{"bendscript":"0.1","blocks":[{"id":"blk-41650","kind":"heading","level":1,"spans":[{"id":"spn-46277","text":"Runtime Walkthrough"}]},{"id":"blk-41651","kind":"paragraph","spans":[{"id":"spn-46278","text":"This page walks through the Graphonomous runtime from process startup to closed-loop learning, goal review, and maintenance."}]},{"id":"blk-41652","kind":"paragraph","spans":[{"id":"spn-46279","text":"If you want a practical mental model, think in this sequence:"}]},{"id":"blk-41653","kind":"paragraph","spans":[{"id":"spn-46280","text":"1. "},{"id":"spn-46281","marks":["bold"],"text":"Boot services"},{"id":"spn-46282","text":" 2. "},{"id":"spn-46283","marks":["bold"],"text":"Retrieve context"},{"id":"spn-46284","text":" 3. "},{"id":"spn-46285","marks":["bold"],"text":"Act"},{"id":"spn-46286","text":" 4. "},{"id":"spn-46287","marks":["bold"],"text":"Store durable knowledge"},{"id":"spn-46288","text":" 5. "},{"id":"spn-46289","marks":["bold"],"text":"Learn from outcomes"},{"id":"spn-46290","text":" 6. "},{"id":"spn-46291","marks":["bold"],"text":"Review goal coverage"},{"id":"spn-46292","text":" 7. "},{"id":"spn-46293","marks":["bold"],"text":"Run consolidation"}]},{"id":"blk-41654","kind":"paragraph","spans":[{"id":"spn-46294","text":"---"}]},{"id":"blk-41655","kind":"heading","level":2,"spans":[{"id":"spn-46295","text":"1) Boot and Supervision"}]},{"id":"blk-41656","kind":"paragraph","spans":[{"id":"spn-46296","text":"Graphonomous runs as an OTP application with supervised runtime components:"}]},{"id":"blk-41657","items":[{"blocks":[{"id":"blk-41659","kind":"paragraph","spans":[{"id":"spn-46297","text":"Store"}]}],"id":"blk-41658","kind":"list-item"},{"blocks":[{"id":"blk-41661","kind":"paragraph","spans":[{"id":"spn-46298","text":"Embedder"}]}],"id":"blk-41660","kind":"list-item"},{"blocks":[{"id":"blk-41663","kind":"paragraph","spans":[{"id":"spn-46299","text":"Graph"}]}],"id":"blk-41662","kind":"list-item"},{"blocks":[{"id":"blk-41665","kind":"paragraph","spans":[{"id":"spn-46300","text":"Retriever"}]}],"id":"blk-41664","kind":"list-item"},{"blocks":[{"id":"blk-41667","kind":"paragraph","spans":[{"id":"spn-46301","text":"Learner"}]}],"id":"blk-41666","kind":"list-item"},{"blocks":[{"id":"blk-41669","kind":"paragraph","spans":[{"id":"spn-46302","text":"GoalGraph"}]}],"id":"blk-41668","kind":"list-item"},{"blocks":[{"id":"blk-41671","kind":"paragraph","spans":[{"id":"spn-46303","text":"Attention"}]}],"id":"blk-41670","kind":"list-item"},{"blocks":[{"id":"blk-41673","kind":"paragraph","spans":[{"id":"spn-46304","text":"Consolidator"}]}],"id":"blk-41672","kind":"list-item"},{"blocks":[{"id":"blk-41675","kind":"paragraph","spans":[{"id":"spn-46305","text":"MCP registry/server plumbing"}]}],"id":"blk-41674","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41676","kind":"heading","level":3,"spans":[{"id":"spn-46306","text":"What happens at startup"}]},{"id":"blk-41677","items":[{"blocks":[{"id":"blk-41679","kind":"paragraph","spans":[{"id":"spn-46307","text":"Store opens the SQLite database."}]}],"id":"blk-41678","kind":"list-item"},{"blocks":[{"id":"blk-41681","kind":"paragraph","spans":[{"id":"spn-46308","text":"Schema/migrations are applied."}]}],"id":"blk-41680","kind":"list-item"},{"blocks":[{"id":"blk-41683","kind":"paragraph","spans":[{"id":"spn-46309","text":"ETS hot cache is rebuilt from durable state."}]}],"id":"blk-41682","kind":"list-item"},{"blocks":[{"id":"blk-41685","kind":"paragraph","spans":[{"id":"spn-46310","text":"Core services come online and MCP tools/resources are exposed."}]}],"id":"blk-41684","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41686","kind":"heading","level":3,"spans":[{"id":"spn-46311","text":"Why this matters"}]},{"id":"blk-41687","kind":"paragraph","spans":[{"id":"spn-46312","text":"You get:"}]},{"id":"blk-41688","items":[{"blocks":[{"id":"blk-41690","kind":"paragraph","spans":[{"id":"spn-46313","text":"fast reads (ETS)"}]}],"id":"blk-41689","kind":"list-item"},{"blocks":[{"id":"blk-41692","kind":"paragraph","spans":[{"id":"spn-46314","text":"durable writes (SQLite)"}]}],"id":"blk-41691","kind":"list-item"},{"blocks":[{"id":"blk-41694","kind":"paragraph","spans":[{"id":"spn-46315","text":"process-level fault isolation (OTP supervision)"}]}],"id":"blk-41693","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41695","kind":"paragraph","spans":[{"id":"spn-46316","text":"---"}]},{"id":"blk-41696","kind":"heading","level":2,"spans":[{"id":"spn-46317","text":"2) MCP Session Entry"}]},{"id":"blk-41697","kind":"paragraph","spans":[{"id":"spn-46318","text":"Most integrations begin through MCP over stdio."}]},{"id":"blk-41698","kind":"paragraph","spans":[{"id":"spn-46319","text":"Typical first checks:"}]},{"id":"blk-41699","items":[{"blocks":[{"id":"blk-41701","kind":"paragraph","spans":[{"id":"spn-46320","text":"Runtime health snapshot"}]}],"id":"blk-41700","kind":"list-item"},{"blocks":[{"id":"blk-41703","kind":"paragraph","spans":[{"id":"spn-46321","text":"Goal snapshot"}]}],"id":"blk-41702","kind":"list-item"},{"blocks":[{"id":"blk-41705","kind":"paragraph","spans":[{"id":"spn-46322","text":"Lightweight context retrieval for the current task"}]}],"id":"blk-41704","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41706","kind":"paragraph","spans":[{"id":"spn-46323","text":"This gives the agent session orientation before making changes."}]},{"id":"blk-41707","kind":"paragraph","spans":[{"id":"spn-46324","text":"---"}]},{"id":"blk-41708","kind":"heading","level":2,"spans":[{"id":"spn-46325","text":"3) Retrieval Path (Context Before Action)"}]},{"id":"blk-41709","kind":"paragraph","spans":[{"id":"spn-46326","text":"Graphonomous retrieval is not only semantic similarity. It combines:"}]},{"id":"blk-41710","kind":"paragraph","spans":[{"id":"spn-46327","text":"1. embedding similarity search 2. graph-neighbor expansion 3. confidence-aware ranking 4. topology analysis (SCC/κ routing metadata)"}]},{"id":"blk-41