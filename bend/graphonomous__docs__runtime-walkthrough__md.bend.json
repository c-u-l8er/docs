:[{"id":"spn-46347","text":"After retrieval, the agent reasons and executes work. New durable knowledge should be stored in atomic form."}]},{"id":"blk-41730","kind":"heading","level":3,"spans":[{"id":"spn-46348","text":"Node types"}]},{"id":"blk-41731","items":[{"blocks":[{"id":"blk-41733","kind":"paragraph","spans":[{"id":"spn-46349","marks":["code"],"text":"semantic"},{"id":"spn-46350","text":": facts/architecture"}]}],"id":"blk-41732","kind":"list-item"},{"blocks":[{"id":"blk-41735","kind":"paragraph","spans":[{"id":"spn-46351","marks":["code"],"text":"procedural"},{"id":"spn-46352","text":": how-to/workflows"}]}],"id":"blk-41734","kind":"list-item"},{"blocks":[{"id":"blk-41737","kind":"paragraph","spans":[{"id":"spn-46353","marks":["code"],"text":"episodic"},{"id":"spn-46354","text":": observed events or session outcomes"}]}],"id":"blk-41736","kind":"list-item"},{"blocks":[{"id":"blk-41739","kind":"paragraph","spans":[{"id":"spn-46355","marks":["code"],"text":"temporal"},{"id":"spn-46356","text":": time-indexed observations, monitoring events"}]}],"id":"blk-41738","kind":"list-item"},{"blocks":[{"id":"blk-41741","kind":"paragraph","spans":[{"id":"spn-46357","marks":["code"],"text":"outcome"},{"id":"spn-46358","text":": empirical results of actions (grounding)"}]}],"id":"blk-41740","kind":"list-item"},{"blocks":[{"id":"blk-41743","kind":"paragraph","spans":[{"id":"spn-46359","marks":["code"],"text":"goal"},{"id":"spn-46360","text":": durable intent, objectives, targets"}]}],"id":"blk-41742","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41744","kind":"heading","level":3,"spans":[{"id":"spn-46361","text":"Good storage discipline"}]},{"id":"blk-41745","items":[{"blocks":[{"id":"blk-41747","kind":"paragraph","spans":[{"id":"spn-46362","text":"one claim/procedure/event per node"}]}],"id":"blk-41746","kind":"list-item"},{"blocks":[{"id":"blk-41749","kind":"paragraph","spans":[{"id":"spn-46363","text":"realistic confidence values"}]}],"id":"blk-41748","kind":"list-item"},{"blocks":[{"id":"blk-41751","kind":"paragraph","spans":[{"id":"spn-46364","text":"source attribution when possible"}]}],"id":"blk-41750","kind":"list-item"},{"blocks":[{"id":"blk-41753","kind":"paragraph","spans":[{"id":"spn-46365","text":"edges only when relationship quality justifies it"}]}],"id":"blk-41752","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41754","kind":"paragraph","spans":[{"id":"spn-46366","text":"---"}]},{"id":"blk-41755","kind":"heading","level":2,"spans":[{"id":"spn-46367","text":"5) Closed-Loop Learning (Outcome Feedback)"}]},{"id":"blk-41756","kind":"paragraph","spans":[{"id":"spn-46368","text":"After a meaningful action, Graphonomous can update confidence on the causal nodes that informed that action."}]},{"id":"blk-41757","kind":"heading","level":3,"spans":[{"id":"spn-46369","text":"Learning inputs"}]},{"id":"blk-41758","items":[{"blocks":[{"id":"blk-41760","kind":"paragraph","spans":[{"id":"spn-46370","marks":["code"],"text":"action_id"}]}],"id":"blk-41759","kind":"list-item"},{"blocks":[{"id":"blk-41762","kind":"paragraph","spans":[{"id":"spn-46371","marks":["code"],"text":"status"},{"id":"spn-46372","text":" ("},{"id":"spn-46373","marks":["code"],"text":"success"},{"id":"spn-46374","text":", "},{"id":"spn-46375","marks":["code"],"text":"partial_success"},{"id":"spn-46376","text":", "},{"id":"spn-46377","marks":["code"],"text":"failure"},{"id":"spn-46378","text":", "},{"id":"spn-46379","marks":["code"],"text":"timeout"},{"id":"spn-46380","text":")"}]}],"id":"blk-41761","kind":"list-item"},{"blocks":[{"id":"blk-41764","kind":"paragraph","spans":[{"id":"spn-46381","text":"outcome "},{"id":"spn-46382","marks":["code"],"text":"confidence"}]}],"id":"blk-41763","kind":"list-item"},{"blocks":[{"id":"blk-41766","kind":"paragraph","spans":[{"id":"spn-46383","marks":["code"],"text":"causal_node_ids"},{"id":"spn-46384","text":" (from retrieval causal context)"}]}],"id":"blk-41765","kind":"list-item"},{"blocks":[{