{"bendscript":"0.1","blocks":[{"id":"blk-14852","kind":"heading","level":1,"spans":[{"id":"spn-13619","text":"Skill 05 — Generation"}]},{"blocks":[{"id":"blk-14854","kind":"paragraph","spans":[{"id":"spn-13620","text":"Compiling agent declarations into MCP server configurations and A2A agent cards. The \"from spec to running agent\" path."}]}],"id":"blk-14853","kind":"quote"},{"id":"blk-14855","kind":"paragraph","spans":[{"id":"spn-13621","text":"---"}]},{"id":"blk-14856","kind":"heading","level":2,"spans":[{"id":"spn-13622","text":"Why This Matters"}]},{"id":"blk-14857","kind":"paragraph","spans":[{"id":"spn-13623","text":"Generation is the payoff. A validated, composed "},{"id":"spn-13624","marks":["code"],"text":"ampersand.json"},{"id":"spn-13625","text":" compiles into runtime artifacts that existing protocols understand. This is how [&] complements MCP and A2A without replacing either."}]},{"id":"blk-14858","kind":"code","language":"text","text":"ampersand.json → ampersand generate → mcp-config.json + agent-card.json"},{"id":"blk-14859","kind":"paragraph","spans":[{"id":"spn-13626","text":"---"}]},{"id":"blk-14860","kind":"heading","level":2,"spans":[{"id":"spn-13627","text":"Generating MCP Configuration"}]},{"id":"blk-14861","kind":"heading","level":3,"spans":[{"id":"spn-13628","text":"Command"}]},{"id":"blk-14862","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json"},{"id":"blk-14863","kind":"heading","level":3,"spans":[{"id":"spn-13629","text":"What It Produces"}]},{"id":"blk-14864","kind":"paragraph","spans":[{"id":"spn-13630","text":"An MCP server configuration that wires up the declared capability providers as MCP tools and resources:"}]},{"id":"blk-14865","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--instance\", \"infra-ops\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\n        \"store_node\", \"store_edge\", \"retrieve_context\",\n        \"topology_analyze\", \"deliberate\"\n      ],\n      \"resources\": [\"graphonomous://runtime/health\"]\n    },\n    \"ticktickclock\": {\n      \"command\": \"ticktickclock\",\n      \"args\": [\"--streams\", \"cpu,mem\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\"detect_anomaly\", \"enrich_context\", \"learn_observation\"]\n    },\n    \"deliberatic\": {\n      \"command\": \"deliberatic\",\n      \"args\": [\"--governance\", \"constitutional\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\"evaluate_argument\", \"structured_vote\"]\n    }\n  }\n}"},{"id":"blk-14866","kind":"heading","level":3,"spans":[{"id":"spn-13631","text":"How Capabilities Map to MCP Tools"}]},{"id":"blk-14867","kind":"paragraph","spans":[{"id":"spn-13632","text":"Each capability's operations become MCP tools:"}]},{"head":[{"id":"blk-14869","spans":[{"id":"spn-13633","text":"Capability"}]},{"id":"blk-14870","spans":[{"id":"spn-13634","text":"Operations"}]},{"id":"blk-14871","spans":[{"id":"spn-13635","text":"MCP Tools"}]}],"id":"blk-14868","kind":"table","rows":[[{"id":"blk-14872","spans":[{"id":"spn-13636","marks":["code"],"text":"&memory.graph"}]},{"id":"blk-14873","spans":[{"id":"spn-13637","marks":["code"],"text":"recall"},{"id":"spn-13638","text":", "},{"id":"spn-13639","marks":["code"],"text":"store"},{"id":"spn-13640","text":", "},{"id":"spn-13641","marks":["code"],"text":"enrich"},{"id":"spn-13642","text":", "},{"id":"spn-13643","marks":["code"],"text":"topology"}]},{"id":"blk-14874","spans":[{"id":"spn-13644","marks":["code"],"text":"retrieve_context"},{"id":"spn-13645","text":", "},{"id":"spn-13646","marks":["code"],"text":"store_node"},{"id":"spn-13647","text":", "},{"id":"spn-13648","marks":["code"],"text":"store_edge"},{"id":"spn-13649","text":", "},{"id":"spn-13650","marks":["code"],"text":"topology_analyze"}]}],[{"id":"blk-14875","spans":[{"id":"spn-13651","marks":["code"],"text":"&time.anomaly"}]},{"id":"blk-14876","spans":[{"id":"spn-13652","marks":["code"],"text":"detect"},{"id":"spn-13653","text":", "},{"id":"spn-13654","marks":["code"],"text":"enrich"},{"id":"spn-13655","text":", "},{"id":"spn-13656","marks":["code"],"text":"learn"}]},{"id":"blk-14877","spans":[{"id":"spn-13657","marks":["code"],"text":"detect_anomaly"},{"id":"spn-13658","text":", "},{"id":"spn-13659","marks":["code"],"text":"enrich_context"},{"id":"spn-13660","text":", "},{"id":"spn-13661","marks":["code"],"text":"learn_observation"}]}],[{"id":"blk-14878","spans":[{"id":"spn-13662","marks":["code"],"text":"&reason.argument"}]},{"id":"blk-14879","spans":[{"id":"spn-13663","marks":["code"],"text":"evaluate"},{"id":"spn-13664","text":", "},{"id":"spn-13665","marks":["code"],"text":"vote"}]},{"id":"blk-14880","spans":[{"id":"spn-13666","marks":["code"],"text":"evaluate_argument"},{"id":"spn-13667","text":", "},{"id":"spn-13668","marks":["code"],"text":"structured_vote"}]}],[{"id":"blk-14881","spans":[{"id":"spn-13669","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-14882","spans":[{"id":"spn-13670","marks":["code"],"text":"deliberate"},{"id":"spn-13671","text":", "},{"id":"spn-13672","marks":["code"],"text":"decompose"},{"id":"spn-13673","text":", "},{"id":"spn-13674","marks":["code"],"text":"reconcile"}]},{"id":"blk-14883","spans":[{"id":"spn-13675","marks":["code"],"text":"deliberate"},{"id":"spn-13676","text":", "},{"id":"spn-13677","marks":["code"],"text":"decompose_topology"},{"id":"spn-13678","text":", "},{"id":"spn-13679","marks":["code"],"text":"reconcile_conclusions"}]}],[{"id":"blk-14884","spans":[{"id":"spn-13680","marks":["code"],"text":"&reason.attend"}]},{"id":"blk-14885","spans":[{"id":"spn-13681","marks":["code"],"text":"survey"},{"id":"spn-13682","text":", "},{"id":"spn-13683","marks":["code"],"text":"triage"},{"id":"spn-13684","text":", "},{"id":"spn-13685","marks":["code"],"text":"dispatch"}]},{"id":"blk-14886","spans":[{"id":"spn-13686","marks":["code"],"text":"attention_survey"},{"id":"spn-13687","text":", "},{"id":"spn-13688","marks":["code"],"text":"attention_triage"},{"id":"spn-13689","text":", "},{"id":"spn-13690","marks":["code"],"text":"attention_run_cycle"}]}]]},{"id":"blk-14887","kind":"paragraph","spans":[{"id":"spn-13691","text":"The mapping is defined in each capability's contract. The generator reads the contract and emits the corresponding MCP tool registrations."}]},{"id":"blk-14888","kind":"paragraph","spans":[{"id":"spn-13692","text":"---"}]},{"id":"blk-14889","kind":"heading","level":2,"spans":[{"id":"spn-13693","text":"Generating A2A Agent Cards"}]},{"id":"blk-14890","kind":"heading","level":3,"spans":[{"id":"spn-13694","text":"Command"}]},{"id":"blk-14891","kind":"code","language":"bash","text":"./ampersand generate a2a agent.ampersand.json"},{"id":"blk-14892","kind":"heading","level":3,"spans":[{"id":"spn-13695","text":"What It Produces"}]},{"id":"blk-14893","kind":"paragraph","spans":[{"id":"spn-13696","text":"An A2A agent card suitable for "},{"id":"spn-13697","marks":["code"],"text":"/.well-known/agent.json"},{"id":"spn-13698","text":":"}]},{"id":"blk-14894","kind":"code","language":"json","text":"{\n  \"name\": \"InfraOperator\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Infrastructure operations agent with graph memory, temporal anomaly detection, fleet awareness, and deliberative reasoning.\",\n  \"skills\": [\n    {\n      \"id\": \"temporal-anomaly-detection\",\n      \"name\": \"Temporal Anomaly Detection\",\n      \"description\": \"Detect anomalous events in temporal data streams.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    },\n    {\n      \"id\": \"topology-aware-deliberation\",\n      \"name\": \"Topology-Aware Deliberation\",\n      \"description\": \"Focused reasoning through knowledge graph cycles.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    },\n    {\n      \"id\": \"fleet-spatial-awareness\",\n      \"name\": \"Fleet Spatial Awareness\",\n      \"description\": \"Geospatial fleet tracking and geofence management.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    }\n  ],\n  \"capabilities\": {\n    \"streaming\": false,\n    \"pushNotifications\": false\n  }\n}"},{"id":"blk-14895","kind":"heading","level":3,"spans":[{"id":"spn-13699","text":"How Capabilities Map to A2A Skills"}]},{"id":"blk-14896","kind":"paragraph","spans":[{"id":"spn-13700","text":"Each capability contract includes an "},{"id":"spn-13701","marks":["code"],"text":"a2a_skills"},{"id":"spn-13702","text":" field that defines the skill identifiers exposed via A2A:"}]},{"head":[{"id":"blk-14898","spans":[{"id":"spn-13703","text":"Capability"}]},{"id":"blk-14899","spans":[{"id":"spn-13704","marks":["code"],"text":"a2a_skills"}]},{"id":"blk-14900","spans":[{"id":"spn-13705","text":"A2A Skill Entry"}]}],"id":"blk-14897","kind":"table","rows":[[{"id":"blk-14901","spans":[{"id":"spn-13706","marks":["code"],"text":"&time.anomaly"}]},{"id":"blk-14902","spans":[{"id":"spn-13707","marks":["code"],"text":"[\"temporal-anomaly-detection\"]"}]},{"id":"blk-14903","spans":[{"id":"spn-13708","text":"Temporal anomaly detection skill"}]}],[{"id":"blk-14904","spans":[{"id":"spn-13709","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-14905","spans":[{"id":"spn-13710","marks":["code"],"text":"[\"topology-aware-deliberation\"]"}]},{"id":"blk-14906","spans":[{"id":"spn-13711","text":"Deliberation skill"}]}],[{"id":"blk-14907","spans":[{"id":"spn-13712","marks":["code"],"text":"&space.fleet"}]},{"id":"blk-14908","spans":[{"id":"spn-13713","marks":["code"],"text":"[\"fleet-spatial-awareness\"]"}]},{"id":"blk-14909","spans":[{"id":"spn-13714","text":"Fleet tracking skill"}]}]]},{"id":"blk-14910","kind":"paragraph","spans":[{"id":"spn-13715","text":"---"}]},{"id":"blk-14911","kind":"heading","level":2,"spans":[{"id":"spn-13716","text":"Output Options"}]},{"id":"blk-14912","kind":"heading","level":3,"spans":[{"id":"spn-13717","text":"Write to file"}]},{"id":"blk-14913","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --output mcp-config.json\n./ampersand generate a2a agent.ampersand.json --output agent-card.json"},{"id":"blk-14914","kind":"heading","level":3,"spans":[{"id":"spn-13718","text":"Write to stdout (default)"}]},{"id":"blk-14915","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json | jq ."},{"id":"blk-14916","kind":"heading","level":3,"spans":[{"id":"spn-13719","text":"Compact output"}]},{"id":"blk-14917","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --compact"},{"id":"blk-14918","kind":"paragraph","spans":[{"id":"spn-13720","text":"---"}]},{"id":"blk-14919","kind":"heading","level":2,"spans":[{"id":"spn-13721","text":"Generation Pipeline"}]},{"id":"blk-14920","kind":"paragraph","spans":[{"id":"spn-13722","text":"Generation runs after validation and composition. The full sequence:"}]},{"id":"blk-14921","kind":"code","language":"text","text":"1. Parse ampersand.json\n2. Validate against schema (same as `validate`)\n3. Compose and check type safety (same as `compose`)\n4. Resolve providers from registry\n5. Load capability contracts for each provider\n6. Map operations → MCP tools or A2A skills\n7. Emit output artifact"},{"id":"blk-14922","kind":"paragraph","spans":[{"id":"spn-13723","text":"If validation or composition fails, generation aborts with the relevant errors. You do not need to run "},{"id":"spn-13724","marks":["code"],"text":"validate"},{"id":"spn-13725","text":" and "},{"id":"spn-13726","marks":["code"],"text":"compose"},{"id":"spn-13727","text":" separately before "},{"id":"spn-13728","marks":["code"],"text":"generate"},{"id":"spn-13729","text":" — the command includes both checks."}]},{"id":"blk-14923","kind":"paragraph","spans":[{"id":"spn-13730","text":"---"}]},{"id":"blk-14924","kind":"heading","level":2,"spans":[{"id":"spn-13731","text":"Custom Generation"}]},{"id":"blk-14925","kind":"heading","level":3,"spans":[{"id":"spn-13732","text":"Provider overrides"}]},{"id":"blk-14926","kind":"paragraph","spans":[{"id":"spn-13733","text":"Override providers at generation time without modifying the declaration:"}]},{"id":"blk-14927","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json \\\n  --provider \"&memory.graph=custom-graph-service\""},{"id":"blk-14928","kind":"heading","level":3,"spans":[{"id":"spn-13734","text":"Transport selection"}]},{"id":"blk-14929","kind":"paragraph","spans":[{"id":"spn-13735","text":"Force a specific MCP transport:"}]},{"id":"blk-14930","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --transport http"},{"id":"blk-14931","kind":"paragraph","spans":[{"id":"spn-13736","text":"Default is "},{"id":"spn-13737","marks":["code"],"text":"stdio"},{"id":"spn-13738","text":"."}]},{"id":"blk-14932","kind":"paragraph","spans":[{"id":"spn-13739","text":"---"}]},{"id":"blk-14933","kind":"heading","level":2,"spans":[{"id":"spn-13740","text":"What Generation Does NOT Do"}]},{"id":"blk-14934","items":[{"blocks":[{"id":"blk-14936","kind":"paragraph","spans":[{"id":"spn-13741","text":"It does not start MCP servers or deploy agents"}]}],"id":"blk-14935","kind":"list-item"},{"blocks":[{"id":"blk-14938","kind":"paragraph","spans":[{"id":"spn-13742","text":"It does not install provider binaries"}]}],"id":"blk-14937","kind":"list-item"},{"blocks":[{"id":"blk-14940","kind":"paragraph","spans":[{"id":"spn-13743","text":"It does not modify the source declaration"}]}],"id":"blk-14939","kind":"list-item"},{"blocks":[{"id":"blk-14942","kind":"paragraph","spans":[{"id":"spn-13744","text":"It does not create network connections"}]}],"id":"blk-14941","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14943","kind":"paragraph","spans":[{"id":"spn-13745","text":"Generation produces "},{"id":"spn-13746","marks":["bold"],"text":"configuration artifacts"},{"id":"spn-13747","text":". Deployment is a separate concern handled by your runtime infrastructure."}]}],"edges":[],"id":"bagaaierahaeqizoki7zdt7us2mxerfkcq6yeqmz2shupc3maf3bdxkwrqwva","vocabulary":"ampersand.docs.fs.v1"}