{"bendscript":"0.1","blocks":[{"id":"blk-48675","kind":"heading","level":1,"spans":[{"id":"spn-54903","text":"Skill 01 — The Ten Protocols"}]},{"blocks":[{"id":"blk-48677","kind":"paragraph","spans":[{"id":"spn-54904","text":"OS-001 through OS-010: what each protocol specifies, which product implements it, and the cognitive science behind it. Eight cognitive primitives plus two cross-cutting protocols (PRISM diagnostic, PULSE temporal)."}]}],"id":"blk-48676","kind":"quote"},{"id":"blk-48678","kind":"paragraph","spans":[{"id":"spn-54905","text":"---"}]},{"id":"blk-48679","kind":"heading","level":2,"spans":[{"id":"spn-54906","text":"Overview"}]},{"id":"blk-48680","kind":"paragraph","spans":[{"id":"spn-54907","text":"OpenSentience publishes ten numbered protocols organized in two layers:"}]},{"id":"blk-48681","items":[{"blocks":[{"id":"blk-48683","kind":"paragraph","spans":[{"id":"spn-54908","marks":["bold"],"text":"Cognitive primitives (OS-001 — OS-008)"},{"id":"spn-54909","text":" — eight individual capabilities,"}]}],"id":"blk-48682","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48684","kind":"paragraph","spans":[{"id":"spn-54910","text":"each grounded in a cognitive science thread."}]},{"id":"blk-48685","items":[{"blocks":[{"id":"blk-48687","kind":"paragraph","spans":[{"id":"spn-54911","marks":["bold"],"text":"Cross-cutting protocols (OS-009 PRISM, OS-010 PULSE)"},{"id":"spn-54912","text":" — two sibling"}]}],"id":"blk-48686","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48688","kind":"paragraph","spans":[{"id":"spn-54913","text":"protocols that sit above the cognitive primitives and above the [&] structural composition layer. PULSE declares how every loop in the ecosystem cycles, nests, and signals; PRISM measures how well those loops actually learn over time."}]},{"id":"blk-48689","kind":"paragraph","spans":[{"id":"spn-54914","text":"The protocols are independent specifications — they can be adopted individually or composed together. A system may publish a PULSE manifest without implementing any cognitive primitive, and PRISM can benchmark any PULSE-conforming system without bespoke per-system integration."}]},{"id":"blk-48690","kind":"paragraph","spans":[{"id":"spn-54915","text":"---"}]},{"id":"blk-48691","kind":"heading","level":2,"spans":[{"id":"spn-54916","text":"OS-001: Continual Learning"}]},{"id":"blk-48692","kind":"paragraph","spans":[{"id":"spn-54917","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-54918","text":" Hippocampal consolidation (McClelland et al. 1995)"}]},{"id":"blk-48693","kind":"paragraph","spans":[{"id":"spn-54919","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48694","items":[{"blocks":[{"id":"blk-48696","kind":"paragraph","spans":[{"id":"spn-54920","text":"Three node types: episodic (events), semantic (facts), procedural (workflows)"}]}],"id":"blk-48695","kind":"list-item"},{"blocks":[{"id":"blk-48698","kind":"paragraph","spans":[{"id":"spn-54921","text":"Typed, weighted edges between nodes"}]}],"id":"blk-48697","kind":"list-item"},{"blocks":[{"id":"blk-48700","kind":"paragraph","spans":[{"id":"spn-54922","text":"Confidence scores with evidence-calibrated assignment"}]}],"id":"blk-48699","kind":"list-item"},{"blocks":[{"id":"blk-48702","kind":"paragraph","spans":[{"id":"spn-54923","text":"Consolidation cycle: decay low-confidence nodes, prune stale entries,"}]}],"id":"blk-48701","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48703","kind":"paragraph","spans":[{"id":"spn-54924","text":"merge near-duplicates, strengthen co-retrieved edges"}]},{"id":"blk-48704","items":[{"blocks":[{"id":"blk-48706","kind":"paragraph","spans":[{"id":"spn-54925","text":"Memory timescales: working memory (session), short-term (hours), long-term"}]}],"id":"blk-48705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48707","kind":"paragraph","spans":[{"id":"spn-54926","text":"(persistent)"}]},{"id":"blk-48708","kind":"paragraph","spans":[{"id":"spn-54927","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-54928","text":" New memories must be stored quickly (hippocampal fast-write) without disrupting existing knowledge (neocortical slow-consolidation). This maps to immediate ETS/SQLite writes with background consolidation."}]},{"id":"blk-48709","kind":"paragraph","spans":[{"id":"spn-54929","marks":["bold"],"text":"Implemented by:"},{"id":"spn-54930","text":" Graphonomous ("},{"id":"spn-54931","marks":["code"],"text":"store_node"},{"id":"spn-54932","text":", "},{"id":"spn-54933","marks":["code"],"text":"store_edge"},{"id":"spn-54934","text":", "},{"id":"spn-54935","marks":["code"],"text":"retrieve_context"},{"id":"spn-54936","text":", "},{"id":"spn-54937","marks":["code"],"text":"run_consolidation"},{"id":"spn-54938","text":")"}]},{"id":"blk-48710","kind":"paragraph","spans":[{"id":"spn-54939","text":"---"}]},{"id":"blk-48711","kind":"heading","level":2,"spans":[{"id":"spn-54940","text":"OS-002: Topological Routing (kappa)"}]},{"id":"blk-48712","kind":"paragraph","spans":[{"id":"spn-54941","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-54942","text":" Working memory gating (O'Reilly & Frank 2006)"}]},{"id":"blk-48713","kind":"paragraph","spans":[{"id":"spn-54943","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48714","items":[{"blocks":[{"id":"blk-48716","kind":"paragraph","spans":[{"id":"spn-54944","text":"The kappa parameter: a measure of cyclicity in a knowledge subgraph"}]}],"id":"blk-48715","kind":"list-item"},{"blocks":[{"id":"blk-48718","kind":"paragraph","spans":[{"id":"spn-54945","text":"Strongly connected component (SCC) detection on retrieved neighborhoods"}]}],"id":"blk-48717","kind":"list-item"},{"blocks":[{"id":"blk-48720","kind":"paragraph","spans":[{"id":"spn-54946","text":"Routing decision: kappa = 0 implies fast path (acyclic, no conflict),"}]}],"id":"blk-48719","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48721","kind":"paragraph","spans":[{"id":"spn-54947","text":"kappa > 0 implies deliberate path (cycles exist, may contain contradictions)"}]},{"id":"blk-48722","items":[{"blocks":[{"id":"blk-48724","kind":"paragraph","spans":[{"id":"spn-54948","text":"Topological features: SCC count, max SCC size, edge density within cycles"}]}],"id":"blk-48723","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48725","kind":"paragraph","spans":[{"id":"spn-54949","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-54950","text":" The prefrontal cortex gates information into working memory based on relevance and conflict signals. Kappa serves as the conflict signal — cyclic knowledge regions indicate unresolved tension that requires deliberation before action."}]},{"id":"blk-48726","kind":"paragraph","spans":[{"id":"spn-54951","marks":["bold"],"text":"Implemented by:"},{"id":"spn-54952","text":" Graphonomous routing layer ("},{"id":"spn-54953","marks":["code"],"text":"topology_analyze"},{"id":"spn-54954","text":", "},{"id":"spn-54955","marks":["code"],"text":"retrieve_context"},{"id":"spn-54956","text":" topology annotations)"}]},{"id":"blk-48727","kind":"paragraph","spans":[{"id":"spn-54957","text":"---"}]},{"id":"blk-48728","kind":"heading","level":2,"spans":[{"id":"spn-54958","text":"OS-003: Deliberation Orchestrator"}]},{"id":"blk-48729","kind":"paragraph","spans":[{"id":"spn-54959","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-54960","text":" Dual-process theory (Kahneman 2011)"}]},{"id":"blk-48730","kind":"paragraph","spans":[{"id":"spn-54961","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48731","items":[{"blocks":[{"id":"blk-48733","kind":"paragraph","spans":[{"id":"spn-54962","text":"Four-phase deliberation: bid, debate, vote, commit"}]}],"id":"blk-48732","kind":"list-item"},{"blocks":[{"id":"blk-48735","kind":"paragraph","spans":[{"id":"spn-54963","text":"Argumentation framework: claims, warrants, rebuttals"}]}],"id":"blk-48734","kind":"list-item"},{"blocks":[{"id":"blk-48737","kind":"paragraph","spans":[{"id":"spn-54964","text":"Consensus mechanisms: majority, supermajority, unanimity"}]}],"id":"blk-48736","kind":"list-item"},{"blocks":[{"id":"blk-48739","kind":"paragraph","spans":[{"id":"spn-54965","text":"Timeout and escalation policies"}]}],"id":"blk-48738","kind":"list-item"},{"blocks":[{"id":"blk-48741","kind":"paragraph","spans":[{"id":"spn-54966","text":"Triggered when kappa routing indicates deliberation is needed"}]}],"id":"blk-48740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48742","kind":"paragraph","spans":[{"id":"spn-54967","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-54968","text":" System 1 (fast, automatic) handles routine decisions. System 2 (slow, deliberate) engages when conflict is detected. The kappa threshold is the trigger that shifts from fast to deliberate processing."}]},{"id":"blk-48743","kind":"paragraph","spans":[{"id":"spn-54969","marks":["bold"],"text":"Implemented by:"},{"id":"spn-54970","text":" AgenTroMatic ("},{"id":"spn-54971","marks":["code"],"text":"deliberate"},{"id":"spn-54972","text":" tool in Graphonomous provides the single-agent deliberation path)"}]},{"id":"blk-48744","kind":"paragraph","spans":[{"id":"spn-54973","text":"---"}]},{"id":"blk-48745","kind":"heading","level":2,"spans":[{"id":"spn-54974","text":"OS-004: Attention Engine"}]},{"id":"blk-48746","kind":"paragraph","spans":[{"id":"spn-54975","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-54976","text":" Endogenous attention (Desimone & Duncan 1995)"}]},{"id":"blk-48747","kind":"paragraph","spans":[{"id":"spn-54977","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48748","items":[{"blocks":[{"id":"blk-48750","kind":"paragraph","spans":[{"id":"spn-54978","text":"Three-phase cycle: survey (scan environment), triage (rank by salience),"}]}],"id":"blk-48749","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48751","kind":"paragraph","spans":[{"id":"spn-54979","text":"dispatch (act on highest-priority items)"}]},{"id":"blk-48752","items":[{"blocks":[{"id":"blk-48754","kind":"paragraph","spans":[{"id":"spn-54980","text":"Salience scoring: combines urgency, recency, goal relevance, and confidence"}]}],"id":"blk-48753","kind":"list-item"},{"blocks":[{"id":"blk-48756","kind":"paragraph","spans":[{"id":"spn-54981","text":"Goal bias: active goals increase salience of related knowledge"}]}],"id":"blk-48755","kind":"list-item"},{"blocks":[{"id":"blk-48758","kind":"paragraph","spans":[{"id":"spn-54982","text":"Dispatch modes: act (execute), learn (gather more context), escalate"}]}],"id":"blk-48757","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48759","kind":"paragraph","spans":[{"id":"spn-54983","text":"(request human intervention), idle (nothing needed)"}]},{"id":"blk-48760","kind":"paragraph","spans":[{"id":"spn-54984","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-54985","text":" Biological attention is goal-directed (endogenous) not just stimulus-driven (exogenous). The attention engine prioritizes based on the agent's active goals, not just what is new or loud."}]},{"id":"blk-48761","kind":"paragraph","spans":[{"id":"spn-54986","marks":["bold"],"text":"Implemented by:"},{"id":"spn-54987","text":" Graphonomous attention module ("},{"id":"spn-54988","marks":["code"],"text":"attention_survey"},{"id":"spn-54989","text":", "},{"id":"spn-54990","marks":["code"],"text":"attention_run_cycle"},{"id":"spn-54991","text":")"}]},{"id":"blk-48762","kind":"paragraph","spans":[{"id":"spn-54992","text":"---"}]},{"id":"blk-48763","kind":"heading","level":2,"spans":[{"id":"spn-54993","text":"OS-005: Model Tier Adaptation"}]},{"id":"blk-48764","kind":"paragraph","spans":[{"id":"spn-54994","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-54995","text":" Resource rationality (Lieder & Griffiths 2020)"}]},{"id":"blk-48765","kind":"paragraph","spans":[{"id":"spn-54996","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48766","items":[{"blocks":[{"id":"blk-48768","kind":"paragraph","spans":[{"id":"spn-54997","text":"Three tiers: "},{"id":"spn-54998","marks":["code"],"text":"local_small"},{"id":"spn-54999","text":" (8B parameter models), "},{"id":"spn-55000","marks":["code"],"text":"local_large"},{"id":"spn-55001","text":" (70B+),"}]}],"id":"blk-48767","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48769","kind":"paragraph","spans":[{"id":"spn-55002","marks":["code"],"text":"cloud_frontier"},{"id":"spn-55003","text":" (largest available)"}]},{"id":"blk-48770","items":[{"blocks":[{"id":"blk-48772","kind":"paragraph","spans":[{"id":"spn-55004","text":"Same topology and tool surface at every tier — only depth and latency differ"}]}],"id":"blk-48771","kind":"list-item"},{"blocks":[{"id":"blk-48774","kind":"paragraph","spans":[{"id":"spn-55005","text":"Escalation rules: when local_small confidence is below threshold, escalate"}]}],"id":"blk-48773","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48775","kind":"paragraph","spans":[{"id":"spn-55006","text":"to local_large; when local_large is insufficient, escalate to cloud_frontier"}]},{"id":"blk-48776","items":[{"blocks":[{"id":"blk-48778","kind":"paragraph","spans":[{"id":"spn-55007","text":"Budget constraints: token limits, latency targets, cost caps per tier"}]}],"id":"blk-48777","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48779","kind":"paragraph","spans":[{"id":"spn-55008","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55009","text":" Optimal cognition allocates computational resources proportional to decision importance. Simple decisions use fast/cheap processing; high-stakes decisions justify expensive computation."}]},{"id":"blk-48780","kind":"paragraph","spans":[{"id":"spn-55010","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55011","text":" Graphonomous and Agentelic (tier selection and escalation logic)"}]},{"id":"blk-48781","kind":"paragraph","spans":[{"id":"spn-55012","text":"---"}]},{"id":"blk-48782","kind":"heading","level":2,"spans":[{"id":"spn-55013","text":"OS-006: Agent Governance Shim"}]},{"id":"blk-48783","kind":"paragraph","spans":[{"id":"spn-55014","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55015","text":" Executive function (Miyake et al. 2000)"}]},{"id":"blk-48784","kind":"paragraph","spans":[{"id":"spn-55016","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48785","items":[{"blocks":[{"id":"blk-48787","kind":"paragraph","spans":[{"id":"spn-55017","text":"Permission taxonomy: filesystem, network, tool_invocation, graph_access"}]}],"id":"blk-48786","kind":"list-item"},{"blocks":[{"id":"blk-48789","kind":"paragraph","spans":[{"id":"spn-55018","text":"Lifecycle state machine: installed, enabled, running, disabled, removed"}]}],"id":"blk-48788","kind":"list-item"},{"blocks":[{"id":"blk-48791","kind":"paragraph","spans":[{"id":"spn-55019","text":"Graduated autonomy: observe, advise, act"}]}],"id":"blk-48790","kind":"list-item"},{"blocks":[{"id":"blk-48793","kind":"paragraph","spans":[{"id":"spn-55020","text":"Append-only audit trail with typed events"}]}],"id":"blk-48792","kind":"list-item"},{"blocks":[{"id":"blk-48795","kind":"paragraph","spans":[{"id":"spn-55021","text":"OTP-native implementation: GenStateMachine, ETS, DynamicSupervisor"}]}],"id":"blk-48794","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48796","kind":"paragraph","spans":[{"id":"spn-55022","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55023","text":" Executive function provides inhibitory control (permissions), task switching (lifecycle), and cognitive flexibility (autonomy levels). Without executive function, an agent cannot self-regulate — it either does nothing or does everything."}]},{"id":"blk-48797","kind":"paragraph","spans":[{"id":"spn-55024","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55025","text":" "},{"id":"spn-55026","marks":["code"],"text":"open_sentience"},{"id":"spn-55027","text":" hex package (this project)"}]},{"id":"blk-48798","kind":"paragraph","spans":[{"id":"spn-55028","text":"---"}]},{"id":"blk-48799","kind":"heading","level":2,"spans":[{"id":"spn-55029","text":"OS-007: Adversarial Robustness"}]},{"id":"blk-48800","kind":"paragraph","spans":[{"id":"spn-55030","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55031","text":" Immune system — self/non-self discrimination"}]},{"id":"blk-48801","kind":"paragraph","spans":[{"id":"spn-55032","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48802","items":[{"blocks":[{"id":"blk-48804","kind":"paragraph","spans":[{"id":"spn-55033","text":"Five threat categories: prompt injection, model poisoning, side-channel,"}]}],"id":"blk-48803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48805","kind":"paragraph","spans":[{"id":"spn-55034","text":"identity spoofing, resource exhaustion"}]},{"id":"blk-48806","items":[{"blocks":[{"id":"blk-48808","kind":"paragraph","spans":[{"id":"spn-55035","text":"Detection rules per category"}]}],"id":"blk-48807","kind":"list-item"},{"blocks":[{"id":"blk-48810","kind":"paragraph","spans":[{"id":"spn-55036","text":"Defense protocols: quarantine, circuit-break, escalate"}]}],"id":"blk-48809","kind":"list-item"},{"blocks":[{"id":"blk-48812","kind":"paragraph","spans":[{"id":"spn-55037","text":"Integration with OS-006 for permission revocation and OS-008 for circuit"}]}],"id":"blk-48811","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48813","kind":"paragraph","spans":[{"id":"spn-55038","text":"breaking"}]},{"id":"blk-48814","kind":"paragraph","spans":[{"id":"spn-55039","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55040","text":" OpenSentience security module (draft)"}]},{"id":"blk-48815","kind":"paragraph","spans":[{"id":"spn-55041","text":"---"}]},{"id":"blk-48816","kind":"heading","level":2,"spans":[{"id":"spn-55042","text":"OS-008: Agent Harness"}]},{"id":"blk-48817","kind":"paragraph","spans":[{"id":"spn-55043","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55044","text":" Supervisory attentional system (Norman & Shallice 1986)"}]},{"id":"blk-48818","kind":"paragraph","spans":[{"id":"spn-55045","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48819","items":[{"blocks":[{"id":"blk-48821","kind":"paragraph","spans":[{"id":"spn-55046","text":"Pipeline ordering enforcement (retrieve → route → act → learn)"}]}],"id":"blk-48820","kind":"list-item"},{"blocks":[{"id":"blk-48823","kind":"paragraph","spans":[{"id":"spn-55047","text":"Quality gates between pipeline stages"}]}],"id":"blk-48822","kind":"list-item"},{"blocks":[{"id":"blk-48825","kind":"paragraph","spans":[{"id":"spn-55048","text":"Sprint contracts: bounded execution with explicit goals and success criteria"}]}],"id":"blk-48824","kind":"list-item"},{"blocks":[{"id":"blk-48827","kind":"paragraph","spans":[{"id":"spn-55049","text":"Context management: 60% threshold, compaction, Graphonomous overflow"}]}],"id":"blk-48826","kind":"list-item"},{"blocks":[{"id":"blk-48829","kind":"paragraph","spans":[{"id":"spn-55050","text":"Generator-evaluator separation for adversarial grading"}]}],"id":"blk-48828","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48830","kind":"paragraph","spans":[{"id":"spn-55051","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55052","text":" OpenSentience harness module (draft)"}]},{"id":"blk-48831","kind":"paragraph","spans":[{"id":"spn-55053","text":"---"}]},{"id":"blk-48832","kind":"heading","level":2,"spans":[{"id":"spn-55054","text":"OS-009: PRISM — Protocol for Rating Iterative System Memory"}]},{"id":"blk-48833","kind":"paragraph","spans":[{"id":"spn-55055","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55056","text":" Meta-cognition + psychometrics (Item Response Theory, signal detection theory)"}]},{"id":"bl