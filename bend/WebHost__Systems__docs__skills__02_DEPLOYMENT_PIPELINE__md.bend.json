{"bendscript":"0.1","blocks":[{"id":"blk-24009","kind":"heading","level":1,"spans":[{"id":"spn-27450","text":"02 — Deployment Pipeline"}]},{"blocks":[{"id":"blk-24011","kind":"paragraph","spans":[{"id":"spn-27451","marks":["bold"],"text":"Purpose:"},{"id":"spn-27452","text":" How bundles are uploaded, validated, and deployed to runtime providers. Covers the immutable deployment model, version monotonicity, rollback mechanics, and the AgentCore container build pipeline."}]}],"id":"blk-24010","kind":"quote"},{"id":"blk-24012","kind":"paragraph","spans":[{"id":"spn-27453","text":"---"}]},{"id":"blk-24013","kind":"heading","level":2,"spans":[{"id":"spn-27454","text":"Deployment Model"}]},{"id":"blk-24014","kind":"paragraph","spans":[{"id":"spn-27455","text":"Deployments are "},{"id":"spn-27456","marks":["bold"],"text":"immutable records"},{"id":"spn-27457","text":". Once created, a deployment's artifact, version, and configuration never change. Only "},{"id":"spn-27458","marks":["code"],"text":"status"},{"id":"spn-27459","text":" and "},{"id":"spn-27460","marks":["code"],"text":"error_message"},{"id":"spn-27461","text":" are updated during the lifecycle. Rollback works by switching the agent's "},{"id":"spn-27462","marks":["code"],"text":"active_deployment_id"},{"id":"spn-27463","text":" pointer -- not by modifying old deployments."}]},{"id":"blk-24015","kind":"paragraph","spans":[{"id":"spn-27464","text":"---"}]},{"id":"blk-24016","kind":"heading","level":2,"spans":[{"id":"spn-27465","text":"Deployment Fields"}]},{"head":[{"id":"blk-24018","spans":[{"id":"spn-27466","text":"Field"}]},{"id":"blk-24019","spans":[{"id":"spn-27467","text":"Type"}]},{"id":"blk-24020","spans":[{"id":"spn-27468","text":"Description"}]}],"id":"blk-24017","kind":"table","rows":[[{"id":"blk-24021","spans":[{"id":"spn-27469","marks":["code"],"text":"id"}]},{"id":"blk-24022","spans":[{"id":"spn-27470","text":"UUID"}]},{"id":"blk-24023","spans":[{"id":"spn-27471","text":"Immutable deployment identifier"}]}],[{"id":"blk-24024","spans":[{"id":"spn-27472","marks":["code"],"text":"agent_id"}]},{"id":"blk-24025","spans":[{"id":"spn-27473","text":"UUID"}]},{"id":"blk-24026","spans":[{"id":"spn-27474","text":"Parent agent"}]}],[{"id":"blk-24027","spans":[{"id":"spn-27475","marks":["code"],"text":"version"}]},{"id":"blk-24028","spans":[{"id":"spn-27476","text":"int"}]},{"id":"blk-24029","spans":[{"id":"spn-27477","text":"Monotonically increasing per agent"}]}],[{"id":"blk-24030","spans":[{"id":"spn-27478","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24031","spans":[{"id":"spn-27479","text":"enum"}]},{"id":"blk-24032","spans":[{"id":"spn-27480","marks":["code"],"text":"cloudflare"},{"id":"spn-27481","text":" or "},{"id":"spn-27482","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24033","spans":[{"id":"spn-27483","marks":["code"],"text":"status"}]},{"id":"blk-24034","spans":[{"id":"spn-27484","text":"enum"}]},{"id":"blk-24035","spans":[{"id":"spn-27485","marks":["code"],"text":"deploying"},{"id":"spn-27486","text":" / "},{"id":"spn-27487","marks":["code"],"text":"active"},{"id":"spn-27488","text":" / "},{"id":"spn-27489","marks":["code"],"text":"failed"},{"id":"spn-27490","text":" / "},{"id":"spn-27491","marks":["code"],"text":"rolled_back"}]}],[{"id":"blk-24036","spans":[{"id":"spn-27492","marks":["code"],"text":"artifact"}]},{"id":"blk-24037","spans":[{"id":"spn-27493","text":"JSONB"}]},{"id":"blk-24038","spans":[{"id":"spn-27494","text":"Upload reference (checksum, size)"}]}],[{"id":"blk-24039","spans":[{"id":"spn-27495","marks":["code"],"text":"provider_ref"}]},{"id":"blk-24040","spans":[{"id":"spn-27496","text":"JSONB"}]},{"id":"blk-24041","spans":[{"id":"spn-27497","text":"Provider-specific deployment reference"}]}],[{"id":"blk-24042","spans":[{"id":"spn-27498","marks":["code"],"text":"commit_hash"}]},{"id":"blk-24043","spans":[{"id":"spn-27499","text":"string?"}]},{"id":"blk-24044","spans":[{"id":"spn-27500","text":"Optional git commit"}]}],[{"id":"blk-24045","spans":[{"id":"spn-27501","marks":["code"],"text":"error_message"}]},{"id":"blk-24046","spans":[{"id":"spn-27502","text":"string?"}]},{"id":"blk-24047","spans":[{"id":"spn-27503","text":"Failure details (sanitized, no secrets)"}]}]]},{"id":"blk-24048","kind":"paragraph","spans":[{"id":"spn-27504","text":"---"}]},{"id":"blk-24049","kind":"heading","level":2,"spans":[{"id":"spn-27505","text":"Deploy Flow"}]},{"id":"blk-24050","kind":"code","language":"text","text":"1. UI uploads bundle (zip/tar)\n2. POST /functions/v1/deploy\n3. Edge Function:\n   a. Validate bundle (see validation rules below)\n   b. INSERT deployment (status: deploying)\n   c. Call RPI adapter: deploy(artifact, config, secrets)\n   d. On success:\n      - UPDATE deployment status -> active\n      - SET agents.active_deployment_id = deployment.id\n      - SET agents.status -> active\n   e. On failure:\n      - UPDATE deployment status -> failed\n      - SET error_message\n      - SET agents.status -> error"},{"id":"blk-24051","kind":"paragraph","spans":[{"id":"spn-27506","text":"---"}]},{"id":"blk-24052","kind":"heading","level":2,"spans":[{"id":"spn-27507","text":"Required Manifest: "},{"id":"spn-27508","marks":["code"],"text":"agent.config.json"}]},{"id":"blk-24053","kind":"paragraph","spans":[{"id":"spn-27509","text":"Every bundle must include this file at the root:"}]},{"id":"blk-24054","kind":"code","language":"json","text":"{\n  \"entrypoint\": \"src/index.ts\",\n  \"runtime\": \"cloudflare\",\n  \"protocol\": \"invoke/v1\",\n  \"env\": {\n    \"requiredKeys\": [\"OPENAI_API_KEY\"],\n    \"optionalKeys\": [\"DEBUG\"]\n  },\n  \"capabilities\": {\n    \"streaming\": true,\n    \"tools\": false\n  }\n}"},{"head":[{"id":"blk-24056","spans":[{"id":"spn-27510","text":"Field"}]},{"id":"blk-24057","spans":[{"id":"spn-27511","text":"Required"}]},{"id":"blk-24058","spans":[{"id":"spn-27512","text":"Description"}]}],"id":"blk-24055","kind":"table","rows":[[{"id":"blk-24059","spans":[{"id":"spn-27513","marks":["code"],"text":"entrypoint"}]},{"id":"blk-24060","spans":[{"id":"spn-27514","text":"Yes"}]},{"id":"blk-24061","spans":[{"id":"spn-27515","text":"Path to main file"}]}],[{"id":"blk-24062","spans":[{"id":"spn-27516","marks":["code"],"text":"runtime"}]},{"id":"blk-24063","spans":[{"id":"spn-27517","text":"Yes"}]},{"id":"blk-24064","spans":[{"id":"spn-27518","text":"Must match agent's "},{"id":"spn-27519","marks":["code"],"text":"runtime_provider"}]}],[{"id":"blk-24065","spans":[{"id":"spn-27520","marks":["code"],"text":"protocol"}]},{"id":"blk-24066","spans":[{"id":"spn-27521","text":"Yes"}]},{"id":"blk-24067","spans":[{"id":"spn-27522","text":"Must be "},{"id":"spn-27523","marks":["code"],"text":"invoke/v1"}]}],[{"id":"blk-24068","spans":[{"id":"spn-27524","marks":["code"],"text":"env.requiredKeys"}]},{"id":"blk-24069","spans":[{"id":"spn-27525","text":"Yes"}]},{"id":"blk-24070","spans":[{"id":"spn-27526","text":"Secret keys that must exist in Vault"}]}],[{"id":"blk-24071","spans":[{"id":"spn-27527","marks":["code"],"text":"capabilities"}]},{"id":"blk-24072","spans":[{"id":"spn-27528","text":"Yes"}]},{"id":"blk-24073","spans":[{"id":"spn-27529","text":"Feature flags"}]}]]},{"id":"blk-24074","kind":"paragraph","spans":[{"id":"spn-27530","text":"---"}]},{"id":"blk-24075","kind":"heading","level":2,"spans":[{"id":"spn-27531","text":"Validation Rules (MUST)"}]},{"id":"blk-24076","items":[{"blocks":[{"id":"blk-24078","kind":"paragraph","spans":[{"id":"spn-27532","text":"[ ] "},{"id":"spn-27533","marks":["code"],"text":"agent.config.json"},{"id":"spn-27534","text":" exists and parses as valid JSON"}]}],"id":"blk-24077","kind":"list-item"},{"blocks":[{"id":"blk-24080","kind":"paragraph","spans":[{"id":"spn-27535","text":"[ ] "},{"id":"spn-27536","marks":["code"],"text":"entrypoint"},{"id":"spn-27537","text":" file exists in the bundle"}]}],"id":"blk-24079","kind":"list-item"},{"blocks":[{"id":"blk-24082","kind":"paragraph","spans":[{"id":"spn-27538","text":"[ ] "},{"id":"spn-27539","marks":["code"],"text":"runtime"},{"id":"spn-27540","text":" matches the agent's "},{"id":"spn-27541","marks":["code"],"text":"runtime_provider"}]}],"id":"blk-24081","kind":"list-item"},{"blocks":[{"id":"blk-24084","kind":"paragraph","spans":[{"id":"spn-27542","text":"[ ] "},{"id":"spn-27543","marks":["code"],"text":"protocol"},{"id":"spn-27544","text":" is "},{"id":"spn-27545","marks":["code"],"text":"invoke/v1"}]}],"id":"blk-24083","kind":"list-item"},{"blocks":[{"id":"blk-24086","kind":"paragraph","spans":[{"id":"spn-27546","text":"[ ] Bundle size within limits (compressed and extracted)"}]}],"id":"blk-24085","kind":"list-item"},{"blocks":[{"id":"blk-24088","kind":"paragraph","spans":[{"id":"spn-27547","text":"[ ] File count within limits"}]}],"id":"blk-24087","kind":"list-item"},{"blocks":[{"id":"blk-24090","kind":"paragraph","spans":[{"id":"spn-27548","text":"[ ] No path traversal entries or unsafe symlinks"}]}],"id":"blk-24089","kind":"list-item"},{"blocks":[{"id":"blk-24092","kind":"paragraph","spans":[{"id":"spn-27549","text":"[ ] Version is strictly greater than the previous deployment's version"}]}],"id":"blk-24091","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24093","kind":"paragraph","spans":[{"id":"spn-27550","text":"---"}]},{"id":"blk-24094","kind":"heading","level":2,"spans":[{"id":"spn-27551","text":"Version Monotonicity"}]},{"id":"blk-24095","kind":"paragraph","spans":[{"id":"spn-27552","text":"Versions are monotonically increasing integers per agent. The platform auto-assigns the next version if not provided. Attempting to deploy a version less than or equal to the current maximum is rejected."}]},{"id":"blk-24096","kind":"code","language":"text","text":"agent_id | version | status\n---------+---------+--------\nabc      | 1       | rolled_back\nabc      | 2       | rolled_back\nabc      | 3       | active     <-- current"},{"id":"blk-24097","kind":"paragraph","spans":[{"id":"spn-27553","text":"---"}]},{"id":"blk-24098","kind":"heading","level":2,"spans":[{"id":"spn-27554","text":"Rollback"}]},{"id":"blk-24099","kind":"paragraph","spans":[{"id":"spn-27555","text":"Rollback does "},{"id":"spn-27556","marks":["bold"],"text":"not"},{"id":"spn-27557","text":" create a new deployment. It switches the active pointer:"}]},{"id":"blk-24100","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/rollback_deployment\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"deployment_id\": \"<target-uuid>\" }'"},{"id":"blk-24101","kind":"paragraph","spans":[{"id":"spn-27558","text":"The target deployment must have status "},{"id":"spn-27559","marks":["code"],"text":"active"},{"id":"spn-27560","text":" or "},{"id":"spn-27561","marks":["code"],"text":"rolled_back"},{"id":"spn-27562","text":" and belong to the same agent. The current active deployment is marked "},{"id":"spn-27563","marks":["code"],"text":"rolled_back"},{"id":"spn-27564","text":"."}]},{"id":"blk-24102","kind":"paragraph","spans":[{"id":"spn-27565","text":"---"}]},{"id":"blk-24103","kind":"heading","level":2,"spans":[{"id":"spn-27566","text":"AgentCore Container Build Pipeline"}]},{"id":"blk-24104","kind":"paragraph","spans":[{"id":"spn-27567","text":"When "},{"id":"spn-27568","marks":["code"],"text":"runtime=agentcore"},{"id":"spn-27569","text":", the control plane converts the uploaded bundle into a container image:"}]},{"id":"blk-24105","kind":"code","language":"text","text":"1. Extract and validate archive\n2. Build user code (TypeScript -> Node.js 20 artifact)\n3. Generate HTTP wrapper (invoke/v1 handler)\n4. Build OCI container image\n5. Push to ECR registry\n6. Create/update AgentCore runtime with image URI\n7. Inject env vars (telemetry key + user secrets)"},{"id":"blk-24106","kind":"paragraph","spans":[{"id":"spn-27570","text":"The pipeline is idempotent per "},{"id":"spn-27571","marks":["code"],"text":"deployment_id"},{"id":"spn-27572","text":" -- retries produce the same provider state."}]},{"id":"blk-24107","kind":"paragraph","spans":[{"id":"spn-27573","text":"---"}]},{"id":"blk-24108","kind":"heading","level":2,"spans":[{"id":"spn-27574","text":"Concurrent Deploy Guard"}]},{"id":"blk-24109","kind":"paragraph","spans":[{"id":"spn-27575","text":"Only one deployment can be in "},{"id":"spn-27576","marks":["code"],"text":"deploying"},{"id":"spn-27577","text":" status per agent at a time. The Edge Function must check for existing in-progress deployments and reject concurrent attempts with an appropriate error."}]},{"id":"blk-24110","kind":"paragraph","spans":[{"id":"spn-27578","text":"---"}]},{"id":"blk-24111","kind":"heading","level":2,"spans":[{"id":"spn-27579","text":"Checklist"}]},{"id":"blk-24112","items":[{"blocks":[{"id":"blk-24114","kind":"paragraph","spans":[{"id":"spn-27580","text":"[ ] Bundle includes valid "},{"id":"spn-27581","marks":["code"],"text":"agent.config.json"}]}],"id":"blk-24113","kind":"list-item"},{"blocks":[{"id":"blk-24116","kind":"paragraph","spans":[{"id":"spn-27582","text":"[ ] Entrypoint file exists"}]}],"id":"blk-24115","kind":"list-item"},{"blocks":[{"id":"blk-24118","kind":"paragraph","spans":[{"id":"spn-27583","text":"[ ] Runtime matches agent configuration"}]}],"id":"blk-24117","kind":"list-item"},{"blocks":[{"id":"blk-24120","kind":"paragraph","spans":[{"id":"spn-27584","text":"[ ] Version is monotonically increasing"}]}],"id":"blk-24119","kind":"list-item"},{"blocks":[{"id":"blk-24122","kind":"paragraph","spans":[{"id":"spn-27585","text":"[ ] Bundle passes size and file count limits"}]}],"id":"blk-24121","kind":"list-item"},{"blocks":[{"id":"blk-24124","kind":"paragraph","spans":[{"id":"spn-27586","text":"[ ] No concurrent deploys for the same agent"}]}],"id":"blk-24123","kind":"list-item"},{"blocks":[{"id":"blk-24126","kind":"paragraph","spans":[{"id":"spn-27587","text":"[ ] Secrets referenced in manifest exist in Vault"}]}],"id":"blk-24125","kind":"list-item"},{"blocks":[{"id":"blk-24128","kind":"paragraph","spans":[{"id":"spn-27588","text":"[ ] Deployment record is immutable after creation (except status/error)"}]}],"id":"blk-24127","kind":"list-item"},{"blocks":[{"id":"blk-24130","kind":"paragraph","spans":[{"id":"spn-27589","text":"[ ] AgentCore builds produce deterministic container images"}]}],"id":"blk-24129","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierapwu4jzzqimelawgmhlq2spog3emfva3czyve62ancpzfkspj56sa","vocabulary":"ampersand.docs.fs.v1"}