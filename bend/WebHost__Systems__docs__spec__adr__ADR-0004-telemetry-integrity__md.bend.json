{"bendscript":"0.1","blocks":[{"id":"blk-31903","kind":"heading","level":1,"spans":[{"id":"spn-34684","text":"ADR-0004: Telemetry Integrity & Attribution Model (Deployment-Scoped Signed Events)"}]},{"id":"blk-31904","kind":"paragraph","spans":[{"id":"spn-34685","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-31905","items":[{"blocks":[{"id":"blk-31907","kind":"paragraph","spans":[{"id":"spn-34686","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-31906","kind":"list-item"},{"blocks":[{"id":"blk-31909","kind":"paragraph","spans":[{"id":"spn-34687","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-31908","kind":"list-item"},{"blocks":[{"id":"blk-31911","kind":"paragraph","spans":[{"id":"spn-34688","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-31910","kind":"list-item"},{"blocks":[{"id":"blk-31913","kind":"paragraph","spans":[{"id":"spn-34689","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-31912","kind":"list-item"},{"blocks":[{"id":"blk-31915","kind":"paragraph","spans":[{"id":"spn-34690","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-31914","kind":"list-item"},{"blocks":[{"id":"blk-31917","kind":"paragraph","spans":[{"id":"spn-34691","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-31916","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31918","kind":"heading","level":2,"spans":[{"id":"spn-34692","text":"Context"}]},{"id":"blk-31919","kind":"paragraph","spans":[{"id":"spn-34693","text":"webhost.systems is a multi-runtime AI agent platform. For each invocation executed in the data plane (Cloudflare Workers/DO or AWS Bedrock AgentCore), the platform must record usage and operational telemetry for:"}]},{"id":"blk-31920","items":[{"blocks":[{"id":"blk-31922","kind":"paragraph","spans":[{"id":"spn-34694","text":"plan enforcement (requests/tokens/compute limits),"}]}],"id":"blk-31921","kind":"list-item"},{"blocks":[{"id":"blk-31924","kind":"paragraph","spans":[{"id":"spn-34695","text":"cost estimation (v1: estimated cost),"}]}],"id":"blk-31923","kind":"list-item"},{"blocks":[{"id":"blk-31926","kind":"paragraph","spans":[{"id":"spn-34696","text":"billing integrity (tier gating and upgrade flows),"}]}],"id":"blk-31925","kind":"list-item"},{"blocks":[{"id":"blk-31928","kind":"paragraph","spans":[{"id":"spn-34697","text":"observability (error rates, latency/compute, tool usage),"}]}],"id":"blk-31927","kind":"list-item"},{"blocks":[{"id":"blk-31930","kind":"paragraph","spans":[{"id":"spn-34698","text":"audits and support (traceability via "},{"id":"spn-34699","marks":["code"],"text":"traceId"},{"id":"spn-34700","text":", deploy version, runtime)."}]}],"id":"blk-31929","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31931","kind":"paragraph","spans":[{"id":"spn-34701","text":"Telemetry is consumed by the control plane and stored as append-only raw events ("},{"id":"spn-34702","marks":["code"],"text":"metricsEvents"},{"id":"spn-34703","text":") and aggregated views ("},{"id":"spn-34704","marks":["code"],"text":"billingUsage"},{"id":"spn-34705","text":")."}]},{"id":"blk-31932","kind":"heading","level":3,"spans":[{"id":"spn-34706","text":"Problem statement"}]},{"id":"blk-31933","kind":"paragraph","spans":[{"id":"spn-34707","text":"Telemetry is a critical security and business integrity surface. If telemetry is spoofable or not attributable, an attacker (or buggy runtime) could:"}]},{"id":"blk-31934","items":[{"blocks":[{"id":"blk-31936","kind":"paragraph","spans":[{"id":"spn-34708","text":"underreport usage to avoid limits or billing,"}]}],"id":"blk-31935","kind":"list-item"},{"blocks":[{"id":"blk-31938","kind":"paragraph","spans":[{"id":"spn-34709","text":"overreport usage to sabotage another tenant,"}]}],"id":"blk-31937","kind":"list-item"},{"blocks":[{"id":"blk-31940","kind":"paragraph","spans":[{"id":"spn-34710","text":"inject events for another tenant’s agents/deployments,"}]}],"id":"blk-31939","kind":"list-item"},{"blocks":[{"id":"blk-31942","kind":"paragraph","spans":[{"id":"spn-34711","text":"create ambiguity in chargeback attribution across runtimes,"}]}],"id":"blk-31941","kind":"list-item"},{"blocks":[{"id":"blk-31944","kind":"paragraph","spans":[{"id":"spn-34712","text":"break observability and incident response."}]}],"id":"blk-31943","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31945","kind":"paragraph","spans":[{"id":"spn-34713","text":"Therefore telemetry ingestion must ensure:"}]},{"id":"blk-31946","kind":"paragraph","spans":[{"id":"spn-34714","text":"1. "},{"id":"spn-34715","marks":["bold"],"text":"Integrity"},{"id":"spn-34716","text":": payload not tampered in transit. 2. "},{"id":"spn-34717","marks":["bold"],"text":"Authenticity"},{"id":"spn-34718","text":": sender is an authorized runtime deployment. 3. "},{"id":"spn-34719","marks":["bold"],"text":"Attribution"},{"id":"spn-34720","text":": event belongs to exactly one "},{"id":"spn-34721","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-34722","text":". 4. "},{"id":"spn-34723","marks":["bold"],"text":"Replay safety"},{"id":"spn-34724","text":": retries do not double count; attackers cannot re-submit old events to alter usage. 5. "},{"id":"spn-34725","marks":["bold"],"text":"No secrets leakage"},{"id":"spn-34726","text":": telemetry must never include secret values, and telemetry auth secrets must not be stored as plaintext."}]},{"id":"blk-31947","kind":"paragraph","spans":[{"id":"spn-34727","text":"Constraints:"}]},{"id":"blk-31948","items":[{"blocks":[{"id":"blk-31950","kind":"paragraph","spans":[{"id":"spn-34728","text":"Data plane runtimes are heterogeneous and may differ in what usage details they can report."}]}],"id":"blk-31949","kind":"list-item"},{"blocks":[{"id":"blk-31952","kind":"paragraph","spans":[{"id":"spn-34729","text":"Customer agent code is untrusted; it may attempt to forge telemetry or call arbitrary endpoints."}]}],"id":"blk-31951","kind":"list-item"},{"blocks":[{"id":"blk-31954","kind":"paragraph","spans":[{"id":"spn-34730","text":"Telemetry ingestion must not rely on browser sessions/cookies."}]}],"id":"blk-31953","kind":"list-item"},{"blocks":[{"id":"blk-31956","kind":"paragraph","spans":[{"id":"spn-34731","text":"The system must remain implementable for v1 without introducing a full centralized vault or complex PKI."}]}],"id":"blk-31955","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31957","kind":"heading","level":2,"spans":[{"id":"spn-34732","text":"Decision"}]},{"id":"blk-31958","kind":"paragraph","spans":[{"id":"spn-34733","text":"Adopt a "},{"id":"spn-34734","marks":["bold"],"text":"deployment-scoped signed telemetry event"},{"id":"spn-34735","text":" model with "},{"id":"spn-34736","marks":["bold"],"text":"ownership cross-checking"},{"id":"spn-34737","text":" at ingestion."}]},{"id":"blk-31959","kind":"heading","level":3,"spans":[{"id":"spn-34738","text":"Decision summary (normative)"}]},{"id":"blk-31960","kind":"paragraph","spans":[{"id":"spn-34739","text":"1. "},{"id":"spn-34740","marks":["bold"],"text":"Attribution is mandatory"},{"id":"spn-34741","text":" Every telemetry event MUST be attributable to:"}]},{"id":"blk-31961","items":[{"blocks":[{"id":"blk-31963","kind":"paragraph","spans":[{"id":"spn-34742","marks":["code"],"text":"userId"}]}],"id":"blk-31962","kind":"list-item"},{"blocks":[{"id":"blk-31965","kind":"paragraph","spans":[{"id":"spn-34743","marks":["code"],"text":"agentId"}]}],"id":"blk-31964","kind":"list-item"},{"blocks":[{"id":"blk-31967","kind":"paragraph","spans":[{"id":"spn-34744","marks":["code"],"text":"deploymentId"}]}],"id":"blk-31966","kind":"list-item"},{"blocks":[{"id":"blk-31969","kind":"paragraph","spans":[{"id":"spn-34745","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-31968","kind":"list-item"},{"blocks":[{"id":"blk-31971","kind":"paragraph","spans":[{"id":"spn-34746","marks":["code"],"text":"timestamp"}]}],"id":"blk-31970","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31972","kind":"paragraph","spans":[{"id":"spn-34747","text":"2. "},{"id":"spn-34748","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped HMAC signatures (v1)"}]},{"id":"blk-31973","items":[{"blocks":[{"id":"blk-31975","kind":"paragraph","spans":[{"id":"spn-34749","text":"Each deployment has a unique "},{"id":"spn-34750","marks":["code"],"text":"telemetrySecret"},{"id":"spn-34751","text":" (HMAC key), generated by the control plane."}]}],"id":"blk-31974","kind":"list-item"},{"blocks":[{"id":"blk-31977","kind":"paragraph","spans":[{"id":"spn-34752","text":"The "},{"id":"spn-34753","marks":["code"],"text":"telemetrySecret"},{"id":"spn-34754","text":" is injected into the deployed runtime using provider secret mechanisms."}]}],"id":"blk-31976","kind":"list-item"},{"blocks":[{"id":"blk-31979","kind":"paragraph","spans":[{"id":"spn-34755","text":"Data plane submits telemetry to the control plane ingestion endpoint with:"}]}],"id":"blk-31978","kind":"list-item"},{"blocks":[{"id":"blk-31981","kind":"paragraph","spans":[{"id":"spn-34756","text":"header "},{"id":"spn-34757","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-31980","kind":"list-item"},{"blocks":[{"id":"blk-31983","kind":"paragraph","spans":[{"id":"spn-34758","text":"header "},{"id":"spn-34759","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex(hmac_sha256(raw_body_bytes, telemetrySecret))>"}]}],"id":"blk-31982","kind":"list-item"},{"blocks":[{"id":"blk-31985","kind":"paragraph","spans":[{"id":"spn-34760","text":"Control plane verifies:"}]}],"id":"blk-31984","kind":"list-item"},{"blocks":[{"id":"blk-31987","kind":"paragraph","spans":[{"id":"spn-34761","text":"signature validity (using deployment-scoped secret reference),"}]}],"id":"blk-31986","kind":"list-item"},{"blocks":[{"id":"blk-31989","kind":"paragraph","spans":[{"id":"spn-34762","text":"ownership mapping: deployment belongs to the agent and user in the payload,"}]}],"id":"blk-31988","kind":"list-item"},{"blocks":[{"id":"blk-31991","kind":"paragraph","spans":[{"id":"spn-34763","text":"required fields and enums."}]}],"id":"blk-31990","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31992","kind":"paragraph","spans":[{"id":"spn-34764","text":"3. "},{"id":"spn-34765","marks":["bold"],"text":"Ingestion performs ownership cross-check (defense in depth)"},{"id":"spn-34766","text":" After signature validation, ingestion MUST query control plane data and verify:"}]},{"id":"blk-31993","items":[{"blocks":[{"id":"blk-31995","kind":"paragraph","spans":[{"id":"spn-34767","marks":["code"],"text":"deployments._id == deploymentId"}]}],"id":"blk-31994","kind":"list-item"},{"blocks":[{"id":"blk-31997","kind":"paragraph","spans":[{"id":"spn-34768","marks":["code"],"text":"deployments.agentId == agentId"}]}],"id":"blk-31996","kind":"list-item"},{"blocks":[{"id":"blk-31999","kind":"paragraph","spans":[{"id":"spn-34769","marks":["code"],"text":"deployments.userId == userId"}]}],"id":"blk-31998","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32000","kind":"paragraph","spans":[{"id":"spn-34770","text":"If any mismatch: reject the event, optionally record an "},{"id":"spn-34771","marks":["code"],"text":"auditLog"},{"id":"spn-34772","text":" entry with sanitized details."}]},{"id":"blk-32001","kind":"paragraph","spans":[{"id":"spn-34773","text":"4. "},{"id":"spn-34774","marks":["bold"],"text":"Telemetry does not use user auth"},{"id":"spn-34775","text":" Telemetry ingestion MUST NOT accept browser session cookies as authentication. Telemetry is authenticated solely by deployment-scoped signature (and optional anti-replay)."}]},{"id":"blk-32002","kind":"paragraph","spans":[{"id":"spn-34776","text":"5. "},{"id":"spn-34777","marks":["bold"],"text":"Replay/dedupe (recommended in v1; mandatory before public invocations)"},{"id":"spn-34778","text":" Telemetry ingestion SHOULD implement one of:"}]},{"id":"blk-32003","items":[{"blocks":[{"id":"blk-32005","kind":"paragraph","spans":[{"id":"spn-34779","marks":["code"],"text":"eventId"},{"id":"spn-34780","text":" (UUID generated by data plane) + short-window dedupe store, OR"}]}],"id":"blk-32004","kind":"list-item"},{"blocks":[{"id":"blk-32007","kind":"paragraph","spans":[{"id":"spn-34781","text":"dedupe on "},{"id":"spn-34782","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-34783","text":" if "},{"id":"spn-34784","marks":["code"],"text":"traceId"},{"id":"spn-34785","text":" uniqueness per invocation is guaranteed."}]}],"id":"blk-32006","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32008","kind":"paragraph","spans":[{"id":"spn-34786","text":"In either case, ingestion must be idempotent under retries to prevent double counting."}]},{"id":"blk-32009","kind":"paragraph","spans":[{"id":"spn-34787","text":"6. "},{"id":"spn-34788","marks":["bold"],"text":"Secrets are never stored as plaintext in the primary DB"}]},{"id":"blk-32010","items":[{"blocks":[{"id":"blk-32012","kind":"paragraph","spans":[{"id":"spn-34789","text":"The primary DB stores only metadata and secret references (e.g., provider secret name/id)."}]}],"id":"blk-32011","kind":"list-item"},{"blocks":[{"id":"blk-32014","kind":"paragraph","spans":[{"id":"spn-34790","text":"The "},{"id":"spn-34791","marks":["code"],"text":"telemetrySecret"},{"id":"spn-34792","text":" value MUST NOT be stored in plaintext in the primary database (Supabase)."}]}],"id":"blk-32013","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32015","kind":"heading","level":3,"spans":[{"id":"spn-34793","text":"Provider-specific telemetry capabilities (implementation guidance)"}]},{"id":"blk-32016","kind":"paragraph","spans":[{"id":"spn-34794","text":"This ADR standardizes telemetry ingestion on "},{"id":"spn-34795","marks":["bold"],"text":"deployment-scoped signed events"},{"id":"spn-34796","text":" for all runtimes. Provider capabilities vary, but the v1 baseline remains consistent."}]},{"id":"blk-32017","kind":"paragraph","spans":[{"id":"spn-34797","marks":["bold"],"text":"Cloudflare (Workers + Durable Objects):"}]},{"id":"blk-32018","items":[{"blocks":[{"id":"blk-32020","kind":"paragraph","spans":[{"id":"spn-34798","text":"The runtime MUST explicitly emit telemetry to the control plane (Pattern A: in-workload emission is the preferred approach)."}]}],"id":"blk-32019","kind":"list-item"},{"blocks":[{"id":"blk-32022","kind":"paragraph","spans":[{"id":"spn-34799","text":"The telemetry signing secret is injected via Worker secret bindings."}]}],"id":"blk-32021","kind":"list-item"},{"blocks":[{"id":"blk-32024","kind":"paragraph","spans":[{"id":"spn-34800","text":"The Worker/DO submits "},{"id":"spn-34801","marks":["code"],"text":"POST /v1/telemetry/report"},{"id":"spn-34802","text":" with "},{"id":"spn-34803","marks":["code"],"text":"X-Telemetry-Deployment-Id"},{"id":"spn-34804","text":" and "},{"id":"spn-34805","marks":["code"],"text":"X-Telemetry-Signature"},{"id":"spn-34806","text":"."}]}],"id":"blk-32023","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32025","kind":"paragraph","spans":[{"id":"spn-34807","marks":["bold"],"text":"AgentCore (AWS Bedrock AgentCore):"}]},{"id":"blk-32026","items":[{"blocks":[{"id":"blk-32028","kind":"paragraph","spans":[{"id":"spn-34808","text":"AgentCore may provide provider-native observability capabilities (e.g., service-level telemetry/OTel-style integrations) that can be valuable for deep debugging."}]}],"id":"blk-32027","kind":"list-item"},{"blocks":[{"id":"blk-32030","kind":"paragraph","spans":[{"id":"spn-34809","marks":["bold"],"text":"v1 baseline:"},{"id":"spn-34810","text":" use the same direct signed submission model as Cloudflare (either in-workload emission when feasible, or adapter-side emission when required by provider constraints) to keep metering, limits, and billing semantics consistent across runtimes."}]}],"id":"blk-32029","kind":"list-item"},{"blocks":[{"id":"blk-32032","kind":"paragraph","spans":[{"id":"spn-34811","marks":["bold"],"text":"post-v1 enhancement:"},{"id":"spn-34812","text":" integrate provider-native observability for richer traces while still emitting the normalized, signed metering event used for billing and limits."}]}],"id":"blk-32031","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32033","kind":"heading","level":2,"spans":[{"id":"spn-34813","text":"Rationale"}]},{"id":"blk-32034","kind":"paragraph","spans":[{"id":"spn-34814","text":"This approach satisfies the requirements with minimal complexity:"}]},{"id":"blk-32035","items":[{"blocks":[{"id":"blk-32037","kind":"paragraph","spans":[{"id":"spn-34815","marks":["bold"],"text":"Integrity and authenticity"},{"id":"spn-34816","text":": HMAC signatures prevent tampering and authenticate possession of a deployment-scoped secret."}]}],"id":"blk-32036","kind":"list-item"},{"blocks":[{"id":"blk-32039","kind":"paragraph","spans":[{"id":"spn-34817","marks":["bold"],"text":"Tenant protection"},{"id":"spn-34818","text":": ownership cross-check prevents a compromised deployment secret from being used to write events for a different agent or user."}]}],"id":"blk-32038","kind":"list-item"},{"blocks":[{"id":"blk-32041","kind":"paragraph","spans":[{"id":"spn-34819","marks":["bold"],"text":"Least privilege"},{"id":"spn-34820","text":": deployment-scoped secret limits blast radius if compromised."}]}],"id":"blk-32040","kind":"list-item"},{"blocks":[{"id":"blk-32043","kind":"paragraph","spans":[{"id":"spn-34821","marks":["bold"],"text":"Provider portability"},{"id":"spn-34822","text":": works across runtimes because it relies on a generic “can send HTTP + store secret” capability."}]}],"id":"blk-32042","kind":"list-item"},{"blocks":[{"id":"blk-32045","kind":"paragraph","spans":[{"id":"spn-34823","marks":["bold"],"text":"Operable MVP"},{"id":"spn-34824","text":": avoids the need for PKI or an always-online centralized vault, while still enabling strong guarantees."}]}],"id":"blk-32044","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32046","kind":"heading","level":2,"spans":[{"id":"spn-34825","text":"Alternatives considered"}]},{"id":"blk-32047","kind":"heading","level":3,"spans":[{"id":"spn-34826","text":"A) Trust telemetry without signatures (reject)"}]},{"id":"blk-32048","kind":"paragraph","spans":[{"id":"spn-34827","marks":["bold"],"text":"Pros"}]},{"id":"blk-32049","items":[{"blocks":[{"id":"blk-32051","kind":"paragraph","spans":[{"id":"spn-34828","text":"Easiest to implement."}]}],"id":"blk-32050","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32052","kind":"paragraph","spans":[{"id":"spn-34829","marks":["bold"],"text":"Cons"}]},{"id":"blk-32053","items":[{"blocks":[{"id":"blk-32055","kind":"paragraph","spans":[{"id":"spn-34830","text":"Enables trivial spoofing and billing manipulation."}]}],"id":"blk-32054","kind":"list-item"},{"blocks":[{"id":"blk-32057","kind":"paragraph","spans":[{"id":"spn-34831","text":"Allows cross-tenant sabotage and incorrect usage enforcement."}]}],"id":"blk-32056","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32058","kind":"paragraph","spans":[{"id":"spn-34832","marks":["bold"],"text":"Decision"},{"id":"spn-34833","text":" Rejected. Not acceptable for any paid system with limits and billing."}]},{"id":"blk-32059","kind":"heading","level":3,"spans":[{"id":"spn-34834","text":"B) Adapter-side telemetry only (partial alternative)"}]},{"id":"blk-32060","kind":"paragraph","spans":[{"id":"spn-34835","text":"Telemetry is emitted only by the control plane adapter after it receives provider responses."}]},{"id":"blk-32061","kind":"paragraph","spans":[{"id":"spn-34836","marks":["bold"],"text":"Pros"}]},{"id":"blk-32062","items":[{"blocks":[{"id":"blk-32064","kind":"paragraph","spans":[{"id":"spn-34837","text":"Avoids injecting telemetry secrets into runtime code."}]}],"id":"blk-32063","kind":"list-item"},{"blocks":[{"id":"blk-32066","kind":"paragraph","spans":[{"id":"spn-34838","text":"Avoids runtime outbound call to control plane."}]}],"id":"blk-32065","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32067","kind":"paragraph","spans":[{"id":"spn-34839","marks":["bold"],"text":"Cons"}]},{"id":"blk-32068","items":[{"blocks":[{"id":"blk-32070","kind":"paragraph","spans":[{"id":"spn-34840","text":"Often cannot capture provider-specific usage (compute/tool usage) reliably."}]}],"id":"blk-32069","kind":"list-item"},{"blocks":[{"id":"blk-32072","kind":"paragraph","spans":[{"id":"spn-34841","text":"Creates attribution gaps if invocations happen outside the adapter path or if provider returns incomplete usage."}]}],"id":"blk-32071","kind":"list-item"},{"blocks":[{"id":"blk-32074","kind":"paragraph","spans":[{"id":"spn-34842","text":"Weakens correlation with runtime events and can undercount."}]}],"id":"blk-32073","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32075","kind":"paragraph","spans":[{"id":"spn-34843","marks":["bold"],"text":"Decision"},{"id":"spn-34844","text":" Not the primary model. Allowed as a constrained fallback if a provider cannot support in-workload emission, but must preserve integrity and attribution. If adapter emits, it must still attach to a deployment and enforce ownership; it must not be forgeable by clients."}]},{"id":"blk-32076","kind":"heading","level":3,"spans":[{"id":"spn-34845","text":"C) Per-user telemetry keys (reject)"}]},{"id":"blk-32077","kind":"paragraph","spans":[{"id":"spn-34846","text":"Use one key per user shared across all deployments."}]},{"id":"blk-32078","kind":"paragraph","spans":[{"id":"spn-34847","marks":["bold"],"text":"Pros"}]},{"id":"blk-32079","items":[{"blocks":[{"id":"blk-32081","kind":"paragraph","spans":[{"id":"spn-34848","text":"Fewer secrets."}]}],"id":"blk-32080","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32082","kind":"paragraph","spans":[{"id":"spn-34849","marks":["bold"],"text":"Cons"}]},{"id":"blk-32083","items":[{"blocks":[{"id":"blk-32085","kind":"paragraph","spans":[{"id":"spn-34850","text":"Massive blast radius if compromised; compromised deployment can spoof across all user deployments."}]}],"id":"blk-32084","kind":"list-item"},{"blocks":[{"id":"blk-32087","kind":"paragraph","spans":[{"id":"spn-34851","text":"Harder to rotate safely and isolate issues."}]}],"id":"blk-32086","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32088","kind":"paragraph","spans":[{"id":"spn-34852","marks":["bold"],"text":"Decision"},{"id":"spn-34853","text":" Rejected. Deployment-scoped keys are safer and align with immutability and auditability."}]},{"id":"blk-32089","kind":"heading","level":3,"spans":[{"id":"spn-34854","text":"D) Public-key signatures (PKI) per deployment (defer)"}]},{"id":"blk-32090","kind":"paragraph","spans":[{"id":"spn-34855","text":"Each deployment gets a keypair; telemetry signed with private key, verified with public key."}]},{"id":"blk-32091","kind":"paragraph","spans":[{"id":"spn-34856","marks":["bold"],"text":"Pros"}]},{"id":"blk-32092","items":[{"blocks":[{"id":"blk-32094","kind":"paragraph","spans":[{"id":"spn-34857","text":"No shared secret at ingestion; avoids secret distribution to verifier."}]}],"id":"blk-32093","kind":"list-item"},{"blocks":[{"id":"blk-32096","kind":"paragraph","spans":[{"id":"spn-34858","text":"Strong cryptographic model."}]}],"id":"blk-32095","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32097","kind":"paragraph","spans":[{"id":"spn-34859","marks":["bold"],"text":"Cons"}]},{"id":"blk-32098","items":[{"blocks":[{"id":"blk-32100","kind":"paragraph","spans":[{"id":"spn-34860","text":"Adds key management complexity; still needs secure private key injection to runtime."}]}],"id":"blk-32099","kind":"list-item"},{"blocks":[{"id":"blk-32102","kind":"paragraph","spans":[{"id":"spn-34861","text":"Higher implementation overhead for v1 without clear ROI."}]}],"id":"blk-32101","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32103","kind":"paragraph","spans":[{"id":"spn-34862","marks":["bold"],"text":"Decision"},{"id":"spn-34863","text":" Deferred. Consider post-v1 if you need stronger non-repudiation or third-party verification."}]},{"id":"blk-32104","kind":"heading","level":3,"spans":[{"id":"spn-34864","text":"E) mTLS between data plane and control plane (defer)"}]},{"id":"blk-32105","kind":"paragraph","spans":[{"id":"spn-34865","text":"Use mutual TLS with client certs per deployment."}]},{"id":"blk-32106","kind":"paragraph","spans":[{"id":"spn-34866","marks":["bold"],"text":"Pros"}]},{"id":"blk-32107","items":[{"blocks":[{"id":"blk-32109","kind":"paragraph","spans":[{"id":"spn-34867","text":"Strong channel-level authentication."}]}],"id":"blk-32108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32110","kind":"paragraph","spans":[{"id":"spn-34868","marks":["bold"],"text":"Cons"}]},{"id":"blk-32111","items":[{"blocks":[{"id":"blk-32113","kind":"paragraph","spans":[{"id":"spn-34869","text":"Operationally heavy; certificate issuance/rotation complexity."}]}],"id":"blk-32112","kind":"list-item"},{"blocks":[{"id":"blk-32115","kind":"paragraph","spans":[{"id":"spn-34870","text":"Hard to implement uniformly across runtimes."}]}],"id":"blk-32114","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32116","kind":"paragraph","spans":[{"id":"spn-34871","marks":["bold"],"text":"Decision"},{"id":"spn-34872","text":" Deferred. Potential future hardening for enterprise tiers."}]},{"id":"blk-32117","kind":"heading","level":2,"spans":[{"id":"spn-34873","text":"Detailed design (normative)"}]},{"id":"blk-32118","kind":"heading","level":3,"spans":[{"id":"spn-34874","text":"1) Telemetry event schema (minimum viable)"}]},{"id":"blk-32119","kind":"paragraph","spans":[{"id":"spn-34875","text":"Telemetry payload MUST include:"}]},{"id":"blk-32120","items":[{"blocks":[{"id":"blk-32122","kind":"paragraph","spans":[{"id":"spn-34876","marks":["code"],"text":"userId"},{"id":"spn-34877","text":" (internal id)"}]}],"id":"blk-32121","kind":"list-item"},{"blocks":[{"id":"blk-32124","kind":"paragraph","spans":[{"id":"spn-34878","marks":["code"],"text":"agentId"}]}],"id":"blk-32123","kind":"list-item"},{"blocks":[{"id":"blk-32126","kind":"paragraph","spans":[{"id":"spn-34879","marks":["code"],"text":"deploymentId"}]}],"id":"blk-32125","kind":"list-item"},{"blocks":[{"id":"blk-32128","kind":"paragraph","spans":[{"id":"spn-34880","marks":["code"],"text":"runtimeProvider"},{"id":"spn-34881","text":" ("},{"id":"spn-34882","marks":["code"],"text":"cloudflare"},{"id":"spn-34883","text":" | "},{"id":"spn-34884","marks":["code"],"text":"agentcore"},{"id":"spn-34885","text":")"}]}],"id":"blk-32127","kind":"list-item"},{"blocks":[{"id":"blk-32130","kind":"paragraph","spans":[{"id":"spn-34886","marks":["code"],"text":"timestamp"},{"id":"spn-34887","text":" (RFC3339 or unix ms; ingestion converts to unix ms)"}]}],"id":"blk-32129","kind":"list-item"},{"blocks":[{"id":"blk-32132","kind":"paragraph","spans":[{"id":"spn-34888","marks":["code"],"text":"requests"},{"id":"spn-34889","text":" (typically 1)"}]}],"id":"blk-32131","kind":"list-item"},{"blocks":[{"id":"blk-32134","kind":"paragraph","spans":[{"id":"spn-34890","marks":["code"],"text":"llmTokens"},{"id":"spn-34891","text":" (reported or estimated)"}]}],"id":"blk-32133","kind":"list-item"},{"blocks":[{"id":"blk-32136","kind":"paragraph","spans":[{"id":"spn-34892","marks":["code"],"text":"computeMs"},{"id":"spn-34893","text":" (wall time or billed time, defined per provider)"}]}],"id":"blk-32135","kind":"list-item"},{"blocks":[{"id":"blk-32138","kind":"paragraph","spans":[{"id":"spn-34894","marks":["code"],"text":"errors"},{"id":"spn-34895","text":" (0/1 typical)"}]}],"id":"blk-32137","kind":"list-item"},{"blocks":[{"id":"blk-32140","kind":"paragraph","spans":[{"id":"spn-34896","marks":["code"],"text":"errorClass"},{"id":"spn-34897","text":" (optional: "},{"id":"spn-34898","marks":["code"],"text":"auth | limit | runtime | tool | unknown"},{"id":"spn-34899","text":")"}]}],"id":"blk-32139","kind":"list-item"},{"blocks":[{"id":"blk-32142","kind":"paragraph","spans":[{"id":"spn-34900","marks":["code"],"text":"costUsdEstimated"}]}],"id":"blk-32141","kind":"list-item"},{"blocks":[{"id":"blk-32144","kind":"paragraph","spans":[{"id":"spn-34901","marks":["code"],"text":"traceId"},{"id":"spn-34902","text":" (optional but recommended)"}]}],"id":"blk-32143","kind":"list-item"},{"blocks":[{"id":"blk-32146","kind":"paragraph","spans":[{"id":"spn-34903","marks":["code"],"text":"provider"},{"id":"spn-34904","text":" (optional runtime-specific counters)"}]}],"id":"blk-32145","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32147","kind":"paragraph","spans":[{"id":"spn-34905","text":"Telemetry MUST NOT include:"}]},{"id":"blk-32148","items":[{"blocks":[{"id":"blk-32150","kind":"paragraph","spans":[{"id":"spn-34906","text":"plaintext secrets,"}]}],"id":"blk-32149","kind":"list-item"},{"blocks":[{"id":"blk-32152","kind":"paragraph","spans":[{"id":"spn-34907","text":"full prompts/responses by default (unless an explicit opt-in feature is added later),"}]}],"id":"blk-32151","kind":"list-item"},{"blocks":[{"id":"blk-32154","kind":"paragraph","spans":[{"id":"spn-34908","text":"raw provider credential material."}]}],"id":"blk-32153","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32155","kind":"heading","level":3,"spans":[{"id":"spn-34909","text":"2) Signature computation"}]},{"id":"blk-32156","items":[{"blocks":[{"id":"blk-32158","kind":"paragraph","spans":[{"id":"spn-34910","text":"Signature is computed over the exact raw request body bytes as received/sent."}]}],"id":"blk-32157","kind":"list-item"},{"blocks":[{"id":"blk-32160","kind":"paragraph","spans":[{"id":"spn-34911","text":"Algorithm: "},{"id":"spn-34912","marks":["code"],"text":"HMAC_SHA256(telemetrySecret, raw_body_bytes)"},{"id":"spn-34913","text":"."}]}],"id":"blk-32159","kind":"list-item"},{"blocks":[{"id":"blk-32162","kind":"paragraph","spans":[{"id":"spn-34914","text":"Encoding: hex lowercase recommended."}]}],"id":"blk-32161","kind":"list-item"},{"blocks":[{"id":"blk-32164","kind":"paragraph","spans":[{"id":"spn-34915","text":"Header format: "},{"id":"spn-34916","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex>"},{"id":"spn-34917","text":"."}]}],"id":"blk-32163","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32165","kind":"paragraph","spans":[{"id":"spn-34918","text":"Canonicalization note:"}]},{"id":"blk-32166","items":[{"blocks":[{"id":"blk-32168","kind":"paragraph","spans":[{"id":"spn-34919","text":"The verifier MUST use the raw body bytes, not a re-serialized JSON object."}]}],"id":"blk-32167","kind":"list-item"},{"blocks":[{"id":"blk-32170","kind":"paragraph","spans":[{"id":"spn-34920","text":"If your framework modifies request bodies, capture raw bytes before parsing."}]}],"id":"blk-32169","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32171","kind":"heading","level":3,"spans":[{"id":"spn-34921","text":"3) Ingestion validation steps (MUST)"}]},{"id":"blk-32172","kind":"paragraph","spans":[{"id":"spn-34922","text":"In order: 1. Read "},{"id":"spn-34923","marks":["code"],"text":"deploymentId"},{"id":"spn-34924","text":" header and locate deployment record. 2. Fetch deployment-scoped secret reference and verify signature. 3. Parse JSON body and validate required fields and enums. 4. Ownership cross-check:"}]},{"id":"blk-32173","items":[{"blocks":[{"id":"blk-32175","kind":"paragraph","spans":[{"id":"spn-34925","marks":["code"],"text":"deployments.userId == body.userId"}]}],"id":"blk-32174","kind":"list-item"},{"blocks":[{"id":"blk-32177","kind":"paragraph","spans":[{"id":"spn-34926","marks":["code"],"text":"deployments.agentId == body.agentId"}]}],"id":"blk-32176","kind":"list-item"},{"blocks":[{"id":"blk-32179","kind":"paragraph","spans":[{"id":"spn-34927","marks":["code"],"text":"deployments._id == body.deploymentId"},{"id":"spn-34928","text":" (or match header)"}]}],"id":"blk-32178","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32180","kind":"paragraph","spans":[{"id":"spn-34929","text":"5. Dedupe/idempotency:"}]},{"id":"blk-32181","items":[{"blocks":[{"id":"blk-32183","kind":"paragraph","spans":[{"id":"spn-34930","text":"if "},{"id":"spn-34931","marks":["code"],"text":"eventId"},{"id":"spn-34932","text":" used: reject or no-op if already processed in dedupe window"}]}],"id":"blk-32182","kind":"list-item"},{"blocks":[{"id":"blk-32185","kind":"paragraph","spans":[{"id":"spn-34933","text":"if "},{"id":"spn-34934","marks":["code"],"text":"traceId"},{"id":"spn-34935","text":" used: ensure uniqueness per "},{"id":"spn-34936","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-34937","text":" in dedupe window"}]}],"id":"blk-32184","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32186","kind":"paragraph","spans":[{"id":"spn-34938","text":"6. Persist event append-only. 7. Optionally update incremental counters."}]},{"id":"blk-32187","kind":"paragraph","spans":[{"id":"spn-34939","text":"If any step fails:"}]},{"id":"blk-32188","items":[{"blocks":[{"id":"blk-32190","kind":"paragraph","spans":[{"id":"spn-34940","text":"respond with normalized error (for non-telemetry callers, keep generic),"}]}],"id":"blk-32189","kind":"list-item"},{"blocks":[{"id":"blk-32192","kind":"paragraph","spans":[{"id":"spn-34941","text":"DO NOT reveal secret or internal details,"}]}],"id":"blk-32191","kind":"list-item"},{"blocks":[{"id":"blk-32194","kind":"paragraph","spans":[{"id":"spn-34942","text":"optionally write a sanitized "},{"id":"spn-34943","marks":["code"],"text":"auditLog"},{"id":"spn-34944","text":" entry for investigation."}]}],"id":"blk-32193","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32195","kind":"heading","level":3,"spans":[{"id":"spn-34945","text":"4) Secret generation and rotation"}]},{"id":"blk-32196","items":[{"blocks":[{"id":"blk-32198","kind":"paragraph","spans":[{"id":"spn-34946","text":"Generate a new telemetry secret on every new deployment by default."}]}],"id":"blk-32197","kind":"list-item"},{"blocks":[{"id":"blk-32200","kind":"paragraph","spans":[{"id":"spn-34947","text":"Inject the secret into the runtime provider as a secret (not as plain env var stored in DB)."}]}],"id":"blk-32199","kind":"list-item"},{"blocks":[{"id":"blk-32202","kind":"paragraph","spans":[{"id":"spn-34948","text":"Rotation policy:"}]}],"id":"blk-32201","kind":"list-item"},{"blocks":[{"id":"blk-32204","kind":"paragraph","spans":[{"id":"spn-34949","text":"New deployment => new telemetry secret (mandatory)."}]}],"id":"blk-32203","kind":"list-item"},{"blocks":[{"id":"blk-32206","kind":"paragraph","spans":[{"id":"spn-34950","text":"Old deployments retain old secret for the duration they might emit telemetry (but they should not emit after deactivation, except in-flight retries)."}]}],"id":"blk-32205","kind":"list-item"},{"blocks":[{"id":"blk-32208","kind":"paragraph","spans":[{"id":"spn-34951","text":"Keep verification capability for a bounded time window after deactivation to allow late telemetry retries."}]}],"id":"blk-32207","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32209","kind":"heading","level":3,"spans":[{"id":"spn-34952","text":"5) Telemetry retries and ingestion availability"}]},{"id":"blk-32210","items":[{"blocks":[{"id":"blk-32212","kind":"paragraph","spans":[{"id":"spn-34953","text":"Data plane SHOULD retry telemetry submission with exponential backoff (bounded)."}]}],"id":"blk-32211","kind":"list-item"},{"blocks":[{"id":"blk-32214","kind":"paragraph","spans":[{"id":"spn-34954","text":"Data plane SHOULD NOT block user-visible invocation completion while retrying telemetry."}]}],"id":"blk-32213","kind":"list-item"},{"blocks":[{"id":"blk-32216","kind":"paragraph","spans":[{"id":"spn-34955","text":"Control plane SHOULD expose internal health metrics for telemetry ingestion rate and rejection counts."}]}],"id":"blk-32215","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32217","kind":"heading","level":2,"spans":[{"id":"spn-34956","text":"Consequences"}]},{"id":"blk-32218","kind":"heading","level":3,"spans":[{"id":"spn-34957","text":"Positive"}]},{"id":"blk-32219","items":[{"blocks":[{"id":"blk-32221","kind":"paragraph","spans":[{"id":"spn-34958","text":"Strong billing and limits integrity foundation."}]}],"id":"blk-32220","kind":"list-item"},{"blocks":[{"id":"blk-32223","kind":"paragraph","spans":[{"id":"spn-34959","text":"Provider-agnostic design that scales to new runtimes."}]}],"id":"blk-32222","kind":"list-item"},{"blocks":[{"id":"blk-32225","kind":"paragraph","spans":[{"id":"spn-34960","text":"Reduced blast radius via deployment-scoped secrets."}]}],"id":"blk-32224","kind":"list-item"},{"blocks":[{"id":"blk-32227","kind":"paragraph","spans":[{"id":"spn-34961","text":"Clear audit path for telemetry failures and spoof attempts."}]}],"id":"blk-32226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32228","kind":"heading","level":3,"spans":[{"id":"spn-34962","text":"Negative / tradeoffs"}]},{"id":"blk-32229","items":[{"blocks":[{"id":"blk-32231","kind":"paragraph","spans":[{"id":"spn-34963","text":"Requires deploying a telemetry secret per deployment and managing injection per provider."}]}],"id":"blk-32230","kind":"list-item"},{"blocks":[{"id":"blk-32233","kind":"paragraph","spans":[{"id":"spn-34964","text":"Requires careful handling of raw request bytes for correct signature verification."}]}],"id":"blk-32232","kind":"list-item"},{"blocks":[{"id":"blk-32235","kind":"paragraph","spans":[{"id":"spn-34965","text":"Adds complexity to runtime code (Pattern A emission) or to adapters (Pattern B emission)."}]}],"id":"blk-32234","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32236","kind":"heading","level":2,"spans":[{"id":"spn-34966","text":"Implementation requirements (checklist)"}]},{"id":"blk-32237","items":[{"blocks":[{"id":"blk-32239","kind":"paragraph","spans":[{"id":"spn-34967","text":"[ ] Each deployment has a telemetry signing secret generated by the control plane."}]}],"id":"blk-32238","kind":"list-item"},{"blocks":[{"id":"blk-32241","kind":"paragraph","spans":[{"id":"spn-34968","text":"[ ] Secret is injected into the runtime provider using provider secret mechanisms."}]}],"id":"blk-32240","kind":"list-item"},{"blocks":[{"id":"blk-32243","kind":"paragraph","spans":[{"id":"spn-34969","text":"[ ] Telemetry endpoint verifies signature using raw request body bytes."}]}],"id":"blk-32242","kind":"list-item"},{"blocks":[{"id":"blk-32245","kind":"paragraph","spans":[{"id":"spn-34970","text":"[ ] Telemetry endpoint cross-checks "},{"id":"spn-34971","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-34972","text":" ownership."}]}],"id":"blk-32244","kind":"list-item"},{"blocks":[{"id":"blk-32247","kind":"paragraph","spans":[{"id":"spn-34973","text":"[ ] Telemetry endpoint is not authenticated via browser sessions/cookies."}]}],"id":"blk-32246","kind":"list-item"},{"blocks":[{"id":"blk-32249","kind":"paragraph","spans":[{"id":"spn-34974","text":"[ ] Telemetry ingestion is idempotent under retries (dedupe window)."}]}],"id":"blk-32248","kind":"list-item"},{"blocks":[{"id":"blk-32251","kind":"paragraph","spans":[{"id":"spn-34975","text":"[ ] Telemetry payloads do not include secret values or full prompt contents by default."}]}],"id":"blk-32250","kind":"list-item"},{"blocks":[{"id":"blk-32253","kind":"paragraph","spans":[{"id":"spn-34976","text":"[ ] Telemetry rejection and signature failures are auditable (sanitized audit log)."}]}],"id":"blk-32252","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32254","kind":"heading","level":2,"spans":[{"id":"spn-34977","text":"Acceptance criteria"}]},{"id":"blk-32255","kind":"paragraph","spans":[{"id":"spn-34978","text":"This ADR is considered correctly implemented when:"}]},{"id":"blk-32256","kind":"paragraph","spans":[{"id":"spn-34979","text":"1. A valid telemetry payload signed with the correct deployment secret is accepted and persisted. 2. The same payload with an invalid signature is rejected and not persisted. 3. A valid signature with mismatched ownership (deployment belongs to a different agent/user) is rejected. 4. Retried telemetry submissions do not cause double-counting within the dedupe strategy window. 5. No plaintext telemetry secret values exist in the primary DB. 6. Telemetry events are attributable to "},{"id":"spn-34980","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-34981","text":" and can be aggregated reliably for billing and limits."}]},{"id":"blk-32257","kind":"heading","level":2,"spans":[{"id":"spn-34982","text":"Follow-ups"}]},{"id":"blk-32258","items":[{"blocks":[{"id":"blk-32260","kind":"paragraph","spans":[{"id":"spn-34983","text":"ADR-0005: Deployment immutability + active pointer model (if not already documented as ADR)."}]}],"id":"blk-32259","kind":"list-item"},{"blocks":[{"id":"blk-32262","kind":"paragraph","spans":[{"id":"spn-34984","text":"Define a standardized "},{"id":"spn-34985","marks":["code"],"text":"eventId"},{"id":"spn-34986","text":" policy if traceId uniqueness cannot be guaranteed."}]}],"id":"blk-32261","kind":"list-item"},{"blocks":[{"id":"blk-32264","kind":"paragraph","spans":[{"id":"spn-34987","text":"Consider stronger anti-replay guarantees (timestamp window + dedupe store) before enabling public agent invocations."}]}],"id":"blk-32263","kind":"list-item"},{"blocks":[{"id":"blk-32266","kind":"paragraph","spans":[{"id":"spn-34988","text":"Consider future hardening for enterprise tiers (PKI signatures or mTLS) if required by compliance/security posture."}]}],"id":"blk-32265","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieralstry7uxuwx45xy5ublotk44xsijf7nv3rxxhyuxdugwmdzsxoaa","vocabulary":"ampersand.docs.fs.v1"}