},{"id":"spn-19407","text":" (Claude in Chrome MCP)"}]}],"id":"blk-19275","kind":"list-item"},{"blocks":[{"id":"blk-19278","kind":"paragraph","spans":[{"id":"spn-19408","marks":["code"],"text":"mcp__plugin_chrome-devtools-mcp_chrome-devtools__*"},{"id":"spn-19409","text":" (chrome-devtools MCP)"}]}],"id":"blk-19277","kind":"list-item"},{"blocks":[{"id":"blk-19280","kind":"paragraph","spans":[{"id":"spn-19410","marks":["code"],"text":"mcp__Claude_Preview__*"},{"id":"spn-19411","text":" for browser-level testing (preview_* is still fine for dev-server management and HMR; use "},{"id":"spn-19412","marks":["code"],"text":"agent-browser"},{"id":"spn-19413","text":" once a server is running and you want real browser interaction)"}]}],"id":"blk-19279","kind":"list-item"},{"blocks":[{"id":"blk-19282","kind":"paragraph","spans":[{"id":"spn-19414","text":"Any ad-hoc Playwright / Puppeteer / Selenium scripts"}]}],"id":"blk-19281","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19283","kind":"paragraph","spans":[{"id":"spn-19415","text":"Bootstrap pattern for any session doing browser work:"}]},{"id":"blk-19284","kind":"code","language":"text","text":"agent-browser skills get core --full    # load the core skill\nagent-browser open <url>                # navigate\nagent-browser snapshot                  # a11y-tree snapshot (preferred over screenshot for assertions)\nagent-browser screenshot                # visual proof when sharing with the user"},{"id":"blk-19285","kind":"paragraph","spans":[{"id":"spn-19416","text":"Exception: if a task is narrowly about Chrome DevTools-specific features (Lighthouse audits, performance traces, heap snapshots), the "},{"id":"spn-19417","marks":["code"],"text":"chrome-devtools"},{"id":"spn-19418","text":" MCP may be used — but default to "},{"id":"spn-19419","marks":["code"],"text":"agent-browser"},{"id":"spn-19420","text":" for everything else."}]},{"id":"blk-19286","kind":"heading","level":2,"spans":[{"id":"spn-19421","text":"Graphonomous session policy (ALL ProjectAmp2 sessions)"}]},{"id":"blk-19287","kind":"paragraph","spans":[{"id":"spn-19422","text":"Treat Graphonomous MCP as the "},{"id":"spn-19423","marks":["bold"],"text":"always-on memory and learning loop"},{"id":"spn-19424","text":" for every chat session in this repository — regardless of which subdirectory the task is in. Graphonomous is the shared knowledge substrate for the entire [&] ecosystem."}]},{"id":"blk-19288","kind":"paragraph","spans":[{"id":"spn-19425","text":"Adopt this internal policy at session start:"}]},{"id":"blk-19289","kind":"paragraph","spans":[{"id":"spn-19426","marks":["bold"],"text":"\"Graphonomous-first memory loop is active.\""}]},{"id":"blk-19290","kind":"heading","level":3,"spans":[{"id":"spn-19427","text":"Required prompt/context wiring"}]},{"id":"blk-19291","kind":"paragraph","spans":[{"id":"spn-19428","text":"Skills live in "},{"id":"spn-19429","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-19430","text":" as Claude Code skills. Reference docs are mirrored in "},{"id":"spn-19431","marks":["code"],"text":"graphonomous/docs/skills/"},{"id":"spn-19432","text":"."}]},{"id":"blk-19292","kind":"paragraph","spans":[{"id":"spn-19433","text":"Load at session start (or before first non-trivial action):"}]},{"id":"blk-19293","kind":"paragraph","spans":[{"id":"spn-19434","text":"1. "},{"id":"spn-19435","marks":["code"],"text":"graphonomous/docs/skills/SKILLS.md"},{"id":"spn-19436","text":" (index + machine architecture) 2. "},{"id":"spn-19437","marks":["code"],"text":"graphonomous/docs/skills/bootstrap.md"},{"id":"spn-19438","text":" (session initialization)"}]},{"id":"blk-19294","kind":"paragraph","spans":[{"id":"spn-19439","text":"Recommended full load for complex sessions:"}]},{"id":"blk-19295","items":[{"blocks":[{"id":"blk-19297","kind":"paragraph","spans":[{"id":"spn-19440","marks":["code"],"text":"graphonomous/docs/skills/retrieve.md"}]}],"id":"blk-19296","kind":"list-item"},{"blocks":[{"id":"blk-19299","kind":"paragraph","spans":[{"id":"spn-19441","marks":["code"],"text":"graphonomous/docs/skills/learn.md"}]}],"id":"blk-19298","kind":"list-item"},{"blocks":[{"id":"blk-19301","kind":"paragraph","spans":[{"id":"spn-19442","marks":["code"],"text":"graphonomous/docs/skills/deliberate.md"}]}],"id":"blk-19300","kind":"list-item"},{"blocks":[{"id":"blk-19303","kind":"paragraph","spans":[{"id":"spn-19443","marks":["code"],"text":"graphonomous/docs/skills/consolidate.md"}]}],"id":"blk-19302","kind":"list-item"},{"blocks":[{"id":"blk-19305","kind":"paragraph","spans":[{"id":"spn-19444","marks":["code"],"text":"graphonomous/docs/skills/goals.md"}]}],"id":"blk-19304","kind":"list-item"},{"blocks":[{"id":"blk-19307","kind":"paragraph","spans":[{"id":"spn-19445","marks":["code"],"text":"graphonomous/docs/skills/attention.md"}]}],"id":"blk-19306","kind":"list-item"},{"blocks":[{"id":"blk-19309","kind":"paragraph","spans":[{"id":"spn-19446","marks":["code"],"text":"graphonomous/docs/skills/workflows.md"}]}],"id":"blk-19308","kind":"list-item"},{"blocks":[{"id":"blk-19311","kind":"paragraph","spans":[{"id":"spn-19447","marks":["code"],"text":"graphonomous/docs/skills/store.md"}]}],"id":"blk-19310","kind":"list-item"},{"blocks":[{"id":"blk-19313","kind":"paragraph","spans":[{"id":"spn-19448","marks":["code"],"text":"graphonomous/docs/skills/belief.md"}]}],"id":"blk-19312","kind":"list-item"},{"blocks":[{"id":"blk-19315","kind":"paragraph","spans":[{"id":"spn-19449","marks":["code"],"text":"graphonomous/docs/skills/review.md"}]}],"id":"blk-19314","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19316","kind":"heading","level":3,"spans":[{"id":"spn-19450","text":"Default loop (every non-trivial task)"}]},{"id":"blk-19317","kind":"paragraph","spans":[{"id":"spn-19451","text":"Graphonomous v0.4 exposes "},{"id":"spn-19452","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-19453","text":" (down from 29 individual tools). Each machine maps to a phase of the closed memory loop:"}]},{"id":"blk-19318","kind":"paragraph","spans":[{"id":"spn-19454","text":"1. "},{"id":"spn-19455","marks":["bold"],"text":"Retrieve"},{"id":"spn-19456","text":" — "},{"id":"spn-19457","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-19458","text":" before reasoning 2. "},{"id":"spn-19459","marks":["bold"],"text":"Route"},{"id":"spn-19460","text":" — check "},{"id":"spn-19461","marks":["code"],"text":"topology.routing"},{"id":"spn-19462","text":"; if "},{"id":"spn-19463","marks":["code"],"text":"\"deliberate\""},{"id":"spn-19464","text":", run "},{"id":"spn-19465","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-19466","text":" 3. "},{"id":"spn-19467","marks":["bold"],"text":"Act"},{"id":"spn-19468","text":" — "},{"id":"spn-19469","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-19470","text":" to mutate the graph 4. "},{"id":"spn-19471","marks":["bold"],"text":"Learn"},{"id":"spn-19472","text":" — "},{"id":"spn-19473","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-19474","text":" to close the feedback loop 5. "},{"id":"spn-19475","marks":["bold"],"text":"Consolidate"},{"id":"spn-19476","text":" — "},{"id":"spn-19477","marks":["code"],"text":"consolidate(action: \"run\")"},{"id":"spn-19478","text":" at session boundaries"}]},{"id":"blk-19319","kind":"paragraph","spans":[{"id":"spn-19479","text":"This applies whether you're working in "},{"id":"spn-19480","marks":["code"],"text":"graphonomous/"},{"id":"spn-19481","text":", "},{"id":"spn-19482","marks":["code"],"text":"WebHost.Systems/"},{"id":"spn-19483","text":", "},{"id":"spn-19484","marks":["code"],"text":"AmpersandBoxDesign/"},{"id":"spn-19485","text":", "},{"id":"spn-19486","marks":["code"],"text":"bendscript.com/"},{"id":"spn-19487","text":", or any portfolio site spec."}]},{"id":"blk-19320","kind":"heading","level":3,"spans":[{"id":"spn-19488","text":"Dual-loop architecture"}]},{"id":"blk-19321","kind":"paragraph","spans":[{"id":"spn-19489","text":"When PRISM (OS-009) benchmarks Graphonomous, both closed loops interlock — 5 Graphonomous machines + 6 PRISM machines = 11 tools total, down from 76. See "},{"id":"spn-19490","marks":["code"],"text":"AmpersandBoxDesign/prompts/DUAL_LOOP_MACHINES.md"},{"id":"spn-19491","text":" and "},{"id":"spn-19492","marks":["code"],"text":"PRISM/docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-19493","text":" (which now also covers triple-loop nesting via PULSE)."}]},{"id":"blk-19322","kind":"heading","level":3,"spans":[{"id":"spn-19494","text":"Three-protocol stack: [&] + PULSE + PRISM"}]},{"id":"blk-19323","kind":"paragraph","spans":[{"id":"spn-19495","text":"OS-010 PULSE is the temporal algebra that lets every loop in the [&] portfolio declare its phases, cadence, nesting, substrates, invariants, and cross-loop signal connections in a single JSON file ("},{"id":"spn-19496","marks":["code"],"text":"<loop>.pulse.json"},{"id":"spn-19497","text":"). Together with [&] (structural composition) and PRISM (diagnostic measurement), they form the three-protocol stack:"}]},{"id":"blk-19324","items":[{"blocks":[{"id":"blk-19326","kind":"paragraph","spans":[{"id":"spn-19498","marks":["bold"],"text":"[&]"},{"id":"spn-19499","text":" composes capabilities ("},{"id":"spn-19500","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-19501","text":") — structural"}]}],"id":"blk-19325","kind":"list-item"},{"blocks":[{"id":"blk-19328","kind":"paragraph","spans":[{"id":"spn-19502","marks":["bold"],"text":"PULSE"},{"id":"spn-19503","text":" declares loops + circulation ("},{"id":"spn-19504","marks":["code"],"text":"*.pulse.json"},{"id":"spn-19505","text":") — temporal — see "},{"id":"spn-19506","marks":["code"],"text":"PULSE/schemas/pulse-loop-manifest.v0.1.json"}]}],"id":"blk-19327","kind":"list-item"},{"blocks":[{"id":"blk-19330","kind":"paragraph","spans":[{"id":"spn-19507","marks":["bold"],"text":"PRISM"},{"id":"spn-19508","text":" measures loops over time (BYOR benchmark) — diagnostic"}]}],"id":"blk-19329","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19331","kind":"paragraph","spans":[{"id":"spn-19509","text":"Every portfolio product declares its own loop topology in a \"PULSE Loop Manifest\" section of "},{"id":"spn-19510","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-19511","text":". Reference manifests live in "},{"id":"spn-19512","marks":["code"],"text":"PULSE/manifests/"},{"id":"spn-19513","text":" (graphonomous, prism, agentromatic). PRISM does not require a separate file — it reads any system's PULSE manifest directly to discover phases, signatures, and substrates."}]},{"id":"blk-19332","kind":"paragraph","spans":[{"id":"spn-19514","text":"The five canonical PULSE phase kinds — "},{"id":"spn-19515","marks":["code"],"text":"retrieve"},{"id":"spn-19516","text":", "},{"id":"spn-19517","marks":["code"],"text":"route"},{"id":"spn-19518","text":", "},{"id":"spn-19519","marks":["code"],"text":"act"},{"id":"spn-19520","text":", "},{"id":"spn-19521","marks":["code"],"text":"learn"},{"id":"spn-19522","text":", "},{"id":"spn-19523","marks":["code"],"text":"consolidate"},{"id":"spn-19524","text":" — match the Graphonomous machine architecture exactly. The six canonical cross-loop tokens (as of PULSE v0.1.1) — "},{"id":"spn-19525","marks":["code"],"text":"TopologyContext"},{"id":"spn-19526","text":", "},{"id":"spn-19527","marks":["code"],"text":"DeliberationResult"},{"id":"spn-19528","text":", "},{"id":"spn-19529","marks":["code"],"text":"OutcomeSignal"},{"id":"spn-19530","text":", "},{"id":"spn-19531","marks":["code"],"text":"ReputationUpdate"},{"id":"spn-19532","text":", "},{"id":"spn-19533","marks":["code"],"text":"ConsolidationEvent"},{"id":"spn-19534","text":", "},{"id":"spn-19535","marks":["code"],"text":"SurpriseSignal"},{"id":"spn-19536","text":" — flow through CloudEvents v1 envelopes between loops. "},{"id":"spn-19537","marks":["code"],"text":"SurpriseSignal"},{"id":"spn-19538","text":" was added in v0.1.1 for OS-011 (Embodiment Protocol) forward-model-prediction-error emission."}]},{"id":"blk-19333","kind":"paragraph","spans":[{"id":"spn-19539","text":"When working in any subdirectory, treat the local PULSE Loop Manifest as authoritative for that project's loop topology. Cross-loop integrations should reference manifest connections, not hard-coded coupling."}]},{"id":"blk-19334","kind":"heading","level":3,"spans":[{"id":"spn-19540","text":"Arithmetic ladder / box-and-box (the governance kernel)"}]},{"id":"blk-19335","kind":"paragraph","spans":[{"id":"spn-19541","marks":["code"],"text":"box-and-box"},{"id":"spn-19542","text":" (at "},{"id":"spn-19543","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/"},{"id":"spn-19544","text":") is the [&] "},{"id":"spn-19545","marks":["bold"],"text":"governance kernel"},{"id":"spn-19546","text":" — an "},{"id":"spn-19547","marks":["bold"],"text":"eight-rung modality ladder"},{"id":"spn-19548","text":", each rung a small algebra with stated laws:"}]},{"id":"blk-19336","kind":"paragraph","spans":[{"id":"spn-19549","text":"1. "},{"id":"spn-19550","marks":["bold"],"text":"alethic"},{"id":"spn-19551","text":" (value) — what *can* happen · 2. "},{"id":"spn-19552","marks":["bold"],"text":"axiological"},{"id":"spn-19553","text":" (score) — how to rank · 3. "},{"id":"spn-19554","marks":["bold"],"text":"deontic"},{"id":"spn-19555","text":" (norm/govern) — what's *allowed* · 4. "},{"id":"spn-19556","marks":["bold"],"text":"temporal"},{"id":"spn-19557","text":" (supervise) — safe over time · 5. "},{"id":"spn-19558","marks":["bold"],"text":"reflexive"},{"id":"spn-19559","text":" — may the rules change (entrenched ring-0 core) · 6. "},{"id":"spn-19560","marks":["bold"],"text":"epistemic"},{"id":"spn-19561","text":" — do we know enough · 7. "},{"id":"spn-19562","marks":["bold"],"text":"strategic"},{"id":"spn-19563","text":" — who can ensure it · 8. "},{"id":"spn-19564","marks":["bold"],"text":"resource"},{"id":"spn-19565","text":" — can we afford it (affine ledger)."}]},{"id":"blk-19337","kind":"paragraph","spans":[{"id":"spn-19566","text":"One composing "},{"id":"spn-19567","marks":["bold"],"text":"bridge"},{"id":"spn-19568","text":" ("},{"id":"spn-19569","marks":["code"],"text":"bridge.mjs"},{"id":"spn-19570","text":") runs floor-then-gradient: "},{"id":"spn-19571","marks":["bold"],"text":"`feasible ▸ permitted ▸ best`"},{"id":"spn-19572","text":" over an un-weakenable safety floor; every verdict ships a certificate. "},{"id":"spn-19573","marks":["bold"],"text":"116 property-tested laws"},{"id":"spn-19574","text":" (103 kernel + 13 compose/CC2; "},{"id":"spn-19575","marks":["code"],"text":"node test/laws.mjs && node test/compose-laws.mjs"},{"id":"spn-19576","text":", 2000 trials each). "},{"id":"spn-19577","marks":["bold"],"text":"Invariant Arithmetic"},{"id":"spn-19578","text":" (the prior "},{"id":"spn-19579","marks":["code"],"text":"opensentience.org/invariant-arithmetic.html"},{"id":"spn-19580","text":" + the TS port in "},{"id":"spn-19581","marks":["code"],"text":"workbench/app/src/lib/ia/"},{"id":"spn-19582","text":") is "},{"id":"spn-19583","marks":["bold"],"text":"rungs 1–2"},{"id":"spn-19584","text":" of this same ladder."}]},{"id":"blk-19338","kind":"paragraph","spans":[{"id":"spn-19585","marks":["bold"],"text":"Important — the 8 rungs are orthogonal to PULSE's 5 phase kinds."},{"id":"spn-19586","text":" Do NOT claim a 1:1 mapping. The rungs govern a *single decision* (a one-shot verdict: may this action proceed, and is it best?); PULSE's "},{"id":"spn-19587","marks":["code"],"text":"retrieve/route/act/learn/consolidate"},{"id":"spn-19588","text":" *sequence a loop over time*. The kernel governs "},{"id":"spn-19589","marks":["bold"],"text":"what is allowed to happen at"},{"id":"spn-19590","text":" a phase — it is not itself a set of phases. The package is "},{"id":"spn-19591","marks":["bold"],"text":"pure library, code only"},{"id":"spn-19592","text":" (no bundled HTML); the rung \"living-paper\" pages + interactive "},{"id":"spn-19593","marks":["code"],"text":"playground.html"},{"id":"spn-19594","text":" (64 of 116 laws wired client-side) are website content at "},{"id":"spn-19595","marks":["code"],"text":"opensentience.org/"},{"id":"spn-19596","text":" root; conformance is published at "},{"id":"spn-19597","marks":["code"],"text":"ampersandboxdesign.com/laws.html"},{"id":"spn-19598","text":"."}]},{"id":"blk-19339","kind":"heading","level":3,"spans":[{"id":"spn-19599","text":"Hard requirements"}]},{"id":"blk-19340","items":[{"blocks":[{"id":"blk-19342","kind":"paragraph","spans":[{"id":"spn-19600","text":"Do not skip retrieval habitually — prior context likely exists for most tasks"}]}],"id":"blk-19341","kind":"list-item"},{"blocks":[{"id":"blk-19344","kind":"paragraph","spans":[{"id":"spn-19601","text":"Do not fabricate causal provenance, outcomes, or coverage signals"}]}],"id":"blk-19343","kind":"list-item"},{"blocks":[{"id":"blk-19346","kind":"paragraph","spans":[{"id":"spn-19602","text":"Do not inflate confidence indiscriminately"}]}],"id":"blk-19345","kind":"list-item"},{"blocks":[{"id":"blk-19348","kind":"paragraph","spans":[{"id":"spn-19603","text":"Respect act/learn/escalate routing from goal coverage decisions"}]}],"id":"blk-19347","kind":"list-item"},{"blocks":[{"id":"blk-19350","kind":"paragraph","spans":[{"id":"spn-19604","text":"Store cross-project learnings (e.g., spec decisions that affect multiple apps) as semantic nodes with appropriate edges"}]}],"id":"blk-19349","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieranrzlf26xi3csbupjwbhtji4groutryfilkqtbrofke7bx73gck6q","vocabulary":"ampersand.docs.fs.v1"}