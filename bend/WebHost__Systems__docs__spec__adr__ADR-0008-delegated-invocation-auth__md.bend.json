{"bendscript":"0.1","blocks":[{"id":"blk-33480","kind":"heading","level":1,"spans":[{"id":"spn-36000","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-33481","items":[{"blocks":[{"id":"blk-33483","kind":"paragraph","spans":[{"id":"spn-36001","marks":["bold"],"text":"Status:"},{"id":"spn-36002","text":" Accepted"}]}],"id":"blk-33482","kind":"list-item"},{"blocks":[{"id":"blk-33485","kind":"paragraph","spans":[{"id":"spn-36003","marks":["bold"],"text":"Date:"},{"id":"spn-36004","text":" 2026-01-24"}]}],"id":"blk-33484","kind":"list-item"},{"blocks":[{"id":"blk-33487","kind":"paragraph","spans":[{"id":"spn-36005","marks":["bold"],"text":"Owners:"},{"id":"spn-36006","text":" Engineering"}]}],"id":"blk-33486","kind":"list-item"},{"blocks":[{"id":"blk-33489","kind":"paragraph","spans":[{"id":"spn-36007","marks":["bold"],"text":"Applies to:"},{"id":"spn-36008","text":" "},{"id":"spn-36009","marks":["code"],"text":"webhost.systems"},{"id":"spn-36010","text":" control plane"}]}],"id":"blk-33488","kind":"list-item"},{"blocks":[{"id":"blk-33491","kind":"paragraph","spans":[{"id":"spn-36011","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-36012","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-33490","kind":"list-item"},{"blocks":[{"id":"blk-33493","kind":"paragraph","spans":[{"id":"spn-36013","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-33492","kind":"list-item"},{"blocks":[{"id":"blk-33495","kind":"paragraph","spans":[{"id":"spn-36014","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-36015","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-33494","kind":"list-item"},{"blocks":[{"id":"blk-33497","kind":"paragraph","spans":[{"id":"spn-36016","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-36017","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-33496","kind":"list-item"},{"blocks":[{"id":"blk-33499","kind":"paragraph","spans":[{"id":"spn-36018","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-36019","text":" (invoke contract)"}]}],"id":"blk-33498","kind":"list-item"},{"blocks":[{"id":"blk-33501","kind":"paragraph","spans":[{"id":"spn-36020","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-36021","text":" (tenant isolation; access control)"}]}],"id":"blk-33500","kind":"list-item"},{"blocks":[{"id":"blk-33503","kind":"paragraph","spans":[{"id":"spn-36022","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-36023","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-33502","kind":"list-item"},{"blocks":[{"id":"blk-33505","kind":"paragraph","spans":[{"id":"spn-36024","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-36025","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-33504","kind":"list-item"},{"blocks":[{"id":"blk-33507","kind":"paragraph","spans":[{"id":"spn-36026","text":"External integration: "},{"id":"spn-36027","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-36028","text":" (consumer contract)"}]}],"id":"blk-33506","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33508","kind":"paragraph","spans":[{"id":"spn-36029","text":"---"}]},{"id":"blk-33509","kind":"heading","level":2,"spans":[{"id":"spn-36030","text":"1) Context"}]},{"id":"blk-33510","kind":"paragraph","spans":[{"id":"spn-36031","text":"The canonical WHS invocation endpoint ("},{"id":"spn-36032","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-36033","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-33511","kind":"paragraph","spans":[{"id":"spn-36034","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-33512","items":[{"blocks":[{"id":"blk-33514","kind":"paragraph","spans":[{"id":"spn-36035","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-33513","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33515","kind":"paragraph","spans":[{"id":"spn-36036","text":"Constraints:"}]},{"id":"blk-33516","items":[{"blocks":[{"id":"blk-33518","kind":"paragraph","spans":[{"id":"spn-36037","text":"Server-side orchestrators should "},{"id":"spn-36038","marks":["bold"],"text":"not"},{"id":"spn-36039","text":" rely on browser tokens."}]}],"id":"blk-33517","kind":"list-item"},{"blocks":[{"id":"blk-33520","kind":"paragraph","spans":[{"id":"spn-36040","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-33519","kind":"list-item"},{"blocks":[{"id":"blk-33522","kind":"paragraph","spans":[{"id":"spn-36041","text":"WHS must remain authoritative for:"}]}],"id":"blk-33521","kind":"list-item"},{"blocks":[{"id":"blk-33524","kind":"paragraph","spans":[{"id":"spn-36042","text":"agent ownership/visibility,"}]}],"id":"blk-33523","kind":"list-item"},{"blocks":[{"id":"blk-33526","kind":"paragraph","spans":[{"id":"spn-36043","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-33525","kind":"list-item"},{"blocks":[{"id":"blk-33528","kind":"paragraph","spans":[{"id":"spn-36044","text":"telemetry, usage, billing."}]}],"id":"blk-33527","kind":"list-item"},{"blocks":[{"id":"blk-33530","kind":"paragraph","spans":[{"id":"spn-36045","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-33529","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33531","kind":"paragraph","spans":[{"id":"spn-36046","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-33532","items":[{"blocks":[{"id":"blk-33534","kind":"paragraph","spans":[{"id":"spn-36047","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-33533","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33535","kind":"paragraph","spans":[{"id":"spn-36048","text":"We need an analogous but distinct mechanism for "},{"id":"spn-36049","marks":["bold"],"text":"delegated invocation"},{"id":"spn-36050","text":"."}]},{"id":"blk-33536","kind":"paragraph","spans":[{"id":"spn-36051","text":"---"}]},{"id":"blk-33537","kind":"heading","level":2,"spans":[{"id":"spn-36052","text":"2) Decision"}]},{"id":"blk-33538","kind":"heading","level":3,"spans":[{"id":"spn-36053","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-33539","kind":"paragraph","spans":[{"id":"spn-36054","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-33540","items":[{"blocks":[{"id":"blk-33542","kind":"paragraph","spans":[{"id":"spn-36055","text":"The delegator sends a request with:"}]}],"id":"blk-33541","kind":"list-item"},{"blocks":[{"id":"blk-33544","kind":"paragraph","spans":[{"id":"spn-36056","text":"an HMAC signature computed over the "},{"id":"spn-36057","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-36058","text":"."}]}],"id":"blk-33543","kind":"list-item"},{"blocks":[{"id":"blk-33546","kind":"paragraph","spans":[{"id":"spn-36059","text":"a timestamp used for replay protection."}]}],"id":"blk-33545","kind":"list-item"},{"blocks":[{"id":"blk-33548","kind":"paragraph","spans":[{"id":"spn-36060","text":"a declared delegated end-user identity ("},{"id":"spn-36061","marks":["code"],"text":"externalUserId"},{"id":"spn-36062","text":") in the JSON body."}]}],"id":"blk-33547","kind":"list-item"},{"blocks":[{"id":"blk-33550","kind":"paragraph","spans":[{"id":"spn-36063","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-33549","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33551","kind":"paragraph","spans":[{"id":"spn-36064","text":"This is "},{"id":"spn-36065","marks":["bold"],"text":"service authentication"},{"id":"spn-36066","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-33552","kind":"heading","level":3,"spans":[{"id":"spn-36067","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-33553","kind":"paragraph","spans":[{"id":"spn-36068","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-33554","items":[{"blocks":[{"id":"blk-33556","kind":"paragraph","spans":[{"id":"spn-36069","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-33555","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33557","kind":"paragraph","spans":[{"id":"spn-36070","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-33558","kind":"heading","level":3,"spans":[{"id":"spn-36071","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-33559","kind":"paragraph","spans":[{"id":"spn-36072","text":"For delegated invocations:"}]},{"id":"blk-33560","items":[{"blocks":[{"id":"blk-33562","kind":"paragraph","spans":[{"id":"spn-36073","text":"WHS resolves "},{"id":"spn-36074","marks":["code"],"text":"externalUserId"},{"id":"spn-36075","text":" to a WHS "},{"id":"spn-36076","marks":["code"],"text":"users"},{"id":"spn-36077","text":" row."}]}],"id":"blk-33561","kind":"list-item"},{"blocks":[{"id":"blk-33564","kind":"paragraph","spans":[{"id":"spn-36078","text":"WHS enforces all standard checks "},{"id":"spn-36079","marks":["bold"],"text":"as that user"},{"id":"spn-36080","text":", including:"}]}],"id":"blk-33563","kind":"list-item"},{"blocks":[{"id":"blk-33566","kind":"paragraph","spans":[{"id":"spn-36081","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-33565","kind":"list-item"},{"blocks":[{"id":"blk-33568","kind":"paragraph","spans":[{"id":"spn-36082","text":"agent status (not disabled),"}]}],"id":"blk-33567","kind":"list-item"},{"blocks":[{"id":"blk-33570","kind":"paragraph","spans":[{"id":"spn-36083","text":"active deployment present,"}]}],"id":"blk-33569","kind":"list-item"},{"blocks":[{"id":"blk-33572","kind":"paragraph","spans":[{"id":"spn-36084","text":"plan entitlements and limits,"}]}],"id":"blk-33571","kind":"list-item"},{"blocks":[{"id":"blk-33574","kind":"paragraph","spans":[{"id":"spn-36085","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-33573","kind":"list-item"},{"blocks":[{"id":"blk-33576","kind":"paragraph","spans":[{"id":"spn-36086","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-33575","kind":"list-item"},{"blocks":[{"id":"blk-33578","kind":"paragraph","spans":[{"id":"spn-36087","text":"any additional internal safety controls."}]}],"id":"blk-33577","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33579","kind":"paragraph","spans":[{"id":"spn-36088","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-33580","kind":"paragraph","spans":[{"id":"spn-36089","text":"---"}]},{"id":"blk-33581","kind":"heading","level":2,"spans":[{"id":"spn-36090","text":"3) Normative request authentication"}]},{"id":"blk-33582","kind":"heading","level":3,"spans":[{"id":"spn-36091","text":"3.1 Required headers"}]},{"id":"blk-33583","kind":"paragraph","spans":[{"id":"spn-36092","text":"Delegated requests MUST include:"}]},{"id":"blk-33584","items":[{"blocks":[{"id":"blk-33586","kind":"paragraph","spans":[{"id":"spn-36093","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-33585","kind":"list-item"},{"blocks":[{"id":"blk-33588","kind":"paragraph","spans":[{"id":"spn-36094","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-33587","kind":"list-item"},{"blocks":[{"id":"blk-33590","kind":"paragraph","spans":[{"id":"spn-36095","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-33589","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33591","kind":"paragraph","spans":[{"id":"spn-36096","text":"Rules:"}]},{"id":"blk-33592","items":[{"blocks":[{"id":"blk-33594","kind":"paragraph","spans":[{"id":"spn-36097","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-33593","kind":"list-item"},{"blocks":[{"id":"blk-33596","kind":"paragraph","spans":[{"id":"spn-36098","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-33595","kind":"list-item"},{"blocks":[{"id":"blk-33598","kind":"paragraph","spans":[{"id":"spn-36099","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-33597","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33599","kind":"paragraph","spans":[{"id":"spn-36100","text":"Recommended default skew window:"}]},{"id":"blk-33600","items":[{"blocks":[{"id":"blk-33602","kind":"paragraph","spans":[{"id":"spn-36101","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-36102","text":" (5 minutes)"}]}],"id":"blk-33601","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33603","kind":"paragraph","spans":[{"id":"spn-36103","text":"If signature or timestamp validation fails:"}]},{"id":"blk-33604","items":[{"blocks":[{"id":"blk-33606","kind":"paragraph","spans":[{"id":"spn-36104","text":"return a normalized error:"}]}],"id":"blk-33605","kind":"list-item"},{"blocks":[{"id":"blk-33608","kind":"paragraph","spans":[{"id":"spn-36105","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-33607","kind":"list-item"},{"blocks":[{"id":"blk-33610","kind":"paragraph","spans":[{"id":"spn-36106","text":"safe "},{"id":"spn-36107","marks":["code"],"text":"message"}]}],"id":"blk-33609","kind":"list-item"},{"blocks":[{"id":"blk-33612","kind":"paragraph","spans":[{"id":"spn-36108","marks":["code"],"text":"retryable: false"},{"id":"spn-36109","text":" (recommended)"}]}],"id":"blk-33611","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33613","kind":"heading","level":3,"spans":[{"id":"spn-36110","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-33614","kind":"paragraph","spans":[{"id":"spn-36111","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-33615","items":[{"blocks":[{"id":"blk-33617","kind":"paragraph","spans":[{"id":"spn-36112","text":"e.g., "},{"id":"spn-36113","marks":["code"],"text":"agentromatic"},{"id":"spn-36114","text":", "},{"id":"spn-36115","marks":["code"],"text":"agentelic"},{"id":"spn-36116","text":" (future), "},{"id":"spn-36117","marks":["code"],"text":"internal"}]}],"id":"blk-33616","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33618","kind":"paragraph","spans":[{"id":"spn-36118","text":"Requests with an unknown "},{"id":"spn-36119","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-36120","text":" SHOULD be rejected with "},{"id":"spn-36121","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-36122","text":"."}]},{"id":"blk-33619","kind":"paragraph","spans":[{"id":"spn-36123","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-33620","kind":"heading","level":3,"spans":[{"id":"spn-36124","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-33621","kind":"paragraph","spans":[{"id":"spn-36125","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-33622","items":[{"blocks":[{"id":"blk-33624","kind":"paragraph","spans":[{"id":"spn-36126","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-33623","kind":"list-item"},{"blocks":[{"id":"blk-33626","kind":"paragraph","spans":[{"id":"spn-36127","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-36128","text":" (stable external auth subject id)"}]}],"id":"blk-33625","kind":"list-item"},{"blocks":[{"id":"blk-33628","kind":"paragraph","spans":[{"id":"spn-36129","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-36130","text":" (see §5)"}]}],"id":"blk-33627","kind":"list-item"},{"blocks":[{"id":"blk-33630","kind":"paragraph","spans":[{"id":"spn-36131","text":"optional correlation metadata for observability:"}]}],"id":"blk-33629","kind":"list-item"},{"blocks":[{"id":"blk-33632","kind":"paragraph","spans":[{"id":"spn-36132","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-33631","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33633","kind":"paragraph","spans":[{"id":"spn-36133","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-36134","marks":["code"],"text":"invoke"},{"id":"spn-36135","text":" (compatible with "},{"id":"spn-36136","marks":["code"],"text":"InvokeRequest"},{"id":"spn-36137","text":")."}]},{"id":"blk-33634","kind":"paragraph","spans":[{"id":"spn-36138","text":"The body MUST NOT include:"}]},{"id":"blk-33635","items":[{"blocks":[{"id":"blk-33637","kind":"paragraph","spans":[{"id":"spn-36139","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-33636","kind":"list-item"},{"blocks":[{"id":"blk-33639","kind":"paragraph","spans":[{"id":"spn-36140","text":"raw end-user auth tokens"}]}],"id":"blk-33638","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33640","kind":"paragraph","spans":[{"id":"spn-36141","text":"---"}]},{"id":"blk-33641","kind":"heading","level":2,"spans":[{"id":"spn-36142","text":"4) Error semantics"}]},{"id":"blk-33642","kind":"paragraph","spans":[{"id":"spn-36143","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-33643","kind":"paragraph","spans":[{"id":"spn-36144","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-33644","items":[{"blocks":[{"id":"blk-33646","kind":"paragraph","spans":[{"id":"spn-36145","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-36146","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-33645","kind":"list-item"},{"blocks":[{"id":"blk-33648","kind":"paragraph","spans":[{"id":"spn-36147","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-36148","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-33647","kind":"list-item"},{"blocks":[{"id":"blk-33650","kind":"paragraph","spans":[{"id":"spn-36149","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-36150","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-33649","kind":"list-item"},{"blocks":[{"id":"blk-33652","kind":"paragraph","spans":[{"id":"spn-36151","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-36152","text":" (plan limits)"}]}],"id":"blk-33651","kind":"list-item"},{"blocks":[{"id":"blk-33654","kind":"paragraph","spans":[{"id":"spn-36153","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-36154","text":" (bad schema, oversized payload)"}]}],"id":"blk-33653","kind":"list-item"},{"blocks":[{"id":"blk-33656","kind":"paragraph","spans":[{"id":"spn-36155","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-36156","text":" (provider/runtime failures)"}]}],"id":"blk-33655","kind":"list-item"},{"blocks":[{"id":"blk-33658","kind":"paragraph","spans":[{"id":"spn-36157","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-33657","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33659","kind":"paragraph","spans":[{"id":"spn-36158","text":"Consistency rule:"}]},{"id":"blk-33660","items":[{"blocks":[{"id":"blk-33662","kind":"paragraph","spans":[{"id":"spn-36159","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-36160","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-36161","text":" over "},{"id":"spn-36162","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-36163","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-33661","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33663","kind":"paragraph","spans":[{"id":"spn-36164","text":"---"}]},{"id":"blk-33664","kind":"heading","level":2,"spans":[{"id":"spn-36165","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-33665","kind":"paragraph","spans":[{"id":"spn-36166","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-33666","kind":"heading","level":3,"spans":[{"id":"spn-36167","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-33667","kind":"paragraph","spans":[{"id":"spn-36168","text":"Delegated invocation requests MUST include "},{"id":"spn-36169","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-36170","text":"."}]},{"id":"blk-33668","kind":"paragraph","spans":[{"id":"spn-36171","text":"The key MUST be:"}]},{"id":"blk-33669","items":[{"blocks":[{"id":"blk-33671","kind":"paragraph","spans":[{"id":"spn-36172","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-33670","kind":"list-item"},{"blocks":[{"id":"blk-33673","kind":"paragraph","spans":[{"id":"spn-36173","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-33672","kind":"list-item"},{"blocks":[{"id":"blk-33675","kind":"paragraph","spans":[{"id":"spn-36174","text":"secret-free,"}]}],"id":"blk-33674","kind":"list-item"},{"blocks":[{"id":"blk-33677","kind":"paragraph","spans":[{"id":"spn-36175","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-33676","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33678","kind":"heading","level":3,"spans":[{"id":"spn-36176","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-33679","kind":"paragraph","spans":[{"id":"spn-36177","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-33680","items":[{"blocks":[{"id":"blk-33682","kind":"paragraph","spans":[{"id":"spn-36178","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-33681","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33683","kind":"paragraph","spans":[{"id":"spn-36179","text":"Behavior:"}]},{"id":"blk-33684","items":[{"blocks":[{"id":"blk-33686","kind":"paragraph","spans":[{"id":"spn-36180","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-33685","kind":"list-item"},{"blocks":[{"id":"blk-33688","kind":"paragraph","spans":[{"id":"spn-36181","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-33687","kind":"list-item"},{"blocks":[{"id":"blk-33690","kind":"paragraph","spans":[{"id":"spn-36182","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-33689","kind":"list-item"},{"blocks":[{"id":"blk-33692","kind":"paragraph","spans":[{"id":"spn-36183","marks":["code"],"text":"CONFLICT"},{"id":"spn-36184","text":" or "},{"id":"spn-36185","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-36186","text":" (choose one; keep consistent),"}]}],"id":"blk-33691","kind":"list-item"},{"blocks":[{"id":"blk-33694","kind":"paragraph","spans":[{"id":"spn-36187","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-33693","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33695","kind":"paragraph","spans":[{"id":"spn-36188","text":"Implementation guidance (non-normative):"}]},{"id":"blk-33696","items":[{"blocks":[{"id":"blk-33698","kind":"paragraph","spans":[{"id":"spn-36189","text":"Store an idempotency ledger row containing:"}]}],"id":"blk-33697","kind":"list-item"},{"blocks":[{"id":"blk-33700","kind":"paragraph","spans":[{"id":"spn-36190","text":"request hash (e.g., sha256 of raw bytes),"}]}],"id":"blk-33699","kind":"list-item"},{"blocks":[{"id":"blk-33702","kind":"paragraph","spans":[{"id":"spn-36191","text":"response payload or response reference (bounded),"}]}],"id":"blk-33701","kind":"list-item"},{"blocks":[{"id":"blk-33704","kind":"paragraph","spans":[{"id":"spn-36192","text":"traceId/sessionId,"}]}],"id":"blk-33703","kind":"list-item"},{"blocks":[{"id":"blk-33706","kind":"paragraph","spans":[{"id":"spn-36193","text":"timestamps and status."}]}],"id":"blk-33705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33707","kind":"paragraph","spans":[{"id":"spn-36194","text":"---"}]},{"id":"blk-33708","kind":"heading","level":2,"spans":[{"id":"spn-36195","text":"6) Security analysis (threats and mitigations)"}]},{"id":"blk-33709","kind":"heading","level":3,"spans":[{"id":"spn-36196","text":"6.1 Threat: delegator attempts to invoke as another user"}]},{"id":"blk-33710","kind":"paragraph","spans":[{"id":"spn-36197","text":"Mitigation:"}]},{"id":"blk-33711","items":[{"blocks":[{"id":"blk-33713","kind":"paragraph","spans":[{"id":"spn-36198","text":"WHS enforces authorization based on "},{"id":"spn-36199","marks":["code"],"text":"externalUserId"},{"id":"spn-36200","text":" resolved user row."}]}],"id":"blk-33712","kind":"list-item"},{"blocks":[{"id":"blk-33715","kind":"paragraph","spans":[{"id":"spn-36201","text":"WHS enforces ownership/visibility checks and entitlements."}]}],