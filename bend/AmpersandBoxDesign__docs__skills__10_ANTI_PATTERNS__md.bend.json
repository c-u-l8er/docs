{"bendscript":"0.1","blocks":[{"id":"blk-15437","kind":"heading","level":1,"spans":[{"id":"spn-14319","text":"Skill 10 — Anti-Patterns"}]},{"blocks":[{"id":"blk-15439","kind":"paragraph","spans":[{"id":"spn-14320","text":"Common mistakes when writing [&] Protocol declarations and how to avoid them. Every anti-pattern here comes from real failure modes: broken compositions, unenforceable governance, unportable agents, and silent pipeline failures."}]}],"id":"blk-15438","kind":"quote"},{"id":"blk-15440","kind":"paragraph","spans":[{"id":"spn-14321","text":"---"}]},{"id":"blk-15441","kind":"heading","level":2,"spans":[{"id":"spn-14322","text":"Overview"}]},{"id":"blk-15442","kind":"paragraph","spans":[{"id":"spn-14323","text":"Each anti-pattern follows this structure:"}]},{"id":"blk-15443","kind":"paragraph","spans":[{"id":"spn-14324","text":"1. "},{"id":"spn-14325","marks":["bold"],"text":"The mistake"},{"id":"spn-14326","text":" — what it looks like 2. "},{"id":"spn-14327","marks":["bold"],"text":"Why it's harmful"},{"id":"spn-14328","text":" — the concrete damage 3. "},{"id":"spn-14329","marks":["bold"],"text":"The fix"},{"id":"spn-14330","text":" — what to do instead"}]},{"id":"blk-15444","kind":"paragraph","spans":[{"id":"spn-14331","text":"---"}]},{"id":"blk-15445","kind":"heading","level":2,"spans":[{"id":"spn-14332","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-15447","spans":[{"id":"spn-14333","text":"#"}]},{"id":"blk-15448","spans":[{"id":"spn-14334","text":"Name"}]},{"id":"blk-15449","spans":[{"id":"spn-14335","text":"Severity"}]}],"id":"blk-15446","kind":"table","rows":[[{"id":"blk-15450","spans":[{"id":"spn-14336","text":"1"}]},{"id":"blk-15451","spans":[{"id":"spn-14337","marks":[{"kind":"link","predicate":"cites","target":"#1--capabilities-without-providers"}],"text":"Capabilities Without Providers"}]},{"id":"blk-15452","spans":[{"id":"spn-14338","text":"Critical"}]}],[{"id":"blk-15453","spans":[{"id":"spn-14339","text":"2"}]},{"id":"blk-15454","spans":[{"id":"spn-14340","marks":[{"kind":"link","predicate":"cites","target":"#2--ignoring-composition-type-checks"}],"text":"Ignoring Composition Type Checks"}]},{"id":"blk-15455","spans":[{"id":"spn-14341","text":"Critical"}]}],[{"id":"blk-15456","spans":[{"id":"spn-14342","text":"3"}]},{"id":"blk-15457","spans":[{"id":"spn-14343","marks":[{"kind":"link","predicate":"cites","target":"#3--kitchen-sink-declarations"}],"text":"Kitchen-Sink Declarations"}]},{"id":"blk-15458","spans":[{"id":"spn-14344","text":"High"}]}],[{"id":"blk-15459","spans":[{"id":"spn-14345","text":"4"}]},{"id":"blk-15460","spans":[{"id":"spn-14346","marks":[{"kind":"link","predicate":"cites","target":"#4--missing-provenance-on-critical-capabilities"}],"text":"Missing Provenance on Critical Capabilities"}]},{"id":"blk-15461","spans":[{"id":"spn-14347","text":"High"}]}],[{"id":"blk-15462","spans":[{"id":"spn-14348","text":"5"}]},{"id":"blk-15463","spans":[{"id":"spn-14349","marks":[{"kind":"link","predicate":"cites","target":"#5--governance-gaps"}],"text":"Governance Gaps"}]},{"id":"blk-15464","spans":[{"id":"spn-14350","text":"High"}]}],[{"id":"blk-15465","spans":[{"id":"spn-14351","text":"6"}]},{"id":"blk-15466","spans":[{"id":"spn-14352","marks":[{"kind":"link","predicate":"cites","target":"#6--over-specifying-providers"}],"text":"Over-Specifying Providers"}]},{"id":"blk-15467","spans":[{"id":"spn-14353","text":"Medium"}]}],[{"id":"blk-15468","spans":[{"id":"spn-14354","text":"7"}]},{"id":"blk-15469","spans":[{"id":"spn-14355","marks":[{"kind":"link","predicate":"cites","target":"#7--ignoring-contract-versioning"}],"text":"Ignoring Contract Versioning"}]},{"id":"blk-15470","spans":[{"id":"spn-14356","text":"Medium"}]}],[{"id":"blk-15471","spans":[{"id":"spn-14357","text":"8"}]},{"id":"blk-15472","spans":[{"id":"spn-14358","marks":[{"kind":"link","predicate":"cites","target":"#8--pipeline-without-validation"}],"text":"Pipeline Without Validation"}]},{"id":"blk-15473","spans":[{"id":"spn-14359","text":"Medium"}]}],[{"id":"blk-15474","spans":[{"id":"spn-14360","text":"9"}]},{"id":"blk-15475","spans":[{"id":"spn-14361","marks":[{"kind":"link","predicate":"cites","target":"#9--bare-primitive-references"}],"text":"Bare Primitive References"}]},{"id":"blk-15476","spans":[{"id":"spn-14362","text":"Low"}]}],[{"id":"blk-15477","spans":[{"id":"spn-14363","text":"10"}]},{"id":"blk-15478","spans":[{"id":"spn-14364","marks":[{"kind":"link","predicate":"cites","target":"#10--copy-paste-governance"}],"text":"Copy-Paste Governance"}]},{"id":"blk-15479","spans":[{"id":"spn-14365","text":"Low"}]}]]},{"id":"blk-15480","kind":"paragraph","spans":[{"id":"spn-14366","text":"---"}]},{"id":"blk-15481","kind":"heading","level":2,"spans":[{"id":"spn-14367","text":"Critical Anti-Patterns"}]},{"id":"blk-15482","kind":"paragraph","spans":[{"id":"spn-14368","text":"---"}]},{"id":"blk-15483","kind":"heading","level":3,"spans":[{"id":"spn-14369","text":"1 — Capabilities Without Providers"}]},{"id":"blk-15484","kind":"paragraph","spans":[{"id":"spn-14370","marks":["bold"],"text":"The mistake:"},{"id":"spn-14371","text":" Declaring capabilities but omitting or leaving blank the provider field."}]},{"id":"blk-15485","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\": { \"config\": { \"instance\": \"ops\" } },\n  \"&time.anomaly\": { \"provider\": \"\", \"config\": {} }\n}"},{"id":"blk-15486","kind":"paragraph","spans":[{"id":"spn-14372","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15487","items":[{"blocks":[{"id":"blk-15489","kind":"paragraph","spans":[{"id":"spn-14373","text":"The runtime cannot bind the capability to any service"}]}],"id":"blk-15488","kind":"list-item"},{"blocks":[{"id":"blk-15491","kind":"paragraph","spans":[{"id":"spn-14374","text":"Generation produces empty MCP server entries"}]}],"id":"blk-15490","kind":"list-item"},{"blocks":[{"id":"blk-15493","kind":"paragraph","spans":[{"id":"spn-14375","text":"The agent appears to have capabilities it cannot actually use"}]}],"id":"blk-15492","kind":"list-item"},{"blocks":[{"id":"blk-15495","kind":"paragraph","spans":[{"id":"spn-14376","text":"Composition passes but generation fails silently or produces broken output"}]}],"id":"blk-15494","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15496","kind":"paragraph","spans":[{"id":"spn-14377","marks":["bold"],"text":"The fix:"},{"id":"spn-14378","text":" Always specify a provider. Use "},{"id":"spn-14379","marks":["code"],"text":"\"auto\""},{"id":"spn-14380","text":" if you want the runtime to resolve it from the registry:"}]},{"id":"blk-15497","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"ops\" } }\n\"&time.anomaly\": { \"provider\": \"auto\", \"config\": {} }"},{"id":"blk-15498","kind":"paragraph","spans":[{"id":"spn-14381","text":"---"}]},{"id":"blk-15499","kind":"heading","level":3,"spans":[{"id":"spn-14382","text":"2 — Ignoring Composition Type Checks"}]},{"id":"blk-15500","kind":"paragraph","spans":[{"id":"spn-14383","marks":["bold"],"text":"The mistake:"},{"id":"spn-14384","text":" Building pipelines without verifying that step N's output type matches step N+1's "},{"id":"spn-14385","marks":["code"],"text":"accepts_from"},{"id":"spn-14386","text":" list."}]},{"id":"blk-15501","kind":"code","language":"json","text":"\"steps\": [\n  { \"capability\": \"&time.forecast\", \"operation\": \"predict\" },\n  { \"capability\": \"&memory.graph\", \"operation\": \"enrich\" }\n]"},{"id":"blk-15502","kind":"paragraph","spans":[{"id":"spn-14387","text":"If "},{"id":"spn-14388","marks":["code"],"text":"&time.forecast.predict()"},{"id":"spn-14389","text":" outputs "},{"id":"spn-14390","marks":["code"],"text":"forecast_set"},{"id":"spn-14391","text":" but "},{"id":"spn-14392","marks":["code"],"text":"&memory.graph.enrich()"},{"id":"spn-14393","text":" does not accept "},{"id":"spn-14394","marks":["code"],"text":"forecast_set"},{"id":"spn-14395","text":", the pipeline breaks at runtime."}]},{"id":"blk-15503","kind":"paragraph","spans":[{"id":"spn-14396","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15504","items":[{"blocks":[{"id":"blk-15506","kind":"paragraph","spans":[{"id":"spn-14397","text":"Runtime errors instead of compile-time errors"}]}],"id":"blk-15505","kind":"list-item"},{"blocks":[{"id":"blk-15508","kind":"paragraph","spans":[{"id":"spn-14398","text":"Silent data loss or unexpected behavior"}]}],"id":"blk-15507","kind":"list-item"},{"blocks":[{"id":"blk-15510","kind":"paragraph","spans":[{"id":"spn-14399","text":"Difficult to debug in production"}]}],"id":"blk-15509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15511","kind":"paragraph","spans":[{"id":"spn-14400","marks":["bold"],"text":"The fix:"},{"id":"spn-14401","text":" Run "},{"id":"spn-14402","marks":["code"],"text":"ampersand compose"},{"id":"spn-14403","text":" before "},{"id":"spn-14404","marks":["code"],"text":"ampersand generate"},{"id":"spn-14405","text":". Always check the type flow:"}]},{"id":"blk-15512","kind":"code","language":"bash","text":"ampersand compose agent.ampersand.json --verbose"},{"id":"blk-15513","kind":"paragraph","spans":[{"id":"spn-14406","text":"The verbose output shows the type at each pipeline step, making mismatches immediately visible."}]},{"id":"blk-15514","kind":"paragraph","spans":[{"id":"spn-14407","text":"---"}]},{"id":"blk-15515","kind":"heading","level":2,"spans":[{"id":"spn-14408","text":"High-Severity Anti-Patterns"}]},{"id":"blk-15516","kind":"paragraph","spans":[{"id":"spn-14409","text":"---"}]},{"id":"blk-15517","kind":"heading","level":3,"spans":[{"id":"spn-14410","text":"3 — Kitchen-Sink Declarations"}]},{"id":"blk-15518","kind":"paragraph","spans":[{"id":"spn-14411","marks":["bold"],"text":"The mistake:"},{"id":"spn-14412","text":" Declaring every available capability even when the agent does not need most of them."}]},{"id":"blk-15519","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\": { ... },\n  \"&memory.vector\": { ... },\n  \"&memory.episodic\": { ... },\n  \"&memory.semantic\": { ... },\n  \"&time.anomaly\": { ... },\n  \"&time.forecast\": { ... },\n  \"&time.pattern\": { ... },\n  \"&time.baseline\": { ... },\n  \"&space.fleet\": { ... },\n  \"&space.geofence\": { ... },\n  \"&reason.argument\": { ... },\n  \"&reason.vote\": { ... },\n  \"&reason.plan\": { ... },\n  \"&reason.deliberate\": { ... },\n  \"&reason.attend\": { ... }\n}"},{"id":"blk-15520","kind":"paragraph","spans":[{"id":"spn-14413","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15521","items":[{"blocks":[{"id":"blk-15523","kind":"paragraph","spans":[{"id":"spn-14414","text":"Generated MCP config starts 8+ servers, most unused"}]}],"id":"blk-15522","kind":"list-item"},{"blocks":[{"id":"blk-15525","kind":"paragraph","spans":[{"id":"spn-14415","text":"A2A agent card advertises skills the agent cannot meaningfully perform"}]}],"id":"blk-15524","kind":"list-item"},{"blocks":[{"id":"blk-15527","kind":"paragraph","spans":[{"id":"spn-14416","text":"More providers means more failure points"}]}],"id":"blk-15526","kind":"list-item"},{"blocks":[{"id":"blk-15529","kind":"paragraph","spans":[{"id":"spn-14417","text":"Harder to reason about what the agent actually does"}]}],"id":"blk-15528","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15530","kind":"paragraph","spans":[{"id":"spn-14418","marks":["bold"],"text":"The fix:"},{"id":"spn-14419","text":" Start with the minimum set of capabilities your use case requires. Add more only when a concrete need emerges:"}]},{"id":"blk-15531","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\":    { \"provider\": \"graphonomous\", \"config\": {} },\n  \"&time.anomaly\":    { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&reason.argument\": { \"provider\": \"deliberatic\", \"config\": {} }\n}"},{"id":"blk-15532","kind":"paragraph","spans":[{"id":"spn-14420","text":"Three capabilities that work together is better than fifteen that sit idle."}]},{"id":"blk-15533","kind":"paragraph","spans":[{"id":"spn-14421","text":"---"}]},{"id":"blk-15534","kind":"heading","level":3,"spans":[{"id":"spn-14422","text":"4 — Missing Provenance on Critical Capabilities"}]},{"id":"blk-15535","kind":"paragraph","spans":[{"id":"spn-14423","marks":["bold"],"text":"The mistake:"},{"id":"spn-14424","text":" Omitting "},{"id":"spn-14425","marks":["code"],"text":"\"provenance\": true"},{"id":"spn-14426","text":" on agents that make consequential decisions."}]},{"id":"blk-15536","kind":"paragraph","spans":[{"id":"spn-14427","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15537","items":[{"blocks":[{"id":"blk-15539","kind":"paragraph","spans":[{"id":"spn-14428","text":"No audit trail for decisions"}]}],"id":"blk-15538","kind":"list-item"},{"blocks":[{"id":"blk-15541","kind":"paragraph","spans":[{"id":"spn-14429","text":"Cannot trace which capability contributed to an outcome"}]}],"id":"blk-15540","kind":"list-item"},{"blocks":[{"id":"blk-15543","kind":"paragraph","spans":[{"id":"spn-14430","text":"Compliance requirements cannot be verified"}]}],"id":"blk-15542","kind":"list-item"},{"blocks":[{"id":"blk-15545","kind":"paragraph","spans":[{"id":"spn-14431","text":"Debugging production issues requires reproducing the full pipeline"}]}],"id":"blk-15544","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15546","kind":"paragraph","spans":[{"id":"spn-14432","marks":["bold"],"text":"The fix:"},{"id":"spn-14433","text":" Enable provenance on any agent that makes decisions affecting users, infrastructure, or finances:"}]},{"id":"blk-15547","kind":"code","language":"json","text":"\"provenance\": true"},{"id":"blk-15548","kind":"paragraph","spans":[{"id":"spn-14434","text":"The overhead is minimal — a hash computation per operation. The value is significant — a complete, verifiable decision trail."}]},{"id":"blk-15549","kind":"paragraph","spans":[{"id":"spn-14435","text":"---"}]},{"id":"blk-15550","kind":"heading","level":3,"spans":[{"id":"spn-14436","text":"5 — Governance Gaps"}]},{"id":"blk-15551","kind":"paragraph","spans":[{"id":"spn-14437","marks":["bold"],"text":"The mistake:"},{"id":"spn-14438","text":" Declaring autonomous agents without escalation rules or hard constraints."}]},{"id":"blk-15552","kind":"code","language":"json","text":"\"governance\": {\n  \"autonomy\": { \"level\": \"act\" }\n}"},{"id":"blk-15553","kind":"paragraph","spans":[{"id":"spn-14439","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15554","items":[{"blocks":[{"id":"blk-15556","kind":"paragraph","spans":[{"id":"spn-14440","text":"The agent has full autonomy with no guardrails"}]}],"id":"blk-15555","kind":"list-item"},{"blocks":[{"id":"blk-15558","kind":"paragraph","spans":[{"id":"spn-14441","text":"No mechanism to stop it from taking harmful actions"}]}],"id":"blk-15557","kind":"list-item"},{"blocks":[{"id":"blk-15560","kind":"paragraph","spans":[{"id":"spn-14442","text":"No escalation path when confidence is low"}]}],"id":"blk-15559","kind":"list-item"},{"blocks":[{"id":"blk-15562","kind":"paragraph","spans":[{"id":"spn-14443","text":"Violates the principle that autonomy requires governance"}]}],"id":"blk-15561","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15563","kind":"paragraph","spans":[{"id":"spn-14444","marks":["bold"],"text":"The fix:"},{"id":"spn-14445","text":" Every "},{"id":"spn-14446","marks":["code"],"text":"act"},{"id":"spn-14447","text":"-level agent needs hard constraints and escalation:"}]},{"id":"blk-15564","kind":"code","language":"json","text":"\"governance\": {\n  \"hard\": [\"Never exceed budget allocation\"],\n  \"escalate_when\": { \"confidence_below\": 0.6 },\n  \"autonomy\": {\n    \"level\": \"act\",\n    \"budget\": { \"max_actions_per_hour\": 10 }\n  }\n}"},{"id":"blk-15565","kind":"paragraph","spans":[{"id":"spn-14448","text":"The higher the autonomy, the more governance is required."}]},{"id":"blk-15566","kind":"paragraph","spans":[{"id":"spn-14449","text":"---"}]},{"id":"blk-15567","kind":"heading","level":2,"spans":[{"id":"spn-14450","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-15568","kind":"paragraph","spans":[{"id":"spn-14451","text":"---"}]},{"id":"blk-15569","kind":"heading","level":3,"spans":[{"id":"spn-14452","text":"6 — Over-Specifying Providers"}]},{"id":"blk-15570","kind":"paragraph","spans":[{"id":"spn-14453","marks":["bold"],"text":"The mistake:"},{"id":"spn-14454","text":" Hardcoding specific provider names when the agent could work with any conforming provider."}]},{"id":"blk-15571","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": {} }"},{"id":"blk-15572","kind":"paragraph","spans":[{"id":"spn-14455","marks":["bold"],"text":"Why it's harmful (when portability matters):"}]},{"id":"blk-15573","items":[{"blocks":[{"id":"blk-15575","kind":"paragraph","spans":[{"id":"spn-14456","text":"Locks the agent to a specific provider"}]}],"id":"blk-15574","kind":"list-item"},{"blocks":[{"id":"blk-15577","kind":"paragraph","spans":[{"id":"spn-14457","text":"Cannot swap to an alternative without modifying the declaration"}]}],"id":"blk-15576","kind":"list-item"},{"blocks":[{"id":"blk-15579","kind":"paragraph","spans":[{"id":"spn-14458","text":"Reduces adoption — users without access to that provider cannot use the agent"}]}],"id":"blk-15578","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15580","kind":"paragraph","spans":[{"id":"spn-14459","marks":["bold"],"text":"The fix:"},{"id":"spn-14460","text":" Use "},{"id":"spn-14461","marks":["code"],"text":"\"auto\""},{"id":"spn-14462","text":" for capabilities where the specific provider does not matter, and explicit providers only when provider-specific features are required:"}]},{"id":"blk-15581","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"auto\", \"config\": { \"index\": \"docs\" } }"},{"id":"blk-15582","kind":"paragraph","spans":[{"id":"spn-14463","text":"Note: This is only an anti-pattern when portability is a goal. For internal agents with known infrastructure, explicit providers are fine."}]},{"id":"blk-15583","kind":"paragraph","spans":[{"id":"spn-14464","text":"---"}]},{"id":"blk-15584","kind":"heading","level":3,"spans":[{"id":"spn-14465","text":"7 — Ignoring Contract Versioning"}]},{"id":"blk-15585","kind":"paragraph","spans":[{"id":"spn-14466","marks":["bold"],"text":"The mistake:"},{"id":"spn-14467","text":" Never specifying which contract version a declaration was built against."}]},{"id":"blk-15586","kind":"paragraph","spans":[{"id":"spn-14468","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15587","items":[{"blocks":[{"id":"blk-15589","kind":"paragraph","spans":[{"id":"spn-14469","text":"A provider updates its contract, breaking your pipeline"}]}],"id":"blk-15588","kind":"list-item"},{"blocks":[{"id":"blk-15591","kind":"paragraph","spans":[{"id":"spn-14470","text":"No way to pin to a known-working version"}]}],"id":"blk-15590","kind":"list-item"},{"blocks":[{"id":"blk-15593","kind":"paragraph","spans":[{"id":"spn-14471","text":"Composition may pass today and fail tomorrow"}]}],"id":"blk-15592","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15594","kind":"paragraph","spans":[{"id":"spn-14472","marks":["bold"],"text":"The fix:"},{"id":"spn-14473","text":" Pin your declarations to specific contract versions and test against them in CI:"}]},{"id":"blk-15595","kind":"code","language":"bash","text":"ampersand validate agent.ampersand.json --schema protocol/schema/v0.1.0/"},{"id":"blk-15596","kind":"paragraph","spans":[{"id":"spn-14474","text":"When upgrading, review the contract changelog for breaking changes."}]},{"id":"blk-15597","kind":"paragraph","spans":[{"id":"spn-14475","text":"---"}]},{"id":"blk-15598","kind":"heading","level":3,"spans":[{"id":"spn-14476","text":"8 — Pipeline Without Validation"}]},{"id":"blk-15599","kind":"paragraph","spans":[{"id":"spn-14477","marks":["bold"],"text":"The mistake:"},{"id":"spn-14478","text":" Defining pipelines in the declaration but only running "},{"id":"spn-14479","marks":["code"],"text":"validate"},{"id":"spn-14480","text":" (schema check) and never "},{"id":"spn-14481","marks":["code"],"text":"compose"},{"id":"spn-14482","text":" (type check)."}]},{"id":"blk-15600","kind":"paragraph","spans":[{"id":"spn-14483","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15601","items":[{"blocks":[{"id":"blk-15603","kind":"paragraph","spans":[{"id":"spn-14484","marks":["code"],"text":"validate"},{"id":"spn-14485","text":" checks structure, not semantics"}]}],"id":"blk-15602","kind":"list-item"},{"blocks":[{"id":"blk-15605","kind":"paragraph","spans":[{"id":"spn-14486","text":"A structurally valid pipeline can have type mismatches"}]}],"id":"blk-15604","kind":"list-item"},{"blocks":[{"id":"blk-15607","kind":"paragraph","spans":[{"id":"spn-14487","text":"Errors surface at generation or runtime instead of composition time"}]}],"id":"blk-15606","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15608","kind":"paragraph","spans":[{"id":"spn-14488","marks":["bold"],"text":"The fix:"},{"id":"spn-14489","text":" Always run "},{"id":"spn-14490","marks":["code"],"text":"compose"},{"id":"spn-14491","text":" after "},{"id":"spn-14492","marks":["code"],"text":"validate"},{"id":"spn-14493","text":":"}]},{"id":"blk-15609","kind":"code","language":"bash","text":"ampersand validate agent.ampersand.json && ampersand compose agent.ampersand.json"},{"id":"blk-15610","kind":"paragraph","spans":[{"id":"spn-14494","text":"Or just run "},{"id":"spn-14495","marks":["code"],"text":"generate"},{"id":"spn-14496","text":", which includes both checks."}]},{"id":"blk-15611","kind":"paragraph","spans":[{"id":"spn-14497","text":"---"}]},{"id":"blk-15612","kind":"heading","level":2,"spans":[{"id":"spn-14498","text":"Low-Severity Anti-Patterns"}]},{"id":"blk-15613","kind":"paragraph","spans":[{"id":"spn-14499","text":"---"}]},{"id":"blk-15614","kind":"heading","level":3,"spans":[{"id":"spn-14500","text":"9 — Bare Primitive References"}]},{"id":"blk-15615","kind":"paragraph","spans":[{"id":"spn-14501","marks":["bold"],"text":"The mistake:"},{"id":"spn-14502","text":" Using "},{"id":"spn-14503","marks":["code"],"text":"&memory"},{"id":"spn-14504","text":" instead of "},{"id":"spn-14505","marks":["code"],"text":"&memory.graph"},{"id":"spn-14506","text":" in discussions, documentation, or (attempted) declarations."}]},{"id":"blk-15616","kind":"paragraph","spans":[{"id":"spn-14507","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15617","items":[{"blocks":[{"id":"blk-15619","kind":"paragraph","spans":[{"id":"spn-14508","text":"Declarations require subtypes — "},{"id":"spn-14509","marks":["code"],"text":"&memory"},{"id":"spn-14510","text":" alone is not valid"}]}],"id":"blk-15618","kind":"list-item"},{"blocks":[{"id":"blk-15621","kind":"paragraph","spans":[{"id":"spn-14511","text":"Creates ambiguity about which specific capability is meant"}]}],"id":"blk-15620","kind":"list-item"},{"blocks":[{"id":"blk-15623","kind":"paragraph","spans":[{"id":"spn-14512","text":"New users may think bare primitives work and get confused by errors"}]}],"id":"blk-15622","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15624","kind":"paragraph","spans":[{"id":"spn-14513","marks":["bold"],"text":"The fix:"},{"id":"spn-14514","text":" Always use the full "},{"id":"spn-14515","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14516","text":" form:"}]},{"id":"blk-15625","kind":"code","language":"text","text":"&memory.graph    (not &memory)\n&reason.argument (not &reason)\n&time.anomaly    (not &time)\n&space.fleet     (not &space)"},{"id":"blk-15626","kind":"paragraph","spans":[{"id":"spn-14517","text":"---"}]},{"id":"blk-15627","kind":"heading","level":3,"spans":[{"id":"spn-14518","text":"10 — Copy-Paste Governance"}]},{"id":"blk-15628","kind":"paragraph","spans":[{"id":"spn-14519","marks":["bold"],"text":"The mistake:"},{"id":"spn-14520","text":" Copying governance blocks from examples without adapting them to the agent's actual requirements."}]},{"id":"blk-15629","kind":"paragraph","spans":[{"id":"spn-14521","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-15630","items":[{"blocks":[{"id":"blk-15632","kind":"paragraph","spans":[{"id":"spn-14522","text":"Constraints may be too loose or too strict for the use case"}]}],"id":"blk-15631","kind":"list-item"},{"blocks":[{"id":"blk-15634","kind":"paragraph","spans":[{"id":"spn-14523","text":"Escalation thresholds may not match operational reality"}]}],"id":"blk-15633","kind":"list-item"},{"blocks":[{"id":"blk-15636","kind":"paragraph","spans":[{"id":"spn-14524","text":"Budget limits may be inappropriate"}]}],"id":"blk-15635","kind":"list-item"},{"blocks":[{"id":"blk-15638","kind":"paragraph","spans":[{"id":"spn-14525","text":"Creates a false sense of security"}]}],"id":"blk-15637","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15639","kind":"paragraph","spans":[{"id":"spn-14526","marks":["bold"],"text":"The fix:"},{"id":"spn-14527","text":" Write governance constraints specific to your agent's domain, risk profile, and operational context. Use examples as templates, not as final answers."}]},{"id":"blk-15640","kind":"paragraph","spans":[{"id":"spn-14528","text":"---"}]},{"id":"blk-15641","kind":"heading","level":2,"spans":[{"id":"spn-14529","text":"Self-Audit Checklist"}]},{"id":"blk-15642","kind":"paragraph","spans":[{"id":"spn-14530","text":"Run through this before deploying an agent declaration:"}]},{"id":"blk-15643","kind":"heading","level":3,"spans":[{"id":"spn-14531","text":"Declaration"}]},{"id":"blk-15644","items":[{"blocks":[{"id":"blk-15646","kind":"paragraph","spans":[{"id":"spn-14532","text":"[ ] Every capability has an explicit provider (or "},{"id":"spn-14533","marks":["code"],"text":"\"auto\""},{"id":"spn-14534","text":")"}]}],"id":"blk-15645","kind":"list-item"},{"blocks":[{"id":"blk-15648","kind":"paragraph","spans":[{"id":"spn-14535","text":"[ ] Agent name and version are set"}]}],"id":"blk-15647","kind":"list-item"},{"blocks":[{"id":"blk-15650","kind":"paragraph","spans":[{"id":"spn-14536","text":"[ ] Only needed capabilities are declared"}]}],"id":"blk-15649","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15651","kind":"heading","level":3,"spans":[{"id":"spn-14537","text":"Composition"}]},{"id":"blk-15652","items":[{"blocks":[{"id":"blk-15654","kind":"paragraph","spans":[{"id":"spn-14538","text":"[ ] "},{"id":"spn-14539","marks":["code"],"text":"ampersand compose"},{"id":"spn-14540","text":" passes with no errors"}]}],"id":"blk-15653","kind":"list-item"},{"blocks":[{"id":"blk-15656","kind":"paragraph","spans":[{"id":"spn-14541","text":"[ ] Pipeline type flow is verified (use "},{"id":"spn-14542","marks":["code"],"text":"--verbose"},{"id":"spn-14543","text":")"}]}],"id":"blk-15655","kind":"list-item"},{"blocks":[{"id":"blk-15658","kind":"paragraph","spans":[{"id":"spn-14544","text":"[ ] No circular pipeline dependencies"}]}],"id":"blk-15657","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15659","kind":"heading","level":3,"spans":[{"id":"spn-14545","text":"Governance"}]},{"id":"blk-15660","items":[{"blocks":[{"id":"blk-15662","kind":"paragraph","spans":[{"id":"spn-14546","text":"[ ] Hard constraints cover critical boundaries"}]}],"id":"blk-15661","kind":"list-item"},{"blocks":[{"id":"blk-15664","kind":"paragraph","spans":[{"id":"spn-14547","text":"[ ] Escalation triggers are set for autonomous agents"}]}],"id":"blk-15663","kind":"list-item"},{"blocks":[{"id":"blk-15666","kind":"paragraph","spans":[{"id":"spn-14548","text":"[ ] Autonomy level matches operational trust level"}]}],"id":"blk-15665","kind":"list-item"},{"blocks":[{"id":"blk-15668","kind":"paragraph","spans":[{"id":"spn-14549","text":"[ ] Budget limits are appropriate"}]}],"id":"blk-15667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15669","kind":"heading","level":3,"spans":[{"id":"spn-14550","text":"Provenance"}]},{"id":"blk-15670","items":[{"blocks":[{"id":"blk-15672","kind":"paragraph","spans":[{"id":"spn-14551","text":"[ ] "},{"id":"spn-14552","marks":["code"],"text":"provenance: true"},{"id":"spn-14553","text":" for agents making consequential decisions"}]}],"id":"blk-15671","kind":"list-item"},{"blocks":[{"id":"blk-15674","kind":"paragraph","spans":[{"id":"spn-14554","text":"[ ] Audit trail requirements are met"}]}],"id":"blk-15673","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15675","kind":"heading","level":3,"spans":[{"id":"spn-14555","text":"Portability"}]},{"id":"blk-15676","items":[{"blocks":[{"id":"blk-15678","kind":"paragraph","spans":[{"id":"spn-14556","text":"[ ] Providers are explicit only when provider-specific features are needed"}]}],"id":"blk-15677","kind":"list-item"},{"blocks":[{"id":"blk-15680","kind":"paragraph","spans":[{"id":"spn-14557","text":"[ ] Contract versions are pinned for production agents"}]}],"id":"blk-15679","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierapzgo3uc7atonddikoymauz4xrieqsivxcfqomxuwohnhwpyxx4hq","vocabulary":"ampersand.docs.fs.v1"}