{"bendscript":"0.1","blocks":[{"id":"blk-6466","kind":"heading","level":1,"spans":[{"id":"spn-6592","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6593","text":" — Human-in-the-Loop Escalation and Governance Handoff"}]},{"id":"blk-6467","kind":"paragraph","spans":[{"id":"spn-6594","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6595","text":" is the [&] Protocol capability for "},{"id":"spn-6596","marks":["bold"],"text":"governance-mandated escalation"},{"id":"spn-6597","text":"."}]},{"id":"blk-6468","kind":"paragraph","spans":[{"id":"spn-6598","text":"It describes an agent's ability to:"}]},{"id":"blk-6469","items":[{"blocks":[{"id":"blk-6471","kind":"paragraph","spans":[{"id":"spn-6599","text":"detect when a decision exceeds its authorized autonomy"}]}],"id":"blk-6470","kind":"list-item"},{"blocks":[{"id":"blk-6473","kind":"paragraph","spans":[{"id":"spn-6600","text":"surface that decision to a human operator or governance layer"}]}],"id":"blk-6472","kind":"list-item"},{"blocks":[{"id":"blk-6475","kind":"paragraph","spans":[{"id":"spn-6601","text":"pause execution until a response is received or timeout expires"}]}],"id":"blk-6474","kind":"list-item"},{"blocks":[{"id":"blk-6477","kind":"paragraph","spans":[{"id":"spn-6602","text":"resume with an approved, rejected, or modified action"}]}],"id":"blk-6476","kind":"list-item"},{"blocks":[{"id":"blk-6479","kind":"paragraph","spans":[{"id":"spn-6603","text":"maintain a queryable history of all escalation events"}]}],"id":"blk-6478","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6480","kind":"paragraph","spans":[{"id":"spn-6604","text":"In the protocol's five-primitive model:"}]},{"id":"blk-6481","items":[{"blocks":[{"id":"blk-6483","kind":"paragraph","spans":[{"id":"spn-6605","marks":["code"],"text":"&memory"},{"id":"spn-6606","text":" answers "},{"id":"spn-6607","marks":["bold"],"text":"what"},{"id":"spn-6608","text":" the agent knows"}]}],"id":"blk-6482","kind":"list-item"},{"blocks":[{"id":"blk-6485","kind":"paragraph","spans":[{"id":"spn-6609","marks":["code"],"text":"&reason"},{"id":"spn-6610","text":" answers "},{"id":"spn-6611","marks":["bold"],"text":"how"},{"id":"spn-6612","text":" the agent decides"}]}],"id":"blk-6484","kind":"list-item"},{"blocks":[{"id":"blk-6487","kind":"paragraph","spans":[{"id":"spn-6613","marks":["code"],"text":"&time"},{"id":"spn-6614","text":" answers "},{"id":"spn-6615","marks":["bold"],"text":"when"},{"id":"spn-6616","text":" things change"}]}],"id":"blk-6486","kind":"list-item"},{"blocks":[{"id":"blk-6489","kind":"paragraph","spans":[{"id":"spn-6617","marks":["code"],"text":"&space"},{"id":"spn-6618","text":" answers "},{"id":"spn-6619","marks":["bold"],"text":"where"},{"id":"spn-6620","text":" things are"}]}],"id":"blk-6488","kind":"list-item"},{"blocks":[{"id":"blk-6491","kind":"paragraph","spans":[{"id":"spn-6621","marks":["code"],"text":"&govern"},{"id":"spn-6622","text":" answers "},{"id":"spn-6623","marks":["bold"],"text":"who approves, what limits apply, and how decisions are audited"}]}],"id":"blk-6490","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6492","kind":"paragraph","spans":[{"id":"spn-6624","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6625","text":" is the subtype that handles the critical handoff between autonomous agent action and human oversight."}]},{"id":"blk-6493","kind":"paragraph","spans":[{"id":"spn-6626","text":"---"}]},{"id":"blk-6494","kind":"heading","level":2,"spans":[{"id":"spn-6627","text":"1. Definition"}]},{"id":"blk-6495","kind":"paragraph","spans":[{"id":"spn-6628","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6629","text":" is the capability interface for "},{"id":"spn-6630","marks":["bold"],"text":"human-in-the-loop decision escalation"},{"id":"spn-6631","text":"."}]},{"id":"blk-6496","kind":"paragraph","spans":[{"id":"spn-6632","text":"It is used when an agent must:"}]},{"id":"blk-6497","items":[{"blocks":[{"id":"blk-6499","kind":"paragraph","spans":[{"id":"spn-6633","text":"pause before executing an action that crosses a governance threshold"}]}],"id":"blk-6498","kind":"list-item"},{"blocks":[{"id":"blk-6501","kind":"paragraph","spans":[{"id":"spn-6634","text":"present a proposed action with rationale to a human reviewer"}]}],"id":"blk-6500","kind":"list-item"},{"blocks":[{"id":"blk-6503","kind":"paragraph","spans":[{"id":"spn-6635","text":"wait for approval, rejection, or modification"}]}],"id":"blk-6502","kind":"list-item"},{"blocks":[{"id":"blk-6505","kind":"paragraph","spans":[{"id":"spn-6636","text":"handle timeout behavior according to autonomy level"}]}],"id":"blk-6504","kind":"list-item"},{"blocks":[{"id":"blk-6507","kind":"paragraph","spans":[{"id":"spn-6637","text":"record the full escalation lifecycle for audit"}]}],"id":"blk-6506","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6508","kind":"paragraph","spans":[{"id":"spn-6638","text":"Escalation is NOT failure. It is a governance-mandated handoff when agent confidence or cost crosses thresholds defined by policy."}]},{"id":"blk-6509","kind":"paragraph","spans":[{"id":"spn-6639","text":"This distinction matters because agents that treat escalation as error will:"}]},{"id":"blk-6510","items":[{"blocks":[{"id":"blk-6512","kind":"paragraph","spans":[{"id":"spn-6640","text":"suppress legitimate governance signals"}]}],"id":"blk-6511","kind":"list-item"},{"blocks":[{"id":"blk-6514","kind":"paragraph","spans":[{"id":"spn-6641","text":"avoid surfacing uncertainty"}]}],"id":"blk-6513","kind":"list-item"},{"blocks":[{"id":"blk-6516","kind":"paragraph","spans":[{"id":"spn-6642","text":"degrade trust over time"}]}],"id":"blk-6515","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6517","kind":"paragraph","spans":[{"id":"spn-6643","text":"The protocol treats escalation as a first-class capability, not an exception path."}]},{"id":"blk-6518","kind":"paragraph","spans":[{"id":"spn-6644","text":"---"}]},{"id":"blk-6519","kind":"heading","level":2,"spans":[{"id":"spn-6645","text":"2. Why this capability exists"}]},{"id":"blk-6520","kind":"paragraph","spans":[{"id":"spn-6646","text":"Many agent systems either operate fully autonomously or halt completely when uncertainty arises."}]},{"id":"blk-6521","kind":"paragraph","spans":[{"id":"spn-6647","text":"Neither extreme is acceptable in production governance:"}]},{"id":"blk-6522","items":[{"blocks":[{"id":"blk-6524","kind":"paragraph","spans":[{"id":"spn-6648","text":"A logistics agent proposes a high-cost reallocation but has no mechanism to ask a human before committing."}]}],"id":"blk-6523","kind":"list-item"},{"blocks":[{"id":"blk-6526","kind":"paragraph","spans":[{"id":"spn-6649","text":"An infrastructure agent detects a hard boundary violation but silently logs it instead of requesting approval."}]}],"id":"blk-6525","kind":"list-item"},{"blocks":[{"id":"blk-6528","kind":"paragraph","spans":[{"id":"spn-6650","text":"A support agent encounters a policy-sensitive case but lacks a structured way to surface it to a supervisor."}]}],"id":"blk-6527","kind":"list-item"},{"blocks":[{"id":"blk-6530","kind":"paragraph","spans":[{"id":"spn-6651","text":"A planning agent operates below its confidence threshold but proceeds anyway because no escalation path exists."}]}],"id":"blk-6529","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6531","kind":"paragraph","spans":[{"id":"spn-6652","text":"In all of these cases, the missing layer is "},{"id":"spn-6653","marks":["bold"],"text":"structured escalation with defined trigger conditions, timeout behavior, and response semantics"},{"id":"spn-6654","text":"."}]},{"id":"blk-6532","kind":"paragraph","spans":[{"id":"spn-6655","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6656","text":" gives the protocol a standard way to declare that capability."}]},{"id":"blk-6533","kind":"paragraph","spans":[{"id":"spn-6657","text":"---"}]},{"id":"blk-6534","kind":"heading","level":2,"spans":[{"id":"spn-6658","text":"3. What problems "},{"id":"spn-6659","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6660","text":" solves"}]},{"id":"blk-6535","kind":"paragraph","spans":[{"id":"spn-6661","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6662","text":" is useful when an agent needs to answer questions like:"}]},{"id":"blk-6536","items":[{"blocks":[{"id":"blk-6538","kind":"paragraph","spans":[{"id":"spn-6663","text":"Should I proceed with this action given my current confidence level?"}]}],"id":"blk-6537","kind":"list-item"},{"blocks":[{"id":"blk-6540","kind":"paragraph","spans":[{"id":"spn-6664","text":"Does this action exceed the cost threshold defined by Delegatic policy?"}]}],"id":"blk-6539","kind":"list-item"},{"blocks":[{"id":"blk-6542","kind":"paragraph","spans":[{"id":"spn-6665","text":"Am I approaching a hard boundary that requires human sign-off?"}]}],"id":"blk-6541","kind":"list-item"},{"blocks":[{"id":"blk-6544","kind":"paragraph","spans":[{"id":"spn-6666","text":"Does the current autonomy level (observe, advise, act) permit this operation?"}]}],"id":"blk-6543","kind":"list-item"},{"blocks":[{"id":"blk-6546","kind":"paragraph","spans":[{"id":"spn-6667","text":"What should happen if no human responds within the timeout window?"}]}],"id":"blk-6545","kind":"list-item"},{"blocks":[{"id":"blk-6548","kind":"paragraph","spans":[{"id":"spn-6668","text":"How do I resume execution after receiving approval or modification?"}]}],"id":"blk-6547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6549","kind":"paragraph","spans":[{"id":"spn-6669","text":"Without this capability, escalation logic tends to get buried inside:"}]},{"id":"blk-6550","items":[{"blocks":[{"id":"blk-6552","kind":"paragraph","spans":[{"id":"spn-6670","text":"ad-hoc if/else blocks in application code"}]}],"id":"blk-6551","kind":"list-item"},{"blocks":[{"id":"blk-6554","kind":"paragraph","spans":[{"id":"spn-6671","text":"implicit confidence thresholds with no auditability"}]}],"id":"blk-6553","kind":"list-item"},{"blocks":[{"id":"blk-6556","kind":"paragraph","spans":[{"id":"spn-6672","text":"custom notification systems with no structured response path"}]}],"id":"blk-6555","kind":"list-item"},{"blocks":[{"id":"blk-6558","kind":"paragraph","spans":[{"id":"spn-6673","text":"provider-specific approval workflows with no interoperability"}]}],"id":"blk-6557","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6559","kind":"paragraph","spans":[{"id":"spn-6674","text":"The protocol makes it explicit instead."}]},{"id":"blk-6560","kind":"paragraph","spans":[{"id":"spn-6675","text":"---"}]},{"id":"blk-6561","kind":"heading","level":2,"spans":[{"id":"spn-6676","text":"4. Capability role in the "},{"id":"spn-6677","marks":["code"],"text":"&govern"},{"id":"spn-6678","text":" namespace"}]},{"id":"blk-6562","kind":"paragraph","spans":[{"id":"spn-6679","text":"The "},{"id":"spn-6680","marks":["code"],"text":"&govern"},{"id":"spn-6681","text":" primitive supports multiple subtypes, including:"}]},{"id":"blk-6563","items":[{"blocks":[{"id":"blk-6565","kind":"paragraph","spans":[{"id":"spn-6682","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-6564","kind":"list-item"},{"blocks":[{"id":"blk-6567","kind":"paragraph","spans":[{"id":"spn-6683","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-6566","kind":"list-item"},{"blocks":[{"id":"blk-6569","kind":"paragraph","spans":[{"id":"spn-6684","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-6568","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6570","kind":"paragraph","spans":[{"id":"spn-6685","text":"A helpful distinction is:"}]},{"id":"blk-6571","items":[{"blocks":[{"id":"blk-6573","kind":"paragraph","spans":[{"id":"spn-6686","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6687","text":" = decision handoff when thresholds are crossed"}]}],"id":"blk-6572","kind":"list-item"},{"blocks":[{"id":"blk-6575","kind":"paragraph","spans":[{"id":"spn-6688","marks":["code"],"text":"&govern.identity"},{"id":"spn-6689","text":" = agent authentication and trust verification"}]}],"id":"blk-6574","kind":"list-item"},{"blocks":[{"id":"blk-6577","kind":"paragraph","spans":[{"id":"spn-6690","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-6691","text":" = observability, cost tracking, and budget enforcement"}]}],"id":"blk-6576","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6578","kind":"paragraph","spans":[{"id":"spn-6692","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6693","text":" is the right subtype when the main problem is "},{"id":"spn-6694","marks":["bold"],"text":"controlling what happens at the boundary between autonomous action and human oversight"},{"id":"spn-6695","text":"."}]},{"id":"blk-6579","kind":"paragraph","spans":[{"id":"spn-6696","text":"---"}]},{"id":"blk-6580","kind":"heading","level":2,"spans":[{"id":"spn-6697","text":"5. Typical use cases"}]},{"id":"blk-6581","kind":"heading","level":3,"spans":[{"id":"spn-6698","text":"Confidence-based escalation"}]},{"id":"blk-6582","kind":"paragraph","spans":[{"id":"spn-6699","text":"Agent confidence drops below the configured threshold during reasoning. The proposed action is surfaced for human review before execution."}]},{"id":"blk-6583","kind":"heading","level":3,"spans":[{"id":"spn-6700","text":"Cost-based escalation"}]},{"id":"blk-6584","kind":"paragraph","spans":[{"id":"spn-6701","text":"A planned action would exceed the per-task or per-period cost budget defined in Delegatic policy. The agent requests approval before committing resources."}]},{"id":"blk-6585","kind":"heading","level":3,"spans":[{"id":"spn-6702","text":"Hard boundary escalation"}]},{"id":"blk-6586","kind":"paragraph","spans":[{"id":"spn-6703","text":"The agent approaches a governance hard constraint (e.g., \"never deploy to production without approval\"). The boundary rule triggers mandatory human review."}]},{"id":"blk-6587","kind":"heading","level":3,"spans":[{"id":"spn-6704","text":"Policy-required approval"}]},{"id":"blk-6588","kind":"paragraph","spans":[{"id":"spn-6705","text":"The autonomy level or org policy requires human sign-off for certain capability operations regardless of confidence or cost."}]},{"id":"blk-6589","kind":"heading","level":3,"spans":[{"id":"spn-6706","text":"Cross-agent escalation"}]},{"id":"blk-6590","kind":"paragraph","spans":[{"id":"spn-6707","text":"In multi-agent workflows, one agent escalates to another agent's human operator when a collaborative decision crosses governance boundaries."}]},{"id":"blk-6591","kind":"heading","level":3,"spans":[{"id":"spn-6708","text":"Audit-driven escalation"}]},{"id":"blk-6592","kind":"paragraph","spans":[{"id":"spn-6709","text":"Retrospective analysis of telemetry reveals that an action should have been escalated. The system flags it for review and updates escalation policy."}]},{"id":"blk-6593","kind":"paragraph","spans":[{"id":"spn-6710","text":"---"}]},{"id":"blk-6594","kind":"heading","level":2,"spans":[{"id":"spn-6711","text":"6. Example capability contract"}]},{"id":"blk-6595","kind":"paragraph","spans":[{"id":"spn-6712","text":"The authoritative contract is at "},{"id":"spn-6713","marks":["code"],"text":"contracts/v0.1.0/govern.escalation.contract.json"},{"id":"spn-6714","text":"."}]},{"id":"blk-6596","kind":"paragraph","spans":[{"id":"spn-6715","text":"A representative summary:"}]},{"id":"blk-6597","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&govern.escalation\",\n  \"provider\": \"opensentience\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Human-in-the-loop escalation contract for governance-mandated decision handoff.\",\n  \"operations\": {\n    \"escalate\": {\n      \"in\": \"escalation_request\",\n      \"out\": \"escalation_ack\",\n      \"description\": \"Submit an action for human review. Agent pauses until response or timeout.\"\n    },\n    \"respond\": {\n      \"in\": \"escalation_response\",\n      \"out\": \"resolution\",\n      \"description\": \"Human operator approves, rejects, or modifies the escalated action.\"\n    },\n    \"query\": {\n      \"in\": \"escalation_query\",\n      \"out\": \"escalation_history\",\n      \"description\": \"Query pending, resolved, or expired escalations by agent, org, goal, or time range.\"\n    }\n  },\n  \"accepts_from\": [\n    \"&reason.*\",\n    \"&govern.telemetry\",\n    \"escalation_request\",\n    \"escalation_response\"\n  ],\n  \"feeds_into\": [\n    \"&reason.*\",\n    \"&govern.telemetry\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"human-escalation-bridge\",\n    \"approval-workflow\"\n  ]\n}"},{"id":"blk-6598","kind":"heading","level":3,"spans":[{"id":"spn-6716","text":"What this contract means"}]},{"id":"blk-6599","kind":"paragraph","spans":[{"id":"spn-6717","text":"This contract says that "},{"id":"spn-6718","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6719","text":" can:"}]},{"id":"blk-6600","items":[{"blocks":[{"id":"blk-6602","kind":"paragraph","spans":[{"id":"spn-6720","text":"accept escalation requests from reasoning capabilities or telemetry triggers"}]}],"id":"blk-6601","kind":"list-item"},{"blocks":[{"id":"blk-6604","kind":"paragraph","spans":[{"id":"spn-6721","text":"present them to a human operator via the escalation bridge"}]}],"id":"blk-6603","kind":"list-item"},{"blocks":[{"id":"blk-6606","kind":"paragraph","spans":[{"id":"spn-6722","text":"return structured resolutions (approve, reject, modify)"}]}],"id":"blk-6605","kind":"list-item"},{"blocks":[{"id":"blk-6608","kind":"paragraph","spans":[{"id":"spn-6723","text":"feed resolution outcomes back into reasoning and telemetry"}]}],"id":"blk-6607","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6609","kind":"paragraph","spans":[{"id":"spn-6724","text":"It also says that this capability composes well with:"}]},{"id":"blk-6610","items":[{"blocks":[{"id":"blk-6612","kind":"paragraph","spans":[{"id":"spn-6725","marks":["code"],"text":"&reason.*"},{"id":"spn-6726","text":" upstream, where reasoning produces actions that may require approval"}]}],"id":"blk-6611","kind":"list-item"},{"blocks":[{"id":"blk-6614","kind":"paragraph","spans":[{"id":"spn-6727","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-6728","text":" upstream, where cost or usage signals trigger escalation"}]}],"id":"blk-6613","kind":"list-item"},{"blocks":[{"id":"blk-6616","kind":"paragraph","spans":[{"id":"spn-6729","marks":["code"],"text":"&reason.*"},{"id":"spn-6730","text":" downstream, where approved or modified actions resume execution"}]}],"id":"blk-6615","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6617","kind":"paragraph","spans":[{"id":"spn-6731","text":"---"}]},{"id":"blk-6618","kind":"heading","level":2,"spans":[{"id":"spn-6732","text":"7. Core operations"}]},{"id":"blk-6619","kind":"heading","level":3,"spans":[{"id":"spn-6733","marks":["code"],"text":"escalate"}]},{"id":"blk-6620","kind":"paragraph","spans":[{"id":"spn-6734","text":"Purpose:"}]},{"id":"blk-6621","items":[{"blocks":[{"id":"blk-6623","kind":"paragraph","spans":[{"id":"spn-6735","text":"submit a proposed action for human review"}]}],"id":"blk-6622","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6624","kind":"paragraph","spans":[{"id":"spn-6736","text":"Typical input:"}]},{"id":"blk-6625","items":[{"blocks":[{"id":"blk-6627","kind":"paragraph","spans":[{"id":"spn-6737","marks":["code"],"text":"escalation_request"}]}],"id":"blk-6626","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6628","kind":"paragraph","spans":[{"id":"spn-6738","text":"Typical output:"}]},{"id":"blk-6629","items":[{"blocks":[{"id":"blk-6631","kind":"paragraph","spans":[{"id":"spn-6739","marks":["code"],"text":"escalation_ack"}]}],"id":"blk-6630","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6632","kind":"paragraph","spans":[{"id":"spn-6740","text":"Use when:"}]},{"id":"blk-6633","items":[{"blocks":[{"id":"blk-6635","kind":"paragraph","spans":[{"id":"spn-6741","text":"the agent's confidence is below the configured threshold"}]}],"id":"blk-6634","kind":"list-item"},{"blocks":[{"id":"blk-6637","kind":"paragraph","spans":[{"id":"spn-6742","text":"the estimated cost exceeds Delegatic policy limits"}]}],"id":"blk-6636","kind":"list-item"},{"blocks":[{"id":"blk-6639","kind":"paragraph","spans":[{"id":"spn-6743","text":"a hard boundary constraint is approaching"}]}],"id":"blk-6638","kind":"list-item"},{"blocks":[{"id":"blk-6641","kind":"paragraph","spans":[{"id":"spn-6744","text":"the autonomy level requires approval for this operation type"}]}],"id":"blk-6640","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6642","kind":"heading","level":3,"spans":[{"id":"spn-6745","marks":["code"],"text":"respond"}]},{"id":"blk-6643","kind":"paragraph","spans":[{"id":"spn-6746","text":"Purpose:"}]},{"id":"blk-6644","items":[{"blocks":[{"id":"blk-6646","kind":"paragraph","spans":[{"id":"spn-6747","text":"deliver a human operator's decision back to the requesting agent"}]}],"id":"blk-6645","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6647","kind":"paragraph","spans":[{"id":"spn-6748","text":"Typical input:"}]},{"id":"blk-6648","items":[{"blocks":[{"id":"blk-6650","kind":"paragraph","spans":[{"id":"spn-6749","marks":["code"],"text":"escalation_response"}]}],"id":"blk-6649","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6651","kind":"paragraph","spans":[{"id":"spn-6750","text":"Typical output:"}]},{"id":"blk-6652","items":[{"blocks":[{"id":"blk-6654","kind":"paragraph","spans":[{"id":"spn-6751","marks":["code"],"text":"resolution"}]}],"id":"blk-6653","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6655","kind":"paragraph","spans":[{"id":"spn-6752","text":"Use when:"}]},{"id":"blk-6656","items":[{"blocks":[{"id":"blk-6658","kind":"paragraph","spans":[{"id":"spn-6753","text":"a human has reviewed the escalated action and chosen to approve, reject, or modify it"}]}],"id":"blk-6657","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6659","kind":"heading","level":3,"spans":[{"id":"spn-6754","marks":["code"],"text":"query"}]},{"id":"blk-6660","kind":"paragraph","spans":[{"id":"spn-6755","text":"Purpose:"}]},{"id":"blk-6661","items":[{"blocks":[{"id":"blk-6663","kind":"paragraph","spans":[{"id":"spn-6756","text":"inspect the history and status of escalation events"}]}],"id":"blk-6662","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6664","kind":"paragraph","spans":[{"id":"spn-6757","text":"Typical input:"}]},{"id":"blk-6665","items":[{"blocks":[{"id":"blk-6667","kind":"paragraph","spans":[{"id":"spn-6758","marks":["code"],"text":"escalation_query"}]}],"id":"blk-6666","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6668","kind":"paragraph","spans":[{"id":"spn-6759","text":"Typical output:"}]},{"id":"blk-6669","items":[{"blocks":[{"id":"blk-6671","kind":"paragraph","spans":[{"id":"spn-6760","marks":["code"],"text":"escalation_history"}]}],"id":"blk-6670","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6672","kind":"paragraph","spans":[{"id":"spn-6761","text":"Use when:"}]},{"id":"blk-6673","items":[{"blocks":[{"id":"blk-6675","kind":"paragraph","spans":[{"id":"spn-6762","text":"auditing past escalation decisions"}]}],"id":"blk-6674","kind":"list-item"},{"blocks":[{"id":"blk-6677","kind":"paragraph","spans":[{"id":"spn-6763","text":"checking for pending escalations that need attention"}]}],"id":"blk-6676","kind":"list-item"},{"blocks":[{"id":"blk-6679","kind":"paragraph","spans":[{"id":"spn-6764","text":"analyzing escalation patterns across agents or time ranges"}]}],"id":"blk-6678","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6680","kind":"paragraph","spans":[{"id":"spn-6765","text":"---"}]},{"id":"blk-6681","kind":"heading","level":2,"spans":[{"id":"spn-6766","text":"8. Trigger types"}]},{"id":"blk-6682","kind":"paragraph","spans":[{"id":"spn-6767","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6768","text":" defines four trigger types that cause an escalation event:"}]},{"id":"blk-6683","kind":"heading","level":3,"spans":[{"id":"spn-6769","marks":["code"],"text":"confidence_below"}]},{"id":"blk-6684","kind":"paragraph","spans":[{"id":"spn-6770","text":"The agent's confidence in the proposed action falls below the threshold configured in the governance block of its "},{"id":"spn-6771","marks":["code"],"text":"ampersand.json"},{"id":"spn-6772","text":" declaration."}]},{"id":"blk-6685","kind":"heading","level":3,"spans":[{"id":"spn-6773","marks":["code"],"text":"cost_exceeds"}]},{"id":"blk-6686","kind":"paragraph","spans":[{"id":"spn-6774","text":"The estimated cost of the proposed action exceeds Delegatic budget limits (per-task or per-period)."}]},{"id":"blk-6687","kind":"heading","level":3,"spans":[{"id":"spn-6775","marks":["code"],"text":"hard_boundary"}]},{"id":"blk-6688","kind":"paragraph","spans":[{"id":"spn-6776","text":"A governance hard constraint is about to be violated. Hard boundaries are never overridable by the agent — they always require human review."}]},{"id":"blk-6689","kind":"heading","level":3,"spans":[{"id":"spn-6777","marks":["code"],"text":"policy_requires_approval"}]},{"id":"blk-6690","kind":"paragraph","spans":[{"id":"spn-6778","text":"The agent's autonomy level or org-level policy mandates human sign-off for this category of action, regardless of confidence or cost."}]},{"id":"blk-6691","kind":"paragraph","spans":[{"id":"spn-6779","text":"---"}]},{"id":"blk-6692","kind":"heading","level":2,"spans":[{"id":"spn-6780","text":"9. Timeout behavior"}]},{"id":"blk-6693","kind":"paragraph","spans":[{"id":"spn-6781","text":"When an escalation times out without a human response, behavior depends on the agent's autonomy level:"}]},{"id":"blk-6694","kind":"heading","level":3,"spans":[{"id":"spn-6782","marks":["code"],"text":"observe"},{"id":"spn-6783","text":" autonomy level"}]},{"id":"blk-6695","kind":"paragraph","spans":[{"id":"spn-6784","text":"Timeout action: "},{"id":"spn-6785","marks":["bold"],"text":"auto-reject"},{"id":"spn-6786","text":". The agent logs the escalation as expired and does not execute the proposed action. Rationale: observe-mode agents should never act autonomously."}]},{"id":"blk-6696","kind":"heading","level":3,"spans":[{"id":"spn-6787","marks":["code"],"text":"advise"},{"id":"spn-6788","text":" autonomy level"}]},{"id":"blk-6697","kind":"paragraph","spans":[{"id":"spn-6789","text":"Timeout action: "},{"id":"spn-6790","marks":["bold"],"text":"auto-escalate"},{"id":"spn-6791","text":". The escalation is re-routed to a higher-priority channel or fallback operator. The agent does not act. Rationale: advise-mode agents should surface decisions but not resolve them unilaterally."}]},{"id":"blk-6698","kind":"heading","level":3,"spans":[{"id":"spn-6792","marks":["code"],"text":"act"},{"id":"spn-6793","text":" autonomy level"}]},{"id":"blk-6699","kind":"paragraph","spans":[{"id":"spn-6794","text":"Timeout action: "},{"id":"spn-6795","marks":["bold"],"text":"auto-approve with audit"},{"id":"spn-6796","text":". If the agent's confidence exceeds a fallback threshold, it proceeds with execution and logs a full audit trail. If confidence is below the fallback threshold, the action is rejected. Rationale: act-mode agents are authorized to proceed under defined conditions, but every timeout-triggered action must be auditable."}]},{"id":"blk-6700","kind":"paragraph","spans":[{"id":"spn-6797","text":"---"}]},{"id":"blk-6701","kind":"heading","level":2,"spans":[{"id":"spn-6798","text":"10. Response decisions"}]},{"id":"blk-6702","kind":"paragraph","spans":[{"id":"spn-6799","text":"Human operators can respond to an escalation with one of three decisions:"}]},{"id":"blk-6703","kind":"heading","level":3,"spans":[{"id":"spn-6800","marks":["code"],"text":"approve"}]},{"id":"blk-6704","kind":"paragraph","spans":[{"id":"spn-6801","text":"The proposed action is authorized. The agent resumes execution with the original input."}]},{"id":"blk-6705","kind":"heading","level":3,"spans":[{"id":"spn-6802","marks":["code"],"text":"reject"}]},{"id":"blk-6706","kind":"paragraph","spans":[{"id":"spn-6803","text":"The proposed action is denied. The agent must not execute it and should log the rejection reason."}]},{"id":"blk-6707","kind":"heading","level":3,"spans":[{"id":"spn-6804","marks":["code"],"text":"modify"}]},{"id":"blk-6708","kind":"paragraph","spans":[{"id":"spn-6805","text":"The proposed action is partially authorized with changes. The human provides a modified input, and the agent resumes with the modified version."}]},{"id":"blk-6709","kind":"paragraph","spans":[{"id":"spn-6806","text":"---"}]},{"id":"blk-6710","kind":"heading","level":2,"spans":[{"id":"spn-6807","text":"11. Architecture patterns"}]},{"id":"blk-6711","kind":"heading","level":3,"spans":[{"id":"spn-6808","text":"Pattern A: reasoning -> escalation -> execution"}]},{"id":"blk-6712","kind":"code","language":"text","text":"context\n|> &reason.plan.plan()\n|> &govern.escalation.escalate()\n|> execute_if_approved()"},{"id":"blk-6713","kind":"paragraph","spans":[{"id":"spn-6809","text":"Use this when:"}]},{"id":"blk-6714","items":[{"blocks":[{"id":"blk-6716","kind":"paragraph","spans":[{"id":"spn-6810","text":"the reasoning step produces a plan that may exceed governance thresholds"}]}],"id":"blk-6715","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6717","kind":"heading","level":3,"spans":[{"id":"spn-6811","text":"Pattern B: telemetry -> escalation -> reasoning"}]},{"id":"blk-6718","kind":"code","language":"text","text":"telemetry_event\n|> &govern.telemetry.budget_check()\n|> &govern.escalation.escalate()\n|> &reason.plan.replan()"},{"id":"blk-6719","kind":"paragraph","spans":[{"id":"spn-6812","text":"Use this when:"}]},{"id":"blk-6720","items":[{"blocks":[{"id":"blk-6722","kind":"paragraph","spans":[{"id":"spn-6813","text":"a budget threshold is crossed and the agent needs human input before adjusting its plan"}]}],"id":"blk-6721","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6723","kind":"heading","level":3,"spans":[{"id":"spn-6814","text":"Pattern C: multi-agent escalation bridge"}]},{"id":"blk-6724","kind":"code","language":"text","text":"agent_a_action\n|> &govern.identity.verify()\n|> &govern.escalation.escalate()\n|> agent_b_respond()"},{"id":"blk-6725","kind":"paragraph","spans":[{"id":"spn-6815","text":"Use this when:"}]},{"id":"blk-6726","items":[{"blocks":[{"id":"blk-6728","kind":"paragraph","spans":[{"id":"spn-6816","text":"one agent's proposed action requires approval from another agent's governance context"}]}],"id":"blk-6727","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6729","kind":"heading","level":3,"spans":[{"id":"spn-6817","text":"Pattern D: escalation with audit trail"}]},{"id":"blk-6730","kind":"code","language":"text","text":"proposed_action\n|> &govern.escalation.escalate()\n|> &govern.telemetry.emit()\n|> execute_or_skip()"},{"id":"blk-6731","kind":"paragraph","spans":[{"id":"spn-6818","text":"Use this when:"}]},{"id":"blk-6732","items":[{"blocks":[{"id":"blk-6734","kind":"paragraph","spans":[{"id":"spn-6819","text":"every escalation event, including its outcome, must be recorded in the telemetry stream"}]}],"id":"blk-6733","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6735","kind":"paragraph","spans":[{"id":"spn-6820","text":"---"}]},{"id":"blk-6736","kind":"heading","level":2,"spans":[{"id":"spn-6821","text":"12. Example declaration"}]},{"id":"blk-6737","kind":"paragraph","spans":[{"id":"spn-6822","text":"A concrete "},{"id":"spn-6823","marks":["code"],"text":"ampersand.json"},{"id":"spn-6824","text":" fragment:"}]},{"id":"blk-6738","kind":"code","language":"json","text":"{\n  \"&govern.escalation\": {\n    \"provider\": \"opensentience\",\n    \"config\": {\n      \"timeout_seconds\": 3600,\n      \"fallback_threshold\": 0.85\n    }\n  }\n}"},{"id":"blk-6739","kind":"paragraph","spans":[{"id":"spn-6825","text":"A fuller declaration:"}]},{"id":"blk-6740","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"InfraRemediation\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&reason.plan\": {\n      \"provider\": \"auto\",\n      \"need\": \"infrastructure remediation planning with policy-aware tradeoffs\"\n    },\n    \"&govern.escalation\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"timeout_seconds\": 3600,\n        \"fallback_threshold\": 0.85\n      }\n    },\n    \"&govern.telemetry\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"emit_all_operations\": true\n      }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\n      \"Never deploy to production without human approval\",\n      \"Never modify security groups without escalation\"\n    ],\n    \"soft\": [\n      \"Prefer least-disruption remediation paths\"\n    ],\n    \"escalate_when\": {\n      \"confidence_below\": 0.75,\n      \"cost_exceeds_usd\": 500,\n      \"hard_boundary_approached\": true,\n      \"policy_requires_approval\": [\"deploy\", \"security_modify\"]\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-6741","kind":"paragraph","spans":[{"id":"spn-6826","text":"---"}]},{"id":"blk-6742","kind":"heading","level":2,"spans":[{"id":"spn-6827","text":"13. Governance and provenance implications"}]},{"id":"blk-6743","kind":"paragraph","spans":[{"id":"spn-6828","text":"Escalation events are themselves governance artifacts and must participate in the provenance chain."}]},{"id":"blk-6744","kind":"heading","level":3,"spans":[{"id":"spn-6829","text":"Cross-references"}]},{"id":"blk-6745","items":[{"blocks":[{"id":"blk-6747","kind":"paragraph","spans":[{"id":"spn-6830","marks":["bold"],"text":"OpenSentience OS-006"},{"id":"spn-6831","text":": defines autonomy levels (observe, advise, act) that determine escalation behavior and timeout semantics"}]}],"id":"blk-6746","kind":"list-item"},{"blocks":[{"id":"blk-6749","kind":"paragraph","spans":[{"id":"spn-6832","marks":["bold"],"text":"OpenSentience OS-007"},{"id":"spn-6833","text":": addresses threat model for agent impersonation — escalation requests must be attributable to verified agent identities via "},{"id":"spn-6834","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-6748","kind":"list-item"},{"blocks":[{"id":"blk-6751","kind":"paragraph","spans":[{"id":"spn-6835","marks":["bold"],"text":"Delegatic budget policies"},{"id":"spn-6836","text":": cost-based escalation triggers are derived from Delegatic org-level and agent-level budget limits"}]}],"id":"blk-6750","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6752","kind":"heading","level":3,"spans":[{"id":"spn-6837","text":"Representative provenance record"}]},{"id":"blk-6753","kind":"code","language":"json","text":"{\n  \"source\": \"&govern.escalation\",\n  \"provider\": \"opensentience\",\n  \"operation\": \"escalate\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"escalation_id\": \"esc-01JQ7...\",\n  \"trigger\": \"confidence_below\",\n  \"trigger_detail\": {\n    \"confidence\": 0.62,\n    \"threshold\": 0.75\n  },\n  \"decision\": \"approve\",\n  \"responder\": \"ops-lead-42\",\n  \"mcp_trace_id\": \"os-esc-301\"\n}"},{"id":"blk-6754","kind":"paragraph","spans":[{"id":"spn-6838","text":"This matters because escalation decisions can fundamentally alter the execution path."}]},{"id":"blk-6755","kind":"paragraph","spans":[{"id":"spn-6839","text":"Provenance should help answer questions like:"}]},{"id":"blk-6756","items":[{"blocks":[{"id":"blk-6758","kind":"paragraph","spans":[{"id":"spn-6840","text":"Why was this action escalated instead of executed directly?"}]}],"id":"blk-6757","kind":"list-item"},{"blocks":[{"id":"blk-6760","kind":"paragraph","spans":[{"id":"spn-6841","text":"Which trigger condition fired?"}]}],"id":"blk-6759","kind":"list-item"},{"blocks":[{"id":"blk-6762","kind":"paragraph","spans":[{"id":"spn-6842","text":"Who approved or rejected it, and when?"}]}],"id":"blk-6761","kind":"list-item"},{"blocks":[{"id":"blk-6764","kind":"paragraph","spans":[{"id":"spn-6843","text":"Did the action execute under timeout-based auto-approval?"}]}],"id":"blk-6763","kind":"list-item"},{"blocks":[{"id":"blk-6766","kind":"paragraph","spans":[{"id":"spn-6844","text":"Which Delegatic budget policy caused the cost-based trigger?"}]}],"id":"blk-6765","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6767","kind":"paragraph","spans":[{"id":"spn-6845","text":"---"}]},{"id":"blk-6768","kind":"heading","level":2,"spans":[{"id":"spn-6846","text":"14. Compatible providers"}]},{"id":"blk-6769","kind":"paragraph","spans":[{"id":"spn-6847","text":"Representative compatible providers include:"}]},{"id":"blk-6770","items":[{"blocks":[{"id":"blk-6772","kind":"paragraph","spans":[{"id":"spn-6848","marks":["code"],"text":"opensentience"},{"id":"spn-6849","text":" (primary runtime provider for escalation bridge)"}]}],"id":"blk-6771","kind":"list-item"},{"blocks":[{"id":"blk-6774","kind":"paragraph","spans":[{"id":"spn-6850","marks":["code"],"text":"delegatic"},{"id":"spn-6851","text":" (policy source for cost and approval thresholds)"}]}],"id":"blk-6773","kind":"list-item"},{"blocks":[{"id":"blk-6776","kind":"paragraph","spans":[{"id":"spn-6852","text":"custom human-review UX systems exposed behind MCP-compatible surfaces"}]}],"id":"blk-6775","kind":"list-item"},{"blocks":[{"id":"blk-6778","kind":"paragraph","spans":[{"id":"spn-6853","text":"enterprise approval workflow engines with structured response semantics"}]}],"id":"blk-6777","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6779","kind":"heading","level":3,"spans":[{"id":"spn-6854","text":"Default ecosystem fit"}]},{"id":"blk-6780","kind":"paragraph","spans":[{"id":"spn-6855","text":"The most natural default ecosystem pairing is:"}]},{"id":"blk-6781","items":[{"blocks":[{"id":"blk-6783","kind":"paragraph","spans":[{"id":"spn-6856","marks":["code"],"text":"opensentience"},{"id":"spn-6857","text":" for the escalation runtime"}]}],"id":"blk-6782","kind":"list-item"},{"blocks":[{"id":"blk-6785","kind":"paragraph","spans":[{"id":"spn-6858","marks":["code"],"text":"delegatic"},{"id":"spn-6859","text":" for the policy definitions that trigger escalation"}]}],"id":"blk-6784","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6786","kind":"paragraph","spans":[{"id":"spn-6860","text":"Why they fit together:"}]},{"id":"blk-6787","items":[{"blocks":[{"id":"blk-6789","kind":"paragraph","spans":[{"id":"spn-6861","text":"OpenSentience defines autonomy levels and timeout semantics"}]}],"id":"blk-6788","kind":"list-item"},{"blocks":[{"id":"blk-6791","kind":"paragraph","spans":[{"id":"spn-6862","text":"Delegatic defines org-level budget and approval policies"}]}],"id":"blk-6790","kind":"list-item"},{"blocks":[{"id":"blk-6793","kind":"paragraph","spans":[{"id":"spn-6863","text":"Together they form the complete escalation governance stack"}]}],"id":"blk-6792","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6794","kind":"paragraph","spans":[{"id":"spn-6864","text":"The protocol stance remains:"}]},{"blocks":[{"id":"blk-6796","kind":"paragraph","spans":[{"id":"spn-6865","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6866","text":" is the capability. "},{"id":"spn-6867","marks":["code"],"text":"opensentience"},{"id":"spn-6868","text":" is one provider that may satisfy it."}]}],"id":"blk-6795","kind":"quote"},{"id":"blk-6797","kind":"paragraph","spans":[{"id":"spn-6869","text":"---"}]},{"id":"blk-6798","kind":"heading","level":2,"spans":[{"id":"spn-6870","text":"15. A2A-facing skills"}]},{"id":"blk-6799","kind":"paragraph","spans":[{"id":"spn-6871","text":"A "},{"id":"spn-6872","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6873","text":" capability may advertise skills such as:"}]},{"id":"blk-6800","items":[{"blocks":[{"id":"blk-6802","kind":"paragraph","spans":[{"id":"spn-6874","marks":["code"],"text":"human-escalation-bridge"}]}],"id":"blk-6801","kind":"list-item"},{"blocks":[{"id":"blk-6804","kind":"paragraph","spans":[{"id":"spn-6875","marks":["code"],"text":"approval-workflow"}]}],"id":"blk-6803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6805","kind":"paragraph","spans":[{"id":"spn-6876","text":"These are useful when generating A2A-style agent cards, because they let an external coordination surface say more than \"has escalation support.\""}]},{"id":"blk-6806","kind":"paragraph","spans":[{"id":"spn-6877","text":"Instead, it can say the agent can:"}]},{"id":"blk-6807","items":[{"blocks":[{"id":"blk-6809","kind":"paragraph","spans":[{"id":"spn-6878","text":"bridge decisions to human operators when governance thresholds are crossed"}]}],"id":"blk-6808","kind":"list-item"},{"blocks":[{"id":"blk-6811","kind":"paragraph","spans":[{"id":"spn-6879","text":"participate in structured approval workflows with approve/reject/modify semantics"}]}],"id":"blk-6810","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6812","kind":"paragraph","spans":[{"id":"spn-6880","text":"---"}]},{"id":"blk-6813","kind":"heading","level":2,"spans":[{"id":"spn-6881","text":"16. Anti-patterns"}]},{"id":"blk-6814","kind":"heading","level":3,"spans":[{"id":"spn-6882","text":"Anti-pattern 1: treat escalation as error handling"}]},{"id":"blk-6815","kind":"paragraph","spans":[{"id":"spn-6883","text":"Escalation is a governance mechanism, not an exception path. Agents that only escalate on errors miss the core purpose: structured human oversight of normal decisions that cross thresholds."}]},{"id":"blk-6816","kind":"heading","level":3,"spans":[{"id":"spn-6884","text":"Anti-pattern 2: escalate everything"}]},{"id":"blk-6817","kind":"paragraph","spans":[{"id":"spn-6885","text":"If every action is escalated, the human operator becomes a bottleneck and trust in the agent degrades. Escalation thresholds should be calibrated to surface only meaningful decisions."}]},{"id":"blk-6818","kind":"heading","level":3,"spans":[{"id":"spn-6886","text":"Anti-pattern 3: ignore timeout semantics"}]},{"id":"blk-6819","kind":"paragraph","spans":[{"id":"spn-6887","text":"Timeout behavior varies by autonomy level for good reasons. Implementing a single timeout policy across all levels defeats the purpose of differentiated autonomy."}]},{"id":"blk-6820","kind":"heading","level":3,"spans":[{"id":"spn-6888","text":"Anti-pattern 4: escalate without context"}]},{"id":"blk-6821","kind":"paragraph","spans":[{"id":"spn-6889","text":"An escalation request without rationale, confidence scores, or trigger details forces the human to reconstruct the decision context. Always include the agent's reasoning and the specific trigger condition."}]},{"id":"blk-6822","kind":"heading","level":3,"spans":[{"id":"spn-6890","text":"Anti-pattern 5: skip provenance on auto-approved timeouts"}]},{"id":"blk-6823","kind":"paragraph","spans":[{"id":"spn-6891","text":"When an act-mode agent auto-approves on timeout, the audit trail is especially important. Skipping provenance on these events creates governance blind spots."}]},{"id":"blk-6824","kind":"paragraph","spans":[{"id":"spn-6892","text":"---"}]},{"id":"blk-6825","kind":"heading","level":2,"spans":[{"id":"spn-6893","text":"17. Summary"}]},{"id":"blk-6826","kind":"paragraph","spans":[{"id":"spn-6894","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6895","text":" is the [&] Protocol capability for "},{"id":"spn-6896","marks":["bold"],"text":"governance-mandated decision handoff"},{"id":"spn-6897","text":"."}]},{"id":"blk-6827","kind":"paragraph","spans":[{"id":"spn-6898","text":"It is the right capability when an agent needs to:"}]},{"id":"blk-6828","items":[{"blocks":[{"id":"blk-6830","kind":"paragraph","spans":[{"id":"spn-6899","text":"pause before executing actions that cross confidence, cost, or policy thresholds"}]}],"id":"blk-6829","kind":"list-item"},{"blocks":[{"id":"blk-6832","kind":"paragraph","spans":[{"id":"spn-6900","text":"present proposed actions to human operators with full context"}]}],"id":"blk-6831","kind":"list-item"},{"blocks":[{"id":"blk-6834","kind":"paragraph","spans":[{"id":"spn-6901","text":"handle timeout behavior differently based on autonomy level"}]}],"id":"blk-6833","kind":"list-item"},{"blocks":[{"id":"blk-6836","kind":"paragraph","spans":[{"id":"spn-6902","text":"maintain auditable records of every escalation lifecycle"}]}],"id":"blk-6835","kind":"list-item"},{"blocks":[{"id":"blk-6838","kind":"paragraph","spans":[{"id":"spn-6903","text":"compose escalation with reasoning, telemetry, and identity capabilities"}]}],"id":"blk-6837","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6839","kind":"paragraph","spans":[{"id":"spn-6904","text":"In one sentence:"}]},{"blocks":[{"id":"blk-6841","kind":"paragraph","spans":[{"id":"spn-6905","marks":["code"],"text":"&govern.escalation"},{"id":"spn-6906","text":" gives an agent a protocol-native way to hand off decisions to humans when governance thresholds require it."}]}],"id":"blk-6840","kind":"quote"},{"id":"blk-6842","kind":"paragraph","spans":[{"id":"spn-6907","text":"---"}]}],"edges":[],"id":"bagaaierazhnrwkqqignazoovqdj6svdzaynxbipfzxcm4arlyjo6cmwsaotq","vocabulary":"ampersand.docs.fs.v1"}