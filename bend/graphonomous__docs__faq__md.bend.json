{"bendscript":"0.1","blocks":[{"id":"blk-40871","kind":"heading","level":1,"spans":[{"id":"spn-45012","text":"Graphonomous FAQ"}]},{"id":"blk-40872","kind":"paragraph","spans":[{"id":"spn-45013","text":"This page answers the most common questions about Graphonomous, its MCP interface, and operating model."}]},{"id":"blk-40873","kind":"heading","level":2,"spans":[{"id":"spn-45014","text":"What is Graphonomous?"}]},{"id":"blk-40874","kind":"paragraph","spans":[{"id":"spn-45015","text":"Graphonomous is a continual-learning memory engine for AI agents. It stores knowledge as a graph, supports confidence-updating feedback loops, and exposes all capabilities through MCP tools/resources."}]},{"id":"blk-40875","kind":"paragraph","spans":[{"id":"spn-45016","text":"---"}]},{"id":"blk-40876","kind":"heading","level":2,"spans":[{"id":"spn-45017","text":"Does Graphonomous retrain model weights?"}]},{"id":"blk-40877","kind":"paragraph","spans":[{"id":"spn-45018","text":"No. Graphonomous does "},{"id":"spn-45019","marks":["bold"],"text":"not"},{"id":"spn-45020","text":" retrain model weights. Learning happens in the memory graph by storing knowledge and updating confidence based on outcomes."}]},{"id":"blk-40878","kind":"paragraph","spans":[{"id":"spn-45021","text":"---"}]},{"id":"blk-40879","kind":"heading","level":2,"spans":[{"id":"spn-45022","text":"What problem does it solve?"}]},{"id":"blk-40880","kind":"paragraph","spans":[{"id":"spn-45023","text":"It gives agents durable, evolving memory and better decision quality over time by combining:"}]},{"id":"blk-40881","items":[{"blocks":[{"id":"blk-40883","kind":"paragraph","spans":[{"id":"spn-45024","text":"semantic retrieval"}]}],"id":"blk-40882","kind":"list-item"},{"blocks":[{"id":"blk-40885","kind":"paragraph","spans":[{"id":"spn-45025","text":"graph neighborhood expansion"}]}],"id":"blk-40884","kind":"list-item"},{"blocks":[{"id":"blk-40887","kind":"paragraph","spans":[{"id":"spn-45026","text":"causal outcome feedback"}]}],"id":"blk-40886","kind":"list-item"},{"blocks":[{"id":"blk-40889","kind":"paragraph","spans":[{"id":"spn-45027","text":"goal tracking"}]}],"id":"blk-40888","kind":"list-item"},{"blocks":[{"id":"blk-40891","kind":"paragraph","spans":[{"id":"spn-45028","text":"topology-aware routing ("},{"id":"spn-45029","marks":["code"],"text":"fast"},{"id":"spn-45030","text":" vs "},{"id":"spn-45031","marks":["code"],"text":"deliberate"},{"id":"spn-45032","text":")"}]}],"id":"blk-40890","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40892","kind":"paragraph","spans":[{"id":"spn-45033","text":"---"}]},{"id":"blk-40893","kind":"heading","level":2,"spans":[{"id":"spn-45034","text":"What are the core node types?"}]},{"id":"blk-40894","kind":"paragraph","spans":[{"id":"spn-45035","text":"Use node types intentionally (6 types):"}]},{"id":"blk-40895","items":[{"blocks":[{"id":"blk-40897","kind":"paragraph","spans":[{"id":"spn-45036","marks":["code"],"text":"semantic"},{"id":"spn-45037","text":" — facts, architecture, definitions"}]}],"id":"blk-40896","kind":"list-item"},{"blocks":[{"id":"blk-40899","kind":"paragraph","spans":[{"id":"spn-45038","marks":["code"],"text":"procedural"},{"id":"spn-45039","text":" — workflows and how-to steps"}]}],"id":"blk-40898","kind":"list-item"},{"blocks":[{"id":"blk-40901","kind":"paragraph","spans":[{"id":"spn-45040","marks":["code"],"text":"episodic"},{"id":"spn-45041","text":" — events and observations"}]}],"id":"blk-40900","kind":"list-item"},{"blocks":[{"id":"blk-40903","kind":"paragraph","spans":[{"id":"spn-45042","marks":["code"],"text":"temporal"},{"id":"spn-45043","text":" — time-indexed observations, monitoring events"}]}],"id":"blk-40902","kind":"list-item"},{"blocks":[{"id":"blk-40905","kind":"paragraph","spans":[{"id":"spn-45044","marks":["code"],"text":"outcome"},{"id":"spn-45045","text":" — empirical results of actions (grounding)"}]}],"id":"blk-40904","kind":"list-item"},{"blocks":[{"id":"blk-40907","kind":"paragraph","spans":[