,"text":"Graphonomous includes durable GoalGraph operations:"}]},{"id":"blk-40951","items":[{"blocks":[{"id":"blk-40953","kind":"paragraph","spans":[{"id":"spn-45117","text":"create/list/get/update/delete goals"}]}],"id":"blk-40952","kind":"list-item"},{"blocks":[{"id":"blk-40955","kind":"paragraph","spans":[{"id":"spn-45118","text":"transition status"}]}],"id":"blk-40954","kind":"list-item"},{"blocks":[{"id":"blk-40957","kind":"paragraph","spans":[{"id":"spn-45119","text":"set progress"}]}],"id":"blk-40956","kind":"list-item"},{"blocks":[{"id":"blk-40959","kind":"paragraph","spans":[{"id":"spn-45120","text":"link/unlink evidence nodes"}]}],"id":"blk-40958","kind":"list-item"},{"blocks":[{"id":"blk-40961","kind":"paragraph","spans":[{"id":"spn-45121","text":"run epistemic review ("},{"id":"spn-45122","marks":["code"],"text":"review_goal"},{"id":"spn-45123","text":")"}]}],"id":"blk-40960","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40962","kind":"paragraph","spans":[{"id":"spn-45124","text":"Typical statuses include "},{"id":"spn-45125","marks":["code"],"text":"proposed"},{"id":"spn-45126","text":", "},{"id":"spn-45127","marks":["code"],"text":"active"},{"id":"spn-45128","text":", "},{"id":"spn-45129","marks":["code"],"text":"blocked"},{"id":"spn-45130","text":", "},{"id":"spn-45131","marks":["code"],"text":"completed"},{"id":"spn-45132","text":", and "},{"id":"spn-45133","marks":["code"],"text":"abandoned"},{"id":"spn-45134","text":"."}]},{"id":"blk-40963","kind":"paragraph","spans":[{"id":"spn-45135","text":"---"}]},{"id":"blk-40964","kind":"heading","level":2,"spans":[{"id":"spn-45136","text":"What is coverage review?"}]},{"id":"blk-40965","kind":"paragraph","spans":[{"id":"spn-45137","marks":["code"],"text":"review_goal"},{"id":"spn-45138","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-40966","items":[{"blocks":[{"id":"blk-40968","kind":"paragraph","spans":[{"id":"spn-45139","marks":["code"],"text":"act"},{"id":"spn-45140","text":" (enough coverage)"}]}],"id":"blk-40967","kind":"list-item"},{"blocks":[{"id":"blk-40970","kind":"paragraph","spans":[{"id":"spn-45141","marks":["code"],"text":"learn"},{"id":"spn-45142","text":" (need more context)"}]}],"id":"blk-40969","kind":"list-item"},{"blocks":[{"id":"blk-40972","kind":"paragraph","spans":[{"id":"spn-45143","marks":["code"],"text":"escalate"},{"id":"spn-45144","text":" (insufficient/too risky)"}]}],"id":"blk-40971","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40973","kind":"paragraph","spans":[{"id":"spn-45145","text":"---"}]},{"id":"blk-40974","kind":"heading","level":2,"spans":[{"id":"spn-45146","text":"What does topology-aware routing mean?"}]},{"id":"blk-40975","kind":"paragraph","spans":[{"id":"spn-45147","text":"Graphonomous analyzes retrieved subgraphs for cycles and complexity. If topology is simple, routing is "},{"id":"spn-45148","marks":["code"],"text":"fast"},{"id":"spn-45149","text":". If cyclic complexity is higher, routing may indicate "},{"id":"spn-45150","marks":["code"],"text":"deliberate"},{"id":"spn-45151","text":", signaling deeper reasoning is safer."}]},{"id":"blk-40976","kind":"paragraph","spans":[{"id":"spn-45152","text":"---"}]},{"id":"blk-40977","kind":"heading","level":2,"spans":[{"id":"spn-45153","text":"What does consolidation do?"}]},{"id":"blk-40978","kind":"paragraph","spans":[{"id":"spn-45154","text":"Consolidation is a 7-stage periodic memory maintenance pipeline:"}]},{"id":"blk-40979","kind":"paragraph","spans":[{"id":"spn-45155","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-40980","kind":"paragraph","spans":[{"id":"spn-45156","text":"Use "},{"id":"spn-45157","marks":["code"],"text":"run_consolidation"},{"id":"spn-45158","text":" to trigger/inspect cycles manually when needed."}]},{"id":"blk-40981","kind":"paragraph","spans":[{"id":"spn-45159","text":"---"}]},{"id":"blk-40982","kind":"heading","level":2,"spans":[{"id":"spn-45160","text":"Is Graphonomous usable from constrained machines?"}]},{"id":"blk-40983","kind":"paragraph","spans":[{"id":"spn-45161","text":"Yes. It is designed for local operation with practical defaults and fallback modes. A common setup uses a local SQLite DB path and a lightweight embedder backend configuration for reliability."}]},{"id":"blk-40984","kind":"paragraph","spans":[{"id":"spn-45162","text":"---"}]},{"id":"blk-40985","kind":"heading","level":2,"spans":[{"id":"spn-45163","text":"How do I run it quickly?"}]},{"id":"blk-40986","kind":"paragraph","spans":[{"id":"spn-45164","text":"Typical options:"}]},{"id":"blk-40987","items":[{"blocks":[{"id":"blk-40989","kind":"paragraph","spans":[{"id":"spn-45165","text":"run as MCP server over stdio"}]}],"id":"blk-40988","kind":"list-item"},{"blocks":[{"id":"blk-40991","kind":"paragraph","spans":[{"id":"spn-45166","text":"run one-shot traversal/scan mode"}]}],"id":"blk-40990","kind":"list-item"},{"blocks":[{"id":"blk-40993","kind":"paragraph","spans":[{"id":"spn-45167","text":"run watch mode for ongoing ingestion"}]}],"id":"blk-40992","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40994","kind":"paragraph","spans":[{"id":"spn-45168","text":"See "},{"id":"spn-45169","marks":["code"],"text":"quickstart"},{"id":"spn-45170","text":" and "},{"id":"spn-45171","marks":["code"],"text":"runtime"},{"id":"spn-45172","text":" docs pages for exact commands and settings."}]},{"id":"blk-40995","kind":"paragraph","spans":[{"id":"spn-45173","text":"---"}]},{"id":"blk-40996","kind":"heading","level":2,"spans":[{"id":"spn-45174","text":"How should agents use Graphonomous by default?"}]},{"id":"blk-40997","kind":"paragraph","spans":[{"id":"spn-45175","text":"For non-trivial work, use this loop:"}]},{"id":"blk-40998","kind":"paragraph","spans":[{"id":"spn-45176","text":"1. retrieve context 2. reason and act 3. store durable knowledge 4. report outcomes 5. maintain via consolidation"}]},{"id":"blk-40999","kind":"paragraph","spans":[{"id":"spn-45177","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-41000","kind":"paragraph","spans":[{"id":"spn-45178","text":"---"}]},{"id":"blk-41001","kind":"heading","level":2,"spans":[{"id":"spn-45179","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-41002","kind":"paragraph","spans":[{"id":"spn-45180","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-41003","items":[{"blocks":[{"id":"blk-41005","kind":"paragraph","spans":[{"id":"spn-45181","text":"retrieval and graph query"}]}],"id":"blk-41004","kind":"list-item"},{"blocks":[{"id":"blk-41007","kind":"paragraph","spans":[{"id":"spn-45182","text":"node/edge storage"}]}],"id":"blk-41006","kind":"list-item"},{"blocks":[{"id":"blk-41009","kind":"paragraph","spans":[{"id":"spn-45183","text":"outcome learning"}]}],"id":"blk-41008","kind":"list-item"},{"blocks":[{"id":"blk-41011","kind":"paragraph","spans":[{"id":"spn-45184","text":"goal management and review"}]}],"id":"blk-41010","kind":"list-item"},{"blocks":[{"id":"blk-41013","kind":"paragraph","spans":[{"id":"spn-45185","text":"topology analysis and deliberation"}]}],"id":"blk-41012","kind":"list-item"},{"blocks":[{"id":"blk-41015","kind":"paragraph","spans":[{"id":"spn-45186","text":"attention and consolidation"}]}],"id":"blk-41014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41016","kind":"paragraph","spans":[{"id":"spn-45187","text":"---"}]},{"id":"blk-41017","kind":"heading","level":2,"spans":[{"id":"spn-45188","text":"Is there a best-practice checklist?"}]},{"id":"blk-41018","kind":"paragraph","spans":[{"id":"spn-45189","text":"Yes—short version:"}]},{"id":"blk-41019","items":[{"blocks":[{"id":"blk-41021","kind":"paragraph","spans":[{"id":"spn-45190","text":"retrieve first for meaningful tasks"}]}],"id":"blk-41020","kind":"list-item"},{"blocks":[{"id":"blk-41023","kind":"paragraph","spans":[{"id":"spn-45191","text":"store atomic nodes (avoid “kitchen-sink” nodes)"}]}],"id":"blk-41022","kind":"list-item"},{"blocks":[{"id":"blk-41025","kind":"paragraph","spans":[{"id":"spn-45192","text":"keep confidence calibrated to evidence quality"}]}],"id":"blk-41024","kind":"list-item"},{"blocks":[{"id":"blk-41027","kind":"paragraph","spans":[{"id":"spn-45193","text":"preserve causal IDs for feedback"}]}],"id":"blk-41026","kind":"list-item"},{"blocks":[{"id":"blk-41029","kind":"paragraph","spans":[{"id":"spn-45194","text":"avoid fabricated provenance/signals"}]}],"id":"blk-41028","kind":"list-item"},{"blocks":[{"id":"blk-41031","kind":"paragraph","spans":[{"id":"spn-45195","text":"review goals before consequential actions"}]}],"id":"blk-41030","kind":"list-item"},{"blocks":[{"id":"blk-41033","kind":"paragraph","spans":[{"id":"spn-45196","text":"consolidate periodically"}]}],"id":"blk-41032","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41034","kind":"paragraph","spans":[{"id":"spn-45197","text":"---"}]},{"id":"blk-41035","kind":"paragraph","spans":[{"id":"spn-45198","text":"If you want a deeper operational playbook, start with the docs "},{"id":"spn-45199","marks":["code"],"text":"quickstart"},{"id":"spn-45200","text":", then "},{"id":"spn-45201","marks":["code"],"text":"architecture"},{"id":"spn-45202","text":", then the workflows and anti-patterns sections."}]}],"edges":[],"id":"bagaaieradm5sk4rztw2uukmiveoldzzr3acgk6miioffzhfltueuagxaf6sa","vocabulary":"ampersand.docs.fs.v1"}