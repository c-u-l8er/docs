:[{"id":"spn-6114","text":"When writing a new capability page:"}]},{"id":"blk-6259","items":[{"blocks":[{"id":"blk-6261","kind":"paragraph","spans":[{"id":"spn-6115","text":"start from the protocol capability identifier, not the provider name"}]}],"id":"blk-6260","kind":"list-item"},{"blocks":[{"id":"blk-6263","kind":"paragraph","spans":[{"id":"spn-6116","text":"keep the capability/provider distinction explicit"}]}],"id":"blk-6262","kind":"list-item"},{"blocks":[{"id":"blk-6265","kind":"paragraph","spans":[{"id":"spn-6117","text":"use realistic examples"}]}],"id":"blk-6264","kind":"list-item"},{"blocks":[{"id":"blk-6267","kind":"paragraph","spans":[{"id":"spn-6118","text":"align terminology with "},{"id":"spn-6119","marks":["code"],"text":"SPEC.md"}]}],"id":"blk-6266","kind":"list-item"},{"blocks":[{"id":"blk-6269","kind":"paragraph","spans":[{"id":"spn-6120","text":"align contracts with "},{"id":"spn-6121","marks":["code"],"text":"contracts/v0.1.0/"}]}],"id":"blk-6268","kind":"list-item"},{"blocks":[{"id":"blk-6271","kind":"paragraph","spans":[{"id":"spn-6122","text":"align registry metadata with "},{"id":"spn-6123","marks":["code"],"text":"protocol/registry/v0.1.0/capabilities.registry.json"}]}],"id":"blk-6270","kind":"list-item"},{"blocks":[{"id":"blk-6273","kind":"paragraph","spans":[{"id":"spn-6124","text":"mention governance and provenance when they materially matter"}]}],"id":"blk-6272","kind":"list-item"},{"blocks":[{"id":"blk-6275","kind":"paragraph","spans":[{"id":"spn-6125","text":"prefer clarity over hype"}]}],"id":"blk-6274","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6276","kind":"paragraph","spans":[{"id":"spn-6126","text":"A simple rule of thumb:"}]},{"blocks":[{"id":"blk-6278","kind":"paragraph","spans":[{"id":"spn-6127","text":"Write each page so that an engineer could understand what the capability is, how it composes, and how to implement or consume it without reading the whole repository first."}]}],"id":"blk-6277","kind":"quo