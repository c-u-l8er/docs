{"bendscript":"0.1","blocks":[{"id":"blk-44907","kind":"heading","level":1,"spans":[{"id":"spn-50570","text":"Benchmark Expansion Prompt — Graphonomous v0.3.3+"}]},{"id":"blk-44908","kind":"paragraph","spans":[{"id":"spn-50571","text":"Use this prompt to build benchmark harnesses for Graphonomous one-by-one across chat sessions. Each session tackles one benchmark. The order below is the recommended build sequence (highest ROI first)."}]},{"id":"blk-44909","kind":"paragraph","spans":[{"id":"spn-50572","text":"---"}]},{"id":"blk-44910","kind":"heading","level":2,"spans":[{"id":"spn-50573","text":"Context"}]},{"id":"blk-44911","kind":"paragraph","spans":[{"id":"spn-50574","text":"Graphonomous already has two benchmark harnesses:"}]},{"id":"blk-44912","items":[{"blocks":[{"id":"blk-44914","kind":"paragraph","spans":[{"id":"spn-50575","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-50576","text":" — LongMemEval (ICLR 2025), 500 questions, 92.6% QA proxy"}]}],"id":"blk-44913","kind":"list-item"},{"blocks":[{"id":"blk-44916","kind":"paragraph","spans":[{"id":"spn-50577","marks":["code"],"text":"lib/mix/tasks/benchmark/graphmembench.ex"},{"id":"spn-50578","text":" — GraphMemBench, 120 scenarios, 100% pass"}]}],"id":"blk-44915","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44917","kind":"paragraph","spans":[{"id":"spn-50579","text":"Shared infrastructure:"}]},{"id":"blk-44918","items":[{"blocks":[{"id":"blk-44920","kind":"paragraph","spans":[{"id":"spn-50580","marks":["code"],"text":"lib/mix/tasks/benchmark/helpers.ex"},{"id":"spn-50581","text":" — corpus loading, timing, metrics, JSON output"}]}],"id":"blk-44919","kind":"list-item"},{"blocks":[{"id":"blk-44922","kind":"paragraph","spans":[{"id":"spn-50582","marks":["code"],"text":"lib/mix/tasks/benchmark/llm_judge.ex"},{"id":"spn-50583","text":" — LLM-free evaluation helpers"}]}],"id":"blk-44921","kind":"list-item"},{"blocks":[{"id":"blk-44924","kind":"paragraph","spans":[{"id":"spn-50584","marks":["code"],"text":"lib/mix/tasks/benchmark/run.ex"},{"id":"spn-50585","text":" — full suite orchestrator"}]}],"id":"blk-44923","kind":"list-item"},{"blocks":[{"id":"blk-44926","kind":"paragraph","spans":[{"id":"spn-50586","text":"Benchmark data lives in "},{"id":"spn-50587","marks":["code"],"text":"priv/<benchmark_name>/"}]}],"id":"blk-44925","kind":"list-item"},{"blocks":[{"id":"blk-44928","kind":"paragraph","spans":[{"id":"spn-50588","text":"Results are written as JSON to "},{"id":"spn-50589","marks":["code"],"text":"priv/<benchmark_name>/"},{"id":"spn-50590","text":" with timestamps"}]}],"id":"blk-44927","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44929","kind":"paragraph","spans":[{"id":"spn-50591","text":"Pattern for each new harness: 1. Create "},{"id":"spn-50592","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-50593","text":" to fetch dataset 2. Create "},{"id":"spn-50594","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-50595","text":" as a Mix task 3. Add the phase to "},{"id":"spn-50596","marks":["code"],"text":"run.ex"},{"id":"spn-50597","text":" orchestrator 4. Run, measure, record results 5. Update "},{"id":"spn-50598","marks":["code"],"text":"opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-50599","text":" with findings 6. Store results in Graphonomous via "},{"id":"spn-50600","marks":["code"],"text":"learn_from_outcome"}]},{"id":"blk-44930","kind":"paragraph","spans":[{"id":"spn-50601","text":"---"}]},{"id":"blk-44931","kind":"heading","level":2,"spans":[{"id":"spn-50602","text":"Session Instructions"}]},{"id":"blk-44932","kind":"paragraph","spans":[{"id":"spn-50603","text":"At the start of each session, paste this prompt and say:"}]},{"blocks":[{"id":"blk-44934","kind":"paragraph","spans":[{"id":"spn-50604","marks":["bold"],"text":"\"Build the benchmark harness for [BENCHMARK_NAME].\""}]}],"id":"blk-44933","kind":"quote"},{"id":"blk-44935","kind":"paragraph","spans":[{"id":"spn-50605","text":"The agent should:"}]},{"id":"blk-44936","kind":"paragraph","spans":[{"id":"spn-50606","text":"1. "},{"id":"spn-50607","marks":["bold"],"text":"Bootstrap Graphonomous"},{"id":"spn-50608","text":" — retrieve context for the benchmark goal and any prior benchmark work 2. "},{"id":"spn-50609","marks":["bold"],"text":"Transition the goal"},{"id":"spn-50610","text":" from "},{"id":"spn-50611","marks":["code"],"text":"proposed"},{"id":"spn-50612","text":" → "},{"id":"spn-50613","marks":["code"],"text":"active"},{"id":"spn-50614","text":" 3. "},{"id":"spn-50615","marks":["bold"],"text":"Research the benchmark"},{"id":"spn-50616","text":" — read the paper/repo, understand dataset format, evaluation metrics, and scoring methodology 4. "},{"id":"spn-50617","marks":["bold"],"text":"Download/prepare data"},{"id":"spn-50618","text":" — create "},{"id":"spn-50619","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-50620","text":" and fetch the dataset 5. "},{"id":"spn-50621","marks":["bold"],"text":"Build the harness"},{"id":"spn-50622","text":" — create "},{"id":"spn-50623","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-50624","text":" following the longmemeval.ex pattern:"}]},{"id":"blk-44937","items":[{"blocks":[{"id":"blk-44939","kind":"paragraph","spans":[{"id":"spn-50625","marks":["code"],"text":"use Mix.Task"},{"id":"spn-50626","text":" with "},{"id":"spn-50627","marks":["code"],"text":"@shortdoc"}]}],"id":"blk-44938","kind":"list-item"},{"blocks":[{"id":"blk-44941","kind":"paragraph","spans":[{"id":"spn-50628","text":"Parse CLI options ("},{"id":"spn-50629","marks":["code"],"text":"--limit"},{"id":"spn-50630","text":", "},{"id":"spn-50631","marks":["code"],"text":"--purge"},{"id":"spn-50632","text":", "},{"id":"spn-50633","marks":["code"],"text":"--neural"},{"id":"spn-50634","text":", "},{"id":"spn-50635","marks":["code"],"text":"--skip-ingest"},{"id":"spn-50636","text":")"}]}],"id":"blk-44940","kind":"list-item"},{"blocks":[{"id":"blk-44943","kind":"paragraph","spans":[{"id":"spn-50637","text":"Ingest benchmark data into a fresh Graphonomous graph"}]}],"id":"blk-44942","kind":"list-item"},{"blocks":[{"id":"blk-44945","kind":"paragraph","spans":[{"id":"spn-50638","text":"Run queries through "},{"id":"spn-50639","marks":["code"],"text":"retrieve_context"},{"id":"spn-50640","text":" (and other MCP tools as needed)"}]}],"id":"blk-44944","kind":"list-item"},{"blocks":[{"id":"blk-44947","kind":"paragraph","spans":[{"id":"spn-50641","text":"Score results using the benchmark's official metrics"}]}],"id":"blk-44946","kind":"list-item"},{"blocks":[{"id":"blk-44949","kind":"paragraph","spans":[{"id":"spn-50642","text":"Output competitive comparison table"}]}],"id":"blk-44948","kind":"list-item"},{"blocks":[{"id":"blk-44951","kind":"paragraph","spans":[{"id":"spn-50643","text":"Write results JSON to "},{"id":"spn-50644","marks":["code"],"text":"priv/<name>/"}]}],"id":"blk-44950","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44952","kind":"paragraph","spans":[{"id":"spn-50645","text":"6. "},{"id":"spn-50646","marks":["bold"],"text":"Wire into run.ex"},{"id":"spn-50647","text":" — add the new phase to the orchestrator 7. "},{"id":"spn-50648","marks":["bold"],"text":"Run the benchmark"},{"id":"spn-50649","text":" — execute with "},{"id":"spn-50650","marks":["code"],"text":"--limit 50"},{"id":"spn-50651","text":" first for a smoke test, then full run 8. "},{"id":"spn-50652","marks":["bold"],"text":"Record results"},{"id":"spn-50653","text":" — update OS-E001 evaluation doc, store in Graphonomous 9. "},{"id":"spn-50654","marks":["bold"],"text":"Update goal progress"},{"id":"spn-50655","text":" — set to 1.0 and transition to "},{"id":"spn-50656","marks":["code"],"text":"done"},{"id":"spn-50657","text":" if passing"}]},{"id":"blk-44953","kind":"paragraph","spans":[{"id":"spn-50658","text":"---"}]},{"id":"blk-44954","kind":"heading","level":2,"spans":[{"id":"spn-50659","text":"Benchmark Build Order"}]},{"id":"blk-44955","kind":"heading","level":3,"spans":[{"id":"spn-50660","text":"Session 1: BEAM (Beyond a Million Tokens)"}]},{"id":"blk-44956","items":[{"blocks":[{"id":"blk-44958","kind":"paragraph","spans":[{"id":"spn-50661","marks":["bold"],"text":"Goal ID"},{"id":"spn-50662","text":": "},{"id":"spn-50663","marks":["code"],"text":"goal_5e547ffb6d10787cae8d9a57a9f217f8"}]}],"id":"blk-44957","kind":"list-item"},{"blocks":[{"id":"blk-44960","kind":"paragraph","spans":[{"id":"spn-50664","marks":["bold"],"text":"Paper"},{"id":"spn-50665","text":": https://arxiv.org/abs/2510.27246"}]}],"id":"blk-44959","kind":"list-item"},{"blocks":[{"id":"blk-44962","kind":"paragraph","spans":[{"id":"spn-50666","marks":["bold"],"text":"Repo"},{"id":"spn-50667","text":": https://github.com/mohammadtavakoli78/BEAM"}]}],"id":"blk-44961","kind":"list-item"},{"blocks":[{"id":"blk-44964","kind":"paragraph","spans":[{"id":"spn-50668","marks":["bold"],"text":"Dataset"},{"id":"spn-50669","text":": 100 conversations, 2,000 questions at 128K/500K/1M/10M token scales"}]}],"id":"blk-44963","kind":"list-item"},{"blocks":[{"id":"blk-44966","kind":"paragraph","spans":[{"id":"spn-50670","marks":["bold"],"text":"Metrics"},{"id":"spn-50671","text":": QA accuracy across 10 memory abilities, per-scale breakdown"}]}],"id":"blk-44965","kind":"list-item"},{"blocks":[{"id":"blk-44968","kind":"paragraph","spans":[{"id":"spn-50672","marks":["bold"],"text":"SOTA"},{"id":"spn-50673","text":": Hindsight 64.1% (10M), 73.9% (1M)"}]}],"id":"blk-44967","kind":"list-item"},{"blocks":[{"id":"blk-44970","kind":"paragraph","spans":[{"id":"spn-50674","marks":["bold"],"text":"Key challenge"},{"id":"spn-50675","text":": Multi-scale evaluation. Start with 128K tier (fits in single graph). 10M tier will stress SQLite and retrieval latency."}]}],"id":"blk-44969","kind":"list-item"},{"blocks":[{"id":"blk-44972","kind":"paragraph","spans":[{"id":"spn-50676","marks":["bold"],"text":"Harness name"},{"id":"spn-50677","text":": "},{"id":"spn-50678","marks":["code"],"text":"mix benchmark.beam"}]}],"id":"blk-44971","kind":"list-item"},{"blocks":[{"id":"blk-44974","kind":"paragraph","spans":[{"id":"spn-50679","marks":["bold"],"text":"CLI"},{"id":"spn-50680","text":": "},{"id":"spn-50681","marks":["code"],"text":"mix benchmark.beam --tier 128k --limit 50"}]}],"id":"blk-44973","kind":"list-item"},{"blocks":[{"id":"blk-44976","kind":"paragraph","spans":[{"id":"spn-50682","marks":["bold"],"text":"Why first"},{"id":"spn-50683","text":": This is the new industry standard. Every competitor reports BEAM scores. Scaling behavior is where graph memory should differentiate from flat vector stores."}]}],"id":"blk-44975","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44977","kind":"heading","level":3,"spans":[{"id":"spn-50684","text":"Session 2: MemoryAgentBench"}]},{"id":"blk-44978","items":[{"blocks":[{"id":"blk-44980","kind":"paragraph","spans":[{"id":"spn-50685","marks":["bold"],"text":"Goal ID"},{"id":"spn-50686","text":": "},{"id":"spn-50687","marks":["code"],"text":"goal_8889e094cb2b904d65f6a29cd7861f1c"}]}],"id":"blk-44979","kind":"list-item"},{"blocks":[{"id":"blk-44982","kind":"paragraph","spans":[{"id":"spn-50688","marks":["bold"],"text":"Paper"},{"id":"spn-50689","text":": https://arxiv.org/abs/2507.05257"}]}],"id":"blk-44981","kind":"list-item"},{"blocks":[{"id":"blk-44984","kind":"paragraph","spans":[{"id":"spn-50690","marks":["bold"],"text":"Repo"},{"id":"spn-50691","text":": https://github.com/HUST-AI-HYZ/MemoryAgentBench"}]}],"id":"blk-44983","kind":"list-item"},{"blocks":[{"id":"blk-44986","kind":"paragraph","spans":[{"id":"spn-50692","marks":["bold"],"text":"Dataset"},{"id":"spn-50693","text":": Multi-turn incremental format, includes EventQA and FactConsolidation"}]}],"id":"blk-44985","kind":"list-item"},{"blocks":[{"id":"blk-44988","kind":"paragraph","spans":[{"id":"spn-50694","marks":["bold"],"text":"Metrics"},{"id":"spn-50695","text":": 4 competency scores — accurate retrieval, test-time learning, long-range understanding, selective forgetting"}]}],"id":"blk-44987","kind":"list-item"},{"blocks":[{"id":"blk-44990","kind":"paragraph","spans":[{"id":"spn-50696","marks":["bold"],"text":"Key challenge"},{"id":"spn-50697","text":": Multi-turn format requires simulating incremental store→query cycles, not batch ingest. Map \"selective forgetting\" to "},{"id":"spn-50698","marks":["code"],"text":"forget_by_policy"},{"id":"spn-50699","text":" / "},{"id":"spn-50700","marks":["code"],"text":"forget_node"},{"id":"spn-50701","text":"."}]}],"id":"blk-44989","kind":"list-item"},{"blocks":[{"id":"blk-44992","kind":"paragraph","spans":[{"id":"spn-50702","marks":["bold"],"text":"Harness name"},{"id":"spn-50703","text":": "},{"id":"spn-50704","marks":["code"],"text":"mix benchmark.memoryagentbench"}]}],"id":"blk-44991","kind":"list-item"},{"blocks":[{"id":"blk-44994","kind":"paragraph","spans":[{"id":"spn-50705","marks":["bold"],"text":"CLI"},{"id":"spn-50706","text":": "},{"id":"spn-50707","marks":["code"],"text":"mix benchmark.memoryagentbench --limit 50"}]}],"id":"blk-44993","kind":"list-item"},{"blocks":[{"id":"blk-44996","kind":"paragraph","spans":[{"id":"spn-50708","marks":["bold"],"text":"Why second"},{"id":"spn-50709","text":": Directly tests Graphonomous's differentiating features (forgetting, learning loop). ICLR 2026 paper — high credibility."}]}],"id":"blk-44995","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44997","kind":"heading","level":3,"spans":[{"id":"spn-50710","text":"Session 3: LMEB (Long-horizon Memory Embedding Benchmark)"}]},{"id":"blk-44998","items":[{"blocks":[{"id":"blk-45000","kind":"paragraph","spans":[{"id":"spn-50711","marks":["bold"],"text":"Goal ID"},{"id":"spn-50712","text":": "},{"id":"spn-50713","marks":["code"],"text":"goal_81c0f91f92b9b4a52e0a38b44c49a492"}]}],"id":"blk-44999","kind":"list-item"},{"blocks":[{"id":"blk-45002","kind":"paragraph","spans":[{"id":"spn-50714","marks":["bold"],"text":"Paper"},{"id":"spn-50715","text":": https://arxiv.org/abs/2603.12572"}]}],"id":"blk-45001","kind":"list-item"},{"blocks":[{"id":"blk-45004","kind":"paragraph","spans":[{"id":"spn-50716","marks":["bold"],"text":"Repo"},{"id":"spn-50717","text":": https://github.com/KaLM-Embedding/LMEB"}]}],"id":"blk-45003","kind":"list-item"},{"blocks":[{"id":"blk-45006","kind":"paragraph","spans":[{"id":"spn-50718","marks":["bold"],"text":"HuggingFace"},{"id":"spn-50719","text":": https://huggingface.co/datasets/KaLM-Embedding/LMEB"}]}],"id":"blk-45005","kind":"list-item"},{"blocks":[{"id":"blk-45008","kind":"paragraph","spans":[{"id":"spn-50720","marks":["bold"],"text":"Dataset"},{"id":"spn-50721","text":": 22 datasets, 193 zero-shot retrieval tasks across 4 memory types (episodic, dialogue, semantic, procedural)"}]}],"id":"blk-45007","kind":"list-item"},{"blocks":[{"id":"blk-45010","kind":"paragraph","spans":[{"id":"spn-50722","marks":["bold"],"text":"Metrics"},{"id":"spn-50723","text":": Retrieval accuracy per memory type, aggregate score"}]}],"id":"blk-45009","kind":"list-item"},{"blocks":[{"id":"blk-45012","kind":"paragraph","spans":[{"id":"spn-50724","marks":["bold"],"text":"Key challenge"},{"id":"spn-50725","text":": This benchmarks the *embedding model*, not the full system. Run nomic-embed-text-v2-moe through the LMEB eval harness (likely Python). May need a thin Python wrapper or direct Elixir port of the eval logic."}]}],"id":"blk-45011","kind":"list-item"},{"blocks":[{"id":"blk-45014","kind":"paragraph","spans":[{"id":"spn-50726","marks":["bold"],"text":"Harness name"},{"id":"spn-50727","text":": "},{"id":"spn-50728","marks":["code"],"text":"mix benchmark.lmeb"}]}],"id":"blk-45013","kind":"list-item"},{"blocks":[{"id":"blk-45016","kind":"paragraph","spans":[{"id":"spn-50729","marks":["bold"],"text":"CLI"},{"id":"spn-50730","text":": "},{"id":"spn-50731","marks":["code"],"text":"mix benchmark.lmeb --model nomic-embed-text-v2-moe"}]}],"id":"blk-45015","kind":"list-item"},{"blocks":[{"id":"blk-45018","kind":"paragraph","spans":[{"id":"spn-50732","marks":["bold"],"text":"Why third"},{"id":"spn-50733","text":": Cheapest to run (embedding-only, no LLM judge needed). Validates the foundational layer. If nomic scores poorly on memory-specific retrieval, that's a critical finding."}]}],"id":"blk-45017","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45019","kind":"heading","level":3,"spans":[{"id":"spn-50734","text":"Session 4: MemoryBench (Continual Learning from Feedback)"}]},{"id":"blk-45020","items":[{"blocks":[{"id":"blk-45022","kind":"paragraph","spans":[{"id":"spn-50735","marks":["bold"],"text":"Goal ID"},{"id":"spn-50736","text":": "},{"id":"spn-50737","marks":["code"],"text":"goal_8ef86ae124eb2f03375289107dcac5ae"}]}],"id":"blk-45021","kind":"list-item"},{"blocks":[{"id":"blk-45024","kind":"paragraph","spans":[{"id":"spn-50738","marks":["bold"],"text":"Paper"},{"id":"spn-50739","text":": https://arxiv.org/abs/2510.17281"}]}],"id":"blk-45023","kind":"list-item"},{"blocks":[{"id":"blk-45026","kind":"paragraph","spans":[{"id":"spn-50740","marks":["bold"],"text":"Dataset"},{"id":"spn-50741","text":": User feedback simulation across multiple domains and languages"}]}],"id":"blk-45025","kind":"list-item"},{"blocks":[{"id":"blk-45028","kind":"paragraph","spans":[{"id":"spn-50742","marks":["bold"],"text":"Metrics"},{"id":"spn-50743","text":": Continual learning accuracy, feedback utilization rate, cross-domain transfer"}]}],"id":"blk-45027","kind":"list-item"},{"blocks":[{"id":"blk-45030","kind":"paragraph","spans":[{"id":"spn-50744","marks":["bold"],"text":"Key challenge"},{"id":"spn-50745","text":": Requires simulating the feedback loop — "},{"id":"spn-50746","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-50747","text":" with explicit/action-based/implicit feedback types, then re-querying to measure improvement. Multi-domain and multilingual means varied corpus."}]}],"id":"blk-45029","kind":"list-item"},{"blocks":[{"id":"blk-45032","kind":"paragraph","spans":[{"id":"spn-50748","marks":["bold"],"text":"Harness name"},{"id":"spn-50749","text":": "},{"id":"spn-50750","marks":["code"],"text":"mix benchmark.memorybench"}]}],"id":"blk-45031","kind":"list-item"},{"blocks":[{"id":"blk-45034","kind":"paragraph","spans":[{"id":"spn-50751","marks":["bold"],"text":"CLI"},{"id":"spn-50752","text":": "},{"id":"spn-50753","marks":["code"],"text":"mix benchmark.memorybench --domain all --limit 100"}]}],"id":"blk-45033","kind":"list-item"},{"blocks":[{"id":"blk-45036","kind":"paragraph","spans":[{"id":"spn-50754","marks":["bold"],"text":"Why fourth"},{"id":"spn-50755","text":": Directly tests the learning loop. Published finding that no system beats RAG baseline — if Graphonomous does, that's a headline result."}]}],"id":"blk-45035","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45037","kind":"heading","level":3,"spans":[{"id":"spn-50756","text":"Session 5: LifeBench (Non-Declarative Memory)"}]},{"id":"blk-45038","items":[{"blocks":[{"id":"blk-45040","kind":"paragraph","spans":[{"id":"spn-50757","marks":["bold"],"text":"Goal ID"},{"id":"spn-50758","text":": "},{"id":"spn-50759","marks":["code"],"text":"goal_824059ff9230ff0953646ea7ac2e7d6a"}]}],"id":"blk-45039","kind":"list-item"},{"blocks":[{"id":"blk-45042","kind":"paragraph","spans":[{"id":"spn-50760","marks":["bold"],"text":"Paper"},{"id":"spn-50761","text":": https://arxiv.org/abs/2603.03781"}]}],"id":"blk-45041","kind":"list-item"},{"blocks":[{"id":"blk-45044","kind":"paragraph","spans":[{"id":"spn-50762","marks":["bold"],"text":"Dataset"},{"id":"spn-50763","text":": Long-horizon event simulations with real-world priors (surveys, maps, calendars)"}]}],"id":"blk-45043","kind":"list-item"},{"blocks":[{"id":"blk-45046","kind":"paragraph","spans":[{"id":"spn-50764","marks":["bold"],"text":"Metrics"},{"id":"spn-50765","text":": Accuracy on habitual/procedural memory inference, declarative vs non-declarative breakdown"}]}],"id":"blk-45045","kind":"list-item"},{"blocks":[{"id":"blk-45048","kind":"paragraph","spans":[{"id":"spn-50766","marks":["bold"],"text":"SOTA"},{"id":"spn-50767","text":": 55.2% (top system)"}]}],"id":"blk-45047","kind":"list-item"},{"blocks":[{"id":"blk-45050","kind":"paragraph","spans":[{"id":"spn-50768","marks":["bold"],"text":"Key challenge"},{"id":"spn-50769","text":": Tests *inferred* knowledge, not explicitly stored facts. Graphonomous procedural nodes + edge patterns may capture habitual patterns that flat stores miss. May need to extend "},{"id":"spn-50770","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-50771","text":" or add inference logic."}]}],"id":"blk-45049","kind":"list-item"},{"blocks":[{"id":"blk-45052","kind":"paragraph","spans":[{"id":"spn-50772","marks":["bold"],"text":"Harness name"},{"id":"spn-50773","text":": "},{"id":"spn-50774","marks":["code"],"text":"mix benchmark.lifebench"}]}],"id":"blk-45051","kind":"list-item"},{"blocks":[{"id":"blk-45054","kind":"paragraph","spans":[{"id":"spn-50775","marks":["bold"],"text":"CLI"},{"id":"spn-50776","text":": "},{"id":"spn-50777","marks":["code"],"text":"mix benchmark.lifebench --limit 50"}]}],"id":"blk-45053","kind":"list-item"},{"blocks":[{"id":"blk-45056","kind":"paragraph","spans":[{"id":"spn-50778","marks":["bold"],"text":"Why fifth"},{"id":"spn-50779","text":": Hardest benchmark (SOTA is 55%). Low expectations, high signal. If graph structure helps even marginally on non-declarative memory, that validates the architecture thesis."}]}],"id":"blk-45055","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45057","kind":"heading","level":3,"spans":[{"id":"spn-50780","text":"Session 6: AMemGym (On-Policy Interactive)"}]},{"id":"blk-45058","items":[{"blocks":[{"id":"blk-45060","kind":"paragraph","spans":[{"id":"spn-50781","marks":["bold"],"text":"Goal ID"},{"id":"spn-50782","text":": "},{"id":"spn-50783","marks":["code"],"text":"goal_b7ccffd9e67df8e7b42366ff24a9be82"}]}],"id":"blk-45059","kind":"list-item"},{"blocks":[{"id":"blk-45062","kind":"paragraph","spans":[{"id":"spn-50784","marks":["bold"],"text":"Paper"},{"id":"spn-50785","text":": https://arxiv.org/abs/2603.01966"}]}],"id":"blk-45061","kind":"list-item"},{"blocks":[{"id":"blk-45064","kind":"paragraph","spans":[{"id":"spn-50786","marks":["bold"],"text":"HuggingFace"},{"id":"spn-50787","text":": https://huggingface.co/datasets/AGI-Eval/AMemGym"}]}],"id":"blk-45063","kind":"list-item"},{"blocks":[{"id":"blk-45066","kind":"paragraph","spans":[{"id":"spn-50788","marks":["bold"],"text":"Dataset"},{"id":"spn-50789","text":": Interactive on-policy benchmark — agent generates its own conversation"}]}],"id":"blk-45065","kind":"list-item"},{"blocks":[{"id":"blk-45068","kind":"paragraph","spans":[{"id":"spn-50790","marks":["bold"],"text":"Metrics"},{"id":"spn-50791","text":": Structured state consistency, memory utilization, persona tracking"}]}],"id":"blk-45067","kind":"list-item"},{"blocks":[{"id":"blk-45070","kind":"paragraph","spans":[{"id":"spn-50792","marks":["bold"],"text":"Key challenge"},{"id":"spn-50793","text":": This is fundamentally different from other benchmarks. The agent must *participate* in the conversation, not just answer post-hoc questions. Requires wiring Graphonomous MCP into a simulated conversation loop with an LLM-simulated user. Most complex harness to build."}]}],"id":"blk-45069","kind":"list-item"},{"blocks":[{"id":"blk-45072","kind":"paragraph","spans":[{"id":"spn-50794","marks":["bold"],"text":"Harness name"},{"id":"spn-50795","text":": "},{"id":"spn-50796","marks":["code"],"text":"mix benchmark.amemgym"}]}],"id":"blk-45071","kind":"list-item"},{"blocks":[{"id":"blk-45074","kind":"paragraph","spans":[{"id":"spn-50797","marks":["bold"],"text":"CLI"},{"id":"spn-50798","text":": "},{"id":"spn-50799","marks":["code"],"text":"mix benchmark.amemgym --scenarios 10"}]}],"id":"blk-45073","kind":"list-item"},{"blocks":[{"id":"blk-45076","kind":"paragraph","spans":[{"id":"spn-50800","marks":["bold"],"text":"Why last"},{"id":"spn-50801","text":": Most complex integration. Requires LLM-in-the-loop (simulated user). But the most realistic test of how Graphonomous actually performs in production. Save for last when all other harnesses are proven."}]}],"id":"blk-45075","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45077","kind":"paragraph","spans":[{"id":"spn-50802","text":"---"}]},{"id":"blk-45078","kind":"heading","level":2,"spans":[{"id":"spn-50803","text":"Post-Completion"}]},{"id":"blk-45079","kind":"paragraph","spans":[{"id":"spn-50804","text":"After all 6 harnesses are built and run:"}]},{"id":"blk-45080","kind":"paragraph","spans":[{"id":"spn-50805","text":"1. Update "},{"id":"spn-50806","marks":["code"],"text":"OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-50807","text":" with a unified results table 2. Update "},{"id":"spn-50808","marks":["code"],"text":"graphonomous.com/benchmarks/"},{"id":"spn-50809","text":" pages with new benchmark results 3. Update "},{"id":"spn-50810","marks":["code"],"text":"AmpersandBoxDesign/site/portfolio-review.html"},{"id":"spn-50811","text":" competitive landscape 4. Store a comprehensive episodic node in Graphonomous summarizing the full evaluation 5. Consider adding top-line scores to "},{"id":"spn-50812","marks":["code"],"text":"graphonomous/README.md"}]},{"id":"blk-45081","kind":"paragraph","spans":[{"id":"spn-50813","text":"---"}]},{"id":"blk-45082","kind":"heading","level":2,"spans":[{"id":"spn-50814","text":"Anti-Patterns to Avoid"}]},{"id":"blk-45083","items":[{"blocks":[{"id":"blk-45085","kind":"paragraph","spans":[{"id":"spn-50815","text":"Do NOT modify "},{"id":"spn-50816","marks":["code"],"text":"retrieve_context"},{"id":"spn-50817","text":" or the retrieval pipeline to game a specific benchmark"}]}],"id":"blk-45084","kind":"list-item"},{"blocks":[{"id":"blk-45087","kind":"paragraph","spans":[{"id":"spn-50818","text":"Do NOT add benchmark-specific code paths to the core engine"}]}],"id":"blk-45086","kind":"list-item"},{"blocks":[{"id":"blk-45089","kind":"paragraph","spans":[{"id":"spn-50819","text":"Do NOT skip the smoke test ("},{"id":"spn-50820","marks":["code"],"text":"--limit 50"},{"id":"spn-50821","text":") before full runs"}]}],"id":"blk-45088","kind":"list-item"},{"blocks":[{"id":"blk-45091","kind":"paragraph","spans":[{"id":"spn-50822","text":"Do NOT fabricate competitive baselines — only cite published numbers with sources"}]}],"id":"blk-45090","kind":"list-item"},{"blocks":[{"id":"blk-45093","kind":"paragraph","spans":[{"id":"spn-50823","text":"Do NOT skip storing results in Graphonomous — the learning loop is the point"}]}],"id":"blk-45092","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierakn25fi4j6ayv6jwzzkjlgprilbgffwy754bzdyjzhzmrmvms4brq","vocabulary":"ampersand.docs.fs.v1"}