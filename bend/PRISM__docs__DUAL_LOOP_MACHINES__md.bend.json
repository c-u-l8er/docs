actions)"}]},{"id":"blk-19600","kind":"paragraph","spans":[{"id":"spn-20231","marks":["code"],"text":"from_outcome"},{"id":"spn-20232","text":", "},{"id":"spn-20233","marks":["code"],"text":"from_feedback"},{"id":"spn-20234","text":", "},{"id":"spn-20235","marks":["code"],"text":"detect_novelty"},{"id":"spn-20236","text":", "},{"id":"spn-20237","marks":["code"],"text":"from_interaction"},{"id":"spn-20238","text":", "},{"id":"spn-20239","marks":["code"],"text":"contradictions"}]},{"id":"blk-19601","kind":"heading","level":3,"spans":[{"id":"spn-20240","marks":["code"],"text":"consolidate"},{"id":"spn-20241","text":" — \"Clean up\" (4 actions)"}]},{"id":"blk-19602","kind":"paragraph","spans":[{"id":"spn-20242","marks":["code"],"text":"run"},{"id":"spn-20243","text":", "},{"id":"spn-20244","marks":["code"],"text":"stats"},{"id":"spn-20245","text":", "},{"id":"spn-20246","marks":["code"],"text":"query"},{"id":"spn-20247","text":", "},{"id":"spn-20248","marks":["code"],"text":"traverse"}]},{"id":"blk-19603","kind":"heading","level":2,"spans":[{"id":"spn-20249","text":"Combined Impact"}]},{"head":[{"id":"blk-19605","spans":[{"id":"spn-20250","text":"Scenario"}]},{"id":"blk-19606","spans":[{"id":"spn-20251","text":"Before"}]},{"id":"blk-19607","spans":[{"id":"spn-20252","text":"After"}]}],"id":"blk-19604","kind":"table","rows":[[{"id":"blk-19608","spans":[{"id":"spn-20253","text":"Graphonomous alone"}]},{"id":"blk-19609","spans":[{"id":"spn-20254","text":"29 tools"}]},{"id":"blk-19610","spans":[{"id":"spn-20255","text":"5 tools"}]}],[{"id":"blk-19611","spans":[{"id":"spn-20256","text":"PRISM alone"}]},{"id":"blk-19612","spans":[{"id":"spn-20257","text":"47 tools"}]},{"id":"blk-19613","spans":[{"id":"spn-20258","text":"6 tools"}]}],[{"id":"blk-19614","spans":[{"id":"spn-20259","text":"Both in same session"}]},{"id":"blk-19615","spans":[{"id":"spn-20260","text":"76 tools"}]},{"id":"blk-19616","spans":[{"id":"spn-20261","text":"11 tools"}]}]]},{"id":"blk-19617","kind":"paragraph","spans":[{"id":"spn-20262","text":"Context savings: ~85% reduction in tool schema tokens. Selection accuracy: from ~49% (76 tools) to ~95% (11 tools)."}]},{"id":"blk-19618","kind":"heading","level":2,"spans":[{"id":"spn-20263","text":"Implementation"}]},{"id":"blk-19619","kind":"paragraph","spans":[{"id":"spn-20264","text":"Both systems use the same Elixir pattern: a single Anubis.Server.Component module per machine with an "},{"id":"spn-20265","marks":["code"],"text":"action"},{"id":"spn-20266","text":" field that dispatches internally to the existing tool implementations. The v1 tool modules are preserved as the implementation layer."}]},{"id":"blk-19620","kind":"paragraph","spans":[{"id":"spn-20267","text":"See:"}]},{"id":"blk-19621","items":[{"blocks":[{"id":"blk-19623","kind":"paragraph","spans":[{"id":"spn-20268","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/machines/"},{"id":"spn-20269","text":" — Graphonomous machine modules"}]}],"id":"blk-19622","kind":"list-item"},{"blocks":[{"id":"blk-19625","kind":"paragraph","spans":[{"id":"spn-20270","marks":["code"],"text":"PRISM/lib/prism/mcp/machines/"},{"id":"spn-20271","text":" — PRISM machine modules"}]}],"id":"blk-19624","kind":"list-item"},{"blocks":[{"id":"blk-19627","kind":"paragraph","spans":[{"id":"spn-20272","marks":["code"],"text":"AmpersandBoxDesign/prompts/DUAL_LOOP_MACHINES.md"},{"id":"spn-20273","text":" — canonical architecture design"}]}],"id":"blk-19626","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19628","kind":"heading","level":2,"spans":[{"id":"spn-20274","text":"Triple loop and beyond — PULSE generalization"}]},{"id":"blk-19629","kind":"paragraph","spans":[{"id":"spn-20275","text":"The Graphonomous ↔ PRISM dual loop is the canonical example, but the [&] ecosystem actually runs "},{"id":"spn-20276","marks":["bold"],"text":"at least three"},{"id":"spn-20277","text":" nested loops today:"}]},{"id":"blk-19630","kind":"code","language":"text","text":"PRISM (outer)        compose → interact → observe → reflect → diagnose\n  │\n  └─ Graphonomous    retrieve → route → act → learn → consolidate\n       │\n       └─ Deliberation    survey → triage → dispatch → act → learn"},{"id":"blk-19631","kind":"paragraph","spans":[{"id":"spn-20278","text":"OS-010 PULSE encodes this nesting in each manifest's "},{"id":"spn-20279","marks":["code"],"text":"nesting"},{"id":"spn-20280","text":" block:"}]},{"id":"blk-19632","items":[{"blocks":[{"id":"blk-19634","kind":"paragraph","spans":[{"id":"spn-20281","marks":["code"],"text":"prism.benchmark"},{"id":"spn-20282","text":" declares "},{"id":"spn-20283","marks":["code"],"text":"inner_loops: [graphonomous.continual_learning]"}]}],"id":"blk-19633","kind":"list-item"},{"blocks":[{"id":"blk-19636","kind":"paragraph","spans":[{"id":"spn-20284","marks":["code"],"text":"graphonomous.continual_learning"},{"id":"spn-20285","text":" declares "},{"id":"spn-20286","marks":["code"],"text":"inner_loops: [graphonomous.deliberate]"},{"id":"spn-20287","text":" and "},{"id":"spn-20288","marks":["code"],"text":"parent_loop: prism.benchmark"}]}],"id":"blk-19635","kind":"list-item"},{"blocks":[{"id":"blk-19638","kind":"paragraph","spans":[{"id":"spn-20289","marks":["code"],"text":"graphonomous.deliberate"},{"id":"spn-20290","text":" declares "},{"id":"spn-20291","marks":["code"],"text":"parent_loop: graphonomous.continual_learning"}]}],"id":"blk-19637","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19639","kind":"paragraph","spans":[{"id":"spn-20292","text":"PULSE supports unbounded nesting depth. OS-008 (Agent Harness, draft) is expected to add a fourth outer layer that wraps PRISM itself — when it ships, the only change required is a new manifest with "},{"id":"spn-20293","marks":["code"],"text":"inner_loops: [prism.benchmark]"},{"id":"spn-20294","text":". No code changes to existing machines."}]},{"id":"blk-19640","kind":"heading","level":3,"spans":[{"id":"spn-20295","text":"Why this matters for the machine architecture"}]},{"id":"blk-19641","kind":"paragraph","spans":[{"id":"spn-20296","text":"The 5/6/11-tool count documented above is a "},{"id":"spn-20297","marks":["bold"],"text":"floor"},{"id":"spn-20298","text":", not a ceiling. Adding a third loop adds at most 5 more machines (one per phase kind), and because PULSE manifests declare the inner-loop boundary explicitly, the outer machines do not need to learn about inner machines individually. PRISM's "},{"id":"spn-20299","marks":["code"],"text":"interact"},{"id":"spn-20300","text":" machine, for example, drives any PULSE-conforming inner loop through its declared "},{"id":"spn-20301","marks":["code"],"text":"retrieve"},{"id":"spn-20302","text":" phase — it does not need a Graphonomous-specific code path."}]},{"head":[{"id":"blk-19643","spans":[{"id":"spn-20303","text":"Layers in session"}]},{"id":"blk-19644","spans":[{"id":"spn-20304","text":"Tool count (machines)"}]},{"id":"blk-19645","spans":[{"id":"spn-20305","text":"Tool count (legacy v1)"}]}],"id":"blk-19642","kind":"table","rows":[[{"id":"blk-19646","spans":[{"id":"spn-20306","text":"Graphonomous alone"}]},{"id":"blk-19647","spans":[{"id":"spn-20307","text":"5"}]},{"id":"blk-19648","spans":[{"id":"spn-20308","text":"29"}]}],[{"id":"blk-19649","spans":[{"id":"spn-20309","text":"Graphonomous + PRISM"}]},{"id":"blk-19650","spans":[{"id":"spn-20310","text":"11"}]},{"id":"blk-19651","spans":[{"id":"spn-20311","text":"76"}]}],[{"id":"blk-19652","spans":[{"id":"spn-20312","text":"Graphonomous + PRISM + OS-008 Harness"}]},{"id":"blk-19653","spans":[{"id":"spn-20313","text":"~16"}]},{"id":"blk-19654","spans":[{"id":"spn-20314","text":"~100+"}]}],[{"id":"blk-19655","spans":[{"id":"spn-20315","text":"Graphonomous + PRISM + OS-008 + AgenTroMatic deliberation"}]},{"id":"blk-19656","spans":[{"id":"spn-20316","text":"~21"}]},{"id":"blk-19657","spans":[{"id":"spn-20317","text":"~130+"}]}]]},{"id":"blk-19658","kind":"paragraph","spans":[{"id":"spn-20318","text":"The savings compound with depth, and PULSE's manifest standard is what makes the composition algebraic instead of ad-hoc."}]},{"id":"blk-19659","kind":"heading","level":3,"spans":[{"id":"spn-20319","text":"Three-protocol stack at runtime"}]},{"id":"blk-19660","kind":"code","language":"text","text":"┌──────────────────────────────────────────────────────────┐\n│  PRISM    — measures loops over time      (diagnostic)   │ OS-009\n├──────────────────────────────────────────────────────────┤\n│  PULSE    — declares loops + circulation   (temporal)    │ OS-010\n├──────────────────────────────────────────────────────────┤\n│  [&]      — composes capabilities          (structural)  │ AmpersandBoxDesign\n└──────────────────────────────────────────────────────────┘"},{"id":"blk-19661","kind":"paragraph","spans":[{"id":"spn-20320","text":"A loop is "},{"id":"spn-20321","marks":["bold"],"text":"PULSE-conforming"},{"id":"spn-20322","text":" if its manifest validates against "},{"id":"spn-20323","marks":["code"],"text":"pulse-loop-manifest.v0.1.json"},{"id":"spn-20324","text":" and its runtime passes all 12 conformance tests. A system is "},{"id":"spn-20325","marks":["bold"],"text":"PRISM-evaluable"},{"id":"spn-20326","text":" automatically once it is PULSE-conforming — PRISM's "},{"id":"spn-20327","marks":["code"],"text":"compose"},{"id":"spn-20328","text":" phase reads the manifest, injects scenarios at the declared "},{"id":"spn-20329","marks":["code"],"text":"retrieve"},{"id":"spn-20330","text":" boundary, and observes outcomes via the declared "},{"id":"spn-20331","marks":["code"],"text":"learn"},{"id":"spn-20332","text":" phase. No bespoke per-system integration required."}]}],"edges":[],"id":"bagaaierapsqlvki2ih7wen6lhda2mhxtpw4yg3br462yb5u4vonc345zxrva","vocabulary":"ampersand.docs.fs.v1"}