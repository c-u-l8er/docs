{"bendscript":"0.1","blocks":[{"id":"blk-42529","kind":"paragraph","spans":[{"id":"spn-47401","text":"--- name: forgetting description: Use when nodes need to be removed from the knowledge graph — soft-hide from retrieval, hard-delete, cascade-delete orphans, GDPR-erase with audit, or run budget-aware priority pruning. Use when the user says \"forget this\", \"delete node\", \"remove node\", \"GDPR erase\", \"prune low-priority\", \"run forgetting policy\", or \"remove from memory\". For graph-wide cleanup use "},{"id":"spn-47402","marks":["code"],"text":"consolidate"},{"id":"spn-47403","text":"; for aggregate diagnostics use "},{"id":"spn-47404","marks":["code"],"text":"graph-health"},{"id":"spn-47405","text":". Routes through the "},{"id":"spn-47406","marks":["code"],"text":"act"},{"id":"spn-47407","text":" machine. argument-hint: <soft|hard|cascade|gdpr|policy> [node_id] ---"}]},{"id":"blk-42530","kind":"heading","level":1,"spans":[{"id":"spn-47408","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-42531","kind":"paragraph","spans":[{"id":"spn-47409","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-42532","kind":"heading","level":2,"spans":[{"id":"spn-47410","text":"Arguments"}]},{"id":"blk-42533","kind":"paragraph","spans":[{"id":"spn-47411","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-42534","kind":"heading","level":2,"spans":[{"id":"spn-47412","text":"Forgetting Modes"}]},{"id":"blk-42535","kind":"heading","level":3,"spans":[{"id":"spn-47413","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-42536","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-42537","kind":"paragraph","spans":[{"id":"spn-47414","text":"Node gets "},{"id":"spn-47415","marks":["code"],"text":"forgotten_at"},{"id":"spn-47416","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-42538","kind":"heading","level":3,"spans":[{"id":"spn-47417","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-42539","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-42540","kind":"paragraph","spans":[{"id":"spn-47418","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-42541","kind":"heading","level":3,"spans":[{"id":"spn-47419","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-42542","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-42543","kind":"paragraph","spans":[{"id":"spn-47420","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-42544","kind":"heading","level":3,"spans":[{"id":"spn-47421","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-42545","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-42546","kind":"paragraph","spans":[{"id":"spn-47422","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-42547","kind":"heading","level":2,"spans":[{"id":"spn-47423","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-42548","kind":"paragraph","spans":[{"id":"spn-47424","text":"Preview what would be forgotten:"}]},{"id":"blk-42549","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-42550","kind":"paragraph","spans":[{"id":"spn-47425","text":"Execute the policy:"}]},{"id":"blk-42551","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-42552","kind":"paragraph","spans":[{"id":"spn-47426","text":"Priority scoring: "},{"id":"spn-47427","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-47428","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-42553","kind":"heading","level":2,"spans":[{"id":"spn-47429","text":"When to Use Which"}]},{"head":[{"id":"blk-42555","spans":[{"id":"spn-47430","text":"Scenario"}]},{"id":"blk-42556","spans":[{"id":"spn-47431","text":"Mode"}]}],"id":"blk-42554","kind":"table","rows":[[{"id":"blk-42557","spans":[{"id":"spn-47432","text":"Outdated but might be useful later"}]},{"id":"blk-42558","spans":[{"id":"spn-47433","marks":["code"],"text":"forget_node"},{"id":"spn-47434","text":" mode: "},{"id":"spn-47435","marks":["code"],"text":"soft"}]}],[{"id":"blk-42559","spans":[{"id":"spn-47436","text":"Definitely wrong, no dependents"}]},{"id":"blk-42560","spans":[{"id":"spn-47437","marks":["code"],"text":"forget_node"},{"id":"spn-47438","text":" mode: "},{"id":"spn-47439","marks":["code"],"text":"hard"}]}],[{"id":"blk-42561","spans":[{"id":"spn-47440","text":"Wrong + has orphaned dependents"}]},{"id":"blk-42562","spans":[{"id":"spn-47441","marks":["code"],"text":"forget_node"},{"id":"spn-47442","text":" mode: "},{"id":"spn-47443","marks":["code"],"text":"cascade"}]}],[{"id":"blk-42563","spans":[{"id":"spn-47444","text":"Contains PII / user data"}]},{"id":"blk-42564","spans":[{"id":"spn-47445","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-42565","spans":[{"id":"spn-47446","text":"Graph getting too large"}]},{"id":"blk-42566","spans":[{"id":"spn-47447","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-42567","spans":[{"id":"spn-47448","text":"Want to weaken, not remove"}]},{"id":"blk-42568","spans":[{"id":"spn-47449","text":"Use "},{"id":"spn-47450","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-47451","text":" instead"}]}]]},{"id":"blk-42569","kind":"heading","level":2,"spans":[{"id":"spn-47452","text":"Anti-patterns to avoid"}]},{"id":"blk-42570","items":[{"blocks":[{"id":"blk-42572","kind":"paragraph","spans":[{"id":"spn-47453","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-42571","kind":"list-item"},{"blocks":[{"id":"blk-42574","kind":"paragraph","spans":[{"id":"spn-47454","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-42573","kind":"list-item"},{"blocks":[{"id":"blk-42576","kind":"paragraph","spans":[{"id":"spn-47455","text":"Always dry_run policy before executing"}]}],"id":"blk-42575","kind":"list-item"},{"blocks":[{"id":"blk-42578","kind":"paragraph","spans":[{"id":"spn-47456","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-42577","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7c7thzredyme4qypw2jufl7rk2lkm5f7jn3pkdte2brtsakptchq","vocabulary":"ampersand.docs.fs.v1"}