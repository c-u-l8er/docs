{"bendscript":"0.1","blocks":[{"id":"blk-14721","kind":"heading","level":1,"spans":[{"id":"spn-13461","text":"Skill 04 — Capability Contracts"}]},{"blocks":[{"id":"blk-14723","kind":"paragraph","spans":[{"id":"spn-13462","text":"How to read and write capability contracts — the typed interfaces that define what a capability does, what it accepts, and what it feeds into."}]}],"id":"blk-14722","kind":"quote"},{"id":"blk-14724","kind":"paragraph","spans":[{"id":"spn-13463","text":"---"}]},{"id":"blk-14725","kind":"heading","level":2,"spans":[{"id":"spn-13464","text":"Why This Matters"}]},{"id":"blk-14726","kind":"paragraph","spans":[{"id":"spn-13465","text":"Contracts are how the protocol enforces pipeline type safety. Without contracts, composition is just syntax. With contracts, the protocol can verify at declaration time that your pipeline will work at runtime."}]},{"id":"blk-14727","kind":"paragraph","spans":[{"id":"spn-13466","text":"---"}]},{"id":"blk-14728","kind":"heading","level":2,"spans":[{"id":"spn-13467","text":"Contract Schema Structure"}]},{"id":"blk-14729","kind":"paragraph","spans":[{"id":"spn-13468","text":"Every contract follows this shape:"}]},{"id":"blk-14730","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&time.anomaly\",\n  \"provider\": \"ticktickclock\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Temporal anomaly detection for streaming or historical signals.\",\n  \"operations\": { ... },\n  \"accepts_from\": [ ... ],\n  \"feeds_into\": [ ... ],\n  \"a2a_skills\": [ ... ],\n  \"metadata\": { ... }\n}"},{"head":[{"id":"blk-14732","spans":[{"id":"spn-13469","text":"Field"}]},{"id":"blk-14733","spans":[{"id":"spn-13470","text":"Required"}]},{"id":"blk-14734","spans":[{"id":"spn-13471","text":"Description"}]}],"id":"blk-14731","kind":"table","rows":[[{"id":"blk-14735","spans":[{"id":"spn-13472","marks":["code"],"text":"capability"}]},{"id":"blk-14736","spans":[{"id":"spn-13473","text":"Yes"}]},{"id":"blk-14737","spans":[{"id":"spn-13474","text":"The capability identifier ("},{"id":"spn-13475","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-13476","text":")"}]}],[{"id":"blk-14738","spans":[{"id":"spn-13477","marks":["code"],"text":"provider"}]},{"id":"blk-14739","spans":[{"id":"spn-13478","text":"Yes"}]},{"id":"blk-14740","spans":[{"id":"spn-13479","text":"Provider that satisfies this contract"}]}],[{"id":"blk-14741","spans":[{"id":"spn-13480","marks":["code"],"text":"version"}]},{"id":"blk-14742","spans":[{"id":"spn-13481","text":"Yes"}]},{"id":"blk-14743","spans":[{"id":"spn-13482","text":"Contract version (semver)"}]}],[{"id":"blk-14744","spans":[{"id":"spn-13483","marks":["code"],"text":"description"}]},{"id":"blk-14745","spans":[{"id":"spn-13484","text":"Yes"}]},{"id":"blk-14746","spans":[{"id":"spn-13485","text":"Human-readable description"}]}],[{"id":"blk-14747","spans":[{"id":"spn-13486","marks":["code"],"text":"operations"}]},{"id":"blk-14748","spans":[{"id":"spn-13487","text":"Yes"}]},{"id":"blk-14749","spans":[{"id":"spn-13488","text":"Map of operation names to input/output types"}]}],[{"id":"blk-14750","spans":[{"id":"spn-13489","marks":["code"],"text":"accepts_from"}]},{"id":"blk-14751","spans":[{"id":"spn-13490","text":"Yes"}]},{"id":"blk-14752","spans":[{"id":"spn-13491","text":"Types this capability can receive as input"}]}],[{"id":"blk-14753","spans":[{"id":"spn-13492","marks":["code"],"text":"feeds_into"}]},{"id":"blk-14754","spans":[{"id":"spn-13493","text":"Yes"}]},{"id":"blk-14755","spans":[{"id":"spn-13494","text":"Types this capability can produce as output targets"}]}],[{"id":"blk-14756","spans":[{"id":"spn-13495","marks":["code"],"text":"a2a_skills"}]},{"id":"blk-14757","spans":[{"id":"spn-13496","text":"No"}]},{"id":"blk-14758","spans":[{"id":"spn-13497","text":"A2A skill identifiers this maps to"}]}],[{"id":"blk-14759","spans":[{"id":"spn-13498","marks":["code"],"text":"metadata"}]},{"id":"blk-14760","spans":[{"id":"spn-13499","text":"No"}]},{"id":"blk-14761","spans":[{"id":"spn-13500","text":"Additional structured data"}]}]]},{"id":"blk-14762","kind":"paragraph","spans":[{"id":"spn-13501","text":"---"}]},{"id":"blk-14763","kind":"heading","level":2,"spans":[{"id":"spn-13502","text":"Operations Definition"}]},{"id":"blk-14764","kind":"paragraph","spans":[{"id":"spn-13503","text":"Operations define what a capability can do. Each operation has typed input and output:"}]},{"id":"blk-14765","kind":"code","language":"json","text":"\"operations\": {\n  \"detect\": {\n    \"in\": \"stream_data\",\n    \"out\": \"anomaly_set\",\n    \"description\": \"Detect anomalous events from temporal input signals.\",\n    \"deterministic\": false,\n    \"side_effects\": false\n  },\n  \"enrich\": {\n    \"in\": \"context\",\n    \"out\": \"enriched_context\",\n    \"description\": \"Attach anomaly-derived context to an existing payload.\",\n    \"deterministic\": false,\n    \"side_effects\": false\n  },\n  \"learn\": {\n    \"in\": \"observation\",\n    \"out\": \"ack\",\n    \"description\": \"Incorporate feedback to improve detection.\",\n    \"deterministic\": false,\n    \"side_effects\": true\n  }\n}"},{"head":[{"id":"blk-14767","spans":[{"id":"spn-13504","text":"Field"}]},{"id":"blk-14768","spans":[{"id":"spn-13505","text":"Description"}]}],"id":"blk-14766","kind":"table","rows":[[{"id":"blk-14769","spans":[{"id":"spn-13506","marks":["code"],"text":"in"}]},{"id":"blk-14770","spans":[{"id":"spn-13507","text":"Input type token this operation expects"}]}],[{"id":"blk-14771","spans":[{"id":"spn-13508","marks":["code"],"text":"out"}]},{"id":"blk-14772","spans":[{"id":"spn-13509","text":"Output type token this operation produces"}]}],[{"id":"blk-14773","spans":[{"id":"spn-13510","marks":["code"],"text":"description"}]},{"id":"blk-14774","spans":[{"id":"spn-13511","text":"What the operation does"}]}],[{"id":"blk-14775","spans":[{"id":"spn-13512","marks":["code"],"text":"deterministic"}]},{"id":"blk-14776","spans":[{"id":"spn-13513","text":"Whether same input always produces same output"}]}],[{"id":"blk-14777","spans":[{"id":"spn-13514","marks":["code"],"text":"side_effects"}]},{"id":"blk-14778","spans":[{"id":"spn-13515","text":"Whether the operation modifies state"}]}]]},{"id":"blk-14779","kind":"paragraph","spans":[{"id":"spn-13516","text":"---"}]},{"id":"blk-14780","kind":"heading","level":2,"spans":[{"id":"spn-13517","text":"accepts_from and feeds_into"}]},{"id":"blk-14781","kind":"paragraph","spans":[{"id":"spn-13518","text":"These fields define the "},{"id":"spn-13519","marks":["bold"],"text":"type compatibility"},{"id":"spn-13520","text":" of a capability:"}]},{"id":"blk-14782","kind":"code","language":"json","text":"\"accepts_from\": [\"&memory.*\", \"&space.*\", \"raw_data\", \"stream_data\", \"context\"],\n\"feeds_into\": [\"&memory.*\", \"&reason.*\", \"&space.*\", \"output\"]"},{"id":"blk-14783","kind":"paragraph","spans":[{"id":"spn-13521","marks":["bold"],"text":"`accepts_from`"},{"id":"spn-13522","text":" — What types can flow INTO this capability. Used to validate that the previous pipeline step's output is compatible."}]},{"id":"blk-14784","kind":"paragraph","spans":[{"id":"spn-13523","marks":["bold"],"text":"`feeds_into`"},{"id":"spn-13524","text":" — What types can flow OUT of this capability. Used to validate that the next pipeline step can accept this output."}]},{"id":"blk-14785","kind":"heading","level":3,"spans":[{"id":"spn-13525","text":"Type token categories"}]},{"head":[{"id":"blk-14787","spans":[{"id":"spn-13526","text":"Category"}]},{"id":"blk-14788","spans":[{"id":"spn-13527","text":"Examples"}]},{"id":"blk-14789","spans":[{"id":"spn-13528","text":"Meaning"}]}],"id":"blk-14786","kind":"table","rows":[[{"id":"blk-14790","spans":[{"id":"spn-13529","text":"Capability wildcards"}]},{"id":"blk-14791","spans":[{"id":"spn-13530","marks":["code"],"text":"&memory.*"},{"id":"spn-13531","text":", "},{"id":"spn-13532","marks":["code"],"text":"&reason.*"}]},{"id":"blk-14792","spans":[{"id":"spn-13533","text":"Output from any capability in that domain"}]}],[{"id":"blk-14793","spans":[{"id":"spn-13534","text":"Literal types"}]},{"id":"blk-14794","spans":[{"id":"spn-13535","marks":["code"],"text":"raw_data"},{"id":"spn-13536","text":", "},{"id":"spn-13537","marks":["code"],"text":"stream_data"},{"id":"spn-13538","text":", "},{"id":"spn-13539","marks":["code"],"text":"context"}]},{"id":"blk-14795","spans":[{"id":"spn-13540","text":"Specific data shapes"}]}],[{"id":"blk-14796","spans":[{"id":"spn-13541","text":"Terminal"}]},{"id":"blk-14797","spans":[{"id":"spn-13542","marks":["code"],"text":"output"}]},{"id":"blk-14798","spans":[{"id":"spn-13543","text":"Pipeline result, no further steps"}]}],[{"id":"blk-14799","spans":[{"id":"spn-13544","text":"Acknowledgment"}]},{"id":"blk-14800","spans":[{"id":"spn-13545","marks":["code"],"text":"ack"}]},{"id":"blk-14801","spans":[{"id":"spn-13546","text":"Confirmation of a side-effecting operation"}]}]]},{"id":"blk-14802","kind":"paragraph","spans":[{"id":"spn-13547","text":"---"}]},{"id":"blk-14803","kind":"heading","level":2,"spans":[{"id":"spn-13548","text":"Wildcard Matching Rules"}]},{"id":"blk-14804","kind":"paragraph","spans":[{"id":"spn-13549","text":"Wildcards match any subtype within a primitive domain:"}]},{"head":[{"id":"blk-14806","spans":[{"id":"spn-13550","text":"Pattern"}]},{"id":"blk-14807","spans":[{"id":"spn-13551","text":"Matches"}]},{"id":"blk-14808","spans":[{"id":"spn-13552","text":"Does Not Match"}]}],"id":"blk-14805","kind":"table","rows":[[{"id":"blk-14809","spans":[{"id":"spn-13553","marks":["code"],"text":"&memory.*"}]},{"id":"blk-14810","spans":[{"id":"spn-13554","marks":["code"],"text":"&memory.graph"},{"id":"spn-13555","text":", "},{"id":"spn-13556","marks":["code"],"text":"&memory.vector"},{"id":"spn-13557","text":", "},{"id":"spn-13558","marks":["code"],"text":"&memory.episodic"}]},{"id":"blk-14811","spans":[{"id":"spn-13559","marks":["code"],"text":"&reason.argument"},{"id":"spn-13560","text":", "},{"id":"spn-13561","marks":["code"],"text":"&time.anomaly"}]}],[{"id":"blk-14812","spans":[{"id":"spn-13562","marks":["code"],"text":"&reason.*"}]},{"id":"blk-14813","spans":[{"id":"spn-13563","marks":["code"],"text":"&reason.argument"},{"id":"spn-13564","text":", "},{"id":"spn-13565","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-13566","text":", "},{"id":"spn-13567","marks":["code"],"text":"&reason.attend"}]},{"id":"blk-14814","spans":[{"id":"spn-13568","marks":["code"],"text":"&memory.graph"}]}],[{"id":"blk-14815","spans":[{"id":"spn-13569","marks":["code"],"text":"&time.*"}]},{"id":"blk-14816","spans":[{"id":"spn-13570","marks":["code"],"text":"&time.anomaly"},{"id":"spn-13571","text":", "},{"id":"spn-13572","marks":["code"],"text":"&time.forecast"}]},{"id":"blk-14817","spans":[{"id":"spn-13573","marks":["code"],"text":"&space.fleet"}]}],[{"id":"blk-14818","spans":[{"id":"spn-13574","marks":["code"],"text":"&space.*"}]},{"id":"blk-14819","spans":[{"id":"spn-13575","marks":["code"],"text":"&space.fleet"},{"id":"spn-13576","text":", "},{"id":"spn-13577","marks":["code"],"text":"&space.geofence"}]},{"id":"blk-14820","spans":[{"id":"spn-13578","marks":["code"],"text":"&memory.graph"}]}]]},{"id":"blk-14821","kind":"paragraph","spans":[{"id":"spn-13579","text":"A literal type like "},{"id":"spn-13580","marks":["code"],"text":"\"stream_data\""},{"id":"spn-13581","text":" matches only itself — no wildcards."}]},{"id":"blk-14822","kind":"paragraph","spans":[{"id":"spn-13582","text":"---"}]},{"id":"blk-14823","kind":"heading","level":2,"spans":[{"id":"spn-13583","text":"A2A Skill Mapping"}]},{"id":"blk-14824","kind":"paragraph","spans":[{"id":"spn-13584","text":"The "},{"id":"spn-13585","marks":["code"],"text":"a2a_skills"},{"id":"spn-13586","text":" field maps capability operations to A2A skill identifiers:"}]},{"id":"blk-14825","kind":"code","language":"json","text":"\"a2a_skills\": [\"temporal-anomaly-detection\"]"},{"id":"blk-14826","kind":"paragraph","spans":[{"id":"spn-13587","text":"When generating an A2A agent card, these skill identifiers appear in the agent's skill registry. This allows other agents to discover capabilities via the A2A protocol."}]},{"id":"blk-14827","kind":"paragraph","spans":[{"id":"spn-13588","text":"Multiple skills per contract are permitted:"}]},{"id":"blk-14828","kind":"code","language":"json","text":"\"a2a_skills\": [\n  \"topology-aware-deliberation\",\n  \"knowledge-graph-reasoning\"\n]"},{"id":"blk-14829","kind":"paragraph","spans":[{"id":"spn-13589","text":"---"}]},{"id":"blk-14830","kind":"heading","level":2,"spans":[{"id":"spn-13590","text":"How Providers Satisfy Contracts"}]},{"id":"blk-14831","kind":"paragraph","spans":[{"id":"spn-13591","text":"A provider satisfies a contract when:"}]},{"id":"blk-14832","kind":"paragraph","spans":[{"id":"spn-13592","text":"1. It implements all operations listed in the contract 2. Each operation accepts the declared input type 3. Each operation produces the declared output type 4. The provider responds via MCP transport (stdio or HTTP)"}]},{"id":"blk-14833","kind":"paragraph","spans":[{"id":"spn-13593","text":"The contract is a promise. The provider is the implementation. The protocol validates the promise at composition time; the runtime enforces it at execution time."}]},{"id":"blk-14834","kind":"paragraph","spans":[{"id":"spn-13594","text":"---"}]},{"id":"blk-14835","kind":"heading","level":2,"spans":[{"id":"spn-13595","text":"Real Contract Examples"}]},{"id":"blk-14836","kind":"heading","level":3,"spans":[{"id":"spn-13596","marks":["code"],"text":"&memory.graph"},{"id":"spn-13597","text":" (Graphonomous)"}]},{"id":"blk-14837","kind":"code","language":"json","text":"{\n  \"capability\": \"&memory.graph\",\n  \"operations\": {\n    \"recall\":   { \"in\": \"query\",   \"out\": \"retrieval_result\" },\n    \"store\":    { \"in\": \"context\", \"out\": \"ack\" },\n    \"enrich\":   { \"in\": \"context\", \"out\": \"enriched_context\" },\n    \"topology\": { \"in\": \"node_set\", \"out\": \"topology_result\" }\n  },\n  \"accepts_from\": [\"&time.*\", \"&space.*\", \"&reason.*\", \"query\", \"context\"],\n  \"feeds_into\": [\"&reason.*\", \"&time.*\", \"&space.*\", \"output\"]\n}"},{"id":"blk-14838","kind":"heading","level":3,"spans":[{"id":"spn-13598","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-13599","text":" (Graphonomous)"}]},{"id":"blk-14839","kind":"code","language":"json","text":"{\n  \"capability\": \"&reason.deliberate\",\n  \"operations\": {\n    \"deliberate\": { \"in\": \"topology_result\", \"out\": \"deliberation_result\" },\n    \"decompose\":  { \"in\": \"topology_result\", \"out\": \"partitions\" },\n    \"reconcile\":  { \"in\": \"intermediate_conclusions\", \"out\": \"deliberation_result\" }\n  },\n  \"accepts_from\": [\"&memory.graph\", \"&memory.*\"],\n  \"feeds_into\": [\"&memory.graph\", \"&reason.*\", \"output\"]\n}"},{"id":"blk-14840","kind":"paragraph","spans":[{"id":"spn-13600","text":"Full contracts are in "},{"id":"spn-13601","marks":["code"],"text":"contracts/v0.1.0/"},{"id":"spn-13602","text":" — one file per capability."}]},{"id":"blk-14841","kind":"paragraph","spans":[{"id":"spn-13603","text":"---"}]},{"id":"blk-14842","kind":"heading","level":2,"spans":[{"id":"spn-13604","text":"Contract Versioning"}]},{"id":"blk-14843","kind":"paragraph","spans":[{"id":"spn-13605","text":"Contracts use semver. When a provider changes its operations, types, or compatibility:"}]},{"id":"blk-14844","items":[{"blocks":[{"id":"blk-14846","kind":"paragraph","spans":[{"id":"spn-13606","marks":["bold"],"text":"Patch"},{"id":"spn-13607","text":" ("},{"id":"spn-13608","marks":["code"],"text":"0.1.1"},{"id":"spn-13609","text":"): Bug fixes, no interface changes"}]}],"id":"blk-14845","kind":"list-item"},{"blocks":[{"id":"blk-14848","kind":"paragraph","spans":[{"id":"spn-13610","marks":["bold"],"text":"Minor"},{"id":"spn-13611","text":" ("},{"id":"spn-13612","marks":["code"],"text":"0.2.0"},{"id":"spn-13613","text":"): New operations added, existing operations unchanged"}]}],"id":"blk-14847","kind":"list-item"},{"blocks":[{"id":"blk-14850","kind":"paragraph","spans":[{"id":"spn-13614","marks":["bold"],"text":"Major"},{"id":"spn-13615","text":" ("},{"id":"spn-13616","marks":["code"],"text":"1.0.0"},{"id":"spn-13617","text":"): Breaking changes to existing operations or types"}]}],"id":"blk-14849","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14851","kind":"paragraph","spans":[{"id":"spn-13618","text":"Declarations should pin contract versions to avoid unexpected breakage."}]}],"edges":[],"id":"bagaaieravusxqs6wuszhrnp7kym2n7oee2cmxgbxo22pzlaqgnyk7r7b6nga","vocabulary":"ampersand.docs.fs.v1"}