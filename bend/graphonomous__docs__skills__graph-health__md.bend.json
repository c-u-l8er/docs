{"bendscript":"0.1","blocks":[{"id":"blk-42652","kind":"paragraph","spans":[{"id":"spn-47572","text":"--- name: graph-health description: Use when the user asks \"is the graph healthy?\", \"run diagnostics\", \"graph quality\", \"check graph health\", \"memory health\", \"audit the graph\", \"how big is the graph?\", \"any problems?\", or wants a combined health report. Runs stats, identifies weak nodes, checks for orphans, and reports frontier uncertainty. Routes through "},{"id":"spn-47573","marks":["code"],"text":"consolidate"},{"id":"spn-47574","text":", "},{"id":"spn-47575","marks":["code"],"text":"retrieve"},{"id":"spn-47576","text":", and "},{"id":"spn-47577","marks":["code"],"text":"act"},{"id":"spn-47578","text":" machines. argument-hint: [--full] [--fix] ---"}]},{"id":"blk-42653","kind":"heading","level":1,"spans":[{"id":"spn-47579","text":"Graph Health Check"}]},{"id":"blk-42654","kind":"paragraph","spans":[{"id":"spn-47580","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-42655","kind":"heading","level":2,"spans":[{"id":"spn-47581","text":"Arguments"}]},{"id":"blk-42656","kind":"paragraph","spans":[{"id":"spn-47582","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-42657","items":[{"blocks":[{"id":"blk-42659","kind":"paragraph","spans":[{"id":"spn-47583","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-42658","kind":"list-item"},{"blocks":[{"id":"blk-42661","kind":"paragraph","spans":[{"id":"spn-47584","marks":["code"],"text":"--full"},{"id":"spn-47585","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-42660","kind":"list-item"},{"blocks":[{"id":"blk-42663","kind":"paragraph","spans":[{"id":"spn-47586","marks":["code"],"text":"--fix"},{"id":"spn-47587","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-42662","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42664","kind":"heading","level":2,"spans":[{"id":"spn-47588","text":"Quick Health Check"}]},{"id":"blk-42665","kind":"heading","level":3,"spans":[{"id":"spn-47589","text":"Step 1 — Graph stats"}]},{"id":"blk-42666","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-42667","kind":"paragraph","spans":[{"id":"spn-47590","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-42668","kind":"heading","level":3,"spans":[{"id":"spn-47591","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-42670","spans":[{"id":"spn-47592","text":"Metric"}]},{"id":"blk-42671","spans":[{"id":"spn-47593","text":"Healthy"}]},{"id":"blk-42672","spans":[{"id":"spn-47594","text":"Warning"}]},{"id":"blk-42673","spans":[{"id":"spn-47595","text":"Critical"}]}],"id":"blk-42669","kind":"table","rows":[[{"id":"blk-42674","spans":[{"id":"spn-47596","text":"Orphan ratio"}]},{"id":"blk-42675","spans":[{"id":"spn-47597","text":"< 10%"}]},{"id":"blk-42676","spans":[{"id":"spn-47598","text":"10–30%"}]},{"id":"blk-42677","spans":[{"id":"spn-47599","text":"> 30%"}]}],[{"id":"blk-42678","spans":[{"id":"spn-47600","text":"Mean confidence"}]},{"id":"blk-42679","spans":[{"id":"spn-47601","text":"> 0.5"}]},{"id":"blk-42680","spans":[{"id":"spn-47602","text":"0.3–0.5"}]},{"id":"blk-42681","spans":[{"id":"spn-47603","text":"< 0.3"}]}],[{"id":"blk-42682","spans":[{"id":"spn-47604","text":"Edge/node ratio"}]},{"id":"blk-42683","spans":[{"id":"spn-47605","text":"> 1.5"}]},{"id":"blk-42684","spans":[{"id":"spn-47606","text":"0.5–1.5"}]},{"id":"blk-42685","spans":[{"id":"spn-47607","text":"< 0.5"}]}],[{"id":"blk-42686","spans":[{"id":"spn-47608","text":"Confidence std_dev"}]},{"id":"blk-42687","spans":[{"id":"spn-47609","text":"< 0.25"}]},{"id":"blk-42688","spans":[{"id":"spn-47610","text":"0.25–0.35"}]},{"id":"blk-42689","spans":[{"id":"spn-47611","text":"> 0.35"}]}]]},{"id":"blk-42690","kind":"paragraph","spans":[{"id":"spn-47612","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-42692","kind":"paragraph","spans":[{"id":"spn-47613","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-47614","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-42691","kind":"quote"},{"id":"blk-42693","kind":"heading","level":2,"spans":[{"id":"spn-47615","text":"Full Audit (--full)"}]},{"id":"blk-42694","kind":"heading","level":3,"spans":[{"id":"spn-47616","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-42695","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-42696","kind":"paragraph","spans":[{"id":"spn-47617","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-42697","kind":"heading","level":3,"spans":[{"id":"spn-47618","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-42698","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-42699","kind":"paragraph","spans":[{"id":"spn-47619","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-42700","kind":"heading","level":3,"spans":[{"id":"spn-47620","text":"Step 5 — Check for staleness"}]},{"id":"blk-42701","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-42702","kind":"paragraph","spans":[{"id":"spn-47621","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-42703","kind":"heading","level":3,"spans":[{"id":"spn-47622","text":"Step 6 — Orphan details"}]},{"id":"blk-42704","kind":"paragraph","spans":[{"id":"spn-47623","text":"If orphan count > 10%, list them:"}]},{"id":"blk-42705","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-42706","kind":"paragraph","spans":[{"id":"spn-47624","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-42707","kind":"heading","level":2,"spans":[{"id":"spn-47625","text":"Auto-Fix (--fix)"}]},{"id":"blk-42708","kind":"paragraph","spans":[{"id":"spn-47626","text":"When "},{"id":"spn-47627","marks":["code"],"text":"--fix"},{"id":"spn-47628","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-42709","kind":"heading","level":3,"spans":[{"id":"spn-47629","text":"Fix orphans — connect or prune"}]},{"id":"blk-42710","kind":"paragraph","spans":[{"id":"spn-47630","text":"For each orphan node: 1. Search for related nodes: "},{"id":"spn-47631","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"},{"id":"spn-47632","text":" 2. If similarity > 0.5 with any node → create "},{"id":"spn-47633","marks":["code"],"text":"related_to"},{"id":"spn-47634","text":" edge 3. If no matches and confidence < 0.3 → prune: "},{"id":"spn-47635","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-42711","kind":"heading","level":3,"spans":[{"id":"spn-47636","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-42712","kind":"paragraph","spans":[{"id":"spn-47637","text":"For nodes with confidence < 0.2: 1. Check if still relevant (search for supporting context) 2. If supporting evidence exists → "},{"id":"spn-47638","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"},{"id":"spn-47639","text":" 3. If no support → "},{"id":"spn-47640","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-42713","kind":"heading","level":3,"spans":[{"id":"spn-47641","text":"Fix staleness — flag for sync"}]},{"id":"blk-42714","kind":"paragraph","spans":[{"id":"spn-47642","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-47643","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-47644","text":" to ingest recent filesystem changes."}]},{"id":"blk-42715","kind":"heading","level":2,"spans":[{"id":"spn-47645","text":"Health Report Format"}]},{"id":"blk-42716","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-42717","kind":"heading","level":2,"spans":[{"id":"spn-47646","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-42719","spans":[{"id":"spn-47647","text":"Situation"}]},{"id":"blk-42720","spans":[{"id":"spn-47648","text":"Follow-up"}]}],"id":"blk-42718","kind":"table","rows":[[{"id":"blk-42721","spans":[{"id":"spn-47649","text":"High orphan count"}]},{"id":"blk-42722","spans":[{"id":"spn-47650","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-47651","text":" to rebuild edges"}]}],[{"id":"blk-42723","spans":[{"id":"spn-47652","text":"Low mean confidence"}]},{"id":"blk-42724","spans":[{"id":"spn-47653","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-47654","text":" to merge and strengthen"}]}],[{"id":"blk-42725","spans":[{"id":"spn-47655","text":"Frontier gaps"}]},{"id":"blk-42726","spans":[{"id":"spn-47656","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-47657","text":" to fill gaps"}]}],[{"id":"blk-42727","spans":[{"id":"spn-47658","text":"Stale graph"}]},{"id":"blk-42728","spans":[{"id":"spn-47659","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-47660","text":" for continuous sync"}]}]]},{"id":"blk-42729","kind":"heading","level":2,"spans":[{"id":"spn-47661","text":"Anti-patterns to avoid"}]},{"id":"blk-42730","items":[{"blocks":[{"id":"blk-42732","kind":"paragraph","spans":[{"id":"spn-47662","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-42731","kind":"list-item"},{"blocks":[{"id":"blk-42734","kind":"paragraph","spans":[{"id":"spn-47663","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-42733","kind":"list-item"},{"blocks":[{"id":"blk-42736","kind":"paragraph","spans":[{"id":"spn-47664","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-42735","kind":"list-item"},{"blocks":[{"id":"blk-42738","kind":"paragraph","spans":[{"id":"spn-47665","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-42737","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierarvv454bank2gloitw6qrdwmkhski53dmtgzbdwh5cgmfqznoutqa","vocabulary":"ampersand.docs.fs.v1"}