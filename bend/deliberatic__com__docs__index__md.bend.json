{"bendscript":"0.1","blocks":[{"id":"blk-37194","kind":"heading","level":1,"spans":[{"id":"spn-40470","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-37196","kind":"paragraph","spans":[{"id":"spn-40471","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-37195","kind":"quote"},{"blocks":[{"id":"blk-37198","kind":"paragraph","spans":[{"id":"spn-40472","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-40473","text":" · "},{"id":"spn-40474","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-40475","text":" · "},{"id":"spn-40476","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-40477","text":" · "},{"id":"spn-40478","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-37197","kind":"quote"},{"id":"blk-37199","kind":"paragraph","spans":[{"id":"spn-40479","text":"Welcome to the documentation hub for "},{"id":"spn-40480","marks":["bold"],"text":"Deliberatic"},{"id":"spn-40481","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-37200","kind":"paragraph","spans":[{"id":"spn-40482","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-37201","kind":"paragraph","spans":[{"id":"spn-40483","text":"---"}]},{"id":"blk-37202","kind":"heading","level":2,"spans":[{"id":"spn-40484","text":"Why Deliberatic?"}]},{"id":"blk-37203","kind":"paragraph","spans":[{"id":"spn-40485","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-37204","kind":"paragraph","spans":[{"id":"spn-40486","text":"1. "},{"id":"spn-40487","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-40488","text":" — agents exchange opinions with no structured way to compare, attack, or support positions 2. "},{"id":"spn-40489","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-40490","text":" — a compromised agent can corrupt the entire cluster 3. "},{"id":"spn-40491","marks":["bold"],"text":"No audit trail"},{"id":"spn-40492","text":" — enterprise deployments require explainable, verifiable decision chains"}]},{"id":"blk-37205","kind":"paragraph","spans":[{"id":"spn-40493","text":"Deliberatic addresses all three."}]},{"id":"blk-37206","kind":"paragraph","spans":[{"id":"spn-40494","text":"---"}]},{"id":"blk-37207","kind":"heading","level":2,"spans":[{"id":"spn-40495","text":"Documentation Map"}]},{"id":"blk-37208","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-37209","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-37210","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Deliberatic Docs\n\nspec/README"},{"id":"blk-37211","kind":"paragraph","spans":[{"id":"spn-40496","text":"---"}]},{"id":"blk-37212","kind":"heading","level":2,"spans":[{"id":"spn-40497","text":"Core Concepts"}]},{"id":"blk-37213","kind":"heading","level":3,"spans":[{"id":"spn-40498","text":"Deliberatic Argumentation Framework (DAF)"}]},{"id":"blk-37214","kind":"paragraph","spans":[{"id":"spn-40499","text":"A formal tuple "},{"id":"spn-40500","marks":["code"],"text":"DAF = <A, R-, R+, w, a, C, p>"},{"id":"spn-40501","text":" combining:"}]},{"id":"blk-37215","items":[{"blocks":[{"id":"blk-37217","kind":"paragraph","spans":[{"id":"spn-40502","marks":["bold"],"text":"Weighted bipolar argumentation"},{"id":"spn-40503","text":" (attacks + supports with evidence-derived weights)"}]}],"id":"blk-37216","kind":"list-item"},{"blocks":[{"id":"blk-37219","kind":"paragraph","spans":[{"id":"spn-40504","marks":["bold"],"text":"Agent authorship tracking"},{"id":"spn-40505","text":" (every argument traces to its submitting agent)"}]}],"id":"blk-37218","kind":"list-item"},{"blocks":[{"id":"blk-37221","kind":"paragraph","spans":[{"id":"spn-40506","marks":["bold"],"text":"Constitutional constraints"},{"id":"spn-40507","text":" (hard boundaries + soft preferences)"}]}],"id":"blk-37220","kind":"list-item"},{"blocks":[{"id":"blk-37223","kind":"paragraph","spans":[{"id":"spn-40508","marks":["bold"],"text":"Domain-aware reputation"},{"id":"spn-40509","text":" (ELO-derived, calibration-adjusted)"}]}],"id":"blk-37222","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37224","kind":"heading","level":3,"spans":[{"id":"spn-40510","text":"Two-Phase Adaptive Consensus"}]},{"id":"blk-37225","items":[{"blocks":[{"id":"blk-37227","kind":"paragraph","spans":[{"id":"spn-40511","marks":["bold"],"text":"Fast path (Raft-derived)"},{"id":"spn-40512","text":" — when positions have a clear winner (~50ms)"}]}],"id":"blk-37226","kind":"list-item"},{"blocks":[{"id":"blk-37229","kind":"paragraph","spans":[{"id":"spn-40513","marks":["bold"],"text":"Conflict path (PBFT-derived)"},{"id":"spn-40514","text":" — when positions are close, Byzantine-tolerant (~200ms)"}]}],"id":"blk-37228","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37230","kind":"heading","level":3,"spans":[{"id":"spn-40515","text":"Constitution DSL"}]},{"id":"blk-37231","kind":"paragraph","spans":[{"id":"spn-40516","text":"YAML-based normative constraints: hard boundaries (instant rejection on violation), soft preferences (score adjustments), and amendment rules (vindicated dissents trigger constitutional votes)."}]},{"id":"blk-37232","kind":"heading","level":3,"spans":[{"id":"spn-40517","text":"Merkle-Chained Evidence"}]},{"id":"blk-37233","kind":"paragraph","spans":[{"id":"spn-40518","text":"Every deliberation round produces an immutable evidence chain — SHA-256 hashed positions, challenges, votes, and verdicts with a verifiable Merkle root."}]},{"id":"blk-37234","kind":"paragraph","spans":[{"id":"spn-40519","text":"---"}]},{"id":"blk-37235","kind":"heading","level":2,"spans":[{"id":"spn-40520","text":"Transport Bindings"}]},{"head":[{"id":"blk-37237","spans":[{"id":"spn-40521","text":"Protocol"}]},{"id":"blk-37238","spans":[{"id":"spn-40522","text":"Support"}]}],"id":"blk-37236","kind":"table","rows":[[{"id":"blk-37239","spans":[{"id":"spn-40523","marks":["bold"],"text":"A2A"},{"id":"spn-40524","text":" (Google/Linux Foundation)"}]},{"id":"blk-37240","spans":[{"id":"spn-40525","text":"Native — agents advertise "},{"id":"spn-40526","marks":["code"],"text":"deliberation/v1"},{"id":"spn-40527","text":" skill"}]}],[{"id":"blk-37241","spans":[{"id":"spn-40528","marks":["bold"],"text":"MCP"},{"id":"spn-40529","text":" (Anthropic/AAIF)"}]},{"id":"blk-37242","spans":[{"id":"spn-40530","text":"MCP server with 7 tools"}]}],[{"id":"blk-37243","spans":[{"id":"spn-40531","marks":["bold"],"text":"HTTP"}]},{"id":"blk-37244","spans":[{"id":"spn-40532","text":"JSON-RPC 2.0 + SSE for streaming"}]}]]},{"id":"blk-37245","kind":"heading","level":3,"spans":[{"id":"spn-40533","text":"MCP Tools"}]},{"head":[{"id":"blk-37247","spans":[{"id":"spn-40534","text":"Tool"}]},{"id":"blk-37248","spans":[{"id":"spn-40535","text":"Description"}]}],"id":"blk-37246","kind":"table","rows":[[{"id":"blk-37249","spans":[{"id":"spn-40536","marks":["code"],"text":"deliberatic_open_round"}]},{"id":"blk-37250","spans":[{"id":"spn-40537","text":"Open a new deliberation round"}]}],[{"id":"blk-37251","spans":[{"id":"spn-40538","marks":["code"],"text":"deliberatic_submit_position"}]},{"id":"blk-37252","spans":[{"id":"spn-40539","text":"Submit a position with evidence"}]}],[{"id":"blk-37253","spans":[{"id":"spn-40540","marks":["code"],"text":"deliberatic_challenge"}]},{"id":"blk-37254","spans":[{"id":"spn-40541","text":"Challenge another agent's position"}]}],[{"id":"blk-37255","spans":[{"id":"spn-40542","marks":["code"],"text":"deliberatic_resolve"}]},{"id":"blk-37256","spans":[{"id":"spn-40543","text":"Trigger resolution and get verdict"}]}],[{"id":"blk-37257","spans":[{"id":"spn-40544","marks":["code"],"text":"deliberatic_query_evidence"}]},{"id":"blk-37258","spans":[{"id":"spn-40545","text":"Query evidence chains by round ID"}]}],[{"id":"blk-37259","spans":[{"id":"spn-40546","marks":["code"],"text":"deliberatic_get_reputation"}]},{"id":"blk-37260","spans":[{"id":"spn-40547","text":"Get agent reputation scores"}]}],[{"id":"blk-37261","spans":[{"id":"spn-40548","marks":["code"],"text":"deliberatic_amend_constitution"}]},{"id":"blk-37262","spans":[{"id":"spn-40549","text":"Propose constitutional amendment"}]}]]},{"id":"blk-37263","kind":"paragraph","spans":[{"id":"spn-40550","text":"---"}]},{"id":"blk-37264","kind":"heading","level":2,"spans":[{"id":"spn-40551","text":"Position in the [&] Ecosystem"}]},{"id":"blk-37265","kind":"paragraph","spans":[{"id":"spn-40552","text":"Deliberatic is the "},{"id":"spn-40553","marks":["bold"],"text":"decision layer"},{"id":"spn-40554","text":":"}]},{"head":[{"id":"blk-37267","spans":[{"id":"spn-40555","text":"Layer"}]},{"id":"blk-37268","spans":[{"id":"spn-40556","text":"Product"}]},{"id":"blk-37269","spans":[{"id":"spn-40557","text":"Role"}]}],"id":"blk-37266","kind":"table","rows":[[{"id":"blk-37270","spans":[{"id":"spn-40558","text":"Distribution"}]},{"id":"blk-37271","spans":[{"id":"spn-40559","text":"FleetPrompt"}]},{"id":"blk-37272","spans":[{"id":"spn-40560","text":"Agent runtime, skill execution"}]}],[{"id":"blk-37273","spans":[{"id":"spn-40561","text":"Standards"}]},{"id":"blk-37274","spans":[{"id":"spn-40562","text":"SpecPrompt"}]},{"id":"blk-37275","spans":[{"id":"spn-40563","text":"Execution specs, schema validation"}]}],[{"id":"blk-37276","spans":[{"id":"spn-40564","text":"Orchestration"}]},{"id":"blk-37277","spans":[{"id":"spn-40565","text":"Delegatic"}]},{"id":"blk-37278","spans":[{"id":"spn-40566","text":"Task routing, workflow graphs"}]}],[{"id":"blk-37279","spans":[{"id":"spn-40567","marks":["bold"],"text":"Decisions"}]},{"id":"blk-37280","spans":[{"id":"spn-40568","marks":["bold"],"text":"Deliberatic"}]},{"id":"blk-37281","spans":[{"id":"spn-40569","marks":["bold"],"text":"Argumentation, consensus, audit"}]}],[{"id":"blk-37282","spans":[{"id":"spn-40570","text":"Execution"}]},{"id":"blk-37283","spans":[{"id":"spn-40571","text":"AgenTroMatic"}]},{"id":"blk-37284","spans":[{"id":"spn-40572","text":"Autonomous task execution"}]}],[{"id":"blk-37285","spans":[{"id":"spn-40573","text":"Infrastructure"}]},{"id":"blk-37286","spans":[{"id":"spn-40574","text":"WebHost.Systems"}]},{"id":"blk-37287","spans":[{"id":"spn-40575","text":"Hosting, deployment"}]}],[{"id":"blk-37288","spans":[{"id":"spn-40576","text":"Spatial"}]},{"id":"blk-37289","spans":[{"id":"spn-40577","text":"GeoFleetic"}]},{"id":"blk-37290","spans":[{"id":"spn-40578","text":"Location-aware routing"}]}],[{"id":"blk-37291","spans":[{"id":"spn-40579","text":"Temporal"}]},{"id":"blk-37292","spans":[{"id":"spn-40580","text":"TickTickClock"}]},{"id":"blk-37293","spans":[{"id":"spn-40581","text":"Scheduling, deadlines"}]}]]},{"id":"blk-37294","kind":"paragraph","spans":[{"id":"spn-40582","text":"---"}]},{"id":"blk-37295","kind":"heading","level":2,"spans":[{"id":"spn-40583","text":"Project Links"}]},{"id":"blk-37296","items":[{"blocks":[{"id":"blk-37298","kind":"paragraph","spans":[{"id":"spn-40584","marks":["bold"],"text":"Spec:"},{"id":"spn-40585","text":" "},{"id":"spn-40586","marks":[{"kind":"link","predicate":"cites","target":"#/deliberatic.com/docs/spec/README.md"}],"text":"Protocol Specification"}]}],"id":"blk-37297","kind":"list-item"},{"blocks":[{"id":"blk-37300","kind":"paragraph","spans":[{"id":"spn-40587","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-40588","text":" "},{"id":"spn-40589","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-37299","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37301","kind":"paragraph","spans":[{"id":"spn-40590","text":"---"}]},{"id":"blk-37302","kind":"paragraph","spans":[{"id":"spn-40591","text":"*[&] Ampersand Box Design — deliberatic.com*"}]}],"edges":[],"id":"bagaaierapgzezyscj435eho6czl32uc5nfnfwrqshrxhzsj3n2a7oxf5bpsa","vocabulary":"ampersand.docs.fs.v1"}