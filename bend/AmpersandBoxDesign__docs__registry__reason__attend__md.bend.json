{"bendscript":"0.1","blocks":[{"id":"blk-9390","kind":"heading","level":1,"spans":[{"id":"spn-9035","marks":["code"],"text":"&reason.attend"},{"id":"spn-9036","text":" — Proactive Attention and Bounded Autonomy for the [&] Protocol"}]},{"id":"blk-9391","kind":"paragraph","spans":[{"id":"spn-9037","marks":["code"],"text":"&reason.attend"},{"id":"spn-9038","text":" is the capability page for the "},{"id":"spn-9039","marks":["code"],"text":"&reason.attend"},{"id":"spn-9040","text":" subtype in the [&] Protocol."}]},{"id":"blk-9392","kind":"paragraph","spans":[{"id":"spn-9041","text":"It represents a meta-reasoning surface for deciding "},{"id":"spn-9042","marks":["bold"],"text":"what should receive attention next"},{"id":"spn-9043","text":", under governance and budget constraints."}]},{"id":"blk-9393","kind":"paragraph","spans":[{"id":"spn-9044","text":"In short:"}]},{"blocks":[{"id":"blk-9395","kind":"paragraph","spans":[{"id":"spn-9045","marks":["code"],"text":"&reason.attend"},{"id":"spn-9046","text":" is the protocol capability for agents that should not only reason about a task, but also reason about "},{"id":"spn-9047","marks":["bold"],"text":"which tasks to prioritize, defer, escalate, or propose"},{"id":"spn-9048","text":"."}]}],"id":"blk-9394","kind":"quote"},{"id":"blk-9396","kind":"paragraph","spans":[{"id":"spn-9049","text":"---"}]},{"id":"blk-9397","kind":"heading","level":2,"spans":[{"id":"spn-9050","text":"1. Definition"}]},{"id":"blk-9398","kind":"paragraph","spans":[{"id":"spn-9051","marks":["code"],"text":"&reason.attend"},{"id":"spn-9052","text":" is a subtype of the "},{"id":"spn-9053","marks":["code"],"text":"&reason"},{"id":"spn-9054","text":" primitive."}]},{"id":"blk-9399","kind":"paragraph","spans":[{"id":"spn-9055","text":"It describes a capability that continuously or on-demand:"}]},{"id":"blk-9400","items":[{"blocks":[{"id":"blk-9402","kind":"paragraph","spans":[{"id":"spn-9056","text":"surveys active context and goals"}]}],"id":"blk-9401","kind":"list-item"},{"blocks":[{"id":"blk-9404","kind":"paragraph","spans":[{"id":"spn-9057","text":"triages attention candidates"}]}],"id":"blk-9403","kind":"list-item"},{"blocks":[{"id":"blk-9406","kind":"paragraph","spans":[{"id":"spn-9058","text":"dispatches bounded actions according to autonomy policy"}]}],"id":"blk-9405","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9407","kind":"paragraph","spans":[{"id":"spn-9059","text":"Typical outputs include:"}]},{"id":"blk-9408","items":[{"blocks":[{"id":"blk-9410","kind":"paragraph","spans":[{"id":"spn-9060","text":"ranked attention maps"}]}],"id":"blk-9409","kind":"list-item"},{"blocks":[{"id":"blk-9412","kind":"paragraph","spans":[{"id":"spn-9061","text":"dispatch decisions ("},{"id":"spn-9062","marks":["code"],"text":"explore"},{"id":"spn-9063","text":", "},{"id":"spn-9064","marks":["code"],"text":"focus"},{"id":"spn-9065","text":", "},{"id":"spn-9066","marks":["code"],"text":"act"},{"id":"spn-9067","text":", "},{"id":"spn-9068","marks":["code"],"text":"escalate"},{"id":"spn-9069","text":", "},{"id":"spn-9070","marks":["code"],"text":"propose"},{"id":"spn-9071","text":", "},{"id":"spn-9072","marks":["code"],"text":"idle"},{"id":"spn-9073","text":")"}]}],"id":"blk-9411","kind":"list-item"},{"blocks":[{"id":"blk-9414","kind":"paragraph","spans":[{"id":"spn-9074","text":"cycle results suitable for storage, audit, and later learning"}]}],"id":"blk-9413","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9415","kind":"paragraph","spans":[{"id":"spn-9075","text":"Unlike generic scheduling logic hidden in runtime code, "},{"id":"spn-9076","marks":["code"],"text":"&reason.attend"},{"id":"spn-9077","text":" makes this behavior explicit and composable."}]},{"id":"blk-9416","kind":"paragraph","spans":[{"id":"spn-9078","text":"---"}]},{"id":"blk-9417","kind":"heading","level":2,"spans":[{"id":"spn-9079","text":"2. Why this capability exists"}]},{"id":"blk-9418","kind":"paragraph","spans":[{"id":"spn-9080","text":"Many agent systems fail not because they cannot reason, but because they cannot "},{"id":"spn-9081","marks":["bold"],"text":"allocate reasoning effort"},{"id":"spn-9082","text":" well."}]},{"id":"blk-9419","kind":"paragraph","spans":[{"id":"spn-9083","text":"Real deployments need to answer:"}]},{"id":"blk-9420","items":[{"blocks":[{"id":"blk-9422","kind":"paragraph","spans":[{"id":"spn-9084","text":"Which goal is most urgent now?"}]}],"id":"blk-9421","kind":"list-item"},{"blocks":[{"id":"blk-9424","kind":"paragraph","spans":[{"id":"spn-9085","text":"Is coverage sufficient to act, or should we learn first?"}]}],"id":"blk-9423","kind":"list-item"},{"blocks":[{"id":"blk-9426","kind":"paragraph","spans":[{"id":"spn-9086","text":"Is this region cyclic/uncertain and requiring deeper deliberation?"}]}],"id":"blk-9425","kind":"list-item"},{"blocks":[{"id":"blk-9428","kind":"paragraph","spans":[{"id":"spn-9087","text":"Should we defer for approval, escalate, or proceed?"}]}],"id":"blk-9427","kind":"list-item"},{"blocks":[{"id":"blk-9430","kind":"paragraph","spans":[{"id":"spn-9088","text":"Are we within autonomy and budget constraints?"}]}],"id":"blk-9429","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9431","kind":"paragraph","spans":[{"id":"spn-9089","marks":["code"],"text":"&reason.attend"},{"id":"spn-9090","text":" exists so that these decisions are part of the protocol surface, not ad hoc internal glue."}]},{"id":"blk-9432","kind":"paragraph","spans":[{"id":"spn-9091","text":"This is especially important for:"}]},{"id":"blk-9433","items":[{"blocks":[{"id":"blk-9435","kind":"paragraph","spans":[{"id":"spn-9092","text":"long-running agents"}]}],"id":"blk-9434","kind":"list-item"},{"blocks":[{"id":"blk-9437","kind":"paragraph","spans":[{"id":"spn-9093","text":"multi-goal systems"}]}],"id":"blk-9436","kind":"list-item"},{"blocks":[{"id":"blk-9439","kind":"paragraph","spans":[{"id":"spn-9094","text":"cost-constrained deployments"}]}],"id":"blk-9438","kind":"list-item"},{"blocks":[{"id":"blk-9441","kind":"paragraph","spans":[{"id":"spn-9095","text":"safety-sensitive domains requiring escalation policy"}]}],"id":"blk-9440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9442","kind":"paragraph","spans":[{"id":"spn-9096","text":"---"}]},{"id":"blk-9443","kind":"heading","level":2,"spans":[{"id":"spn-9097","text":"3. Where it fits in the protocol"}]},{"id":"blk-9444","kind":"paragraph","spans":[{"id":"spn-9098","text":"The [&] Protocol organizes cognition, embodiment, and governance into six primitive families:"}]},{"id":"blk-9445","items":[{"blocks":[{"id":"blk-9447","kind":"paragraph","spans":[{"id":"spn-9099","marks":["code"],"text":"&memory"},{"id":"spn-9100","text":" — what the agent knows"}]}],"id":"blk-9446","kind":"list-item"},{"blocks":[{"id":"blk-9449","kind":"paragraph","spans":[{"id":"spn-9101","marks":["code"],"text":"&reason"},{"id":"spn-9102","text":" — how the agent decides"}]}],"id":"blk-9448","kind":"list-item"},{"blocks":[{"id":"blk-9451","kind":"paragraph","spans":[{"id":"spn-9103","marks":["code"],"text":"&time"},{"id":"spn-9104","text":" — when things happen"}]}],"id":"blk-9450","kind":"list-item"},{"blocks":[{"id":"blk-9453","kind":"paragraph","spans":[{"id":"spn-9105","marks":["code"],"text":"&space"},{"id":"spn-9106","text":" — where things are"}]}],"id":"blk-9452","kind":"list-item"},{"blocks":[{"id":"blk-9455","kind":"paragraph","spans":[{"id":"spn-9107","marks":["code"],"text":"&body"},{"id":"spn-9108","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-9454","kind":"list-item"},{"blocks":[{"id":"blk-9457","kind":"paragraph","spans":[{"id":"spn-9109","marks":["code"],"text":"&govern"},{"id":"spn-9110","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-9456","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9458","kind":"paragraph","spans":[{"id":"spn-9111","marks":["code"],"text":"&reason.attend"},{"id":"spn-9112","text":" sits under "},{"id":"spn-9113","marks":["code"],"text":"&reason"},{"id":"spn-9114","text":" and complements local decision subtypes by adding "},{"id":"spn-9115","marks":["bold"],"text":"meta-level control"},{"id":"spn-9116","text":":"}]},{"id":"blk-9459","items":[{"blocks":[{"id":"blk-9461","kind":"paragraph","spans":[{"id":"spn-9117","marks":["code"],"text":"&reason.argument"},{"id":"spn-9118","text":" helps decide *between options*"}]}],"id":"blk-9460","kind":"list-item"},{"blocks":[{"id":"blk-9463","kind":"paragraph","spans":[{"id":"spn-9119","marks":["code"],"text":"&reason.plan"},{"id":"spn-9120","text":" helps decide *sequences of actions*"}]}],"id":"blk-9462","kind":"list-item"},{"blocks":[{"id":"blk-9465","kind":"paragraph","spans":[{"id":"spn-9121","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-9122","text":" helps reason through *cyclic dependencies*"}]}],"id":"blk-9464","kind":"list-item"},{"blocks":[{"id":"blk-9467","kind":"paragraph","spans":[{"id":"spn-9123","marks":["code"],"text":"&reason.attend"},{"id":"spn-9124","text":" helps decide *what to reason or act on next*"}]}],"id":"blk-9466","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9468","kind":"paragraph","spans":[{"id":"spn-9125","text":"---"}]},{"id":"blk-9469","kind":"heading","level":2,"spans":[{"id":"spn-9126","text":"4. Capability contract"}]},{"id":"blk-9470","kind":"paragraph","spans":[{"id":"spn-9127","text":"A representative contract for "},{"id":"spn-9128","marks":["code"],"text":"&reason.attend"},{"id":"spn-9129","text":":"}]},{"id":"blk-9471","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&reason.attend\",\n  \"provider\": \"graphonomous\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Proactive attention contract for surveying active goals, triaging epistemic gaps, and dispatching bounded autonomy actions.\",\n  \"operations\": {\n    \"survey\": {\n      \"in\": \"context\",\n      \"out\": \"attention_map\",\n      \"description\": \"Build a ranked attention map from active goals, coverage assessments, and topology signals.\"\n    },\n    \"triage\": {\n      \"in\": \"attention_map\",\n      \"out\": \"attention_map\",\n      \"description\": \"Assign urgency, gap scores, and dispatch modes to attention items under governance and budget constraints.\"\n    },\n    \"dispatch\": {\n      \"in\": \"attention_map\",\n      \"out\": \"attention_cycle\",\n      \"description\": \"Execute or defer bounded explore/focus/act/escalate/propose dispatches according to autonomy level.\"\n    }\n  }\n}"},{"id":"blk-9472","kind":"paragraph","spans":[{"id":"spn-9130","text":"---"}]},{"id":"blk-9473","kind":"heading","level":2,"spans":[{"id":"spn-9131","text":"5. Operations"}]},{"id":"blk-9474","kind":"heading","level":3,"spans":[{"id":"spn-9132","marks":["code"],"text":"survey(context) -> attention_map"}]},{"id":"blk-9475","kind":"paragraph","spans":[{"id":"spn-9133","text":"Builds a ranked set of attention candidates from available context, for example:"}]},{"id":"blk-9476","items":[{"blocks":[{"id":"blk-9478","kind":"paragraph","spans":[{"id":"spn-9134","text":"active goals"}]}],"id":"blk-9477","kind":"list-item"},{"blocks":[{"id":"blk-9480","kind":"paragraph","spans":[{"id":"spn-9135","text":"retrieval signals"}]}],"id":"blk-9479","kind":"list-item"},{"blocks":[{"id":"blk-9482","kind":"paragraph","spans":[{"id":"spn-9136","text":"coverage assessments"}]}],"id":"blk-9481","kind":"list-item"},{"blocks":[{"id":"blk-9484","kind":"paragraph","spans":[{"id":"spn-9137","text":"topology/κ signals"}]}],"id":"blk-9483","kind":"list-item"},{"blocks":[{"id":"blk-9486","kind":"paragraph","spans":[{"id":"spn-9138","text":"recent outcomes"}]}],"id":"blk-9485","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9487","kind":"heading","level":3,"spans":[{"id":"spn-9139","marks":["code"],"text":"triage(attention_map) -> attention_map"}]},{"id":"blk-9488","kind":"paragraph","spans":[{"id":"spn-9140","text":"Annotates and reorders attention items with fields such as:"}]},{"id":"blk-9489","items":[{"blocks":[{"id":"blk-9491","kind":"paragraph","spans":[{"id":"spn-9141","text":"urgency"}]}],"id":"blk-9490","kind":"list-item"},{"blocks":[{"id":"blk-9493","kind":"paragraph","spans":[{"id":"spn-9142","text":"epistemic gap"}]}],"id":"blk-9492","kind":"list-item"},{"blocks":[{"id":"blk-9495","kind":"paragraph","spans":[{"id":"spn-9143","text":"confidence/risk notes"}]}],"id":"blk-9494","kind":"list-item"},{"blocks":[{"id":"blk-9497","kind":"paragraph","spans":[{"id":"spn-9144","text":"selected dispatch mode"}]}],"id":"blk-9496","kind":"list-item"},{"blocks":[{"id":"blk-9499","kind":"paragraph","spans":[{"id":"spn-9145","text":"bounded rationale"}]}],"id":"blk-9498","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9500","kind":"heading","level":3,"spans":[{"id":"spn-9146","marks":["code"],"text":"dispatch(attention_map) -> attention_cycle"}]},{"id":"blk-9501","kind":"paragraph","spans":[{"id":"spn-9147","text":"Executes or defers actions under policy and budget:"}]},{"id":"blk-9502","items":[{"blocks":[{"id":"blk-9504","kind":"paragraph","spans":[{"id":"spn-9148","marks":["code"],"text":"explore"},{"id":"spn-9149","text":" — enrich memory/coverage"}]}],"id":"blk-9503","kind":"list-item"},{"blocks":[{"id":"blk-9506","kind":"paragraph","spans":[{"id":"spn-9150","marks":["code"],"text":"focus"},{"id":"spn-9151","text":" — invoke deeper deliberation"}]}],"id":"blk-9505","kind":"list-item"},{"blocks":[{"id":"blk-9508","kind":"paragraph","spans":[{"id":"spn-9152","marks":["code"],"text":"act"},{"id":"spn-9153","text":" — execute bounded action"}]}],"id":"blk-9507","kind":"list-item"},{"blocks":[{"id":"blk-9510","kind":"paragraph","spans":[{"id":"spn-9154","marks":["code"],"text":"escalate"},{"id":"spn-9155","text":" — defer to higher-trust/human path"}]}],"id":"blk-9509","kind":"list-item"},{"blocks":[{"id":"blk-9512","kind":"paragraph","spans":[{"id":"spn-9156","marks":["code"],"text":"propose"},{"id":"spn-9157","text":" — suggest new goal (if allowed)"}]}],"id":"blk-9511","kind":"list-item"},{"blocks":[{"id":"blk-9514","kind":"paragraph","spans":[{"id":"spn-9158","marks":["code"],"text":"idle"},{"id":"spn-9159","text":" — no action"}]}],"id":"blk-9513","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9515","kind":"paragraph","spans":[{"id":"spn-9160","text":"---"}]},{"id":"blk-9516","kind":"heading","level":2,"spans":[{"id":"spn-9161","text":"6. Architecture pattern"}]},{"id":"blk-9517","kind":"paragraph","spans":[{"id":"spn-9162","text":"A common proactive loop:"}]},{"id":"blk-9518","kind":"code","language":"text","text":"heartbeat\n  |> &reason.attend.survey()\n  |> &reason.attend.triage()\n  |> &reason.attend.dispatch()\n  |> &memory.graph.store()"},{"id":"blk-9519","kind":"paragraph","spans":[{"id":"spn-9163","text":"A common demand-triggered loop (constrained tier):"}]},{"id":"blk-9520","kind":"code","language":"text","text":"query\n  |> &memory.graph.recall()\n  |> &memory.graph.topology()\n  |> &reason.attend.survey()\n  |> &reason.attend.dispatch()"},{"id":"blk-9521","kind":"paragraph","spans":[{"id":"spn-9164","text":"Interpretation:"}]},{"id":"blk-9522","items":[{"blocks":[{"id":"blk-9524","kind":"paragraph","spans":[{"id":"spn-9165","text":"survey/triage gives explicit prioritization"}]}],"id":"blk-9523","kind":"list-item"},{"blocks":[{"id":"blk-9526","kind":"paragraph","spans":[{"id":"spn-9166","text":"dispatch is budgeted and governed"}]}],"id":"blk-9525","kind":"list-item"},{"blocks":[{"id":"blk-9528","kind":"paragraph","spans":[{"id":"spn-9167","text":"cycle artifacts can be persisted for provenance and learning feedback"}]}],"id":"blk-9527","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9529","kind":"paragraph","spans":[{"id":"spn-9168","text":"---"}]},{"id":"blk-9530","kind":"heading","level":2,"spans":[{"id":"spn-9169","text":"7. Example declaration snippet ("},{"id":"spn-9170","marks":["code"],"text":"ampersand.json"},{"id":"spn-9171","text":")"}]},{"id":"blk-9531","kind":"code","language":"json","text":"{\n  \"capabilities\": {\n    \"&reason.attend\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  },\n  \"governance\": {\n    \"autonomy\": {\n      \"level\": \"advise\",\n      \"model_tier\": \"local_small\",\n      \"heartbeat_seconds\": 300,\n      \"budget\": {\n        \"max_actions_per_hour\": 5,\n        \"max_deliberation_calls_per_query\": 1,\n        \"require_approval_for\": [\"act\", \"propose\"]\n      }\n    }\n  }\n}"},{"id":"blk-9532","kind":"paragraph","spans":[{"id":"spn-9172","text":"---"}]},{"id":"blk-9533","kind":"heading","level":2,"spans":[{"id":"spn-9173","text":"8. Governance implications"}]},{"id":"blk-9534","kind":"paragraph","spans":[{"id":"spn-9174","marks":["code"],"text":"&reason.attend"},{"id":"spn-9175","text":" is where autonomy policy becomes operational."}]},{"id":"blk-9535","kind":"paragraph","spans":[{"id":"spn-9176","text":"Relevant governance fields:"}]},{"id":"blk-9536","items":[{"blocks":[{"id":"blk-9538","kind":"paragraph","spans":[{"id":"spn-9177","marks":["code"],"text":"hard"},{"id":"spn-9178","text":" / "},{"id":"spn-9179","marks":["code"],"text":"soft"}]}],"id":"blk-9537","kind":"list-item"},{"blocks":[{"id":"blk-9540","kind":"paragraph","spans":[{"id":"spn-9180","marks":["code"],"text":"escalate_when"}]}],"id":"blk-9539","kind":"list-item"},{"blocks":[{"id":"blk-9542","kind":"paragraph","spans":[{"id":"spn-9181","marks":["code"],"text":"autonomy.level"},{"id":"spn-9182","text":" ("},{"id":"spn-9183","marks":["code"],"text":"observe"},{"id":"spn-9184","text":", "},{"id":"spn-9185","marks":["code"],"text":"advise"},{"id":"spn-9186","text":", "},{"id":"spn-9187","marks":["code"],"text":"act"},{"id":"spn-9188","text":")"}]}],"id":"blk-9541","kind":"list-item"},{"blocks":[{"id":"blk-9544","kind":"paragraph","spans":[{"id":"spn-9189","marks":["code"],"text":"autonomy.model_tier"},{"id":"spn-9190","text":" ("},{"id":"spn-9191","marks":["code"],"text":"local_small"},{"id":"spn-9192","text":", "},{"id":"spn-9193","marks":["code"],"text":"local_large"},{"id":"spn-9194","text":", "},{"id":"spn-9195","marks":["code"],"text":"cloud_frontier"},{"id":"spn-9196","text":")"}]}],"id":"blk-9543","kind":"list-item"},{"blocks":[{"id":"blk-9546","kind":"paragraph","spans":[{"id":"spn-9197","marks":["code"],"text":"autonomy.heartbeat_seconds"}]}],"id":"blk-9545","kind":"list-item"},{"blocks":[{"id":"blk-9548","kind":"paragraph","spans":[{"id":"spn-9198","marks":["code"],"text":"autonomy.budget"},{"id":"spn-9199","text":" controls"}]}],"id":"blk-9547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9549","kind":"paragraph","spans":[{"id":"spn-9200","text":"Typical effect:"}]},{"id":"blk-9550","items":[{"blocks":[{"id":"blk-9552","kind":"paragraph","spans":[{"id":"spn-9201","marks":["code"],"text":"observe"},{"id":"spn-9202","text":" → survey/triage only, no execution"}]}],"id":"blk-9551","kind":"list-item"},{"blocks":[{"id":"blk-9554","kind":"paragraph","spans":[{"id":"spn-9203","marks":["code"],"text":"advise"},{"id":"spn-9204","text":" → propose actions, wait for approval"}]}],"id":"blk-9553","kind":"list-item"},{"blocks":[{"id":"blk-9556","kind":"paragraph","spans":[{"id":"spn-9205","marks":["code"],"text":"act"},{"id":"spn-9206","text":" → execute bounded actions inside policy limits"}]}],"id":"blk-9555","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9557","kind":"paragraph","spans":[{"id":"spn-9207","text":"---"}]},{"id":"blk-9558","kind":"heading","level":2,"spans":[{"id":"spn-9208","text":"9. Provenance implications"}]},{"id":"blk-9559","kind":"paragraph","spans":[{"id":"spn-9209","text":"Attention decisions should be auditable."}]},{"id":"blk-9560","kind":"paragraph","spans":[{"id":"spn-9210","text":"A useful provenance chain should preserve:"}]},{"id":"blk-9561","items":[{"blocks":[{"id":"blk-9563","kind":"paragraph","spans":[{"id":"spn-9211","text":"source context used for survey/triage"}]}],"id":"blk-9562","kind":"list-item"},{"blocks":[{"id":"blk-9565","kind":"paragraph","spans":[{"id":"spn-9212","text":"selected mode and rationale"}]}],"id":"blk-9564","kind":"list-item"},{"blocks":[{"id":"blk-9567","kind":"paragraph","spans":[{"id":"spn-9213","text":"governance/autonomy state at dispatch time"}]}],"id":"blk-9566","kind":"list-item"},{"blocks":[{"id":"blk-9569","kind":"paragraph","spans":[{"id":"spn-9214","text":"output cycle summary and timestamps"}]}],"id":"blk-9568","kind":"list-item"},{"blocks":[{"id":"blk-9571","kind":"paragraph","spans":[{"id":"spn-9215","text":"links to any resulting memory writes or action outcomes"}]}],"id":"blk-9570","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9572","kind":"paragraph","spans":[{"id":"spn-9216","text":"This makes it possible to answer:"}]},{"id":"blk-9573","items":[{"blocks":[{"id":"blk-9575","kind":"paragraph","spans":[{"id":"spn-9217","text":"Why was this goal prioritized?"}]}],"id":"blk-9574","kind":"list-item"},{"blocks":[{"id":"blk-9577","kind":"paragraph","spans":[{"id":"spn-9218","text":"Why was action deferred/escalated?"}]}],"id":"blk-9576","kind":"list-item"},{"blocks":[{"id":"blk-9579","kind":"paragraph","spans":[{"id":"spn-9219","text":"Which policy or budget boundary affected dispatch?"}]}],"id":"blk-9578","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9580","kind":"paragraph","spans":[{"id":"spn-9220","text":"---"}]},{"id":"blk-9581","kind":"heading","level":2,"spans":[{"id":"spn-9221","text":"10. MCP and A2A implications"}]},{"id":"blk-9582","kind":"heading","level":3,"spans":[{"id":"spn-9222","text":"MCP"}]},{"id":"blk-9583","kind":"paragraph","spans":[{"id":"spn-9223","text":"A provider may expose tool surfaces such as:"}]},{"id":"blk-9584","items":[{"blocks":[{"id":"blk-9586","kind":"paragraph","spans":[{"id":"spn-9224","marks":["code"],"text":"attention_survey"}]}],"id":"blk-9585","kind":"list-item"},{"blocks":[{"id":"blk-9588","kind":"paragraph","spans":[{"id":"spn-9225","marks":["code"],"text":"attention_run_cycle"}]}],"id":"blk-9587","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9589","kind":"paragraph","spans":[{"id":"spn-9226","text":"These allow external runtimes or operators to inspect and trigger attention behavior without custom APIs."}]},{"id":"blk-9590","kind":"heading","level":3,"spans":[{"id":"spn-9227","text":"A2A"}]},{"id":"blk-9591","kind":"paragraph","spans":[{"id":"spn-9228","marks":["code"],"text":"&reason.attend"},{"id":"spn-9229","text":" commonly maps to skill identifiers like:"}]},{"id":"blk-9592","items":[{"blocks":[{"id":"blk-9594","kind":"paragraph","spans":[{"id":"spn-9230","marks":["code"],"text":"proactive-attention"}]}],"id":"blk-9593","kind":"list-item"},{"blocks":[{"id":"blk-9596","kind":"paragraph","spans":[{"id":"spn-9231","marks":["code"],"text":"autonomous-planning"}]}],"id":"blk-9595","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9597","kind":"paragraph","spans":[{"id":"spn-9232","text":"This allows agent-to-agent systems to discover and delegate attention orchestration capabilities explicitly."}]},{"id":"blk-9598","kind":"paragraph","spans":[{"id":"spn-9233","text":"---"}]},{"id":"blk-9599","kind":"heading","level":2,"spans":[{"id":"spn-9234","text":"11. Anti-patterns"}]},{"id":"blk-9600","kind":"paragraph","spans":[{"id":"spn-9235","text":"Common mistakes when modeling "},{"id":"spn-9236","marks":["code"],"text":"&reason.attend"},{"id":"spn-9237","text":":"}]},{"id":"blk-9601","kind":"paragraph","spans":[{"id":"spn-9238","text":"1. Treating attention as hidden scheduler logic with no contract. 2. Executing actions in autonomous mode without declared budget bounds. 3. Collapsing "},{"id":"spn-9239","marks":["code"],"text":