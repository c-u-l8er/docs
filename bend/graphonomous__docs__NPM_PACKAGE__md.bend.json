{"bendscript":"0.1","blocks":[{"id":"blk-39855","kind":"heading","level":1,"spans":[{"id":"spn-43824","text":"graphonomous — NPM Package Specification"}]},{"id":"blk-39856","kind":"paragraph","spans":[{"id":"spn-43825","marks":["bold"],"text":"Package"},{"id":"spn-43826","text":": "},{"id":"spn-43827","marks":["code"],"text":"graphonomous"},{"id":"spn-43828","text":" "},{"id":"spn-43829","marks":["bold"],"text":"Version"},{"id":"spn-43830","text":": "},{"id":"spn-43831","marks":["code"],"text":"0.4.0"},{"id":"spn-43832","text":" (current) → "},{"id":"spn-43833","marks":["code"],"text":"0.4.1"},{"id":"spn-43834","text":" (three-package alignment bump) "},{"id":"spn-43835","marks":["bold"],"text":"Language"},{"id":"spn-43836","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-43837","marks":["bold"],"text":"License"},{"id":"spn-43838","text":": Apache-2.0 "},{"id":"spn-43839","marks":["bold"],"text":"Registry"},{"id":"spn-43840","text":": https://www.npmjs.com/package/graphonomous "},{"id":"spn-43841","marks":["bold"],"text":"Repository"},{"id":"spn-43842","text":": "},{"id":"spn-43843","marks":["code"],"text":"AmpersandBoxDesign/graphonomous"},{"id":"spn-43844","text":" (monorepo subdir)"}]},{"id":"blk-39857","kind":"heading","level":2,"spans":[{"id":"spn-43845","text":"Purpose"}]},{"id":"blk-39858","kind":"paragraph","spans":[{"id":"spn-43846","marks":["code"],"text":"graphonomous"},{"id":"spn-43847","text":" is the MCP server for the continual learning engine. It exposes the 5 Graphonomous loop-phase machines ("},{"id":"spn-43848","marks":["code"],"text":"retrieve"},{"id":"spn-43849","text":", "},{"id":"spn-43850","marks":["code"],"text":"route"},{"id":"spn-43851","text":", "},{"id":"spn-43852","marks":["code"],"text":"act"},{"id":"spn-43853","text":", "},{"id":"spn-43854","marks":["code"],"text":"learn"},{"id":"spn-43855","text":", "},{"id":"spn-43856","marks":["code"],"text":"consolidate"},{"id":"spn-43857","text":") over stdio and persists knowledge in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-39859","kind":"paragraph","spans":[{"id":"spn-43858","text":"This package already ships at v0.4.0 and serves as the "},{"id":"spn-43859","marks":["bold"],"text":"template"},{"id":"spn-43860","text":" for the other two packages in the three-package MCP stack. A v0.4.1 bump is required to:"}]},{"id":"blk-39860","kind":"paragraph","spans":[{"id":"spn-43861","text":"1. Update the package description to name the 5-machine surface (no more \"28 tools\" wording — the v1 tool surface is now legacy). 2. Update the README to reference the three-package install story. 3. Publish a "},{"id":"spn-43862","marks":["code"],"text":"graphonomous.continual_learning.pulse.json"},{"id":"spn-43863","text":" manifest so "},{"id":"spn-43864","marks":["code"],"text":"os-prism"},{"id":"spn-43865","text":" can benchmark against a canonical PULSE manifest. 4. Register itself with a running "},{"id":"spn-43866","marks":["code"],"text":"os-pulse"},{"id":"spn-43867","text":" instance at startup if one is configured (optional)."}]},{"id":"blk-39861","kind":"paragraph","spans":[{"id":"spn-43868","text":"No Elixir code changes are required. The existing vendored escript at "},{"id":"spn-43869","marks":["code"],"text":"graphonomous/npm/vendor/"},{"id":"spn-43870","text":" and the existing postinstall script continue to work."}]},{"id":"blk-39862","kind":"heading","level":2,"spans":[{"id":"spn-43871","text":"Install"}]},{"id":"blk-39863","kind":"code","language":"bash","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db"},{"id":"blk-39864","kind":"paragraph","spans":[{"id":"spn-43872","text":"Or in "},{"id":"spn-43873","marks":["code"],"text":".mcp.json"},{"id":"spn-43874","text":":"}]},{"id":"blk-39865","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"]\n    }\n  }\n}"},{"id":"blk-39866","kind":"heading","level":2,"spans":[{"id":"spn-43875","text":"MCP Surface — 5 Loop-Phase Machines"}]},{"head":[{"id":"blk-39868","spans":[{"id":"spn-43876","text":"Machine"}]},{"id":"blk-39869","spans":[{"id":"spn-43877","text":"Phase"}]},{"id":"blk-39870","spans":[{"id":"spn-43878","text":"Actions"}]}],"id":"blk-39867","kind":"table","rows":[[{"id":"blk-39871","spans":[{"id":"spn-43879","marks":["code"],"text":"retrieve"}]},{"id":"blk-39872","spans":[{"id":"spn-43880","text":"\"What do I know?\""}]},{"id":"blk-39873","spans":[{"id":"spn-43881","marks":["code"],"text":"context"},{"id":"spn-43882","text":", "},{"id":"spn-43883","marks":["code"],"text":"episodic"},{"id":"spn-43884","text":", "},{"id":"spn-43885","marks":["code"],"text":"procedural"},{"id":"spn-43886","text":", "},{"id":"spn-43887","marks":["code"],"text":"coverage"},{"id":"spn-43888","text":", "},{"id":"spn-43889","marks":["code"],"text":"trace_evidence"},{"id":"spn-43890","text":", "},{"id":"spn-43891","marks":["code"],"text":"frontier"}]}],[{"id":"blk-39874","spans":[{"id":"spn-43892","marks":["code"],"text":"route"}]},{"id":"blk-39875","spans":[{"id":"spn-43893","text":"\"What should I do?\""}]},{"id":"blk-39876","spans":[{"id":"spn-43894","marks":["code"],"text":"topology"},{"id":"spn-43895","text":", "},{"id":"spn-43896","marks":["code"],"text":"deliberate"},{"id":"spn-43897","text":", "},{"id":"spn-43898","marks":["code"],"text":"attention_survey"},{"id":"spn-43899","text":", "},{"id":"spn-43900","marks":["code"],"text":"attention_cycle"},{"id":"spn-43901","text":", "},{"id":"spn-43902","marks":["code"],"text":"review_goal"}]}],[{"id":"blk-39877","spans":[{"id":"spn-43903","marks":["code"],"text":"act"}]},{"id":"blk-39878","spans":[{"id":"spn-43904","text":"\"Do it\""}]},{"id":"blk-39879","spans":[{"id":"spn-43905","marks":["code"],"text":"store_node"},{"id":"spn-43906","text":", "},{"id":"spn-43907","marks":["code"],"text":"store_edge"},{"id":"spn-43908","text":",