{"id":"spn-44964","text":"This makes Graphonomous interoperable with MCP-capable assistants, editors, and agent runtimes."}]},{"id":"blk-40853","kind":"paragraph","spans":[{"id":"spn-44965","text":"---"}]},{"id":"blk-40854","kind":"heading","level":2,"spans":[{"id":"spn-44966","text":"Architectural Properties"}]},{"id":"blk-40855","items":[{"blocks":[{"id":"blk-40857","kind":"paragraph","spans":[{"id":"spn-44967","marks":["bold"],"text":"Modular"},{"id":"spn-44968","text":": clear boundaries between storage, retrieval, learning, and orchestration"}]}],"id":"blk-40856","kind":"list-item"},{"blocks":[{"id":"blk-40859","kind":"paragraph","spans":[{"id":"spn-44969","marks":["bold"],"text":"Causal"},{"id":"spn-44970","text":": outcome feedback updates the exact nodes used for decisions"}]}],"id":"blk-40858","kind":"list-item"},{"blocks":[{"id":"blk-40861","kind":"paragraph","spans":[{"id":"spn-44971","marks":["bold"],"text":"Topology-aware"},{"id":"spn-44972","text":": can detect when simple retrieval is insufficient"}]}],"id":"blk-40860","kind":"list-item"},{"blocks":[{"id":"blk-40863","kind":"paragraph","spans":[{"id":"spn-44973","marks":["bold"],"text":"Durable"},{"id":"spn-44974","text":": goals and memory survive process and session boundaries"}]}],"id":"blk-40862","kind":"list-item"},{"blocks":[{"id":"blk-40865","kind":"paragraph","spans":[{"id":"spn-44975","marks":["bold"],"text":"Operationally practical"},{"id":"spn-44976","text":": local DB + supervised services + MCP transport"}]}],"id":"blk-40864","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40866","kind":"paragraph","spans":[{"id":"spn-44977","text":"---"}]},{"id":"blk-40867","kind":"heading","level":2,"spans":[{"id":"spn-44978","text":"Practical Mental Model"}]},{"id":"blk-40868","kind":"paragraph","spans":[{"id":"spn-44979","text":"You can think of Graphonomous as:"}]},{"id":"blk-40869","kind":"paragraph","spans":[{"id":"spn-44980","text":"1. a "},{"id":"spn-44981","marks":["bold"],"text":