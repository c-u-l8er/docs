],"id":"blk-40738","kind":"list-item"},{"blocks":[{"id":"blk-40741","kind":"paragraph","spans":[{"id":"spn-44864","text":"Legacy aliases: "},{"id":"spn-44865","marks":["code"],"text":"causal"},{"id":"spn-44866","text":", "},{"id":"spn-44867","marks":["code"],"text":"related"},{"id":"spn-44868","text":" (backward-compatible)"}]}],"id":"blk-40740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40742","kind":"paragraph","spans":[{"id":"spn-44869","text":"Each edge carries a weight ("},{"id":"spn-44870","marks":["code"],"text":"0.0..1.0"},{"id":"spn-44871","text":", default 0.3), optional "},{"id":"spn-44872","marks":["code"],"text":"co_activation_count"},{"id":"spn-44873","text":", and "},{"id":"spn-44874","marks":["code"],"text":"decay_rate"},{"id":"spn-44875","text":"."}]},{"id":"blk-40743","kind":"paragraph","spans":[{"id":"spn-44876","text":"---"}]},{"id":"blk-40744","kind":"heading","level":2,"spans":[{"id":"spn-44877","text":"Persistence Layer"}]},{"id":"blk-40745","kind":"paragraph","spans":[{"id":"spn-44878","marks":["code"],"text":"Store"},{"id":"spn-44879","text":" provides:"}]},{"id":"blk-40746","items":[{"blocks":[{"id":"blk-40748","kind":"paragraph","spans":[{"id":"spn-44880","marks":["bold"],"text":"SQLite durability"},{"id":"spn-44881","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-40747","kind":"list-item"},{"blocks":[{"id":"blk-40750","kind":"paragraph","spans":[{"id":"spn-44882","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-44883","text":" for low-latency reads"}]}],"id":"blk-40749","kind":"list-item"},{"blocks":[{"id":"blk-40752","kind":"paragraph","spans":[{"id":"spn-44884","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-40751","kind":"list-item"},{"blocks":[{"id":"blk-40754","kind":"paragraph","spans":[{"id":"spn-44885","text":"cache warm-up from durable state after boot"}]}],"id":"blk-40753","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40755","kind":"paragraph","spans":[{"id":"spn-44886","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-40756","kind":"paragraph","spans":[{"id":"spn-44887","text":"---"}]},{"id":"blk-40757","kind":"heading","level":2,"spans":[{"id":"spn-44888","text":"Retrieval Pipeline"}]},{"id":"blk-40758","kind":"paragraph","spans":[{"id":"spn-44889","marks":["code"],"text":"Retriever"},{"id":"spn-44890","text":" executes a multi-step pipeline:"}]},{"id":"blk-40759","kind":"paragraph","spans":[{"id":"spn-44891","text":"1. Semantic similarity search (seed candidates) 2. Graph neighborhood expansion (bounded hops) 3. Confidence-aware ranking 4. Topology analysis over the retrieved subgraph 5. Return context with:"}]},{"id":"blk-40760","items":[{"blocks":[{"id":"blk-40762","kind":"paragraph","spans":[{"id":"spn-44892","text":"ranked results"}]}],"id":"blk-40761","kind":"list-item"},{"blocks":[{"id":"blk-40764","kind":"paragraph","spans":[{"id":"spn-44893","text":"causal context IDs"}]}],"id":"blk-40763","kind":"list-item"},{"blocks":[{"id":"blk-40766","kind":"paragraph","spans":[{"id":"spn-44894","text":"topology routing hint ("},{"id":"spn-44895","marks":["code"],"text":"fast"},{"id":"spn-44896","text":" or "},{"id":"spn-44897","marks":["code"],"text":"deliberate"},{"id":"spn-44898","text":")"}]}],"id":"blk-40765","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40767","kind":"paragraph","spans":[{"id":"spn-44899","text":"This provides both relevant memory and structural signal for downstream reasoning."}]},{"id":"blk-40768","kind":"paragraph","spans":[{"id":"spn-44900","text":"---"}]},{"id":"blk-40769","kind":"heading","level":2,"spans":[{"id":"spn-44901","text":"Topology and Deliberation"}]},{"id":"blk-40770","kind":"paragraph","spans":[{"id":"spn-44902","text":"Graphonomous computes SCC/topology properties and a κ-style complexity signal to identify cyclic reasoning regions."}]},{"id":"blk-40771","items":[{"blocks":[{"id":"blk-40773","kind":"paragraph","spans":[{"id":"spn-44903","marks":["bold"],"text":"`fast` routing"},{"id":"spn-44904","text":": low cycle complexity, proceed with normal retrieval flow"}]}],"id":"blk-40772","kind":"list-item"},{"blocks":[{"id":"blk-40775","kind":"paragraph","spans":[{"id":"spn-44905","marks":["bold"],"text":"`deliberate` routing"},{"id":"spn-44906","text":": cyclic/entangled subgraph, invoke deeper structured deliberation"}]}],"id":"blk-40774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40776","kind":"paragraph","spans":[{"id":"spn-44907","marks":["code"],"text":"Deliberator"},{"id":"spn-44908","text":" can decompose cyclic regions, analyze fault-line edges, reconcile conclusions, and optionally write conclusions back into the graph."}]},{"id":"blk-40777","kind":"paragraph","spans":[{"id":"spn-44909","text":"---"}]},{"id":"blk-40778","kind":"heading","level":2,"spans":[{"id":"spn-44910","text":"Learning Loop"}]},{"id":"blk-40779","kind":"paragraph","spans":[{"id":"spn-44911","marks":["code"],"text":"Learner"},{"id":"spn-44912","text":" closes the causal feedback loop:"}]},{"id":"blk-40780","kind":"paragraph","spans":[{"id":"spn-44913","text":"1. Persist action outcome 2. Update confidence on causal source nodes"}]},{"id":"blk-40781","kind":"paragraph","spans":[{"id":"spn-44914","text":"Status signals include:"}]},{"id":"blk-40782","items":[{"blocks":[{"id":"blk-40784","kind":"paragraph","spans":[{"id":"spn-44915","marks":["code"],"text":"success"}]}],"id":"blk-40783","kind":"list-item"},{"blocks":[{"id":"blk-40786","kind":"paragraph","spans":[{"id":"spn-44916","marks":["code"],"text":"partial_success"}]}],"id":"blk-40785","kind":"list-item"},{"blocks":[{"id":"blk-40788","kind":"paragraph","spans":[{"id":"spn-44917","marks":["code"],"text":"failure"}]}],"id":"blk-40787","kind":"list-item"},{"blocks":[{"id":"blk-40790","kind":"paragraph","spans":[{"id":"spn-44918","marks":["code"],"text":"timeout"}]}],"id":"blk-40789","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40791","kind":"paragraph","spans":[{"id":"spn-44919","text":"Confidence updates are blended with a learning-rate rule, so the graph continuously calibrates itself over real outcomes instead of static assumptions."}]},{"id":"blk-40792","kind":"paragraph","spans":[{"id":"spn-44920","text":"---"}]},{"id":"blk-40793","kind":"heading","level":2,"spans":[{"id":"spn-44921","text":"Goal and Epistemic Control Plane"}]},{"id":"blk-40794","kind":"heading","level":3,"spans":[{"id":"spn-44922","text":"GoalGraph"}]},{"id":"blk-40795","kind":"paragraph","spans":[{"id":"spn-44923","text":"Durable multi-step intent with lifecycle states such as:"}]},{"id":"blk-40796","items":[{"blocks":[{"id":"blk-40798","kind":"paragraph","spans":[{"id":"spn-44924","marks":["code"],"text":"proposed"}]}],"id":"blk-40797","kind":"list-item"},{"blocks":[{"id":"blk-40800","kind":"paragraph","spans":[{"id":"spn-44925","marks":["code"],"text":"active"}]}],"id":"blk-40799","kind":"list-item"},{"blocks":[{"id":"blk-40802","kind":"paragraph","spans":[{"id":"spn-44926","marks":["code"],"text":"blocked"}]}],"id":"blk-40801","kind":"list-item"},{"blocks":[{"id":"blk-40804","kind":"paragraph","spans":[{"id":"spn-44927","marks":["code"],"text":"completed"}]}],"id":"blk-40803","kind":"list-item"},{"blocks":[{"id":"blk-40806","kind":"paragraph","spans":[{"id":"spn-44928","marks":["code"],"text":"abandoned"}]}],"id":"blk-40805","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40807","kind":"paragraph","spans":[{"id":"spn-44929","text":"Goals can link to supporting node IDs, track progress, and persist across sessions."}]},{"id":"blk-40808","kind":"heading","level":3,"spans":[{"id":"spn-44930","text":"Coverage"}]},{"id":"blk-40809","kind":"paragraph","spans":[{"id":"spn-44931","text":"Before high-impact actions, Graphonomous can score epistemic readiness:"}]},{"id":"blk-40810","items":[{"blocks":[{"id":"blk-40812","kind":"paragraph","spans":[{"id":"spn-44932","marks":["code"],"text":"coverage_score"}]}],"id":"blk-40811","kind":"list-item"},{"blocks":[{"id":"blk-40814","kind":"paragraph","spans":[{"id":"spn-44933","marks":["code"],"text":"uncertainty_score"}]}],"id":"blk-40813","kind":"list-item"},{"blocks":[{"id":"blk-40816","kind":"paragraph","spans":[{"id":"spn-44934","marks":["code"],"text":"risk_score"}]}],"id":"blk-40815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40817","kind":"paragraph","spans":[{"id":"spn-44935","text":"Decision output:"}]},{"id":"blk-40818","items":[{"blocks":[{"id":"blk-40820","kind":"paragraph","spans":[{"id":"spn-44936","marks":["bold"],"text":"act"}]}],"id":"blk-40819","kind":"list-item"},{"blocks":[{"id":"blk-40822","kind":"paragraph","spans":[{"id":"spn-44937","marks":["bold"],"text":"learn"}]}],"id":"blk-40821","kind":"list-item"},{"blocks":[{"id":"blk-40824","kind":"paragraph","spans":[{"id":"spn-44938","marks":["bold"],"text":"escalate"}]}],"id":"blk-40823","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40825","kind":"heading","level":3,"spans":[{"id":"spn-44939","text":"Attention"}]},{"id":"blk-40826","kind":"paragraph","spans":[{"id":"spn-44940","text":"Attention continuously ranks work across goals using urgency, coverage gaps, and topology signals; it supports "},{"id":"spn-44941","marks":["code"],"text":"observe"},{"id":"spn-44942","text":", "},{"id":"spn-44943","marks":["code"],"text":"advise"},{"id":"spn-44944","text":", and "},{"id":"spn-44945","marks":["code"],"text":"act"},{"id":"spn-44946","text":" autonomy levels."}]},{"id":"blk-40827","kind":"paragraph","spans":[{"id":"spn-44947","text":"---"}]},{"id":"blk-40828","kind":"heading","level":2,"spans":[{"id":"spn-44948","text":"Consolidation"}]},{"id":"blk-40829","kind":"paragraph","spans":[{"id":"spn-44949","marks":["code"],"text":"Consolidator"},{"id":"spn-44950","text":" runs periodic maintenance to protect graph quality over time:"}]},{"id":"blk-40830","kind":"paragraph","spans":[{"id":"s