{"bendscript":"0.1","blocks":[{"id":"blk-1","kind":"heading","level":1,"spans":[{"id":"spn-177","text":"Runefort"}]},{"id":"blk-2","kind":"paragraph","spans":[{"id":"spn-178","text":"A small open protocol and ~5KB Web Component framework for tile-grid UIs with file-backed "},{"id":"spn-179","text":"rooms, runtime state classes, and in-browser authoring. Drop into any HTML page. Version "},{"id":"spn-180","marks":["code"],"text":"0.1.0-alpha.1"},{"id":"spn-181","text":"."}]},{"blocks":[{"id":"blk-4","kind":"paragraph","spans":[{"id":"spn-182","text":"The home page of this site is a Runefort floor: each room is a component of the stack, its state class driven by ship status. Hot tile = shipped; dim tile = draft."}]}],"id":"blk-3","kind":"quote"},{"id":"blk-5","kind":"heading","level":2,"spans":[{"id":"spn-183","text":"Four primitives, four scales"}]},{"id":"blk-6","kind":"paragraph","spans":[{"id":"spn-184","text":"A "},{"id":"spn-185","marks":["bold"],"text":"room"},{"id":"spn-186","text":" is the tile; a "},{"id":"spn-187","marks":["bold"],"text":"claim"},{"id":"spn-188","text":" is what it owns (inline content or a file "},{"id":"spn-189","text":"anchor); a "},{"id":"spn-190","marks":["bold"],"text":"neighbor"},{"id":"spn-191","text":" is arrow-key adjacency; a "},{"id":"spn-192","marks":["bold"],"text":"state"},{"id":"spn-193","text":" is live status. Real systems live at four zooms: campus → building → floor → room."}]},{"id":"blk-7","kind":"heading","level":2,"spans":[{"id":"spn-194","text":"Vocabularies on the floor"}]},{"id":"blk-8","kind":"paragraph","spans":[{"id":"spn-195","text":"A vocabulary declares what a tile "},{"id":"spn-196","marks":["bold"],"text":"means"},{"id":"spn-197","text":". "},{"id":"spn-198","marks":["code"],"text":"codebase-atlas.v1"},{"id":"spn-199","text":" makes a repository a place — tiles are modules, signals are coverage and churn. "},{"id":"spn-200","text":"This docs floor uses that idea: the stack as a place you can walk."}]}],"edges":[{"object":"bend:dqqim37","predicate":"ampersand.docs:rendered-by","subject":"bend:d1s6s5fe"},{"object":"https://runefort.com","predicate":"cites","subject":"bend:d1s6s5fe"}],"id":"bagaaieravgi7a6ll5xnqo23ekqcus34ey2boes7uo6p4qdpe2fxsanqu4mma","vocabulary":"ampersand.docs.v1"}