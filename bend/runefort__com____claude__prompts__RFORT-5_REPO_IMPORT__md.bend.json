{"bendscript":"0.1","blocks":[{"id":"blk-56301","kind":"heading","level":1,"spans":[{"id":"spn-64112","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-56302","kind":"heading","level":2,"spans":[{"id":"spn-64113","text":"Goal"}]},{"id":"blk-56303","kind":"paragraph","spans":[{"id":"spn-64114","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-56304","kind":"heading","level":2,"spans":[{"id":"spn-64115","text":"Prerequisites"}]},{"id":"blk-56305","items":[{"blocks":[{"id":"blk-56307","kind":"paragraph","spans":[{"id":"spn-64116","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-56306","kind":"list-item"},{"blocks":[{"id":"blk-56309","kind":"paragraph","spans":[{"id":"spn-64117","text":"Core fort generator ("},{"id":"spn-64118","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-64119","text":") already exists with "},{"id":"spn-64120","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-56308","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56310","kind":"heading","level":2,"spans":[{"id":"spn-64121","text":"Files to Create"}]},{"id":"blk-56311","kind":"heading","level":3,"spans":[{"id":"spn-64122","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-56312","kind":"paragraph","spans":[{"id":"spn-64123","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-56313","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-56314","kind":"paragraph","spans":[{"id":"spn-64124","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-56316","spans":[{"id":"spn-64125","text":"Git concept"}]},{"id":"blk-56317","spans":[{"id":"spn-64126","text":"Fort concept"}]},{"id":"blk-56318","spans":[{"id":"spn-64127","text":"Level"}]}],"id":"blk-56315","kind":"table","rows":[[{"id":"blk-56319","spans":[{"id":"spn-64128","text":"Repository"}]},{"id":"blk-56320","spans":[{"id":"spn-64129","text":"Fort (L1 Campus)"}]},{"id":"blk-56321","spans":[{"id":"spn-64130","text":"L1"}]}],[{"id":"blk-56322","spans":[{"id":"spn-64131","text":"Top-level directory"}]},{"id":"blk-56323","spans":[{"id":"spn-64132","text":"Room"}]},{"id":"blk-56324","spans":[{"id":"spn-64133","text":"L2"}]}],[{"id":"blk-56325","spans":[{"id":"spn-64134","text":"Subdirectory"}]},{"id":"blk-56326","spans":[{"id":"spn-64135","text":"Nested room cluster"}]},{"id":"blk-56327","spans":[{"id":"spn-64136","text":"L2"}]}],[{"id":"blk-56328","spans":[{"id":"spn-64137","text":"Source file"}]},{"id":"blk-56329","spans":[{"id":"spn-64138","text":"Tile"}]},{"id":"blk-56330","spans":[{"id":"spn-64139","text":"L3"}]}],[{"id":"blk-56331","spans":[{"id":"spn-64140","marks":["code"],"text":"package.json"},{"id":"spn-64141","text":" / "},{"id":"spn-64142","marks":["code"],"text":"mix.exs"},{"id":"spn-64143","text":" / "},{"id":"spn-64144","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-56332","spans":[{"id":"spn-64145","text":"Gate node (entry point)"}]},{"id":"blk-56333","spans":[{"id":"spn-64146","text":"L2"}]}],[{"id":"blk-56334","spans":[{"id":"spn-64147","text":"Import/require between dirs"}]},{"id":"blk-56335","spans":[{"id":"spn-64148","text":"Hall (corridor edge)"}]},{"id":"blk-56336","spans":[{"id":"spn-64149","text":"L2"}]}],[{"id":"blk-56337","spans":[{"id":"spn-64150","text":"External dependency"}]},{"id":"blk-56338","spans":[{"id":"spn-64151","text":"Bridge edge (outgoing)"}]},{"id":"blk-56339","spans":[{"id":"spn-64152","text":"L1"}]}],[{"id":"blk-56340","spans":[{"id":"spn-64153","text":"README / docs"}]},{"id":"blk-56341","spans":[{"id":"spn-64154","text":"Tower (observation)"}]},{"id":"blk-56342","spans":[{"id":"spn-64155","text":"L2"}]}],[{"id":"blk-56343","spans":[{"id":"spn-64156","text":"Config files"}]},{"id":"blk-56344","spans":[{"id":"spn-64157","text":"Wall (policy)"}]},{"id":"blk-56345","spans":[{"id":"spn-64158","text":"L2"}]}]]},{"id":"blk-56346","kind":"heading","level":3,"spans":[{"id":"spn-64159","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-56347","kind":"paragraph","spans":[{"id":"spn-64160","text":"Modal with:"}]},{"id":"blk-56348","items":[{"blocks":[{"id":"blk-56350","kind":"paragraph","spans":[{"id":"spn-64161","text":"GitHub URL input field"}]}],"id":"blk-56349","kind":"list-item"},{"blocks":[{"id":"blk-56352","kind":"paragraph","spans":[{"id":"spn-64162","text":"Branch selector (default: main)"}]}],"id":"blk-56351","kind":"list-item"},{"blocks":[{"id":"blk-56354","kind":"paragraph","spans":[{"id":"spn-64163","text":"\"Import\" button"}]}],"id":"blk-56353","kind":"list-item"},{"blocks":[{"id":"blk-56356","kind":"paragraph","spans":[{"id":"spn-64164","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-56355","kind":"list-item"},{"blocks":[{"id":"blk-56358","kind":"paragraph","spans":[{"id":"spn-64165","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-56357","kind":"list-item"},{"blocks":[{"id":"blk-56360","kind":"paragraph","spans":[{"id":"spn-64166","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-56359","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56361","kind":"paragraph","spans":[{"id":"spn-64167","text":"On import success: call "},{"id":"spn-64168","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-56362","kind":"heading","level":3,"spans":[{"id":"spn-64169","text":"Fort store addition"}]},{"id":"blk-56363","kind":"paragraph","spans":[{"id":"spn-64170","text":"Add to "},{"id":"spn-64171","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-64172","text":":"}]},{"id":"blk-56364","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-56365","kind":"heading","level":2,"spans":[{"id":"spn-64173","text":"Integration Point"}]},{"id":"blk-56366","kind":"paragraph","spans":[{"id":"spn-64174","text":"Add a \"Import Repo\" button to the "},{"id":"spn-64175","marks":["code"],"text":"/app"},{"id":"spn-64176","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-56367","kind":"heading","level":2,"spans":[{"id":"spn-64177","text":"Constraints"}]},{"id":"blk-56368","items":[{"blocks":[{"id":"blk-56370","kind":"paragraph","spans":[{"id":"spn-64178","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-56369","kind":"list-item"},{"blocks":[{"id":"blk-56372","kind":"paragraph","spans":[{"id":"spn-64179","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-56371","kind":"list-item"},{"blocks":[{"id":"blk-56374","kind":"paragraph","spans":[{"id":"spn-64180","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-56373","kind":"list-item"},{"blocks":[{"id":"blk-56376","kind":"paragraph","spans":[{"id":"spn-64181","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-56375","kind":"list-item"},{"blocks":[{"id":"blk-56378","kind":"paragraph","spans":[{"id":"spn-64182","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-56377","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7qho5ptx5gwbt4ybekgyle5uj7a7jvj4wnrk2i422nvhewvcmsba","vocabulary":"ampersand.docs.fs.v1"}