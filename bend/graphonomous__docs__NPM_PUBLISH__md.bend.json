{"bendscript":"0.1","blocks":[{"id":"blk-39921","kind":"heading","level":1,"spans":[{"id":"spn-43990","text":"Graphonomous npm Publishing + Maintenance Runbook (Manual-First)"}]},{"id":"blk-39922","kind":"paragraph","spans":[{"id":"spn-43991","text":"This runbook is the "},{"id":"spn-43992","marks":["bold"],"text":"manual release path"},{"id":"spn-43993","text":" for publishing "},{"id":"spn-43994","marks":["code"],"text":"graphonomous"},{"id":"spn-43995","text":" without relying on long-lived CI publish credentials."}]},{"id":"blk-39923","kind":"paragraph","spans":[{"id":"spn-43996","text":"It is designed for the reality that npm credentials/tokens may rotate or expire frequently."}]},{"id":"blk-39924","kind":"paragraph","spans":[{"id":"spn-43997","text":"---"}]},{"id":"blk-39925","kind":"heading","level":2,"spans":[{"id":"spn-43998","text":"1) Goal"}]},{"id":"blk-39926","kind":"paragraph","spans":[{"id":"spn-43999","text":"Publish Graphonomous so users can run:"}]},{"id":"blk-39927","items":[{"blocks":[{"id":"blk-39929","kind":"paragraph","spans":[{"id":"spn-44000","marks":["code"],"text":"npx graphonomous --help"}]}],"id":"blk-39928","kind":"list-item"},{"blocks":[{"id":"blk-39931","kind":"paragraph","spans":[{"id":"spn-44001","marks":["code"],"text":"npm i -g graphonomous"}]}],"id":"blk-39930","kind":"list-item"},{"blocks":[{"id":"blk-39933","kind":"paragraph","spans":[{"id":"spn-44002","marks":["code"],"text":"graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]}],"id":"blk-39932","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-39934","kind":"paragraph","spans":[{"id":"spn-44003","text":"while keeping the Elixir implementation as source of truth."}]},{"id":"blk-39935","kind":"paragraph","spans":[{"id":"spn-44004","text":"---"}]},{"id":"blk-39936","kind":"heading","level":2,"spans":[{"id":"spn-44005","text":"2) Principles"}]},{"id":"blk-39937","kind":"paragraph","spans":[{"id":"spn-44006","text":"1. "},{"id":"spn-44007","marks":["bold"],"text":"Manual over automated publish"}]},{"id":"blk-39938","items":[{"blocks":[{"id":"blk-39940","kind":"paragraph","spans":[{"id":"spn-44008","text":"You run the release and npm publish commands locally."}]}],"id":"blk-39939","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-39941","kind":"paragraph","spans":[{"id":"spn-44009","text":"2. "},{"id":"spn-44010","marks":["bold"],"text":"No dependency on permanent CI tokens"}]},{"id":"blk-39942","items":[{"blocks":[{"id":"blk-39944","kind":"paragraph","spans":[{"id":"spn-44011","text":"No long-lived npm automation token required."}]}],"id":"blk-39943","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-39945","kind":"paragraph","spans":[{"id":"spn-44012","text":"3. "},{"id":"spn-44013","marks":["bold"],"text":"Version parity is strict"}]},{"id":"blk-39946","items":[{"blocks":[{"id":"blk-39948","kind":"paragraph","spans":[{"id":"spn-44014","marks":["code"],"text":"mix.exs"},{"id":"spn-44015","text":", "},{"id":"spn-44016","marks":["code"],"text":"npm/package.json"},{"id":"spn-44017","text":", git tag, and release assets must all match."}]}],"id":"blk-39947","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-39949","kind":"paragraph","spans":[{"id":"spn-44018","text":"4. "},{"id":"spn-44019","marks":["bold"],"text":"Never overwrite versions"}]},{"id":"blk-39950","items":[{"blocks":[{"id":"blk-39952","kind":"paragraph","spans":[{"id":"spn-44020","text":"npm versions are immutable once published."}]}],"id":"blk-39951","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-39953","kind":"paragraph","spans":[{"id":"spn-44021","text":"---"}]},{"id":"blk-39954","kind":"heading","level":2,"spans":[{"id":"spn-44022","text":"3) Required Local Tooling"}]},{"id":"blk-39955","items":[{"blocks":[{"id":"blk-39957","kind":"paragraph","spans":[{"id":"spn-44023","text":"Elixir "},{"id":"spn-44024","marks":["code"],"text":"1.17.x"}]}],"id":"blk-39956","kind":"list-item"},{"blocks"