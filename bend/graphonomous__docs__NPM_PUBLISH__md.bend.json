-44116","marks":["code"],"text":"ProjectAmp2/graphonomous/npm"},{"id":"spn-44117","text":": npm publish --access public"}]},{"id":"blk-40044","kind":"paragraph","spans":[{"id":"spn-44118","text":"If 2FA is enabled, complete OTP prompt."}]},{"id":"blk-40045","kind":"heading","level":2,"spans":[{"id":"spn-44119","text":"6.10 Post-publish verification"}]},{"id":"blk-40046","kind":"paragraph","spans":[{"id":"spn-44120","text":"npm view graphonomous version npx -y graphonomous --help npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-40047","kind":"paragraph","spans":[{"id":"spn-44121","text":"---"}]},{"id":"blk-40048","kind":"heading","level":2,"spans":[{"id":"spn-44122","text":"7) Zed Config (npm-installed command)"}]},{"id":"blk-40049","kind":"paragraph","spans":[{"id":"spn-44123","text":"Use in Zed settings JSON:"}]},{"id":"blk-40050","kind":"paragraph","spans":[{"id":"spn-44124","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"graphonomous\", \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\" } } } }"}]},{"id":"blk-40051","kind":"paragraph","spans":[{"id":"spn-44125","text":"Or one-off via "},{"id":"spn-44126","marks":["code"],"text":"npx"},{"id":"spn-44127","text":":"}]},{"id":"blk-40052","kind":"paragraph","spans":[{"id":"spn-44128","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": {} } } }"}]},{"id":"blk-40053","kind":"paragraph","spans":[{"id":"spn-44129","text":"---"}]},{"id":"blk-40054","kind":"heading","level":2,"spans":[{"id":"spn-44130","text":"8) Maintenance Routine"}]},{"id":"blk-40055","kind":"paragraph","spans":[{"id":"spn-44131","text":"For each shipped change: 1. Update "},{"id":"spn-44132","marks":["code"],