":[{"id":"spn-44082","text":"6.3 Quality checks"}]},{"id":"blk-40016","kind":"paragraph","spans":[{"id":"spn-44083","text":"mix deps.get mix format --check-formatted mix compile --warnings-as-errors mix test"}]},{"id":"blk-40017","kind":"heading","level":2,"spans":[{"id":"spn-44084","text":"6.4 Build OTP release locally"}]},{"id":"blk-40018","kind":"paragraph","spans":[{"id":"spn-44085","text":"MIX_ENV=prod mix release --overwrite"}]},{"id":"blk-40019","kind":"paragraph","spans":[{"id":"spn-44086","text":"Sanity check command path: _build/prod/rel/graphonomous/bin/graphonomous version"}]},{"id":"blk-40020","kind":"paragraph","spans":[{"id":"spn-44087","text":"CLI sanity check via eval entrypoint: _build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"}]},{"id":"blk-40021","kind":"heading","level":2,"spans":[{"id":"spn-44088","text":"6.5 Create release assets locally"}]},{"id":"blk-40022","kind":"paragraph","spans":[{"id":"spn-44089","text":"Example for your current machine target: VERSION=X.Y.Z TARGET=linux-x64 mkdir -p dist tar -czf \"dist/graphonomous-v${VERSION}-${TARGET}.tar.gz\" -C \"_build/prod/rel\" graphonomous"}]},{"id":"blk-40023","kind":"paragraph","spans":[{"id":"spn-44090","text":"Repeat on each required OS/arch machine to produce all target artifacts:"}]},{"id":"blk-40024","items":[{"blocks":[{"id":"blk-40026","kind":"paragraph","spans":[{"id":"spn-44091","text":"linux x64"}]}],"id":"blk-40025","kind":"list-item"},{"blocks":[{"id":"blk-40028","kind":"paragraph","spans":[{"id":"spn-44092","text":"linux arm64"}]}],"id":"blk-40027","kind":"list-item"},{"blocks":[{"id":"blk-40030","kind":"paragraph","spans":[{"id":"spn-44093","text":"macOS x64"}]}],"id":"blk-40029","kind":"list-item"},{"blocks":[{"id":"blk-40032","kind":"paragraph","spans":[{"id":"spn-44094","text":"macOS arm64"}]}],"id":"blk-40031","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40033","kind":"heading","level":2,"spans":[{"id":"sp