{"bendscript":"0.1","blocks":[{"id":"blk-19774","kind":"heading","level":1,"spans":[{"id":"spn-20611","text":"PRISM — User Stories"}]},{"id":"blk-19775","kind":"paragraph","spans":[{"id":"spn-20612","text":"Canonical user-story catalog. Used for Playwright tests + Claude Design input for dashboard expansion."}]},{"id":"blk-19776","kind":"paragraph","spans":[{"id":"spn-20613","marks":["bold"],"text":"Scope:"},{"id":"spn-20614","text":" OS-009 PRISM benchmark engine. Phoenix LiveView today (landing + API leaderboard); richer UI planned. "},{"id":"spn-20615","marks":["bold"],"text":"Unit-test surface covered:"},{"id":"spn-20616","text":" "},{"id":"spn-20617","marks":["code"],"text":"test/**"},{"id":"spn-20618","text":" (172 tests)."}]},{"id":"blk-19777","kind":"paragraph","spans":[{"id":"spn-20619","text":"---"}]},{"id":"blk-19778","kind":"heading","level":2,"spans":[{"id":"spn-20620","text":"Story 1 · Compose scenario from git repo (BYOR)"}]},{"id":"blk-19779","items":[{"blocks":[{"id":"blk-19781","kind":"paragraph","spans":[{"id":"spn-20621","marks":["bold"],"text":"Persona:"},{"id":"spn-20622","text":" ML researcher building a CL benchmark"}]}],"id":"blk-19780","kind":"list-item"},{"blocks":[{"id":"blk-19783","kind":"paragraph","spans":[{"id":"spn-20623","marks":["bold"],"text":"Goal:"},{"id":"spn-20624","text":" Walk a git repo's commit history, extract CL challenges, register as anchor scenarios"}]}],"id":"blk-19782","kind":"list-item"},{"blocks":[{"id":"blk-19785","kind":"paragraph","spans":[{"id":"spn-20625","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-20626","text":" Git repo with meaningful commit diffs"}]}],"id":"blk-19784","kind":"list-item"},{"blocks":[{"id":"blk-19787","kind":"paragraph","spans":[{"id":"spn-20627","marks":["bold"],"text":"Steps:"}]}],"id":"blk-19786","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19788","kind":"paragraph","spans":[{"id":"spn-20628","text":"1. Call "},{"id":"spn-20629","marks":["code"],"text":"compose