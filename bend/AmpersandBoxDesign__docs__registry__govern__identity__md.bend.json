k-7110","kind":"paragraph","spans":[{"id":"spn-7145","marks":["code"],"text":"registered_at"},{"id":"spn-7146","text":" — ISO 8601 registration timestamp"}]}],"id":"blk-7109","kind":"list-item"},{"blocks":[{"id":"blk-7112","kind":"paragraph","spans":[{"id":"spn-7147","marks":["code"],"text":"updated_at"},{"id":"spn-7148","text":" — ISO 8601 last update timestamp"}]}],"id":"blk-7111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7113","kind":"paragraph","spans":[{"id":"spn-7149","text":"---"}]},{"id":"blk-7114","kind":"heading","level":2,"spans":[{"id":"spn-7150","text":"9. Architecture patterns"}]},{"id":"blk-7115","kind":"heading","level":3,"spans":[{"id":"spn-7151","text":"Pattern A: A2A handshake with mutual verification"}]},{"id":"blk-7116","kind":"code","language":"text","text":"agent_a\n|> &govern.identity.resolve(agent_b_id)\n|> &govern.identity.verify(agent_b_claim)\n|> proceed_if_verified()"},{"id":"blk-7117","kind":"paragraph","spans":[{"id":"spn-7152","text":"Use this when:"}]},{"id":"blk-7118","items":[{"blocks":[{"id":"blk-7120","kind":"paragraph","spans":[{"id":"spn-7153","text":"two agents need to establish mutual trust before collaborating"}]}],"id":"blk-7119","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7121","kind":"heading","level":3,"spans":[{"id":"spn-7154","text":"Pattern B: identity-gated escalation"}]},{"id":"blk-7122","kind":"code","language":"text","text":"escalation_request\n|> &govern.identity.verify(requester)\n|> &govern.escalation.escalate()\n|> &govern.telemetry.emit()"},{"id":"blk-7123","kind":"paragraph","spans":[{"id":"spn-7155","text":"Use this when:"}]},{"id":"blk-7124","items":[{"blocks":[{"id":"blk-7126","kind":"paragraph","spans":[{"id":"spn-7156","text":"an escalation request must be attributed to a verified agent before it is surfaced to a human operator"}]}],"id":"blk-7125","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7127","kind":"heading","level":3,"spans":[{"id":"spn-7157","text":"Pattern C: registration at deployment"}]},{"id":"blk-7128","kind":"code","language":"text","text":"ampersand_json\n|> &govern.identity.register()\n|> &govern.telemetry.emit()\n|> deploy_to_runtime()"},{"id":"blk-7129","kind":"paragraph","spans":[{"id":"spn-7158","text":"Use this when:"}]},{"id":"blk-7130","items":[{"blocks":[{"id":"blk-7132","kind":"paragraph","spans":[{"id":"spn-7159","text":"a new agent is being deployed and needs to establish its registry identity before becoming operational"}]}],"id":"blk-7131","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7133","kind":"heading","level":3,"spans":[{"id":"spn-7160","text":"Pattern D: trust-aware delegation"}]},{"id":"blk-7134","kind":"code","language":"text","text":"task_request\n|> &govern.identity.resolve(candidate_agent)\n|> check_trust_score()\n|> delegate_if_trusted()"},{"id":"blk-7135","kind":"paragraph","spans":[{"id":"spn-7161","text":"Use this when:"}]},{"id":"blk-7136","items":[{"blocks":[{"id":"blk-7138","kind":"paragraph","spans":[{"id":"spn-7162","text":"a task needs to be delegated to another agent and the trust score should inform the delegation decision"}]}],"id":"blk-7137","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7139","kind":"paragraph","spans":[{"id":"spn-7163","text":"---"}]},{"id":"blk-7140","kind":"heading","level":2,"spans":[{"id":"spn-7164","text":"10. Example declaration"}]},{"id":"blk-7141","kind":"paragraph","spans":[{"id":"spn-7165","text":"A concrete "},{"id":"spn-7166","marks":["code"],"text":"ampersand.json"},{"id":"spn-7167","text":" fragment:"}]},{"id":"blk-7142","kind":"code","language":"json","text":"{\n  \"&govern.identity\": {\n    \"provider\": \"opensentience\",\n    \"config\": {\n      \"registry\": \"fleetprompt\",\n      \"verify_on_a2a\": true\n    }\n  }\n}"},{"id":"blk-7143","kind":"paragraph","spans":[{"id":"spn-7168","text":"A fuller declaration:"}]},{"id":"blk-7144","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"DataAnalyst\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {\n        \"mode\": \"continual-learning\"\n      }\n    },\n    \"&reason.plan\": {\n      \"provider\": \"auto\",\n      \"need\": \"data analysis planning with policy-aware access controls\"\n    },\n    \"&govern.identity\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"registry\": \"fleetprompt\",\n        \"verify_on_a2a\": true\n      }\n    },\n    \"&govern.escalation\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"timeout_seconds\": 1800\n      }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\n      \"Never access data outside the agent's authorized scope\",\n      \"Always verify collaborating agent identity before sharing results\"\n    ],\n    \"soft\": [\n      \"Prefer agents with trust_score above 0.8 for delegation\"\n    ],\n    \"escalate_when\": {\n      \"confidence_below\": 0.7,\n      \"collaborator_trust_below\": 0.6\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-7145","kind":"paragraph","spans":[{"id":"spn-7169","text":"---"}]},{"id":"blk-7146","kind":"heading","level":2,"spans":[{"id":"spn-7170","text":"11. Governance and provenance implications"}]},{"id":"blk-7147","kind":"paragraph","spans":[{"id":"spn-7171","text":"Agent identity is foundational to the entire governance stack. Every other governance capability depends on knowing who the agent is."}]},{"id":"blk-7148","kind":"heading","level":3,"spans":[{"id":"spn-7172","text":"Cross-references"}]},{"id":"blk-7149","items":[{"blocks":[{"id":"blk-7151","kind":"paragraph","spans":[{"id":"spn-7173","marks":["bold"],"text":"OpenSentience OS-006"},{"id":"spn-7174","text":": defines autonomy levels that are part of the identity governance summary"}]}],"id":"blk-7150","kind":"list-item"},{"blocks":[{"id":"blk-7153","kind":"paragraph","spans":[{"id":"spn-7175","marks":["bold"],"text":"OpenSentience OS-007"},{"id":"spn-7176","text":": identifies agent impersonation as a critical threat — "},{"id":"spn-7177","marks":["code"],"text":"&govern.identity"},{"id":"spn-7178","text":" is the primary defense against this threat"}]}],"id":"blk-7152","kind":"list-item"},{"blocks":[{"id":"blk-7155","kind":"paragraph","spans":[{"id":"spn-7179","marks":["bold"],"text":"Delegatic org policies"},{"id":"spn-7180","text":": org_id in the identity record links the agent to Delegatic budget and governance constraints"}]}],"id":"blk-7154","kind":"list-item"},{"blocks":[{"id":"blk-7157","kind":"paragraph","spans":[{"id":"spn-7181","marks":["bold"],"text":"FleetPrompt trust scores"},{"id":"spn-7182","text":": publisher_id and trust_score connect the agent to FleetPrompt's trust computation system"}]}],"id":"blk-7156","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7158","kind":"heading","level":3,"spans":[{"id":"spn-7183","text":"Representative provenance record"}]},{"id":"blk-7159","kind":"code","language":"json","text":"{\n  \"source\": \"&govern.identity\",\n  \"provider\": \"opensentience\",\n  \"operation\": \"verify\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"agent_id\": \"agt-01JQ7...\",\n  \"manifest_hash\": \"sha256:ab3f...\",\n  \"verification_result\": \"verified\",\n  \"trust_score\": 0.91,\n  \"mcp_trace_id\": \"os-id-422\"\n}"},{"id":"blk-7160","kind":"paragraph","spans":[{"id":"spn-7184","text":"Provenance should help answer questions like:"}]},{"id":"blk-7161","items":[{"blocks":[{"id":"blk-7163","kind":"paragraph","spans":[{"id":"spn-7185","text":"Which agent produced this output?"}]}],"id":"blk-7162","kind":"list-item"},{"blocks":[{"id":"blk-7165","kind":"paragraph","spans":[{"id":"spn-7186","text":"Was the agent's identity verified at the time of the operation?"}]}],"id":"blk-7164","kind":"list-item"},{"blocks":[{"id":"blk-7167","kind":"paragraph","spans":[{"id":"spn-7187","text":"What was the agent's trust score when it was delegated this task?"}]}],"id":"blk-7166","kind":"list-item"},{"blocks":[{"id":"blk-7169","kind":"paragraph","spans":[{"id":"spn-7188","text":"Has the agent's manifest changed since this operation was recorded?"}]}],"id":"blk-7168","kind":"list-item"},{"blocks":[{"id":"blk-7171","kind":"paragraph","spans":[{"id":"spn-7189","text":"Which organization was the agent registered under?"}]}],"id":"blk-7170","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7172","kind":"paragraph","spans":[{"id":"spn-7190","text":"---"}]},{"id":"blk-7173","kind":"heading","level":2,"spans":[{"id":"spn-7191","text":"12. Compatible providers"}]},{"id":"blk-7174","kind":"paragraph","spans":[{"id":"spn-7192","text":"Representative compatible providers include:"}]},{"id":"blk-7175","items":[{"blocks":[{"id":"blk-7177","kind":"paragraph","spans":[{"id":"spn-7193","marks":["code"],"text":"opensentience"},{"id":"spn-7194","text":" (primary runtime verification provider)"}]}],"id":"blk-7176","kind":"list-item"},{"blocks":[{"id":"blk-7179","kind":"paragraph","spans":[{"id":"spn-7195","marks":["code"],"text":"fleetprompt"},{"id":"spn-7196","text":" (registry and trust score computation)"}]}],"id":"blk-7178","kind":"list-item"},{"blocks":[{"id":"blk-7181","kind":"paragraph","spans":[{"id":"spn-7197","text":"custom identity and authentication services exposed behind MCP-compatible surfaces"}]}],"id":"blk-7180","kind":"list-item"},{"blocks":[{"id":"blk-7183","kind":"paragraph","spans":[{"id":"spn-7198","text":"enterprise agent directory systems with structured manifest verification"}]}],"id":"blk-7182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7184","kind":"heading","level":3,"spans":[{"id":"spn-7199","text":"Default ecosystem fit"}]},{"id":"blk-7185","kind":"paragraph","spans":[{"id":"spn-7200","text":"The most natural default ecosystem pairing is:"}]},{"id":"blk-7186","items":[{"blocks":[{"id":"blk-7188","kind":"paragraph","spans":[{"id":"spn-7201","marks":["code"],"text":"opensentience"},{"id":"spn-7202","text":" for runtime identity verification"}]}],"id":"blk-7187","kind":"list-item"},{"blocks":[{"id":"blk-7190","kind":"paragraph","spans":[{"id":"spn-7203","marks":["code"],"text":"fleetprompt"},{"id":"spn-7204","text":" for the agent registry and trust scoring"}]}],"id":"blk-7189","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7191","kind":"paragraph","spans":[{"id":"spn-7205","text":"Why they fit together:"}]},{"id":"blk-7192","items":[{"blocks":[{"id":"blk-7194","kind":"paragraph","spans":[{"id":"spn-7206","text":"OpenSentience provides the verification runtime that checks claims against registered manifests"}]}],"id":"blk-7193","kind":"list-item"},{"blocks":[{"id":"blk-7196","kind":"paragraph","spans":[{"id":"spn-7207","text":"FleetPrompt maintains the registry and computes trust scores from agent history and attestations"}]}],"id":"blk-7195","kind":"list-item"},{"blocks":[{"id":"blk-7198","kind":"paragraph","spans":[{"id":"spn-7208","text":"Together they form the complete identity and trust stack"}]}],"id":"blk-7197","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7199","kind":"paragraph","spans":[{"id":"spn-7209","text":"The protocol stance remains:"}]},{"blocks":[{"id":"blk-7201","kind":"paragraph","spans":[{"id":"spn-7210","marks":["code"],"text":"&govern.identity"},{"id":"spn-7211","text":" is the capability. "},{"id":"spn-7212","marks":["code"],"text":"opensentience"},{"id":"spn-7213","text":" and "},{"id":"spn-7214","marks":["code"],"text":"fleetprompt"},{"id":"spn-7215","text":" are providers that may satisfy it."}]}],"id":"blk-7200","kind":"quote"},{"id":"blk-7202","kind":"paragraph","spans":[{"id":"spn-7216","text":"---"}]},{"id":"blk-7203","kind":"heading","level":2,"spans":[{"id":"spn-7217","text":"13. A2A-facing skills"}]},{"id":"blk-7204","kind":"paragraph","spans":[{"id":"spn-7218","text":"A "},{"id":"spn-7219","marks":["code"],"text":"&govern.identity"},{"id":"spn-7220","text":" capability may advertise skills such as:"}]},{"id":"blk-7205","items":[{"blocks":[{"id":"blk-7207","kind":"paragraph","spans":[{"id":"spn-7221","marks":["code"],"text":"agent-identity-verification"}]}],"id":"blk-7206","kind":"list-item"},{"blocks":[{"id":"blk-7209","kind":"paragraph","spans":[{"id":"spn-7222","marks":["code"],"text":"manifest-attestation"}]}],"id":"blk-7208","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7210","kind":"paragraph","spans":[{"id":"spn-7223","text":"These are useful when generating A2A-style agent cards, because they let an external coordination surface say more than \"has identity support.\""}]},{"id":"blk-7211","kind":"paragraph","spans":[{"id":"spn-7224","text":"Instead, it can say the agent can:"}]},{"id":"blk-7212","items":[{"blocks":[{"id":"blk-7214","kind":"paragraph","spans":[{"id":"spn-7225","text":"verify other agents' identities before collaboration"}]}],"id":"blk-7213","kind":"list-item"},{"blocks":[{"id":"blk-7216","kind":"paragraph","spans":[{"id":"spn-7226","text":"attest its own manifest for mutual trust establishment"}]}],"id":"blk-7215","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7217","kind":"paragraph","spans":[{"id":"spn-7227","text":"---"}]},{"id":"blk-7218","kind":"heading","level":2,"spans":[{"id":"spn-7228","text":"14. Anti-patterns"}]},{"id":"blk-7219","kind":"heading","level":3,"spans":[{"id":"spn-7229","text":"Anti-pattern 1: assume trust without verification"}]},{"id":"blk-7220","kind":"paragraph","spans":[{"id":"spn-7230","text":"In multi-agent systems, implicit trust is a security vulnerability. Always verify identity before accepting delegated tasks or sharing results. OS-007 documents the agent impersonation threat this prevents."}]},{"id":"blk-7221","kind":"heading","level":3,"spans":[{"id":"spn-7231","text":"Anti-pattern 2: bind identity to a single runtime"}]},{"id":"blk-7222","kind":"paragraph","spans":[{"id":"spn-7232","text":"Agent identity should be portable across runtimes and deployments. Tying identity to a specific runtime creates fragile trust relationships that break during migration."}]},{"id":"blk-7223","kind":"heading","level":3,"spans":[{"id":"spn-7233","text":"Anti-pattern 3: skip manifest hashing"}]},{"id":"blk-7224","kind":"paragraph","spans":[{"id":"spn-7234","text":"The manifest hash is the integrity anchor. Without it, there is no way to detect if an agent's declaration has been modified after registration."}]},{"id":"blk-7225","kind":"heading","level":3,"spans":[{"id":"spn-7235","text":"Anti-pattern 4: ignore trust scores in delegation"}]},{"id":"blk-7226","kind":"paragraph","spans":[{"id":"spn-7236","text":"Trust scores exist to inform delegation decisions. Delegating sensitive tasks to agents with low or missing trust scores undermines the purpose of the identity system."}]},{"id":"blk-7227","kind":"heading","level":3,"spans":[{"id":"spn-7237","text":"Anti-pattern 5: register once and never update"}]},{"id":"blk-7228","kind":"paragraph","spans":[{"id":"spn-7238","text":"Agent capabilities and governance policies evolve. Stale identity records create a gap between what the registry says and what the agent actually does."}]},{"id":"blk-7229","kind":"paragraph","spans":[{"id":"spn-7239","text":"---"}]},{"id":"blk-7230","kind":"heading","level":2,"spans":[{"id":"spn-7240","text":"15. Summary"}]},{"id":"blk-7231","kind":"paragraph","spans":[{"id":"spn-7241","marks":["code"],"text":"&govern.identity"},{"id":"spn-7242","text":" is the [&] Protocol capability for "},{"id":"spn-7243","marks":["bold"],"text":"cross-runtime agent identity and trust verification"},{"id":"spn-7244","text":"."}]},{"id":"blk-7232","kind":"paragraph","spans":[{"id":"spn-7245","text":"It is the right capability when a system needs to:"}]},{"id":"blk-7233","items":[{"blocks":[{"id":"blk-7235","kind":"paragraph","spans":[{"id":"spn-7246","text":"establish verifiable agent identity that persists across runtimes"}]}],"id":"blk-7234","kind":"list-item"},{"blocks":[{"id":"blk-7237","kind":"paragraph","spans":[{"id":"spn-7247","text":"verify that agents are who they claim to be before collaboration"}]}],"id":"blk-7236","kind":"list-item"},{"blocks":[{"id":"blk-7239","kind":"paragraph","spans":[{"id":"spn-7248","text":"link agents to organizations, publishers, and governance policies"}]}],"id":"blk-7238","kind":"list-item"},{"blocks":[{"id":"blk-7241","kind":"paragraph","spans":[{"id":"spn-7249","text":"carry trust metadata that informs delegation and escalation decisions"}]}],"id":"blk-7240","kind":"list-item"},{"blocks":[{"id":"blk-7243","kind":"paragraph","spans":[{"id":"spn-7250","text":"maintain an auditable registry of all agent identities"}]}],"id":"blk-7242","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7244","kind":"paragraph","spans":[{"id":"spn-7251","text":"In one sentence:"}]},{"blocks":[{"id":"blk-7246","kind":"paragraph","spans":[{"id":"spn-7252","marks":["code"],"text":"&govern.identity"},{"id":"spn-7253","text":" gives agents a protocol-native way to prove who they are and verify who they are working with."}]}],"id":"blk-7245","kind":"quote"},{"id":"blk-7247","kind":"paragraph","spans":[{"id":"spn-7254","text":"---"}]}],"edges":[],"id":"bagaaiera7lizez2egs6b3phdj3m6waui47lpqg6s4x7ei74igk5i432qqqda","vocabulary":"ampersand.docs.fs.v1"}