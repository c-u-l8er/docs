{"bendscript":"0.1","blocks":[{"id":"blk-6843","kind":"heading","level":1,"spans":[{"id":"spn-6908","marks":["code"],"text":"&govern.identity"},{"id":"spn-6909","text":" — Agent Identity, Verification, and Trust"}]},{"id":"blk-6844","kind":"paragraph","spans":[{"id":"spn-6910","marks":["code"],"text":"&govern.identity"},{"id":"spn-6911","text":" is the [&] Protocol capability for "},{"id":"spn-6912","marks":["bold"],"text":"cross-runtime agent identity and trust verification"},{"id":"spn-6913","text":"."}]},{"id":"blk-6845","kind":"paragraph","spans":[{"id":"spn-6914","text":"It describes an agent's ability to:"}]},{"id":"blk-6846","items":[{"blocks":[{"id":"blk-6848","kind":"paragraph","spans":[{"id":"spn-6915","text":"establish a portable, verifiable identity"}]}],"id":"blk-6847","kind":"list-item"},{"blocks":[{"id":"blk-6850","kind":"paragraph","spans":[{"id":"spn-6916","text":"prove that identity to other agents and governance systems"}]}],"id":"blk-6849","kind":"list-item"},{"blocks":[{"id":"blk-6852","kind":"paragraph","spans":[{"id":"spn-6917","text":"register and update identity in a shared registry"}]}],"id":"blk-6851","kind":"list-item"},{"blocks":[{"id":"blk-6854","kind":"paragraph","spans":[{"id":"spn-6918","text":"carry trust metadata that informs collaboration and delegation decisions"}]}],"id":"blk-6853","kind":"list-item"},{"blocks":[{"id":"blk-6856","kind":"paragraph","spans":[{"id":"spn-6919","text":"maintain identity continuity across runtimes, sessions, and deployments"}]}],"id":"blk-6855","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6857","kind":"paragraph","spans":[{"id":"spn-6920","text":"In the protocol's five-primitive model:"}]},{"id":"blk-6858","items":[{"blocks":[{"id":"blk-6860","kind":"paragraph","spans":[{"id":"spn-6921","marks":["code"],"text":"&memory"},{"id":"spn-6922","text":" answers "},{"id":"spn-6923","marks":["bold"],"text":"what"},{"id":"spn-6924","text":" the agent knows"}]}],"id":"blk-6859","kind":"list-item"},{"blocks":[{"id":"blk-6862","kind":"paragraph","spans":[{"id":"spn-6925","marks":["code"],"text":"&reason"},{"id":"spn-6926","text":" answers "},{"id":"spn-6927","marks":["bold"],"text":"how"},{"id":"spn-6928","text":" the agent decides"}]}],"id":"blk-6861","kind":"list-item"},{"blocks":[{"id":"blk-6864","kind":"paragraph","spans":[{"id":"spn-6929","marks":["code"],"text":"&time"},{"id":"spn-6930","text":" answers "},{"id":"spn-6931","marks":["bold"],"text":"when"},{"id":"spn-6932","text":" things change"}]}],"id":"blk-6863","kind":"list-item"},{"blocks":[{"id":"blk-6866","kind":"paragraph","spans":[{"id":"spn-6933","marks":["code"],"text":"&space"},{"id":"spn-6934","text":" answers "},{"id":"spn-6935","marks":["bold"],"text":"where"},{"id":"spn-6936","text":" things are"}]}],"id":"blk-6865","kind":"list-item"},{"blocks":[{"id":"blk-6868","kind":"paragraph","spans":[{"id":"spn-6937","marks":["code"],"text":"&govern"},{"id":"spn-6938","text":" answers "},{"id":"spn-6939","marks":["bold"],"text":"who approves, what limits apply, and how decisions are audited"}]}],"id":"blk-6867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6869","kind":"paragraph","spans":[{"id":"spn-6940","marks":["code"],"text":"&govern.identity"},{"id":"spn-6941","text":" is the subtype that answers the foundational question: "},{"id":"spn-6942","marks":["bold"],"text":"who is this agent, and can it be trusted?"}]},{"id":"blk-6870","kind":"paragraph","spans":[{"id":"spn-6943","text":"---"}]},{"id":"blk-6871","kind":"heading","level":2,"spans":[{"id":"spn-6944","text":"1. Definition"}]},{"id":"blk-6872","kind":"paragraph","spans":[{"id":"spn-6945","marks":["code"],"text":"&govern.identity"},{"id":"spn-6946","text":" is the capability interface for "},{"id":"spn-6947","marks":["bold"],"text":"agent identity resolution, verification, and registration"},{"id":"spn-6948","text":"."}]},{"id":"blk-6873","kind":"paragraph","spans":[{"id":"spn-6949","text":"It is used when a system must:"}]},{"id":"blk-6874","items":[{"blocks":[{"id":"blk-6876","kind":"paragraph","spans":[{"id":"spn-6950","text":"resolve an agent's identity from its ID, returning manifest, capabilities, and trust metadata"}]}],"id":"blk-6875","kind":"list-item"},{"blocks":[{"id":"blk-6878","kind":"paragraph","spans":[{"id":"spn-6951","text":"verify that an agent's claimed identity matches its registered manifest"}]}],"id":"blk-6877","kind":"list-item"},{"blocks":[{"id":"blk-6880","kind":"paragraph","spans":[{"id":"spn-6952","text":"register or update an agent's identity in the shared registry"}]}],"id":"blk-6879","kind":"list-item"},{"blocks":[{"id":"blk-6882","kind":"paragraph","spans":[{"id":"spn-6953","text":"link identity to governance policy, org membership, and runtime bindings"}]}],"id":"blk-6881","kind":"list-item"},{"blocks":[{"id":"blk-6884","kind":"paragraph","spans":[{"id":"spn-6954","text":"provide trust scores that inform delegation and collaboration decisions"}]}],"id":"blk-6883","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6885","kind":"paragraph","spans":[{"id":"spn-6955","text":"Without portable identity, multi-agent systems cannot answer basic questions:"}]},{"id":"blk-6886","items":[{"blocks":[{"id":"blk-6888","kind":"paragraph","spans":[{"id":"spn-6956","text":"Is this agent who it claims to be?"}]}],"id":"blk-6887","kind":"list-item"},{"blocks":[{"id":"blk-6890","kind":"paragraph","spans":[{"id":"spn-6957","text":"What capabilities does it actually have?"}]}],"id":"blk-6889","kind":"list-item"},{"blocks":[{"id":"blk-6892","kind":"paragraph","spans":[{"id":"spn-6958","text":"Which organization published it?"}]}],"id":"blk-6891","kind":"list-item"},{"blocks":[{"id":"blk-6894","kind":"paragraph","spans":[{"id":"spn-6959","text":"What governance constraints apply to it?"}]}],"id":"blk-6893","kind":"list-item"},{"blocks":[{"id":"blk-6896","kind":"paragraph","spans":[{"id":"spn-6960","text":"Should I trust its outputs?"}]}],"id":"blk-6895","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6897","kind":"paragraph","spans":[{"id":"spn-6961","marks":["code"],"text":"&govern.identity"},{"id":"spn-6962","text":" makes these answers explicit, verifiable, and protocol-native."}]},{"id":"blk-6898","kind":"paragraph","spans":[{"id":"spn-6963","text":"---"}]},{"id":"blk-6899","kind":"heading","level":2,"spans":[{"id":"spn-6964","text":"2. Why this capability exists"}]},{"id":"blk-6900","kind":"paragraph","spans":[{"id":"spn-6965","text":"Many agent systems assume trust implicitly."}]},{"id":"blk-6901","kind":"paragraph","spans":[{"id":"spn-6966","text":"That works in single-agent demos, but it breaks down in production multi-agent workflows:"}]},{"id":"blk-6902","items":[{"blocks":[{"id":"blk-6904","kind":"paragraph","spans":[{"id":"spn-6967","text":"An agent receives a task delegation from another agent, but cannot verify the sender's identity or authority."}]}],"id":"blk-6903","kind":"list-item"},{"blocks":[{"id":"blk-6906","kind":"paragraph","spans":[{"id":"spn-6968","text":"A governance system needs to audit which agent produced a decision, but agent identity is tied to a specific runtime and not portable."}]}],"id":"blk-6905","kind":"list-item"},{"blocks":[{"id":"blk-6908","kind":"paragraph","spans":[{"id":"spn-6969","text":"A marketplace lists agents for hire, but has no standard way to verify that an agent's declared capabilities match its actual manifest."}]}],"id":"blk-6907","kind":"list-item"},{"blocks":[{"id":"blk-6910","kind":"paragraph","spans":[{"id":"spn-6970","text":"Two agents from different organizations need to collaborate, but neither can verify the other's governance policy or trust level."}]}],"id":"blk-6909","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6911","kind":"paragraph","spans":[{"id":"spn-6971","text":"In all of these cases, the missing layer is "},{"id":"spn-6972","marks":["bold"],"text":"verifiable, portable agent identity"},{"id":"spn-6973","text":"."}]},{"id":"blk-6912","kind":"paragraph","spans":[{"id":"spn-6974","text":"The OpenSentience OS-007 threat model identifies agent impersonation as a critical risk in multi-agent systems. "},{"id":"spn-6975","marks":["code"],"text":"&govern.identity"},{"id":"spn-6976","text":" is the protocol's answer to that threat."}]},{"id":"blk-6913","kind":"paragraph","spans":[{"id":"spn-6977","text":"---"}]},{"id":"blk-6914","kind":"heading","level":2,"spans":[{"id":"spn-6978","text":"3. What problems "},{"id":"spn-6979","marks":["code"],"text":"&govern.identity"},{"id":"spn-6980","text":" solves"}]},{"id":"blk-6915","kind":"paragraph","spans":[{"id":"spn-6981","marks":["code"],"text":"&govern.identity"},{"id":"spn-6982","text":" is useful when an agent or system needs to answer questions like:"}]},{"id":"blk-6916","items":[{"blocks":[{"id":"blk-6918","kind":"paragraph","spans":[{"id":"spn-6983","text":"Who is this agent, and what is its manifest hash?"}]}],"id":"blk-6917","kind":"list-item"},{"blocks":[{"id":"blk-6920","kind":"paragraph","spans":[{"id":"spn-6984","text":"Does this agent's claimed identity match its registered manifest?"}]}],"id":"blk-6919","kind":"list-item"},{"blocks":[{"id":"blk-6922","kind":"paragraph","spans":[{"id":"spn-6985","text":"Which organization published this agent?"}]}],"id":"blk-6921","kind":"list-item"},{"blocks":[{"id":"blk-6924","kind":"paragraph","spans":[{"id":"spn-6986","text":"What capabilities does this agent declare?"}]}],"id":"blk-6923","kind":"list-item"},{"blocks":[{"id":"blk-6926","kind":"paragraph","spans":[{"id":"spn-6987","text":"What autonomy level and governance constraints apply?"}]}],"id":"blk-6925","kind":"list-item"},{"blocks":[{"id":"blk-6928","kind":"paragraph","spans":[{"id":"spn-6988","text":"What is this agent's trust score, and who computed it?"}]}],"id":"blk-6927","kind":"list-item"},{"blocks":[{"id":"blk-6930","kind":"paragraph","spans":[{"id":"spn-6989","text":"Which runtimes is this agent currently bound to?"}]}],"id":"blk-6929","kind":"list-item"},{"blocks":[{"id":"blk-6932","kind":"paragraph","spans":[{"id":"spn-6990","text":"Has this agent's manifest changed since registration?"}]}],"id":"blk-6931","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6933","kind":"paragraph","spans":[{"id":"spn-6991","text":"Without this capability, identity management tends to get buried inside:"}]},{"id":"blk-6934","items":[{"blocks":[{"id":"blk-6936","kind":"paragraph","spans":[{"id":"spn-6992","text":"runtime-specific authentication systems"}]}],"id":"blk-6935","kind":"list-item"},{"blocks":[{"id":"blk-6938","kind":"paragraph","spans":[{"id":"spn-6993","text":"custom API key and token exchanges"}]}],"id":"blk-6937","kind":"list-item"},{"blocks":[{"id":"blk-6940","kind":"paragraph","spans":[{"id":"spn-6994","text":"implicit trust assumptions in orchestration code"}]}],"id":"blk-6939","kind":"list-item"},{"blocks":[{"id":"blk-6942","kind":"paragraph","spans":[{"id":"spn-6995","text":"vendor-specific agent directories with no interoperability"}]}],"id":"blk-6941","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6943","kind":"paragraph","spans":[{"id":"spn-6996","text":"The protocol makes it explicit instead."}]},{"id":"blk-6944","kind":"paragraph","spans":[{"id":"spn-6997","text":"---"}]},{"id":"blk-6945","kind":"heading","level":2,"spans":[{"id":"spn-6998","text":"4. Capability role in the "},{"id":"spn-6999","marks":["code"],"text":"&govern"},{"id":"spn-7000","text":" namespace"}]},{"id":"blk-6946","kind":"paragraph","spans":[{"id":"spn-7001","text":"The "},{"id":"spn-7002","marks":["code"],"text":"&govern"},{"id":"spn-7003","text":" primitive supports multiple subtypes, including:"}]},{"id":"blk-6947","items":[{"blocks":[{"id":"blk-6949","kind":"paragraph","spans":[{"id":"spn-7004","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-6948","kind":"list-item"},{"blocks":[{"id":"blk-6951","kind":"paragraph","spans":[{"id":"spn-7005","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-6950","kind":"list-item"},{"blocks":[{"id":"blk-6953","kind":"paragraph","spans":[{"id":"spn-7006","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-6952","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6954","kind":"paragraph","spans":[{"id":"spn-7007","text":"A helpful distinction is:"}]},{"id":"blk-6955","items":[{"blocks":[{"id":"blk-6957","kind":"paragraph","spans":[{"id":"spn-7008","marks":["code"],"text":"&govern.escalation"},{"id":"spn-7009","text":" = decision handoff when thresholds are crossed"}]}],"id":"blk-6956","kind":"list-item"},{"blocks":[{"id":"blk-6959","kind":"paragraph","spans":[{"id":"spn-7010","marks":["code"],"text":"&govern.identity"},{"id":"spn-7011","text":" = agent authentication and trust verification"}]}],"id":"blk-6958","kind":"list-item"},{"blocks":[{"id":"blk-6961","kind":"paragraph","spans":[{"id":"spn-7012","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-7013","text":" = observability, cost tracking, and budget enforcement"}]}],"id":"blk-6960","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6962","kind":"paragraph","spans":[{"id":"spn-7014","marks":["code"],"text":"&govern.identity"},{"id":"spn-7015","text":" is the right subtype when the main problem is "},{"id":"spn-7016","marks":["bold"],"text":"establishing and verifying who an agent is"},{"id":"spn-7017","text":" before trusting its actions, delegations, or outputs."}]},{"id":"blk-6963","kind":"paragraph","spans":[{"id":"spn-7018","text":"---"}]},{"id":"blk-6964","kind":"heading","level":2,"spans":[{"id":"spn-7019","text":"5. Typical use cases"}]},{"id":"blk-6965","kind":"heading","level":3,"spans":[{"id":"spn-7020","text":"A2A handshake verification"}]},{"id":"blk-6966","kind":"paragraph","spans":[{"id":"spn-7021","text":"Before two agents collaborate, each verifies the other's identity and governance policy via "},{"id":"spn-7022","marks":["code"],"text":"&govern.identity.verify()"},{"id":"spn-7023","text":"."}]},{"id":"blk-6967","kind":"heading","level":3,"spans":[{"id":"spn-7024","text":"Agent registration"}]},{"id":"blk-6968","kind":"paragraph","spans":[{"id":"spn-7025","text":"A newly deployed agent registers its identity, linking its "},{"id":"spn-7026","marks":["code"],"text":"ampersand.json"},{"id":"spn-7027","text":" declaration, SpecPrompt spec, and Delegatic org membership."}]},{"id":"blk-6969","kind":"heading","level":3,"spans":[{"id":"spn-7028","text":"Marketplace trust evaluation"}]},{"id":"blk-6970","kind":"paragraph","spans":[{"id":"spn-7029","text":"FleetPrompt computes trust scores based on registered identity metadata. Consumers use "},{"id":"spn-7030","marks":["code"],"text":"resolve"},{"id":"spn-7031","text":" to inspect an agent's trust profile before delegation."}]},{"id":"blk-6971","kind":"heading","level":3,"spans":[{"id":"spn-7032","text":"Provenance attribution"}]},{"id":"blk-6972","kind":"paragraph","spans":[{"id":"spn-7033","text":"Every capability operation records the agent's identity in its provenance chain. "},{"id":"spn-7034","marks":["code"],"text":"&govern.identity"},{"id":"spn-7035","text":" provides the authoritative source for that attribution."}]},{"id":"blk-6973","kind":"heading","level":3,"spans":[{"id":"spn-7036","text":"Governance audit"}]},{"id":"blk-6974","kind":"paragraph","spans":[{"id":"spn-7037","text":"Auditors query identity records to verify that agents operating within an org match their registered manifests and governance constraints."}]},{"id":"blk-6975","kind":"heading","level":3,"spans":[{"id":"spn-7038","text":"Cross-runtime continuity"}]},{"id":"blk-6976","kind":"paragraph","spans":[{"id":"spn-7039","text":"An agent migrates between runtimes (e.g., from local development to cloud deployment). Identity persists across the transition because it is bound to the manifest, not the runtime."}]},{"id":"blk-6977","kind":"paragraph","spans":[{"id":"spn-7040","text":"---"}]},{"id":"blk-6978","kind":"heading","level":2,"spans":[{"id":"spn-7041","text":"6. Example capability contract"}]},{"id":"blk-6979","kind":"paragraph","spans":[{"id":"spn-7042","text":"The authoritative contract is at "},{"id":"spn-7043","marks":["code"],"text":"contracts/v0.1.0/govern.identity.contract.json"},{"id":"spn-7044","text":"."}]},{"id":"blk-6980","kind":"paragraph","spans":[{"id":"spn-7045","text":"A representative summary:"}]},{"id":"blk-6981","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&govern.identity\",\n  \"provider\": \"opensentience\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Cross-runtime agent identity contract for resolution, verification, and registration.\",\n  \"operations\": {\n    \"resolve\": {\n      \"in\": \"identity_query\",\n      \"out\": \"agent_identity\",\n      \"description\": \"Resolve an agent's identity by ID, returning manifest, capabilities, and trust metadata.\"\n    },\n    \"verify\": {\n      \"in\": \"verification_request\",\n      \"out\": \"verification_result\",\n      \"description\": \"Verify that an agent's claimed identity matches its registered manifest.\"\n    },\n    \"register\": {\n      \"in\": \"agent_manifest\",\n      \"out\": \"registration_ack\",\n      \"description\": \"Register or update an agent's identity in the shared registry.\"\n    }\n  },\n  \"accepts_from\": [\n    \"&govern.*\",\n    \"identity_query\",\n    \"identity_claim\",\n    \"agent_manifest\"\n  ],\n  \"feeds_into\": [\n    \"&govern.escalation\",\n    \"&govern.telemetry\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"agent-identity-verification\",\n    \"manifest-attestation\"\n  ]\n}"},{"id":"blk-6982","kind":"heading","level":3,"spans":[{"id":"spn-7046","text":"What this contract means"}]},{"id":"blk-6983","kind":"paragraph","spans":[{"id":"spn-7047","text":"This contract says that "},{"id":"spn-7048","marks":["code"],"text":"&govern.identity"},{"id":"spn-7049","text":" can:"}]},{"id":"blk-6984","items":[{"blocks":[{"id":"blk-6986","kind":"paragraph","spans":[{"id":"spn-7050","text":"resolve agent identities from queries"}]}],"id":"blk-6985","kind":"list-item"},{"blocks":[{"id":"blk-6988","kind":"paragraph","spans":[{"id":"spn-7051","text":"verify claimed identities against registered manifests"}]}],"id":"blk-6987","kind":"list-item"},{"blocks":[{"id":"blk-6990","kind":"paragraph","spans":[{"id":"spn-7052","text":"register new agents or update existing registrations"}]}],"id":"blk-6989","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6991","kind":"paragraph","spans":[{"id":"spn-7053","text":"It also says that this capability composes well with:"}]},{"id":"blk-6992","items":[{"blocks":[{"id":"blk-6994","kind":"paragraph","spans":[{"id":"spn-7054","marks":["code"],"text":"&govern.escalation"},{"id":"spn-7055","text":" downstream, where escalation requests must be attributed to verified identities"}]}],"id":"blk-6993","kind":"list-item"},{"blocks":[{"id":"blk-6996","kind":"paragraph","spans":[{"id":"spn-7056","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-7057","text":" downstream, where telemetry events must be attributed to known agents"}]}],"id":"blk-6995","kind":"list-item"},{"blocks":[{"id":"blk-6998","kind":"paragraph","spans":[{"id":"spn-7058","marks":["code"],"text":"&govern.*"},{"id":"spn-7059","text":" upstream, where other governance capabilities may trigger identity checks"}]}],"id":"blk-6997","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-6999","kind":"paragraph","spans":[{"id":"spn-7060","text":"---"}]},{"id":"blk-7000","kind":"heading","level":2,"spans":[{"id":"spn-7061","text":"7. Core operations"}]},{"id":"blk-7001","kind":"heading","level":3,"spans":[{"id":"spn-7062","marks":["code"],"text":"resolve"}]},{"id":"blk-7002","kind":"paragraph","spans":[{"id":"spn-7063","text":"Purpose:"}]},{"id":"blk-7003","items":[{"blocks":[{"id":"blk-7005","kind":"paragraph","spans":[{"id":"spn-7064","text":"look up an agent's full identity record by ID"}]}],"id":"blk-7004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7006","kind":"paragraph","spans":[{"id":"spn-7065","text":"Typical input:"}]},{"id":"blk-7007","items":[{"blocks":[{"id":"blk-7009","kind":"paragraph","spans":[{"id":"spn-7066","marks":["code"],"text":"identity_query"}]}],"id":"blk-7008","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7010","kind":"paragraph","spans":[{"id":"spn-7067","text":"Typical output:"}]},{"id":"blk-7011","items":[{"blocks":[{"id":"blk-7013","kind":"paragraph","spans":[{"id":"spn-7068","marks":["code"],"text":"agent_identity"}]}],"id":"blk-7012","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7014","kind":"paragraph","spans":[{"id":"spn-7069","text":"Use when:"}]},{"id":"blk-7015","items":[{"blocks":[{"id":"blk-7017","kind":"paragraph","spans":[{"id":"spn-7070","text":"another agent or system needs to inspect an agent's capabilities, governance policy, trust score, or runtime bindings before interacting with it"}]}],"id":"blk-7016","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7018","kind":"heading","level":3,"spans":[{"id":"spn-7071","marks":["code"],"text":"verify"}]},{"id":"blk-7019","kind":"paragraph","spans":[{"id":"spn-7072","text":"Purpose:"}]},{"id":"blk-7020","items":[{"blocks":[{"id":"blk-7022","kind":"paragraph","spans":[{"id":"spn-7073","text":"confirm that an agent's claimed identity matches its registered manifest"}]}],"id":"blk-7021","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7023","kind":"paragraph","spans":[{"id":"spn-7074","text":"Typical input:"}]},{"id":"blk-7024","items":[{"blocks":[{"id":"blk-7026","kind":"paragraph","spans":[{"id":"spn-7075","marks":["code"],"text":"verification_request"}]}],"id":"blk-7025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7027","kind":"paragraph","spans":[{"id":"spn-7076","text":"Typical output:"}]},{"id":"blk-7028","items":[{"blocks":[{"id":"blk-7030","kind":"paragraph","spans":[{"id":"spn-7077","marks":["code"],"text":"verification_result"}]}],"id":"blk-7029","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7031","kind":"paragraph","spans":[{"id":"spn-7078","text":"Use when:"}]},{"id":"blk-7032","items":[{"blocks":[{"id":"blk-7034","kind":"paragraph","spans":[{"id":"spn-7079","text":"an A2A handshake requires mutual identity verification"}]}],"id":"blk-7033","kind":"list-item"},{"blocks":[{"id":"blk-7036","kind":"paragraph","spans":[{"id":"spn-7080","text":"an escalation request must be attributed to a verified agent"}]}],"id":"blk-7035","kind":"list-item"},{"blocks":[{"id":"blk-7038","kind":"paragraph","spans":[{"id":"spn-7081","text":"a governance audit checks that operating agents match their registrations"}]}],"id":"blk-7037","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7039","kind":"heading","level":3,"spans":[{"id":"spn-7082","marks":["code"],"text":"register"}]},{"id":"blk-7040","kind":"paragraph","spans":[{"id":"spn-7083","text":"Purpose:"}]},{"id":"blk-7041","items":[{"blocks":[{"id":"blk-7043","kind":"paragraph","spans":[{"id":"spn-7084","text":"create or update an agent's identity in the registry"}]}],"id":"blk-7042","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7044","kind":"paragraph","spans":[{"id":"spn-7085","text":"Typical input:"}]},{"id":"blk-7045","items":[{"blocks":[{"id":"blk-7047","kind":"paragraph","spans":[{"id":"spn-7086","marks":["code"],"text":"agent_manifest"}]}],"id":"blk-7046","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7048","kind":"paragraph","spans":[{"id":"spn-7087","text":"Typical output:"}]},{"id":"blk-7049","items":[{"blocks":[{"id":"blk-7051","kind":"paragraph","spans":[{"id":"spn-7088","marks":["code"],"text":"registration_ack"}]}],"id":"blk-7050","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-7052","kind":"paragr