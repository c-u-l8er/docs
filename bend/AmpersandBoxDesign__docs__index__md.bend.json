detail once the runtime model is clear 10. "},{"id":"spn-5562","marks":["code"],"text":"skills/SKILLS"},{"id":"spn-5563","text":" — hands-on implementation skills registry; start here when you're ready to build"}]},{"id":"blk-5647","items":[{"blocks":[{"id":"blk-5649","kind":"paragraph","spans":[{"id":"spn-5564","marks":["code"],"text":"01_DECLARATION"},{"id":"spn-5565","text":" → "},{"id":"spn-5566","marks":["code"],"text":"02_VALIDATION"},{"id":"spn-5567","text":" → "},{"id":"spn-5568","marks":["code"],"text":"03_COMPOSITION"},{"id":"spn-5569","text":" → "},{"id":"spn-5570","marks":["code"],"text":"04_CONTRACTS"},{"id":"spn-5571","text":" → "},{"id":"spn-5572","marks":["code"],"text":"05_GENERATION"},{"id":"spn-5573","text":" (core workflow)"}]}],"id":"blk-5648","kind":"list-item"},{"blocks":[{"id":"blk-5651","kind":"paragraph","spans":[{"id":"spn-5574","marks":["code"],"text":"06_CLI_REFERENCE"},{"id":"spn-5575","text":" (command reference)"}]}],"id":"blk-5650","kind":"list-item"},{"blocks":[{"id":"blk-5653","kind":"paragraph","spans":[{"id":"spn-5576","marks":["code"],"text":"07_INTEGRATION_PATTERNS"},{"id":"spn-5577","text":" → "},{"id":"spn-5578","marks":["code"],"text":"08_PROVIDER_IMPLEMENTATION"},{"id":"spn-5579","text":" (advanced)"}]}],"id":"blk-5652","kind":"list-item"},{"blocks":[{"id":"blk-5655","kind":"paragraph","spans":[{"id":"spn-5580","marks":["code"],"text":"09_GOVERNANCE_PROVENANCE"},{"id":"spn-5581","text":" → "},{"id":"spn-5582","marks":["code"],"text":"10_ANTI_PATTERNS"},{"id":"spn-5583","text":" (governance and guardrails)"}]}],"id":"blk-5654","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5656","kind":"heading","level":2,"spans":[{"id":"spn-5584","text":"Core idea"}]},{"id":"blk-5657","kind":"paragraph","spans":[{"id":"spn-5585","text":"A concise framing for the protocol is:"}]},{"blocks":[{"id":"blk-5659","kind":"paragraph","spans":[{"id":"spn-5586","text":"MCP defines how agents call tools.   A2A defines how agents call agents.   [&] defines how capabilities compose into a coherent agent."}]}],"id":"blk-5658","kind":"quote"},{"id":"blk-5660","kind":"paragraph","spans":[{"id":"spn-5587","text":"The goal is not to replace existing protocols, but to provide a "},{"id":"spn-5588","marks":["bold"],"text":"source-of-truth composition layer"},{"id":"spn-5589","text":" that sits above runtime wiring and makes agent architecture explicit, portable, and auditable."}]}],"edges":[],"id":"bagaaieraxd5preghilke3kyk4rml6d676awjilz7i7wylyvvkqvq6sxm7vwq","vocabulary":"ampersand.docs.fs.v1"}