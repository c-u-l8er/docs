{"bendscript":"0.1","blocks":[{"id":"blk-42207","kind":"paragraph","spans":[{"id":"spn-46918","text":"--- name: bootstrap description: Use when starting a new session, switching topics, or when the user says \"bootstrap\", \"start session\", \"initialize graphonomous\", or \"load memory\". Activates the Graphonomous-first memory loop and orients on prior context. ---"}]},{"id":"blk-42208","kind":"heading","level":1,"spans":[{"id":"spn-46919","text":"Graphonomous Bootstrap"}]},{"id":"blk-42209","kind":"paragraph","spans":[{"id":"spn-46920","text":"Initialize the Graphonomous-first memory loop for this session."}]},{"id":"blk-42210","kind":"heading","level":2,"spans":[{"id":"spn-46921","text":"Steps"}]},{"id":"blk-42211","kind":"paragraph","spans":[{"id":"spn-46922","text":"1. "},{"id":"spn-46923","marks":["bold"],"text":"Retrieve prior context"},{"id":"spn-46924","text":" for the user's current topic: ``"},{"id":"spn-46925","marks":["code"],"text":" retrieve(action: \"context\", query: \"summary of prior work on <topic>\") "},{"id":"spn-46926","text":"``"}]},{"id":"blk-42212","kind":"paragraph","spans":[{"id":"spn-46927","text":"2. "},{"id":"spn-46928","marks":["bold"],"text":"Check active goals"},{"id":"spn-46929","text":" to regain session continuity: ``"},{"id":"spn-46930","marks":["code"],"text":" act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"}) "},{"id":"spn-46931","text":"``"}]},{"id":"blk-42213","kind":"paragraph","spans":[{"id":"spn-46932","text":"3. "},{"id":"spn-46933","marks":["bold"],"text":"Survey attention"},{"id":"spn-46934","text":" to see what needs focus: ``"},{"id":"spn-46935","marks":["code"],"text":" route(action: \"attention_survey\", include_idle: false) "},{"id":"spn-46936","text":"``"}]},{"id":"blk-42214","kind":"paragraph","spans":[{"id":"spn-46937","text":"4. "},{"id":"spn-46938","marks":["bold"],"text":"Adopt the policy"},{"id":"spn-46939","text":": \"Graphonomous-first memory loop is active.\""}]},{"id":"blk-42215","kind":"paragraph","spans":[{"id":"spn-46940","text":"5. "},{"id":"spn-46941","marks":["bold"],"text":"Report"},{"id":"spn-46942","text":" to the user: what prior context exists, which goals are active, and what the attention engine recommends focusing on."}]},{"id":"blk-42216","kind":"heading","level":2,"spans":[{"id":"spn-46943","text":"Core Loop (apply for remainder of session)"}]},{"id":"blk-42217","kind":"paragraph","spans":[{"id":"spn-46944","text":"For every non-trivial task, run the closed memory loop:"}]},{"id":"blk-42218","kind":"paragraph","spans":[{"id":"spn-46945","text":"1. "},{"id":"spn-46946","marks":["bold"],"text":"Retrieve"},{"id":"spn-46947","text":" — "},{"id":"spn-46948","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-46949","text":" before reasoning/acting. Never skip for domain-specific work. 2. "},{"id":"spn-46950","marks":["bold"],"text":"Route"},{"id":"spn-46951","text":" — check "},{"id":"spn-46952","marks":["code"],"text":"topology.routing"},{"id":"spn-46953","text":" in response. If "},{"id":"spn-46954","marks":["code"],"text":"\"deliberate\""},{"id":"spn-46955","text":", run "},{"id":"spn-46956","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\")"},{"id":"spn-46957","text":" 3. "},{"id":"spn-46958","marks":["bold"],"text":"Act"},{"id":"spn-46959","text":" — "},{"id":"spn-46960","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-46961","text":" to mutate the graph 4. "},{"id":"spn-46962","marks":["bold"],"text":"Learn"},{"id":"spn-46963","text":" — "},{"id":"spn-46964","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-46965","text":" when you have an outcome signal. Preserve "},{"id":"spn-46966","marks":["code"],"text":"causal_context"},{"id":"spn-46967","text":" between retrieval and outcome. 5. "},{"id":"spn-46968","marks":["bold"],"text":"Consolidate"},{"id":"spn-46969","text":" — "},{"id":"spn-46970","marks":["code"],"text":"consolidate(action: \"run\")"},{"id":"spn-46971","text":" periodically and at session end"}]},{"id":"blk-42219","kind":"heading","level":3,"spans":[{"id":"spn-46972","text":"Machine Architecture (v0.4)"}]},{"id":"blk-42220","kind":"paragraph","spans":[{"id":"spn-46973","text":"Graphonomous v0.4 exposes "},{"id":"spn-46974","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-46975","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-46976","marks":["code"],"text":"action"},{"id":"spn-46977","text":" parameter:"}]},{"head":[{"id":"blk-42222","spans":[{"id":"spn-46978","text":"Machine"}]},{"id":"blk-42223","spans":[{"id":"spn-46979","text":"Phase"}]},{"id":"blk-42224","spans":[{"id":"spn-46980","text":"Actions"}]}],"id":"blk-42221","kind":"table","rows":[[{"id":"blk-42225","spans":[{"id":"spn-46981","marks":["code"],"text":"retrieve"}]},{"id":"blk-42226","spans":[{"id":"spn-46982","text":"\"What do I know?\""}]},{"id":"blk-42227","spans":[{"id":"spn-46983","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-42228","spans":[{"id":"spn-46984","marks":["code"],"text":"route"}]},{"id":"blk-42229","spans":[{"id":"spn-46985","text":"\"What should I do?\""}]},{"id":"blk-42230","spans":[{"id":"spn-46986","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-42231","spans":[{"id":"spn-46987","marks":["code"],"text":"act"}]},{"id":"blk-42232","spans":[{"id":"spn-46988","text":"\"Do it\""}]},{"id":"blk-42233","spans":[{"id":"spn-46989","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-42234","spans":[{"id":"spn-46990","marks":["code"],"text":"learn"}]},{"id":"blk-42235","spans":[{"id":"spn-46991","text":"\"Did it work?\""}]},{"id":"blk-42236","spans":[{"id":"spn-46992","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-42237","spans":[{"id":"spn-46993","marks":["code"],"text":"consolidate"}]},{"id":"blk-42238","spans":[{"id":"spn-46994","text":"\"Clean up\""}]},{"id":"blk-42239","spans":[{"id":"spn-46995","text":"run, stats, query, traverse"}]}]]},{"id":"blk-42240","kind":"heading","level":2,"spans":[{"id":"spn-46996","text":"Node and Edge Discipline"}]},{"id":"blk-42241","items":[{"blocks":[{"id":"blk-42243","kind":"paragraph","spans":[{"id":"spn-46997","text":"Prefer "},{"id":"spn-46998","marks":["bold"],"text":"small, atomic nodes"},{"id":"spn-46999","text":" — one fact/procedure/event per node"}]}],"id":"blk-42242","kind":"list-item"},{"blocks":[{"id":"blk-42245","kind":"paragraph","spans":[{"id":"spn-47000","text":"Choose node types correctly: "},{"id":"spn-47001","marks":["code"],"text":"semantic"},{"id":"spn-47002","text":" (facts), "},{"id":"spn-47003","marks":["code"],"text":"procedural"},{"id":"spn-47004","text":" (how-to), "},{"id":"spn-47005","marks":["code"],"text":"episodic"},{"id":"spn-47006","text":" (events), "},{"id":"spn-47007","marks":["code"],"text":"temporal"},{"id":"spn-47008","text":" (time-bound observations), "},{"id":"spn-47009","marks":["code"],"text":"outcome"},{"id":"spn-47010","text":" (measured results), "},{"id":"spn-47011","marks":["code"],"text":"goal"},{"id":"spn-47012","text":" (objectives/targets)"}]}],"id":"blk-42244","kind":"list-item"},{"blocks":[{"id":"blk-42247","kind":"paragraph","spans":[{"id":"spn-47013","text":"Set confidence based on evidence quality, not optimism"}]}],"id":"blk-42246","kind":"list-item"},{"blocks":[{"id":"blk-42249","kind":"paragraph","spans":[{"id":"spn-47014","text":"Include "},{"id":"spn-47015","marks":["code"],"text":"source"},{"id":"spn-47016","text":" whenever possible (file path, URL, \"conversation\")"}]}],"id":"blk-42248","kind":"list-item"},{"blocks":[{"id":"blk-42251","kind":"paragraph","spans":[{"id":"spn-47017","text":"Create edges only when they improve retrieval: "},{"id":"spn-47018","marks":["code