:"paragraph","spans":[{"id":"spn-35558","text":"AgentCore-specific guidance (TypeScript):"}]}],"id":"blk-32939","kind":"list-item"},{"blocks":[{"id":"blk-32942","kind":"paragraph","spans":[{"id":"spn-35559","text":"the adapter SHOULD set "},{"id":"spn-35560","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-35561","text":" explicitly on invocation (e.g., "},{"id":"spn-35562","marks":["code"],"text":"sess_<generated>"},{"id":"spn-35563","text":"), or accept a provider-returned session id if the API returns one."}]}],"id":"blk-32941","kind":"list-item"},{"blocks":[{"id":"blk-32944","kind":"paragraph","spans":[{"id":"spn-35564","text":"the adapter MUST return the session identifier to the client as the opaque "},{"id":"spn-35565","marks":["code"],"text":"sessionId"},{"id":"spn-35566","text":" for subsequent calls."}]}],"id":"blk-32943","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32945","items":[{"blocks":[{"id":"blk-32947","kind":"paragraph","spans":[{"id":"spn-35567","text":"Session lifecycle and timeouts:"}]}],"id":"blk-32946","kind":"list-item"},{"blocks":[{"id":"blk-32949","kind":"paragraph","spans":[{"id":"spn-35568","text":"adapters SHOULD document provider-specific session lifetimes and idle timeouts (in internal docs and/or UI hints) but MUST keep the external "},{"id":"spn-35569","marks":["code"],"text":"invoke/v1"},{"id":"spn-35570","text":" contract stable."}]}],"id":"blk-32948","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32950","kind":"heading","level":3,"spans":[{"id":"spn-35571","text":"4) Streaming rules"}]},{"id":"blk-32951","items":[{"blocks":[{"id":"blk-32953","kind":"paragraph","spans":[{"id":"spn-35572","text":"Streaming endpoint MUST:"}]}],"id":"blk-32952","kind":"list-item"},{"blocks":[{"id":"blk-32955","kind":"paragraph","spans":[{"id":"spn-35573","text":"send "},{"id":"spn-35574","marks":["code"],"text":"meta"},{"id":"spn-35575","text":" as first event,"}]}],"id":"blk-32954","kind":"list-item"},{"blocks":[{"id":"blk-32957","kind":"paragraph","spans":[{"id":"spn-35576","text":"send "},{"id":"spn-35577","marks":["code"],"text":"done"},{"id":"spn-35578","text":" as last event on success,"}]}],"id":"blk-32956","kind":"list-item"},{"blocks":[{"id":"blk-32959","kind":"paragraph","spans":[{"id":"spn-35579","text":"send "},{"id":"spn-35580","marks":["code"],"text":"error"},{"id":"spn-35581","text":" as terminal event on failure."}]}],"id":"blk-32958","kind":"list-item"},{"blocks":[{"id":"blk-32961","kind":"paragraph","spans":[{"id":"spn-35582","text":"Even on streaming:"}]}],"id":"blk-32960","kind":"list-item"},{"blocks":[{"id":"blk-32963","kind":"paragraph","spans":[{"id":"spn-35583","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-32962","kind":"list-item"},{"blocks":[{"id":"blk-32965","kind":"paragraph","spans":[{"id":"spn-35584","marks":["code"],"text":"usage"},{"id":"spn-35585","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-32964","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32966","kind":"heading","level":3,"spans":[{"id":"spn-35586","text":"5) Error normalization"}]},{"id":"blk-32967","items":[{"blocks":[{"id":"blk-32969","kind":"paragraph","spans":[{"id":"spn-35587","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-35588","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-35589","text":"."}]}],"id":"blk-32968","kind":"list-item"},{"blocks":[{"id":"blk-32971","kind":"paragraph","spans":[{"id":"spn-35590","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-32970","kind":"list-item"},{"blocks":[{"id":"blk-32973","kind":"paragraph","spans":[{"id":"spn-35591","marks":["code"],"text":"retryable"},{"id":"spn-35592","text":" must be accurate:"}]}],"id":"blk-32972","kind":"list-item"},{"blocks":[{"id":"blk-32975","kind":"paragraph","spans":[{"id":"spn-35593","text":"transient provider failures: true"}]}],"id":"blk-32974","kind":"list-item"},{"blocks":[{"id":"blk-32977","kind":"paragraph","spans":[{"id":"spn-35594","text":"validation/config/session-expired: false"}]}],"id":"blk-32976","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32978","kind":"heading","level":3,"spans":[{"id":"spn-35595","text":"6) Telemetry correlation"}]},{"id":"blk-32979","items":[{"blocks":[{"id":"blk-32981","kind":"paragraph","spans":[{"id":"spn-35596","text":"The invocation gateway MUST generate a "},{"id":"spn-35597","marks":["code"],"text":"traceId"},{"id":"spn-35598","text":" if missing and propagate it:"}]}],"id":"blk-32980","kind":"list-item"},{"blocks":[{"id":"blk-32983","kind":"paragraph","spans":[{"id":"spn-35599","text":"to the provider adapter request metadata (headers/metadata where possible),"}]}],"id":"blk-32982","kind":"list-item"},{"blocks":[{"id":"blk-32985","kind":"paragraph","spans":[{"id":"spn-35600","text":"to telemetry events emitted by the data plane or adapter."}]}],"id":"blk-32984","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32986","kind":"heading","level":3,"spans":[{"id":"spn-35601","text":"7) Limits and gating integration"}]},{"id":"blk-32987","items":[{"blocks":[{"id":"blk-32989","kind":"paragraph","spans":[{"id":"spn-35602","text":"Limit enforcement is performed in the invocation gateway before provider invocation whenever possible."}]}],"id":"blk-32988","kind":"list-item"},{"blocks":[{"id":"blk-32991","kind":"paragraph","spans":[{"id":"spn-35603","text":"Runtime gating (AgentCore entitlement) MUST be enforced on:"}]}],"id":"blk-32990","kind":"list-item"},{"blocks":[{"id":"blk-32993","kind":"paragraph","spans":[{"id":"spn-35604","text":"deploy path,"}]}],"id":"blk-32992","kind":"list-item"},{"blocks":[{"id":"blk-32995","kind":"paragraph","spans":[{"id":"spn-35605","text":"invoke path,"}]}],"id":"blk-32994","kind":"list-item"},{"blocks":[{"id":"blk-32997","kind":"paragraph","spans":[{"id":"spn-35606","text":"adapter path (defense in depth)."}]}],"id":"blk-32996","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32998","kind":"heading","level":2,"spans":[{"id":"spn-35607","text":"Acceptance criteria"}]},{"id":"blk-32999","kind":"paragraph","spans":[{"id":"spn-35608","text":"This ADR is correctly implemented when:"}]},{"id":"blk-33000","kind":"paragraph","spans":[{"id":"spn-35609","text":"1. "},{"id":"spn-35610","marks":["bold"],"text":"Unified contract"}]},{"id":"blk-33001","items":[{"blocks":[{"id":"blk-33003","kind":"paragraph","spans":[{"id":"spn-35611","text":"Both Cloudflare and AgentCore invocations accept the same "},{"id":"spn-35612","marks":["code"],"text":"invoke/v1"},{"id":"spn-35613","text":" request shape at the gateway."}]}],"id":"blk-33002","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33004","kind":"paragraph","spans":[{"id":"spn-35614","text":"2. "},{"id":"spn-35615","marks":["bold"],"text":"Normalization"}]},{"id":"blk-33005","items":[{"blocks":[{"id":"blk-33007","kind":"paragraph","spans":[{"id":"spn-35616","marks":["code"],"text":"prompt"},{"id":"spn-35617","text":" input is correctly normalized to "},{"id":"spn-35618","marks":["code"],"text":"messages"},{"id":"spn-35619","text":"."}]}],"id":"blk-33006","kind":"list-item"},{"blocks":[{"id":"blk-33009","kind":"paragraph","spans":[{"id":"spn-35620","text":"Ambiguous inputs (both prompt and messages) are handled consistently."}]}],"id":"blk-33008","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33010","kind":"paragraph","spans":[{"id":"spn-35621","text":"3. "},{"id":"spn-35622","marks":["bold"],"text":"Sessions"}]},{"id":"blk-33011","items":[{"blocks":[{"id":"blk-33013","kind":"paragraph","spans":[{"id":"spn-35623","marks":["code"],"text":"sessionId"},{"id":"spn-35624","text":" round-trips correctly for sessionful invocations on both providers (where supported)."}]}],"id":"blk-33012","kind":"list-item"},{"blocks":[{"id":"blk-33015","kind":"paragraph","spans":[{"id":"spn-35625","text":"The system treats session ids as opaque and does not leak provider internals."}]}],"id":"blk-33014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33016","kind":"paragraph","spans":[{"id":"spn-35626","text":"4. "},{"id":"spn-35627","marks":["bold"],"text":"Streaming"}]},{"id":"blk-33017","items":[{"blocks":[{"id":"blk-33019","kind":"paragraph","spans":[{"id":"spn-35628","text":"Streaming endpoint emits SSE events in the required order ("},{"id":"spn-35629","marks":["code"],"text":"meta"},{"id":"spn-35630","text":" → "},{"id":"spn-35631","marks":["code"],"text":"delta*"},{"id":"spn-35632","text":" → "},{"id":"spn-35633","marks":["code"],"text":"usage?"},{"id":"spn-35634","text":" → "},{"id":"spn-35635","marks":["code"],"text":"done"},{"id":"spn-35636","text":" OR "},{"id":"spn-35637","marks":["code"],"text":"error"},{"id":"spn-35638","text":")."}]}],"id":"blk-33018","kind":"list-item"},{"blocks":[{"id":"blk-33021","kind":"paragraph","spans":[{"id":"spn-35639","text":"Non-streaming providers can still be used through streaming endpoint (emulated streaming acceptable)."}]}],"id":"blk-33020","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33022","kind":"paragraph","spans":[{"id":"spn-35640","text":"5. "},{"id":"spn-35641","marks":["bold"],"text":"Telemetry"}]},{"id":"blk-33023","items":[{"blocks":[{"id":"blk-33025","kind":"paragraph","spans":[{"id":"spn-35642","text":"Each invocation results in a telemetry event with correct attribution and "},{"id":"spn-35643","marks":["code"],"text":"traceId"},{"id":"spn-35644","text":"."}]}],"id":"blk-33024","kind":"list-item"},{"blocks":[{"id":"blk-33027","kind":"paragraph","spans":[{"id":"spn-35645","text":"Telemetry cannot be spoofed (signature verification enforced elsewhere per security spec)."}]}],"id":"blk-33026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33028","kind":"paragraph","spans":[{"id":"spn-35646","text":"6. "},{"id":"spn-35647","m