{"bendscript":"0.1","blocks":[{"id":"blk-32626","kind":"heading","level":1,"spans":[{"id":"spn-35294","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-32627","kind":"paragraph","spans":[{"id":"spn-35295","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-32628","items":[{"blocks":[{"id":"blk-32630","kind":"paragraph","spans":[{"id":"spn-35296","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-32629","kind":"list-item"},{"blocks":[{"id":"blk-32632","kind":"paragraph","spans":[{"id":"spn-35297","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-32631","kind":"list-item"},{"blocks":[{"id":"blk-32634","kind":"paragraph","spans":[{"id":"spn-35298","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-32633","kind":"list-item"},{"blocks":[{"id":"blk-32636","kind":"paragraph","spans":[{"id":"spn-35299","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-32635","kind":"list-item"},{"blocks":[{"id":"blk-32638","kind":"paragraph","spans":[{"id":"spn-35300","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-32637","kind":"list-item"},{"blocks":[{"id":"blk-32640","kind":"paragraph","spans":[{"id":"spn-35301","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-35302","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-32639","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32641","kind":"heading","level":2,"spans":[{"id":"spn-35303","text":"Context"}]},{"id":"blk-32642","kind":"paragraph","spans":[{"id":"spn-35304","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-32643","items":[{"blocks":[{"id":"blk-32645","kind":"paragraph","spans":[{"id":"spn-35305","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-32644","kind":"list-item"},{"blocks":[{"id":"blk-32647","kind":"paragraph","spans":[{"id":"spn-35306","text":"consistent session semantics across runtimes,"}]}],"id":"blk-32646","kind":"list-item"},{"blocks":[{"id":"blk-32649","kind":"paragraph","spans":[{"id":"spn-35307","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-32648","kind":"list-item"},{"blocks":[{"id":"blk-32651","kind":"paragraph","spans":[{"id":"spn-35308","text":"safe error handling and sanitization,"}]}],"id":"blk-32650","kind":"list-item"},{"blocks":[{"id":"blk-32653","kind":"paragraph","spans":[{"id":"spn-35309","text":"optional streaming output for good UX."}]}],"id":"blk-32652","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32654","kind":"paragraph","spans":[{"id":"spn-35310","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-32655","items":[{"blocks":[{"id":"blk-32657","kind":"paragraph","spans":[{"id":"spn-35311","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-32656","kind":"list-item"},{"blocks":[{"id":"blk-32659","kind":"paragraph","spans":[{"id":"spn-35312","text":"SDKs hard to write,"}]}],"id":"blk-32658","kind":"list-item"},{"blocks":[{"id":"blk-32661","kind":"paragraph","spans":[{"id":"spn-35313","text":"telemetry inconsistent,"}]}],"id":"blk-32660","kind":"list-item"},{"blocks":[{"id":"blk-32663","kind":"paragraph","spans":[{"id":"spn-35314","text":"limit enforcement unreliable."}]}],"id":"blk-32662","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32664","kind":"paragraph","spans":[{"id":"spn-35315","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-32665","kind":"heading","level":2,"spans":[{"id":"spn-35316","text":"Decision"}]},{"id":"blk-32666","kind":"heading","level":3,"spans":[{"id":"spn-35317","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-35318","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-32667","kind":"paragraph","spans":[{"id":"spn-35319","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-32668","items":[{"blocks":[{"id":"blk-32670","kind":"paragraph","spans":[{"id":"spn-35320","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-32669","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32671","kind":"paragraph","spans":[{"id":"spn-35321","text":"The protocol applies to:"}]},{"id":"blk-32672","items":[{"blocks":[{"id":"blk-32674","kind":"paragraph","spans":[{"id":"spn-35322","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-32673","kind":"list-item"},{"blocks":[{"id":"blk-32676","kind":"paragraph","spans":[{"id":"spn-35323","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-32675","kind":"list-item"},{"blocks":[{"id":"blk-32678","kind":"paragraph","spans":[{"id":"spn-35324","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-32677","kind":"list-item"},{"blocks":[{"id":"blk-32680","kind":"paragraph","spans":[{"id":"spn-35325","text":"telemetry correlation via "},{"id":"spn-35326","marks":["code"],"text":"traceId"},{"id":"spn-35327","text":"."}]}],"id":"blk-32679","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32681","kind":"paragraph","spans":[{"id":"spn-35328","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-35329","marks":["code"],"text":"invoke/v1"},{"id":"spn-35330","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-35331","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-35332","text":"."}]},{"id":"blk-32682","kind":"heading","level":3,"spans":[{"id":"spn-35333","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-32683","kind":"paragraph","spans":[{"id":"spn-35334","marks":["code"],"text":"invoke/v1"},{"id":"spn-35335","text":" defines the canonical input shape as chat "},{"id":"spn-35336","marks":["code"],"text":"messages"},{"id":"spn-35337","text":":"}]},{"id":"blk-32684","items":[{"blocks":[{"id":"blk-32686","kind":"paragraph","spans":[{"id":"spn-35338","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-32685","kind":"list-item"},{"blocks":[{"id":"blk-32688","kind":"paragraph","spans":[{"id":"spn-35339","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-32687","kind":"list-item"},{"blocks":[{"id":"blk-32690","kind":"paragraph","spans":[{"id":"spn-35340","marks":["code"],"text":"content: string"}]}],"id":"blk-32689","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32691","kind":"paragraph","spans":[{"id":"spn-35341","text":"Additionally, for client convenience, "},{"id":"spn-35342","marks":["code"],"text":"invoke/v1"},{"id":"spn-35343","text":" allows a "},{"id":"spn-35344","marks":["code"],"text":"prompt"},{"id":"spn-35345","text":" form:"}]},{"id":"blk-32692","items":[{"blocks":[{"id":"blk-32694","kind":"paragraph","spans":[{"id":"spn-35346","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-32693","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32695","kind":"paragraph","spans":[{"id":"spn-35347","text":"When "},{"id":"spn-35348","marks":["code"],"text":"prompt"},{"id":"spn-35349","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-32696","items":[{"blocks":[{"id":"blk-32698","kind":"paragraph","spans":[{"id":"spn-35350","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-32697","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32699","kind":"paragraph","spans":[{"id":"spn-35351","text":"Rationale:"}]},{"id":"blk-32700","items":[{"blocks":[{"id":"blk-32702","kind":"paragraph","spans":[{"id":"spn-35352","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-32701","kind":"list-item"},{"blocks":[{"id":"blk-32704","kind":"paragraph","spans":[{"id":"spn-35353","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-32703","kind":"list-item"},{"blocks":[{"id":"blk-32706","kind":"paragraph","spans":[{"id":"spn-35354","text":"it avoids provider-specific payload drift."}]}],"id":"blk-32705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32707","kind":"heading","level":3,"spans":[{"id":"spn-35355","text":"3) Session semantics: opaque "},{"id":"spn-35356","marks":["code"],"text":"sessionId"}]},{"id":"blk-32708","kind":"paragraph","spans":[{"id":"spn-35357","marks":["code"],"text":"invoke/v1"},{"id":"spn-35358","text":" standardizes stateful execution via an opaque "},{"id":"spn-35359","marks":["code"],"text":"sessionId"},{"id":"spn-35360","text":" string:"}]},{"id":"blk-32709","items":[{"blocks":[{"id":"blk-32711","kind":"paragraph","spans":[{"id":"spn-35361","text":"Clients MAY include "},{"id":"spn-35362","marks":["code"],"text":"sessionId"},{"id":"spn-35363","text":" to continue a prior session."}]}],"id":"blk-32710","kind":"list-item"},{"blocks":[{"id":"blk-32713","kind":"paragraph","spans":[{"id":"spn-35364","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-35365","marks":["code"],"text":"sessionId"},{"id":"spn-35366","text":"."}]}],"id":"blk-32712","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32714","kind":"paragraph","spans":[{"id":"spn-35367","text":"Rules:"}]},{"id":"blk-32715","items":[{"blocks":[{"id":"blk-32717","kind":"paragraph","spans":[{"id":"spn-35368","marks":["code"],"text":"sessionId"},{"id":"spn-35369","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-32716","kind":"list-item"},{"blocks":[{"id":"blk-32719","kind":"paragraph","spans":[{"id":"spn-35370","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-35371","marks":["code"],"text":"sessionId"},{"id":"spn-35372","text":" string."}]}],"id":"blk-32718","kind":"list-item"},{"blocks":[{"id":"blk-32721","kind":"paragraph","spans":[{"id":"spn-35373","text":"Each runtime provider maps "},{"id":"spn-35374","marks":["code"],"text":"sessionId"},{"id":"spn-35375","text":" to its own session primitive:"}]}],"id":"blk-32720","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32722","items":[{"blocks":[{"id":"blk-32724","kind":"paragraph","spans":[{"id":"spn-35376","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-32723","kind":"list-item"},{"blocks":[{"id":"blk-32726","kind":"paragraph","spans":[{"id":"spn-35377","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-32725","kind":"list-item"},{"blocks":[{"id":"blk-32728","kind":"paragraph","spans":[{"id":"spn-35378","marks":["code"],"text":"sessionId"},{"id":"spn-35379","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-32727","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32729","items":[{"blocks":[{"id":"blk-32731","kind":"paragraph","spans":[{"id":"spn-35380","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-35381","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-35382","text":")"}]}],"id":"blk-32730","kind":"list-item"},{"blocks":[{"id":"blk-32733","kind":"paragraph","spans":[{"id":"spn-35383","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-32732","kind":"list-item"},{"blocks":[{"id":"blk-32735","kind":"paragraph","spans":[{"id":"spn-35384","text":"The adapter MUST treat the "},{"id":"spn-35385","marks":["code"],"text":"sessionId"},{"id":"spn-35386","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-32734","kind":"list-item"},{"blocks":[{"id":"blk-32737","kind":"paragraph","spans":[{"id":"spn-35387","text":"If "},{"id":"spn-35388","marks":["code"],"text":"sessionId"},{"id":"spn-35389","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-35390","marks":["code"],"text":"sessionId"},{"id":"spn-35391","text":"."}]}],"id":"blk-32736","kind":"list-item"},{"blocks":[{"id":"blk-32739","kind":"paragraph","spans":[{"id":"spn-35392","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-32738","kind":"list-item"},{"blocks":[{"id":"blk-32741","kind":"paragraph","spans":[{"id":"spn-35393","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-35394","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-35395","text":" with a safe message such as “Session expired” and "},{"id":"spn-35396","marks":["code"],"text":"retryable=false"},{"id":"spn-35397","text":" (do not leak provider internals)."}]}],"id":"blk-32740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32742","kind":"paragraph","spans":[{"id":"spn-35398","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-32743","items":[{"blocks":[{"id":"blk-32745","kind":"paragraph","spans":[{"id":"spn-35399","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-35400","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-35401","text":") and a "},{"id":"spn-35402","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-35403","text":" set to the opaque "},{"id":"spn-35404","marks":["code"],"text":"sessionId"},{"id":"spn-35405","text":" (or a newly generated one if absent)."}]}],"id":"blk-32744","kind":"list-item"},{"blocks":[{"id":"blk-32747","kind":"paragraph","spans":[{"id":"spn-35406","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-32746","kind":"list-item"},{"blocks":[{"id":"blk-32749","kind":"paragraph","spans":[{"id":"spn-35407","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-32748","kind":"list-item"},{"blocks":[{"id":"blk-32751","kind":"paragraph","spans":[{"id":"spn-35408","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-32750","kind":"list-item"},{"blocks":[{"id":"blk-32753","kind":"paragraph","spans":[{"id":"spn-35409","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-32752","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32754","kind":"heading","level":3,"spans":[{"id":"spn-35410","text":"4) Canonical output: text-first"}]},{"id":"blk-32755","kind":"paragraph","spans":[{"id":"spn-35411","marks":["code"],"text":"invoke/v1"},{"id":"spn-35412","text":" defines the canonical output as:"}]},{"id":"blk-32756","items":[{"blocks":[{"id":"blk-32758","kind":"paragraph","spans":[{"id":"spn-35413","marks":["code"],"text":"output.text: string"},{"id":"spn-35414","text":" (required)"}]}],"id":"blk-32757","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32759","kind":"paragraph","spans":[{"id":"spn-35415","text":"Optionally:"}]},{"id":"blk-32760","items":[{"blocks":[{"id":"blk-32762","kind":"paragraph","spans":[{"id":"spn-35416","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-35417","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-32761","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32763","kind":"paragraph","spans":[{"id":"spn-35418","text":"Rationale:"}]},{"id":"blk-32764","items":[{"blocks":[{"id":"blk-32766","kind":"paragraph","spans":[{"id":"spn-35419","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-32765","kind":"list-item"},{"blocks":[{"id":"blk-32768","kind":"paragraph","spans":[{"id":"spn-35420","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-32767","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32769","kind":"heading","level":3,"spans":[{"id":"spn-35421","text":"5) Usage and correlation are first-class"}]},{"id":"blk-32770","kind":"paragraph","spans":[{"id":"spn-35422","text":"Every "},{"id":"spn-35423","marks":["code"],"text":"invoke/v1"},{"id":"spn-35424","text":" response MUST include:"}]},{"id":"blk-32771","items":[{"blocks":[{"id":"blk-32773","kind":"paragraph","spans":[{"id":"spn-35425","marks":["code"],"text":"traceId: string"},{"id":"spn-35426","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-32772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32774","kind":"paragraph","spans":[{"id":"spn-35427","text":"Response SHOULD include:"}]},{"id":"blk-32775","items":[{"blocks":[{"id":"blk-32777","kind":"paragraph","spans":[{"id":"spn-35428","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-32776","kind":"list-item"},{"blocks":[{"id":"blk-32779","kind":"paragraph","spans":[{"id":"spn-35429","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-32778","kind":"list-item"},{"blocks":[{"id":"blk-32781","kind":"paragraph","spans":[{"id":"spn-35430","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-35431","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-32780","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32782","kind":"paragraph","spans":[{"id":"spn-35432","text":"Telemetry events MUST include the same "},{"id":"spn-35433","marks":["code"],"text":"traceId"},{"id":"spn-35434","text":" when available, and MUST be attributable to:"}]},{"id":"blk-32783","items":[{"blocks":[{"id":"blk-32785","kind":"paragraph","spans":[{"id":"spn-35435","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-32784","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32786","kind":"heading","level":3,"spans":[{"id":"spn-35436","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-32787","kind":"paragraph","spans":[{"id":"spn-35437","marks":["code"],"text":"invoke/v1"},{"id":"spn-35438","text":" defines streaming semantics via "},{"id":"spn-35439","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-35440","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-32788","items":[{"blocks":[{"id":"blk-32790","kind":"paragraph","spans":[{"id":"spn-35441","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-32789","kind":"list-item"},{"blocks":[{"id":"blk-32792","kind":"paragraph","spans":[{"id":"spn-35442","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-32791","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32793","kind":"paragraph","spans":[{"id":"spn-35443","text":"Standard SSE event types:"}]},{"id":"blk-32794","items":[{"blocks":[{"id":"blk-32796","kind":"paragraph","spans":[{"id":"spn-35444","marks":["code"],"text":"meta"},{"id":"spn-35445","text":" (MUST be first)"}]}],"id":"blk-32795","kind":"list-item"},{"blocks":[{"id":"blk-32798","kind":"paragraph","spans":[{"id":"spn-35446","text":"includes "},{"id":"spn-35447","marks":["code"],"text":"traceId"},{"id":"spn-35448","text":" and "},{"id":"spn-35449","marks":["code"],"text":"sessionId"},{"id":"spn-35450","text":" (if known at start)"}]}],"id":"blk-32797","kind":"list-item"},{"blocks":[{"id":"blk-32800","kind":"paragraph","spans":[{"id":"spn-35451","marks":["code"],"text":"delta"},{"id":"spn-35452","text":" (0..N)"}]}],"id":"blk-32799","kind":"list-item"},{"blocks":[{"id":"blk-32802","kind":"paragraph","spans":[{"id":"spn-35453","text":"includes incremental output text chunks"}]}],"id":"blk-32801","kind":"list-item"},{"blocks":[{"id":"blk-32804","kind":"paragraph","spans":[{"id":"spn-35454","marks":["code"],"text":"usage"},{"id":"spn-35455","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-32803","kind":"list-item"},{"blocks":[{"id":"blk-32806","kind":"paragraph","spans":[{"id":"spn-35456","text":"includes final usage summary when available"}]}],"id":"blk-32805","kind":"list-item"},{"blocks":[{"id":"blk-32808","kind":"paragraph","spans":[{"id":"spn-35457","marks":["code"],"text":"done"},{"id":"spn-35458","text":" (MUST be last on success)"}]}],"id":"blk-32807","kind":"list-item"},{"blocks":[{"id":"blk-32810","kind":"paragraph","spans":[{"id":"spn-35459","marks":["code"],"text":"error"},{"id":"spn-35460","text":" (terminal on failure)"}]}],"id":"blk-32809","kind":"list-item"},{"blocks":[{"id":"blk-32812","kind":"paragraph","spans":[{"id":"spn-35461","text":"includes the normalized error envelope"}]}],"id":"blk-32811","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32813","kind":"paragraph","spans":[{"id":"spn-35462","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-32814","items":[{"blocks":[{"id":"blk-32816","kind":"paragraph","spans":[{"id":"spn-35463","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-35464","marks":["code"],"text":"delta"},{"id":"spn-35465","text":" events)."}]}],"id":"blk-32815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32817","kind":"paragraph","spans":[{"id":"spn-35466","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-32818","items":[{"blocks":[{"id":"blk-32820","kind":"paragraph","spans":[{"id":"spn-35467","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-32819","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32821","kind":"paragraph","spans":[{"id":"spn-35468","text":"Rationale:"}]},{"id":"blk-32822","items":[{"blocks":[{"id":"blk-32824","kind":"paragraph","spans":[{"id":"spn-35469","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-32823","kind":"list-item"},{"blocks":[{"id":"blk-32826","kind":"paragraph","spans":[{"id":"spn-35470","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-32825","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32827","kind":"heading","level":2,"spans":[{"id":"spn-35471","text":"Alternatives considered"}]},{"id":"blk-32828","kind":"heading","level":3,"spans":[{"id":"spn-35472","text":"A) Prompt-only protocol"}]},{"id":"blk-32829","kind":"paragraph","spans":[{"id":"spn-35473","text":"Pros:"}]},{"id":"blk-32830","items":[{"blocks":[{"id":"blk-32832","kind":"paragraph","spans":[{"id":"spn-35474","text":"simplest request shape"}]}],"id":"blk-32831","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32833","kind":"paragraph","spans":[{"id":"spn-35475","text":"Cons:"}]},{"id":"blk-32834","items":[{"blocks":[{"id":"blk-32836","kind":"paragraph","spans":[{"id":"spn-35476","text":"loses structured conversation context"}]}],"id":"blk-32835","kind":"list-item"},{"blocks":[{"id":"blk-32838","kind":"paragraph","spans":[{"id":"spn-35477","text":"complicates future tool call integration"}]}],"id":"blk-32837","kind":"list-item"},{"blocks":[{"id":"blk-32840","kind":"paragraph","spans":[{"id":"spn-35478","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-32839","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32841","kind":"paragraph","spans":[{"id":"spn-35479","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-32842","kind":"heading","level":3,"spans":[{"id":"spn-35480","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-32843","kind":"paragraph","spans":[{"id":"spn-35481","text":"Pros:"}]},{"id":"blk-32844","items":[{"blocks":[{"id":"blk-32846","kind":"paragraph","spans":[{"id":"spn-35482","text":"maximum leverage of each provider’s features"}]}],"id":"blk-32845","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32847","kind":"paragraph","spans":[{"id":"spn-35483","text":"Cons:"}]},{"id":"blk-32848","items":[{"blocks":[{"id":"blk-32850","kind":"paragraph","spans":[{"id":"spn-35484","text":"breaks portability and unified SDKs"}]}],"id":"blk-32849","kind":"list-item"},{"blocks":[{"id":"blk-32852","kind":"paragraph","spans":[{"id":"spn-35485","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-32851","kind":"list-item"},{"blocks":[{"id":"blk-32854","kind":"paragraph","spans":[{"id":"spn-35486","text":"increases maintenance and user confusion"}]}],"id":"blk-32853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32855","kind":"paragraph","spans":[{"id":"spn-35487","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-32856","kind":"heading","level":3,"spans":[{"id":"spn-35488","text":"C) WebSockets for streaming"}]},{"id":"blk-32857","kind":"paragraph","spans":[{"id":"spn-35489","text":"Pros:"}]},{"id":"blk-32858","items":[{"blocks":[{"id":"blk-32860","kind":"paragraph","spans":[{"id":"spn-35490","text":"bidirectional, flexible"}]}],"id":"blk-32859","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32861","kind":"paragraph","spans":[{"id":"spn-35491","text":"Cons:"}]},{"id":"blk-32862","items":[{"blocks":[{"id":"blk-32864","kind":"paragraph","spans":[{"id":"spn-35492","text":"more operational complexity (connection state, proxies)"}]}],"id":"blk-32863","kind":"list-item"},{"blocks":[{"id":"blk-32866","kind":"paragraph","spans":[{"id":"spn-35493","text":"not necessary for v1"}]}],"id":"blk-32865","kind":"list-item"},{"blocks":[{"id":"blk-32868","kind":"paragraph","spans":[{"id":"spn-35494","text":"harder to support across platforms and edge gateways"}]}],"id":"blk-32867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32869","kind":"paragraph","spans":[{"id":"spn-35495","text":"Rejected for v1; SSE is sufficient for streaming output. WebSockets can be introduced later if interactive tool call UX requires it."}]},{"id":"blk-32870","kind":"heading","level":3,"spans":[{"id":"spn-35496","text":"D) gRPC for invocation"}]},{"id":"blk-32871","kind":"paragraph","spans":[{"id":"spn-35497","text":"Pros:"}]},{"id":"blk-32872","items":[{"blocks":[{"id":"blk-32874","kind":"paragraph","spans":[{"id":"spn-35498","text":"strict contracts, performance"}]}],"id":"blk-32873","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32875","kind":"paragraph","spans":[{"id":"spn-35499","text":"Cons:"}]},{"id":"blk-32876","items":[{"blocks":[{"id":"blk-32878","kind":"paragraph","spans":[{"id":"spn-35500","text":"browser compatibility constraints"}]}],"id":"blk-32877","kind":"list-item"},{"blocks":[{"id":"blk-32880","kind":"paragraph","spans":[{"id":"spn-35501","text":"higher adoption friction"}]}],"id":"blk-32879","kind":"list-item"},{"blocks":[{"id":"blk-32882","kind":"paragraph","spans":[{"id":"spn-35502","text":"more infrastructure requirements"}]}],"id":"blk-32881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32883","kind":"paragraph","spans":[{"id":"spn-35503","text":"Rejected for v1; HTTP+JSON and SSE are simpler and adequate."}]},{"id":"blk-32884","kind":"heading","level":2,"spans":[{"id":"spn-35504","text":"Consequences"}]},{"id":"blk-32885","kind":"heading","level":3,"spans":[{"id":"spn-35505","text":"Positive"}]},{"id":"blk-32886","items":[{"blocks":[{"id":"blk-32888","kind":"paragraph","spans":[{"id":"spn-35506","text":"Stable, runtime-agnostic contract for clients and SDKs."}]}],"id":"blk-32887","kind":"list-item"},{"blocks":[{"id":"blk-32890","kind":"paragraph","spans":[{"id":"spn-35507","text":"Simplifies the invocation gateway and adapter logic (one normalized shape)."}]}],"id":"blk-32889","kind":"list-item"},{"blocks":[{"id":"blk-32892","kind":"paragraph","spans":[{"id":"spn-35508","text":"Enables consistent telemetry attribution and usage accounting."}]}],"id":"blk-32891","kind":"list-item"},{"blocks":[{"id":"blk-32894","kind":"paragraph","spans":[{"id":"spn-35509","text":"Makes streaming UX consistent across runtimes."}]}],"id":"blk-32893","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32895","kind":"heading","level":3,"spans":[{"id":"spn-35510","text":"Negative / tradeoffs"}]},{"id":"blk-32896","items":[{"blocks":[{"id":"blk-32898","kind":"paragraph","spans":[{"id":"spn-35511","text":"Some provider-native features won’t map cleanly to v1 without extensions (e.g., tool call transcripts)."}]}],"id":"blk-32897","kind":"list-item"},{"blocks":[{"id":"blk-32900","kind":"paragraph","spans":[{"id":"spn-35512","text":"Streaming emulation may not reflect true token-level timing for non-streaming providers."}]}],"id":"blk-32899","kind":"list-item"},{"blocks":[{"id":"blk-32902","kind":"paragraph","spans":[{"id":"spn-35513","text":"Token counts and usage fields may be estimated or unavailable for some providers; must be communicated as such."}]}],"id":"blk-32901","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32903","kind":"heading","level":2,"spans":[{"id":"spn-35514","text":"Implementation details (normative requirements)"}]},{"id":"blk-32904","kind":"heading","level":3,"spans":[{"id":"spn-35515","text":"1) Protocol versioning"}]},{"id":"blk-32905","items":[{"blocks":[{"id":"blk-32907","kind":"paragraph","spans":[{"id":"spn-35516","text":"Every deployment artifact manifest MUST declare "},{"id":"spn-35517","marks":["code"],"text":"protocol: \"invoke/v1\""},{"id":"spn-35518","text":"."}]}],"id":"blk-32906","kind":"list-item"},{"blocks":[{"id":"blk-32909","kind":"paragraph","spans":[{"id":"spn-35519","text":"The control plane MUST reject deployments with unknown protocol versions ("},{"id":"spn-35520","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-35521","text":")."}]}],"id":"blk-32908","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32910","kind":"heading","level":3,"spans":[{"id":"spn-35522","text":"2) Request normalization rules"}]},{"id":"blk-32911","items":[{"blocks":[{"id":"blk-32913","kind":"paragraph","spans":[{"id":"spn-35523","text":"If "},{"id":"spn-35524","marks":["code"],"text":"input.prompt"},{"id":"spn-35525","text":" provided and "},{"id":"spn-35526","marks":["code"],"text":"input.messages"},{"id":"spn-35527","text":" missing:"}]}],"id":"blk-32912","kind":"list-item"},{"blocks":[{"id":"blk-32915","kind":"paragraph","spans":[{"id":"spn-35528","text":"normalize to one user message."}]}],"id":"blk-32914","kind":"list-item"},{"blocks":[{"id":"blk-32917","kind":"paragraph","spans":[{"id":"spn-35529","text":"If both are provided:"}]}],"id":"blk-32916","kind":"list-item"},{"blocks":[{"id":"blk-32919","kind":"paragraph","spans":[{"id":"spn-35530","text":"prefer "},{"id":"spn-35531","marks":["code"],"text":"messages"},{"id":"spn-35532","text":" and ignore "},{"id":"spn-35533","marks":["code"],"text":"prompt"},{"id":"spn-35534","text":" (or reject as invalid; choose one consistent policy; v1 recommendation: reject with "},{"id":"spn-35535","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-35536","text":" to avoid ambiguity)."}]}],"id":"blk-32918","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32920","kind":"heading","level":3,"spans":[{"id":"spn-35537","text":"3) Session rules"}]},{"id":"blk-32921","items":[{"blocks":[{"id":"blk-32923","kind":"para