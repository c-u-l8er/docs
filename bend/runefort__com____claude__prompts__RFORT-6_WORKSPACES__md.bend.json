{"bendscript":"0.1","blocks":[{"id":"blk-56379","kind":"heading","level":1,"spans":[{"id":"spn-64183","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-56380","kind":"heading","level":2,"spans":[{"id":"spn-64184","text":"Goal"}]},{"id":"blk-56381","kind":"paragraph","spans":[{"id":"spn-64185","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-64186","marks":["code"],"text":"amp.workspaces"},{"id":"spn-64187","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-56382","kind":"heading","level":2,"spans":[{"id":"spn-64188","text":"Prerequisites"}]},{"id":"blk-56383","items":[{"blocks":[{"id":"blk-56385","kind":"paragraph","spans":[{"id":"spn-64189","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-56384","kind":"list-item"},{"blocks":[{"id":"blk-56387","kind":"paragraph","spans":[{"id":"spn-64190","text":"Auth system already exists ("},{"id":"spn-64191","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-64192","text":", "},{"id":"spn-64193","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-64194","text":")"}]}],"id":"blk-56386","kind":"list-item"},{"blocks":[{"id":"blk-56389","kind":"paragraph","spans":[{"id":"spn-64195","text":"Supabase client exists ("},{"id":"spn-64196","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-64197","text":") targeting "},{"id":"spn-64198","marks":["code"],"text":"rune"},{"id":"spn-64199","text":" schema"}]}],"id":"blk-56388","kind":"list-item"},{"blocks":[{"id":"blk-56391","kind":"paragraph","spans":[{"id":"spn-64200","text":"Persistence layer exists ("},{"id":"spn-64201","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-64202","text":") with CRUD for "},{"id":"spn-64203","marks":["code"],"text":"rune.forts"},{"id":"spn-64204","text":" and "},{"id":"spn-64205","marks":["code"],"text":"rune.views"}]}],"id":"blk-56390","kind":"list-item"},{"blocks":[{"id":"blk-56393","kind":"paragraph","spans":[{"id":"spn-64206","text":"Migrations exist: "},{"id":"spn-64207","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-64208","text":" (forts, views, bridges, districts tables), "},{"id":"spn-64209","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-64210","text":" (RLS policies using "},{"id":"spn-64211","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-64212","text":")"}]}],"id":"blk-56392","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56394","kind":"heading","level":2,"spans":[{"id":"spn-64213","text":"Files to Create"}]},{"id":"blk-56395","kind":"heading","level":3,"spans":[{"id":"spn-64214","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-56396","kind":"paragraph","spans":[{"id":"spn-64215","text":"Workspace loader using Supabase:"}]},{"id":"blk-56397","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-56398","kind":"heading","level":3,"spans":[{"id":"spn-64216","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-56399","kind":"paragraph","spans":[{"id":"spn-64217","text":"Svelte 5 rune store:"}]},{"id":"blk-56400","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-56401","kind":"heading","level":3,"spans":[{"id":"spn-64218","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-56402","kind":"paragraph","spans":[{"id":"spn-64219","text":"Dropdown in the toolbar:"}]},{"id":"blk-56403","items":[{"blocks":[{"id":"blk-56405","kind":"paragraph","spans":[{"id":"spn-64220","text":"Shows current workspace name"}]}],"id":"blk-56404","kind":"list-item"},{"blocks":[{"id":"blk-56407","kind":"paragraph","spans":[{"id":"spn-64221","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-56406","kind":"list-item"},{"blocks":[{"id":"blk-56409","kind":"paragraph","spans":[{"id":"spn-64222","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-56408","kind":"list-item"},{"blocks":[{"id":"blk-56411","kind":"paragraph","spans":[{"id":"spn-64223","text":"Switching workspace triggers "},{"id":"spn-64224","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-64225","text":" which reloads forts"}]}],"id":"blk-56410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56412","kind":"heading","level":3,"spans":[{"id":"spn-64226","text":"Supabase RPC (migration)"}]},{"id":"blk-56413","kind":"paragraph","spans":[{"id":"spn-64227","text":"If "},{"id":"spn-64228","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-64229","text":" doesn't exist yet, create: "},{"id":"spn-64230","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-64231","text":":"}]},{"id":"blk-56414","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-56415","kind":"heading","level":2,"spans":[{"id":"spn-64232","text":"Integration Points"}]},{"id":"blk-56416","kind":"paragraph","spans":[{"id":"spn-64233","text":"1. "},{"id":"spn-64234","marks":["bold"],"text":"Toolbar"},{"id":"spn-64235","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-64236","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-64237","text":" dropdown when authenticated 2. "},{"id":"spn-64238","marks":["bold"],"text":"Auth flow"},{"id":"spn-64239","text":": After sign-in, call "},{"id":"spn-64240","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-64241","text":" to load the user's workspaces 3. "},{"id":"spn-64242","marks":["bold"],"text":"Fort store"},{"id":"spn-64243","text":": Add "},{"id":"spn-64244","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-64245","text":" that converts saved forts into an L0 district view 4. "},{"id":"spn-64246","marks":["bold"],"text":"Save flow"},{"id":"spn-64247","text":": When saving a fort, include "},{"id":"spn-64248","marks":["code"],"text":"workspace_id"},{"id":"spn-64249","text":" from active workspace 5. "},{"id":"spn-64250","marks":["bold"],"text":"BlueprintList"},{"id":"spn-64251","text":": Filter by active workspace"}]},{"id":"blk-56417","kind":"heading","level":2,"spans":[{"id":"spn-64252","text":"Constraints"}]},{"id":"blk-56418","items":[{"blocks":[{"id":"blk-56420","kind":"paragraph","spans":[{"id":"spn-64253","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-56419","kind":"list-item"},{"blocks":[{"id":"blk-56422","kind":"paragraph","spans":[{"id":"spn-64254","text":"Workspace data comes from "},{"id":"spn-64255","marks":["code"],"text":"amp.workspaces"},{"id":"spn-64256","text":" + "},{"id":"spn-64257","marks":["code"],"text":"amp.members"},{"id":"spn-64258","text":" (shared schema)"}]}],"id":"blk-56421","kind":"list-item"},{"blocks":[{"id":"blk-56424","kind":"paragraph","spans":[{"id":"spn-64259","text":"Fort data comes from "},{"id":"spn-64260","marks":["code"],"text":"rune.forts"},{"id":"spn-64261","text":" (product schema)"}]}],"id":"blk-56423","kind":"list-item"},{"blocks":[{"id":"blk-56426","kind":"paragraph","spans":[{"id":"spn-64262","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-56425","kind":"list-item"},{"blocks":[{"id":"blk-56428","kind":"paragraph","spans":[{"id":"spn-64263","text":"Check if "},{"id":"spn-64264","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-64265","text":" or equivalent already exists before creating migration"}]}],"id":"blk-56427","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraez5ts6uv3os5ghlaykahtnel4srtgcqoqdrpiiu6c3ivm4kslskq","vocabulary":"ampersand.docs.fs.v1"}