ding","level":3,"spans":[{"id":"spn-22183","text":"Build / test"}]},{"head":[{"id":"blk-20893","spans":[{"id":"spn-22184","text":"Command"}]},{"id":"blk-20894","spans":[{"id":"spn-22185","text":"What it does"}]}],"id":"blk-20892","kind":"table","rows":[[{"id":"blk-20895","spans":[{"id":"spn-22186","marks":["code"],"text":"npm run build:all"}]},{"id":"blk-20896","spans":[{"id":"spn-22187","text":"Runs the build step in every buildable project ("},{"id":"spn-22188","marks":["code"],"text":"WebHost.Systems"},{"id":"spn-22189","text":", "},{"id":"spn-22190","marks":["code"],"text":"bendscript.com"},{"id":"spn-22191","text":", "},{"id":"spn-22192","marks":["code"],"text":"runefort.com"},{"id":"spn-22193","text":", "},{"id":"spn-22194","marks":["code"],"text":"graphonomous"},{"id":"spn-22195","text":", "},{"id":"spn-22196","marks":["code"],"text":"PRISM"},{"id":"spn-22197","text":", "},{"id":"spn-22198","marks":["code"],"text":"specprompt.com"},{"id":"spn-22199","text":")."}]}],[{"id":"blk-20897","spans":[{"id":"spn-22200","marks":["code"],"text":"npm run test:all"}]},{"id":"blk-20898","spans":[{"id":"spn-22201","text":"Runs the test suite in every project that has one."}]}],[{"id":"blk-20899","spans":[{"id":"spn-22202","marks":["code"],"text":"npm run lint:all"}]},{"id":"blk-20900","spans":[{"id":"spn-22203","text":"Lints the Node projects; runs "},{"id":"spn-22204","marks":["code"],"text":"mix format --check-formatted"},{"id":"spn-22205","text":" on Elixir projects."}]}],[{"id":"blk-20901","spans":[{"id":"spn-22206","marks":["code"],"text":"npm run typecheck:all"}]},{"id":"blk-20902","spans":[{"id":"spn-22207","marks":["code"],"text":"svelte-check"},{"id":"spn-22208","text":" + "},{"id":"spn-22209","marks":["code"],"text":"tsc"},{"id":"spn-22210","text":" + "},{"id":"spn-22211","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-22212","text":" across the relevant projects."}]}]]},{"id":"blk-20903","kind":"heading","level":3,"spans":[{"id":"spn-22213","text":"Individual project commands (for reference)"}]},{"id":"blk-20904","kind":"paragraph","spans":[{"id":"spn-22214","text":"If you'd rather run commands directly:"}]},{"id":"blk-20905","kind":"code","language":"bash","text":"# graphonomous (Elixir)\ncd graphonomous && mix deps.get && mix compile --warnings-as-errors && mix test\n\n# WebHost.Systems (Node monorepo)\ncd WebHost.Systems && npm install && npm run dev\n\n# AmpersandBoxDesign reference impl\ncd AmpersandBoxDesign/reference/elixir/ampersand_core && mix deps.get && mix escript.build\n\n# PRISM / SpecPrompt (Phoenix)\ncd PRISM && mix deps.get && mix phx.server\ncd specprompt.com && mix deps.get && mix phx.server\n\n# Any SvelteKit / Vite site\ncd runefort.com && npm install && npm run dev"},{"id":"blk-20906","kind":"heading","level":2,"spans":[{"id":"spn-22215","text":"Environment setup per site"}]},{"id":"blk-20907","kind":"paragraph","spans":[{"id":"spn-22216","text":"Most sites need a "},{"id":"spn-22217","marks":["code"],"text":".env.local"},{"id":"spn-22218","text":" pointing at local Supabase. The minimum required:"}]},{"id":"blk-20908","kind":"code","language":"env","text":"VITE_SUPABASE_URL=http://127.0.0.1:54321\nVITE_SUPABASE_ANON_KEY=<ANON_KEY from `npm run db:status`>"},{"id":"blk-20909","kind":"paragraph","spans":[{"id":"spn-22219","marks":["code"],"text":"npm run db:status -- -o env"},{"id":"spn-22220","text":" prints every key ready to paste. (The local anon key is deterministic for "},{"id":"spn-22221","marks":["code"],"text":"supabase-demo"},{"id":"spn-22222","text":", so the same key works across rebuilds.)"}]},{"id":"blk-20910","kind":"heading","level":2,"spans":[{"id":"spn-22223","text":"Conventions"}]},{"id":"blk-20911","items":[{"blocks":[{"id":"blk-20913","kind":"paragraph","spans":[{"id":"spn-22224","text":"Never commit secrets, API keys, or credentials."}]}],"id":"blk-20912","kind":"list-item"},{"blocks":[{"id":"blk-20915","kind":"paragraph","spans":[{"id":"spn-22225","text":"Elixir code follows "},{"id":"spn-22226","marks":["code"],"text":"mix format"},{"id":"spn-22227","text":"; TypeScript uses ESLint + Prettier."}]}],"id":"blk-20914","kind":"list-item"},{"blocks":[{"id":"blk-20917","kind":"paragraph","spans":[{"id":"spn-22228","text":"Each product has a spec under "},{"id":"spn-22229","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-22230","text":" (or "},{"id":"spn-22231","marks":["code"],"text":"prompts/"},{"id":"spn-22232","text":" for AmpersandBoxDesign / BendScript). "},{"id":"spn-22233","marks":["bold"],"text":"Always read the spec before changing code."}]}],"id":"blk-20916","kind":"list-item"},{"blocks":[{"id":"blk-20919","kind":"paragraph","spans":[{"id":"spn-22234","text":"Graphonomous MCP is the always-on memory loop for every session in this repo — see the \"Graphonomous session policy\" section in "},{"id":"spn-22235","marks":[{"kind":"link","predicate":"cites","target":"#/CLAUDE.md"}],"text":"CLAUDE.md"},{"id":"spn-22236","text":"."}]}],"id":"blk-20918","kind":"list-item"},{"blocks":[{"id":"blk-20921","kind":"paragraph","spans":[{"id":"spn-22237","text":"Per-product schema ranges in "},{"id":"spn-22238","marks":["code"],"text":"ampersand-supabase/migrations/"},{"id":"spn-22239","text":": "},{"id":"spn-22240","marks":["code"],"text":"000–009"},{"id":"spn-22241","text":" shared "},{"id":"spn-22242","marks":["code"],"text":"amp.*"},{"id":"spn-22243","text":", "},{"id":"spn-22244","marks":["code"],"text":"010–019"},{"id":"spn-22245","text":" "},{"id":"spn-22246","marks":["code"],"text":"kag.*"},{"id":"spn-22247","text":", "},{"id":"spn-22248","marks":["code"],"text":"020–029"},{"id":"spn-22249","text":" "},{"id":"spn-22250","marks":["code"],"text":"webhost.*"},{"id":"spn-22251","text":", "},{"id":"spn-22252","marks":["code"],"text":"030–039"},{"id":"spn-22253","text":" "},{"id":"spn-22254","marks":["code"],"text":"fleet.*"},{"id":"spn-22255","text":", "},{"id":"spn-22256","marks":["code"],"text":"040–049"},{"