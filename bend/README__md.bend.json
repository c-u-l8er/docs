text":"/home/travis/ProjectAmp2"},{"id":"spn-22098","text":")."}]},{"id":"blk-20824","kind":"code","language":"bash","text":"# 1. Start the shared Supabase data layer (Postgres, Auth, PostgREST, Storage, Studio)\nnpm run db:start\n\n# 2. Start any preview site (examples)\nnpm run dev:runefort      # SvelteKit  → http://localhost:8093\nnpm run dev:bendscript    # SvelteKit  → http://localhost:5174\nnpm run dev:webhost       # Vite/React → http://localhost:5173\n\n# 3. Or start everything in one shot (Supabase + every site/service)\nnpm run dev:all\n\n# Shut down\nnpm run stop:all"},{"id":"blk-20825","kind":"heading","level":2,"spans":[{"id":"spn-22099","text":"Project scripts"}]},{"id":"blk-20826","kind":"paragraph","spans":[{"id":"spn-22100","text":"A top-level "},{"id":"spn-22101","marks":["code"],"text":"package.json"},{"id":"spn-22102","text":" exposes these orchestration commands. Each wraps the appropriate subproject command — nothing fancy, just convenience wrappers so you don't have to remember ports and working directories."}]},{"id":"blk-20827","kind":"heading","level":3,"spans":[{"id":"spn-22103","text":"Supabase (shared data layer)"}]},{"head":[{"id":"blk-20829","spans":[{"id":"spn-22104","text":"Command"}]},{"id":"blk-20830","spans":[{"id":"spn-22105","text":"What it does"}]}],"id":"blk-20828","kind":"table","rows":[[{"id":"blk-20831","spans":[{"id":"spn-22106","marks":["code"],"text":"npm run db:start"}]},{"id":"blk-20832","spans":[{"id":"spn-22107","marks":["code"],"text":"supabase start"},{"id":"spn-22108","text":" from "},{"id":"spn-22109","marks":["code"],"text":"ampersand-supabase/"},{"id":"spn-22110","text":" — boots Postgres, Auth, PostgREST, Studio, Edge Functions"}]}],[{"id":"blk-20833","spans":[{"id":"spn-22111","marks":["code"],"text":"npm run db:stop"}]},{"id":"blk-20834","spans":[{"id":"spn-22112","marks":["code"],"text":"supabase stop"},{"id":"spn-22113","text":" — shut down the full stack (data preserved in Docker volumes)"}]}],[{"id":"blk-20835","spans":[{"id":"spn-22114","marks":["code"],"text":"npm run db:status"}]},{"id":"blk-20836","spans":[{"id":"spn-22115","marks":["code"],"text":"supabase status"},{"id":"spn-22116","text":" — show ports, anon key, publishable key, service-role key"}]}],[{"id":"blk-20837","spans":[{"id":"spn-22117","marks":["code"],"text":"npm run db:reset"}]},{"id":"blk-20838","spans":[{"id":"spn-22118","marks":["code"],"text":"supabase db reset"},{"id":"spn-22119","text":" — re-apply all migrations + seed (destroys data)"}]}],[{"id":"blk-20839","spans":[{"id":"spn-22120","marks":["code"],"text":"npm run db:migrate"}]},{"id":"blk-20840","spans":[{"id":"spn-22121","marks":["code"],"text":"supabase migration up --local --include-all"},{"id":"spn-22122","text":" — apply pending migrations without resetting"}]}],[{"id":"blk-20841","spans":[{"id":"spn-22123","marks":["code"],"text":"npm run db:studio"}]},{"id":"blk-20842","spans":[{"id":"spn-22124","text":"Opens Studio at http://127.0.0.1:54323"}]}]]},{"id":"blk-20843","kind":"paragraph","spans":[{"id":"spn-22125","text":"Endpoints after "},{"id":"spn-22126","marks":["code"],"text":"db:start"},{"id":"spn-22127","text":":"}]},{"id":"blk-20844","items":[{"blocks":[{"id":"blk-20846","kind":"paragraph","spans":[{"id":"spn-22128","text":"API / PostgREST → http://127.0.0.1:54321"}]}],"id":"blk-20845","kind":"list-item"},{"blocks":[{"id":"blk-20848","kind":"paragraph","spans":[{"id":"spn-22129","text":"Postgres → "},{"id":"spn-22130","marks":["code"],"text":"postgresql://postgres:postgres@127.0.0.1:54322/postgres"}]}],"id":"blk-20847","kind":"list-item"},{"blocks":[{"id":"blk-20850","kind":"paragraph","spans":[{"id":"spn-22131","text":"Studio → http://127.0.0.1:54323"}]}],"id":"blk-20849","kind":"list-item"},{"blocks":[{"id":"blk-20852","kind":"paragraph","spans":[{"id":"spn-22132","text":"Mailpit → http://127.0.0.1:54324"}]}],"id":"blk-20851","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-20853","kind":"paragraph","span