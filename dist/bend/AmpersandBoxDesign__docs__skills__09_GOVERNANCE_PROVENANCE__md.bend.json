{"bendscript":"0.1","blocks":[{"id":"blk-15269","kind":"heading","level":1,"spans":[{"id":"spn-14156","text":"Skill 09 — Governance and Provenance"}]},{"blocks":[{"id":"blk-15271","kind":"paragraph","spans":[{"id":"spn-14157","text":"Declaring governance constraints, escalation rules, autonomy levels, and hash-linked provenance chains in agent declarations."}]}],"id":"blk-15270","kind":"quote"},{"id":"blk-15272","kind":"paragraph","spans":[{"id":"spn-14158","text":"---"}]},{"id":"blk-15273","kind":"heading","level":2,"spans":[{"id":"spn-14159","text":"Why This Matters"}]},{"id":"blk-15274","kind":"paragraph","spans":[{"id":"spn-14160","text":"Capabilities without governance are unconstrained. Provenance without governance has no enforcement. Governance without provenance has no audit trail. Together, they make agents trustworthy and accountable."}]},{"id":"blk-15275","kind":"paragraph","spans":[{"id":"spn-14161","text":"---"}]},{"id":"blk-15276","kind":"heading","level":2,"spans":[{"id":"spn-14162","text":"Hard Constraints"}]},{"id":"blk-15277","kind":"paragraph","spans":[{"id":"spn-14163","text":"Hard constraints are "},{"id":"spn-14164","marks":["bold"],"text":"inviolable"},{"id":"spn-14165","text":". Implementations MUST prevent violation. They are strings declaring absolute boundaries:"}]},{"id":"blk-15278","kind":"code","language":"json","text":"\"hard\": [\n  \"Never scale beyond 3x in a single action\",\n  \"Never authorize expenditures above $10,000\",\n  \"Never modify production systems without approval\"\n]"},{"id":"blk-15279","kind":"heading","level":3,"spans":[{"id":"spn-14166","text":"Rules for hard constraints"}]},{"id":"blk-15280","items":[{"blocks":[{"id":"blk-15282","kind":"paragraph","spans":[{"id":"spn-14167","text":"They are enforced at the runtime level, not just advisory"}]}],"id":"blk-15281","kind":"list-item"},{"blocks":[{"id":"blk-15284","kind":"paragraph","spans":[{"id":"spn-14168","text":"Violation of a hard constraint is a system failure, not a judgment call"}]}],"id":"blk-15283","kind":"list-item"},{"blocks":[{"id":"blk-15286","kind":"paragraph","spans":[{"id":"spn-14169","text":"They apply to all capability operations regardless of pipeline"}]}],"id":"blk-15285","kind":"list-item"},{"blocks":[{"id":"blk-15288","kind":"paragraph","spans":[{"id":"spn-14170","text":"Multiple hard constraints are conjunctive (all must hold)"}]}],"id":"blk-15287","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15289","kind":"paragraph","spans":[{"id":"spn-14171","text":"---"}]},{"id":"blk-15290","kind":"heading","level":2,"spans":[{"id":"spn-14172","text":"Soft Constraints"}]},{"id":"blk-15291","kind":"paragraph","spans":[{"id":"spn-14173","text":"Soft constraints are "},{"id":"spn-14174","marks":["bold"],"text":"preferences"},{"id":"spn-14175","text":". They are passed to reasoning capabilities and MAY be overridden with evidence:"}]},{"id":"blk-15292","kind":"code","language":"json","text":"\"soft\": [\n  \"Prefer gradual scaling over spikes\",\n  \"Prefer reversible actions over irreversible ones\",\n  \"Prefer consensus when multiple options score equally\"\n]"},{"id":"blk-15293","kind":"heading","level":3,"spans":[{"id":"spn-14176","text":"Rules for soft constraints"}]},{"id":"blk-15294","items":[{"blocks":[{"id":"blk-15296","kind":"paragraph","spans":[{"id":"spn-14177","text":"They inform reasoning but do not block action"}]}],"id":"blk-15295","kind":"list-item"},{"blocks":[{"id":"blk-15298","kind":"paragraph","spans":[{"id":"spn-14178","text":"A reasoning capability may override a soft constraint if it provides"}]}],"id":"blk-15297","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15299","kind":"paragraph","spans":[{"id":"spn-14179","text":"evidence justifying the override"}]},{"id":"blk-15300","items":[{"blocks":[{"id":"blk-15302","kind":"paragraph","spans":[{"id":"spn-14180","text":"Overrides should be recorded in the provenance chain"}]}],"id":"blk-15301","kind":"list-item"},{"blocks":[{"id":"blk-15304","kind":"paragraph","spans":[{"id":"spn-14181","text":"They are advisory for non-reasoning capabilities"}]}],"id":"blk-15303","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15305","kind":"paragraph","spans":[{"id":"spn-14182","text":"---"}]},{"id":"blk-15306","kind":"heading","level":2,"spans":[{"id":"spn-14183","text":"Escalation Triggers"}]},{"id":"blk-15307","kind":"paragraph","spans":[{"id":"spn-14184","text":"Escalation rules define when an agent MUST defer to a human:"}]},{"id":"blk-15308","kind":"code","language":"json","text":"\"escalate_when\": {\n  \"confidence_below\": 0.7,\n  \"cost_exceeds_usd\": 1000,\n  \"hard_boundary_approached\": true\n}"},{"head":[{"id":"blk-15310","spans":[{"id":"spn-14185","text":"Trigger"}]},{"id":"blk-15311","spans":[{"id":"spn-14186","text":"Semantics"}]}],"id":"blk-15309","kind":"table","rows":[[{"id":"blk-15312","spans":[{"id":"spn-14187","marks":["code"],"text":"confidence_below"}]},{"id":"blk-15313","spans":[{"id":"spn-14188","text":"Escalate if reasoning confidence drops below threshold"}]}],[{"id":"blk-15314","spans":[{"id":"spn-14189","marks":["code"],"text":"cost_exceeds_usd"}]},{"id":"blk-15315","spans":[{"id":"spn-14190","text":"Escalate if action cost exceeds dollar amount"}]}],[{"id":"blk-15316","spans":[{"id":"spn-14191","marks":["code"],"text":"hard_boundary_approached"}]},{"id":"blk-15317","spans":[{"id":"spn-14192","text":"Escalate if action is near a hard constraint boundary"}]}]]},{"id":"blk-15318","kind":"paragraph","spans":[{"id":"spn-14193","text":"Triggers are disjunctive — any single trigger firing causes escalation."}]},{"id":"blk-15319","kind":"heading","level":3,"spans":[{"id":"spn-14194","text":"Custom escalation triggers"}]},{"id":"blk-15320","kind":"paragraph","spans":[{"id":"spn-14195","text":"The "},{"id":"spn-14196","marks":["code"],"text":"escalate_when"},{"id":"spn-14197","text":" object supports arbitrary key-value pairs. Providers interpret the triggers they understand and ignore the rest:"}]},{"id":"blk-15321","kind":"code","language":"json","text":"\"escalate_when\": {\n  \"confidence_below\": 0.6,\n  \"latency_exceeds_ms\": 5000,\n  \"affected_users_above\": 1000\n}"},{"id":"blk-15322","kind":"paragraph","spans":[{"id":"spn-14198","text":"---"}]},{"id":"blk-15323","kind":"heading","level":2,"spans":[{"id":"spn-14199","text":"Autonomy Levels"}]},{"id":"blk-15324","kind":"paragraph","spans":[{"id":"spn-14200","text":"The "},{"id":"spn-14201","marks":["code"],"text":"autonomy"},{"id":"spn-14202","text":" block controls proactive behavior:"}]},{"id":"blk-15325","kind":"code","language":"json","text":"\"autonomy\": {\n  \"level\": \"advise\",\n  \"model_tier\": \"local_small\",\n  \"heartbeat_seconds\": 300,\n  \"budget\": {\n    \"max_actions_per_hour\": 5,\n    \"max_deliberation_calls_per_query\": 1,\n    \"require_approval_for\": [\"act\", \"propose\"]\n  }\n}"},{"id":"blk-15326","kind":"heading","level":3,"spans":[{"id":"spn-14203","text":"Autonomy levels"}]},{"head":[{"id":"blk-15328","spans":[{"id":"spn-14204","text":"Level"}]},{"id":"blk-15329","spans":[{"id":"spn-14205","text":"Behavior"}]}],"id":"blk-15327","kind":"table","rows":[[{"id":"blk-15330","spans":[{"id":"spn-14206","marks":["code"],"text":"observe"}]},{"id":"blk-15331","spans":[{"id":"spn-14207","text":"Survey and log only. Take no action. Safe default for new deployments."}]}],[{"id":"blk-15332","spans":[{"id":"spn-14208","marks":["code"],"text":"advise"}]},{"id":"blk-15333","spans":[{"id":"spn-14209","text":"Propose actions, wait for approval. Typical production mode."}]}],[{"id":"blk-15334","spans":[{"id":"spn-14210","marks":["code"],"text":"act"}]},{"id":"blk-15335","spans":[{"id":"spn-14211","text":"Execute within budget constraints. Full autonomy for high-trust agents."}]}]]},{"id":"blk-15336","kind":"heading","level":3,"spans":[{"id":"spn-14212","text":"Model tiers"}]},{"head":[{"id":"blk-15338","spans":[{"id":"spn-14213","text":"Tier"}]},{"id":"blk-15339","spans":[{"id":"spn-14214","text":"Target Hardware"}]},{"id":"blk-15340","spans":[{"id":"spn-14215","text":"Typical Budget"}]}],"id":"blk-15337","kind":"table","rows":[[{"id":"blk-15341","spans":[{"id":"spn-14216","marks":["code"],"text":"local_small"}]},{"id":"blk-15342","spans":[{"id":"spn-14217","text":"8B parameter models"}]},{"id":"blk-15343","spans":[{"id":"spn-14218","text":"Shallow deliberation, fast attention"}]}],[{"id":"blk-15344","spans":[{"id":"spn-14219","marks":["code"],"text":"local_large"}]},{"id":"blk-15345","spans":[{"id":"spn-14220","text":"70B+ parameter models"}]},{"id":"blk-15346","spans":[{"id":"spn-14221","text":"Deeper deliberation, broader attention"}]}],[{"id":"blk-15347","spans":[{"id":"spn-14222","marks":["code"],"text":"cloud_frontier"}]},{"id":"blk-15348","spans":[{"id":"spn-14223","text":"Cloud-hosted frontier models"}]},{"id":"blk-15349","spans":[{"id":"spn-14224","text":"Full deliberation depth"}]}]]},{"id":"blk-15350","kind":"heading","level":3,"spans":[{"id":"spn-14225","text":"Governance hierarchy"}]},{"id":"blk-15351","kind":"paragraph","spans":[{"id":"spn-14226","text":"Autonomy levels compose hierarchically. An organization-level policy of "},{"id":"spn-14227","marks":["code"],"text":"advise"},{"id":"spn-14228","text":" will downgrade any agent declaring "},{"id":"spn-14229","marks":["code"],"text":"act"},{"id":"spn-14230","text":":"}]},{"id":"blk-15352","kind":"code","language":"text","text":"Org policy: advise  +  Agent declaration: act  →  Effective: advise\nOrg policy: act     +  Agent declaration: advise  →  Effective: advise"},{"id":"blk-15353","kind":"paragraph","spans":[{"id":"spn-14231","text":"The effective level is always the minimum of the org policy and the agent declaration. This is enforced by Delegatic governance policies."}]},{"id":"blk-15354","kind":"paragraph","spans":[{"id":"spn-14232","text":"---"}]},{"id":"blk-15355","kind":"heading","level":2,"spans":[{"id":"spn-14233","text":"Provenance Records"}]},{"id":"blk-15356","kind":"paragraph","spans":[{"id":"spn-14234","text":"When "},{"id":"spn-14235","marks":["code"],"text":"\"provenance\": true"},{"id":"spn-14236","text":", every capability operation appends a hash-linked record to the provenance chain:"}]},{"id":"blk-15357","kind":"code","language":"json","text":"{\n  \"source\": \"&time.anomaly\",\n  \"provider\": \"ticktickclock\",\n  \"operation\": \"detect\",\n  \"timestamp\": \"2026-03-14T14:23:07Z\",\n  \"input_hash\": \"sha256:a3f8...\",\n  \"output_hash\": \"sha256:7b2c...\",\n  \"parent_hash\": \"sha256:0000...\",\n  \"mcp_trace_id\": \"ttc-inv-9f3a...\"\n}"},{"head":[{"id":"blk-15359","spans":[{"id":"spn-14237","text":"Field"}]},{"id":"blk-15360","spans":[{"id":"spn-14238","text":"Description"}]}],"id":"blk-15358","kind":"table","rows":[[{"id":"blk-15361","spans":[{"id":"spn-14239","marks":["code"],"text":"source"}]},{"id":"blk-15362","spans":[{"id":"spn-14240","text":"Capability that performed the operation"}]}],[{"id":"blk-15363","spans":[{"id":"spn-14241","marks":["code"],"text":"provider"}]},{"id":"blk-15364","spans":[{"id":"spn-14242","text":"Provider that executed it"}]}],[{"id":"blk-15365","spans":[{"id":"spn-14243","marks":["code"],"text":"operation"}]},{"id":"blk-15366","spans":[{"id":"spn-14244","text":"Operation name from the contract"}]}],[{"id":"blk-15367","spans":[{"id":"spn-14245","marks":["code"],"text":"timestamp"}]},{"id":"blk-15368","spans":[{"id":"spn-14246","text":"ISO 8601 timestamp"}]}],[{"id":"blk-15369","spans":[{"id":"spn-14247","marks":["code"],"text":"input_hash"}]},{"id":"blk-15370","spans":[{"id":"spn-14248","text":"SHA-256 hash of the input payload"}]}],[{"id":"blk-15371","spans":[{"id":"spn-14249","marks":["code"],"text":"output_hash"}]},{"id":"blk-15372","spans":[{"id":"spn-14250","text":"SHA-256 hash of the output payload"}]}],[{"id":"blk-15373","spans":[{"id":"spn-14251","marks":["code"],"text":"parent_hash"}]},{"id":"blk-15374","spans":[{"id":"spn-14252","text":"Hash of the previous record in the chain"}]}],[{"id":"blk-15375","spans":[{"id":"spn-14253","marks":["code"],"text":"mcp_trace_id"}]},{"id":"blk-15376","spans":[{"id":"spn-14254","text":"MCP invocation trace ID"}]}]]},{"id":"blk-15377","kind":"heading","level":3,"spans":[{"id":"spn-14255","text":"Hash linking"}]},{"id":"blk-15378","kind":"paragraph","spans":[{"id":"spn-14256","text":"Records form a chain via "},{"id":"spn-14257","marks":["code"],"text":"parent_hash"},{"id":"spn-14258","text":". The first record in a pipeline references "},{"id":"spn-14259","marks":["code"],"text":"sha256:0000..."},{"id":"spn-14260","text":" (genesis). Each subsequent record references the previous record's hash. This creates an immutable, verifiable audit trail."}]},{"id":"blk-15379","kind":"heading","level":3,"spans":[{"id":"spn-14261","text":"Querying provenance"}]},{"id":"blk-15380","kind":"paragraph","spans":[{"id":"spn-14262","text":"The provenance chain is queryable after pipeline execution. Use it for:"}]},{"id":"blk-15381","items":[{"blocks":[{"id":"blk-15383","kind":"paragraph","spans":[{"id":"spn-14263","marks":["bold"],"text":"Audit"},{"id":"spn-14264","text":": Trace which capabilities contributed to a decision"}]}],"id":"blk-15382","kind":"list-item"},{"blocks":[{"id":"blk-15385","kind":"paragraph","spans":[{"id":"spn-14265","marks":["bold"],"text":"Debugging"},{"id":"spn-14266","text":": Identify where a pipeline produced unexpected results"}]}],"id":"blk-15384","kind":"list-item"},{"blocks":[{"id":"blk-15387","kind":"paragraph","spans":[{"id":"spn-14267","marks":["bold"],"text":"Compliance"},{"id":"spn-14268","text":": Prove that governance constraints were respected"}]}],"id":"blk-15386","kind":"list-item"},{"blocks":[{"id":"blk-15389","kind":"paragraph","spans":[{"id":"spn-14269","marks":["bold"],"text":"Reproducibility"},{"id":"spn-14270","text":": Replay a pipeline with the same inputs"}]}],"id":"blk-15388","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15390","kind":"paragraph","spans":[{"id":"spn-14271","text":"---"}]},{"id":"blk-15391","kind":"heading","level":2,"spans":[{"id":"spn-14272","text":"Governance Composition"}]},{"id":"blk-15392","kind":"paragraph","spans":[{"id":"spn-14273","text":"When capabilities compose, their governance constraints merge:"}]},{"id":"blk-15393","kind":"heading","level":3,"spans":[{"id":"spn-14274","text":"Hard constraint merging"}]},{"id":"blk-15394","kind":"paragraph","spans":[{"id":"spn-14275","text":"All hard constraints from all composed capabilities are collected into a single conjunctive set. None may be violated."}]},{"id":"blk-15395","kind":"heading","level":3,"spans":[{"id":"spn-14276","text":"Soft constraint merging"}]},{"id":"blk-15396","kind":"paragraph","spans":[{"id":"spn-14277","text":"Soft constraints are collected and passed to reasoning capabilities. When soft constraints conflict, the reasoning capability decides based on evidence. The resolution is recorded in provenance."}]},{"id":"blk-15397","kind":"heading","level":3,"spans":[{"id":"spn-14278","text":"Escalation trigger merging"}]},{"id":"blk-15398","kind":"paragraph","spans":[{"id":"spn-14279","text":"Escalation triggers are merged disjunctively. If any trigger fires, escalation occurs. The most conservative trigger wins."}]},{"id":"blk-15399","kind":"heading","level":3,"spans":[{"id":"spn-14280","text":"Autonomy level merging"}]},{"id":"blk-15400","kind":"paragraph","spans":[{"id":"spn-14281","text":"The effective autonomy level is the minimum across all governance sources (agent declaration, org policy, runtime override)."}]},{"id":"blk-15401","kind":"paragraph","spans":[{"id":"spn-14282","text":"---"}]},{"id":"blk-15402","kind":"heading","level":2,"spans":[{"id":"spn-14283","text":"Integration with Delegatic"}]},{"id":"blk-15403","kind":"paragraph","spans":[{"id":"spn-14284","text":"Delegatic is the governance provider in the [&] Protocol ecosystem. It manages:"}]},{"id":"blk-15404","items":[{"blocks":[{"id":"blk-15406","kind":"paragraph","spans":[{"id":"spn-14285","text":"Organization-level autonomy caps"}]}],"id":"blk-15405","kind":"list-item"},{"blocks":[{"id":"blk-15408","kind":"paragraph","spans":[{"id":"spn-14286","text":"Cross-agent governance policies"}]}],"id":"blk-15407","kind":"list-item"},{"blocks":[{"id":"blk-15410","kind":"paragraph","spans":[{"id":"spn-14287","text":"Escalation routing (who gets notified)"}]}],"id":"blk-15409","kind":"list-item"},{"blocks":[{"id":"blk-15412","kind":"paragraph","spans":[{"id":"spn-14288","text":"Approval workflows"}]}],"id":"blk-15411","kind":"list-item"},{"blocks":[{"id":"blk-15414","kind":"paragraph","spans":[{"id":"spn-14289","text":"Policy versioning and audit"}]}],"id":"blk-15413","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15415","kind":"paragraph","spans":[{"id":"spn-14290","text":"When an agent declares "},{"id":"spn-14291","marks":["code"],"text":"&reason.argument"},{"id":"spn-14292","text":" with "},{"id":"spn-14293","marks":["code"],"text":"provider: \"deliberatic\""},{"id":"spn-14294","text":", the governance block is passed to Deliberatic for enforcement. Delegatic policies can override agent-level governance when org-level constraints are stricter."}]},{"id":"blk-15416","kind":"paragraph","spans":[{"id":"spn-14295","text":"---"}]},{"id":"blk-15417","kind":"heading","level":2,"spans":[{"id":"spn-14296","text":"Common Governance Patterns"}]},{"head":[{"id":"blk-15419","spans":[{"id":"spn-14297","text":"Pattern"}]},{"id":"blk-15420","spans":[{"id":"spn-14298","text":"Description"}]},{"id":"blk-15421","spans":[{"id":"spn-14299","text":"Key Fields"}]}],"id":"blk-15418","kind":"table","rows":[[{"id":"blk-15422","spans":[{"id":"spn-14300","marks":["bold"],"text":"Read-only observer"}]},{"id":"blk-15423","spans":[{"id":"spn-14301","text":"Agent monitors but never acts"}]},{"id":"blk-15424","spans":[{"id":"spn-14302","marks":["code"],"text":"level: \"observe\""},{"id":"spn-14303","text":", no soft/hard needed"}]}],[{"id":"blk-15425","spans":[{"id":"spn-14304","marks":["bold"],"text":"Advisor with guardrails"}]},{"id":"blk-15426","spans":[{"id":"spn-14305","text":"Agent proposes within bounds"}]},{"id":"blk-15427","spans":[{"id":"spn-14306","marks":["code"],"text":"level: \"advise\""},{"id":"spn-14307","text":", hard constraints, escalation"}]}],[{"id":"blk-15428","spans":[{"id":"spn-14308","marks":["bold"],"text":"Autonomous with budget"}]},{"id":"blk-15429","spans":[{"id":"spn-14309","text":"Agent acts within strict limits"}]},{"id":"blk-15430","spans":[{"id":"spn-14310","marks":["code"],"text":"level: \"act\""},{"id":"spn-14311","text":", budget caps, hard constraints"}]}],[{"id":"blk-15431","spans":[{"id":"spn-14312","marks":["bold"],"text":"Compliance-first"}]},{"id":"blk-15432","spans":[{"id":"spn-14313","text":"Full audit trail, conservative escalation"}]},{"id":"blk-15433","spans":[{"id":"spn-14314","marks":["code"],"text":"provenance: true"},{"id":"spn-14315","text":", low confidence threshold"}]}],[{"id":"blk-15434","spans":[{"id":"spn-14316","marks":["bold"],"text":"Multi-domain corroboration"}]},{"id":"blk-15435","spans":[{"id":"spn-14317","text":"Requires evidence from multiple capabilities"}]},{"id":"blk-15436","spans":[{"id":"spn-14318","text":"Hard constraint requiring multi-domain evidence"}]}]]}],"edges":[],"id":"bagaaieray3wknxe2h7f5ounuivagn74hcw2fyiejazen5or4user2dfue76q","vocabulary":"ampersand.docs.fs.v1"}