{"bendscript":"0.1","blocks":[{"id":"blk-17078","kind":"heading","level":1,"spans":[{"id":"spn-15458","text":"Skill 09 — Governance and Provenance"}]},{"blocks":[{"id":"blk-17080","kind":"paragraph","spans":[{"id":"spn-15459","text":"Declaring governance constraints, escalation rules, autonomy levels, and hash-linked provenance chains in agent declarations."}]}],"id":"blk-17079","kind":"quote"},{"id":"blk-17081","kind":"heading","level":2,"spans":[{"id":"spn-15460","text":"Why This Matters"}]},{"id":"blk-17082","kind":"paragraph","spans":[{"id":"spn-15461","text":"Capabilities without governance are unconstrained. Provenance without governance has no enforcement. Governance without provenance has no audit trail. Together, they make agents trustworthy and accountable."}]},{"id":"blk-17083","kind":"heading","level":2,"spans":[{"id":"spn-15462","text":"Hard Constraints"}]},{"id":"blk-17084","kind":"paragraph","spans":[{"id":"spn-15463","text":"Hard constraints are "},{"id":"spn-15464","marks":["bold"],"text":"inviolable"},{"id":"spn-15465","text":". Implementations MUST prevent violation. They are strings declaring absolute boundaries:"}]},{"id":"blk-17085","kind":"code","language":"json","text":"\"hard\": [\n  \"Never scale beyond 3x in a single action\",\n  \"Never authorize expenditures above $10,000\",\n  \"Never modify production systems without approval\"\n]"},{"id":"blk-17086","kind":"heading","level":3,"spans":[{"id":"spn-15466","text":"Rules for hard constraints"}]},{"id":"blk-17087","items":[{"blocks":[{"id":"blk-17089","kind":"paragraph","spans":[{"id":"spn-15467","text":"They are enforced at the runtime level, not just advisory"}]}],"id":"blk-17088","kind":"list-item"},{"blocks":[{"id":"blk-17091","kind":"paragraph","spans":[{"id":"spn-15468","text":"Violation of a hard constraint is a system failure, not a judgment call"}]}],"id":"blk-17090","kind":"list-item"},{"blocks":[{"id":"blk-17093","kind":"paragraph","spans":[{"id":"spn-15469","text":"They apply to all capability operations regardless of pipeline"}]}],"id":"blk-17092","kind":"list-item"},{"blocks":[{"id":"blk-17095","kind":"paragraph","spans":[{"id":"spn-15470","text":"Multiple hard constraints are conjunctive (all must hold)"}]}],"id":"blk-17094","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17096","kind":"heading","level":2,"spans":[{"id":"spn-15471","text":"Soft Constraints"}]},{"id":"blk-17097","kind":"paragraph","spans":[{"id":"spn-15472","text":"Soft constraints are "},{"id":"spn-15473","marks":["bold"],"text":"preferences"},{"id":"spn-15474","text":". They are passed to reasoning capabilities and MAY be overridden with evidence:"}]},{"id":"blk-17098","kind":"code","language":"json","text":"\"soft\": [\n  \"Prefer gradual scaling over spikes\",\n  \"Prefer reversible actions over irreversible ones\",\n  \"Prefer consensus when multiple options score equally\"\n]"},{"id":"blk-17099","kind":"heading","level":3,"spans":[{"id":"spn-15475","text":"Rules for soft constraints"}]},{"id":"blk-17100","items":[{"blocks":[{"id":"blk-17102","kind":"paragraph","spans":[{"id":"spn-15476","text":"They inform reasoning but do not block action"}]}],"id":"blk-17101","kind":"list-item"},{"blocks":[{"id":"blk-17104","kind":"paragraph","spans":[{"id":"spn-15477","text":"A reasoning capability may override a soft constraint if it provides"}]}],"id":"blk-17103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17105","kind":"paragraph","spans":[{"id":"spn-15478","text":"evidence justifying the override"}]},{"id":"blk-17106","items":[{"blocks":[{"id":"blk-17108","kind":"paragraph","spans":[{"id":"spn-15479","text":"Overrides should be recorded in the provenance chain"}]}],"id":"blk-17107","kind":"list-item"},{"blocks":[{"id":"blk-17110","kind":"paragraph","spans":[{"id":"spn-15480","text":"They are advisory for non-reasoning capabilities"}]}],"id":"blk-17109","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17111","kind":"heading","level":2,"spans":[{"id":"spn-15481","text":"Escalation Triggers"}]},{"id":"blk-17112","kind":"paragraph","spans":[{"id":"spn-15482","text":"Escalation rules define when an agent MUST defer to a human:"}]},{"id":"blk-17113","kind":"code","language":"json","text":"\"escalate_when\": {\n  \"confidence_below\": 0.7,\n  \"cost_exceeds_usd\": 1000,\n  \"hard_boundary_approached\": true\n}"},{"head":[{"id":"blk-17115","spans":[{"id":"spn-15483","text":"Trigger"}]},{"id":"blk-17116","spans":[{"id":"spn-15484","text":"Semantics"}]}],"id":"blk-17114","kind":"table","rows":[[{"id":"blk-17117","spans":[{"id":"spn-15485","marks":["code"],"text":"confidence_below"}]},{"id":"blk-17118","spans":[{"id":"spn-15486","text":"Escalate if reasoning confidence drops below threshold"}]}],[{"id":"blk-17119","spans":[{"id":"spn-15487","marks":["code"],"text":"cost_exceeds_usd"}]},{"id":"blk-17120","spans":[{"id":"spn-15488","text":"Escalate if action cost exceeds dollar amount"}]}],[{"id":"blk-17121","spans":[{"id":"spn-15489","marks":["code"],"text":"hard_boundary_approached"}]},{"id":"blk-17122","spans":[{"id":"spn-15490","text":"Escalate if action is near a hard constraint boundary"}]}]]},{"id":"blk-17123","kind":"paragraph","spans":[{"id":"spn-15491","text":"Triggers are disjunctive — any single trigger firing causes escalation."}]},{"id":"blk-17124","kind":"heading","level":3,"spans":[{"id":"spn-15492","text":"Custom escalation triggers"}]},{"id":"blk-17125","kind":"paragraph","spans":[{"id":"spn-15493","text":"The "},{"id":"spn-15494","marks":["code"],"text":"escalate_when"},{"id":"spn-15495","text":" object supports arbitrary key-value pairs. Providers interpret the triggers they understand and ignore the rest:"}]},{"id":"blk-17126","kind":"code","language":"json","text":"\"escalate_when\": {\n  \"confidence_below\": 0.6,\n  \"latency_exceeds_ms\": 5000,\n  \"affected_users_above\": 1000\n}"},{"id":"blk-17127","kind":"heading","level":2,"spans":[{"id":"spn-15496","text":"Autonomy Levels"}]},{"id":"blk-17128","kind":"paragraph","spans":[{"id":"spn-15497","text":"The "},{"id":"spn-15498","marks":["code"],"text":"autonomy"},{"id":"spn-15499","text":" block controls proactive behavior:"}]},{"id":"blk-17129","kind":"code","language":"json","text":"\"autonomy\": {\n  \"level\": \"advise\",\n  \"model_tier\": \"local_small\",\n  \"heartbeat_seconds\": 300,\n  \"budget\": {\n    \"max_actions_per_hour\": 5,\n    \"max_deliberation_calls_per_query\": 1,\n    \"require_approval_for\": [\"act\", \"propose\"]\n  }\n}"},{"id":"blk-17130","kind":"heading","level":3,"spans":[{"id":"spn-15500","text":"Autonomy levels"}]},{"head":[{"id":"blk-17132","spans":[{"id":"spn-15501","text":"Level"}]},{"id":"blk-17133","spans":[{"id":"spn-15502","text":"Behavior"}]}],"id":"blk-17131","kind":"table","rows":[[{"id":"blk-17134","spans":[{"id":"spn-15503","marks":["code"],"text":"observe"}]},{"id":"blk-17135","spans":[{"id":"spn-15504","text":"Survey and log only. Take no action. Safe default for new deployments."}]}],[{"id":"blk-17136","spans":[{"id":"spn-15505","marks":["code"],"text":"advise"}]},{"id":"blk-17137","spans":[{"id":"spn-15506","text":"Propose actions, wait for approval. Typical production mode."}]}],[{"id":"blk-17138","spans":[{"id":"spn-15507","marks":["code"],"text":"act"}]},{"id":"blk-17139","spans":[{"id":"spn-15508","text":"Execute within budget constraints. Full autonomy for high-trust agents."}]}]]},{"id":"blk-17140","kind":"heading","level":3,"spans":[{"id":"spn-15509","text":"Model tiers"}]},{"head":[{"id":"blk-17142","spans":[{"id":"spn-15510","text":"Tier"}]},{"id":"blk-17143","spans":[{"id":"spn-15511","text":"Target Hardware"}]},{"id":"blk-17144","spans":[{"id":"spn-15512","text":"Typical Budget"}]}],"id":"blk-17141","kind":"table","rows":[[{"id":"blk-17145","spans":[{"id":"spn-15513","marks":["code"],"text":"local_small"}]},{"id":"blk-17146","spans":[{"id":"spn-15514","text":"8B parameter models"}]},{"id":"blk-17147","spans":[{"id":"spn-15515","text":"Shallow deliberation, fast attention"}]}],[{"id":"blk-17148","spans":[{"id":"spn-15516","marks":["code"],"text":"local_large"}]},{"id":"blk-17149","spans":[{"id":"spn-15517","text":"70B+ parameter models"}]},{"id":"blk-17150","spans":[{"id":"spn-15518","text":"Deeper deliberation, broader attention"}]}],[{"id":"blk-17151","spans":[{"id":"spn-15519","marks":["code"],"text":"cloud_frontier"}]},{"id":"blk-17152","spans":[{"id":"spn-15520","text":"Cloud-hosted frontier models"}]},{"id":"blk-17153","spans":[{"id":"spn-15521","text":"Full deliberation depth"}]}]]},{"id":"blk-17154","kind":"heading","level":3,"spans":[{"id":"spn-15522","text":"Governance hierarchy"}]},{"id":"blk-17155","kind":"paragraph","spans":[{"id":"spn-15523","text":"Autonomy levels compose hierarchically. An organization-level policy of "},{"id":"spn-15524","marks":["code"],"text":"advise"},{"id":"spn-15525","text":" will downgrade any agent declaring "},{"id":"spn-15526","marks":["code"],"text":"act"},{"id":"spn-15527","text":":"}]},{"id":"blk-17156","kind":"code","language":"text","text":"Org policy: advise  +  Agent declaration: act  →  Effective: advise\nOrg policy: act     +  Agent declaration: advise  →  Effective: advise"},{"id":"blk-17157","kind":"paragraph","spans":[{"id":"spn-15528","text":"The effective level is always the minimum of the org policy and the agent declaration. This is enforced by Delegatic governance policies."}]},{"id":"blk-17158","kind":"heading","level":2,"spans":[{"id":"spn-15529","text":"Provenance Records"}]},{"id":"blk-17159","kind":"paragraph","spans":[{"id":"spn-15530","text":"When "},{"id":"spn-15531","marks":["code"],"text":"\"provenance\": true"},{"id":"spn-15532","text":", every capability operation appends a hash-linked record to the provenance chain:"}]},{"id":"blk-17160","kind":"code","language":"json","text":"{\n  \"source\": \"&time.anomaly\",\n  \"provider\": \"ticktickclock\",\n  \"operation\": \"detect\",\n  \"timestamp\": \"2026-03-14T14:23:07Z\",\n  \"input_hash\": \"sha256:a3f8...\",\n  \"output_hash\": \"sha256:7b2c...\",\n  \"parent_hash\": \"sha256:0000...\",\n  \"mcp_trace_id\": \"ttc-inv-9f3a...\"\n}"},{"head":[{"id":"blk-17162","spans":[{"id":"spn-15533","text":"Field"}]},{"id":"blk-17163","spans":[{"id":"spn-15534","text":"Description"}]}],"id":"blk-17161","kind":"table","rows":[[{"id":"blk-17164","spans":[{"id":"spn-15535","marks":["code"],"text":"source"}]},{"id":"blk-17165","spans":[{"id":"spn-15536","text":"Capability that performed the operation"}]}],[{"id":"blk-17166","spans":[{"id":"spn-15537","marks":["code"],"text":"provider"}]},{"id":"blk-17167","spans":[{"id":"spn-15538","text":"Provider that executed it"}]}],[{"id":"blk-17168","spans":[{"id":"spn-15539","marks":["code"],"text":"operation"}]},{"id":"blk-17169","spans":[{"id":"spn-15540","text":"Operation name from the contract"}]}],[{"id":"blk-17170","spans":[{"id":"spn-15541","marks":["code"],"text":"timestamp"}]},{"id":"blk-17171","spans":[{"id":"spn-15542","text":"ISO 8601 timestamp"}]}],[{"id":"blk-17172","spans":[{"id":"spn-15543","marks":["code"],"text":"input_hash"}]},{"id":"blk-17173","spans":[{"id":"spn-15544","text":"SHA-256 hash of the input payload"}]}],[{"id":"blk-17174","spans":[{"id":"spn-15545","marks":["code"],"text":"output_hash"}]},{"id":"blk-17175","spans":[{"id":"spn-15546","text":"SHA-256 hash of the output payload"}]}],[{"id":"blk-17176","spans":[{"id":"spn-15547","marks":["code"],"text":"parent_hash"}]},{"id":"blk-17177","spans":[{"id":"spn-15548","text":"Hash of the previous record in the chain"}]}],[{"id":"blk-17178","spans":[{"id":"spn-15549","marks":["code"],"text":"mcp_trace_id"}]},{"id":"blk-17179","spans":[{"id":"spn-15550","text":"MCP invocation trace ID"}]}]]},{"id":"blk-17180","kind":"heading","level":3,"spans":[{"id":"spn-15551","text":"Hash linking"}]},{"id":"blk-17181","kind":"paragraph","spans":[{"id":"spn-15552","text":"Records form a chain via "},{"id":"spn-15553","marks":["code"],"text":"parent_hash"},{"id":"spn-15554","text":". The first record in a pipeline references "},{"id":"spn-15555","marks":["code"],"text":"sha256:0000..."},{"id":"spn-15556","text":" (genesis). Each subsequent record references the previous record's hash. This creates an immutable, verifiable audit trail."}]},{"id":"blk-17182","kind":"heading","level":3,"spans":[{"id":"spn-15557","text":"Querying provenance"}]},{"id":"blk-17183","kind":"paragraph","spans":[{"id":"spn-15558","text":"The provenance chain is queryable after pipeline execution. Use it for:"}]},{"id":"blk-17184","items":[{"blocks":[{"id":"blk-17186","kind":"paragraph","spans":[{"id":"spn-15559","marks":["bold"],"text":"Audit"},{"id":"spn-15560","text":": Trace which capabilities contributed to a decision"}]}],"id":"blk-17185","kind":"list-item"},{"blocks":[{"id":"blk-17188","kind":"paragraph","spans":[{"id":"spn-15561","marks":["bold"],"text":"Debugging"},{"id":"spn-15562","text":": Identify where a pipeline produced unexpected results"}]}],"id":"blk-17187","kind":"list-item"},{"blocks":[{"id":"blk-17190","kind":"paragraph","spans":[{"id":"spn-15563","marks":["bold"],"text":"Compliance"},{"id":"spn-15564","text":": Prove that governance constraints were respected"}]}],"id":"blk-17189","kind":"list-item"},{"blocks":[{"id":"blk-17192","kind":"paragraph","spans":[{"id":"spn-15565","marks":["bold"],"text":"Reproducibility"},{"id":"spn-15566","text":": Replay a pipeline with the same inputs"}]}],"id":"blk-17191","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17193","kind":"heading","level":2,"spans":[{"id":"spn-15567","text":"Governance Composition"}]},{"id":"blk-17194","kind":"paragraph","spans":[{"id":"spn-15568","text":"When capabilities compose, their governance constraints merge:"}]},{"id":"blk-17195","kind":"heading","level":3,"spans":[{"id":"spn-15569","text":"Hard constraint merging"}]},{"id":"blk-17196","kind":"paragraph","spans":[{"id":"spn-15570","text":"All hard constraints from all composed capabilities are collected into a single conjunctive set. None may be violated."}]},{"id":"blk-17197","kind":"heading","level":3,"spans":[{"id":"spn-15571","text":"Soft constraint merging"}]},{"id":"blk-17198","kind":"paragraph","spans":[{"id":"spn-15572","text":"Soft constraints are collected and passed to reasoning capabilities. When soft constraints conflict, the reasoning capability decides based on evidence. The resolution is recorded in provenance."}]},{"id":"blk-17199","kind":"heading","level":3,"spans":[{"id":"spn-15573","text":"Escalation trigger merging"}]},{"id":"blk-17200","kind":"paragraph","spans":[{"id":"spn-15574","text":"Escalation triggers are merged disjunctively. If any trigger fires, escalation occurs. The most conservative trigger wins."}]},{"id":"blk-17201","kind":"heading","level":3,"spans":[{"id":"spn-15575","text":"Autonomy level merging"}]},{"id":"blk-17202","kind":"paragraph","spans":[{"id":"spn-15576","text":"The effective autonomy level is the minimum across all governance sources (agent declaration, org policy, runtime override)."}]},{"id":"blk-17203","kind":"heading","level":2,"spans":[{"id":"spn-15577","text":"Integration with Delegatic"}]},{"id":"blk-17204","kind":"paragraph","spans":[{"id":"spn-15578","text":"Delegatic is the governance provider in the [&] Protocol ecosystem. It manages:"}]},{"id":"blk-17205","items":[{"blocks":[{"id":"blk-17207","kind":"paragraph","spans":[{"id":"spn-15579","text":"Organization-level autonomy caps"}]}],"id":"blk-17206","kind":"list-item"},{"blocks":[{"id":"blk-17209","kind":"paragraph","spans":[{"id":"spn-15580","text":"Cross-agent governance policies"}]}],"id":"blk-17208","kind":"list-item"},{"blocks":[{"id":"blk-17211","kind":"paragraph","spans":[{"id":"spn-15581","text":"Escalation routing (who gets notified)"}]}],"id":"blk-17210","kind":"list-item"},{"blocks":[{"id":"blk-17213","kind":"paragraph","spans":[{"id":"spn-15582","text":"Approval workflows"}]}],"id":"blk-17212","kind":"list-item"},{"blocks":[{"id":"blk-17215","kind":"paragraph","spans":[{"id":"spn-15583","text":"Policy versioning and audit"}]}],"id":"blk-17214","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17216","kind":"paragraph","spans":[{"id":"spn-15584","text":"When an agent declares "},{"id":"spn-15585","marks":["code"],"text":"&reason.argument"},{"id":"spn-15586","text":" with "},{"id":"spn-15587","marks":["code"],"text":"provider: \"deliberatic\""},{"id":"spn-15588","text":", the governance block is passed to Deliberatic for enforcement. Delegatic policies can override agent-level governance when org-level constraints are stricter."}]},{"id":"blk-17217","kind":"heading","level":2,"spans":[{"id":"spn-15589","text":"Common Governance Patterns"}]},{"head":[{"id":"blk-17219","spans":[{"id":"spn-15590","text":"Pattern"}]},{"id":"blk-17220","spans":[{"id":"spn-15591","text":"Description"}]},{"id":"blk-17221","spans":[{"id":"spn-15592","text":"Key Fields"}]}],"id":"blk-17218","kind":"table","rows":[[{"id":"blk-17222","spans":[{"id":"spn-15593","marks":["bold"],"text":"Read-only observer"}]},{"id":"blk-17223","spans":[{"id":"spn-15594","text":"Agent monitors but never acts"}]},{"id":"blk-17224","spans":[{"id":"spn-15595","marks":["code"],"text":"level: \"observe\""},{"id":"spn-15596","text":", no soft/hard needed"}]}],[{"id":"blk-17225","spans":[{"id":"spn-15597","marks":["bold"],"text":"Advisor with guardrails"}]},{"id":"blk-17226","spans":[{"id":"spn-15598","text":"Agent proposes within bounds"}]},{"id":"blk-17227","spans":[{"id":"spn-15599","marks":["code"],"text":"level: \"advise\""},{"id":"spn-15600","text":", hard constraints, escalation"}]}],[{"id":"blk-17228","spans":[{"id":"spn-15601","marks":["bold"],"text":"Autonomous with budget"}]},{"id":"blk-17229","spans":[{"id":"spn-15602","text":"Agent acts within strict limits"}]},{"id":"blk-17230","spans":[{"id":"spn-15603","marks":["code"],"text":"level: \"act\""},{"id":"spn-15604","text":", budget caps, hard constraints"}]}],[{"id":"blk-17231","spans":[{"id":"spn-15605","marks":["bold"],"text":"Compliance-first"}]},{"id":"blk-17232","spans":[{"id":"spn-15606","text":"Full audit trail, conservative escalation"}]},{"id":"blk-17233","spans":[{"id":"spn-15607","marks":["code"],"text":"provenance: true"},{"id":"spn-15608","text":", low confidence threshold"}]}],[{"id":"blk-17234","spans":[{"id":"spn-15609","marks":["bold"],"text":"Multi-domain corroboration"}]},{"id":"blk-17235","spans":[{"id":"spn-15610","text":"Requires evidence from multiple capabilities"}]},{"id":"blk-17236","spans":[{"id":"spn-15611","text":"Hard constraint requiring multi-domain evidence"}]}]]}],"edges":[],"id":"bagaaierajjcrmh7tlphbmnmhzuwp7usijbzexqmhgw42zs5ncvjva2soquia","vocabulary":"ampersand.docs.fs.v1"}