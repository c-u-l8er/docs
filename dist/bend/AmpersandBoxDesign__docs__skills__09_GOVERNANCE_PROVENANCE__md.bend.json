{"bendscript":"0.1","blocks":[{"id":"blk-17080","kind":"heading","level":1,"spans":[{"id":"spn-15258","text":"Skill 09 — Governance and Provenance"}]},{"blocks":[{"id":"blk-17082","kind":"paragraph","spans":[{"id":"spn-15259","text":"Declaring governance constraints, escalation rules, autonomy levels, and hash-linked provenance chains in agent declarations."}]}],"id":"blk-17081","kind":"quote"},{"id":"blk-17083","kind":"heading","level":2,"spans":[{"id":"spn-15260","text":"Why This Matters"}]},{"id":"blk-17084","kind":"paragraph","spans":[{"id":"spn-15261","text":"Capabilities without governance are unconstrained. Provenance without governance has no enforcement. Governance without provenance has no audit trail. Together, they make agents trustworthy and accountable."}]},{"id":"blk-17085","kind":"heading","level":2,"spans":[{"id":"spn-15262","text":"Hard Constraints"}]},{"id":"blk-17086","kind":"paragraph","spans":[{"id":"spn-15263","text":"Hard constraints are "},{"id":"spn-15264","marks":["bold"],"text":"inviolable"},{"id":"spn-15265","text":". Implementations MUST prevent violation. They are strings declaring absolute boundaries:"}]},{"id":"blk-17087","kind":"code","language":"json","text":"\"hard\": [\n  \"Never scale beyond 3x in a single action\",\n  \"Never authorize expenditures above $10,000\",\n  \"Never modify production systems without approval\"\n]"},{"id":"blk-17088","kind":"heading","level":3,"spans":[{"id":"spn-15266","text":"Rules for hard constraints"}]},{"id":"blk-17089","items":[{"blocks":[{"id":"blk-17091","kind":"paragraph","spans":[{"id":"spn-15267","text":"They are enforced at the runtime level, not just advisory"}]}],"id":"blk-17090","kind":"list-item"},{"blocks":[{"id":"blk-17093","kind":"paragraph","spans":[{"id":"spn-15268","text":"Violation of a hard constraint is a system failure, not a judgment call"}]}],"id":"blk-17092","kind":"list-item"},{"blocks":[{"id":"blk-17095","kind":"paragraph","spans":[{"id":"spn-15269","text":"They apply to all capability operations regardless of pipeline"}]}],"id":"blk-17094","kind":"list-item"},{"blocks":[{"id":"blk-17097","kind":"paragraph","spans":[{"id":"spn-15270","text":"Multiple hard constraints are conjunctive (all must hold)"}]}],"id":"blk-17096","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17098","kind":"heading","level":2,"spans":[{"id":"spn-15271","text":"Soft Constraints"}]},{"id":"blk-17099","kind":"paragraph","spans":[{"id":"spn-15272","text":"Soft constraints are "},{"id":"spn-15273","marks":["bold"],"text":"preferences"},{"id":"spn-15274","text":". They are passed to reasoning capabilities and MAY be overridden with evidence:"}]},{"id":"blk-17100","kind":"code","language":"json","text":"\"soft\": [\n  \"Prefer gradual scaling over spikes\",\n  \"Prefer reversible actions over irreversible ones\",\n  \"Prefer consensus when multiple options score equally\"\n]"},{"id":"blk-17101","kind":"heading","level":3,"spans":[{"id":"spn-15275","text":"Rules for soft constraints"}]},{"id":"blk-17102","items":[{"blocks":[{"id":"blk-17104","kind":"paragraph","spans":[{"id":"spn-15276","text":"They inform reasoning but do not block action"}]}],"id":"blk-17103","kind":"list-item"},{"blocks":[{"id":"blk-17106","kind":"paragraph","spans":[{"id":"spn-15277","text":"A reasoning capability may override a soft constraint if it provides"}]}],"id":"blk-17105","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17107","kind":"paragraph","spans":[{"id":"spn-15278","text":"evidence justifying the override"}]},{"id":"blk-17108","items":[{"blocks":[{"id":"blk-17110","kind":"paragraph","spans":[{"id":"spn-15279","text":"Overrides should be recorded in the provenance chain"}]}],"id":"blk-17109","kind":"list-item"},{"blocks":[{"id":"blk-17112","kind":"paragraph","spans":[{"id":"spn-15280","text":"They are advisory for non-reasoning capabilities"}]}],"id":"blk-17111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17113","kind":"heading","level":2,"spans":[{"id":"spn-15281","text":"Escalation Triggers"}]},{"id":"blk-17114","kind":"paragraph","spans":[{"id":"spn-15282","text":"Escalation rules define when an agent MUST defer to a human:"}]},{"id":"blk-17115","kind":"code","language":"json","text":"\"escalate_when\": {\n  \"confidence_below\": 0.7,\n  \"cost_exceeds_usd\": 1000,\n  \"hard_boundary_approached\": true\n}"},{"head":[{"id":"blk-17117","spans":[{"id":"spn-15283","text":"Trigger"}]},{"id":"blk-17118","spans":[{"id":"spn-15284","text":"Semantics"}]}],"id":"blk-17116","kind":"table","rows":[[{"id":"blk-17119","spans":[{"id":"spn-15285","marks":["code"],"text":"confidence_below"}]},{"id":"blk-17120","spans":[{"id":"spn-15286","text":"Escalate if reasoning confidence drops below threshold"}]}],[{"id":"blk-17121","spans":[{"id":"spn-15287","marks":["code"],"text":"cost_exceeds_usd"}]},{"id":"blk-17122","spans":[{"id":"spn-15288","text":"Escalate if action cost exceeds dollar amount"}]}],[{"id":"blk-17123","spans":[{"id":"spn-15289","marks":["code"],"text":"hard_boundary_approached"}]},{"id":"blk-17124","spans":[{"id":"spn-15290","text":"Escalate if action is near a hard constraint boundary"}]}]]},{"id":"blk-17125","kind":"paragraph","spans":[{"id":"spn-15291","text":"Triggers are disjunctive — any single trigger firing causes escalation."}]},{"id":"blk-17126","kind":"heading","level":3,"spans":[{"id":"spn-15292","text":"Custom escalation triggers"}]},{"id":"blk-17127","kind":"paragraph","spans":[{"id":"spn-15293","text":"The "},{"id":"spn-15294","marks":["code"],"text":"escalate_when"},{"id":"spn-15295","text":" object supports arbitrary key-value pairs. Providers interpret the triggers they understand and ignore the rest:"}]},{"id":"blk-17128","kind":"code","language":"json","text":"\"escalate_when\": {\n  \"confidence_below\": 0.6,\n  \"latency_exceeds_ms\": 5000,\n  \"affected_users_above\": 1000\n}"},{"id":"blk-17129","kind":"heading","level":2,"spans":[{"id":"spn-15296","text":"Autonomy Levels"}]},{"id":"blk-17130","kind":"paragraph","spans":[{"id":"spn-15297","text":"The "},{"id":"spn-15298","marks":["code"],"text":"autonomy"},{"id":"spn-15299","text":" block controls proactive behavior:"}]},{"id":"blk-17131","kind":"code","language":"json","text":"\"autonomy\": {\n  \"level\": \"advise\",\n  \"model_tier\": \"local_small\",\n  \"heartbeat_seconds\": 300,\n  \"budget\": {\n    \"max_actions_per_hour\": 5,\n    \"max_deliberation_calls_per_query\": 1,\n    \"require_approval_for\": [\"act\", \"propose\"]\n  }\n}"},{"id":"blk-17132","kind":"heading","level":3,"spans":[{"id":"spn-15300","text":"Autonomy levels"}]},{"head":[{"id":"blk-17134","spans":[{"id":"spn-15301","text":"Level"}]},{"id":"blk-17135","spans":[{"id":"spn-15302","text":"Behavior"}]}],"id":"blk-17133","kind":"table","rows":[[{"id":"blk-17136","spans":[{"id":"spn-15303","marks":["code"],"text":"observe"}]},{"id":"blk-17137","spans":[{"id":"spn-15304","text":"Survey and log only. Take no action. Safe default for new deployments."}]}],[{"id":"blk-17138","spans":[{"id":"spn-15305","marks":["code"],"text":"advise"}]},{"id":"blk-17139","spans":[{"id":"spn-15306","text":"Propose actions, wait for approval. Typical production mode."}]}],[{"id":"blk-17140","spans":[{"id":"spn-15307","marks":["code"],"text":"act"}]},{"id":"blk-17141","spans":[{"id":"spn-15308","text":"Execute within budget constraints. Full autonomy for high-trust agents."}]}]]},{"id":"blk-17142","kind":"heading","level":3,"spans":[{"id":"spn-15309","text":"Model tiers"}]},{"head":[{"id":"blk-17144","spans":[{"id":"spn-15310","text":"Tier"}]},{"id":"blk-17145","spans":[{"id":"spn-15311","text":"Target Hardware"}]},{"id":"blk-17146","spans":[{"id":"spn-15312","text":"Typical Budget"}]}],"id":"blk-17143","kind":"table","rows":[[{"id":"blk-17147","spans":[{"id":"spn-15313","marks":["code"],"text":"local_small"}]},{"id":"blk-17148","spans":[{"id":"spn-15314","text":"8B parameter models"}]},{"id":"blk-17149","spans":[{"id":"spn-15315","text":"Shallow deliberation, fast attention"}]}],[{"id":"blk-17150","spans":[{"id":"spn-15316","marks":["code"],"text":"local_large"}]},{"id":"blk-17151","spans":[{"id":"spn-15317","text":"70B+ parameter models"}]},{"id":"blk-17152","spans":[{"id":"spn-15318","text":"Deeper deliberation, broader attention"}]}],[{"id":"blk-17153","spans":[{"id":"spn-15319","marks":["code"],"text":"cloud_frontier"}]},{"id":"blk-17154","spans":[{"id":"spn-15320","text":"Cloud-hosted frontier models"}]},{"id":"blk-17155","spans":[{"id":"spn-15321","text":"Full deliberation depth"}]}]]},{"id":"blk-17156","kind":"heading","level":3,"spans":[{"id":"spn-15322","text":"Governance hierarchy"}]},{"id":"blk-17157","kind":"paragraph","spans":[{"id":"spn-15323","text":"Autonomy levels compose hierarchically. An organization-level policy of "},{"id":"spn-15324","marks":["code"],"text":"advise"},{"id":"spn-15325","text":" will downgrade any agent declaring "},{"id":"spn-15326","marks":["code"],"text":"act"},{"id":"spn-15327","text":":"}]},{"id":"blk-17158","kind":"code","language":"text","text":"Org policy: advise  +  Agent declaration: act  →  Effective: advise\nOrg policy: act     +  Agent declaration: advise  →  Effective: advise"},{"id":"blk-17159","kind":"paragraph","spans":[{"id":"spn-15328","text":"The effective level is always the minimum of the org policy and the agent declaration. This is enforced by Delegatic governance policies."}]},{"id":"blk-17160","kind":"heading","level":2,"spans":[{"id":"spn-15329","text":"Provenance Records"}]},{"id":"blk-17161","kind":"paragraph","spans":[{"id":"spn-15330","text":"When "},{"id":"spn-15331","marks":["code"],"text":"\"provenance\": true"},{"id":"spn-15332","text":", every capability operation appends a hash-linked record to the provenance chain:"}]},{"id":"blk-17162","kind":"code","language":"json","text":"{\n  \"source\": \"&time.anomaly\",\n  \"provider\": \"ticktickclock\",\n  \"operation\": \"detect\",\n  \"timestamp\": \"2026-03-14T14:23:07Z\",\n  \"input_hash\": \"sha256:a3f8...\",\n  \"output_hash\": \"sha256:7b2c...\",\n  \"parent_hash\": \"sha256:0000...\",\n  \"mcp_trace_id\": \"ttc-inv-9f3a...\"\n}"},{"head":[{"id":"blk-17164","spans":[{"id":"spn-15333","text":"Field"}]},{"id":"blk-17165","spans":[{"id":"spn-15334","text":"Description"}]}],"id":"blk-17163","kind":"table","rows":[[{"id":"blk-17166","spans":[{"id":"spn-15335","marks":["code"],"text":"source"}]},{"id":"blk-17167","spans":[{"id":"spn-15336","text":"Capability that performed the operation"}]}],[{"id":"blk-17168","spans":[{"id":"spn-15337","marks":["code"],"text":"provider"}]},{"id":"blk-17169","spans":[{"id":"spn-15338","text":"Provider that executed it"}]}],[{"id":"blk-17170","spans":[{"id":"spn-15339","marks":["code"],"text":"operation"}]},{"id":"blk-17171","spans":[{"id":"spn-15340","text":"Operation name from the contract"}]}],[{"id":"blk-17172","spans":[{"id":"spn-15341","marks":["code"],"text":"timestamp"}]},{"id":"blk-17173","spans":[{"id":"spn-15342","text":"ISO 8601 timestamp"}]}],[{"id":"blk-17174","spans":[{"id":"spn-15343","marks":["code"],"text":"input_hash"}]},{"id":"blk-17175","spans":[{"id":"spn-15344","text":"SHA-256 hash of the input payload"}]}],[{"id":"blk-17176","spans":[{"id":"spn-15345","marks":["code"],"text":"output_hash"}]},{"id":"blk-17177","spans":[{"id":"spn-15346","text":"SHA-256 hash of the output payload"}]}],[{"id":"blk-17178","spans":[{"id":"spn-15347","marks":["code"],"text":"parent_hash"}]},{"id":"blk-17179","spans":[{"id":"spn-15348","text":"Hash of the previous record in the chain"}]}],[{"id":"blk-17180","spans":[{"id":"spn-15349","marks":["code"],"text":"mcp_trace_id"}]},{"id":"blk-17181","spans":[{"id":"spn-15350","text":"MCP invocation trace ID"}]}]]},{"id":"blk-17182","kind":"heading","level":3,"spans":[{"id":"spn-15351","text":"Hash linking"}]},{"id":"blk-17183","kind":"paragraph","spans":[{"id":"spn-15352","text":"Records form a chain via "},{"id":"spn-15353","marks":["code"],"text":"parent_hash"},{"id":"spn-15354","text":". The first record in a pipeline references "},{"id":"spn-15355","marks":["code"],"text":"sha256:0000..."},{"id":"spn-15356","text":" (genesis). Each subsequent record references the previous record's hash. This creates an immutable, verifiable audit trail."}]},{"id":"blk-17184","kind":"heading","level":3,"spans":[{"id":"spn-15357","text":"Querying provenance"}]},{"id":"blk-17185","kind":"paragraph","spans":[{"id":"spn-15358","text":"The provenance chain is queryable after pipeline execution. Use it for:"}]},{"id":"blk-17186","items":[{"blocks":[{"id":"blk-17188","kind":"paragraph","spans":[{"id":"spn-15359","marks":["bold"],"text":"Audit"},{"id":"spn-15360","text":": Trace which capabilities contributed to a decision"}]}],"id":"blk-17187","kind":"list-item"},{"blocks":[{"id":"blk-17190","kind":"paragraph","spans":[{"id":"spn-15361","marks":["bold"],"text":"Debugging"},{"id":"spn-15362","text":": Identify where a pipeline produced unexpected results"}]}],"id":"blk-17189","kind":"list-item"},{"blocks":[{"id":"blk-17192","kind":"paragraph","spans":[{"id":"spn-15363","marks":["bold"],"text":"Compliance"},{"id":"spn-15364","text":": Prove that governance constraints were respected"}]}],"id":"blk-17191","kind":"list-item"},{"blocks":[{"id":"blk-17194","kind":"paragraph","spans":[{"id":"spn-15365","marks":["bold"],"text":"Reproducibility"},{"id":"spn-15366","text":": Replay a pipeline with the same inputs"}]}],"id":"blk-17193","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17195","kind":"heading","level":2,"spans":[{"id":"spn-15367","text":"Governance Composition"}]},{"id":"blk-17196","kind":"paragraph","spans":[{"id":"spn-15368","text":"When capabilities compose, their governance constraints merge:"}]},{"id":"blk-17197","kind":"heading","level":3,"spans":[{"id":"spn-15369","text":"Hard constraint merging"}]},{"id":"blk-17198","kind":"paragraph","spans":[{"id":"spn-15370","text":"All hard constraints from all composed capabilities are collected into a single conjunctive set. None may be violated."}]},{"id":"blk-17199","kind":"heading","level":3,"spans":[{"id":"spn-15371","text":"Soft constraint merging"}]},{"id":"blk-17200","kind":"paragraph","spans":[{"id":"spn-15372","text":"Soft constraints are collected and passed to reasoning capabilities. When soft constraints conflict, the reasoning capability decides based on evidence. The resolution is recorded in provenance."}]},{"id":"blk-17201","kind":"heading","level":3,"spans":[{"id":"spn-15373","text":"Escalation trigger merging"}]},{"id":"blk-17202","kind":"paragraph","spans":[{"id":"spn-15374","text":"Escalation triggers are merged disjunctively. If any trigger fires, escalation occurs. The most conservative trigger wins."}]},{"id":"blk-17203","kind":"heading","level":3,"spans":[{"id":"spn-15375","text":"Autonomy level merging"}]},{"id":"blk-17204","kind":"paragraph","spans":[{"id":"spn-15376","text":"The effective autonomy level is the minimum across all governance sources (agent declaration, org policy, runtime override)."}]},{"id":"blk-17205","kind":"heading","level":2,"spans":[{"id":"spn-15377","text":"Integration with Delegatic"}]},{"id":"blk-17206","kind":"paragraph","spans":[{"id":"spn-15378","text":"Delegatic is the governance provider in the [&] Protocol ecosystem. It manages:"}]},{"id":"blk-17207","items":[{"blocks":[{"id":"blk-17209","kind":"paragraph","spans":[{"id":"spn-15379","text":"Organization-level autonomy caps"}]}],"id":"blk-17208","kind":"list-item"},{"blocks":[{"id":"blk-17211","kind":"paragraph","spans":[{"id":"spn-15380","text":"Cross-agent governance policies"}]}],"id":"blk-17210","kind":"list-item"},{"blocks":[{"id":"blk-17213","kind":"paragraph","spans":[{"id":"spn-15381","text":"Escalation routing (who gets notified)"}]}],"id":"blk-17212","kind":"list-item"},{"blocks":[{"id":"blk-17215","kind":"paragraph","spans":[{"id":"spn-15382","text":"Approval workflows"}]}],"id":"blk-17214","kind":"list-item"},{"blocks":[{"id":"blk-17217","kind":"paragraph","spans":[{"id":"spn-15383","text":"Policy versioning and audit"}]}],"id":"blk-17216","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17218","kind":"paragraph","spans":[{"id":"spn-15384","text":"When an agent declares "},{"id":"spn-15385","marks":["code"],"text":"&reason.argument"},{"id":"spn-15386","text":" with "},{"id":"spn-15387","marks":["code"],"text":"provider: \"deliberatic\""},{"id":"spn-15388","text":", the governance block is passed to Deliberatic for enforcement. Delegatic policies can override agent-level governance when org-level constraints are stricter."}]},{"id":"blk-17219","kind":"heading","level":2,"spans":[{"id":"spn-15389","text":"Common Governance Patterns"}]},{"head":[{"id":"blk-17221","spans":[{"id":"spn-15390","text":"Pattern"}]},{"id":"blk-17222","spans":[{"id":"spn-15391","text":"Description"}]},{"id":"blk-17223","spans":[{"id":"spn-15392","text":"Key Fields"}]}],"id":"blk-17220","kind":"table","rows":[[{"id":"blk-17224","spans":[{"id":"spn-15393","marks":["bold"],"text":"Read-only observer"}]},{"id":"blk-17225","spans":[{"id":"spn-15394","text":"Agent monitors but never acts"}]},{"id":"blk-17226","spans":[{"id":"spn-15395","marks":["code"],"text":"level: \"observe\""},{"id":"spn-15396","text":", no soft/hard needed"}]}],[{"id":"blk-17227","spans":[{"id":"spn-15397","marks":["bold"],"text":"Advisor with guardrails"}]},{"id":"blk-17228","spans":[{"id":"spn-15398","text":"Agent proposes within bounds"}]},{"id":"blk-17229","spans":[{"id":"spn-15399","marks":["code"],"text":"level: \"advise\""},{"id":"spn-15400","text":", hard constraints, escalation"}]}],[{"id":"blk-17230","spans":[{"id":"spn-15401","marks":["bold"],"text":"Autonomous with budget"}]},{"id":"blk-17231","spans":[{"id":"spn-15402","text":"Agent acts within strict limits"}]},{"id":"blk-17232","spans":[{"id":"spn-15403","marks":["code"],"text":"level: \"act\""},{"id":"spn-15404","text":", budget caps, hard constraints"}]}],[{"id":"blk-17233","spans":[{"id":"spn-15405","marks":["bold"],"text":"Compliance-first"}]},{"id":"blk-17234","spans":[{"id":"spn-15406","text":"Full audit trail, conservative escalation"}]},{"id":"blk-17235","spans":[{"id":"spn-15407","marks":["code"],"text":"provenance: true"},{"id":"spn-15408","text":", low confidence threshold"}]}],[{"id":"blk-17236","spans":[{"id":"spn-15409","marks":["bold"],"text":"Multi-domain corroboration"}]},{"id":"blk-17237","spans":[{"id":"spn-15410","text":"Requires evidence from multiple capabilities"}]},{"id":"blk-17238","spans":[{"id":"spn-15411","text":"Hard constraint requiring multi-domain evidence"}]}]]}],"edges":[],"id":"bagaaierazypd2vdznbrgqyrb3knufd3mqtbkc5llwunzfjj6biyndv7boldq","vocabulary":"ampersand.docs.fs.v1"}