{"bendscript":"0.1","blocks":[{"id":"blk-16446","kind":"heading","level":1,"spans":[{"id":"spn-14670","text":"Skill 03 — Capability Composition"}]},{"blocks":[{"id":"blk-16448","kind":"paragraph","spans":[{"id":"spn-14671","text":"How capabilities compose via the "},{"id":"spn-14672","marks":["code"],"text":"&"},{"id":"spn-14673","text":" operator and "},{"id":"spn-14674","marks":["code"],"text":"|>"},{"id":"spn-14675","text":" pipeline operator. ACI algebra properties, type compatibility, and composition validation."}]}],"id":"blk-16447","kind":"quote"},{"id":"blk-16449","kind":"heading","level":2,"spans":[{"id":"spn-14676","text":"Why This Matters"}]},{"id":"blk-16450","kind":"paragraph","spans":[{"id":"spn-14677","text":"Composition is the core thesis of the [&] Protocol. Individual capabilities are useful; composed capabilities are powerful. The protocol defines two operators that make composition formal, validated, and portable."}]},{"id":"blk-16451","kind":"heading","level":2,"spans":[{"id":"spn-14678","text":"The "},{"id":"spn-14679","marks":["code"],"text":"&"},{"id":"spn-14680","text":" Operator — Capability Sets"}]},{"id":"blk-16452","kind":"paragraph","spans":[{"id":"spn-14681","text":"The "},{"id":"spn-14682","marks":["code"],"text":"&"},{"id":"spn-14683","text":" operator combines capabilities into a validated set. It is the fundamental composition mechanism."}]},{"id":"blk-16453","kind":"code","language":"text","text":"&memory.graph & &time.anomaly & &reason.argument"},{"id":"blk-16454","kind":"paragraph","spans":[{"id":"spn-14684","text":"This declares an agent with graph memory, temporal anomaly detection, and structured argumentation — composed as a single unit."}]},{"id":"blk-16455","kind":"heading","level":3,"spans":[{"id":"spn-14685","text":"ACI Properties"}]},{"id":"blk-16456","kind":"paragraph","spans":[{"id":"spn-14686","text":"The "},{"id":"spn-14687","marks":["code"],"text":"&"},{"id":"spn-14688","text":" operator satisfies ACI (Associative, Commutative, Idempotent):"}]},{"head":[{"id":"blk-16458","spans":[{"id":"spn-14689","text":"Property"}]},{"id":"blk-16459","spans":[{"id":"spn-14690","text":"Meaning"}]},{"id":"blk-16460","spans":[{"id":"spn-14691","text":"Example"}]}],"id":"blk-16457","kind":"table","rows":[[{"id":"blk-16461","spans":[{"id":"spn-14692","marks":["bold"],"text":"Associative"}]},{"id":"blk-16462","spans":[{"id":"spn-14693","text":"Grouping does not matter"}]},{"id":"blk-16463","spans":[{"id":"spn-14694","marks":["code"],"text":"(&memory & &time) & &space = &memory & (&time & &space)"}]}],[{"id":"blk-16464","spans":[{"id":"spn-14695","marks":["bold"],"text":"Commutative"}]},{"id":"blk-16465","spans":[{"id":"spn-14696","text":"Order does not matter"}]},{"id":"blk-16466","spans":[{"id":"spn-14697","marks":["code"],"text":"&memory & &time = &time & &memory"}]}],[{"id":"blk-16467","spans":[{"id":"spn-14698","marks":["bold"],"text":"Idempotent"}]},{"id":"blk-16468","spans":[{"id":"spn-14699","text":"Duplicates collapse"}]},{"id":"blk-16469","spans":[{"id":"spn-14700","marks":["code"],"text":"&memory & &memory = &memory"}]}],[{"id":"blk-16470","spans":[{"id":"spn-14701","marks":["bold"],"text":"Identity"}]},{"id":"blk-16471","spans":[{"id":"spn-14702","text":"Composing with nothing changes nothing"}]},{"id":"blk-16472","spans":[{"id":"spn-14703","marks":["code"],"text":"&none & &memory = &memory"}]}]]},{"id":"blk-16473","kind":"paragraph","spans":[{"id":"spn-14704","text":"These are the same properties CRDTs use for conflict-free convergence. They ensure capability sets are deterministic regardless of declaration order."}]},{"id":"blk-16474","kind":"heading","level":3,"spans":[{"id":"spn-14705","text":"Composition validation"}]},{"id":"blk-16475","kind":"paragraph","spans":[{"id":"spn-14706","text":"When you run "},{"id":"spn-14707","marks":["code"],"text":"ampersand compose"},{"id":"spn-14708","text":", the tool checks:"}]},{"id":"blk-16476","items":[{"blocks":[{"id":"blk-16478","kind":"paragraph","spans":[{"id":"spn-14709","text":"All capability identifiers are valid ("},{"id":"spn-14710","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14711","text":")"}]}],"id":"blk-16477","kind":"list-item"},{"blocks":[{"id":"blk-16480","kind":"paragraph","spans":[{"id":"spn-14712","text":"All referenced providers exist in the registry (or are "},{"id":"spn-14713","marks":["code"],"text":"\"auto\""},{"id":"spn-14714","text":")"}]}],"id":"blk-16479","kind":"list-item"},{"blocks":[{"id":"blk-16482","kind":"paragraph","spans":[{"id":"spn-14715","text":"No conflicting providers for the same capability"}]}],"id":"blk-16481","kind":"list-item"},{"blocks":[{"id":"blk-16484","kind":"paragraph","spans":[{"id":"spn-14716","text":"ACI properties hold (duplicate removal, order normalization)"}]}],"id":"blk-16483","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-16485","kind":"heading","level":2,"spans":[{"id":"spn-14717","text":"The "},{"id":"spn-14718","marks":["code"],"text":"|>"},{"id":"spn-14719","text":" Operator — Pipelines"}]},{"id":"blk-16486","kind":"paragraph","spans":[{"id":"spn-14720","text":"The "},{"id":"spn-14721","marks":["code"],"text":"|>"},{"id":"spn-14722","text":" operator flows data through capability operations in sequence:"}]},{"id":"blk-16487","kind":"code","language":"text","text":"stream_data\n  |> &time.anomaly.detect()\n  |> &memory.graph.enrich()\n  |> &reason.argument.evaluate()"},{"id":"blk-16488","kind":"paragraph","spans":[{"id":"spn-14723","text":"Each step receives the output of the previous step as input. The pipeline is type-checked against capability contracts."}]},{"id":"blk-16489","kind":"heading","level":3,"spans":[{"id":"spn-14724","text":"Type Compatibility"}]},{"id":"blk-16490","kind":"paragraph","spans":[{"id":"spn-14725","text":"Pipelines are validated using "},{"id":"spn-14726","marks":["code"],"text":"accepts_from"},{"id":"spn-14727","text":" / "},{"id":"spn-14728","marks":["code"],"text":"feeds_into"},{"id":"spn-14729","text":" contracts:"}]},{"id":"blk-16491","kind":"code","language":"text","text":"Step 1: &time.anomaly.detect()\n  Input:  stream_data\n  Output: anomaly_set\n\nStep 2: &memory.graph.enrich()\n  Accepts: anomaly_set (via &time.* wildcard in accepts_from)\n  Output:  enriched_context\n\nStep 3: &reason.argument.evaluate()\n  Accepts: enriched_context (via &memory.* wildcard in accepts_from)\n  Output:  evaluation_result"},{"id":"blk-16492","kind":"paragraph","spans":[{"id":"spn-14730","text":"If Step N's output type does not match Step N+1's "},{"id":"spn-14731","marks":["code"],"text":"accepts_from"},{"id":"spn-14732","text":" list, composition fails with a type error."}]},{"id":"blk-16493","kind":"heading","level":3,"spans":[{"id":"spn-14733","text":"Wildcard matching"}]},{"id":"blk-16494","kind":"paragraph","spans":[{"id":"spn-14734","text":"Contract types support wildcard matching:"}]},{"head":[{"id":"blk-16496","spans":[{"id":"spn-14735","text":"Pattern"}]},{"id":"blk-16497","spans":[{"id":"spn-14736","text":"Matches"}]}],"id":"blk-16495","kind":"table","rows":[[{"id":"blk-16498","spans":[{"id":"spn-14737","marks":["code"],"text":"&memory.*"}]},{"id":"blk-16499","spans":[{"id":"spn-14738","text":"Any memory capability output"}]}],[{"id":"blk-16500","spans":[{"id":"spn-14739","marks":["code"],"text":"&reason.*"}]},{"id":"blk-16501","spans":[{"id":"spn-14740","text":"Any reasoning capability output"}]}],[{"id":"blk-16502","spans":[{"id":"spn-14741","marks":["code"],"text":"raw_data"}]},{"id":"blk-16503","spans":[{"id":"spn-14742","text":"Literal type "},{"id":"spn-14743","marks":["code"],"text":"raw_data"}]}],[{"id":"blk-16504","spans":[{"id":"spn-14744","marks":["code"],"text":"output"}]},{"id":"blk-16505","spans":[{"id":"spn-14745","text":"Terminal — pipeline result"}]}]]},{"id":"blk-16506","kind":"heading","level":2,"spans":[{"id":"spn-14746","text":"Pipeline Declarations in JSON"}]},{"id":"blk-16507","kind":"paragraph","spans":[{"id":"spn-14747","text":"Pipelines are declared in the "},{"id":"spn-14748","marks":["code"],"text":"pipelines"},{"id":"spn-14749","text":" block of "},{"id":"spn-14750","marks":["code"],"text":"ampersand.json"},{"id":"spn-14751","text":":"}]},{"id":"blk-16508","kind":"code","language":"json","text":"\"pipelines\": {\n  \"incident_triage\": {\n    \"source_type\": \"stream_data\",\n    \"source_ref\": \"raw_data\",\n    \"steps\": [\n      { \"capability\": \"&time.anomaly\", \"operation\": \"detect\" },\n      { \"capability\": \"&memory.graph\", \"operation\": \"enrich\" },\n      { \"capability\": \"&reason.argument\", \"operation\": \"evaluate\" }\n    ]\n  }\n}"},{"id":"blk-16509","kind":"paragraph","spans":[{"id":"spn-14752","text":"Each step references a capability declared in the "},{"id":"spn-14753","marks":["code"],"text":"capabilities"},{"id":"spn-14754","text":" block and an operation defined in that capability's contract."}]},{"id":"blk-16510","kind":"heading","level":2,"spans":[{"id":"spn-14755","text":"Multi-Capability Declarations"}]},{"id":"blk-16511","kind":"paragraph","spans":[{"id":"spn-14756","text":"An agent can declare any combination of capabilities across all four primitive domains:"}]},{"id":"blk-16512","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\":      { \"provider\": \"graphonomous\", \"config\": {} },\n  \"&memory.vector\":     { \"provider\": \"pgvector\", \"config\": {} },\n  \"&time.anomaly\":      { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&time.forecast\":     { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&space.fleet\":       { \"provider\": \"geofleetic\", \"config\": {} },\n  \"&reason.argument\":   { \"provider\": \"deliberatic\", \"config\": {} },\n  \"&reason.deliberate\": { \"provider\": \"graphonomous\", \"config\": {} }\n}"},{"id":"blk-16513","kind":"paragraph","spans":[{"id":"spn-14757","text":"Multiple subtypes of the same primitive are allowed. Each is independently bound to a provider."}]},{"id":"blk-16514","kind":"heading","level":2,"spans":[{"id":"spn-14758","text":"Composition Validation via CLI"}]},{"id":"blk-16515","kind":"code","language":"bash","text":"./ampersand compose agent.ampersand.json"},{"id":"blk-16516","kind":"paragraph","spans":[{"id":"spn-14759","marks":["bold"],"text":"Success output:"}]},{"id":"blk-16517","kind":"code","language":"text","text":"OK  agent.ampersand.json\n  Capability set: &memory.graph & &time.anomaly & &reason.argument\n  ACI normal form: &memory.graph & &reason.argument & &time.anomaly\n  Pipelines: incident_triage (3 steps, type-safe)\n  Providers: graphonomous, ticktickclock, deliberatic"},{"id":"blk-16518","kind":"paragraph","spans":[{"id":"spn-14760","marks":["bold"],"text":"Failure output:"}]},{"id":"blk-16519","kind":"code","language":"text","text":"FAIL  agent.ampersand.json\n  errors:\n    - Pipeline \"incident_triage\" step 2: &memory.graph.enrich() does not\n      accept type \"forecast_set\" (output of &time.forecast.predict())\n    - Provider \"unknown_service\" not found in registry"},{"id":"blk-16520","kind":"heading","level":2,"spans":[{"id":"spn-14761","text":"Anti-Patterns"}]},{"head":[{"id":"blk-16522","spans":[{"id":"spn-14762","text":"Anti-Pattern"}]},{"id":"blk-16523","spans":[{"id":"spn-14763","text":"Problem"}]},{"id":"blk-16524","spans":[{"id":"spn-14764","text":"Fix"}]}],"id":"blk-16521","kind":"table","rows":[[{"id":"blk-16525","spans":[{"id":"spn-14765","text":"Incompatible pipeline steps"}]},{"id":"blk-16526","spans":[{"id":"spn-14766","text":"Output type does not match next step's "},{"id":"spn-14767","marks":["code"],"text":"accepts_from"}]},{"id":"blk-16527","spans":[{"id":"spn-14768","text":"Check contracts; insert a compatible intermediary"}]}],[{"id":"blk-16528","spans":[{"id":"spn-14769","text":"Circular pipeline dependencies"}]},{"id":"blk-16529","spans":[{"id":"spn-14770","text":"`"}]},{"id":"blk-16530","spans":[{"id":"spn-14771","text":">` is strictly linear"}]},{"id":"blk-16531","spans":[{"id":"spn-14772","text":"Use capability-level feedback, not pipeline cycles"}]}],[{"id":"blk-16532","spans":[{"id":"spn-14773","text":"Composing without validating"}]},{"id":"blk-16533","spans":[{"id":"spn-14774","text":"Errors surface late at generation time"}]},{"id":"blk-16534","spans":[{"id":"spn-14775","text":"Always "},{"id":"spn-14776","marks":["code"],"text":"compose"},{"id":"spn-14777","text":" before "},{"id":"spn-14778","marks":["code"],"text":"generate"}]}],[{"id":"blk-16535","spans":[{"id":"spn-14779","text":"Ignoring ACI normalization"}]},{"id":"blk-16536","spans":[{"id":"spn-14780","text":"Assuming order matters when it does not"}]},{"id":"blk-16537","spans":[{"id":"spn-14781","text":"Trust the normal form; do not rely on declaration order"}]}],[{"id":"blk-16538","spans":[{"id":"spn-14782","text":"Over-composing"}]},{"id":"blk-16539","spans":[{"id":"spn-14783","text":"Declaring 15 capabilities when 3 suffice"}]},{"id":"blk-16540","spans":[{"id":"spn-14784","text":"Start minimal; add capabilities when needed"}]}]]},{"id":"blk-16541","kind":"heading","level":2,"spans":[{"id":"spn-14785","text":"Elixir DSL Equivalent"}]},{"id":"blk-16542","kind":"paragraph","spans":[{"id":"spn-14786","text":"In the Elixir reference implementation, composition uses native syntax:"}]},{"id":"blk-16543","kind":"code","language":"elixir","text":"capabilities do\n  &memory.graph(:graphonomous, instance: \"infra-ops\")\n  &time.anomaly(:ticktickclock, streams: [:cpu, :mem])\n  &reason.argument(:deliberatic, governance: :constitutional)\nend"},{"id":"blk-16544","kind":"paragraph","spans":[{"id":"spn-14787","text":"Pipeline usage:"}]},{"id":"blk-16545","kind":"code","language":"elixir","text":"stream_data\n|> &time.anomaly.detect()\n|> &memory.graph.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-16546","kind":"paragraph","spans":[{"id":"spn-14788","text":"The "},{"id":"spn-14789","marks":["code"],"text":"&"},{"id":"spn-14790","text":" leverages Elixir's capture operator. The "},{"id":"spn-14791","marks":["code"],"text":"|>"},{"id":"spn-14792","text":" is Elixir's native pipe. Both map directly to the protocol's formal operators."}]}],"edges":[],"id":"bagaaieracswbwgiojmz3htlhppkgj2ov4fnlt5rrzdt2udwma53rwlisnqka","vocabulary":"ampersand.docs.fs.v1"}