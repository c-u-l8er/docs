{"bendscript":"0.1","blocks":[{"id":"blk-16448","kind":"heading","level":1,"spans":[{"id":"spn-14470","text":"Skill 03 — Capability Composition"}]},{"blocks":[{"id":"blk-16450","kind":"paragraph","spans":[{"id":"spn-14471","text":"How capabilities compose via the "},{"id":"spn-14472","marks":["code"],"text":"&"},{"id":"spn-14473","text":" operator and "},{"id":"spn-14474","marks":["code"],"text":"|>"},{"id":"spn-14475","text":" pipeline operator. ACI algebra properties, type compatibility, and composition validation."}]}],"id":"blk-16449","kind":"quote"},{"id":"blk-16451","kind":"heading","level":2,"spans":[{"id":"spn-14476","text":"Why This Matters"}]},{"id":"blk-16452","kind":"paragraph","spans":[{"id":"spn-14477","text":"Composition is the core thesis of the [&] Protocol. Individual capabilities are useful; composed capabilities are powerful. The protocol defines two operators that make composition formal, validated, and portable."}]},{"id":"blk-16453","kind":"heading","level":2,"spans":[{"id":"spn-14478","text":"The "},{"id":"spn-14479","marks":["code"],"text":"&"},{"id":"spn-14480","text":" Operator — Capability Sets"}]},{"id":"blk-16454","kind":"paragraph","spans":[{"id":"spn-14481","text":"The "},{"id":"spn-14482","marks":["code"],"text":"&"},{"id":"spn-14483","text":" operator combines capabilities into a validated set. It is the fundamental composition mechanism."}]},{"id":"blk-16455","kind":"code","language":"text","text":"&memory.graph & &time.anomaly & &reason.argument"},{"id":"blk-16456","kind":"paragraph","spans":[{"id":"spn-14484","text":"This declares an agent with graph memory, temporal anomaly detection, and structured argumentation — composed as a single unit."}]},{"id":"blk-16457","kind":"heading","level":3,"spans":[{"id":"spn-14485","text":"ACI Properties"}]},{"id":"blk-16458","kind":"paragraph","spans":[{"id":"spn-14486","text":"The "},{"id":"spn-14487","marks":["code"],"text":"&"},{"id":"spn-14488","text":" operator satisfies ACI (Associative, Commutative, Idempotent):"}]},{"head":[{"id":"blk-16460","spans":[{"id":"spn-14489","text":"Property"}]},{"id":"blk-16461","spans":[{"id":"spn-14490","text":"Meaning"}]},{"id":"blk-16462","spans":[{"id":"spn-14491","text":"Example"}]}],"id":"blk-16459","kind":"table","rows":[[{"id":"blk-16463","spans":[{"id":"spn-14492","marks":["bold"],"text":"Associative"}]},{"id":"blk-16464","spans":[{"id":"spn-14493","text":"Grouping does not matter"}]},{"id":"blk-16465","spans":[{"id":"spn-14494","marks":["code"],"text":"(&memory & &time) & &space = &memory & (&time & &space)"}]}],[{"id":"blk-16466","spans":[{"id":"spn-14495","marks":["bold"],"text":"Commutative"}]},{"id":"blk-16467","spans":[{"id":"spn-14496","text":"Order does not matter"}]},{"id":"blk-16468","spans":[{"id":"spn-14497","marks":["code"],"text":"&memory & &time = &time & &memory"}]}],[{"id":"blk-16469","spans":[{"id":"spn-14498","marks":["bold"],"text":"Idempotent"}]},{"id":"blk-16470","spans":[{"id":"spn-14499","text":"Duplicates collapse"}]},{"id":"blk-16471","spans":[{"id":"spn-14500","marks":["code"],"text":"&memory & &memory = &memory"}]}],[{"id":"blk-16472","spans":[{"id":"spn-14501","marks":["bold"],"text":"Identity"}]},{"id":"blk-16473","spans":[{"id":"spn-14502","text":"Composing with nothing changes nothing"}]},{"id":"blk-16474","spans":[{"id":"spn-14503","marks":["code"],"text":"&none & &memory = &memory"}]}]]},{"id":"blk-16475","kind":"paragraph","spans":[{"id":"spn-14504","text":"These are the same properties CRDTs use for conflict-free convergence. They ensure capability sets are deterministic regardless of declaration order."}]},{"id":"blk-16476","kind":"heading","level":3,"spans":[{"id":"spn-14505","text":"Composition validation"}]},{"id":"blk-16477","kind":"paragraph","spans":[{"id":"spn-14506","text":"When you run "},{"id":"spn-14507","marks":["code"],"text":"ampersand compose"},{"id":"spn-14508","text":", the tool checks:"}]},{"id":"blk-16478","items":[{"blocks":[{"id":"blk-16480","kind":"paragraph","spans":[{"id":"spn-14509","text":"All capability identifiers are valid ("},{"id":"spn-14510","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14511","text":")"}]}],"id":"blk-16479","kind":"list-item"},{"blocks":[{"id":"blk-16482","kind":"paragraph","spans":[{"id":"spn-14512","text":"All referenced providers exist in the registry (or are "},{"id":"spn-14513","marks":["code"],"text":"\"auto\""},{"id":"spn-14514","text":")"}]}],"id":"blk-16481","kind":"list-item"},{"blocks":[{"id":"blk-16484","kind":"paragraph","spans":[{"id":"spn-14515","text":"No conflicting providers for the same capability"}]}],"id":"blk-16483","kind":"list-item"},{"blocks":[{"id":"blk-16486","kind":"paragraph","spans":[{"id":"spn-14516","text":"ACI properties hold (duplicate removal, order normalization)"}]}],"id":"blk-16485","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-16487","kind":"heading","level":2,"spans":[{"id":"spn-14517","text":"The "},{"id":"spn-14518","marks":["code"],"text":"|>"},{"id":"spn-14519","text":" Operator — Pipelines"}]},{"id":"blk-16488","kind":"paragraph","spans":[{"id":"spn-14520","text":"The "},{"id":"spn-14521","marks":["code"],"text":"|>"},{"id":"spn-14522","text":" operator flows data through capability operations in sequence:"}]},{"id":"blk-16489","kind":"code","language":"text","text":"stream_data\n  |> &time.anomaly.detect()\n  |> &memory.graph.enrich()\n  |> &reason.argument.evaluate()"},{"id":"blk-16490","kind":"paragraph","spans":[{"id":"spn-14523","text":"Each step receives the output of the previous step as input. The pipeline is type-checked against capability contracts."}]},{"id":"blk-16491","kind":"heading","level":3,"spans":[{"id":"spn-14524","text":"Type Compatibility"}]},{"id":"blk-16492","kind":"paragraph","spans":[{"id":"spn-14525","text":"Pipelines are validated using "},{"id":"spn-14526","marks":["code"],"text":"accepts_from"},{"id":"spn-14527","text":" / "},{"id":"spn-14528","marks":["code"],"text":"feeds_into"},{"id":"spn-14529","text":" contracts:"}]},{"id":"blk-16493","kind":"code","language":"text","text":"Step 1: &time.anomaly.detect()\n  Input:  stream_data\n  Output: anomaly_set\n\nStep 2: &memory.graph.enrich()\n  Accepts: anomaly_set (via &time.* wildcard in accepts_from)\n  Output:  enriched_context\n\nStep 3: &reason.argument.evaluate()\n  Accepts: enriched_context (via &memory.* wildcard in accepts_from)\n  Output:  evaluation_result"},{"id":"blk-16494","kind":"paragraph","spans":[{"id":"spn-14530","text":"If Step N's output type does not match Step N+1's "},{"id":"spn-14531","marks":["code"],"text":"accepts_from"},{"id":"spn-14532","text":" list, composition fails with a type error."}]},{"id":"blk-16495","kind":"heading","level":3,"spans":[{"id":"spn-14533","text":"Wildcard matching"}]},{"id":"blk-16496","kind":"paragraph","spans":[{"id":"spn-14534","text":"Contract types support wildcard matching:"}]},{"head":[{"id":"blk-16498","spans":[{"id":"spn-14535","text":"Pattern"}]},{"id":"blk-16499","spans":[{"id":"spn-14536","text":"Matches"}]}],"id":"blk-16497","kind":"table","rows":[[{"id":"blk-16500","spans":[{"id":"spn-14537","marks":["code"],"text":"&memory.*"}]},{"id":"blk-16501","spans":[{"id":"spn-14538","text":"Any memory capability output"}]}],[{"id":"blk-16502","spans":[{"id":"spn-14539","marks":["code"],"text":"&reason.*"}]},{"id":"blk-16503","spans":[{"id":"spn-14540","text":"Any reasoning capability output"}]}],[{"id":"blk-16504","spans":[{"id":"spn-14541","marks":["code"],"text":"raw_data"}]},{"id":"blk-16505","spans":[{"id":"spn-14542","text":"Literal type "},{"id":"spn-14543","marks":["code"],"text":"raw_data"}]}],[{"id":"blk-16506","spans":[{"id":"spn-14544","marks":["code"],"text":"output"}]},{"id":"blk-16507","spans":[{"id":"spn-14545","text":"Terminal — pipeline result"}]}]]},{"id":"blk-16508","kind":"heading","level":2,"spans":[{"id":"spn-14546","text":"Pipeline Declarations in JSON"}]},{"id":"blk-16509","kind":"paragraph","spans":[{"id":"spn-14547","text":"Pipelines are declared in the "},{"id":"spn-14548","marks":["code"],"text":"pipelines"},{"id":"spn-14549","text":" block of "},{"id":"spn-14550","marks":["code"],"text":"ampersand.json"},{"id":"spn-14551","text":":"}]},{"id":"blk-16510","kind":"code","language":"json","text":"\"pipelines\": {\n  \"incident_triage\": {\n    \"source_type\": \"stream_data\",\n    \"source_ref\": \"raw_data\",\n    \"steps\": [\n      { \"capability\": \"&time.anomaly\", \"operation\": \"detect\" },\n      { \"capability\": \"&memory.graph\", \"operation\": \"enrich\" },\n      { \"capability\": \"&reason.argument\", \"operation\": \"evaluate\" }\n    ]\n  }\n}"},{"id":"blk-16511","kind":"paragraph","spans":[{"id":"spn-14552","text":"Each step references a capability declared in the "},{"id":"spn-14553","marks":["code"],"text":"capabilities"},{"id":"spn-14554","text":" block and an operation defined in that capability's contract."}]},{"id":"blk-16512","kind":"heading","level":2,"spans":[{"id":"spn-14555","text":"Multi-Capability Declarations"}]},{"id":"blk-16513","kind":"paragraph","spans":[{"id":"spn-14556","text":"An agent can declare any combination of capabilities across all four primitive domains:"}]},{"id":"blk-16514","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\":      { \"provider\": \"graphonomous\", \"config\": {} },\n  \"&memory.vector\":     { \"provider\": \"pgvector\", \"config\": {} },\n  \"&time.anomaly\":      { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&time.forecast\":     { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&space.fleet\":       { \"provider\": \"geofleetic\", \"config\": {} },\n  \"&reason.argument\":   { \"provider\": \"deliberatic\", \"config\": {} },\n  \"&reason.deliberate\": { \"provider\": \"graphonomous\", \"config\": {} }\n}"},{"id":"blk-16515","kind":"paragraph","spans":[{"id":"spn-14557","text":"Multiple subtypes of the same primitive are allowed. Each is independently bound to a provider."}]},{"id":"blk-16516","kind":"heading","level":2,"spans":[{"id":"spn-14558","text":"Composition Validation via CLI"}]},{"id":"blk-16517","kind":"code","language":"bash","text":"./ampersand compose agent.ampersand.json"},{"id":"blk-16518","kind":"paragraph","spans":[{"id":"spn-14559","marks":["bold"],"text":"Success output:"}]},{"id":"blk-16519","kind":"code","language":"text","text":"OK  agent.ampersand.json\n  Capability set: &memory.graph & &time.anomaly & &reason.argument\n  ACI normal form: &memory.graph & &reason.argument & &time.anomaly\n  Pipelines: incident_triage (3 steps, type-safe)\n  Providers: graphonomous, ticktickclock, deliberatic"},{"id":"blk-16520","kind":"paragraph","spans":[{"id":"spn-14560","marks":["bold"],"text":"Failure output:"}]},{"id":"blk-16521","kind":"code","language":"text","text":"FAIL  agent.ampersand.json\n  errors:\n    - Pipeline \"incident_triage\" step 2: &memory.graph.enrich() does not\n      accept type \"forecast_set\" (output of &time.forecast.predict())\n    - Provider \"unknown_service\" not found in registry"},{"id":"blk-16522","kind":"heading","level":2,"spans":[{"id":"spn-14561","text":"Anti-Patterns"}]},{"head":[{"id":"blk-16524","spans":[{"id":"spn-14562","text":"Anti-Pattern"}]},{"id":"blk-16525","spans":[{"id":"spn-14563","text":"Problem"}]},{"id":"blk-16526","spans":[{"id":"spn-14564","text":"Fix"}]}],"id":"blk-16523","kind":"table","rows":[[{"id":"blk-16527","spans":[{"id":"spn-14565","text":"Incompatible pipeline steps"}]},{"id":"blk-16528","spans":[{"id":"spn-14566","text":"Output type does not match next step's "},{"id":"spn-14567","marks":["code"],"text":"accepts_from"}]},{"id":"blk-16529","spans":[{"id":"spn-14568","text":"Check contracts; insert a compatible intermediary"}]}],[{"id":"blk-16530","spans":[{"id":"spn-14569","text":"Circular pipeline dependencies"}]},{"id":"blk-16531","spans":[{"id":"spn-14570","text":"`"}]},{"id":"blk-16532","spans":[{"id":"spn-14571","text":">` is strictly linear"}]},{"id":"blk-16533","spans":[{"id":"spn-14572","text":"Use capability-level feedback, not pipeline cycles"}]}],[{"id":"blk-16534","spans":[{"id":"spn-14573","text":"Composing without validating"}]},{"id":"blk-16535","spans":[{"id":"spn-14574","text":"Errors surface late at generation time"}]},{"id":"blk-16536","spans":[{"id":"spn-14575","text":"Always "},{"id":"spn-14576","marks":["code"],"text":"compose"},{"id":"spn-14577","text":" before "},{"id":"spn-14578","marks":["code"],"text":"generate"}]}],[{"id":"blk-16537","spans":[{"id":"spn-14579","text":"Ignoring ACI normalization"}]},{"id":"blk-16538","spans":[{"id":"spn-14580","text":"Assuming order matters when it does not"}]},{"id":"blk-16539","spans":[{"id":"spn-14581","text":"Trust the normal form; do not rely on declaration order"}]}],[{"id":"blk-16540","spans":[{"id":"spn-14582","text":"Over-composing"}]},{"id":"blk-16541","spans":[{"id":"spn-14583","text":"Declaring 15 capabilities when 3 suffice"}]},{"id":"blk-16542","spans":[{"id":"spn-14584","text":"Start minimal; add capabilities when needed"}]}]]},{"id":"blk-16543","kind":"heading","level":2,"spans":[{"id":"spn-14585","text":"Elixir DSL Equivalent"}]},{"id":"blk-16544","kind":"paragraph","spans":[{"id":"spn-14586","text":"In the Elixir reference implementation, composition uses native syntax:"}]},{"id":"blk-16545","kind":"code","language":"elixir","text":"capabilities do\n  &memory.graph(:graphonomous, instance: \"infra-ops\")\n  &time.anomaly(:ticktickclock, streams: [:cpu, :mem])\n  &reason.argument(:deliberatic, governance: :constitutional)\nend"},{"id":"blk-16546","kind":"paragraph","spans":[{"id":"spn-14587","text":"Pipeline usage:"}]},{"id":"blk-16547","kind":"code","language":"elixir","text":"stream_data\n|> &time.anomaly.detect()\n|> &memory.graph.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-16548","kind":"paragraph","spans":[{"id":"spn-14588","text":"The "},{"id":"spn-14589","marks":["code"],"text":"&"},{"id":"spn-14590","text":" leverages Elixir's capture operator. The "},{"id":"spn-14591","marks":["code"],"text":"|>"},{"id":"spn-14592","text":" is Elixir's native pipe. Both map directly to the protocol's formal operators."}]}],"edges":[],"id":"bagaaieraera4iiuml2yxnh4dbn4lr6tnw3m7azxlpyou6sdyhmkm75cwurda","vocabulary":"ampersand.docs.fs.v1"}