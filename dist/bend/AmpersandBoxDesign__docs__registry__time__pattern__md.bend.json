{"bendscript":"0.1","blocks":[{"id":"blk-15001","kind":"heading","level":1,"spans":[{"id":"spn-13265","marks":["code"],"text":"&time.pattern"},{"id":"spn-13266","text":" — Pattern Detection as a Capability"}]},{"id":"blk-15002","kind":"paragraph","spans":[{"id":"spn-13267","marks":["code"],"text":"&time.pattern"},{"id":"spn-13268","text":" is a capability page for the [&] Protocol's temporal pattern detection subtype."}]},{"id":"blk-15003","kind":"paragraph","spans":[{"id":"spn-13269","text":"It describes a composable interface for agents that need to identify recurring temporal structures in historical or streaming data. The goal is not to standardize one pattern detection algorithm. The goal is to standardize how an agent declares, validates, and composes pattern detection ability as part of its cognitive architecture."}]},{"id":"blk-15004","kind":"paragraph","spans":[{"id":"spn-13270","text":"In protocol terms:"}]},{"id":"blk-15005","items":[{"blocks":[{"id":"blk-15007","kind":"paragraph","spans":[{"id":"spn-13271","text":"primitive: "},{"id":"spn-13272","marks":["code"],"text":"&time"}]}],"id":"blk-15006","kind":"list-item"},{"blocks":[{"id":"blk-15009","kind":"paragraph","spans":[{"id":"spn-13273","text":"subtype: "},{"id":"spn-13274","marks":["code"],"text":"pattern"}]}],"id":"blk-15008","kind":"list-item"},{"blocks":[{"id":"blk-15011","kind":"paragraph","spans":[{"id":"spn-13275","text":"full capability id: "},{"id":"spn-13276","marks":["code"],"text":"&time.pattern"}]}],"id":"blk-15010","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15012","kind":"heading","level":2,"spans":[{"id":"spn-13277","text":"1. Definition"}]},{"id":"blk-15013","kind":"paragraph","spans":[{"id":"spn-13278","marks":["code"],"text":"&time.pattern"},{"id":"spn-13279","text":" is the protocol capability for "},{"id":"spn-13280","marks":["bold"],"text":"temporal structure identification"},{"id":"spn-13281","text":"."}]},{"id":"blk-15014","kind":"paragraph","spans":[{"id":"spn-13282","text":"It answers questions like:"}]},{"id":"blk-15015","items":[{"blocks":[{"id":"blk-15017","kind":"paragraph","spans":[{"id":"spn-13283","text":"What recurring behaviors exist in this data?"}]}],"id":"blk-15016","kind":"list-item"},{"blocks":[{"id":"blk-15019","kind":"paragraph","spans":[{"id":"spn-13284","text":"Is there a weekly or seasonal cycle driving this signal?"}]}],"id":"blk-15018","kind":"list-item"},{"blocks":[{"id":"blk-15021","kind":"paragraph","spans":[{"id":"spn-13285","text":"Which motifs repeat across different time windows?"}]}],"id":"blk-15020","kind":"list-item"},{"blocks":[{"id":"blk-15023","kind":"paragraph","spans":[{"id":"spn-13286","text":"How strong and stable is the detected periodicity?"}]}],"id":"blk-15022","kind":"list-item"},{"blocks":[{"id":"blk-15025","kind":"paragraph","spans":[{"id":"spn-13287","text":"What rhythm characterizes the operational baseline?"}]}],"id":"blk-15024","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15026","kind":"paragraph","spans":[{"id":"spn-13288","text":"A provider that satisfies "},{"id":"spn-13289","marks":["code"],"text":"&time.pattern"},{"id":"spn-13290","text":" should expose operations that turn temporal data into pattern-oriented artifacts that downstream capabilities can consume."}]},{"id":"blk-15027","kind":"paragraph","spans":[{"id":"spn-13291","text":"This is distinct from:"}]},{"id":"blk-15028","items":[{"blocks":[{"id":"blk-15030","kind":"paragraph","spans":[{"id":"spn-13292","marks":["code"],"text":"&time.anomaly"},{"id":"spn-13293","text":" — detecting what is unusual in current or recent behavior"}]}],"id":"blk-15029","kind":"list-item"},{"blocks":[{"id":"blk-15032","kind":"paragraph","spans":[{"id":"spn-13294","marks":["code"],"text":"&time.forecast"},{"id":"spn-13295","text":" — predicting what is likely to happen next"}]}],"id":"blk-15031","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15033","kind":"paragraph","spans":[{"id":"spn-13296","marks":["code"],"text":"&time.pattern"},{"id":"spn-13297","text":" is about "},{"id":"spn-13298","marks":["bold"],"text":"identifying what recurs"},{"id":"spn-13299","text":"."}]},{"id":"blk-15034","kind":"heading","level":2,"spans":[{"id":"spn-13300","text":"2. Why this capability matters"}]},{"id":"blk-15035","kind":"paragraph","spans":[{"id":"spn-13301","text":"A large class of useful agents need more than retrieval and reasoning over current context."}]},{"id":"blk-15036","kind":"paragraph","spans":[{"id":"spn-13302","text":"They need to recognize structure:"}]},{"id":"blk-15037","items":[{"blocks":[{"id":"blk-15039","kind":"paragraph","spans":[{"id":"spn-13303","text":"support ticket seasonality"}]}],"id":"blk-15038","kind":"list-item"},{"blocks":[{"id":"blk-15041","kind":"paragraph","spans":[{"id":"spn-13304","text":"recurring incident patterns"}]}],"id":"blk-15040","kind":"list-item"},{"blocks":[{"id":"blk-15043","kind":"paragraph","spans":[{"id":"spn-13305","text":"demand rhythms"}]}],"id":"blk-15042","kind":"list-item"},{"blocks":[{"id":"blk-15045","kind":"paragraph","spans":[{"id":"spn-13306","text":"research trend cycles"}]}],"id":"blk-15044","kind":"list-item"},{"blocks":[{"id":"blk-15047","kind":"paragraph","spans":[{"id":"spn-13307","text":"periodic load spikes"}]}],"id":"blk-15046","kind":"list-item"},{"blocks":[{"id":"blk-15049","kind":"paragraph","spans":[{"id":"spn-13308","text":"weekly or monthly behavioral shifts"}]}],"id":"blk-15048","kind":"list-item"},{"blocks":[{"id":"blk-15051","kind":"paragraph","spans":[{"id":"spn-13309","text":"recurring failure modes"}]}],"id":"blk-15050","kind":"list-item"},{"blocks":[{"id":"blk-15053","kind":"paragraph","spans":[{"id":"spn-13310","text":"staffing demand cadence"}]}],"id":"blk-15052","kind":"list-item"},{"blocks":[{"id":"blk-15055","kind":"paragraph","spans":[{"id":"spn-13311","text":"cyclical resource consumption"}]}],"id":"blk-15054","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15056","kind":"paragraph","spans":[{"id":"spn-13312","text":"Without an explicit pattern detection capability, systems often hide structural temporal logic inside:"}]},{"id":"blk-15057","items":[{"blocks":[{"id":"blk-15059","kind":"paragraph","spans":[{"id":"spn-13313","text":"custom analytics code"}]}],"id":"blk-15058","kind":"list-item"},{"blocks":[{"id":"blk-15061","kind":"paragraph","spans":[{"id":"spn-13314","text":"prompts"}]}],"id":"blk-15060","kind":"list-item"},{"blocks":[{"id":"blk-15063","kind":"paragraph","spans":[{"id":"spn-13315","text":"ad hoc tool wrappers"}]}],"id":"blk-15062","kind":"list-item"},{"blocks":[{"id":"blk-15065","kind":"paragraph","spans":[{"id":"spn-13316","text":"vendor-specific integrations"}]}],"id":"blk-15064","kind":"list-item"},{"blocks":[{"id":"blk-15067","kind":"paragraph","spans":[{"id":"spn-13317","text":"application business logic"}]}],"id":"blk-15066","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15068","kind":"paragraph","spans":[{"id":"spn-13318","text":"That makes architectures hard to compare, validate, and reuse."}]},{"id":"blk-15069","kind":"paragraph","spans":[{"id":"spn-13319","text":"By treating pattern detection as a protocol capability, the [&] Protocol makes it possible to:"}]},{"id":"blk-15070","items":[{"blocks":[{"id":"blk-15072","kind":"paragraph","spans":[{"id":"spn-13320","text":"declare pattern detection explicitly"}]}],"id":"blk-15071","kind":"list-item"},{"blocks":[{"id":"blk-15074","kind":"paragraph","spans":[{"id":"spn-13321","text":"bind it to a provider"}]}],"id":"blk-15073","kind":"list-item"},{"blocks":[{"id":"blk-15076","kind":"paragraph","spans":[{"id":"spn-13322","text":"validate pipelines that depend on pattern output"}]}],"id":"blk-15075","kind":"list-item"},{"blocks":[{"id":"blk-15078","kind":"paragraph","spans":[{"id":"spn-13323","text":"preserve provenance for pattern-driven decisions"}]}],"id":"blk-15077","kind":"list-item"},{"blocks":[{"id":"blk-15080","kind":"paragraph","spans":[{"id":"spn-13324","text":"generate downstream MCP and A2A artifacts from the same declaration"}]}],"id":"blk-15079","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15081","kind":"heading","level":2,"spans":[{"id":"spn-13325","text":"3. Capability role in the four-primitive model"}]},{"id":"blk-15082","kind":"paragraph","spans":[{"id":"spn-13326","text":"The [&] Protocol organizes cognition around four top-level domains:"}]},{"id":"blk-15083","items":[{"blocks":[{"id":"blk-15085","kind":"paragraph","spans":[{"id":"spn-13327","marks":["code"],"text":"&memory"},{"id":"spn-13328","text":" — what the agent knows"}]}],"id":"blk-15084","kind":"list-item"},{"blocks":[{"id":"blk-15087","kind":"paragraph","spans":[{"id":"spn-13329","marks":["code"],"text":"&reason"},{"id":"spn-13330","text":" — how the agent decides"}]}],"id":"blk-15086","kind":"list-item"},{"blocks":[{"id":"blk-15089","kind":"paragraph","spans":[{"id":"spn-13331","marks":["code"],"text":"&time"},{"id":"spn-13332","text":" — when things happen"}]}],"id":"blk-15088","kind":"list-item"},{"blocks":[{"id":"blk-15091","kind":"paragraph","spans":[{"id":"spn-13333","marks":["code"],"text":"&space"},{"id":"spn-13334","text":" — where things are"}]}],"id":"blk-15090","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15092","kind":"paragraph","spans":[{"id":"spn-13335","text":"Within that model, "},{"id":"spn-13336","marks":["code"],"text":"&time.pattern"},{"id":"spn-13337","text":" provides the agent's ability to recognize recurring temporal structure in past and present data."}]},{"id":"blk-15093","kind":"paragraph","spans":[{"id":"spn-13338","text":"It often works best when composed with:"}]},{"id":"blk-15094","items":[{"blocks":[{"id":"blk-15096","kind":"paragraph","spans":[{"id":"spn-13339","marks":["code"],"text":"&time.forecast"},{"id":"spn-13340","text":" for turning detected patterns into predictions"}]}],"id":"blk-15095","kind":"list-item"},{"blocks":[{"id":"blk-15098","kind":"paragraph","spans":[{"id":"spn-13341","marks":["code"],"text":"&memory.*"},{"id":"spn-13342","text":" for pattern-enriched knowledge and structural context"}]}],"id":"blk-15097","kind":"list-item"},{"blocks":[{"id":"blk-15100","kind":"paragraph","spans":[{"id":"spn-13343","marks":["code"],"text":"&reason.*"},{"id":"spn-13344","text":" for acting on detected rhythms and cycles"}]}],"id":"blk-15099","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15101","kind":"paragraph","spans":[{"id":"spn-13345","text":"A useful shorthand is:"}]},{"blocks":[{"id":"blk-15103","kind":"paragraph","spans":[{"id":"spn-13346","marks":["code"],"text":"&time.pattern"},{"id":"spn-13347","text":" tells the agent what temporal structures are stable enough to reason about."}]}],"id":"blk-15102","kind":"quote"},{"id":"blk-15104","kind":"heading","level":2,"spans":[{"id":"spn-13348","text":"4. Typical use cases"}]},{"id":"blk-15105","kind":"heading","level":3,"spans":[{"id":"spn-13349","text":"Support ticket seasonality"}]},{"id":"blk-15106","kind":"paragraph","spans":[{"id":"spn-13350","text":"Detect recurring weekly or monthly cycles in support volume to anticipate staffing needs."}]},{"id":"blk-15107","kind":"heading","level":3,"spans":[{"id":"spn-13351","text":"Research trend cycles"}]},{"id":"blk-15108","kind":"paragraph","spans":[{"id":"spn-13352","text":"Identify periodic surges in topic interest, publication volume, or signal activity."}]},{"id":"blk-15109","kind":"heading","level":3,"spans":[{"id":"spn-13353","text":"Recurring incident patterns"}]},{"id":"blk-15110","kind":"paragraph","spans":[{"id":"spn-13354","text":"Recognize repeating failure modes tied to deployment cadence, maintenance windows, or load cycles."}]},{"id":"blk-15111","kind":"heading","level":3,"spans":[{"id":"spn-13355","text":"Demand rhythm characterization"}]},{"id":"blk-15112","kind":"paragraph","spans":[{"id":"spn-13356","text":"Profile the underlying periodicity of demand signals across regions, products, or service lines."}]},{"id":"blk-15113","kind":"heading","level":3,"spans":[{"id":"spn-13357","text":"Operational baseline profiling"}]},{"id":"blk-15114","kind":"paragraph","spans":[{"id":"spn-13358","text":"Establish what normal recurring behavior looks like so that deviations become meaningful."}]},{"id":"blk-15115","kind":"heading","level":3,"spans":[{"id":"spn-13359","text":"Maintenance window optimization"}]},{"id":"blk-15116","kind":"paragraph","spans":[{"id":"spn-13360","text":"Detect when recurring low-activity periods occur to inform scheduling decisions."}]},{"id":"blk-15117","kind":"heading","level":2,"spans":[{"id":"spn-13361","text":"5. Example declaration"}]},{"id":"blk-15118","kind":"paragraph","spans":[{"id":"spn-13362","text":"A basic "},{"id":"spn-13363","marks":["code"],"text":"ampersand.json"},{"id":"spn-13364","text":" fragment using "},{"id":"spn-13365","marks":["code"],"text":"&time.pattern"},{"id":"spn-13366","text":":"}]},{"id":"blk-15119","kind":"code","language":"json","text":"{\n  \"&time.pattern\": {\n    \"provider\": \"ticktickclock\",\n    \"config\": {\n      \"windows\": [\"24h\", \"7d\", \"30d\"],\n      \"targets\": [\"support_volume\", \"incident_rate\"]\n    }\n  }\n}"},{"id":"blk-15120","kind":"paragraph","spans":[{"id":"spn-13367","text":"A goal-driven version using auto resolution:"}]},{"id":"blk-15121","kind":"code","language":"json","text":"{\n  \"&time.pattern\": {\n    \"provider\": \"auto\",\n    \"need\": \"detect weekly seasonality in customer support ticket volume\"\n  }\n}"},{"id":"blk-15122","kind":"paragraph","spans":[{"id":"spn-13368","text":"See also: "},{"id":"spn-13369","marks":["code"],"text":"customer-support.ampersand.json"},{"id":"spn-13370","text":" and "},{"id":"spn-13371","marks":["code"],"text":"research-agent.ampersand.json"},{"id":"spn-13372","text":" for full declaration examples."}]},{"id":"blk-15123","kind":"heading","level":2,"spans":[{"id":"spn-13373","text":"6. Compatible providers"}]},{"id":"blk-15124","kind":"paragraph","spans":[{"id":"spn-13374","text":"The protocol is provider-agnostic. The capability is the contract; providers are implementations."}]},{"id":"blk-15125","kind":"paragraph","spans":[{"id":"spn-13375","text":"Representative providers for "},{"id":"spn-13376","marks":["code"],"text":"&time.pattern"},{"id":"spn-13377","text":" may include:"}]},{"id":"blk-15126","items":[{"blocks":[{"id":"blk-15128","kind":"paragraph","spans":[{"id":"spn-13378","marks":["code"],"text":"ticktickclock"}]}],"id":"blk-15127","kind":"list-item"},{"blocks":[{"id":"blk-15130","kind":"paragraph","spans":[{"id":"spn-13379","text":"seasonal decomposition services"}]}],"id":"blk-15129","kind":"list-item"},{"blocks":[{"id":"blk-15132","kind":"paragraph","spans":[{"id":"spn-13380","text":"motif detection engines"}]}],"id":"blk-15131","kind":"list-item"},{"blocks":[{"id":"blk-15134","kind":"paragraph","spans":[{"id":"spn-13381","text":"time-series analysis platforms with periodicity APIs"}]}],"id":"blk-15133","kind":"list-item"},{"blocks":[{"id":"blk-15136","kind":"paragraph","spans":[{"id":"spn-13382","text":"domain-specific pattern recognition services"}]}],"id":"blk-15135","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15137","kind":"paragraph","spans":[{"id":"spn-13383","text":"A provider should be considered compatible when it can satisfy the capability contract, not merely because it performs some pattern-related function in marketing language."}]},{"id":"blk-15138","kind":"heading","level":2,"spans":[{"id":"spn-13384","text":"7. Example capability contract"}]},{"id":"blk-15139","kind":"paragraph","spans":[{"id":"spn-13385","text":"A representative contract artifact for "},{"id":"spn-13386","marks":["code"],"text":"&time.pattern"},{"id":"spn-13387","text":":"}]},{"id":"blk-15140","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&time.pattern\",\n  \"provider\": \"ticktickclock\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Temporal pattern detection contract for identifying recurring behaviors, seasonality, and trend cycles.\",\n  \"operations\": {\n    \"detect\": {\n      \"in\": \"time_series\",\n      \"out\": \"pattern_set\",\n      \"description\": \"Identify recurring temporal structures including cycles, seasonality, and motifs.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"summarize\": {\n      \"in\": \"pattern_set\",\n      \"out\": \"pattern_summary\",\n      \"description\": \"Convert detected patterns into interpretable signals with strength and periodicity metadata.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"enrich\": {\n      \"in\": \"context\",\n      \"out\": \"enriched_context\",\n      \"description\": \"Attach pattern and seasonality context to an existing decision or planning payload.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    }\n  },\n  \"accepts_from\": [\n    \"&memory.*\",\n    \"&space.*\",\n    \"raw_data\",\n    \"time_series\",\n    \"context\"\n  ],\n  \"feeds_into\": [\n    \"&time.forecast\",\n    \"&reason.*\",\n    \"&memory.*\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"temporal-pattern-detection\",\n    \"seasonality-analysis\"\n  ]\n}"},{"id":"blk-15141","kind":"paragraph","spans":[{"id":"spn-13388","text":"This contract matters because it makes pattern detection composable in a typed system."}]},{"id":"blk-15142","kind":"heading","level":2,"spans":[{"id":"spn-13389","text":"8. Example provider configuration patterns"}]},{"id":"blk-15143","kind":"paragraph","spans":[{"id":"spn-13390","text":"The protocol does not hardcode one configuration shape, but these fields are common and useful."}]},{"id":"blk-15144","kind":"heading","level":3,"spans":[{"id":"spn-13391","text":"Windows"}]},{"id":"blk-15145","kind":"paragraph","spans":[{"id":"spn-13392","text":"Which time windows to analyze for recurring structure."}]},{"id":"blk-15146","kind":"code","language":"json","text":"{\n  \"windows\": [\"24h\", \"7d\", \"30d\"]\n}"},{"id":"blk-15147","kind":"heading","level":3,"spans":[{"id":"spn-13393","text":"Targets"}]},{"id":"blk-15148","kind":"paragraph","spans":[{"id":"spn-13394","text":"Which signals or domains are being analyzed for patterns."}]},{"id":"blk-15149","kind":"code","language":"json","text":"{\n  \"targets\": [\"support_volume\", \"incident_rate\"]\n}"},{"id":"blk-15150","kind":"heading","level":3,"spans":[{"id":"spn-13395","text":"Minimum strength"}]},{"id":"blk-15151","kind":"paragraph","spans":[{"id":"spn-13396","text":"Filter for patterns that meet a minimum strength threshold."}]},{"id":"blk-15152","kind":"code","language":"json","text":"{\n  \"min_strength\": 0.6\n}"},{"id":"blk-15153","kind":"heading","level":3,"spans":[{"id":"spn-13397","text":"Pattern types"}]},{"id":"blk-15154","kind":"paragraph","spans":[{"id":"spn-13398","text":"Optionally constrain which types of temporal structure to search for."}]},{"id":"blk-15155","kind":"code","language":"json","text":"{\n  \"pattern_types\": [\"seasonality\", \"cycle\", \"motif\"]\n}"},{"id":"blk-15156","kind":"heading","level":3,"spans":[{"id":"spn-13399","text":"Region or segment scope"}]},{"id":"blk-15157","kind":"paragraph","spans":[{"id":"spn-13400","text":"Useful for spatially-aware pattern detection."}]},{"id":"blk-15158","kind":"code","language":"json","text":"{\n  \"regions\": [\"us-east\", \"eu-west\"]\n}"},{"id":"blk-15159","kind":"paragraph","spans":[{"id":"spn-13401","text":"These are implementation patterns, not mandatory protocol fields."}]},{"id":"blk-15160","kind":"heading","level":2,"spans":[{"id":"spn-13402","text":"9. Architecture patterns"}]},{"id":"blk-15161","kind":"heading","level":3,"spans":[{"id":"spn-13403","text":"Pattern A: pattern -> forecast"}]},{"id":"blk-15162","kind":"paragraph","spans":[{"id":"spn-13404","text":"Use detected patterns to inform predictions."}]},{"id":"blk-15163","kind":"code","language":"text","text":"time_series\n|> &time.pattern.detect()\n|> &time.forecast.predict()"},{"id":"blk-15164","kind":"paragraph","spans":[{"id":"spn-13405","text":"Use when recurring structure in historical data should improve forecast accuracy."}]},{"id":"blk-15165","kind":"heading","level":3,"spans":[{"id":"spn-13406","text":"Pattern B: pattern -> reason"}]},{"id":"blk-15166","kind":"paragraph","spans":[{"id":"spn-13407","text":"Use detected patterns directly as decision input."}]},{"id":"blk-15167","kind":"code","language":"text","text":"time_series\n|> &time.pattern.detect()\n|> &time.pattern.summarize()\n|> &reason.argument.evaluate()"},{"id":"blk-15168","kind":"paragraph","spans":[{"id":"spn-13408","text":"Use when a detected rhythm or cycle can directly support a decision, recommendation, or escalation."}]},{"id":"blk-15169","kind":"heading","level":3,"spans":[{"id":"spn-13409","text":"Pattern C: pattern -> memory"}]},{"id":"blk-15170","kind":"paragraph","spans":[{"id":"spn-13410","text":"Use detected patterns to enrich durable knowledge."}]},{"id":"blk-15171","kind":"code","language":"text","text":"time_series\n|> &time.pattern.detect()\n|> &time.pattern.enrich()\n|> &memory.graph.store()"},{"id":"blk-15172","kind":"paragraph","spans":[{"id":"spn-13411","text":"Use when identified patterns should become part of organizational memory for future retrieval."}]},{"id":"blk-15173","kind":"heading","level":3,"spans":[{"id":"spn-13412","text":"Pattern D: memory -> pattern -> forecast -> reason"}]},{"id":"blk-15174","kind":"paragraph","spans":[{"id":"spn-13413","text":"Full temporal pipeline from history through structure to prediction and action."}]},{"id":"blk-15175","kind":"code","language":"text","text":"query_context\n|> &memory.graph.recall()\n|> &time.pattern.detect()\n|> &time.forecast.predict()\n|> &reason.argument.evaluate()"},{"id":"blk-15176","kind":"paragraph","spans":[{"id":"spn-13414","text":"Use when the agent needs to recall historical data, identify its structure, project forward, and decide."}]},{"id":"blk-15177","kind":"heading","level":2,"spans":[{"id":"spn-13415","text":"10. Architecture diagram"}]},{"id":"blk-15178","kind":"paragraph","spans":[{"id":"spn-13416","text":"A simple conceptual view of "},{"id":"spn-13417","marks":["code"],"text":"&time.pattern"},{"id":"spn-13418","text":" in composition:"}]},{"id":"blk-15179","kind":"code","language":"text","text":"historical data / stream data\n            |\n            v\n   +----------------------+\n   |   &time.pattern      |\n   | detect / summarize   |\n   +----------------------+\n            |\n            v\n       pattern_set\n            |\n     +------+------+\n     |             |\n     v             v\n&time.forecast  &memory.*\n  predict        store\n     |             |\n     +------+------+\n            |\n            v\n       &reason.*\n        evaluate\n            |\n            v\n         output"},{"id":"blk-15180","kind":"paragraph","spans":[{"id":"spn-13419","text":"This is why contract typing matters: downstream capabilities need to know what kind of artifact they are receiving."}]},{"id":"blk-15181","kind":"heading","level":2,"spans":[{"id":"spn-13420","text":"11. Example API shape"}]},{"id":"blk-15182","kind":"paragraph","spans":[{"id":"spn-13421","text":"A provider-specific API will vary, but a pattern detection provider commonly exposes a shape like:"}]},{"id":"blk-15183","kind":"code","language":"json","text":"{\n  \"operation\": \"detect\",\n  \"input\": {\n    \"series\": [\n      { \"timestamp\": \"2026-02-22T00:00:00Z\", \"value\": 142 },\n      { \"timestamp\": \"2026-02-22T01:00:00Z\", \"value\": 155 },\n      { \"timestamp\": \"2026-02-23T00:00:00Z\", \"value\": 148 },\n      { \"timestamp\": \"2026-02-23T01:00:00Z\", \"value\": 160 }\n    ],\n    \"windows\": [\"24h\", \"7d\"]\n  }\n}"},{"id":"blk-15184","kind":"paragraph","spans":[{"id":"spn-13422","text":"Representative response:"}]},{"id":"blk-15185","kind":"code","language":"json","text":"{\n  \"patterns\": [\n    {\n      \"type\": \"seasonality\",\n      \"period\": \"24h\",\n      \"strength\": 0.87,\n      \"description\": \"Strong daily cycle with peak activity between 09:00 and 11:00 UTC.\"\n    },\n    {\n      \"type\": \"cycle\",\n      \"period\": \"7d\",\n      \"strength\": 0.72,\n      \"description\": \"Moderate weekly rhythm with reduced activity on weekends.\"\n    }\n  ],\n  \"summary\": \"Two recurring patterns detected: a strong daily peak and a moderate weekly cycle.\"\n}"},{"id":"blk-15186","kind":"paragraph","spans":[{"id":"spn-13423","text":"The protocol does not require this exact transport shape. It requires that the provider satisfy the declared capability contract."}]},{"id":"blk-15187","kind":"heading","level":2,"spans":[{"id":"spn-13424","text":"12. Governance implications"}]},{"id":"blk-15188","kind":"paragraph","spans":[{"id":"spn-13425","text":"Patterns are often used to justify structural assumptions about system behavior. That makes governance important."}]},{"id":"blk-15189","kind":"paragraph","spans":[{"id":"spn-13426","text":"Common governance examples for pattern-driven systems:"}]},{"id":"blk-15190","kind":"heading","level":3,"spans":[{"id":"spn-13427","text":"Hard constraints"}]},{"id":"blk-15191","items":[{"blocks":[{"id":"blk-15193","kind":"paragraph","spans":[{"id":"spn-13428","text":"never treat a detected pattern as ground truth without sufficient observation windows"}]}],"id":"blk-15192","kind":"list-item"},{"blocks":[{"id":"blk-15195","kind":"paragraph","spans":[{"id":"spn-13429","text":"never automate staffing changes from pattern output alone"}]}],"id":"blk-15194","kind":"list-item"},{"blocks":[{"id":"blk-15197","kind":"paragraph","spans":[{"id":"spn-13430","text":"never suppress audit logging for pattern-driven decisions"}]}],"id":"blk-15196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15198","kind":"heading","level":3,"spans":[{"id":"spn-13431","text":"Soft constraints"}]},{"id":"blk-15199","items":[{"blocks":[{"id":"blk-15201","kind":"paragraph","spans":[{"id":"spn-13432","text":"prefer longer observation windows over short ones when pattern stability is uncertain"}]}],"id":"blk-15200","kind":"list-item"},{"blocks":[{"id":"blk-15203","kind":"paragraph","spans":[{"id":"spn-13433","text":"prefer explicit seasonality detection over inferred periodicity"}]}],"id":"blk-15202","kind":"list-item"},{"blocks":[{"id":"blk-15205","kind":"paragraph","spans":[{"id":"spn-13434","text":"prefer validated patterns over single-window detections"}]}],"id":"blk-15204","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15206","kind":"heading","level":3,"spans":[{"id":"spn-13435","text":"Escalation rules"}]},{"id":"blk-15207","kind":"paragraph","spans":[{"id":"spn-13436","text":"Pattern-driven systems often combine well with:"}]},{"id":"blk-15208","kind":"code","language":"json","text":"{\n  \"escalate_when\": {\n    \"pattern_strength_below\": 0.5,\n    \"conflicting_patterns_detected\": true,\n    \"observation_window_insufficient\": true\n  }\n}"},{"id":"blk-15209","kind":"paragraph","spans":[{"id":"spn-13437","text":"This is one reason "},{"id":"spn-13438","marks":["code"],"text":"&time.pattern"},{"id":"spn-13439","text":" often composes closely with "},{"id":"spn-13440","marks":["code"],"text":"&reason.argument"},{"id":"spn-13441","text":" or "},{"id":"spn-13442","marks":["code"],"text":"&reason.plan"},{"id":"spn-13443","text":"."}]},{"id":"blk-15210","kind":"heading","level":2,"spans":[{"id":"spn-13444","text":"13. Provenance implications"}]},{"id":"blk-15211","kind":"paragraph","spans":[{"id":"spn-13445","text":"Patterns can strongly influence planning, resource allocation, and operational assumptions, so provenance should be explicit."}]},{"id":"blk-15212","kind":"paragraph","spans":[{"id":"spn-13446","text":"A provenance record for a pattern detection step may include:"}]},{"id":"blk-15213","kind":"code","language":"json","text":"{\n  \"source\": \"&time.pattern\",\n  \"provider\": \"ticktickclock\",\n  \"operation\": \"detect\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"input_hash\": \"sha256:abcd1234...\",\n  \"output_hash\": \"sha256:efgh5678...\",\n  \"parent_hash\": \"sha256:0000...\",\n  \"mcp_trace_id\": \"ttc-pattern-17\"\n}"},{"id":"blk-15214","kind":"paragraph","spans":[{"id":"spn-13447","text":"This helps answer questions like:"}]},{"id":"blk-15215","items":[{"blocks":[{"id":"blk-15217","kind":"paragraph","spans":[{"id":"spn-13448","text":"Why did the system assume weekly seasonality?"}]}],"id":"blk-15216","kind":"list-item"},{"blocks":[{"id":"blk-15219","kind":"paragraph","spans":[{"id":"spn-13449","text":"Which provider identified this recurring structure?"}]}],"id":"blk-15218","kind":"list-item"},{"blocks":[{"id":"blk-15221","kind":"paragraph","spans":[{"id":"spn-13450","text":"What observation windows informed the detected pattern?"}]}],"id":"blk-15220","kind":"list-item"},{"blocks":[{"id":"blk-15223","kind":"paragraph","spans":[{"id":"spn-13451","text":"Which upstream context produced this pattern set?"}]}],"id":"blk-15222","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15224","kind":"paragraph","spans":[{"id":"spn-13452","text":"Patterns without provenance are difficult to audit and easy to over-trust."}]},{"id":"blk-15225","kind":"heading","level":2,"spans":[{"id":"spn-13453","text":"14. A2A implications"}]},{"id":"blk-15226","kind":"paragraph","spans":[{"id":"spn-13454","text":"A pattern detection capability may map naturally to A2A-advertised skills such as:"}]},{"id":"blk-15227","items":[{"blocks":[{"id":"blk-15229","kind":"paragraph","spans":[{"id":"spn-13455","marks":["code"],"text":"temporal-pattern-detection"}]}],"id":"blk-15228","kind":"list-item"},{"blocks":[{"id":"blk-15231","kind":"paragraph","spans":[{"id":"spn-13456","marks":["code"],"text":"seasonality-analysis"}]}],"id":"blk-15230","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15232","kind":"paragraph","spans":[{"id":"spn-13457","text":"That means an agent card generated from an "},{"id":"spn-13458","marks":["code"],"text":"ampersand.json"},{"id":"spn-13459","text":" declaration can advertise pattern detection as a reusable, discoverable coordination-facing skill."}]},{"id":"blk-15233","kind":"paragraph","spans":[{"id":"spn-13460","text":"This is one example of how the [&] Protocol complements A2A rather than replacing it."}]},{"id":"blk-15234","kind":"heading","level":2,"spans":[{"id":"spn-13461","text":"15. MCP implications"}]},{"id":"blk-15235","kind":"paragraph","spans":[{"id":"spn-13462","text":"A pattern detection provider may also compile into MCP-facing configuration if the implementation exposes a tool or service endpoint."}]},{"id":"blk-15236","kind":"paragraph","spans":[{"id":"spn-13463","text":"For example, a declaration containing "},{"id":"spn-13464","marks":["code"],"text":"&time.pattern"},{"id":"spn-13465","text":" may generate MCP configuration that wires in a pattern detection provider alongside memory and reasoning providers."}]},{"id":"blk-15237","kind":"paragraph","spans":[{"id":"spn-13466","text":"This is one example of how the [&] Protocol complements MCP rather than replacing it."}]},{"id":"blk-15238","kind":"heading","level":2,"spans":[{"id":"spn-13467","text":"16. Research references and grounding"}]},{"id":"blk-15239","kind":"paragraph","spans":[{"id":"spn-13468","text":"The design of "},{"id":"spn-13469","marks":["code"],"text":"&time.pattern"},{"id":"spn-13470","text":" is informed by overlapping areas of work:"}]},{"id":"blk-15240","items":[{"blocks":[{"id":"blk-15242","kind":"paragraph","spans":[{"id":"spn-13471","text":"seasonal decomposition"}]}],"id":"blk-15241","kind":"list-item"},{"blocks":[{"id":"blk-15244","kind":"paragraph","spans":[{"id":"spn-13472","text":"motif discovery"}]}],"id":"blk-15243","kind":"list-item"},{"blocks":[{"id":"blk-15246","kind":"paragraph","spans":[{"id":"spn-13473","text":"periodicity detection"}]}],"id":"blk-15245","kind":"list-item"},{"blocks":[{"id":"blk-15248","kind":"paragraph","spans":[{"id":"spn-13474","text":"cycle analysis"}]}],"id":"blk-15247","kind":"list-item"},{"blocks":[{"id":"blk-15250","kind":"paragraph","spans":[{"id":"spn-13475","text":"temporal data mining"}]}],"id":"blk-15249","kind":"list-item"},{"blocks":[{"id":"blk-15252","kind":"paragraph","spans":[{"id":"spn-13476","text":"time-series structural analysis"}]}],"id":"blk-15251","kind":"list-item"},{"blocks":[{"id":"blk-15254","kind":"paragraph","spans":[{"id":"spn-13477","text":"recurring behavior characterization in operational systems"}]}],"id":"blk-15253","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15255","kind":"paragraph","spans":[{"id":"spn-13478","text":"The important protocol-level insight is not that pattern detection is new. It is that "},{"id":"spn-13479","marks":["bold"],"text":"pattern detection should be represented explicitly as a composable capability"},{"id":"spn-13480","text":" rather than hidden in framework logic."}]},{"id":"blk-15256","kind":"paragraph","spans":[{"id":"spn-13481","text":"That shift enables:"}]},{"id":"blk-15257","items":[{"blocks":[{"id":"blk-15259","kind":"paragraph","spans":[{"id":"spn-13482","text":"schema validation"}]}],"id":"blk-15258","kind":"list-item"},{"blocks":[{"id":"blk-15261","kind":"paragraph","spans":[{"id":"spn-13483","text":"typed pipelines"}]}],"id":"blk-15260","kind":"list-item"},{"blocks":[{"id":"blk-15263","kind":"paragraph","spans":[{"id":"spn-13484","text":"provider interchangeability"}]}],"id":"blk-15262","kind":"list-item"},{"blocks":[{"id":"blk-15265","kind":"paragraph","spans":[{"id":"spn-13485","text":"governance-aware decisions"}]}],"id":"blk-15264","kind":"list-item"},{"blocks":[{"id":"blk-15267","kind":"paragraph","spans":[{"id":"spn-13486","text":"provenance-preserving execution"}]}],"id":"blk-15266","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15268","kind":"heading","level":2,"spans":[{"id":"spn-13487","text":"17. Anti-patterns"}]},{"id":"blk-15269","kind":"heading","level":3,"spans":[{"id":"spn-13488","text":"Anti-pattern 1: conflate pattern detection and anomaly detection"}]},{"id":"blk-15270","kind":"paragraph","spans":[{"id":"spn-13489","text":"They are complementary temporal capabilities, but they are not the same interface. Anomaly detection finds what is unusual. Pattern detection finds what recurs."}]},{"id":"blk-15271","kind":"heading","level":3,"spans":[{"id":"spn-13490","text":"Anti-pattern 2: treat detected patterns as permanent"}]},{"id":"blk-15272","kind":"paragraph","spans":[{"id":"spn-13491","text":"Patterns can decay, shift, or disappear. A pattern detected over one window may not hold over another."}]},{"id":"blk-15273","kind":"heading","level":3,"spans":[{"id":"spn-13492","text":"Anti-pattern 3: treat pattern detection as generic analytics"}]},{"id":"blk-15274","kind":"paragraph","spans":[{"id":"spn-13493","text":"If pattern detection is bundled into a broad \"analytics\" block, its contract and pipeline role become unclear."}]},{"id":"blk-15275","kind":"heading","level":3,"spans":[{"id":"spn-13494","text":"Anti-pattern 4: hardwire the protocol to one provider"}]},{"id":"blk-15276","kind":"paragraph","spans":[{"id":"spn-13495","marks":["code"],"text":"&time.pattern"},{"id":"spn-13496","text":" should remain a portable capability contract."}]},{"id":"blk-15277","kind":"heading","level":2,"spans":[{"id":"spn-13497","text":"18. Good default guidance"}]},{"id":"blk-15278","kind":"paragraph","spans":[{"id":"spn-13498","text":"Use "},{"id":"spn-13499","marks":["code"],"text":"&time.pattern"},{"id":"spn-13500","text":" when:"}]},{"id":"blk-15279","items":[{"blocks":[{"id":"blk-15281","kind":"paragraph","spans":[{"id":"spn-13501","text":"the system needs to identify recurring temporal structures"}]}],"id":"blk-15280","kind":"list-item"},{"blocks":[{"id":"blk-15283","kind":"paragraph","spans":[{"id":"spn-13502","text":"a planner or forecaster must act on detected periodicity or seasonality"}]}],"id":"blk-15282","kind":"list-item"},{"blocks":[{"id":"blk-15285","kind":"paragraph","spans":[{"id":"spn-13503","text":"demand, load, or incident rhythms matter operationally"}]}],"id":"blk-15284","kind":"list-item"},{"blocks":[{"id":"blk-15287","kind":"paragraph","spans":[{"id":"spn-13504","text":"a declaration should express structural temporal intelligence explicitly"}]}],"id":"blk-15286","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15288","kind":"paragraph","spans":[{"id":"spn-13505","text":"Prefer composing it with:"}]},{"id":"blk-15289","items":[{"blocks":[{"id":"blk-15291","kind":"paragraph","spans":[{"id":"spn-13506","marks":["code"],"text":"&time.forecast"},{"id":"spn-13507","text":" when detected patterns should inform predictions"}]}],"id":"blk-15290","kind":"list-item"},{"blocks":[{"id":"blk-15293","kind":"paragraph","spans":[{"id":"spn-13508","marks":["code"],"text":"&memory.*"},{"id":"spn-13509","text":" when patterns should enrich durable knowledge"}]}],"id":"blk-15292","kind":"list-item"},{"blocks":[{"id":"blk-15295","kind":"paragraph","spans":[{"id":"spn-13510","marks":["code"],"text":"&reason.*"},{"id":"spn-13511","text":" when detected rhythms influence action selection"}]}],"id":"blk-15294","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15296","kind":"paragraph","spans":[{"id":"spn-13512","text":"Recommended observation windows: 24h, 7d, 30d."}]},{"id":"blk-15297","kind":"heading","level":2,"spans":[{"id":"spn-13513","text":"19. Summary"}]},{"id":"blk-15298","kind":"paragraph","spans":[{"id":"spn-13514","marks":["code"],"text":"&time.pattern"},{"id":"spn-13515","text":" is the [&] Protocol capability for detecting recurring temporal structure."}]},{"id":"blk-15299","kind":"paragraph","spans":[{"id":"spn-13516","text":"It exists to make structural temporal intelligence:"}]},{"id":"blk-15300","items":[{"blocks":[{"id":"blk-15302","kind":"paragraph","spans":[{"id":"spn-13517","text":"explicit"}]}],"id":"blk-15301","kind":"list-item"},{"blocks":[{"id":"blk-15304","kind":"paragraph","spans":[{"id":"spn-13518","text":"composable"}]}],"id":"blk-15303","kind":"list-item"},{"blocks":[{"id":"blk-15306","kind":"paragraph","spans":[{"id":"spn-13519","text":"contract-aware"}]}],"id":"blk-15305","kind":"list-item"},{"blocks":[{"id":"blk-15308","kind":"paragraph","spans":[{"id":"spn-13520","text":"provider-agnostic"}]}],"id":"blk-15307","kind":"list-item"},{"blocks":[{"id":"blk-15310","kind":"paragraph","spans":[{"id":"spn-13521","text":"governable"}]}],"id":"blk-15309","kind":"list-item"},{"blocks":[{"id":"blk-15312","kind":"paragraph","spans":[{"id":"spn-13522","text":"provenance-friendly"}]}],"id":"blk-15311","kind":"list-item"},{"blocks":[{"id":"blk-15314","kind":"paragraph","spans":[{"id":"spn-13523","text":"generatable into MCP and A2A surfaces"}]}],"id":"blk-15313","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15315","kind":"paragraph","spans":[{"id":"spn-13524","text":"In short:"}]},{"blocks":[{"id":"blk-15317","kind":"paragraph","spans":[{"id":"spn-13525","marks":["code"],"text":"&time.pattern"},{"id":"spn-13526","text":" gives an agent a standard way to declare that it can identify recurring temporal structures and use that knowledge safely within a composed cognitive system."}]}],"id":"blk-15316","kind":"quote"}],"edges":[],"id":"bagaaieratloywjxvjxfxhhkrsxaui7ze4hf5ksgsqq7pwnq6tt66kjd3f5da","vocabulary":"ampersand.docs.fs.v1"}