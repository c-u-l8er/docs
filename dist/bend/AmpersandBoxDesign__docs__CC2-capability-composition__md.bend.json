"code"],"text":"owns"},{"id":"spn-2271","text":" (single owner = self), and "},{"id":"spn-2272","marks":["code"],"text":"ensure"},{"id":"spn-2273","text":" defaulting to the agent's own goal. CC1 compositions therefore keep their meaning; CC2 only "},{"id":"spn-2274","marks":["italic"],"text":"adds"},{"id":"spn-2275","text":" the coalition, ownership, common-knowledge, joint-trajectory, and ability layers. Runtimes SHOULD accept CC1 documents unchanged and treat them as singleton coalitions."}]},{"id":"blk-2074","kind":"heading","level":2,"spans":[{"id":"spn-2276","text":"7. Conformance"}]},{"id":"blk-2075","kind":"paragraph","spans":[{"id":"spn-2277","text":"A conformant CC2 implementation MUST:"}]},{"id":"blk-2076","items":[{"blocks":[{"id":"blk-2078","kind":"paragraph","spans":[{"id":"spn-2278","text":"compute the "},{"id":"spn-2279","marks":["code"],"text":"&"},{"id":"spn-2280","text":" and "},{"id":"spn-2281","marks":["code"],"text":"|>"},{"id":"spn-2282","text":" verdicts via an arithmetic that passes the enforced laws — "},{"id":"spn-2283","marks":["bold"],"text":"210"},{"id":"spn-2284","text":" as the suites derive them today, 109 kernel ("},{"id":"spn-2285","marks":["code"],"text":"test/laws.mjs"},{"id":"spn-2286","text":") + 99 compose ("},{"id":"spn-2287","marks":["code"],"text":"test/compose-laws.mjs"},{"id":"spn-2288","text":", 100 suite + 1 anchor). The suite is the contract, not this number; pass it in your language. The 3 declared-open laws (CP5/CP6/CP7) are expected to print FALSIFIED and MUST NOT be counted as passing;"}]}],"id":"blk-2077","kind":"list-item"},{"blocks":[{"id":"blk-2080","kind":"paragraph","spans":[{"id":"spn-2289","text":"treat "},{"id":"spn-2290","marks":["code"],"text":"hard"},{"id":"spn-2291","text":", "},{"id":"spn-2292","marks":["code"],"text":"floor"},{"id":"spn-2293","text":", and "},{"id":"spn-2294","marks":["code"],"text":"ensure"},{"id":"spn-2295","text":" failures as hard rejections, not advisories;"}]}],"id":"blk-2079","kind":"list-item"},{"blocks":[{"id":"blk-2082","kind":"paragraph","spans":[{"id":"spn-2296","text":"run governance "},{"id":"spn-2297","marks":["bold"],"text":"interpositionally"},{"id":"spn-2298","text":" — no consequential effect may execute without first clearing the "},{"id":"spn-2299","marks":["code"],"text":"govern"},{"id":"spn-2300","text":" verdict;"}]}],"id":"blk-2081","kind":"list-item"},{"blocks":[{"id":"blk-2084","kind":"paragraph","spans":[{"id":"spn-2301","text":"preserve entrenchment across all self-revision ("},{"id":"spn-2302","marks":["code"],"text":"R4"},{"id":"spn-2303","text":");"}]}],"id":"blk-2083","kind":"list-item"},{"blocks":[{"id":"blk-2086","kind":"paragraph","spans":[{"id":"spn-2304","text":"agree, verdict-for-verdict, with any other conformant implementation on the same composition (the cross-language guarantee)."}]}],"id":"blk-2085","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-2087","kind":"paragraph","spans":[{"id":"spn-2305","text":"It SHOULD emit a decision certificate (which gate failed, which norm vetoed, which obligation forced, which ability was missing) as a CloudEvents payload, so verdicts travel the existing cross-loop bus."}]},{"id":"blk-2088","kind":"heading","level":2,"spans":[{"id":"spn-2306","text":"8. Open questions"}]},{"id":"blk-2089","items":[{"blocks":[{"id":"blk-2091","kind":"paragraph","spans":[{"id":"spn-2307","text":"Imperfect information / partial observability in the strategic rung (ATL\\* with incomplete information is harder than the perfect-information model here). The current "},{"id":"spn-2308","marks":["code"],"text":"executable"},{"id":"spn-2309","text":" flag is a placeholder for a proper epistemic-strategic product."}]}],"id":"blk-2090","kind":"list-item"},{"blocks":[{"id":"blk-2093","kind":"paragraph","spans":[{"id":"spn-2310","text":"Quantitative ability (cost-bounded strategies) — combining the strategic rung with the semiring (resource-bounded coalition logic)."}]}],"id":"blk-209