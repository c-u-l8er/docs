ning."}]},{"id":"blk-2059","kind":"heading","level":2,"spans":[{"id":"spn-2208","text":"5. Worked example (the verdict)"}]},{"id":"blk-2060","kind":"paragraph","spans":[{"id":"spn-2209","text":"For "},{"id":"spn-2210","marks":["code"],"text":":ship_it"},{"id":"spn-2211","text":" over the controller/environment-style game where neither "},{"id":"spn-2212","marks":["code"],"text":":dev"},{"id":"spn-2213","text":" nor "},{"id":"spn-2214","marks":["code"],"text":":ops"},{"id":"spn-2215","text":" can force the goal alone:"}]},{"id":"blk-2061","items":[{"blocks":[{"id":"blk-2063","kind":"paragraph","spans":[{"id":"spn-2216","marks":["code"],"text":"ensure deployed ∧ tests_pass"},{"id":"spn-2217","text":" → "},{"id":"spn-2218","marks":["code"],"text":"strategic.canEnsure([:dev,:qa,:ops], …)"},{"id":"spn-2219","text":" = "},{"id":"spn-2220","marks":["bold"],"text":"true"},{"id":"spn-2221","text":" (the full coalition can force it), but "},{"id":"spn-2222","marks":["code"],"text":"canEnsure([:dev], …)"},{"id":"spn-2223","text":" = "},{"id":"spn-2224","marks":["bold"],"text":"false"},{"id":"spn-2225","text":" — so a "},{"id":"spn-2226","marks":["code"],"text":":dev"},{"id":"spn-2227","text":"-only coalition is "},{"id":"spn-2228","marks":["bold"],"text":"inadmissible"},{"id":"spn-2229","text":" and escalates to recruit "},{"id":"spn-2230","marks":["code"],"text":":qa"},{"id":"spn-2231","text":"/"},{"id":"spn-2232","marks":["code"],"text":":ops"},{"id":"spn-2233","text":". ("},{"id":"spn-2234","marks":["code"],"text":"oblige"},{"id":"spn-2235","text":" → "},{"id":"spn-2236","marks":["code"],"text":":escalate"},{"id":"spn-2237","text":".)"}]}],"id":"blk-2062","kind":"list-item"},{"blocks":[{"id":"blk-2065","kind":"paragraph","spans":[{"id":"spn-2238","marks":["code"],"text":"common_knowledge [:release_plan]"},{"id":"spn-2239","text":" must hold or the joint pipeline is not executable, regardless of ability."}]}],"id":"blk-2064","kind":"list-item"},{"blocks":[{"id":"blk-2067","k