{"bendscript":"0.1","blocks":[{"id":"blk-73778","kind":"heading","level":1,"spans":[{"id":"spn-105144","text":"Quickstart"}]},{"blocks":[{"id":"blk-73780","kind":"paragraph","spans":[{"id":"spn-105145","text":"Zero-to-value walkthrough: add "},{"id":"spn-105146","marks":["code"],"text":"open_sentience"},{"id":"spn-105147","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-73779","kind":"quote"},{"id":"blk-73781","kind":"heading","level":2,"spans":[{"id":"spn-105148","text":"Prerequisites"}]},{"id":"blk-73782","items":[{"blocks":[{"id":"blk-73784","kind":"paragraph","spans":[{"id":"spn-105149","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-73783","kind":"list-item"},{"blocks":[{"id":"blk-73786","kind":"paragraph","spans":[{"id":"spn-105150","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-73785","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-73787","kind":"heading","level":2,"spans":[{"id":"spn-105151","text":"1. Add the Dependency"}]},{"id":"blk-73788","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-73789","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-73790","kind":"heading","level":2,"spans":[{"id":"spn-105152","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-73791","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-73792","kind":"paragraph","spans":[{"id":"spn-105153","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-73793","kind":"heading","level":2,"spans":[{"id":"spn-105154","text":"3. Install Your First Agent"}]},{"id":"blk-73794","kind":"paragraph","spans":[{"id":"spn-105155","text":"Use the "},{"id":"spn-105156","marks":["code"],"text":"agent_install"},{"id":"spn-105157","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-73795","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-73796","kind":"paragraph","spans":[{"id":"spn-105158","text":"The agent is now in the "},{"id":"spn-105159","marks":["code"],"text":"installed"},{"id":"spn-105160","text":" state. It is registered but not running."}]},{"id":"blk-73797","kind":"heading","level":2,"spans":[{"id":"spn-105161","text":"4. Check Permissions"}]},{"id":"blk-73798","kind":"paragraph","spans":[{"id":"spn-105162","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-73799","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-73800","kind":"heading","level":2,"spans":[{"id":"spn-105163","text":"5. Enable and Run the Agent"}]},{"id":"blk-73801","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-73802","kind":"heading","level":2,"spans":[{"id":"spn-105164","text":"6. Change Autonomy Level"}]},{"id":"blk-73803","kind":"paragraph","spans":[{"id":"spn-105165","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-73804","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-73805","kind":"paragraph","spans":[{"id":"spn-105166","text":"Each change is recorded in the audit trail."}]},{"id":"blk-73806","kind":"heading","level":2,"spans":[{"id":"spn-105167","text":"7. Query the Audit Trail"}]},{"id":"blk-73807","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-73808","kind":"paragraph","spans":[{"id":"spn-105168","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-73809","kind":"heading","level":2,"spans":[{"id":"spn-105169","text":"8. Lifecycle Transitions"}]},{"id":"blk-73810","kind":"paragraph","spans":[{"id":"spn-105170","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-73811","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-73812","kind":"heading","level":2,"spans":[{"id":"spn-105171","text":"What Happens Next"}]},{"id":"blk-73813","items":[{"blocks":[{"id":"blk-73815","kind":"paragraph","spans":[{"id":"spn-105172","text":"Read "},{"id":"spn-105173","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-105174","text":" to understand the OTP internals"}]}],"id":"blk-73814","kind":"list-item"},{"blocks":[{"id":"blk-73817","kind":"paragraph","spans":[{"id":"spn-105175","text":"Read "},{"id":"spn-105176","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-105177","text":" for the full permission model"}]}],"id":"blk-73816","kind":"list-item"},{"blocks":[{"id":"blk-73819","kind":"paragraph","spans":[{"id":"spn-105178","text":"Read "},{"id":"spn-105179","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-105180","text":" for autonomy details"}]}],"id":"blk-73818","kind":"list-item"},{"blocks":[{"id":"blk-73821","kind":"paragraph","spans":[{"id":"spn-105181","text":"Read "},{"id":"spn-105182","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-105183","text":" to connect with Graphonomous,"}]}],"id":"blk-73820","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-73822","kind":"paragraph","spans":[{"id":"spn-105184","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-73823","kind":"heading","level":2,"spans":[{"id":"spn-105185","text":"MCP Tool Equivalents"}]},{"id":"blk-73824","kind":"paragraph","spans":[{"id":"spn-105186","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-73826","spans":[{"id":"spn-105187","text":"Elixir API"}]},{"id":"blk-73827","spans":[{"id":"spn-105188","text":"MCP Tool"}]},{"id":"blk-73828","spans":[{"id":"spn-105189","text":"Purpose"}]}],"id":"blk-73825","kind":"table","rows":[[{"id":"blk-73829","spans":[{"id":"spn-105190","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-73830","spans":[{"id":"spn-105191","marks":["code"],"text":"agent_install"}]},{"id":"blk-73831","spans":[{"id":"spn-105192","text":"Register agent with permissions"}]}],[{"id":"blk-73832","spans":[{"id":"spn-105193","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-73833","spans":[{"id":"spn-105194","marks":["code"],"text":"agent_enable"}]},{"id":"blk-73834","spans":[{"id":"spn-105195","text":"Start the governed process"}]}],[{"id":"blk-73835","spans":[{"id":"spn-105196","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-73836","spans":[{"id":"spn-105197","marks":["code"],"text":"agent_disable"}]},{"id":"blk-73837","spans":[{"id":"spn-105198","text":"Graceful stop"}]}],[{"id":"blk-73838","spans":[{"id":"spn-105199","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-73839","spans":[{"id":"spn-105200","marks":["code"],"text":"agent_status"}]},{"id":"blk-73840","spans":[{"id":"spn-105201","text":"Current state and metadata"}]}],[{"id":"blk-73841","spans":[{"id":"spn-105202","marks":["code"],"text":"audit/2"}]},{"id":"blk-73842","spans":[{"id":"spn-105203","marks":["code"],"text":"agent_audit"}]},{"id":"blk-73843","spans":[{"id":"spn-105204","text":"Query audit trail"}]}],[{"id":"blk-73844","spans":[{"id":"spn-105205","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-73845","spans":[{"id":"spn-105206","marks":["code"],"text":"permission_check"}]},{"id":"blk-73846","spans":[{"id":"spn-105207","text":"Evaluate a permission"}]}],[{"id":"blk-73847","spans":[{"id":"spn-105208","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-73848","spans":[{"id":"spn-105209","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-73849","spans":[{"id":"spn-105210","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaiera6lwnl7niafbgqnymr4abch7xud4retlmjraotasq6gjnjsgklgza","vocabulary":"ampersand.docs.fs.v1"}