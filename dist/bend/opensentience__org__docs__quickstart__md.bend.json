{"bendscript":"0.1","blocks":[{"id":"blk-73904","kind":"heading","level":1,"spans":[{"id":"spn-105292","text":"Quickstart"}]},{"blocks":[{"id":"blk-73906","kind":"paragraph","spans":[{"id":"spn-105293","text":"Zero-to-value walkthrough: add "},{"id":"spn-105294","marks":["code"],"text":"open_sentience"},{"id":"spn-105295","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-73905","kind":"quote"},{"id":"blk-73907","kind":"heading","level":2,"spans":[{"id":"spn-105296","text":"Prerequisites"}]},{"id":"blk-73908","items":[{"blocks":[{"id":"blk-73910","kind":"paragraph","spans":[{"id":"spn-105297","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-73909","kind":"list-item"},{"blocks":[{"id":"blk-73912","kind":"paragraph","spans":[{"id":"spn-105298","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-73911","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-73913","kind":"heading","level":2,"spans":[{"id":"spn-105299","text":"1. Add the Dependency"}]},{"id":"blk-73914","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-73915","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-73916","kind":"heading","level":2,"spans":[{"id":"spn-105300","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-73917","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-73918","kind":"paragraph","spans":[{"id":"spn-105301","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-73919","kind":"heading","level":2,"spans":[{"id":"spn-105302","text":"3. Install Your First Agent"}]},{"id":"blk-73920","kind":"paragraph","spans":[{"id":"spn-105303","text":"Use the "},{"id":"spn-105304","marks":["code"],"text":"agent_install"},{"id":"spn-105305","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-73921","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-73922","kind":"paragraph","spans":[{"id":"spn-105306","text":"The agent is now in the "},{"id":"spn-105307","marks":["code"],"text":"installed"},{"id":"spn-105308","text":" state. It is registered but not running."}]},{"id":"blk-73923","kind":"heading","level":2,"spans":[{"id":"spn-105309","text":"4. Check Permissions"}]},{"id":"blk-73924","kind":"paragraph","spans":[{"id":"spn-105310","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-73925","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-73926","kind":"heading","level":2,"spans":[{"id":"spn-105311","text":"5. Enable and Run the Agent"}]},{"id":"blk-73927","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-73928","kind":"heading","level":2,"spans":[{"id":"spn-105312","text":"6. Change Autonomy Level"}]},{"id":"blk-73929","kind":"paragraph","spans":[{"id":"spn-105313","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-73930","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-73931","kind":"paragraph","spans":[{"id":"spn-105314","text":"Each change is recorded in the audit trail."}]},{"id":"blk-73932","kind":"heading","level":2,"spans":[{"id":"spn-105315","text":"7. Query the Audit Trail"}]},{"id":"blk-73933","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-73934","kind":"paragraph","spans":[{"id":"spn-105316","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-73935","kind":"heading","level":2,"spans":[{"id":"spn-105317","text":"8. Lifecycle Transitions"}]},{"id":"blk-73936","kind":"paragraph","spans":[{"id":"spn-105318","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-73937","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-73938","kind":"heading","level":2,"spans":[{"id":"spn-105319","text":"What Happens Next"}]},{"id":"blk-73939","items":[{"blocks":[{"id":"blk-73941","kind":"paragraph","spans":[{"id":"spn-105320","text":"Read "},{"id":"spn-105321","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-105322","text":" to understand the OTP internals"}]}],"id":"blk-73940","kind":"list-item"},{"blocks":[{"id":"blk-73943","kind":"paragraph","spans":[{"id":"spn-105323","text":"Read "},{"id":"spn-105324","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-105325","text":" for the full permission model"}]}],"id":"blk-73942","kind":"list-item"},{"blocks":[{"id":"blk-73945","kind":"paragraph","spans":[{"id":"spn-105326","text":"Read "},{"id":"spn-105327","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-105328","text":" for autonomy details"}]}],"id":"blk-73944","kind":"list-item"},{"blocks":[{"id":"blk-73947","kind":"paragraph","spans":[{"id":"spn-105329","text":"Read "},{"id":"spn-105330","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-105331","text":" to connect with Graphonomous,"}]}],"id":"blk-73946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-73948","kind":"paragraph","spans":[{"id":"spn-105332","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-73949","kind":"heading","level":2,"spans":[{"id":"spn-105333","text":"MCP Tool Equivalents"}]},{"id":"blk-73950","kind":"paragraph","spans":[{"id":"spn-105334","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-73952","spans":[{"id":"spn-105335","text":"Elixir API"}]},{"id":"blk-73953","spans":[{"id":"spn-105336","text":"MCP Tool"}]},{"id":"blk-73954","spans":[{"id":"spn-105337","text":"Purpose"}]}],"id":"blk-73951","kind":"table","rows":[[{"id":"blk-73955","spans":[{"id":"spn-105338","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-73956","spans":[{"id":"spn-105339","marks":["code"],"text":"agent_install"}]},{"id":"blk-73957","spans":[{"id":"spn-105340","text":"Register agent with permissions"}]}],[{"id":"blk-73958","spans":[{"id":"spn-105341","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-73959","spans":[{"id":"spn-105342","marks":["code"],"text":"agent_enable"}]},{"id":"blk-73960","spans":[{"id":"spn-105343","text":"Start the governed process"}]}],[{"id":"blk-73961","spans":[{"id":"spn-105344","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-73962","spans":[{"id":"spn-105345","marks":["code"],"text":"agent_disable"}]},{"id":"blk-73963","spans":[{"id":"spn-105346","text":"Graceful stop"}]}],[{"id":"blk-73964","spans":[{"id":"spn-105347","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-73965","spans":[{"id":"spn-105348","marks":["code"],"text":"agent_status"}]},{"id":"blk-73966","spans":[{"id":"spn-105349","text":"Current state and metadata"}]}],[{"id":"blk-73967","spans":[{"id":"spn-105350","marks":["code"],"text":"audit/2"}]},{"id":"blk-73968","spans":[{"id":"spn-105351","marks":["code"],"text":"agent_audit"}]},{"id":"blk-73969","spans":[{"id":"spn-105352","text":"Query audit trail"}]}],[{"id":"blk-73970","spans":[{"id":"spn-105353","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-73971","spans":[{"id":"spn-105354","marks":["code"],"text":"permission_check"}]},{"id":"blk-73972","spans":[{"id":"spn-105355","text":"Evaluate a permission"}]}],[{"id":"blk-73973","spans":[{"id":"spn-105356","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-73974","spans":[{"id":"spn-105357","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-73975","spans":[{"id":"spn-105358","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaieraa7rep4t55v63rjdlbzolybqhfimedq7mui5w4cusiz4sqghzx3fq","vocabulary":"ampersand.docs.fs.v1"}