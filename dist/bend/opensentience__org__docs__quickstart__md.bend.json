{"bendscript":"0.1","blocks":[{"id":"blk-47937","kind":"heading","level":1,"spans":[{"id":"spn-54082","text":"Quickstart"}]},{"blocks":[{"id":"blk-47939","kind":"paragraph","spans":[{"id":"spn-54083","text":"Zero-to-value walkthrough: add "},{"id":"spn-54084","marks":["code"],"text":"open_sentience"},{"id":"spn-54085","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-47938","kind":"quote"},{"id":"blk-47940","kind":"paragraph","spans":[{"id":"spn-54086","text":"---"}]},{"id":"blk-47941","kind":"heading","level":2,"spans":[{"id":"spn-54087","text":"Prerequisites"}]},{"id":"blk-47942","items":[{"blocks":[{"id":"blk-47944","kind":"paragraph","spans":[{"id":"spn-54088","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-47943","kind":"list-item"},{"blocks":[{"id":"blk-47946","kind":"paragraph","spans":[{"id":"spn-54089","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-47945","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47947","kind":"paragraph","spans":[{"id":"spn-54090","text":"---"}]},{"id":"blk-47948","kind":"heading","level":2,"spans":[{"id":"spn-54091","text":"1. Add the Dependency"}]},{"id":"blk-47949","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-47950","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-47951","kind":"paragraph","spans":[{"id":"spn-54092","text":"---"}]},{"id":"blk-47952","kind":"heading","level":2,"spans":[{"id":"spn-54093","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-47953","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-47954","kind":"paragraph","spans":[{"id":"spn-54094","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-47955","kind":"paragraph","spans":[{"id":"spn-54095","text":"---"}]},{"id":"blk-47956","kind":"heading","level":2,"spans":[{"id":"spn-54096","text":"3. Install Your First Agent"}]},{"id":"blk-47957","kind":"paragraph","spans":[{"id":"spn-54097","text":"Use the "},{"id":"spn-54098","marks":["code"],"text":"agent_install"},{"id":"spn-54099","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-47958","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-47959","kind":"paragraph","spans":[{"id":"spn-54100","text":"The agent is now in the "},{"id":"spn-54101","marks":["code"],"text":"installed"},{"id":"spn-54102","text":" state. It is registered but not running."}]},{"id":"blk-47960","kind":"paragraph","spans":[{"id":"spn-54103","text":"---"}]},{"id":"blk-47961","kind":"heading","level":2,"spans":[{"id":"spn-54104","text":"4. Check Permissions"}]},{"id":"blk-47962","kind":"paragraph","spans":[{"id":"spn-54105","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-47963","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-47964","kind":"paragraph","spans":[{"id":"spn-54106","text":"---"}]},{"id":"blk-47965","kind":"heading","level":2,"spans":[{"id":"spn-54107","text":"5. Enable and Run the Agent"}]},{"id":"blk-47966","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-47967","kind":"paragraph","spans":[{"id":"spn-54108","text":"---"}]},{"id":"blk-47968","kind":"heading","level":2,"spans":[{"id":"spn-54109","text":"6. Change Autonomy Level"}]},{"id":"blk-47969","kind":"paragraph","spans":[{"id":"spn-54110","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-47970","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-47971","kind":"paragraph","spans":[{"id":"spn-54111","text":"Each change is recorded in the audit trail."}]},{"id":"blk-47972","kind":"paragraph","spans":[{"id":"spn-54112","text":"---"}]},{"id":"blk-47973","kind":"heading","level":2,"spans":[{"id":"spn-54113","text":"7. Query the Audit Trail"}]},{"id":"blk-47974","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-47975","kind":"paragraph","spans":[{"id":"spn-54114","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-47976","kind":"paragraph","spans":[{"id":"spn-54115","text":"---"}]},{"id":"blk-47977","kind":"heading","level":2,"spans":[{"id":"spn-54116","text":"8. Lifecycle Transitions"}]},{"id":"blk-47978","kind":"paragraph","spans":[{"id":"spn-54117","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-47979","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-47980","kind":"paragraph","spans":[{"id":"spn-54118","text":"---"}]},{"id":"blk-47981","kind":"heading","level":2,"spans":[{"id":"spn-54119","text":"What Happens Next"}]},{"id":"blk-47982","items":[{"blocks":[{"id":"blk-47984","kind":"paragraph","spans":[{"id":"spn-54120","text":"Read "},{"id":"spn-54121","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-54122","text":" to understand the OTP internals"}]}],"id":"blk-47983","kind":"list-item"},{"blocks":[{"id":"blk-47986","kind":"paragraph","spans":[{"id":"spn-54123","text":"Read "},{"id":"spn-54124","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-54125","text":" for the full permission model"}]}],"id":"blk-47985","kind":"list-item"},{"blocks":[{"id":"blk-47988","kind":"paragraph","spans":[{"id":"spn-54126","text":"Read "},{"id":"spn-54127","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-54128","text":" for autonomy details"}]}],"id":"blk-47987","kind":"list-item"},{"blocks":[{"id":"blk-47990","kind":"paragraph","spans":[{"id":"spn-54129","text":"Read "},{"id":"spn-54130","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-54131","text":" to connect with Graphonomous,"}]}],"id":"blk-47989","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47991","kind":"paragraph","spans":[{"id":"spn-54132","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-47992","kind":"paragraph","spans":[{"id":"spn-54133","text":"---"}]},{"id":"blk-47993","kind":"heading","level":2,"spans":[{"id":"spn-54134","text":"MCP Tool Equivalents"}]},{"id":"blk-47994","kind":"paragraph","spans":[{"id":"spn-54135","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-47996","spans":[{"id":"spn-54136","text":"Elixir API"}]},{"id":"blk-47997","spans":[{"id":"spn-54137","text":"MCP Tool"}]},{"id":"blk-47998","spans":[{"id":"spn-54138","text":"Purpose"}]}],"id":"blk-47995","kind":"table","rows":[[{"id":"blk-47999","spans":[{"id":"spn-54139","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-48000","spans":[{"id":"spn-54140","marks":["code"],"text":"agent_install"}]},{"id":"blk-48001","spans":[{"id":"spn-54141","text":"Register agent with permissions"}]}],[{"id":"blk-48002","spans":[{"id":"spn-54142","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-48003","spans":[{"id":"spn-54143","marks":["code"],"text":"agent_enable"}]},{"id":"blk-48004","spans":[{"id":"spn-54144","text":"Start the governed process"}]}],[{"id":"blk-48005","spans":[{"id":"spn-54145","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-48006","spans":[{"id":"spn-54146","marks":["code"],"text":"agent_disable"}]},{"id":"blk-48007","spans":[{"id":"spn-54147","text":"Graceful stop"}]}],[{"id":"blk-48008","spans":[{"id":"spn-54148","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-48009","spans":[{"id":"spn-54149","marks":["code"],"text":"agent_status"}]},{"id":"blk-48010","spans":[{"id":"spn-54150","text":"Current state and metadata"}]}],[{"id":"blk-48011","spans":[{"id":"spn-54151","marks":["code"],"text":"audit/2"}]},{"id":"blk-48012","spans":[{"id":"spn-54152","marks":["code"],"text":"agent_audit"}]},{"id":"blk-48013","spans":[{"id":"spn-54153","text":"Query audit trail"}]}],[{"id":"blk-48014","spans":[{"id":"spn-54154","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-48015","spans":[{"id":"spn-54155","marks":["code"],"text":"permission_check"}]},{"id":"blk-48016","spans":[{"id":"spn-54156","text":"Evaluate a permission"}]}],[{"id":"blk-48017","spans":[{"id":"spn-54157","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-48018","spans":[{"id":"spn-54158","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-48019","spans":[{"id":"spn-54159","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaierawgqpdfetajp5ym5c3bq6yygtaznmayykn625nxt3ogq4pqqa63oa","vocabulary":"ampersand.docs.fs.v1"}