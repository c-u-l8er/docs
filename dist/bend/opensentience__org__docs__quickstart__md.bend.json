{"bendscript":"0.1","blocks":[{"id":"blk-49019","kind":"heading","level":1,"spans":[{"id":"spn-57005","text":"Quickstart"}]},{"blocks":[{"id":"blk-49021","kind":"paragraph","spans":[{"id":"spn-57006","text":"Zero-to-value walkthrough: add "},{"id":"spn-57007","marks":["code"],"text":"open_sentience"},{"id":"spn-57008","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-49020","kind":"quote"},{"id":"blk-49022","kind":"paragraph","spans":[{"id":"spn-57009","text":"---"}]},{"id":"blk-49023","kind":"heading","level":2,"spans":[{"id":"spn-57010","text":"Prerequisites"}]},{"id":"blk-49024","items":[{"blocks":[{"id":"blk-49026","kind":"paragraph","spans":[{"id":"spn-57011","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-49025","kind":"list-item"},{"blocks":[{"id":"blk-49028","kind":"paragraph","spans":[{"id":"spn-57012","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-49027","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49029","kind":"paragraph","spans":[{"id":"spn-57013","text":"---"}]},{"id":"blk-49030","kind":"heading","level":2,"spans":[{"id":"spn-57014","text":"1. Add the Dependency"}]},{"id":"blk-49031","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-49032","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-49033","kind":"paragraph","spans":[{"id":"spn-57015","text":"---"}]},{"id":"blk-49034","kind":"heading","level":2,"spans":[{"id":"spn-57016","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-49035","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-49036","kind":"paragraph","spans":[{"id":"spn-57017","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-49037","kind":"paragraph","spans":[{"id":"spn-57018","text":"---"}]},{"id":"blk-49038","kind":"heading","level":2,"spans":[{"id":"spn-57019","text":"3. Install Your First Agent"}]},{"id":"blk-49039","kind":"paragraph","spans":[{"id":"spn-57020","text":"Use the "},{"id":"spn-57021","marks":["code"],"text":"agent_install"},{"id":"spn-57022","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-49040","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-49041","kind":"paragraph","spans":[{"id":"spn-57023","text":"The agent is now in the "},{"id":"spn-57024","marks":["code"],"text":"installed"},{"id":"spn-57025","text":" state. It is registered but not running."}]},{"id":"blk-49042","kind":"paragraph","spans":[{"id":"spn-57026","text":"---"}]},{"id":"blk-49043","kind":"heading","level":2,"spans":[{"id":"spn-57027","text":"4. Check Permissions"}]},{"id":"blk-49044","kind":"paragraph","spans":[{"id":"spn-57028","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-49045","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-49046","kind":"paragraph","spans":[{"id":"spn-57029","text":"---"}]},{"id":"blk-49047","kind":"heading","level":2,"spans":[{"id":"spn-57030","text":"5. Enable and Run the Agent"}]},{"id":"blk-49048","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-49049","kind":"paragraph","spans":[{"id":"spn-57031","text":"---"}]},{"id":"blk-49050","kind":"heading","level":2,"spans":[{"id":"spn-57032","text":"6. Change Autonomy Level"}]},{"id":"blk-49051","kind":"paragraph","spans":[{"id":"spn-57033","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-49052","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-49053","kind":"paragraph","spans":[{"id":"spn-57034","text":"Each change is recorded in the audit trail."}]},{"id":"blk-49054","kind":"paragraph","spans":[{"id":"spn-57035","text":"---"}]},{"id":"blk-49055","kind":"heading","level":2,"spans":[{"id":"spn-57036","text":"7. Query the Audit Trail"}]},{"id":"blk-49056","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-49057","kind":"paragraph","spans":[{"id":"spn-57037","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-49058","kind":"paragraph","spans":[{"id":"spn-57038","text":"---"}]},{"id":"blk-49059","kind":"heading","level":2,"spans":[{"id":"spn-57039","text":"8. Lifecycle Transitions"}]},{"id":"blk-49060","kind":"paragraph","spans":[{"id":"spn-57040","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-49061","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-49062","kind":"paragraph","spans":[{"id":"spn-57041","text":"---"}]},{"id":"blk-49063","kind":"heading","level":2,"spans":[{"id":"spn-57042","text":"What Happens Next"}]},{"id":"blk-49064","items":[{"blocks":[{"id":"blk-49066","kind":"paragraph","spans":[{"id":"spn-57043","text":"Read "},{"id":"spn-57044","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-57045","text":" to understand the OTP internals"}]}],"id":"blk-49065","kind":"list-item"},{"blocks":[{"id":"blk-49068","kind":"paragraph","spans":[{"id":"spn-57046","text":"Read "},{"id":"spn-57047","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-57048","text":" for the full permission model"}]}],"id":"blk-49067","kind":"list-item"},{"blocks":[{"id":"blk-49070","kind":"paragraph","spans":[{"id":"spn-57049","text":"Read "},{"id":"spn-57050","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-57051","text":" for autonomy details"}]}],"id":"blk-49069","kind":"list-item"},{"blocks":[{"id":"blk-49072","kind":"paragraph","spans":[{"id":"spn-57052","text":"Read "},{"id":"spn-57053","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-57054","text":" to connect with Graphonomous,"}]}],"id":"blk-49071","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49073","kind":"paragraph","spans":[{"id":"spn-57055","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-49074","kind":"paragraph","spans":[{"id":"spn-57056","text":"---"}]},{"id":"blk-49075","kind":"heading","level":2,"spans":[{"id":"spn-57057","text":"MCP Tool Equivalents"}]},{"id":"blk-49076","kind":"paragraph","spans":[{"id":"spn-57058","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-49078","spans":[{"id":"spn-57059","text":"Elixir API"}]},{"id":"blk-49079","spans":[{"id":"spn-57060","text":"MCP Tool"}]},{"id":"blk-49080","spans":[{"id":"spn-57061","text":"Purpose"}]}],"id":"blk-49077","kind":"table","rows":[[{"id":"blk-49081","spans":[{"id":"spn-57062","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-49082","spans":[{"id":"spn-57063","marks":["code"],"text":"agent_install"}]},{"id":"blk-49083","spans":[{"id":"spn-57064","text":"Register agent with permissions"}]}],[{"id":"blk-49084","spans":[{"id":"spn-57065","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-49085","spans":[{"id":"spn-57066","marks":["code"],"text":"agent_enable"}]},{"id":"blk-49086","spans":[{"id":"spn-57067","text":"Start the governed process"}]}],[{"id":"blk-49087","spans":[{"id":"spn-57068","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-49088","spans":[{"id":"spn-57069","marks":["code"],"text":"agent_disable"}]},{"id":"blk-49089","spans":[{"id":"spn-57070","text":"Graceful stop"}]}],[{"id":"blk-49090","spans":[{"id":"spn-57071","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-49091","spans":[{"id":"spn-57072","marks":["code"],"text":"agent_status"}]},{"id":"blk-49092","spans":[{"id":"spn-57073","text":"Current state and metadata"}]}],[{"id":"blk-49093","spans":[{"id":"spn-57074","marks":["code"],"text":"audit/2"}]},{"id":"blk-49094","spans":[{"id":"spn-57075","marks":["code"],"text":"agent_audit"}]},{"id":"blk-49095","spans":[{"id":"spn-57076","text":"Query audit trail"}]}],[{"id":"blk-49096","spans":[{"id":"spn-57077","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-49097","spans":[{"id":"spn-57078","marks":["code"],"text":"permission_check"}]},{"id":"blk-49098","spans":[{"id":"spn-57079","text":"Evaluate a permission"}]}],[{"id":"blk-49099","spans":[{"id":"spn-57080","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-49100","spans":[{"id":"spn-57081","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-49101","spans":[{"id":"spn-57082","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaiera3d43dfixzqzsaqgkkowxio6hkj5sh3otu3b4v6meay5si3hsn2vq","vocabulary":"ampersand.docs.fs.v1"}