{"bendscript":"0.1","blocks":[{"id":"blk-97229","kind":"heading","level":1,"spans":[{"id":"spn-161607","text":"Quickstart"}]},{"blocks":[{"id":"blk-97231","kind":"paragraph","spans":[{"id":"spn-161608","text":"Zero-to-value walkthrough: add "},{"id":"spn-161609","marks":["code"],"text":"open_sentience"},{"id":"spn-161610","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-97230","kind":"quote"},{"id":"blk-97232","kind":"heading","level":2,"spans":[{"id":"spn-161611","text":"Prerequisites"}]},{"id":"blk-97233","items":[{"blocks":[{"id":"blk-97235","kind":"paragraph","spans":[{"id":"spn-161612","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-97234","kind":"list-item"},{"blocks":[{"id":"blk-97237","kind":"paragraph","spans":[{"id":"spn-161613","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-97236","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-97238","kind":"heading","level":2,"spans":[{"id":"spn-161614","text":"1. Add the Dependency"}]},{"id":"blk-97239","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-97240","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-97241","kind":"heading","level":2,"spans":[{"id":"spn-161615","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-97242","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-97243","kind":"paragraph","spans":[{"id":"spn-161616","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-97244","kind":"heading","level":2,"spans":[{"id":"spn-161617","text":"3. Install Your First Agent"}]},{"id":"blk-97245","kind":"paragraph","spans":[{"id":"spn-161618","text":"Use the "},{"id":"spn-161619","marks":["code"],"text":"agent_install"},{"id":"spn-161620","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-97246","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-97247","kind":"paragraph","spans":[{"id":"spn-161621","text":"The agent is now in the "},{"id":"spn-161622","marks":["code"],"text":"installed"},{"id":"spn-161623","text":" state. It is registered but not running."}]},{"id":"blk-97248","kind":"heading","level":2,"spans":[{"id":"spn-161624","text":"4. Check Permissions"}]},{"id":"blk-97249","kind":"paragraph","spans":[{"id":"spn-161625","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-97250","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-97251","kind":"heading","level":2,"spans":[{"id":"spn-161626","text":"5. Enable and Run the Agent"}]},{"id":"blk-97252","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-97253","kind":"heading","level":2,"spans":[{"id":"spn-161627","text":"6. Change Autonomy Level"}]},{"id":"blk-97254","kind":"paragraph","spans":[{"id":"spn-161628","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-97255","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-97256","kind":"paragraph","spans":[{"id":"spn-161629","text":"Each change is recorded in the audit trail."}]},{"id":"blk-97257","kind":"heading","level":2,"spans":[{"id":"spn-161630","text":"7. Query the Audit Trail"}]},{"id":"blk-97258","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-97259","kind":"paragraph","spans":[{"id":"spn-161631","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-97260","kind":"heading","level":2,"spans":[{"id":"spn-161632","text":"8. Lifecycle Transitions"}]},{"id":"blk-97261","kind":"paragraph","spans":[{"id":"spn-161633","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-97262","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-97263","kind":"heading","level":2,"spans":[{"id":"spn-161634","text":"What Happens Next"}]},{"id":"blk-97264","items":[{"blocks":[{"id":"blk-97266","kind":"paragraph","spans":[{"id":"spn-161635","text":"Read "},{"id":"spn-161636","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-161637","text":" to understand the OTP internals"}]}],"id":"blk-97265","kind":"list-item"},{"blocks":[{"id":"blk-97268","kind":"paragraph","spans":[{"id":"spn-161638","text":"Read "},{"id":"spn-161639","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-161640","text":" for the full permission model"}]}],"id":"blk-97267","kind":"list-item"},{"blocks":[{"id":"blk-97270","kind":"paragraph","spans":[{"id":"spn-161641","text":"Read "},{"id":"spn-161642","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-161643","text":" for autonomy details"}]}],"id":"blk-97269","kind":"list-item"},{"blocks":[{"id":"blk-97272","kind":"paragraph","spans":[{"id":"spn-161644","text":"Read "},{"id":"spn-161645","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-161646","text":" to connect with Graphonomous,"}]}],"id":"blk-97271","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-97273","kind":"paragraph","spans":[{"id":"spn-161647","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-97274","kind":"heading","level":2,"spans":[{"id":"spn-161648","text":"MCP Tool Equivalents"}]},{"id":"blk-97275","kind":"paragraph","spans":[{"id":"spn-161649","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-97277","spans":[{"id":"spn-161650","text":"Elixir API"}]},{"id":"blk-97278","spans":[{"id":"spn-161651","text":"MCP Tool"}]},{"id":"blk-97279","spans":[{"id":"spn-161652","text":"Purpose"}]}],"id":"blk-97276","kind":"table","rows":[[{"id":"blk-97280","spans":[{"id":"spn-161653","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-97281","spans":[{"id":"spn-161654","marks":["code"],"text":"agent_install"}]},{"id":"blk-97282","spans":[{"id":"spn-161655","text":"Register agent with permissions"}]}],[{"id":"blk-97283","spans":[{"id":"spn-161656","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-97284","spans":[{"id":"spn-161657","marks":["code"],"text":"agent_enable"}]},{"id":"blk-97285","spans":[{"id":"spn-161658","text":"Start the governed process"}]}],[{"id":"blk-97286","spans":[{"id":"spn-161659","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-97287","spans":[{"id":"spn-161660","marks":["code"],"text":"agent_disable"}]},{"id":"blk-97288","spans":[{"id":"spn-161661","text":"Graceful stop"}]}],[{"id":"blk-97289","spans":[{"id":"spn-161662","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-97290","spans":[{"id":"spn-161663","marks":["code"],"text":"agent_status"}]},{"id":"blk-97291","spans":[{"id":"spn-161664","text":"Current state and metadata"}]}],[{"id":"blk-97292","spans":[{"id":"spn-161665","marks":["code"],"text":"audit/2"}]},{"id":"blk-97293","spans":[{"id":"spn-161666","marks":["code"],"text":"agent_audit"}]},{"id":"blk-97294","spans":[{"id":"spn-161667","text":"Query audit trail"}]}],[{"id":"blk-97295","spans":[{"id":"spn-161668","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-97296","spans":[{"id":"spn-161669","marks":["code"],"text":"permission_check"}]},{"id":"blk-97297","spans":[{"id":"spn-161670","text":"Evaluate a permission"}]}],[{"id":"blk-97298","spans":[{"id":"spn-161671","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-97299","spans":[{"id":"spn-161672","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-97300","spans":[{"id":"spn-161673","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaieraadfbbbl6jvsi4mxtfxylfj27nkbp7rfj4cl3ub7tdqecdewgdkjq","vocabulary":"ampersand.docs.fs.v1"}