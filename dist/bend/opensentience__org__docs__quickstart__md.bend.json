{"bendscript":"0.1","blocks":[{"id":"blk-74732","kind":"heading","level":1,"spans":[{"id":"spn-107905","text":"Quickstart"}]},{"blocks":[{"id":"blk-74734","kind":"paragraph","spans":[{"id":"spn-107906","text":"Zero-to-value walkthrough: add "},{"id":"spn-107907","marks":["code"],"text":"open_sentience"},{"id":"spn-107908","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-74733","kind":"quote"},{"id":"blk-74735","kind":"heading","level":2,"spans":[{"id":"spn-107909","text":"Prerequisites"}]},{"id":"blk-74736","items":[{"blocks":[{"id":"blk-74738","kind":"paragraph","spans":[{"id":"spn-107910","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-74737","kind":"list-item"},{"blocks":[{"id":"blk-74740","kind":"paragraph","spans":[{"id":"spn-107911","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-74739","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74741","kind":"heading","level":2,"spans":[{"id":"spn-107912","text":"1. Add the Dependency"}]},{"id":"blk-74742","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-74743","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-74744","kind":"heading","level":2,"spans":[{"id":"spn-107913","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-74745","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-74746","kind":"paragraph","spans":[{"id":"spn-107914","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-74747","kind":"heading","level":2,"spans":[{"id":"spn-107915","text":"3. Install Your First Agent"}]},{"id":"blk-74748","kind":"paragraph","spans":[{"id":"spn-107916","text":"Use the "},{"id":"spn-107917","marks":["code"],"text":"agent_install"},{"id":"spn-107918","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-74749","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-74750","kind":"paragraph","spans":[{"id":"spn-107919","text":"The agent is now in the "},{"id":"spn-107920","marks":["code"],"text":"installed"},{"id":"spn-107921","text":" state. It is registered but not running."}]},{"id":"blk-74751","kind":"heading","level":2,"spans":[{"id":"spn-107922","text":"4. Check Permissions"}]},{"id":"blk-74752","kind":"paragraph","spans":[{"id":"spn-107923","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-74753","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-74754","kind":"heading","level":2,"spans":[{"id":"spn-107924","text":"5. Enable and Run the Agent"}]},{"id":"blk-74755","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-74756","kind":"heading","level":2,"spans":[{"id":"spn-107925","text":"6. Change Autonomy Level"}]},{"id":"blk-74757","kind":"paragraph","spans":[{"id":"spn-107926","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-74758","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-74759","kind":"paragraph","spans":[{"id":"spn-107927","text":"Each change is recorded in the audit trail."}]},{"id":"blk-74760","kind":"heading","level":2,"spans":[{"id":"spn-107928","text":"7. Query the Audit Trail"}]},{"id":"blk-74761","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-74762","kind":"paragraph","spans":[{"id":"spn-107929","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-74763","kind":"heading","level":2,"spans":[{"id":"spn-107930","text":"8. Lifecycle Transitions"}]},{"id":"blk-74764","kind":"paragraph","spans":[{"id":"spn-107931","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-74765","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-74766","kind":"heading","level":2,"spans":[{"id":"spn-107932","text":"What Happens Next"}]},{"id":"blk-74767","items":[{"blocks":[{"id":"blk-74769","kind":"paragraph","spans":[{"id":"spn-107933","text":"Read "},{"id":"spn-107934","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-107935","text":" to understand the OTP internals"}]}],"id":"blk-74768","kind":"list-item"},{"blocks":[{"id":"blk-74771","kind":"paragraph","spans":[{"id":"spn-107936","text":"Read "},{"id":"spn-107937","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-107938","text":" for the full permission model"}]}],"id":"blk-74770","kind":"list-item"},{"blocks":[{"id":"blk-74773","kind":"paragraph","spans":[{"id":"spn-107939","text":"Read "},{"id":"spn-107940","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-107941","text":" for autonomy details"}]}],"id":"blk-74772","kind":"list-item"},{"blocks":[{"id":"blk-74775","kind":"paragraph","spans":[{"id":"spn-107942","text":"Read "},{"id":"spn-107943","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-107944","text":" to connect with Graphonomous,"}]}],"id":"blk-74774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74776","kind":"paragraph","spans":[{"id":"spn-107945","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-74777","kind":"heading","level":2,"spans":[{"id":"spn-107946","text":"MCP Tool Equivalents"}]},{"id":"blk-74778","kind":"paragraph","spans":[{"id":"spn-107947","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-74780","spans":[{"id":"spn-107948","text":"Elixir API"}]},{"id":"blk-74781","spans":[{"id":"spn-107949","text":"MCP Tool"}]},{"id":"blk-74782","spans":[{"id":"spn-107950","text":"Purpose"}]}],"id":"blk-74779","kind":"table","rows":[[{"id":"blk-74783","spans":[{"id":"spn-107951","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-74784","spans":[{"id":"spn-107952","marks":["code"],"text":"agent_install"}]},{"id":"blk-74785","spans":[{"id":"spn-107953","text":"Register agent with permissions"}]}],[{"id":"blk-74786","spans":[{"id":"spn-107954","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-74787","spans":[{"id":"spn-107955","marks":["code"],"text":"agent_enable"}]},{"id":"blk-74788","spans":[{"id":"spn-107956","text":"Start the governed process"}]}],[{"id":"blk-74789","spans":[{"id":"spn-107957","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-74790","spans":[{"id":"spn-107958","marks":["code"],"text":"agent_disable"}]},{"id":"blk-74791","spans":[{"id":"spn-107959","text":"Graceful stop"}]}],[{"id":"blk-74792","spans":[{"id":"spn-107960","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-74793","spans":[{"id":"spn-107961","marks":["code"],"text":"agent_status"}]},{"id":"blk-74794","spans":[{"id":"spn-107962","text":"Current state and metadata"}]}],[{"id":"blk-74795","spans":[{"id":"spn-107963","marks":["code"],"text":"audit/2"}]},{"id":"blk-74796","spans":[{"id":"spn-107964","marks":["code"],"text":"agent_audit"}]},{"id":"blk-74797","spans":[{"id":"spn-107965","text":"Query audit trail"}]}],[{"id":"blk-74798","spans":[{"id":"spn-107966","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-74799","spans":[{"id":"spn-107967","marks":["code"],"text":"permission_check"}]},{"id":"blk-74800","spans":[{"id":"spn-107968","text":"Evaluate a permission"}]}],[{"id":"blk-74801","spans":[{"id":"spn-107969","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-74802","spans":[{"id":"spn-107970","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-74803","spans":[{"id":"spn-107971","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaierayieebbcsugkrtgadg5osy74zwg3gr6otbziszu6bblbvy5tgisaq","vocabulary":"ampersand.docs.fs.v1"}