{"bendscript":"0.1","blocks":[{"id":"blk-48047","kind":"heading","level":1,"spans":[{"id":"spn-54711","text":"Quickstart"}]},{"blocks":[{"id":"blk-48049","kind":"paragraph","spans":[{"id":"spn-54712","text":"Zero-to-value walkthrough: add "},{"id":"spn-54713","marks":["code"],"text":"open_sentience"},{"id":"spn-54714","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-48048","kind":"quote"},{"id":"blk-48050","kind":"paragraph","spans":[{"id":"spn-54715","text":"---"}]},{"id":"blk-48051","kind":"heading","level":2,"spans":[{"id":"spn-54716","text":"Prerequisites"}]},{"id":"blk-48052","items":[{"blocks":[{"id":"blk-48054","kind":"paragraph","spans":[{"id":"spn-54717","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-48053","kind":"list-item"},{"blocks":[{"id":"blk-48056","kind":"paragraph","spans":[{"id":"spn-54718","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-48055","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48057","kind":"paragraph","spans":[{"id":"spn-54719","text":"---"}]},{"id":"blk-48058","kind":"heading","level":2,"spans":[{"id":"spn-54720","text":"1. Add the Dependency"}]},{"id":"blk-48059","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-48060","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-48061","kind":"paragraph","spans":[{"id":"spn-54721","text":"---"}]},{"id":"blk-48062","kind":"heading","level":2,"spans":[{"id":"spn-54722","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-48063","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-48064","kind":"paragraph","spans":[{"id":"spn-54723","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-48065","kind":"paragraph","spans":[{"id":"spn-54724","text":"---"}]},{"id":"blk-48066","kind":"heading","level":2,"spans":[{"id":"spn-54725","text":"3. Install Your First Agent"}]},{"id":"blk-48067","kind":"paragraph","spans":[{"id":"spn-54726","text":"Use the "},{"id":"spn-54727","marks":["code"],"text":"agent_install"},{"id":"spn-54728","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-48068","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-48069","kind":"paragraph","spans":[{"id":"spn-54729","text":"The agent is now in the "},{"id":"spn-54730","marks":["code"],"text":"installed"},{"id":"spn-54731","text":" state. It is registered but not running."}]},{"id":"blk-48070","kind":"paragraph","spans":[{"id":"spn-54732","text":"---"}]},{"id":"blk-48071","kind":"heading","level":2,"spans":[{"id":"spn-54733","text":"4. Check Permissions"}]},{"id":"blk-48072","kind":"paragraph","spans":[{"id":"spn-54734","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-48073","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-48074","kind":"paragraph","spans":[{"id":"spn-54735","text":"---"}]},{"id":"blk-48075","kind":"heading","level":2,"spans":[{"id":"spn-54736","text":"5. Enable and Run the Agent"}]},{"id":"blk-48076","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-48077","kind":"paragraph","spans":[{"id":"spn-54737","text":"---"}]},{"id":"blk-48078","kind":"heading","level":2,"spans":[{"id":"spn-54738","text":"6. Change Autonomy Level"}]},{"id":"blk-48079","kind":"paragraph","spans":[{"id":"spn-54739","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-48080","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-48081","kind":"paragraph","spans":[{"id":"spn-54740","text":"Each change is recorded in the audit trail."}]},{"id":"blk-48082","kind":"paragraph","spans":[{"id":"spn-54741","text":"---"}]},{"id":"blk-48083","kind":"heading","level":2,"spans":[{"id":"spn-54742","text":"7. Query the Audit Trail"}]},{"id":"blk-48084","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-48085","kind":"paragraph","spans":[{"id":"spn-54743","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-48086","kind":"paragraph","spans":[{"id":"spn-54744","text":"---"}]},{"id":"blk-48087","kind":"heading","level":2,"spans":[{"id":"spn-54745","text":"8. Lifecycle Transitions"}]},{"id":"blk-48088","kind":"paragraph","spans":[{"id":"spn-54746","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-48089","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-48090","kind":"paragraph","spans":[{"id":"spn-54747","text":"---"}]},{"id":"blk-48091","kind":"heading","level":2,"spans":[{"id":"spn-54748","text":"What Happens Next"}]},{"id":"blk-48092","items":[{"blocks":[{"id":"blk-48094","kind":"paragraph","spans":[{"id":"spn-54749","text":"Read "},{"id":"spn-54750","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-54751","text":" to understand the OTP internals"}]}],"id":"blk-48093","kind":"list-item"},{"blocks":[{"id":"blk-48096","kind":"paragraph","spans":[{"id":"spn-54752","text":"Read "},{"id":"spn-54753","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-54754","text":" for the full permission model"}]}],"id":"blk-48095","kind":"list-item"},{"blocks":[{"id":"blk-48098","kind":"paragraph","spans":[{"id":"spn-54755","text":"Read "},{"id":"spn-54756","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-54757","text":" for autonomy details"}]}],"id":"blk-48097","kind":"list-item"},{"blocks":[{"id":"blk-48100","kind":"paragraph","spans":[{"id":"spn-54758","text":"Read "},{"id":"spn-54759","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-54760","text":" to connect with Graphonomous,"}]}],"id":"blk-48099","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48101","kind":"paragraph","spans":[{"id":"spn-54761","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-48102","kind":"paragraph","spans":[{"id":"spn-54762","text":"---"}]},{"id":"blk-48103","kind":"heading","level":2,"spans":[{"id":"spn-54763","text":"MCP Tool Equivalents"}]},{"id":"blk-48104","kind":"paragraph","spans":[{"id":"spn-54764","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-48106","spans":[{"id":"spn-54765","text":"Elixir API"}]},{"id":"blk-48107","spans":[{"id":"spn-54766","text":"MCP Tool"}]},{"id":"blk-48108","spans":[{"id":"spn-54767","text":"Purpose"}]}],"id":"blk-48105","kind":"table","rows":[[{"id":"blk-48109","spans":[{"id":"spn-54768","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-48110","spans":[{"id":"spn-54769","marks":["code"],"text":"agent_install"}]},{"id":"blk-48111","spans":[{"id":"spn-54770","text":"Register agent with permissions"}]}],[{"id":"blk-48112","spans":[{"id":"spn-54771","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-48113","spans":[{"id":"spn-54772","marks":["code"],"text":"agent_enable"}]},{"id":"blk-48114","spans":[{"id":"spn-54773","text":"Start the governed process"}]}],[{"id":"blk-48115","spans":[{"id":"spn-54774","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-48116","spans":[{"id":"spn-54775","marks":["code"],"text":"agent_disable"}]},{"id":"blk-48117","spans":[{"id":"spn-54776","text":"Graceful stop"}]}],[{"id":"blk-48118","spans":[{"id":"spn-54777","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-48119","spans":[{"id":"spn-54778","marks":["code"],"text":"agent_status"}]},{"id":"blk-48120","spans":[{"id":"spn-54779","text":"Current state and metadata"}]}],[{"id":"blk-48121","spans":[{"id":"spn-54780","marks":["code"],"text":"audit/2"}]},{"id":"blk-48122","spans":[{"id":"spn-54781","marks":["code"],"text":"agent_audit"}]},{"id":"blk-48123","spans":[{"id":"spn-54782","text":"Query audit trail"}]}],[{"id":"blk-48124","spans":[{"id":"spn-54783","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-48125","spans":[{"id":"spn-54784","marks":["code"],"text":"permission_check"}]},{"id":"blk-48126","spans":[{"id":"spn-54785","text":"Evaluate a permission"}]}],[{"id":"blk-48127","spans":[{"id":"spn-54786","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-48128","spans":[{"id":"spn-54787","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-48129","spans":[{"id":"spn-54788","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaierazezvsoy6qemzodycuz3ni6nouufauvmmjmvhxgobnbcoepczmkga","vocabulary":"ampersand.docs.fs.v1"}