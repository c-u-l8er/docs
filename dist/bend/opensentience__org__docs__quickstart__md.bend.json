{"bendscript":"0.1","blocks":[{"id":"blk-48533","kind":"heading","level":1,"spans":[{"id":"spn-55885","text":"Quickstart"}]},{"blocks":[{"id":"blk-48535","kind":"paragraph","spans":[{"id":"spn-55886","text":"Zero-to-value walkthrough: add "},{"id":"spn-55887","marks":["code"],"text":"open_sentience"},{"id":"spn-55888","text":" to your project, install an agent, configure permissions, and run it under governance."}]}],"id":"blk-48534","kind":"quote"},{"id":"blk-48536","kind":"paragraph","spans":[{"id":"spn-55889","text":"---"}]},{"id":"blk-48537","kind":"heading","level":2,"spans":[{"id":"spn-55890","text":"Prerequisites"}]},{"id":"blk-48538","items":[{"blocks":[{"id":"blk-48540","kind":"paragraph","spans":[{"id":"spn-55891","text":"Elixir 1.16+ and OTP 26+"}]}],"id":"blk-48539","kind":"list-item"},{"blocks":[{"id":"blk-48542","kind":"paragraph","spans":[{"id":"spn-55892","text":"An existing Mix project with a supervision tree"}]}],"id":"blk-48541","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48543","kind":"paragraph","spans":[{"id":"spn-55893","text":"---"}]},{"id":"blk-48544","kind":"heading","level":2,"spans":[{"id":"spn-55894","text":"1. Add the Dependency"}]},{"id":"blk-48545","kind":"code","language":"elixir","text":"# mix.exs\ndefp deps do\n  [\n    {:open_sentience, \"~> 0.1.0\"}\n  ]\nend"},{"id":"blk-48546","kind":"code","language":"sh","text":"mix deps.get"},{"id":"blk-48547","kind":"paragraph","spans":[{"id":"spn-55895","text":"---"}]},{"id":"blk-48548","kind":"heading","level":2,"spans":[{"id":"spn-55896","text":"2. Add to Your Supervision Tree"}]},{"id":"blk-48549","kind":"code","language":"elixir","text":"# lib/my_app/application.ex\ndef start(_type, _args) do\n  children = [\n    # Your existing children...\n    {OpenSentience.Supervisor, []}\n  ]\n\n  opts = [strategy: :one_for_one, name: MyApp.Supervisor]\n  Supervisor.start_link(children, opts)\nend"},{"id":"blk-48550","kind":"paragraph","spans":[{"id":"spn-55897","text":"This starts the PermissionEngine, AutonomyController, AuditWriter, AgentSupervisor, and MCP Server."}]},{"id":"blk-48551","kind":"paragraph","spans":[{"id":"spn-55898","text":"---"}]},{"id":"blk-48552","kind":"heading","level":2,"spans":[{"id":"spn-55899","text":"3. Install Your First Agent"}]},{"id":"blk-48553","kind":"paragraph","spans":[{"id":"spn-55900","text":"Use the "},{"id":"spn-55901","marks":["code"],"text":"agent_install"},{"id":"spn-55902","text":" MCP tool (or call the Elixir API directly):"}]},{"id":"blk-48554","kind":"code","language":"elixir","text":"OpenSentience.install_agent(%{\n  agent_id: \"my-worker\",\n  name: \"My Worker Agent\",\n  child_spec: {MyApp.Worker, []},\n  permissions: %{\n    granted: [\n      %{type: :filesystem, access: :read, resource: \"/data/**\"},\n      %{type: :network, access: :outbound, resource: \"api.example.com\"}\n    ],\n    denied: [\n      %{type: :filesystem, access: :write, resource: \"/etc/**\"}\n    ]\n  }\n})"},{"id":"blk-48555","kind":"paragraph","spans":[{"id":"spn-55903","text":"The agent is now in the "},{"id":"spn-55904","marks":["code"],"text":"installed"},{"id":"spn-55905","text":" state. It is registered but not running."}]},{"id":"blk-48556","kind":"paragraph","spans":[{"id":"spn-55906","text":"---"}]},{"id":"blk-48557","kind":"heading","level":2,"spans":[{"id":"spn-55907","text":"4. Check Permissions"}]},{"id":"blk-48558","kind":"paragraph","spans":[{"id":"spn-55908","text":"Verify what the agent can and cannot do:"}]},{"id":"blk-48559","kind":"code","language":"elixir","text":"OpenSentience.permission_check(\"my-worker\", :filesystem, :read, \"/data/input.csv\")\n# => {:allow, \"explicit grant: /data/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :filesystem, :write, \"/etc/passwd\")\n# => {:deny, \"explicit denial: /etc/**\"}\n\nOpenSentience.permission_check(\"my-worker\", :network, :inbound, \"0.0.0.0:8080\")\n# => {:deny, \"default deny: no matching grant\"}"},{"id":"blk-48560","kind":"paragraph","spans":[{"id":"spn-55909","text":"---"}]},{"id":"blk-48561","kind":"heading","level":2,"spans":[{"id":"spn-55910","text":"5. Enable and Run the Agent"}]},{"id":"blk-48562","kind":"code","language":"elixir","text":"# Transition from installed to enabled\nOpenSentience.enable_agent(\"my-worker\")\n\n# The agent starts under the AgentSupervisor.\n# Default autonomy level is :observe — the agent can see but not act."},{"id":"blk-48563","kind":"paragraph","spans":[{"id":"spn-55911","text":"---"}]},{"id":"blk-48564","kind":"heading","level":2,"spans":[{"id":"spn-55912","text":"6. Change Autonomy Level"}]},{"id":"blk-48565","kind":"paragraph","spans":[{"id":"spn-55913","text":"Progress the agent through graduated autonomy:"}]},{"id":"blk-48566","kind":"code","language":"elixir","text":"# Check current level\nOpenSentience.autonomy_level(\"my-worker\")\n# => :observe\n\n# Promote to advise (agent queues actions for approval)\nOpenSentience.set_autonomy_level(\"my-worker\", :advise)\n\n# After building trust, promote to act (autonomous within permissions)\nOpenSentience.set_autonomy_level(\"my-worker\", :act)"},{"id":"blk-48567","kind":"paragraph","spans":[{"id":"spn-55914","text":"Each change is recorded in the audit trail."}]},{"id":"blk-48568","kind":"paragraph","spans":[{"id":"spn-55915","text":"---"}]},{"id":"blk-48569","kind":"heading","level":2,"spans":[{"id":"spn-55916","text":"7. Query the Audit Trail"}]},{"id":"blk-48570","kind":"code","language":"elixir","text":"OpenSentience.audit(\"my-worker\", type: :lifecycle_transition, limit: 10)\n# => [\n#   %{id: \"...\", timestamp: ~U[...], event_type: :lifecycle_transition,\n#     operation: \"installed -> enabled\", result: :ok, actor: \"system\", ...},\n#   %{id: \"...\", timestamp: ~U[...], event_type: :autonomy_change,\n#     operation: \"observe -> advise\", result: :ok, actor: \"operator\", ...},\n#   ...\n# ]"},{"id":"blk-48571","kind":"paragraph","spans":[{"id":"spn-55917","text":"The audit trail is append-only. Entries cannot be modified or deleted."}]},{"id":"blk-48572","kind":"paragraph","spans":[{"id":"spn-55918","text":"---"}]},{"id":"blk-48573","kind":"heading","level":2,"spans":[{"id":"spn-55919","text":"8. Lifecycle Transitions"}]},{"id":"blk-48574","kind":"paragraph","spans":[{"id":"spn-55920","text":"Move agents through the full lifecycle as needed:"}]},{"id":"blk-48575","kind":"code","language":"elixir","text":"# Graceful stop (running -> enabled -> disabled)\nOpenSentience.disable_agent(\"my-worker\")\n\n# Re-enable later\nOpenSentience.enable_agent(\"my-worker\")\n\n# Permanent removal (must be disabled first)\nOpenSentience.remove_agent(\"my-worker\")"},{"id":"blk-48576","kind":"paragraph","spans":[{"id":"spn-55921","text":"---"}]},{"id":"blk-48577","kind":"heading","level":2,"spans":[{"id":"spn-55922","text":"What Happens Next"}]},{"id":"blk-48578","items":[{"blocks":[{"id":"blk-48580","kind":"paragraph","spans":[{"id":"spn-55923","text":"Read "},{"id":"spn-55924","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/architecture.md"}],"text":"architecture.md"},{"id":"spn-55925","text":" to understand the OTP internals"}]}],"id":"blk-48579","kind":"list-item"},{"blocks":[{"id":"blk-48582","kind":"paragraph","spans":[{"id":"spn-55926","text":"Read "},{"id":"spn-55927","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/03_PERMISSIONS.md"}],"text":"skills/03_PERMISSIONS.md"},{"id":"spn-55928","text":" for the full permission model"}]}],"id":"blk-48581","kind":"list-item"},{"blocks":[{"id":"blk-48584","kind":"paragraph","spans":[{"id":"spn-55929","text":"Read "},{"id":"spn-55930","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/04_AUTONOMY_LEVELS.md"}],"text":"skills/04_AUTONOMY_LEVELS.md"},{"id":"spn-55931","text":" for autonomy details"}]}],"id":"blk-48583","kind":"list-item"},{"blocks":[{"id":"blk-48586","kind":"paragraph","spans":[{"id":"spn-55932","text":"Read "},{"id":"spn-55933","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/skills/06_INTEGRATION.md"}],"text":"skills/06_INTEGRATION.md"},{"id":"spn-55934","text":" to connect with Graphonomous,"}]}],"id":"blk-48585","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48587","kind":"paragraph","spans":[{"id":"spn-55935","text":"Delegatic, and the rest of the [&] ecosystem"}]},{"id":"blk-48588","kind":"paragraph","spans":[{"id":"spn-55936","text":"---"}]},{"id":"blk-48589","kind":"heading","level":2,"spans":[{"id":"spn-55937","text":"MCP Tool Equivalents"}]},{"id":"blk-48590","kind":"paragraph","spans":[{"id":"spn-55938","text":"Every operation above is also available as an MCP tool for LLM agents:"}]},{"head":[{"id":"blk-48592","spans":[{"id":"spn-55939","text":"Elixir API"}]},{"id":"blk-48593","spans":[{"id":"spn-55940","text":"MCP Tool"}]},{"id":"blk-48594","spans":[{"id":"spn-55941","text":"Purpose"}]}],"id":"blk-48591","kind":"table","rows":[[{"id":"blk-48595","spans":[{"id":"spn-55942","marks":["code"],"text":"install_agent/1"}]},{"id":"blk-48596","spans":[{"id":"spn-55943","marks":["code"],"text":"agent_install"}]},{"id":"blk-48597","spans":[{"id":"spn-55944","text":"Register agent with permissions"}]}],[{"id":"blk-48598","spans":[{"id":"spn-55945","marks":["code"],"text":"enable_agent/1"}]},{"id":"blk-48599","spans":[{"id":"spn-55946","marks":["code"],"text":"agent_enable"}]},{"id":"blk-48600","spans":[{"id":"spn-55947","text":"Start the governed process"}]}],[{"id":"blk-48601","spans":[{"id":"spn-55948","marks":["code"],"text":"disable_agent/1"}]},{"id":"blk-48602","spans":[{"id":"spn-55949","marks":["code"],"text":"agent_disable"}]},{"id":"blk-48603","spans":[{"id":"spn-55950","text":"Graceful stop"}]}],[{"id":"blk-48604","spans":[{"id":"spn-55951","marks":["code"],"text":"agent_status/1"}]},{"id":"blk-48605","spans":[{"id":"spn-55952","marks":["code"],"text":"agent_status"}]},{"id":"blk-48606","spans":[{"id":"spn-55953","text":"Current state and metadata"}]}],[{"id":"blk-48607","spans":[{"id":"spn-55954","marks":["code"],"text":"audit/2"}]},{"id":"blk-48608","spans":[{"id":"spn-55955","marks":["code"],"text":"agent_audit"}]},{"id":"blk-48609","spans":[{"id":"spn-55956","text":"Query audit trail"}]}],[{"id":"blk-48610","spans":[{"id":"spn-55957","marks":["code"],"text":"permission_check/4"}]},{"id":"blk-48611","spans":[{"id":"spn-55958","marks":["code"],"text":"permission_check"}]},{"id":"blk-48612","spans":[{"id":"spn-55959","text":"Evaluate a permission"}]}],[{"id":"blk-48613","spans":[{"id":"spn-55960","marks":["code"],"text":"set_autonomy_level/2"}]},{"id":"blk-48614","spans":[{"id":"spn-55961","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-48615","spans":[{"id":"spn-55962","text":"Get or set autonomy"}]}]]}],"edges":[],"id":"bagaaierany3dkirvdqjyczyjhn4xukfqfzfmi3wgitbbrs6h4ryw3cqurrxq","vocabulary":"ampersand.docs.fs.v1"}