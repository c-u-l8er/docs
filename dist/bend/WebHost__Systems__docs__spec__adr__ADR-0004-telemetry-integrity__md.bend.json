{"bendscript":"0.1","blocks":[{"id":"blk-51957","kind":"heading","level":1,"spans":[{"id":"spn-80373","text":"ADR-0004: Telemetry Integrity & Attribution Model (Deployment-Scoped Signed Events)"}]},{"id":"blk-51958","kind":"paragraph","spans":[{"id":"spn-80374","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-51959","items":[{"blocks":[{"id":"blk-51961","kind":"paragraph","spans":[{"id":"spn-80375","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-51960","kind":"list-item"},{"blocks":[{"id":"blk-51963","kind":"paragraph","spans":[{"id":"spn-80376","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-51962","kind":"list-item"},{"blocks":[{"id":"blk-51965","kind":"paragraph","spans":[{"id":"spn-80377","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-51964","kind":"list-item"},{"blocks":[{"id":"blk-51967","kind":"paragraph","spans":[{"id":"spn-80378","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-51966","kind":"list-item"},{"blocks":[{"id":"blk-51969","kind":"paragraph","spans":[{"id":"spn-80379","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-51968","kind":"list-item"},{"blocks":[{"id":"blk-51971","kind":"paragraph","spans":[{"id":"spn-80380","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-51970","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51972","kind":"heading","level":2,"spans":[{"id":"spn-80381","text":"Context"}]},{"id":"blk-51973","kind":"paragraph","spans":[{"id":"spn-80382","text":"webhost.systems is a multi-runtime AI agent platform. For each invocation executed in the data plane (Cloudflare Workers/DO or AWS Bedrock AgentCore), the platform must record usage and operational telemetry for:"}]},{"id":"blk-51974","items":[{"blocks":[{"id":"blk-51976","kind":"paragraph","spans":[{"id":"spn-80383","text":"plan enforcement (requests/tokens/compute limits),"}]}],"id":"blk-51975","kind":"list-item"},{"blocks":[{"id":"blk-51978","kind":"paragraph","spans":[{"id":"spn-80384","text":"cost estimation (v1: estimated cost),"}]}],"id":"blk-51977","kind":"list-item"},{"blocks":[{"id":"blk-51980","kind":"paragraph","spans":[{"id":"spn-80385","text":"billing integrity (tier gating and upgrade flows),"}]}],"id":"blk-51979","kind":"list-item"},{"blocks":[{"id":"blk-51982","kind":"paragraph","spans":[{"id":"spn-80386","text":"observability (error rates, latency/compute, tool usage),"}]}],"id":"blk-51981","kind":"list-item"},{"blocks":[{"id":"blk-51984","kind":"paragraph","spans":[{"id":"spn-80387","text":"audits and support (traceability via "},{"id":"spn-80388","marks":["code"],"text":"traceId"},{"id":"spn-80389","text":", deploy version, runtime)."}]}],"id":"blk-51983","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51985","kind":"paragraph","spans":[{"id":"spn-80390","text":"Telemetry is consumed by the control plane and stored as append-only raw events ("},{"id":"spn-80391","marks":["code"],"text":"metricsEvents"},{"id":"spn-80392","text":") and aggregated views ("},{"id":"spn-80393","marks":["code"],"text":"billingUsage"},{"id":"spn-80394","text":")."}]},{"id":"blk-51986","kind":"heading","level":3,"spans":[{"id":"spn-80395","text":"Problem statement"}]},{"id":"blk-51987","kind":"paragraph","spans":[{"id":"spn-80396","text":"Telemetry is a critical security and business integrity surface. If telemetry is spoofable or not attributable, an attacker (or buggy runtime) could:"}]},{"id":"blk-51988","items":[{"blocks":[{"id":"blk-51990","kind":"paragraph","spans":[{"id":"spn-80397","text":"underreport usage to avoid limits or billing,"}]}],"id":"blk-51989","kind":"list-item"},{"blocks":[{"id":"blk-51992","kind":"paragraph","spans":[{"id":"spn-80398","text":"overreport usage to sabotage another tenant,"}]}],"id":"blk-51991","kind":"list-item"},{"blocks":[{"id":"blk-51994","kind":"paragraph","spans":[{"id":"spn-80399","text":"inject events for another tenant’s agents/deployments,"}]}],"id":"blk-51993","kind":"list-item"},{"blocks":[{"id":"blk-51996","kind":"paragraph","spans":[{"id":"spn-80400","text":"create ambiguity in chargeback attribution across runtimes,"}]}],"id":"blk-51995","kind":"list-item"},{"blocks":[{"id":"blk-51998","kind":"paragraph","spans":[{"id":"spn-80401","text":"break observability and incident response."}]}],"id":"blk-51997","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51999","kind":"paragraph","spans":[{"id":"spn-80402","text":"Therefore telemetry ingestion must ensure:"}]},{"id":"blk-52000","items":[{"blocks":[{"id":"blk-52002","kind":"paragraph","spans":[{"id":"spn-80403","marks":["bold"],"text":"Integrity"},{"id":"spn-80404","text":": payload not tampered in transit."}]}],"id":"blk-52001","kind":"list-item"},{"blocks":[{"id":"blk-52004","kind":"paragraph","spans":[{"id":"spn-80405","marks":["bold"],"text":"Authenticity"},{"id":"spn-80406","text":": sender is an authorized runtime deployment."}]}],"id":"blk-52003","kind":"list-item"},{"blocks":[{"id":"blk-52006","kind":"paragraph","spans":[{"id":"spn-80407","marks":["bold"],"text":"Attribution"},{"id":"spn-80408","text":": event belongs to exactly one "},{"id":"spn-80409","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-80410","text":"."}]}],"id":"blk-52005","kind":"list-item"},{"blocks":[{"id":"blk-52008","kind":"paragraph","spans":[{"id":"spn-80411","marks":["bold"],"text":"Replay safety"},{"id":"spn-80412","text":": retries do not double count; attackers cannot re-submit old events to alter usage."}]}],"id":"blk-52007","kind":"list-item"},{"blocks":[{"id":"blk-52010","kind":"paragraph","spans":[{"id":"spn-80413","marks":["bold"],"text":"No secrets leakage"},{"id":"spn-80414","text":": telemetry must never include secret values, and telemetry auth secrets must not be stored as plaintext."}]}],"id":"blk-52009","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-52011","kind":"paragraph","spans":[{"id":"spn-80415","text":"Constraints:"}]},{"id":"blk-52012","items":[{"blocks":[{"id":"blk-52014","kind":"paragraph","spans":[{"id":"spn-80416","text":"Data plane runtimes are heterogeneous and may differ in what usage details they can report."}]}],"id":"blk-52013","kind":"list-item"},{"blocks":[{"id":"blk-52016","kind":"paragraph","spans":[{"id":"spn-80417","text":"Customer agent code is untrusted; it may attempt to forge telemetry or call arbitrary endpoints."}]}],"id":"blk-52015","kind":"list-item"},{"blocks":[{"id":"blk-52018","kind":"paragraph","spans":[{"id":"spn-80418","text":"Telemetry ingestion must not rely on browser sessions/cookies."}]}],"id":"blk-52017","kind":"list-item"},{"blocks":[{"id":"blk-52020","kind":"paragraph","spans":[{"id":"spn-80419","text":"The system must remain implementable for v1 without introducing a full centralized vault or complex PKI."}]}],"id":"blk-52019","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52021","kind":"heading","level":2,"spans":[{"id":"spn-80420","text":"Decision"}]},{"id":"blk-52022","kind":"paragraph","spans":[{"id":"spn-80421","text":"Adopt a "},{"id":"spn-80422","marks":["bold"],"text":"deployment-scoped signed telemetry event"},{"id":"spn-80423","text":" model with "},{"id":"spn-80424","marks":["bold"],"text":"ownership cross-checking"},{"id":"spn-80425","text":" at ingestion."}]},{"id":"blk-52023","kind":"heading","level":3,"spans":[{"id":"spn-80426","text":"Decision summary (normative)"}]},{"id":"blk-52024","items":[{"blocks":[{"id":"blk-52026","kind":"paragraph","spans":[{"id":"spn-80427","marks":["bold"],"text":"Attribution is mandatory"}]}],"id":"blk-52025","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-52027","kind":"paragraph","spans":[{"id":"spn-80428","text":"Every telemetry event MUST be attributable to:"}]},{"id":"blk-52028","items":[{"blocks":[{"id":"blk-52030","kind":"paragraph","spans":[{"id":"spn-80429","marks":["code"],"text":"userId"}]}],"id":"blk-52029","kind":"list-item"},{"blocks":[{"id":"blk-52032","kind":"paragraph","spans":[{"id":"spn-80430","marks":["code"],"text":"agentId"}]}],"id":"blk-52031","kind":"list-item"},{"blocks":[{"id":"blk-52034","kind":"paragraph","spans":[{"id":"spn-80431","marks":["code"],"text":"deploymentId"}]}],"id":"blk-52033","kind":"list-item"},{"blocks":[{"id":"blk-52036","kind":"paragraph","spans":[{"id":"spn-80432","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-52035","kind":"list-item"},{"blocks":[{"id":"blk-52038","kind":"paragraph","spans":[{"id":"spn-80433","marks":["code"],"text":"timestamp"}]}],"id":"blk-52037","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52039","items":[{"blocks":[{"id":"blk-52041","kind":"paragraph","spans":[{"id":"spn-80434","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped HMAC signatures (v1)"}]}],"id":"blk-52040","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-52042","items":[{"blocks":[{"id":"blk-52044","kind":"paragraph","spans":[{"id":"spn-80435","text":"Each deployment has a unique "},{"id":"spn-80436","marks":["code"],"text":"telemetrySecret"},{"id":"spn-80437","text":" (HMAC key), generated by the control plane."}]}],"id":"blk-52043","kind":"list-item"},{"blocks":[{"id":"blk-52046","kind":"paragraph","spans":[{"id":"spn-80438","text":"The "},{"id":"spn-80439","marks":["code"],"text":"telemetrySecret"},{"id":"spn-80440","text":" is injected into the deployed runtime using provider secret mechanisms."}]}],"id":"blk-52045","kind":"list-item"},{"blocks":[{"id":"blk-52048","kind":"paragraph","spans":[{"id":"spn-80441","text":"Data plane submits telemetry to the control plane ingestion endpoint with:"}]}],"id":"blk-52047","kind":"list-item"},{"blocks":[{"id":"blk-52050","kind":"paragraph","spans":[{"id":"spn-80442","text":"header "},{"id":"spn-80443","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-52049","kind":"list-item"},{"blocks":[{"id":"blk-52052","kind":"paragraph","spans":[{"id":"spn-80444","text":"header "},{"id":"spn-80445","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex(hmac_sha256(raw_body_bytes, telemetrySecret))>"}]}],"id":"blk-52051","kind":"list-item"},{"blocks":[{"id":"blk-52054","kind":"paragraph","spans":[{"id":"spn-80446","text":"Control plane verifies:"}]}],"id":"blk-52053","kind":"list-item"},{"blocks":[{"id":"blk-52056","kind":"paragraph","spans":[{"id":"spn-80447","text":"signature validity (using deployment-scoped secret reference),"}]}],"id":"blk-52055","kind":"list-item"},{"blocks":[{"id":"blk-52058","kind":"paragraph","spans":[{"id":"spn-80448","text":"ownership mapping: deployment belongs to the agent and user in the payload,"}]}],"id":"blk-52057","kind":"list-item"},{"blocks":[{"id":"blk-52060","kind":"paragraph","spans":[{"id":"spn-80449","text":"required fields and enums."}]}],"id":"blk-52059","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52061","items":[{"blocks":[{"id":"blk-52063","kind":"paragraph","spans":[{"id":"spn-80450","marks":["bold"],"text":"Ingestion performs ownership cross-check (defense in depth)"}]}],"id":"blk-52062","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-52064","kind":"paragraph","spans":[{"id":"spn-80451","text":"After signature validation, ingestion MUST query control plane data and verify:"}]},{"id":"blk-52065","items":[{"blocks":[{"id":"blk-52067","kind":"paragraph","spans":[{"id":"spn-80452","marks":["code"],"text":"deployments._id == deploymentId"}]}],"id":"blk-52066","kind":"list-item"},{"blocks":[{"id":"blk-52069","kind":"paragraph","spans":[{"id":"spn-80453","marks":["code"],"text":"deployments.agentId == agentId"}]}],"id":"blk-52068","kind":"list-item"},{"blocks":[{"id":"blk-52071","kind":"paragraph","spans":[{"id":"spn-80454","marks":["code"],"text":"deployments.userId == userId"}]}],"id":"blk-52070","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52072","kind":"paragraph","spans":[{"id":"spn-80455","text":"If any mismatch: reject the event, optionally record an "},{"id":"spn-80456","marks":["code"],"text":"auditLog"},{"id":"spn-80457","text":" entry with sanitized details."}]},{"id":"blk-52073","items":[{"blocks":[{"id":"blk-52075","kind":"paragraph","spans":[{"id":"spn-80458","marks":["bold"],"text":"Telemetry does not use user auth"}]}],"id":"blk-52074","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-52076","kind":"paragraph","spans":[{"id":"spn-80459","text":"Telemetry ingestion MUST NOT accept browser session cookies as authentication. Telemetry is authenticated solely by deployment-scoped signature (and optional anti-replay)."}]},{"id":"blk-52077","items":[{"blocks":[{"id":"blk-52079","kind":"paragraph","spans":[{"id":"spn-80460","marks":["bold"],"text":"Replay/dedupe (recommended in v1; mandatory before public invocations)"}]}],"id":"blk-52078","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-52080","kind":"paragraph","spans":[{"id":"spn-80461","text":"Telemetry ingestion SHOULD implement one of:"}]},{"id":"blk-52081","items":[{"blocks":[{"id":"blk-52083","kind":"paragraph","spans":[{"id":"spn-80462","marks":["code"],"text":"eventId"},{"id":"spn-80463","text":" (UUID generated by data plane) + short-window dedupe store, OR"}]}],"id":"blk-52082","kind":"list-item"},{"blocks":[{"id":"blk-52085","kind":"paragraph","spans":[{"id":"spn-80464","text":"dedupe on "},{"id":"spn-80465","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-80466","text":" if "},{"id":"spn-80467","marks":["code"],"text":"traceId"},{"id":"spn-80468","text":" uniqueness per invocation is guaranteed."}]}],"id":"blk-52084","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52086","kind":"paragraph","spans":[{"id":"spn-80469","text":"In either case, ingestion must be idempotent under retries to prevent double counting."}]},{"id":"blk-52087","items":[{"blocks":[{"id":"blk-52089","kind":"paragraph","spans":[{"id":"spn-80470","marks":["bold"],"text":"Secrets are never stored as plaintext in the primary DB"}]}],"id":"blk-52088","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-52090","items":[{"blocks":[{"id":"blk-52092","kind":"paragraph","spans":[{"id":"spn-80471","text":"The primary DB stores only metadata and secret references (e.g., provider secret name/id)."}]}],"id":"blk-52091","kind":"list-item"},{"blocks":[{"id":"blk-52094","kind":"paragraph","spans":[{"id":"spn-80472","text":"The "},{"id":"spn-80473","marks":["code"],"text":"telemetrySecret"},{"id":"spn-80474","text":" value MUST NOT be stored in plaintext in the primary database (Supabase)."}]}],"id":"blk-52093","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52095","kind":"heading","level":3,"spans":[{"id":"spn-80475","text":"Provider-specific telemetry capabilities (implementation guidance)"}]},{"id":"blk-52096","kind":"paragraph","spans":[{"id":"spn-80476","text":"This ADR standardizes telemetry ingestion on "},{"id":"spn-80477","marks":["bold"],"text":"deployment-scoped signed events"},{"id":"spn-80478","text":" for all runtimes. Provider capabilities vary, but the v1 baseline remains consistent."}]},{"id":"blk-52097","kind":"paragraph","spans":[{"id":"spn-80479","marks":["bold"],"text":"Cloudflare (Workers + Durable Objects):"}]},{"id":"blk-52098","items":[{"blocks":[{"id":"blk-52100","kind":"paragraph","spans":[{"id":"spn-80480","text":"The runtime MUST explicitly emit telemetry to the control plane (Pattern A: in-workload emission is the preferred approach)."}]}],"id":"blk-52099","kind":"list-item"},{"blocks":[{"id":"blk-52102","kind":"paragraph","spans":[{"id":"spn-80481","text":"The telemetry signing secret is injected via Worker secret bindings."}]}],"id":"blk-52101","kind":"list-item"},{"blocks":[{"id":"blk-52104","kind":"paragraph","spans":[{"id":"spn-80482","text":"The Worker/DO submits "},{"id":"spn-80483","marks":["code"],"text":"POST /v1/telemetry/report"},{"id":"spn-80484","text":" with "},{"id":"spn-80485","marks":["code"],"text":"X-Telemetry-Deployment-Id"},{"id":"spn-80486","text":" and "},{"id":"spn-80487","marks":["code"],"text":"X-Telemetry-Signature"},{"id":"spn-80488","text":"."}]}],"id":"blk-52103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52105","kind":"paragraph","spans":[{"id":"spn-80489","marks":["bold"],"text":"AgentCore (AWS Bedrock AgentCore):"}]},{"id":"blk-52106","items":[{"blocks":[{"id":"blk-52108","kind":"paragraph","spans":[{"id":"spn-80490","text":"AgentCore may provide provider-native observability capabilities (e.g., service-level telemetry/OTel-style integrations) that can be valuable for deep debugging."}]}],"id":"blk-52107","kind":"list-item"},{"blocks":[{"id":"blk-52110","kind":"paragraph","spans":[{"id":"spn-80491","marks":["bold"],"text":"v1 baseline:"},{"id":"spn-80492","text":" use the same direct signed submission model as Cloudflare (either in-workload emission when feasible, or adapter-side emission when required by provider constraints) to keep metering, limits, and billing semantics consistent across runtimes."}]}],"id":"blk-52109","kind":"list-item"},{"blocks":[{"id":"blk-52112","kind":"paragraph","spans":[{"id":"spn-80493","marks":["bold"],"text":"post-v1 enhancement:"},{"id":"spn-80494","text":" integrate provider-native observability for richer traces while still emitting the normalized, signed metering event used for billing and limits."}]}],"id":"blk-52111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52113","kind":"heading","level":2,"spans":[{"id":"spn-80495","text":"Rationale"}]},{"id":"blk-52114","kind":"paragraph","spans":[{"id":"spn-80496","text":"This approach satisfies the requirements with minimal complexity:"}]},{"id":"blk-52115","items":[{"blocks":[{"id":"blk-52117","kind":"paragraph","spans":[{"id":"spn-80497","marks":["bold"],"text":"Integrity and authenticity"},{"id":"spn-80498","text":": HMAC signatures prevent tampering and authenticate possession of a deployment-scoped secret."}]}],"id":"blk-52116","kind":"list-item"},{"blocks":[{"id":"blk-52119","kind":"paragraph","spans":[{"id":"spn-80499","marks":["bold"],"text":"Tenant protection"},{"id":"spn-80500","text":": ownership cross-check prevents a compromised deployment secret from being used to write events for a different agent or user."}]}],"id":"blk-52118","kind":"list-item"},{"blocks":[{"id":"blk-52121","kind":"paragraph","spans":[{"id":"spn-80501","marks":["bold"],"text":"Least privilege"},{"id":"spn-80502","text":": deployment-scoped secret limits blast radius if compromised."}]}],"id":"blk-52120","kind":"list-item"},{"blocks":[{"id":"blk-52123","kind":"paragraph","spans":[{"id":"spn-80503","marks":["bold"],"text":"Provider portability"},{"id":"spn-80504","text":": works across runtimes because it relies on a generic “can send HTTP + store secret” capability."}]}],"id":"blk-52122","kind":"list-item"},{"blocks":[{"id":"blk-52125","kind":"paragraph","spans":[{"id":"spn-80505","marks":["bold"],"text":"Operable MVP"},{"id":"spn-80506","text":": avoids the need for PKI or an always-online centralized vault, while still enabling strong guarantees."}]}],"id":"blk-52124","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52126","kind":"heading","level":2,"spans":[{"id":"spn-80507","text":"Alternatives considered"}]},{"id":"blk-52127","kind":"heading","level":3,"spans":[{"id":"spn-80508","text":"A) Trust telemetry without signatures (reject)"}]},{"id":"blk-52128","kind":"paragraph","spans":[{"id":"spn-80509","marks":["bold"],"text":"Pros"}]},{"id":"blk-52129","items":[{"blocks":[{"id":"blk-52131","kind":"paragraph","spans":[{"id":"spn-80510","text":"Easiest to implement."}]}],"id":"blk-52130","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52132","kind":"paragraph","spans":[{"id":"spn-80511","marks":["bold"],"text":"Cons"}]},{"id":"blk-52133","items":[{"blocks":[{"id":"blk-52135","kind":"paragraph","spans":[{"id":"spn-80512","text":"Enables trivial spoofing and billing manipulation."}]}],"id":"blk-52134","kind":"list-item"},{"blocks":[{"id":"blk-52137","kind":"paragraph","spans":[{"id":"spn-80513","text":"Allows cross-tenant sabotage and incorrect usage enforcement."}]}],"id":"blk-52136","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52138","kind":"paragraph","spans":[{"id":"spn-80514","marks":["bold"],"text":"Decision"},{"id":"spn-80515","text":" Rejected. Not acceptable for any paid system with limits and billing."}]},{"id":"blk-52139","kind":"heading","level":3,"spans":[{"id":"spn-80516","text":"B) Adapter-side telemetry only (partial alternative)"}]},{"id":"blk-52140","kind":"paragraph","spans":[{"id":"spn-80517","text":"Telemetry is emitted only by the control plane adapter after it receives provider responses."}]},{"id":"blk-52141","kind":"paragraph","spans":[{"id":"spn-80518","marks":["bold"],"text":"Pros"}]},{"id":"blk-52142","items":[{"blocks":[{"id":"blk-52144","kind":"paragraph","spans":[{"id":"spn-80519","text":"Avoids injecting telemetry secrets into runtime code."}]}],"id":"blk-52143","kind":"list-item"},{"blocks":[{"id":"blk-52146","kind":"paragraph","spans":[{"id":"spn-80520","text":"Avoids runtime outbound call to control plane."}]}],"id":"blk-52145","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52147","kind":"paragraph","spans":[{"id":"spn-80521","marks":["bold"],"text":"Cons"}]},{"id":"blk-52148","items":[{"blocks":[{"id":"blk-52150","kind":"paragraph","spans":[{"id":"spn-80522","text":"Often cannot capture provider-specific usage (compute/tool usage) reliably."}]}],"id":"blk-52149","kind":"list-item"},{"blocks":[{"id":"blk-52152","kind":"paragraph","spans":[{"id":"spn-80523","text":"Creates attribution gaps if invocations happen outside the adapter path or if provider returns incomplete usage."}]}],"id":"blk-52151","kind":"list-item"},{"blocks":[{"id":"blk-52154","kind":"paragraph","spans":[{"id":"spn-80524","text":"Weakens correlation with runtime events and can undercount."}]}],"id":"blk-52153","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52155","kind":"paragraph","spans":[{"id":"spn-80525","marks":["bold"],"text":"Decision"},{"id":"spn-80526","text":" Not the primary model. Allowed as a constrained fallback if a provider cannot support in-workload emission, but must preserve integrity and attribution. If adapter emits, it must still attach to a deployment and enforce ownership; it must not be forgeable by clients."}]},{"id":"blk-52156","kind":"heading","level":3,"spans":[{"id":"spn-80527","text":"C) Per-user telemetry keys (reject)"}]},{"id":"blk-52157","kind":"paragraph","spans":[{"id":"spn-80528","text":"Use one key per user shared across all deployments."}]},{"id":"blk-52158","kind":"paragraph","spans":[{"id":"spn-80529","marks":["bold"],"text":"Pros"}]},{"id":"blk-52159","items":[{"blocks":[{"id":"blk-52161","kind":"paragraph","spans":[{"id":"spn-80530","text":"Fewer secrets."}]}],"id":"blk-52160","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52162","kind":"paragraph","spans":[{"id":"spn-80531","marks":["bold"],"text":"Cons"}]},{"id":"blk-52163","items":[{"blocks":[{"id":"blk-52165","kind":"paragraph","spans":[{"id":"spn-80532","text":"Massive blast radius if compromised; compromised deployment can spoof across all user deployments."}]}],"id":"blk-52164","kind":"list-item"},{"blocks":[{"id":"blk-52167","kind":"paragraph","spans":[{"id":"spn-80533","text":"Harder to rotate safely and isolate issues."}]}],"id":"blk-52166","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52168","kind":"paragraph","spans":[{"id":"spn-80534","marks":["bold"],"text":"Decision"},{"id":"spn-80535","text":" Rejected. Deployment-scoped keys are safer and align with immutability and auditability."}]},{"id":"blk-52169","kind":"heading","level":3,"spans":[{"id":"spn-80536","text":"D) Public-key signatures (PKI) per deployment (defer)"}]},{"id":"blk-52170","kind":"paragraph","spans":[{"id":"spn-80537","text":"Each deployment gets a keypair; telemetry signed with private key, verified with public key."}]},{"id":"blk-52171","kind":"paragraph","spans":[{"id":"spn-80538","marks":["bold"],"text":"Pros"}]},{"id":"blk-52172","items":[{"blocks":[{"id":"blk-52174","kind":"paragraph","spans":[{"id":"spn-80539","text":"No shared secret at ingestion; avoids secret distribution to verifier."}]}],"id":"blk-52173","kind":"list-item"},{"blocks":[{"id":"blk-52176","kind":"paragraph","spans":[{"id":"spn-80540","text":"Strong cryptographic model."}]}],"id":"blk-52175","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52177","kind":"paragraph","spans":[{"id":"spn-80541","marks":["bold"],"text":"Cons"}]},{"id":"blk-52178","items":[{"blocks":[{"id":"blk-52180","kind":"paragraph","spans":[{"id":"spn-80542","text":"Adds key management complexity; still needs secure private key injection to runtime."}]}],"id":"blk-52179","kind":"list-item"},{"blocks":[{"id":"blk-52182","kind":"paragraph","spans":[{"id":"spn-80543","text":"Higher implementation overhead for v1 without clear ROI."}]}],"id":"blk-52181","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52183","kind":"paragraph","spans":[{"id":"spn-80544","marks":["bold"],"text":"Decision"},{"id":"spn-80545","text":" Deferred. Consider post-v1 if you need stronger non-repudiation or third-party verification."}]},{"id":"blk-52184","kind":"heading","level":3,"spans":[{"id":"spn-80546","text":"E) mTLS between data plane and control plane (defer)"}]},{"id":"blk-52185","kind":"paragraph","spans":[{"id":"spn-80547","text":"Use mutual TLS with client certs per deployment."}]},{"id":"blk-52186","kind":"paragraph","spans":[{"id":"spn-80548","marks":["bold"],"text":"Pros"}]},{"id":"blk-52187","items":[{"blocks":[{"id":"blk-52189","kind":"paragraph","spans":[{"id":"spn-80549","text":"Strong channel-level authentication."}]}],"id":"blk-52188","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52190","kind":"paragraph","spans":[{"id":"spn-80550","marks":["bold"],"text":"Cons"}]},{"id":"blk-52191","items":[{"blocks":[{"id":"blk-52193","kind":"paragraph","spans":[{"id":"spn-80551","text":"Operationally heavy; certificate issuance/rotation complexity."}]}],"id":"blk-52192","kind":"list-item"},{"blocks":[{"id":"blk-52195","kind":"paragraph","spans":[{"id":"spn-80552","text":"Hard to implement uniformly across runtimes."}]}],"id":"blk-52194","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52196","kind":"paragraph","spans":[{"id":"spn-80553","marks":["bold"],"text":"Decision"},{"id":"spn-80554","text":" Deferred. Potential future hardening for enterprise tiers."}]},{"id":"blk-52197","kind":"heading","level":2,"spans":[{"id":"spn-80555","text":"Detailed design (normative)"}]},{"id":"blk-52198","kind":"heading","level":3,"spans":[{"id":"spn-80556","text":"1) Telemetry event schema (minimum viable)"}]},{"id":"blk-52199","kind":"paragraph","spans":[{"id":"spn-80557","text":"Telemetry payload MUST include:"}]},{"id":"blk-52200","items":[{"blocks":[{"id":"blk-52202","kind":"paragraph","spans":[{"id":"spn-80558","marks":["code"],"text":"userId"},{"id":"spn-80559","text":" (internal id)"}]}],"id":"blk-52201","kind":"list-item"},{"blocks":[{"id":"blk-52204","kind":"paragraph","spans":[{"id":"spn-80560","marks":["code"],"text":"agentId"}]}],"id":"blk-52203","kind":"list-item"},{"blocks":[{"id":"blk-52206","kind":"paragraph","spans":[{"id":"spn-80561","marks":["code"],"text":"deploymentId"}]}],"id":"blk-52205","kind":"list-item"},{"blocks":[{"id":"blk-52208","kind":"paragraph","spans":[{"id":"spn-80562","marks":["code"],"text":"runtimeProvider"},{"id":"spn-80563","text":" ("},{"id":"spn-80564","marks":["code"],"text":"cloudflare"},{"id":"spn-80565","text":" | "},{"id":"spn-80566","marks":["code"],"text":"agentcore"},{"id":"spn-80567","text":")"}]}],"id":"blk-52207","kind":"list-item"},{"blocks":[{"id":"blk-52210","kind":"paragraph","spans":[{"id":"spn-80568","marks":["code"],"text":"timestamp"},{"id":"spn-80569","text":" (RFC3339 or unix ms; ingestion converts to unix ms)"}]}],"id":"blk-52209","kind":"list-item"},{"blocks":[{"id":"blk-52212","kind":"paragraph","spans":[{"id":"spn-80570","marks":["code"],"text":"requests"},{"id":"spn-80571","text":" (typically 1)"}]}],"id":"blk-52211","kind":"list-item"},{"blocks":[{"id":"blk-52214","kind":"paragraph","spans":[{"id":"spn-80572","marks":["code"],"text":"llmTokens"},{"id":"spn-80573","text":" (reported or estimated)"}]}],"id":"blk-52213","kind":"list-item"},{"blocks":[{"id":"blk-52216","kind":"paragraph","spans":[{"id":"spn-80574","marks":["code"],"text":"computeMs"},{"id":"spn-80575","text":" (wall time or billed time, defined per provider)"}]}],"id":"blk-52215","kind":"list-item"},{"blocks":[{"id":"blk-52218","kind":"paragraph","spans":[{"id":"spn-80576","marks":["code"],"text":"errors"},{"id":"spn-80577","text":" (0/1 typical)"}]}],"id":"blk-52217","kind":"list-item"},{"blocks":[{"id":"blk-52220","kind":"paragraph","spans":[{"id":"spn-80578","marks":["code"],"text":"errorClass"},{"id":"spn-80579","text":" (optional: "},{"id":"spn-80580","marks":["code"],"text":"auth | limit | runtime | tool | unknown"},{"id":"spn-80581","text":")"}]}],"id":"blk-52219","kind":"list-item"},{"blocks":[{"id":"blk-52222","kind":"paragraph","spans":[{"id":"spn-80582","marks":["code"],"text":"costUsdEstimated"}]}],"id":"blk-52221","kind":"list-item"},{"blocks":[{"id":"blk-52224","kind":"paragraph","spans":[{"id":"spn-80583","marks":["code"],"text":"traceId"},{"id":"spn-80584","text":" (optional but recommended)"}]}],"id":"blk-52223","kind":"list-item"},{"blocks":[{"id":"blk-52226","kind":"paragraph","spans":[{"id":"spn-80585","marks":["code"],"text":"provider"},{"id":"spn-80586","text":" (optional runtime-specific counters)"}]}],"id":"blk-52225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52227","kind":"paragraph","spans":[{"id":"spn-80587","text":"Telemetry MUST NOT include:"}]},{"id":"blk-52228","items":[{"blocks":[{"id":"blk-52230","kind":"paragraph","spans":[{"id":"spn-80588","text":"plaintext secrets,"}]}],"id":"blk-52229","kind":"list-item"},{"blocks":[{"id":"blk-52232","kind":"paragraph","spans":[{"id":"spn-80589","text":"full prompts/responses by default (unless an explicit opt-in feature is added later),"}]}],"id":"blk-52231","kind":"list-item"},{"blocks":[{"id":"blk-52234","kind":"paragraph","spans":[{"id":"spn-80590","text":"raw provider credential material."}]}],"id":"blk-52233","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52235","kind":"heading","level":3,"spans":[{"id":"spn-80591","text":"2) Signature computation"}]},{"id":"blk-52236","items":[{"blocks":[{"id":"blk-52238","kind":"paragraph","spans":[{"id":"spn-80592","text":"Signature is computed over the exact raw request body bytes as received/sent."}]}],"id":"blk-52237","kind":"list-item"},{"blocks":[{"id":"blk-52240","kind":"paragraph","spans":[{"id":"spn-80593","text":"Algorithm: "},{"id":"spn-80594","marks":["code"],"text":"HMAC_SHA256(telemetrySecret, raw_body_bytes)"},{"id":"spn-80595","text":"."}]}],"id":"blk-52239","kind":"list-item"},{"blocks":[{"id":"blk-52242","kind":"paragraph","spans":[{"id":"spn-80596","text":"Encoding: hex lowercase recommended."}]}],"id":"blk-52241","kind":"list-item"},{"blocks":[{"id":"blk-52244","kind":"paragraph","spans":[{"id":"spn-80597","text":"Header format: "},{"id":"spn-80598","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex>"},{"id":"spn-80599","text":"."}]}],"id":"blk-52243","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52245","kind":"paragraph","spans":[{"id":"spn-80600","text":"Canonicalization note:"}]},{"id":"blk-52246","items":[{"blocks":[{"id":"blk-52248","kind":"paragraph","spans":[{"id":"spn-80601","text":"The verifier MUST use the raw body bytes, not a re-serialized JSON object."}]}],"id":"blk-52247","kind":"list-item"},{"blocks":[{"id":"blk-52250","kind":"paragraph","spans":[{"id":"spn-80602","text":"If your framework modifies request bodies, capture raw bytes before parsing."}]}],"id":"blk-52249","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52251","kind":"heading","level":3,"spans":[{"id":"spn-80603","text":"3) Ingestion validation steps (MUST)"}]},{"id":"blk-52252","kind":"paragraph","spans":[{"id":"spn-80604","text":"In order:"}]},{"id":"blk-52253","items":[{"blocks":[{"id":"blk-52255","kind":"paragraph","spans":[{"id":"spn-80605","text":"Read "},{"id":"spn-80606","marks":["code"],"text":"deploymentId"},{"id":"spn-80607","text":" header and locate deployment record."}]}],"id":"blk-52254","kind":"list-item"},{"blocks":[{"id":"blk-52257","kind":"paragraph","spans":[{"id":"spn-80608","text":"Fetch deployment-scoped secret reference and verify signature."}]}],"id":"blk-52256","kind":"list-item"},{"blocks":[{"id":"blk-52259","kind":"paragraph","spans":[{"id":"spn-80609","text":"Parse JSON body and validate required fields and enums."}]}],"id":"blk-52258","kind":"list-item"},{"blocks":[{"id":"blk-52261","kind":"paragraph","spans":[{"id":"spn-80610","text":"Ownership cross-check:"}]}],"id":"blk-52260","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-52262","items":[{"blocks":[{"id":"blk-52264","kind":"paragraph","spans":[{"id":"spn-80611","marks":["code"],"text":"deployments.userId == body.userId"}]}],"id":"blk-52263","kind":"list-item"},{"blocks":[{"id":"blk-52266","kind":"paragraph","spans":[{"id":"spn-80612","marks":["code"],"text":"deployments.agentId == body.agentId"}]}],"id":"blk-52265","kind":"list-item"},{"blocks":[{"id":"blk-52268","kind":"paragraph","spans":[{"id":"spn-80613","marks":["code"],"text":"deployments._id == body.deploymentId"},{"id":"spn-80614","text":" (or match header)"}]}],"id":"blk-52267","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52269","items":[{"blocks":[{"id":"blk-52271","kind":"paragraph","spans":[{"id":"spn-80615","text":"Dedupe/idempotency:"}]}],"id":"blk-52270","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-52272","items":[{"blocks":[{"id":"blk-52274","kind":"paragraph","spans":[{"id":"spn-80616","text":"if "},{"id":"spn-80617","marks":["code"],"text":"eventId"},{"id":"spn-80618","text":" used: reject or no-op if already processed in dedupe window"}]}],"id":"blk-52273","kind":"list-item"},{"blocks":[{"id":"blk-52276","kind":"paragraph","spans":[{"id":"spn-80619","text":"if "},{"id":"spn-80620","marks":["code"],"text":"traceId"},{"id":"spn-80621","text":" used: ensure uniqueness per "},{"id":"spn-80622","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-80623","text":" in dedupe window"}]}],"id":"blk-52275","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52277","items":[{"blocks":[{"id":"blk-52279","kind":"paragraph","spans":[{"id":"spn-80624","text":"Persist event append-only."}]}],"id":"blk-52278","kind":"list-item"},{"blocks":[{"id":"blk-52281","kind":"paragraph","spans":[{"id":"spn-80625","text":"Optionally update incremental counters."}]}],"id":"blk-52280","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-52282","kind":"paragraph","spans":[{"id":"spn-80626","text":"If any step fails:"}]},{"id":"blk-52283","items":[{"blocks":[{"id":"blk-52285","kind":"paragraph","spans":[{"id":"spn-80627","text":"respond with normalized error (for non-telemetry callers, keep generic),"}]}],"id":"blk-52284","kind":"list-item"},{"blocks":[{"id":"blk-52287","kind":"paragraph","spans":[{"id":"spn-80628","text":"DO NOT reveal secret or internal details,"}]}],"id":"blk-52286","kind":"list-item"},{"blocks":[{"id":"blk-52289","kind":"paragraph","spans":[{"id":"spn-80629","text":"optionally write a sanitized "},{"id":"spn-80630","marks":["code"],"text":"auditLog"},{"id":"spn-80631","text":" entry for investigation."}]}],"id":"blk-52288","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52290","kind":"heading","level":3,"spans":[{"id":"spn-80632","text":"4) Secret generation and rotation"}]},{"id":"blk-52291","items":[{"blocks":[{"id":"blk-52293","kind":"paragraph","spans":[{"id":"spn-80633","text":"Generate a new telemetry secret on every new deployment by default."}]}],"id":"blk-52292","kind":"list-item"},{"blocks":[{"id":"blk-52295","kind":"paragraph","spans":[{"id":"spn-80634","text":"Inject the secret into the runtime provider as a secret (not as plain env var stored in DB)."}]}],"id":"blk-52294","kind":"list-item"},{"blocks":[{"id":"blk-52297","kind":"paragraph","spans":[{"id":"spn-80635","text":"Rotation policy:"}]}],"id":"blk-52296","kind":"list-item"},{"blocks":[{"id":"blk-52299","kind":"paragraph","spans":[{"id":"spn-80636","text":"New deployment => new telemetry secret (mandatory)."}]}],"id":"blk-52298","kind":"list-item"},{"blocks":[{"id":"blk-52301","kind":"paragraph","spans":[{"id":"spn-80637","text":"Old deployments retain old secret for the duration they might emit telemetry (but they should not emit after deactivation, except in-flight retries)."}]}],"id":"blk-52300","kind":"list-item"},{"blocks":[{"id":"blk-52303","kind":"paragraph","spans":[{"id":"spn-80638","text":"Keep verification capability for a bounded time window after deactivation to allow late telemetry retries."}]}],"id":"blk-52302","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52304","kind":"heading","level":3,"spans":[{"id":"spn-80639","text":"5) Telemetry retries and ingestion availability"}]},{"id":"blk-52305","items":[{"blocks":[{"id":"blk-52307","kind":"paragraph","spans":[{"id":"spn-80640","text":"Data plane SHOULD retry telemetry submission with exponential backoff (bounded)."}]}],"id":"blk-52306","kind":"list-item"},{"blocks":[{"id":"blk-52309","kind":"paragraph","spans":[{"id":"spn-80641","text":"Data plane SHOULD NOT block user-visible invocation completion while retrying telemetry."}]}],"id":"blk-52308","kind":"list-item"},{"blocks":[{"id":"blk-52311","kind":"paragraph","spans":[{"id":"spn-80642","text":"Control plane SHOULD expose internal health metrics for telemetry ingestion rate and rejection counts."}]}],"id":"blk-52310","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52312","kind":"heading","level":2,"spans":[{"id":"spn-80643","text":"Consequences"}]},{"id":"blk-52313","kind":"heading","level":3,"spans":[{"id":"spn-80644","text":"Positive"}]},{"id":"blk-52314","items":[{"blocks":[{"id":"blk-52316","kind":"paragraph","spans":[{"id":"spn-80645","text":"Strong billing and limits integrity foundation."}]}],"id":"blk-52315","kind":"list-item"},{"blocks":[{"id":"blk-52318","kind":"paragraph","spans":[{"id":"spn-80646","text":"Provider-agnostic design that scales to new runtimes."}]}],"id":"blk-52317","kind":"list-item"},{"blocks":[{"id":"blk-52320","kind":"paragraph","spans":[{"id":"spn-80647","text":"Reduced blast radius via deployment-scoped secrets."}]}],"id":"blk-52319","kind":"list-item"},{"blocks":[{"id":"blk-52322","kind":"paragraph","spans":[{"id":"spn-80648","text":"Clear audit path for telemetry failures and spoof attempts."}]}],"id":"blk-52321","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52323","kind":"heading","level":3,"spans":[{"id":"spn-80649","text":"Negative / tradeoffs"}]},{"id":"blk-52324","items":[{"blocks":[{"id":"blk-52326","kind":"paragraph","spans":[{"id":"spn-80650","text":"Requires deploying a telemetry secret per deployment and managing injection per provider."}]}],"id":"blk-52325","kind":"list-item"},{"blocks":[{"id":"blk-52328","kind":"paragraph","spans":[{"id":"spn-80651","text":"Requires careful handling of raw request bytes for correct signature verification."}]}],"id":"blk-52327","kind":"list-item"},{"blocks":[{"id":"blk-52330","kind":"paragraph","spans":[{"id":"spn-80652","text":"Adds complexity to runtime code (Pattern A emission) or to adapters (Pattern B emission)."}]}],"id":"blk-52329","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52331","kind":"heading","level":2,"spans":[{"id":"spn-80653","text":"Implementation requirements (checklist)"}]},{"id":"blk-52332","items":[{"blocks":[{"id":"blk-52334","kind":"paragraph","spans":[{"id":"spn-80654","text":"[ ] Each deployment has a telemetry signing secret generated by the control plane."}]}],"id":"blk-52333","kind":"list-item"},{"blocks":[{"id":"blk-52336","kind":"paragraph","spans":[{"id":"spn-80655","text":"[ ] Secret is injected into the runtime provider using provider secret mechanisms."}]}],"id":"blk-52335","kind":"list-item"},{"blocks":[{"id":"blk-52338","kind":"paragraph","spans":[{"id":"spn-80656","text":"[ ] Telemetry endpoint verifies signature using raw request body bytes."}]}],"id":"blk-52337","kind":"list-item"},{"blocks":[{"id":"blk-52340","kind":"paragraph","spans":[{"id":"spn-80657","text":"[ ] Telemetry endpoint cross-checks "},{"id":"spn-80658","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-80659","text":" ownership."}]}],"id":"blk-52339","kind":"list-item"},{"blocks":[{"id":"blk-52342","kind":"paragraph","spans":[{"id":"spn-80660","text":"[ ] Telemetry endpoint is not authenticated via browser sessions/cookies."}]}],"id":"blk-52341","kind":"list-item"},{"blocks":[{"id":"blk-52344","kind":"paragraph","spans":[{"id":"spn-80661","text":"[ ] Telemetry ingestion is idempotent under retries (dedupe window)."}]}],"id":"blk-52343","kind":"list-item"},{"blocks":[{"id":"blk-52346","kind":"paragraph","spans":[{"id":"spn-80662","text":"[ ] Telemetry payloads do not include secret values or full prompt contents by default."}]}],"id":"blk-52345","kind":"list-item"},{"blocks":[{"id":"blk-52348","kind":"paragraph","spans":[{"id":"spn-80663","text":"[ ] Telemetry rejection and signature failures are auditable (sanitized audit log)."}]}],"id":"blk-52347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52349","kind":"heading","level":2,"spans":[{"id":"spn-80664","text":"Acceptance criteria"}]},{"id":"blk-52350","kind":"paragraph","spans":[{"id":"spn-80665","text":"This ADR is considered correctly implemented when:"}]},{"id":"blk-52351","items":[{"blocks":[{"id":"blk-52353","kind":"paragraph","spans":[{"id":"spn-80666","text":"A valid telemetry payload signed with the correct deployment secret is accepted and persisted."}]}],"id":"blk-52352","kind":"list-item"},{"blocks":[{"id":"blk-52355","kind":"paragraph","spans":[{"id":"spn-80667","text":"The same payload with an invalid signature is rejected and not persisted."}]}],"id":"blk-52354","kind":"list-item"},{"blocks":[{"id":"blk-52357","kind":"paragraph","spans":[{"id":"spn-80668","text":"A valid signature with mismatched ownership (deployment belongs to a different agent/user) is rejected."}]}],"id":"blk-52356","kind":"list-item"},{"blocks":[{"id":"blk-52359","kind":"paragraph","spans":[{"id":"spn-80669","text":"Retried telemetry submissions do not cause double-counting within the dedupe strategy window."}]}],"id":"blk-52358","kind":"list-item"},{"blocks":[{"id":"blk-52361","kind":"paragraph","spans":[{"id":"spn-80670","text":"No plaintext telemetry secret values exist in the primary DB."}]}],"id":"blk-52360","kind":"list-item"},{"blocks":[{"id":"blk-52363","kind":"paragraph","spans":[{"id":"spn-80671","text":"Telemetry events are attributable to "},{"id":"spn-80672","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-80673","text":" and can be aggregated reliably for billing and limits."}]}],"id":"blk-52362","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-52364","kind":"heading","level":2,"spans":[{"id":"spn-80674","text":"Follow-ups"}]},{"id":"blk-52365","items":[{"blocks":[{"id":"blk-52367","kind":"paragraph","spans":[{"id":"spn-80675","text":"ADR-0005: Deployment immutability + active pointer model (if not already documented as ADR)."}]}],"id":"blk-52366","kind":"list-item"},{"blocks":[{"id":"blk-52369","kind":"paragraph","spans":[{"id":"spn-80676","text":"Define a standardized "},{"id":"spn-80677","marks":["code"],"text":"eventId"},{"id":"spn-80678","text":" policy if traceId uniqueness cannot be guaranteed."}]}],"id":"blk-52368","kind":"list-item"},{"blocks":[{"id":"blk-52371","kind":"paragraph","spans":[{"id":"spn-80679","text":"Consider stronger anti-replay guarantees (timestamp window + dedupe store) before enabling public agent invocations."}]}],"id":"blk-52370","kind":"list-item"},{"blocks":[{"id":"blk-52373","kind":"paragraph","spans":[{"id":"spn-80680","text":"Consider future hardening for enterprise tiers (PKI signatures or mTLS) if required by compliance/security posture."}]}],"id":"blk-52372","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7a5fcdbm7x6mvvkweb5pwehrq4jcnhitwibccmuvgp5bqbll7a5a","vocabulary":"ampersand.docs.fs.v1"}