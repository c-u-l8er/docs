{"bendscript":"0.1","blocks":[{"id":"blk-51241","kind":"heading","level":1,"spans":[{"id":"spn-77983","text":"ADR-0004: Telemetry Integrity & Attribution Model (Deployment-Scoped Signed Events)"}]},{"id":"blk-51242","kind":"paragraph","spans":[{"id":"spn-77984","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-51243","items":[{"blocks":[{"id":"blk-51245","kind":"paragraph","spans":[{"id":"spn-77985","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-51244","kind":"list-item"},{"blocks":[{"id":"blk-51247","kind":"paragraph","spans":[{"id":"spn-77986","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-51246","kind":"list-item"},{"blocks":[{"id":"blk-51249","kind":"paragraph","spans":[{"id":"spn-77987","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-51248","kind":"list-item"},{"blocks":[{"id":"blk-51251","kind":"paragraph","spans":[{"id":"spn-77988","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-51250","kind":"list-item"},{"blocks":[{"id":"blk-51253","kind":"paragraph","spans":[{"id":"spn-77989","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-51252","kind":"list-item"},{"blocks":[{"id":"blk-51255","kind":"paragraph","spans":[{"id":"spn-77990","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-51254","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51256","kind":"heading","level":2,"spans":[{"id":"spn-77991","text":"Context"}]},{"id":"blk-51257","kind":"paragraph","spans":[{"id":"spn-77992","text":"webhost.systems is a multi-runtime AI agent platform. For each invocation executed in the data plane (Cloudflare Workers/DO or AWS Bedrock AgentCore), the platform must record usage and operational telemetry for:"}]},{"id":"blk-51258","items":[{"blocks":[{"id":"blk-51260","kind":"paragraph","spans":[{"id":"spn-77993","text":"plan enforcement (requests/tokens/compute limits),"}]}],"id":"blk-51259","kind":"list-item"},{"blocks":[{"id":"blk-51262","kind":"paragraph","spans":[{"id":"spn-77994","text":"cost estimation (v1: estimated cost),"}]}],"id":"blk-51261","kind":"list-item"},{"blocks":[{"id":"blk-51264","kind":"paragraph","spans":[{"id":"spn-77995","text":"billing integrity (tier gating and upgrade flows),"}]}],"id":"blk-51263","kind":"list-item"},{"blocks":[{"id":"blk-51266","kind":"paragraph","spans":[{"id":"spn-77996","text":"observability (error rates, latency/compute, tool usage),"}]}],"id":"blk-51265","kind":"list-item"},{"blocks":[{"id":"blk-51268","kind":"paragraph","spans":[{"id":"spn-77997","text":"audits and support (traceability via "},{"id":"spn-77998","marks":["code"],"text":"traceId"},{"id":"spn-77999","text":", deploy version, runtime)."}]}],"id":"blk-51267","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51269","kind":"paragraph","spans":[{"id":"spn-78000","text":"Telemetry is consumed by the control plane and stored as append-only raw events ("},{"id":"spn-78001","marks":["code"],"text":"metricsEvents"},{"id":"spn-78002","text":") and aggregated views ("},{"id":"spn-78003","marks":["code"],"text":"billingUsage"},{"id":"spn-78004","text":")."}]},{"id":"blk-51270","kind":"heading","level":3,"spans":[{"id":"spn-78005","text":"Problem statement"}]},{"id":"blk-51271","kind":"paragraph","spans":[{"id":"spn-78006","text":"Telemetry is a critical security and business integrity surface. If telemetry is spoofable or not attributable, an attacker (or buggy runtime) could:"}]},{"id":"blk-51272","items":[{"blocks":[{"id":"blk-51274","kind":"paragraph","spans":[{"id":"spn-78007","text":"underreport usage to avoid limits or billing,"}]}],"id":"blk-51273","kind":"list-item"},{"blocks":[{"id":"blk-51276","kind":"paragraph","spans":[{"id":"spn-78008","text":"overreport usage to sabotage another tenant,"}]}],"id":"blk-51275","kind":"list-item"},{"blocks":[{"id":"blk-51278","kind":"paragraph","spans":[{"id":"spn-78009","text":"inject events for another tenant’s agents/deployments,"}]}],"id":"blk-51277","kind":"list-item"},{"blocks":[{"id":"blk-51280","kind":"paragraph","spans":[{"id":"spn-78010","text":"create ambiguity in chargeback attribution across runtimes,"}]}],"id":"blk-51279","kind":"list-item"},{"blocks":[{"id":"blk-51282","kind":"paragraph","spans":[{"id":"spn-78011","text":"break observability and incident response."}]}],"id":"blk-51281","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51283","kind":"paragraph","spans":[{"id":"spn-78012","text":"Therefore telemetry ingestion must ensure:"}]},{"id":"blk-51284","items":[{"blocks":[{"id":"blk-51286","kind":"paragraph","spans":[{"id":"spn-78013","marks":["bold"],"text":"Integrity"},{"id":"spn-78014","text":": payload not tampered in transit."}]}],"id":"blk-51285","kind":"list-item"},{"blocks":[{"id":"blk-51288","kind":"paragraph","spans":[{"id":"spn-78015","marks":["bold"],"text":"Authenticity"},{"id":"spn-78016","text":": sender is an authorized runtime deployment."}]}],"id":"blk-51287","kind":"list-item"},{"blocks":[{"id":"blk-51290","kind":"paragraph","spans":[{"id":"spn-78017","marks":["bold"],"text":"Attribution"},{"id":"spn-78018","text":": event belongs to exactly one "},{"id":"spn-78019","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-78020","text":"."}]}],"id":"blk-51289","kind":"list-item"},{"blocks":[{"id":"blk-51292","kind":"paragraph","spans":[{"id":"spn-78021","marks":["bold"],"text":"Replay safety"},{"id":"spn-78022","text":": retries do not double count; attackers cannot re-submit old events to alter usage."}]}],"id":"blk-51291","kind":"list-item"},{"blocks":[{"id":"blk-51294","kind":"paragraph","spans":[{"id":"spn-78023","marks":["bold"],"text":"No secrets leakage"},{"id":"spn-78024","text":": telemetry must never include secret values, and telemetry auth secrets must not be stored as plaintext."}]}],"id":"blk-51293","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51295","kind":"paragraph","spans":[{"id":"spn-78025","text":"Constraints:"}]},{"id":"blk-51296","items":[{"blocks":[{"id":"blk-51298","kind":"paragraph","spans":[{"id":"spn-78026","text":"Data plane runtimes are heterogeneous and may differ in what usage details they can report."}]}],"id":"blk-51297","kind":"list-item"},{"blocks":[{"id":"blk-51300","kind":"paragraph","spans":[{"id":"spn-78027","text":"Customer agent code is untrusted; it may attempt to forge telemetry or call arbitrary endpoints."}]}],"id":"blk-51299","kind":"list-item"},{"blocks":[{"id":"blk-51302","kind":"paragraph","spans":[{"id":"spn-78028","text":"Telemetry ingestion must not rely on browser sessions/cookies."}]}],"id":"blk-51301","kind":"list-item"},{"blocks":[{"id":"blk-51304","kind":"paragraph","spans":[{"id":"spn-78029","text":"The system must remain implementable for v1 without introducing a full centralized vault or complex PKI."}]}],"id":"blk-51303","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51305","kind":"heading","level":2,"spans":[{"id":"spn-78030","text":"Decision"}]},{"id":"blk-51306","kind":"paragraph","spans":[{"id":"spn-78031","text":"Adopt a "},{"id":"spn-78032","marks":["bold"],"text":"deployment-scoped signed telemetry event"},{"id":"spn-78033","text":" model with "},{"id":"spn-78034","marks":["bold"],"text":"ownership cross-checking"},{"id":"spn-78035","text":" at ingestion."}]},{"id":"blk-51307","kind":"heading","level":3,"spans":[{"id":"spn-78036","text":"Decision summary (normative)"}]},{"id":"blk-51308","items":[{"blocks":[{"id":"blk-51310","kind":"paragraph","spans":[{"id":"spn-78037","marks":["bold"],"text":"Attribution is mandatory"}]}],"id":"blk-51309","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51311","kind":"paragraph","spans":[{"id":"spn-78038","text":"Every telemetry event MUST be attributable to:"}]},{"id":"blk-51312","items":[{"blocks":[{"id":"blk-51314","kind":"paragraph","spans":[{"id":"spn-78039","marks":["code"],"text":"userId"}]}],"id":"blk-51313","kind":"list-item"},{"blocks":[{"id":"blk-51316","kind":"paragraph","spans":[{"id":"spn-78040","marks":["code"],"text":"agentId"}]}],"id":"blk-51315","kind":"list-item"},{"blocks":[{"id":"blk-51318","kind":"paragraph","spans":[{"id":"spn-78041","marks":["code"],"text":"deploymentId"}]}],"id":"blk-51317","kind":"list-item"},{"blocks":[{"id":"blk-51320","kind":"paragraph","spans":[{"id":"spn-78042","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-51319","kind":"list-item"},{"blocks":[{"id":"blk-51322","kind":"paragraph","spans":[{"id":"spn-78043","marks":["code"],"text":"timestamp"}]}],"id":"blk-51321","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51323","items":[{"blocks":[{"id":"blk-51325","kind":"paragraph","spans":[{"id":"spn-78044","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped HMAC signatures (v1)"}]}],"id":"blk-51324","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-51326","items":[{"blocks":[{"id":"blk-51328","kind":"paragraph","spans":[{"id":"spn-78045","text":"Each deployment has a unique "},{"id":"spn-78046","marks":["code"],"text":"telemetrySecret"},{"id":"spn-78047","text":" (HMAC key), generated by the control plane."}]}],"id":"blk-51327","kind":"list-item"},{"blocks":[{"id":"blk-51330","kind":"paragraph","spans":[{"id":"spn-78048","text":"The "},{"id":"spn-78049","marks":["code"],"text":"telemetrySecret"},{"id":"spn-78050","text":" is injected into the deployed runtime using provider secret mechanisms."}]}],"id":"blk-51329","kind":"list-item"},{"blocks":[{"id":"blk-51332","kind":"paragraph","spans":[{"id":"spn-78051","text":"Data plane submits telemetry to the control plane ingestion endpoint with:"}]}],"id":"blk-51331","kind":"list-item"},{"blocks":[{"id":"blk-51334","kind":"paragraph","spans":[{"id":"spn-78052","text":"header "},{"id":"spn-78053","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-51333","kind":"list-item"},{"blocks":[{"id":"blk-51336","kind":"paragraph","spans":[{"id":"spn-78054","text":"header "},{"id":"spn-78055","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex(hmac_sha256(raw_body_bytes, telemetrySecret))>"}]}],"id":"blk-51335","kind":"list-item"},{"blocks":[{"id":"blk-51338","kind":"paragraph","spans":[{"id":"spn-78056","text":"Control plane verifies:"}]}],"id":"blk-51337","kind":"list-item"},{"blocks":[{"id":"blk-51340","kind":"paragraph","spans":[{"id":"spn-78057","text":"signature validity (using deployment-scoped secret reference),"}]}],"id":"blk-51339","kind":"list-item"},{"blocks":[{"id":"blk-51342","kind":"paragraph","spans":[{"id":"spn-78058","text":"ownership mapping: deployment belongs to the agent and user in the payload,"}]}],"id":"blk-51341","kind":"list-item"},{"blocks":[{"id":"blk-51344","kind":"paragraph","spans":[{"id":"spn-78059","text":"required fields and enums."}]}],"id":"blk-51343","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51345","items":[{"blocks":[{"id":"blk-51347","kind":"paragraph","spans":[{"id":"spn-78060","marks":["bold"],"text":"Ingestion performs ownership cross-check (defense in depth)"}]}],"id":"blk-51346","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-51348","kind":"paragraph","spans":[{"id":"spn-78061","text":"After signature validation, ingestion MUST query control plane data and verify:"}]},{"id":"blk-51349","items":[{"blocks":[{"id":"blk-51351","kind":"paragraph","spans":[{"id":"spn-78062","marks":["code"],"text":"deployments._id == deploymentId"}]}],"id":"blk-51350","kind":"list-item"},{"blocks":[{"id":"blk-51353","kind":"paragraph","spans":[{"id":"spn-78063","marks":["code"],"text":"deployments.agentId == agentId"}]}],"id":"blk-51352","kind":"list-item"},{"blocks":[{"id":"blk-51355","kind":"paragraph","spans":[{"id":"spn-78064","marks":["code"],"text":"deployments.userId == userId"}]}],"id":"blk-51354","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51356","kind":"paragraph","spans":[{"id":"spn-78065","text":"If any mismatch: reject the event, optionally record an "},{"id":"spn-78066","marks":["code"],"text":"auditLog"},{"id":"spn-78067","text":" entry with sanitized details."}]},{"id":"blk-51357","items":[{"blocks":[{"id":"blk-51359","kind":"paragraph","spans":[{"id":"spn-78068","marks":["bold"],"text":"Telemetry does not use user auth"}]}],"id":"blk-51358","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-51360","kind":"paragraph","spans":[{"id":"spn-78069","text":"Telemetry ingestion MUST NOT accept browser session cookies as authentication. Telemetry is authenticated solely by deployment-scoped signature (and optional anti-replay)."}]},{"id":"blk-51361","items":[{"blocks":[{"id":"blk-51363","kind":"paragraph","spans":[{"id":"spn-78070","marks":["bold"],"text":"Replay/dedupe (recommended in v1; mandatory before public invocations)"}]}],"id":"blk-51362","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-51364","kind":"paragraph","spans":[{"id":"spn-78071","text":"Telemetry ingestion SHOULD implement one of:"}]},{"id":"blk-51365","items":[{"blocks":[{"id":"blk-51367","kind":"paragraph","spans":[{"id":"spn-78072","marks":["code"],"text":"eventId"},{"id":"spn-78073","text":" (UUID generated by data plane) + short-window dedupe store, OR"}]}],"id":"blk-51366","kind":"list-item"},{"blocks":[{"id":"blk-51369","kind":"paragraph","spans":[{"id":"spn-78074","text":"dedupe on "},{"id":"spn-78075","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-78076","text":" if "},{"id":"spn-78077","marks":["code"],"text":"traceId"},{"id":"spn-78078","text":" uniqueness per invocation is guaranteed."}]}],"id":"blk-51368","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51370","kind":"paragraph","spans":[{"id":"spn-78079","text":"In either case, ingestion must be idempotent under retries to prevent double counting."}]},{"id":"blk-51371","items":[{"blocks":[{"id":"blk-51373","kind":"paragraph","spans":[{"id":"spn-78080","marks":["bold"],"text":"Secrets are never stored as plaintext in the primary DB"}]}],"id":"blk-51372","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-51374","items":[{"blocks":[{"id":"blk-51376","kind":"paragraph","spans":[{"id":"spn-78081","text":"The primary DB stores only metadata and secret references (e.g., provider secret name/id)."}]}],"id":"blk-51375","kind":"list-item"},{"blocks":[{"id":"blk-51378","kind":"paragraph","spans":[{"id":"spn-78082","text":"The "},{"id":"spn-78083","marks":["code"],"text":"telemetrySecret"},{"id":"spn-78084","text":" value MUST NOT be stored in plaintext in the primary database (Supabase)."}]}],"id":"blk-51377","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51379","kind":"heading","level":3,"spans":[{"id":"spn-78085","text":"Provider-specific telemetry capabilities (implementation guidance)"}]},{"id":"blk-51380","kind":"paragraph","spans":[{"id":"spn-78086","text":"This ADR standardizes telemetry ingestion on "},{"id":"spn-78087","marks":["bold"],"text":"deployment-scoped signed events"},{"id":"spn-78088","text":" for all runtimes. Provider capabilities vary, but the v1 baseline remains consistent."}]},{"id":"blk-51381","kind":"paragraph","spans":[{"id":"spn-78089","marks":["bold"],"text":"Cloudflare (Workers + Durable Objects):"}]},{"id":"blk-51382","items":[{"blocks":[{"id":"blk-51384","kind":"paragraph","spans":[{"id":"spn-78090","text":"The runtime MUST explicitly emit telemetry to the control plane (Pattern A: in-workload emission is the preferred approach)."}]}],"id":"blk-51383","kind":"list-item"},{"blocks":[{"id":"blk-51386","kind":"paragraph","spans":[{"id":"spn-78091","text":"The telemetry signing secret is injected via Worker secret bindings."}]}],"id":"blk-51385","kind":"list-item"},{"blocks":[{"id":"blk-51388","kind":"paragraph","spans":[{"id":"spn-78092","text":"The Worker/DO submits "},{"id":"spn-78093","marks":["code"],"text":"POST /v1/telemetry/report"},{"id":"spn-78094","text":" with "},{"id":"spn-78095","marks":["code"],"text":"X-Telemetry-Deployment-Id"},{"id":"spn-78096","text":" and "},{"id":"spn-78097","marks":["code"],"text":"X-Telemetry-Signature"},{"id":"spn-78098","text":"."}]}],"id":"blk-51387","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51389","kind":"paragraph","spans":[{"id":"spn-78099","marks":["bold"],"text":"AgentCore (AWS Bedrock AgentCore):"}]},{"id":"blk-51390","items":[{"blocks":[{"id":"blk-51392","kind":"paragraph","spans":[{"id":"spn-78100","text":"AgentCore may provide provider-native observability capabilities (e.g., service-level telemetry/OTel-style integrations) that can be valuable for deep debugging."}]}],"id":"blk-51391","kind":"list-item"},{"blocks":[{"id":"blk-51394","kind":"paragraph","spans":[{"id":"spn-78101","marks":["bold"],"text":"v1 baseline:"},{"id":"spn-78102","text":" use the same direct signed submission model as Cloudflare (either in-workload emission when feasible, or adapter-side emission when required by provider constraints) to keep metering, limits, and billing semantics consistent across runtimes."}]}],"id":"blk-51393","kind":"list-item"},{"blocks":[{"id":"blk-51396","kind":"paragraph","spans":[{"id":"spn-78103","marks":["bold"],"text":"post-v1 enhancement:"},{"id":"spn-78104","text":" integrate provider-native observability for richer traces while still emitting the normalized, signed metering event used for billing and limits."}]}],"id":"blk-51395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51397","kind":"heading","level":2,"spans":[{"id":"spn-78105","text":"Rationale"}]},{"id":"blk-51398","kind":"paragraph","spans":[{"id":"spn-78106","text":"This approach satisfies the requirements with minimal complexity:"}]},{"id":"blk-51399","items":[{"blocks":[{"id":"blk-51401","kind":"paragraph","spans":[{"id":"spn-78107","marks":["bold"],"text":"Integrity and authenticity"},{"id":"spn-78108","text":": HMAC signatures prevent tampering and authenticate possession of a deployment-scoped secret."}]}],"id":"blk-51400","kind":"list-item"},{"blocks":[{"id":"blk-51403","kind":"paragraph","spans":[{"id":"spn-78109","marks":["bold"],"text":"Tenant protection"},{"id":"spn-78110","text":": ownership cross-check prevents a compromised deployment secret from being used to write events for a different agent or user."}]}],"id":"blk-51402","kind":"list-item"},{"blocks":[{"id":"blk-51405","kind":"paragraph","spans":[{"id":"spn-78111","marks":["bold"],"text":"Least privilege"},{"id":"spn-78112","text":": deployment-scoped secret limits blast radius if compromised."}]}],"id":"blk-51404","kind":"list-item"},{"blocks":[{"id":"blk-51407","kind":"paragraph","spans":[{"id":"spn-78113","marks":["bold"],"text":"Provider portability"},{"id":"spn-78114","text":": works across runtimes because it relies on a generic “can send HTTP + store secret” capability."}]}],"id":"blk-51406","kind":"list-item"},{"blocks":[{"id":"blk-51409","kind":"paragraph","spans":[{"id":"spn-78115","marks":["bold"],"text":"Operable MVP"},{"id":"spn-78116","text":": avoids the need for PKI or an always-online centralized vault, while still enabling strong guarantees."}]}],"id":"blk-51408","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51410","kind":"heading","level":2,"spans":[{"id":"spn-78117","text":"Alternatives considered"}]},{"id":"blk-51411","kind":"heading","level":3,"spans":[{"id":"spn-78118","text":"A) Trust telemetry without signatures (reject)"}]},{"id":"blk-51412","kind":"paragraph","spans":[{"id":"spn-78119","marks":["bold"],"text":"Pros"}]},{"id":"blk-51413","items":[{"blocks":[{"id":"blk-51415","kind":"paragraph","spans":[{"id":"spn-78120","text":"Easiest to implement."}]}],"id":"blk-51414","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51416","kind":"paragraph","spans":[{"id":"spn-78121","marks":["bold"],"text":"Cons"}]},{"id":"blk-51417","items":[{"blocks":[{"id":"blk-51419","kind":"paragraph","spans":[{"id":"spn-78122","text":"Enables trivial spoofing and billing manipulation."}]}],"id":"blk-51418","kind":"list-item"},{"blocks":[{"id":"blk-51421","kind":"paragraph","spans":[{"id":"spn-78123","text":"Allows cross-tenant sabotage and incorrect usage enforcement."}]}],"id":"blk-51420","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51422","kind":"paragraph","spans":[{"id":"spn-78124","marks":["bold"],"text":"Decision"},{"id":"spn-78125","text":" Rejected. Not acceptable for any paid system with limits and billing."}]},{"id":"blk-51423","kind":"heading","level":3,"spans":[{"id":"spn-78126","text":"B) Adapter-side telemetry only (partial alternative)"}]},{"id":"blk-51424","kind":"paragraph","spans":[{"id":"spn-78127","text":"Telemetry is emitted only by the control plane adapter after it receives provider responses."}]},{"id":"blk-51425","kind":"paragraph","spans":[{"id":"spn-78128","marks":["bold"],"text":"Pros"}]},{"id":"blk-51426","items":[{"blocks":[{"id":"blk-51428","kind":"paragraph","spans":[{"id":"spn-78129","text":"Avoids injecting telemetry secrets into runtime code."}]}],"id":"blk-51427","kind":"list-item"},{"blocks":[{"id":"blk-51430","kind":"paragraph","spans":[{"id":"spn-78130","text":"Avoids runtime outbound call to control plane."}]}],"id":"blk-51429","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51431","kind":"paragraph","spans":[{"id":"spn-78131","marks":["bold"],"text":"Cons"}]},{"id":"blk-51432","items":[{"blocks":[{"id":"blk-51434","kind":"paragraph","spans":[{"id":"spn-78132","text":"Often cannot capture provider-specific usage (compute/tool usage) reliably."}]}],"id":"blk-51433","kind":"list-item"},{"blocks":[{"id":"blk-51436","kind":"paragraph","spans":[{"id":"spn-78133","text":"Creates attribution gaps if invocations happen outside the adapter path or if provider returns incomplete usage."}]}],"id":"blk-51435","kind":"list-item"},{"blocks":[{"id":"blk-51438","kind":"paragraph","spans":[{"id":"spn-78134","text":"Weakens correlation with runtime events and can undercount."}]}],"id":"blk-51437","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51439","kind":"paragraph","spans":[{"id":"spn-78135","marks":["bold"],"text":"Decision"},{"id":"spn-78136","text":" Not the primary model. Allowed as a constrained fallback if a provider cannot support in-workload emission, but must preserve integrity and attribution. If adapter emits, it must still attach to a deployment and enforce ownership; it must not be forgeable by clients."}]},{"id":"blk-51440","kind":"heading","level":3,"spans":[{"id":"spn-78137","text":"C) Per-user telemetry keys (reject)"}]},{"id":"blk-51441","kind":"paragraph","spans":[{"id":"spn-78138","text":"Use one key per user shared across all deployments."}]},{"id":"blk-51442","kind":"paragraph","spans":[{"id":"spn-78139","marks":["bold"],"text":"Pros"}]},{"id":"blk-51443","items":[{"blocks":[{"id":"blk-51445","kind":"paragraph","spans":[{"id":"spn-78140","text":"Fewer secrets."}]}],"id":"blk-51444","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51446","kind":"paragraph","spans":[{"id":"spn-78141","marks":["bold"],"text":"Cons"}]},{"id":"blk-51447","items":[{"blocks":[{"id":"blk-51449","kind":"paragraph","spans":[{"id":"spn-78142","text":"Massive blast radius if compromised; compromised deployment can spoof across all user deployments."}]}],"id":"blk-51448","kind":"list-item"},{"blocks":[{"id":"blk-51451","kind":"paragraph","spans":[{"id":"spn-78143","text":"Harder to rotate safely and isolate issues."}]}],"id":"blk-51450","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51452","kind":"paragraph","spans":[{"id":"spn-78144","marks":["bold"],"text":"Decision"},{"id":"spn-78145","text":" Rejected. Deployment-scoped keys are safer and align with immutability and auditability."}]},{"id":"blk-51453","kind":"heading","level":3,"spans":[{"id":"spn-78146","text":"D) Public-key signatures (PKI) per deployment (defer)"}]},{"id":"blk-51454","kind":"paragraph","spans":[{"id":"spn-78147","text":"Each deployment gets a keypair; telemetry signed with private key, verified with public key."}]},{"id":"blk-51455","kind":"paragraph","spans":[{"id":"spn-78148","marks":["bold"],"text":"Pros"}]},{"id":"blk-51456","items":[{"blocks":[{"id":"blk-51458","kind":"paragraph","spans":[{"id":"spn-78149","text":"No shared secret at ingestion; avoids secret distribution to verifier."}]}],"id":"blk-51457","kind":"list-item"},{"blocks":[{"id":"blk-51460","kind":"paragraph","spans":[{"id":"spn-78150","text":"Strong cryptographic model."}]}],"id":"blk-51459","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51461","kind":"paragraph","spans":[{"id":"spn-78151","marks":["bold"],"text":"Cons"}]},{"id":"blk-51462","items":[{"blocks":[{"id":"blk-51464","kind":"paragraph","spans":[{"id":"spn-78152","text":"Adds key management complexity; still needs secure private key injection to runtime."}]}],"id":"blk-51463","kind":"list-item"},{"blocks":[{"id":"blk-51466","kind":"paragraph","spans":[{"id":"spn-78153","text":"Higher implementation overhead for v1 without clear ROI."}]}],"id":"blk-51465","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51467","kind":"paragraph","spans":[{"id":"spn-78154","marks":["bold"],"text":"Decision"},{"id":"spn-78155","text":" Deferred. Consider post-v1 if you need stronger non-repudiation or third-party verification."}]},{"id":"blk-51468","kind":"heading","level":3,"spans":[{"id":"spn-78156","text":"E) mTLS between data plane and control plane (defer)"}]},{"id":"blk-51469","kind":"paragraph","spans":[{"id":"spn-78157","text":"Use mutual TLS with client certs per deployment."}]},{"id":"blk-51470","kind":"paragraph","spans":[{"id":"spn-78158","marks":["bold"],"text":"Pros"}]},{"id":"blk-51471","items":[{"blocks":[{"id":"blk-51473","kind":"paragraph","spans":[{"id":"spn-78159","text":"Strong channel-level authentication."}]}],"id":"blk-51472","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51474","kind":"paragraph","spans":[{"id":"spn-78160","marks":["bold"],"text":"Cons"}]},{"id":"blk-51475","items":[{"blocks":[{"id":"blk-51477","kind":"paragraph","spans":[{"id":"spn-78161","text":"Operationally heavy; certificate issuance/rotation complexity."}]}],"id":"blk-51476","kind":"list-item"},{"blocks":[{"id":"blk-51479","kind":"paragraph","spans":[{"id":"spn-78162","text":"Hard to implement uniformly across runtimes."}]}],"id":"blk-51478","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51480","kind":"paragraph","spans":[{"id":"spn-78163","marks":["bold"],"text":"Decision"},{"id":"spn-78164","text":" Deferred. Potential future hardening for enterprise tiers."}]},{"id":"blk-51481","kind":"heading","level":2,"spans":[{"id":"spn-78165","text":"Detailed design (normative)"}]},{"id":"blk-51482","kind":"heading","level":3,"spans":[{"id":"spn-78166","text":"1) Telemetry event schema (minimum viable)"}]},{"id":"blk-51483","kind":"paragraph","spans":[{"id":"spn-78167","text":"Telemetry payload MUST include:"}]},{"id":"blk-51484","items":[{"blocks":[{"id":"blk-51486","kind":"paragraph","spans":[{"id":"spn-78168","marks":["code"],"text":"userId"},{"id":"spn-78169","text":" (internal id)"}]}],"id":"blk-51485","kind":"list-item"},{"blocks":[{"id":"blk-51488","kind":"paragraph","spans":[{"id":"spn-78170","marks":["code"],"text":"agentId"}]}],"id":"blk-51487","kind":"list-item"},{"blocks":[{"id":"blk-51490","kind":"paragraph","spans":[{"id":"spn-78171","marks":["code"],"text":"deploymentId"}]}],"id":"blk-51489","kind":"list-item"},{"blocks":[{"id":"blk-51492","kind":"paragraph","spans":[{"id":"spn-78172","marks":["code"],"text":"runtimeProvider"},{"id":"spn-78173","text":" ("},{"id":"spn-78174","marks":["code"],"text":"cloudflare"},{"id":"spn-78175","text":" | "},{"id":"spn-78176","marks":["code"],"text":"agentcore"},{"id":"spn-78177","text":")"}]}],"id":"blk-51491","kind":"list-item"},{"blocks":[{"id":"blk-51494","kind":"paragraph","spans":[{"id":"spn-78178","marks":["code"],"text":"timestamp"},{"id":"spn-78179","text":" (RFC3339 or unix ms; ingestion converts to unix ms)"}]}],"id":"blk-51493","kind":"list-item"},{"blocks":[{"id":"blk-51496","kind":"paragraph","spans":[{"id":"spn-78180","marks":["code"],"text":"requests"},{"id":"spn-78181","text":" (typically 1)"}]}],"id":"blk-51495","kind":"list-item"},{"blocks":[{"id":"blk-51498","kind":"paragraph","spans":[{"id":"spn-78182","marks":["code"],"text":"llmTokens"},{"id":"spn-78183","text":" (reported or estimated)"}]}],"id":"blk-51497","kind":"list-item"},{"blocks":[{"id":"blk-51500","kind":"paragraph","spans":[{"id":"spn-78184","marks":["code"],"text":"computeMs"},{"id":"spn-78185","text":" (wall time or billed time, defined per provider)"}]}],"id":"blk-51499","kind":"list-item"},{"blocks":[{"id":"blk-51502","kind":"paragraph","spans":[{"id":"spn-78186","marks":["code"],"text":"errors"},{"id":"spn-78187","text":" (0/1 typical)"}]}],"id":"blk-51501","kind":"list-item"},{"blocks":[{"id":"blk-51504","kind":"paragraph","spans":[{"id":"spn-78188","marks":["code"],"text":"errorClass"},{"id":"spn-78189","text":" (optional: "},{"id":"spn-78190","marks":["code"],"text":"auth | limit | runtime | tool | unknown"},{"id":"spn-78191","text":")"}]}],"id":"blk-51503","kind":"list-item"},{"blocks":[{"id":"blk-51506","kind":"paragraph","spans":[{"id":"spn-78192","marks":["code"],"text":"costUsdEstimated"}]}],"id":"blk-51505","kind":"list-item"},{"blocks":[{"id":"blk-51508","kind":"paragraph","spans":[{"id":"spn-78193","marks":["code"],"text":"traceId"},{"id":"spn-78194","text":" (optional but recommended)"}]}],"id":"blk-51507","kind":"list-item"},{"blocks":[{"id":"blk-51510","kind":"paragraph","spans":[{"id":"spn-78195","marks":["code"],"text":"provider"},{"id":"spn-78196","text":" (optional runtime-specific counters)"}]}],"id":"blk-51509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51511","kind":"paragraph","spans":[{"id":"spn-78197","text":"Telemetry MUST NOT include:"}]},{"id":"blk-51512","items":[{"blocks":[{"id":"blk-51514","kind":"paragraph","spans":[{"id":"spn-78198","text":"plaintext secrets,"}]}],"id":"blk-51513","kind":"list-item"},{"blocks":[{"id":"blk-51516","kind":"paragraph","spans":[{"id":"spn-78199","text":"full prompts/responses by default (unless an explicit opt-in feature is added later),"}]}],"id":"blk-51515","kind":"list-item"},{"blocks":[{"id":"blk-51518","kind":"paragraph","spans":[{"id":"spn-78200","text":"raw provider credential material."}]}],"id":"blk-51517","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51519","kind":"heading","level":3,"spans":[{"id":"spn-78201","text":"2) Signature computation"}]},{"id":"blk-51520","items":[{"blocks":[{"id":"blk-51522","kind":"paragraph","spans":[{"id":"spn-78202","text":"Signature is computed over the exact raw request body bytes as received/sent."}]}],"id":"blk-51521","kind":"list-item"},{"blocks":[{"id":"blk-51524","kind":"paragraph","spans":[{"id":"spn-78203","text":"Algorithm: "},{"id":"spn-78204","marks":["code"],"text":"HMAC_SHA256(telemetrySecret, raw_body_bytes)"},{"id":"spn-78205","text":"."}]}],"id":"blk-51523","kind":"list-item"},{"blocks":[{"id":"blk-51526","kind":"paragraph","spans":[{"id":"spn-78206","text":"Encoding: hex lowercase recommended."}]}],"id":"blk-51525","kind":"list-item"},{"blocks":[{"id":"blk-51528","kind":"paragraph","spans":[{"id":"spn-78207","text":"Header format: "},{"id":"spn-78208","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex>"},{"id":"spn-78209","text":"."}]}],"id":"blk-51527","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51529","kind":"paragraph","spans":[{"id":"spn-78210","text":"Canonicalization note:"}]},{"id":"blk-51530","items":[{"blocks":[{"id":"blk-51532","kind":"paragraph","spans":[{"id":"spn-78211","text":"The verifier MUST use the raw body bytes, not a re-serialized JSON object."}]}],"id":"blk-51531","kind":"list-item"},{"blocks":[{"id":"blk-51534","kind":"paragraph","spans":[{"id":"spn-78212","text":"If your framework modifies request bodies, capture raw bytes before parsing."}]}],"id":"blk-51533","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51535","kind":"heading","level":3,"spans":[{"id":"spn-78213","text":"3) Ingestion validation steps (MUST)"}]},{"id":"blk-51536","kind":"paragraph","spans":[{"id":"spn-78214","text":"In order:"}]},{"id":"blk-51537","items":[{"blocks":[{"id":"blk-51539","kind":"paragraph","spans":[{"id":"spn-78215","text":"Read "},{"id":"spn-78216","marks":["code"],"text":"deploymentId"},{"id":"spn-78217","text":" header and locate deployment record."}]}],"id":"blk-51538","kind":"list-item"},{"blocks":[{"id":"blk-51541","kind":"paragraph","spans":[{"id":"spn-78218","text":"Fetch deployment-scoped secret reference and verify signature."}]}],"id":"blk-51540","kind":"list-item"},{"blocks":[{"id":"blk-51543","kind":"paragraph","spans":[{"id":"spn-78219","text":"Parse JSON body and validate required fields and enums."}]}],"id":"blk-51542","kind":"list-item"},{"blocks":[{"id":"blk-51545","kind":"paragraph","spans":[{"id":"spn-78220","text":"Ownership cross-check:"}]}],"id":"blk-51544","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51546","items":[{"blocks":[{"id":"blk-51548","kind":"paragraph","spans":[{"id":"spn-78221","marks":["code"],"text":"deployments.userId == body.userId"}]}],"id":"blk-51547","kind":"list-item"},{"blocks":[{"id":"blk-51550","kind":"paragraph","spans":[{"id":"spn-78222","marks":["code"],"text":"deployments.agentId == body.agentId"}]}],"id":"blk-51549","kind":"list-item"},{"blocks":[{"id":"blk-51552","kind":"paragraph","spans":[{"id":"spn-78223","marks":["code"],"text":"deployments._id == body.deploymentId"},{"id":"spn-78224","text":" (or match header)"}]}],"id":"blk-51551","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51553","items":[{"blocks":[{"id":"blk-51555","kind":"paragraph","spans":[{"id":"spn-78225","text":"Dedupe/idempotency:"}]}],"id":"blk-51554","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-51556","items":[{"blocks":[{"id":"blk-51558","kind":"paragraph","spans":[{"id":"spn-78226","text":"if "},{"id":"spn-78227","marks":["code"],"text":"eventId"},{"id":"spn-78228","text":" used: reject or no-op if already processed in dedupe window"}]}],"id":"blk-51557","kind":"list-item"},{"blocks":[{"id":"blk-51560","kind":"paragraph","spans":[{"id":"spn-78229","text":"if "},{"id":"spn-78230","marks":["code"],"text":"traceId"},{"id":"spn-78231","text":" used: ensure uniqueness per "},{"id":"spn-78232","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-78233","text":" in dedupe window"}]}],"id":"blk-51559","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51561","items":[{"blocks":[{"id":"blk-51563","kind":"paragraph","spans":[{"id":"spn-78234","text":"Persist event append-only."}]}],"id":"blk-51562","kind":"list-item"},{"blocks":[{"id":"blk-51565","kind":"paragraph","spans":[{"id":"spn-78235","text":"Optionally update incremental counters."}]}],"id":"blk-51564","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-51566","kind":"paragraph","spans":[{"id":"spn-78236","text":"If any step fails:"}]},{"id":"blk-51567","items":[{"blocks":[{"id":"blk-51569","kind":"paragraph","spans":[{"id":"spn-78237","text":"respond with normalized error (for non-telemetry callers, keep generic),"}]}],"id":"blk-51568","kind":"list-item"},{"blocks":[{"id":"blk-51571","kind":"paragraph","spans":[{"id":"spn-78238","text":"DO NOT reveal secret or internal details,"}]}],"id":"blk-51570","kind":"list-item"},{"blocks":[{"id":"blk-51573","kind":"paragraph","spans":[{"id":"spn-78239","text":"optionally write a sanitized "},{"id":"spn-78240","marks":["code"],"text":"auditLog"},{"id":"spn-78241","text":" entry for investigation."}]}],"id":"blk-51572","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51574","kind":"heading","level":3,"spans":[{"id":"spn-78242","text":"4) Secret generation and rotation"}]},{"id":"blk-51575","items":[{"blocks":[{"id":"blk-51577","kind":"paragraph","spans":[{"id":"spn-78243","text":"Generate a new telemetry secret on every new deployment by default."}]}],"id":"blk-51576","kind":"list-item"},{"blocks":[{"id":"blk-51579","kind":"paragraph","spans":[{"id":"spn-78244","text":"Inject the secret into the runtime provider as a secret (not as plain env var stored in DB)."}]}],"id":"blk-51578","kind":"list-item"},{"blocks":[{"id":"blk-51581","kind":"paragraph","spans":[{"id":"spn-78245","text":"Rotation policy:"}]}],"id":"blk-51580","kind":"list-item"},{"blocks":[{"id":"blk-51583","kind":"paragraph","spans":[{"id":"spn-78246","text":"New deployment => new telemetry secret (mandatory)."}]}],"id":"blk-51582","kind":"list-item"},{"blocks":[{"id":"blk-51585","kind":"paragraph","spans":[{"id":"spn-78247","text":"Old deployments retain old secret for the duration they might emit telemetry (but they should not emit after deactivation, except in-flight retries)."}]}],"id":"blk-51584","kind":"list-item"},{"blocks":[{"id":"blk-51587","kind":"paragraph","spans":[{"id":"spn-78248","text":"Keep verification capability for a bounded time window after deactivation to allow late telemetry retries."}]}],"id":"blk-51586","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51588","kind":"heading","level":3,"spans":[{"id":"spn-78249","text":"5) Telemetry retries and ingestion availability"}]},{"id":"blk-51589","items":[{"blocks":[{"id":"blk-51591","kind":"paragraph","spans":[{"id":"spn-78250","text":"Data plane SHOULD retry telemetry submission with exponential backoff (bounded)."}]}],"id":"blk-51590","kind":"list-item"},{"blocks":[{"id":"blk-51593","kind":"paragraph","spans":[{"id":"spn-78251","text":"Data plane SHOULD NOT block user-visible invocation completion while retrying telemetry."}]}],"id":"blk-51592","kind":"list-item"},{"blocks":[{"id":"blk-51595","kind":"paragraph","spans":[{"id":"spn-78252","text":"Control plane SHOULD expose internal health metrics for telemetry ingestion rate and rejection counts."}]}],"id":"blk-51594","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51596","kind":"heading","level":2,"spans":[{"id":"spn-78253","text":"Consequences"}]},{"id":"blk-51597","kind":"heading","level":3,"spans":[{"id":"spn-78254","text":"Positive"}]},{"id":"blk-51598","items":[{"blocks":[{"id":"blk-51600","kind":"paragraph","spans":[{"id":"spn-78255","text":"Strong billing and limits integrity foundation."}]}],"id":"blk-51599","kind":"list-item"},{"blocks":[{"id":"blk-51602","kind":"paragraph","spans":[{"id":"spn-78256","text":"Provider-agnostic design that scales to new runtimes."}]}],"id":"blk-51601","kind":"list-item"},{"blocks":[{"id":"blk-51604","kind":"paragraph","spans":[{"id":"spn-78257","text":"Reduced blast radius via deployment-scoped secrets."}]}],"id":"blk-51603","kind":"list-item"},{"blocks":[{"id":"blk-51606","kind":"paragraph","spans":[{"id":"spn-78258","text":"Clear audit path for telemetry failures and spoof attempts."}]}],"id":"blk-51605","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51607","kind":"heading","level":3,"spans":[{"id":"spn-78259","text":"Negative / tradeoffs"}]},{"id":"blk-51608","items":[{"blocks":[{"id":"blk-51610","kind":"paragraph","spans":[{"id":"spn-78260","text":"Requires deploying a telemetry secret per deployment and managing injection per provider."}]}],"id":"blk-51609","kind":"list-item"},{"blocks":[{"id":"blk-51612","kind":"paragraph","spans":[{"id":"spn-78261","text":"Requires careful handling of raw request bytes for correct signature verification."}]}],"id":"blk-51611","kind":"list-item"},{"blocks":[{"id":"blk-51614","kind":"paragraph","spans":[{"id":"spn-78262","text":"Adds complexity to runtime code (Pattern A emission) or to adapters (Pattern B emission)."}]}],"id":"blk-51613","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51615","kind":"heading","level":2,"spans":[{"id":"spn-78263","text":"Implementation requirements (checklist)"}]},{"id":"blk-51616","items":[{"blocks":[{"id":"blk-51618","kind":"paragraph","spans":[{"id":"spn-78264","text":"[ ] Each deployment has a telemetry signing secret generated by the control plane."}]}],"id":"blk-51617","kind":"list-item"},{"blocks":[{"id":"blk-51620","kind":"paragraph","spans":[{"id":"spn-78265","text":"[ ] Secret is injected into the runtime provider using provider secret mechanisms."}]}],"id":"blk-51619","kind":"list-item"},{"blocks":[{"id":"blk-51622","kind":"paragraph","spans":[{"id":"spn-78266","text":"[ ] Telemetry endpoint verifies signature using raw request body bytes."}]}],"id":"blk-51621","kind":"list-item"},{"blocks":[{"id":"blk-51624","kind":"paragraph","spans":[{"id":"spn-78267","text":"[ ] Telemetry endpoint cross-checks "},{"id":"spn-78268","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-78269","text":" ownership."}]}],"id":"blk-51623","kind":"list-item"},{"blocks":[{"id":"blk-51626","kind":"paragraph","spans":[{"id":"spn-78270","text":"[ ] Telemetry endpoint is not authenticated via browser sessions/cookies."}]}],"id":"blk-51625","kind":"list-item"},{"blocks":[{"id":"blk-51628","kind":"paragraph","spans":[{"id":"spn-78271","text":"[ ] Telemetry ingestion is idempotent under retries (dedupe window)."}]}],"id":"blk-51627","kind":"list-item"},{"blocks":[{"id":"blk-51630","kind":"paragraph","spans":[{"id":"spn-78272","text":"[ ] Telemetry payloads do not include secret values or full prompt contents by default."}]}],"id":"blk-51629","kind":"list-item"},{"blocks":[{"id":"blk-51632","kind":"paragraph","spans":[{"id":"spn-78273","text":"[ ] Telemetry rejection and signature failures are auditable (sanitized audit log)."}]}],"id":"blk-51631","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51633","kind":"heading","level":2,"spans":[{"id":"spn-78274","text":"Acceptance criteria"}]},{"id":"blk-51634","kind":"paragraph","spans":[{"id":"spn-78275","text":"This ADR is considered correctly implemented when:"}]},{"id":"blk-51635","items":[{"blocks":[{"id":"blk-51637","kind":"paragraph","spans":[{"id":"spn-78276","text":"A valid telemetry payload signed with the correct deployment secret is accepted and persisted."}]}],"id":"blk-51636","kind":"list-item"},{"blocks":[{"id":"blk-51639","kind":"paragraph","spans":[{"id":"spn-78277","text":"The same payload with an invalid signature is rejected and not persisted."}]}],"id":"blk-51638","kind":"list-item"},{"blocks":[{"id":"blk-51641","kind":"paragraph","spans":[{"id":"spn-78278","text":"A valid signature with mismatched ownership (deployment belongs to a different agent/user) is rejected."}]}],"id":"blk-51640","kind":"list-item"},{"blocks":[{"id":"blk-51643","kind":"paragraph","spans":[{"id":"spn-78279","text":"Retried telemetry submissions do not cause double-counting within the dedupe strategy window."}]}],"id":"blk-51642","kind":"list-item"},{"blocks":[{"id":"blk-51645","kind":"paragraph","spans":[{"id":"spn-78280","text":"No plaintext telemetry secret values exist in the primary DB."}]}],"id":"blk-51644","kind":"list-item"},{"blocks":[{"id":"blk-51647","kind":"paragraph","spans":[{"id":"spn-78281","text":"Telemetry events are attributable to "},{"id":"spn-78282","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-78283","text":" and can be aggregated reliably for billing and limits."}]}],"id":"blk-51646","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51648","kind":"heading","level":2,"spans":[{"id":"spn-78284","text":"Follow-ups"}]},{"id":"blk-51649","items":[{"blocks":[{"id":"blk-51651","kind":"paragraph","spans":[{"id":"spn-78285","text":"ADR-0005: Deployment immutability + active pointer model (if not already documented as ADR)."}]}],"id":"blk-51650","kind":"list-item"},{"blocks":[{"id":"blk-51653","kind":"paragraph","spans":[{"id":"spn-78286","text":"Define a standardized "},{"id":"spn-78287","marks":["code"],"text":"eventId"},{"id":"spn-78288","text":" policy if traceId uniqueness cannot be guaranteed."}]}],"id":"blk-51652","kind":"list-item"},{"blocks":[{"id":"blk-51655","kind":"paragraph","spans":[{"id":"spn-78289","text":"Consider stronger anti-replay guarantees (timestamp window + dedupe store) before enabling public agent invocations."}]}],"id":"blk-51654","kind":"list-item"},{"blocks":[{"id":"blk-51657","kind":"paragraph","spans":[{"id":"spn-78290","text":"Consider future hardening for enterprise tiers (PKI signatures or mTLS) if required by compliance/security posture."}]}],"id":"blk-51656","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraolnzmgiyfwa7tbqyvdlee2qxydeztdqyuecx42t6n6h7houkixza","vocabulary":"ampersand.docs.fs.v1"}