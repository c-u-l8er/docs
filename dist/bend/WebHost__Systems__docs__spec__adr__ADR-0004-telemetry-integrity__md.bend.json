{"bendscript":"0.1","blocks":[{"id":"blk-32498","kind":"heading","level":1,"spans":[{"id":"spn-36486","text":"ADR-0004: Telemetry Integrity & Attribution Model (Deployment-Scoped Signed Events)"}]},{"id":"blk-32499","kind":"paragraph","spans":[{"id":"spn-36487","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-32500","items":[{"blocks":[{"id":"blk-32502","kind":"paragraph","spans":[{"id":"spn-36488","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-32501","kind":"list-item"},{"blocks":[{"id":"blk-32504","kind":"paragraph","spans":[{"id":"spn-36489","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-32503","kind":"list-item"},{"blocks":[{"id":"blk-32506","kind":"paragraph","spans":[{"id":"spn-36490","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-32505","kind":"list-item"},{"blocks":[{"id":"blk-32508","kind":"paragraph","spans":[{"id":"spn-36491","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-32507","kind":"list-item"},{"blocks":[{"id":"blk-32510","kind":"paragraph","spans":[{"id":"spn-36492","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-32509","kind":"list-item"},{"blocks":[{"id":"blk-32512","kind":"paragraph","spans":[{"id":"spn-36493","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-32511","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32513","kind":"heading","level":2,"spans":[{"id":"spn-36494","text":"Context"}]},{"id":"blk-32514","kind":"paragraph","spans":[{"id":"spn-36495","text":"webhost.systems is a multi-runtime AI agent platform. For each invocation executed in the data plane (Cloudflare Workers/DO or AWS Bedrock AgentCore), the platform must record usage and operational telemetry for:"}]},{"id":"blk-32515","items":[{"blocks":[{"id":"blk-32517","kind":"paragraph","spans":[{"id":"spn-36496","text":"plan enforcement (requests/tokens/compute limits),"}]}],"id":"blk-32516","kind":"list-item"},{"blocks":[{"id":"blk-32519","kind":"paragraph","spans":[{"id":"spn-36497","text":"cost estimation (v1: estimated cost),"}]}],"id":"blk-32518","kind":"list-item"},{"blocks":[{"id":"blk-32521","kind":"paragraph","spans":[{"id":"spn-36498","text":"billing integrity (tier gating and upgrade flows),"}]}],"id":"blk-32520","kind":"list-item"},{"blocks":[{"id":"blk-32523","kind":"paragraph","spans":[{"id":"spn-36499","text":"observability (error rates, latency/compute, tool usage),"}]}],"id":"blk-32522","kind":"list-item"},{"blocks":[{"id":"blk-32525","kind":"paragraph","spans":[{"id":"spn-36500","text":"audits and support (traceability via "},{"id":"spn-36501","marks":["code"],"text":"traceId"},{"id":"spn-36502","text":", deploy version, runtime)."}]}],"id":"blk-32524","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32526","kind":"paragraph","spans":[{"id":"spn-36503","text":"Telemetry is consumed by the control plane and stored as append-only raw events ("},{"id":"spn-36504","marks":["code"],"text":"metricsEvents"},{"id":"spn-36505","text":") and aggregated views ("},{"id":"spn-36506","marks":["code"],"text":"billingUsage"},{"id":"spn-36507","text":")."}]},{"id":"blk-32527","kind":"heading","level":3,"spans":[{"id":"spn-36508","text":"Problem statement"}]},{"id":"blk-32528","kind":"paragraph","spans":[{"id":"spn-36509","text":"Telemetry is a critical security and business integrity surface. If telemetry is spoofable or not attributable, an attacker (or buggy runtime) could:"}]},{"id":"blk-32529","items":[{"blocks":[{"id":"blk-32531","kind":"paragraph","spans":[{"id":"spn-36510","text":"underreport usage to avoid limits or billing,"}]}],"id":"blk-32530","kind":"list-item"},{"blocks":[{"id":"blk-32533","kind":"paragraph","spans":[{"id":"spn-36511","text":"overreport usage to sabotage another tenant,"}]}],"id":"blk-32532","kind":"list-item"},{"blocks":[{"id":"blk-32535","kind":"paragraph","spans":[{"id":"spn-36512","text":"inject events for another tenant’s agents/deployments,"}]}],"id":"blk-32534","kind":"list-item"},{"blocks":[{"id":"blk-32537","kind":"paragraph","spans":[{"id":"spn-36513","text":"create ambiguity in chargeback attribution across runtimes,"}]}],"id":"blk-32536","kind":"list-item"},{"blocks":[{"id":"blk-32539","kind":"paragraph","spans":[{"id":"spn-36514","text":"break observability and incident response."}]}],"id":"blk-32538","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32540","kind":"paragraph","spans":[{"id":"spn-36515","text":"Therefore telemetry ingestion must ensure:"}]},{"id":"blk-32541","kind":"paragraph","spans":[{"id":"spn-36516","text":"1. "},{"id":"spn-36517","marks":["bold"],"text":"Integrity"},{"id":"spn-36518","text":": payload not tampered in transit. 2. "},{"id":"spn-36519","marks":["bold"],"text":"Authenticity"},{"id":"spn-36520","text":": sender is an authorized runtime deployment. 3. "},{"id":"spn-36521","marks":["bold"],"text":"Attribution"},{"id":"spn-36522","text":": event belongs to exactly one "},{"id":"spn-36523","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-36524","text":". 4. "},{"id":"spn-36525","marks":["bold"],"text":"Replay safety"},{"id":"spn-36526","text":": retries do not double count; attackers cannot re-submit old events to alter usage. 5. "},{"id":"spn-36527","marks":["bold"],"text":"No secrets leakage"},{"id":"spn-36528","text":": telemetry must never include secret values, and telemetry auth secrets must not be stored as plaintext."}]},{"id":"blk-32542","kind":"paragraph","spans":[{"id":"spn-36529","text":"Constraints:"}]},{"id":"blk-32543","items":[{"blocks":[{"id":"blk-32545","kind":"paragraph","spans":[{"id":"spn-36530","text":"Data plane runtimes are heterogeneous and may differ in what usage details they can report."}]}],"id":"blk-32544","kind":"list-item"},{"blocks":[{"id":"blk-32547","kind":"paragraph","spans":[{"id":"spn-36531","text":"Customer agent code is untrusted; it may attempt to forge telemetry or call arbitrary endpoints."}]}],"id":"blk-32546","kind":"list-item"},{"blocks":[{"id":"blk-32549","kind":"paragraph","spans":[{"id":"spn-36532","text":"Telemetry ingestion must not rely on browser sessions/cookies."}]}],"id":"blk-32548","kind":"list-item"},{"blocks":[{"id":"blk-32551","kind":"paragraph","spans":[{"id":"spn-36533","text":"The system must remain implementable for v1 without introducing a full centralized vault or complex PKI."}]}],"id":"blk-32550","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32552","kind":"heading","level":2,"spans":[{"id":"spn-36534","text":"Decision"}]},{"id":"blk-32553","kind":"paragraph","spans":[{"id":"spn-36535","text":"Adopt a "},{"id":"spn-36536","marks":["bold"],"text":"deployment-scoped signed telemetry event"},{"id":"spn-36537","text":" model with "},{"id":"spn-36538","marks":["bold"],"text":"ownership cross-checking"},{"id":"spn-36539","text":" at ingestion."}]},{"id":"blk-32554","kind":"heading","level":3,"spans":[{"id":"spn-36540","text":"Decision summary (normative)"}]},{"id":"blk-32555","kind":"paragraph","spans":[{"id":"spn-36541","text":"1. "},{"id":"spn-36542","marks":["bold"],"text":"Attribution is mandatory"},{"id":"spn-36543","text":" Every telemetry event MUST be attributable to:"}]},{"id":"blk-32556","items":[{"blocks":[{"id":"blk-32558","kind":"paragraph","spans":[{"id":"spn-36544","marks":["code"],"text":"userId"}]}],"id":"blk-32557","kind":"list-item"},{"blocks":[{"id":"blk-32560","kind":"paragraph","spans":[{"id":"spn-36545","marks":["code"],"text":"agentId"}]}],"id":"blk-32559","kind":"list-item"},{"blocks":[{"id":"blk-32562","kind":"paragraph","spans":[{"id":"spn-36546","marks":["code"],"text":"deploymentId"}]}],"id":"blk-32561","kind":"list-item"},{"blocks":[{"id":"blk-32564","kind":"paragraph","spans":[{"id":"spn-36547","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-32563","kind":"list-item"},{"blocks":[{"id":"blk-32566","kind":"paragraph","spans":[{"id":"spn-36548","marks":["code"],"text":"timestamp"}]}],"id":"blk-32565","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32567","kind":"paragraph","spans":[{"id":"spn-36549","text":"2. "},{"id":"spn-36550","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped HMAC signatures (v1)"}]},{"id":"blk-32568","items":[{"blocks":[{"id":"blk-32570","kind":"paragraph","spans":[{"id":"spn-36551","text":"Each deployment has a unique "},{"id":"spn-36552","marks":["code"],"text":"telemetrySecret"},{"id":"spn-36553","text":" (HMAC key), generated by the control plane."}]}],"id":"blk-32569","kind":"list-item"},{"blocks":[{"id":"blk-32572","kind":"paragraph","spans":[{"id":"spn-36554","text":"The "},{"id":"spn-36555","marks":["code"],"text":"telemetrySecret"},{"id":"spn-36556","text":" is injected into the deployed runtime using provider secret mechanisms."}]}],"id":"blk-32571","kind":"list-item"},{"blocks":[{"id":"blk-32574","kind":"paragraph","spans":[{"id":"spn-36557","text":"Data plane submits telemetry to the control plane ingestion endpoint with:"}]}],"id":"blk-32573","kind":"list-item"},{"blocks":[{"id":"blk-32576","kind":"paragraph","spans":[{"id":"spn-36558","text":"header "},{"id":"spn-36559","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-32575","kind":"list-item"},{"blocks":[{"id":"blk-32578","kind":"paragraph","spans":[{"id":"spn-36560","text":"header "},{"id":"spn-36561","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex(hmac_sha256(raw_body_bytes, telemetrySecret))>"}]}],"id":"blk-32577","kind":"list-item"},{"blocks":[{"id":"blk-32580","kind":"paragraph","spans":[{"id":"spn-36562","text":"Control plane verifies:"}]}],"id":"blk-32579","kind":"list-item"},{"blocks":[{"id":"blk-32582","kind":"paragraph","spans":[{"id":"spn-36563","text":"signature validity (using deployment-scoped secret reference),"}]}],"id":"blk-32581","kind":"list-item"},{"blocks":[{"id":"blk-32584","kind":"paragraph","spans":[{"id":"spn-36564","text":"ownership mapping: deployment belongs to the agent and user in the payload,"}]}],"id":"blk-32583","kind":"list-item"},{"blocks":[{"id":"blk-32586","kind":"paragraph","spans":[{"id":"spn-36565","text":"required fields and enums."}]}],"id":"blk-32585","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32587","kind":"paragraph","spans":[{"id":"spn-36566","text":"3. "},{"id":"spn-36567","marks":["bold"],"text":"Ingestion performs ownership cross-check (defense in depth)"},{"id":"spn-36568","text":" After signature validation, ingestion MUST query control plane data and verify:"}]},{"id":"blk-32588","items":[{"blocks":[{"id":"blk-32590","kind":"paragraph","spans":[{"id":"spn-36569","marks":["code"],"text":"deployments._id == deploymentId"}]}],"id":"blk-32589","kind":"list-item"},{"blocks":[{"id":"blk-32592","kind":"paragraph","spans":[{"id":"spn-36570","marks":["code"],"text":"deployments.agentId == agentId"}]}],"id":"blk-32591","kind":"list-item"},{"blocks":[{"id":"blk-32594","kind":"paragraph","spans":[{"id":"spn-36571","marks":["code"],"text":"deployments.userId == userId"}]}],"id":"blk-32593","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32595","kind":"paragraph","spans":[{"id":"spn-36572","text":"If any mismatch: reject the event, optionally record an "},{"id":"spn-36573","marks":["code"],"text":"auditLog"},{"id":"spn-36574","text":" entry with sanitized details."}]},{"id":"blk-32596","kind":"paragraph","spans":[{"id":"spn-36575","text":"4. "},{"id":"spn-36576","marks":["bold"],"text":"Telemetry does not use user auth"},{"id":"spn-36577","text":" Telemetry ingestion MUST NOT accept browser session cookies as authentication. Telemetry is authenticated solely by deployment-scoped signature (and optional anti-replay)."}]},{"id":"blk-32597","kind":"paragraph","spans":[{"id":"spn-36578","text":"5. "},{"id":"spn-36579","marks":["bold"],"text":"Replay/dedupe (recommended in v1; mandatory before public invocations)"},{"id":"spn-36580","text":" Telemetry ingestion SHOULD implement one of:"}]},{"id":"blk-32598","items":[{"blocks":[{"id":"blk-32600","kind":"paragraph","spans":[{"id":"spn-36581","marks":["code"],"text":"eventId"},{"id":"spn-36582","text":" (UUID generated by data plane) + short-window dedupe store, OR"}]}],"id":"blk-32599","kind":"list-item"},{"blocks":[{"id":"blk-32602","kind":"paragraph","spans":[{"id":"spn-36583","text":"dedupe on "},{"id":"spn-36584","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-36585","text":" if "},{"id":"spn-36586","marks":["code"],"text":"traceId"},{"id":"spn-36587","text":" uniqueness per invocation is guaranteed."}]}],"id":"blk-32601","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32603","kind":"paragraph","spans":[{"id":"spn-36588","text":"In either case, ingestion must be idempotent under retries to prevent double counting."}]},{"id":"blk-32604","kind":"paragraph","spans":[{"id":"spn-36589","text":"6. "},{"id":"spn-36590","marks":["bold"],"text":"Secrets are never stored as plaintext in the primary DB"}]},{"id":"blk-32605","items":[{"blocks":[{"id":"blk-32607","kind":"paragraph","spans":[{"id":"spn-36591","text":"The primary DB stores only metadata and secret references (e.g., provider secret name/id)."}]}],"id":"blk-32606","kind":"list-item"},{"blocks":[{"id":"blk-32609","kind":"paragraph","spans":[{"id":"spn-36592","text":"The "},{"id":"spn-36593","marks":["code"],"text":"telemetrySecret"},{"id":"spn-36594","text":" value MUST NOT be stored in plaintext in the primary database (Supabase)."}]}],"id":"blk-32608","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32610","kind":"heading","level":3,"spans":[{"id":"spn-36595","text":"Provider-specific telemetry capabilities (implementation guidance)"}]},{"id":"blk-32611","kind":"paragraph","spans":[{"id":"spn-36596","text":"This ADR standardizes telemetry ingestion on "},{"id":"spn-36597","marks":["bold"],"text":"deployment-scoped signed events"},{"id":"spn-36598","text":" for all runtimes. Provider capabilities vary, but the v1 baseline remains consistent."}]},{"id":"blk-32612","kind":"paragraph","spans":[{"id":"spn-36599","marks":["bold"],"text":"Cloudflare (Workers + Durable Objects):"}]},{"id":"blk-32613","items":[{"blocks":[{"id":"blk-32615","kind":"paragraph","spans":[{"id":"spn-36600","text":"The runtime MUST explicitly emit telemetry to the control plane (Pattern A: in-workload emission is the preferred approach)."}]}],"id":"blk-32614","kind":"list-item"},{"blocks":[{"id":"blk-32617","kind":"paragraph","spans":[{"id":"spn-36601","text":"The telemetry signing secret is injected via Worker secret bindings."}]}],"id":"blk-32616","kind":"list-item"},{"blocks":[{"id":"blk-32619","kind":"paragraph","spans":[{"id":"spn-36602","text":"The Worker/DO submits "},{"id":"spn-36603","marks":["code"],"text":"POST /v1/telemetry/report"},{"id":"spn-36604","text":" with "},{"id":"spn-36605","marks":["code"],"text":"X-Telemetry-Deployment-Id"},{"id":"spn-36606","text":" and "},{"id":"spn-36607","marks":["code"],"text":"X-Telemetry-Signature"},{"id":"spn-36608","text":"."}]}],"id":"blk-32618","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32620","kind":"paragraph","spans":[{"id":"spn-36609","marks":["bold"],"text":"AgentCore (AWS Bedrock AgentCore):"}]},{"id":"blk-32621","items":[{"blocks":[{"id":"blk-32623","kind":"paragraph","spans":[{"id":"spn-36610","text":"AgentCore may provide provider-native observability capabilities (e.g., service-level telemetry/OTel-style integrations) that can be valuable for deep debugging."}]}],"id":"blk-32622","kind":"list-item"},{"blocks":[{"id":"blk-32625","kind":"paragraph","spans":[{"id":"spn-36611","marks":["bold"],"text":"v1 baseline:"},{"id":"spn-36612","text":" use the same direct signed submission model as Cloudflare (either in-workload emission when feasible, or adapter-side emission when required by provider constraints) to keep metering, limits, and billing semantics consistent across runtimes."}]}],"id":"blk-32624","kind":"list-item"},{"blocks":[{"id":"blk-32627","kind":"paragraph","spans":[{"id":"spn-36613","marks":["bold"],"text":"post-v1 enhancement:"},{"id":"spn-36614","text":" integrate provider-native observability for richer traces while still emitting the normalized, signed metering event used for billing and limits."}]}],"id":"blk-32626","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32628","kind":"heading","level":2,"spans":[{"id":"spn-36615","text":"Rationale"}]},{"id":"blk-32629","kind":"paragraph","spans":[{"id":"spn-36616","text":"This approach satisfies the requirements with minimal complexity:"}]},{"id":"blk-32630","items":[{"blocks":[{"id":"blk-32632","kind":"paragraph","spans":[{"id":"spn-36617","marks":["bold"],"text":"Integrity and authenticity"},{"id":"spn-36618","text":": HMAC signatures prevent tampering and authenticate possession of a deployment-scoped secret."}]}],"id":"blk-32631","kind":"list-item"},{"blocks":[{"id":"blk-32634","kind":"paragraph","spans":[{"id":"spn-36619","marks":["bold"],"text":"Tenant protection"},{"id":"spn-36620","text":": ownership cross-check prevents a compromised deployment secret from being used to write events for a different agent or user."}]}],"id":"blk-32633","kind":"list-item"},{"blocks":[{"id":"blk-32636","kind":"paragraph","spans":[{"id":"spn-36621","marks":["bold"],"text":"Least privilege"},{"id":"spn-36622","text":": deployment-scoped secret limits blast radius if compromised."}]}],"id":"blk-32635","kind":"list-item"},{"blocks":[{"id":"blk-32638","kind":"paragraph","spans":[{"id":"spn-36623","marks":["bold"],"text":"Provider portability"},{"id":"spn-36624","text":": works across runtimes because it relies on a generic “can send HTTP + store secret” capability."}]}],"id":"blk-32637","kind":"list-item"},{"blocks":[{"id":"blk-32640","kind":"paragraph","spans":[{"id":"spn-36625","marks":["bold"],"text":"Operable MVP"},{"id":"spn-36626","text":": avoids the need for PKI or an always-online centralized vault, while still enabling strong guarantees."}]}],"id":"blk-32639","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32641","kind":"heading","level":2,"spans":[{"id":"spn-36627","text":"Alternatives considered"}]},{"id":"blk-32642","kind":"heading","level":3,"spans":[{"id":"spn-36628","text":"A) Trust telemetry without signatures (reject)"}]},{"id":"blk-32643","kind":"paragraph","spans":[{"id":"spn-36629","marks":["bold"],"text":"Pros"}]},{"id":"blk-32644","items":[{"blocks":[{"id":"blk-32646","kind":"paragraph","spans":[{"id":"spn-36630","text":"Easiest to implement."}]}],"id":"blk-32645","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32647","kind":"paragraph","spans":[{"id":"spn-36631","marks":["bold"],"text":"Cons"}]},{"id":"blk-32648","items":[{"blocks":[{"id":"blk-32650","kind":"paragraph","spans":[{"id":"spn-36632","text":"Enables trivial spoofing and billing manipulation."}]}],"id":"blk-32649","kind":"list-item"},{"blocks":[{"id":"blk-32652","kind":"paragraph","spans":[{"id":"spn-36633","text":"Allows cross-tenant sabotage and incorrect usage enforcement."}]}],"id":"blk-32651","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32653","kind":"paragraph","spans":[{"id":"spn-36634","marks":["bold"],"text":"Decision"},{"id":"spn-36635","text":" Rejected. Not acceptable for any paid system with limits and billing."}]},{"id":"blk-32654","kind":"heading","level":3,"spans":[{"id":"spn-36636","text":"B) Adapter-side telemetry only (partial alternative)"}]},{"id":"blk-32655","kind":"paragraph","spans":[{"id":"spn-36637","text":"Telemetry is emitted only by the control plane adapter after it receives provider responses."}]},{"id":"blk-32656","kind":"paragraph","spans":[{"id":"spn-36638","marks":["bold"],"text":"Pros"}]},{"id":"blk-32657","items":[{"blocks":[{"id":"blk-32659","kind":"paragraph","spans":[{"id":"spn-36639","text":"Avoids injecting telemetry secrets into runtime code."}]}],"id":"blk-32658","kind":"list-item"},{"blocks":[{"id":"blk-32661","kind":"paragraph","spans":[{"id":"spn-36640","text":"Avoids runtime outbound call to control plane."}]}],"id":"blk-32660","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32662","kind":"paragraph","spans":[{"id":"spn-36641","marks":["bold"],"text":"Cons"}]},{"id":"blk-32663","items":[{"blocks":[{"id":"blk-32665","kind":"paragraph","spans":[{"id":"spn-36642","text":"Often cannot capture provider-specific usage (compute/tool usage) reliably."}]}],"id":"blk-32664","kind":"list-item"},{"blocks":[{"id":"blk-32667","kind":"paragraph","spans":[{"id":"spn-36643","text":"Creates attribution gaps if invocations happen outside the adapter path or if provider returns incomplete usage."}]}],"id":"blk-32666","kind":"list-item"},{"blocks":[{"id":"blk-32669","kind":"paragraph","spans":[{"id":"spn-36644","text":"Weakens correlation with runtime events and can undercount."}]}],"id":"blk-32668","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32670","kind":"paragraph","spans":[{"id":"spn-36645","marks":["bold"],"text":"Decision"},{"id":"spn-36646","text":" Not the primary model. Allowed as a constrained fallback if a provider cannot support in-workload emission, but must preserve integrity and attribution. If adapter emits, it must still attach to a deployment and enforce ownership; it must not be forgeable by clients."}]},{"id":"blk-32671","kind":"heading","level":3,"spans":[{"id":"spn-36647","text":"C) Per-user telemetry keys (reject)"}]},{"id":"blk-32672","kind":"paragraph","spans":[{"id":"spn-36648","text":"Use one key per user shared across all deployments."}]},{"id":"blk-32673","kind":"paragraph","spans":[{"id":"spn-36649","marks":["bold"],"text":"Pros"}]},{"id":"blk-32674","items":[{"blocks":[{"id":"blk-32676","kind":"paragraph","spans":[{"id":"spn-36650","text":"Fewer secrets."}]}],"id":"blk-32675","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32677","kind":"paragraph","spans":[{"id":"spn-36651","marks":["bold"],"text":"Cons"}]},{"id":"blk-32678","items":[{"blocks":[{"id":"blk-32680","kind":"paragraph","spans":[{"id":"spn-36652","text":"Massive blast radius if compromised; compromised deployment can spoof across all user deployments."}]}],"id":"blk-32679","kind":"list-item"},{"blocks":[{"id":"blk-32682","kind":"paragraph","spans":[{"id":"spn-36653","text":"Harder to rotate safely and isolate issues."}]}],"id":"blk-32681","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32683","kind":"paragraph","spans":[{"id":"spn-36654","marks":["bold"],"text":"Decision"},{"id":"spn-36655","text":" Rejected. Deployment-scoped keys are safer and align with immutability and auditability."}]},{"id":"blk-32684","kind":"heading","level":3,"spans":[{"id":"spn-36656","text":"D) Public-key signatures (PKI) per deployment (defer)"}]},{"id":"blk-32685","kind":"paragraph","spans":[{"id":"spn-36657","text":"Each deployment gets a keypair; telemetry signed with private key, verified with public key."}]},{"id":"blk-32686","kind":"paragraph","spans":[{"id":"spn-36658","marks":["bold"],"text":"Pros"}]},{"id":"blk-32687","items":[{"blocks":[{"id":"blk-32689","kind":"paragraph","spans":[{"id":"spn-36659","text":"No shared secret at ingestion; avoids secret distribution to verifier."}]}],"id":"blk-32688","kind":"list-item"},{"blocks":[{"id":"blk-32691","kind":"paragraph","spans":[{"id":"spn-36660","text":"Strong cryptographic model."}]}],"id":"blk-32690","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32692","kind":"paragraph","spans":[{"id":"spn-36661","marks":["bold"],"text":"Cons"}]},{"id":"blk-32693","items":[{"blocks":[{"id":"blk-32695","kind":"paragraph","spans":[{"id":"spn-36662","text":"Adds key management complexity; still needs secure private key injection to runtime."}]}],"id":"blk-32694","kind":"list-item"},{"blocks":[{"id":"blk-32697","kind":"paragraph","spans":[{"id":"spn-36663","text":"Higher implementation overhead for v1 without clear ROI."}]}],"id":"blk-32696","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32698","kind":"paragraph","spans":[{"id":"spn-36664","marks":["bold"],"text":"Decision"},{"id":"spn-36665","text":" Deferred. Consider post-v1 if you need stronger non-repudiation or third-party verification."}]},{"id":"blk-32699","kind":"heading","level":3,"spans":[{"id":"spn-36666","text":"E) mTLS between data plane and control plane (defer)"}]},{"id":"blk-32700","kind":"paragraph","spans":[{"id":"spn-36667","text":"Use mutual TLS with client certs per deployment."}]},{"id":"blk-32701","kind":"paragraph","spans":[{"id":"spn-36668","marks":["bold"],"text":"Pros"}]},{"id":"blk-32702","items":[{"blocks":[{"id":"blk-32704","kind":"paragraph","spans":[{"id":"spn-36669","text":"Strong channel-level authentication."}]}],"id":"blk-32703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32705","kind":"paragraph","spans":[{"id":"spn-36670","marks":["bold"],"text":"Cons"}]},{"id":"blk-32706","items":[{"blocks":[{"id":"blk-32708","kind":"paragraph","spans":[{"id":"spn-36671","text":"Operationally heavy; certificate issuance/rotation complexity."}]}],"id":"blk-32707","kind":"list-item"},{"blocks":[{"id":"blk-32710","kind":"paragraph","spans":[{"id":"spn-36672","text":"Hard to implement uniformly across runtimes."}]}],"id":"blk-32709","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32711","kind":"paragraph","spans":[{"id":"spn-36673","marks":["bold"],"text":"Decision"},{"id":"spn-36674","text":" Deferred. Potential future hardening for enterprise tiers."}]},{"id":"blk-32712","kind":"heading","level":2,"spans":[{"id":"spn-36675","text":"Detailed design (normative)"}]},{"id":"blk-32713","kind":"heading","level":3,"spans":[{"id":"spn-36676","text":"1) Telemetry event schema (minimum viable)"}]},{"id":"blk-32714","kind":"paragraph","spans":[{"id":"spn-36677","text":"Telemetry payload MUST include:"}]},{"id":"blk-32715","items":[{"blocks":[{"id":"blk-32717","kind":"paragraph","spans":[{"id":"spn-36678","marks":["code"],"text":"userId"},{"id":"spn-36679","text":" (internal id)"}]}],"id":"blk-32716","kind":"list-item"},{"blocks":[{"id":"blk-32719","kind":"paragraph","spans":[{"id":"spn-36680","marks":["code"],"text":"agentId"}]}],"id":"blk-32718","kind":"list-item"},{"blocks":[{"id":"blk-32721","kind":"paragraph","spans":[{"id":"spn-36681","marks":["code"],"text":"deploymentId"}]}],"id":"blk-32720","kind":"list-item"},{"blocks":[{"id":"blk-32723","kind":"paragraph","spans":[{"id":"spn-36682","marks":["code"],"text":"runtimeProvider"},{"id":"spn-36683","text":" ("},{"id":"spn-36684","marks":["code"],"text":"cloudflare"},{"id":"spn-36685","text":" | "},{"id":"spn-36686","marks":["code"],"text":"agentcore"},{"id":"spn-36687","text":")"}]}],"id":"blk-32722","kind":"list-item"},{"blocks":[{"id":"blk-32725","kind":"paragraph","spans":[{"id":"spn-36688","marks":["code"],"text":"timestamp"},{"id":"spn-36689","text":" (RFC3339 or unix ms; ingestion converts to unix ms)"}]}],"id":"blk-32724","kind":"list-item"},{"blocks":[{"id":"blk-32727","kind":"paragraph","spans":[{"id":"spn-36690","marks":["code"],"text":"requests"},{"id":"spn-36691","text":" (typically 1)"}]}],"id":"blk-32726","kind":"list-item"},{"blocks":[{"id":"blk-32729","kind":"paragraph","spans":[{"id":"spn-36692","marks":["code"],"text":"llmTokens"},{"id":"spn-36693","text":" (reported or estimated)"}]}],"id":"blk-32728","kind":"list-item"},{"blocks":[{"id":"blk-32731","kind":"paragraph","spans":[{"id":"spn-36694","marks":["code"],"text":"computeMs"},{"id":"spn-36695","text":" (wall time or billed time, defined per provider)"}]}],"id":"blk-32730","kind":"list-item"},{"blocks":[{"id":"blk-32733","kind":"paragraph","spans":[{"id":"spn-36696","marks":["code"],"text":"errors"},{"id":"spn-36697","text":" (0/1 typical)"}]}],"id":"blk-32732","kind":"list-item"},{"blocks":[{"id":"blk-32735","kind":"paragraph","spans":[{"id":"spn-36698","marks":["code"],"text":"errorClass"},{"id":"spn-36699","text":" (optional: "},{"id":"spn-36700","marks":["code"],"text":"auth | limit | runtime | tool | unknown"},{"id":"spn-36701","text":")"}]}],"id":"blk-32734","kind":"list-item"},{"blocks":[{"id":"blk-32737","kind":"paragraph","spans":[{"id":"spn-36702","marks":["code"],"text":"costUsdEstimated"}]}],"id":"blk-32736","kind":"list-item"},{"blocks":[{"id":"blk-32739","kind":"paragraph","spans":[{"id":"spn-36703","marks":["code"],"text":"traceId"},{"id":"spn-36704","text":" (optional but recommended)"}]}],"id":"blk-32738","kind":"list-item"},{"blocks":[{"id":"blk-32741","kind":"paragraph","spans":[{"id":"spn-36705","marks":["code"],"text":"provider"},{"id":"spn-36706","text":" (optional runtime-specific counters)"}]}],"id":"blk-32740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32742","kind":"paragraph","spans":[{"id":"spn-36707","text":"Telemetry MUST NOT include:"}]},{"id":"blk-32743","items":[{"blocks":[{"id":"blk-32745","kind":"paragraph","spans":[{"id":"spn-36708","text":"plaintext secrets,"}]}],"id":"blk-32744","kind":"list-item"},{"blocks":[{"id":"blk-32747","kind":"paragraph","spans":[{"id":"spn-36709","text":"full prompts/responses by default (unless an explicit opt-in feature is added later),"}]}],"id":"blk-32746","kind":"list-item"},{"blocks":[{"id":"blk-32749","kind":"paragraph","spans":[{"id":"spn-36710","text":"raw provider credential material."}]}],"id":"blk-32748","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32750","kind":"heading","level":3,"spans":[{"id":"spn-36711","text":"2) Signature computation"}]},{"id":"blk-32751","items":[{"blocks":[{"id":"blk-32753","kind":"paragraph","spans":[{"id":"spn-36712","text":"Signature is computed over the exact raw request body bytes as received/sent."}]}],"id":"blk-32752","kind":"list-item"},{"blocks":[{"id":"blk-32755","kind":"paragraph","spans":[{"id":"spn-36713","text":"Algorithm: "},{"id":"spn-36714","marks":["code"],"text":"HMAC_SHA256(telemetrySecret, raw_body_bytes)"},{"id":"spn-36715","text":"."}]}],"id":"blk-32754","kind":"list-item"},{"blocks":[{"id":"blk-32757","kind":"paragraph","spans":[{"id":"spn-36716","text":"Encoding: hex lowercase recommended."}]}],"id":"blk-32756","kind":"list-item"},{"blocks":[{"id":"blk-32759","kind":"paragraph","spans":[{"id":"spn-36717","text":"Header format: "},{"id":"spn-36718","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex>"},{"id":"spn-36719","text":"."}]}],"id":"blk-32758","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32760","kind":"paragraph","spans":[{"id":"spn-36720","text":"Canonicalization note:"}]},{"id":"blk-32761","items":[{"blocks":[{"id":"blk-32763","kind":"paragraph","spans":[{"id":"spn-36721","text":"The verifier MUST use the raw body bytes, not a re-serialized JSON object."}]}],"id":"blk-32762","kind":"list-item"},{"blocks":[{"id":"blk-32765","kind":"paragraph","spans":[{"id":"spn-36722","text":"If your framework modifies request bodies, capture raw bytes before parsing."}]}],"id":"blk-32764","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32766","kind":"heading","level":3,"spans":[{"id":"spn-36723","text":"3) Ingestion validation steps (MUST)"}]},{"id":"blk-32767","kind":"paragraph","spans":[{"id":"spn-36724","text":"In order: 1. Read "},{"id":"spn-36725","marks":["code"],"text":"deploymentId"},{"id":"spn-36726","text":" header and locate deployment record. 2. Fetch deployment-scoped secret reference and verify signature. 3. Parse JSON body and validate required fields and enums. 4. Ownership cross-check:"}]},{"id":"blk-32768","items":[{"blocks":[{"id":"blk-32770","kind":"paragraph","spans":[{"id":"spn-36727","marks":["code"],"text":"deployments.userId == body.userId"}]}],"id":"blk-32769","kind":"list-item"},{"blocks":[{"id":"blk-32772","kind":"paragraph","spans":[{"id":"spn-36728","marks":["code"],"text":"deployments.agentId == body.agentId"}]}],"id":"blk-32771","kind":"list-item"},{"blocks":[{"id":"blk-32774","kind":"paragraph","spans":[{"id":"spn-36729","marks":["code"],"text":"deployments._id == body.deploymentId"},{"id":"spn-36730","text":" (or match header)"}]}],"id":"blk-32773","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32775","kind":"paragraph","spans":[{"id":"spn-36731","text":"5. Dedupe/idempotency:"}]},{"id":"blk-32776","items":[{"blocks":[{"id":"blk-32778","kind":"paragraph","spans":[{"id":"spn-36732","text":"if "},{"id":"spn-36733","marks":["code"],"text":"eventId"},{"id":"spn-36734","text":" used: reject or no-op if already processed in dedupe window"}]}],"id":"blk-32777","kind":"list-item"},{"blocks":[{"id":"blk-32780","kind":"paragraph","spans":[{"id":"spn-36735","text":"if "},{"id":"spn-36736","marks":["code"],"text":"traceId"},{"id":"spn-36737","text":" used: ensure uniqueness per "},{"id":"spn-36738","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-36739","text":" in dedupe window"}]}],"id":"blk-32779","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32781","kind":"paragraph","spans":[{"id":"spn-36740","text":"6. Persist event append-only. 7. Optionally update incremental counters."}]},{"id":"blk-32782","kind":"paragraph","spans":[{"id":"spn-36741","text":"If any step fails:"}]},{"id":"blk-32783","items":[{"blocks":[{"id":"blk-32785","kind":"paragraph","spans":[{"id":"spn-36742","text":"respond with normalized error (for non-telemetry callers, keep generic),"}]}],"id":"blk-32784","kind":"list-item"},{"blocks":[{"id":"blk-32787","kind":"paragraph","spans":[{"id":"spn-36743","text":"DO NOT reveal secret or internal details,"}]}],"id":"blk-32786","kind":"list-item"},{"blocks":[{"id":"blk-32789","kind":"paragraph","spans":[{"id":"spn-36744","text":"optionally write a sanitized "},{"id":"spn-36745","marks":["code"],"text":"auditLog"},{"id":"spn-36746","text":" entry for investigation."}]}],"id":"blk-32788","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32790","kind":"heading","level":3,"spans":[{"id":"spn-36747","text":"4) Secret generation and rotation"}]},{"id":"blk-32791","items":[{"blocks":[{"id":"blk-32793","kind":"paragraph","spans":[{"id":"spn-36748","text":"Generate a new telemetry secret on every new deployment by default."}]}],"id":"blk-32792","kind":"list-item"},{"blocks":[{"id":"blk-32795","kind":"paragraph","spans":[{"id":"spn-36749","text":"Inject the secret into the runtime provider as a secret (not as plain env var stored in DB)."}]}],"id":"blk-32794","kind":"list-item"},{"blocks":[{"id":"blk-32797","kind":"paragraph","spans":[{"id":"spn-36750","text":"Rotation policy:"}]}],"id":"blk-32796","kind":"list-item"},{"blocks":[{"id":"blk-32799","kind":"paragraph","spans":[{"id":"spn-36751","text":"New deployment => new telemetry secret (mandatory)."}]}],"id":"blk-32798","kind":"list-item"},{"blocks":[{"id":"blk-32801","kind":"paragraph","spans":[{"id":"spn-36752","text":"Old deployments retain old secret for the duration they might emit telemetry (but they should not emit after deactivation, except in-flight retries)."}]}],"id":"blk-32800","kind":"list-item"},{"blocks":[{"id":"blk-32803","kind":"paragraph","spans":[{"id":"spn-36753","text":"Keep verification capability for a bounded time window after deactivation to allow late telemetry retries."}]}],"id":"blk-32802","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32804","kind":"heading","level":3,"spans":[{"id":"spn-36754","text":"5) Telemetry retries and ingestion availability"}]},{"id":"blk-32805","items":[{"blocks":[{"id":"blk-32807","kind":"paragraph","spans":[{"id":"spn-36755","text":"Data plane SHOULD retry telemetry submission with exponential backoff (bounded)."}]}],"id":"blk-32806","kind":"list-item"},{"blocks":[{"id":"blk-32809","kind":"paragraph","spans":[{"id":"spn-36756","text":"Data plane SHOULD NOT block user-visible invocation completion while retrying telemetry."}]}],"id":"blk-32808","kind":"list-item"},{"blocks":[{"id":"blk-32811","kind":"paragraph","spans":[{"id":"spn-36757","text":"Control plane SHOULD expose internal health metrics for telemetry ingestion rate and rejection counts."}]}],"id":"blk-32810","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32812","kind":"heading","level":2,"spans":[{"id":"spn-36758","text":"Consequences"}]},{"id":"blk-32813","kind":"heading","level":3,"spans":[{"id":"spn-36759","text":"Positive"}]},{"id":"blk-32814","items":[{"blocks":[{"id":"blk-32816","kind":"paragraph","spans":[{"id":"spn-36760","text":"Strong billing and limits integrity foundation."}]}],"id":"blk-32815","kind":"list-item"},{"blocks":[{"id":"blk-32818","kind":"paragraph","spans":[{"id":"spn-36761","text":"Provider-agnostic design that scales to new runtimes."}]}],"id":"blk-32817","kind":"list-item"},{"blocks":[{"id":"blk-32820","kind":"paragraph","spans":[{"id":"spn-36762","text":"Reduced blast radius via deployment-scoped secrets."}]}],"id":"blk-32819","kind":"list-item"},{"blocks":[{"id":"blk-32822","kind":"paragraph","spans":[{"id":"spn-36763","text":"Clear audit path for telemetry failures and spoof attempts."}]}],"id":"blk-32821","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32823","kind":"heading","level":3,"spans":[{"id":"spn-36764","text":"Negative / tradeoffs"}]},{"id":"blk-32824","items":[{"blocks":[{"id":"blk-32826","kind":"paragraph","spans":[{"id":"spn-36765","text":"Requires deploying a telemetry secret per deployment and managing injection per provider."}]}],"id":"blk-32825","kind":"list-item"},{"blocks":[{"id":"blk-32828","kind":"paragraph","spans":[{"id":"spn-36766","text":"Requires careful handling of raw request bytes for correct signature verification."}]}],"id":"blk-32827","kind":"list-item"},{"blocks":[{"id":"blk-32830","kind":"paragraph","spans":[{"id":"spn-36767","text":"Adds complexity to runtime code (Pattern A emission) or to adapters (Pattern B emission)."}]}],"id":"blk-32829","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32831","kind":"heading","level":2,"spans":[{"id":"spn-36768","text":"Implementation requirements (checklist)"}]},{"id":"blk-32832","items":[{"blocks":[{"id":"blk-32834","kind":"paragraph","spans":[{"id":"spn-36769","text":"[ ] Each deployment has a telemetry signing secret generated by the control plane."}]}],"id":"blk-32833","kind":"list-item"},{"blocks":[{"id":"blk-32836","kind":"paragraph","spans":[{"id":"spn-36770","text":"[ ] Secret is injected into the runtime provider using provider secret mechanisms."}]}],"id":"blk-32835","kind":"list-item"},{"blocks":[{"id":"blk-32838","kind":"paragraph","spans":[{"id":"spn-36771","text":"[ ] Telemetry endpoint verifies signature using raw request body bytes."}]}],"id":"blk-32837","kind":"list-item"},{"blocks":[{"id":"blk-32840","kind":"paragraph","spans":[{"id":"spn-36772","text":"[ ] Telemetry endpoint cross-checks "},{"id":"spn-36773","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-36774","text":" ownership."}]}],"id":"blk-32839","kind":"list-item"},{"blocks":[{"id":"blk-32842","kind":"paragraph","spans":[{"id":"spn-36775","text":"[ ] Telemetry endpoint is not authenticated via browser sessions/cookies."}]}],"id":"blk-32841","kind":"list-item"},{"blocks":[{"id":"blk-32844","kind":"paragraph","spans":[{"id":"spn-36776","text":"[ ] Telemetry ingestion is idempotent under retries (dedupe window)."}]}],"id":"blk-32843","kind":"list-item"},{"blocks":[{"id":"blk-32846","kind":"paragraph","spans":[{"id":"spn-36777","text":"[ ] Telemetry payloads do not include secret values or full prompt contents by default."}]}],"id":"blk-32845","kind":"list-item"},{"blocks":[{"id":"blk-32848","kind":"paragraph","spans":[{"id":"spn-36778","text":"[ ] Telemetry rejection and signature failures are auditable (sanitized audit log)."}]}],"id":"blk-32847","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32849","kind":"heading","level":2,"spans":[{"id":"spn-36779","text":"Acceptance criteria"}]},{"id":"blk-32850","kind":"paragraph","spans":[{"id":"spn-36780","text":"This ADR is considered correctly implemented when:"}]},{"id":"blk-32851","kind":"paragraph","spans":[{"id":"spn-36781","text":"1. A valid telemetry payload signed with the correct deployment secret is accepted and persisted. 2. The same payload with an invalid signature is rejected and not persisted. 3. A valid signature with mismatched ownership (deployment belongs to a different agent/user) is rejected. 4. Retried telemetry submissions do not cause double-counting within the dedupe strategy window. 5. No plaintext telemetry secret values exist in the primary DB. 6. Telemetry events are attributable to "},{"id":"spn-36782","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-36783","text":" and can be aggregated reliably for billing and limits."}]},{"id":"blk-32852","kind":"heading","level":2,"spans":[{"id":"spn-36784","text":"Follow-ups"}]},{"id":"blk-32853","items":[{"blocks":[{"id":"blk-32855","kind":"paragraph","spans":[{"id":"spn-36785","text":"ADR-0005: Deployment immutability + active pointer model (if not already documented as ADR)."}]}],"id":"blk-32854","kind":"list-item"},{"blocks":[{"id":"blk-32857","kind":"paragraph","spans":[{"id":"spn-36786","text":"Define a standardized "},{"id":"spn-36787","marks":["code"],"text":"eventId"},{"id":"spn-36788","text":" policy if traceId uniqueness cannot be guaranteed."}]}],"id":"blk-32856","kind":"list-item"},{"blocks":[{"id":"blk-32859","kind":"paragraph","spans":[{"id":"spn-36789","text":"Consider stronger anti-replay guarantees (timestamp window + dedupe store) before enabling public agent invocations."}]}],"id":"blk-32858","kind":"list-item"},{"blocks":[{"id":"blk-32861","kind":"paragraph","spans":[{"id":"spn-36790","text":"Consider future hardening for enterprise tiers (PKI signatures or mTLS) if required by compliance/security posture."}]}],"id":"blk-32860","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieravm6aoybea3n2wlw4v4tpkmrwp7bksh2hqbzhqrje2zstibq47ygq","vocabulary":"ampersand.docs.fs.v1"}