{"bendscript":"0.1","blocks":[{"id":"blk-32013","kind":"heading","level":1,"spans":[{"id":"spn-35313","text":"ADR-0004: Telemetry Integrity & Attribution Model (Deployment-Scoped Signed Events)"}]},{"id":"blk-32014","kind":"paragraph","spans":[{"id":"spn-35314","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-32015","items":[{"blocks":[{"id":"blk-32017","kind":"paragraph","spans":[{"id":"spn-35315","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-32016","kind":"list-item"},{"blocks":[{"id":"blk-32019","kind":"paragraph","spans":[{"id":"spn-35316","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-32018","kind":"list-item"},{"blocks":[{"id":"blk-32021","kind":"paragraph","spans":[{"id":"spn-35317","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-32020","kind":"list-item"},{"blocks":[{"id":"blk-32023","kind":"paragraph","spans":[{"id":"spn-35318","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-32022","kind":"list-item"},{"blocks":[{"id":"blk-32025","kind":"paragraph","spans":[{"id":"spn-35319","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-32024","kind":"list-item"},{"blocks":[{"id":"blk-32027","kind":"paragraph","spans":[{"id":"spn-35320","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-32026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32028","kind":"heading","level":2,"spans":[{"id":"spn-35321","text":"Context"}]},{"id":"blk-32029","kind":"paragraph","spans":[{"id":"spn-35322","text":"webhost.systems is a multi-runtime AI agent platform. For each invocation executed in the data plane (Cloudflare Workers/DO or AWS Bedrock AgentCore), the platform must record usage and operational telemetry for:"}]},{"id":"blk-32030","items":[{"blocks":[{"id":"blk-32032","kind":"paragraph","spans":[{"id":"spn-35323","text":"plan enforcement (requests/tokens/compute limits),"}]}],"id":"blk-32031","kind":"list-item"},{"blocks":[{"id":"blk-32034","kind":"paragraph","spans":[{"id":"spn-35324","text":"cost estimation (v1: estimated cost),"}]}],"id":"blk-32033","kind":"list-item"},{"blocks":[{"id":"blk-32036","kind":"paragraph","spans":[{"id":"spn-35325","text":"billing integrity (tier gating and upgrade flows),"}]}],"id":"blk-32035","kind":"list-item"},{"blocks":[{"id":"blk-32038","kind":"paragraph","spans":[{"id":"spn-35326","text":"observability (error rates, latency/compute, tool usage),"}]}],"id":"blk-32037","kind":"list-item"},{"blocks":[{"id":"blk-32040","kind":"paragraph","spans":[{"id":"spn-35327","text":"audits and support (traceability via "},{"id":"spn-35328","marks":["code"],"text":"traceId"},{"id":"spn-35329","text":", deploy version, runtime)."}]}],"id":"blk-32039","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32041","kind":"paragraph","spans":[{"id":"spn-35330","text":"Telemetry is consumed by the control plane and stored as append-only raw events ("},{"id":"spn-35331","marks":["code"],"text":"metricsEvents"},{"id":"spn-35332","text":") and aggregated views ("},{"id":"spn-35333","marks":["code"],"text":"billingUsage"},{"id":"spn-35334","text":")."}]},{"id":"blk-32042","kind":"heading","level":3,"spans":[{"id":"spn-35335","text":"Problem statement"}]},{"id":"blk-32043","kind":"paragraph","spans":[{"id":"spn-35336","text":"Telemetry is a critical security and business integrity surface. If telemetry is spoofable or not attributable, an attacker (or buggy runtime) could:"}]},{"id":"blk-32044","items":[{"blocks":[{"id":"blk-32046","kind":"paragraph","spans":[{"id":"spn-35337","text":"underreport usage to avoid limits or billing,"}]}],"id":"blk-32045","kind":"list-item"},{"blocks":[{"id":"blk-32048","kind":"paragraph","spans":[{"id":"spn-35338","text":"overreport usage to sabotage another tenant,"}]}],"id":"blk-32047","kind":"list-item"},{"blocks":[{"id":"blk-32050","kind":"paragraph","spans":[{"id":"spn-35339","text":"inject events for another tenant’s agents/deployments,"}]}],"id":"blk-32049","kind":"list-item"},{"blocks":[{"id":"blk-32052","kind":"paragraph","spans":[{"id":"spn-35340","text":"create ambiguity in chargeback attribution across runtimes,"}]}],"id":"blk-32051","kind":"list-item"},{"blocks":[{"id":"blk-32054","kind":"paragraph","spans":[{"id":"spn-35341","text":"break observability and incident response."}]}],"id":"blk-32053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32055","kind":"paragraph","spans":[{"id":"spn-35342","text":"Therefore telemetry ingestion must ensure:"}]},{"id":"blk-32056","kind":"paragraph","spans":[{"id":"spn-35343","text":"1. "},{"id":"spn-35344","marks":["bold"],"text":"Integrity"},{"id":"spn-35345","text":": payload not tampered in transit. 2. "},{"id":"spn-35346","marks":["bold"],"text":"Authenticity"},{"id":"spn-35347","text":": sender is an authorized runtime deployment. 3. "},{"id":"spn-35348","marks":["bold"],"text":"Attribution"},{"id":"spn-35349","text":": event belongs to exactly one "},{"id":"spn-35350","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-35351","text":". 4. "},{"id":"spn-35352","marks":["bold"],"text":"Replay safety"},{"id":"spn-35353","text":": retries do not double count; attackers cannot re-submit old events to alter usage. 5. "},{"id":"spn-35354","marks":["bold"],"text":"No secrets leakage"},{"id":"spn-35355","text":": telemetry must never include secret values, and telemetry auth secrets must not be stored as plaintext."}]},{"id":"blk-32057","kind":"paragraph","spans":[{"id":"spn-35356","text":"Constraints:"}]},{"id":"blk-32058","items":[{"blocks":[{"id":"blk-32060","kind":"paragraph","spans":[{"id":"spn-35357","text":"Data plane runtimes are heterogeneous and may differ in what usage details they can report."}]}],"id":"blk-32059","kind":"list-item"},{"blocks":[{"id":"blk-32062","kind":"paragraph","spans":[{"id":"spn-35358","text":"Customer agent code is untrusted; it may attempt to forge telemetry or call arbitrary endpoints."}]}],"id":"blk-32061","kind":"list-item"},{"blocks":[{"id":"blk-32064","kind":"paragraph","spans":[{"id":"spn-35359","text":"Telemetry ingestion must not rely on browser sessions/cookies."}]}],"id":"blk-32063","kind":"list-item"},{"blocks":[{"id":"blk-32066","kind":"paragraph","spans":[{"id":"spn-35360","text":"The system must remain implementable for v1 without introducing a full centralized vault or complex PKI."}]}],"id":"blk-32065","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32067","kind":"heading","level":2,"spans":[{"id":"spn-35361","text":"Decision"}]},{"id":"blk-32068","kind":"paragraph","spans":[{"id":"spn-35362","text":"Adopt a "},{"id":"spn-35363","marks":["bold"],"text":"deployment-scoped signed telemetry event"},{"id":"spn-35364","text":" model with "},{"id":"spn-35365","marks":["bold"],"text":"ownership cross-checking"},{"id":"spn-35366","text":" at ingestion."}]},{"id":"blk-32069","kind":"heading","level":3,"spans":[{"id":"spn-35367","text":"Decision summary (normative)"}]},{"id":"blk-32070","kind":"paragraph","spans":[{"id":"spn-35368","text":"1. "},{"id":"spn-35369","marks":["bold"],"text":"Attribution is mandatory"},{"id":"spn-35370","text":" Every telemetry event MUST be attributable to:"}]},{"id":"blk-32071","items":[{"blocks":[{"id":"blk-32073","kind":"paragraph","spans":[{"id":"spn-35371","marks":["code"],"text":"userId"}]}],"id":"blk-32072","kind":"list-item"},{"blocks":[{"id":"blk-32075","kind":"paragraph","spans":[{"id":"spn-35372","marks":["code"],"text":"agentId"}]}],"id":"blk-32074","kind":"list-item"},{"blocks":[{"id":"blk-32077","kind":"paragraph","spans":[{"id":"spn-35373","marks":["code"],"text":"deploymentId"}]}],"id":"blk-32076","kind":"list-item"},{"blocks":[{"id":"blk-32079","kind":"paragraph","spans":[{"id":"spn-35374","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-32078","kind":"list-item"},{"blocks":[{"id":"blk-32081","kind":"paragraph","spans":[{"id":"spn-35375","marks":["code"],"text":"timestamp"}]}],"id":"blk-32080","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32082","kind":"paragraph","spans":[{"id":"spn-35376","text":"2. "},{"id":"spn-35377","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped HMAC signatures (v1)"}]},{"id":"blk-32083","items":[{"blocks":[{"id":"blk-32085","kind":"paragraph","spans":[{"id":"spn-35378","text":"Each deployment has a unique "},{"id":"spn-35379","marks":["code"],"text":"telemetrySecret"},{"id":"spn-35380","text":" (HMAC key), generated by the control plane."}]}],"id":"blk-32084","kind":"list-item"},{"blocks":[{"id":"blk-32087","kind":"paragraph","spans":[{"id":"spn-35381","text":"The "},{"id":"spn-35382","marks":["code"],"text":"telemetrySecret"},{"id":"spn-35383","text":" is injected into the deployed runtime using provider secret mechanisms."}]}],"id":"blk-32086","kind":"list-item"},{"blocks":[{"id":"blk-32089","kind":"paragraph","spans":[{"id":"spn-35384","text":"Data plane submits telemetry to the control plane ingestion endpoint with:"}]}],"id":"blk-32088","kind":"list-item"},{"blocks":[{"id":"blk-32091","kind":"paragraph","spans":[{"id":"spn-35385","text":"header "},{"id":"spn-35386","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-32090","kind":"list-item"},{"blocks":[{"id":"blk-32093","kind":"paragraph","spans":[{"id":"spn-35387","text":"header "},{"id":"spn-35388","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex(hmac_sha256(raw_body_bytes, telemetrySecret))>"}]}],"id":"blk-32092","kind":"list-item"},{"blocks":[{"id":"blk-32095","kind":"paragraph","spans":[{"id":"spn-35389","text":"Control plane verifies:"}]}],"id":"blk-32094","kind":"list-item"},{"blocks":[{"id":"blk-32097","kind":"paragraph","spans":[{"id":"spn-35390","text":"signature validity (using deployment-scoped secret reference),"}]}],"id":"blk-32096","kind":"list-item"},{"blocks":[{"id":"blk-32099","kind":"paragraph","spans":[{"id":"spn-35391","text":"ownership mapping: deployment belongs to the agent and user in the payload,"}]}],"id":"blk-32098","kind":"list-item"},{"blocks":[{"id":"blk-32101","kind":"paragraph","spans":[{"id":"spn-35392","text":"required fields and enums."}]}],"id":"blk-32100","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32102","kind":"paragraph","spans":[{"id":"spn-35393","text":"3. "},{"id":"spn-35394","marks":["bold"],"text":"Ingestion performs ownership cross-check (defense in depth)"},{"id":"spn-35395","text":" After signature validation, ingestion MUST query control plane data and verify:"}]},{"id":"blk-32103","items":[{"blocks":[{"id":"blk-32105","kind":"paragraph","spans":[{"id":"spn-35396","marks":["code"],"text":"deployments._id == deploymentId"}]}],"id":"blk-32104","kind":"list-item"},{"blocks":[{"id":"blk-32107","kind":"paragraph","spans":[{"id":"spn-35397","marks":["code"],"text":"deployments.agentId == agentId"}]}],"id":"blk-32106","kind":"list-item"},{"blocks":[{"id":"blk-32109","kind":"paragraph","spans":[{"id":"spn-35398","marks":["code"],"text":"deployments.userId == userId"}]}],"id":"blk-32108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32110","kind":"paragraph","spans":[{"id":"spn-35399","text":"If any mismatch: reject the event, optionally record an "},{"id":"spn-35400","marks":["code"],"text":"auditLog"},{"id":"spn-35401","text":" entry with sanitized details."}]},{"id":"blk-32111","kind":"paragraph","spans":[{"id":"spn-35402","text":"4. "},{"id":"spn-35403","marks":["bold"],"text":"Telemetry does not use user auth"},{"id":"spn-35404","text":" Telemetry ingestion MUST NOT accept browser session cookies as authentication. Telemetry is authenticated solely by deployment-scoped signature (and optional anti-replay)."}]},{"id":"blk-32112","kind":"paragraph","spans":[{"id":"spn-35405","text":"5. "},{"id":"spn-35406","marks":["bold"],"text":"Replay/dedupe (recommended in v1; mandatory before public invocations)"},{"id":"spn-35407","text":" Telemetry ingestion SHOULD implement one of:"}]},{"id":"blk-32113","items":[{"blocks":[{"id":"blk-32115","kind":"paragraph","spans":[{"id":"spn-35408","marks":["code"],"text":"eventId"},{"id":"spn-35409","text":" (UUID generated by data plane) + short-window dedupe store, OR"}]}],"id":"blk-32114","kind":"list-item"},{"blocks":[{"id":"blk-32117","kind":"paragraph","spans":[{"id":"spn-35410","text":"dedupe on "},{"id":"spn-35411","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-35412","text":" if "},{"id":"spn-35413","marks":["code"],"text":"traceId"},{"id":"spn-35414","text":" uniqueness per invocation is guaranteed."}]}],"id":"blk-32116","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32118","kind":"paragraph","spans":[{"id":"spn-35415","text":"In either case, ingestion must be idempotent under retries to prevent double counting."}]},{"id":"blk-32119","kind":"paragraph","spans":[{"id":"spn-35416","text":"6. "},{"id":"spn-35417","marks":["bold"],"text":"Secrets are never stored as plaintext in the primary DB"}]},{"id":"blk-32120","items":[{"blocks":[{"id":"blk-32122","kind":"paragraph","spans":[{"id":"spn-35418","text":"The primary DB stores only metadata and secret references (e.g., provider secret name/id)."}]}],"id":"blk-32121","kind":"list-item"},{"blocks":[{"id":"blk-32124","kind":"paragraph","spans":[{"id":"spn-35419","text":"The "},{"id":"spn-35420","marks":["code"],"text":"telemetrySecret"},{"id":"spn-35421","text":" value MUST NOT be stored in plaintext in the primary database (Supabase)."}]}],"id":"blk-32123","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32125","kind":"heading","level":3,"spans":[{"id":"spn-35422","text":"Provider-specific telemetry capabilities (implementation guidance)"}]},{"id":"blk-32126","kind":"paragraph","spans":[{"id":"spn-35423","text":"This ADR standardizes telemetry ingestion on "},{"id":"spn-35424","marks":["bold"],"text":"deployment-scoped signed events"},{"id":"spn-35425","text":" for all runtimes. Provider capabilities vary, but the v1 baseline remains consistent."}]},{"id":"blk-32127","kind":"paragraph","spans":[{"id":"spn-35426","marks":["bold"],"text":"Cloudflare (Workers + Durable Objects):"}]},{"id":"blk-32128","items":[{"blocks":[{"id":"blk-32130","kind":"paragraph","spans":[{"id":"spn-35427","text":"The runtime MUST explicitly emit telemetry to the control plane (Pattern A: in-workload emission is the preferred approach)."}]}],"id":"blk-32129","kind":"list-item"},{"blocks":[{"id":"blk-32132","kind":"paragraph","spans":[{"id":"spn-35428","text":"The telemetry signing secret is injected via Worker secret bindings."}]}],"id":"blk-32131","kind":"list-item"},{"blocks":[{"id":"blk-32134","kind":"paragraph","spans":[{"id":"spn-35429","text":"The Worker/DO submits "},{"id":"spn-35430","marks":["code"],"text":"POST /v1/telemetry/report"},{"id":"spn-35431","text":" with "},{"id":"spn-35432","marks":["code"],"text":"X-Telemetry-Deployment-Id"},{"id":"spn-35433","text":" and "},{"id":"spn-35434","marks":["code"],"text":"X-Telemetry-Signature"},{"id":"spn-35435","text":"."}]}],"id":"blk-32133","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32135","kind":"paragraph","spans":[{"id":"spn-35436","marks":["bold"],"text":"AgentCore (AWS Bedrock AgentCore):"}]},{"id":"blk-32136","items":[{"blocks":[{"id":"blk-32138","kind":"paragraph","spans":[{"id":"spn-35437","text":"AgentCore may provide provider-native observability capabilities (e.g., service-level telemetry/OTel-style integrations) that can be valuable for deep debugging."}]}],"id":"blk-32137","kind":"list-item"},{"blocks":[{"id":"blk-32140","kind":"paragraph","spans":[{"id":"spn-35438","marks":["bold"],"text":"v1 baseline:"},{"id":"spn-35439","text":" use the same direct signed submission model as Cloudflare (either in-workload emission when feasible, or adapter-side emission when required by provider constraints) to keep metering, limits, and billing semantics consistent across runtimes."}]}],"id":"blk-32139","kind":"list-item"},{"blocks":[{"id":"blk-32142","kind":"paragraph","spans":[{"id":"spn-35440","marks":["bold"],"text":"post-v1 enhancement:"},{"id":"spn-35441","text":" integrate provider-native observability for richer traces while still emitting the normalized, signed metering event used for billing and limits."}]}],"id":"blk-32141","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32143","kind":"heading","level":2,"spans":[{"id":"spn-35442","text":"Rationale"}]},{"id":"blk-32144","kind":"paragraph","spans":[{"id":"spn-35443","text":"This approach satisfies the requirements with minimal complexity:"}]},{"id":"blk-32145","items":[{"blocks":[{"id":"blk-32147","kind":"paragraph","spans":[{"id":"spn-35444","marks":["bold"],"text":"Integrity and authenticity"},{"id":"spn-35445","text":": HMAC signatures prevent tampering and authenticate possession of a deployment-scoped secret."}]}],"id":"blk-32146","kind":"list-item"},{"blocks":[{"id":"blk-32149","kind":"paragraph","spans":[{"id":"spn-35446","marks":["bold"],"text":"Tenant protection"},{"id":"spn-35447","text":": ownership cross-check prevents a compromised deployment secret from being used to write events for a different agent or user."}]}],"id":"blk-32148","kind":"list-item"},{"blocks":[{"id":"blk-32151","kind":"paragraph","spans":[{"id":"spn-35448","marks":["bold"],"text":"Least privilege"},{"id":"spn-35449","text":": deployment-scoped secret limits blast radius if compromised."}]}],"id":"blk-32150","kind":"list-item"},{"blocks":[{"id":"blk-32153","kind":"paragraph","spans":[{"id":"spn-35450","marks":["bold"],"text":"Provider portability"},{"id":"spn-35451","text":": works across runtimes because it relies on a generic “can send HTTP + store secret” capability."}]}],"id":"blk-32152","kind":"list-item"},{"blocks":[{"id":"blk-32155","kind":"paragraph","spans":[{"id":"spn-35452","marks":["bold"],"text":"Operable MVP"},{"id":"spn-35453","text":": avoids the need for PKI or an always-online centralized vault, while still enabling strong guarantees."}]}],"id":"blk-32154","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32156","kind":"heading","level":2,"spans":[{"id":"spn-35454","text":"Alternatives considered"}]},{"id":"blk-32157","kind":"heading","level":3,"spans":[{"id":"spn-35455","text":"A) Trust telemetry without signatures (reject)"}]},{"id":"blk-32158","kind":"paragraph","spans":[{"id":"spn-35456","marks":["bold"],"text":"Pros"}]},{"id":"blk-32159","items":[{"blocks":[{"id":"blk-32161","kind":"paragraph","spans":[{"id":"spn-35457","text":"Easiest to implement."}]}],"id":"blk-32160","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32162","kind":"paragraph","spans":[{"id":"spn-35458","marks":["bold"],"text":"Cons"}]},{"id":"blk-32163","items":[{"blocks":[{"id":"blk-32165","kind":"paragraph","spans":[{"id":"spn-35459","text":"Enables trivial spoofing and billing manipulation."}]}],"id":"blk-32164","kind":"list-item"},{"blocks":[{"id":"blk-32167","kind":"paragraph","spans":[{"id":"spn-35460","text":"Allows cross-tenant sabotage and incorrect usage enforcement."}]}],"id":"blk-32166","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32168","kind":"paragraph","spans":[{"id":"spn-35461","marks":["bold"],"text":"Decision"},{"id":"spn-35462","text":" Rejected. Not acceptable for any paid system with limits and billing."}]},{"id":"blk-32169","kind":"heading","level":3,"spans":[{"id":"spn-35463","text":"B) Adapter-side telemetry only (partial alternative)"}]},{"id":"blk-32170","kind":"paragraph","spans":[{"id":"spn-35464","text":"Telemetry is emitted only by the control plane adapter after it receives provider responses."}]},{"id":"blk-32171","kind":"paragraph","spans":[{"id":"spn-35465","marks":["bold"],"text":"Pros"}]},{"id":"blk-32172","items":[{"blocks":[{"id":"blk-32174","kind":"paragraph","spans":[{"id":"spn-35466","text":"Avoids injecting telemetry secrets into runtime code."}]}],"id":"blk-32173","kind":"list-item"},{"blocks":[{"id":"blk-32176","kind":"paragraph","spans":[{"id":"spn-35467","text":"Avoids runtime outbound call to control plane."}]}],"id":"blk-32175","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32177","kind":"paragraph","spans":[{"id":"spn-35468","marks":["bold"],"text":"Cons"}]},{"id":"blk-32178","items":[{"blocks":[{"id":"blk-32180","kind":"paragraph","spans":[{"id":"spn-35469","text":"Often cannot capture provider-specific usage (compute/tool usage) reliably."}]}],"id":"blk-32179","kind":"list-item"},{"blocks":[{"id":"blk-32182","kind":"paragraph","spans":[{"id":"spn-35470","text":"Creates attribution gaps if invocations happen outside the adapter path or if provider returns incomplete usage."}]}],"id":"blk-32181","kind":"list-item"},{"blocks":[{"id":"blk-32184","kind":"paragraph","spans":[{"id":"spn-35471","text":"Weakens correlation with runtime events and can undercount."}]}],"id":"blk-32183","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32185","kind":"paragraph","spans":[{"id":"spn-35472","marks":["bold"],"text":"Decision"},{"id":"spn-35473","text":" Not the primary model. Allowed as a constrained fallback if a provider cannot support in-workload emission, but must preserve integrity and attribution. If adapter emits, it must still attach to a deployment and enforce ownership; it must not be forgeable by clients."}]},{"id":"blk-32186","kind":"heading","level":3,"spans":[{"id":"spn-35474","text":"C) Per-user telemetry keys (reject)"}]},{"id":"blk-32187","kind":"paragraph","spans":[{"id":"spn-35475","text":"Use one key per user shared across all deployments."}]},{"id":"blk-32188","kind":"paragraph","spans":[{"id":"spn-35476","marks":["bold"],"text":"Pros"}]},{"id":"blk-32189","items":[{"blocks":[{"id":"blk-32191","kind":"paragraph","spans":[{"id":"spn-35477","text":"Fewer secrets."}]}],"id":"blk-32190","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32192","kind":"paragraph","spans":[{"id":"spn-35478","marks":["bold"],"text":"Cons"}]},{"id":"blk-32193","items":[{"blocks":[{"id":"blk-32195","kind":"paragraph","spans":[{"id":"spn-35479","text":"Massive blast radius if compromised; compromised deployment can spoof across all user deployments."}]}],"id":"blk-32194","kind":"list-item"},{"blocks":[{"id":"blk-32197","kind":"paragraph","spans":[{"id":"spn-35480","text":"Harder to rotate safely and isolate issues."}]}],"id":"blk-32196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32198","kind":"paragraph","spans":[{"id":"spn-35481","marks":["bold"],"text":"Decision"},{"id":"spn-35482","text":" Rejected. Deployment-scoped keys are safer and align with immutability and auditability."}]},{"id":"blk-32199","kind":"heading","level":3,"spans":[{"id":"spn-35483","text":"D) Public-key signatures (PKI) per deployment (defer)"}]},{"id":"blk-32200","kind":"paragraph","spans":[{"id":"spn-35484","text":"Each deployment gets a keypair; telemetry signed with private key, verified with public key."}]},{"id":"blk-32201","kind":"paragraph","spans":[{"id":"spn-35485","marks":["bold"],"text":"Pros"}]},{"id":"blk-32202","items":[{"blocks":[{"id":"blk-32204","kind":"paragraph","spans":[{"id":"spn-35486","text":"No shared secret at ingestion; avoids secret distribution to verifier."}]}],"id":"blk-32203","kind":"list-item"},{"blocks":[{"id":"blk-32206","kind":"paragraph","spans":[{"id":"spn-35487","text":"Strong cryptographic model."}]}],"id":"blk-32205","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32207","kind":"paragraph","spans":[{"id":"spn-35488","marks":["bold"],"text":"Cons"}]},{"id":"blk-32208","items":[{"blocks":[{"id":"blk-32210","kind":"paragraph","spans":[{"id":"spn-35489","text":"Adds key management complexity; still needs secure private key injection to runtime."}]}],"id":"blk-32209","kind":"list-item"},{"blocks":[{"id":"blk-32212","kind":"paragraph","spans":[{"id":"spn-35490","text":"Higher implementation overhead for v1 without clear ROI."}]}],"id":"blk-32211","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32213","kind":"paragraph","spans":[{"id":"spn-35491","marks":["bold"],"text":"Decision"},{"id":"spn-35492","text":" Deferred. Consider post-v1 if you need stronger non-repudiation or third-party verification."}]},{"id":"blk-32214","kind":"heading","level":3,"spans":[{"id":"spn-35493","text":"E) mTLS between data plane and control plane (defer)"}]},{"id":"blk-32215","kind":"paragraph","spans":[{"id":"spn-35494","text":"Use mutual TLS with client certs per deployment."}]},{"id":"blk-32216","kind":"paragraph","spans":[{"id":"spn-35495","marks":["bold"],"text":"Pros"}]},{"id":"blk-32217","items":[{"blocks":[{"id":"blk-32219","kind":"paragraph","spans":[{"id":"spn-35496","text":"Strong channel-level authentication."}]}],"id":"blk-32218","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32220","kind":"paragraph","spans":[{"id":"spn-35497","marks":["bold"],"text":"Cons"}]},{"id":"blk-32221","items":[{"blocks":[{"id":"blk-32223","kind":"paragraph","spans":[{"id":"spn-35498","text":"Operationally heavy; certificate issuance/rotation complexity."}]}],"id":"blk-32222","kind":"list-item"},{"blocks":[{"id":"blk-32225","kind":"paragraph","spans":[{"id":"spn-35499","text":"Hard to implement uniformly across runtimes."}]}],"id":"blk-32224","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32226","kind":"paragraph","spans":[{"id":"spn-35500","marks":["bold"],"text":"Decision"},{"id":"spn-35501","text":" Deferred. Potential future hardening for enterprise tiers."}]},{"id":"blk-32227","kind":"heading","level":2,"spans":[{"id":"spn-35502","text":"Detailed design (normative)"}]},{"id":"blk-32228","kind":"heading","level":3,"spans":[{"id":"spn-35503","text":"1) Telemetry event schema (minimum viable)"}]},{"id":"blk-32229","kind":"paragraph","spans":[{"id":"spn-35504","text":"Telemetry payload MUST include:"}]},{"id":"blk-32230","items":[{"blocks":[{"id":"blk-32232","kind":"paragraph","spans":[{"id":"spn-35505","marks":["code"],"text":"userId"},{"id":"spn-35506","text":" (internal id)"}]}],"id":"blk-32231","kind":"list-item"},{"blocks":[{"id":"blk-32234","kind":"paragraph","spans":[{"id":"spn-35507","marks":["code"],"text":"agentId"}]}],"id":"blk-32233","kind":"list-item"},{"blocks":[{"id":"blk-32236","kind":"paragraph","spans":[{"id":"spn-35508","marks":["code"],"text":"deploymentId"}]}],"id":"blk-32235","kind":"list-item"},{"blocks":[{"id":"blk-32238","kind":"paragraph","spans":[{"id":"spn-35509","marks":["code"],"text":"runtimeProvider"},{"id":"spn-35510","text":" ("},{"id":"spn-35511","marks":["code"],"text":"cloudflare"},{"id":"spn-35512","text":" | "},{"id":"spn-35513","marks":["code"],"text":"agentcore"},{"id":"spn-35514","text":")"}]}],"id":"blk-32237","kind":"list-item"},{"blocks":[{"id":"blk-32240","kind":"paragraph","spans":[{"id":"spn-35515","marks":["code"],"text":"timestamp"},{"id":"spn-35516","text":" (RFC3339 or unix ms; ingestion converts to unix ms)"}]}],"id":"blk-32239","kind":"list-item"},{"blocks":[{"id":"blk-32242","kind":"paragraph","spans":[{"id":"spn-35517","marks":["code"],"text":"requests"},{"id":"spn-35518","text":" (typically 1)"}]}],"id":"blk-32241","kind":"list-item"},{"blocks":[{"id":"blk-32244","kind":"paragraph","spans":[{"id":"spn-35519","marks":["code"],"text":"llmTokens"},{"id":"spn-35520","text":" (reported or estimated)"}]}],"id":"blk-32243","kind":"list-item"},{"blocks":[{"id":"blk-32246","kind":"paragraph","spans":[{"id":"spn-35521","marks":["code"],"text":"computeMs"},{"id":"spn-35522","text":" (wall time or billed time, defined per provider)"}]}],"id":"blk-32245","kind":"list-item"},{"blocks":[{"id":"blk-32248","kind":"paragraph","spans":[{"id":"spn-35523","marks":["code"],"text":"errors"},{"id":"spn-35524","text":" (0/1 typical)"}]}],"id":"blk-32247","kind":"list-item"},{"blocks":[{"id":"blk-32250","kind":"paragraph","spans":[{"id":"spn-35525","marks":["code"],"text":"errorClass"},{"id":"spn-35526","text":" (optional: "},{"id":"spn-35527","marks":["code"],"text":"auth | limit | runtime | tool | unknown"},{"id":"spn-35528","text":")"}]}],"id":"blk-32249","kind":"list-item"},{"blocks":[{"id":"blk-32252","kind":"paragraph","spans":[{"id":"spn-35529","marks":["code"],"text":"costUsdEstimated"}]}],"id":"blk-32251","kind":"list-item"},{"blocks":[{"id":"blk-32254","kind":"paragraph","spans":[{"id":"spn-35530","marks":["code"],"text":"traceId"},{"id":"spn-35531","text":" (optional but recommended)"}]}],"id":"blk-32253","kind":"list-item"},{"blocks":[{"id":"blk-32256","kind":"paragraph","spans":[{"id":"spn-35532","marks":["code"],"text":"provider"},{"id":"spn-35533","text":" (optional runtime-specific counters)"}]}],"id":"blk-32255","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32257","kind":"paragraph","spans":[{"id":"spn-35534","text":"Telemetry MUST NOT include:"}]},{"id":"blk-32258","items":[{"blocks":[{"id":"blk-32260","kind":"paragraph","spans":[{"id":"spn-35535","text":"plaintext secrets,"}]}],"id":"blk-32259","kind":"list-item"},{"blocks":[{"id":"blk-32262","kind":"paragraph","spans":[{"id":"spn-35536","text":"full prompts/responses by default (unless an explicit opt-in feature is added later),"}]}],"id":"blk-32261","kind":"list-item"},{"blocks":[{"id":"blk-32264","kind":"paragraph","spans":[{"id":"spn-35537","text":"raw provider credential material."}]}],"id":"blk-32263","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32265","kind":"heading","level":3,"spans":[{"id":"spn-35538","text":"2) Signature computation"}]},{"id":"blk-32266","items":[{"blocks":[{"id":"blk-32268","kind":"paragraph","spans":[{"id":"spn-35539","text":"Signature is computed over the exact raw request body bytes as received/sent."}]}],"id":"blk-32267","kind":"list-item"},{"blocks":[{"id":"blk-32270","kind":"paragraph","spans":[{"id":"spn-35540","text":"Algorithm: "},{"id":"spn-35541","marks":["code"],"text":"HMAC_SHA256(telemetrySecret, raw_body_bytes)"},{"id":"spn-35542","text":"."}]}],"id":"blk-32269","kind":"list-item"},{"blocks":[{"id":"blk-32272","kind":"paragraph","spans":[{"id":"spn-35543","text":"Encoding: hex lowercase recommended."}]}],"id":"blk-32271","kind":"list-item"},{"blocks":[{"id":"blk-32274","kind":"paragraph","spans":[{"id":"spn-35544","text":"Header format: "},{"id":"spn-35545","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex>"},{"id":"spn-35546","text":"."}]}],"id":"blk-32273","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32275","kind":"paragraph","spans":[{"id":"spn-35547","text":"Canonicalization note:"}]},{"id":"blk-32276","items":[{"blocks":[{"id":"blk-32278","kind":"paragraph","spans":[{"id":"spn-35548","text":"The verifier MUST use the raw body bytes, not a re-serialized JSON object."}]}],"id":"blk-32277","kind":"list-item"},{"blocks":[{"id":"blk-32280","kind":"paragraph","spans":[{"id":"spn-35549","text":"If your framework modifies request bodies, capture raw bytes before parsing."}]}],"id":"blk-32279","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32281","kind":"heading","level":3,"spans":[{"id":"spn-35550","text":"3) Ingestion validation steps (MUST)"}]},{"id":"blk-32282","kind":"paragraph","spans":[{"id":"spn-35551","text":"In order: 1. Read "},{"id":"spn-35552","marks":["code"],"text":"deploymentId"},{"id":"spn-35553","text":" header and locate deployment record. 2. Fetch deployment-scoped secret reference and verify signature. 3. Parse JSON body and validate required fields and enums. 4. Ownership cross-check:"}]},{"id":"blk-32283","items":[{"blocks":[{"id":"blk-32285","kind":"paragraph","spans":[{"id":"spn-35554","marks":["code"],"text":"deployments.userId == body.userId"}]}],"id":"blk-32284","kind":"list-item"},{"blocks":[{"id":"blk-32287","kind":"paragraph","spans":[{"id":"spn-35555","marks":["code"],"text":"deployments.agentId == body.agentId"}]}],"id":"blk-32286","kind":"list-item"},{"blocks":[{"id":"blk-32289","kind":"paragraph","spans":[{"id":"spn-35556","marks":["code"],"text":"deployments._id == body.deploymentId"},{"id":"spn-35557","text":" (or match header)"}]}],"id":"blk-32288","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32290","kind":"paragraph","spans":[{"id":"spn-35558","text":"5. Dedupe/idempotency:"}]},{"id":"blk-32291","items":[{"blocks":[{"id":"blk-32293","kind":"paragraph","spans":[{"id":"spn-35559","text":"if "},{"id":"spn-35560","marks":["code"],"text":"eventId"},{"id":"spn-35561","text":" used: reject or no-op if already processed in dedupe window"}]}],"id":"blk-32292","kind":"list-item"},{"blocks":[{"id":"blk-32295","kind":"paragraph","spans":[{"id":"spn-35562","text":"if "},{"id":"spn-35563","marks":["code"],"text":"traceId"},{"id":"spn-35564","text":" used: ensure uniqueness per "},{"id":"spn-35565","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-35566","text":" in dedupe window"}]}],"id":"blk-32294","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32296","kind":"paragraph","spans":[{"id":"spn-35567","text":"6. Persist event append-only. 7. Optionally update incremental counters."}]},{"id":"blk-32297","kind":"paragraph","spans":[{"id":"spn-35568","text":"If any step fails:"}]},{"id":"blk-32298","items":[{"blocks":[{"id":"blk-32300","kind":"paragraph","spans":[{"id":"spn-35569","text":"respond with normalized error (for non-telemetry callers, keep generic),"}]}],"id":"blk-32299","kind":"list-item"},{"blocks":[{"id":"blk-32302","kind":"paragraph","spans":[{"id":"spn-35570","text":"DO NOT reveal secret or internal details,"}]}],"id":"blk-32301","kind":"list-item"},{"blocks":[{"id":"blk-32304","kind":"paragraph","spans":[{"id":"spn-35571","text":"optionally write a sanitized "},{"id":"spn-35572","marks":["code"],"text":"auditLog"},{"id":"spn-35573","text":" entry for investigation."}]}],"id":"blk-32303","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32305","kind":"heading","level":3,"spans":[{"id":"spn-35574","text":"4) Secret generation and rotation"}]},{"id":"blk-32306","items":[{"blocks":[{"id":"blk-32308","kind":"paragraph","spans":[{"id":"spn-35575","text":"Generate a new telemetry secret on every new deployment by default."}]}],"id":"blk-32307","kind":"list-item"},{"blocks":[{"id":"blk-32310","kind":"paragraph","spans":[{"id":"spn-35576","text":"Inject the secret into the runtime provider as a secret (not as plain env var stored in DB)."}]}],"id":"blk-32309","kind":"list-item"},{"blocks":[{"id":"blk-32312","kind":"paragraph","spans":[{"id":"spn-35577","text":"Rotation policy:"}]}],"id":"blk-32311","kind":"list-item"},{"blocks":[{"id":"blk-32314","kind":"paragraph","spans":[{"id":"spn-35578","text":"New deployment => new telemetry secret (mandatory)."}]}],"id":"blk-32313","kind":"list-item"},{"blocks":[{"id":"blk-32316","kind":"paragraph","spans":[{"id":"spn-35579","text":"Old deployments retain old secret for the duration they might emit telemetry (but they should not emit after deactivation, except in-flight retries)."}]}],"id":"blk-32315","kind":"list-item"},{"blocks":[{"id":"blk-32318","kind":"paragraph","spans":[{"id":"spn-35580","text":"Keep verification capability for a bounded time window after deactivation to allow late telemetry retries."}]}],"id":"blk-32317","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32319","kind":"heading","level":3,"spans":[{"id":"spn-35581","text":"5) Telemetry retries and ingestion availability"}]},{"id":"blk-32320","items":[{"blocks":[{"id":"blk-32322","kind":"paragraph","spans":[{"id":"spn-35582","text":"Data plane SHOULD retry telemetry submission with exponential backoff (bounded)."}]}],"id":"blk-32321","kind":"list-item"},{"blocks":[{"id":"blk-32324","kind":"paragraph","spans":[{"id":"spn-35583","text":"Data plane SHOULD NOT block user-visible invocation completion while retrying telemetry."}]}],"id":"blk-32323","kind":"list-item"},{"blocks":[{"id":"blk-32326","kind":"paragraph","spans":[{"id":"spn-35584","text":"Control plane SHOULD expose internal health metrics for telemetry ingestion rate and rejection counts."}]}],"id":"blk-32325","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32327","kind":"heading","level":2,"spans":[{"id":"spn-35585","text":"Consequences"}]},{"id":"blk-32328","kind":"heading","level":3,"spans":[{"id":"spn-35586","text":"Positive"}]},{"id":"blk-32329","items":[{"blocks":[{"id":"blk-32331","kind":"paragraph","spans":[{"id":"spn-35587","text":"Strong billing and limits integrity foundation."}]}],"id":"blk-32330","kind":"list-item"},{"blocks":[{"id":"blk-32333","kind":"paragraph","spans":[{"id":"spn-35588","text":"Provider-agnostic design that scales to new runtimes."}]}],"id":"blk-32332","kind":"list-item"},{"blocks":[{"id":"blk-32335","kind":"paragraph","spans":[{"id":"spn-35589","text":"Reduced blast radius via deployment-scoped secrets."}]}],"id":"blk-32334","kind":"list-item"},{"blocks":[{"id":"blk-32337","kind":"paragraph","spans":[{"id":"spn-35590","text":"Clear audit path for telemetry failures and spoof attempts."}]}],"id":"blk-32336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32338","kind":"heading","level":3,"spans":[{"id":"spn-35591","text":"Negative / tradeoffs"}]},{"id":"blk-32339","items":[{"blocks":[{"id":"blk-32341","kind":"paragraph","spans":[{"id":"spn-35592","text":"Requires deploying a telemetry secret per deployment and managing injection per provider."}]}],"id":"blk-32340","kind":"list-item"},{"blocks":[{"id":"blk-32343","kind":"paragraph","spans":[{"id":"spn-35593","text":"Requires careful handling of raw request bytes for correct signature verification."}]}],"id":"blk-32342","kind":"list-item"},{"blocks":[{"id":"blk-32345","kind":"paragraph","spans":[{"id":"spn-35594","text":"Adds complexity to runtime code (Pattern A emission) or to adapters (Pattern B emission)."}]}],"id":"blk-32344","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32346","kind":"heading","level":2,"spans":[{"id":"spn-35595","text":"Implementation requirements (checklist)"}]},{"id":"blk-32347","items":[{"blocks":[{"id":"blk-32349","kind":"paragraph","spans":[{"id":"spn-35596","text":"[ ] Each deployment has a telemetry signing secret generated by the control plane."}]}],"id":"blk-32348","kind":"list-item"},{"blocks":[{"id":"blk-32351","kind":"paragraph","spans":[{"id":"spn-35597","text":"[ ] Secret is injected into the runtime provider using provider secret mechanisms."}]}],"id":"blk-32350","kind":"list-item"},{"blocks":[{"id":"blk-32353","kind":"paragraph","spans":[{"id":"spn-35598","text":"[ ] Telemetry endpoint verifies signature using raw request body bytes."}]}],"id":"blk-32352","kind":"list-item"},{"blocks":[{"id":"blk-32355","kind":"paragraph","spans":[{"id":"spn-35599","text":"[ ] Telemetry endpoint cross-checks "},{"id":"spn-35600","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-35601","text":" ownership."}]}],"id":"blk-32354","kind":"list-item"},{"blocks":[{"id":"blk-32357","kind":"paragraph","spans":[{"id":"spn-35602","text":"[ ] Telemetry endpoint is not authenticated via browser sessions/cookies."}]}],"id":"blk-32356","kind":"list-item"},{"blocks":[{"id":"blk-32359","kind":"paragraph","spans":[{"id":"spn-35603","text":"[ ] Telemetry ingestion is idempotent under retries (dedupe window)."}]}],"id":"blk-32358","kind":"list-item"},{"blocks":[{"id":"blk-32361","kind":"paragraph","spans":[{"id":"spn-35604","text":"[ ] Telemetry payloads do not include secret values or full prompt contents by default."}]}],"id":"blk-32360","kind":"list-item"},{"blocks":[{"id":"blk-32363","kind":"paragraph","spans":[{"id":"spn-35605","text":"[ ] Telemetry rejection and signature failures are auditable (sanitized audit log)."}]}],"id":"blk-32362","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32364","kind":"heading","level":2,"spans":[{"id":"spn-35606","text":"Acceptance criteria"}]},{"id":"blk-32365","kind":"paragraph","spans":[{"id":"spn-35607","text":"This ADR is considered correctly implemented when:"}]},{"id":"blk-32366","kind":"paragraph","spans":[{"id":"spn-35608","text":"1. A valid telemetry payload signed with the correct deployment secret is accepted and persisted. 2. The same payload with an invalid signature is rejected and not persisted. 3. A valid signature with mismatched ownership (deployment belongs to a different agent/user) is rejected. 4. Retried telemetry submissions do not cause double-counting within the dedupe strategy window. 5. No plaintext telemetry secret values exist in the primary DB. 6. Telemetry events are attributable to "},{"id":"spn-35609","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-35610","text":" and can be aggregated reliably for billing and limits."}]},{"id":"blk-32367","kind":"heading","level":2,"spans":[{"id":"spn-35611","text":"Follow-ups"}]},{"id":"blk-32368","items":[{"blocks":[{"id":"blk-32370","kind":"paragraph","spans":[{"id":"spn-35612","text":"ADR-0005: Deployment immutability + active pointer model (if not already documented as ADR)."}]}],"id":"blk-32369","kind":"list-item"},{"blocks":[{"id":"blk-32372","kind":"paragraph","spans":[{"id":"spn-35613","text":"Define a standardized "},{"id":"spn-35614","marks":["code"],"text":"eventId"},{"id":"spn-35615","text":" policy if traceId uniqueness cannot be guaranteed."}]}],"id":"blk-32371","kind":"list-item"},{"blocks":[{"id":"blk-32374","kind":"paragraph","spans":[{"id":"spn-35616","text":"Consider stronger anti-replay guarantees (timestamp window + dedupe store) before enabling public agent invocations."}]}],"id":"blk-32373","kind":"list-item"},{"blocks":[{"id":"blk-32376","kind":"paragraph","spans":[{"id":"spn-35617","text":"Consider future hardening for enterprise tiers (PKI signatures or mTLS) if required by compliance/security posture."}]}],"id":"blk-32375","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierajsrea3vhhqrvpu7wnnikxifbpvisx3j546qdhqm7y72dbnq5zdhq","vocabulary":"ampersand.docs.fs.v1"}