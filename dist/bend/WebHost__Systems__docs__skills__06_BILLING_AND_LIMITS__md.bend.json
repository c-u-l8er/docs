{"bendscript":"0.1","blocks":[{"id":"blk-44267","kind":"heading","level":1,"spans":[{"id":"spn-73745","text":"06 — Billing and Limits"}]},{"blocks":[{"id":"blk-44269","kind":"paragraph","spans":[{"id":"spn-73746","marks":["bold"],"text":"Purpose:"},{"id":"spn-73747","text":" Subscription tiers, plan enforcement at invoke and deploy time, checkout and webhook flow, usage aggregation, retention policies, and overage handling."}]}],"id":"blk-44268","kind":"quote"},{"id":"blk-44270","kind":"heading","level":2,"spans":[{"id":"spn-73748","text":"Subscription Tiers"}]},{"head":[{"id":"blk-44272","spans":[{"id":"spn-73749","text":"Feature"}]},{"id":"blk-44273","spans":[{"id":"spn-73750","text":"Free"}]},{"id":"blk-44274","spans":[{"id":"spn-73751","text":"Starter"}]},{"id":"blk-44275","spans":[{"id":"spn-73752","text":"Pro"}]},{"id":"blk-44276","spans":[{"id":"spn-73753","text":"Enterprise"}]}],"id":"blk-44271","kind":"table","rows":[[{"id":"blk-44277","spans":[{"id":"spn-73754","text":"Requests / month"}]},{"id":"blk-44278","spans":[{"id":"spn-73755","text":"1,000"}]},{"id":"blk-44279","spans":[{"id":"spn-73756","text":"10,000"}]},{"id":"blk-44280","spans":[{"id":"spn-73757","text":"100,000"}]},{"id":"blk-44281","spans":[{"id":"spn-73758","text":"Custom"}]}],[{"id":"blk-44282","spans":[{"id":"spn-73759","text":"Token budget / month"}]},{"id":"blk-44283","spans":[{"id":"spn-73760","text":"100K"}]},{"id":"blk-44284","spans":[{"id":"spn-73761","text":"1M"}]},{"id":"blk-44285","spans":[{"id":"spn-73762","text":"10M"}]},{"id":"blk-44286","spans":[{"id":"spn-73763","text":"Custom"}]}],[{"id":"blk-44287","spans":[{"id":"spn-73764","text":"Compute budget (ms) / month"}]},{"id":"blk-44288","spans":[{"id":"spn-73765","text":"60,000"}]},{"id":"blk-44289","spans":[{"id":"spn-73766","text":"600,000"}]},{"id":"blk-44290","spans":[{"id":"spn-73767","text":"6,000,000"}]},{"id":"blk-44291","spans":[{"id":"spn-73768","text":"Custom"}]}],[{"id":"blk-44292","spans":[{"id":"spn-73769","text":"Log retention (days)"}]},{"id":"blk-44293","spans":[{"id":"spn-73770","text":"3"}]},{"id":"blk-44294","spans":[{"id":"spn-73771","text":"14"}]},{"id":"blk-44295","spans":[{"id":"spn-73772","text":"30"}]},{"id":"blk-44296","spans":[{"id":"spn-73773","text":"90+"}]}],[{"id":"blk-44297","spans":[{"id":"spn-73774","text":"Runtime: Cloudflare"}]},{"id":"blk-44298","spans":[{"id":"spn-73775","text":"Yes"}]},{"id":"blk-44299","spans":[{"id":"spn-73776","text":"Yes"}]},{"id":"blk-44300","spans":[{"id":"spn-73777","text":"Yes"}]},{"id":"blk-44301","spans":[{"id":"spn-73778","text":"Yes"}]}],[{"id":"blk-44302","spans":[{"id":"spn-73779","text":"Runtime: AgentCore"}]},{"id":"blk-44303","spans":[{"id":"spn-73780","text":"No"}]},{"id":"blk-44304","spans":[{"id":"spn-73781","text":"No"}]},{"id":"blk-44305","spans":[{"id":"spn-73782","text":"Yes"}]},{"id":"blk-44306","spans":[{"id":"spn-73783","text":"Yes"}]}],[{"id":"blk-44307","spans":[{"id":"spn-73784","text":"Max agents"}]},{"id":"blk-44308","spans":[{"id":"spn-73785","text":"3"}]},{"id":"blk-44309","spans":[{"id":"spn-73786","text":"10"}]},{"id":"blk-44310","spans":[{"id":"spn-73787","text":"50"}]},{"id":"blk-44311","spans":[{"id":"spn-73788","text":"Unlimited"}]}]]},{"id":"blk-44312","kind":"heading","level":2,"spans":[{"id":"spn-73789","text":"Enforcement Points"}]},{"id":"blk-44313","kind":"heading","level":3,"spans":[{"id":"spn-73790","text":"At Invoke Time"}]},{"id":"blk-44314","kind":"paragraph","spans":[{"id":"spn-73791","text":"The invocation gateway checks "},{"id":"spn-73792","marks":["code"],"text":"billing_usage"},{"id":"spn-73793","text":" for the current period before routing to the provider:"}]},{"id":"blk-44315","kind":"code","language":"typescript","text":"const usage = await getBillingUsage(userId, currentPeriod());\nconst limits = TIER_LIMITS[user.subscriptionTier];\n\nif (usage.totalRequests >= limits.maxRequests) {\n  throw new LimitExceededError(\"Monthly request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-44316","kind":"paragraph","spans":[{"id":"spn-73794","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-73795","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-73796","text":" (HTTP 429)."}]},{"id":"blk-44317","kind":"heading","level":3,"spans":[{"id":"spn-73797","text":"At Deploy Time"}]},{"id":"blk-44318","kind":"paragraph","spans":[{"id":"spn-73798","text":"The deploy Edge Function enforces:"}]},{"id":"blk-44319","items":[{"blocks":[{"id":"blk-44321","kind":"paragraph","spans":[{"id":"spn-73799","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-73800","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-44320","kind":"list-item"},{"blocks":[{"id":"blk-44323","kind":"paragraph","spans":[{"id":"spn-73801","marks":["bold"],"text":"Agent count:"},{"id":"spn-73802","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-44322","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44324","kind":"paragraph","spans":[{"id":"spn-73803","text":"max agent count."}]},{"id":"blk-44325","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-44326","kind":"heading","level":2,"spans":[{"id":"spn-73804","text":"Checkout Flow"}]},{"id":"blk-44327","kind":"paragraph","spans":[{"id":"spn-73805","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-44328","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends webhook to /functions/v1/billing/webhook\n6. Edge Function verifies webhook signature\n7. UPDATE users SET subscription_tier = 'pro' WHERE id = user_id"},{"id":"blk-44329","kind":"heading","level":2,"spans":[{"id":"spn-73806","text":"Webhook Events"}]},{"head":[{"id":"blk-44331","spans":[{"id":"spn-73807","text":"Event"}]},{"id":"blk-44332","spans":[{"id":"spn-73808","text":"Action"}]}],"id":"blk-44330","kind":"table","rows":[[{"id":"blk-44333","spans":[{"id":"spn-73809","marks":["code"],"text":"subscription_created"}]},{"id":"blk-44334","spans":[{"id":"spn-73810","text":"Set "},{"id":"spn-73811","marks":["code"],"text":"subscription_tier"},{"id":"spn-73812","text":" to new tier"}]}],[{"id":"blk-44335","spans":[{"id":"spn-73813","marks":["code"],"text":"subscription_updated"}]},{"id":"blk-44336","spans":[{"id":"spn-73814","text":"Update tier (upgrade/downgrade)"}]}],[{"id":"blk-44337","spans":[{"id":"spn-73815","marks":["code"],"text":"subscription_cancelled"}]},{"id":"blk-44338","spans":[{"id":"spn-73816","text":"Downgrade to "},{"id":"spn-73817","marks":["code"],"text":"free"},{"id":"spn-73818","text":" at period end"}]}],[{"id":"blk-44339","spans":[{"id":"spn-73819","marks":["code"],"text":"subscription_payment_failed"}]},{"id":"blk-44340","spans":[{"id":"spn-73820","text":"Flag account; optionally restrict after grace"}]}]]},{"id":"blk-44341","kind":"paragraph","spans":[{"id":"spn-73821","text":"The webhook Edge Function:"}]},{"id":"blk-44342","items":[{"blocks":[{"id":"blk-44344","kind":"paragraph","spans":[{"id":"spn-73822","text":"Verifies the "},{"id":"spn-73823","marks":["code"],"text":"X-Signature"},{"id":"spn-73824","text":" header against the webhook secret"}]}],"id":"blk-44343","kind":"list-item"},{"blocks":[{"id":"blk-44346","kind":"paragraph","spans":[{"id":"spn-73825","text":"Extracts user identity from webhook payload metadata"}]}],"id":"blk-44345","kind":"list-item"},{"blocks":[{"id":"blk-44348","kind":"paragraph","spans":[{"id":"spn-73826","text":"Updates "},{"id":"spn-73827","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-73828","text":" accordingly"}]}],"id":"blk-44347","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-44349","kind":"heading","level":2,"spans":[{"id":"spn-73829","text":"Usage Aggregation"}]},{"id":"blk-44350","kind":"paragraph","spans":[{"id":"spn-73830","text":"Raw "},{"id":"spn-73831","marks":["code"],"text":"metrics_events"},{"id":"spn-73832","text":" are aggregated into "},{"id":"spn-73833","marks":["code"],"text":"billing_usage"},{"id":"spn-73834","text":" by "},{"id":"spn-73835","marks":["code"],"text":"pg_cron"},{"id":"spn-73836","text":":"}]},{"id":"blk-44351","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-44352","kind":"paragraph","spans":[{"id":"spn-73837","text":"The "},{"id":"spn-73838","marks":["code"],"text":"period_key"},{"id":"spn-73839","text":" format is "},{"id":"spn-73840","marks":["code"],"text":"YYYY-MM"},{"id":"spn-73841","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-44353","kind":"heading","level":2,"spans":[{"id":"spn-73842","text":"Retention Policies"}]},{"id":"blk-44354","kind":"paragraph","spans":[{"id":"spn-73843","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-44356","spans":[{"id":"spn-73844","text":"Tier"}]},{"id":"blk-44357","spans":[{"id":"spn-73845","marks":["code"],"text":"metrics_events"},{"id":"spn-73846","text":" retention"}]}],"id":"blk-44355","kind":"table","rows":[[{"id":"blk-44358","spans":[{"id":"spn-73847","text":"Free"}]},{"id":"blk-44359","spans":[{"id":"spn-73848","text":"3 days"}]}],[{"id":"blk-44360","spans":[{"id":"spn-73849","text":"Starter"}]},{"id":"blk-44361","spans":[{"id":"spn-73850","text":"14 days"}]}],[{"id":"blk-44362","spans":[{"id":"spn-73851","text":"Pro"}]},{"id":"blk-44363","spans":[{"id":"spn-73852","text":"30 days"}]}],[{"id":"blk-44364","spans":[{"id":"spn-73853","text":"Enterprise"}]},{"id":"blk-44365","spans":[{"id":"spn-73854","text":"90+ days"}]}]]},{"id":"blk-44366","kind":"paragraph","spans":[{"id":"spn-73855","text":"A "},{"id":"spn-73856","marks":["code"],"text":"pg_cron"},{"id":"spn-73857","text":" job periodically deletes old "},{"id":"spn-73858","marks":["code"],"text":"metrics_events"},{"id":"spn-73859","text":" rows:"}]},{"id":"blk-44367","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-44368","kind":"paragraph","spans":[{"id":"spn-73860","marks":["code"],"text":"billing_usage"},{"id":"spn-73861","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-44369","kind":"heading","level":2,"spans":[{"id":"spn-73862","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-44370","kind":"paragraph","spans":[{"id":"spn-73863","text":"MVP uses "},{"id":"spn-73864","marks":["bold"],"text":"hard stop"},{"id":"spn-73865","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-44371","kind":"paragraph","spans":[{"id":"spn-73866","text":"Post-MVP options:"}]},{"id":"blk-44372","items":[{"blocks":[{"id":"blk-44374","kind":"paragraph","spans":[{"id":"spn-73867","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-73868","text":" Allow overages at a per-unit rate, billed at period end."}]}],"id":"blk-44373","kind":"list-item"},{"blocks":[{"id":"blk-44376","kind":"paragraph","spans":[{"id":"spn-73869","marks":["bold"],"text":"Soft limits:"},{"id":"spn-73870","text":" Warn users at 80% and 100%, hard stop at 120%."}]}],"id":"blk-44375","kind":"list-item"},{"blocks":[{"id":"blk-44378","kind":"paragraph","spans":[{"id":"spn-73871","marks":["bold"],"text":"Reconciled billing:"},{"id":"spn-73872","text":" Reconcile estimated costs with provider billing exports."}]}],"id":"blk-44377","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-44379","kind":"heading","level":2,"spans":[{"id":"spn-73873","text":"Checklist"}]},{"id":"blk-44380","items":[{"blocks":[{"id":"blk-44382","kind":"paragraph","spans":[{"id":"spn-73874","text":"[ ] Tier limits are defined and stored in a configuration table or constants"}]}],"id":"blk-44381","kind":"list-item"},{"blocks":[{"id":"blk-44384","kind":"paragraph","spans":[{"id":"spn-73875","text":"[ ] Invocation gateway checks all three limit types (requests, tokens, compute)"}]}],"id":"blk-44383","kind":"list-item"},{"blocks":[{"id":"blk-44386","kind":"paragraph","spans":[{"id":"spn-73876","text":"[ ] Deploy enforces runtime gating and agent count limits"}]}],"id":"blk-44385","kind":"list-item"},{"blocks":[{"id":"blk-44388","kind":"paragraph","spans":[{"id":"spn-73877","text":"[ ] Checkout creates a valid billing provider session"}]}],"id":"blk-44387","kind":"list-item"},{"blocks":[{"id":"blk-44390","kind":"paragraph","spans":[{"id":"spn-73878","text":"[ ] Webhook verifies signature before processing"}]}],"id":"blk-44389","kind":"list-item"},{"blocks":[{"id":"blk-44392","kind":"paragraph","spans":[{"id":"spn-73879","text":"[ ] "},{"id":"spn-73880","marks":["code"],"text":"subscription_tier"},{"id":"spn-73881","text":" is updated transactionally on webhook events"}]}],"id":"blk-44391","kind":"list-item"},{"blocks":[{"id":"blk-44394","kind":"paragraph","spans":[{"id":"spn-73882","text":"[ ] Aggregation job runs on schedule and handles partial failures"}]}],"id":"blk-44393","kind":"list-item"},{"blocks":[{"id":"blk-44396","kind":"paragraph","spans":[{"id":"spn-73883","text":"[ ] Retention cleanup job respects per-tier retention windows"}]}],"id":"blk-44395","kind":"list-item"},{"blocks":[{"id":"blk-44398","kind":"paragraph","spans":[{"id":"spn-73884","text":"[ ] Downgrade on cancellation is deferred to period end"}]}],"id":"blk-44397","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera3miha6jfym5ztiwmqujmsx6lao3v3f6fe7d6lecglpksr5bx7nxq","vocabulary":"ampersand.docs.fs.v1"}