{"bendscript":"0.1","blocks":[{"id":"blk-25048","kind":"heading","level":1,"spans":[{"id":"spn-29736","text":"06 — Billing and Limits"}]},{"blocks":[{"id":"blk-25050","kind":"paragraph","spans":[{"id":"spn-29737","marks":["bold"],"text":"Purpose:"},{"id":"spn-29738","text":" Subscription tiers, plan enforcement at invoke and deploy time, checkout and webhook flow, usage aggregation, retention policies, and overage handling."}]}],"id":"blk-25049","kind":"quote"},{"id":"blk-25051","kind":"paragraph","spans":[{"id":"spn-29739","text":"---"}]},{"id":"blk-25052","kind":"heading","level":2,"spans":[{"id":"spn-29740","text":"Subscription Tiers"}]},{"head":[{"id":"blk-25054","spans":[{"id":"spn-29741","text":"Feature"}]},{"id":"blk-25055","spans":[{"id":"spn-29742","text":"Free"}]},{"id":"blk-25056","spans":[{"id":"spn-29743","text":"Starter"}]},{"id":"blk-25057","spans":[{"id":"spn-29744","text":"Pro"}]},{"id":"blk-25058","spans":[{"id":"spn-29745","text":"Enterprise"}]}],"id":"blk-25053","kind":"table","rows":[[{"id":"blk-25059","spans":[{"id":"spn-29746","text":"Requests / month"}]},{"id":"blk-25060","spans":[{"id":"spn-29747","text":"1,000"}]},{"id":"blk-25061","spans":[{"id":"spn-29748","text":"10,000"}]},{"id":"blk-25062","spans":[{"id":"spn-29749","text":"100,000"}]},{"id":"blk-25063","spans":[{"id":"spn-29750","text":"Custom"}]}],[{"id":"blk-25064","spans":[{"id":"spn-29751","text":"Token budget / month"}]},{"id":"blk-25065","spans":[{"id":"spn-29752","text":"100K"}]},{"id":"blk-25066","spans":[{"id":"spn-29753","text":"1M"}]},{"id":"blk-25067","spans":[{"id":"spn-29754","text":"10M"}]},{"id":"blk-25068","spans":[{"id":"spn-29755","text":"Custom"}]}],[{"id":"blk-25069","spans":[{"id":"spn-29756","text":"Compute budget (ms) / month"}]},{"id":"blk-25070","spans":[{"id":"spn-29757","text":"60,000"}]},{"id":"blk-25071","spans":[{"id":"spn-29758","text":"600,000"}]},{"id":"blk-25072","spans":[{"id":"spn-29759","text":"6,000,000"}]},{"id":"blk-25073","spans":[{"id":"spn-29760","text":"Custom"}]}],[{"id":"blk-25074","spans":[{"id":"spn-29761","text":"Log retention (days)"}]},{"id":"blk-25075","spans":[{"id":"spn-29762","text":"3"}]},{"id":"blk-25076","spans":[{"id":"spn-29763","text":"14"}]},{"id":"blk-25077","spans":[{"id":"spn-29764","text":"30"}]},{"id":"blk-25078","spans":[{"id":"spn-29765","text":"90+"}]}],[{"id":"blk-25079","spans":[{"id":"spn-29766","text":"Runtime: Cloudflare"}]},{"id":"blk-25080","spans":[{"id":"spn-29767","text":"Yes"}]},{"id":"blk-25081","spans":[{"id":"spn-29768","text":"Yes"}]},{"id":"blk-25082","spans":[{"id":"spn-29769","text":"Yes"}]},{"id":"blk-25083","spans":[{"id":"spn-29770","text":"Yes"}]}],[{"id":"blk-25084","spans":[{"id":"spn-29771","text":"Runtime: AgentCore"}]},{"id":"blk-25085","spans":[{"id":"spn-29772","text":"No"}]},{"id":"blk-25086","spans":[{"id":"spn-29773","text":"No"}]},{"id":"blk-25087","spans":[{"id":"spn-29774","text":"Yes"}]},{"id":"blk-25088","spans":[{"id":"spn-29775","text":"Yes"}]}],[{"id":"blk-25089","spans":[{"id":"spn-29776","text":"Max agents"}]},{"id":"blk-25090","spans":[{"id":"spn-29777","text":"3"}]},{"id":"blk-25091","spans":[{"id":"spn-29778","text":"10"}]},{"id":"blk-25092","spans":[{"id":"spn-29779","text":"50"}]},{"id":"blk-25093","spans":[{"id":"spn-29780","text":"Unlimited"}]}]]},{"id":"blk-25094","kind":"paragraph","spans":[{"id":"spn-29781","text":"---"}]},{"id":"blk-25095","kind":"heading","level":2,"spans":[{"id":"spn-29782","text":"Enforcement Points"}]},{"id":"blk-25096","kind":"heading","level":3,"spans":[{"id":"spn-29783","text":"At Invoke Time"}]},{"id":"blk-25097","kind":"paragraph","spans":[{"id":"spn-29784","text":"The invocation gateway checks "},{"id":"spn-29785","marks":["code"],"text":"billing_usage"},{"id":"spn-29786","text":" for the current period before routing to the provider:"}]},{"id":"blk-25098","kind":"code","language":"typescript","text":"const usage = await getBillingUsage(userId, currentPeriod());\nconst limits = TIER_LIMITS[user.subscriptionTier];\n\nif (usage.totalRequests >= limits.maxRequests) {\n  throw new LimitExceededError(\"Monthly request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-25099","kind":"paragraph","spans":[{"id":"spn-29787","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-29788","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-29789","text":" (HTTP 429)."}]},{"id":"blk-25100","kind":"heading","level":3,"spans":[{"id":"spn-29790","text":"At Deploy Time"}]},{"id":"blk-25101","kind":"paragraph","spans":[{"id":"spn-29791","text":"The deploy Edge Function enforces:"}]},{"id":"blk-25102","items":[{"blocks":[{"id":"blk-25104","kind":"paragraph","spans":[{"id":"spn-29792","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-29793","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-25103","kind":"list-item"},{"blocks":[{"id":"blk-25106","kind":"paragraph","spans":[{"id":"spn-29794","marks":["bold"],"text":"Agent count:"},{"id":"spn-29795","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-25105","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25107","kind":"paragraph","spans":[{"id":"spn-29796","text":"max agent count."}]},{"id":"blk-25108","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-25109","kind":"paragraph","spans":[{"id":"spn-29797","text":"---"}]},{"id":"blk-25110","kind":"heading","level":2,"spans":[{"id":"spn-29798","text":"Checkout Flow"}]},{"id":"blk-25111","kind":"paragraph","spans":[{"id":"spn-29799","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-25112","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends webhook to /functions/v1/billing/webhook\n6. Edge Function verifies webhook signature\n7. UPDATE users SET subscription_tier = 'pro' WHERE id = user_id"},{"id":"blk-25113","kind":"paragraph","spans":[{"id":"spn-29800","text":"---"}]},{"id":"blk-25114","kind":"heading","level":2,"spans":[{"id":"spn-29801","text":"Webhook Events"}]},{"head":[{"id":"blk-25116","spans":[{"id":"spn-29802","text":"Event"}]},{"id":"blk-25117","spans":[{"id":"spn-29803","text":"Action"}]}],"id":"blk-25115","kind":"table","rows":[[{"id":"blk-25118","spans":[{"id":"spn-29804","marks":["code"],"text":"subscription_created"}]},{"id":"blk-25119","spans":[{"id":"spn-29805","text":"Set "},{"id":"spn-29806","marks":["code"],"text":"subscription_tier"},{"id":"spn-29807","text":" to new tier"}]}],[{"id":"blk-25120","spans":[{"id":"spn-29808","marks":["code"],"text":"subscription_updated"}]},{"id":"blk-25121","spans":[{"id":"spn-29809","text":"Update tier (upgrade/downgrade)"}]}],[{"id":"blk-25122","spans":[{"id":"spn-29810","marks":["code"],"text":"subscription_cancelled"}]},{"id":"blk-25123","spans":[{"id":"spn-29811","text":"Downgrade to "},{"id":"spn-29812","marks":["code"],"text":"free"},{"id":"spn-29813","text":" at period end"}]}],[{"id":"blk-25124","spans":[{"id":"spn-29814","marks":["code"],"text":"subscription_payment_failed"}]},{"id":"blk-25125","spans":[{"id":"spn-29815","text":"Flag account; optionally restrict after grace"}]}]]},{"id":"blk-25126","kind":"paragraph","spans":[{"id":"spn-29816","text":"The webhook Edge Function:"}]},{"id":"blk-25127","kind":"paragraph","spans":[{"id":"spn-29817","text":"1. Verifies the "},{"id":"spn-29818","marks":["code"],"text":"X-Signature"},{"id":"spn-29819","text":" header against the webhook secret 2. Extracts user identity from webhook payload metadata 3. Updates "},{"id":"spn-29820","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-29821","text":" accordingly"}]},{"id":"blk-25128","kind":"paragraph","spans":[{"id":"spn-29822","text":"---"}]},{"id":"blk-25129","kind":"heading","level":2,"spans":[{"id":"spn-29823","text":"Usage Aggregation"}]},{"id":"blk-25130","kind":"paragraph","spans":[{"id":"spn-29824","text":"Raw "},{"id":"spn-29825","marks":["code"],"text":"metrics_events"},{"id":"spn-29826","text":" are aggregated into "},{"id":"spn-29827","marks":["code"],"text":"billing_usage"},{"id":"spn-29828","text":" by "},{"id":"spn-29829","marks":["code"],"text":"pg_cron"},{"id":"spn-29830","text":":"}]},{"id":"blk-25131","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-25132","kind":"paragraph","spans":[{"id":"spn-29831","text":"The "},{"id":"spn-29832","marks":["code"],"text":"period_key"},{"id":"spn-29833","text":" format is "},{"id":"spn-29834","marks":["code"],"text":"YYYY-MM"},{"id":"spn-29835","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-25133","kind":"paragraph","spans":[{"id":"spn-29836","text":"---"}]},{"id":"blk-25134","kind":"heading","level":2,"spans":[{"id":"spn-29837","text":"Retention Policies"}]},{"id":"blk-25135","kind":"paragraph","spans":[{"id":"spn-29838","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-25137","spans":[{"id":"spn-29839","text":"Tier"}]},{"id":"blk-25138","spans":[{"id":"spn-29840","marks":["code"],"text":"metrics_events"},{"id":"spn-29841","text":" retention"}]}],"id":"blk-25136","kind":"table","rows":[[{"id":"blk-25139","spans":[{"id":"spn-29842","text":"Free"}]},{"id":"blk-25140","spans":[{"id":"spn-29843","text":"3 days"}]}],[{"id":"blk-25141","spans":[{"id":"spn-29844","text":"Starter"}]},{"id":"blk-25142","spans":[{"id":"spn-29845","text":"14 days"}]}],[{"id":"blk-25143","spans":[{"id":"spn-29846","text":"Pro"}]},{"id":"blk-25144","spans":[{"id":"spn-29847","text":"30 days"}]}],[{"id":"blk-25145","spans":[{"id":"spn-29848","text":"Enterprise"}]},{"id":"blk-25146","spans":[{"id":"spn-29849","text":"90+ days"}]}]]},{"id":"blk-25147","kind":"paragraph","spans":[{"id":"spn-29850","text":"A "},{"id":"spn-29851","marks":["code"],"text":"pg_cron"},{"id":"spn-29852","text":" job periodically deletes old "},{"id":"spn-29853","marks":["code"],"text":"metrics_events"},{"id":"spn-29854","text":" rows:"}]},{"id":"blk-25148","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-25149","kind":"paragraph","spans":[{"id":"spn-29855","marks":["code"],"text":"billing_usage"},{"id":"spn-29856","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-25150","kind":"paragraph","spans":[{"id":"spn-29857","text":"---"}]},{"id":"blk-25151","kind":"heading","level":2,"spans":[{"id":"spn-29858","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-25152","kind":"paragraph","spans":[{"id":"spn-29859","text":"MVP uses "},{"id":"spn-29860","marks":["bold"],"text":"hard stop"},{"id":"spn-29861","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-25153","kind":"paragraph","spans":[{"id":"spn-29862","text":"Post-MVP options:"}]},{"id":"blk-25154","kind":"paragraph","spans":[{"id":"spn-29863","text":"1. "},{"id":"spn-29864","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-29865","text":" Allow overages at a per-unit rate, billed at period end. 2. "},{"id":"spn-29866","marks":["bold"],"text":"Soft limits:"},{"id":"spn-29867","text":" Warn users at 80% and 100%, hard stop at 120%. 3. "},{"id":"spn-29868","marks":["bold"],"text":"Reconciled billing:"},{"id":"spn-29869","text":" Reconcile estimated costs with provider billing exports."}]},{"id":"blk-25155","kind":"paragraph","spans":[{"id":"spn-29870","text":"---"}]},{"id":"blk-25156","kind":"heading","level":2,"spans":[{"id":"spn-29871","text":"Checklist"}]},{"id":"blk-25157","items":[{"blocks":[{"id":"blk-25159","kind":"paragraph","spans":[{"id":"spn-29872","text":"[ ] Tier limits are defined and stored in a configuration table or constants"}]}],"id":"blk-25158","kind":"list-item"},{"blocks":[{"id":"blk-25161","kind":"paragraph","spans":[{"id":"spn-29873","text":"[ ] Invocation gateway checks all three limit types (requests, tokens, compute)"}]}],"id":"blk-25160","kind":"list-item"},{"blocks":[{"id":"blk-25163","kind":"paragraph","spans":[{"id":"spn-29874","text":"[ ] Deploy enforces runtime gating and agent count limits"}]}],"id":"blk-25162","kind":"list-item"},{"blocks":[{"id":"blk-25165","kind":"paragraph","spans":[{"id":"spn-29875","text":"[ ] Checkout creates a valid billing provider session"}]}],"id":"blk-25164","kind":"list-item"},{"blocks":[{"id":"blk-25167","kind":"paragraph","spans":[{"id":"spn-29876","text":"[ ] Webhook verifies signature before processing"}]}],"id":"blk-25166","kind":"list-item"},{"blocks":[{"id":"blk-25169","kind":"paragraph","spans":[{"id":"spn-29877","text":"[ ] "},{"id":"spn-29878","marks":["code"],"text":"subscription_tier"},{"id":"spn-29879","text":" is updated transactionally on webhook events"}]}],"id":"blk-25168","kind":"list-item"},{"blocks":[{"id":"blk-25171","kind":"paragraph","spans":[{"id":"spn-29880","text":"[ ] Aggregation job runs on schedule and handles partial failures"}]}],"id":"blk-25170","kind":"list-item"},{"blocks":[{"id":"blk-25173","kind":"paragraph","spans":[{"id":"spn-29881","text":"[ ] Retention cleanup job respects per-tier retention windows"}]}],"id":"blk-25172","kind":"list-item"},{"blocks":[{"id":"blk-25175","kind":"paragraph","spans":[{"id":"spn-29882","text":"[ ] Downgrade on cancellation is deferred to period end"}]}],"id":"blk-25174","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieran7h7y74yx5yrcxzfb4khcab6cbku4kckainvj37sgamye6e3kc7a","vocabulary":"ampersand.docs.fs.v1"}