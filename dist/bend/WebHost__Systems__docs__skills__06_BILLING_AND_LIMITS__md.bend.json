{"bendscript":"0.1","blocks":[{"id":"blk-43549","kind":"heading","level":1,"spans":[{"id":"spn-71343","text":"06 — Billing and Limits"}]},{"blocks":[{"id":"blk-43551","kind":"paragraph","spans":[{"id":"spn-71344","marks":["bold"],"text":"Purpose:"},{"id":"spn-71345","text":" Subscription tiers, plan enforcement at invoke and deploy time, checkout and webhook flow, usage aggregation, retention policies, and overage handling."}]}],"id":"blk-43550","kind":"quote"},{"id":"blk-43552","kind":"heading","level":2,"spans":[{"id":"spn-71346","text":"Subscription Tiers"}]},{"head":[{"id":"blk-43554","spans":[{"id":"spn-71347","text":"Feature"}]},{"id":"blk-43555","spans":[{"id":"spn-71348","text":"Free"}]},{"id":"blk-43556","spans":[{"id":"spn-71349","text":"Starter"}]},{"id":"blk-43557","spans":[{"id":"spn-71350","text":"Pro"}]},{"id":"blk-43558","spans":[{"id":"spn-71351","text":"Enterprise"}]}],"id":"blk-43553","kind":"table","rows":[[{"id":"blk-43559","spans":[{"id":"spn-71352","text":"Requests / month"}]},{"id":"blk-43560","spans":[{"id":"spn-71353","text":"1,000"}]},{"id":"blk-43561","spans":[{"id":"spn-71354","text":"10,000"}]},{"id":"blk-43562","spans":[{"id":"spn-71355","text":"100,000"}]},{"id":"blk-43563","spans":[{"id":"spn-71356","text":"Custom"}]}],[{"id":"blk-43564","spans":[{"id":"spn-71357","text":"Token budget / month"}]},{"id":"blk-43565","spans":[{"id":"spn-71358","text":"100K"}]},{"id":"blk-43566","spans":[{"id":"spn-71359","text":"1M"}]},{"id":"blk-43567","spans":[{"id":"spn-71360","text":"10M"}]},{"id":"blk-43568","spans":[{"id":"spn-71361","text":"Custom"}]}],[{"id":"blk-43569","spans":[{"id":"spn-71362","text":"Compute budget (ms) / month"}]},{"id":"blk-43570","spans":[{"id":"spn-71363","text":"60,000"}]},{"id":"blk-43571","spans":[{"id":"spn-71364","text":"600,000"}]},{"id":"blk-43572","spans":[{"id":"spn-71365","text":"6,000,000"}]},{"id":"blk-43573","spans":[{"id":"spn-71366","text":"Custom"}]}],[{"id":"blk-43574","spans":[{"id":"spn-71367","text":"Log retention (days)"}]},{"id":"blk-43575","spans":[{"id":"spn-71368","text":"3"}]},{"id":"blk-43576","spans":[{"id":"spn-71369","text":"14"}]},{"id":"blk-43577","spans":[{"id":"spn-71370","text":"30"}]},{"id":"blk-43578","spans":[{"id":"spn-71371","text":"90+"}]}],[{"id":"blk-43579","spans":[{"id":"spn-71372","text":"Runtime: Cloudflare"}]},{"id":"blk-43580","spans":[{"id":"spn-71373","text":"Yes"}]},{"id":"blk-43581","spans":[{"id":"spn-71374","text":"Yes"}]},{"id":"blk-43582","spans":[{"id":"spn-71375","text":"Yes"}]},{"id":"blk-43583","spans":[{"id":"spn-71376","text":"Yes"}]}],[{"id":"blk-43584","spans":[{"id":"spn-71377","text":"Runtime: AgentCore"}]},{"id":"blk-43585","spans":[{"id":"spn-71378","text":"No"}]},{"id":"blk-43586","spans":[{"id":"spn-71379","text":"No"}]},{"id":"blk-43587","spans":[{"id":"spn-71380","text":"Yes"}]},{"id":"blk-43588","spans":[{"id":"spn-71381","text":"Yes"}]}],[{"id":"blk-43589","spans":[{"id":"spn-71382","text":"Max agents"}]},{"id":"blk-43590","spans":[{"id":"spn-71383","text":"3"}]},{"id":"blk-43591","spans":[{"id":"spn-71384","text":"10"}]},{"id":"blk-43592","spans":[{"id":"spn-71385","text":"50"}]},{"id":"blk-43593","spans":[{"id":"spn-71386","text":"Unlimited"}]}]]},{"id":"blk-43594","kind":"heading","level":2,"spans":[{"id":"spn-71387","text":"Enforcement Points"}]},{"id":"blk-43595","kind":"heading","level":3,"spans":[{"id":"spn-71388","text":"At Invoke Time"}]},{"id":"blk-43596","kind":"paragraph","spans":[{"id":"spn-71389","text":"The invocation gateway checks "},{"id":"spn-71390","marks":["code"],"text":"billing_usage"},{"id":"spn-71391","text":" for the current period before routing to the provider:"}]},{"id":"blk-43597","kind":"code","language":"typescript","text":"const usage = await getBillingUsage(userId, currentPeriod());\nconst limits = TIER_LIMITS[user.subscriptionTier];\n\nif (usage.totalRequests >= limits.maxRequests) {\n  throw new LimitExceededError(\"Monthly request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-43598","kind":"paragraph","spans":[{"id":"spn-71392","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-71393","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-71394","text":" (HTTP 429)."}]},{"id":"blk-43599","kind":"heading","level":3,"spans":[{"id":"spn-71395","text":"At Deploy Time"}]},{"id":"blk-43600","kind":"paragraph","spans":[{"id":"spn-71396","text":"The deploy Edge Function enforces:"}]},{"id":"blk-43601","items":[{"blocks":[{"id":"blk-43603","kind":"paragraph","spans":[{"id":"spn-71397","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-71398","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-43602","kind":"list-item"},{"blocks":[{"id":"blk-43605","kind":"paragraph","spans":[{"id":"spn-71399","marks":["bold"],"text":"Agent count:"},{"id":"spn-71400","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-43604","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43606","kind":"paragraph","spans":[{"id":"spn-71401","text":"max agent count."}]},{"id":"blk-43607","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-43608","kind":"heading","level":2,"spans":[{"id":"spn-71402","text":"Checkout Flow"}]},{"id":"blk-43609","kind":"paragraph","spans":[{"id":"spn-71403","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-43610","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends webhook to /functions/v1/billing/webhook\n6. Edge Function verifies webhook signature\n7. UPDATE users SET subscription_tier = 'pro' WHERE id = user_id"},{"id":"blk-43611","kind":"heading","level":2,"spans":[{"id":"spn-71404","text":"Webhook Events"}]},{"head":[{"id":"blk-43613","spans":[{"id":"spn-71405","text":"Event"}]},{"id":"blk-43614","spans":[{"id":"spn-71406","text":"Action"}]}],"id":"blk-43612","kind":"table","rows":[[{"id":"blk-43615","spans":[{"id":"spn-71407","marks":["code"],"text":"subscription_created"}]},{"id":"blk-43616","spans":[{"id":"spn-71408","text":"Set "},{"id":"spn-71409","marks":["code"],"text":"subscription_tier"},{"id":"spn-71410","text":" to new tier"}]}],[{"id":"blk-43617","spans":[{"id":"spn-71411","marks":["code"],"text":"subscription_updated"}]},{"id":"blk-43618","spans":[{"id":"spn-71412","text":"Update tier (upgrade/downgrade)"}]}],[{"id":"blk-43619","spans":[{"id":"spn-71413","marks":["code"],"text":"subscription_cancelled"}]},{"id":"blk-43620","spans":[{"id":"spn-71414","text":"Downgrade to "},{"id":"spn-71415","marks":["code"],"text":"free"},{"id":"spn-71416","text":" at period end"}]}],[{"id":"blk-43621","spans":[{"id":"spn-71417","marks":["code"],"text":"subscription_payment_failed"}]},{"id":"blk-43622","spans":[{"id":"spn-71418","text":"Flag account; optionally restrict after grace"}]}]]},{"id":"blk-43623","kind":"paragraph","spans":[{"id":"spn-71419","text":"The webhook Edge Function:"}]},{"id":"blk-43624","items":[{"blocks":[{"id":"blk-43626","kind":"paragraph","spans":[{"id":"spn-71420","text":"Verifies the "},{"id":"spn-71421","marks":["code"],"text":"X-Signature"},{"id":"spn-71422","text":" header against the webhook secret"}]}],"id":"blk-43625","kind":"list-item"},{"blocks":[{"id":"blk-43628","kind":"paragraph","spans":[{"id":"spn-71423","text":"Extracts user identity from webhook payload metadata"}]}],"id":"blk-43627","kind":"list-item"},{"blocks":[{"id":"blk-43630","kind":"paragraph","spans":[{"id":"spn-71424","text":"Updates "},{"id":"spn-71425","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-71426","text":" accordingly"}]}],"id":"blk-43629","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43631","kind":"heading","level":2,"spans":[{"id":"spn-71427","text":"Usage Aggregation"}]},{"id":"blk-43632","kind":"paragraph","spans":[{"id":"spn-71428","text":"Raw "},{"id":"spn-71429","marks":["code"],"text":"metrics_events"},{"id":"spn-71430","text":" are aggregated into "},{"id":"spn-71431","marks":["code"],"text":"billing_usage"},{"id":"spn-71432","text":" by "},{"id":"spn-71433","marks":["code"],"text":"pg_cron"},{"id":"spn-71434","text":":"}]},{"id":"blk-43633","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-43634","kind":"paragraph","spans":[{"id":"spn-71435","text":"The "},{"id":"spn-71436","marks":["code"],"text":"period_key"},{"id":"spn-71437","text":" format is "},{"id":"spn-71438","marks":["code"],"text":"YYYY-MM"},{"id":"spn-71439","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-43635","kind":"heading","level":2,"spans":[{"id":"spn-71440","text":"Retention Policies"}]},{"id":"blk-43636","kind":"paragraph","spans":[{"id":"spn-71441","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-43638","spans":[{"id":"spn-71442","text":"Tier"}]},{"id":"blk-43639","spans":[{"id":"spn-71443","marks":["code"],"text":"metrics_events"},{"id":"spn-71444","text":" retention"}]}],"id":"blk-43637","kind":"table","rows":[[{"id":"blk-43640","spans":[{"id":"spn-71445","text":"Free"}]},{"id":"blk-43641","spans":[{"id":"spn-71446","text":"3 days"}]}],[{"id":"blk-43642","spans":[{"id":"spn-71447","text":"Starter"}]},{"id":"blk-43643","spans":[{"id":"spn-71448","text":"14 days"}]}],[{"id":"blk-43644","spans":[{"id":"spn-71449","text":"Pro"}]},{"id":"blk-43645","spans":[{"id":"spn-71450","text":"30 days"}]}],[{"id":"blk-43646","spans":[{"id":"spn-71451","text":"Enterprise"}]},{"id":"blk-43647","spans":[{"id":"spn-71452","text":"90+ days"}]}]]},{"id":"blk-43648","kind":"paragraph","spans":[{"id":"spn-71453","text":"A "},{"id":"spn-71454","marks":["code"],"text":"pg_cron"},{"id":"spn-71455","text":" job periodically deletes old "},{"id":"spn-71456","marks":["code"],"text":"metrics_events"},{"id":"spn-71457","text":" rows:"}]},{"id":"blk-43649","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-43650","kind":"paragraph","spans":[{"id":"spn-71458","marks":["code"],"text":"billing_usage"},{"id":"spn-71459","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-43651","kind":"heading","level":2,"spans":[{"id":"spn-71460","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-43652","kind":"paragraph","spans":[{"id":"spn-71461","text":"MVP uses "},{"id":"spn-71462","marks":["bold"],"text":"hard stop"},{"id":"spn-71463","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-43653","kind":"paragraph","spans":[{"id":"spn-71464","text":"Post-MVP options:"}]},{"id":"blk-43654","items":[{"blocks":[{"id":"blk-43656","kind":"paragraph","spans":[{"id":"spn-71465","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-71466","text":" Allow overages at a per-unit rate, billed at period end."}]}],"id":"blk-43655","kind":"list-item"},{"blocks":[{"id":"blk-43658","kind":"paragraph","spans":[{"id":"spn-71467","marks":["bold"],"text":"Soft limits:"},{"id":"spn-71468","text":" Warn users at 80% and 100%, hard stop at 120%."}]}],"id":"blk-43657","kind":"list-item"},{"blocks":[{"id":"blk-43660","kind":"paragraph","spans":[{"id":"spn-71469","marks":["bold"],"text":"Reconciled billing:"},{"id":"spn-71470","text":" Reconcile estimated costs with provider billing exports."}]}],"id":"blk-43659","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43661","kind":"heading","level":2,"spans":[{"id":"spn-71471","text":"Checklist"}]},{"id":"blk-43662","items":[{"blocks":[{"id":"blk-43664","kind":"paragraph","spans":[{"id":"spn-71472","text":"[ ] Tier limits are defined and stored in a configuration table or constants"}]}],"id":"blk-43663","kind":"list-item"},{"blocks":[{"id":"blk-43666","kind":"paragraph","spans":[{"id":"spn-71473","text":"[ ] Invocation gateway checks all three limit types (requests, tokens, compute)"}]}],"id":"blk-43665","kind":"list-item"},{"blocks":[{"id":"blk-43668","kind":"paragraph","spans":[{"id":"spn-71474","text":"[ ] Deploy enforces runtime gating and agent count limits"}]}],"id":"blk-43667","kind":"list-item"},{"blocks":[{"id":"blk-43670","kind":"paragraph","spans":[{"id":"spn-71475","text":"[ ] Checkout creates a valid billing provider session"}]}],"id":"blk-43669","kind":"list-item"},{"blocks":[{"id":"blk-43672","kind":"paragraph","spans":[{"id":"spn-71476","text":"[ ] Webhook verifies signature before processing"}]}],"id":"blk-43671","kind":"list-item"},{"blocks":[{"id":"blk-43674","kind":"paragraph","spans":[{"id":"spn-71477","text":"[ ] "},{"id":"spn-71478","marks":["code"],"text":"subscription_tier"},{"id":"spn-71479","text":" is updated transactionally on webhook events"}]}],"id":"blk-43673","kind":"list-item"},{"blocks":[{"id":"blk-43676","kind":"paragraph","spans":[{"id":"spn-71480","text":"[ ] Aggregation job runs on schedule and handles partial failures"}]}],"id":"blk-43675","kind":"list-item"},{"blocks":[{"id":"blk-43678","kind":"paragraph","spans":[{"id":"spn-71481","text":"[ ] Retention cleanup job respects per-tier retention windows"}]}],"id":"blk-43677","kind":"list-item"},{"blocks":[{"id":"blk-43680","kind":"paragraph","spans":[{"id":"spn-71482","text":"[ ] Downgrade on cancellation is deferred to period end"}]}],"id":"blk-43679","kind":"list-item"}],