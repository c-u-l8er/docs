{"bendscript":"0.1","blocks":[{"id":"blk-24563","kind":"heading","level":1,"spans":[{"id":"spn-28563","text":"06 — Billing and Limits"}]},{"blocks":[{"id":"blk-24565","kind":"paragraph","spans":[{"id":"spn-28564","marks":["bold"],"text":"Purpose:"},{"id":"spn-28565","text":" Subscription tiers, plan enforcement at invoke and deploy time, checkout and webhook flow, usage aggregation, retention policies, and overage handling."}]}],"id":"blk-24564","kind":"quote"},{"id":"blk-24566","kind":"paragraph","spans":[{"id":"spn-28566","text":"---"}]},{"id":"blk-24567","kind":"heading","level":2,"spans":[{"id":"spn-28567","text":"Subscription Tiers"}]},{"head":[{"id":"blk-24569","spans":[{"id":"spn-28568","text":"Feature"}]},{"id":"blk-24570","spans":[{"id":"spn-28569","text":"Free"}]},{"id":"blk-24571","spans":[{"id":"spn-28570","text":"Starter"}]},{"id":"blk-24572","spans":[{"id":"spn-28571","text":"Pro"}]},{"id":"blk-24573","spans":[{"id":"spn-28572","text":"Enterprise"}]}],"id":"blk-24568","kind":"table","rows":[[{"id":"blk-24574","spans":[{"id":"spn-28573","text":"Requests / month"}]},{"id":"blk-24575","spans":[{"id":"spn-28574","text":"1,000"}]},{"id":"blk-24576","spans":[{"id":"spn-28575","text":"10,000"}]},{"id":"blk-24577","spans":[{"id":"spn-28576","text":"100,000"}]},{"id":"blk-24578","spans":[{"id":"spn-28577","text":"Custom"}]}],[{"id":"blk-24579","spans":[{"id":"spn-28578","text":"Token budget / month"}]},{"id":"blk-24580","spans":[{"id":"spn-28579","text":"100K"}]},{"id":"blk-24581","spans":[{"id":"spn-28580","text":"1M"}]},{"id":"blk-24582","spans":[{"id":"spn-28581","text":"10M"}]},{"id":"blk-24583","spans":[{"id":"spn-28582","text":"Custom"}]}],[{"id":"blk-24584","spans":[{"id":"spn-28583","text":"Compute budget (ms) / month"}]},{"id":"blk-24585","spans":[{"id":"spn-28584","text":"60,000"}]},{"id":"blk-24586","spans":[{"id":"spn-28585","text":"600,000"}]},{"id":"blk-24587","spans":[{"id":"spn-28586","text":"6,000,000"}]},{"id":"blk-24588","spans":[{"id":"spn-28587","text":"Custom"}]}],[{"id":"blk-24589","spans":[{"id":"spn-28588","text":"Log retention (days)"}]},{"id":"blk-24590","spans":[{"id":"spn-28589","text":"3"}]},{"id":"blk-24591","spans":[{"id":"spn-28590","text":"14"}]},{"id":"blk-24592","spans":[{"id":"spn-28591","text":"30"}]},{"id":"blk-24593","spans":[{"id":"spn-28592","text":"90+"}]}],[{"id":"blk-24594","spans":[{"id":"spn-28593","text":"Runtime: Cloudflare"}]},{"id":"blk-24595","spans":[{"id":"spn-28594","text":"Yes"}]},{"id":"blk-24596","spans":[{"id":"spn-28595","text":"Yes"}]},{"id":"blk-24597","spans":[{"id":"spn-28596","text":"Yes"}]},{"id":"blk-24598","spans":[{"id":"spn-28597","text":"Yes"}]}],[{"id":"blk-24599","spans":[{"id":"spn-28598","text":"Runtime: AgentCore"}]},{"id":"blk-24600","spans":[{"id":"spn-28599","text":"No"}]},{"id":"blk-24601","spans":[{"id":"spn-28600","text":"No"}]},{"id":"blk-24602","spans":[{"id":"spn-28601","text":"Yes"}]},{"id":"blk-24603","spans":[{"id":"spn-28602","text":"Yes"}]}],[{"id":"blk-24604","spans":[{"id":"spn-28603","text":"Max agents"}]},{"id":"blk-24605","spans":[{"id":"spn-28604","text":"3"}]},{"id":"blk-24606","spans":[{"id":"spn-28605","text":"10"}]},{"id":"blk-24607","spans":[{"id":"spn-28606","text":"50"}]},{"id":"blk-24608","spans":[{"id":"spn-28607","text":"Unlimited"}]}]]},{"id":"blk-24609","kind":"paragraph","spans":[{"id":"spn-28608","text":"---"}]},{"id":"blk-24610","kind":"heading","level":2,"spans":[{"id":"spn-28609","text":"Enforcement Points"}]},{"id":"blk-24611","kind":"heading","level":3,"spans":[{"id":"spn-28610","text":"At Invoke Time"}]},{"id":"blk-24612","kind":"paragraph","spans":[{"id":"spn-28611","text":"The invocation gateway checks "},{"id":"spn-28612","marks":["code"],"text":"billing_usage"},{"id":"spn-28613","text":" for the current period before routing to the provider:"}]},{"id":"blk-24613","kind":"code","language":"typescript","text":"const usage = await getBillingUsage(userId, currentPeriod());\nconst limits = TIER_LIMITS[user.subscriptionTier];\n\nif (usage.totalRequests >= limits.maxRequests) {\n  throw new LimitExceededError(\"Monthly request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-24614","kind":"paragraph","spans":[{"id":"spn-28614","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-28615","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-28616","text":" (HTTP 429)."}]},{"id":"blk-24615","kind":"heading","level":3,"spans":[{"id":"spn-28617","text":"At Deploy Time"}]},{"id":"blk-24616","kind":"paragraph","spans":[{"id":"spn-28618","text":"The deploy Edge Function enforces:"}]},{"id":"blk-24617","items":[{"blocks":[{"id":"blk-24619","kind":"paragraph","spans":[{"id":"spn-28619","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-28620","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-24618","kind":"list-item"},{"blocks":[{"id":"blk-24621","kind":"paragraph","spans":[{"id":"spn-28621","marks":["bold"],"text":"Agent count:"},{"id":"spn-28622","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-24620","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24622","kind":"paragraph","spans":[{"id":"spn-28623","text":"max agent count."}]},{"id":"blk-24623","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-24624","kind":"paragraph","spans":[{"id":"spn-28624","text":"---"}]},{"id":"blk-24625","kind":"heading","level":2,"spans":[{"id":"spn-28625","text":"Checkout Flow"}]},{"id":"blk-24626","kind":"paragraph","spans":[{"id":"spn-28626","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-24627","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends webhook to /functions/v1/billing/webhook\n6. Edge Function verifies webhook signature\n7. UPDATE users SET subscription_tier = 'pro' WHERE id = user_id"},{"id":"blk-24628","kind":"paragraph","spans":[{"id":"spn-28627","text":"---"}]},{"id":"blk-24629","kind":"heading","level":2,"spans":[{"id":"spn-28628","text":"Webhook Events"}]},{"head":[{"id":"blk-24631","spans":[{"id":"spn-28629","text":"Event"}]},{"id":"blk-24632","spans":[{"id":"spn-28630","text":"Action"}]}],"id":"blk-24630","kind":"table","rows":[[{"id":"blk-24633","spans":[{"id":"spn-28631","marks":["code"],"text":"subscription_created"}]},{"id":"blk-24634","spans":[{"id":"spn-28632","text":"Set "},{"id":"spn-28633","marks":["code"],"text":"subscription_tier"},{"id":"spn-28634","text":" to new tier"}]}],[{"id":"blk-24635","spans":[{"id":"spn-28635","marks":["code"],"text":"subscription_updated"}]},{"id":"blk-24636","spans":[{"id":"spn-28636","text":"Update tier (upgrade/downgrade)"}]}],[{"id":"blk-24637","spans":[{"id":"spn-28637","marks":["code"],"text":"subscription_cancelled"}]},{"id":"blk-24638","spans":[{"id":"spn-28638","text":"Downgrade to "},{"id":"spn-28639","marks":["code"],"text":"free"},{"id":"spn-28640","text":" at period end"}]}],[{"id":"blk-24639","spans":[{"id":"spn-28641","marks":["code"],"text":"subscription_payment_failed"}]},{"id":"blk-24640","spans":[{"id":"spn-28642","text":"Flag account; optionally restrict after grace"}]}]]},{"id":"blk-24641","kind":"paragraph","spans":[{"id":"spn-28643","text":"The webhook Edge Function:"}]},{"id":"blk-24642","kind":"paragraph","spans":[{"id":"spn-28644","text":"1. Verifies the "},{"id":"spn-28645","marks":["code"],"text":"X-Signature"},{"id":"spn-28646","text":" header against the webhook secret 2. Extracts user identity from webhook payload metadata 3. Updates "},{"id":"spn-28647","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-28648","text":" accordingly"}]},{"id":"blk-24643","kind":"paragraph","spans":[{"id":"spn-28649","text":"---"}]},{"id":"blk-24644","kind":"heading","level":2,"spans":[{"id":"spn-28650","text":"Usage Aggregation"}]},{"id":"blk-24645","kind":"paragraph","spans":[{"id":"spn-28651","text":"Raw "},{"id":"spn-28652","marks":["code"],"text":"metrics_events"},{"id":"spn-28653","text":" are aggregated into "},{"id":"spn-28654","marks":["code"],"text":"billing_usage"},{"id":"spn-28655","text":" by "},{"id":"spn-28656","marks":["code"],"text":"pg_cron"},{"id":"spn-28657","text":":"}]},{"id":"blk-24646","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-24647","kind":"paragraph","spans":[{"id":"spn-28658","text":"The "},{"id":"spn-28659","marks":["code"],"text":"period_key"},{"id":"spn-28660","text":" format is "},{"id":"spn-28661","marks":["code"],"text":"YYYY-MM"},{"id":"spn-28662","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-24648","kind":"paragraph","spans":[{"id":"spn-28663","text":"---"}]},{"id":"blk-24649","kind":"heading","level":2,"spans":[{"id":"spn-28664","text":"Retention Policies"}]},{"id":"blk-24650","kind":"paragraph","spans":[{"id":"spn-28665","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-24652","spans":[{"id":"spn-28666","text":"Tier"}]},{"id":"blk-24653","spans":[{"id":"spn-28667","marks":["code"],"text":"metrics_events"},{"id":"spn-28668","text":" retention"}]}],"id":"blk-24651","kind":"table","rows":[[{"id":"blk-24654","spans":[{"id":"spn-28669","text":"Free"}]},{"id":"blk-24655","spans":[{"id":"spn-28670","text":"3 days"}]}],[{"id":"blk-24656","spans":[{"id":"spn-28671","text":"Starter"}]},{"id":"blk-24657","spans":[{"id":"spn-28672","text":"14 days"}]}],[{"id":"blk-24658","spans":[{"id":"spn-28673","text":"Pro"}]},{"id":"blk-24659","spans":[{"id":"spn-28674","text":"30 days"}]}],[{"id":"blk-24660","spans":[{"id":"spn-28675","text":"Enterprise"}]},{"id":"blk-24661","spans":[{"id":"spn-28676","text":"90+ days"}]}]]},{"id":"blk-24662","kind":"paragraph","spans":[{"id":"spn-28677","text":"A "},{"id":"spn-28678","marks":["code"],"text":"pg_cron"},{"id":"spn-28679","text":" job periodically deletes old "},{"id":"spn-28680","marks":["code"],"text":"metrics_events"},{"id":"spn-28681","text":" rows:"}]},{"id":"blk-24663","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-24664","kind":"paragraph","spans":[{"id":"spn-28682","marks":["code"],"text":"billing_usage"},{"id":"spn-28683","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-24665","kind":"paragraph","spans":[{"id":"spn-28684","text":"---"}]},{"id":"blk-24666","kind":"heading","level":2,"spans":[{"id":"spn-28685","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-24667","kind":"paragraph","spans":[{"id":"spn-28686","text":"MVP uses "},{"id":"spn-28687","marks":["bold"],"text":"hard stop"},{"id":"spn-28688","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-24668","kind":"paragraph","spans":[{"id":"spn-28689","text":"Post-MVP options:"}]},{"id":"blk-24669","kind":"paragraph","spans":[{"id":"spn-28690","text":"1. "},{"id":"spn-28691","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-28692","text":" Allow overages at a per-unit rate, billed at period end. 2. "},{"id":"spn-28693","marks":["bold"],"text":"Soft limits:"},{"id":"spn-28694","text":" Warn users at 80% and 100%, hard stop at 120%. 3. "},{"id":"spn-28695","marks":["bold"],"text":"Reconciled billing:"},{"id":"spn-28696","text":" Reconcile estimated costs with provider billing exports."}]},{"id":"blk-24670","kind":"paragraph","spans":[{"id":"spn-28697","text":"---"}]},{"id":"blk-24671","kind":"heading","level":2,"spans":[{"id":"spn-28698","text":"Checklist"}]},{"id":"blk-24672","items":[{"blocks":[{"id":"blk-24674","kind":"paragraph","spans":[{"id":"spn-28699","text":"[ ] Tier limits are defined and stored in a configuration table or constants"}]}],"id":"blk-24673","kind":"list-item"},{"blocks":[{"id":"blk-24676","kind":"paragraph","spans":[{"id":"spn-28700","text":"[ ] Invocation gateway checks all three limit types (requests, tokens, compute)"}]}],"id":"blk-24675","kind":"list-item"},{"blocks":[{"id":"blk-24678","kind":"paragraph","spans":[{"id":"spn-28701","text":"[ ] Deploy enforces runtime gating and agent count limits"}]}],"id":"blk-24677","kind":"list-item"},{"blocks":[{"id":"blk-24680","kind":"paragraph","spans":[{"id":"spn-28702","text":"[ ] Checkout creates a valid billing provider session"}]}],"id":"blk-24679","kind":"list-item"},{"blocks":[{"id":"blk-24682","kind":"paragraph","spans":[{"id":"spn-28703","text":"[ ] Webhook verifies signature before processing"}]}],"id":"blk-24681","kind":"list-item"},{"blocks":[{"id":"blk-24684","kind":"paragraph","spans":[{"id":"spn-28704","text":"[ ] "},{"id":"spn-28705","marks":["code"],"text":"subscription_tier"},{"id":"spn-28706","text":" is updated transactionally on webhook events"}]}],"id":"blk-24683","kind":"list-item"},{"blocks":[{"id":"blk-24686","kind":"paragraph","spans":[{"id":"spn-28707","text":"[ ] Aggregation job runs on schedule and handles partial failures"}]}],"id":"blk-24685","kind":"list-item"},{"blocks":[{"id":"blk-24688","kind":"paragraph","spans":[{"id":"spn-28708","text":"[ ] Retention cleanup job respects per-tier retention windows"}]}],"id":"blk-24687","kind":"list-item"},{"blocks":[{"id":"blk-24690","kind":"paragraph","spans":[{"id":"spn-28709","text":"[ ] Downgrade on cancellation is deferred to period end"}]}],"id":"b