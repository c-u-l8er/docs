{"bendscript":"0.1","blocks":[{"id":"blk-24453","kind":"heading","level":1,"spans":[{"id":"spn-27934","text":"06 — Billing and Limits"}]},{"blocks":[{"id":"blk-24455","kind":"paragraph","spans":[{"id":"spn-27935","marks":["bold"],"text":"Purpose:"},{"id":"spn-27936","text":" Subscription tiers, plan enforcement at invoke and deploy time, checkout and webhook flow, usage aggregation, retention policies, and overage handling."}]}],"id":"blk-24454","kind":"quote"},{"id":"blk-24456","kind":"paragraph","spans":[{"id":"spn-27937","text":"---"}]},{"id":"blk-24457","kind":"heading","level":2,"spans":[{"id":"spn-27938","text":"Subscription Tiers"}]},{"head":[{"id":"blk-24459","spans":[{"id":"spn-27939","text":"Feature"}]},{"id":"blk-24460","spans":[{"id":"spn-27940","text":"Free"}]},{"id":"blk-24461","spans":[{"id":"spn-27941","text":"Starter"}]},{"id":"blk-24462","spans":[{"id":"spn-27942","text":"Pro"}]},{"id":"blk-24463","spans":[{"id":"spn-27943","text":"Enterprise"}]}],"id":"blk-24458","kind":"table","rows":[[{"id":"blk-24464","spans":[{"id":"spn-27944","text":"Requests / month"}]},{"id":"blk-24465","spans":[{"id":"spn-27945","text":"1,000"}]},{"id":"blk-24466","spans":[{"id":"spn-27946","text":"10,000"}]},{"id":"blk-24467","spans":[{"id":"spn-27947","text":"100,000"}]},{"id":"blk-24468","spans":[{"id":"spn-27948","text":"Custom"}]}],[{"id":"blk-24469","spans":[{"id":"spn-27949","text":"Token budget / month"}]},{"id":"blk-24470","spans":[{"id":"spn-27950","text":"100K"}]},{"id":"blk-24471","spans":[{"id":"spn-27951","text":"1M"}]},{"id":"blk-24472","spans":[{"id":"spn-27952","text":"10M"}]},{"id":"blk-24473","spans":[{"id":"spn-27953","text":"Custom"}]}],[{"id":"blk-24474","spans":[{"id":"spn-27954","text":"Compute budget (ms) / month"}]},{"id":"blk-24475","spans":[{"id":"spn-27955","text":"60,000"}]},{"id":"blk-24476","spans":[{"id":"spn-27956","text":"600,000"}]},{"id":"blk-24477","spans":[{"id":"spn-27957","text":"6,000,000"}]},{"id":"blk-24478","spans":[{"id":"spn-27958","text":"Custom"}]}],[{"id":"blk-24479","spans":[{"id":"spn-27959","text":"Log retention (days)"}]},{"id":"blk-24480","spans":[{"id":"spn-27960","text":"3"}]},{"id":"blk-24481","spans":[{"id":"spn-27961","text":"14"}]},{"id":"blk-24482","spans":[{"id":"spn-27962","text":"30"}]},{"id":"blk-24483","spans":[{"id":"spn-27963","text":"90+"}]}],[{"id":"blk-24484","spans":[{"id":"spn-27964","text":"Runtime: Cloudflare"}]},{"id":"blk-24485","spans":[{"id":"spn-27965","text":"Yes"}]},{"id":"blk-24486","spans":[{"id":"spn-27966","text":"Yes"}]},{"id":"blk-24487","spans":[{"id":"spn-27967","text":"Yes"}]},{"id":"blk-24488","spans":[{"id":"spn-27968","text":"Yes"}]}],[{"id":"blk-24489","spans":[{"id":"spn-27969","text":"Runtime: AgentCore"}]},{"id":"blk-24490","spans":[{"id":"spn-27970","text":"No"}]},{"id":"blk-24491","spans":[{"id":"spn-27971","text":"No"}]},{"id":"blk-24492","spans":[{"id":"spn-27972","text":"Yes"}]},{"id":"blk-24493","spans":[{"id":"spn-27973","text":"Yes"}]}],[{"id":"blk-24494","spans":[{"id":"spn-27974","text":"Max agents"}]},{"id":"blk-24495","spans":[{"id":"spn-27975","text":"3"}]},{"id":"blk-24496","spans":[{"id":"spn-27976","text":"10"}]},{"id":"blk-24497","spans":[{"id":"spn-27977","text":"50"}]},{"id":"blk-24498","spans":[{"id":"spn-27978","text":"Unlimited"}]}]]},{"id":"blk-24499","kind":"paragraph","spans":[{"id":"spn-27979","text":"---"}]},{"id":"blk-24500","kind":"heading","level":2,"spans":[{"id":"spn-27980","text":"Enforcement Points"}]},{"id":"blk-24501","kind":"heading","level":3,"spans":[{"id":"spn-27981","text":"At Invoke Time"}]},{"id":"blk-24502","kind":"paragraph","spans":[{"id":"spn-27982","text":"The invocation gateway checks "},{"id":"spn-27983","marks":["code"],"text":"billing_usage"},{"id":"spn-27984","text":" for the current period before routing to the provider:"}]},{"id":"blk-24503","kind":"code","language":"typescript","text":"const usage = await getBillingUsage(userId, currentPeriod());\nconst limits = TIER_LIMITS[user.subscriptionTier];\n\nif (usage.totalRequests >= limits.maxRequests) {\n  throw new LimitExceededError(\"Monthly request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-24504","kind":"paragraph","spans":[{"id":"spn-27985","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-27986","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-27987","text":" (HTTP 429)."}]},{"id":"blk-24505","kind":"heading","level":3,"spans":[{"id":"spn-27988","text":"At Deploy Time"}]},{"id":"blk-24506","kind":"paragraph","spans":[{"id":"spn-27989","text":"The deploy Edge Function enforces:"}]},{"id":"blk-24507","items":[{"blocks":[{"id":"blk-24509","kind":"paragraph","spans":[{"id":"spn-27990","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-27991","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-24508","kind":"list-item"},{"blocks":[{"id":"blk-24511","kind":"paragraph","spans":[{"id":"spn-27992","marks":["bold"],"text":"Agent count:"},{"id":"spn-27993","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-24510","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24512","kind":"paragraph","spans":[{"id":"spn-27994","text":"max agent count."}]},{"id":"blk-24513","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-24514","kind":"paragraph","spans":[{"id":"spn-27995","text":"---"}]},{"id":"blk-24515","kind":"heading","level":2,"spans":[{"id":"spn-27996","text":"Checkout Flow"}]},{"id":"blk-24516","kind":"paragraph","spans":[{"id":"spn-27997","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-24517","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends webhook to /functions/v1/billing/webhook\n6. Edge Function verifies webhook signature\n7. UPDATE users SET subscription_tier = 'pro' WHERE id = user_id"},{"id":"blk-24518","kind":"paragraph","spans":[{"id":"spn-27998","text":"---"}]},{"id":"blk-24519","kind":"heading","level":2,"spans":[{"id":"spn-27999","text":"Webhook Events"}]},{"head":[{"id":"blk-24521","spans":[{"id":"spn-28000","text":"Event"}]},{"id":"blk-24522","spans":[{"id":"spn-28001","text":"Action"}]}],"id":"blk-24520","kind":"table","rows":[[{"id":"blk-24523","spans":[{"id":"spn-28002","marks":["code"],"text":"subscription_created"}]},{"id":"blk-24524","spans":[{"id":"spn-28003","text":"Set "},{"id":"spn-28004","marks":["code"],"text":"subscription_tier"},{"id":"spn-28005","text":" to new tier"}]}],[{"id":"blk-24525","spans":[{"id":"spn-28006","marks":["code"],"text":"subscription_updated"}]},{"id":"blk-24526","spans":[{"id":"spn-28007","text":"Update tier (upgrade/downgrade)"}]}],[{"id":"blk-24527","spans":[{"id":"spn-28008","marks":["code"],"text":"subscription_cancelled"}]},{"id":"blk-24528","spans":[{"id":"spn-28009","text":"Downgrade to "},{"id":"spn-28010","marks":["code"],"text":"free"},{"id":"spn-28011","text":" at period end"}]}],[{"id":"blk-24529","spans":[{"id":"spn-28012","marks":["code"],"text":"subscription_payment_failed"}]},{"id":"blk-24530","spans":[{"id":"spn-28013","text":"Flag account; optionally restrict after grace"}]}]]},{"id":"blk-24531","kind":"paragraph","spans":[{"id":"spn-28014","text":"The webhook Edge Function:"}]},{"id":"blk-24532","kind":"paragraph","spans":[{"id":"spn-28015","text":"1. Verifies the "},{"id":"spn-28016","marks":["code"],"text":"X-Signature"},{"id":"spn-28017","text":" header against the webhook secret 2. Extracts user identity from webhook payload metadata 3. Updates "},{"id":"spn-28018","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-28019","text":" accordingly"}]},{"id":"blk-24533","kind":"paragraph","spans":[{"id":"spn-28020","text":"---"}]},{"id":"blk-24534","kind":"heading","level":2,"spans":[{"id":"spn-28021","text":"Usage Aggregation"}]},{"id":"blk-24535","kind":"paragraph","spans":[{"id":"spn-28022","text":"Raw "},{"id":"spn-28023","marks":["code"],"text":"metrics_events"},{"id":"spn-28024","text":" are aggregated into "},{"id":"spn-28025","marks":["code"],"text":"billing_usage"},{"id":"spn-28026","text":" by "},{"id":"spn-28027","marks":["code"],"text":"pg_cron"},{"id":"spn-28028","text":":"}]},{"id":"blk-24536","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-24537","kind":"paragraph","spans":[{"id":"spn-28029","text":"The "},{"id":"spn-28030","marks":["code"],"text":"period_key"},{"id":"spn-28031","text":" format is "},{"id":"spn-28032","marks":["code"],"text":"YYYY-MM"},{"id":"spn-28033","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-24538","kind":"paragraph","spans":[{"id":"spn-28034","text":"---"}]},{"id":"blk-24539","kind":"heading","level":2,"spans":[{"id":"spn-28035","text":"Retention Policies"}]},{"id":"blk-24540","kind":"paragraph","spans":[{"id":"spn-28036","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-24542","spans":[{"id":"spn-28037","text":"Tier"}]},{"id":"blk-24543","spans":[{"id":"spn-28038","marks":["code"],"text":"metrics_events"},{"id":"spn-28039","text":" retention"}]}],"id":"blk-24541","kind":"table","rows":[[{"id":"blk-24544","spans":[{"id":"spn-28040","text":"Free"}]},{"id":"blk-24545","spans":[{"id":"spn-28041","text":"3 days"}]}],[{"id":"blk-24546","spans":[{"id":"spn-28042","text":"Starter"}]},{"id":"blk-24547","spans":[{"id":"spn-28043","text":"14 days"}]}],[{"id":"blk-24548","spans":[{"id":"spn-28044","text":"Pro"}]},{"id":"blk-24549","spans":[{"id":"spn-28045","text":"30 days"}]}],[{"id":"blk-24550","spans":[{"id":"spn-28046","text":"Enterprise"}]},{"id":"blk-24551","spans":[{"id":"spn-28047","text":"90+ days"}]}]]},{"id":"blk-24552","kind":"paragraph","spans":[{"id":"spn-28048","text":"A "},{"id":"spn-28049","marks":["code"],"text":"pg_cron"},{"id":"spn-28050","text":" job periodically deletes old "},{"id":"spn-28051","marks":["code"],"text":"metrics_events"},{"id":"spn-28052","text":" rows:"}]},{"id":"blk-24553","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-24554","kind":"paragraph","spans":[{"id":"spn-28053","marks":["code"],"text":"billing_usage"},{"id":"spn-28054","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-24555","kind":"paragraph","spans":[{"id":"spn-28055","text":"---"}]},{"id":"blk-24556","kind":"heading","level":2,"spans":[{"id":"spn-28056","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-24557","kind":"paragraph","spans":[{"id":"spn-28057","text":"MVP uses "},{"id":"spn-28058","marks":["bold"],"text":"hard stop"},{"id":"spn-28059","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-24558","kind":"paragraph","spans":[{"id":"spn-28060","text":"Post-MVP options:"}]},{"id":"blk-24559","kind":"paragraph","spans":[{"id":"spn-28061","text":"1. "},{"id":"spn-28062","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-28063","text":" Allow overages at a per-unit rate, billed at period end. 2. "},{"id":"spn-28064","marks":["bold"],"text":"Soft limits:"},{"id":"spn-28065","text":" Warn users at 80% and 100%, hard stop at 120%. 3. "},{"id":"spn-28066","marks":["bold"],"text":"Reconciled billing:"},{"id":"spn-28067","text":" Reconcile estimated costs with provider billing exports."}]},{"id":"blk-24560","kind":"paragraph","spans":[{"id":"spn-28068","text":"---"}]},{"id":"blk-24561","kind":"heading","level":2,"spans":[{"id":"spn-28069","text":"Checklist"}]},{"id":"blk-24562","items":[{"blocks":[{"id":"blk-24564","kind":"paragraph","spans":[{"id":"spn-28070","text":"[ ] Tier limits are defined and stored in a configuration table or constants"}]}],"id":"blk-24563","kind":"list-item"},{"blocks":[{"id":"blk-24566","kind":"paragraph","spans":[{"id":"spn-28071","text":"[ ] Invocation gateway checks all three limit types (requests, tokens, compute)"}]}],"id":"blk-24565","kind":"list-item"},{"blocks":[{"id":"blk-24568","kind":"paragraph","spans":[{"id":"spn-28072","text":"[ ] Deploy enforces runtime gating and agent count limits"}]}],"id":"blk-24567","kind":"list-item"},{"blocks":[{"id":"blk-24570","kind":"paragraph","spans":[{"id":"spn-28073","text":"[ ] Checkout creates a valid billing provider session"}]}],"id":"blk-24569","kind":"list-item"},{"blocks":[{"id":"blk-24572","kind":"paragraph","spans":[{"id":"spn-28074","text":"[ ] Webhook verifies signature before processing"}]}],"id":"blk-24571","kind":"list-item"},{"blocks":[{"id":"blk-24574","kind":"paragraph","spans":[{"id":"spn-28075","text":"[ ] "},{"id":"spn-28076","marks":["code"],"text":"subscription_tier"},{"id":"spn-28077","text":" is updated transactionally on webhook events"}]}],"id":"blk-24573","kind":"list-item"},{"blocks":[{"id":"blk-24576","kind":"paragraph","spans":[{"id":"spn-28078","text":"[ ] Aggregation job runs on schedule and handles partial failures"}]}],"id":"blk-24575","kind":"list-item"},{"blocks":[{"id":"blk-24578","kind":"paragraph","spans":[{"id":"spn-28079","text":"[ ] Retention cleanup job respects per-tier retention windows"}]}],"id":"blk-24577","kind":"list-item"},{"blocks":[{"id":"blk-24580","kind":"paragraph","spans":[{"id":"spn-28080","text":"[ ] Downgrade on cancellation is deferred to period end"}]}],"id":"b