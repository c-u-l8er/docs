0876","text":"Custom"}]}],[{"id":"blk-25560","spans":[{"id":"spn-30877","text":"Log retention (days)"}]},{"id":"blk-25561","spans":[{"id":"spn-30878","text":"3"}]},{"id":"blk-25562","spans":[{"id":"spn-30879","text":"14"}]},{"id":"blk-25563","spans":[{"id":"spn-30880","text":"30"}]},{"id":"blk-25564","spans":[{"id":"spn-30881","text":"90+"}]}],[{"id":"blk-25565","spans":[{"id":"spn-30882","text":"Runtime: Cloudflare"}]},{"id":"blk-25566","spans":[{"id":"spn-30883","text":"Yes"}]},{"id":"blk-25567","spans":[{"id":"spn-30884","text":"Yes"}]},{"id":"blk-25568","spans":[{"id":"spn-30885","text":"Yes"}]},{"id":"blk-25569","spans":[{"id":"spn-30886","text":"Yes"}]}],[{"id":"blk-25570","spans":[{"id":"spn-30887","text":"Runtime: AgentCore"}]},{"id":"blk-25571","spans":[{"id":"spn-30888","text":"No"}]},{"id":"blk-25572","spans":[{"id":"spn-30889","text":"No"}]},{"id":"blk-25573","spans":[{"id":"spn-30890","text":"Yes"}]},{"id":"blk-25574","spans":[{"id":"spn-30891","text":"Yes"}]}],[{"id":"blk-25575","spans":[{"id":"spn-30892","text":"Max agents"}]},{"id":"blk-25576","spans":[{"id":"spn-30893","text":"3"}]},{"id":"blk-25577","spans":[{"id":"spn-30894","text":"10"}]},{"id":"blk-25578","spans":[{"id":"spn-30895","text":"50"}]},{"id":"blk-25579","spans":[{"id":"spn-30896","text":"Unlimited"}]}]]},{"id":"blk-25580","kind":"paragraph","spans":[{"id":"spn-30897","text":"---"}]},{"id":"blk-25581","kind":"heading","level":2,"spans":[{"id":"spn-30898","text":"Enforcement Points"}]},{"id":"blk-25582","kind":"heading","level":3,"spans":[{"id":"spn-30899","text":"At Invoke Time"}]},{"id":"blk-25583","kind":"paragraph","spans":[{"id":"spn-30900","text":"The invocation gateway checks "},{"id":"spn-30901","marks":["code"],"text":"billing_usage"},{"id":"spn-30902","text":" for the current period before routing to the provider:"}]},{"id":"blk-25584","kind":"code","language":"typescript","text":"const usage = await getBillingUsage(userId, currentPeriod());\nconst limits = TIER_LIMITS[user.subscriptionTier];\n\nif (usage.totalRequests >= limits.maxRequests) {\n  throw new LimitExceededError(\"Monthly request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-25585","kind":"paragraph","spans":[{"id":"spn-30903","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-30904","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-30905","text":" (HTTP 429)."}]},{"id":"blk-25586","kind":"heading","level":3,"spans":[{"id":"spn-30906","text":"At Deploy Time"}]},{"id":"blk-25587","kind":"paragraph","spans":[{"id":"spn-30907","text":"The deploy Edge Function enforces:"}]},{"id":"blk-25588","items":[{"blocks":[{"id":"blk-25590","kind":"paragraph","spans":[{"id":"spn-30908","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-30909","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-25589","kind":"list-item"},{"blocks":[{"id":"blk-25592","kind":"paragraph","spans":[{"id":"spn-30910","marks":["bold"],"text":"Agent count:"},{"id":"spn-30911","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-25591","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25593","kind":"paragraph","spans":[{"id":"spn-30912","text":"max agent count."}]},{"id":"blk-25594","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-25595","kind":"paragraph","spans":[{"id":"spn-30913","text":"---"}]},{"id":"blk-25596","kind":"heading","level":2,"spans":[{"id":"spn-30914","text":"Checkout Flow"}]},{"id":"blk-25597","kind":"paragraph","spans":[{"id":"spn-30915","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-25598","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends webhook to /functions/v1/billing/webhook\n6. Edge Function verifies webhook signature\n7. UPDATE users SET subscription_tier = 'pro' WHERE id = user_id"},{"id":"blk-25599","kind":"paragraph","spans":[{"id":"spn-30916","text":"---"}]},{"id":"blk-25600","kind":"heading","level":2,"spans":[{"id":"spn-30917","text":"Webhook Events"}]},{"head":[{"id":"blk-25602","spans":[{"id":"spn-30918","text":"Event"}]},{"id":"blk-25603","spans":[{"id":"spn-30919","text":"Action"}]}],"id":"blk-25601","kind":"table","rows":[[{"id":"blk-25604","spans":[{"id":"spn-30920","marks":["code"],"text":"subscription_created"}]},{"id":"blk-25605","spans":[{"id":"spn-30921","text":"Set "},{"id":"spn-30922","marks":["code"],"text":"subscription_tier"},{"id":"spn-30923","text":" to new tier"}]}],[{"id":"blk-25606","spans":[{"id":"spn-30924","marks":["code"],"text":"subscription_updated"}]},{"id":"blk-25607","spans":[{"id":"spn-30925","text":"Update tier (upgrade/downgrade)"}]}],[{"id":"blk-25608","spans":[{"id":"spn-30926","marks":["code"],"text":"subscription_cancelled"}]},{"id":"blk-25609","spans":[{"id":"spn-30927","text":"Downgrade to "},{"id":"spn-30928","marks":["code"],"text":"free"},{"id":"spn-30929","text":" at period end"}]}],[{"id":"blk-25610","spans":[{"id":"spn-30930","marks":["code"],"text":"subscription_payment_failed"}]},{"id":"blk-25611","spans":[{"id":"spn-30931","text":"Flag account; optionally restrict after grace"}]}]]},{"id":"blk-25612","kind":"paragraph","spans":[{"id":"spn-30932","text":"The webhook Edge Function:"}]},{"id":"blk-25613","kind":"paragraph","spans":[{"id":"spn-30933","text":"1. Verifies the "},{"id":"spn-30934","marks":["code"],"text":"X-Signature"},{"id":"spn-30935","text":" header against the webhook secret 2. Extracts user identity from webhook payload metadata 3. Updates "},{"id":"spn-30936","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-30937","text":" accordingly"}]},{"id":"blk-25614","kind":"paragraph","spans":[{"id":"spn-30938","text":"---"}]},{"id":"blk-25615","kind":"heading","level":2,"spans":[{"id":"spn-30939","text":"Usage Aggregation"}]},{"id":"blk-25616","kind":"paragraph","spans":[{"id":"spn-30940","text":"Raw "},{"id":"spn-30941","marks":["code"],"text":"metrics_events"},{"id":"spn-30942","text":" are aggregated into "},{"id":"spn-30943","marks":["code"],"text":"billing_usage"},{"id":"spn-30944","text":" by "},{"id":"spn-30945","marks":["code"],"text":"pg_cron"},{"id":"spn-30946","text":":"}]},{"id":"blk-25617","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-25618","kind":"paragraph","spans":[{"id":"spn-30947","text":"The "},{"id":"spn-30948","marks":["code"],"text":"period_key"},{"id":"spn-30949","text":" format is "},{"id":"spn-30950","marks":["code"],"text":"YYYY-MM"},{"id":"spn-30951","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-25619","kind":"paragraph","spans":[{"id":"spn-30952","text":"---"}]},{"id":"blk-25620","kind":"heading","level":2,"spans":[{"id":"spn-30953","text":"Retention Policies"}]},{"id":"blk-25621","kind":"paragraph","spans":[{"id":"spn-30954","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-25623","spans":[{"id":"spn-30955","text":"Tier"}]},{"id":"blk-25624","spans":[{"id":"spn-30956","marks":["code"],"text":"metrics_events"},{"id":"spn-30957","text":" retention"}]}],"id":"blk-25622","kind":"table","rows":[[{"id":"blk-25625","spans":[{"id":"spn-30958","text":"Free"}]},{"id":"blk-25626","spans":[{"id":"spn-30959","text":"3 days"}]}],[{"id":"blk-25627","spans":[{"id":"spn-30960","text":"Starter"}]},{"id":"blk-25628","spans":[{"id":"spn-30961","text":"14 days"}]}],[{"id":"blk-25629","spans":[{"id":"spn-30962","text":"Pro"}]},{"id":"blk-25630","spans":[{"id":"spn-30963","text":"30 days"}]}],[{"id":"blk-25631","spans":[{"id":"spn-30964","text":"Enterprise"}]},{"id":"blk-25632","spans":[{"id":"spn-30965","text":"90+ days"}]}]]},{"id":"blk-25633","kind":"paragraph","spans":[{"id":"spn-30966","text":"A "},{"id":"spn-30967","marks":["code"],"text":"pg_cron"},{"id":"spn-30968","text":" job periodically deletes old "},{"id":"spn-30969","marks":["code"],"text":"metrics_events"},{"id":"spn-30970","text":" rows:"}]},{"id":"blk-25634","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-25635","kind":"paragraph","spans":[{"id":"spn-30971","marks":["code"],"text":"billing_usage"},{"id":"spn-30972","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-25636","kind":"paragraph","spans":[{"id":"spn-30973","text":"---"}]},{"id":"blk-25637","kind":"heading","level":2,"spans":[{"id":"spn-30974","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-25638","kind":"paragraph","spans":[{"id":"spn-30975","text":"MVP uses "},{"id":"spn-30976","marks":["bold"],"text":"hard stop"},{"id":"spn-30977","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-25639","kind":"paragraph","spans":[{"id":"spn-30978","text":"Post-MVP options:"}]},{"id":"blk-25640","kind":"paragraph","spans":[{"id":"spn-30979","text":"1. "},{"id":"spn-30980","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-30981","text":" Allow overages at a per-unit rate, billed at period end. 2. "},{"id":"spn-30982","marks":["bold"],"text":"Soft limits:"},{"id":"spn-30983","text":" Warn users at 80% and 100%, hard stop at 120%. 3. "},{"id":"spn-30984","marks":["bold"],"text":"Reconciled billing:"},{"id":"spn-30985","text":" Reconcile estimated costs with provider billing exports."}]},{"id":"blk-25641","kind":"paragraph","spans":[{"id":"spn-30986","text":"---"}]},{"id":"blk-25642","kind":"heading","level":2,"spans":[{"id":"spn-30987","text":"Checklist"}]},{"id":"blk-25643","items":[{"blocks":[{"id":"blk-25645","kind":"paragraph","spans":[{"id":"spn-30988","text":"[ ] Tier limits are defined and stored in a configuration table or constants"}]}],"id":"blk-25644","kind":"list-item"},{"blocks":[{"id":"blk-25647","kind":"paragraph","spans":[{"id":"spn-30989","text":"[ ] Invocation gateway checks all three limit types (requests, tokens, compute)"}]}],"id":"blk-25646","kind":"list-item"},{"blocks":[{"id":"blk-25649","kind":"paragraph","spans":[{"id":"spn-30990","text":"[ ] Deploy enforces runtime gating and agent count limits"}]}],"id":"blk-25648","kind":"list-item"},{"blocks":[{"id":"blk-25651","kind":"paragraph","spans":[{"id":"spn-30991","text":"[ ] Checkout creates a valid billing provider session"}]}],"id":"blk-25650","kind":"list-item"},{"blocks":[{"id":"blk-25653","kind":"paragraph","spans":[{"id":"spn-30992","text":"[ ] Webhook verifies signature before processing"}]}],"id":"blk-25652","kind":"list-item"},{"blocks":[{"id":"blk-25655","kind":"paragraph","spans":[{"id":"spn-30993","text":"[ ] "},{"id":"spn-30994","marks":["code"],"text":"subscription_tier"},{"id":"spn-30995","text":" is updated transactionally on webhook events"}]}],"id":"blk-25654","kind":"list-item"},{"blocks":[{"id":"blk-25657","kind":"paragraph","spans":[{"id":"spn-30996","text":"[ ] Aggregation job runs on schedule and handles partial failures"}]}],"id":"blk-25656","kind":"list-item"},{"blocks":[{"id":"blk-25659","kind":"paragraph","spans":[{"id":"spn-30997","text":"[ ] Retention cleanup job respects per-tier retention windows"}]}],"id":"blk-25658","kind":"list-item"},{"blocks":[{"id":"blk-25661","kind":"paragraph","spans":[{"id":"spn-30998","text":"[ ] Downgrade on cancellation is deferred to period end"}]}],"id":"b