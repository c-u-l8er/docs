{"bendscript":"0.1","blocks":[{"id":"blk-56509","kind":"heading","level":1,"spans":[{"id":"spn-64895","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-56510","kind":"heading","level":2,"spans":[{"id":"spn-64896","text":"Goal"}]},{"id":"blk-56511","kind":"paragraph","spans":[{"id":"spn-64897","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-64898","marks":["code"],"text":"amp.workspaces"},{"id":"spn-64899","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-56512","kind":"heading","level":2,"spans":[{"id":"spn-64900","text":"Prerequisites"}]},{"id":"blk-56513","items":[{"blocks":[{"id":"blk-56515","kind":"paragraph","spans":[{"id":"spn-64901","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-56514","kind":"list-item"},{"blocks":[{"id":"blk-56517","kind":"paragraph","spans":[{"id":"spn-64902","text":"Auth system already exists ("},{"id":"spn-64903","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-64904","text":", "},{"id":"spn-64905","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-64906","text":")"}]}],"id":"blk-56516","kind":"list-item"},{"blocks":[{"id":"blk-56519","kind":"paragraph","spans":[{"id":"spn-64907","text":"Supabase client exists ("},{"id":"spn-64908","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-64909","text":") targeting "},{"id":"spn-64910","marks":["code"],"text":"rune"},{"id":"spn-64911","text":" schema"}]}],"id":"blk-56518","kind":"list-item"},{"blocks":[{"id":"blk-56521","kind":"paragraph","spans":[{"id":"spn-64912","text":"Persistence layer exists ("},{"id":"spn-64913","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-64914","text":") with CRUD for "},{"id":"spn-64915","marks":["code"],"text":"rune.forts"},{"id":"spn-64916","text":" and "},{"id":"spn-64917","marks":["code"],"text":"rune.views"}]}],"id":"blk-56520","kind":"list-item"},{"blocks":[{"id":"blk-56523","kind":"paragraph","spans":[{"id":"spn-64918","text":"Migrations exist: "},{"id":"spn-64919","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-64920","text":" (forts, views, bridges, districts tables), "},{"id":"spn-64921","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-64922","text":" (RLS policies using "},{"id":"spn-64923","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-64924","text":")"}]}],"id":"blk-56522","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56524","kind":"heading","level":2,"spans":[{"id":"spn-64925","text":"Files to Create"}]},{"id":"blk-56525","kind":"heading","level":3,"spans":[{"id":"spn-64926","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-56526","kind":"paragraph","spans":[{"id":"spn-64927","text":"Workspace loader using Supabase:"}]},{"id":"blk-56527","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-56528","kind":"heading","level":3,"spans":[{"id":"spn-64928","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-56529","kind":"paragraph","spans":[{"id":"spn-64929","text":"Svelte 5 rune store:"}]},{"id":"blk-56530","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-56531","kind":"heading","level":3,"spans":[{"id":"spn-64930","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-56532","kind":"paragraph","spans":[{"id":"spn-64931","text":"Dropdown in the toolbar:"}]},{"id":"blk-56533","items":[{"blocks":[{"id":"blk-56535","kind":"paragraph","spans":[{"id":"spn-64932","text":"Shows current workspace name"}]}],"id":"blk-56534","kind":"list-item"},{"blocks":[{"id":"blk-56537","kind":"paragraph","spans":[{"id":"spn-64933","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-56536","kind":"list-item"},{"blocks":[{"id":"blk-56539","kind":"paragraph","spans":[{"id":"spn-64934","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-56538","kind":"list-item"},{"blocks":[{"id":"blk-56541","kind":"paragraph","spans":[{"id":"spn-64935","text":"Switching workspace triggers "},{"id":"spn-64936","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-64937","text":" which reloads forts"}]}],"id":"blk-56540","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56542","kind":"heading","level":3,"spans":[{"id":"spn-64938","text":"Supabase RPC (migration)"}]},{"id":"blk-56543","kind":"paragraph","spans":[{"id":"spn-64939","text":"If "},{"id":"spn-64940","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-64941","text":" doesn't exist yet, create: "},{"id":"spn-64942","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-64943","text":":"}]},{"id":"blk-56544","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-56545","kind":"heading","level":2,"spans":[{"id":"spn-64944","text":"Integration Points"}]},{"id":"blk-56546","kind":"paragraph","spans":[{"id":"spn-64945","text":"1. "},{"id":"spn-64946","marks":["bold"],"text":"Toolbar"},{"id":"spn-64947","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-64948","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-64949","text":" dropdown when authenticated 2. "},{"id":"spn-64950","marks":["bold"],"text":"Auth flow"},{"id":"spn-64951","text":": After sign-in, call "},{"id":"spn-64952","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-64953","text":" to load the user's workspaces 3. "},{"id":"spn-64954","marks":["bold"],"text":"Fort store"},{"id":"spn-64955","text":": Add "},{"id":"spn-64956","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-64957","text":" that converts saved forts into an L0 district view 4. "},{"id":"spn-64958","marks":["bold"],"text":"Save flow"},{"id":"spn-64959","text":": When saving a fort, include "},{"id":"spn-64960","marks":["code"],"text":"workspace_id"},{"id":"spn-64961","text":" from active workspace 5. "},{"id":"spn-64962","marks":["bold"],"text":"BlueprintList"},{"id":"spn-64963","text":": Filter by active workspace"}]},{"id":"blk-56547","kind":"heading","level":2,"spans":[{"id":"spn-64964","text":"Constraints"}]},{"id":"blk-56548","items":[{"blocks":[{"id":"blk-56550","kind":"paragraph","spans":[{"id":"spn-64965","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-56549","kind":"list-item"},{"blocks":[{"id":"blk-56552","kind":"paragraph","spans":[{"id":"spn-64966","text":"Workspace data comes from "},{"id":"spn-64967","marks":["code"],"text":"amp.workspaces"},{"id":"spn-64968","text":" + "},{"id":"spn-64969","marks":["code"],"text":"amp.members"},{"id":"spn-64970","text":" (shared schema)"}]}],"id":"blk-56551","kind":"list-item"},{"blocks":[{"id":"blk-56554","kind":"paragraph","spans":[{"id":"spn-64971","text":"Fort data comes from "},{"id":"spn-64972","marks":["code"],"text":"rune.forts"},{"id":"spn-64973","text":" (product schema)"}]}],"id":"blk-56553","kind":"list-item"},{"blocks":[{"id":"blk-56556","kind":"paragraph","spans":[{"id":"spn-64974","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-56555","kind":"list-item"},{"blocks":[{"id":"blk-56558","kind":"paragraph","spans":[{"id":"spn-64975","text":"Check if "},{"id":"spn-64976","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-64977","text":" or equivalent already exists before creating migration"}]}],"id":"blk-56557","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieramht5qmqa2eq7sp3cy3uzang6ioc2jeiqdedw6i3lzqqfrdjzns3q","vocabulary":"ampersand.docs.fs.v1"}