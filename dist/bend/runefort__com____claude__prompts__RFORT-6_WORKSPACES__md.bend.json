{"bendscript":"0.1","blocks":[{"id":"blk-83090","kind":"heading","level":1,"spans":[{"id":"spn-115189","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-83091","kind":"heading","level":2,"spans":[{"id":"spn-115190","text":"Goal"}]},{"id":"blk-83092","kind":"paragraph","spans":[{"id":"spn-115191","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-115192","marks":["code"],"text":"amp.workspaces"},{"id":"spn-115193","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-83093","kind":"heading","level":2,"spans":[{"id":"spn-115194","text":"Prerequisites"}]},{"id":"blk-83094","items":[{"blocks":[{"id":"blk-83096","kind":"paragraph","spans":[{"id":"spn-115195","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-83095","kind":"list-item"},{"blocks":[{"id":"blk-83098","kind":"paragraph","spans":[{"id":"spn-115196","text":"Auth system already exists ("},{"id":"spn-115197","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-115198","text":", "},{"id":"spn-115199","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-115200","text":")"}]}],"id":"blk-83097","kind":"list-item"},{"blocks":[{"id":"blk-83100","kind":"paragraph","spans":[{"id":"spn-115201","text":"Supabase client exists ("},{"id":"spn-115202","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-115203","text":") targeting "},{"id":"spn-115204","marks":["code"],"text":"rune"},{"id":"spn-115205","text":" schema"}]}],"id":"blk-83099","kind":"list-item"},{"blocks":[{"id":"blk-83102","kind":"paragraph","spans":[{"id":"spn-115206","text":"Persistence layer exists ("},{"id":"spn-115207","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-115208","text":") with CRUD for "},{"id":"spn-115209","marks":["code"],"text":"rune.forts"},{"id":"spn-115210","text":" and "},{"id":"spn-115211","marks":["code"],"text":"rune.views"}]}],"id":"blk-83101","kind":"list-item"},{"blocks":[{"id":"blk-83104","kind":"paragraph","spans":[{"id":"spn-115212","text":"Migrations exist: "},{"id":"spn-115213","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-115214","text":" (forts, views, bridges, districts tables), "},{"id":"spn-115215","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-115216","text":" (RLS policies using "},{"id":"spn-115217","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-115218","text":")"}]}],"id":"blk-83103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83105","kind":"heading","level":2,"spans":[{"id":"spn-115219","text":"Files to Create"}]},{"id":"blk-83106","kind":"heading","level":3,"spans":[{"id":"spn-115220","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-83107","kind":"paragraph","spans":[{"id":"spn-115221","text":"Workspace loader using Supabase:"}]},{"id":"blk-83108","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-83109","kind":"heading","level":3,"spans":[{"id":"spn-115222","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-83110","kind":"paragraph","spans":[{"id":"spn-115223","text":"Svelte 5 rune store:"}]},{"id":"blk-83111","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-83112","kind":"heading","level":3,"spans":[{"id":"spn-115224","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-83113","kind":"paragraph","spans":[{"id":"spn-115225","text":"Dropdown in the toolbar:"}]},{"id":"blk-83114","items":[{"blocks":[{"id":"blk-83116","kind":"paragraph","spans":[{"id":"spn-115226","text":"Shows current workspace name"}]}],"id":"blk-83115","kind":"list-item"},{"blocks":[{"id":"blk-83118","kind":"paragraph","spans":[{"id":"spn-115227","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-83117","kind":"list-item"},{"blocks":[{"id":"blk-83120","kind":"paragraph","spans":[{"id":"spn-115228","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-83119","kind":"list-item"},{"blocks":[{"id":"blk-83122","kind":"paragraph","spans":[{"id":"spn-115229","text":"Switching workspace triggers "},{"id":"spn-115230","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-115231","text":" which reloads forts"}]}],"id":"blk-83121","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83123","kind":"heading","level":3,"spans":[{"id":"spn-115232","text":"Supabase RPC (migration)"}]},{"id":"blk-83124","kind":"paragraph","spans":[{"id":"spn-115233","text":"If "},{"id":"spn-115234","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-115235","text":" doesn't exist yet, create: "},{"id":"spn-115236","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-115237","text":":"}]},{"id":"blk-83125","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-83126","kind":"heading","level":2,"spans":[{"id":"spn-115238","text":"Integration Points"}]},{"id":"blk-83127","items":[{"blocks":[{"id":"blk-83129","kind":"paragraph","spans":[{"id":"spn-115239","marks":["bold"],"text":"Toolbar"},{"id":"spn-115240","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-115241","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-115242","text":" dropdown when authenticated"}]}],"id":"blk-83128","kind":"list-item"},{"blocks":[{"id":"blk-83131","kind":"paragraph","spans":[{"id":"spn-115243","marks":["bold"],"text":"Auth flow"},{"id":"spn-115244","text":": After sign-in, call "},{"id":"spn-115245","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-115246","text":" to load the user's workspaces"}]}],"id":"blk-83130","kind":"list-item"},{"blocks":[{"id":"blk-83133","kind":"paragraph","spans":[{"id":"spn-115247","marks":["bold"],"text":"Fort store"},{"id":"spn-115248","text":": Add "},{"id":"spn-115249","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-115250","text":" that converts saved forts into an L0 district view"}]}],"id":"blk-83132","kind":"list-item"},{"blocks":[{"id":"blk-83135","kind":"paragraph","spans":[{"id":"spn-115251","marks":["bold"],"text":"Save flow"},{"id":"spn-115252","text":": When saving a fort, include "},{"id":"spn-115253","marks":["code"],"text":"workspace_id"},{"id":"spn-115254","text":" from active workspace"}]}],"id":"blk-83134","kind":"list-item"},{"blocks":[{"id":"blk-83137","kind":"paragraph","spans":[{"id":"spn-115255","marks":["bold"],"text":"BlueprintList"},{"id":"spn-115256","text":": Filter by active workspace"}]}],"id":"blk-83136","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-83138","kind":"heading","level":2,"spans":[{"id":"spn-115257","text":"Constraints"}]},{"id":"blk-83139","items":[{"blocks":[{"id":"blk-83141","kind":"paragraph","spans":[{"id":"spn-115258","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-83140","kind":"list-item"},{"blocks":[{"id":"blk-83143","kind":"paragraph","spans":[{"id":"spn-115259","text":"Workspace data comes from "},{"id":"spn-115260","marks":["code"],"text":"amp.workspaces"},{"id":"spn-115261","text":" + "},{"id":"spn-115262","marks":["code"],"text":"amp.members"},{"id":"spn-115263","text":" (shared schema)"}]}],"id":"blk-83142","kind":"list-item"},{"blocks":[{"id":"blk-83145","kind":"paragraph","spans":[{"id":"spn-115264","text":"Fort data comes from "},{"id":"spn-115265","marks":["code"],"text":"rune.forts"},{"id":"spn-115266","text":" (product schema)"}]}],"id":"blk-83144","kind":"list-item"},{"blocks":[{"id":"blk-83147","kind":"paragraph","spans":[{"id":"spn-115267","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-83146","kind":"list-item"},{"blocks":[{"id":"blk-83149","kind":"paragraph","spans":[{"id":"spn-115268","text":"Check if "},{"id":"spn-115269","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-115270","text":" or equivalent already exists before creating migration"}]}],"id":"blk-83148","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraxhiacmbpuyk5w7qhsu6aarctpwrerp7cxyorm3jv62skag5vm5xa","vocabulary":"ampersand.docs.fs.v1"}