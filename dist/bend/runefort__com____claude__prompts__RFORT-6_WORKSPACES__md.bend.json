{"bendscript":"0.1","blocks":[{"id":"blk-56995","kind":"heading","level":1,"spans":[{"id":"spn-66069","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-56996","kind":"heading","level":2,"spans":[{"id":"spn-66070","text":"Goal"}]},{"id":"blk-56997","kind":"paragraph","spans":[{"id":"spn-66071","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-66072","marks":["code"],"text":"amp.workspaces"},{"id":"spn-66073","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-56998","kind":"heading","level":2,"spans":[{"id":"spn-66074","text":"Prerequisites"}]},{"id":"blk-56999","items":[{"blocks":[{"id":"blk-57001","kind":"paragraph","spans":[{"id":"spn-66075","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-57000","kind":"list-item"},{"blocks":[{"id":"blk-57003","kind":"paragraph","spans":[{"id":"spn-66076","text":"Auth system already exists ("},{"id":"spn-66077","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-66078","text":", "},{"id":"spn-66079","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-66080","text":")"}]}],"id":"blk-57002","kind":"list-item"},{"blocks":[{"id":"blk-57005","kind":"paragraph","spans":[{"id":"spn-66081","text":"Supabase client exists ("},{"id":"spn-66082","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-66083","text":") targeting "},{"id":"spn-66084","marks":["code"],"text":"rune"},{"id":"spn-66085","text":" schema"}]}],"id":"blk-57004","kind":"list-item"},{"blocks":[{"id":"blk-57007","kind":"paragraph","spans":[{"id":"spn-66086","text":"Persistence layer exists ("},{"id":"spn-66087","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-66088","text":") with CRUD for "},{"id":"spn-66089","marks":["code"],"text":"rune.forts"},{"id":"spn-66090","text":" and "},{"id":"spn-66091","marks":["code"],"text":"rune.views"}]}],"id":"blk-57006","kind":"list-item"},{"blocks":[{"id":"blk-57009","kind":"paragraph","spans":[{"id":"spn-66092","text":"Migrations exist: "},{"id":"spn-66093","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-66094","text":" (forts, views, bridges, districts tables), "},{"id":"spn-66095","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-66096","text":" (RLS policies using "},{"id":"spn-66097","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-66098","text":")"}]}],"id":"blk-57008","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57010","kind":"heading","level":2,"spans":[{"id":"spn-66099","text":"Files to Create"}]},{"id":"blk-57011","kind":"heading","level":3,"spans":[{"id":"spn-66100","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-57012","kind":"paragraph","spans":[{"id":"spn-66101","text":"Workspace loader using Supabase:"}]},{"id":"blk-57013","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-57014","kind":"heading","level":3,"spans":[{"id":"spn-66102","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-57015","kind":"paragraph","spans":[{"id":"spn-66103","text":"Svelte 5 rune store:"}]},{"id":"blk-57016","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-57017","kind":"heading","level":3,"spans":[{"id":"spn-66104","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-57018","kind":"paragraph","spans":[{"id":"spn-66105","text":"Dropdown in the toolbar:"}]},{"id":"blk-57019","items":[{"blocks":[{"id":"blk-57021","kind":"paragraph","spans":[{"id":"spn-66106","text":"Shows current workspace name"}]}],"id":"blk-57020","kind":"list-item"},{"blocks":[{"id":"blk-57023","kind":"paragraph","spans":[{"id":"spn-66107","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-57022","kind":"list-item"},{"blocks":[{"id":"blk-57025","kind":"paragraph","spans":[{"id":"spn-66108","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-57024","kind":"list-item"},{"blocks":[{"id":"blk-57027","kind":"paragraph","spans":[{"id":"spn-66109","text":"Switching workspace triggers "},{"id":"spn-66110","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-66111","text":" which reloads forts"}]}],"id":"blk-57026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57028","kind":"heading","level":3,"spans":[{"id":"spn-66112","text":"Supabase RPC (migration)"}]},{"id":"blk-57029","kind":"paragraph","spans":[{"id":"spn-66113","text":"If "},{"id":"spn-66114","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-66115","text":" doesn't exist yet, create: "},{"id":"spn-66116","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-66117","text":":"}]},{"id":"blk-57030","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-57031","kind":"heading","level":2,"spans":[{"id":"spn-66118","text":"Integration Points"}]},{"id":"blk-57032","kind":"paragraph","spans":[{"id":"spn-66119","text":"1. "},{"id":"spn-66120","marks":["bold"],"text":"Toolbar"},{"id":"spn-66121","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-66122","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-66123","text":" dropdown when authenticated 2. "},{"id":"spn-66124","marks":["bold"],"text":"Auth flow"},{"id":"spn-66125","text":": After sign-in, call "},{"id":"spn-66126","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-66127","text":" to load the user's workspaces 3. "},{"id":"spn-66128","marks":["bold"],"text":"Fort store"},{"id":"spn-66129","text":": Add "},{"id":"spn-66130","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-66131","text":" that converts saved forts into an L0 district view 4. "},{"id":"spn-66132","marks":["bold"],"text":"Save flow"},{"id":"spn-66133","text":": When saving a fort, include "},{"id":"spn-66134","marks":["code"],"text":"workspace_id"},{"id":"spn-66135","text":" from active workspace 5. "},{"id":"spn-66136","marks":["bold"],"text":"BlueprintList"},{"id":"spn-66137","text":": Filter by active workspace"}]},{"id":"blk-57033","kind":"heading","level":2,"spans":[{"id":"spn-66138","text":"Constraints"}]},{"id":"blk-57034","items":[{"blocks":[{"id":"blk-57036","kind":"paragraph","spans":[{"id":"spn-66139","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-57035","kind":"list-item"},{"blocks":[{"id":"blk-57038","kind":"paragraph","spans":[{"id":"spn-66140","text":"Workspace data comes from "},{"id":"spn-66141","marks":["code"],"text":"amp.workspaces"},{"id":"spn-66142","text":" + "},{"id":"spn-66143","marks":["code"],"text":"amp.members"},{"id":"spn-66144","text":" (shared schema)"}]}],"id":"blk-57037","kind":"list-item"},{"blocks":[{"id":"blk-57040","kind":"paragraph","spans":[{"id":"spn-66145","text":"Fort data comes from "},{"id":"spn-66146","marks":["code"],"text":"rune.forts"},{"id":"spn-66147","text":" (product schema)"}]}],"id":"blk-57039","kind":"list-item"},{"blocks":[{"id":"blk-57042","kind":"paragraph","spans":[{"id":"spn-66148","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-57041","kind":"list-item"},{"blocks":[{"id":"blk-57044","kind":"paragraph","spans":[{"id":"spn-66149","text":"Check if "},{"id":"spn-66150","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-66151","text":" or equivalent already exists before creating migration"}]}],"id":"blk-57043","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieravpnxmfpncippcifk2klcsz762ujftj5yyselim6vzulrakf6jvea","vocabulary":"ampersand.docs.fs.v1"}