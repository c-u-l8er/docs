{"bendscript":"0.1","blocks":[{"id":"blk-83079","kind":"heading","level":1,"spans":[{"id":"spn-115136","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-83080","kind":"heading","level":2,"spans":[{"id":"spn-115137","text":"Goal"}]},{"id":"blk-83081","kind":"paragraph","spans":[{"id":"spn-115138","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-115139","marks":["code"],"text":"amp.workspaces"},{"id":"spn-115140","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-83082","kind":"heading","level":2,"spans":[{"id":"spn-115141","text":"Prerequisites"}]},{"id":"blk-83083","items":[{"blocks":[{"id":"blk-83085","kind":"paragraph","spans":[{"id":"spn-115142","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-83084","kind":"list-item"},{"blocks":[{"id":"blk-83087","kind":"paragraph","spans":[{"id":"spn-115143","text":"Auth system already exists ("},{"id":"spn-115144","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-115145","text":", "},{"id":"spn-115146","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-115147","text":")"}]}],"id":"blk-83086","kind":"list-item"},{"blocks":[{"id":"blk-83089","kind":"paragraph","spans":[{"id":"spn-115148","text":"Supabase client exists ("},{"id":"spn-115149","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-115150","text":") targeting "},{"id":"spn-115151","marks":["code"],"text":"rune"},{"id":"spn-115152","text":" schema"}]}],"id":"blk-83088","kind":"list-item"},{"blocks":[{"id":"blk-83091","kind":"paragraph","spans":[{"id":"spn-115153","text":"Persistence layer exists ("},{"id":"spn-115154","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-115155","text":") with CRUD for "},{"id":"spn-115156","marks":["code"],"text":"rune.forts"},{"id":"spn-115157","text":" and "},{"id":"spn-115158","marks":["code"],"text":"rune.views"}]}],"id":"blk-83090","kind":"list-item"},{"blocks":[{"id":"blk-83093","kind":"paragraph","spans":[{"id":"spn-115159","text":"Migrations exist: "},{"id":"spn-115160","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-115161","text":" (forts, views, bridges, districts tables), "},{"id":"spn-115162","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-115163","text":" (RLS policies using "},{"id":"spn-115164","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-115165","text":")"}]}],"id":"blk-83092","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83094","kind":"heading","level":2,"spans":[{"id":"spn-115166","text":"Files to Create"}]},{"id":"blk-83095","kind":"heading","level":3,"spans":[{"id":"spn-115167","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-83096","kind":"paragraph","spans":[{"id":"spn-115168","text":"Workspace loader using Supabase:"}]},{"id":"blk-83097","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-83098","kind":"heading","level":3,"spans":[{"id":"spn-115169","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-83099","kind":"paragraph","spans":[{"id":"spn-115170","text":"Svelte 5 rune store:"}]},{"id":"blk-83100","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-83101","kind":"heading","level":3,"spans":[{"id":"spn-115171","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-83102","kind":"paragraph","spans":[{"id":"spn-115172","text":"Dropdown in the toolbar:"}]},{"id":"blk-83103","items":[{"blocks":[{"id":"blk-83105","kind":"paragraph","spans":[{"id":"spn-115173","text":"Shows current workspace name"}]}],"id":"blk-83104","kind":"list-item"},{"blocks":[{"id":"blk-83107","kind":"paragraph","spans":[{"id":"spn-115174","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-83106","kind":"list-item"},{"blocks":[{"id":"blk-83109","kind":"paragraph","spans":[{"id":"spn-115175","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-83108","kind":"list-item"},{"blocks":[{"id":"blk-83111","kind":"paragraph","spans":[{"id":"spn-115176","text":"Switching workspace triggers "},{"id":"spn-115177","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-115178","text":" which reloads forts"}]}],"id":"blk-83110","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83112","kind":"heading","level":3,"spans":[{"id":"spn-115179","text":"Supabase RPC (migration)"}]},{"id":"blk-83113","kind":"paragraph","spans":[{"id":"spn-115180","text":"If "},{"id":"spn-115181","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-115182","text":" doesn't exist yet, create: "},{"id":"spn-115183","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-115184","text":":"}]},{"id":"blk-83114","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-83115","kind":"heading","level":2,"spans":[{"id":"spn-115185","text":"Integration Points"}]},{"id":"blk-83116","items":[{"blocks":[{"id":"blk-83118","kind":"paragraph","spans":[{"id":"spn-115186","marks":["bold"],"text":"Toolbar"},{"id":"spn-115187","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-115188","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-115189","text":" dropdown when authenticated"}]}],"id":"blk-83117","kind":"list-item"},{"blocks":[{"id":"blk-83120","kind":"paragraph","spans":[{"id":"spn-115190","marks":["bold"],"text":"Auth flow"},{"id":"spn-115191","text":": After sign-in, call "},{"id":"spn-115192","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-115193","text":" to load the user's workspaces"}]}],"id":"blk-83119","kind":"list-item"},{"blocks":[{"id":"blk-83122","kind":"paragraph","spans":[{"id":"spn-115194","marks":["bold"],"text":"Fort store"},{"id":"spn-115195","text":": Add "},{"id":"spn-115196","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-115197","text":" that converts saved forts into an L0 district view"}]}],"id":"blk-83121","kind":"list-item"},{"blocks":[{"id":"blk-83124","kind":"paragraph","spans":[{"id":"spn-115198","marks":["bold"],"text":"Save flow"},{"id":"spn-115199","text":": When saving a fort, include "},{"id":"spn-115200","marks":["code"],"text":"workspace_id"},{"id":"spn-115201","text":" from active workspace"}]}],"id":"blk-83123","kind":"list-item"},{"blocks":[{"id":"blk-83126","kind":"paragraph","spans":[{"id":"spn-115202","marks":["bold"],"text":"BlueprintList"},{"id":"spn-115203","text":": Filter by active workspace"}]}],"id":"blk-83125","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-83127","kind":"heading","level":2,"spans":[{"id":"spn-115204","text":"Constraints"}]},{"id":"blk-83128","items":[{"blocks":[{"id":"blk-83130","kind":"paragraph","spans":[{"id":"spn-115205","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-83129","kind":"list-item"},{"blocks":[{"id":"blk-83132","kind":"paragraph","spans":[{"id":"spn-115206","text":"Workspace data comes from "},{"id":"spn-115207","marks":["code"],"text":"amp.workspaces"},{"id":"spn-115208","text":" + "},{"id":"spn-115209","marks":["code"],"text":"amp.members"},{"id":"spn-115210","text":" (shared schema)"}]}],"id":"blk-83131","kind":"list-item"},{"blocks":[{"id":"blk-83134","kind":"paragraph","spans":[{"id":"spn-115211","text":"Fort data comes from "},{"id":"spn-115212","marks":["code"],"text":"rune.forts"},{"id":"spn-115213","text":" (product schema)"}]}],"id":"blk-83133","kind":"list-item"},{"blocks":[{"id":"blk-83136","kind":"paragraph","spans":[{"id":"spn-115214","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-83135","kind":"list-item"},{"blocks":[{"id":"blk-83138","kind":"paragraph","spans":[{"id":"spn-115215","text":"Check if "},{"id":"spn-115216","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-115217","text":" or equivalent already exists before creating migration"}]}],"id":"blk-83137","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera4z6hz7rzjikxi6vjz7u5qakftnzwhpvk5rkvla7pnegzrrgia6ka","vocabulary":"ampersand.docs.fs.v1"}