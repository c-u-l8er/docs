{"bendscript":"0.1","blocks":[{"id":"blk-57481","kind":"heading","level":1,"spans":[{"id":"spn-67189","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-57482","kind":"heading","level":2,"spans":[{"id":"spn-67190","text":"Goal"}]},{"id":"blk-57483","kind":"paragraph","spans":[{"id":"spn-67191","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-67192","marks":["code"],"text":"amp.workspaces"},{"id":"spn-67193","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-57484","kind":"heading","level":2,"spans":[{"id":"spn-67194","text":"Prerequisites"}]},{"id":"blk-57485","items":[{"blocks":[{"id":"blk-57487","kind":"paragraph","spans":[{"id":"spn-67195","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-57486","kind":"list-item"},{"blocks":[{"id":"blk-57489","kind":"paragraph","spans":[{"id":"spn-67196","text":"Auth system already exists ("},{"id":"spn-67197","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-67198","text":", "},{"id":"spn-67199","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-67200","text":")"}]}],"id":"blk-57488","kind":"list-item"},{"blocks":[{"id":"blk-57491","kind":"paragraph","spans":[{"id":"spn-67201","text":"Supabase client exists ("},{"id":"spn-67202","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-67203","text":") targeting "},{"id":"spn-67204","marks":["code"],"text":"rune"},{"id":"spn-67205","text":" schema"}]}],"id":"blk-57490","kind":"list-item"},{"blocks":[{"id":"blk-57493","kind":"paragraph","spans":[{"id":"spn-67206","text":"Persistence layer exists ("},{"id":"spn-67207","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-67208","text":") with CRUD for "},{"id":"spn-67209","marks":["code"],"text":"rune.forts"},{"id":"spn-67210","text":" and "},{"id":"spn-67211","marks":["code"],"text":"rune.views"}]}],"id":"blk-57492","kind":"list-item"},{"blocks":[{"id":"blk-57495","kind":"paragraph","spans":[{"id":"spn-67212","text":"Migrations exist: "},{"id":"spn-67213","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-67214","text":" (forts, views, bridges, districts tables), "},{"id":"spn-67215","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-67216","text":" (RLS policies using "},{"id":"spn-67217","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-67218","text":")"}]}],"id":"blk-57494","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57496","kind":"heading","level":2,"spans":[{"id":"spn-67219","text":"Files to Create"}]},{"id":"blk-57497","kind":"heading","level":3,"spans":[{"id":"spn-67220","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-57498","kind":"paragraph","spans":[{"id":"spn-67221","text":"Workspace loader using Supabase:"}]},{"id":"blk-57499","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-57500","kind":"heading","level":3,"spans":[{"id":"spn-67222","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-57501","kind":"paragraph","spans":[{"id":"spn-67223","text":"Svelte 5 rune store:"}]},{"id":"blk-57502","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-57503","kind":"heading","level":3,"spans":[{"id":"spn-67224","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-57504","kind":"paragraph","spans":[{"id":"spn-67225","text":"Dropdown in the toolbar:"}]},{"id":"blk-57505","items":[{"blocks":[{"id":"blk-57507","kind":"paragraph","spans":[{"id":"spn-67226","text":"Shows current workspace name"}]}],"id":"blk-57506","kind":"list-item"},{"blocks":[{"id":"blk-57509","kind":"paragraph","spans":[{"id":"spn-67227","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-57508","kind":"list-item"},{"blocks":[{"id":"blk-57511","kind":"paragraph","spans":[{"id":"spn-67228","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-57510","kind":"list-item"},{"blocks":[{"id":"blk-57513","kind":"paragraph","spans":[{"id":"spn-67229","text":"Switching workspace triggers "},{"id":"spn-67230","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-67231","text":" which reloads forts"}]}],"id":"blk-57512","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57514","kind":"heading","level":3,"spans":[{"id":"spn-67232","text":"Supabase RPC (migration)"}]},{"id":"blk-57515","kind":"paragraph","spans":[{"id":"spn-67233","text":"If "},{"id":"spn-67234","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-67235","text":" doesn't exist yet, create: "},{"id":"spn-67236","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-67237","text":":"}]},{"id":"blk-57516","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-57517","kind":"heading","level":2,"spans":[{"id":"spn-67238","text":"Integration Points"}]},{"id":"blk-57518","kind":"paragraph","spans":[{"id":"spn-67239","text":"1. "},{"id":"spn-67240","marks":["bold"],"text":"Toolbar"},{"id":"spn-67241","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-67242","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-67243","text":" dropdown when authenticated 2. "},{"id":"spn-67244","marks":["bold"],"text":"Auth flow"},{"id":"spn-67245","text":": After sign-in, call "},{"id":"spn-67246","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-67247","text":" to load the user's workspaces 3. "},{"id":"spn-67248","marks":["bold"],"text":"Fort store"},{"id":"spn-67249","text":": Add "},{"id":"spn-67250","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-67251","text":" that converts saved forts into an L0 district view 4. "},{"id":"spn-67252","marks":["bold"],"text":"Save flow"},{"id":"spn-67253","text":": When saving a fort, include "},{"id":"spn-67254","marks":["code"],"text":"workspace_id"},{"id":"spn-67255","text":" from active workspace 5. "},{"id":"spn-67256","marks":["bold"],"text":"BlueprintList"},{"id":"spn-67257","text":": Filter by active workspace"}]},{"id":"blk-57519","kind":"heading","level":2,"spans":[{"id":"spn-67258","text":"Constraints"}]},{"id":"blk-57520","items":[{"blocks":[{"id":"blk-57522","kind":"paragraph","spans":[{"id":"spn-67259","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-57521","kind":"list-item"},{"blocks":[{"id":"blk-57524","kind":"paragraph","spans":[{"id":"spn-67260","text":"Workspace data comes from "},{"id":"spn-67261","marks":["code"],"text":"amp.workspaces"},{"id":"spn-67262","text":" + "},{"id":"spn-67263","marks":["code"],"text":"amp.members"},{"id":"spn-67264","text":" (shared schema)"}]}],"id":"blk-57523","kind":"list-item"},{"blocks":[{"id":"blk-57526","kind":"paragraph","spans":[{"id":"spn-67265","text":"Fort data comes from "},{"id":"spn-67266","marks":["code"],"text":"rune.forts"},{"id":"spn-67267","text":" (product schema)"}]}],"id":"blk-57525","kind":"list-item"},{"blocks":[{"id":"blk-57528","kind":"paragraph","spans":[{"id":"spn-67268","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-57527","kind":"list-item"},{"blocks":[{"id":"blk-57530","kind":"paragraph","spans":[{"id":"spn-67269","text":"Check if "},{"id":"spn-67270","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-67271","text":" or equivalent already exists before creating migration"}]}],"id":"blk-57529","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierahk2pslxrzy2oopg4ykdnhvysop4i2hlnpa4gcgm6d44ukznhf3wa","vocabulary":"ampersand.docs.fs.v1"}