{"bendscript":"0.1","blocks":[{"id":"blk-84044","kind":"heading","level":1,"spans":[{"id":"spn-117976","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-84045","kind":"heading","level":2,"spans":[{"id":"spn-117977","text":"Goal"}]},{"id":"blk-84046","kind":"paragraph","spans":[{"id":"spn-117978","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-117979","marks":["code"],"text":"amp.workspaces"},{"id":"spn-117980","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-84047","kind":"heading","level":2,"spans":[{"id":"spn-117981","text":"Prerequisites"}]},{"id":"blk-84048","items":[{"blocks":[{"id":"blk-84050","kind":"paragraph","spans":[{"id":"spn-117982","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-84049","kind":"list-item"},{"blocks":[{"id":"blk-84052","kind":"paragraph","spans":[{"id":"spn-117983","text":"Auth system already exists ("},{"id":"spn-117984","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-117985","text":", "},{"id":"spn-117986","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-117987","text":")"}]}],"id":"blk-84051","kind":"list-item"},{"blocks":[{"id":"blk-84054","kind":"paragraph","spans":[{"id":"spn-117988","text":"Supabase client exists ("},{"id":"spn-117989","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-117990","text":") targeting "},{"id":"spn-117991","marks":["code"],"text":"rune"},{"id":"spn-117992","text":" schema"}]}],"id":"blk-84053","kind":"list-item"},{"blocks":[{"id":"blk-84056","kind":"paragraph","spans":[{"id":"spn-117993","text":"Persistence layer exists ("},{"id":"spn-117994","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-117995","text":") with CRUD for "},{"id":"spn-117996","marks":["code"],"text":"rune.forts"},{"id":"spn-117997","text":" and "},{"id":"spn-117998","marks":["code"],"text":"rune.views"}]}],"id":"blk-84055","kind":"list-item"},{"blocks":[{"id":"blk-84058","kind":"paragraph","spans":[{"id":"spn-117999","text":"Migrations exist: "},{"id":"spn-118000","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-118001","text":" (forts, views, bridges, districts tables), "},{"id":"spn-118002","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-118003","text":" (RLS policies using "},{"id":"spn-118004","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-118005","text":")"}]}],"id":"blk-84057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84059","kind":"heading","level":2,"spans":[{"id":"spn-118006","text":"Files to Create"}]},{"id":"blk-84060","kind":"heading","level":3,"spans":[{"id":"spn-118007","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-84061","kind":"paragraph","spans":[{"id":"spn-118008","text":"Workspace loader using Supabase:"}]},{"id":"blk-84062","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-84063","kind":"heading","level":3,"spans":[{"id":"spn-118009","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-84064","kind":"paragraph","spans":[{"id":"spn-118010","text":"Svelte 5 rune store:"}]},{"id":"blk-84065","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-84066","kind":"heading","level":3,"spans":[{"id":"spn-118011","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-84067","kind":"paragraph","spans":[{"id":"spn-118012","text":"Dropdown in the toolbar:"}]},{"id":"blk-84068","items":[{"blocks":[{"id":"blk-84070","kind":"paragraph","spans":[{"id":"spn-118013","text":"Shows current workspace name"}]}],"id":"blk-84069","kind":"list-item"},{"blocks":[{"id":"blk-84072","kind":"paragraph","spans":[{"id":"spn-118014","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-84071","kind":"list-item"},{"blocks":[{"id":"blk-84074","kind":"paragraph","spans":[{"id":"spn-118015","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-84073","kind":"list-item"},{"blocks":[{"id":"blk-84076","kind":"paragraph","spans":[{"id":"spn-118016","text":"Switching workspace triggers "},{"id":"spn-118017","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-118018","text":" which reloads forts"}]}],"id":"blk-84075","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84077","kind":"heading","level":3,"spans":[{"id":"spn-118019","text":"Supabase RPC (migration)"}]},{"id":"blk-84078","kind":"paragraph","spans":[{"id":"spn-118020","text":"If "},{"id":"spn-118021","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-118022","text":" doesn't exist yet, create: "},{"id":"spn-118023","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-118024","text":":"}]},{"id":"blk-84079","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-84080","kind":"heading","level":2,"spans":[{"id":"spn-118025","text":"Integration Points"}]},{"id":"blk-84081","items":[{"blocks":[{"id":"blk-84083","kind":"paragraph","spans":[{"id":"spn-118026","marks":["bold"],"text":"Toolbar"},{"id":"spn-118027","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-118028","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-118029","text":" dropdown when authenticated"}]}],"id":"blk-84082","kind":"list-item"},{"blocks":[{"id":"blk-84085","kind":"paragraph","spans":[{"id":"spn-118030","marks":["bold"],"text":"Auth flow"},{"id":"spn-118031","text":": After sign-in, call "},{"id":"spn-118032","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-118033","text":" to load the user's workspaces"}]}],"id":"blk-84084","kind":"list-item"},{"blocks":[{"id":"blk-84087","kind":"paragraph","spans":[{"id":"spn-118034","marks":["bold"],"text":"Fort store"},{"id":"spn-118035","text":": Add "},{"id":"spn-118036","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-118037","text":" that converts saved forts into an L0 district view"}]}],"id":"blk-84086","kind":"list-item"},{"blocks":[{"id":"blk-84089","kind":"paragraph","spans":[{"id":"spn-118038","marks":["bold"],"text":"Save flow"},{"id":"spn-118039","text":": When saving a fort, include "},{"id":"spn-118040","marks":["code"],"text":"workspace_id"},{"id":"spn-118041","text":" from active workspace"}]}],"id":"blk-84088","kind":"list-item"},{"blocks":[{"id":"blk-84091","kind":"paragraph","spans":[{"id":"spn-118042","marks":["bold"],"text":"BlueprintList"},{"id":"spn-118043","text":": Filter by active workspace"}]}],"id":"blk-84090","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-84092","kind":"heading","level":2,"spans":[{"id":"spn-118044","text":"Constraints"}]},{"id":"blk-84093","items":[{"blocks":[{"id":"blk-84095","kind":"paragraph","spans":[{"id":"spn-118045","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-84094","kind":"list-item"},{"blocks":[{"id":"blk-84097","kind":"paragraph","spans":[{"id":"spn-118046","text":"Workspace data comes from "},{"id":"spn-118047","marks":["code"],"text":"amp.workspaces"},{"id":"spn-118048","text":" + "},{"id":"spn-118049","marks":["code"],"text":"amp.members"},{"id":"spn-118050","text":" (shared schema)"}]}],"id":"blk-84096","kind":"list-item"},{"blocks":[{"id":"blk-84099","kind":"paragraph","spans":[{"id":"spn-118051","text":"Fort data comes from "},{"id":"spn-118052","marks":["code"],"text":"rune.forts"},{"id":"spn-118053","text":" (product schema)"}]}],"id":"blk-84098","kind":"list-item"},{"blocks":[{"id":"blk-84101","kind":"paragraph","spans":[{"id":"spn-118054","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-84100","kind":"list-item"},{"blocks":[{"id":"blk-84103","kind":"paragraph","spans":[{"id":"spn-118055","text":"Check if "},{"id":"spn-118056","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-118057","text":" or equivalent already exists before creating migration"}]}],"id":"blk-84102","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierarfl3ytanxpmzdcvm6oxs2pcfvou2djmkhaha5zbufpcnxxghzugq","vocabulary":"ampersand.docs.fs.v1"}