{"bendscript":"0.1","blocks":[{"id":"blk-83216","kind":"heading","level":1,"spans":[{"id":"spn-115337","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-83217","kind":"heading","level":2,"spans":[{"id":"spn-115338","text":"Goal"}]},{"id":"blk-83218","kind":"paragraph","spans":[{"id":"spn-115339","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-115340","marks":["code"],"text":"amp.workspaces"},{"id":"spn-115341","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-83219","kind":"heading","level":2,"spans":[{"id":"spn-115342","text":"Prerequisites"}]},{"id":"blk-83220","items":[{"blocks":[{"id":"blk-83222","kind":"paragraph","spans":[{"id":"spn-115343","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-83221","kind":"list-item"},{"blocks":[{"id":"blk-83224","kind":"paragraph","spans":[{"id":"spn-115344","text":"Auth system already exists ("},{"id":"spn-115345","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-115346","text":", "},{"id":"spn-115347","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-115348","text":")"}]}],"id":"blk-83223","kind":"list-item"},{"blocks":[{"id":"blk-83226","kind":"paragraph","spans":[{"id":"spn-115349","text":"Supabase client exists ("},{"id":"spn-115350","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-115351","text":") targeting "},{"id":"spn-115352","marks":["code"],"text":"rune"},{"id":"spn-115353","text":" schema"}]}],"id":"blk-83225","kind":"list-item"},{"blocks":[{"id":"blk-83228","kind":"paragraph","spans":[{"id":"spn-115354","text":"Persistence layer exists ("},{"id":"spn-115355","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-115356","text":") with CRUD for "},{"id":"spn-115357","marks":["code"],"text":"rune.forts"},{"id":"spn-115358","text":" and "},{"id":"spn-115359","marks":["code"],"text":"rune.views"}]}],"id":"blk-83227","kind":"list-item"},{"blocks":[{"id":"blk-83230","kind":"paragraph","spans":[{"id":"spn-115360","text":"Migrations exist: "},{"id":"spn-115361","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-115362","text":" (forts, views, bridges, districts tables), "},{"id":"spn-115363","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-115364","text":" (RLS policies using "},{"id":"spn-115365","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-115366","text":")"}]}],"id":"blk-83229","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83231","kind":"heading","level":2,"spans":[{"id":"spn-115367","text":"Files to Create"}]},{"id":"blk-83232","kind":"heading","level":3,"spans":[{"id":"spn-115368","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-83233","kind":"paragraph","spans":[{"id":"spn-115369","text":"Workspace loader using Supabase:"}]},{"id":"blk-83234","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-83235","kind":"heading","level":3,"spans":[{"id":"spn-115370","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-83236","kind":"paragraph","spans":[{"id":"spn-115371","text":"Svelte 5 rune store:"}]},{"id":"blk-83237","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-83238","kind":"heading","level":3,"spans":[{"id":"spn-115372","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-83239","kind":"paragraph","spans":[{"id":"spn-115373","text":"Dropdown in the toolbar:"}]},{"id":"blk-83240","items":[{"blocks":[{"id":"blk-83242","kind":"paragraph","spans":[{"id":"spn-115374","text":"Shows current workspace name"}]}],"id":"blk-83241","kind":"list-item"},{"blocks":[{"id":"blk-83244","kind":"paragraph","spans":[{"id":"spn-115375","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-83243","kind":"list-item"},{"blocks":[{"id":"blk-83246","kind":"paragraph","spans":[{"id":"spn-115376","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-83245","kind":"list-item"},{"blocks":[{"id":"blk-83248","kind":"paragraph","spans":[{"id":"spn-115377","text":"Switching workspace triggers "},{"id":"spn-115378","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-115379","text":" which reloads forts"}]}],"id":"blk-83247","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83249","kind":"heading","level":3,"spans":[{"id":"spn-115380","text":"Supabase RPC (migration)"}]},{"id":"blk-83250","kind":"paragraph","spans":[{"id":"spn-115381","text":"If "},{"id":"spn-115382","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-115383","text":" doesn't exist yet, create: "},{"id":"spn-115384","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-115385","text":":"}]},{"id":"blk-83251","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-83252","kind":"heading","level":2,"spans":[{"id":"spn-115386","text":"Integration Points"}]},{"id":"blk-83253","items":[{"blocks":[{"id":"blk-83255","kind":"paragraph","spans":[{"id":"spn-115387","marks":["bold"],"text":"Toolbar"},{"id":"spn-115388","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-115389","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-115390","text":" dropdown when authenticated"}]}],"id":"blk-83254","kind":"list-item"},{"blocks":[{"id":"blk-83257","kind":"paragraph","spans":[{"id":"spn-115391","marks":["bold"],"text":"Auth flow"},{"id":"spn-115392","text":": After sign-in, call "},{"id":"spn-115393","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-115394","text":" to load the user's workspaces"}]}],"id":"blk-83256","kind":"list-item"},{"blocks":[{"id":"blk-83259","kind":"paragraph","spans":[{"id":"spn-115395","marks":["bold"],"text":"Fort store"},{"id":"spn-115396","text":": Add "},{"id":"spn-115397","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-115398","text":" that converts saved forts into an L0 district view"}]}],"id":"blk-83258","kind":"list-item"},{"blocks":[{"id":"blk-83261","kind":"paragraph","spans":[{"id":"spn-115399","marks":["bold"],"text":"Save flow"},{"id":"spn-115400","text":": When saving a fort, include "},{"id":"spn-115401","marks":["code"],"text":"workspace_id"},{"id":"spn-115402","text":" from active workspace"}]}],"id":"blk-83260","kind":"list-item"},{"blocks":[{"id":"blk-83263","kind":"paragraph","spans":[{"id":"spn-115403","marks":["bold"],"text":"BlueprintList"},{"id":"spn-115404","text":": Filter by active workspace"}]}],"id":"blk-83262","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-83264","kind":"heading","level":2,"spans":[{"id":"spn-115405","text":"Constraints"}]},{"id":"blk-83265","items":[{"blocks":[{"id":"blk-83267","kind":"paragraph","spans":[{"id":"spn-115406","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-83266","kind":"list-item"},{"blocks":[{"id":"blk-83269","kind":"paragraph","spans":[{"id":"spn-115407","text":"Workspace data comes from "},{"id":"spn-115408","marks":["code"],"text":"amp.workspaces"},{"id":"spn-115409","text":" + "},{"id":"spn-115410","marks":["code"],"text":"amp.members"},{"id":"spn-115411","text":" (shared schema)"}]}],"id":"blk-83268","kind":"list-item"},{"blocks":[{"id":"blk-83271","kind":"paragraph","spans":[{"id":"spn-115412","text":"Fort data comes from "},{"id":"spn-115413","marks":["code"],"text":"rune.forts"},{"id":"spn-115414","text":" (product schema)"}]}],"id":"blk-83270","kind":"list-item"},{"blocks":[{"id":"blk-83273","kind":"paragraph","spans":[{"id":"spn-115415","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-83272","kind":"list-item"},{"blocks":[{"id":"blk-83275","kind":"paragraph","spans":[{"id":"spn-115416","text":"Check if "},{"id":"spn-115417","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-115418","text":" or equivalent already exists before creating migration"}]}],"id":"blk-83274","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierae5zv4jf32xho6bllxeytgyadj3nedwmjucc4zuvqikqvcgo6xqiq","vocabulary":"ampersand.docs.fs.v1"}