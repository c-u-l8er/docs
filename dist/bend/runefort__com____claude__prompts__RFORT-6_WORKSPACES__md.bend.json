{"bendscript":"0.1","blocks":[{"id":"blk-106543","kind":"heading","level":1,"spans":[{"id":"spn-171676","text":"RFort-6: Workspace Switcher + Supabase Persistence"}]},{"id":"blk-106544","kind":"heading","level":2,"spans":[{"id":"spn-171677","text":"Goal"}]},{"id":"blk-106545","kind":"paragraph","spans":[{"id":"spn-171678","text":"Connect RuneFort to the shared Supabase workspace system ("},{"id":"spn-171679","marks":["code"],"text":"amp.workspaces"},{"id":"spn-171680","text":"). Each workspace has its own district of forts. Switching workspace reloads the fort view from Supabase."}]},{"id":"blk-106546","kind":"heading","level":2,"spans":[{"id":"spn-171681","text":"Prerequisites"}]},{"id":"blk-106547","items":[{"blocks":[{"id":"blk-106549","kind":"paragraph","spans":[{"id":"spn-171682","text":"RFort-1 (BYOK) — not required"}]}],"id":"blk-106548","kind":"list-item"},{"blocks":[{"id":"blk-106551","kind":"paragraph","spans":[{"id":"spn-171683","text":"Auth system already exists ("},{"id":"spn-171684","marks":["code"],"text":"src/lib/stores/auth.svelte.js"},{"id":"spn-171685","text":", "},{"id":"spn-171686","marks":["code"],"text":"src/components/app/AuthModal.svelte"},{"id":"spn-171687","text":")"}]}],"id":"blk-106550","kind":"list-item"},{"blocks":[{"id":"blk-106553","kind":"paragraph","spans":[{"id":"spn-171688","text":"Supabase client exists ("},{"id":"spn-171689","marks":["code"],"text":"src/lib/supabase.js"},{"id":"spn-171690","text":") targeting "},{"id":"spn-171691","marks":["code"],"text":"rune"},{"id":"spn-171692","text":" schema"}]}],"id":"blk-106552","kind":"list-item"},{"blocks":[{"id":"blk-106555","kind":"paragraph","spans":[{"id":"spn-171693","text":"Persistence layer exists ("},{"id":"spn-171694","marks":["code"],"text":"src/lib/persistence.js"},{"id":"spn-171695","text":") with CRUD for "},{"id":"spn-171696","marks":["code"],"text":"rune.forts"},{"id":"spn-171697","text":" and "},{"id":"spn-171698","marks":["code"],"text":"rune.views"}]}],"id":"blk-106554","kind":"list-item"},{"blocks":[{"id":"blk-106557","kind":"paragraph","spans":[{"id":"spn-171699","text":"Migrations exist: "},{"id":"spn-171700","marks":["code"],"text":"ampersand-supabase/migrations/090_rune_schema.sql"},{"id":"spn-171701","text":" (forts, views, bridges, districts tables), "},{"id":"spn-171702","marks":["code"],"text":"091_rune_rls.sql"},{"id":"spn-171703","text":" (RLS policies using "},{"id":"spn-171704","marks":["code"],"text":"amp.is_workspace_member()"},{"id":"spn-171705","text":")"}]}],"id":"blk-106556","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106558","kind":"heading","level":2,"spans":[{"id":"spn-171706","text":"Files to Create"}]},{"id":"blk-106559","kind":"heading","level":3,"spans":[{"id":"spn-171707","marks":["code"],"text":"src/lib/play/workspaces.js"}]},{"id":"blk-106560","kind":"paragraph","spans":[{"id":"spn-171708","text":"Workspace loader using Supabase:"}]},{"id":"blk-106561","kind":"code","language":"js","text":"import { getSupabase } from '$lib/supabase.js';\n\n// List workspaces the user is a member of\nexport async function listWorkspaces() {\n  const sb = getSupabase();\n  if (!sb) return [];\n  // Query amp.workspaces via amp schema (need a second client or RPC)\n  // Alternatively, query rune.forts grouped by workspace_id\n  const { data } = await sb.rpc('list_my_workspaces');\n  return data || [];\n}\n\n// Load all forts for a workspace\nexport async function loadWorkspaceForts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('forts')\n    .select('*')\n    .eq('workspace_id', workspaceId)\n    .order('updated_at', { ascending: false });\n  return data || [];\n}\n\n// Load all districts for a workspace\nexport async function loadWorkspaceDistricts(workspaceId) {\n  const sb = getSupabase();\n  if (!sb) return [];\n  const { data } = await sb\n    .from('districts')\n    .select('*, forts(*)')\n    .eq('workspace_id', workspaceId);\n  return data || [];\n}"},{"id":"blk-106562","kind":"heading","level":3,"spans":[{"id":"spn-171709","marks":["code"],"text":"src/lib/stores/workspace.svelte.js"}]},{"id":"blk-106563","kind":"paragraph","spans":[{"id":"spn-171710","text":"Svelte 5 rune store:"}]},{"id":"blk-106564","kind":"code","language":"js","text":"let _workspaces = $state([]);\nlet _activeWorkspace = $state(null);\nlet _forts = $state([]);\n\nexport function getWorkspaces() { return _workspaces; }\nexport function getActiveWorkspace() { return _activeWorkspace; }\nexport function getWorkspaceForts() { return _forts; }\n\nexport async function initWorkspaces() {\n  _workspaces = await listWorkspaces();\n  if (_workspaces.length > 0) {\n    await switchWorkspace(_workspaces[0].id);\n  }\n}\n\nexport async function switchWorkspace(workspaceId) {\n  _activeWorkspace = _workspaces.find(w => w.id === workspaceId);\n  _forts = await loadWorkspaceForts(workspaceId);\n  // Trigger fort store to rebuild district from workspace forts\n}"},{"id":"blk-106565","kind":"heading","level":3,"spans":[{"id":"spn-171711","marks":["code"],"text":"src/components/app/WorkspaceSwitcher.svelte"}]},{"id":"blk-106566","kind":"paragraph","spans":[{"id":"spn-171712","text":"Dropdown in the toolbar:"}]},{"id":"blk-106567","items":[{"blocks":[{"id":"blk-106569","kind":"paragraph","spans":[{"id":"spn-171713","text":"Shows current workspace name"}]}],"id":"blk-106568","kind":"list-item"},{"blocks":[{"id":"blk-106571","kind":"paragraph","spans":[{"id":"spn-171714","text":"Dropdown lists all workspaces with fort counts"}]}],"id":"blk-106570","kind":"list-item"},{"blocks":[{"id":"blk-106573","kind":"paragraph","spans":[{"id":"spn-171715","text":"\"Demo\" option always available (loads demo manifests, no auth required)"}]}],"id":"blk-106572","kind":"list-item"},{"blocks":[{"id":"blk-106575","kind":"paragraph","spans":[{"id":"spn-171716","text":"Switching workspace triggers "},{"id":"spn-171717","marks":["code"],"text":"switchWorkspace()"},{"id":"spn-171718","text":" which reloads forts"}]}],"id":"blk-106574","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106576","kind":"heading","level":3,"spans":[{"id":"spn-171719","text":"Supabase RPC (migration)"}]},{"id":"blk-106577","kind":"paragraph","spans":[{"id":"spn-171720","text":"If "},{"id":"spn-171721","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-171722","text":" doesn't exist yet, create: "},{"id":"spn-171723","marks":["code"],"text":"ampersand-supabase/migrations/092_rune_workspace_rpc.sql"},{"id":"spn-171724","text":":"}]},{"id":"blk-106578","kind":"code","language":"sql","text":"-- RPC to list workspaces the current user is a member of\n-- This may already exist in amp schema; check first\nCREATE OR REPLACE FUNCTION rune.list_my_workspaces()\nRETURNS TABLE (id uuid, name text, slug text, fort_count bigint)\nLANGUAGE sql STABLE SECURITY DEFINER\nAS $$\n  SELECT w.id, w.name, w.slug, COUNT(f.id) as fort_count\n  FROM amp.workspaces w\n  JOIN amp.members m ON m.workspace_id = w.id\n  LEFT JOIN rune.forts f ON f.workspace_id = w.id\n  WHERE m.user_id = auth.uid()\n  GROUP BY w.id, w.name, w.slug\n  ORDER BY w.name;\n$$;\n\nGRANT EXECUTE ON FUNCTION rune.list_my_workspaces() TO authenticated;"},{"id":"blk-106579","kind":"heading","level":2,"spans":[{"id":"spn-171725","text":"Integration Points"}]},{"id":"blk-106580","items":[{"blocks":[{"id":"blk-106582","kind":"paragraph","spans":[{"id":"spn-171726","marks":["bold"],"text":"Toolbar"},{"id":"spn-171727","text":": Replace static \"RuneFort\" brand text with "},{"id":"spn-171728","marks":["code"],"text":"WorkspaceSwitcher"},{"id":"spn-171729","text":" dropdown when authenticated"}]}],"id":"blk-106581","kind":"list-item"},{"blocks":[{"id":"blk-106584","kind":"paragraph","spans":[{"id":"spn-171730","marks":["bold"],"text":"Auth flow"},{"id":"spn-171731","text":": After sign-in, call "},{"id":"spn-171732","marks":["code"],"text":"initWorkspaces()"},{"id":"spn-171733","text":" to load the user's workspaces"}]}],"id":"blk-106583","kind":"list-item"},{"blocks":[{"id":"blk-106586","kind":"paragraph","spans":[{"id":"spn-171734","marks":["bold"],"text":"Fort store"},{"id":"spn-171735","text":": Add "},{"id":"spn-171736","marks":["code"],"text":"loadWorkspaceDistrict(forts)"},{"id":"spn-171737","text":" that converts saved forts into an L0 district view"}]}],"id":"blk-106585","kind":"list-item"},{"blocks":[{"id":"blk-106588","kind":"paragraph","spans":[{"id":"spn-171738","marks":["bold"],"text":"Save flow"},{"id":"spn-171739","text":": When saving a fort, include "},{"id":"spn-171740","marks":["code"],"text":"workspace_id"},{"id":"spn-171741","text":" from active workspace"}]}],"id":"blk-106587","kind":"list-item"},{"blocks":[{"id":"blk-106590","kind":"paragraph","spans":[{"id":"spn-171742","marks":["bold"],"text":"BlueprintList"},{"id":"spn-171743","text":": Filter by active workspace"}]}],"id":"blk-106589","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-106591","kind":"heading","level":2,"spans":[{"id":"spn-171744","text":"Constraints"}]},{"id":"blk-106592","items":[{"blocks":[{"id":"blk-106594","kind":"paragraph","spans":[{"id":"spn-171745","text":"Unauthenticated users see demo forts only (the existing DEMO_MANIFESTS)"}]}],"id":"blk-106593","kind":"list-item"},{"blocks":[{"id":"blk-106596","kind":"paragraph","spans":[{"id":"spn-171746","text":"Workspace data comes from "},{"id":"spn-171747","marks":["code"],"text":"amp.workspaces"},{"id":"spn-171748","text":" + "},{"id":"spn-171749","marks":["code"],"text":"amp.members"},{"id":"spn-171750","text":" (shared schema)"}]}],"id":"blk-106595","kind":"list-item"},{"blocks":[{"id":"blk-106598","kind":"paragraph","spans":[{"id":"spn-171751","text":"Fort data comes from "},{"id":"spn-171752","marks":["code"],"text":"rune.forts"},{"id":"spn-171753","text":" (product schema)"}]}],"id":"blk-106597","kind":"list-item"},{"blocks":[{"id":"blk-106600","kind":"paragraph","spans":[{"id":"spn-171754","text":"RLS already handles access control — no client-side filtering needed"}]}],"id":"blk-106599","kind":"list-item"},{"blocks":[{"id":"blk-106602","kind":"paragraph","spans":[{"id":"spn-171755","text":"Check if "},{"id":"spn-171756","marks":["code"],"text":"amp.list_my_workspaces()"},{"id":"spn-171757","text":" or equivalent already exists before creating migration"}]}],"id":"blk-106601","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera3wr4qw5xnuzeieeiu62x4qabdzf6nyjoqoqtdkz7cyy22wvyggma","vocabulary":"ampersand.docs.fs.v1"}