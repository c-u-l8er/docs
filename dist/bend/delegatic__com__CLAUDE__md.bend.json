{"bendscript":"0.1","blocks":[{"id":"blk-59483","kind":"heading","level":1,"spans":[{"id":"spn-90516","text":"Delegatic — Governance for AI Agent Teams"}]},{"id":"blk-59484","kind":"paragraph","spans":[{"id":"spn-90517","text":"Governance and orchestration layer for multi-agent AI systems. Containment trees, monotonic policy inheritance, and immutable audit trails."}]},{"id":"blk-59485","kind":"heading","level":2,"spans":[{"id":"spn-90518","text":"Source-of-truth spec"}]},{"id":"blk-59486","items":[{"blocks":[{"id":"blk-59488","kind":"paragraph","spans":[{"id":"spn-90519","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-90520","text":" — Delegatic technical specification"}]}],"id":"blk-59487","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-59489","kind":"heading","level":2,"spans":[{"id":"spn-90521","text":"Role in [&] Ecosystem"}]},{"id":"blk-59490","kind":"paragraph","spans":[{"id":"spn-90522","text":"Delegatic is the "},{"id":"spn-90523","marks":["bold"],"text":"governance layer"},{"id":"spn-90524","text":" — it defines who can do what, enforces policy boundaries, and provides audit trails. It does not execute tasks, host agents, or run workflows."}]},{"id":"blk-59491","kind":"heading","level":2,"spans":[{"id":"spn-90525","text":"Core concepts"}]},{"id":"blk-59492","items":[{"blocks":[{"id":"blk-59494","kind":"paragraph","spans":[{"id":"spn-90526","marks":["bold"],"text":"Containment trees"},{"id":"spn-90527","text":" — strict org hierarchy, no cycles, no DAGs"}]}],"id":"blk-59493","kind":"list-item"},{"blocks":[{"id":"blk-59496","kind":"paragraph","spans":[{"id":"spn-90528","marks":["bold"],"text":"Monotonic policy inheritance"},{"id":"spn-90529","text":" — children can tighten, never widen parent restrictions"}]}],"id":"blk-59495","kind":"list-item"},{"blocks":[{"id":"blk-59498","kind":"paragraph","spans":[{"id":"spn-90530","marks":["bold"],"text":"Deny by default"},{"id":"spn-90531","text":" — no implicit permissions"}]}],"id":"blk-59497","kind":"list-item"},{"blocks":[{"id":"blk-59500","kind":"paragraph","spans":[{"id":"spn-90532","marks":["bold"],"text":"Append-only audit"},{"id":"spn-90533","text":" — every mutation logged immutably"}]}],"id":"blk-59499","kind":"list-item"},{"blocks":[{"id":"blk-59502","kind":"paragraph","spans":[{"id":"spn-90534","marks":["bold"],"text":"Goal-aware governance"},{"id":"spn-90535","text":" — references Graphonomous GoalGraph for durable intent"}]}],"id":"blk-59501","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-59503","kind":"heading","level":2,"spans":[{"id":"spn-90536","text":"Tech stack"}]},{"id":"blk-59504","kind":"paragraph","spans":[{"id":"spn-90537","text":"Elixir/OTP, Phoenix LiveView, PostgreSQL, ETS, Broadway, Oban"}]},{"id":"blk-59505","kind":"heading","level":2,"spans":[{"id":"spn-90538","text":"Status"}]},{"id":"blk-59506","kind":"paragraph","spans":[{"id":"spn-90539","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieragpwhgoh5erwukan7yhm565tiy5jemf3bhp3fyilwjmfdcuqquw7q","vocabulary":"ampersand.docs.fs.v1"}