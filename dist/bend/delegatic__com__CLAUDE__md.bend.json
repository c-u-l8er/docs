{"bendscript":"0.1","blocks":[{"id":"blk-59483","kind":"heading","level":1,"spans":[{"id":"spn-90542","text":"Delegatic — Governance for AI Agent Teams"}]},{"id":"blk-59484","kind":"paragraph","spans":[{"id":"spn-90543","text":"Governance and orchestration layer for multi-agent AI systems. Containment trees, monotonic policy inheritance, and immutable audit trails."}]},{"id":"blk-59485","kind":"heading","level":2,"spans":[{"id":"spn-90544","text":"Source-of-truth spec"}]},{"id":"blk-59486","items":[{"blocks":[{"id":"blk-59488","kind":"paragraph","spans":[{"id":"spn-90545","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-90546","text":" — Delegatic technical specification"}]}],"id":"blk-59487","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-59489","kind":"heading","level":2,"spans":[{"id":"spn-90547","text":"Role in [&] Ecosystem"}]},{"id":"blk-59490","kind":"paragraph","spans":[{"id":"spn-90548","text":"Delegatic is the "},{"id":"spn-90549","marks":["bold"],"text":"governance layer"},{"id":"spn-90550","text":" — it defines who can do what, enforces policy boundaries, and provides audit trails. It does not execute tasks, host agents, or run workflows."}]},{"id":"blk-59491","kind":"heading","level":2,"spans":[{"id":"spn-90551","text":"Core concepts"}]},{"id":"blk-59492","items":[{"blocks":[{"id":"blk-59494","kind":"paragraph","spans":[{"id":"spn-90552","marks":["bold"],"text":"Containment trees"},{"id":"spn-90553","text":" — strict org hierarchy, no cycles, no DAGs"}]}],"id":"blk-59493","kind":"list-item"},{"blocks":[{"id":"blk-59496","kind":"paragraph","spans":[{"id":"spn-90554","marks":["bold"],"text":"Monotonic policy inheritance"},{"id":"spn-90555","text":" — children can tighten, never widen parent restrictions"}]}],"id":"blk-59495","kind":"list-item"},{"blocks":[{"id":"blk-59498","kind":"paragraph","spans":[{"id":"spn-90556","marks":["bold"],"text":"Deny by default"},{"id":"spn-90557","text":" — no implicit permissions"}]}],"id":"blk-59497","kind":"list-item"},{"blocks":[{"id":"blk-59500","kind":"paragraph","spans":[{"id":"spn-90558","marks":["bold"],"text":"Append-only audit"},{"id":"spn-90559","text":" — every mutation logged immutably"}]}],"id":"blk-59499","kind":"list-item"},{"blocks":[{"id":"blk-59502","kind":"paragraph","spans":[{"id":"spn-90560","marks":["bold"],"text":"Goal-aware governance"},{"id":"spn-90561","text":" — references Graphonomous GoalGraph for durable intent"}]}],"id":"blk-59501","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-59503","kind":"heading","level":2,"spans":[{"id":"spn-90562","text":"Tech stack"}]},{"id":"blk-59504","kind":"paragraph","spans":[{"id":"spn-90563","text":"Elixir/OTP, Phoenix LiveView, PostgreSQL, ETS, Broadway, Oban"}]},{"id":"blk-59505","kind":"heading","level":2,"spans":[{"id":"spn-90564","text":"Status"}]},{"id":"blk-59506","kind":"paragraph","spans":[{"id":"spn-90565","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieraoljvdskgervwpiurtz5d3zpopqqrenppsfdgp5dw4ttxnxsc6quq","vocabulary":"ampersand.docs.fs.v1"}