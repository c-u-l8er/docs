{"bendscript":"0.1","blocks":[{"id":"blk-58587","kind":"heading","level":1,"spans":[{"id":"spn-87906","text":"Delegatic — Governance for AI Agent Teams"}]},{"id":"blk-58588","kind":"paragraph","spans":[{"id":"spn-87907","text":"Governance and orchestration layer for multi-agent AI systems. Containment trees, monotonic policy inheritance, and immutable audit trails."}]},{"id":"blk-58589","kind":"heading","level":2,"spans":[{"id":"spn-87908","text":"Source-of-truth spec"}]},{"id":"blk-58590","items":[{"blocks":[{"id":"blk-58592","kind":"paragraph","spans":[{"id":"spn-87909","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-87910","text":" — Delegatic technical specification"}]}],"id":"blk-58591","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58593","kind":"heading","level":2,"spans":[{"id":"spn-87911","text":"Role in [&] Ecosystem"}]},{"id":"blk-58594","kind":"paragraph","spans":[{"id":"spn-87912","text":"Delegatic is the "},{"id":"spn-87913","marks":["bold"],"text":"governance layer"},{"id":"spn-87914","text":" — it defines who can do what, enforces policy boundaries, and provides audit trails. It does not execute tasks, host agents, or run workflows."}]},{"id":"blk-58595","kind":"heading","level":2,"spans":[{"id":"spn-87915","text":"Core concepts"}]},{"id":"blk-58596","items":[{"blocks":[{"id":"blk-58598","kind":"paragraph","spans":[{"id":"spn-87916","marks":["bold"],"text":"Containment trees"},{"id":"spn-87917","text":" — strict org hierarchy, no cycles, no DAGs"}]}],"id":"blk-58597","kind":"list-item"},{"blocks":[{"id":"blk-58600","kind":"paragraph","spans":[{"id":"spn-87918","marks":["bold"],"text":"Monotonic policy inheritance"},{"id":"spn-87919","text":" — children can tighten, never widen parent restrictions"}]}],"id":"blk-58599","kind":"list-item"},{"blocks":[{"id":"blk-58602","kind":"paragraph","spans":[{"id":"spn-87920","marks":["bold"],"text":"Deny by default"},{"id":"spn-87921","text":" — no implicit permissions"}]}],"id":"blk-58601","kind":"list-item"},{"blocks":[{"id":"blk-58604","kind":"paragraph","spans":[{"id":"spn-87922","marks":["bold"],"text":"Append-only audit"},{"id":"spn-87923","text":" — every mutation logged immutably"}]}],"id":"blk-58603","kind":"list-item"},{"blocks":[{"id":"blk-58606","kind":"paragraph","spans":[{"id":"spn-87924","marks":["bold"],"text":"Goal-aware governance"},{"id":"spn-87925","text":" — references Graphonomous GoalGraph for durable intent"}]}],"id":"blk-58605","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58607","kind":"heading","level":2,"spans":[{"id":"spn-87926","text":"Tech stack"}]},{"id":"blk-58608","kind":"paragraph","spans":[{"id":"spn-87927","text":"Elixir/OTP, Phoenix LiveView, PostgreSQL, ETS, Broadway, Oban"}]},{"id":"blk-58609","kind":"heading","level":2,"spans":[{"id":"spn-87928","text":"Status"}]},{"id":"blk-58610","kind":"paragraph","spans":[{"id":"spn-87929","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieradnegb3ylqzxlb7pu65plajy2wt6dunwsjnvazd35rts4ppcjksia","vocabulary":"ampersand.docs.fs.v1"}