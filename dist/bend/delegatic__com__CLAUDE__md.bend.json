{"bendscript":"0.1","blocks":[{"id":"blk-63599","kind":"heading","level":1,"spans":[{"id":"spn-122240","text":"Delegatic — Governance for AI Agent Teams"}]},{"id":"blk-63600","kind":"paragraph","spans":[{"id":"spn-122241","text":"Governance and orchestration layer for multi-agent AI systems. Containment trees, monotonic policy inheritance, and immutable audit trails."}]},{"id":"blk-63601","kind":"heading","level":2,"spans":[{"id":"spn-122242","text":"Source-of-truth spec"}]},{"id":"blk-63602","items":[{"blocks":[{"id":"blk-63604","kind":"paragraph","spans":[{"id":"spn-122243","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-122244","text":" — Delegatic technical specification"}]}],"id":"blk-63603","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63605","kind":"heading","level":2,"spans":[{"id":"spn-122245","text":"Role in [&] Ecosystem"}]},{"id":"blk-63606","kind":"paragraph","spans":[{"id":"spn-122246","text":"Delegatic is the "},{"id":"spn-122247","marks":["bold"],"text":"governance layer"},{"id":"spn-122248","text":" — it defines who can do what, enforces policy boundaries, and provides audit trails. It does not execute tasks, host agents, or run workflows."}]},{"id":"blk-63607","kind":"heading","level":2,"spans":[{"id":"spn-122249","text":"Core concepts"}]},{"id":"blk-63608","items":[{"blocks":[{"id":"blk-63610","kind":"paragraph","spans":[{"id":"spn-122250","marks":["bold"],"text":"Containment trees"},{"id":"spn-122251","text":" — strict org hierarchy, no cycles, no DAGs"}]}],"id":"blk-63609","kind":"list-item"},{"blocks":[{"id":"blk-63612","kind":"paragraph","spans":[{"id":"spn-122252","marks":["bold"],"text":"Monotonic policy inheritance"},{"id":"spn-122253","text":" — children can tighten, never widen parent restrictions"}]}],"id":"blk-63611","kind":"list-item"},{"blocks":[{"id":"blk-63614","kind":"paragraph","spans":[{"id":"spn-122254","marks":["bold"],"text":"Deny by default"},{"id":"spn-122255","text":" — no implicit permissions"}]}],"id":"blk-63613","kind":"list-item"},{"blocks":[{"id":"blk-63616","kind":"paragraph","spans":[{"id":"spn-122256","marks":["bold"],"text":"Append-only audit"},{"id":"spn-122257","text":" — every mutation logged immutably"}]}],"id":"blk-63615","kind":"list-item"},{"blocks":[{"id":"blk-63618","kind":"paragraph","spans":[{"id":"spn-122258","marks":["bold"],"text":"Goal-aware governance"},{"id":"spn-122259","text":" — references Graphonomous GoalGraph for durable intent"}]}],"id":"blk-63617","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63619","kind":"heading","level":2,"spans":[{"id":"spn-122260","text":"Tech stack"}]},{"id":"blk-63620","kind":"paragraph","spans":[{"id":"spn-122261","text":"Elixir/OTP, Phoenix LiveView, PostgreSQL, ETS, Broadway, Oban"}]},{"id":"blk-63621","kind":"heading","level":2,"spans":[{"id":"spn-122262","text":"Status"}]},{"id":"blk-63622","kind":"paragraph","spans":[{"id":"spn-122263","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieray3fflqqjavhljemluujdow5ohg7r3lioe6mcqkcxqghzy4gd4mjq","vocabulary":"ampersand.docs.fs.v1"}