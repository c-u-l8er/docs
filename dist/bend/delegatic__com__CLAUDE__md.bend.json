{"bendscript":"0.1","blocks":[{"id":"blk-58576","kind":"heading","level":1,"spans":[{"id":"spn-87853","text":"Delegatic — Governance for AI Agent Teams"}]},{"id":"blk-58577","kind":"paragraph","spans":[{"id":"spn-87854","text":"Governance and orchestration layer for multi-agent AI systems. Containment trees, monotonic policy inheritance, and immutable audit trails."}]},{"id":"blk-58578","kind":"heading","level":2,"spans":[{"id":"spn-87855","text":"Source-of-truth spec"}]},{"id":"blk-58579","items":[{"blocks":[{"id":"blk-58581","kind":"paragraph","spans":[{"id":"spn-87856","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-87857","text":" — Delegatic technical specification"}]}],"id":"blk-58580","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58582","kind":"heading","level":2,"spans":[{"id":"spn-87858","text":"Role in [&] Ecosystem"}]},{"id":"blk-58583","kind":"paragraph","spans":[{"id":"spn-87859","text":"Delegatic is the "},{"id":"spn-87860","marks":["bold"],"text":"governance layer"},{"id":"spn-87861","text":" — it defines who can do what, enforces policy boundaries, and provides audit trails. It does not execute tasks, host agents, or run workflows."}]},{"id":"blk-58584","kind":"heading","level":2,"spans":[{"id":"spn-87862","text":"Core concepts"}]},{"id":"blk-58585","items":[{"blocks":[{"id":"blk-58587","kind":"paragraph","spans":[{"id":"spn-87863","marks":["bold"],"text":"Containment trees"},{"id":"spn-87864","text":" — strict org hierarchy, no cycles, no DAGs"}]}],"id":"blk-58586","kind":"list-item"},{"blocks":[{"id":"blk-58589","kind":"paragraph","spans":[{"id":"spn-87865","marks":["bold"],"text":"Monotonic policy inheritance"},{"id":"spn-87866","text":" — children can tighten, never widen parent restrictions"}]}],"id":"blk-58588","kind":"list-item"},{"blocks":[{"id":"blk-58591","kind":"paragraph","spans":[{"id":"spn-87867","marks":["bold"],"text":"Deny by default"},{"id":"spn-87868","text":" — no implicit permissions"}]}],"id":"blk-58590","kind":"list-item"},{"blocks":[{"id":"blk-58593","kind":"paragraph","spans":[{"id":"spn-87869","marks":["bold"],"text":"Append-only audit"},{"id":"spn-87870","text":" — every mutation logged immutably"}]}],"id":"blk-58592","kind":"list-item"},{"blocks":[{"id":"blk-58595","kind":"paragraph","spans":[{"id":"spn-87871","marks":["bold"],"text":"Goal-aware governance"},{"id":"spn-87872","text":" — references Graphonomous GoalGraph for durable intent"}]}],"id":"blk-58594","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58596","kind":"heading","level":2,"spans":[{"id":"spn-87873","text":"Tech stack"}]},{"id":"blk-58597","kind":"paragraph","spans":[{"id":"spn-87874","text":"Elixir/OTP, Phoenix LiveView, PostgreSQL, ETS, Broadway, Oban"}]},{"id":"blk-58598","kind":"heading","level":2,"spans":[{"id":"spn-87875","text":"Status"}]},{"id":"blk-58599","kind":"paragraph","spans":[{"id":"spn-87876","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieralmf4xh2gfr63gjavhcob6ztikai6jknkof4zlttjwxlt2fieojuq","vocabulary":"ampersand.docs.fs.v1"}