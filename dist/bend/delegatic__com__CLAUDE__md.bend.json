{"bendscript":"0.1","blocks":[{"id":"blk-58713","kind":"heading","level":1,"spans":[{"id":"spn-88054","text":"Delegatic — Governance for AI Agent Teams"}]},{"id":"blk-58714","kind":"paragraph","spans":[{"id":"spn-88055","text":"Governance and orchestration layer for multi-agent AI systems. Containment trees, monotonic policy inheritance, and immutable audit trails."}]},{"id":"blk-58715","kind":"heading","level":2,"spans":[{"id":"spn-88056","text":"Source-of-truth spec"}]},{"id":"blk-58716","items":[{"blocks":[{"id":"blk-58718","kind":"paragraph","spans":[{"id":"spn-88057","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-88058","text":" — Delegatic technical specification"}]}],"id":"blk-58717","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58719","kind":"heading","level":2,"spans":[{"id":"spn-88059","text":"Role in [&] Ecosystem"}]},{"id":"blk-58720","kind":"paragraph","spans":[{"id":"spn-88060","text":"Delegatic is the "},{"id":"spn-88061","marks":["bold"],"text":"governance layer"},{"id":"spn-88062","text":" — it defines who can do what, enforces policy boundaries, and provides audit trails. It does not execute tasks, host agents, or run workflows."}]},{"id":"blk-58721","kind":"heading","level":2,"spans":[{"id":"spn-88063","text":"Core concepts"}]},{"id":"blk-58722","items":[{"blocks":[{"id":"blk-58724","kind":"paragraph","spans":[{"id":"spn-88064","marks":["bold"],"text":"Containment trees"},{"id":"spn-88065","text":" — strict org hierarchy, no cycles, no DAGs"}]}],"id":"blk-58723","kind":"list-item"},{"blocks":[{"id":"blk-58726","kind":"paragraph","spans":[{"id":"spn-88066","marks":["bold"],"text":"Monotonic policy inheritance"},{"id":"spn-88067","text":" — children can tighten, never widen parent restrictions"}]}],"id":"blk-58725","kind":"list-item"},{"blocks":[{"id":"blk-58728","kind":"paragraph","spans":[{"id":"spn-88068","marks":["bold"],"text":"Deny by default"},{"id":"spn-88069","text":" — no implicit permissions"}]}],"id":"blk-58727","kind":"list-item"},{"blocks":[{"id":"blk-58730","kind":"paragraph","spans":[{"id":"spn-88070","marks":["bold"],"text":"Append-only audit"},{"id":"spn-88071","text":" — every mutation logged immutably"}]}],"id":"blk-58729","kind":"list-item"},{"blocks":[{"id":"blk-58732","kind":"paragraph","spans":[{"id":"spn-88072","marks":["bold"],"text":"Goal-aware governance"},{"id":"spn-88073","text":" — references Graphonomous GoalGraph for durable intent"}]}],"id":"blk-58731","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58733","kind":"heading","level":2,"spans":[{"id":"spn-88074","text":"Tech stack"}]},{"id":"blk-58734","kind":"paragraph","spans":[{"id":"spn-88075","text":"Elixir/OTP, Phoenix LiveView, PostgreSQL, ETS, Broadway, Oban"}]},{"id":"blk-58735","kind":"heading","level":2,"spans":[{"id":"spn-88076","text":"Status"}]},{"id":"blk-58736","kind":"paragraph","spans":[{"id":"spn-88077","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieraoiqqg5utqkogrftvrrddzkbu7r6x2iphjqgywcmkihyr2mtyuwbq","vocabulary":"ampersand.docs.fs.v1"}