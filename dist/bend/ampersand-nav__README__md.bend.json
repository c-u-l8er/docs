 ids"}]},{"id":"blk-54649","spans":[{"id":"spn-105134","marks":["code"],"text":"\"\""}]},{"id":"blk-54650","spans":[{"id":"spn-105135","text":"\"You are here\" highlight. Non-hero ids are accepted but never highlight."}]}],[{"id":"blk-54651","spans":[{"id":"spn-105136","marks":["code"],"text":"theme"}]},{"id":"blk-54652","spans":[{"id":"spn-105137","marks":["code"],"text":"dark"},{"id":"spn-105138","text":", "},{"id":"spn-105139","marks":["code"],"text":"light"},{"id":"spn-105140","text":", "},{"id":"spn-105141","marks":["code"],"text":"auto"}]},{"id":"blk-54653","spans":[{"id":"spn-105142","marks":["code"],"text":"dark"}]},{"id":"blk-54654","spans":[{"id":"spn-105143","text":"Switches the baseline color scheme."}]}]]},{"id":"blk-54655","kind":"heading","level":2,"spans":[{"id":"spn-105144","text":"Theming"}]},{"id":"blk-54656","kind":"paragraph","spans":[{"id":"spn-105145","text":"Override any CSS custom property on the host element:"}]},{"id":"blk-54657","kind":"code","language":"css","text":"amp-nav {\n  --amp-nav-accent: #4af5c6;\n  --amp-nav-bg: rgba(8, 9, 12, 0.78);\n  --amp-nav-fg: #e2e0db;\n  --amp-nav-font: \"JetBrains Mono\", monospace;\n  --amp-nav-height: 56px;\n}"},{"id":"blk-54658","kind":"paragraph","spans":[{"id":"spn-105146","text":"Full list: "},{"id":"spn-105147","marks":["code"],"text":"--amp-nav-bg"},{"id":"spn-105148","text":", "},{"id":"spn-105149","marks":["code"],"text":"--amp-nav-fg"},{"id":"spn-105150","text":", "},{"id":"spn-105151","marks":["code"],"text":"--amp-nav-muted"},{"id":"spn-105152","text":", "},{"id":"spn-105153","marks":["code"],"text":"--amp-nav-accent"},{"id":"spn-105154","text":", "},{"id":"spn-105155","marks":["code"],"text":"--amp-nav-border"},{"id":"spn-105156","text":", "},{"id":"spn-105157","marks":["code"],"text":"--amp-nav-hover"},{"id":"spn-105158","text":", "},{"id":"spn-105159","marks":["code"],"text":"--amp-nav-cta-bg"},{"id":"spn-105160","text":", "},{"id":"spn-105161","marks":["code"],"text":"--amp-nav-cta-fg"