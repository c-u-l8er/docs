{"bendscript":"0.1","blocks":[{"id":"blk-54588","kind":"heading","level":1,"spans":[{"id":"spn-104975","marks":["code"],"text":"<amp-nav>"},{"id":"spn-104976","text":" — Shared portfolio navigation"}]},{"id":"blk-54589","kind":"paragraph","spans":[{"id":"spn-104977","text":"A single Web Component that renders the Ampersand Box Design portfolio top nav on every property — graphonomous.com, runefort.com, opensentience.org, and the rest of the [&] ecosystem."}]},{"id":"blk-54590","kind":"heading","level":2,"spans":[{"id":"spn-104978","text":"Why a Web Component"}]},{"id":"blk-54591","kind":"paragraph","spans":[{"id":"spn-104979","text":"One nav, multiple stacks:"}]},{"id":"blk-54592","items":[{"blocks":[{"id":"blk-54594","kind":"paragraph","spans":[{"id":"spn-104980","text":"Static HTML ("},{"id":"spn-104981","marks":["code"],"text":"graphonomous.com"},{"id":"spn-104982","text":", "},{"id":"spn-104983","marks":["code"],"text":"deliberatic.com"},{"id":"spn-104984","text":", ...)"}]}],"id":"blk-54593","kind":"list-item"},{"blocks":[{"id":"blk-54596","kind":"paragraph","spans":[{"id":"spn-104985","text":"Elixir/Phoenix ("},{"id":"spn-104986","marks":["code"],"text":"agentelic.com"},{"id":"spn-104987","text":", "},{"id":"spn-104988","marks":["code"],"text":"specprompt.com"},{"id":"spn-104989","text":", ...)"}]}],"id":"blk-54595","kind":"list-item"},{"blocks":[{"id":"blk-54598","kind":"paragraph","spans":[{"id":"spn-104990","text":"SvelteKit ("},{"id":"spn-104991","marks":["code"],"text":"bendscript.com"},{"id":"spn-104992","text":", "},{"id":"spn-104993","marks":["code"],"text":"runefort.com"},{"id":"spn-104994","text":")"}]}],"id":"blk-54597","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-54599","kind":"paragraph","spans":[{"id":"spn-104995","text":"A custom element works identically in all three. Shadow DOM isolates styling so host-site CSS can't break it and the nav can't leak styles into the host. No build step, no framework dependency, no iframe pathology."}]},{"id":"blk-54600","kind":"heading","level":2,"spans":[{"id":"spn-104996","text":"Source of truth"}]},{"id":"blk-54601","kind":"code","language":"text","text":"ampersand-nav/\n├── src/amp-nav.js        ← edit this\n├── dist/amp-nav.js       ← built artifact (copied to each site)\n├── sync-nav.sh           ← deployment script\n└── README.md"},{"id":"blk-54602","kind":"paragraph","spans":[{"id":"spn-104997","text":"To change the nav — add a category, swap the CTA, update a link — edit "},{"id":"spn-104998","marks":["code"],"text":"src/amp-nav.js"},{"id":"spn-104999","text":" and run "},{"id":"spn-105000","marks":["code"],"text":"./sync-nav.sh"},{"id":"spn-105001","text":". Every property picks it up."}]},{"id":"blk-54603","kind":"heading","level":2,"spans":[{"id":"spn-105002","text":"Nav structure"}]},{"id":"blk-54604","kind":"paragraph","spans":[{"id":"spn-105003","text":"Top-level categories:"}]},{"head":[{"id":"blk-54606","spans":[{"id":"spn-105004","text":"Category"}]},{"id":"blk-54607","spans":[{"id":"spn-105005","text":"Items"}]}],"id":"blk-54605","kind":"table","rows":[[{"id":"blk-54608","spans":[{"id":"spn-105006","marks":["bold"],"text":"Products"}]},{"id":"blk-54609","spans":[{"id":"spn-105007","text":"Code, Graphonomous, BendScript, RuneFort"}]}],[{"id":"blk-54610","spans":[{"id":"spn-105008","marks":["bold"],"text":"Protocols"}]},{"id":"blk-54611","spans":[{"id":"spn-105009","text":"[&] Protocol, PULSE, PRISM, SCOPE, TRVM"}]}],[{"id":"blk-54612","spans":[{"id":"spn-105010","marks":["bold"],"text":"Research"}]},{"id":"blk-54613","spans":[{"id":"spn-105011","text":"mega-menu — Protocols & Census / Proven Invariants (κ, π, ⊘, ⊆, ⊥, ⊕) / The Arithmetic Ladder / The Execution Substrate / The Eight Rungs"}]}],[{"id":"blk-54614","spans":[{"id":"spn-105012","marks":["bold"],"text":"Academy"}]},{"id":"blk-54615","spans":[{"id":"spn-105013","text":"Workbench, Supervisor"}]}],[{"id":"blk-54616","spans":[{"id":"spn-105014","marks":["bold"],"text":"Docs"}]},{"id":"blk-54617","spans":[{"id":"spn-105015","text":"mega-menu — Start here / The protocol stack / Engines & capabilities / Execution substrate"}]}],[{"id":"blk-54618","spans":[{"id":"spn-105016","marks":["bold"],"text":"Company"}]},{"id":"blk-54619","spans":[{"id":"spn-105017","text":"c-u-l8er.link, Ampersand Box Design, TRAAVIIS, Talk to us"}]}],[{"id":"blk-54620","spans":[{"id":"spn-105018","marks":["bold"],"text":"Compose"}]},{"id":"blk-54621","spans":[{"id":"spn-105019","text":"mega-menu — full ecosystem catalog across Cognitive Primitives / Agent Platform / Runtime"}]}]]},{"id":"blk-54622","kind":"paragraph","spans":[{"id":"spn-105020","marks":["bold"],"text":"Academy"},{"id":"spn-105021","text":" houses the institutional loop — the systems that "},{"id":"spn-105022","marks":["italic"],"text":"teach and prove"},{"id":"spn-105023","text":" cognition rather than perform it. Workbench (the skill workshop + 6-gate proof harness, deploying to "},{"id":"spn-105024","marks":["code"],"text":"workbench.opensentience.org"},{"id":"spn-105025","text":") is the live entry; Supervisor (the teacher loop that turns an invariant into a curriculum) is spec-stage. This is the nav home for the \"proof, not vibes\" / dark-factory story."}]},{"id":"blk-54623","kind":"paragraph","spans":[{"id":"spn-105026","marks":["bold"],"text":"Research"},{"id":"spn-105027","text":" is a five-column mega-menu. "},{"id":"spn-105028","marks":["italic"],"text":"Protocols & Census"},{"id":"spn-105029","text":" links OpenSentience and the "},{"id":"spn-105030","marks":["bold"],"text":"Periodic Table of Agent Invariants"},{"id":"spn-105031","text":" ("},{"id":"spn-105032","marks":["code"],"text":"opensentience.org/invariants.html"},{"id":"spn-105033","text":") — the full 43-invariant census. "},{"id":"spn-105034","marks":["italic"],"text":"Proven Invariants"},{"id":"spn-105035","text":" links the six invariants with real machine-checked / property-tested proof pages ("},{"id":"spn-105036","marks":["code"],"text":"opensentience.org/proofs/*.html"},{"id":"spn-105037","text":"): κ Cyclicity, π Phase Ordering, and the four Delegatic governance invariants ⊘ No-cycles, ⊆ Monotonic, ⊥ Deny-default, ⊕ Append-only. Only invariants with an actual proof are surfaced as proof pages; the periodic table shows the honest status of the rest. "},{"id":"spn-105038","marks":["italic"],"text":"The Arithmetic Ladder"},{"id":"spn-105039","text":" is the box-and-box kernel entry point (package, conformance, playground), and "},{"id":"spn-105040","marks":["italic"],"text":"The Eight Rungs"},{"id":"spn-105041","text":" lists the rungs as individual living-paper pages."}]},{"id":"blk-54624","kind":"paragraph","spans":[{"id":"spn-105042","marks":["bold"],"text":"The Execution Substrate"},{"id":"spn-105043","text":" — the fourth Research column — lists WallRiderLang, TRVM, WRLM and TRAAVIIS in the order a world moves through them: WRLM proposes → WRL seals → TRVM reduces → TRAAVIIS admits. WRLM is the only statistical layer; the other three are total and deterministic. TRVM also appears under Protocols (it is the runtime spec, not only a research artifact) and TRAAVIIS also appears under Company; both highlight against their primary home, the same way Graphonomous resolves to Products despite also appearing under Compose."}]},{"id":"blk-54625","kind":"paragraph","spans":[{"id":"spn-105044","text":"Because the mega-menus now carry different column counts (Research five, Docs four, Compose three), each dropdown is sized from its own "},{"id":"spn-105045","marks":["code"],"text":"--cols"},{"id":"spn-105046","text":" value, set inline at render, and centered on the bar rather than on its trigger — a wide menu centered on an edge-adjacent trigger falls off-screen."}]},{"id":"blk-54626","kind":"paragraph","spans":[{"id":"spn-105047","marks":["bold"],"text":"Invariant Arithmetic"},{"id":"spn-105048","text":", which leads "},{"id":"spn-105049","marks":["italic"],"text":"The Eight Rungs"},{"id":"spn-105050","text":", is the algebra under the proofs ("},{"id":"spn-105051","marks":["code"],"text":"opensentience.org/invariant-arithmetic.html"},{"id":"spn-105052","text":") — the 15 fast-check laws (L1–L15) that back the proof pages' gate verdicts."}]},{"id":"blk-54627","kind":"paragraph","spans":[{"id":"spn-105053","text":"Right-aligned CTA: "},{"id":"spn-105054","marks":["bold"],"text":"\"Talk to us →\""},{"id":"spn-105055","text":" (design-partner inquiries)."}]},{"blocks":[{"id":"blk-54629","kind":"paragraph","spans":[{"id":"spn-105056","marks":["bold"],"text":"Q4 2026 swap:"},{"id":"spn-105057","text":" when the Dark Factory demo ships, change "},{"id":"spn-105058","marks":["code"],"text":"CTA"},{"id":"spn-105059","text":" in "},{"id":"spn-105060","marks":["code"],"text":"src/amp-nav.js"},{"id":"spn-105061","text":" to "},{"id":"spn-105062","marks":["code"],"text":"{ label: \"Run the factory →\", href: \"https://runefort.com/factory\" }"},{"id":"spn-105063","text":". Single line, then "},{"id":"spn-105064","marks":["code"],"text":"./sync-nav.sh"},{"id":"spn-105065","text":"."}]}],"id":"blk-54628","kind":"quote"},{"id":"blk-54630","kind":"heading","level":2,"spans":[{"id":"spn-105066","text":"Taxonomy discipline"}]},{"id":"blk-54631","kind":"paragraph","spans":[{"id":"spn-105067","text":"The nav deliberately shows only the five hero products from the Dark Factory strategy doc. The other portfolio properties (Agentelic, FleetPrompt, BendScript, Delegatic, Deliberatic, GeoFleetic, TickTickClock, SpecPrompt, AgenTroMatic) "},{"id":"spn-105068","marks":["bold"],"text":"do not appear"},{"id":"spn-105069","text":" as top-level items. They stay reachable via deep links from spec pages and through the \"Docs\" surface, but the public nav never surfaces them. This enforces the \"do not pitch 15 products\" constraint."}]},{"id":"blk-54632","kind":"heading","level":2,"spans":[{"id":"spn-105070","text":"Integration"}]},{"id":"blk-54633","kind":"heading","level":3,"spans":[{"id":"spn-105071","text":"Static HTML site"}]},{"id":"blk-54634","kind":"code","language":"html","text":"<head>\n  ...\n  <script type=\"module\" src=\"/amp-nav.js\"></script>\n</head>\n<body>\n  <amp-nav property=\"graphonomous\"></amp-nav>\n  ...\n</body>"},{"id":"blk-54635","kind":"heading","level":3,"spans":[{"id":"spn-105072","text":"SvelteKit site"}]},{"id":"blk-54636","kind":"code","language":"html","text":"<!-- src/app.html -->\n<head>\n  %sveltekit.head%\n  <script type=\"module\" src=\"/amp-nav.js\"></script>\n</head>"},{"id":"blk-54637","kind":"code","language":"svelte","text":"<!-- src/routes/+layout.svelte -->\n<amp-nav property=\"runefort\"></amp-nav>\n<slot />   <!-- or {@render children()} in Svelte 5 -->"},{"id":"blk-54638","kind":"paragraph","spans":[{"id":"spn-105073","text":"The file lives in "},{"id":"spn-105074","marks":["code"],"text":"static/amp-nav.js"},{"id":"spn-105075","text":"."}]},{"id":"blk-54639","kind":"heading","level":3,"spans":[{"id":"spn-105076","text":"Elixir / Phoenix"}]},{"id":"blk-54640","kind":"paragraph","spans":[{"id":"spn-105077","text":"Same as static HTML. The file is copied to both "},{"id":"spn-105078","marks":["code"],"text":"<site>/amp-nav.js"},{"id":"spn-105079","text":" and "},{"id":"spn-105080","marks":["code"],"text":"<site>/priv/static/amp-nav.js"},{"id":"spn-105081","text":" so it's served regardless of whether "},{"id":"spn-105082","marks":["code"],"text":"index.html"},{"id":"spn-105083","text":" is a static file or rendered through Phoenix."}]},{"id":"blk-54641","kind":"heading","level":2,"spans":[{"id":"spn-105084","text":"Attributes"}]},{"head":[{"id":"blk-54643","spans":[{"id":"spn-105085","text":"Attribute"}]},{"id":"blk-54644","spans":[{"id":"spn-105086","text":"Values"}]},{"id":"blk-54645","spans":[{"id":"spn-105087","text":"Default"}]},{"id":"blk-54646","spans":[{"id":"spn-105088","text":"Purpose"}]}],"id":"blk-54642","kind":"table","rows":[[{"id":"blk-54647","spans":[{"id":"spn-105089","marks":["code"