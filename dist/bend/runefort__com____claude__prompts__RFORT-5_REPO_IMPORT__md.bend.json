{"bendscript":"0.1","blocks":[{"id":"blk-83138","kind":"heading","level":1,"spans":[{"id":"spn-115266","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-83139","kind":"heading","level":2,"spans":[{"id":"spn-115267","text":"Goal"}]},{"id":"blk-83140","kind":"paragraph","spans":[{"id":"spn-115268","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-83141","kind":"heading","level":2,"spans":[{"id":"spn-115269","text":"Prerequisites"}]},{"id":"blk-83142","items":[{"blocks":[{"id":"blk-83144","kind":"paragraph","spans":[{"id":"spn-115270","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-83143","kind":"list-item"},{"blocks":[{"id":"blk-83146","kind":"paragraph","spans":[{"id":"spn-115271","text":"Core fort generator ("},{"id":"spn-115272","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-115273","text":") already exists with "},{"id":"spn-115274","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-83145","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83147","kind":"heading","level":2,"spans":[{"id":"spn-115275","text":"Files to Create"}]},{"id":"blk-83148","kind":"heading","level":3,"spans":[{"id":"spn-115276","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-83149","kind":"paragraph","spans":[{"id":"spn-115277","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-83150","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-83151","kind":"paragraph","spans":[{"id":"spn-115278","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-83153","spans":[{"id":"spn-115279","text":"Git concept"}]},{"id":"blk-83154","spans":[{"id":"spn-115280","text":"Fort concept"}]},{"id":"blk-83155","spans":[{"id":"spn-115281","text":"Level"}]}],"id":"blk-83152","kind":"table","rows":[[{"id":"blk-83156","spans":[{"id":"spn-115282","text":"Repository"}]},{"id":"blk-83157","spans":[{"id":"spn-115283","text":"Fort (L1 Campus)"}]},{"id":"blk-83158","spans":[{"id":"spn-115284","text":"L1"}]}],[{"id":"blk-83159","spans":[{"id":"spn-115285","text":"Top-level directory"}]},{"id":"blk-83160","spans":[{"id":"spn-115286","text":"Room"}]},{"id":"blk-83161","spans":[{"id":"spn-115287","text":"L2"}]}],[{"id":"blk-83162","spans":[{"id":"spn-115288","text":"Subdirectory"}]},{"id":"blk-83163","spans":[{"id":"spn-115289","text":"Nested room cluster"}]},{"id":"blk-83164","spans":[{"id":"spn-115290","text":"L2"}]}],[{"id":"blk-83165","spans":[{"id":"spn-115291","text":"Source file"}]},{"id":"blk-83166","spans":[{"id":"spn-115292","text":"Tile"}]},{"id":"blk-83167","spans":[{"id":"spn-115293","text":"L3"}]}],[{"id":"blk-83168","spans":[{"id":"spn-115294","marks":["code"],"text":"package.json"},{"id":"spn-115295","text":" / "},{"id":"spn-115296","marks":["code"],"text":"mix.exs"},{"id":"spn-115297","text":" / "},{"id":"spn-115298","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-83169","spans":[{"id":"spn-115299","text":"Gate node (entry point)"}]},{"id":"blk-83170","spans":[{"id":"spn-115300","text":"L2"}]}],[{"id":"blk-83171","spans":[{"id":"spn-115301","text":"Import/require between dirs"}]},{"id":"blk-83172","spans":[{"id":"spn-115302","text":"Hall (corridor edge)"}]},{"id":"blk-83173","spans":[{"id":"spn-115303","text":"L2"}]}],[{"id":"blk-83174","spans":[{"id":"spn-115304","text":"External dependency"}]},{"id":"blk-83175","spans":[{"id":"spn-115305","text":"Bridge edge (outgoing)"}]},{"id":"blk-83176","spans":[{"id":"spn-115306","text":"L1"}]}],[{"id":"blk-83177","spans":[{"id":"spn-115307","text":"README / docs"}]},{"id":"blk-83178","spans":[{"id":"spn-115308","text":"Tower (observation)"}]},{"id":"blk-83179","spans":[{"id":"spn-115309","text":"L2"}]}],[{"id":"blk-83180","spans":[{"id":"spn-115310","text":"Config files"}]},{"id":"blk-83181","spans":[{"id":"spn-115311","text":"Wall (policy)"}]},{"id":"blk-83182","spans":[{"id":"spn-115312","text":"L2"}]}]]},{"id":"blk-83183","kind":"heading","level":3,"spans":[{"id":"spn-115313","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-83184","kind":"paragraph","spans":[{"id":"spn-115314","text":"Modal with:"}]},{"id":"blk-83185","items":[{"blocks":[{"id":"blk-83187","kind":"paragraph","spans":[{"id":"spn-115315","text":"GitHub URL input field"}]}],"id":"blk-83186","kind":"list-item"},{"blocks":[{"id":"blk-83189","kind":"paragraph","spans":[{"id":"spn-115316","text":"Branch selector (default: main)"}]}],"id":"blk-83188","kind":"list-item"},{"blocks":[{"id":"blk-83191","kind":"paragraph","spans":[{"id":"spn-115317","text":"\"Import\" button"}]}],"id":"blk-83190","kind":"list-item"},{"blocks":[{"id":"blk-83193","kind":"paragraph","spans":[{"id":"spn-115318","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-83192","kind":"list-item"},{"blocks":[{"id":"blk-83195","kind":"paragraph","spans":[{"id":"spn-115319","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-83194","kind":"list-item"},{"blocks":[{"id":"blk-83197","kind":"paragraph","spans":[{"id":"spn-115320","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-83196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83198","kind":"paragraph","spans":[{"id":"spn-115321","text":"On import success: call "},{"id":"spn-115322","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-83199","kind":"heading","level":3,"spans":[{"id":"spn-115323","text":"Fort store addition"}]},{"id":"blk-83200","kind":"paragraph","spans":[{"id":"spn-115324","text":"Add to "},{"id":"spn-115325","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-115326","text":":"}]},{"id":"blk-83201","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-83202","kind":"heading","level":2,"spans":[{"id":"spn-115327","text":"Integration Point"}]},{"id":"blk-83203","kind":"paragraph","spans":[{"id":"spn-115328","text":"Add a \"Import Repo\" button to the "},{"id":"spn-115329","marks":["code"],"text":"/app"},{"id":"spn-115330","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-83204","kind":"heading","level":2,"spans":[{"id":"spn-115331","text":"Constraints"}]},{"id":"blk-83205","items":[{"blocks":[{"id":"blk-83207","kind":"paragraph","spans":[{"id":"spn-115332","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-83206","kind":"list-item"},{"blocks":[{"id":"blk-83209","kind":"paragraph","spans":[{"id":"spn-115333","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-83208","kind":"list-item"},{"blocks":[{"id":"blk-83211","kind":"paragraph","spans":[{"id":"spn-115334","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-83210","kind":"list-item"},{"blocks":[{"id":"blk-83213","kind":"paragraph","spans":[{"id":"spn-115335","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-83212","kind":"list-item"},{"blocks":[{"id":"blk-83215","kind":"paragraph","spans":[{"id":"spn-115336","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-83214","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera6o3kytlwbyys24rcat6ht2doic5dxllyafemu35s5pthzfe22ehq","vocabulary":"ampersand.docs.fs.v1"}