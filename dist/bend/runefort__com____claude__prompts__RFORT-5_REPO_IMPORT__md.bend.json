{"bendscript":"0.1","blocks":[{"id":"blk-83001","kind":"heading","level":1,"spans":[{"id":"spn-115065","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-83002","kind":"heading","level":2,"spans":[{"id":"spn-115066","text":"Goal"}]},{"id":"blk-83003","kind":"paragraph","spans":[{"id":"spn-115067","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-83004","kind":"heading","level":2,"spans":[{"id":"spn-115068","text":"Prerequisites"}]},{"id":"blk-83005","items":[{"blocks":[{"id":"blk-83007","kind":"paragraph","spans":[{"id":"spn-115069","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-83006","kind":"list-item"},{"blocks":[{"id":"blk-83009","kind":"paragraph","spans":[{"id":"spn-115070","text":"Core fort generator ("},{"id":"spn-115071","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-115072","text":") already exists with "},{"id":"spn-115073","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-83008","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83010","kind":"heading","level":2,"spans":[{"id":"spn-115074","text":"Files to Create"}]},{"id":"blk-83011","kind":"heading","level":3,"spans":[{"id":"spn-115075","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-83012","kind":"paragraph","spans":[{"id":"spn-115076","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-83013","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-83014","kind":"paragraph","spans":[{"id":"spn-115077","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-83016","spans":[{"id":"spn-115078","text":"Git concept"}]},{"id":"blk-83017","spans":[{"id":"spn-115079","text":"Fort concept"}]},{"id":"blk-83018","spans":[{"id":"spn-115080","text":"Level"}]}],"id":"blk-83015","kind":"table","rows":[[{"id":"blk-83019","spans":[{"id":"spn-115081","text":"Repository"}]},{"id":"blk-83020","spans":[{"id":"spn-115082","text":"Fort (L1 Campus)"}]},{"id":"blk-83021","spans":[{"id":"spn-115083","text":"L1"}]}],[{"id":"blk-83022","spans":[{"id":"spn-115084","text":"Top-level directory"}]},{"id":"blk-83023","spans":[{"id":"spn-115085","text":"Room"}]},{"id":"blk-83024","spans":[{"id":"spn-115086","text":"L2"}]}],[{"id":"blk-83025","spans":[{"id":"spn-115087","text":"Subdirectory"}]},{"id":"blk-83026","spans":[{"id":"spn-115088","text":"Nested room cluster"}]},{"id":"blk-83027","spans":[{"id":"spn-115089","text":"L2"}]}],[{"id":"blk-83028","spans":[{"id":"spn-115090","text":"Source file"}]},{"id":"blk-83029","spans":[{"id":"spn-115091","text":"Tile"}]},{"id":"blk-83030","spans":[{"id":"spn-115092","text":"L3"}]}],[{"id":"blk-83031","spans":[{"id":"spn-115093","marks":["code"],"text":"package.json"},{"id":"spn-115094","text":" / "},{"id":"spn-115095","marks":["code"],"text":"mix.exs"},{"id":"spn-115096","text":" / "},{"id":"spn-115097","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-83032","spans":[{"id":"spn-115098","text":"Gate node (entry point)"}]},{"id":"blk-83033","spans":[{"id":"spn-115099","text":"L2"}]}],[{"id":"blk-83034","spans":[{"id":"spn-115100","text":"Import/require between dirs"}]},{"id":"blk-83035","spans":[{"id":"spn-115101","text":"Hall (corridor edge)"}]},{"id":"blk-83036","spans":[{"id":"spn-115102","text":"L2"}]}],[{"id":"blk-83037","spans":[{"id":"spn-115103","text":"External dependency"}]},{"id":"blk-83038","spans":[{"id":"spn-115104","text":"Bridge edge (outgoing)"}]},{"id":"blk-83039","spans":[{"id":"spn-115105","text":"L1"}]}],[{"id":"blk-83040","spans":[{"id":"spn-115106","text":"README / docs"}]},{"id":"blk-83041","spans":[{"id":"spn-115107","text":"Tower (observation)"}]},{"id":"blk-83042","spans":[{"id":"spn-115108","text":"L2"}]}],[{"id":"blk-83043","spans":[{"id":"spn-115109","text":"Config files"}]},{"id":"blk-83044","spans":[{"id":"spn-115110","text":"Wall (policy)"}]},{"id":"blk-83045","spans":[{"id":"spn-115111","text":"L2"}]}]]},{"id":"blk-83046","kind":"heading","level":3,"spans":[{"id":"spn-115112","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-83047","kind":"paragraph","spans":[{"id":"spn-115113","text":"Modal with:"}]},{"id":"blk-83048","items":[{"blocks":[{"id":"blk-83050","kind":"paragraph","spans":[{"id":"spn-115114","text":"GitHub URL input field"}]}],"id":"blk-83049","kind":"list-item"},{"blocks":[{"id":"blk-83052","kind":"paragraph","spans":[{"id":"spn-115115","text":"Branch selector (default: main)"}]}],"id":"blk-83051","kind":"list-item"},{"blocks":[{"id":"blk-83054","kind":"paragraph","spans":[{"id":"spn-115116","text":"\"Import\" button"}]}],"id":"blk-83053","kind":"list-item"},{"blocks":[{"id":"blk-83056","kind":"paragraph","spans":[{"id":"spn-115117","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-83055","kind":"list-item"},{"blocks":[{"id":"blk-83058","kind":"paragraph","spans":[{"id":"spn-115118","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-83057","kind":"list-item"},{"blocks":[{"id":"blk-83060","kind":"paragraph","spans":[{"id":"spn-115119","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-83059","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83061","kind":"paragraph","spans":[{"id":"spn-115120","text":"On import success: call "},{"id":"spn-115121","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-83062","kind":"heading","level":3,"spans":[{"id":"spn-115122","text":"Fort store addition"}]},{"id":"blk-83063","kind":"paragraph","spans":[{"id":"spn-115123","text":"Add to "},{"id":"spn-115124","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-115125","text":":"}]},{"id":"blk-83064","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-83065","kind":"heading","level":2,"spans":[{"id":"spn-115126","text":"Integration Point"}]},{"id":"blk-83066","kind":"paragraph","spans":[{"id":"spn-115127","text":"Add a \"Import Repo\" button to the "},{"id":"spn-115128","marks":["code"],"text":"/app"},{"id":"spn-115129","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-83067","kind":"heading","level":2,"spans":[{"id":"spn-115130","text":"Constraints"}]},{"id":"blk-83068","items":[{"blocks":[{"id":"blk-83070","kind":"paragraph","spans":[{"id":"spn-115131","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-83069","kind":"list-item"},{"blocks":[{"id":"blk-83072","kind":"paragraph","spans":[{"id":"spn-115132","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-83071","kind":"list-item"},{"blocks":[{"id":"blk-83074","kind":"paragraph","spans":[{"id":"spn-115133","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-83073","kind":"list-item"},{"blocks":[{"id":"blk-83076","kind":"paragraph","spans":[{"id":"spn-115134","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-83075","kind":"list-item"},{"blocks":[{"id":"blk-83078","kind":"paragraph","spans":[{"id":"spn-115135","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-83077","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierasxzvsp7nytea4kvt4eoxrwqbhq4xmfga2evj3736dpmj2u2j2paa","vocabulary":"ampersand.docs.fs.v1"}