{"bendscript":"0.1","blocks":[{"id":"blk-56431","kind":"heading","level":1,"spans":[{"id":"spn-64824","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-56432","kind":"heading","level":2,"spans":[{"id":"spn-64825","text":"Goal"}]},{"id":"blk-56433","kind":"paragraph","spans":[{"id":"spn-64826","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-56434","kind":"heading","level":2,"spans":[{"id":"spn-64827","text":"Prerequisites"}]},{"id":"blk-56435","items":[{"blocks":[{"id":"blk-56437","kind":"paragraph","spans":[{"id":"spn-64828","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-56436","kind":"list-item"},{"blocks":[{"id":"blk-56439","kind":"paragraph","spans":[{"id":"spn-64829","text":"Core fort generator ("},{"id":"spn-64830","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-64831","text":") already exists with "},{"id":"spn-64832","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-56438","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56440","kind":"heading","level":2,"spans":[{"id":"spn-64833","text":"Files to Create"}]},{"id":"blk-56441","kind":"heading","level":3,"spans":[{"id":"spn-64834","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-56442","kind":"paragraph","spans":[{"id":"spn-64835","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-56443","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-56444","kind":"paragraph","spans":[{"id":"spn-64836","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-56446","spans":[{"id":"spn-64837","text":"Git concept"}]},{"id":"blk-56447","spans":[{"id":"spn-64838","text":"Fort concept"}]},{"id":"blk-56448","spans":[{"id":"spn-64839","text":"Level"}]}],"id":"blk-56445","kind":"table","rows":[[{"id":"blk-56449","spans":[{"id":"spn-64840","text":"Repository"}]},{"id":"blk-56450","spans":[{"id":"spn-64841","text":"Fort (L1 Campus)"}]},{"id":"blk-56451","spans":[{"id":"spn-64842","text":"L1"}]}],[{"id":"blk-56452","spans":[{"id":"spn-64843","text":"Top-level directory"}]},{"id":"blk-56453","spans":[{"id":"spn-64844","text":"Room"}]},{"id":"blk-56454","spans":[{"id":"spn-64845","text":"L2"}]}],[{"id":"blk-56455","spans":[{"id":"spn-64846","text":"Subdirectory"}]},{"id":"blk-56456","spans":[{"id":"spn-64847","text":"Nested room cluster"}]},{"id":"blk-56457","spans":[{"id":"spn-64848","text":"L2"}]}],[{"id":"blk-56458","spans":[{"id":"spn-64849","text":"Source file"}]},{"id":"blk-56459","spans":[{"id":"spn-64850","text":"Tile"}]},{"id":"blk-56460","spans":[{"id":"spn-64851","text":"L3"}]}],[{"id":"blk-56461","spans":[{"id":"spn-64852","marks":["code"],"text":"package.json"},{"id":"spn-64853","text":" / "},{"id":"spn-64854","marks":["code"],"text":"mix.exs"},{"id":"spn-64855","text":" / "},{"id":"spn-64856","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-56462","spans":[{"id":"spn-64857","text":"Gate node (entry point)"}]},{"id":"blk-56463","spans":[{"id":"spn-64858","text":"L2"}]}],[{"id":"blk-56464","spans":[{"id":"spn-64859","text":"Import/require between dirs"}]},{"id":"blk-56465","spans":[{"id":"spn-64860","text":"Hall (corridor edge)"}]},{"id":"blk-56466","spans":[{"id":"spn-64861","text":"L2"}]}],[{"id":"blk-56467","spans":[{"id":"spn-64862","text":"External dependency"}]},{"id":"blk-56468","spans":[{"id":"spn-64863","text":"Bridge edge (outgoing)"}]},{"id":"blk-56469","spans":[{"id":"spn-64864","text":"L1"}]}],[{"id":"blk-56470","spans":[{"id":"spn-64865","text":"README / docs"}]},{"id":"blk-56471","spans":[{"id":"spn-64866","text":"Tower (observation)"}]},{"id":"blk-56472","spans":[{"id":"spn-64867","text":"L2"}]}],[{"id":"blk-56473","spans":[{"id":"spn-64868","text":"Config files"}]},{"id":"blk-56474","spans":[{"id":"spn-64869","text":"Wall (policy)"}]},{"id":"blk-56475","spans":[{"id":"spn-64870","text":"L2"}]}]]},{"id":"blk-56476","kind":"heading","level":3,"spans":[{"id":"spn-64871","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-56477","kind":"paragraph","spans":[{"id":"spn-64872","text":"Modal with:"}]},{"id":"blk-56478","items":[{"blocks":[{"id":"blk-56480","kind":"paragraph","spans":[{"id":"spn-64873","text":"GitHub URL input field"}]}],"id":"blk-56479","kind":"list-item"},{"blocks":[{"id":"blk-56482","kind":"paragraph","spans":[{"id":"spn-64874","text":"Branch selector (default: main)"}]}],"id":"blk-56481","kind":"list-item"},{"blocks":[{"id":"blk-56484","kind":"paragraph","spans":[{"id":"spn-64875","text":"\"Import\" button"}]}],"id":"blk-56483","kind":"list-item"},{"blocks":[{"id":"blk-56486","kind":"paragraph","spans":[{"id":"spn-64876","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-56485","kind":"list-item"},{"blocks":[{"id":"blk-56488","kind":"paragraph","spans":[{"id":"spn-64877","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-56487","kind":"list-item"},{"blocks":[{"id":"blk-56490","kind":"paragraph","spans":[{"id":"spn-64878","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-56489","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56491","kind":"paragraph","spans":[{"id":"spn-64879","text":"On import success: call "},{"id":"spn-64880","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-56492","kind":"heading","level":3,"spans":[{"id":"spn-64881","text":"Fort store addition"}]},{"id":"blk-56493","kind":"paragraph","spans":[{"id":"spn-64882","text":"Add to "},{"id":"spn-64883","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-64884","text":":"}]},{"id":"blk-56494","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-56495","kind":"heading","level":2,"spans":[{"id":"spn-64885","text":"Integration Point"}]},{"id":"blk-56496","kind":"paragraph","spans":[{"id":"spn-64886","text":"Add a \"Import Repo\" button to the "},{"id":"spn-64887","marks":["code"],"text":"/app"},{"id":"spn-64888","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-56497","kind":"heading","level":2,"spans":[{"id":"spn-64889","text":"Constraints"}]},{"id":"blk-56498","items":[{"blocks":[{"id":"blk-56500","kind":"paragraph","spans":[{"id":"spn-64890","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-56499","kind":"list-item"},{"blocks":[{"id":"blk-56502","kind":"paragraph","spans":[{"id":"spn-64891","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-56501","kind":"list-item"},{"blocks":[{"id":"blk-56504","kind":"paragraph","spans":[{"id":"spn-64892","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-56503","kind":"list-item"},{"blocks":[{"id":"blk-56506","kind":"paragraph","spans":[{"id":"spn-64893","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-56505","kind":"list-item"},{"blocks":[{"id":"blk-56508","kind":"paragraph","spans":[{"id":"spn-64894","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-56507","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7zhxmxetjygp2rf7edqgsgdqjbxfe2dsz356ydutlt7ce2o3mppq","vocabulary":"ampersand.docs.fs.v1"}