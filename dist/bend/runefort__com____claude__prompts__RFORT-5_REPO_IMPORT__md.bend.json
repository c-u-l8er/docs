{"bendscript":"0.1","blocks":[{"id":"blk-56917","kind":"heading","level":1,"spans":[{"id":"spn-65998","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-56918","kind":"heading","level":2,"spans":[{"id":"spn-65999","text":"Goal"}]},{"id":"blk-56919","kind":"paragraph","spans":[{"id":"spn-66000","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-56920","kind":"heading","level":2,"spans":[{"id":"spn-66001","text":"Prerequisites"}]},{"id":"blk-56921","items":[{"blocks":[{"id":"blk-56923","kind":"paragraph","spans":[{"id":"spn-66002","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-56922","kind":"list-item"},{"blocks":[{"id":"blk-56925","kind":"paragraph","spans":[{"id":"spn-66003","text":"Core fort generator ("},{"id":"spn-66004","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-66005","text":") already exists with "},{"id":"spn-66006","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-56924","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56926","kind":"heading","level":2,"spans":[{"id":"spn-66007","text":"Files to Create"}]},{"id":"blk-56927","kind":"heading","level":3,"spans":[{"id":"spn-66008","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-56928","kind":"paragraph","spans":[{"id":"spn-66009","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-56929","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-56930","kind":"paragraph","spans":[{"id":"spn-66010","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-56932","spans":[{"id":"spn-66011","text":"Git concept"}]},{"id":"blk-56933","spans":[{"id":"spn-66012","text":"Fort concept"}]},{"id":"blk-56934","spans":[{"id":"spn-66013","text":"Level"}]}],"id":"blk-56931","kind":"table","rows":[[{"id":"blk-56935","spans":[{"id":"spn-66014","text":"Repository"}]},{"id":"blk-56936","spans":[{"id":"spn-66015","text":"Fort (L1 Campus)"}]},{"id":"blk-56937","spans":[{"id":"spn-66016","text":"L1"}]}],[{"id":"blk-56938","spans":[{"id":"spn-66017","text":"Top-level directory"}]},{"id":"blk-56939","spans":[{"id":"spn-66018","text":"Room"}]},{"id":"blk-56940","spans":[{"id":"spn-66019","text":"L2"}]}],[{"id":"blk-56941","spans":[{"id":"spn-66020","text":"Subdirectory"}]},{"id":"blk-56942","spans":[{"id":"spn-66021","text":"Nested room cluster"}]},{"id":"blk-56943","spans":[{"id":"spn-66022","text":"L2"}]}],[{"id":"blk-56944","spans":[{"id":"spn-66023","text":"Source file"}]},{"id":"blk-56945","spans":[{"id":"spn-66024","text":"Tile"}]},{"id":"blk-56946","spans":[{"id":"spn-66025","text":"L3"}]}],[{"id":"blk-56947","spans":[{"id":"spn-66026","marks":["code"],"text":"package.json"},{"id":"spn-66027","text":" / "},{"id":"spn-66028","marks":["code"],"text":"mix.exs"},{"id":"spn-66029","text":" / "},{"id":"spn-66030","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-56948","spans":[{"id":"spn-66031","text":"Gate node (entry point)"}]},{"id":"blk-56949","spans":[{"id":"spn-66032","text":"L2"}]}],[{"id":"blk-56950","spans":[{"id":"spn-66033","text":"Import/require between dirs"}]},{"id":"blk-56951","spans":[{"id":"spn-66034","text":"Hall (corridor edge)"}]},{"id":"blk-56952","spans":[{"id":"spn-66035","text":"L2"}]}],[{"id":"blk-56953","spans":[{"id":"spn-66036","text":"External dependency"}]},{"id":"blk-56954","spans":[{"id":"spn-66037","text":"Bridge edge (outgoing)"}]},{"id":"blk-56955","spans":[{"id":"spn-66038","text":"L1"}]}],[{"id":"blk-56956","spans":[{"id":"spn-66039","text":"README / docs"}]},{"id":"blk-56957","spans":[{"id":"spn-66040","text":"Tower (observation)"}]},{"id":"blk-56958","spans":[{"id":"spn-66041","text":"L2"}]}],[{"id":"blk-56959","spans":[{"id":"spn-66042","text":"Config files"}]},{"id":"blk-56960","spans":[{"id":"spn-66043","text":"Wall (policy)"}]},{"id":"blk-56961","spans":[{"id":"spn-66044","text":"L2"}]}]]},{"id":"blk-56962","kind":"heading","level":3,"spans":[{"id":"spn-66045","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-56963","kind":"paragraph","spans":[{"id":"spn-66046","text":"Modal with:"}]},{"id":"blk-56964","items":[{"blocks":[{"id":"blk-56966","kind":"paragraph","spans":[{"id":"spn-66047","text":"GitHub URL input field"}]}],"id":"blk-56965","kind":"list-item"},{"blocks":[{"id":"blk-56968","kind":"paragraph","spans":[{"id":"spn-66048","text":"Branch selector (default: main)"}]}],"id":"blk-56967","kind":"list-item"},{"blocks":[{"id":"blk-56970","kind":"paragraph","spans":[{"id":"spn-66049","text":"\"Import\" button"}]}],"id":"blk-56969","kind":"list-item"},{"blocks":[{"id":"blk-56972","kind":"paragraph","spans":[{"id":"spn-66050","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-56971","kind":"list-item"},{"blocks":[{"id":"blk-56974","kind":"paragraph","spans":[{"id":"spn-66051","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-56973","kind":"list-item"},{"blocks":[{"id":"blk-56976","kind":"paragraph","spans":[{"id":"spn-66052","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-56975","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56977","kind":"paragraph","spans":[{"id":"spn-66053","text":"On import success: call "},{"id":"spn-66054","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-56978","kind":"heading","level":3,"spans":[{"id":"spn-66055","text":"Fort store addition"}]},{"id":"blk-56979","kind":"paragraph","spans":[{"id":"spn-66056","text":"Add to "},{"id":"spn-66057","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-66058","text":":"}]},{"id":"blk-56980","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-56981","kind":"heading","level":2,"spans":[{"id":"spn-66059","text":"Integration Point"}]},{"id":"blk-56982","kind":"paragraph","spans":[{"id":"spn-66060","text":"Add a \"Import Repo\" button to the "},{"id":"spn-66061","marks":["code"],"text":"/app"},{"id":"spn-66062","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-56983","kind":"heading","level":2,"spans":[{"id":"spn-66063","text":"Constraints"}]},{"id":"blk-56984","items":[{"blocks":[{"id":"blk-56986","kind":"paragraph","spans":[{"id":"spn-66064","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-56985","kind":"list-item"},{"blocks":[{"id":"blk-56988","kind":"paragraph","spans":[{"id":"spn-66065","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-56987","kind":"list-item"},{"blocks":[{"id":"blk-56990","kind":"paragraph","spans":[{"id":"spn-66066","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-56989","kind":"list-item"},{"blocks":[{"id":"blk-56992","kind":"paragraph","spans":[{"id":"spn-66067","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-56991","kind":"list-item"},{"blocks":[{"id":"blk-56994","kind":"paragraph","spans":[{"id":"spn-66068","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-56993","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraq77iyerqbcpcwzxq32pnxpvtl7gto6r3tj7o24puk2gfrar7lrrq","vocabulary":"ampersand.docs.fs.v1"}