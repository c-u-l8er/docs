{"bendscript":"0.1","blocks":[{"id":"blk-106465","kind":"heading","level":1,"spans":[{"id":"spn-171605","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-106466","kind":"heading","level":2,"spans":[{"id":"spn-171606","text":"Goal"}]},{"id":"blk-106467","kind":"paragraph","spans":[{"id":"spn-171607","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-106468","kind":"heading","level":2,"spans":[{"id":"spn-171608","text":"Prerequisites"}]},{"id":"blk-106469","items":[{"blocks":[{"id":"blk-106471","kind":"paragraph","spans":[{"id":"spn-171609","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-106470","kind":"list-item"},{"blocks":[{"id":"blk-106473","kind":"paragraph","spans":[{"id":"spn-171610","text":"Core fort generator ("},{"id":"spn-171611","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-171612","text":") already exists with "},{"id":"spn-171613","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-106472","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106474","kind":"heading","level":2,"spans":[{"id":"spn-171614","text":"Files to Create"}]},{"id":"blk-106475","kind":"heading","level":3,"spans":[{"id":"spn-171615","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-106476","kind":"paragraph","spans":[{"id":"spn-171616","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-106477","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-106478","kind":"paragraph","spans":[{"id":"spn-171617","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-106480","spans":[{"id":"spn-171618","text":"Git concept"}]},{"id":"blk-106481","spans":[{"id":"spn-171619","text":"Fort concept"}]},{"id":"blk-106482","spans":[{"id":"spn-171620","text":"Level"}]}],"id":"blk-106479","kind":"table","rows":[[{"id":"blk-106483","spans":[{"id":"spn-171621","text":"Repository"}]},{"id":"blk-106484","spans":[{"id":"spn-171622","text":"Fort (L1 Campus)"}]},{"id":"blk-106485","spans":[{"id":"spn-171623","text":"L1"}]}],[{"id":"blk-106486","spans":[{"id":"spn-171624","text":"Top-level directory"}]},{"id":"blk-106487","spans":[{"id":"spn-171625","text":"Room"}]},{"id":"blk-106488","spans":[{"id":"spn-171626","text":"L2"}]}],[{"id":"blk-106489","spans":[{"id":"spn-171627","text":"Subdirectory"}]},{"id":"blk-106490","spans":[{"id":"spn-171628","text":"Nested room cluster"}]},{"id":"blk-106491","spans":[{"id":"spn-171629","text":"L2"}]}],[{"id":"blk-106492","spans":[{"id":"spn-171630","text":"Source file"}]},{"id":"blk-106493","spans":[{"id":"spn-171631","text":"Tile"}]},{"id":"blk-106494","spans":[{"id":"spn-171632","text":"L3"}]}],[{"id":"blk-106495","spans":[{"id":"spn-171633","marks":["code"],"text":"package.json"},{"id":"spn-171634","text":" / "},{"id":"spn-171635","marks":["code"],"text":"mix.exs"},{"id":"spn-171636","text":" / "},{"id":"spn-171637","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-106496","spans":[{"id":"spn-171638","text":"Gate node (entry point)"}]},{"id":"blk-106497","spans":[{"id":"spn-171639","text":"L2"}]}],[{"id":"blk-106498","spans":[{"id":"spn-171640","text":"Import/require between dirs"}]},{"id":"blk-106499","spans":[{"id":"spn-171641","text":"Hall (corridor edge)"}]},{"id":"blk-106500","spans":[{"id":"spn-171642","text":"L2"}]}],[{"id":"blk-106501","spans":[{"id":"spn-171643","text":"External dependency"}]},{"id":"blk-106502","spans":[{"id":"spn-171644","text":"Bridge edge (outgoing)"}]},{"id":"blk-106503","spans":[{"id":"spn-171645","text":"L1"}]}],[{"id":"blk-106504","spans":[{"id":"spn-171646","text":"README / docs"}]},{"id":"blk-106505","spans":[{"id":"spn-171647","text":"Tower (observation)"}]},{"id":"blk-106506","spans":[{"id":"spn-171648","text":"L2"}]}],[{"id":"blk-106507","spans":[{"id":"spn-171649","text":"Config files"}]},{"id":"blk-106508","spans":[{"id":"spn-171650","text":"Wall (policy)"}]},{"id":"blk-106509","spans":[{"id":"spn-171651","text":"L2"}]}]]},{"id":"blk-106510","kind":"heading","level":3,"spans":[{"id":"spn-171652","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-106511","kind":"paragraph","spans":[{"id":"spn-171653","text":"Modal with:"}]},{"id":"blk-106512","items":[{"blocks":[{"id":"blk-106514","kind":"paragraph","spans":[{"id":"spn-171654","text":"GitHub URL input field"}]}],"id":"blk-106513","kind":"list-item"},{"blocks":[{"id":"blk-106516","kind":"paragraph","spans":[{"id":"spn-171655","text":"Branch selector (default: main)"}]}],"id":"blk-106515","kind":"list-item"},{"blocks":[{"id":"blk-106518","kind":"paragraph","spans":[{"id":"spn-171656","text":"\"Import\" button"}]}],"id":"blk-106517","kind":"list-item"},{"blocks":[{"id":"blk-106520","kind":"paragraph","spans":[{"id":"spn-171657","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-106519","kind":"list-item"},{"blocks":[{"id":"blk-106522","kind":"paragraph","spans":[{"id":"spn-171658","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-106521","kind":"list-item"},{"blocks":[{"id":"blk-106524","kind":"paragraph","spans":[{"id":"spn-171659","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-106523","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106525","kind":"paragraph","spans":[{"id":"spn-171660","text":"On import success: call "},{"id":"spn-171661","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-106526","kind":"heading","level":3,"spans":[{"id":"spn-171662","text":"Fort store addition"}]},{"id":"blk-106527","kind":"paragraph","spans":[{"id":"spn-171663","text":"Add to "},{"id":"spn-171664","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-171665","text":":"}]},{"id":"blk-106528","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-106529","kind":"heading","level":2,"spans":[{"id":"spn-171666","text":"Integration Point"}]},{"id":"blk-106530","kind":"paragraph","spans":[{"id":"spn-171667","text":"Add a \"Import Repo\" button to the "},{"id":"spn-171668","marks":["code"],"text":"/app"},{"id":"spn-171669","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-106531","kind":"heading","level":2,"spans":[{"id":"spn-171670","text":"Constraints"}]},{"id":"blk-106532","items":[{"blocks":[{"id":"blk-106534","kind":"paragraph","spans":[{"id":"spn-171671","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-106533","kind":"list-item"},{"blocks":[{"id":"blk-106536","kind":"paragraph","spans":[{"id":"spn-171672","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-106535","kind":"list-item"},{"blocks":[{"id":"blk-106538","kind":"paragraph","spans":[{"id":"spn-171673","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-106537","kind":"list-item"},{"blocks":[{"id":"blk-106540","kind":"paragraph","spans":[{"id":"spn-171674","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-106539","kind":"list-item"},{"blocks":[{"id":"blk-106542","kind":"paragraph","spans":[{"id":"spn-171675","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-106541","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraqeww77xm73faktr2qmt7272c2xooaoq3veqmj54d75i2uhrpvr3a","vocabulary":"ampersand.docs.fs.v1"}