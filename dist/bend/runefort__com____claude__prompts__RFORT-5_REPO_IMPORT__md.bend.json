{"bendscript":"0.1","blocks":[{"id":"blk-83966","kind":"heading","level":1,"spans":[{"id":"spn-117905","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-83967","kind":"heading","level":2,"spans":[{"id":"spn-117906","text":"Goal"}]},{"id":"blk-83968","kind":"paragraph","spans":[{"id":"spn-117907","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-83969","kind":"heading","level":2,"spans":[{"id":"spn-117908","text":"Prerequisites"}]},{"id":"blk-83970","items":[{"blocks":[{"id":"blk-83972","kind":"paragraph","spans":[{"id":"spn-117909","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-83971","kind":"list-item"},{"blocks":[{"id":"blk-83974","kind":"paragraph","spans":[{"id":"spn-117910","text":"Core fort generator ("},{"id":"spn-117911","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-117912","text":") already exists with "},{"id":"spn-117913","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-83973","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83975","kind":"heading","level":2,"spans":[{"id":"spn-117914","text":"Files to Create"}]},{"id":"blk-83976","kind":"heading","level":3,"spans":[{"id":"spn-117915","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-83977","kind":"paragraph","spans":[{"id":"spn-117916","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-83978","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-83979","kind":"paragraph","spans":[{"id":"spn-117917","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-83981","spans":[{"id":"spn-117918","text":"Git concept"}]},{"id":"blk-83982","spans":[{"id":"spn-117919","text":"Fort concept"}]},{"id":"blk-83983","spans":[{"id":"spn-117920","text":"Level"}]}],"id":"blk-83980","kind":"table","rows":[[{"id":"blk-83984","spans":[{"id":"spn-117921","text":"Repository"}]},{"id":"blk-83985","spans":[{"id":"spn-117922","text":"Fort (L1 Campus)"}]},{"id":"blk-83986","spans":[{"id":"spn-117923","text":"L1"}]}],[{"id":"blk-83987","spans":[{"id":"spn-117924","text":"Top-level directory"}]},{"id":"blk-83988","spans":[{"id":"spn-117925","text":"Room"}]},{"id":"blk-83989","spans":[{"id":"spn-117926","text":"L2"}]}],[{"id":"blk-83990","spans":[{"id":"spn-117927","text":"Subdirectory"}]},{"id":"blk-83991","spans":[{"id":"spn-117928","text":"Nested room cluster"}]},{"id":"blk-83992","spans":[{"id":"spn-117929","text":"L2"}]}],[{"id":"blk-83993","spans":[{"id":"spn-117930","text":"Source file"}]},{"id":"blk-83994","spans":[{"id":"spn-117931","text":"Tile"}]},{"id":"blk-83995","spans":[{"id":"spn-117932","text":"L3"}]}],[{"id":"blk-83996","spans":[{"id":"spn-117933","marks":["code"],"text":"package.json"},{"id":"spn-117934","text":" / "},{"id":"spn-117935","marks":["code"],"text":"mix.exs"},{"id":"spn-117936","text":" / "},{"id":"spn-117937","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-83997","spans":[{"id":"spn-117938","text":"Gate node (entry point)"}]},{"id":"blk-83998","spans":[{"id":"spn-117939","text":"L2"}]}],[{"id":"blk-83999","spans":[{"id":"spn-117940","text":"Import/require between dirs"}]},{"id":"blk-84000","spans":[{"id":"spn-117941","text":"Hall (corridor edge)"}]},{"id":"blk-84001","spans":[{"id":"spn-117942","text":"L2"}]}],[{"id":"blk-84002","spans":[{"id":"spn-117943","text":"External dependency"}]},{"id":"blk-84003","spans":[{"id":"spn-117944","text":"Bridge edge (outgoing)"}]},{"id":"blk-84004","spans":[{"id":"spn-117945","text":"L1"}]}],[{"id":"blk-84005","spans":[{"id":"spn-117946","text":"README / docs"}]},{"id":"blk-84006","spans":[{"id":"spn-117947","text":"Tower (observation)"}]},{"id":"blk-84007","spans":[{"id":"spn-117948","text":"L2"}]}],[{"id":"blk-84008","spans":[{"id":"spn-117949","text":"Config files"}]},{"id":"blk-84009","spans":[{"id":"spn-117950","text":"Wall (policy)"}]},{"id":"blk-84010","spans":[{"id":"spn-117951","text":"L2"}]}]]},{"id":"blk-84011","kind":"heading","level":3,"spans":[{"id":"spn-117952","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-84012","kind":"paragraph","spans":[{"id":"spn-117953","text":"Modal with:"}]},{"id":"blk-84013","items":[{"blocks":[{"id":"blk-84015","kind":"paragraph","spans":[{"id":"spn-117954","text":"GitHub URL input field"}]}],"id":"blk-84014","kind":"list-item"},{"blocks":[{"id":"blk-84017","kind":"paragraph","spans":[{"id":"spn-117955","text":"Branch selector (default: main)"}]}],"id":"blk-84016","kind":"list-item"},{"blocks":[{"id":"blk-84019","kind":"paragraph","spans":[{"id":"spn-117956","text":"\"Import\" button"}]}],"id":"blk-84018","kind":"list-item"},{"blocks":[{"id":"blk-84021","kind":"paragraph","spans":[{"id":"spn-117957","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-84020","kind":"list-item"},{"blocks":[{"id":"blk-84023","kind":"paragraph","spans":[{"id":"spn-117958","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-84022","kind":"list-item"},{"blocks":[{"id":"blk-84025","kind":"paragraph","spans":[{"id":"spn-117959","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-84024","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84026","kind":"paragraph","spans":[{"id":"spn-117960","text":"On import success: call "},{"id":"spn-117961","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-84027","kind":"heading","level":3,"spans":[{"id":"spn-117962","text":"Fort store addition"}]},{"id":"blk-84028","kind":"paragraph","spans":[{"id":"spn-117963","text":"Add to "},{"id":"spn-117964","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-117965","text":":"}]},{"id":"blk-84029","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-84030","kind":"heading","level":2,"spans":[{"id":"spn-117966","text":"Integration Point"}]},{"id":"blk-84031","kind":"paragraph","spans":[{"id":"spn-117967","text":"Add a \"Import Repo\" button to the "},{"id":"spn-117968","marks":["code"],"text":"/app"},{"id":"spn-117969","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-84032","kind":"heading","level":2,"spans":[{"id":"spn-117970","text":"Constraints"}]},{"id":"blk-84033","items":[{"blocks":[{"id":"blk-84035","kind":"paragraph","spans":[{"id":"spn-117971","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-84034","kind":"list-item"},{"blocks":[{"id":"blk-84037","kind":"paragraph","spans":[{"id":"spn-117972","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-84036","kind":"list-item"},{"blocks":[{"id":"blk-84039","kind":"paragraph","spans":[{"id":"spn-117973","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-84038","kind":"list-item"},{"blocks":[{"id":"blk-84041","kind":"paragraph","spans":[{"id":"spn-117974","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-84040","kind":"list-item"},{"blocks":[{"id":"blk-84043","kind":"paragraph","spans":[{"id":"spn-117975","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-84042","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraoskemit2gnh6wm3ladihkbz5eqgerm5k25gmx6mviwwdmemsco2a","vocabulary":"ampersand.docs.fs.v1"}