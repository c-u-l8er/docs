{"bendscript":"0.1","blocks":[{"id":"blk-57403","kind":"heading","level":1,"spans":[{"id":"spn-67118","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-57404","kind":"heading","level":2,"spans":[{"id":"spn-67119","text":"Goal"}]},{"id":"blk-57405","kind":"paragraph","spans":[{"id":"spn-67120","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-57406","kind":"heading","level":2,"spans":[{"id":"spn-67121","text":"Prerequisites"}]},{"id":"blk-57407","items":[{"blocks":[{"id":"blk-57409","kind":"paragraph","spans":[{"id":"spn-67122","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-57408","kind":"list-item"},{"blocks":[{"id":"blk-57411","kind":"paragraph","spans":[{"id":"spn-67123","text":"Core fort generator ("},{"id":"spn-67124","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-67125","text":") already exists with "},{"id":"spn-67126","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-57410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57412","kind":"heading","level":2,"spans":[{"id":"spn-67127","text":"Files to Create"}]},{"id":"blk-57413","kind":"heading","level":3,"spans":[{"id":"spn-67128","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-57414","kind":"paragraph","spans":[{"id":"spn-67129","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-57415","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-57416","kind":"paragraph","spans":[{"id":"spn-67130","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-57418","spans":[{"id":"spn-67131","text":"Git concept"}]},{"id":"blk-57419","spans":[{"id":"spn-67132","text":"Fort concept"}]},{"id":"blk-57420","spans":[{"id":"spn-67133","text":"Level"}]}],"id":"blk-57417","kind":"table","rows":[[{"id":"blk-57421","spans":[{"id":"spn-67134","text":"Repository"}]},{"id":"blk-57422","spans":[{"id":"spn-67135","text":"Fort (L1 Campus)"}]},{"id":"blk-57423","spans":[{"id":"spn-67136","text":"L1"}]}],[{"id":"blk-57424","spans":[{"id":"spn-67137","text":"Top-level directory"}]},{"id":"blk-57425","spans":[{"id":"spn-67138","text":"Room"}]},{"id":"blk-57426","spans":[{"id":"spn-67139","text":"L2"}]}],[{"id":"blk-57427","spans":[{"id":"spn-67140","text":"Subdirectory"}]},{"id":"blk-57428","spans":[{"id":"spn-67141","text":"Nested room cluster"}]},{"id":"blk-57429","spans":[{"id":"spn-67142","text":"L2"}]}],[{"id":"blk-57430","spans":[{"id":"spn-67143","text":"Source file"}]},{"id":"blk-57431","spans":[{"id":"spn-67144","text":"Tile"}]},{"id":"blk-57432","spans":[{"id":"spn-67145","text":"L3"}]}],[{"id":"blk-57433","spans":[{"id":"spn-67146","marks":["code"],"text":"package.json"},{"id":"spn-67147","text":" / "},{"id":"spn-67148","marks":["code"],"text":"mix.exs"},{"id":"spn-67149","text":" / "},{"id":"spn-67150","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-57434","spans":[{"id":"spn-67151","text":"Gate node (entry point)"}]},{"id":"blk-57435","spans":[{"id":"spn-67152","text":"L2"}]}],[{"id":"blk-57436","spans":[{"id":"spn-67153","text":"Import/require between dirs"}]},{"id":"blk-57437","spans":[{"id":"spn-67154","text":"Hall (corridor edge)"}]},{"id":"blk-57438","spans":[{"id":"spn-67155","text":"L2"}]}],[{"id":"blk-57439","spans":[{"id":"spn-67156","text":"External dependency"}]},{"id":"blk-57440","spans":[{"id":"spn-67157","text":"Bridge edge (outgoing)"}]},{"id":"blk-57441","spans":[{"id":"spn-67158","text":"L1"}]}],[{"id":"blk-57442","spans":[{"id":"spn-67159","text":"README / docs"}]},{"id":"blk-57443","spans":[{"id":"spn-67160","text":"Tower (observation)"}]},{"id":"blk-57444","spans":[{"id":"spn-67161","text":"L2"}]}],[{"id":"blk-57445","spans":[{"id":"spn-67162","text":"Config files"}]},{"id":"blk-57446","spans":[{"id":"spn-67163","text":"Wall (policy)"}]},{"id":"blk-57447","spans":[{"id":"spn-67164","text":"L2"}]}]]},{"id":"blk-57448","kind":"heading","level":3,"spans":[{"id":"spn-67165","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-57449","kind":"paragraph","spans":[{"id":"spn-67166","text":"Modal with:"}]},{"id":"blk-57450","items":[{"blocks":[{"id":"blk-57452","kind":"paragraph","spans":[{"id":"spn-67167","text":"GitHub URL input field"}]}],"id":"blk-57451","kind":"list-item"},{"blocks":[{"id":"blk-57454","kind":"paragraph","spans":[{"id":"spn-67168","text":"Branch selector (default: main)"}]}],"id":"blk-57453","kind":"list-item"},{"blocks":[{"id":"blk-57456","kind":"paragraph","spans":[{"id":"spn-67169","text":"\"Import\" button"}]}],"id":"blk-57455","kind":"list-item"},{"blocks":[{"id":"blk-57458","kind":"paragraph","spans":[{"id":"spn-67170","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-57457","kind":"list-item"},{"blocks":[{"id":"blk-57460","kind":"paragraph","spans":[{"id":"spn-67171","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-57459","kind":"list-item"},{"blocks":[{"id":"blk-57462","kind":"paragraph","spans":[{"id":"spn-67172","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-57461","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57463","kind":"paragraph","spans":[{"id":"spn-67173","text":"On import success: call "},{"id":"spn-67174","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-57464","kind":"heading","level":3,"spans":[{"id":"spn-67175","text":"Fort store addition"}]},{"id":"blk-57465","kind":"paragraph","spans":[{"id":"spn-67176","text":"Add to "},{"id":"spn-67177","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-67178","text":":"}]},{"id":"blk-57466","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-57467","kind":"heading","level":2,"spans":[{"id":"spn-67179","text":"Integration Point"}]},{"id":"blk-57468","kind":"paragraph","spans":[{"id":"spn-67180","text":"Add a \"Import Repo\" button to the "},{"id":"spn-67181","marks":["code"],"text":"/app"},{"id":"spn-67182","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-57469","kind":"heading","level":2,"spans":[{"id":"spn-67183","text":"Constraints"}]},{"id":"blk-57470","items":[{"blocks":[{"id":"blk-57472","kind":"paragraph","spans":[{"id":"spn-67184","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-57471","kind":"list-item"},{"blocks":[{"id":"blk-57474","kind":"paragraph","spans":[{"id":"spn-67185","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-57473","kind":"list-item"},{"blocks":[{"id":"blk-57476","kind":"paragraph","spans":[{"id":"spn-67186","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-57475","kind":"list-item"},{"blocks":[{"id":"blk-57478","kind":"paragraph","spans":[{"id":"spn-67187","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-57477","kind":"list-item"},{"blocks":[{"id":"blk-57480","kind":"paragraph","spans":[{"id":"spn-67188","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-57479","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7wvp4lqhfx2ivibeusxtncal4br3onadlsti2imfy67phrzfl2zq","vocabulary":"ampersand.docs.fs.v1"}