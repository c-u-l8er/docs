{"bendscript":"0.1","blocks":[{"id":"blk-83012","kind":"heading","level":1,"spans":[{"id":"spn-115118","text":"RFort-5: Repo Import → Fort Generator"}]},{"id":"blk-83013","kind":"heading","level":2,"spans":[{"id":"spn-115119","text":"Goal"}]},{"id":"blk-83014","kind":"paragraph","spans":[{"id":"spn-115120","text":"Let users paste a GitHub repo URL and generate a fort layout from the repository structure. Directories become rooms, files become tiles, imports/exports become edges. This is the \"bring your own codebase\" feature."}]},{"id":"blk-83015","kind":"heading","level":2,"spans":[{"id":"spn-115121","text":"Prerequisites"}]},{"id":"blk-83016","items":[{"blocks":[{"id":"blk-83018","kind":"paragraph","spans":[{"id":"spn-115122","text":"RFort-1 (BYOK) — not strictly required but enhances with LLM-powered analysis"}]}],"id":"blk-83017","kind":"list-item"},{"blocks":[{"id":"blk-83020","kind":"paragraph","spans":[{"id":"spn-115123","text":"Core fort generator ("},{"id":"spn-115124","marks":["code"],"text":"src/lib/fortGenerator.js"},{"id":"spn-115125","text":") already exists with "},{"id":"spn-115126","marks":["code"],"text":"generateFortFromManifest()"}]}],"id":"blk-83019","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83021","kind":"heading","level":2,"spans":[{"id":"spn-115127","text":"Files to Create"}]},{"id":"blk-83022","kind":"heading","level":3,"spans":[{"id":"spn-115128","marks":["code"],"text":"src/lib/play/repoImport.js"}]},{"id":"blk-83023","kind":"paragraph","spans":[{"id":"spn-115129","text":"GitHub API client (no auth needed for public repos):"}]},{"id":"blk-83024","kind":"code","language":"js","text":"// Fetch repo tree (recursive)\nexport async function fetchRepoTree(owner, repo, branch = 'main') {\n  const res = await fetch(\n    `https://api.github.com/repos/${owner}/${repo}/git/trees/${branch}?recursive=1`\n  );\n  const data = await res.json();\n  return data.tree; // [{ path, type: 'blob'|'tree', size }]\n}\n\n// Parse GitHub URL → { owner, repo }\nexport function parseGitHubUrl(url) {\n  const m = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n  return m ? { owner: m[1], repo: m[2].replace(/\\.git$/, '') } : null;\n}\n\n// Convert repo tree → fort layout (Svelte Flow nodes + edges)\nexport function repoToFort(repoName, tree) {\n  // Group files by directory\n  // Top-level dirs → L1 rooms\n  // Files → L2 tiles within rooms\n  // Detect relationships:\n  //   - package.json deps → edges between rooms\n  //   - import statements (if file content available) → edges\n  //   - Same-extension files in different dirs → weak edges\n  // Return { nodes, edges, manifest } compatible with fort store\n}"},{"id":"blk-83025","kind":"paragraph","spans":[{"id":"spn-115130","marks":["bold"],"text":"Mapping rules:"}]},{"head":[{"id":"blk-83027","spans":[{"id":"spn-115131","text":"Git concept"}]},{"id":"blk-83028","spans":[{"id":"spn-115132","text":"Fort concept"}]},{"id":"blk-83029","spans":[{"id":"spn-115133","text":"Level"}]}],"id":"blk-83026","kind":"table","rows":[[{"id":"blk-83030","spans":[{"id":"spn-115134","text":"Repository"}]},{"id":"blk-83031","spans":[{"id":"spn-115135","text":"Fort (L1 Campus)"}]},{"id":"blk-83032","spans":[{"id":"spn-115136","text":"L1"}]}],[{"id":"blk-83033","spans":[{"id":"spn-115137","text":"Top-level directory"}]},{"id":"blk-83034","spans":[{"id":"spn-115138","text":"Room"}]},{"id":"blk-83035","spans":[{"id":"spn-115139","text":"L2"}]}],[{"id":"blk-83036","spans":[{"id":"spn-115140","text":"Subdirectory"}]},{"id":"blk-83037","spans":[{"id":"spn-115141","text":"Nested room cluster"}]},{"id":"blk-83038","spans":[{"id":"spn-115142","text":"L2"}]}],[{"id":"blk-83039","spans":[{"id":"spn-115143","text":"Source file"}]},{"id":"blk-83040","spans":[{"id":"spn-115144","text":"Tile"}]},{"id":"blk-83041","spans":[{"id":"spn-115145","text":"L3"}]}],[{"id":"blk-83042","spans":[{"id":"spn-115146","marks":["code"],"text":"package.json"},{"id":"spn-115147","text":" / "},{"id":"spn-115148","marks":["code"],"text":"mix.exs"},{"id":"spn-115149","text":" / "},{"id":"spn-115150","marks":["code"],"text":"Cargo.toml"}]},{"id":"blk-83043","spans":[{"id":"spn-115151","text":"Gate node (entry point)"}]},{"id":"blk-83044","spans":[{"id":"spn-115152","text":"L2"}]}],[{"id":"blk-83045","spans":[{"id":"spn-115153","text":"Import/require between dirs"}]},{"id":"blk-83046","spans":[{"id":"spn-115154","text":"Hall (corridor edge)"}]},{"id":"blk-83047","spans":[{"id":"spn-115155","text":"L2"}]}],[{"id":"blk-83048","spans":[{"id":"spn-115156","text":"External dependency"}]},{"id":"blk-83049","spans":[{"id":"spn-115157","text":"Bridge edge (outgoing)"}]},{"id":"blk-83050","spans":[{"id":"spn-115158","text":"L1"}]}],[{"id":"blk-83051","spans":[{"id":"spn-115159","text":"README / docs"}]},{"id":"blk-83052","spans":[{"id":"spn-115160","text":"Tower (observation)"}]},{"id":"blk-83053","spans":[{"id":"spn-115161","text":"L2"}]}],[{"id":"blk-83054","spans":[{"id":"spn-115162","text":"Config files"}]},{"id":"blk-83055","spans":[{"id":"spn-115163","text":"Wall (policy)"}]},{"id":"blk-83056","spans":[{"id":"spn-115164","text":"L2"}]}]]},{"id":"blk-83057","kind":"heading","level":3,"spans":[{"id":"spn-115165","marks":["code"],"text":"src/components/app/RepoImportModal.svelte"}]},{"id":"blk-83058","kind":"paragraph","spans":[{"id":"spn-115166","text":"Modal with:"}]},{"id":"blk-83059","items":[{"blocks":[{"id":"blk-83061","kind":"paragraph","spans":[{"id":"spn-115167","text":"GitHub URL input field"}]}],"id":"blk-83060","kind":"list-item"},{"blocks":[{"id":"blk-83063","kind":"paragraph","spans":[{"id":"spn-115168","text":"Branch selector (default: main)"}]}],"id":"blk-83062","kind":"list-item"},{"blocks":[{"id":"blk-83065","kind":"paragraph","spans":[{"id":"spn-115169","text":"\"Import\" button"}]}],"id":"blk-83064","kind":"list-item"},{"blocks":[{"id":"blk-83067","kind":"paragraph","spans":[{"id":"spn-115170","text":"Loading state with progress (fetching tree...)"}]}],"id":"blk-83066","kind":"list-item"},{"blocks":[{"id":"blk-83069","kind":"paragraph","spans":[{"id":"spn-115171","text":"Error display (invalid URL, API rate limit, repo not found)"}]}],"id":"blk-83068","kind":"list-item"},{"blocks":[{"id":"blk-83071","kind":"paragraph","spans":[{"id":"spn-115172","text":"Preview: show directory count, file count before generating"}]}],"id":"blk-83070","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83072","kind":"paragraph","spans":[{"id":"spn-115173","text":"On import success: call "},{"id":"spn-115174","marks":["code"],"text":"fortStore.loadImportedFort(nodes, edges, repoName)"}]},{"id":"blk-83073","kind":"heading","level":3,"spans":[{"id":"spn-115175","text":"Fort store addition"}]},{"id":"blk-83074","kind":"paragraph","spans":[{"id":"spn-115176","text":"Add to "},{"id":"spn-115177","marks":["code"],"text":"src/lib/stores/fort.svelte.js"},{"id":"spn-115178","text":":"}]},{"id":"blk-83075","kind":"code","language":"js","text":"export function loadImportedFort(nodes, edges, name) {\n  // Set fort state from imported data\n  // Start at L1 (campus) showing the repo overview\n}"},{"id":"blk-83076","kind":"heading","level":2,"spans":[{"id":"spn-115179","text":"Integration Point"}]},{"id":"blk-83077","kind":"paragraph","spans":[{"id":"spn-115180","text":"Add a \"Import Repo\" button to the "},{"id":"spn-115181","marks":["code"],"text":"/app"},{"id":"spn-115182","text":" toolbar (folder/download icon). Opens RepoImportModal."}]},{"id":"blk-83078","kind":"heading","level":2,"spans":[{"id":"spn-115183","text":"Constraints"}]},{"id":"blk-83079","items":[{"blocks":[{"id":"blk-83081","kind":"paragraph","spans":[{"id":"spn-115184","text":"GitHub API rate limit: 60 req/hour unauthenticated. The recursive tree endpoint is 1 request, so this is fine for demos."}]}],"id":"blk-83080","kind":"list-item"},{"blocks":[{"id":"blk-83083","kind":"paragraph","spans":[{"id":"spn-115185","text":"Max 10,000 files (GitHub API limit for recursive tree)"}]}],"id":"blk-83082","kind":"list-item"},{"blocks":[{"id":"blk-83085","kind":"paragraph","spans":[{"id":"spn-115186","text":"No file content fetching in v1 — just structure. Content-based analysis (imports, deps) can come later with BYOK-powered analysis."}]}],"id":"blk-83084","kind":"list-item"},{"blocks":[{"id":"blk-83087","kind":"paragraph","spans":[{"id":"spn-115187","text":"Generate deterministic node IDs from file paths so re-importing the same repo produces the same layout"}]}],"id":"blk-83086","kind":"list-item"},{"blocks":[{"id":"blk-83089","kind":"paragraph","spans":[{"id":"spn-115188","text":"Rune assignment: hash file path to assign Elder Futhark rune (same deterministic hash as existing fortGenerator)"}]}],"id":"blk-83088","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieralbau6ayisd2zmrfkvvkjqnzbp3bls6zbhm4svcczxi4vsb5teg7a","vocabulary":"ampersand.docs.fs.v1"}