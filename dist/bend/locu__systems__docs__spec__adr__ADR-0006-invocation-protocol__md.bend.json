{"bendscript":"0.1","blocks":[{"id":"blk-92324","kind":"heading","level":1,"spans":[{"id":"spn-155980","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-92325","kind":"paragraph","spans":[{"id":"spn-155981","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-92326","items":[{"blocks":[{"id":"blk-92328","kind":"paragraph","spans":[{"id":"spn-155982","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-92327","kind":"list-item"},{"blocks":[{"id":"blk-92330","kind":"paragraph","spans":[{"id":"spn-155983","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-92329","kind":"list-item"},{"blocks":[{"id":"blk-92332","kind":"paragraph","spans":[{"id":"spn-155984","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-92331","kind":"list-item"},{"blocks":[{"id":"blk-92334","kind":"paragraph","spans":[{"id":"spn-155985","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-92333","kind":"list-item"},{"blocks":[{"id":"blk-92336","kind":"paragraph","spans":[{"id":"spn-155986","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-92335","kind":"list-item"},{"blocks":[{"id":"blk-92338","kind":"paragraph","spans":[{"id":"spn-155987","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-155988","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-92337","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92339","kind":"heading","level":2,"spans":[{"id":"spn-155989","text":"Context"}]},{"id":"blk-92340","kind":"paragraph","spans":[{"id":"spn-155990","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-92341","items":[{"blocks":[{"id":"blk-92343","kind":"paragraph","spans":[{"id":"spn-155991","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-92342","kind":"list-item"},{"blocks":[{"id":"blk-92345","kind":"paragraph","spans":[{"id":"spn-155992","text":"consistent session semantics across runtimes,"}]}],"id":"blk-92344","kind":"list-item"},{"blocks":[{"id":"blk-92347","kind":"paragraph","spans":[{"id":"spn-155993","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-92346","kind":"list-item"},{"blocks":[{"id":"blk-92349","kind":"paragraph","spans":[{"id":"spn-155994","text":"safe error handling and sanitization,"}]}],"id":"blk-92348","kind":"list-item"},{"blocks":[{"id":"blk-92351","kind":"paragraph","spans":[{"id":"spn-155995","text":"optional streaming output for good UX."}]}],"id":"blk-92350","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92352","kind":"paragraph","spans":[{"id":"spn-155996","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-92353","items":[{"blocks":[{"id":"blk-92355","kind":"paragraph","spans":[{"id":"spn-155997","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-92354","kind":"list-item"},{"blocks":[{"id":"blk-92357","kind":"paragraph","spans":[{"id":"spn-155998","text":"SDKs hard to write,"}]}],"id":"blk-92356","kind":"list-item"},{"blocks":[{"id":"blk-92359","kind":"paragraph","spans":[{"id":"spn-155999","text":"telemetry inconsistent,"}]}],"id":"blk-92358","kind":"list-item"},{"blocks":[{"id":"blk-92361","kind":"paragraph","spans":[{"id":"spn-156000","text":"limit enforcement unreliable."}]}],"id":"blk-92360","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92362","kind":"paragraph","spans":[{"id":"spn-156001","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-92363","kind":"heading","level":2,"spans":[{"id":"spn-156002","text":"Decision"}]},{"id":"blk-92364","kind":"heading","level":3,"spans":[{"id":"spn-156003","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-156004","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-92365","kind":"paragraph","spans":[{"id":"spn-156005","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-92366","items":[{"blocks":[{"id":"blk-92368","kind":"paragraph","spans":[{"id":"spn-156006","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-92367","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92369","kind":"paragraph","spans":[{"id":"spn-156007","text":"The protocol applies to:"}]},{"id":"blk-92370","items":[{"blocks":[{"id":"blk-92372","kind":"paragraph","spans":[{"id":"spn-156008","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-92371","kind":"list-item"},{"blocks":[{"id":"blk-92374","kind":"paragraph","spans":[{"id":"spn-156009","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-92373","kind":"list-item"},{"blocks":[{"id":"blk-92376","kind":"paragraph","spans":[{"id":"spn-156010","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-92375","kind":"list-item"},{"blocks":[{"id":"blk-92378","kind":"paragraph","spans":[{"id":"spn-156011","text":"telemetry correlation via "},{"id":"spn-156012","marks":["code"],"text":"traceId"},{"id":"spn-156013","text":"."}]}],"id":"blk-92377","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92379","kind":"paragraph","spans":[{"id":"spn-156014","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-156015","marks":["code"],"text":"invoke/v1"},{"id":"spn-156016","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-156017","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-156018","text":"."}]},{"id":"blk-92380","kind":"heading","level":3,"spans":[{"id":"spn-156019","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-92381","kind":"paragraph","spans":[{"id":"spn-156020","marks":["code"],"text":"invoke/v1"},{"id":"spn-156021","text":" defines the canonical input shape as chat "},{"id":"spn-156022","marks":["code"],"text":"messages"},{"id":"spn-156023","text":":"}]},{"id":"blk-92382","items":[{"blocks":[{"id":"blk-92384","kind":"paragraph","spans":[{"id":"spn-156024","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-92383","kind":"list-item"},{"blocks":[{"id":"blk-92386","kind":"paragraph","spans":[{"id":"spn-156025","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-92385","kind":"list-item"},{"blocks":[{"id":"blk-92388","kind":"paragraph","spans":[{"id":"spn-156026","marks":["code"],"text":"content: string"}]}],"id":"blk-92387","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92389","kind":"paragraph","spans":[{"id":"spn-156027","text":"Additionally, for client convenience, "},{"id":"spn-156028","marks":["code"],"text":"invoke/v1"},{"id":"spn-156029","text":" allows a "},{"id":"spn-156030","marks":["code"],"text":"prompt"},{"id":"spn-156031","text":" form:"}]},{"id":"blk-92390","items":[{"blocks":[{"id":"blk-92392","kind":"paragraph","spans":[{"id":"spn-156032","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-92391","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92393","kind":"paragraph","spans":[{"id":"spn-156033","text":"When "},{"id":"spn-156034","marks":["code"],"text":"prompt"},{"id":"spn-156035","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-92394","items":[{"blocks":[{"id":"blk-92396","kind":"paragraph","spans":[{"id":"spn-156036","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-92395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92397","kind":"paragraph","spans":[{"id":"spn-156037","text":"Rationale:"}]},{"id":"blk-92398","items":[{"blocks":[{"id":"blk-92400","kind":"paragraph","spans":[{"id":"spn-156038","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-92399","kind":"list-item"},{"blocks":[{"id":"blk-92402","kind":"paragraph","spans":[{"id":"spn-156039","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-92401","kind":"list-item"},{"blocks":[{"id":"blk-92404","kind":"paragraph","spans":[{"id":"spn-156040","text":"it avoids provider-specific payload drift."}]}],"id":"blk-92403","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92405","kind":"heading","level":3,"spans":[{"id":"spn-156041","text":"3) Session semantics: opaque "},{"id":"spn-156042","marks":["code"],"text":"sessionId"}]},{"id":"blk-92406","kind":"paragraph","spans":[{"id":"spn-156043","marks":["code"],"text":"invoke/v1"},{"id":"spn-156044","text":" standardizes stateful execution via an opaque "},{"id":"spn-156045","marks":["code"],"text":"sessionId"},{"id":"spn-156046","text":" string:"}]},{"id":"blk-92407","items":[{"blocks":[{"id":"blk-92409","kind":"paragraph","spans":[{"id":"spn-156047","text":"Clients MAY include "},{"id":"spn-156048","marks":["code"],"text":"sessionId"},{"id":"spn-156049","text":" to continue a prior session."}]}],"id":"blk-92408","kind":"list-item"},{"blocks":[{"id":"blk-92411","kind":"paragraph","spans":[{"id":"spn-156050","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-156051","marks":["code"],"text":"sessionId"},{"id":"spn-156052","text":"."}]}],"id":"blk-92410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92412","kind":"paragraph","spans":[{"id":"spn-156053","text":"Rules:"}]},{"id":"blk-92413","items":[{"blocks":[{"id":"blk-92415","kind":"paragraph","spans":[{"id":"spn-156054","marks":["code"],"text":"sessionId"},{"id":"spn-156055","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-92414","kind":"list-item"},{"blocks":[{"id":"blk-92417","kind":"paragraph","spans":[{"id":"spn-156056","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-156057","marks":["code"],"text":"sessionId"},{"id":"spn-156058","text":" string."}]}],"id":"blk-92416","kind":"list-item"},{"blocks":[{"id":"blk-92419","kind":"paragraph","spans":[{"id":"spn-156059","text":"Each runtime provider maps "},{"id":"spn-156060","marks":["code"],"text":"sessionId"},{"id":"spn-156061","text":" to its own session primitive:"}]}],"id":"blk-92418","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92420","items":[{"blocks":[{"id":"blk-92422","kind":"paragraph","spans":[{"id":"spn-156062","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-92421","kind":"list-item"},{"blocks":[{"id":"blk-92424","kind":"paragraph","spans":[{"id":"spn-156063","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-92423","kind":"list-item"},{"blocks":[{"id":"blk-92426","kind":"paragraph","spans":[{"id":"spn-156064","marks":["code"],"text":"sessionId"},{"id":"spn-156065","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-92425","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92427","items":[{"blocks":[{"id":"blk-92429","kind":"paragraph","spans":[{"id":"spn-156066","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-156067","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-156068","text":")"}]}],"id":"blk-92428","kind":"list-item"},{"blocks":[{"id":"blk-92431","kind":"paragraph","spans":[{"id":"spn-156069","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-92430","kind":"list-item"},{"blocks":[{"id":"blk-92433","kind":"paragraph","spans":[{"id":"spn-156070","text":"The adapter MUST treat the "},{"id":"spn-156071","marks":["code"],"text":"sessionId"},{"id":"spn-156072","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-92432","kind":"list-item"},{"blocks":[{"id":"blk-92435","kind":"paragraph","spans":[{"id":"spn-156073","text":"If "},{"id":"spn-156074","marks":["code"],"text":"sessionId"},{"id":"spn-156075","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-156076","marks":["code"],"text":"sessionId"},{"id":"spn-156077","text":"."}]}],"id":"blk-92434","kind":"list-item"},{"blocks":[{"id":"blk-92437","kind":"paragraph","spans":[{"id":"spn-156078","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-92436","kind":"list-item"},{"blocks":[{"id":"blk-92439","kind":"paragraph","spans":[{"id":"spn-156079","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-156080","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-156081","text":" with a safe message such as “Session expired” and "},{"id":"spn-156082","marks":["code"],"text":"retryable=false"},{"id":"spn-156083","text":" (do not leak provider internals)."}]}],"id":"blk-92438","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92440","kind":"paragraph","spans":[{"id":"spn-156084","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-92441","items":[{"blocks":[{"id":"blk-92443","kind":"paragraph","spans":[{"id":"spn-156085","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-156086","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-156087","text":") and a "},{"id":"spn-156088","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-156089","text":" set to the opaque "},{"id":"spn-156090","marks":["code"],"text":"sessionId"},{"id":"spn-156091","text":" (or a newly generated one if absent)."}]}],"id":"blk-92442","kind":"list-item"},{"blocks":[{"id":"blk-92445","kind":"paragraph","spans":[{"id":"spn-156092","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-92444","kind":"list-item"},{"blocks":[{"id":"blk-92447","kind":"paragraph","spans":[{"id":"spn-156093","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-92446","kind":"list-item"},{"blocks":[{"id":"blk-92449","kind":"paragraph","spans":[{"id":"spn-156094","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-92448","kind":"list-item"},{"blocks":[{"id":"blk-92451","kind":"paragraph","spans":[{"id":"spn-156095","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-92450","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92452","kind":"heading","level":3,"spans":[{"id":"spn-156096","text":"4) Canonical output: text-first"}]},{"id":"blk-92453","kind":"paragraph","spans":[{"id":"spn-156097","marks":["code"],"text":"invoke/v1"},{"id":"spn-156098","text":" defines the canonical output as:"}]},{"id":"blk-92454","items":[{"blocks":[{"id":"blk-92456","kind":"paragraph","spans":[{"id":"spn-156099","marks":["code"],"text":"output.text: string"},{"id":"spn-156100","text":" (required)"}]}],"id":"blk-92455","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92457","kind":"paragraph","spans":[{"id":"spn-156101","text":"Optionally:"}]},{"id":"blk-92458","items":[{"blocks":[{"id":"blk-92460","kind":"paragraph","spans":[{"id":"spn-156102","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-156103","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-92459","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92461","kind":"paragraph","spans":[{"id":"spn-156104","text":"Rationale:"}]},{"id":"blk-92462","items":[{"blocks":[{"id":"blk-92464","kind":"paragraph","spans":[{"id":"spn-156105","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-92463","kind":"list-item"},{"blocks":[{"id":"blk-92466","kind":"paragraph","spans":[{"id":"spn-156106","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-92465","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92467","kind":"heading","level":3,"spans":[{"id":"spn-156107","text":"5) Usage and correlation are first-class"}]},{"id":"blk-92468","kind":"paragraph","spans":[{"id":"spn-156108","text":"Every "},{"id":"spn-156109","marks":["code"],"text":"invoke/v1"},{"id":"spn-156110","text":" response MUST include:"}]},{"id":"blk-92469","items":[{"blocks":[{"id":"blk-92471","kind":"paragraph","spans":[{"id":"spn-156111","marks":["code"],"text":"traceId: string"},{"id":"spn-156112","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-92470","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92472","kind":"paragraph","spans":[{"id":"spn-156113","text":"Response SHOULD include:"}]},{"id":"blk-92473","items":[{"blocks":[{"id":"blk-92475","kind":"paragraph","spans":[{"id":"spn-156114","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-92474","kind":"list-item"},{"blocks":[{"id":"blk-92477","kind":"paragraph","spans":[{"id":"spn-156115","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-92476","kind":"list-item"},{"blocks":[{"id":"blk-92479","kind":"paragraph","spans":[{"id":"spn-156116","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-156117","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-92478","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92480","kind":"paragraph","spans":[{"id":"spn-156118","text":"Telemetry events MUST include the same "},{"id":"spn-156119","marks":["code"],"text":"traceId"},{"id":"spn-156120","text":" when available, and MUST be attributable to:"}]},{"id":"blk-92481","items":[{"blocks":[{"id":"blk-92483","kind":"paragraph","spans":[{"id":"spn-156121","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-92482","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92484","kind":"heading","level":3,"spans":[{"id":"spn-156122","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-92485","kind":"paragraph","spans":[{"id":"spn-156123","marks":["code"],"text":"invoke/v1"},{"id":"spn-156124","text":" defines streaming semantics via "},{"id":"spn-156125","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-156126","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-92486","items":[{"blocks":[{"id":"blk-92488","kind":"paragraph","spans":[{"id":"spn-156127","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-92487","kind":"list-item"},{"blocks":[{"id":"blk-92490","kind":"paragraph","spans":[{"id":"spn-156128","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-92489","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92491","kind":"paragraph","spans":[{"id":"spn-156129","text":"Standard SSE event types:"}]},{"id":"blk-92492","items":[{"blocks":[{"id":"blk-92494","kind":"paragraph","spans":[{"id":"spn-156130","marks":["code"],"text":"meta"},{"id":"spn-156131","text":" (MUST be first)"}]}],"id":"blk-92493","kind":"list-item"},{"blocks":[{"id":"blk-92496","kind":"paragraph","spans":[{"id":"spn-156132","text":"includes "},{"id":"spn-156133","marks":["code"],"text":"traceId"},{"id":"spn-156134","text":" and "},{"id":"spn-156135","marks":["code"],"text":"sessionId"},{"id":"spn-156136","text":" (if known at start)"}]}],"id":"blk-92495","kind":"list-item"},{"blocks":[{"id":"blk-92498","kind":"paragraph","spans":[{"id":"spn-156137","marks":["code"],"text":"delta"},{"id":"spn-156138","text":" (0..N)"}]}],"id":"blk-92497","kind":"list-item"},{"blocks":[{"id":"blk-92500","kind":"paragraph","spans":[{"id":"spn-156139","text":"includes incremental output text chunks"}]}],"id":"blk-92499","kind":"list-item"},{"blocks":[{"id":"blk-92502","kind":"paragraph","spans":[{"id":"spn-156140","marks":["code"],"text":"usage"},{"id":"spn-156141","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-92501","kind":"list-item"},{"blocks":[{"id":"blk-92504","kind":"paragraph","spans":[{"id":"spn-156142","text":"includes final usage summary when available"}]}],"id":"blk-92503","kind":"list-item"},{"blocks":[{"id":"blk-92506","kind":"paragraph","spans":[{"id":"spn-156143","marks":["code"],"text":"done"},{"id":"spn-156144","text":" (MUST be last on success)"}]}],"id":"blk-92505","kind":"list-item"},{"blocks":[{"id":"blk-92508","kind":"paragraph","spans":[{"id":"spn-156145","marks":["code"],"text":"error"},{"id":"spn-156146","text":" (terminal on failure)"}]}],"id":"blk-92507","kind":"list-item"},{"blocks":[{"id":"blk-92510","kind":"paragraph","spans":[{"id":"spn-156147","text":"includes the normalized error envelope"}]}],"id":"blk-92509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92511","kind":"paragraph","spans":[{"id":"spn-156148","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-92512","items":[{"blocks":[{"id":"blk-92514","kind":"paragraph","spans":[{"id":"spn-156149","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-156150","marks":["code"],"text":"delta"},{"id":"spn-156151","text":" events)."}]}],"id":"blk-92513","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92515","kind":"paragraph","spans":[{"id":"spn-156152","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-92516","items":[{"blocks":[{"id":"blk-92518","kind":"paragraph","spans":[{"id":"spn-156153","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-92517","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92519","kind":"paragraph","spans":[{"id":"spn-156154","text":"Rationale:"}]},{"id":"blk-92520","items":[{"blocks":[{"id":"blk-92522","kind":"paragraph","spans":[{"id":"spn-156155","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-92521","kind":"list-item"},{"blocks":[{"id":"blk-92524","kind":"paragraph","spans":[{"id":"spn-156156","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-92523","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92525","kind":"heading","level":2,"spans":[{"id":"spn-156157","text":"Alternatives considered"}]},{"id":"blk-92526","kind":"heading","level":3,"spans":[{"id":"spn-156158","text":"A) Prompt-only protocol"}]},{"id":"blk-92527","kind":"paragraph","spans":[{"id":"spn-156159","text":"Pros:"}]},{"id":"blk-92528","items":[{"blocks":[{"id":"blk-92530","kind":"paragraph","spans":[{"id":"spn-156160","text":"simplest request shape"}]}],"id":"blk-92529","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92531","kind":"paragraph","spans":[{"id":"spn-156161","text":"Cons:"}]},{"id":"blk-92532","items":[{"blocks":[{"id":"blk-92534","kind":"paragraph","spans":[{"id":"spn-156162","text":"loses structured conversation context"}]}],"id":"blk-92533","kind":"list-item"},{"blocks":[{"id":"blk-92536","kind":"paragraph","spans":[{"id":"spn-156163","text":"complicates future tool call integration"}]}],"id":"blk-92535","kind":"list-item"},{"blocks":[{"id":"blk-92538","kind":"paragraph","spans":[{"id":"spn-156164","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-92537","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92539","kind":"paragraph","spans":[{"id":"spn-156165","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-92540","kind":"heading","level":3,"spans":[{"id":"spn-156166","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-92541","kind":"paragraph","spans":[{"id":"spn-156167","text":"Pros:"}]},{"id":"blk-92542","items":[{"blocks":[{"id":"blk-92544","kind":"paragraph","spans":[{"id":"spn-156168","text":"maximum leverage of each provider’s features"}]}],"id":"blk-92543","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92545","kind":"paragraph","spans":[{"id":"spn-156169","text":"Cons:"}]},{"id":"blk-92546","items":[{"blocks":[{"id":"blk-92548","kind":"paragraph","spans":[{"id":"spn-156170","text":"breaks portability and unified SDKs"}]}],"id":"blk-92547","kind":"list-item"},{"blocks":[{"id":"blk-92550","kind":"paragraph","spans":[{"id":"spn-156171","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-92549","kind":"list-item"},{"blocks":[{"id":"blk-92552","kind":"paragraph","spans":[{"id":"spn-156172","text":"increases maintenance and user confusion"}]}],"id":"blk-92551","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92553","kind":"paragraph","spans":[{"id":"spn-156173","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-92554","kind":"heading","level":3,"spans":[{"id":"spn-156174","text":"C) WebSockets for streaming"}]},{"id":"blk-92555","kind":"paragraph","spans":[{"id":"spn-156175","text":"Pros:"}]},{"id":"blk-92556","items":[{"blocks":[{"id":"blk-92558","kind":"paragraph","spans":[{"id":"spn-156176","text":"bidirectional, flexible"}]}],"id":"blk-92557","kind":"list-item"}],"kind":"list",