ments)"}]},{"id":"blk-92602","kind":"heading","level":3,"spans":[{"id":"spn-156201","text":"1) Protocol versioning"}]},{"id":"blk-92603","items":[{"blocks":[{"id":"blk-92605","kind":"paragraph","spans":[{"id":"spn-156202","text":"Every deployment artifact manifest MUST declare "},{"id":"spn-156203","marks":["code"],"text":"protocol: \"invoke/v1\""},{"id":"spn-156204","text":"."}]}],"id":"blk-92604","kind":"list-item"},{"blocks":[{"id":"blk-92607","kind":"paragraph","spans":[{"id":"spn-156205","text":"The control plane MUST reject deployments with unknown protocol versions ("},{"id":"spn-156206","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-156207","text":")."}]}],"id":"blk-92606","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92608","kind":"heading","level":3,"spans":[{"id":"spn-156208","text":"2) Request normalization rules"}]},{"id":"blk-92609","items":[{"blocks":[{"id":"blk-92611","kind":"paragraph","spans":[{"id":"spn-156209","text":"If "},{"id":"spn-156210","marks":["code"],"text":"input.prompt"},{"id":"spn-156211","text":" provided and "},{"id":"spn-156212","marks":["code"],"text":"input.messages"},{"id":"spn-156213","text":" missing:"}]}],"id":"blk-92610","kind":"list-item"},{"blocks":[{"id":"blk-92613","kind":"paragraph","spans":[{"id":"spn-156214","text":"normalize to one user message."}]}],"id":"blk-92612","kind":"list-item"},{"blocks":[{"id":"blk-92615","kind":"paragraph","spans":[{"id":"spn-156215","text":"If both are provided:"}]}],"id":"blk-92614","kind":"list-item"},{"blocks":[{"id":"blk-92617","kind":"paragraph","spans":[{"id":"spn-156216","text":"prefer "},{"id":"spn-156217","marks":["code"],"text":"messages"},{"id":"spn-156218","text":" and ignore "},{"id":"spn-156219","marks":["code"],"text":"prompt"},{"id":"spn-156220","text":" (or reject as invalid; choose one consistent policy; v1 recommendation: reject with "},{"id":"spn-156221","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-156222","text":" to avoid ambiguity)."