T:"}]}],"id":"blk-92650","kind":"list-item"},{"blocks":[{"id":"blk-92653","kind":"paragraph","spans":[{"id":"spn-156259","text":"send "},{"id":"spn-156260","marks":["code"],"text":"meta"},{"id":"spn-156261","text":" as first event,"}]}],"id":"blk-92652","kind":"list-item"},{"blocks":[{"id":"blk-92655","kind":"paragraph","spans":[{"id":"spn-156262","text":"send "},{"id":"spn-156263","marks":["code"],"text":"done"},{"id":"spn-156264","text":" as last event on success,"}]}],"id":"blk-92654","kind":"list-item"},{"blocks":[{"id":"blk-92657","kind":"paragraph","spans":[{"id":"spn-156265","text":"send "},{"id":"spn-156266","marks":["code"],"text":"error"},{"id":"spn-156267","text":" as terminal event on failure."}]}],"id":"blk-92656","kind":"list-item"},{"blocks":[{"id":"blk-92659","kind":"paragraph","spans":[{"id":"spn-156268","text":"Even on streaming:"}]}],"id":"blk-92658","kind":"list-item"},{"blocks":[{"id":"blk-92661","kind":"paragraph","spans":[{"id":"spn-156269","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-92660","kind":"list-item"},{"blocks":[{"id":"blk-92663","kind":"paragraph","spans":[{"id":"spn-156270","marks":["code"],"text":"usage"},{"id":"spn-156271","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-92662","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92664","kind":"heading","level":3,"spans":[{"id":"spn-156272","text":"5) Error normalization"}]},{"id":"blk-92665","items":[{"blocks":[{"id":"blk-92667","kind":"paragraph","spans":[{"id":"spn-156273","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-156274","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-156275","text":"."}]}],"id":"blk-92666","kind":"list-item"},{"blocks":[{"id":"blk-92669","kind":"paragraph","spans":[{"id":"spn-156276","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-92668","kind":"list-