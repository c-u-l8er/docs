request limit reached.\");\n}\nif (usage.totalTokens >= limits.maxTokens) {\n  throw new LimitExceededError(\"Monthly token limit reached.\");\n}"},{"id":"blk-83310","kind":"paragraph","spans":[{"id":"spn-147770","text":"If any limit is exceeded, the gateway returns "},{"id":"spn-147771","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-147772","text":" (HTTP 429)."}]},{"id":"blk-83311","kind":"heading","level":3,"spans":[{"id":"spn-147773","text":"At Deploy Time"}]},{"id":"blk-83312","kind":"paragraph","spans":[{"id":"spn-147774","text":"The deploy Edge Function enforces:"}]},{"id":"blk-83313","items":[{"blocks":[{"id":"blk-83315","kind":"paragraph","spans":[{"id":"spn-147775","marks":["bold"],"text":"Runtime gating:"},{"id":"spn-147776","text":" Free and Starter tiers cannot deploy to AgentCore."}]}],"id":"blk-83314","kind":"list-item"},{"blocks":[{"id":"blk-83317","kind":"paragraph","spans":[{"id":"spn-147777","marks":["bold"],"text":"Agent count:"},{"id":"spn-147778","text":" Deployment is rejected if the user has reached their tier's"}]}],"id":"blk-83316","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83318","kind":"paragraph","spans":[{"id":"spn-147779","text":"max agent count."}]},{"id":"blk-83319","kind":"code","language":"typescript","text":"if (agent.runtimeProvider === \"agentcore\" && !AGENTCORE_TIERS.includes(user.tier)) {\n  throw new UnauthorizedError(\"AgentCore requires Pro or Enterprise tier.\");\n}"},{"id":"blk-83320","kind":"heading","level":2,"spans":[{"id":"spn-147780","text":"Checkout Flow"}]},{"id":"blk-83321","kind":"paragraph","spans":[{"id":"spn-147781","text":"WebHost.Systems uses LemonSqueezy (or equivalent) for subscription billing:"}]},{"id":"blk-83322","kind":"code","language":"text","text":"1. User clicks \"Upgrade\" in dashboard\n2. POST /functions/v1/billing/checkout { tier: \"pro\" }\n3. Edge Function creates LemonSqueezy checkout session\n4. Returns checkout URL -> user completes payment\n5. LemonSqueezy sends 