:"spn-147802","text":"Updates "},{"id":"spn-147803","marks":["code"],"text":"users.subscription_tier"},{"id":"spn-147804","text":" accordingly"}]}],"id":"blk-83341","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-83343","kind":"heading","level":2,"spans":[{"id":"spn-147805","text":"Usage Aggregation"}]},{"id":"blk-83344","kind":"paragraph","spans":[{"id":"spn-147806","text":"Raw "},{"id":"spn-147807","marks":["code"],"text":"metrics_events"},{"id":"spn-147808","text":" are aggregated into "},{"id":"spn-147809","marks":["code"],"text":"billing_usage"},{"id":"spn-147810","text":" by "},{"id":"spn-147811","marks":["code"],"text":"pg_cron"},{"id":"spn-147812","text":":"}]},{"id":"blk-83345","kind":"code","language":"sql","text":"-- billing_usage row per user per month\n{\n  user_id, period_key,\n  total_requests, total_tokens, total_compute_ms,\n  total_cost_usd_estimated,\n  per_runtime_breakdown,  -- JSONB: { cloudflare: {...}, agentcore: {...} }\n  paid, invoice_id\n}"},{"id":"blk-83346","kind":"paragraph","spans":[{"id":"spn-147813","text":"The "},{"id":"spn-147814","marks":["code"],"text":"period_key"},{"id":"spn-147815","text":" format is "},{"id":"spn-147816","marks":["code"],"text":"YYYY-MM"},{"id":"spn-147817","text":". Aggregation is incremental -- new events are summed into the existing row, not recomputed from scratch."}]},{"id":"blk-83347","kind":"heading","level":2,"spans":[{"id":"spn-147818","text":"Retention Policies"}]},{"id":"blk-83348","kind":"paragraph","spans":[{"id":"spn-147819","text":"Log and metrics retention is tier-dependent:"}]},{"head":[{"id":"blk-83350","spans":[{"id":"spn-147820","text":"Tier"}]},{"id":"blk-83351","spans":[{"id":"spn-147821","marks":["code"],"text":"metrics_events"},{"id":"spn-147822","text":" retention"}]}],"id":"blk-83349","kind":"table","rows":[[{"id":"blk-83352","spans":[{"id":"spn-147823","text":"Free"}]},{"id":"blk-83353","spans":[{"id":"spn-147824","text":"3 days"}]}],[{"id":"blk-83354","spans":[{"id":"spn-147825","text":"Starter"}]},{"id":"blk-83355","spans":[{"id":"spn-147826","text":"14 days"}]}],[{"id":"blk-83356","spans":[{"id":"spn-147827","text":"Pro"}]},{"id":"blk-83357","spans":[{"id":"spn-147828","text":"30 days"}]}],[{"id":"blk-83358","spans":[{"id":"spn-147829","text":"Enterprise"}]},{"id":"blk-83359","spans":[{"id":"spn-147830","text":"90+ days"}]}]]},{"id":"blk-83360","kind":"paragraph","spans":[{"id":"spn-147831","text":"A "},{"id":"spn-147832","marks":["code"],"text":"pg_cron"},{"id":"spn-147833","text":" job periodically deletes old "},{"id":"spn-147834","marks":["code"],"text":"metrics_events"},{"id":"spn-147835","text":" rows:"}]},{"id":"blk-83361","kind":"code","language":"sql","text":"DELETE FROM metrics_events\nWHERE timestamp_ms < extract(epoch from (now() - retention_interval(user_id))) * 1000;"},{"id":"blk-83362","kind":"paragraph","spans":[{"id":"spn-147836","marks":["code"],"text":"billing_usage"},{"id":"spn-147837","text":" aggregated rows are retained indefinitely."}]},{"id":"blk-83363","kind":"heading","level":2,"spans":[{"id":"spn-147838","text":"Overage Handling (Post-MVP)"}]},{"id":"blk-83364","kind":"paragraph","spans":[{"id":"spn-147839","text":"MVP uses "},{"id":"spn-147840","marks":["bold"],"text":"hard stop"},{"id":"spn-147841","text":" -- invocations are rejected when limits are exceeded."}]},{"id":"blk-83365","kind":"paragraph","spans":[{"id":"spn-147842","text":"Post-MVP options:"}]},{"id":"blk-83366","items":[{"blocks":[{"id":"blk-83368","kind":"paragraph","spans":[{"id":"spn-147843","marks":["bold"],"text":"Pay-as-you-go:"},{"id":"spn-147844","text":" Allow overages at a per-unit rate, billed at period end."}]}],"id":"blk-83367","kind":"list-item"},{"blocks":[{"id":"blk-83370","kind":"paragraph","spans":[{"id":"spn-147845","marks":["bold"],"text":"Soft limits:"},{"id":"spn-147846","text":" Warn users at 80% and 100%, hard stop at 120%."}]}],"id":"blk-83369","kind":"list-item"},{"blocks":[{"id":"blk-83372","kind":"paragra