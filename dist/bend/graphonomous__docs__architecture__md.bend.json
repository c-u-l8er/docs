eline"}]},{"id":"blk-72648","kind":"paragraph","spans":[{"id":"spn-134948","marks":["code"],"text":"Retriever"},{"id":"spn-134949","text":" executes a multi-step pipeline:"}]},{"id":"blk-72649","items":[{"blocks":[{"id":"blk-72651","kind":"paragraph","spans":[{"id":"spn-134950","text":"Semantic similarity search (seed candidates)"}]}],"id":"blk-72650","kind":"list-item"},{"blocks":[{"id":"blk-72653","kind":"paragraph","spans":[{"id":"spn-134951","text":"Graph neighborhood expansion (bounded hops)"}]}],"id":"blk-72652","kind":"list-item"},{"blocks":[{"id":"blk-72655","kind":"paragraph","spans":[{"id":"spn-134952","text":"Confidence-aware ranking"}]}],"id":"blk-72654","kind":"list-item"},{"blocks":[{"id":"blk-72657","kind":"paragraph","spans":[{"id":"spn-134953","text":"Topology analysis over the retrieved subgraph"}]}],"id":"blk-72656","kind":"list-item"},{"blocks":[{"id":"blk-72659","kind":"paragraph","spans":[{"id":"spn-134954","text":"Return context with:"}]}],"id":"blk-72658","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-72660","items":[{"blocks":[{"id":"blk-72662","kind":"paragraph","spans":[{"id":"spn-134955","text":"ranked results"}]}],"id":"blk-72661","kind":"list-item"},{"blocks":[{"id":"blk-72664","kind":"paragraph","spans":[{"id":"spn-134956","text":"causal context IDs"}]}],"id":"blk-72663","kind":"list-item"},{"blocks":[{"id":"blk-72666","kind":"paragraph","spans":[{"id":"spn-134957","text":"topology routing hint ("},{"id":"spn-134958","marks":["code"],"text":"fast"},{"id":"spn-134959","text":" or "},{"id":"spn-134960","marks":["code"],"text":"deliberate"},{"id":"spn-134961","text":")"}]}],"id":"blk-72665","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72667","kind":"paragraph","spans":[{"id":"spn-134962","text":"This provides both relevant memory and structural signal for downstream reasoning."}]},{"id":"blk-72668","kind":"heading","level":2,"spans":[{"id":"spn-134963","text":"Topology and Deliberation"}]},{"id":"blk-72669","kind":"paragraph","spans":[{"id":"spn-134964","text":"Graphonomous computes SCC/topology properties and a κ-style complexity signal to identify cyclic reasoning regions."}]},{"id":"blk-72670","items":[{"blocks":[{"id":"blk-72672","kind":"paragraph","spans":[{"id":"spn-134965","marks":["bold"],"text":"`fast` routing"},{"id":"spn-134966","text":": low cycle complexity, proceed with normal retrieval flow"}]}],"id":"blk-72671","kind":"list-item"},{"blocks":[{"id":"blk-72674","kind":"paragraph","spans":[{"id":"spn-134967","marks":["bold"],"text":"`deliberate` routing"},{"id":"spn-134968","text":": cyclic/entangled subgraph, invoke deeper structured deliberation"}]}],"id":"blk-72673","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72675","kind":"paragraph","spans":[{"id":"spn-134969","marks":["code"],"text":"Deliberator"},{"id":"spn-134970","text":" can decompose cyclic regions, analyze fault-line edges, reconcile conclusions, and optionally write conclusions back into the graph."}]},{"id":"blk-72676","kind":"heading","level":2,"spans":[{"id":"spn-134971","text":"Learning Loop"}]},{"id":"blk-72677","kind":"paragraph","spans":[{"id":"spn-134972","marks":["code"],"text":"Learner"},{"id":"spn-134973","text":" closes the causal feedback loop:"}]},{"id":"blk-72678","items":[{"blocks":[{"id":"blk-72680","kind":"paragraph","spans":[{"id":"spn-134974","text":"Persist action outcome"}]}],"id":"blk-72679","kind":"list-item"},{"blocks":[{"id":"blk-72682","kind":"paragraph","spans":[{"id":"spn-134975","text":"Update confidence on causal source nodes"}]}],"id":"blk-72681","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-72683","kind":"paragraph","spans":[{"id":"spn-134976","text":"Status signals include:"}]},{"id":"blk-72684","items":[{"blocks":[{"id":"blk-72686","kind":"paragraph","spans":[{"id":"spn-134977","marks":["code"],"text":"success"}]}],"id":"blk-72685","kind":"list-item"},{"blocks":[{"id":"blk-72688","kind":"paragraph","spans":[{"id":"spn-1349