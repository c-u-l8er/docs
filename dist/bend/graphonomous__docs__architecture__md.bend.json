{"bendscript":"0.1","blocks":[{"id":"blk-40789","kind":"heading","level":1,"spans":[{"id":"spn-45414","text":"Graphonomous Architecture"}]},{"id":"blk-40790","kind":"paragraph","spans":[{"id":"spn-45415","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-40791","kind":"paragraph","spans":[{"id":"spn-45416","text":"---"}]},{"id":"blk-40792","kind":"heading","level":2,"spans":[{"id":"spn-45417","text":"System Overview"}]},{"id":"blk-40793","kind":"paragraph","spans":[{"id":"spn-45418","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-40794","items":[{"blocks":[{"id":"blk-40796","kind":"paragraph","spans":[{"id":"spn-45419","marks":["bold"],"text":"Store"},{"id":"spn-45420","text":": durable persistence and hot cache"}]}],"id":"blk-40795","kind":"list-item"},{"blocks":[{"id":"blk-40798","kind":"paragraph","spans":[{"id":"spn-45421","marks":["bold"],"text":"Embedder"},{"id":"spn-45422","text":": embedding generation backend"}]}],"id":"blk-40797","kind":"list-item"},{"blocks":[{"id":"blk-40800","kind":"paragraph","spans":[{"id":"spn-45423","marks":["bold"],"text":"Graph"},{"id":"spn-45424","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-40799","kind":"list-item"},{"blocks":[{"id":"blk-40802","kind":"paragraph","spans":[{"id":"spn-45425","marks":["bold"],"text":"Retriever"},{"id":"spn-45426","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-40801","kind":"list-item"},{"blocks":[{"id":"blk-40804","kind":"paragraph","spans":[{"id":"spn-45427","marks":["bold"],"text":"Learner"},{"id":"spn-45428","text":": outcome ingestion and confidence updates"}]}],"id":"blk-40803","kind":"list-item"},{"blocks":[{"id":"blk-40806","kind":"paragraph","spans":[{