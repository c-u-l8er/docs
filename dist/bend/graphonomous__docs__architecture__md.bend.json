code"],"text":"causes"},{"id":"spn-95334","text":", "},{"id":"spn-95335","marks":["code"],"text":"resolves"},{"id":"spn-95336","text":" — causal attribution"}]}],"id":"blk-65126","kind":"list-item"},{"blocks":[{"id":"blk-65129","kind":"paragraph","spans":[{"id":"spn-95337","marks":["code"],"text":"supports"},{"id":"spn-95338","text":", "},{"id":"spn-95339","marks":["code"],"text":"contradicts"},{"id":"spn-95340","text":" — evidential"}]}],"id":"blk-65128","kind":"list-item"},{"blocks":[{"id":"blk-65131","kind":"paragraph","spans":[{"id":"spn-95341","marks":["code"],"text":"related_to"},{"id":"spn-95342","text":", "},{"id":"spn-95343","marks":["code"],"text":"similar_to"},{"id":"spn-95344","text":" — topical affinity"}]}],"id":"blk-65130","kind":"list-item"},{"blocks":[{"id":"blk-65133","kind":"paragraph","spans":[{"id":"spn-95345","marks":["code"],"text":"part_of"},{"id":"spn-95346","text":", "},{"id":"spn-95347","marks":["code"],"text":"follows"},{"id":"spn-95348","text":", "},{"id":"spn-95349","marks":["code"],"text":"supersedes"},{"id":"spn-95350","text":", "},{"id":"spn-95351","marks":["code"],"text":"depends_on"},{"id":"spn-95352","text":" — structural"}]}],"id":"blk-65132","kind":"list-item"},{"blocks":[{"id":"blk-65135","kind":"paragraph","spans":[{"id":"spn-95353","marks":["code"],"text":"temporal_before"},{"id":"spn-95354","text":", "},{"id":"spn-95355","marks":["code"],"text":"temporal_after"},{"id":"spn-95356","text":", "},{"id":"spn-95357","marks":["code"],"text":"co_occurs"},{"id":"spn-95358","text":" — temporal ordering"}]}],"id":"blk-65134","kind":"list-item"},{"blocks":[{"id":"blk-65137","kind":"paragraph","spans":[{"id":"spn-95359","marks":["code"],"text":"derived_from"},{"id":"spn-95360","text":" — provenance"}]}],"id":"blk-65136","kind":"list-item"},{"blocks":[{"id":"blk-65139","kind":"paragraph","spans":[{"id":"spn-95361","text":"Legacy aliases: "},{"id":"spn-95362","marks":["code"],"text":"causal"},{"id":"spn-95363","text":", "},{"id":"spn-95364","marks":["code"],"text":"related"},{"id":"spn-95365","text":" (backward-compatible)"}]}],"id":"blk-65138","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65140","kind":"paragraph","spans":[{"id":"spn-95366","text":"Each edge carries a weight ("},{"id":"spn-95367","marks":["code"],"text":"0.0..1.0"},{"id":"spn-95368","text":", default 0.3), optional "},{"id":"spn-95369","marks":["code"],"text":"co_activation_count"},{"id":"spn-95370","text":", and "},{"id":"spn-95371","marks":["code"],"text":"decay_rate"},{"id":"spn-95372","text":"."}]},{"id":"blk-65141","kind":"heading","level":2,"spans":[{"id":"spn-95373","text":"Persistence Layer"}]},{"id":"blk-65142","kind":"paragraph","spans":[{"id":"spn-95374","marks":["code"],"text":"Store"},{"id":"spn-95375","text":" provides:"}]},{"id":"blk-65143","items":[{"blocks":[{"id":"blk-65145","kind":"paragraph","spans":[{"id":"spn-95376","marks":["bold"],"text":"SQLite durability"},{"id":"spn-95377","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-65144","kind":"list-item"},{"blocks":[{"id":"blk-65147","kind":"paragraph","spans":[{"id":"spn-95378","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-95379","text":" for low-latency reads"}]}],"id":"blk-65146","kind":"list-item"},{"blocks":[{"id":"blk-65149","kind":"paragraph","spans":[{"id":"spn-95380","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-65148","kind":"list-item"},{"blocks":[{"id":"blk-65151","kind":"paragraph","spans":[{"id":"spn-95381","text":"cache warm-up from durable state after boot"}]}],"id":"blk-65150","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65152","kind":"paragraph","spans":[{"id":"spn-95382","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-65153","kind":"heading","level":2,"spans":[{"id":"spn-95383","text":"Retrieval Pipeline"}]},{"id":"blk-65154","kind":"paragraph","spans":[{"id":"spn-95384","marks":["code"],"text":"