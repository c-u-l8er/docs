on"}]},{"id":"blk-72729","kind":"paragraph","spans":[{"id":"spn-135009","marks":["code"],"text":"Consolidator"},{"id":"spn-135010","text":" runs periodic maintenance to protect graph quality over time:"}]},{"id":"blk-72730","items":[{"blocks":[{"id":"blk-72732","kind":"paragraph","spans":[{"id":"spn-135011","text":"Confidence decay"}]}],"id":"blk-72731","kind":"list-item"},{"blocks":[{"id":"blk-72734","kind":"paragraph","spans":[{"id":"spn-135012","text":"Prune weak nodes"}]}],"id":"blk-72733","kind":"list-item"},{"blocks":[{"id":"blk-72736","kind":"paragraph","spans":[{"id":"spn-135013","text":"Prune weak edges"}]}],"id":"blk-72735","kind":"list-item"},{"blocks":[{"id":"blk-72738","kind":"paragraph","spans":[{"id":"spn-135014","text":"Strengthen co-activated edges"}]}],"id":"blk-72737","kind":"list-item"},{"blocks":[{"id":"blk-72740","kind":"paragraph","spans":[{"id":"spn-135015","text":"Merge similar nodes"}]}],"id":"blk-72739","kind":"list-item"},{"blocks":[{"id":"blk-72742","kind":"paragraph","spans":[{"id":"spn-135016","text":"Promote timescale (fast → medium → slow → glacial)"}]}],"id":"blk-72741","kind":"list-item"},{"blocks":[{"id":"blk-72744","kind":"paragraph","spans":[{"id":"spn-135017","text":"Generate abstractions from episodic clusters"}]}],"id":"blk-72743","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-72745","kind":"paragraph","spans":[{"id":"spn-135018","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-72746","kind":"heading","level":2,"spans":[{"id":"spn-135019","text":"MCP Surface"}]},{"id":"blk-72747","kind":"paragraph","spans":[{"id":"spn-135020","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-72748","items":[{"blocks":[{"id":"blk-72750","kind":"paragraph","spans":[{"id":"spn-135021","text":"storing memory"}]}],"id":"blk-72749","kind":"list-item"},{"blocks":[{"id":"blk-72752","kind":"paragraph","spans":[{"id":"spn-135022","text":"querying/retrieving cont