],"id":"blk-40848","kind":"list-item"},{"blocks":[{"id":"blk-40851","kind":"paragraph","spans":[{"id":"spn-45493","text":"Legacy aliases: "},{"id":"spn-45494","marks":["code"],"text":"causal"},{"id":"spn-45495","text":", "},{"id":"spn-45496","marks":["code"],"text":"related"},{"id":"spn-45497","text":" (backward-compatible)"}]}],"id":"blk-40850","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40852","kind":"paragraph","spans":[{"id":"spn-45498","text":"Each edge carries a weight ("},{"id":"spn-45499","marks":["code"],"text":"0.0..1.0"},{"id":"spn-45500","text":", default 0.3), optional "},{"id":"spn-45501","marks":["code"],"text":"co_activation_count"},{"id":"spn-45502","text":", and "},{"id":"spn-45503","marks":["code"],"text":"decay_rate"},{"id":"spn-45504","text":"."}]},{"id":"blk-40853","kind":"paragraph","spans":[{"id":"spn-45505","text":"---"}]},{"id":"blk-40854","kind":"heading","level":2,"spans":[{"id":"spn-45506","text":"Persistence Layer"}]},{"id":"blk-40855","kind":"paragraph","spans":[{"id":"spn-45507","marks":["code"],"text":"Store"},{"id":"spn-45508","text":" provides:"}]},{"id":"blk-40856","items":[{"blocks":[{"id":"blk-40858","kind":"paragraph","spans":[{"id":"spn-45509","marks":["bold"],"text":"SQLite durability"},{"id":"spn-45510","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-40857","kind":"list-item"},{"blocks":[{"id":"blk-40860","kind":"paragraph","spans":[{"id":"spn-45511","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-45512","text":" for low-latency reads"}]}],"id":"blk-40859","kind":"list-item"},{"blocks":[{"id":"blk-40862","kind":"paragraph","spans":[{"id":"spn-45513","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-40861","kind":"list-item"},{"blocks":[{"id":"blk-40864","kind":"paragraph","spans":[{"id":"spn-45514","text":"cache warm-up from durable state after boot"}]}],"id":"blk-40863","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40865","kind":"paragraph","spans":[{"id":"spn-45515","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-40866","kind":"paragraph","spans":[{"id":"spn-45516","text":"---"}]},{"id":"blk-40867","kind":"heading","level":2,"spans":[{"id":"spn-45517","text":"Retrieval Pipeline"}]},{"id":"blk-40868","kind":"paragraph","spans":[{"id":"spn-45518","marks":["code"],"text":"Retriever"},{"id":"spn-45519","text":" executes a multi-step pipeline:"}]},{"id":"blk-40869","kind":"paragraph","spans":[{"id":"spn-45520","text":"1. Semantic similarity search (seed candidates) 2. Graph neighborhood expansion (bounded hops) 3. Confidence-aware ranking 4. Topology analysis over the retrieved subgraph 5. Return context with:"}]},{"id":"blk-40870","items":[{"blocks":[{"id":"blk-40872","kind":"paragraph","spans":[{"id":"spn-45521","text":"ranked results"}]}],"id":"blk-40871","kind":"list-item"},{"blocks":[{"id":"blk-40874","kind":"paragraph","spans":[{"id":"spn-45522","text":"causal context IDs"}]}],"id":"blk-40873","kind":"list-item"},{"blocks":[{"id":"blk-40876","kind":"paragraph","spans":[{"id":"spn-45523","text":"topology routing hint ("},{"id":"spn-45524","marks":["code"],"text":"fast"},{"id":"spn-45525","text":" or "},{"id":"spn-45526","marks":["code"],"text":"deliberate"},{"id":"spn-45527","text":")"}]}],"id":"blk-40875","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40877","kind":"paragraph","spans":[{"id":"spn-45528","text":"This provides both relevant memory and structural signal for downstream reasoning."}]},{"id":"blk-40878","kind":"paragraph","spans":[{"id":"spn-45529","text":"---"}]},{"id":"blk-40879","kind":"heading","level":2,"spans":[{"id":"spn-45530","text":"Topology and Deliberation"}]},{"id":"blk-40880","kind":"paragraph","spans":[{"id":"spn-45531","text":"Graphonomous computes SCC/topology properties and a κ-style complexity signal to identify cyclic reasoning regions."}]},{"id":"blk-40881","items":[{"blocks":[{"id":"blk-40883","kind":"paragraph","spans":[{"id":"spn-45532","marks":["bold"],"text":"`fast` routing"},{"id":"spn-45533","text":": low cycle complexity, proceed with normal retrieval flow"}]}],"id":"blk-40882","kind":"list-item"},{"blocks":[{"id":"blk-40885","kind":"paragraph","spans":[{"id":"spn-45534","marks":["bold"],"text":"`deliberate` routing"},{"id":"spn-45535","text":": cyclic/entangled subgraph, invoke deeper structured deliberation"}]}],"id":"blk-40884","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40886","kind":"paragraph","spans":[{"id":"spn-45536","marks":["code"],"text":"Deliberator"},{"id":"spn-45537","text":" can decompose cyclic regions, analyze fault-line edges, reconcile conclusions, and optionally write conclusions back into the graph."}]},{"id":"blk-40887","kind":"paragraph","spans":[{"id":"spn-45538","text":"---"}]},{"id":"blk-40888","kind":"heading","level":2,"spans":[{"id":"spn-45539","text":"Learning Loop"}]},{"id":"blk-40889","kind":"paragraph","spans":[{"id":"spn-45540","marks":["code"],"text":"Learner"},{"id":"spn-45541","text":" closes the causal feedback loop:"}]},{"id":"blk-40890","kind":"paragraph","spans":[{"id":"spn-45542","text":"1. Persist action outcome 2. Update confidence on causal source nodes"}]},{"id":"blk-40891","kind":"paragraph","spans":[{"id":"spn-45543","text":"Status signals include:"}]},{"id":"blk-40892","items":[{"blocks":[{"id":"blk-40894","kind":"paragraph","spans":[{"id":"spn-45544","marks":["code"],"text":"success"}]}],"id":"blk-40893","kind":"list-item"},{"blocks":[{"id":"blk-40896","kind":"paragraph","spans":[{"id":"spn-45545","marks":["code"],"text":"partial_success"}]}],"id":"blk-40895","kind":"list-item"},{"blocks":[{"id":"blk-40898","kind":"paragraph","spans":[{"id":"spn-45546","marks":["code"],"text":"failure"}]}],"id":"blk-40897","kind":"list-item"},{"blocks":[{"id":"blk-40900","kind":"paragraph","spans":[{"id":"spn-45547","marks":["code"],"text":"timeout"}]}],"id":"blk-40899","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40901","kind":"paragraph","spans":[{"id":"spn-45548","text":"Confidence updates are blended with a learning-rate rule, so the graph continuously calibrates itself over real outcomes instead of static assumptions."}]},{"id":"blk-40902","kind":"paragraph","spans":[{"id":"spn-45549","text":"---"}]},{"id":"blk-40903","kind":"heading","level":2,"spans":[{"id":"spn-45550","text":"Goal and Epistemic Control Plane"}]},{"id":"blk-40904","kind":"heading","level":3,"spans":[{"id":"spn-45551","text":"GoalGraph"}]},{"id":"blk-40905","kind":"paragraph","spans":[{"id":"spn-45552","text":"Durable multi-step intent with lifecycle states such as:"}]},{"id":"blk-40906","items":[{"blocks":[{"id":"blk-40908","kind":"paragraph","spans":[{"id":"spn-45553","marks":["code"],"text":"proposed"}]}],"id":"blk-40907","kind":"list-item"},{"blocks":[{"id":"blk-40910","kind":"paragraph","spans":[{"id":"spn-45554","marks":["code"],"text":"active"}]}],"id":"blk-40909","kind":"list-item"},{"blocks":[{"id":"blk-40912","kind":"paragraph","spans":[{"id":"spn-45555","marks":["code"],"text":"blocked"}]}],"id":"blk-40911","kind":"list-item"},{"blocks":[{"id":"blk-40914","kind":"paragraph","spans":[{"id":"spn-45556","marks":["code"],"text":"completed"}]}],"id":"blk-40913","kind":"list-item"},{"blocks":[{"id":"blk-40916","kind":"paragraph","spans":[{"id":"spn-45557","marks":["code"],"text":"abandoned"}]}],"id":"blk-40915","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40917","kind":"paragraph","spans":[{"id":"spn-45558","text":"Goals can link to supporting node IDs, track progress, and persist across sessions."}]},{"id":"blk-40918","kind":"heading","level":3,"spans":[{"id":"spn-45559","text":"Coverage"}]},{"id":"blk-40919","kind":"paragraph","spans":[{"id":"spn-45560","text":"Before high-impact actions, Graphonomous can score epistemic readiness:"}]},{"id":"blk-40920","items":[{"blocks":[{"id":"blk-40922","kind":"paragraph","spans":[{"id":"spn-45561","marks":["code"],"text":"coverage_score"}]}],"id":"blk-40921","kind":"list-item"},{"blocks":[{"id":"blk-40924","kind":"paragraph","spans":[{"id":"spn-45562","marks":["code"],"text":"uncertainty_score"}]}],"id":"blk-40923","kind":"list-item"},{"blocks":[{"id":"blk-40926","kind":"paragraph","spans":[{"id":"spn-45563","marks":["code"],"text":"risk_score"}]}],"id":"blk-40925","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40927","kind":"paragraph","spans":[{"id":"spn-45564","text":"Decision output:"}]},{"id":"blk-40928","items":[{"blocks":[{"id":"blk-40930","kind":"paragraph","spans":[{"id":"spn-45565","marks":["bold"],"text":"act"}]}],"id":"blk-40929","kind":"list-item"},{"blocks":[{"id":"blk-40932","kind":"paragraph","spans":[{"id":"spn-45566","marks":["bold"],"text":"learn"}]}],"id":"blk-40931","kind":"list-item"},{"blocks":[{"id":"blk-40934","kind":"paragraph","spans":[{"id":"spn-45567","marks":["bold"],"text":"escalate"}]}],"id":"blk-40933","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40935","kind":"heading","level":3,"spans":[{"id":"spn-45568","text":"Attention"}]},{"id":"blk-40936","kind":"paragraph","spans":[{"id":"spn-45569","text":"Attention continuously ranks work across goals using urgency, coverage gaps, and topology signals; it supports "},{"id":"spn-45570","marks":["code"],"text":"observe"},{"id":"spn-45571","text":", "},{"id":"spn-45572","marks":["code"],"text":"advise"},{"id":"spn-45573","text":", and "},{"id":"spn-45574","marks":["code"],"text":"act"},{"id":"spn-45575","text":" autonomy levels."}]},{"id":"blk-40937","kind":"paragraph","spans":[{"id":"spn-45576","text":"---"}]},{"id":"blk-40938","kind":"heading","level":2,"spans":[{"id":"spn-45577","text":"Consolidation"}]},{"id":"blk-40939","kind":"paragraph","spans":[{"id":"spn-45578","marks":["code"],"text":"Consolidator"},{"id":"spn-45579","text":" runs periodic maintenance to protect graph quality over time:"}]},{"id":"blk-40940","kind":"paragraph","spans":[{"id":"s