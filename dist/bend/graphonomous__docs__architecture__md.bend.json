{"bendscript":"0.1","blocks":[{"id":"blk-72574","kind":"heading","level":1,"spans":[{"id":"spn-134849","text":"Graphonomous Architecture"}]},{"id":"blk-72575","kind":"paragraph","spans":[{"id":"spn-134850","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-72576","kind":"heading","level":2,"spans":[{"id":"spn-134851","text":"System Overview"}]},{"id":"blk-72577","kind":"paragraph","spans":[{"id":"spn-134852","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-72578","items":[{"blocks":[{"id":"blk-72580","kind":"paragraph","spans":[{"id":"spn-134853","marks":["bold"],"text":"Store"},{"id":"spn-134854","text":": durable persistence and hot cache"}]}],"id":"blk-72579","kind":"list-item"},{"blocks":[{"id":"blk-72582","kind":"paragraph","spans":[{"id":"spn-134855","marks":["bold"],"text":"Embedder"},{"id":"spn-134856","text":": embedding generation backend"}]}],"id":"blk-72581","kind":"list-item"},{"blocks":[{"id":"blk-72584","kind":"paragraph","spans":[{"id":"spn-134857","marks":["bold"],"text":"Graph"},{"id":"spn-134858","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-72583","kind":"list-item"},{"blocks":[{"id":"blk-72586","kind":"paragraph","spans":[{"id":"spn-134859","marks":["bold"],"text":"Retriever"},{"id":"spn-134860","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-72585","kind":"list-item"},{"blocks":[{"id":"blk-72588","kind":"paragraph","spans":[{"id":"spn-134861","marks":["bold"],"text":"Learner"},{"id":"spn-134862","text":": outcome ingestion and confidence updates"}]}],"id":"blk-72587","kind":"list-item"},{"blocks":[{"id":"blk-72590","kind":"paragraph","spans":[{"id":"spn-134863","marks":["bold"],"text":"GoalGraph"},{"id":"spn-134864","text":": durable goal lifecycle management"}]}],"id":"blk-72589","kind":"list-item"},{"blocks":[{"id":"blk-72592","kind":"paragraph","spans":[{"id":"spn-134865","marks":["bold"],"text":"Coverage"},{"id":"spn-134866","text":": epistemic scoring ("},{"id":"spn-134867","marks":["code"],"text":"act"},{"id":"spn-134868","text":" / "},{"id":"spn-134869","marks":["code"],"text":"learn"},{"id":"spn-134870","text":" / "},{"id":"spn-134871","marks":["code"],"text":"escalate"},{"id":"spn-134872","text":")"}]}],"id":"blk-72591","kind":"list-item"},{"blocks":[{"id":"blk-72594","kind":"paragraph","spans":[{"id":"spn-134873","marks":["bold"],"text":"Attention"},{"id":"spn-134874","text":": proactive goal prioritization loop"}]}],"id":"blk-72593","kind":"list-item"},{"blocks":[{"id":"blk-72596","kind":"paragraph","spans":[{"id":"spn-134875","marks":["bold"],"text":"Consolidator"},{"id":"spn-134876","text":": periodic memory maintenance"}]}],"id":"blk-72595","kind":"list-item"},{"blocks":[{"id":"blk-72598","kind":"paragraph","spans":[{"id":"spn-134877","marks":["bold"],"text":"MCP Server"},{"id":"spn-134878","text":": tool/resource interface for external agents"}]}],"id":"blk-72597","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72599","kind":"heading","level":2,"spans":[{"id":"spn-134879","text":"Runtime Topology (Conceptual)"}]},{"id":"blk-72600","kind":"code","language":"text","text":"Agent / Client (MCP)\n        |\n        v\n+-------------------------+\n| Graphonomous MCP Server |\n+-------------------------+\n   |      |         |\n   |      |         +--> Goal / Coverage / Attention\n   |      |\n   |      +-------------> Retriever / Deliberator / Topology\n   |\n   +---------------------> Graph <-> Store <-> SQLite + ETS\n                                \\\n                                 +-> Embedder\n\nLearner <------------------ Outcomes (causal feedback)\nConsolidator -----------> Decay / prune / maintain cycles"},{"id":"blk-72601","kind":"head