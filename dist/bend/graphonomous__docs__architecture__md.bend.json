","marks":["code"],"text":"related"},{"id":"spn-95418","text":" (backward-compatible)"}]}],"id":"blk-65149","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65151","kind":"paragraph","spans":[{"id":"spn-95419","text":"Each edge carries a weight ("},{"id":"spn-95420","marks":["code"],"text":"0.0..1.0"},{"id":"spn-95421","text":", default 0.3), optional "},{"id":"spn-95422","marks":["code"],"text":"co_activation_count"},{"id":"spn-95423","text":", and "},{"id":"spn-95424","marks":["code"],"text":"decay_rate"},{"id":"spn-95425","text":"."}]},{"id":"blk-65152","kind":"heading","level":2,"spans":[{"id":"spn-95426","text":"Persistence Layer"}]},{"id":"blk-65153","kind":"paragraph","spans":[{"id":"spn-95427","marks":["code"],"text":"Store"},{"id":"spn-95428","text":" provides:"}]},{"id":"blk-65154","items":[{"blocks":[{"id":"blk-65156","kind":"paragraph","spans":[{"id":"spn-95429","marks":["bold"],"text":"SQLite durability"},{"id":"spn-95430","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-65155","kind":"list-item"},{"blocks":[{"id":"blk-65158","kind":"paragraph","spans":[{"id":"spn-95431","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-95432","text":" for low-latency reads"}]}],"id":"blk-65157","kind":"list-item"},{"blocks":[{"id":"blk-65160","kind":"paragraph","spans":[{"id":"spn-95433","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-65159","kind":"list-item"},{"blocks":[{"id":"blk-65162","kind":"paragraph","spans":[{"id":"spn-95434","text":"cache warm-up from durable state after boot"}]}],"id":"blk-65161","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65163","kind":"paragraph","spans":[{"id":"spn-95435","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-65164","kind":"heading","level":2,"spans":[{"id":"spn-95436","text":"Retrieval Pipeline"}]},{"id":"blk-65165","kind":"paragraph","spans":[{"id":"spn-95437","marks":["code"],"text":"