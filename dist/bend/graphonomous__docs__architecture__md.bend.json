{"bendscript":"0.1","blocks":[{"id":"blk-65091","kind":"heading","level":1,"spans":[{"id":"spn-95338","text":"Graphonomous Architecture"}]},{"id":"blk-65092","kind":"paragraph","spans":[{"id":"spn-95339","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-65093","kind":"heading","level":2,"spans":[{"id":"spn-95340","text":"System Overview"}]},{"id":"blk-65094","kind":"paragraph","spans":[{"id":"spn-95341","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-65095","items":[{"blocks":[{"id":"blk-65097","kind":"paragraph","spans":[{"id":"spn-95342","marks":["bold"],"text":"Store"},{"id":"spn-95343","text":": durable persistence and hot cache"}]}],"id":"blk-65096","kind":"list-item"},{"blocks":[{"id":"blk-65099","kind":"paragraph","spans":[{"id":"spn-95344","marks":["bold"],"text":"Embedder"},{"id":"spn-95345","text":": embedding generation backend"}]}],"id":"blk-65098","kind":"list-item"},{"blocks":[{"id":"blk-65101","kind":"paragraph","spans":[{"id":"spn-95346","marks":["bold"],"text":"Graph"},{"id":"spn-95347","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-65100","kind":"list-item"},{"blocks":[{"id":"blk-65103","kind":"paragraph","spans":[{"id":"spn-95348","marks":["bold"],"text":"Retriever"},{"id":"spn-95349","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-65102","kind":"list-item"},{"blocks":[{"id":"blk-65105","kind":"paragraph","spans":[{"id":"spn-95350","marks":["bold"],"text":"Learner"},{"id":"spn-95351","text":": outcome ingestion and confidence updates"}]}],"id":"blk-65104","kind":"list-item"},{"blocks":[{"id":"blk-65107","kind":"paragraph","spans":[{"id":"spn-95352","marks":["bold"],"text":"GoalGraph"},{"id":"spn-95353","text":": durable goal lifecycle management"}]}],"id":"blk-65106","kind":"list-item"},{"blocks":[{"id":"blk-65109","kind":"paragraph","spans":[{"id":"spn-95354","marks":["bold"],"text":"Coverage"},{"id":"spn-95355","text":": epistemic scoring ("},{"id":"spn-95356","marks":["code"],"text":"act"},{"id":"spn-95357","text":" / "},{"id":"spn-95358","marks":["code"],"text":"learn"},{"id":"spn-95359","text":" / "},{"id":"spn-95360","marks":["code"],"text":"escalate"},{"id":"spn-95361","text":")"}]}],"id":"blk-65108","kind":"list-item"},{"blocks":[{"id":"blk-65111","kind":"paragraph","spans":[{"id":"spn-95362","marks":["bold"],"text":"Attention"},{"id":"spn-95363","text":": proactive goal prioritization loop"}]}],"id":"blk-65110","kind":"list-item"},{"blocks":[{"id":"blk-65113","kind":"paragraph","spans":[{"id":"spn-95364","marks":["bold"],"text":"Consolidator"},{"id":"spn-95365","text":": periodic memory maintenance"}]}],"id":"blk-65112","kind":"list-item"},{"blocks":[{"id":"blk-65115","kind":"paragraph","spans":[{"id":"spn-95366","marks":["bold"],"text":"MCP Server"},{"id":"spn-95367","text":": tool/resource interface for external agents"}]}],"id":"blk-65114","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65116","kind":"heading","level":2,"spans":[{"id":"spn-95368","text":"Runtime Topology (Conceptual)"}]},{"id":"blk-65117","kind":"code","language":"text","text":"Agent / Client (MCP)\n        |\n        v\n+-------------------------+\n| Graphonomous MCP Server |\n+-------------------------+\n   |      |         |\n   |      |         +--> Goal / Coverage / Attention\n   |      |\n   |      +-------------> Retriever / Deliberator / Topology\n   |\n   +---------------------> Graph <-> Store <-> SQLite + ETS\n                                \\\n                                 +-> Embedder\n\nLearner <------------------ Outcomes (causal feedback)\nConsolidator -----------> Decay / prune / maintain cycles"},{"id":"blk-65118","kind":"heading","level":2,"spans":[{"id":"