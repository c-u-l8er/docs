nce to protect graph quality over time:"}]},{"id":"blk-65236","items":[{"blocks":[{"id":"blk-65238","kind":"paragraph","spans":[{"id":"spn-95447","text":"Confidence decay"}]}],"id":"blk-65237","kind":"list-item"},{"blocks":[{"id":"blk-65240","kind":"paragraph","spans":[{"id":"spn-95448","text":"Prune weak nodes"}]}],"id":"blk-65239","kind":"list-item"},{"blocks":[{"id":"blk-65242","kind":"paragraph","spans":[{"id":"spn-95449","text":"Prune weak edges"}]}],"id":"blk-65241","kind":"list-item"},{"blocks":[{"id":"blk-65244","kind":"paragraph","spans":[{"id":"spn-95450","text":"Strengthen co-activated edges"}]}],"id":"blk-65243","kind":"list-item"},{"blocks":[{"id":"blk-65246","kind":"paragraph","spans":[{"id":"spn-95451","text":"Merge similar nodes"}]}],"id":"blk-65245","kind":"list-item"},{"blocks":[{"id":"blk-65248","kind":"paragraph","spans":[{"id":"spn-95452","text":"Promote timescale (fast → medium → slow → glacial)"}]}],"id":"blk-65247","kind":"list-item"},{"blocks":[{"id":"blk-65250","kind":"paragraph","spans":[{"id":"spn-95453","text":"Generate abstractions from episodic clusters"}]}],"id":"blk-65249","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65251","kind":"paragraph","spans":[{"id":"spn-95454","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-65252","kind":"heading","level":2,"spans":[{"id":"spn-95455","text":"MCP Surface"}]},{"id":"blk-65253","kind":"paragraph","spans":[{"id":"spn-95456","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-65254","items":[{"blocks":[{"id":"blk-65256","kind":"paragraph","spans":[{"id":"spn-95457","text":"storing memory"}]}],"id":"blk-65255","kind":"list-item"},{"blocks":[{"id":"blk-65258","kind":"paragraph","spans":[{"id":"spn-95458","text":"querying/retrieving context"}]}],"id":"blk-65257","kind":"list-item"},{"blocks":[{"id":"blk-65260","kind":"paragraph","spans":[{"id":"spn-95459","text":"reporting outcomes"}]}],"id":"blk-65259","kin