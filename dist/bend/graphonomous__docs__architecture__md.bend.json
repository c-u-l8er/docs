{"bendscript":"0.1","blocks":[{"id":"blk-41761","kind":"heading","level":1,"spans":[{"id":"spn-47708","text":"Graphonomous Architecture"}]},{"id":"blk-41762","kind":"paragraph","spans":[{"id":"spn-47709","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-41763","kind":"paragraph","spans":[{"id":"spn-47710","text":"---"}]},{"id":"blk-41764","kind":"heading","level":2,"spans":[{"id":"spn-47711","text":"System Overview"}]},{"id":"blk-41765","kind":"paragraph","spans":[{"id":"spn-47712","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-41766","items":[{"blocks":[{"id":"blk-41768","kind":"paragraph","spans":[{"id":"spn-47713","marks":["bold"],"text":"Store"},{"id":"spn-47714","text":": durable persistence and hot cache"}]}],"id":"blk-41767","kind":"list-item"},{"blocks":[{"id":"blk-41770","kind":"paragraph","spans":[{"id":"spn-47715","marks":["bold"],"text":"Embedder"},{"id":"spn-47716","text":": embedding generation backend"}]}],"id":"blk-41769","kind":"list-item"},{"blocks":[{"id":"blk-41772","kind":"paragraph","spans":[{"id":"spn-47717","marks":["bold"],"text":"Graph"},{"id":"spn-47718","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-41771","kind":"list-item"},{"blocks":[{"id":"blk-41774","kind":"paragraph","spans":[{"id":"spn-47719","marks":["bold"],"text":"Retriever"},{"id":"spn-47720","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-41773","kind":"list-item"},{"blocks":[{"id":"blk-41776","kind":"paragraph","spans":[{"id":"spn-47721","marks":["bold"],"text":"Learner"},{"id":"spn-47722","text":": outcome ingestion and confidence updates"}]}],"id":"blk-41775","kind":"list-item"},{"blocks":[{"id":"blk-41778","kind":"paragraph","spans":[{"id":"spn-47723","marks":["bold"],"text":"GoalGraph"},{"id":"spn-47724","text":": durable goal lifecycle management"}]}],"id":"blk-41777","kind":"list-item"},{"blocks":[{"id":"blk-41780","kind":"paragraph","spans":[{"id":"spn-47725","marks":["bold"],"text":"Coverage"},{"id":"spn-47726","text":": epistemic scoring ("},{"id":"spn-47727","marks":["code"],"text":"act"},{"id":"spn-47728","text":" / "},{"id":"spn-47729","marks":["code"],"text":"learn"},{"id":"spn-47730","text":" / "},{"id":"spn-47731","marks":["code"],"text":"escalate"},{"id":"spn-47732","text":")"}]}],"id":"blk-41779","kind":"list-item"},{"blocks":[{"id":"blk-41782","kind":"paragraph","spans":[{"id":"spn-47733","marks":["bold"],"text":"Attention"},{"id":"spn-47734","text":": proactive goal prioritization loop"}]}],"id":"blk-41781","kind":"list-item"},{"blocks":[{"id":"blk-41784","kind":"paragraph","spans":[{"id":"spn-47735","marks":["bold"],"text":"Consolidator"},{"id":"spn-47736","text":": periodic memory maintenance"}]}],"id":"blk-41783","kind":"list-item"},{"blocks":[{"id":"blk-41786","kind":"paragraph","spans":[{"id":"spn-47737","marks":["bold"],"text":"MCP Server"},{"id":"spn-47738","text":": tool/resource interface for external agents"}]}],"id":"blk-41785","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41787","kind":"paragraph","spans":[{"id":"spn-47739","text":"---"}]},{"id":"blk-41788","kind":"heading","level":2,"spans":[{"id":"spn-47740","text":"Runtime Topology (Conceptual)"}]},{"id":"blk-41789","kind":"code","language":"text","text":"Agent / Client (MCP)\n        |\n        v\n+-------------------------+\n| Graphonomous MCP Server |\n+-------------------------+\n   |      |         |\n   |      |         +--> Goal / Coverage / Attention\n   |      |\n   |      +-------------> Retriever / Deliberator / Topology\n   |\n   +---------------------> Graph <-> Store <-> SQLite + ETS\n                                \\\n                                 +-> Embedder\n\nLearner <--------