,"text":"Edge Types"}]},{"id":"blk-41322","kind":"paragraph","spans":[{"id":"spn-46638","text":"Relationship types include:"}]},{"id":"blk-41323","items":[{"blocks":[{"id":"blk-41325","kind":"paragraph","spans":[{"id":"spn-46639","marks":["code"],"text":"causes"},{"id":"spn-46640","text":", "},{"id":"spn-46641","marks":["code"],"text":"resolves"},{"id":"spn-46642","text":" — causal attribution"}]}],"id":"blk-41324","kind":"list-item"},{"blocks":[{"id":"blk-41327","kind":"paragraph","spans":[{"id":"spn-46643","marks":["code"],"text":"supports"},{"id":"spn-46644","text":", "},{"id":"spn-46645","marks":["code"],"text":"contradicts"},{"id":"spn-46646","text":" — evidential"}]}],"id":"blk-41326","kind":"list-item"},{"blocks":[{"id":"blk-41329","kind":"paragraph","spans":[{"id":"spn-46647","marks":["code"],"text":"related_to"},{"id":"spn-46648","text":", "},{"id":"spn-46649","marks":["code"],"text":"similar_to"},{"id":"spn-46650","text":" — topical affinity"}]}],"id":"blk-41328","kind":"list-item"},{"blocks":[{"id":"blk-41331","kind":"paragraph","spans":[{"id":"spn-46651","marks":["code"],"text":"part_of"},{"id":"spn-46652","text":", "},{"id":"spn-46653","marks":["code"],"text":"follows"},{"id":"spn-46654","text":", "},{"id":"spn-46655","marks":["code"],"text":"supersedes"},{"id":"spn-46656","text":", "},{"id":"spn-46657","marks":["code"],"text":"depends_on"},{"id":"spn-46658","text":" — structural"}]}],"id":"blk-41330","kind":"list-item"},{"blocks":[{"id":"blk-41333","kind":"paragraph","spans":[{"id":"spn-46659","marks":["code"],"text":"temporal_before"},{"id":"spn-46660","text":", "},{"id":"spn-46661","marks":["code"],"text":"temporal_after"},{"id":"spn-46662","text":", "},{"id":"spn-46663","marks":["code"],"text":"co_occurs"},{"id":"spn-46664","text":" — temporal ordering"}]}],"id":"blk-41332","kind":"list-item"},{"blocks":[{"id":"blk-41335","kind":"paragraph","spans":[{"id":"spn-46665","marks":["code"],"text":"derived_from"},{"id":"spn-46666","text":" — provenance"}]}],"id":"blk-41334","kind":"list-item"},{"blocks":[{"id":"blk-41337","kind":"paragraph","spans":[{"id":"spn-46667","text":"Legacy aliases: "},{"id":"spn-46668","marks":["code"],"text":"causal"},{"id":"spn-46669","text":", "},{"id":"spn-46670","marks":["code"],"text":"related"},{"id":"spn-46671","text":" (backward-compatible)"}]}],"id":"blk-41336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41338","kind":"paragraph","spans":[{"id":"spn-46672","text":"Each edge carries a weight ("},{"id":"spn-46673","marks":["code"],"text":"0.0..1.0"},{"id":"spn-46674","text":", default 0.3), optional "},{"id":"spn-46675","marks":["code"],"text":"co_activation_count"},{"id":"spn-46676","text":", and "},{"id":"spn-46677","marks":["code"],"text":"decay_rate"},{"id":"spn-46678","text":"."}]},{"id":"blk-41339","kind":"paragraph","spans":[{"id":"spn-46679","text":"---"}]},{"id":"blk-41340","kind":"heading","level":2,"spans":[{"id":"spn-46680","text":"Persistence Layer"}]},{"id":"blk-41341","kind":"paragraph","spans":[{"id":"spn-46681","marks":["code"],"text":"Store"},{"id":"spn-46682","text":" provides:"}]},{"id":"blk-41342","items":[{"blocks":[{"id":"blk-41344","kind":"paragraph","spans":[{"id":"spn-46683","marks":["bold"],"text":"SQLite durability"},{"id":"spn-46684","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-41343","kind":"list-item"},{"blocks":[{"id":"blk-41346","kind":"paragraph","spans":[{"id":"spn-46685","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-46686","text":" for low-latency reads"}]}],"id":"blk-41345","kind":"list-item"},{"blocks":[{"id":"blk-41348","kind":"paragraph","spans":[{"id":"spn-46687","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-41347","kind":"list-item"},{"blocks":[{"id":"blk-41350","kind":"paragraph","spans":[{"id":"spn-46688","text":"cache warm-up from durable state after boot"}]}],"id":"blk-41349","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41351","kind":"paragraph","spans":[{"id":"spn-46689","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-41352","kind":"paragraph","spans":[{"id":"spn-46690","text":"---"}]},{"id":"blk-41353","kind":"heading","level":2,"spans":[{"id":"spn-46691","text":"Retrieval Pipeline"}]},{"id":"blk-41354","kind":"paragraph","spans":[{"id":"spn-46692","marks":["code"],"text":"Retriever"},{"id":"spn-46693","text":" executes a multi-step pipeline:"}]},{"id":"blk-41355","kind":"paragraph","spans":[{"id":"spn-46694","text":"1. Semantic similarity search (seed candidates) 2. Graph neighborhood expansion (bounded hops) 3. Confidence-aware ranking 4. Topology analysis over the retrieved subgraph 5. Return context with:"}]},{"id":"blk-41356","items":[{"blocks":[{"id":"blk-41358","kind":"paragraph","spans":[{"id":"spn-46695","text":"ranked results"}]}],"id":"blk-41357","kind":"list-item"},{"blocks":[{"id":"blk-41360","kind":"paragraph","spans":[{"id":"spn-46696","text":"causal context IDs"}]}],"id":"blk-41359","kind":"list-item"},{"blocks":[{"id":"blk-41362","kind":"paragraph","spans":[{"id":"spn-46697","text":"topology routing hint ("},{"id":"spn-46698","marks":["code"],"text":"fast"},{"id":"spn-46699","text":" or "},{"id":"spn-46700","marks":["code"],"text":"deliberate"},{"id":"spn-46701","text":")"}]}],"id":"blk-41361","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41363","kind":"paragraph","spans":[{"id":"spn-46702","text":"This provides both relevant memory and structural signal for downstream reasoning."}]},{"id":"blk-41364","kind":"paragraph","spans":[{"id":"spn-46703","text":"---"}]},{"id":"blk-41365","kind":"heading","level":2,"spans":[{"id":"spn-46704","text":"Topology and Deliberation"}]},{"id":"blk-41366","kind":"paragraph","spans":[{"id":"spn-46705","text":"Graphonomous computes SCC/topology properties and a κ-style complexity signal to identify cyclic reasoning regions."}]},{"id":"blk-41367","items":[{"blocks":[{"id":"blk-41369","kind":"paragraph","spans":[{"id":"spn-46706","marks":["bold"],"text":"`fast` routing"},{"id":"spn-46707","text":": low cycle complexity, proceed with normal retrieval flow"}]}],"id":"blk-41368","kind":"list-item"},{"blocks":[{"id":"blk-41371","kind":"paragraph","spans":[{"id":"spn-46708","marks":["bold"],"text":"`deliberate` routing"},{"id":"spn-46709","text":": cyclic/entangled subgraph, invoke deeper structured deliberation"}]}],"id":"blk-41370","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41372","kind":"paragraph","spans":[{"id":"spn-46710","marks":["code"],"text":"Deliberator"},{"id":"spn-46711","text":" can decompose cyclic regions, analyze fault-line edges, reconcile conclusions, and optionally write conclusions back into the graph."}]},{"id":"blk-41373","kind":"paragraph","spans":[{"id":"spn-46712","text":"---"}]},{"id":"blk-41374","kind":"heading","level":2,"spans":[{"id":"spn-46713","text":"Learning Loop"}]},{"id":"blk-41375","kind":"paragraph","spans":[{"id":"spn-46714","marks":["code"],"text":"Learner"},{"id":"spn-46715","text":" closes the causal feedback loop:"}]},{"id":"blk-41376","kind":"paragraph","spans":[{"id":"spn-46716","text":"1. Persist action outcome 2. Update confidence on causal source nodes"}]},{"id":"blk-41377","kind":"paragraph","spans":[{"id":"spn-46717","text":"Status signals include:"}]},{"id":"blk-41378","items":[{"blocks":[{"id":"blk-41380","kind":"paragraph","spans":[{"id":"spn-46718","marks":["code"],"text":"success"}]}],"id":"blk-41379","kind":"list-item"},{"blocks":[{"id":"blk-41382","kind":"paragraph","spans":[{"id":"spn-46719","marks":["code"],"text":"partial_success"}]}],"id":"blk-41381","kind":"list-item"},{"blocks":[{"id":"blk-41384","kind":"paragraph","spans":[{"id":"spn-46720","marks":["code"],"text":"failure"}]}],"id":"blk-41383","kind":"list-item"},{"blocks":[{"id":"blk-41386","kind":"paragraph","spans":[{"id":"spn-46721","marks":["code"],"text":"timeout"}]}],"id":"blk-41385","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41387","kind":"paragraph","spans":[{"id":"spn-46722","text":"Confidence updates are blended with a learning-rate rule, so the graph continuously calibrates itself over real outcomes instead of static assumptions."}]},{"id":"blk-41388","kind":"paragraph","spans":[{"id":"spn-46723","text":"---"}]},{"id":"blk-41389","kind":"heading","level":2,"spans":[{"id":"spn-46724","text":"Goal and Epistemic Control Plane"}]},{"id":"blk-41390","kind":"heading","level":3,"spans":[{"id":"spn-46725","text":"GoalGraph"}]},{"id":"blk-41391","kind":"paragraph","spans":[{"id":"spn-46726","text":"Durable multi-step intent with lifecycle states such as:"}]},{"id":"blk-41392","items":[{"blocks":[{"id":"blk-41394","kind":"paragraph","spans":[{"id":"spn-46727","marks":["code"],"text":"proposed"}]}],"id":"blk-41393","kind":"list-item"},{"blocks":[{"id":"blk-41396","kind":"paragraph","spans":[{"id":"spn-46728","marks":["code"],"text":"active"}]}],"id":"blk-41395","kind":"list-item"},{"blocks":[{"id":"blk-41398","kind":"paragraph","spans":[{"id":"spn-46729","marks":["code"],"text":"blocked"}]}],"id":"blk-41397","kind":"list-item"},{"blocks":[{"id":"blk-41400","kind":"paragraph","spans":[{"id":"spn-46730","marks":["code"],"text":"completed"}]}],"id":"blk-41399","kind":"list-item"},{"blocks":[{"id":"blk-41402","kind":"paragraph","spans":[{"id":"spn-46731","marks":["code"],"text":"abandoned"}]}],"id":"blk-41401","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41403","kind":"paragraph","spans":[{"id":"spn-46732","text":"Goals can link to supporting node IDs, track progress, and persist across sessions."}]},{"id":"blk-41404","kind":"heading","level":3,"spans":[{"id":"spn-46733","text":"Coverage"}]},{"id":"blk-41405","kind":"paragraph","spans":[{"id":"spn-46734","text":"Before high-impact actions, Graphonomous can score epistemic readiness:"}]},{"id":"blk-41406","items":[{"blocks":[{"id":"blk-41408","kind":"paragraph","spans":[{"id":"spn-46735","marks":["code"],"text":"coverage_score"}]}],"id":"blk-41407","kind":"list-item"},{"blocks":[{"id":"blk-41410","kind":"paragraph","spans":[{"id":"spn-46736","marks":["code"],"text":"uncertainty_score"}]}],"id":"blk-41409","kind":"list-item"},{"blocks":[{"id":"blk-41412","kind":"paragraph","spans":[{"id":"spn-46737","marks":["code"],"text":"risk_score"}]}],"id":"blk-41411","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41413","kind":"paragraph","spans":[{"id":"spn-46738","text":"Decision output:"}]},{"id":"blk-41414","items":[{"blocks":[{"id":"blk-41416","kind":"paragraph","spans":[{"id":"spn-46739","marks":["bold"],"text":"act"}]}],"id":"blk-41415","kind":"list-item"},{"blocks":[{"id":"blk-41418","kind":"paragraph","spans":[{"id":"spn-46740","marks":["bold"],"text":"learn"}]}],"id":"blk-41417","kind":"list-item"},{"blocks":[{"id":"blk-41420","kind":"paragraph","spans":[{"id":"spn-46741","marks":["bold"],"text":"escalate"}]}],"id":"blk-41419","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41421","kind":"heading","level":3,"spans":[{"id":"spn-46742","text":"Attention"}]},{"id":"blk-41422","kind":"paragraph","spans":[{"id":"spn-46743","text":"Attention continuously ranks work across goals using urgency, coverage gaps, and topology signals; it supports "},{"id":"spn-46744","marks":["code"],"text":"observe"},{"id":"spn-46745","text":", "},{"id":"spn-46746","marks":["code"],"text":"advise"},{"id":"spn-46747","text":", and "},{"id":"spn-46748","marks":["code"],"text":"act"},{"id":"spn-46749","text":" autonomy levels."}]},{"id":"blk-41423","kind":"paragraph","spans":[{"id":"spn-46750","text":"---"}]},{"id":"blk-41424","kind":"heading","level":2,"spans":[{"id":"spn-46751","text":"Consolidation"}]},{"id":"blk-41425","kind":"paragraph","spans":[{"id":"spn-46752","marks":["code"],"text":"Consolidator"},{"id":"spn-46753","text":" runs periodic maintenance to protect graph quality over time:"}]},{"id":"blk-41426","kind":"paragraph","spans":[{"id":"spn-46754","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-41427","kind":"paragraph","spans":[{"id":"spn-46755","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-41428","kind":"paragraph","spans":[{"id":"spn-46756","text":"---"}]},{"id":"blk-41429","kind":"heading","level":2,"spans":[{"id":"spn-46757","text":"MCP Surface"}]},{"id":"blk-41430","kind":"paragraph","spans":[{"id":"spn-46758","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-41431","items":[{"blocks":[{"id":"blk-41433","kind":"paragraph","spans":[{"id":"spn-46759","text":"storing memory"}]}],"id":"blk-41432","kind":"list-item"},{"blocks":[{"id":"blk-41435","kind":"paragraph","spans":[{"id":"spn-46760","text":"querying/retrieving context"}]}],"id":"blk-41434","kind":"list-item"},{"blocks":[{"id":"blk-41437","kind":"paragraph","spans":[{"id":"spn-46761","text":"reporting outcomes"}]}],"id":"blk-41436","kind":"list-item"},{"blocks":[{"id":"blk-41439","kind":"paragraph","spans":[{"id":"spn-46762","text":"managing goals"}]}],"id":"blk-41438","kind":"list-item"},{"blocks":[{"id":"blk-41441","kind":"paragraph","spans":[{"id":"spn-46763","text":"reviewing coverage"}]}],"id":"blk-41440","kind":"list-item"},{"blocks":[{"id":"blk-41443","kind":"paragraph","spans":[{"id":"spn-46764","text":"running consolidation"}]}],"id":"blk-41442","kind":"list-item"},{"blocks":[{"id":"blk-41445","kind":"paragraph","spans":[{"id":"spn-46765","text":"analyzing topology and running deliberation"}]}],"id":"blk-41444","kind":"list-item"},{"blocks":[{"id":"blk-41447","kind":"paragraph","spans":[{"id":"spn-46766","text":"surveying/running attention cycles"}]}],"id":"blk-41446","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41448","kind":"paragraph","spans":[{"id":"spn-46767","text":"This makes Graphonomous interoperable with MCP-capable assistants, editors, and agent runtimes."}]},{"id":"blk-41449","kind":"paragraph","spans":[{"id":"spn-46768","text":"---"}]},{"id":"blk-41450","kind":"heading","level":2,"spans":[{"id":"spn-46769","text":"Architectural Properties"}]},{"id":"blk-41451","items":[{"blocks":[{"id":"blk-41453","kind":"paragraph","spans":[{"id":"spn-46770","marks":["bold"],"text":"Modular"},{"id":"spn-46771","text":": clear boundaries between storage, retrieval, learning, and orchestration"}]}],"id":"blk-41452","kind":"list-item"},{"blocks":[{"id":"blk-41455","kind":"paragraph","spans":[{"id":"spn-46772","marks":["bold"],"text":"Causal"},{"id":"spn-46773","text":": outcome feedback updates the exact nodes used for decisions"}]}],"id":"blk-41454","kind":"list-item"},{"blocks":[{"id":"blk-41457","kind":"paragraph","spans":[{"id":"spn-46774","marks":["bold"],"text":"Topology-aware"},{"id":"spn-46775","text":": can detect when simple retrieval is insufficient"}]}],"id":"blk-41456","kind":"list-item"},{"blocks":[{"id":"blk-41459","kind":"paragraph","spans":[{"id":"spn-46776","marks":["bold"],"text":"Durable"},{"id":"spn-46777","text":": goals and memory survive process and session boundaries"}]}],"id":"blk-41458","kind":"list-item"},{"blocks":[{"id":"blk-41461","kind":"paragraph","spans":[{"id":"spn-46778","marks":["bold"],"text":"Operationally practical"},{"id":"spn-46779","text":": local DB + supervised services + MCP transport"}]}],"id":"blk-41460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41462","kind":"paragraph","spans":[{"id":"spn-46780","text":"---"}]},{"id":"blk-41463","kind":"heading","level":2,"spans":[{"id":"spn-46781","text":"Practical Mental Model"}]},{"id":"blk-41464","kind":"paragraph","spans":[{"id":"spn-46782","text":"You can think of Graphonomous as:"}]},{"id":"blk-41465","kind":"paragraph","spans":[{"id":"spn-46783","text":"1. a "},{"id":"spn-46784","marks":["bold"],"text":"memory graph"},{"id":"spn-46785","text":" ("},{"id":"spn-46786","marks":["code"],"text":"Store"},{"id":"spn-46787","text":" + "},{"id":"spn-46788","marks":["code"],"text":"Graph"},{"id":"spn-46789","text":"), 2. a "},{"id":"spn-46790","marks":["bold"],"text":"reasoning front-end"},{"id":"spn-46791","text":" ("},{"id":"spn-46792","marks":["code"],"text":"Retriever"},{"id":"spn-46793","text":" + "},{"id":"spn-46794","marks":["code"],"text":"Topology"},{"id":"spn-46795","text":" + "},{"id":"spn-46796","marks":["code"],"text":"Deliberator"},{"id":"spn-46797","text":"), 3. a "},{"id":"spn-46798","marks":["bold"],"text":"learning backend"},{"id":"spn-46799","text":" ("},{"id":"spn-46800","marks":["code"],"text":"Learner"},{"id":"spn-46801","text":" + "},{"id":"spn-46802","marks":["code"],"text":"Consolidator"},{"id":"spn-46803","text":"), 4. and a "},{"id":"spn-46804","marks":["bold"],"text":"control plane"},{"id":"spn-46805","text":" ("},{"id":"spn-46806","marks":["code"],"text":"GoalGraph"},{"id":"spn-46807","text":" + "},{"id":"spn-46808","marks":["code"],"text":"Coverage"},{"id":"spn-46809","text":" + "},{"id":"spn-46810","marks":["code"],"text":"Attention"},{"id":"spn-46811","text":"), 5. all exposed through an "},{"id":"spn-46812","marks":["bold"],"text":"MCP API"},{"id":"spn-46813","text":"."}]},{"id":"blk-41466","kind":"paragraph","spans":[{"id":"spn-46814","text":"That composition is what enables continual learning without retraining base model weights."}]}],"edges":[],"id":"bagaaierabc6mf6vgxlghd5hddlgj5gokgjr6ceyxb6f5t4neib4xx3ewg2kq","vocabulary":"ampersand.docs.fs.v1"}