nce to protect graph quality over time:"}]},{"id":"blk-65247","items":[{"blocks":[{"id":"blk-65249","kind":"paragraph","spans":[{"id":"spn-95500","text":"Confidence decay"}]}],"id":"blk-65248","kind":"list-item"},{"blocks":[{"id":"blk-65251","kind":"paragraph","spans":[{"id":"spn-95501","text":"Prune weak nodes"}]}],"id":"blk-65250","kind":"list-item"},{"blocks":[{"id":"blk-65253","kind":"paragraph","spans":[{"id":"spn-95502","text":"Prune weak edges"}]}],"id":"blk-65252","kind":"list-item"},{"blocks":[{"id":"blk-65255","kind":"paragraph","spans":[{"id":"spn-95503","text":"Strengthen co-activated edges"}]}],"id":"blk-65254","kind":"list-item"},{"blocks":[{"id":"blk-65257","kind":"paragraph","spans":[{"id":"spn-95504","text":"Merge similar nodes"}]}],"id":"blk-65256","kind":"list-item"},{"blocks":[{"id":"blk-65259","kind":"paragraph","spans":[{"id":"spn-95505","text":"Promote timescale (fast → medium → slow → glacial)"}]}],"id":"blk-65258","kind":"list-item"},{"blocks":[{"id":"blk-65261","kind":"paragraph","spans":[{"id":"spn-95506","text":"Generate abstractions from episodic clusters"}]}],"id":"blk-65260","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65262","kind":"paragraph","spans":[{"id":"spn-95507","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-65263","kind":"heading","level":2,"spans":[{"id":"spn-95508","text":"MCP Surface"}]},{"id":"blk-65264","kind":"paragraph","spans":[{"id":"spn-95509","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-65265","items":[{"blocks":[{"id":"blk-65267","kind":"paragraph","spans":[{"id":"spn-95510","text":"storing memory"}]}],"id":"blk-65266","kind":"list-item"},{"blocks":[{"id":"blk-65269","kind":"paragraph","spans":[{"id":"spn-95511","text":"querying/retrieving context"}]}],"id":"blk-65268","kind":"list-item"},{"blocks":[{"id":"blk-65271","kind":"paragraph","spans":[{"id":"spn-95512","text":"reporting outcomes"}]}],"id":"blk-65270","kin