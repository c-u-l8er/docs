","marks":["code"],"text":"related"},{"id":"spn-98179","text":" (backward-compatible)"}]}],"id":"blk-66103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66105","kind":"paragraph","spans":[{"id":"spn-98180","text":"Each edge carries a weight ("},{"id":"spn-98181","marks":["code"],"text":"0.0..1.0"},{"id":"spn-98182","text":", default 0.3), optional "},{"id":"spn-98183","marks":["code"],"text":"co_activation_count"},{"id":"spn-98184","text":", and "},{"id":"spn-98185","marks":["code"],"text":"decay_rate"},{"id":"spn-98186","text":"."}]},{"id":"blk-66106","kind":"heading","level":2,"spans":[{"id":"spn-98187","text":"Persistence Layer"}]},{"id":"blk-66107","kind":"paragraph","spans":[{"id":"spn-98188","marks":["code"],"text":"Store"},{"id":"spn-98189","text":" provides:"}]},{"id":"blk-66108","items":[{"blocks":[{"id":"blk-66110","kind":"paragraph","spans":[{"id":"spn-98190","marks":["bold"],"text":"SQLite durability"},{"id":"spn-98191","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-66109","kind":"list-item"},{"blocks":[{"id":"blk-66112","kind":"paragraph","spans":[{"id":"spn-98192","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-98193","text":" for low-latency reads"}]}],"id":"blk-66111","kind":"list-item"},{"blocks":[{"id":"blk-66114","kind":"paragraph","spans":[{"id":"spn-98194","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-66113","kind":"list-item"},{"blocks":[{"id":"blk-66116","kind":"paragraph","spans":[{"id":"spn-98195","text":"cache warm-up from durable state after boot"}]}],"id":"blk-66115","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66117","kind":"paragraph","spans":[{"id":"spn-98196","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-66118","kind":"heading","level":2,"spans":[{"id":"spn-98197","text":"Retrieval Pipeline"}]},{"id":"blk-66119","kind":"paragraph","spans":[{"id":"spn-98198","marks":["code"],"text":"