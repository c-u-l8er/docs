code"],"text":"causes"},{"id":"spn-95535","text":", "},{"id":"spn-95536","marks":["code"],"text":"resolves"},{"id":"spn-95537","text":" — causal attribution"}]}],"id":"blk-65263","kind":"list-item"},{"blocks":[{"id":"blk-65266","kind":"paragraph","spans":[{"id":"spn-95538","marks":["code"],"text":"supports"},{"id":"spn-95539","text":", "},{"id":"spn-95540","marks":["code"],"text":"contradicts"},{"id":"spn-95541","text":" — evidential"}]}],"id":"blk-65265","kind":"list-item"},{"blocks":[{"id":"blk-65268","kind":"paragraph","spans":[{"id":"spn-95542","marks":["code"],"text":"related_to"},{"id":"spn-95543","text":", "},{"id":"spn-95544","marks":["code"],"text":"similar_to"},{"id":"spn-95545","text":" — topical affinity"}]}],"id":"blk-65267","kind":"list-item"},{"blocks":[{"id":"blk-65270","kind":"paragraph","spans":[{"id":"spn-95546","marks":["code"],"text":"part_of"},{"id":"spn-95547","text":", "},{"id":"spn-95548","marks":["code"],"text":"follows"},{"id":"spn-95549","text":", "},{"id":"spn-95550","marks":["code"],"text":"supersedes"},{"id":"spn-95551","text":", "},{"id":"spn-95552","marks":["code"],"text":"depends_on"},{"id":"spn-95553","text":" — structural"}]}],"id":"blk-65269","kind":"list-item"},{"blocks":[{"id":"blk-65272","kind":"paragraph","spans":[{"id":"spn-95554","marks":["code"],"text":"temporal_before"},{"id":"spn-95555","text":", "},{"id":"spn-95556","marks":["code"],"text":"temporal_after"},{"id":"spn-95557","text":", "},{"id":"spn-95558","marks":["code"],"text":"co_occurs"},{"id":"spn-95559","text":" — temporal ordering"}]}],"id":"blk-65271","kind":"list-item"},{"blocks":[{"id":"blk-65274","kind":"paragraph","spans":[{"id":"spn-95560","marks":["code"],"text":"derived_from"},{"id":"spn-95561","text":" — provenance"}]}],"id":"blk-65273","kind":"list-item"},{"blocks":[{"id":"blk-65276","kind":"paragraph","spans":[{"id":"spn-95562","text":"Legacy aliases: "},{"id":"spn-95563","marks":["code"],"text":"causal"},{"id":"spn-95564","text":", "},{"id":"spn-95565","marks":["code"],"text":"related"},{"id":"spn-95566","text":" (backward-compatible)"}]}],"id":"blk-65275","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65277","kind":"paragraph","spans":[{"id":"spn-95567","text":"Each edge carries a weight ("},{"id":"spn-95568","marks":["code"],"text":"0.0..1.0"},{"id":"spn-95569","text":", default 0.3), optional "},{"id":"spn-95570","marks":["code"],"text":"co_activation_count"},{"id":"spn-95571","text":", and "},{"id":"spn-95572","marks":["code"],"text":"decay_rate"},{"id":"spn-95573","text":"."}]},{"id":"blk-65278","kind":"heading","level":2,"spans":[{"id":"spn-95574","text":"Persistence Layer"}]},{"id":"blk-65279","kind":"paragraph","spans":[{"id":"spn-95575","marks":["code"],"text":"Store"},{"id":"spn-95576","text":" provides:"}]},{"id":"blk-65280","items":[{"blocks":[{"id":"blk-65282","kind":"paragraph","spans":[{"id":"spn-95577","marks":["bold"],"text":"SQLite durability"},{"id":"spn-95578","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-65281","kind":"list-item"},{"blocks":[{"id":"blk-65284","kind":"paragraph","spans":[{"id":"spn-95579","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-95580","text":" for low-latency reads"}]}],"id":"blk-65283","kind":"list-item"},{"blocks":[{"id":"blk-65286","kind":"paragraph","spans":[{"id":"spn-95581","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-65285","kind":"list-item"},{"blocks":[{"id":"blk-65288","kind":"paragraph","spans":[{"id":"spn-95582","text":"cache warm-up from durable state after boot"}]}],"id":"blk-65287","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65289","kind":"paragraph","spans":[{"id":"spn-95583","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-65290","kind":"heading","level":2,"spans":[{"id":"spn-95584","text":"Retrieval Pipeline"}]},{"id":"blk-65291","kind":"paragraph","spans":[{"id":"spn-95585","marks":["code"],"text":"