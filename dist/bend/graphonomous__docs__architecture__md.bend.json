: durable goal lifecycle management"}]}],"id":"blk-66060","kind":"list-item"},{"blocks":[{"id":"blk-66063","kind":"paragraph","spans":[{"id":"spn-98115","marks":["bold"],"text":"Coverage"},{"id":"spn-98116","text":": epistemic scoring ("},{"id":"spn-98117","marks":["code"],"text":"act"},{"id":"spn-98118","text":" / "},{"id":"spn-98119","marks":["code"],"text":"learn"},{"id":"spn-98120","text":" / "},{"id":"spn-98121","marks":["code"],"text":"escalate"},{"id":"spn-98122","text":")"}]}],"id":"blk-66062","kind":"list-item"},{"blocks":[{"id":"blk-66065","kind":"paragraph","spans":[{"id":"spn-98123","marks":["bold"],"text":"Attention"},{"id":"spn-98124","text":": proactive goal prioritization loop"}]}],"id":"blk-66064","kind":"list-item"},{"blocks":[{"id":"blk-66067","kind":"paragraph","spans":[{"id":"spn-98125","marks":["bold"],"text":"Consolidator"},{"id":"spn-98126","text":": periodic memory maintenance"}]}],"id":"blk-66066","kind":"list-item"},{"blocks":[{"id":"blk-66069","kind":"paragraph","spans":[{"id":"spn-98127","marks":["bold"],"text":"MCP Server"},{"id":"spn-98128","text":": tool/resource interface for external agents"}]}],"id":"blk-66068","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66070","kind":"heading","level":2,"spans":[{"id":"spn-98129","text":"Runtime Topology (Conceptual)"}]},{"id":"blk-66071","kind":"code","language":"text","text":"Agent / Client (MCP)\n        |\n        v\n+-------------------------+\n| Graphonomous MCP Server |\n+-------------------------+\n   |      |         |\n   |      |         +--> Goal / Coverage / Attention\n   |      |\n   |      +-------------> Retriever / Deliberator / Topology\n   |\n   +---------------------> Graph <-> Store <-> SQLite + ETS\n                                \\\n                                 +-> Embedder\n\nLearner <------------------ Outcomes (causal feedback)\nConsolidator -----------> Decay / prune / maintain cycles"},{"id":"blk-66072","kind":"heading","level":2,"spans":[{"id":"