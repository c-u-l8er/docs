,"text":"Edge Types"}]},{"id":"blk-41808","kind":"paragraph","spans":[{"id":"spn-47758","text":"Relationship types include:"}]},{"id":"blk-41809","items":[{"blocks":[{"id":"blk-41811","kind":"paragraph","spans":[{"id":"spn-47759","marks":["code"],"text":"causes"},{"id":"spn-47760","text":", "},{"id":"spn-47761","marks":["code"],"text":"resolves"},{"id":"spn-47762","text":" — causal attribution"}]}],"id":"blk-41810","kind":"list-item"},{"blocks":[{"id":"blk-41813","kind":"paragraph","spans":[{"id":"spn-47763","marks":["code"],"text":"supports"},{"id":"spn-47764","text":", "},{"id":"spn-47765","marks":["code"],"text":"contradicts"},{"id":"spn-47766","text":" — evidential"}]}],"id":"blk-41812","kind":"list-item"},{"blocks":[{"id":"blk-41815","kind":"paragraph","spans":[{"id":"spn-47767","marks":["code"],"text":"related_to"},{"id":"spn-47768","text":", "},{"id":"spn-47769","marks":["code"],"text":"similar_to"},{"id":"spn-47770","text":" — topical affinity"}]}],"id":"blk-41814","kind":"list-item"},{"blocks":[{"id":"blk-41817","kind":"paragraph","spans":[{"id":"spn-47771","marks":["code"],"text":"part_of"},{"id":"spn-47772","text":", "},{"id":"spn-47773","marks":["code"],"text":"follows"},{"id":"spn-47774","text":", "},{"id":"spn-47775","marks":["code"],"text":"supersedes"},{"id":"spn-47776","text":", "},{"id":"spn-47777","marks":["code"],"text":"depends_on"},{"id":"spn-47778","text":" — structural"}]}],"id":"blk-41816","kind":"list-item"},{"blocks":[{"id":"blk-41819","kind":"paragraph","spans":[{"id":"spn-47779","marks":["code"],"text":"temporal_before"},{"id":"spn-47780","text":", "},{"id":"spn-47781","marks":["code"],"text":"temporal_after"},{"id":"spn-47782","text":", "},{"id":"spn-47783","marks":["code"],"text":"co_occurs"},{"id":"spn-47784","text":" — temporal ordering"}]}],"id":"blk-41818","kind":"list-item"},{"blocks":[{"id":"blk-41821","kind":"paragraph","spans":[{"id":"spn-47785","marks":["code"],"text":"derived_from"},{"id":"spn-47786","text":" — provenance"}]}],"id":"blk-41820","kind":"list-item"},{"blocks":[{"id":"blk-41823","kind":"paragraph","spans":[{"id":"spn-47787","text":"Legacy aliases: "},{"id":"spn-47788","marks":["code"],"text":"causal"},{"id":"spn-47789","text":", "},{"id":"spn-47790","marks":["code"],"text":"related"},{"id":"spn-47791","text":" (backward-compatible)"}]}],"id":"blk-41822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41824","kind":"paragraph","spans":[{"id":"spn-47792","text":"Each edge carries a weight ("},{"id":"spn-47793","marks":["code"],"text":"0.0..1.0"},{"id":"spn-47794","text":", default 0.3), optional "},{"id":"spn-47795","marks":["code"],"text":"co_activation_count"},{"id":"spn-47796","text":", and "},{"id":"spn-47797","marks":["code"],"text":"decay_rate"},{"id":"spn-47798","text":"."}]},{"id":"blk-41825","kind":"paragraph","spans":[{"id":"spn-47799","text":"---"}]},{"id":"blk-41826","kind":"heading","level":2,"spans":[{"id":"spn-47800","text":"Persistence Layer"}]},{"id":"blk-41827","kind":"paragraph","spans":[{"id":"spn-47801","marks":["code"],"text":"Store"},{"id":"spn-47802","text":" provides:"}]},{"id":"blk-41828","items":[{"blocks":[{"id":"blk-41830","kind":"paragraph","spans":[{"id":"spn-47803","marks":["bold"],"text":"SQLite durability"},{"id":"spn-47804","text":" for nodes, edges, outcomes, and goals"}]}],"id":"blk-41829","kind":"list-item"},{"blocks":[{"id":"blk-41832","kind":"paragraph","spans":[{"id":"spn-47805","marks":["bold"],"text":"ETS hot cache"},{"id":"spn-47806","text":" for low-latency reads"}]}],"id":"blk-41831","kind":"list-item"},{"blocks":[{"id":"blk-41834","kind":"paragraph","spans":[{"id":"spn-47807","text":"schema bootstrap and migration application on startup"}]}],"id":"blk-41833","kind":"list-item"},{"blocks":[{"id":"blk-41836","kind":"paragraph","spans":[{"id":"spn-47808","text":"cache warm-up from durable state after boot"}]}],"id":"blk-41835","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41837","kind":"paragraph","spans":[{"id":"spn-47809","text":"Design intent: keep memory local-first and lightweight while still durable across restarts."}]},{"id":"blk-41838","kind":"paragraph","spans":[{"id":"spn-47810","text":"---"}]},{"id":"blk-41839","kind":"heading","level":2,"spans":[{"id":"spn-47811","text":"Retrieval Pipeline"}]},{"id":"blk-41840","kind":"paragraph","spans":[{"id":"spn-47812","marks":["code"],"text":"Retriever"},{"id":"spn-47813","text":" executes a multi-step pipeline:"}]},{"id":"blk-41841","kind":"paragraph","spans":[{"id":"spn-47814","text":"1. Semantic similarity search (seed candidates) 2. Graph neighborhood expansion (bounded hops) 3. Confidence-aware ranking 4. Topology analysis over the retrieved subgraph 5. Return context with:"}]},{"id":"blk-41842","items":[{"blocks":[{"id":"blk-41844","kind":"paragraph","spans":[{"id":"spn-47815","text":"ranked results"}]}],"id":"blk-41843","kind":"list-item"},{"blocks":[{"id":"blk-41846","kind":"paragraph","spans":[{"id":"spn-47816","text":"causal context IDs"}]}],"id":"blk-41845","kind":"list-item"},{"blocks":[{"id":"blk-41848","kind":"paragraph","spans":[{"id":"spn-47817","text":"topology routing hint ("},{"id":"spn-47818","marks":["code"],"text":"fast"},{"id":"spn-47819","text":" or "},{"id":"spn-47820","marks":["code"],"text":"deliberate"},{"id":"spn-47821","text":")"}]}],"id":"blk-41847","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41849","kind":"paragraph","spans":[{"id":"spn-47822","text":"This provides both relevant memory and structural signal for downstream reasoning."}]},{"id":"blk-41850","kind":"paragraph","spans":[{"id":"spn-47823","text":"---"}]},{"id":"blk-41851","kind":"heading","level":2,"spans":[{"id":"spn-47824","text":"Topology and Deliberation"}]},{"id":"blk-41852","kind":"paragraph","spans":[{"id":"spn-47825","text":"Graphonomous computes SCC/topology properties and a κ-style complexity signal to identify cyclic reasoning regions."}]},{"id":"blk-41853","items":[{"blocks":[{"id":"blk-41855","kind":"paragraph","spans":[{"id":"spn-47826","marks":["bold"],"text":"`fast` routing"},{"id":"spn-47827","text":": low cycle complexity, proceed with normal retrieval flow"}]}],"id":"blk-41854","kind":"list-item"},{"blocks":[{"id":"blk-41857","kind":"paragraph","spans":[{"id":"spn-47828","marks":["bold"],"text":"`deliberate` routing"},{"id":"spn-47829","text":": cyclic/entangled subgraph, invoke deeper structured deliberation"}]}],"id":"blk-41856","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41858","kind":"paragraph","spans":[{"id":"spn-47830","marks":["code"],"text":"Deliberator"},{"id":"spn-47831","text":" can decompose cyclic regions, analyze fault-line edges, reconcile conclusions, and optionally write conclusions back into the graph."}]},{"id":"blk-41859","kind":"paragraph","spans":[{"id":"spn-47832","text":"---"}]},{"id":"blk-41860","kind":"heading","level":2,"spans":[{"id":"spn-47833","text":"Learning Loop"}]},{"id":"blk-41861","kind":"paragraph","spans":[{"id":"spn-47834","marks":["code"],"text":"Learner"},{"id":"spn-47835","text":" closes the causal feedback loop:"}]},{"id":"blk-41862","kind":"paragraph","spans":[{"id":"spn-47836","text":"1. Persist action outcome 2. Update confidence on causal source nodes"}]},{"id":"blk-41863","kind":"paragraph","spans":[{"id":"spn-47837","text":"Status signals include:"}]},{"id":"blk-41864","items":[{"blocks":[{"id":"blk-41866","kind":"paragraph","spans":[{"id":"spn-47838","marks":["code"],"text":"success"}]}],"id":"blk-41865","kind":"list-item"},{"blocks":[{"id":"blk-41868","kind":"paragraph","spans":[{"id":"spn-47839","marks":["code"],"text":"partial_success"}]}],"id":"blk-41867","kind":"list-item"},{"blocks":[{"id":"blk-41870","kind":"paragraph","spans":[{"id":"spn-47840","marks":["code"],"text":"failure"}]}],"id":"blk-41869","kind":"list-item"},{"blocks":[{"id":"blk-41872","kind":"paragraph","spans":[{"id":"spn-47841","marks":["code"],"text":"timeout"}]}],"id":"blk-41871","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41873","kind":"paragraph","spans":[{"id":"spn-47842","text":"Confidence updates are blended with a learning-rate rule, so the graph continuously calibrates itself over real outcomes instead of static assumptions."}]},{"id":"blk-41874","kind":"paragraph","spans":[{"id":"spn-47843","text":"---"}]},{"id":"blk-41875","kind":"heading","level":2,"spans":[{"id":"spn-47844","text":"Goal and Epistemic Control Plane"}]},{"id":"blk-41876","kind":"heading","level":3,"spans":[{"id":"spn-47845","text":"GoalGraph"}]},{"id":"blk-41877","kind":"paragraph","spans":[{"id":"spn-47846","text":"Durable multi-step intent with lifecycle states such as:"}]},{"id":"blk-41878","items":[{"blocks":[{"id":"blk-41880","kind":"paragraph","spans":[{"id":"spn-47847","marks":["code"],"text":"proposed"}]}],"id":"blk-41879","kind":"list-item"},{"blocks":[{"id":"blk-41882","kind":"paragraph","spans":[{"id":"spn-47848","marks":["code"],"text":"active"}]}],"id":"blk-41881","kind":"list-item"},{"blocks":[{"id":"blk-41884","kind":"paragraph","spans":[{"id":"spn-47849","marks":["code"],"text":"blocked"}]}],"id":"blk-41883","kind":"list-item"},{"blocks":[{"id":"blk-41886","kind":"paragraph","spans":[{"id":"spn-47850","marks":["code"],"text":"completed"}]}],"id":"blk-41885","kind":"list-item"},{"blocks":[{"id":"blk-41888","kind":"paragraph","spans":[{"id":"spn-47851","marks":["code"],"text":"abandoned"}]}],"id":"blk-41887","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41889","kind":"paragraph","spans":[{"id":"spn-47852","text":"Goals can link to supporting node IDs, track progress, and persist across sessions."}]},{"id":"blk-41890","kind":"heading","level":3,"spans":[{"id":"spn-47853","text":"Coverage"}]},{"id":"blk-41891","kind":"paragraph","spans":[{"id":"spn-47854","text":"Before high-impact actions, Graphonomous can score epistemic readiness:"}]},{"id":"blk-41892","items":[{"blocks":[{"id":"blk-41894","kind":"paragraph","spans":[{"id":"spn-47855","marks":["code"],"text":"coverage_score"}]}],"id":"blk-41893","kind":"list-item"},{"blocks":[{"id":"blk-41896","kind":"paragraph","spans":[{"id":"spn-47856","marks":["code"],"text":"uncertainty_score"}]}],"id":"blk-41895","kind":"list-item"},{"blocks":[{"id":"blk-41898","kind":"paragraph","spans":[{"id":"spn-47857","marks":["code"],"text":"risk_score"}]}],"id":"blk-41897","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41899","kind":"paragraph","spans":[{"id":"spn-47858","text":"Decision output:"}]},{"id":"blk-41900","items":[{"blocks":[{"id":"blk-41902","kind":"paragraph","spans":[{"id":"spn-47859","marks":["bold"],"text":"act"}]}],"id":"blk-41901","kind":"list-item"},{"blocks":[{"id":"blk-41904","kind":"paragraph","spans":[{"id":"spn-47860","marks":["bold"],"text":"learn"}]}],"id":"blk-41903","kind":"list-item"},{"blocks":[{"id":"blk-41906","kind":"paragraph","spans":[{"id":"spn-47861","marks":["bold"],"text":"escalate"}]}],"id":"blk-41905","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41907","kind":"heading","level":3,"spans":[{"id":"spn-47862","text":"Attention"}]},{"id":"blk-41908","kind":"paragraph","spans":[{"id":"spn-47863","text":"Attention continuously ranks work across goals using urgency, coverage gaps, and topology signals; it supports "},{"id":"spn-47864","marks":["code"],"text":"observe"},{"id":"spn-47865","text":", "},{"id":"spn-47866","marks":["code"],"text":"advise"},{"id":"spn-47867","text":", and "},{"id":"spn-47868","marks":["code"],"text":"act"},{"id":"spn-47869","text":" autonomy levels."}]},{"id":"blk-41909","kind":"paragraph","spans":[{"id":"spn-47870","text":"---"}]},{"id":"blk-41910","kind":"heading","level":2,"spans":[{"id":"spn-47871","text":"Consolidation"}]},{"id":"blk-41911","kind":"paragraph","spans":[{"id":"spn-47872","marks":["code"],"text":"Consolidator"},{"id":"spn-47873","text":" runs periodic maintenance to protect graph quality over time:"}]},{"id":"blk-41912","kind":"paragraph","spans":[{"id":"spn-47874","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-41913","kind":"paragraph","spans":[{"id":"spn-47875","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-41914","kind":"paragraph","spans":[{"id":"spn-47876","text":"---"}]},{"id":"blk-41915","kind":"heading","level":2,"spans":[{"id":"spn-47877","text":"MCP Surface"}]},{"id":"blk-41916","kind":"paragraph","spans":[{"id":"spn-47878","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-41917","items":[{"blocks":[{"id":"blk-41919","kind":"paragraph","spans":[{"id":"spn-47879","text":"storing memory"}]}],"id":"blk-41918","kind":"list-item"},{"blocks":[{"id":"blk-41921","kind":"paragraph","spans":[{"id":"spn-47880","text":"querying/retrieving context"}]}],"id":"blk-41920","kind":"list-item"},{"blocks":[{"id":"blk-41923","kind":"paragraph","spans":[{"id":"spn-47881","text":"reporting outcomes"}]}],"id":"blk-41922","kind":"list-item"},{"blocks":[{"id":"blk-41925","kind":"paragraph","spans":[{"id":"spn-47882","text":"managing goals"}]}],"id":"blk-41924","kind":"list-item"},{"blocks":[{"id":"blk-41927","kind":"paragraph","spans":[{"id":"spn-47883","text":"reviewing coverage"}]}],"id":"blk-41926","kind":"list-item"},{"blocks":[{"id":"blk-41929","kind":"paragraph","spans":[{"id":"spn-47884","text":"running consolidation"}]}],"id":"blk-41928","kind":"list-item"},{"blocks":[{"id":"blk-41931","kind":"paragraph","spans":[{"id":"spn-47885","text":"analyzing topology and running deliberation"}]}],"id":"blk-41930","kind":"list-item"},{"blocks":[{"id":"blk-41933","kind":"paragraph","spans":[{"id":"spn-47886","text":"surveying/running attention cycles"}]}],"id":"blk-41932","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41934","kind":"paragraph","spans":[{"id":"spn-47887","text":"This makes Graphonomous interoperable with MCP-capable assistants, editors, and agent runtimes."}]},{"id":"blk-41935","kind":"paragraph","spans":[{"id":"spn-47888","text":"---"}]},{"id":"blk-41936","kind":"heading","level":2,"spans":[{"id":"spn-47889","text":"Architectural Properties"}]},{"id":"blk-41937","items":[{"blocks":[{"id":"blk-41939","kind":"paragraph","spans":[{"id":"spn-47890","marks":["bold"],"text":"Modular"},{"id":"spn-47891","text":": clear boundaries between storage, retrieval, learning, and orchestration"}]}],"id":"blk-41938","kind":"list-item"},{"blocks":[{"id":"blk-41941","kind":"paragraph","spans":[{"id":"spn-47892","marks":["bold"],"text":"Causal"},{"id":"spn-47893","text":": outcome feedback updates the exact nodes used for decisions"}]}],"id":"blk-41940","kind":"list-item"},{"blocks":[{"id":"blk-41943","kind":"paragraph","spans":[{"id":"spn-47894","marks":["bold"],"text":"Topology-aware"},{"id":"spn-47895","text":": can detect when simple retrieval is insufficient"}]}],"id":"blk-41942","kind":"list-item"},{"blocks":[{"id":"blk-41945","kind":"paragraph","spans":[{"id":"spn-47896","marks":["bold"],"text":"Durable"},{"id":"spn-47897","text":": goals and memory survive process and session boundaries"}]}],"id":"blk-41944","kind":"list-item"},{"blocks":[{"id":"blk-41947","kind":"paragraph","spans":[{"id":"spn-47898","marks":["bold"],"text":"Operationally practical"},{"id":"spn-47899","text":": local DB + supervised services + MCP transport"}]}],"id":"blk-41946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41948","kind":"paragraph","spans":[{"id":"spn-47900","text":"---"}]},{"id":"blk-41949","kind":"heading","level":2,"spans":[{"id":"spn-47901","text":"Practical Mental Model"}]},{"id":"blk-41950","kind":"paragraph","spans":[{"id":"spn-47902","text":"You can think of Graphonomous as:"}]},{"id":"blk-41951","kind":"paragraph","spans":[{"id":"spn-47903","text":"1. a "},{"id":"spn-47904","marks":["bold"],"text":"memory graph"},{"id":"spn-47905","text":" ("},{"id":"spn-47906","marks":["code"],"text":"Store"},{"id":"spn-47907","text":" + "},{"id":"spn-47908","marks":["code"],"text":"Graph"},{"id":"spn-47909","text":"), 2. a "},{"id":"spn-47910","marks":["bold"],"text":"reasoning front-end"},{"id":"spn-47911","text":" ("},{"id":"spn-47912","marks":["code"],"text":"Retriever"},{"id":"spn-47913","text":" + "},{"id":"spn-47914","marks":["code"],"text":"Topology"},{"id":"spn-47915","text":" + "},{"id":"spn-47916","marks":["code"],"text":"Deliberator"},{"id":"spn-47917","text":"), 3. a "},{"id":"spn-47918","marks":["bold"],"text":"learning backend"},{"id":"spn-47919","text":" ("},{"id":"spn-47920","marks":["code"],"text":"Learner"},{"id":"spn-47921","text":" + "},{"id":"spn-47922","marks":["code"],"text":"Consolidator"},{"id":"spn-47923","text":"), 4. and a "},{"id":"spn-47924","marks":["bold"],"text":"control plane"},{"id":"spn-47925","text":" ("},{"id":"spn-47926","marks":["code"],"text":"GoalGraph"},{"id":"spn-47927","text":" + "},{"id":"spn-47928","marks":["code"],"text":"Coverage"},{"id":"spn-47929","text":" + "},{"id":"spn-47930","marks":["code"],"text":"Attention"},{"id":"spn-47931","text":"), 5. all exposed through an "},{"id":"spn-47932","marks":["bold"],"text":"MCP API"},{"id":"spn-47933","text":"."}]},{"id":"blk-41952","kind":"paragraph","spans":[{"id":"spn-47934","text":"That composition is what enables continual learning without retraining base model weights."}]}],"edges":[],"id":"bagaaieraarrgflfqpbwxww2llbxlpwocscezqbq6c5teihillbab5nyq5uia","vocabulary":"ampersand.docs.fs.v1"}