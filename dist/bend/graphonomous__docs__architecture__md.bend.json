nce to protect graph quality over time:"}]},{"id":"blk-66201","items":[{"blocks":[{"id":"blk-66203","kind":"paragraph","spans":[{"id":"spn-98261","text":"Confidence decay"}]}],"id":"blk-66202","kind":"list-item"},{"blocks":[{"id":"blk-66205","kind":"paragraph","spans":[{"id":"spn-98262","text":"Prune weak nodes"}]}],"id":"blk-66204","kind":"list-item"},{"blocks":[{"id":"blk-66207","kind":"paragraph","spans":[{"id":"spn-98263","text":"Prune weak edges"}]}],"id":"blk-66206","kind":"list-item"},{"blocks":[{"id":"blk-66209","kind":"paragraph","spans":[{"id":"spn-98264","text":"Strengthen co-activated edges"}]}],"id":"blk-66208","kind":"list-item"},{"blocks":[{"id":"blk-66211","kind":"paragraph","spans":[{"id":"spn-98265","text":"Merge similar nodes"}]}],"id":"blk-66210","kind":"list-item"},{"blocks":[{"id":"blk-66213","kind":"paragraph","spans":[{"id":"spn-98266","text":"Promote timescale (fast → medium → slow → glacial)"}]}],"id":"blk-66212","kind":"list-item"},{"blocks":[{"id":"blk-66215","kind":"paragraph","spans":[{"id":"spn-98267","text":"Generate abstractions from episodic clusters"}]}],"id":"blk-66214","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-66216","kind":"paragraph","spans":[{"id":"spn-98268","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-66217","kind":"heading","level":2,"spans":[{"id":"spn-98269","text":"MCP Surface"}]},{"id":"blk-66218","kind":"paragraph","spans":[{"id":"spn-98270","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-66219","items":[{"blocks":[{"id":"blk-66221","kind":"paragraph","spans":[{"id":"spn-98271","text":"storing memory"}]}],"id":"blk-66220","kind":"list-item"},{"blocks":[{"id":"blk-66223","kind":"paragraph","spans":[{"id":"spn-98272","text":"querying/retrieving context"}]}],"id":"blk-66222","kind":"list-item"},{"blocks":[{"id":"blk-66225","kind":"paragraph","spans":[{"id":"spn-98273","text":"reporting outcomes"}]}],"id":"blk-66224","kin