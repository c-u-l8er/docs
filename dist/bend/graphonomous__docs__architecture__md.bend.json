{"bendscript":"0.1","blocks":[{"id":"blk-65080","kind":"heading","level":1,"spans":[{"id":"spn-95285","text":"Graphonomous Architecture"}]},{"id":"blk-65081","kind":"paragraph","spans":[{"id":"spn-95286","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-65082","kind":"heading","level":2,"spans":[{"id":"spn-95287","text":"System Overview"}]},{"id":"blk-65083","kind":"paragraph","spans":[{"id":"spn-95288","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-65084","items":[{"blocks":[{"id":"blk-65086","kind":"paragraph","spans":[{"id":"spn-95289","marks":["bold"],"text":"Store"},{"id":"spn-95290","text":": durable persistence and hot cache"}]}],"id":"blk-65085","kind":"list-item"},{"blocks":[{"id":"blk-65088","kind":"paragraph","spans":[{"id":"spn-95291","marks":["bold"],"text":"Embedder"},{"id":"spn-95292","text":": embedding generation backend"}]}],"id":"blk-65087","kind":"list-item"},{"blocks":[{"id":"blk-65090","kind":"paragraph","spans":[{"id":"spn-95293","marks":["bold"],"text":"Graph"},{"id":"spn-95294","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-65089","kind":"list-item"},{"blocks":[{"id":"blk-65092","kind":"paragraph","spans":[{"id":"spn-95295","marks":["bold"],"text":"Retriever"},{"id":"spn-95296","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-65091","kind":"list-item"},{"blocks":[{"id":"blk-65094","kind":"paragraph","spans":[{"id":"spn-95297","marks":["bold"],"text":"Learner"},{"id":"spn-95298","text":": outcome ingestion and confidence updates"}]}],"id":"blk-65093","kind":"list-item"},{"blocks":[{"id":"blk-65096","kind":"paragraph","spans":[{"id":"spn-95299","marks":["bold"],"text":"GoalGraph"},{"id":"spn-95300","text":": durable goal lifecycle management"}]}],"id":"blk-65095","kind":"list-item"},{"blocks":[{"id":"blk-65098","kind":"paragraph","spans":[{"id":"spn-95301","marks":["bold"],"text":"Coverage"},{"id":"spn-95302","text":": epistemic scoring ("},{"id":"spn-95303","marks":["code"],"text":"act"},{"id":"spn-95304","text":" / "},{"id":"spn-95305","marks":["code"],"text":"learn"},{"id":"spn-95306","text":" / "},{"id":"spn-95307","marks":["code"],"text":"escalate"},{"id":"spn-95308","text":")"}]}],"id":"blk-65097","kind":"list-item"},{"blocks":[{"id":"blk-65100","kind":"paragraph","spans":[{"id":"spn-95309","marks":["bold"],"text":"Attention"},{"id":"spn-95310","text":": proactive goal prioritization loop"}]}],"id":"blk-65099","kind":"list-item"},{"blocks":[{"id":"blk-65102","kind":"paragraph","spans":[{"id":"spn-95311","marks":["bold"],"text":"Consolidator"},{"id":"spn-95312","text":": periodic memory maintenance"}]}],"id":"blk-65101","kind":"list-item"},{"blocks":[{"id":"blk-65104","kind":"paragraph","spans":[{"id":"spn-95313","marks":["bold"],"text":"MCP Server"},{"id":"spn-95314","text":": tool/resource interface for external agents"}]}],"id":"blk-65103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65105","kind":"heading","level":2,"spans":[{"id":"spn-95315","text":"Runtime Topology (Conceptual)"}]},{"id":"blk-65106","kind":"code","language":"text","text":"Agent / Client (MCP)\n        |\n        v\n+-------------------------+\n| Graphonomous MCP Server |\n+-------------------------+\n   |      |         |\n   |      |         +--> Goal / Coverage / Attention\n   |      |\n   |      +-------------> Retriever / Deliberator / Topology\n   |\n   +---------------------> Graph <-> Store <-> SQLite + ETS\n                                \\\n                                 +-> Embedder\n\nLearner <------------------ Outcomes (causal feedback)\nConsolidator -----------> Decay / prune / maintain cycles"},{"id":"blk-65107","kind":"heading","level":2,"spans":[{"id":"