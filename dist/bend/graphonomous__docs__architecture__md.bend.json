{"bendscript":"0.1","blocks":[{"id":"blk-41275","kind":"heading","level":1,"spans":[{"id":"spn-46588","text":"Graphonomous Architecture"}]},{"id":"blk-41276","kind":"paragraph","spans":[{"id":"spn-46589","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-41277","kind":"paragraph","spans":[{"id":"spn-46590","text":"---"}]},{"id":"blk-41278","kind":"heading","level":2,"spans":[{"id":"spn-46591","text":"System Overview"}]},{"id":"blk-41279","kind":"paragraph","spans":[{"id":"spn-46592","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-41280","items":[{"blocks":[{"id":"blk-41282","kind":"paragraph","spans":[{"id":"spn-46593","marks":["bold"],"text":"Store"},{"id":"spn-46594","text":": durable persistence and hot cache"}]}],"id":"blk-41281","kind":"list-item"},{"blocks":[{"id":"blk-41284","kind":"paragraph","spans":[{"id":"spn-46595","marks":["bold"],"text":"Embedder"},{"id":"spn-46596","text":": embedding generation backend"}]}],"id":"blk-41283","kind":"list-item"},{"blocks":[{"id":"blk-41286","kind":"paragraph","spans":[{"id":"spn-46597","marks":["bold"],"text":"Graph"},{"id":"spn-46598","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-41285","kind":"list-item"},{"blocks":[{"id":"blk-41288","kind":"paragraph","spans":[{"id":"spn-46599","marks":["bold"],"text":"Retriever"},{"id":"spn-46600","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-41287","kind":"list-item"},{"blocks":[{"id":"blk-41290","kind":"paragraph","spans":[{"id":"spn-46601","marks":["bold"],"text":"Learner"},{"id":"spn-46602","text":": outcome ingestion and confidence updates"}]}],"id":"blk-41289","kind":"list-item"},{"blocks":[{"id":"blk-41292","kind":"paragraph","spans":[{