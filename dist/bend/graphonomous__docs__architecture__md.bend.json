nce to protect graph quality over time:"}]},{"id":"blk-65373","items":[{"blocks":[{"id":"blk-65375","kind":"paragraph","spans":[{"id":"spn-95648","text":"Confidence decay"}]}],"id":"blk-65374","kind":"list-item"},{"blocks":[{"id":"blk-65377","kind":"paragraph","spans":[{"id":"spn-95649","text":"Prune weak nodes"}]}],"id":"blk-65376","kind":"list-item"},{"blocks":[{"id":"blk-65379","kind":"paragraph","spans":[{"id":"spn-95650","text":"Prune weak edges"}]}],"id":"blk-65378","kind":"list-item"},{"blocks":[{"id":"blk-65381","kind":"paragraph","spans":[{"id":"spn-95651","text":"Strengthen co-activated edges"}]}],"id":"blk-65380","kind":"list-item"},{"blocks":[{"id":"blk-65383","kind":"paragraph","spans":[{"id":"spn-95652","text":"Merge similar nodes"}]}],"id":"blk-65382","kind":"list-item"},{"blocks":[{"id":"blk-65385","kind":"paragraph","spans":[{"id":"spn-95653","text":"Promote timescale (fast → medium → slow → glacial)"}]}],"id":"blk-65384","kind":"list-item"},{"blocks":[{"id":"blk-65387","kind":"paragraph","spans":[{"id":"spn-95654","text":"Generate abstractions from episodic clusters"}]}],"id":"blk-65386","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65388","kind":"paragraph","spans":[{"id":"spn-95655","text":"This prevents unbounded memory drift and keeps retrieval quality stable."}]},{"id":"blk-65389","kind":"heading","level":2,"spans":[{"id":"spn-95656","text":"MCP Surface"}]},{"id":"blk-65390","kind":"paragraph","spans":[{"id":"spn-95657","text":"Graphonomous is MCP-first, exposing tools/resources for:"}]},{"id":"blk-65391","items":[{"blocks":[{"id":"blk-65393","kind":"paragraph","spans":[{"id":"spn-95658","text":"storing memory"}]}],"id":"blk-65392","kind":"list-item"},{"blocks":[{"id":"blk-65395","kind":"paragraph","spans":[{"id":"spn-95659","text":"querying/retrieving context"}]}],"id":"blk-65394","kind":"list-item"},{"blocks":[{"id":"blk-65397","kind":"paragraph","spans":[{"id":"spn-95660","text":"reporting outcomes"}]}],"id":"blk-65396","kin