{"bendscript":"0.1","blocks":[{"id":"blk-65217","kind":"heading","level":1,"spans":[{"id":"spn-95486","text":"Graphonomous Architecture"}]},{"id":"blk-65218","kind":"paragraph","spans":[{"id":"spn-95487","text":"Graphonomous is a continual-learning engine for AI agents, implemented in Elixir/OTP and exposed through an MCP server. Its design centers on a graph memory model, confidence-updating learning loops, and topology-aware reasoning."}]},{"id":"blk-65219","kind":"heading","level":2,"spans":[{"id":"spn-95488","text":"System Overview"}]},{"id":"blk-65220","kind":"paragraph","spans":[{"id":"spn-95489","text":"At runtime, Graphonomous is composed of supervised services that each own a distinct responsibility:"}]},{"id":"blk-65221","items":[{"blocks":[{"id":"blk-65223","kind":"paragraph","spans":[{"id":"spn-95490","marks":["bold"],"text":"Store"},{"id":"spn-95491","text":": durable persistence and hot cache"}]}],"id":"blk-65222","kind":"list-item"},{"blocks":[{"id":"blk-65225","kind":"paragraph","spans":[{"id":"spn-95492","marks":["bold"],"text":"Embedder"},{"id":"spn-95493","text":": embedding generation backend"}]}],"id":"blk-65224","kind":"list-item"},{"blocks":[{"id":"blk-65227","kind":"paragraph","spans":[{"id":"spn-95494","marks":["bold"],"text":"Graph"},{"id":"spn-95495","text":": node/edge CRUD and similarity orchestration"}]}],"id":"blk-65226","kind":"list-item"},{"blocks":[{"id":"blk-65229","kind":"paragraph","spans":[{"id":"spn-95496","marks":["bold"],"text":"Retriever"},{"id":"spn-95497","text":": context retrieval + neighborhood expansion + topology annotation"}]}],"id":"blk-65228","kind":"list-item"},{"blocks":[{"id":"blk-65231","kind":"paragraph","spans":[{"id":"spn-95498","marks":["bold"],"text":"Learner"},{"id":"spn-95499","text":": outcome ingestion and confidence updates"}]}],"id":"blk-65230","kind":"list-item"},{"blocks":[{"id":"blk-65233","kind":"paragraph","spans":[{"id":"spn-95500","marks":["bold"],"text":"GoalGraph"},{"id":"spn-95501","text":": durable goal lifecycle management"}]}],"id":"blk-65232","kind":"list-item"},{"blocks":[{"id":"blk-65235","kind":"paragraph","spans":[{"id":"spn-95502","marks":["bold"],"text":"Coverage"},{"id":"spn-95503","text":": epistemic scoring ("},{"id":"spn-95504","marks":["code"],"text":"act"},{"id":"spn-95505","text":" / "},{"id":"spn-95506","marks":["code"],"text":"learn"},{"id":"spn-95507","text":" / "},{"id":"spn-95508","marks":["code"],"text":"escalate"},{"id":"spn-95509","text":")"}]}],"id":"blk-65234","kind":"list-item"},{"blocks":[{"id":"blk-65237","kind":"paragraph","spans":[{"id":"spn-95510","marks":["bold"],"text":"Attention"},{"id":"spn-95511","text":": proactive goal prioritization loop"}]}],"id":"blk-65236","kind":"list-item"},{"blocks":[{"id":"blk-65239","kind":"paragraph","spans":[{"id":"spn-95512","marks":["bold"],"text":"Consolidator"},{"id":"spn-95513","text":": periodic memory maintenance"}]}],"id":"blk-65238","kind":"list-item"},{"blocks":[{"id":"blk-65241","kind":"paragraph","spans":[{"id":"spn-95514","marks":["bold"],"text":"MCP Server"},{"id":"spn-95515","text":": tool/resource interface for external agents"}]}],"id":"blk-65240","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65242","kind":"heading","level":2,"spans":[{"id":"spn-95516","text":"Runtime Topology (Conceptual)"}]},{"id":"blk-65243","kind":"code","language":"text","text":"Agent / Client (MCP)\n        |\n        v\n+-------------------------+\n| Graphonomous MCP Server |\n+-------------------------+\n   |      |         |\n   |      |         +--> Goal / Coverage / Attention\n   |      |\n   |      +-------------> Retriever / Deliberator / Topology\n   |\n   +---------------------> Graph <-> Store <-> SQLite + ETS\n                                \\\n                                 +-> Embedder\n\nLearner <------------------ Outcomes (causal feedback)\nConsolidator -----------> Decay / prune / maintain cycles"},{"id":"blk-65244","kind":"heading","level":2,"spans":[{"id":"