}]},{"id":"blk-26292","spans":[{"id":"spn-30431","marks":["code"],"text":"PULSE/site/"},{"id":"spn-30432","text":" static"}]},{"id":"blk-26293","spans":[{"id":"spn-30433","text":"http://localhost:8091"}]}],[{"id":"blk-26294","spans":[{"id":"spn-30434","marks":["code"],"text":"npm run dev:opensentience"}]},{"id":"blk-26295","spans":[{"id":"spn-30435","marks":["code"],"text":"opensentience.org/"},{"id":"spn-30436","text":" static"}]},{"id":"blk-26296","spans":[{"id":"spn-30437","text":"http://localhost:8092"}]}],[{"id":"blk-26297","spans":[{"id":"spn-30438","marks":["code"],"text":"npm run dev:prism"}]},{"id":"blk-26298","spans":[{"id":"spn-30439","marks":["code"],"text":"PRISM/"},{"id":"spn-30440","text":" Phoenix"}]},{"id":"blk-26299","spans":[{"id":"spn-30441","text":"http://localhost:4000"}]}],[{"id":"blk-26300","spans":[{"id":"spn-30442","marks":["code"],"text":"npm run dev:specprompt"}]},{"id":"blk-26301","spans":[{"id":"spn-30443","marks":["code"],"text":"specprompt.com/"},{"id":"spn-30444","text":" Phoenix"}]},{"id":"blk-26302","spans":[{"id":"spn-30445","text":"http://localhost:4200"}]}]]},{"id":"blk-26303","kind":"heading","level":3,"spans":[{"id":"spn-30446","text":"Run everything at once"}]},{"head":[{"id":"blk-26305","spans":[{"id":"spn-30447","text":"Command"}]},{"id":"blk-26306","spans":[{"id":"spn-30448","text":"What it does"}]}],"id":"blk-26304","kind":"table","rows":[[{"id":"blk-26307","spans":[{"id":"spn-30449","marks":["code"],"text":"npm run dev:all"}]},{"id":"blk-26308","spans":[{"id":"spn-30450","text":"Starts Supabase, then every dev server above in parallel (uses "},{"id":"spn-30451","marks":["code"],"text":"concurrently"},{"id":"spn-30452","text":"). Press Ctrl+C to terminate all."}]}],[{"id":"blk-26309","spans":[{"id":"spn-30453","marks":["code"],"text":"npm run stop:all"}]},{"id":"blk-26310","spans":[{"id":"spn-30454","text":"Stops Supabase and kills any lingering dev-server processes on the ports above."}]}]]},{"id":"blk-26311","kind":"heading","level":3,"spans":[{"id":"spn-30455","text":"Build / test"}]},{"head":[{"id":"blk-26313","spans":[{"id":"spn-30456","text":"Command"}]},{"id":"blk-26314","spans":[{"id":"spn-30457","text":"What it does"}]}],"id":"blk-26312","kind":"table","rows":[[{"id":"blk-26315","spans":[{"id":"spn-30458","marks":["code"],"text":"npm run build:all"}]},{"id":"blk-26316","spans":[{"id":"spn-30459","text":"Runs the build step in every buildable project ("},{"id":"spn-30460","marks":["code"],"text":"WebHost.Systems"},{"id":"spn-30461","text":", "},{"id":"spn-30462","marks":["code"],"text":"bendscript.com"},{"id":"spn-30463","text":", "},{"id":"spn-30464","marks":["code"],"text":"runefort.com"},{"id":"spn-30465","text":", "},{"id":"spn-30466","marks":["code"],"text":"graphonomous"},{"id":"spn-30467","text":", "},{"id":"spn-30468","marks":["code"],"text":"PRISM"},{"id":"spn-30469","text":", "},{"id":"spn-30470","marks":["code"],"text":"specprompt.com"},{"id":"spn-30471","text":")."}]}],[{"id":"blk-26317","spans":[{"id":"spn-30472","marks":["code"],"text":"npm run test:all"}]},{"id":"blk-26318","spans":[{"id":"spn-30473","text":"Runs the test suite in every project that has one."}]}],[{"id":"blk-26319","spans":[{"id":"spn-30474","marks":["code"],"text":"npm run lint:all"}]},{"id":"blk-26320","spans":[{"id":"spn-30475","text":"Lints the Node projects; runs "},{"id":"spn-30476","marks":["code"],"text":"mix format --check-formatted"},{"id":"spn-30477","text":" on Elixir projects."}]}],[{"id":"blk-26321","spans":[{"id":"spn-30478","marks":["code"],"text":"npm run typecheck:all"}]},{"id":"blk-26322","spans":[{"id":"spn-30479","marks":["code"],"text":"svelte-check"},{"id":"spn-30480","text":" + "},{"id":"spn-30481","marks":["code"],"text":"tsc"},{"id":"spn-30482","text":" + "},{"id":"spn-30483","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-30484","text":" across the relevant projects."}]}]]},{"id":"blk-26323","kind":"heading","level":3,"spans":[{"id":"spn-30485","text":"Individual project commands (for reference)"}]},{"id":"blk-26324","kind":"paragraph","spans":[{"id":"spn-30486","text":"If you'd rather run commands directly:"}]},{"id":"blk-26325","kind":"code","language":"bash","text":"# graphonomous (Elixir)\ncd graphonomous && mix deps.get && mix compile --warnings-as-errors && mix test\n\n# WebHost.Systems (Node monorepo)\ncd WebHost.Systems && npm install && npm run dev\n\n# AmpersandBoxDesign reference impl\ncd AmpersandBoxDesign/reference/elixir/ampersand_core && mix deps.get && mix escript.build\n\n# PRISM / SpecPrompt (Phoenix)\ncd PRISM && mix deps.get && mix phx.server\ncd specprompt.com && mix deps.get && mix phx.server\n\n# Any SvelteKit / Vite site\ncd runefort.com && npm install && npm run dev"},{"id":"blk-26326","kind":"heading","level":2,"spans":[{"id":"spn-30487","text":"Environment setup per site"}]},{"id":"blk-26327","kind":"paragraph","spans":[{"id":"spn-30488","text":"Most sites need a "},{"id":"spn-30489","marks":["code"],"text":".env.local"},{"id":"spn-30490","text":" pointing at local Supabase. The minimum required:"}]},{"id":"blk-26328","kind":"code","language":"env","text":"VITE_SUPABASE_URL=http://127.0.0.1:54321\nVITE_SUPABASE_ANON_KEY=<ANON_KEY from `npm run db:status`>"},{"id":"blk-26329","kind":"paragraph","spans":[{"id":"spn-30491","marks":["code"],"text":"npm run db:status -- -o env"},{"id":"spn-30492","text":" prints every key ready to paste. (The local anon key is deterministic for "},{"id":"spn-30493","marks":["code"],"text":"supabase-demo"},{"id":"spn-30494","text":", so the same key works across rebuilds.)"}]},{"id":"blk-26330","kind":"heading","level":2,"spans":[{"id":"spn-30495","text":"Conventions"}]},{"id":"blk-26331","items":[{"blocks":[{"id":"blk-26333","kind":"paragraph","spans":[{"id":"spn-30496","text":"Never commit secrets, API keys, or credentials."}]}],"id":"blk-26332","kind":"list-item"},{"blocks":[{"id":"blk-26335","kind":"paragraph","spans":[{"id":"spn-30497","text":"Elixir code follows "},{"id":"spn-30498","marks":["code"],"text":"mix format"},{"id":"spn-30499","text":"; TypeScript uses ESLint + Prettier."}]}],"id":"blk-26334","kind":"list-item"},{"blocks":[{"id":"blk-26337","kind":"paragraph","spans":[{"id":"spn-30500","text":"Each product has a spec under "},{"id":"spn-30501","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-30502","text":" (or "},{"id":"spn-30503","marks":["code"],"text":"prompts/"},{"id":"spn-30504","text":" for AmpersandBoxDesign / BendScript). "},{"id":"spn-30505","marks":["bold"],"text":"Always read the spec before changing code."}]}],"id":"blk-26336","kind":"list-item"},{"blocks":[{"id":"blk-26339","kind":"paragraph","spans":[{"id":"spn-30506","text":"Graphonomous MCP is the always-on memory loop for every session in this repo — see the \"Graphonomous session policy\" section in "},{"id":"spn-30507","marks":[{"kind":"link","predicate":"cites","target":"#/CLAUDE.md"}],"text":"CLAUDE.md"},{"id":"spn-30508","text":"."}]}],"id":"blk-26338","kind":"list-item"},{"blocks":[{"id":"blk-26341","kind":"paragraph","spans":[{"id":"spn-30509","text":"Per-product schema ranges in "},{"id":"spn-30510","marks":["code"],"text":"ampersand-supabase/migrations/"},{"id":"spn-30511","text":": "},{"id":"spn-30512","marks":["code"],"text":"000–009"},{"id":"spn-30513","text":" shared "},{"id":"spn-30514","marks":["code"],"text":"amp.*"},{"id":"spn-30515","text":", "},{"id":"spn-30516","marks":["code"],"text":"010–019"},{"id":"spn-30517","text":" "},{"id":"spn-30518","marks":["code"],"text":"kag.*"},{"id":"spn-30519","text":", "},{"id":"spn-30520","marks":["code"],"text":"020–029"},{"id":"spn-30521","text":" "},{"id":"spn-30522","marks":["code"],"text":"webhost.*"},{"id":"spn-30523","text":", "},{"id":"spn-30524","marks":["code"],"text":"030–039"},{"id":"spn-30525","text":" "},{"id":"spn-30526","marks":["code"],"text":"fleet.*"},{"id":"spn-30527","text":", "},{"id":"spn-30528","marks":["code"],"text":"040–049"},{"