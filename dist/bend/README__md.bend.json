}]},{"id":"blk-26259","spans":[{"id":"spn-30315","marks":["code"],"text":"PULSE/site/"},{"id":"spn-30316","text":" static"}]},{"id":"blk-26260","spans":[{"id":"spn-30317","text":"http://localhost:8091"}]}],[{"id":"blk-26261","spans":[{"id":"spn-30318","marks":["code"],"text":"npm run dev:opensentience"}]},{"id":"blk-26262","spans":[{"id":"spn-30319","marks":["code"],"text":"opensentience.org/"},{"id":"spn-30320","text":" static"}]},{"id":"blk-26263","spans":[{"id":"spn-30321","text":"http://localhost:8092"}]}],[{"id":"blk-26264","spans":[{"id":"spn-30322","marks":["code"],"text":"npm run dev:prism"}]},{"id":"blk-26265","spans":[{"id":"spn-30323","marks":["code"],"text":"PRISM/"},{"id":"spn-30324","text":" Phoenix"}]},{"id":"blk-26266","spans":[{"id":"spn-30325","text":"http://localhost:4000"}]}],[{"id":"blk-26267","spans":[{"id":"spn-30326","marks":["code"],"text":"npm run dev:specprompt"}]},{"id":"blk-26268","spans":[{"id":"spn-30327","marks":["code"],"text":"specprompt.com/"},{"id":"spn-30328","text":" Phoenix"}]},{"id":"blk-26269","spans":[{"id":"spn-30329","text":"http://localhost:4200"}]}]]},{"id":"blk-26270","kind":"heading","level":3,"spans":[{"id":"spn-30330","text":"Run everything at once"}]},{"head":[{"id":"blk-26272","spans":[{"id":"spn-30331","text":"Command"}]},{"id":"blk-26273","spans":[{"id":"spn-30332","text":"What it does"}]}],"id":"blk-26271","kind":"table","rows":[[{"id":"blk-26274","spans":[{"id":"spn-30333","marks":["code"],"text":"npm run dev:all"}]},{"id":"blk-26275","spans":[{"id":"spn-30334","text":"Starts Supabase, then every dev server above in parallel (uses "},{"id":"spn-30335","marks":["code"],"text":"concurrently"},{"id":"spn-30336","text":"). Press Ctrl+C to terminate all."}]}],[{"id":"blk-26276","spans":[{"id":"spn-30337","marks":["code"],"text":"npm run stop:all"}]},{"id":"blk-26277","spans":[{"id":"spn-30338","text":"Stops Supabase and kills any lingering dev-server processes on the ports above."}]}]]},{"id":"blk-26278","kind":"heading","level":3,"spans":[{"id":"spn-30339","text":"Build / test"}]},{"head":[{"id":"blk-26280","spans":[{"id":"spn-30340","text":"Command"}]},{"id":"blk-26281","spans":[{"id":"spn-30341","text":"What it does"}]}],"id":"blk-26279","kind":"table","rows":[[{"id":"blk-26282","spans":[{"id":"spn-30342","marks":["code"],"text":"npm run build:all"}]},{"id":"blk-26283","spans":[{"id":"spn-30343","text":"Runs the build step in every buildable project ("},{"id":"spn-30344","marks":["code"],"text":"WebHost.Systems"},{"id":"spn-30345","text":", "},{"id":"spn-30346","marks":["code"],"text":"bendscript.com"},{"id":"spn-30347","text":", "},{"id":"spn-30348","marks":["code"],"text":"runefort.com"},{"id":"spn-30349","text":", "},{"id":"spn-30350","marks":["code"],"text":"graphonomous"},{"id":"spn-30351","text":", "},{"id":"spn-30352","marks":["code"],"text":"PRISM"},{"id":"spn-30353","text":", "},{"id":"spn-30354","marks":["code"],"text":"specprompt.com"},{"id":"spn-30355","text":")."}]}],[{"id":"blk-26284","spans":[{"id":"spn-30356","marks":["code"],"text":"npm run test:all"}]},{"id":"blk-26285","spans":[{"id":"spn-30357","text":"Runs the test suite in every project that has one."}]}],[{"id":"blk-26286","spans":[{"id":"spn-30358","marks":["code"],"text":"npm run lint:all"}]},{"id":"blk-26287","spans":[{"id":"spn-30359","text":"Lints the Node projects; runs "},{"id":"spn-30360","marks":["code"],"text":"mix format --check-formatted"},{"id":"spn-30361","text":" on Elixir projects."}]}],[{"id":"blk-26288","spans":[{"id":"spn-30362","marks":["code"],"text":"npm run typecheck:all"}]},{"id":"blk-26289","spans":[{"id":"spn-30363","marks":["code"],"text":"svelte-check"},{"id":"spn-30364","text":" + "},{"id":"spn-30365","marks":["code"],"text":"tsc"},{"id":"spn-30366","text":" + "},{"id":"spn-30367","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-30368","text":" across the relevant projects."}]}]]},{"id":"blk-26290","kind":"heading","level":3,"spans":[{"id":"spn-30369","text":"Individual project commands (for reference)"}]},{"id":"blk-26291","kind":"paragraph","spans":[{"id":"spn-30370","text":"If you'd rather run commands directly:"}]},{"id":"blk-26292","kind":"code","language":"bash","text":"# graphonomous (Elixir)\ncd graphonomous && mix deps.get && mix compile --warnings-as-errors && mix test\n\n# WebHost.Systems (Node monorepo)\ncd WebHost.Systems && npm install && npm run dev\n\n# AmpersandBoxDesign reference impl\ncd AmpersandBoxDesign/reference/elixir/ampersand_core && mix deps.get && mix escript.build\n\n# PRISM / SpecPrompt (Phoenix)\ncd PRISM && mix deps.get && mix phx.server\ncd specprompt.com && mix deps.get && mix phx.server\n\n# Any SvelteKit / Vite site\ncd runefort.com && npm install && npm run dev"},{"id":"blk-26293","kind":"heading","level":2,"spans":[{"id":"spn-30371","text":"Environment setup per site"}]},{"id":"blk-26294","kind":"paragraph","spans":[{"id":"spn-30372","text":"Most sites need a "},{"id":"spn-30373","marks":["code"],"text":".env.local"},{"id":"spn-30374","text":" pointing at local Supabase. The minimum required:"}]},{"id":"blk-26295","kind":"code","language":"env","text":"VITE_SUPABASE_URL=http://127.0.0.1:54321\nVITE_SUPABASE_ANON_KEY=<ANON_KEY from `npm run db:status`>"},{"id":"blk-26296","kind":"paragraph","spans":[{"id":"spn-30375","marks":["code"],"text":"npm run db:status -- -o env"},{"id":"spn-30376","text":" prints every key ready to paste. (The local anon key is deterministic for "},{"id":"spn-30377","marks":["code"],"text":"supabase-demo"},{"id":"spn-30378","text":", so the same key works across rebuilds.)"}]},{"id":"blk-26297","kind":"heading","level":2,"spans":[{"id":"spn-30379","text":"Conventions"}]},{"id":"blk-26298","items":[{"blocks":[{"id":"blk-26300","kind":"paragraph","spans":[{"id":"spn-30380","text":"Never commit secrets, API keys, or credentials."}]}],"id":"blk-26299","kind":"list-item"},{"blocks":[{"id":"blk-26302","kind":"paragraph","spans":[{"id":"spn-30381","text":"Elixir code follows "},{"id":"spn-30382","marks":["code"],"text":"mix format"},{"id":"spn-30383","text":"; TypeScript uses ESLint + Prettier."}]}],"id":"blk-26301","kind":"list-item"},{"blocks":[{"id":"blk-26304","kind":"paragraph","spans":[{"id":"spn-30384","text":"Each product has a spec under "},{"id":"spn-30385","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-30386","text":" (or "},{"id":"spn-30387","marks":["code"],"text":"prompts/"},{"id":"spn-30388","text":" for AmpersandBoxDesign / BendScript). "},{"id":"spn-30389","marks":["bold"],"text":"Always read the spec before changing code."}]}],"id":"blk-26303","kind":"list-item"},{"blocks":[{"id":"blk-26306","kind":"paragraph","spans":[{"id":"spn-30390","text":"Graphonomous MCP is the always-on memory loop for every session in this repo — see the \"Graphonomous session policy\" section in "},{"id":"spn-30391","marks":[{"kind":"link","predicate":"cites","target":"#/CLAUDE.md"}],"text":"CLAUDE.md"},{"id":"spn-30392","text":"."}]}],"id":"blk-26305","kind":"list-item"},{"blocks":[{"id":"blk-26308","kind":"paragraph","spans":[{"id":"spn-30393","text":"Per-product schema ranges in "},{"id":"spn-30394","marks":["code"],"text":"ampersand-supabase/migrations/"},{"id":"spn-30395","text":": "},{"id":"spn-30396","marks":["code"],"text":"000–009"},{"id":"spn-30397","text":" shared "},{"id":"spn-30398","marks":["code"],"text":"amp.*"},{"id":"spn-30399","text":", "},{"id":"spn-30400","marks":["code"],"text":"010–019"},{"id":"spn-30401","text":" "},{"id":"spn-30402","marks":["code"],"text":"kag.*"},{"id":"spn-30403","text":", "},{"id":"spn-30404","marks":["code"],"text":"020–029"},{"id":"spn-30405","text":" "},{"id":"spn-30406","marks":["code"],"text":"webhost.*"},{"id":"spn-30407","text":", "},{"id":"spn-30408","marks":["code"],"text":"030–039"},{"id":"spn-30409","text":" "},{"id":"spn-30410","marks":["code"],"text":"fleet.*"},{"id":"spn-30411","text":", "},{"id":"spn-30412","marks":["code"],"text":"040–049"},{"