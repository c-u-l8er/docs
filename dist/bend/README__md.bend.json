text":"/home/travis/ProjectAmp2"},{"id":"spn-30254","text":")."}]},{"id":"blk-26211","kind":"code","language":"bash","text":"# 1. Start the shared Supabase data layer (Postgres, Auth, PostgREST, Storage, Studio)\nnpm run db:start\n\n# 2. Start any preview site (examples)\nnpm run dev:runefort      # SvelteKit  → http://localhost:8093\nnpm run dev:bendscript    # SvelteKit  → http://localhost:5174\nnpm run dev:webhost       # Vite/React → http://localhost:5173\n\n# 3. Or start everything in one shot (Supabase + every site/service)\nnpm run dev:all\n\n# Shut down\nnpm run stop:all"},{"id":"blk-26212","kind":"heading","level":2,"spans":[{"id":"spn-30255","text":"Project scripts"}]},{"id":"blk-26213","kind":"paragraph","spans":[{"id":"spn-30256","text":"A top-level "},{"id":"spn-30257","marks":["code"],"text":"package.json"},{"id":"spn-30258","text":" exposes these orchestration commands. Each wraps the appropriate subproject command — nothing fancy, just convenience wrappers so you don't have to remember ports and working directories."}]},{"id":"blk-26214","kind":"heading","level":3,"spans":[{"id":"spn-30259","text":"Supabase (shared data layer)"}]},{"head":[{"id":"blk-26216","spans":[{"id":"spn-30260","text":"Command"}]},{"id":"blk-26217","spans":[{"id":"spn-30261","text":"What it does"}]}],"id":"blk-26215","kind":"table","rows":[[{"id":"blk-26218","spans":[{"id":"spn-30262","marks":["code"],"text":"npm run db:start"}]},{"id":"blk-26219","spans":[{"id":"spn-30263","marks":["code"],"text":"supabase start"},{"id":"spn-30264","text":" from "},{"id":"spn-30265","marks":["code"],"text":"ampersand-supabase/"},{"id":"spn-30266","text":" — boots Postgres, Auth, PostgREST, Studio, Edge Functions"}]}],[{"id":"blk-26220","spans":[{"id":"spn-30267","marks":["code"],"text":"npm run db:stop"}]},{"id":"blk-26221","spans":[{"id":"spn-30268","marks":["code"],"text":"supabase stop"},{"id":"spn-30269","text":" — shut down the full stack (data preserved in Docker volumes)"}]}],[{"id":"blk-26222","spans":[{"id":"spn-30270","marks":["code"],"text":"npm run db:status"}]},{"id":"blk-26223","spans":[{"id":"spn-30271","marks":["code"],"text":"supabase status"},{"id":"spn-30272","text":" — show ports, anon key, publishable key, service-role key"}]}],[{"id":"blk-26224","spans":[{"id":"spn-30273","marks":["code"],"text":"npm run db:reset"}]},{"id":"blk-26225","spans":[{"id":"spn-30274","marks":["code"],"text":"supabase db reset"},{"id":"spn-30275","text":" — re-apply all migrations + seed (destroys data)"}]}],[{"id":"blk-26226","spans":[{"id":"spn-30276","marks":["code"],"text":"npm run db:migrate"}]},{"id":"blk-26227","spans":[{"id":"spn-30277","marks":["code"],"text":"supabase migration up --local --include-all"},{"id":"spn-30278","text":" — apply pending migrations without resetting"}]}],[{"id":"blk-26228","spans":[{"id":"spn-30279","marks":["code"],"text":"npm run db:studio"}]},{"id":"blk-26229","spans":[{"id":"spn-30280","text":"Opens Studio at http://127.0.0.1:54323"}]}]]},{"id":"blk-26230","kind":"paragraph","spans":[{"id":"spn-30281","text":"Endpoints after "},{"id":"spn-30282","marks":["code"],"text":"db:start"},{"id":"spn-30283","text":":"}]},{"id":"blk-26231","items":[{"blocks":[{"id":"blk-26233","kind":"paragraph","spans":[{"id":"spn-30284","text":"API / PostgREST → http://127.0.0.1:54321"}]}],"id":"blk-26232","kind":"list-item"},{"blocks":[{"id":"blk-26235","kind":"paragraph","spans":[{"id":"spn-30285","text":"Postgres → "},{"id":"spn-30286","marks":["code"],"text":"postgresql://postgres:postgres@127.0.0.1:54322/postgres"}]}],"id":"blk-26234","kind":"list-item"},{"blocks":[{"id":"blk-26237","kind":"paragraph","spans":[{"id":"spn-30287","text":"Studio → http://127.0.0.1:54323"}]}],"id":"blk-26236","kind":"list-item"},{"blocks":[{"id":"blk-26239","kind":"paragraph","spans":[{"id":"spn-30288","text":"Mailpit → http://127.0.0.1:54324"}]}],"id":"blk-26238","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26240","kind":"paragraph","span