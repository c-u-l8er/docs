still boots Supabase first)\nnpm run dev:all\n\n# Shut down\nnpm run stop:all"},{"id":"blk-26465","kind":"heading","level":2,"spans":[{"id":"spn-31080","text":"Project scripts"}]},{"id":"blk-26466","kind":"paragraph","spans":[{"id":"spn-31081","text":"A top-level "},{"id":"spn-31082","marks":["code"],"text":"package.json"},{"id":"spn-31083","text":" exposes these orchestration commands. Each wraps the appropriate subproject command — nothing fancy, just convenience wrappers so you don't have to remember ports and working directories."}]},{"id":"blk-26467","kind":"heading","level":3,"spans":[{"id":"spn-31084","text":"Supabase — the ARCHIVED data layer (commands still work)"}]},{"blocks":[{"id":"blk-26469","kind":"paragraph","spans":[{"id":"spn-31085","marks":["bold"],"text":"The shared-Supabase route was abandoned by decision on 2026-07-30"},{"id":"spn-31086","text":"; the replacement is "},{"id":"spn-31087","marks":["code"],"text":"studbook"},{"id":"spn-31088","text":" ("},{"id":"spn-31089","marks":["code"],"text":"studbook/docs/spec/README.md"},{"id":"spn-31090","text":", "},{"id":"spn-31091","marks":["code"],"text":"spec"},{"id":"spn-31092","text":" rung, "},{"id":"spn-31093","marks":["italic"],"text":"\"do not build from this yet\""},{"id":"spn-31094","text":"). See "},{"id":"spn-31095","marks":[{"kind":"link","predicate":"cites","target":"#/CLAUDE.md"}],"text":"CLAUDE.md"},{"id":"spn-31096","text":" for why, and for the one unruled blocker (§10.2, where confidentiality comes from).  "},{"id":"spn-31097","marks":["bold"],"text":"Archived is not deleted."},{"id":"spn-31098","text":" Every command below still runs, the "},{"id":"spn-31099","marks":["bold"],"text":"40"},{"id":"spn-31100","text":" migrations still apply, and "},{"id":"spn-31101","marks":["bold"],"text":"nothing has migrated off it"},{"id":"spn-31102","text":" — "},{"id":"spn-31103","marks":["code"],"text":"fleet.*"},{"id":"spn-31104","text":" serves KILN and FleetPrompt "},{"id":"spn-31105","marks":[