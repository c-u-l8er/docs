],"text":"dev"},{"id":"spn-31209","text":" again."}]}],[{"id":"blk-26529","spans":[{"id":"spn-31210","marks":["code"],"text":"npm run stop:all"}]},{"id":"blk-26530","spans":[{"id":"spn-31211","text":"Stops Supabase and kills any lingering dev-server processes on the ports above."}]}]]},{"id":"blk-26531","kind":"heading","level":3,"spans":[{"id":"spn-31212","text":"Build / test"}]},{"head":[{"id":"blk-26533","spans":[{"id":"spn-31213","text":"Command"}]},{"id":"blk-26534","spans":[{"id":"spn-31214","text":"What it does"}]}],"id":"blk-26532","kind":"table","rows":[[{"id":"blk-26535","spans":[{"id":"spn-31215","marks":["code"],"text":"npm run build:all"}]},{"id":"blk-26536","spans":[{"id":"spn-31216","text":"Runs the build step in every buildable project ("},{"id":"spn-31217","marks":["code"],"text":"WebHost.Systems"},{"id":"spn-31218","text":", "},{"id":"spn-31219","marks":["code"],"text":"bendscript.com"},{"id":"spn-31220","text":", "},{"id":"spn-31221","marks":["code"],"text":"runefort.com"},{"id":"spn-31222","text":", "},{"id":"spn-31223","marks":["code"],"text":"graphonomous"},{"id":"spn-31224","text":", "},{"id":"spn-31225","marks":["code"],"text":"PRISM"},{"id":"spn-31226","text":", "},{"id":"spn-31227","marks":["code"],"text":"specprompt.com"},{"id":"spn-31228","text":")."}]}],[{"id":"blk-26537","spans":[{"id":"spn-31229","marks":["code"],"text":"npm run test:all"}]},{"id":"blk-26538","spans":[{"id":"spn-31230","text":"Runs the test suite in every project that has one."}]}],[{"id":"blk-26539","spans":[{"id":"spn-31231","marks":["code"],"text":"npm run lint:all"}]},{"id":"blk-26540","spans":[{"id":"spn-31232","text":"Lints the Node projects; runs "},{"id":"spn-31233","marks":["code"],"text":"mix format --check-formatted"},{"id":"spn-31234","text":" on Elixir projects."}]}],[{"id":"blk-26541","spans":[{"id":"spn-31235","marks":["code"],"text":"npm run typecheck:all"}]},{"id":"blk-26542","spans":[{"id":"spn-31236","marks":["code"],"text":"svelte-check"},{"id":"spn-31237","text":" + "},{"id":"spn-31238","marks":["code"],"text":"tsc"},{"id":"spn-31239","text":" + "},{"id":"spn-31240","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-31241","text":" across the relevant projects."}]}]]},{"id":"blk-26543","kind":"heading","level":3,"spans":[{"id":"spn-31242","text":"Individual project commands (for reference)"}]},{"id":"blk-26544","kind":"paragraph","spans":[{"id":"spn-31243","text":"If you'd rather run commands directly:"}]},{"id":"blk-26545","kind":"code","language":"bash","text":"# graphonomous (Elixir)\ncd graphonomous && mix deps.get && mix compile --warnings-as-errors && mix test\n\n# WebHost.Systems (Node monorepo)\ncd WebHost.Systems && npm install && npm run dev\n\n# AmpersandBoxDesign reference impl\ncd AmpersandBoxDesign/reference/elixir/ampersand_core && mix deps.get && mix escript.build\n\n# PRISM / SpecPrompt (Phoenix)\ncd PRISM && mix deps.get && mix phx.server\ncd specprompt.com && mix deps.get && mix phx.server\n\n# Any SvelteKit / Vite site\ncd runefort.com && npm install && npm run dev"},{"id":"blk-26546","kind":"heading","level":2,"spans":[{"id":"spn-31244","text":"Environment setup per site"}]},{"id":"blk-26547","kind":"paragraph","spans":[{"id":"spn-31245","text":"Most sites need a "},{"id":"spn-31246","marks":["code"],"text":".env.local"},{"id":"spn-31247","text":" pointing at local Supabase. The minimum required:"}]},{"id":"blk-26548","kind":"code","language":"env","text":"VITE_SUPABASE_URL=http://127.0.0.1:54321\nVITE_SUPABASE_ANON_KEY=<ANON_KEY from `npm run db:status`>"},{"id":"blk-26549","kind":"paragraph","spans":[{"id":"spn-31248","marks":["code"],"text":"npm run db:status -- -o env"},{"id":"spn-31249","text":" prints every key ready to paste. (The local anon key is deterministic for "},{"id":"spn-31250","marks":["code"],"text":"supabase-demo"},{"id":"spn-31251","text":", so the same key works across rebuilds.)"}]},{"id":"blk-26550","kind":"heading","level":2,"spans":[{"id":"spn-31252","text":"Conventions"}]},{"id":"blk-26551","items":[{"blocks":[{"id":"blk-26553","kind":"paragraph","spans":[{"id":"spn-31253","text":"Never commit secrets, API keys, or credentials."}]}],"id":"blk-26552","kind":"list-item"},{"blocks":[{"id":"blk-26555","kind":"paragraph","spans":[{"id":"spn-31254","text":"Elixir code follows "},{"id":"spn-31255","marks":["code"],"text":"mix format"},{"id":"spn-31256","text":"; TypeScript uses ESLint + Prettier."}]}],"id":"blk-26554","kind":"list-item"},{"blocks":[{"id":"blk-26557","kind":"paragraph","spans":[{"id":"spn-31257","text":"Each product has a spec under "},{"id":"spn-31258","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-31259","text":" (or "},{"id":"spn-31260","marks":["code"],"text":"prompts/"},{"id":"spn-31261","text":" for AmpersandBoxDesign / BendScript). "},{"id":"spn-31262","marks":["bold"],"text":"Always read the spec before changing code."}]}],"id":"blk-26556","kind":"list-item"},{"blocks":[{"id":"blk-26559","kind":"paragraph","spans":[{"id":"spn-31263","text":"Graphonomous MCP is the always-on memory loop for every session in this repo — see the \"Graphonomous session policy\" section in "},{"id":"spn-31264","marks":[{"kind":"link","predicate":"cites","target":"#/CLAUDE.md"}],"text":"CLAUDE.md"},{"id":"spn-31265","text":"."}]}],"id":"blk-26558","kind":"list-item"},{"blocks":[{"id":"blk-26561","kind":"paragraph","spans":[{"id":"spn-31266","text":"Per-product schema ranges in "},{"id":"spn-31267","marks":["code"],"text":"ampersand-supabase/migrations/"},{"id":"spn-31268","text":": "},{"id":"spn-31269","marks":["code"],"text":"000–009"},{"id":"spn-31270","text":" shared "},{"id":"spn-31271","marks":["code"],"text":"amp.*"},{"id":"spn-31272","text":", "},{"id":"spn-31273","marks":["code"],"text":"010–019"},{"id":"spn-31274","text":" "},{"id":"spn-31275","marks":["code"],"text":"kag.*"},{"id":"spn-31276","text":", "},{"id":"spn-31277","marks":["code"],"text":"020–029"},{"id":"spn-31278","tex