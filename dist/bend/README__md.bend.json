text":"/home/travis/ProjectAmp2"},{"id":"spn-30370","text":")."}]},{"id":"blk-26244","kind":"code","language":"bash","text":"# 1. Start the shared Supabase data layer (Postgres, Auth, PostgREST, Storage, Studio)\nnpm run db:start\n\n# 2. Start any preview site (examples)\nnpm run dev:runefort      # SvelteKit  → http://localhost:8093\nnpm run dev:bendscript    # SvelteKit  → http://localhost:5174\nnpm run dev:webhost       # Vite/React → http://localhost:5173\n\n# 3. Or start everything in one shot (Supabase + every site/service)\nnpm run dev:all\n\n# Shut down\nnpm run stop:all"},{"id":"blk-26245","kind":"heading","level":2,"spans":[{"id":"spn-30371","text":"Project scripts"}]},{"id":"blk-26246","kind":"paragraph","spans":[{"id":"spn-30372","text":"A top-level "},{"id":"spn-30373","marks":["code"],"text":"package.json"},{"id":"spn-30374","text":" exposes these orchestration commands. Each wraps the appropriate subproject command — nothing fancy, just convenience wrappers so you don't have to remember ports and working directories."}]},{"id":"blk-26247","kind":"heading","level":3,"spans":[{"id":"spn-30375","text":"Supabase (shared data layer)"}]},{"head":[{"id":"blk-26249","spans":[{"id":"spn-30376","text":"Command"}]},{"id":"blk-26250","spans":[{"id":"spn-30377","text":"What it does"}]}],"id":"blk-26248","kind":"table","rows":[[{"id":"blk-26251","spans":[{"id":"spn-30378","marks":["code"],"text":"npm run db:start"}]},{"id":"blk-26252","spans":[{"id":"spn-30379","marks":["code"],"text":"supabase start"},{"id":"spn-30380","text":" from "},{"id":"spn-30381","marks":["code"],"text":"ampersand-supabase/"},{"id":"spn-30382","text":" — boots Postgres, Auth, PostgREST, Studio, Edge Functions"}]}],[{"id":"blk-26253","spans":[{"id":"spn-30383","marks":["code"],"text":"npm run db:stop"}]},{"id":"blk-26254","spans":[{"id":"spn-30384","marks":["code"],"text":"supabase stop"},{"id":"spn-30385","text":" — shut down the full stack (data preserved in Docker volumes)"}]}],[{"id":"blk-26255","spans":[{"id":"spn-30386","marks":["code"],"text":"npm run db:status"}]},{"id":"blk-26256","spans":[{"id":"spn-30387","marks":["code"],"text":"supabase status"},{"id":"spn-30388","text":" — show ports, anon key, publishable key, service-role key"}]}],[{"id":"blk-26257","spans":[{"id":"spn-30389","marks":["code"],"text":"npm run db:reset"}]},{"id":"blk-26258","spans":[{"id":"spn-30390","marks":["code"],"text":"supabase db reset"},{"id":"spn-30391","text":" — re-apply all migrations + seed (destroys data)"}]}],[{"id":"blk-26259","spans":[{"id":"spn-30392","marks":["code"],"text":"npm run db:migrate"}]},{"id":"blk-26260","spans":[{"id":"spn-30393","marks":["code"],"text":"supabase migration up --local --include-all"},{"id":"spn-30394","text":" — apply pending migrations without resetting"}]}],[{"id":"blk-26261","spans":[{"id":"spn-30395","marks":["code"],"text":"npm run db:studio"}]},{"id":"blk-26262","spans":[{"id":"spn-30396","text":"Opens Studio at http://127.0.0.1:54323"}]}]]},{"id":"blk-26263","kind":"paragraph","spans":[{"id":"spn-30397","text":"Endpoints after "},{"id":"spn-30398","marks":["code"],"text":"db:start"},{"id":"spn-30399","text":":"}]},{"id":"blk-26264","items":[{"blocks":[{"id":"blk-26266","kind":"paragraph","spans":[{"id":"spn-30400","text":"API / PostgREST → http://127.0.0.1:54321"}]}],"id":"blk-26265","kind":"list-item"},{"blocks":[{"id":"blk-26268","kind":"paragraph","spans":[{"id":"spn-30401","text":"Postgres → "},{"id":"spn-30402","marks":["code"],"text":"postgresql://postgres:postgres@127.0.0.1:54322/postgres"}]}],"id":"blk-26267","kind":"list-item"},{"blocks":[{"id":"blk-26270","kind":"paragraph","spans":[{"id":"spn-30403","text":"Studio → http://127.0.0.1:54323"}]}],"id":"blk-26269","kind":"list-item"},{"blocks":[{"id":"blk-26272","kind":"paragraph","spans":[{"id":"spn-30404","text":"Mailpit → http://127.0.0.1:54324"}]}],"id":"blk-26271","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26273","kind":"paragraph","span