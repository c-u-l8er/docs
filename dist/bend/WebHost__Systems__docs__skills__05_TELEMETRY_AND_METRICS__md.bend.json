{"bendscript":"0.1","blocks":[{"id":"blk-24355","kind":"heading","level":1,"spans":[{"id":"spn-27829","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-24357","kind":"paragraph","spans":[{"id":"spn-27830","marks":["bold"],"text":"Purpose:"},{"id":"spn-27831","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-24356","kind":"quote"},{"id":"blk-24358","kind":"paragraph","spans":[{"id":"spn-27832","text":"---"}]},{"id":"blk-24359","kind":"heading","level":2,"spans":[{"id":"spn-27833","text":"Telemetry Flow"}]},{"id":"blk-24360","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-24361","kind":"paragraph","spans":[{"id":"spn-27834","text":"---"}]},{"id":"blk-24362","kind":"heading","level":2,"spans":[{"id":"spn-27835","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-24364","spans":[{"id":"spn-27836","text":"Field"}]},{"id":"blk-24365","spans":[{"id":"spn-27837","text":"Type"}]},{"id":"blk-24366","spans":[{"id":"spn-27838","text":"Description"}]}],"id":"blk-24363","kind":"table","rows":[[{"id":"blk-24367","spans":[{"id":"spn-27839","marks":["code"],"text":"id"}]},{"id":"blk-24368","spans":[{"id":"spn-27840","text":"UUID"}]},{"id":"blk-24369","spans":[{"id":"spn-27841","text":"Auto-generated"}]}],[{"id":"blk-24370","spans":[{"id":"spn-27842","marks":["code"],"text":"user_id"}]},{"id":"blk-24371","spans":[{"id":"spn-27843","text":"UUID"}]},{"id":"blk-24372","spans":[{"id":"spn-27844","text":"Event owner"}]}],[{"id":"blk-24373","spans":[{"id":"spn-27845","marks":["code"],"text":"agent_id"}]},{"id":"blk-24374","spans":[{"id":"spn-27846","text":"UUID"}]},{"id":"blk-24375","spans":[{"id":"spn-27847","text":"Agent that was invoked"}]}],[{"id":"blk-24376","spans":[{"id":"spn-27848","marks":["code"],"text":"deployment_id"}]},{"id":"blk-24377","spans":[{"id":"spn-27849","text":"UUID"}]},{"id":"blk-24378","spans":[{"id":"spn-27850","text":"Specific deployment version"}]}],[{"id":"blk-24379","spans":[{"id":"spn-27851","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24380","spans":[{"id":"spn-27852","text":"enum"}]},{"id":"blk-24381","spans":[{"id":"spn-27853","marks":["code"],"text":"cloudflare"},{"id":"spn-27854","text":" or "},{"id":"spn-27855","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24382","spans":[{"id":"spn-27856","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-24383","spans":[{"id":"spn-27857","text":"bigint"}]},{"id":"blk-24384","spans":[{"id":"spn-27858","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-24385","spans":[{"id":"spn-27859","marks":["code"],"text":"requests"}]},{"id":"blk-24386","spans":[{"id":"spn-27860","text":"int"}]},{"id":"blk-24387","spans":[{"id":"spn-27861","text":"Always 1 per event"}]}],[{"id":"blk-24388","spans":[{"id":"spn-27862","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-24389","spans":[{"id":"spn-27863","text":"int"}]},{"id":"blk-24390","spans":[{"id":"spn-27864","text":"Token count (actual or estimated)"}]}],[{"id":"blk-24391","spans":[{"id":"spn-27865","marks":["code"],"text":"compute_ms"}]},{"id":"blk-24392","spans":[{"id":"spn-27866","text":"int"}]},{"id":"blk-24393","spans":[{"id":"spn-27867","text":"Wall-clock execution time"}]}],[{"id":"blk-24394","spans":[{"id":"spn-27868","marks":["code"],"text":"errors"}]},{"id":"blk-24395","spans":[{"id":"spn-27869","text":"int"}]},{"id":"blk-24396","spans":[{"id":"spn-27870","text":"0 or 1"}]}],[{"id":"blk-24397","spans":[{"id":"spn-27871","marks":["code"],"text":"error_class"}]},{"id":"blk-24398","spans":[{"id":"spn-27872","text":"string?"}]},{"id":"blk-24399","spans":[{"id":"spn-27873","text":"Error category if errors > 0"}]}],[{"id":"blk-24400","spans":[{"id":"spn-27874","marks":["code"],"text":"provider_details"}]},{"id":"blk-24401","spans":[{"id":"spn-27875","text":"JSONB"}]},{"id":"blk-24402","spans":[{"id":"spn-27876","text":"Provider-specific metadata"}]}],[{"id":"blk-24403","spans":[{"id":"spn-27877","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-24404","spans":[{"id":"spn-27878","text":"numeric"}]},{"id":"blk-24405","spans":[{"id":"spn-27879","text":"Estimated cost in USD"}]}],[{"id":"blk-24406","spans":[{"id":"spn-27880","marks":["code"],"text":"trace_id"}]},{"id":"blk-24407","spans":[{"id":"spn-27881","text":"string"}]},{"id":"blk-24408","spans":[{"id":"spn-27882","text":"Correlation ID for tracing"}]}]]},{"id":"blk-24409","kind":"paragraph","spans":[{"id":"spn-27883","text":"---"}]},{"id":"blk-24410","kind":"heading","level":2,"spans":[{"id":"spn-27884","text":"Telemetry Authentication"}]},{"id":"blk-24411","kind":"paragraph","spans":[{"id":"spn-27885","text":"Unauthenticated telemetry events are "},{"id":"spn-27886","marks":["bold"],"text":"rejected"},{"id":"spn-27887","text":". Two authentication methods are supported:"}]},{"id":"blk-24412","kind":"heading","level":3,"spans":[{"id":"spn-27888","text":"Option A: HMAC Signature"}]},{"id":"blk-24413","kind":"paragraph","spans":[{"id":"spn-27889","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-24414","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-24415","kind":"paragraph","spans":[{"id":"spn-27890","text":"The ingestion endpoint verifies:"}]},{"id":"blk-24416","kind":"paragraph","spans":[{"id":"spn-27891","text":"1. Timestamp is within 5-minute window (anti-replay) 2. HMAC matches "},{"id":"spn-27892","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]},{"id":"blk-24417","kind":"heading","level":3,"spans":[{"id":"spn-27893","text":"Option B: Signed JWT"}]},{"id":"blk-24418","kind":"paragraph","spans":[{"id":"spn-27894","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-24419","kind":"paragraph","spans":[{"id":"spn-27895","text":"---"}]},{"id":"blk-24420","kind":"heading","level":2,"spans":[{"id":"spn-27896","text":"Ingestion Endpoint"}]},{"id":"blk-24421","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-24422","kind":"paragraph","spans":[{"id":"spn-27897","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-27898","marks":["code"],"text":"metrics_events"},{"id":"spn-27899","text":". Attribution fields ("},{"id":"spn-27900","marks":["code"],"text":"agent_id"},{"id":"spn-27901","text":", "},{"id":"spn-27902","marks":["code"],"text":"deployment_id"},{"id":"spn-27903","text":", "},{"id":"spn-27904","marks":["code"],"text":"user_id"},{"id":"spn-27905","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-24423","kind":"paragraph","spans":[{"id":"spn-27906","text":"---"}]},{"id":"blk-24424","kind":"heading","level":2,"spans":[{"id":"spn-27907","text":"Aggregation via pg_cron"}]},{"id":"blk-24425","kind":"paragraph","spans":[{"id":"spn-27908","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-27909","marks":["code"],"text":"billing_usage"},{"id":"spn-27910","text":":"}]},{"id":"blk-24426","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-24427","kind":"paragraph","spans":[{"id":"spn-27911","text":"---"}]},{"id":"blk-24428","kind":"heading","level":2,"spans":[{"id":"spn-27912","text":"Time-Series Queries"}]},{"id":"blk-24429","kind":"paragraph","spans":[{"id":"spn-27913","text":"The dashboard queries "},{"id":"spn-27914","marks":["code"],"text":"metrics_events"},{"id":"spn-27915","text":" for time-series visualization:"}]},{"id":"blk-24430","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-24431","kind":"paragraph","spans":[{"id":"spn-27916","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-24432","kind":"paragraph","spans":[{"id":"spn-27917","text":"---"}]},{"id":"blk-24433","kind":"heading","level":2,"spans":[{"id":"spn-27918","text":"Checklist"}]},{"id":"blk-24434","items":[{"blocks":[{"id":"blk-24436","kind":"paragraph","spans":[{"id":"spn-27919","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-24435","kind":"list-item"},{"blocks":[{"id":"blk-24438","kind":"paragraph","spans":[{"id":"spn-27920","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-24437","kind":"list-item"},{"blocks":[{"id":"blk-24440","kind":"paragraph","spans":[{"id":"spn-27921","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-24439","kind":"list-item"},{"blocks":[{"id":"blk-24442","kind":"paragraph","spans":[{"id":"spn-27922","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-24441","kind":"list-item"},{"blocks":[{"id":"blk-24444","kind":"paragraph","spans":[{"id":"spn-27923","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-24443","kind":"list-item"},{"blocks":[{"id":"blk-24446","kind":"paragraph","spans":[{"id":"spn-27924","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-24445","kind":"list-item"},{"blocks":[{"id":"blk-24448","kind":"paragraph","spans":[{"id":"spn-27925","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-24447","kind":"list-item"},{"blocks":[{"id":"blk-24450","kind":"paragraph","spans":[{"id":"spn-27926","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-27927","marks":["code"],"text":"agent_id"},{"id":"spn-27928","text":", "},{"id":"spn-27929","marks":["code"],"text":"timestamp_ms"},{"id":"spn-27930","text":")"}]}],"id":"blk-24449","kind":"list-item"},{"blocks":[{"id":"blk-24452","kind":"paragraph","spans":[{"id":"spn-27931","text":"[ ] "},{"id":"spn-27932","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-27933","text":" uses provider-specific calculators"}]}],"id":"blk-24451","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraedawkxswrn5vf4rm4gflzzli6ba7ywebz3rboenusht7uvmbhhqa","vocabulary":"ampersand.docs.fs.v1"}