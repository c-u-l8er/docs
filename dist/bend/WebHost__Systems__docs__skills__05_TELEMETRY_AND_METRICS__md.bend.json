{"bendscript":"0.1","blocks":[{"id":"blk-44172","kind":"heading","level":1,"spans":[{"id":"spn-73624","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-44174","kind":"paragraph","spans":[{"id":"spn-73625","marks":["bold"],"text":"Purpose:"},{"id":"spn-73626","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-44173","kind":"quote"},{"id":"blk-44175","kind":"heading","level":2,"spans":[{"id":"spn-73627","text":"Telemetry Flow"}]},{"id":"blk-44176","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-44177","kind":"heading","level":2,"spans":[{"id":"spn-73628","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-44179","spans":[{"id":"spn-73629","text":"Field"}]},{"id":"blk-44180","spans":[{"id":"spn-73630","text":"Type"}]},{"id":"blk-44181","spans":[{"id":"spn-73631","text":"Description"}]}],"id":"blk-44178","kind":"table","rows":[[{"id":"blk-44182","spans":[{"id":"spn-73632","marks":["code"],"text":"id"}]},{"id":"blk-44183","spans":[{"id":"spn-73633","text":"UUID"}]},{"id":"blk-44184","spans":[{"id":"spn-73634","text":"Auto-generated"}]}],[{"id":"blk-44185","spans":[{"id":"spn-73635","marks":["code"],"text":"user_id"}]},{"id":"blk-44186","spans":[{"id":"spn-73636","text":"UUID"}]},{"id":"blk-44187","spans":[{"id":"spn-73637","text":"Event owner"}]}],[{"id":"blk-44188","spans":[{"id":"spn-73638","marks":["code"],"text":"agent_id"}]},{"id":"blk-44189","spans":[{"id":"spn-73639","text":"UUID"}]},{"id":"blk-44190","spans":[{"id":"spn-73640","text":"Agent that was invoked"}]}],[{"id":"blk-44191","spans":[{"id":"spn-73641","marks":["code"],"text":"deployment_id"}]},{"id":"blk-44192","spans":[{"id":"spn-73642","text":"UUID"}]},{"id":"blk-44193","spans":[{"id":"spn-73643","text":"Specific deployment version"}]}],[{"id":"blk-44194","spans":[{"id":"spn-73644","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-44195","spans":[{"id":"spn-73645","text":"enum"}]},{"id":"blk-44196","spans":[{"id":"spn-73646","marks":["code"],"text":"cloudflare"},{"id":"spn-73647","text":" or "},{"id":"spn-73648","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-44197","spans":[{"id":"spn-73649","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-44198","spans":[{"id":"spn-73650","text":"bigint"}]},{"id":"blk-44199","spans":[{"id":"spn-73651","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-44200","spans":[{"id":"spn-73652","marks":["code"],"text":"requests"}]},{"id":"blk-44201","spans":[{"id":"spn-73653","text":"int"}]},{"id":"blk-44202","spans":[{"id":"spn-73654","text":"Always 1 per event"}]}],[{"id":"blk-44203","spans":[{"id":"spn-73655","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-44204","spans":[{"id":"spn-73656","text":"int"}]},{"id":"blk-44205","spans":[{"id":"spn-73657","text":"Token count (actual or estimated)"}]}],[{"id":"blk-44206","spans":[{"id":"spn-73658","marks":["code"],"text":"compute_ms"}]},{"id":"blk-44207","spans":[{"id":"spn-73659","text":"int"}]},{"id":"blk-44208","spans":[{"id":"spn-73660","text":"Wall-clock execution time"}]}],[{"id":"blk-44209","spans":[{"id":"spn-73661","marks":["code"],"text":"errors"}]},{"id":"blk-44210","spans":[{"id":"spn-73662","text":"int"}]},{"id":"blk-44211","spans":[{"id":"spn-73663","text":"0 or 1"}]}],[{"id":"blk-44212","spans":[{"id":"spn-73664","marks":["code"],"text":"error_class"}]},{"id":"blk-44213","spans":[{"id":"spn-73665","text":"string?"}]},{"id":"blk-44214","spans":[{"id":"spn-73666","text":"Error category if errors > 0"}]}],[{"id":"blk-44215","spans":[{"id":"spn-73667","marks":["code"],"text":"provider_details"}]},{"id":"blk-44216","spans":[{"id":"spn-73668","text":"JSONB"}]},{"id":"blk-44217","spans":[{"id":"spn-73669","text":"Provider-specific metadata"}]}],[{"id":"blk-44218","spans":[{"id":"spn-73670","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-44219","spans":[{"id":"spn-73671","text":"numeric"}]},{"id":"blk-44220","spans":[{"id":"spn-73672","text":"Estimated cost in USD"}]}],[{"id":"blk-44221","spans":[{"id":"spn-73673","marks":["code"],"text":"trace_id"}]},{"id":"blk-44222","spans":[{"id":"spn-73674","text":"string"}]},{"id":"blk-44223","spans":[{"id":"spn-73675","text":"Correlation ID for tracing"}]}]]},{"id":"blk-44224","kind":"heading","level":2,"spans":[{"id":"spn-73676","text":"Telemetry Authentication"}]},{"id":"blk-44225","kind":"paragraph","spans":[{"id":"spn-73677","text":"Unauthenticated telemetry events are "},{"id":"spn-73678","marks":["bold"],"text":"rejected"},{"id":"spn-73679","text":". Two authentication methods are supported:"}]},{"id":"blk-44226","kind":"heading","level":3,"spans":[{"id":"spn-73680","text":"Option A: HMAC Signature"}]},{"id":"blk-44227","kind":"paragraph","spans":[{"id":"spn-73681","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-44228","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-44229","kind":"paragraph","spans":[{"id":"spn-73682","text":"The ingestion endpoint verifies:"}]},{"id":"blk-44230","items":[{"blocks":[{"id":"blk-44232","kind":"paragraph","spans":[{"id":"spn-73683","text":"Timestamp is within 5-minute window (anti-replay)"}]}],"id":"blk-44231","kind":"list-item"},{"blocks":[{"id":"blk-44234","kind":"paragraph","spans":[{"id":"spn-73684","text":"HMAC matches "},{"id":"spn-73685","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]}],"id":"blk-44233","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-44235","kind":"heading","level":3,"spans":[{"id":"spn-73686","text":"Option B: Signed JWT"}]},{"id":"blk-44236","kind":"paragraph","spans":[{"id":"spn-73687","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-44237","kind":"heading","level":2,"spans":[{"id":"spn-73688","text":"Ingestion Endpoint"}]},{"id":"blk-44238","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-44239","kind":"paragraph","spans":[{"id":"spn-73689","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-73690","marks":["code"],"text":"metrics_events"},{"id":"spn-73691","text":". Attribution fields ("},{"id":"spn-73692","marks":["code"],"text":"agent_id"},{"id":"spn-73693","text":", "},{"id":"spn-73694","marks":["code"],"text":"deployment_id"},{"id":"spn-73695","text":", "},{"id":"spn-73696","marks":["code"],"text":"user_id"},{"id":"spn-73697","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-44240","kind":"heading","level":2,"spans":[{"id":"spn-73698","text":"Aggregation via pg_cron"}]},{"id":"blk-44241","kind":"paragraph","spans":[{"id":"spn-73699","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-73700","marks":["code"],"text":"billing_usage"},{"id":"spn-73701","text":":"}]},{"id":"blk-44242","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-44243","kind":"heading","level":2,"spans":[{"id":"spn-73702","text":"Time-Series Queries"}]},{"id":"blk-44244","kind":"paragraph","spans":[{"id":"spn-73703","text":"The dashboard queries "},{"id":"spn-73704","marks":["code"],"text":"metrics_events"},{"id":"spn-73705","text":" for time-series visualization:"}]},{"id":"blk-44245","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-44246","kind":"paragraph","spans":[{"id":"spn-73706","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-44247","kind":"heading","level":2,"spans":[{"id":"spn-73707","text":"Checklist"}]},{"id":"blk-44248","items":[{"blocks":[{"id":"blk-44250","kind":"paragraph","spans":[{"id":"spn-73708","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-44249","kind":"list-item"},{"blocks":[{"id":"blk-44252","kind":"paragraph","spans":[{"id":"spn-73709","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-44251","kind":"list-item"},{"blocks":[{"id":"blk-44254","kind":"paragraph","spans":[{"id":"spn-73710","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-44253","kind":"list-item"},{"blocks":[{"id":"blk-44256","kind":"paragraph","spans":[{"id":"spn-73711","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-44255","kind":"list-item"},{"blocks":[{"id":"blk-44258","kind":"paragraph","spans":[{"id":"spn-73712","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-44257","kind":"list-item"},{"blocks":[{"id":"blk-44260","kind":"paragraph","spans":[{"id":"spn-73713","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-44259","kind":"list-item"},{"blocks":[{"id":"blk-44262","kind":"paragraph","spans":[{"id":"spn-73714","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-44261","kind":"list-item"},{"blocks":[{"id":"blk-44264","kind":"paragraph","spans":[{"id":"spn-73715","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-73716","marks":["code"],"text":"agent_id"},{"id":"spn-73717","text":", "},{"id":"spn-73718","marks":["code"],"text":"timestamp_ms"},{"id":"spn-73719","text":")"}]}],"id":"blk-44263","kind":"list-item"},{"blocks":[{"id":"blk-44266","kind":"paragraph","spans":[{"id":"spn-73720","text":"[ ] "},{"id":"spn-73721","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-73722","text":" uses provider-specific calculators"}]}],"id":"blk-44265","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieramctu42maiy5zlbhfwz6om6w24dg6ovje2ix3bffo2nvmsaupiw6a","vocabulary":"ampersand.docs.fs.v1"}