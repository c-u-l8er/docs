{"bendscript":"0.1","blocks":[{"id":"blk-24950","kind":"heading","level":1,"spans":[{"id":"spn-29631","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-24952","kind":"paragraph","spans":[{"id":"spn-29632","marks":["bold"],"text":"Purpose:"},{"id":"spn-29633","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-24951","kind":"quote"},{"id":"blk-24953","kind":"paragraph","spans":[{"id":"spn-29634","text":"---"}]},{"id":"blk-24954","kind":"heading","level":2,"spans":[{"id":"spn-29635","text":"Telemetry Flow"}]},{"id":"blk-24955","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-24956","kind":"paragraph","spans":[{"id":"spn-29636","text":"---"}]},{"id":"blk-24957","kind":"heading","level":2,"spans":[{"id":"spn-29637","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-24959","spans":[{"id":"spn-29638","text":"Field"}]},{"id":"blk-24960","spans":[{"id":"spn-29639","text":"Type"}]},{"id":"blk-24961","spans":[{"id":"spn-29640","text":"Description"}]}],"id":"blk-24958","kind":"table","rows":[[{"id":"blk-24962","spans":[{"id":"spn-29641","marks":["code"],"text":"id"}]},{"id":"blk-24963","spans":[{"id":"spn-29642","text":"UUID"}]},{"id":"blk-24964","spans":[{"id":"spn-29643","text":"Auto-generated"}]}],[{"id":"blk-24965","spans":[{"id":"spn-29644","marks":["code"],"text":"user_id"}]},{"id":"blk-24966","spans":[{"id":"spn-29645","text":"UUID"}]},{"id":"blk-24967","spans":[{"id":"spn-29646","text":"Event owner"}]}],[{"id":"blk-24968","spans":[{"id":"spn-29647","marks":["code"],"text":"agent_id"}]},{"id":"blk-24969","spans":[{"id":"spn-29648","text":"UUID"}]},{"id":"blk-24970","spans":[{"id":"spn-29649","text":"Agent that was invoked"}]}],[{"id":"blk-24971","spans":[{"id":"spn-29650","marks":["code"],"text":"deployment_id"}]},{"id":"blk-24972","spans":[{"id":"spn-29651","text":"UUID"}]},{"id":"blk-24973","spans":[{"id":"spn-29652","text":"Specific deployment version"}]}],[{"id":"blk-24974","spans":[{"id":"spn-29653","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24975","spans":[{"id":"spn-29654","text":"enum"}]},{"id":"blk-24976","spans":[{"id":"spn-29655","marks":["code"],"text":"cloudflare"},{"id":"spn-29656","text":" or "},{"id":"spn-29657","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24977","spans":[{"id":"spn-29658","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-24978","spans":[{"id":"spn-29659","text":"bigint"}]},{"id":"blk-24979","spans":[{"id":"spn-29660","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-24980","spans":[{"id":"spn-29661","marks":["code"],"text":"requests"}]},{"id":"blk-24981","spans":[{"id":"spn-29662","text":"int"}]},{"id":"blk-24982","spans":[{"id":"spn-29663","text":"Always 1 per event"}]}],[{"id":"blk-24983","spans":[{"id":"spn-29664","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-24984","spans":[{"id":"spn-29665","text":"int"}]},{"id":"blk-24985","spans":[{"id":"spn-29666","text":"Token count (actual or estimated)"}]}],[{"id":"blk-24986","spans":[{"id":"spn-29667","marks":["code"],"text":"compute_ms"}]},{"id":"blk-24987","spans":[{"id":"spn-29668","text":"int"}]},{"id":"blk-24988","spans":[{"id":"spn-29669","text":"Wall-clock execution time"}]}],[{"id":"blk-24989","spans":[{"id":"spn-29670","marks":["code"],"text":"errors"}]},{"id":"blk-24990","spans":[{"id":"spn-29671","text":"int"}]},{"id":"blk-24991","spans":[{"id":"spn-29672","text":"0 or 1"}]}],[{"id":"blk-24992","spans":[{"id":"spn-29673","marks":["code"],"text":"error_class"}]},{"id":"blk-24993","spans":[{"id":"spn-29674","text":"string?"}]},{"id":"blk-24994","spans":[{"id":"spn-29675","text":"Error category if errors > 0"}]}],[{"id":"blk-24995","spans":[{"id":"spn-29676","marks":["code"],"text":"provider_details"}]},{"id":"blk-24996","spans":[{"id":"spn-29677","text":"JSONB"}]},{"id":"blk-24997","spans":[{"id":"spn-29678","text":"Provider-specific metadata"}]}],[{"id":"blk-24998","spans":[{"id":"spn-29679","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-24999","spans":[{"id":"spn-29680","text":"numeric"}]},{"id":"blk-25000","spans":[{"id":"spn-29681","text":"Estimated cost in USD"}]}],[{"id":"blk-25001","spans":[{"id":"spn-29682","marks":["code"],"text":"trace_id"}]},{"id":"blk-25002","spans":[{"id":"spn-29683","text":"string"}]},{"id":"blk-25003","spans":[{"id":"spn-29684","text":"Correlation ID for tracing"}]}]]},{"id":"blk-25004","kind":"paragraph","spans":[{"id":"spn-29685","text":"---"}]},{"id":"blk-25005","kind":"heading","level":2,"spans":[{"id":"spn-29686","text":"Telemetry Authentication"}]},{"id":"blk-25006","kind":"paragraph","spans":[{"id":"spn-29687","text":"Unauthenticated telemetry events are "},{"id":"spn-29688","marks":["bold"],"text":"rejected"},{"id":"spn-29689","text":". Two authentication methods are supported:"}]},{"id":"blk-25007","kind":"heading","level":3,"spans":[{"id":"spn-29690","text":"Option A: HMAC Signature"}]},{"id":"blk-25008","kind":"paragraph","spans":[{"id":"spn-29691","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-25009","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-25010","kind":"paragraph","spans":[{"id":"spn-29692","text":"The ingestion endpoint verifies:"}]},{"id":"blk-25011","kind":"paragraph","spans":[{"id":"spn-29693","text":"1. Timestamp is within 5-minute window (anti-replay) 2. HMAC matches "},{"id":"spn-29694","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]},{"id":"blk-25012","kind":"heading","level":3,"spans":[{"id":"spn-29695","text":"Option B: Signed JWT"}]},{"id":"blk-25013","kind":"paragraph","spans":[{"id":"spn-29696","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-25014","kind":"paragraph","spans":[{"id":"spn-29697","text":"---"}]},{"id":"blk-25015","kind":"heading","level":2,"spans":[{"id":"spn-29698","text":"Ingestion Endpoint"}]},{"id":"blk-25016","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-25017","kind":"paragraph","spans":[{"id":"spn-29699","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-29700","marks":["code"],"text":"metrics_events"},{"id":"spn-29701","text":". Attribution fields ("},{"id":"spn-29702","marks":["code"],"text":"agent_id"},{"id":"spn-29703","text":", "},{"id":"spn-29704","marks":["code"],"text":"deployment_id"},{"id":"spn-29705","text":", "},{"id":"spn-29706","marks":["code"],"text":"user_id"},{"id":"spn-29707","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-25018","kind":"paragraph","spans":[{"id":"spn-29708","text":"---"}]},{"id":"blk-25019","kind":"heading","level":2,"spans":[{"id":"spn-29709","text":"Aggregation via pg_cron"}]},{"id":"blk-25020","kind":"paragraph","spans":[{"id":"spn-29710","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-29711","marks":["code"],"text":"billing_usage"},{"id":"spn-29712","text":":"}]},{"id":"blk-25021","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-25022","kind":"paragraph","spans":[{"id":"spn-29713","text":"---"}]},{"id":"blk-25023","kind":"heading","level":2,"spans":[{"id":"spn-29714","text":"Time-Series Queries"}]},{"id":"blk-25024","kind":"paragraph","spans":[{"id":"spn-29715","text":"The dashboard queries "},{"id":"spn-29716","marks":["code"],"text":"metrics_events"},{"id":"spn-29717","text":" for time-series visualization:"}]},{"id":"blk-25025","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-25026","kind":"paragraph","spans":[{"id":"spn-29718","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-25027","kind":"paragraph","spans":[{"id":"spn-29719","text":"---"}]},{"id":"blk-25028","kind":"heading","level":2,"spans":[{"id":"spn-29720","text":"Checklist"}]},{"id":"blk-25029","items":[{"blocks":[{"id":"blk-25031","kind":"paragraph","spans":[{"id":"spn-29721","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-25030","kind":"list-item"},{"blocks":[{"id":"blk-25033","kind":"paragraph","spans":[{"id":"spn-29722","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-25032","kind":"list-item"},{"blocks":[{"id":"blk-25035","kind":"paragraph","spans":[{"id":"spn-29723","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-25034","kind":"list-item"},{"blocks":[{"id":"blk-25037","kind":"paragraph","spans":[{"id":"spn-29724","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-25036","kind":"list-item"},{"blocks":[{"id":"blk-25039","kind":"paragraph","spans":[{"id":"spn-29725","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-25038","kind":"list-item"},{"blocks":[{"id":"blk-25041","kind":"paragraph","spans":[{"id":"spn-29726","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-25040","kind":"list-item"},{"blocks":[{"id":"blk-25043","kind":"paragraph","spans":[{"id":"spn-29727","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-25042","kind":"list-item"},{"blocks":[{"id":"blk-25045","kind":"paragraph","spans":[{"id":"spn-29728","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-29729","marks":["code"],"text":"agent_id"},{"id":"spn-29730","text":", "},{"id":"spn-29731","marks":["code"],"text":"timestamp_ms"},{"id":"spn-29732","text":")"}]}],"id":"blk-25044","kind":"list-item"},{"blocks":[{"id":"blk-25047","kind":"paragraph","spans":[{"id":"spn-29733","text":"[ ] "},{"id":"spn-29734","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-29735","text":" uses provider-specific calculators"}]}],"id":"blk-25046","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieracnvc324pwg2n6bu6xel2wo3eokmhnqzgfcery6sflvt557xg6iza","vocabulary":"ampersand.docs.fs.v1"}