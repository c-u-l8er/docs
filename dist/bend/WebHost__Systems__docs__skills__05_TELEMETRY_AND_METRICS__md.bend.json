{"bendscript":"0.1","blocks":[{"id":"blk-43456","kind":"heading","level":1,"spans":[{"id":"spn-71256","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-43458","kind":"paragraph","spans":[{"id":"spn-71257","marks":["bold"],"text":"Purpose:"},{"id":"spn-71258","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-43457","kind":"quote"},{"id":"blk-43459","kind":"heading","level":2,"spans":[{"id":"spn-71259","text":"Telemetry Flow"}]},{"id":"blk-43460","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-43461","kind":"heading","level":2,"spans":[{"id":"spn-71260","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-43463","spans":[{"id":"spn-71261","text":"Field"}]},{"id":"blk-43464","spans":[{"id":"spn-71262","text":"Type"}]},{"id":"blk-43465","spans":[{"id":"spn-71263","text":"Description"}]}],"id":"blk-43462","kind":"table","rows":[[{"id":"blk-43466","spans":[{"id":"spn-71264","marks":["code"],"text":"id"}]},{"id":"blk-43467","spans":[{"id":"spn-71265","text":"UUID"}]},{"id":"blk-43468","spans":[{"id":"spn-71266","text":"Auto-generated"}]}],[{"id":"blk-43469","spans":[{"id":"spn-71267","marks":["code"],"text":"user_id"}]},{"id":"blk-43470","spans":[{"id":"spn-71268","text":"UUID"}]},{"id":"blk-43471","spans":[{"id":"spn-71269","text":"Event owner"}]}],[{"id":"blk-43472","spans":[{"id":"spn-71270","marks":["code"],"text":"agent_id"}]},{"id":"blk-43473","spans":[{"id":"spn-71271","text":"UUID"}]},{"id":"blk-43474","spans":[{"id":"spn-71272","text":"Agent that was invoked"}]}],[{"id":"blk-43475","spans":[{"id":"spn-71273","marks":["code"],"text":"deployment_id"}]},{"id":"blk-43476","spans":[{"id":"spn-71274","text":"UUID"}]},{"id":"blk-43477","spans":[{"id":"spn-71275","text":"Specific deployment version"}]}],[{"id":"blk-43478","spans":[{"id":"spn-71276","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-43479","spans":[{"id":"spn-71277","text":"enum"}]},{"id":"blk-43480","spans":[{"id":"spn-71278","marks":["code"],"text":"cloudflare"},{"id":"spn-71279","text":" or "},{"id":"spn-71280","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-43481","spans":[{"id":"spn-71281","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-43482","spans":[{"id":"spn-71282","text":"bigint"}]},{"id":"blk-43483","spans":[{"id":"spn-71283","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-43484","spans":[{"id":"spn-71284","marks":["code"],"text":"requests"}]},{"id":"blk-43485","spans":[{"id":"spn-71285","text":"int"}]},{"id":"blk-43486","spans":[{"id":"spn-71286","text":"Always 1 per event"}]}],[{"id":"blk-43487","spans":[{"id":"spn-71287","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-43488","spans":[{"id":"spn-71288","text":"int"}]},{"id":"blk-43489","spans":[{"id":"spn-71289","text":"Token count (actual or estimated)"}]}],[{"id":"blk-43490","spans":[{"id":"spn-71290","marks":["code"],"text":"compute_ms"}]},{"id":"blk-43491","spans":[{"id":"spn-71291","text":"int"}]},{"id":"blk-43492","spans":[{"id":"spn-71292","text":"Wall-clock execution time"}]}],[{"id":"blk-43493","spans":[{"id":"spn-71293","marks":["code"],"text":"errors"}]},{"id":"blk-43494","spans":[{"id":"spn-71294","text":"int"}]},{"id":"blk-43495","spans":[{"id":"spn-71295","text":"0 or 1"}]}],[{"id":"blk-43496","spans":[{"id":"spn-71296","marks":["code"],"text":"error_class"}]},{"id":"blk-43497","spans":[{"id":"spn-71297","text":"string?"}]},{"id":"blk-43498","spans":[{"id":"spn-71298","text":"Error category if errors > 0"}]}],[{"id":"blk-43499","spans":[{"id":"spn-71299","marks":["code"],"text":"provider_details"}]},{"id":"blk-43500","spans":[{"id":"spn-71300","text":"JSONB"}]},{"id":"blk-43501","spans":[{"id":"spn-71301","text":"Provider-specific metadata"}]}],[{"id":"blk-43502","spans":[{"id":"spn-71302","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-43503","spans":[{"id":"spn-71303","text":"numeric"}]},{"id":"blk-43504","spans":[{"id":"spn-71304","text":"Estimated cost in USD"}]}],[{"id":"blk-43505","spans":[{"id":"spn-71305","marks":["code"],"text":"trace_id"}]},{"id":"blk-43506","spans":[{"id":"spn-71306","text":"string"}]},{"id":"blk-43507","spans":[{"id":"spn-71307","text":"Correlation ID for tracing"}]}]]},{"id":"blk-43508","kind":"heading","level":2,"spans":[{"id":"spn-71308","text":"Telemetry Authentication"}]},{"id":"blk-43509","kind":"paragraph","spans":[{"id":"spn-71309","text":"Unauthenticated telemetry events are "},{"id":"spn-71310","marks":["bold"],"text":"rejected"},{"id":"spn-71311","text":". Two authentication methods are supported:"}]},{"id":"blk-43510","kind":"heading","level":3,"spans":[{"id":"spn-71312","text":"Option A: HMAC Signature"}]},{"id":"blk-43511","kind":"paragraph","spans":[{"id":"spn-71313","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-43512","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-43513","kind":"paragraph","spans":[{"id":"spn-71314","text":"The ingestion endpoint verifies:"}]},{"id":"blk-43514","items":[{"blocks":[{"id":"blk-43516","kind":"paragraph","spans":[{"id":"spn-71315","text":"Timestamp is within 5-minute window (anti-replay)"}]}],"id":"blk-43515","kind":"list-item"},{"blocks":[{"id":"blk-43518","kind":"paragraph","spans":[{"id":"spn-71316","text":"HMAC matches "},{"id":"spn-71317","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]}],"id":"blk-43517","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43519","kind":"heading","level":3,"spans":[{"id":"spn-71318","text":"Option B: Signed JWT"}]},{"id":"blk-43520","kind":"paragraph","spans":[{"id":"spn-71319","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-43521","kind":"heading","level":2,"spans":[{"id":"spn-71320","text":"Ingestion Endpoint"}]},{"id":"blk-43522","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-43523","kind":"paragraph","spans":[{"id":"spn-71321","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-71322","marks":["code"],"text":"metrics_events"},{"id":"spn-71323","text":". Attribution fields ("},{"id":"spn-71324","marks":["code"],"text":"agent_id"},{"id":"spn-71325","text":", "},{"id":"spn-71326","marks":["code"],"text":"deployment_id"},{"id":"spn-71327","text":", "},{"id":"spn-71328","marks":["code"],"text":"user_id"},{"id":"spn-71329","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-43524","kind":"heading","level":2,"spans":[{"id":"spn-71330","text":"Aggregation via pg_cron"}]},{"id":"blk-43525","kind":"paragraph","spans":[{"id":"spn-71331","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-71332","marks":["code"],"text":"billing_usage"},{"id":"spn-71333","text":":"}]},{"id":"blk-43526","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-43527","kind":"heading","level":2,"spans":[{"id":"spn-71334","text":"Time-Series Queries"}]},{"id":"blk-43528","kind":"paragraph","spans":[{"id":"spn-71335","text":"The dashboard queries "},{"id":"spn-71336","marks":["code"],"text":"metrics_events"},{"id":"spn-71337","text":" for time-series visualization:"}]},{"id":"blk-43529","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-43530","kind":"paragraph","spans":[{"id":"spn-71338","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-43531","kind":"heading","level":2,"spans":[{"id":"spn-71339","text":"Checklist"}]},{"id":"blk-43532","items":[{"blocks":[{"id":"blk-43534","kind":"paragraph","spans":[{"id":"spn-71340","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-43533","kind":"list-item"},{"blocks":[{"id":"blk-43536","kind":"paragraph","spans":[{"id":"spn-71341","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-43535","kind":"list-item"},{"blocks":[{"id":"blk-43538","kind":"paragraph","spans":[{"id":"spn-71342","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-43537","kind":"list-item"},{"blocks":[{"id":"blk-43540","kind":"paragraph","spans":[{"id":"spn-71343","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-43539","kind":"list-item"},{"blocks":[{"id":"blk-43542","kind":"paragraph","spans":[{"id":"spn-71344","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-43541","kind":"list-item"},{"blocks":[{"id":"blk-43544","kind":"paragraph","spans":[{"id":"spn-71345","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-43543","kind":"list-item"},{"blocks":[{"id":"blk-43546","kind":"paragraph","spans":[{"id":"spn-71346","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-43545","kind":"list-item"},{"blocks":[{"id":"blk-43548","kind":"paragraph","spans":[{"id":"spn-71347","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-71348","marks":["code"],"text":"agent_id"},{"id":"spn-71349","text":", "},{"id":"spn-71350","marks":["code"],"text":"timestamp_ms"},{"id":"spn-71351","text":")"}]}],"id":"blk-43547","kind":"list-item"},{"blocks":[{"id":"blk-43550","kind":"paragraph","spans":[{"id":"spn-71352","text":"[ ] "},{"id":"spn-71353","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-71354","text":" uses provider-specific calculators"}]}],"id":"blk-43549","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierasodock4xfi6aymedebldka7ltkrkubpipki3rgswd2tswd4syhxa","vocabulary":"ampersand.docs.fs.v1"}