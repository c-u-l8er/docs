{"bendscript":"0.1","blocks":[{"id":"blk-25436","kind":"heading","level":1,"spans":[{"id":"spn-30747","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-25438","kind":"paragraph","spans":[{"id":"spn-30748","marks":["bold"],"text":"Purpose:"},{"id":"spn-30749","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-25437","kind":"quote"},{"id":"blk-25439","kind":"paragraph","spans":[{"id":"spn-30750","text":"---"}]},{"id":"blk-25440","kind":"heading","level":2,"spans":[{"id":"spn-30751","text":"Telemetry Flow"}]},{"id":"blk-25441","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-25442","kind":"paragraph","spans":[{"id":"spn-30752","text":"---"}]},{"id":"blk-25443","kind":"heading","level":2,"spans":[{"id":"spn-30753","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-25445","spans":[{"id":"spn-30754","text":"Field"}]},{"id":"blk-25446","spans":[{"id":"spn-30755","text":"Type"}]},{"id":"blk-25447","spans":[{"id":"spn-30756","text":"Description"}]}],"id":"blk-25444","kind":"table","rows":[[{"id":"blk-25448","spans":[{"id":"spn-30757","marks":["code"],"text":"id"}]},{"id":"blk-25449","spans":[{"id":"spn-30758","text":"UUID"}]},{"id":"blk-25450","spans":[{"id":"spn-30759","text":"Auto-generated"}]}],[{"id":"blk-25451","spans":[{"id":"spn-30760","marks":["code"],"text":"user_id"}]},{"id":"blk-25452","spans":[{"id":"spn-30761","text":"UUID"}]},{"id":"blk-25453","spans":[{"id":"spn-30762","text":"Event owner"}]}],[{"id":"blk-25454","spans":[{"id":"spn-30763","marks":["code"],"text":"agent_id"}]},{"id":"blk-25455","spans":[{"id":"spn-30764","text":"UUID"}]},{"id":"blk-25456","spans":[{"id":"spn-30765","text":"Agent that was invoked"}]}],[{"id":"blk-25457","spans":[{"id":"spn-30766","marks":["code"],"text":"deployment_id"}]},{"id":"blk-25458","spans":[{"id":"spn-30767","text":"UUID"}]},{"id":"blk-25459","spans":[{"id":"spn-30768","text":"Specific deployment version"}]}],[{"id":"blk-25460","spans":[{"id":"spn-30769","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-25461","spans":[{"id":"spn-30770","text":"enum"}]},{"id":"blk-25462","spans":[{"id":"spn-30771","marks":["code"],"text":"cloudflare"},{"id":"spn-30772","text":" or "},{"id":"spn-30773","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-25463","spans":[{"id":"spn-30774","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-25464","spans":[{"id":"spn-30775","text":"bigint"}]},{"id":"blk-25465","spans":[{"id":"spn-30776","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-25466","spans":[{"id":"spn-30777","marks":["code"],"text":"requests"}]},{"id":"blk-25467","spans":[{"id":"spn-30778","text":"int"}]},{"id":"blk-25468","spans":[{"id":"spn-30779","text":"Always 1 per event"}]}],[{"id":"blk-25469","spans":[{"id":"spn-30780","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-25470","spans":[{"id":"spn-30781","text":"int"}]},{"id":"blk-25471","spans":[{"id":"spn-30782","text":"Token count (actual or estimated)"}]}],[{"id":"blk-25472","spans":[{"id":"spn-30783","marks":["code"],"text":"compute_ms"}]},{"id":"blk-25473","spans":[{"id":"spn-30784","text":"int"}]},{"id":"blk-25474","spans":[{"id":"spn-30785","text":"Wall-clock execution time"}]}],[{"id":"blk-25475","spans":[{"id":"spn-30786","marks":["code"],"text":"errors"}]},{"id":"blk-25476","spans":[{"id":"spn-30787","text":"int"}]},{"id":"blk-25477","spans":[{"id":"spn-30788","text":"0 or 1"}]}],[{"id":"blk-25478","spans":[{"id":"spn-30789","marks":["code"],"text":"error_class"}]},{"id":"blk-25479","spans":[{"id":"spn-30790","text":"string?"}]},{"id":"blk-25480","spans":[{"id":"spn-30791","text":"Error category if errors > 0"}]}],[{"id":"blk-25481","spans":[{"id":"spn-30792","marks":["code"],"text":"provider_details"}]},{"id":"blk-25482","spans":[{"id":"spn-30793","text":"JSONB"}]},{"id":"blk-25483","spans":[{"id":"spn-30794","text":"Provider-specific metadata"}]}],[{"id":"blk-25484","spans":[{"id":"spn-30795","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-25485","spans":[{"id":"spn-30796","text":"numeric"}]},{"id":"blk-25486","spans":[{"id":"spn-30797","text":"Estimated cost in USD"}]}],[{"id":"blk-25487","spans":[{"id":"spn-30798","marks":["code"],"text":"trace_id"}]},{"id":"blk-25488","spans":[{"id":"spn-30799","text":"string"}]},{"id":"blk-25489","spans":[{"id":"spn-30800","text":"Correlation ID for tracing"}]}]]},{"id":"blk-25490","kind":"paragraph","spans":[{"id":"spn-30801","text":"---"}]},{"id":"blk-25491","kind":"heading","level":2,"spans":[{"id":"spn-30802","text":"Telemetry Authentication"}]},{"id":"blk-25492","kind":"paragraph","spans":[{"id":"spn-30803","text":"Unauthenticated telemetry events are "},{"id":"spn-30804","marks":["bold"],"text":"rejected"},{"id":"spn-30805","text":". Two authentication methods are supported:"}]},{"id":"blk-25493","kind":"heading","level":3,"spans":[{"id":"spn-30806","text":"Option A: HMAC Signature"}]},{"id":"blk-25494","kind":"paragraph","spans":[{"id":"spn-30807","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-25495","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-25496","kind":"paragraph","spans":[{"id":"spn-30808","text":"The ingestion endpoint verifies:"}]},{"id":"blk-25497","kind":"paragraph","spans":[{"id":"spn-30809","text":"1. Timestamp is within 5-minute window (anti-replay) 2. HMAC matches "},{"id":"spn-30810","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]},{"id":"blk-25498","kind":"heading","level":3,"spans":[{"id":"spn-30811","text":"Option B: Signed JWT"}]},{"id":"blk-25499","kind":"paragraph","spans":[{"id":"spn-30812","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-25500","kind":"paragraph","spans":[{"id":"spn-30813","text":"---"}]},{"id":"blk-25501","kind":"heading","level":2,"spans":[{"id":"spn-30814","text":"Ingestion Endpoint"}]},{"id":"blk-25502","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-25503","kind":"paragraph","spans":[{"id":"spn-30815","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-30816","marks":["code"],"text":"metrics_events"},{"id":"spn-30817","text":". Attribution fields ("},{"id":"spn-30818","marks":["code"],"text":"agent_id"},{"id":"spn-30819","text":", "},{"id":"spn-30820","marks":["code"],"text":"deployment_id"},{"id":"spn-30821","text":", "},{"id":"spn-30822","marks":["code"],"text":"user_id"},{"id":"spn-30823","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-25504","kind":"paragraph","spans":[{"id":"spn-30824","text":"---"}]},{"id":"blk-25505","kind":"heading","level":2,"spans":[{"id":"spn-30825","text":"Aggregation via pg_cron"}]},{"id":"blk-25506","kind":"paragraph","spans":[{"id":"spn-30826","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-30827","marks":["code"],"text":"billing_usage"},{"id":"spn-30828","text":":"}]},{"id":"blk-25507","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-25508","kind":"paragraph","spans":[{"id":"spn-30829","text":"---"}]},{"id":"blk-25509","kind":"heading","level":2,"spans":[{"id":"spn-30830","text":"Time-Series Queries"}]},{"id":"blk-25510","kind":"paragraph","spans":[{"id":"spn-30831","text":"The dashboard queries "},{"id":"spn-30832","marks":["code"],"text":"metrics_events"},{"id":"spn-30833","text":" for time-series visualization:"}]},{"id":"blk-25511","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-25512","kind":"paragraph","spans":[{"id":"spn-30834","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-25513","kind":"paragraph","spans":[{"id":"spn-30835","text":"---"}]},{"id":"blk-25514","kind":"heading","level":2,"spans":[{"id":"spn-30836","text":"Checklist"}]},{"id":"blk-25515","items":[{"blocks":[{"id":"blk-25517","kind":"paragraph","spans":[{"id":"spn-30837","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-25516","kind":"list-item"},{"blocks":[{"id":"blk-25519","kind":"paragraph","spans":[{"id":"spn-30838","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-25518","kind":"list-item"},{"blocks":[{"id":"blk-25521","kind":"paragraph","spans":[{"id":"spn-30839","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-25520","kind":"list-item"},{"blocks":[{"id":"blk-25523","kind":"paragraph","spans":[{"id":"spn-30840","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-25522","kind":"list-item"},{"blocks":[{"id":"blk-25525","kind":"paragraph","spans":[{"id":"spn-30841","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-25524","kind":"list-item"},{"blocks":[{"id":"blk-25527","kind":"paragraph","spans":[{"id":"spn-30842","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-25526","kind":"list-item"},{"blocks":[{"id":"blk-25529","kind":"paragraph","spans":[{"id":"spn-30843","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-25528","kind":"list-item"},{"blocks":[{"id":"blk-25531","kind":"paragraph","spans":[{"id":"spn-30844","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-30845","marks":["code"],"text":"agent_id"},{"id":"spn-30846","text":", "},{"id":"spn-30847","marks":["code"],"text":"timestamp_ms"},{"id":"spn-30848","text":")"}]}],"id":"blk-25530","kind":"list-item"},{"blocks":[{"id":"blk-25533","kind":"paragraph","spans":[{"id":"spn-30849","text":"[ ] "},{"id":"spn-30850","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-30851","text":" uses provider-specific calculators"}]}],"id":"blk-25532","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierauju7lgbc2db3gyvwtdro6slpjrwlb2hyulo32za4emvkbfble54a","vocabulary":"ampersand.docs.fs.v1"}