{"bendscript":"0.1","blocks":[{"id":"blk-24465","kind":"heading","level":1,"spans":[{"id":"spn-28458","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-24467","kind":"paragraph","spans":[{"id":"spn-28459","marks":["bold"],"text":"Purpose:"},{"id":"spn-28460","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-24466","kind":"quote"},{"id":"blk-24468","kind":"paragraph","spans":[{"id":"spn-28461","text":"---"}]},{"id":"blk-24469","kind":"heading","level":2,"spans":[{"id":"spn-28462","text":"Telemetry Flow"}]},{"id":"blk-24470","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-24471","kind":"paragraph","spans":[{"id":"spn-28463","text":"---"}]},{"id":"blk-24472","kind":"heading","level":2,"spans":[{"id":"spn-28464","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-24474","spans":[{"id":"spn-28465","text":"Field"}]},{"id":"blk-24475","spans":[{"id":"spn-28466","text":"Type"}]},{"id":"blk-24476","spans":[{"id":"spn-28467","text":"Description"}]}],"id":"blk-24473","kind":"table","rows":[[{"id":"blk-24477","spans":[{"id":"spn-28468","marks":["code"],"text":"id"}]},{"id":"blk-24478","spans":[{"id":"spn-28469","text":"UUID"}]},{"id":"blk-24479","spans":[{"id":"spn-28470","text":"Auto-generated"}]}],[{"id":"blk-24480","spans":[{"id":"spn-28471","marks":["code"],"text":"user_id"}]},{"id":"blk-24481","spans":[{"id":"spn-28472","text":"UUID"}]},{"id":"blk-24482","spans":[{"id":"spn-28473","text":"Event owner"}]}],[{"id":"blk-24483","spans":[{"id":"spn-28474","marks":["code"],"text":"agent_id"}]},{"id":"blk-24484","spans":[{"id":"spn-28475","text":"UUID"}]},{"id":"blk-24485","spans":[{"id":"spn-28476","text":"Agent that was invoked"}]}],[{"id":"blk-24486","spans":[{"id":"spn-28477","marks":["code"],"text":"deployment_id"}]},{"id":"blk-24487","spans":[{"id":"spn-28478","text":"UUID"}]},{"id":"blk-24488","spans":[{"id":"spn-28479","text":"Specific deployment version"}]}],[{"id":"blk-24489","spans":[{"id":"spn-28480","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24490","spans":[{"id":"spn-28481","text":"enum"}]},{"id":"blk-24491","spans":[{"id":"spn-28482","marks":["code"],"text":"cloudflare"},{"id":"spn-28483","text":" or "},{"id":"spn-28484","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24492","spans":[{"id":"spn-28485","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-24493","spans":[{"id":"spn-28486","text":"bigint"}]},{"id":"blk-24494","spans":[{"id":"spn-28487","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-24495","spans":[{"id":"spn-28488","marks":["code"],"text":"requests"}]},{"id":"blk-24496","spans":[{"id":"spn-28489","text":"int"}]},{"id":"blk-24497","spans":[{"id":"spn-28490","text":"Always 1 per event"}]}],[{"id":"blk-24498","spans":[{"id":"spn-28491","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-24499","spans":[{"id":"spn-28492","text":"int"}]},{"id":"blk-24500","spans":[{"id":"spn-28493","text":"Token count (actual or estimated)"}]}],[{"id":"blk-24501","spans":[{"id":"spn-28494","marks":["code"],"text":"compute_ms"}]},{"id":"blk-24502","spans":[{"id":"spn-28495","text":"int"}]},{"id":"blk-24503","spans":[{"id":"spn-28496","text":"Wall-clock execution time"}]}],[{"id":"blk-24504","spans":[{"id":"spn-28497","marks":["code"],"text":"errors"}]},{"id":"blk-24505","spans":[{"id":"spn-28498","text":"int"}]},{"id":"blk-24506","spans":[{"id":"spn-28499","text":"0 or 1"}]}],[{"id":"blk-24507","spans":[{"id":"spn-28500","marks":["code"],"text":"error_class"}]},{"id":"blk-24508","spans":[{"id":"spn-28501","text":"string?"}]},{"id":"blk-24509","spans":[{"id":"spn-28502","text":"Error category if errors > 0"}]}],[{"id":"blk-24510","spans":[{"id":"spn-28503","marks":["code"],"text":"provider_details"}]},{"id":"blk-24511","spans":[{"id":"spn-28504","text":"JSONB"}]},{"id":"blk-24512","spans":[{"id":"spn-28505","text":"Provider-specific metadata"}]}],[{"id":"blk-24513","spans":[{"id":"spn-28506","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-24514","spans":[{"id":"spn-28507","text":"numeric"}]},{"id":"blk-24515","spans":[{"id":"spn-28508","text":"Estimated cost in USD"}]}],[{"id":"blk-24516","spans":[{"id":"spn-28509","marks":["code"],"text":"trace_id"}]},{"id":"blk-24517","spans":[{"id":"spn-28510","text":"string"}]},{"id":"blk-24518","spans":[{"id":"spn-28511","text":"Correlation ID for tracing"}]}]]},{"id":"blk-24519","kind":"paragraph","spans":[{"id":"spn-28512","text":"---"}]},{"id":"blk-24520","kind":"heading","level":2,"spans":[{"id":"spn-28513","text":"Telemetry Authentication"}]},{"id":"blk-24521","kind":"paragraph","spans":[{"id":"spn-28514","text":"Unauthenticated telemetry events are "},{"id":"spn-28515","marks":["bold"],"text":"rejected"},{"id":"spn-28516","text":". Two authentication methods are supported:"}]},{"id":"blk-24522","kind":"heading","level":3,"spans":[{"id":"spn-28517","text":"Option A: HMAC Signature"}]},{"id":"blk-24523","kind":"paragraph","spans":[{"id":"spn-28518","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-24524","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-24525","kind":"paragraph","spans":[{"id":"spn-28519","text":"The ingestion endpoint verifies:"}]},{"id":"blk-24526","kind":"paragraph","spans":[{"id":"spn-28520","text":"1. Timestamp is within 5-minute window (anti-replay) 2. HMAC matches "},{"id":"spn-28521","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]},{"id":"blk-24527","kind":"heading","level":3,"spans":[{"id":"spn-28522","text":"Option B: Signed JWT"}]},{"id":"blk-24528","kind":"paragraph","spans":[{"id":"spn-28523","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-24529","kind":"paragraph","spans":[{"id":"spn-28524","text":"---"}]},{"id":"blk-24530","kind":"heading","level":2,"spans":[{"id":"spn-28525","text":"Ingestion Endpoint"}]},{"id":"blk-24531","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-24532","kind":"paragraph","spans":[{"id":"spn-28526","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-28527","marks":["code"],"text":"metrics_events"},{"id":"spn-28528","text":". Attribution fields ("},{"id":"spn-28529","marks":["code"],"text":"agent_id"},{"id":"spn-28530","text":", "},{"id":"spn-28531","marks":["code"],"text":"deployment_id"},{"id":"spn-28532","text":", "},{"id":"spn-28533","marks":["code"],"text":"user_id"},{"id":"spn-28534","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-24533","kind":"paragraph","spans":[{"id":"spn-28535","text":"---"}]},{"id":"blk-24534","kind":"heading","level":2,"spans":[{"id":"spn-28536","text":"Aggregation via pg_cron"}]},{"id":"blk-24535","kind":"paragraph","spans":[{"id":"spn-28537","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-28538","marks":["code"],"text":"billing_usage"},{"id":"spn-28539","text":":"}]},{"id":"blk-24536","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-24537","kind":"paragraph","spans":[{"id":"spn-28540","text":"---"}]},{"id":"blk-24538","kind":"heading","level":2,"spans":[{"id":"spn-28541","text":"Time-Series Queries"}]},{"id":"blk-24539","kind":"paragraph","spans":[{"id":"spn-28542","text":"The dashboard queries "},{"id":"spn-28543","marks":["code"],"text":"metrics_events"},{"id":"spn-28544","text":" for time-series visualization:"}]},{"id":"blk-24540","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-24541","kind":"paragraph","spans":[{"id":"spn-28545","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-24542","kind":"paragraph","spans":[{"id":"spn-28546","text":"---"}]},{"id":"blk-24543","kind":"heading","level":2,"spans":[{"id":"spn-28547","text":"Checklist"}]},{"id":"blk-24544","items":[{"blocks":[{"id":"blk-24546","kind":"paragraph","spans":[{"id":"spn-28548","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-24545","kind":"list-item"},{"blocks":[{"id":"blk-24548","kind":"paragraph","spans":[{"id":"spn-28549","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-24547","kind":"list-item"},{"blocks":[{"id":"blk-24550","kind":"paragraph","spans":[{"id":"spn-28550","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-24549","kind":"list-item"},{"blocks":[{"id":"blk-24552","kind":"paragraph","spans":[{"id":"spn-28551","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-24551","kind":"list-item"},{"blocks":[{"id":"blk-24554","kind":"paragraph","spans":[{"id":"spn-28552","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-24553","kind":"list-item"},{"blocks":[{"id":"blk-24556","kind":"paragraph","spans":[{"id":"spn-28553","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-24555","kind":"list-item"},{"blocks":[{"id":"blk-24558","kind":"paragraph","spans":[{"id":"spn-28554","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-24557","kind":"list-item"},{"blocks":[{"id":"blk-24560","kind":"paragraph","spans":[{"id":"spn-28555","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-28556","marks":["code"],"text":"agent_id"},{"id":"spn-28557","text":", "},{"id":"spn-28558","marks":["code"],"text":"timestamp_ms"},{"id":"spn-28559","text":")"}]}],"id":"blk-24559","kind":"list-item"},{"blocks":[{"id":"blk-24562","kind":"paragraph","spans":[{"id":"spn-28560","text":"[ ] "},{"id":"spn-28561","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-28562","text":" uses provider-specific calculators"}]}],"id":"blk-24561","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierawywfsq7kfmr52efipvqxywdx33xrr7xddi2jakrc2xmubjxfc7sa","vocabulary":"ampersand.docs.fs.v1"}