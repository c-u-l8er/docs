{"bendscript":"0.1","blocks":[{"id":"blk-75789","kind":"heading","level":1,"spans":[{"id":"spn-107115","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-75791","kind":"paragraph","spans":[{"id":"spn-107116","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-75790","kind":"quote"},{"id":"blk-75792","kind":"heading","level":2,"spans":[{"id":"spn-107117","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-75794","spans":[{"id":"spn-107118","text":"#"}]},{"id":"blk-75795","spans":[{"id":"spn-107119","text":"Name"}]},{"id":"blk-75796","spans":[{"id":"spn-107120","text":"Severity"}]},{"id":"blk-75797","spans":[{"id":"spn-107121","text":"Description"}]}],"id":"blk-75793","kind":"table","rows":[[{"id":"blk-75798","spans":[{"id":"spn-107122","text":"1"}]},{"id":"blk-75799","spans":[{"id":"spn-107123","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-75800","spans":[{"id":"spn-107124","text":"Critical"}]},{"id":"blk-75801","spans":[{"id":"spn-107125","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-75802","spans":[{"id":"spn-107126","text":"2"}]},{"id":"blk-75803","spans":[{"id":"spn-107127","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-75804","spans":[{"id":"spn-107128","text":"Critical"}]},{"id":"blk-75805","spans":[{"id":"spn-107129","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-75806","spans":[{"id":"spn-107130","text":"3"}]},{"id":"blk-75807","spans":[{"id":"spn-107131","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-75808","spans":[{"id":"spn-107132","text":"High"}]},{"id":"blk-75809","spans":[{"id":"spn-107133","text":"Ignoring the audit trail"}]}],[{"id":"blk-75810","spans":[{"id":"spn-107134","text":"4"}]},{"id":"blk-75811","spans":[{"id":"spn-107135","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-75812","spans":[{"id":"spn-107136","text":"High"}]},{"id":"blk-75813","spans":[{"id":"spn-107137","text":"Not integrating with Delegatic"}]}],[{"id":"blk-75814","spans":[{"id":"spn-107138","text":"5"}]},{"id":"blk-75815","spans":[{"id":"spn-107139","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-75816","spans":[{"id":"spn-107140","text":"High"}]},{"id":"blk-75817","spans":[{"id":"spn-107141","text":"Treating the shim as a runtime"}]}],[{"id":"blk-75818","spans":[{"id":"spn-107142","text":"6"}]},{"id":"blk-75819","spans":[{"id":"spn-107143","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-75820","spans":[{"id":"spn-107144","text":"High"}]},{"id":"blk-75821","spans":[{"id":"spn-107145","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-75822","spans":[{"id":"spn-107146","text":"7"}]},{"id":"blk-75823","spans":[{"id":"spn-107147","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-75824","spans":[{"id":"spn-107148","text":"Medium"}]},{"id":"blk-75825","spans":[{"id":"spn-107149","text":"Not monitoring shim overhead"}]}],[{"id":"blk-75826","spans":[{"id":"spn-107150","text":"8"}]},{"id":"blk-75827","spans":[{"id":"spn-107151","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-75828","spans":[{"id":"spn-107152","text":"Medium"}]},{"id":"blk-75829","spans":[{"id":"spn-107153","text":"Skipping lifecycle states"}]}]]},{"id":"blk-75830","kind":"heading","level":2,"spans":[{"id":"spn-107154","text":"Critical Anti-Patterns"}]},{"id":"blk-75831","kind":"heading","level":3,"spans":[{"id":"spn-107155","text":"1 — Permission Sprawl"}]},{"id":"blk-75832","kind":"paragraph","spans":[{"id":"spn-107156","marks":["bold"],"text":"The mistake:"},{"id":"spn-107157","text":" Granting "},{"id":"spn-107158","marks":["code"],"text":"*"},{"id":"spn-107159","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-75833","kind":"paragraph","spans":[{"id":"spn-107160","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75834","items":[{"blocks":[{"id":"blk-75836","kind":"paragraph","spans":[{"id":"spn-107161","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-107162","marks":["code"],"text":"allow"}]}],"id":"blk-75835","kind":"list-item"},{"blocks":[{"id":"blk-75838","kind":"paragraph","spans":[{"id":"spn-107163","text":"The audit trail fills with meaningless "},{"id":"spn-107164","marks":["code"],"text":"ok"},{"id":"spn-107165","text":" entries"}]}],"id":"blk-75837","kind":"list-item"},{"blocks":[{"id":"blk-75840","kind":"paragraph","spans":[{"id":"spn-107166","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-75839","kind":"list-item"},{"blocks":[{"id":"blk-75842","kind":"paragraph","spans":[{"id":"spn-107167","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-75841","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75843","kind":"paragraph","spans":[{"id":"spn-107168","marks":["bold"],"text":"The fix:"},{"id":"spn-107169","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-75844","kind":"paragraph","spans":[{"id":"spn-107170","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-75845","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-75846","kind":"paragraph","spans":[{"id":"spn-107171","marks":["bold"],"text":"After (good):"}]},{"id":"blk-75847","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-75848","kind":"heading","level":3,"spans":[{"id":"spn-107172","text":"2 — Trust Skipping"}]},{"id":"blk-75849","kind":"paragraph","spans":[{"id":"spn-107173","marks":["bold"],"text":"The mistake:"},{"id":"spn-107174","text":" Setting a new agent directly to "},{"id":"spn-107175","marks":["code"],"text":"act"},{"id":"spn-107176","text":" autonomy without any observation or advise period."}]},{"id":"blk-75850","kind":"paragraph","spans":[{"id":"spn-107177","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75851","items":[{"blocks":[{"id":"blk-75853","kind":"paragraph","spans":[{"id":"spn-107178","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-75852","kind":"list-item"},{"blocks":[{"id":"blk-75855","kind":"paragraph","spans":[{"id":"spn-107179","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-75854","kind":"list-item"},{"blocks":[{"id":"blk-75857","kind":"paragraph","spans":[{"id":"spn-107180","text":"The audit trail has no "},{"id":"spn-107181","marks":["code"],"text":"action_recommended"},{"id":"spn-107182","text":" or approval records to review"}]}],"id":"blk-75856","kind":"list-item"},{"blocks":[{"id":"blk-75859","kind":"paragraph","spans":[{"id":"spn-107183","text":"Trust is assumed, not earned"}]}],"id":"blk-75858","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75860","kind":"paragraph","spans":[{"id":"spn-107184","marks":["bold"],"text":"The fix:"},{"id":"spn-107185","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-107186","marks":["code"],"text":"observe"},{"id":"spn-107187","text":", review recommendations, promote to "},{"id":"spn-107188","marks":["code"],"text":"advise"},{"id":"spn-107189","text":", review approvals, then promote to "},{"id":"spn-107190","marks":["code"],"text":"act"},{"id":"spn-107191","text":" when confidence is established."}]},{"id":"blk-75861","kind":"paragraph","spans":[{"id":"spn-107192","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-75862","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-75863","kind":"paragraph","spans":[{"id":"spn-107193","marks":["bold"],"text":"After (good):"}]},{"id":"blk-75864","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-75865","kind":"heading","level":2,"spans":[{"id":"spn-107194","text":"High-Severity Anti-Patterns"}]},{"id":"blk-75866","kind":"heading","level":3,"spans":[{"id":"spn-107195","text":"3 — Audit Blindness"}]},{"id":"blk-75867","kind":"paragraph","spans":[{"id":"spn-107196","marks":["bold"],"text":"The mistake:"},{"id":"spn-107197","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-75868","kind":"paragraph","spans":[{"id":"spn-107198","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75869","items":[{"blocks":[{"id":"blk-75871","kind":"paragraph","spans":[{"id":"spn-107199","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-75870","kind":"list-item"},{"blocks":[{"id":"blk-75873","kind":"paragraph","spans":[{"id":"spn-107200","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-75872","kind":"list-item"},{"blocks":[{"id":"blk-75875","kind":"paragraph","spans":[{"id":"spn-107201","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-75874","kind":"list-item"},{"blocks":[{"id":"blk-75877","kind":"paragraph","spans":[{"id":"spn-107202","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-75876","kind":"list-item"},{"blocks":[{"id":"blk-75879","kind":"paragraph","spans":[{"id":"spn-107203","text":"The audit system costs resources for zero value"}]}],"id":"blk-75878","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75880","kind":"paragraph","spans":[{"id":"spn-107204","marks":["bold"],"text":"The fix:"},{"id":"spn-107205","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-75881","kind":"heading","level":3,"spans":[{"id":"spn-107206","text":"4 — Island Governance"}]},{"id":"blk-75882","kind":"paragraph","spans":[{"id":"spn-107207","marks":["bold"],"text":"The mistake:"},{"id":"spn-107208","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-75883","kind":"paragraph","spans":[{"id":"spn-107209","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75884","items":[{"blocks":[{"id":"blk-75886","kind":"paragraph","spans":[{"id":"spn-107210","text":"No centralized policy management across agents"}]}],"id":"blk-75885","kind":"list-item"},{"blocks":[{"id":"blk-75888","kind":"paragraph","spans":[{"id":"spn-107211","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-75887","kind":"list-item"},{"blocks":[{"id":"blk-75890","kind":"paragraph","spans":[{"id":"spn-107212","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-75889","kind":"list-item"},{"blocks":[{"id":"blk-75892","kind":"paragraph","spans":[{"id":"spn-107213","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-75891","kind":"list-item"},{"blocks":[{"id":"blk-75894","kind":"paragraph","spans":[{"id":"spn-107214","text":"No policy versioning or rollback capability"}]}],"id":"blk-75893","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75895","kind":"paragraph","spans":[{"id":"spn-107215","marks":["bold"],"text":"The fix:"},{"id":"spn-107216","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-75896","kind":"heading","level":3,"spans":[{"id":"spn-107217","text":"5 — Shim Confusion"}]},{"id":"blk-75897","kind":"paragraph","spans":[{"id":"spn-107218","marks":["bold"],"text":"The mistake:"},{"id":"spn-107219","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-75898","kind":"paragraph","spans":[{"id":"spn-107220","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75899","items":[{"blocks":[{"id":"blk-75901","kind":"paragraph","spans":[{"id":"spn-107221","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-75900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75902","kind":"paragraph","spans":[{"id":"spn-107222","text":"OTP process."}]},{"id":"blk-75903","items":[{"blocks":[{"id":"blk-75905","kind":"paragraph","spans":[{"id":"spn-107223","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-75904","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75906","kind":"paragraph","spans":[{"id":"spn-107224","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-75907","items":[{"blocks":[{"id":"blk-75909","kind":"paragraph","spans":[{"id":"spn-107225","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-75908","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75910","kind":"paragraph","spans":[{"id":"spn-107226","marks":["bold"],"text":"The fix:"},{"id":"spn-107227","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-75911","kind":"heading","level":3,"spans":[{"id":"spn-107228","text":"6 — Unchecked Actions"}]},{"id":"blk-75912","kind":"paragraph","spans":[{"id":"spn-107229","marks":["bold"],"text":"The mistake:"},{"id":"spn-107230","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-107231","marks":["code"],"text":"permission_check"},{"id":"spn-107232","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-75913","kind":"paragraph","spans":[{"id":"spn-107233","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75914","items":[{"blocks":[{"id":"blk-75916","kind":"paragraph","spans":[{"id":"spn-107234","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-75915","kind":"list-item"},{"blocks":[{"id":"blk-75918","kind":"paragraph","spans":[{"id":"spn-107235","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-75917","kind":"list-item"},{"blocks":[{"id":"blk-75920","kind":"paragraph","spans":[{"id":"spn-107236","text":"An agent at "},{"id":"spn-107237","marks":["code"],"text":"act"},{"id":"spn-107238","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-75919","kind":"list-item"},{"blocks":[{"id":"blk-75922","kind":"paragraph","spans":[{"id":"spn-107239","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-75921","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75923","kind":"paragraph","spans":[{"id":"spn-107240","text":"resources were accessed"}]},{"id":"blk-75924","kind":"paragraph","spans":[{"id":"spn-107241","marks":["bold"],"text":"The fix:"},{"id":"spn-107242","text":" Always call "},{"id":"spn-107243","marks":["code"],"text":"permission_check"},{"id":"spn-107244","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-75925","kind":"heading","level":2,"spans":[{"id":"spn-107245","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-75926","kind":"heading","level":3,"spans":[{"id":"spn-107246","text":"7 — Telemetry Neglect"}]},{"id":"blk-75927","kind":"paragraph","spans":[{"id":"spn-107247","marks":["bold"],"text":"The mistake:"},{"id":"spn-107248","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-75928","kind":"paragraph","spans":[{"id":"spn-107249","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75929","items":[{"blocks":[{"id":"blk-75931","kind":"paragraph","spans":[{"id":"spn-107250","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-75930","kind":"list-item"},{"blocks":[{"id":"blk-75933","kind":"paragraph","spans":[{"id":"spn-107251","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-75932","kind":"list-item"},{"blocks":[{"id":"blk-75935","kind":"paragraph","spans":[{"id":"spn-107252","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-75934","kind":"list-item"},{"blocks":[{"id":"blk-75937","kind":"paragraph","spans":[{"id":"spn-107253","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-75936","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75938","kind":"paragraph","spans":[{"id":"spn-107254","marks":["bold"],"text":"The fix:"},{"id":"spn-107255","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-75939","items":[{"blocks":[{"id":"blk-75941","kind":"paragraph","spans":[{"id":"spn-107256","text":"ETS table sizes for "},{"id":"spn-107257","marks":["code"],"text":":os_permissions"},{"id":"spn-107258","text":" and "},{"id":"spn-107259","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-75940","kind":"list-item"},{"blocks":[{"id":"blk-75943","kind":"paragraph","spans":[{"id":"spn-107260","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-75942","kind":"list-item"},{"blocks":[{"id":"blk-75945","kind":"paragraph","spans":[{"id":"spn-107261","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-75944","kind":"list-item"},{"blocks":[{"id":"blk-75947","kind":"paragraph","spans":[{"id":"spn-107262","text":"Agent count under AgentSupervisor"}]}],"id":"blk-75946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75948","kind":"heading","level":3,"spans":[{"id":"spn-107263","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-75949","kind":"paragraph","spans":[{"id":"spn-107264","marks":["bold"],"text":"The mistake:"},{"id":"spn-107265","text":" Attempting to jump from "},{"id":"spn-107266","marks":["code"],"text":"installed"},{"id":"spn-107267","text":" directly to "},{"id":"spn-107268","marks":["code"],"text":"running"},{"id":"spn-107269","text":", or from "},{"id":"spn-107270","marks":["code"],"text":"running"},{"id":"spn-107271","text":" directly to "},{"id":"spn-107272","marks":["code"],"text":"removed"},{"id":"spn-107273","text":", bypassing intermediate states."}]},{"id":"blk-75950","kind":"paragraph","spans":[{"id":"spn-107274","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75951","items":[{"blocks":[{"id":"blk-75953","kind":"paragraph","spans":[{"id":"spn-107275","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-75952","kind":"list-item"},{"blocks":[{"id":"blk-75955","kind":"paragraph","spans":[{"id":"spn-107276","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-75954","kind":"list-item"},{"blocks":[{"id":"blk-75957","kind":"paragraph","spans":[{"id":"spn-107277","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-75956","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75958","kind":"paragraph","spans":[{"id":"spn-107278","marks":["bold"],"text":"The fix:"},{"id":"spn-107279","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-107280","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-107281","text":". There are no shortcuts."}]},{"id":"blk-75959","kind":"heading","level":2,"spans":[{"id":"spn-107282","text":"Self-Audit Checklist"}]},{"id":"blk-75960","kind":"paragraph","spans":[{"id":"spn-107283","text":"Run through this periodically:"}]},{"id":"blk-75961","kind":"heading","level":3,"spans":[{"id":"spn-107284","text":"Permissions"}]},{"id":"blk-75962","items":[{"blocks":[{"id":"blk-75964","kind":"paragraph","spans":[{"id":"spn-107285","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-75963","kind":"list-item"},{"blocks":[{"id":"blk-75966","kind":"paragraph","spans":[{"id":"spn-107286","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-75965","kind":"list-item"},{"blocks":[{"id":"blk-75968","kind":"paragraph","spans":[{"id":"spn-107287","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-75967","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75969","kind":"heading","level":3,"spans":[{"id":"spn-107288","text":"Autonomy"}]},{"id":"blk-75970","items":[{"blocks":[{"id":"blk-75972","kind":"paragraph","spans":[{"id":"spn-107289","text":"[ ] Do new agents start at "},{"id":"spn-107290","marks":["code"],"text":"observe"},{"id":"spn-107291","text":"?"}]}],"id":"blk-75971","kind":"list-item"},{"blocks":[{"id":"blk-75974","kind":"paragraph","spans":[{"id":"spn-107292","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-75973","kind":"list-item"},{"blocks":[{"id":"blk-75976","kind":"paragraph","spans":[{"id":"spn-107293","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-75975","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75977","kind":"heading","level":3,"spans":[{"id":"spn-107294","text":"Audit"}]},{"id":"blk-75978","items":[{"blocks":[{"id":"blk-75980","kind":"paragraph","spans":[{"id":"spn-107295","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-75979","kind":"list-item"},{"blocks":[{"id":"blk-75982","kind":"paragraph","spans":[{"id":"spn-107296","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-75981","kind":"list-item"},{"blocks":[{"id":"blk-75984","kind":"paragraph","spans":[{"id":"spn-107297","text":"[ ] Is the audit backend appropriate for the deployment (ETS for dev, Ecto for prod)?"}]}],"id":"blk-75983","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75985","kind":"heading","level":3,"spans":[{"id":"spn-107298","text":"Integration"}]},{"id":"blk-75986","items":[{"blocks":[{"id":"blk-75988","kind":"paragraph","spans":[{"id":"spn-107299","text":"[ ] Is Delegatic connected for policy management?"}]}],"id":"blk-75987","kind":"list-item"},{"blocks":[{"id":"blk-75990","kind":"paragraph","spans":[{"id":"spn-107300","text":"[ ] Are Agentelic manifests reviewed before install?"}]}],"id":"blk-75989","kind":"list-item"},{"blocks":[{"id":"blk-75992","kind":"paragraph","spans":[{"id":"spn-107301","text":"[ ] Are marketplace agents treated as untrusted by default?"}]}],"id":"blk-75991","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75993","kind":"heading","level":3,"spans":[{"id":"spn-107302","text":"Operations"}]},{"id":"blk-75994","items":[{"blocks":[{"id":"blk-75996","kind":"paragraph","spans":[{"id":"spn-107303","text":"[ ] Is shim telemetry included in monitoring?"}]}],"id":"blk-75995","kind":"list-item"},{"blocks":[{"id":"blk-75998","kind":"paragraph","spans":[{"id":"spn-107304","text":"[ ] Are ETS table sizes tracked?"}]}],"id":"blk-75997","kind":"list-item"},{"blocks":[{"id":"blk-76000","kind":"paragraph","spans":[{"id":"spn-107305","text":"[ ] Is AuditWriter health monitored?"}]}],"id":"blk-75999","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierayi3jwjlqoz2pzblh47bmxbu6qgiog6kdskonsin2cq7bkqwgec5a","vocabulary":"ampersand.docs.fs.v1"}