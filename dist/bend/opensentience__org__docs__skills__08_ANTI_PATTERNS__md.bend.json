{"bendscript":"0.1","blocks":[{"id":"blk-50863","kind":"heading","level":1,"spans":[{"id":"spn-59037","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-50865","kind":"paragraph","spans":[{"id":"spn-59038","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-50864","kind":"quote"},{"id":"blk-50866","kind":"paragraph","spans":[{"id":"spn-59039","text":"---"}]},{"id":"blk-50867","kind":"heading","level":2,"spans":[{"id":"spn-59040","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-50869","spans":[{"id":"spn-59041","text":"#"}]},{"id":"blk-50870","spans":[{"id":"spn-59042","text":"Name"}]},{"id":"blk-50871","spans":[{"id":"spn-59043","text":"Severity"}]},{"id":"blk-50872","spans":[{"id":"spn-59044","text":"Description"}]}],"id":"blk-50868","kind":"table","rows":[[{"id":"blk-50873","spans":[{"id":"spn-59045","text":"1"}]},{"id":"blk-50874","spans":[{"id":"spn-59046","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-50875","spans":[{"id":"spn-59047","text":"Critical"}]},{"id":"blk-50876","spans":[{"id":"spn-59048","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-50877","spans":[{"id":"spn-59049","text":"2"}]},{"id":"blk-50878","spans":[{"id":"spn-59050","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-50879","spans":[{"id":"spn-59051","text":"Critical"}]},{"id":"blk-50880","spans":[{"id":"spn-59052","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-50881","spans":[{"id":"spn-59053","text":"3"}]},{"id":"blk-50882","spans":[{"id":"spn-59054","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-50883","spans":[{"id":"spn-59055","text":"High"}]},{"id":"blk-50884","spans":[{"id":"spn-59056","text":"Ignoring the audit trail"}]}],[{"id":"blk-50885","spans":[{"id":"spn-59057","text":"4"}]},{"id":"blk-50886","spans":[{"id":"spn-59058","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-50887","spans":[{"id":"spn-59059","text":"High"}]},{"id":"blk-50888","spans":[{"id":"spn-59060","text":"Not integrating with Delegatic"}]}],[{"id":"blk-50889","spans":[{"id":"spn-59061","text":"5"}]},{"id":"blk-50890","spans":[{"id":"spn-59062","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-50891","spans":[{"id":"spn-59063","text":"High"}]},{"id":"blk-50892","spans":[{"id":"spn-59064","text":"Treating the shim as a runtime"}]}],[{"id":"blk-50893","spans":[{"id":"spn-59065","text":"6"}]},{"id":"blk-50894","spans":[{"id":"spn-59066","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-50895","spans":[{"id":"spn-59067","text":"High"}]},{"id":"blk-50896","spans":[{"id":"spn-59068","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-50897","spans":[{"id":"spn-59069","text":"7"}]},{"id":"blk-50898","spans":[{"id":"spn-59070","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-50899","spans":[{"id":"spn-59071","text":"Medium"}]},{"id":"blk-50900","spans":[{"id":"spn-59072","text":"Not monitoring shim overhead"}]}],[{"id":"blk-50901","spans":[{"id":"spn-59073","text":"8"}]},{"id":"blk-50902","spans":[{"id":"spn-59074","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-50903","spans":[{"id":"spn-59075","text":"Medium"}]},{"id":"blk-50904","spans":[{"id":"spn-59076","text":"Skipping lifecycle states"}]}]]},{"id":"blk-50905","kind":"paragraph","spans":[{"id":"spn-59077","text":"---"}]},{"id":"blk-50906","kind":"heading","level":2,"spans":[{"id":"spn-59078","text":"Critical Anti-Patterns"}]},{"id":"blk-50907","kind":"paragraph","spans":[{"id":"spn-59079","text":"---"}]},{"id":"blk-50908","kind":"heading","level":3,"spans":[{"id":"spn-59080","text":"1 — Permission Sprawl"}]},{"id":"blk-50909","kind":"paragraph","spans":[{"id":"spn-59081","marks":["bold"],"text":"The mistake:"},{"id":"spn-59082","text":" Granting "},{"id":"spn-59083","marks":["code"],"text":"*"},{"id":"spn-59084","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-50910","kind":"paragraph","spans":[{"id":"spn-59085","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50911","items":[{"blocks":[{"id":"blk-50913","kind":"paragraph","spans":[{"id":"spn-59086","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-59087","marks":["code"],"text":"allow"}]}],"id":"blk-50912","kind":"list-item"},{"blocks":[{"id":"blk-50915","kind":"paragraph","spans":[{"id":"spn-59088","text":"The audit trail fills with meaningless "},{"id":"spn-59089","marks":["code"],"text":"ok"},{"id":"spn-59090","text":" entries"}]}],"id":"blk-50914","kind":"list-item"},{"blocks":[{"id":"blk-50917","kind":"paragraph","spans":[{"id":"spn-59091","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-50916","kind":"list-item"},{"blocks":[{"id":"blk-50919","kind":"paragraph","spans":[{"id":"spn-59092","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-50918","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50920","kind":"paragraph","spans":[{"id":"spn-59093","marks":["bold"],"text":"The fix:"},{"id":"spn-59094","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-50921","kind":"paragraph","spans":[{"id":"spn-59095","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-50922","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-50923","kind":"paragraph","spans":[{"id":"spn-59096","marks":["bold"],"text":"After (good):"}]},{"id":"blk-50924","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-50925","kind":"paragraph","spans":[{"id":"spn-59097","text":"---"}]},{"id":"blk-50926","kind":"heading","level":3,"spans":[{"id":"spn-59098","text":"2 — Trust Skipping"}]},{"id":"blk-50927","kind":"paragraph","spans":[{"id":"spn-59099","marks":["bold"],"text":"The mistake:"},{"id":"spn-59100","text":" Setting a new agent directly to "},{"id":"spn-59101","marks":["code"],"text":"act"},{"id":"spn-59102","text":" autonomy without any observation or advise period."}]},{"id":"blk-50928","kind":"paragraph","spans":[{"id":"spn-59103","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50929","items":[{"blocks":[{"id":"blk-50931","kind":"paragraph","spans":[{"id":"spn-59104","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-50930","kind":"list-item"},{"blocks":[{"id":"blk-50933","kind":"paragraph","spans":[{"id":"spn-59105","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-50932","kind":"list-item"},{"blocks":[{"id":"blk-50935","kind":"paragraph","spans":[{"id":"spn-59106","text":"The audit trail has no "},{"id":"spn-59107","marks":["code"],"text":"action_recommended"},{"id":"spn-59108","text":" or approval records to review"}]}],"id":"blk-50934","kind":"list-item"},{"blocks":[{"id":"blk-50937","kind":"paragraph","spans":[{"id":"spn-59109","text":"Trust is assumed, not earned"}]}],"id":"blk-50936","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50938","kind":"paragraph","spans":[{"id":"spn-59110","marks":["bold"],"text":"The fix:"},{"id":"spn-59111","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-59112","marks":["code"],"text":"observe"},{"id":"spn-59113","text":", review recommendations, promote to "},{"id":"spn-59114","marks":["code"],"text":"advise"},{"id":"spn-59115","text":", review approvals, then promote to "},{"id":"spn-59116","marks":["code"],"text":"act"},{"id":"spn-59117","text":" when confidence is established."}]},{"id":"blk-50939","kind":"paragraph","spans":[{"id":"spn-59118","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-50940","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-50941","kind":"paragraph","spans":[{"id":"spn-59119","marks":["bold"],"text":"After (good):"}]},{"id":"blk-50942","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-50943","kind":"paragraph","spans":[{"id":"spn-59120","text":"---"}]},{"id":"blk-50944","kind":"heading","level":2,"spans":[{"id":"spn-59121","text":"High-Severity Anti-Patterns"}]},{"id":"blk-50945","kind":"paragraph","spans":[{"id":"spn-59122","text":"---"}]},{"id":"blk-50946","kind":"heading","level":3,"spans":[{"id":"spn-59123","text":"3 — Audit Blindness"}]},{"id":"blk-50947","kind":"paragraph","spans":[{"id":"spn-59124","marks":["bold"],"text":"The mistake:"},{"id":"spn-59125","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-50948","kind":"paragraph","spans":[{"id":"spn-59126","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50949","items":[{"blocks":[{"id":"blk-50951","kind":"paragraph","spans":[{"id":"spn-59127","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-50950","kind":"list-item"},{"blocks":[{"id":"blk-50953","kind":"paragraph","spans":[{"id":"spn-59128","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-50952","kind":"list-item"},{"blocks":[{"id":"blk-50955","kind":"paragraph","spans":[{"id":"spn-59129","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-50954","kind":"list-item"},{"blocks":[{"id":"blk-50957","kind":"paragraph","spans":[{"id":"spn-59130","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-50956","kind":"list-item"},{"blocks":[{"id":"blk-50959","kind":"paragraph","spans":[{"id":"spn-59131","text":"The audit system costs resources for zero value"}]}],"id":"blk-50958","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50960","kind":"paragraph","spans":[{"id":"spn-59132","marks":["bold"],"text":"The fix:"},{"id":"spn-59133","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-50961","kind":"paragraph","spans":[{"id":"spn-59134","text":"---"}]},{"id":"blk-50962","kind":"heading","level":3,"spans":[{"id":"spn-59135","text":"4 — Island Governance"}]},{"id":"blk-50963","kind":"paragraph","spans":[{"id":"spn-59136","marks":["bold"],"text":"The mistake:"},{"id":"spn-59137","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-50964","kind":"paragraph","spans":[{"id":"spn-59138","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50965","items":[{"blocks":[{"id":"blk-50967","kind":"paragraph","spans":[{"id":"spn-59139","text":"No centralized policy management across agents"}]}],"id":"blk-50966","kind":"list-item"},{"blocks":[{"id":"blk-50969","kind":"paragraph","spans":[{"id":"spn-59140","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-50968","kind":"list-item"},{"blocks":[{"id":"blk-50971","kind":"paragraph","spans":[{"id":"spn-59141","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-50970","kind":"list-item"},{"blocks":[{"id":"blk-50973","kind":"paragraph","spans":[{"id":"spn-59142","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-50972","kind":"list-item"},{"blocks":[{"id":"blk-50975","kind":"paragraph","spans":[{"id":"spn-59143","text":"No policy versioning or rollback capability"}]}],"id":"blk-50974","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50976","kind":"paragraph","spans":[{"id":"spn-59144","marks":["bold"],"text":"The fix:"},{"id":"spn-59145","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-50977","kind":"paragraph","spans":[{"id":"spn-59146","text":"---"}]},{"id":"blk-50978","kind":"heading","level":3,"spans":[{"id":"spn-59147","text":"5 — Shim Confusion"}]},{"id":"blk-50979","kind":"paragraph","spans":[{"id":"spn-59148","marks":["bold"],"text":"The mistake:"},{"id":"spn-59149","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-50980","kind":"paragraph","spans":[{"id":"spn-59150","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50981","items":[{"blocks":[{"id":"blk-50983","kind":"paragraph","spans":[{"id":"spn-59151","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-50982","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50984","kind":"paragraph","spans":[{"id":"spn-59152","text":"OTP process."}]},{"id":"blk-50985","items":[{"blocks":[{"id":"blk-50987","kind":"paragraph","spans":[{"id":"spn-59153","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-50986","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50988","kind":"paragraph","spans":[{"id":"spn-59154","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-50989","items":[{"blocks":[{"id":"blk-50991","kind":"paragraph","spans":[{"id":"spn-59155","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-50990","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50992","kind":"paragraph","spans":[{"id":"spn-59156","marks":["bold"],"text":"The fix:"},{"id":"spn-59157","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-50993","kind":"paragraph","spans":[{"id":"spn-59158","text":"---"}]},{"id":"blk-50994","kind":"heading","level":3,"spans":[{"id":"spn-59159","text":"6 — Unchecked Actions"}]},{"id":"blk-50995","kind":"paragraph","spans":[{"id":"spn-59160","marks":["bold"],"text":"The mistake:"},{"id":"spn-59161","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-59162","marks":["code"],"text":"permission_check"},{"id":"spn-59163","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-50996","kind":"paragraph","spans":[{"id":"spn-59164","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50997","items":[{"blocks":[{"id":"blk-50999","kind":"paragraph","spans":[{"id":"spn-59165","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-50998","kind":"list-item"},{"blocks":[{"id":"blk-51001","kind":"paragraph","spans":[{"id":"spn-59166","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-51000","kind":"list-item"},{"blocks":[{"id":"blk-51003","kind":"paragraph","spans":[{"id":"spn-59167","text":"An agent at "},{"id":"spn-59168","marks":["code"],"text":"act"},{"id":"spn-59169","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-51002","kind":"list-item"},{"blocks":[{"id":"blk-51005","kind":"paragraph","spans":[{"id":"spn-59170","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-51004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51006","kind":"paragraph","spans":[{"id":"spn-59171","text":"resources were accessed"}]},{"id":"blk-51007","kind":"paragraph","spans":[{"id":"spn-59172","marks":["bold"],"text":"The fix:"},{"id":"spn-59173","text":" Always call "},{"id":"spn-59174","marks":["code"],"text":"permission_check"},{"id":"spn-59175","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-51008","kind":"paragraph","spans":[{"id":"spn-59176","text":"---"}]},{"id":"blk-51009","kind":"heading","level":2,"spans":[{"id":"spn-59177","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-51010","kind":"paragraph","spans":[{"id":"spn-59178","text":"---"}]},{"id":"blk-51011","kind":"heading","level":3,"spans":[{"id":"spn-59179","text":"7 — Telemetry Neglect"}]},{"id":"blk-51012","kind":"paragraph","spans":[{"id":"spn-59180","marks":["bold"],"text":"The mistake:"},{"id":"spn-59181","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-51013","kind":"paragraph","spans":[{"id":"spn-59182","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-51014","items":[{"blocks":[{"id":"blk-51016","kind":"paragraph","spans":[{"id":"spn-59183","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-51015","kind":"list-item"},{"blocks":[{"id":"blk-51018","kind":"paragraph","spans":[{"id":"spn-59184","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-51017","kind":"list-item"},{"blocks":[{"id":"blk-51020","kind":"paragraph","spans":[{"id":"spn-59185","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-51019","kind":"list-item"},{"blocks":[{"id":"blk-51022","kind":"paragraph","spans":[{"id":"spn-59186","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-51021","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51023","kind":"paragraph","spans":[{"id":"spn-59187","marks":["bold"],"text":"The fix:"},{"id":"spn-59188","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-51024","items":[{"blocks":[{"id":"blk-51026","kind":"paragraph","spans":[{"id":"spn-59189","text":"ETS table sizes for "},{"id":"spn-59190","marks":["code"],"text":":os_permissions"},{"id":"spn-59191","text":" and "},{"id":"spn-59192","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-51025","kind":"list-item"},{"blocks":[{"id":"blk-51028","kind":"paragraph","spans":[{"id":"spn-59193","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-51027","kind":"list-item"},{"blocks":[{"id":"blk-51030","kind":"paragraph","spans":[{"id":"spn-59194","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-51029","kind":"list-item"},{"blocks":[{"id":"blk-51032","kind":"paragraph","spans":[{"id":"spn-59195","text":"Agent count under AgentSupervisor"}]}],"id":"blk-51031","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51033","kind":"paragraph","spans":[{"id":"spn-59196","text":"---"}]},{"id":"blk-51034","kind":"heading","level":3,"spans":[{"id":"spn-59197","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-51035","kind":"paragraph","spans":[{"id":"spn-59198","marks":["bold"],"text":"The mistake:"},{"id":"spn-59199","text":" Attempting to jump from "},{"id":"spn-59200","marks":["code"],"text":"installed"},{"id":"spn-59201","text":" directly to "},{"id":"spn-59202","marks":["code"],"text":"running"},{"id":"spn-59203","text":", or from "},{"id":"spn-59204","marks":["code"],"text":"running"},{"id":"spn-59205","text":" directly to "},{"id":"spn-59206","marks":["code"],"text":"removed"},{"id":"spn-59207","text":", bypassing intermediate states."}]},{"id":"blk-51036","kind":"paragraph","spans":[{"id":"spn-59208","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-51037","items":[{"blocks":[{"id":"blk-51039","kind":"paragraph","spans":[{"id":"spn-59209","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-51038","kind":"list-item"},{"blocks":[{"id":"blk-51041","kind":"paragraph","spans":[{"id":"spn-59210","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-51040","kind":"list-item"},{"blocks":[{"id":"blk-51043","kind":"paragraph","spans":[{"id":"spn-59211","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-51042","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51044","kind":"paragraph","spans":[{"id":"spn-59212","marks":["bold"],"text":"The fix:"},{"id":"spn-59213","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-59214","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-59215","text":". There are no shortcuts."}]},{"id":"blk-51045","kind":"paragraph","spans":[{"id":"spn-59216","text":"---"}]},{"id":"blk-51046","kind":"heading","level":2,"spans":[{"id":"spn-59217","text":"Self-Audit Checklist"}]},{"id":"blk-51047","kind":"paragraph","spans":[{"id":"spn-59218","text":"Run through this periodically:"}]},{"id":"blk-51048","kind":"heading","level":3,"spans":[{"id":"spn-59219","text":"Permissions"}]},{"id":"blk-51049","items":[{"blocks":[{"id":"blk-51051","kind":"paragraph","spans":[{"id":"spn-59220","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-51050","kind":"list-item"},{"blocks":[{"id":"blk-51053","kind":"paragraph","spans":[{"id":"spn-59221","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-51052","kind":"list-item"},{"blocks":[{"id":"blk-51055","kind":"paragraph","spans":[{"id":"spn-59222","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-51054","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51056","kind":"heading","level":3,"spans":[{"id":"spn-59223","text":"Autonomy"}]},{"id":"blk-51057","items":[{"blocks":[{"id":"blk-51059","kind":"paragraph","spans":[{"id":"spn-59224","text":"[ ] Do new agents start at "},{"id":"spn-59225","marks":["code"],"text":"observe"},{"id":"spn-59226","text":"?"}]}],"id":"blk-51058","kind":"list-item"},{"blocks":[{"id":"blk-51061","kind":"paragraph","spans":[{"id":"spn-59227","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-51060","kind":"list-item"},{"blocks":[{"id":"blk-51063","kind":"paragraph","spans":[{"id":"spn-59228","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-51062","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51064","kind":"heading","level":3,"spans":[{"id":"spn-59229","text":"Audit"}]},{"id":"blk-51065","items":[{"blocks":[{"id":"blk-51067","kind":"paragraph","spans":[{"id":"spn-59230","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-51066","kind":"list-item"},{"blocks":[{"id":"blk-51069","kind":"paragraph","spans":[{"id":"spn-59231","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-51068","kind":"list-item"},{"blocks":[{"id":"blk-51071","kind":"paragraph","spans":[{"id":"spn-59232","text":"[ ] Is the audit backend appropriate for the deployment (ETS for dev, Ecto for prod)?"}]}],"id":"blk-51070","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51072","kind":"heading","level":3,"spans":[{"id":"spn-59233","text":"Integration"}]},{"id":"blk-51073","items":[{"blocks":[{"id":"blk-51075","kind":"paragraph","spans":[{"id":"spn-59234","text":"[ ] Is Delegatic connected for policy management?"}]}],"id":"blk-51074","kind":"list-item"},{"blocks":[{"id":"blk-51077","kind":"paragraph","spans":[{"id":"spn-59235","text":"[ ] Are Agentelic manifests reviewed before install?"}]}],"id":"blk-51076","kind":"list-item"},{"blocks":[{"id":"blk-51079","kind":"paragraph","spans":[{"id":"spn-59236","text":"[ ] Are marketplace agents treated as untrusted by default?"}]}],"id":"blk-51078","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51080","kind":"heading","level":3,"spans":[{"id":"spn-59237","text":"Operations"}]},{"id":"blk-51081","items":[{"blocks":[{"id":"blk-51083","kind":"paragraph","spans":[{"id":"spn-59238","text":"[ ] Is shim telemetry included in monitoring?"}]}],"id":"blk-51082","kind":"list-item"},{"blocks":[{"id":"blk-51085","kind":"paragraph","spans":[{"id":"spn-59239","text":"[ ] Are ETS table sizes tracked?"}]}],"id":"blk-51084","kind":"list-item"},{"blocks":[{"id":"blk-51087","kind":"paragraph","spans":[{"id":"spn-59240","text":"[ ] Is AuditWriter health monitored?"}]}],"id":"blk-51086","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera3xvc7j4x2v5kl4s6jqh2hy6edlae7lnzfiii6xtbjojxdamoqkqq","vocabulary":"ampersand.docs.fs.v1"}