{"bendscript":"0.1","blocks":[{"id":"blk-49781","kind":"heading","level":1,"spans":[{"id":"spn-56114","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-49783","kind":"paragraph","spans":[{"id":"spn-56115","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-49782","kind":"quote"},{"id":"blk-49784","kind":"paragraph","spans":[{"id":"spn-56116","text":"---"}]},{"id":"blk-49785","kind":"heading","level":2,"spans":[{"id":"spn-56117","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-49787","spans":[{"id":"spn-56118","text":"#"}]},{"id":"blk-49788","spans":[{"id":"spn-56119","text":"Name"}]},{"id":"blk-49789","spans":[{"id":"spn-56120","text":"Severity"}]},{"id":"blk-49790","spans":[{"id":"spn-56121","text":"Description"}]}],"id":"blk-49786","kind":"table","rows":[[{"id":"blk-49791","spans":[{"id":"spn-56122","text":"1"}]},{"id":"blk-49792","spans":[{"id":"spn-56123","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-49793","spans":[{"id":"spn-56124","text":"Critical"}]},{"id":"blk-49794","spans":[{"id":"spn-56125","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-49795","spans":[{"id":"spn-56126","text":"2"}]},{"id":"blk-49796","spans":[{"id":"spn-56127","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-49797","spans":[{"id":"spn-56128","text":"Critical"}]},{"id":"blk-49798","spans":[{"id":"spn-56129","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-49799","spans":[{"id":"spn-56130","text":"3"}]},{"id":"blk-49800","spans":[{"id":"spn-56131","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-49801","spans":[{"id":"spn-56132","text":"High"}]},{"id":"blk-49802","spans":[{"id":"spn-56133","text":"Ignoring the audit trail"}]}],[{"id":"blk-49803","spans":[{"id":"spn-56134","text":"4"}]},{"id":"blk-49804","spans":[{"id":"spn-56135","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-49805","spans":[{"id":"spn-56136","text":"High"}]},{"id":"blk-49806","spans":[{"id":"spn-56137","text":"Not integrating with Delegatic"}]}],[{"id":"blk-49807","spans":[{"id":"spn-56138","text":"5"}]},{"id":"blk-49808","spans":[{"id":"spn-56139","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-49809","spans":[{"id":"spn-56140","text":"High"}]},{"id":"blk-49810","spans":[{"id":"spn-56141","text":"Treating the shim as a runtime"}]}],[{"id":"blk-49811","spans":[{"id":"spn-56142","text":"6"}]},{"id":"blk-49812","spans":[{"id":"spn-56143","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-49813","spans":[{"id":"spn-56144","text":"High"}]},{"id":"blk-49814","spans":[{"id":"spn-56145","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-49815","spans":[{"id":"spn-56146","text":"7"}]},{"id":"blk-49816","spans":[{"id":"spn-56147","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-49817","spans":[{"id":"spn-56148","text":"Medium"}]},{"id":"blk-49818","spans":[{"id":"spn-56149","text":"Not monitoring shim overhead"}]}],[{"id":"blk-49819","spans":[{"id":"spn-56150","text":"8"}]},{"id":"blk-49820","spans":[{"id":"spn-56151","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-49821","spans":[{"id":"spn-56152","text":"Medium"}]},{"id":"blk-49822","spans":[{"id":"spn-56153","text":"Skipping lifecycle states"}]}]]},{"id":"blk-49823","kind":"paragraph","spans":[{"id":"spn-56154","text":"---"}]},{"id":"blk-49824","kind":"heading","level":2,"spans":[{"id":"spn-56155","text":"Critical Anti-Patterns"}]},{"id":"blk-49825","kind":"paragraph","spans":[{"id":"spn-56156","text":"---"}]},{"id":"blk-49826","kind":"heading","level":3,"spans":[{"id":"spn-56157","text":"1 — Permission Sprawl"}]},{"id":"blk-49827","kind":"paragraph","spans":[{"id":"spn-56158","marks":["bold"],"text":"The mistake:"},{"id":"spn-56159","text":" Granting "},{"id":"spn-56160","marks":["code"],"text":"*"},{"id":"spn-56161","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-49828","kind":"paragraph","spans":[{"id":"spn-56162","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49829","items":[{"blocks":[{"id":"blk-49831","kind":"paragraph","spans":[{"id":"spn-56163","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-56164","marks":["code"],"text":"allow"}]}],"id":"blk-49830","kind":"list-item"},{"blocks":[{"id":"blk-49833","kind":"paragraph","spans":[{"id":"spn-56165","text":"The audit trail fills with meaningless "},{"id":"spn-56166","marks":["code"],"text":"ok"},{"id":"spn-56167","text":" entries"}]}],"id":"blk-49832","kind":"list-item"},{"blocks":[{"id":"blk-49835","kind":"paragraph","spans":[{"id":"spn-56168","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-49834","kind":"list-item"},{"blocks":[{"id":"blk-49837","kind":"paragraph","spans":[{"id":"spn-56169","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-49836","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49838","kind":"paragraph","spans":[{"id":"spn-56170","marks":["bold"],"text":"The fix:"},{"id":"spn-56171","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-49839","kind":"paragraph","spans":[{"id":"spn-56172","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-49840","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-49841","kind":"paragraph","spans":[{"id":"spn-56173","marks":["bold"],"text":"After (good):"}]},{"id":"blk-49842","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-49843","kind":"paragraph","spans":[{"id":"spn-56174","text":"---"}]},{"id":"blk-49844","kind":"heading","level":3,"spans":[{"id":"spn-56175","text":"2 — Trust Skipping"}]},{"id":"blk-49845","kind":"paragraph","spans":[{"id":"spn-56176","marks":["bold"],"text":"The mistake:"},{"id":"spn-56177","text":" Setting a new agent directly to "},{"id":"spn-56178","marks":["code"],"text":"act"},{"id":"spn-56179","text":" autonomy without any observation or advise period."}]},{"id":"blk-49846","kind":"paragraph","spans":[{"id":"spn-56180","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49847","items":[{"blocks":[{"id":"blk-49849","kind":"paragraph","spans":[{"id":"spn-56181","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-49848","kind":"list-item"},{"blocks":[{"id":"blk-49851","kind":"paragraph","spans":[{"id":"spn-56182","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-49850","kind":"list-item"},{"blocks":[{"id":"blk-49853","kind":"paragraph","spans":[{"id":"spn-56183","text":"The audit trail has no "},{"id":"spn-56184","marks":["code"],"text":"action_recommended"},{"id":"spn-56185","text":" or approval records to review"}]}],"id":"blk-49852","kind":"list-item"},{"blocks":[{"id":"blk-49855","kind":"paragraph","spans":[{"id":"spn-56186","text":"Trust is assumed, not earned"}]}],"id":"blk-49854","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49856","kind":"paragraph","spans":[{"id":"spn-56187","marks":["bold"],"text":"The fix:"},{"id":"spn-56188","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-56189","marks":["code"],"text":"observe"},{"id":"spn-56190","text":", review recommendations, promote to "},{"id":"spn-56191","marks":["code"],"text":"advise"},{"id":"spn-56192","text":", review approvals, then promote to "},{"id":"spn-56193","marks":["code"],"text":"act"},{"id":"spn-56194","text":" when confidence is established."}]},{"id":"blk-49857","kind":"paragraph","spans":[{"id":"spn-56195","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-49858","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-49859","kind":"paragraph","spans":[{"id":"spn-56196","marks":["bold"],"text":"After (good):"}]},{"id":"blk-49860","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-49861","kind":"paragraph","spans":[{"id":"spn-56197","text":"---"}]},{"id":"blk-49862","kind":"heading","level":2,"spans":[{"id":"spn-56198","text":"High-Severity Anti-Patterns"}]},{"id":"blk-49863","kind":"paragraph","spans":[{"id":"spn-56199","text":"---"}]},{"id":"blk-49864","kind":"heading","level":3,"spans":[{"id":"spn-56200","text":"3 — Audit Blindness"}]},{"id":"blk-49865","kind":"paragraph","spans":[{"id":"spn-56201","marks":["bold"],"text":"The mistake:"},{"id":"spn-56202","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-49866","kind":"paragraph","spans":[{"id":"spn-56203","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49867","items":[{"blocks":[{"id":"blk-49869","kind":"paragraph","spans":[{"id":"spn-56204","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-49868","kind":"list-item"},{"blocks":[{"id":"blk-49871","kind":"paragraph","spans":[{"id":"spn-56205","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-49870","kind":"list-item"},{"blocks":[{"id":"blk-49873","kind":"paragraph","spans":[{"id":"spn-56206","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-49872","kind":"list-item"},{"blocks":[{"id":"blk-49875","kind":"paragraph","spans":[{"id":"spn-56207","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-49874","kind":"list-item"},{"blocks":[{"id":"blk-49877","kind":"paragraph","spans":[{"id":"spn-56208","text":"The audit system costs resources for zero value"}]}],"id":"blk-49876","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49878","kind":"paragraph","spans":[{"id":"spn-56209","marks":["bold"],"text":"The fix:"},{"id":"spn-56210","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-49879","kind":"paragraph","spans":[{"id":"spn-56211","text":"---"}]},{"id":"blk-49880","kind":"heading","level":3,"spans":[{"id":"spn-56212","text":"4 — Island Governance"}]},{"id":"blk-49881","kind":"paragraph","spans":[{"id":"spn-56213","marks":["bold"],"text":"The mistake:"},{"id":"spn-56214","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-49882","kind":"paragraph","spans":[{"id":"spn-56215","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49883","items":[{"blocks":[{"id":"blk-49885","kind":"paragraph","spans":[{"id":"spn-56216","text":"No centralized policy management across agents"}]}],"id":"blk-49884","kind":"list-item"},{"blocks":[{"id":"blk-49887","kind":"paragraph","spans":[{"id":"spn-56217","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-49886","kind":"list-item"},{"blocks":[{"id":"blk-49889","kind":"paragraph","spans":[{"id":"spn-56218","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-49888","kind":"list-item"},{"blocks":[{"id":"blk-49891","kind":"paragraph","spans":[{"id":"spn-56219","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-49890","kind":"list-item"},{"blocks":[{"id":"blk-49893","kind":"paragraph","spans":[{"id":"spn-56220","text":"No policy versioning or rollback capability"}]}],"id":"blk-49892","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49894","kind":"paragraph","spans":[{"id":"spn-56221","marks":["bold"],"text":"The fix:"},{"id":"spn-56222","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-49895","kind":"paragraph","spans":[{"id":"spn-56223","text":"---"}]},{"id":"blk-49896","kind":"heading","level":3,"spans":[{"id":"spn-56224","text":"5 — Shim Confusion"}]},{"id":"blk-49897","kind":"paragraph","spans":[{"id":"spn-56225","marks":["bold"],"text":"The mistake:"},{"id":"spn-56226","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-49898","kind":"paragraph","spans":[{"id":"spn-56227","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49899","items":[{"blocks":[{"id":"blk-49901","kind":"paragraph","spans":[{"id":"spn-56228","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-49900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49902","kind":"paragraph","spans":[{"id":"spn-56229","text":"OTP process."}]},{"id":"blk-49903","items":[{"blocks":[{"id":"blk-49905","kind":"paragraph","spans":[{"id":"spn-56230","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-49904","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49906","kind":"paragraph","spans":[{"id":"spn-56231","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-49907","items":[{"blocks":[{"id":"blk-49909","kind":"paragraph","spans":[{"id":"spn-56232","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-49908","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49910","kind":"paragraph","spans":[{"id":"spn-56233","marks":["bold"],"text":"The fix:"},{"id":"spn-56234","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-49911","kind":"paragraph","spans":[{"id":"spn-56235","text":"---"}]},{"id":"blk-49912","kind":"heading","level":3,"spans":[{"id":"spn-56236","text":"6 — Unchecked Actions"}]},{"id":"blk-49913","kind":"paragraph","spans":[{"id":"spn-56237","marks":["bold"],"text":"The mistake:"},{"id":"spn-56238","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-56239","marks":["code"],"text":"permission_check"},{"id":"spn-56240","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-49914","kind":"paragraph","spans":[{"id":"spn-56241","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49915","items":[{"blocks":[{"id":"blk-49917","kind":"paragraph","spans":[{"id":"spn-56242","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-49916","kind":"list-item"},{"blocks":[{"id":"blk-49919","kind":"paragraph","spans":[{"id":"spn-56243","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-49918","kind":"list-item"},{"blocks":[{"id":"blk-49921","kind":"paragraph","spans":[{"id":"spn-56244","text":"An agent at "},{"id":"spn-56245","marks":["code"],"text":"act"},{"id":"spn-56246","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-49920","kind":"list-item"},{"blocks":[{"id":"blk-49923","kind":"paragraph","spans":[{"id":"spn-56247","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-49922","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49924","kind":"paragraph","spans":[{"id":"spn-56248","text":"resources were accessed"}]},{"id":"blk-49925","kind":"paragraph","spans":[{"id":"spn-56249","marks":["bold"],"text":"The fix:"},{"id":"spn-56250","text":" Always call "},{"id":"spn-56251","marks":["code"],"text":"permission_check"},{"id":"spn-56252","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-49926","kind":"paragraph","spans":[{"id":"spn-56253","text":"---"}]},{"id":"blk-49927","kind":"heading","level":2,"spans":[{"id":"spn-56254","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-49928","kind":"paragraph","spans":[{"id":"spn-56255","text":"---"}]},{"id":"blk-49929","kind":"heading","level":3,"spans":[{"id":"spn-56256","text":"7 — Telemetry Neglect"}]},{"id":"blk-49930","kind":"paragraph","spans":[{"id":"spn-56257","marks":["bold"],"text":"The mistake:"},{"id":"spn-56258","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-49931","kind":"paragraph","spans":[{"id":"spn-56259","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49932","items":[{"blocks":[{"id":"blk-49934","kind":"paragraph","spans":[{"id":"spn-56260","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-49933","kind":"list-item"},{"blocks":[{"id":"blk-49936","kind":"paragraph","spans":[{"id":"spn-56261","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-49935","kind":"list-item"},{"blocks":[{"id":"blk-49938","kind":"paragraph","spans":[{"id":"spn-56262","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-49937","kind":"list-item"},{"blocks":[{"id":"blk-49940","kind":"paragraph","spans":[{"id":"spn-56263","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-49939","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49941","kind":"paragraph","spans":[{"id":"spn-56264","marks":["bold"],"text":"The fix:"},{"id":"spn-56265","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-49942","items":[{"blocks":[{"id":"blk-49944","kind":"paragraph","spans":[{"id":"spn-56266","text":"ETS table sizes for "},{"id":"spn-56267","marks":["code"],"text":":os_permissions"},{"id":"spn-56268","text":" and "},{"id":"spn-56269","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-49943","kind":"list-item"},{"blocks":[{"id":"blk-49946","kind":"paragraph","spans":[{"id":"spn-56270","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-49945","kind":"list-item"},{"blocks":[{"id":"blk-49948","kind":"paragraph","spans":[{"id":"spn-56271","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-49947","kind":"list-item"},{"blocks":[{"id":"blk-49950","kind":"paragraph","spans":[{"id":"spn-56272","text":"Agent count under AgentSupervisor"}]}],"id":"blk-49949","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49951","kind":"paragraph","spans":[{"id":"spn-56273","text":"---"}]},{"id":"blk-49952","kind":"heading","level":3,"spans":[{"id":"spn-56274","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-49953","kind":"paragraph","spans":[{"id":"spn-56275","marks":["bold"],"text":"The mistake:"},{"id":"spn-56276","text":" Attempting to jump from "},{"id":"spn-56277","marks":["code"],"text":"installed"},{"id":"spn-56278","text":" directly to "},{"id":"spn-56279","marks":["code"],"text":"running"},{"id":"spn-56280","text":", or from "},{"id":"spn-56281","marks":["code"],"text":"running"},{"id":"spn-56282","text":" directly to "},{"id":"spn-56283","marks":["code"],"text":"removed"},{"id":"spn-56284","text":", bypassing intermediate states."}]},{"id":"blk-49954","kind":"paragraph","spans":[{"id":"spn-56285","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49955","items":[{"blocks":[{"id":"blk-49957","kind":"paragraph","spans":[{"id":"spn-56286","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-49956","kind":"list-item"},{"blocks":[{"id":"blk-49959","kind":"paragraph","spans":[{"id":"spn-56287","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-49958","kind":"list-item"},{"blocks":[{"id":"blk-49961","kind":"paragraph","spans":[{"id":"spn-56288","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-49960","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49962","kind":"paragraph","spans":[{"id":"spn-56289","marks":["bold"],"text":"The fix:"},{"id":"spn-56290","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-56291","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-56292","text":". There are no shortcuts."}]},{"id":"blk-49963","kind":"paragraph","spans":[{"id":"spn-56293","text":"---"}]},{"id":"blk-49964","kind":"heading","level":2,"spans":[{"id":"spn-56294","text":"Self-Audit Checklist"}]},{"id":"blk-49965","kind":"paragraph","spans":[{"id":"spn-56295","text":"Run through this periodically:"}]},{"id":"blk-49966","kind":"heading","level":3,"spans":[{"id":"spn-56296","text":"Permissions"}]},{"id":"blk-49967","items":[{"blocks":[{"id":"blk-49969","kind":"paragraph","spans":[{"id":"spn-56297","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-49968","kind":"list-item"},{"blocks":[{"id":"blk-49971","kind":"paragraph","spans":[{"id":"spn-56298","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-49970","kind":"list-item"},{"blocks":[{"id":"blk-49973","kind":"paragraph","spans":[{"id":"spn-56299","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-49972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49974","kind":"heading","level":3,"spans":[{"id":"spn-56300","text":"Autonomy"}]},{"id":"blk-49975","items":[{"blocks":[{"id":"blk-49977","kind":"paragraph","spans":[{"id":"spn-56301","text":"[ ] Do new agents start at "},{"id":"spn-56302","marks":["code"],"text":"observe"},{"id":"spn-56303","text":"?"}]}],"id":"blk-49976","kind":"list-item"},{"blocks":[{"id":"blk-49979","kind":"paragraph","spans":[{"id":"spn-56304","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-49978","kind":"list-item"},{"blocks":[{"id":"blk-49981","kind":"paragraph","spans":[{"id":"spn-56305","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-49980","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49982","kind":"heading","level":3,"spans":[{"id":"spn-56306","text":"Audit"}]},{"id":"blk-49983","items":[{"blocks":[{"id":"blk-49985","kind":"paragraph","spans":[{"id":"spn-56307","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-49984","kind":"list-item"},{"blocks":[{"id":"blk-49987","kind":"paragraph","spans":[{"id":"spn-56308","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-49986","kind":"list-item"},{"blocks":[{"id":"blk-49989","kind":"paragraph","spans":[{"id":"spn-56309","text":"[ ] Is the audit backend appropriate for the deployment (ETS for dev, Ecto for prod)?"}]}],"id":"blk-49988","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49990","kind":"heading","level":3,"spans":[{"id":"spn-56310","text":"Integration"}]},{"id":"blk-49991","items":[{"blocks":[{"id":"blk-49993","kind":"paragraph","spans":[{"id":"spn-56311","text":"[ ] Is Delegatic connected for policy management?"}]}],"id":"blk-49992","kind":"list-item"},{"blocks":[{"id":"blk-49995","kind":"paragraph","spans":[{"id":"spn-56312","text":"[ ] Are Agentelic manifests reviewed before install?"}]}],"id":"blk-49994","kind":"list-item"},{"blocks":[{"id":"blk-49997","kind":"paragraph","spans":[{"id":"spn-56313","text":"[ ] Are marketplace agents treated as untrusted by default?"}]}],"id":"blk-49996","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49998","kind":"heading","level":3,"spans":[{"id":"spn-56314","text":"Operations"}]},{"id":"blk-49999","items":[{"blocks":[{"id":"blk-50001","kind":"paragraph","spans":[{"id":"spn-56315","text":"[ ] Is shim telemetry included in monitoring?"}]}],"id":"blk-50000","kind":"list-item"},{"blocks":[{"id":"blk-50003","kind":"paragraph","spans":[{"id":"spn-56316","text":"[ ] Are ETS table sizes tracked?"}]}],"id":"blk-50002","kind":"list-item"},{"blocks":[{"id":"blk-50005","kind":"paragraph","spans":[{"id":"spn-56317","text":"[ ] Is AuditWriter health monitored?"}]}],"id":"blk-50004","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieradttm2wrwvis2k722cm6lukyspgw5fwrruwzauslarhqxh6lfa6ua","vocabulary":"ampersand.docs.fs.v1"}