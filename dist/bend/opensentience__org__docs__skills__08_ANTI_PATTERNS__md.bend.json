{"bendscript":"0.1","blocks":[{"id":"blk-99240","kind":"heading","level":1,"spans":[{"id":"spn-163578","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-99242","kind":"paragraph","spans":[{"id":"spn-163579","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-99241","kind":"quote"},{"id":"blk-99243","kind":"heading","level":2,"spans":[{"id":"spn-163580","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-99245","spans":[{"id":"spn-163581","text":"#"}]},{"id":"blk-99246","spans":[{"id":"spn-163582","text":"Name"}]},{"id":"blk-99247","spans":[{"id":"spn-163583","text":"Severity"}]},{"id":"blk-99248","spans":[{"id":"spn-163584","text":"Description"}]}],"id":"blk-99244","kind":"table","rows":[[{"id":"blk-99249","spans":[{"id":"spn-163585","text":"1"}]},{"id":"blk-99250","spans":[{"id":"spn-163586","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-99251","spans":[{"id":"spn-163587","text":"Critical"}]},{"id":"blk-99252","spans":[{"id":"spn-163588","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-99253","spans":[{"id":"spn-163589","text":"2"}]},{"id":"blk-99254","spans":[{"id":"spn-163590","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-99255","spans":[{"id":"spn-163591","text":"Critical"}]},{"id":"blk-99256","spans":[{"id":"spn-163592","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-99257","spans":[{"id":"spn-163593","text":"3"}]},{"id":"blk-99258","spans":[{"id":"spn-163594","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-99259","spans":[{"id":"spn-163595","text":"High"}]},{"id":"blk-99260","spans":[{"id":"spn-163596","text":"Ignoring the audit trail"}]}],[{"id":"blk-99261","spans":[{"id":"spn-163597","text":"4"}]},{"id":"blk-99262","spans":[{"id":"spn-163598","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-99263","spans":[{"id":"spn-163599","text":"High"}]},{"id":"blk-99264","spans":[{"id":"spn-163600","text":"Not integrating with Delegatic"}]}],[{"id":"blk-99265","spans":[{"id":"spn-163601","text":"5"}]},{"id":"blk-99266","spans":[{"id":"spn-163602","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-99267","spans":[{"id":"spn-163603","text":"High"}]},{"id":"blk-99268","spans":[{"id":"spn-163604","text":"Treating the shim as a runtime"}]}],[{"id":"blk-99269","spans":[{"id":"spn-163605","text":"6"}]},{"id":"blk-99270","spans":[{"id":"spn-163606","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-99271","spans":[{"id":"spn-163607","text":"High"}]},{"id":"blk-99272","spans":[{"id":"spn-163608","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-99273","spans":[{"id":"spn-163609","text":"7"}]},{"id":"blk-99274","spans":[{"id":"spn-163610","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-99275","spans":[{"id":"spn-163611","text":"Medium"}]},{"id":"blk-99276","spans":[{"id":"spn-163612","text":"Not monitoring shim overhead"}]}],[{"id":"blk-99277","spans":[{"id":"spn-163613","text":"8"}]},{"id":"blk-99278","spans":[{"id":"spn-163614","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-99279","spans":[{"id":"spn-163615","text":"Medium"}]},{"id":"blk-99280","spans":[{"id":"spn-163616","text":"Skipping lifecycle states"}]}]]},{"id":"blk-99281","kind":"heading","level":2,"spans":[{"id":"spn-163617","text":"Critical Anti-Patterns"}]},{"id":"blk-99282","kind":"heading","level":3,"spans":[{"id":"spn-163618","text":"1 — Permission Sprawl"}]},{"id":"blk-99283","kind":"paragraph","spans":[{"id":"spn-163619","marks":["bold"],"text":"The mistake:"},{"id":"spn-163620","text":" Granting "},{"id":"spn-163621","marks":["code"],"text":"*"},{"id":"spn-163622","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-99284","kind":"paragraph","spans":[{"id":"spn-163623","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99285","items":[{"blocks":[{"id":"blk-99287","kind":"paragraph","spans":[{"id":"spn-163624","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-163625","marks":["code"],"text":"allow"}]}],"id":"blk-99286","kind":"list-item"},{"blocks":[{"id":"blk-99289","kind":"paragraph","spans":[{"id":"spn-163626","text":"The audit trail fills with meaningless "},{"id":"spn-163627","marks":["code"],"text":"ok"},{"id":"spn-163628","text":" entries"}]}],"id":"blk-99288","kind":"list-item"},{"blocks":[{"id":"blk-99291","kind":"paragraph","spans":[{"id":"spn-163629","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-99290","kind":"list-item"},{"blocks":[{"id":"blk-99293","kind":"paragraph","spans":[{"id":"spn-163630","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-99292","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99294","kind":"paragraph","spans":[{"id":"spn-163631","marks":["bold"],"text":"The fix:"},{"id":"spn-163632","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-99295","kind":"paragraph","spans":[{"id":"spn-163633","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-99296","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-99297","kind":"paragraph","spans":[{"id":"spn-163634","marks":["bold"],"text":"After (good):"}]},{"id":"blk-99298","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-99299","kind":"heading","level":3,"spans":[{"id":"spn-163635","text":"2 — Trust Skipping"}]},{"id":"blk-99300","kind":"paragraph","spans":[{"id":"spn-163636","marks":["bold"],"text":"The mistake:"},{"id":"spn-163637","text":" Setting a new agent directly to "},{"id":"spn-163638","marks":["code"],"text":"act"},{"id":"spn-163639","text":" autonomy without any observation or advise period."}]},{"id":"blk-99301","kind":"paragraph","spans":[{"id":"spn-163640","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99302","items":[{"blocks":[{"id":"blk-99304","kind":"paragraph","spans":[{"id":"spn-163641","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-99303","kind":"list-item"},{"blocks":[{"id":"blk-99306","kind":"paragraph","spans":[{"id":"spn-163642","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-99305","kind":"list-item"},{"blocks":[{"id":"blk-99308","kind":"paragraph","spans":[{"id":"spn-163643","text":"The audit trail has no "},{"id":"spn-163644","marks":["code"],"text":"action_recommended"},{"id":"spn-163645","text":" or approval records to review"}]}],"id":"blk-99307","kind":"list-item"},{"blocks":[{"id":"blk-99310","kind":"paragraph","spans":[{"id":"spn-163646","text":"Trust is assumed, not earned"}]}],"id":"blk-99309","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99311","kind":"paragraph","spans":[{"id":"spn-163647","marks":["bold"],"text":"The fix:"},{"id":"spn-163648","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-163649","marks":["code"],"text":"observe"},{"id":"spn-163650","text":", review recommendations, promote to "},{"id":"spn-163651","marks":["code"],"text":"advise"},{"id":"spn-163652","text":", review approvals, then promote to "},{"id":"spn-163653","marks":["code"],"text":"act"},{"id":"spn-163654","text":" when confidence is established."}]},{"id":"blk-99312","kind":"paragraph","spans":[{"id":"spn-163655","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-99313","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-99314","kind":"paragraph","spans":[{"id":"spn-163656","marks":["bold"],"text":"After (good):"}]},{"id":"blk-99315","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-99316","kind":"heading","level":2,"spans":[{"id":"spn-163657","text":"High-Severity Anti-Patterns"}]},{"id":"blk-99317","kind":"heading","level":3,"spans":[{"id":"spn-163658","text":"3 — Audit Blindness"}]},{"id":"blk-99318","kind":"paragraph","spans":[{"id":"spn-163659","marks":["bold"],"text":"The mistake:"},{"id":"spn-163660","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-99319","kind":"paragraph","spans":[{"id":"spn-163661","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99320","items":[{"blocks":[{"id":"blk-99322","kind":"paragraph","spans":[{"id":"spn-163662","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-99321","kind":"list-item"},{"blocks":[{"id":"blk-99324","kind":"paragraph","spans":[{"id":"spn-163663","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-99323","kind":"list-item"},{"blocks":[{"id":"blk-99326","kind":"paragraph","spans":[{"id":"spn-163664","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-99325","kind":"list-item"},{"blocks":[{"id":"blk-99328","kind":"paragraph","spans":[{"id":"spn-163665","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-99327","kind":"list-item"},{"blocks":[{"id":"blk-99330","kind":"paragraph","spans":[{"id":"spn-163666","text":"The audit system costs resources for zero value"}]}],"id":"blk-99329","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99331","kind":"paragraph","spans":[{"id":"spn-163667","marks":["bold"],"text":"The fix:"},{"id":"spn-163668","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-99332","kind":"heading","level":3,"spans":[{"id":"spn-163669","text":"4 — Island Governance"}]},{"id":"blk-99333","kind":"paragraph","spans":[{"id":"spn-163670","marks":["bold"],"text":"The mistake:"},{"id":"spn-163671","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-99334","kind":"paragraph","spans":[{"id":"spn-163672","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99335","items":[{"blocks":[{"id":"blk-99337","kind":"paragraph","spans":[{"id":"spn-163673","text":"No centralized policy management across agents"}]}],"id":"blk-99336","kind":"list-item"},{"blocks":[{"id":"blk-99339","kind":"paragraph","spans":[{"id":"spn-163674","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-99338","kind":"list-item"},{"blocks":[{"id":"blk-99341","kind":"paragraph","spans":[{"id":"spn-163675","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-99340","kind":"list-item"},{"blocks":[{"id":"blk-99343","kind":"paragraph","spans":[{"id":"spn-163676","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-99342","kind":"list-item"},{"blocks":[{"id":"blk-99345","kind":"paragraph","spans":[{"id":"spn-163677","text":"No policy versioning or rollback capability"}]}],"id":"blk-99344","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99346","kind":"paragraph","spans":[{"id":"spn-163678","marks":["bold"],"text":"The fix:"},{"id":"spn-163679","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-99347","kind":"heading","level":3,"spans":[{"id":"spn-163680","text":"5 — Shim Confusion"}]},{"id":"blk-99348","kind":"paragraph","spans":[{"id":"spn-163681","marks":["bold"],"text":"The mistake:"},{"id":"spn-163682","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-99349","kind":"paragraph","spans":[{"id":"spn-163683","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99350","items":[{"blocks":[{"id":"blk-99352","kind":"paragraph","spans":[{"id":"spn-163684","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-99351","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99353","kind":"paragraph","spans":[{"id":"spn-163685","text":"OTP process."}]},{"id":"blk-99354","items":[{"blocks":[{"id":"blk-99356","kind":"paragraph","spans":[{"id":"spn-163686","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-99355","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99357","kind":"paragraph","spans":[{"id":"spn-163687","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-99358","items":[{"blocks":[{"id":"blk-99360","kind":"paragraph","spans":[{"id":"spn-163688","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-99359","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99361","kind":"paragraph","spans":[{"id":"spn-163689","marks":["bold"],"text":"The fix:"},{"id":"spn-163690","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-99362","kind":"heading","level":3,"spans":[{"id":"spn-163691","text":"6 — Unchecked Actions"}]},{"id":"blk-99363","kind":"paragraph","spans":[{"id":"spn-163692","marks":["bold"],"text":"The mistake:"},{"id":"spn-163693","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-163694","marks":["code"],"text":"permission_check"},{"id":"spn-163695","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-99364","kind":"paragraph","spans":[{"id":"spn-163696","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99365","items":[{"blocks":[{"id":"blk-99367","kind":"paragraph","spans":[{"id":"spn-163697","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-99366","kind":"list-item"},{"blocks":[{"id":"blk-99369","kind":"paragraph","spans":[{"id":"spn-163698","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-99368","kind":"list-item"},{"blocks":[{"id":"blk-99371","kind":"paragraph","spans":[{"id":"spn-163699","text":"An agent at "},{"id":"spn-163700","marks":["code"],"text":"act"},{"id":"spn-163701","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-99370","kind":"list-item"},{"blocks":[{"id":"blk-99373","kind":"paragraph","spans":[{"id":"spn-163702","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-99372","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99374","kind":"paragraph","spans":[{"id":"spn-163703","text":"resources were accessed"}]},{"id":"blk-99375","kind":"paragraph","spans":[{"id":"spn-163704","marks":["bold"],"text":"The fix:"},{"id":"spn-163705","text":" Always call "},{"id":"spn-163706","marks":["code"],"text":"permission_check"},{"id":"spn-163707","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-99376","kind":"heading","level":2,"spans":[{"id":"spn-163708","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-99377","kind":"heading","level":3,"spans":[{"id":"spn-163709","text":"7 — Telemetry Neglect"}]},{"id":"blk-99378","kind":"paragraph","spans":[{"id":"spn-163710","marks":["bold"],"text":"The mistake:"},{"id":"spn-163711","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-99379","kind":"paragraph","spans":[{"id":"spn-163712","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99380","items":[{"blocks":[{"id":"blk-99382","kind":"paragraph","spans":[{"id":"spn-163713","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-99381","kind":"list-item"},{"blocks":[{"id":"blk-99384","kind":"paragraph","spans":[{"id":"spn-163714","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-99383","kind":"list-item"},{"blocks":[{"id":"blk-99386","kind":"paragraph","spans":[{"id":"spn-163715","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-99385","kind":"list-item"},{"blocks":[{"id":"blk-99388","kind":"paragraph","spans":[{"id":"spn-163716","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-99387","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99389","kind":"paragraph","spans":[{"id":"spn-163717","marks":["bold"],"text":"The fix:"},{"id":"spn-163718","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-99390","items":[{"blocks":[{"id":"blk-99392","kind":"paragraph","spans":[{"id":"spn-163719","text":"ETS table sizes for "},{"id":"spn-163720","marks":["code"],"text":":os_permissions"},{"id":"spn-163721","text":" and "},{"id":"spn-163722","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-99391","kind":"list-item"},{"blocks":[{"id":"blk-99394","kind":"paragraph","spans":[{"id":"spn-163723","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-99393","kind":"list-item"},{"blocks":[{"id":"blk-99396","kind":"paragraph","spans":[{"id":"spn-163724","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-99395","kind":"list-item"},{"blocks":[{"id":"blk-99398","kind":"paragraph","spans":[{"id":"spn-163725","text":"Agent count under AgentSupervisor"}]}],"id":"blk-99397","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99399","kind":"heading","level":3,"spans":[{"id":"spn-163726","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-99400","kind":"paragraph","spans":[{"id":"spn-163727","marks":["bold"],"text":"The mistake:"},{"id":"spn-163728","text":" Attempting to jump from "},{"id":"spn-163729","marks":["code"],"text":"installed"},{"id":"spn-163730","text":" directly to "},{"id":"spn-163731","marks":["code"],"text":"running"},{"id":"spn-163732","text":", or from "},{"id":"spn-163733","marks":["code"],"text":"running"},{"id":"spn-163734","text":" directly to "},{"id":"spn-163735","marks":["code"],"text":"removed"},{"id":"spn-163736","text":", bypassing intermediate states."}]},{"id":"blk-99401","kind":"paragraph","spans":[{"id":"spn-163737","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-99402","items":[{"blocks":[{"id":"blk-99404","kind":"paragraph","spans":[{"id":"spn-163738","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-99403","kind":"list-item"},{"blocks":[{"id":"blk-99406","kind":"paragraph","spans":[{"id":"spn-163739","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-99405","kind":"list-item"},{"blocks":[{"id":"blk-99408","kind":"paragraph","spans":[{"id":"spn-163740","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-99407","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99409","kind":"paragraph","spans":[{"id":"spn-163741","marks":["bold"],"text":"The fix:"},{"id":"spn-163742","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-163743","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-163744","text":". There are no shortcuts."}]},{"id":"blk-99410","kind":"heading","level":2,"spans":[{"id":"spn-163745","text":"Self-Audit Checklist"}]},{"id":"blk-99411","kind":"paragraph","spans":[{"id":"spn-163746","text":"Run through this periodically:"}]},{"id":"blk-99412","kind":"heading","level":3,"spans":[{"id":"spn-163747","text":"Permissions"}]},{"id":"blk-99413","items":[{"blocks":[{"id":"blk-99415","kind":"paragraph","spans":[{"id":"spn-163748","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-99414","kind":"list-item"},{"blocks":[{"id":"blk-99417","kind":"paragraph","spans":[{"id":"spn-163749","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-99416","kind":"list-item"},{"blocks":[{"id":"blk-99419","kind":"paragraph","spans":[{"id":"spn-163750","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-99418","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99420","kind":"heading","level":3,"spans":[{"id":"spn-163751","text":"Autonomy"}]},{"id":"blk-99421","items":[{"blocks":[{"id":"blk-99423","kind":"paragraph","spans":[{"id":"spn-163752","text":"[ ] Do new agents start at "},{"id":"spn-163753","marks":["code"],"text":"observe"},{"id":"spn-163754","text":"?"}]}],"id":"blk-99422","kind":"list-item"},{"blocks":[{"id":"blk-99425","kind":"paragraph","spans":[{"id":"spn-163755","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-99424","kind":"list-item"},{"blocks":[{"id":"blk-99427","kind":"paragraph","spans":[{"id":"spn-163756","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-99426","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99428","kind":"heading","level":3,"spans":[{"id":"spn-163757","text":"Audit"}]},{"id":"blk-99429","items":[{"blocks":[{"id":"blk-99431","kind":"paragraph","spans":[{"id":"spn-163758","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-99430","kind":"list-item"},{"blocks":[{"id":"blk-99433","kind":"paragraph","spans":[{"id":"spn-163759","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-99432","kind":"list-item"},{"blocks":[{"id":"blk-99435","kind":"paragraph","spans":[{"id":"spn-163760","text":"[ ] Is the audit backend appropriate for the deployment (ETS for dev, Ecto for prod)?"}]}],"id":"blk-99434","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99436","kind":"heading","level":3,"spans":[{"id":"spn-163761","text":"Integration"}]},{"id":"blk-99437","items":[{"blocks":[{"id":"blk-99439","kind":"paragraph","spans":[{"id":"spn-163762","text":"[ ] Is Delegatic connected for policy management?"}]}],"id":"blk-99438","kind":"list-item"},{"blocks":[{"id":"blk-99441","kind":"paragraph","spans":[{"id":"spn-163763","text":"[ ] Are Agentelic manifests reviewed before install?"}]}],"id":"blk-99440","kind":"list-item"},{"blocks":[{"id":"blk-99443","kind":"paragraph","spans":[{"id":"spn-163764","text":"[ ] Are marketplace agents treated as untrusted by default?"}]}],"id":"blk-99442","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-99444","kind":"heading","leve