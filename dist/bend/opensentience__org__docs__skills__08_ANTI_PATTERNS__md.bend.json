{"bendscript":"0.1","blocks":[{"id":"blk-75915","kind":"heading","level":1,"spans":[{"id":"spn-107263","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-75917","kind":"paragraph","spans":[{"id":"spn-107264","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-75916","kind":"quote"},{"id":"blk-75918","kind":"heading","level":2,"spans":[{"id":"spn-107265","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-75920","spans":[{"id":"spn-107266","text":"#"}]},{"id":"blk-75921","spans":[{"id":"spn-107267","text":"Name"}]},{"id":"blk-75922","spans":[{"id":"spn-107268","text":"Severity"}]},{"id":"blk-75923","spans":[{"id":"spn-107269","text":"Description"}]}],"id":"blk-75919","kind":"table","rows":[[{"id":"blk-75924","spans":[{"id":"spn-107270","text":"1"}]},{"id":"blk-75925","spans":[{"id":"spn-107271","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-75926","spans":[{"id":"spn-107272","text":"Critical"}]},{"id":"blk-75927","spans":[{"id":"spn-107273","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-75928","spans":[{"id":"spn-107274","text":"2"}]},{"id":"blk-75929","spans":[{"id":"spn-107275","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-75930","spans":[{"id":"spn-107276","text":"Critical"}]},{"id":"blk-75931","spans":[{"id":"spn-107277","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-75932","spans":[{"id":"spn-107278","text":"3"}]},{"id":"blk-75933","spans":[{"id":"spn-107279","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-75934","spans":[{"id":"spn-107280","text":"High"}]},{"id":"blk-75935","spans":[{"id":"spn-107281","text":"Ignoring the audit trail"}]}],[{"id":"blk-75936","spans":[{"id":"spn-107282","text":"4"}]},{"id":"blk-75937","spans":[{"id":"spn-107283","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-75938","spans":[{"id":"spn-107284","text":"High"}]},{"id":"blk-75939","spans":[{"id":"spn-107285","text":"Not integrating with Delegatic"}]}],[{"id":"blk-75940","spans":[{"id":"spn-107286","text":"5"}]},{"id":"blk-75941","spans":[{"id":"spn-107287","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-75942","spans":[{"id":"spn-107288","text":"High"}]},{"id":"blk-75943","spans":[{"id":"spn-107289","text":"Treating the shim as a runtime"}]}],[{"id":"blk-75944","spans":[{"id":"spn-107290","text":"6"}]},{"id":"blk-75945","spans":[{"id":"spn-107291","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-75946","spans":[{"id":"spn-107292","text":"High"}]},{"id":"blk-75947","spans":[{"id":"spn-107293","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-75948","spans":[{"id":"spn-107294","text":"7"}]},{"id":"blk-75949","spans":[{"id":"spn-107295","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-75950","spans":[{"id":"spn-107296","text":"Medium"}]},{"id":"blk-75951","spans":[{"id":"spn-107297","text":"Not monitoring shim overhead"}]}],[{"id":"blk-75952","spans":[{"id":"spn-107298","text":"8"}]},{"id":"blk-75953","spans":[{"id":"spn-107299","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-75954","spans":[{"id":"spn-107300","text":"Medium"}]},{"id":"blk-75955","spans":[{"id":"spn-107301","text":"Skipping lifecycle states"}]}]]},{"id":"blk-75956","kind":"heading","level":2,"spans":[{"id":"spn-107302","text":"Critical Anti-Patterns"}]},{"id":"blk-75957","kind":"heading","level":3,"spans":[{"id":"spn-107303","text":"1 — Permission Sprawl"}]},{"id":"blk-75958","kind":"paragraph","spans":[{"id":"spn-107304","marks":["bold"],"text":"The mistake:"},{"id":"spn-107305","text":" Granting "},{"id":"spn-107306","marks":["code"],"text":"*"},{"id":"spn-107307","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-75959","kind":"paragraph","spans":[{"id":"spn-107308","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75960","items":[{"blocks":[{"id":"blk-75962","kind":"paragraph","spans":[{"id":"spn-107309","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-107310","marks":["code"],"text":"allow"}]}],"id":"blk-75961","kind":"list-item"},{"blocks":[{"id":"blk-75964","kind":"paragraph","spans":[{"id":"spn-107311","text":"The audit trail fills with meaningless "},{"id":"spn-107312","marks":["code"],"text":"ok"},{"id":"spn-107313","text":" entries"}]}],"id":"blk-75963","kind":"list-item"},{"blocks":[{"id":"blk-75966","kind":"paragraph","spans":[{"id":"spn-107314","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-75965","kind":"list-item"},{"blocks":[{"id":"blk-75968","kind":"paragraph","spans":[{"id":"spn-107315","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-75967","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75969","kind":"paragraph","spans":[{"id":"spn-107316","marks":["bold"],"text":"The fix:"},{"id":"spn-107317","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-75970","kind":"paragraph","spans":[{"id":"spn-107318","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-75971","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-75972","kind":"paragraph","spans":[{"id":"spn-107319","marks":["bold"],"text":"After (good):"}]},{"id":"blk-75973","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-75974","kind":"heading","level":3,"spans":[{"id":"spn-107320","text":"2 — Trust Skipping"}]},{"id":"blk-75975","kind":"paragraph","spans":[{"id":"spn-107321","marks":["bold"],"text":"The mistake:"},{"id":"spn-107322","text":" Setting a new agent directly to "},{"id":"spn-107323","marks":["code"],"text":"act"},{"id":"spn-107324","text":" autonomy without any observation or advise period."}]},{"id":"blk-75976","kind":"paragraph","spans":[{"id":"spn-107325","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75977","items":[{"blocks":[{"id":"blk-75979","kind":"paragraph","spans":[{"id":"spn-107326","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-75978","kind":"list-item"},{"blocks":[{"id":"blk-75981","kind":"paragraph","spans":[{"id":"spn-107327","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-75980","kind":"list-item"},{"blocks":[{"id":"blk-75983","kind":"paragraph","spans":[{"id":"spn-107328","text":"The audit trail has no "},{"id":"spn-107329","marks":["code"],"text":"action_recommended"},{"id":"spn-107330","text":" or approval records to review"}]}],"id":"blk-75982","kind":"list-item"},{"blocks":[{"id":"blk-75985","kind":"paragraph","spans":[{"id":"spn-107331","text":"Trust is assumed, not earned"}]}],"id":"blk-75984","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75986","kind":"paragraph","spans":[{"id":"spn-107332","marks":["bold"],"text":"The fix:"},{"id":"spn-107333","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-107334","marks":["code"],"text":"observe"},{"id":"spn-107335","text":", review recommendations, promote to "},{"id":"spn-107336","marks":["code"],"text":"advise"},{"id":"spn-107337","text":", review approvals, then promote to "},{"id":"spn-107338","marks":["code"],"text":"act"},{"id":"spn-107339","text":" when confidence is established."}]},{"id":"blk-75987","kind":"paragraph","spans":[{"id":"spn-107340","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-75988","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-75989","kind":"paragraph","spans":[{"id":"spn-107341","marks":["bold"],"text":"After (good):"}]},{"id":"blk-75990","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-75991","kind":"heading","level":2,"spans":[{"id":"spn-107342","text":"High-Severity Anti-Patterns"}]},{"id":"blk-75992","kind":"heading","level":3,"spans":[{"id":"spn-107343","text":"3 — Audit Blindness"}]},{"id":"blk-75993","kind":"paragraph","spans":[{"id":"spn-107344","marks":["bold"],"text":"The mistake:"},{"id":"spn-107345","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-75994","kind":"paragraph","spans":[{"id":"spn-107346","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-75995","items":[{"blocks":[{"id":"blk-75997","kind":"paragraph","spans":[{"id":"spn-107347","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-75996","kind":"list-item"},{"blocks":[{"id":"blk-75999","kind":"paragraph","spans":[{"id":"spn-107348","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-75998","kind":"list-item"},{"blocks":[{"id":"blk-76001","kind":"paragraph","spans":[{"id":"spn-107349","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-76000","kind":"list-item"},{"blocks":[{"id":"blk-76003","kind":"paragraph","spans":[{"id":"spn-107350","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-76002","kind":"list-item"},{"blocks":[{"id":"blk-76005","kind":"paragraph","spans":[{"id":"spn-107351","text":"The audit system costs resources for zero value"}]}],"id":"blk-76004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76006","kind":"paragraph","spans":[{"id":"spn-107352","marks":["bold"],"text":"The fix:"},{"id":"spn-107353","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-76007","kind":"heading","level":3,"spans":[{"id":"spn-107354","text":"4 — Island Governance"}]},{"id":"blk-76008","kind":"paragraph","spans":[{"id":"spn-107355","marks":["bold"],"text":"The mistake:"},{"id":"spn-107356","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-76009","kind":"paragraph","spans":[{"id":"spn-107357","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76010","items":[{"blocks":[{"id":"blk-76012","kind":"paragraph","spans":[{"id":"spn-107358","text":"No centralized policy management across agents"}]}],"id":"blk-76011","kind":"list-item"},{"blocks":[{"id":"blk-76014","kind":"paragraph","spans":[{"id":"spn-107359","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-76013","kind":"list-item"},{"blocks":[{"id":"blk-76016","kind":"paragraph","spans":[{"id":"spn-107360","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-76015","kind":"list-item"},{"blocks":[{"id":"blk-76018","kind":"paragraph","spans":[{"id":"spn-107361","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-76017","kind":"list-item"},{"blocks":[{"id":"blk-76020","kind":"paragraph","spans":[{"id":"spn-107362","text":"No policy versioning or rollback capability"}]}],"id":"blk-76019","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76021","kind":"paragraph","spans":[{"id":"spn-107363","marks":["bold"],"text":"The fix:"},{"id":"spn-107364","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-76022","kind":"heading","level":3,"spans":[{"id":"spn-107365","text":"5 — Shim Confusion"}]},{"id":"blk-76023","kind":"paragraph","spans":[{"id":"spn-107366","marks":["bold"],"text":"The mistake:"},{"id":"spn-107367","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-76024","kind":"paragraph","spans":[{"id":"spn-107368","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76025","items":[{"blocks":[{"id":"blk-76027","kind":"paragraph","spans":[{"id":"spn-107369","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-76026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76028","kind":"paragraph","spans":[{"id":"spn-107370","text":"OTP process."}]},{"id":"blk-76029","items":[{"blocks":[{"id":"blk-76031","kind":"paragraph","spans":[{"id":"spn-107371","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-76030","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76032","kind":"paragraph","spans":[{"id":"spn-107372","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-76033","items":[{"blocks":[{"id":"blk-76035","kind":"paragraph","spans":[{"id":"spn-107373","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-76034","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76036","kind":"paragraph","spans":[{"id":"spn-107374","marks":["bold"],"text":"The fix:"},{"id":"spn-107375","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-76037","kind":"heading","level":3,"spans":[{"id":"spn-107376","text":"6 — Unchecked Actions"}]},{"id":"blk-76038","kind":"paragraph","spans":[{"id":"spn-107377","marks":["bold"],"text":"The mistake:"},{"id":"spn-107378","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-107379","marks":["code"],"text":"permission_check"},{"id":"spn-107380","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-76039","kind":"paragraph","spans":[{"id":"spn-107381","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76040","items":[{"blocks":[{"id":"blk-76042","kind":"paragraph","spans":[{"id":"spn-107382","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-76041","kind":"list-item"},{"blocks":[{"id":"blk-76044","kind":"paragraph","spans":[{"id":"spn-107383","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-76043","kind":"list-item"},{"blocks":[{"id":"blk-76046","kind":"paragraph","spans":[{"id":"spn-107384","text":"An agent at "},{"id":"spn-107385","marks":["code"],"text":"act"},{"id":"spn-107386","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-76045","kind":"list-item"},{"blocks":[{"id":"blk-76048","kind":"paragraph","spans":[{"id":"spn-107387","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-76047","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76049","kind":"paragraph","spans":[{"id":"spn-107388","text":"resources were accessed"}]},{"id":"blk-76050","kind":"paragraph","spans":[{"id":"spn-107389","marks":["bold"],"text":"The fix:"},{"id":"spn-107390","text":" Always call "},{"id":"spn-107391","marks":["code"],"text":"permission_check"},{"id":"spn-107392","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-76051","kind":"heading","level":2,"spans":[{"id":"spn-107393","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-76052","kind":"heading","level":3,"spans":[{"id":"spn-107394","text":"7 — Telemetry Neglect"}]},{"id":"blk-76053","kind":"paragraph","spans":[{"id":"spn-107395","marks":["bold"],"text":"The mistake:"},{"id":"spn-107396","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-76054","kind":"paragraph","spans":[{"id":"spn-107397","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76055","items":[{"blocks":[{"id":"blk-76057","kind":"paragraph","spans":[{"id":"spn-107398","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-76056","kind":"list-item"},{"blocks":[{"id":"blk-76059","kind":"paragraph","spans":[{"id":"spn-107399","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-76058","kind":"list-item"},{"blocks":[{"id":"blk-76061","kind":"paragraph","spans":[{"id":"spn-107400","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-76060","kind":"list-item"},{"blocks":[{"id":"blk-76063","kind":"paragraph","spans":[{"id":"spn-107401","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-76062","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76064","kind":"paragraph","spans":[{"id":"spn-107402","marks":["bold"],"text":"The fix:"},{"id":"spn-107403","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-76065","items":[{"blocks":[{"id":"blk-76067","kind":"paragraph","spans":[{"id":"spn-107404","text":"ETS table sizes for "},{"id":"spn-107405","marks":["code"],"text":":os_permissions"},{"id":"spn-107406","text":" and "},{"id":"spn-107407","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-76066","kind":"list-item"},{"blocks":[{"id":"blk-76069","kind":"paragraph","spans":[{"id":"spn-107408","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-76068","kind":"list-item"},{"blocks":[{"id":"blk-76071","kind":"paragraph","spans":[{"id":"spn-107409","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-76070","kind":"list-item"},{"blocks":[{"id":"blk-76073","kind":"paragraph","spans":[{"id":"spn-107410","text":"Agent count under AgentSupervisor"}]}],"id":"blk-76072","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76074","kind":"heading","level":3,"spans":[{"id":"spn-107411","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-76075","kind":"paragraph","spans":[{"id":"spn-107412","marks":["bold"],"text":"The mistake:"},{"id":"spn-107413","text":" Attempting to jump from "},{"id":"spn-107414","marks":["code"],"text":"installed"},{"id":"spn-107415","text":" directly to "},{"id":"spn-107416","marks":["code"],"text":"running"},{"id":"spn-107417","text":", or from "},{"id":"spn-107418","marks":["code"],"text":"running"},{"id":"spn-107419","text":" directly to "},{"id":"spn-107420","marks":["code"],"text":"removed"},{"id":"spn-107421","text":", bypassing intermediate states."}]},{"id":"blk-76076","kind":"paragraph","spans":[{"id":"spn-107422","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76077","items":[{"blocks":[{"id":"blk-76079","kind":"paragraph","spans":[{"id":"spn-107423","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-76078","kind":"list-item"},{"blocks":[{"id":"blk-76081","kind":"paragraph","spans":[{"id":"spn-107424","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-76080","kind":"list-item"},{"blocks":[{"id":"blk-76083","kind":"paragraph","spans":[{"id":"spn-107425","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-76082","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76084","kind":"paragraph","spans":[{"id":"spn-107426","marks":["bold"],"text":"The fix:"},{"id":"spn-107427","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-107428","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-107429","text":". There are no shortcuts."}]},{"id":"blk-76085","kind":"heading","level":2,"spans":[{"id":"spn-107430","text":"Self-Audit Checklist"}]},{"id":"blk-76086","kind":"paragraph","spans":[{"id":"spn-107431","text":"Run through this periodically:"}]},{"id":"blk-76087","kind":"heading","level":3,"spans":[{"id":"spn-107432","text":"Permissions"}]},{"id":"blk-76088","items":[{"blocks":[{"id":"blk-76090","kind":"paragraph","spans":[{"id":"spn-107433","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-76089","kind":"list-item"},{"blocks":[{"id":"blk-76092","kind":"paragraph","spans":[{"id":"spn-107434","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-76091","kind":"list-item"},{"blocks":[{"id":"blk-76094","kind":"paragraph","spans":[{"id":"spn-107435","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-76093","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76095","kind":"heading","level":3,"spans":[{"id":"spn-107436","text":"Autonomy"}]},{"id":"blk-76096","items":[{"blocks":[{"id":"blk-76098","kind":"paragraph","spans":[{"id":"spn-107437","text":"[ ] Do new agents start at "},{"id":"spn-107438","marks":["code"],"text":"observe"},{"id":"spn-107439","text":"?"}]}],"id":"blk-76097","kind":"list-item"},{"blocks":[{"id":"blk-76100","kind":"paragraph","spans":[{"id":"spn-107440","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-76099","kind":"list-item"},{"blocks":[{"id":"blk-76102","kind":"paragraph","spans":[{"id":"spn-107441","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-76101","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76103","kind":"heading","level":3,"spans":[{"id":"spn-107442","text":"Audit"}]},{"id":"blk-76104","items":[{"blocks":[{"id":"blk-76106","kind":"paragraph","spans":[{"id":"spn-107443","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-76105","kind":"list-item"},{"blocks":[{"id":"blk-76108","kind":"paragraph","spans":[{"id":"spn-107444","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-76107","kind":"list-item"},{"blocks":[{"id":"blk-76110","kind":"paragraph","spans":[{"id":"spn-107445","text":"[ ] Is the audit backend appropriate for the deployment (ETS for dev, Ecto for prod)?"}]}],"id":"blk-76109","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76111","kind":"heading","level":3,"spans":[{"id":"spn-107446","text":"Integration"}]},{"id":"blk-76112","items":[{"blocks":[{"id":"blk-76114","kind":"paragraph","spans":[{"id":"spn-107447","text":"[ ] Is Delegatic connected for policy management?"}]}],"id":"blk-76113","kind":"list-item"},{"blocks":[{"id":"blk-76116","kind":"paragraph","spans":[{"id":"spn-107448","text":"[ ] Are Agentelic manifests reviewed before install?"}]}],"id":"blk-76115","kind":"list-item"},{"blocks":[{"id":"blk-76118","kind":"paragraph","spans":[{"id":"spn-107449","text":"[ ] Are marketplace agents treated as untrusted by default?"}]}],"id":"blk-76117","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76119","kind":"heading","level":3,"spans":[{"id":"spn-107450","text":"Operations"}]},{"id":"blk-76120","items":[{"blocks":[{"id":"blk-76122","kind":"paragraph","spans":[{"id":"spn-107451","text":"[ ] Is shim telemetry included in monitoring?"}]}],"id":"blk-76121","kind":"list-item"},{"blocks":[{"id":"blk-76124","kind":"paragraph","spans":[{"id":"spn-107452","text":"[ ] Are ETS table sizes tracked?"}]}],"id":"blk-76123","kind":"list-item"},{"blocks":[{"id":"blk-76126","kind":"paragraph","spans":[{"id":"spn-107453","text":"[ ] Is AuditWriter health monitored?"}]}],"id":"blk-76125","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera6w4ghzzx2wlul4t2eayvh3fy4s7ucxkp3g4mjim3i4zjqkl6qq7q","vocabulary":"ampersand.docs.fs.v1"}