{"bendscript":"0.1","blocks":[{"id":"blk-76743","kind":"heading","level":1,"spans":[{"id":"spn-109876","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-76745","kind":"paragraph","spans":[{"id":"spn-109877","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-76744","kind":"quote"},{"id":"blk-76746","kind":"heading","level":2,"spans":[{"id":"spn-109878","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-76748","spans":[{"id":"spn-109879","text":"#"}]},{"id":"blk-76749","spans":[{"id":"spn-109880","text":"Name"}]},{"id":"blk-76750","spans":[{"id":"spn-109881","text":"Severity"}]},{"id":"blk-76751","spans":[{"id":"spn-109882","text":"Description"}]}],"id":"blk-76747","kind":"table","rows":[[{"id":"blk-76752","spans":[{"id":"spn-109883","text":"1"}]},{"id":"blk-76753","spans":[{"id":"spn-109884","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-76754","spans":[{"id":"spn-109885","text":"Critical"}]},{"id":"blk-76755","spans":[{"id":"spn-109886","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-76756","spans":[{"id":"spn-109887","text":"2"}]},{"id":"blk-76757","spans":[{"id":"spn-109888","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-76758","spans":[{"id":"spn-109889","text":"Critical"}]},{"id":"blk-76759","spans":[{"id":"spn-109890","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-76760","spans":[{"id":"spn-109891","text":"3"}]},{"id":"blk-76761","spans":[{"id":"spn-109892","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-76762","spans":[{"id":"spn-109893","text":"High"}]},{"id":"blk-76763","spans":[{"id":"spn-109894","text":"Ignoring the audit trail"}]}],[{"id":"blk-76764","spans":[{"id":"spn-109895","text":"4"}]},{"id":"blk-76765","spans":[{"id":"spn-109896","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-76766","spans":[{"id":"spn-109897","text":"High"}]},{"id":"blk-76767","spans":[{"id":"spn-109898","text":"Not integrating with Delegatic"}]}],[{"id":"blk-76768","spans":[{"id":"spn-109899","text":"5"}]},{"id":"blk-76769","spans":[{"id":"spn-109900","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-76770","spans":[{"id":"spn-109901","text":"High"}]},{"id":"blk-76771","spans":[{"id":"spn-109902","text":"Treating the shim as a runtime"}]}],[{"id":"blk-76772","spans":[{"id":"spn-109903","text":"6"}]},{"id":"blk-76773","spans":[{"id":"spn-109904","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-76774","spans":[{"id":"spn-109905","text":"High"}]},{"id":"blk-76775","spans":[{"id":"spn-109906","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-76776","spans":[{"id":"spn-109907","text":"7"}]},{"id":"blk-76777","spans":[{"id":"spn-109908","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-76778","spans":[{"id":"spn-109909","text":"Medium"}]},{"id":"blk-76779","spans":[{"id":"spn-109910","text":"Not monitoring shim overhead"}]}],[{"id":"blk-76780","spans":[{"id":"spn-109911","text":"8"}]},{"id":"blk-76781","spans":[{"id":"spn-109912","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-76782","spans":[{"id":"spn-109913","text":"Medium"}]},{"id":"blk-76783","spans":[{"id":"spn-109914","text":"Skipping lifecycle states"}]}]]},{"id":"blk-76784","kind":"heading","level":2,"spans":[{"id":"spn-109915","text":"Critical Anti-Patterns"}]},{"id":"blk-76785","kind":"heading","level":3,"spans":[{"id":"spn-109916","text":"1 — Permission Sprawl"}]},{"id":"blk-76786","kind":"paragraph","spans":[{"id":"spn-109917","marks":["bold"],"text":"The mistake:"},{"id":"spn-109918","text":" Granting "},{"id":"spn-109919","marks":["code"],"text":"*"},{"id":"spn-109920","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-76787","kind":"paragraph","spans":[{"id":"spn-109921","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76788","items":[{"blocks":[{"id":"blk-76790","kind":"paragraph","spans":[{"id":"spn-109922","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-109923","marks":["code"],"text":"allow"}]}],"id":"blk-76789","kind":"list-item"},{"blocks":[{"id":"blk-76792","kind":"paragraph","spans":[{"id":"spn-109924","text":"The audit trail fills with meaningless "},{"id":"spn-109925","marks":["code"],"text":"ok"},{"id":"spn-109926","text":" entries"}]}],"id":"blk-76791","kind":"list-item"},{"blocks":[{"id":"blk-76794","kind":"paragraph","spans":[{"id":"spn-109927","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-76793","kind":"list-item"},{"blocks":[{"id":"blk-76796","kind":"paragraph","spans":[{"id":"spn-109928","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-76795","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76797","kind":"paragraph","spans":[{"id":"spn-109929","marks":["bold"],"text":"The fix:"},{"id":"spn-109930","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-76798","kind":"paragraph","spans":[{"id":"spn-109931","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-76799","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-76800","kind":"paragraph","spans":[{"id":"spn-109932","marks":["bold"],"text":"After (good):"}]},{"id":"blk-76801","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-76802","kind":"heading","level":3,"spans":[{"id":"spn-109933","text":"2 — Trust Skipping"}]},{"id":"blk-76803","kind":"paragraph","spans":[{"id":"spn-109934","marks":["bold"],"text":"The mistake:"},{"id":"spn-109935","text":" Setting a new agent directly to "},{"id":"spn-109936","marks":["code"],"text":"act"},{"id":"spn-109937","text":" autonomy without any observation or advise period."}]},{"id":"blk-76804","kind":"paragraph","spans":[{"id":"spn-109938","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76805","items":[{"blocks":[{"id":"blk-76807","kind":"paragraph","spans":[{"id":"spn-109939","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-76806","kind":"list-item"},{"blocks":[{"id":"blk-76809","kind":"paragraph","spans":[{"id":"spn-109940","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-76808","kind":"list-item"},{"blocks":[{"id":"blk-76811","kind":"paragraph","spans":[{"id":"spn-109941","text":"The audit trail has no "},{"id":"spn-109942","marks":["code"],"text":"action_recommended"},{"id":"spn-109943","text":" or approval records to review"}]}],"id":"blk-76810","kind":"list-item"},{"blocks":[{"id":"blk-76813","kind":"paragraph","spans":[{"id":"spn-109944","text":"Trust is assumed, not earned"}]}],"id":"blk-76812","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76814","kind":"paragraph","spans":[{"id":"spn-109945","marks":["bold"],"text":"The fix:"},{"id":"spn-109946","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-109947","marks":["code"],"text":"observe"},{"id":"spn-109948","text":", review recommendations, promote to "},{"id":"spn-109949","marks":["code"],"text":"advise"},{"id":"spn-109950","text":", review approvals, then promote to "},{"id":"spn-109951","marks":["code"],"text":"act"},{"id":"spn-109952","text":" when confidence is established."}]},{"id":"blk-76815","kind":"paragraph","spans":[{"id":"spn-109953","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-76816","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-76817","kind":"paragraph","spans":[{"id":"spn-109954","marks":["bold"],"text":"After (good):"}]},{"id":"blk-76818","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-76819","kind":"heading","level":2,"spans":[{"id":"spn-109955","text":"High-Severity Anti-Patterns"}]},{"id":"blk-76820","kind":"heading","level":3,"spans":[{"id":"spn-109956","text":"3 — Audit Blindness"}]},{"id":"blk-76821","kind":"paragraph","spans":[{"id":"spn-109957","marks":["bold"],"text":"The mistake:"},{"id":"spn-109958","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-76822","kind":"paragraph","spans":[{"id":"spn-109959","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76823","items":[{"blocks":[{"id":"blk-76825","kind":"paragraph","spans":[{"id":"spn-109960","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-76824","kind":"list-item"},{"blocks":[{"id":"blk-76827","kind":"paragraph","spans":[{"id":"spn-109961","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-76826","kind":"list-item"},{"blocks":[{"id":"blk-76829","kind":"paragraph","spans":[{"id":"spn-109962","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-76828","kind":"list-item"},{"blocks":[{"id":"blk-76831","kind":"paragraph","spans":[{"id":"spn-109963","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-76830","kind":"list-item"},{"blocks":[{"id":"blk-76833","kind":"paragraph","spans":[{"id":"spn-109964","text":"The audit system costs resources for zero value"}]}],"id":"blk-76832","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76834","kind":"paragraph","spans":[{"id":"spn-109965","marks":["bold"],"text":"The fix:"},{"id":"spn-109966","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-76835","kind":"heading","level":3,"spans":[{"id":"spn-109967","text":"4 — Island Governance"}]},{"id":"blk-76836","kind":"paragraph","spans":[{"id":"spn-109968","marks":["bold"],"text":"The mistake:"},{"id":"spn-109969","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-76837","kind":"paragraph","spans":[{"id":"spn-109970","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76838","items":[{"blocks":[{"id":"blk-76840","kind":"paragraph","spans":[{"id":"spn-109971","text":"No centralized policy management across agents"}]}],"id":"blk-76839","kind":"list-item"},{"blocks":[{"id":"blk-76842","kind":"paragraph","spans":[{"id":"spn-109972","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-76841","kind":"list-item"},{"blocks":[{"id":"blk-76844","kind":"paragraph","spans":[{"id":"spn-109973","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-76843","kind":"list-item"},{"blocks":[{"id":"blk-76846","kind":"paragraph","spans":[{"id":"spn-109974","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-76845","kind":"list-item"},{"blocks":[{"id":"blk-76848","kind":"paragraph","spans":[{"id":"spn-109975","text":"No policy versioning or rollback capability"}]}],"id":"blk-76847","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76849","kind":"paragraph","spans":[{"id":"spn-109976","marks":["bold"],"text":"The fix:"},{"id":"spn-109977","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-76850","kind":"heading","level":3,"spans":[{"id":"spn-109978","text":"5 — Shim Confusion"}]},{"id":"blk-76851","kind":"paragraph","spans":[{"id":"spn-109979","marks":["bold"],"text":"The mistake:"},{"id":"spn-109980","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-76852","kind":"paragraph","spans":[{"id":"spn-109981","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76853","items":[{"blocks":[{"id":"blk-76855","kind":"paragraph","spans":[{"id":"spn-109982","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-76854","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76856","kind":"paragraph","spans":[{"id":"spn-109983","text":"OTP process."}]},{"id":"blk-76857","items":[{"blocks":[{"id":"blk-76859","kind":"paragraph","spans":[{"id":"spn-109984","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-76858","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76860","kind":"paragraph","spans":[{"id":"spn-109985","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-76861","items":[{"blocks":[{"id":"blk-76863","kind":"paragraph","spans":[{"id":"spn-109986","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-76862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76864","kind":"paragraph","spans":[{"id":"spn-109987","marks":["bold"],"text":"The fix:"},{"id":"spn-109988","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-76865","kind":"heading","level":3,"spans":[{"id":"spn-109989","text":"6 — Unchecked Actions"}]},{"id":"blk-76866","kind":"paragraph","spans":[{"id":"spn-109990","marks":["bold"],"text":"The mistake:"},{"id":"spn-109991","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-109992","marks":["code"],"text":"permission_check"},{"id":"spn-109993","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-76867","kind":"paragraph","spans":[{"id":"spn-109994","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76868","items":[{"blocks":[{"id":"blk-76870","kind":"paragraph","spans":[{"id":"spn-109995","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-76869","kind":"list-item"},{"blocks":[{"id":"blk-76872","kind":"paragraph","spans":[{"id":"spn-109996","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-76871","kind":"list-item"},{"blocks":[{"id":"blk-76874","kind":"paragraph","spans":[{"id":"spn-109997","text":"An agent at "},{"id":"spn-109998","marks":["code"],"text":"act"},{"id":"spn-109999","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-76873","kind":"list-item"},{"blocks":[{"id":"blk-76876","kind":"paragraph","spans":[{"id":"spn-110000","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-76875","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76877","kind":"paragraph","spans":[{"id":"spn-110001","text":"resources were accessed"}]},{"id":"blk-76878","kind":"paragraph","spans":[{"id":"spn-110002","marks":["bold"],"text":"The fix:"},{"id":"spn-110003","text":" Always call "},{"id":"spn-110004","marks":["code"],"text":"permission_check"},{"id":"spn-110005","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-76879","kind":"heading","level":2,"spans":[{"id":"spn-110006","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-76880","kind":"heading","level":3,"spans":[{"id":"spn-110007","text":"7 — Telemetry Neglect"}]},{"id":"blk-76881","kind":"paragraph","spans":[{"id":"spn-110008","marks":["bold"],"text":"The mistake:"},{"id":"spn-110009","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-76882","kind":"paragraph","spans":[{"id":"spn-110010","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76883","items":[{"blocks":[{"id":"blk-76885","kind":"paragraph","spans":[{"id":"spn-110011","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-76884","kind":"list-item"},{"blocks":[{"id":"blk-76887","kind":"paragraph","spans":[{"id":"spn-110012","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-76886","kind":"list-item"},{"blocks":[{"id":"blk-76889","kind":"paragraph","spans":[{"id":"spn-110013","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-76888","kind":"list-item"},{"blocks":[{"id":"blk-76891","kind":"paragraph","spans":[{"id":"spn-110014","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-76890","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76892","kind":"paragraph","spans":[{"id":"spn-110015","marks":["bold"],"text":"The fix:"},{"id":"spn-110016","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-76893","items":[{"blocks":[{"id":"blk-76895","kind":"paragraph","spans":[{"id":"spn-110017","text":"ETS table sizes for "},{"id":"spn-110018","marks":["code"],"text":":os_permissions"},{"id":"spn-110019","text":" and "},{"id":"spn-110020","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-76894","kind":"list-item"},{"blocks":[{"id":"blk-76897","kind":"paragraph","spans":[{"id":"spn-110021","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-76896","kind":"list-item"},{"blocks":[{"id":"blk-76899","kind":"paragraph","spans":[{"id":"spn-110022","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-76898","kind":"list-item"},{"blocks":[{"id":"blk-76901","kind":"paragraph","spans":[{"id":"spn-110023","text":"Agent count under AgentSupervisor"}]}],"id":"blk-76900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76902","kind":"heading","level":3,"spans":[{"id":"spn-110024","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-76903","kind":"paragraph","spans":[{"id":"spn-110025","marks":["bold"],"text":"The mistake:"},{"id":"spn-110026","text":" Attempting to jump from "},{"id":"spn-110027","marks":["code"],"text":"installed"},{"id":"spn-110028","text":" directly to "},{"id":"spn-110029","marks":["code"],"text":"running"},{"id":"spn-110030","text":", or from "},{"id":"spn-110031","marks":["code"],"text":"running"},{"id":"spn-110032","text":" directly to "},{"id":"spn-110033","marks":["code"],"text":"removed"},{"id":"spn-110034","text":", bypassing intermediate states."}]},{"id":"blk-76904","kind":"paragraph","spans":[{"id":"spn-110035","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-76905","items":[{"blocks":[{"id":"blk-76907","kind":"paragraph","spans":[{"id":"spn-110036","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-76906","kind":"list-item"},{"blocks":[{"id":"blk-76909","kind":"paragraph","spans":[{"id":"spn-110037","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-76908","kind":"list-item"},{"blocks":[{"id":"blk-76911","kind":"paragraph","spans":[{"id":"spn-110038","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-76910","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76912","kind":"paragraph","spans":[{"id":"spn-110039","marks":["bold"],"text":"The fix:"},{"id":"spn-110040","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-110041","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-110042","text":". There are no shortcuts."}]},{"id":"blk-76913","kind":"heading","level":2,"spans":[{"id":"spn-110043","text":"Self-Audit Checklist"}]},{"id":"blk-76914","kind":"paragraph","spans":[{"id":"spn-110044","text":"Run through this periodically:"}]},{"id":"blk-76915","kind":"heading","level":3,"spans":[{"id":"spn-110045","text":"Permissions"}]},{"id":"blk-76916","items":[{"blocks":[{"id":"blk-76918","kind":"paragraph","spans":[{"id":"spn-110046","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-76917","kind":"list-item"},{"blocks":[{"id":"blk-76920","kind":"paragraph","spans":[{"id":"spn-110047","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-76919","kind":"list-item"},{"blocks":[{"id":"blk-76922","kind":"paragraph","spans":[{"id":"spn-110048","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-76921","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76923","kind":"heading","level":3,"spans":[{"id":"spn-110049","text":"Autonomy"}]},{"id":"blk-76924","items":[{"blocks":[{"id":"blk-76926","kind":"paragraph","spans":[{"id":"spn-110050","text":"[ ] Do new agents start at "},{"id":"spn-110051","marks":["code"],"text":"observe"},{"id":"spn-110052","text":"?"}]}],"id":"blk-76925","kind":"list-item"},{"blocks":[{"id":"blk-76928","kind":"paragraph","spans":[{"id":"spn-110053","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-76927","kind":"list-item"},{"blocks":[{"id":"blk-76930","kind":"paragraph","spans":[{"id":"spn-110054","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-76929","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76931","kind":"heading","level":3,"spans":[{"id":"spn-110055","text":"Audit"}]},{"id":"blk-76932","items":[{"blocks":[{"id":"blk-76934","kind":"paragraph","spans":[{"id":"spn-110056","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-76933","kind":"list-item"},{"blocks":[{"id":"blk-76936","kind":"paragraph","spans":[{"id":"spn-110057","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-76935","kind":"list-item"},{"blocks":[{"id":"blk-76938","kind":"paragraph","spans":[{"id":"spn-110058","text":"[ ] Is the audit backend appropriate for the deployment (ETS for dev, Ecto for prod)?"}]}],"id":"blk-76937","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76939","kind":"heading","level":3,"spans":[{"id":"spn-110059","text":"Integration"}]},{"id":"blk-76940","items":[{"blocks":[{"id":"blk-76942","kind":"paragraph","spans":[{"id":"spn-110060","text":"[ ] Is Delegatic connected for policy management?"}]}],"id":"blk-76941","kind":"list-item"},{"blocks":[{"id":"blk-76944","kind":"paragraph","spans":[{"id":"spn-110061","text":"[ ] Are Agentelic manifests reviewed before install?"}]}],"id":"blk-76943","kind":"list-item"},{"blocks":[{"id":"blk-76946","kind":"paragraph","spans":[{"id":"spn-110062","text":"[ ] Are marketplace agents treated as untrusted by default?"}]}],"id":"blk-76945","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76947","kind":"heading","leve