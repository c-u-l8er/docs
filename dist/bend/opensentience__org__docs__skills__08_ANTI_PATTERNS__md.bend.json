{"bendscript":"0.1","blocks":[{"id":"blk-50377","kind":"heading","level":1,"spans":[{"id":"spn-57917","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-50379","kind":"paragraph","spans":[{"id":"spn-57918","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-50378","kind":"quote"},{"id":"blk-50380","kind":"paragraph","spans":[{"id":"spn-57919","text":"---"}]},{"id":"blk-50381","kind":"heading","level":2,"spans":[{"id":"spn-57920","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-50383","spans":[{"id":"spn-57921","text":"#"}]},{"id":"blk-50384","spans":[{"id":"spn-57922","text":"Name"}]},{"id":"blk-50385","spans":[{"id":"spn-57923","text":"Severity"}]},{"id":"blk-50386","spans":[{"id":"spn-57924","text":"Description"}]}],"id":"blk-50382","kind":"table","rows":[[{"id":"blk-50387","spans":[{"id":"spn-57925","text":"1"}]},{"id":"blk-50388","spans":[{"id":"spn-57926","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-50389","spans":[{"id":"spn-57927","text":"Critical"}]},{"id":"blk-50390","spans":[{"id":"spn-57928","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-50391","spans":[{"id":"spn-57929","text":"2"}]},{"id":"blk-50392","spans":[{"id":"spn-57930","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-50393","spans":[{"id":"spn-57931","text":"Critical"}]},{"id":"blk-50394","spans":[{"id":"spn-57932","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-50395","spans":[{"id":"spn-57933","text":"3"}]},{"id":"blk-50396","spans":[{"id":"spn-57934","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-50397","spans":[{"id":"spn-57935","text":"High"}]},{"id":"blk-50398","spans":[{"id":"spn-57936","text":"Ignoring the audit trail"}]}],[{"id":"blk-50399","spans":[{"id":"spn-57937","text":"4"}]},{"id":"blk-50400","spans":[{"id":"spn-57938","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-50401","spans":[{"id":"spn-57939","text":"High"}]},{"id":"blk-50402","spans":[{"id":"spn-57940","text":"Not integrating with Delegatic"}]}],[{"id":"blk-50403","spans":[{"id":"spn-57941","text":"5"}]},{"id":"blk-50404","spans":[{"id":"spn-57942","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-50405","spans":[{"id":"spn-57943","text":"High"}]},{"id":"blk-50406","spans":[{"id":"spn-57944","text":"Treating the shim as a runtime"}]}],[{"id":"blk-50407","spans":[{"id":"spn-57945","text":"6"}]},{"id":"blk-50408","spans":[{"id":"spn-57946","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-50409","spans":[{"id":"spn-57947","text":"High"}]},{"id":"blk-50410","spans":[{"id":"spn-57948","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-50411","spans":[{"id":"spn-57949","text":"7"}]},{"id":"blk-50412","spans":[{"id":"spn-57950","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-50413","spans":[{"id":"spn-57951","text":"Medium"}]},{"id":"blk-50414","spans":[{"id":"spn-57952","text":"Not monitoring shim overhead"}]}],[{"id":"blk-50415","spans":[{"id":"spn-57953","text":"8"}]},{"id":"blk-50416","spans":[{"id":"spn-57954","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-50417","spans":[{"id":"spn-57955","text":"Medium"}]},{"id":"blk-50418","spans":[{"id":"spn-57956","text":"Skipping lifecycle states"}]}]]},{"id":"blk-50419","kind":"paragraph","spans":[{"id":"spn-57957","text":"---"}]},{"id":"blk-50420","kind":"heading","level":2,"spans":[{"id":"spn-57958","text":"Critical Anti-Patterns"}]},{"id":"blk-50421","kind":"paragraph","spans":[{"id":"spn-57959","text":"---"}]},{"id":"blk-50422","kind":"heading","level":3,"spans":[{"id":"spn-57960","text":"1 — Permission Sprawl"}]},{"id":"blk-50423","kind":"paragraph","spans":[{"id":"spn-57961","marks":["bold"],"text":"The mistake:"},{"id":"spn-57962","text":" Granting "},{"id":"spn-57963","marks":["code"],"text":"*"},{"id":"spn-57964","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-50424","kind":"paragraph","spans":[{"id":"spn-57965","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50425","items":[{"blocks":[{"id":"blk-50427","kind":"paragraph","spans":[{"id":"spn-57966","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-57967","marks":["code"],"text":"allow"}]}],"id":"blk-50426","kind":"list-item"},{"blocks":[{"id":"blk-50429","kind":"paragraph","spans":[{"id":"spn-57968","text":"The audit trail fills with meaningless "},{"id":"spn-57969","marks":["code"],"text":"ok"},{"id":"spn-57970","text":" entries"}]}],"id":"blk-50428","kind":"list-item"},{"blocks":[{"id":"blk-50431","kind":"paragraph","spans":[{"id":"spn-57971","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-50430","kind":"list-item"},{"blocks":[{"id":"blk-50433","kind":"paragraph","spans":[{"id":"spn-57972","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-50432","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50434","kind":"paragraph","spans":[{"id":"spn-57973","marks":["bold"],"text":"The fix:"},{"id":"spn-57974","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-50435","kind":"paragraph","spans":[{"id":"spn-57975","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-50436","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-50437","kind":"paragraph","spans":[{"id":"spn-57976","marks":["bold"],"text":"After (good):"}]},{"id":"blk-50438","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-50439","kind":"paragraph","spans":[{"id":"spn-57977","text":"---"}]},{"id":"blk-50440","kind":"heading","level":3,"spans":[{"id":"spn-57978","text":"2 — Trust Skipping"}]},{"id":"blk-50441","kind":"paragraph","spans":[{"id":"spn-57979","marks":["bold"],"text":"The mistake:"},{"id":"spn-57980","text":" Setting a new agent directly to "},{"id":"spn-57981","marks":["code"],"text":"act"},{"id":"spn-57982","text":" autonomy without any observation or advise period."}]},{"id":"blk-50442","kind":"paragraph","spans":[{"id":"spn-57983","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50443","items":[{"blocks":[{"id":"blk-50445","kind":"paragraph","spans":[{"id":"spn-57984","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-50444","kind":"list-item"},{"blocks":[{"id":"blk-50447","kind":"paragraph","spans":[{"id":"spn-57985","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-50446","kind":"list-item"},{"blocks":[{"id":"blk-50449","kind":"paragraph","spans":[{"id":"spn-57986","text":"The audit trail has no "},{"id":"spn-57987","marks":["code"],"text":"action_recommended"},{"id":"spn-57988","text":" or approval records to review"}]}],"id":"blk-50448","kind":"list-item"},{"blocks":[{"id":"blk-50451","kind":"paragraph","spans":[{"id":"spn-57989","text":"Trust is assumed, not earned"}]}],"id":"blk-50450","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50452","kind":"paragraph","spans":[{"id":"spn-57990","marks":["bold"],"text":"The fix:"},{"id":"spn-57991","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-57992","marks":["code"],"text":"observe"},{"id":"spn-57993","text":", review recommendations, promote to "},{"id":"spn-57994","marks":["code"],"text":"advise"},{"id":"spn-57995","text":", review approvals, then promote to "},{"id":"spn-57996","marks":["code"],"text":"act"},{"id":"spn-57997","text":" when confidence is established."}]},{"id":"blk-50453","kind":"paragraph","spans":[{"id":"spn-57998","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-50454","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-50455","kind":"paragraph","spans":[{"id":"spn-57999","marks":["bold"],"text":"After (good):"}]},{"id":"blk-50456","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-50457","kind":"paragraph","spans":[{"id":"spn-58000","text":"---"}]},{"id":"blk-50458","kind":"heading","level":2,"spans":[{"id":"spn-58001","text":"High-Severity Anti-Patterns"}]},{"id":"blk-50459","kind":"paragraph","spans":[{"id":"spn-58002","text":"---"}]},{"id":"blk-50460","kind":"heading","level":3,"spans":[{"id":"spn-58003","text":"3 — Audit Blindness"}]},{"id":"blk-50461","kind":"paragraph","spans":[{"id":"spn-58004","marks":["bold"],"text":"The mistake:"},{"id":"spn-58005","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-50462","kind":"paragraph","spans":[{"id":"spn-58006","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50463","items":[{"blocks":[{"id":"blk-50465","kind":"paragraph","spans":[{"id":"spn-58007","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-50464","kind":"list-item"},{"blocks":[{"id":"blk-50467","kind":"paragraph","spans":[{"id":"spn-58008","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-50466","kind":"list-item"},{"blocks":[{"id":"blk-50469","kind":"paragraph","spans":[{"id":"spn-58009","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-50468","kind":"list-item"},{"blocks":[{"id":"blk-50471","kind":"paragraph","spans":[{"id":"spn-58010","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-50470","kind":"list-item"},{"blocks":[{"id":"blk-50473","kind":"paragraph","spans":[{"id":"spn-58011","text":"The audit system costs resources for zero value"}]}],"id":"blk-50472","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50474","kind":"paragraph","spans":[{"id":"spn-58012","marks":["bold"],"text":"The fix:"},{"id":"spn-58013","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-50475","kind":"paragraph","spans":[{"id":"spn-58014","text":"---"}]},{"id":"blk-50476","kind":"heading","level":3,"spans":[{"id":"spn-58015","text":"4 — Island Governance"}]},{"id":"blk-50477","kind":"paragraph","spans":[{"id":"spn-58016","marks":["bold"],"text":"The mistake:"},{"id":"spn-58017","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-50478","kind":"paragraph","spans":[{"id":"spn-58018","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50479","items":[{"blocks":[{"id":"blk-50481","kind":"paragraph","spans":[{"id":"spn-58019","text":"No centralized policy management across agents"}]}],"id":"blk-50480","kind":"list-item"},{"blocks":[{"id":"blk-50483","kind":"paragraph","spans":[{"id":"spn-58020","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-50482","kind":"list-item"},{"blocks":[{"id":"blk-50485","kind":"paragraph","spans":[{"id":"spn-58021","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-50484","kind":"list-item"},{"blocks":[{"id":"blk-50487","kind":"paragraph","spans":[{"id":"spn-58022","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-50486","kind":"list-item"},{"blocks":[{"id":"blk-50489","kind":"paragraph","spans":[{"id":"spn-58023","text":"No policy versioning or rollback capability"}]}],"id":"blk-50488","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50490","kind":"paragraph","spans":[{"id":"spn-58024","marks":["bold"],"text":"The fix:"},{"id":"spn-58025","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-50491","kind":"paragraph","spans":[{"id":"spn-58026","text":"---"}]},{"id":"blk-50492","kind":"heading","level":3,"spans":[{"id":"spn-58027","text":"5 — Shim Confusion"}]},{"id":"blk-50493","kind":"paragraph","spans":[{"id":"spn-58028","marks":["bold"],"text":"The mistake:"},{"id":"spn-58029","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-50494","kind":"paragraph","spans":[{"id":"spn-58030","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50495","items":[{"blocks":[{"id":"blk-50497","kind":"paragraph","spans":[{"id":"spn-58031","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-50496","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50498","kind":"paragraph","spans":[{"id":"spn-58032","text":"OTP process."}]},{"id":"blk-50499","items":[{"blocks":[{"id":"blk-50501","kind":"paragraph","spans":[{"id":"spn-58033","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-50500","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50502","kind":"paragraph","spans":[{"id":"spn-58034","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-50503","items":[{"blocks":[{"id":"blk-50505","kind":"paragraph","spans":[{"id":"spn-58035","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-50504","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50506","kind":"paragraph","spans":[{"id":"spn-58036","marks":["bold"],"text":"The fix:"},{"id":"spn-58037","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-50507","kind":"paragraph","spans":[{"id":"spn-58038","text":"---"}]},{"id":"blk-50508","kind":"heading","level":3,"spans":[{"id":"spn-58039","text":"6 — Unchecked Actions"}]},{"id":"blk-50509","kind":"paragraph","spans":[{"id":"spn-58040","marks":["bold"],"text":"The mistake:"},{"id":"spn-58041","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-58042","marks":["code"],"text":"permission_check"},{"id":"spn-58043","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-50510","kind":"paragraph","spans":[{"id":"spn-58044","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50511","items":[{"blocks":[{"id":"blk-50513","kind":"paragraph","spans":[{"id":"spn-58045","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-50512","kind":"list-item"},{"blocks":[{"id":"blk-50515","kind":"paragraph","spans":[{"id":"spn-58046","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-50514","kind":"list-item"},{"blocks":[{"id":"blk-50517","kind":"paragraph","spans":[{"id":"spn-58047","text":"An agent at "},{"id":"spn-58048","marks":["code"],"text":"act"},{"id":"spn-58049","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-50516","kind":"list-item"},{"blocks":[{"id":"blk-50519","kind":"paragraph","spans":[{"id":"spn-58050","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-50518","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50520","kind":"paragraph","spans":[{"id":"spn-58051","text":"resources were accessed"}]},{"id":"blk-50521","kind":"paragraph","spans":[{"id":"spn-58052","marks":["bold"],"text":"The fix:"},{"id":"spn-58053","text":" Always call "},{"id":"spn-58054","marks":["code"],"text":"permission_check"},{"id":"spn-58055","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-50522","kind":"paragraph","spans":[{"id":"spn-58056","text":"---"}]},{"id":"blk-50523","kind":"heading","level":2,"spans":[{"id":"spn-58057","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-50524","kind":"paragraph","spans":[{"id":"spn-58058","text":"---"}]},{"id":"blk-50525","kind":"heading","level":3,"spans":[{"id":"spn-58059","text":"7 — Telemetry Neglect"}]},{"id":"blk-50526","kind":"paragraph","spans":[{"id":"spn-58060","marks":["bold"],"text":"The mistake:"},{"id":"spn-58061","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-50527","kind":"paragraph","spans":[{"id":"spn-58062","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50528","items":[{"blocks":[{"id":"blk-50530","kind":"paragraph","spans":[{"id":"spn-58063","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-50529","kind":"list-item"},{"blocks":[{"id":"blk-50532","kind":"paragraph","spans":[{"id":"spn-58064","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-50531","kind":"list-item"},{"blocks":[{"id":"blk-50534","kind":"paragraph","spans":[{"id":"spn-58065","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-50533","kind":"list-item"},{"blocks":[{"id":"blk-50536","kind":"paragraph","spans":[{"id":"spn-58066","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-50535","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50537","kind":"paragraph","spans":[{"id":"spn-58067","marks":["bold"],"text":"The fix:"},{"id":"spn-58068","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-50538","items":[{"blocks":[{"id":"blk-50540","kind":"paragraph","spans":[{"id":"spn-58069","text":"ETS table sizes for "},{"id":"spn-58070","marks":["code"],"text":":os_permissions"},{"id":"spn-58071","text":" and "},{"id":"spn-58072","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-50539","kind":"list-item"},{"blocks":[{"id":"blk-50542","kind":"paragraph","spans":[{"id":"spn-58073","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-50541","kind":"list-item"},{"blocks":[{"id":"blk-50544","kind":"paragraph","spans":[{"id":"spn-58074","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-50543","kind":"list-item"},{"blocks":[{"id":"blk-50546","kind":"paragraph","spans":[{"id":"spn-58075","text":"Agent count under AgentSupervisor"}]}],"id":"blk-50545","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50547","kind":"paragraph","spans":[{"id":"spn-58076","text":"---"}]},{"id":"blk-50548","kind":"heading","level":3,"spans":[{"id":"spn-58077","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-50549","kind":"paragraph","spans":[{"id":"spn-58078","marks":["bold"],"text":"The mistake:"},{"id":"spn-58079","text":" Attempting to jump from "},{"id":"spn-58080","marks":["code"],"text":"installed"},{"id":"spn-58081","text":" directly to "},{"id":"spn-58082","marks":["code"],"text":"running"},{"id":"spn-58083","text":", or from "},{"id":"spn-58084","marks":["code"],"text":"running"},{"id":"spn-58085","text":" directly to "},{"id":"spn-58086","marks":["code"],"text":"removed"},{"id":"spn-58087","text":", bypassing intermediate states."}]},{"id":"blk-50550","kind":"paragraph","spans":[{"id":"spn-58088","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50551","items":[{"blocks":[{"id":"blk-50553","kind":"paragraph","spans":[{"id":"spn-58089","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-50552","kind":"list-item"},{"blocks":[{"id":"blk-50555","kind":"paragraph","spans":[{"id":"spn-58090","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-50554","kind":"list-item"},{"blocks":[{"id":"blk-50557","kind":"paragraph","spans":[{"id":"spn-58091","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-50556","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50558","kind":"paragraph","spans":[{"id":"spn-58092","marks":["bold"],"text":"The fix:"},{"id":"spn-58093","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-58094","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-58095","text":". There are no shortcuts."}]},{"id":"blk-50559","kind":"paragraph","spans":[{"id":"spn-58096","text":"---"}]},{"id":"blk-50560","kind":"heading","level":2,"spans":[{"id":"spn-58097","text":"Self-Audit Checklist"}]},{"id":"blk-50561","kind":"paragraph","spans":[{"id":"spn-58098","text":"Run through this periodically:"}]},{"id":"blk-50562","kind":"heading","level":3,"spans":[{"id":"spn-58099","text":"Permissions"}]},{"id":"blk-50563","items":[{"blocks":[{"id":"blk-50565","kind":"paragraph","spans":[{"id":"spn-58100","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-50564","kind":"list-item"},{"blocks":[{"id":"blk-50567","kind":"paragraph","spans":[{"id":"spn-58101","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-50566","kind":"list-item"},{"blocks":[{"id":"blk-50569","kind":"paragraph","spans":[{"id":"spn-58102","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-50568","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50570","kind":"heading","level":3,"spans":[{"id":"spn-58103","text":"Autonomy"}]},{"id":"blk-50571","items":[{"blocks":[{"id":"blk-50573","kind":"paragraph","spans":[{"id":"spn-58104","text":"[ ] Do new agents start at "},{"id":"spn-58105","marks":["code"],"text":"observe"},{"id":"spn-58106","text":"?"}]}],"id":"blk-50572","kind":"list-item"},{"blocks":[{"id":"blk-50575","kind":"paragraph","spans":[{"id":"spn-58107","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-50574","kind":"list-item"},{"blocks":[{"id":"blk-50577","kind":"paragraph","spans":[{"id":"spn-58108","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-50576","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50578","kind":"heading","level":3,"spans":[{"id":"spn-58109","text":"Audit"}]},{"id":"blk-50579","items":[{"blocks":[{"id":"blk-50581","kind":"paragraph","spans":[{"id":"spn-58110","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-50580","kind":"list-item"},{"blocks":[{"id":"blk-50583","kind":"paragraph","spans":[{"id":"spn-58111","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-50582","kind":"list-item"},{"blocks":[{"id":"blk-50585","kind":"paragraph","spans":[{"id":"spn-58112","text":"[ ] Is the audit backend appropriate for