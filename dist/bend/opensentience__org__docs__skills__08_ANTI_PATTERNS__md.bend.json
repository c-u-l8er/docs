{"bendscript":"0.1","blocks":[{"id":"blk-49891","kind":"heading","level":1,"spans":[{"id":"spn-56743","text":"Skill 08 — Anti-Patterns"}]},{"blocks":[{"id":"blk-49893","kind":"paragraph","spans":[{"id":"spn-56744","text":"What NOT to do when using the OpenSentience governance shim — and how to fix it.  Every anti-pattern here comes from real failure modes: ungoverned agents, permission sprawl, false trust, missing audit evidence, and governance that exists on paper but not at runtime."}]}],"id":"blk-49892","kind":"quote"},{"id":"blk-49894","kind":"paragraph","spans":[{"id":"spn-56745","text":"---"}]},{"id":"blk-49895","kind":"heading","level":2,"spans":[{"id":"spn-56746","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-49897","spans":[{"id":"spn-56747","text":"#"}]},{"id":"blk-49898","spans":[{"id":"spn-56748","text":"Name"}]},{"id":"blk-49899","spans":[{"id":"spn-56749","text":"Severity"}]},{"id":"blk-49900","spans":[{"id":"spn-56750","text":"Description"}]}],"id":"blk-49896","kind":"table","rows":[[{"id":"blk-49901","spans":[{"id":"spn-56751","text":"1"}]},{"id":"blk-49902","spans":[{"id":"spn-56752","marks":[{"kind":"link","predicate":"cites","target":"#1--permission-sprawl"}],"text":"Permission Sprawl"}]},{"id":"blk-49903","spans":[{"id":"spn-56753","text":"Critical"}]},{"id":"blk-49904","spans":[{"id":"spn-56754","text":"Granting all permissions defeats governance"}]}],[{"id":"blk-49905","spans":[{"id":"spn-56755","text":"2"}]},{"id":"blk-49906","spans":[{"id":"spn-56756","marks":[{"kind":"link","predicate":"cites","target":"#2--trust-skipping"}],"text":"Trust Skipping"}]},{"id":"blk-49907","spans":[{"id":"spn-56757","text":"Critical"}]},{"id":"blk-49908","spans":[{"id":"spn-56758","text":"Jumping straight to Act autonomy"}]}],[{"id":"blk-49909","spans":[{"id":"spn-56759","text":"3"}]},{"id":"blk-49910","spans":[{"id":"spn-56760","marks":[{"kind":"link","predicate":"cites","target":"#3--audit-blindness"}],"text":"Audit Blindness"}]},{"id":"blk-49911","spans":[{"id":"spn-56761","text":"High"}]},{"id":"blk-49912","spans":[{"id":"spn-56762","text":"Ignoring the audit trail"}]}],[{"id":"blk-49913","spans":[{"id":"spn-56763","text":"4"}]},{"id":"blk-49914","spans":[{"id":"spn-56764","marks":[{"kind":"link","predicate":"cites","target":"#4--island-governance"}],"text":"Island Governance"}]},{"id":"blk-49915","spans":[{"id":"spn-56765","text":"High"}]},{"id":"blk-49916","spans":[{"id":"spn-56766","text":"Not integrating with Delegatic"}]}],[{"id":"blk-49917","spans":[{"id":"spn-56767","text":"5"}]},{"id":"blk-49918","spans":[{"id":"spn-56768","marks":[{"kind":"link","predicate":"cites","target":"#5--shim-confusion"}],"text":"Shim Confusion"}]},{"id":"blk-49919","spans":[{"id":"spn-56769","text":"High"}]},{"id":"blk-49920","spans":[{"id":"spn-56770","text":"Treating the shim as a runtime"}]}],[{"id":"blk-49921","spans":[{"id":"spn-56771","text":"6"}]},{"id":"blk-49922","spans":[{"id":"spn-56772","marks":[{"kind":"link","predicate":"cites","target":"#6--unchecked-actions"}],"text":"Unchecked Actions"}]},{"id":"blk-49923","spans":[{"id":"spn-56773","text":"High"}]},{"id":"blk-49924","spans":[{"id":"spn-56774","text":"Skipping permission_check before sensitive operations"}]}],[{"id":"blk-49925","spans":[{"id":"spn-56775","text":"7"}]},{"id":"blk-49926","spans":[{"id":"spn-56776","marks":[{"kind":"link","predicate":"cites","target":"#7--telemetry-neglect"}],"text":"Telemetry Neglect"}]},{"id":"blk-49927","spans":[{"id":"spn-56777","text":"Medium"}]},{"id":"blk-49928","spans":[{"id":"spn-56778","text":"Not monitoring shim overhead"}]}],[{"id":"blk-49929","spans":[{"id":"spn-56779","text":"8"}]},{"id":"blk-49930","spans":[{"id":"spn-56780","marks":[{"kind":"link","predicate":"cites","target":"#8--lifecycle-shortcuts"}],"text":"Lifecycle Shortcuts"}]},{"id":"blk-49931","spans":[{"id":"spn-56781","text":"Medium"}]},{"id":"blk-49932","spans":[{"id":"spn-56782","text":"Skipping lifecycle states"}]}]]},{"id":"blk-49933","kind":"paragraph","spans":[{"id":"spn-56783","text":"---"}]},{"id":"blk-49934","kind":"heading","level":2,"spans":[{"id":"spn-56784","text":"Critical Anti-Patterns"}]},{"id":"blk-49935","kind":"paragraph","spans":[{"id":"spn-56785","text":"---"}]},{"id":"blk-49936","kind":"heading","level":3,"spans":[{"id":"spn-56786","text":"1 — Permission Sprawl"}]},{"id":"blk-49937","kind":"paragraph","spans":[{"id":"spn-56787","marks":["bold"],"text":"The mistake:"},{"id":"spn-56788","text":" Granting "},{"id":"spn-56789","marks":["code"],"text":"*"},{"id":"spn-56790","text":" permissions across all types to avoid dealing with permission configuration."}]},{"id":"blk-49938","kind":"paragraph","spans":[{"id":"spn-56791","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49939","items":[{"blocks":[{"id":"blk-49941","kind":"paragraph","spans":[{"id":"spn-56792","text":"The governance shim becomes a no-op — every permission check returns "},{"id":"spn-56793","marks":["code"],"text":"allow"}]}],"id":"blk-49940","kind":"list-item"},{"blocks":[{"id":"blk-49943","kind":"paragraph","spans":[{"id":"spn-56794","text":"The audit trail fills with meaningless "},{"id":"spn-56795","marks":["code"],"text":"ok"},{"id":"spn-56796","text":" entries"}]}],"id":"blk-49942","kind":"list-item"},{"blocks":[{"id":"blk-49945","kind":"paragraph","spans":[{"id":"spn-56797","text":"No defense against agent scope creep or compromised agents"}]}],"id":"blk-49944","kind":"list-item"},{"blocks":[{"id":"blk-49947","kind":"paragraph","spans":[{"id":"spn-56798","text":"Compliance reviews have no evidence of access control"}]}],"id":"blk-49946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49948","kind":"paragraph","spans":[{"id":"spn-56799","marks":["bold"],"text":"The fix:"},{"id":"spn-56800","text":" Start with the minimum permissions the agent needs. Add more only when the agent encounters a denial that the operator determines is legitimate. Every grant should have a documented reason."}]},{"id":"blk-49949","kind":"paragraph","spans":[{"id":"spn-56801","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-49950","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/**\"},\n    %{type: :filesystem, access: :write, resource: \"/**\"},\n    %{type: :network, access: :outbound, resource: \"*\"},\n    %{type: :tool_invocation, access: :allowed, resource: \"*\"}\n  ]\n}"},{"id":"blk-49951","kind":"paragraph","spans":[{"id":"spn-56802","marks":["bold"],"text":"After (good):"}]},{"id":"blk-49952","kind":"code","language":"elixir","text":"permissions: %{\n  granted: [\n    %{type: :filesystem, access: :read, resource: \"/data/input/**\"},\n    %{type: :filesystem, access: :write, resource: \"/data/output/**\"},\n    %{type: :network, access: :outbound, resource: \"api.internal.net\"}\n  ],\n  denied: [\n    %{type: :filesystem, access: :write, resource: \"/data/input/**\"}\n  ]\n}"},{"id":"blk-49953","kind":"paragraph","spans":[{"id":"spn-56803","text":"---"}]},{"id":"blk-49954","kind":"heading","level":3,"spans":[{"id":"spn-56804","text":"2 — Trust Skipping"}]},{"id":"blk-49955","kind":"paragraph","spans":[{"id":"spn-56805","marks":["bold"],"text":"The mistake:"},{"id":"spn-56806","text":" Setting a new agent directly to "},{"id":"spn-56807","marks":["code"],"text":"act"},{"id":"spn-56808","text":" autonomy without any observation or advise period."}]},{"id":"blk-49956","kind":"paragraph","spans":[{"id":"spn-56809","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49957","items":[{"blocks":[{"id":"blk-49959","kind":"paragraph","spans":[{"id":"spn-56810","text":"No evidence that the agent behaves as expected"}]}],"id":"blk-49958","kind":"list-item"},{"blocks":[{"id":"blk-49961","kind":"paragraph","spans":[{"id":"spn-56811","text":"If the agent misbehaves, the first indication is a production incident"}]}],"id":"blk-49960","kind":"list-item"},{"blocks":[{"id":"blk-49963","kind":"paragraph","spans":[{"id":"spn-56812","text":"The audit trail has no "},{"id":"spn-56813","marks":["code"],"text":"action_recommended"},{"id":"spn-56814","text":" or approval records to review"}]}],"id":"blk-49962","kind":"list-item"},{"blocks":[{"id":"blk-49965","kind":"paragraph","spans":[{"id":"spn-56815","text":"Trust is assumed, not earned"}]}],"id":"blk-49964","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49966","kind":"paragraph","spans":[{"id":"spn-56816","marks":["bold"],"text":"The fix:"},{"id":"spn-56817","text":" Follow the graduated autonomy workflow. Start at "},{"id":"spn-56818","marks":["code"],"text":"observe"},{"id":"spn-56819","text":", review recommendations, promote to "},{"id":"spn-56820","marks":["code"],"text":"advise"},{"id":"spn-56821","text":", review approvals, then promote to "},{"id":"spn-56822","marks":["code"],"text":"act"},{"id":"spn-56823","text":" when confidence is established."}]},{"id":"blk-49967","kind":"paragraph","spans":[{"id":"spn-56824","marks":["bold"],"text":"Before (bad):"}]},{"id":"blk-49968","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\nautonomy_level(\"new-agent\", \"act\")  # immediately autonomous"},{"id":"blk-49969","kind":"paragraph","spans":[{"id":"spn-56825","marks":["bold"],"text":"After (good):"}]},{"id":"blk-49970","kind":"code","language":"text","text":"agent_install(manifest)\nagent_enable(\"new-agent\")\n# Default: observe\n# ... review audit trail for 1-2 sessions ...\nautonomy_level(\"new-agent\", \"advise\")\n# ... review and approve queued actions ...\nautonomy_level(\"new-agent\", \"act\")"},{"id":"blk-49971","kind":"paragraph","spans":[{"id":"spn-56826","text":"---"}]},{"id":"blk-49972","kind":"heading","level":2,"spans":[{"id":"spn-56827","text":"High-Severity Anti-Patterns"}]},{"id":"blk-49973","kind":"paragraph","spans":[{"id":"spn-56828","text":"---"}]},{"id":"blk-49974","kind":"heading","level":3,"spans":[{"id":"spn-56829","text":"3 — Audit Blindness"}]},{"id":"blk-49975","kind":"paragraph","spans":[{"id":"spn-56830","marks":["bold"],"text":"The mistake:"},{"id":"spn-56831","text":" Never querying the audit trail. The entries accumulate but nobody reads them."}]},{"id":"blk-49976","kind":"paragraph","spans":[{"id":"spn-56832","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49977","items":[{"blocks":[{"id":"blk-49979","kind":"paragraph","spans":[{"id":"spn-56833","text":"Permission denials go unnoticed (potential misconfiguration)"}]}],"id":"blk-49978","kind":"list-item"},{"blocks":[{"id":"blk-49981","kind":"paragraph","spans":[{"id":"spn-56834","text":"Blocked actions go unreviewed (the agent may need broader scope)"}]}],"id":"blk-49980","kind":"list-item"},{"blocks":[{"id":"blk-49983","kind":"paragraph","spans":[{"id":"spn-56835","text":"Autonomy changes go unmonitored (who promoted this agent?)"}]}],"id":"blk-49982","kind":"list-item"},{"blocks":[{"id":"blk-49985","kind":"paragraph","spans":[{"id":"spn-56836","text":"Compliance audits have the data but nobody has reviewed it"}]}],"id":"blk-49984","kind":"list-item"},{"blocks":[{"id":"blk-49987","kind":"paragraph","spans":[{"id":"spn-56837","text":"The audit system costs resources for zero value"}]}],"id":"blk-49986","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49988","kind":"paragraph","spans":[{"id":"spn-56838","marks":["bold"],"text":"The fix:"},{"id":"spn-56839","text":" Build audit review into your operational workflow. Query the audit trail at least at session boundaries, after autonomy changes, and during periodic compliance reviews."}]},{"id":"blk-49989","kind":"paragraph","spans":[{"id":"spn-56840","text":"---"}]},{"id":"blk-49990","kind":"heading","level":3,"spans":[{"id":"spn-56841","text":"4 — Island Governance"}]},{"id":"blk-49991","kind":"paragraph","spans":[{"id":"spn-56842","marks":["bold"],"text":"The mistake:"},{"id":"spn-56843","text":" Running OpenSentience without Delegatic, defining all permissions locally in code."}]},{"id":"blk-49992","kind":"paragraph","spans":[{"id":"spn-56844","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-49993","items":[{"blocks":[{"id":"blk-49995","kind":"paragraph","spans":[{"id":"spn-56845","text":"No centralized policy management across agents"}]}],"id":"blk-49994","kind":"list-item"},{"blocks":[{"id":"blk-49997","kind":"paragraph","spans":[{"id":"spn-56846","text":"Permission changes require code deploys instead of policy updates"}]}],"id":"blk-49996","kind":"list-item"},{"blocks":[{"id":"blk-49999","kind":"paragraph","spans":[{"id":"spn-56847","text":"Multiple governance instances cannot coordinate"}]}],"id":"blk-49998","kind":"list-item"},{"blocks":[{"id":"blk-50001","kind":"paragraph","spans":[{"id":"spn-56848","text":"Policy drift between environments (dev/staging/prod)"}]}],"id":"blk-50000","kind":"list-item"},{"blocks":[{"id":"blk-50003","kind":"paragraph","spans":[{"id":"spn-56849","text":"No policy versioning or rollback capability"}]}],"id":"blk-50002","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50004","kind":"paragraph","spans":[{"id":"spn-56850","marks":["bold"],"text":"The fix:"},{"id":"spn-56851","text":" Connect to Delegatic for policy authoring. Use local permissions only as a fallback or for development. In production, Delegatic should be the source of truth for policy, with OpenSentience enforcing it."}]},{"id":"blk-50005","kind":"paragraph","spans":[{"id":"spn-56852","text":"---"}]},{"id":"blk-50006","kind":"heading","level":3,"spans":[{"id":"spn-56853","text":"5 — Shim Confusion"}]},{"id":"blk-50007","kind":"paragraph","spans":[{"id":"spn-56854","marks":["bold"],"text":"The mistake:"},{"id":"spn-56855","text":" Treating the governance shim as a replacement for the agent runtime. Expecting OpenSentience to execute tasks, manage state, or provide business logic."}]},{"id":"blk-50008","kind":"paragraph","spans":[{"id":"spn-56856","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50009","items":[{"blocks":[{"id":"blk-50011","kind":"paragraph","spans":[{"id":"spn-56857","text":"The shim wraps, it does not replace. It adds governance around an existing"}]}],"id":"blk-50010","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50012","kind":"paragraph","spans":[{"id":"spn-56858","text":"OTP process."}]},{"id":"blk-50013","items":[{"blocks":[{"id":"blk-50015","kind":"paragraph","spans":[{"id":"spn-56859","text":"Attempting to use the shim as a runtime leads to missing functionality,"}]}],"id":"blk-50014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50016","kind":"paragraph","spans":[{"id":"spn-56860","text":"confused architecture, and misplaced responsibilities"}]},{"id":"blk-50017","items":[{"blocks":[{"id":"blk-50019","kind":"paragraph","spans":[{"id":"spn-56861","text":"The shim is intentionally thin — overhead under 1%"}]}],"id":"blk-50018","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50020","kind":"paragraph","spans":[{"id":"spn-56862","marks":["bold"],"text":"The fix:"},{"id":"spn-56863","text":" Remember the separation of concerns. The agent process handles business logic. The governance shim handles permissions, lifecycle, autonomy, and audit. They compose through OTP supervision, not inheritance."}]},{"id":"blk-50021","kind":"paragraph","spans":[{"id":"spn-56864","text":"---"}]},{"id":"blk-50022","kind":"heading","level":3,"spans":[{"id":"spn-56865","text":"6 — Unchecked Actions"}]},{"id":"blk-50023","kind":"paragraph","spans":[{"id":"spn-56866","marks":["bold"],"text":"The mistake:"},{"id":"spn-56867","text":" Having an agent perform sensitive operations without calling "},{"id":"spn-56868","marks":["code"],"text":"permission_check"},{"id":"spn-56869","text":" first, relying on the autonomy controller alone."}]},{"id":"blk-50024","kind":"paragraph","spans":[{"id":"spn-56870","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50025","items":[{"blocks":[{"id":"blk-50027","kind":"paragraph","spans":[{"id":"spn-56871","text":"Autonomy only controls whether actions need approval"}]}],"id":"blk-50026","kind":"list-item"},{"blocks":[{"id":"blk-50029","kind":"paragraph","spans":[{"id":"spn-56872","text":"Permissions control whether actions are allowed at all"}]}],"id":"blk-50028","kind":"list-item"},{"blocks":[{"id":"blk-50031","kind":"paragraph","spans":[{"id":"spn-56873","text":"An agent at "},{"id":"spn-56874","marks":["code"],"text":"act"},{"id":"spn-56875","text":" autonomy still needs permission to access a resource"}]}],"id":"blk-50030","kind":"list-item"},{"blocks":[{"id":"blk-50033","kind":"paragraph","spans":[{"id":"spn-56876","text":"Skipping permission checks means the audit trail has no record of what"}]}],"id":"blk-50032","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50034","kind":"paragraph","spans":[{"id":"spn-56877","text":"resources were accessed"}]},{"id":"blk-50035","kind":"paragraph","spans":[{"id":"spn-56878","marks":["bold"],"text":"The fix:"},{"id":"spn-56879","text":" Always call "},{"id":"spn-56880","marks":["code"],"text":"permission_check"},{"id":"spn-56881","text":" before sensitive operations, regardless of autonomy level. The permission check is the enforcement point; autonomy is the approval workflow."}]},{"id":"blk-50036","kind":"paragraph","spans":[{"id":"spn-56882","text":"---"}]},{"id":"blk-50037","kind":"heading","level":2,"spans":[{"id":"spn-56883","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-50038","kind":"paragraph","spans":[{"id":"spn-56884","text":"---"}]},{"id":"blk-50039","kind":"heading","level":3,"spans":[{"id":"spn-56885","text":"7 — Telemetry Neglect"}]},{"id":"blk-50040","kind":"paragraph","spans":[{"id":"spn-56886","marks":["bold"],"text":"The mistake:"},{"id":"spn-56887","text":" Not monitoring the governance shim's own resource usage and performance."}]},{"id":"blk-50041","kind":"paragraph","spans":[{"id":"spn-56888","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50042","items":[{"blocks":[{"id":"blk-50044","kind":"paragraph","spans":[{"id":"spn-56889","text":"Permission check latency could degrade without anyone noticing"}]}],"id":"blk-50043","kind":"list-item"},{"blocks":[{"id":"blk-50046","kind":"paragraph","spans":[{"id":"spn-56890","text":"ETS table growth could consume unexpected memory"}]}],"id":"blk-50045","kind":"list-item"},{"blocks":[{"id":"blk-50048","kind":"paragraph","spans":[{"id":"spn-56891","text":"AuditWriter batch sizes could grow unboundedly"}]}],"id":"blk-50047","kind":"list-item"},{"blocks":[{"id":"blk-50050","kind":"paragraph","spans":[{"id":"spn-56892","text":"The shim's overhead claim (< 1% CPU, < 5 MB RSS) is a target, not a guarantee"}]}],"id":"blk-50049","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50051","kind":"paragraph","spans":[{"id":"spn-56893","marks":["bold"],"text":"The fix:"},{"id":"spn-56894","text":" Include shim health in your application's telemetry:"}]},{"id":"blk-50052","items":[{"blocks":[{"id":"blk-50054","kind":"paragraph","spans":[{"id":"spn-56895","text":"ETS table sizes for "},{"id":"spn-56896","marks":["code"],"text":":os_permissions"},{"id":"spn-56897","text":" and "},{"id":"spn-56898","marks":["code"],"text":":os_autonomy"}]}],"id":"blk-50053","kind":"list-item"},{"blocks":[{"id":"blk-50056","kind":"paragraph","spans":[{"id":"spn-56899","text":"AuditWriter queue depth and flush latency"}]}],"id":"blk-50055","kind":"list-item"},{"blocks":[{"id":"blk-50058","kind":"paragraph","spans":[{"id":"spn-56900","text":"Permission check latency percentiles (p50, p99)"}]}],"id":"blk-50057","kind":"list-item"},{"blocks":[{"id":"blk-50060","kind":"paragraph","spans":[{"id":"spn-56901","text":"Agent count under AgentSupervisor"}]}],"id":"blk-50059","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50061","kind":"paragraph","spans":[{"id":"spn-56902","text":"---"}]},{"id":"blk-50062","kind":"heading","level":3,"spans":[{"id":"spn-56903","text":"8 — Lifecycle Shortcuts"}]},{"id":"blk-50063","kind":"paragraph","spans":[{"id":"spn-56904","marks":["bold"],"text":"The mistake:"},{"id":"spn-56905","text":" Attempting to jump from "},{"id":"spn-56906","marks":["code"],"text":"installed"},{"id":"spn-56907","text":" directly to "},{"id":"spn-56908","marks":["code"],"text":"running"},{"id":"spn-56909","text":", or from "},{"id":"spn-56910","marks":["code"],"text":"running"},{"id":"spn-56911","text":" directly to "},{"id":"spn-56912","marks":["code"],"text":"removed"},{"id":"spn-56913","text":", bypassing intermediate states."}]},{"id":"blk-50064","kind":"paragraph","spans":[{"id":"spn-56914","marks":["bold"],"text":"Why it is harmful:"}]},{"id":"blk-50065","items":[{"blocks":[{"id":"blk-50067","kind":"paragraph","spans":[{"id":"spn-56915","text":"The GenStateMachine will reject the transition, causing an error"}]}],"id":"blk-50066","kind":"list-item"},{"blocks":[{"id":"blk-50069","kind":"paragraph","spans":[{"id":"spn-56916","text":"The audit trail will record a failed transition attempt"}]}],"id":"blk-50068","kind":"list-item"},{"blocks":[{"id":"blk-50071","kind":"paragraph","spans":[{"id":"spn-56917","text":"Workarounds (direct state manipulation) bypass governance entirely"}]}],"id":"blk-50070","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50072","kind":"paragraph","spans":[{"id":"spn-56918","marks":["bold"],"text":"The fix:"},{"id":"spn-56919","text":" Follow the state machine. Every transition must go through valid intermediate states. If you need to remove a running agent: "},{"id":"spn-56920","marks":["code"],"text":"running -> disabled -> removed"},{"id":"spn-56921","text":". There are no shortcuts."}]},{"id":"blk-50073","kind":"paragraph","spans":[{"id":"spn-56922","text":"---"}]},{"id":"blk-50074","kind":"heading","level":2,"spans":[{"id":"spn-56923","text":"Self-Audit Checklist"}]},{"id":"blk-50075","kind":"paragraph","spans":[{"id":"spn-56924","text":"Run through this periodically:"}]},{"id":"blk-50076","kind":"heading","level":3,"spans":[{"id":"spn-56925","text":"Permissions"}]},{"id":"blk-50077","items":[{"blocks":[{"id":"blk-50079","kind":"paragraph","spans":[{"id":"spn-56926","text":"[ ] Are grants scoped to the minimum necessary resources?"}]}],"id":"blk-50078","kind":"list-item"},{"blocks":[{"id":"blk-50081","kind":"paragraph","spans":[{"id":"spn-56927","text":"[ ] Are explicit denials in place for sensitive paths?"}]}],"id":"blk-50080","kind":"list-item"},{"blocks":[{"id":"blk-50083","kind":"paragraph","spans":[{"id":"spn-56928","text":"[ ] Are permission denials in the audit trail reviewed?"}]}],"id":"blk-50082","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50084","kind":"heading","level":3,"spans":[{"id":"spn-56929","text":"Autonomy"}]},{"id":"blk-50085","items":[{"blocks":[{"id":"blk-50087","kind":"paragraph","spans":[{"id":"spn-56930","text":"[ ] Do new agents start at "},{"id":"spn-56931","marks":["code"],"text":"observe"},{"id":"spn-56932","text":"?"}]}],"id":"blk-50086","kind":"list-item"},{"blocks":[{"id":"blk-50089","kind":"paragraph","spans":[{"id":"spn-56933","text":"[ ] Are promotions documented with reasons in the audit trail?"}]}],"id":"blk-50088","kind":"list-item"},{"blocks":[{"id":"blk-50091","kind":"paragraph","spans":[{"id":"spn-56934","text":"[ ] Is demotion used when behavior degrades?"}]}],"id":"blk-50090","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50092","kind":"heading","level":3,"spans":[{"id":"spn-56935","text":"Audit"}]},{"id":"blk-50093","items":[{"blocks":[{"id":"blk-50095","kind":"paragraph","spans":[{"id":"spn-56936","text":"[ ] Is the audit trail queried regularly?"}]}],"id":"blk-50094","kind":"list-item"},{"blocks":[{"id":"blk-50097","kind":"paragraph","spans":[{"id":"spn-56937","text":"[ ] Are compliance reviews scheduled?"}]}],"id":"blk-50096","kind":"list-item"},{"blocks":[{"id":"blk-50099","kind":"paragraph","spans":[{"id":"spn-56938","text":"[ ] Is the audit backend appropriate for