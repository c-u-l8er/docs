he final canonical"},{"id":"spn-144337","text":" — the "},{"id":"spn-144338","marks":["code"],"text":"evidence_transitions"},{"id":"spn-144339","text":" / "},{"id":"spn-144340","marks":["code"],"text":"transition_kind"},{"id":"spn-144341","text":" schema, the station receipt as the root of the projection binding, and the receipt-bytes convention (a historical package's witness path points at the "},{"id":"spn-144342","marks":["italic"],"text":"current"},{"id":"spn-144343","text":" receipt; the bytes it hashed are retained under the versioned name — stated in the CHANGELOG)."}]}],"id":"blk-80126","kind":"list-item"},{"blocks":[{"id":"blk-80129","kind":"paragraph","spans":[{"id":"spn-144344","marks":["bold"],"text":"E-52"},{"id":"spn-144345","text":" minted from the executed model, and "},{"id":"spn-144346","marks":["bold"],"text":"E-53's born-red convention"},{"id":"spn-144347","text":" (a finding repaired by the lane carries pre-fix + repair witnesses but no transition until adjudicated)."}]}],"id":"blk-80128","kind":"list-item"},{"blocks":[{"id":"blk-80131","kind":"paragraph","spans":[{"id":"spn-144348","marks":["bold"],"text":"Frontier §9"},{"id":"spn-144349","text":" — is "},{"id":"spn-144350","marks":["italic"],"text":"proposal-time admission ≠ use-time currentness"},{"id":"spn-144351","text":" a dimension of the table or a corollary family? Nothing depends on the answer yet; the next finding of that shape would."}]}],"id":"blk-80130","kind":"list-item"},{"blocks":[{"id":"blk-80133","kind":"paragraph","spans":[{"id":"spn-144352","text":"The TRVM decision drafts and the Super E-52 vocabulary — for their lanes, through you."}]}],"id":"blk-80132","kind":"list-item"}],"kind":"list","ordered":true}],"edges":[],"id":"bagaaierann7yc4bsbwsbweyzceypatuvd4rfp6dq43e52wwnktywzwbsro5a","vocabulary":"ampersand.docs.fs.v1"}