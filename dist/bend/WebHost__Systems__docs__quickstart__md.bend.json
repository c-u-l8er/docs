{"bendscript":"0.1","blocks":[{"id":"blk-43651","kind":"heading","level":1,"spans":[{"id":"spn-73119","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-43653","kind":"paragraph","spans":[{"id":"spn-73120","marks":["bold"],"text":"Purpose:"},{"id":"spn-73121","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-43652","kind":"quote"},{"id":"blk-43654","kind":"heading","level":2,"spans":[{"id":"spn-73122","text":"Prerequisites"}]},{"id":"blk-43655","items":[{"blocks":[{"id":"blk-43657","kind":"paragraph","spans":[{"id":"spn-73123","text":"Node.js >= 20"}]}],"id":"blk-43656","kind":"list-item"},{"blocks":[{"id":"blk-43659","kind":"paragraph","spans":[{"id":"spn-73124","text":"npm (ships with Node)"}]}],"id":"blk-43658","kind":"list-item"},{"blocks":[{"id":"blk-43661","kind":"paragraph","spans":[{"id":"spn-73125","text":"Supabase CLI ("},{"id":"spn-73126","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-73127","text":")"}]}],"id":"blk-43660","kind":"list-item"},{"blocks":[{"id":"blk-43663","kind":"paragraph","spans":[{"id":"spn-73128","text":"A Supabase project (or local emulator)"}]}],"id":"blk-43662","kind":"list-item"},{"blocks":[{"id":"blk-43665","kind":"paragraph","spans":[{"id":"spn-73129","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-43664","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43666","kind":"heading","level":2,"spans":[{"id":"spn-73130","text":"1. Clone and Install"}]},{"id":"blk-43667","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-43668","kind":"heading","level":2,"spans":[{"id":"spn-73131","text":"2. Environment Setup"}]},{"id":"blk-43669","kind":"paragraph","spans":[{"id":"spn-73132","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-43670","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-43671","kind":"paragraph","spans":[{"id":"spn-73133","text":"Required variables:"}]},{"head":[{"id":"blk-43673","spans":[{"id":"spn-73134","text":"Variable"}]},{"id":"blk-43674","spans":[{"id":"spn-73135","text":"Description"}]}],"id":"blk-43672","kind":"table","rows":[[{"id":"blk-43675","spans":[{"id":"spn-73136","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-43676","spans":[{"id":"spn-73137","text":"Your Supabase project URL"}]}],[{"id":"blk-43677","spans":[{"id":"spn-73138","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-43678","spans":[{"id":"spn-73139","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-43679","spans":[{"id":"spn-73140","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-43680","spans":[{"id":"spn-73141","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-43681","spans":[{"id":"spn-73142","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-43682","spans":[{"id":"spn-73143","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-43683","spans":[{"id":"spn-73144","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-43684","spans":[{"id":"spn-73145","text":"Cloudflare account ID"}]}],[{"id":"blk-43685","spans":[{"id":"spn-73146","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-43686","spans":[{"id":"spn-73147","text":"Billing webhook verification"}]}]]},{"id":"blk-43687","kind":"heading","level":2,"spans":[{"id":"spn-73148","text":"3. Start Development Servers"}]},{"id":"blk-43688","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-43689","kind":"heading","level":2,"spans":[{"id":"spn-73149","text":"4. Create Your First Agent"}]},{"id":"blk-43690","kind":"heading","level":3,"spans":[{"id":"spn-73150","text":"Via the dashboard"}]},{"id":"blk-43691","items":[{"blocks":[{"id":"blk-43693","kind":"paragraph","spans":[{"id":"spn-73151","text":"Navigate to "},{"id":"spn-73152","marks":["code"],"text":"http://localhost:5173"}]}],"id":"blk-43692","kind":"list-item"},{"blocks":[{"id":"blk-43695","kind":"paragraph","spans":[{"id":"spn-73153","text":"Sign in (Supabase Auth: email or OAuth)"}]}],"id":"blk-43694","kind":"list-item"},{"blocks":[{"id":"blk-43697","kind":"paragraph","spans":[{"id":"spn-73154","text":"Click \"New Agent\""}]}],"id":"blk-43696","kind":"list-item"},{"blocks":[{"id":"blk-43699","kind":"paragraph","spans":[{"id":"spn-73155","text":"Fill in name, framework, and select "},{"id":"spn-73156","marks":["code"],"text":"cloudflare"},{"id":"spn-73157","text":" runtime"}]}],"id":"blk-43698","kind":"list-item"},{"blocks":[{"id":"blk-43701","kind":"paragraph","spans":[{"id":"spn-73158","text":"Upload a bundle containing "},{"id":"spn-73159","marks":["code"],"text":"agent.config.json"},{"id":"spn-73160","text":" and your entrypoint"}]}],"id":"blk-43700","kind":"list-item"},{"blocks":[{"id":"blk-43703","kind":"paragraph","spans":[{"id":"spn-73161","text":"Click \"Deploy\""}]}],"id":"blk-43702","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43704","kind":"heading","level":3,"spans":[{"id":"spn-73162","text":"Via the API"}]},{"id":"blk-43705","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-43706","kind":"heading","level":2,"spans":[{"id":"spn-73163","text":"5. Invoke Your Agent"}]},{"id":"blk-43707","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-43708","kind":"heading","level":2,"spans":[{"id":"spn-73164","text":"6. View Metrics"}]},{"id":"blk-43709","kind":"paragraph","spans":[{"id":"spn-73165","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-43710","items":[{"blocks":[{"id":"blk-43712","kind":"paragraph","spans":[{"id":"spn-73166","text":"Request count"}]}],"id":"blk-43711","kind":"list-item"},{"blocks":[{"id":"blk-43714","kind":"paragraph","spans":[{"id":"spn-73167","text":"Token usage"}]}],"id":"blk-43713","kind":"list-item"},{"blocks":[{"id":"blk-43716","kind":"paragraph","spans":[{"id":"spn-73168","text":"Compute time (ms)"}]}],"id":"blk-43715","kind":"list-item"},{"blocks":[{"id":"blk-43718","kind":"paragraph","spans":[{"id":"spn-73169","text":"Error rate"}]}],"id":"blk-43717","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43719","kind":"heading","level":2,"spans":[{"id":"spn-73170","text":"Next Steps"}]},{"id":"blk-43720","items":[{"blocks":[{"id":"blk-43722","kind":"paragraph","spans":[{"id":"spn-73171","text":"Read the "},{"id":"spn-73172","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-73173","text":" for system design context"}]}],"id":"blk-43721","kind":"list-item"},{"blocks":[{"id":"blk-43724","kind":"paragraph","spans":[{"id":"spn-73174","text":"See "},{"id":"spn-73175","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-73176","text":" for operational guides"}]}],"id":"blk-43723","kind":"list-item"},{"blocks":[{"id":"blk-43726","kind":"paragraph","spans":[{"id":"spn-73177","text":"Review the "},{"id":"spn-73178","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-73179","text":" for full requirements"}]}],"id":"blk-43725","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43727","kind":"heading","level":2,"spans":[{"id":"spn-73180","text":"Verify Your Setup"}]},{"id":"blk-43728","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-43729","kind":"paragraph","spans":[{"id":"spn-73181","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaieraupuiq6xut3fmqfanvk7bjvv6l2gtxxvfsm3tear6zywsnkvtxuja","vocabulary":"ampersand.docs.fs.v1"}