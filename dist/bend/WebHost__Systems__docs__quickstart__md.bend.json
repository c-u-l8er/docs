{"bendscript":"0.1","blocks":[{"id":"blk-24902","kind":"heading","level":1,"spans":[{"id":"spn-30187","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-24904","kind":"paragraph","spans":[{"id":"spn-30188","marks":["bold"],"text":"Purpose:"},{"id":"spn-30189","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-24903","kind":"quote"},{"id":"blk-24905","kind":"paragraph","spans":[{"id":"spn-30190","text":"---"}]},{"id":"blk-24906","kind":"heading","level":2,"spans":[{"id":"spn-30191","text":"Prerequisites"}]},{"id":"blk-24907","items":[{"blocks":[{"id":"blk-24909","kind":"paragraph","spans":[{"id":"spn-30192","text":"Node.js >= 20"}]}],"id":"blk-24908","kind":"list-item"},{"blocks":[{"id":"blk-24911","kind":"paragraph","spans":[{"id":"spn-30193","text":"npm (ships with Node)"}]}],"id":"blk-24910","kind":"list-item"},{"blocks":[{"id":"blk-24913","kind":"paragraph","spans":[{"id":"spn-30194","text":"Supabase CLI ("},{"id":"spn-30195","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-30196","text":")"}]}],"id":"blk-24912","kind":"list-item"},{"blocks":[{"id":"blk-24915","kind":"paragraph","spans":[{"id":"spn-30197","text":"A Supabase project (or local emulator)"}]}],"id":"blk-24914","kind":"list-item"},{"blocks":[{"id":"blk-24917","kind":"paragraph","spans":[{"id":"spn-30198","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-24916","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24918","kind":"paragraph","spans":[{"id":"spn-30199","text":"---"}]},{"id":"blk-24919","kind":"heading","level":2,"spans":[{"id":"spn-30200","text":"1. Clone and Install"}]},{"id":"blk-24920","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-24921","kind":"paragraph","spans":[{"id":"spn-30201","text":"---"}]},{"id":"blk-24922","kind":"heading","level":2,"spans":[{"id":"spn-30202","text":"2. Environment Setup"}]},{"id":"blk-24923","kind":"paragraph","spans":[{"id":"spn-30203","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-24924","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-24925","kind":"paragraph","spans":[{"id":"spn-30204","text":"Required variables:"}]},{"head":[{"id":"blk-24927","spans":[{"id":"spn-30205","text":"Variable"}]},{"id":"blk-24928","spans":[{"id":"spn-30206","text":"Description"}]}],"id":"blk-24926","kind":"table","rows":[[{"id":"blk-24929","spans":[{"id":"spn-30207","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-24930","spans":[{"id":"spn-30208","text":"Your Supabase project URL"}]}],[{"id":"blk-24931","spans":[{"id":"spn-30209","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-24932","spans":[{"id":"spn-30210","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-24933","spans":[{"id":"spn-30211","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-24934","spans":[{"id":"spn-30212","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-24935","spans":[{"id":"spn-30213","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-24936","spans":[{"id":"spn-30214","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-24937","spans":[{"id":"spn-30215","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-24938","spans":[{"id":"spn-30216","text":"Cloudflare account ID"}]}],[{"id":"blk-24939","spans":[{"id":"spn-30217","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-24940","spans":[{"id":"spn-30218","text":"Billing webhook verification"}]}]]},{"id":"blk-24941","kind":"paragraph","spans":[{"id":"spn-30219","text":"---"}]},{"id":"blk-24942","kind":"heading","level":2,"spans":[{"id":"spn-30220","text":"3. Start Development Servers"}]},{"id":"blk-24943","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-24944","kind":"paragraph","spans":[{"id":"spn-30221","text":"---"}]},{"id":"blk-24945","kind":"heading","level":2,"spans":[{"id":"spn-30222","text":"4. Create Your First Agent"}]},{"id":"blk-24946","kind":"heading","level":3,"spans":[{"id":"spn-30223","text":"Via the dashboard"}]},{"id":"blk-24947","kind":"paragraph","spans":[{"id":"spn-30224","text":"1. Navigate to "},{"id":"spn-30225","marks":["code"],"text":"http://localhost:5173"},{"id":"spn-30226","text":" 2. Sign in (Supabase Auth: email or OAuth) 3. Click \"New Agent\" 4. Fill in name, framework, and select "},{"id":"spn-30227","marks":["code"],"text":"cloudflare"},{"id":"spn-30228","text":" runtime 5. Upload a bundle containing "},{"id":"spn-30229","marks":["code"],"text":"agent.config.json"},{"id":"spn-30230","text":" and your entrypoint 6. Click \"Deploy\""}]},{"id":"blk-24948","kind":"heading","level":3,"spans":[{"id":"spn-30231","text":"Via the API"}]},{"id":"blk-24949","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-24950","kind":"paragraph","spans":[{"id":"spn-30232","text":"---"}]},{"id":"blk-24951","kind":"heading","level":2,"spans":[{"id":"spn-30233","text":"5. Invoke Your Agent"}]},{"id":"blk-24952","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-24953","kind":"paragraph","spans":[{"id":"spn-30234","text":"---"}]},{"id":"blk-24954","kind":"heading","level":2,"spans":[{"id":"spn-30235","text":"6. View Metrics"}]},{"id":"blk-24955","kind":"paragraph","spans":[{"id":"spn-30236","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-24956","items":[{"blocks":[{"id":"blk-24958","kind":"paragraph","spans":[{"id":"spn-30237","text":"Request count"}]}],"id":"blk-24957","kind":"list-item"},{"blocks":[{"id":"blk-24960","kind":"paragraph","spans":[{"id":"spn-30238","text":"Token usage"}]}],"id":"blk-24959","kind":"list-item"},{"blocks":[{"id":"blk-24962","kind":"paragraph","spans":[{"id":"spn-30239","text":"Compute time (ms)"}]}],"id":"blk-24961","kind":"list-item"},{"blocks":[{"id":"blk-24964","kind":"paragraph","spans":[{"id":"spn-30240","text":"Error rate"}]}],"id":"blk-24963","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24965","kind":"paragraph","spans":[{"id":"spn-30241","text":"---"}]},{"id":"blk-24966","kind":"heading","level":2,"spans":[{"id":"spn-30242","text":"Next Steps"}]},{"id":"blk-24967","items":[{"blocks":[{"id":"blk-24969","kind":"paragraph","spans":[{"id":"spn-30243","text":"Read the "},{"id":"spn-30244","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-30245","text":" for system design context"}]}],"id":"blk-24968","kind":"list-item"},{"blocks":[{"id":"blk-24971","kind":"paragraph","spans":[{"id":"spn-30246","text":"See "},{"id":"spn-30247","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-30248","text":" for operational guides"}]}],"id":"blk-24970","kind":"list-item"},{"blocks":[{"id":"blk-24973","kind":"paragraph","spans":[{"id":"spn-30249","text":"Review the "},{"id":"spn-30250","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-30251","text":" for full requirements"}]}],"id":"blk-24972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24974","kind":"paragraph","spans":[{"id":"spn-30252","text":"---"}]},{"id":"blk-24975","kind":"heading","level":2,"spans":[{"id":"spn-30253","text":"Verify Your Setup"}]},{"id":"blk-24976","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-24977","kind":"paragraph","spans":[{"id":"spn-30254","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaieraxkbjn3wzmmgsvtoqu2poc2asycixpbsrsuicyc4327ro6jicbgma","vocabulary":"ampersand.docs.fs.v1"}