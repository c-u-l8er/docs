{"bendscript":"0.1","blocks":[{"id":"blk-42935","kind":"heading","level":1,"spans":[{"id":"spn-70729","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-42937","kind":"paragraph","spans":[{"id":"spn-70730","marks":["bold"],"text":"Purpose:"},{"id":"spn-70731","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-42936","kind":"quote"},{"id":"blk-42938","kind":"heading","level":2,"spans":[{"id":"spn-70732","text":"Prerequisites"}]},{"id":"blk-42939","items":[{"blocks":[{"id":"blk-42941","kind":"paragraph","spans":[{"id":"spn-70733","text":"Node.js >= 20"}]}],"id":"blk-42940","kind":"list-item"},{"blocks":[{"id":"blk-42943","kind":"paragraph","spans":[{"id":"spn-70734","text":"npm (ships with Node)"}]}],"id":"blk-42942","kind":"list-item"},{"blocks":[{"id":"blk-42945","kind":"paragraph","spans":[{"id":"spn-70735","text":"Supabase CLI ("},{"id":"spn-70736","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-70737","text":")"}]}],"id":"blk-42944","kind":"list-item"},{"blocks":[{"id":"blk-42947","kind":"paragraph","spans":[{"id":"spn-70738","text":"A Supabase project (or local emulator)"}]}],"id":"blk-42946","kind":"list-item"},{"blocks":[{"id":"blk-42949","kind":"paragraph","spans":[{"id":"spn-70739","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-42948","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42950","kind":"heading","level":2,"spans":[{"id":"spn-70740","text":"1. Clone and Install"}]},{"id":"blk-42951","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-42952","kind":"heading","level":2,"spans":[{"id":"spn-70741","text":"2. Environment Setup"}]},{"id":"blk-42953","kind":"paragraph","spans":[{"id":"spn-70742","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-42954","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-42955","kind":"paragraph","spans":[{"id":"spn-70743","text":"Required variables:"}]},{"head":[{"id":"blk-42957","spans":[{"id":"spn-70744","text":"Variable"}]},{"id":"blk-42958","spans":[{"id":"spn-70745","text":"Description"}]}],"id":"blk-42956","kind":"table","rows":[[{"id":"blk-42959","spans":[{"id":"spn-70746","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-42960","spans":[{"id":"spn-70747","text":"Your Supabase project URL"}]}],[{"id":"blk-42961","spans":[{"id":"spn-70748","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-42962","spans":[{"id":"spn-70749","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-42963","spans":[{"id":"spn-70750","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-42964","spans":[{"id":"spn-70751","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-42965","spans":[{"id":"spn-70752","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-42966","spans":[{"id":"spn-70753","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-42967","spans":[{"id":"spn-70754","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-42968","spans":[{"id":"spn-70755","text":"Cloudflare account ID"}]}],[{"id":"blk-42969","spans":[{"id":"spn-70756","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-42970","spans":[{"id":"spn-70757","text":"Billing webhook verification"}]}]]},{"id":"blk-42971","kind":"heading","level":2,"spans":[{"id":"spn-70758","text":"3. Start Development Servers"}]},{"id":"blk-42972","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-42973","kind":"heading","level":2,"spans":[{"id":"spn-70759","text":"4. Create Your First Agent"}]},{"id":"blk-42974","kind":"heading","level":3,"spans":[{"id":"spn-70760","text":"Via the dashboard"}]},{"id":"blk-42975","items":[{"blocks":[{"id":"blk-42977","kind":"paragraph","spans":[{"id":"spn-70761","text":"Navigate to "},{"id":"spn-70762","marks":["code"],"text":"http://localhost:5173"}]}],"id":"blk-42976","kind":"list-item"},{"blocks":[{"id":"blk-42979","kind":"paragraph","spans":[{"id":"spn-70763","text":"Sign in (Supabase Auth: email or OAuth)"}]}],"id":"blk-42978","kind":"list-item"},{"blocks":[{"id":"blk-42981","kind":"paragraph","spans":[{"id":"spn-70764","text":"Click \"New Agent\""}]}],"id":"blk-42980","kind":"list-item"},{"blocks":[{"id":"blk-42983","kind":"paragraph","spans":[{"id":"spn-70765","text":"Fill in name, framework, and select "},{"id":"spn-70766","marks":["code"],"text":"cloudflare"},{"id":"spn-70767","text":" runtime"}]}],"id":"blk-42982","kind":"list-item"},{"blocks":[{"id":"blk-42985","kind":"paragraph","spans":[{"id":"spn-70768","text":"Upload a bundle containing "},{"id":"spn-70769","marks":["code"],"text":"agent.config.json"},{"id":"spn-70770","text":" and your entrypoint"}]}],"id":"blk-42984","kind":"list-item"},{"blocks":[{"id":"blk-42987","kind":"paragraph","spans":[{"id":"spn-70771","text":"Click \"Deploy\""}]}],"id":"blk-42986","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-42988","kind":"heading","level":3,"spans":[{"id":"spn-70772","text":"Via the API"}]},{"id":"blk-42989","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-42990","kind":"heading","level":2,"spans":[{"id":"spn-70773","text":"5. Invoke Your Agent"}]},{"id":"blk-42991","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-42992","kind":"heading","level":2,"spans":[{"id":"spn-70774","text":"6. View Metrics"}]},{"id":"blk-42993","kind":"paragraph","spans":[{"id":"spn-70775","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-42994","items":[{"blocks":[{"id":"blk-42996","kind":"paragraph","spans":[{"id":"spn-70776","text":"Request count"}]}],"id":"blk-42995","kind":"list-item"},{"blocks":[{"id":"blk-42998","kind":"paragraph","spans":[{"id":"spn-70777","text":"Token usage"}]}],"id":"blk-42997","kind":"list-item"},{"blocks":[{"id":"blk-43000","kind":"paragraph","spans":[{"id":"spn-70778","text":"Compute time (ms)"}]}],"id":"blk-42999","kind":"list-item"},{"blocks":[{"id":"blk-43002","kind":"paragraph","spans":[{"id":"spn-70779","text":"Error rate"}]}],"id":"blk-43001","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43003","kind":"heading","level":2,"spans":[{"id":"spn-70780","text":"Next Steps"}]},{"id":"blk-43004","items":[{"blocks":[{"id":"blk-43006","kind":"paragraph","spans":[{"id":"spn-70781","text":"Read the "},{"id":"spn-70782","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-70783","text":" for system design context"}]}],"id":"blk-43005","kind":"list-item"},{"blocks":[{"id":"blk-43008","kind":"paragraph","spans":[{"id":"spn-70784","text":"See "},{"id":"spn-70785","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-70786","text":" for operational guides"}]}],"id":"blk-43007","kind":"list-item"},{"blocks":[{"id":"blk-43010","kind":"paragraph","spans":[{"id":"spn-70787","text":"Review the "},{"id":"spn-70788","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-70789","text":" for full requirements"}]}],"id":"blk-43009","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43011","kind":"heading","level":2,"spans":[{"id":"spn-70790","text":"Verify Your Setup"}]},{"id":"blk-43012","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-43013","kind":"paragraph","spans":[{"id":"spn-70791","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaierautbdnql2mxjdoh4x5tk3pq4uvqil2dctedih2xrk5dd3pnaqf5za","vocabulary":"ampersand.docs.fs.v1"}