{"bendscript":"0.1","blocks":[{"id":"blk-24416","kind":"heading","level":1,"spans":[{"id":"spn-29071","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-24418","kind":"paragraph","spans":[{"id":"spn-29072","marks":["bold"],"text":"Purpose:"},{"id":"spn-29073","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-24417","kind":"quote"},{"id":"blk-24419","kind":"paragraph","spans":[{"id":"spn-29074","text":"---"}]},{"id":"blk-24420","kind":"heading","level":2,"spans":[{"id":"spn-29075","text":"Prerequisites"}]},{"id":"blk-24421","items":[{"blocks":[{"id":"blk-24423","kind":"paragraph","spans":[{"id":"spn-29076","text":"Node.js >= 20"}]}],"id":"blk-24422","kind":"list-item"},{"blocks":[{"id":"blk-24425","kind":"paragraph","spans":[{"id":"spn-29077","text":"npm (ships with Node)"}]}],"id":"blk-24424","kind":"list-item"},{"blocks":[{"id":"blk-24427","kind":"paragraph","spans":[{"id":"spn-29078","text":"Supabase CLI ("},{"id":"spn-29079","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-29080","text":")"}]}],"id":"blk-24426","kind":"list-item"},{"blocks":[{"id":"blk-24429","kind":"paragraph","spans":[{"id":"spn-29081","text":"A Supabase project (or local emulator)"}]}],"id":"blk-24428","kind":"list-item"},{"blocks":[{"id":"blk-24431","kind":"paragraph","spans":[{"id":"spn-29082","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-24430","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24432","kind":"paragraph","spans":[{"id":"spn-29083","text":"---"}]},{"id":"blk-24433","kind":"heading","level":2,"spans":[{"id":"spn-29084","text":"1. Clone and Install"}]},{"id":"blk-24434","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-24435","kind":"paragraph","spans":[{"id":"spn-29085","text":"---"}]},{"id":"blk-24436","kind":"heading","level":2,"spans":[{"id":"spn-29086","text":"2. Environment Setup"}]},{"id":"blk-24437","kind":"paragraph","spans":[{"id":"spn-29087","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-24438","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-24439","kind":"paragraph","spans":[{"id":"spn-29088","text":"Required variables:"}]},{"head":[{"id":"blk-24441","spans":[{"id":"spn-29089","text":"Variable"}]},{"id":"blk-24442","spans":[{"id":"spn-29090","text":"Description"}]}],"id":"blk-24440","kind":"table","rows":[[{"id":"blk-24443","spans":[{"id":"spn-29091","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-24444","spans":[{"id":"spn-29092","text":"Your Supabase project URL"}]}],[{"id":"blk-24445","spans":[{"id":"spn-29093","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-24446","spans":[{"id":"spn-29094","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-24447","spans":[{"id":"spn-29095","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-24448","spans":[{"id":"spn-29096","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-24449","spans":[{"id":"spn-29097","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-24450","spans":[{"id":"spn-29098","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-24451","spans":[{"id":"spn-29099","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-24452","spans":[{"id":"spn-29100","text":"Cloudflare account ID"}]}],[{"id":"blk-24453","spans":[{"id":"spn-29101","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-24454","spans":[{"id":"spn-29102","text":"Billing webhook verification"}]}]]},{"id":"blk-24455","kind":"paragraph","spans":[{"id":"spn-29103","text":"---"}]},{"id":"blk-24456","kind":"heading","level":2,"spans":[{"id":"spn-29104","text":"3. Start Development Servers"}]},{"id":"blk-24457","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-24458","kind":"paragraph","spans":[{"id":"spn-29105","text":"---"}]},{"id":"blk-24459","kind":"heading","level":2,"spans":[{"id":"spn-29106","text":"4. Create Your First Agent"}]},{"id":"blk-24460","kind":"heading","level":3,"spans":[{"id":"spn-29107","text":"Via the dashboard"}]},{"id":"blk-24461","kind":"paragraph","spans":[{"id":"spn-29108","text":"1. Navigate to "},{"id":"spn-29109","marks":["code"],"text":"http://localhost:5173"},{"id":"spn-29110","text":" 2. Sign in (Supabase Auth: email or OAuth) 3. Click \"New Agent\" 4. Fill in name, framework, and select "},{"id":"spn-29111","marks":["code"],"text":"cloudflare"},{"id":"spn-29112","text":" runtime 5. Upload a bundle containing "},{"id":"spn-29113","marks":["code"],"text":"agent.config.json"},{"id":"spn-29114","text":" and your entrypoint 6. Click \"Deploy\""}]},{"id":"blk-24462","kind":"heading","level":3,"spans":[{"id":"spn-29115","text":"Via the API"}]},{"id":"blk-24463","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-24464","kind":"paragraph","spans":[{"id":"spn-29116","text":"---"}]},{"id":"blk-24465","kind":"heading","level":2,"spans":[{"id":"spn-29117","text":"5. Invoke Your Agent"}]},{"id":"blk-24466","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-24467","kind":"paragraph","spans":[{"id":"spn-29118","text":"---"}]},{"id":"blk-24468","kind":"heading","level":2,"spans":[{"id":"spn-29119","text":"6. View Metrics"}]},{"id":"blk-24469","kind":"paragraph","spans":[{"id":"spn-29120","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-24470","items":[{"blocks":[{"id":"blk-24472","kind":"paragraph","spans":[{"id":"spn-29121","text":"Request count"}]}],"id":"blk-24471","kind":"list-item"},{"blocks":[{"id":"blk-24474","kind":"paragraph","spans":[{"id":"spn-29122","text":"Token usage"}]}],"id":"blk-24473","kind":"list-item"},{"blocks":[{"id":"blk-24476","kind":"paragraph","spans":[{"id":"spn-29123","text":"Compute time (ms)"}]}],"id":"blk-24475","kind":"list-item"},{"blocks":[{"id":"blk-24478","kind":"paragraph","spans":[{"id":"spn-29124","text":"Error rate"}]}],"id":"blk-24477","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24479","kind":"paragraph","spans":[{"id":"spn-29125","text":"---"}]},{"id":"blk-24480","kind":"heading","level":2,"spans":[{"id":"spn-29126","text":"Next Steps"}]},{"id":"blk-24481","items":[{"blocks":[{"id":"blk-24483","kind":"paragraph","spans":[{"id":"spn-29127","text":"Read the "},{"id":"spn-29128","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-29129","text":" for system design context"}]}],"id":"blk-24482","kind":"list-item"},{"blocks":[{"id":"blk-24485","kind":"paragraph","spans":[{"id":"spn-29130","text":"See "},{"id":"spn-29131","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-29132","text":" for operational guides"}]}],"id":"blk-24484","kind":"list-item"},{"blocks":[{"id":"blk-24487","kind":"paragraph","spans":[{"id":"spn-29133","text":"Review the "},{"id":"spn-29134","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-29135","text":" for full requirements"}]}],"id":"blk-24486","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24488","kind":"paragraph","spans":[{"id":"spn-29136","text":"---"}]},{"id":"blk-24489","kind":"heading","level":2,"spans":[{"id":"spn-29137","text":"Verify Your Setup"}]},{"id":"blk-24490","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-24491","kind":"paragraph","spans":[{"id":"spn-29138","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaierae7nr5c4pdzz6vzqpkvawcrlv3shizlhsd4jujy7wobmompsyt3ea","vocabulary":"ampersand.docs.fs.v1"}