{"bendscript":"0.1","blocks":[{"id":"blk-23931","kind":"heading","level":1,"spans":[{"id":"spn-27898","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-23933","kind":"paragraph","spans":[{"id":"spn-27899","marks":["bold"],"text":"Purpose:"},{"id":"spn-27900","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-23932","kind":"quote"},{"id":"blk-23934","kind":"paragraph","spans":[{"id":"spn-27901","text":"---"}]},{"id":"blk-23935","kind":"heading","level":2,"spans":[{"id":"spn-27902","text":"Prerequisites"}]},{"id":"blk-23936","items":[{"blocks":[{"id":"blk-23938","kind":"paragraph","spans":[{"id":"spn-27903","text":"Node.js >= 20"}]}],"id":"blk-23937","kind":"list-item"},{"blocks":[{"id":"blk-23940","kind":"paragraph","spans":[{"id":"spn-27904","text":"npm (ships with Node)"}]}],"id":"blk-23939","kind":"list-item"},{"blocks":[{"id":"blk-23942","kind":"paragraph","spans":[{"id":"spn-27905","text":"Supabase CLI ("},{"id":"spn-27906","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-27907","text":")"}]}],"id":"blk-23941","kind":"list-item"},{"blocks":[{"id":"blk-23944","kind":"paragraph","spans":[{"id":"spn-27908","text":"A Supabase project (or local emulator)"}]}],"id":"blk-23943","kind":"list-item"},{"blocks":[{"id":"blk-23946","kind":"paragraph","spans":[{"id":"spn-27909","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-23945","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23947","kind":"paragraph","spans":[{"id":"spn-27910","text":"---"}]},{"id":"blk-23948","kind":"heading","level":2,"spans":[{"id":"spn-27911","text":"1. Clone and Install"}]},{"id":"blk-23949","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-23950","kind":"paragraph","spans":[{"id":"spn-27912","text":"---"}]},{"id":"blk-23951","kind":"heading","level":2,"spans":[{"id":"spn-27913","text":"2. Environment Setup"}]},{"id":"blk-23952","kind":"paragraph","spans":[{"id":"spn-27914","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-23953","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-23954","kind":"paragraph","spans":[{"id":"spn-27915","text":"Required variables:"}]},{"head":[{"id":"blk-23956","spans":[{"id":"spn-27916","text":"Variable"}]},{"id":"blk-23957","spans":[{"id":"spn-27917","text":"Description"}]}],"id":"blk-23955","kind":"table","rows":[[{"id":"blk-23958","spans":[{"id":"spn-27918","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-23959","spans":[{"id":"spn-27919","text":"Your Supabase project URL"}]}],[{"id":"blk-23960","spans":[{"id":"spn-27920","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-23961","spans":[{"id":"spn-27921","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-23962","spans":[{"id":"spn-27922","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-23963","spans":[{"id":"spn-27923","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-23964","spans":[{"id":"spn-27924","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-23965","spans":[{"id":"spn-27925","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-23966","spans":[{"id":"spn-27926","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-23967","spans":[{"id":"spn-27927","text":"Cloudflare account ID"}]}],[{"id":"blk-23968","spans":[{"id":"spn-27928","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-23969","spans":[{"id":"spn-27929","text":"Billing webhook verification"}]}]]},{"id":"blk-23970","kind":"paragraph","spans":[{"id":"spn-27930","text":"---"}]},{"id":"blk-23971","kind":"heading","level":2,"spans":[{"id":"spn-27931","text":"3. Start Development Servers"}]},{"id":"blk-23972","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-23973","kind":"paragraph","spans":[{"id":"spn-27932","text":"---"}]},{"id":"blk-23974","kind":"heading","level":2,"spans":[{"id":"spn-27933","text":"4. Create Your First Agent"}]},{"id":"blk-23975","kind":"heading","level":3,"spans":[{"id":"spn-27934","text":"Via the dashboard"}]},{"id":"blk-23976","kind":"paragraph","spans":[{"id":"spn-27935","text":"1. Navigate to "},{"id":"spn-27936","marks":["code"],"text":"http://localhost:5173"},{"id":"spn-27937","text":" 2. Sign in (Supabase Auth: email or OAuth) 3. Click \"New Agent\" 4. Fill in name, framework, and select "},{"id":"spn-27938","marks":["code"],"text":"cloudflare"},{"id":"spn-27939","text":" runtime 5. Upload a bundle containing "},{"id":"spn-27940","marks":["code"],"text":"agent.config.json"},{"id":"spn-27941","text":" and your entrypoint 6. Click \"Deploy\""}]},{"id":"blk-23977","kind":"heading","level":3,"spans":[{"id":"spn-27942","text":"Via the API"}]},{"id":"blk-23978","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-23979","kind":"paragraph","spans":[{"id":"spn-27943","text":"---"}]},{"id":"blk-23980","kind":"heading","level":2,"spans":[{"id":"spn-27944","text":"5. Invoke Your Agent"}]},{"id":"blk-23981","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-23982","kind":"paragraph","spans":[{"id":"spn-27945","text":"---"}]},{"id":"blk-23983","kind":"heading","level":2,"spans":[{"id":"spn-27946","text":"6. View Metrics"}]},{"id":"blk-23984","kind":"paragraph","spans":[{"id":"spn-27947","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-23985","items":[{"blocks":[{"id":"blk-23987","kind":"paragraph","spans":[{"id":"spn-27948","text":"Request count"}]}],"id":"blk-23986","kind":"list-item"},{"blocks":[{"id":"blk-23989","kind":"paragraph","spans":[{"id":"spn-27949","text":"Token usage"}]}],"id":"blk-23988","kind":"list-item"},{"blocks":[{"id":"blk-23991","kind":"paragraph","spans":[{"id":"spn-27950","text":"Compute time (ms)"}]}],"id":"blk-23990","kind":"list-item"},{"blocks":[{"id":"blk-23993","kind":"paragraph","spans":[{"id":"spn-27951","text":"Error rate"}]}],"id":"blk-23992","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23994","kind":"paragraph","spans":[{"id":"spn-27952","text":"---"}]},{"id":"blk-23995","kind":"heading","level":2,"spans":[{"id":"spn-27953","text":"Next Steps"}]},{"id":"blk-23996","items":[{"blocks":[{"id":"blk-23998","kind":"paragraph","spans":[{"id":"spn-27954","text":"Read the "},{"id":"spn-27955","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-27956","text":" for system design context"}]}],"id":"blk-23997","kind":"list-item"},{"blocks":[{"id":"blk-24000","kind":"paragraph","spans":[{"id":"spn-27957","text":"See "},{"id":"spn-27958","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-27959","text":" for operational guides"}]}],"id":"blk-23999","kind":"list-item"},{"blocks":[{"id":"blk-24002","kind":"paragraph","spans":[{"id":"spn-27960","text":"Review the "},{"id":"spn-27961","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-27962","text":" for full requirements"}]}],"id":"blk-24001","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24003","kind":"paragraph","spans":[{"id":"spn-27963","text":"---"}]},{"id":"blk-24004","kind":"heading","level":2,"spans":[{"id":"spn-27964","text":"Verify Your Setup"}]},{"id":"blk-24005","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-24006","kind":"paragraph","spans":[{"id":"spn-27965","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaieraygsqlfxtolrwqkaiwlr6xkb23glz362pxphxlm2rmawxabhq7w4a","vocabulary":"ampersand.docs.fs.v1"}