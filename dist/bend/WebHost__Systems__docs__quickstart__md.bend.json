{"bendscript":"0.1","blocks":[{"id":"blk-23821","kind":"heading","level":1,"spans":[{"id":"spn-27269","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-23823","kind":"paragraph","spans":[{"id":"spn-27270","marks":["bold"],"text":"Purpose:"},{"id":"spn-27271","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-23822","kind":"quote"},{"id":"blk-23824","kind":"paragraph","spans":[{"id":"spn-27272","text":"---"}]},{"id":"blk-23825","kind":"heading","level":2,"spans":[{"id":"spn-27273","text":"Prerequisites"}]},{"id":"blk-23826","items":[{"blocks":[{"id":"blk-23828","kind":"paragraph","spans":[{"id":"spn-27274","text":"Node.js >= 20"}]}],"id":"blk-23827","kind":"list-item"},{"blocks":[{"id":"blk-23830","kind":"paragraph","spans":[{"id":"spn-27275","text":"npm (ships with Node)"}]}],"id":"blk-23829","kind":"list-item"},{"blocks":[{"id":"blk-23832","kind":"paragraph","spans":[{"id":"spn-27276","text":"Supabase CLI ("},{"id":"spn-27277","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-27278","text":")"}]}],"id":"blk-23831","kind":"list-item"},{"blocks":[{"id":"blk-23834","kind":"paragraph","spans":[{"id":"spn-27279","text":"A Supabase project (or local emulator)"}]}],"id":"blk-23833","kind":"list-item"},{"blocks":[{"id":"blk-23836","kind":"paragraph","spans":[{"id":"spn-27280","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-23835","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23837","kind":"paragraph","spans":[{"id":"spn-27281","text":"---"}]},{"id":"blk-23838","kind":"heading","level":2,"spans":[{"id":"spn-27282","text":"1. Clone and Install"}]},{"id":"blk-23839","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-23840","kind":"paragraph","spans":[{"id":"spn-27283","text":"---"}]},{"id":"blk-23841","kind":"heading","level":2,"spans":[{"id":"spn-27284","text":"2. Environment Setup"}]},{"id":"blk-23842","kind":"paragraph","spans":[{"id":"spn-27285","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-23843","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-23844","kind":"paragraph","spans":[{"id":"spn-27286","text":"Required variables:"}]},{"head":[{"id":"blk-23846","spans":[{"id":"spn-27287","text":"Variable"}]},{"id":"blk-23847","spans":[{"id":"spn-27288","text":"Description"}]}],"id":"blk-23845","kind":"table","rows":[[{"id":"blk-23848","spans":[{"id":"spn-27289","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-23849","spans":[{"id":"spn-27290","text":"Your Supabase project URL"}]}],[{"id":"blk-23850","spans":[{"id":"spn-27291","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-23851","spans":[{"id":"spn-27292","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-23852","spans":[{"id":"spn-27293","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-23853","spans":[{"id":"spn-27294","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-23854","spans":[{"id":"spn-27295","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-23855","spans":[{"id":"spn-27296","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-23856","spans":[{"id":"spn-27297","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-23857","spans":[{"id":"spn-27298","text":"Cloudflare account ID"}]}],[{"id":"blk-23858","spans":[{"id":"spn-27299","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-23859","spans":[{"id":"spn-27300","text":"Billing webhook verification"}]}]]},{"id":"blk-23860","kind":"paragraph","spans":[{"id":"spn-27301","text":"---"}]},{"id":"blk-23861","kind":"heading","level":2,"spans":[{"id":"spn-27302","text":"3. Start Development Servers"}]},{"id":"blk-23862","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-23863","kind":"paragraph","spans":[{"id":"spn-27303","text":"---"}]},{"id":"blk-23864","kind":"heading","level":2,"spans":[{"id":"spn-27304","text":"4. Create Your First Agent"}]},{"id":"blk-23865","kind":"heading","level":3,"spans":[{"id":"spn-27305","text":"Via the dashboard"}]},{"id":"blk-23866","kind":"paragraph","spans":[{"id":"spn-27306","text":"1. Navigate to "},{"id":"spn-27307","marks":["code"],"text":"http://localhost:5173"},{"id":"spn-27308","text":" 2. Sign in (Supabase Auth: email or OAuth) 3. Click \"New Agent\" 4. Fill in name, framework, and select "},{"id":"spn-27309","marks":["code"],"text":"cloudflare"},{"id":"spn-27310","text":" runtime 5. Upload a bundle containing "},{"id":"spn-27311","marks":["code"],"text":"agent.config.json"},{"id":"spn-27312","text":" and your entrypoint 6. Click \"Deploy\""}]},{"id":"blk-23867","kind":"heading","level":3,"spans":[{"id":"spn-27313","text":"Via the API"}]},{"id":"blk-23868","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-23869","kind":"paragraph","spans":[{"id":"spn-27314","text":"---"}]},{"id":"blk-23870","kind":"heading","level":2,"spans":[{"id":"spn-27315","text":"5. Invoke Your Agent"}]},{"id":"blk-23871","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-23872","kind":"paragraph","spans":[{"id":"spn-27316","text":"---"}]},{"id":"blk-23873","kind":"heading","level":2,"spans":[{"id":"spn-27317","text":"6. View Metrics"}]},{"id":"blk-23874","kind":"paragraph","spans":[{"id":"spn-27318","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-23875","items":[{"blocks":[{"id":"blk-23877","kind":"paragraph","spans":[{"id":"spn-27319","text":"Request count"}]}],"id":"blk-23876","kind":"list-item"},{"blocks":[{"id":"blk-23879","kind":"paragraph","spans":[{"id":"spn-27320","text":"Token usage"}]}],"id":"blk-23878","kind":"list-item"},{"blocks":[{"id":"blk-23881","kind":"paragraph","spans":[{"id":"spn-27321","text":"Compute time (ms)"}]}],"id":"blk-23880","kind":"list-item"},{"blocks":[{"id":"blk-23883","kind":"paragraph","spans":[{"id":"spn-27322","text":"Error rate"}]}],"id":"blk-23882","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23884","kind":"paragraph","spans":[{"id":"spn-27323","text":"---"}]},{"id":"blk-23885","kind":"heading","level":2,"spans":[{"id":"spn-27324","text":"Next Steps"}]},{"id":"blk-23886","items":[{"blocks":[{"id":"blk-23888","kind":"paragraph","spans":[{"id":"spn-27325","text":"Read the "},{"id":"spn-27326","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-27327","text":" for system design context"}]}],"id":"blk-23887","kind":"list-item"},{"blocks":[{"id":"blk-23890","kind":"paragraph","spans":[{"id":"spn-27328","text":"See "},{"id":"spn-27329","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-27330","text":" for operational guides"}]}],"id":"blk-23889","kind":"list-item"},{"blocks":[{"id":"blk-23892","kind":"paragraph","spans":[{"id":"spn-27331","text":"Review the "},{"id":"spn-27332","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-27333","text":" for full requirements"}]}],"id":"blk-23891","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23893","kind":"paragraph","spans":[{"id":"spn-27334","text":"---"}]},{"id":"blk-23894","kind":"heading","level":2,"spans":[{"id":"spn-27335","text":"Verify Your Setup"}]},{"id":"blk-23895","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-23896","kind":"paragraph","spans":[{"id":"spn-27336","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaiera23k25p3axynsd4hmijip537j5n27ldiforpopcwdr5dae7ki2uxq","vocabulary":"ampersand.docs.fs.v1"}