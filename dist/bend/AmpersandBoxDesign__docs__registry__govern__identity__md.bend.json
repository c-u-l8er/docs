{"bendscript":"0.1","blocks":[{"id":"blk-8867","kind":"heading","level":1,"spans":[{"id":"spn-8564","marks":["code"],"text":"&govern.identity"},{"id":"spn-8565","text":" — Agent Identity, Verification, and Trust"}]},{"id":"blk-8868","kind":"paragraph","spans":[{"id":"spn-8566","marks":["code"],"text":"&govern.identity"},{"id":"spn-8567","text":" is the [&] Protocol capability for "},{"id":"spn-8568","marks":["bold"],"text":"cross-runtime agent identity and trust verification"},{"id":"spn-8569","text":"."}]},{"id":"blk-8869","kind":"paragraph","spans":[{"id":"spn-8570","text":"It describes an agent's ability to:"}]},{"id":"blk-8870","items":[{"blocks":[{"id":"blk-8872","kind":"paragraph","spans":[{"id":"spn-8571","text":"establish a portable, verifiable identity"}]}],"id":"blk-8871","kind":"list-item"},{"blocks":[{"id":"blk-8874","kind":"paragraph","spans":[{"id":"spn-8572","text":"prove that identity to other agents and governance systems"}]}],"id":"blk-8873","kind":"list-item"},{"blocks":[{"id":"blk-8876","kind":"paragraph","spans":[{"id":"spn-8573","text":"register and update identity in a shared registry"}]}],"id":"blk-8875","kind":"list-item"},{"blocks":[{"id":"blk-8878","kind":"paragraph","spans":[{"id":"spn-8574","text":"carry trust metadata that informs collaboration and delegation decisions"}]}],"id":"blk-8877","kind":"list-item"},{"blocks":[{"id":"blk-8880","kind":"paragraph","spans":[{"id":"spn-8575","text":"maintain identity continuity across runtimes, sessions, and deployments"}]}],"id":"blk-8879","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8881","kind":"paragraph","spans":[{"id":"spn-8576","text":"In the protocol's five-primitive model:"}]},{"id":"blk-8882","items":[{"blocks":[{"id":"blk-8884","kind":"paragraph","spans":[{"id":"spn-8577","marks":["code"],"text":"&memory"},{"id":"spn-8578","text":" answers "},{"id":"spn-8579","marks":["bold"],"text":"what"},{"id":"spn-8580","text":" the agent knows"}]}],"id":"blk-8883","kind":"list-item"},{"blocks":[{"id":"blk-8886","kind":"paragraph","spans":[{"id":"spn-8581","marks":["code"],"text":"&reason"},{"id":"spn-8582","text":" answers "},{"id":"spn-8583","marks":["bold"],"text":"how"},{"id":"spn-8584","text":" the agent decides"}]}],"id":"blk-8885","kind":"list-item"},{"blocks":[{"id":"blk-8888","kind":"paragraph","spans":[{"id":"spn-8585","marks":["code"],"text":"&time"},{"id":"spn-8586","text":" answers "},{"id":"spn-8587","marks":["bold"],"text":"when"},{"id":"spn-8588","text":" things change"}]}],"id":"blk-8887","kind":"list-item"},{"blocks":[{"id":"blk-8890","kind":"paragraph","spans":[{"id":"spn-8589","marks":["code"],"text":"&space"},{"id":"spn-8590","text":" answers "},{"id":"spn-8591","marks":["bold"],"text":"where"},{"id":"spn-8592","text":" things are"}]}],"id":"blk-8889","kind":"list-item"},{"blocks":[{"id":"blk-8892","kind":"paragraph","spans":[{"id":"spn-8593","marks":["code"],"text":"&govern"},{"id":"spn-8594","text":" answers "},{"id":"spn-8595","marks":["bold"],"text":"who approves, what limits apply, and how decisions are audited"}]}],"id":"blk-8891","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8893","kind":"paragraph","spans":[{"id":"spn-8596","marks":["code"],"text":"&govern.identity"},{"id":"spn-8597","text":" is the subtype that answers the foundational question: "},{"id":"spn-8598","marks":["bold"],"text":"who is this agent, and can it be trusted?"}]},{"id":"blk-8894","kind":"heading","level":2,"spans":[{"id":"spn-8599","text":"1. Definition"}]},{"id":"blk-8895","kind":"paragraph","spans":[{"id":"spn-8600","marks":["code"],"text":"&govern.identity"},{"id":"spn-8601","text":" is the capability interface for "},{"id":"spn-8602","marks":["bold"],"text":"agent identity resolution, verification, and registration"},{"id":"spn-8603","text":"."}]},{"id":"blk-8896","kind":"paragraph","spans":[{"id":"spn-8604","text":"It is used when a system must:"}]},{"id":"blk-8897","items":[{"blocks":[{"id":"blk-8899","kind":"paragraph","spans":[{"id":"spn-8605","text":"resolve an agent's identity from its ID, returning manifest, capabilities, and trust metadata"}]}],"id":"blk-8898","kind":"list-item"},{"blocks":[{"id":"blk-8901","kind":"paragraph","spans":[{"id":"spn-8606","text":"verify that an agent's claimed identity matches its registered manifest"}]}],"id":"blk-8900","kind":"list-item"},{"blocks":[{"id":"blk-8903","kind":"paragraph","spans":[{"id":"spn-8607","text":"register or update an agent's identity in the shared registry"}]}],"id":"blk-8902","kind":"list-item"},{"blocks":[{"id":"blk-8905","kind":"paragraph","spans":[{"id":"spn-8608","text":"link identity to governance policy, org membership, and runtime bindings"}]}],"id":"blk-8904","kind":"list-item"},{"blocks":[{"id":"blk-8907","kind":"paragraph","spans":[{"id":"spn-8609","text":"provide trust scores that inform delegation and collaboration decisions"}]}],"id":"blk-8906","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8908","kind":"paragraph","spans":[{"id":"spn-8610","text":"Without portable identity, multi-agent systems cannot answer basic questions:"}]},{"id":"blk-8909","items":[{"blocks":[{"id":"blk-8911","kind":"paragraph","spans":[{"id":"spn-8611","text":"Is this agent who it claims to be?"}]}],"id":"blk-8910","kind":"list-item"},{"blocks":[{"id":"blk-8913","kind":"paragraph","spans":[{"id":"spn-8612","text":"What capabilities does it actually have?"}]}],"id":"blk-8912","kind":"list-item"},{"blocks":[{"id":"blk-8915","kind":"paragraph","spans":[{"id":"spn-8613","text":"Which organization published it?"}]}],"id":"blk-8914","kind":"list-item"},{"blocks":[{"id":"blk-8917","kind":"paragraph","spans":[{"id":"spn-8614","text":"What governance constraints apply to it?"}]}],"id":"blk-8916","kind":"list-item"},{"blocks":[{"id":"blk-8919","kind":"paragraph","spans":[{"id":"spn-8615","text":"Should I trust its outputs?"}]}],"id":"blk-8918","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8920","kind":"paragraph","spans":[{"id":"spn-8616","marks":["code"],"text":"&govern.identity"},{"id":"spn-8617","text":" makes these answers explicit, verifiable, and protocol-native."}]},{"id":"blk-8921","kind":"heading","level":2,"spans":[{"id":"spn-8618","text":"2. Why this capability exists"}]},{"id":"blk-8922","kind":"paragraph","spans":[{"id":"spn-8619","text":"Many agent systems assume trust implicitly."}]},{"id":"blk-8923","kind":"paragraph","spans":[{"id":"spn-8620","text":"That works in single-agent demos, but it breaks down in production multi-agent workflows:"}]},{"id":"blk-8924","items":[{"blocks":[{"id":"blk-8926","kind":"paragraph","spans":[{"id":"spn-8621","text":"An agent receives a task delegation from another agent, but cannot verify the sender's identity or authority."}]}],"id":"blk-8925","kind":"list-item"},{"blocks":[{"id":"blk-8928","kind":"paragraph","spans":[{"id":"spn-8622","text":"A governance system needs to audit which agent produced a decision, but agent identity is tied to a specific runtime and not portable."}]}],"id":"blk-8927","kind":"list-item"},{"blocks":[{"id":"blk-8930","kind":"paragraph","spans":[{"id":"spn-8623","text":"A marketplace lists agents for hire, but has no standard way to verify that an agent's declared capabilities match its actual manifest."}]}],"id":"blk-8929","kind":"list-item"},{"blocks":[{"id":"blk-8932","kind":"paragraph","spans":[{"id":"spn-8624","text":"Two agents from different organizations need to collaborate, but neither can verify the other's governance policy or trust level."}]}],"id":"blk-8931","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8933","kind":"paragraph","spans":[{"id":"spn-8625","text":"In all of these cases, the missing layer is "},{"id":"spn-8626","marks":["bold"],"text":"verifiable, portable agent identity"},{"id":"spn-8627","text":"."}]},{"id":"blk-8934","kind":"paragraph","spans":[{"id":"spn-8628","text":"The OpenSentience OS-007 threat model identifies agent impersonation as a critical risk in multi-agent systems. "},{"id":"spn-8629","marks":["code"],"text":"&govern.identity"},{"id":"spn-8630","text":" is the protocol's answer to that threat."}]},{"id":"blk-8935","kind":"heading","level":2,"spans":[{"id":"spn-8631","text":"3. What problems "},{"id":"spn-8632","marks":["code"],"text":"&govern.identity"},{"id":"spn-8633","text":" solves"}]},{"id":"blk-8936","kind":"paragraph","spans":[{"id":"spn-8634","marks":["code"],"text":"&govern.identity"},{"id":"spn-8635","text":" is useful when an agent or system needs to answer questions like:"}]},{"id":"blk-8937","items":[{"blocks":[{"id":"blk-8939","kind":"paragraph","spans":[{"id":"spn-8636","text":"Who is this agent, and what is its manifest hash?"}]}],"id":"blk-8938","kind":"list-item"},{"blocks":[{"id":"blk-8941","kind":"paragraph","spans":[{"id":"spn-8637","text":"Does this agent's claimed identity match its registered manifest?"}]}],"id":"blk-8940","kind":"list-item"},{"blocks":[{"id":"blk-8943","kind":"paragraph","spans":[{"id":"spn-8638","text":"Which organization published this agent?"}]}],"id":"blk-8942","kind":"list-item"},{"blocks":[{"id":"blk-8945","kind":"paragraph","spans":[{"id":"spn-8639","text":"What capabilities does this agent declare?"}]}],"id":"blk-8944","kind":"list-item"},{"blocks":[{"id":"blk-8947","kind":"paragraph","spans":[{"id":"spn-8640","text":"What autonomy level and governance constraints apply?"}]}],"id":"blk-8946","kind":"list-item"},{"blocks":[{"id":"blk-8949","kind":"paragraph","spans":[{"id":"spn-8641","text":"What is this agent's trust score, and who computed it?"}]}],"id":"blk-8948","kind":"list-item"},{"blocks":[{"id":"blk-8951","kind":"paragraph","spans":[{"id":"spn-8642","text":"Which runtimes is this agent currently bound to?"}]}],"id":"blk-8950","kind":"list-item"},{"blocks":[{"id":"blk-8953","kind":"paragraph","spans":[{"id":"spn-8643","text":"Has this agent's manifest changed since registration?"}]}],"id":"blk-8952","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8954","kind":"paragraph","spans":[{"id":"spn-8644","text":"Without this capability, identity management tends to get buried inside:"}]},{"id":"blk-8955","items":[{"blocks":[{"id":"blk-8957","kind":"paragraph","spans":[{"id":"spn-8645","text":"runtime-specific authentication systems"}]}],"id":"blk-8956","kind":"list-item"},{"blocks":[{"id":"blk-8959","kind":"paragraph","spans":[{"id":"spn-8646","text":"custom API key and token exchanges"}]}],"id":"blk-8958","kind":"list-item"},{"blocks":[{"id":"blk-8961","kind":"paragraph","spans":[{"id":"spn-8647","text":"implicit trust assumptions in orchestration code"}]}],"id":"blk-8960","kind":"list-item"},{"blocks":[{"id":"blk-8963","kind":"paragraph","spans":[{"id":"spn-8648","text":"vendor-specific agent directories with no interoperability"}]}],"id":"blk-8962","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8964","kind":"paragraph","spans":[{"id":"spn-8649","text":"The protocol makes it explicit instead."}]},{"id":"blk-8965","kind":"heading","level":2,"spans":[{"id":"spn-8650","text":"4. Capability role in the "},{"id":"spn-8651","marks":["code"],"text":"&govern"},{"id":"spn-8652","text":" namespace"}]},{"id":"blk-8966","kind":"paragraph","spans":[{"id":"spn-8653","text":"The "},{"id":"spn-8654","marks":["code"],"text":"&govern"},{"id":"spn-8655","text":" primitive supports multiple subtypes, including:"}]},{"id":"blk-8967","items":[{"blocks":[{"id":"blk-8969","kind":"paragraph","spans":[{"id":"spn-8656","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-8968","kind":"list-item"},{"blocks":[{"id":"blk-8971","kind":"paragraph","spans":[{"id":"spn-8657","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-8970","kind":"list-item"},{"blocks":[{"id":"blk-8973","kind":"paragraph","spans":[{"id":"spn-8658","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-8972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8974","kind":"paragraph","spans":[{"id":"spn-8659","text":"A helpful distinction is:"}]},{"id":"blk-8975","items":[{"blocks":[{"id":"blk-8977","kind":"paragraph","spans":[{"id":"spn-8660","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8661","text":" = decision handoff when thresholds are crossed"}]}],"id":"blk-8976","kind":"list-item"},{"blocks":[{"id":"blk-8979","kind":"paragraph","spans":[{"id":"spn-8662","marks":["code"],"text":"&govern.identity"},{"id":"spn-8663","text":" = agent authentication and trust verification"}]}],"id":"blk-8978","kind":"list-item"},{"blocks":[{"id":"blk-8981","kind":"paragraph","spans":[{"id":"spn-8664","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-8665","text":" = observability, cost tracking, and budget enforcement"}]}],"id":"blk-8980","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8982","kind":"paragraph","spans":[{"id":"spn-8666","marks":["code"],"text":"&govern.identity"},{"id":"spn-8667","text":" is the right subtype when the main problem is "},{"id":"spn-8668","marks":["bold"],"text":"establishing and verifying who an agent is"},{"id":"spn-8669","text":" before trusting its actions, delegations, or outputs."}]},{"id":"blk-8983","kind":"heading","level":2,"spans":[{"id":"spn-8670","text":"5. Typical use cases"}]},{"id":"blk-8984","kind":"heading","level":3,"spans":[{"id":"spn-8671","text":"A2A handshake verification"}]},{"id":"blk-8985","kind":"paragraph","spans":[{"id":"spn-8672","text":"Before two agents collaborate, each verifies the other's identity and governance policy via "},{"id":"spn-8673","marks":["code"],"text":"&govern.identity.verify()"},{"id":"spn-8674","text":"."}]},{"id":"blk-8986","kind":"heading","level":3,"spans":[{"id":"spn-8675","text":"Agent registration"}]},{"id":"blk-8987","kind":"paragraph","spans":[{"id":"spn-8676","text":"A newly deployed agent registers its identity, linking its "},{"id":"spn-8677","marks":["code"],"text":"ampersand.json"},{"id":"spn-8678","text":" declaration, SpecPrompt spec, and Delegatic org membership."}]},{"id":"blk-8988","kind":"heading","level":3,"spans":[{"id":"spn-8679","text":"Marketplace trust evaluation"}]},{"id":"blk-8989","kind":"paragraph","spans":[{"id":"spn-8680","text":"FleetPrompt computes trust scores based on registered identity metadata. Consumers use "},{"id":"spn-8681","marks":["code"],"text":"resolve"},{"id":"spn-8682","text":" to inspect an agent's trust profile before delegation."}]},{"id":"blk-8990","kind":"heading","level":3,"spans":[{"id":"spn-8683","text":"Provenance attribution"}]},{"id":"blk-8991","kind":"paragraph","spans":[{"id":"spn-8684","text":"Every capability operation records the agent's identity in its provenance chain. "},{"id":"spn-8685","marks":["code"],"text":"&govern.identity"},{"id":"spn-8686","text":" provides the authoritative source for that attribution."}]},{"id":"blk-8992","kind":"heading","level":3,"spans":[{"id":"spn-8687","text":"Governance audit"}]},{"id":"blk-8993","kind":"paragraph","spans":[{"id":"spn-8688","text":"Auditors query identity records to verify that agents operating within an org match their registered manifests and governance constraints."}]},{"id":"blk-8994","kind":"heading","level":3,"spans":[{"id":"spn-8689","text":"Cross-runtime continuity"}]},{"id":"blk-8995","kind":"paragraph","spans":[{"id":"spn-8690","text":"An agent migrates between runtimes (e.g., from local development to cloud deployment). Identity persists across the transition because it is bound to the manifest, not the runtime."}]},{"id":"blk-8996","kind":"heading","level":2,"spans":[{"id":"spn-8691","text":"6. Example capability contract"}]},{"id":"blk-8997","kind":"paragraph","spans":[{"id":"spn-8692","text":"The authoritative contract is at "},{"id":"spn-8693","marks":["code"],"text":"contracts/v0.1.0/govern.identity.contract.json"},{"id":"spn-8694","text":"."}]},{"id":"blk-8998","kind":"paragraph","spans":[{"id":"spn-8695","text":"A representative summary:"}]},{"id":"blk-8999","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&govern.identity\",\n  \"provider\": \"opensentience\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Cross-runtime agent identity contract for resolution, verification, and registration.\",\n  \"operations\": {\n    \"resolve\": {\n      \"in\": \"identity_query\",\n      \"out\": \"agent_identity\",\n      \"description\": \"Resolve an agent's identity by ID, returning manifest, capabilities, and trust metadata.\"\n    },\n    \"verify\": {\n      \"in\": \"verification_request\",\n      \"out\": \"verification_result\",\n      \"description\": \"Verify that an agent's claimed identity matches its registered manifest.\"\n    },\n    \"register\": {\n      \"in\": \"agent_manifest\",\n      \"out\": \"registration_ack\",\n      \"description\": \"Register or update an agent's identity in the shared registry.\"\n    }\n  },\n  \"accepts_from\": [\n    \"&govern.*\",\n    \"identity_query\",\n    \"identity_claim\",\n    \"agent_manifest\"\n  ],\n  \"feeds_into\": [\n    \"&govern.escalation\",\n    \"&govern.telemetry\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"agent-identity-verification\",\n    \"manifest-attestation\"\n  ]\n}"},{"id":"blk-9000","kind":"heading","level":3,"spans":[{"id":"spn-8696","text":"What this contract means"}]},{"id":"blk-9001","kind":"paragraph","spans":[{"id":"spn-8697","text":"This contract says that "},{"id":"spn-8698","marks":["code"],"text":"&govern.identity"},{"id":"spn-8699","text":" can:"}]},{"id":"blk-9002","items":[{"blocks":[{"id":"blk-9004","kind":"paragraph","spans":[{"id":"spn-8700","text":"resolve agent identities from queries"}]}],"id":"blk-9003","kind":"list-item"},{"blocks":[{"id":"blk-9006","kind":"paragraph","spans":[{"id":"spn-8701","text":"verify claimed identities against registered manifests"}]}],"id":"blk-9005","kind":"list-item"},{"blocks":[{"id":"blk-9008","kind":"paragraph","spans":[{"id":"spn-8702","text":"register new agents or update existing registrations"}]}],"id":"blk-9007","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9009","kind":"paragraph","spans":[{"id":"spn-8703","text":"It also says that this capability composes well with:"}]},{"id":"blk-9010","items":[{"blocks":[{"id":"blk-9012","kind":"paragraph","spans":[{"id":"spn-8704","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8705","text":" downstream, where escalation requests must be attributed to verified identities"}]}],"id":"blk-9011","kind":"list-item"},{"blocks":[{"id":"blk-9014","kind":"paragraph","spans":[{"id":"spn-8706","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-8707","text":" downstream, where telemetry events must be attributed to known agents"}]}],"id":"blk-9013","kind":"list-item"},{"blocks":[{"id":"blk-9016","kind":"paragraph","spans":[{"id":"spn-8708","marks":["code"],"text":"&govern.*"},{"id":"spn-8709","text":" upstream, where other governance capabilities may trigger identity checks"}]}],"id":"blk-9015","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9017","kind":"heading","level":2,"spans":[{"id":"spn-8710","text":"7. Core operations"}]},{"id":"blk-9018","kind":"heading","level":3,"spans":[{"id":"spn-8711","marks":["code"],"text":"resolve"}]},{"id":"blk-9019","kind":"paragraph","spans":[{"id":"spn-8712","text":"Purpose:"}]},{"id":"blk-9020","items":[{"blocks":[{"id":"blk-9022","kind":"paragraph","spans":[{"id":"spn-8713","text":"look up an agent's full identity record by ID"}]}],"id":"blk-9021","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9023","kind":"paragraph","spans":[{"id":"spn-8714","text":"Typical input:"}]},{"id":"blk-9024","items":[{"blocks":[{"id":"blk-9026","kind":"paragraph","spans":[{"id":"spn-8715","marks":["code"],"text":"identity_query"}]}],"id":"blk-9025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9027","kind":"paragraph","spans":[{"id":"spn-8716","text":"Typical output:"}]},{"id":"blk-9028","items":[{"blocks":[{"id":"blk-9030","kind":"paragraph","spans":[{"id":"spn-8717","marks":["code"],"text":"agent_identity"}]}],"id":"blk-9029","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9031","kind":"paragraph","spans":[{"id":"spn-8718","text":"Use when:"}]},{"id":"blk-9032","items":[{"blocks":[{"id":"blk-9034","kind":"paragraph","spans":[{"id":"spn-8719","text":"another agent or system needs to inspect an agent's capabilities, governance policy, trust score, or runtime bindings before interacting with it"}]}],"id":"blk-9033","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9035","kind":"heading","level":3,"spans":[{"id":"spn-8720","marks":["code"],"text":"verify"}]},{"id":"blk-9036","kind":"paragraph","spans":[{"id":"spn-8721","text":"Purpose:"}]},{"id":"blk-9037","items":[{"blocks":[{"id":"blk-9039","kind":"paragraph","spans":[{"id":"spn-8722","text":"confirm that an agent's claimed identity matches its registered manifest"}]}],"id":"blk-9038","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9040","kind":"paragraph","spans":[{"id":"spn-8723","text":"Typical input:"}]},{"id":"blk-9041","items":[{"blocks":[{"id":"blk-9043","kind":"paragraph","spans":[{"id":"spn-8724","marks":["code"],"text":"verification_request"}]}],"id":"blk-9042","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9044","kind":"paragraph","spans":[{"id":"spn-8725","text":"Typical output:"}]},{"id":"blk-9045","items":[{"blocks":[{"id":"blk-9047","kind":"paragraph","spans":[{"id":"spn-8726","marks":["code"],"text":"verification_result"}]}],"id":"blk-9046","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9048","kind":"paragraph","spans":[{"id":"spn-8727","text":"Use when:"}]},{"id":"blk-9049","items":[{"blocks":[{"id":"blk-9051","kind":"paragraph","spans":[{"id":"spn-8728","text":"an A2A handshake requires mutual identity verification"}]}],"id":"blk-9050","kind":"list-item"},{"blocks":[{"id":"blk-9053","kind":"paragraph","spans":[{"id":"spn-8729","text":"an escalation request must be attributed to a verified agent"}]}],"id":"blk-9052","kind":"list-item"},{"blocks":[{"id":"blk-9055","kind":"paragraph","spans":[{"id":"spn-8730","text":"a governance audit checks that operating agents match their registrations"}]}],"id":"blk-9054","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9056","kind":"heading","level":3,"spans":[{"id":"spn-8731","marks":["code"],"text":"register"}]},{"id":"blk-9057","kind":"paragraph","spans":[{"id":"spn-8732","text":"Purpose:"}]},{"id":"blk-9058","items":[{"blocks":[{"id":"blk-9060","kind":"paragraph","spans":[{"id":"spn-8733","text":"create or update an agent's identity in the registry"}]}],"id":"blk-9059","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9061","kind":"paragraph","spans":[{"id":"spn-8734","text":"Typical input:"}]},{"id":"blk-9062","items":[{"blocks":[{"id":"blk-9064","kind":"paragraph","spans":[{"id":"spn-8735","marks":["code"],"text":"agent_manifest"}]}],"id":"blk-9063","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9065","kind":"paragraph","spans":[{"id":"spn-8736","text":"Typical output:"}]},{"id":"blk-9066","items":[{"blocks":[{"id":"blk-9068","kind":"paragraph","spans":[{"id":"spn-8737","marks":["code"],"text":"registration_ack"}]}],"id":"blk-9067","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9069","kind":"paragraph","spans":[{"id":"spn-8738","text":"Use when:"}]},{"id":"blk-9070","items":[{"blocks":[{"id":"blk-9072","kind":"paragraph","spans":[{"id":"spn-8739","text":"a new agent is deployed and needs to establish its identity"}]}],"id":"blk-9071","kind":"list-item"},{"blocks":[{"id":"blk-9074","kind":"paragraph","spans":[{"id":"spn-8740","text":"an agent's manifest, capabilities, or governance policy has changed"}]}],"id":"blk-9073","kind":"list-item"},{"blocks":[{"id":"blk-9076","kind":"paragraph","spans":[{"id":"spn-8741","text":"an agent is linking to a new SpecPrompt spec or Delegatic org"}]}],"id":"blk-9075","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9077","kind":"heading","level":2,"spans":[{"id":"spn-8742","text":"8. Identity fields"}]},{"id":"blk-9078","kind":"paragraph","spans":[{"id":"spn-8743","text":"The identity record contains the following fields:"}]},{"id":"blk-9079","kind":"heading","level":3,"spans":[{"id":"spn-8744","text":"Core identity"}]},{"id":"blk-9080","items":[{"blocks":[{"id":"blk-9082","kind":"paragraph","spans":[{"id":"spn-8745","marks":["code"],"text":"agent_id"},{"id":"spn-8746","text":" — globally unique identifier (UUIDv7)"}]}],"id":"blk-9081","kind":"list-item"},{"blocks":[{"id":"blk-9084","kind":"paragraph","spans":[{"id":"spn-8747","marks":["code"],"text":"agent_name"},{"id":"spn-8748","text":" — human-readable name from "},{"id":"spn-8749","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-9083","kind":"list-item"},{"blocks":[{"id":"blk-9086","kind":"paragraph","spans":[{"id":"spn-8750","marks":["code"],"text":"version"},{"id":"spn-8751","text":" — semver from "},{"id":"spn-8752","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-9085","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9087","kind":"heading","level":3,"spans":[{"id":"spn-8753","text":"Integrity hashes"}]},{"id":"blk-9088","items":[{"blocks":[{"id":"blk-9090","kind":"paragraph","spans":[{"id":"spn-8754","marks":["code"],"text":"manifest_hash"},{"id":"spn-8755","text":" — SHA-256 of the "},{"id":"spn-8756","marks":["code"],"text":"ampersand.json"},{"id":"spn-8757","text":" declaration at registration time"}]}],"id":"blk-9089","kind":"list-item"},{"blocks":[{"id":"blk-9092","kind":"paragraph","spans":[{"id":"spn-8758","marks":["code"],"text":"spec_hash"},{"id":"spn-8759","text":" — SHA-256 of the linked SpecPrompt "},{"id":"spn-8760","marks":["code"],"text":"SPEC.md"},{"id":"spn-8761","text":" (if applicable)"}]}],"id":"blk-9091","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9093","kind":"heading","level":3,"spans":[{"id":"spn-8762","text":"Organizational binding"}]},{"id":"blk-9094","items":[{"blocks":[{"id":"blk-9096","kind":"paragraph","spans":[{"id":"spn-8763","marks":["code"],"text":"org_id"},{"id":"spn-8764","text":" — Delegatic org reference"}]}],"id":"blk-9095","kind":"list-item"},{"blocks":[{"id":"blk-9098","kind":"paragraph","spans":[{"id":"spn-8765","marks":["code"],"text":"publisher_id"},{"id":"spn-8766","text":" — FleetPrompt publisher reference"}]}],"id":"blk-9097","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9099","kind":"heading","level":3,"spans":[{"id":"spn-8767","text":"Capability declaration"}]},{"id":"blk-9100","items":[{"blocks":[{"id":"blk-9102","kind":"paragraph","spans":[{"id":"spn-8768","marks":["code"],"text":"capabilities"},{"id":"spn-8769","text":" — list of declared "},{"id":"spn-8770","marks":["code"],"text":"&"},{"id":"spn-8771","text":"-prefixed capability keys"}]}],"id":"blk-9101","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9103","kind":"heading","level":3,"spans":[{"id":"spn-8772","text":"Governance summary"}]},{"id":"blk-9104","items":[{"blocks":[{"id":"blk-9106","kind":"paragraph","spans":[{"id":"spn-8773","marks":["code"],"text":"autonomy_level"},{"id":"spn-8774","text":" — observe, advise, or act"}]}],"id":"blk-9105","kind":"list-item"},{"blocks":[{"id":"blk-9108","kind":"paragraph","spans":[{"id":"spn-8775","marks":["code"],"text":"model_tier"},{"id":"spn-8776","text":" — local_small, local_large, or cloud_frontier"}]}],"id":"blk-9107","kind":"list-item"},{"blocks":[{"id":"blk-9110","kind":"paragraph","spans":[{"id":"spn-8777","marks":["code"],"text":"hard_constraints_count"},{"id":"spn-8778","text":" — number of hard governance constraints"}]}],"id":"blk-9109","kind":"list-item"},{"blocks":[{"id":"blk-9112","kind":"paragraph","spans":[{"id":"spn-8779","marks":["code"],"text":"escalation_configured"},{"id":"spn-8780","text":" — whether "},{"id":"spn-8781","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8782","text":" is declared"}]}],"id":"blk-9111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9113","kind":"heading","level":3,"spans":[{"id":"spn-8783","text":"Runtime bindings"}]},{"id":"blk-9114","items":[{"blocks":[{"id":"blk-9116","kind":"paragraph","spans":[{"id":"spn-8784","marks":["code"],"text":"runtime"},{"id":"spn-8785","text":" — runtime provider (cloudflare, agentcore, opensentience, custom)"}]}],"id":"blk-9115","kind":"list-item"},{"blocks":[{"id":"blk-9118","kind":"paragraph","spans":[{"id":"spn-8786","marks":["code"],"text":"deployment_ref"},{"id":"spn-8787","text":" — deployment reference within the runtime"}]}],"id":"blk-9117","kind":"list-item"},{"blocks":[{"id":"blk-9120","kind":"paragraph","spans":[{"id":"spn-8788","marks":["code"],"text":"status"},{"id":"spn-8789","text":" — active, inactive, or deploying"}]}],"id":"blk-9119","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9121","kind":"heading","level":3,"spans":[{"id":"spn-8790","text":"Trust metadata"}]},{"id":"blk-9122","items":[{"blocks":[{"id":"blk-9124","kind":"paragraph","spans":[{"id":"spn-8791","marks":["code"],"text":"trust_score"},{"id":"spn-8792","text":" — FleetPrompt-computed trust score (0.0 to 1.0)"}]}],"id":"blk-9123","kind":"list-item"},{"blocks":[{"id":"blk-9126","kind":"paragraph","spans":[{"id":"spn-8793","marks":["code"],"text":"registered_at"},{"id":"spn-8794","text":" — ISO 8601 registration timestamp"}]}],"id":"blk-9125","kind":"list-item"},{"blocks":[{"id":"blk-9128","kind":"paragraph","spans":[{"id":"spn-8795","marks":["code"],"text":"updated_at"},{"id":"spn-8796","text":" — ISO 8601 last update timestamp"}]}],"id":"blk-9127","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9129","kind":"heading","level":2,"spans":[{"id":"spn-8797","text":"9. Architecture patterns"}]},{"id":"blk-9130","kind":"heading","level":3,"spans":[{"id":"spn-8798","text":"Pattern A: A2A handshake with mutual verification"}]},{"id":"blk-9131","kind":"code","language":"text","text":"agent_a\n|> &govern.identity.resolve(agent_b_id)\n|> &govern.identity.verify(agent_b_claim)\n|> proceed_if_verified()"},{"id":"blk-9132","kind":"paragraph","spans":[{"id":"spn-8799","text":"Use this when:"}]},{"id":"blk-9133","items":[{"blocks":[{"id":"blk-9135","kind":"paragraph","spans":[{"id":"spn-8800","text":"two agents need to establish mutual trust before collaborating"}]}],"id":"blk-9134","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9136","kind":"heading","level":3,"spans":[{"id":"spn-8801","text":"Pattern B: identity-gated escalation"}]},{"id":"blk-9137","kind":"code","language":"text","text":"escalation_request\n|> &govern.identity.verify(requester)\n|> &govern.escalation.escalate()\n|> &govern.telemetry.emit()"},{"id":"blk-9138","kind":"paragraph","spans":[{"id":"spn-8802","text":"Use this when:"}]},{"id":"blk-9139","items":[{"blocks":[{"id":"blk-9141","kind":"paragraph","spans":[{"id":"spn-8803","text":"an escalation request must be attributed to a verified agent before it is surfaced to a human operator"}]}],"id":"blk-9140","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9142","kind":"heading","level":3,"spans":[{"id":"spn-8804","text":"Pattern C: registration at deployment"}]},{"id":"blk-9143","kind":"code","language":"text","text":"ampersand_json\n|> &govern.identity.register()\n|> &govern.telemetry.emit()\n|> deploy_to_runtime()"},{"id":"blk-9144","kind":"paragraph","spans":[{"id":"spn-8805","text":"Use this when:"}]},{"id":"blk-9145","items":[{"blocks":[{"id":"blk-9147","kind":"paragraph","spans":[{"id":"spn-8806","text":"a new agent is being deployed and needs to establish its registry identity before becoming operational"}]}],"id":"blk-9146","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9148","kind":"heading","level":3,"spans":[{"id":"spn-8807","text":"Pattern D: trust-aware delegation"}]},{"id":"blk-9149","kind":"code","language":"text","text":"task_request\n|> &govern.identity.resolve(candidate_agent)\n|> check_trust_score()\n|> delegate_if_trusted()"},{"id":"blk-9150","kind":"paragraph","spans":[{"id":"spn-8808","text":"Use this when:"}]},{"id":"blk-9151","items":[{"blocks":[{"id":"blk-9153","kind":"paragraph","spans":[{"id":"spn-8809","text":"a task needs to be delegated to another agent and the trust score should inform the delegation decision"}]}],"id":"blk-9152","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9154","kind":"heading","level":2,"spans":[{"id":"spn-8810","text":"10. Example declaration"}]},{"id":"blk-9155","kind":"paragraph","spans":[{"id":"spn-8811","text":"A concrete "},{"id":"spn-8812","marks":["code"],"text":"ampersand.json"},{"id":"spn-8813","text":" fragment:"}]},{"id":"blk-9156","kind":"code","language":"json","text":"{\n  \"&govern.identity\": {\n    \"provider\": \"opensentience\",\n    \"config\": {\n      \"registry\": \"fleetprompt\",\n      \"verify_on_a2a\": true\n    }\n  }\n}"},{"id":"blk-9157","kind":"paragraph","spans":[{"id":"spn-8814","text":"A fuller declaration:"}]},{"id":"blk-9158","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"DataAnalyst\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {\n        \"mode\": \"continual-learning\"\n      }\n    },\n    \"&reason.plan\": {\n      \"provider\": \"auto\",\n      \"need\": \"data analysis planning with policy-aware access controls\"\n    },\n    \"&govern.identity\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"registry\": \"fleetprompt\",\n        \"verify_on_a2a\": true\n      }\n    },\n    \"&govern.escalation\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"timeout_seconds\": 1800\n      }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\n      \"Never access data outside the agent's authorized scope\",\n      \"Always verify collaborating agent identity before sharing results\"\n    ],\n    \"soft\": [\n      \"Prefer agents with trust_score above 0.8 for delegation\"\n    ],\n    \"escalate_when\": {\n      \"confidence_below\": 0.7,\n      \"collaborator_trust_below\": 0.6\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-9159","kind":"heading","level":2,"spans":[{"id":"spn-8815","text":"11. Governance and provenance implications"}]},{"id":"blk-9160","kind":"paragraph","spans":[{"id":"spn-8816","text":"Agent identity is foundational to the entire governance stack. Every other governance capability depends on knowing who the agent is."}]},{"id":"blk-9161","kind":"heading","level":3,"spans":[{"id":"spn-8817","text":"Cross-references"}]},{"id":"blk-9162","items":[{"blocks":[{"id":"blk-9164","kind":"paragraph","spans":[{"id":"spn-8818","marks":["bold"],"text":"OpenSentience OS-006"},{"id":"spn-8819","text":": defines autonomy levels that are part of the identity governance summary"}]}],"id":"blk-9163","kind":"list-item"},{"blocks":[{"id":"blk-9166","kind":"paragraph","spans":[{"id":"spn-8820","marks":["bold"],"text":"OpenSentience OS-007"},{"id":"spn-8821","text":": identifies agent impersonation as a critical threat — "},{"id":"spn-8822","marks":["code"],"text":"&govern.identity"},{"id":"spn-8823","text":" is the primary defense against this threat"}]}],"id":"blk-9165","kind":"list-item"},{"blocks":[{"id":"blk-9168","kind":"paragraph","spans":[{"id":"spn-8824","marks":["bold"],"text":"Delegatic org policies"},{"id":"spn-8825","text":": org_id in the identity record links the agent to Delegatic budget and governance constraints"}]}],"id":"blk-9167","kind":"list-item"},{"blocks":[{"id":"blk-9170","kind":"paragraph","spans":[{"id":"spn-8826","marks":["bold"],"text":"FleetPrompt trust scores"},{"id":"spn-8827","text":": publisher_id and trust_score connect the agent to FleetPrompt's trust computation system"}]}],"id":"blk-9169","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9171","kind":"heading","level":3,"spans":[{"id":"spn-8828","text":"Representative provenance record"}]},{"id":"blk-9172","kind":"code","language":"json","text":"{\n  \"source\": \"&govern.identity\",\n  \"provider\": \"opensentience\",\n  \"operation\": \"verify\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"agent_id\": \"agt-01JQ7...\",\n  \"manifest_hash\": \"sha256:ab3f...\",\n  \"verification_result\": \"verified\",\n  \"trust_score\": 0.91,\n  \"mcp_trace_id\": \"os-id-422\"\n}"},{"id":"blk-9173","kind":"paragraph","spans":[{"id":"spn-8829","text":"Provenance should help answer questions like:"}]},{"id":"blk-9174","items":[{"blocks":[{"id":"blk-9176","kind":"paragraph","spans":[{"id":"spn-8830","text":"Which agent produced this output?"}]}],"id":"blk-9175","kind":"list-item"},{"blocks":[{"id":"blk-9178","kind":"paragraph","spans":[{"id":"spn-8831","text":"Was the agent's identity verified at the time of the operation?"}]}],"id":"blk-9177","kind":"list-item"},{"blocks":[{"id":"blk-9180","kind":"paragraph","spans":[{"id":"spn-8832","text":"What was the agent's trust score when it was delegated this task?"}]}],"id":"blk-9179","kind":"list-item"},{"blocks":[{"id":"blk-9182","kind":"paragraph","spans":[{"id":"spn-8833","text":"Has the agent's manifest changed since this operation was recorded?"}]}],"id":"blk-9181","kind":"list-item"},{"blocks":[{"id":"blk-9184","kind":"paragraph","spans":[{"id":"spn-8834","text":"Which organization was the agent registered under?"}]}],"id":"blk-9183","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9185","kind":"heading","level":2,"spans":[{"id":"spn-8835","text":"12. Compatible providers"}]},{"id":"blk-9186","kind":"paragraph","spans":[{"id":"spn-8836","text":"Representative compatible providers include:"}]},{"id":"blk-9187","items":[{"blocks":[{"id":"blk-9189","kind":"paragraph","spans":[{"id":"spn-8837","marks":["code"],"text":"opensentience"},{"id":"spn-8838","text":" (primary runtime verification provider)"}]}],"id":"blk-9188","kind":"list-item"},{"blocks":[{"id":"blk-9191","kind":"paragraph","spans":[{"id":"spn-8839","marks":["code"],"text":"fleetprompt"},{"id":"spn-8840","text":" (registry and trust score computation)"}]}],"id":"blk-9190","kind":"list-item"},{"blocks":[{"id":"blk-9193","kind":"paragraph","spans":[{"id":"spn-8841","text":"custom identity and authentication services exposed behind MCP-compatible surfaces"}]}],"id":"blk-9192","kind":"list-item"},{"blocks":[{"id":"blk-9195","kind":"paragraph","spans":[{"id":"spn-8842","text":"enterprise agent directory systems with structured manifest verification"}]}],"id":"blk-9194","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9196","kind":"heading","level":3,"spans":[{"id":"spn-8843","text":"Default ecosystem fit"}]},{"id":"blk-9197","kind":"paragraph","spans":[{"id":"spn-8844","text":"The most natural default ecosystem pairing is:"}]},{"id":"blk-9198","items":[{"blocks":[{"id":"blk-9200","kind":"paragraph","spans":[{"id":"spn-8845","marks":["code"],"text":"opensentience"},{"id":"spn-8846","text":" for runtime identity verification"}]}],"id":"blk-9199","kind":"list-item"},{"blocks":[{"id":"blk-9202","kind":"paragraph","spans":[{"id":"spn-8847","marks":["code"],"text":"fleetprompt"},{"id":"spn-8848","text":" for the agent registry and trust scoring"}]}],"id":"blk-9201","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9203","kind":"paragraph","spans":[{"id":"spn-8849","text":"Why they fit together:"}]},{"id":"blk-9204","items":[{"blocks":[{"id":"blk-9206","kind":"paragraph","spans":[{"id":"spn-8850","text":"OpenSentience provides the verification runtime that checks claims against registered manifests"}]}],"id":"blk-9205","kind":"list-item"},{"blocks":[{"id":"blk-9208","kind":"paragraph","spans":[{"id":"spn-8851","text":"FleetPrompt maintains the registry and computes trust scores from agent history and attestations"}]}],"id":"blk-9207","kind":"list-item"},{"blocks":[{"id":"blk-9210","kind":"paragraph","spans":[{"id":"spn-8852","text":"Together they form the complete identity and trust stack"}]}],"id":"blk-9209","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9211","kind":"paragraph","spans":[{"id":"spn-8853","text":"The protocol stance remains:"}]},{"blocks":[{"id":"blk-9213","kind":"paragraph","spans":[{"id":"spn-8854","marks":["code"],"text":"&govern.identity"},{"id":"spn-8855","text":" is the capability. "},{"id":"spn-8856","marks":["code"],"text":"opensentience"},{"id":"spn-8857","text":" and "},{"id":"spn-8858","marks":["code"],"text":"fleetprompt"},{"id":"spn-8859","text":" are providers that may satisfy it."}]}],"id":"blk-9212","kind":"quote"},{"id":"blk-9214","kind":"heading","level":2,"spans":[{"id":"spn-8860","text":"13. A2A-facing skills"}]},{"id":"blk-9215","kind":"paragraph","spans":[{"id":"spn-8861","text":"A "},{"id":"spn-8862","marks":["code"],"text":"&govern.identity"},{"id":"spn-8863","text":" capability may advertise skills such as:"}]},{"id":"blk-9216","items":[{"blocks":[{"id":"blk-9218","kind":"paragraph","spans":[{"id":"spn-8864","marks":["code"],"text":"agent-identity-verification"}]}],"id":"blk-9217","kind":"list-item"},{"blocks":[{"id":"blk-9220","kind":"paragraph","spans":[{"id":"spn-8865","marks":["code"],"text":"manifest-attestation"}]}],"id":"blk-9219","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9221","kind":"paragraph","spans":[{"id":"spn-8866","text":"These are useful when generating A2A-style agent cards, because they let an external coordination surface say more than \"has identity support.\""}]},{"id":"blk-9222","kind":"paragraph","spans":[{"id":"spn-8867","text":"Instead, it can say the agent can:"}]},{"id":"blk-9223","items":[{"blocks":[{"id":"blk-9225","kind":"paragraph","spans":[{"id":"spn-8868","text":"verify other agents' identities before collaboration"}]}],"id":"blk-9224","kind":"list-item"},{"blocks":[{"id":"blk-9227","kind":"paragraph","spans":[{"id":"spn-8869","text":"attest its own manifest for mutual trust establishment"}]}],"id":"blk-9226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9228","kind":"heading","level":2,"spans":[{"id":"spn-8870","text":"14. Anti-patterns"}]},{"id":"blk-9229","kind":"heading","level":3,"spans":[{"id":"spn-8871","text":"Anti-pattern 1: assume trust without verification"}]},{"id":"blk-9230","kind":"paragraph","spans":[{"id":"spn-8872","text":"In multi-agent systems, implicit trust is a security vulnerability. Always verify identity before accepting delegated tasks or sharing results. OS-007 documents the agent impersonation threat this prevents."}]},{"id":"blk-9231","kind":"heading","level":3,"spans":[{"id":"spn-8873","text":"Anti-pattern 2: bind identity to a single runtime"}]},{"id":"blk-9232","kind":"paragraph","spans":[{"id":"spn-8874","text":"Agent identity should be portable across runtimes and deployments. Tying identity to a specific runtime creates fragile trust relationships that break during migration."}]},{"id":"blk-9233","kind":"heading","level":3,"spans":[{"id":"spn-8875","text":"Anti-pattern 3: skip manifest hashing"}]},{"id":"blk-9234","kind":"paragraph","spans":[{"id":"spn-8876","text":"The manifest hash is the integrity anchor. Without it, there is no way to detect if an agent's declaration has been modified after registration."}]},{"id":"blk-9235","kind":"heading","level":3,"spans":[{"id":"spn-8877","text":"Anti-pattern 4: ignore trust scores in delegation"}]},{"id":"blk-9236","kind":"paragraph","spans":[{"id":"spn-8878","text":"Trust scores exist to inform delegation decisions. Delegating sensitive tasks to agents with low or missing trust scores undermines the purpose of the identity system."}]},{"id":"blk-9237","kind":"heading","level":3,"spans":[{"id":"spn-8879","text":"Anti-pattern 5: register once and never update"}]},{"id":"blk-9238","kind":"paragraph","spans":[{"id":"spn-8880","text":"Agent capabilities and governance policies evolve. Stale identity records create a gap between what the registry says and what the agent actually does."}]},{"id":"blk-9239","kind":"heading","level":2,"spans":[{"id":"spn-8881","text":"15. Summary"}]},{"id":"blk-9240","kind":"paragraph","spans":[{"id":"spn-8882","marks":["code"],"text":"&govern.identity"},{"id":"spn-8883","text":" is the [&] Protocol capability for "},{"id":"spn-8884","marks":["bold"],"text":"cross-runtime agent identity and trust verification"},{"id":"spn-8885","text":"."}]},{"id":"blk-9241","kind":"paragraph","spans":[{"id":"spn-8886","text":"It is the right capability when a system needs to:"}]},{"id":"blk-9242","items":[{"blocks":[{"id":"blk-9244","kind":"paragraph","spans":[{"id":"spn-8887","text":"establish verifiable agent identity that persists across runtimes"}]}],"id":"blk-9243","kind":"list-item"},{"blocks":[{"id":"blk-9246","kind":"paragraph","spans":[{"id":"spn-8888","text":"verify that agents are who they claim to be before collaboration"}]}],"id":"blk-9245","kind":"list-item"},{"blocks":[{"id":"blk-9248","kind":"paragraph","spans":[{"id":"spn-8889","text":"link agents to organizations, publishers, and governance policies"}]}],"id":"blk-9247","kind":"list-item"},{"blocks":[{"id":"blk-9250","kind":"paragraph","spans":[{"id":"spn-8890","text":"carry trust metadata that informs delegation and escalation decisions"}]}],"id":"blk-9249","kind":"list-item"},{"blocks":[{"id":"blk-9252","kind":"paragraph","spans":[{"id":"spn-8891","text":"maintain an auditable registry of all agent identities"}]}],"id":"blk-9251","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-9253","kind":"paragraph","spans":[{"id":"spn-8892","text":"In one sentence:"}]},{"blocks":[{"id":"blk-9255","kind":"paragraph","spans":[{"id":"spn-8893","marks":["code"],"text":"&govern.identity"},{"id":"spn-8894","text":" gives agents a protocol-native way to prove who they are and verify who they are working with."}]}],"id":"blk-9254","kind":"quote"}],"edges":[],"id":"bagaaieraeksqsifx7mmpt26vwasjxhatuwwb7b6v2e3j3eb3glm6lw6fzaua","vocabulary":"ampersand.docs.fs.v1"}