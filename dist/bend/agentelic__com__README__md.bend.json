{"bendscript":"0.1","blocks":[{"id":"blk-50969","kind":"heading","level":1,"spans":[{"id":"spn-98644","text":"Agentelic"}]},{"id":"blk-50970","kind":"paragraph","spans":[{"id":"spn-98645","text":"Spec-driven agent builder — you write the specification, it generates and runs the agent. Elixir/OTP with a Phoenix API and an MCP server. Part of the "},{"id":"spn-98646","marks":[{"kind":"link","predicate":"cites","target":"https://computedriven.com"}],"text":"ComputeDriven"},{"id":"spn-98647","text":" world."}]},{"id":"blk-50971","kind":"paragraph","spans":[{"id":"spn-98648","marks":["bold"],"text":"Written 2026-08-16."},{"id":"spn-98649","text":" This repository had no README before that date. Every figure below was measured that day with the command beside it."}]},{"id":"blk-50972","kind":"heading","level":2,"spans":[{"id":"spn-98650","text":"Status, honestly"}]},{"head":[{"id":"blk-50974","spans":[{"id":"spn-98651","text":""}]},{"id":"blk-50975","spans":[{"id":"spn-98652","text":""}]}],"id":"blk-50973","kind":"table","rows":[[{"id":"blk-50976","spans":[{"id":"spn-98653","text":"Version"}]},{"id":"blk-50977","spans":[{"id":"spn-98654","marks":["code"],"text":"0.1.0"},{"id":"spn-98655","text":" ("},{"id":"spn-98656","marks":["code"],"text":"mix.exs"},{"id":"spn-98657","text":", app "},{"id":"spn-98658","marks":["code"],"text":":agentelic"},{"id":"spn-98659","text":")"}]}],[{"id":"blk-50978","spans":[{"id":"spn-98660","text":"Tests"}]},{"id":"blk-50979","spans":[{"id":"spn-98661","marks":["bold"],"text":"66 passing, 0 failures"},{"id":"spn-98662","text":" — "},{"id":"spn-98663","marks":["code"],"text":"mix test"}]}],[{"id":"blk-50980","spans":[{"id":"spn-98664","text":"Marketing page"}]},{"id":"blk-50981","spans":[{"id":"spn-98665","marks":["bold"],"text":"live"},{"id":"spn-98666","text":" — "},{"id":"spn-98667","marks":["code"],"text":"https://agentelic.com"},{"id":"spn-98668","text":" answers 200"}]}],[{"id":"blk-50982","spans":[{"id":"spn-98669","text":"Application"}]},{"id":"blk-50983","spans":[{"id":"spn-98670","marks":["bold"],"text":"live on Fly"},{"id":"spn-98671","text":" as app "},{"id":"spn-98672","marks":["code"],"text":"agentelic"},{"id":"spn-98673","text":", "},{"id":"spn-98674","marks":["code"],"text":"PHX_HOST=app.agentelic.com"},{"id":"spn-98675","text":", region "},{"id":"spn-98676","marks":["code"],"text":"iad"}]}],[{"id":"blk-50984","spans":[{"id":"spn-98677","text":"Evidence rung"}]},{"id":"blk-50985","spans":[{"id":"spn-98678","marks":["code"],"text":"live_deployed"}]}]]},{"id":"blk-50986","kind":"paragraph","spans":[{"id":"spn-98679","marks":["bold"],"text":"`GET https://app.agentelic.com/` returns 404, and that is the app answering, not the app being down."},{"id":"spn-98680","text":" The body is "},{"id":"spn-98681","marks":["code"],"text":"{\"errors\":{\"detail\":\"Not Found\"}}"},{"id":"spn-98682","text":" — Phoenix, routing correctly. "},{"id":"spn-98683","marks":["code"],"text":"lib/agentelic_web/router.ex"},{"id":"spn-98684","text":" declares "},{"id":"spn-98685","marks":["bold"],"text":"POST routes only"},{"id":"spn-98686","text":", so every GET 404s by design. The check that actually tells you it is up:"}]},{"id":"blk-50987","kind":"code","language":"bash","text":"curl -s -o /dev/null -w '%{http_code}\\n' -X POST \\\n  -H 'content-type: application/json' \\\n  -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' \\\n  https://app.agentelic.com/mcp        # -> 200"},{"id":"blk-50988","kind":"paragraph","spans":[{"id":"spn-98687","text":"This is written down because a 404 on the root of a deployed service is exactly the shape of evidence that gets misread as a dead deployment."}]},{"id":"blk-50989","kind":"heading","level":2,"spans":[{"id":"spn-98688","text":"Routes"}]},{"id":"blk-50990","kind":"code","language":"text","text":"POST /mcp                      MCP server — tools/list, tools/call\nPOST /api/pipeline/trigger     run a pipeline\nPOST /api/pipeline/github      GitHub webhook"},{"id":"blk-50991","kind":"heading","level":2,"spans":[{"id":"spn-98689","text":"Quick start"}]},{"id":"blk-50992","kind":"code","language":"bash","text":"mix deps.get\nmix compile --warnings-as-errors\nmix test                       # 66 tests\nmix format --check-formatted\nmix phx.server                 # local, port from config"},{"id":"blk-50993","kind":"paragraph","spans":[{"id":"spn-98690","text":"Deploy is "},{"id":"spn-98691","marks":["code"],"text":"fly deploy"},{"id":"spn-98692","text":" against "},{"id":"spn-98693","marks":["code"],"text":"fly.toml"},{"id":"spn-98694","text":" (app "},{"id":"spn-98695","marks":["code"],"text":"agentelic"},{"id":"spn-98696","text":", "},{"id":"spn-98697","marks":["code"],"text":"iad"},{"id":"spn-98698","text":", internal port 8080, "},{"id":"spn-98699","marks":["code"],"text":"force_https"},{"id":"spn-98700","text":")."}]},{"id":"blk-50994","kind":"heading","level":2,"spans":[{"id":"spn-98701","text":"The specification is authoritative, and superseded in part"}]},{"id":"blk-50995","kind":"paragraph","spans":[{"id":"spn-98702","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-98703","text":" is the product specification and drives implementation — "},{"id":"spn-98704","marks":["bold"],"text":"read it before changing behaviour."},{"id":"spn-98705","text":" It carries a supersession banner added 2026-08-15, and the banner is the important part:"}]},{"id":"blk-50996","items":[{"blocks":[{"id":"blk-50998","kind":"paragraph","spans":[{"id":"spn-98706","marks":["bold"],"text":"Superseded:"},{"id":"spn-98707","text":" everything specifying Supabase tables, RLS policies, Supabase"}]}],"id":"blk-50997","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50999","kind":"paragraph","spans":[{"id":"spn-98708","text":"Auth or "},{"id":"spn-98709","marks":["code"],"text":"amp.profiles"},{"id":"spn-98710","text":" identity. The shared-Supabase data layer was abandoned by ruling on "},{"id":"spn-98711","marks":["bold"],"text":"2026-07-30"},{"id":"spn-98712","text":", replaced by "},{"id":"spn-98713","marks":["code"],"text":"studbook"},{"id":"spn-98714","text":" — which is a spec with no implementation and is blocked on an unruled confidentiality question. "},{"id":"spn-98715","marks":["bold"],"text":"Do not build against studbook yet."}]},{"id":"blk-51000","items":[{"blocks":[{"id":"blk-51002","kind":"paragraph","spans":[{"id":"spn-98716","marks":["bold"],"text":"Not superseded:"},{"id":"spn-98717","text":" the product, API, UX and protocol design, which is most of"}]}],"id":"blk-51001","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51003","kind":"paragraph","spans":[{"id":"spn-98718","text":"the document. Read it normally."}]},{"id":"blk-51004","kind":"paragraph","spans":[{"id":"spn-98719","text":"The spec was "},{"id":"spn-98720","marks":["bold"],"text":"not rewritten"},{"id":"spn-98721","text":", deliberately. It is a dated design record, and rewriting it would fabricate a review nobody performed."}]},{"id":"blk-51005","kind":"heading","level":2,"spans":[{"id":"spn-98722","text":"A standing direction that affects this repository"}]},{"id":"blk-51006","kind":"paragraph","spans":[{"id":"spn-98723","text":"Ruled 2026-08-15: "},{"id":"spn-98724","marks":["bold"],"text":"compute moves into the ComputeDriven OS, and the Fly.io apps become storage or nothing."},{"id":"spn-98725","text":" This app is one of them. It is not being torn down — "},{"id":"spn-98726","marks":["bold"],"text":"nothing is torn down before its OS-side replacement runs locally"},{"id":"spn-98727","text":" — but do not plan new Fly-shaped work here without checking "},{"id":"spn-98728","marks":["code"],"text":"STACK_HUB.md"},{"id":"spn-98729","text":" in the workspace first."}]},{"id":"blk-51007","kind":"heading","level":2,"spans":[{"id":"spn-98730","text":"The portfolio nav"}]},{"id":"blk-51008","kind":"paragraph","spans":[{"id":"spn-98731","marks":["code"],"text":"amp-nav.js"},{"id":"spn-98732","text":" is a "},{"id":"spn-98733","marks":["bold"],"text":"deployed copy"},{"id":"spn-98734","text":". The source is "},{"id":"spn-98735","marks":["code"],"text":"ampersand-nav/src/amp-nav.js"},{"id":"spn-98736","text":", fanned out by "},{"id":"spn-98737","marks":["code"],"text":"sync-nav.sh"},{"id":"spn-98738","text":". Edits here are lost on the next sync."}]},{"id":"blk-51009","kind":"heading","level":2,"spans":[{"id":"spn-98739","text":"Conventions"}]},{"id":"blk-51010","items":[{"blocks":[{"id":"blk-51012","kind":"paragraph","spans":[{"id":"spn-98740","marks":["code"],"text":"mix format"},{"id":"spn-98741","text":", warnings-as-errors."}]}],"id":"blk-51011","kind":"list-item"},{"blocks":[{"id":"blk-51014","kind":"paragraph","spans":[{"id":"spn-98742","text":"Never commit secrets."}]}],"id":"blk-51013","kind":"list-item"},{"blocks":[{"id":"blk-51016","kind":"paragraph","spans":[{"id":"spn-98743","marks":["code"],"text":"old_scrap/"},{"id":"spn-98744","text":" is historical and not authoritative."}]}],"id":"blk-51015","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51017","kind":"heading","level":2,"spans":[{"id":"spn-98745","text":"Related"}]},{"id":"blk-51018","items":[{"blocks":[{"id":"blk-51020","kind":"paragraph","spans":[{"id":"spn-98746","marks":[{"kind":"link","predicate":"cites","target":"https://computedriven.com"}],"text":"computedriven.com"},{"id":"spn-98747","text":" — the discipline this is built under"}]}],"id":"blk-51019","kind":"list-item"},{"blocks":[{"id":"blk-51022","kind":"paragraph","spans":[{"id":"spn-98748","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"ampersandboxdesign.com"},{"id":"spn-98749","text":" — the [&] Protocol it composes under"}]}],"id":"blk-51021","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraj3if2ucfobh5ybb4kb5a557uqkbqbeyxfsecyxllvmomtrwwivka","vocabulary":"ampersand.docs.fs.v1"}