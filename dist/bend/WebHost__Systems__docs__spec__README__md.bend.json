spn-79360","text":" (gated runtime requested) to "},{"id":"spn-79361","marks":["code"],"text":"delegatic.governance.learn_drift"}]}],"id":"blk-50710","kind":"list-item"},{"blocks":[{"id":"blk-50713","kind":"paragraph","spans":[{"id":"spn-79362","marks":["code"],"text":"deploy_to_fleetprompt"},{"id":"spn-79363","text":" — optional "},{"id":"spn-79364","marks":["code"],"text":"ConsolidationEvent"},{"id":"spn-79365","text":" from "},{"id":"spn-79366","marks":["code"],"text":"consolidate_billing"},{"id":"spn-79367","text":" to "},{"id":"spn-79368","marks":["code"],"text":"fleetprompt.publish"},{"id":"spn-79369","text":" for usage-based trust signals"}]}],"id":"blk-50712","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50714","kind":"paragraph","spans":[{"id":"spn-79370","marks":["bold"],"text":"Why this matters:"},{"id":"spn-79371","text":" WebHost.Systems is the only loop in the portfolio with "},{"id":"spn-79372","marks":["bold"],"text":"multiple swappable runtime providers"},{"id":"spn-79373","text":" in its "},{"id":"spn-79374","marks":["code"],"text":"act"},{"id":"spn-79375","text":" phase. PULSE's "},{"id":"spn-79376","marks":["code"],"text":"phase"},{"id":"spn-79377","text":" schema allows the runtime to be opaque (declared via "},{"id":"spn-79378","marks":["code"],"text":"signature"},{"id":"spn-79379","text":" and "},{"id":"spn-79380","marks":["code"],"text":"policy_check"},{"id":"spn-79381","text":" fields) — the manifest stays stable even as the RPI gains new adapters. This is the pattern other loops should follow when their "},{"id":"spn-79382","marks":["code"],"text":"act"},{"id":"spn-79383","text":" phase depends on third-party infrastructure."}]},{"id":"blk-50715","kind":"paragraph","spans":[{"id":"spn-79384","text":"See "},{"id":"spn-79385","marks":["code"],"text":"OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-79386","text":" in "},{"id":"spn-79387","marks":["code"],"text":"/home/travis/ProjectAmp2/opensentience.org/docs/spec/"},{"id":"spn-79388","text":" for the full PULSE protocol spec."}]}],"edges":[],"id":"bagaaieraexblamhgsvyv7jculhpdnh7koiiucwzssedpuddcnmzcioz5zyua","vocabulary":"ampersand.docs.fs.v1"}