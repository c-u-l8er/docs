tion/aggregation, UI API."}]}],"id":"blk-50615","kind":"list-item"},{"blocks":[{"id":"blk-50618","kind":"paragraph","spans":[{"id":"spn-79205","marks":["bold"],"text":"Data plane"},{"id":"spn-79206","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-50617","kind":"list-item"},{"blocks":[{"id":"blk-50620","kind":"paragraph","spans":[{"id":"spn-79207","marks":["bold"],"text":"Session IDs"},{"id":"spn-79208","text":" are "},{"id":"spn-79209","marks":["bold"],"text":"opaque"},{"id":"spn-79210","text":" and runtime-specific; the control plane and clients must not parse them."}]}],"id":"blk-50619","kind":"list-item"},{"blocks":[{"id":"blk-50622","kind":"paragraph","spans":[{"id":"spn-79211","marks":["bold"],"text":"Deployments"},{"id":"spn-79212","text":" are "},{"id":"spn-79213","marks":["bold"],"text":"immutable"},{"id":"spn-79214","text":" records; routing is via the agent’s single "},{"id":"spn-79215","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-79216","text":"."}]}],"id":"blk-50621","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50623","kind":"heading","level":2,"spans":[{"id":"spn-79217","text":"Implementation “starter checklist” (quick reference)"}]},{"id":"blk-50624","kind":"paragraph","spans":[{"id":"spn-79218","text":"Minimum v1 must-haves:"}]},{"id":"blk-50625","items":[{"blocks":[{"id":"blk-50627","kind":"paragraph","spans":[{"id":"spn-79219","text":"Auth + tenant isolation across all endpoints."}]}],"id":"blk-50626","kind":"list-item"},{"blocks":[{"id":"blk-50629","kind":"paragraph","spans":[{"id":"spn-79220","text":"Agent CRUD."}]}],"id":"blk-50628","kind":"list-item"},{"blocks":[{"id":"blk-50631","kind":"paragraph","spans":[{"id":"spn-79221","text":"Immutable deployments + rollback (active pointer)."}]}],"id":"blk-50630","kind":"list-item"},{"blocks":[{"id":"blk-50633","kind":"paragraph","spans":[{"id":"spn-79222","text":"Invocation gateway with consistent "},{"id":"spn-79223","marks":["code"],"text":"invoke/v1"},{"id":"spn-79224","text":" contract (non-streaming required; streaming recommended)."}]}],"id":"blk-50632","kind":"list-item"},{"blocks":[{"id":"blk-50635","kind":"paragraph","spans":[{"id":"spn-79225","text":"Telemetry ingestion with integrity protection (deployment-scoped signing) and ownership cross-check."}]}],"id":"blk-50634","kind":"list-item"},{"blocks":[{"id":"blk-50637","kind":"paragraph","spans":[{"id":"spn-79226","text":"Usage aggregation by billing period + dashboard usage views."}]}],"id":"blk-50636","kind":"list-item"},{"blocks":[{"id":"blk-50639","kind":"paragraph","spans":[{"id":"spn-79227","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-50638","kind":"list-item"},{"blocks":[{"id":"blk-50641","kind":"paragraph","spans":[{"id":"spn-79228","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-50640","kind":"list-item"},{"blocks":[{"id":"blk-50643","kind":"paragraph","spans":[{"id":"spn-79229","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-50642","kind":"list-item"},{"blocks":[{"id":"blk-50645","kind":"paragraph","spans":[{"id":"spn-79230","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-50644","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50646","kind":"heading","level":2,"spans":[{"id":"spn-79231","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-50647","items":[{"blocks":[{"id":"blk-50649","kind":"paragraph","spans":[{"id":"spn-79232","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-50648","kind":"list-item"},{"blocks":[{"id":"blk-50651","kind":"paragraph","spans":[{"id":"spn-79233","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-50650","kind":"list-item"},{"blocks":[{"