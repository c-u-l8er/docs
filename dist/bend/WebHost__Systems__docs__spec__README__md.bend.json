t":" — Supabase as control-plane backend (supersedes original Convex choice); Edge Functions for server-only logic."}]}],"id":"blk-31695","kind":"list-item"},{"blocks":[{"id":"blk-31698","kind":"paragraph","spans":[{"id":"spn-36385","marks":["code"],"text":"adr/ADR-0003-secrets-strategy.md"},{"id":"spn-36386","text":" — No plaintext secrets in DB; provider-native secret injection; write-only secrets API."}]}],"id":"blk-31697","kind":"list-item"},{"blocks":[{"id":"blk-31700","kind":"paragraph","spans":[{"id":"spn-36387","marks":["code"],"text":"adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-36388","text":" — Deployment-scoped signed telemetry events + ownership cross-check."}]}],"id":"blk-31699","kind":"list-item"},{"blocks":[{"id":"blk-31702","kind":"paragraph","spans":[{"id":"spn-36389","marks":["code"],"text":"adr/ADR-0005-deployment-immutability.md"},{"id":"spn-36390","text":" — Immutable deployment records + "},{"id":"spn-36391","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-36392","text":" routing pointer + rollback."}]}],"id":"blk-31701","kind":"list-item"},{"blocks":[{"id":"blk-31704","kind":"paragraph","spans":[{"id":"spn-36393","marks":["code"],"text":"adr/ADR-0006-invocation-protocol.md"},{"id":"spn-36394","text":" — Canonical "},{"id":"spn-36395","marks":["code"],"text":"invoke/v1"},{"id":"spn-36396","text":" protocol, session semantics, and SSE streaming model."}]}],"id":"blk-31703","kind":"list-item"},{"blocks":[{"id":"blk-31706","kind":"paragraph","spans":[{"id":"spn-36397","marks":["code"],"text":"adr/ADR-0007-entitlements-and-limits.md"},{"id":"spn-36398","text":" — Tier entitlements, runtime gating, and limit enforcement strategy."}]}],"id":"blk-31705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31707","kind":"heading","level":2,"spans":[{"id":"spn-36399","text":"Progress logs"}]},{"id":"blk-31708","kind":"paragraph","spans":[{"id":"spn-36400","text":"Daily implementation progress logs live in "},{"id":"spn-36401","marks":["code"],"text":"../progress/"},{"id":"spn-36402","text":" (relative to this folder). These logs are "},{"id":"spn-36403","marks":["bold"],"text":"non-normative"},{"id":"spn-36404","text":" and exist to track execution against this spec."}]},{"id":"blk-31709","kind":"paragraph","spans":[{"id":"spn-36405","text":"Recommended convention:"}]},{"id":"blk-31710","items":[{"blocks":[{"id":"blk-31712","kind":"paragraph","spans":[{"id":"spn-36406","text":"One file per day: "},{"id":"spn-36407","marks":["code"],"text":"YYYY-MM-DD.md"}]}],"id":"blk-31711","kind":"list-item"},{"blocks":[{"id":"blk-31714","kind":"paragraph","spans":[{"id":"spn-36408","text":"Include: what shipped, what changed, decisions made (with links to ADRs/spec sections), and next steps."}]}],"id":"blk-31713","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31715","kind":"heading","level":2,"spans":[{"id":"spn-36409","text":"Normative conventions used in this spec"}]},{"id":"blk-31716","items":[{"blocks":[{"id":"blk-31718","kind":"paragraph","spans":[{"id":"spn-36410","marks":["bold"],"text":"MUST / MUST NOT / SHOULD / MAY"},{"id":"spn-36411","text":" are used intentionally."}]}],"id":"blk-31717","kind":"list-item"},{"blocks":[{"id":"blk-31720","kind":"paragraph","spans":[{"id":"spn-36412","marks":["bold"],"text":"Control plane"},{"id":"spn-36413","text":" = auth, DB, deploy orchestration, billing, telemetry ingestion/aggregation, UI API."}]}],"id":"blk-31719","kind":"list-item"},{"blocks":[{"id":"blk-31722","kind":"paragraph","spans":[{"id":"spn-36414","marks":["bold"],"text":"Data plane"},{"id":"spn-36415","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-31721","kind":"list-item"},{"blocks":[{"id":"blk-31724","kind":"paragraph","spans":[{"id":"spn-36416","marks":["bold"],"text":"Session IDs"},{"id":"spn-36417","text":" are "},{"id":"spn-36418","marks":["bold"],"text":"opaque"},{"id":"spn-36419","text":" and runtime-specific; the control plane and clients must not parse them."}]}],"id":"blk-31723","kind":"list-item"},{"blocks":[{"id":"blk-31726","kind":"paragraph","spans":[{"id":"spn-36420","marks":["bold"],"text":"Deployments"},{"id":"spn-36421","text":" are "},{"id":"spn-36422","marks":["bold"],"text":"immutable"},{"id":"spn-36423","text":" records; routing is via the agent’s single "},{"id":"spn-36424","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-36425","text":"."}]}],"id":"blk-31725","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31727","kind":"heading","level":2,"spans":[{"id":"spn-36426","text":"Implementation “starter checklist” (quick reference)"}]},{"id":"blk-31728","kind":"paragraph","spans":[{"id":"spn-36427","text":"Minimum v1 must-haves:"}]},{"id":"blk-31729","items":[{"blocks":[{"id":"blk-31731","kind":"paragraph","spans":[{"id":"spn-36428","text":"Auth + tenant isolation across all endpoints."}]}],"id":"blk-31730","kind":"list-item"},{"blocks":[{"id":"blk-31733","kind":"paragraph","spans":[{"id":"spn-36429","text":"Agent CRUD."}]}],"id":"blk-31732","kind":"list-item"},{"blocks":[{"id":"blk-31735","kind":"paragraph","spans":[{"id":"spn-36430","text":"Immutable deployments + rollback (active pointer)."}]}],"id":"blk-31734","kind":"list-item"},{"blocks":[{"id":"blk-31737","kind":"paragraph","spans":[{"id":"spn-36431","text":"Invocation gateway with consistent "},{"id":"spn-36432","marks":["code"],"text":"invoke/v1"},{"id":"spn-36433","text":" contract (non-streaming required; streaming recommended)."}]}],"id":"blk-31736","kind":"list-item"},{"blocks":[{"id":"blk-31739","kind":"paragraph","spans":[{"id":"spn-36434","text":"Telemetry ingestion with integrity protection (deployment-scoped signing) and ownership cross-check."}]}],"id":"blk-31738","kind":"list-item"},{"blocks":[{"id":"blk-31741","kind":"paragraph","spans":[{"id":"spn-36435","text":"Usage aggregation by billing period + dashboard usage views."}]}],"id":"blk-31740","kind":"list-item"},{"blocks":[{"id":"blk-31743","kind":"paragraph","spans":[{"id":"spn-36436","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-31742","kind":"list-item"},{"blocks":[{"id":"blk-31745","kind":"paragraph","spans":[{"id":"spn-36437","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-31744","kind":"list-item"},{"blocks":[{"id":"blk-31747","kind":"paragraph","spans":[{"id":"spn-36438","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-31746","kind":"list-item"},{"blocks":[{"id":"blk-31749","kind":"paragraph","spans":[{"id":"spn-36439","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-31748","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31750","kind":"heading","level":2,"spans":[{"id":"spn-36440","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-31751","items":[{"blocks":[{"id":"blk-31753","kind":"paragraph","spans":[{"id":"spn-36441","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-31752","kind":"list-item"},{"blocks":[{"id":"blk-31755","kind":"paragraph","spans":[{"id":"spn-36442","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-31754","kind":"list-item"},{"blocks":[{"id":"blk-31757","kind":"paragraph","spans":[{"id":"spn-36443","text":"Public agents / unauthenticated invocation (unless explicitly added later with API keys)."}]}],"id":"blk-31756","kind":"list-item"},{"blocks":[{"id":"blk-31759","kind":"paragraph","spans":[{"id":"spn-36444","text":"Full prompt/response storage (telemetry is numeric and metadata-focused by default)."}]}],"id":"blk-31758","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31760","kind":"heading","level":2,"spans":[{"id":"spn-36445","text":"Notes on older drafts"}]},{"id":"blk-31761","kind":"paragraph","spans":[{"id":"spn-36446","text":"This folder is the canonical spec. Earlier rough drafts (if any remain) are useful as background, but "},{"id":"spn-36447","marks":["bold"],"text":"implementation should follow this folder"},{"id":"spn-36448","text":"."}]},{"id":"blk-31762","kind":"paragraph","spans":[{"id":"spn-36449","text":"If any contradictions are found: 1. Prefer "},{"id":"spn-36450","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-36451","text":" and "},{"id":"spn-36452","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-36453","text":" for canonical behavior. 2. Prefer ADRs for “why” and invariants. 3. Treat earlier drafts as non-normative."}]},{"id":"blk-31763","kind":"heading","level":2,"spans":[{"id":"spn-36454","text":"PULSE Loop Manifest"}]},{"id":"blk-31764","kind":"paragraph","spans":[{"id":"spn-36455","text":"WebHost.Systems is a "},{"id":"spn-36456","marks":["bold"],"text":"PULSE-conforming loop"},{"id":"spn-36457","text":" under OS-010. As the hosting layer for the entire [&] ecosystem, its loop encodes the "},{"id":"spn-36458","marks":["bold"],"text":"deploy → invoke → meter → bill"},{"id":"spn-36459","text":" rhythm. Unlike other loops in the portfolio it is the only one whose substrates include both Cloudflare Workers and AWS AgentCore (per ADR-0001), and its "},{"id":"spn-36460","marks":["code"],"text":"act"},{"id":"spn-36461","text":" phase is intentionally pluggable through the Runtime Provider Interface (per "},{"id":"spn-36462","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-36463","text":")."}]},{"id":"blk-31765","kind":"paragraph","spans":[{"id":"spn-36464","marks":["bold"],"text":"Loop ID:"},{"id":"spn-36465","text":" "},{"id":"spn-36466","marks":["code"],"text":"webhost.deploy_invoke"},{"id":"spn-36467","text":" "},{"id":"spn-36468","marks":["bold"],"text":"Loop name:"},{"id":"spn-36469","text":" WebHost.Systems Deploy/Invoke Loop "},{"id":"spn-36470","marks":["bold"],"text":"Version:"},{"id":"spn-36471","text":" 1.0.0 "},{"id":"spn-36472","marks":["bold"],"text":"Owner:"},{"id":"spn-36473","text":" webhost.systems "},{"id":"spn-36474","marks":["bold"],"text":"Workspace scope:"},{"id":"spn-36475","text":" required"}]},{"id":"blk-31766","kind":"paragraph","spans":[{"id":"spn-36476","marks":["bold"],"text":"Phases (5 canonical kinds):"}]},{"head":[{"id":"blk-31768","spans":[{"id":"spn-36477","text":"Phase ID"}]},{"id":"blk-31769","spans":[{"id":"spn-36478","text":"Kind"}]},{"id":"blk-31770","spans":[{"id":"spn-36479","text":"Description"}]}],"id":"blk-31767","kind":"table","rows":[[{"id":"blk-31771","spans":[{"id":"spn-36480","marks":["code"],"text":"retrieve_deployment"}]},{"id":"blk-31772","spans":[{"id":"spn-36481","marks":["code"],"text":"retrieve"}]},{"id":"blk-31773","spans":[{"id":"spn-36482","text":"Resolve "},{"id":"spn-36483","marks":["code"],"text":"agent_id → activeDeploymentId"},{"id":"spn-36484","text":" from Supabase control plane (per ADR-0005)"}]}],[{"id":"blk-31774","spans":[{"id":"spn-36485","marks":["code"],"text":"route_runtime"}]},{"id":"blk-31775","spans":[{"id":"spn-36486","marks":["code"],"text":"route"}]},{"id":"blk-31776","spans":[{"id":"spn-36487","text":"Select runtime provider via RPI (Cloudflare default, AgentCore premium, others as adapters)"}]}],[{"id":"blk-31777","spans":[{"id":"spn-36488","marks":["code"],"text":"act_invoke"}]},{"id":"blk-31778","spans":[{"id":"spn-36489","marks":["code"],"text":"act"}]},{"id":"blk-31779","spans":[{"id":"spn-36490","text":"Execute "},{"id":"spn-36491","marks":["code"],"text":"invoke/v1"},{"id":"spn-36492","text":" (per ADR-0006); stream SSE response if requested; capture telemetry"}]}],[{"id":"blk-31780","spans":[{"id":"spn-36493","marks":["code"],"text":"learn_telemetry"}]},{"id":"blk-31781","spans":[{"id":"spn-36494","marks":["code"],"text":"learn"}]},{"id":"blk-31782","spans":[{"id":"spn-36495","text":"Aggregate signed telemetry events; update usage counters; check tier entitlements"}]}],[{"id":"blk-31783","spans":[{"id":"spn-36496","marks":["code"],"text":"consolidate_billing"}]},{"id":"blk-31784","spans":[{"id":"spn-36497","marks":["code"],"text":"consolidate"}]},{"id":"blk-31785","spans":[{"id":"spn-36498","text":"Periodic aggregation by billing period; retention pruning; cost estimation rollups"}]}]]},{"id":"blk-31786","kind":"paragraph","spans":[{"id":"spn-36499","marks":["bold"],"text":"Closure:"},{"id":"spn-36500","text":" "},{"id":"spn-36501","marks":["code"],"text":"consolidate_billing → retrieve_deployment"},{"id":"spn-36502","text":" via Supabase, guarantee "},{"id":"spn-36503","marks":["code"],"text":"eventual"},{"id":"spn-36504","text":"."}]},{"id":"blk-31787","kind":"paragraph","spans":[{"id":"spn-36505","marks":["bold"],"text":"Cadence:"},{"id":"spn-36506","text":" Primary "},{"id":"spn-36507","marks":["code"],"text":"event"},{"id":"spn-36508","text":" (every invocation). Fallback "},{"id":"spn-36509","marks":["code"],"text":"periodic"},{"id":"spn-36510","text":" (billing aggregation, retention sweeps)."}]},{"id":"blk-31788","kind":"paragraph","spans":[{"id":"spn-36511","marks":["bold"],"text":"Substrates:"}]},{"id":"blk-31789","items":[{"blocks":[{"id":"blk-31791","kind":"paragraph","spans":[{"id":"spn-36512","marks":["code"],"text":"memory"},{"id":"spn-36513","text":": "},{"id":"spn-36514","marks":["code"],"text":"graphonomous://workspace/{ws_id}"},{"id":"spn-36515","text":" (optional, for hosted MCP sidecars)"}]}],"id":"blk-31790","kind":"list-item"},{"blocks":[{"id":"blk-31793","kind":"paragraph","spans":[{"id":"spn-36516","marks":["code"],"text":"policy"},{"id":"spn-36517","text":": "},{"id":"spn-36518","marks":["code"],"text":"delegatic://workspace/{ws_id}"},{"id":"spn-36519","text":" (tier entitlements, runtime gating)"}]}],"id":"blk-31792","kind":"list-item"},{"blocks":[{"id":"blk-31795","kind":"paragraph","spans":[{"id":"spn-36520","marks":["code"],"text":"audit"},{"id":"spn-36521","text":": "},{"id":"spn-36522","marks":["code