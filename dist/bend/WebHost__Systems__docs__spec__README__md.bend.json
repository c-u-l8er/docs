t":" — Supabase as control-plane backend (supersedes original Convex choice); Edge Functions for server-only logic."}]}],"id":"blk-30614","kind":"list-item"},{"blocks":[{"id":"blk-30617","kind":"paragraph","spans":[{"id":"spn-33467","marks":["code"],"text":"adr/ADR-0003-secrets-strategy.md"},{"id":"spn-33468","text":" — No plaintext secrets in DB; provider-native secret injection; write-only secrets API."}]}],"id":"blk-30616","kind":"list-item"},{"blocks":[{"id":"blk-30619","kind":"paragraph","spans":[{"id":"spn-33469","marks":["code"],"text":"adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-33470","text":" — Deployment-scoped signed telemetry events + ownership cross-check."}]}],"id":"blk-30618","kind":"list-item"},{"blocks":[{"id":"blk-30621","kind":"paragraph","spans":[{"id":"spn-33471","marks":["code"],"text":"adr/ADR-0005-deployment-immutability.md"},{"id":"spn-33472","text":" — Immutable deployment records + "},{"id":"spn-33473","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-33474","text":" routing pointer + rollback."}]}],"id":"blk-30620","kind":"list-item"},{"blocks":[{"id":"blk-30623","kind":"paragraph","spans":[{"id":"spn-33475","marks":["code"],"text":"adr/ADR-0006-invocation-protocol.md"},{"id":"spn-33476","text":" — Canonical "},{"id":"spn-33477","marks":["code"],"text":"invoke/v1"},{"id":"spn-33478","text":" protocol, session semantics, and SSE streaming model."}]}],"id":"blk-30622","kind":"list-item"},{"blocks":[{"id":"blk-30625","kind":"paragraph","spans":[{"id":"spn-33479","marks":["code"],"text":"adr/ADR-0007-entitlements-and-limits.md"},{"id":"spn-33480","text":" — Tier entitlements, runtime gating, and limit enforcement strategy."}]}],"id":"blk-30624","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30626","kind":"heading","level":2,"spans":[{"id":"spn-33481","text":"Progress logs"}]},{"id":"blk-30627","kind":"paragraph","spans":[{"id":"spn-33482","text":"Daily implementation progress logs live in "},{"id":"spn-33483","marks":["code"],"text":"../progress/"},{"id":"spn-33484","text":" (relative to this folder). These logs are "},{"id":"spn-33485","marks":["bold"],"text":"non-normative"},{"id":"spn-33486","text":" and exist to track execution against this spec."}]},{"id":"blk-30628","kind":"paragraph","spans":[{"id":"spn-33487","text":"Recommended convention:"}]},{"id":"blk-30629","items":[{"blocks":[{"id":"blk-30631","kind":"paragraph","spans":[{"id":"spn-33488","text":"One file per day: "},{"id":"spn-33489","marks":["code"],"text":"YYYY-MM-DD.md"}]}],"id":"blk-30630","kind":"list-item"},{"blocks":[{"id":"blk-30633","kind":"paragraph","spans":[{"id":"spn-33490","text":"Include: what shipped, what changed, decisions made (with links to ADRs/spec sections), and next steps."}]}],"id":"blk-30632","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30634","kind":"heading","level":2,"spans":[{"id":"spn-33491","text":"Normative conventions used in this spec"}]},{"id":"blk-30635","items":[{"blocks":[{"id":"blk-30637","kind":"paragraph","spans":[{"id":"spn-33492","marks":["bold"],"text":"MUST / MUST NOT / SHOULD / MAY"},{"id":"spn-33493","text":" are used intentionally."}]}],"id":"blk-30636","kind":"list-item"},{"blocks":[{"id":"blk-30639","kind":"paragraph","spans":[{"id":"spn-33494","marks":["bold"],"text":"Control plane"},{"id":"spn-33495","text":" = auth, DB, deploy orchestration, billing, telemetry ingestion/aggregation, UI API."}]}],"id":"blk-30638","kind":"list-item"},{"blocks":[{"id":"blk-30641","kind":"paragraph","spans":[{"id":"spn-33496","marks":["bold"],"text":"Data plane"},{"id":"spn-33497","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-30640","kind":"list-item"},{"blocks":[{"id":"blk-30643","kind":"paragraph","spans":[{"id":"spn-33498","marks":["bold"],"text":"Session IDs"},{"id":"spn-33499","text":" are "},{"id":"spn-33500","marks":["bold"],"text":"opaque"},{"id":"spn-33501","text":" and runtime-specific; the 