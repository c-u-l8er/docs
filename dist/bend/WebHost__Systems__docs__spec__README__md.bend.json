","ordered":false},{"id":"blk-30589","kind":"paragraph","spans":[{"id":"spn-33433","text":"3. "},{"id":"spn-33434","marks":["bold"],"text":"Implement runtime portability"}]},{"id":"blk-30590","items":[{"blocks":[{"id":"blk-30592","kind":"paragraph","spans":[{"id":"spn-33435","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-33436","text":" — Runtime Provider Interface (RPI) that all runtimes must implement, plus adapter guidance (including AgentCore TypeScript adapter guidance using "},{"id":"spn-33437","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-33438","text":", and notes on the "},{"id":"spn-33439","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-33440","text":" tools SDK ecosystem)."}]}],"id":"blk-30591","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30593","kind":"paragraph","spans":[{"id":"spn-33441","text":"4. "},{"id":"spn-33442","marks":["bold"],"text":"Build your control-plane data layer"}]},{"id":"blk-30594","items":[{"blocks":[{"id":"blk-30596","kind":"paragraph","spans":[{"id":"spn-33443","marks":["code"],"text":"30_DATA_MODEL_SUPABASE.md"},{"id":"spn-33444","text":" — Supabase/PostgreSQL schema, indexes, invariants, RLS policies, retention and deletion semantics."}]}],"id":"blk-30595","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30597","kind":"paragraph","spans":[{"id":"spn-33445","text":"5. "},{"id":"spn-33446","marks":["bold"],"text":"Lock down security and secrets"}]},{"id":"blk-30598","items":[{"blocks":[{"id":"blk-30600","kind":"paragraph","spans":[{"id":"spn-33447","marks":["code"],"text":"40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-33448","text":" — threat model, secrets strategy requirements, telemetry integrity, webhook integrity, artifact safety, acceptance criteria."}]}],"id":"blk-30599","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30601","kind":"paragraph","spans":[{"id":"spn-33449","text":"6. "},{"id":"spn-33450","marks":["bold"],"