{"bendscript":"0.1","blocks":[{"id":"blk-31658","kind":"heading","level":1,"spans":[{"id":"spn-36337","text":"webhost.systems — Spec v1 (Implementation-Ready Document Set)"}]},{"id":"blk-31659","kind":"paragraph","spans":[{"id":"spn-36338","text":"Version: 1.0 Status: Implementation-ready draft Audience: Engineering Last updated: 2026-01-21"}]},{"id":"blk-31660","kind":"paragraph","spans":[{"id":"spn-36339","text":"This folder is the "},{"id":"spn-36340","marks":["bold"],"text":"canonical v1 specification"},{"id":"spn-36341","text":" for implementing webhost.systems from scratch. It consolidates product + technical requirements into a small set of normative documents with ADRs (Architecture Decision Records). If you implement only what’s in these files, you should be able to build a working v1."}]},{"id":"blk-31661","kind":"heading","level":2,"spans":[{"id":"spn-36342","text":"How to use this spec (recommended reading order)"}]},{"id":"blk-31662","kind":"paragraph","spans":[{"id":"spn-36343","text":"1. "},{"id":"spn-36344","marks":["bold"],"text":"Start here (overall system)"}]},{"id":"blk-31663","items":[{"blocks":[{"id":"blk-31665","kind":"paragraph","spans":[{"id":"spn-36345","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-36346","text":" — the single “master” engineering spec: scope, architecture, flows, core requirements, acceptance criteria."}]}],"id":"blk-31664","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31666","kind":"paragraph","spans":[{"id":"spn-36347","text":"2. "},{"id":"spn-36348","marks":["bold"],"text":"Implement your API surface and contracts"}]},{"id":"blk-31667","items":[{"blocks":[{"id":"blk-31669","kind":"paragraph","spans":[{"id":"spn-36349","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-36350","text":" — normalized request/response shapes, error envelope, idempotency, pagination, invocation gateway, telemetry ingestion, and billing/webhook contracts."}]}],"id":"blk-31668","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31670","kind":"paragraph","spans":[{"id":"spn-36351","text":"3. "},{"id":"spn-36352","marks":["bold"],"text":"Implement runtime portability"}]},{"id":"blk-31671","items":[{"blocks":[{"id":"blk-31673","kind":"paragraph","spans":[{"id":"spn-36353","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-36354","text":" — Runtime Provider Interface (RPI) that all runtimes must implement, plus adapter guidance (including AgentCore TypeScript adapter guidance using "},{"id":"spn-36355","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-36356","text":", and notes on the "},{"id":"spn-36357","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-36358","text":" tools SDK ecosystem)."}]}],"id":"blk-31672","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31674","kind":"paragraph","spans":[{"id":"spn-36359","text":"4. "},{"id":"spn-36360","marks":["bold"],"text":"Build your control-plane data layer"}]},{"id":"blk-31675","items":[{"blocks":[{"id":"blk-31677","kind":"paragraph","spans":[{"id":"spn-36361","marks":["code"],"text":"30_DATA_MODEL_SUPABASE.md"},{"id":"spn-36362","text":" — Supabase/PostgreSQL schema, indexes, invariants, RLS policies, retention and deletion semantics."}]}],"id":"blk-31676","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31678","kind":"paragraph","spans":[{"id":"spn-36363","text":"5. "},{"id":"spn-36364","marks":["bold"],"text":"Lock down security and secrets"}]},{"id":"blk-31679","items":[{"blocks":[{"id":"blk-31681","kind":"paragraph","spans":[{"id":"spn-36365","marks":["code"],"text":"40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-36366","text":" — threat model, secrets strategy requirements, telemetry integrity, webhook integrity, artifact safety, acceptance criteria."}]}],"id":"blk-31680","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31682","kind":"paragraph","spans":[{"id":"spn-36367","text":"6. "},{"id":"spn-36368","marks":["bold"],"