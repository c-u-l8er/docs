tion/aggregation, UI API."}]}],"id":"blk-49897","kind":"list-item"},{"blocks":[{"id":"blk-49900","kind":"paragraph","spans":[{"id":"spn-76803","marks":["bold"],"text":"Data plane"},{"id":"spn-76804","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-49899","kind":"list-item"},{"blocks":[{"id":"blk-49902","kind":"paragraph","spans":[{"id":"spn-76805","marks":["bold"],"text":"Session IDs"},{"id":"spn-76806","text":" are "},{"id":"spn-76807","marks":["bold"],"text":"opaque"},{"id":"spn-76808","text":" and runtime-specific; the control plane and clients must not parse them."}]}],"id":"blk-49901","kind":"list-item"},{"blocks":[{"id":"blk-49904","kind":"paragraph","spans":[{"id":"spn-76809","marks":["bold"],"text":"Deployments"},{"id":"spn-76810","text":" are "},{"id":"spn-76811","marks":["bold"],"text":"immutable"},{"id":"spn-76812","text":" records; routing is via the agent’s single "},{"id":"spn-76813","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-76814","text":"."}]}],"id":"blk-49903","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49905","kind":"heading","level":2,"spans":[{"id":"spn-76815","text":"Implementation “starter checklist” (quick reference)"}]},{"id":"blk-49906","kind":"paragraph","spans":[{"id":"spn-76816","text":"Minimum v1 must-haves:"}]},{"id":"blk-49907","items":[{"blocks":[{"id":"blk-49909","kind":"paragraph","spans":[{"id":"spn-76817","text":"Auth + tenant isolation across all endpoints."}]}],"id":"blk-49908","kind":"list-item"},{"blocks":[{"id":"blk-49911","kind":"paragraph","spans":[{"id":"spn-76818","text":"Agent CRUD."}]}],"id":"blk-49910","kind":"list-item"},{"blocks":[{"id":"blk-49913","kind":"paragraph","spans":[{"id":"spn-76819","text":"Immutable deployments + rollback (active pointer)."}]}],"id":"blk-49912","kind":"list-item"},{"blocks":[{"id":"blk-49915","kind":"paragraph","spans":[{"id":"spn-76820","text":"Invocation gateway with consistent "},{"id":"spn-76821","marks":["code"],"text":"invoke/v1"},{"id":"spn-76822","text":" contract (non-streaming required; streaming recommended)."}]}],"id":"blk-49914","kind":"list-item"},{"blocks":[{"id":"blk-49917","kind":"paragraph","spans":[{"id":"spn-76823","text":"Telemetry ingestion with integrity protection (deployment-scoped signing) and ownership cross-check."}]}],"id":"blk-49916","kind":"list-item"},{"blocks":[{"id":"blk-49919","kind":"paragraph","spans":[{"id":"spn-76824","text":"Usage aggregation by billing period + dashboard usage views."}]}],"id":"blk-49918","kind":"list-item"},{"blocks":[{"id":"blk-49921","kind":"paragraph","spans":[{"id":"spn-76825","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-49920","kind":"list-item"},{"blocks":[{"id":"blk-49923","kind":"paragraph","spans":[{"id":"spn-76826","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-49922","kind":"list-item"},{"blocks":[{"id":"blk-49925","kind":"paragraph","spans":[{"id":"spn-76827","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-49924","kind":"list-item"},{"blocks":[{"id":"blk-49927","kind":"paragraph","spans":[{"id":"spn-76828","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-49926","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49928","kind":"heading","level":2,"spans":[{"id":"spn-76829","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-49929","items":[{"blocks":[{"id":"blk-49931","kind":"paragraph","spans":[{"id":"spn-76830","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-49930","kind":"list-item"},{"blocks":[{"id":"blk-49933","kind":"paragraph","spans":[{"id":"spn-76831","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-49932","kind":"list-item"},{"blocks":[{"id":"blk-49935","kind":"paragraph","spans":[{"id":"spn-76832","text":"Public agents / unauthenticated invocation (unless explicitly added later with API keys)."}]}],"id":"blk-49934","kind":"list-item"},{"blocks":[{"id":"blk-49937","kind":"paragraph","spans":[{"id":"spn-76833","text":"Full prompt/response storage (telemetry is numeric and metadata-focused by default)."}]}],"id":"blk-49936","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49938","kind":"heading","level":2,"spans":[{"id":"spn-76834","text":"Notes on older drafts"}]},{"id":"blk-49939","kind":"paragraph","spans":[{"id":"spn-76835","text":"This folder is the canonical spec. Earlier rough drafts (if any remain) are useful as background, but "},{"id":"spn-76836","marks":["bold"],"text":"implementation should follow this folder"},{"id":"spn-76837","text":"."}]},{"id":"blk-49940","kind":"paragraph","spans":[{"id":"spn-76838","text":"If any contradictions are found:"}]},{"id":"blk-49941","items":[{"blocks":[{"id":"blk-49943","kind":"paragraph","spans":[{"id":"spn-76839","text":"Prefer "},{"id":"spn-76840","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-76841","text":" and "},{"id":"spn-76842","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-76843","text":" for canonical behavior."}]}],"id":"blk-49942","kind":"list-item"},{"blocks":[{"id":"blk-49945","kind":"paragraph","spans":[{"id":"spn-76844","text":"Prefer ADRs for “why” and invariants."}]}],"id":"blk-49944","kind":"list-item"},{"blocks":[{"id":"blk-49947","kind":"paragraph","spans":[{"id":"spn-76845","text":"Treat earlier drafts as non-normative."}]}],"id":"blk-49946","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49948","kind":"heading","level":2,"spans":[{"id":"spn-76846","text":"PULSE Loop Manifest"}]},{"id":"blk-49949","kind":"paragraph","spans":[{"id":"spn-76847","text":"WebHost.Systems is a "},{"id":"spn-76848","marks":["bold"],"text":"PULSE-conforming loop"},{"id":"spn-76849","text":" under OS-010. As the hosting layer for the entire [&] ecosystem, its loop encodes the "},{"id":"spn-76850","marks":["bold"],"text":"deploy → invoke → meter → bill"},{"id":"spn-76851","text":" rhythm. Unlike other loops in the portfolio it is the only one whose substrates include both Cloudflare Workers and AWS AgentCore (per ADR-0001), and its "},{"id":"spn-76852","marks":["code"],"text":"act"},{"id":"spn-76853","text":" phase is intentionally pluggable through the Runtime Provider Interface (per "},{"id":"spn-76854","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-76855","text":")."}]},{"id":"blk-49950","kind":"paragraph","spans":[{"id":"spn-76856","marks":["bold"],"text":"Loop ID:"},{"id":"spn-76857","text":" "},{"id":"spn-76858","marks":["code"],"text":"webhost.deploy_invoke"},{"id":"spn-76859","text":" "},{"id":"spn-76860","marks":["bold"],"text":"Loop name:"},{"id":"spn-76861","text":" WebHost.Systems Deploy/Invoke Loop "},{"id":"spn-76862","marks":["bold"],"text":"Version:"},{"id":"spn-76863","text":" 1.0.0 "},{"id":"spn-76864","marks":["bold"],"text":"Owner:"},{"id":"spn-76865","text":" webhost.systems "},{"id":"spn-76866","marks":["bold"],"text":"Workspace scope:"},{"id":"spn-76867","text":" required"}]},{"id":"blk-49951","kind":"paragraph","spans":[{"id":"spn-76868","marks":["bold"],"text":"Phases (5 canonical kinds):"}]},{"head":[{"id":"blk-49953","spans":[{"id":"spn-76869","text":"Phase ID"}]},{"id":"blk-49954","spans":[{"id":"spn-76870","text":"Kind"}]},{"id":"blk-49955","spans":[{"id":"spn-76871","text":"Description"}]}],"id":"blk-49952","kind":"table","rows":[[{"id":"blk-49956","spans":[{"id":"spn-76872","marks":["code"],"text":"retrieve_deployment"}]},{"id":"blk-49957","spans":[{"id":"spn-76873","marks":["code"],"text":"retrieve"}]},{"id":"blk-49958","spans":[{"id":"spn-76874","text":"Resolve "},{"id":"spn-76875","marks":["code"],"text":"agent_id → activeDeploymentId"},{"id":"spn-76876","text":" from Supabase control plane (per ADR-0005)"}]}],[{"id":"blk-49959","spans":[{"id":"spn-76877","marks":["code"],"text":"route_runtime"}]},{"id":"blk-49960","spans":[{"id":"spn-76878","marks":["code"],"text":"route"}]},{"id":"blk-49961","spans":[{"id":"spn-76879","text":"Select runtime provider via RPI (Cloudflare default, AgentCore premium, others as adapters)"}]}],[{"id":"blk-49962","spans":[{"id":"spn-76880","marks":["code"],"text":"act_invoke"}]},{"id":"blk-49963","spans":[{"id":"spn-76881","marks":["code"],"text":"act"}]},{"id":"blk-49964","spans":[{"id":"spn-76882","text":"Execute "},{"id":"spn-76883","marks":["code"],"text":"invoke/v1"},{"id":"spn-76884","text":" (per ADR-0006); stream SSE response if requested; capture telemetry"}]}],[{"id":"blk-49965","spans":[{"id":"spn-76885","marks":["code"],"text":"learn_telemetry"}]},{"id":"blk-49966","spans":[{"id":"spn-76886","marks":["code"],"text":"learn"}]},{"id":"blk-49967","spans":[{"id":"spn-76887","text":"Aggregate signed telemetry events; update usage counters; check tier entitlements"}]}],[{"id":"blk-49968","spans":[{"id":"spn-76888","marks":["code"],"text":"consolidate_billing"}]},{"id":"blk-49969","spans":[{"id":"spn-76889","marks":["code"],"text":"consolidate"}]},{"id":"blk-49970","spans":[{"id":"spn-76890","text":"Periodic aggregation by billing period; retention pruning; cost estimation rollups"}]}]]},{"id":"blk-49971","kind":"paragraph","spans":[{"id":"spn-76891","marks":["bold"],"text":"Closure:"},{"id":"spn-76892","text":" "},{"id":"spn-76893","marks":["code"],"text":"consolidate_billing → retrieve_deployment"},{"id":"spn-76894","text":" via Supabase, guarantee "},{"id":"spn-76895","marks":["code"],"text":"eventual"},{"id":"spn-76896","text":"."}]},{"id":"blk-49972","kind":"paragraph","spans":[{"id":"spn-76897","marks":["bold"],"text":"Cadence:"},{"id":"spn-76898","text":" Primary "},{"id":"spn-76899","marks":["code"],"text":"event"},{"id":"spn-76900","text":" (every invocation). Fallback "},{"id":"spn-76901","marks":["code"],"text":"periodic"},{"id":"spn-76902","text":" (billing aggregation, retention sweeps)."}]},{"id":"blk-49973","kind":"paragraph","spans":[{"id":"spn-76903","marks":["bold"],"text":"Substrates:"}]},{"id":"blk-49974","items":[{"blocks":[{"id":"blk-49976","kind":"paragraph","spans":[{"id":"spn-76904","marks":["code"],"text":"memory"},{"id":"spn-76905","text":": "},{"id":"spn-76906","marks":["code"],"text":"graphonomous://workspace/{ws_id}"},{"id":"spn-76907","text":" (optional, for hosted MCP sidecars)"}]}],"id":"blk-49975","kind":"list-item"},{"blocks":[{"id":"blk-49978","kind":"paragraph","spans":[{"id":"spn-76908","marks":["code"],"text":"policy"},{"id":"spn-76909","text":": "},{"id":"spn-76910","marks":["code"],"text":"delegatic://workspace/{ws_id}"},{"id":"spn-76911","text":" (tier entitlements, runtime gating)"}]}],"id":"blk-49977","kind":"list-item"},{"blocks":[{"id":"blk-49980","kind":"paragraph","spans":[{"id":"spn-76912","marks":["code"],"text":"audit"},{"id":"spn-76913","text":": "},{"id":"spn-76914","marks":["code"],"text":"delegatic://workspace/{ws_id}/audit"},{"id":"spn-76915","text":" + Supabase telemetry table"}]}],"id":"blk-49979","kind":"list-item"},{"blocks":[{"id":"blk-49982","kind":"paragraph","spans":[{"id":"spn-76916","marks":["code"],"text":"auth"},{"id":"spn-76917","text":": "},{"id":"spn-76918","marks":["code"],"text":"supabase://auth"},{"id":"spn-76919","text":" (Supabase Auth, shared with other Node-based products)"}]}],"id":"blk-49981","kind":"list-item"},{"blocks":[{"id":"blk-49984","kind":"paragraph","spans":[{"id":"spn-76920","marks":["code"],"text":"transport"},{"id":"spn-76921","text":": "},{"id":"spn-76922","marks":["code"],"text":"https"},{"id":"spn-76923","text":" ("},{"id":"spn-76924","marks":["code"],"text":"invoke/v1"},{"id":"spn-76925","text":" per ADR-0006), "},{"id":"spn-76926","marks":["code"],"text":"mcp"},{"id":"spn-76927","text":" (sidecars)"}]}],"id":"blk-49983","kind":"list-item"},{"blocks":[{"id":"blk-49986","kind":"paragraph","spans":[{"id":"spn-76928","marks":["code"],"text":"time"},{"id":"spn-76929","text":": "},{"id":"spn-76930","marks":["code"],"text":"ticktickclock://workspace/{ws_id}"},{"id":"spn-76931","text":" (optional, for SLA enforcement)"}]}],"id":"blk-49985","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49987","kind":"paragraph","spans":[{"id":"spn-76932","marks":["bold"],"text":"Invariants enabled:"},{"id":"spn-76933","text":" "},{"id":"spn-76934","marks":["code"],"text":"phase_atomicity"},{"id":"spn-76935","text":", "},{"id":"spn-76936","marks":["code"],"text":"feedback_immutability"},{"id":"spn-76937","text":" (immutable deployments per ADR-0005), "},{"id":"spn-76938","marks":["code"],"text":"append_only_audit"},{"id":"spn-76939","text":", "},{"id":"spn-76940","marks":["code"],"text":"outcome_grounding"},{"id":"spn-76941","text":", "},{"id":"spn-76942","marks":["code"],"text":"trace_id_propagation"},{"id":"spn-76943","text":". The deployment-immutability invariant from ADR-0005 corresponds directly to "},{"id":"spn-76944","marks":["code"],"text":"feedback_immutability"},{"id":"spn-76945","text":" in PULSE terms."}]},{"id":"blk-49988","kind":"paragraph","spans":[{"id":"spn-76946","marks":["bold"],"text":"Cross-loop connections:"}]},{"id":"blk-49989","items":[{"blocks":[{"id":"blk-49991","kind":"paragraph","spans":[{"id":"spn-76947","marks":["code"],"text":"usage_to_billing"},{"id":"spn-76948","text":" — "},{"id":"spn-76949","marks":["code"],"text":"consolidate_billing"},{"id":"spn-76950","text":" emits "},{"id":"spn-76951","marks":["code"],"text":"OutcomeSignal"},{"id":"spn-76952","text":" (usage rollup) to billing webhooks"}]}],"id":"blk-49990","kind":"list-item"},{"blocks":[{"id":"blk-49993","kind":"paragraph","spans":[{"id":"spn-76953","marks":["code"],"text":"entitlement_violation"},{"id":"spn-76954","text":" — "},{"id":"spn-76955","marks":["code"],"text":"route_runtime"},{"id":"spn-76956","text":" emits "},{"id":"spn-76957","marks":["code"],"text":"OutcomeSignal"},{"id":"spn-76958","text":" (gated runtime requested) to "},{"id":"spn-76959","marks":["code"],"text":"delegatic.governance.learn_drift"}]}],"id":"blk-49992","kind":"list-item"},{"blocks":[{"id":"blk-49995","kind":"paragraph","spans":[{"id":"spn-76960","marks":["code"],"text":"deploy_to_fleetprompt"},{"id":"spn-76961","text":" — optional "},{"id":"spn-76962","marks":["code"],"text":"ConsolidationEvent"},{"id":"spn-76963","text":" from "},{"id":"spn-76964","marks":["code"],"text":"consolidate_billing"},{"id":"spn-76965","text":" to "},{"id":"spn-76966","marks":["code"],"text":"fleetprompt.publish"},{"id":"spn-76967","text":" for usage-based trust signals"}]}],"id":"blk-49994","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49996","kind":"paragraph","spans":[{"id":"spn-76968","marks":["bold"],"text":"Why this matters:"},{"id":"spn-76969","text":" WebHost.Systems is the only loop in the portfolio with "},{"id":"spn-76970","marks":["bold"],"text":"multiple swappable runtime providers"},{"id":"spn-76971","text":" in its "},{"id":"spn-76972","marks":["code"],"text":"act"},{"id":"spn-76973","text":" phase. PULSE's "},{"id":"spn-76974","marks":["code"],"text":"phase"},{"id":"spn-76975","text":" schema allows the runtime to be opaque (declared via "},{"id":"spn-76976","marks":["code"],"text":"signature"},{"id":"spn-76977","text":" and "},{"id":"spn-76978","marks":["code"],"text":"policy_check"},{"id":"spn-76979","text":" fields) — the manifest stays stable even as the RPI gains new adapters. This is the pattern other loops should follow when their "},{"id":"spn-76980","marks":["code"],"text":"act"},{"id":"spn-76981","text":" phase depends on third-party infrastructure."}]},{"id":"blk-49997","kind":"paragraph","spans":[{"id":"spn-76982","text":"See "},{"id":"spn-76983","marks":["code"],"text":"OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-76984","text":" in "},{"id":"spn-76985","marks":["code"],"text":"/home/travis/ProjectAmp2/opensentience.org/docs/spec/"},{"id":"spn-76986","text":" for the full PULSE protocol spec."}]}],"edges":[],"id":"bagaaieravj7iltfa5xr4gylhoq6ofm5zbd6uxxvfgrgionypoippt7ahsyhq","vocabulary":"ampersand.docs.fs.v1"}