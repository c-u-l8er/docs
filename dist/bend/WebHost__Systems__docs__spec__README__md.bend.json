tion/aggregation, UI API."}]}],"id":"blk-49899","kind":"list-item"},{"blocks":[{"id":"blk-49902","kind":"paragraph","spans":[{"id":"spn-76815","marks":["bold"],"text":"Data plane"},{"id":"spn-76816","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-49901","kind":"list-item"},{"blocks":[{"id":"blk-49904","kind":"paragraph","spans":[{"id":"spn-76817","marks":["bold"],"text":"Session IDs"},{"id":"spn-76818","text":" are "},{"id":"spn-76819","marks":["bold"],"text":"opaque"},{"id":"spn-76820","text":" and runtime-specific; the control plane and clients must not parse them."}]}],"id":"blk-49903","kind":"list-item"},{"blocks":[{"id":"blk-49906","kind":"paragraph","spans":[{"id":"spn-76821","marks":["bold"],"text":"Deployments"},{"id":"spn-76822","text":" are "},{"id":"spn-76823","marks":["bold"],"text":"immutable"},{"id":"spn-76824","text":" records; routing is via the agent’s single "},{"id":"spn-76825","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-76826","text":"."}]}],"id":"blk-49905","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49907","kind":"heading","level":2,"spans":[{"id":"spn-76827","text":"Implementation “starter checklist” (quick reference)"}]},{"id":"blk-49908","kind":"paragraph","spans":[{"id":"spn-76828","text":"Minimum v1 must-haves:"}]},{"id":"blk-49909","items":[{"blocks":[{"id":"blk-49911","kind":"paragraph","spans":[{"id":"spn-76829","text":"Auth + tenant isolation across all endpoints."}]}],"id":"blk-49910","kind":"list-item"},{"blocks":[{"id":"blk-49913","kind":"paragraph","spans":[{"id":"spn-76830","text":"Agent CRUD."}]}],"id":"blk-49912","kind":"list-item"},{"blocks":[{"id":"blk-49915","kind":"paragraph","spans":[{"id":"spn-76831","text":"Immutable deployments + rollback (active pointer)."}]}],"id":"blk-49914","kind":"list-item"},{"blocks":[{"id":"blk-49917","kind":"paragraph","spans":[{"id":"spn-76832","text":"Invocation gateway with consistent "},{"id":"spn-76833","marks":["code"],"text":"invoke/v1"},{"id":"spn-76834","text":" contract (non-streaming required; streaming recommended)."}]}],"id":"blk-49916","kind":"list-item"},{"blocks":[{"id":"blk-49919","kind":"paragraph","spans":[{"id":"spn-76835","text":"Telemetry ingestion with integrity protection (deployment-scoped signing) and ownership cross-check."}]}],"id":"blk-49918","kind":"list-item"},{"blocks":[{"id":"blk-49921","kind":"paragraph","spans":[{"id":"spn-76836","text":"Usage aggregation by billing period + dashboard usage views."}]}],"id":"blk-49920","kind":"list-item"},{"blocks":[{"id":"blk-49923","kind":"paragraph","spans":[{"id":"spn-76837","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-49922","kind":"list-item"},{"blocks":[{"id":"blk-49925","kind":"paragraph","spans":[{"id":"spn-76838","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-49924","kind":"list-item"},{"blocks":[{"id":"blk-49927","kind":"paragraph","spans":[{"id":"spn-76839","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-49926","kind":"list-item"},{"blocks":[{"id":"blk-49929","kind":"paragraph","spans":[{"id":"spn-76840","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-49928","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49930","kind":"heading","level":2,"spans":[{"id":"spn-76841","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-49931","items":[{"blocks":[{"id":"blk-49933","kind":"paragraph","spans":[{"id":"spn-76842","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-49932","kind":"list-item"},{"blocks":[{"id":"blk-49935","kind":"paragraph","spans":[{"id":"spn-76843","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-49934","kind":"list-item"},{"blocks":[{"