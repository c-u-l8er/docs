t":" — Supabase as control-plane backend (supersedes original Convex choice); Edge Functions for server-only logic."}]}],"id":"blk-30724","kind":"list-item"},{"blocks":[{"id":"blk-30727","kind":"paragraph","spans":[{"id":"spn-34096","marks":["code"],"text":"adr/ADR-0003-secrets-strategy.md"},{"id":"spn-34097","text":" — No plaintext secrets in DB; provider-native secret injection; write-only secrets API."}]}],"id":"blk-30726","kind":"list-item"},{"blocks":[{"id":"blk-30729","kind":"paragraph","spans":[{"id":"spn-34098","marks":["code"],"text":"adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-34099","text":" — Deployment-scoped signed telemetry events + ownership cross-check."}]}],"id":"blk-30728","kind":"list-item"},{"blocks":[{"id":"blk-30731","kind":"paragraph","spans":[{"id":"spn-34100","marks":["code"],"text":"adr/ADR-0005-deployment-immutability.md"},{"id":"spn-34101","text":" — Immutable deployment records + "},{"id":"spn-34102","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-34103","text":" routing pointer + rollback."}]}],"id":"blk-30730","kind":"list-item"},{"blocks":[{"id":"blk-30733","kind":"paragraph","spans":[{"id":"spn-34104","marks":["code"],"text":"adr/ADR-0006-invocation-protocol.md"},{"id":"spn-34105","text":" — Canonical "},{"id":"spn-34106","marks":["code"],"text":"invoke/v1"},{"id":"spn-34107","text":" protocol, session semantics, and SSE streaming model."}]}],"id":"blk-30732","kind":"list-item"},{"blocks":[{"id":"blk-30735","kind":"paragraph","spans":[{"id":"spn-34108","marks":["code"],"text":"adr/ADR-0007-entitlements-and-limits.md"},{"id":"spn-34109","text":" — Tier entitlements, runtime gating, and limit enforcement strategy."}]}],"id":"blk-30734","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30736","kind":"heading","level":2,"spans":[{"id":"spn-34110","text":"Progress logs"}]},{"id":"blk-30737","kind":"paragraph","spans":[{"id":"spn-34111","text":"Daily implementation progress logs live in "},{"id":"spn-34112","marks":["code"],"text":"../progress/"},{"id":"spn-34113","text":" (relative to this folder). These logs are "},{"id":"spn-34114","marks":["bold"],"text":"non-normative"},{"id":"spn-34115","text":" and exist to track execution against this spec."}]},{"id":"blk-30738","kind":"paragraph","spans":[{"id":"spn-34116","text":"Recommended convention:"}]},{"id":"blk-30739","items":[{"blocks":[{"id":"blk-30741","kind":"paragraph","spans":[{"id":"spn-34117","text":"One file per day: "},{"id":"spn-34118","marks":["code"],"text":"YYYY-MM-DD.md"}]}],"id":"blk-30740","kind":"list-item"},{"blocks":[{"id":"blk-30743","kind":"paragraph","spans":[{"id":"spn-34119","text":"Include: what shipped, what changed, decisions made (with links to ADRs/spec sections), and next steps."}]}],"id":"blk-30742","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30744","kind":"heading","level":2,"spans":[{"id":"spn-34120","text":"Normative conventions used in this spec"}]},{"id":"blk-30745","items":[{"blocks":[{"id":"blk-30747","kind":"paragraph","spans":[{"id":"spn-34121","marks":["bold"],"text":"MUST / MUST NOT / SHOULD / MAY"},{"id":"spn-34122","text":" are used intentionally."}]}],"id":"blk-30746","kind":"list-item"},{"blocks":[{"id":"blk-30749","kind":"paragraph","spans":[{"id":"spn-34123","marks":["bold"],"text":"Control plane"},{"id":"spn-34124","text":" = auth, DB, deploy orchestration, billing, telemetry ingestion/aggregation, UI API."}]}],"id":"blk-30748","kind":"list-item"},{"blocks":[{"id":"blk-30751","kind":"paragraph","spans":[{"id":"spn-34125","marks":["bold"],"text":"Data plane"},{"id":"spn-34126","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-30750","kind":"list-item"},{"blocks":[{"id":"blk-30753","kind":"paragraph","spans":[{"id":"spn-34127","marks":["bold"],"text":"Session IDs"},{"id":"spn-34128","text":" are "},{"id":"spn-34129","marks":["bold"],"text":"opaque"},{"id":"spn-34130","text":" and runtime-specific; the control plane and clients must not parse them."}]}],"id":"blk-30752","kind":"list-item"},{"blocks":[{"id":"blk-30755","kind":"paragraph","spans":[{"id":"spn-34131","marks":["bold"],"text":"Deployments"},{"id":"spn-34132","text":" are "},{"id":"spn-34133","marks":["bold"],"text":"immutable"},{"id":"spn-34134","text":" records; routing is via the agent’s single "},{"id":"spn-34135","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-34136","text":"."}]}],"id":"blk-30754","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30756","kind":"heading","level":2,"spans":[{"id":"spn-34137","text":"Implementation “starter checklist” (quick reference)"}]},{"id":"blk-30757","kind":"paragraph","spans":[{"id":"spn-34138","text":"Minimum v1 must-haves:"}]},{"id":"blk-30758","items":[{"blocks":[{"id":"blk-30760","kind":"paragraph","spans":[{"id":"spn-34139","text":"Auth + tenant isolation across all endpoints."}]}],"id":"blk-30759","kind":"list-item"},{"blocks":[{"id":"blk-30762","kind":"paragraph","spans":[{"id":"spn-34140","text":"Agent CRUD."}]}],"id":"blk-30761","kind":"list-item"},{"blocks":[{"id":"blk-30764","kind":"paragraph","spans":[{"id":"spn-34141","text":"Immutable deployments + rollback (active pointer)."}]}],"id":"blk-30763","kind":"list-item"},{"blocks":[{"id":"blk-30766","kind":"paragraph","spans":[{"id":"spn-34142","text":"Invocation gateway with consistent "},{"id":"spn-34143","marks":["code"],"text":"invoke/v1"},{"id":"spn-34144","text":" contract (non-streaming required; streaming recommended)."}]}],"id":"blk-30765","kind":"list-item"},{"blocks":[{"id":"blk-30768","kind":"paragraph","spans":[{"id":"spn-34145","text":"Telemetry ingestion with integrity protection (deployment-scoped signing) and ownership cross-check."}]}],"id":"blk-30767","kind":"list-item"},{"blocks":[{"id":"blk-30770","kind":"paragraph","spans":[{"id":"spn-34146","text":"Usage aggregation by billing period + dashboard usage views."}]}],"id":"blk-30769","kind":"list-item"},{"blocks":[{"id":"blk-30772","kind":"paragraph","spans":[{"id":"spn-34147","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-30771","kind":"list-item"},{"blocks":[{"id":"blk-30774","kind":"paragraph","spans":[{"id":"spn-34148","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-30773","kind":"list-item"},{"blocks":[{"id":"blk-30776","kind":"paragraph","spans":[{"id":"spn-34149","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-30775","kind":"list-item"},{"blocks":[{"id":"blk-30778","kind":"paragraph","spans":[{"id":"spn-34150","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-30777","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30779","kind":"heading","level":2,"spans":[{"id":"spn-34151","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-30780","items":[{"blocks":[{"id":"blk-30782","kind":"paragraph","spans":[{"id":"spn-34152","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-30781","kind":"list-item"},{"blocks":[{"id":"blk-30784","kind":"paragraph","spans":[{"id":"spn-34153","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-30783","kind":"list-item"},{"blocks":[{"id":"blk-30786","kind":"paragraph","spans":[{"id":"spn-34154","text":"Public agents / unauthenticated invocation (unless explicitly added later with API keys)."}]}],"id":"blk-30785","kind":"list-item"},{"blocks":[{"id":"blk-30788","kind":"paragraph","spans":[{"id":"spn-34155","text":"Full prompt/response storage (telemetry is numeric and metadata-focused by default)."}]}],"id":"blk-30787","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30789","kind":"heading","level":2,"spans":[{"id":"spn-34156","text":"Notes on older drafts"}]},{"id":"blk-30790","kind":"paragraph","spans":[{"id":"spn-34157","text":"This folder is the canonical spec. Earlier rough drafts (if any remain) are useful as background, but "},{"id":"spn-34158","marks":["bold"],"text":"implementation should follow this folder"},{"id":"spn-34159","text":"."}]},{"id":"blk-30791","kind":"paragraph","spans":[{"id":"spn-34160","text":"If any contradictions are found: 1. Prefer "},{"id":"spn-34161","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-34162","text":" and "},{"id":"spn-34163","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-34164","text":" for canonical behavior. 2. Prefer ADRs for “why” and invariants. 3. Treat earlier drafts as non-normative."}]},{"id":"blk-30792","kind":"heading","level":2,"spans":[{"id":"spn-34165","text":"PULSE Loop Manifest"}]},{"id":"blk-30793","kind":"paragraph","spans":[{"id":"spn-34166","text":"WebHost.Systems is a "},{"id":"spn-34167","marks":["bold"],"text":"PULSE-conforming loop"},{"id":"spn-34168","text":" under OS-010. As the hosting layer for the entire [&] ecosystem, its loop encodes the "},{"id":"spn-34169","marks":["bold"],"text":"deploy → invoke → meter → bill"},{"id":"spn-34170","text":" rhythm. Unlike other loops in the portfolio it is the only one whose substrates include both Cloudflare Workers and AWS AgentCore (per ADR-0001), and its "},{"id":"spn-34171","marks":["code"],"text":"act"},{"id":"spn-34172","text":" phase is intentionally pluggable through the Runtime Provider Interface (per "},{"id":"spn-34173","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-34174","text":")."}]},{"id":"blk-30794","kind":"paragraph","spans":[{"id":"spn-34175","marks":["bold"],"text":"Loop ID:"},{"id":"spn-34176","text":" "},{"id":"spn-34177","marks":["code"],"text":"webhost.deploy_invoke"},{"id":"spn-34178","text":" "},{"id":"spn-34179","marks":["bold"],"text":"Loop name:"},{"id":"spn-34180","text":" WebHost.Systems Deploy/Invoke Loop "},{"id":"spn-34181","marks":["bold"],"text":"Version:"},{"id":"spn-34182","text":" 1.0.0 "},{"id":"spn-34183","marks":["bold"],"text":"Owner:"},{"id":"spn-34184","text":" webhost.systems "},{"id":"spn-34185","marks":["bold"],"text":"Workspace scope:"},{"id":"spn-34186","text":" required"}]},{"id":"blk-30795","kind":"paragraph","spans":[{"id":"spn-34187","marks":["bold"],"text":"Phases (5 canonical kinds):"}]},{"head":[{"id":"blk-30797","spans":[{"id":"spn-34188","text":"Phase ID"}]},{"id":"blk-30798","spans":[{"id":"spn-34189","text":"Kind"}]},{"id":"blk-30799","spans":[{"id":"spn-34190","text":"Description"}]}],"id":"blk-30796","kind":"table","rows":[[{"id":"blk-30800","spans":[{"id":"spn-34191","marks":["code"],"text":"retrieve_deployment"}]},{"id":"blk-30801","spans":[{"id":"spn-34192","marks":["code"],"text":"retrieve"}]},{"id":"blk-30802","spans":[{"id":"spn-34193","text":"Resolve "},{"id":"spn-34194","marks":["code"],"text":"agent_id → activeDeploymentId"},{"id":"spn-34195","text":" from Supabase control plane (per ADR-0005)"}]}],[{"id":"blk-30803","spans":[{"id":"spn-34196","marks":["code"],"text":"route_runtime"}]},{"id":"blk-30804","spans":[{"id":"spn-34197","marks":["code"],"text":"route"}]},{"id":"blk-30805","spans":[{"id":"spn-34198","text":"Select runtime provider via RPI (Cloudflare default, AgentCore premium, others as adapters)"}]}],[{"id":"blk-30806","spans":[{"id":"spn-34199","marks":["code"],"text":"act_invoke"}]},{"id":"blk-30807","spans":[{"id":"spn-34200","marks":["code"],"text":"act"}]},{"id":"blk-30808","spans":[{"id":"spn-34201","text":"Execute "},{"id":"spn-34202","marks":["code"],"text":"invoke/v1"},{"id":"spn-34203","text":" (per ADR-0006); stream SSE response if requested; capture telemetry"}]}],[{"id":"blk-30809","spans":[{"id":"spn-34204","marks":["code"],"text":"learn_telemetry"}]},{"id":"blk-30810","spans":[{"id":"spn-34205","marks":["code"],"text":"learn"}]},{"id":"blk-30811","spans":[{"id":"spn-34206","text":"Aggregate signed telemetry events; update usage counters; check tier entitlements"}]}],[{"id":"blk-30812","spans":[{"id":"spn-34207","marks":["code"],"text":"consolidate_billing"}]},{"id":"blk-30813","spans":[{"id":"spn-34208","marks":["code"],"text":"consolidate"}]},{"id":"blk-30814","spans":[{"id":"spn-34209","text":"Periodic aggregation by billing period; retention pruning; cost estimation rollups"}]}]]},{"id":"blk-30815","kind":"paragraph","spans":[{"id":"spn-34210","marks":["bold"],"text":"Closure:"},{"id":"spn-34211","text":" "},{"id":"spn-34212","marks":["code"],"text":"consolidate_billing → retrieve_deployment"},{"id":"spn-34213","text":" via Supabase, guarantee "},{"id":"spn-34214","marks":["code"],"text":"eventual"},{"id":"spn-34215","text":"."}]},{"id":"blk-30816","kind":"paragraph","spans":[{"id":"spn-34216","marks":["bold"],"text":"Cadence:"},{"id":"spn-34217","text":" Primary "},{"id":"spn-34218","marks":["code"],"text":"event"},{"id":"spn-34219","text":" (every invocation). Fallback "},{"id":"spn-34220","marks":["code"],"text":"periodic"},{"id":"spn-34221","text":" (billing aggregation, retention sweeps)."}]},{"id":"blk-30817","kind":"paragraph","spans":[{"id":"spn-34222","marks":["bold"],"text":"Substrates:"}]},{"id":"blk-30818","items":[{"blocks":[{"id":"blk-30820","kind":"paragraph","spans":[{"id":"spn-34223","marks":["code"],"text":"memory"},{"id":"spn-34224","text":": "},{"id":"spn-34225","marks":["code"],"text":"graphonomous://workspace/{ws_id}"},{"id":"spn-34226","text":" (optional, for hosted MCP sidecars)"}]}],"id":"blk-30819","kind":"list-item"},{"blocks":[{"id":"blk-30822","kind":"paragraph","spans":[{"id":"spn-34227","marks":["code"],"text":"policy"},{"id":"spn-34228","text":": "},{"id":"spn-34229","marks":["code"],"text":"delegatic://workspace/{ws_id}"},{"id":"spn-34230","text":" (tier entitlements, runtime gating)"}]}],"id":"blk-30821","kind":"list-item"},{"blocks":[{"id":"blk-30824","kind":"paragraph","spans":[{"id":"spn-34231","marks":["code"],"text":"audit"},{"id":"spn-34232","text":": "},{"id":"spn-34233","marks":["code