":"blk-50677","spans":[{"id":"spn-79279","marks":["code"],"text":"route_runtime"}]},{"id":"blk-50678","spans":[{"id":"spn-79280","marks":["code"],"text":"route"}]},{"id":"blk-50679","spans":[{"id":"spn-79281","text":"Select runtime provider via RPI (Cloudflare default, AgentCore premium, others as adapters)"}]}],[{"id":"blk-50680","spans":[{"id":"spn-79282","marks":["code"],"text":"act_invoke"}]},{"id":"blk-50681","spans":[{"id":"spn-79283","marks":["code"],"text":"act"}]},{"id":"blk-50682","spans":[{"id":"spn-79284","text":"Execute "},{"id":"spn-79285","marks":["code"],"text":"invoke/v1"},{"id":"spn-79286","text":" (per ADR-0006); stream SSE response if requested; capture telemetry"}]}],[{"id":"blk-50683","spans":[{"id":"spn-79287","marks":["code"],"text":"learn_telemetry"}]},{"id":"blk-50684","spans":[{"id":"spn-79288","marks":["code"],"text":"learn"}]},{"id":"blk-50685","spans":[{"id":"spn-79289","text":"Aggregate signed telemetry events; update usage counters; check tier entitlements"}]}],[{"id":"blk-50686","spans":[{"id":"spn-79290","marks":["code"],"text":"consolidate_billing"}]},{"id":"blk-50687","spans":[{"id":"spn-79291","marks":["code"],"text":"consolidate"}]},{"id":"blk-50688","spans":[{"id":"spn-79292","text":"Periodic aggregation by billing period; retention pruning; cost estimation rollups"}]}]]},{"id":"blk-50689","kind":"paragraph","spans":[{"id":"spn-79293","marks":["bold"],"text":"Closure:"},{"id":"spn-79294","text":" "},{"id":"spn-79295","marks":["code"],"text":"consolidate_billing → retrieve_deployment"},{"id":"spn-79296","text":" via Supabase, guarantee "},{"id":"spn-79297","marks":["code"],"text":"eventual"},{"id":"spn-79298","text":"."}]},{"id":"blk-50690","kind":"paragraph","spans":[{"id":"spn-79299","marks":["bold"],"text":"Cadence:"},{"id":"spn-79300","text":" Primary "},{"id":"spn-79301","marks":["code"],"text":"event"},{"id":"spn-79302","text":" (every invocation). Fallback "},{"id":"spn-79303","marks":["code"],"text":"periodic"},{"id":"sp