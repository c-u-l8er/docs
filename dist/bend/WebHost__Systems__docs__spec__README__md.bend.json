,{"id":"spn-36552","marks":["code"],"text":"feedback_immutability"},{"id":"spn-36553","text":" in PULSE terms."}]},{"id":"blk-31803","kind":"paragraph","spans":[{"id":"spn-36554","marks":["bold"],"text":"Cross-loop connections:"}]},{"id":"blk-31804","items":[{"blocks":[{"id":"blk-31806","kind":"paragraph","spans":[{"id":"spn-36555","marks":["code"],"text":"usage_to_billing"},{"id":"spn-36556","text":" — "},{"id":"spn-36557","marks":["code"],"text":"consolidate_billing"},{"id":"spn-36558","text":" emits "},{"id":"spn-36559","marks":["code"],"text":"OutcomeSignal"},{"id":"spn-36560","text":" (usage rollup) to billing webhooks"}]}],"id":"blk-31805","kind":"list-item"},{"blocks":[{"id":"blk-31808","kind":"paragraph","spans":[{"id":"spn-36561","marks":["code"],"text":"entitlement_violation"},{"id":"spn-36562","text":" — "},{"id":"spn-36563","marks":["code"],"text":"route_runtime"},{"id":"spn-36564","text":" emits "},{"id":"spn-36565","marks":["code"],"text":"OutcomeSignal"},{"id":"spn-36566","text":" (gated runtime requested) to "},{"id":"spn-36567","marks":["code"],"text":"delegatic.governance.learn_drift"}]}],"id":"blk-31807","kind":"list-item"},{"blocks":[{"id":"blk-31810","kind":"paragraph","spans":[{"id":"spn-36568","marks":["code"],"text":"deploy_to_fleetprompt"},{"id":"spn-36569","text":" — optional "},{"id":"spn-36570","marks":["code"],"text":"ConsolidationEvent"},{"id":"spn-36571","text":" from "},{"id":"spn-36572","marks":["code"],"text":"consolidate_billing"},{"id":"spn-36573","text":" to "},{"id":"spn-36574","marks":["code"],"text":"fleetprompt.publish"},{"id":"spn-36575","text":" for usage-based trust signals"}]}],"id":"blk-31809","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31811","kind":"paragraph","spans":[{"id":"spn-36576","marks":["bold"],"text":"Why this matters:"},{"id":"spn-36577","text":" WebHost.Systems is the only loop in the portfolio with "},{"id":"spn-36578","marks":["bold"],"text":"multiple swappable runtime providers"},{"id":"spn-36579","text":" in its "},{"id":"spn-36580","marks":["code"],"text":"act"},{"id":"spn-36581","text":" phase. PULSE's "},{"id":"spn-36582","marks":["code"],"text":"phase"},{"id":"spn-36583","text":" schema allows the runtime to be opaque (declared via "},{"id":"spn-36584","marks":["code"],"text":"signature"},{"id":"spn-36585","text":" and "},{"id":"spn-36586","marks":["code"],"text":"policy_check"},{"id":"spn-36587","text":" fields) — the manifest stays stable even as the RPI gains new adapters. This is the pattern other loops should follow when their "},{"id":"spn-36588","marks":["code"],"text":"act"},{"id":"spn-36589","text":" phase depends on third-party infrastructure."}]},{"id":"blk-31812","kind":"paragraph","spans":[{"id":"spn-36590","text":"See "},{"id":"spn-36591","marks":["code"],"text":"OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-36592","text":" in "},{"id":"spn-36593","marks":["code"],"text":"/home/travis/ProjectAmp2/opensentience.org/docs/spec/"},{"id":"spn-36594","text":" for the full PULSE protocol spec."}]}],"edges":[],"id":"bagaaieravwcjkymarlfm4mq5f23ezpsfo4ogbwcj5lwmtnpj7537dxwpzrya","vocabulary":"ampersand.docs.fs.v1"}