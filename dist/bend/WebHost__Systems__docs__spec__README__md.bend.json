spn-76970","text":" (gated runtime requested) to "},{"id":"spn-76971","marks":["code"],"text":"delegatic.governance.learn_drift"}]}],"id":"blk-49994","kind":"list-item"},{"blocks":[{"id":"blk-49997","kind":"paragraph","spans":[{"id":"spn-76972","marks":["code"],"text":"deploy_to_fleetprompt"},{"id":"spn-76973","text":" — optional "},{"id":"spn-76974","marks":["code"],"text":"ConsolidationEvent"},{"id":"spn-76975","text":" from "},{"id":"spn-76976","marks":["code"],"text":"consolidate_billing"},{"id":"spn-76977","text":" to "},{"id":"spn-76978","marks":["code"],"text":"fleetprompt.publish"},{"id":"spn-76979","text":" for usage-based trust signals"}]}],"id":"blk-49996","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49998","kind":"paragraph","spans":[{"id":"spn-76980","marks":["bold"],"text":"Why this matters:"},{"id":"spn-76981","text":" WebHost.Systems is the only loop in the portfolio with "},{"id":"spn-76982","marks":["bold"],"text":"multiple swappable runtime providers"},{"id":"spn-76983","text":" in its "},{"id":"spn-76984","marks":["code"],"text":"act"},{"id":"spn-76985","text":" phase. PULSE's "},{"id":"spn-76986","marks":["code"],"text":"phase"},{"id":"spn-76987","text":" schema allows the runtime to be opaque (declared via "},{"id":"spn-76988","marks":["code"],"text":"signature"},{"id":"spn-76989","text":" and "},{"id":"spn-76990","marks":["code"],"text":"policy_check"},{"id":"spn-76991","text":" fields) — the manifest stays stable even as the RPI gains new adapters. This is the pattern other loops should follow when their "},{"id":"spn-76992","marks":["code"],"text":"act"},{"id":"spn-76993","text":" phase depends on third-party infrastructure."}]},{"id":"blk-49999","kind":"paragraph","spans":[{"id":"spn-76994","text":"See "},{"id":"spn-76995","marks":["code"],"text":"OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-76996","text":" in "},{"id":"spn-76997","marks":["code"],"text":"/home/travis/ProjectAmp2/opensentience.org/docs/spec/"},{"id":"spn-76998","text":" for the full PULSE protocol spec."}]}],"edges":[],"id":"bagaaiera2dot6owclepwvcg33tytawzikt33c5ngcjugpsr7zdtzc3ifxf4q","vocabulary":"ampersand.docs.fs.v1"}