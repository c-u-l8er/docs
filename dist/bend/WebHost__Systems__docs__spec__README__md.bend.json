{"bendscript":"0.1","blocks":[{"id":"blk-30687","kind":"heading","level":1,"spans":[{"id":"spn-34048","text":"webhost.systems — Spec v1 (Implementation-Ready Document Set)"}]},{"id":"blk-30688","kind":"paragraph","spans":[{"id":"spn-34049","text":"Version: 1.0 Status: Implementation-ready draft Audience: Engineering Last updated: 2026-01-21"}]},{"id":"blk-30689","kind":"paragraph","spans":[{"id":"spn-34050","text":"This folder is the "},{"id":"spn-34051","marks":["bold"],"text":"canonical v1 specification"},{"id":"spn-34052","text":" for implementing webhost.systems from scratch. It consolidates product + technical requirements into a small set of normative documents with ADRs (Architecture Decision Records). If you implement only what’s in these files, you should be able to build a working v1."}]},{"id":"blk-30690","kind":"heading","level":2,"spans":[{"id":"spn-34053","text":"How to use this spec (recommended reading order)"}]},{"id":"blk-30691","kind":"paragraph","spans":[{"id":"spn-34054","text":"1. "},{"id":"spn-34055","marks":["bold"],"text":"Start here (overall system)"}]},{"id":"blk-30692","items":[{"blocks":[{"id":"blk-30694","kind":"paragraph","spans":[{"id":"spn-34056","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-34057","text":" — the single “master” engineering spec: scope, architecture, flows, core requirements, acceptance criteria."}]}],"id":"blk-30693","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30695","kind":"paragraph","spans":[{"id":"spn-34058","text":"2. "},{"id":"spn-34059","marks":["bold"],"text":"Implement your API surface and contracts"}]},{"id":"blk-30696","items":[{"blocks":[{"id":"blk-30698","kind":"paragraph","spans":[{"id":"spn-34060","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-34061","text":" — normalized request/response shapes, error envelope, idempotency, pagination, invocation gateway, telemetry ingestion, and billing/webhook contracts."}]}],"id":"blk-30697","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30699","kind":"paragraph","spans":[{"id":"spn-34062","text":"3. "},{"id":"spn-34063","marks":["bold"],"text":"Implement runtime portability"}]},{"id":"blk-30700","items":[{"blocks":[{"id":"blk-30702","kind":"paragraph","spans":[{"id":"spn-34064","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-34065","text":" — Runtime Provider Interface (RPI) that all runtimes must implement, plus adapter guidance (including AgentCore TypeScript adapter guidance using "},{"id":"spn-34066","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-34067","text":", and notes on the "},{"id":"spn-34068","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-34069","text":" tools SDK ecosystem)."}]}],"id":"blk-30701","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30703","kind":"paragraph","spans":[{"id":"spn-34070","text":"4. "},{"id":"spn-34071","marks":["bold"],"text":"Build your control-plane data layer"}]},{"id":"blk-30704","items":[{"blocks":[{"id":"blk-30706","kind":"paragraph","spans":[{"id":"spn-34072","marks":["code"],"text":"30_DATA_MODEL_SUPABASE.md"},{"id":"spn-34073","text":" — Supabase/PostgreSQL schema, indexes, invariants, RLS policies, retention and deletion semantics."}]}],"id":"blk-30705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30707","kind":"paragraph","spans":[{"id":"spn-34074","text":"5. "},{"id":"spn-34075","marks":["bold"],"text":"Lock down security and secrets"}]},{"id":"blk-30708","items":[{"blocks":[{"id":"blk-30710","kind":"paragraph","spans":[{"id":"spn-34076","marks":["code"],"text":"40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-34077","text":" — threat model, secrets strategy requirements, telemetry integrity, webhook integrity, artifact safety, acceptance criteria."}]}],"id":"blk-30709","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30711","kind":"paragraph","spans":[{"id":"spn-34078","text":"6. "},{"id":"spn-34079","marks":["bold"],"