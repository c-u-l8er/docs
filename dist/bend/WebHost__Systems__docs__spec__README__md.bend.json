{"bendscript":"0.1","blocks":[{"id":"blk-31172","kind":"heading","level":1,"spans":[{"id":"spn-35221","text":"webhost.systems — Spec v1 (Implementation-Ready Document Set)"}]},{"id":"blk-31173","kind":"paragraph","spans":[{"id":"spn-35222","text":"Version: 1.0 Status: Implementation-ready draft Audience: Engineering Last updated: 2026-01-21"}]},{"id":"blk-31174","kind":"paragraph","spans":[{"id":"spn-35223","text":"This folder is the "},{"id":"spn-35224","marks":["bold"],"text":"canonical v1 specification"},{"id":"spn-35225","text":" for implementing webhost.systems from scratch. It consolidates product + technical requirements into a small set of normative documents with ADRs (Architecture Decision Records). If you implement only what’s in these files, you should be able to build a working v1."}]},{"id":"blk-31175","kind":"heading","level":2,"spans":[{"id":"spn-35226","text":"How to use this spec (recommended reading order)"}]},{"id":"blk-31176","kind":"paragraph","spans":[{"id":"spn-35227","text":"1. "},{"id":"spn-35228","marks":["bold"],"text":"Start here (overall system)"}]},{"id":"blk-31177","items":[{"blocks":[{"id":"blk-31179","kind":"paragraph","spans":[{"id":"spn-35229","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-35230","text":" — the single “master” engineering spec: scope, architecture, flows, core requirements, acceptance criteria."}]}],"id":"blk-31178","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31180","kind":"paragraph","spans":[{"id":"spn-35231","text":"2. "},{"id":"spn-35232","marks":["bold"],"text":"Implement your API surface and contracts"}]},{"id":"blk-31181","items":[{"blocks":[{"id":"blk-31183","kind":"paragraph","spans":[{"id":"spn-35233","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-35234","text":" — normalized request/response shapes, error envelope, idempotency, pagination, invocation gateway, telemetry ingestion, and billing/webhook contracts."}]}],"id":"blk-31182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31184","kind":"paragraph","spans":[{"id":"spn-35235","text":"3. "},{"id":"spn-35236","marks":["bold"],"text":"Implement runtime portability"}]},{"id":"blk-31185","items":[{"blocks":[{"id":"blk-31187","kind":"paragraph","spans":[{"id":"spn-35237","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-35238","text":" — Runtime Provider Interface (RPI) that all runtimes must implement, plus adapter guidance (including AgentCore TypeScript adapter guidance using "},{"id":"spn-35239","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-35240","text":", and notes on the "},{"id":"spn-35241","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-35242","text":" tools SDK ecosystem)."}]}],"id":"blk-31186","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31188","kind":"paragraph","spans":[{"id":"spn-35243","text":"4. "},{"id":"spn-35244","marks":["bold"],"text":"Build your control-plane data layer"}]},{"id":"blk-31189","items":[{"blocks":[{"id":"blk-31191","kind":"paragraph","spans":[{"id":"spn-35245","marks":["code"],"text":"30_DATA_MODEL_SUPABASE.md"},{"id":"spn-35246","text":" — Supabase/PostgreSQL schema, indexes, invariants, RLS policies, retention and deletion semantics."}]}],"id":"blk-31190","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31192","kind":"paragraph","spans":[{"id":"spn-35247","text":"5. "},{"id":"spn-35248","marks":["bold"],"text":"Lock down security and secrets"}]},{"id":"blk-31193","items":[{"blocks":[{"id":"blk-31195","kind":"paragraph","spans":[{"id":"spn-35249","marks":["code"],"text":"40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-35250","text":" — threat model, secrets strategy requirements, telemetry integrity, webhook integrity, artifact safety, acceptance criteria."}]}],"id":"blk-31194","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31196","kind":"paragraph","spans":[{"id":"spn-35251","text":"6. "},{"id":"spn-35252","marks":["bold"],"text":"Build metering, billing UX, and enforcement"}]},{"id":"blk-31197","items":[{"blocks":[{"id":"blk-31199","kind":"paragraph","spans":[{"id":"spn-35253","marks":["code"],"text":"50_OBSERVABILITY_BILLING_LIMITS.md"},{"id":"spn-35254","text":" — telemetry pipeline, aggregation model, cost estimation (estimated in v1), tier entitlements, runtime gating, limit enforcement algorithms."}]}],"id":"blk-31198","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31200","kind":"paragraph","spans":[{"id":"spn-35255","text":"7. "},{"id":"spn-35256","marks":["bold"],"text":"Verify correctness end-to-end"}]},{"id":"blk-31201","items":[{"blocks":[{"id":"blk-31203","kind":"paragraph","spans":[{"id":"spn-35257","marks":["code"],"text":"60_TESTING_ACCEPTANCE.md"},{"id":"spn-35258","text":" — unit/integration/E2E test plan + release gates and system-level definition of done."}]}],"id":"blk-31202","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31204","kind":"heading","level":2,"spans":[{"id":"spn-35259","text":"Architecture Decision Records (ADRs)"}]},{"id":"blk-31205","kind":"paragraph","spans":[{"id":"spn-35260","text":"ADRs document the “why” behind major choices and define additional constraints that implementations must satisfy."}]},{"id":"blk-31206","items":[{"blocks":[{"id":"blk-31208","kind":"paragraph","spans":[{"id":"spn-35261","marks":["code"],"text":"adr/ADR-0001-multi-runtime.md"},{"id":"spn-35262","text":" — Multi-runtime strategy (Cloudflare default + AgentCore premium), explicitly TypeScript-first across both runtimes (AgentCore SDKs: "},{"id":"spn-35263","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-35264","text":" and "},{"id":"spn-35265","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-35266","text":")."}]}],"id":"blk-31207","kind":"list-item"},{"blocks":[{"id":"blk-31210","kind":"paragraph","spans":[{"id":"spn-35267","marks":["code"],"text":"adr/ADR-0002-supabase-control-plane.md"},{"id":"spn-35268","text":" — Supabase as control-plane backend (supersedes original Convex choice); Edge Functions for server-only logic."}]}],"id":"blk-31209","kind":"list-item"},{"blocks":[{"id":"blk-31212","kind":"paragraph","spans":[{"id":"spn-35269","marks":["code"],"text":"adr/ADR-0003-secrets-strategy.md"},{"id":"spn-35270","text":" — No plaintext secrets in DB; provider-native secret injection; write-only secrets API."}]}],"id":"blk-31211","kind":"list-item"},{"blocks":[{"id":"blk-31214","kind":"paragraph","spans":[{"id":"spn-35271","marks":["code"],"text":"adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-35272","text":" — Deployment-scoped signed telemetry events + ownership cross-check."}]}],"id":"blk-31213","kind":"list-item"},{"blocks":[{"id":"blk-31216","kind":"paragraph","spans":[{"id":"spn-35273","marks":["code"],"text":"adr/ADR-0005-deployment-immutability.md"},{"id":"spn-35274","text":" — Immutable deployment records + "},{"id":"spn-35275","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-35276","text":" routing pointer + rollback."}]}],"id":"blk-31215","kind":"list-item"},{"blocks":[{"id":"blk-31218","kind":"paragraph","spans":[{"id":"spn-35277","marks":["code"],"text":"adr/ADR-0006-invocation-protocol.md"},{"id":"spn-35278","text":" — Canonical "},{"id":"spn-35279","marks":["code"],"text":"invoke/v1"},{"id":"spn-35280","text":" protocol, session semantics, and SSE streaming model."}]}],"id":"blk-31217","kind":"list-item"},{"blocks":[{"id":"blk-31220","kind":"paragraph","spans":[{"id":"spn-35281","marks":["code"],"text":"adr/ADR-0007-entitlements-and-limits.md"},{"id":"spn-35282","text":" — Tier entitlements, runtime gating, and limit enforcement strategy."}]}],"id":"blk-31219","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31221","kind":"heading","level":2,"spans":[{"id":"spn-35283","text":"Progress logs"}]},{"id":"blk-31222","kind":"paragraph","spans":[{"id":"spn-35284","text":"Daily implementation progress logs live in "},{"id":"spn-35285","marks":["code"],"text":"../progress/"},{"id":"spn-35286","text":" (relative to this folder). These logs are "},{"id":"spn-35287","marks":["bold"],"text":"non-normative"},{"id":"spn-35288","text":" and exist to track execution against this spec."}]},{"id":"blk-31223","kind":"paragraph","spans":[{"id":"spn-35289","text":"Recommended convention:"}]},{"id":"blk-31224","items":[{"blocks":[{"id":"blk-31226","kind":"paragraph","spans":[{"id":"spn-35290","text":"One file per day: "},{"id":"spn-35291","marks":["code"],"text":"YYYY-MM-DD.md"}]}],"id":"blk-31225","kind":"list-item"},{"blocks":[{"id":"blk-31228","kind":"paragraph","spans":[{"id":"spn-35292","text":"Include: what shipped, what changed, decisions made (with links to ADRs/spec sections), and next steps."}]}],"id":"blk-31227","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31229","kind":"heading","level":2,"spans":[{"id":"spn-35293","text":"Normative conventions used in this spec"}]},{"id":"blk-31230","items":[{"blocks":[{"id":"blk-31232","kind":"paragraph","spans":[{"id":"spn-35294","marks":["bold"],"text":"MUST / MUST NOT / SHOULD / MAY"},{"id":"spn-35295","text":" are used intentionally."}]}],"id":"blk-31231","kind":"list-item"},{"blocks":[{"id":"blk-31234","kind":"paragraph","spans":[{"id":"spn-35296","marks":["bold"],"text":"Control plane"},{"id":"spn-35297","text":" = auth, DB, deploy orchestration, billing, telemetry ingestion/aggregation, UI API."}]}],"id":"blk-31233","kind":"list-item"},{"blocks":[{"id":"blk-31236","kind":"paragraph","spans":[{"id":"spn-35298","marks":["bold"],"text":"Data plane"},{"id":"spn-35299","text":" = runtime provider execution environments (Cloudflare Workers/DO, AWS AgentCore)."}]}],"id":"blk-31235","kind":"list-item"},{"blocks":[{"id":"blk-31238","kind":"paragraph","spans":[{"id":"spn-35300","marks":["bold"],"text":"Session IDs"},{"id":"spn-35301","text":" are "},{"id":"spn-35302","marks":["bold"],"text":"opaque"},{"id":"spn-35303","text":" and runtime-specific; the control plane and clients must not parse them."}]}],"id":"blk-31237","kind":"list-item"},{"blocks":[{"id":"blk-31240","kind":"paragraph","spans":[{"id":"spn-35304","marks":["bold"],"text":"Deployments"},{"id":"spn-35305","text":" are "},{"id":"spn-35306","marks":["bold"],"text":"immutable"},{"id":"spn-35307","text":" records; routing is via the agent’s single "},{"id":"spn-35308","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-35309","text":"."}]}],"id":"blk-31239","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31241","kind":"heading","level":2,"spans":[{"id":"spn-35310","text":"Implementation “starter checklist” (quick reference)"}]},{"id":"blk-31242","kind":"paragraph","spans":[{"id":"spn-35311","text":"Minimum v1 must-haves:"}]},{"id":"blk-31243","items":[{"blocks":[{"id":"blk-31245","kind":"paragraph","spans":[{"id":"spn-35312","text":"Auth + tenant isolation across all endpoints."}]}],"id":"blk-31244","kind":"list-item"},{"blocks":[{"id":"blk-31247","kind":"paragraph","spans":[{"id":"spn-35313","text":"Agent CRUD."}]}],"id":"blk-31246","kind":"list-item"},{"blocks":[{"id":"blk-31249","kind":"paragraph","spans":[{"id":"spn-35314","text":"Immutable deployments + rollback (active pointer)."}]}],"id":"blk-31248","kind":"list-item"},{"blocks":[{"id":"blk-31251","kind":"paragraph","spans":[{"id":"spn-35315","text":"Invocation gateway with consistent "},{"id":"spn-35316","marks":["code"],"text":"invoke/v1"},{"id":"spn-35317","text":" contract (non-streaming required; streaming recommended)."}]}],"id":"blk-31250","kind":"list-item"},{"blocks":[{"id":"blk-31253","kind":"paragraph","spans":[{"id":"spn-35318","text":"Telemetry ingestion with integrity protection (deployment-scoped signing) and ownership cross-check."}]}],"id":"blk-31252","kind":"list-item"},{"blocks":[{"id":"blk-31255","kind":"paragraph","spans":[{"id":"spn-35319","text":"Usage aggregation by billing period + dashboard usage views."}]}],"id":"blk-31254","kind":"list-item"},{"blocks":[{"id":"blk-31257","kind":"paragraph","spans":[{"id":"spn-35320","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-31256","kind":"list-item"},{"blocks":[{"id":"blk-31259","kind":"paragraph","spans":[{"id":"spn-35321","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-31258","kind":"list-item"},{"blocks":[{"id":"blk-31261","kind":"paragraph","spans":[{"id":"spn-35322","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-31260","kind":"list-item"},{"blocks":[{"id":"blk-31263","kind":"paragraph","spans":[{"id":"spn-35323","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-31262","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31264","kind":"heading","level":2,"spans":[{"id":"spn-35324","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-31265","items":[{"blocks":[{"id":"blk-31267","kind":"paragraph","spans":[{"id":"spn-35325","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-31266","kind":"list-item"},{"blocks":[{"id":"blk-31269","kind":"paragraph","spans":[{"id":"spn-35326","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-31268","kind":"list-item"},{"blocks":[{"id":"blk-31271","kind":"paragraph","spans":[{"id":"spn-35327","text":"Public agents / unauthenticated invocation (unless explicitly added later with API keys)."}]}],"id":"blk-31270","kind":"list-item"},{"blocks":[{"id":"blk-31273","kind":"paragraph","spans":[{"id":"spn-35328","text":"Full prompt/response storage (telemetry is numeric and metadata-focused by default)."}]}],"id":"blk-31272","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31274","kind":"heading","level":2,"spans":[{"id":"spn-35329","text":"Notes on older drafts"}]},{"id":"blk-31275","kind":"paragraph","spans":[{"id":"spn-35330","text":"This folder is the canonical spec. Earlier rough drafts (if any remain) are useful as background, but "},{"id":"spn-35331","marks":["bold"],"text":"implementation should follow this folder"},{"id":"spn-35332","text":"."}]},{"id":"blk-31276","kind":"paragraph","spans":[{"id":"spn-35333","text":"If any contradictions are found: 1. Prefer "},{"id":"spn-35334","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-35335","text":" and "},{"id":"spn-35336","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-35337","text":" for canonical behavior. 2. Prefer ADRs for “why” and invariants. 3. Treat earlier drafts as non-normative."}]},{"id":"blk-31277","kind":"heading","level":2,"spans":[{"id":"spn-35338","text":"PULSE Loop Manifest"}]},{"id":"blk-31278","kind":"paragraph","spans":[{"id":"spn-35339","text":"WebHost.Systems is a "},{"id":"spn-35340","marks":["bold"],"text":"PULSE-conforming loop"},{"id":"spn-35341","text":" under OS-010. As the hosting layer for the entire [&] ecosystem, its loop encodes the "},{"id":"spn-35342","marks":["bold"],"text":"deploy → invoke → meter → bill"},{"id":"spn-35343","text":" rhythm. Unlike other loops in the portfolio it is the only one whose substrates include both Cloudflare Workers and AWS AgentCore (per ADR-0001), and its "},{"id":"spn-35344","marks":["code"],"text":"act"},{"id":"spn-35345","text":" phase is intentionally pluggable through the Runtime Provider Interface (per "},{"id":"spn-35346","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-35347","text":")."}]},{"id":"blk-31279","kind":"paragraph","spans":[{"id":"spn-35348","marks":["bold"],"text":"Loop ID:"},{"id":"spn-35349","text":" "},{"id":"spn-35350","marks":["code"],"text":"webhost.deploy_invoke"},{"id":"spn-35351","text":" "},{"id":"spn-35352","marks":["bold"],"text":"Loop name:"},{"id":"spn-35353","text":" WebHost.Systems Deploy/Invoke Loop "},{"id":"spn-35354","marks":["bold"],"text":"Version:"},{"id":"spn-35355","text":" 1.0.0 "},{"id":"spn-35356","marks":["bold"],"text":"Owner:"},{"id":"spn-35357","text":" webhost.systems "},{"id":"spn-35358","marks":["bold"],"text":"Workspace scope:"},{"id":"spn-35359","text":" required"}]},{"id":"blk-31280","kind":"paragraph","spans":[{"id":"spn-35360","marks":["bold"],"text":"Phases (5 canonical kinds):"}]},{"head":[{"id":"blk-31282","spans":[{"id":"spn-35361","text":"Phase ID"}]},{"id":"blk-31283","spans":[{"id":"spn-35362","text":"Kind"}]},{"id":"blk-31284","spans":[{"id":"spn-35363","text":"Description"}]}],"id":"blk-31281","kind":"table","rows":[[{"id":"blk-31285","spans":[{"id":"spn-35364","marks":["code"],"text":"retrieve_deployment"}]},{"id":"blk-31286","spans":[{"id":"spn-35365","marks":["code"],"text":"retrieve"}]},{"id":"blk-31287","spans":[{"id":"spn-35366","text":"Resolve "},{"id":"spn-35367","marks":["code"],"text":"agent_id → activeDeploymentId"},{"id":"spn-35368","text":" from Supabase control plane (per ADR-0005)"}]}],[{"id":"blk-31288","spans":[{"id":"spn-35369","marks":["code"],"text":"route_runtime"}]},{"id":"blk-31289","spans":[{"id":"spn-35370","marks":["code"],"text":"route"}]},{"id":"blk-31290","spans":[{"id":"spn-35371","text":"Select runtime provider via RPI (Cloudflare default, AgentCore premium, others as adapters)"}]}],[{"id":"blk-31291","spans":[{"id":"spn-35372","marks":["code"],"text":"act_invoke"}]},{"id":"blk-31292","spans":[{"id":"spn-35373","marks":["code"],"text":"act"}]},{"id":"blk-31293","spans":[{"id":"spn-35374","text":"Execute "},{"id":"spn-35375","marks":["code"],"text":"invoke/v1"},{"id":"spn-35376","text":" (per ADR-0006); stream SSE response if requested; capture telemetry"}]}],[{"id":"blk-31294","spans":[{"id":"spn-35377","marks":["code"],"text":"learn_telemetry"}]},{"id":"blk-31295","spans":[{"id":"spn-35378","marks":["code"],"text":"learn"}]},{"id":"blk-31296","spans":[{"id":"spn-35379","text":"Aggregate signed telemetry events; update usage counters; check tier entitlements"}]}],[{"id":"blk-31297","spans":[{"id":"spn-35380","marks":["code"],"text":"consolidate_billing"}]},{"id":"blk-31298","spans":[{"id":"spn-35381","marks":["code"],"text":"consolidate"}]},{"id":"blk-31299","spans":[{"id":"spn-35382","text":"Periodic aggregation by billing period; retention pruning; cost estimation rollups"}]}]]},{"id":"blk-31300","kind":"paragraph","spans":[{"id":"spn-35383","marks":["bold"],"text":"Closure:"},{"id":"spn-35384","text":" "},{"id":"spn-35385","marks":["code"],"text":"consolidate_billing → retrieve_deployment"},{"id":"spn-35386","text":" via Supabase, guarantee "},{"id":"spn-35387","marks":["code"],"text":"eventual"},{"id":"spn-35388","text":"."}]},{"id":"blk-31301","kind":"paragraph","spans":[{"id":"spn-35389","marks":["bold"],"text":"Cadence:"},{"id":"spn-35390","text":" Primary "},{"id":"spn-35391","marks":["code"],"text":"event"},{"id":"spn-35392","text":" (every invocation). Fallback "},{"id":"spn-35393","marks":["code"],"text":"periodic"},{"id":"spn-35394","text":" (billing aggregation, retention sweeps)."}]},{"id":"blk-31302","kind":"paragraph","spans":[{"id":"spn-35395","marks":["bold"],"text":"Substrates:"}]},{"id":"blk-31303","items":[{"blocks":[{"id":"blk-31305","kind":"paragraph","spans":[{"id":"spn-35396","marks":["code"],"text":"memory"},{"id":"spn-35397","text":": "},{"id":"spn-35398","marks":["code"],"text":"graphonomous://workspace/{ws_id}"},{"id":"spn-35399","text":" (optional, for hosted MCP sidecars)"}]}],"id":"blk-31304","kind":"list-item"},{"blocks":[{"id":"blk-31307","kind":"paragraph","spans":[{"id":"spn-35400","marks":["code"],"text":"policy"},{"id":"spn-35401","text":": "},{"id":"spn-35402","marks":["code"],"text":"delegatic://workspace/{ws_id}"},{"id":"spn-35403","text":" (tier entitlements, runtime gating)"}]}],"id":"blk-31306","kind":"list-item"},{"blocks":[{"id":"blk-31309","kind":"paragraph","spans":[{"id":"spn-35404","marks":["code"],"text":"audit"},{"id":"spn-35405","text":": "},{"id":"spn-35406","marks":["code