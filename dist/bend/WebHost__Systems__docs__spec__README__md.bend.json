s":[{"id":"blk-30662","kind":"paragraph","spans":[{"id":"spn-33518","text":"Tier entitlements + runtime gating (AgentCore gated) + at least request-limit enforcement."}]}],"id":"blk-30661","kind":"list-item"},{"blocks":[{"id":"blk-30664","kind":"paragraph","spans":[{"id":"spn-33519","text":"No plaintext secrets in the primary DB; secrets injected into providers."}]}],"id":"blk-30663","kind":"list-item"},{"blocks":[{"id":"blk-30666","kind":"paragraph","spans":[{"id":"spn-33520","text":"Retention for raw telemetry/logs by tier (at minimum: raw telemetry deletion job)."}]}],"id":"blk-30665","kind":"list-item"},{"blocks":[{"id":"blk-30668","kind":"paragraph","spans":[{"id":"spn-33521","text":"E2E flow: create agent → set secrets → deploy (Cloudflare) → invoke → view usage."}]}],"id":"blk-30667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30669","kind":"heading","level":2,"spans":[{"id":"spn-33522","text":"Out of scope (explicit v1 non-goals)"}]},{"id":"blk-30670","items":[{"blocks":[{"id":"blk-30672","kind":"paragraph","spans":[{"id":"spn-33523","text":"Team/org/role-based access control (single-owner resources only)."}]}],"id":"blk-30671","kind":"list-item"},{"blocks":[{"id":"blk-30674","kind":"paragraph","spans":[{"id":"spn-33524","text":"Perfect cost reconciliation with provider billing exports (v1 cost is “estimated”)."}]}],"id":"blk-30673","kind":"list-item"},{"blocks":[{"id":"blk-30676","kind":"paragraph","spans":[{"id":"spn-33525","text":"Public agents / unauthenticated invocation (unless explicitly added later with API keys)."}]}],"id":"blk-30675","kind":"list-item"},{"blocks":[{"id":"blk-30678","kind":"paragraph","spans":[{"id":"spn-33526","text":"Full prompt/response storage (telemetry is numeric and metadata-focused by default)."}]}],"id":"blk-30677","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30679","kind":"heading","level":2,"spans":[{"id":"spn-33527","text":"Notes on older drafts"}]},{"id":"blk-30680","kind":"paragraph","spans":[{"id":"spn-33528","text":"This folder is the canonical spec. Earlier rough drafts (if any remain) are useful as background, but "},{"id":"spn-33529","marks":["bold"],"text":"implementation should follow this folder"},{"id":"spn-33530","text":"."}]},{"id":"blk-30681","kind":"paragraph","spans":[{"id":"spn-33531","text":"If any contradictions are found: 1. Prefer "},{"id":"spn-33532","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-33533","text":" and "},{"id":"spn-33534","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-33535","text":" for canonical behavior. 2. Prefer ADRs for “why” and invariants. 3. Treat earlier drafts as non-normative."}]},{"id":"blk-30682","kind":"heading","level":2,"spans":[{"id":"spn-33536","text":"PULSE Loop Manifest"}]},{"id":"blk-30683","kind":"paragraph","spans":[{"id":"spn-33537","text":"WebHost.Systems is a "},{"id":"spn-33538","marks":["bold"],"text":"PULSE-conforming loop"},{"id":"spn-33539","text":" under OS-010. As the hosting layer for the entire [&] ecosystem, its loop encodes the "},{"id":"spn-33540","marks":["bold"],"text":"deploy → invoke → meter → bill"},{"id":"spn-33541","text":" rhythm. Unlike other loops in the portfolio it is the only one whose substrates include both Cloudflare Workers and AWS AgentCore (per ADR-0001), and its "},{"id":"spn-33542","marks":["code"],"text":"act"},{"id":"spn-33543","text":" phase is intentionally pluggable through the Runtime Provider Interface (per "},{"id":"spn-33544","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-33545","text":")."}]},{"id":"blk-30684","kind":"paragraph","spans":[{"id":"spn-33546","marks":["bold"],"text":"Loop ID:"},{"id":"spn-33547","text":" "},{"id":"spn-33548","marks":["code"],"text":"webhost.deploy_invoke"},{"id":"spn-33549","text":" "},{"id":"spn-33550","marks":["bold"],"text":"Loop name:"},{"id":"spn-33551","text":" WebHost.Systems Deploy/Invoke Loop "},{"id":"spn-33552","marks":["bold"],"text":"Version:"},{"id":"spn-33553","text":" 1.0.0 "},{"id":"spn-33554","marks":["bold"],"text":"Owner:"},{"id":"spn-33555","text":" webhost.systems "},{"id":"spn-33556","marks":["bold"],"text":"Workspace scope:"},{"id":"spn-33557","text":" required"}]},{"id":"blk-30685","kind":"paragraph","spans":[{"id":"spn-33558","marks":["bold"],"text":"Phases (5 canonical kinds):"}]},{"head":[{"id":"blk-30687","spans":[{"id":"spn-33559","text":"Phase ID"}]},{"id":"blk-30688","spans":[{"id":"spn-33560","text":"Kind"}]},{"id":"blk-30689","spans":[{"id":"spn-33561","text":"Description"}]}],"id":"blk-30686","kind":"table","rows":[[{"id":"blk-30690","spans":[{"id":"spn-33562","marks":["code"],"text":"retrieve_deployment"}]},{"id":"blk-30691","spans":[{"id":"spn-33563","marks":["code"],"text":"retrieve"}]},{"id":"blk-30692","spans":[{"id":"spn-33564","text":"Resolve "},{"id":"spn-33565","marks":["code"],"text":"agent_id → activeDeploymentId"},{"id":"spn-33566","text":" from Supabase control plane (per ADR-0005)"}]}],[{"id":"blk-30693","spans":[{"id":"spn-33567","marks":["code"],"text":"route_runtime"}]},{"id":"blk-30694","spans":[{"id":"spn-33568","marks":["code"],"text":"route"}]},{"id":"blk-30695","spans":[{"id":"spn-33569","text":"Select runtime provider via RPI (Cloudflare default, AgentCore premium, others as adapters)"}]}],[{"id":"blk-30696","spans":[{"id":"spn-33570","marks":["code"],"text":"act_invoke"}]},{"id":"blk-30697","spans":[{"id":"spn-33571","marks":["code"],"text":"act"}]},{"id":"blk-30698","spans":[{"id":"spn-33572","text":"Execute "},{"id":"spn-33573","marks":["code"],"text":"invoke/v1"},{"id":"spn-33574","text":" (per ADR-0006); stream SSE response if requested; capture telemetry"}]}],[{"id":"blk-30699","spans":[{"id":"spn-33575","marks":["code"],"text":"learn_telemetry"}]},{"id":"blk-30700","spans":[{"id":"spn-33576","marks":["code"],"text":"learn"}]},{"id":"blk-30701","spans":[{"id":"spn-33577","text":"Aggregate signed telemetry events; update usage counters; check tier entitlements"}]}],[{"id":"blk-30702","spans":[{"id":"spn-33578","marks":["code"],"text":"consolidate_billing"}]},{"id":"blk-30703","spans":[{"id":"spn-33579","marks":["code"],"text":"consolidate"}]},{"id":"blk-30704","spans":[{"id":"spn-33580","text":"Periodic aggregation by billing period; retention pruning; cost estimation rollups"}]}]]},{"id":"blk-30705","kind":"paragraph","spans":[{"id":"spn-33581","marks":["bold"],"text":"Closure:"},{"id":"spn-33582","text":" "},{"id":"spn-33583","marks":["code"],"text":"consolidate_billing → retrieve_deployment"},{"id":"spn-33584","text":" via Supabase, guarantee "},{"id":"spn-33585","marks":["code"],"text":"eventual"},{"id":"spn-33586","text":"."}]},{"id":"blk-30706","kind":"paragraph","spans":[{"id":"spn-33587","marks":["bold"],"text":"Cadence:"},{"id":"spn-33588","text":" Primary "},{"id":"spn-33589","marks":["code"],"text":"event"},{"id":"spn-33590","text":" (every invocation). Fallback "},{"id":"spn-33591","marks":["code"],"text":"periodic"},{"id":"spn-33592","text":" (billing aggregation, retention sweeps)."}]},{"id":"blk-30707","kind":"paragraph","spans":[{"id":"spn-33593","marks":["bold"],"text":"Substrates:"}]},{"id":"blk-30708","items":[{"blocks":[{"id":"blk-30710","kind":"paragraph","spans":[{"id":"spn-33594","marks":["code"],"text":"memory"},{"id":"spn-33595","text":": "},{"id":"spn-33596","marks":["code"],"text":"graphonomous://workspace/{ws_id}"},{"id":"spn-33597","text":" (optional, for hosted MCP sidecars)"}]}],"id":"blk-30709","kind":"list-item"},{"blocks":[{"id":"blk-30712","kind":"paragraph","spans":[{"id":"spn-33598","marks":["code"],"text":"policy"},{"id":"spn-33599","text":": "},{"id":"spn-33600","marks":["code"],"text":"delegatic://workspace/{ws_id}"},{"id":"spn-33601","text":" (tier entitlements, runtime gating)"}]}],"id":"blk-30711","kind":"list-item"},{"blocks":[{"id":"blk-30714","kind":"paragraph","spans":[{"id":"spn-33602","marks":["code"],"text":"audit"},{"id":"spn-33603","text":": "},{"id":"spn-33604","marks":["code