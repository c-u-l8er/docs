":"spn-76768","marks":["code"],"text":"40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-76769","text":" — threat model, secrets strategy requirements, telemetry integrity, webhook integrity, artifact safety, acceptance criteria."}]}],"id":"blk-49856","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49858","items":[{"blocks":[{"id":"blk-49860","kind":"paragraph","spans":[{"id":"spn-76770","marks":["bold"],"text":"Build metering, billing UX, and enforcement"}]}],"id":"blk-49859","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-49861","items":[{"blocks":[{"id":"blk-49863","kind":"paragraph","spans":[{"id":"spn-76771","marks":["code"],"text":"50_OBSERVABILITY_BILLING_LIMITS.md"},{"id":"spn-76772","text":" — telemetry pipeline, aggregation model, cost estimation (estimated in v1), tier entitlements, runtime gating, limit enforcement algorithms."}]}],"id":"blk-49862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49864","items":[{"blocks":[{"id":"blk-49866","kind":"paragraph","spans":[{"id":"spn-76773","marks":["bold"],"text":"Verify correctness end-to-end"}]}],"id":"blk-49865","kind":"list-item"}],"kind":"list","ordered":true,"start":7},{"id":"blk-49867","items":[{"blocks":[{"id":"blk-49869","kind":"paragraph","spans":[{"id":"spn-76774","marks":["code"],"text":"60_TESTING_ACCEPTANCE.md"},{"id":"spn-76775","text":" — unit/integration/E2E test plan + release gates and system-level definition of done."}]}],"id":"blk-49868","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49870","kind":"heading","level":2,"spans":[{"id":"spn-76776","text":"Architecture Decision Records (ADRs)"}]},{"id":"blk-49871","kind":"paragraph","spans":[{"id":"spn-76777","text":"ADRs document the “why” behind major choices and define additional constraints that implementations must satisfy."}]},{"id":"blk-49872","items":[{"blocks":[{"id":"blk-49874","kind":"paragraph","spans":[{"id":"spn-76778","marks":["code"],"text":"adr/ADR-0001-multi-r