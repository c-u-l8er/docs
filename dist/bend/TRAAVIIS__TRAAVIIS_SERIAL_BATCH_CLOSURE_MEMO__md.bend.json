blk-35013","kind":"paragraph","spans":[{"id":"spn-52544","marks":["code"],"text":"EvaluationV1"},{"id":"spn-52545","text":" is written in full beside the episodes it indexes; embedding a second copy in "},{"id":"spn-52546","marks":["code"],"text":"batch.json"},{"id":"spn-52547","text":" would give a reader two copies to keep in agreement, and "},{"id":"spn-52548","marks":["code"],"text":"batch.json"},{"id":"spn-52549","text":" is the document people quote."}]},{"id":"blk-35014","items":[{"blocks":[{"id":"blk-35016","kind":"paragraph","spans":[{"id":"spn-52550","marks":["bold"],"text":"`tasks[].comparisons[].relation` is the whole relation block"},{"id":"spn-52551","text":" — "},{"id":"spn-52552","marks":["code"],"text":"reward"},{"id":"spn-52553","text":","}]}],"id":"blk-35015","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-35017","kind":"paragraph","spans":[{"id":"spn-52554","marks":["code"],"text":"right_minus_left"},{"id":"spn-52555","text":", "},{"id":"spn-52556","marks":["code"],"text":"same_episode"},{"id":"spn-52557","text":", "},{"id":"spn-52558","marks":["code"],"text":"same_trace"},{"id":"spn-52559","text":" — copied verbatim from the "},{"id":"spn-52560","marks":["code"],"text":"ComparisonV1"},{"id":"spn-52561","text":" member, not a bare relation string. The delta and the trace flag are what stop \"equal\" from reading as \"the same\"."}]},{"id":"blk-35018","items":[{"blocks":[{"id":"blk-35020","kind":"paragraph","spans":[{"id":"spn-52562","marks":["bold"],"text":"The batch exposes only the `registry=` seam."},{"id":"spn-52563","text":" There is no"}]}],"id":"blk-35019","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-35021","kind":"paragraph","spans":[{"id":"spn-52564","marks":["code"],"text":"extra_verifiers"},{"id":"spn-52565","text":" parameter anywhere in "},{"id":"spn-52566","marks":["code"],"text":"batch.py"},{"id":"spn-52567","text":", and B29 asserts the string does not appear in the module. Having just closed the dual-wiring defect twice, adding a second seam to a third command seemed the wrong lesson to draw."}]},{"id":"blk-35022","items":[{"blocks":[{"id":"blk-35024","kind":"paragraph","spans":[{"id":"spn-52568","marks":["bold"],"text":"An existing output path is refused outright"},{"id":"spn-52569","text":" ("},{"id":"spn-52570","marks":["code"],"text":"OUTPUT_EXISTS"},{"id":"spn-52571","text":"), including"}]}],"id":"blk-35023","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-35025","kind":"paragraph","spans":[{"id":"spn-52572","text":"an empty directory. Publishing on top of an older batch would silently produce half of each; B22b asserts the collision leaves the existing batch byte-identical."}]},{"id":"blk-35026","items":[{"blocks":[{"id":"blk-35028","kind":"paragraph","spans":[{"id":"spn-52573","marks":["bold"],"text":"A candidate key may not contain `--`."},{"id":"spn-52574","text":" The ruling fixed the pair filename"}]}],"id":"blk-35027","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-35029","kind":"paragraph","spans":[{"id":"spn-52575","text":"as "},{"id":"spn-52576","marks":["code"],"text":"<left>--<right>.json"},{"id":"spn-52577","text":" without constraining keys; permitting "},{"id":"spn-52578","marks":["code"],"text":"--"},{"id":"spn-52579","text":" inside one makes the filename ambiguous."}]},{"id":"blk-35030","items":[{"blocks":[{"id":"blk-35032","kind":"paragraph","spans":[{"id":"spn-52580","marks":["bold"],"text":"`_pairs` emits each unordered pair once, in sorted-key direction"},{"id":"spn-52581","text":", as"}]}],"id":"blk-35031","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-35033","kind":"paragraph","spans":[{"id":"spn-52582","text":"ruled. The reverse reading stays available through "},{"id":"spn-52583","marks":["code"],"text":"trvs compare"},{"id":"spn-52584","text":", and B12 asserts "},{"id":"spn-52585","marks":["code"],"text":"left < right"},{"id":"spn-52586","text":" for every pair in the index."}]},{"id":"blk-35034","items":[{"blocks":[{"id":"blk-35036","kind":"paragraph","spans":[{"id":"spn-52587","marks":["bold"],"text":"B4 is proved in two halves"},{"id":"spn-52588","text":" rather than by a canary agent. The candidate"}]}],"id":"blk-35035","kind":"list-item"}],"kind":"list","ordered":true,"start":7},{"id":"blk-35037","kind":"paragraph","spans":[{"id":"spn-52589","text":"set has nowhere to put an environment (refused), and "},{"id":"spn-52590","marks":["code"],"text":"runner._seal_env"},{"id":"spn-52591","text":" ignores a canary variable set in the parent process. A canary agent would only have proved it for an agent that happened to report its environment."}]},{"id":"blk-35038","items":[{"blocks":[{"id":"blk-35040","kind":"paragraph","spans":[{"id":"spn-52592","marks":["bold"],"text":"`accept_packet.py` grew exit code 2"},{"id":"spn-52593","text":" rather than keeping the binary"}]}],"id":"blk-35039","kind":"list-item"}],"kind":"list","ordered":true,"start":8},{"id":"blk-35041","kind":"paragraph","spans":[{"id":"spn-52594","text":"accepted/rejected contract (§3c). A tool that reports a verdict it did not reach is worse than a tool that reports nothing, and the 0/1/2 split already means exactly this everywhere else in the CLI. This changes a release tool's observable contract, so it is flagged rather than filed as a bug fix — if anything downstream branches on "},{"id":"spn-52595","marks":["code"],"text":"!= 0"},{"id":"spn-52596","text":", it is unaffected; if anything branches on "},{"id":"spn-52597","marks":["code"],"text":"== 1"},{"id":"spn-52598","text":", it now sees 2 for a missing packet."}]},{"id":"blk-35042","kind":"heading","level":2,"spans":[{"id":"spn-52599","text":"6. What was not built"}]},{"id":"blk-35043","kind":"paragraph","spans":[{"id":"spn-52600","text":"Untouched, and still deferred by ruling: "},{"id":"spn-52601","marks":["code"],"text":"bundle-…"},{"id":"spn-52602","text":" distribution identity (the next slice), "},{"id":"spn-52603","marks":["code"],"text":"eval-…"},{"id":"spn-52604","text":", "},{"id":"spn-52605","marks":["code"],"text":"agent-…"},{"id":"spn-52606","text":", ORS, "},{"id":"spn-52607","marks":["code"],"text":"trvs serve --ors/--mcp"},{"id":"spn-52608","text":", MCP, the REPL. No new identity rung was introduced. "},{"id":"spn-52609","marks":["code"],"text":"ComparisonV1"},{"id":"spn-52610","text":" was not redesigned — the change to it is the one-branch wiring closure and nothing else."}]}],"edges":[],"id":"bagaaiera4wr7vh6fmudwbzii3ygoyljnmbgzz7qzuqgywkmb2yn4nvmklnwq","vocabulary":"ampersand.docs.fs.v1"}