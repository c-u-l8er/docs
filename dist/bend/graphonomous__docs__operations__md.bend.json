{"bendscript":"0.1","blocks":[{"id":"blk-41365","kind":"heading","level":1,"spans":[{"id":"spn-46551","text":"Operations & Maintenance"}]},{"id":"blk-41366","kind":"paragraph","spans":[{"id":"spn-46552","text":"This page is the operational runbook for running, validating, and maintaining "},{"id":"spn-46553","marks":["bold"],"text":"Graphonomous"},{"id":"spn-46554","text":" in development and production-like environments."}]},{"id":"blk-41367","kind":"paragraph","spans":[{"id":"spn-46555","text":"---"}]},{"id":"blk-41368","kind":"heading","level":2,"spans":[{"id":"spn-46556","text":"1) Operational Model"}]},{"id":"blk-41369","kind":"paragraph","spans":[{"id":"spn-46557","text":"Graphonomous runs as an Elixir/OTP application with supervised runtime services and an MCP server interface over stdio. Core operational concerns are:"}]},{"id":"blk-41370","items":[{"blocks":[{"id":"blk-41372","kind":"paragraph","spans":[{"id":"spn-46558","marks":["bold"],"text":"Process health"},{"id":"spn-46559","text":" (runtime services are up)"}]}],"id":"blk-41371","kind":"list-item"},{"blocks":[{"id":"blk-41374","kind":"paragraph","spans":[{"id":"spn-46560","marks":["bold"],"text":"Data durability"},{"id":"spn-46561","text":" (SQLite-backed state)"}]}],"id":"blk-41373","kind":"list-item"},{"blocks":[{"id":"blk-41376","kind":"paragraph","spans":[{"id":"spn-46562","marks":["bold"],"text":"Retrieval quality"},{"id":"spn-46563","text":" (memory remains relevant)"}]}],"id":"blk-41375","kind":"list-item"},{"blocks":[{"id":"blk-41378","kind":"paragraph","spans":[{"id":"spn-46564","marks":["bold"],"text":"Learning integrity"},{"id":"spn-46565","text":" (outcomes update confidence correctly)"}]}],"id":"blk-41377","kind":"list-item"},{"blocks":[{"id":"blk-41380","kind":"paragraph","spans":[{"id":"spn-46566","marks":["bold"],"text":"Memory hygiene"},{"id":"spn-46567","text":" (consolidation decay/pruning cycles)"}]}],"id":"blk-41379","kind":"list-item"},{"blocks":[{"id":"blk-41382","kind":"paragraph","spans":[{"id":"spn-46568","marks":["bold"],"text":"Transport stability"},{"id":"spn-46569","text":" (MCP client/server connectivity)"}]}],"id":"blk-41381","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41383","kind":"paragraph","spans":[{"id":"spn-46570","text":"---"}]},{"id":"blk-41384","kind":"heading","level":2,"spans":[{"id":"spn-46571","text":"2) Daily Operator Checklist"}]},{"id":"blk-41385","kind":"paragraph","spans":[{"id":"spn-46572","text":"Use this checklist for routine operation:"}]},{"id":"blk-41386","kind":"paragraph","spans":[{"id":"spn-46573","text":"1. Start Graphonomous with an explicit DB path. 2. Verify runtime health snapshot. 3. Verify goals snapshot (if goal-driven workflows are active). 4. Confirm retrieval works on a known query. 5. Confirm writes ("},{"id":"spn-46574","marks":["code"],"text":"store_node"},{"id":"spn-46575","text":") and updates ("},{"id":"spn-46576","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-46577","text":") succeed. 6. Run/inspect consolidation state. 7. Review logs for transport disconnects or repeated timeouts."}]},{"id":"blk-41387","kind":"paragraph","spans":[{"id":"spn-46578","text":"---"}]},{"id":"blk-41388","kind":"heading","level":2,"spans":[{"id":"spn-46579","text":"3) Startup Procedures"}]},{"id":"blk-41389","kind":"heading","level":2,"spans":[{"id":"spn-46580","text":"3.1 Local development startup"}]},{"id":"blk-41390","kind":"paragraph","spans":[{"id":"spn-46581","text":"Run Graphonomous with a dedicated local DB:"}]},{"id":"blk-41391","items":[{"blocks":[{"id":"blk-41393","kind":"paragraph","spans":[{"id":"spn-46582","text":"Ensure your DB directory exists."}]}],"id":"blk-41392","kind":"list-item"},{"blocks":[{"id":"blk-41395","kind":"paragraph","spans":[{"id":"spn-46583","text":"Start using fallback embedder when troubleshooting or on constrained devices."}]}],"id":"blk-41394","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41396","kind":"paragraph","spans":[{"id":"spn-46584","text":"Recommended startup characteristics:"}]},{"id":"blk-41397","items":[{"blocks":[{"id":"blk-41399","kind":"paragraph","spans":[{"id":"spn-46585","text":"Explicit "},{"id":"spn-46586","marks":["code"],"text":"--db"},{"id":"spn-46587","text":" path"}]}],"id":"blk-41398","kind":"list-item"},{"blocks":[{"id":"blk-41401","kind":"paragraph","spans":[{"id":"spn-46588","text":"Stable log level ("},{"id":"spn-46589","marks":["code"],"text":"info"},{"id":"spn-46590","text":" or "},{"id":"spn-46591","marks":["code"],"text":"debug"},{"id":"spn-46592","text":")"}]}],"id":"blk-41400","kind":"list-item"},{"blocks":[{"id":"blk-41403","kind":"paragraph","spans":[{"id":"spn-46593","text":"Request timeout tuned for your client/editor"}]}],"id":"blk-41402","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41404","kind":"heading","level":2,"spans":[{"id":"spn-46594","text":"3.2 MCP client startup validation"}]},{"id":"blk-41405","kind":"paragraph","spans":[{"id":"spn-46595","text":"After startup, validate in this order:"}]},{"id":"blk-41406","kind":"paragraph","spans":[{"id":"spn-46596","text":"1. Tool discovery returns expected Graphonomous tools. 2. Resource reads succeed:"}]},{"id":"blk-41407","items":[{"blocks":[{"id":"blk-41409","kind":"paragraph","spans":[{"id":"spn-46597","marks":["code"],"text":"graphonomous://runtime/health"}]}],"id":"blk-41408","kind":"list-item"},{"blocks":[{"id":"blk-41411","kind":"paragraph","spans":[{"id":"spn-46598","marks":["code"],"text":"graphonomous://goals/snapshot"}]}],"id":"blk-41410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41412","kind":"paragraph","spans":[{"id":"spn-46599","text":"3. A test retrieval query returns "},{"id":"spn-46600","marks":["code"],"text":"status: ok"},{"id":"spn-46601","text":". 4. A test node write succeeds."}]},{"id":"blk-41413","kind":"paragraph","spans":[{"id":"spn-46602","text":"---"}]},{"id":"blk-41414","kind":"heading","level":2,"spans":[{"id":"spn-46603","text":"4) Health Monitoring"}]},{"id":"blk-41415","kind":"heading","level":2,"spans":[{"id":"spn-46604","text":"4.1 Runtime health resource"}]},{"id":"blk-41416","kind":"paragraph","spans":[{"id":"spn-46605","text":"Use "},{"id":"spn-46606","marks":["code"],"text":"graphonomous://runtime/health"},{"id":"spn-46607","text":" to verify:"}]},{"id":"blk-41417","items":[{"blocks":[{"id":"blk-41419","kind":"paragraph","spans":[{"id":"spn-46608","text":"Process-level service status ("},{"id":"spn-46609","marks":["code"],"text":"up"},{"id":"spn-46610","text":"/"},{"id":"spn-46611","marks":["code"],"text":"down"},{"id":"spn-46612","text":")"}]}],"id":"blk-41418","kind":"list-item"},{"blocks":[{"id":"blk-41421","kind":"paragraph","spans":[{"id":"spn-46613","text":"High-level object counts (nodes/goals)"}]}],"id":"blk-41420","kind":"list-item"},{"blocks":[{"id":"blk-41423","kind":"paragraph","spans":[{"id":"spn-46614","text":"Timestamp of snapshot generation"}]}],"id":"blk-41422","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41424","kind":"paragraph","spans":[{"id":"spn-46615","text":"If any core service is down, restart runtime and verify DB accessibility."}]},{"id":"blk-41425","kind":"heading","level":2,"spans":[{"id":"spn-46616","text":"4.2 Goal snapshot resource"}]},{"id":"blk-41426","kind":"paragraph","spans":[{"id":"spn-46617","text":"Use "},{"id":"spn-46618","marks":["code"],"text":"graphonomous://goals/snapshot"},{"id":"spn-46619","text":" to verify:"}]},{"id":"blk-41427","items":[{"blocks":[{"id":"blk-41429","kind":"paragraph","spans":[{"id":"spn-46620","text":"Total number of goals"}]}],"id":"blk-41428","kind":"list-item"},{"blocks":[{"id":"blk-41431","kind":"paragraph","spans":[{"id":"spn-46621","text":"Status distribution ("},{"id":"spn-46622","marks":["code"],"text":"proposed"},{"id":"spn-46623","text":", "},{"id":"spn-46624","marks":["code"],"text":"active"},{"id":"spn-46625","text":", "},{"id":"spn-46626","marks":["code"],"text":"blocked"},{"id":"spn-46627","text":", "},{"id":"spn-46628","marks":["code"],"text":"completed"},{"id":"spn-46629","text":", etc.)"}]}],"id":"blk-41430","kind":"list-item"},{"blocks":[{"id":"blk-41433","kind":"paragraph","spans":[{"id":"spn-46630","text":"Serialized goal records for debugging orchestration state"}]}],"id":"blk-41432","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41434","kind":"paragraph","spans":[{"id":"spn-46631","text":"---"}]},{"id":"blk-41435","kind":"heading","level":2,"spans":[{"id":"spn-46632","text":"5) Data & Storage Operations"}]},{"id":"blk-41436","kind":"heading","level":2,"spans":[{"id":"spn-46633","text":"5.1 Persistence strategy"}]},{"id":"blk-41437","kind":"paragraph","spans":[{"id":"spn-46634","text":"Graphonomous uses SQLite as durable storage and ETS as hot in-memory cache."}]},{"id":"blk-41438","kind":"paragraph","spans":[{"id":"spn-46635","text":"Operational implications:"}]},{"id":"blk-41439","items":[{"blocks":[{"id":"blk-41441","kind":"paragraph","spans":[{"id":"spn-46636","text":"SQLite file is the recovery source of truth."}]}],"id":"blk-41440","kind":"list-item"},{"blocks":[{"id":"blk-41443","kind":"paragraph","spans":[{"id":"spn-46637","text":"ETS is rebuilt/warmed from DB state."}]}],"id":"blk-41442","kind":"list-item"},{"blocks":[{"id":"blk-41445","kind":"paragraph","spans":[{"id":"spn-46638","text":"Always keep DB path explicit and stable per environment."}]}],"id":"blk-41444","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41446","kind":"heading","level":2,"spans":[{"id":"spn-46639","text":"5.2 Backup strategy"}]},{"id":"blk-41447","kind":"paragraph","spans":[{"id":"spn-46640","text":"Recommended backup practice:"}]},{"id":"blk-41448","items":[{"blocks":[{"id":"blk-41450","kind":"paragraph","spans":[{"id":"spn-46641","text":"Schedule periodic copies/snapshots of the SQLite DB file."}]}],"id":"blk-41449","kind":"list-item"},{"blocks":[{"id":"blk-41452","kind":"paragraph","spans":[{"id":"spn-46642","text":"Perform backups during low-write periods when possible."}]}],"id":"blk-41451","kind":"list-item"},{"blocks":[{"id":"blk-41454","kind":"paragraph","spans":[{"id":"spn-46643","text":"Keep at least:"}]}],"id":"blk-41453","kind":"list-item"},{"blocks":[{"id":"blk-41456","kind":"paragraph","spans":[{"id":"spn-46644","text":"daily rolling backups (7 days),"}]}],"id":"blk-41455","kind":"list-item"},{"blocks":[{"id":"blk-41458","kind":"paragraph","spans":[{"id":"spn-46645","text":"weekly backups (4 weeks),"}]}],"id":"blk-41457","kind":"list-item"},{"blocks":[{"id":"blk-41460","kind":"paragraph","spans":[{"id":"spn-46646","text":"monthly backups (3–6 months)."}]}],"id":"blk-41459","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41461","kind":"heading","level":2,"spans":[{"id":"spn-46647","text":"5.3 Recovery procedure"}]},{"id":"blk-41462","kind":"paragraph","spans":[{"id":"spn-46648","text":"If runtime state appears inconsistent:"}]},{"id":"blk-41463","kind":"paragraph","spans":[{"id":"spn-46649","text":"1. Stop Graphonomous. 2. Backup current DB file before changes. 3. Restart runtime and verify health. 4. Re-run retrieval sanity checks. 5. If needed, restore from known-good backup and replay required operational steps."}]},{"id":"blk-41464","kind":"paragraph","spans":[{"id":"spn-46650","text":"---"}]},{"id":"blk-41465","kind":"heading","level":2,"spans":[{"id":"spn-46651","text":"6) Learning Loop Operations"}]},{"id":"blk-41466","kind":"heading","level":2,"spans":[{"id":"spn-46652","text":"6.1 Required loop discipline"}]},{"id":"blk-41467","kind":"paragraph","spans":[{"id":"spn-46653","text":"For consequential actions:"}]},{"id":"blk-41468","kind":"paragraph","spans":[{"id":"spn-46654","text":"1. Retrieve context first. 2. Perform action. 3. Report outcome with real "},{"id":"spn-46655","marks":["code"],"text":"causal_node_ids"},{"id":"spn-46656","text":"."}]},{"id":"blk-41469","kind":"paragraph","spans":[{"id":"spn-46657","text":"This keeps confidence updates meaningful and avoids drift."}]},{"id":"blk-41470","kind":"heading","level":2,"spans":[{"id":"spn-46658","text":"6.2 Outcome status semantics"}]},{"id":"blk-41471","kind":"paragraph","spans":[{"id":"spn-46659","text":"Use outcome status correctly:"}]},{"id":"blk-41472","items":[{"blocks":[{"id":"blk-41474","kind":"paragraph","spans":[{"id":"spn-46660","marks":["code"],"text":"success"},{"id":"spn-46661","text":": action achieved intended result"}]}],"id":"blk-41473","kind":"list-item"},{"blocks":[{"id":"blk-41476","kind":"paragraph","spans":[{"id":"spn-46662","marks":["code"],"text":"partial_success"},{"id":"spn-46663","text":": mixed outcome"}]}],"id":"blk-41475","kind":"list-item"},{"blocks":[{"id":"blk-41478","kind":"paragraph","spans":[{"id":"spn-46664","marks":["code"],"text":"failure"},{"id":"spn-46665","text":": action failed"}]}],"id":"blk-41477","kind":"list-item"},{"blocks":[{"id":"blk-41480","kind":"paragraph","spans":[{"id":"spn-46666","marks":["code"],"text":"timeout"},{"id":"spn-46667","text":": no reliable completion signal"}]}],"id":"blk-41479","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41481","kind":"paragraph","spans":[{"id":"spn-46668","text":"Treating timeouts as failures can incorrectly penalize good knowledge."}]},{"id":"blk-41482","kind":"heading","level":2,"spans":[{"id":"spn-46669","text":"6.3 Confidence hygiene"}]},{"id":"blk-41483","kind":"paragraph","spans":[{"id":"spn-46670","text":"Operational rule:"}]},{"id":"blk-41484","items":[{"blocks":[{"id":"blk-41486","kind":"paragraph","spans":[{"id":"spn-46671","text":"Use evidence-calibrated confidence values."}]}],"id":"blk-41485","kind":"list-item"},{"blocks":[{"id":"blk-41488","kind":"paragraph","spans":[{"id":"spn-46672","text":"Avoid blanket high confidence in both stored nodes and outcomes."}]}],"id":"blk-41487","kind":"list-item"},{"blocks":[{"id":"blk-41490","kind":"paragraph","spans":[{"id":"spn-46673","text":"Favor structured evidence payloads for audits and debugging."}]}],"id":"blk-41489","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41491","kind":"paragraph","spans":[{"id":"spn-46674","text":"---"}]},{"id":"blk-41492","kind":"heading","level":2,"spans":[{"id":"spn-46675","text":"7) Goal Operations"}]},{"id":"blk-41493","kind":"paragraph","spans":[{"id":"spn-46676","text":"For multi-step work, always use goals."}]},{"id":"blk-41494","kind":"heading","level":2,"spans":[{"id":"spn-46677","text":"7.1 Goal lifecycle flow"}]},{"id":"blk-41495","kind":"paragraph","spans":[{"id":"spn-46678","text":"Typical progression:"}]},{"id":"blk-41496","kind":"paragraph","spans":[{"id":"spn-46679","marks":["code"],"text":"proposed -> active -> completed"},{"id":"spn-46680","text":" or "},{"id":"spn-46681","marks":["code"],"text":"proposed/active -> blocked -> active"},{"id":"spn-46682","text":" (when unblocked)"}]},{"id":"blk-41497","kind":"heading","level":2,"spans":[{"id":"spn-46683","text":"7.2 Coverage review gate"}]},{"id":"blk-41498","kind":"paragraph","spans":[{"id":"spn-46684","text":"Before high-impact actions, run goal coverage review to route execution:"}]},{"id":"blk-41499","items":[{"blocks":[{"id":"blk-41501","kind":"paragraph","spans":[{"id":"spn-46685","marks":["code"],"text":"act"},{"id":"spn-46686","text":": proceed"}]}],"id":"blk-41500","kind":"list-item"},{"blocks":[{"id":"blk-41503","kind":"paragraph","spans":[{"id":"spn-46687","marks":["code"],"text":"learn"},{"id":"spn-46688","text":": gather additional context"}]}],"id":"blk-41502","kind":"list-item"},{"blocks":[{"id":"blk-41505","kind":"paragraph","spans":[{"id":"spn-46689","marks":["code"],"text":"escalate"},{"id":"spn-46690","text":": block/escalate to human or multi-agent process"}]}],"id":"blk-41504","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41506","kind":"heading","level":2,"spans":[{"id":"spn-46691","text":"7.3 Progress and evidence"}]},{"id":"blk-41507","items":[{"blocks":[{"id":"blk-41509","kind":"paragraph","spans":[{"id":"spn-46692","text":"Update progress incrementally (avoid “jump to 100%” without evidence)."}]}],"id":"blk-41508","kind":"list-item"},{"blocks":[{"id":"blk-41511","kind":"paragraph","spans":[{"id":"spn-46693","text":"Link supporting nodes to goals."}]}],"id":"blk-41510","kind":"list-item"},{"blocks":[{"id":"blk-41513","kind":"paragraph","spans":[{"id":"spn-46694","text":"Keep transition metadata descriptive for auditability."}]}],"id":"blk-41512","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41514","kind":"paragraph","spans":[{"id":"spn-46695","text":"---"}]},{"id":"blk-41515","kind":"heading","level":2,"spans":[{"id":"spn-46696","text":"8) Consolidation Operations"}]},{"id":"blk-41516","kind":"paragraph","spans":[{"id":"spn-46697","text":"Consolidation maintains memory quality over time."}]},{"id":"blk-41517","kind":"heading","level":2,"spans":[{"id":"spn-46698","text":"8.1 When to run"}]},{"id":"blk-41518","items":[{"blocks":[{"id":"blk-41520","kind":"paragraph","spans":[{"id":"spn-46699","text":"End of productive sessions"}]}],"id":"blk-41519","kind":"list-item"},{"blocks":[{"id":"blk-41522","kind":"paragraph","spans":[{"id":"spn-46700","text":"Periodically during long autonomous runs"}]}],"id":"blk-41521","kind":"list-item"},{"blocks":[{"id":"blk-41524","kind":"paragraph","spans":[{"id":"spn-46701","text":"After heavy write/ingestion bursts"}]}],"id":"blk-41523","kind":"list-item"},{"blocks":[{"id":"blk-41526","kind":"paragraph","spans":[{"id":"spn-46702","text":"Before critical retrieval/review checkpoints"}]}],"id":"blk-41525","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41527","kind":"heading","level":2,"spans":[{"id":"spn-46703","text":"8.2 What to watch"}]},{"id":"blk-41528","kind":"paragraph","spans":[{"id":"spn-46704","text":"From consolidation status/runtime info monitor:"}]},{"id":"blk-41529","items":[{"blocks":[{"id":"blk-41531","kind":"paragraph","spans":[{"id":"spn-46705","text":"cycle count"}]}],"id":"blk-41530","kind":"list-item"},{"blocks":[{"id":"blk-41533","kind":"paragraph","spans":[{"id":"spn-46706","text":"last run timestamp"}]}],"id":"blk-41532","kind":"list-item"},{"blocks":[{"id":"blk-41535","kind":"paragraph","spans":[{"id":"spn-46707","text":"decay/prune behavior"}]}],"id":"blk-41534","kind":"list-item"},{"blocks":[{"id":"blk-41537","kind":"paragraph","spans":[{"id":"spn-46708","text":"signs of overly aggressive pruning"}]}],"id":"blk-41536","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41538","kind":"paragraph","spans":[{"id":"spn-46709","text":"If retrieval quality drops sharply, inspect consolidation settings and confidence distributions."}]},{"id":"blk-41539","kind":"paragraph","spans":[{"id":"spn-46710","text":"---"}]},{"id":"blk-41540","kind":"heading","level":2,"spans":[{"id":"spn-46711","text":"9) Incident Response Runbooks"}]},{"id":"blk-41541","kind":"heading","level":2,"spans":[{"id":"spn-46712","text":"9.1 MCP server transport instability"}]},{"id":"blk-41542","kind":"paragraph","spans":[{"id":"spn-46713","text":"Symptoms:"}]},{"id":"blk-41543","items":[{"blocks":[{"id":"blk-41545","kind":"paragraph","spans":[{"id":"spn-46714","text":"client timeouts"}]}],"id":"blk-41544","kind":"list-item"},{"blocks":[{"id":"blk-41547","kind":"paragraph","spans":[{"id":"spn-46715","text":"server shutdown messages"}]}],"id":"blk-41546","kind":"list-item"},{"blocks":[{"id":"blk-41549","kind":"paragraph","spans":[{"id":"spn-46716","text":"intermittent success/failure across calls"}]}],"id":"blk-41548","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41550","kind":"paragraph","spans":[{"id":"spn-46717","text":"Response:"}]},{"id":"blk-41551","kind":"paragraph","spans":[{"id":"spn-46718","text":"1. Confirm runtime process is alive. 2. Validate health resource. 3. Restart MCP runtime cleanly. 4. Re-run minimal smoke flow (list tools -> read resources -> retrieve -> store). 5. Inspect logs for transport and timeout patterns. 6. Increase request timeout if workload is heavy."}]},{"id":"blk-41552","kind":"heading","level":2,"spans":[{"id":"spn-46719","text":"9.2 Write-path failures"}]},{"id":"blk-41553","kind":"paragraph","spans":[{"id":"spn-46720","text":"Symptoms:"}]},{"id":"blk-41554","items":[{"blocks":[{"id":"blk-41556","kind":"paragraph","spans":[{"id":"spn-46721","text":"retrieval works but node/goal writes fail"}]}],"id":"blk-41555","kind":"list-item"},{"blocks":[{"id":"blk-41558","kind":"paragraph","spans":[{"id":"spn-46722","text":"partial success in batches"}]}],"id":"blk-41557","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41559","kind":"paragraph","spans":[{"id":"spn-46723","text":"Response:"}]},{"id":"blk-41560","kind":"paragraph","spans":[{"id":"spn-46724","text":"1. Verify DB path and file permissions. 2. Check available disk space. 3. Restart runtime. 4. Retry writes idempotently. 5. Confirm data via query/list calls after retry."}]},{"id":"blk-41561","kind":"heading","level":2,"spans":[{"id":"spn-46725","text":"9.3 Retrieval degradation"}]},{"id":"blk-41562","kind":"paragraph","spans":[{"id":"spn-46726","text":"Symptoms:"}]},{"id":"blk-41563","items":[{"blocks":[{"id":"blk-41565","kind":"paragraph","spans":[{"id":"spn-46727","text":"poor relevance"}]}],"id":"blk-41564","kind":"list-item"},{"blocks":[{"id":"blk-41567","kind":"paragraph","spans":[{"id":"spn-46728","text":"stale/conflicting recall"}]}],"id":"blk-41566","kind":"list-item"},{"blocks":[{"id":"blk-41569","kind":"paragraph","spans":[{"id":"spn-46729","text":"weak support around active goals"}]}],"id":"blk-41568","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41570","kind":"paragraph","spans":[{"id":"spn-46730","text":"Response:"}]},{"id":"blk-41571","kind":"paragraph","spans":[{"id":"spn-46731","text":"1. Inspect low-confidence node concentration. 2. Run consolidation. 3. Add missing high-quality nodes (semantic, procedural, temporal, outcome, or goal as appropriate). 4. Use coverage review to identify knowledge gaps. 5. Avoid forcing action when routing says "},{"id":"spn-46732","marks":["code"],"text":"learn"},{"id":"spn-46733","text":" or "},{"id":"spn-46734","marks":["code"],"text":"escalate"},{"id":"spn-46735","text":"."}]},{"id":"blk-41572","kind":"paragraph","spans":[{"id":"spn-46736","text":"---"}]},{"id":"blk-41573","kind":"heading","level":2,"spans":[{"id":"spn-46737","text":"10) Release & Change Management"}]},{"id":"blk-41574","kind":"paragraph","spans":[{"id":"spn-46738","text":"Before releases:"}]},{"id":"blk-41575","kind":"paragraph","spans":[{"id":"spn-46739","text":"1. Run format, compile, and tests. 2. Verify MCP tools/resources remain discoverable. 3. Validate key operational workflows:"}]},{"id":"blk-41576","items":[{"blocks":[{"id":"blk-41578","kind":"paragraph","spans":[{"id":"spn-46740","text":"retrieve -> store -> learn -> consolidate"}]}],"id":"blk-41577","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41579","kind":"paragraph","spans":[{"id":"spn-46741","text":"4. Confirm docs and CLI help text are in sync with behavior. 5. Ensure version parity across project metadata and distribution artifacts."}]},{"id":"blk-41580","kind":"paragraph","spans":[{"id":"spn-46742","text":"After releases:"}]},{"id":"blk-41581","items":[{"blocks":[{"id":"blk-41583","kind":"paragraph","spans":[{"id":"spn-46743","text":"Smoke test install/run path."}]}],"id":"blk-41582","kind":"list-item"},{"blocks":[{"id":"blk-41585","kind":"paragraph","spans":[{"id":"spn-46744","text":"Verify health/resource access from at least one MCP client."}]}],"id":"blk-41584","kind":"list-item"},{"blocks":[{"id":"blk-41587","kind":"paragraph","spans":[{"id":"spn-46745","text":"Confirm no regressions in goal operations and consolidation calls."}]}],"id":"blk-41586","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41588","kind":"paragraph","spans":[{"id":"spn-46746","text":"---"}]},{"id":"blk-41589","kind":"heading","level":2,"spans":[{"id":"spn-46747","text":"11) Security & Safety Practices"}]},{"id":"blk-41590","items":[{"blocks":[{"id":"blk-41592","kind":"paragraph","spans":[{"id":"spn-46748","text":"Never store secrets or credentials in graph content/metadata."}]}],"id":"blk-41591","kind":"list-item"},{"blocks":[{"id":"blk-41594","kind":"paragraph","spans":[{"id":"spn-46749","text":"Use least-privilege file permissions for DB directories."}]}],"id":"blk-41593","kind":"list-item"},{"blocks":[{"id":"blk-41596","kind":"paragraph","spans":[{"id":"spn-46750","text":"Keep logs free of sensitive user data where possible."}]}],"id":"blk-41595","kind":"list-item"},{"blocks":[{"id":"blk-41598","kind":"paragraph","spans":[{"id":"spn-46751","text":"Prefer explicit, auditable metadata over opaque free-text for critical actions."}]}],"id":"blk-41597","kind":"list-item"},{"blocks":[{"id":"blk-41600","kind":"paragraph","spans":[{"id":"spn-46752","text":"Treat externally sourced claims as lower confidence until verified."}]}],"id":"blk-41599","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41601","kind":"paragraph","spans":[{"id":"spn-46753","text":"---"}]},{"id":"blk-41602","kind":"heading","level":2,"spans":[{"id":"spn-46754","text":"12) Recommended SLO-Style Targets (Starter Set)"}]},{"id":"blk-41603","kind":"paragraph","spans":[{"id":"spn-46755","text":"These are practical baseline targets you can tune per environment:"}]},{"id":"blk-41604","items":[{"blocks":[{"id":"blk-41606","kind":"paragraph","spans":[{"id":"spn-46756","marks":["bold"],"text":"Runtime availability:"},{"id":"spn-46757","text":" core services up > 99%"}]}],"id":"blk-41605","kind":"list-item"},{"blocks":[{"id":"blk-41608","kind":"paragraph","spans":[{"id":"spn-46758","marks":["bold"],"text":"MCP request success rate:"},{"id":"spn-46759","text":" > 99% for standard calls"}]}],"id":"blk-41607","kind":"list-item"},{"blocks":[{"id":"blk-41610","kind":"paragraph","spans":[{"id":"spn-46760","marks":["bold"],"text":"Median retrieval latency:"},{"id":"spn-46761","text":" < 2s on local workloads"}]}],"id":"blk-41609","kind":"list-item"},{"blocks":[{"id":"blk-41612","kind":"paragraph","spans":[{"id":"spn-46762","marks":["bold"],"text":"Write success rate:"},{"id":"spn-46763","text":" > 99% for node/goal operations"}]}],"id":"blk-41611","kind":"list-item"},{"blocks":[{"id":"blk-41614","kind":"paragraph","spans":[{"id":"spn-46764","marks":["bold"],"text":"Consolidation cadence adherence:"},{"id":"spn-46765","text":" > 95% of expected cycles"}]}],"id":"blk-41613","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41615","kind":"paragraph","spans":[{"id":"spn-46766","text":"---"}]},{"id":"blk-41616","kind":"heading","level":2,"spans":[{"id":"spn-46767","text":"13) Quick Troubleshooting Matrix"}]},{"head":[{"id":"blk-41618","spans":[{"id":"spn-46768","text":"Symptom"}]},{"id":"blk-41619","spans":[{"id":"spn-46769","text":"Likely Cause"}]},{"id":"blk-41620","spans":[{"id":"spn-46770","text":"First Action"}]}],"id":"blk-41617","kind":"table","rows":[[{"id":"blk-41621","spans":[{"id":"spn-46771","text":"Tool calls timeout"}]},{"id":"blk-41622","spans":[{"id":"spn-46772","text":"Transport/runtime instability"}]},{"id":"blk-41623","spans":[{"id":"spn-46773","text":"Restart runtime, re-check health"}]}],[{"id":"blk-41624","spans":[{"id":"spn-46774","text":"Goals not updating"}]},{"id":"blk-41625","spans":[{"id":"spn-46775","text":"Write-path issue or bad payload"}]},{"id":"blk-41626","spans":[{"id":"spn-46776","text":"Validate payload shape, retry update"}]}],[{"id":"blk-41627","spans":[{"id":"spn-46777","text":"Retrieval returns empty repeatedly"}]},{"id":"blk-41628","spans":[{"id":"spn-46778","text":"Sparse graph or wrong query scope"}]},{"id":"blk-41629","spans":[{"id":"spn-46779","text":"Seed knowledge, broaden query"}]}],[{"id":"blk-41630","spans":[{"id":"spn-46780","text":"Coverage always escalates"}]},{"id":"blk-41631","spans":[{"id":"spn-46781","text":"Insufficient support/confidence"}]},{"id":"blk-41632","spans":[{"id":"spn-46782","text":"Add evidence nodes, review contradictions"}]}],[{"id":"blk-41633","spans":[{"id":"spn-46783","text":"Sudden memory loss feel"}]},{"id":"blk-41634","spans":[{"id":"spn-46784","text":"Aggressive decay/prune settings"}]},{"id":"blk-41635","spans":[{"id":"spn-46785","text":"Inspect consolidation config/status"}]}]]},{"id":"blk-41636","kind":"paragraph","spans":[{"id":"spn-46786","text":"---"}]},{"id":"blk-41637","kind":"heading","level":2,"spans":[{"id":"spn-46787","text":"14) End-of-Session Operator Procedure"}]},{"id":"blk-41638","kind":"paragraph","spans":[{"id":"spn-46788","text":"Before ending a productive session:"}]},{"id":"blk-41639","kind":"paragraph","spans":[{"id":"spn-46789","text":"1. Store key new knowledge discovered. 2. Report any pending outcomes. 3. Update goal progress/status. 4. Trigger consolidation and verify status. 5. Capture any unresolved risks in a goal note for next session continuity."}]},{"id":"blk-41640","kind":"paragraph","spans":[{"id":"spn-46790","text":"---"}]},{"id":"blk-41641","kind":"heading","level":2,"spans":[{"id":"spn-46791","text":"15) Related Documentation"}]},{"id":"blk-41642","items":[{"blocks":[{"id":"blk-41644","kind":"paragraph","spans":[{"id":"spn-46792","marks":["code"],"text":"index"},{"id":"spn-46793","text":" — docs entry point"}]}],"id":"blk-41643","kind":"list-item"},{"blocks":[{"id":"blk-41646","kind":"paragraph","spans":[{"id":"spn-46794","marks":["code"],"text":"architecture"},{"id":"spn-46795","text":" — system design and internals"}]}],"id":"blk-41645","kind":"list-item"},{"blocks":[{"id":"blk-41648","kind":"paragraph","spans":[{"id":"spn-46796","marks":["code"],"text":"quickstart"},{"id":"spn-46797","text":" — first-run path"}]}],"id":"blk-41647","kind":"list-item"},{"blocks":[{"id":"blk-41650","kind":"paragraph","spans":[{"id":"spn-46798","marks":["code"],"text":"mcp-tools"},{"id":"spn-46799","text":" — tool/resource interface reference"}]}],"id":"blk-41649","kind":