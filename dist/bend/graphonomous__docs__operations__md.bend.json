{"bendscript":"0.1","blocks":[{"id":"blk-42337","kind":"heading","level":1,"spans":[{"id":"spn-48845","text":"Operations & Maintenance"}]},{"id":"blk-42338","kind":"paragraph","spans":[{"id":"spn-48846","text":"This page is the operational runbook for running, validating, and maintaining "},{"id":"spn-48847","marks":["bold"],"text":"Graphonomous"},{"id":"spn-48848","text":" in development and production-like environments."}]},{"id":"blk-42339","kind":"paragraph","spans":[{"id":"spn-48849","text":"---"}]},{"id":"blk-42340","kind":"heading","level":2,"spans":[{"id":"spn-48850","text":"1) Operational Model"}]},{"id":"blk-42341","kind":"paragraph","spans":[{"id":"spn-48851","text":"Graphonomous runs as an Elixir/OTP application with supervised runtime services and an MCP server interface over stdio. Core operational concerns are:"}]},{"id":"blk-42342","items":[{"blocks":[{"id":"blk-42344","kind":"paragraph","spans":[{"id":"spn-48852","marks":["bold"],"text":"Process health"},{"id":"spn-48853","text":" (runtime services are up)"}]}],"id":"blk-42343","kind":"list-item"},{"blocks":[{"id":"blk-42346","kind":"paragraph","spans":[{"id":"spn-48854","marks":["bold"],"text":"Data durability"},{"id":"spn-48855","text":" (SQLite-backed state)"}]}],"id":"blk-42345","kind":"list-item"},{"blocks":[{"id":"blk-42348","kind":"paragraph","spans":[{"id":"spn-48856","marks":["bold"],"text":"Retrieval quality"},{"id":"spn-48857","text":" (memory remains relevant)"}]}],"id":"blk-42347","kind":"list-item"},{"blocks":[{"id":"blk-42350","kind":"paragraph","spans":[{"id":"spn-48858","marks":["bold"],"text":"Learning integrity"},{"id":"spn-48859","text":" (outcomes update confidence correctly)"}]}],"id":"blk-42349","kind":"list-item"},{"blocks":[{"id":"blk-42352","kind":"paragraph","spans":[{"id":"spn-48860","marks":["bold"],"text":"Memory hygiene"},{"id":"spn-48861","text":" (consolidation decay/pruning cycles)"}]}],"id":"blk-42351","kind":"list-item"},{"blocks":[{"id":"blk-42354","kind":"paragraph","spans":[{"id":"spn-48862","marks":["bold"],"text":"Transport stability"},{"id":"spn-48863","text":" (MCP client/server connectivity)"}]}],"id":"blk-42353","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42355","kind":"paragraph","spans":[{"id":"spn-48864","text":"---"}]},{"id":"blk-42356","kind":"heading","level":2,"spans":[{"id":"spn-48865","text":"2) Daily Operator Checklist"}]},{"id":"blk-42357","kind":"paragraph","spans":[{"id":"spn-48866","text":"Use this checklist for routine operation:"}]},{"id":"blk-42358","kind":"paragraph","spans":[{"id":"spn-48867","text":"1. Start Graphonomous with an explicit DB path. 2. Verify runtime health snapshot. 3. Verify goals snapshot (if goal-driven workflows are active). 4. Confirm retrieval works on a known query. 5. Confirm writes ("},{"id":"spn-48868","marks":["code"],"text":"store_node"},{"id":"spn-48869","text":") and updates ("},{"id":"spn-48870","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-48871","text":") succeed. 6. Run/inspect consolidation state. 7. Review logs for transport disconnects or repeated timeouts."}]},{"id":"blk-42359","kind":"paragraph","spans":[{"id":"spn-48872","text":"---"}]},{"id":"blk-42360","kind":"heading","level":2,"spans":[{"id":"spn-48873","text":"3) Startup Procedures"}]},{"id":"blk-42361","kind":"heading","level":2,"spans":[{"id":"spn-48874","text":"3.1 Local development startup"}]},{"id":"blk-42362","kind":"paragraph","spans":[{"id":"spn-48875","text":"Run Graphonomous with a dedicated local DB:"}]},{"id":"blk-42363","items":[{"blocks":[{"id":"blk-42365","kind":"paragraph","spans":[{"id":"spn-48876","text":"Ensure your DB directory exists."}]}],"id":"blk-42364","kind":"list-item"},{"blocks":[{"id":"blk-42367","kind":"paragraph","spans":[{"id":"spn-48877","text":"Start using fallback embedder when troubleshooting or on constrained devices."}]}],"id":"blk-42366","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42368","kind":"paragraph","spans":[{"id":"spn-48878","text":"Recommended startup characteristics:"}]},{"id":"blk-42369","items":[{"blocks":[{"id":"blk-42371","kind":"paragraph","spans":[{"id":"spn-48879","text":"Explicit "},{"id":"spn-48880","marks":["code"],"text":"--db"},{"id":"spn-48881","text":" path"}]}],"id":"blk-42370","kind":"list-item"},{"blocks":[{"id":"blk-42373","kind":"paragraph","spans":[{"id":"spn-48882","text":"Stable log level ("},{"id":"spn-48883","marks":["code"],"text":"info"},{"id":"spn-48884","text":" or "},{"id":"spn-48885","marks":["code"],"text":"debug"},{"id":"spn-48886","text":")"}]}],"id":"blk-42372","kind":"list-item"},{"blocks":[{"id":"blk-42375","kind":"paragraph","spans":[{"id":"spn-48887","text":"Request timeout tuned for your client/editor"}]}],"id":"blk-42374","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42376","kind":"heading","level":2,"spans":[{"id":"spn-48888","text":"3.2 MCP client startup validation"}]},{"id":"blk-42377","kind":"paragraph","spans":[{"id":"spn-48889","text":"After startup, validate in this order:"}]},{"id":"blk-42378","kind":"paragraph","spans":[{"id":"spn-48890","text":"1. Tool discovery returns expected Graphonomous tools. 2. Resource reads succeed:"}]},{"id":"blk-42379","items":[{"blocks":[{"id":"blk-42381","kind":"paragraph","spans":[{"id":"spn-48891","marks":["code"],"text":"graphonomous://runtime/health"}]}],"id":"blk-42380","kind":"list-item"},{"blocks":[{"id":"blk-42383","kind":"paragraph","spans":[{"id":"spn-48892","marks":["code"],"text":"graphonomous://goals/snapshot"}]}],"id":"blk-42382","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42384","kind":"paragraph","spans":[{"id":"spn-48893","text":"3. A test retrieval query returns "},{"id":"spn-48894","marks":["code"],"text":"status: ok"},{"id":"spn-48895","text":". 4. A test node write succeeds."}]},{"id":"blk-42385","kind":"paragraph","spans":[{"id":"spn-48896","text":"---"}]},{"id":"blk-42386","kind":"heading","level":2,"spans":[{"id":"spn-48897","text":"4) Health Monitoring"}]},{"id":"blk-42387","kind":"heading","level":2,"spans":[{"id":"spn-48898","text":"4.1 Runtime health resource"}]},{"id":"blk-42388","kind":"paragraph","spans":[{"id":"spn-48899","text":"Use "},{"id":"spn-48900","marks":["code"],"text":"graphonomous://runtime/health"},{"id":"spn-48901","text":" to verify:"}]},{"id":"blk-42389","items":[{"blocks":[{"id":"blk-42391","kind":"paragraph","spans":[{"id":"spn-48902","text":"Process-level service status ("},{"id":"spn-48903","marks":["code"],"text":"up"},{"id":"spn-48904","text":"/"},{"id":"spn-48905","marks":["code"],"text":"down"},{"id":"spn-48906","text":")"}]}],"id":"blk-42390","kind":"list-item"},{"blocks":[{"id":"blk-42393","kind":"paragraph","spans":[{"id":"spn-48907","text":"High-level object counts (nodes/goals)"}]}],"id":"blk-42392","kind":"list-item"},{"blocks":[{"id":"blk-42395","kind":"paragraph","spans":[{"id":"spn-48908","text":"Timestamp of snapshot generation"}]}],"id":"blk-42394","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42396","kind":"paragraph","spans":[{"id":"spn-48909","text":"If any core service is down, restart runtime and verify DB accessibility."}]},{"id":"blk-42397","kind":"heading","level":2,"spans":[{"id":"spn-48910","text":"4.2 Goal snapshot resource"}]},{"id":"blk-42398","kind":"paragraph","spans":[{"id":"spn-48911","text":"Use "},{"id":"spn-48912","marks":["code"],"text":"graphonomous://goals/snapshot"},{"id":"spn-48913","text":" to verify:"}]},{"id":"blk-42399","items":[{"blocks":[{"id":"blk-42401","kind":"paragraph","spans":[{"id":"spn-48914","text":"Total number of goals"}]}],"id":"blk-42400","kind":"list-item"},{"blocks":[{"id":"blk-42403","kind":"paragraph","spans":[{"id":"spn-48915","text":"Status distribution ("},{"id":"spn-48916","marks":["code"],"text":"proposed"},{"id":"spn-48917","text":", "},{"id":"spn-48918","marks":["code"],"text":"active"},{"id":"spn-48919","text":", "},{"id":"spn-48920","marks":["code"],"text":"blocked"},{"id":"spn-48921","text":", "},{"id":"spn-48922","marks":["code"],"text":"completed"},{"id":"spn-48923","text":", etc.)"}]}],"id":"blk-42402","kind":"list-item"},{"blocks":[{"id":"blk-42405","kind":"paragraph","spans":[{"id":"spn-48924","text":"Serialized goal records for debugging orchestration state"}]}],"id":"blk-42404","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42406","kind":"paragraph","spans":[{"id":"spn-48925","text":"---"}]},{"id":"blk-42407","kind":"heading","level":2,"spans":[{"id":"spn-48926","text":"5) Data & Storage Operations"}]},{"id":"blk-42408","kind":"heading","level":2,"spans":[{"id":"spn-48927","text":"5.1 Persistence strategy"}]},{"id":"blk-42409","kind":"paragraph","spans":[{"id":"spn-48928","text":"Graphonomous uses SQLite as durable storage and ETS as hot in-memory cache."}]},{"id":"blk-42410","kind":"paragraph","spans":[{"id":"spn-48929","text":"Operational implications:"}]},{"id":"blk-42411","items":[{"blocks":[{"id":"blk-42413","kind":"paragraph","spans":[{"id":"spn-48930","text":"SQLite file is the recovery source of truth."}]}],"id":"blk-42412","kind":"list-item"},{"blocks":[{"id":"blk-42415","kind":"paragraph","spans":[{"id":"spn-48931","text":"ETS is rebuilt/warmed from DB state."}]}],"id":"blk-42414","kind":"list-item"},{"blocks":[{"id":"blk-42417","kind":"paragraph","spans":[{"id":"spn-48932","text":"Always keep DB path explicit and stable per environment."}]}],"id":"blk-42416","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42418","kind":"heading","level":2,"spans":[{"id":"spn-48933","text":"5.2 Backup strategy"}]},{"id":"blk-42419","kind":"paragraph","spans":[{"id":"spn-48934","text":"Recommended backup practice:"}]},{"id":"blk-42420","items":[{"blocks":[{"id":"blk-42422","kind":"paragraph","spans":[{"id":"spn-48935","text":"Schedule periodic copies/snapshots of the SQLite DB file."}]}],"id":"blk-42421","kind":"list-item"},{"blocks":[{"id":"blk-42424","kind":"paragraph","spans":[{"id":"spn-48936","text":"Perform backups during low-write periods when possible."}]}],"id":"blk-42423","kind":"list-item"},{"blocks":[{"id":"blk-42426","kind":"paragraph","spans":[{"id":"spn-48937","text":"Keep at least:"}]}],"id":"blk-42425","kind":"list-item"},{"blocks":[{"id":"blk-42428","kind":"paragraph","spans":[{"id":"spn-48938","text":"daily rolling backups (7 days),"}]}],"id":"blk-42427","kind":"list-item"},{"blocks":[{"id":"blk-42430","kind":"paragraph","spans":[{"id":"spn-48939","text":"weekly backups (4 weeks),"}]}],"id":"blk-42429","kind":"list-item"},{"blocks":[{"id":"blk-42432","kind":"paragraph","spans":[{"id":"spn-48940","text":"monthly backups (3–6 months)."}]}],"id":"blk-42431","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42433","kind":"heading","level":2,"spans":[{"id":"spn-48941","text":"5.3 Recovery procedure"}]},{"id":"blk-42434","kind":"paragraph","spans":[{"id":"spn-48942","text":"If runtime state appears inconsistent:"}]},{"id":"blk-42435","kind":"paragraph","spans":[{"id":"spn-48943","text":"1. Stop Graphonomous. 2. Backup current DB file before changes. 3. Restart runtime and verify health. 4. Re-run retrieval sanity checks. 5. If needed, restore from known-good backup and replay required operational steps."}]},{"id":"blk-42436","kind":"paragraph","spans":[{"id":"spn-48944","text":"---"}]},{"id":"blk-42437","kind":"heading","level":2,"spans":[{"id":"spn-48945","text":"6) Learning Loop Operations"}]},{"id":"blk-42438","kind":"heading","level":2,"spans":[{"id":"spn-48946","text":"6.1 Required loop discipline"}]},{"id":"blk-42439","kind":"paragraph","spans":[{"id":"spn-48947","text":"For consequential actions:"}]},{"id":"blk-42440","kind":"paragraph","spans":[{"id":"spn-48948","text":"1. Retrieve context first. 2. Perform action. 3. Report outcome with real "},{"id":"spn-48949","marks":["code"],"text":"causal_node_ids"},{"id":"spn-48950","text":"."}]},{"id":"blk-42441","kind":"paragraph","spans":[{"id":"spn-48951","text":"This keeps confidence updates meaningful and avoids drift."}]},{"id":"blk-42442","kind":"heading","level":2,"spans":[{"id":"spn-48952","text":"6.2 Outcome status semantics"}]},{"id":"blk-42443","kind":"paragraph","spans":[{"id":"spn-48953","text":"Use outcome status correctly:"}]},{"id":"blk-42444","items":[{"blocks":[{"id":"blk-42446","kind":"paragraph","spans":[{"id":"spn-48954","marks":["code"],"text":"success"},{"id":"spn-48955","text":": action achieved intended result"}]}],"id":"blk-42445","kind":"list-item"},{"blocks":[{"id":"blk-42448","kind":"paragraph","spans":[{"id":"spn-48956","marks":["code"],"text":"partial_success"},{"id":"spn-48957","text":": mixed outcome"}]}],"id":"blk-42447","kind":"list-item"},{"blocks":[{"id":"blk-42450","kind":"paragraph","spans":[{"id":"spn-48958","marks":["code"],"text":"failure"},{"id":"spn-48959","text":": action failed"}]}],"id":"blk-42449","kind":"list-item"},{"blocks":[{"id":"blk-42452","kind":"paragraph","spans":[{"id":"spn-48960","marks":["code"],"text":"timeout"},{"id":"spn-48961","text":": no reliable completion signal"}]}],"id":"blk-42451","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42453","kind":"paragraph","spans":[{"id":"spn-48962","text":"Treating timeouts as failures can incorrectly penalize good knowledge."}]},{"id":"blk-42454","kind":"heading","level":2,"spans":[{"id":"spn-48963","text":"6.3 Confidence hygiene"}]},{"id":"blk-42455","kind":"paragraph","spans":[{"id":"spn-48964","text":"Operational rule:"}]},{"id":"blk-42456","items":[{"blocks":[{"id":"blk-42458","kind":"paragraph","spans":[{"id":"spn-48965","text":"Use evidence-calibrated confidence values."}]}],"id":"blk-42457","kind":"list-item"},{"blocks":[{"id":"blk-42460","kind":"paragraph","spans":[{"id":"spn-48966","text":"Avoid blanket high confidence in both stored nodes and outcomes."}]}],"id":"blk-42459","kind":"list-item"},{"blocks":[{"id":"blk-42462","kind":"paragraph","spans":[{"id":"spn-48967","text":"Favor structured evidence payloads for audits and debugging."}]}],"id":"blk-42461","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42463","kind":"paragraph","spans":[{"id":"spn-48968","text":"---"}]},{"id":"blk-42464","kind":"heading","level":2,"spans":[{"id":"spn-48969","text":"7) Goal Operations"}]},{"id":"blk-42465","kind":"paragraph","spans":[{"id":"spn-48970","text":"For multi-step work, always use goals."}]},{"id":"blk-42466","kind":"heading","level":2,"spans":[{"id":"spn-48971","text":"7.1 Goal lifecycle flow"}]},{"id":"blk-42467","kind":"paragraph","spans":[{"id":"spn-48972","text":"Typical progression:"}]},{"id":"blk-42468","kind":"paragraph","spans":[{"id":"spn-48973","marks":["code"],"text":"proposed -> active -> completed"},{"id":"spn-48974","text":" or "},{"id":"spn-48975","marks":["code"],"text":"proposed/active -> blocked -> active"},{"id":"spn-48976","text":" (when unblocked)"}]},{"id":"blk-42469","kind":"heading","level":2,"spans":[{"id":"spn-48977","text":"7.2 Coverage review gate"}]},{"id":"blk-42470","kind":"paragraph","spans":[{"id":"spn-48978","text":"Before high-impact actions, run goal coverage review to route execution:"}]},{"id":"blk-42471","items":[{"blocks":[{"id":"blk-42473","kind":"paragraph","spans":[{"id":"spn-48979","marks":["code"],"text":"act"},{"id":"spn-48980","text":": proceed"}]}],"id":"blk-42472","kind":"list-item"},{"blocks":[{"id":"blk-42475","kind":"paragraph","spans":[{"id":"spn-48981","marks":["code"],"text":"learn"},{"id":"spn-48982","text":": gather additional context"}]}],"id":"blk-42474","kind":"list-item"},{"blocks":[{"id":"blk-42477","kind":"paragraph","spans":[{"id":"spn-48983","marks":["code"],"text":"escalate"},{"id":"spn-48984","text":": block/escalate to human or multi-agent process"}]}],"id":"blk-42476","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42478","kind":"heading","level":2,"spans":[{"id":"spn-48985","text":"7.3 Progress and evidence"}]},{"id":"blk-42479","items":[{"blocks":[{"id":"blk-42481","kind":"paragraph","spans":[{"id":"spn-48986","text":"Update progress incrementally (avoid “jump to 100%” without evidence)."}]}],"id":"blk-42480","kind":"list-item"},{"blocks":[{"id":"blk-42483","kind":"paragraph","spans":[{"id":"spn-48987","text":"Link supporting nodes to goals."}]}],"id":"blk-42482","kind":"list-item"},{"blocks":[{"id":"blk-42485","kind":"paragraph","spans":[{"id":"spn-48988","text":"Keep transition metadata descriptive for auditability."}]}],"id":"blk-42484","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42486","kind":"paragraph","spans":[{"id":"spn-48989","text":"---"}]},{"id":"blk-42487","kind":"heading","level":2,"spans":[{"id":"spn-48990","text":"8) Consolidation Operations"}]},{"id":"blk-42488","kind":"paragraph","spans":[{"id":"spn-48991","text":"Consolidation maintains memory quality over time."}]},{"id":"blk-42489","kind":"heading","level":2,"spans":[{"id":"spn-48992","text":"8.1 When to run"}]},{"id":"blk-42490","items":[{"blocks":[{"id":"blk-42492","kind":"paragraph","spans":[{"id":"spn-48993","text":"End of productive sessions"}]}],"id":"blk-42491","kind":"list-item"},{"blocks":[{"id":"blk-42494","kind":"paragraph","spans":[{"id":"spn-48994","text":"Periodically during long autonomous runs"}]}],"id":"blk-42493","kind":"list-item"},{"blocks":[{"id":"blk-42496","kind":"paragraph","spans":[{"id":"spn-48995","text":"After heavy write/ingestion bursts"}]}],"id":"blk-42495","kind":"list-item"},{"blocks":[{"id":"blk-42498","kind":"paragraph","spans":[{"id":"spn-48996","text":"Before critical retrieval/review checkpoints"}]}],"id":"blk-42497","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42499","kind":"heading","level":2,"spans":[{"id":"spn-48997","text":"8.2 What to watch"}]},{"id":"blk-42500","kind":"paragraph","spans":[{"id":"spn-48998","text":"From consolidation status/runtime info monitor:"}]},{"id":"blk-42501","items":[{"blocks":[{"id":"blk-42503","kind":"paragraph","spans":[{"id":"spn-48999","text":"cycle count"}]}],"id":"blk-42502","kind":"list-item"},{"blocks":[{"id":"blk-42505","kind":"paragraph","spans":[{"id":"spn-49000","text":"last run timestamp"}]}],"id":"blk-42504","kind":"list-item"},{"blocks":[{"id":"blk-42507","kind":"paragraph","spans":[{"id":"spn-49001","text":"decay/prune behavior"}]}],"id":"blk-42506","kind":"list-item"},{"blocks":[{"id":"blk-42509","kind":"paragraph","spans":[{"id":"spn-49002","text":"signs of overly aggressive pruning"}]}],"id":"blk-42508","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42510","kind":"paragraph","spans":[{"id":"spn-49003","text":"If retrieval quality drops sharply, inspect consolidation settings and confidence distributions."}]},{"id":"blk-42511","kind":"paragraph","spans":[{"id":"spn-49004","text":"---"}]},{"id":"blk-42512","kind":"heading","level":2,"spans":[{"id":"spn-49005","text":"9) Incident Response Runbooks"}]},{"id":"blk-42513","kind":"heading","level":2,"spans":[{"id":"spn-49006","text":"9.1 MCP server transport instability"}]},{"id":"blk-42514","kind":"paragraph","spans":[{"id":"spn-49007","text":"Symptoms:"}]},{"id":"blk-42515","items":[{"blocks":[{"id":"blk-42517","kind":"paragraph","spans":[{"id":"spn-49008","text":"client timeouts"}]}],"id":"blk-42516","kind":"list-item"},{"blocks":[{"id":"blk-42519","kind":"paragraph","spans":[{"id":"spn-49009","text":"server shutdown messages"}]}],"id":"blk-42518","kind":"list-item"},{"blocks":[{"id":"blk-42521","kind":"paragraph","spans":[{"id":"spn-49010","text":"intermittent success/failure across calls"}]}],"id":"blk-42520","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42522","kind":"paragraph","spans":[{"id":"spn-49011","text":"Response:"}]},{"id":"blk-42523","kind":"paragraph","spans":[{"id":"spn-49012","text":"1. Confirm runtime process is alive. 2. Validate health resource. 3. Restart MCP runtime cleanly. 4. Re-run minimal smoke flow (list tools -> read resources -> retrieve -> store). 5. Inspect logs for transport and timeout patterns. 6. Increase request timeout if workload is heavy."}]},{"id":"blk-42524","kind":"heading","level":2,"spans":[{"id":"spn-49013","text":"9.2 Write-path failures"}]},{"id":"blk-42525","kind":"paragraph","spans":[{"id":"spn-49014","text":"Symptoms:"}]},{"id":"blk-42526","items":[{"blocks":[{"id":"blk-42528","kind":"paragraph","spans":[{"id":"spn-49015","text":"retrieval works but node/goal writes fail"}]}],"id":"blk-42527","kind":"list-item"},{"blocks":[{"id":"blk-42530","kind":"paragraph","spans":[{"id":"spn-49016","text":"partial success in batches"}]}],"id":"blk-42529","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42531","kind":"paragraph","spans":[{"id":"spn-49017","text":"Response:"}]},{"id":"blk-42532","kind":"paragraph","spans":[{"id":"spn-49018","text":"1. Verify DB path and file permissions. 2. Check available disk space. 3. Restart runtime. 4. Retry writes idempotently. 5. Confirm data via query/list calls after retry."}]},{"id":"blk-42533","kind":"heading","level":2,"spans":[{"id":"spn-49019","text":"9.3 Retrieval degradation"}]},{"id":"blk-42534","kind":"paragraph","spans":[{"id":"spn-49020","text":"Symptoms:"}]},{"id":"blk-42535","items":[{"blocks":[{"id":"blk-42537","kind":"paragraph","spans":[{"id":"spn-49021","text":"poor relevance"}]}],"id":"blk-42536","kind":"list-item"},{"blocks":[{"id":"blk-42539","kind":"paragraph","spans":[{"id":"spn-49022","text":"stale/conflicting recall"}]}],"id":"blk-42538","kind":"list-item"},{"blocks":[{"id":"blk-42541","kind":"paragraph","spans":[{"id":"spn-49023","text":"weak support around active goals"}]}],"id":"blk-42540","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42542","kind":"paragraph","spans":[{"id":"spn-49024","text":"Response:"}]},{"id":"blk-42543","kind":"paragraph","spans":[{"id":"spn-49025","text":"1. Inspect low-confidence node concentration. 2. Run consolidation. 3. Add missing high-quality nodes (semantic, procedural, temporal, outcome, or goal as appropriate). 4. Use coverage review to identify knowledge gaps. 5. Avoid forcing action when routing says "},{"id":"spn-49026","marks":["code"],"text":"learn"},{"id":"spn-49027","text":" or "},{"id":"spn-49028","marks":["code"],"text":"escalate"},{"id":"spn-49029","text":"."}]},{"id":"blk-42544","kind":"paragraph","spans":[{"id":"spn-49030","text":"---"}]},{"id":"blk-42545","kind":"heading","level":2,"spans":[{"id":"spn-49031","text":"10) Release & Change Management"}]},{"id":"blk-42546","kind":"paragraph","spans":[{"id":"spn-49032","text":"Before releases:"}]},{"id":"blk-42547","kind":"paragraph","spans":[{"id":"spn-49033","text":"1. Run format, compile, and tests. 2. Verify MCP tools/resources remain discoverable. 3. Validate key operational workflows:"}]},{"id":"blk-42548","items":[{"blocks":[{"id":"blk-42550","kind":"paragraph","spans":[{"id":"spn-49034","text":"retrieve -> store -> learn -> consolidate"}]}],"id":"blk-42549","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42551","kind":"paragraph","spans":[{"id":"spn-49035","text":"4. Confirm docs and CLI help text are in sync with behavior. 5. Ensure version parity across project metadata and distribution artifacts."}]},{"id":"blk-42552","kind":"paragraph","spans":[{"id":"spn-49036","text":"After releases:"}]},{"id":"blk-42553","items":[{"blocks":[{"id":"blk-42555","kind":"paragraph","spans":[{"id":"spn-49037","text":"Smoke test install/run path."}]}],"id":"blk-42554","kind":"list-item"},{"blocks":[{"id":"blk-42557","kind":"paragraph","spans":[{"id":"spn-49038","text":"Verify health/resource access from at least one MCP client."}]}],"id":"blk-42556","kind":"list-item"},{"blocks":[{"id":"blk-42559","kind":"paragraph","spans":[{"id":"spn-49039","text":"Confirm no regressions in goal operations and consolidation calls."}]}],"id":"blk-42558","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42560","kind":"paragraph","spans":[{"id":"spn-49040","text":"---"}]},{"id":"blk-42561","kind":"heading","level":2,"spans":[{"id":"spn-49041","text":"11) Security & Safety Practices"}]},{"id":"blk-42562","items":[{"blocks":[{"id":"blk-42564","kind":"paragraph","spans":[{"id":"spn-49042","text":"Never store secrets or credentials in graph content/metadata."}]}],"id":"blk-42563","kind":"list-item"},{"blocks":[{"id":"blk-42566","kind":"paragraph","spans":[{"id":"spn-49043","text":"Use least-privilege file permissions for DB directories."}]}],"id":"blk-42565","kind":"list-item"},{"blocks":[{"id":"blk-42568","kind":"paragraph","spans":[{"id":"spn-49044","text":"Keep logs free of sensitive user data where possible."}]}],"id":"blk-42567","kind":"list-item"},{"blocks":[{"id":"blk-42570","kind":"paragraph","spans":[{"id":"spn-49045","text":"Prefer explicit, auditable metadata over opaque free-text for critical actions."}]}],"id":"blk-42569","kind":"list-item"},{"blocks":[{"id":"blk-42572","kind":"paragraph","spans":[{"id":"spn-49046","text":"Treat externally sourced claims as lower confidence until verified."}]}],"id":"blk-42571","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42573","kind":"paragraph","spans":[{"id":"spn-49047","text":"---"}]},{"id":"blk-42574","kind":"heading","level":2,"spans":[{"id":"spn-49048","text":"12) Recommended SLO-Style Targets (Starter Set)"}]},{"id":"blk-42575","kind":"paragraph","spans":[{"id":"spn-49049","text":"These are practical baseline targets you can tune per environment:"}]},{"id":"blk-42576","items":[{"blocks":[{"id":"blk-42578","kind":"paragraph","spans":[{"id":"spn-49050","marks":["bold"],"text":"Runtime availability:"},{"id":"spn-49051","text":" core services up > 99%"}]}],"id":"blk-42577","kind":"list-item"},{"blocks":[{"id":"blk-42580","kind":"paragraph","spans":[{"id":"spn-49052","marks":["bold"],"text":"MCP request success rate:"},{"id":"spn-49053","text":" > 99% for standard calls"}]}],"id":"blk-42579","kind":"list-item"},{"blocks":[{"id":"blk-42582","kind":"paragraph","spans":[{"id":"spn-49054","marks":["bold"],"text":"Median retrieval latency:"},{"id":"spn-49055","text":" < 2s on local workloads"}]}],"id":"blk-42581","kind":"list-item"},{"blocks":[{"id":"blk-42584","kind":"paragraph","spans":[{"id":"spn-49056","marks":["bold"],"text":"Write success rate:"},{"id":"spn-49057","text":" > 99% for node/goal operations"}]}],"id":"blk-42583","kind":"list-item"},{"blocks":[{"id":"blk-42586","kind":"paragraph","spans":[{"id":"spn-49058","marks":["bold"],"text":"Consolidation cadence adherence:"},{"id":"spn-49059","text":" > 95% of expected cycles"}]}],"id":"blk-42585","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42587","kind":"paragraph","spans":[{"id":"spn-49060","text":"---"}]},{"id":"blk-42588","kind":"heading","level":2,"spans":[{"id":"spn-49061","text":"13) Quick Troubleshooting Matrix"}]},{"head":[{"id":"blk-42590","spans":[{"id":"spn-49062","text":"Symptom"}]},{"id":"blk-42591","spans":[{"id":"spn-49063","text":"Likely Cause"}]},{"id":"blk-42592","spans":[{"id":"spn-49064","text":"First Action"}]}],"id":"blk-42589","kind":"table","rows":[[{"id":"blk-42593","spans":[{"id":"spn-49065","text":"Tool calls timeout"}]},{"id":"blk-42594","spans":[{"id":"spn-49066","text":"Transport/runtime instability"}]},{"id":"blk-42595","spans":[{"id":"spn-49067","text":"Restart runtime, re-check health"}]}],[{"id":"blk-42596","spans":[{"id":"spn-49068","text":"Goals not updating"}]},{"id":"blk-42597","spans":[{"id":"spn-49069","text":"Write-path issue or bad payload"}]},{"id":"blk-42598","spans":[{"id":"spn-49070","text":"Validate payload shape, retry update"}]}],[{"id":"blk-42599","spans":[{"id":"spn-49071","text":"Retrieval returns empty repeatedly"}]},{"id":"blk-42600","spans":[{"id":"spn-49072","text":"Sparse graph or wrong query scope"}]},{"id":"blk-42601","spans":[{"id":"spn-49073","text":"Seed knowledge, broaden query"}]}],[{"id":"blk-42602","spans":[{"id":"spn-49074","text":"Coverage always escalates"}]},{"id":"blk-42603","spans":[{"id":"spn-49075","text":"Insufficient support/confidence"}]},{"id":"blk-42604","spans":[{"id":"spn-49076","text":"Add evidence nodes, review contradictions"}]}],[{"id":"blk-42605","spans":[{"id":"spn-49077","text":"Sudden memory loss feel"}]},{"id":"blk-42606","spans":[{"id":"spn-49078","text":"Aggressive decay/prune settings"}]},{"id":"blk-42607","spans":[{"id":"spn-49079","text":"Inspect consolidation config/status"}]}]]},{"id":"blk-42608","kind":"paragraph","spans":[{"id":"spn-49080","text":"---"}]},{"id":"blk-42609","kind":"heading","level":2,"spans":[{"id":"spn-49081","text":"14) End-of-Session Operator Procedure"}]},{"id":"blk-42610","kind":"paragraph","spans":[{"id":"spn-49082","text":"Before ending a productive session:"}]},{"id":"blk-42611","kind":"paragraph","spans":[{"id":"spn-49083","text":"1. Store key new knowledge discovered. 2. Report any pending outcomes. 3. Update goal progress/status. 4. Trigger consolidation and verify status. 5. Capture any unresolved risks in a goal note for next session continuity."}]},{"id":"blk-42612","kind":"paragraph","spans":[{"id":"spn-49084","text":"---"}]},{"id":"blk-42613","kind":"heading","level":2,"spans":[{"id":"spn-49085","text":"15) Related Documentation"}]},{"id":"blk-42614","items":[{"blocks":[{"id":"blk-42616","kind":"paragraph","spans":[{"id":"spn-49086","marks":["code"],"text":"index"},{"id":"spn-49087","text":" — docs entry point"}]}],"id":"blk-42615","kind":"list-item"},{"blocks":[{"id":"blk-42618","kind":"paragraph","spans":[{"id":"spn-49088","marks":["code"],"text":"architecture"},{"id":"spn-49089","text":" — system design and internals"}]}],"id":"blk-42617","kind":"list-item"},{"blocks":[{"id":"blk-42620","kind":"paragraph","spans":[{"id":"spn-49090","marks":["code"],"text":"quickstart"},{"id":"spn-49091","text":" — first-run path"}]}],"id":"blk-42619","kind":"list-item"},{"blocks":[{"id":"blk-42622","kind":"paragraph","spans":[{"id":"spn-49092","marks":["code"],"text":"mcp-tools"},{"id":"spn-49093","text":" — tool/resource interface reference"}]}],"id":"blk-42621","kind":