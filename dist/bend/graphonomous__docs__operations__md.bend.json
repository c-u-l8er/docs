{"bendscript":"0.1","blocks":[{"id":"blk-41851","kind":"heading","level":1,"spans":[{"id":"spn-47725","text":"Operations & Maintenance"}]},{"id":"blk-41852","kind":"paragraph","spans":[{"id":"spn-47726","text":"This page is the operational runbook for running, validating, and maintaining "},{"id":"spn-47727","marks":["bold"],"text":"Graphonomous"},{"id":"spn-47728","text":" in development and production-like environments."}]},{"id":"blk-41853","kind":"paragraph","spans":[{"id":"spn-47729","text":"---"}]},{"id":"blk-41854","kind":"heading","level":2,"spans":[{"id":"spn-47730","text":"1) Operational Model"}]},{"id":"blk-41855","kind":"paragraph","spans":[{"id":"spn-47731","text":"Graphonomous runs as an Elixir/OTP application with supervised runtime services and an MCP server interface over stdio. Core operational concerns are:"}]},{"id":"blk-41856","items":[{"blocks":[{"id":"blk-41858","kind":"paragraph","spans":[{"id":"spn-47732","marks":["bold"],"text":"Process health"},{"id":"spn-47733","text":" (runtime services are up)"}]}],"id":"blk-41857","kind":"list-item"},{"blocks":[{"id":"blk-41860","kind":"paragraph","spans":[{"id":"spn-47734","marks":["bold"],"text":"Data durability"},{"id":"spn-47735","text":" (SQLite-backed state)"}]}],"id":"blk-41859","kind":"list-item"},{"blocks":[{"id":"blk-41862","kind":"paragraph","spans":[{"id":"spn-47736","marks":["bold"],"text":"Retrieval quality"},{"id":"spn-47737","text":" (memory remains relevant)"}]}],"id":"blk-41861","kind":"list-item"},{"blocks":[{"id":"blk-41864","kind":"paragraph","spans":[{"id":"spn-47738","marks":["bold"],"text":"Learning integrity"},{"id":"spn-47739","text":" (outcomes update confidence correctly)"}]}],"id":"blk-41863","kind":"list-item"},{"blocks":[{"id":"blk-41866","kind":"paragraph","spans":[{"id":"spn-47740","marks":["bold"],"text":"Memory hygiene"},{"id":"spn-47741","text":" (consolidation decay/pruning cycles)"}]}],"id":"blk-41865","kind":"list-item"},{"blocks":[{"id":"blk-41868","kind":"paragraph","spans":[{"id":"spn-47742","marks":["bold"],"text":"Transport stability"},{"id":"spn-47743","text":" (MCP client/server connectivity)"}]}],"id":"blk-41867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41869","kind":"paragraph","spans":[{"id":"spn-47744","text":"---"}]},{"id":"blk-41870","kind":"heading","level":2,"spans":[{"id":"spn-47745","text":"2) Daily Operator Checklist"}]},{"id":"blk-41871","kind":"paragraph","spans":[{"id":"spn-47746","text":"Use this checklist for routine operation:"}]},{"id":"blk-41872","kind":"paragraph","spans":[{"id":"spn-47747","text":"1. Start Graphonomous with an explicit DB path. 2. Verify runtime health snapshot. 3. Verify goals snapshot (if goal-driven workflows are active). 4. Confirm retrieval works on a known query. 5. Confirm writes ("},{"id":"spn-47748","marks":["code"],"text":"store_node"},{"id":"spn-47749","text":") and updates ("},{"id":"spn-47750","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-47751","text":") succeed. 6. Run/inspect consolidation state. 7. Review logs for transport disconnects or repeated timeouts."}]},{"id":"blk-41873","kind":"paragraph","spans":[{"id":"spn-47752","text":"---"}]},{"id":"blk-41874","kind":"heading","level":2,"spans":[{"id":"spn-47753","text":"3) Startup Procedures"}]},{"id":"blk-41875","kind":"heading","level":2,"spans":[{"id":"spn-47754","text":"3.1 Local development startup"}]},{"id":"blk-41876","kind":"paragraph","spans":[{"id":"spn-47755","text":"Run Graphonomous with a dedicated local DB:"}]},{"id":"blk-41877","items":[{"blocks":[{"id":"blk-41879","kind":"paragraph","spans":[{"id":"spn-47756","text":"Ensure your DB directory exists."}]}],"id":"blk-41878","kind":"list-item"},{"blocks":[{"id":"blk-41881","kind":"paragraph","spans":[{"id":"spn-47757","text":"Start using fallback embedder when troubleshooting or on constrained devices."}]}],"id":"blk-41880","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41882","kind":"paragraph","spans":[{"id":"spn-47758","text":"Recommended startup characteristics:"}]},{"id":"blk-41883","items":[{"blocks":[{"id":"blk-41885","kind":"paragraph","spans":[{"id":"spn-47759","text":"Explicit "},{"id":"spn-47760","marks":["code"],"text":"--db"},{"id":"spn-47761","text":" path"}]}],"id":"blk-41884","kind":"list-item"},{"blocks":[{"id":"blk-41887","kind":"paragraph","spans":[{"id":"spn-47762","text":"Stable log level ("},{"id":"spn-47763","marks":["code"],"text":"info"},{"id":"spn-47764","text":" or "},{"id":"spn-47765","marks":["code"],"text":"debug"},{"id":"spn-47766","text":")"}]}],"id":"blk-41886","kind":"list-item"},{"blocks":[{"id":"blk-41889","kind":"paragraph","spans":[{"id":"spn-47767","text":"Request timeout tuned for your client/editor"}]}],"id":"blk-41888","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41890","kind":"heading","level":2,"spans":[{"id":"spn-47768","text":"3.2 MCP client startup validation"}]},{"id":"blk-41891","kind":"paragraph","spans":[{"id":"spn-47769","text":"After startup, validate in this order:"}]},{"id":"blk-41892","kind":"paragraph","spans":[{"id":"spn-47770","text":"1. Tool discovery returns expected Graphonomous tools. 2. Resource reads succeed:"}]},{"id":"blk-41893","items":[{"blocks":[{"id":"blk-41895","kind":"paragraph","spans":[{"id":"spn-47771","marks":["code"],"text":"graphonomous://runtime/health"}]}],"id":"blk-41894","kind":"list-item"},{"blocks":[{"id":"blk-41897","kind":"paragraph","spans":[{"id":"spn-47772","marks":["code"],"text":"graphonomous://goals/snapshot"}]}],"id":"blk-41896","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41898","kind":"paragraph","spans":[{"id":"spn-47773","text":"3. A test retrieval query returns "},{"id":"spn-47774","marks":["code"],"text":"status: ok"},{"id":"spn-47775","text":". 4. A test node write succeeds."}]},{"id":"blk-41899","kind":"paragraph","spans":[{"id":"spn-47776","text":"---"}]},{"id":"blk-41900","kind":"heading","level":2,"spans":[{"id":"spn-47777","text":"4) Health Monitoring"}]},{"id":"blk-41901","kind":"heading","level":2,"spans":[{"id":"spn-47778","text":"4.1 Runtime health resource"}]},{"id":"blk-41902","kind":"paragraph","spans":[{"id":"spn-47779","text":"Use "},{"id":"spn-47780","marks":["code"],"text":"graphonomous://runtime/health"},{"id":"spn-47781","text":" to verify:"}]},{"id":"blk-41903","items":[{"blocks":[{"id":"blk-41905","kind":"paragraph","spans":[{"id":"spn-47782","text":"Process-level service status ("},{"id":"spn-47783","marks":["code"],"text":"up"},{"id":"spn-47784","text":"/"},{"id":"spn-47785","marks":["code"],"text":"down"},{"id":"spn-47786","text":")"}]}],"id":"blk-41904","kind":"list-item"},{"blocks":[{"id":"blk-41907","kind":"paragraph","spans":[{"id":"spn-47787","text":"High-level object counts (nodes/goals)"}]}],"id":"blk-41906","kind":"list-item"},{"blocks":[{"id":"blk-41909","kind":"paragraph","spans":[{"id":"spn-47788","text":"Timestamp of snapshot generation"}]}],"id":"blk-41908","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41910","kind":"paragraph","spans":[{"id":"spn-47789","text":"If any core service is down, restart runtime and verify DB accessibility."}]},{"id":"blk-41911","kind":"heading","level":2,"spans":[{"id":"spn-47790","text":"4.2 Goal snapshot resource"}]},{"id":"blk-41912","kind":"paragraph","spans":[{"id":"spn-47791","text":"Use "},{"id":"spn-47792","marks":["code"],"text":"graphonomous://goals/snapshot"},{"id":"spn-47793","text":" to verify:"}]},{"id":"blk-41913","items":[{"blocks":[{"id":"blk-41915","kind":"paragraph","spans":[{"id":"spn-47794","text":"Total number of goals"}]}],"id":"blk-41914","kind":"list-item"},{"blocks":[{"id":"blk-41917","kind":"paragraph","spans":[{"id":"spn-47795","text":"Status distribution ("},{"id":"spn-47796","marks":["code"],"text":"proposed"},{"id":"spn-47797","text":", "},{"id":"spn-47798","marks":["code"],"text":"active"},{"id":"spn-47799","text":", "},{"id":"spn-47800","marks":["code"],"text":"blocked"},{"id":"spn-47801","text":", "},{"id":"spn-47802","marks":["code"],"text":"completed"},{"id":"spn-47803","text":", etc.)"}]}],"id":"blk-41916","kind":"list-item"},{"blocks":[{"id":"blk-41919","kind":"paragraph","spans":[{"id":"spn-47804","text":"Serialized goal records for debugging orchestration state"}]}],"id":"blk-41918","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41920","kind":"paragraph","spans":[{"id":"spn-47805","text":"---"}]},{"id":"blk-41921","kind":"heading","level":2,"spans":[{"id":"spn-47806","text":"5) Data & Storage Operations"}]},{"id":"blk-41922","kind":"heading","level":2,"spans":[{"id":"spn-47807","text":"5.1 Persistence strategy"}]},{"id":"blk-41923","kind":"paragraph","spans":[{"id":"spn-47808","text":"Graphonomous uses SQLite as durable storage and ETS as hot in-memory cache."}]},{"id":"blk-41924","kind":"paragraph","spans":[{"id":"spn-47809","text":"Operational implications:"}]},{"id":"blk-41925","items":[{"blocks":[{"id":"blk-41927","kind":"paragraph","spans":[{"id":"spn-47810","text":"SQLite file is the recovery source of truth."}]}],"id":"blk-41926","kind":"list-item"},{"blocks":[{"id":"blk-41929","kind":"paragraph","spans":[{"id":"spn-47811","text":"ETS is rebuilt/warmed from DB state."}]}],"id":"blk-41928","kind":"list-item"},{"blocks":[{"id":"blk-41931","kind":"paragraph","spans":[{"id":"spn-47812","text":"Always keep DB path explicit and stable per environment."}]}],"id":"blk-41930","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41932","kind":"heading","level":2,"spans":[{"id":"spn-47813","text":"5.2 Backup strategy"}]},{"id":"blk-41933","kind":"paragraph","spans":[{"id":"spn-47814","text":"Recommended backup practice:"}]},{"id":"blk-41934","items":[{"blocks":[{"id":"blk-41936","kind":"paragraph","spans":[{"id":"spn-47815","text":"Schedule periodic copies/snapshots of the SQLite DB file."}]}],"id":"blk-41935","kind":"list-item"},{"blocks":[{"id":"blk-41938","kind":"paragraph","spans":[{"id":"spn-47816","text":"Perform backups during low-write periods when possible."}]}],"id":"blk-41937","kind":"list-item"},{"blocks":[{"id":"blk-41940","kind":"paragraph","spans":[{"id":"spn-47817","text":"Keep at least:"}]}],"id":"blk-41939","kind":"list-item"},{"blocks":[{"id":"blk-41942","kind":"paragraph","spans":[{"id":"spn-47818","text":"daily rolling backups (7 days),"}]}],"id":"blk-41941","kind":"list-item"},{"blocks":[{"id":"blk-41944","kind":"paragraph","spans":[{"id":"spn-47819","text":"weekly backups (4 weeks),"}]}],"id":"blk-41943","kind":"list-item"},{"blocks":[{"id":"blk-41946","kind":"paragraph","spans":[{"id":"spn-47820","text":"monthly backups (3–6 months)."}]}],"id":"blk-41945","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41947","kind":"heading","level":2,"spans":[{"id":"spn-47821","text":"5.3 Recovery procedure"}]},{"id":"blk-41948","kind":"paragraph","spans":[{"id":"spn-47822","text":"If runtime state appears inconsistent:"}]},{"id":"blk-41949","kind":"paragraph","spans":[{"id":"spn-47823","text":"1. Stop Graphonomous. 2. Backup current DB file before changes. 3. Restart runtime and verify health. 4. Re-run retrieval sanity checks. 5. If needed, restore from known-good backup and replay required operational steps."}]},{"id":"blk-41950","kind":"paragraph","spans":[{"id":"spn-47824","text":"---"}]},{"id":"blk-41951","kind":"heading","level":2,"spans":[{"id":"spn-47825","text":"6) Learning Loop Operations"}]},{"id":"blk-41952","kind":"heading","level":2,"spans":[{"id":"spn-47826","text":"6.1 Required loop discipline"}]},{"id":"blk-41953","kind":"paragraph","spans":[{"id":"spn-47827","text":"For consequential actions:"}]},{"id":"blk-41954","kind":"paragraph","spans":[{"id":"spn-47828","text":"1. Retrieve context first. 2. Perform action. 3. Report outcome with real "},{"id":"spn-47829","marks":["code"],"text":"causal_node_ids"},{"id":"spn-47830","text":"."}]},{"id":"blk-41955","kind":"paragraph","spans":[{"id":"spn-47831","text":"This keeps confidence updates meaningful and avoids drift."}]},{"id":"blk-41956","kind":"heading","level":2,"spans":[{"id":"spn-47832","text":"6.2 Outcome status semantics"}]},{"id":"blk-41957","kind":"paragraph","spans":[{"id":"spn-47833","text":"Use outcome status correctly:"}]},{"id":"blk-41958","items":[{"blocks":[{"id":"blk-41960","kind":"paragraph","spans":[{"id":"spn-47834","marks":["code"],"text":"success"},{"id":"spn-47835","text":": action achieved intended result"}]}],"id":"blk-41959","kind":"list-item"},{"blocks":[{"id":"blk-41962","kind":"paragraph","spans":[{"id":"spn-47836","marks":["code"],"text":"partial_success"},{"id":"spn-47837","text":": mixed outcome"}]}],"id":"blk-41961","kind":"list-item"},{"blocks":[{"id":"blk-41964","kind":"paragraph","spans":[{"id":"spn-47838","marks":["code"],"text":"failure"},{"id":"spn-47839","text":": action failed"}]}],"id":"blk-41963","kind":"list-item"},{"blocks":[{"id":"blk-41966","kind":"paragraph","spans":[{"id":"spn-47840","marks":["code"],"text":"timeout"},{"id":"spn-47841","text":": no reliable completion signal"}]}],"id":"blk-41965","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41967","kind":"paragraph","spans":[{"id":"spn-47842","text":"Treating timeouts as failures can incorrectly penalize good knowledge."}]},{"id":"blk-41968","kind":"heading","level":2,"spans":[{"id":"spn-47843","text":"6.3 Confidence hygiene"}]},{"id":"blk-41969","kind":"paragraph","spans":[{"id":"spn-47844","text":"Operational rule:"}]},{"id":"blk-41970","items":[{"blocks":[{"id":"blk-41972","kind":"paragraph","spans":[{"id":"spn-47845","text":"Use evidence-calibrated confidence values."}]}],"id":"blk-41971","kind":"list-item"},{"blocks":[{"id":"blk-41974","kind":"paragraph","spans":[{"id":"spn-47846","text":"Avoid blanket high confidence in both stored nodes and outcomes."}]}],"id":"blk-41973","kind":"list-item"},{"blocks":[{"id":"blk-41976","kind":"paragraph","spans":[{"id":"spn-47847","text":"Favor structured evidence payloads for audits and debugging."}]}],"id":"blk-41975","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41977","kind":"paragraph","spans":[{"id":"spn-47848","text":"---"}]},{"id":"blk-41978","kind":"heading","level":2,"spans":[{"id":"spn-47849","text":"7) Goal Operations"}]},{"id":"blk-41979","kind":"paragraph","spans":[{"id":"spn-47850","text":"For multi-step work, always use goals."}]},{"id":"blk-41980","kind":"heading","level":2,"spans":[{"id":"spn-47851","text":"7.1 Goal lifecycle flow"}]},{"id":"blk-41981","kind":"paragraph","spans":[{"id":"spn-47852","text":"Typical progression:"}]},{"id":"blk-41982","kind":"paragraph","spans":[{"id":"spn-47853","marks":["code"],"text":"proposed -> active -> completed"},{"id":"spn-47854","text":" or "},{"id":"spn-47855","marks":["code"],"text":"proposed/active -> blocked -> active"},{"id":"spn-47856","text":" (when unblocked)"}]},{"id":"blk-41983","kind":"heading","level":2,"spans":[{"id":"spn-47857","text":"7.2 Coverage review gate"}]},{"id":"blk-41984","kind":"paragraph","spans":[{"id":"spn-47858","text":"Before high-impact actions, run goal coverage review to route execution:"}]},{"id":"blk-41985","items":[{"blocks":[{"id":"blk-41987","kind":"paragraph","spans":[{"id":"spn-47859","marks":["code"],"text":"act"},{"id":"spn-47860","text":": proceed"}]}],"id":"blk-41986","kind":"list-item"},{"blocks":[{"id":"blk-41989","kind":"paragraph","spans":[{"id":"spn-47861","marks":["code"],"text":"learn"},{"id":"spn-47862","text":": gather additional context"}]}],"id":"blk-41988","kind":"list-item"},{"blocks":[{"id":"blk-41991","kind":"paragraph","spans":[{"id":"spn-47863","marks":["code"],"text":"escalate"},{"id":"spn-47864","text":": block/escalate to human or multi-agent process"}]}],"id":"blk-41990","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41992","kind":"heading","level":2,"spans":[{"id":"spn-47865","text":"7.3 Progress and evidence"}]},{"id":"blk-41993","items":[{"blocks":[{"id":"blk-41995","kind":"paragraph","spans":[{"id":"spn-47866","text":"Update progress incrementally (avoid “jump to 100%” without evidence)."}]}],"id":"blk-41994","kind":"list-item"},{"blocks":[{"id":"blk-41997","kind":"paragraph","spans":[{"id":"spn-47867","text":"Link supporting nodes to goals."}]}],"id":"blk-41996","kind":"list-item"},{"blocks":[{"id":"blk-41999","kind":"paragraph","spans":[{"id":"spn-47868","text":"Keep transition metadata descriptive for auditability."}]}],"id":"blk-41998","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42000","kind":"paragraph","spans":[{"id":"spn-47869","text":"---"}]},{"id":"blk-42001","kind":"heading","level":2,"spans":[{"id":"spn-47870","text":"8) Consolidation Operations"}]},{"id":"blk-42002","kind":"paragraph","spans":[{"id":"spn-47871","text":"Consolidation maintains memory quality over time."}]},{"id":"blk-42003","kind":"heading","level":2,"spans":[{"id":"spn-47872","text":"8.1 When to run"}]},{"id":"blk-42004","items":[{"blocks":[{"id":"blk-42006","kind":"paragraph","spans":[{"id":"spn-47873","text":"End of productive sessions"}]}],"id":"blk-42005","kind":"list-item"},{"blocks":[{"id":"blk-42008","kind":"paragraph","spans":[{"id":"spn-47874","text":"Periodically during long autonomous runs"}]}],"id":"blk-42007","kind":"list-item"},{"blocks":[{"id":"blk-42010","kind":"paragraph","spans":[{"id":"spn-47875","text":"After heavy write/ingestion bursts"}]}],"id":"blk-42009","kind":"list-item"},{"blocks":[{"id":"blk-42012","kind":"paragraph","spans":[{"id":"spn-47876","text":"Before critical retrieval/review checkpoints"}]}],"id":"blk-42011","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42013","kind":"heading","level":2,"spans":[{"id":"spn-47877","text":"8.2 What to watch"}]},{"id":"blk-42014","kind":"paragraph","spans":[{"id":"spn-47878","text":"From consolidation status/runtime info monitor:"}]},{"id":"blk-42015","items":[{"blocks":[{"id":"blk-42017","kind":"paragraph","spans":[{"id":"spn-47879","text":"cycle count"}]}],"id":"blk-42016","kind":"list-item"},{"blocks":[{"id":"blk-42019","kind":"paragraph","spans":[{"id":"spn-47880","text":"last run timestamp"}]}],"id":"blk-42018","kind":"list-item"},{"blocks":[{"id":"blk-42021","kind":"paragraph","spans":[{"id":"spn-47881","text":"decay/prune behavior"}]}],"id":"blk-42020","kind":"list-item"},{"blocks":[{"id":"blk-42023","kind":"paragraph","spans":[{"id":"spn-47882","text":"signs of overly aggressive pruning"}]}],"id":"blk-42022","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42024","kind":"paragraph","spans":[{"id":"spn-47883","text":"If retrieval quality drops sharply, inspect consolidation settings and confidence distributions."}]},{"id":"blk-42025","kind":"paragraph","spans":[{"id":"spn-47884","text":"---"}]},{"id":"blk-42026","kind":"heading","level":2,"spans":[{"id":"spn-47885","text":"9) Incident Response Runbooks"}]},{"id":"blk-42027","kind":"heading","level":2,"spans":[{"id":"spn-47886","text":"9.1 MCP server transport instability"}]},{"id":"blk-42028","kind":"paragraph","spans":[{"id":"spn-47887","text":"Symptoms:"}]},{"id":"blk-42029","items":[{"blocks":[{"id":"blk-42031","kind":"paragraph","spans":[{"id":"spn-47888","text":"client timeouts"}]}],"id":"blk-42030","kind":"list-item"},{"blocks":[{"id":"blk-42033","kind":"paragraph","spans":[{"id":"spn-47889","text":"server shutdown messages"}]}],"id":"blk-42032","kind":"list-item"},{"blocks":[{"id":"blk-42035","kind":"paragraph","spans":[{"id":"spn-47890","text":"intermittent success/failure across calls"}]}],"id":"blk-42034","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42036","kind":"paragraph","spans":[{"id":"spn-47891","text":"Response:"}]},{"id":"blk-42037","kind":"paragraph","spans":[{"id":"spn-47892","text":"1. Confirm runtime process is alive. 2. Validate health resource. 3. Restart MCP runtime cleanly. 4. Re-run minimal smoke flow (list tools -> read resources -> retrieve -> store). 5. Inspect logs for transport and timeout patterns. 6. Increase request timeout if workload is heavy."}]},{"id":"blk-42038","kind":"heading","level":2,"spans":[{"id":"spn-47893","text":"9.2 Write-path failures"}]},{"id":"blk-42039","kind":"paragraph","spans":[{"id":"spn-47894","text":"Symptoms:"}]},{"id":"blk-42040","items":[{"blocks":[{"id":"blk-42042","kind":"paragraph","spans":[{"id":"spn-47895","text":"retrieval works but node/goal writes fail"}]}],"id":"blk-42041","kind":"list-item"},{"blocks":[{"id":"blk-42044","kind":"paragraph","spans":[{"id":"spn-47896","text":"partial success in batches"}]}],"id":"blk-42043","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42045","kind":"paragraph","spans":[{"id":"spn-47897","text":"Response:"}]},{"id":"blk-42046","kind":"paragraph","spans":[{"id":"spn-47898","text":"1. Verify DB path and file permissions. 2. Check available disk space. 3. Restart runtime. 4. Retry writes idempotently. 5. Confirm data via query/list calls after retry."}]},{"id":"blk-42047","kind":"heading","level":2,"spans":[{"id":"spn-47899","text":"9.3 Retrieval degradation"}]},{"id":"blk-42048","kind":"paragraph","spans":[{"id":"spn-47900","text":"Symptoms:"}]},{"id":"blk-42049","items":[{"blocks":[{"id":"blk-42051","kind":"paragraph","spans":[{"id":"spn-47901","text":"poor relevance"}]}],"id":"blk-42050","kind":"list-item"},{"blocks":[{"id":"blk-42053","kind":"paragraph","spans":[{"id":"spn-47902","text":"stale/conflicting recall"}]}],"id":"blk-42052","kind":"list-item"},{"blocks":[{"id":"blk-42055","kind":"paragraph","spans":[{"id":"spn-47903","text":"weak support around active goals"}]}],"id":"blk-42054","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42056","kind":"paragraph","spans":[{"id":"spn-47904","text":"Response:"}]},{"id":"blk-42057","kind":"paragraph","spans":[{"id":"spn-47905","text":"1. Inspect low-confidence node concentration. 2. Run consolidation. 3. Add missing high-quality nodes (semantic, procedural, temporal, outcome, or goal as appropriate). 4. Use coverage review to identify knowledge gaps. 5. Avoid forcing action when routing says "},{"id":"spn-47906","marks":["code"],"text":"learn"},{"id":"spn-47907","text":" or "},{"id":"spn-47908","marks":["code"],"text":"escalate"},{"id":"spn-47909","text":"."}]},{"id":"blk-42058","kind":"paragraph","spans":[{"id":"spn-47910","text":"---"}]},{"id":"blk-42059","kind":"heading","level":2,"spans":[{"id":"spn-47911","text":"10) Release & Change Management"}]},{"id":"blk-42060","kind":"paragraph","spans":[{"id":"spn-47912","text":"Before releases:"}]},{"id":"blk-42061","kind":"paragraph","spans":[{"id":"spn-47913","text":"1. Run format, compile, and tests. 2. Verify MCP tools/resources remain discoverable. 3. Validate key operational workflows:"}]},{"id":"blk-42062","items":[{"blocks":[{"id":"blk-42064","kind":"paragraph","spans":[{"id":"spn-47914","text":"retrieve -> store -> learn -> consolidate"}]}],"id":"blk-42063","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42065","kind":"paragraph","spans":[{"id":"spn-47915","text":"4. Confirm docs and CLI help text are in sync with behavior. 5. Ensure version parity across project metadata and distribution artifacts."}]},{"id":"blk-42066","kind":"paragraph","spans":[{"id":"spn-47916","text":"After releases:"}]},{"id":"blk-42067","items":[{"blocks":[{"id":"blk-42069","kind":"paragraph","spans":[{"id":"spn-47917","text":"Smoke test install/run path."}]}],"id":"blk-42068","kind":"list-item"},{"blocks":[{"id":"blk-42071","kind":"paragraph","spans":[{"id":"spn-47918","text":"Verify health/resource access from at least one MCP client."}]}],"id":"blk-42070","kind":"list-item"},{"blocks":[{"id":"blk-42073","kind":"paragraph","spans":[{"id":"spn-47919","text":"Confirm no regressions in goal operations and consolidation calls."}]}],"id":"blk-42072","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42074","kind":"paragraph","spans":[{"id":"spn-47920","text":"---"}]},{"id":"blk-42075","kind":"heading","level":2,"spans":[{"id":"spn-47921","text":"11) Security & Safety Practices"}]},{"id":"blk-42076","items":[{"blocks":[{"id":"blk-42078","kind":"paragraph","spans":[{"id":"spn-47922","text":"Never store secrets or credentials in graph content/metadata."}]}],"id":"blk-42077","kind":"list-item"},{"blocks":[{"id":"blk-42080","kind":"paragraph","spans":[{"id":"spn-47923","text":"Use least-privilege file permissions for DB directories."}]}],"id":"blk-42079","kind":"list-item"},{"blocks":[{"id":"blk-42082","kind":"paragraph","spans":[{"id":"spn-47924","text":"Keep logs free of sensitive user data where possible."}]}],"id":"blk-42081","kind":"list-item"},{"blocks":[{"id":"blk-42084","kind":"paragraph","spans":[{"id":"spn-47925","text":"Prefer explicit, auditable metadata over opaque free-text for critical actions."}]}],"id":"blk-42083","kind":"list-item"},{"blocks":[{"id":"blk-42086","kind":"paragraph","spans":[{"id":"spn-47926","text":"Treat externally sourced claims as lower confidence until verified."}]}],"id":"blk-42085","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42087","kind":"paragraph","spans":[{"id":"spn-47927","text":"---"}]},{"id":"blk-42088","kind":"heading","level":2,"spans":[{"id":"spn-47928","text":"12) Recommended SLO-Style Targets (Starter Set)"}]},{"id":"blk-42089","kind":"paragraph","spans":[{"id":"spn-47929","text":"These are practical baseline targets you can tune per environment:"}]},{"id":"blk-42090","items":[{"blocks":[{"id":"blk-42092","kind":"paragraph","spans":[{"id":"spn-47930","marks":["bold"],"text":"Runtime availability:"},{"id":"spn-47931","text":" core services up > 99%"}]}],"id":"blk-42091","kind":"list-item"},{"blocks":[{"id":"blk-42094","kind":"paragraph","spans":[{"id":"spn-47932","marks":["bold"],"text":"MCP request success rate:"},{"id":"spn-47933","text":" > 99% for standard calls"}]}],"id":"blk-42093","kind":"list-item"},{"blocks":[{"id":"blk-42096","kind":"paragraph","spans":[{"id":"spn-47934","marks":["bold"],"text":"Median retrieval latency:"}