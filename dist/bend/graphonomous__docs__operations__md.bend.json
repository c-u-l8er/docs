-42118","spans":[{"id":"spn-47956","text":"Add evidence nodes, review contradictions"}]}],[{"id":"blk-42119","spans":[{"id":"spn-47957","text":"Sudden memory loss feel"}]},{"id":"blk-42120","spans":[{"id":"spn-47958","text":"Aggressive decay/prune settings"}]},{"id":"blk-42121","spans":[{"id":"spn-47959","text":"Inspect consolidation config/status"}]}]]},{"id":"blk-42122","kind":"paragraph","spans":[{"id":"spn-47960","text":"---"}]},{"id":"blk-42123","kind":"heading","level":2,"spans":[{"id":"spn-47961","text":"14) End-of-Session Operator Procedure"}]},{"id":"blk-42124","kind":"paragraph","spans":[{"id":"spn-47962","text":"Before ending a productive session:"}]},{"id":"blk-42125","kind":"paragraph","spans":[{"id":"spn-47963","text":"1. Store key new knowledge discovered. 2. Report any pending outcomes. 3. Update goal progress/status. 4. Trigger consolidation and verify status. 5. Capture any unresolved risks in a goal note for next session continuity."}]},{"id":"blk-42126","kind":"paragraph","spans":[{"id":"spn-47964","text":"---"}]},{"id":"blk-42127","kind":"heading","level":2,"spans":[{"id":"spn-47965","text":"15) Related Documentation"}]},{"id":"blk-42128","items":[{"blocks":[{"id":"blk-42130","kind":"paragraph","spans":[{"id":"spn-47966","marks":["code"],"text":"index"},{"id":"spn-47967","text":" — docs entry point"}]}],"id":"blk-42129","kind":"list-item"},{"blocks":[{"id":"blk-42132","kind":"paragraph","spans":[{"id":"spn-47968","marks":["code"],"text":"architecture"},{"id":"spn-47969","text":" — system design and internals"}]}],"id":"blk-42131","kind":"list-item"},{"blocks":[{"id":"blk-42134","kind":"paragraph","spans":[{"id":"spn-47970","marks":["code"],"text":"quickstart"},{"id":"spn-47971","text":" — first-run path"}]}],"id":"blk-42133","kind":"list-item"},{"blocks":[{"id":"blk-42136","kind":"paragraph","spans":[{"id":"spn-47972","marks":["code"],"text":"mcp-tools"},{"id":"spn-47973","text":" — tool/resource interface reference"}]}],"id":"blk-42135","kind":