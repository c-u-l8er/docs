{"bendscript":"0.1","blocks":[{"id":"blk-41255","kind":"heading","level":1,"spans":[{"id":"spn-45922","text":"Operations & Maintenance"}]},{"id":"blk-41256","kind":"paragraph","spans":[{"id":"spn-45923","text":"This page is the operational runbook for running, validating, and maintaining "},{"id":"spn-45924","marks":["bold"],"text":"Graphonomous"},{"id":"spn-45925","text":" in development and production-like environments."}]},{"id":"blk-41257","kind":"paragraph","spans":[{"id":"spn-45926","text":"---"}]},{"id":"blk-41258","kind":"heading","level":2,"spans":[{"id":"spn-45927","text":"1) Operational Model"}]},{"id":"blk-41259","kind":"paragraph","spans":[{"id":"spn-45928","text":"Graphonomous runs as an Elixir/OTP application with supervised runtime services and an MCP server interface over stdio. Core operational concerns are:"}]},{"id":"blk-41260","items":[{"blocks":[{"id":"blk-41262","kind":"paragraph","spans":[{"id":"spn-45929","marks":["bold"],"text":"Process health"},{"id":"spn-45930","text":" (runtime services are up)"}]}],"id":"blk-41261","kind":"list-item"},{"blocks":[{"id":"blk-41264","kind":"paragraph","spans":[{"id":"spn-45931","marks":["bold"],"text":"Data durability"},{"id":"spn-45932","text":" (SQLite-backed state)"}]}],"id":"blk-41263","kind":"list-item"},{"blocks":[{"id":"blk-41266","kind":"paragraph","spans":[{"id":"spn-45933","marks":["bold"],"text":"Retrieval quality"},{"id":"spn-45934","text":" (memory remains relevant)"}]}],"id":"blk-41265","kind":"list-item"},{"blocks":[{"id":"blk-41268","kind":"paragraph","spans":[{"id":"spn-45935","marks":["bold"],"text":"Learning integrity"},{"id":"spn-45936","text":" (outcomes update confidence correctly)"}]}],"id":"blk-41267","kind":"list-item"},{"blocks":[{"id":"blk-41270","kind":"paragraph","spans":[{"id":"spn-45937","marks":["bold"],"text":"Memory hygiene"},{"id":"spn-45938","text":" (consolidation decay/pruning cycles)"}]}],"id":"blk-41269","kind":"list-item"},{"blocks":[{"id":"blk-41272","kind":"paragraph","spans":[{"id":"spn-45939","marks":["bold"],"text":"Transport stability"},{"id":"spn-45940","text":" (MCP client/server connectivity)"}]}],"id":"blk-41271","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41273","kind":"paragraph","spans":[{"id":"spn-45941","text":"---"}]},{"id":"blk-41274","kind":"heading","level":2,"spans":[{"id":"spn-45942","text":"2) Daily Operator Checklist"}]},{"id":"blk-41275","kind":"paragraph","spans":[{"id":"spn-45943","text":"Use this checklist for routine operation:"}]},{"id":"blk-41276","kind":"paragraph","spans":[{"id":"spn-45944","text":"1. Start Graphonomous with an explicit DB path. 2. Verify runtime health snapshot. 3. Verify goals snapshot (if goal-driven workflows are active). 4. Confirm retrieval works on a known query. 5. Confirm writes ("},{"id":"spn-45945","marks":["code"],"text":"store_node"},{"id":"spn-45946","text":") and updates ("},{"id":"spn-45947","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-45948","text":") succeed. 6. Run/inspect consolidation state. 7. Review logs for transport disconnects or repeated timeouts."}]},{"id":"blk-41277","kind":"paragraph","spans":[{"id":"spn-45949","text":"---"}]},{"id":"blk-41278","kind":"heading","level":2,"spans":[{"id":"spn-45950","text":"3) Startup Procedures"}]},{"id":"blk-41279","kind":"heading","level":2,"spans":[{"id":"spn-45951","text":"3.1 Local development startup"}]},{"id":"blk-41280","kind":"paragraph","spans":[{"id":"spn-45952","text":"Run Graphonomous with a dedicated local DB:"}]},{"id":"blk-41281","items":[{"blocks":[{"id":"blk-41283","kind":"paragraph","spans":[{"id":"spn-45953","text":"Ensure your DB directory exists."}]}],"id":"blk-41282","kind":"list-item"},{"blocks":[{"id":"blk-41285","kind":"paragraph","spans":[{"id":"spn-45954","text":"Start using fallback embedder when troubleshooting or on constrained devices."}]}],"id":"blk-41284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41286","kind":"paragraph","spans":[{"id":"spn-45955","text":"Recommended startup characteristics:"}]},{"id":"blk-41287","items":[{"blocks":[{"id":"blk-41289","kind":"paragraph","spans":[{"id":"spn-45956","text":"Explicit "},{"id":"spn-45957","marks":["code"],"text":"--db"},{"id":"spn-45958","text":" path"}]}],"id":"blk-41288","kind":"list-item"},{"blocks":[{"id":"blk-41291","kind":"paragraph","spans":[{"id":"spn-45959","text":"Stable log level ("},{"id":"spn-45960","marks":["code"],"text":"info"},{"id":"spn-45961","text":" or "},{"id":"spn-45962","marks":["code"],"text":"debug"},{"id":"spn-45963","text":")"}]}],"id":"blk-41290","kind":"list-item"},{"blocks":[{"id":"blk-41293","kind":"paragraph","spans":[{"id":"spn-45964","text":"Request timeout tuned for your client/editor"}]}],"id":"blk-41292","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41294","kind":"heading","level":2,"spans":[{"id":"spn-45965","text":"3.2 MCP client startup validation"}]},{"id":"blk-41295","kind":"paragraph","spans":[{"id":"spn-45966","text":"After startup, validate in this order:"}]},{"id":"blk-41296","kind":"paragraph","spans":[{"id":"spn-45967","text":"1. Tool discovery returns expected Graphonomous tools. 2. Resource reads succeed:"}]},{"id":"blk-41297","items":[{"blocks":[{"id":"blk-41299","kind":"paragraph","spans":[{"id":"spn-45968","marks":["code"],"text":"graphonomous://runtime/health"}]}],"id":"blk-41298","kind":"list-item"},{"blocks":[{"id":"blk-41301","kind":"paragraph","spans":[{"id":"spn-45969","marks":["code"],"text":"graphonomous://goals/snapshot"}]}],"id":"blk-41300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41302","kind":"paragraph","spans":[{"id":"spn-45970","text":"3. A test retrieval query returns "},{"id":"spn-45971","marks":["code"],"text":"status: ok"},{"id":"spn-45972","text":". 4. A test node write succeeds."}]},{"id":"blk-41303","kind":"paragraph","spans":[{"id":"spn-45973","text":"---"}]},{"id":"blk-41304","kind":"heading","level":2,"spans":[{"id":"spn-45974","text":"4) Health Monitoring"}]},{"id":"blk-41305","kind":"heading","level":2,"spans":[{"id":"spn-45975","text":"4.1 Runtime health resource"}]},{"id":"blk-41306","kind":"paragraph","spans":[{"id":"spn-45976","text":"Use "},{"id":"spn-45977","marks":["code"],"text":"graphonomous://runtime/health"},{"id":"spn-45978","text":" to verify:"}]},{"id":"blk-41307","items":[{"blocks":[{"id":"blk-41309","kind":"paragraph","spans":[{"id":"spn-45979","text":"Process-level service status ("},{"id":"spn-45980","marks":["code"],"text":"up"},{"id":"spn-45981","text":"/"},{"id":"spn-45982","marks":["code"],"text":"down"},{"id":"spn-45983","text":")"}]}],"id":"blk-41308","kind":"list-item"},{"blocks":[{"id":"blk-41311","kind":"paragraph","spans":[{"id":"spn-45984","text":"High-level object counts (nodes/goals)"}]}],"id":"blk-41310","kind":"list-item"},{"blocks":[{"id":"blk-41313","kind":"paragraph","spans":[{"id":"spn-45985","text":"Timestamp of snapshot generation"}]}],"id":"blk-41312","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41314","kind":"paragraph","spans":[{"id":"spn-45986","text":"If any core service is down, restart runtime and verify DB accessibility."}]},{"id":"blk-41315","kind":"heading","level":2,"spans":[{"id":"spn-45987","text":"4.2 Goal snapshot resource"}]},{"id":"blk-41316","kind":"paragraph","spans":[{"id":"spn-45988","text":"Use "},{"id":"spn-45989","marks":["code"],"text":"graphonomous://goals/snapshot"},{"id":"spn-45990","text":" to verify:"}]},{"id":"blk-41317","items":[{"blocks":[{"id":"blk-41319","kind":"paragraph","spans":[{"id":"spn-45991","text":"Total number of goals"}]}],"id":"blk-41318","kind":"list-item"},{"blocks":[{"id":"blk-41321","kind":"paragraph","spans":[{"id":"spn-45992","text":"Status distribution ("},{"id":"spn-45993","marks":["code"],"text":"proposed"},{"id":"spn-45994","text":", "},{"id":"spn-45995","marks":["code"],"text":"active"},{"id":"spn-45996","text":", "},{"id":"spn-45997","marks":["code"],"text":"blocked"},{"id":"spn-45998","text":", "},{"id":"spn-45999","marks":["code"],"text":"completed"},{"id":"spn-46000","text":", etc.)"}]}],"id":"blk-41320","kind":"list-item"},{"blocks":[{"id":"blk-41323","kind":"paragraph","spans":[{"id":"spn-46001","text":"Serialized goal records for debugging orchestration state"}]}],"id":"blk-41322","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41324","kind":"paragraph","spans":[{"id":"spn-46002","text":"---"}]},{"id":"blk-41325","kind":"heading","level":2,"spans":[{"id":"spn-46003","text":"5) Data & Storage Operations"}]},{"id":"blk-41326","kind":"heading","level":2,"spans":[{"id":"spn-46004","text":"5.1 Persistence strategy"}]},{"id":"blk-41327","kind":"paragraph","spans":[{"id":"spn-46005","text":"Graphonomous uses SQLite as durable storage and ETS as hot in-memory cache."}]},{"id":"blk-41328","kind":"paragraph","spans":[{"id":"spn-46006","text":"Operational implications:"}]},{"id":"blk-41329","items":[{"blocks":[{"id":"blk-41331","kind":"paragraph","spans":[{"id":"spn-46007","text":"SQLite file is the recovery source of truth."}]}],"id":"blk-41330","kind":"list-item"},{"blocks":[{"id":"blk-41333","kind":"paragraph","spans":[{"id":"spn-46008","text":"ETS is rebuilt/warmed from DB state."}]}],"id":"blk-41332","kind":"list-item"},{"blocks":[{"id":"blk-41335","kind":"paragraph","spans":[{"id":"spn-46009","text":"Always keep DB path explicit and stable per environment."}]}],"id":"blk-41334","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41336","kind":"heading","level":2,"spans":[{"id":"spn-46010","text":"5.2 Backup strategy"}]},{"id":"blk-41337","kind":"paragraph","spans":[{"id":"spn-46011","text":"Recommended backup practice:"}]},{"id":"blk-41338","items":[{"blocks":[{"id":"blk-41340","kind":"paragraph","spans":[{"id":"spn-46012","text":"Schedule periodic copies/snapshots of the SQLite DB file."}]}],"id":"blk-41339","kind":"list-item"},{"blocks":[{"id":"blk-41342","kind":"paragraph","spans":[{"id":"spn-46013","text":"Perform backups during low-write periods when possible."}]}],"id":"blk-41341","kind":"list-item"},{"blocks":[{"id":"blk-41344","kind":"paragraph","spans":[{"id":"spn-46014","text":"Keep at least:"}]}],"id":"blk-41343","kind":"list-item"},{"blocks":[{"id":"blk-41346","kind":"paragraph","spans":[{"id":"spn-46015","text":"daily rolling backups (7 days),"}]}],"id":"blk-41345","kind":"list-item"},{"blocks":[{"id":"blk-41348","kind":"paragraph","spans":[{"id":"spn-46016","text":"weekly backups (4 weeks),"}]}],"id":"blk-41347","kind":"list-item"},{"blocks":[{"id":"blk-41350","kind":"paragraph","spans":[{"id":"spn-46017","text":"monthly backups (3–6 months)."}]}],"id":"blk-41349","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41351","kind":"heading","level":2,"spans":[{"id":"spn-46018","text":"5.3 Recovery procedure"}]},{"id":"blk-41352","kind":"paragraph","spans":[{"id":"spn-46019","text":"If runtime state appears inconsistent:"}]},{"id":"blk-41353","kind":"paragraph","spans":[{"id":"spn-46020","text":"1. Stop Graphonomous. 2. Backup current DB file before changes. 3. Restart runtime and verify health. 4. Re-run retrieval sanity checks. 5. If needed, restore from known-good backup and replay required operational steps."}]},{"id":"blk-41354","kind":"paragraph","spans":[{"id":"spn-46021","text":"---"}]},{"id":"blk-41355","kind":"heading","level":2,"spans":[{"id":"spn-46022","text":"6) Learning Loop Operations"}]},{"id":"blk-41356","kind":"heading","level":2,"spans":[{"id":"spn-46023","text":"6.1 Required loop discipline"}]},{"id":"blk-41357","kind":"paragraph","spans":[{"id":"spn-46024","text":"For consequential actions:"}]},{"id":"blk-41358","kind":"paragraph","spans":[{"id":"spn-46025","text":"1. Retrieve context first. 2. Perform action. 3. Report outcome with real "},{"id":"spn-46026","marks":["code"],"text":"causal_node_ids"},{"id":"spn-46027","text":"."}]},{"id":"blk-41359","kind":"paragraph","spans":[{"id":"spn-46028","text":"This keeps confidence updates meaningful and avoids drift."}]},{"id":"blk-41360","kind":"heading","level":2,"spans":[{"id":"spn-46029","text":"6.2 Outcome status semantics"}]},{"id":"blk-41361","kind":"paragraph","spans":[{"id":"spn-46030","text":"Use outcome status correctly:"}]},{"id":"blk-41362","items":[{"blocks":[{"id":"blk-41364","kind":"paragraph","spans":[{"id":"spn-46031","marks":["code"],"text":"success"},{"id":"spn-46032","text":": action achieved intended result"}]}],"id":"blk-41363","kind":"list-item"},{"blocks":[{"id":"blk-41366","kind":"paragraph","spans":[{"id":"spn-46033","marks":["code"],"text":"partial_success"},{"id":"spn-46034","text":": mixed outcome"}]}],"id":"blk-41365","kind":"list-item"},{"blocks":[{"id":"blk-41368","kind":"paragraph","spans":[{"id":"spn-46035","marks":["code"],"text":"failure"},{"id":"spn-46036","text":": action failed"}]}],"id":"blk-41367","kind":"list-item"},{"blocks":[{"id":"blk-41370","kind":"paragraph","spans":[{"id":"spn-46037","marks":["code"],"text":"timeout"},{"id":"spn-46038","text":": no reliable completion signal"}]}],"id":"blk-41369","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41371","kind":"paragraph","spans":[{"id":"spn-46039","text":"Treating timeouts as failures can incorrectly penalize good knowledge."}]},{"id":"blk-41372","kind":"heading","level":2,"spans":[{"id":"spn-46040","text":"6.3 Confidence hygiene"}]},{"id":"blk-41373","kind":"paragraph","spans":[{"id":"spn-46041","text":"Operational rule:"}]},{"id":"blk-41374","items":[{"blocks":[{"id":"blk-41376","kind":"paragraph","spans":[{"id":"spn-46042","text":"Use evidence-calibrated confidence values."}]}],"id":"blk-41375","kind":"list-item"},{"blocks":[{"id":"blk-41378","kind":"paragraph","spans":[{"id":"spn-46043","text":"Avoid blanket high confidence in both stored nodes and outcomes."}]}],"id":"blk-41377","kind":"list-item"},{"blocks":[{"id":"blk-41380","kind":"paragraph","spans":[{"id":"spn-46044","text":"Favor structured evidence payloads for audits and debugging."}]}],"id":"blk-41379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41381","kind":"paragraph","spans":[{"id":"spn-46045","text":"---"}]},{"id":"blk-41382","kind":"heading","level":2,"spans":[{"id":"spn-46046","text":"7) Goal Operations"}]},{"id":"blk-41383","kind":"paragraph","spans":[{"id":"spn-46047","text":"For multi-step work, always use goals."}]},{"id":"blk-41384","kind":"heading","level":2,"spans":[{"id":"spn-46048","text":"7.1 Goal lifecycle flow"}]},{"id":"blk-41385","kind":"paragraph","spans":[{"id":"spn-46049","text":"Typical progression:"}]},{"id":"blk-41386","kind":"paragraph","spans":[{"id":"spn-46050","marks":["code"],"text":"proposed -> active -> completed"},{"id":"spn-46051","text":" or "},{"id":"spn-46052","marks":["code"],"text":"proposed/active -> blocked -> active"},{"id":"spn-46053","text":" (when unblocked)"}]},{"id":"blk-41387","kind":"heading","level":2,"spans":[{"id":"spn-46054","text":"7.2 Coverage review gate"}]},{"id":"blk-41388","kind":"paragraph","spans":[{"id":"spn-46055","text":"Before high-impact actions, run goal coverage review to route execution:"}]},{"id":"blk-41389","items":[{"blocks":[{"id":"blk-41391","kind":"paragraph","spans":[{"id":"spn-46056","marks":["code"],"text":"act"},{"id":"spn-46057","text":": proceed"}]}],"id":"blk-41390","kind":"list-item"},{"blocks":[{"id":"blk-41393","kind":"paragraph","spans":[{"id":"spn-46058","marks":["code"],"text":"learn"},{"id":"spn-46059","text":": gather additional context"}]}],"id":"blk-41392","kind":"list-item"},{"blocks":[{"id":"blk-41395","kind":"paragraph","spans":[{"id":"spn-46060","marks":["code"],"text":"escalate"},{"id":"spn-46061","text":": block/escalate to human or multi-agent process"}]}],"id":"blk-41394","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41396","kind":"heading","level":2,"spans":[{"id":"spn-46062","text":"7.3 Progress and evidence"}]},{"id":"blk-41397","items":[{"blocks":[{"id":"blk-41399","kind":"paragraph","spans":[{"id":"spn-46063","text":"Update progress incrementally (avoid “jump to 100%” without evidence)."}]}],"id":"blk-41398","kind":"list-item"},{"blocks":[{"id":"blk-41401","kind":"paragraph","spans":[{"id":"spn-46064","text":"Link supporting nodes to goals."}]}],"id":"blk-41400","kind":"list-item"},{"blocks":[{"id":"blk-41403","kind":"paragraph","spans":[{"id":"spn-46065","text":"Keep transition metadata descriptive for auditability."}]}],"id":"blk-41402","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41404","kind":"paragraph","spans":[{"id":"spn-46066","text":"---"}]},{"id":"blk-41405","kind":"heading","level":2,"spans":[{"id":"spn-46067","text":"8) Consolidation Operations"}]},{"id":"blk-41406","kind":"paragraph","spans":[{"id":"spn-46068","text":"Consolidation maintains memory quality over time."}]},{"id":"blk-41407","kind":"heading","level":2,"spans":[{"id":"spn-46069","text":"8.1 When to run"}]},{"id":"blk-41408","items":[{"blocks":[{"id":"blk-41410","kind":"paragraph","spans":[{"id":"spn-46070","text":"End of productive sessions"}]}],"id":"blk-41409","kind":"list-item"},{"blocks":[{"id":"blk-41412","kind":"paragraph","spans":[{"id":"spn-46071","text":"Periodically during long autonomous runs"}]}],"id":"blk-41411","kind":"list-item"},{"blocks":[{"id":"blk-41414","kind":"paragraph","spans":[{"id":"spn-46072","text":"After heavy write/ingestion bursts"}]}],"id":"blk-41413","kind":"list-item"},{"blocks":[{"id":"blk-41416","kind":"paragraph","spans":[{"id":"spn-46073","text":"Before critical retrieval/review checkpoints"}]}],"id":"blk-41415","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41417","kind":"heading","level":2,"spans":[{"id":"spn-46074","text":"8.2 What to watch"}]},{"id":"blk-41418","kind":"paragraph","spans":[{"id":"spn-46075","text":"From consolidation status/runtime info monitor:"}]},{"id":"blk-41419","items":[{"blocks":[{"id":"blk-41421","kind":"paragraph","spans":[{"id":"spn-46076","text":"cycle count"}]}],"id":"blk-41420","kind":"list-item"},{"blocks":[{"id":"blk-41423","kind":"paragraph","spans":[{"id":"spn-46077","text":"last run timestamp"}]}],"id":"blk-41422","kind":"list-item"},{"blocks":[{"id":"blk-41425","kind":"paragraph","spans":[{"id":"spn-46078","text":"decay/prune behavior"}]}],"id":"blk-41424","kind":"list-item"},{"blocks":[{"id":"blk-41427","kind":"paragraph","spans":[{"id":"spn-46079","text":"signs of overly aggressive pruning"}]}],"id":"blk-41426","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41428","kind":"paragraph","spans":[{"id":"spn-46080","text":"If retrieval quality drops sharply, inspect consolidation settings and confidence distributions."}]},{"id":"blk-41429","kind":"paragraph","spans":[{"id":"spn-46081","text":"---"}]},{"id":"blk-41430","kind":"heading","level":2,"spans":[{"id":"spn-46082","text":"9) Incident Response Runbooks"}]},{"id":"blk-41431","kind":"heading","level":2,"spans":[{"id":"spn-46083","text":"9.1 MCP server transport instability"}]},{"id":"blk-41432","kind":"paragraph","spans":[{"id":"spn-46084","text":"Symptoms:"}]},{"id":"blk-41433","items":[{"blocks":[{"id":"blk-41435","kind":"paragraph","spans":[{"id":"spn-46085","text":"client timeouts"}]}],"id":"blk-41434","kind":"list-item"},{"blocks":[{"id":"blk-41437","kind":"paragraph","spans":[{"id":"spn-46086","text":"server shutdown messages"}]}],"id":"blk-41436","kind":"list-item"},{"blocks":[{"id":"blk-41439","kind":"paragraph","spans":[{"id":"spn-46087","text":"intermittent success/failure across calls"}]}],"id":"blk-41438","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41440","kind":"paragraph","spans":[{"id":"spn-46088","text":"Response:"}]},{"id":"blk-41441","kind":"paragraph","spans":[{"id":"spn-46089","text":"1. Confirm runtime process is alive. 2. Validate health resource. 3. Restart MCP runtime cleanly. 4. Re-run minimal smoke flow (list tools -> read resources -> retrieve -> store). 5. Inspect logs for transport and timeout patterns. 6. Increase request timeout if workload is heavy."}]},{"id":"blk-41442","kind":"heading","level":2,"spans":[{"id":"spn-46090","text":"9.2 Write-path failures"}]},{"id":"blk-41443","kind":"paragraph","spans":[{"id":"spn-46091","text":"Symptoms:"}]},{"id":"blk-41444","items":[{"blocks":[{"id":"blk-41446","kind":"paragraph","spans":[{"id":"spn-46092","text":"retrieval works but node/goal writes fail"}]}],"id":"blk-41445","kind":"list-item"},{"blocks":[{"id":"blk-41448","kind":"paragraph","spans":[{"id":"spn-46093","text":"partial success in batches"}]}],"id":"blk-41447","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41449","kind":"paragraph","spans":[{"id":"spn-46094","text":"Response:"}]},{"id":"blk-41450","kind":"paragraph","spans":[{"id":"spn-46095","text":"1. Verify DB path and file permissions. 2. Check available disk space. 3. Restart runtime. 4. Retry writes idempotently. 5. Confirm data via query/list calls after retry."}]},{"id":"blk-41451","kind":"heading","level":2,"spans":[{"id":"spn-46096","text":"9.3 Retrieval degradation"}]},{"id":"blk-41452","kind":"paragraph","spans":[{"id":"spn-46097","text":"Symptoms:"}]},{"id":"blk-41453","items":[{"blocks":[{"id":"blk-41455","kind":"paragraph","spans":[{"id":"spn-46098","text":"poor relevance"}]}],"id":"blk-41454","kind":"list-item"},{"blocks":[{"id":"blk-41457","kind":"paragraph","spans":[{"id":"spn-46099","text":"stale/conflicting recall"}]}],"id":"blk-41456","kind":"list-item"},{"blocks":[{"id":"blk-41459","kind":"paragraph","spans":[{"id":"spn-46100","text":"weak support around active goals"}]}],"id":"blk-41458","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41460","kind":"paragraph","spans":[{"id":"spn-46101","text":"Response:"}]},{"id":"blk-41461","kind":"paragraph","spans":[{"id":"spn-46102","text":"1. Inspect low-confidence node concentration. 2. Run consolidation. 3. Add missing high-quality nodes (semantic, procedural, temporal, outcome, or goal as appropriate). 4. Use coverage review to identify knowledge gaps. 5. Avoid forcing action when routing says "},{"id":"spn-46103","marks":["code"],"text":"learn"},{"id":"spn-46104","text":" or "},{"id":"spn-46105","marks":["code"],"text":"escalate"},{"id":"spn-46106","text":"."}]},{"id":"blk-41462","kind":"paragraph","spans":[{"id":"spn-46107","text":"---"}]},{"id":"blk-41463","kind":"heading","level":2,"spans":[{"id":"spn-46108","text":"10) Release & Change Management"}]},{"id":"blk-41464","kind":"paragraph","spans":[{"id":"spn-46109","text":"Before releases:"}]},{"id":"blk-41465","kind":"paragraph","spans":[{"id":"spn-46110","text":"1. Run format, compile, and tests. 2. Verify MCP tools/resources remain discoverable. 3. Validate key operational workflows:"}]},{"id":"blk-41466","items":[{"blocks":[{"id":"blk-41468","kind":"paragraph","spans":[{"id":"spn-46111","text":"retrieve -> store -> learn -> consolidate"}]}],"id":"blk-41467","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41469","kind":"paragraph","spans":[{"id":"spn-46112","text":"4. Confirm docs and CLI help text are in sync with behavior. 5. Ensure version parity across project metadata and distribution artifacts."}]},{"id":"blk-41470","kind":"paragraph","spans":[{"id":"spn-46113","text":"After releases:"}]},{"id":"blk-41471","items":[{"blocks":[{"id":"blk-41473","kind":"paragraph","spans":[{"id":"spn-46114","text":"Smoke test install/run path."}]}],"id":"blk-41472","kind":"list-item"},{"blocks":[{"id":"blk-41475","kind":"paragraph","spans":[{"id":"spn-46115","text":"Verify health/resource access from at least one MCP client."}]}],"id":"blk-41474","kind":"list-item"},{"blocks":[{"id":"blk-41477","kind":"paragraph","spans":[{"id":"spn-46116","text":"Confirm no regressions in goal operations and consolidation calls."}]}],"id":"blk-41476","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41478","kind":"paragraph","spans":[{"id":"spn-46117","text":"---"}]},{"id":"blk-41479","kind":"heading","level":2,"spans":[{"id":"spn-46118","text":"11) Security & Safety Practices"}]},{"id":"blk-41480","items":[{"blocks":[{"id":"blk-41482","kind":"paragraph","spans":[{"id":"spn-46119","text":"Never store secrets or credentials in graph content/metadata."}]}],"id":"blk-41481","kind":"list-item"},{"blocks":[{"id":"blk-41484","kind":"paragraph","spans":[{"id":"spn-46120","text":"Use least-privilege file permissions for DB directories."}]}],"id":"blk-41483","kind":"list-item"},{"blocks":[{"id":"blk-41486","kind":"paragraph","spans":[{"id":"spn-46121","text":"Keep logs free of sensitive user data where possible."}]}],"id":"blk-41485","kind":"list-item"},{"blocks":[{"id":"blk-41488","kind":"paragraph","spans":[{"id":"spn-46122","text":"Prefer explicit, auditable metadata over opaque free-text for critical actions."}]}],"id":"blk-41487","kind":"list-item"},{"blocks":[{"id":"blk-41490","kind":"paragraph","spans":[{"id":"spn-46123","text":"Treat externally sourced claims as lower confidence until verified."}]}],"id":"blk-41489","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41491","kind":"paragraph","spans":[{"id":"spn-46124","text":"---"}]},{"id":"blk-41492","kind":"heading","level":2,"spans":[{"id":"spn-46125","text":"12) Recommended SLO-Style Targets (Starter Set)"}]},{"id":"blk-41493","kind":"paragraph","spans":[{"id":"spn-46126","text":"These are practical baseline targets you can tune per environment:"}]},{"id":"blk-41494","items":[{"blocks":[{"id":"blk-41496","kind":"paragraph","spans":[{"id":"spn-46127","marks":["bold"],"text":"Runtime availability:"},{"id":"spn-46128","text":" core services up > 99%"}]}],"id":"blk-41495","kind":"list-item"},{"blocks":[{"id":"blk-41498","kind":"paragraph","spans":[{"id":"spn-46129","marks":["bold"],"text":"MCP request success rate:"},{"id":"spn-46130","text":" > 99% for standard calls"}]}],"id":"blk-41497","kind":"list-item"},{"blocks":[{"id":"blk-41500","kind":"paragraph","spans":[{"id":"spn-46131","marks":["bold"],"text":"Median retrieval latency:"}