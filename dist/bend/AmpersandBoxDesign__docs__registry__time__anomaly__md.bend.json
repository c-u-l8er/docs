{"bendscript":"0.1","blocks":[{"id":"blk-12497","kind":"heading","level":1,"spans":[{"id":"spn-11501","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11502","text":" — Anomaly Detection as a Capability"}]},{"id":"blk-12498","kind":"paragraph","spans":[{"id":"spn-11503","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11504","text":" is a capability page for the [&] Protocol's temporal anomaly detection subtype."}]},{"id":"blk-12499","kind":"paragraph","spans":[{"id":"spn-11505","text":"It describes a composable interface for agents that need to detect unusual behavior in streaming or historical temporal signals. The goal is not to standardize one anomaly detection algorithm. The goal is to standardize how an agent declares, validates, and composes anomaly detection ability as part of its cognitive architecture."}]},{"id":"blk-12500","kind":"paragraph","spans":[{"id":"spn-11506","text":"In protocol terms:"}]},{"id":"blk-12501","items":[{"blocks":[{"id":"blk-12503","kind":"paragraph","spans":[{"id":"spn-11507","text":"primitive: "},{"id":"spn-11508","marks":["code"],"text":"&time"}]}],"id":"blk-12502","kind":"list-item"},{"blocks":[{"id":"blk-12505","kind":"paragraph","spans":[{"id":"spn-11509","text":"subtype: "},{"id":"spn-11510","marks":["code"],"text":"anomaly"}]}],"id":"blk-12504","kind":"list-item"},{"blocks":[{"id":"blk-12507","kind":"paragraph","spans":[{"id":"spn-11511","text":"full capability id: "},{"id":"spn-11512","marks":["code"],"text":"&time.anomaly"}]}],"id":"blk-12506","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12508","kind":"paragraph","spans":[{"id":"spn-11513","text":"---"}]},{"id":"blk-12509","kind":"heading","level":2,"spans":[{"id":"spn-11514","text":"1. Definition"}]},{"id":"blk-12510","kind":"paragraph","spans":[{"id":"spn-11515","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11516","text":" is the protocol capability for "},{"id":"spn-11517","marks":["bold"],"text":"temporal anomaly detection"},{"id":"spn-11518","text":"."}]},{"id":"blk-12511","kind":"paragraph","spans":[{"id":"spn-11519","text":"It answers questions like:"}]},{"id":"blk-12512","items":[{"blocks":[{"id":"blk-12514","kind":"paragraph","spans":[{"id":"spn-11520","text":"Is something unusual happening right now?"}]}],"id":"blk-12513","kind":"list-item"},{"blocks":[{"id":"blk-12516","kind":"paragraph","spans":[{"id":"spn-11521","text":"Did a metric spike, drop, or drift outside expected behavior?"}]}],"id":"blk-12515","kind":"list-item"},{"blocks":[{"id":"blk-12518","kind":"paragraph","spans":[{"id":"spn-11522","text":"Which signals are deviating from their historical norms?"}]}],"id":"blk-12517","kind":"list-item"},{"blocks":[{"id":"blk-12520","kind":"paragraph","spans":[{"id":"spn-11523","text":"When did this anomalous behavior begin, and is it still active?"}]}],"id":"blk-12519","kind":"list-item"},{"blocks":[{"id":"blk-12522","kind":"paragraph","spans":[{"id":"spn-11524","text":"How severe is this deviation relative to the system's baseline?"}]}],"id":"blk-12521","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12523","kind":"paragraph","spans":[{"id":"spn-11525","text":"A provider that satisfies "},{"id":"spn-11526","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11527","text":" should expose operations that turn temporal data into anomaly-oriented artifacts that downstream capabilities can consume."}]},{"id":"blk-12524","kind":"paragraph","spans":[{"id":"spn-11528","text":"This is distinct from:"}]},{"id":"blk-12525","items":[{"blocks":[{"id":"blk-12527","kind":"paragraph","spans":[{"id":"spn-11529","marks":["code"],"text":"&time.forecast"},{"id":"spn-11530","text":" — predicting likely future values"}]}],"id":"blk-12526","kind":"list-item"},{"blocks":[{"id":"blk-12529","kind":"paragraph","spans":[{"id":"spn-11531","marks":["code"],"text":"&time.pattern"},{"id":"spn-11532","text":" — identifying recurring or structural behavior over time"}]}],"id":"blk-12528","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12530","kind":"paragraph","spans":[{"id":"spn-11533","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11534","text":" is about "},{"id":"spn-11535","marks":["bold"],"text":"detecting deviations from expected present or past behavior"},{"id":"spn-11536","text":"."}]},{"id":"blk-12531","kind":"paragraph","spans":[{"id":"spn-11537","text":"---"}]},{"id":"blk-12532","kind":"heading","level":2,"spans":[{"id":"spn-11538","text":"2. Why this capability matters"}]},{"id":"blk-12533","kind":"paragraph","spans":[{"id":"spn-11539","text":"A large class of useful agents need more than prediction and pattern recognition over temporal signals."}]},{"id":"blk-12534","kind":"paragraph","spans":[{"id":"spn-11540","text":"They need to detect:"}]},{"id":"blk-12535","items":[{"blocks":[{"id":"blk-12537","kind":"paragraph","spans":[{"id":"spn-11541","text":"infrastructure metric spikes"}]}],"id":"blk-12536","kind":"list-item"},{"blocks":[{"id":"blk-12539","kind":"paragraph","spans":[{"id":"spn-11542","text":"sudden drops in throughput or availability"}]}],"id":"blk-12538","kind":"list-item"},{"blocks":[{"id":"blk-12541","kind":"paragraph","spans":[{"id":"spn-11543","text":"unusual error rate behavior"}]}],"id":"blk-12540","kind":"list-item"},{"blocks":[{"id":"blk-12543","kind":"paragraph","spans":[{"id":"spn-11544","text":"support volume surges"}]}],"id":"blk-12542","kind":"list-item"},{"blocks":[{"id":"blk-12545","kind":"paragraph","spans":[{"id":"spn-11545","text":"regional demand anomalies"}]}],"id":"blk-12544","kind":"list-item"},{"blocks":[{"id":"blk-12547","kind":"paragraph","spans":[{"id":"spn-11546","text":"fleet telemetry deviations"}]}],"id":"blk-12546","kind":"list-item"},{"blocks":[{"id":"blk-12549","kind":"paragraph","spans":[{"id":"spn-11547","text":"latency drift"}]}],"id":"blk-12548","kind":"list-item"},{"blocks":[{"id":"blk-12551","kind":"paragraph","spans":[{"id":"spn-11548","text":"capacity threshold breaches"}]}],"id":"blk-12550","kind":"list-item"},{"blocks":[{"id":"blk-12553","kind":"paragraph","spans":[{"id":"spn-11549","text":"unexpected changes in operational cadence"}]}],"id":"blk-12552","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12554","kind":"paragraph","spans":[{"id":"spn-11550","text":"Without an explicit anomaly detection capability, systems often hide detection logic inside:"}]},{"id":"blk-12555","items":[{"blocks":[{"id":"blk-12557","kind":"paragraph","spans":[{"id":"spn-11551","text":"custom monitoring code"}]}],"id":"blk-12556","kind":"list-item"},{"blocks":[{"id":"blk-12559","kind":"paragraph","spans":[{"id":"spn-11552","text":"static threshold alerts"}]}],"id":"blk-12558","kind":"list-item"},{"blocks":[{"id":"blk-12561","kind":"paragraph","spans":[{"id":"spn-11553","text":"vendor-specific observability platforms"}]}],"id":"blk-12560","kind":"list-item"},{"blocks":[{"id":"blk-12563","kind":"paragraph","spans":[{"id":"spn-11554","text":"ad hoc rule engines"}]}],"id":"blk-12562","kind":"list-item"},{"blocks":[{"id":"blk-12565","kind":"paragraph","spans":[{"id":"spn-11555","text":"application-layer heuristics"}]}],"id":"blk-12564","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12566","kind":"paragraph","spans":[{"id":"spn-11556","text":"That makes architectures hard to compare, validate, and reuse."}]},{"id":"blk-12567","kind":"paragraph","spans":[{"id":"spn-11557","text":"By treating anomaly detection as a protocol capability, the [&] Protocol makes it possible to:"}]},{"id":"blk-12568","items":[{"blocks":[{"id":"blk-12570","kind":"paragraph","spans":[{"id":"spn-11558","text":"declare anomaly detection explicitly"}]}],"id":"blk-12569","kind":"list-item"},{"blocks":[{"id":"blk-12572","kind":"paragraph","spans":[{"id":"spn-11559","text":"bind it to a provider"}]}],"id":"blk-12571","kind":"list-item"},{"blocks":[{"id":"blk-12574","kind":"paragraph","spans":[{"id":"spn-11560","text":"validate pipelines that depend on anomaly output"}]}],"id":"blk-12573","kind":"list-item"},{"blocks":[{"id":"blk-12576","kind":"paragraph","spans":[{"id":"spn-11561","text":"preserve provenance for anomaly-driven decisions"}]}],"id":"blk-12575","kind":"list-item"},{"blocks":[{"id":"blk-12578","kind":"paragraph","spans":[{"id":"spn-11562","text":"generate downstream MCP and A2A artifacts from the same declaration"}]}],"id":"blk-12577","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12579","kind":"paragraph","spans":[{"id":"spn-11563","text":"---"}]},{"id":"blk-12580","kind":"heading","level":2,"spans":[{"id":"spn-11564","text":"3. Capability role in the four-primitive model"}]},{"id":"blk-12581","kind":"paragraph","spans":[{"id":"spn-11565","text":"The [&] Protocol organizes cognition around four top-level domains:"}]},{"id":"blk-12582","items":[{"blocks":[{"id":"blk-12584","kind":"paragraph","spans":[{"id":"spn-11566","marks":["code"],"text":"&memory"},{"id":"spn-11567","text":" — what the agent knows"}]}],"id":"blk-12583","kind":"list-item"},{"blocks":[{"id":"blk-12586","kind":"paragraph","spans":[{"id":"spn-11568","marks":["code"],"text":"&reason"},{"id":"spn-11569","text":" — how the agent decides"}]}],"id":"blk-12585","kind":"list-item"},{"blocks":[{"id":"blk-12588","kind":"paragraph","spans":[{"id":"spn-11570","marks":["code"],"text":"&time"},{"id":"spn-11571","text":" — when things happen"}]}],"id":"blk-12587","kind":"list-item"},{"blocks":[{"id":"blk-12590","kind":"paragraph","spans":[{"id":"spn-11572","marks":["code"],"text":"&space"},{"id":"spn-11573","text":" — where things are"}]}],"id":"blk-12589","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12591","kind":"paragraph","spans":[{"id":"spn-11574","text":"Within that model, "},{"id":"spn-11575","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11576","text":" provides the agent's ability to surface unexpected deviations in temporal context."}]},{"id":"blk-12592","kind":"paragraph","spans":[{"id":"spn-11577","text":"It often works best when composed with:"}]},{"id":"blk-12593","items":[{"blocks":[{"id":"blk-12595","kind":"paragraph","spans":[{"id":"spn-11578","marks":["code"],"text":"&memory.*"},{"id":"spn-11579","text":" for historical baselines and incident context"}]}],"id":"blk-12594","kind":"list-item"},{"blocks":[{"id":"blk-12597","kind":"paragraph","spans":[{"id":"spn-11580","marks":["code"],"text":"&space.*"},{"id":"spn-11581","text":" for region- or fleet-aware anomaly scoping"}]}],"id":"blk-12596","kind":"list-item"},{"blocks":[{"id":"blk-12599","kind":"paragraph","spans":[{"id":"spn-11582","marks":["code"],"text":"&reason.*"},{"id":"spn-11583","text":" for turning detected anomalies into decisions or escalations"}]}],"id":"blk-12598","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12600","kind":"paragraph","spans":[{"id":"spn-11584","text":"A useful shorthand is:"}]},{"blocks":[{"id":"blk-12602","kind":"paragraph","spans":[{"id":"spn-11585","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11586","text":" tells the agent that something unexpected is happening and provides structured context about the deviation."}]}],"id":"blk-12601","kind":"quote"},{"id":"blk-12603","kind":"paragraph","spans":[{"id":"spn-11587","text":"---"}]},{"id":"blk-12604","kind":"heading","level":2,"spans":[{"id":"spn-11588","text":"4. Typical use cases"}]},{"id":"blk-12605","kind":"heading","level":3,"spans":[{"id":"spn-11589","text":"Infrastructure incident detection"}]},{"id":"blk-12606","kind":"paragraph","spans":[{"id":"spn-11590","text":"Surface anomalous CPU, memory, latency, or error rate behavior before static thresholds fire."}]},{"id":"blk-12607","kind":"heading","level":3,"spans":[{"id":"spn-11591","text":"Support volume spike detection"}]},{"id":"blk-12608","kind":"paragraph","spans":[{"id":"spn-11592","text":"Detect unexpected surges in inbound support requests or ticket creation rates."}]},{"id":"blk-12609","kind":"heading","level":3,"spans":[{"id":"spn-11593","text":"Regional demand anomaly"}]},{"id":"blk-12610","kind":"paragraph","spans":[{"id":"spn-11594","text":"Identify unusual demand patterns in specific geographic regions or market segments."}]},{"id":"blk-12611","kind":"heading","level":3,"spans":[{"id":"spn-11595","text":"Fleet telemetry anomaly"}]},{"id":"blk-12612","kind":"paragraph","spans":[{"id":"spn-11596","text":"Detect deviations in vehicle, device, or node telemetry across a managed fleet."}]},{"id":"blk-12613","kind":"heading","level":3,"spans":[{"id":"spn-11597","text":"Operational drift detection"}]},{"id":"blk-12614","kind":"paragraph","spans":[{"id":"spn-11598","text":"Surface gradual shifts in throughput, response time, or error distribution that indicate systemic change."}]},{"id":"blk-12615","kind":"heading","level":3,"spans":[{"id":"spn-11599","text":"Incident correlation"}]},{"id":"blk-12616","kind":"paragraph","spans":[{"id":"spn-11600","text":"Provide anomaly context that downstream reasoning capabilities can use to correlate related events across signals."}]},{"id":"blk-12617","kind":"paragraph","spans":[{"id":"spn-11601","text":"---"}]},{"id":"blk-12618","kind":"heading","level":2,"spans":[{"id":"spn-11602","text":"5. Example declaration"}]},{"id":"blk-12619","kind":"paragraph","spans":[{"id":"spn-11603","text":"A basic "},{"id":"spn-11604","marks":["code"],"text":"ampersand.json"},{"id":"spn-11605","text":" fragment using "},{"id":"spn-11606","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11607","text":":"}]},{"id":"blk-12620","kind":"code","language":"json","text":"{\n  \"&time.anomaly\": {\n    \"provider\": \"ticktickclock\",\n    \"config\": {\n      \"streams\": [\"cpu\", \"mem\"],\n      \"sensitivity\": \"medium\",\n      \"window_minutes\": 15\n    }\n  }\n}"},{"id":"blk-12621","kind":"paragraph","spans":[{"id":"spn-11608","text":"A goal-driven version using auto resolution:"}]},{"id":"blk-12622","kind":"code","language":"json","text":"{\n  \"&time.anomaly\": {\n    \"provider\": \"auto\",\n    \"need\": \"detect unusual latency or error rate behavior in production infrastructure\"\n  }\n}"},{"id":"blk-12623","kind":"paragraph","spans":[{"id":"spn-11609","text":"---"}]},{"id":"blk-12624","kind":"heading","level":2,"spans":[{"id":"spn-11610","text":"6. Compatible providers"}]},{"id":"blk-12625","kind":"paragraph","spans":[{"id":"spn-11611","text":"The protocol is provider-agnostic. The capability is the contract; providers are implementations."}]},{"id":"blk-12626","kind":"paragraph","spans":[{"id":"spn-11612","text":"Representative providers for "},{"id":"spn-11613","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11614","text":" may include:"}]},{"id":"blk-12627","items":[{"blocks":[{"id":"blk-12629","kind":"paragraph","spans":[{"id":"spn-11615","marks":["code"],"text":"ticktickclock"}]}],"id":"blk-12628","kind":"list-item"},{"blocks":[{"id":"blk-12631","kind":"paragraph","spans":[{"id":"spn-11616","text":"statistical anomaly detection services"}]}],"id":"blk-12630","kind":"list-item"},{"blocks":[{"id":"blk-12633","kind":"paragraph","spans":[{"id":"spn-11617","text":"custom detection engines"}]}],"id":"blk-12632","kind":"list-item"},{"blocks":[{"id":"blk-12635","kind":"paragraph","spans":[{"id":"spn-11618","text":"time-series platforms with anomaly detection APIs"}]}],"id":"blk-12634","kind":"list-item"},{"blocks":[{"id":"blk-12637","kind":"paragraph","spans":[{"id":"spn-11619","text":"domain-specific monitoring and observability services"}]}],"id":"blk-12636","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12638","kind":"paragraph","spans":[{"id":"spn-11620","text":"A provider should be considered compatible when it can satisfy the capability contract, not merely because it performs some anomaly-adjacent function in marketing language."}]},{"id":"blk-12639","kind":"paragraph","spans":[{"id":"spn-11621","text":"---"}]},{"id":"blk-12640","kind":"heading","level":2,"spans":[{"id":"spn-11622","text":"7. Example capability contract"}]},{"id":"blk-12641","kind":"paragraph","spans":[{"id":"spn-11623","text":"A representative contract artifact for "},{"id":"spn-11624","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11625","text":":"}]},{"id":"blk-12642","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&time.anomaly\",\n  \"provider\": \"ticktickclock\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Temporal anomaly detection contract for surfacing unusual behavior in streaming or historical signals and enriching downstream decision context.\",\n  \"operations\": {\n    \"detect\": {\n      \"in\": \"stream_data\",\n      \"out\": \"anomaly_set\",\n      \"description\": \"Detect anomalous events, spikes, drops, or drift from temporal input signals.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"enrich\": {\n      \"in\": \"context\",\n      \"out\": \"enriched_context\",\n      \"description\": \"Attach anomaly-derived temporal context to an existing payload for downstream reasoning or routing.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"learn\": {\n      \"in\": \"observation\",\n      \"out\": \"ack\",\n      \"description\": \"Incorporate confirmed outcomes or operator feedback to improve later anomaly detection behavior.\",\n      \"deterministic\": false,\n      \"side_effects\": true\n    }\n  },\n  \"accepts_from\": [\n    \"&memory.*\",\n    \"&space.*\",\n    \"raw_data\",\n    \"stream_data\",\n    \"context\",\n    \"observation\"\n  ],\n  \"feeds_into\": [\n    \"&memory.*\",\n    \"&reason.*\",\n    \"&space.*\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"temporal-anomaly-detection\"\n  ]\n}"},{"id":"blk-12643","kind":"paragraph","spans":[{"id":"spn-11626","text":"This contract matters because it makes anomaly detection composable in a typed system."}]},{"id":"blk-12644","kind":"paragraph","spans":[{"id":"spn-11627","text":"---"}]},{"id":"blk-12645","kind":"heading","level":2,"spans":[{"id":"spn-11628","text":"8. Example provider configuration patterns"}]},{"id":"blk-12646","kind":"paragraph","spans":[{"id":"spn-11629","text":"The protocol does not hardcode one configuration shape, but these fields are common and useful."}]},{"id":"blk-12647","kind":"heading","level":3,"spans":[{"id":"spn-11630","text":"Streams"}]},{"id":"blk-12648","kind":"paragraph","spans":[{"id":"spn-11631","text":"Which signals to monitor for anomalies."}]},{"id":"blk-12649","kind":"code","language":"json","text":"{\n  \"streams\": [\"cpu\", \"mem\", \"latency\", \"error_rate\", \"throughput\"]\n}"},{"id":"blk-12650","kind":"heading","level":3,"spans":[{"id":"spn-11632","text":"Sensitivity"}]},{"id":"blk-12651","kind":"paragraph","spans":[{"id":"spn-11633","text":"How aggressively to flag deviations."}]},{"id":"blk-12652","kind":"code","language":"json","text":"{\n  \"sensitivity\": \"medium\"\n}"},{"id":"blk-12653","kind":"heading","level":3,"spans":[{"id":"spn-11634","text":"Window"}]},{"id":"blk-12654","kind":"paragraph","spans":[{"id":"spn-11635","text":"How much recent history to consider when determining baseline behavior."}]},{"id":"blk-12655","kind":"code","language":"json","text":"{\n  \"window_minutes\": 15\n}"},{"id":"blk-12656","kind":"heading","level":3,"spans":[{"id":"spn-11636","text":"Confidence threshold"}]},{"id":"blk-12657","kind":"paragraph","spans":[{"id":"spn-11637","text":"Useful when anomaly output should trigger escalation or downstream filtering."}]},{"id":"blk-12658","kind":"code","language":"json","text":"{\n  \"min_confidence\": 0.7\n}"},{"id":"blk-12659","kind":"heading","level":3,"spans":[{"id":"spn-11638","text":"Region or segment scope"}]},{"id":"blk-12660","kind":"paragraph","spans":[{"id":"spn-11639","text":"Useful for spatially-aware anomaly detection."}]},{"id":"blk-12661","kind":"code","language":"json","text":"{\n  \"regions\": [\"us-east\", \"eu-west\"]\n}"},{"id":"blk-12662","kind":"paragraph","spans":[{"id":"spn-11640","text":"These are implementation patterns, not mandatory protocol fields."}]},{"id":"blk-12663","kind":"paragraph","spans":[{"id":"spn-11641","text":"---"}]},{"id":"blk-12664","kind":"heading","level":2,"spans":[{"id":"spn-11642","text":"9. Architecture patterns"}]},{"id":"blk-12665","kind":"heading","level":3,"spans":[{"id":"spn-11643","text":"Pattern A: detect -> reason"}]},{"id":"blk-12666","kind":"paragraph","spans":[{"id":"spn-11644","text":"Use a detected anomaly directly as decision input."}]},{"id":"blk-12667","kind":"code","language":"text","text":"stream_data\n|> &time.anomaly.detect()\n|> &reason.argument.evaluate()"},{"id":"blk-12668","kind":"paragraph","spans":[{"id":"spn-11645","text":"Use when an anomaly can directly support a decision, escalation, or incident response action."}]},{"id":"blk-12669","kind":"heading","level":3,"spans":[{"id":"spn-11646","text":"Pattern B: detect -> enrich -> reason"}]},{"id":"blk-12670","kind":"paragraph","spans":[{"id":"spn-11647","text":"Attach anomaly context to graph memory before deciding."}]},{"id":"blk-12671","kind":"code","language":"text","text":"stream_data\n|> &time.anomaly.detect()\n|> &memory.graph.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-12672","kind":"paragraph","spans":[{"id":"spn-11648","text":"Use when anomaly context should be enriched with historical incidents or structural memory before a decision is made. This is the core anomaly enrichment pipeline."}]},{"id":"blk-12673","kind":"heading","level":3,"spans":[{"id":"spn-11649","text":"Pattern C: detect -> space -> reason"}]},{"id":"blk-12674","kind":"paragraph","spans":[{"id":"spn-11650","text":"Add region or fleet state before deciding."}]},{"id":"blk-12675","kind":"code","language":"text","text":"fleet_telemetry\n|> &time.anomaly.detect()\n|> &space.fleet.enrich()\n|> &reason.plan.evaluate()"},{"id":"blk-12676","kind":"paragraph","spans":[{"id":"spn-11651","text":"Use when anomalies must be interpreted in spatial context, such as regional infrastructure or fleet-level behavior."}]},{"id":"blk-12677","kind":"heading","level":3,"spans":[{"id":"spn-11652","text":"Pattern D: memory -> detect -> reason"}]},{"id":"blk-12678","kind":"paragraph","spans":[{"id":"spn-11653","text":"Use historical memory alongside anomaly detection."}]},{"id":"blk-12679","kind":"code","language":"text","text":"query_context\n|> &memory.graph.recall()\n|> &time.anomaly.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-12680","kind":"paragraph","spans":[{"id":"spn-11654","text":"Use when anomaly interpretation benefits from prior incidents, known failure modes, or analogous cases."}]},{"id":"blk-12681","kind":"heading","level":3,"spans":[{"id":"spn-11655","text":"Pattern E: detect -> memory.learn"}]},{"id":"blk-12682","kind":"paragraph","spans":[{"id":"spn-11656","text":"Use confirmed outcomes to improve future detection."}]},{"id":"blk-12683","kind":"code","language":"text","text":"stream_data\n|> &time.anomaly.detect()\n|> &reason.argument.evaluate()\n|> &memory.graph.learn()"},{"id":"blk-12684","kind":"paragraph","spans":[{"id":"spn-11657","text":"Use when anomaly-driven decisions should become part of durable organizational memory and future detection baselines."}]},{"id":"blk-12685","kind":"paragraph","spans":[{"id":"spn-11658","text":"---"}]},{"id":"blk-12686","kind":"heading","level":2,"spans":[{"id":"spn-11659","text":"10. Architecture diagram"}]},{"id":"blk-12687","kind":"paragraph","spans":[{"id":"spn-11660","text":"A simple conceptual view of "},{"id":"spn-11661","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11662","text":" in composition:"}]},{"id":"blk-12688","kind":"code","language":"text","text":"streaming data / historical signals\n            |\n            v\n   +----------------------+\n   |   &time.anomaly      |\n   |  detect / enrich     |\n   +----------------------+\n            |\n            v\n       anomaly_set\n            |\n     +------+------+\n     |             |\n     v             v\n&memory.*      &reason.*\n enrich         evaluate\n     |             |\n     +------+------+\n            |\n            v\n         output"},{"id":"blk-12689","kind":"paragraph","spans":[{"id":"spn-11663","text":"This is why contract typing matters: downstream capabilities need to know what kind of artifact they are receiving."}]},{"id":"blk-12690","kind":"paragraph","spans":[{"id":"spn-11664","text":"---"}]},{"id":"blk-12691","kind":"heading","level":2,"spans":[{"id":"spn-11665","text":"11. Example API shape"}]},{"id":"blk-12692","kind":"paragraph","spans":[{"id":"spn-11666","text":"A provider-specific API will vary, but an anomaly detection provider commonly exposes a shape like:"}]},{"id":"blk-12693","kind":"code","language":"json","text":"{\n  \"operation\": \"detect\",\n  \"input\": {\n    \"stream\": \"cpu\",\n    \"data\": [\n      { \"timestamp\": \"2026-03-15T00:00:00Z\", \"value\": 42.1 },\n      { \"timestamp\": \"2026-03-15T00:01:00Z\", \"value\": 43.7 },\n      { \"timestamp\": \"2026-03-15T00:02:00Z\", \"value\": 91.3 }\n    ],\n    \"window_minutes\": 15,\n    \"sensitivity\": \"medium\"\n  }\n}"},{"id":"blk-12694","kind":"paragraph","spans":[{"id":"spn-11667","text":"Representative response:"}]},{"id":"blk-12695","kind":"code","language":"json","text":"{\n  \"anomalies\": [\n    {\n      \"timestamp\": \"2026-03-15T00:02:00Z\",\n      \"stream\": \"cpu\",\n      \"type\": \"spike\",\n      \"severity\": \"high\",\n      \"value\": 91.3,\n      \"baseline\": 43.0,\n      \"confidence\": 0.92\n    }\n  ],\n  \"summary\": \"CPU spike detected at 00:02 — value 91.3 vs baseline 43.0.\"\n}"},{"id":"blk-12696","kind":"paragraph","spans":[{"id":"spn-11668","text":"The protocol does not require this exact transport shape. It requires that the provider satisfy the declared capability contract."}]},{"id":"blk-12697","kind":"paragraph","spans":[{"id":"spn-11669","text":"---"}]},{"id":"blk-12698","kind":"heading","level":2,"spans":[{"id":"spn-11670","text":"12. Governance implications"}]},{"id":"blk-12699","kind":"paragraph","spans":[{"id":"spn-11671","text":"Anomalies are often used to trigger automated responses before a human fully reviews the situation. That makes governance important."}]},{"id":"blk-12700","kind":"paragraph","spans":[{"id":"spn-11672","text":"Common governance examples for anomaly-driven systems:"}]},{"id":"blk-12701","kind":"heading","level":3,"spans":[{"id":"spn-11673","text":"Hard constraints"}]},{"id":"blk-12702","items":[{"blocks":[{"id":"blk-12704","kind":"paragraph","spans":[{"id":"spn-11674","text":"never trigger irreversible action from a single anomaly detection alone"}]}],"id":"blk-12703","kind":"list-item"},{"blocks":[{"id":"blk-12706","kind":"paragraph","spans":[{"id":"spn-11675","text":"never suppress audit logging for anomaly-driven responses"}]}],"id":"blk-12705","kind":"list-item"},{"blocks":[{"id":"blk-12708","kind":"paragraph","spans":[{"id":"spn-11676","text":"never escalate to external systems without provenance attached"}]}],"id":"blk-12707","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12709","kind":"heading","level":3,"spans":[{"id":"spn-11677","text":"Soft constraints"}]},{"id":"blk-12710","items":[{"blocks":[{"id":"blk-12712","kind":"paragraph","spans":[{"id":"spn-11678","text":"prefer investigation over immediate remediation when confidence is moderate"}]}],"id":"blk-12711","kind":"list-item"},{"blocks":[{"id":"blk-12714","kind":"paragraph","spans":[{"id":"spn-11679","text":"prefer correlating multiple signals before triggering high-severity responses"}]}],"id":"blk-12713","kind":"list-item"},{"blocks":[{"id":"blk-12716","kind":"paragraph","spans":[{"id":"spn-11680","text":"prefer recent baselines over stale detection models"}]}],"id":"blk-12715","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12717","kind":"heading","level":3,"spans":[{"id":"spn-11681","text":"Escalation rules"}]},{"id":"blk-12718","kind":"paragraph","spans":[{"id":"spn-11682","text":"Anomaly-heavy systems often combine well with:"}]},{"id":"blk-12719","kind":"code","language":"json","text":"{\n  \"escalate_when\": {\n    \"confidence_below\": 0.7,\n    \"severity_above\": \"high\",\n    \"correlated_anomalies_exceed\": 3,\n    \"hard_boundary_approached\": true\n  }\n}"},{"id":"blk-12720","kind":"paragraph","spans":[{"id":"spn-11683","text":"This is one reason "},{"id":"spn-11684","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11685","text":" often composes closely with "},{"id":"spn-11686","marks":["code"],"text":"&reason.argument"},{"id":"spn-11687","text":" or "},{"id":"spn-11688","marks":["code"],"text":"&reason.plan"},{"id":"spn-11689","text":"."}]},{"id":"blk-12721","kind":"paragraph","spans":[{"id":"spn-11690","text":"---"}]},{"id":"blk-12722","kind":"heading","level":2,"spans":[{"id":"spn-11691","text":"13. Provenance implications"}]},{"id":"blk-12723","kind":"paragraph","spans":[{"id":"spn-11692","text":"Anomalies can trigger automated incident response, scaling decisions, and operational escalations, so provenance should be explicit."}]},{"id":"blk-12724","kind":"paragraph","spans":[{"id":"spn-11693","text":"A provenance record for an anomaly detection step may include:"}]},{"id":"blk-12725","kind":"code","language":"json","text":"{\n  \"source\": \"&time.anomaly\",\n  \"provider\": \"ticktickclock\",\n  \"operation\": \"detect\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"input_hash\": \"sha256:abcd1234...\",\n  \"output_hash\": \"sha256:efgh5678...\",\n  \"parent_hash\": \"sha256:0000...\",\n  \"mcp_trace_id\": \"ttc-anomaly-17\"\n}"},{"id":"blk-12726","kind":"paragraph","spans":[{"id":"spn-11694","text":"This helps answer questions like:"}]},{"id":"blk-12727","items":[{"blocks":[{"id":"blk-12729","kind":"paragraph","spans":[{"id":"spn-11695","text":"Why did the system trigger an incident response?"}]}],"id":"blk-12728","kind":"list-item"},{"blocks":[{"id":"blk-12731","kind":"paragraph","spans":[{"id":"spn-11696","text":"Which anomaly provider flagged the deviation?"}]}],"id":"blk-12730","kind":"list-item"},{"blocks":[{"id":"blk-12733","kind":"paragraph","spans":[{"id":"spn-11697","text":"What detection window and confidence profile informed the action?"}]}],"id":"blk-12732","kind":"list-item"},{"blocks":[{"id":"blk-12735","kind":"paragraph","spans":[{"id":"spn-11698","text":"Which upstream signals produced this anomaly event?"}]}],"id":"blk-12734","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12736","kind":"paragraph","spans":[{"id":"spn-11699","text":"Anomalies without provenance are difficult to audit and easy to over-trust."}]},{"id":"blk-12737","kind":"paragraph","spans":[{"id":"spn-11700","text":"---"}]},{"id":"blk-12738","kind":"heading","level":2,"spans":[{"id":"spn-11701","text":"14. A2A implications"}]},{"id":"blk-12739","kind":"paragraph","spans":[{"id":"spn-11702","text":"An anomaly detection capability may map naturally to A2A-advertised skills such as:"}]},{"id":"blk-12740","items":[{"blocks":[{"id":"blk-12742","kind":"paragraph","spans":[{"id":"spn-11703","marks":["code"],"text":"temporal-anomaly-detection"}]}],"id":"blk-12741","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12743","kind":"paragraph","spans":[{"id":"spn-11704","text":"That means an agent card generated from an "},{"id":"spn-11705","marks":["code"],"text":"ampersand.json"},{"id":"spn-11706","text":" declaration can advertise anomaly detection as a reusable, discoverable coordination-facing skill."}]},{"id":"blk-12744","kind":"paragraph","spans":[{"id":"spn-11707","text":"This is one example of how the [&] Protocol complements A2A rather than replacing it."}]},{"id":"blk-12745","kind":"paragraph","spans":[{"id":"spn-11708","text":"---"}]},{"id":"blk-12746","kind":"heading","level":2,"spans":[{"id":"spn-11709","text":"15. MCP implications"}]},{"id":"blk-12747","kind":"paragraph","spans":[{"id":"spn-11710","text":"An anomaly detection provider may also compile into MCP-facing configuration if the implementation exposes a tool or service endpoint."}]},{"id":"blk-12748","kind":"paragraph","spans":[{"id":"spn-11711","text":"For example, a declaration containing "},{"id":"spn-11712","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11713","text":" may generate MCP configuration that wires in an anomaly detection provider alongside memory and reasoning providers."}]},{"id":"blk-12749","kind":"paragraph","spans":[{"id":"spn-11714","text":"This is one example of how the [&] Protocol complements MCP rather than replacing it."}]},{"id":"blk-12750","kind":"paragraph","spans":[{"id":"spn-11715","text":"---"}]},{"id":"blk-12751","kind":"heading","level":2,"spans":[{"id":"spn-11716","text":"16. Research references and grounding"}]},{"id":"blk-12752","kind":"paragraph","spans":[{"id":"spn-11717","text":"The design of "},{"id":"spn-11718","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11719","text":" is informed by overlapping areas of work:"}]},{"id":"blk-12753","items":[{"blocks":[{"id":"blk-12755","kind":"paragraph","spans":[{"id":"spn-11720","text":"statistical anomaly detection"}]}],"id":"blk-12754","kind":"list-item"},{"blocks":[{"id":"blk-12757","kind":"paragraph","spans":[{"id":"spn-11721","text":"time-series outlier identification"}]}],"id":"blk-12756","kind":"list-item"},{"blocks":[{"id":"blk-12759","kind":"paragraph","spans":[{"id":"spn-11722","text":"change-point detection"}]}],"id":"blk-12758","kind":"list-item"},{"blocks":[{"id":"blk-12761","kind":"paragraph","spans":[{"id":"spn-11723","text":"operational monitoring and observability"}]}],"id":"blk-12760","kind":"list-item"},{"blocks":[{"id":"blk-12763","kind":"paragraph","spans":[{"id":"spn-11724","text":"streaming event detection"}]}],"id":"blk-12762","kind":"list-item"},{"blocks":[{"id":"blk-12765","kind":"paragraph","spans":[{"id":"spn-11725","text":"drift detection in production systems"}]}],"id":"blk-12764","kind":"list-item"},{"blocks":[{"id":"blk-12767","kind":"paragraph","spans":[{"id":"spn-11726","text":"temporal context in agent and planning architectures"}]}],"id":"blk-12766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12768","kind":"paragraph","spans":[{"id":"spn-11727","text":"The important protocol-level insight is not that anomaly detection is new. It is that "},{"id":"spn-11728","marks":["bold"],"text":"anomaly detection should be represented explicitly as a composable capability"},{"id":"spn-11729","text":" rather than hidden in monitoring infrastructure."}]},{"id":"blk-12769","kind":"paragraph","spans":[{"id":"spn-11730","text":"That shift enables:"}]},{"id":"blk-12770","items":[{"blocks":[{"id":"blk-12772","kind":"paragraph","spans":[{"id":"spn-11731","text":"schema validation"}]}],"id":"blk-12771","kind":"list-item"},{"blocks":[{"id":"blk-12774","kind":"paragraph","spans":[{"id":"spn-11732","text":"typed pipelines"}]}],"id":"blk-12773","kind":"list-item"},{"blocks":[{"id":"blk-12776","kind":"paragraph","spans":[{"id":"spn-11733","text":"provider interchangeability"}]}],"id":"blk-12775","kind":"list-item"},{"blocks":[{"id":"blk-12778","kind":"paragraph","spans":[{"id":"spn-11734","text":"governance-aware responses"}]}],"id":"blk-12777","kind":"list-item"},{"blocks":[{"id":"blk-12780","kind":"paragraph","spans":[{"id":"spn-11735","text":"provenance-preserving execution"}]}],"id":"blk-12779","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12781","kind":"paragraph","spans":[{"id":"spn-11736","text":"---"}]},{"id":"blk-12782","kind":"heading","level":2,"spans":[{"id":"spn-11737","text":"17. Anti-patterns"}]},{"id":"blk-12783","kind":"heading","level":3,"spans":[{"id":"spn-11738","text":"Anti-pattern 1: treat anomaly detection as generic alerting"}]},{"id":"blk-12784","kind":"paragraph","spans":[{"id":"spn-11739","text":"If anomaly detection is bundled into a broad \"alerting\" or \"monitoring\" block, its contract and pipeline role become unclear."}]},{"id":"blk-12785","kind":"heading","level":3,"spans":[{"id":"spn-11740","text":"Anti-pattern 2: treat anomaly output as self-justifying"}]},{"id":"blk-12786","kind":"paragraph","spans":[{"id":"spn-11741","text":"An anomaly is strong evidence that something unusual occurred, but not always enough for unsupervised remediation."}]},{"id":"blk-12787","kind":"heading","level":3,"spans":[{"id":"spn-11742","text":"Anti-pattern 3: conflate forecasting and anomaly detection"}]},{"id":"blk-12788","kind":"paragraph","spans":[{"id":"spn-11743","text":"They are related temporal capabilities, but they are not the same interface. Forecasting predicts future values. Anomaly detection surfaces unexpected present or past values."}]},{"id":"blk-12789","kind":"heading","level":3,"spans":[{"id":"spn-11744","text":"Anti-pattern 4: conflate pattern recognition and anomaly detection"}]},{"id":"blk-12790","kind":"paragraph","spans":[{"id":"spn-11745","text":"Pattern recognition identifies recurring structures such as seasonality or cycles. Anomaly detection identifies deviations from expected behavior."}]},{"id":"blk-12791","kind":"heading","level":3,"spans":[{"id":"spn-11746","text":"Anti-pattern 5: hardwire the protocol to one provider"}]},{"id":"blk-12792","kind":"paragraph","spans":[{"id":"spn-11747","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11748","text":" should remain a portable capability contract."}]},{"id":"blk-12793","kind":"paragraph","spans":[{"id":"spn-11749","text":"---"}]},{"id":"blk-12794","kind":"heading","level":2,"spans":[{"id":"spn-11750","text":"18. Good default guidance"}]},{"id":"blk-12795","kind":"paragraph","spans":[{"id":"spn-11751","text":"Use "},{"id":"spn-11752","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11753","text":" when:"}]},{"id":"blk-12796","items":[{"blocks":[{"id":"blk-12798","kind":"paragraph","spans":[{"id":"spn-11754","text":"the system needs to detect unexpected deviations in temporal signals"}]}],"id":"blk-12797","kind":"list-item"},{"blocks":[{"id":"blk-12800","kind":"paragraph","spans":[{"id":"spn-11755","text":"an incident response or escalation pipeline depends on anomaly context"}]}],"id":"blk-12799","kind":"list-item"},{"blocks":[{"id":"blk-12802","kind":"paragraph","spans":[{"id":"spn-11756","text":"infrastructure, fleet, or operational metrics require continuous monitoring for unusual behavior"}]}],"id":"blk-12801","kind":"list-item"},{"blocks":[{"id":"blk-12804","kind":"paragraph","spans":[{"id":"spn-11757","text":"a declaration should express temporal anomaly detection intelligence explicitly"}]}],"id":"blk-12803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12805","kind":"paragraph","spans":[{"id":"spn-11758","text":"Prefer composing it with:"}]},{"id":"blk-12806","items":[{"blocks":[{"id":"blk-12808","kind":"paragraph","spans":[{"id":"spn-11759","marks":["code"],"text":"&memory.*"},{"id":"spn-11760","text":" when historical baselines or prior incident context improves interpretation"}]}],"id":"blk-12807","kind":"list-item"},{"blocks":[{"id":"blk-12810","kind":"paragraph","spans":[{"id":"spn-11761","marks":["code"],"text":"&space.*"},{"id":"spn-11762","text":" when geography, fleet position, or regional state matters"}]}],"id":"blk-12809","kind":"list-item"},{"blocks":[{"id":"blk-12812","kind":"paragraph","spans":[{"id":"spn-11763","marks":["code"],"text":"&reason.*"},{"id":"spn-11764","text":" when anomalies influence action selection, escalation, or remediation"}]}],"id":"blk-12811","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12813","kind":"paragraph","spans":[{"id":"spn-11765","text":"---"}]},{"id":"blk-12814","kind":"heading","level":2,"spans":[{"id":"spn-11766","text":"19. Summary"}]},{"id":"blk-12815","kind":"paragraph","spans":[{"id":"spn-11767","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11768","text":" is the [&] Protocol capability for detecting temporal anomalies."}]},{"id":"blk-12816","kind":"paragraph","spans":[{"id":"spn-11769","text":"It exists to make temporal anomaly detection:"}]},{"id":"blk-12817","items":[{"blocks":[{"id":"blk-12819","kind":"paragraph","spans":[{"id":"spn-11770","text":"explicit"}]}],"id":"blk-12818","kind":"list-item"},{"blocks":[{"id":"blk-12821","kind":"paragraph","spans":[{"id":"spn-11771","text":"composable"}]}],"id":"blk-12820","kind":"list-item"},{"blocks":[{"id":"blk-12823","kind":"paragraph","spans":[{"id":"spn-11772","text":"contract-aware"}]}],"id":"blk-12822","kind":"list-item"},{"blocks":[{"id":"blk-12825","kind":"paragraph","spans":[{"id":"spn-11773","text":"provider-agnostic"}]}],"id":"blk-12824","kind":"list-item"},{"blocks":[{"id":"blk-12827","kind":"paragraph","spans":[{"id":"spn-11774","text":"governable"}]}],"id":"blk-12826","kind":"list-item"},{"blocks":[{"id":"blk-12829","kind":"paragraph","spans":[{"id":"spn-11775","text":"provenance-friendly"}]}],"id":"blk-12828","kind":"list-item"},{"blocks":[{"id":"blk-12831","kind":"paragraph","spans":[{"id":"spn-11776","text":"generatable into MCP and A2A surfaces"}]}],"id":"blk-12830","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-12832","kind":"paragraph","spans":[{"id":"spn-11777","text":"In short:"}]},{"blocks":[{"id":"blk-12834","kind":"paragraph","spans":[{"id":"spn-11778","marks":["code"],"text":"&time.anomaly"},{"id":"spn-11779","text":" gives an agent a standard way to declare that it can detect unexpected deviations in temporal signals and use that detection safely within a composed cognitive system."}]}],"id":"blk-12833","kind":"quote"}],"edges":[],"id":"bagaaiera7f3h2uitk2jnip7sratw2icc5lihs7lkjhbdpjxwn3it5gvlaq2a","vocabulary":"ampersand.docs.fs.v1"}