rks":["code"],"text":"protocols.length"},{"id":"spn-102699","text":", never typed — so \"missing OS-011/OS-012\" or a wrong count is structurally impossible."}]}],"id":"blk-71615","kind":"list-item"},{"blocks":[{"id":"blk-71618","kind":"paragraph","spans":[{"id":"spn-102700","marks":["code"],"text":"_rebuild/build/templates.mjs"},{"id":"spn-102701","text":" — zero-dependency template-literal components."}]}],"id":"blk-71617","kind":"list-item"},{"blocks":[{"id":"blk-71620","kind":"paragraph","spans":[{"id":"spn-102702","marks":["code"],"text":"_rebuild/build/build.mjs"},{"id":"spn-102703","text":" — validates data (fails the build on drift: bad id, unknown status, missing field, out-of-order ids) then renders."}]}],"id":"blk-71619","kind":"list-item"},{"blocks":[{"id":"blk-71622","kind":"paragraph","spans":[{"id":"spn-102704","marks":["code"],"text":"_rebuild/styles/site.css"},{"id":"spn-102705","text":" + "},{"id":"spn-102706","marks":["code"],"text":"_rebuild/build/proof.js"},{"id":"spn-102707","text":" — design tokens + the κ proof UI; "},{"id":"spn-102708","marks":["code"],"text":"kappa_proof.js"},{"id":"spn-102709","text":" and "},{"id":"spn-102710","marks":["code"],"text":"amp-nav.js"},{"id":"spn-102711","text":" already live at the site root."}]}],"id":"blk-71621","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71623","kind":"paragraph","spans":[{"id":"spn-102712","text":"To change the homepage: edit the JSON/templates, run "},{"id":"spn-102713","marks":["code"],"text":"node _rebuild/build/build.mjs"},{"id":"spn-102714","text":", then copy "},{"id":"spn-102715","marks":["code"],"text":"dist/index.html"},{"id":"spn-102716","text":" → "},{"id":"spn-102717","marks":["code"],"text":"index.html"},{"id":"spn-102718","text":", "},{"id":"spn-102719","marks":["code"],"text":"dist/styles/site.css"},{"id":"spn-102720","text":" → "},{"id":"spn-102721","marks":["code"],"text":"styles/site.css"},{"id":"spn-102722","text":", "},{"id":"spn-102723","marks":["co