102820","text":"v3.0 in development ("},{"id":"spn-102821","marks":["code"],"text":"/PRISM/"},{"id":"spn-102822","text":" codebase, subdomain "},{"id":"spn-102823","marks":["code"],"text":"prism.opensentience.org"},{"id":"spn-102824","text":")"}]}],[{"id":"blk-71706","spans":[{"id":"spn-102825","marks":["bold"],"text":"PULSE"},{"id":"spn-102826","text":" (Uniform Loop State Exchange)"}]},{"id":"blk-71707","spans":[{"id":"spn-102827","marks":["bold"],"text":"OS-010"}]},{"id":"blk-71708","spans":[{"id":"spn-102828","marks":["code"],"text":"&memory + &govern + &time"}]},{"id":"blk-71709","spans":[{"id":"spn-102829","text":"v0.1.1 ("},{"id":"spn-102830","marks":["code"],"text":"/PULSE/"},{"id":"spn-102831","text":" directory, subdomain "},{"id":"spn-102832","marks":["code"],"text":"pulse.opensentience.org"},{"id":"spn-102833","text":")"}]}],[{"id":"blk-71710","spans":[{"id":"spn-102834","marks":["bold"],"text":"Embodiment Protocol"}]},{"id":"blk-71711","spans":[{"id":"spn-102835","marks":["bold"],"text":"OS-011"}]},{"id":"blk-71712","spans":[{"id":"spn-102836","marks":["code"],"text":"&body.*"},{"id":"spn-102837","text":" (new sensorimotor primitive)"}]},{"id":"blk-71713","spans":[{"id":"spn-102838","text":"v0.1 draft (subdomain "},{"id":"spn-102839","marks":["code"],"text":"embodiment.opensentience.org"},{"id":"spn-102840","text":")"}]}],[{"id":"blk-71714","spans":[{"id":"spn-102841","marks":["bold"],"text":"SCOPE"},{"id":"spn-102842","text":" (Spatial Claims & Coordination)"}]},{"id":"blk-71715","spans":[{"id":"spn-102843","marks":["bold"],"text":"OS-012"}]},{"id":"blk-71716","spans":[{"id":"spn-102844","marks":["code"],"text":"&space.region + &space.claim"}]},{"id":"blk-71717","spans":[{"id":"spn-102845","text":"v0.1 draft (subdomain "},{"id":"spn-102846","marks":["code"],"text":"scope.opensentience.org"},{"id":"spn-102847","text":")"}]}]]},{"id":"blk-71718","kind":"paragraph","spans":[{"id":"spn-102848","text":"OS-009 (PRISM) and OS-010 (PULSE) are sibling cross-cutting protocols. PRISM is the diagnostic algebra (measures loops over time). PULSE is the temporal algebra (declares how loops cycle). OS-011 (Embodiment) is the sensorimotor behavioral protocol for "},{"id":"spn-102849","marks":["code"],"text":"&body.*"},{"id":"spn-102850","text":" providers — closes the perception-action gap by defining the typed "},{"id":"spn-102851","marks":["code"],"text":"perceive/act/affordances/encode_state/replay"},{"id":"spn-102852","text":" loop. Together with the eight cognitive primitives (OS-001 through OS-008) and the [&] structural composition layer, they form the complete protocol stack."}]},{"id":"blk-71719","kind":"heading","level":2,"spans":[{"id":"spn-102853","text":"Separate spec documents"}]},{"id":"blk-71720","items":[{"blocks":[{"id":"blk-71722","kind":"paragraph","spans":[{"id":"spn-102854","marks":["code"],"text":"docs/spec/OS-008-HARNESS.md"},{"id":"spn-102855","text":" — Agent Harness Protocol (pipeline enforcement, quality gates, sprint contracts, context management)"}]}],"id":"blk-71721","kind":"list-item"},{"blocks":[{"id":"blk-71724","kind":"paragraph","spans":[{"id":"spn-102856","marks":["code"],"text":"docs/spec/OS-009-PRISM-SPECIFICATION.md"},{"id":"spn-102857","text":" — PRISM Protocol for Rating Iterative System Memory (9 CL dimensions, 4-phase evaluation loop, BYOR, IRT calibration)"}]}],"id":"blk-71723","kind":"list-item"},{"blocks":[{"id":"blk-71726","kind":"paragraph","spans":[{"id":"spn-102858","marks":["code"],"text":"docs/spec/OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-102859","text":" — PULSE Protocol for Uniform Loop State Exchange (loop manifest schema, 5 canonical phase kinds, 6 canonical tokens as of v0.1.1, 7 invariants, BYOL)"}]}],"id":"blk-71725","kind":"list-item"},{"blocks":[{"id":"blk-71728","kind":"paragraph","spans":[{"id":"spn-102860","marks":["code"],"text":"docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-102861","text":" — Embodiment Protocol (typed perceive/act/affordances/encode_state/replay loop for "},{"id":"spn-102862","marks":["code"],"text":"&body.*"},{"id":"spn-102863","text":", InteractionTrace schema, SurpriseSignal PULSE token, 5 invariants, 12 conformance tests)"}]}],"id":"blk-71727","kind":"list-item"},{"blocks":[{"id":"blk-71730","kind":"paragraph","spans":[{"id":"spn-102864","marks":["code"],"text":"docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-102865","text":" — Empirical Evaluation of Topology-Aware Continual Learning (Graphonomous benchmark on [&] portfolio)"}]}],"id":"blk-71729","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71731","kind":"heading","level":2,"spans":[{"id":"spn-102866","text":"Relationship to other projects"}]},{"id":"blk-71732","items":[{"blocks":[{"id":"blk-71734","kind":"paragraph","spans":[{"id":"spn-102867","text":"OpenSentience defines the theoretical protocols; [&] portfolio companies implement them"}]}],"id":"blk-71733","kind":"list-item"},{"blocks":[{"id":"blk-71736","kind":"paragraph","spans":[{"id":"spn-102868","text":"Graphonomous implements OS-001 (continual learning) and is the canonical PULSE substrate for "},{"id":"spn-102869","marks":["code"],"text":"memory"}]}],"id":"blk-71735","kind":"list-item"},{"blocks":[{"id":"blk-71738","kind":"paragraph","spans":[{"id":"spn-102870","text":"AmpersandBoxDesign implements OS-002 through OS-005 as prompts and contracts"}]}],"id":"blk-71737","kind":"list-item"},{"blocks":[{"id":"blk-71740","kind":"paragraph","spans":[{"id":"spn-102871","text":"Delegatic implements OS-006 (governance) and is the canonical PULSE substrate for "},{"id":"spn-102872","marks":["code"],"text":"policy"},{"id":"spn-102873","text":" and "},{"id":"spn-102874","marks":["code"],"text":"audit"}]}],"id":"blk-71739","kind":"list-item"},{"blocks":[{"id":"blk-71742","kind":"paragraph","spans":[{"id":"spn-102875","text":"OS-008 (Harness) sits above OS-006 — enforces pipeline ordering, quality gates, and governance contracts at runtime"}]}],"id":"blk-71741","kind":"list-item"},{"blocks":[{"id":"blk-71744","kind":"paragraph","spans":[{"id":"spn-102876","text":"OS-009 (PRISM) lives in "},{"id":"spn-102877","marks":["code"],"text":"/home/travis/ProjectAmp2/PRISM/"},{"id":"spn-102878","text":" (Elixir codebase, Fly.io deploy)"}]}],"id":"blk-71743","kind":"list-item"},{"blocks":[{"id":"blk-71746","kind":"paragraph","spans":[{"id":"spn-102879","text":"OS-010 (PULSE) lives in "},{"id":"spn-102880","marks":["code"],"text":"/home/travis/ProjectAmp2/PULSE/"},{"id":"spn-102881","text":" (manifest standard + reference manifests + JSON Schema)"}]}],"id":"blk-71745","kind":"list-item"},{"blocks":[{"id":"blk-71748","kind":"paragraph","spans":[{"id":"spn-102882","text":"Every portfolio product declares its own loop topology via a PULSE manifest in "},{"id":"spn-102883","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-102884","text":" under the \"PULSE Loop Manifest\" section"}]}],"id":"blk-71747","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71749","kind":"heading","level":2,"spans":[{"id":"spn-102885","text":"Homepage build (data-driven, anti-drift)"}]},{"id":"blk-71750","kind":"paragraph","spans":[{"id":"spn-102886","text":"The homepage ("},{"id":"spn-102887","marks":["code"],"text":"index.html"},{"id":"spn-102888","text":") is "},{"id":"spn-102889","marks":["bold"],"text":"generated"},{"id":"spn-102890","text":", not hand-edited. Source lives in "},{"id":"spn-102891","marks":["code"],"text":"_rebuild/"},{"id":"spn-102892","text":":"}]},{"id":"blk-71751","items":[{"blocks":[{"id":"blk-71753","kind":"paragraph","spans":[{"id":"spn-102893","marks":["code"],"text":"_rebuild/data/{site,protocols,rungs,references}.json"},{"id":"spn-102894","text":" — single source of truth. The protocol "},{"id":"spn-102895","marks":["bold"],"text":"count"},{"id":"spn-102896","text":" and "},{"id":"spn-102897","marks":["bold"],"text":"OS-NNN range"},{"id":"spn-102898","text":" in the hero/headings are DERIVED from "},{"id":"spn-102899","marks":["code"],"text":"protocols.length"},{"id":"spn-102900","text":", never typed — so \"missing OS-011/OS-012\" or a wrong count is structurally impossible."}]}],"id":"blk-71752","kind":"list-item"},{"blocks":[{"id":"blk-71755","kind":"paragraph","spans":[{"id":"spn-102901","marks":["code"],"text":"_rebuild/build/templates.mjs"},{"id":"spn-102902","text":" — zero-dependency template-literal components."}]}],"id":"blk-71754","kind":"list-item"},{"blocks":[{"id":"blk-71757","kind":"paragraph","spans":[{"id":"spn-102903","marks":["code"],"text":"_rebuild/build/build.mjs"},{"id":"spn-102904","text":" — validates data (fails the build on drift: bad id, unknown status, missing field, out-of-order ids) then renders."}]}],"id":"blk-71756","kind":"list-item"},{"blocks":[{"id":"blk-71759","kind":"paragraph","spans":[{"id":"spn-102905","marks":["code"],"text":"_rebuild/styles/site.css"},{"id":"spn-102906","text":" + "},{"id":"spn-102907","marks":["code"],"text":"_rebuild/build/proof.js"},{"id":"spn-102908","text":" — design tokens + the κ proof UI; "},{"id":"spn-102909","marks":["code"],"text":"kappa_proof.js"},{"id":"spn-102910","text":" and "},{"id":"spn-102911","marks":["code"],"text":"amp-nav.js"},{"id":"spn-102912","text":" already live at the site root."}]}],"id":"blk-71758","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71760","kind":"paragraph","spans":[{"id":"spn-102913","text":"To change the homepage: edit the JSON/templates, run "},{"id":"spn-102914","marks":["code"],"text":"node _rebuild/build/build.mjs"},{"id":"spn-102915","text":", then copy "},{"id":"spn-102916","marks":["code"],"text":"dist/index.html"},{"id":"spn-102917","text":" → "},{"id":"spn-102918","marks":["code"],"text":"index.html"},{"id":"spn-102919","text":", "},{"id":"spn-102920","marks":["code"],"text":"dist/styles/site.css"},{"id":"spn-102921","text":" → "},{"id":"spn-102922","marks":["code"],"text":"styles/site.css"},{"id":"spn-102923","text":", "},{"id":"spn-102924","marks":["code"],"text":"dist/proof.js"},{"id":"spn-102925","text":" → "},{"id":"spn-102926","marks":["code"],"text":"proof.js"},{"id":"spn-102927","text":". The standalone arithmetic/playground/scope pages at the root are authored separately and are not generated."}]}],"edges":[],"id":"bagaaierafgjcji7ygd5yivjj4nvpmysr6o3xrg2ml4ewlkbgygnohd2gc5uq","vocabulary":"ampersand.docs.fs.v1"}