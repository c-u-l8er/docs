rks":["code"],"text":"protocols.length"},{"id":"spn-105539","text":", never typed — so \"missing OS-011/OS-012\" or a wrong count is structurally impossible."}]}],"id":"blk-72580","kind":"list-item"},{"blocks":[{"id":"blk-72583","kind":"paragraph","spans":[{"id":"spn-105540","marks":["code"],"text":"_rebuild/build/templates.mjs"},{"id":"spn-105541","text":" — zero-dependency template-literal components."}]}],"id":"blk-72582","kind":"list-item"},{"blocks":[{"id":"blk-72585","kind":"paragraph","spans":[{"id":"spn-105542","marks":["code"],"text":"_rebuild/build/build.mjs"},{"id":"spn-105543","text":" — validates data (fails the build on drift: bad id, unknown status, missing field, out-of-order ids) then renders."}]}],"id":"blk-72584","kind":"list-item"},{"blocks":[{"id":"blk-72587","kind":"paragraph","spans":[{"id":"spn-105544","marks":["code"],"text":"_rebuild/styles/site.css"},{"id":"spn-105545","text":" + "},{"id":"spn-105546","marks":["code"],"text":"_rebuild/build/proof.js"},{"id":"spn-105547","text":" — design tokens + the κ proof UI; "},{"id":"spn-105548","marks":["code"],"text":"kappa_proof.js"},{"id":"spn-105549","text":" and "},{"id":"spn-105550","marks":["code"],"text":"amp-nav.js"},{"id":"spn-105551","text":" already live at the site root."}]}],"id":"blk-72586","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72588","kind":"paragraph","spans":[{"id":"spn-105552","text":"To change the homepage: edit the JSON/templates, run "},{"id":"spn-105553","marks":["code"],"text":"node _rebuild/build/build.mjs"},{"id":"spn-105554","text":", then copy "},{"id":"spn-105555","marks":["code"],"text":"dist/index.html"},{"id":"spn-105556","text":" → "},{"id":"spn-105557","marks":["code"],"text":"index.html"},{"id":"spn-105558","text":", "},{"id":"spn-105559","marks":["code"],"text":"dist/styles/site.css"},{"id":"spn-105560","text":" → "},{"id":"spn-105561","marks":["code"],"text":"styles/site.css"},{"id":"spn-105562","text":", "},{"id":"spn-105563","marks":["co