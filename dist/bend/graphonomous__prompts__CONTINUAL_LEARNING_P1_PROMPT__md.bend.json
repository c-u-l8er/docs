{"bendscript":"0.1","blocks":[{"id":"blk-45690","kind":"heading","level":1,"spans":[{"id":"spn-52627","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-45691","kind":"heading","level":2,"spans":[{"id":"spn-52628","text":"Prerequisites"}]},{"id":"blk-45692","kind":"paragraph","spans":[{"id":"spn-52629","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-45693","items":[{"blocks":[{"id":"blk-45695","kind":"paragraph","spans":[{"id":"spn-52630","text":"[ ] "},{"id":"spn-52631","marks":["code"],"text":"mix test"},{"id":"spn-52632","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-45694","kind":"list-item"},{"blocks":[{"id":"blk-45697","kind":"paragraph","spans":[{"id":"spn-52633","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-45696","kind":"list-item"},{"blocks":[{"id":"blk-45699","kind":"paragraph","spans":[{"id":"spn-52634","text":"[ ] "},{"id":"spn-52635","marks":["code"],"text":"BeliefRevision"},{"id":"spn-52636","text":" module exists with "},{"id":"spn-52637","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-45698","kind":"list-item"},{"blocks":[{"id":"blk-45701","kind":"paragraph","spans":[{"id":"spn-52638","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-45700","kind":"list-item"},{"blocks":[{"id":"blk-45703","kind":"paragraph","spans":[{"id":"spn-52639","text":"[ ] "},{"id":"spn-52640","marks":["code"],"text":":superseded_by"},{"id":"spn-52641","text":" edge type works"}]}],"id":"blk-45702","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45704","kind":"heading","level":2,"spans":[{"id":"spn-52642","text":"Session Goal"}]},{"id":"blk-45705","kind":"paragraph","spans":[{"id":"spn-52643","text":"Implement P1 capabilities: "},{"id":"spn-52644","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-52645","text":" (Q-value utility scoring), "},{"id":"spn-52646","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-52647","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-52648","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-52649","text":" (40 scenarios), and "},{"id":"spn-52650","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-52651","text":"."}]},{"id":"blk-45706","kind":"heading","level":2,"spans":[{"id":"spn-52652","text":"Active Goal"}]},{"id":"blk-45707","kind":"paragraph","spans":[{"id":"spn-52653","text":"Retrieve and update: "},{"id":"spn-52654","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-45708","kind":"paragraph","spans":[{"id":"spn-52655","text":"---"}]},{"id":"blk-45709","kind":"heading","level":2,"spans":[{"id":"spn-52656","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-45710","kind":"heading","level":3,"spans":[{"id":"spn-52657","text":"What it does"}]},{"id":"blk-45711","kind":"paragraph","spans":[{"id":"spn-52658","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-45712","kind":"heading","level":3,"spans":[{"id":"spn-52659","text":"Research basis"}]},{"id":"blk-45713","kind":"paragraph","spans":[{"id":"spn-52660","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-45714","kind":"heading","level":3,"spans":[{"id":"spn-52661","text":"Schema migration"}]},{"id":"blk-45715","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-45716","kind":"heading","level":3,"spans":[{"id":"spn-52662","text":"File: "},{"id":"spn-52663","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45717","kind":"paragraph","spans":[{"id":"spn-52664","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-45718","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-45719","kind":"paragraph","spans":[{"id":"spn-52665","text":"Call "},{"id":"spn-52666","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-52667","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-52668","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-52669","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-45720","kind":"heading","level":3,"spans":[{"id":"spn-52670","text":"File: "},{"id":"spn-52671","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-45721","kind":"paragraph","spans":[{"id":"spn-52672","text":"In "},{"id":"spn-52673","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-52674","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-45722","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-45723","kind":"heading","level":3,"spans":[{"id":"spn-52675","text":"File: "},{"id":"spn-52676","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45724","kind":"paragraph","spans":[{"id":"spn-52677","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-45725","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-45726","kind":"heading","level":3,"spans":[{"id":"spn-52678","text":"Tests"}]},{"id":"blk-45727","items":[{"blocks":[{"id":"blk-45729","kind":"paragraph","spans":[{"id":"spn-52679","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-45728","kind":"list-item"},{"blocks":[{"id":"blk-45731","kind":"paragraph","spans":[{"id":"spn-52680","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-45730","kind":"list-item"},{"blocks":[{"id":"blk-45733","kind":"paragraph","spans":[{"id":"spn-52681","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-45732","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45734","kind":"paragraph","spans":[{"id":"spn-52682","text":"---"}]},{"id":"blk-45735","kind":"heading","level":2,"spans":[{"id":"spn-52683","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-45736","kind":"heading","level":3,"spans":[{"id":"spn-52684","text":"What it does"}]},{"id":"blk-45737","kind":"paragraph","spans":[{"id":"spn-52685","text":"Two forgetting policies (not six): 1. "},{"id":"spn-52686","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-52687","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-52688","marks":["code"],"text":"max_nodes"},{"id":"spn-52689","text":". Scores each node: "},{"id":"spn-52690","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-52691","text":". Lowest-priority nodes forgotten first. 2. "},{"id":"spn-52692","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-52693","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]},{"id":"blk-45738","kind":"heading","level":3,"spans":[{"id":"spn-52694","text":"Research basis"}]},{"id":"blk-45739","items":[{"blocks":[{"id":"blk-45741","kind":"paragraph","spans":[{"id":"spn-52695","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-45740","kind":"list-item"},{"blocks":[{"id":"blk-45743","kind":"paragraph","spans":[{"id":"spn-52696","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-45742","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45744","kind":"heading","level":3,"spans":[{"id":"spn-52697","text":"Schema migration"}]},{"id":"blk-45745","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-45746","kind":"heading","level":3,"spans":[{"id":"spn-52698","text":"New file: "},{"id":"spn-52699","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-45747","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-45748","kind":"heading","level":3,"spans":[{"id":"spn-52700","text":"New MCP tools (3)"}]},{"id":"blk-45749","items":[{"blocks":[{"id":"blk-45751","kind":"paragraph","spans":[{"id":"spn-52701","marks":["code"],"text":"forget_node"},{"id":"spn-52702","text":" — "},{"id":"spn-52703","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-45750","kind":"list-item"},{"blocks":[{"id":"blk-45753","kind":"paragraph","spans":[{"id":"spn-52704","marks":["code"],"text":"forget_by_policy"},{"id":"spn-52705","text":" — "},{"id":"spn-52706","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-45752","kind":"list-item"},{"blocks":[{"id":"blk-45755","kind":"paragraph","spans":[{"id":"spn-52707","marks":["code"],"text":"gdpr_erase"},{"id":"spn-52708","text":" — "},{"id":"spn-52709","marks":["code"],"text":"{node_id}"},{"id":"spn-52710","text":" — hard delete with audit trail"}]}],"id":"blk-45754","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45756","kind":"heading","level":3,"spans":[{"id":"spn-52711","text":"File: "},{"id":"spn-52712","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45757","kind":"paragraph","spans":[{"id":"spn-52713","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-45758","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-45759","kind":"heading","level":3,"spans":[{"id":"spn-52714","text":"File: "},{"id":"spn-52715","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45760","kind":"paragraph","spans":[{"id":"spn-52716","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-45761","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-45762","kind":"heading","level":3,"spans":[{"id":"spn-52717","text":"File: "},{"id":"spn-52718","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-45763","kind":"paragraph","spans":[{"id":"spn-52719","text":"Add memory pressure detection to survey:"}]},{"id":"blk-45764","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-45765","kind":"heading","level":3,"spans":[{"id":"spn-52720","text":"Tests"}]},{"id":"blk-45766","items":[{"blocks":[{"id":"blk-45768","kind":"paragraph","spans":[{"id":"spn-52721","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-45767","kind":"list-item"},{"blocks":[{"id":"blk-45770","kind":"paragraph","spans":[{"id":"spn-52722","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-45769","kind":"list-item"},{"blocks":[{"id":"blk-45772","kind":"paragraph","spans":[{"id":"spn-52723","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-45771","kind":"list-item"},{"blocks":[{"id":"blk-45774","kind":"paragraph","spans":[{"id":"spn-52724","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-45773","kind":"list-item"},{"blocks":[{"id":"blk-45776","kind":"paragraph","spans":[{"id":"spn-52725","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-45775","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45777","kind":"paragraph","spans":[{"id":"spn-52726","text":"---"}]},{"id":"blk-45778","kind":"heading","level":2,"spans":[{"id":"spn-52727","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-45779","kind":"heading","level":3,"spans":[{"id":"spn-52728","text":"What it does"}]},{"id":"blk-45780","kind":"paragraph","spans":[{"id":"spn-52729","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-45781","kind":"paragraph","spans":[{"id":"spn-52730","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-45782","items":[{"blocks":[{"id":"blk-45784","kind":"paragraph","spans":[{"id":"spn-52731","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-45783","kind":"list-item"},{"blocks":[{"id":"blk-45786","kind":"paragraph","spans":[{"id":"spn-52732","text":"Store contradicting facts → verify "},{"id":"spn-52733","marks":["code"],"text":":contradicts"},{"id":"spn-52734","text":" edges form SCC"}]}],"id":"blk-45785","kind":"list-item"},{"blocks":[{"id":"blk-45788","kind":"paragraph","spans":[{"id":"spn-52735","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-45787","kind":"list-item"},{"blocks":[{"id":"blk-45790","kind":"paragraph","spans":[{"id":"spn-52736","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-45789","kind":"list-item"},{"blocks":[{"id":"blk-45792","kind":"paragraph","spans":[{"id":"spn-52737","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-45791","kind":"list-item"},{"blocks":[{"id":"blk-45794","kind":"paragraph","spans":[{"id":"spn-52738","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-45793","kind":"list-item"},{"blocks":[{"id":"blk-45796","kind":"paragraph","spans":[{"id":"spn-52739","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-45795","kind":"list-item"},{"blocks":[{"id":"blk-45798","kind":"paragraph","spans":[{"id":"spn-52740","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-45797","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45799","kind":"paragraph","spans":[{"id":"spn-52741","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-45800","items":[{"blocks":[{"id":"blk-45802","kind":"paragraph","spans":[{"id":"spn-52742","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-45801","kind":"list-item"},{"blocks":[{"id":"blk-45804","kind":"paragraph","spans":[{"id":"spn-52743","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-45803","kind":"list-item"},{"blocks":[{"id":"blk-45806","kind":"paragraph","spans":[{"id":"spn-52744","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-45805","kind":"list-item"},{"blocks":[{"id":"blk-45808","kind":"paragraph","spans":[{"id":"spn-52745","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-45807","kind":"list-item"},{"blocks":[{"id":"blk-45810","kind":"paragraph","spans":[{"id":"spn-52746","text":"Detect contradictions via explicit "},{"id":"spn-52747","marks":["code"],"text":":contradicts"},{"id":"spn-52748","text":" edges"}]}],"id":"blk-45809","kind":"list-item"},{"blocks":[{"id":"blk-45812","kind":"paragraph","spans":[{"id":"spn-52749","text":"Revision record created with correct fields"}]}],"id":"blk-45811","kind":"list-item"},{"blocks":[{"id":"blk-45814","kind":"paragraph","spans":[{"id":"spn-52750","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-45813","kind":"list-item"},{"blocks":[{"id":"blk-45816","kind":"paragraph","spans":[{"id":"spn-52751","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-45815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45817","kind":"paragraph","spans":[{"id":"spn-52752","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-45818","items":[{"blocks":[{"id":"blk-45820","kind":"paragraph","spans":[{"id":"spn-52753","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-45819","kind":"list-item"},{"blocks":[{"id":"blk-45822","kind":"paragraph","spans":[{"id":"spn-52754","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-45821","kind":"list-item"},{"blocks":[{"id":"blk-45824","kind":"paragraph","spans":[{"id":"spn-52755","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-45823","kind":"list-item"},{"blocks":[{"id":"blk-45826","kind":"paragraph","spans":[{"id":"spn-52756","text":"Unresolved conflict creates "},{"id":"spn-52757","marks":["code"],"text":":contradicts"},{"id":"spn-52758","text":" edges"}]}],"id":"blk-45825","kind":"list-item"},{"blocks":[{"id":"blk-45828","kind":"paragraph","spans":[{"id":"spn-52759","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-45827","kind":"list-item"},{"blocks":[{"id":"blk-45830","kind":"paragraph","spans":[{"id":"spn-52760","text":"Stage 4.5 runs between strengthen and merge"}