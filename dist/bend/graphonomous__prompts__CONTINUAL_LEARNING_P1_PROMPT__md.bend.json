{"bendscript":"0.1","blocks":[{"id":"blk-45094","kind":"heading","level":1,"spans":[{"id":"spn-50824","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-45095","kind":"heading","level":2,"spans":[{"id":"spn-50825","text":"Prerequisites"}]},{"id":"blk-45096","kind":"paragraph","spans":[{"id":"spn-50826","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-45097","items":[{"blocks":[{"id":"blk-45099","kind":"paragraph","spans":[{"id":"spn-50827","text":"[ ] "},{"id":"spn-50828","marks":["code"],"text":"mix test"},{"id":"spn-50829","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-45098","kind":"list-item"},{"blocks":[{"id":"blk-45101","kind":"paragraph","spans":[{"id":"spn-50830","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-45100","kind":"list-item"},{"blocks":[{"id":"blk-45103","kind":"paragraph","spans":[{"id":"spn-50831","text":"[ ] "},{"id":"spn-50832","marks":["code"],"text":"BeliefRevision"},{"id":"spn-50833","text":" module exists with "},{"id":"spn-50834","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-45102","kind":"list-item"},{"blocks":[{"id":"blk-45105","kind":"paragraph","spans":[{"id":"spn-50835","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-45104","kind":"list-item"},{"blocks":[{"id":"blk-45107","kind":"paragraph","spans":[{"id":"spn-50836","text":"[ ] "},{"id":"spn-50837","marks":["code"],"text":":superseded_by"},{"id":"spn-50838","text":" edge type works"}]}],"id":"blk-45106","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45108","kind":"heading","level":2,"spans":[{"id":"spn-50839","text":"Session Goal"}]},{"id":"blk-45109","kind":"paragraph","spans":[{"id":"spn-50840","text":"Implement P1 capabilities: "},{"id":"spn-50841","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-50842","text":" (Q-value utility scoring), "},{"id":"spn-50843","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-50844","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-50845","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-50846","text":" (40 scenarios), and "},{"id":"spn-50847","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-50848","text":"."}]},{"id":"blk-45110","kind":"heading","level":2,"spans":[{"id":"spn-50849","text":"Active Goal"}]},{"id":"blk-45111","kind":"paragraph","spans":[{"id":"spn-50850","text":"Retrieve and update: "},{"id":"spn-50851","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-45112","kind":"paragraph","spans":[{"id":"spn-50852","text":"---"}]},{"id":"blk-45113","kind":"heading","level":2,"spans":[{"id":"spn-50853","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-45114","kind":"heading","level":3,"spans":[{"id":"spn-50854","text":"What it does"}]},{"id":"blk-45115","kind":"paragraph","spans":[{"id":"spn-50855","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-45116","kind":"heading","level":3,"spans":[{"id":"spn-50856","text":"Research basis"}]},{"id":"blk-45117","kind":"paragraph","spans":[{"id":"spn-50857","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-45118","kind":"heading","level":3,"spans":[{"id":"spn-50858","text":"Schema migration"}]},{"id":"blk-45119","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-45120","kind":"heading","level":3,"spans":[{"id":"spn-50859","text":"File: "},{"id":"spn-50860","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45121","kind":"paragraph","spans":[{"id":"spn-50861","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-45122","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-45123","kind":"paragraph","spans":[{"id":"spn-50862","text":"Call "},{"id":"spn-50863","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-50864","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-50865","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-50866","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-45124","kind":"heading","level":3,"spans":[{"id":"spn-50867","text":"File: "},{"id":"spn-50868","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-45125","kind":"paragraph","spans":[{"id":"spn-50869","text":"In "},{"id":"spn-50870","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-50871","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-45126","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-45127","kind":"heading","level":3,"spans":[{"id":"spn-50872","text":"File: "},{"id":"spn-50873","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45128","kind":"paragraph","spans":[{"id":"spn-50874","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-45129","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-45130","kind":"heading","level":3,"spans":[{"id":"spn-50875","text":"Tests"}]},{"id":"blk-45131","items":[{"blocks":[{"id":"blk-45133","kind":"paragraph","spans":[{"id":"spn-50876","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-45132","kind":"list-item"},{"blocks":[{"id":"blk-45135","kind":"paragraph","spans":[{"id":"spn-50877","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-45134","kind":"list-item"},{"blocks":[{"id":"blk-45137","kind":"paragraph","spans":[{"id":"spn-50878","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-45136","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45138","kind":"paragraph","spans":[{"id":"spn-50879","text":"---"}]},{"id":"blk-45139","kind":"heading","level":2,"spans":[{"id":"spn-50880","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-45140","kind":"heading","level":3,"spans":[{"id":"spn-50881","text":"What it does"}]},{"id":"blk-45141","kind":"paragraph","spans":[{"id":"spn-50882","text":"Two forgetting policies (not six): 1. "},{"id":"spn-50883","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-50884","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-50885","marks":["code"],"text":"max_nodes"},{"id":"spn-50886","text":". Scores each node: "},{"id":"spn-50887","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-50888","text":". Lowest-priority nodes forgotten first. 2. "},{"id":"spn-50889","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-50890","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]},{"id":"blk-45142","kind":"heading","level":3,"spans":[{"id":"spn-50891","text":"Research basis"}]},{"id":"blk-45143","items":[{"blocks":[{"id":"blk-45145","kind":"paragraph","spans":[{"id":"spn-50892","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-45144","kind":"list-item"},{"blocks":[{"id":"blk-45147","kind":"paragraph","spans":[{"id":"spn-50893","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-45146","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45148","kind":"heading","level":3,"spans":[{"id":"spn-50894","text":"Schema migration"}]},{"id":"blk-45149","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-45150","kind":"heading","level":3,"spans":[{"id":"spn-50895","text":"New file: "},{"id":"spn-50896","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-45151","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-45152","kind":"heading","level":3,"spans":[{"id":"spn-50897","text":"New MCP tools (3)"}]},{"id":"blk-45153","items":[{"blocks":[{"id":"blk-45155","kind":"paragraph","spans":[{"id":"spn-50898","marks":["code"],"text":"forget_node"},{"id":"spn-50899","text":" — "},{"id":"spn-50900","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-45154","kind":"list-item"},{"blocks":[{"id":"blk-45157","kind":"paragraph","spans":[{"id":"spn-50901","marks":["code"],"text":"forget_by_policy"},{"id":"spn-50902","text":" — "},{"id":"spn-50903","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-45156","kind":"list-item"},{"blocks":[{"id":"blk-45159","kind":"paragraph","spans":[{"id":"spn-50904","marks":["code"],"text":"gdpr_erase"},{"id":"spn-50905","text":" — "},{"id":"spn-50906","marks":["code"],"text":"{node_id}"},{"id":"spn-50907","text":" — hard delete with audit trail"}]}],"id":"blk-45158","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45160","kind":"heading","level":3,"spans":[{"id":"spn-50908","text":"File: "},{"id":"spn-50909","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45161","kind":"paragraph","spans":[{"id":"spn-50910","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-45162","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-45163","kind":"heading","level":3,"spans":[{"id":"spn-50911","text":"File: "},{"id":"spn-50912","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45164","kind":"paragraph","spans":[{"id":"spn-50913","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-45165","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-45166","kind":"heading","level":3,"spans":[{"id":"spn-50914","text":"File: "},{"id":"spn-50915","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-45167","kind":"paragraph","spans":[{"id":"spn-50916","text":"Add memory pressure detection to survey:"}]},{"id":"blk-45168","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-45169","kind":"heading","level":3,"spans":[{"id":"spn-50917","text":"Tests"}]},{"id":"blk-45170","items":[{"blocks":[{"id":"blk-45172","kind":"paragraph","spans":[{"id":"spn-50918","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-45171","kind":"list-item"},{"blocks":[{"id":"blk-45174","kind":"paragraph","spans":[{"id":"spn-50919","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-45173","kind":"list-item"},{"blocks":[{"id":"blk-45176","kind":"paragraph","spans":[{"id":"spn-50920","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-45175","kind":"list-item"},{"blocks":[{"id":"blk-45178","kind":"paragraph","spans":[{"id":"spn-50921","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-45177","kind":"list-item"},{"blocks":[{"id":"blk-45180","kind":"paragraph","spans":[{"id":"spn-50922","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-45179","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45181","kind":"paragraph","spans":[{"id":"spn-50923","text":"---"}]},{"id":"blk-45182","kind":"heading","level":2,"spans":[{"id":"spn-50924","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-45183","kind":"heading","level":3,"spans":[{"id":"spn-50925","text":"What it does"}]},{"id":"blk-45184","kind":"paragraph","spans":[{"id":"spn-50926","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-45185","kind":"paragraph","spans":[{"id":"spn-50927","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-45186","items":[{"blocks":[{"id":"blk-45188","kind":"paragraph","spans":[{"id":"spn-50928","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-45187","kind":"list-item"},{"blocks":[{"id":"blk-45190","kind":"paragraph","spans":[{"id":"spn-50929","text":"Store contradicting facts → verify "},{"id":"spn-50930","marks":["code"],"text":":contradicts"},{"id":"spn-50931","text":" edges form SCC"}]}],"id":"blk-45189","kind":"list-item"},{"blocks":[{"id":"blk-45192","kind":"paragraph","spans":[{"id":"spn-50932","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-45191","kind":"list-item"},{"blocks":[{"id":"blk-45194","kind":"paragraph","spans":[{"id":"spn-50933","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-45193","kind":"list-item"},{"blocks":[{"id":"blk-45196","kind":"paragraph","spans":[{"id":"spn-50934","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-45195","kind":"list-item"},{"blocks":[{"id":"blk-45198","kind":"paragraph","spans":[{"id":"spn-50935","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-45197","kind":"list-item"},{"blocks":[{"id":"blk-45200","kind":"paragraph","spans":[{"id":"spn-50936","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-45199","kind":"list-item"},{"blocks":[{"id":"blk-45202","kind":"paragraph","spans":[{"id":"spn-50937","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-45201","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45203","kind":"paragraph","spans":[{"id":"spn-50938","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-45204","items":[{"blocks":[{"id":"blk-45206","kind":"paragraph","spans":[{"id":"spn-50939","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-45205","kind":"list-item"},{"blocks":[{"id":"blk-45208","kind":"paragraph","spans":[{"id":"spn-50940","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-45207","kind":"list-item"},{"blocks":[{"id":"blk-45210","kind":"paragraph","spans":[{"id":"spn-50941","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-45209","kind":"list-item"},{"blocks":[{"id":"blk-45212","kind":"paragraph","spans":[{"id":"spn-50942","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-45211","kind":"list-item"},{"blocks":[{"id":"blk-45214","kind":"paragraph","spans":[{"id":"spn-50943","text":"Detect contradictions via explicit "},{"id":"spn-50944","marks":["code"],"text":":contradicts"},{"id":"spn-50945","text":" edges"}]}],"id":"blk-45213","kind":"list-item"},{"blocks":[{"id":"blk-45216","kind":"paragraph","spans":[{"id":"spn-50946","text":"Revision record created with correct fields"}]}],"id":"blk-45215","kind":"list-item"},{"blocks":[{"id":"blk-45218","kind":"paragraph","spans":[{"id":"spn-50947","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-45217","kind":"list-item"},{"blocks":[{"id":"blk-45220","kind":"paragraph","spans":[{"id":"spn-50948","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-45219","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45221","kind":"paragraph","spans":[{"id":"spn-50949","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-45222","items":[{"blocks":[{"id":"blk-45224","kind":"paragraph","spans":[{"id":"spn-50950","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-45223","kind":"list-item"},{"blocks":[{"id":"blk-45226","kind":"paragraph","spans":[{"id":"spn-50951","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-45225","kind":"list-item"},{"blocks":[{"id":"blk-45228","kind":"paragraph","spans":[{"id":"spn-50952","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-45227","kind":"list-item"},{"blocks":[{"id":"blk-45230","kind":"paragraph","spans":[{"id":"spn-50953","text":"Unresolved conflict creates "},{"id":"spn-50954","marks":["code"],"text":":contradicts"},{"id":"spn-50955","text":" edges"}]}],"id":"blk-45229","kind":"list-item"},{"blocks":[{"id":"blk-45232","kind":"paragraph","spans":[{"id":"spn-50956","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-45231","kind":"list-item"},{"blocks":[{"id":"blk-45234","kind":"paragraph","spans":[{"id":"spn-50957","text":"Stage 4.5 runs between strengthen and merge"}]}],"id":"blk-45233","kind":"list-item"},{"blocks":[{"id":"blk-45236","kind":"paragraph","spans":[{"id":"spn-50958","text":"Conflict resolution doesn't interfere with Stage 5 merge (0.95 threshold)"}]}],"id":"blk-45235","kind":"list-item"},{"blocks":[{"id":"blk-45238","kind":"paragraph","spans":[{"id":"spn-50959","text":"Multiple conflicts in one consolidation cycle"}]}],"id":"blk-45237","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45239","kind":"paragraph","spans":[{"id":"spn-50960","marks":["bold"],"text":"Category 4: Two-Phase Retrieval (8 scenarios)"}]},{"id":"blk-45240","items":[{"blocks":[{"id":"blk-45242","kind":"paragraph","spans":[{"id":"spn-50961","text":"Q-value updates from successful outcome increase ranking"}]}],"id":"blk-45241","kind":"list-item"},{"blocks":[{"id":"blk-45244","kind":"paragraph","spans":[{"id":"spn-50962","text":"Q-value updates from failed outcome decrease ranking"}]}],"id":"blk-45243","kind":"list-item"},{"blocks":[{"id":"blk-45246","kind":"paragraph","spans":[{"id":"spn-50963","text":"No Q-value effect when q_update_count == 0 for all candidates"}]}],"id":"blk-45245","kind":"list-item"},{"blocks":[{"id":"blk-45248","kind":"paragraph","spans":[{"id":"spn-50964","text":"Blended scoring with alpha=0.3"}]}],"id":"blk-45247","kind":"list-item"},{"blocks":[{"id":"blk-45250","kind":"paragraph","spans":[{"id":"spn-50965","text":"Q-value decay is half confidence decay rate"}]}],"id":"blk-45249","kind":"list-item"},{"blocks":[{"id":"blk-45252","kind":"paragraph","spans":[{"id":"spn-50966","text":"High-confidence but low-utility node ranks below high-utility node"}]}],"id":"blk-45251","kind":"list-item"},{"blocks":[{"id":"blk-45254","kind":"paragraph","spans":[{"id":"spn-50967","text":"Retrieve same query before and after outcome learning → verify rank change"}]}],"id":"blk-45253","kind":"list-item"},{"blocks":[{"id":"blk-45256","kind":"paragraph","spans":[{"id":"spn-50968","text":"nDCG improvement after 5 outcome cycles"}]}],"id":"blk-45255","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45257","kind":"paragraph","spans":[{"id":"spn-50969","marks":["bold"],"text":"Category 5: Intentional Forgetting (8 scenarios)"}]},{"id":"blk-45258","items":[{"blocks":[{"id":"blk-45260","kind":"paragraph","spans":[{"id":"spn-50970","text":"Soft forget excludes from retrieval"}]}],"id":"blk-45259","kind":"list-item"},{"blocks":[{"id":"blk-45262","kind":"paragraph","spans":[{"id":"spn-50971","text":"Hard forget removes node + edges"}]}],"id":"blk-45261","kind":"list-item"},{"blocks":[{"id":"blk-45264","kind":"paragraph","spans":[{"id":"spn-50972","text":"Cascade forget propagates to orphaned dependents"}]}],"id":"blk-45263","kind":"list-item"},{"blocks":[{"id":"blk-45266","kind":"paragraph","spans":[{"id":"spn-50973","text":"GDPR erase leaves no trace"}]}],"id":"blk-45265","kind":"list-item"},{"blocks":[{"id":"blk-45268","kind":"paragraph","spans":[{"id":"spn-50974","text":"Budget-aware hybrid pruning respects max_nodes"}]}],"id":"blk-45267","kind":"list-item"},{"blocks":[{"id":"blk-45270","kind":"paragraph","spans":[{"id":"spn-50975","text":"Priority scoring favors high-confidence, recent, connected nodes"}]}],"id":"blk-45269","kind":"list-item"},{"blocks":[{"id":"blk-45272","kind":"paragraph","spans":[{"id":"spn-50976","text":"Forgotten nodes don't appear in topology analysis"}]}],"id":"blk-45271","kind":"list-item"},{"blocks":[{"id":"blk-45274","kind":"paragraph","spans":[{"id":"spn-50977","text":"Memory pressure triggers forgetting in attention survey"}]}],"id":"blk-45273","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45275","kind":"heading","level":3,"spans":[{"id":"spn-50978","text":"Implementation"}]},{"id":"blk-45276","kind":"paragraph","spans":[{"id":"spn-50979","text":"New file: "},{"id":"spn-50980","marks":["code"],"text":"graphonomous/lib/mix/tasks/benchmark/capability_spec.ex"}]},{"id":"blk-45277","kind":"paragraph","spans":[{"id":"spn-50981","text":"Follow 