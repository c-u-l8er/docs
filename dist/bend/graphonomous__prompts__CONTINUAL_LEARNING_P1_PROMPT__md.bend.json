{"bendscript":"0.1","blocks":[{"id":"blk-70273","kind":"heading","level":1,"spans":[{"id":"spn-101288","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-70274","kind":"heading","level":2,"spans":[{"id":"spn-101289","text":"Prerequisites"}]},{"id":"blk-70275","kind":"paragraph","spans":[{"id":"spn-101290","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-70276","items":[{"blocks":[{"id":"blk-70278","kind":"paragraph","spans":[{"id":"spn-101291","text":"[ ] "},{"id":"spn-101292","marks":["code"],"text":"mix test"},{"id":"spn-101293","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-70277","kind":"list-item"},{"blocks":[{"id":"blk-70280","kind":"paragraph","spans":[{"id":"spn-101294","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-70279","kind":"list-item"},{"blocks":[{"id":"blk-70282","kind":"paragraph","spans":[{"id":"spn-101295","text":"[ ] "},{"id":"spn-101296","marks":["code"],"text":"BeliefRevision"},{"id":"spn-101297","text":" module exists with "},{"id":"spn-101298","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-70281","kind":"list-item"},{"blocks":[{"id":"blk-70284","kind":"paragraph","spans":[{"id":"spn-101299","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-70283","kind":"list-item"},{"blocks":[{"id":"blk-70286","kind":"paragraph","spans":[{"id":"spn-101300","text":"[ ] "},{"id":"spn-101301","marks":["code"],"text":":superseded_by"},{"id":"spn-101302","text":" edge type works"}]}],"id":"blk-70285","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70287","kind":"heading","level":2,"spans":[{"id":"spn-101303","text":"Session Goal"}]},{"id":"blk-70288","kind":"paragraph","spans":[{"id":"spn-101304","text":"Implement P1 capabilities: "},{"id":"spn-101305","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-101306","text":" (Q-value utility scoring), "},{"id":"spn-101307","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-101308","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-101309","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-101310","text":" (40 scenarios), and "},{"id":"spn-101311","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-101312","text":"."}]},{"id":"blk-70289","kind":"heading","level":2,"spans":[{"id":"spn-101313","text":"Active Goal"}]},{"id":"blk-70290","kind":"paragraph","spans":[{"id":"spn-101314","text":"Retrieve and update: "},{"id":"spn-101315","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-70291","kind":"heading","level":2,"spans":[{"id":"spn-101316","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-70292","kind":"heading","level":3,"spans":[{"id":"spn-101317","text":"What it does"}]},{"id":"blk-70293","kind":"paragraph","spans":[{"id":"spn-101318","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-70294","kind":"heading","level":3,"spans":[{"id":"spn-101319","text":"Research basis"}]},{"id":"blk-70295","kind":"paragraph","spans":[{"id":"spn-101320","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-70296","kind":"heading","level":3,"spans":[{"id":"spn-101321","text":"Schema migration"}]},{"id":"blk-70297","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-70298","kind":"heading","level":3,"spans":[{"id":"spn-101322","text":"File: "},{"id":"spn-101323","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-70299","kind":"paragraph","spans":[{"id":"spn-101324","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-70300","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-70301","kind":"paragraph","spans":[{"id":"spn-101325","text":"Call "},{"id":"spn-101326","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-101327","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-101328","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-101329","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-70302","kind":"heading","level":3,"spans":[{"id":"spn-101330","text":"File: "},{"id":"spn-101331","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-70303","kind":"paragraph","spans":[{"id":"spn-101332","text":"In "},{"id":"spn-101333","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-101334","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-70304","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-70305","kind":"heading","level":3,"spans":[{"id":"spn-101335","text":"File: "},{"id":"spn-101336","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-70306","kind":"paragraph","spans":[{"id":"spn-101337","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-70307","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-70308","kind":"heading","level":3,"spans":[{"id":"spn-101338","text":"Tests"}]},{"id":"blk-70309","items":[{"blocks":[{"id":"blk-70311","kind":"paragraph","spans":[{"id":"spn-101339","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-70310","kind":"list-item"},{"blocks":[{"id":"blk-70313","kind":"paragraph","spans":[{"id":"spn-101340","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-70312","kind":"list-item"},{"blocks":[{"id":"blk-70315","kind":"paragraph","spans":[{"id":"spn-101341","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-70314","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70316","kind":"heading","level":2,"spans":[{"id":"spn-101342","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-70317","kind":"heading","level":3,"spans":[{"id":"spn-101343","text":"What it does"}]},{"id":"blk-70318","kind":"paragraph","spans":[{"id":"spn-101344","text":"Two forgetting policies (not six):"}]},{"id":"blk-70319","items":[{"blocks":[{"id":"blk-70321","kind":"paragraph","spans":[{"id":"spn-101345","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-101346","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-101347","marks":["code"],"text":"max_nodes"},{"id":"spn-101348","text":". Scores each node: "},{"id":"spn-101349","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-101350","text":". Lowest-priority nodes forgotten first."}]}],"id":"blk-70320","kind":"list-item"},{"blocks":[{"id":"blk-70323","kind":"paragraph","spans":[{"id":"spn-101351","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-101352","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]}],"id":"blk-70322","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-70324","kind":"heading","level":3,"spans":[{"id":"spn-101353","text":"Research basis"}]},{"id":"blk-70325","items":[{"blocks":[{"id":"blk-70327","kind":"paragraph","spans":[{"id":"spn-101354","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-70326","kind":"list-item"},{"blocks":[{"id":"blk-70329","kind":"paragraph","spans":[{"id":"spn-101355","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-70328","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70330","kind":"heading","level":3,"spans":[{"id":"spn-101356","text":"Schema migration"}]},{"id":"blk-70331","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-70332","kind":"heading","level":3,"spans":[{"id":"spn-101357","text":"New file: "},{"id":"spn-101358","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-70333","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-70334","kind":"heading","level":3,"spans":[{"id":"spn-101359","text":"New MCP tools (3)"}]},{"id":"blk-70335","items":[{"blocks":[{"id":"blk-70337","kind":"paragraph","spans":[{"id":"spn-101360","marks":["code"],"text":"forget_node"},{"id":"spn-101361","text":" — "},{"id":"spn-101362","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-70336","kind":"list-item"},{"blocks":[{"id":"blk-70339","kind":"paragraph","spans":[{"id":"spn-101363","marks":["code"],"text":"forget_by_policy"},{"id":"spn-101364","text":" — "},{"id":"spn-101365","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-70338","kind":"list-item"},{"blocks":[{"id":"blk-70341","kind":"paragraph","spans":[{"id":"spn-101366","marks":["code"],"text":"gdpr_erase"},{"id":"spn-101367","text":" — "},{"id":"spn-101368","marks":["code"],"text":"{node_id}"},{"id":"spn-101369","text":" — hard delete with audit trail"}]}],"id":"blk-70340","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70342","kind":"heading","level":3,"spans":[{"id":"spn-101370","text":"File: "},{"id":"spn-101371","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-70343","kind":"paragraph","spans":[{"id":"spn-101372","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-70344","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-70345","kind":"heading","level":3,"spans":[{"id":"spn-101373","text":"File: "},{"id":"spn-101374","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-70346","kind":"paragraph","spans":[{"id":"spn-101375","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-70347","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-70348","kind":"heading","level":3,"spans":[{"id":"spn-101376","text":"File: "},{"id":"spn-101377","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-70349","kind":"paragraph","spans":[{"id":"spn-101378","text":"Add memory pressure detection to survey:"}]},{"id":"blk-70350","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-70351","kind":"heading","level":3,"spans":[{"id":"spn-101379","text":"Tests"}]},{"id":"blk-70352","items":[{"blocks":[{"id":"blk-70354","kind":"paragraph","spans":[{"id":"spn-101380","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-70353","kind":"list-item"},{"blocks":[{"id":"blk-70356","kind":"paragraph","spans":[{"id":"spn-101381","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-70355","kind":"list-item"},{"blocks":[{"id":"blk-70358","kind":"paragraph","spans":[{"id":"spn-101382","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-70357","kind":"list-item"},{"blocks":[{"id":"blk-70360","kind":"paragraph","spans":[{"id":"spn-101383","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-70359","kind":"list-item"},{"blocks":[{"id":"blk-70362","kind":"paragraph","spans":[{"id":"spn-101384","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-70361","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70363","kind":"heading","level":2,"spans":[{"id":"spn-101385","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-70364","kind":"heading","level":3,"spans":[{"id":"spn-101386","text":"What it does"}]},{"id":"blk-70365","kind":"paragraph","spans":[{"id":"spn-101387","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-70366","kind":"paragraph","spans":[{"id":"spn-101388","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-70367","items":[{"blocks":[{"id":"blk-70369","kind":"paragraph","spans":[{"id":"spn-101389","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-70368","kind":"list-item"},{"blocks":[{"id":"blk-70371","kind":"paragraph","spans":[{"id":"spn-101390","text":"Store contradicting facts → verify "},{"id":"spn-101391","marks":["code"],"text":":contradicts"},{"id":"spn-101392","text":" edges form SCC"}]}],"id":"blk-70370","kind":"list-item"},{"blocks":[{"id":"blk-70373","kind":"paragraph","spans":[{"id":"spn-101393","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-70372","kind":"list-item"},{"blocks":[{"id":"blk-70375","kind":"paragraph","spans":[{"id":"spn-101394","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-70374","kind":"list-item"},{"blocks":[{"id":"blk-70377","kind":"paragraph","spans":[{"id":"spn-101395","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-70376","kind":"list-item"},{"blocks":[{"id":"blk-70379","kind":"paragraph","spans":[{"id":"spn-101396","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-70378","kind":"list-item"},{"blocks":[{"id":"blk-70381","kind":"paragraph","spans":[{"id":"spn-101397","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-70380","kind":"list-item"},{"blocks":[{"id":"blk-70383","kind":"paragraph","spans":[{"id":"spn-101398","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-70382","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70384","kind":"paragraph","spans":[{"id":"spn-101399","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-70385","items":[{"blocks":[{"id":"blk-70387","kind":"paragraph","spans":[{"id":"spn-101400","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-70386","kind":"list-item"},{"blocks":[{"id":"blk-70389","kind":"paragraph","spans":[{"id":"spn-101401","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-70388","kind":"list-item"},{"blocks":[{"id":"blk-70391","kind":"paragraph","spans":[{"id":"spn-101402","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-70390","kind":"list-item"},{"blocks":[{"id":"blk-70393","kind":"paragraph","spans":[{"id":"spn-101403","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-70392","kind":"list-item"},{"blocks":[{"id":"blk-70395","kind":"paragraph","spans":[{"id":"spn-101404","text":"Detect contradictions via explicit "},{"id":"spn-101405","marks":["code"],"text":":contradicts"},{"id":"spn-101406","text":" edges"}]}],"id":"blk-70394","kind":"list-item"},{"blocks":[{"id":"blk-70397","kind":"paragraph","spans":[{"id":"spn-101407","text":"Revision record created with correct fields"}]}],"id":"blk-70396","kind":"list-item"},{"blocks":[{"id":"blk-70399","kind":"paragraph","spans":[{"id":"spn-101408","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-70398","kind":"list-item"},{"blocks":[{"id":"blk-70401","kind":"paragraph","spans":[{"id":"spn-101409","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-70400","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70402","kind":"paragraph","spans":[{"id":"spn-101410","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-70403","items":[{"blocks":[{"id":"blk-70405","kind":"paragraph","spans":[{"id":"spn-101411","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-70404","kind":"list-item"},{"blocks":[{"id":"blk-70407","kind":"paragraph","spans":[{"id":"spn-101412","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-70406","kind":"list-item"},{"blocks":[{"id":"blk-70409","kind":"paragraph","spans":[{"id":"spn-101413","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-70408","kind":"list-item"},{"blocks":[{"id":"blk-70411","kind":"paragraph","spans":[{"id":"spn-101414","text":"Unresolved conflict creates "},{"id":"spn-101415","marks":["code"],"text":":contradicts"},{"id":"spn-101416","text":" edges"}]}],"id":"blk-70410","kind":"list-item"},{"blocks":[{"id":"blk-70413","kind":"paragraph","spans":[{"id":"spn-101417","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-70412","kind":"list-i