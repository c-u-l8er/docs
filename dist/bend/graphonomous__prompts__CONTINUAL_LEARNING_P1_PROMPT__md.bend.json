{"bendscript":"0.1","blocks":[{"id":"blk-71238","kind":"heading","level":1,"spans":[{"id":"spn-104102","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-71239","kind":"heading","level":2,"spans":[{"id":"spn-104103","text":"Prerequisites"}]},{"id":"blk-71240","kind":"paragraph","spans":[{"id":"spn-104104","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-71241","items":[{"blocks":[{"id":"blk-71243","kind":"paragraph","spans":[{"id":"spn-104105","text":"[ ] "},{"id":"spn-104106","marks":["code"],"text":"mix test"},{"id":"spn-104107","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-71242","kind":"list-item"},{"blocks":[{"id":"blk-71245","kind":"paragraph","spans":[{"id":"spn-104108","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-71244","kind":"list-item"},{"blocks":[{"id":"blk-71247","kind":"paragraph","spans":[{"id":"spn-104109","text":"[ ] "},{"id":"spn-104110","marks":["code"],"text":"BeliefRevision"},{"id":"spn-104111","text":" module exists with "},{"id":"spn-104112","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-71246","kind":"list-item"},{"blocks":[{"id":"blk-71249","kind":"paragraph","spans":[{"id":"spn-104113","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-71248","kind":"list-item"},{"blocks":[{"id":"blk-71251","kind":"paragraph","spans":[{"id":"spn-104114","text":"[ ] "},{"id":"spn-104115","marks":["code"],"text":":superseded_by"},{"id":"spn-104116","text":" edge type works"}]}],"id":"blk-71250","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71252","kind":"heading","level":2,"spans":[{"id":"spn-104117","text":"Session Goal"}]},{"id":"blk-71253","kind":"paragraph","spans":[{"id":"spn-104118","text":"Implement P1 capabilities: "},{"id":"spn-104119","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-104120","text":" (Q-value utility scoring), "},{"id":"spn-104121","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-104122","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-104123","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-104124","text":" (40 scenarios), and "},{"id":"spn-104125","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-104126","text":"."}]},{"id":"blk-71254","kind":"heading","level":2,"spans":[{"id":"spn-104127","text":"Active Goal"}]},{"id":"blk-71255","kind":"paragraph","spans":[{"id":"spn-104128","text":"Retrieve and update: "},{"id":"spn-104129","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-71256","kind":"heading","level":2,"spans":[{"id":"spn-104130","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-71257","kind":"heading","level":3,"spans":[{"id":"spn-104131","text":"What it does"}]},{"id":"blk-71258","kind":"paragraph","spans":[{"id":"spn-104132","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-71259","kind":"heading","level":3,"spans":[{"id":"spn-104133","text":"Research basis"}]},{"id":"blk-71260","kind":"paragraph","spans":[{"id":"spn-104134","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-71261","kind":"heading","level":3,"spans":[{"id":"spn-104135","text":"Schema migration"}]},{"id":"blk-71262","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-71263","kind":"heading","level":3,"spans":[{"id":"spn-104136","text":"File: "},{"id":"spn-104137","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-71264","kind":"paragraph","spans":[{"id":"spn-104138","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-71265","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-71266","kind":"paragraph","spans":[{"id":"spn-104139","text":"Call "},{"id":"spn-104140","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-104141","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-104142","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-104143","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-71267","kind":"heading","level":3,"spans":[{"id":"spn-104144","text":"File: "},{"id":"spn-104145","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-71268","kind":"paragraph","spans":[{"id":"spn-104146","text":"In "},{"id":"spn-104147","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-104148","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-71269","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-71270","kind":"heading","level":3,"spans":[{"id":"spn-104149","text":"File: "},{"id":"spn-104150","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-71271","kind":"paragraph","spans":[{"id":"spn-104151","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-71272","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-71273","kind":"heading","level":3,"spans":[{"id":"spn-104152","text":"Tests"}]},{"id":"blk-71274","items":[{"blocks":[{"id":"blk-71276","kind":"paragraph","spans":[{"id":"spn-104153","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-71275","kind":"list-item"},{"blocks":[{"id":"blk-71278","kind":"paragraph","spans":[{"id":"spn-104154","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-71277","kind":"list-item"},{"blocks":[{"id":"blk-71280","kind":"paragraph","spans":[{"id":"spn-104155","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-71279","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71281","kind":"heading","level":2,"spans":[{"id":"spn-104156","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-71282","kind":"heading","level":3,"spans":[{"id":"spn-104157","text":"What it does"}]},{"id":"blk-71283","kind":"paragraph","spans":[{"id":"spn-104158","text":"Two forgetting policies (not six):"}]},{"id":"blk-71284","items":[{"blocks":[{"id":"blk-71286","kind":"paragraph","spans":[{"id":"spn-104159","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-104160","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-104161","marks":["code"],"text":"max_nodes"},{"id":"spn-104162","text":". Scores each node: "},{"id":"spn-104163","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-104164","text":". Lowest-priority nodes forgotten first."}]}],"id":"blk-71285","kind":"list-item"},{"blocks":[{"id":"blk-71288","kind":"paragraph","spans":[{"id":"spn-104165","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-104166","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]}],"id":"blk-71287","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71289","kind":"heading","level":3,"spans":[{"id":"spn-104167","text":"Research basis"}]},{"id":"blk-71290","items":[{"blocks":[{"id":"blk-71292","kind":"paragraph","spans":[{"id":"spn-104168","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-71291","kind":"list-item"},{"blocks":[{"id":"blk-71294","kind":"paragraph","spans":[{"id":"spn-104169","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-71293","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71295","kind":"heading","level":3,"spans":[{"id":"spn-104170","text":"Schema migration"}]},{"id":"blk-71296","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-71297","kind":"heading","level":3,"spans":[{"id":"spn-104171","text":"New file: "},{"id":"spn-104172","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-71298","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-71299","kind":"heading","level":3,"spans":[{"id":"spn-104173","text":"New MCP tools (3)"}]},{"id":"blk-71300","items":[{"blocks":[{"id":"blk-71302","kind":"paragraph","spans":[{"id":"spn-104174","marks":["code"],"text":"forget_node"},{"id":"spn-104175","text":" — "},{"id":"spn-104176","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-71301","kind":"list-item"},{"blocks":[{"id":"blk-71304","kind":"paragraph","spans":[{"id":"spn-104177","marks":["code"],"text":"forget_by_policy"},{"id":"spn-104178","text":" — "},{"id":"spn-104179","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-71303","kind":"list-item"},{"blocks":[{"id":"blk-71306","kind":"paragraph","spans":[{"id":"spn-104180","marks":["code"],"text":"gdpr_erase"},{"id":"spn-104181","text":" — "},{"id":"spn-104182","marks":["code"],"text":"{node_id}"},{"id":"spn-104183","text":" — hard delete with audit trail"}]}],"id":"blk-71305","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71307","kind":"heading","level":3,"spans":[{"id":"spn-104184","text":"File: "},{"id":"spn-104185","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-71308","kind":"paragraph","spans":[{"id":"spn-104186","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-71309","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-71310","kind":"heading","level":3,"spans":[{"id":"spn-104187","text":"File: "},{"id":"spn-104188","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-71311","kind":"paragraph","spans":[{"id":"spn-104189","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-71312","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-71313","kind":"heading","level":3,"spans":[{"id":"spn-104190","text":"File: "},{"id":"spn-104191","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-71314","kind":"paragraph","spans":[{"id":"spn-104192","text":"Add memory pressure detection to survey:"}]},{"id":"blk-71315","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-71316","kind":"heading","level":3,"spans":[{"id":"spn-104193","text":"Tests"}]},{"id":"blk-71317","items":[{"blocks":[{"id":"blk-71319","kind":"paragraph","spans":[{"id":"spn-104194","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-71318","kind":"list-item"},{"blocks":[{"id":"blk-71321","kind":"paragraph","spans":[{"id":"spn-104195","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-71320","kind":"list-item"},{"blocks":[{"id":"blk-71323","kind":"paragraph","spans":[{"id":"spn-104196","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-71322","kind":"list-item"},{"blocks":[{"id":"blk-71325","kind":"paragraph","spans":[{"id":"spn-104197","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-71324","kind":"list-item"},{"blocks":[{"id":"blk-71327","kind":"paragraph","spans":[{"id":"spn-104198","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-71326","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71328","kind":"heading","level":2,"spans":[{"id":"spn-104199","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-71329","kind":"heading","level":3,"spans":[{"id":"spn-104200","text":"What it does"}]},{"id":"blk-71330","kind":"paragraph","spans":[{"id":"spn-104201","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-71331","kind":"paragraph","spans":[{"id":"spn-104202","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-71332","items":[{"blocks":[{"id":"blk-71334","kind":"paragraph","spans":[{"id":"spn-104203","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-71333","kind":"list-item"},{"blocks":[{"id":"blk-71336","kind":"paragraph","spans":[{"id":"spn-104204","text":"Store contradicting facts → verify "},{"id":"spn-104205","marks":["code"],"text":":contradicts"},{"id":"spn-104206","text":" edges form SCC"}]}],"id":"blk-71335","kind":"list-item"},{"blocks":[{"id":"blk-71338","kind":"paragraph","spans":[{"id":"spn-104207","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-71337","kind":"list-item"},{"blocks":[{"id":"blk-71340","kind":"paragraph","spans":[{"id":"spn-104208","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-71339","kind":"list-item"},{"blocks":[{"id":"blk-71342","kind":"paragraph","spans":[{"id":"spn-104209","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-71341","kind":"list-item"},{"blocks":[{"id":"blk-71344","kind":"paragraph","spans":[{"id":"spn-104210","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-71343","kind":"list-item"},{"blocks":[{"id":"blk-71346","kind":"paragraph","spans":[{"id":"spn-104211","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-71345","kind":"list-item"},{"blocks":[{"id":"blk-71348","kind":"paragraph","spans":[{"id":"spn-104212","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-71347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71349","kind":"paragraph","spans":[{"id":"spn-104213","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-71350","items":[{"blocks":[{"id":"blk-71352","kind":"paragraph","spans":[{"id":"spn-104214","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-71351","kind":"list-item"},{"blocks":[{"id":"blk-71354","kind":"paragraph","spans":[{"id":"spn-104215","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-71353","kind":"list-item"},{"blocks":[{"id":"blk-71356","kind":"paragraph","spans":[{"id":"spn-104216","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-71355","kind":"list-item"},{"blocks":[{"id":"blk-71358","kind":"paragraph","spans":[{"id":"spn-104217","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-71357","kind":"list-item"},{"blocks":[{"id":"blk-71360","kind":"paragraph","spans":[{"id":"spn-104218","text":"Detect contradictions via explicit "},{"id":"spn-104219","marks":["code"],"text":":contradicts"},{"id":"spn-104220","text":" edges"}]}],"id":"blk-71359","kind":"list-item"},{"blocks":[{"id":"blk-71362","kind":"paragraph","spans":[{"id":"spn-104221","text":"Revision record created with correct fields"}]}],"id":"blk-71361","kind":"list-item"},{"blocks":[{"id":"blk-71364","kind":"paragraph","spans":[{"id":"spn-104222","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-71363","kind":"list-item"},{"blocks":[{"id":"blk-71366","kind":"paragraph","spans":[{"id":"spn-104223","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-71365","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71367","kind":"paragraph","spans":[{"id":"spn-104224","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-71368","items":[{"blocks":[{"id":"blk-71370","kind":"paragraph","spans":[{"id":"spn-104225","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-71369","kind":"list-item"},{"blocks":[{"id":"blk-71372","kind":"paragraph","spans":[{"id":"spn-104226","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-71371","kind":"list-item"},{"blocks":[{"id":"blk-71374","kind":"paragraph","spans":[{"id":"spn-104227","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-71373","kind":"list-item"},{"blocks":[{"id":"blk-71376","kind":"paragraph","spans":[{"id":"spn-104228","text":"Unresolved conflict creates "},{"id":"spn-104229","marks":["code"],"text":":contradicts"},{"id":"spn-104230","text":" edges"}]}],"id":"blk-71375","kind":"list-item"},{"blocks":[{"id":"blk-71378","kind":"paragraph","spans":[{"id":"spn-104231","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-71377","kind":"list-i