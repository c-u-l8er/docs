{"bendscript":"0.1","blocks":[{"id":"blk-45204","kind":"heading","level":1,"spans":[{"id":"spn-51453","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-45205","kind":"heading","level":2,"spans":[{"id":"spn-51454","text":"Prerequisites"}]},{"id":"blk-45206","kind":"paragraph","spans":[{"id":"spn-51455","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-45207","items":[{"blocks":[{"id":"blk-45209","kind":"paragraph","spans":[{"id":"spn-51456","text":"[ ] "},{"id":"spn-51457","marks":["code"],"text":"mix test"},{"id":"spn-51458","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-45208","kind":"list-item"},{"blocks":[{"id":"blk-45211","kind":"paragraph","spans":[{"id":"spn-51459","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-45210","kind":"list-item"},{"blocks":[{"id":"blk-45213","kind":"paragraph","spans":[{"id":"spn-51460","text":"[ ] "},{"id":"spn-51461","marks":["code"],"text":"BeliefRevision"},{"id":"spn-51462","text":" module exists with "},{"id":"spn-51463","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-45212","kind":"list-item"},{"blocks":[{"id":"blk-45215","kind":"paragraph","spans":[{"id":"spn-51464","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-45214","kind":"list-item"},{"blocks":[{"id":"blk-45217","kind":"paragraph","spans":[{"id":"spn-51465","text":"[ ] "},{"id":"spn-51466","marks":["code"],"text":":superseded_by"},{"id":"spn-51467","text":" edge type works"}]}],"id":"blk-45216","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45218","kind":"heading","level":2,"spans":[{"id":"spn-51468","text":"Session Goal"}]},{"id":"blk-45219","kind":"paragraph","spans":[{"id":"spn-51469","text":"Implement P1 capabilities: "},{"id":"spn-51470","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-51471","text":" (Q-value utility scoring), "},{"id":"spn-51472","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-51473","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-51474","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-51475","text":" (40 scenarios), and "},{"id":"spn-51476","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-51477","text":"."}]},{"id":"blk-45220","kind":"heading","level":2,"spans":[{"id":"spn-51478","text":"Active Goal"}]},{"id":"blk-45221","kind":"paragraph","spans":[{"id":"spn-51479","text":"Retrieve and update: "},{"id":"spn-51480","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-45222","kind":"paragraph","spans":[{"id":"spn-51481","text":"---"}]},{"id":"blk-45223","kind":"heading","level":2,"spans":[{"id":"spn-51482","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-45224","kind":"heading","level":3,"spans":[{"id":"spn-51483","text":"What it does"}]},{"id":"blk-45225","kind":"paragraph","spans":[{"id":"spn-51484","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-45226","kind":"heading","level":3,"spans":[{"id":"spn-51485","text":"Research basis"}]},{"id":"blk-45227","kind":"paragraph","spans":[{"id":"spn-51486","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-45228","kind":"heading","level":3,"spans":[{"id":"spn-51487","text":"Schema migration"}]},{"id":"blk-45229","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-45230","kind":"heading","level":3,"spans":[{"id":"spn-51488","text":"File: "},{"id":"spn-51489","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45231","kind":"paragraph","spans":[{"id":"spn-51490","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-45232","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-45233","kind":"paragraph","spans":[{"id":"spn-51491","text":"Call "},{"id":"spn-51492","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-51493","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-51494","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-51495","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-45234","kind":"heading","level":3,"spans":[{"id":"spn-51496","text":"File: "},{"id":"spn-51497","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-45235","kind":"paragraph","spans":[{"id":"spn-51498","text":"In "},{"id":"spn-51499","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-51500","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-45236","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-45237","kind":"heading","level":3,"spans":[{"id":"spn-51501","text":"File: "},{"id":"spn-51502","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45238","kind":"paragraph","spans":[{"id":"spn-51503","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-45239","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-45240","kind":"heading","level":3,"spans":[{"id":"spn-51504","text":"Tests"}]},{"id":"blk-45241","items":[{"blocks":[{"id":"blk-45243","kind":"paragraph","spans":[{"id":"spn-51505","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-45242","kind":"list-item"},{"blocks":[{"id":"blk-45245","kind":"paragraph","spans":[{"id":"spn-51506","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-45244","kind":"list-item"},{"blocks":[{"id":"blk-45247","kind":"paragraph","spans":[{"id":"spn-51507","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-45246","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45248","kind":"paragraph","spans":[{"id":"spn-51508","text":"---"}]},{"id":"blk-45249","kind":"heading","level":2,"spans":[{"id":"spn-51509","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-45250","kind":"heading","level":3,"spans":[{"id":"spn-51510","text":"What it does"}]},{"id":"blk-45251","kind":"paragraph","spans":[{"id":"spn-51511","text":"Two forgetting policies (not six): 1. "},{"id":"spn-51512","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-51513","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-51514","marks":["code"],"text":"max_nodes"},{"id":"spn-51515","text":". Scores each node: "},{"id":"spn-51516","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-51517","text":". Lowest-priority nodes forgotten first. 2. "},{"id":"spn-51518","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-51519","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]},{"id":"blk-45252","kind":"heading","level":3,"spans":[{"id":"spn-51520","text":"Research basis"}]},{"id":"blk-45253","items":[{"blocks":[{"id":"blk-45255","kind":"paragraph","spans":[{"id":"spn-51521","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-45254","kind":"list-item"},{"blocks":[{"id":"blk-45257","kind":"paragraph","spans":[{"id":"spn-51522","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-45256","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45258","kind":"heading","level":3,"spans":[{"id":"spn-51523","text":"Schema migration"}]},{"id":"blk-45259","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-45260","kind":"heading","level":3,"spans":[{"id":"spn-51524","text":"New file: "},{"id":"spn-51525","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-45261","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-45262","kind":"heading","level":3,"spans":[{"id":"spn-51526","text":"New MCP tools (3)"}]},{"id":"blk-45263","items":[{"blocks":[{"id":"blk-45265","kind":"paragraph","spans":[{"id":"spn-51527","marks":["code"],"text":"forget_node"},{"id":"spn-51528","text":" — "},{"id":"spn-51529","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-45264","kind":"list-item"},{"blocks":[{"id":"blk-45267","kind":"paragraph","spans":[{"id":"spn-51530","marks":["code"],"text":"forget_by_policy"},{"id":"spn-51531","text":" — "},{"id":"spn-51532","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-45266","kind":"list-item"},{"blocks":[{"id":"blk-45269","kind":"paragraph","spans":[{"id":"spn-51533","marks":["code"],"text":"gdpr_erase"},{"id":"spn-51534","text":" — "},{"id":"spn-51535","marks":["code"],"text":"{node_id}"},{"id":"spn-51536","text":" — hard delete with audit trail"}]}],"id":"blk-45268","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45270","kind":"heading","level":3,"spans":[{"id":"spn-51537","text":"File: "},{"id":"spn-51538","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45271","kind":"paragraph","spans":[{"id":"spn-51539","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-45272","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-45273","kind":"heading","level":3,"spans":[{"id":"spn-51540","text":"File: "},{"id":"spn-51541","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45274","kind":"paragraph","spans":[{"id":"spn-51542","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-45275","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-45276","kind":"heading","level":3,"spans":[{"id":"spn-51543","text":"File: "},{"id":"spn-51544","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-45277","kind":"paragraph","spans":[{"id":"spn-51545","text":"Add memory pressure detection to survey:"}]},{"id":"blk-45278","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-45279","kind":"heading","level":3,"spans":[{"id":"spn-51546","text":"Tests"}]},{"id":"blk-45280","items":[{"blocks":[{"id":"blk-45282","kind":"paragraph","spans":[{"id":"spn-51547","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-45281","kind":"list-item"},{"blocks":[{"id":"blk-45284","kind":"paragraph","spans":[{"id":"spn-51548","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-45283","kind":"list-item"},{"blocks":[{"id":"blk-45286","kind":"paragraph","spans":[{"id":"spn-51549","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-45285","kind":"list-item"},{"blocks":[{"id":"blk-45288","kind":"paragraph","spans":[{"id":"spn-51550","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-45287","kind":"list-item"},{"blocks":[{"id":"blk-45290","kind":"paragraph","spans":[{"id":"spn-51551","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-45289","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45291","kind":"paragraph","spans":[{"id":"spn-51552","text":"---"}]},{"id":"blk-45292","kind":"heading","level":2,"spans":[{"id":"spn-51553","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-45293","kind":"heading","level":3,"spans":[{"id":"spn-51554","text":"What it does"}]},{"id":"blk-45294","kind":"paragraph","spans":[{"id":"spn-51555","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-45295","kind":"paragraph","spans":[{"id":"spn-51556","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-45296","items":[{"blocks":[{"id":"blk-45298","kind":"paragraph","spans":[{"id":"spn-51557","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-45297","kind":"list-item"},{"blocks":[{"id":"blk-45300","kind":"paragraph","spans":[{"id":"spn-51558","text":"Store contradicting facts → verify "},{"id":"spn-51559","marks":["code"],"text":":contradicts"},{"id":"spn-51560","text":" edges form SCC"}]}],"id":"blk-45299","kind":"list-item"},{"blocks":[{"id":"blk-45302","kind":"paragraph","spans":[{"id":"spn-51561","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-45301","kind":"list-item"},{"blocks":[{"id":"blk-45304","kind":"paragraph","spans":[{"id":"spn-51562","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-45303","kind":"list-item"},{"blocks":[{"id":"blk-45306","kind":"paragraph","spans":[{"id":"spn-51563","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-45305","kind":"list-item"},{"blocks":[{"id":"blk-45308","kind":"paragraph","spans":[{"id":"spn-51564","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-45307","kind":"list-item"},{"blocks":[{"id":"blk-45310","kind":"paragraph","spans":[{"id":"spn-51565","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-45309","kind":"list-item"},{"blocks":[{"id":"blk-45312","kind":"paragraph","spans":[{"id":"spn-51566","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-45311","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45313","kind":"paragraph","spans":[{"id":"spn-51567","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-45314","items":[{"blocks":[{"id":"blk-45316","kind":"paragraph","spans":[{"id":"spn-51568","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-45315","kind":"list-item"},{"blocks":[{"id":"blk-45318","kind":"paragraph","spans":[{"id":"spn-51569","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-45317","kind":"list-item"},{"blocks":[{"id":"blk-45320","kind":"paragraph","spans":[{"id":"spn-51570","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-45319","kind":"list-item"},{"blocks":[{"id":"blk-45322","kind":"paragraph","spans":[{"id":"spn-51571","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-45321","kind":"list-item"},{"blocks":[{"id":"blk-45324","kind":"paragraph","spans":[{"id":"spn-51572","text":"Detect contradictions via explicit "},{"id":"spn-51573","marks":["code"],"text":":contradicts"},{"id":"spn-51574","text":" edges"}]}],"id":"blk-45323","kind":"list-item"},{"blocks":[{"id":"blk-45326","kind":"paragraph","spans":[{"id":"spn-51575","text":"Revision record created with correct fields"}]}],"id":"blk-45325","kind":"list-item"},{"blocks":[{"id":"blk-45328","kind":"paragraph","spans":[{"id":"spn-51576","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-45327","kind":"list-item"},{"blocks":[{"id":"blk-45330","kind":"paragraph","spans":[{"id":"spn-51577","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-45329","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45331","kind":"paragraph","spans":[{"id":"spn-51578","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-45332","items":[{"blocks":[{"id":"blk-45334","kind":"paragraph","spans":[{"id":"spn-51579","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-45333","kind":"list-item"},{"blocks":[{"id":"blk-45336","kind":"paragraph","spans":[{"id":"spn-51580","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-45335","kind":"list-item"},{"blocks":[{"id":"blk-45338","kind":"paragraph","spans":[{"id":"spn-51581","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-45337","kind":"list-item"},{"blocks":[{"id":"blk-45340","kind":"paragraph","spans":[{"id":"spn-51582","text":"Unresolved conflict creates "},{"id":"spn-51583","marks":["code"],"text":":contradicts"},{"id":"spn-51584","text":" edges"}]}],"id":"blk-45339","kind":"list-item"},{"blocks":[{"id":"blk-45342","kind":"paragraph","spans":[{"id":"spn-51585","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-45341","kind":"list-item"},{"blocks":[{"id":"blk-45344","kind":"paragraph","spans":[{"id":"spn-51586","text":"Stage 4.5 runs between strengthen and merge"}]}],"id":"blk-45343","kind":"list-item"},{"blocks":[{"id":"blk-45346","kind":"paragraph","spans":[{"id":"spn-51587","text":"Conflict resolution doesn't interfere with Stage 5 merge (0.95 threshold)"}]}],"id":"blk-45345","kind":"list-item"},{"blocks":[{"id":"blk-45348","kind":"paragraph","spans":[{"id":"spn-51588","text":"Multiple conflicts in one consolidation cycle"}]}],"id":"blk-45347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45349","kind":"paragraph","spans":[{"id":"spn-51589","marks":["bold"],"text":"Category 4: Two-Phase Retrieval (8 scenarios)"}]},{"id":"blk-45350","items":[{"blocks":[{"id":"blk-45352","kind":"paragraph","spans":[{"id":"spn-51590","text":"Q-value updates from successful outcome increase ranking"}]}],"id":"blk-45351","kind":"list-item"},{"blocks":[{"id":"blk-45354","kind":"paragraph","spans":[{"id":"spn-51591","text":"Q-value updates from failed outcome decrease ranking"}]}],"id":"blk-45353","kind":"list-item"},{"blocks":[{"id":"blk-45356","kind":"paragraph","spans":[{"id":"spn-51592","text":"No Q-value effect when q_update_count == 0 for all candidates"}]}],"id":"blk-45355","kind":"list-item"},{"blocks":[{"id":"blk-45358","kind":"paragraph","spans":[{"id":"spn-51593","text":"Blended scoring with alpha=0.3"}]}],"id":"blk-45357","kind":"list-item"},{"blocks":[{"id":"blk-45360","kind":"paragraph","spans":[{"id":"spn-51594","text":"Q-value decay is half confidence decay rate"}]}],"id":"blk-45359","kind":"list-item"},{"blocks":[{"id":"blk-45362","kind":"paragraph","spans":[{"id":"spn-51595","text":"High-confidence but low-utility node ranks below high-utility node"}]}],"id":"blk-45361","kind":"list-item"},{"blocks":[{"id":"blk-45364","kind":"paragraph","spans":[{"id":"spn-51596","text":"Retrieve same query before and after outcome learning → verify rank change"}]}],"id":"blk-45363","kind":"list-item"},{"blocks":[{"id":"blk-45366","kind":"paragraph","spans":[{"id":"spn-51597","text":"nDCG improvement after 5 outcome cycles"}]}],"id":"blk-45365","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45367","kind":"paragraph","spans":[{"id":"spn-51598","marks":["bold"],"text":"Category 5: Intentional Forgetting (8 scenarios)"}]},{"id":"blk-45368","items":[{"blocks":[{"id":"blk-45370","kind":"paragraph","spans":[{"id":"spn-51599","text":"Soft forget excludes from retrieval"}]}],"id":"blk-45369","kind":"list-item"},{"blocks":[{"id":"blk-45372","kind":"paragraph","spans":[{"id":"spn-51600","text":"Hard forget removes node + edges"}]}],"id":"blk-45371","kind":"list-item"},{"blocks":[{"id":"blk-45374","kind":"paragraph","spans":[{"id":"spn-51601","text":"Cascade forget propagates to orphaned dependents"}]}],"id":"blk-45373","kind":"list-item"},{"blocks":[{"id":"blk-45376","kind":"paragraph","spans":[{"id":"spn-51602","text":"GDPR erase leaves no trace"}]}],"id":"blk-45375","kind":"list-item"},{"blocks":[{"id":"blk-45378","kind":"paragraph","spans":[{"id":"spn-51603","text":"Budget-aware hybrid pruning respects max_nodes"}]}],"id":"blk-45377","kind":"list-item"},{"blocks":[{"id":"blk-45380","kind":"paragraph","spans":[{"id":"spn-51604","text":"Priority scoring favors high-confidence, recent, connected nodes"}]}],"id":"blk-45379","kind":"list-item"},{"blocks":[{"id":"blk-45382","kind":"paragraph","spans":[{"id":"spn-51605","text":"Forgotten nodes don't appear in topology analysis"}]}],"id":"blk-45381","kind":"list-item"},{"blocks":[{"id":"blk-45384","kind":"paragraph","spans":[{"id":"spn-51606","text":"Memory pressure triggers forgetting in attention survey"}]}],"id":"blk-45383","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45385","kind":"heading","level":3,"spans":[{"id":"spn-51607","text":"Implementation"}]},{"id":"blk-45386","kind":"paragraph","spans":[{"id":"spn-51608","text":"New file: "},{"id":"spn-51609","marks":["code"],"text":"graphonomous/lib/mix/tasks/benchmark/capability_spec.ex"}]},{"id":"blk-45387","kind":"paragraph","spans":[{"id":"spn-51610","text":"Follow 