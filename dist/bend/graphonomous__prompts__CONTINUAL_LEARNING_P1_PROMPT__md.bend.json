{"bendscript":"0.1","blocks":[{"id":"blk-46176","kind":"heading","level":1,"spans":[{"id":"spn-53747","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-46177","kind":"heading","level":2,"spans":[{"id":"spn-53748","text":"Prerequisites"}]},{"id":"blk-46178","kind":"paragraph","spans":[{"id":"spn-53749","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-46179","items":[{"blocks":[{"id":"blk-46181","kind":"paragraph","spans":[{"id":"spn-53750","text":"[ ] "},{"id":"spn-53751","marks":["code"],"text":"mix test"},{"id":"spn-53752","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-46180","kind":"list-item"},{"blocks":[{"id":"blk-46183","kind":"paragraph","spans":[{"id":"spn-53753","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-46182","kind":"list-item"},{"blocks":[{"id":"blk-46185","kind":"paragraph","spans":[{"id":"spn-53754","text":"[ ] "},{"id":"spn-53755","marks":["code"],"text":"BeliefRevision"},{"id":"spn-53756","text":" module exists with "},{"id":"spn-53757","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-46184","kind":"list-item"},{"blocks":[{"id":"blk-46187","kind":"paragraph","spans":[{"id":"spn-53758","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-46186","kind":"list-item"},{"blocks":[{"id":"blk-46189","kind":"paragraph","spans":[{"id":"spn-53759","text":"[ ] "},{"id":"spn-53760","marks":["code"],"text":":superseded_by"},{"id":"spn-53761","text":" edge type works"}]}],"id":"blk-46188","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46190","kind":"heading","level":2,"spans":[{"id":"spn-53762","text":"Session Goal"}]},{"id":"blk-46191","kind":"paragraph","spans":[{"id":"spn-53763","text":"Implement P1 capabilities: "},{"id":"spn-53764","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-53765","text":" (Q-value utility scoring), "},{"id":"spn-53766","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-53767","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-53768","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-53769","text":" (40 scenarios), and "},{"id":"spn-53770","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-53771","text":"."}]},{"id":"blk-46192","kind":"heading","level":2,"spans":[{"id":"spn-53772","text":"Active Goal"}]},{"id":"blk-46193","kind":"paragraph","spans":[{"id":"spn-53773","text":"Retrieve and update: "},{"id":"spn-53774","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-46194","kind":"paragraph","spans":[{"id":"spn-53775","text":"---"}]},{"id":"blk-46195","kind":"heading","level":2,"spans":[{"id":"spn-53776","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-46196","kind":"heading","level":3,"spans":[{"id":"spn-53777","text":"What it does"}]},{"id":"blk-46197","kind":"paragraph","spans":[{"id":"spn-53778","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-46198","kind":"heading","level":3,"spans":[{"id":"spn-53779","text":"Research basis"}]},{"id":"blk-46199","kind":"paragraph","spans":[{"id":"spn-53780","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-46200","kind":"heading","level":3,"spans":[{"id":"spn-53781","text":"Schema migration"}]},{"id":"blk-46201","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-46202","kind":"heading","level":3,"spans":[{"id":"spn-53782","text":"File: "},{"id":"spn-53783","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-46203","kind":"paragraph","spans":[{"id":"spn-53784","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-46204","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-46205","kind":"paragraph","spans":[{"id":"spn-53785","text":"Call "},{"id":"spn-53786","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-53787","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-53788","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-53789","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-46206","kind":"heading","level":3,"spans":[{"id":"spn-53790","text":"File: "},{"id":"spn-53791","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-46207","kind":"paragraph","spans":[{"id":"spn-53792","text":"In "},{"id":"spn-53793","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-53794","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-46208","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-46209","kind":"heading","level":3,"spans":[{"id":"spn-53795","text":"File: "},{"id":"spn-53796","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-46210","kind":"paragraph","spans":[{"id":"spn-53797","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-46211","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-46212","kind":"heading","level":3,"spans":[{"id":"spn-53798","text":"Tests"}]},{"id":"blk-46213","items":[{"blocks":[{"id":"blk-46215","kind":"paragraph","spans":[{"id":"spn-53799","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-46214","kind":"list-item"},{"blocks":[{"id":"blk-46217","kind":"paragraph","spans":[{"id":"spn-53800","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-46216","kind":"list-item"},{"blocks":[{"id":"blk-46219","kind":"paragraph","spans":[{"id":"spn-53801","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-46218","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46220","kind":"paragraph","spans":[{"id":"spn-53802","text":"---"}]},{"id":"blk-46221","kind":"heading","level":2,"spans":[{"id":"spn-53803","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-46222","kind":"heading","level":3,"spans":[{"id":"spn-53804","text":"What it does"}]},{"id":"blk-46223","kind":"paragraph","spans":[{"id":"spn-53805","text":"Two forgetting policies (not six): 1. "},{"id":"spn-53806","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-53807","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-53808","marks":["code"],"text":"max_nodes"},{"id":"spn-53809","text":". Scores each node: "},{"id":"spn-53810","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-53811","text":". Lowest-priority nodes forgotten first. 2. "},{"id":"spn-53812","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-53813","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]},{"id":"blk-46224","kind":"heading","level":3,"spans":[{"id":"spn-53814","text":"Research basis"}]},{"id":"blk-46225","items":[{"blocks":[{"id":"blk-46227","kind":"paragraph","spans":[{"id":"spn-53815","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-46226","kind":"list-item"},{"blocks":[{"id":"blk-46229","kind":"paragraph","spans":[{"id":"spn-53816","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-46228","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46230","kind":"heading","level":3,"spans":[{"id":"spn-53817","text":"Schema migration"}]},{"id":"blk-46231","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-46232","kind":"heading","level":3,"spans":[{"id":"spn-53818","text":"New file: "},{"id":"spn-53819","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-46233","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-46234","kind":"heading","level":3,"spans":[{"id":"spn-53820","text":"New MCP tools (3)"}]},{"id":"blk-46235","items":[{"blocks":[{"id":"blk-46237","kind":"paragraph","spans":[{"id":"spn-53821","marks":["code"],"text":"forget_node"},{"id":"spn-53822","text":" — "},{"id":"spn-53823","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-46236","kind":"list-item"},{"blocks":[{"id":"blk-46239","kind":"paragraph","spans":[{"id":"spn-53824","marks":["code"],"text":"forget_by_policy"},{"id":"spn-53825","text":" — "},{"id":"spn-53826","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-46238","kind":"list-item"},{"blocks":[{"id":"blk-46241","kind":"paragraph","spans":[{"id":"spn-53827","marks":["code"],"text":"gdpr_erase"},{"id":"spn-53828","text":" — "},{"id":"spn-53829","marks":["code"],"text":"{node_id}"},{"id":"spn-53830","text":" — hard delete with audit trail"}]}],"id":"blk-46240","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46242","kind":"heading","level":3,"spans":[{"id":"spn-53831","text":"File: "},{"id":"spn-53832","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-46243","kind":"paragraph","spans":[{"id":"spn-53833","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-46244","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-46245","kind":"heading","level":3,"spans":[{"id":"spn-53834","text":"File: "},{"id":"spn-53835","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-46246","kind":"paragraph","spans":[{"id":"spn-53836","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-46247","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-46248","kind":"heading","level":3,"spans":[{"id":"spn-53837","text":"File: "},{"id":"spn-53838","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-46249","kind":"paragraph","spans":[{"id":"spn-53839","text":"Add memory pressure detection to survey:"}]},{"id":"blk-46250","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-46251","kind":"heading","level":3,"spans":[{"id":"spn-53840","text":"Tests"}]},{"id":"blk-46252","items":[{"blocks":[{"id":"blk-46254","kind":"paragraph","spans":[{"id":"spn-53841","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-46253","kind":"list-item"},{"blocks":[{"id":"blk-46256","kind":"paragraph","spans":[{"id":"spn-53842","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-46255","kind":"list-item"},{"blocks":[{"id":"blk-46258","kind":"paragraph","spans":[{"id":"spn-53843","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-46257","kind":"list-item"},{"blocks":[{"id":"blk-46260","kind":"paragraph","spans":[{"id":"spn-53844","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-46259","kind":"list-item"},{"blocks":[{"id":"blk-46262","kind":"paragraph","spans":[{"id":"spn-53845","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-46261","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46263","kind":"paragraph","spans":[{"id":"spn-53846","text":"---"}]},{"id":"blk-46264","kind":"heading","level":2,"spans":[{"id":"spn-53847","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-46265","kind":"heading","level":3,"spans":[{"id":"spn-53848","text":"What it does"}]},{"id":"blk-46266","kind":"paragraph","spans":[{"id":"spn-53849","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-46267","kind":"paragraph","spans":[{"id":"spn-53850","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-46268","items":[{"blocks":[{"id":"blk-46270","kind":"paragraph","spans":[{"id":"spn-53851","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-46269","kind":"list-item"},{"blocks":[{"id":"blk-46272","kind":"paragraph","spans":[{"id":"spn-53852","text":"Store contradicting facts → verify "},{"id":"spn-53853","marks":["code"],"text":":contradicts"},{"id":"spn-53854","text":" edges form SCC"}]}],"id":"blk-46271","kind":"list-item"},{"blocks":[{"id":"blk-46274","kind":"paragraph","spans":[{"id":"spn-53855","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-46273","kind":"list-item"},{"blocks":[{"id":"blk-46276","kind":"paragraph","spans":[{"id":"spn-53856","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-46275","kind":"list-item"},{"blocks":[{"id":"blk-46278","kind":"paragraph","spans":[{"id":"spn-53857","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-46277","kind":"list-item"},{"blocks":[{"id":"blk-46280","kind":"paragraph","spans":[{"id":"spn-53858","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-46279","kind":"list-item"},{"blocks":[{"id":"blk-46282","kind":"paragraph","spans":[{"id":"spn-53859","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-46281","kind":"list-item"},{"blocks":[{"id":"blk-46284","kind":"paragraph","spans":[{"id":"spn-53860","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-46283","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46285","kind":"paragraph","spans":[{"id":"spn-53861","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-46286","items":[{"blocks":[{"id":"blk-46288","kind":"paragraph","spans":[{"id":"spn-53862","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-46287","kind":"list-item"},{"blocks":[{"id":"blk-46290","kind":"paragraph","spans":[{"id":"spn-53863","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-46289","kind":"list-item"},{"blocks":[{"id":"blk-46292","kind":"paragraph","spans":[{"id":"spn-53864","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-46291","kind":"list-item"},{"blocks":[{"id":"blk-46294","kind":"paragraph","spans":[{"id":"spn-53865","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-46293","kind":"list-item"},{"blocks":[{"id":"blk-46296","kind":"paragraph","spans":[{"id":"spn-53866","text":"Detect contradictions via explicit "},{"id":"spn-53867","marks":["code"],"text":":contradicts"},{"id":"spn-53868","text":" edges"}]}],"id":"blk-46295","kind":"list-item"},{"blocks":[{"id":"blk-46298","kind":"paragraph","spans":[{"id":"spn-53869","text":"Revision record created with correct fields"}]}],"id":"blk-46297","kind":"list-item"},{"blocks":[{"id":"blk-46300","kind":"paragraph","spans":[{"id":"spn-53870","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-46299","kind":"list-item"},{"blocks":[{"id":"blk-46302","kind":"paragraph","spans":[{"id":"spn-53871","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-46301","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46303","kind":"paragraph","spans":[{"id":"spn-53872","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-46304","items":[{"blocks":[{"id":"blk-46306","kind":"paragraph","spans":[{"id":"spn-53873","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-46305","kind":"list-item"},{"blocks":[{"id":"blk-46308","kind":"paragraph","spans":[{"id":"spn-53874","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-46307","kind":"list-item"},{"blocks":[{"id":"blk-46310","kind":"paragraph","spans":[{"id":"spn-53875","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-46309","kind":"list-item"},{"blocks":[{"id":"blk-46312","kind":"paragraph","spans":[{"id":"spn-53876","text":"Unresolved conflict creates "},{"id":"spn-53877","marks":["code"],"text":":contradicts"},{"id":"spn-53878","text":" edges"}]}],"id":"blk-46311","kind":"list-item"},{"blocks":[{"id":"blk-46314","kind":"paragraph","spans":[{"id":"spn-53879","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-46313","kind":"list-item"},{"blocks":[{"id":"blk-46316","kind":"paragraph","spans":[{"id":"spn-53880","text":"Stage 4.5 runs between strengthen and merge"}