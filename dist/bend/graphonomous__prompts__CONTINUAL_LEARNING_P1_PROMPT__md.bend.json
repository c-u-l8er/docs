{"bendscript":"0.1","blocks":[{"id":"blk-78385","kind":"heading","level":1,"spans":[{"id":"spn-141839","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-78386","kind":"heading","level":2,"spans":[{"id":"spn-141840","text":"Prerequisites"}]},{"id":"blk-78387","kind":"paragraph","spans":[{"id":"spn-141841","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-78388","items":[{"blocks":[{"id":"blk-78390","kind":"paragraph","spans":[{"id":"spn-141842","text":"[ ] "},{"id":"spn-141843","marks":["code"],"text":"mix test"},{"id":"spn-141844","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-78389","kind":"list-item"},{"blocks":[{"id":"blk-78392","kind":"paragraph","spans":[{"id":"spn-141845","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-78391","kind":"list-item"},{"blocks":[{"id":"blk-78394","kind":"paragraph","spans":[{"id":"spn-141846","text":"[ ] "},{"id":"spn-141847","marks":["code"],"text":"BeliefRevision"},{"id":"spn-141848","text":" module exists with "},{"id":"spn-141849","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-78393","kind":"list-item"},{"blocks":[{"id":"blk-78396","kind":"paragraph","spans":[{"id":"spn-141850","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-78395","kind":"list-item"},{"blocks":[{"id":"blk-78398","kind":"paragraph","spans":[{"id":"spn-141851","text":"[ ] "},{"id":"spn-141852","marks":["code"],"text":":superseded_by"},{"id":"spn-141853","text":" edge type works"}]}],"id":"blk-78397","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78399","kind":"heading","level":2,"spans":[{"id":"spn-141854","text":"Session Goal"}]},{"id":"blk-78400","kind":"paragraph","spans":[{"id":"spn-141855","text":"Implement P1 capabilities: "},{"id":"spn-141856","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-141857","text":" (Q-value utility scoring), "},{"id":"spn-141858","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-141859","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-141860","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-141861","text":" (40 scenarios), and "},{"id":"spn-141862","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-141863","text":"."}]},{"id":"blk-78401","kind":"heading","level":2,"spans":[{"id":"spn-141864","text":"Active Goal"}]},{"id":"blk-78402","kind":"paragraph","spans":[{"id":"spn-141865","text":"Retrieve and update: "},{"id":"spn-141866","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-78403","kind":"heading","level":2,"spans":[{"id":"spn-141867","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-78404","kind":"heading","level":3,"spans":[{"id":"spn-141868","text":"What it does"}]},{"id":"blk-78405","kind":"paragraph","spans":[{"id":"spn-141869","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-78406","kind":"heading","level":3,"spans":[{"id":"spn-141870","text":"Research basis"}]},{"id":"blk-78407","kind":"paragraph","spans":[{"id":"spn-141871","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-78408","kind":"heading","level":3,"spans":[{"id":"spn-141872","text":"Schema migration"}]},{"id":"blk-78409","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-78410","kind":"heading","level":3,"spans":[{"id":"spn-141873","text":"File: "},{"id":"spn-141874","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-78411","kind":"paragraph","spans":[{"id":"spn-141875","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-78412","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-78413","kind":"paragraph","spans":[{"id":"spn-141876","text":"Call "},{"id":"spn-141877","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-141878","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-141879","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-141880","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-78414","kind":"heading","level":3,"spans":[{"id":"spn-141881","text":"File: "},{"id":"spn-141882","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-78415","kind":"paragraph","spans":[{"id":"spn-141883","text":"In "},{"id":"spn-141884","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-141885","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-78416","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-78417","kind":"heading","level":3,"spans":[{"id":"spn-141886","text":"File: "},{"id":"spn-141887","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-78418","kind":"paragraph","spans":[{"id":"spn-141888","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-78419","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-78420","kind":"heading","level":3,"spans":[{"id":"spn-141889","text":"Tests"}]},{"id":"blk-78421","items":[{"blocks":[{"id":"blk-78423","kind":"paragraph","spans":[{"id":"spn-141890","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-78422","kind":"list-item"},{"blocks":[{"id":"blk-78425","kind":"paragraph","spans":[{"id":"spn-141891","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-78424","kind":"list-item"},{"blocks":[{"id":"blk-78427","kind":"paragraph","spans":[{"id":"spn-141892","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-78426","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78428","kind":"heading","level":2,"spans":[{"id":"spn-141893","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-78429","kind":"heading","level":3,"spans":[{"id":"spn-141894","text":"What it does"}]},{"id":"blk-78430","kind":"paragraph","spans":[{"id":"spn-141895","text":"Two forgetting policies (not six):"}]},{"id":"blk-78431","items":[{"blocks":[{"id":"blk-78433","kind":"paragraph","spans":[{"id":"spn-141896","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-141897","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-141898","marks":["code"],"text":"max_nodes"},{"id":"spn-141899","text":". Scores each node: "},{"id":"spn-141900","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-141901","text":". Lowest-priority nodes forgotten first."}]}],"id":"blk-78432","kind":"list-item"},{"blocks":[{"id":"blk-78435","kind":"paragraph","spans":[{"id":"spn-141902","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-141903","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]}],"id":"blk-78434","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-78436","kind":"heading","level":3,"spans":[{"id":"spn-141904","text":"Research basis"}]},{"id":"blk-78437","items":[{"blocks":[{"id":"blk-78439","kind":"paragraph","spans":[{"id":"spn-141905","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-78438","kind":"list-item"},{"blocks":[{"id":"blk-78441","kind":"paragraph","spans":[{"id":"spn-141906","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-78440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78442","kind":"heading","level":3,"spans":[{"id":"spn-141907","text":"Schema migration"}]},{"id":"blk-78443","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-78444","kind":"heading","level":3,"spans":[{"id":"spn-141908","text":"New file: "},{"id":"spn-141909","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-78445","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-78446","kind":"heading","level":3,"spans":[{"id":"spn-141910","text":"New MCP tools (3)"}]},{"id":"blk-78447","items":[{"blocks":[{"id":"blk-78449","kind":"paragraph","spans":[{"id":"spn-141911","marks":["code"],"text":"forget_node"},{"id":"spn-141912","text":" — "},{"id":"spn-141913","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-78448","kind":"list-item"},{"blocks":[{"id":"blk-78451","kind":"paragraph","spans":[{"id":"spn-141914","marks":["code"],"text":"forget_by_policy"},{"id":"spn-141915","text":" — "},{"id":"spn-141916","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-78450","kind":"list-item"},{"blocks":[{"id":"blk-78453","kind":"paragraph","spans":[{"id":"spn-141917","marks":["code"],"text":"gdpr_erase"},{"id":"spn-141918","text":" — "},{"id":"spn-141919","marks":["code"],"text":"{node_id}"},{"id":"spn-141920","text":" — hard delete with audit trail"}]}],"id":"blk-78452","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78454","kind":"heading","level":3,"spans":[{"id":"spn-141921","text":"File: "},{"id":"spn-141922","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-78455","kind":"paragraph","spans":[{"id":"spn-141923","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-78456","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-78457","kind":"heading","level":3,"spans":[{"id":"spn-141924","text":"File: "},{"id":"spn-141925","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-78458","kind":"paragraph","spans":[{"id":"spn-141926","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-78459","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-78460","kind":"heading","level":3,"spans":[{"id":"spn-141927","text":"File: "},{"id":"spn-141928","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-78461","kind":"paragraph","spans":[{"id":"spn-141929","text":"Add memory pressure detection to survey:"}]},{"id":"blk-78462","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-78463","kind":"heading","level":3,"spans":[{"id":"spn-141930","text":"Tests"}]},{"id":"blk-78464","items":[{"blocks":[{"id":"blk-78466","kind":"paragraph","spans":[{"id":"spn-141931","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-78465","kind":"list-item"},{"blocks":[{"id":"blk-78468","kind":"paragraph","spans":[{"id":"spn-141932","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-78467","kind":"list-item"},{"blocks":[{"id":"blk-78470","kind":"paragraph","spans":[{"id":"spn-141933","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-78469","kind":"list-item"},{"blocks":[{"id":"blk-78472","kind":"paragraph","spans":[{"id":"spn-141934","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-78471","kind":"list-item"},{"blocks":[{"id":"blk-78474","kind":"paragraph","spans":[{"id":"spn-141935","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-78473","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78475","kind":"heading","level":2,"spans":[{"id":"spn-141936","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-78476","kind":"heading","level":3,"spans":[{"id":"spn-141937","text":"What it does"}]},{"id":"blk-78477","kind":"paragraph","spans":[{"id":"spn-141938","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-78478","kind":"paragraph","spans":[{"id":"spn-141939","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-78479","items":[{"blocks":[{"id":"blk-78481","kind":"paragraph","spans":[{"id":"spn-141940","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-78480","kind":"list-item"},{"blocks":[{"id":"blk-78483","kind":"paragraph","spans":[{"id":"spn-141941","text":"Store contradicting facts → verify "},{"id":"spn-141942","marks":["code"],"text":":contradicts"},{"id":"spn-141943","text":" edges form SCC"}]}],"id":"blk-78482","kind":"list-item"},{"blocks":[{"id":"blk-78485","kind":"paragraph","spans":[{"id":"spn-141944","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-78484","kind":"list-item"},{"blocks":[{"id":"blk-78487","kind":"paragraph","spans":[{"id":"spn-141945","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-78486","kind":"list-item"},{"blocks":[{"id":"blk-78489","kind":"paragraph","spans":[{"id":"spn-141946","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-78488","kind":"list-item"},{"blocks":[{"id":"blk-78491","kind":"paragraph","spans":[{"id":"spn-141947","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-78490","kind":"list-item"},{"blocks":[{"id":"blk-78493","kind":"paragraph","spans":[{"id":"spn-141948","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-78492","kind":"list-item"},{"blocks":[{"id":"blk-78495","kind":"paragraph","spans":[{"id":"spn-141949","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-78494","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78496","kind":"paragraph","spans":[{"id":"spn-141950","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-78497","items":[{"blocks":[{"id":"blk-78499","kind":"paragraph","spans":[{"id":"spn-141951","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-78498","kind":"list-item"},{"blocks":[{"id":"blk-78501","kind":"paragraph","spans":[{"id":"spn-141952","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-78500","kind":"list-item"},{"blocks":[{"id":"blk-78503","kind":"paragraph","spans":[{"id":"spn-141953","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-78502","kind":"list-item"},{"blocks":[{"id":"blk-78505","kind":"paragraph","spans":[{"id":"spn-141954","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-78504","kind":"list-item"},{"blocks":[{"id":"blk-78507","kind":"paragraph","spans":[{"id":"spn-141955","text":"Detect contradictions via explicit "},{"id":"spn-141956","marks":["code"],"text":":contradicts"},{"id":"spn-141957","text":" edges"}]}],"id":"blk-78506","kind":"list-item"},{"blocks":[{"id":"blk-78509","kind":"paragraph","spans":[{"id":"spn-141958","text":"Revision record created with correct fields"}]}],"id":"blk-78508","kind":"list-item"},{"blocks":[{"id":"blk-78511","kind":"paragraph","spans":[{"id":"spn-141959","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-78510","kind":"list-item"},{"blocks":[{"id":"blk-78513","kind":"paragraph","spans":[{"id":"spn-141960","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-78512","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78514","kind":"paragraph","spans":[{"id":"spn-141961","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-78515","items":[{"blocks":[{"id":"blk-78517","kind":"paragraph","spans":[{"id":"spn-141962","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-78516","kind":"list-item"},{"blocks":[{"id":"blk-78519","kind":"paragraph","spans":[{"id":"spn-141963","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-78518","kind":"list-item"},{"blocks":[{"id":"blk-78521","kind":"paragraph","spans":[{"id":"spn-141964","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-78520","kind":"list-item"},{"blocks":[{"id":"blk-78523","kind":"paragraph","spans":[{"id":"spn-141965","text":"Unresolved conflict creates "},{"id":"spn-141966","marks":["code"],"text":":contradicts"},{"id":"spn-141967","text":" edges"}]}],"id":"blk-78522","kind":"list-item"},{"blocks":[{"id":"blk-78525","kind":"paragraph","spans":[{"id":"spn-141968","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-78524","kind":"list-i