{"bendscript":"0.1","blocks":[{"id":"blk-70410","kind":"heading","level":1,"spans":[{"id":"spn-101489","text":"Graphonomous v0.3 — P1 Implementation Prompt (Week 3-4)"}]},{"id":"blk-70411","kind":"heading","level":2,"spans":[{"id":"spn-101490","text":"Prerequisites"}]},{"id":"blk-70412","kind":"paragraph","spans":[{"id":"spn-101491","text":"P0 must be complete before starting P1. Verify:"}]},{"id":"blk-70413","items":[{"blocks":[{"id":"blk-70415","kind":"paragraph","spans":[{"id":"spn-101492","text":"[ ] "},{"id":"spn-101493","marks":["code"],"text":"mix test"},{"id":"spn-101494","text":" passes (240+ existing + new P0 tests)"}]}],"id":"blk-70414","kind":"list-item"},{"blocks":[{"id":"blk-70417","kind":"paragraph","spans":[{"id":"spn-101495","text":"[ ] kappa > 0 appears on at least some retrieval queries"}]}],"id":"blk-70416","kind":"list-item"},{"blocks":[{"id":"blk-70419","kind":"paragraph","spans":[{"id":"spn-101496","text":"[ ] "},{"id":"spn-101497","marks":["code"],"text":"BeliefRevision"},{"id":"spn-101498","text":" module exists with "},{"id":"spn-101499","marks":["code"],"text":"expand/revise/contract/detect_contradictions"}]}],"id":"blk-70418","kind":"list-item"},{"blocks":[{"id":"blk-70421","kind":"paragraph","spans":[{"id":"spn-101500","text":"[ ] Consolidator Stage 4.5 (conflict resolution) is operational"}]}],"id":"blk-70420","kind":"list-item"},{"blocks":[{"id":"blk-70423","kind":"paragraph","spans":[{"id":"spn-101501","text":"[ ] "},{"id":"spn-101502","marks":["code"],"text":":superseded_by"},{"id":"spn-101503","text":" edge type works"}]}],"id":"blk-70422","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70424","kind":"heading","level":2,"spans":[{"id":"spn-101504","text":"Session Goal"}]},{"id":"blk-70425","kind":"paragraph","spans":[{"id":"spn-101505","text":"Implement P1 capabilities: "},{"id":"spn-101506","marks":["bold"],"text":"two-phase retrieval"},{"id":"spn-101507","text":" (Q-value utility scoring), "},{"id":"spn-101508","marks":["bold"],"text":"simplified forgetting"},{"id":"spn-101509","text":" (budget-aware hybrid pruning + GDPR hard delete), "},{"id":"spn-101510","marks":["bold"],"text":"GraphMemBench Phase 1"},{"id":"spn-101511","text":" (40 scenarios), and "},{"id":"spn-101512","marks":["bold"],"text":"LongMemEval re-benchmark"},{"id":"spn-101513","text":"."}]},{"id":"blk-70426","kind":"heading","level":2,"spans":[{"id":"spn-101514","text":"Active Goal"}]},{"id":"blk-70427","kind":"paragraph","spans":[{"id":"spn-101515","text":"Retrieve and update: "},{"id":"spn-101516","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-70428","kind":"heading","level":2,"spans":[{"id":"spn-101517","text":"Capability 4: Two-Phase Retrieval (2 days)"}]},{"id":"blk-70429","kind":"heading","level":3,"spans":[{"id":"spn-101518","text":"What it does"}]},{"id":"blk-70430","kind":"paragraph","spans":[{"id":"spn-101519","text":"Adds a second ranking phase to retrieval: after semantic similarity scoring, re-rank by Q-value (outcome utility). Nodes that have historically contributed to successful outcomes rank higher; nodes that led to failures rank lower."}]},{"id":"blk-70431","kind":"heading","level":3,"spans":[{"id":"spn-101520","text":"Research basis"}]},{"id":"blk-70432","kind":"paragraph","spans":[{"id":"spn-101521","text":"MemRL (arxiv 2601.03192) demonstrates semantic + utility outperforms semantic-only. We use Bayesian updates instead of RL training — simpler, interpretable, already in the codebase."}]},{"id":"blk-70433","kind":"heading","level":3,"spans":[{"id":"spn-101522","text":"Schema migration"}]},{"id":"blk-70434","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN q_value REAL DEFAULT 0.5;\nALTER TABLE nodes ADD COLUMN q_update_count INTEGER DEFAULT 0;"},{"id":"blk-70435","kind":"heading","level":3,"spans":[{"id":"spn-101523","text":"File: "},{"id":"spn-101524","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-70436","kind":"paragraph","spans":[{"id":"spn-101525","text":"After existing ranking pipeline, add Phase 2:"}]},{"id":"blk-70437","kind":"code","language":"elixir","text":"defp utility_rerank(ranked, opts) do\n  alpha = Keyword.get(opts, :utility_weight, 0.3)\n\n  ranked\n  |> Enum.map(fn entry ->\n    q = Store.get_q_value(entry.node_id) || 0.5\n    blended = (1.0 - alpha) * entry.score + alpha * q\n    %{entry | score: blended, metadata: Map.put(entry.metadata || %{}, :utility, q)}\n  end)\n  |> Enum.sort_by(& &1.score, :desc)\nend"},{"id":"blk-70438","kind":"paragraph","spans":[{"id":"spn-101526","text":"Call "},{"id":"spn-101527","marks":["code"],"text":"utility_rerank/2"},{"id":"spn-101528","text":" after the existing scoring in the retrieval pipeline. Skip when "},{"id":"spn-101529","marks":["code"],"text":"q_update_count == 0"},{"id":"spn-101530","text":" for all candidates (no outcome data yet — avoids changing behavior until outcomes exist)."}]},{"id":"blk-70439","kind":"heading","level":3,"spans":[{"id":"spn-101531","text":"File: "},{"id":"spn-101532","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-70440","kind":"paragraph","spans":[{"id":"spn-101533","text":"In "},{"id":"spn-101534","marks":["code"],"text":"update_node_from_outcome/3"},{"id":"spn-101535","text":", after updating confidence, also update Q-value:"}]},{"id":"blk-70441","kind":"code","language":"elixir","text":"q_learning_rate = 0.3  # Faster than confidence learning rate (0.2)\nreward = case status do\n  :success -> 1.0\n  :partial_success -> 0.65\n  :failure -> 0.0\n  :timeout -> 0.25\nend\n\nnew_q = old_q + q_learning_rate * (reward - old_q)\nStore.update_q_value(node_id, new_q, q_update_count + 1)"},{"id":"blk-70442","kind":"heading","level":3,"spans":[{"id":"spn-101536","text":"File: "},{"id":"spn-101537","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-70443","kind":"paragraph","spans":[{"id":"spn-101538","text":"In Stage 1 (decay), decay Q-values at HALF the confidence decay rate:"}]},{"id":"blk-70444","kind":"code","language":"elixir","text":"q_decay = node.decay_rate * 0.5\nnew_q = node.q_value * (1.0 - q_decay)"},{"id":"blk-70445","kind":"heading","level":3,"spans":[{"id":"spn-101539","text":"Tests"}]},{"id":"blk-70446","items":[{"blocks":[{"id":"blk-70448","kind":"paragraph","spans":[{"id":"spn-101540","text":"Store 10 nodes. Mark 3 as causal in successful outcome, 2 in failed outcome. Verify re-ranking promotes successful nodes."}]}],"id":"blk-70447","kind":"list-item"},{"blocks":[{"id":"blk-70450","kind":"paragraph","spans":[{"id":"spn-101541","text":"Verify Q-values don't affect ranking when no outcomes exist (q_update_count == 0)."}]}],"id":"blk-70449","kind":"list-item"},{"blocks":[{"id":"blk-70452","kind":"paragraph","spans":[{"id":"spn-101542","text":"Verify Q-value decay is slower than confidence decay."}]}],"id":"blk-70451","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70453","kind":"heading","level":2,"spans":[{"id":"spn-101543","text":"Capability 5: Simplified Forgetting (3 days)"}]},{"id":"blk-70454","kind":"heading","level":3,"spans":[{"id":"spn-101544","text":"What it does"}]},{"id":"blk-70455","kind":"paragraph","spans":[{"id":"spn-101545","text":"Two forgetting policies (not six):"}]},{"id":"blk-70456","items":[{"blocks":[{"id":"blk-70458","kind":"paragraph","spans":[{"id":"spn-101546","marks":["bold"],"text":"Budget-aware hybrid pruning"},{"id":"spn-101547","text":" — combines LRU + priority-decay. Triggers when node count exceeds "},{"id":"spn-101548","marks":["code"],"text":"max_nodes"},{"id":"spn-101549","text":". Scores each node: "},{"id":"spn-101550","marks":["code"],"text":"priority = confidence * recency_factor * (1 + log(access_count + 1))"},{"id":"spn-101551","text":". Lowest-priority nodes forgotten first."}]}],"id":"blk-70457","kind":"list-item"},{"blocks":[{"id":"blk-70460","kind":"paragraph","spans":[{"id":"spn-101552","marks":["bold"],"text":"Governance-gated hard delete"},{"id":"spn-101553","text":" — UtU-style constant-time cascade deletion. Severs all edges, deletes node. Audit-logged. For GDPR compliance."}]}],"id":"blk-70459","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-70461","kind":"heading","level":3,"spans":[{"id":"spn-101554","text":"Research basis"}]},{"id":"blk-70462","items":[{"blocks":[{"id":"blk-70464","kind":"paragraph","spans":[{"id":"spn-101555","text":"FiFA (arxiv 2512.12856): hybrid policy achieves 0.911 composite score. LRU + priority-decay are the two most effective components."}]}],"id":"blk-70463","kind":"list-item"},{"blocks":[{"id":"blk-70466","kind":"paragraph","spans":[{"id":"spn-101556","text":"UtU (arxiv 2402.10695): constant-time graph unlearning via edge unlinking, 97.3% privacy protection."}]}],"id":"blk-70465","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70467","kind":"heading","level":3,"spans":[{"id":"spn-101557","text":"Schema migration"}]},{"id":"blk-70468","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN forgotten_at TEXT;\n\nCREATE TABLE IF NOT EXISTS forgetting_config (\n  id TEXT PRIMARY KEY DEFAULT 'default',\n  policy TEXT NOT NULL DEFAULT 'hybrid',\n  max_nodes INTEGER DEFAULT 10000,\n  max_age_hours INTEGER DEFAULT 720,\n  updated_at TEXT NOT NULL\n);"},{"id":"blk-70469","kind":"heading","level":3,"spans":[{"id":"spn-101558","text":"New file: "},{"id":"spn-101559","marks":["code"],"text":"graphonomous/lib/graphonomous/forgetter.ex"}]},{"id":"blk-70470","kind":"code","language":"elixir","text":"defmodule Graphonomous.Forgetter do\n  @moduledoc \"\"\"\n  Policy-driven intentional forgetting with governance integration.\n  Two policies: hybrid pruning (LRU + priority-decay) and GDPR hard delete.\n  \"\"\"\n\n  @type forget_mode :: :soft | :hard | :cascade\n\n  def forget(node_id, mode \\\\ :soft, opts \\\\ [])\n  # :soft — set forgotten_at timestamp, exclude from retrieval, keep structure\n  # :hard — delete node + all edges (UtU constant-time unlink)\n  # :cascade — hard delete + propagate to nodes whose ONLY support is this node\n\n  def forget_by_policy(policy \\\\ :hybrid, opts \\\\ [])\n  # :hybrid — score all nodes by priority, forget lowest until under max_nodes\n  # Returns {forgotten_count, surviving_count}\n\n  def gdpr_erase(node_id)\n  # Hard delete with audit record. No recovery. Requires OS-006 act-level autonomy.\n\n  def candidates(policy \\\\ :hybrid, opts \\\\ [])\n  # Dry run: return nodes that WOULD be forgotten, sorted by priority ascending\n\n  def priority_score(node) do\n    recency = recency_factor(node.access_recency)  # 1.0 for recent, decays to 0.0\n    confidence = node.confidence\n    access = 1.0 + :math.log(node.access_count + 1)\n    connectivity = edge_count(node.id) / max_edge_count()  # 0.0 to 1.0\n\n    confidence * recency * access * (1.0 + connectivity)\n  end\nend"},{"id":"blk-70471","kind":"heading","level":3,"spans":[{"id":"spn-101560","text":"New MCP tools (3)"}]},{"id":"blk-70472","items":[{"blocks":[{"id":"blk-70474","kind":"paragraph","spans":[{"id":"spn-101561","marks":["code"],"text":"forget_node"},{"id":"spn-101562","text":" — "},{"id":"spn-101563","marks":["code"],"text":"{node_id, mode: \"soft\"|\"hard\"|\"cascade\", reason: string}"}]}],"id":"blk-70473","kind":"list-item"},{"blocks":[{"id":"blk-70476","kind":"paragraph","spans":[{"id":"spn-101564","marks":["code"],"text":"forget_by_policy"},{"id":"spn-101565","text":" — "},{"id":"spn-101566","marks":["code"],"text":"{policy: \"hybrid\", dry_run: boolean, max_nodes: integer}"}]}],"id":"blk-70475","kind":"list-item"},{"blocks":[{"id":"blk-70478","kind":"paragraph","spans":[{"id":"spn-101567","marks":["code"],"text":"gdpr_erase"},{"id":"spn-101568","text":" — "},{"id":"spn-101569","marks":["code"],"text":"{node_id}"},{"id":"spn-101570","text":" — hard delete with audit trail"}]}],"id":"blk-70477","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70479","kind":"heading","level":3,"spans":[{"id":"spn-101571","text":"File: "},{"id":"spn-101572","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-70480","kind":"paragraph","spans":[{"id":"spn-101573","text":"Replace Stage 2 (prune weak nodes) with:"}]},{"id":"blk-70481","kind":"code","language":"elixir","text":"defp stage_prune_nodes(state) do\n  config = Forgetter.get_config()\n  node_count = Store.count_nodes()\n\n  if node_count > config.max_nodes do\n    {:ok, result} = Forgetter.forget_by_policy(:hybrid, max_nodes: config.max_nodes)\n    emit_telemetry(:pruned_nodes, %{count: result.forgotten_count, policy: :hybrid})\n  else\n    # Fall back to existing confidence threshold pruning\n    existing_prune_logic(state)\n  end\nend"},{"id":"blk-70482","kind":"heading","level":3,"spans":[{"id":"spn-101574","text":"File: "},{"id":"spn-101575","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-70483","kind":"paragraph","spans":[{"id":"spn-101576","text":"Filter out soft-forgotten nodes in retrieval:"}]},{"id":"blk-70484","kind":"code","language":"elixir","text":"# In the retrieval query, add: WHERE forgotten_at IS NULL"},{"id":"blk-70485","kind":"heading","level":3,"spans":[{"id":"spn-101577","text":"File: "},{"id":"spn-101578","marks":["code"],"text":"graphonomous/lib/graphonomous/attention.ex"}]},{"id":"blk-70486","kind":"paragraph","spans":[{"id":"spn-101579","text":"Add memory pressure detection to survey:"}]},{"id":"blk-70487","kind":"code","language":"elixir","text":"defp check_memory_pressure() do\n  config = Forgetter.get_config()\n  count = Store.count_nodes()\n  if count > config.max_nodes * 0.9 do\n    %{type: :memory_pressure, severity: :warning, node_count: count, max: config.max_nodes}\n  end\nend"},{"id":"blk-70488","kind":"heading","level":3,"spans":[{"id":"spn-101580","text":"Tests"}]},{"id":"blk-70489","items":[{"blocks":[{"id":"blk-70491","kind":"paragraph","spans":[{"id":"spn-101581","text":"Fill graph with 500 nodes of varying confidence/recency/access. Run hybrid forgetting with max_nodes=200. Verify high-priority nodes survive."}]}],"id":"blk-70490","kind":"list-item"},{"blocks":[{"id":"blk-70493","kind":"paragraph","spans":[{"id":"spn-101582","text":"Test GDPR erase removes node + all edges completely."}]}],"id":"blk-70492","kind":"list-item"},{"blocks":[{"id":"blk-70495","kind":"paragraph","spans":[{"id":"spn-101583","text":"Test soft forget excludes from retrieval but preserves structure."}]}],"id":"blk-70494","kind":"list-item"},{"blocks":[{"id":"blk-70497","kind":"paragraph","spans":[{"id":"spn-101584","text":"Test cascade forget propagates to orphaned dependents."}]}],"id":"blk-70496","kind":"list-item"},{"blocks":[{"id":"blk-70499","kind":"paragraph","spans":[{"id":"spn-101585","text":"Test retrieval filters out forgotten nodes."}]}],"id":"blk-70498","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70500","kind":"heading","level":2,"spans":[{"id":"spn-101586","text":"Capability 6: GraphMemBench Phase 1 (3 days)"}]},{"id":"blk-70501","kind":"heading","level":3,"spans":[{"id":"spn-101587","text":"What it does"}]},{"id":"blk-70502","kind":"paragraph","spans":[{"id":"spn-101588","text":"40 test scenarios across 5 categories (8 each) validating P0+P1 capabilities:"}]},{"id":"blk-70503","kind":"paragraph","spans":[{"id":"spn-101589","marks":["bold"],"text":"Category 1: Kappa Activation (8 scenarios)"}]},{"id":"blk-70504","items":[{"blocks":[{"id":"blk-70506","kind":"paragraph","spans":[{"id":"spn-101590","text":"Store nodes with mutual references → verify kappa >= 1"}]}],"id":"blk-70505","kind":"list-item"},{"blocks":[{"id":"blk-70508","kind":"paragraph","spans":[{"id":"spn-101591","text":"Store contradicting facts → verify "},{"id":"spn-101592","marks":["code"],"text":":contradicts"},{"id":"spn-101593","text":" edges form SCC"}]}],"id":"blk-70507","kind":"list-item"},{"blocks":[{"id":"blk-70510","kind":"paragraph","spans":[{"id":"spn-101594","text":"Retrieve with expanded topology window → verify neighbor inclusion"}]}],"id":"blk-70509","kind":"list-item"},{"blocks":[{"id":"blk-70512","kind":"paragraph","spans":[{"id":"spn-101595","text":"Verify semantic back-references create reverse edges"}]}],"id":"blk-70511","kind":"list-item"},{"blocks":[{"id":"blk-70514","kind":"paragraph","spans":[{"id":"spn-101596","text":"Test kappa computation on 2-node, 3-node, and N-node SCCs"}]}],"id":"blk-70513","kind":"list-item"},{"blocks":[{"id":"blk-70516","kind":"paragraph","spans":[{"id":"spn-101597","text":"Test that kappa=0 fast path still works for acyclic subgraphs"}]}],"id":"blk-70515","kind":"list-item"},{"blocks":[{"id":"blk-70518","kind":"paragraph","spans":[{"id":"spn-101598","text":"Test deliberation triggers when kappa > 0"}]}],"id":"blk-70517","kind":"list-item"},{"blocks":[{"id":"blk-70520","kind":"paragraph","spans":[{"id":"spn-101599","text":"End-to-end: ingest file pair with mutual imports → retrieve → verify kappa > 0"}]}],"id":"blk-70519","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70521","kind":"paragraph","spans":[{"id":"spn-101600","marks":["bold"],"text":"Category 2: Belief Revision (8 scenarios)"}]},{"id":"blk-70522","items":[{"blocks":[{"id":"blk-70524","kind":"paragraph","spans":[{"id":"spn-101601","text":"Expand: store new belief, no contradiction → clean expansion"}]}],"id":"blk-70523","kind":"list-item"},{"blocks":[{"id":"blk-70526","kind":"paragraph","spans":[{"id":"spn-101602","text":"Revise: store contradicting belief → verify supersedes edge + confidence propagation"}]}],"id":"blk-70525","kind":"list-item"},{"blocks":[{"id":"blk-70528","kind":"paragraph","spans":[{"id":"spn-101603","text":"Contract: remove belief → verify dependent confidence reduction"}]}],"id":"blk-70527","kind":"list-item"},{"blocks":[{"id":"blk-70530","kind":"paragraph","spans":[{"id":"spn-101604","text":"Detect contradictions via semantic similarity"}]}],"id":"blk-70529","kind":"list-item"},{"blocks":[{"id":"blk-70532","kind":"paragraph","spans":[{"id":"spn-101605","text":"Detect contradictions via explicit "},{"id":"spn-101606","marks":["code"],"text":":contradicts"},{"id":"spn-101607","text":" edges"}]}],"id":"blk-70531","kind":"list-item"},{"blocks":[{"id":"blk-70534","kind":"paragraph","spans":[{"id":"spn-101608","text":"Revision record created with correct fields"}]}],"id":"blk-70533","kind":"list-item"},{"blocks":[{"id":"blk-70536","kind":"paragraph","spans":[{"id":"spn-101609","text":"Pluggable hook receives contradiction notification"}]}],"id":"blk-70535","kind":"list-item"},{"blocks":[{"id":"blk-70538","kind":"paragraph","spans":[{"id":"spn-101610","text":"Chain revision: A superseded by B superseded by C → verify provenance chain"}]}],"id":"blk-70537","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70539","kind":"paragraph","spans":[{"id":"spn-101611","marks":["bold"],"text":"Category 3: Conflict-Aware Consolidation (8 scenarios)"}]},{"id":"blk-70540","items":[{"blocks":[{"id":"blk-70542","kind":"paragraph","spans":[{"id":"spn-101612","text":"High-similarity, divergent-confidence pair tagged during retrieval"}]}],"id":"blk-70541","kind":"list-item"},{"blocks":[{"id":"blk-70544","kind":"paragraph","spans":[{"id":"spn-101613","text":"Conflict resolved by temporal heuristic (newer wins)"}]}],"id":"blk-70543","kind":"list-item"},{"blocks":[{"id":"blk-70546","kind":"paragraph","spans":[{"id":"spn-101614","text":"Conflict resolved by evidence heuristic (more outcomes wins)"}]}],"id":"blk-70545","kind":"list-item"},{"blocks":[{"id":"blk-70548","kind":"paragraph","spans":[{"id":"spn-101615","text":"Unresolved conflict creates "},{"id":"spn-101616","marks":["code"],"text":":contradicts"},{"id":"spn-101617","text":" edges"}]}],"id":"blk-70547","kind":"list-item"},{"blocks":[{"id":"blk-70550","kind":"paragraph","spans":[{"id":"spn-101618","text":"Unresolved conflict escalates to attention"}]}],"id":"blk-70549","kind":"list-i