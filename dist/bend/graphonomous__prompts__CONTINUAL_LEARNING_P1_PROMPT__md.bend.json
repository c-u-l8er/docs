,"id":"blk-46337","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46339","kind":"paragraph","spans":[{"id":"spn-53892","marks":["bold"],"text":"Category 5: Intentional Forgetting (8 scenarios)"}]},{"id":"blk-46340","items":[{"blocks":[{"id":"blk-46342","kind":"paragraph","spans":[{"id":"spn-53893","text":"Soft forget excludes from retrieval"}]}],"id":"blk-46341","kind":"list-item"},{"blocks":[{"id":"blk-46344","kind":"paragraph","spans":[{"id":"spn-53894","text":"Hard forget removes node + edges"}]}],"id":"blk-46343","kind":"list-item"},{"blocks":[{"id":"blk-46346","kind":"paragraph","spans":[{"id":"spn-53895","text":"Cascade forget propagates to orphaned dependents"}]}],"id":"blk-46345","kind":"list-item"},{"blocks":[{"id":"blk-46348","kind":"paragraph","spans":[{"id":"spn-53896","text":"GDPR erase leaves no trace"}]}],"id":"blk-46347","kind":"list-item"},{"blocks":[{"id":"blk-46350","kind":"paragraph","spans":[{"id":"spn-53897","text":"Budget-aware hybrid pruning respects max_nodes"}]}],"id":"blk-46349","kind":"list-item"},{"blocks":[{"id":"blk-46352","kind":"paragraph","spans":[{"id":"spn-53898","text":"Priority scoring favors high-confidence, recent, connected nodes"}]}],"id":"blk-46351","kind":"list-item"},{"blocks":[{"id":"blk-46354","kind":"paragraph","spans":[{"id":"spn-53899","text":"Forgotten nodes don't appear in topology analysis"}]}],"id":"blk-46353","kind":"list-item"},{"blocks":[{"id":"blk-46356","kind":"paragraph","spans":[{"id":"spn-53900","text":"Memory pressure triggers forgetting in attention survey"}]}],"id":"blk-46355","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46357","kind":"heading","level":3,"spans":[{"id":"spn-53901","text":"Implementation"}]},{"id":"blk-46358","kind":"paragraph","spans":[{"id":"spn-53902","text":"New file: "},{"id":"spn-53903","marks":["code"],"text":"graphonomous/lib/mix/tasks/benchmark/capability_spec.ex"}]},{"id":"blk-46359","kind":"paragraph","spans":[{"id":"spn-53904","text":"Follow 