{"bendscript":"0.1","blocks":[{"id":"blk-67275","kind":"heading","level":1,"spans":[{"id":"spn-97892","text":"Epistemic Frontier — Uncertainty-Guided Investigation"}]},{"id":"blk-67276","kind":"paragraph","spans":[{"id":"spn-97893","text":"Find nodes where investigation would most reduce graph uncertainty."}]},{"id":"blk-67277","kind":"heading","level":2,"spans":[{"id":"spn-97894","text":"Arguments"}]},{"id":"blk-67278","kind":"paragraph","spans":[{"id":"spn-97895","text":"Optional parameters: $ARGUMENTS"}]},{"id":"blk-67279","kind":"heading","level":2,"spans":[{"id":"spn-97896","text":"Query the Frontier"}]},{"id":"blk-67280","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"},{"id":"blk-67281","kind":"paragraph","spans":[{"id":"spn-97897","text":"Response:"}]},{"id":"blk-67282","kind":"code","language":"json","text":"{\n  \"status\": \"ok\",\n  \"count\": 5,\n  \"frontier\": [\n    {\n      \"node_id\": \"node_abc123\",\n      \"content\": \"BM25 hybrid retrieval improves SHR by 12pp...\",\n      \"confidence\": 0.625,\n      \"evidence_count\": 1,\n      \"interval_lower\": 0.0833,\n      \"interval_upper\": 0.9683,\n      \"width\": 0.885,\n      \"information_gain\": 0.0828,\n      \"access_count\": 0\n    }\n  ]\n}"},{"id":"blk-67283","kind":"paragraph","spans":[{"id":"spn-97898","marks":["bold"],"text":"Key fields:"}]},{"id":"blk-67284","items":[{"blocks":[{"id":"blk-67286","kind":"paragraph","spans":[{"id":"spn-97899","marks":["code"],"text":"interval_lower"},{"id":"spn-97900","text":" / "},{"id":"spn-97901","marks":["code"],"text":"interval_upper"},{"id":"spn-97902","text":" — Wilson score 95% confidence bounds"}]}],"id":"blk-67285","kind":"list-item"},{"blocks":[{"id":"blk-67288","kind":"paragraph","spans":[{"id":"spn-97903","marks":["code"],"text":"width"},{"id":"spn-97904","text":" — interval width (upper - lower); wider = more uncertain"}]}],"id":"blk-67287","kind":"list-item"},{"blocks":[{"id":"blk-67290","kind":"paragraph","spans":[{"id":"spn-97905","marks":["code"],"text":"information_gain"},{"id":"spn-97906","text":" — expected interval narrowing from one more evidence point"}]}],"id":"blk-67289","kind":"list-item"},{"blocks":[{"id":"blk-67292","kind":"paragraph","spans":[{"id":"spn-97907","marks":["code"],"text":"evidence_count"},{"id":"spn-97908","text":" — number of outcome observations backing this node"}]}],"id":"blk-67291","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67293","kind":"paragraph","spans":[{"id":"spn-97909","text":"Only nodes with "},{"id":"spn-97910","marks":["code"],"text":"evidence_count > 0"},{"id":"spn-97911","text":" appear on the frontier. Nodes without evidence are either current or stale, not \"uncertain\" in the statistical sense."}]},{"id":"blk-67294","kind":"heading","level":2,"spans":[{"id":"spn-97912","text":"The Investigation Loop"}]},{"id":"blk-67295","items":[{"blocks":[{"id":"blk-67297","kind":"paragraph","spans":[{"id":"spn-97913","marks":["bold"],"text":"Query frontier"},{"id":"spn-97914","text":" — "},{"id":"spn-97915","marks":["code"],"text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"}]}],"id":"blk-67296","kind":"list-item"},{"blocks":[{"id":"blk-67299","kind":"paragraph","spans":[{"id":"spn-97916","marks":["bold"],"text":"Pick highest info_gain node"},{"id":"spn-97917","text":" — investigate it (run tests, check docs, verify claims)"}]}],"id":"blk-67298","kind":"list-item"},{"blocks":[{"id":"blk-67301","kind":"paragraph","spans":[{"id":"spn-97918","marks":["bold"],"text":"Report outcome"},{"id":"spn-97919","text":" — "},{"id":"spn-97920","marks":["code"],"text":"learn(action: \"from_outcome\", causal_node_ids: [\"<frontier_node>\"], status: \"success\", ...)"}]}],"id":"blk-67300","kind":"list-item"},{"blocks":[{"id":"blk-67303","kind":"paragraph","spans":[{"id":"spn-97921","marks":["bold"],"text":"Re-query frontier"},{"id":"spn-97922","text":" — the investigated node should have narrowed or dropped off"}]}],"id":"blk-67302","kind":"list-item"},{"blocks":[{"id":"blk-67305","kind":"paragraph","spans":[{"id":"spn-97923","marks":["bold"],"text":"Repeat"},{"id":"spn-97924","text":" — each cycle reduces graph uncertainty where it matters most"}]}],"id":"blk-67304","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67306","kind":"heading","level":2,"spans":[{"id":"spn-97925","text":"Wilson Score Intervals"}]},{"id":"blk-67307","kind":"paragraph","spans":[{"id":"spn-97926","text":"The frontier uses Wilson score confidence intervals (z=1.96 for 95% confidence):"}]},{"id":"blk-67308","items":[{"blocks":[{"id":"blk-67310","kind":"paragraph","spans":[{"id":"spn-97927","marks":["bold"],"text":"1 evidence point"},{"id":"spn-97928","text":": very wide intervals (~0.89 width) regardless of confidence"}]}],"id":"blk-67309","kind":"list-item"},{"blocks":[{"id":"blk-67312","kind":"paragraph","spans":[{"id":"spn-97929","marks":["bold"],"text":"2 evidence points"},{"id":"spn-97930","text":": significantly narrower (~0.58 width)"}]}],"id":"blk-67311","kind":"list-item"},{"blocks":[{"id":"blk-67314","kind":"paragraph","spans":[{"id":"spn-97931","marks":["bold"],"text":"5+ evidence points"},{"id":"spn-97932","text":": reasonably tight bounds"}]}],"id":"blk-67313","kind":"list-item"},{"blocks":[{"id":"blk-67316","kind":"paragraph","spans":[{"id":"spn-97933","marks":["bold"],"text":"10+ evidence points"},{"id":"spn-97934","text":": converging on true confidence"}]}],"id":"blk-67315","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67317","kind":"paragraph","spans":[{"id":"spn-97935","text":"This is why the frontier is powerful: it tells you exactly where one more data point would have the biggest impact."}]},{"id":"blk-67318","kind":"heading","level":2,"spans":[{"id":"spn-97936","text":"Integration with Other Machines"}]},{"id":"blk-67319","kind":"heading","level":3,"spans":[{"id":"spn-97937","text":"Frontier + Learn"}]},{"id":"blk-67320","kind":"paragraph","spans":[{"id":"spn-97938","text":"Every "},{"id":"spn-97939","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-97940","text":" call increments "},{"id":"spn-97941","marks":["code"],"text":"evidence_count"},{"id":"spn-97942","text":" and updates "},{"id":"spn-97943","marks":["code"],"text":"confidence"},{"id":"spn-97944","text":" on causal nodes. This naturally narrows their Wilson intervals and may drop them off the frontier."}]},{"id":"blk-67321","kind":"heading","level":3,"spans":[{"id":"spn-97945","text":"Frontier + Coverage Review"}]},{"id":"blk-67322","kind":"paragraph","spans":[{"id":"spn-97946","text":"Use frontier data to inform coverage decisions:"}]},{"id":"blk-67323","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"...\", signal: \"frontier shows 3 high-uncertainty nodes in this area\")"},{"id":"blk-67324","kind":"paragraph","spans":[{"id":"spn-97947","text":"If key nodes are on the frontier, coverage review may route to "},{"id":"spn-97948","marks":["code"],"text":"learn"},{"id":"spn-97949","text":" instead of "},{"id":"spn-97950","marks":["code"],"text":"act"},{"id":"spn-97951","text":"."}]},{"id":"blk-67325","kind":"heading","level":3,"spans":[{"id":"spn-97952","text":"Frontier + Attention"}]},{"id":"blk-67326","kind":"paragraph","spans":[{"id":"spn-97953","text":"The attention engine can incorporate frontier data when prioritizing goals — goals with high-uncertainty supporting knowledge may need investigation before execution."}]},{"id":"blk-67327","kind":"heading","level":2,"spans":[{"id":"spn-97954","text":"Anti-patterns to avoid"}]},{"id":"blk-67328","items":[{"blocks":[{"id":"blk-67330","kind":"paragraph","spans":[{"id":"spn-97955","text":"Don't ignore high-information-gain nodes — they're where learning has most value"}]}],"id":"blk-67329","kind":"list-item"},{"blocks":[{"id":"blk-67332","kind":"paragraph","spans":[{"id":"spn-97956","text":"Don't assume evidence_count=0 nodes are \"fine\" — they're just not measurable yet"}]}],"id":"blk-67331","kind":"list-item"},{"blocks":[{"id":"blk-67334","kind":"paragraph","spans":[{"id":"spn-97957","text":"Don't set min_gap too low — very narrow intervals aren't worth investigating"}]}],"id":"blk-67333","kind":"list-item"},{"blocks":[{"id":"blk-67336","kind":"paragraph","spans":[{"id":"spn-97958","text":"Always report outcomes after investigating frontier nodes — that's how the frontier shrinks"}]}],"id":"blk-67335","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieran4tjjdkuphtegyq65shqt2wqm4xnaw2elt7comx6y3aoplbmx6tq","vocabulary":"ampersand.docs.fs.v1"}