{"bendscript":"0.1","blocks":[{"id":"blk-74758","kind":"heading","level":1,"spans":[{"id":"spn-137403","text":"Epistemic Frontier — Uncertainty-Guided Investigation"}]},{"id":"blk-74759","kind":"paragraph","spans":[{"id":"spn-137404","text":"Find nodes where investigation would most reduce graph uncertainty."}]},{"id":"blk-74760","kind":"heading","level":2,"spans":[{"id":"spn-137405","text":"Arguments"}]},{"id":"blk-74761","kind":"paragraph","spans":[{"id":"spn-137406","text":"Optional parameters: $ARGUMENTS"}]},{"id":"blk-74762","kind":"heading","level":2,"spans":[{"id":"spn-137407","text":"Query the Frontier"}]},{"id":"blk-74763","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"},{"id":"blk-74764","kind":"paragraph","spans":[{"id":"spn-137408","text":"Response:"}]},{"id":"blk-74765","kind":"code","language":"json","text":"{\n  \"status\": \"ok\",\n  \"count\": 5,\n  \"frontier\": [\n    {\n      \"node_id\": \"node_abc123\",\n      \"content\": \"BM25 hybrid retrieval improves SHR by 12pp...\",\n      \"confidence\": 0.625,\n      \"evidence_count\": 1,\n      \"interval_lower\": 0.0833,\n      \"interval_upper\": 0.9683,\n      \"width\": 0.885,\n      \"information_gain\": 0.0828,\n      \"access_count\": 0\n    }\n  ]\n}"},{"id":"blk-74766","kind":"paragraph","spans":[{"id":"spn-137409","marks":["bold"],"text":"Key fields:"}]},{"id":"blk-74767","items":[{"blocks":[{"id":"blk-74769","kind":"paragraph","spans":[{"id":"spn-137410","marks":["code"],"text":"interval_lower"},{"id":"spn-137411","text":" / "},{"id":"spn-137412","marks":["code"],"text":"interval_upper"},{"id":"spn-137413","text":" — Wilson score 95% confidence bounds"}]}],"id":"blk-74768","kind":"list-item"},{"blocks":[{"id":"blk-74771","kind":"paragraph","spans":[{"id":"spn-137414","marks":["code"],"text":"width"},{"id":"spn-137415","text":" — interval width (upper - lower); wider = more uncertain"}]}],"id":"blk-74770","kind":"list-item"},{"blocks":[{"id":"blk-74773","kind":"paragraph","spans":[{"id":"spn-137416","marks":["code"],"text":"information_gain"},{"id":"spn-137417","text":" — expected interval narrowing from one more evidence point"}]}],"id":"blk-74772","kind":"list-item"},{"blocks":[{"id":"blk-74775","kind":"paragraph","spans":[{"id":"spn-137418","marks":["code"],"text":"evidence_count"},{"id":"spn-137419","text":" — number of outcome observations backing this node"}]}],"id":"blk-74774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74776","kind":"paragraph","spans":[{"id":"spn-137420","text":"Only nodes with "},{"id":"spn-137421","marks":["code"],"text":"evidence_count > 0"},{"id":"spn-137422","text":" appear on the frontier. Nodes without evidence are either current or stale, not \"uncertain\" in the statistical sense."}]},{"id":"blk-74777","kind":"heading","level":2,"spans":[{"id":"spn-137423","text":"The Investigation Loop"}]},{"id":"blk-74778","items":[{"blocks":[{"id":"blk-74780","kind":"paragraph","spans":[{"id":"spn-137424","marks":["bold"],"text":"Query frontier"},{"id":"spn-137425","text":" — "},{"id":"spn-137426","marks":["code"],"text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"}]}],"id":"blk-74779","kind":"list-item"},{"blocks":[{"id":"blk-74782","kind":"paragraph","spans":[{"id":"spn-137427","marks":["bold"],"text":"Pick highest info_gain node"},{"id":"spn-137428","text":" — investigate it (run tests, check docs, verify claims)"}]}],"id":"blk-74781","kind":"list-item"},{"blocks":[{"id":"blk-74784","kind":"paragraph","spans":[{"id":"spn-137429","marks":["bold"],"text":"Report outcome"},{"id":"spn-137430","text":" — "},{"id":"spn-137431","marks":["code"],"text":"learn(action: \"from_outcome\", causal_node_ids: [\"<frontier_node>\"], status: \"success\", ...)"}]}],"id":"blk-74783","kind":"list-item"},{"blocks":[{"id":"blk-74786","kind":"paragraph","spans":[{"id":"spn-137432","marks":["bold"],"text":"Re-query frontier"},{"id":"spn-137433","text":" — the investigated node should have narrowed or dropped off"}]}],"id":"blk-74785","kind":"list-item"},{"blocks":[{"id":"blk-74788","kind":"paragraph","spans":[{"id":"spn-137434","marks":["bold"],"text":"Repeat"},{"id":"spn-137435","text":" — each cycle reduces graph uncertainty where it matters most"}]}],"id":"blk-74787","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74789","kind":"heading","level":2,"spans":[{"id":"spn-137436","text":"Wilson Score Intervals"}]},{"id":"blk-74790","kind":"paragraph","spans":[{"id":"spn-137437","text":"The frontier uses Wilson score confidence intervals (z=1.96 for 95% confidence):"}]},{"id":"blk-74791","items":[{"blocks":[{"id":"blk-74793","kind":"paragraph","spans":[{"id":"spn-137438","marks":["bold"],"text":"1 evidence point"},{"id":"spn-137439","text":": very wide intervals (~0.89 width) regardless of confidence"}]}],"id":"blk-74792","kind":"list-item"},{"blocks":[{"id":"blk-74795","kind":"paragraph","spans":[{"id":"spn-137440","marks":["bold"],"text":"2 evidence points"},{"id":"spn-137441","text":": significantly narrower (~0.58 width)"}]}],"id":"blk-74794","kind":"list-item"},{"blocks":[{"id":"blk-74797","kind":"paragraph","spans":[{"id":"spn-137442","marks":["bold"],"text":"5+ evidence points"},{"id":"spn-137443","text":": reasonably tight bounds"}]}],"id":"blk-74796","kind":"list-item"},{"blocks":[{"id":"blk-74799","kind":"paragraph","spans":[{"id":"spn-137444","marks":["bold"],"text":"10+ evidence points"},{"id":"spn-137445","text":": converging on true confidence"}]}],"id":"blk-74798","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74800","kind":"paragraph","spans":[{"id":"spn-137446","text":"This is why the frontier is powerful: it tells you exactly where one more data point would have the biggest impact."}]},{"id":"blk-74801","kind":"heading","level":2,"spans":[{"id":"spn-137447","text":"Integration with Other Machines"}]},{"id":"blk-74802","kind":"heading","level":3,"spans":[{"id":"spn-137448","text":"Frontier + Learn"}]},{"id":"blk-74803","kind":"paragraph","spans":[{"id":"spn-137449","text":"Every "},{"id":"spn-137450","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-137451","text":" call increments "},{"id":"spn-137452","marks":["code"],"text":"evidence_count"},{"id":"spn-137453","text":" and updates "},{"id":"spn-137454","marks":["code"],"text":"confidence"},{"id":"spn-137455","text":" on causal nodes. This naturally narrows their Wilson intervals and may drop them off the frontier."}]},{"id":"blk-74804","kind":"heading","level":3,"spans":[{"id":"spn-137456","text":"Frontier + Coverage Review"}]},{"id":"blk-74805","kind":"paragraph","spans":[{"id":"spn-137457","text":"Use frontier data to inform coverage decisions:"}]},{"id":"blk-74806","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"...\", signal: \"frontier shows 3 high-uncertainty nodes in this area\")"},{"id":"blk-74807","kind":"paragraph","spans":[{"id":"spn-137458","text":"If key nodes are on the frontier, coverage review may route to "},{"id":"spn-137459","marks":["code"],"text":"learn"},{"id":"spn-137460","text":" instead of "},{"id":"spn-137461","marks":["code"],"text":"act"},{"id":"spn-137462","text":"."}]},{"id":"blk-74808","kind":"heading","level":3,"spans":[{"id":"spn-137463","text":"Frontier + Attention"}]},{"id":"blk-74809","kind":"paragraph","spans":[{"id":"spn-137464","text":"The attention engine can incorporate frontier data when prioritizing goals — goals with high-uncertainty supporting knowledge may need investigation before execution."}]},{"id":"blk-74810","kind":"heading","level":2,"spans":[{"id":"spn-137465","text":"Anti-patterns to avoid"}]},{"id":"blk-74811","items":[{"blocks":[{"id":"blk-74813","kind":"paragraph","spans":[{"id":"spn-137466","text":"Don't ignore high-information-gain nodes — they're where learning has most value"}]}],"id":"blk-74812","kind":"list-item"},{"blocks":[{"id":"blk-74815","kind":"paragraph","spans":[{"id":"spn-137467","text":"Don't assume evidence_count=0 nodes are \"fine\" — they're just not measurable yet"}]}],"id":"blk-74814","kind":"list-item"},{"blocks":[{"id":"blk-74817","kind":"paragraph","spans":[{"id":"spn-137468","text":"Don't set min_gap too low — very narrow intervals aren't worth investigating"}]}],"id":"blk-74816","kind":"list-item"},{"blocks":[{"id":"blk-74819","kind":"paragraph","spans":[{"id":"spn-137469","text":"Always report outcomes after investigating frontier nodes — that's how the frontier shrinks"}]}],"id":"blk-74818","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierajnbx566iakvanz6drvibc73mftnf7uonlqb3mdurclk7dhmehh5a","vocabulary":"ampersand.docs.fs.v1"}