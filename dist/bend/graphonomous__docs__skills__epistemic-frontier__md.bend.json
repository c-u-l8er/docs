{"bendscript":"0.1","blocks":[{"id":"blk-67264","kind":"heading","level":1,"spans":[{"id":"spn-97839","text":"Epistemic Frontier — Uncertainty-Guided Investigation"}]},{"id":"blk-67265","kind":"paragraph","spans":[{"id":"spn-97840","text":"Find nodes where investigation would most reduce graph uncertainty."}]},{"id":"blk-67266","kind":"heading","level":2,"spans":[{"id":"spn-97841","text":"Arguments"}]},{"id":"blk-67267","kind":"paragraph","spans":[{"id":"spn-97842","text":"Optional parameters: $ARGUMENTS"}]},{"id":"blk-67268","kind":"heading","level":2,"spans":[{"id":"spn-97843","text":"Query the Frontier"}]},{"id":"blk-67269","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"},{"id":"blk-67270","kind":"paragraph","spans":[{"id":"spn-97844","text":"Response:"}]},{"id":"blk-67271","kind":"code","language":"json","text":"{\n  \"status\": \"ok\",\n  \"count\": 5,\n  \"frontier\": [\n    {\n      \"node_id\": \"node_abc123\",\n      \"content\": \"BM25 hybrid retrieval improves SHR by 12pp...\",\n      \"confidence\": 0.625,\n      \"evidence_count\": 1,\n      \"interval_lower\": 0.0833,\n      \"interval_upper\": 0.9683,\n      \"width\": 0.885,\n      \"information_gain\": 0.0828,\n      \"access_count\": 0\n    }\n  ]\n}"},{"id":"blk-67272","kind":"paragraph","spans":[{"id":"spn-97845","marks":["bold"],"text":"Key fields:"}]},{"id":"blk-67273","items":[{"blocks":[{"id":"blk-67275","kind":"paragraph","spans":[{"id":"spn-97846","marks":["code"],"text":"interval_lower"},{"id":"spn-97847","text":" / "},{"id":"spn-97848","marks":["code"],"text":"interval_upper"},{"id":"spn-97849","text":" — Wilson score 95% confidence bounds"}]}],"id":"blk-67274","kind":"list-item"},{"blocks":[{"id":"blk-67277","kind":"paragraph","spans":[{"id":"spn-97850","marks":["code"],"text":"width"},{"id":"spn-97851","text":" — interval width (upper - lower); wider = more uncertain"}]}],"id":"blk-67276","kind":"list-item"},{"blocks":[{"id":"blk-67279","kind":"paragraph","spans":[{"id":"spn-97852","marks":["code"],"text":"information_gain"},{"id":"spn-97853","text":" — expected interval narrowing from one more evidence point"}]}],"id":"blk-67278","kind":"list-item"},{"blocks":[{"id":"blk-67281","kind":"paragraph","spans":[{"id":"spn-97854","marks":["code"],"text":"evidence_count"},{"id":"spn-97855","text":" — number of outcome observations backing this node"}]}],"id":"blk-67280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67282","kind":"paragraph","spans":[{"id":"spn-97856","text":"Only nodes with "},{"id":"spn-97857","marks":["code"],"text":"evidence_count > 0"},{"id":"spn-97858","text":" appear on the frontier. Nodes without evidence are either current or stale, not \"uncertain\" in the statistical sense."}]},{"id":"blk-67283","kind":"heading","level":2,"spans":[{"id":"spn-97859","text":"The Investigation Loop"}]},{"id":"blk-67284","items":[{"blocks":[{"id":"blk-67286","kind":"paragraph","spans":[{"id":"spn-97860","marks":["bold"],"text":"Query frontier"},{"id":"spn-97861","text":" — "},{"id":"spn-97862","marks":["code"],"text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"}]}],"id":"blk-67285","kind":"list-item"},{"blocks":[{"id":"blk-67288","kind":"paragraph","spans":[{"id":"spn-97863","marks":["bold"],"text":"Pick highest info_gain node"},{"id":"spn-97864","text":" — investigate it (run tests, check docs, verify claims)"}]}],"id":"blk-67287","kind":"list-item"},{"blocks":[{"id":"blk-67290","kind":"paragraph","spans":[{"id":"spn-97865","marks":["bold"],"text":"Report outcome"},{"id":"spn-97866","text":" — "},{"id":"spn-97867","marks":["code"],"text":"learn(action: \"from_outcome\", causal_node_ids: [\"<frontier_node>\"], status: \"success\", ...)"}]}],"id":"blk-67289","kind":"list-item"},{"blocks":[{"id":"blk-67292","kind":"paragraph","spans":[{"id":"spn-97868","marks":["bold"],"text":"Re-query frontier"},{"id":"spn-97869","text":" — the investigated node should have narrowed or dropped off"}]}],"id":"blk-67291","kind":"list-item"},{"blocks":[{"id":"blk-67294","kind":"paragraph","spans":[{"id":"spn-97870","marks":["bold"],"text":"Repeat"},{"id":"spn-97871","text":" — each cycle reduces graph uncertainty where it matters most"}]}],"id":"blk-67293","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67295","kind":"heading","level":2,"spans":[{"id":"spn-97872","text":"Wilson Score Intervals"}]},{"id":"blk-67296","kind":"paragraph","spans":[{"id":"spn-97873","text":"The frontier uses Wilson score confidence intervals (z=1.96 for 95% confidence):"}]},{"id":"blk-67297","items":[{"blocks":[{"id":"blk-67299","kind":"paragraph","spans":[{"id":"spn-97874","marks":["bold"],"text":"1 evidence point"},{"id":"spn-97875","text":": very wide intervals (~0.89 width) regardless of confidence"}]}],"id":"blk-67298","kind":"list-item"},{"blocks":[{"id":"blk-67301","kind":"paragraph","spans":[{"id":"spn-97876","marks":["bold"],"text":"2 evidence points"},{"id":"spn-97877","text":": significantly narrower (~0.58 width)"}]}],"id":"blk-67300","kind":"list-item"},{"blocks":[{"id":"blk-67303","kind":"paragraph","spans":[{"id":"spn-97878","marks":["bold"],"text":"5+ evidence points"},{"id":"spn-97879","text":": reasonably tight bounds"}]}],"id":"blk-67302","kind":"list-item"},{"blocks":[{"id":"blk-67305","kind":"paragraph","spans":[{"id":"spn-97880","marks":["bold"],"text":"10+ evidence points"},{"id":"spn-97881","text":": converging on true confidence"}]}],"id":"blk-67304","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67306","kind":"paragraph","spans":[{"id":"spn-97882","text":"This is why the frontier is powerful: it tells you exactly where one more data point would have the biggest impact."}]},{"id":"blk-67307","kind":"heading","level":2,"spans":[{"id":"spn-97883","text":"Integration with Other Machines"}]},{"id":"blk-67308","kind":"heading","level":3,"spans":[{"id":"spn-97884","text":"Frontier + Learn"}]},{"id":"blk-67309","kind":"paragraph","spans":[{"id":"spn-97885","text":"Every "},{"id":"spn-97886","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-97887","text":" call increments "},{"id":"spn-97888","marks":["code"],"text":"evidence_count"},{"id":"spn-97889","text":" and updates "},{"id":"spn-97890","marks":["code"],"text":"confidence"},{"id":"spn-97891","text":" on causal nodes. This naturally narrows their Wilson intervals and may drop them off the frontier."}]},{"id":"blk-67310","kind":"heading","level":3,"spans":[{"id":"spn-97892","text":"Frontier + Coverage Review"}]},{"id":"blk-67311","kind":"paragraph","spans":[{"id":"spn-97893","text":"Use frontier data to inform coverage decisions:"}]},{"id":"blk-67312","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"...\", signal: \"frontier shows 3 high-uncertainty nodes in this area\")"},{"id":"blk-67313","kind":"paragraph","spans":[{"id":"spn-97894","text":"If key nodes are on the frontier, coverage review may route to "},{"id":"spn-97895","marks":["code"],"text":"learn"},{"id":"spn-97896","text":" instead of "},{"id":"spn-97897","marks":["code"],"text":"act"},{"id":"spn-97898","text":"."}]},{"id":"blk-67314","kind":"heading","level":3,"spans":[{"id":"spn-97899","text":"Frontier + Attention"}]},{"id":"blk-67315","kind":"paragraph","spans":[{"id":"spn-97900","text":"The attention engine can incorporate frontier data when prioritizing goals — goals with high-uncertainty supporting knowledge may need investigation before execution."}]},{"id":"blk-67316","kind":"heading","level":2,"spans":[{"id":"spn-97901","text":"Anti-patterns to avoid"}]},{"id":"blk-67317","items":[{"blocks":[{"id":"blk-67319","kind":"paragraph","spans":[{"id":"spn-97902","text":"Don't ignore high-information-gain nodes — they're where learning has most value"}]}],"id":"blk-67318","kind":"list-item"},{"blocks":[{"id":"blk-67321","kind":"paragraph","spans":[{"id":"spn-97903","text":"Don't assume evidence_count=0 nodes are \"fine\" — they're just not measurable yet"}]}],"id":"blk-67320","kind":"list-item"},{"blocks":[{"id":"blk-67323","kind":"paragraph","spans":[{"id":"spn-97904","text":"Don't set min_gap too low — very narrow intervals aren't worth investigating"}]}],"id":"blk-67322","kind":"list-item"},{"blocks":[{"id":"blk-67325","kind":"paragraph","spans":[{"id":"spn-97905","text":"Always report outcomes after investigating frontier nodes — that's how the frontier shrinks"}]}],"id":"blk-67324","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7r6spib3n4myce5qt6unpnur5f2ipznnuksqoozvkjiozsvtutda","vocabulary":"ampersand.docs.fs.v1"}