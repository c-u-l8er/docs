{"bendscript":"0.1","blocks":[{"id":"blk-67401","kind":"heading","level":1,"spans":[{"id":"spn-98040","text":"Epistemic Frontier — Uncertainty-Guided Investigation"}]},{"id":"blk-67402","kind":"paragraph","spans":[{"id":"spn-98041","text":"Find nodes where investigation would most reduce graph uncertainty."}]},{"id":"blk-67403","kind":"heading","level":2,"spans":[{"id":"spn-98042","text":"Arguments"}]},{"id":"blk-67404","kind":"paragraph","spans":[{"id":"spn-98043","text":"Optional parameters: $ARGUMENTS"}]},{"id":"blk-67405","kind":"heading","level":2,"spans":[{"id":"spn-98044","text":"Query the Frontier"}]},{"id":"blk-67406","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"},{"id":"blk-67407","kind":"paragraph","spans":[{"id":"spn-98045","text":"Response:"}]},{"id":"blk-67408","kind":"code","language":"json","text":"{\n  \"status\": \"ok\",\n  \"count\": 5,\n  \"frontier\": [\n    {\n      \"node_id\": \"node_abc123\",\n      \"content\": \"BM25 hybrid retrieval improves SHR by 12pp...\",\n      \"confidence\": 0.625,\n      \"evidence_count\": 1,\n      \"interval_lower\": 0.0833,\n      \"interval_upper\": 0.9683,\n      \"width\": 0.885,\n      \"information_gain\": 0.0828,\n      \"access_count\": 0\n    }\n  ]\n}"},{"id":"blk-67409","kind":"paragraph","spans":[{"id":"spn-98046","marks":["bold"],"text":"Key fields:"}]},{"id":"blk-67410","items":[{"blocks":[{"id":"blk-67412","kind":"paragraph","spans":[{"id":"spn-98047","marks":["code"],"text":"interval_lower"},{"id":"spn-98048","text":" / "},{"id":"spn-98049","marks":["code"],"text":"interval_upper"},{"id":"spn-98050","text":" — Wilson score 95% confidence bounds"}]}],"id":"blk-67411","kind":"list-item"},{"blocks":[{"id":"blk-67414","kind":"paragraph","spans":[{"id":"spn-98051","marks":["code"],"text":"width"},{"id":"spn-98052","text":" — interval width (upper - lower); wider = more uncertain"}]}],"id":"blk-67413","kind":"list-item"},{"blocks":[{"id":"blk-67416","kind":"paragraph","spans":[{"id":"spn-98053","marks":["code"],"text":"information_gain"},{"id":"spn-98054","text":" — expected interval narrowing from one more evidence point"}]}],"id":"blk-67415","kind":"list-item"},{"blocks":[{"id":"blk-67418","kind":"paragraph","spans":[{"id":"spn-98055","marks":["code"],"text":"evidence_count"},{"id":"spn-98056","text":" — number of outcome observations backing this node"}]}],"id":"blk-67417","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67419","kind":"paragraph","spans":[{"id":"spn-98057","text":"Only nodes with "},{"id":"spn-98058","marks":["code"],"text":"evidence_count > 0"},{"id":"spn-98059","text":" appear on the frontier. Nodes without evidence are either current or stale, not \"uncertain\" in the statistical sense."}]},{"id":"blk-67420","kind":"heading","level":2,"spans":[{"id":"spn-98060","text":"The Investigation Loop"}]},{"id":"blk-67421","items":[{"blocks":[{"id":"blk-67423","kind":"paragraph","spans":[{"id":"spn-98061","marks":["bold"],"text":"Query frontier"},{"id":"spn-98062","text":" — "},{"id":"spn-98063","marks":["code"],"text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"}]}],"id":"blk-67422","kind":"list-item"},{"blocks":[{"id":"blk-67425","kind":"paragraph","spans":[{"id":"spn-98064","marks":["bold"],"text":"Pick highest info_gain node"},{"id":"spn-98065","text":" — investigate it (run tests, check docs, verify claims)"}]}],"id":"blk-67424","kind":"list-item"},{"blocks":[{"id":"blk-67427","kind":"paragraph","spans":[{"id":"spn-98066","marks":["bold"],"text":"Report outcome"},{"id":"spn-98067","text":" — "},{"id":"spn-98068","marks":["code"],"text":"learn(action: \"from_outcome\", causal_node_ids: [\"<frontier_node>\"], status: \"success\", ...)"}]}],"id":"blk-67426","kind":"list-item"},{"blocks":[{"id":"blk-67429","kind":"paragraph","spans":[{"id":"spn-98069","marks":["bold"],"text":"Re-query frontier"},{"id":"spn-98070","text":" — the investigated node should have narrowed or dropped off"}]}],"id":"blk-67428","kind":"list-item"},{"blocks":[{"id":"blk-67431","kind":"paragraph","spans":[{"id":"spn-98071","marks":["bold"],"text":"Repeat"},{"id":"spn-98072","text":" — each cycle reduces graph uncertainty where it matters most"}]}],"id":"blk-67430","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67432","kind":"heading","level":2,"spans":[{"id":"spn-98073","text":"Wilson Score Intervals"}]},{"id":"blk-67433","kind":"paragraph","spans":[{"id":"spn-98074","text":"The frontier uses Wilson score confidence intervals (z=1.96 for 95% confidence):"}]},{"id":"blk-67434","items":[{"blocks":[{"id":"blk-67436","kind":"paragraph","spans":[{"id":"spn-98075","marks":["bold"],"text":"1 evidence point"},{"id":"spn-98076","text":": very wide intervals (~0.89 width) regardless of confidence"}]}],"id":"blk-67435","kind":"list-item"},{"blocks":[{"id":"blk-67438","kind":"paragraph","spans":[{"id":"spn-98077","marks":["bold"],"text":"2 evidence points"},{"id":"spn-98078","text":": significantly narrower (~0.58 width)"}]}],"id":"blk-67437","kind":"list-item"},{"blocks":[{"id":"blk-67440","kind":"paragraph","spans":[{"id":"spn-98079","marks":["bold"],"text":"5+ evidence points"},{"id":"spn-98080","text":": reasonably tight bounds"}]}],"id":"blk-67439","kind":"list-item"},{"blocks":[{"id":"blk-67442","kind":"paragraph","spans":[{"id":"spn-98081","marks":["bold"],"text":"10+ evidence points"},{"id":"spn-98082","text":": converging on true confidence"}]}],"id":"blk-67441","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67443","kind":"paragraph","spans":[{"id":"spn-98083","text":"This is why the frontier is powerful: it tells you exactly where one more data point would have the biggest impact."}]},{"id":"blk-67444","kind":"heading","level":2,"spans":[{"id":"spn-98084","text":"Integration with Other Machines"}]},{"id":"blk-67445","kind":"heading","level":3,"spans":[{"id":"spn-98085","text":"Frontier + Learn"}]},{"id":"blk-67446","kind":"paragraph","spans":[{"id":"spn-98086","text":"Every "},{"id":"spn-98087","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-98088","text":" call increments "},{"id":"spn-98089","marks":["code"],"text":"evidence_count"},{"id":"spn-98090","text":" and updates "},{"id":"spn-98091","marks":["code"],"text":"confidence"},{"id":"spn-98092","text":" on causal nodes. This naturally narrows their Wilson intervals and may drop them off the frontier."}]},{"id":"blk-67447","kind":"heading","level":3,"spans":[{"id":"spn-98093","text":"Frontier + Coverage Review"}]},{"id":"blk-67448","kind":"paragraph","spans":[{"id":"spn-98094","text":"Use frontier data to inform coverage decisions:"}]},{"id":"blk-67449","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"...\", signal: \"frontier shows 3 high-uncertainty nodes in this area\")"},{"id":"blk-67450","kind":"paragraph","spans":[{"id":"spn-98095","text":"If key nodes are on the frontier, coverage review may route to "},{"id":"spn-98096","marks":["code"],"text":"learn"},{"id":"spn-98097","text":" instead of "},{"id":"spn-98098","marks":["code"],"text":"act"},{"id":"spn-98099","text":"."}]},{"id":"blk-67451","kind":"heading","level":3,"spans":[{"id":"spn-98100","text":"Frontier + Attention"}]},{"id":"blk-67452","kind":"paragraph","spans":[{"id":"spn-98101","text":"The attention engine can incorporate frontier data when prioritizing goals — goals with high-uncertainty supporting knowledge may need investigation before execution."}]},{"id":"blk-67453","kind":"heading","level":2,"spans":[{"id":"spn-98102","text":"Anti-patterns to avoid"}]},{"id":"blk-67454","items":[{"blocks":[{"id":"blk-67456","kind":"paragraph","spans":[{"id":"spn-98103","text":"Don't ignore high-information-gain nodes — they're where learning has most value"}]}],"id":"blk-67455","kind":"list-item"},{"blocks":[{"id":"blk-67458","kind":"paragraph","spans":[{"id":"spn-98104","text":"Don't assume evidence_count=0 nodes are \"fine\" — they're just not measurable yet"}]}],"id":"blk-67457","kind":"list-item"},{"blocks":[{"id":"blk-67460","kind":"paragraph","spans":[{"id":"spn-98105","text":"Don't set min_gap too low — very narrow intervals aren't worth investigating"}]}],"id":"blk-67459","kind":"list-item"},{"blocks":[{"id":"blk-67462","kind":"paragraph","spans":[{"id":"spn-98106","text":"Always report outcomes after investigating frontier nodes — that's how the frontier shrinks"}]}],"id":"blk-67461","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraxdgukfvsnvxbjljyeyrk7ny44p6mpxeup6rlxnesn4s7yh5fatoa","vocabulary":"ampersand.docs.fs.v1"}