blk-68244","kind":"paragraph","spans":[{"id":"spn-100692","marks":["code"],"text":"information_gain"},{"id":"spn-100693","text":" — expected interval narrowing from one more evidence point"}]}],"id":"blk-68243","kind":"list-item"},{"blocks":[{"id":"blk-68246","kind":"paragraph","spans":[{"id":"spn-100694","marks":["code"],"text":"evidence_count"},{"id":"spn-100695","text":" — number of outcome observations backing this node"}]}],"id":"blk-68245","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68247","kind":"paragraph","spans":[{"id":"spn-100696","text":"Only nodes with "},{"id":"spn-100697","marks":["code"],"text":"evidence_count > 0"},{"id":"spn-100698","text":" appear on the frontier. Nodes without evidence are either current or stale, not \"uncertain\" in the statistical sense."}]},{"id":"blk-68248","kind":"heading","level":2,"spans":[{"id":"spn-100699","text":"The Investigation Loop"}]},{"id":"blk-68249","items":[{"blocks":[{"id":"blk-68251","kind":"paragraph","spans":[{"id":"spn-100700","marks":["bold"],"text":"Query frontier"},{"id":"spn-100701","text":" — "},{"id":"spn-100702","marks":["code"],"text":"retrieve(action: \"frontier\", limit: 5, min_gap: 0.3)"}]}],"id":"blk-68250","kind":"list-item"},{"blocks":[{"id":"blk-68253","kind":"paragraph","spans":[{"id":"spn-100703","marks":["bold"],"text":"Pick highest info_gain node"},{"id":"spn-100704","text":" — investigate it (run tests, check docs, verify claims)"}]}],"id":"blk-68252","kind":"list-item"},{"blocks":[{"id":"blk-68255","kind":"paragraph","spans":[{"id":"spn-100705","marks":["bold"],"text":"Report outcome"},{"id":"spn-100706","text":" — "},{"id":"spn-100707","marks":["code"],"text":"learn(action: \"from_outcome\", causal_node_ids: [\"<frontier_node>\"], status: \"success\", ...)"}]}],"id":"blk-68254","kind":"list-item"},{"blocks":[{"id":"blk-68257","kind":"paragraph","spans":[{"id":"spn-100708","marks":["bold"],"text":"Re-query frontier"},{"id":"spn-100709","text":" — the investigated node should have narrowed or dropped off"}]}],"id":"blk-68256","kind":"list-item"},{"blocks":[{"id":"blk-68259","kind":"paragraph","spans":[{"id":"spn-100710","marks":["bold"],"text":"Repeat"},{"id":"spn-100711","text":" — each cycle reduces graph uncertainty where it matters most"}]}],"id":"blk-68258","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68260","kind":"heading","level":2,"spans":[{"id":"spn-100712","text":"Wilson Score Intervals"}]},{"id":"blk-68261","kind":"paragraph","spans":[{"id":"spn-100713","text":"The frontier uses Wilson score confidence intervals (z=1.96 for 95% confidence):"}]},{"id":"blk-68262","items":[{"blocks":[{"id":"blk-68264","kind":"paragraph","spans":[{"id":"spn-100714","marks":["bold"],"text":"1 evidence point"},{"id":"spn-100715","text":": very wide intervals (~0.89 width) regardless of confidence"}]}],"id":"blk-68263","kind":"list-item"},{"blocks":[{"id":"blk-68266","kind":"paragraph","spans":[{"id":"spn-100716","marks":["bold"],"text":"2 evidence points"},{"id":"spn-100717","text":": significantly narrower (~0.58 width)"}]}],"id":"blk-68265","kind":"list-item"},{"blocks":[{"id":"blk-68268","kind":"paragraph","spans":[{"id":"spn-100718","marks":["bold"],"text":"5+ evidence points"},{"id":"spn-100719","text":": reasonably tight bounds"}]}],"id":"blk-68267","kind":"list-item"},{"blocks":[{"id":"blk-68270","kind":"paragraph","spans":[{"id":"spn-100720","marks":["bold"],"text":"10+ evidence points"},{"id":"spn-100721","text":": converging on true confidence"}]}],"id":"blk-68269","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68271","kind":"paragraph","spans":[{"id":"spn-100722","text":"This is why the frontier is powerful: it tells you exactly where one more data point would have the biggest impact."}]},{"id":"blk-68272","kind":"heading","level":2,"spans":[{"id":"spn-100723","text":"Integration with Other Machines"}]},{"id":"blk-68273","kind":"heading","level":3,"spans":[{"id":"spn-100724","text":"Frontier + Learn"}]},{"id":"blk-68274","kind":"paragraph","spans":[{"id":"spn-100725","text":"Every "},{"id":"spn-100726","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-100727","text":" call increments "},{"id":"spn-100728","marks":["code"],"text":"evidence_count"},{"id":"spn-100729","text":" and updates "},{"id":"spn-100730","marks":["code"],"text":"confidence"},{"id":"spn-100731","text":" on causal nodes. This naturally narrows their Wilson intervals and may drop them off the frontier."}]},{"id":"blk-68275","kind":"heading","level":3,"spans":[{"id":"spn-100732","text":"Frontier + Coverage Review"}]},{"id":"blk-68276","kind":"paragraph","spans":[{"id":"spn-100733","text":"Use frontier data to inform coverage decisions:"}]},{"id":"blk-68277","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"...\", signal: \"frontier shows 3 high-uncertainty nodes in this area\")"},{"id":"blk-68278","kind":"paragraph","spans":[{"id":"spn-100734","text":"If key nodes are on the frontier, coverage review may route to "},{"id":"spn-100735","marks":["code"],"text":"learn"},{"id":"spn-100736","text":" instead of "},{"id":"spn-100737","marks":["code"],"text":"act"},{"id":"spn-100738","text":"."}]},{"id":"blk-68279","kind":"heading","level":3,"spans":[{"id":"spn-100739","text":"Frontier + Attention"}]},{"id":"blk-68280","kind":"paragraph","spans":[{"id":"spn-100740","text":"The attention engine can incorporate frontier data when prioritizing goals — goals with high-uncertainty supporting knowledge may need investigation before execution."}]},{"id":"blk-68281","kind":"heading","level":2,"spans":[{"id":"spn-100741","text":"Anti-patterns to avoid"}]},{"id":"blk-68282","items":[{"blocks":[{"id":"blk-68284","kind":"paragraph","spans":[{"id":"spn-100742","text":"Don't ignore high-information-gain nodes — they're where learning has most value"}]}],"id":"blk-68283","kind":"list-item"},{"blocks":[{"id":"blk-68286","kind":"paragraph","spans":[{"id":"spn-100743","text":"Don't assume evidence_count=0 nodes are \"fine\" — they're just not measurable yet"}]}],"id":"blk-68285","kind":"list-item"},{"blocks":[{"id":"blk-68288","kind":"paragraph","spans":[{"id":"spn-100744","text":"Don't set min_gap too low — very narrow intervals aren't worth investigating"}]}],"id":"blk-68287","kind":"list-item"},{"blocks":[{"id":"blk-68290","kind":"paragraph","spans":[{"id":"spn-100745","text":"Always report outcomes after investigating frontier nodes — that's how the frontier shrinks"}]}],"id":"blk-68289","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraagq2zwpy2ponhgi6hddum42gowjxpq46yi647fuaubqnrcn3zrja","vocabulary":"ampersand.docs.fs.v1"}