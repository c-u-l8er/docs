{"bendscript":"0.1","blocks":[{"id":"blk-45850","kind":"heading","level":1,"spans":[{"id":"spn-51599","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-45851","kind":"heading","level":2,"spans":[{"id":"spn-51600","text":"Mission"}]},{"id":"blk-45852","kind":"paragraph","spans":[{"id":"spn-51601","text":"Push Graphonomous LongMemEval from "},{"id":"spn-51602","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-51603","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-45853","kind":"heading","level":2,"spans":[{"id":"spn-51604","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-45855","spans":[{"id":"spn-51605","text":"Metric"}]},{"id":"blk-45856","spans":[{"id":"spn-51606","text":"Value"}]},{"id":"blk-45857","spans":[{"id":"spn-51607","text":"Gap to Target"}]}],"id":"blk-45854","kind":"table","rows":[[{"id":"blk-45858","spans":[{"id":"spn-51608","text":"Session Hit Rate (SHR)"}]},{"id":"blk-45859","spans":[{"id":"spn-51609","text":"90.4%"}]},{"id":"blk-45860","spans":[{"id":"spn-51610","text":"+6.6pp to 97%"}]}],[{"id":"blk-45861","spans":[{"id":"spn-51611","text":"QA Proxy Score"}]},{"id":"blk-45862","spans":[{"id":"spn-51612","text":"73.04%"}]},{"id":"blk-45863","spans":[{"id":"spn-51613","text":"+22pp to 95%"}]}],[{"id":"blk-45864","spans":[{"id":"spn-51614","text":"Multi-session SHR"}]},{"id":"blk-45865","spans":[{"id":"spn-51615","marks":["bold"],"text":"85.0%"}]},{"id":"blk-45866","spans":[{"id":"spn-51616","text":"worst category"}]}],[{"id":"blk-45867","spans":[{"id":"spn-51617","text":"Multi-session recall"}]},{"id":"blk-45868","spans":[{"id":"spn-51618","marks":["bold"],"text":"60.5%"}]},{"id":"blk-45869","spans":[{"id":"spn-51619","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-45870","spans":[{"id":"spn-51620","text":"Temporal SHR"}]},{"id":"blk-45871","spans":[{"id":"spn-51621","text":"95.0%"}]},{"id":"blk-45872","spans":[{"id":"spn-51622","text":"strong"}]}],[{"id":"blk-45873","spans":[{"id":"spn-51623","text":"Temporal QA proxy"}]},{"id":"blk-45874","spans":[{"id":"spn-51624","text":"74.2%"}]},{"id":"blk-45875","spans":[{"id":"spn-51625","text":"gap despite good SHR"}]}],[{"id":"blk-45876","spans":[{"id":"spn-51626","text":"Abstention accuracy"}]},{"id":"blk-45877","spans":[{"id":"spn-51627","marks":["bold"],"text":"0.0%"}]},{"id":"blk-45878","spans":[{"id":"spn-51628","text":"broken threshold"}]}],[{"id":"blk-45879","spans":[{"id":"spn-51629","text":"Retrieval: similarity_limit"}]},{"id":"blk-45880","spans":[{"id":"spn-51630","text":"10"}]},{"id":"blk-45881","spans":[{"id":"spn-51631","text":"too few for multi-session"}]}],[{"id":"blk-45882","spans":[{"id":"spn-51632","text":"Retrieval: final_limit"}]},{"id":"blk-45883","spans":[{"id":"spn-51633","text":"20"}]},{"id":"blk-45884","spans":[{"id":"spn-51634","text":""}]}],[{"id":"blk-45885","spans":[{"id":"spn-51635","text":"Retrieval: expansion_hops"}]},{"id":"blk-45886","spans":[{"id":"spn-51636","text":"1"}]},{"id":"blk-45887","spans":[{"id":"spn-51637","text":"can't reach cross-session nodes"}]}],[{"id":"blk-45888","spans":[{"id":"spn-51638","text":"Retrieval: hop_decay"}]},{"id":"blk-45889","spans":[{"id":"spn-51639","text":"0.85 (flat)"}]},{"id":"blk-45890","spans":[{"id":"spn-51640","text":"not topology-aware"}]}],[{"id":"blk-45891","spans":[{"id":"spn-51641","text":"Deliberation"}]},{"id":"blk-45892","spans":[{"id":"spn-51642","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-45893","spans":[{"id":"spn-51643","text":"no iterative retrieval"}]}],[{"id":"blk-45894","spans":[{"id":"spn-51644","text":"Temporal indexing"}]},{"id":"blk-45895","spans":[{"id":"spn-51645","text":"none"}]},{"id":"blk-45896","spans":[{"id":"spn-51646","text":"biggest gap vs Chronos"}]}],[{"id":"blk-45897","spans":[{"id":"spn-51647","text":"Session edges at ingestion"}]},{"id":"blk-45898","spans":[{"id":"spn-51648","marks":["bold"],"text":"none"}]},{"id":"blk-45899","spans":[{"id":"spn-51649","text":"turns stored as isolated nodes"}]}],[{"id":"blk-45900","spans":[{"id":"spn-51650","text":"Cross-session entity edges"}]},{"id":"blk-45901","spans":[{"id":"spn-51651","marks":["bold"],"text":"none"}]},{"id":"blk-45902","spans":[{"id":"spn-51652","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-45903","kind":"heading","level":2,"spans":[{"id":"spn-51653","text":"Competitive Landscape"}]},{"head":[{"id":"blk-45905","spans":[{"id":"spn-51654","text":"System"}]},{"id":"blk-45906","spans":[{"id":"spn-51655","text":"Score"}]},{"id":"blk-45907","spans":[{"id":"spn-51656","text":"Key Technique"}]}],"id":"blk-45904","kind":"table","rows":[[{"id":"blk-45908","spans":[{"id":"spn-51657","text":"Supermemory ASMR"}]},{"id":"blk-45909","spans":[{"id":"spn-51658","text":"~99%"}]},{"id":"blk-45910","spans":[{"id":"spn-51659","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-45911","spans":[{"id":"spn-51660","text":"Chronos"}]},{"id":"blk-45912","spans":[{"id":"spn-51661","text":"95.6%"}]},{"id":"blk-45913","spans":[{"id":"spn-51662","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-45914","spans":[{"id":"spn-51663","text":"Mastra OM"}]},{"id":"blk-45915","spans":[{"id":"spn-51664","text":"94.87%"}]},{"id":"blk-45916","spans":[{"id":"spn-51665","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-45917","spans":[{"id":"spn-51666","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-45918","spans":[{"id":"spn-51667","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-45919","spans":[{"id":"spn-51668","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-45920","spans":[{"id":"spn-51669","text":"Emergence AI"}]},{"id":"blk-45921","spans":[{"id":"spn-51670","text":"86%"}]},{"id":"blk-45922","spans":[{"id":"spn-51671","text":"Well-tuned RAG only"}]}],[{"id":"blk-45923","spans":[{"id":"spn-51672","text":"Hindsight (Vectorize)"}]},{"id":"blk-45924","spans":[{"id":"spn-51673","text":"91.4% SHR"}]},{"id":"blk-45925","spans":[{"id":"spn-51674","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-45926","kind":"paragraph","spans":[{"id":"spn-51675","text":"---"}]},{"id":"blk-45927","kind":"heading","level":2,"spans":[{"id":"spn-51676","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-51677","marks":["code"],"text":"shr-optimization"},{"id":"spn-51678","text":")"}]},{"id":"blk-45928","kind":"paragraph","spans":[{"id":"spn-51679","text":"The SHR gap is primarily driven by "},{"id":"spn-51680","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-51681","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-45929","kind":"heading","level":3,"spans":[{"id":"spn-51682","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-45930","kind":"heading","level":4,"spans":[{"id":"spn-51683","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-45931","kind":"paragraph","spans":[{"id":"spn-51684","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51685","text":" "},{"id":"spn-51686","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-51687","text":" "},{"id":"spn-51688","marks":["bold"],"text":"File:"},{"id":"spn-51689","text":" "},{"id":"spn-51690","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-51691","text":" → "},{"id":"spn-51692","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-45932","kind":"paragraph","spans":[{"id":"spn-51693","text":"Currently "},{"id":"spn-51694","marks":["code"],"text":"ingest_session/2"},{"id":"spn-51695","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-45933","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-45934","kind":"paragraph","spans":[{"id":"spn-51696","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-45935","kind":"heading","level":4,"spans":[{"id":"spn-51697","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-45936","kind":"paragraph","spans":[{"id":"spn-51698","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51699","text":" "},{"id":"spn-51700","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-51701","text":" "},{"id":"spn-51702","marks":["bold"],"text":"File:"},{"id":"spn-51703","text":" "},{"id":"spn-51704","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-51705","text":" (new post-ingestion phase)"}]},{"id":"blk-45937","kind":"paragraph","spans":[{"id":"spn-51706","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-45938","items":[{"blocks":[{"id":"blk-45940","kind":"paragraph","spans":[{"id":"spn-51707","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-45939","kind":"list-item"},{"blocks":[{"id":"blk-45942","kind":"paragraph","spans":[{"id":"spn-51708","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-51709","marks":["code"],"text":":related"},{"id":"spn-51710","text":" edges"}]}],"id":"blk-45941","kind":"list-item"},{"blocks":[{"id":"blk-45944","kind":"paragraph","spans":[{"id":"spn-51711","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-45943","kind":"list-item"},{"blocks":[{"id":"blk-45946","kind":"paragraph","spans":[{"id":"spn-51712","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-45945","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45947","kind":"paragraph","spans":[{"id":"spn-51713","text":"Implementation approach:"}]},{"id":"blk-45948","items":[{"blocks":[{"id":"blk-45950","kind":"paragraph","spans":[{"id":"spn-51714","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-45949","kind":"list-item"},{"blocks":[{"id":"blk-45952","kind":"paragraph","spans":[{"id":"spn-51715","text":"Better: use existing "},{"id":"spn-51716","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-51717","text":" which already does edge extraction"}]}],"id":"blk-45951","kind":"list-item"},{"blocks":[{"id":"blk-45954","kind":"paragraph","spans":[{"id":"spn-51718","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-45953","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45955","kind":"heading","level":4,"spans":[{"id":"spn-51719","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-45956","kind":"paragraph","spans":[{"id":"spn-51720","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51721","text":" "},{"id":"spn-51722","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-51723","text":" "},{"id":"spn-51724","marks":["bold"],"text":"File:"},{"id":"spn-51725","text":" "},{"id":"spn-51726","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-45957","kind":"paragraph","spans":[{"id":"spn-51727","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-45958","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-45959","kind":"paragraph","spans":[{"id":"spn-51728","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-45960","kind":"heading","level":4,"spans":[{"id":"spn-51729","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-45961","kind":"paragraph","spans":[{"id":"spn-51730","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51731","text":" "},{"id":"spn-51732","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-51733","text":" "},{"id":"spn-51734","marks":["bold"],"text":"File:"},{"id":"spn-51735","text":" "},{"id":"spn-51736","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-51737","text":" → "},{"id":"spn-51738","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-45962","kind":"paragraph","spans":[{"id":"spn-51739","text":"Change retrieval call from:"}]},{"id":"blk-45963","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-45964","kind":"paragraph","spans":[{"id":"spn-51740","text":"To:"}]},{"id":"blk-45965","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-45966","kind":"paragraph","spans":[{"id":"spn-51741","text":"For even better results, make limits adaptive:"}]},{"id":"blk-45967","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-45968","kind":"heading","level":3,"spans":[{"id":"spn-51742","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-45969","kind":"heading","level":4,"spans":[{"id":"spn-51743","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-45970","kind":"paragraph","spans":[{"id":"spn-51744","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51745","text":" "},{"id":"spn-51746","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-51747","text":" "},{"id":"spn-51748","marks":["bold"],"text":"File:"},{"id":"spn-51749","text":" "},{"id":"spn-51750","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-45971","kind":"paragraph","spans":[{"id":"spn-51751","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-45972","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-45973","kind":"paragraph","spans":[{"id":"spn-51752","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-45974","kind":"heading","level":4,"spans":[{"id":"spn-51753","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-45975","kind":"paragraph","spans":[{"id":"spn-51754","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51755","text":" "},{"id":"spn-51756","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-51757","text":" "},{"id":"spn-51758","marks":["bold"],"text":"File:"},{"id":"spn-51759","text":" "},{"id":"spn-51760","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-45976","kind":"paragraph","spans":[{"id":"spn-51761","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-45977","kind":"heading","level":4,"spans":[{"id":"spn-51762","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-45978","kind":"paragraph","spans":[{"id":"spn-51763","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51764","text":" "},{"id":"spn-51765","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-51766","text":" "},{"id":"spn-51767","marks":["bold"],"text":"Files:"},{"id":"spn-51768","text":" "},{"id":"spn-51769","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-51770","text":", "},{"id":"spn-51771","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-45979","kind":"paragraph","spans":[{"id":"spn-51772","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-45980","kind":"heading","level":4,"spans":[{"id":"spn-51773","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-45981","kind":"paragraph","spans":[{"id":"spn-51774","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51775","text":" "},{"id":"spn-51776","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-51777","text":" "},{"id":"spn-51778","marks":["bold"],"text":"File:"},{"id":"spn-51779","text":" "},{"id":"spn-51780","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-51781","text":" → "},{"id":"spn-51782","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-45982","kind":"paragraph","spans":[{"id":"spn-51783","text":"Current abstention threshold ("},{"id":"spn-51784","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-51785","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-45983","items":[{"blocks":[{"id":"blk-45985","kind":"paragraph","spans":[{"id":"spn-51786","text":"Use confidence gap: "},{"id":"spn-51787","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-51788","text":" → likely no clear answer"}]}],"id":"blk-45984","kind":"list-item"},{"blocks":[{"id":"blk-45987","kind":"paragraph","spans":[{"id":"spn-51789","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-45986","kind":"list-item"},{"blocks":[{"id":"blk-45989","kind":"paragraph","spans":[{"id":"spn-51790","text":"Raise score threshold to "},{"id":"spn-51791","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-45988","kind":"list-item"},{"blocks":[{"id":"blk-45991","kind":"paragraph","spans":[{"id":"spn-51792","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-45990","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45992","kind":"paragraph","spans":[{"id":"spn-51793","text":"---"}]},{"id":"blk-45993","kind":"heading","level":2,"spans":[{"id":"spn-51794","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-51795","marks":["code"],"text":"kappa-optimization"},{"id":"spn-51796","text":")"}]},{"id":"blk-45994","kind":"paragraph","spans":[{"id":"spn-51797","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-45995","kind":"heading","level":3,"spans":[{"id":"spn-51798","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-45996","kind":"heading","level":4,"spans":[{"id":"spn-51799","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-45997","kind":"paragraph","spans":[{"id":"spn-51800","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51801","text":" "},{"id":"spn-51802","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-51803","text":" "},{"id":"spn-51804","marks":["bold"],"text":"File:"},{"id":"spn-51805","text":" "},{"id":"spn-51806","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-45998","kind":"paragraph","spans":[{"id":"spn-51807","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-51808","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-51809","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-51810","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-51811","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-45999","kind":"paragraph","spans":[{"id":"spn-51812","text":"Implementation:"}]},{"id":"blk-46000","items":[{"blocks":[{"id":"blk-46002","kind":"paragraph","spans":[{"id":"spn-51813","text":"In "},{"id":"spn-51814","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-51815","text":", after building the initial prompt, add a "},{"id":"spn-51816","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-51817","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-46001","kind":"list-item"},{"blocks":[{"id":"blk-46004","kind":"paragraph","spans":[{"id":"spn-51818","text":"In the main "},{"id":"spn-51819","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-51820","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-46003","kind":"list-item"},{"blocks":[{"id":"blk-46006","kind":"paragraph","spans":[{"id":"spn-51821","text":"Use "},{"id":"spn-51822","marks":["code"],"text":"fault_line_edges"},{"id":"spn-51823","text":" to decide which partition side needs more evidence"}]}],"id":"blk-46005","kind":"list-item"},{"blocks":[{"id":"blk-46008","kind":"paragraph","spans":[{"id":"spn-51824","text":"Wire through "},{"id":"spn-51825","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-51826","text":" with a "},{"id":"spn-51827","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-51828","text":" option"}]}],"id":"blk-46007","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46009","kind":"paragraph","spans":[{"id":"spn-51829","text":"Test: Run "},{"id":"spn-51830","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-51831","text":" before and after. QA proxy score should increase."}]},{"id":"blk-46010","kind":"heading","level":4,"spans":[{"id":"spn-51832","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-46011","kind":"paragraph","spans":[{"id":"spn-51833","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51834","text":" "},{"id":"spn-51835","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-51836","text":" "},{"id":"spn-51837","marks":["bold"],"text":"File:"},{"id":"spn-51838","text":" "},{"id":"spn-51839","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46012","kind":"paragraph","spans":[{"id":"spn-51840","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-46013","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-46014","kind":"paragraph","spans":[{"id":"spn-51841","text":"This requires restructuring "},{"id":"spn-51842","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-51843","text":" to: 1. Run similarity search (seeds) 2. Do a preliminary 1-hop expansion 3. Run topology analysis on the expanded set 4. If κ > 0, do additional hops up to "},{"id":"spn-51844","marks":["code"],"text":"effective_hops"}]},{"id":"blk-46015","kind":"heading","level":4,"spans":[{"id":"spn-51845","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-46016","kind":"paragraph","spans":[{"id":"spn-51846","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51847","text":" "},{"id":"spn-51848","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-51849","text":" "},{"id":"spn-51850","marks":["bold"],"text":"Files:"},{"id":"spn-51851","text":" "},{"id":"spn-51852","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-51853","text":", "},{"id":"spn-51854","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-51855","text":", edge types"}]},{"id":"blk-46017","kind":"paragraph","spans":[{"id":"spn-51856","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-51857","marks":["code"],"text":"contradicts"},{"id":"spn-51858","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-46018","kind":"paragraph","spans":[{"id":"spn-51859","text":"Implementation:"}]},{"id":"blk-46019","items":[{"blocks":[{"id":"blk-46021","kind":"paragraph","spans":[{"id":"spn-51860","text":"In "},{"id":"spn-51861","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-51862","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-51863","marks":["code"],"text":":contradicts"}]}],"id":"blk-46020","kind":"list-item"},{"blocks":[{"id":"blk-46023","kind":"paragraph","spans":[{"id":"spn-51864","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-51865","marks":["code"],"text":"inserted_at"},{"id":"spn-51866","text":" timestamps"}]}],"id":"blk-46022","kind":"list-item"},{"blocks":[{"id":"blk-46025","kind":"paragraph","spans":[{"id":"spn-51867","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-46024","kind":"list-item"},{"blocks":[{"id":"blk-46027","kind":"paragraph","spans":[{"id":"spn-51868","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-46026","kind":"list-item"},{"blocks":[{"id":"blk-46029","kind":"paragraph","spans":[{"id":"spn-51869","text":"Add "},{"id":"spn-51870","marks":["code"],"text":":supersedes"},{"id":"spn-51871","text":" edge type if not present"}]}],"id":"blk-46028","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46030","kind":"heading","level":3,"spans":[{"id":"spn-51872","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-46031","kind":"heading","level":4,"spans":[{"id":"spn-51873","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-46032","kind":"paragraph","spans":[{"id":"spn-51874","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51875","text":" "},{"id":"spn-51876","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-51877","text":" "},{"id":"spn-51878","marks":["bold"],"text":"File:"},{"id":"spn-51879","text":" "},{"id":"spn-51880","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46033","kind":"paragraph","spans":[{"id":"spn-51881","text":"Replace flat "},{"id":"spn-51882","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-51883","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-46034","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-46035","items":[{"blocks":[{"id":"blk-46037","kind":"paragraph","spans":[{"id":"spn-51884","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-46036","kind":"list-item"},{"blocks":[{"id":"blk-46039","kind":"paragraph","spans":[{"id":"spn-51885","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-46038","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46040","kind":"paragraph","spans":[{"id":"spn-51886","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-46041","kind":"heading","level":4,"spans":[{"id":"spn-51887","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-46042","kind":"paragraph","spans":[{"id":"spn-51888","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51889","text":" "},{"id":"spn-51890","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-51891","text":" "},{"id":"spn-51892","marks":["bold"],"text":"File:"},{"id":"spn-51893","text":" "},{"id":"spn-51894","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46043","kind":"paragraph","spans":[{"id":"spn-51895","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-51896","marks":["code"],"text":"fault_line_edges"},{"id":"spn-51897","text":":"}]},{"id":"blk-46044","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-46045","kind":"heading","level":4,"spans":[{"id":"spn-51898","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-46046","kind":"paragraph","spans":[{"id":"spn-51899","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51900","text":" "},{"id":"spn-51901","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-51902","text":" "},{"id":"spn-51903","marks":["bold"],"text":"File:"},{"id":"spn-51904","text":" "},{"id":"spn-51905","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-51906","text":" (or new module)"}]},{"id":"blk-46047","kind":"paragraph","spans":[{"id":"spn-51907","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-46048","items":[{"blocks":[{"id":"blk-46050","kind":"paragraph","spans":[{"id":"spn-51908","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-46049","kind":"list-item"},{"blocks":[{"id":"blk-46052","kind":"paragraph","spans":[{"id":"spn-51909","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-46051","kind":"list-item"},{"blocks":[{"id":"blk-46054","kind":"paragraph","spans":[{"id":"spn-51910","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-46053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46055","kind":"paragraph","spans":[{"id":"spn-51911","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-46056","kind":"heading","level":3,"spans":[{"id":"spn-51912","text":"κ Phase 3 — Polish"}]},{"id":"blk-46057","kind":"heading","level":4,"spans":[{"id":"spn-51913","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-46058","kind":"paragraph","spans":[{"id":"spn-51914","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51915","text":" "},{"id":"spn-51916","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-46059","kind":"paragraph","spans":[{"id":"spn-51917","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-46060","kind":"heading","level":4,"spans":[{"id":"spn-51918","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-46061","kind":"paragraph","spans":[{"id":"spn-51919","marks":["bold"],"text":"Goal ID:"},{"id":"spn-51920","text":" "},{"id":"spn-51921","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-46062","kind":"paragraph","spans":[{"id":"spn-51922","text":"Use "},{"id":"spn-51923","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-51924","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-46063","kind":"paragraph","spans":[{"id":"spn-51925","text":"---"}]},{"id":"blk-46064","kind":"heading","level":2,"spans":[{"id":"spn-51926","text":"Recommended Implementation Order"}]},{"id":"blk-46065","kind":"paragraph","spans":[{"id":"spn-51927","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-46067","spans":[{"id":"spn-51928","text":"Order"}]},{"id":"blk-46068","spans":[{"id":"spn-51929","text":"Goal"}]},{"id":"blk-46069","spans":[{"id":"spn-51930","text":"Tag"}]},{"id":"blk-46070","spans":[{"id":"spn-51931","text":"Expected Impact"}]}],"id":"blk-46066","kind":"table","rows":[[{"id":"blk-46071","spans":[{"id":"spn-51932","text":"1"}]},{"id":"blk-46072","spans":[{"id":"spn-51933","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-46073","spans":[{"id":"spn-51934","text":"shr"}]},{"id":"blk-46074","spans":[{"id":"spn-51935","text":"+3-5pp SHR"}]}],[{"id":"blk-46075","spans":[{"id":"spn-51936","text":"2"}]},{"id":"blk-46076","spans":[{"id":"spn-51937","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-46077","spans":[{"id":"spn-51938","text":"shr"}]},{"id":"blk-46078","spans":[{"id":"spn-51939","text":"+2-3pp SHR"}]}],[{"id":"blk-46079","spans":[{"id":"spn-51940","text":"3"}]},{"id":"blk-46080","spans":[{"id":"spn-51941","text":"S3: Session Summary Nodes"}]},{"id":"blk-46081","spans":[{"id":"spn-51942","text":"shr"}]},{"id":"blk-46082","spans":[{"id":"spn-51943","text":"+3-5pp SHR"}]}],[{"id":"blk-46083","spans":[{"id":"spn-51944","text":"4"}]},{"id":"blk-46084","spans":[{"id":"spn-51945","text":"S2: Cross-Session Entity Edges"}]},{"id":"blk-46085","spans":[{"id":"spn-51946","text":"shr"}]},{"id":"blk-46086","spans":[{"id":"spn-51947","text":"+3-4pp SHR"}]}],[{"id":"blk-46087","spans":[{"id":"spn-51948","text":"5"}]},{"id":"blk-46088","spans":[{"id":"spn-51949","text":"S5: Session Diversity Re-ranking"}]},{"id":"blk-46089","spans":[{"id":"spn-51950","text":"shr"}]},{"id":"blk-46090","spans":[{"id":"spn-51951","text":"+2-3pp SHR"}]}],[{"id":"blk-46091","spans":[{"id":"spn-51952","text":"6"}]},{"id":"blk-46092","spans":[{"id":"spn-51953","text":"S8: Abstention Calibration"}]},{"id":"blk-46093","spans":[{"id":"spn-51954","text":"shr"}]},{"id":"blk-46094","spans":[{"id":"spn-51955","text":"+2-3pp QA"}]}],[{"id":"blk-46095","spans":[{"id":"spn-51956","text":"7"}]},{"id":"blk-46096","spans":[{"id":"spn-51957","text":"K1: Iterative Retrieval in Deliberation"}]},{"id":"blk-46097","spans":[{"id":"spn-51958","text":"κ"}]},{"id":"blk-46098","spans":[{"id":"spn-51959","text":"+8-12pp QA"}]}],[{"id":"blk-46099","spans":[{"id":"spn-51960","text":"8"}]},{"id":"blk-46100","spans":[{"id":"spn-51961","text":"K2: κ-Adaptive Retrieval Depth"}]},{"id":"blk-46101","spans":[{"id":"spn-51962","text":"κ"}]},{"id":"blk-46102","spans":[{"id":"spn-51963","text":"+3-5pp QA"}]}],[{"id":"blk-46103","spans":[{"id":"spn-51964","text":"9"}]},{"id":"blk-46104","spans":[{"id":"spn-51965","text":"K3: Temporal Contradiction via κ"}]},{"id":"blk-46105","spans":[{"id":"spn-51966","text":"κ"}]},{"id":"blk-46106","spans":[{"id":"spn-51967","text":"+5-8pp QA"}]}],[{"id":"blk-46107","spans":[{"id":"spn-51968","text":"10"}]},{"id":"blk-46108","spans":[{"id":"spn-51969","text":"K4: κ-Modulated Hop Decay"}]},{"id":"blk-46109","spans":[{"id":"spn-51970","text":"κ"}]},{"id":"blk-46110","spans":[{"id":"spn-51971","text":"+2-3pp QA"}]}],[{"id":"blk-46111","spans":[{"id":"spn-51972","text":"11"}]},{"id":"blk-46112","spans":[{"id":"spn-51973","text":"K5: Fault-Line Boosting"}]},{"id":"blk-46113","spans":[{"id":"spn-51974","text":"κ"}]},{"id":"blk-46114","spans":[{"id":"spn-51975","text":"+2-4pp QA"}]}],[{"id":"blk-46115","spans":[{"id":"spn-51976","text":"12"}]},{"id":"blk-46116","spans":[{"id":"spn-51977","text":"S