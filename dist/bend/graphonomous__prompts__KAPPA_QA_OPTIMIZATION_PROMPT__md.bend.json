{"bendscript":"0.1","blocks":[{"id":"blk-46932","kind":"heading","level":1,"spans":[{"id":"spn-54522","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-46933","kind":"heading","level":2,"spans":[{"id":"spn-54523","text":"Mission"}]},{"id":"blk-46934","kind":"paragraph","spans":[{"id":"spn-54524","text":"Push Graphonomous LongMemEval from "},{"id":"spn-54525","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-54526","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-46935","kind":"heading","level":2,"spans":[{"id":"spn-54527","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-46937","spans":[{"id":"spn-54528","text":"Metric"}]},{"id":"blk-46938","spans":[{"id":"spn-54529","text":"Value"}]},{"id":"blk-46939","spans":[{"id":"spn-54530","text":"Gap to Target"}]}],"id":"blk-46936","kind":"table","rows":[[{"id":"blk-46940","spans":[{"id":"spn-54531","text":"Session Hit Rate (SHR)"}]},{"id":"blk-46941","spans":[{"id":"spn-54532","text":"90.4%"}]},{"id":"blk-46942","spans":[{"id":"spn-54533","text":"+6.6pp to 97%"}]}],[{"id":"blk-46943","spans":[{"id":"spn-54534","text":"QA Proxy Score"}]},{"id":"blk-46944","spans":[{"id":"spn-54535","text":"73.04%"}]},{"id":"blk-46945","spans":[{"id":"spn-54536","text":"+22pp to 95%"}]}],[{"id":"blk-46946","spans":[{"id":"spn-54537","text":"Multi-session SHR"}]},{"id":"blk-46947","spans":[{"id":"spn-54538","marks":["bold"],"text":"85.0%"}]},{"id":"blk-46948","spans":[{"id":"spn-54539","text":"worst category"}]}],[{"id":"blk-46949","spans":[{"id":"spn-54540","text":"Multi-session recall"}]},{"id":"blk-46950","spans":[{"id":"spn-54541","marks":["bold"],"text":"60.5%"}]},{"id":"blk-46951","spans":[{"id":"spn-54542","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-46952","spans":[{"id":"spn-54543","text":"Temporal SHR"}]},{"id":"blk-46953","spans":[{"id":"spn-54544","text":"95.0%"}]},{"id":"blk-46954","spans":[{"id":"spn-54545","text":"strong"}]}],[{"id":"blk-46955","spans":[{"id":"spn-54546","text":"Temporal QA proxy"}]},{"id":"blk-46956","spans":[{"id":"spn-54547","text":"74.2%"}]},{"id":"blk-46957","spans":[{"id":"spn-54548","text":"gap despite good SHR"}]}],[{"id":"blk-46958","spans":[{"id":"spn-54549","text":"Abstention accuracy"}]},{"id":"blk-46959","spans":[{"id":"spn-54550","marks":["bold"],"text":"0.0%"}]},{"id":"blk-46960","spans":[{"id":"spn-54551","text":"broken threshold"}]}],[{"id":"blk-46961","spans":[{"id":"spn-54552","text":"Retrieval: similarity_limit"}]},{"id":"blk-46962","spans":[{"id":"spn-54553","text":"10"}]},{"id":"blk-46963","spans":[{"id":"spn-54554","text":"too few for multi-session"}]}],[{"id":"blk-46964","spans":[{"id":"spn-54555","text":"Retrieval: final_limit"}]},{"id":"blk-46965","spans":[{"id":"spn-54556","text":"20"}]},{"id":"blk-46966","spans":[{"id":"spn-54557","text":""}]}],[{"id":"blk-46967","spans":[{"id":"spn-54558","text":"Retrieval: expansion_hops"}]},{"id":"blk-46968","spans":[{"id":"spn-54559","text":"1"}]},{"id":"blk-46969","spans":[{"id":"spn-54560","text":"can't reach cross-session nodes"}]}],[{"id":"blk-46970","spans":[{"id":"spn-54561","text":"Retrieval: hop_decay"}]},{"id":"blk-46971","spans":[{"id":"spn-54562","text":"0.85 (flat)"}]},{"id":"blk-46972","spans":[{"id":"spn-54563","text":"not topology-aware"}]}],[{"id":"blk-46973","spans":[{"id":"spn-54564","text":"Deliberation"}]},{"id":"blk-46974","spans":[{"id":"spn-54565","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-46975","spans":[{"id":"spn-54566","text":"no iterative retrieval"}]}],[{"id":"blk-46976","spans":[{"id":"spn-54567","text":"Temporal indexing"}]},{"id":"blk-46977","spans":[{"id":"spn-54568","text":"none"}]},{"id":"blk-46978","spans":[{"id":"spn-54569","text":"biggest gap vs Chronos"}]}],[{"id":"blk-46979","spans":[{"id":"spn-54570","text":"Session edges at ingestion"}]},{"id":"blk-46980","spans":[{"id":"spn-54571","marks":["bold"],"text":"none"}]},{"id":"blk-46981","spans":[{"id":"spn-54572","text":"turns stored as isolated nodes"}]}],[{"id":"blk-46982","spans":[{"id":"spn-54573","text":"Cross-session entity edges"}]},{"id":"blk-46983","spans":[{"id":"spn-54574","marks":["bold"],"text":"none"}]},{"id":"blk-46984","spans":[{"id":"spn-54575","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-46985","kind":"heading","level":2,"spans":[{"id":"spn-54576","text":"Competitive Landscape"}]},{"head":[{"id":"blk-46987","spans":[{"id":"spn-54577","text":"System"}]},{"id":"blk-46988","spans":[{"id":"spn-54578","text":"Score"}]},{"id":"blk-46989","spans":[{"id":"spn-54579","text":"Key Technique"}]}],"id":"blk-46986","kind":"table","rows":[[{"id":"blk-46990","spans":[{"id":"spn-54580","text":"Supermemory ASMR"}]},{"id":"blk-46991","spans":[{"id":"spn-54581","text":"~99%"}]},{"id":"blk-46992","spans":[{"id":"spn-54582","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-46993","spans":[{"id":"spn-54583","text":"Chronos"}]},{"id":"blk-46994","spans":[{"id":"spn-54584","text":"95.6%"}]},{"id":"blk-46995","spans":[{"id":"spn-54585","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-46996","spans":[{"id":"spn-54586","text":"Mastra OM"}]},{"id":"blk-46997","spans":[{"id":"spn-54587","text":"94.87%"}]},{"id":"blk-46998","spans":[{"id":"spn-54588","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-46999","spans":[{"id":"spn-54589","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-47000","spans":[{"id":"spn-54590","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-47001","spans":[{"id":"spn-54591","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-47002","spans":[{"id":"spn-54592","text":"Emergence AI"}]},{"id":"blk-47003","spans":[{"id":"spn-54593","text":"86%"}]},{"id":"blk-47004","spans":[{"id":"spn-54594","text":"Well-tuned RAG only"}]}],[{"id":"blk-47005","spans":[{"id":"spn-54595","text":"Hindsight (Vectorize)"}]},{"id":"blk-47006","spans":[{"id":"spn-54596","text":"91.4% SHR"}]},{"id":"blk-47007","spans":[{"id":"spn-54597","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-47008","kind":"paragraph","spans":[{"id":"spn-54598","text":"---"}]},{"id":"blk-47009","kind":"heading","level":2,"spans":[{"id":"spn-54599","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-54600","marks":["code"],"text":"shr-optimization"},{"id":"spn-54601","text":")"}]},{"id":"blk-47010","kind":"paragraph","spans":[{"id":"spn-54602","text":"The SHR gap is primarily driven by "},{"id":"spn-54603","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-54604","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-47011","kind":"heading","level":3,"spans":[{"id":"spn-54605","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-47012","kind":"heading","level":4,"spans":[{"id":"spn-54606","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-47013","kind":"paragraph","spans":[{"id":"spn-54607","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54608","text":" "},{"id":"spn-54609","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-54610","text":" "},{"id":"spn-54611","marks":["bold"],"text":"File:"},{"id":"spn-54612","text":" "},{"id":"spn-54613","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-54614","text":" → "},{"id":"spn-54615","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-47014","kind":"paragraph","spans":[{"id":"spn-54616","text":"Currently "},{"id":"spn-54617","marks":["code"],"text":"ingest_session/2"},{"id":"spn-54618","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-47015","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-47016","kind":"paragraph","spans":[{"id":"spn-54619","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-47017","kind":"heading","level":4,"spans":[{"id":"spn-54620","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-47018","kind":"paragraph","spans":[{"id":"spn-54621","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54622","text":" "},{"id":"spn-54623","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-54624","text":" "},{"id":"spn-54625","marks":["bold"],"text":"File:"},{"id":"spn-54626","text":" "},{"id":"spn-54627","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-54628","text":" (new post-ingestion phase)"}]},{"id":"blk-47019","kind":"paragraph","spans":[{"id":"spn-54629","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-47020","items":[{"blocks":[{"id":"blk-47022","kind":"paragraph","spans":[{"id":"spn-54630","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-47021","kind":"list-item"},{"blocks":[{"id":"blk-47024","kind":"paragraph","spans":[{"id":"spn-54631","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-54632","marks":["code"],"text":":related"},{"id":"spn-54633","text":" edges"}]}],"id":"blk-47023","kind":"list-item"},{"blocks":[{"id":"blk-47026","kind":"paragraph","spans":[{"id":"spn-54634","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-47025","kind":"list-item"},{"blocks":[{"id":"blk-47028","kind":"paragraph","spans":[{"id":"spn-54635","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-47027","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47029","kind":"paragraph","spans":[{"id":"spn-54636","text":"Implementation approach:"}]},{"id":"blk-47030","items":[{"blocks":[{"id":"blk-47032","kind":"paragraph","spans":[{"id":"spn-54637","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-47031","kind":"list-item"},{"blocks":[{"id":"blk-47034","kind":"paragraph","spans":[{"id":"spn-54638","text":"Better: use existing "},{"id":"spn-54639","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-54640","text":" which already does edge extraction"}]}],"id":"blk-47033","kind":"list-item"},{"blocks":[{"id":"blk-47036","kind":"paragraph","spans":[{"id":"spn-54641","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-47035","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47037","kind":"heading","level":4,"spans":[{"id":"spn-54642","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-47038","kind":"paragraph","spans":[{"id":"spn-54643","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54644","text":" "},{"id":"spn-54645","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-54646","text":" "},{"id":"spn-54647","marks":["bold"],"text":"File:"},{"id":"spn-54648","text":" "},{"id":"spn-54649","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-47039","kind":"paragraph","spans":[{"id":"spn-54650","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-47040","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-47041","kind":"paragraph","spans":[{"id":"spn-54651","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-47042","kind":"heading","level":4,"spans":[{"id":"spn-54652","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-47043","kind":"paragraph","spans":[{"id":"spn-54653","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54654","text":" "},{"id":"spn-54655","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-54656","text":" "},{"id":"spn-54657","marks":["bold"],"text":"File:"},{"id":"spn-54658","text":" "},{"id":"spn-54659","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-54660","text":" → "},{"id":"spn-54661","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-47044","kind":"paragraph","spans":[{"id":"spn-54662","text":"Change retrieval call from:"}]},{"id":"blk-47045","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-47046","kind":"paragraph","spans":[{"id":"spn-54663","text":"To:"}]},{"id":"blk-47047","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-47048","kind":"paragraph","spans":[{"id":"spn-54664","text":"For even better results, make limits adaptive:"}]},{"id":"blk-47049","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-47050","kind":"heading","level":3,"spans":[{"id":"spn-54665","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-47051","kind":"heading","level":4,"spans":[{"id":"spn-54666","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-47052","kind":"paragraph","spans":[{"id":"spn-54667","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54668","text":" "},{"id":"spn-54669","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-54670","text":" "},{"id":"spn-54671","marks":["bold"],"text":"File:"},{"id":"spn-54672","text":" "},{"id":"spn-54673","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-47053","kind":"paragraph","spans":[{"id":"spn-54674","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-47054","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-47055","kind":"paragraph","spans":[{"id":"spn-54675","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-47056","kind":"heading","level":4,"spans":[{"id":"spn-54676","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-47057","kind":"paragraph","spans":[{"id":"spn-54677","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54678","text":" "},{"id":"spn-54679","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-54680","text":" "},{"id":"spn-54681","marks":["bold"],"text":"File:"},{"id":"spn-54682","text":" "},{"id":"spn-54683","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-47058","kind":"paragraph","spans":[{"id":"spn-54684","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-47059","kind":"heading","level":4,"spans":[{"id":"spn-54685","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-47060","kind":"paragraph","spans":[{"id":"spn-54686","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54687","text":" "},{"id":"spn-54688","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-54689","text":" "},{"id":"spn-54690","marks":["bold"],"text":"Files:"},{"id":"spn-54691","text":" "},{"id":"spn-54692","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-54693","text":", "},{"id":"spn-54694","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-47061","kind":"paragraph","spans":[{"id":"spn-54695","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-47062","kind":"heading","level":4,"spans":[{"id":"spn-54696","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-47063","kind":"paragraph","spans":[{"id":"spn-54697","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54698","text":" "},{"id":"spn-54699","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-54700","text":" "},{"id":"spn-54701","marks":["bold"],"text":"File:"},{"id":"spn-54702","text":" "},{"id":"spn-54703","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-54704","text":" → "},{"id":"spn-54705","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-47064","kind":"paragraph","spans":[{"id":"spn-54706","text":"Current abstention threshold ("},{"id":"spn-54707","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-54708","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-47065","items":[{"blocks":[{"id":"blk-47067","kind":"paragraph","spans":[{"id":"spn-54709","text":"Use confidence gap: "},{"id":"spn-54710","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-54711","text":" → likely no clear answer"}]}],"id":"blk-47066","kind":"list-item"},{"blocks":[{"id":"blk-47069","kind":"paragraph","spans":[{"id":"spn-54712","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-47068","kind":"list-item"},{"blocks":[{"id":"blk-47071","kind":"paragraph","spans":[{"id":"spn-54713","text":"Raise score threshold to "},{"id":"spn-54714","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-47070","kind":"list-item"},{"blocks":[{"id":"blk-47073","kind":"paragraph","spans":[{"id":"spn-54715","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-47072","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47074","kind":"paragraph","spans":[{"id":"spn-54716","text":"---"}]},{"id":"blk-47075","kind":"heading","level":2,"spans":[{"id":"spn-54717","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-54718","marks":["code"],"text":"kappa-optimization"},{"id":"spn-54719","text":")"}]},{"id":"blk-47076","kind":"paragraph","spans":[{"id":"spn-54720","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-47077","kind":"heading","level":3,"spans":[{"id":"spn-54721","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-47078","kind":"heading","level":4,"spans":[{"id":"spn-54722","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-47079","kind":"paragraph","spans":[{"id":"spn-54723","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54724","text":" "},{"id":"spn-54725","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-54726","text":" "},{"id":"spn-54727","marks":["bold"],"text":"File:"},{"id":"spn-54728","text":" "},{"id":"spn-54729","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-47080","kind":"paragraph","spans":[{"id":"spn-54730","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-54731","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-54732","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-54733","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-54734","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-47081","kind":"paragraph","spans":[{"id":"spn-54735","text":"Implementation:"}]},{"id":"blk-47082","items":[{"blocks":[{"id":"blk-47084","kind":"paragraph","spans":[{"id":"spn-54736","text":"In "},{"id":"spn-54737","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-54738","text":", after building the initial prompt, add a "},{"id":"spn-54739","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-54740","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-47083","kind":"list-item"},{"blocks":[{"id":"blk-47086","kind":"paragraph","spans":[{"id":"spn-54741","text":"In the main "},{"id":"spn-54742","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-54743","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-47085","kind":"list-item"},{"blocks":[{"id":"blk-47088","kind":"paragraph","spans":[{"id":"spn-54744","text":"Use "},{"id":"spn-54745","marks":["code"],"text":"fault_line_edges"},{"id":"spn-54746","text":" to decide which partition side needs more evidence"}]}],"id":"blk-47087","kind":"list-item"},{"blocks":[{"id":"blk-47090","kind":"paragraph","spans":[{"id":"spn-54747","text":"Wire through "},{"id":"spn-54748","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-54749","text":" with a "},{"id":"spn-54750","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-54751","text":" option"}]}],"id":"blk-47089","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47091","kind":"paragraph","spans":[{"id":"spn-54752","text":"Test: Run "},{"id":"spn-54753","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-54754","text":" before and after. QA proxy score should increase."}]},{"id":"blk-47092","kind":"heading","level":4,"spans":[{"id":"spn-54755","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-47093","kind":"paragraph","spans":[{"id":"spn-54756","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54757","text":" "},{"id":"spn-54758","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-54759","text":" "},{"id":"spn-54760","marks":["bold"],"text":"File:"},{"id":"spn-54761","text":" "},{"id":"spn-54762","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-47094","kind":"paragraph","spans":[{"id":"spn-54763","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-47095","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-47096","kind":"paragraph","spans":[{"id":"spn-54764","text":"This requires restructuring "},{"id":"spn-54765","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-54766","text":" to: 1. Run similarity search (seeds) 2. Do a preliminary 1-hop expansion 3. Run topology analysis on the expanded set 4. If κ > 0, do additional hops up to "},{"id":"spn-54767","marks":["code"],"text":"effective_hops"}]},{"id":"blk-47097","kind":"heading","level":4,"spans":[{"id":"spn-54768","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-47098","kind":"paragraph","spans":[{"id":"spn-54769","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54770","text":" "},{"id":"spn-54771","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-54772","text":" "},{"id":"spn-54773","marks":["bold"],"text":"Files:"},{"id":"spn-54774","text":" "},{"id":"spn-54775","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-54776","text":", "},{"id":"spn-54777","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-54778","text":", edge types"}]},{"id":"blk-47099","kind":"paragraph","spans":[{"id":"spn-54779","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-54780","marks":["code"],"text":"contradicts"},{"id":"spn-54781","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-47100","kind":"paragraph","spans":[{"id":"spn-54782","text":"Implementation:"}]},{"id":"blk-47101","items":[{"blocks":[{"id":"blk-47103","kind":"paragraph","spans":[{"id":"spn-54783","text":"In "},{"id":"spn-54784","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-54785","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-54786","marks":["code"],"text":":contradicts"}]}],"id":"blk-47102","kind":"list-item"},{"blocks":[{"id":"blk-47105","kind":"paragraph","spans":[{"id":"spn-54787","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-54788","marks":["code"],"text":"inserted_at"},{"id":"spn-54789","text":" timestamps"}]}],"id":"blk-47104","kind":"list-item"},{"blocks":[{"id":"blk-47107","kind":"paragraph","spans":[{"id":"spn-54790","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-47106","kind":"list-item"},{"blocks":[{"id":"blk-47109","kind":"paragraph","spans":[{"id":"spn-54791","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-47108","kind":"list-item"},{"blocks":[{"id":"blk-47111","kind":"paragraph","spans":[{"id":"spn-54792","text":"Add "},{"id":"spn-54793","marks":["code"],"text":":supersedes"},{"id":"spn-54794","text":" edge type if not present"}]}],"id":"blk-47110","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47112","kind":"heading","level":3,"spans":[{"id":"spn-54795","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-47113","kind":"heading","level":4,"spans":[{"id":"spn-54796","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-47114","kind":"paragraph","spans":[{"id":"spn-54797","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54798","text":" "},{"id":"spn-54799","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-54800","text":" "},{"id":"spn-54801","marks":["bold"],"text":"File:"},{"id":"spn-54802","text":" "},{"id":"spn-54803","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-47115","kind":"paragraph","spans":[{"id":"spn-54804","text":"Replace flat "},{"id":"spn-54805","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-54806","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-47116","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-47117","items":[{"blocks":[{"id":"blk-47119","kind":"paragraph","spans":[{"id":"spn-54807","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-47118","kind":"list-item"},{"blocks":[{"id":"blk-47121","kind":"paragraph","spans":[{"id":"spn-54808","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-47120","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47122","kind":"paragraph","spans":[{"id":"spn-54809","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-47123","kind":"heading","level":4,"spans":[{"id":"spn-54810","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-47124","kind":"paragraph","spans":[{"id":"spn-54811","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54812","text":" "},{"id":"spn-54813","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-54814","text":" "},{"id":"spn-54815","marks":["bold"],"text":"File:"},{"id":"spn-54816","text":" "},{"id":"spn-54817","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-47125","kind":"paragraph","spans":[{"id":"spn-54818","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-54819","marks":["code"],"text":"fault_line_edges"},{"id":"spn-54820","text":":"}]},{"id":"blk-47126","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-47127","kind":"heading","level":4,"spans":[{"id":"spn-54821","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-47128","kind":"paragraph","spans":[{"id":"spn-54822","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54823","text":" "},{"id":"spn-54824","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-54825","text":" "},{"id":"spn-54826","marks":["bold"],"text":"File:"},{"id":"spn-54827","text":" "},{"id":"spn-54828","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-54829","text":" (or new module)"}]},{"id":"blk-47129","kind":"paragraph","spans":[{"id":"spn-54830","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-47130","items":[{"blocks":[{"id":"blk-47132","kind":"paragraph","spans":[{"id":"spn-54831","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-47131","kind":"list-item"},{"blocks":[{"id":"blk-47134","kind":"paragraph","spans":[{"id":"spn-54832","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-47133","kind":"list-item"},{"blocks":[{"id":"blk-47136","kind":"paragraph","spans":[{"id":"spn-54833","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-47135","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47137","kind":"paragraph","spans":[{"id":"spn-54834","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-47138","kind":"heading","level":3,"spans":[{"id":"spn-54835","text":"κ Phase 3 — Polish"}]},{"id":"blk-47139","kind":"heading","level":4,"spans":[{"id":"spn-54836","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-47140","kind":"paragraph","spans":[{"id":"spn-54837","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54838","text":" "},{"id":"spn-54839","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-47141","kind":"paragraph","spans":[{"id":"spn-54840","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-47142","kind":"heading","level":4,"spans":[{"id":"spn-54841","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-47143","kind":"paragraph","spans":[{"id":"spn-54842","marks":["bold"],"text":"Goal ID:"},{"id":"spn-54843","text":" "},{"id":"spn-54844","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-47144","kind":"paragraph","spans":[{"id":"spn-54845","text":"Use "},{"id":"spn-54846","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-54847","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-47145","kind":"paragraph","spans":[{"id":"spn-54848","text":"---"}]},{"id":"blk-47146","kind":"heading","level":2,"spans":[{"id":"spn-54849","text":"Recommended Implementation Order"}]},{"id":"blk-47147","kind":"paragraph","spans":[{"id":"spn-54850","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-47149","spans":[{"id":"spn-54851","text":"Order"}]},{"id":"blk-47150","spans":[{"id":"spn-54852","text":"Goal"}]},{"id":"blk-47151","spans":[{"id":"spn-54853","text":"Tag"}]},{"id":"blk-47152","spans":[{"id":"spn-54854","text":"Expected Impact"}]}],"id":"blk-47148","kind":"table","rows":[[{"id":"blk-47153","spans":[{"id":"spn-54855","text":"1"}]},{"id":"blk-47154","spans":[{"id":"spn-54856","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-47155","spans":[{"id":"spn-54857","text":"shr"}]},{"id":"blk-47156","spans":[{"id":"spn-54858","text":"+3-5pp SHR"}]}],[{"id":"blk-47157","spans":[{"id":"spn-54859","text":"2"}]},{"id":"blk-47158","spans":[{"id":"spn-54860","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-47159","spans":[{"id":"spn-54861","text":"shr"}]},{"id":"blk-47160","spans":[{"id":"spn-54862","text":"+2-3pp SHR"}]}],[{"id":"blk-47161","spans":[{"id":"spn-54863","text":"3"}]},{"id":"blk-47162","spans":[{"id":"spn-54864","text":"S3: Session Summary Nodes"}]},{"id":"blk-47163","spans":[{"id":"spn-54865","text":"shr"}]},{"id":"blk-47164","spans":[{"id":"spn-54866","text":"+3-5pp SHR"}]}],[{"id":"blk-47165","spans":[{"id":"spn-54867","text":"4"}]},{"id":"blk-47166","spans":[{"id":"spn-54868","text":"S2: Cross-Session Entity Edges"}]},{"id":"blk-47167","spans":[{"id":"spn-54869","text":"shr"}]},{"id":"blk-47168","spans":[{"id":"spn-54870","text":"+3-4pp SHR"}]}],[{"id":"blk-47169","spans":[{"id":"spn-54871","text":"5"}]},{"id":"blk-47170","spans":[{"id":"spn-54872","text":"S5: Session Diversity Re-ranking"}]},{"id":"blk-47171","spans":[{"id":"spn-54873","text":"shr"}]},{"id":"blk-47172","spans":[{"id":"spn-54874","text":"+2-3pp SHR"}]}],[{"id":"blk-47173","spans":[{"id":"spn-54875","text":"6"}]},{"id":"blk-47174","spans":[{"id":"spn-54876","text":"S8: Abstention Calibration"}]},{"id":"blk-47175","spans":[{"id":"spn-54877","text":"shr"}]},{"id":"blk-47176","spans":[{"id":"spn-54878","text":"+2-3pp QA"}]}],[{"id":"blk-47177","spans":[{"id":"spn-54879","text":"7"}]},{"id":"blk-47178","spans":[{"id":"spn-54880","text":"K1: Iterative Retrieval in Deliberation"}]},{"id":"blk-47179","spans":[{"id":"spn-54881","text":"κ"}]},{"id":"blk-47180","spans":[{"id":"spn-54882","text":"+8-12pp QA"}]}],[{"id":"blk-47181","spans":[{"id":"spn-54883","text":"8"}]},{"id":"blk-47182","spans":[{"id":"spn-54884","text":"K2: κ-Adaptive Retrieval Depth"}]},{"id":"blk-47183","spans":[{"id":"spn-54885","text":"κ"}]},{"id":"blk-47184","spans":[{"id":"spn-54886","text":"+3-5pp QA"}]}],[{"id":"blk-47185","spans":[{"id":"spn-54887","text":"9"}]},{"id":"blk-47186","spans":[{"id":"spn-54888","text":"K3: Temporal Contradiction via κ"}]},{"id":"blk-47187","spans":[{"id":"spn-54889","text":"κ"}]},{"id":"blk-47188","spans":[{"id":"spn-54890","text":"+5-8pp QA"}]}],[{"id":"blk-47189","spans":[{"id":"spn-54891","text":"10"}]},{"id":"blk-47190","spans":[{"id":"spn-54892","text":"K4: κ-Modulated Hop Decay"}]},{"id":"blk-47191","spans":[{"id":"spn-54893","text":"κ"}]},{"id":"blk-47192","spans":[{"id":"spn-54894","text":"+2-3pp QA"}]}],[{"id":"blk-47193","spans":[{"id":"spn-54895","text":"11"}]},{"id":"blk-47194","spans":[{"id":"spn-54896","text":"K5: Fault-Line Boosting"}]},{"id":"blk-47195","spans":[{"id":"spn-54897","text":"κ"}]},{"id":"blk-47196","spans":[{"id":"spn-54898","text":"+2-4pp QA"}]}],[{"id":"blk-47197","spans":[{"id":"spn-54899","text":"12"}]},{"id":"blk-47198","spans":[{"id":"spn-54900","text":"S