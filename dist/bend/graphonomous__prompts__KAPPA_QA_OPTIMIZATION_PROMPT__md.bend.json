arity → BFS → rerank → topology → deliberate)"}]}],[{"id":"blk-47225","spans":[{"id":"spn-54927","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-47226","spans":[{"id":"spn-54928","text":"κ-driven decompose-focus-reconcile"}]}],[{"id":"blk-47227","spans":[{"id":"spn-54929","marks":["code"],"text":"lib/graphonomous/topology.ex"}]},{"id":"blk-47228","spans":[{"id":"spn-54930","text":"Tarjan SCC, κ computation, fault lines, edge impact preview"}]}],[{"id":"blk-47229","spans":[{"id":"spn-54931","marks":["code"],"text":"lib/graphonomous/graph.ex"}]},{"id":"blk-47230","spans":[{"id":"spn-54932","text":"Node/edge CRUD, similarity search, BFS"}]}],[{"id":"blk-47231","spans":[{"id":"spn-54933","marks":["code"],"text":"lib/graphonomous/store.ex"}]},{"id":"blk-47232","spans":[{"id":"spn-54934","text":"SQLite persistence layer"}]}],[{"id":"blk-47233","spans":[{"id":"spn-54935","marks":["code"],"text":"lib/graphonomous/types/edge.ex"}]},{"id":"blk-47234","spans":[{"id":"spn-54936","text":"Edge type definitions (16 types)"}]}],[{"id":"blk-47235","spans":[{"id":"spn-54937","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-47236","spans":[{"id":"spn-54938","text":"LongMemEval benchmark task (ingestion + evaluation)"}]}],[{"id":"blk-47237","spans":[{"id":"spn-54939","marks":["code"],"text":"lib/mix/tasks/benchmark/retrieval.ex"}]},{"id":"blk-47238","spans":[{"id":"spn-54940","text":"Retrieval quality benchmark (graph vs flat)"}]}],[{"id":"blk-47239","spans":[{"id":"spn-54941","marks":["code"],"text":"test/graphonomous/retriever_test.exs"}]},{"id":"blk-47240","spans":[{"id":"spn-54942","text":"Retriever tests"}]}],[{"id":"blk-47241","spans":[{"id":"spn-54943","marks":["code"],"text":"test/graphonomous/deliberator_test.exs"}]},{"id":"blk-47242","spans":[{"id":"spn-54944","text":"Deliberator tests"}]}],[{"id":"blk-47243","spans":[{"id":"spn-54945","marks":["code"],"text":"test/graphonomous/topology_test.exs"}]},{"id":"blk-47244","span