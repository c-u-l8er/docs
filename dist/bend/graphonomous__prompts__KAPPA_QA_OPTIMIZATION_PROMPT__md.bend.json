{"bendscript":"0.1","blocks":[{"id":"blk-46446","kind":"heading","level":1,"spans":[{"id":"spn-53402","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-46447","kind":"heading","level":2,"spans":[{"id":"spn-53403","text":"Mission"}]},{"id":"blk-46448","kind":"paragraph","spans":[{"id":"spn-53404","text":"Push Graphonomous LongMemEval from "},{"id":"spn-53405","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-53406","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-46449","kind":"heading","level":2,"spans":[{"id":"spn-53407","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-46451","spans":[{"id":"spn-53408","text":"Metric"}]},{"id":"blk-46452","spans":[{"id":"spn-53409","text":"Value"}]},{"id":"blk-46453","spans":[{"id":"spn-53410","text":"Gap to Target"}]}],"id":"blk-46450","kind":"table","rows":[[{"id":"blk-46454","spans":[{"id":"spn-53411","text":"Session Hit Rate (SHR)"}]},{"id":"blk-46455","spans":[{"id":"spn-53412","text":"90.4%"}]},{"id":"blk-46456","spans":[{"id":"spn-53413","text":"+6.6pp to 97%"}]}],[{"id":"blk-46457","spans":[{"id":"spn-53414","text":"QA Proxy Score"}]},{"id":"blk-46458","spans":[{"id":"spn-53415","text":"73.04%"}]},{"id":"blk-46459","spans":[{"id":"spn-53416","text":"+22pp to 95%"}]}],[{"id":"blk-46460","spans":[{"id":"spn-53417","text":"Multi-session SHR"}]},{"id":"blk-46461","spans":[{"id":"spn-53418","marks":["bold"],"text":"85.0%"}]},{"id":"blk-46462","spans":[{"id":"spn-53419","text":"worst category"}]}],[{"id":"blk-46463","spans":[{"id":"spn-53420","text":"Multi-session recall"}]},{"id":"blk-46464","spans":[{"id":"spn-53421","marks":["bold"],"text":"60.5%"}]},{"id":"blk-46465","spans":[{"id":"spn-53422","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-46466","spans":[{"id":"spn-53423","text":"Temporal SHR"}]},{"id":"blk-46467","spans":[{"id":"spn-53424","text":"95.0%"}]},{"id":"blk-46468","spans":[{"id":"spn-53425","text":"strong"}]}],[{"id":"blk-46469","spans":[{"id":"spn-53426","text":"Temporal QA proxy"}]},{"id":"blk-46470","spans":[{"id":"spn-53427","text":"74.2%"}]},{"id":"blk-46471","spans":[{"id":"spn-53428","text":"gap despite good SHR"}]}],[{"id":"blk-46472","spans":[{"id":"spn-53429","text":"Abstention accuracy"}]},{"id":"blk-46473","spans":[{"id":"spn-53430","marks":["bold"],"text":"0.0%"}]},{"id":"blk-46474","spans":[{"id":"spn-53431","text":"broken threshold"}]}],[{"id":"blk-46475","spans":[{"id":"spn-53432","text":"Retrieval: similarity_limit"}]},{"id":"blk-46476","spans":[{"id":"spn-53433","text":"10"}]},{"id":"blk-46477","spans":[{"id":"spn-53434","text":"too few for multi-session"}]}],[{"id":"blk-46478","spans":[{"id":"spn-53435","text":"Retrieval: final_limit"}]},{"id":"blk-46479","spans":[{"id":"spn-53436","text":"20"}]},{"id":"blk-46480","spans":[{"id":"spn-53437","text":""}]}],[{"id":"blk-46481","spans":[{"id":"spn-53438","text":"Retrieval: expansion_hops"}]},{"id":"blk-46482","spans":[{"id":"spn-53439","text":"1"}]},{"id":"blk-46483","spans":[{"id":"spn-53440","text":"can't reach cross-session nodes"}]}],[{"id":"blk-46484","spans":[{"id":"spn-53441","text":"Retrieval: hop_decay"}]},{"id":"blk-46485","spans":[{"id":"spn-53442","text":"0.85 (flat)"}]},{"id":"blk-46486","spans":[{"id":"spn-53443","text":"not topology-aware"}]}],[{"id":"blk-46487","spans":[{"id":"spn-53444","text":"Deliberation"}]},{"id":"blk-46488","spans":[{"id":"spn-53445","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-46489","spans":[{"id":"spn-53446","text":"no iterative retrieval"}]}],[{"id":"blk-46490","spans":[{"id":"spn-53447","text":"Temporal indexing"}]},{"id":"blk-46491","spans":[{"id":"spn-53448","text":"none"}]},{"id":"blk-46492","spans":[{"id":"spn-53449","text":"biggest gap vs Chronos"}]}],[{"id":"blk-46493","spans":[{"id":"spn-53450","text":"Session edges at ingestion"}]},{"id":"blk-46494","spans":[{"id":"spn-53451","marks":["bold"],"text":"none"}]},{"id":"blk-46495","spans":[{"id":"spn-53452","text":"turns stored as isolated nodes"}]}],[{"id":"blk-46496","spans":[{"id":"spn-53453","text":"Cross-session entity edges"}]},{"id":"blk-46497","spans":[{"id":"spn-53454","marks":["bold"],"text":"none"}]},{"id":"blk-46498","spans":[{"id":"spn-53455","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-46499","kind":"heading","level":2,"spans":[{"id":"spn-53456","text":"Competitive Landscape"}]},{"head":[{"id":"blk-46501","spans":[{"id":"spn-53457","text":"System"}]},{"id":"blk-46502","spans":[{"id":"spn-53458","text":"Score"}]},{"id":"blk-46503","spans":[{"id":"spn-53459","text":"Key Technique"}]}],"id":"blk-46500","kind":"table","rows":[[{"id":"blk-46504","spans":[{"id":"spn-53460","text":"Supermemory ASMR"}]},{"id":"blk-46505","spans":[{"id":"spn-53461","text":"~99%"}]},{"id":"blk-46506","spans":[{"id":"spn-53462","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-46507","spans":[{"id":"spn-53463","text":"Chronos"}]},{"id":"blk-46508","spans":[{"id":"spn-53464","text":"95.6%"}]},{"id":"blk-46509","spans":[{"id":"spn-53465","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-46510","spans":[{"id":"spn-53466","text":"Mastra OM"}]},{"id":"blk-46511","spans":[{"id":"spn-53467","text":"94.87%"}]},{"id":"blk-46512","spans":[{"id":"spn-53468","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-46513","spans":[{"id":"spn-53469","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-46514","spans":[{"id":"spn-53470","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-46515","spans":[{"id":"spn-53471","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-46516","spans":[{"id":"spn-53472","text":"Emergence AI"}]},{"id":"blk-46517","spans":[{"id":"spn-53473","text":"86%"}]},{"id":"blk-46518","spans":[{"id":"spn-53474","text":"Well-tuned RAG only"}]}],[{"id":"blk-46519","spans":[{"id":"spn-53475","text":"Hindsight (Vectorize)"}]},{"id":"blk-46520","spans":[{"id":"spn-53476","text":"91.4% SHR"}]},{"id":"blk-46521","spans":[{"id":"spn-53477","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-46522","kind":"paragraph","spans":[{"id":"spn-53478","text":"---"}]},{"id":"blk-46523","kind":"heading","level":2,"spans":[{"id":"spn-53479","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-53480","marks":["code"],"text":"shr-optimization"},{"id":"spn-53481","text":")"}]},{"id":"blk-46524","kind":"paragraph","spans":[{"id":"spn-53482","text":"The SHR gap is primarily driven by "},{"id":"spn-53483","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-53484","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-46525","kind":"heading","level":3,"spans":[{"id":"spn-53485","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-46526","kind":"heading","level":4,"spans":[{"id":"spn-53486","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-46527","kind":"paragraph","spans":[{"id":"spn-53487","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53488","text":" "},{"id":"spn-53489","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-53490","text":" "},{"id":"spn-53491","marks":["bold"],"text":"File:"},{"id":"spn-53492","text":" "},{"id":"spn-53493","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-53494","text":" → "},{"id":"spn-53495","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-46528","kind":"paragraph","spans":[{"id":"spn-53496","text":"Currently "},{"id":"spn-53497","marks":["code"],"text":"ingest_session/2"},{"id":"spn-53498","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-46529","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-46530","kind":"paragraph","spans":[{"id":"spn-53499","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-46531","kind":"heading","level":4,"spans":[{"id":"spn-53500","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-46532","kind":"paragraph","spans":[{"id":"spn-53501","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53502","text":" "},{"id":"spn-53503","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-53504","text":" "},{"id":"spn-53505","marks":["bold"],"text":"File:"},{"id":"spn-53506","text":" "},{"id":"spn-53507","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-53508","text":" (new post-ingestion phase)"}]},{"id":"blk-46533","kind":"paragraph","spans":[{"id":"spn-53509","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-46534","items":[{"blocks":[{"id":"blk-46536","kind":"paragraph","spans":[{"id":"spn-53510","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-46535","kind":"list-item"},{"blocks":[{"id":"blk-46538","kind":"paragraph","spans":[{"id":"spn-53511","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-53512","marks":["code"],"text":":related"},{"id":"spn-53513","text":" edges"}]}],"id":"blk-46537","kind":"list-item"},{"blocks":[{"id":"blk-46540","kind":"paragraph","spans":[{"id":"spn-53514","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-46539","kind":"list-item"},{"blocks":[{"id":"blk-46542","kind":"paragraph","spans":[{"id":"spn-53515","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-46541","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46543","kind":"paragraph","spans":[{"id":"spn-53516","text":"Implementation approach:"}]},{"id":"blk-46544","items":[{"blocks":[{"id":"blk-46546","kind":"paragraph","spans":[{"id":"spn-53517","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-46545","kind":"list-item"},{"blocks":[{"id":"blk-46548","kind":"paragraph","spans":[{"id":"spn-53518","text":"Better: use existing "},{"id":"spn-53519","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-53520","text":" which already does edge extraction"}]}],"id":"blk-46547","kind":"list-item"},{"blocks":[{"id":"blk-46550","kind":"paragraph","spans":[{"id":"spn-53521","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-46549","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46551","kind":"heading","level":4,"spans":[{"id":"spn-53522","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-46552","kind":"paragraph","spans":[{"id":"spn-53523","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53524","text":" "},{"id":"spn-53525","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-53526","text":" "},{"id":"spn-53527","marks":["bold"],"text":"File:"},{"id":"spn-53528","text":" "},{"id":"spn-53529","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-46553","kind":"paragraph","spans":[{"id":"spn-53530","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-46554","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-46555","kind":"paragraph","spans":[{"id":"spn-53531","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-46556","kind":"heading","level":4,"spans":[{"id":"spn-53532","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-46557","kind":"paragraph","spans":[{"id":"spn-53533","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53534","text":" "},{"id":"spn-53535","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-53536","text":" "},{"id":"spn-53537","marks":["bold"],"text":"File:"},{"id":"spn-53538","text":" "},{"id":"spn-53539","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-53540","text":" → "},{"id":"spn-53541","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-46558","kind":"paragraph","spans":[{"id":"spn-53542","text":"Change retrieval call from:"}]},{"id":"blk-46559","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-46560","kind":"paragraph","spans":[{"id":"spn-53543","text":"To:"}]},{"id":"blk-46561","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-46562","kind":"paragraph","spans":[{"id":"spn-53544","text":"For even better results, make limits adaptive:"}]},{"id":"blk-46563","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-46564","kind":"heading","level":3,"spans":[{"id":"spn-53545","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-46565","kind":"heading","level":4,"spans":[{"id":"spn-53546","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-46566","kind":"paragraph","spans":[{"id":"spn-53547","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53548","text":" "},{"id":"spn-53549","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-53550","text":" "},{"id":"spn-53551","marks":["bold"],"text":"File:"},{"id":"spn-53552","text":" "},{"id":"spn-53553","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46567","kind":"paragraph","spans":[{"id":"spn-53554","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-46568","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-46569","kind":"paragraph","spans":[{"id":"spn-53555","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-46570","kind":"heading","level":4,"spans":[{"id":"spn-53556","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-46571","kind":"paragraph","spans":[{"id":"spn-53557","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53558","text":" "},{"id":"spn-53559","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-53560","text":" "},{"id":"spn-53561","marks":["bold"],"text":"File:"},{"id":"spn-53562","text":" "},{"id":"spn-53563","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46572","kind":"paragraph","spans":[{"id":"spn-53564","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-46573","kind":"heading","level":4,"spans":[{"id":"spn-53565","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-46574","kind":"paragraph","spans":[{"id":"spn-53566","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53567","text":" "},{"id":"spn-53568","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-53569","text":" "},{"id":"spn-53570","marks":["bold"],"text":"Files:"},{"id":"spn-53571","text":" "},{"id":"spn-53572","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-53573","text":", "},{"id":"spn-53574","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46575","kind":"paragraph","spans":[{"id":"spn-53575","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-46576","kind":"heading","level":4,"spans":[{"id":"spn-53576","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-46577","kind":"paragraph","spans":[{"id":"spn-53577","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53578","text":" "},{"id":"spn-53579","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-53580","text":" "},{"id":"spn-53581","marks":["bold"],"text":"File:"},{"id":"spn-53582","text":" "},{"id":"spn-53583","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-53584","text":" → "},{"id":"spn-53585","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-46578","kind":"paragraph","spans":[{"id":"spn-53586","text":"Current abstention threshold ("},{"id":"spn-53587","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-53588","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-46579","items":[{"blocks":[{"id":"blk-46581","kind":"paragraph","spans":[{"id":"spn-53589","text":"Use confidence gap: "},{"id":"spn-53590","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-53591","text":" → likely no clear answer"}]}],"id":"blk-46580","kind":"list-item"},{"blocks":[{"id":"blk-46583","kind":"paragraph","spans":[{"id":"spn-53592","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-46582","kind":"list-item"},{"blocks":[{"id":"blk-46585","kind":"paragraph","spans":[{"id":"spn-53593","text":"Raise score threshold to "},{"id":"spn-53594","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-46584","kind":"list-item"},{"blocks":[{"id":"blk-46587","kind":"paragraph","spans":[{"id":"spn-53595","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-46586","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46588","kind":"paragraph","spans":[{"id":"spn-53596","text":"---"}]},{"id":"blk-46589","kind":"heading","level":2,"spans":[{"id":"spn-53597","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-53598","marks":["code"],"text":"kappa-optimization"},{"id":"spn-53599","text":")"}]},{"id":"blk-46590","kind":"paragraph","spans":[{"id":"spn-53600","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-46591","kind":"heading","level":3,"spans":[{"id":"spn-53601","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-46592","kind":"heading","level":4,"spans":[{"id":"spn-53602","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-46593","kind":"paragraph","spans":[{"id":"spn-53603","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53604","text":" "},{"id":"spn-53605","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-53606","text":" "},{"id":"spn-53607","marks":["bold"],"text":"File:"},{"id":"spn-53608","text":" "},{"id":"spn-53609","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-46594","kind":"paragraph","spans":[{"id":"spn-53610","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-53611","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-53612","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-53613","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-53614","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-46595","kind":"paragraph","spans":[{"id":"spn-53615","text":"Implementation:"}]},{"id":"blk-46596","items":[{"blocks":[{"id":"blk-46598","kind":"paragraph","spans":[{"id":"spn-53616","text":"In "},{"id":"spn-53617","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-53618","text":", after building the initial prompt, add a "},{"id":"spn-53619","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-53620","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-46597","kind":"list-item"},{"blocks":[{"id":"blk-46600","kind":"paragraph","spans":[{"id":"spn-53621","text":"In the main "},{"id":"spn-53622","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-53623","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-46599","kind":"list-item"},{"blocks":[{"id":"blk-46602","kind":"paragraph","spans":[{"id":"spn-53624","text":"Use "},{"id":"spn-53625","marks":["code"],"text":"fault_line_edges"},{"id":"spn-53626","text":" to decide which partition side needs more evidence"}]}],"id":"blk-46601","kind":"list-item"},{"blocks":[{"id":"blk-46604","kind":"paragraph","spans":[{"id":"spn-53627","text":"Wire through "},{"id":"spn-53628","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-53629","text":" with a "},{"id":"spn-53630","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-53631","text":" option"}]}],"id":"blk-46603","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46605","kind":"paragraph","spans":[{"id":"spn-53632","text":"Test: Run "},{"id":"spn-53633","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-53634","text":" before and after. QA proxy score should increase."}]},{"id":"blk-46606","kind":"heading","level":4,"spans":[{"id":"spn-53635","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-46607","kind":"paragraph","spans":[{"id":"spn-53636","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53637","text":" "},{"id":"spn-53638","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-53639","text":" "},{"id":"spn-53640","marks":["bold"],"text":"File:"},{"id":"spn-53641","text":" "},{"id":"spn-53642","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46608","kind":"paragraph","spans":[{"id":"spn-53643","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-46609","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-46610","kind":"paragraph","spans":[{"id":"spn-53644","text":"This requires restructuring "},{"id":"spn-53645","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-53646","text":" to: 1. Run similarity search (seeds) 2. Do a preliminary 1-hop expansion 3. Run topology analysis on the expanded set 4. If κ > 0, do additional hops up to "},{"id":"spn-53647","marks":["code"],"text":"effective_hops"}]},{"id":"blk-46611","kind":"heading","level":4,"spans":[{"id":"spn-53648","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-46612","kind":"paragraph","spans":[{"id":"spn-53649","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53650","text":" "},{"id":"spn-53651","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-53652","text":" "},{"id":"spn-53653","marks":["bold"],"text":"Files:"},{"id":"spn-53654","text":" "},{"id":"spn-53655","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-53656","text":", "},{"id":"spn-53657","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-53658","text":", edge types"}]},{"id":"blk-46613","kind":"paragraph","spans":[{"id":"spn-53659","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-53660","marks":["code"],"text":"contradicts"},{"id":"spn-53661","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-46614","kind":"paragraph","spans":[{"id":"spn-53662","text":"Implementation:"}]},{"id":"blk-46615","items":[{"blocks":[{"id":"blk-46617","kind":"paragraph","spans":[{"id":"spn-53663","text":"In "},{"id":"spn-53664","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-53665","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-53666","marks":["code"],"text":":contradicts"}]}],"id":"blk-46616","kind":"list-item"},{"blocks":[{"id":"blk-46619","kind":"paragraph","spans":[{"id":"spn-53667","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-53668","marks":["code"],"text":"inserted_at"},{"id":"spn-53669","text":" timestamps"}]}],"id":"blk-46618","kind":"list-item"},{"blocks":[{"id":"blk-46621","kind":"paragraph","spans":[{"id":"spn-53670","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-46620","kind":"list-item"},{"blocks":[{"id":"blk-46623","kind":"paragraph","spans":[{"id":"spn-53671","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-46622","kind":"list-item"},{"blocks":[{"id":"blk-46625","kind":"paragraph","spans":[{"id":"spn-53672","text":"Add "},{"id":"spn-53673","marks":["code"],"text":":supersedes"},{"id":"spn-53674","text":" edge type if not present"}]}],"id":"blk-46624","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46626","kind":"heading","level":3,"spans":[{"id":"spn-53675","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-46627","kind":"heading","level":4,"spans":[{"id":"spn-53676","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-46628","kind":"paragraph","spans":[{"id":"spn-53677","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53678","text":" "},{"id":"spn-53679","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-53680","text":" "},{"id":"spn-53681","marks":["bold"],"text":"File:"},{"id":"spn-53682","text":" "},{"id":"spn-53683","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46629","kind":"paragraph","spans":[{"id":"spn-53684","text":"Replace flat "},{"id":"spn-53685","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-53686","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-46630","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-46631","items":[{"blocks":[{"id":"blk-46633","kind":"paragraph","spans":[{"id":"spn-53687","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-46632","kind":"list-item"},{"blocks":[{"id":"blk-46635","kind":"paragraph","spans":[{"id":"spn-53688","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-46634","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46636","kind":"paragraph","spans":[{"id":"spn-53689","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-46637","kind":"heading","level":4,"spans":[{"id":"spn-53690","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-46638","kind":"paragraph","spans":[{"id":"spn-53691","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53692","text":" "},{"id":"spn-53693","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-53694","text":" "},{"id":"spn-53695","marks":["bold"],"text":"File:"},{"id":"spn-53696","text":" "},{"id":"spn-53697","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46639","kind":"paragraph","spans":[{"id":"spn-53698","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-53699","marks":["code"],"text":"fault_line_edges"},{"id":"spn-53700","text":":"}]},{"id":"blk-46640","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-46641","kind":"heading","level":4,"spans":[{"id":"spn-53701","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-46642","kind":"paragraph","spans":[{"id":"spn-53702","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53703","text":" "},{"id":"spn-53704","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-53705","text":" "},{"id":"spn-53706","marks":["bold"],"text":"File:"},{"id":"spn-53707","text":" "},{"id":"spn-53708","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-53709","text":" (or new module)"}]},{"id":"blk-46643","kind":"paragraph","spans":[{"id":"spn-53710","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-46644","items":[{"blocks":[{"id":"blk-46646","kind":"paragraph","spans":[{"id":"spn-53711","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-46645","kind":"list-item"},{"blocks":[{"id":"blk-46648","kind":"paragraph","spans":[{"id":"spn-53712","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-46647","kind":"list-item"},{"blocks":[{"id":"blk-46650","kind":"paragraph","spans":[{"id":"spn-53713","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-46649","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46651","kind":"paragraph","spans":[{"id":"spn-53714","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-46652","kind":"heading","level":3,"spans":[{"id":"spn-53715","text":"κ Phase 3 — Polish"}]},{"id":"blk-46653","kind":"heading","level":4,"spans":[{"id":"spn-53716","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-46654","kind":"paragraph","spans":[{"id":"spn-53717","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53718","text":" "},{"id":"spn-53719","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-46655","kind":"paragraph","spans":[{"id":"spn-53720","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-46656","kind":"heading","level":4,"spans":[{"id":"spn-53721","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-46657","kind":"paragraph","spans":[{"id":"spn-53722","marks":["bold"],"text":"Goal ID:"},{"id":"spn-53723","text":" "},{"id":"spn-53724","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-46658","kind":"paragraph","spans":[{"id":"spn-53725","text":"Use "},{"id":"spn-53726","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-53727","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-46659","kind":"paragraph","spans":[{"id":"spn-53728","text":"---"}]},{"id":"blk-46660","kind":"heading","level":2,"spans":[{"id":"spn-53729","text":"Recommended Implementation Order"}]},{"id":"blk-46661","kind":"paragraph","spans":[{"id":"spn-53730","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-46663","spans":[{"id":"spn-53731","text":"Order"}]},{"id":"blk-46664","spans":[{"id":"spn-53732","text":"Goal"}]},{"id":"blk-46665","spans":[{"id":"spn-53733","text":"Tag"}]},{"id":"blk-46666","spans":[{"id":"spn-53734","text":"Expected Impact"}]}],"id":"blk-46662","kind":"table","rows":[[{"id":"blk-46667","spans":[{"id":"spn-53735","text":"1"}]},{"id":"blk-46668","spans":[{"id":"spn-53736","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-46669","spans":[{"id":"spn-53737","text":"shr"}]},{"id":"blk-46670","spans":[{"id":"spn-53738","text":"+3-5pp SHR"}]}],[{"id":"blk-46671","spans":[{"id":"spn-53739","text":"2"}]},{"id":"blk-46672","spans":[{"id":"spn-53740","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-46673","spans":[{"id":"spn-53741","text":"shr"}]},{"id":"blk-46674","spans":[{"id":"spn-53742","text":"+2-3pp SHR"}]}],[{"id":"blk-46675","spans":[{"id":"spn-53743","text":"3"}]},{"id":"blk-46676","spans":[{"id":"spn-53744","text":"S3: Session Summary Nodes"}]},{"id":"blk-46677","spans":[{"id":"spn-53745","text":"shr"}]},{"id":"blk-46678","spans":[{"id":"spn-53746","text":"+3-5pp SHR"}]}],[{"id":"blk-46679","spans":[{"id":"spn-53747","text":"4"}]},{"id":"blk-46680","spans":[{"id":"spn-53748","text":"S2: Cross-Session Entity Edges"}]},{"id":"blk-46681","spans":[{"id":"spn-53749","text":"shr"}]},{"id":"blk-46682","spans":[{"id":"spn-53750","text":"+3-4pp SHR"}]}],[{"id":"blk-46683","spans":[{"id":"spn-53751","text":"5"}]},{"id":"blk-46684","spans":[{"id":"spn-53752","text":"S5: Session Diversity Re-ranking"}]},{"id":"blk-46685","spans":[{"id":"spn-53753","text":"shr"}]},{"id":"blk-46686","spans":[{"id":"spn-53754","text":"+2-3pp SHR"}]}],[{"id":"blk-46687","spans":[{"id":"spn-53755","text":"6"}]},{"id":"blk-46688","spans":[{"id":"spn-53756","text":"S8: Abstention Calibration"}]},{"id":"blk-46689","spans":[{"id":"spn-53757","text":"shr"}]},{"id":"blk-46690","spans":[{"id":"spn-53758","text":"+2-3pp QA"}]}],[{"id":"blk-46691","spans":[{"id":"spn-53759","text":"7"}]},{"id":"blk-46692","spans":[{"id":"spn-53760","text":"K1: Iterative Retrieval in Deliberation"}]},{"id":"blk-46693","spans":[{"id":"spn-53761","text":"κ"}]},{"id":"blk-46694","spans":[{"id":"spn-53762","text":"+8-12pp QA"}]}],[{"id":"blk-46695","spans":[{"id":"spn-53763","text":"8"}]},{"id":"blk-46696","spans":[{"id":"spn-53764","text":"K2: κ-Adaptive Retrieval Depth"}]},{"id":"blk-46697","spans":[{"id":"spn-53765","text":"κ"}]},{"id":"blk-46698","spans":[{"id":"spn-53766","text":"+3-5pp QA"}]}],[{"id":"blk-46699","spans":[{"id":"spn-53767","text":"9"}]},{"id":"blk-46700","spans":[{"id":"spn-53768","text":"K3: Temporal Contradiction via κ"}]},{"id":"blk-46701","spans":[{"id":"spn-53769","text":"κ"}]},{"id":"blk-46702","spans":[{"id":"spn-53770","text":"+5-8pp QA"}]}],[{"id":"blk-46703","spans":[{"id":"spn-53771","text":"10"}]},{"id":"blk-46704","spans":[{"id":"spn-53772","text":"K4: κ-Modulated Hop Decay"}]},{"id":"blk-46705","spans":[{"id":"spn-53773","text":"κ"}]},{"id":"blk-46706","spans":[{"id":"spn-53774","text":"+2-3pp QA"}]}],[{"id":"blk-46707","spans":[{"id":"spn-53775","text":"11"}]},{"id":"blk-46708","spans":[{"id":"spn-53776","text":"K5: Fault-Line Boosting"}]},{"id":"blk-46709","spans":[{"id":"spn-53777","text":"κ"}]},{"id":"blk-46710","spans":[{"id":"spn-53778","text":"+2-4pp QA"}]}],[{"id":"blk-46711","spans":[{"id":"spn-53779","text":"12"}]},{"id":"blk-46712","spans":[{"id":"spn-53780","text":"S