{"bendscript":"0.1","blocks":[{"id":"blk-45960","kind":"heading","level":1,"spans":[{"id":"spn-52228","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-45961","kind":"heading","level":2,"spans":[{"id":"spn-52229","text":"Mission"}]},{"id":"blk-45962","kind":"paragraph","spans":[{"id":"spn-52230","text":"Push Graphonomous LongMemEval from "},{"id":"spn-52231","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-52232","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-45963","kind":"heading","level":2,"spans":[{"id":"spn-52233","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-45965","spans":[{"id":"spn-52234","text":"Metric"}]},{"id":"blk-45966","spans":[{"id":"spn-52235","text":"Value"}]},{"id":"blk-45967","spans":[{"id":"spn-52236","text":"Gap to Target"}]}],"id":"blk-45964","kind":"table","rows":[[{"id":"blk-45968","spans":[{"id":"spn-52237","text":"Session Hit Rate (SHR)"}]},{"id":"blk-45969","spans":[{"id":"spn-52238","text":"90.4%"}]},{"id":"blk-45970","spans":[{"id":"spn-52239","text":"+6.6pp to 97%"}]}],[{"id":"blk-45971","spans":[{"id":"spn-52240","text":"QA Proxy Score"}]},{"id":"blk-45972","spans":[{"id":"spn-52241","text":"73.04%"}]},{"id":"blk-45973","spans":[{"id":"spn-52242","text":"+22pp to 95%"}]}],[{"id":"blk-45974","spans":[{"id":"spn-52243","text":"Multi-session SHR"}]},{"id":"blk-45975","spans":[{"id":"spn-52244","marks":["bold"],"text":"85.0%"}]},{"id":"blk-45976","spans":[{"id":"spn-52245","text":"worst category"}]}],[{"id":"blk-45977","spans":[{"id":"spn-52246","text":"Multi-session recall"}]},{"id":"blk-45978","spans":[{"id":"spn-52247","marks":["bold"],"text":"60.5%"}]},{"id":"blk-45979","spans":[{"id":"spn-52248","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-45980","spans":[{"id":"spn-52249","text":"Temporal SHR"}]},{"id":"blk-45981","spans":[{"id":"spn-52250","text":"95.0%"}]},{"id":"blk-45982","spans":[{"id":"spn-52251","text":"strong"}]}],[{"id":"blk-45983","spans":[{"id":"spn-52252","text":"Temporal QA proxy"}]},{"id":"blk-45984","spans":[{"id":"spn-52253","text":"74.2%"}]},{"id":"blk-45985","spans":[{"id":"spn-52254","text":"gap despite good SHR"}]}],[{"id":"blk-45986","spans":[{"id":"spn-52255","text":"Abstention accuracy"}]},{"id":"blk-45987","spans":[{"id":"spn-52256","marks":["bold"],"text":"0.0%"}]},{"id":"blk-45988","spans":[{"id":"spn-52257","text":"broken threshold"}]}],[{"id":"blk-45989","spans":[{"id":"spn-52258","text":"Retrieval: similarity_limit"}]},{"id":"blk-45990","spans":[{"id":"spn-52259","text":"10"}]},{"id":"blk-45991","spans":[{"id":"spn-52260","text":"too few for multi-session"}]}],[{"id":"blk-45992","spans":[{"id":"spn-52261","text":"Retrieval: final_limit"}]},{"id":"blk-45993","spans":[{"id":"spn-52262","text":"20"}]},{"id":"blk-45994","spans":[{"id":"spn-52263","text":""}]}],[{"id":"blk-45995","spans":[{"id":"spn-52264","text":"Retrieval: expansion_hops"}]},{"id":"blk-45996","spans":[{"id":"spn-52265","text":"1"}]},{"id":"blk-45997","spans":[{"id":"spn-52266","text":"can't reach cross-session nodes"}]}],[{"id":"blk-45998","spans":[{"id":"spn-52267","text":"Retrieval: hop_decay"}]},{"id":"blk-45999","spans":[{"id":"spn-52268","text":"0.85 (flat)"}]},{"id":"blk-46000","spans":[{"id":"spn-52269","text":"not topology-aware"}]}],[{"id":"blk-46001","spans":[{"id":"spn-52270","text":"Deliberation"}]},{"id":"blk-46002","spans":[{"id":"spn-52271","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-46003","spans":[{"id":"spn-52272","text":"no iterative retrieval"}]}],[{"id":"blk-46004","spans":[{"id":"spn-52273","text":"Temporal indexing"}]},{"id":"blk-46005","spans":[{"id":"spn-52274","text":"none"}]},{"id":"blk-46006","spans":[{"id":"spn-52275","text":"biggest gap vs Chronos"}]}],[{"id":"blk-46007","spans":[{"id":"spn-52276","text":"Session edges at ingestion"}]},{"id":"blk-46008","spans":[{"id":"spn-52277","marks":["bold"],"text":"none"}]},{"id":"blk-46009","spans":[{"id":"spn-52278","text":"turns stored as isolated nodes"}]}],[{"id":"blk-46010","spans":[{"id":"spn-52279","text":"Cross-session entity edges"}]},{"id":"blk-46011","spans":[{"id":"spn-52280","marks":["bold"],"text":"none"}]},{"id":"blk-46012","spans":[{"id":"spn-52281","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-46013","kind":"heading","level":2,"spans":[{"id":"spn-52282","text":"Competitive Landscape"}]},{"head":[{"id":"blk-46015","spans":[{"id":"spn-52283","text":"System"}]},{"id":"blk-46016","spans":[{"id":"spn-52284","text":"Score"}]},{"id":"blk-46017","spans":[{"id":"spn-52285","text":"Key Technique"}]}],"id":"blk-46014","kind":"table","rows":[[{"id":"blk-46018","spans":[{"id":"spn-52286","text":"Supermemory ASMR"}]},{"id":"blk-46019","spans":[{"id":"spn-52287","text":"~99%"}]},{"id":"blk-46020","spans":[{"id":"spn-52288","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-46021","spans":[{"id":"spn-52289","text":"Chronos"}]},{"id":"blk-46022","spans":[{"id":"spn-52290","text":"95.6%"}]},{"id":"blk-46023","spans":[{"id":"spn-52291","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-46024","spans":[{"id":"spn-52292","text":"Mastra OM"}]},{"id":"blk-46025","spans":[{"id":"spn-52293","text":"94.87%"}]},{"id":"blk-46026","spans":[{"id":"spn-52294","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-46027","spans":[{"id":"spn-52295","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-46028","spans":[{"id":"spn-52296","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-46029","spans":[{"id":"spn-52297","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-46030","spans":[{"id":"spn-52298","text":"Emergence AI"}]},{"id":"blk-46031","spans":[{"id":"spn-52299","text":"86%"}]},{"id":"blk-46032","spans":[{"id":"spn-52300","text":"Well-tuned RAG only"}]}],[{"id":"blk-46033","spans":[{"id":"spn-52301","text":"Hindsight (Vectorize)"}]},{"id":"blk-46034","spans":[{"id":"spn-52302","text":"91.4% SHR"}]},{"id":"blk-46035","spans":[{"id":"spn-52303","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-46036","kind":"paragraph","spans":[{"id":"spn-52304","text":"---"}]},{"id":"blk-46037","kind":"heading","level":2,"spans":[{"id":"spn-52305","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-52306","marks":["code"],"text":"shr-optimization"},{"id":"spn-52307","text":")"}]},{"id":"blk-46038","kind":"paragraph","spans":[{"id":"spn-52308","text":"The SHR gap is primarily driven by "},{"id":"spn-52309","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-52310","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-46039","kind":"heading","level":3,"spans":[{"id":"spn-52311","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-46040","kind":"heading","level":4,"spans":[{"id":"spn-52312","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-46041","kind":"paragraph","spans":[{"id":"spn-52313","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52314","text":" "},{"id":"spn-52315","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-52316","text":" "},{"id":"spn-52317","marks":["bold"],"text":"File:"},{"id":"spn-52318","text":" "},{"id":"spn-52319","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-52320","text":" → "},{"id":"spn-52321","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-46042","kind":"paragraph","spans":[{"id":"spn-52322","text":"Currently "},{"id":"spn-52323","marks":["code"],"text":"ingest_session/2"},{"id":"spn-52324","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-46043","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-46044","kind":"paragraph","spans":[{"id":"spn-52325","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-46045","kind":"heading","level":4,"spans":[{"id":"spn-52326","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-46046","kind":"paragraph","spans":[{"id":"spn-52327","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52328","text":" "},{"id":"spn-52329","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-52330","text":" "},{"id":"spn-52331","marks":["bold"],"text":"File:"},{"id":"spn-52332","text":" "},{"id":"spn-52333","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-52334","text":" (new post-ingestion phase)"}]},{"id":"blk-46047","kind":"paragraph","spans":[{"id":"spn-52335","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-46048","items":[{"blocks":[{"id":"blk-46050","kind":"paragraph","spans":[{"id":"spn-52336","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-46049","kind":"list-item"},{"blocks":[{"id":"blk-46052","kind":"paragraph","spans":[{"id":"spn-52337","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-52338","marks":["code"],"text":":related"},{"id":"spn-52339","text":" edges"}]}],"id":"blk-46051","kind":"list-item"},{"blocks":[{"id":"blk-46054","kind":"paragraph","spans":[{"id":"spn-52340","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-46053","kind":"list-item"},{"blocks":[{"id":"blk-46056","kind":"paragraph","spans":[{"id":"spn-52341","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-46055","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46057","kind":"paragraph","spans":[{"id":"spn-52342","text":"Implementation approach:"}]},{"id":"blk-46058","items":[{"blocks":[{"id":"blk-46060","kind":"paragraph","spans":[{"id":"spn-52343","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-46059","kind":"list-item"},{"blocks":[{"id":"blk-46062","kind":"paragraph","spans":[{"id":"spn-52344","text":"Better: use existing "},{"id":"spn-52345","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-52346","text":" which already does edge extraction"}]}],"id":"blk-46061","kind":"list-item"},{"blocks":[{"id":"blk-46064","kind":"paragraph","spans":[{"id":"spn-52347","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-46063","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46065","kind":"heading","level":4,"spans":[{"id":"spn-52348","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-46066","kind":"paragraph","spans":[{"id":"spn-52349","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52350","text":" "},{"id":"spn-52351","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-52352","text":" "},{"id":"spn-52353","marks":["bold"],"text":"File:"},{"id":"spn-52354","text":" "},{"id":"spn-52355","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-46067","kind":"paragraph","spans":[{"id":"spn-52356","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-46068","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-46069","kind":"paragraph","spans":[{"id":"spn-52357","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-46070","kind":"heading","level":4,"spans":[{"id":"spn-52358","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-46071","kind":"paragraph","spans":[{"id":"spn-52359","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52360","text":" "},{"id":"spn-52361","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-52362","text":" "},{"id":"spn-52363","marks":["bold"],"text":"File:"},{"id":"spn-52364","text":" "},{"id":"spn-52365","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-52366","text":" → "},{"id":"spn-52367","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-46072","kind":"paragraph","spans":[{"id":"spn-52368","text":"Change retrieval call from:"}]},{"id":"blk-46073","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-46074","kind":"paragraph","spans":[{"id":"spn-52369","text":"To:"}]},{"id":"blk-46075","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-46076","kind":"paragraph","spans":[{"id":"spn-52370","text":"For even better results, make limits adaptive:"}]},{"id":"blk-46077","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-46078","kind":"heading","level":3,"spans":[{"id":"spn-52371","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-46079","kind":"heading","level":4,"spans":[{"id":"spn-52372","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-46080","kind":"paragraph","spans":[{"id":"spn-52373","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52374","text":" "},{"id":"spn-52375","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-52376","text":" "},{"id":"spn-52377","marks":["bold"],"text":"File:"},{"id":"spn-52378","text":" "},{"id":"spn-52379","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46081","kind":"paragraph","spans":[{"id":"spn-52380","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-46082","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-46083","kind":"paragraph","spans":[{"id":"spn-52381","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-46084","kind":"heading","level":4,"spans":[{"id":"spn-52382","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-46085","kind":"paragraph","spans":[{"id":"spn-52383","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52384","text":" "},{"id":"spn-52385","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-52386","text":" "},{"id":"spn-52387","marks":["bold"],"text":"File:"},{"id":"spn-52388","text":" "},{"id":"spn-52389","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46086","kind":"paragraph","spans":[{"id":"spn-52390","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-46087","kind":"heading","level":4,"spans":[{"id":"spn-52391","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-46088","kind":"paragraph","spans":[{"id":"spn-52392","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52393","text":" "},{"id":"spn-52394","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-52395","text":" "},{"id":"spn-52396","marks":["bold"],"text":"Files:"},{"id":"spn-52397","text":" "},{"id":"spn-52398","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-52399","text":", "},{"id":"spn-52400","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46089","kind":"paragraph","spans":[{"id":"spn-52401","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-46090","kind":"heading","level":4,"spans":[{"id":"spn-52402","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-46091","kind":"paragraph","spans":[{"id":"spn-52403","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52404","text":" "},{"id":"spn-52405","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-52406","text":" "},{"id":"spn-52407","marks":["bold"],"text":"File:"},{"id":"spn-52408","text":" "},{"id":"spn-52409","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-52410","text":" → "},{"id":"spn-52411","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-46092","kind":"paragraph","spans":[{"id":"spn-52412","text":"Current abstention threshold ("},{"id":"spn-52413","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-52414","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-46093","items":[{"blocks":[{"id":"blk-46095","kind":"paragraph","spans":[{"id":"spn-52415","text":"Use confidence gap: "},{"id":"spn-52416","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-52417","text":" → likely no clear answer"}]}],"id":"blk-46094","kind":"list-item"},{"blocks":[{"id":"blk-46097","kind":"paragraph","spans":[{"id":"spn-52418","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-46096","kind":"list-item"},{"blocks":[{"id":"blk-46099","kind":"paragraph","spans":[{"id":"spn-52419","text":"Raise score threshold to "},{"id":"spn-52420","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-46098","kind":"list-item"},{"blocks":[{"id":"blk-46101","kind":"paragraph","spans":[{"id":"spn-52421","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-46100","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46102","kind":"paragraph","spans":[{"id":"spn-52422","text":"---"}]},{"id":"blk-46103","kind":"heading","level":2,"spans":[{"id":"spn-52423","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-52424","marks":["code"],"text":"kappa-optimization"},{"id":"spn-52425","text":")"}]},{"id":"blk-46104","kind":"paragraph","spans":[{"id":"spn-52426","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-46105","kind":"heading","level":3,"spans":[{"id":"spn-52427","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-46106","kind":"heading","level":4,"spans":[{"id":"spn-52428","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-46107","kind":"paragraph","spans":[{"id":"spn-52429","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52430","text":" "},{"id":"spn-52431","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-52432","text":" "},{"id":"spn-52433","marks":["bold"],"text":"File:"},{"id":"spn-52434","text":" "},{"id":"spn-52435","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-46108","kind":"paragraph","spans":[{"id":"spn-52436","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-52437","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-52438","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-52439","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-52440","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-46109","kind":"paragraph","spans":[{"id":"spn-52441","text":"Implementation:"}]},{"id":"blk-46110","items":[{"blocks":[{"id":"blk-46112","kind":"paragraph","spans":[{"id":"spn-52442","text":"In "},{"id":"spn-52443","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-52444","text":", after building the initial prompt, add a "},{"id":"spn-52445","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-52446","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-46111","kind":"list-item"},{"blocks":[{"id":"blk-46114","kind":"paragraph","spans":[{"id":"spn-52447","text":"In the main "},{"id":"spn-52448","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-52449","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-46113","kind":"list-item"},{"blocks":[{"id":"blk-46116","kind":"paragraph","spans":[{"id":"spn-52450","text":"Use "},{"id":"spn-52451","marks":["code"],"text":"fault_line_edges"},{"id":"spn-52452","text":" to decide which partition side needs more evidence"}]}],"id":"blk-46115","kind":"list-item"},{"blocks":[{"id":"blk-46118","kind":"paragraph","spans":[{"id":"spn-52453","text":"Wire through "},{"id":"spn-52454","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-52455","text":" with a "},{"id":"spn-52456","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-52457","text":" option"}]}],"id":"blk-46117","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46119","kind":"paragraph","spans":[{"id":"spn-52458","text":"Test: Run "},{"id":"spn-52459","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-52460","text":" before and after. QA proxy score should increase."}]},{"id":"blk-46120","kind":"heading","level":4,"spans":[{"id":"spn-52461","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-46121","kind":"paragraph","spans":[{"id":"spn-52462","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52463","text":" "},{"id":"spn-52464","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-52465","text":" "},{"id":"spn-52466","marks":["bold"],"text":"File:"},{"id":"spn-52467","text":" "},{"id":"spn-52468","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46122","kind":"paragraph","spans":[{"id":"spn-52469","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-46123","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-46124","kind":"paragraph","spans":[{"id":"spn-52470","text":"This requires restructuring "},{"id":"spn-52471","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-52472","text":" to: 1. Run similarity search (seeds) 2. Do a preliminary 1-hop expansion 3. Run topology analysis on the expanded set 4. If κ > 0, do additional hops up to "},{"id":"spn-52473","marks":["code"],"text":"effective_hops"}]},{"id":"blk-46125","kind":"heading","level":4,"spans":[{"id":"spn-52474","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-46126","kind":"paragraph","spans":[{"id":"spn-52475","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52476","text":" "},{"id":"spn-52477","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-52478","text":" "},{"id":"spn-52479","marks":["bold"],"text":"Files:"},{"id":"spn-52480","text":" "},{"id":"spn-52481","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-52482","text":", "},{"id":"spn-52483","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-52484","text":", edge types"}]},{"id":"blk-46127","kind":"paragraph","spans":[{"id":"spn-52485","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-52486","marks":["code"],"text":"contradicts"},{"id":"spn-52487","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-46128","kind":"paragraph","spans":[{"id":"spn-52488","text":"Implementation:"}]},{"id":"blk-46129","items":[{"blocks":[{"id":"blk-46131","kind":"paragraph","spans":[{"id":"spn-52489","text":"In "},{"id":"spn-52490","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-52491","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-52492","marks":["code"],"text":":contradicts"}]}],"id":"blk-46130","kind":"list-item"},{"blocks":[{"id":"blk-46133","kind":"paragraph","spans":[{"id":"spn-52493","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-52494","marks":["code"],"text":"inserted_at"},{"id":"spn-52495","text":" timestamps"}]}],"id":"blk-46132","kind":"list-item"},{"blocks":[{"id":"blk-46135","kind":"paragraph","spans":[{"id":"spn-52496","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-46134","kind":"list-item"},{"blocks":[{"id":"blk-46137","kind":"paragraph","spans":[{"id":"spn-52497","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-46136","kind":"list-item"},{"blocks":[{"id":"blk-46139","kind":"paragraph","spans":[{"id":"spn-52498","text":"Add "},{"id":"spn-52499","marks":["code"],"text":":supersedes"},{"id":"spn-52500","text":" edge type if not present"}]}],"id":"blk-46138","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46140","kind":"heading","level":3,"spans":[{"id":"spn-52501","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-46141","kind":"heading","level":4,"spans":[{"id":"spn-52502","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-46142","kind":"paragraph","spans":[{"id":"spn-52503","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52504","text":" "},{"id":"spn-52505","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-52506","text":" "},{"id":"spn-52507","marks":["bold"],"text":"File:"},{"id":"spn-52508","text":" "},{"id":"spn-52509","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46143","kind":"paragraph","spans":[{"id":"spn-52510","text":"Replace flat "},{"id":"spn-52511","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-52512","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-46144","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-46145","items":[{"blocks":[{"id":"blk-46147","kind":"paragraph","spans":[{"id":"spn-52513","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-46146","kind":"list-item"},{"blocks":[{"id":"blk-46149","kind":"paragraph","spans":[{"id":"spn-52514","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-46148","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46150","kind":"paragraph","spans":[{"id":"spn-52515","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-46151","kind":"heading","level":4,"spans":[{"id":"spn-52516","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-46152","kind":"paragraph","spans":[{"id":"spn-52517","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52518","text":" "},{"id":"spn-52519","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-52520","text":" "},{"id":"spn-52521","marks":["bold"],"text":"File:"},{"id":"spn-52522","text":" "},{"id":"spn-52523","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-46153","kind":"paragraph","spans":[{"id":"spn-52524","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-52525","marks":["code"],"text":"fault_line_edges"},{"id":"spn-52526","text":":"}]},{"id":"blk-46154","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-46155","kind":"heading","level":4,"spans":[{"id":"spn-52527","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-46156","kind":"paragraph","spans":[{"id":"spn-52528","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52529","text":" "},{"id":"spn-52530","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-52531","text":" "},{"id":"spn-52532","marks":["bold"],"text":"File:"},{"id":"spn-52533","text":" "},{"id":"spn-52534","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-52535","text":" (or new module)"}]},{"id":"blk-46157","kind":"paragraph","spans":[{"id":"spn-52536","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-46158","items":[{"blocks":[{"id":"blk-46160","kind":"paragraph","spans":[{"id":"spn-52537","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-46159","kind":"list-item"},{"blocks":[{"id":"blk-46162","kind":"paragraph","spans":[{"id":"spn-52538","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-46161","kind":"list-item"},{"blocks":[{"id":"blk-46164","kind":"paragraph","spans":[{"id":"spn-52539","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-46163","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46165","kind":"paragraph","spans":[{"id":"spn-52540","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-46166","kind":"heading","level":3,"spans":[{"id":"spn-52541","text":"κ Phase 3 — Polish"}]},{"id":"blk-46167","kind":"heading","level":4,"spans":[{"id":"spn-52542","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-46168","kind":"paragraph","spans":[{"id":"spn-52543","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52544","text":" "},{"id":"spn-52545","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-46169","kind":"paragraph","spans":[{"id":"spn-52546","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-46170","kind":"heading","level":4,"spans":[{"id":"spn-52547","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-46171","kind":"paragraph","spans":[{"id":"spn-52548","marks":["bold"],"text":"Goal ID:"},{"id":"spn-52549","text":" "},{"id":"spn-52550","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-46172","kind":"paragraph","spans":[{"id":"spn-52551","text":"Use "},{"id":"spn-52552","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-52553","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-46173","kind":"paragraph","spans":[{"id":"spn-52554","text":"---"}]},{"id":"blk-46174","kind":"heading","level":2,"spans":[{"id":"spn-52555","text":"Recommended Implementation Order"}]},{"id":"blk-46175","kind":"paragraph","spans":[{"id":"spn-52556","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-46177","spans":[{"id":"spn-52557","text":"Order"}]},{"id":"blk-46178","spans":[{"id":"spn-52558","text":"Goal"}]},{"id":"blk-46179","spans":[{"id":"spn-52559","text":"Tag"}]},{"id":"blk-46180","spans":[{"id":"spn-52560","text":"Expected Impact"}]}],"id":"blk-46176","kind":"table","rows":[[{"id":"blk-46181","spans":[{"id":"spn-52561","text":"1"}]},{"id":"blk-46182","spans":[{"id":"spn-52562","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-46183","spans":[{"id":"spn-52563","text":"shr"}]},{"id":"blk-46184","spans":[{"id":"spn-52564","text":"+3-5pp SHR"}]}],[{"id":"blk-46185","spans":[{"id":"spn-52565","text":"2"}]},{"id":"blk-46186","spans":[{"id":"spn-52566","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-46187","spans":[{"id":"spn-52567","text":"shr"}]},{"id":"blk-46188","spans":[{"id":"spn-52568","text":"+2-3pp SHR"}]}],[{"id":"blk-46189","spans":[{"id":"spn-52569","text":"3"}]},{"id":"blk-46190","spans":[{"id":"spn-52570","text":"S3: Session Summary Nodes"}]},{"id":"blk-46191","spans":[{"id":"spn-52571","text":"shr"}]},{"id":"blk-46192","spans":[{"id":"spn-52572","text":"+3-5pp SHR"}]}],[{"id":"blk-46193","spans":[{"id":"spn-52573","text":"4"}]},{"id":"blk-46194","spans":[{"id":"spn-52574","text":"S2: Cross-Session Entity Edges"}]},{"id":"blk-46195","spans":[{"id":"spn-52575","text":"shr"}]},{"id":"blk-46196","spans":[{"id":"spn-52576","text":"+3-4pp SHR"}]}],[{"id":"blk-46197","spans":[{"id":"spn-52577","text":"5"}]},{"id":"blk-46198","spans":[{"id":"spn-52578","text":"S5: Session Diversity Re-ranking"}]},{"id":"blk-46199","spans":[{"id":"spn-52579","text":"shr"}]},{"id":"blk-46200","spans":[{"id":"spn-52580","text":"+2-3pp SHR"}]}],[{"id":"blk-46201","spans":[{"id":"spn-52581","text":"6"}]},{"id":"blk-46202","spans":[{"id":"spn-52582","text":"S8: Abstention Calibration"}]},{"id":"blk-46203","spans":[{"id":"spn-52583","text":"shr"}]},{"id":"blk-46204","spans":[{"id":"spn-52584","text":"+2-3pp QA"}]}],[{"id":"blk-46205","spans":[{"id":"spn-52585","text":"7"}]},{"id":"blk-46206","spans":[{"id":"spn-52586","text":"K1: Iterative Retrieval in Deliberation"}]},{"id":"blk-46207","spans":[{"id":"spn-52587","text":"κ"}]},{"id":"blk-46208","spans":[{"id":"spn-52588","text":"+8-12pp QA"}]}],[{"id":"blk-46209","spans":[{"id":"spn-52589","text":"8"}]},{"id":"blk-46210","spans":[{"id":"spn-52590","text":"K2: κ-Adaptive Retrieval Depth"}]},{"id":"blk-46211","spans":[{"id":"spn-52591","text":"κ"}]},{"id":"blk-46212","spans":[{"id":"spn-52592","text":"+3-5pp QA"}]}],[{"id":"blk-46213","spans":[{"id":"spn-52593","text":"9"}]},{"id":"blk-46214","spans":[{"id":"spn-52594","text":"K3: Temporal Contradiction via κ"}]},{"id":"blk-46215","spans":[{"id":"spn-52595","text":"κ"}]},{"id":"blk-46216","spans":[{"id":"spn-52596","text":"+5-8pp QA"}]}],[{"id":"blk-46217","spans":[{"id":"spn-52597","text":"10"}]},{"id":"blk-46218","spans":[{"id":"spn-52598","text":"K4: κ-Modulated Hop Decay"}]},{"id":"blk-46219","spans":[{"id":"spn-52599","text":"κ"}]},{"id":"blk-46220","spans":[{"id":"spn-52600","text":"+2-3pp QA"}]}],[{"id":"blk-46221","spans":[{"id":"spn-52601","text":"11"}]},{"id":"blk-46222","spans":[{"id":"spn-52602","text":"K5: Fault-Line Boosting"}]},{"id":"blk-46223","spans":[{"id":"spn-52603","text":"κ"}]},{"id":"blk-46224","spans":[{"id":"spn-52604","text":"+2-4pp QA"}]}],[{"id":"blk-46225","spans":[{"id":"spn-52605","text":"12"}]},{"id":"blk-46226","spans":[{"id":"spn-52606","text":"S