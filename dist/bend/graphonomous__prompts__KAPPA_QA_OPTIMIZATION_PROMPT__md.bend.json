{"bendscript":"0.1","blocks":[{"id":"blk-71105","kind":"heading","level":1,"spans":[{"id":"spn-102052","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-71106","kind":"heading","level":2,"spans":[{"id":"spn-102053","text":"Mission"}]},{"id":"blk-71107","kind":"paragraph","spans":[{"id":"spn-102054","text":"Push Graphonomous LongMemEval from "},{"id":"spn-102055","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-102056","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-71108","kind":"heading","level":2,"spans":[{"id":"spn-102057","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-71110","spans":[{"id":"spn-102058","text":"Metric"}]},{"id":"blk-71111","spans":[{"id":"spn-102059","text":"Value"}]},{"id":"blk-71112","spans":[{"id":"spn-102060","text":"Gap to Target"}]}],"id":"blk-71109","kind":"table","rows":[[{"id":"blk-71113","spans":[{"id":"spn-102061","text":"Session Hit Rate (SHR)"}]},{"id":"blk-71114","spans":[{"id":"spn-102062","text":"90.4%"}]},{"id":"blk-71115","spans":[{"id":"spn-102063","text":"+6.6pp to 97%"}]}],[{"id":"blk-71116","spans":[{"id":"spn-102064","text":"QA Proxy Score"}]},{"id":"blk-71117","spans":[{"id":"spn-102065","text":"73.04%"}]},{"id":"blk-71118","spans":[{"id":"spn-102066","text":"+22pp to 95%"}]}],[{"id":"blk-71119","spans":[{"id":"spn-102067","text":"Multi-session SHR"}]},{"id":"blk-71120","spans":[{"id":"spn-102068","marks":["bold"],"text":"85.0%"}]},{"id":"blk-71121","spans":[{"id":"spn-102069","text":"worst category"}]}],[{"id":"blk-71122","spans":[{"id":"spn-102070","text":"Multi-session recall"}]},{"id":"blk-71123","spans":[{"id":"spn-102071","marks":["bold"],"text":"60.5%"}]},{"id":"blk-71124","spans":[{"id":"spn-102072","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-71125","spans":[{"id":"spn-102073","text":"Temporal SHR"}]},{"id":"blk-71126","spans":[{"id":"spn-102074","text":"95.0%"}]},{"id":"blk-71127","spans":[{"id":"spn-102075","text":"strong"}]}],[{"id":"blk-71128","spans":[{"id":"spn-102076","text":"Temporal QA proxy"}]},{"id":"blk-71129","spans":[{"id":"spn-102077","text":"74.2%"}]},{"id":"blk-71130","spans":[{"id":"spn-102078","text":"gap despite good SHR"}]}],[{"id":"blk-71131","spans":[{"id":"spn-102079","text":"Abstention accuracy"}]},{"id":"blk-71132","spans":[{"id":"spn-102080","marks":["bold"],"text":"0.0%"}]},{"id":"blk-71133","spans":[{"id":"spn-102081","text":"broken threshold"}]}],[{"id":"blk-71134","spans":[{"id":"spn-102082","text":"Retrieval: similarity_limit"}]},{"id":"blk-71135","spans":[{"id":"spn-102083","text":"10"}]},{"id":"blk-71136","spans":[{"id":"spn-102084","text":"too few for multi-session"}]}],[{"id":"blk-71137","spans":[{"id":"spn-102085","text":"Retrieval: final_limit"}]},{"id":"blk-71138","spans":[{"id":"spn-102086","text":"20"}]},{"id":"blk-71139","spans":[{"id":"spn-102087","text":""}]}],[{"id":"blk-71140","spans":[{"id":"spn-102088","text":"Retrieval: expansion_hops"}]},{"id":"blk-71141","spans":[{"id":"spn-102089","text":"1"}]},{"id":"blk-71142","spans":[{"id":"spn-102090","text":"can't reach cross-session nodes"}]}],[{"id":"blk-71143","spans":[{"id":"spn-102091","text":"Retrieval: hop_decay"}]},{"id":"blk-71144","spans":[{"id":"spn-102092","text":"0.85 (flat)"}]},{"id":"blk-71145","spans":[{"id":"spn-102093","text":"not topology-aware"}]}],[{"id":"blk-71146","spans":[{"id":"spn-102094","text":"Deliberation"}]},{"id":"blk-71147","spans":[{"id":"spn-102095","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-71148","spans":[{"id":"spn-102096","text":"no iterative retrieval"}]}],[{"id":"blk-71149","spans":[{"id":"spn-102097","text":"Temporal indexing"}]},{"id":"blk-71150","spans":[{"id":"spn-102098","text":"none"}]},{"id":"blk-71151","spans":[{"id":"spn-102099","text":"biggest gap vs Chronos"}]}],[{"id":"blk-71152","spans":[{"id":"spn-102100","text":"Session edges at ingestion"}]},{"id":"blk-71153","spans":[{"id":"spn-102101","marks":["bold"],"text":"none"}]},{"id":"blk-71154","spans":[{"id":"spn-102102","text":"turns stored as isolated nodes"}]}],[{"id":"blk-71155","spans":[{"id":"spn-102103","text":"Cross-session entity edges"}]},{"id":"blk-71156","spans":[{"id":"spn-102104","marks":["bold"],"text":"none"}]},{"id":"blk-71157","spans":[{"id":"spn-102105","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-71158","kind":"heading","level":2,"spans":[{"id":"spn-102106","text":"Competitive Landscape"}]},{"head":[{"id":"blk-71160","spans":[{"id":"spn-102107","text":"System"}]},{"id":"blk-71161","spans":[{"id":"spn-102108","text":"Score"}]},{"id":"blk-71162","spans":[{"id":"spn-102109","text":"Key Technique"}]}],"id":"blk-71159","kind":"table","rows":[[{"id":"blk-71163","spans":[{"id":"spn-102110","text":"Supermemory ASMR"}]},{"id":"blk-71164","spans":[{"id":"spn-102111","text":"~99%"}]},{"id":"blk-71165","spans":[{"id":"spn-102112","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-71166","spans":[{"id":"spn-102113","text":"Chronos"}]},{"id":"blk-71167","spans":[{"id":"spn-102114","text":"95.6%"}]},{"id":"blk-71168","spans":[{"id":"spn-102115","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-71169","spans":[{"id":"spn-102116","text":"Mastra OM"}]},{"id":"blk-71170","spans":[{"id":"spn-102117","text":"94.87%"}]},{"id":"blk-71171","spans":[{"id":"spn-102118","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-71172","spans":[{"id":"spn-102119","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-71173","spans":[{"id":"spn-102120","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-71174","spans":[{"id":"spn-102121","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-71175","spans":[{"id":"spn-102122","text":"Emergence AI"}]},{"id":"blk-71176","spans":[{"id":"spn-102123","text":"86%"}]},{"id":"blk-71177","spans":[{"id":"spn-102124","text":"Well-tuned RAG only"}]}],[{"id":"blk-71178","spans":[{"id":"spn-102125","text":"Hindsight (Vectorize)"}]},{"id":"blk-71179","spans":[{"id":"spn-102126","text":"91.4% SHR"}]},{"id":"blk-71180","spans":[{"id":"spn-102127","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-71181","kind":"heading","level":2,"spans":[{"id":"spn-102128","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-102129","marks":["code"],"text":"shr-optimization"},{"id":"spn-102130","text":")"}]},{"id":"blk-71182","kind":"paragraph","spans":[{"id":"spn-102131","text":"The SHR gap is primarily driven by "},{"id":"spn-102132","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-102133","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-71183","kind":"heading","level":3,"spans":[{"id":"spn-102134","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-71184","kind":"heading","level":4,"spans":[{"id":"spn-102135","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-71185","kind":"paragraph","spans":[{"id":"spn-102136","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102137","text":" "},{"id":"spn-102138","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-102139","text":" "},{"id":"spn-102140","marks":["bold"],"text":"File:"},{"id":"spn-102141","text":" "},{"id":"spn-102142","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102143","text":" → "},{"id":"spn-102144","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-71186","kind":"paragraph","spans":[{"id":"spn-102145","text":"Currently "},{"id":"spn-102146","marks":["code"],"text":"ingest_session/2"},{"id":"spn-102147","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-71187","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-71188","kind":"paragraph","spans":[{"id":"spn-102148","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-71189","kind":"heading","level":4,"spans":[{"id":"spn-102149","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-71190","kind":"paragraph","spans":[{"id":"spn-102150","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102151","text":" "},{"id":"spn-102152","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-102153","text":" "},{"id":"spn-102154","marks":["bold"],"text":"File:"},{"id":"spn-102155","text":" "},{"id":"spn-102156","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102157","text":" (new post-ingestion phase)"}]},{"id":"blk-71191","kind":"paragraph","spans":[{"id":"spn-102158","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-71192","items":[{"blocks":[{"id":"blk-71194","kind":"paragraph","spans":[{"id":"spn-102159","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-71193","kind":"list-item"},{"blocks":[{"id":"blk-71196","kind":"paragraph","spans":[{"id":"spn-102160","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-102161","marks":["code"],"text":":related"},{"id":"spn-102162","text":" edges"}]}],"id":"blk-71195","kind":"list-item"},{"blocks":[{"id":"blk-71198","kind":"paragraph","spans":[{"id":"spn-102163","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-71197","kind":"list-item"},{"blocks":[{"id":"blk-71200","kind":"paragraph","spans":[{"id":"spn-102164","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-71199","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71201","kind":"paragraph","spans":[{"id":"spn-102165","text":"Implementation approach:"}]},{"id":"blk-71202","items":[{"blocks":[{"id":"blk-71204","kind":"paragraph","spans":[{"id":"spn-102166","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-71203","kind":"list-item"},{"blocks":[{"id":"blk-71206","kind":"paragraph","spans":[{"id":"spn-102167","text":"Better: use existing "},{"id":"spn-102168","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-102169","text":" which already does edge extraction"}]}],"id":"blk-71205","kind":"list-item"},{"blocks":[{"id":"blk-71208","kind":"paragraph","spans":[{"id":"spn-102170","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-71207","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71209","kind":"heading","level":4,"spans":[{"id":"spn-102171","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-71210","kind":"paragraph","spans":[{"id":"spn-102172","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102173","text":" "},{"id":"spn-102174","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-102175","text":" "},{"id":"spn-102176","marks":["bold"],"text":"File:"},{"id":"spn-102177","text":" "},{"id":"spn-102178","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-71211","kind":"paragraph","spans":[{"id":"spn-102179","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-71212","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-71213","kind":"paragraph","spans":[{"id":"spn-102180","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-71214","kind":"heading","level":4,"spans":[{"id":"spn-102181","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-71215","kind":"paragraph","spans":[{"id":"spn-102182","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102183","text":" "},{"id":"spn-102184","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-102185","text":" "},{"id":"spn-102186","marks":["bold"],"text":"File:"},{"id":"spn-102187","text":" "},{"id":"spn-102188","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102189","text":" → "},{"id":"spn-102190","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-71216","kind":"paragraph","spans":[{"id":"spn-102191","text":"Change retrieval call from:"}]},{"id":"blk-71217","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-71218","kind":"paragraph","spans":[{"id":"spn-102192","text":"To:"}]},{"id":"blk-71219","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-71220","kind":"paragraph","spans":[{"id":"spn-102193","text":"For even better results, make limits adaptive:"}]},{"id":"blk-71221","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-71222","kind":"heading","level":3,"spans":[{"id":"spn-102194","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-71223","kind":"heading","level":4,"spans":[{"id":"spn-102195","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-71224","kind":"paragraph","spans":[{"id":"spn-102196","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102197","text":" "},{"id":"spn-102198","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-102199","text":" "},{"id":"spn-102200","marks":["bold"],"text":"File:"},{"id":"spn-102201","text":" "},{"id":"spn-102202","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71225","kind":"paragraph","spans":[{"id":"spn-102203","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-71226","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-71227","kind":"paragraph","spans":[{"id":"spn-102204","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-71228","kind":"heading","level":4,"spans":[{"id":"spn-102205","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-71229","kind":"paragraph","spans":[{"id":"spn-102206","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102207","text":" "},{"id":"spn-102208","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-102209","text":" "},{"id":"spn-102210","marks":["bold"],"text":"File:"},{"id":"spn-102211","text":" "},{"id":"spn-102212","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71230","kind":"paragraph","spans":[{"id":"spn-102213","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-71231","kind":"heading","level":4,"spans":[{"id":"spn-102214","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-71232","kind":"paragraph","spans":[{"id":"spn-102215","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102216","text":" "},{"id":"spn-102217","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-102218","text":" "},{"id":"spn-102219","marks":["bold"],"text":"Files:"},{"id":"spn-102220","text":" "},{"id":"spn-102221","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102222","text":", "},{"id":"spn-102223","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71233","kind":"paragraph","spans":[{"id":"spn-102224","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-71234","kind":"heading","level":4,"spans":[{"id":"spn-102225","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-71235","kind":"paragraph","spans":[{"id":"spn-102226","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102227","text":" "},{"id":"spn-102228","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-102229","text":" "},{"id":"spn-102230","marks":["bold"],"text":"File:"},{"id":"spn-102231","text":" "},{"id":"spn-102232","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102233","text":" → "},{"id":"spn-102234","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-71236","kind":"paragraph","spans":[{"id":"spn-102235","text":"Current abstention threshold ("},{"id":"spn-102236","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-102237","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-71237","items":[{"blocks":[{"id":"blk-71239","kind":"paragraph","spans":[{"id":"spn-102238","text":"Use confidence gap: "},{"id":"spn-102239","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-102240","text":" → likely no clear answer"}]}],"id":"blk-71238","kind":"list-item"},{"blocks":[{"id":"blk-71241","kind":"paragraph","spans":[{"id":"spn-102241","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-71240","kind":"list-item"},{"blocks":[{"id":"blk-71243","kind":"paragraph","spans":[{"id":"spn-102242","text":"Raise score threshold to "},{"id":"spn-102243","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-71242","kind":"list-item"},{"blocks":[{"id":"blk-71245","kind":"paragraph","spans":[{"id":"spn-102244","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-71244","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71246","kind":"heading","level":2,"spans":[{"id":"spn-102245","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-102246","marks":["code"],"text":"kappa-optimization"},{"id":"spn-102247","text":")"}]},{"id":"blk-71247","kind":"paragraph","spans":[{"id":"spn-102248","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-71248","kind":"heading","level":3,"spans":[{"id":"spn-102249","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-71249","kind":"heading","level":4,"spans":[{"id":"spn-102250","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-71250","kind":"paragraph","spans":[{"id":"spn-102251","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102252","text":" "},{"id":"spn-102253","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-102254","text":" "},{"id":"spn-102255","marks":["bold"],"text":"File:"},{"id":"spn-102256","text":" "},{"id":"spn-102257","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-71251","kind":"paragraph","spans":[{"id":"spn-102258","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-102259","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-102260","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-102261","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-102262","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-71252","kind":"paragraph","spans":[{"id":"spn-102263","text":"Implementation:"}]},{"id":"blk-71253","items":[{"blocks":[{"id":"blk-71255","kind":"paragraph","spans":[{"id":"spn-102264","text":"In "},{"id":"spn-102265","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-102266","text":", after building the initial prompt, add a "},{"id":"spn-102267","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-102268","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-71254","kind":"list-item"},{"blocks":[{"id":"blk-71257","kind":"paragraph","spans":[{"id":"spn-102269","text":"In the main "},{"id":"spn-102270","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-102271","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-71256","kind":"list-item"},{"blocks":[{"id":"blk-71259","kind":"paragraph","spans":[{"id":"spn-102272","text":"Use "},{"id":"spn-102273","marks":["code"],"text":"fault_line_edges"},{"id":"spn-102274","text":" to decide which partition side needs more evidence"}]}],"id":"blk-71258","kind":"list-item"},{"blocks":[{"id":"blk-71261","kind":"paragraph","spans":[{"id":"spn-102275","text":"Wire through "},{"id":"spn-102276","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-102277","text":" with a "},{"id":"spn-102278","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-102279","text":" option"}]}],"id":"blk-71260","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71262","kind":"paragraph","spans":[{"id":"spn-102280","text":"Test: Run "},{"id":"spn-102281","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-102282","text":" before and after. QA proxy score should increase."}]},{"id":"blk-71263","kind":"heading","level":4,"spans":[{"id":"spn-102283","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-71264","kind":"paragraph","spans":[{"id":"spn-102284","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102285","text":" "},{"id":"spn-102286","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-102287","text":" "},{"id":"spn-102288","marks":["bold"],"text":"File:"},{"id":"spn-102289","text":" "},{"id":"spn-102290","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71265","kind":"paragraph","spans":[{"id":"spn-102291","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-71266","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-71267","kind":"paragraph","spans":[{"id":"spn-102292","text":"This requires restructuring "},{"id":"spn-102293","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-102294","text":" to:"}]},{"id":"blk-71268","items":[{"blocks":[{"id":"blk-71270","kind":"paragraph","spans":[{"id":"spn-102295","text":"Run similarity search (seeds)"}]}],"id":"blk-71269","kind":"list-item"},{"blocks":[{"id":"blk-71272","kind":"paragraph","spans":[{"id":"spn-102296","text":"Do a preliminary 1-hop expansion"}]}],"id":"blk-71271","kind":"list-item"},{"blocks":[{"id":"blk-71274","kind":"paragraph","spans":[{"id":"spn-102297","text":"Run topology analysis on the expanded set"}]}],"id":"blk-71273","kind":"list-item"},{"blocks":[{"id":"blk-71276","kind":"paragraph","spans":[{"id":"spn-102298","text":"If κ > 0, do additional hops up to "},{"id":"spn-102299","marks":["code"],"text":"effective_hops"}]}],"id":"blk-71275","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71277","kind":"heading","level":4,"spans":[{"id":"spn-102300","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-71278","kind":"paragraph","spans":[{"id":"spn-102301","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102302","text":" "},{"id":"spn-102303","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-102304","text":" "},{"id":"spn-102305","marks":["bold"],"text":"Files:"},{"id":"spn-102306","text":" "},{"id":"spn-102307","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-102308","text":", "},{"id":"spn-102309","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-102310","text":", edge types"}]},{"id":"blk-71279","kind":"paragraph","spans":[{"id":"spn-102311","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-102312","marks":["code"],"text":"contradicts"},{"id":"spn-102313","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-71280","kind":"paragraph","spans":[{"id":"spn-102314","text":"Implementation:"}]},{"id":"blk-71281","items":[{"blocks":[{"id":"blk-71283","kind":"paragraph","spans":[{"id":"spn-102315","text":"In "},{"id":"spn-102316","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-102317","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-102318","marks":["code"],"text":":contradicts"}]}],"id":"blk-71282","kind":"list-item"},{"blocks":[{"id":"blk-71285","kind":"paragraph","spans":[{"id":"spn-102319","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-102320","marks":["code"],"text":"inserted_at"},{"id":"spn-102321","text":" timestamps"}]}],"id":"blk-71284","kind":"list-item"},{"blocks":[{"id":"blk-71287","kind":"paragraph","spans":[{"id":"spn-102322","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-71286","kind":"list-item"},{"blocks":[{"id":"blk-71289","kind":"paragraph","spans":[{"id":"spn-102323","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-71288","kind":"list-item"},{"blocks":[{"id":"blk-71291","kind":"paragraph","spans":[{"id":"spn-102324","text":"Add "},{"id":"spn-102325","marks":["code"],"text":":supersedes"},{"id":"spn-102326","text":" edge type if not present"}]}],"id":"blk-71290","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71292","kind":"heading","level":3,"spans":[{"id":"spn-102327","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-71293","kind":"heading","level":4,"spans":[{"id":"spn-102328","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-71294","kind":"paragraph","spans":[{"id":"spn-102329","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102330","text":" "},{"id":"spn-102331","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-102332","text":" "},{"id":"spn-102333","marks":["bold"],"text":"File:"},{"id":"spn-102334","text":" "},{"id":"spn-102335","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71295","kind":"paragraph","spans":[{"id":"spn-102336","text":"Replace flat "},{"id":"spn-102337","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-102338","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-71296","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-71297","items":[{"blocks":[{"id":"blk-71299","kind":"paragraph","spans":[{"id":"spn-102339","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-71298","kind":"list-item"},{"blocks":[{"id":"blk-71301","kind":"paragraph","spans":[{"id":"spn-102340","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-71300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71302","kind":"paragraph","spans":[{"id":"spn-102341","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-71303","kind":"heading","level":4,"spans":[{"id":"spn-102342","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-71304","kind":"paragraph","spans":[{"id":"spn-102343","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102344","text":" "},{"id":"spn-102345","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-102346","text":" "},{"id":"spn-102347","marks":["bold"],"text":"File:"},{"id":"spn-102348","text":" "},{"id":"spn-102349","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71305","kind":"paragraph","spans":[{"id":"spn-102350","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-102351","marks":["code"],"text":"fault_line_edges"},{"id":"spn-102352","text":":"}]},{"id":"blk-71306","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-71307","kind":"heading","level":4,"spans":[{"id":"spn-102353","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-71308","kind":"paragraph","spans":[{"id":"spn-102354","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102355","text":" "},{"id":"spn-102356","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-102357","text":" "},{"id":"spn-102358","marks":["bold"],"text":"File:"},{"id":"spn-102359","text":" "},{"id":"spn-102360","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-102361","text":" (or new module)"}]},{"id":"blk-71309","kind":"paragraph","spans":[{"id":"spn-102362","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-71310","items":[{"blocks":[{"id":"blk-71312","kind":"paragraph","spans":[{"id":"spn-102363","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-71311","kind":"list-item"},{"blocks":[{"id":"blk-71314","kind":"paragraph","spans":[{"id":"spn-102364","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-71313","kind":"list-item"},{"blocks":[{"id":"blk-71316","kind":"paragraph","spans":[{"id":"spn-102365","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-71315","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71317","kind":"paragraph","spans":[{"id":"spn-102366","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-71318","kind":"heading","level":3,"spans":[{"id":"spn-102367","text":"κ Phase 3 — Polish"}]},{"id":"blk-71319","kind":"heading","level":4,"spans":[{"id":"spn-102368","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-71320","kind":"paragraph","spans":[{"id":"spn-102369","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102370","text":" "},{"id":"spn-102371","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-71321","kind":"paragraph","spans":[{"id":"spn-102372","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-71322","kind":"heading","level":4,"spans":[{"id":"spn-102373","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-71323","kind":"paragraph","spans":[{"id":"spn-102374","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102375","text":" "},{"id":"spn-102376","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-71324","kind":"paragraph","spans":[{"id":"spn-102377","text":"Use "},{"id":"spn-102378","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-102379","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-71325","kind":"heading","level":2,"spans":[{"id":"spn-102380","text":"Recommended Implementation Order"}]},{"id":"blk-71326","kind":"paragraph","spans":[{"id":"spn-102381","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-71328","spans":[{"id":"spn-102382","text":"Order"}]},{"id":"blk-71329","spans":[{"id":"spn-102383","text":"Goal"}]},{"id":"blk-71330","spans":[{"id":"spn-102384","text":"Tag"}]},{"id":"blk-71331","spans":[{"id":"spn-102385","text":"Expected Impact"}]}],"id":"blk-71327","kind":"table","rows":[[{"id":"blk-71332","spans":[{"id":"spn-102386","text":"1"}]},{"id":"blk-71333","spans":[{"id":"spn-102387","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-71334","spans":[{"id":"spn-102388","text":"shr"}]},{"id":"blk-71335","spans":[{"id":"spn-102389","text":"+3-5pp SHR"}]}],[{"id":"blk-71336","spans":[{"id":"spn-102390","text":"2"}]},{"id":"blk-71337","spans":[{"id":"spn-102391","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-71338","spans":[{"id":"spn-102392","text":"shr"}]},{"id":"blk-71339","spans":[{"id":"spn-102393","text":"+2-3pp SHR"}]}],[{"id":"blk-71340","spans":[{"id":"spn-102394","text":"3"}]},{"id":"blk-71341","spans":[{"id":"spn-102395","text":"S3: Session Summary Nodes"}]},{"id":"blk-71342","spans":[{"id":"spn-102396","text":"shr"}]},{"id":"blk-71343","spans":[{"id":"spn-102397","text":"+3-5pp SHR"}]}],[{"id":"blk-71344","spans":[{"id":"spn-102398","text":"4"}]},{"id":"blk-71345","spans":[{"id":"spn-102399","text":"S2: Cross-Session Entity Edges"}]},{"id":"blk-71346","spans":[{"id":"spn-102400","text":"shr"}]},{"id":"blk-71347","spans":[{"id":"spn-102401","text":"+3-4pp SHR"}]}],[{"id":"blk-71348","spans":[{"id":"spn-102402","text":"5"}]},{"id":"blk-71349","spans":[{"id":"spn-102403","text":"S5: Session Diversity Re-ranking"}]},{"id":"blk-71350","spans":[{"id":"spn-102404","text":"shr"}]},{"id":"blk-71351","spans":[{"id":"spn-102405","text":"+2-3pp SHR"}]}],[{"id":"blk-71352","spans":[{"id":"spn-102406","text":"6"}]},{"id":"blk-71353","spans":[{"id":"spn-102407","text":"S8: Abstention Calibration"}]},{"id":"blk-71354","spans":[{"id":"spn-102408","text":"shr"}]},{"id":"blk-71355","spans":[{"id":"spn-102409","text":"+2-3pp QA"}]}],[{"id":"blk-71356","spans":[{"id":"spn-102410","text":"7"}]},{"id":"blk-71357","spans":[{"id":"spn-102411","text":"K1: Iterative Retrieval in Deliberation"}]},{"id":"blk-71358","spans":[{"id":"spn-102412","text":"κ"}]},{"id":"blk-71359","spans":[{"id":"spn-102413","text":"+8-12pp QA"}]}],[{"id":"blk-71360","spans":[{"id":"spn-102414","text":"8"}]},{"id":"blk-71361","spans":[{"id":"spn-102415","text":"K2: κ-Adaptive Retrieval Depth"}]},{"id":"blk-71362","spans":[{"id":"spn-102416","text":"κ"}]},{"id":"blk-71363","spans":[{"id":"spn-102417","text":"+3-5pp QA"}]}],[{"id":"blk-71364","spans":[{"id":"spn-102418","text":"9"}]},{"id":"blk-71365","spans":[{"id":"spn-102419","text":"K3: Temporal Contradiction via κ"}]},{"id":"blk-71366","spans":[{"id":"spn-102420","text":"κ"}]},{"id":"blk-71367","spans":[{"id":"spn-102421","t