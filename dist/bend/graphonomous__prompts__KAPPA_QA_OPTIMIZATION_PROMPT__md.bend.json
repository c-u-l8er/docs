{"bendscript":"0.1","blocks":[{"id":"blk-79217","kind":"heading","level":1,"spans":[{"id":"spn-142603","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-79218","kind":"heading","level":2,"spans":[{"id":"spn-142604","text":"Mission"}]},{"id":"blk-79219","kind":"paragraph","spans":[{"id":"spn-142605","text":"Push Graphonomous LongMemEval from "},{"id":"spn-142606","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-142607","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-79220","kind":"heading","level":2,"spans":[{"id":"spn-142608","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-79222","spans":[{"id":"spn-142609","text":"Metric"}]},{"id":"blk-79223","spans":[{"id":"spn-142610","text":"Value"}]},{"id":"blk-79224","spans":[{"id":"spn-142611","text":"Gap to Target"}]}],"id":"blk-79221","kind":"table","rows":[[{"id":"blk-79225","spans":[{"id":"spn-142612","text":"Session Hit Rate (SHR)"}]},{"id":"blk-79226","spans":[{"id":"spn-142613","text":"90.4%"}]},{"id":"blk-79227","spans":[{"id":"spn-142614","text":"+6.6pp to 97%"}]}],[{"id":"blk-79228","spans":[{"id":"spn-142615","text":"QA Proxy Score"}]},{"id":"blk-79229","spans":[{"id":"spn-142616","text":"73.04%"}]},{"id":"blk-79230","spans":[{"id":"spn-142617","text":"+22pp to 95%"}]}],[{"id":"blk-79231","spans":[{"id":"spn-142618","text":"Multi-session SHR"}]},{"id":"blk-79232","spans":[{"id":"spn-142619","marks":["bold"],"text":"85.0%"}]},{"id":"blk-79233","spans":[{"id":"spn-142620","text":"worst category"}]}],[{"id":"blk-79234","spans":[{"id":"spn-142621","text":"Multi-session recall"}]},{"id":"blk-79235","spans":[{"id":"spn-142622","marks":["bold"],"text":"60.5%"}]},{"id":"blk-79236","spans":[{"id":"spn-142623","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-79237","spans":[{"id":"spn-142624","text":"Temporal SHR"}]},{"id":"blk-79238","spans":[{"id":"spn-142625","text":"95.0%"}]},{"id":"blk-79239","spans":[{"id":"spn-142626","text":"strong"}]}],[{"id":"blk-79240","spans":[{"id":"spn-142627","text":"Temporal QA proxy"}]},{"id":"blk-79241","spans":[{"id":"spn-142628","text":"74.2%"}]},{"id":"blk-79242","spans":[{"id":"spn-142629","text":"gap despite good SHR"}]}],[{"id":"blk-79243","spans":[{"id":"spn-142630","text":"Abstention accuracy"}]},{"id":"blk-79244","spans":[{"id":"spn-142631","marks":["bold"],"text":"0.0%"}]},{"id":"blk-79245","spans":[{"id":"spn-142632","text":"broken threshold"}]}],[{"id":"blk-79246","spans":[{"id":"spn-142633","text":"Retrieval: similarity_limit"}]},{"id":"blk-79247","spans":[{"id":"spn-142634","text":"10"}]},{"id":"blk-79248","spans":[{"id":"spn-142635","text":"too few for multi-session"}]}],[{"id":"blk-79249","spans":[{"id":"spn-142636","text":"Retrieval: final_limit"}]},{"id":"blk-79250","spans":[{"id":"spn-142637","text":"20"}]},{"id":"blk-79251","spans":[{"id":"spn-142638","text":""}]}],[{"id":"blk-79252","spans":[{"id":"spn-142639","text":"Retrieval: expansion_hops"}]},{"id":"blk-79253","spans":[{"id":"spn-142640","text":"1"}]},{"id":"blk-79254","spans":[{"id":"spn-142641","text":"can't reach cross-session nodes"}]}],[{"id":"blk-79255","spans":[{"id":"spn-142642","text":"Retrieval: hop_decay"}]},{"id":"blk-79256","spans":[{"id":"spn-142643","text":"0.85 (flat)"}]},{"id":"blk-79257","spans":[{"id":"spn-142644","text":"not topology-aware"}]}],[{"id":"blk-79258","spans":[{"id":"spn-142645","text":"Deliberation"}]},{"id":"blk-79259","spans":[{"id":"spn-142646","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-79260","spans":[{"id":"spn-142647","text":"no iterative retrieval"}]}],[{"id":"blk-79261","spans":[{"id":"spn-142648","text":"Temporal indexing"}]},{"id":"blk-79262","spans":[{"id":"spn-142649","text":"none"}]},{"id":"blk-79263","spans":[{"id":"spn-142650","text":"biggest gap vs Chronos"}]}],[{"id":"blk-79264","spans":[{"id":"spn-142651","text":"Session edges at ingestion"}]},{"id":"blk-79265","spans":[{"id":"spn-142652","marks":["bold"],"text":"none"}]},{"id":"blk-79266","spans":[{"id":"spn-142653","text":"turns stored as isolated nodes"}]}],[{"id":"blk-79267","spans":[{"id":"spn-142654","text":"Cross-session entity edges"}]},{"id":"blk-79268","spans":[{"id":"spn-142655","marks":["bold"],"text":"none"}]},{"id":"blk-79269","spans":[{"id":"spn-142656","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-79270","kind":"heading","level":2,"spans":[{"id":"spn-142657","text":"Competitive Landscape"}]},{"head":[{"id":"blk-79272","spans":[{"id":"spn-142658","text":"System"}]},{"id":"blk-79273","spans":[{"id":"spn-142659","text":"Score"}]},{"id":"blk-79274","spans":[{"id":"spn-142660","text":"Key Technique"}]}],"id":"blk-79271","kind":"table","rows":[[{"id":"blk-79275","spans":[{"id":"spn-142661","text":"Supermemory ASMR"}]},{"id":"blk-79276","spans":[{"id":"spn-142662","text":"~99%"}]},{"id":"blk-79277","spans":[{"id":"spn-142663","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-79278","spans":[{"id":"spn-142664","text":"Chronos"}]},{"id":"blk-79279","spans":[{"id":"spn-142665","text":"95.6%"}]},{"id":"blk-79280","spans":[{"id":"spn-142666","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-79281","spans":[{"id":"spn-142667","text":"Mastra OM"}]},{"id":"blk-79282","spans":[{"id":"spn-142668","text":"94.87%"}]},{"id":"blk-79283","spans":[{"id":"spn-142669","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-79284","spans":[{"id":"spn-142670","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-79285","spans":[{"id":"spn-142671","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-79286","spans":[{"id":"spn-142672","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-79287","spans":[{"id":"spn-142673","text":"Emergence AI"}]},{"id":"blk-79288","spans":[{"id":"spn-142674","text":"86%"}]},{"id":"blk-79289","spans":[{"id":"spn-142675","text":"Well-tuned RAG only"}]}],[{"id":"blk-79290","spans":[{"id":"spn-142676","text":"Hindsight (Vectorize)"}]},{"id":"blk-79291","spans":[{"id":"spn-142677","text":"91.4% SHR"}]},{"id":"blk-79292","spans":[{"id":"spn-142678","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-79293","kind":"heading","level":2,"spans":[{"id":"spn-142679","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-142680","marks":["code"],"text":"shr-optimization"},{"id":"spn-142681","text":")"}]},{"id":"blk-79294","kind":"paragraph","spans":[{"id":"spn-142682","text":"The SHR gap is primarily driven by "},{"id":"spn-142683","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-142684","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-79295","kind":"heading","level":3,"spans":[{"id":"spn-142685","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-79296","kind":"heading","level":4,"spans":[{"id":"spn-142686","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-79297","kind":"paragraph","spans":[{"id":"spn-142687","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142688","text":" "},{"id":"spn-142689","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-142690","text":" "},{"id":"spn-142691","marks":["bold"],"text":"File:"},{"id":"spn-142692","text":" "},{"id":"spn-142693","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-142694","text":" → "},{"id":"spn-142695","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-79298","kind":"paragraph","spans":[{"id":"spn-142696","text":"Currently "},{"id":"spn-142697","marks":["code"],"text":"ingest_session/2"},{"id":"spn-142698","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-79299","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-79300","kind":"paragraph","spans":[{"id":"spn-142699","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-79301","kind":"heading","level":4,"spans":[{"id":"spn-142700","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-79302","kind":"paragraph","spans":[{"id":"spn-142701","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142702","text":" "},{"id":"spn-142703","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-142704","text":" "},{"id":"spn-142705","marks":["bold"],"text":"File:"},{"id":"spn-142706","text":" "},{"id":"spn-142707","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-142708","text":" (new post-ingestion phase)"}]},{"id":"blk-79303","kind":"paragraph","spans":[{"id":"spn-142709","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-79304","items":[{"blocks":[{"id":"blk-79306","kind":"paragraph","spans":[{"id":"spn-142710","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-79305","kind":"list-item"},{"blocks":[{"id":"blk-79308","kind":"paragraph","spans":[{"id":"spn-142711","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-142712","marks":["code"],"text":":related"},{"id":"spn-142713","text":" edges"}]}],"id":"blk-79307","kind":"list-item"},{"blocks":[{"id":"blk-79310","kind":"paragraph","spans":[{"id":"spn-142714","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-79309","kind":"list-item"},{"blocks":[{"id":"blk-79312","kind":"paragraph","spans":[{"id":"spn-142715","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-79311","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79313","kind":"paragraph","spans":[{"id":"spn-142716","text":"Implementation approach:"}]},{"id":"blk-79314","items":[{"blocks":[{"id":"blk-79316","kind":"paragraph","spans":[{"id":"spn-142717","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-79315","kind":"list-item"},{"blocks":[{"id":"blk-79318","kind":"paragraph","spans":[{"id":"spn-142718","text":"Better: use existing "},{"id":"spn-142719","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-142720","text":" which already does edge extraction"}]}],"id":"blk-79317","kind":"list-item"},{"blocks":[{"id":"blk-79320","kind":"paragraph","spans":[{"id":"spn-142721","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-79319","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79321","kind":"heading","level":4,"spans":[{"id":"spn-142722","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-79322","kind":"paragraph","spans":[{"id":"spn-142723","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142724","text":" "},{"id":"spn-142725","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-142726","text":" "},{"id":"spn-142727","marks":["bold"],"text":"File:"},{"id":"spn-142728","text":" "},{"id":"spn-142729","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-79323","kind":"paragraph","spans":[{"id":"spn-142730","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-79324","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-79325","kind":"paragraph","spans":[{"id":"spn-142731","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-79326","kind":"heading","level":4,"spans":[{"id":"spn-142732","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-79327","kind":"paragraph","spans":[{"id":"spn-142733","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142734","text":" "},{"id":"spn-142735","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-142736","text":" "},{"id":"spn-142737","marks":["bold"],"text":"File:"},{"id":"spn-142738","text":" "},{"id":"spn-142739","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-142740","text":" → "},{"id":"spn-142741","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-79328","kind":"paragraph","spans":[{"id":"spn-142742","text":"Change retrieval call from:"}]},{"id":"blk-79329","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-79330","kind":"paragraph","spans":[{"id":"spn-142743","text":"To:"}]},{"id":"blk-79331","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-79332","kind":"paragraph","spans":[{"id":"spn-142744","text":"For even better results, make limits adaptive:"}]},{"id":"blk-79333","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-79334","kind":"heading","level":3,"spans":[{"id":"spn-142745","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-79335","kind":"heading","level":4,"spans":[{"id":"spn-142746","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-79336","kind":"paragraph","spans":[{"id":"spn-142747","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142748","text":" "},{"id":"spn-142749","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-142750","text":" "},{"id":"spn-142751","marks":["bold"],"text":"File:"},{"id":"spn-142752","text":" "},{"id":"spn-142753","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-79337","kind":"paragraph","spans":[{"id":"spn-142754","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-79338","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-79339","kind":"paragraph","spans":[{"id":"spn-142755","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-79340","kind":"heading","level":4,"spans":[{"id":"spn-142756","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-79341","kind":"paragraph","spans":[{"id":"spn-142757","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142758","text":" "},{"id":"spn-142759","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-142760","text":" "},{"id":"spn-142761","marks":["bold"],"text":"File:"},{"id":"spn-142762","text":" "},{"id":"spn-142763","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-79342","kind":"paragraph","spans":[{"id":"spn-142764","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-79343","kind":"heading","level":4,"spans":[{"id":"spn-142765","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-79344","kind":"paragraph","spans":[{"id":"spn-142766","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142767","text":" "},{"id":"spn-142768","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-142769","text":" "},{"id":"spn-142770","marks":["bold"],"text":"Files:"},{"id":"spn-142771","text":" "},{"id":"spn-142772","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-142773","text":", "},{"id":"spn-142774","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-79345","kind":"paragraph","spans":[{"id":"spn-142775","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-79346","kind":"heading","level":4,"spans":[{"id":"spn-142776","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-79347","kind":"paragraph","spans":[{"id":"spn-142777","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142778","text":" "},{"id":"spn-142779","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-142780","text":" "},{"id":"spn-142781","marks":["bold"],"text":"File:"},{"id":"spn-142782","text":" "},{"id":"spn-142783","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-142784","text":" → "},{"id":"spn-142785","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-79348","kind":"paragraph","spans":[{"id":"spn-142786","text":"Current abstention threshold ("},{"id":"spn-142787","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-142788","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-79349","items":[{"blocks":[{"id":"blk-79351","kind":"paragraph","spans":[{"id":"spn-142789","text":"Use confidence gap: "},{"id":"spn-142790","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-142791","text":" → likely no clear answer"}]}],"id":"blk-79350","kind":"list-item"},{"blocks":[{"id":"blk-79353","kind":"paragraph","spans":[{"id":"spn-142792","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-79352","kind":"list-item"},{"blocks":[{"id":"blk-79355","kind":"paragraph","spans":[{"id":"spn-142793","text":"Raise score threshold to "},{"id":"spn-142794","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-79354","kind":"list-item"},{"blocks":[{"id":"blk-79357","kind":"paragraph","spans":[{"id":"spn-142795","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-79356","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79358","kind":"heading","level":2,"spans":[{"id":"spn-142796","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-142797","marks":["code"],"text":"kappa-optimization"},{"id":"spn-142798","text":")"}]},{"id":"blk-79359","kind":"paragraph","spans":[{"id":"spn-142799","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-79360","kind":"heading","level":3,"spans":[{"id":"spn-142800","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-79361","kind":"heading","level":4,"spans":[{"id":"spn-142801","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-79362","kind":"paragraph","spans":[{"id":"spn-142802","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142803","text":" "},{"id":"spn-142804","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-142805","text":" "},{"id":"spn-142806","marks":["bold"],"text":"File:"},{"id":"spn-142807","text":" "},{"id":"spn-142808","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-79363","kind":"paragraph","spans":[{"id":"spn-142809","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-142810","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-142811","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-142812","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-142813","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-79364","kind":"paragraph","spans":[{"id":"spn-142814","text":"Implementation:"}]},{"id":"blk-79365","items":[{"blocks":[{"id":"blk-79367","kind":"paragraph","spans":[{"id":"spn-142815","text":"In "},{"id":"spn-142816","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-142817","text":", after building the initial prompt, add a "},{"id":"spn-142818","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-142819","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-79366","kind":"list-item"},{"blocks":[{"id":"blk-79369","kind":"paragraph","spans":[{"id":"spn-142820","text":"In the main "},{"id":"spn-142821","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-142822","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-79368","kind":"list-item"},{"blocks":[{"id":"blk-79371","kind":"paragraph","spans":[{"id":"spn-142823","text":"Use "},{"id":"spn-142824","marks":["code"],"text":"fault_line_edges"},{"id":"spn-142825","text":" to decide which partition side needs more evidence"}]}],"id":"blk-79370","kind":"list-item"},{"blocks":[{"id":"blk-79373","kind":"paragraph","spans":[{"id":"spn-142826","text":"Wire through "},{"id":"spn-142827","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-142828","text":" with a "},{"id":"spn-142829","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-142830","text":" option"}]}],"id":"blk-79372","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79374","kind":"paragraph","spans":[{"id":"spn-142831","text":"Test: Run "},{"id":"spn-142832","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-142833","text":" before and after. QA proxy score should increase."}]},{"id":"blk-79375","kind":"heading","level":4,"spans":[{"id":"spn-142834","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-79376","kind":"paragraph","spans":[{"id":"spn-142835","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142836","text":" "},{"id":"spn-142837","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-142838","text":" "},{"id":"spn-142839","marks":["bold"],"text":"File:"},{"id":"spn-142840","text":" "},{"id":"spn-142841","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-79377","kind":"paragraph","spans":[{"id":"spn-142842","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-79378","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-79379","kind":"paragraph","spans":[{"id":"spn-142843","text":"This requires restructuring "},{"id":"spn-142844","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-142845","text":" to:"}]},{"id":"blk-79380","items":[{"blocks":[{"id":"blk-79382","kind":"paragraph","spans":[{"id":"spn-142846","text":"Run similarity search (seeds)"}]}],"id":"blk-79381","kind":"list-item"},{"blocks":[{"id":"blk-79384","kind":"paragraph","spans":[{"id":"spn-142847","text":"Do a preliminary 1-hop expansion"}]}],"id":"blk-79383","kind":"list-item"},{"blocks":[{"id":"blk-79386","kind":"paragraph","spans":[{"id":"spn-142848","text":"Run topology analysis on the expanded set"}]}],"id":"blk-79385","kind":"list-item"},{"blocks":[{"id":"blk-79388","kind":"paragraph","spans":[{"id":"spn-142849","text":"If κ > 0, do additional hops up to "},{"id":"spn-142850","marks":["code"],"text":"effective_hops"}]}],"id":"blk-79387","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-79389","kind":"heading","level":4,"spans":[{"id":"spn-142851","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-79390","kind":"paragraph","spans":[{"id":"spn-142852","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142853","text":" "},{"id":"spn-142854","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-142855","text":" "},{"id":"spn-142856","marks":["bold"],"text":"Files:"},{"id":"spn-142857","text":" "},{"id":"spn-142858","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-142859","text":", "},{"id":"spn-142860","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-142861","text":", edge types"}]},{"id":"blk-79391","kind":"paragraph","spans":[{"id":"spn-142862","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-142863","marks":["code"],"text":"contradicts"},{"id":"spn-142864","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-79392","kind":"paragraph","spans":[{"id":"spn-142865","text":"Implementation:"}]},{"id":"blk-79393","items":[{"blocks":[{"id":"blk-79395","kind":"paragraph","spans":[{"id":"spn-142866","text":"In "},{"id":"spn-142867","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-142868","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-142869","marks":["code"],"text":":contradicts"}]}],"id":"blk-79394","kind":"list-item"},{"blocks":[{"id":"blk-79397","kind":"paragraph","spans":[{"id":"spn-142870","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-142871","marks":["code"],"text":"inserted_at"},{"id":"spn-142872","text":" timestamps"}]}],"id":"blk-79396","kind":"list-item"},{"blocks":[{"id":"blk-79399","kind":"paragraph","spans":[{"id":"spn-142873","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-79398","kind":"list-item"},{"blocks":[{"id":"blk-79401","kind":"paragraph","spans":[{"id":"spn-142874","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-79400","kind":"list-item"},{"blocks":[{"id":"blk-79403","kind":"paragraph","spans":[{"id":"spn-142875","text":"Add "},{"id":"spn-142876","marks":["code"],"text":":supersedes"},{"id":"spn-142877","text":" edge type if not present"}]}],"id":"blk-79402","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79404","kind":"heading","level":3,"spans":[{"id":"spn-142878","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-79405","kind":"heading","level":4,"spans":[{"id":"spn-142879","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-79406","kind":"paragraph","spans":[{"id":"spn-142880","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142881","text":" "},{"id":"spn-142882","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-142883","text":" "},{"id":"spn-142884","marks":["bold"],"text":"File:"},{"id":"spn-142885","text":" "},{"id":"spn-142886","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-79407","kind":"paragraph","spans":[{"id":"spn-142887","text":"Replace flat "},{"id":"spn-142888","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-142889","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-79408","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-79409","items":[{"blocks":[{"id":"blk-79411","kind":"paragraph","spans":[{"id":"spn-142890","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-79410","kind":"list-item"},{"blocks":[{"id":"blk-79413","kind":"paragraph","spans":[{"id":"spn-142891","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-79412","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79414","kind":"paragraph","spans":[{"id":"spn-142892","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-79415","kind":"heading","level":4,"spans":[{"id":"spn-142893","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-79416","kind":"paragraph","spans":[{"id":"spn-142894","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142895","text":" "},{"id":"spn-142896","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-142897","text":" "},{"id":"spn-142898","marks":["bold"],"text":"File:"},{"id":"spn-142899","text":" "},{"id":"spn-142900","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-79417","kind":"paragraph","spans":[{"id":"spn-142901","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-142902","marks":["code"],"text":"fault_line_edges"},{"id":"spn-142903","text":":"}]},{"id":"blk-79418","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-79419","kind":"heading","level":4,"spans":[{"id":"spn-142904","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-79420","kind":"paragraph","spans":[{"id":"spn-142905","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142906","text":" "},{"id":"spn-142907","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-142908","text":" "},{"id":"spn-142909","marks":["bold"],"text":"File:"},{"id":"spn-142910","text":" "},{"id":"spn-142911","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-142912","text":" (or new module)"}]},{"id":"blk-79421","kind":"paragraph","spans":[{"id":"spn-142913","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-79422","items":[{"blocks":[{"id":"blk-79424","kind":"paragraph","spans":[{"id":"spn-142914","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-79423","kind":"list-item"},{"blocks":[{"id":"blk-79426","kind":"paragraph","spans":[{"id":"spn-142915","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-79425","kind":"list-item"},{"blocks":[{"id":"blk-79428","kind":"paragraph","spans":[{"id":"spn-142916","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-79427","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-79429","kind":"paragraph","spans":[{"id":"spn-142917","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-79430","kind":"heading","level":3,"spans":[{"id":"spn-142918","text":"κ Phase 3 — Polish"}]},{"id":"blk-79431","kind":"heading","level":4,"spans":[{"id":"spn-142919","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-79432","kind":"paragraph","spans":[{"id":"spn-142920","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142921","text":" "},{"id":"spn-142922","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-79433","kind":"paragraph","spans":[{"id":"spn-142923","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-79434","kind":"heading","level":4,"spans":[{"id":"spn-142924","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-79435","kind":"paragraph","spans":[{"id":"spn-142925","marks":["bold"],"text":"Goal ID:"},{"id":"spn-142926","text":" "},{"id":"spn-142927","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-79436","kind":"paragraph","spans":[{"id":"spn-142928","text":"Use "},{"id":"spn-142929","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-142930","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-79437","kind":"heading","level":2,"spans":[{"id":"spn-142931","text":"Recommended Implementation Order"}]},{"id":"blk-79438","kind":"paragraph","spans":[{"id":"spn-142932","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-79440","spans":[{"id":"spn-142933","text":"Order"}]},{"id":"blk-79441","spans":[{"id":"spn-142934","text":"Goal"}]},{"id":"blk-79442","spans":[{"id":"spn-142935","text":"Tag"}]},{"id":"blk-79443","spans":[{"id":"spn-142936","text":"Expected Impact"}]}],"id":"blk-79439","kind":"table","rows":[[{"id":"blk-79444","spans":[{"id":"spn-142937","text":"1"}]},{"id":"blk-79445","spans":[{"id":"spn-142938","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-79446","spans":[{"id":"spn-142939","text":"shr"}]},{"id":"blk-79447","spans":[{"id":"spn-142940","text":"+3-5pp SHR"}]}],[{"id":"blk-79448","spans":[{"id":"spn-142941","text":"2"}]},{"id":"blk-79449","spans":[{"id":"spn-142942","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-79450","spans":[{"id":"spn-142943","text":"shr"}]},{"id":"blk-79451",