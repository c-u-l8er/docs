arity → BFS → rerank → topology → deliberate)"}]}],[{"id":"blk-46739","spans":[{"id":"spn-53807","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-46740","spans":[{"id":"spn-53808","text":"κ-driven decompose-focus-reconcile"}]}],[{"id":"blk-46741","spans":[{"id":"spn-53809","marks":["code"],"text":"lib/graphonomous/topology.ex"}]},{"id":"blk-46742","spans":[{"id":"spn-53810","text":"Tarjan SCC, κ computation, fault lines, edge impact preview"}]}],[{"id":"blk-46743","spans":[{"id":"spn-53811","marks":["code"],"text":"lib/graphonomous/graph.ex"}]},{"id":"blk-46744","spans":[{"id":"spn-53812","text":"Node/edge CRUD, similarity search, BFS"}]}],[{"id":"blk-46745","spans":[{"id":"spn-53813","marks":["code"],"text":"lib/graphonomous/store.ex"}]},{"id":"blk-46746","spans":[{"id":"spn-53814","text":"SQLite persistence layer"}]}],[{"id":"blk-46747","spans":[{"id":"spn-53815","marks":["code"],"text":"lib/graphonomous/types/edge.ex"}]},{"id":"blk-46748","spans":[{"id":"spn-53816","text":"Edge type definitions (16 types)"}]}],[{"id":"blk-46749","spans":[{"id":"spn-53817","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-46750","spans":[{"id":"spn-53818","text":"LongMemEval benchmark task (ingestion + evaluation)"}]}],[{"id":"blk-46751","spans":[{"id":"spn-53819","marks":["code"],"text":"lib/mix/tasks/benchmark/retrieval.ex"}]},{"id":"blk-46752","spans":[{"id":"spn-53820","text":"Retrieval quality benchmark (graph vs flat)"}]}],[{"id":"blk-46753","spans":[{"id":"spn-53821","marks":["code"],"text":"test/graphonomous/retriever_test.exs"}]},{"id":"blk-46754","spans":[{"id":"spn-53822","text":"Retriever tests"}]}],[{"id":"blk-46755","spans":[{"id":"spn-53823","marks":["code"],"text":"test/graphonomous/deliberator_test.exs"}]},{"id":"blk-46756","spans":[{"id":"spn-53824","text":"Deliberator tests"}]}],[{"id":"blk-46757","spans":[{"id":"spn-53825","marks":["code"],"text":"test/graphonomous/topology_test.exs"}]},{"id":"blk-46758","span