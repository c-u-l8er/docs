{"bendscript":"0.1","blocks":[{"id":"blk-72070","kind":"heading","level":1,"spans":[{"id":"spn-104866","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-72071","kind":"heading","level":2,"spans":[{"id":"spn-104867","text":"Mission"}]},{"id":"blk-72072","kind":"paragraph","spans":[{"id":"spn-104868","text":"Push Graphonomous LongMemEval from "},{"id":"spn-104869","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-104870","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-72073","kind":"heading","level":2,"spans":[{"id":"spn-104871","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-72075","spans":[{"id":"spn-104872","text":"Metric"}]},{"id":"blk-72076","spans":[{"id":"spn-104873","text":"Value"}]},{"id":"blk-72077","spans":[{"id":"spn-104874","text":"Gap to Target"}]}],"id":"blk-72074","kind":"table","rows":[[{"id":"blk-72078","spans":[{"id":"spn-104875","text":"Session Hit Rate (SHR)"}]},{"id":"blk-72079","spans":[{"id":"spn-104876","text":"90.4%"}]},{"id":"blk-72080","spans":[{"id":"spn-104877","text":"+6.6pp to 97%"}]}],[{"id":"blk-72081","spans":[{"id":"spn-104878","text":"QA Proxy Score"}]},{"id":"blk-72082","spans":[{"id":"spn-104879","text":"73.04%"}]},{"id":"blk-72083","spans":[{"id":"spn-104880","text":"+22pp to 95%"}]}],[{"id":"blk-72084","spans":[{"id":"spn-104881","text":"Multi-session SHR"}]},{"id":"blk-72085","spans":[{"id":"spn-104882","marks":["bold"],"text":"85.0%"}]},{"id":"blk-72086","spans":[{"id":"spn-104883","text":"worst category"}]}],[{"id":"blk-72087","spans":[{"id":"spn-104884","text":"Multi-session recall"}]},{"id":"blk-72088","spans":[{"id":"spn-104885","marks":["bold"],"text":"60.5%"}]},{"id":"blk-72089","spans":[{"id":"spn-104886","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-72090","spans":[{"id":"spn-104887","text":"Temporal SHR"}]},{"id":"blk-72091","spans":[{"id":"spn-104888","text":"95.0%"}]},{"id":"blk-72092","spans":[{"id":"spn-104889","text":"strong"}]}],[{"id":"blk-72093","spans":[{"id":"spn-104890","text":"Temporal QA proxy"}]},{"id":"blk-72094","spans":[{"id":"spn-104891","text":"74.2%"}]},{"id":"blk-72095","spans":[{"id":"spn-104892","text":"gap despite good SHR"}]}],[{"id":"blk-72096","spans":[{"id":"spn-104893","text":"Abstention accuracy"}]},{"id":"blk-72097","spans":[{"id":"spn-104894","marks":["bold"],"text":"0.0%"}]},{"id":"blk-72098","spans":[{"id":"spn-104895","text":"broken threshold"}]}],[{"id":"blk-72099","spans":[{"id":"spn-104896","text":"Retrieval: similarity_limit"}]},{"id":"blk-72100","spans":[{"id":"spn-104897","text":"10"}]},{"id":"blk-72101","spans":[{"id":"spn-104898","text":"too few for multi-session"}]}],[{"id":"blk-72102","spans":[{"id":"spn-104899","text":"Retrieval: final_limit"}]},{"id":"blk-72103","spans":[{"id":"spn-104900","text":"20"}]},{"id":"blk-72104","spans":[{"id":"spn-104901","text":""}]}],[{"id":"blk-72105","spans":[{"id":"spn-104902","text":"Retrieval: expansion_hops"}]},{"id":"blk-72106","spans":[{"id":"spn-104903","text":"1"}]},{"id":"blk-72107","spans":[{"id":"spn-104904","text":"can't reach cross-session nodes"}]}],[{"id":"blk-72108","spans":[{"id":"spn-104905","text":"Retrieval: hop_decay"}]},{"id":"blk-72109","spans":[{"id":"spn-104906","text":"0.85 (flat)"}]},{"id":"blk-72110","spans":[{"id":"spn-104907","text":"not topology-aware"}]}],[{"id":"blk-72111","spans":[{"id":"spn-104908","text":"Deliberation"}]},{"id":"blk-72112","spans":[{"id":"spn-104909","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-72113","spans":[{"id":"spn-104910","text":"no iterative retrieval"}]}],[{"id":"blk-72114","spans":[{"id":"spn-104911","text":"Temporal indexing"}]},{"id":"blk-72115","spans":[{"id":"spn-104912","text":"none"}]},{"id":"blk-72116","spans":[{"id":"spn-104913","text":"biggest gap vs Chronos"}]}],[{"id":"blk-72117","spans":[{"id":"spn-104914","text":"Session edges at ingestion"}]},{"id":"blk-72118","spans":[{"id":"spn-104915","marks":["bold"],"text":"none"}]},{"id":"blk-72119","spans":[{"id":"spn-104916","text":"turns stored as isolated nodes"}]}],[{"id":"blk-72120","spans":[{"id":"spn-104917","text":"Cross-session entity edges"}]},{"id":"blk-72121","spans":[{"id":"spn-104918","marks":["bold"],"text":"none"}]},{"id":"blk-72122","spans":[{"id":"spn-104919","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-72123","kind":"heading","level":2,"spans":[{"id":"spn-104920","text":"Competitive Landscape"}]},{"head":[{"id":"blk-72125","spans":[{"id":"spn-104921","text":"System"}]},{"id":"blk-72126","spans":[{"id":"spn-104922","text":"Score"}]},{"id":"blk-72127","spans":[{"id":"spn-104923","text":"Key Technique"}]}],"id":"blk-72124","kind":"table","rows":[[{"id":"blk-72128","spans":[{"id":"spn-104924","text":"Supermemory ASMR"}]},{"id":"blk-72129","spans":[{"id":"spn-104925","text":"~99%"}]},{"id":"blk-72130","spans":[{"id":"spn-104926","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-72131","spans":[{"id":"spn-104927","text":"Chronos"}]},{"id":"blk-72132","spans":[{"id":"spn-104928","text":"95.6%"}]},{"id":"blk-72133","spans":[{"id":"spn-104929","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-72134","spans":[{"id":"spn-104930","text":"Mastra OM"}]},{"id":"blk-72135","spans":[{"id":"spn-104931","text":"94.87%"}]},{"id":"blk-72136","spans":[{"id":"spn-104932","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-72137","spans":[{"id":"spn-104933","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-72138","spans":[{"id":"spn-104934","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-72139","spans":[{"id":"spn-104935","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-72140","spans":[{"id":"spn-104936","text":"Emergence AI"}]},{"id":"blk-72141","spans":[{"id":"spn-104937","text":"86%"}]},{"id":"blk-72142","spans":[{"id":"spn-104938","text":"Well-tuned RAG only"}]}],[{"id":"blk-72143","spans":[{"id":"spn-104939","text":"Hindsight (Vectorize)"}]},{"id":"blk-72144","spans":[{"id":"spn-104940","text":"91.4% SHR"}]},{"id":"blk-72145","spans":[{"id":"spn-104941","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-72146","kind":"heading","level":2,"spans":[{"id":"spn-104942","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-104943","marks":["code"],"text":"shr-optimization"},{"id":"spn-104944","text":")"}]},{"id":"blk-72147","kind":"paragraph","spans":[{"id":"spn-104945","text":"The SHR gap is primarily driven by "},{"id":"spn-104946","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-104947","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-72148","kind":"heading","level":3,"spans":[{"id":"spn-104948","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-72149","kind":"heading","level":4,"spans":[{"id":"spn-104949","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-72150","kind":"paragraph","spans":[{"id":"spn-104950","marks":["bold"],"text":"Goal ID:"},{"id":"spn-104951","text":" "},{"id":"spn-104952","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-104953","text":" "},{"id":"spn-104954","marks":["bold"],"text":"File:"},{"id":"spn-104955","text":" "},{"id":"spn-104956","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-104957","text":" → "},{"id":"spn-104958","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-72151","kind":"paragraph","spans":[{"id":"spn-104959","text":"Currently "},{"id":"spn-104960","marks":["code"],"text":"ingest_session/2"},{"id":"spn-104961","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-72152","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-72153","kind":"paragraph","spans":[{"id":"spn-104962","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-72154","kind":"heading","level":4,"spans":[{"id":"spn-104963","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-72155","kind":"paragraph","spans":[{"id":"spn-104964","marks":["bold"],"text":"Goal ID:"},{"id":"spn-104965","text":" "},{"id":"spn-104966","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-104967","text":" "},{"id":"spn-104968","marks":["bold"],"text":"File:"},{"id":"spn-104969","text":" "},{"id":"spn-104970","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-104971","text":" (new post-ingestion phase)"}]},{"id":"blk-72156","kind":"paragraph","spans":[{"id":"spn-104972","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-72157","items":[{"blocks":[{"id":"blk-72159","kind":"paragraph","spans":[{"id":"spn-104973","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-72158","kind":"list-item"},{"blocks":[{"id":"blk-72161","kind":"paragraph","spans":[{"id":"spn-104974","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-104975","marks":["code"],"text":":related"},{"id":"spn-104976","text":" edges"}]}],"id":"blk-72160","kind":"list-item"},{"blocks":[{"id":"blk-72163","kind":"paragraph","spans":[{"id":"spn-104977","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-72162","kind":"list-item"},{"blocks":[{"id":"blk-72165","kind":"paragraph","spans":[{"id":"spn-104978","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-72164","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72166","kind":"paragraph","spans":[{"id":"spn-104979","text":"Implementation approach:"}]},{"id":"blk-72167","items":[{"blocks":[{"id":"blk-72169","kind":"paragraph","spans":[{"id":"spn-104980","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-72168","kind":"list-item"},{"blocks":[{"id":"blk-72171","kind":"paragraph","spans":[{"id":"spn-104981","text":"Better: use existing "},{"id":"spn-104982","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-104983","text":" which already does edge extraction"}]}],"id":"blk-72170","kind":"list-item"},{"blocks":[{"id":"blk-72173","kind":"paragraph","spans":[{"id":"spn-104984","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-72172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72174","kind":"heading","level":4,"spans":[{"id":"spn-104985","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-72175","kind":"paragraph","spans":[{"id":"spn-104986","marks":["bold"],"text":"Goal ID:"},{"id":"spn-104987","text":" "},{"id":"spn-104988","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-104989","text":" "},{"id":"spn-104990","marks":["bold"],"text":"File:"},{"id":"spn-104991","text":" "},{"id":"spn-104992","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-72176","kind":"paragraph","spans":[{"id":"spn-104993","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-72177","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-72178","kind":"paragraph","spans":[{"id":"spn-104994","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-72179","kind":"heading","level":4,"spans":[{"id":"spn-104995","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-72180","kind":"paragraph","spans":[{"id":"spn-104996","marks":["bold"],"text":"Goal ID:"},{"id":"spn-104997","text":" "},{"id":"spn-104998","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-104999","text":" "},{"id":"spn-105000","marks":["bold"],"text":"File:"},{"id":"spn-105001","text":" "},{"id":"spn-105002","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-105003","text":" → "},{"id":"spn-105004","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-72181","kind":"paragraph","spans":[{"id":"spn-105005","text":"Change retrieval call from:"}]},{"id":"blk-72182","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-72183","kind":"paragraph","spans":[{"id":"spn-105006","text":"To:"}]},{"id":"blk-72184","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-72185","kind":"paragraph","spans":[{"id":"spn-105007","text":"For even better results, make limits adaptive:"}]},{"id":"blk-72186","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-72187","kind":"heading","level":3,"spans":[{"id":"spn-105008","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-72188","kind":"heading","level":4,"spans":[{"id":"spn-105009","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-72189","kind":"paragraph","spans":[{"id":"spn-105010","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105011","text":" "},{"id":"spn-105012","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-105013","text":" "},{"id":"spn-105014","marks":["bold"],"text":"File:"},{"id":"spn-105015","text":" "},{"id":"spn-105016","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-72190","kind":"paragraph","spans":[{"id":"spn-105017","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-72191","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-72192","kind":"paragraph","spans":[{"id":"spn-105018","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-72193","kind":"heading","level":4,"spans":[{"id":"spn-105019","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-72194","kind":"paragraph","spans":[{"id":"spn-105020","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105021","text":" "},{"id":"spn-105022","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-105023","text":" "},{"id":"spn-105024","marks":["bold"],"text":"File:"},{"id":"spn-105025","text":" "},{"id":"spn-105026","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-72195","kind":"paragraph","spans":[{"id":"spn-105027","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-72196","kind":"heading","level":4,"spans":[{"id":"spn-105028","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-72197","kind":"paragraph","spans":[{"id":"spn-105029","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105030","text":" "},{"id":"spn-105031","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-105032","text":" "},{"id":"spn-105033","marks":["bold"],"text":"Files:"},{"id":"spn-105034","text":" "},{"id":"spn-105035","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-105036","text":", "},{"id":"spn-105037","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-72198","kind":"paragraph","spans":[{"id":"spn-105038","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-72199","kind":"heading","level":4,"spans":[{"id":"spn-105039","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-72200","kind":"paragraph","spans":[{"id":"spn-105040","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105041","text":" "},{"id":"spn-105042","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-105043","text":" "},{"id":"spn-105044","marks":["bold"],"text":"File:"},{"id":"spn-105045","text":" "},{"id":"spn-105046","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-105047","text":" → "},{"id":"spn-105048","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-72201","kind":"paragraph","spans":[{"id":"spn-105049","text":"Current abstention threshold ("},{"id":"spn-105050","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-105051","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-72202","items":[{"blocks":[{"id":"blk-72204","kind":"paragraph","spans":[{"id":"spn-105052","text":"Use confidence gap: "},{"id":"spn-105053","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-105054","text":" → likely no clear answer"}]}],"id":"blk-72203","kind":"list-item"},{"blocks":[{"id":"blk-72206","kind":"paragraph","spans":[{"id":"spn-105055","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-72205","kind":"list-item"},{"blocks":[{"id":"blk-72208","kind":"paragraph","spans":[{"id":"spn-105056","text":"Raise score threshold to "},{"id":"spn-105057","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-72207","kind":"list-item"},{"blocks":[{"id":"blk-72210","kind":"paragraph","spans":[{"id":"spn-105058","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-72209","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72211","kind":"heading","level":2,"spans":[{"id":"spn-105059","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-105060","marks":["code"],"text":"kappa-optimization"},{"id":"spn-105061","text":")"}]},{"id":"blk-72212","kind":"paragraph","spans":[{"id":"spn-105062","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-72213","kind":"heading","level":3,"spans":[{"id":"spn-105063","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-72214","kind":"heading","level":4,"spans":[{"id":"spn-105064","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-72215","kind":"paragraph","spans":[{"id":"spn-105065","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105066","text":" "},{"id":"spn-105067","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-105068","text":" "},{"id":"spn-105069","marks":["bold"],"text":"File:"},{"id":"spn-105070","text":" "},{"id":"spn-105071","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-72216","kind":"paragraph","spans":[{"id":"spn-105072","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-105073","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-105074","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-105075","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-105076","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-72217","kind":"paragraph","spans":[{"id":"spn-105077","text":"Implementation:"}]},{"id":"blk-72218","items":[{"blocks":[{"id":"blk-72220","kind":"paragraph","spans":[{"id":"spn-105078","text":"In "},{"id":"spn-105079","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-105080","text":", after building the initial prompt, add a "},{"id":"spn-105081","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-105082","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-72219","kind":"list-item"},{"blocks":[{"id":"blk-72222","kind":"paragraph","spans":[{"id":"spn-105083","text":"In the main "},{"id":"spn-105084","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-105085","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-72221","kind":"list-item"},{"blocks":[{"id":"blk-72224","kind":"paragraph","spans":[{"id":"spn-105086","text":"Use "},{"id":"spn-105087","marks":["code"],"text":"fault_line_edges"},{"id":"spn-105088","text":" to decide which partition side needs more evidence"}]}],"id":"blk-72223","kind":"list-item"},{"blocks":[{"id":"blk-72226","kind":"paragraph","spans":[{"id":"spn-105089","text":"Wire through "},{"id":"spn-105090","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-105091","text":" with a "},{"id":"spn-105092","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-105093","text":" option"}]}],"id":"blk-72225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72227","kind":"paragraph","spans":[{"id":"spn-105094","text":"Test: Run "},{"id":"spn-105095","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-105096","text":" before and after. QA proxy score should increase."}]},{"id":"blk-72228","kind":"heading","level":4,"spans":[{"id":"spn-105097","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-72229","kind":"paragraph","spans":[{"id":"spn-105098","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105099","text":" "},{"id":"spn-105100","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-105101","text":" "},{"id":"spn-105102","marks":["bold"],"text":"File:"},{"id":"spn-105103","text":" "},{"id":"spn-105104","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-72230","kind":"paragraph","spans":[{"id":"spn-105105","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-72231","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-72232","kind":"paragraph","spans":[{"id":"spn-105106","text":"This requires restructuring "},{"id":"spn-105107","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-105108","text":" to:"}]},{"id":"blk-72233","items":[{"blocks":[{"id":"blk-72235","kind":"paragraph","spans":[{"id":"spn-105109","text":"Run similarity search (seeds)"}]}],"id":"blk-72234","kind":"list-item"},{"blocks":[{"id":"blk-72237","kind":"paragraph","spans":[{"id":"spn-105110","text":"Do a preliminary 1-hop expansion"}]}],"id":"blk-72236","kind":"list-item"},{"blocks":[{"id":"blk-72239","kind":"paragraph","spans":[{"id":"spn-105111","text":"Run topology analysis on the expanded set"}]}],"id":"blk-72238","kind":"list-item"},{"blocks":[{"id":"blk-72241","kind":"paragraph","spans":[{"id":"spn-105112","text":"If κ > 0, do additional hops up to "},{"id":"spn-105113","marks":["code"],"text":"effective_hops"}]}],"id":"blk-72240","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-72242","kind":"heading","level":4,"spans":[{"id":"spn-105114","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-72243","kind":"paragraph","spans":[{"id":"spn-105115","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105116","text":" "},{"id":"spn-105117","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-105118","text":" "},{"id":"spn-105119","marks":["bold"],"text":"Files:"},{"id":"spn-105120","text":" "},{"id":"spn-105121","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-105122","text":", "},{"id":"spn-105123","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-105124","text":", edge types"}]},{"id":"blk-72244","kind":"paragraph","spans":[{"id":"spn-105125","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-105126","marks":["code"],"text":"contradicts"},{"id":"spn-105127","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-72245","kind":"paragraph","spans":[{"id":"spn-105128","text":"Implementation:"}]},{"id":"blk-72246","items":[{"blocks":[{"id":"blk-72248","kind":"paragraph","spans":[{"id":"spn-105129","text":"In "},{"id":"spn-105130","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-105131","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-105132","marks":["code"],"text":":contradicts"}]}],"id":"blk-72247","kind":"list-item"},{"blocks":[{"id":"blk-72250","kind":"paragraph","spans":[{"id":"spn-105133","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-105134","marks":["code"],"text":"inserted_at"},{"id":"spn-105135","text":" timestamps"}]}],"id":"blk-72249","kind":"list-item"},{"blocks":[{"id":"blk-72252","kind":"paragraph","spans":[{"id":"spn-105136","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-72251","kind":"list-item"},{"blocks":[{"id":"blk-72254","kind":"paragraph","spans":[{"id":"spn-105137","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-72253","kind":"list-item"},{"blocks":[{"id":"blk-72256","kind":"paragraph","spans":[{"id":"spn-105138","text":"Add "},{"id":"spn-105139","marks":["code"],"text":":supersedes"},{"id":"spn-105140","text":" edge type if not present"}]}],"id":"blk-72255","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72257","kind":"heading","level":3,"spans":[{"id":"spn-105141","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-72258","kind":"heading","level":4,"spans":[{"id":"spn-105142","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-72259","kind":"paragraph","spans":[{"id":"spn-105143","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105144","text":" "},{"id":"spn-105145","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-105146","text":" "},{"id":"spn-105147","marks":["bold"],"text":"File:"},{"id":"spn-105148","text":" "},{"id":"spn-105149","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-72260","kind":"paragraph","spans":[{"id":"spn-105150","text":"Replace flat "},{"id":"spn-105151","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-105152","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-72261","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-72262","items":[{"blocks":[{"id":"blk-72264","kind":"paragraph","spans":[{"id":"spn-105153","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-72263","kind":"list-item"},{"blocks":[{"id":"blk-72266","kind":"paragraph","spans":[{"id":"spn-105154","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-72265","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72267","kind":"paragraph","spans":[{"id":"spn-105155","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-72268","kind":"heading","level":4,"spans":[{"id":"spn-105156","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-72269","kind":"paragraph","spans":[{"id":"spn-105157","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105158","text":" "},{"id":"spn-105159","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-105160","text":" "},{"id":"spn-105161","marks":["bold"],"text":"File:"},{"id":"spn-105162","text":" "},{"id":"spn-105163","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-72270","kind":"paragraph","spans":[{"id":"spn-105164","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-105165","marks":["code"],"text":"fault_line_edges"},{"id":"spn-105166","text":":"}]},{"id":"blk-72271","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-72272","kind":"heading","level":4,"spans":[{"id":"spn-105167","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-72273","kind":"paragraph","spans":[{"id":"spn-105168","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105169","text":" "},{"id":"spn-105170","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-105171","text":" "},{"id":"spn-105172","marks":["bold"],"text":"File:"},{"id":"spn-105173","text":" "},{"id":"spn-105174","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-105175","text":" (or new module)"}]},{"id":"blk-72274","kind":"paragraph","spans":[{"id":"spn-105176","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-72275","items":[{"blocks":[{"id":"blk-72277","kind":"paragraph","spans":[{"id":"spn-105177","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-72276","kind":"list-item"},{"blocks":[{"id":"blk-72279","kind":"paragraph","spans":[{"id":"spn-105178","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-72278","kind":"list-item"},{"blocks":[{"id":"blk-72281","kind":"paragraph","spans":[{"id":"spn-105179","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-72280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72282","kind":"paragraph","spans":[{"id":"spn-105180","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-72283","kind":"heading","level":3,"spans":[{"id":"spn-105181","text":"κ Phase 3 — Polish"}]},{"id":"blk-72284","kind":"heading","level":4,"spans":[{"id":"spn-105182","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-72285","kind":"paragraph","spans":[{"id":"spn-105183","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105184","text":" "},{"id":"spn-105185","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-72286","kind":"paragraph","spans":[{"id":"spn-105186","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-72287","kind":"heading","level":4,"spans":[{"id":"spn-105187","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-72288","kind":"paragraph","spans":[{"id":"spn-105188","marks":["bold"],"text":"Goal ID:"},{"id":"spn-105189","text":" "},{"id":"spn-105190","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-72289","kind":"paragraph","spans":[{"id":"spn-105191","text":"Use "},{"id":"spn-105192","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-105193","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-72290","kind":"heading","level":2,"spans":[{"id":"spn-105194","text":"Recommended Implementation Order"}]},{"id":"blk-72291","kind":"paragraph","spans":[{"id":"spn-105195","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-72293","spans":[{"id":"spn-105196","text":"Order"}]},{"id":"blk-72294","spans":[{"id":"spn-105197","text":"Goal"}]},{"id":"blk-72295","spans":[{"id":"spn-105198","text":"Tag"}]},{"id":"blk-72296","spans":[{"id":"spn-105199","text":"Expected Impact"}]}],"id":"blk-72292","kind":"table","rows":[[{"id":"blk-72297","spans":[{"id":"spn-105200","text":"1"}]},{"id":"blk-72298","spans":[{"id":"spn-105201","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-72299","spans":[{"id":"spn-105202","text":"shr"}]},{"id":"blk-72300","spans":[{"id":"spn-105203","text":"+3-5pp SHR"}]}],[{"id":"blk-72301","spans":[{"id":"spn-105204","text":"2"}]},{"id":"blk-72302","spans":[{"id":"spn-105205","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-72303","spans":[{"id":"spn-105206","text":"shr"}]},{"id":"blk-72304","spans":[{"id":"spn-105207","text":"+2-3pp SHR"}]}],[{"id":"blk-72305","spans":[{"id":"spn-105208","text":"3"}]},{"id":"blk-72306","spans":[{"id":"spn-105209","text":"S3: Session Summary Nodes"}]},{"id":"blk-72307","spans":[{"id":"spn-105210","text":"shr"}]},{"id":"blk-72308","spans":[{"id":"spn-105211","text":"+3-5pp SHR"}]}],[{"id":"blk-72309","spans":[{"id":"spn-105212","text":"4"}]},{"id":"blk-72310","spans":[{"id":"spn-105213","text":"S2: Cross-Session Entity Edges"}]},{"id":"blk-72311","spans":[{"id":"spn-105214","text":"shr"}]},{"id":"blk-72312","spans":[{"id":"spn-105215","text":"+3-4pp SHR"}]}],[{"id":"blk-72313","spans":[{"id":"spn-105216","text":"5"}]},{"id":"blk-72314","spans":[{"id":"spn-105217","text":"S5: Session Diversity Re-ranking"}]},{"id":"blk-72315","spans":[{"id":"spn-105218","text":"shr"}]},{"id":"blk-72316","spans":[{"id":"spn-105219","text":"+2-3pp SHR"}]}],[{"id":"blk-72317","spans":[{"id":"spn-105220","text":"6"}]},{"id":"blk-72318","spans":[{"id":"spn-105221","text":"S8: Abstention Calibration"}]},{"id":"blk-72319","spans":[{"id":"spn-105222","text":"shr"}]},{"id":"blk-72320","spans":[{"id":"spn-105223","text":"+2-3pp QA"}]}],[{"id":"blk-72321","spans":[{"id":"spn-105224","text":"7"}]},{"id":"blk-72322","spans":[{"id":"spn-105225","text":"K1: Iterative Retrieval in Deliberation"}]},{"id":"blk-72323","spans":[{"id":"spn-105226","text":"κ"}]},{"id":"blk-72324","spans":[{"id":"spn-105227","text":"+8-12pp QA"}]}],[{"id":"blk-72325","spans":[{"id":"spn-105228","text":"8"}]},{"id":"blk-72326","spans":[{"id":"spn-105229","text":"K2: κ-Adaptive Retrieval Depth"}]},{"id":"blk-72327","spans":[{"id":"spn-105230","text":"κ"}]},{"id":"blk-72328","spans":[{"id":"spn-105231","text":"+3-5pp QA"}]}],[{"id":"blk-72329","spans":[{"id":"spn-105232","text":"9"}]},{"id":"blk-72330","spans":[{"id":"spn-105233","text":"K3: Temporal Contradiction via κ"}]},{"id":"blk-72331","spans":[{"id":"spn-105234","text":"κ"}]},{"id":"blk-72332","spans":[{"id":"spn-105235","t