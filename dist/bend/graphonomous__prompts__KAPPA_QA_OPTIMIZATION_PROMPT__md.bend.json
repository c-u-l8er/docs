{"bendscript":"0.1","blocks":[{"id":"blk-71242","kind":"heading","level":1,"spans":[{"id":"spn-102253","text":"κ-Topology QA & SHR Optimization — Session Prompt"}]},{"id":"blk-71243","kind":"heading","level":2,"spans":[{"id":"spn-102254","text":"Mission"}]},{"id":"blk-71244","kind":"paragraph","spans":[{"id":"spn-102255","text":"Push Graphonomous LongMemEval from "},{"id":"spn-102256","marks":["bold"],"text":"73% QA / 90.4% SHR → 95%+ QA / 97%+ SHR"},{"id":"spn-102257","text":" by leveraging the κ-invariant topology that no other memory system has, and fixing structural retrieval gaps."}]},{"id":"blk-71245","kind":"heading","level":2,"spans":[{"id":"spn-102258","text":"Current Baseline (as of 2026-04-02)"}]},{"head":[{"id":"blk-71247","spans":[{"id":"spn-102259","text":"Metric"}]},{"id":"blk-71248","spans":[{"id":"spn-102260","text":"Value"}]},{"id":"blk-71249","spans":[{"id":"spn-102261","text":"Gap to Target"}]}],"id":"blk-71246","kind":"table","rows":[[{"id":"blk-71250","spans":[{"id":"spn-102262","text":"Session Hit Rate (SHR)"}]},{"id":"blk-71251","spans":[{"id":"spn-102263","text":"90.4%"}]},{"id":"blk-71252","spans":[{"id":"spn-102264","text":"+6.6pp to 97%"}]}],[{"id":"blk-71253","spans":[{"id":"spn-102265","text":"QA Proxy Score"}]},{"id":"blk-71254","spans":[{"id":"spn-102266","text":"73.04%"}]},{"id":"blk-71255","spans":[{"id":"spn-102267","text":"+22pp to 95%"}]}],[{"id":"blk-71256","spans":[{"id":"spn-102268","text":"Multi-session SHR"}]},{"id":"blk-71257","spans":[{"id":"spn-102269","marks":["bold"],"text":"85.0%"}]},{"id":"blk-71258","spans":[{"id":"spn-102270","text":"worst category"}]}],[{"id":"blk-71259","spans":[{"id":"spn-102271","text":"Multi-session recall"}]},{"id":"blk-71260","spans":[{"id":"spn-102272","marks":["bold"],"text":"60.5%"}]},{"id":"blk-71261","spans":[{"id":"spn-102273","text":"only finding 60% of needed sessions"}]}],[{"id":"blk-71262","spans":[{"id":"spn-102274","text":"Temporal SHR"}]},{"id":"blk-71263","spans":[{"id":"spn-102275","text":"95.0%"}]},{"id":"blk-71264","spans":[{"id":"spn-102276","text":"strong"}]}],[{"id":"blk-71265","spans":[{"id":"spn-102277","text":"Temporal QA proxy"}]},{"id":"blk-71266","spans":[{"id":"spn-102278","text":"74.2%"}]},{"id":"blk-71267","spans":[{"id":"spn-102279","text":"gap despite good SHR"}]}],[{"id":"blk-71268","spans":[{"id":"spn-102280","text":"Abstention accuracy"}]},{"id":"blk-71269","spans":[{"id":"spn-102281","marks":["bold"],"text":"0.0%"}]},{"id":"blk-71270","spans":[{"id":"spn-102282","text":"broken threshold"}]}],[{"id":"blk-71271","spans":[{"id":"spn-102283","text":"Retrieval: similarity_limit"}]},{"id":"blk-71272","spans":[{"id":"spn-102284","text":"10"}]},{"id":"blk-71273","spans":[{"id":"spn-102285","text":"too few for multi-session"}]}],[{"id":"blk-71274","spans":[{"id":"spn-102286","text":"Retrieval: final_limit"}]},{"id":"blk-71275","spans":[{"id":"spn-102287","text":"20"}]},{"id":"blk-71276","spans":[{"id":"spn-102288","text":""}]}],[{"id":"blk-71277","spans":[{"id":"spn-102289","text":"Retrieval: expansion_hops"}]},{"id":"blk-71278","spans":[{"id":"spn-102290","text":"1"}]},{"id":"blk-71279","spans":[{"id":"spn-102291","text":"can't reach cross-session nodes"}]}],[{"id":"blk-71280","spans":[{"id":"spn-102292","text":"Retrieval: hop_decay"}]},{"id":"blk-71281","spans":[{"id":"spn-102293","text":"0.85 (flat)"}]},{"id":"blk-71282","spans":[{"id":"spn-102294","text":"not topology-aware"}]}],[{"id":"blk-71283","spans":[{"id":"spn-102295","text":"Deliberation"}]},{"id":"blk-71284","spans":[{"id":"spn-102296","text":"single-pass decompose-focus-reconcile"}]},{"id":"blk-71285","spans":[{"id":"spn-102297","text":"no iterative retrieval"}]}],[{"id":"blk-71286","spans":[{"id":"spn-102298","text":"Temporal indexing"}]},{"id":"blk-71287","spans":[{"id":"spn-102299","text":"none"}]},{"id":"blk-71288","spans":[{"id":"spn-102300","text":"biggest gap vs Chronos"}]}],[{"id":"blk-71289","spans":[{"id":"spn-102301","text":"Session edges at ingestion"}]},{"id":"blk-71290","spans":[{"id":"spn-102302","marks":["bold"],"text":"none"}]},{"id":"blk-71291","spans":[{"id":"spn-102303","text":"turns stored as isolated nodes"}]}],[{"id":"blk-71292","spans":[{"id":"spn-102304","text":"Cross-session entity edges"}]},{"id":"blk-71293","spans":[{"id":"spn-102305","marks":["bold"],"text":"none"}]},{"id":"blk-71294","spans":[{"id":"spn-102306","text":"BFS can't bridge sessions"}]}]]},{"id":"blk-71295","kind":"heading","level":2,"spans":[{"id":"spn-102307","text":"Competitive Landscape"}]},{"head":[{"id":"blk-71297","spans":[{"id":"spn-102308","text":"System"}]},{"id":"blk-71298","spans":[{"id":"spn-102309","text":"Score"}]},{"id":"blk-71299","spans":[{"id":"spn-102310","text":"Key Technique"}]}],"id":"blk-71296","kind":"table","rows":[[{"id":"blk-71300","spans":[{"id":"spn-102311","text":"Supermemory ASMR"}]},{"id":"blk-71301","spans":[{"id":"spn-102312","text":"~99%"}]},{"id":"blk-71302","spans":[{"id":"spn-102313","text":"8 parallel LLM agents, majority vote (very expensive)"}]}],[{"id":"blk-71303","spans":[{"id":"spn-102314","text":"Chronos"}]},{"id":"blk-71304","spans":[{"id":"spn-102315","text":"95.6%"}]},{"id":"blk-71305","spans":[{"id":"spn-102316","text":"Event tuples + temporal index + iterative tool-calling"}]}],[{"id":"blk-71306","spans":[{"id":"spn-102317","text":"Mastra OM"}]},{"id":"blk-71307","spans":[{"id":"spn-102318","text":"94.87%"}]},{"id":"blk-71308","spans":[{"id":"spn-102319","text":"Observer/Reflector compression, no retrieval needed"}]}],[{"id":"blk-71309","spans":[{"id":"spn-102320","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-71310","spans":[{"id":"spn-102321","marks":["bold"],"text":"73% QA / 90.4% SHR"}]},{"id":"blk-71311","spans":[{"id":"spn-102322","text":"Graph expansion + κ routing + deliberation"}]}],[{"id":"blk-71312","spans":[{"id":"spn-102323","text":"Emergence AI"}]},{"id":"blk-71313","spans":[{"id":"spn-102324","text":"86%"}]},{"id":"blk-71314","spans":[{"id":"spn-102325","text":"Well-tuned RAG only"}]}],[{"id":"blk-71315","spans":[{"id":"spn-102326","text":"Hindsight (Vectorize)"}]},{"id":"blk-71316","spans":[{"id":"spn-102327","text":"91.4% SHR"}]},{"id":"blk-71317","spans":[{"id":"spn-102328","text":"Current SHR SOTA for vector-based"}]}]]},{"id":"blk-71318","kind":"heading","level":2,"spans":[{"id":"spn-102329","text":"Part A: SHR Optimization Goals (tag: "},{"id":"spn-102330","marks":["code"],"text":"shr-optimization"},{"id":"spn-102331","text":")"}]},{"id":"blk-71319","kind":"paragraph","spans":[{"id":"spn-102332","text":"The SHR gap is primarily driven by "},{"id":"spn-102333","marks":["bold"],"text":"multi-session questions (85% SHR, 60.5% session recall)"},{"id":"spn-102334","text":". Root cause: turns are ingested as isolated nodes with no intra-session or cross-session edges, so BFS expansion can't bridge sessions."}]},{"id":"blk-71320","kind":"heading","level":3,"spans":[{"id":"spn-102335","text":"SHR Phase 1 — Structural Fixes (Implement First)"}]},{"id":"blk-71321","kind":"heading","level":4,"spans":[{"id":"spn-102336","text":"S1. Session-Aware Edge Linking at Ingestion (CRITICAL, +3-5pp SHR)"}]},{"id":"blk-71322","kind":"paragraph","spans":[{"id":"spn-102337","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102338","text":" "},{"id":"spn-102339","marks":["code"],"text":"goal_d98cc02a3043693529a881b5d754dd0d"},{"id":"spn-102340","text":" "},{"id":"spn-102341","marks":["bold"],"text":"File:"},{"id":"spn-102342","text":" "},{"id":"spn-102343","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102344","text":" → "},{"id":"spn-102345","marks":["code"],"text":"ingest_session/2"}]},{"id":"blk-71323","kind":"paragraph","spans":[{"id":"spn-102346","text":"Currently "},{"id":"spn-102347","marks":["code"],"text":"ingest_session/2"},{"id":"spn-102348","text":" stores each turn as an isolated node. Fix:"}]},{"id":"blk-71324","kind":"code","language":"elixir","text":"defp ingest_session(session_id, turns) when is_list(turns) do\n  node_ids =\n    turns\n    |> Enum.with_index()\n    |> Enum.map(fn {turn, turn_idx} ->\n      # ... existing store_node code ...\n      # Return the node_id\n      node_id\n    end)\n\n  # Add sequential edges between consecutive turns\n  node_ids\n  |> Enum.chunk_every(2, 1, :discard)\n  |> Enum.each(fn [prev, curr] ->\n    Graphonomous.store_edge(%{\n      source_id: prev,\n      target_id: curr,\n      edge_type: :sequence,\n      weight: 0.9,\n      metadata: %{\"session_id\" => session_id}\n    })\n  end)\nend"},{"id":"blk-71325","kind":"paragraph","spans":[{"id":"spn-102349","text":"This alone should improve multi-session SHR because BFS expansion from one turn now reaches all turns in the same session."}]},{"id":"blk-71326","kind":"heading","level":4,"spans":[{"id":"spn-102350","text":"S2. Cross-Session Entity Edges (HIGH, +3-4pp SHR)"}]},{"id":"blk-71327","kind":"paragraph","spans":[{"id":"spn-102351","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102352","text":" "},{"id":"spn-102353","marks":["code"],"text":"goal_676413bfeb49f07f502e5756e2c522ea"},{"id":"spn-102354","text":" "},{"id":"spn-102355","marks":["bold"],"text":"File:"},{"id":"spn-102356","text":" "},{"id":"spn-102357","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102358","text":" (new post-ingestion phase)"}]},{"id":"blk-71328","kind":"paragraph","spans":[{"id":"spn-102359","text":"After all sessions are ingested, run a second pass:"}]},{"id":"blk-71329","items":[{"blocks":[{"id":"blk-71331","kind":"paragraph","spans":[{"id":"spn-102360","text":"Extract named entities (people, places, preferences) from each turn node"}]}],"id":"blk-71330","kind":"list-item"},{"blocks":[{"id":"blk-71333","kind":"paragraph","spans":[{"id":"spn-102361","text":"For turns in different sessions mentioning the same entity, create "},{"id":"spn-102362","marks":["code"],"text":":related"},{"id":"spn-102363","text":" edges"}]}],"id":"blk-71332","kind":"list-item"},{"blocks":[{"id":"blk-71335","kind":"paragraph","spans":[{"id":"spn-102364","text":"Weight by entity specificity (proper nouns > common nouns)"}]}],"id":"blk-71334","kind":"list-item"},{"blocks":[{"id":"blk-71337","kind":"paragraph","spans":[{"id":"spn-102365","text":"This creates the cross-session graph bridges that BFS needs"}]}],"id":"blk-71336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71338","kind":"paragraph","spans":[{"id":"spn-102366","text":"Implementation approach:"}]},{"id":"blk-71339","items":[{"blocks":[{"id":"blk-71341","kind":"paragraph","spans":[{"id":"spn-102367","text":"Simple: keyword/regex entity extraction (fast, no LLM)"}]}],"id":"blk-71340","kind":"list-item"},{"blocks":[{"id":"blk-71343","kind":"paragraph","spans":[{"id":"spn-102368","text":"Better: use existing "},{"id":"spn-102369","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-102370","text":" which already does edge extraction"}]}],"id":"blk-71342","kind":"list-item"},{"blocks":[{"id":"blk-71345","kind":"paragraph","spans":[{"id":"spn-102371","text":"Add as \"Phase 1.5\" in the benchmark task between ingestion and evaluation"}]}],"id":"blk-71344","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71346","kind":"heading","level":4,"spans":[{"id":"spn-102372","text":"S3. Session-Level Summary Nodes (HIGH, +3-5pp SHR)"}]},{"id":"blk-71347","kind":"paragraph","spans":[{"id":"spn-102373","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102374","text":" "},{"id":"spn-102375","marks":["code"],"text":"goal_43634453e8fa66e51bda30b5365ed73c"},{"id":"spn-102376","text":" "},{"id":"spn-102377","marks":["bold"],"text":"File:"},{"id":"spn-102378","text":" "},{"id":"spn-102379","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"}]},{"id":"blk-71348","kind":"paragraph","spans":[{"id":"spn-102380","text":"After ingesting all turns for a session, create one summary node:"}]},{"id":"blk-71349","kind":"code","language":"elixir","text":"summary_content = turns\n  |> Enum.map(fn t -> \"[#{t[\"role\"]}] #{String.slice(t[\"content\"], 0, 200)}\" end)\n  |> Enum.join(\" | \")\n\nsummary_id = Graphonomous.store_node(%{\n  content: \"Session summary: #{summary_content}\",\n  node_type: :semantic,\n  confidence: 0.80,\n  source: \"longmemeval\",\n  metadata: %{\"session_id\" => session_id, \"is_summary\" => true, \"turn_count\" => length(turns)}\n})\n\n# Link summary to all turn nodes\nEnum.each(turn_node_ids, fn nid ->\n  Graphonomous.store_edge(%{source_id: summary_id, target_id: nid, edge_type: :contains, weight: 0.85})\nend)"},{"id":"blk-71350","kind":"paragraph","spans":[{"id":"spn-102381","text":"Creates LiCoMemory-style two-level hierarchy. Retrieval hits the summary, BFS expands to specific turns."}]},{"id":"blk-71351","kind":"heading","level":4,"spans":[{"id":"spn-102382","text":"S4. Increase Retrieval Limits (HIGH, +2-3pp SHR)"}]},{"id":"blk-71352","kind":"paragraph","spans":[{"id":"spn-102383","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102384","text":" "},{"id":"spn-102385","marks":["code"],"text":"goal_30d212e4e8f40406bcf69499447cb8a9"},{"id":"spn-102386","text":" "},{"id":"spn-102387","marks":["bold"],"text":"File:"},{"id":"spn-102388","text":" "},{"id":"spn-102389","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102390","text":" → "},{"id":"spn-102391","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-71353","kind":"paragraph","spans":[{"id":"spn-102392","text":"Change retrieval call from:"}]},{"id":"blk-71354","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text, limit: 10, expansion_hops: 1, neighbors_per_node: 5)"},{"id":"blk-71355","kind":"paragraph","spans":[{"id":"spn-102393","text":"To:"}]},{"id":"blk-71356","kind":"code","language":"elixir","text":"Graphonomous.retrieve_context(question_text,\n  similarity_limit: 20,\n  final_limit: 40,\n  expansion_hops: 1,\n  neighbors_per_node: 5\n)"},{"id":"blk-71357","kind":"paragraph","spans":[{"id":"spn-102394","text":"For even better results, make limits adaptive:"}]},{"id":"blk-71358","kind":"code","language":"elixir","text":"{sim_limit, final_limit} =\n  if question_type in [\"multi-session\", \"temporal-reasoning\"],\n    do: {25, 50},\n    else: {10, 20}"},{"id":"blk-71359","kind":"heading","level":3,"spans":[{"id":"spn-102395","text":"SHR Phase 2 — Retrieval Refinements"}]},{"id":"blk-71360","kind":"heading","level":4,"spans":[{"id":"spn-102396","text":"S5. Session Diversity Re-ranking (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-71361","kind":"paragraph","spans":[{"id":"spn-102397","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102398","text":" "},{"id":"spn-102399","marks":["code"],"text":"goal_ea328d4b1ac438e428f8664ac7a9ded6"},{"id":"spn-102400","text":" "},{"id":"spn-102401","marks":["bold"],"text":"File:"},{"id":"spn-102402","text":" "},{"id":"spn-102403","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71362","kind":"paragraph","spans":[{"id":"spn-102404","text":"Add session-aware diversity penalty alongside existing domain diversity:"}]},{"id":"blk-71363","kind":"code","language":"elixir","text":"defp apply_session_diversity(entries) do\n  session_counts = Enum.frequencies_by(entries, fn e ->\n    get_in(e, [:metadata, \"session_id\"]) || \"unknown\"\n  end)\n\n  Enum.map(entries, fn entry ->\n    sid = get_in(entry, [:metadata, \"session_id\"]) || \"unknown\"\n    count = Map.get(session_counts, sid, 1)\n    penalty = :math.pow(0.90, count - 1)\n    %{entry | score: entry.score * penalty}\n  end)\nend"},{"id":"blk-71364","kind":"paragraph","spans":[{"id":"spn-102405","text":"This spreads results across sessions, directly targeting the 60.5% multi-session recall."}]},{"id":"blk-71365","kind":"heading","level":4,"spans":[{"id":"spn-102406","text":"S6. Multi-Hop Expansion for Multi-Session (MEDIUM, +2-3pp SHR)"}]},{"id":"blk-71366","kind":"paragraph","spans":[{"id":"spn-102407","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102408","text":" "},{"id":"spn-102409","marks":["code"],"text":"goal_a8dd4b2bcd66e6c583a18ba47564bb38"},{"id":"spn-102410","text":" "},{"id":"spn-102411","marks":["bold"],"text":"File:"},{"id":"spn-102412","text":" "},{"id":"spn-102413","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71367","kind":"paragraph","spans":[{"id":"spn-102414","text":"After session-aware edges exist (S1, S2), increase expansion_hops to 2 for multi-session queries. One hop reaches same-session turns, two hops reaches cross-session entity bridges."}]},{"id":"blk-71368","kind":"heading","level":4,"spans":[{"id":"spn-102415","text":"S7. Temporal Metadata Indexing (MEDIUM, +1-2pp SHR, +5-8pp temporal QA)"}]},{"id":"blk-71369","kind":"paragraph","spans":[{"id":"spn-102416","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102417","text":" "},{"id":"spn-102418","marks":["code"],"text":"goal_ef2897d27e15bd7a94ff2ec0983e8982"},{"id":"spn-102419","text":" "},{"id":"spn-102420","marks":["bold"],"text":"Files:"},{"id":"spn-102421","text":" "},{"id":"spn-102422","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102423","text":", "},{"id":"spn-102424","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71370","kind":"paragraph","spans":[{"id":"spn-102425","text":"Store resolved timestamps in node metadata during ingestion. Add temporal range filtering to retrieval for temporal-reasoning questions."}]},{"id":"blk-71371","kind":"heading","level":4,"spans":[{"id":"spn-102426","text":"S8. Abstention Calibration (MEDIUM, +2-3pp overall QA)"}]},{"id":"blk-71372","kind":"paragraph","spans":[{"id":"spn-102427","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102428","text":" "},{"id":"spn-102429","marks":["code"],"text":"goal_aac9a2f1d9b4e93f49c39a2ab88ac75c"},{"id":"spn-102430","text":" "},{"id":"spn-102431","marks":["bold"],"text":"File:"},{"id":"spn-102432","text":" "},{"id":"spn-102433","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-102434","text":" → "},{"id":"spn-102435","marks":["code"],"text":"evaluate_question/1"}]},{"id":"blk-71373","kind":"paragraph","spans":[{"id":"spn-102436","text":"Current abstention threshold ("},{"id":"spn-102437","marks":["code"],"text":"avg_score < 0.15 or length(results) < 3"},{"id":"spn-102438","text":") gives 0% accuracy. Fix:"}]},{"id":"blk-71374","items":[{"blocks":[{"id":"blk-71376","kind":"paragraph","spans":[{"id":"spn-102439","text":"Use confidence gap: "},{"id":"spn-102440","marks":["code"],"text":"top_score - mean_score < 0.05"},{"id":"spn-102441","text":" → likely no clear answer"}]}],"id":"blk-71375","kind":"list-item"},{"blocks":[{"id":"blk-71378","kind":"paragraph","spans":[{"id":"spn-102442","text":"Use topology signal: no coherent SCC in results → likely abstention"}]}],"id":"blk-71377","kind":"list-item"},{"blocks":[{"id":"blk-71380","kind":"paragraph","spans":[{"id":"spn-102443","text":"Raise score threshold to "},{"id":"spn-102444","marks":["code"],"text":"avg_score < 0.25"}]}],"id":"blk-71379","kind":"list-item"},{"blocks":[{"id":"blk-71382","kind":"paragraph","spans":[{"id":"spn-102445","text":"All 6 abstention questions flipping = +3.6pp on overall QA proxy"}]}],"id":"blk-71381","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71383","kind":"heading","level":2,"spans":[{"id":"spn-102446","text":"Part B: κ-Topology QA Optimization Goals (tag: "},{"id":"spn-102447","marks":["code"],"text":"kappa-optimization"},{"id":"spn-102448","text":")"}]},{"id":"blk-71384","kind":"paragraph","spans":[{"id":"spn-102449","text":"These goals specifically leverage the κ-invariant to improve answer quality on questions where retrieval already finds the right sessions."}]},{"id":"blk-71385","kind":"heading","level":3,"spans":[{"id":"spn-102450","text":"κ Phase 1 — High Impact, Implement First"}]},{"id":"blk-71386","kind":"heading","level":4,"spans":[{"id":"spn-102451","text":"K1. Iterative Retrieval in Deliberation (CRITICAL, +8-12pp QA)"}]},{"id":"blk-71387","kind":"paragraph","spans":[{"id":"spn-102452","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102453","text":" "},{"id":"spn-102454","marks":["code"],"text":"goal_ab2e008d496aa8ae6bef4d161e425c90"},{"id":"spn-102455","text":" "},{"id":"spn-102456","marks":["bold"],"text":"File:"},{"id":"spn-102457","text":" "},{"id":"spn-102458","marks":["code"],"text":"lib/graphonomous/deliberator.ex"}]},{"id":"blk-71388","kind":"paragraph","spans":[{"id":"spn-102459","text":"Current deliberation is single-pass: decompose → focus → reconcile. Change focus steps to issue "},{"id":"spn-102460","marks":["bold"],"text":"follow-up graph traversals"},{"id":"spn-102461","text":" scoped to each SCC partition. The κ value already sets the iteration budget via "},{"id":"spn-102462","marks":["code"],"text":"deliberation_budget/1"},{"id":"spn-102463","text":". Model after Chronos iterative tool-calling loops."}]},{"id":"blk-71389","kind":"paragraph","spans":[{"id":"spn-102464","text":"Implementation:"}]},{"id":"blk-71390","items":[{"blocks":[{"id":"blk-71392","kind":"paragraph","spans":[{"id":"spn-102465","text":"In "},{"id":"spn-102466","marks":["code"],"text":"build_focused_prompt/5"},{"id":"spn-102467","text":", after building the initial prompt, add a "},{"id":"spn-102468","marks":["code"],"text":"retrieve_for_partition/3"},{"id":"spn-102469","text":" call that queries Graph for nodes within the partition's node set"}]}],"id":"blk-71391","kind":"list-item"},{"blocks":[{"id":"blk-71394","kind":"paragraph","spans":[{"id":"spn-102470","text":"In the main "},{"id":"spn-102471","marks":["code"],"text":"deliberate_scc/6"},{"id":"spn-102472","text":" loop, after each intermediate conclusion, check if confidence < threshold and issue another scoped retrieval"}]}],"id":"blk-71393","kind":"list-item"},{"blocks":[{"id":"blk-71396","kind":"paragraph","spans":[{"id":"spn-102473","text":"Use "},{"id":"spn-102474","marks":["code"],"text":"fault_line_edges"},{"id":"spn-102475","text":" to decide which partition side needs more evidence"}]}],"id":"blk-71395","kind":"list-item"},{"blocks":[{"id":"blk-71398","kind":"paragraph","spans":[{"id":"spn-102476","text":"Wire through "},{"id":"spn-102477","marks":["code"],"text":"Retriever.retrieve/2"},{"id":"spn-102478","text":" with a "},{"id":"spn-102479","marks":["code"],"text":"scope_to_node_ids"},{"id":"spn-102480","text":" option"}]}],"id":"blk-71397","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71399","kind":"paragraph","spans":[{"id":"spn-102481","text":"Test: Run "},{"id":"spn-102482","marks":["code"],"text":"mix benchmark.longmemeval --split oracle"},{"id":"spn-102483","text":" before and after. QA proxy score should increase."}]},{"id":"blk-71400","kind":"heading","level":4,"spans":[{"id":"spn-102484","text":"K2. κ-Guided Adaptive Retrieval Depth (HIGH, +3-5pp QA)"}]},{"id":"blk-71401","kind":"paragraph","spans":[{"id":"spn-102485","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102486","text":" "},{"id":"spn-102487","marks":["code"],"text":"goal_eae521c4f46b1a8e172f1474667e99f1"},{"id":"spn-102488","text":" "},{"id":"spn-102489","marks":["bold"],"text":"File:"},{"id":"spn-102490","text":" "},{"id":"spn-102491","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71402","kind":"paragraph","spans":[{"id":"spn-102492","text":"After initial seed retrieval and topology analysis, adjust expansion depth:"}]},{"id":"blk-71403","kind":"code","language":"elixir","text":"effective_hops = case topology.max_kappa do\n  0 -> opts[:expansion_hops] || @default_expansion_hops  # keep default (1)\n  k when k >= 1 -> min(k + 1, 3)                         # 2-3 hops for cyclic regions\nend"},{"id":"blk-71404","kind":"paragraph","spans":[{"id":"spn-102493","text":"This requires restructuring "},{"id":"spn-102494","marks":["code"],"text":"do_retrieve/3"},{"id":"spn-102495","text":" to:"}]},{"id":"blk-71405","items":[{"blocks":[{"id":"blk-71407","kind":"paragraph","spans":[{"id":"spn-102496","text":"Run similarity search (seeds)"}]}],"id":"blk-71406","kind":"list-item"},{"blocks":[{"id":"blk-71409","kind":"paragraph","spans":[{"id":"spn-102497","text":"Do a preliminary 1-hop expansion"}]}],"id":"blk-71408","kind":"list-item"},{"blocks":[{"id":"blk-71411","kind":"paragraph","spans":[{"id":"spn-102498","text":"Run topology analysis on the expanded set"}]}],"id":"blk-71410","kind":"list-item"},{"blocks":[{"id":"blk-71413","kind":"paragraph","spans":[{"id":"spn-102499","text":"If κ > 0, do additional hops up to "},{"id":"spn-102500","marks":["code"],"text":"effective_hops"}]}],"id":"blk-71412","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71414","kind":"heading","level":4,"spans":[{"id":"spn-102501","text":"K3. Temporal Contradiction Detection via κ (HIGH, +5-8pp QA)"}]},{"id":"blk-71415","kind":"paragraph","spans":[{"id":"spn-102502","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102503","text":" "},{"id":"spn-102504","marks":["code"],"text":"goal_b3613e912f86927f10a0f2a7f2470d6f"},{"id":"spn-102505","text":" "},{"id":"spn-102506","marks":["bold"],"text":"Files:"},{"id":"spn-102507","text":" "},{"id":"spn-102508","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-102509","text":", "},{"id":"spn-102510","marks":["code"],"text":"lib/graphonomous/deliberator.ex"},{"id":"spn-102511","text":", edge types"}]},{"id":"blk-71416","kind":"paragraph","spans":[{"id":"spn-102512","text":"Knowledge updates create contradictions: old fact ↔ new fact. When both exist with "},{"id":"spn-102513","marks":["code"],"text":"contradicts"},{"id":"spn-102514","text":" edges, they form a 2-node SCC with κ=1. The deliberator should detect these \"temporal contradiction SCCs\" and resolve to the temporally newer node."}]},{"id":"blk-71417","kind":"paragraph","spans":[{"id":"spn-102515","text":"Implementation:"}]},{"id":"blk-71418","items":[{"blocks":[{"id":"blk-71420","kind":"paragraph","spans":[{"id":"spn-102516","text":"In "},{"id":"spn-102517","marks":["code"],"text":"Deliberator.deliberate_scc/6"},{"id":"spn-102518","text":", detect 2-node SCCs with κ=1 where edges are "},{"id":"spn-102519","marks":["code"],"text":":contradicts"}]}],"id":"blk-71419","kind":"list-item"},{"blocks":[{"id":"blk-71422","kind":"paragraph","spans":[{"id":"spn-102520","text":"For these, skip full decompose-focus-reconcile — just compare "},{"id":"spn-102521","marks":["code"],"text":"inserted_at"},{"id":"spn-102522","text":" timestamps"}]}],"id":"blk-71421","kind":"list-item"},{"blocks":[{"id":"blk-71424","kind":"paragraph","spans":[{"id":"spn-102523","text":"Boost the newer node's confidence, decay the older one"}]}],"id":"blk-71423","kind":"list-item"},{"blocks":[{"id":"blk-71426","kind":"paragraph","spans":[{"id":"spn-102524","text":"Return conclusion favoring the newer fact"}]}],"id":"blk-71425","kind":"list-item"},{"blocks":[{"id":"blk-71428","kind":"paragraph","spans":[{"id":"spn-102525","text":"Add "},{"id":"spn-102526","marks":["code"],"text":":supersedes"},{"id":"spn-102527","text":" edge type if not present"}]}],"id":"blk-71427","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71429","kind":"heading","level":3,"spans":[{"id":"spn-102528","text":"κ Phase 2 — Medium Impact"}]},{"id":"blk-71430","kind":"heading","level":4,"spans":[{"id":"spn-102529","text":"K4. κ-Modulated Hop Decay (MEDIUM, +2-3pp QA)"}]},{"id":"blk-71431","kind":"paragraph","spans":[{"id":"spn-102530","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102531","text":" "},{"id":"spn-102532","marks":["code"],"text":"goal_d5f5b195ed91d6fcc459179c1dc0480f"},{"id":"spn-102533","text":" "},{"id":"spn-102534","marks":["bold"],"text":"File:"},{"id":"spn-102535","text":" "},{"id":"spn-102536","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71432","kind":"paragraph","spans":[{"id":"spn-102537","text":"Replace flat "},{"id":"spn-102538","marks":["code"],"text":"@default_hop_decay 0.85"},{"id":"spn-102539","text":" with κ-aware decay during BFS expansion:"}]},{"id":"blk-71433","kind":"code","language":"elixir","text":"defp effective_hop_decay(base_decay, local_kappa) do\n  base_decay + min(local_kappa * 0.02, 0.10)\nend"},{"id":"blk-71434","items":[{"blocks":[{"id":"blk-71436","kind":"paragraph","spans":[{"id":"spn-102540","text":"DAG regions (κ=0): use base decay (0.85)"}]}],"id":"blk-71435","kind":"list-item"},{"blocks":[{"id":"blk-71438","kind":"paragraph","spans":[{"id":"spn-102541","text":"Cyclic regions: gentler decay (up to 0.95) because cycles mean distant nodes may circle back"}]}],"id":"blk-71437","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71439","kind":"paragraph","spans":[{"id":"spn-102542","text":"Requires passing topology info into the BFS expansion step, which currently doesn't have it. May need a two-pass approach: expand → analyze topology → re-score with κ-aware decay."}]},{"id":"blk-71440","kind":"heading","level":4,"spans":[{"id":"spn-102543","text":"K5. Fault-Line-Aware Retrieval Boosting (MEDIUM, +2-4pp QA)"}]},{"id":"blk-71441","kind":"paragraph","spans":[{"id":"spn-102544","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102545","text":" "},{"id":"spn-102546","marks":["code"],"text":"goal_3ce56e41b144cba14d4971ed0c02fc56"},{"id":"spn-102547","text":" "},{"id":"spn-102548","marks":["bold"],"text":"File:"},{"id":"spn-102549","text":" "},{"id":"spn-102550","marks":["code"],"text":"lib/graphonomous/retriever.ex"}]},{"id":"blk-71442","kind":"paragraph","spans":[{"id":"spn-102551","text":"After topology analysis, boost scores of nodes adjacent to "},{"id":"spn-102552","marks":["code"],"text":"fault_line_edges"},{"id":"spn-102553","text":":"}]},{"id":"blk-71443","kind":"code","language":"elixir","text":"defp apply_fault_line_boost(entries, topology) do\n  fault_nodes = topology.sccs\n    |> Enum.flat_map(& &1.fault_line_edges)\n    |> Enum.flat_map(fn %{source: s, target: t} -> [s, t] end)\n    |> MapSet.new()\n\n  Enum.map(entries, fn entry ->\n    if MapSet.member?(fault_nodes, entry.node_id),\n      do: %{entry | score: entry.score * 1.15},\n      else: entry\n  end)\nend"},{"id":"blk-71444","kind":"heading","level":4,"spans":[{"id":"spn-102554","text":"K6. κ-Bucketed Answer Strategies (MEDIUM, +3-5pp QA)"}]},{"id":"blk-71445","kind":"paragraph","spans":[{"id":"spn-102555","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102556","text":" "},{"id":"spn-102557","marks":["code"],"text":"goal_1d658ad0a747cebb8f44a31d74f32fa8"},{"id":"spn-102558","text":" "},{"id":"spn-102559","marks":["bold"],"text":"File:"},{"id":"spn-102560","text":" "},{"id":"spn-102561","marks":["code"],"text":"lib/graphonomous/retriever.ex"},{"id":"spn-102562","text":" (or new module)"}]},{"id":"blk-71446","kind":"paragraph","spans":[{"id":"spn-102563","text":"Route the entire answer strategy by κ profile:"}]},{"id":"blk-71447","items":[{"blocks":[{"id":"blk-71449","kind":"paragraph","spans":[{"id":"spn-102564","text":"κ=0 everywhere → fast path, direct answer from top results"}]}],"id":"blk-71448","kind":"list-item"},{"blocks":[{"id":"blk-71451","kind":"paragraph","spans":[{"id":"spn-102565","text":"κ=1 (contradiction pattern) → resolve contradictions first, then answer"}]}],"id":"blk-71450","kind":"list-item"},{"blocks":[{"id":"blk-71453","kind":"paragraph","spans":[{"id":"spn-102566","text":"κ≥2 → full multi-pass deliberation"}]}],"id":"blk-71452","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71454","kind":"paragraph","spans":[{"id":"spn-102567","text":"This builds on goals K1 and K3. Implement after those are done."}]},{"id":"blk-71455","kind":"heading","level":3,"spans":[{"id":"spn-102568","text":"κ Phase 3 — Polish"}]},{"id":"blk-71456","kind":"heading","level":4,"spans":[{"id":"spn-102569","text":"K7. SCC Confidence Propagation (LOW, +1-2pp QA)"}]},{"id":"blk-71457","kind":"paragraph","spans":[{"id":"spn-102570","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102571","text":" "},{"id":"spn-102572","marks":["code"],"text":"goal_7464c6c4b2d84f46c2c80e3e8044927c"}]},{"id":"blk-71458","kind":"paragraph","spans":[{"id":"spn-102573","text":"Propagate confidence through SCC edges during retrieval. High-confidence nodes boost low-confidence neighbors. Scale boost by 1/κ."}]},{"id":"blk-71459","kind":"heading","level":4,"spans":[{"id":"spn-102574","text":"K8. Query-Time Edge Impact (LOW, +1-2pp QA)"}]},{"id":"blk-71460","kind":"paragraph","spans":[{"id":"spn-102575","marks":["bold"],"text":"Goal ID:"},{"id":"spn-102576","text":" "},{"id":"spn-102577","marks":["code"],"text":"goal_d4334f3f76ffa2c9fd07b98f2aa82632"}]},{"id":"blk-71461","kind":"paragraph","spans":[{"id":"spn-102578","text":"Use "},{"id":"spn-102579","marks":["code"],"text":"Topology.preview_edge_impact/3"},{"id":"spn-102580","text":" at query time to detect semantically related but unlinked result nodes. Synthesize bridge reasoning in deliberation."}]},{"id":"blk-71462","kind":"heading","level":2,"spans":[{"id":"spn-102581","text":"Recommended Implementation Order"}]},{"id":"blk-71463","kind":"paragraph","spans":[{"id":"spn-102582","text":"Do SHR structural fixes first (they unlock the κ optimizations), then κ QA work:"}]},{"head":[{"id":"blk-71465","spans":[{"id":"spn-102583","text":"Order"}]},{"id":"blk-71466","spans":[{"id":"spn-102584","text":"Goal"}]},{"id":"blk-71467","spans":[{"id":"spn-102585","text":"Tag"}]},{"id":"blk-71468","spans":[{"id":"spn-102586","text":"Expected Impact"}]}],"id":"blk-71464","kind":"table","rows":[[{"id":"blk-71469","spans":[{"id":"spn-102587","text":"1"}]},{"id":"blk-71470","spans":[{"id":"spn-102588","text":"S1: Session-Aware Edge Linking"}]},{"id":"blk-71471","spans":[{"id":"spn-102589","text":"shr"}]},{"id":"blk-71472","spans":[{"id":"spn-102590","text":"+3-5pp SHR"}]}],[{"id":"blk-71473","spans":[{"id":"spn-102591","text":"2"}]},{"id":"blk-71474","spans":[{"id":"spn-102592","text":"S4: Increase Retrieval Limits"}]},{"id":"blk-71475","spans":[{"id":"spn-102593","text":"shr"}]},{"id":"blk-71476",