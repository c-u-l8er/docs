{"bendscript":"0.1","blocks":[{"id":"blk-67386","kind":"heading","level":1,"spans":[{"id":"spn-98008","text":"Goal Management"}]},{"id":"blk-67387","kind":"paragraph","spans":[{"id":"spn-98009","text":"Track durable intent across sessions — create goals, update progress, link knowledge."}]},{"id":"blk-67388","kind":"heading","level":2,"spans":[{"id":"spn-98010","text":"Arguments"}]},{"id":"blk-67389","kind":"paragraph","spans":[{"id":"spn-98011","text":"Operation and details: $ARGUMENTS"}]},{"id":"blk-67390","kind":"heading","level":2,"spans":[{"id":"spn-98012","text":"Operations"}]},{"id":"blk-67391","kind":"heading","level":3,"spans":[{"id":"spn-98013","text":"Create a goal"}]},{"id":"blk-67392","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"create_goal\", payload: {\n  \"title\": \"Implement auth middleware\",\n  \"description\": \"Add JWT-based auth to all API routes\",\n  \"priority\": \"high\",\n  \"horizon\": \"short\",\n  \"parent_goal_id\": \"<parent-id>\",\n  \"completion_criteria\": [\"All routes require valid JWT\", \"Tests pass\"],\n  \"tags\": [\"auth\", \"security\"]\n})"},{"id":"blk-67393","kind":"paragraph","spans":[{"id":"spn-98014","marks":["bold"],"text":"Payload fields:"}]},{"id":"blk-67394","items":[{"blocks":[{"id":"blk-67396","kind":"paragraph","spans":[{"id":"spn-98015","marks":["code"],"text":"title"},{"id":"spn-98016","text":" (required) — concise goal name"}]}],"id":"blk-67395","kind":"list-item"},{"blocks":[{"id":"blk-67398","kind":"paragraph","spans":[{"id":"spn-98017","marks":["code"],"text":"description"},{"id":"spn-98018","text":" — detailed explanation"}]}],"id":"blk-67397","kind":"list-item"},{"blocks":[{"id":"blk-67400","kind":"paragraph","spans":[{"id":"spn-98019","marks":["code"],"text":"priority"},{"id":"spn-98020","text":" — "},{"id":"spn-98021","marks":["code"],"text":"\"low\""},{"id":"spn-98022","text":", "},{"id":"spn-98023","marks":["code"],"text":"\"medium\""},{"id":"spn-98024","text":", "},{"id":"spn-98025","marks":["code"],"text":"\"high\""},{"id":"spn-98026","text":", "},{"id":"spn-98027","marks":["code"],"text":"\"critical\""}]}],"id":"blk-67399","kind":"list-item"},{"blocks":[{"id":"blk-67402","kind":"paragraph","spans":[{"id":"spn-98028","marks":["code"],"text":"horizon"},{"id":"spn-98029","text":" — "},{"id":"spn-98030","marks":["code"],"text":"\"short\""},{"id":"spn-98031","text":" (hours), "},{"id":"spn-98032","marks":["code"],"text":"\"medium\""},{"id":"spn-98033","text":" (days), "},{"id":"spn-98034","marks":["code"],"text":"\"long\""},{"id":"spn-98035","text":" (weeks+)"}]}],"id":"blk-67401","kind":"list-item"},{"blocks":[{"id":"blk-67404","kind":"paragraph","spans":[{"id":"spn-98036","marks":["code"],"text":"parent_goal_id"},{"id":"spn-98037","text":" — for sub-goal decomposition (critical for large goals)"}]}],"id":"blk-67403","kind":"list-item"},{"blocks":[{"id":"blk-67406","kind":"paragraph","spans":[{"id":"spn-98038","marks":["code"],"text":"completion_criteria"},{"id":"spn-98039","text":" — array of success conditions"}]}],"id":"blk-67405","kind":"list-item"},{"blocks":[{"id":"blk-67408","kind":"paragraph","spans":[{"id":"spn-98040","marks":["code"],"text":"tags"},{"id":"spn-98041","text":" — array of labels for filtering"}]}],"id":"blk-67407","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67409","kind":"paragraph","spans":[{"id":"spn-98042","text":"Save the returned "},{"id":"spn-98043","marks":["code"],"text":"goal_id"},{"id":"spn-98044","text":"."}]},{"id":"blk-67410","kind":"heading","level":3,"spans":[{"id":"spn-98045","text":"Get a specific goal"}]},{"id":"blk-67411","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<id>\")"},{"id":"blk-67412","kind":"paragraph","spans":[{"id":"spn-98046","text":"Returns full goal state: status, progress, linked nodes, metadata, timestamps."}]},{"id":"blk-67413","kind":"heading","level":3,"spans":[{"id":"spn-98047","text":"List goals"}]},{"id":"blk-67414","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"})"},{"id":"blk-67415","kind":"paragraph","spans":[{"id":"spn-98048","text":"Filter by: "},{"id":"spn-98049","marks":["code"],"text":"status"},{"id":"spn-98050","text":", "},{"id":"spn-98051","marks":["code"],"text":"priority"},{"id":"spn-98052","text":", "},{"id":"spn-98053","marks":["code"],"text":"tags"},{"id":"spn-98054","text":". Status values: "},{"id":"spn-98055","marks":["code"],"text":"proposed"},{"id":"spn-98056","text":", "},{"id":"spn-98057","marks":["code"],"text":"active"},{"id":"spn-98058","text":", "},{"id":"spn-98059","marks":["code"],"text":"blocked"},{"id":"spn-98060","text":", "},{"id":"spn-98061","marks":["code"],"text":"completed"},{"id":"spn-98062","text":", "},{"id":"spn-98063","marks":["code"],"text":"failed"},{"id":"spn-98064","text":", "},{"id":"spn-98065","marks":["code"],"text":"suspended"},{"id":"spn-98066","text":", "},{"id":"spn-98067","marks":["code"],"text":"abandoned"},{"id":"spn-98068","text":"."}]},{"id":"blk-67416","kind":"heading","level":3,"spans":[{"id":"spn-98069","text":"Transition goal status"}]},{"id":"blk-67417","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"transition_goal\", goal_id: \"<id>\", new_status: \"completed\", metadata: {\n  \"reason\": \"All completion criteria met\",\n  \"evidence\": [\"test-suite-passed\", \"coverage-review-act\"],\n  \"context\": \"session-2026-03-28\"\n})"},{"id":"blk-67418","kind":"paragraph","spans":[{"id":"spn-98070","text":"Always use "},{"id":"spn-98071","marks":["code"],"text":"transition_goal"},{"id":"spn-98072","text":" (not "},{"id":"spn-98073","marks":["code"],"text":"update_goal"},{"id":"spn-98074","text":") for status changes — provides audit trail. Include "},{"id":"spn-98075","marks":["code"],"text":"reason"},{"id":"spn-98076","text":" and evidence in metadata."}]},{"id":"blk-67419","kind":"heading","level":3,"spans":[{"id":"spn-98077","text":"Set progress"}]},{"id":"blk-67420","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"set_progress\", goal_id: \"<id>\", progress: 0.6, metadata: {\n  \"basis\": \"3 of 5 sub-goals completed\"\n})"},{"id":"blk-67421","kind":"paragraph","spans":[{"id":"spn-98078","marks":["bold"],"text":"Progress benchmarks (base on evidence, not optimism):"}]},{"id":"blk-67422","items":[{"blocks":[{"id":"blk-67424","kind":"paragraph","spans":[{"id":"spn-98079","text":"0.0 — not started"}]}],"id":"blk-67423","kind":"list-item"},{"blocks":[{"id":"blk-67426","kind":"paragraph","spans":[{"id":"spn-98080","text":"0.1-0.3 — early exploration, initial nodes stored"}]}],"id":"blk-67425","kind":"list-item"},{"blocks":[{"id":"blk-67428","kind":"paragraph","spans":[{"id":"spn-98081","text":"0.3-0.5 — core knowledge captured, key sub-goals active"}]}],"id":"blk-67427","kind":"list-item"},{"blocks":[{"id":"blk-67430","kind":"paragraph","spans":[{"id":"spn-98082","text":"0.5-0.7 — substantial coverage, most sub-goals done"}]}],"id":"blk-67429","kind":"list-item"},{"blocks":[{"id":"blk-67432","kind":"paragraph","spans":[{"id":"spn-98083","text":"0.7-0.9 — near complete, verifying/testing"}]}],"id":"blk-67431","kind":"list-item"},{"blocks":[{"id":"blk-67434","kind":"paragraph","spans":[{"id":"spn-98084","text":"1.0 — all criteria met"}]}],"id":"blk-67433","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67435","kind":"heading","level":3,"spans":[{"id":"spn-98085","text":"Link knowledge to goals"}]},{"id":"blk-67436","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"link_nodes\", goal_id: \"<id>\", node_ids: [\"<node1>\", \"<node2>\"])"},{"id":"blk-67437","kind":"paragraph","spans":[{"id":"spn-98086","text":"Every node created for a goal should be linked. "},{"id":"spn-98087","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-98088","text":"