rks":["code"],"text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<top-priority-id>\")"}]}],"id":"blk-67448","kind":"list-item"},{"blocks":[{"id":"blk-67451","kind":"paragraph","spans":[{"id":"spn-98105","text":"Resume work with context from linked nodes"}]}],"id":"blk-67450","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67452","kind":"heading","level":2,"spans":[{"id":"spn-98106","text":"Anti-patterns to avoid"}]},{"id":"blk-67453","items":[{"blocks":[{"id":"blk-67455","kind":"paragraph","spans":[{"id":"spn-98107","text":"Goal monolith — one giant goal instead of 3-6 sub-goals"}]}],"id":"blk-67454","kind":"list-item"},{"blocks":[{"id":"blk-67457","kind":"paragraph","spans":[{"id":"spn-98108","text":"Orphan goals — creating goals but never linking nodes or updating progress"}]}],"id":"blk-67456","kind":"list-item"},{"blocks":[{"id":"blk-67459","kind":"paragraph","spans":[{"id":"spn-98109","text":"Progress fantasy — setting progress based on optimism, not evidence"}]}],"id":"blk-67458","kind":"list-item"},{"blocks":[{"id":"blk-67461","kind":"paragraph","spans":[{"id":"spn-98110","text":"Status shortcuts — using "},{"id":"spn-98111","marks":["code"],"text":"update_goal"},{"id":"spn-98112","text":" instead of "},{"id":"spn-98113","marks":["code"],"text":"transition_goal"},{"id":"spn-98114","text":" for status changes"}]}],"id":"blk-67460","kind":"list-item"},{"blocks":[{"id":"blk-67463","kind":"paragraph","spans":[{"id":"spn-98115","text":"Ignoring "},{"id":"spn-98116","marks":["code"],"text":"blocked"},{"id":"spn-98117","text":" — not escalating when coverage is insufficient"}]}],"id":"blk-67462","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierakbtbbvtvsp6o6h4tthbgqv27a55gm7racwvjfcmfhbhovoo6cyba","vocabulary":"ampersand.docs.fs.v1"}