rks":["code"],"text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<top-priority-id>\")"}]}],"id":"blk-67437","kind":"list-item"},{"blocks":[{"id":"blk-67440","kind":"paragraph","spans":[{"id":"spn-98052","text":"Resume work with context from linked nodes"}]}],"id":"blk-67439","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67441","kind":"heading","level":2,"spans":[{"id":"spn-98053","text":"Anti-patterns to avoid"}]},{"id":"blk-67442","items":[{"blocks":[{"id":"blk-67444","kind":"paragraph","spans":[{"id":"spn-98054","text":"Goal monolith — one giant goal instead of 3-6 sub-goals"}]}],"id":"blk-67443","kind":"list-item"},{"blocks":[{"id":"blk-67446","kind":"paragraph","spans":[{"id":"spn-98055","text":"Orphan goals — creating goals but never linking nodes or updating progress"}]}],"id":"blk-67445","kind":"list-item"},{"blocks":[{"id":"blk-67448","kind":"paragraph","spans":[{"id":"spn-98056","text":"Progress fantasy — setting progress based on optimism, not evidence"}]}],"id":"blk-67447","kind":"list-item"},{"blocks":[{"id":"blk-67450","kind":"paragraph","spans":[{"id":"spn-98057","text":"Status shortcuts — using "},{"id":"spn-98058","marks":["code"],"text":"update_goal"},{"id":"spn-98059","text":" instead of "},{"id":"spn-98060","marks":["code"],"text":"transition_goal"},{"id":"spn-98061","text":" for status changes"}]}],"id":"blk-67449","kind":"list-item"},{"blocks":[{"id":"blk-67452","kind":"paragraph","spans":[{"id":"spn-98062","text":"Ignoring "},{"id":"spn-98063","marks":["code"],"text":"blocked"},{"id":"spn-98064","text":" — not escalating when coverage is insufficient"}]}],"id":"blk-67451","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieramtuadnd2y3jqfmqvppkwfstjm7o3dqy6pq2sz4reeocm5it3i46q","vocabulary":"ampersand.docs.fs.v1"}