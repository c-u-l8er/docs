{"bendscript":"0.1","blocks":[{"id":"blk-67512","kind":"heading","level":1,"spans":[{"id":"spn-98156","text":"Goal Management"}]},{"id":"blk-67513","kind":"paragraph","spans":[{"id":"spn-98157","text":"Track durable intent across sessions — create goals, update progress, link knowledge."}]},{"id":"blk-67514","kind":"heading","level":2,"spans":[{"id":"spn-98158","text":"Arguments"}]},{"id":"blk-67515","kind":"paragraph","spans":[{"id":"spn-98159","text":"Operation and details: $ARGUMENTS"}]},{"id":"blk-67516","kind":"heading","level":2,"spans":[{"id":"spn-98160","text":"Operations"}]},{"id":"blk-67517","kind":"heading","level":3,"spans":[{"id":"spn-98161","text":"Create a goal"}]},{"id":"blk-67518","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"create_goal\", payload: {\n  \"title\": \"Implement auth middleware\",\n  \"description\": \"Add JWT-based auth to all API routes\",\n  \"priority\": \"high\",\n  \"horizon\": \"short\",\n  \"parent_goal_id\": \"<parent-id>\",\n  \"completion_criteria\": [\"All routes require valid JWT\", \"Tests pass\"],\n  \"tags\": [\"auth\", \"security\"]\n})"},{"id":"blk-67519","kind":"paragraph","spans":[{"id":"spn-98162","marks":["bold"],"text":"Payload fields:"}]},{"id":"blk-67520","items":[{"blocks":[{"id":"blk-67522","kind":"paragraph","spans":[{"id":"spn-98163","marks":["code"],"text":"title"},{"id":"spn-98164","text":" (required) — concise goal name"}]}],"id":"blk-67521","kind":"list-item"},{"blocks":[{"id":"blk-67524","kind":"paragraph","spans":[{"id":"spn-98165","marks":["code"],"text":"description"},{"id":"spn-98166","text":" — detailed explanation"}]}],"id":"blk-67523","kind":"list-item"},{"blocks":[{"id":"blk-67526","kind":"paragraph","spans":[{"id":"spn-98167","marks":["code"],"text":"priority"},{"id":"spn-98168","text":" — "},{"id":"spn-98169","marks":["code"],"text":"\"low\""},{"id":"spn-98170","text":", "},{"id":"spn-98171","marks":["code"],"text":"\"medium\""},{"id":"spn-98172","text":", "},{"id":"spn-98173","marks":["code"],"text":"\"high\""},{"id":"spn-98174","text":", "},{"id":"spn-98175","marks":["code"],"text":"\"critical\""}]}],"id":"blk-67525","kind":"list-item"},{"blocks":[{"id":"blk-67528","kind":"paragraph","spans":[{"id":"spn-98176","marks":["code"],"text":"horizon"},{"id":"spn-98177","text":" — "},{"id":"spn-98178","marks":["code"],"text":"\"short\""},{"id":"spn-98179","text":" (hours), "},{"id":"spn-98180","marks":["code"],"text":"\"medium\""},{"id":"spn-98181","text":" (days), "},{"id":"spn-98182","marks":["code"],"text":"\"long\""},{"id":"spn-98183","text":" (weeks+)"}]}],"id":"blk-67527","kind":"list-item"},{"blocks":[{"id":"blk-67530","kind":"paragraph","spans":[{"id":"spn-98184","marks":["code"],"text":"parent_goal_id"},{"id":"spn-98185","text":" — for sub-goal decomposition (critical for large goals)"}]}],"id":"blk-67529","kind":"list-item"},{"blocks":[{"id":"blk-67532","kind":"paragraph","spans":[{"id":"spn-98186","marks":["code"],"text":"completion_criteria"},{"id":"spn-98187","text":" — array of success conditions"}]}],"id":"blk-67531","kind":"list-item"},{"blocks":[{"id":"blk-67534","kind":"paragraph","spans":[{"id":"spn-98188","marks":["code"],"text":"tags"},{"id":"spn-98189","text":" — array of labels for filtering"}]}],"id":"blk-67533","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67535","kind":"paragraph","spans":[{"id":"spn-98190","text":"Save the returned "},{"id":"spn-98191","marks":["code"],"text":"goal_id"},{"id":"spn-98192","text":"."}]},{"id":"blk-67536","kind":"heading","level":3,"spans":[{"id":"spn-98193","text":"Get a specific goal"}]},{"id":"blk-67537","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<id>\")"},{"id":"blk-67538","kind":"paragraph","spans":[{"id":"spn-98194","text":"Returns full goal state: status, progress, linked nodes, metadata, timestamps."}]},{"id":"blk-67539","kind":"heading","level":3,"spans":[{"id":"spn-98195","text":"List goals"}]},{"id":"blk-67540","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"})"},{"id":"blk-67541","kind":"paragraph","spans":[{"id":"spn-98196","text":"Filter by: "},{"id":"spn-98197","marks":["code"],"text":"status"},{"id":"spn-98198","text":", "},{"id":"spn-98199","marks":["code"],"text":"priority"},{"id":"spn-98200","text":", "},{"id":"spn-98201","marks":["code"],"text":"tags"},{"id":"spn-98202","text":". Status values: "},{"id":"spn-98203","marks":["code"],"text":"proposed"},{"id":"spn-98204","text":", "},{"id":"spn-98205","marks":["code"],"text":"active"},{"id":"spn-98206","text":", "},{"id":"spn-98207","marks":["code"],"text":"blocked"},{"id":"spn-98208","text":", "},{"id":"spn-98209","marks":["code"],"text":"completed"},{"id":"spn-98210","text":", "},{"id":"spn-98211","marks":["code"],"text":"failed"},{"id":"spn-98212","text":", "},{"id":"spn-98213","marks":["code"],"text":"suspended"},{"id":"spn-98214","text":", "},{"id":"spn-98215","marks":["code"],"text":"abandoned"},{"id":"spn-98216","text":"."}]},{"id":"blk-67542","kind":"heading","level":3,"spans":[{"id":"spn-98217","text":"Transition goal status"}]},{"id":"blk-67543","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"transition_goal\", goal_id: \"<id>\", new_status: \"completed\", metadata: {\n  \"reason\": \"All completion criteria met\",\n  \"evidence\": [\"test-suite-passed\", \"coverage-review-act\"],\n  \"context\": \"session-2026-03-28\"\n})"},{"id":"blk-67544","kind":"paragraph","spans":[{"id":"spn-98218","text":"Always use "},{"id":"spn-98219","marks":["code"],"text":"transition_goal"},{"id":"spn-98220","text":" (not "},{"id":"spn-98221","marks":["code"],"text":"update_goal"},{"id":"spn-98222","text":") for status changes — provides audit trail. Include "},{"id":"spn-98223","marks":["code"],"text":"reason"},{"id":"spn-98224","text":" and evidence in metadata."}]},{"id":"blk-67545","kind":"heading","level":3,"spans":[{"id":"spn-98225","text":"Set progress"}]},{"id":"blk-67546","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"set_progress\", goal_id: \"<id>\", progress: 0.6, metadata: {\n  \"basis\": \"3 of 5 sub-goals completed\"\n})"},{"id":"blk-67547","kind":"paragraph","spans":[{"id":"spn-98226","marks":["bold"],"text":"Progress benchmarks (base on evidence, not optimism):"}]},{"id":"blk-67548","items":[{"blocks":[{"id":"blk-67550","kind":"paragraph","spans":[{"id":"spn-98227","text":"0.0 — not started"}]}],"id":"blk-67549","kind":"list-item"},{"blocks":[{"id":"blk-67552","kind":"paragraph","spans":[{"id":"spn-98228","text":"0.1-0.3 — early exploration, initial nodes stored"}]}],"id":"blk-67551","kind":"list-item"},{"blocks":[{"id":"blk-67554","kind":"paragraph","spans":[{"id":"spn-98229","text":"0.3-0.5 — core knowledge captured, key sub-goals active"}]}],"id":"blk-67553","kind":"list-item"},{"blocks":[{"id":"blk-67556","kind":"paragraph","spans":[{"id":"spn-98230","text":"0.5-0.7 — substantial coverage, most sub-goals done"}]}],"id":"blk-67555","kind":"list-item"},{"blocks":[{"id":"blk-67558","kind":"paragraph","spans":[{"id":"spn-98231","text":"0.7-0.9 — near complete, verifying/testing"}]}],"id":"blk-67557","kind":"list-item"},{"blocks":[{"id":"blk-67560","kind":"paragraph","spans":[{"id":"spn-98232","text":"1.0 — all criteria met"}]}],"id":"blk-67559","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67561","kind":"heading","level":3,"spans":[{"id":"spn-98233","text":"Link knowledge to goals"}]},{"id":"blk-67562","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"link_nodes\", goal_id: \"<id>\", node_ids: [\"<node1>\", \"<node2>\"])"},{"id":"blk-67563","kind":"paragraph","spans":[{"id":"spn-98234","text":"Every node created for a goal should be linked. "},{"id":"spn-98235","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-98236","text":"