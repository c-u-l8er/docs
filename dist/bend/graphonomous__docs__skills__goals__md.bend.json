{"bendscript":"0.1","blocks":[{"id":"blk-67375","kind":"heading","level":1,"spans":[{"id":"spn-97955","text":"Goal Management"}]},{"id":"blk-67376","kind":"paragraph","spans":[{"id":"spn-97956","text":"Track durable intent across sessions — create goals, update progress, link knowledge."}]},{"id":"blk-67377","kind":"heading","level":2,"spans":[{"id":"spn-97957","text":"Arguments"}]},{"id":"blk-67378","kind":"paragraph","spans":[{"id":"spn-97958","text":"Operation and details: $ARGUMENTS"}]},{"id":"blk-67379","kind":"heading","level":2,"spans":[{"id":"spn-97959","text":"Operations"}]},{"id":"blk-67380","kind":"heading","level":3,"spans":[{"id":"spn-97960","text":"Create a goal"}]},{"id":"blk-67381","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"create_goal\", payload: {\n  \"title\": \"Implement auth middleware\",\n  \"description\": \"Add JWT-based auth to all API routes\",\n  \"priority\": \"high\",\n  \"horizon\": \"short\",\n  \"parent_goal_id\": \"<parent-id>\",\n  \"completion_criteria\": [\"All routes require valid JWT\", \"Tests pass\"],\n  \"tags\": [\"auth\", \"security\"]\n})"},{"id":"blk-67382","kind":"paragraph","spans":[{"id":"spn-97961","marks":["bold"],"text":"Payload fields:"}]},{"id":"blk-67383","items":[{"blocks":[{"id":"blk-67385","kind":"paragraph","spans":[{"id":"spn-97962","marks":["code"],"text":"title"},{"id":"spn-97963","text":" (required) — concise goal name"}]}],"id":"blk-67384","kind":"list-item"},{"blocks":[{"id":"blk-67387","kind":"paragraph","spans":[{"id":"spn-97964","marks":["code"],"text":"description"},{"id":"spn-97965","text":" — detailed explanation"}]}],"id":"blk-67386","kind":"list-item"},{"blocks":[{"id":"blk-67389","kind":"paragraph","spans":[{"id":"spn-97966","marks":["code"],"text":"priority"},{"id":"spn-97967","text":" — "},{"id":"spn-97968","marks":["code"],"text":"\"low\""},{"id":"spn-97969","text":", "},{"id":"spn-97970","marks":["code"],"text":"\"medium\""},{"id":"spn-97971","text":", "},{"id":"spn-97972","marks":["code"],"text":"\"high\""},{"id":"spn-97973","text":", "},{"id":"spn-97974","marks":["code"],"text":"\"critical\""}]}],"id":"blk-67388","kind":"list-item"},{"blocks":[{"id":"blk-67391","kind":"paragraph","spans":[{"id":"spn-97975","marks":["code"],"text":"horizon"},{"id":"spn-97976","text":" — "},{"id":"spn-97977","marks":["code"],"text":"\"short\""},{"id":"spn-97978","text":" (hours), "},{"id":"spn-97979","marks":["code"],"text":"\"medium\""},{"id":"spn-97980","text":" (days), "},{"id":"spn-97981","marks":["code"],"text":"\"long\""},{"id":"spn-97982","text":" (weeks+)"}]}],"id":"blk-67390","kind":"list-item"},{"blocks":[{"id":"blk-67393","kind":"paragraph","spans":[{"id":"spn-97983","marks":["code"],"text":"parent_goal_id"},{"id":"spn-97984","text":" — for sub-goal decomposition (critical for large goals)"}]}],"id":"blk-67392","kind":"list-item"},{"blocks":[{"id":"blk-67395","kind":"paragraph","spans":[{"id":"spn-97985","marks":["code"],"text":"completion_criteria"},{"id":"spn-97986","text":" — array of success conditions"}]}],"id":"blk-67394","kind":"list-item"},{"blocks":[{"id":"blk-67397","kind":"paragraph","spans":[{"id":"spn-97987","marks":["code"],"text":"tags"},{"id":"spn-97988","text":" — array of labels for filtering"}]}],"id":"blk-67396","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67398","kind":"paragraph","spans":[{"id":"spn-97989","text":"Save the returned "},{"id":"spn-97990","marks":["code"],"text":"goal_id"},{"id":"spn-97991","text":"."}]},{"id":"blk-67399","kind":"heading","level":3,"spans":[{"id":"spn-97992","text":"Get a specific goal"}]},{"id":"blk-67400","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<id>\")"},{"id":"blk-67401","kind":"paragraph","spans":[{"id":"spn-97993","text":"Returns full goal state: status, progress, linked nodes, metadata, timestamps."}]},{"id":"blk-67402","kind":"heading","level":3,"spans":[{"id":"spn-97994","text":"List goals"}]},{"id":"blk-67403","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"})"},{"id":"blk-67404","kind":"paragraph","spans":[{"id":"spn-97995","text":"Filter by: "},{"id":"spn-97996","marks":["code"],"text":"status"},{"id":"spn-97997","text":", "},{"id":"spn-97998","marks":["code"],"text":"priority"},{"id":"spn-97999","text":", "},{"id":"spn-98000","marks":["code"],"text":"tags"},{"id":"spn-98001","text":". Status values: "},{"id":"spn-98002","marks":["code"],"text":"proposed"},{"id":"spn-98003","text":", "},{"id":"spn-98004","marks":["code"],"text":"active"},{"id":"spn-98005","text":", "},{"id":"spn-98006","marks":["code"],"text":"blocked"},{"id":"spn-98007","text":", "},{"id":"spn-98008","marks":["code"],"text":"completed"},{"id":"spn-98009","text":", "},{"id":"spn-98010","marks":["code"],"text":"failed"},{"id":"spn-98011","text":", "},{"id":"spn-98012","marks":["code"],"text":"suspended"},{"id":"spn-98013","text":", "},{"id":"spn-98014","marks":["code"],"text":"abandoned"},{"id":"spn-98015","text":"."}]},{"id":"blk-67405","kind":"heading","level":3,"spans":[{"id":"spn-98016","text":"Transition goal status"}]},{"id":"blk-67406","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"transition_goal\", goal_id: \"<id>\", new_status: \"completed\", metadata: {\n  \"reason\": \"All completion criteria met\",\n  \"evidence\": [\"test-suite-passed\", \"coverage-review-act\"],\n  \"context\": \"session-2026-03-28\"\n})"},{"id":"blk-67407","kind":"paragraph","spans":[{"id":"spn-98017","text":"Always use "},{"id":"spn-98018","marks":["code"],"text":"transition_goal"},{"id":"spn-98019","text":" (not "},{"id":"spn-98020","marks":["code"],"text":"update_goal"},{"id":"spn-98021","text":") for status changes — provides audit trail. Include "},{"id":"spn-98022","marks":["code"],"text":"reason"},{"id":"spn-98023","text":" and evidence in metadata."}]},{"id":"blk-67408","kind":"heading","level":3,"spans":[{"id":"spn-98024","text":"Set progress"}]},{"id":"blk-67409","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"set_progress\", goal_id: \"<id>\", progress: 0.6, metadata: {\n  \"basis\": \"3 of 5 sub-goals completed\"\n})"},{"id":"blk-67410","kind":"paragraph","spans":[{"id":"spn-98025","marks":["bold"],"text":"Progress benchmarks (base on evidence, not optimism):"}]},{"id":"blk-67411","items":[{"blocks":[{"id":"blk-67413","kind":"paragraph","spans":[{"id":"spn-98026","text":"0.0 — not started"}]}],"id":"blk-67412","kind":"list-item"},{"blocks":[{"id":"blk-67415","kind":"paragraph","spans":[{"id":"spn-98027","text":"0.1-0.3 — early exploration, initial nodes stored"}]}],"id":"blk-67414","kind":"list-item"},{"blocks":[{"id":"blk-67417","kind":"paragraph","spans":[{"id":"spn-98028","text":"0.3-0.5 — core knowledge captured, key sub-goals active"}]}],"id":"blk-67416","kind":"list-item"},{"blocks":[{"id":"blk-67419","kind":"paragraph","spans":[{"id":"spn-98029","text":"0.5-0.7 — substantial coverage, most sub-goals done"}]}],"id":"blk-67418","kind":"list-item"},{"blocks":[{"id":"blk-67421","kind":"paragraph","spans":[{"id":"spn-98030","text":"0.7-0.9 — near complete, verifying/testing"}]}],"id":"blk-67420","kind":"list-item"},{"blocks":[{"id":"blk-67423","kind":"paragraph","spans":[{"id":"spn-98031","text":"1.0 — all criteria met"}]}],"id":"blk-67422","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67424","kind":"heading","level":3,"spans":[{"id":"spn-98032","text":"Link knowledge to goals"}]},{"id":"blk-67425","kind":"code","language":"text","text":"act(action: \"manage_goal\", operation: \"link_nodes\", goal_id: \"<id>\", node_ids: [\"<node1>\", \"<node2>\"])"},{"id":"blk-67426","kind":"paragraph","spans":[{"id":"spn-98033","text":"Every node created for a goal should be linked. "},{"id":"spn-98034","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-98035","text":"