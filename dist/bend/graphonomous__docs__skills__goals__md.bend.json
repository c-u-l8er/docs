rks":["code"],"text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<top-priority-id>\")"}]}],"id":"blk-67574","kind":"list-item"},{"blocks":[{"id":"blk-67577","kind":"paragraph","spans":[{"id":"spn-98253","text":"Resume work with context from linked nodes"}]}],"id":"blk-67576","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67578","kind":"heading","level":2,"spans":[{"id":"spn-98254","text":"Anti-patterns to avoid"}]},{"id":"blk-67579","items":[{"blocks":[{"id":"blk-67581","kind":"paragraph","spans":[{"id":"spn-98255","text":"Goal monolith — one giant goal instead of 3-6 sub-goals"}]}],"id":"blk-67580","kind":"list-item"},{"blocks":[{"id":"blk-67583","kind":"paragraph","spans":[{"id":"spn-98256","text":"Orphan goals — creating goals but never linking nodes or updating progress"}]}],"id":"blk-67582","kind":"list-item"},{"blocks":[{"id":"blk-67585","kind":"paragraph","spans":[{"id":"spn-98257","text":"Progress fantasy — setting progress based on optimism, not evidence"}]}],"id":"blk-67584","kind":"list-item"},{"blocks":[{"id":"blk-67587","kind":"paragraph","spans":[{"id":"spn-98258","text":"Status shortcuts — using "},{"id":"spn-98259","marks":["code"],"text":"update_goal"},{"id":"spn-98260","text":" instead of "},{"id":"spn-98261","marks":["code"],"text":"transition_goal"},{"id":"spn-98262","text":" for status changes"}]}],"id":"blk-67586","kind":"list-item"},{"blocks":[{"id":"blk-67589","kind":"paragraph","spans":[{"id":"spn-98263","text":"Ignoring "},{"id":"spn-98264","marks":["code"],"text":"blocked"},{"id":"spn-98265","text":" — not escalating when coverage is insufficient"}]}],"id":"blk-67588","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraip4xnp5di3wzajzue2wxeohxdzmhvzdclz4pprt2ob6eomsiql7a","vocabulary":"ampersand.docs.fs.v1"}