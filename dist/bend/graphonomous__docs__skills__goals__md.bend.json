-auth-goal-id>\",\n  \"priority\": \"high\",\n  \"horizon\": \"short\"\n})"},{"id":"blk-43234","kind":"heading","level":2,"spans":[{"id":"spn-49357","text":"Session startup pattern"}]},{"id":"blk-43235","kind":"paragraph","spans":[{"id":"spn-49358","text":"1. "},{"id":"spn-49359","marks":["code"],"text":"act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"})"},{"id":"spn-49360","text":" 2. "},{"id":"spn-49361","marks":["code"],"text":"act(action: \"manage_goal\", operation: \"get_goal\", goal_id: \"<top-priority-id>\")"},{"id":"spn-49362","text":" 3. Resume work with context from linked nodes"}]},{"id":"blk-43236","kind":"heading","level":2,"spans":[{"id":"spn-49363","text":"Anti-patterns to avoid"}]},{"id":"blk-43237","items":[{"blocks":[{"id":"blk-43239","kind":"paragraph","spans":[{"id":"spn-49364","text":"Goal monolith — one giant goal instead of 3-6 sub-goals"}]}],"id":"blk-43238","kind":"list-item"},{"blocks":[{"id":"blk-43241","kind":"paragraph","spans":[{"id":"spn-49365","text":"Orphan goals — creating goals but never linking nodes or updating progress"}]}],"id":"blk-43240","kind":"list-item"},{"blocks":[{"id":"blk-43243","kind":"paragraph","spans":[{"id":"spn-49366","text":"Progress fantasy — setting progress based on optimism, not evidence"}]}],"id":"blk-43242","kind":"list-item"},{"blocks":[{"id":"blk-43245","kind":"paragraph","spans":[{"id":"spn-49367","text":"Status shortcuts — using "},{"id":"spn-49368","marks":["code"],"text":"update_goal"},{"id":"spn-49369","text":" instead of "},{"id":"spn-49370","marks":["code"],"text":"transition_goal"},{"id":"spn-49371","text":" for status changes"}]}],"id":"blk-43244","kind":"list-item"},{"blocks":[{"id":"blk-43247","kind":"paragraph","spans":[{"id":"spn-49372","text":"Ignoring "},{"id":"spn-49373","marks":["code"],"text":"blocked"},{"id":"spn-49374","text":" — not escalating when coverage is insufficient"}]}],"id":"blk-43246","kind":"list-item"}],"kind":"list","ordered":false