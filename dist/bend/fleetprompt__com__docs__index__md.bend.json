46","kind":"list-item"},{"blocks":[{"id":"blk-61449","kind":"paragraph","spans":[{"id":"spn-93003","marks":[{"kind":"link","predicate":"cites","target":"https://docs.fleetprompt.com"}],"text":"FleetPrompt Docs"}]}],"id":"blk-61448","kind":"list-item"},{"blocks":[{"id":"blk-61451","kind":"paragraph","spans":[{"id":"spn-93004","marks":[{"kind":"link","predicate":"cites","target":"https://docs.geofleetic.com"}],"text":"GeoFleetic Docs"}]}],"id":"blk-61450","kind":"list-item"},{"blocks":[{"id":"blk-61453","kind":"paragraph","spans":[{"id":"spn-93005","marks":[{"kind":"link","predicate":"cites","target":"https://docs.opensentience.org"}],"text":"OpenSentience Docs"}]}],"id":"blk-61452","kind":"list-item"},{"blocks":[{"id":"blk-61455","kind":"paragraph","spans":[{"id":"spn-93006","marks":[{"kind":"link","predicate":"cites","target":"https://docs.specprompt.com"}],"text":"SpecPrompt Docs"}]}],"id":"blk-61454","kind":"list-item"},{"blocks":[{"id":"blk-61457","kind":"paragraph","spans":[{"id":"spn-93007","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ticktickclock.com"}],"text":"TickTickClock Docs"}]}],"id":"blk-61456","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-61458","kind":"paragraph","spans":[{"id":"spn-93008","marks":["bold"],"text":"FleetPrompt Docs"}]},{"id":"blk-61459","items":[{"blocks":[{"id":"blk-61461","kind":"paragraph","spans":[{"id":"spn-93009","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/spec/README.md"}],"text":"README"}]}],"id":"blk-61460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-61462","kind":"heading","level":2,"spans":[{"id":"spn-93010","text":"Design Principles"}]},{"id":"blk-61463","items":[{"blocks":[{"id":"blk-61465","kind":"paragraph","spans":[{"id":"spn-93011","marks":["bold"],"text":"Manifest-first"},{"id":"spn-93012","text":" — Every agent defined by a machine-readable manifest. No opaque binaries."}]}],"id":"blk-61464","kind":"list-item"},{"blocks":[{"id":"blk-61467","kind":"paragraph","spans":[{"id":"spn-93013","marks":["bold"],"text":"Trust by computation"},{"id":"spn-93014","text":" — Trust scores derived from tests, audits, and usage — never self-reported."}]}],"id":"blk-61466","kind":"list-item"},{"blocks":[{"id":"blk-61469","kind":"paragraph","spans":[{"id":"spn-93015","marks":["bold"],"text":"Permission transparency"},{"id":"spn-93016","text":" — All permissions declared upfront, reviewed on install."}]}],"id":"blk-61468","kind":"list-item"},{"blocks":[{"id":"blk-61471","kind":"paragraph","spans":[{"id":"spn-93017","marks":["bold"],"text":"Provenance chain"},{"id":"spn-93018","text":" — Every version links to its SpecPrompt spec, build pipeline, and audit trail."}]}],"id":"blk-61470","kind":"list-item"},{"blocks":[{"id":"blk-61473","kind":"paragraph","spans":[{"id":"spn-93019","marks":["bold"],"text":"One-click deploy"},{"id":"spn-93020","text":" — Install means deploy to OpenSentience. No manual wiring."}]}],"id":"blk-61472","kind":"list-item"},{"blocks":[{"id":"blk-61475","kind":"paragraph","spans":[{"id":"spn-93021","marks":["bold"],"text":"Open registry"},{"id":"spn-93022","text":" — Public agents are free to publish and install. The marketplace is the commons."}]}],"id":"blk-61474","kind":"list-item"},{"blocks":[{"id":"blk-61477","kind":"paragraph","spans":[{"id":"spn-93023","marks":["bold"],"text":"Fork-friendly"},{"id":"spn-93024","text":" — Any public agent can be forked, customized, and republished."}]}],"id":"blk-61476","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-61478","kind":"heading","level":2,"spans":[{"id":"spn-93025","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-61480","spans":[{"id":"spn-93026","text":"Component"}]},{"id":"blk-61481","spans":[{"id":"spn-93027","text":"Role"}]},{"id":"blk-61482","spans":[{"id":"spn-93028","text":"OTP Pattern"}]}],"id":"blk-61479","kind":"table","rows":[[{"id":"blk-61483","spans":[{"id":"spn-93029","marks":["bold"],"text":"Registry Core"}]},{"id":"blk-61484","spans":[{"id":"spn-93030","text":"Manifest storage, version control, search indexing, fork management"}]},{"id":"blk-61485","spans":[{"id":"spn-93031","text":"Ecto + ETS"}]}],[{"id":"blk-61486","spans":[{"id":"spn-93032","marks":["bold"],"text":"Trust Engine"}]},{"id":"blk-61487","spans":[{"id":"spn-93033","text":"Async recompute of trust scores on new data"}]},{"id":"blk-61488","spans":[{"id":"spn-93034","text":"GenServer per agent"}]}],[{"id":"blk-61489","spans":[{"id":"spn-93035","marks":["bold"],"text":"Install Engine"}]},{"id":"blk-61490","spans":[{"id":"spn-93036","text":"Manifest → OpenSentience deploy with permission review gate"}]},{"id":"blk-61491","spans":[{"id":"spn-93037","text":"Task pipeline"}]}],[{"id":"blk-61492","spans":[{"id":"spn-93038","marks":["bold"],"text":"Search"}]},{"id":"blk-61493","spans":[{"id":"spn-93039","text":"Full-text + capability + trust-score search"}]},{"id":"blk-61494","spans":[{"id":"spn-93040","text":"ETS + PostgreSQL"}]}],[{"id":"blk-61495","spans":[{"id":"spn-93041","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-61496","spans":[{"id":"spn-93042","text":"Agent search, detail, trust scores, publisher profiles"}]},{"id":"blk-61497","spans":[{"id":"spn-93043","text":"Phoenix LiveView"}]}]]},{"id":"blk-61498","kind":"heading","level":2,"spans":[{"id":"spn-93044","text":"The Trust Pipeline"}]},{"id":"blk-61499","kind":"paragraph","spans":[{"id":"spn-93045","text":"Every agent on FleetPrompt gets a computed trust score based on:"}]},{"id":"blk-61500","items":[{"blocks":[{"id":"blk-61502","kind":"paragraph","spans":[{"id":"spn-93046","marks":["bold"],"text":"Test coverage"},{"id":"spn-93047","text":" — percentage of acceptance criteria with passing tests"}]}],"id":"blk-61501","kind":"list-item"},{"blocks":[{"id":"blk-61504","kind":"paragraph","spans":[{"id":"spn-93048","marks":["bold"],"text":"Build provenance"},{"id":"spn-93049","text":" — deterministic builds with hash-linked artifacts"}]}],"id":"