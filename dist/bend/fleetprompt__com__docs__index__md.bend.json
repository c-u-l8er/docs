":"blk-60639","kind":"paragraph","spans":[{"id":"spn-90374","marks":["bold"],"text":"Trust by computation"},{"id":"spn-90375","text":" — Trust scores derived from tests, audits, and usage — never self-reported."}]}],"id":"blk-60638","kind":"list-item"},{"blocks":[{"id":"blk-60641","kind":"paragraph","spans":[{"id":"spn-90376","marks":["bold"],"text":"Permission transparency"},{"id":"spn-90377","text":" — All permissions declared upfront, reviewed on install."}]}],"id":"blk-60640","kind":"list-item"},{"blocks":[{"id":"blk-60643","kind":"paragraph","spans":[{"id":"spn-90378","marks":["bold"],"text":"Provenance chain"},{"id":"spn-90379","text":" — Every version links to its SpecPrompt spec, build pipeline, and audit trail."}]}],"id":"blk-60642","kind":"list-item"},{"blocks":[{"id":"blk-60645","kind":"paragraph","spans":[{"id":"spn-90380","marks":["bold"],"text":"One-click deploy"},{"id":"spn-90381","text":" — Install means deploy to OpenSentience. No manual wiring."}]}],"id":"blk-60644","kind":"list-item"},{"blocks":[{"id":"blk-60647","kind":"paragraph","spans":[{"id":"spn-90382","marks":["bold"],"text":"Open registry"},{"id":"spn-90383","text":" — Public agents are free to publish and install. The marketplace is the commons."}]}],"id":"blk-60646","kind":"list-item"},{"blocks":[{"id":"blk-60649","kind":"paragraph","spans":[{"id":"spn-90384","marks":["bold"],"text":"Fork-friendly"},{"id":"spn-90385","text":" — Any public agent can be forked, customized, and republished."}]}],"id":"blk-60648","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-60650","kind":"heading","level":2,"spans":[{"id":"spn-90386","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-60652","spans":[{"id":"spn-90387","text":"Component"}]},{"id":"blk-60653","spans":[{"id":"spn-90388","text":"Role"}]},{"id":"blk-60654","spans":[{"id":"spn-90389","text":"OTP Pattern"}]}],"id":"blk-60651","kind":"table","rows":[[{"id":"blk-60655","spans":[{"id":"spn-90390","marks":["bold"],"text":"Registry Core"}]},{"id":"blk-60656","spans":[{"id":"spn-90391","text":"Manifest storage, version control, search indexing, fork management"}]},{"id":"blk-60657","spans":[{"id":"spn-90392","text":"Ecto + ETS"}]}],[{"id":"blk-60658","spans":[{"id":"spn-90393","marks":["bold"],"text":"Trust Engine"}]},{"id":"blk-60659","spans":[{"id":"spn-90394","text":"Async recompute of trust scores on new data"}]},{"id":"blk-60660","spans":[{"id":"spn-90395","text":"GenServer per agent"}]}],[{"id":"blk-60661","spans":[{"id":"spn-90396","marks":["bold"],"text":"Install Engine"}]},{"id":"blk-60662","spans":[{"id":"spn-90397","text":"Manifest → OpenSentience deploy with permission review gate"}]},{"id":"blk-60663","spans":[{"id":"spn-90398","text":"Task pipeline"}]}],[{"id":"blk-60664","spans":[{"id":"spn-90399","marks":["bold"],"text":"Search"}]},{"id":"blk-60665","spans":[{"id":"spn-90400","text":"Full-text + capability + trust-score search"}]},{"id":"blk-60666","spans":[{"id":"spn-90401","text":"ETS + PostgreSQL"}]}],[{"id":"blk-60667","spans":[{"id":"spn-90402","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-60668","spans":[{"id":"spn-90403","text":"Agent search, detail, trust scores, publisher profiles"}]},{"id":"blk-60669","spans":[{"id":"spn-90404","text":"Phoenix LiveView"}]}]]},{"id":"blk-60670","kind":"heading","level":2,"spans":[{"id":"spn-90405","text":"The Trust Pipeline"}]},{"id":"blk-60671","kind":"paragraph","spans":[{"id":"spn-90406","text":"Every agent on FleetPrompt gets a computed trust score based on:"}]},{"id":"blk-60672","items":[{"blocks":[{"id":"blk-60674","kind":"paragraph","spans":[{"id":"spn-90407","marks":["bold"],"text":"Test coverage"},{"id":"spn-90408","text":" — percentage of acceptance criteria with passing tests"}]}],"id":"blk-60673","kind":"list-item"},{"blocks":[{"id":"blk-60676","kind":"paragraph","spans":[{"id":"spn-90409","marks":["bold"],"text":"Build provenance"},{"id":"spn-90410","text":" — deterministic builds with hash-linked artifacts"}]}],"id":"blk-60675","kind":"list-item"},{"blocks":[{"id":"blk-60678","kind":"paragraph","spans":[{"id":"spn-90411","marks":["bold"],"text":"Usage metrics"},{"id":"spn-90412","text":" — install count, active deployments, error rates"}]}],"id":"blk-60677","kind":"list-item"},{"blocks":[{"id":"blk-60680","kind":"paragraph","spans":[{"id":"spn-90413","marks":["bold"],"text":"Audit trail"},{"id":"spn-90414","text":" — linked SpecPrompt spec, Agentelic build history"}]}],"id":"blk-60679","kind":"list-item"},{"blocks":[{"id":"blk-60682","kind":"paragraph","spans":[{"id":"spn-90415","marks":["bold"],"text":"Community signals"},{"id":"spn-90416","text":" — forks, reviews, reports"}]}],"id":"blk-60681","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-60683","kind":"paragraph","spans":[{"id":"spn-90417","text":"Trust scores are recomputed asynchronously whenever new data arrives."}]},{"id":"blk-60684","kind":"heading","level":2,"spans":[{"id":"spn-90418","text":"Project Links"}]},{"id":"blk-60685","items":[{"blocks":[{"id":"blk-60687","kind":"paragraph","spans":[{"id":"spn-90419","marks":["bold"],"text":"Spec:"},{"id":"spn-90420","text":" "},{"id":"spn-90421","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-60686","kind":"list-item"},{"blocks":[{"id":"blk-60689","kind":"paragraph","spans":[{"id":"spn-90422","marks":["bold"],"text":"User stories:"},{"id":"spn-90423","text":" "},{"id":"spn-90424","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/ux/user-stories.md"}],"text":"FleetPrompt User Stories"}]}],"id":"blk-60688","kind":"list-item"},{"blocks":[{"id":"blk-60691","kind":"paragraph","spans":[{"id":"spn-90425","marks":["bold"],"text":"Build prompt:"},{"id":"spn-90426","text":" "},{"id":"spn-90427","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/prompts/BUILD.md"}],"text":"FleetPrompt Implementation Build Prompt"}]}],"id":"blk-60