81","kind":"list-item"},{"blocks":[{"id":"blk-60484","kind":"paragraph","spans":[{"id":"spn-90163","marks":[{"kind":"link","predicate":"cites","target":"https://docs.fleetprompt.com"}],"text":"FleetPrompt Docs"}]}],"id":"blk-60483","kind":"list-item"},{"blocks":[{"id":"blk-60486","kind":"paragraph","spans":[{"id":"spn-90164","marks":[{"kind":"link","predicate":"cites","target":"https://docs.geofleetic.com"}],"text":"GeoFleetic Docs"}]}],"id":"blk-60485","kind":"list-item"},{"blocks":[{"id":"blk-60488","kind":"paragraph","spans":[{"id":"spn-90165","marks":[{"kind":"link","predicate":"cites","target":"https://docs.opensentience.org"}],"text":"OpenSentience Docs"}]}],"id":"blk-60487","kind":"list-item"},{"blocks":[{"id":"blk-60490","kind":"paragraph","spans":[{"id":"spn-90166","marks":[{"kind":"link","predicate":"cites","target":"https://docs.specprompt.com"}],"text":"SpecPrompt Docs"}]}],"id":"blk-60489","kind":"list-item"},{"blocks":[{"id":"blk-60492","kind":"paragraph","spans":[{"id":"spn-90167","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ticktickclock.com"}],"text":"TickTickClock Docs"}]}],"id":"blk-60491","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-60493","kind":"paragraph","spans":[{"id":"spn-90168","marks":["bold"],"text":"FleetPrompt Docs"}]},{"id":"blk-60494","items":[{"blocks":[{"id":"blk-60496","kind":"paragraph","spans":[{"id":"spn-90169","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/spec/README.md"}],"text":"README"}]}],"id":"blk-60495","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-60497","kind":"heading","level":2,"spans":[{"id":"spn-90170","text":"Design Principles"}]},{"id":"blk-60498","items":[{"blocks":[{"id":"blk-60500","kind":"paragraph","spans":[{"id":"spn-90171","marks":["bold"],"text":"Manifest-first"},{"id":"spn-90172","text":" — Every agent defined by a machine-readable manifest. No opaque binaries."}]}],"id":"blk-60499","kind":"list-item"},{"blocks":[{"id":"blk-60502","kind":"paragraph","spans":[{"id":"spn-90173","marks":["bold"],"text":"Trust by computation"},{"id":"spn-90174","text":" — Trust scores derived from tests, audits, and usage — never self-reported."}]}],"id":"blk-60501","kind":"list-item"},{"blocks":[{"id":"blk-60504","kind":"paragraph","spans":[{"id":"spn-90175","marks":["bold"],"text":"Permission transparency"},{"id":"spn-90176","text":" — All permissions declared upfront, reviewed on install."}]}],"id":"blk-60503","kind":"list-item"},{"blocks":[{"id":"blk-60506","kind":"paragraph","spans":[{"id":"spn-90177","marks":["bold"],"text":"Provenance chain"},{"id":"spn-90178","text":" — Every version links to its SpecPrompt spec, build pipeline, and audit trail."}]}],"id":"blk-60505","kind":"list-item"},{"blocks":[{"id":"blk-60508","kind":"paragraph","spans":[{"id":"spn-90179","marks":["bold"],"text":"One-click deploy"},{"id":"spn-90180","text":" — Install means deploy to OpenSentience. No manual wiring."}]}],"id":"blk-60507","kind":"list-item"},{"blocks":[{"id":"blk-60510","kind":"paragraph","spans":[{"id":"spn-90181","marks":["bold"],"text":"Open registry"},{"id":"spn-90182","text":" — Public agents are free to publish and install. The marketplace is the commons."}]}],"id":"blk-60509","kind":"list-item"},{"blocks":[{"id":"blk-60512","kind":"paragraph","spans":[{"id":"spn-90183","marks":["bold"],"text":"Fork-friendly"},{"id":"spn-90184","text":" — Any public agent can be forked, customized, and republished."}]}],"id":"blk-60511","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-60513","kind":"heading","level":2,"spans":[{"id":"spn-90185","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-60515","spans":[{"id":"spn-90186","text":"Component"}]},{"id":"blk-60516","spans":[{"id":"spn-90187","text":"Role"}]},{"id":"blk-60517","spans":[{"id":"spn-90188","text":"OTP Pattern"}]}],"id":"blk-60514","kind":"table","rows":[[{"id":"blk-60518","spans":[{"id":"spn-90189","marks":["bold"],"text":"Registry Core"}]},{"id":"blk-60519","spans":[{"id":"spn-90190","text":"Manifest storage, version control, search indexing, fork management"}]},{"id":"blk-60520","spans":[{"id":"spn-90191","text":"Ecto + ETS"}]}],[{"id":"blk-60521","spans":[{"id":"spn-90192","marks":["bold"],"text":"Trust Engine"}]},{"id":"blk-60522","spans":[{"id":"spn-90193","text":"Async recompute of trust scores on new data"}]},{"id":"blk-60523","spans":[{"id":"spn-90194","text":"GenServer per agent"}]}],[{"id":"blk-60524","spans":[{"id":"spn-90195","marks":["bold"],"text":"Install Engine"}]},{"id":"blk-60525","spans":[{"id":"spn-90196","text":"Manifest → OpenSentience deploy with permission review gate"}]},{"id":"blk-60526","spans":[{"id":"spn-90197","text":"Task pipeline"}]}],[{"id":"blk-60527","spans":[{"id":"spn-90198","marks":["bold"],"text":"Search"}]},{"id":"blk-60528","spans":[{"id":"spn-90199","text":"Full-text + capability + trust-score search"}]},{"id":"blk-60529","spans":[{"id":"spn-90200","text":"ETS + PostgreSQL"}]}],[{"id":"blk-60530","spans":[{"id":"spn-90201","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-60531","spans":[{"id":"spn-90202","text":"Agent search, detail, trust scores, publisher profiles"}]},{"id":"blk-60532","spans":[{"id":"spn-90203","text":"Phoenix LiveView"}]}]]},{"id":"blk-60533","kind":"heading","level":2,"spans":[{"id":"spn-90204","text":"The Trust Pipeline"}]},{"id":"blk-60534","kind":"paragraph","spans":[{"id":"spn-90205","text":"Every agent on FleetPrompt gets a computed trust score based on:"}]},{"id":"blk-60535","items":[{"blocks":[{"id":"blk-60537","kind":"paragraph","spans":[{"id":"spn-90206","marks":["bold"],"text":"Test coverage"},{"id":"spn-90207","text":" — percentage of acceptance criteria with passing tests"}]}],"id":"blk-60536","kind":"list-item"},{"blocks":[{"id":"blk-60539","kind":"paragraph","spans":[{"id":"spn-90208","marks":["bold"],"text":"Build provenance"},{"id":"spn-90209","text":" — deterministic builds with hash-linked artifacts"}]}],"id":"blk-60538","kind":"list-item"},{"blocks":[{"id":"blk-60541","kind":"paragraph","spans":[{"id":"spn-90210","marks":["bold"],"text":"Usage metrics"},{"id":"spn-90211","text":" — install count, active deployments, error rates"}]}],"id":"blk-60540","kind":"list-item"},{"blocks":[{"id":"blk-60543","kind":"paragraph","spans":[{"id":"spn-90212","marks":["bold"],"text":"Audit trail"},{"id":"spn-90213","text":" — linked SpecPrompt spec, Agentelic build history"}]}],"id":"blk-60542","kind":"list-item"},{"blocks":[{"id":"blk-60545","kind":"paragraph","spans":[{"id":"spn-90214","marks":["bold"],"text":"Community signals"},{"id":"spn-90215","text":" — forks, reviews, reports"}]}],"id":"blk-60544","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-60546","kind":"paragraph","spans":[{"id":"spn-90216","text":"Trust scores are recomputed asynchronously whenever new data arrives."}]},{"id":"blk-60547","kind":"heading","level":2,"spans":[{"id":"spn-90217","text":"Project Links"}]},{"id":"blk-60548","items":[{"blocks":[{"id":"blk-60550","kind":"paragraph","spans":[{"id":"spn-90218","marks":["bold"],"text":"Spec:"},{"id":"spn-90219","text":" "},{"id":"spn-90220","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-60549","kind":"list-item"},{"blocks":[{"id":"blk-60552","kind":"paragraph","spans":[{"id":"spn-90221","marks":["bold"],"text":"User stories:"},{"id":"spn-90222","text":" "},{"id":"spn-90223","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/ux/user-stories.md"}],"text":"FleetPrompt User Stories"}]}],"id":"blk-60551","kind":"list-item"},{"blocks":[{"id":"blk-60554","kind":"paragraph","spans":[{"id":"spn-90224","marks":["bold"],"text":"Build prompt:"},{"id":"spn-90225","text":" "},{"id":"spn-90226","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/prompts/BUILD.md"}],"text":"FleetPrompt Implementation Build Prompt"}]}],"id":"blk-60