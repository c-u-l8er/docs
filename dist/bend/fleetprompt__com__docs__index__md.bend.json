":"blk-60513","kind":"paragraph","spans":[{"id":"spn-90226","marks":["bold"],"text":"Trust by computation"},{"id":"spn-90227","text":" — Trust scores derived from tests, audits, and usage — never self-reported."}]}],"id":"blk-60512","kind":"list-item"},{"blocks":[{"id":"blk-60515","kind":"paragraph","spans":[{"id":"spn-90228","marks":["bold"],"text":"Permission transparency"},{"id":"spn-90229","text":" — All permissions declared upfront, reviewed on install."}]}],"id":"blk-60514","kind":"list-item"},{"blocks":[{"id":"blk-60517","kind":"paragraph","spans":[{"id":"spn-90230","marks":["bold"],"text":"Provenance chain"},{"id":"spn-90231","text":" — Every version links to its SpecPrompt spec, build pipeline, and audit trail."}]}],"id":"blk-60516","kind":"list-item"},{"blocks":[{"id":"blk-60519","kind":"paragraph","spans":[{"id":"spn-90232","marks":["bold"],"text":"One-click deploy"},{"id":"spn-90233","text":" — Install means deploy to OpenSentience. No manual wiring."}]}],"id":"blk-60518","kind":"list-item"},{"blocks":[{"id":"blk-60521","kind":"paragraph","spans":[{"id":"spn-90234","marks":["bold"],"text":"Open registry"},{"id":"spn-90235","text":" — Public agents are free to publish and install. The marketplace is the commons."}]}],"id":"blk-60520","kind":"list-item"},{"blocks":[{"id":"blk-60523","kind":"paragraph","spans":[{"id":"spn-90236","marks":["bold"],"text":"Fork-friendly"},{"id":"spn-90237","text":" — Any public agent can be forked, customized, and republished."}]}],"id":"blk-60522","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-60524","kind":"heading","level":2,"spans":[{"id":"spn-90238","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-60526","spans":[{"id":"spn-90239","text":"Component"}]},{"id":"blk-60527","spans":[{"id":"spn-90240","text":"Role"}]},{"id":"blk-60528","spans":[{"id":"spn-90241","text":"OTP Pattern"}]}],"id":"blk-60525","kind":"table","rows":[[{"id":"blk-60529","spans":[{"id":"spn-90242","marks":["bold"],"text":"Registry Core"}]},{"id":"blk-60530","spans":[{"id":"spn-90243","text":"Manifest storage, version control, search indexing, fork management"}]},{"id":"blk-60531","spans":[{"id":"spn-90244","text":"Ecto + ETS"}]}],[{"id":"blk-60532","spans":[{"id":"spn-90245","marks":["bold"],"text":"Trust Engine"}]},{"id":"blk-60533","spans":[{"id":"spn-90246","text":"Async recompute of trust scores on new data"}]},{"id":"blk-60534","spans":[{"id":"spn-90247","text":"GenServer per agent"}]}],[{"id":"blk-60535","spans":[{"id":"spn-90248","marks":["bold"],"text":"Install Engine"}]},{"id":"blk-60536","spans":[{"id":"spn-90249","text":"Manifest → OpenSentience deploy with permission review gate"}]},{"id":"blk-60537","spans":[{"id":"spn-90250","text":"Task pipeline"}]}],[{"id":"blk-60538","spans":[{"id":"spn-90251","marks":["bold"],"text":"Search"}]},{"id":"blk-60539","spans":[{"id":"spn-90252","text":"Full-text + capability + trust-score search"}]},{"id":"blk-60540","spans":[{"id":"spn-90253","text":"ETS + PostgreSQL"}]}],[{"id":"blk-60541","spans":[{"id":"spn-90254","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-60542","spans":[{"id":"spn-90255","text":"Agent search, detail, trust scores, publisher profiles"}]},{"id":"blk-60543","spans":[{"id":"spn-90256","text":"Phoenix LiveView"}]}]]},{"id":"blk-60544","kind":"heading","level":2,"spans":[{"id":"spn-90257","text":"The Trust Pipeline"}]},{"id":"blk-60545","kind":"paragraph","spans":[{"id":"spn-90258","text":"Every agent on FleetPrompt gets a computed trust score based on:"}]},{"id":"blk-60546","items":[{"blocks":[{"id":"blk-60548","kind":"paragraph","spans":[{"id":"spn-90259","marks":["bold"],"text":"Test coverage"},{"id":"spn-90260","text":" — percentage of acceptance criteria with passing tests"}]}],"id":"blk-60547","kind":"list-item"},{"blocks":[{"id":"blk-60550","kind":"paragraph","spans":[{"id":"spn-90261","marks":["bold"],"text":"Build provenance"},{"id":"spn-90262","text":" — deterministic builds with hash-linked artifacts"}]}],"id":"blk-60549","kind":"list-item"},{"blocks":[{"id":"blk-60552","kind":"paragraph","spans":[{"id":"spn-90263","marks":["bold"],"text":"Usage metrics"},{"id":"spn-90264","text":" — install count, active deployments, error rates"}]}],"id":"blk-60551","kind":"list-item"},{"blocks":[{"id":"blk-60554","kind":"paragraph","spans":[{"id":"spn-90265","marks":["bold"],"text":"Audit trail"},{"id":"spn-90266","text":" — linked SpecPrompt spec, Agentelic build history"}]}],"id":"blk-60553","kind":"list-item"},{"blocks":[{"id":"blk-60556","kind":"paragraph","spans":[{"id":"spn-90267","marks":["bold"],"text":"Community signals"},{"id":"spn-90268","text":" — forks, reviews, reports"}]}],"id":"blk-60555","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-60557","kind":"paragraph","spans":[{"id":"spn-90269","text":"Trust scores are recomputed asynchronously whenever new data arrives."}]},{"id":"blk-60558","kind":"heading","level":2,"spans":[{"id":"spn-90270","text":"Project Links"}]},{"id":"blk-60559","items":[{"blocks":[{"id":"blk-60561","kind":"paragraph","spans":[{"id":"spn-90271","marks":["bold"],"text":"Spec:"},{"id":"spn-90272","text":" "},{"id":"spn-90273","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-60560","kind":"list-item"},{"blocks":[{"id":"blk-60563","kind":"paragraph","spans":[{"id":"spn-90274","marks":["bold"],"text":"User stories:"},{"id":"spn-90275","text":" "},{"id":"spn-90276","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/docs/ux/user-stories.md"}],"text":"FleetPrompt User Stories"}]}],"id":"blk-60562","kind":"list-item"},{"blocks":[{"id":"blk-60565","kind":"paragraph","spans":[{"id":"spn-90277","marks":["bold"],"text":"Build prompt:"},{"id":"spn-90278","text":" "},{"id":"spn-90279","marks":[{"kind":"link","predicate":"cites","target":"#/fleetprompt.com/prompts/BUILD.md"}],"text":"FleetPrompt Implementation Build Prompt"}]}],"id":"blk-60