,"id":"blk-68053","kind":"list-item"},{"blocks":[{"id":"blk-68056","kind":"paragraph","spans":[{"id":"spn-129467","marks":["bold"],"text":"Trust by computation"},{"id":"spn-129468","text":" — Trust scores derived from tests, audits, and usage — never self-reported."}]}],"id":"blk-68055","kind":"list-item"},{"blocks":[{"id":"blk-68058","kind":"paragraph","spans":[{"id":"spn-129469","marks":["bold"],"text":"Permission transparency"},{"id":"spn-129470","text":" — All permissions declared upfront, reviewed on install."}]}],"id":"blk-68057","kind":"list-item"},{"blocks":[{"id":"blk-68060","kind":"paragraph","spans":[{"id":"spn-129471","marks":["bold"],"text":"Provenance chain"},{"id":"spn-129472","text":" — Every version links to its SpecPrompt spec, build pipeline, and audit trail."}]}],"id":"blk-68059","kind":"list-item"},{"blocks":[{"id":"blk-68062","kind":"paragraph","spans":[{"id":"spn-129473","marks":["bold"],"text":"One-click deploy"},{"id":"spn-129474","text":" — Install means deploy to OpenSentience. No manual wiring."}]}],"id":"blk-68061","kind":"list-item"},{"blocks":[{"id":"blk-68064","kind":"paragraph","spans":[{"id":"spn-129475","marks":["bold"],"text":"Open registry"},{"id":"spn-129476","text":" — Public agents are free to publish and install. The marketplace is the commons."}]}],"id":"blk-68063","kind":"list-item"},{"blocks":[{"id":"blk-68066","kind":"paragraph","spans":[{"id":"spn-129477","marks":["bold"],"text":"Fork-friendly"},{"id":"spn-129478","text":" — Any public agent can be forked, customized, and republished."}]}],"id":"blk-68065","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68067","kind":"heading","level":2,"spans":[{"id":"spn-129479","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-68069","spans":[{"id":"spn-129480","text":"Component"}]},{"id":"blk-68070","spans":[{"id":"spn-129481","text":"Role"}]},{"id":"blk-68071","spans":[{"id":"spn-129482","text":"OTP Pattern"}]}],"id":"blk-68068","kind":"table","rows":[[{"id":"bl