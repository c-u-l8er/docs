{"bendscript":"0.1","blocks":[{"id":"blk-57638","kind":"heading","level":1,"spans":[{"id":"spn-86160","text":"BendScript Protocol"}]},{"id":"blk-57639","kind":"paragraph","spans":[{"id":"spn-86161","text":"A graph-first document format with typed inline link facets, for agent-native systems."}]},{"id":"blk-57640","kind":"paragraph","spans":[{"id":"spn-86162","marks":["bold"],"text":"Status:"},{"id":"spn-86163","text":" v0.1 draft (sections 0–6). Pre-implementation."}]},{"id":"blk-57641","kind":"heading","level":2,"spans":[{"id":"spn-86164","text":"Direction"}]},{"id":"blk-57642","kind":"paragraph","spans":[{"id":"spn-86165","text":"bendscript.com is being rebuilt as a "},{"id":"spn-86166","marks":["bold"],"text":"protocol spec + reference framework"},{"id":"spn-86167","text":", not a canvas/KAG SaaS. The previous direction (SvelteKit canvas editor + KAG server on Supabase) is archived under "},{"id":"spn-86168","marks":["code"],"text":"old_scrap/v1/"},{"id":"spn-86169","text":" and is not being extended."}]},{"id":"blk-57643","kind":"paragraph","spans":[{"id":"spn-86170","text":"The new product is:"}]},{"id":"blk-57644","items":[{"blocks":[{"id":"blk-57646","kind":"paragraph","spans":[{"id":"spn-86171","text":"A JSON document format ("},{"id":"spn-86172","marks":["code"],"text":"bend:"},{"id":"spn-86173","text":" URI scheme, content-addressable ids, span-addressable graph edges)"}]}],"id":"blk-57645","kind":"list-item"},{"blocks":[{"id":"blk-57648","kind":"paragraph","spans":[{"id":"spn-86174","text":"A reference parser/validator/edge-extractor ("},{"id":"spn-86175","marks":["code"],"text":"@bendscript/core"},{"id":"spn-86176","text":", not yet written)"}]}],"id":"blk-57647","kind":"list-item"},{"blocks":[{"id":"blk-57650","kind":"paragraph","spans":[{"id":"spn-86177","text":"An LLM round-trip test harness (the load-bearing claim of v0.1)"}]}],"id":"blk-57649","kind":"list-item"},{"blocks":[{"id":"blk-57652","kind":"paragraph","spans":[{"id":"spn-86178","text":"Five reserved vocabularies that integrate with the rest of the [&] portfolio"}]}],"id":"blk-57651","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57653","kind":"heading","level":2,"spans":[{"id":"spn-86179","text":"Source-of-truth spec"}]},{"id":"blk-57654","items":[{"blocks":[{"id":"blk-57656","kind":"paragraph","spans":[{"id":"spn-86180","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-86181","text":" — BendScript Protocol v0.1 draft (sections 0–6)"}]}],"id":"blk-57655","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57657","kind":"heading","level":2,"spans":[{"id":"spn-86182","text":"What's archived"}]},{"id":"blk-57658","kind":"paragraph","spans":[{"id":"spn-86183","marks":["code"],"text":"old_scrap/v1/"},{"id":"spn-86184","text":" contains the entire previous product — SvelteKit app, Supabase migrations integration, AGENTS.md, prompts, the v1.0 canvas-and-KAG spec ("},{"id":"spn-86185","marks":["code"],"text":"old_scrap/v1/docs/spec/README.md"},{"id":"spn-86186","text":"), and all build configs. It is historical; do not extend it."}]},{"id":"blk-57659","kind":"heading","level":2,"spans":[{"id":"spn-86187","text":"Build"}]},{"id":"blk-57660","kind":"code","language":"text","text":"npm install\nnpm test            # run all unit tests (vitest)\nnpm run typecheck   # tsc --noEmit"},{"id":"blk-57661","kind":"paragraph","spans":[{"id":"spn-86188","text":"Reference framework: "},{"id":"spn-86189","marks":["code"],"text":"@bendscript/core"},{"id":"spn-86190","text":" (TypeScript, Node 20+)."}]},{"id":"blk-57662","items":[{"blocks":[{"id":"blk-57664","kind":"paragraph","spans":[{"id":"spn-86191","marks":["code"],"text":"src/types.ts"},{"id":"spn-86192","text":" — Document, Block, Span, Edge, Mark types"}]}],"id":"blk-57663","kind":"list-item"},{"blocks":[{"id":"blk-57666","kind":"paragraph","spans":[{"id":"spn-86193","marks":["code"],"text":"src/parse.ts"},{"id":"spn-86194","text":" — "},{"id":"spn-86195","marks":["code"],"text":"parse(text) → Document"},{"id":"spn-86196","text":", "},{"id":"spn-86197","marks":["code"],"text":"normalize(doc)"},{"id":"spn-86198","text":" (link-mark expansion), "},{"id":"spn-86199","marks":["code"],"text":"parseAndNormalize"}]}],"id":"blk-57665","kind":"list-item"},{"blocks":[{"id":"blk-57668","kind":"paragraph","spans":[{"id":"spn-86200","marks":["code"],"text":"src/validate.ts"},{"id":"spn-86201","text":" — structural validator per §2/§3 (throws "},{"id":"spn-86202","marks":["code"],"text":"ValidationError"},{"id":"spn-86203","text":" with JSON path)"}]}],"id":"blk-57667","kind":"list-item"},{"blocks":[{"id":"blk-57670","kind":"paragraph","spans":[{"id":"spn-86204","marks":["code"],"text":"src/canonicalize.ts"},{"id":"spn-86205","text":" — RFC 8785 (JCS) wrapper for canonical serialization"}]}],"id":"blk-57669","kind":"list-item"},{"blocks":[{"id":"blk-57672","kind":"paragraph","spans":[{"id":"spn-86206","marks":["code"],"text":"src/hash.ts"},{"id":"spn-86207","text":" — content-addressable document id ("},{"id":"spn-86208","marks":["code"],"text":"computeDocumentId"},{"id":"spn-86209","text":") using sha2-256 + json multicodec → CIDv1 multibase string"}]}],"id":"blk-57671","kind":"list-item"},{"blocks":[{"id":"blk-57674","kind":"paragraph","spans":[{"id":"spn-86210","marks":["code"],"text":"src/expand-marks.ts"},{"id":"spn-86211","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-57673","kind":"list-item"},{"blocks":[{"id":"blk-57676","kind":"paragraph","spans":[{"id":"spn-86212","marks":["code"],"text":"src/serialize.ts"},{"id":"spn-86213","text":" — pretty-print and canonical serializers"}]}],"id":"blk-57675","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57677","kind":"paragraph","spans":[{"id":"spn-86214","marks":["code"],"text":"test/round-trip.test.ts"},{"id":"spn-86215","text":" exercises the §8.1.1 strict round-trip claim against "},{"id":"spn-86216","marks":["code"],"text":"test-corpus/v0.1/*.bend.json"},{"id":"spn-86217","text":"."}]},{"id":"blk-57678","kind":"heading","level":2,"spans":[{"id":"spn-86218","text":"Verification status"}]},{"id":"blk-57679","kind":"paragraph","spans":[{"id":"spn-86219","marks":["bold"],"text":"§8.1.1 parser round-trip — verified."},{"id":"spn-86220","text":" 96 tests passing as of 2026-04-27 against the full 20-document corpus:"}]},{"id":"blk-57680","items":[{"blocks":[{"id":"blk-57682","kind":"paragraph","spans":[{"id":"spn-86221","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-86222","text":" holds for all 20 corpus documents (Unicode, ZWJ emoji, deeply nested lists, all five reserved vocabularies, supersedes/tombstones, untyped links)"}]}],"id":"blk-57681","kind":"list-item"},{"blocks":[{"id":"blk-57684","kind":"paragraph","spans":[{"id":"spn-86223","text":"Document id is stable across parse/serialize cycles"}]}],"id":"blk-57683","kind":"list-item"},{"blocks":[{"id":"blk-57686","kind":"paragraph","spans":[{"id":"spn-86224","text":"Editing span text changes the id; editing "},{"id":"spn-86225","marks":["code"],"text":"meta"},{"id":"spn-86226","text":" does NOT (§5.1 trade-off works as designed)"}]}],"id":"blk-57685","kind":"list-item"},{"blocks":[{"id":"blk-57688","kind":"paragraph","spans":[{"id":"spn-86227","text":"RFC 8785 canonicalization is field-order independent"}]}],"id":"blk-57687","kind":"list-item"},{"blocks":[{"id":"blk-57690","kind":"paragraph","spans":[{"id":"spn-86228","text":"Link-mark expansion is deterministic and idempotent"}]}],"id":"blk-57689","kind":"list-item"},{"blocks":[{"id":"blk-57692","kind":"paragraph","spans":[{"id":"spn-86229","text":"Untyped link marks (no "},{"id":"spn-86230","marks":["code"],"text":"predicate"},{"id":"spn-86231","text":") do NOT emit edges (per §2.5.1)"}]}],"id":"blk-57691","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57693","kind":"paragraph","spans":[{"id":"spn-86232","marks":["bold"],"text":"§8 harness mechanics — verified with mock LLMs."},{"id":"spn-86233","text":" No paid API calls yet:"}]},{"id":"blk-57694","items":[{"blocks":[{"id":"blk-57696","kind":"paragraph","spans":[{"id":"spn-86234","text":"Drift metric implemented (5 components per §8.4: block_structure, edge_preservation, span_coverage, mark_fidelity, vocabulary_integrity), zero-drift on identical docs"}]}],"id":"blk-57695","kind":"list-item"},{"blocks":[{"id":"blk-57698","kind":"paragraph","spans":[{"id":"spn-86235","text":"Identity / small-edit / lossy / garbage mock models exercise each failure mode"}]}],"id":"blk-57697","kind":"list-item"},{"blocks":[{"id":"blk-57700","kind":"paragraph","spans":[{"id":"spn-86236","text":"Median + P95 aggregation per §8.5"}]}],"id":"blk-57699","kind":"list-item"},{"blocks":[{"id":"blk-57702","kind":"paragraph","spans":[{"id":"spn-86237","text":"Threshold checking emits "},{"id":"spn-86238","marks":["code"],"text":"pass"},{"id":"spn-86239","text":" / "},{"id":"spn-86240","marks":["code"],"text":"fail"},{"id":"spn-86241","text":" verdict with failing thresholds enumerated"}]}],"id":"blk-57701","kind":"list-item"},{"blocks":[{"id":"blk-57704","kind":"paragraph","spans":[{"id":"spn-86242","marks":["code"],"text":"MockModel"},{"id":"spn-86243","text":" with "},{"id":"spn-86244","marks":["code"],"text":"lossy"},{"id":"spn-86245","text":" mode confirmed: harness correctly enforces spec invariant that link-mark edges always re-expand on parse, so dropping the "},{"id":"spn-86246","marks":["code"],"text":"edges"},{"id":"spn-86247","text":" array doesn't lose link-mark-derived edges"}]}],"id":"blk-57703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57705","kind":"paragraph","spans":[{"id":"spn-86248","marks":["bold"],"text":"§8.1.2 LLM round-trip — not yet run against real models."},{"id":"spn-86249","text":" Implementing a "},{"id":"spn-86250","marks":["code"],"text":"ModelClient"},{"id":"spn-86251","text":" against OpenRouter is the next step. Estimated cost: $5–20 per gating run (180 calls = 20 docs × 3 classes × 3 models)."}]},{"id":"blk-57706","kind":"paragraph","spans":[{"id":"spn-86252","marks":["bold"],"text":"§14.3.1 Graphonomous adoption — not yet implemented."},{"id":"spn-86253","text":" This is the other gating commitment for v0.1 final."}]},{"id":"blk-57707","kind":"heading","level":2,"spans":[{"id":"spn-86254","text":"Conventions"}]},{"id":"blk-57708","items":[{"blocks":[{"id":"blk-57710","kind":"paragraph","spans":[{"id":"spn-86255","text":"Spec uses RFC discipline (MUST / SHOULD / MAY)"}]}],"id":"blk-57709","kind":"list-item"},{"blocks":[{"id":"blk-57712","kind":"paragraph","spans":[{"id":"spn-86256","text":"Canonical document form is JSON; text projection deferred to v0.2"}]}],"id":"blk-57711","kind":"list-item"},{"blocks":[{"id":"blk-57714","kind":"paragraph","spans":[{"id":"spn-86257","marks":["code"],"text":".bend"},{"id":"spn-86258","text":" files are not hand-authored — produced by editors that emit JSON"}]}],"id":"blk-57713","kind":"list-item"},{"blocks":[{"id":"blk-57716","kind":"paragraph","spans":[{"id":"spn-86259","text":"No host coupling: the protocol must work in TypeScript, Elixir, Rust, plain HTML"}]}],"id":"blk-57715","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieratofsf6jszqidevgcvr5udj53r55l4bk3yqe5i6d7avdfrxhrsdaa","vocabulary":"ampersand.docs.fs.v1"}