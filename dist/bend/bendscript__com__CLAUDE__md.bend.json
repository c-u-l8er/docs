{"bendscript":"0.1","blocks":[{"id":"blk-56742","kind":"heading","level":1,"spans":[{"id":"spn-83528","text":"BendScript Protocol"}]},{"id":"blk-56743","kind":"paragraph","spans":[{"id":"spn-83529","text":"A graph-first document format with typed inline link facets, for agent-native systems."}]},{"id":"blk-56744","kind":"paragraph","spans":[{"id":"spn-83530","marks":["bold"],"text":"Status:"},{"id":"spn-83531","text":" v0.1 draft (sections 0–6). Pre-implementation."}]},{"id":"blk-56745","kind":"heading","level":2,"spans":[{"id":"spn-83532","text":"Direction"}]},{"id":"blk-56746","kind":"paragraph","spans":[{"id":"spn-83533","text":"bendscript.com is being rebuilt as a "},{"id":"spn-83534","marks":["bold"],"text":"protocol spec + reference framework"},{"id":"spn-83535","text":", not a canvas/KAG SaaS. The previous direction (SvelteKit canvas editor + KAG server on Supabase) is archived under "},{"id":"spn-83536","marks":["code"],"text":"old_scrap/v1/"},{"id":"spn-83537","text":" and is not being extended."}]},{"id":"blk-56747","kind":"paragraph","spans":[{"id":"spn-83538","text":"The new product is:"}]},{"id":"blk-56748","items":[{"blocks":[{"id":"blk-56750","kind":"paragraph","spans":[{"id":"spn-83539","text":"A JSON document format ("},{"id":"spn-83540","marks":["code"],"text":"bend:"},{"id":"spn-83541","text":" URI scheme, content-addressable ids, span-addressable graph edges)"}]}],"id":"blk-56749","kind":"list-item"},{"blocks":[{"id":"blk-56752","kind":"paragraph","spans":[{"id":"spn-83542","text":"A reference parser/validator/edge-extractor ("},{"id":"spn-83543","marks":["code"],"text":"@bendscript/core"},{"id":"spn-83544","text":", not yet written)"}]}],"id":"blk-56751","kind":"list-item"},{"blocks":[{"id":"blk-56754","kind":"paragraph","spans":[{"id":"spn-83545","text":"An LLM round-trip test harness (the load-bearing claim of v0.1)"}]}],"id":"blk-56753","kind":"list-item"},{"blocks":[{"id":"blk-56756","kind":"paragraph","spans":[{"id":"spn-83546","text":"Five reserved vocabularies that integrate with the rest of the [&] portfolio"}]}],"id":"blk-56755","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56757","kind":"heading","level":2,"spans":[{"id":"spn-83547","text":"Source-of-truth spec"}]},{"id":"blk-56758","items":[{"blocks":[{"id":"blk-56760","kind":"paragraph","spans":[{"id":"spn-83548","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-83549","text":" — BendScript Protocol v0.1 draft (sections 0–6)"}]}],"id":"blk-56759","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56761","kind":"heading","level":2,"spans":[{"id":"spn-83550","text":"What's archived"}]},{"id":"blk-56762","kind":"paragraph","spans":[{"id":"spn-83551","marks":["code"],"text":"old_scrap/v1/"},{"id":"spn-83552","text":" contains the entire previous product — SvelteKit app, Supabase migrations integration, AGENTS.md, prompts, the v1.0 canvas-and-KAG spec ("},{"id":"spn-83553","marks":["code"],"text":"old_scrap/v1/docs/spec/README.md"},{"id":"spn-83554","text":"), and all build configs. It is historical; do not extend it."}]},{"id":"blk-56763","kind":"heading","level":2,"spans":[{"id":"spn-83555","text":"Build"}]},{"id":"blk-56764","kind":"code","language":"text","text":"npm install\nnpm test            # run all unit tests (vitest)\nnpm run typecheck   # tsc --noEmit"},{"id":"blk-56765","kind":"paragraph","spans":[{"id":"spn-83556","text":"Reference framework: "},{"id":"spn-83557","marks":["code"],"text":"@bendscript/core"},{"id":"spn-83558","text":" (TypeScript, Node 20+)."}]},{"id":"blk-56766","items":[{"blocks":[{"id":"blk-56768","kind":"paragraph","spans":[{"id":"spn-83559","marks":["code"],"text":"src/types.ts"},{"id":"spn-83560","text":" — Document, Block, Span, Edge, Mark types"}]}],"id":"blk-56767","kind":"list-item"},{"blocks":[{"id":"blk-56770","kind":"paragraph","spans":[{"id":"spn-83561","marks":["code"],"text":"src/parse.ts"},{"id":"spn-83562","text":" — "},{"id":"spn-83563","marks":["code"],"text":"parse(text) → Document"},{"id":"spn-83564","text":", "},{"id":"spn-83565","marks":["code"],"text":"normalize(doc)"},{"id":"spn-83566","text":" (link-mark expansion), "},{"id":"spn-83567","marks":["code"],"text":"parseAndNormalize"}]}],"id":"blk-56769","kind":"list-item"},{"blocks":[{"id":"blk-56772","kind":"paragraph","spans":[{"id":"spn-83568","marks":["code"],"text":"src/validate.ts"},{"id":"spn-83569","text":" — structural validator per §2/§3 (throws "},{"id":"spn-83570","marks":["code"],"text":"ValidationError"},{"id":"spn-83571","text":" with JSON path)"}]}],"id":"blk-56771","kind":"list-item"},{"blocks":[{"id":"blk-56774","kind":"paragraph","spans":[{"id":"spn-83572","marks":["code"],"text":"src/canonicalize.ts"},{"id":"spn-83573","text":" — RFC 8785 (JCS) wrapper for canonical serialization"}]}],"id":"blk-56773","kind":"list-item"},{"blocks":[{"id":"blk-56776","kind":"paragraph","spans":[{"id":"spn-83574","marks":["code"],"text":"src/hash.ts"},{"id":"spn-83575","text":" — content-addressable document id ("},{"id":"spn-83576","marks":["code"],"text":"computeDocumentId"},{"id":"spn-83577","text":") using sha2-256 + json multicodec → CIDv1 multibase string"}]}],"id":"blk-56775","kind":"list-item"},{"blocks":[{"id":"blk-56778","kind":"paragraph","spans":[{"id":"spn-83578","marks":["code"],"text":"src/expand-marks.ts"},{"id":"spn-83579","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-56777","kind":"list-item"},{"blocks":[{"id":"blk-56780","kind":"paragraph","spans":[{"id":"spn-83580","marks":["code"],"text":"src/serialize.ts"},{"id":"spn-83581","text":" — pretty-print and canonical serializers"}]}],"id":"blk-56779","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56781","kind":"paragraph","spans":[{"id":"spn-83582","marks":["code"],"text":"test/round-trip.test.ts"},{"id":"spn-83583","text":" exercises the §8.1.1 strict round-trip claim against "},{"id":"spn-83584","marks":["code"],"text":"test-corpus/v0.1/*.bend.json"},{"id":"spn-83585","text":"."}]},{"id":"blk-56782","kind":"heading","level":2,"spans":[{"id":"spn-83586","text":"Verification status"}]},{"id":"blk-56783","kind":"paragraph","spans":[{"id":"spn-83587","marks":["bold"],"text":"§8.1.1 parser round-trip — verified."},{"id":"spn-83588","text":" 96 tests passing as of 2026-04-27 against the full 20-document corpus:"}]},{"id":"blk-56784","items":[{"blocks":[{"id":"blk-56786","kind":"paragraph","spans":[{"id":"spn-83589","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-83590","text":" holds for all 20 corpus documents (Unicode, ZWJ emoji, deeply nested lists, all five reserved vocabularies, supersedes/tombstones, untyped links)"}]}],"id":"blk-56785","kind":"list-item"},{"blocks":[{"id":"blk-56788","kind":"paragraph","spans":[{"id":"spn-83591","text":"Document id is stable across parse/serialize cycles"}]}],"id":"blk-56787","kind":"list-item"},{"blocks":[{"id":"blk-56790","kind":"paragraph","spans":[{"id":"spn-83592","text":"Editing span text changes the id; editing "},{"id":"spn-83593","marks":["code"],"text":"meta"},{"id":"spn-83594","text":" does NOT (§5.1 trade-off works as designed)"}]}],"id":"blk-56789","kind":"list-item"},{"blocks":[{"id":"blk-56792","kind":"paragraph","spans":[{"id":"spn-83595","text":"RFC 8785 canonicalization is field-order independent"}]}],"id":"blk-56791","kind":"list-item"},{"blocks":[{"id":"blk-56794","kind":"paragraph","spans":[{"id":"spn-83596","text":"Link-mark expansion is deterministic and idempotent"}]}],"id":"blk-56793","kind":"list-item"},{"blocks":[{"id":"blk-56796","kind":"paragraph","spans":[{"id":"spn-83597","text":"Untyped link marks (no "},{"id":"spn-83598","marks":["code"],"text":"predicate"},{"id":"spn-83599","text":") do NOT emit edges (per §2.5.1)"}]}],"id":"blk-56795","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56797","kind":"paragraph","spans":[{"id":"spn-83600","marks":["bold"],"text":"§8 harness mechanics — verified with mock LLMs."},{"id":"spn-83601","text":" No paid API calls yet:"}]},{"id":"blk-56798","items":[{"blocks":[{"id":"blk-56800","kind":"paragraph","spans":[{"id":"spn-83602","text":"Drift metric implemented (5 components per §8.4: block_structure, edge_preservation, span_coverage, mark_fidelity, vocabulary_integrity), zero-drift on identical docs"}]}],"id":"blk-56799","kind":"list-item"},{"blocks":[{"id":"blk-56802","kind":"paragraph","spans":[{"id":"spn-83603","text":"Identity / small-edit / lossy / garbage mock models exercise each failure mode"}]}],"id":"blk-56801","kind":"list-item"},{"blocks":[{"id":"blk-56804","kind":"paragraph","spans":[{"id":"spn-83604","text":"Median + P95 aggregation per §8.5"}]}],"id":"blk-56803","kind":"list-item"},{"blocks":[{"id":"blk-56806","kind":"paragraph","spans":[{"id":"spn-83605","text":"Threshold checking emits "},{"id":"spn-83606","marks":["code"],"text":"pass"},{"id":"spn-83607","text":" / "},{"id":"spn-83608","marks":["code"],"text":"fail"},{"id":"spn-83609","text":" verdict with failing thresholds enumerated"}]}],"id":"blk-56805","kind":"list-item"},{"blocks":[{"id":"blk-56808","kind":"paragraph","spans":[{"id":"spn-83610","marks":["code"],"text":"MockModel"},{"id":"spn-83611","text":" with "},{"id":"spn-83612","marks":["code"],"text":"lossy"},{"id":"spn-83613","text":" mode confirmed: harness correctly enforces spec invariant that link-mark edges always re-expand on parse, so dropping the "},{"id":"spn-83614","marks":["code"],"text":"edges"},{"id":"spn-83615","text":" array doesn't lose link-mark-derived edges"}]}],"id":"blk-56807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56809","kind":"paragraph","spans":[{"id":"spn-83616","marks":["bold"],"text":"§8.1.2 LLM round-trip — not yet run against real models."},{"id":"spn-83617","text":" Implementing a "},{"id":"spn-83618","marks":["code"],"text":"ModelClient"},{"id":"spn-83619","text":" against OpenRouter is the next step. Estimated cost: $5–20 per gating run (180 calls = 20 docs × 3 classes × 3 models)."}]},{"id":"blk-56810","kind":"paragraph","spans":[{"id":"spn-83620","marks":["bold"],"text":"§14.3.1 Graphonomous adoption — not yet implemented."},{"id":"spn-83621","text":" This is the other gating commitment for v0.1 final."}]},{"id":"blk-56811","kind":"heading","level":2,"spans":[{"id":"spn-83622","text":"Conventions"}]},{"id":"blk-56812","items":[{"blocks":[{"id":"blk-56814","kind":"paragraph","spans":[{"id":"spn-83623","text":"Spec uses RFC discipline (MUST / SHOULD / MAY)"}]}],"id":"blk-56813","kind":"list-item"},{"blocks":[{"id":"blk-56816","kind":"paragraph","spans":[{"id":"spn-83624","text":"Canonical document form is JSON; text projection deferred to v0.2"}]}],"id":"blk-56815","kind":"list-item"},{"blocks":[{"id":"blk-56818","kind":"paragraph","spans":[{"id":"spn-83625","marks":["code"],"text":".bend"},{"id":"spn-83626","text":" files are not hand-authored — produced by editors that emit JSON"}]}],"id":"blk-56817","kind":"list-item"},{"blocks":[{"id":"blk-56820","kind":"paragraph","spans":[{"id":"spn-83627","text":"No host coupling: the protocol must work in TypeScript, Elixir, Rust, plain HTML"}]}],"id":"blk-56819","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieragafpzogjvho55uwy7dd3vblxinutorqtax6fivetriyjcyl63kua","vocabulary":"ampersand.docs.fs.v1"}