{"bendscript":"0.1","blocks":[{"id":"blk-56868","kind":"heading","level":1,"spans":[{"id":"spn-83676","text":"BendScript Protocol"}]},{"id":"blk-56869","kind":"paragraph","spans":[{"id":"spn-83677","text":"A graph-first document format with typed inline link facets, for agent-native systems."}]},{"id":"blk-56870","kind":"paragraph","spans":[{"id":"spn-83678","marks":["bold"],"text":"Status:"},{"id":"spn-83679","text":" v0.1 draft (sections 0–6). Pre-implementation."}]},{"id":"blk-56871","kind":"heading","level":2,"spans":[{"id":"spn-83680","text":"Direction"}]},{"id":"blk-56872","kind":"paragraph","spans":[{"id":"spn-83681","text":"bendscript.com is being rebuilt as a "},{"id":"spn-83682","marks":["bold"],"text":"protocol spec + reference framework"},{"id":"spn-83683","text":", not a canvas/KAG SaaS. The previous direction (SvelteKit canvas editor + KAG server on Supabase) is archived under "},{"id":"spn-83684","marks":["code"],"text":"old_scrap/v1/"},{"id":"spn-83685","text":" and is not being extended."}]},{"id":"blk-56873","kind":"paragraph","spans":[{"id":"spn-83686","text":"The new product is:"}]},{"id":"blk-56874","items":[{"blocks":[{"id":"blk-56876","kind":"paragraph","spans":[{"id":"spn-83687","text":"A JSON document format ("},{"id":"spn-83688","marks":["code"],"text":"bend:"},{"id":"spn-83689","text":" URI scheme, content-addressable ids, span-addressable graph edges)"}]}],"id":"blk-56875","kind":"list-item"},{"blocks":[{"id":"blk-56878","kind":"paragraph","spans":[{"id":"spn-83690","text":"A reference parser/validator/edge-extractor ("},{"id":"spn-83691","marks":["code"],"text":"@bendscript/core"},{"id":"spn-83692","text":", not yet written)"}]}],"id":"blk-56877","kind":"list-item"},{"blocks":[{"id":"blk-56880","kind":"paragraph","spans":[{"id":"spn-83693","text":"An LLM round-trip test harness (the load-bearing claim of v0.1)"}]}],"id":"blk-56879","kind":"list-item"},{"blocks":[{"id":"blk-56882","kind":"paragraph","spans":[{"id":"spn-83694","text":"Five reserved vocabularies that integrate with the rest of the [&] portfolio"}]}],"id":"blk-56881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56883","kind":"heading","level":2,"spans":[{"id":"spn-83695","text":"Source-of-truth spec"}]},{"id":"blk-56884","items":[{"blocks":[{"id":"blk-56886","kind":"paragraph","spans":[{"id":"spn-83696","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-83697","text":" — BendScript Protocol v0.1 draft (sections 0–6)"}]}],"id":"blk-56885","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56887","kind":"heading","level":2,"spans":[{"id":"spn-83698","text":"What's archived"}]},{"id":"blk-56888","kind":"paragraph","spans":[{"id":"spn-83699","marks":["code"],"text":"old_scrap/v1/"},{"id":"spn-83700","text":" contains the entire previous product — SvelteKit app, Supabase migrations integration, AGENTS.md, prompts, the v1.0 canvas-and-KAG spec ("},{"id":"spn-83701","marks":["code"],"text":"old_scrap/v1/docs/spec/README.md"},{"id":"spn-83702","text":"), and all build configs. It is historical; do not extend it."}]},{"id":"blk-56889","kind":"heading","level":2,"spans":[{"id":"spn-83703","text":"Build"}]},{"id":"blk-56890","kind":"code","language":"text","text":"npm install\nnpm test            # run all unit tests (vitest)\nnpm run typecheck   # tsc --noEmit"},{"id":"blk-56891","kind":"paragraph","spans":[{"id":"spn-83704","text":"Reference framework: "},{"id":"spn-83705","marks":["code"],"text":"@bendscript/core"},{"id":"spn-83706","text":" (TypeScript, Node 20+)."}]},{"id":"blk-56892","items":[{"blocks":[{"id":"blk-56894","kind":"paragraph","spans":[{"id":"spn-83707","marks":["code"],"text":"src/types.ts"},{"id":"spn-83708","text":" — Document, Block, Span, Edge, Mark types"}]}],"id":"blk-56893","kind":"list-item"},{"blocks":[{"id":"blk-56896","kind":"paragraph","spans":[{"id":"spn-83709","marks":["code"],"text":"src/parse.ts"},{"id":"spn-83710","text":" — "},{"id":"spn-83711","marks":["code"],"text":"parse(text) → Document"},{"id":"spn-83712","text":", "},{"id":"spn-83713","marks":["code"],"text":"normalize(doc)"},{"id":"spn-83714","text":" (link-mark expansion), "},{"id":"spn-83715","marks":["code"],"text":"parseAndNormalize"}]}],"id":"blk-56895","kind":"list-item"},{"blocks":[{"id":"blk-56898","kind":"paragraph","spans":[{"id":"spn-83716","marks":["code"],"text":"src/validate.ts"},{"id":"spn-83717","text":" — structural validator per §2/§3 (throws "},{"id":"spn-83718","marks":["code"],"text":"ValidationError"},{"id":"spn-83719","text":" with JSON path)"}]}],"id":"blk-56897","kind":"list-item"},{"blocks":[{"id":"blk-56900","kind":"paragraph","spans":[{"id":"spn-83720","marks":["code"],"text":"src/canonicalize.ts"},{"id":"spn-83721","text":" — RFC 8785 (JCS) wrapper for canonical serialization"}]}],"id":"blk-56899","kind":"list-item"},{"blocks":[{"id":"blk-56902","kind":"paragraph","spans":[{"id":"spn-83722","marks":["code"],"text":"src/hash.ts"},{"id":"spn-83723","text":" — content-addressable document id ("},{"id":"spn-83724","marks":["code"],"text":"computeDocumentId"},{"id":"spn-83725","text":") using sha2-256 + json multicodec → CIDv1 multibase string"}]}],"id":"blk-56901","kind":"list-item"},{"blocks":[{"id":"blk-56904","kind":"paragraph","spans":[{"id":"spn-83726","marks":["code"],"text":"src/expand-marks.ts"},{"id":"spn-83727","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-56903","kind":"list-item"},{"blocks":[{"id":"blk-56906","kind":"paragraph","spans":[{"id":"spn-83728","marks":["code"],"text":"src/serialize.ts"},{"id":"spn-83729","text":" — pretty-print and canonical serializers"}]}],"id":"blk-56905","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56907","kind":"paragraph","spans":[{"id":"spn-83730","marks":["code"],"text":"test/round-trip.test.ts"},{"id":"spn-83731","text":" exercises the §8.1.1 strict round-trip claim against "},{"id":"spn-83732","marks":["code"],"text":"test-corpus/v0.1/*.bend.json"},{"id":"spn-83733","text":"."}]},{"id":"blk-56908","kind":"heading","level":2,"spans":[{"id":"spn-83734","text":"Verification status"}]},{"id":"blk-56909","kind":"paragraph","spans":[{"id":"spn-83735","marks":["bold"],"text":"§8.1.1 parser round-trip — verified."},{"id":"spn-83736","text":" 96 tests passing as of 2026-04-27 against the full 20-document corpus:"}]},{"id":"blk-56910","items":[{"blocks":[{"id":"blk-56912","kind":"paragraph","spans":[{"id":"spn-83737","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-83738","text":" holds for all 20 corpus documents (Unicode, ZWJ emoji, deeply nested lists, all five reserved vocabularies, supersedes/tombstones, untyped links)"}]}],"id":"blk-56911","kind":"list-item"},{"blocks":[{"id":"blk-56914","kind":"paragraph","spans":[{"id":"spn-83739","text":"Document id is stable across parse/serialize cycles"}]}],"id":"blk-56913","kind":"list-item"},{"blocks":[{"id":"blk-56916","kind":"paragraph","spans":[{"id":"spn-83740","text":"Editing span text changes the id; editing "},{"id":"spn-83741","marks":["code"],"text":"meta"},{"id":"spn-83742","text":" does NOT (§5.1 trade-off works as designed)"}]}],"id":"blk-56915","kind":"list-item"},{"blocks":[{"id":"blk-56918","kind":"paragraph","spans":[{"id":"spn-83743","text":"RFC 8785 canonicalization is field-order independent"}]}],"id":"blk-56917","kind":"list-item"},{"blocks":[{"id":"blk-56920","kind":"paragraph","spans":[{"id":"spn-83744","text":"Link-mark expansion is deterministic and idempotent"}]}],"id":"blk-56919","kind":"list-item"},{"blocks":[{"id":"blk-56922","kind":"paragraph","spans":[{"id":"spn-83745","text":"Untyped link marks (no "},{"id":"spn-83746","marks":["code"],"text":"predicate"},{"id":"spn-83747","text":") do NOT emit edges (per §2.5.1)"}]}],"id":"blk-56921","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56923","kind":"paragraph","spans":[{"id":"spn-83748","marks":["bold"],"text":"§8 harness mechanics — verified with mock LLMs."},{"id":"spn-83749","text":" No paid API calls yet:"}]},{"id":"blk-56924","items":[{"blocks":[{"id":"blk-56926","kind":"paragraph","spans":[{"id":"spn-83750","text":"Drift metric implemented (5 components per §8.4: block_structure, edge_preservation, span_coverage, mark_fidelity, vocabulary_integrity), zero-drift on identical docs"}]}],"id":"blk-56925","kind":"list-item"},{"blocks":[{"id":"blk-56928","kind":"paragraph","spans":[{"id":"spn-83751","text":"Identity / small-edit / lossy / garbage mock models exercise each failure mode"}]}],"id":"blk-56927","kind":"list-item"},{"blocks":[{"id":"blk-56930","kind":"paragraph","spans":[{"id":"spn-83752","text":"Median + P95 aggregation per §8.5"}]}],"id":"blk-56929","kind":"list-item"},{"blocks":[{"id":"blk-56932","kind":"paragraph","spans":[{"id":"spn-83753","text":"Threshold checking emits "},{"id":"spn-83754","marks":["code"],"text":"pass"},{"id":"spn-83755","text":" / "},{"id":"spn-83756","marks":["code"],"text":"fail"},{"id":"spn-83757","text":" verdict with failing thresholds enumerated"}]}],"id":"blk-56931","kind":"list-item"},{"blocks":[{"id":"blk-56934","kind":"paragraph","spans":[{"id":"spn-83758","marks":["code"],"text":"MockModel"},{"id":"spn-83759","text":" with "},{"id":"spn-83760","marks":["code"],"text":"lossy"},{"id":"spn-83761","text":" mode confirmed: harness correctly enforces spec invariant that link-mark edges always re-expand on parse, so dropping the "},{"id":"spn-83762","marks":["code"],"text":"edges"},{"id":"spn-83763","text":" array doesn't lose link-mark-derived edges"}]}],"id":"blk-56933","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56935","kind":"paragraph","spans":[{"id":"spn-83764","marks":["bold"],"text":"§8.1.2 LLM round-trip — not yet run against real models."},{"id":"spn-83765","text":" Implementing a "},{"id":"spn-83766","marks":["code"],"text":"ModelClient"},{"id":"spn-83767","text":" against OpenRouter is the next step. Estimated cost: $5–20 per gating run (180 calls = 20 docs × 3 classes × 3 models)."}]},{"id":"blk-56936","kind":"paragraph","spans":[{"id":"spn-83768","marks":["bold"],"text":"§14.3.1 Graphonomous adoption — not yet implemented."},{"id":"spn-83769","text":" This is the other gating commitment for v0.1 final."}]},{"id":"blk-56937","kind":"heading","level":2,"spans":[{"id":"spn-83770","text":"Conventions"}]},{"id":"blk-56938","items":[{"blocks":[{"id":"blk-56940","kind":"paragraph","spans":[{"id":"spn-83771","text":"Spec uses RFC discipline (MUST / SHOULD / MAY)"}]}],"id":"blk-56939","kind":"list-item"},{"blocks":[{"id":"blk-56942","kind":"paragraph","spans":[{"id":"spn-83772","text":"Canonical document form is JSON; text projection deferred to v0.2"}]}],"id":"blk-56941","kind":"list-item"},{"blocks":[{"id":"blk-56944","kind":"paragraph","spans":[{"id":"spn-83773","marks":["code"],"text":".bend"},{"id":"spn-83774","text":" files are not hand-authored — produced by editors that emit JSON"}]}],"id":"blk-56943","kind":"list-item"},{"blocks":[{"id":"blk-56946","kind":"paragraph","spans":[{"id":"spn-83775","text":"No host coupling: the protocol must work in TypeScript, Elixir, Rust, plain HTML"}]}],"id":"blk-56945","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierac7oiqoer7wedplddc5dwrsne3z3ufhylvewlyvtuimax35vmnd4a","vocabulary":"ampersand.docs.fs.v1"}