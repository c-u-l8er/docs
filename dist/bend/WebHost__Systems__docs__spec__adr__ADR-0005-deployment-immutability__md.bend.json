s":["code"],"text":"version"}]}],"id":"blk-51896","kind":"list-item"},{"blocks":[{"id":"blk-51899","kind":"paragraph","spans":[{"id":"spn-78498","text":"Only the allowed mutable subset may be updated (status/providerRef/error/timestamps/log pointers)."}]}],"id":"blk-51898","kind":"list-item"},{"blocks":[{"id":"blk-51901","kind":"paragraph","spans":[{"id":"spn-78499","text":"Client code MUST NOT be allowed to update deployment rows directly."}]}],"id":"blk-51900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51902","kind":"heading","level":3,"spans":[{"id":"spn-78500","text":"6.3 Activation rules"}]},{"id":"blk-51903","kind":"paragraph","spans":[{"id":"spn-78501","text":"When activating a deployment (including rollback):"}]},{"id":"blk-51904","items":[{"blocks":[{"id":"blk-51906","kind":"paragraph","spans":[{"id":"spn-78502","text":"The target deployment MUST:"}]}],"id":"blk-51905","kind":"list-item"},{"blocks":[{"id":"blk-51908","kind":"paragraph","spans":[{"id":"spn-78503","text":"belong to the agent,"}]}],"id":"blk-51907","kind":"list-item"},{"blocks":[{"id":"blk-51910","kind":"paragraph","spans":[{"id":"spn-78504","text":"belong to the current user (tenant check),"}]}],"id":"blk-51909","kind":"list-item"},{"blocks":[{"id":"blk-51912","kind":"paragraph","spans":[{"id":"spn-78505","text":"be in a valid state for activation (recommended: "},{"id":"spn-78506","marks":["code"],"text":"status=active"},{"id":"spn-78507","text":")."}]}],"id":"blk-51911","kind":"list-item"},{"blocks":[{"id":"blk-51914","kind":"paragraph","spans":[{"id":"spn-78508","text":"The system MUST update "},{"id":"spn-78509","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-78510","text":" to the target deployment id."}]}],"id":"blk-51913","kind":"list-item"},{"blocks":[{"id":"blk-51916","kind":"paragraph","spans":[{"id":"spn-78511","text":"The system SHOULD record an audit log entry:"}]}],"id":"blk-51915","kind":"list-item"},{"blocks":[{"id":"blk-51918","kind":"parag