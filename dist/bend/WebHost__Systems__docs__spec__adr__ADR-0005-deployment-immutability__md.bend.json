,"spans":[{"id":"spn-78561","text":"6.7 Retention and cleanup"}]},{"id":"blk-51973","items":[{"blocks":[{"id":"blk-51975","kind":"paragraph","spans":[{"id":"spn-78562","text":"Deployments are retained as part of audit history."}]}],"id":"blk-51974","kind":"list-item"},{"blocks":[{"id":"blk-51977","kind":"paragraph","spans":[{"id":"spn-78563","text":"The platform SHOULD implement:"}]}],"id":"blk-51976","kind":"list-item"},{"blocks":[{"id":"blk-51979","kind":"paragraph","spans":[{"id":"spn-78564","text":"retention policy for old deployments (e.g., keep last N or last X days) per tier,"}]}],"id":"blk-51978","kind":"list-item"},{"blocks":[{"id":"blk-51981","kind":"paragraph","spans":[{"id":"spn-78565","text":"best-effort deprovisioning of provider resources when deployments are deleted or when an agent is deleted."}]}],"id":"blk-51980","kind":"list-item"},{"blocks":[{"id":"blk-51983","kind":"paragraph","spans":[{"id":"spn-78566","text":"Cleanup MUST be careful not to remove resources for the currently active deployment."}]}],"id":"blk-51982","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51984","kind":"heading","level":2,"spans":[{"id":"spn-78567","text":"7) Testing requirements (acceptance-focused)"}]},{"id":"blk-51985","kind":"heading","level":3,"spans":[{"id":"spn-78568","text":"7.1 Unit tests (MUST)"}]},{"id":"blk-51986","items":[{"blocks":[{"id":"blk-51988","kind":"paragraph","spans":[{"id":"spn-78569","text":"Deployment status transition validation."}]}],"id":"blk-51987","kind":"list-item"},{"blocks":[{"id":"blk-51990","kind":"paragraph","spans":[{"id":"spn-78570","text":"Immutability enforcement (attempted mutation of immutable fields rejected)."}]}],"id":"blk-51989","kind":"list-item"},{"blocks":[{"id":"blk-51992","kind":"paragraph","spans":[{"id":"spn-78571","text":"Activation validation (wrong agent/user/state rejected)."}]}],"id":"blk-51991","kind":"list-item"},{"blocks":[{"id":"blk-51994","kind":"paragraph","spans":[{"id":"spn-78572","text":"Routing resolver uses "},{"id":"spn-78573","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-78574","text":" only."}]}],"id":"blk-51993","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51995","kind":"heading","level":3,"spans":[{"id":"spn-78575","text":"7.2 Integration tests (MUST)"}]},{"id":"blk-51996","items":[{"blocks":[{"id":"blk-51998","kind":"paragraph","spans":[{"id":"spn-78576","text":"Deploy creates new immutable record; a second deploy creates a second record."}]}],"id":"blk-51997","kind":"list-item"},{"blocks":[{"id":"blk-52000","kind":"paragraph","spans":[{"id":"spn-78577","text":"Activate (rollback) changes routing immediately."}]}],"id":"blk-51999","kind":"list-item"},{"blocks":[{"id":"blk-52002","kind":"paragraph","spans":[{"id":"spn-78578","text":"Concurrent deploy attempts are rejected with "},{"id":"spn-78579","marks":["code"],"text":"CONFLICT"},{"id":"spn-78580","text":" (v1)."}]}],"id":"blk-52001","kind":"list-item"},{"blocks":[{"id":"blk-52004","kind":"paragraph","spans":[{"id":"spn-78581","text":"Telemetry attribution includes correct "},{"id":"spn-78582","marks":["code"],"text":"deploymentId"},{"id":"spn-78583","text":"."}]}],"id":"blk-52003","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52005","kind":"heading","level":3,"spans":[{"id":"spn-78584","text":"7.3 E2E tests (MUST)"}]},{"id":"blk-52006","items":[{"blocks":[{"id":"blk-52008","kind":"paragraph","spans":[{"id":"spn-78585","text":"Deploy v1 → invoke returns v1 output."}]}],"id":"blk-52007","kind":"list-item"},{"blocks":[{"id":"blk-52010","kind":"paragraph","spans":[{"id":"spn-78586","text":"Deploy v2 → invoke returns v2 output."}]}],"id":"blk-52009","kind":"list-item"},{"blocks":[{"id":"blk-52012","kind":"paragraph","spans":[{"id":"spn-78587","text":"Activate v1 → invoke returns v1 output again."}]}],"id":"blk-52011","kind":"list-item"},{"blocks":[{"id":"blk-52014","kind":"paragraph","spans":[{"id":"spn-78588","text":"Deployment history remains intact and visible."}]}],"id":"blk-52013","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52015","kind":"heading","level":2,"spans":[{"id":"spn-78589","text":"8) Future extensions enabled by this ADR"}]},{"id":"blk-52016","kind":"paragraph","spans":[{"id":"spn-78590","text":"This model is a foundation for:"}]},{"id":"blk-52017","items":[{"blocks":[{"id":"blk-52019","kind":"paragraph","spans":[{"id":"spn-78591","text":"canary/blue-green deployments (multiple “active” pointers with traffic split policies),"}]}],"id":"blk-52018","kind":"list-item"},{"blocks":[{"id":"blk-52021","kind":"paragraph","spans":[{"id":"spn-78592","text":"environment promotion (dev → staging → prod) with deployment immutability preserved,"}]}],"id":"blk-52020","kind":"list-item"},{"blocks":[{"id":"blk-52023","kind":"paragraph","spans":[{"id":"spn-78593","text":"signed deployment manifests / provenance,"}]}],"id":"blk-52022","kind":"list-item"},{"blocks":[{"id":"blk-52025","kind":"paragraph","spans":[{"id":"spn-78594","text":"provider billing reconciliation (resource tags + immutable providerRef),"}]}],"id":"blk-52024","kind":"list-item"},{"blocks":[{"id":"blk-52027","kind":"paragraph","spans":[{"id":"spn-78595","text":"more advanced rollback policies (automatic rollback on error rate thresholds)."}]}],"id":"blk-52026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52028","kind":"heading","level":2,"spans":[{"id":"spn-78596","text":"9) Acceptance criteria"}]},{"id":"blk-52029","kind":"paragraph","spans":[{"id":"spn-78597","text":"This ADR is correctly implemented when:"}]},{"id":"blk-52030","items":[{"blocks":[{"id":"blk-52032","kind":"paragraph","spans":[{"id":"spn-78598","text":"Every deployment attempt creates a new deployment record and does not mutate previous deployments’ immutable fields."}]}],"id":"blk-52031","kind":"list-item"},{"blocks":[{"id":"blk-52034","kind":"paragraph","spans":[{"id":"spn-78599","text":"An agent’s invocations always route to "},{"id":"s