,"spans":[{"id":"spn-80951","text":"6.7 Retention and cleanup"}]},{"id":"blk-52689","items":[{"blocks":[{"id":"blk-52691","kind":"paragraph","spans":[{"id":"spn-80952","text":"Deployments are retained as part of audit history."}]}],"id":"blk-52690","kind":"list-item"},{"blocks":[{"id":"blk-52693","kind":"paragraph","spans":[{"id":"spn-80953","text":"The platform SHOULD implement:"}]}],"id":"blk-52692","kind":"list-item"},{"blocks":[{"id":"blk-52695","kind":"paragraph","spans":[{"id":"spn-80954","text":"retention policy for old deployments (e.g., keep last N or last X days) per tier,"}]}],"id":"blk-52694","kind":"list-item"},{"blocks":[{"id":"blk-52697","kind":"paragraph","spans":[{"id":"spn-80955","text":"best-effort deprovisioning of provider resources when deployments are deleted or when an agent is deleted."}]}],"id":"blk-52696","kind":"list-item"},{"blocks":[{"id":"blk-52699","kind":"paragraph","spans":[{"id":"spn-80956","text":"Cleanup MUST be careful not to remove resources for the currently active deployment."}]}],"id":"blk-52698","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52700","kind":"heading","level":2,"spans":[{"id":"spn-80957","text":"7) Testing requirements (acceptance-focused)"}]},{"id":"blk-52701","kind":"heading","level":3,"spans":[{"id":"spn-80958","text":"7.1 Unit tests (MUST)"}]},{"id":"blk-52702","items":[{"blocks":[{"id":"blk-52704","kind":"paragraph","spans":[{"id":"spn-80959","text":"Deployment status transition validation."}]}],"id":"blk-52703","kind":"list-item"},{"blocks":[{"id":"blk-52706","kind":"paragraph","spans":[{"id":"spn-80960","text":"Immutability enforcement (attempted mutation of immutable fields rejected)."}]}],"id":"blk-52705","kind":"list-item"},{"blocks":[{"id":"blk-52708","kind":"paragraph","spans":[{"id":"spn-80961","text":"Activation validation (wrong agent/user/state rejected)."}]}],"id":"blk-52707","kind":"list-item"},{"blocks":[{"id":"blk-52710","kind":"paragraph","spans":[{"id":"spn-80962","text":"