{"bendscript":"0.1","blocks":[{"id":"blk-52374","kind":"heading","level":1,"spans":[{"id":"spn-80681","text":"ADR-0005: Deployment Immutability + Active Deployment Pointer Model"}]},{"id":"blk-52375","items":[{"blocks":[{"id":"blk-52377","kind":"paragraph","spans":[{"id":"spn-80682","marks":["bold"],"text":"Status:"},{"id":"spn-80683","text":" Accepted (v1)"}]}],"id":"blk-52376","kind":"list-item"},{"blocks":[{"id":"blk-52379","kind":"paragraph","spans":[{"id":"spn-80684","marks":["bold"],"text":"Date:"},{"id":"spn-80685","text":" 2026-01-21"}]}],"id":"blk-52378","kind":"list-item"},{"blocks":[{"id":"blk-52381","kind":"paragraph","spans":[{"id":"spn-80686","marks":["bold"],"text":"Owners:"},{"id":"spn-80687","text":" webhost.systems engineering"}]}],"id":"blk-52380","kind":"list-item"},{"blocks":[{"id":"blk-52383","kind":"paragraph","spans":[{"id":"spn-80688","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-52382","kind":"list-item"},{"blocks":[{"id":"blk-52385","kind":"paragraph","spans":[{"id":"spn-80689","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-52384","kind":"list-item"},{"blocks":[{"id":"blk-52387","kind":"paragraph","spans":[{"id":"spn-80690","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-52386","kind":"list-item"},{"blocks":[{"id":"blk-52389","kind":"paragraph","spans":[{"id":"spn-80691","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-52388","kind":"list-item"},{"blocks":[{"id":"blk-52391","kind":"paragraph","spans":[{"id":"spn-80692","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-52390","kind":"list-item"},{"blocks":[{"id":"blk-52393","kind":"paragraph","spans":[{"id":"spn-80693","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-52392","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52394","kind":"heading","level":2,"spans":[{"id":"spn-80694","text":"1) Context"}]},{"id":"blk-52395","kind":"paragraph","spans":[{"id":"spn-80695","text":"webhost.systems deploys untrusted customer agent code to one of multiple runtime providers and routes invocations to the correct deployed version. The platform must support:"}]},{"id":"blk-52396","items":[{"blocks":[{"id":"blk-52398","kind":"paragraph","spans":[{"id":"spn-80696","text":"safe, repeatable deployments,"}]}],"id":"blk-52397","kind":"list-item"},{"blocks":[{"id":"blk-52400","kind":"paragraph","spans":[{"id":"spn-80697","text":"rapid iteration with reliable rollbacks,"}]}],"id":"blk-52399","kind":"list-item"},{"blocks":[{"id":"blk-52402","kind":"paragraph","spans":[{"id":"spn-80698","text":"clear auditability (“what is running now, and who changed it?”),"}]}],"id":"blk-52401","kind":"list-item"},{"blocks":[{"id":"blk-52404","kind":"paragraph","spans":[{"id":"spn-80699","text":"consistent routing across multiple runtime providers,"}]}],"id":"blk-52403","kind":"list-item"},{"blocks":[{"id":"blk-52406","kind":"paragraph","spans":[{"id":"spn-80700","text":"robust handling of partial failures (deploy succeeded on provider but DB update failed; or vice versa),"}]}],"id":"blk-52405","kind":"list-item"},{"blocks":[{"id":"blk-52408","kind":"paragraph","spans":[{"id":"spn-80701","text":"deterministic metering attribution to "},{"id":"spn-80702","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-80703","text":"."}]}],"id":"blk-52407","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52409","kind":"paragraph","spans":[{"id":"spn-80704","text":"Early prototypes often store deployment state “in place” on the agent record (e.g., overwriting "},{"id":"spn-80705","marks":["code"],"text":"workerUrl"},{"id":"spn-80706","text":", updating "},{"id":"spn-80707","marks":["code"],"text":"codeHash"},{"id":"spn-80708","text":", etc.). This tends to create correctness and support problems:"}]},{"id":"blk-52410","items":[{"blocks":[{"id":"blk-52412","kind":"paragraph","spans":[{"id":"spn-80709","text":"You lose historical context (“what changed?”)."}]}],"id":"blk-52411","kind":"list-item"},{"blocks":[{"id":"blk-52414","kind":"paragraph","spans":[{"id":"spn-80710","text":"Rollback is difficult or impossible without redeploying."}]}],"id":"blk-52413","kind":"list-item"},{"blocks":[{"id":"blk-52416","kind":"paragraph","spans":[{"id":"spn-80711","text":"In-flight deploys can corrupt the “current” state if they fail midway."}]}],"id":"blk-52415","kind":"list-item"},{"blocks":[{"id":"blk-52418","kind":"paragraph","spans":[{"id":"spn-80712","text":"Auditing, debugging, and cost reconciliation become fragile."}]}],"id":"blk-52417","kind":"list-item"},{"blocks":[{"id":"blk-52420","kind":"paragraph","spans":[{"id":"spn-80713","text":"Concurrency introduces race conditions: two deploys can interleave and leave the agent in an inconsistent state."}]}],"id":"blk-52419","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52421","kind":"paragraph","spans":[{"id":"spn-80714","text":"Therefore, the system needs a durable, auditable, and concurrency-tolerant model for deployments and routing."}]},{"id":"blk-52422","kind":"heading","level":2,"spans":[{"id":"spn-80715","text":"2) Decision"}]},{"id":"blk-52423","kind":"heading","level":3,"spans":[{"id":"spn-80716","text":"2.1 Deployment immutability"}]},{"id":"blk-52424","kind":"paragraph","spans":[{"id":"spn-80717","text":"A "},{"id":"spn-80718","marks":["bold"],"text":"Deployment"},{"id":"spn-80719","text":" is an immutable record representing a specific released version of an agent."}]},{"id":"blk-52425","items":[{"blocks":[{"id":"blk-52427","kind":"paragraph","spans":[{"id":"spn-80720","text":"A new deployment attempt MUST create a "},{"id":"spn-80721","marks":["bold"],"text":"new deployment record"},{"id":"spn-80722","text":" ("},{"id":"spn-80723","marks":["code"],"text":"deployments"},{"id":"spn-80724","text":" table row)."}]}],"id":"blk-52426","kind":"list-item"},{"blocks":[{"id":"blk-52429","kind":"paragraph","spans":[{"id":"spn-80725","text":"Deployment records MUST be treated as immutable after creation, except for a narrowly defined mutable subset:"}]}],"id":"blk-52428","kind":"list-item"},{"blocks":[{"id":"blk-52431","kind":"paragraph","spans":[{"id":"spn-80726","marks":["code"],"text":"status"},{"id":"spn-80727","text":" (e.g., deploying → active/failed)"}]}],"id":"blk-52430","kind":"list-item"},{"blocks":[{"id":"blk-52433","kind":"paragraph","spans":[{"id":"spn-80728","marks":["code"],"text":"providerRef"},{"id":"spn-80729","text":" (filled once known)"}]}],"id":"blk-52432","kind":"list-item"},{"blocks":[{"id":"blk-52435","kind":"paragraph","spans":[{"id":"spn-80730","marks":["code"],"text":"errorMessage"},{"id":"spn-80731","text":" (sanitized)"}]}],"id":"blk-52434","kind":"list-item"},{"blocks":[{"id":"blk-52437","kind":"paragraph","spans":[{"id":"spn-80732","text":"timestamps like "},{"id":"spn-80733","marks":["code"],"text":"deployedAtMs"},{"id":"spn-80734","text":" / "},{"id":"spn-80735","marks":["code"],"text":"finishedAtMs"}]}],"id":"blk-52436","kind":"list-item"},{"blocks":[{"id":"blk-52439","kind":"paragraph","spans":[{"id":"spn-80736","text":"optional "},{"id":"spn-80737","marks":["code"],"text":"logsRef"},{"id":"spn-80738","text":" pointer"}]}],"id":"blk-52438","kind":"list-item"},{"blocks":[{"id":"blk-52441","kind":"paragraph","spans":[{"id":"spn-80739","text":"Any new code/artifact/provider configuration change MUST create a new deployment record (never modify an existing deployment to “become” the new version)."}]}],"id":"blk-52440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52442","kind":"heading","level":3,"spans":[{"id":"spn-80740","text":"2.2 Active deployment pointer"}]},{"id":"blk-52443","kind":"paragraph","spans":[{"id":"spn-80741","text":"Each agent has a single routing pointer:"}]},{"id":"blk-52444","items":[{"blocks":[{"id":"blk-52446","kind":"paragraph","spans":[{"id":"spn-80742","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-80743","text":" points to the deployment that should receive invocations."}]}],"id":"blk-52445","kind":"list-item"},{"blocks":[{"id":"blk-52448","kind":"paragraph","spans":[{"id":"spn-80744","text":"Rollback (and “activate old deployment”) is implemented by updating "},{"id":"spn-80745","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-80746","text":" to a previous deployment id."}]}],"id":"blk-52447","kind":"list-item"},{"blocks":[{"id":"blk-52450","kind":"paragraph","spans":[{"id":"spn-80747","text":"Invocation routing uses ONLY:"}]}],"id":"blk-52449","kind":"list-item"},{"blocks":[{"id":"blk-52452","kind":"paragraph","spans":[{"id":"spn-80748","text":"agent ownership checks + status checks, then"}]}],"id":"blk-52451","kind":"list-item"},{"blocks":[{"id":"blk-52454","kind":"paragraph","spans":[{"id":"spn-80749","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-80750","text":" → "},{"id":"spn-80751","marks":["code"],"text":"deployments.providerRef"},{"id":"spn-80752","text":" and "},{"id":"spn-80753","marks":["code"],"text":"deployments.runtimeProvider"},{"id":"spn-80754","text":" to select runtime adapter and invoke."}]}],"id":"blk-52453","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52455","kind":"heading","level":3,"spans":[{"id":"spn-80755","text":"2.3 Single-writer rule per agent during deploy (v1 simplification)"}]},{"id":"blk-52456","kind":"paragraph","spans":[{"id":"spn-80756","text":"To reduce complexity and prevent version races in v1:"}]},{"id":"blk-52457","items":[{"blocks":[{"id":"blk-52459","kind":"paragraph","spans":[{"id":"spn-80757","text":"The platform MUST prevent concurrent deployments per agent (e.g., guard with "},{"id":"spn-80758","marks":["code"],"text":"agents.status=deploying"},{"id":"spn-80759","text":" or a server-side mutex mechanism)."}]}],"id":"blk-52458","kind":"list-item"},{"blocks":[{"id":"blk-52461","kind":"paragraph","spans":[{"id":"spn-80760","text":"A second deploy attempt while "},{"id":"spn-80761","marks":["code"],"text":"deploying"},{"id":"spn-80762","text":" SHOULD fail with "},{"id":"spn-80763","marks":["code"],"text":"CONFLICT"},{"id":"spn-80764","text":" (or be queued post-v1)."}]}],"id":"blk-52460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52462","kind":"heading","level":2,"spans":[{"id":"spn-80765","text":"3) Rationale"}]},{"id":"blk-52463","kind":"heading","level":3,"spans":[{"id":"spn-80766","text":"3.1 Safety and correctness"}]},{"id":"blk-52464","kind":"paragraph","spans":[{"id":"spn-80767","text":"Immutability avoids a class of “torn writes” where partial updates leave the system in an inconsistent state. If deployment artifacts and references are immutable, you can always answer:"}]},{"id":"blk-52465","items":[{"blocks":[{"id":"blk-52467","kind":"paragraph","spans":[{"id":"spn-80768","text":"exactly what was deployed,"}]}],"id":"blk-52466","kind":"list-item"},{"blocks":[{"id":"blk-52469","kind":"paragraph","spans":[{"id":"spn-80769","text":"where it was deployed,"}]}],"id":"blk-52468","kind":"list-item"},{"blocks":[{"id":"blk-52471","kind":"paragraph","spans":[{"id":"spn-80770","text":"and when it changed."}]}],"id":"blk-52470","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52472","kind":"heading","level":3,"spans":[{"id":"spn-80771","text":"3.2 Rollbacks become fast and reliable"}]},{"id":"blk-52473","kind":"paragraph","spans":[{"id":"spn-80772","text":"With immutable deployments, rollback is primarily a pointer change:"}]},{"id":"blk-52474","items":[{"blocks":[{"id":"blk-52476","kind":"paragraph","spans":[{"id":"spn-80773","text":"no redeploy required (unless provider forces it for technical reasons),"}]}],"id":"blk-52475","kind":"list-item"},{"blocks":[{"id":"blk-52478","kind":"paragraph","spans":[{"id":"spn-80774","text":"quick recovery from bad deploys,"}]}],"id":"blk-52477","kind":"list-item"},{"blocks":[{"id":"blk-52480","kind":"paragraph","spans":[{"id":"spn-80775","text":"repeatable and auditable."}]}],"id":"blk-52479","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52481","kind":"heading","level":3,"spans":[{"id":"spn-80776","text":"3.3 Auditing and supportability"}]},{"id":"blk-52482","kind":"paragraph","spans":[{"id":"spn-80777","text":"A permanent deployment history supports:"}]},{"id":"blk-52483","items":[{"blocks":[{"id":"blk-52485","kind":"paragraph","spans":[{"id":"spn-80778","text":"customer support (“what changed?”),"}]}],"id":"blk-52484","kind":"list-item"},{"blocks":[{"id":"blk-52487","kind":"paragraph","spans":[{"id":"spn-80779","text":"incident response (“who activated what?”),"}]}],"id":"blk-52486","kind":"list-item"},{"blocks":[{"id":"blk-52489","kind":"paragraph","spans":[{"id":"spn-80780","text":"compliance-aligned audits."}]}],"id":"blk-52488","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52490","kind":"heading","level":3,"spans":[{"id":"spn-80781","text":"3.4 Metering attribution and future cost reconciliation"}]},{"id":"blk-52491","kind":"paragraph","spans":[{"id":"spn-80782","text":"When telemetry references a "},{"id":"spn-80783","marks":["code"],"text":"deploymentId"},{"id":"spn-80784","text":" and deployments are immutable, usage can always be attributed to an exact version and provider resource set. This also enables future provider cost reconciliation by tagging provider resources per deployment."}]},{"id":"blk-52492","kind":"heading","level":3,"spans":[{"id":"spn-80785","text":"3.5 Multi-runtime routing simplicity"}]},{"id":"blk-52493","kind":"paragraph","spans":[{"id":"spn-80786","text":"A single "},{"id":"spn-80787","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-80788","text":" model works uniformly across providers:"}]},{"id":"blk-52494","items":[{"blocks":[{"id":"blk-52496","kind":"paragraph","spans":[{"id":"spn-80789","text":"Cloudflare: "},{"id":"spn-80790","marks":["code"],"text":"providerRef.cloudflare.workerUrl"},{"id":"spn-80791","text":" etc."}]}],"id":"blk-52495","kind":"list-item"},{"blocks":[{"id":"blk-52498","kind":"paragraph","spans":[{"id":"spn-80792","text":"AgentCore: "},{"id":"spn-80793","marks":["code"],"text":"providerRef.agentcore.agentRuntimeArn"},{"id":"spn-80794","text":" etc."}]}],"id":"blk-52497","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52499","kind":"paragraph","spans":[{"id":"spn-80795","text":"The control plane remains provider-agnostic; provider-specific details are confined to adapter implementations."}]},{"id":"blk-52500","kind":"heading","level":2,"spans":[{"id":"spn-80796","text":"4) Alternatives considered"}]},{"id":"blk-52501","kind":"heading","level":3,"spans":[{"id":"spn-80797","text":"A) Mutable deployment state stored on the agent row only"}]},{"id":"blk-52502","kind":"paragraph","spans":[{"id":"spn-80798","marks":["bold"],"text":"Pros"}]},{"id":"blk-52503","items":[{"blocks":[{"id":"blk-52505","kind":"paragraph","spans":[{"id":"spn-80799","text":"Minimal schema."}]}],"id":"blk-52504","kind":"list-item"},{"blocks":[{"id":"blk-52507","kind":"paragraph","spans":[{"id":"spn-80800","text":"Simplifies “what’s currently active” (single record)."}]}],"id":"blk-52506","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52508","kind":"paragraph","spans":[{"id":"spn-80801","marks":["bold"],"text":"Cons"}]},{"id":"blk-52509","items":[{"blocks":[{"id":"blk-52511","kind":"paragraph","spans":[{"id":"spn-80802","text":"Loses history."}]}],"id":"blk-52510","kind":"list-item"},{"blocks":[{"id":"blk-52513","kind":"paragraph","spans":[{"id":"spn-80803","text":"Hard to rollback."}]}],"id":"blk-52512","kind":"list-item"},{"blocks":[{"id":"blk-52515","kind":"paragraph","spans":[{"id":"spn-80804","text":"Partial failures can corrupt the running pointer."}]}],"id":"blk-52514","kind":"list-item"},{"blocks":[{"id":"blk-52517","kind":"paragraph","spans":[{"id":"spn-80805","text":"Difficult to audit and debug."}]}],"id":"blk-52516","kind":"list-item"},{"blocks":[{"id":"blk-52519","kind":"paragraph","spans":[{"id":"spn-80806","text":"Makes telemetry attribution ambiguous when “current deployment” changes."}]}],"id":"blk-52518","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52520","kind":"paragraph","spans":[{"id":"spn-80807","marks":["bold"],"text":"Decision:"},{"id":"spn-80808","text":" Rejected."}]},{"id":"blk-52521","kind":"heading","level":3,"spans":[{"id":"spn-80809","text":"B) Immutable deployments without an active pointer (derive “active” from latest successful deploy)"}]},{"id":"blk-52522","kind":"paragraph","spans":[{"id":"spn-80810","marks":["bold"],"text":"Pros"}]},{"id":"blk-52523","items":[{"blocks":[{"id":"blk-52525","kind":"paragraph","spans":[{"id":"spn-80811","text":"No pointer updates; “active” is last successful deployment."}]}],"id":"blk-52524","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52526","kind":"paragraph","spans":[{"id":"spn-80812","marks":["bold"],"text":"Cons"}]},{"id":"blk-52527","items":[{"blocks":[{"id":"blk-52529","kind":"paragraph","spans":[{"id":"spn-80813","text":"Rollback becomes non-trivial (must “fake” a new deploy or add flags)."}]}],"id":"blk-52528","kind":"list-item"},{"blocks":[{"id":"blk-52531","kind":"paragraph","spans":[{"id":"spn-80814","text":"“Latest” is not always what you want running (e.g., canary, manual pinning)."}]}],"id":"blk-52530","kind":"list-item"},{"blocks":[{"id":"blk-52533","kind":"paragraph","spans":[{"id":"spn-80815","text":"In-flight deploys complicate “latest success” semantics."}]}],"id":"blk-52532","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52534","kind":"paragraph","spans":[{"id":"spn-80816","marks":["bold"],"text":"Decision:"},{"id":"spn-80817","text":" Rejected."}]},{"id":"blk-52535","kind":"heading","level":3,"spans":[{"id":"spn-80818","text":"C) Mutable “active deployment” record plus separate immutable history"}]},{"id":"blk-52536","kind":"paragraph","spans":[{"id":"spn-80819","marks":["bold"],"text":"Pros"}]},{"id":"blk-52537","items":[{"blocks":[{"id":"blk-52539","kind":"paragraph","spans":[{"id":"spn-80820","text":"A dedicated active record could simplify reads."}]}],"id":"blk-52538","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52540","kind":"paragraph","spans":[{"id":"spn-80821","marks":["bold"],"text":"Cons"}]},{"id":"blk-52541","items":[{"blocks":[{"id":"blk-52543","kind":"paragraph","spans":[{"id":"spn-80822","text":"You now have two sources of truth to keep consistent."}]}],"id":"blk-52542","kind":"list-item"},{"blocks":[{"id":"blk-52545","kind":"paragraph","spans":[{"id":"spn-80823","text":"Reintroduces mutability issues for the “active” record."}]}],"id":"blk-52544","kind":"list-item"},{"blocks":[{"id":"blk-52547","kind":"paragraph","spans":[{"id":"spn-80824","text":"Added complexity with limited benefit over a pointer."}]}],"id":"blk-52546","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52548","kind":"paragraph","spans":[{"id":"spn-80825","marks":["bold"],"text":"Decision:"},{"id":"spn-80826","text":" Rejected."}]},{"id":"blk-52549","kind":"heading","level":3,"spans":[{"id":"spn-80827","text":"D) Blue/green or canary routing model as default"}]},{"id":"blk-52550","kind":"paragraph","spans":[{"id":"spn-80828","marks":["bold"],"text":"Pros"}]},{"id":"blk-52551","items":[{"blocks":[{"id":"blk-52553","kind":"paragraph","spans":[{"id":"spn-80829","text":"Advanced rollout safety."}]}],"id":"blk-52552","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52554","kind":"paragraph","spans":[{"id":"spn-80830","marks":["bold"],"text":"Cons"}]},{"id":"blk-52555","items":[{"blocks":[{"id":"blk-52557","kind":"paragraph","spans":[{"id":"spn-80831","text":"Too complex for v1."}]}],"id":"blk-52556","kind":"list-item"},{"blocks":[{"id":"blk-52559","kind":"paragraph","spans":[{"id":"spn-80832","text":"Requires traffic splitting, per-request routing policies, and richer metrics gating."}]}],"id":"blk-52558","kind":"list-item"},{"blocks":[{"id":"blk-52561","kind":"paragraph","spans":[{"id":"spn-80833","text":"Still requires immutable deployments underneath."}]}],"id":"blk-52560","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52562","kind":"paragraph","spans":[{"id":"spn-80834","marks":["bold"],"text":"Decision:"},{"id":"spn-80835","text":" Deferred to post-v1; can be built on top of this ADR."}]},{"id":"blk-52563","kind":"heading","level":2,"spans":[{"id":"spn-80836","text":"5) Consequences"}]},{"id":"blk-52564","kind":"heading","level":3,"spans":[{"id":"spn-80837","text":"5.1 Positive consequences"}]},{"id":"blk-52565","items":[{"blocks":[{"id":"blk-52567","kind":"paragraph","spans":[{"id":"spn-80838","text":"Reliable rollback (pointer flip)."}]}],"id":"blk-52566","kind":"list-item"},{"blocks":[{"id":"blk-52569","kind":"paragraph","spans":[{"id":"spn-80839","text":"Clear deployment audit trail."}]}],"id":"blk-52568","kind":"list-item"},{"blocks":[{"id":"blk-52571","kind":"paragraph","spans":[{"id":"spn-80840","text":"Strong basis for incident response and debugging."}]}],"id":"blk-52570","kind":"list-item"},{"blocks":[{"id":"blk-52573","kind":"paragraph","spans":[{"id":"spn-80841","text":"Simplified multi-runtime invocation routing."}]}],"id":"blk-52572","kind":"list-item"},{"blocks":[{"id":"blk-52575","kind":"paragraph","spans":[{"id":"spn-80842","text":"Enables deterministic telemetry attribution and later cost reconciliation."}]}],"id":"blk-52574","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52576","kind":"heading","level":3,"spans":[{"id":"spn-80843","text":"5.2 Negative consequences / tradeoffs"}]},{"id":"blk-52577","items":[{"blocks":[{"id":"blk-52579","kind":"paragraph","spans":[{"id":"spn-80844","text":"More schema and records (deployments grow over time)."}]}],"id":"blk-52578","kind":"list-item"},{"blocks":[{"id":"blk-52581","kind":"paragraph","spans":[{"id":"spn-80845","text":"Requires retention policy decisions for old deployments (storage cleanup, provider resource deprovisioning)."}]}],"id":"blk-52580","kind":"list-item"},{"blocks":[{"id":"blk-52583","kind":"paragraph","spans":[{"id":"spn-80846","text":"Requires careful handling of “deploy succeeded but DB update failed” and vice versa."}]}],"id":"blk-52582","kind":"list-item"},{"blocks":[{"id":"blk-52585","kind":"paragraph","spans":[{"id":"spn-80847","text":"Requires a versioning strategy (monotonic per agent) and concurrency controls."}]}],"id":"blk-52584","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52586","kind":"heading","level":2,"spans":[{"id":"spn-80848","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-52587","kind":"heading","level":3,"spans":[{"id":"spn-80849","text":"6.1 Data model requirements"}]},{"id":"blk-52588","kind":"paragraph","spans":[{"id":"spn-80850","text":"The following fields/semantics MUST exist (names may vary if consistent):"}]},{"id":"blk-52589","items":[{"blocks":[{"id":"blk-52591","kind":"paragraph","spans":[{"id":"spn-80851","marks":["code"],"text":"deployments"},{"id":"spn-80852","text":" table with:"}]}],"id":"blk-52590","kind":"list-item"},{"blocks":[{"id":"blk-52593","kind":"paragraph","spans":[{"id":"spn-80853","marks":["code"],"text":"agentId"},{"id":"spn-80854","text":", "},{"id":"spn-80855","marks":["code"],"text":"userId"}]}],"id":"blk-52592","kind":"list-item"},{"blocks":[{"id":"blk-52595","kind":"paragraph","spans":[{"id":"spn-80856","marks":["code"],"text":"version"},{"id":"spn-80857","text":" (monotonic per agent)"}]}],"id":"blk-52594","kind":"list-item"},{"blocks":[{"id":"blk-52597","kind":"paragraph","spans":[{"id":"spn-80858","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-52596","kind":"list-item"},{"blocks":[{"id":"blk-52599","kind":"paragraph","spans":[{"id":"spn-80859","marks":["code"],"text":"artifact"},{"id":"spn-80860","text":" reference (uploaded bundle or repo ref)"}]}],"id":"blk-52