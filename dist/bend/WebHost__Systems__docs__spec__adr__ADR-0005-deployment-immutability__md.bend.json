{"bendscript":"0.1","blocks":[{"id":"blk-51658","kind":"heading","level":1,"spans":[{"id":"spn-78291","text":"ADR-0005: Deployment Immutability + Active Deployment Pointer Model"}]},{"id":"blk-51659","items":[{"blocks":[{"id":"blk-51661","kind":"paragraph","spans":[{"id":"spn-78292","marks":["bold"],"text":"Status:"},{"id":"spn-78293","text":" Accepted (v1)"}]}],"id":"blk-51660","kind":"list-item"},{"blocks":[{"id":"blk-51663","kind":"paragraph","spans":[{"id":"spn-78294","marks":["bold"],"text":"Date:"},{"id":"spn-78295","text":" 2026-01-21"}]}],"id":"blk-51662","kind":"list-item"},{"blocks":[{"id":"blk-51665","kind":"paragraph","spans":[{"id":"spn-78296","marks":["bold"],"text":"Owners:"},{"id":"spn-78297","text":" webhost.systems engineering"}]}],"id":"blk-51664","kind":"list-item"},{"blocks":[{"id":"blk-51667","kind":"paragraph","spans":[{"id":"spn-78298","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-51666","kind":"list-item"},{"blocks":[{"id":"blk-51669","kind":"paragraph","spans":[{"id":"spn-78299","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-51668","kind":"list-item"},{"blocks":[{"id":"blk-51671","kind":"paragraph","spans":[{"id":"spn-78300","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-51670","kind":"list-item"},{"blocks":[{"id":"blk-51673","kind":"paragraph","spans":[{"id":"spn-78301","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-51672","kind":"list-item"},{"blocks":[{"id":"blk-51675","kind":"paragraph","spans":[{"id":"spn-78302","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-51674","kind":"list-item"},{"blocks":[{"id":"blk-51677","kind":"paragraph","spans":[{"id":"spn-78303","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-51676","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51678","kind":"heading","level":2,"spans":[{"id":"spn-78304","text":"1) Context"}]},{"id":"blk-51679","kind":"paragraph","spans":[{"id":"spn-78305","text":"webhost.systems deploys untrusted customer agent code to one of multiple runtime providers and routes invocations to the correct deployed version. The platform must support:"}]},{"id":"blk-51680","items":[{"blocks":[{"id":"blk-51682","kind":"paragraph","spans":[{"id":"spn-78306","text":"safe, repeatable deployments,"}]}],"id":"blk-51681","kind":"list-item"},{"blocks":[{"id":"blk-51684","kind":"paragraph","spans":[{"id":"spn-78307","text":"rapid iteration with reliable rollbacks,"}]}],"id":"blk-51683","kind":"list-item"},{"blocks":[{"id":"blk-51686","kind":"paragraph","spans":[{"id":"spn-78308","text":"clear auditability (“what is running now, and who changed it?”),"}]}],"id":"blk-51685","kind":"list-item"},{"blocks":[{"id":"blk-51688","kind":"paragraph","spans":[{"id":"spn-78309","text":"consistent routing across multiple runtime providers,"}]}],"id":"blk-51687","kind":"list-item"},{"blocks":[{"id":"blk-51690","kind":"paragraph","spans":[{"id":"spn-78310","text":"robust handling of partial failures (deploy succeeded on provider but DB update failed; or vice versa),"}]}],"id":"blk-51689","kind":"list-item"},{"blocks":[{"id":"blk-51692","kind":"paragraph","spans":[{"id":"spn-78311","text":"deterministic metering attribution to "},{"id":"spn-78312","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-78313","text":"."}]}],"id":"blk-51691","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51693","kind":"paragraph","spans":[{"id":"spn-78314","text":"Early prototypes often store deployment state “in place” on the agent record (e.g., overwriting "},{"id":"spn-78315","marks":["code"],"text":"workerUrl"},{"id":"spn-78316","text":", updating "},{"id":"spn-78317","marks":["code"],"text":"codeHash"},{"id":"spn-78318","text":", etc.). This tends to create correctness and support problems:"}]},{"id":"blk-51694","items":[{"blocks":[{"id":"blk-51696","kind":"paragraph","spans":[{"id":"spn-78319","text":"You lose historical context (“what changed?”)."}]}],"id":"blk-51695","kind":"list-item"},{"blocks":[{"id":"blk-51698","kind":"paragraph","spans":[{"id":"spn-78320","text":"Rollback is difficult or impossible without redeploying."}]}],"id":"blk-51697","kind":"list-item"},{"blocks":[{"id":"blk-51700","kind":"paragraph","spans":[{"id":"spn-78321","text":"In-flight deploys can corrupt the “current” state if they fail midway."}]}],"id":"blk-51699","kind":"list-item"},{"blocks":[{"id":"blk-51702","kind":"paragraph","spans":[{"id":"spn-78322","text":"Auditing, debugging, and cost reconciliation become fragile."}]}],"id":"blk-51701","kind":"list-item"},{"blocks":[{"id":"blk-51704","kind":"paragraph","spans":[{"id":"spn-78323","text":"Concurrency introduces race conditions: two deploys can interleave and leave the agent in an inconsistent state."}]}],"id":"blk-51703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51705","kind":"paragraph","spans":[{"id":"spn-78324","text":"Therefore, the system needs a durable, auditable, and concurrency-tolerant model for deployments and routing."}]},{"id":"blk-51706","kind":"heading","level":2,"spans":[{"id":"spn-78325","text":"2) Decision"}]},{"id":"blk-51707","kind":"heading","level":3,"spans":[{"id":"spn-78326","text":"2.1 Deployment immutability"}]},{"id":"blk-51708","kind":"paragraph","spans":[{"id":"spn-78327","text":"A "},{"id":"spn-78328","marks":["bold"],"text":"Deployment"},{"id":"spn-78329","text":" is an immutable record representing a specific released version of an agent."}]},{"id":"blk-51709","items":[{"blocks":[{"id":"blk-51711","kind":"paragraph","spans":[{"id":"spn-78330","text":"A new deployment attempt MUST create a "},{"id":"spn-78331","marks":["bold"],"text":"new deployment record"},{"id":"spn-78332","text":" ("},{"id":"spn-78333","marks":["code"],"text":"deployments"},{"id":"spn-78334","text":" table row)."}]}],"id":"blk-51710","kind":"list-item"},{"blocks":[{"id":"blk-51713","kind":"paragraph","spans":[{"id":"spn-78335","text":"Deployment records MUST be treated as immutable after creation, except for a narrowly defined mutable subset:"}]}],"id":"blk-51712","kind":"list-item"},{"blocks":[{"id":"blk-51715","kind":"paragraph","spans":[{"id":"spn-78336","marks":["code"],"text":"status"},{"id":"spn-78337","text":" (e.g., deploying → active/failed)"}]}],"id":"blk-51714","kind":"list-item"},{"blocks":[{"id":"blk-51717","kind":"paragraph","spans":[{"id":"spn-78338","marks":["code"],"text":"providerRef"},{"id":"spn-78339","text":" (filled once known)"}]}],"id":"blk-51716","kind":"list-item"},{"blocks":[{"id":"blk-51719","kind":"paragraph","spans":[{"id":"spn-78340","marks":["code"],"text":"errorMessage"},{"id":"spn-78341","text":" (sanitized)"}]}],"id":"blk-51718","kind":"list-item"},{"blocks":[{"id":"blk-51721","kind":"paragraph","spans":[{"id":"spn-78342","text":"timestamps like "},{"id":"spn-78343","marks":["code"],"text":"deployedAtMs"},{"id":"spn-78344","text":" / "},{"id":"spn-78345","marks":["code"],"text":"finishedAtMs"}]}],"id":"blk-51720","kind":"list-item"},{"blocks":[{"id":"blk-51723","kind":"paragraph","spans":[{"id":"spn-78346","text":"optional "},{"id":"spn-78347","marks":["code"],"text":"logsRef"},{"id":"spn-78348","text":" pointer"}]}],"id":"blk-51722","kind":"list-item"},{"blocks":[{"id":"blk-51725","kind":"paragraph","spans":[{"id":"spn-78349","text":"Any new code/artifact/provider configuration change MUST create a new deployment record (never modify an existing deployment to “become” the new version)."}]}],"id":"blk-51724","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51726","kind":"heading","level":3,"spans":[{"id":"spn-78350","text":"2.2 Active deployment pointer"}]},{"id":"blk-51727","kind":"paragraph","spans":[{"id":"spn-78351","text":"Each agent has a single routing pointer:"}]},{"id":"blk-51728","items":[{"blocks":[{"id":"blk-51730","kind":"paragraph","spans":[{"id":"spn-78352","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-78353","text":" points to the deployment that should receive invocations."}]}],"id":"blk-51729","kind":"list-item"},{"blocks":[{"id":"blk-51732","kind":"paragraph","spans":[{"id":"spn-78354","text":"Rollback (and “activate old deployment”) is implemented by updating "},{"id":"spn-78355","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-78356","text":" to a previous deployment id."}]}],"id":"blk-51731","kind":"list-item"},{"blocks":[{"id":"blk-51734","kind":"paragraph","spans":[{"id":"spn-78357","text":"Invocation routing uses ONLY:"}]}],"id":"blk-51733","kind":"list-item"},{"blocks":[{"id":"blk-51736","kind":"paragraph","spans":[{"id":"spn-78358","text":"agent ownership checks + status checks, then"}]}],"id":"blk-51735","kind":"list-item"},{"blocks":[{"id":"blk-51738","kind":"paragraph","spans":[{"id":"spn-78359","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-78360","text":" → "},{"id":"spn-78361","marks":["code"],"text":"deployments.providerRef"},{"id":"spn-78362","text":" and "},{"id":"spn-78363","marks":["code"],"text":"deployments.runtimeProvider"},{"id":"spn-78364","text":" to select runtime adapter and invoke."}]}],"id":"blk-51737","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51739","kind":"heading","level":3,"spans":[{"id":"spn-78365","text":"2.3 Single-writer rule per agent during deploy (v1 simplification)"}]},{"id":"blk-51740","kind":"paragraph","spans":[{"id":"spn-78366","text":"To reduce complexity and prevent version races in v1:"}]},{"id":"blk-51741","items":[{"blocks":[{"id":"blk-51743","kind":"paragraph","spans":[{"id":"spn-78367","text":"The platform MUST prevent concurrent deployments per agent (e.g., guard with "},{"id":"spn-78368","marks":["code"],"text":"agents.status=deploying"},{"id":"spn-78369","text":" or a server-side mutex mechanism)."}]}],"id":"blk-51742","kind":"list-item"},{"blocks":[{"id":"blk-51745","kind":"paragraph","spans":[{"id":"spn-78370","text":"A second deploy attempt while "},{"id":"spn-78371","marks":["code"],"text":"deploying"},{"id":"spn-78372","text":" SHOULD fail with "},{"id":"spn-78373","marks":["code"],"text":"CONFLICT"},{"id":"spn-78374","text":" (or be queued post-v1)."}]}],"id":"blk-51744","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51746","kind":"heading","level":2,"spans":[{"id":"spn-78375","text":"3) Rationale"}]},{"id":"blk-51747","kind":"heading","level":3,"spans":[{"id":"spn-78376","text":"3.1 Safety and correctness"}]},{"id":"blk-51748","kind":"paragraph","spans":[{"id":"spn-78377","text":"Immutability avoids a class of “torn writes” where partial updates leave the system in an inconsistent state. If deployment artifacts and references are immutable, you can always answer:"}]},{"id":"blk-51749","items":[{"blocks":[{"id":"blk-51751","kind":"paragraph","spans":[{"id":"spn-78378","text":"exactly what was deployed,"}]}],"id":"blk-51750","kind":"list-item"},{"blocks":[{"id":"blk-51753","kind":"paragraph","spans":[{"id":"spn-78379","text":"where it was deployed,"}]}],"id":"blk-51752","kind":"list-item"},{"blocks":[{"id":"blk-51755","kind":"paragraph","spans":[{"id":"spn-78380","text":"and when it changed."}]}],"id":"blk-51754","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51756","kind":"heading","level":3,"spans":[{"id":"spn-78381","text":"3.2 Rollbacks become fast and reliable"}]},{"id":"blk-51757","kind":"paragraph","spans":[{"id":"spn-78382","text":"With immutable deployments, rollback is primarily a pointer change:"}]},{"id":"blk-51758","items":[{"blocks":[{"id":"blk-51760","kind":"paragraph","spans":[{"id":"spn-78383","text":"no redeploy required (unless provider forces it for technical reasons),"}]}],"id":"blk-51759","kind":"list-item"},{"blocks":[{"id":"blk-51762","kind":"paragraph","spans":[{"id":"spn-78384","text":"quick recovery from bad deploys,"}]}],"id":"blk-51761","kind":"list-item"},{"blocks":[{"id":"blk-51764","kind":"paragraph","spans":[{"id":"spn-78385","text":"repeatable and auditable."}]}],"id":"blk-51763","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51765","kind":"heading","level":3,"spans":[{"id":"spn-78386","text":"3.3 Auditing and supportability"}]},{"id":"blk-51766","kind":"paragraph","spans":[{"id":"spn-78387","text":"A permanent deployment history supports:"}]},{"id":"blk-51767","items":[{"blocks":[{"id":"blk-51769","kind":"paragraph","spans":[{"id":"spn-78388","text":"customer support (“what changed?”),"}]}],"id":"blk-51768","kind":"list-item"},{"blocks":[{"id":"blk-51771","kind":"paragraph","spans":[{"id":"spn-78389","text":"incident response (“who activated what?”),"}]}],"id":"blk-51770","kind":"list-item"},{"blocks":[{"id":"blk-51773","kind":"paragraph","spans":[{"id":"spn-78390","text":"compliance-aligned audits."}]}],"id":"blk-51772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51774","kind":"heading","level":3,"spans":[{"id":"spn-78391","text":"3.4 Metering attribution and future cost reconciliation"}]},{"id":"blk-51775","kind":"paragraph","spans":[{"id":"spn-78392","text":"When telemetry references a "},{"id":"spn-78393","marks":["code"],"text":"deploymentId"},{"id":"spn-78394","text":" and deployments are immutable, usage can always be attributed to an exact version and provider resource set. This also enables future provider cost reconciliation by tagging provider resources per deployment."}]},{"id":"blk-51776","kind":"heading","level":3,"spans":[{"id":"spn-78395","text":"3.5 Multi-runtime routing simplicity"}]},{"id":"blk-51777","kind":"paragraph","spans":[{"id":"spn-78396","text":"A single "},{"id":"spn-78397","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-78398","text":" model works uniformly across providers:"}]},{"id":"blk-51778","items":[{"blocks":[{"id":"blk-51780","kind":"paragraph","spans":[{"id":"spn-78399","text":"Cloudflare: "},{"id":"spn-78400","marks":["code"],"text":"providerRef.cloudflare.workerUrl"},{"id":"spn-78401","text":" etc."}]}],"id":"blk-51779","kind":"list-item"},{"blocks":[{"id":"blk-51782","kind":"paragraph","spans":[{"id":"spn-78402","text":"AgentCore: "},{"id":"spn-78403","marks":["code"],"text":"providerRef.agentcore.agentRuntimeArn"},{"id":"spn-78404","text":" etc."}]}],"id":"blk-51781","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51783","kind":"paragraph","spans":[{"id":"spn-78405","text":"The control plane remains provider-agnostic; provider-specific details are confined to adapter implementations."}]},{"id":"blk-51784","kind":"heading","level":2,"spans":[{"id":"spn-78406","text":"4) Alternatives considered"}]},{"id":"blk-51785","kind":"heading","level":3,"spans":[{"id":"spn-78407","text":"A) Mutable deployment state stored on the agent row only"}]},{"id":"blk-51786","kind":"paragraph","spans":[{"id":"spn-78408","marks":["bold"],"text":"Pros"}]},{"id":"blk-51787","items":[{"blocks":[{"id":"blk-51789","kind":"paragraph","spans":[{"id":"spn-78409","text":"Minimal schema."}]}],"id":"blk-51788","kind":"list-item"},{"blocks":[{"id":"blk-51791","kind":"paragraph","spans":[{"id":"spn-78410","text":"Simplifies “what’s currently active” (single record)."}]}],"id":"blk-51790","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51792","kind":"paragraph","spans":[{"id":"spn-78411","marks":["bold"],"text":"Cons"}]},{"id":"blk-51793","items":[{"blocks":[{"id":"blk-51795","kind":"paragraph","spans":[{"id":"spn-78412","text":"Loses history."}]}],"id":"blk-51794","kind":"list-item"},{"blocks":[{"id":"blk-51797","kind":"paragraph","spans":[{"id":"spn-78413","text":"Hard to rollback."}]}],"id":"blk-51796","kind":"list-item"},{"blocks":[{"id":"blk-51799","kind":"paragraph","spans":[{"id":"spn-78414","text":"Partial failures can corrupt the running pointer."}]}],"id":"blk-51798","kind":"list-item"},{"blocks":[{"id":"blk-51801","kind":"paragraph","spans":[{"id":"spn-78415","text":"Difficult to audit and debug."}]}],"id":"blk-51800","kind":"list-item"},{"blocks":[{"id":"blk-51803","kind":"paragraph","spans":[{"id":"spn-78416","text":"Makes telemetry attribution ambiguous when “current deployment” changes."}]}],"id":"blk-51802","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51804","kind":"paragraph","spans":[{"id":"spn-78417","marks":["bold"],"text":"Decision:"},{"id":"spn-78418","text":" Rejected."}]},{"id":"blk-51805","kind":"heading","level":3,"spans":[{"id":"spn-78419","text":"B) Immutable deployments without an active pointer (derive “active” from latest successful deploy)"}]},{"id":"blk-51806","kind":"paragraph","spans":[{"id":"spn-78420","marks":["bold"],"text":"Pros"}]},{"id":"blk-51807","items":[{"blocks":[{"id":"blk-51809","kind":"paragraph","spans":[{"id":"spn-78421","text":"No pointer updates; “active” is last successful deployment."}]}],"id":"blk-51808","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51810","kind":"paragraph","spans":[{"id":"spn-78422","marks":["bold"],"text":"Cons"}]},{"id":"blk-51811","items":[{"blocks":[{"id":"blk-51813","kind":"paragraph","spans":[{"id":"spn-78423","text":"Rollback becomes non-trivial (must “fake” a new deploy or add flags)."}]}],"id":"blk-51812","kind":"list-item"},{"blocks":[{"id":"blk-51815","kind":"paragraph","spans":[{"id":"spn-78424","text":"“Latest” is not always what you want running (e.g., canary, manual pinning)."}]}],"id":"blk-51814","kind":"list-item"},{"blocks":[{"id":"blk-51817","kind":"paragraph","spans":[{"id":"spn-78425","text":"In-flight deploys complicate “latest success” semantics."}]}],"id":"blk-51816","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51818","kind":"paragraph","spans":[{"id":"spn-78426","marks":["bold"],"text":"Decision:"},{"id":"spn-78427","text":" Rejected."}]},{"id":"blk-51819","kind":"heading","level":3,"spans":[{"id":"spn-78428","text":"C) Mutable “active deployment” record plus separate immutable history"}]},{"id":"blk-51820","kind":"paragraph","spans":[{"id":"spn-78429","marks":["bold"],"text":"Pros"}]},{"id":"blk-51821","items":[{"blocks":[{"id":"blk-51823","kind":"paragraph","spans":[{"id":"spn-78430","text":"A dedicated active record could simplify reads."}]}],"id":"blk-51822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51824","kind":"paragraph","spans":[{"id":"spn-78431","marks":["bold"],"text":"Cons"}]},{"id":"blk-51825","items":[{"blocks":[{"id":"blk-51827","kind":"paragraph","spans":[{"id":"spn-78432","text":"You now have two sources of truth to keep consistent."}]}],"id":"blk-51826","kind":"list-item"},{"blocks":[{"id":"blk-51829","kind":"paragraph","spans":[{"id":"spn-78433","text":"Reintroduces mutability issues for the “active” record."}]}],"id":"blk-51828","kind":"list-item"},{"blocks":[{"id":"blk-51831","kind":"paragraph","spans":[{"id":"spn-78434","text":"Added complexity with limited benefit over a pointer."}]}],"id":"blk-51830","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51832","kind":"paragraph","spans":[{"id":"spn-78435","marks":["bold"],"text":"Decision:"},{"id":"spn-78436","text":" Rejected."}]},{"id":"blk-51833","kind":"heading","level":3,"spans":[{"id":"spn-78437","text":"D) Blue/green or canary routing model as default"}]},{"id":"blk-51834","kind":"paragraph","spans":[{"id":"spn-78438","marks":["bold"],"text":"Pros"}]},{"id":"blk-51835","items":[{"blocks":[{"id":"blk-51837","kind":"paragraph","spans":[{"id":"spn-78439","text":"Advanced rollout safety."}]}],"id":"blk-51836","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51838","kind":"paragraph","spans":[{"id":"spn-78440","marks":["bold"],"text":"Cons"}]},{"id":"blk-51839","items":[{"blocks":[{"id":"blk-51841","kind":"paragraph","spans":[{"id":"spn-78441","text":"Too complex for v1."}]}],"id":"blk-51840","kind":"list-item"},{"blocks":[{"id":"blk-51843","kind":"paragraph","spans":[{"id":"spn-78442","text":"Requires traffic splitting, per-request routing policies, and richer metrics gating."}]}],"id":"blk-51842","kind":"list-item"},{"blocks":[{"id":"blk-51845","kind":"paragraph","spans":[{"id":"spn-78443","text":"Still requires immutable deployments underneath."}]}],"id":"blk-51844","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51846","kind":"paragraph","spans":[{"id":"spn-78444","marks":["bold"],"text":"Decision:"},{"id":"spn-78445","text":" Deferred to post-v1; can be built on top of this ADR."}]},{"id":"blk-51847","kind":"heading","level":2,"spans":[{"id":"spn-78446","text":"5) Consequences"}]},{"id":"blk-51848","kind":"heading","level":3,"spans":[{"id":"spn-78447","text":"5.1 Positive consequences"}]},{"id":"blk-51849","items":[{"blocks":[{"id":"blk-51851","kind":"paragraph","spans":[{"id":"spn-78448","text":"Reliable rollback (pointer flip)."}]}],"id":"blk-51850","kind":"list-item"},{"blocks":[{"id":"blk-51853","kind":"paragraph","spans":[{"id":"spn-78449","text":"Clear deployment audit trail."}]}],"id":"blk-51852","kind":"list-item"},{"blocks":[{"id":"blk-51855","kind":"paragraph","spans":[{"id":"spn-78450","text":"Strong basis for incident response and debugging."}]}],"id":"blk-51854","kind":"list-item"},{"blocks":[{"id":"blk-51857","kind":"paragraph","spans":[{"id":"spn-78451","text":"Simplified multi-runtime invocation routing."}]}],"id":"blk-51856","kind":"list-item"},{"blocks":[{"id":"blk-51859","kind":"paragraph","spans":[{"id":"spn-78452","text":"Enables deterministic telemetry attribution and later cost reconciliation."}]}],"id":"blk-51858","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51860","kind":"heading","level":3,"spans":[{"id":"spn-78453","text":"5.2 Negative consequences / tradeoffs"}]},{"id":"blk-51861","items":[{"blocks":[{"id":"blk-51863","kind":"paragraph","spans":[{"id":"spn-78454","text":"More schema and records (deployments grow over time)."}]}],"id":"blk-51862","kind":"list-item"},{"blocks":[{"id":"blk-51865","kind":"paragraph","spans":[{"id":"spn-78455","text":"Requires retention policy decisions for old deployments (storage cleanup, provider resource deprovisioning)."}]}],"id":"blk-51864","kind":"list-item"},{"blocks":[{"id":"blk-51867","kind":"paragraph","spans":[{"id":"spn-78456","text":"Requires careful handling of “deploy succeeded but DB update failed” and vice versa."}]}],"id":"blk-51866","kind":"list-item"},{"blocks":[{"id":"blk-51869","kind":"paragraph","spans":[{"id":"spn-78457","text":"Requires a versioning strategy (monotonic per agent) and concurrency controls."}]}],"id":"blk-51868","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51870","kind":"heading","level":2,"spans":[{"id":"spn-78458","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-51871","kind":"heading","level":3,"spans":[{"id":"spn-78459","text":"6.1 Data model requirements"}]},{"id":"blk-51872","kind":"paragraph","spans":[{"id":"spn-78460","text":"The following fields/semantics MUST exist (names may vary if consistent):"}]},{"id":"blk-51873","items":[{"blocks":[{"id":"blk-51875","kind":"paragraph","spans":[{"id":"spn-78461","marks":["code"],"text":"deployments"},{"id":"spn-78462","text":" table with:"}]}],"id":"blk-51874","kind":"list-item"},{"blocks":[{"id":"blk-51877","kind":"paragraph","spans":[{"id":"spn-78463","marks":["code"],"text":"agentId"},{"id":"spn-78464","text":", "},{"id":"spn-78465","marks":["code"],"text":"userId"}]}],"id":"blk-51876","kind":"list-item"},{"blocks":[{"id":"blk-51879","kind":"paragraph","spans":[{"id":"spn-78466","marks":["code"],"text":"version"},{"id":"spn-78467","text":" (monotonic per agent)"}]}],"id":"blk-51878","kind":"list-item"},{"blocks":[{"id":"blk-51881","kind":"paragraph","spans":[{"id":"spn-78468","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-51880","kind":"list-item"},{"blocks":[{"id":"blk-51883","kind":"paragraph","spans":[{"id":"spn-78469","marks":["code"],"text":"artifact"},{"id":"spn-78470","text":" reference (uploaded bundle or repo ref)"}]}],"id":"blk-51