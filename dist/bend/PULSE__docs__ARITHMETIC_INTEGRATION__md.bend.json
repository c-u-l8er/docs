s"}]},{"id":"blk-23146","kind":"paragraph","spans":[{"id":"spn-23977","marks":["code"],"text":"schemas/pulse-loop-manifest.v0.1.json"},{"id":"spn-23978","text":" lines 180–191 declare seven boolean invariants. Each is the manifest-level assertion of a box-and-box "},{"id":"spn-23979","marks":["bold"],"text":"alethic Value"},{"id":"spn-23980","text":" invariant family:"}]},{"head":[{"id":"blk-23148","spans":[{"id":"spn-23981","text":"PULSE invariant"}]},{"id":"blk-23149","spans":[{"id":"spn-23982","text":"box-and-box Value family"}]},{"id":"blk-23150","spans":[{"id":"spn-23983","text":"Meaning"}]}],"id":"blk-23147","kind":"table","rows":[[{"id":"blk-23151","spans":[{"id":"spn-23984","marks":["code"],"text":"phase_atomicity"}]},{"id":"blk-23152","spans":[{"id":"spn-23985","marks":["bold"],"text":"π"},{"id":"spn-23986","text":" (phase ordering)"}]},{"id":"blk-23153","spans":[{"id":"spn-23987","text":"a phase runs to completion or not at all"}]}],[{"id":"blk-23154","spans":[{"id":"spn-23988","marks":["code"],"text":"kappa_routing"}]},{"id":"blk-23155","spans":[{"id":"spn-23989","marks":["bold"],"text":"κ"},{"id":"spn-23990","text":" (cyclicity)"}]},{"id":"blk-23156","spans":[{"id":"spn-23991","text":"route on the κ invariant (OS-002)"}]}],[{"id":"blk-23157","spans":[{"id":"spn-23992","marks":["code"],"text":"feedback_immutability"}]},{"id":"blk-23158","spans":[{"id":"spn-23993","marks":["bold"],"text":"β"},{"id":"spn-23994","text":" (no-overwrite)"}]},{"id":"blk-23159","spans":[{"id":"spn-23995","text":"recorded feedback is never mutated"}]}],[{"id":"blk-23160","spans":[{"id":"spn-23996","marks":["code"],"text":"append_only_audit"}]},{"id":"blk-23161","spans":[{"id":"spn-23997","marks":["bold"],"text":"σ"},{"id":"spn-23998","text":" (provenance)"}]},{"id":"blk-23162","spans":[{"id":"spn-23999","text":"audit is append-only"}]}],[{"id":"blk-23163","spans":[{"id":"spn-24000","marks":["code"],"text":"outcome_grounding"}]},{"id":"blk-23164","spans":[{"id":"spn-24001","marks":["bold"],"text":"σ"},{"id":"spn-24002","text":" (provenance)"}]},{"id":"blk-23165","spans":[{"id":"spn-24003","text":"every outcome traces to a cause"}]}],[{"id":"blk-23166","spans":[{"id":"spn-24004","marks":["code"],"text":"trace_id_propagation"}]},{"id":"blk-23167","spans":[{"id":"spn-24005","marks":["bold"],"text":"σ"},{"id":"spn-24006","text":" (provenance)"}]},{"id":"blk-23168","spans":[{"id":"spn-24007","text":"trace ids flow across phases"}]}],[{"id":"blk-23169","spans":[{"id":"spn-24008","marks":["code"],"text":"quorum_before_commit"}]},{"id":"blk-23170","spans":[{"id":"spn-24009","marks":["bold"],"text":"deontic obligation"},{"id":"spn-24010","text":" (rung 3)"}]},{"id":"blk-23171","spans":[{"id":"spn-24011","text":"an obligation gate, not an alethic fact"}]}]]},{"id":"blk-23172","kind":"paragraph","spans":[{"id":"spn-24012","marks":["bold"],"text":"Additive wiring (no schema change):"},{"id":"spn-24013","text":" a conformance checker can lift a manifest's "},{"id":"spn-24014","marks":["code"],"text":"invariants"},{"id":"spn-24015","text":" object into a kernel "},{"id":"spn-24016","marks":["code"],"text":"value"},{"id":"spn-24017","text":" and assert the corresponding Value laws ("},{"id":"spn-24018","marks":["code"],"text":"L1–L14"},{"id":"spn-24019","text":"). The manifest stays declarative; the kernel becomes the "},{"id":"spn-24020","marks":["italic"],"text":"executable"},{"id":"spn-24021","text":" checker. "},{"id":"spn-24022","marks":["code"],"text":"quorum_before_commit"},{"id":"spn-24023","text":" is the one invariant that is genuinely "},{"id":"spn-24024","marks":["bold"],"text":"deontic"},{"id":"spn-24025","text":" (an obligation), not alethic — worth noting in the spec so it is enforced via the norm rung, not as a fact."}]},{"id":"blk-23173","kind":"heading","level":3,"spans":[{"id":"spn-24026","text":"2. "},{"id":"spn-24027","marks":["code"],"text":"closure.guarantee"},{"id":"spn-24028","text":" ↔ temporal rung (rung 4)"}]},{"id":"blk-23174",