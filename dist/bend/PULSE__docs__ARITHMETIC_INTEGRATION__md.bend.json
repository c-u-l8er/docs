{"bendscript":"0.1","blocks":[{"id":"blk-23094","kind":"heading","level":1,"spans":[{"id":"spn-23876","text":"PULSE × box-and-box — Arithmetic Integration Review"}]},{"id":"blk-23095","kind":"paragraph","spans":[{"id":"spn-23877","marks":["bold"],"text":"Status:"},{"id":"spn-23878","text":" review (no schema break) · "},{"id":"spn-23879","marks":["bold"],"text":"Kernel:"},{"id":"spn-23880","text":" "},{"id":"spn-23881","marks":["code"],"text":"box-and-box"},{"id":"spn-23882","text":" v0.8.0 (8 rungs, 97 laws) "},{"id":"spn-23883","marks":["bold"],"text":"Scope:"},{"id":"spn-23884","text":" how the PULSE loop-manifest standard (OS-010) relates to the [&] governance kernel, what already aligns, and what additive wiring is available."}]},{"id":"blk-23096","kind":"heading","level":2,"spans":[{"id":"spn-23885","text":"TL;DR"}]},{"id":"blk-23097","kind":"paragraph","spans":[{"id":"spn-23886","text":"PULSE and box-and-box are "},{"id":"spn-23887","marks":["bold"],"text":"orthogonal and complementary"},{"id":"spn-23888","text":". PULSE "},{"id":"spn-23889","marks":["italic"],"text":"sequences a loop over time"},{"id":"spn-23890","text":" (phases, cadence, substrates, cross-loop signals). box-and-box renders a "},{"id":"spn-23891","marks":["bold"],"text":"single-decision verdict"},{"id":"spn-23892","text":" — "},{"id":"spn-23893","marks":["code"],"text":"feasible ▸ permitted ▸ best"},{"id":"spn-23894","text":" over an un-weakenable safety floor. The kernel governs "},{"id":"spn-23895","marks":["italic"],"text":"what is allowed to happen at"},{"id":"spn-23896","text":" a PULSE phase; it is not itself a phase or a set of phases. There is "},{"id":"spn-23897","marks":["bold"],"text":"no 1:1 mapping"},{"id":"spn-23898","text":" between the 8 rungs and the 5 phase kinds — do not introduce one."}]},{"id":"blk-23098","kind":"paragraph","spans":[{"id":"spn-23899","text":"The integration surface is small and entirely additive:"}]},{"id":"blk-23099","items":[{"blocks":[{"id":"blk-23101","kind":"paragraph","spans":[{"id":"spn-23900","text":"PULSE's 7 boolean "},{"id":"spn-23901","marks":["code"],"text":"invariants"},{"id":"spn-23902","text":" are the manifest-level shadow of the kernel's alethic"}]}],"id":"blk-23100","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-23102","kind":"paragraph","spans":[{"id":"spn-23903","marks":["bold"],"text":"Value families"},{"id":"spn-23904","text":". They can be "},{"id":"spn-23905","marks":["italic"],"text":"checked"},{"id":"spn-23906","text":" by the kernel but the schema needs no change."}]},{"id":"blk-23103","items":[{"blocks":[{"id":"blk-23105","kind":"paragraph","spans":[{"id":"spn-23907","marks":["code"],"text":"closure.guarantee"},{"id":"spn-23908","text":" is already an LTL fragment — it lines up with the kernel's"}]}],"id":"blk-23104","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-23106","kind":"paragraph","spans":[{"id":"spn-23909","marks":["bold"],"text":"temporal"},{"id":"spn-23910","text":" rung (rung 4) operators."}]},{"id":"blk-23107","items":[{"blocks":[{"id":"blk-23109","kind":"paragraph","spans":[{"id":"spn-23911","text":"PULSE V0.2's proposed linear/affine token typing is the kernel's "},{"id":"spn-23912","marks":["bold"],"text":"resource"},{"id":"spn-23913","text":" rung"}]}],"id":"blk-23108","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-23110","kind":"paragraph","spans":[{"id":"spn-23914","text":"(rung 8, the affine ledger) viewed at the manifest layer."}]},{"id":"blk-23111","items":[{"blocks":[{"id":"blk-23113","kind":"paragraph","spans":[{"id":"spn-23915","text":"A loop "},{"id":"spn-23916","marks":["italic"],"text":"may"},{"id":"spn-23917","text":" declare a phase whose body is \"run the kernel verdict\" — but PULSE does not"}]}],"id":"blk-23112","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-23114","kind":"paragraph","spans":[{"id":"spn-23918","text":"need a new phase "},{"id":"spn-23919","marks":["code"],"text":"kind"},{"id":"spn-23920","text":" to express this; it is an ordinary "},{"id":"spn-23921","marks":["code"],"text":"act"},{"id":"spn-23922","text":"/"},{"id":"spn-23923","marks":["code"],"text":"route"},{"id":"spn-23924","text":" phase."}]},{"id":"blk-23115","kind":"heading","level":2,"spans":[{"id":"spn-23925","text":"Rung-by-rung alignment"}]},{"head":[{"id":"blk-23117","spans":[{"id":"spn-23926","text":"Kernel rung"}]},{"id":"blk-23118","spans":[{"id":"spn-23927","text":"PULSE construct that already carries it"}]},{"id":"blk-23119","spans":[{"id":"spn-23928","text":"Already aligned?"}]}],"id":"blk-23116","kind":"table","rows":[[{"id":"blk-23120","spans":[{"id":"spn-23929","text":"1. alethic ("},{"id":"spn-23930","marks":["code"],"text":"value"},{"id":"spn-23931","text":")"}]},{"id":"blk-23121","spans":[{"id":"spn-23932","marks":["code"],"text":"invariants"},{"id":"spn-23933","text":" booleans (π/κ/β/σ families); "},{"id":"spn-23934","marks":["code"],"text":"phase.kind"},{"id":"spn-23935","text":" enumerates what "},{"id":"spn-23936","marks":["italic"],"text":"can"},{"id":"spn-23937","text":" happen"}]},{"id":"blk-23122","spans":[{"id":"spn-23938","text":"✅ at manifest level"}]}],[{"id":"blk-23123","spans":[{"id":"spn-23939","text":"2. axiological ("},{"id":"spn-23940","marks":["code"],"text":"score"},{"id":"spn-23941","text":")"}]},{"id":"blk-23124","spans":[{"id":"spn-23942","text":"— (PULSE does not rank; PRISM does)"}]},{"id":"blk-23125","spans":[{"id":"spn-23943","text":"n/a — lives in PRISM"}]}],[{"id":"blk-23126","spans":[{"id":"spn-23944","text":"3. deontic (norm/govern)"}]},{"id":"blk-23127","spans":[{"id":"spn-23945","marks":["code"],"text":"substrates.policy"},{"id":"spn-23946","text":", "},{"id":"spn-23947","marks":["code"],"text":"substrates.audit"},{"id":"spn-23948","text":"; "},{"id":"spn-23949","marks":["code"],"text":"quorum_before_commit"}]},{"id":"blk-23128","spans":[{"id":"spn-23950","text":"◻ partial — declared, not enforced by 