s"}]},{"id":"blk-22966","kind":"paragraph","spans":[{"id":"spn-23352","marks":["code"],"text":"schemas/pulse-loop-manifest.v0.1.json"},{"id":"spn-23353","text":" lines 180–191 declare seven boolean invariants. Each is the manifest-level assertion of a box-and-box "},{"id":"spn-23354","marks":["bold"],"text":"alethic Value"},{"id":"spn-23355","text":" invariant family:"}]},{"head":[{"id":"blk-22968","spans":[{"id":"spn-23356","text":"PULSE invariant"}]},{"id":"blk-22969","spans":[{"id":"spn-23357","text":"box-and-box Value family"}]},{"id":"blk-22970","spans":[{"id":"spn-23358","text":"Meaning"}]}],"id":"blk-22967","kind":"table","rows":[[{"id":"blk-22971","spans":[{"id":"spn-23359","marks":["code"],"text":"phase_atomicity"}]},{"id":"blk-22972","spans":[{"id":"spn-23360","marks":["bold"],"text":"π"},{"id":"spn-23361","text":" (phase ordering)"}]},{"id":"blk-22973","spans":[{"id":"spn-23362","text":"a phase runs to completion or not at all"}]}],[{"id":"blk-22974","spans":[{"id":"spn-23363","marks":["code"],"text":"kappa_routing"}]},{"id":"blk-22975","spans":[{"id":"spn-23364","marks":["bold"],"text":"κ"},{"id":"spn-23365","text":" (cyclicity)"}]},{"id":"blk-22976","spans":[{"id":"spn-23366","text":"route on the κ invariant (OS-002)"}]}],[{"id":"blk-22977","spans":[{"id":"spn-23367","marks":["code"],"text":"feedback_immutability"}]},{"id":"blk-22978","spans":[{"id":"spn-23368","marks":["bold"],"text":"β"},{"id":"spn-23369","text":" (no-overwrite)"}]},{"id":"blk-22979","spans":[{"id":"spn-23370","text":"recorded feedback is never mutated"}]}],[{"id":"blk-22980","spans":[{"id":"spn-23371","marks":["code"],"text":"append_only_audit"}]},{"id":"blk-22981","spans":[{"id":"spn-23372","marks":["bold"],"text":"σ"},{"id":"spn-23373","text":" (provenance)"}]},{"id":"blk-22982","spans":[{"id":"spn-23374","text":"audit is append-only"}]}],[{"id":"blk-22983","spans":[{"id":"spn-23375","marks":["code"],"text":"outcome_grounding"}]},{"id":"blk-22984","spans":[{"id":"spn-23376","marks":["bold"],"text":"σ"},{"id":"spn-23377","text":" (provenance)"}]},{"id":"blk-22985","spans":[{"id":"spn-23378","text":"every outcome traces to a cause"}]}],[{"id":"blk-22986","spans":[{"id":"spn-23379","marks":["code"],"text":"trace_id_propagation"}]},{"id":"blk-22987","spans":[{"id":"spn-23380","marks":["bold"],"text":"σ"},{"id":"spn-23381","text":" (provenance)"}]},{"id":"blk-22988","spans":[{"id":"spn-23382","text":"trace ids flow across phases"}]}],[{"id":"blk-22989","spans":[{"id":"spn-23383","marks":["code"],"text":"quorum_before_commit"}]},{"id":"blk-22990","spans":[{"id":"spn-23384","marks":["bold"],"text":"deontic obligation"},{"id":"spn-23385","text":" (rung 3)"}]},{"id":"blk-22991","spans":[{"id":"spn-23386","text":"an obligation gate, not an alethic fact"}]}]]},{"id":"blk-22992","kind":"paragraph","spans":[{"id":"spn-23387","marks":["bold"],"text":"Additive wiring (no schema change):"},{"id":"spn-23388","text":" a conformance checker can lift a manifest's "},{"id":"spn-23389","marks":["code"],"text":"invariants"},{"id":"spn-23390","text":" object into a kernel "},{"id":"spn-23391","marks":["code"],"text":"value"},{"id":"spn-23392","text":" and assert the corresponding Value laws ("},{"id":"spn-23393","marks":["code"],"text":"L1–L14"},{"id":"spn-23394","text":"). The manifest stays declarative; the kernel becomes the "},{"id":"spn-23395","marks":["italic"],"text":"executable"},{"id":"spn-23396","text":" checker. "},{"id":"spn-23397","marks":["code"],"text":"quorum_before_commit"},{"id":"spn-23398","text":" is the one invariant that is genuinely "},{"id":"spn-23399","marks":["bold"],"text":"deontic"},{"id":"spn-23400","text":" (an obligation), not alethic — worth noting in the spec so it is enforced via the norm rung, not as a fact."}]},{"id":"blk-22993","kind":"heading","level":3,"spans":[{"id":"spn-23401","text":"2. "},{"id":"spn-23402","marks":["code"],"text":"closure.guarantee"},{"id":"spn-23403","text":" ↔ temporal rung (rung 4)"}]},{"id":"blk-22994",