{"bendscript":"0.1","blocks":[{"id":"blk-22094","kind":"heading","level":1,"spans":[{"id":"spn-21835","text":"PRISM — Protocol for Rating Iterative System Memory"}]},{"id":"blk-22095","kind":"paragraph","spans":[{"id":"spn-21836","marks":["bold"],"text":"OpenSentience Specification OS-009"}]},{"id":"blk-22096","kind":"paragraph","spans":[{"id":"spn-21837","text":"The first self-improving continual learning benchmark for AI agent memory systems."}]},{"id":"blk-22097","kind":"heading","level":2,"spans":[{"id":"spn-21838","text":"Legacy Benchmarks vs PRISM"}]},{"head":[{"id":"blk-22099","spans":[{"id":"spn-21839","text":""}]},{"id":"blk-22100","spans":[{"id":"spn-21840","text":"Legacy (BEAM, LongMemEval, etc.)"}]},{"id":"blk-22101","spans":[{"id":"spn-21841","text":"PRISM"}]}],"id":"blk-22098","kind":"table","rows":[[{"id":"blk-22102","spans":[{"id":"spn-21842","marks":["bold"],"text":"Assessment"}]},{"id":"blk-22103","spans":[{"id":"spn-21843","text":"Synthetic Q&A"}]},{"id":"blk-22104","spans":[{"id":"spn-21844","text":"Observational: agents interact naturally, judges observe transcripts"}]}],[{"id":"blk-22105","spans":[{"id":"spn-21845","marks":["bold"],"text":"Ground truth"}]},{"id":"blk-22106","spans":[{"id":"spn-21846","text":"Author's expected answer"}]},{"id":"blk-22107","spans":[{"id":"spn-21847","text":"Git repos: the code IS the answer"}]}],[{"id":"blk-22108","spans":[{"id":"spn-21848","marks":["bold"],"text":"Learning test"}]},{"id":"blk-22109","spans":[{"id":"spn-21849","text":"Single pass (store→retrieve→score)"}]},{"id":"blk-22110","spans":[{"id":"spn-21850","text":"Closed-loop: scenario sequences measure improvement over time"}]}],[{"id":"blk-22111","spans":[{"id":"spn-21851","marks":["bold"],"text":"Scoring"}]},{"id":"blk-22112","spans":[{"id":"spn-21852","text":"One composite number"}]},{"id":"blk-22113","spans":[{"id":"spn-21853","text":"9 CL dimensions × domain × loop closure rate"}]}],[{"id":"blk-22114","spans":[{"id":"spn-21854","marks":["bold"],"text":"Judging"}]},{"id":"blk-22115","spans":[{"id":"spn-21855","text":"Single LLM judge"}]},{"id":"blk-22116","spans":[{"id":"spn-21856","text":"3 layers: transcripts → dimension judges → meta-judges"}]}],[{"id":"blk-22117","spans":[{"id":"spn-21857","marks":["bold"],"text":"Evolution"}]},{"id":"blk-22118","spans":[{"id":"spn-21858","text":"Static question bank"}]},{"id":"blk-22119","spans":[{"id":"spn-21859","text":"Self-improving: gap analysis evolves scenarios, IRT calibrates difficulty"}]}],[{"id":"blk-22120","spans":[{"id":"spn-21860","marks":["bold"],"text":"Domains"}]},{"id":"blk-22121","spans":[{"id":"spn-21861","text":"Domain-agnostic"}]},{"id":"blk-22122","spans":[{"id":"spn-21862","text":"Tagged by domain for cross-domain comparison"}]}]]},{"id":"blk-22123","kind":"heading","level":2,"spans":[{"id":"spn-21863","text":"The 9 CL Dimensions"}]},{"head":[{"id":"blk-22125","spans":[{"id":"spn-21864","text":"#"}]},{"id":"blk-22126","spans":[{"id":"spn-21865","text":"Dimension"}]},{"id":"blk-22127","spans":[{"id":"spn-21866","text":"Weight"}]}],"id":"blk-22124","kind":"table","rows":[[{"id":"blk-22128","spans":[{"id":"spn-21867","text":"1"}]},{"id":"blk-22129","spans":[{"id":"spn-21868","text":"Stability (Anti-Forgetting)"}]},{"id":"blk-22130","spans":[{"id":"spn-21869","text":"0.20"}]}],[{"id":"blk-22131","spans":[{"id":"spn-21870","text":"2"}]},{"id":"blk-22132","spans":[{"id":"spn-21871","text":"Plasticity (New Acquisition)"}]},{"id":"blk-22133","spans":[{"id":"spn-21872","text":"0.18"}]}],[{"id":"blk-22134","spans":[{"id":"spn-21873","text":"3"}]},{"id":"blk-22135","spans":[{"id":"spn-21874","text":"Knowledge Update (Contradiction)"}]},{"id":"blk-22136","spans":[{"id":"spn-21875","text":"0.15"}]}],[{"id":"blk-22137","spans":[{"id":"spn-21876","text":"4"}]},{"id":"blk-22138","spans":[{"id":"spn-21877","text":"Temporal Reasoning"}]},{"id":"blk-22139","spans":[{"id":"spn-21878","text":"0.12"}]}],[{"id":"blk-22140","spans":[{"id":"spn-21879","text":"5"}]},{"id":"blk-22141","spans":[{"id":"spn-21880","text":"Consolidation (Abstraction)"}]},{"id":"blk-22142","spans":[{"id":"spn-21881","text":"0.10"}]}],[{"id":"blk-22143","spans":[{"id":"spn-21882","text":"6"}]},{"id":"blk-22144","spans":[{"id":"spn-21883","text":"Epistemic Awareness"}]},{"id":"blk-22145","spans":[{"id":"spn-21884","text":"0.08"}]}],[{"id":"blk-22146","spans":[{"id":"spn-21885","text":"7"}]},{"id":"blk-22147","spans":[{"id":"spn-21886","text":"Cross-Domain Transfer"}]},{"id":"blk-22148","spans":[{"id":"spn-21887","text":"0.07"}]}],[{"id":"blk-22149","spans":[{"id":"spn-21888","text":"8"}]},{"id":"blk-22150","spans":[{"id":"spn-21889","text":"Intentional Forgetting"}]},{"id":"blk-22151","spans":[{"id":"spn-21890","text":"0.05"}]}],[{"id":"blk-22152","spans":[{"id":"spn-21891","text":"9"}]},{"id":"blk-22153","spans":[{"id":"spn-21892","text":"Outcome Feedback"}]},{"id":"blk-22154","spans":[{"id":"spn-21893","text":"0.05"}]}]]},{"id":"blk-22155","kind":"heading","level":2,"spans":[{"id":"spn-21894","text":"4-Phase Evaluation Loop"}]},{"id":"blk-22156","kind":"code","language":"text","text":"Phase 1: Compose → Phase 2: Interact → Phase 3: Observe → Phase 4: Reflect\n     ↑                                                          │\n     └────────────────── Scenario Evolution ────────────────────┘"},{"id":"blk-22157","kind":"paragraph","spans":[{"id":"spn-21895","marks":["bold"],"text":"Phase 1: Compose"},{"id":"spn-21896","text":" — Build scenarios from git repo anchors with embedded CL challenges"}]},{"id":"blk-22158","kind":"paragraph","spans":[{"id":"spn-21897","marks":["bold"],"text":"Phase 2: Interact"},{"id":"spn-21898","text":" — User Simulator runs scenarios against memory systems via MCP"}]},{"id":"blk-22159","kind":"paragraph","spans":[{"id":"spn-21899","marks":["bold"],"text":"Phase 3: Observe"},{"id":"spn-21900","text":" — Three-layer judging: transcripts → L2 dimension judges → L3 meta-judges"}]},{"id":"blk-22160","kind":"paragraph","spans":[{"id":"spn-21901","marks":["bold"],"text":"Phase 4: Reflect"},{"id":"spn-21902","text":" — Gap analysis, IRT recalibration, scenario evolution"}]},{"id":"blk-22161","kind":"heading","level":2,"spans":[{"id":"spn-21903","text":"Key Innovations"}]},{"id":"blk-22162","kind":"heading","level":3,"spans":[{"id":"spn-21904","text":"Git-Grounded Anchors"}]},{"id":"blk-22163","kind":"paragraph","spans":[{"id":"spn-21905","text":"Anchor scenarios use real git repositories as ground truth. Walk the commit history, ingest diffs, probe for understanding. The code IS the answer — checkout any commit to verify."}]},{"id":"blk-22164","kind":"heading","level":3,"spans":[{"id":"spn-21906","text":"Closed-Loop Testing"}]},{"id":"blk-22165","kind":"paragraph","spans":[{"id":"spn-21907","text":"Scenario sequences run S1→S2→S3 without resetting memory. Measures whether the system "},{"id":"spn-21908","marks":["italic"],"text":"actually learns"},{"id":"spn-21909","text":" from its own usage. Loop closure rate is a first-class leaderboard metric."}]},{"id":"blk-22166","kind":"heading","level":3,"spans":[{"id":"spn-21910","text":"Three-Layer Judging"}]},{"id":"blk-22167","items":[{"blocks":[{"id":"blk-22169","kind":"paragraph","spans":[{"id":"spn-21911","marks":["bold"],"text":"Layer 1"},{"id":"spn-21912","text":": Raw interaction transcript (observable evidence)"}]}],"id":"blk-22168","kind":"list-item"},{"blocks":[{"id":"blk-22171","kind":"paragraph","spans":[{"id":"spn-21913","marks":["bold"],"text":"Layer 2"},{"id":"spn-21914","text":": Per-dimension judges with structured rubrics"}]}],"id":"blk-22170","kind":"list-item"},{"blocks":[{"id":"blk-22173","kind":"paragraph","spans":[{"id":"spn-21915","marks":["bold"],"text":"Layer 3"},{"id":"spn-21916","text":": Meta-judges that audit L2 (must use different model family)"}]}],"id":"blk-22172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22174","kind":"heading","level":3,"spans":[{"id":"spn-21917","text":"Domain Categories"}]},{"id":"blk-22175","kind":"paragraph","spans":[{"id":"spn-21918","text":"Every scenario tagged by domain (code, medical, business, personal, research, creative, legal, operations). Enables \"Who's best at medical CL?\" comparisons."}]},{"id":"blk-22176","kind":"heading","level":2,"spans":[{"id":"spn-21919","text":"Running locally"}]},{"id":"blk-22177","kind":"paragraph","spans":[{"id":"spn-21920","text":"PRISM ships as a single Elixir/OTP app that runs three things side-by-side in one supervision tree:"}]},{"id":"blk-22178","items":[{"blocks":[{"id":"blk-22180","kind":"paragraph","spans":[{"id":"spn-21921","text":"The "},{"id":"spn-21922","marks":["bold"],"text":"evaluation engine"},{"id":"spn-21923","text":" (compose → interact → observe → reflect → diagnose)"}]}],"id":"blk-22179","kind":"list-item"},{"blocks":[{"id":"blk-22182","kind":"paragraph","spans":[{"id":"spn-21924","text":"The "},{"id":"spn-21925","marks":["bold"],"text":"MCP server"},{"id":"spn-21926","text":" exposing six loop-phase machines over stdio"}]}],"id":"blk-22181","kind":"list-item"},{"blocks":[{"id":"blk-22184","kind":"paragraph","spans":[{"id":"spn-21927","text":"A "},{"id":"spn-21928","marks":["bold"],"text":"Phoenix 1.7 web layer"},{"id":"spn-21929","text":" serving the marketing site at "},{"id":"spn-21930","marks":["code"],"text":"/"},{"id":"spn-21931","text":" and a JSON"}]}],"id":"blk-22183","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22185","kind":"paragraph","spans":[{"id":"spn-21932","text":"leaderboard at "},{"id":"spn-21933","marks":["code"],"text":"/api/leaderboard"}]},{"id":"blk-22186","kind":"heading","level":3,"spans":[{"id":"spn-21934","text":"Prerequisites"}]},{"id":"blk-22187","items":[{"blocks":[{"id":"blk-22189","kind":"paragraph","spans":[{"id":"spn-21935","text":"Elixir 1.17+ / Erlang/OTP 27"}]}],"id":"blk-22188","kind":"list-item"},{"blocks":[{"id":"blk-22191","kind":"paragraph","spans":[{"id":"spn-21936","text":"SQLite (bundled via "},{"id":"spn-21937","marks":["code"],"text":"ecto_sqlite3"},{"id":"spn-21938","text":" — no extra install needed for dev)"}]}],"id":"blk-22190","kind":"list-item"},{"blocks":[{"id":"blk-22193","kind":"paragraph","spans":[{"id":"spn-21939","text":"No Node / esbuild / Tailwind — CSS is hand-written in "},{"id":"spn-21940","marks":["code"],"text":"priv/static/assets/app.css"}]}],"id":"blk-22192","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22194","kind":"heading","level":3,"spans":[{"id":"spn-21941","text":"First-time setup"}]},{"id":"blk-22195","kind":"code","language":"bash","text":"cd PRISM\nmix deps.get\nmix ecto.create\nmix ecto.migrate"},{"id":"blk-22196","kind":"paragraph","spans":[{"id":"spn-21942","text":"The dev database lives at "},{"id":"spn-21943","marks":["code"],"text":"~/.prism/prism_dev.db"},{"id":"spn-21944","text":" (SQLite, WAL mode). Override with "},{"id":"spn-21945","marks":["code"],"text":"config/dev.exs"},{"id":"spn-21946","text":" if you want it elsewhere."}]},{"id":"blk-22197","kind":"heading","level":3,"spans":[{"id":"spn-21947","text":"Start the Phoenix server (site + API + engine, all in one process)"}]},{"id":"blk-22198","kind":"code","language":"bash","text":"mix phx.server"},{"id":"blk-22199","kind":"paragraph","spans":[{"id":"spn-21948","text":"Then open:"}]},{"id":"blk-22200","items":[{"blocks":[{"id":"blk-22202","kind":"paragraph","spans":[{"id":"spn-21949","text":"<http://localhost:4000/> — the marketing site"}]}],"id":"blk-22201","kind":"list-item"},{"blocks":[{"id":"blk-22204","kind":"paragraph","spans":[{"id":"spn-21950","text":"<http://localhost:4000/api/leaderboard> — leaderboard JSON (currently a stub)"}]}],"id":"blk-22203","kind":"list-item"},{"blocks":[{"id":"blk-22206","kind":"paragraph","spans":[{"id":"spn-21951","text":"<http://localhost:4000/api/health> — health check"}]}],"id":"blk-22205","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22207","kind":"paragraph","spans":[{"id":"spn-21952","text":"Live reload is enabled in dev — edits to "},{"id":"spn-21953","marks":["code"],"text":"lib/prism_web/**/*.{ex,heex}"},{"id":"spn-21954","text":" and "},{"id":"spn-21955","marks":["code"],"text":"priv/static/**/*.css"},{"id":"spn-21956","text":" trigger an automatic browser refresh."}]},{"id":"blk-22208","kind":"heading","level":3,"spans":[{"id":"spn-21957","text":"Start without the web layer (headless engine + MCP only)"}]},{"id":"blk-22209","kind":"code","language":"bash","text":"mix run --no-halt"},{"id":"blk-22210","kind":"paragraph","spans":[{"id":"spn-21958","text":"This boots the full supervision tree (including the Phoenix endpoint on 4000) without attaching to the shell for HTTP serving. For a truly headless run that skips the web layer entirely, set "},{"id":"spn-21959","marks":["code"],"text":"PHX_SERVER=0"},{"id":"spn-21960","text":" or comment out "},{"id":"spn-21961","marks":["code"],"text":"PrismWeb.Endpoint"},{"id":"spn-21962","text":" in "},{"id":"spn-21963","marks":["code"],"text":"lib/prism/application.ex"},{"id":"spn-21964","text":"."}]},{"id":"blk-22211","kind":"heading","level":3,"spans":[{"id":"spn-21965","text":"Use as an MCP server from a Claude / Codex / Zed session"}]},{"id":"blk-22212","kind":"paragraph","spans":[{"id":"spn-21966","text":"Add to your "},{"id":"spn-21967","marks":["code"],"text":".mcp.json"},{"id":"spn-21968","text":":"}]},{"id":"blk-22213","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"prism\": { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\", \"--db\", \"~/.os-prism/benchmarks.db\"] }\n  }\n}"},{"id":"blk-22214","kind":"paragraph","spans":[{"id":"spn-21969","text":"Or run directly against the checkout via stdio:"}]},{"id":"blk-22215","kind":"code","language":"bash","text":"mix run --no-halt -e \"Prism.MCP.Stdio.start()\""},{"id":"blk-22216","kind":"heading","level":3,"spans":[{"id":"spn-21970","text":"Tests and format"}]},{"id":"blk-22217","kind":"code","language":"bash","text":"mix test\nmix format --check-formatted"},{"id":"blk-22218","kind":"heading","level":3,"spans":[{"id":"spn-21971","text":"Production release (Fly.io)"}]},{"id":"blk-22219","kind":"paragraph","spans":[{"id":"spn-21972","text":"The "},{"id":"spn-21973","marks":["code"],"text":"Dockerfile"},{"id":"spn-21974","text":" + "},{"id":"spn-21975","marks":["code"],"text":"fly.toml"},{"id":"spn-21976","text":" build a standalone release that serves the site and the engine from the same VM. Before the first deploy, set the Phoenix cookie secret as a Fly secret:"}]},{"id":"blk-22220","kind":"code","language":"bash","text":"fly secrets set SECRET_KEY_BASE=$(mix phx.gen.secret)\nfly deploy"},{"id":"blk-22221","kind":"paragraph","spans":[{"id":"spn-21977","text":"The release listens on "},{"id":"spn-21978","marks":["code"],"text":"PORT=4000"},{"id":"spn-21979","text":" (see "},{"id":"spn-21980","marks":["code"],"text":"fly.toml"},{"id":"spn-21981","text":") and is fronted by Fly's HTTPS proxy at "},{"id":"spn-21982","marks":["code"],"text":"https://prism-eval.fly.dev"},{"id":"spn-21983","text":"."}]},{"id":"blk-22222","kind":"heading","level":2,"spans":[{"id":"spn-21984","text":"Stack"}]},{"id":"blk-22223","items":[{"blocks":[{"id":"blk-22225","kind":"paragraph","spans":[{"id":"spn-21985","marks":["bold"],"text":"Language"},{"id":"spn-21986","text":": Elixir 1.17+ / OTP 27"}]}],"id":"blk-22224","kind":"list-item"},{"blocks":[{"id":"blk-22227","kind":"paragraph","spans":[{"id":"spn-21987","marks":["bold"],"text":"Database"},{"id":"spn-21988","text":": Postgres (server mode via Ecto) · SQLite + sqlite-vec (local "},{"id":"spn-21989","marks":["code"],"text":"os-prism"},{"id":"spn-21990","text":" npm mode)"}]}],"id":"blk-22226","kind":"list-item"},{"blocks":[{"id":"blk-22229","kind":"paragraph","spans":[{"id":"spn-21991","marks":["bold"],"text":"Protocol"},{"id":"spn-21992","text":": MCP exposed as "},{"id":"spn-21993","marks":["bold"],"text":"6 loop-phase machines"},{"id":"spn-21994","text":" — "},{"id":"spn-21995","marks":["code"],"text":"compose"},{"id":"spn-21996","text":", "},{"id":"spn-21997","marks":["code"],"text":"interact"},{"id":"spn-21998","text":", "},{"id":"spn-21999","marks":["code"],"text":"observe"},{"id":"spn-22000","text":", "},{"id":"spn-22001","marks":["code"],"text":"reflect"},{"id":"spn-22002","text":", "},{"id":"spn-22003","marks":["code"],"text":"diagnose"},{"id":"spn-22004","text":", "},{"id":"spn-22005","marks":["code"],"text":"config"},{"id":"spn-22006","text":" — over stdio (local) and SSE/Streamable HTTP (server). Each machine dispatches internally to 5–13 actions (down from 47 individual tools; see "},{"id":"spn-22007","marks":["code"],"text":"docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-22008","text":")."}]}],"id":"blk-22228","kind":"list-item"},{"blocks":[{"id":"blk-22231","kind":"paragraph","spans":[{"id":"spn-22009","marks":["bold"],"text":"LLM"},{"id":"spn-22010","text":": Anthropic Claude, OpenAI GPT-4o, Google Gemini, OpenRouter"}]}],"id":"blk-22230","kind":"list-item"},{"blocks":[{"id":"blk-22233","kind":"paragraph","spans":[{"id":"spn-22011","marks":["bold"],"text":"Deploy"},{"id":"spn-22012","text":": Fly.io (hosted) · "},{"id":"spn-22013","marks":["code"],"text":"npx -y os-prism"},{"id":"spn-22014","text":" (local)"}]}],"id":"blk-22232","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22234","kind":"heading","level":2,"spans":[{"id":"spn-22015","text":"Three-Package MCP Stack"}]},{"id":"blk-22235","kind":"paragraph","spans":[{"id":"spn-22016","text":"PRISM ships as one of three npm-distributed MCP servers that together form the [&] three-protocol stack. All three install identically with "},{"id":"spn-22017","marks":["code"],"text":"npx -y <pkg> --db <path>"},{"id":"spn-22018","text":" and carry their own embedded SQLite + sqlite-vec database:"}]},{"head":[{"id":"blk-22237","spans":[{"id":"spn-22019","text":"Package"}]},{"id":"blk-22238","spans":[{"id":"spn-22020","text":"Role"}]},{"id":"blk-22239","spans":[{"id":"spn-22021","text":"DB path"}]}],"id":"blk-22236","kind":"table","rows":[[{"id":"blk-22240","spans":[{"id":"spn-22022","marks":["code"],"text":"graphonomous"}]},{"id":"blk-22241","spans":[{"id":"spn-22023","text":"Memory loop (5 machines)"}]},{"id":"blk-22242","spans":[{"id":"spn-22024","marks":["code"],"text":"~/.graphonomous/knowledge.db"}]}],[{"id":"blk-22243","spans":[{"id":"spn-22025","marks":["code"],"text":"os-prism"}]},{"id":"blk-22244","spans":[{"id":"spn-22026","text":"Diagnostic loop (6 machines, "},{"id":"spn-22027","marks":["bold"],"text":"this"},{"id":"spn-22028","text":")"}]},{"id":"blk-22245","spans":[{"id":"spn-22029","marks":["code"],"text":"~/.os-prism/benchmarks.db"}]}],[{"id":"blk-22246","spans":[{"id":"spn-22030","marks":["code"],"text":"os-pulse"}]},{"id":"blk-22247","spans":[{"id":"spn-22031","text":"PULSE manifest registry (8 tools)"}]},{"id":"blk-22248","spans":[{"id":"spn-22032","marks":["code"],"text":"~/.os-pulse/manifests.db"}]}]]},{"blocks":[{"id":"blk-22250","kind":"paragraph","spans":[{"id":"spn-22033","text":"The "},{"id":"spn-22034","marks":["code"],"text":"box-and-box"},{"id":"spn-22035","text":" name now belongs to the [&] "},{"id":"spn-22036","marks":["bold"],"text":"governance kernel"},{"id":"spn-22037","text":" (the eight-rung arithmetic ladder · 97 property-tested laws — "},{"id":"spn-22038","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/"},{"id":"spn-22039","text":"), not an MCP server. The old "},{"id":"spn-22040","marks":["code"],"text":"box-and-box"},{"id":"spn-22041","text":" [&] Protocol validator MCP was removed. PRISM's scoring pipeline "},{"id":"spn-22042","marks":["italic"],"text":"is"},{"id":"spn-22043","text":" the kernel's axiological rung at scale — see "},{"id":"spn-22044","marks":[{"kind":"link","predicate":"cites","target":"#/PRISM/docs/ARITHMETIC_INTEGRATION.md"}],"text":"`docs/ARITHMETIC_INTEGRATION.md`"},{"id":"spn-22045","text":"."}]}],"id":"blk-22249","kind":"quote"},{"id":"blk-22251","kind":"paragraph","spans":[{"id":"spn-22046","marks":["code"],"text":".mcp.json"},{"id":"spn-22047","text":" snippet to install all three:"}]},{"id":"blk-22252","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"] },\n    \"prism\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\",     \"--db\", \"~/.os-prism/benchmarks.db\"] },\n    \"pulse\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-pulse\",     \"--db\", \"~/.os-pulse/manifests.db\"] }\n  }\n}"},{"id":"blk-22253","kind":"paragraph","spans":[{"id":"spn-22048","text":"PRISM is "},{"id":"spn-22049","marks":["bold"],"text":"PULSE-evaluable"},{"id":"spn-22050","text":": once a memory system publishes a PULSE manifest, "},{"id":"spn-22051","marks":["code"],"text":"os-prism compose"},{"id":"spn-22052","text":" reads it directly to discover the "},{"id":"spn-22053","marks":["code"],"text":"retrieve"},{"id":"spn-22054","text":" boundary, the "},{"id":"spn-22055","marks":["code"],"text":"learn"},{"id":"spn-22056","text":" phase, and substrate URIs. No bespoke per-system integration is required — see "},{"id":"spn-22057","marks":["code"],"text":"docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-22058","text":" § \"Three-protocol stack at runtime.\""}]},{"id":"blk-22254","kind":"heading","level":2,"spans":[{"id":"spn-22059","text":"Specification"}]},{"id":"blk-22255","kind":"paragraph","spans":[{"id":"spn-22060","text":"Full spec: "},{"id":"spn-22061","marks":[{"kind":"link","predicate":"cites","target":"./OS-009-PRISM-SPECIFICATION.md"}],"text":"OS-009-PRISM-SPECIFICATION.md"}]},{"id":"blk-22256","kind":"heading","level":2,"spans":[{"id":"spn-22062","text":"License"}]},{"id":"blk-22257","kind":"paragraph","spans":[{"id":"spn-22063","text":"Apache 2.0"}]}],"edges":[],"id":"bagaaierah3g5ryexs3cpgwrxljq4kspysdo57w6h7xwa33iu3o5wtzj43xpa","vocabulary":"ampersand.docs.fs.v1"}