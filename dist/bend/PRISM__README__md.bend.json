{"bendscript":"0.1","blocks":[{"id":"blk-22127","kind":"heading","level":1,"spans":[{"id":"spn-21945","text":"PRISM — Protocol for Rating Iterative System Memory"}]},{"id":"blk-22128","kind":"paragraph","spans":[{"id":"spn-21946","marks":["bold"],"text":"OpenSentience Specification OS-009"}]},{"id":"blk-22129","kind":"paragraph","spans":[{"id":"spn-21947","text":"The first self-improving continual learning benchmark for AI agent memory systems."}]},{"id":"blk-22130","kind":"heading","level":2,"spans":[{"id":"spn-21948","text":"Legacy Benchmarks vs PRISM"}]},{"head":[{"id":"blk-22132","spans":[{"id":"spn-21949","text":""}]},{"id":"blk-22133","spans":[{"id":"spn-21950","text":"Legacy (BEAM, LongMemEval, etc.)"}]},{"id":"blk-22134","spans":[{"id":"spn-21951","text":"PRISM"}]}],"id":"blk-22131","kind":"table","rows":[[{"id":"blk-22135","spans":[{"id":"spn-21952","marks":["bold"],"text":"Assessment"}]},{"id":"blk-22136","spans":[{"id":"spn-21953","text":"Synthetic Q&A"}]},{"id":"blk-22137","spans":[{"id":"spn-21954","text":"Observational: agents interact naturally, judges observe transcripts"}]}],[{"id":"blk-22138","spans":[{"id":"spn-21955","marks":["bold"],"text":"Ground truth"}]},{"id":"blk-22139","spans":[{"id":"spn-21956","text":"Author's expected answer"}]},{"id":"blk-22140","spans":[{"id":"spn-21957","text":"Git repos: the code IS the answer"}]}],[{"id":"blk-22141","spans":[{"id":"spn-21958","marks":["bold"],"text":"Learning test"}]},{"id":"blk-22142","spans":[{"id":"spn-21959","text":"Single pass (store→retrieve→score)"}]},{"id":"blk-22143","spans":[{"id":"spn-21960","text":"Closed-loop: scenario sequences measure improvement over time"}]}],[{"id":"blk-22144","spans":[{"id":"spn-21961","marks":["bold"],"text":"Scoring"}]},{"id":"blk-22145","spans":[{"id":"spn-21962","text":"One composite number"}]},{"id":"blk-22146","spans":[{"id":"spn-21963","text":"9 CL dimensions × domain × loop closure rate"}]}],[{"id":"blk-22147","spans":[{"id":"spn-21964","marks":["bold"],"text":"Judging"}]},{"id":"blk-22148","spans":[{"id":"spn-21965","text":"Single LLM judge"}]},{"id":"blk-22149","spans":[{"id":"spn-21966","text":"3 layers: transcripts → dimension judges → meta-judges"}]}],[{"id":"blk-22150","spans":[{"id":"spn-21967","marks":["bold"],"text":"Evolution"}]},{"id":"blk-22151","spans":[{"id":"spn-21968","text":"Static question bank"}]},{"id":"blk-22152","spans":[{"id":"spn-21969","text":"Self-improving: gap analysis evolves scenarios, IRT calibrates difficulty"}]}],[{"id":"blk-22153","spans":[{"id":"spn-21970","marks":["bold"],"text":"Domains"}]},{"id":"blk-22154","spans":[{"id":"spn-21971","text":"Domain-agnostic"}]},{"id":"blk-22155","spans":[{"id":"spn-21972","text":"Tagged by domain for cross-domain comparison"}]}]]},{"id":"blk-22156","kind":"heading","level":2,"spans":[{"id":"spn-21973","text":"The 9 CL Dimensions"}]},{"head":[{"id":"blk-22158","spans":[{"id":"spn-21974","text":"#"}]},{"id":"blk-22159","spans":[{"id":"spn-21975","text":"Dimension"}]},{"id":"blk-22160","spans":[{"id":"spn-21976","text":"Weight"}]}],"id":"blk-22157","kind":"table","rows":[[{"id":"blk-22161","spans":[{"id":"spn-21977","text":"1"}]},{"id":"blk-22162","spans":[{"id":"spn-21978","text":"Stability (Anti-Forgetting)"}]},{"id":"blk-22163","spans":[{"id":"spn-21979","text":"0.20"}]}],[{"id":"blk-22164","spans":[{"id":"spn-21980","text":"2"}]},{"id":"blk-22165","spans":[{"id":"spn-21981","text":"Plasticity (New Acquisition)"}]},{"id":"blk-22166","spans":[{"id":"spn-21982","text":"0.18"}]}],[{"id":"blk-22167","spans":[{"id":"spn-21983","text":"3"}]},{"id":"blk-22168","spans":[{"id":"spn-21984","text":"Knowledge Update (Contradiction)"}]},{"id":"blk-22169","spans":[{"id":"spn-21985","text":"0.15"}]}],[{"id":"blk-22170","spans":[{"id":"spn-21986","text":"4"}]},{"id":"blk-22171","spans":[{"id":"spn-21987","text":"Temporal Reasoning"}]},{"id":"blk-22172","spans":[{"id":"spn-21988","text":"0.12"}]}],[{"id":"blk-22173","spans":[{"id":"spn-21989","text":"5"}]},{"id":"blk-22174","spans":[{"id":"spn-21990","text":"Consolidation (Abstraction)"}]},{"id":"blk-22175","spans":[{"id":"spn-21991","text":"0.10"}]}],[{"id":"blk-22176","spans":[{"id":"spn-21992","text":"6"}]},{"id":"blk-22177","spans":[{"id":"spn-21993","text":"Epistemic Awareness"}]},{"id":"blk-22178","spans":[{"id":"spn-21994","text":"0.08"}]}],[{"id":"blk-22179","spans":[{"id":"spn-21995","text":"7"}]},{"id":"blk-22180","spans":[{"id":"spn-21996","text":"Cross-Domain Transfer"}]},{"id":"blk-22181","spans":[{"id":"spn-21997","text":"0.07"}]}],[{"id":"blk-22182","spans":[{"id":"spn-21998","text":"8"}]},{"id":"blk-22183","spans":[{"id":"spn-21999","text":"Intentional Forgetting"}]},{"id":"blk-22184","spans":[{"id":"spn-22000","text":"0.05"}]}],[{"id":"blk-22185","spans":[{"id":"spn-22001","text":"9"}]},{"id":"blk-22186","spans":[{"id":"spn-22002","text":"Outcome Feedback"}]},{"id":"blk-22187","spans":[{"id":"spn-22003","text":"0.05"}]}]]},{"id":"blk-22188","kind":"heading","level":2,"spans":[{"id":"spn-22004","text":"4-Phase Evaluation Loop"}]},{"id":"blk-22189","kind":"code","language":"text","text":"Phase 1: Compose → Phase 2: Interact → Phase 3: Observe → Phase 4: Reflect\n     ↑                                                          │\n     └────────────────── Scenario Evolution ────────────────────┘"},{"id":"blk-22190","kind":"paragraph","spans":[{"id":"spn-22005","marks":["bold"],"text":"Phase 1: Compose"},{"id":"spn-22006","text":" — Build scenarios from git repo anchors with embedded CL challenges"}]},{"id":"blk-22191","kind":"paragraph","spans":[{"id":"spn-22007","marks":["bold"],"text":"Phase 2: Interact"},{"id":"spn-22008","text":" — User Simulator runs scenarios against memory systems via MCP"}]},{"id":"blk-22192","kind":"paragraph","spans":[{"id":"spn-22009","marks":["bold"],"text":"Phase 3: Observe"},{"id":"spn-22010","text":" — Three-layer judging: transcripts → L2 dimension judges → L3 meta-judges"}]},{"id":"blk-22193","kind":"paragraph","spans":[{"id":"spn-22011","marks":["bold"],"text":"Phase 4: Reflect"},{"id":"spn-22012","text":" — Gap analysis, IRT recalibration, scenario evolution"}]},{"id":"blk-22194","kind":"heading","level":2,"spans":[{"id":"spn-22013","text":"Key Innovations"}]},{"id":"blk-22195","kind":"heading","level":3,"spans":[{"id":"spn-22014","text":"Git-Grounded Anchors"}]},{"id":"blk-22196","kind":"paragraph","spans":[{"id":"spn-22015","text":"Anchor scenarios use real git repositories as ground truth. Walk the commit history, ingest diffs, probe for understanding. The code IS the answer — checkout any commit to verify."}]},{"id":"blk-22197","kind":"heading","level":3,"spans":[{"id":"spn-22016","text":"Closed-Loop Testing"}]},{"id":"blk-22198","kind":"paragraph","spans":[{"id":"spn-22017","text":"Scenario sequences run S1→S2→S3 without resetting memory. Measures whether the system "},{"id":"spn-22018","marks":["italic"],"text":"actually learns"},{"id":"spn-22019","text":" from its own usage. Loop closure rate is a first-class leaderboard metric."}]},{"id":"blk-22199","kind":"heading","level":3,"spans":[{"id":"spn-22020","text":"Three-Layer Judging"}]},{"id":"blk-22200","items":[{"blocks":[{"id":"blk-22202","kind":"paragraph","spans":[{"id":"spn-22021","marks":["bold"],"text":"Layer 1"},{"id":"spn-22022","text":": Raw interaction transcript (observable evidence)"}]}],"id":"blk-22201","kind":"list-item"},{"blocks":[{"id":"blk-22204","kind":"paragraph","spans":[{"id":"spn-22023","marks":["bold"],"text":"Layer 2"},{"id":"spn-22024","text":": Per-dimension judges with structured rubrics"}]}],"id":"blk-22203","kind":"list-item"},{"blocks":[{"id":"blk-22206","kind":"paragraph","spans":[{"id":"spn-22025","marks":["bold"],"text":"Layer 3"},{"id":"spn-22026","text":": Meta-judges that audit L2 (must use different model family)"}]}],"id":"blk-22205","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22207","kind":"heading","level":3,"spans":[{"id":"spn-22027","text":"Domain Categories"}]},{"id":"blk-22208","kind":"paragraph","spans":[{"id":"spn-22028","text":"Every scenario tagged by domain (code, medical, business, personal, research, creative, legal, operations). Enables \"Who's best at medical CL?\" comparisons."}]},{"id":"blk-22209","kind":"heading","level":2,"spans":[{"id":"spn-22029","text":"Running locally"}]},{"id":"blk-22210","kind":"paragraph","spans":[{"id":"spn-22030","text":"PRISM ships as a single Elixir/OTP app that runs three things side-by-side in one supervision tree:"}]},{"id":"blk-22211","items":[{"blocks":[{"id":"blk-22213","kind":"paragraph","spans":[{"id":"spn-22031","text":"The "},{"id":"spn-22032","marks":["bold"],"text":"evaluation engine"},{"id":"spn-22033","text":" (compose → interact → observe → reflect → diagnose)"}]}],"id":"blk-22212","kind":"list-item"},{"blocks":[{"id":"blk-22215","kind":"paragraph","spans":[{"id":"spn-22034","text":"The "},{"id":"spn-22035","marks":["bold"],"text":"MCP server"},{"id":"spn-22036","text":" exposing six loop-phase machines over stdio"}]}],"id":"blk-22214","kind":"list-item"},{"blocks":[{"id":"blk-22217","kind":"paragraph","spans":[{"id":"spn-22037","text":"A "},{"id":"spn-22038","marks":["bold"],"text":"Phoenix 1.7 web layer"},{"id":"spn-22039","text":" serving the marketing site at "},{"id":"spn-22040","marks":["code"],"text":"/"},{"id":"spn-22041","text":" and a JSON"}]}],"id":"blk-22216","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22218","kind":"paragraph","spans":[{"id":"spn-22042","text":"leaderboard at "},{"id":"spn-22043","marks":["code"],"text":"/api/leaderboard"}]},{"id":"blk-22219","kind":"heading","level":3,"spans":[{"id":"spn-22044","text":"Prerequisites"}]},{"id":"blk-22220","items":[{"blocks":[{"id":"blk-22222","kind":"paragraph","spans":[{"id":"spn-22045","text":"Elixir 1.17+ / Erlang/OTP 27"}]}],"id":"blk-22221","kind":"list-item"},{"blocks":[{"id":"blk-22224","kind":"paragraph","spans":[{"id":"spn-22046","text":"SQLite (bundled via "},{"id":"spn-22047","marks":["code"],"text":"ecto_sqlite3"},{"id":"spn-22048","text":" — no extra install needed for dev)"}]}],"id":"blk-22223","kind":"list-item"},{"blocks":[{"id":"blk-22226","kind":"paragraph","spans":[{"id":"spn-22049","text":"No Node / esbuild / Tailwind — CSS is hand-written in "},{"id":"spn-22050","marks":["code"],"text":"priv/static/assets/app.css"}]}],"id":"blk-22225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22227","kind":"heading","level":3,"spans":[{"id":"spn-22051","text":"First-time setup"}]},{"id":"blk-22228","kind":"code","language":"bash","text":"cd PRISM\nmix deps.get\nmix ecto.create\nmix ecto.migrate"},{"id":"blk-22229","kind":"paragraph","spans":[{"id":"spn-22052","text":"The dev database lives at "},{"id":"spn-22053","marks":["code"],"text":"~/.prism/prism_dev.db"},{"id":"spn-22054","text":" (SQLite, WAL mode). Override with "},{"id":"spn-22055","marks":["code"],"text":"config/dev.exs"},{"id":"spn-22056","text":" if you want it elsewhere."}]},{"id":"blk-22230","kind":"heading","level":3,"spans":[{"id":"spn-22057","text":"Start the Phoenix server (site + API + engine, all in one process)"}]},{"id":"blk-22231","kind":"code","language":"bash","text":"mix phx.server"},{"id":"blk-22232","kind":"paragraph","spans":[{"id":"spn-22058","text":"Then open:"}]},{"id":"blk-22233","items":[{"blocks":[{"id":"blk-22235","kind":"paragraph","spans":[{"id":"spn-22059","text":"<http://localhost:4000/> — the marketing site"}]}],"id":"blk-22234","kind":"list-item"},{"blocks":[{"id":"blk-22237","kind":"paragraph","spans":[{"id":"spn-22060","text":"<http://localhost:4000/api/leaderboard> — leaderboard JSON (currently a stub)"}]}],"id":"blk-22236","kind":"list-item"},{"blocks":[{"id":"blk-22239","kind":"paragraph","spans":[{"id":"spn-22061","text":"<http://localhost:4000/api/health> — health check"}]}],"id":"blk-22238","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22240","kind":"paragraph","spans":[{"id":"spn-22062","text":"Live reload is enabled in dev — edits to "},{"id":"spn-22063","marks":["code"],"text":"lib/prism_web/**/*.{ex,heex}"},{"id":"spn-22064","text":" and "},{"id":"spn-22065","marks":["code"],"text":"priv/static/**/*.css"},{"id":"spn-22066","text":" trigger an automatic browser refresh."}]},{"id":"blk-22241","kind":"heading","level":3,"spans":[{"id":"spn-22067","text":"Start without the web layer (headless engine + MCP only)"}]},{"id":"blk-22242","kind":"code","language":"bash","text":"mix run --no-halt"},{"id":"blk-22243","kind":"paragraph","spans":[{"id":"spn-22068","text":"This boots the full supervision tree (including the Phoenix endpoint on 4000) without attaching to the shell for HTTP serving. For a truly headless run that skips the web layer entirely, set "},{"id":"spn-22069","marks":["code"],"text":"PHX_SERVER=0"},{"id":"spn-22070","text":" or comment out "},{"id":"spn-22071","marks":["code"],"text":"PrismWeb.Endpoint"},{"id":"spn-22072","text":" in "},{"id":"spn-22073","marks":["code"],"text":"lib/prism/application.ex"},{"id":"spn-22074","text":"."}]},{"id":"blk-22244","kind":"heading","level":3,"spans":[{"id":"spn-22075","text":"Use as an MCP server from a Claude / Codex / Zed session"}]},{"id":"blk-22245","kind":"paragraph","spans":[{"id":"spn-22076","text":"Add to your "},{"id":"spn-22077","marks":["code"],"text":".mcp.json"},{"id":"spn-22078","text":":"}]},{"id":"blk-22246","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"prism\": { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\", \"--db\", \"~/.os-prism/benchmarks.db\"] }\n  }\n}"},{"id":"blk-22247","kind":"paragraph","spans":[{"id":"spn-22079","text":"Or run directly against the checkout via stdio:"}]},{"id":"blk-22248","kind":"code","language":"bash","text":"mix run --no-halt -e \"Prism.MCP.Stdio.start()\""},{"id":"blk-22249","kind":"heading","level":3,"spans":[{"id":"spn-22080","text":"Tests and format"}]},{"id":"blk-22250","kind":"code","language":"bash","text":"mix test\nmix format --check-formatted"},{"id":"blk-22251","kind":"heading","level":3,"spans":[{"id":"spn-22081","text":"Production release (Fly.io)"}]},{"id":"blk-22252","kind":"paragraph","spans":[{"id":"spn-22082","text":"The "},{"id":"spn-22083","marks":["code"],"text":"Dockerfile"},{"id":"spn-22084","text":" + "},{"id":"spn-22085","marks":["code"],"text":"fly.toml"},{"id":"spn-22086","text":" build a standalone release that serves the site and the engine from the same VM. Before the first deploy, set the Phoenix cookie secret as a Fly secret:"}]},{"id":"blk-22253","kind":"code","language":"bash","text":"fly secrets set SECRET_KEY_BASE=$(mix phx.gen.secret)\nfly deploy"},{"id":"blk-22254","kind":"paragraph","spans":[{"id":"spn-22087","text":"The release listens on "},{"id":"spn-22088","marks":["code"],"text":"PORT=4000"},{"id":"spn-22089","text":" (see "},{"id":"spn-22090","marks":["code"],"text":"fly.toml"},{"id":"spn-22091","text":") and is fronted by Fly's HTTPS proxy at "},{"id":"spn-22092","marks":["code"],"text":"https://prism-eval.fly.dev"},{"id":"spn-22093","text":"."}]},{"id":"blk-22255","kind":"heading","level":2,"spans":[{"id":"spn-22094","text":"Stack"}]},{"id":"blk-22256","items":[{"blocks":[{"id":"blk-22258","kind":"paragraph","spans":[{"id":"spn-22095","marks":["bold"],"text":"Language"},{"id":"spn-22096","text":": Elixir 1.17+ / OTP 27"}]}],"id":"blk-22257","kind":"list-item"},{"blocks":[{"id":"blk-22260","kind":"paragraph","spans":[{"id":"spn-22097","marks":["bold"],"text":"Database"},{"id":"spn-22098","text":": Postgres (server mode via Ecto) · SQLite + sqlite-vec (local "},{"id":"spn-22099","marks":["code"],"text":"os-prism"},{"id":"spn-22100","text":" npm mode)"}]}],"id":"blk-22259","kind":"list-item"},{"blocks":[{"id":"blk-22262","kind":"paragraph","spans":[{"id":"spn-22101","marks":["bold"],"text":"Protocol"},{"id":"spn-22102","text":": MCP exposed as "},{"id":"spn-22103","marks":["bold"],"text":"6 loop-phase machines"},{"id":"spn-22104","text":" — "},{"id":"spn-22105","marks":["code"],"text":"compose"},{"id":"spn-22106","text":", "},{"id":"spn-22107","marks":["code"],"text":"interact"},{"id":"spn-22108","text":", "},{"id":"spn-22109","marks":["code"],"text":"observe"},{"id":"spn-22110","text":", "},{"id":"spn-22111","marks":["code"],"text":"reflect"},{"id":"spn-22112","text":", "},{"id":"spn-22113","marks":["code"],"text":"diagnose"},{"id":"spn-22114","text":", "},{"id":"spn-22115","marks":["code"],"text":"config"},{"id":"spn-22116","text":" — over stdio (local) and SSE/Streamable HTTP (server). Each machine dispatches internally to 5–13 actions (down from 47 individual tools; see "},{"id":"spn-22117","marks":["code"],"text":"docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-22118","text":")."}]}],"id":"blk-22261","kind":"list-item"},{"blocks":[{"id":"blk-22264","kind":"paragraph","spans":[{"id":"spn-22119","marks":["bold"],"text":"LLM"},{"id":"spn-22120","text":": Anthropic Claude, OpenAI GPT-4o, Google Gemini, OpenRouter"}]}],"id":"blk-22263","kind":"list-item"},{"blocks":[{"id":"blk-22266","kind":"paragraph","spans":[{"id":"spn-22121","marks":["bold"],"text":"Deploy"},{"id":"spn-22122","text":": Fly.io (hosted) · "},{"id":"spn-22123","marks":["code"],"text":"npx -y os-prism"},{"id":"spn-22124","text":" (local)"}]}],"id":"blk-22265","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22267","kind":"heading","level":2,"spans":[{"id":"spn-22125","text":"Three-Package MCP Stack"}]},{"id":"blk-22268","kind":"paragraph","spans":[{"id":"spn-22126","text":"PRISM ships as one of three npm-distributed MCP servers that together form the [&] three-protocol stack. All three install identically with "},{"id":"spn-22127","marks":["code"],"text":"npx -y <pkg> --db <path>"},{"id":"spn-22128","text":" and carry their own embedded SQLite + sqlite-vec database:"}]},{"head":[{"id":"blk-22270","spans":[{"id":"spn-22129","text":"Package"}]},{"id":"blk-22271","spans":[{"id":"spn-22130","text":"Role"}]},{"id":"blk-22272","spans":[{"id":"spn-22131","text":"DB path"}]}],"id":"blk-22269","kind":"table","rows":[[{"id":"blk-22273","spans":[{"id":"spn-22132","marks":["code"],"text":"graphonomous"}]},{"id":"blk-22274","spans":[{"id":"spn-22133","text":"Memory loop (5 machines)"}]},{"id":"blk-22275","spans":[{"id":"spn-22134","marks":["code"],"text":"~/.graphonomous/knowledge.db"}]}],[{"id":"blk-22276","spans":[{"id":"spn-22135","marks":["code"],"text":"os-prism"}]},{"id":"blk-22277","spans":[{"id":"spn-22136","text":"Diagnostic loop (6 machines, "},{"id":"spn-22137","marks":["bold"],"text":"this"},{"id":"spn-22138","text":")"}]},{"id":"blk-22278","spans":[{"id":"spn-22139","marks":["code"],"text":"~/.os-prism/benchmarks.db"}]}],[{"id":"blk-22279","spans":[{"id":"spn-22140","marks":["code"],"text":"os-pulse"}]},{"id":"blk-22280","spans":[{"id":"spn-22141","text":"PULSE manifest registry (8 tools)"}]},{"id":"blk-22281","spans":[{"id":"spn-22142","marks":["code"],"text":"~/.os-pulse/manifests.db"}]}]]},{"blocks":[{"id":"blk-22283","kind":"paragraph","spans":[{"id":"spn-22143","text":"The "},{"id":"spn-22144","marks":["code"],"text":"box-and-box"},{"id":"spn-22145","text":" name now belongs to the [&] "},{"id":"spn-22146","marks":["bold"],"text":"governance kernel"},{"id":"spn-22147","text":" (the eight-rung arithmetic ladder · 97 property-tested laws — "},{"id":"spn-22148","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/"},{"id":"spn-22149","text":"), not an MCP server. The old "},{"id":"spn-22150","marks":["code"],"text":"box-and-box"},{"id":"spn-22151","text":" [&] Protocol validator MCP was removed. PRISM's scoring pipeline "},{"id":"spn-22152","marks":["italic"],"text":"is"},{"id":"spn-22153","text":" the kernel's axiological rung at scale — see "},{"id":"spn-22154","marks":[{"kind":"link","predicate":"cites","target":"#/PRISM/docs/ARITHMETIC_INTEGRATION.md"}],"text":"`docs/ARITHMETIC_INTEGRATION.md`"},{"id":"spn-22155","text":"."}]}],"id":"blk-22282","kind":"quote"},{"id":"blk-22284","kind":"paragraph","spans":[{"id":"spn-22156","marks":["code"],"text":".mcp.json"},{"id":"spn-22157","text":" snippet to install all three:"}]},{"id":"blk-22285","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"] },\n    \"prism\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\",     \"--db\", \"~/.os-prism/benchmarks.db\"] },\n    \"pulse\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-pulse\",     \"--db\", \"~/.os-pulse/manifests.db\"] }\n  }\n}"},{"id":"blk-22286","kind":"paragraph","spans":[{"id":"spn-22158","text":"PRISM is "},{"id":"spn-22159","marks":["bold"],"text":"PULSE-evaluable"},{"id":"spn-22160","text":": once a memory system publishes a PULSE manifest, "},{"id":"spn-22161","marks":["code"],"text":"os-prism compose"},{"id":"spn-22162","text":" reads it directly to discover the "},{"id":"spn-22163","marks":["code"],"text":"retrieve"},{"id":"spn-22164","text":" boundary, the "},{"id":"spn-22165","marks":["code"],"text":"learn"},{"id":"spn-22166","text":" phase, and substrate URIs. No bespoke per-system integration is required — see "},{"id":"spn-22167","marks":["code"],"text":"docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-22168","text":" § \"Three-protocol stack at runtime.\""}]},{"id":"blk-22287","kind":"heading","level":2,"spans":[{"id":"spn-22169","text":"Specification"}]},{"id":"blk-22288","kind":"paragraph","spans":[{"id":"spn-22170","text":"Full spec: "},{"id":"spn-22171","marks":[{"kind":"link","predicate":"cites","target":"./OS-009-PRISM-SPECIFICATION.md"}],"text":"OS-009-PRISM-SPECIFICATION.md"}]},{"id":"blk-22289","kind":"heading","level":2,"spans":[{"id":"spn-22172","text":"License"}]},{"id":"blk-22290","kind":"paragraph","spans":[{"id":"spn-22173","text":"Apache 2.0"}]}],"edges":[],"id":"bagaaierax455m2uqf75q7fycbgfaznzknkooudshy4iwvqwtmpjdbj3tjjlq","vocabulary":"ampersand.docs.fs.v1"}