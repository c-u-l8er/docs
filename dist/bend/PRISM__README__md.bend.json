{"bendscript":"0.1","blocks":[{"id":"blk-22307","kind":"heading","level":1,"spans":[{"id":"spn-22576","text":"PRISM — Protocol for Rating Iterative System Memory"}]},{"id":"blk-22308","kind":"paragraph","spans":[{"id":"spn-22577","marks":["bold"],"text":"OpenSentience Specification OS-009"}]},{"id":"blk-22309","kind":"paragraph","spans":[{"id":"spn-22578","text":"The first self-improving continual learning benchmark for AI agent memory systems."}]},{"id":"blk-22310","kind":"heading","level":2,"spans":[{"id":"spn-22579","text":"Legacy Benchmarks vs PRISM"}]},{"head":[{"id":"blk-22312","spans":[{"id":"spn-22580","text":""}]},{"id":"blk-22313","spans":[{"id":"spn-22581","text":"Legacy (BEAM, LongMemEval, etc.)"}]},{"id":"blk-22314","spans":[{"id":"spn-22582","text":"PRISM"}]}],"id":"blk-22311","kind":"table","rows":[[{"id":"blk-22315","spans":[{"id":"spn-22583","marks":["bold"],"text":"Assessment"}]},{"id":"blk-22316","spans":[{"id":"spn-22584","text":"Synthetic Q&A"}]},{"id":"blk-22317","spans":[{"id":"spn-22585","text":"Observational: agents interact naturally, judges observe transcripts"}]}],[{"id":"blk-22318","spans":[{"id":"spn-22586","marks":["bold"],"text":"Ground truth"}]},{"id":"blk-22319","spans":[{"id":"spn-22587","text":"Author's expected answer"}]},{"id":"blk-22320","spans":[{"id":"spn-22588","text":"Git repos: the code IS the answer"}]}],[{"id":"blk-22321","spans":[{"id":"spn-22589","marks":["bold"],"text":"Learning test"}]},{"id":"blk-22322","spans":[{"id":"spn-22590","text":"Single pass (store→retrieve→score)"}]},{"id":"blk-22323","spans":[{"id":"spn-22591","text":"Closed-loop: scenario sequences measure improvement over time"}]}],[{"id":"blk-22324","spans":[{"id":"spn-22592","marks":["bold"],"text":"Scoring"}]},{"id":"blk-22325","spans":[{"id":"spn-22593","text":"One composite number"}]},{"id":"blk-22326","spans":[{"id":"spn-22594","text":"9 CL dimensions × domain × loop closure rate"}]}],[{"id":"blk-22327","spans":[{"id":"spn-22595","marks":["bold"],"text":"Judging"}]},{"id":"blk-22328","spans":[{"id":"spn-22596","text":"Single LLM judge"}]},{"id":"blk-22329","spans":[{"id":"spn-22597","text":"3 layers: transcripts → dimension judges → meta-judges"}]}],[{"id":"blk-22330","spans":[{"id":"spn-22598","marks":["bold"],"text":"Evolution"}]},{"id":"blk-22331","spans":[{"id":"spn-22599","text":"Static question bank"}]},{"id":"blk-22332","spans":[{"id":"spn-22600","text":"Self-improving: gap analysis evolves scenarios, IRT calibrates difficulty"}]}],[{"id":"blk-22333","spans":[{"id":"spn-22601","marks":["bold"],"text":"Domains"}]},{"id":"blk-22334","spans":[{"id":"spn-22602","text":"Domain-agnostic"}]},{"id":"blk-22335","spans":[{"id":"spn-22603","text":"Tagged by domain for cross-domain comparison"}]}]]},{"id":"blk-22336","kind":"heading","level":2,"spans":[{"id":"spn-22604","text":"The 9 CL Dimensions"}]},{"head":[{"id":"blk-22338","spans":[{"id":"spn-22605","text":"#"}]},{"id":"blk-22339","spans":[{"id":"spn-22606","text":"Dimension"}]},{"id":"blk-22340","spans":[{"id":"spn-22607","text":"Weight"}]}],"id":"blk-22337","kind":"table","rows":[[{"id":"blk-22341","spans":[{"id":"spn-22608","text":"1"}]},{"id":"blk-22342","spans":[{"id":"spn-22609","text":"Stability (Anti-Forgetting)"}]},{"id":"blk-22343","spans":[{"id":"spn-22610","text":"0.20"}]}],[{"id":"blk-22344","spans":[{"id":"spn-22611","text":"2"}]},{"id":"blk-22345","spans":[{"id":"spn-22612","text":"Plasticity (New Acquisition)"}]},{"id":"blk-22346","spans":[{"id":"spn-22613","text":"0.18"}]}],[{"id":"blk-22347","spans":[{"id":"spn-22614","text":"3"}]},{"id":"blk-22348","spans":[{"id":"spn-22615","text":"Knowledge Update (Contradiction)"}]},{"id":"blk-22349","spans":[{"id":"spn-22616","text":"0.15"}]}],[{"id":"blk-22350","spans":[{"id":"spn-22617","text":"4"}]},{"id":"blk-22351","spans":[{"id":"spn-22618","text":"Temporal Reasoning"}]},{"id":"blk-22352","spans":[{"id":"spn-22619","text":"0.12"}]}],[{"id":"blk-22353","spans":[{"id":"spn-22620","text":"5"}]},{"id":"blk-22354","spans":[{"id":"spn-22621","text":"Consolidation (Abstraction)"}]},{"id":"blk-22355","spans":[{"id":"spn-22622","text":"0.10"}]}],[{"id":"blk-22356","spans":[{"id":"spn-22623","text":"6"}]},{"id":"blk-22357","spans":[{"id":"spn-22624","text":"Epistemic Awareness"}]},{"id":"blk-22358","spans":[{"id":"spn-22625","text":"0.08"}]}],[{"id":"blk-22359","spans":[{"id":"spn-22626","text":"7"}]},{"id":"blk-22360","spans":[{"id":"spn-22627","text":"Cross-Domain Transfer"}]},{"id":"blk-22361","spans":[{"id":"spn-22628","text":"0.07"}]}],[{"id":"blk-22362","spans":[{"id":"spn-22629","text":"8"}]},{"id":"blk-22363","spans":[{"id":"spn-22630","text":"Intentional Forgetting"}]},{"id":"blk-22364","spans":[{"id":"spn-22631","text":"0.05"}]}],[{"id":"blk-22365","spans":[{"id":"spn-22632","text":"9"}]},{"id":"blk-22366","spans":[{"id":"spn-22633","text":"Outcome Feedback"}]},{"id":"blk-22367","spans":[{"id":"spn-22634","text":"0.05"}]}]]},{"id":"blk-22368","kind":"heading","level":2,"spans":[{"id":"spn-22635","text":"4-Phase Evaluation Loop"}]},{"id":"blk-22369","kind":"code","language":"text","text":"Phase 1: Compose → Phase 2: Interact → Phase 3: Observe → Phase 4: Reflect\n     ↑                                                          │\n     └────────────────── Scenario Evolution ────────────────────┘"},{"id":"blk-22370","kind":"paragraph","spans":[{"id":"spn-22636","marks":["bold"],"text":"Phase 1: Compose"},{"id":"spn-22637","text":" — Build scenarios from git repo anchors with embedded CL challenges"}]},{"id":"blk-22371","kind":"paragraph","spans":[{"id":"spn-22638","marks":["bold"],"text":"Phase 2: Interact"},{"id":"spn-22639","text":" — User Simulator runs scenarios against memory systems via MCP"}]},{"id":"blk-22372","kind":"paragraph","spans":[{"id":"spn-22640","marks":["bold"],"text":"Phase 3: Observe"},{"id":"spn-22641","text":" — Three-layer judging: transcripts → L2 dimension judges → L3 meta-judges"}]},{"id":"blk-22373","kind":"paragraph","spans":[{"id":"spn-22642","marks":["bold"],"text":"Phase 4: Reflect"},{"id":"spn-22643","text":" — Gap analysis, IRT recalibration, scenario evolution"}]},{"id":"blk-22374","kind":"heading","level":2,"spans":[{"id":"spn-22644","text":"Key Innovations"}]},{"id":"blk-22375","kind":"heading","level":3,"spans":[{"id":"spn-22645","text":"Git-Grounded Anchors"}]},{"id":"blk-22376","kind":"paragraph","spans":[{"id":"spn-22646","text":"Anchor scenarios use real git repositories as ground truth. Walk the commit history, ingest diffs, probe for understanding. The code IS the answer — checkout any commit to verify."}]},{"id":"blk-22377","kind":"heading","level":3,"spans":[{"id":"spn-22647","text":"Closed-Loop Testing"}]},{"id":"blk-22378","kind":"paragraph","spans":[{"id":"spn-22648","text":"Scenario sequences run S1→S2→S3 without resetting memory. Measures whether the system "},{"id":"spn-22649","marks":["italic"],"text":"actually learns"},{"id":"spn-22650","text":" from its own usage. Loop closure rate is a first-class leaderboard metric."}]},{"id":"blk-22379","kind":"heading","level":3,"spans":[{"id":"spn-22651","text":"Three-Layer Judging"}]},{"id":"blk-22380","items":[{"blocks":[{"id":"blk-22382","kind":"paragraph","spans":[{"id":"spn-22652","marks":["bold"],"text":"Layer 1"},{"id":"spn-22653","text":": Raw interaction transcript (observable evidence)"}]}],"id":"blk-22381","kind":"list-item"},{"blocks":[{"id":"blk-22384","kind":"paragraph","spans":[{"id":"spn-22654","marks":["bold"],"text":"Layer 2"},{"id":"spn-22655","text":": Per-dimension judges with structured rubrics"}]}],"id":"blk-22383","kind":"list-item"},{"blocks":[{"id":"blk-22386","kind":"paragraph","spans":[{"id":"spn-22656","marks":["bold"],"text":"Layer 3"},{"id":"spn-22657","text":": Meta-judges that audit L2 (must use different model family)"}]}],"id":"blk-22385","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22387","kind":"heading","level":3,"spans":[{"id":"spn-22658","text":"Domain Categories"}]},{"id":"blk-22388","kind":"paragraph","spans":[{"id":"spn-22659","text":"Every scenario tagged by domain (code, medical, business, personal, research, creative, legal, operations). Enables \"Who's best at medical CL?\" comparisons."}]},{"id":"blk-22389","kind":"heading","level":2,"spans":[{"id":"spn-22660","text":"Running locally"}]},{"id":"blk-22390","kind":"paragraph","spans":[{"id":"spn-22661","text":"PRISM ships as a single Elixir/OTP app that runs three things side-by-side in one supervision tree:"}]},{"id":"blk-22391","items":[{"blocks":[{"id":"blk-22393","kind":"paragraph","spans":[{"id":"spn-22662","text":"The "},{"id":"spn-22663","marks":["bold"],"text":"evaluation engine"},{"id":"spn-22664","text":" (compose → interact → observe → reflect → diagnose)"}]}],"id":"blk-22392","kind":"list-item"},{"blocks":[{"id":"blk-22395","kind":"paragraph","spans":[{"id":"spn-22665","text":"The "},{"id":"spn-22666","marks":["bold"],"text":"MCP server"},{"id":"spn-22667","text":" exposing six loop-phase machines over stdio"}]}],"id":"blk-22394","kind":"list-item"},{"blocks":[{"id":"blk-22397","kind":"paragraph","spans":[{"id":"spn-22668","text":"A "},{"id":"spn-22669","marks":["bold"],"text":"Phoenix 1.7 web layer"},{"id":"spn-22670","text":" serving the marketing site at "},{"id":"spn-22671","marks":["code"],"text":"/"},{"id":"spn-22672","text":" and a JSON"}]}],"id":"blk-22396","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22398","kind":"paragraph","spans":[{"id":"spn-22673","text":"leaderboard at "},{"id":"spn-22674","marks":["code"],"text":"/api/leaderboard"}]},{"id":"blk-22399","kind":"heading","level":3,"spans":[{"id":"spn-22675","text":"Prerequisites"}]},{"id":"blk-22400","items":[{"blocks":[{"id":"blk-22402","kind":"paragraph","spans":[{"id":"spn-22676","text":"Elixir 1.17+ / Erlang/OTP 27"}]}],"id":"blk-22401","kind":"list-item"},{"blocks":[{"id":"blk-22404","kind":"paragraph","spans":[{"id":"spn-22677","text":"SQLite (bundled via "},{"id":"spn-22678","marks":["code"],"text":"ecto_sqlite3"},{"id":"spn-22679","text":" — no extra install needed for dev)"}]}],"id":"blk-22403","kind":"list-item"},{"blocks":[{"id":"blk-22406","kind":"paragraph","spans":[{"id":"spn-22680","text":"No Node / esbuild / Tailwind — CSS is hand-written in "},{"id":"spn-22681","marks":["code"],"text":"priv/static/assets/app.css"}]}],"id":"blk-22405","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22407","kind":"heading","level":3,"spans":[{"id":"spn-22682","text":"First-time setup"}]},{"id":"blk-22408","kind":"code","language":"bash","text":"cd PRISM\nmix deps.get\nmix ecto.create\nmix ecto.migrate"},{"id":"blk-22409","kind":"paragraph","spans":[{"id":"spn-22683","text":"The dev database lives at "},{"id":"spn-22684","marks":["code"],"text":"~/.prism/prism_dev.db"},{"id":"spn-22685","text":" (SQLite, WAL mode). Override with "},{"id":"spn-22686","marks":["code"],"text":"config/dev.exs"},{"id":"spn-22687","text":" if you want it elsewhere."}]},{"id":"blk-22410","kind":"heading","level":3,"spans":[{"id":"spn-22688","text":"Start the Phoenix server (site + API + engine, all in one process)"}]},{"id":"blk-22411","kind":"code","language":"bash","text":"mix phx.server"},{"id":"blk-22412","kind":"paragraph","spans":[{"id":"spn-22689","text":"Then open:"}]},{"id":"blk-22413","items":[{"blocks":[{"id":"blk-22415","kind":"paragraph","spans":[{"id":"spn-22690","text":"<http://localhost:4000/> — the marketing site"}]}],"id":"blk-22414","kind":"list-item"},{"blocks":[{"id":"blk-22417","kind":"paragraph","spans":[{"id":"spn-22691","text":"<http://localhost:4000/api/leaderboard> — leaderboard JSON (currently a stub)"}]}],"id":"blk-22416","kind":"list-item"},{"blocks":[{"id":"blk-22419","kind":"paragraph","spans":[{"id":"spn-22692","text":"<http://localhost:4000/api/health> — health check"}]}],"id":"blk-22418","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22420","kind":"paragraph","spans":[{"id":"spn-22693","text":"Live reload is enabled in dev — edits to "},{"id":"spn-22694","marks":["code"],"text":"lib/prism_web/**/*.{ex,heex}"},{"id":"spn-22695","text":" and "},{"id":"spn-22696","marks":["code"],"text":"priv/static/**/*.css"},{"id":"spn-22697","text":" trigger an automatic browser refresh."}]},{"id":"blk-22421","kind":"heading","level":3,"spans":[{"id":"spn-22698","text":"Start without the web layer (headless engine + MCP only)"}]},{"id":"blk-22422","kind":"code","language":"bash","text":"mix run --no-halt"},{"id":"blk-22423","kind":"paragraph","spans":[{"id":"spn-22699","text":"This boots the full supervision tree (including the Phoenix endpoint on 4000) without attaching to the shell for HTTP serving. For a truly headless run that skips the web layer entirely, set "},{"id":"spn-22700","marks":["code"],"text":"PHX_SERVER=0"},{"id":"spn-22701","text":" or comment out "},{"id":"spn-22702","marks":["code"],"text":"PrismWeb.Endpoint"},{"id":"spn-22703","text":" in "},{"id":"spn-22704","marks":["code"],"text":"lib/prism/application.ex"},{"id":"spn-22705","text":"."}]},{"id":"blk-22424","kind":"heading","level":3,"spans":[{"id":"spn-22706","text":"Use as an MCP server from a Claude / Codex / Zed session"}]},{"id":"blk-22425","kind":"paragraph","spans":[{"id":"spn-22707","text":"Add to your "},{"id":"spn-22708","marks":["code"],"text":".mcp.json"},{"id":"spn-22709","text":":"}]},{"id":"blk-22426","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"prism\": { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\", \"--db\", \"~/.os-prism/benchmarks.db\"] }\n  }\n}"},{"id":"blk-22427","kind":"paragraph","spans":[{"id":"spn-22710","text":"Or run directly against the checkout via stdio:"}]},{"id":"blk-22428","kind":"code","language":"bash","text":"mix run --no-halt -e \"Prism.MCP.Stdio.start()\""},{"id":"blk-22429","kind":"heading","level":3,"spans":[{"id":"spn-22711","text":"Tests and format"}]},{"id":"blk-22430","kind":"code","language":"bash","text":"mix test\nmix format --check-formatted"},{"id":"blk-22431","kind":"heading","level":3,"spans":[{"id":"spn-22712","text":"Production release (Fly.io)"}]},{"id":"blk-22432","kind":"paragraph","spans":[{"id":"spn-22713","text":"The "},{"id":"spn-22714","marks":["code"],"text":"Dockerfile"},{"id":"spn-22715","text":" + "},{"id":"spn-22716","marks":["code"],"text":"fly.toml"},{"id":"spn-22717","text":" build a standalone release that serves the site and the engine from the same VM. Before the first deploy, set the Phoenix cookie secret as a Fly secret:"}]},{"id":"blk-22433","kind":"code","language":"bash","text":"fly secrets set SECRET_KEY_BASE=$(mix phx.gen.secret)\nfly deploy"},{"id":"blk-22434","kind":"paragraph","spans":[{"id":"spn-22718","text":"The release listens on "},{"id":"spn-22719","marks":["code"],"text":"PORT=4000"},{"id":"spn-22720","text":" (see "},{"id":"spn-22721","marks":["code"],"text":"fly.toml"},{"id":"spn-22722","text":") and is fronted by Fly's HTTPS proxy at "},{"id":"spn-22723","marks":["code"],"text":"https://prism-eval.fly.dev"},{"id":"spn-22724","text":"."}]},{"id":"blk-22435","kind":"heading","level":2,"spans":[{"id":"spn-22725","text":"Stack"}]},{"id":"blk-22436","items":[{"blocks":[{"id":"blk-22438","kind":"paragraph","spans":[{"id":"spn-22726","marks":["bold"],"text":"Language"},{"id":"spn-22727","text":": Elixir 1.17+ / OTP 27"}]}],"id":"blk-22437","kind":"list-item"},{"blocks":[{"id":"blk-22440","kind":"paragraph","spans":[{"id":"spn-22728","marks":["bold"],"text":"Database"},{"id":"spn-22729","text":": Postgres (server mode via Ecto) · SQLite + sqlite-vec (local "},{"id":"spn-22730","marks":["code"],"text":"os-prism"},{"id":"spn-22731","text":" npm mode)"}]}],"id":"blk-22439","kind":"list-item"},{"blocks":[{"id":"blk-22442","kind":"paragraph","spans":[{"id":"spn-22732","marks":["bold"],"text":"Protocol"},{"id":"spn-22733","text":": MCP exposed as "},{"id":"spn-22734","marks":["bold"],"text":"6 loop-phase machines"},{"id":"spn-22735","text":" — "},{"id":"spn-22736","marks":["code"],"text":"compose"},{"id":"spn-22737","text":", "},{"id":"spn-22738","marks":["code"],"text":"interact"},{"id":"spn-22739","text":", "},{"id":"spn-22740","marks":["code"],"text":"observe"},{"id":"spn-22741","text":", "},{"id":"spn-22742","marks":["code"],"text":"reflect"},{"id":"spn-22743","text":", "},{"id":"spn-22744","marks":["code"],"text":"diagnose"},{"id":"spn-22745","text":", "},{"id":"spn-22746","marks":["code"],"text":"config"},{"id":"spn-22747","text":" — over stdio (local) and SSE/Streamable HTTP (server). Each machine dispatches internally to 5–13 actions (down from 47 individual tools; see "},{"id":"spn-22748","marks":["code"],"text":"docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-22749","text":")."}]}],"id":"blk-22441","kind":"list-item"},{"blocks":[{"id":"blk-22444","kind":"paragraph","spans":[{"id":"spn-22750","marks":["bold"],"text":"LLM"},{"id":"spn-22751","text":": Anthropic Claude, OpenAI GPT-4o, Google Gemini, OpenRouter"}]}],"id":"blk-22443","kind":"list-item"},{"blocks":[{"id":"blk-22446","kind":"paragraph","spans":[{"id":"spn-22752","marks":["bold"],"text":"Deploy"},{"id":"spn-22753","text":": Fly.io (hosted) · "},{"id":"spn-22754","marks":["code"],"text":"npx -y os-prism"},{"id":"spn-22755","text":" (local)"}]}],"id":"blk-22445","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22447","kind":"heading","level":2,"spans":[{"id":"spn-22756","text":"Three-Package MCP Stack"}]},{"id":"blk-22448","kind":"paragraph","spans":[{"id":"spn-22757","text":"PRISM ships as one of three npm-distributed MCP servers that together form the [&] three-protocol stack. All three install identically with "},{"id":"spn-22758","marks":["code"],"text":"npx -y <pkg> --db <path>"},{"id":"spn-22759","text":" and carry their own embedded SQLite + sqlite-vec database:"}]},{"head":[{"id":"blk-22450","spans":[{"id":"spn-22760","text":"Package"}]},{"id":"blk-22451","spans":[{"id":"spn-22761","text":"Role"}]},{"id":"blk-22452","spans":[{"id":"spn-22762","text":"DB path"}]}],"id":"blk-22449","kind":"table","rows":[[{"id":"blk-22453","spans":[{"id":"spn-22763","marks":["code"],"text":"graphonomous"}]},{"id":"blk-22454","spans":[{"id":"spn-22764","text":"Memory loop (5 machines)"}]},{"id":"blk-22455","spans":[{"id":"spn-22765","marks":["code"],"text":"~/.graphonomous/knowledge.db"}]}],[{"id":"blk-22456","spans":[{"id":"spn-22766","marks":["code"],"text":"os-prism"}]},{"id":"blk-22457","spans":[{"id":"spn-22767","text":"Diagnostic loop (6 machines, "},{"id":"spn-22768","marks":["bold"],"text":"this"},{"id":"spn-22769","text":")"}]},{"id":"blk-22458","spans":[{"id":"spn-22770","marks":["code"],"text":"~/.os-prism/benchmarks.db"}]}],[{"id":"blk-22459","spans":[{"id":"spn-22771","marks":["code"],"text":"os-pulse"}]},{"id":"blk-22460","spans":[{"id":"spn-22772","text":"PULSE manifest registry (8 tools)"}]},{"id":"blk-22461","spans":[{"id":"spn-22773","marks":["code"],"text":"~/.os-pulse/manifests.db"}]}]]},{"blocks":[{"id":"blk-22463","kind":"paragraph","spans":[{"id":"spn-22774","text":"The "},{"id":"spn-22775","marks":["code"],"text":"box-and-box"},{"id":"spn-22776","text":" name now belongs to the [&] "},{"id":"spn-22777","marks":["bold"],"text":"governance kernel"},{"id":"spn-22778","text":" (the eight-rung arithmetic ladder · 97 property-tested laws — "},{"id":"spn-22779","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/"},{"id":"spn-22780","text":"), not an MCP server. The old "},{"id":"spn-22781","marks":["code"],"text":"box-and-box"},{"id":"spn-22782","text":" [&] Protocol validator MCP was removed. PRISM's scoring pipeline "},{"id":"spn-22783","marks":["italic"],"text":"is"},{"id":"spn-22784","text":" the kernel's axiological rung at scale — see "},{"id":"spn-22785","marks":[{"kind":"link","predicate":"cites","target":"#/PRISM/docs/ARITHMETIC_INTEGRATION.md"}],"text":"`docs/ARITHMETIC_INTEGRATION.md`"},{"id":"spn-22786","text":"."}]}],"id":"blk-22462","kind":"quote"},{"id":"blk-22464","kind":"paragraph","spans":[{"id":"spn-22787","marks":["code"],"text":".mcp.json"},{"id":"spn-22788","text":" snippet to install all three:"}]},{"id":"blk-22465","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"] },\n    \"prism\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\",     \"--db\", \"~/.os-prism/benchmarks.db\"] },\n    \"pulse\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-pulse\",     \"--db\", \"~/.os-pulse/manifests.db\"] }\n  }\n}"},{"id":"blk-22466","kind":"paragraph","spans":[{"id":"spn-22789","text":"PRISM is "},{"id":"spn-22790","marks":["bold"],"text":"PULSE-evaluable"},{"id":"spn-22791","text":": once a memory system publishes a PULSE manifest, "},{"id":"spn-22792","marks":["code"],"text":"os-prism compose"},{"id":"spn-22793","text":" reads it directly to discover the "},{"id":"spn-22794","marks":["code"],"text":"retrieve"},{"id":"spn-22795","text":" boundary, the "},{"id":"spn-22796","marks":["code"],"text":"learn"},{"id":"spn-22797","text":" phase, and substrate URIs. No bespoke per-system integration is required — see "},{"id":"spn-22798","marks":["code"],"text":"docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-22799","text":" § \"Three-protocol stack at runtime.\""}]},{"id":"blk-22467","kind":"heading","level":2,"spans":[{"id":"spn-22800","text":"Specification"}]},{"id":"blk-22468","kind":"paragraph","spans":[{"id":"spn-22801","text":"Full spec: "},{"id":"spn-22802","marks":[{"kind":"link","predicate":"cites","target":"./OS-009-PRISM-SPECIFICATION.md"}],"text":"OS-009-PRISM-SPECIFICATION.md"}]},{"id":"blk-22469","kind":"heading","level":2,"spans":[{"id":"spn-22803","text":"License"}]},{"id":"blk-22470","kind":"paragraph","spans":[{"id":"spn-22804","text":"Apache 2.0"}]}],"edges":[],"id":"bagaaierak7drhcxjvicg4ghtncsaersmlk5zxxtf5gsn3j46r3fj23hfx2sa","vocabulary":"ampersand.docs.fs.v1"}