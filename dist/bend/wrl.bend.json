{"bendscript":"0.1","blocks":[{"id":"blk-1","kind":"heading","level":1,"spans":[{"id":"spn-294","text":"WallRiderLang"}]},{"id":"blk-2","kind":"paragraph","spans":[{"id":"spn-295","text":"A WRL program is a network of "},{"id":"spn-296","marks":["bold"],"text":"durable identities"},{"id":"spn-297","text":" connected by "},{"id":"spn-298","marks":["bold"],"text":"textured routes"},{"id":"spn-299","text":" and separated by "},{"id":"spn-300","marks":["bold"],"text":"boundaries"},{"id":"spn-301","text":". The name is literal — programs are made of "},{"id":"spn-302","marks":["bold"],"text":"riders"},{"id":"spn-303","text":" (identities in motion along routes) and "},{"id":"spn-304","marks":["bold"],"text":"walls"},{"id":"spn-305","text":" (boundaries that gate, commit and seal what they do). The whole network is one content "},{"id":"spn-306","text":"address, and every run of it is a film that replays exactly. Version "},{"id":"spn-307","marks":["code"],"text":"0.1.2"},{"id":"spn-308","text":"."}]},{"id":"blk-3","kind":"heading","level":2,"spans":[{"id":"spn-309","text":"The identity spine"}]},{"id":"blk-4","kind":"paragraph","spans":[{"id":"spn-310","text":"A world seals to a "},{"id":"spn-311","marks":["code"],"text":"SemanticArtifactID"},{"id":"spn-312","text":" ("},{"id":"spn-313","marks":["code"],"text":"sem-"},{"id":"spn-314","text":") via: "},{"id":"spn-315","marks":["code"],"text":"desugar → parse → validate → canonicalize → serialize → SHA-256"},{"id":"spn-316","text":". The playground reproduces the reference implementation's canonical bytes exactly — "},{"id":"spn-317","text":"same id on every host, forever."}]},{"id":"blk-5","kind":"heading","level":2,"spans":[{"id":"spn-318","text":"What is built vs. designed"}]},{"id":"blk-6","items":[{"blocks":[{"id":"blk-8","kind":"paragraph","spans":[{"id":"spn-319","text":"WRL Core 0.1.2 — frozen. Five roles, one texture, no behaviours."}]}],"id":"blk-7","kind":"list-item"},{"blocks":[{"id":"blk-10","kind":"paragraph","spans":[{"id":"spn-320","text":"Forge Semantic IR 1.x — frozen. Forge Semantic IR 2.0 — draft, implemented."}]}],"id":"blk-9","kind":"list-item"},{"blocks":[{"id":"blk-12","kind":"paragraph","spans":[{"id":"spn-321","text":"The authored design — 46 sections, tier-marked, capability-gated roadmap."}]}],"id":"blk-11","kind":"list-item"},{"blocks":[{"id":"blk-14","kind":"paragraph","spans":[{"id":"spn-322","text":"The direction — executable topology: physical, computational, authority, fault and economic networks over the same durable identities."}]}],"id":"blk-13","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15","kind":"code","language":"text","text":"profile forge.world.core.v1\n\n[pulser:p0](every 2){sig_out}\n[relay:r0]{sig_in, sig_out}\n[spinner:sp](w=16, n=8, rotor=quarter_turn_z, configurable){sig_in, socket}\n[orb:ob]{pose}\n\n[p0] --sig--> [r0]\n[r0] --sig--> [sp]\n[sp] --socket--> [ob]"},{"id":"blk-16","kind":"paragraph","spans":[{"id":"spn-323","text":"seals to "},{"id":"spn-324","marks":["code"],"text":"sem-67e954cf…60ae"},{"id":"spn-325","text":" on every host, forever."}]}],"edges":[{"object":"bend:dyksgsu","predicate":"ampersand.docs:runs-on","subject":"bend:d377lmi"},{"object":"bend:dykurqf","predicate":"ampersand.docs:proposed-by","subject":"bend:d377lmi"},{"object":"bend:d1fpdh60","predicate":"ampersand.docs:evaluated-by","subject":"bend:d377lmi"},{"object":"https://wallriderlang.com","predicate":"cites","subject":"bend:d377lmi"}],"id":"bagaaiera3vwmm5w7vaig7iql6wc6iao7bk4dmbynz5ouk5q2vorwu2sw2g2a","vocabulary":"ampersand.docs.v1"}