"text":"2"}]}],"id":"blk-33928","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33930","kind":"paragraph","spans":[{"id":"spn-49893","marks":["code"],"text":"trvs verify-episode"},{"id":"spn-49894","text":" maps these directly (smoke-verified: tampered reward → 1, missing dir → 2, clean → 0). "},{"id":"spn-49895","marks":["code"],"text":"trvs eval-one --output"},{"id":"spn-49896","text":" now passes the wired verifier set into "},{"id":"spn-49897","marks":["code"],"text":"write_episode_bundle"},{"id":"spn-49898","text":", whose in-line staging verification exercises the exact closure a later "},{"id":"spn-49899","marks":["code"],"text":"verify-episode"},{"id":"spn-49900","text":" will."}]},{"id":"blk-33931","kind":"heading","level":2,"spans":[{"id":"spn-49901","text":"3. Corrected invariant (per your note)"}]},{"id":"blk-33932","kind":"paragraph","spans":[{"id":"spn-49902","text":"We no longer claim the whole episode directory is byte-identical across writes — the manifest carries a wall-clock "},{"id":"spn-49903","marks":["code"],"text":"created_at"},{"id":"spn-49904","text":". The correct invariant is: "},{"id":"spn-49905","marks":["bold"],"text":"the same evaluation → identical receipt → identical canonical evidence artifacts → the same episode id."},{"id":"spn-49906","text":" Pinned by "},{"id":"spn-49907","marks":["code"],"text":"test_fresh_independent_writes_share_canonical_artifacts"},{"id":"spn-49908","text":" (two independent roots share every canonical member; only "},{"id":"spn-49909","marks":["code"],"text":"created_at"},{"id":"spn-49910","text":" may differ)."}]},{"id":"blk-33933","kind":"heading","level":2,"spans":[{"id":"spn-49911","text":"4. Autonomous decisions flagged for your review"}]},{"id":"blk-33934","items":[{"blocks":[{"id":"blk-33936","kind":"paragraph","spans":[{"id":"spn-49912","marks":["bold"],"text":"execution_facts reconstruction on replay"},{"id":"spn-49913","text":" ("},{"id":"spn-49914","marks":["code"],"text":"_recon