s":["bold"],"text":"Idempotent reuse requires a full re-verify"},{"id":"spn-49937","text":" of the existing target (not just a"}]}],"id":"blk-33943","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-33945","kind":"paragraph","spans":[{"id":"spn-49938","text":"name/"},{"id":"spn-49939","marks":["code"],"text":"episode_id"},{"id":"spn-49940","text":" match), and a conflicting/corrupt target is a hard "},{"id":"spn-49941","marks":["code"],"text":"EpisodeBundleConflict"},{"id":"spn-49942","text":", never an overwrite."}]},{"id":"blk-33946","kind":"paragraph","spans":[{"id":"spn-49943","text":"Everything above is green with the real engine. No blocker — proceeding per the standing instruction. TestPlanV2 remains "},{"id":"spn-49944","marks":["bold"],"text":"not started"},{"id":"spn-49945","text":" as you directed."}]}],"edges":[],"id":"bagaaierajrauqplqwizlej2xhuq2gl63zujw4qengyjoi4nxsauefgpftf4a","vocabulary":"ampersand.docs.fs.v1"}