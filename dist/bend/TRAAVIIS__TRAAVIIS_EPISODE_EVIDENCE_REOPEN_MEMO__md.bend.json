{"id":"spn-47478","text":"; plus every signal is checked in the closing/positive cases."}]},{"id":"blk-33188","kind":"heading","level":3,"spans":[{"id":"spn-47479","text":"Step 12 — regenerate the five-signal conformance episode + battery + packet"}]},{"id":"blk-33189","kind":"paragraph","spans":[{"id":"spn-47480","text":"Regenerated at "},{"id":"spn-47481","marks":["code"],"text":"examples/eval-one/episodes/episode-5aef63c4943d44fa4f4703435dbac87bb23fd05e1f8679189b19ca0c3688b3e2/"},{"id":"spn-47482","text":" (id moved from "},{"id":"spn-47483","marks":["code"],"text":"…e125d77b…"},{"id":"spn-47484","text":" because verifier-implementation names now enter the episode id). It re-verifies "},{"id":"spn-47485","marks":["bold"],"text":"closed, exit 0"},{"id":"spn-47486","text":"."}]},{"id":"blk-33190","kind":"heading","level":3,"spans":[{"id":"spn-47487","text":"Plus — separate contract vs implementation version naming"}]},{"id":"blk-33191","items":[{"blocks":[{"id":"blk-33193","kind":"paragraph","spans":[{"id":"spn-47488","marks":["code"],"text":"citations"},{"id":"spn-47489","text":" seals "},{"id":"spn-47490","marks":["code"],"text":"implementation = traaviis.citations-impl.v1"},{"id":"spn-47491","text":" (contract stays"}]}],"id":"blk-33192","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33194","kind":"paragraph","spans":[{"id":"spn-47492","marks":["code"],"text":"residency.citations.v1"},{"id":"spn-47493","text":")."}]},{"id":"blk-33195","items":[{"blocks":[{"id":"blk-33197","kind":"paragraph","spans":[{"id":"spn-47494","marks":["code"],"text":"patch"},{"id":"spn-47495","text":" → "},{"id":"spn-47496","marks":["code"],"text":"traaviis.patch-impl.v1"},{"id":"spn-47497","text":"."}]}],"id":"blk-33196","kind":"list-item"},{"blocks":[{"id":"blk-33199","kind":"paragraph","spans":[{"id":"spn-47498","marks":["code"],"text":"finding_completeness"},{"id":"spn-47499","text":" → "},{"id":"spn-47500","marks":["code"],"text":"traaviis.finding-completeness-impl.v