"text":"2"}]}],"id":"blk-36600","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36602","kind":"paragraph","spans":[{"id":"spn-59843","marks":["code"],"text":"trvs verify-episode"},{"id":"spn-59844","text":" maps these directly (smoke-verified: tampered reward → 1, missing dir → 2, clean → 0). "},{"id":"spn-59845","marks":["code"],"text":"trvs eval-one --output"},{"id":"spn-59846","text":" now passes the wired verifier set into "},{"id":"spn-59847","marks":["code"],"text":"write_episode_bundle"},{"id":"spn-59848","text":", whose in-line staging verification exercises the exact closure a later "},{"id":"spn-59849","marks":["code"],"text":"verify-episode"},{"id":"spn-59850","text":" will."}]},{"id":"blk-36603","kind":"heading","level":2,"spans":[{"id":"spn-59851","text":"3. Corrected invariant (per your note)"}]},{"id":"blk-36604","kind":"paragraph","spans":[{"id":"spn-59852","text":"We no longer claim the whole episode directory is byte-identical across writes — the manifest carries a wall-clock "},{"id":"spn-59853","marks":["code"],"text":"created_at"},{"id":"spn-59854","text":". The correct invariant is: "},{"id":"spn-59855","marks":["bold"],"text":"the same evaluation → identical receipt → identical canonical evidence artifacts → the same episode id."},{"id":"spn-59856","text":" Pinned by "},{"id":"spn-59857","marks":["code"],"text":"test_fresh_independent_writes_share_canonical_artifacts"},{"id":"spn-59858","text":" (two independent roots share every canonical member; only "},{"id":"spn-59859","marks":["code"],"text":"created_at"},{"id":"spn-59860","text":" may differ)."}]},{"id":"blk-36605","kind":"heading","level":2,"spans":[{"id":"spn-59861","text":"4. Autonomous decisions flagged for your review"}]},{"id":"blk-36606","items":[{"blocks":[{"id":"blk-36608","kind":"paragraph","spans":[{"id":"spn-59862","marks":["bold"],"text":"execution_facts reconstruction on replay"},{"id":"spn-59863","text":" ("},{"id":"spn-59864","marks":["code"],"text":"_reconstruct_execution_facts"},{"id":"spn-59865","text":"):"}]}],"id":"blk-36607","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-36609","kind":"paragraph","spans":[{"id":"spn-59866","text":"only "},{"id":"spn-59867","marks":["code"],"text":"agent_process"},{"id":"spn-59868","text":" (from the trace "},{"id":"spn-59869","marks":["code"],"text":"exit_code"},{"id":"spn-59870","text":" + manifest truncation flags) and "},{"id":"spn-59871","marks":["code"],"text":"sandbox"},{"id":"spn-59872","text":" (from the runner profile) are re-derivable from the bundle's own evidence; the irreducible run-time config (runner / platform / toolchain) is carried verbatim from the stored facts. A stored "},{"id":"spn-59873","marks":["code"],"text":"agent_process"},{"id":"spn-59874","text":"/"},{"id":"spn-59875","marks":["code"],"text":"sandbox"},{"id":"spn-59876","text":" that lies therefore moves the derived episode id and fails the receipt comparison."}]},{"id":"blk-36610","items":[{"blocks":[{"id":"blk-36612","kind":"paragraph","spans":[{"id":"spn-59877","marks":["bold"],"text":"Sealed-implementation-driven replay wiring"},{"id":"spn-59878","text":" (step 5/11): the receipt's sealed"}]}],"id":"blk-36611","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-36613","kind":"paragraph","spans":[{"id":"spn-59879","text":"versions decide whether a scored signal is re-wired on replay. A demo that scores "},{"id":"spn-59880","marks":["code"],"text":"tests"},{"id":"spn-59881","text":"/"},{"id":"spn-59882","marks":["code"],"text":"identity"},{"id":"spn-59883","text":" but left them unwired (sealed impl null) does NOT go "},{"id":"spn-59884","marks":["code"],"text":"unavailable"},{"id":"spn-59885","text":" when the CLI happens to wire them — it stays unwired to match what was sealed. Only a non-null sealed implementation demands a matching-version verifier."}]},{"id":"blk-36614","items":[{"blocks":[{"id":"blk-36616","kind":"paragraph","spans":[{"id":"spn-59886","marks":["bold"],"text":"Idempotent reuse requires a full re-verify"},{"id":"spn-59887","text":" of the existing target (not just a"}]}],"id":"blk-36615","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-36617","kind":"paragraph","spans":[{"id":"spn-59888","text":"name/"},{"id":"spn-59889","marks":["code"],"text":"episode_id"},{"id":"spn-59890","text":" match), and a conflicting/corrupt target is a hard "},{"id":"spn-59891","marks":["code"],"text":"EpisodeBundleConflict"},{"id":"spn-59892","text":", never an overwrite."}]},{"id":"blk-36618","kind":"paragraph","spans":[{"id":"spn-59893","text":"Everything above is green with the real engine. No blocker — proceeding per the standing instruction. TestPlanV2 remains "},{"id":"spn-59894","marks":["bold"],"text":"not started"},{"id":"spn-59895","text":" as you directed."}]}],"edges":[],"id":"bagaaierav7flr534q77wh3cswme5vo574y4trinn5s7vgwryyhrlxbj4o5uq","vocabulary":"ampersand.docs.fs.v1"}