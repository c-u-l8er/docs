{"bendscript":"0.1","blocks":[{"id":"blk-91522","kind":"heading","level":1,"spans":[{"id":"spn-155355","text":"ADR-0004: Telemetry Integrity & Attribution Model (Deployment-Scoped Signed Events)"}]},{"id":"blk-91523","kind":"paragraph","spans":[{"id":"spn-155356","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-91524","items":[{"blocks":[{"id":"blk-91526","kind":"paragraph","spans":[{"id":"spn-155357","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-91525","kind":"list-item"},{"blocks":[{"id":"blk-91528","kind":"paragraph","spans":[{"id":"spn-155358","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-91527","kind":"list-item"},{"blocks":[{"id":"blk-91530","kind":"paragraph","spans":[{"id":"spn-155359","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-91529","kind":"list-item"},{"blocks":[{"id":"blk-91532","kind":"paragraph","spans":[{"id":"spn-155360","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-91531","kind":"list-item"},{"blocks":[{"id":"blk-91534","kind":"paragraph","spans":[{"id":"spn-155361","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-91533","kind":"list-item"},{"blocks":[{"id":"blk-91536","kind":"paragraph","spans":[{"id":"spn-155362","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-91535","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91537","kind":"heading","level":2,"spans":[{"id":"spn-155363","text":"Context"}]},{"id":"blk-91538","kind":"paragraph","spans":[{"id":"spn-155364","text":"webhost.systems is a multi-runtime AI agent platform. For each invocation executed in the data plane (Cloudflare Workers/DO or AWS Bedrock AgentCore), the platform must record usage and operational telemetry for:"}]},{"id":"blk-91539","items":[{"blocks":[{"id":"blk-91541","kind":"paragraph","spans":[{"id":"spn-155365","text":"plan enforcement (requests/tokens/compute limits),"}]}],"id":"blk-91540","kind":"list-item"},{"blocks":[{"id":"blk-91543","kind":"paragraph","spans":[{"id":"spn-155366","text":"cost estimation (v1: estimated cost),"}]}],"id":"blk-91542","kind":"list-item"},{"blocks":[{"id":"blk-91545","kind":"paragraph","spans":[{"id":"spn-155367","text":"billing integrity (tier gating and upgrade flows),"}]}],"id":"blk-91544","kind":"list-item"},{"blocks":[{"id":"blk-91547","kind":"paragraph","spans":[{"id":"spn-155368","text":"observability (error rates, latency/compute, tool usage),"}]}],"id":"blk-91546","kind":"list-item"},{"blocks":[{"id":"blk-91549","kind":"paragraph","spans":[{"id":"spn-155369","text":"audits and support (traceability via "},{"id":"spn-155370","marks":["code"],"text":"traceId"},{"id":"spn-155371","text":", deploy version, runtime)."}]}],"id":"blk-91548","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91550","kind":"paragraph","spans":[{"id":"spn-155372","text":"Telemetry is consumed by the control plane and stored as append-only raw events ("},{"id":"spn-155373","marks":["code"],"text":"metricsEvents"},{"id":"spn-155374","text":") and aggregated views ("},{"id":"spn-155375","marks":["code"],"text":"billingUsage"},{"id":"spn-155376","text":")."}]},{"id":"blk-91551","kind":"heading","level":3,"spans":[{"id":"spn-155377","text":"Problem statement"}]},{"id":"blk-91552","kind":"paragraph","spans":[{"id":"spn-155378","text":"Telemetry is a critical security and business integrity surface. If telemetry is spoofable or not attributable, an attacker (or buggy runtime) could:"}]},{"id":"blk-91553","items":[{"blocks":[{"id":"blk-91555","kind":"paragraph","spans":[{"id":"spn-155379","text":"underreport usage to avoid limits or billing,"}]}],"id":"blk-91554","kind":"list-item"},{"blocks":[{"id":"blk-91557","kind":"paragraph","spans":[{"id":"spn-155380","text":"overreport usage to sabotage another tenant,"}]}],"id":"blk-91556","kind":"list-item"},{"blocks":[{"id":"blk-91559","kind":"paragraph","spans":[{"id":"spn-155381","text":"inject events for another tenant’s agents/deployments,"}]}],"id":"blk-91558","kind":"list-item"},{"blocks":[{"id":"blk-91561","kind":"paragraph","spans":[{"id":"spn-155382","text":"create ambiguity in chargeback attribution across runtimes,"}]}],"id":"blk-91560","kind":"list-item"},{"blocks":[{"id":"blk-91563","kind":"paragraph","spans":[{"id":"spn-155383","text":"break observability and incident response."}]}],"id":"blk-91562","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91564","kind":"paragraph","spans":[{"id":"spn-155384","text":"Therefore telemetry ingestion must ensure:"}]},{"id":"blk-91565","items":[{"blocks":[{"id":"blk-91567","kind":"paragraph","spans":[{"id":"spn-155385","marks":["bold"],"text":"Integrity"},{"id":"spn-155386","text":": payload not tampered in transit."}]}],"id":"blk-91566","kind":"list-item"},{"blocks":[{"id":"blk-91569","kind":"paragraph","spans":[{"id":"spn-155387","marks":["bold"],"text":"Authenticity"},{"id":"spn-155388","text":": sender is an authorized runtime deployment."}]}],"id":"blk-91568","kind":"list-item"},{"blocks":[{"id":"blk-91571","kind":"paragraph","spans":[{"id":"spn-155389","marks":["bold"],"text":"Attribution"},{"id":"spn-155390","text":": event belongs to exactly one "},{"id":"spn-155391","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-155392","text":"."}]}],"id":"blk-91570","kind":"list-item"},{"blocks":[{"id":"blk-91573","kind":"paragraph","spans":[{"id":"spn-155393","marks":["bold"],"text":"Replay safety"},{"id":"spn-155394","text":": retries do not double count; attackers cannot re-submit old events to alter usage."}]}],"id":"blk-91572","kind":"list-item"},{"blocks":[{"id":"blk-91575","kind":"paragraph","spans":[{"id":"spn-155395","marks":["bold"],"text":"No secrets leakage"},{"id":"spn-155396","text":": telemetry must never include secret values, and telemetry auth secrets must not be stored as plaintext."}]}],"id":"blk-91574","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-91576","kind":"paragraph","spans":[{"id":"spn-155397","text":"Constraints:"}]},{"id":"blk-91577","items":[{"blocks":[{"id":"blk-91579","kind":"paragraph","spans":[{"id":"spn-155398","text":"Data plane runtimes are heterogeneous and may differ in what usage details they can report."}]}],"id":"blk-91578","kind":"list-item"},{"blocks":[{"id":"blk-91581","kind":"paragraph","spans":[{"id":"spn-155399","text":"Customer agent code is untrusted; it may attempt to forge telemetry or call arbitrary endpoints."}]}],"id":"blk-91580","kind":"list-item"},{"blocks":[{"id":"blk-91583","kind":"paragraph","spans":[{"id":"spn-155400","text":"Telemetry ingestion must not rely on browser sessions/cookies."}]}],"id":"blk-91582","kind":"list-item"},{"blocks":[{"id":"blk-91585","kind":"paragraph","spans":[{"id":"spn-155401","text":"The system must remain implementable for v1 without introducing a full centralized vault or complex PKI."}]}],"id":"blk-91584","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91586","kind":"heading","level":2,"spans":[{"id":"spn-155402","text":"Decision"}]},{"id":"blk-91587","kind":"paragraph","spans":[{"id":"spn-155403","text":"Adopt a "},{"id":"spn-155404","marks":["bold"],"text":"deployment-scoped signed telemetry event"},{"id":"spn-155405","text":" model with "},{"id":"spn-155406","marks":["bold"],"text":"ownership cross-checking"},{"id":"spn-155407","text":" at ingestion."}]},{"id":"blk-91588","kind":"heading","level":3,"spans":[{"id":"spn-155408","text":"Decision summary (normative)"}]},{"id":"blk-91589","items":[{"blocks":[{"id":"blk-91591","kind":"paragraph","spans":[{"id":"spn-155409","marks":["bold"],"text":"Attribution is mandatory"}]}],"id":"blk-91590","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-91592","kind":"paragraph","spans":[{"id":"spn-155410","text":"Every telemetry event MUST be attributable to:"}]},{"id":"blk-91593","items":[{"blocks":[{"id":"blk-91595","kind":"paragraph","spans":[{"id":"spn-155411","marks":["code"],"text":"userId"}]}],"id":"blk-91594","kind":"list-item"},{"blocks":[{"id":"blk-91597","kind":"paragraph","spans":[{"id":"spn-155412","marks":["code"],"text":"agentId"}]}],"id":"blk-91596","kind":"list-item"},{"blocks":[{"id":"blk-91599","kind":"paragraph","spans":[{"id":"spn-155413","marks":["code"],"text":"deploymentId"}]}],"id":"blk-91598","kind":"list-item"},{"blocks":[{"id":"blk-91601","kind":"paragraph","spans":[{"id":"spn-155414","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-91600","kind":"list-item"},{"blocks":[{"id":"blk-91603","kind":"paragraph","spans":[{"id":"spn-155415","marks":["code"],"text":"timestamp"}]}],"id":"blk-91602","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91604","items":[{"blocks":[{"id":"blk-91606","kind":"paragraph","spans":[{"id":"spn-155416","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped HMAC signatures (v1)"}]}],"id":"blk-91605","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-91607","items":[{"blocks":[{"id":"blk-91609","kind":"paragraph","spans":[{"id":"spn-155417","text":"Each deployment has a unique "},{"id":"spn-155418","marks":["code"],"text":"telemetrySecret"},{"id":"spn-155419","text":" (HMAC key), generated by the control plane."}]}],"id":"blk-91608","kind":"list-item"},{"blocks":[{"id":"blk-91611","kind":"paragraph","spans":[{"id":"spn-155420","text":"The "},{"id":"spn-155421","marks":["code"],"text":"telemetrySecret"},{"id":"spn-155422","text":" is injected into the deployed runtime using provider secret mechanisms."}]}],"id":"blk-91610","kind":"list-item"},{"blocks":[{"id":"blk-91613","kind":"paragraph","spans":[{"id":"spn-155423","text":"Data plane submits telemetry to the control plane ingestion endpoint with:"}]}],"id":"blk-91612","kind":"list-item"},{"blocks":[{"id":"blk-91615","kind":"paragraph","spans":[{"id":"spn-155424","text":"header "},{"id":"spn-155425","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-91614","kind":"list-item"},{"blocks":[{"id":"blk-91617","kind":"paragraph","spans":[{"id":"spn-155426","text":"header "},{"id":"spn-155427","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex(hmac_sha256(raw_body_bytes, telemetrySecret))>"}]}],"id":"blk-91616","kind":"list-item"},{"blocks":[{"id":"blk-91619","kind":"paragraph","spans":[{"id":"spn-155428","text":"Control plane verifies:"}]}],"id":"blk-91618","kind":"list-item"},{"blocks":[{"id":"blk-91621","kind":"paragraph","spans":[{"id":"spn-155429","text":"signature validity (using deployment-scoped secret reference),"}]}],"id":"blk-91620","kind":"list-item"},{"blocks":[{"id":"blk-91623","kind":"paragraph","spans":[{"id":"spn-155430","text":"ownership mapping: deployment belongs to the agent and user in the payload,"}]}],"id":"blk-91622","kind":"list-item"},{"blocks":[{"id":"blk-91625","kind":"paragraph","spans":[{"id":"spn-155431","text":"required fields and enums."}]}],"id":"blk-91624","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91626","items":[{"blocks":[{"id":"blk-91628","kind":"paragraph","spans":[{"id":"spn-155432","marks":["bold"],"text":"Ingestion performs ownership cross-check (defense in depth)"}]}],"id":"blk-91627","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-91629","kind":"paragraph","spans":[{"id":"spn-155433","text":"After signature validation, ingestion MUST query control plane data and verify:"}]},{"id":"blk-91630","items":[{"blocks":[{"id":"blk-91632","kind":"paragraph","spans":[{"id":"spn-155434","marks":["code"],"text":"deployments._id == deploymentId"}]}],"id":"blk-91631","kind":"list-item"},{"blocks":[{"id":"blk-91634","kind":"paragraph","spans":[{"id":"spn-155435","marks":["code"],"text":"deployments.agentId == agentId"}]}],"id":"blk-91633","kind":"list-item"},{"blocks":[{"id":"blk-91636","kind":"paragraph","spans":[{"id":"spn-155436","marks":["code"],"text":"deployments.userId == userId"}]}],"id":"blk-91635","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91637","kind":"paragraph","spans":[{"id":"spn-155437","text":"If any mismatch: reject the event, optionally record an "},{"id":"spn-155438","marks":["code"],"text":"auditLog"},{"id":"spn-155439","text":" entry with sanitized details."}]},{"id":"blk-91638","items":[{"blocks":[{"id":"blk-91640","kind":"paragraph","spans":[{"id":"spn-155440","marks":["bold"],"text":"Telemetry does not use user auth"}]}],"id":"blk-91639","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-91641","kind":"paragraph","spans":[{"id":"spn-155441","text":"Telemetry ingestion MUST NOT accept browser session cookies as authentication. Telemetry is authenticated solely by deployment-scoped signature (and optional anti-replay)."}]},{"id":"blk-91642","items":[{"blocks":[{"id":"blk-91644","kind":"paragraph","spans":[{"id":"spn-155442","marks":["bold"],"text":"Replay/dedupe (recommended in v1; mandatory before public invocations)"}]}],"id":"blk-91643","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-91645","kind":"paragraph","spans":[{"id":"spn-155443","text":"Telemetry ingestion SHOULD implement one of:"}]},{"id":"blk-91646","items":[{"blocks":[{"id":"blk-91648","kind":"paragraph","spans":[{"id":"spn-155444","marks":["code"],"text":"eventId"},{"id":"spn-155445","text":" (UUID generated by data plane) + short-window dedupe store, OR"}]}],"id":"blk-91647","kind":"list-item"},{"blocks":[{"id":"blk-91650","kind":"paragraph","spans":[{"id":"spn-155446","text":"dedupe on "},{"id":"spn-155447","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-155448","text":" if "},{"id":"spn-155449","marks":["code"],"text":"traceId"},{"id":"spn-155450","text":" uniqueness per invocation is guaranteed."}]}],"id":"blk-91649","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91651","kind":"paragraph","spans":[{"id":"spn-155451","text":"In either case, ingestion must be idempotent under retries to prevent double counting."}]},{"id":"blk-91652","items":[{"blocks":[{"id":"blk-91654","kind":"paragraph","spans":[{"id":"spn-155452","marks":["bold"],"text":"Secrets are never stored as plaintext in the primary DB"}]}],"id":"blk-91653","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-91655","items":[{"blocks":[{"id":"blk-91657","kind":"paragraph","spans":[{"id":"spn-155453","text":"The primary DB stores only metadata and secret references (e.g., provider secret name/id)."}]}],"id":"blk-91656","kind":"list-item"},{"blocks":[{"id":"blk-91659","kind":"paragraph","spans":[{"id":"spn-155454","text":"The "},{"id":"spn-155455","marks":["code"],"text":"telemetrySecret"},{"id":"spn-155456","text":" value MUST NOT be stored in plaintext in the primary database (Supabase)."}]}],"id":"blk-91658","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91660","kind":"heading","level":3,"spans":[{"id":"spn-155457","text":"Provider-specific telemetry capabilities (implementation guidance)"}]},{"id":"blk-91661","kind":"paragraph","spans":[{"id":"spn-155458","text":"This ADR standardizes telemetry ingestion on "},{"id":"spn-155459","marks":["bold"],"text":"deployment-scoped signed events"},{"id":"spn-155460","text":" for all runtimes. Provider capabilities vary, but the v1 baseline remains consistent."}]},{"id":"blk-91662","kind":"paragraph","spans":[{"id":"spn-155461","marks":["bold"],"text":"Cloudflare (Workers + Durable Objects):"}]},{"id":"blk-91663","items":[{"blocks":[{"id":"blk-91665","kind":"paragraph","spans":[{"id":"spn-155462","text":"The runtime MUST explicitly emit telemetry to the control plane (Pattern A: in-workload emission is the preferred approach)."}]}],"id":"blk-91664","kind":"list-item"},{"blocks":[{"id":"blk-91667","kind":"paragraph","spans":[{"id":"spn-155463","text":"The telemetry signing secret is injected via Worker secret bindings."}]}],"id":"blk-91666","kind":"list-item"},{"blocks":[{"id":"blk-91669","kind":"paragraph","spans":[{"id":"spn-155464","text":"The Worker/DO submits "},{"id":"spn-155465","marks":["code"],"text":"POST /v1/telemetry/report"},{"id":"spn-155466","text":" with "},{"id":"spn-155467","marks":["code"],"text":"X-Telemetry-Deployment-Id"},{"id":"spn-155468","text":" and "},{"id":"spn-155469","marks":["code"],"text":"X-Telemetry-Signature"},{"id":"spn-155470","text":"."}]}],"id":"blk-91668","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91670","kind":"paragraph","spans":[{"id":"spn-155471","marks":["bold"],"text":"AgentCore (AWS Bedrock AgentCore):"}]},{"id":"blk-91671","items":[{"blocks":[{"id":"blk-91673","kind":"paragraph","spans":[{"id":"spn-155472","text":"AgentCore may provide provider-native observability capabilities (e.g., service-level telemetry/OTel-style integrations) that can be valuable for deep debugging."}]}],"id":"blk-91672","kind":"list-item"},{"blocks":[{"id":"blk-91675","kind":"paragraph","spans":[{"id":"spn-155473","marks":["bold"],"text":"v1 baseline:"},{"id":"spn-155474","text":" use the same direct signed submission model as Cloudflare (either in-workload emission when feasible, or adapter-side emission when required by provider constraints) to keep metering, limits, and billing semantics consistent across runtimes."}]}],"id":"blk-91674","kind":"list-item"},{"blocks":[{"id":"blk-91677","kind":"paragraph","spans":[{"id":"spn-155475","marks":["bold"],"text":"post-v1 enhancement:"},{"id":"spn-155476","text":" integrate provider-native observability for richer traces while still emitting the normalized, signed metering event used for billing and limits."}]}],"id":"blk-91676","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91678","kind":"heading","level":2,"spans":[{"id":"spn-155477","text":"Rationale"}]},{"id":"blk-91679","kind":"paragraph","spans":[{"id":"spn-155478","text":"This approach satisfies the requirements with minimal complexity:"}]},{"id":"blk-91680","items":[{"blocks":[{"id":"blk-91682","kind":"paragraph","spans":[{"id":"spn-155479","marks":["bold"],"text":"Integrity and authenticity"},{"id":"spn-155480","text":": HMAC signatures prevent tampering and authenticate possession of a deployment-scoped secret."}]}],"id":"blk-91681","kind":"list-item"},{"blocks":[{"id":"blk-91684","kind":"paragraph","spans":[{"id":"spn-155481","marks":["bold"],"text":"Tenant protection"},{"id":"spn-155482","text":": ownership cross-check prevents a compromised deployment secret from being used to write events for a different agent or user."}]}],"id":"blk-91683","kind":"list-item"},{"blocks":[{"id":"blk-91686","kind":"paragraph","spans":[{"id":"spn-155483","marks":["bold"],"text":"Least privilege"},{"id":"spn-155484","text":": deployment-scoped secret limits blast radius if compromised."}]}],"id":"blk-91685","kind":"list-item"},{"blocks":[{"id":"blk-91688","kind":"paragraph","spans":[{"id":"spn-155485","marks":["bold"],"text":"Provider portability"},{"id":"spn-155486","text":": works across runtimes because it relies on a generic “can send HTTP + store secret” capability."}]}],"id":"blk-91687","kind":"list-item"},{"blocks":[{"id":"blk-91690","kind":"paragraph","spans":[{"id":"spn-155487","marks":["bold"],"text":"Operable MVP"},{"id":"spn-155488","text":": avoids the need for PKI or an always-online centralized vault, while still enabling strong guarantees."}]}],"id":"blk-91689","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91691","kind":"heading","level":2,"spans":[{"id":"spn-155489","text":"Alternatives considered"}]},{"id":"blk-91692","kind":"heading","level":3,"spans":[{"id":"spn-155490","text":"A) Trust telemetry without signatures (reject)"}]},{"id":"blk-91693","kind":"paragraph","spans":[{"id":"spn-155491","marks":["bold"],"text":"Pros"}]},{"id":"blk-91694","items":[{"blocks":[{"id":"blk-91696","kind":"paragraph","spans":[{"id":"spn-155492","text":"Easiest to implement."}]}],"id":"blk-91695","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91697","kind":"paragraph","spans":[{"id":"spn-155493","marks":["bold"],"text":"Cons"}]},{"id":"blk-91698","items":[{"blocks":[{"id":"blk-91700","kind":"paragraph","spans":[{"id":"spn-155494","text":"Enables trivial spoofing and billing manipulation."}]}],"id":"blk-91699","kind":"list-item"},{"blocks":[{"id":"blk-91702","kind":"paragraph","spans":[{"id":"spn-155495","text":"Allows cross-tenant sabotage and incorrect usage enforcement."}]}],"id":"blk-91701","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91703","kind":"paragraph","spans":[{"id":"spn-155496","marks":["bold"],"text":"Decision"},{"id":"spn-155497","text":" Rejected. Not acceptable for any paid system with limits and billing."}]},{"id":"blk-91704","kind":"heading","level":3,"spans":[{"id":"spn-155498","text":"B) Adapter-side telemetry only (partial alternative)"}]},{"id":"blk-91705","kind":"paragraph","spans":[{"id":"spn-155499","text":"Telemetry is emitted only by the control plane adapter after it receives provider responses."}]},{"id":"blk-91706","kind":"paragraph","spans":[{"id":"spn-155500","marks":["bold"],"text":"Pros"}]},{"id":"blk-91707","items":[{"blocks":[{"id":"blk-91709","kind":"paragraph","spans":[{"id":"spn-155501","text":"Avoids injecting telemetry secrets into runtime code."}]}],"id":"blk-91708","kind":"list-item"},{"blocks":[{"id":"blk-91711","kind":"paragraph","spans":[{"id":"spn-155502","text":"Avoids runtime outbound call to control plane."}]}],"id":"blk-91710","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91712","kind":"paragraph","spans":[{"id":"spn-155503","marks":["bold"],"text":"Cons"}]},{"id":"blk-91713","items":[{"blocks":[{"id":"blk-91715","kind":"paragraph","spans":[{"id":"spn-155504","text":"Often cannot capture provider-specific usage (compute/tool usage) reliably."}]}],"id":"blk-91714","kind":"list-item"},{"blocks":[{"id":"blk-91717","kind":"paragraph","spans":[{"id":"spn-155505","text":"Creates attribution gaps if invocations happen outside the adapter path or if provider returns incomplete usage."}]}],"id":"blk-91716","kind":"list-item"},{"blocks":[{"id":"blk-91719","kind":"paragraph","spans":[{"id":"spn-155506","text":"Weakens correlation with runtime events and can undercount."}]}],"id":"blk-91718","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91720","kind":"paragraph","spans":[{"id":"spn-155507","marks":["bold"],"text":"Decision"},{"id":"spn-155508","text":" Not the primary model. Allowed as a constrained fallback if a provider cannot support in-workload emission, but must preserve integrity and attribution. If adapter emits, it must still attach to a deployment and enforce ownership; it must not be forgeable by clients."}]},{"id":"blk-91721","kind":"heading","level":3,"spans":[{"id":"spn-155509","text":"C) Per-user telemetry keys (reject)"}]},{"id":"blk-91722","kind":"paragraph","spans":[{"id":"spn-155510","text":"Use one key per user shared across all deployments."}]},{"id":"blk-91723","kind":"paragraph","spans":[{"id":"spn-155511","marks":["bold"],"text":"Pros"}]},{"id":"blk-91724","items":[{"blocks":[{"id":"blk-91726","kind":"paragraph","spans":[{"id":"spn-155512","text":"Fewer secrets."}]}],"id":"blk-91725","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91727","kind":"paragraph","spans":[{"id":"spn-155513","marks":["bold"],"text":"Cons"}]},{"id":"blk-91728","items":[{"blocks":[{"id":"blk-91730","kind":"paragraph","spans":[{"id":"spn-155514","text":"Massive blast radius if compromised; compromised deployment can spoof across all user deployments."}]}],"id":"blk-91729","kind":"list-item"},{"blocks":[{"id":"blk-91732","kind":"paragraph","spans":[{"id":"spn-155515","text":"Harder to rotate safely and isolate issues."}]}],"id":"blk-91731","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91733","kind":"paragraph","spans":[{"id":"spn-155516","marks":["bold"],"text":"Decision"},{"id":"spn-155517","text":" Rejected. Deployment-scoped keys are safer and align with immutability and auditability."}]},{"id":"blk-91734","kind":"heading","level":3,"spans":[{"id":"spn-155518","text":"D) Public-key signatures (PKI) per deployment (defer)"}]},{"id":"blk-91735","kind":"paragraph","spans":[{"id":"spn-155519","text":"Each deployment gets a keypair; telemetry signed with private key, verified with public key."}]},{"id":"blk-91736","kind":"paragraph","spans":[{"id":"spn-155520","marks":["bold"],"text":"Pros"}]},{"id":"blk-91737","items":[{"blocks":[{"id":"blk-91739","kind":"paragraph","spans":[{"id":"spn-155521","text":"No shared secret at ingestion; avoids secret distribution to verifier."}]}],"id":"blk-91738","kind":"list-item"},{"blocks":[{"id":"blk-91741","kind":"paragraph","spans":[{"id":"spn-155522","text":"Strong cryptographic model."}]}],"id":"blk-91740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91742","kind":"paragraph","spans":[{"id":"spn-155523","marks":["bold"],"text":"Cons"}]},{"id":"blk-91743","items":[{"blocks":[{"id":"blk-91745","kind":"paragraph","spans":[{"id":"spn-155524","text":"Adds key management complexity; still needs secure private key injection to runtime."}]}],"id":"blk-91744","kind":"list-item"},{"blocks":[{"id":"blk-91747","kind":"paragraph","spans":[{"id":"spn-155525","text":"Higher implementation overhead for v1 without clear ROI."}]}],"id":"blk-91746","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91748","kind":"paragraph","spans":[{"id":"spn-155526","marks":["bold"],"text":"Decision"},{"id":"spn-155527","text":" Deferred. Consider post-v1 if you need stronger non-repudiation or third-party verification."}]},{"id":"blk-91749","kind":"heading","level":3,"spans":[{"id":"spn-155528","text":"E) mTLS between data plane and control plane (defer)"}]},{"id":"blk-91750","kind":"paragraph","spans":[{"id":"spn-155529","text":"Use mutual TLS with client certs per deployment."}]},{"id":"blk-91751","kind":"paragraph","spans":[{"id":"spn-155530","marks":["bold"],"text":"Pros"}]},{"id":"blk-91752","items":[{"blocks":[{"id":"blk-91754","kind":"paragraph","spans":[{"id":"spn-155531","text":"Strong channel-level authentication."}]}],"id":"blk-91753","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91755","kind":"paragraph","spans":[{"id":"spn-155532","marks":["bold"],"text":"Cons"}]},{"id":"blk-91756","items":[{"blocks":[{"id":"blk-91758","kind":"paragraph","spans":[{"id":"spn-155533","text":"Operationally heavy; certificate issuance/rotation complexity."}]}],"id":"blk-91757","kind":"list-item"},{"blocks":[{"id":"blk-91760","kind":"paragraph","spans":[{"id":"spn-155534","text":"Hard to implement uniformly across runtimes."}]}],"id":"blk-91759","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91761","kind":"paragraph","spans":[{"id":"spn-155535","marks":["bold"],"text":"Decision"},{"id":"spn-155536","text":" Deferred. Potential future hardening for enterprise tiers."}]},{"id":"blk-91762","kind":"heading","level":2,"spans":[{"id":"spn-155537","text":"Detailed design (normative)"}]},{"id":"blk-91763","kind":"heading","level":3,"spans":[{"id":"spn-155538","text":"1) Telemetry event schema (minimum viable)"}]},{"id":"blk-91764","kind":"paragraph","spans":[{"id":"spn-155539","text":"Telemetry payload MUST include:"}]},{"id":"blk-91765","items":[{"blocks":[{"id":"blk-91767","kind":"paragraph","spans":[{"id":"spn-155540","marks":["code"],"text":"userId"},{"id":"spn-155541","text":" (internal id)"}]}],"id":"blk-91766","kind":"list-item"},{"blocks":[{"id":"blk-91769","kind":"paragraph","spans":[{"id":"spn-155542","marks":["code"],"text":"agentId"}]}],"id":"blk-91768","kind":"list-item"},{"blocks":[{"id":"blk-91771","kind":"paragraph","spans":[{"id":"spn-155543","marks":["code"],"text":"deploymentId"}]}],"id":"blk-91770","kind":"list-item"},{"blocks":[{"id":"blk-91773","kind":"paragraph","spans":[{"id":"spn-155544","marks":["code"],"text":"runtimeProvider"},{"id":"spn-155545","text":" ("},{"id":"spn-155546","marks":["code"],"text":"cloudflare"},{"id":"spn-155547","text":" | "},{"id":"spn-155548","marks":["code"],"text":"agentcore"},{"id":"spn-155549","text":")"}]}],"id":"blk-91772","kind":"list-item"},{"blocks":[{"id":"blk-91775","kind":"paragraph","spans":[{"id":"spn-155550","marks":["code"],"text":"timestamp"},{"id":"spn-155551","text":" (RFC3339 or unix ms; ingestion converts to unix ms)"}]}],"id":"blk-91774","kind":"list-item"},{"blocks":[{"id":"blk-91777","kind":"paragraph","spans":[{"id":"spn-155552","marks":["code"],"text":"requests"},{"id":"spn-155553","text":" (typically 1)"}]}],"id":"blk-91776","kind":"list-item"},{"blocks":[{"id":"blk-91779","kind":"paragraph","spans":[{"id":"spn-155554","marks":["code"],"text":"llmTokens"},{"id":"spn-155555","text":" (reported or estimated)"}]}],"id":"blk-91778","kind":"list-item"},{"blocks":[{"id":"blk-91781","kind":"paragraph","spans":[{"id":"spn-155556","marks":["code"],"text":"computeMs"},{"id":"spn-155557","text":" (wall time or billed time, defined per provider)"}]}],"id":"blk-91780","kind":"list-item"},{"blocks":[{"id":"blk-91783","kind":"paragraph","spans":[{"id":"spn-155558","marks":["code"],"text":"errors"},{"id":"spn-155559","text":" (0/1 typical)"}]}],"id":"blk-91782","kind":"list-item"},{"blocks":[{"id":"blk-91785","kind":"paragraph","spans":[{"id":"spn-155560","marks":["code"],"text":"errorClass"},{"id":"spn-155561","text":" (optional: "},{"id":"spn-155562","marks":["code"],"text":"auth | limit | runtime | tool | unknown"},{"id":"spn-155563","text":")"}]}],"id":"blk-91784","kind":"list-item"},{"blocks":[{"id":"blk-91787","kind":"paragraph","spans":[{"id":"spn-155564","marks":["code"],"text":"costUsdEstimated"}]}],"id":"blk-91786","kind":"list-item"},{"blocks":[{"id":"blk-91789","kind":"paragraph","spans":[{"id":"spn-155565","marks":["code"],"text":"traceId"},{"id":"spn-155566","text":" (optional but recommended)"}]}],"id":"blk-91788","kind":"list-item"},{"blocks":[{"id":"blk-91791","kind":"paragraph","spans":[{"id":"spn-155567","marks":["code"],"text":"provider"},{"id":"spn-155568","text":" (optional runtime-specific counters)"}]}],"id":"blk-91790","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91792","kind":"paragraph","spans":[{"id":"spn-155569","text":"Telemetry MUST NOT include:"}]},{"id":"blk-91793","items":[{"blocks":[{"id":"blk-91795","kind":"paragraph","spans":[{"id":"spn-155570","text":"plaintext secrets,"}]}],"id":"blk-91794","kind":"list-item"},{"blocks":[{"id":"blk-91797","kind":"paragraph","spans":[{"id":"spn-155571","text":"full prompts/responses by default (unless an explicit opt-in feature is added later),"}]}],"id":"blk-91796","kind":"list-item"},{"blocks":[{"id":"blk-91799","kind":"paragraph","spans":[{"id":"spn-155572","text":"raw provider credential material."}]}],"id":"blk-91798","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91800","kind":"heading","level":3,"spans":[{"id":"spn-155573","text":"2) Signature computation"}]},{"id":"blk-91801","items":[{"blocks":[{"id":"blk-91803","kind":"paragraph","spans":[{"id":"spn-155574","text":"Signature is computed over the exact raw request body bytes as received/sent."}]}],"id":"blk-91802","kind":"list-item"},{"blocks":[{"id":"blk-91805","kind":"paragraph","spans":[{"id":"spn-155575","text":"Algorithm: "},{"id":"spn-155576","marks":["code"],"text":"HMAC_SHA256(telemetrySecret, raw_body_bytes)"},{"id":"spn-155577","text":"."}]}],"id":"blk-91804","kind":"list-item"},{"blocks":[{"id":"blk-91807","kind":"paragraph","spans":[{"id":"spn-155578","text":"Encoding: hex lowercase recommended."}]}],"id":"blk-91806","kind":"list-item"},{"blocks":[{"id":"blk-91809","kind":"paragraph","spans":[{"id":"spn-155579","text":"Header format: "},{"id":"spn-155580","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex>"},{"id":"spn-155581","text":"."}]}],"id":"blk-91808","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91810","kind":"paragraph","spans":[{"id":"spn-155582","text":"Canonicalization note:"}]},{"id":"blk-91811","items":[{"blocks":[{"id":"blk-91813","kind":"paragraph","spans":[{"id":"spn-155583","text":"The verifier MUST use the raw body bytes, not a re-serialized JSON object."}]}],"id":"blk-91812","kind":"list-item"},{"blocks":[{"id":"blk-91815","kind":"paragraph","spans":[{"id":"spn-155584","text":"If your framework modifies request bodies, capture raw bytes before parsing."}]}],"id":"blk-91814","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91816","kind":"heading","level":3,"spans":[{"id":"spn-155585","text":"3) Ingestion validation steps (MUST)"}]},{"id":"blk-91817","kind":"paragraph","spans":[{"id":"spn-155586","text":"In order:"}]},{"id":"blk-91818","items":[{"blocks":[{"id":"blk-91820","kind":"paragraph","spans":[{"id":"spn-155587","text":"Read "},{"id":"spn-155588","marks":["code"],"text":"deploymentId"},{"id":"spn-155589","text":" header and locate deployment record."}]}],"id":"blk-91819","kind":"list-item"},{"blocks":[{"id":"blk-91822","kind":"paragraph","spans":[{"id":"spn-155590","text":"Fetch deployment-scoped secret reference and verify signature."}]}],"id":"blk-91821","kind":"list-item"},{"blocks":[{"id":"blk-91824","kind":"paragraph","spans":[{"id":"spn-155591","text":"Parse JSON body and validate required fields and enums."}]}],"id":"blk-91823","kind":"list-item"},{"blocks":[{"id":"blk-91826","kind":"paragraph","spans":[{"id":"spn-155592","text":"Ownership cross-check:"}]}],"id":"blk-91825","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-91827","items":[{"blocks":[{"id":"blk-91829","kind":"paragraph","spans":[{"id":"spn-155593","marks":["code"],"text":"deployments.userId == body.userId"}]}],"id":"blk-91828","kind":"list-item"},{"blocks":[{"id":"blk-91831","kind":"paragraph","spans":[{"id":"spn-155594","marks":["code"],"text":"deployments.agentId == body.agentId"}]}],"id":"blk-91830","kind":"list-item"},{"blocks":[{"id":"blk-91833","kind":"paragraph","spans":[{"id":"spn-155595","marks":["code"],"text":"deployments._id == body.deploymentId"},{"id":"spn-155596","text":" (or match header)"}]}],"id":"blk-91832","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91834","items":[{"blocks":[{"id":"blk-91836","kind":"paragraph","spans":[{"id":"spn-155597","text":"Dedupe/idempotency:"}]}],"id":"blk-91835","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-91837","items":[{"blocks":[{"id":"blk-91839","kind":"paragraph","spans":[{"id":"spn-155598","text":"if "},{"id":"spn-155599","marks":["code"],"text":"eventId"},{"id":"spn-155600","text":" used: reject or no-op if already processed in dedupe window"}]}],"id":"blk-91838","kind":"list-item"},{"blocks":[{"id":"blk-91841","kind":"paragraph","spans":[{"id":"spn-155601","text":"if "},{"id":"spn-155602","marks":["code"],"text":"traceId"},{"id":"spn-155603","text":" used: ensure uniqueness per "},{"id":"spn-155604","marks":["code"],"text":"(deploymentId, traceId)"},{"id":"spn-155605","text":" in dedupe window"}]}],"id":"blk-91840","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91842","items":[{"blocks":[{"id":"blk-91844","kind":"paragraph","spans":[{"id":"spn-155606","text":"Persist event append-only."}]}],"id":"blk-91843","kind":"list-item"},{"blocks":[{"id":"blk-91846","kind":"paragraph","spans":[{"id":"spn-155607","text":"Optionally update incremental counters."}]}],"id":"blk-91845","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-91847","kind":"paragraph","spans":[{"id":"spn-155608","text":"If any step fails:"}]},{"id":"blk-91848","items":[{"blocks":[{"id":"blk-91850","kind":"paragraph","spans":[{"id":"spn-155609","text":"respond with normalized error (for non-telemetry callers, keep generic),"}]}],"id":"blk-91849","kind":"list-item"},{"blocks":[{"id":"blk-91852","kind":"paragraph","spans":[{"id":"spn-155610","text":"DO NOT reveal secret or internal details,"}]}],"id":"blk-91851","kind":"list-item"},{"blocks":[{"id":"blk-91854","kind":"paragraph","spans":[{"id":"spn-155611","text":"optionally write a sanitized "},{"id":"spn-155612","marks":["code"],"text":"auditLog"},{"id":"spn-155613","text":" entry for investigation."}]}],"id":"blk-91853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91855","kind":"heading","level":3,"spans":[{"id":"spn-155614","text":"4) Secret generation and rotation"}]},{"id":"blk-91856","items":[{"blocks":[{"id":"blk-91858","kind":"paragraph","spans":[{"id":"spn-155615","text":"Generate a new telemetry secret on every new deployment by default."}]}],"id":"blk-91857","kind":"list-item"},{"blocks":[{"id":"blk-91860","kind":"paragraph","spans":[{"id":"spn-155616","text":"Inject the secret into the runtime provider as a secret (not as plain env var stored in DB)."}]}],"id":"blk-91859","kind":"list-item"},{"blocks":[{"id":"blk-91862","kind":"paragraph","spans":[{"id":"spn-155617","text":"Rotation policy:"}]}],"id":"blk-91861","kind":"list-item"},{"blocks":[{"id":"blk-91864","kind":"paragraph","spans":[{"id":"spn-155618","text":"New deployment => new telemetry secret (mandatory)."}]}],"id":"blk-91863","kind":"list-item"},{"blocks":[{"id":"blk-91866","kind":"paragraph","spans":[{"id":"spn-155619","text":"Old deployments retain old secret for the duration they might emit telemetry (but they should not emit after deactivation, except in-flight retries)."}]}],"id":"blk-91865","kind":"list-item"},{"blocks":[{"id":"blk-91868","kind":"paragraph","spans":[{"id":"spn-155620","text":"Keep verification capability for a bounded time window after deactivation to allow late telemetry retries."}]}],"id":"blk-91867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91869","kind":"heading","level":3,"spans":[{"id":"spn-155621","text":"5) Telemetry retries and ingestion availability"}]},{"id":"blk-91870","items":[{"blocks":[{"id":"blk-91872","kind":"paragraph","spans":[{"id":"spn-155622","text":"Data plane SHOULD retry telemetry submission with exponential backoff (bounded)."}]}],"id":"blk-91871","kind":"list-item"},{"blocks":[{"id":"blk-91874","kind":"paragraph","spans":[{"id":"spn-155623","text":"Data plane SHOULD NOT block user-visible invocation completion while retrying telemetry."}]}],"id":"blk-91873","kind":"list-item"},{"blocks":[{"id":"blk-91876","kind":"paragraph","spans":[{"id":"spn-155624","text":"Control plane SHOULD expose internal health metrics for telemetry ingestion rate and rejection counts."}]}],"id":"blk-91875","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91877","kind":"heading","level":2,"spans":[{"id":"spn-155625","text":"Consequences"}]},{"id":"blk-91878","kind":"heading","level":3,"spans":[{"id":"spn-155626","text":"Positive"}]},{"id":"blk-91879","items":[{"blocks":[{"id":"blk-91881","kind":"paragraph","spans":[{"id":"spn-155627","text":"Strong billing and limits integrity foundation."}]}],"id":"blk-91880","kind":"list-item"},{"blocks":[{"id":"blk-91883","kind":"paragraph","spans":[{"id":"spn-155628","text":"Provider-agnostic design that scales to new runtimes."}]}],"id":"blk-91882","kind":"list-item"},{"blocks":[{"id":"blk-91885","kind":"paragraph","spans":[{"id":"spn-155629","text":"Reduced blast radius via deployment-scoped secrets."}]}],"id":"blk-91884","kind":"list-item"},{"blocks":[{"id":"blk-91887","kind":"paragraph","spans":[{"id":"spn-155630","text":"Clear audit path for telemetry failures and spoof attempts."}]}],"id":"blk-91886","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91888","kind":"heading","level":3,"spans":[{"id":"spn-155631","text":"Negative / tradeoffs"}]},{"id":"blk-91889","items":[{"blocks":[{"id":"blk-91891","kind":"paragraph","spans":[{"id":"spn-155632","text":"Requires deploying a telemetry secret per deployment and managing injection per provider."}]}],"id":"blk-91890","kind":"list-item"},{"blocks":[{"id":"blk-91893","kind":"paragraph","spans":[{"id":"spn-155633","text":"Requires careful handling of raw request bytes for correct signature verification."}]}],"id":"blk-91892","kind":"list-item"},{"blocks":[{"id":"blk-91895","kind":"paragraph","spans":[{"id":"spn-155634","text":"Adds complexity to runtime code (Pattern A emission) or to adapters (Pattern B emission)."}]}],"id":"blk-91894","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91896","kind":"heading","level":2,"spans":[{"id":"spn-155635","text":"Implementation requirements (checklist)"}]},{"id":"blk-91897","items":[{"blocks":[{"id":"blk-91899","kind":"paragraph","spans":[{"id":"spn-155636","text":"[ ] Each deployment has a telemetry signing secret generated by the control plane."}]}],"id":"blk-91898","kind":"list-item"},{"blocks":[{"id":"blk-91901","kind":"paragraph","spans":[{"id":"spn-155637","text":"[ ] Secret is injected into the runtime provider using provider secret mechanisms."}]}],"id":"blk-91900","kind":"list-item"},{"blocks":[{"id":"blk-91903","kind":"paragraph","spans":[{"id":"spn-155638","text":"[ ] Telemetry endpoint verifies signature using raw request body bytes."}]}],"id":"blk-91902","kind":"list-item"},{"blocks":[{"id":"blk-91905","kind":"paragraph","spans":[{"id":"spn-155639","text":"[ ] Telemetry endpoint cross-checks "},{"id":"spn-155640","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-155641","text":" ownership."}]}],"id":"blk-91904","kind":"list-item"},{"blocks":[{"id":"blk-91907","kind":"paragraph","spans":[{"id":"spn-155642","text":"[ ] Telemetry endpoint is not authenticated via browser sessions/cookies."}]}],"id":"blk-91906","kind":"list-item"},{"blocks":[{"id":"blk-91909","kind":"paragraph","spans":[{"id":"spn-155643","text":"[ ] Telemetry ingestion is idempotent under retries (dedupe window)."}]}],"id":"blk-91908","kind":"list-item"},{"blocks":[{"id":"blk-91911","kind":"paragraph","spans":[{"id":"spn-155644","text":"[ ] Telemetry payloads do not include secret values or full prompt contents by default."}]}],"id":"blk-91910","kind":"list-item"},{"blocks":[{"id":"blk-91913","kind":"paragraph","spans":[{"id":"spn-155645","text":"[ ] Telemetry rejection and signature failures are auditable (sanitized audit log)."}]}],"id":"blk-91912","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91914","kind":"heading","level":2,"spans":[{"id":"spn-155646","text":"Acceptance criteria"}]},{"id":"blk-91915","kind":"paragraph","spans":[{"id":"spn-155647","text":"This ADR is considered correctly implemented when:"}]},{"id":"blk-91916","items":[{"blocks":[{"id":"blk-91918","kind":"paragraph","spans":[{"id":"spn-155648","text":"A valid telemetry payload signed with the correct deployment secret is accepted and persisted."}]}],"id":"blk-91917","kind":"list-item"},{"blocks":[{"id":"blk-91920","kind":"paragraph","spans":[{"id":"spn-155649","text":"The same payload with an invalid signature is rejected and not persisted."}]}],"id":"blk-91919","kind":"list-item"},{"blocks":[{"id":"blk-91922","kind":"paragraph","spans":[{"id":"spn-155650","text":"A valid signature with mismatched ownership (deployment belongs to a different agent/user) is rejected."}]}],"id":"blk-91921","kind":"list-item"},{"blocks":[{"id":"blk-91924","kind":"paragraph","spans":[{"id":"spn-155651","text":"Retried telemetry submissions do not cause double-counting within the dedupe strategy window."}]}],"id":"blk-91923","kind":"list-item"},{"blocks":[{"id":"blk-91926","kind":"paragraph","spans":[{"id":"spn-155652","text":"No plaintext telemetry secret values exist in the primary DB."}]}],"id":"blk-91925","kind":"list-item"},{"blocks":[{"id":"blk-91928","kind":"paragraph","spans":[{"id":"spn-155653","text":"Telemetry events are attributable to "},{"id":"spn-155654","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-155655","text":" and can be aggregated reliably for billing and limits."}]}],"id":"blk-91927","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-91929","kind":"heading","level":2,"spans":[{"id":"spn-155656","text":"Follow-ups"}]},{"id":"blk-91930","items":[{"blocks":[{"id":"blk-91932","kind":"paragraph","spans":[{"id":"spn-155657","text":"ADR-0005: Deployment immutability + active pointer model (if not already documented as ADR)."}]}],"id":"blk-91931","kind":"list-item"},{"blocks":[{"id":"blk-91934","kind":"paragraph","spans":[{"id":"spn-155658","text":"Define a standardized "},{"id":"spn-155659","marks":["code"],"text":"eventId"},{"id":"spn-155660","text":" policy if traceId uniqueness cannot be guaranteed."}]}],"id":"blk-91933","kind":"list-item"},{"blocks":[{"id":"blk-91936","kind":"paragraph","spans":[{"id":"spn-155661","text":"Consider stronger anti-replay guarantees (timestamp window + dedupe store) before enabling public agent invocations."}]}],"id":"blk-91935","kind":"list-item"},{"blocks":[{"id":"blk-91938","kind":"paragraph","spans":[{"id":"spn-155662","text":"Consider future hardening for enterprise tiers (PKI signatures or mTLS) if required by compliance/security posture."}]}],"id":"blk-91937","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierafemloi45llnaz5lvkak2hx5if5ietofn6jy6l2cu6s2ukpfj7oiq","vocabulary":"ampersand.docs.fs.v1"}