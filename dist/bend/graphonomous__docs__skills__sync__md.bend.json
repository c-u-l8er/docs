{"bendscript":"0.1","blocks":[{"id":"blk-68978","kind":"heading","level":1,"spans":[{"id":"spn-101559","text":"Filesystem Sync — Batch Ingest to Graphonomous"}]},{"id":"blk-68979","kind":"paragraph","spans":[{"id":"spn-101560","text":"Sync filesystem changes into the Graphonomous knowledge graph."}]},{"id":"blk-68980","kind":"heading","level":2,"spans":[{"id":"spn-101561","text":"Arguments"}]},{"id":"blk-68981","kind":"paragraph","spans":[{"id":"spn-101562","text":"Optional path or flags: $ARGUMENTS"}]},{"id":"blk-68982","items":[{"blocks":[{"id":"blk-68984","kind":"paragraph","spans":[{"id":"spn-101563","text":"No arguments: sync only files changed during this session (tracked by the PostToolUse hook)"}]}],"id":"blk-68983","kind":"list-item"},{"blocks":[{"id":"blk-68986","kind":"paragraph","spans":[{"id":"spn-101564","marks":["code"],"text":"<path>"},{"id":"spn-101565","text":": scan a specific directory (uses "},{"id":"spn-101566","marks":["code"],"text":"scan_directory"},{"id":"spn-101567","text":" for full traversal)"}]}],"id":"blk-68985","kind":"list-item"},{"blocks":[{"id":"blk-68988","kind":"paragraph","spans":[{"id":"spn-101568","marks":["code"],"text":"--full"},{"id":"spn-101569","text":": force full directory scan even if change tracking is available"}]}],"id":"blk-68987","kind":"list-item"},{"blocks":[{"id":"blk-68990","kind":"paragraph","spans":[{"id":"spn-101570","marks":["code"],"text":"--consolidate"},{"id":"spn-101571","text":": run consolidation after ingestion"}]}],"id":"blk-68989","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68991","kind":"heading","level":2,"spans":[{"id":"spn-101572","text":"How It Works"}]},{"id":"blk-68992","kind":"paragraph","spans":[{"id":"spn-101573","text":"This skill bridges the gap between AI-driven file editing and Graphonomous memory. When Claude writes or edits files, those changes should be reflected in the knowledge graph so that future retrieval includes the latest state."}]},{"id":"blk-68993","kind":"heading","level":3,"spans":[{"id":"spn-101574","text":"Mode 1: Tracked Changes (Default)"}]},{"id":"blk-68994","kind":"paragraph","spans":[{"id":"spn-101575","text":"The PostToolUse hook on Write/Edit tools records changed file paths in a session file at "},{"id":"spn-101576","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-101577","text":". This skill reads that file and batch-ingests only the changed files."}]},{"id":"blk-68995","kind":"paragraph","spans":[{"id":"spn-101578","marks":["bold"],"text":"Steps:"}]},{"id":"blk-68996","items":[{"blocks":[{"id":"blk-68998","kind":"paragraph","spans":[{"id":"spn-101579","text":"Read the change tracker file ("},{"id":"spn-101580","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-101581","text":")"}]}],"id":"blk-68997","kind":"list-item"},{"blocks":[{"id":"blk-69000","kind":"paragraph","spans":[{"id":"spn-101582","text":"For each changed file, call "},{"id":"spn-101583","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-101584","text":" with:"}]}],"id":"blk-68999","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-69001","items":[{"blocks":[{"id":"blk-69003","kind":"paragraph","spans":[{"id":"spn-101585","marks":["code"],"text":"content"},{"id":"spn-101586","text":": first 16KB of file content"}]}],"id":"blk-69002","kind":"list-item"},{"blocks":[{"id":"blk-69005","kind":"paragraph","spans":[{"id":"spn-101587","marks":["code"],"text":"node_type"},{"id":"spn-101588","text":": \"episodic\""}]}],"id":"blk-69004","kind":"list-item"},{"blocks":[{"id":"blk-69007","kind":"paragraph","spans":[{"id":"spn-101589","marks":["code"],"text":"source"},{"id":"spn-101590","text":": \"filesystem_sync\""}]}],"id":"blk-69006","kind":"list-item"},{"blocks":[{"id":"blk-69009","kind":"paragraph","spans":[{"id":"spn-101591","marks":["code"],"text":"confidence"},{"id":"spn-101592","text":": 0.65"}]}],"id":"blk-69008","kind":"list-item"},{"blocks":[{"id":"blk-69011","kind":"paragraph","spans":[{"id":"spn-101593","marks":["code"],"text":"metadata"},{"id":"spn-101594","text":": "},{"id":"spn-101595","marks":["code"],"text":"{\"path\": \"<absolute_path>\", \"extension\": \"<ext>\", \"sync_reason\": \"file_changed\"}"}]}],"id":"blk-69010","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69012","items":[{"blocks":[{"id":"blk-69014","kind":"paragraph","spans":[{"id":"spn-101596","text":"After all nodes are stored, create edges between related files using "},{"id":"spn-101597","marks":["code"],"text":"act(action: \"store_edge\", ...)"},{"id":"spn-101598","text":":"}]}],"id":"blk-69013","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-69015","items":[{"blocks":[{"id":"blk-69017","kind":"paragraph","spans":[{"id":"spn-101599","text":"Files in the same directory get "},{"id":"spn-101600","marks":["code"],"text":"related"},{"id":"spn-101601","text":" edges (weight 0.4)"}]}],"id":"blk-69016","kind":"list-item"},{"blocks":[{"id":"blk-69019","kind":"paragraph","spans":[{"id":"spn-101602","text":"Files that import/reference each other get "},{"id":"spn-101603","marks":["code"],"text":"derived_from"},{"id":"spn-101604","text":" edges (weight 0.6)"}]}],"id":"blk-69018","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69020","items":[{"blocks":[{"id":"blk-69022","kind":"paragraph","spans":[{"id":"spn-101605","text":"Clear the change tracker file"}]}],"id":"blk-69021","kind":"list-item"},{"blocks":[{"id":"blk-69024","kind":"paragraph","spans":[{"id":"spn-101606","text":"Report: files synced, nodes created, edges created"}]}],"id":"blk-69023","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-69025","kind":"paragraph","spans":[{"id":"spn-101607","marks":["bold"],"text":"Example — sync tracked changes:"}]},{"id":"blk-69026","kind":"code","language":"text","text":"/graphonomous:sync"},{"id":"blk-69027","kind":"heading","level":3,"spans":[{"id":"spn-101608","text":"Mode 2: Directory Scan (with path argument)"}]},{"id":"blk-69028","kind":"paragraph","spans":[{"id":"spn-101609","text":"When given a path, performs a full "},{"id":"spn-101610","marks":["code"],"text":"scan_directory"},{"id":"spn-101611","text":"-style ingestion."}]},{"id":"blk-69029","kind":"paragraph","spans":[{"id":"spn-101612","marks":["bold"],"text":"Steps:"}]},{"id":"blk-69030","items":[{"blocks":[{"id":"blk-69032","kind":"paragraph","spans":[{"id":"spn-101613","text":"List files in the target directory (respecting .gitignore, max 1MB per file)"}]}],"id":"blk-69031","kind":"list-item"},{"blocks":[{"id":"blk-69034","kind":"paragraph","spans":[{"id":"spn-101614","text":"For each file matching supported extensions (.ex, .exs, .ts, .js, .tsx, .md, .html, .css, .json, .yml, .yaml, .toml, .svelte):"}]}],"id":"blk-69033","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-69035","items":[{"blocks":[{"id":"blk-69037","kind":"paragraph","spans":[{"id":"spn-101615","text":"Read first 16KB"}]}],"id":"blk-69036","kind":"list-item"},{"blocks":[{"id":"blk-69039","kind":"paragraph","spans":[{"id":"spn-101616","text":"Call "},{"id":"spn-101617","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-101618","text":" with file content and path metadata"}]}],"id":"blk-69038","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69040","items":[{"blocks":[{"id":"blk-69042","kind":"paragraph","spans":[{"id":"spn-101619","text":"Create inter-file edges based on import/reference patterns"}]}],"id":"blk-69041","kind":"list-item"},{"blocks":[{"id":"blk-69044","kind":"paragraph","spans":[{"id":"spn-101620","text":"Report ingestion stats"}]}],"id":"blk-69043","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-69045","kind":"paragraph","spans":[{"id":"spn-101621","marks":["bold"],"text":"Example — scan a specific directory:"}]},{"id":"blk-69046","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/lib/"},{"id":"blk-69047","kind":"paragraph","spans":[{"id":"spn-101622","marks":["bold"],"text":"Example — full scan with consolidation:"}]},{"id":"blk-69048","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/ --full --consolidate"},{"id":"blk-69049","kind":"heading","level":3,"spans":[{"id":"spn-101623","text":"Mode 3: Post-Consolidation"}]},{"id":"blk-69050","kind":"paragraph","spans":[{"id":"spn-101624","text":"If "},{"id":"spn-101625","marks":["code"],"text":"--consolidate"},{"id":"spn-101626","text":" is passed, run consolidation after ingestion:"}]},{"id":"blk-69051","kind":"code","language":"text","text":"consolidate(action: \"run\")"},{"id":"blk-69052","kind":"heading","level":2,"spans":[{"id":"spn-101627","text":"Deduplication"}]},{"id":"blk-69053","kind":"paragraph","spans":[{"id":"spn-101628","text":"Before storing, check if a node with the same path already exists:"}]},{"id":"blk-69054","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<file path>\", limit: 1)"},{"id":"blk-69055","kind":"paragraph","spans":[{"id":"spn-101629","text":"If a high-similarity node exists (score > 0.9), update it via "},{"id":"spn-101630","marks":["code"],"text":"learn(action: \"from_feedback\", feedback_type: \"correction\")"},{"id":"spn-101631","text":" rather than creating a duplicate."}]},{"id":"blk-69056","kind":"heading","level":2,"spans":[{"id":"spn-101632","text":"Edge Extraction Patterns"}]},{"id":"blk-69057","kind":"paragraph","spans":[{"id":"spn-101633","text":"After storing nodes, create edges for detected references:"}]},{"id":"blk-69058","items":[{"blocks":[{"id":"blk-69060","kind":"paragraph","spans":[{"id":"spn-101634","marks":["bold"],"text":"Elixir"},{"id":"spn-101635","text":": "},{"id":"spn-101636","marks":["code"],"text":"alias Foo.Bar"},{"id":"spn-101637","text":" / "},{"id":"spn-101638","marks":["code"],"text":"import Foo"},{"id":"spn-101639","text":" / "},{"id":"spn-101640","marks":["code"],"text":"use Foo"},{"id":"spn-101641","text":" / "},{"id":"spn-101642","marks":["code"],"text":"require Foo"},{"id":"spn-101643","text":" -> "},{"id":"spn-101644","marks":["code"],"text":"derived_from"},{"id":"spn-101645","text":" edge"}]}],"id":"blk-69059","kind":"list-item"},{"blocks":[{"id":"blk-69062","kind":"paragraph","spans":[{"id":"spn-101646","marks":["bold"],"text":"JS/TS"},{"id":"spn-101647","text":": "},{"id":"spn-101648","marks":["code"],"text":"import ... from './foo'"},{"id":"spn-101649","text":" / "},{"id":"spn-101650","marks":["code"],"text":"require('./foo')"},{"id":"spn-101651","text":" -> "},{"id":"spn-101652","marks":["code"],"text":"derived_from"},{"id":"spn-101653","text":" edge"}]}],"id":"blk-69061","kind":"list-item"},{"blocks":[{"id":"blk-69064","kind":"paragraph","spans":[{"id":"spn-101654","marks":["bold"],"text":"Markdown"},{"id":"spn-101655","text":": backtick file paths, cross-project names -> "},{"id":"spn-101656","marks":["code"],"text":"related"},{"id":"spn-101657","text":" edge"}]}],"id":"blk-69063","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69065","kind":"code","language":"text","text":"act(action: \"store_edge\", source_id: \"<importer_node>\", target_id: \"<imported_node>\", edge_type: \"derived_from\", weight: 0.6)"},{"id":"blk-69066","kind":"heading","level":2,"spans":[{"id":"spn-101658","text":"Anti-patterns to avoid"}]},{"id":"blk-69067","items":[{"blocks":[{"id":"blk-69069","kind":"paragraph","spans":[{"id":"spn-101659","text":"Don't sync every tiny edit in real-time — batch at natural breakpoints"}]}],"id":"blk-69068","kind":"list-item"},{"blocks":[{"id":"blk-69071","kind":"paragraph","spans":[{"id":"spn-101660","text":"Don't ingest binary files, node_modules, _build, deps, or .git directories"}]}],"id":"blk-69070","kind":"list-item"},{"blocks":[{"id":"blk-69073","kind":"paragraph","spans":[{"id":"spn-101661","text":"Don't set confidence above 0.65 for file content (it's raw, not curated knowledge)"}]}],"id":"blk-69072","kind":"list-item"},{"blocks":[{"id":"blk-69075","kind":"paragraph","spans":[{"id":"spn-101662","text":"Don't skip edge extraction — edges are what make the graph useful for retrieval"}]}],"id":"blk-69074","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera6gg7mewky2v2immgnwf7mydpvdsxo6kjswd3nmycvsocriww5nba","vocabulary":"ampersand.docs.fs.v1"}