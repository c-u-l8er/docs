{"bendscript":"0.1","blocks":[{"id":"blk-68150","kind":"heading","level":1,"spans":[{"id":"spn-98920","text":"Filesystem Sync — Batch Ingest to Graphonomous"}]},{"id":"blk-68151","kind":"paragraph","spans":[{"id":"spn-98921","text":"Sync filesystem changes into the Graphonomous knowledge graph."}]},{"id":"blk-68152","kind":"heading","level":2,"spans":[{"id":"spn-98922","text":"Arguments"}]},{"id":"blk-68153","kind":"paragraph","spans":[{"id":"spn-98923","text":"Optional path or flags: $ARGUMENTS"}]},{"id":"blk-68154","items":[{"blocks":[{"id":"blk-68156","kind":"paragraph","spans":[{"id":"spn-98924","text":"No arguments: sync only files changed during this session (tracked by the PostToolUse hook)"}]}],"id":"blk-68155","kind":"list-item"},{"blocks":[{"id":"blk-68158","kind":"paragraph","spans":[{"id":"spn-98925","marks":["code"],"text":"<path>"},{"id":"spn-98926","text":": scan a specific directory (uses "},{"id":"spn-98927","marks":["code"],"text":"scan_directory"},{"id":"spn-98928","text":" for full traversal)"}]}],"id":"blk-68157","kind":"list-item"},{"blocks":[{"id":"blk-68160","kind":"paragraph","spans":[{"id":"spn-98929","marks":["code"],"text":"--full"},{"id":"spn-98930","text":": force full directory scan even if change tracking is available"}]}],"id":"blk-68159","kind":"list-item"},{"blocks":[{"id":"blk-68162","kind":"paragraph","spans":[{"id":"spn-98931","marks":["code"],"text":"--consolidate"},{"id":"spn-98932","text":": run consolidation after ingestion"}]}],"id":"blk-68161","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68163","kind":"heading","level":2,"spans":[{"id":"spn-98933","text":"How It Works"}]},{"id":"blk-68164","kind":"paragraph","spans":[{"id":"spn-98934","text":"This skill bridges the gap between AI-driven file editing and Graphonomous memory. When Claude writes or edits files, those changes should be reflected in the knowledge graph so that future retrieval includes the latest state."}]},{"id":"blk-68165","kind":"heading","level":3,"spans":[{"id":"spn-98935","text":"Mode 1: Tracked Changes (Default)"}]},{"id":"blk-68166","kind":"paragraph","spans":[{"id":"spn-98936","text":"The PostToolUse hook on Write/Edit tools records changed file paths in a session file at "},{"id":"spn-98937","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-98938","text":". This skill reads that file and batch-ingests only the changed files."}]},{"id":"blk-68167","kind":"paragraph","spans":[{"id":"spn-98939","marks":["bold"],"text":"Steps:"}]},{"id":"blk-68168","items":[{"blocks":[{"id":"blk-68170","kind":"paragraph","spans":[{"id":"spn-98940","text":"Read the change tracker file ("},{"id":"spn-98941","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-98942","text":")"}]}],"id":"blk-68169","kind":"list-item"},{"blocks":[{"id":"blk-68172","kind":"paragraph","spans":[{"id":"spn-98943","text":"For each changed file, call "},{"id":"spn-98944","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-98945","text":" with:"}]}],"id":"blk-68171","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68173","items":[{"blocks":[{"id":"blk-68175","kind":"paragraph","spans":[{"id":"spn-98946","marks":["code"],"text":"content"},{"id":"spn-98947","text":": first 16KB of file content"}]}],"id":"blk-68174","kind":"list-item"},{"blocks":[{"id":"blk-68177","kind":"paragraph","spans":[{"id":"spn-98948","marks":["code"],"text":"node_type"},{"id":"spn-98949","text":": \"episodic\""}]}],"id":"blk-68176","kind":"list-item"},{"blocks":[{"id":"blk-68179","kind":"paragraph","spans":[{"id":"spn-98950","marks":["code"],"text":"source"},{"id":"spn-98951","text":": \"filesystem_sync\""}]}],"id":"blk-68178","kind":"list-item"},{"blocks":[{"id":"blk-68181","kind":"paragraph","spans":[{"id":"spn-98952","marks":["code"],"text":"confidence"},{"id":"spn-98953","text":": 0.65"}]}],"id":"blk-68180","kind":"list-item"},{"blocks":[{"id":"blk-68183","kind":"paragraph","spans":[{"id":"spn-98954","marks":["code"],"text":"metadata"},{"id":"spn-98955","text":": "},{"id":"spn-98956","marks":["code"],"text":"{\"path\": \"<absolute_path>\", \"extension\": \"<ext>\", \"sync_reason\": \"file_changed\"}"}]}],"id":"blk-68182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68184","items":[{"blocks":[{"id":"blk-68186","kind":"paragraph","spans":[{"id":"spn-98957","text":"After all nodes are stored, create edges between related files using "},{"id":"spn-98958","marks":["code"],"text":"act(action: \"store_edge\", ...)"},{"id":"spn-98959","text":":"}]}],"id":"blk-68185","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-68187","items":[{"blocks":[{"id":"blk-68189","kind":"paragraph","spans":[{"id":"spn-98960","text":"Files in the same directory get "},{"id":"spn-98961","marks":["code"],"text":"related"},{"id":"spn-98962","text":" edges (weight 0.4)"}]}],"id":"blk-68188","kind":"list-item"},{"blocks":[{"id":"blk-68191","kind":"paragraph","spans":[{"id":"spn-98963","text":"Files that import/reference each other get "},{"id":"spn-98964","marks":["code"],"text":"derived_from"},{"id":"spn-98965","text":" edges (weight 0.6)"}]}],"id":"blk-68190","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68192","items":[{"blocks":[{"id":"blk-68194","kind":"paragraph","spans":[{"id":"spn-98966","text":"Clear the change tracker file"}]}],"id":"blk-68193","kind":"list-item"},{"blocks":[{"id":"blk-68196","kind":"paragraph","spans":[{"id":"spn-98967","text":"Report: files synced, nodes created, edges created"}]}],"id":"blk-68195","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-68197","kind":"paragraph","spans":[{"id":"spn-98968","marks":["bold"],"text":"Example — sync tracked changes:"}]},{"id":"blk-68198","kind":"code","language":"text","text":"/graphonomous:sync"},{"id":"blk-68199","kind":"heading","level":3,"spans":[{"id":"spn-98969","text":"Mode 2: Directory Scan (with path argument)"}]},{"id":"blk-68200","kind":"paragraph","spans":[{"id":"spn-98970","text":"When given a path, performs a full "},{"id":"spn-98971","marks":["code"],"text":"scan_directory"},{"id":"spn-98972","text":"-style ingestion."}]},{"id":"blk-68201","kind":"paragraph","spans":[{"id":"spn-98973","marks":["bold"],"text":"Steps:"}]},{"id":"blk-68202","items":[{"blocks":[{"id":"blk-68204","kind":"paragraph","spans":[{"id":"spn-98974","text":"List files in the target directory (respecting .gitignore, max 1MB per file)"}]}],"id":"blk-68203","kind":"list-item"},{"blocks":[{"id":"blk-68206","kind":"paragraph","spans":[{"id":"spn-98975","text":"For each file matching supported extensions (.ex, .exs, .ts, .js, .tsx, .md, .html, .css, .json, .yml, .yaml, .toml, .svelte):"}]}],"id":"blk-68205","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68207","items":[{"blocks":[{"id":"blk-68209","kind":"paragraph","spans":[{"id":"spn-98976","text":"Read first 16KB"}]}],"id":"blk-68208","kind":"list-item"},{"blocks":[{"id":"blk-68211","kind":"paragraph","spans":[{"id":"spn-98977","text":"Call "},{"id":"spn-98978","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-98979","text":" with file content and path metadata"}]}],"id":"blk-68210","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68212","items":[{"blocks":[{"id":"blk-68214","kind":"paragraph","spans":[{"id":"spn-98980","text":"Create inter-file edges based on import/reference patterns"}]}],"id":"blk-68213","kind":"list-item"},{"blocks":[{"id":"blk-68216","kind":"paragraph","spans":[{"id":"spn-98981","text":"Report ingestion stats"}]}],"id":"blk-68215","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-68217","kind":"paragraph","spans":[{"id":"spn-98982","marks":["bold"],"text":"Example — scan a specific directory:"}]},{"id":"blk-68218","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/lib/"},{"id":"blk-68219","kind":"paragraph","spans":[{"id":"spn-98983","marks":["bold"],"text":"Example — full scan with consolidation:"}]},{"id":"blk-68220","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/ --full --consolidate"},{"id":"blk-68221","kind":"heading","level":3,"spans":[{"id":"spn-98984","text":"Mode 3: Post-Consolidation"}]},{"id":"blk-68222","kind":"paragraph","spans":[{"id":"spn-98985","text":"If "},{"id":"spn-98986","marks":["code"],"text":"--consolidate"},{"id":"spn-98987","text":" is passed, run consolidation after ingestion:"}]},{"id":"blk-68223","kind":"code","language":"text","text":"consolidate(action: \"run\")"},{"id":"blk-68224","kind":"heading","level":2,"spans":[{"id":"spn-98988","text":"Deduplication"}]},{"id":"blk-68225","kind":"paragraph","spans":[{"id":"spn-98989","text":"Before storing, check if a node with the same path already exists:"}]},{"id":"blk-68226","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<file path>\", limit: 1)"},{"id":"blk-68227","kind":"paragraph","spans":[{"id":"spn-98990","text":"If a high-similarity node exists (score > 0.9), update it via "},{"id":"spn-98991","marks":["code"],"text":"learn(action: \"from_feedback\", feedback_type: \"correction\")"},{"id":"spn-98992","text":" rather than creating a duplicate."}]},{"id":"blk-68228","kind":"heading","level":2,"spans":[{"id":"spn-98993","text":"Edge Extraction Patterns"}]},{"id":"blk-68229","kind":"paragraph","spans":[{"id":"spn-98994","text":"After storing nodes, create edges for detected references:"}]},{"id":"blk-68230","items":[{"blocks":[{"id":"blk-68232","kind":"paragraph","spans":[{"id":"spn-98995","marks":["bold"],"text":"Elixir"},{"id":"spn-98996","text":": "},{"id":"spn-98997","marks":["code"],"text":"alias Foo.Bar"},{"id":"spn-98998","text":" / "},{"id":"spn-98999","marks":["code"],"text":"import Foo"},{"id":"spn-99000","text":" / "},{"id":"spn-99001","marks":["code"],"text":"use Foo"},{"id":"spn-99002","text":" / "},{"id":"spn-99003","marks":["code"],"text":"require Foo"},{"id":"spn-99004","text":" -> "},{"id":"spn-99005","marks":["code"],"text":"derived_from"},{"id":"spn-99006","text":" edge"}]}],"id":"blk-68231","kind":"list-item"},{"blocks":[{"id":"blk-68234","kind":"paragraph","spans":[{"id":"spn-99007","marks":["bold"],"text":"JS/TS"},{"id":"spn-99008","text":": "},{"id":"spn-99009","marks":["code"],"text":"import ... from './foo'"},{"id":"spn-99010","text":" / "},{"id":"spn-99011","marks":["code"],"text":"require('./foo')"},{"id":"spn-99012","text":" -> "},{"id":"spn-99013","marks":["code"],"text":"derived_from"},{"id":"spn-99014","text":" edge"}]}],"id":"blk-68233","kind":"list-item"},{"blocks":[{"id":"blk-68236","kind":"paragraph","spans":[{"id":"spn-99015","marks":["bold"],"text":"Markdown"},{"id":"spn-99016","text":": backtick file paths, cross-project names -> "},{"id":"spn-99017","marks":["code"],"text":"related"},{"id":"spn-99018","text":" edge"}]}],"id":"blk-68235","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68237","kind":"code","language":"text","text":"act(action: \"store_edge\", source_id: \"<importer_node>\", target_id: \"<imported_node>\", edge_type: \"derived_from\", weight: 0.6)"},{"id":"blk-68238","kind":"heading","level":2,"spans":[{"id":"spn-99019","text":"Anti-patterns to avoid"}]},{"id":"blk-68239","items":[{"blocks":[{"id":"blk-68241","kind":"paragraph","spans":[{"id":"spn-99020","text":"Don't sync every tiny edit in real-time — batch at natural breakpoints"}]}],"id":"blk-68240","kind":"list-item"},{"blocks":[{"id":"blk-68243","kind":"paragraph","spans":[{"id":"spn-99021","text":"Don't ingest binary files, node_modules, _build, deps, or .git directories"}]}],"id":"blk-68242","kind":"list-item"},{"blocks":[{"id":"blk-68245","kind":"paragraph","spans":[{"id":"spn-99022","text":"Don't set confidence above 0.65 for file content (it's raw, not curated knowledge)"}]}],"id":"blk-68244","kind":"list-item"},{"blocks":[{"id":"blk-68247","kind":"paragraph","spans":[{"id":"spn-99023","text":"Don't skip edge extraction — edges are what make the graph useful for retrieval"}]}],"id":"blk-68246","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera2p73nlajrn7o3lwkyju6qtf4xuv42w2riznoijitutss2ahant3q","vocabulary":"ampersand.docs.fs.v1"}