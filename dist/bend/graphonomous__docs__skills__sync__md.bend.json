{"bendscript":"0.1","blocks":[{"id":"blk-43770","kind":"paragraph","spans":[{"id":"spn-50055","text":"--- name: sync description: Use when the user says \"sync\", \"ingest files\", \"update memory from disk\", \"scan directory\", \"sync to graph\", or after making significant filesystem changes. Batch-ingests changed files into Graphonomous, runs edge extraction, and optionally consolidates. Routes through "},{"id":"spn-50056","marks":["code"],"text":"act"},{"id":"spn-50057","text":", "},{"id":"spn-50058","marks":["code"],"text":"learn"},{"id":"spn-50059","text":", and "},{"id":"spn-50060","marks":["code"],"text":"consolidate"},{"id":"spn-50061","text":" machines. argument-hint: [path] [--full] [--consolidate] ---"}]},{"id":"blk-43771","kind":"heading","level":1,"spans":[{"id":"spn-50062","text":"Filesystem Sync — Batch Ingest to Graphonomous"}]},{"id":"blk-43772","kind":"paragraph","spans":[{"id":"spn-50063","text":"Sync filesystem changes into the Graphonomous knowledge graph."}]},{"id":"blk-43773","kind":"heading","level":2,"spans":[{"id":"spn-50064","text":"Arguments"}]},{"id":"blk-43774","kind":"paragraph","spans":[{"id":"spn-50065","text":"Optional path or flags: $ARGUMENTS"}]},{"id":"blk-43775","items":[{"blocks":[{"id":"blk-43777","kind":"paragraph","spans":[{"id":"spn-50066","text":"No arguments: sync only files changed during this session (tracked by the PostToolUse hook)"}]}],"id":"blk-43776","kind":"list-item"},{"blocks":[{"id":"blk-43779","kind":"paragraph","spans":[{"id":"spn-50067","marks":["code"],"text":"<path>"},{"id":"spn-50068","text":": scan a specific directory (uses "},{"id":"spn-50069","marks":["code"],"text":"scan_directory"},{"id":"spn-50070","text":" for full traversal)"}]}],"id":"blk-43778","kind":"list-item"},{"blocks":[{"id":"blk-43781","kind":"paragraph","spans":[{"id":"spn-50071","marks":["code"],"text":"--full"},{"id":"spn-50072","text":": force full directory scan even if change tracking is available"}]}],"id":"blk-43780","kind":"list-item"},{"blocks":[{"id":"blk-43783","kind":"paragraph","spans":[{"id":"spn-50073","marks":["code"],"text":"--consolidate"},{"id":"spn-50074","text":": run consolidation after ingestion"}]}],"id":"blk-43782","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43784","kind":"heading","level":2,"spans":[{"id":"spn-50075","text":"How It Works"}]},{"id":"blk-43785","kind":"paragraph","spans":[{"id":"spn-50076","text":"This skill bridges the gap between AI-driven file editing and Graphonomous memory. When Claude writes or edits files, those changes should be reflected in the knowledge graph so that future retrieval includes the latest state."}]},{"id":"blk-43786","kind":"heading","level":3,"spans":[{"id":"spn-50077","text":"Mode 1: Tracked Changes (Default)"}]},{"id":"blk-43787","kind":"paragraph","spans":[{"id":"spn-50078","text":"The PostToolUse hook on Write/Edit tools records changed file paths in a session file at "},{"id":"spn-50079","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-50080","text":". This skill reads that file and batch-ingests only the changed files."}]},{"id":"blk-43788","kind":"paragraph","spans":[{"id":"spn-50081","marks":["bold"],"text":"Steps:"}]},{"id":"blk-43789","kind":"paragraph","spans":[{"id":"spn-50082","text":"1. Read the change tracker file ("},{"id":"spn-50083","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-50084","text":") 2. For each changed file, call "},{"id":"spn-50085","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-50086","text":" with:"}]},{"id":"blk-43790","items":[{"blocks":[{"id":"blk-43792","kind":"paragraph","spans":[{"id":"spn-50087","marks":["code"],"text":"content"},{"id":"spn-50088","text":": first 16KB of file content"}]}],"id":"blk-43791","kind":"list-item"},{"blocks":[{"id":"blk-43794","kind":"paragraph","spans":[{"id":"spn-50089","marks":["code"],"text":"node_type"},{"id":"spn-50090","text":": \"episodic\""}]}],"id":"blk-43793","kind":"list-item"},{"blocks":[{"id":"blk-43796","kind":"paragraph","spans":[{"id":"spn-50091","marks":["code"],"text":"source"},{"id":"spn-50092","text":": \"filesystem_sync\""}]}],"id":"blk-43795","kind":"list-item"},{"blocks":[{"id":"blk-43798","kind":"paragraph","spans":[{"id":"spn-50093","marks":["code"],"text":"confidence"},{"id":"spn-50094","text":": 0.65"}]}],"id":"blk-43797","kind":"list-item"},{"blocks":[{"id":"blk-43800","kind":"paragraph","spans":[{"id":"spn-50095","marks":["code"],"text":"metadata"},{"id":"spn-50096","text":": "},{"id":"spn-50097","marks":["code"],"text":"{\"path\": \"<absolute_path>\", \"extension\": \"<ext>\", \"sync_reason\": \"file_changed\"}"}]}],"id":"blk-43799","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43801","kind":"paragraph","spans":[{"id":"spn-50098","text":"3. After all nodes are stored, create edges between related files using "},{"id":"spn-50099","marks":["code"],"text":"act(action: \"store_edge\", ...)"},{"id":"spn-50100","text":":"}]},{"id":"blk-43802","items":[{"blocks":[{"id":"blk-43804","kind":"paragraph","spans":[{"id":"spn-50101","text":"Files in the same directory get "},{"id":"spn-50102","marks":["code"],"text":"related"},{"id":"spn-50103","text":" edges (weight 0.4)"}]}],"id":"blk-43803","kind":"list-item"},{"blocks":[{"id":"blk-43806","kind":"paragraph","spans":[{"id":"spn-50104","text":"Files that import/reference each other get "},{"id":"spn-50105","marks":["code"],"text":"derived_from"},{"id":"spn-50106","text":" edges (weight 0.6)"}]}],"id":"blk-43805","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43807","kind":"paragraph","spans":[{"id":"spn-50107","text":"4. Clear the change tracker file 5. Report: files synced, nodes created, edges created"}]},{"id":"blk-43808","kind":"paragraph","spans":[{"id":"spn-50108","marks":["bold"],"text":"Example — sync tracked changes:"}]},{"id":"blk-43809","kind":"code","language":"text","text":"/graphonomous:sync"},{"id":"blk-43810","kind":"heading","level":3,"spans":[{"id":"spn-50109","text":"Mode 2: Directory Scan (with path argument)"}]},{"id":"blk-43811","kind":"paragraph","spans":[{"id":"spn-50110","text":"When given a path, performs a full "},{"id":"spn-50111","marks":["code"],"text":"scan_directory"},{"id":"spn-50112","text":"-style ingestion."}]},{"id":"blk-43812","kind":"paragraph","spans":[{"id":"spn-50113","marks":["bold"],"text":"Steps:"}]},{"id":"blk-43813","kind":"paragraph","spans":[{"id":"spn-50114","text":"1. List files in the target directory (respecting .gitignore, max 1MB per file) 2. For each file matching supported extensions (.ex, .exs, .ts, .js, .tsx, .md, .html, .css, .json, .yml, .yaml, .toml, .svelte):"}]},{"id":"blk-43814","items":[{"blocks":[{"id":"blk-43816","kind":"paragraph","spans":[{"id":"spn-50115","text":"Read first 16KB"}]}],"id":"blk-43815","kind":"list-item"},{"blocks":[{"id":"blk-43818","kind":"paragraph","spans":[{"id":"spn-50116","text":"Call "},{"id":"spn-50117","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-50118","text":" with file content and path metadata"}]}],"id":"blk-43817","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43819","kind":"paragraph","spans":[{"id":"spn-50119","text":"3. Create inter-file edges based on import/reference patterns 4. Report ingestion stats"}]},{"id":"blk-43820","kind":"paragraph","spans":[{"id":"spn-50120","marks":["bold"],"text":"Example — scan a specific directory:"}]},{"id":"blk-43821","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/lib/"},{"id":"blk-43822","kind":"paragraph","spans":[{"id":"spn-50121","marks":["bold"],"text":"Example — full scan with consolidation:"}]},{"id":"blk-43823","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/ --full --consolidate"},{"id":"blk-43824","kind":"heading","level":3,"spans":[{"id":"spn-50122","text":"Mode 3: Post-Consolidation"}]},{"id":"blk-43825","kind":"paragraph","spans":[{"id":"spn-50123","text":"If "},{"id":"spn-50124","marks":["code"],"text":"--consolidate"},{"id":"spn-50125","text":" is passed, run consolidation after ingestion:"}]},{"id":"blk-43826","kind":"code","language":"text","text":"consolidate(action: \"run\")"},{"id":"blk-43827","kind":"heading","level":2,"spans":[{"id":"spn-50126","text":"Deduplication"}]},{"id":"blk-43828","kind":"paragraph","spans":[{"id":"spn-50127","text":"Before storing, check if a node with the same path already exists:"}]},{"id":"blk-43829","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<file path>\", limit: 1)"},{"id":"blk-43830","kind":"paragraph","spans":[{"id":"spn-50128","text":"If a high-similarity node exists (score > 0.9), update it via "},{"id":"spn-50129","marks":["code"],"text":"learn(action: \"from_feedback\", feedback_type: \"correction\")"},{"id":"spn-50130","text":" rather than creating a duplicate."}]},{"id":"blk-43831","kind":"heading","level":2,"spans":[{"id":"spn-50131","text":"Edge Extraction Patterns"}]},{"id":"blk-43832","kind":"paragraph","spans":[{"id":"spn-50132","text":"After storing nodes, create edges for detected references:"}]},{"id":"blk-43833","items":[{"blocks":[{"id":"blk-43835","kind":"paragraph","spans":[{"id":"spn-50133","marks":["bold"],"text":"Elixir"},{"id":"spn-50134","text":": "},{"id":"spn-50135","marks":["code"],"text":"alias Foo.Bar"},{"id":"spn-50136","text":" / "},{"id":"spn-50137","marks":["code"],"text":"import Foo"},{"id":"spn-50138","text":" / "},{"id":"spn-50139","marks":["code"],"text":"use Foo"},{"id":"spn-50140","text":" / "},{"id":"spn-50141","marks":["code"],"text":"require Foo"},{"id":"spn-50142","text":" -> "},{"id":"spn-50143","marks":["code"],"text":"derived_from"},{"id":"spn-50144","text":" edge"}]}],"id":"blk-43834","kind":"list-item"},{"blocks":[{"id":"blk-43837","kind":"paragraph","spans":[{"id":"spn-50145","marks":["bold"],"text":"JS/TS"},{"id":"spn-50146","text":": "},{"id":"spn-50147","marks":["code"],"text":"import ... from './foo'"},{"id":"spn-50148","text":" / "},{"id":"spn-50149","marks":["code"],"text":"require('./foo')"},{"id":"spn-50150","text":" -> "},{"id":"spn-50151","marks":["code"],"text":"derived_from"},{"id":"spn-50152","text":" edge"}]}],"id":"blk-43836","kind":"list-item"},{"blocks":[{"id":"blk-43839","kind":"paragraph","spans":[{"id":"spn-50153","marks":["bold"],"text":"Markdown"},{"id":"spn-50154","text":": backtick file paths, cross-project names -> "},{"id":"spn-50155","marks":["code"],"text":"related"},{"id":"spn-50156","text":" edge"}]}],"id":"blk-43838","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43840","kind":"code","language":"text","text":"act(action: \"store_edge\", source_id: \"<importer_node>\", target_id: \"<imported_node>\", edge_type: \"derived_from\", weight: 0.6)"},{"id":"blk-43841","kind":"heading","level":2,"spans":[{"id":"spn-50157","text":"Anti-patterns to avoid"}]},{"id":"blk-43842","items":[{"blocks":[{"id":"blk-43844","kind":"paragraph","spans":[{"id":"spn-50158","text":"Don't sync every tiny edit in real-time — batch at natural breakpoints"}]}],"id":"blk-43843","kind":"list-item"},{"blocks":[{"id":"blk-43846","kind":"paragraph","spans":[{"id":"spn-50159","text":"Don't ingest binary files, node_modules, _build, deps, or .git directories"}]}],"id":"blk-43845","kind":"list-item"},{"blocks":[{"id":"blk-43848","kind":"paragraph","spans":[{"id":"spn-50160","text":"Don't set confidence above 0.65 for file content (it's raw, not curated knowledge)"}]}],"id":"blk-43847","kind":"list-item"},{"blocks":[{"id":"blk-43850","kind":"paragraph","spans":[{"id":"spn-50161","text":"Don't skip edge extraction — edges are what make the graph useful for retrieval"}]}],"id":"blk-43849","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierae7j77tpogq5h4ouvg25fwrcn2rrahjx6kxguogqmlad5hjj3hu7q","vocabulary":"ampersand.docs.fs.v1"}