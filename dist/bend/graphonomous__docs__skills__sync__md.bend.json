{"bendscript":"0.1","blocks":[{"id":"blk-75507","kind":"heading","level":1,"spans":[{"id":"spn-138283","text":"Filesystem Sync — Batch Ingest to Graphonomous"}]},{"id":"blk-75508","kind":"paragraph","spans":[{"id":"spn-138284","text":"Sync filesystem changes into the Graphonomous knowledge graph."}]},{"id":"blk-75509","kind":"heading","level":2,"spans":[{"id":"spn-138285","text":"Arguments"}]},{"id":"blk-75510","kind":"paragraph","spans":[{"id":"spn-138286","text":"Optional path or flags: $ARGUMENTS"}]},{"id":"blk-75511","items":[{"blocks":[{"id":"blk-75513","kind":"paragraph","spans":[{"id":"spn-138287","text":"No arguments: sync only files changed during this session (tracked by the PostToolUse hook)"}]}],"id":"blk-75512","kind":"list-item"},{"blocks":[{"id":"blk-75515","kind":"paragraph","spans":[{"id":"spn-138288","marks":["code"],"text":"<path>"},{"id":"spn-138289","text":": scan a specific directory (uses "},{"id":"spn-138290","marks":["code"],"text":"scan_directory"},{"id":"spn-138291","text":" for full traversal)"}]}],"id":"blk-75514","kind":"list-item"},{"blocks":[{"id":"blk-75517","kind":"paragraph","spans":[{"id":"spn-138292","marks":["code"],"text":"--full"},{"id":"spn-138293","text":": force full directory scan even if change tracking is available"}]}],"id":"blk-75516","kind":"list-item"},{"blocks":[{"id":"blk-75519","kind":"paragraph","spans":[{"id":"spn-138294","marks":["code"],"text":"--consolidate"},{"id":"spn-138295","text":": run consolidation after ingestion"}]}],"id":"blk-75518","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75520","kind":"heading","level":2,"spans":[{"id":"spn-138296","text":"How It Works"}]},{"id":"blk-75521","kind":"paragraph","spans":[{"id":"spn-138297","text":"This skill bridges the gap between AI-driven file editing and Graphonomous memory. When Claude writes or edits files, those changes should be reflected in the knowledge graph so that future retrieval includes the latest state."}]},{"id":"blk-75522","kind":"heading","level":3,"spans":[{"id":"spn-138298","text":"Mode 1: Tracked Changes (Default)"}]},{"id":"blk-75523","kind":"paragraph","spans":[{"id":"spn-138299","text":"The PostToolUse hook on Write/Edit tools records changed file paths in a session file at "},{"id":"spn-138300","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-138301","text":". This skill reads that file and batch-ingests only the changed files."}]},{"id":"blk-75524","kind":"paragraph","spans":[{"id":"spn-138302","marks":["bold"],"text":"Steps:"}]},{"id":"blk-75525","items":[{"blocks":[{"id":"blk-75527","kind":"paragraph","spans":[{"id":"spn-138303","text":"Read the change tracker file ("},{"id":"spn-138304","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-138305","text":")"}]}],"id":"blk-75526","kind":"list-item"},{"blocks":[{"id":"blk-75529","kind":"paragraph","spans":[{"id":"spn-138306","text":"For each changed file, call "},{"id":"spn-138307","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-138308","text":" with:"}]}],"id":"blk-75528","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75530","items":[{"blocks":[{"id":"blk-75532","kind":"paragraph","spans":[{"id":"spn-138309","marks":["code"],"text":"content"},{"id":"spn-138310","text":": first 16KB of file content"}]}],"id":"blk-75531","kind":"list-item"},{"blocks":[{"id":"blk-75534","kind":"paragraph","spans":[{"id":"spn-138311","marks":["code"],"text":"node_type"},{"id":"spn-138312","text":": \"episodic\""}]}],"id":"blk-75533","kind":"list-item"},{"blocks":[{"id":"blk-75536","kind":"paragraph","spans":[{"id":"spn-138313","marks":["code"],"text":"source"},{"id":"spn-138314","text":": \"filesystem_sync\""}]}],"id":"blk-75535","kind":"list-item"},{"blocks":[{"id":"blk-75538","kind":"paragraph","spans":[{"id":"spn-138315","marks":["code"],"text":"confidence"},{"id":"spn-138316","text":": 0.65"}]}],"id":"blk-75537","kind":"list-item"},{"blocks":[{"id":"blk-75540","kind":"paragraph","spans":[{"id":"spn-138317","marks":["code"],"text":"metadata"},{"id":"spn-138318","text":": "},{"id":"spn-138319","marks":["code"],"text":"{\"path\": \"<absolute_path>\", \"extension\": \"<ext>\", \"sync_reason\": \"file_changed\"}"}]}],"id":"blk-75539","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75541","items":[{"blocks":[{"id":"blk-75543","kind":"paragraph","spans":[{"id":"spn-138320","text":"After all nodes are stored, create edges between related files using "},{"id":"spn-138321","marks":["code"],"text":"act(action: \"store_edge\", ...)"},{"id":"spn-138322","text":":"}]}],"id":"blk-75542","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-75544","items":[{"blocks":[{"id":"blk-75546","kind":"paragraph","spans":[{"id":"spn-138323","text":"Files in the same directory get "},{"id":"spn-138324","marks":["code"],"text":"related"},{"id":"spn-138325","text":" edges (weight 0.4)"}]}],"id":"blk-75545","kind":"list-item"},{"blocks":[{"id":"blk-75548","kind":"paragraph","spans":[{"id":"spn-138326","text":"Files that import/reference each other get "},{"id":"spn-138327","marks":["code"],"text":"derived_from"},{"id":"spn-138328","text":" edges (weight 0.6)"}]}],"id":"blk-75547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75549","items":[{"blocks":[{"id":"blk-75551","kind":"paragraph","spans":[{"id":"spn-138329","text":"Clear the change tracker file"}]}],"id":"blk-75550","kind":"list-item"},{"blocks":[{"id":"blk-75553","kind":"paragraph","spans":[{"id":"spn-138330","text":"Report: files synced, nodes created, edges created"}]}],"id":"blk-75552","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-75554","kind":"paragraph","spans":[{"id":"spn-138331","marks":["bold"],"text":"Example — sync tracked changes:"}]},{"id":"blk-75555","kind":"code","language":"text","text":"/graphonomous:sync"},{"id":"blk-75556","kind":"heading","level":3,"spans":[{"id":"spn-138332","text":"Mode 2: Directory Scan (with path argument)"}]},{"id":"blk-75557","kind":"paragraph","spans":[{"id":"spn-138333","text":"When given a path, performs a full "},{"id":"spn-138334","marks":["code"],"text":"scan_directory"},{"id":"spn-138335","text":"-style ingestion."}]},{"id":"blk-75558","kind":"paragraph","spans":[{"id":"spn-138336","marks":["bold"],"text":"Steps:"}]},{"id":"blk-75559","items":[{"blocks":[{"id":"blk-75561","kind":"paragraph","spans":[{"id":"spn-138337","text":"List files in the target directory (respecting .gitignore, max 1MB per file)"}]}],"id":"blk-75560","kind":"list-item"},{"blocks":[{"id":"blk-75563","kind":"paragraph","spans":[{"id":"spn-138338","text":"For each file matching supported extensions (.ex, .exs, .ts, .js, .tsx, .md, .html, .css, .json, .yml, .yaml, .toml, .svelte):"}]}],"id":"blk-75562","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75564","items":[{"blocks":[{"id":"blk-75566","kind":"paragraph","spans":[{"id":"spn-138339","text":"Read first 16KB"}]}],"id":"blk-75565","kind":"list-item"},{"blocks":[{"id":"blk-75568","kind":"paragraph","spans":[{"id":"spn-138340","text":"Call "},{"id":"spn-138341","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-138342","text":" with file content and path metadata"}]}],"id":"blk-75567","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75569","items":[{"blocks":[{"id":"blk-75571","kind":"paragraph","spans":[{"id":"spn-138343","text":"Create inter-file edges based on import/reference patterns"}]}],"id":"blk-75570","kind":"list-item"},{"blocks":[{"id":"blk-75573","kind":"paragraph","spans":[{"id":"spn-138344","text":"Report ingestion stats"}]}],"id":"blk-75572","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-75574","kind":"paragraph","spans":[{"id":"spn-138345","marks":["bold"],"text":"Example — scan a specific directory:"}]},{"id":"blk-75575","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/lib/"},{"id":"blk-75576","kind":"paragraph","spans":[{"id":"spn-138346","marks":["bold"],"text":"Example — full scan with consolidation:"}]},{"id":"blk-75577","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/ --full --consolidate"},{"id":"blk-75578","kind":"heading","level":3,"spans":[{"id":"spn-138347","text":"Mode 3: Post-Consolidation"}]},{"id":"blk-75579","kind":"paragraph","spans":[{"id":"spn-138348","text":"If "},{"id":"spn-138349","marks":["code"],"text":"--consolidate"},{"id":"spn-138350","text":" is passed, run consolidation after ingestion:"}]},{"id":"blk-75580","kind":"code","language":"text","text":"consolidate(action: \"run\")"},{"id":"blk-75581","kind":"heading","level":2,"spans":[{"id":"spn-138351","text":"Deduplication"}]},{"id":"blk-75582","kind":"paragraph","spans":[{"id":"spn-138352","text":"Before storing, check if a node with the same path already exists:"}]},{"id":"blk-75583","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<file path>\", limit: 1)"},{"id":"blk-75584","kind":"paragraph","spans":[{"id":"spn-138353","text":"If a high-similarity node exists (score > 0.9), update it via "},{"id":"spn-138354","marks":["code"],"text":"learn(action: \"from_feedback\", feedback_type: \"correction\")"},{"id":"spn-138355","text":" rather than creating a duplicate."}]},{"id":"blk-75585","kind":"heading","level":2,"spans":[{"id":"spn-138356","text":"Edge Extraction Patterns"}]},{"id":"blk-75586","kind":"paragraph","spans":[{"id":"spn-138357","text":"After storing nodes, create edges for detected references:"}]},{"id":"blk-75587","items":[{"blocks":[{"id":"blk-75589","kind":"paragraph","spans":[{"id":"spn-138358","marks":["bold"],"text":"Elixir"},{"id":"spn-138359","text":": "},{"id":"spn-138360","marks":["code"],"text":"alias Foo.Bar"},{"id":"spn-138361","text":" / "},{"id":"spn-138362","marks":["code"],"text":"import Foo"},{"id":"spn-138363","text":" / "},{"id":"spn-138364","marks":["code"],"text":"use Foo"},{"id":"spn-138365","text":" / "},{"id":"spn-138366","marks":["code"],"text":"require Foo"},{"id":"spn-138367","text":" -> "},{"id":"spn-138368","marks":["code"],"text":"derived_from"},{"id":"spn-138369","text":" edge"}]}],"id":"blk-75588","kind":"list-item"},{"blocks":[{"id":"blk-75591","kind":"paragraph","spans":[{"id":"spn-138370","marks":["bold"],"text":"JS/TS"},{"id":"spn-138371","text":": "},{"id":"spn-138372","marks":["code"],"text":"import ... from './foo'"},{"id":"spn-138373","text":" / "},{"id":"spn-138374","marks":["code"],"text":"require('./foo')"},{"id":"spn-138375","text":" -> "},{"id":"spn-138376","marks":["code"],"text":"derived_from"},{"id":"spn-138377","text":" edge"}]}],"id":"blk-75590","kind":"list-item"},{"blocks":[{"id":"blk-75593","kind":"paragraph","spans":[{"id":"spn-138378","marks":["bold"],"text":"Markdown"},{"id":"spn-138379","text":": backtick file paths, cross-project names -> "},{"id":"spn-138380","marks":["code"],"text":"related"},{"id":"spn-138381","text":" edge"}]}],"id":"blk-75592","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75594","kind":"code","language":"text","text":"act(action: \"store_edge\", source_id: \"<importer_node>\", target_id: \"<imported_node>\", edge_type: \"derived_from\", weight: 0.6)"},{"id":"blk-75595","kind":"heading","level":2,"spans":[{"id":"spn-138382","text":"Anti-patterns to avoid"}]},{"id":"blk-75596","items":[{"blocks":[{"id":"blk-75598","kind":"paragraph","spans":[{"id":"spn-138383","text":"Don't sync every tiny edit in real-time — batch at natural breakpoints"}]}],"id":"blk-75597","kind":"list-item"},{"blocks":[{"id":"blk-75600","kind":"paragraph","spans":[{"id":"spn-138384","text":"Don't ingest binary files, node_modules, _build, deps, or .git directories"}]}],"id":"blk-75599","kind":"list-item"},{"blocks":[{"id":"blk-75602","kind":"paragraph","spans":[{"id":"spn-138385","text":"Don't set confidence above 0.65 for file content (it's raw, not curated knowledge)"}]}],"id":"blk-75601","kind":"list-item"},{"blocks":[{"id":"blk-75604","kind":"paragraph","spans":[{"id":"spn-138386","text":"Don't skip edge extraction — edges are what make the graph useful for retrieval"}]}],"id":"blk-75603","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierajygujqo3rxyytoyw6zblndpkxxa67svvd5wzhegrphwan3oal7eq","vocabulary":"ampersand.docs.fs.v1"}