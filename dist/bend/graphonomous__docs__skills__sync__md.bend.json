{"bendscript":"0.1","blocks":[{"id":"blk-68024","kind":"heading","level":1,"spans":[{"id":"spn-98772","text":"Filesystem Sync — Batch Ingest to Graphonomous"}]},{"id":"blk-68025","kind":"paragraph","spans":[{"id":"spn-98773","text":"Sync filesystem changes into the Graphonomous knowledge graph."}]},{"id":"blk-68026","kind":"heading","level":2,"spans":[{"id":"spn-98774","text":"Arguments"}]},{"id":"blk-68027","kind":"paragraph","spans":[{"id":"spn-98775","text":"Optional path or flags: $ARGUMENTS"}]},{"id":"blk-68028","items":[{"blocks":[{"id":"blk-68030","kind":"paragraph","spans":[{"id":"spn-98776","text":"No arguments: sync only files changed during this session (tracked by the PostToolUse hook)"}]}],"id":"blk-68029","kind":"list-item"},{"blocks":[{"id":"blk-68032","kind":"paragraph","spans":[{"id":"spn-98777","marks":["code"],"text":"<path>"},{"id":"spn-98778","text":": scan a specific directory (uses "},{"id":"spn-98779","marks":["code"],"text":"scan_directory"},{"id":"spn-98780","text":" for full traversal)"}]}],"id":"blk-68031","kind":"list-item"},{"blocks":[{"id":"blk-68034","kind":"paragraph","spans":[{"id":"spn-98781","marks":["code"],"text":"--full"},{"id":"spn-98782","text":": force full directory scan even if change tracking is available"}]}],"id":"blk-68033","kind":"list-item"},{"blocks":[{"id":"blk-68036","kind":"paragraph","spans":[{"id":"spn-98783","marks":["code"],"text":"--consolidate"},{"id":"spn-98784","text":": run consolidation after ingestion"}]}],"id":"blk-68035","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68037","kind":"heading","level":2,"spans":[{"id":"spn-98785","text":"How It Works"}]},{"id":"blk-68038","kind":"paragraph","spans":[{"id":"spn-98786","text":"This skill bridges the gap between AI-driven file editing and Graphonomous memory. When Claude writes or edits files, those changes should be reflected in the knowledge graph so that future retrieval includes the latest state."}]},{"id":"blk-68039","kind":"heading","level":3,"spans":[{"id":"spn-98787","text":"Mode 1: Tracked Changes (Default)"}]},{"id":"blk-68040","kind":"paragraph","spans":[{"id":"spn-98788","text":"The PostToolUse hook on Write/Edit tools records changed file paths in a session file at "},{"id":"spn-98789","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-98790","text":". This skill reads that file and batch-ingests only the changed files."}]},{"id":"blk-68041","kind":"paragraph","spans":[{"id":"spn-98791","marks":["bold"],"text":"Steps:"}]},{"id":"blk-68042","items":[{"blocks":[{"id":"blk-68044","kind":"paragraph","spans":[{"id":"spn-98792","text":"Read the change tracker file ("},{"id":"spn-98793","marks":["code"],"text":"/tmp/graphonomous-changed-files.jsonl"},{"id":"spn-98794","text":")"}]}],"id":"blk-68043","kind":"list-item"},{"blocks":[{"id":"blk-68046","kind":"paragraph","spans":[{"id":"spn-98795","text":"For each changed file, call "},{"id":"spn-98796","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-98797","text":" with:"}]}],"id":"blk-68045","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68047","items":[{"blocks":[{"id":"blk-68049","kind":"paragraph","spans":[{"id":"spn-98798","marks":["code"],"text":"content"},{"id":"spn-98799","text":": first 16KB of file content"}]}],"id":"blk-68048","kind":"list-item"},{"blocks":[{"id":"blk-68051","kind":"paragraph","spans":[{"id":"spn-98800","marks":["code"],"text":"node_type"},{"id":"spn-98801","text":": \"episodic\""}]}],"id":"blk-68050","kind":"list-item"},{"blocks":[{"id":"blk-68053","kind":"paragraph","spans":[{"id":"spn-98802","marks":["code"],"text":"source"},{"id":"spn-98803","text":": \"filesystem_sync\""}]}],"id":"blk-68052","kind":"list-item"},{"blocks":[{"id":"blk-68055","kind":"paragraph","spans":[{"id":"spn-98804","marks":["code"],"text":"confidence"},{"id":"spn-98805","text":": 0.65"}]}],"id":"blk-68054","kind":"list-item"},{"blocks":[{"id":"blk-68057","kind":"paragraph","spans":[{"id":"spn-98806","marks":["code"],"text":"metadata"},{"id":"spn-98807","text":": "},{"id":"spn-98808","marks":["code"],"text":"{\"path\": \"<absolute_path>\", \"extension\": \"<ext>\", \"sync_reason\": \"file_changed\"}"}]}],"id":"blk-68056","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68058","items":[{"blocks":[{"id":"blk-68060","kind":"paragraph","spans":[{"id":"spn-98809","text":"After all nodes are stored, create edges between related files using "},{"id":"spn-98810","marks":["code"],"text":"act(action: \"store_edge\", ...)"},{"id":"spn-98811","text":":"}]}],"id":"blk-68059","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-68061","items":[{"blocks":[{"id":"blk-68063","kind":"paragraph","spans":[{"id":"spn-98812","text":"Files in the same directory get "},{"id":"spn-98813","marks":["code"],"text":"related"},{"id":"spn-98814","text":" edges (weight 0.4)"}]}],"id":"blk-68062","kind":"list-item"},{"blocks":[{"id":"blk-68065","kind":"paragraph","spans":[{"id":"spn-98815","text":"Files that import/reference each other get "},{"id":"spn-98816","marks":["code"],"text":"derived_from"},{"id":"spn-98817","text":" edges (weight 0.6)"}]}],"id":"blk-68064","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68066","items":[{"blocks":[{"id":"blk-68068","kind":"paragraph","spans":[{"id":"spn-98818","text":"Clear the change tracker file"}]}],"id":"blk-68067","kind":"list-item"},{"blocks":[{"id":"blk-68070","kind":"paragraph","spans":[{"id":"spn-98819","text":"Report: files synced, nodes created, edges created"}]}],"id":"blk-68069","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-68071","kind":"paragraph","spans":[{"id":"spn-98820","marks":["bold"],"text":"Example — sync tracked changes:"}]},{"id":"blk-68072","kind":"code","language":"text","text":"/graphonomous:sync"},{"id":"blk-68073","kind":"heading","level":3,"spans":[{"id":"spn-98821","text":"Mode 2: Directory Scan (with path argument)"}]},{"id":"blk-68074","kind":"paragraph","spans":[{"id":"spn-98822","text":"When given a path, performs a full "},{"id":"spn-98823","marks":["code"],"text":"scan_directory"},{"id":"spn-98824","text":"-style ingestion."}]},{"id":"blk-68075","kind":"paragraph","spans":[{"id":"spn-98825","marks":["bold"],"text":"Steps:"}]},{"id":"blk-68076","items":[{"blocks":[{"id":"blk-68078","kind":"paragraph","spans":[{"id":"spn-98826","text":"List files in the target directory (respecting .gitignore, max 1MB per file)"}]}],"id":"blk-68077","kind":"list-item"},{"blocks":[{"id":"blk-68080","kind":"paragraph","spans":[{"id":"spn-98827","text":"For each file matching supported extensions (.ex, .exs, .ts, .js, .tsx, .md, .html, .css, .json, .yml, .yaml, .toml, .svelte):"}]}],"id":"blk-68079","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68081","items":[{"blocks":[{"id":"blk-68083","kind":"paragraph","spans":[{"id":"spn-98828","text":"Read first 16KB"}]}],"id":"blk-68082","kind":"list-item"},{"blocks":[{"id":"blk-68085","kind":"paragraph","spans":[{"id":"spn-98829","text":"Call "},{"id":"spn-98830","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-98831","text":" with file content and path metadata"}]}],"id":"blk-68084","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68086","items":[{"blocks":[{"id":"blk-68088","kind":"paragraph","spans":[{"id":"spn-98832","text":"Create inter-file edges based on import/reference patterns"}]}],"id":"blk-68087","kind":"list-item"},{"blocks":[{"id":"blk-68090","kind":"paragraph","spans":[{"id":"spn-98833","text":"Report ingestion stats"}]}],"id":"blk-68089","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-68091","kind":"paragraph","spans":[{"id":"spn-98834","marks":["bold"],"text":"Example — scan a specific directory:"}]},{"id":"blk-68092","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/lib/"},{"id":"blk-68093","kind":"paragraph","spans":[{"id":"spn-98835","marks":["bold"],"text":"Example — full scan with consolidation:"}]},{"id":"blk-68094","kind":"code","language":"text","text":"/graphonomous:sync graphonomous/ --full --consolidate"},{"id":"blk-68095","kind":"heading","level":3,"spans":[{"id":"spn-98836","text":"Mode 3: Post-Consolidation"}]},{"id":"blk-68096","kind":"paragraph","spans":[{"id":"spn-98837","text":"If "},{"id":"spn-98838","marks":["code"],"text":"--consolidate"},{"id":"spn-98839","text":" is passed, run consolidation after ingestion:"}]},{"id":"blk-68097","kind":"code","language":"text","text":"consolidate(action: \"run\")"},{"id":"blk-68098","kind":"heading","level":2,"spans":[{"id":"spn-98840","text":"Deduplication"}]},{"id":"blk-68099","kind":"paragraph","spans":[{"id":"spn-98841","text":"Before storing, check if a node with the same path already exists:"}]},{"id":"blk-68100","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<file path>\", limit: 1)"},{"id":"blk-68101","kind":"paragraph","spans":[{"id":"spn-98842","text":"If a high-similarity node exists (score > 0.9), update it via "},{"id":"spn-98843","marks":["code"],"text":"learn(action: \"from_feedback\", feedback_type: \"correction\")"},{"id":"spn-98844","text":" rather than creating a duplicate."}]},{"id":"blk-68102","kind":"heading","level":2,"spans":[{"id":"spn-98845","text":"Edge Extraction Patterns"}]},{"id":"blk-68103","kind":"paragraph","spans":[{"id":"spn-98846","text":"After storing nodes, create edges for detected references:"}]},{"id":"blk-68104","items":[{"blocks":[{"id":"blk-68106","kind":"paragraph","spans":[{"id":"spn-98847","marks":["bold"],"text":"Elixir"},{"id":"spn-98848","text":": "},{"id":"spn-98849","marks":["code"],"text":"alias Foo.Bar"},{"id":"spn-98850","text":" / "},{"id":"spn-98851","marks":["code"],"text":"import Foo"},{"id":"spn-98852","text":" / "},{"id":"spn-98853","marks":["code"],"text":"use Foo"},{"id":"spn-98854","text":" / "},{"id":"spn-98855","marks":["code"],"text":"require Foo"},{"id":"spn-98856","text":" -> "},{"id":"spn-98857","marks":["code"],"text":"derived_from"},{"id":"spn-98858","text":" edge"}]}],"id":"blk-68105","kind":"list-item"},{"blocks":[{"id":"blk-68108","kind":"paragraph","spans":[{"id":"spn-98859","marks":["bold"],"text":"JS/TS"},{"id":"spn-98860","text":": "},{"id":"spn-98861","marks":["code"],"text":"import ... from './foo'"},{"id":"spn-98862","text":" / "},{"id":"spn-98863","marks":["code"],"text":"require('./foo')"},{"id":"spn-98864","text":" -> "},{"id":"spn-98865","marks":["code"],"text":"derived_from"},{"id":"spn-98866","text":" edge"}]}],"id":"blk-68107","kind":"list-item"},{"blocks":[{"id":"blk-68110","kind":"paragraph","spans":[{"id":"spn-98867","marks":["bold"],"text":"Markdown"},{"id":"spn-98868","text":": backtick file paths, cross-project names -> "},{"id":"spn-98869","marks":["code"],"text":"related"},{"id":"spn-98870","text":" edge"}]}],"id":"blk-68109","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68111","kind":"code","language":"text","text":"act(action: \"store_edge\", source_id: \"<importer_node>\", target_id: \"<imported_node>\", edge_type: \"derived_from\", weight: 0.6)"},{"id":"blk-68112","kind":"heading","level":2,"spans":[{"id":"spn-98871","text":"Anti-patterns to avoid"}]},{"id":"blk-68113","items":[{"blocks":[{"id":"blk-68115","kind":"paragraph","spans":[{"id":"spn-98872","text":"Don't sync every tiny edit in real-time — batch at natural breakpoints"}]}],"id":"blk-68114","kind":"list-item"},{"blocks":[{"id":"blk-68117","kind":"paragraph","spans":[{"id":"spn-98873","text":"Don't ingest binary files, node_modules, _build, deps, or .git directories"}]}],"id":"blk-68116","kind":"list-item"},{"blocks":[{"id":"blk-68119","kind":"paragraph","spans":[{"id":"spn-98874","text":"Don't set confidence above 0.65 for file content (it's raw, not curated knowledge)"}]}],"id":"blk-68118","kind":"list-item"},{"blocks":[{"id":"blk-68121","kind":"paragraph","spans":[{"id":"spn-98875","text":"Don't skip edge extraction — edges are what make the graph useful for retrieval"}]}],"id":"blk-68120","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierayieslqjbrg4gcxob6ssf2g3yblek2n4hk4pxee3ruuoxae7lyliq","vocabulary":"ampersand.docs.fs.v1"}