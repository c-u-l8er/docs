{"bendscript":"0.1","blocks":[{"id":"blk-11594","kind":"heading","level":1,"spans":[{"id":"spn-10825","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10826","text":" — κ-Aware Deliberation for the [&] Protocol"}]},{"id":"blk-11595","kind":"paragraph","spans":[{"id":"spn-10827","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10828","text":" is the capability page for the "},{"id":"spn-10829","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10830","text":" subtype in the [&] Protocol."}]},{"id":"blk-11596","kind":"paragraph","spans":[{"id":"spn-10831","text":"It represents a reasoning surface optimized for "},{"id":"spn-10832","marks":["bold"],"text":"cyclic knowledge regions"},{"id":"spn-10833","text":" where simple one-shot evaluation is often insufficient."}]},{"id":"blk-11597","kind":"paragraph","spans":[{"id":"spn-10834","text":"In short:"}]},{"blocks":[{"id":"blk-11599","kind":"paragraph","spans":[{"id":"spn-10835","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10836","text":" is the protocol capability for agents that must reason through feedback loops using topology-aware decomposition and reconciliation."}]}],"id":"blk-11598","kind":"quote"},{"id":"blk-11600","kind":"heading","level":2,"spans":[{"id":"spn-10837","text":"1. Definition"}]},{"id":"blk-11601","kind":"paragraph","spans":[{"id":"spn-10838","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10839","text":" is a subtype of "},{"id":"spn-10840","marks":["code"],"text":"&reason"},{"id":"spn-10841","text":"."}]},{"id":"blk-11602","kind":"paragraph","spans":[{"id":"spn-10842","text":"It describes a focused reasoning capability that consumes graph-structural context (for example SCCs, κ values, and fault lines) and produces:"}]},{"id":"blk-11603","items":[{"blocks":[{"id":"blk-11605","kind":"paragraph","spans":[{"id":"spn-10843","text":"reconciled conclusions"}]}],"id":"blk-11604","kind":"list-item"},{"blocks":[{"id":"blk-11607","kind":"paragraph","spans":[{"id":"spn-10844","text":"confidence-scored outputs"}]}],"id":"blk-11606","kind":"list-item"},{"blocks":[{"id":"blk-11609","kind":"paragraph","spans":[{"id":"spn-10845","text":"optional crystallized knowledge suitable for write-back into memory"}]}],"id":"blk-11608","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11610","kind":"paragraph","spans":[{"id":"spn-10846","text":"Unlike generic reasoning steps, "},{"id":"spn-10847","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10848","text":" is explicitly designed to operate on "},{"id":"spn-10849","marks":["bold"],"text":"non-acyclic"},{"id":"spn-10850","text":" knowledge structures."}]},{"id":"blk-11611","kind":"heading","level":2,"spans":[{"id":"spn-10851","text":"2. Why this capability exists"}]},{"id":"blk-11612","kind":"paragraph","spans":[{"id":"spn-10852","text":"Many decision problems are not DAG-shaped. They contain circular dependencies such as:"}]},{"id":"blk-11613","items":[{"blocks":[{"id":"blk-11615","kind":"paragraph","spans":[{"id":"spn-10853","text":"demand ↔ pricing feedback"}]}],"id":"blk-11614","kind":"list-item"},{"blocks":[{"id":"blk-11617","kind":"paragraph","spans":[{"id":"spn-10854","text":"quality ↔ retention feedback"}]}],"id":"blk-11616","kind":"list-item"},{"blocks":[{"id":"blk-11619","kind":"paragraph","spans":[{"id":"spn-10855","text":"risk ↔ intervention feedback"}]}],"id":"blk-11618","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11620","kind":"paragraph","spans":[{"id":"spn-10856","text":"In these cases, a direct “retrieve then decide” step can underperform because the model must juggle mutually dependent assumptions."}]},{"id":"blk-11621","kind":"paragraph","spans":[{"id":"spn-10857","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10858","text":" exists to make this structure explicit and routable:"}]},{"id":"blk-11622","items":[{"blocks":[{"id":"blk-11624","kind":"paragraph","spans":[{"id":"spn-10859","text":"detect cyclic structure from memory topology"}]}],"id":"blk-11623","kind":"list-item"},{"blocks":[{"id":"blk-11626","kind":"paragraph","spans":[{"id":"spn-10860","text":"decompose along weak links (fault lines)"}]}],"id":"blk-11625","kind":"list-item"},{"blocks":[{"id":"blk-11628","kind":"paragraph","spans":[{"id":"spn-10861","text":"run focused passes on scoped partitions"}]}],"id":"blk-11627","kind":"list-item"},{"blocks":[{"id":"blk-11630","kind":"paragraph","spans":[{"id":"spn-10862","text":"reconcile intermediate conclusions"}]}],"id":"blk-11629","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-11631","kind":"paragraph","spans":[{"id":"spn-10863","text":"This improves controllability, auditability, and consistency in high-friction reasoning regions."}]},{"id":"blk-11632","kind":"heading","level":2,"spans":[{"id":"spn-10864","text":"3. Where it fits in the protocol"}]},{"id":"blk-11633","kind":"paragraph","spans":[{"id":"spn-10865","text":"The [&] Protocol organizes cognition, embodiment, and governance into six primitive families:"}]},{"id":"blk-11634","items":[{"blocks":[{"id":"blk-11636","kind":"paragraph","spans":[{"id":"spn-10866","marks":["code"],"text":"&memory"},{"id":"spn-10867","text":" — what the agent knows"}]}],"id":"blk-11635","kind":"list-item"},{"blocks":[{"id":"blk-11638","kind":"paragraph","spans":[{"id":"spn-10868","marks":["code"],"text":"&reason"},{"id":"spn-10869","text":" — how the agent decides"}]}],"id":"blk-11637","kind":"list-item"},{"blocks":[{"id":"blk-11640","kind":"paragraph","spans":[{"id":"spn-10870","marks":["code"],"text":"&time"},{"id":"spn-10871","text":" — when things happen"}]}],"id":"blk-11639","kind":"list-item"},{"blocks":[{"id":"blk-11642","kind":"paragraph","spans":[{"id":"spn-10872","marks":["code"],"text":"&space"},{"id":"spn-10873","text":" — where things are"}]}],"id":"blk-11641","kind":"list-item"},{"blocks":[{"id":"blk-11644","kind":"paragraph","spans":[{"id":"spn-10874","marks":["code"],"text":"&body"},{"id":"spn-10875","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-11643","kind":"list-item"},{"blocks":[{"id":"blk-11646","kind":"paragraph","spans":[{"id":"spn-10876","marks":["code"],"text":"&govern"},{"id":"spn-10877","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-11645","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11647","kind":"paragraph","spans":[{"id":"spn-10878","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10879","text":" sits under "},{"id":"spn-10880","marks":["code"],"text":"&reason"},{"id":"spn-10881","text":" and composes most naturally with:"}]},{"id":"blk-11648","items":[{"blocks":[{"id":"blk-11650","kind":"paragraph","spans":[{"id":"spn-10882","marks":["code"],"text":"&memory.graph"},{"id":"spn-10883","text":" (topology and retrieval grounding)"}]}],"id":"blk-11649","kind":"list-item"},{"blocks":[{"id":"blk-11652","kind":"paragraph","spans":[{"id":"spn-10884","marks":["code"],"text":"&reason.attend"},{"id":"spn-10885","text":" (attention routing into deliberate work)"}]}],"id":"blk-11651","kind":"list-item"},{"blocks":[{"id":"blk-11654","kind":"paragraph","spans":[{"id":"spn-10886","marks":["code"],"text":"&memory.*"},{"id":"spn-10887","text":" write-back flows for crystallized conclusions"}]}],"id":"blk-11653","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11655","kind":"heading","level":2,"spans":[{"id":"spn-10888","text":"4. Capability contract (representative)"}]},{"id":"blk-11656","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&reason.deliberate\",\n  \"provider\": \"graphonomous\",\n  \"version\": \"0.1.0\",\n  \"description\": \"κ-driven deliberation contract for topology-aware focused reasoning over cyclic knowledge regions.\",\n  \"operations\": {\n    \"deliberate\": {\n      \"in\": \"topology_result\",\n      \"out\": \"deliberation_result\"\n    },\n    \"decompose\": {\n      \"in\": \"topology_result\",\n      \"out\": \"partitions\"\n    },\n    \"reconcile\": {\n      \"in\": \"intermediate_conclusions\",\n      \"out\": \"deliberation_result\"\n    }\n  },\n  \"accepts_from\": [\"&memory.graph\", \"&memory.*\", \"topology_result\", \"context\"],\n  \"feeds_into\": [\"&memory.graph\", \"&reason.*\", \"deliberation_result\", \"output\"],\n  \"a2a_skills\": [\"topology-aware-deliberation\", \"fault-line-reconciliation\"]\n}"},{"id":"blk-11657","kind":"heading","level":2,"spans":[{"id":"spn-10889","text":"5. Operations"}]},{"id":"blk-11658","kind":"heading","level":3,"spans":[{"id":"spn-10890","marks":["code"],"text":"deliberate"}]},{"id":"blk-11659","kind":"paragraph","spans":[{"id":"spn-10891","text":"Runs focused reasoning over selected SCC regions and returns reconciled conclusions with confidence metadata."}]},{"id":"blk-11660","kind":"heading","level":3,"spans":[{"id":"spn-10892","marks":["code"],"text":"decompose"}]},{"id":"blk-11661","kind":"paragraph","spans":[{"id":"spn-10893","text":"Splits cyclic regions into scoped partitions (typically by fault lines) for manageable passes."}]},{"id":"blk-11662","kind":"heading","level":3,"spans":[{"id":"spn-10894","marks":["code"],"text":"reconcile"}]},{"id":"blk-11663","kind":"paragraph","spans":[{"id":"spn-10895","text":"Combines partition-level intermediates into a coherent result suitable for downstream action or memory write-back."}]},{"id":"blk-11664","kind":"heading","level":2,"spans":[{"id":"spn-10896","text":"6. Composition patterns"}]},{"id":"blk-11665","kind":"heading","level":3,"spans":[{"id":"spn-10897","text":"Pattern A — Topology-aware reactive reasoning"}]},{"id":"blk-11666","kind":"code","language":"text","text":"query\n  -> &memory.graph.recall()\n  -> &memory.graph.topology()\n  -> &reason.deliberate.deliberate()\n  -> &memory.graph.learn()"},{"id":"blk-11667","kind":"paragraph","spans":[{"id":"spn-10898","text":"Use when a query touches cyclic regions and requires deeper reasoning before action."}]},{"id":"blk-11668","kind":"heading","level":3,"spans":[{"id":"spn-10899","text":"Pattern B — Attention-triggered deliberation"}]},{"id":"blk-11669","kind":"code","language":"text","text":"heartbeat_or_demand\n  -> &reason.attend.survey()\n  -> &reason.attend.triage()\n  -> &reason.deliberate.deliberate()\n  -> output"},{"id":"blk-11670","kind":"paragraph","spans":[{"id":"spn-10900","text":"Use when an attention engine routes high-friction regions into explicit deliberation."}]},{"id":"blk-11671","kind":"heading","level":3,"spans":[{"id":"spn-10901","text":"Pattern C — Deliberate then justify"}]},{"id":"blk-11672","kind":"code","language":"text","text":"topology_result\n  -> &reason.deliberate.deliberate()\n  -> &reason.argument.justify()\n  -> output"},{"id":"blk-11673","kind":"paragraph","spans":[{"id":"spn-10902","text":"Use when downstream stakeholders require structured justification artifacts."}]},{"id":"blk-11674","kind":"heading","level":2,"spans":[{"id":"spn-10903","text":"7. Tier-aware behavior"}]},{"id":"blk-11675","kind":"paragraph","spans":[{"id":"spn-10904","text":"Implementations may adapt "},{"id":"spn-10905","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10906","text":" by declared "},{"id":"spn-10907","marks":["code"],"text":"model_tier"},{"id":"spn-10908","text":":"}]},{"id":"blk-11676","items":[{"blocks":[{"id":"blk-11678","kind":"paragraph","spans":[{"id":"spn-10909","marks":["code"],"text":"local_small"}]}],"id":"blk-11677","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11679","kind":"paragraph","spans":[{"id":"spn-10910","text":"Often uses single-pass strategy for higher κ only; may skip low-κ cycles below a floor."}]},{"id":"blk-11680","items":[{"blocks":[{"id":"blk-11682","kind":"paragraph","spans":[{"id":"spn-10911","marks":["code"],"text":"local_large"}]}],"id":"blk-11681","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11683","kind":"paragraph","spans":[{"id":"spn-10912","text":"Typically supports multi-pass decomposition/reconciliation on κ > 0."}]},{"id":"blk-11684","items":[{"blocks":[{"id":"blk-11686","kind":"paragraph","spans":[{"id":"spn-10913","marks":["code"],"text":"cloud_frontier"}]}],"id":"blk-11685","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11687","kind":"paragraph","spans":[{"id":"spn-10914","text":"Supports deeper multi-pass budgets and larger partition scopes."}]},{"id":"blk-11688","kind":"paragraph","spans":[{"id":"spn-10915","text":"This keeps routing semantics stable while adapting execution depth to available inference capacity."}]},{"id":"blk-11689","kind":"heading","level":2,"spans":[{"id":"spn-10916","text":"8. Governance implications"}]},{"id":"blk-11690","kind":"paragraph","spans":[{"id":"spn-10917","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10918","text":" should honor governance boundaries in both routing and output handling:"}]},{"id":"blk-11691","items":[{"blocks":[{"id":"blk-11693","kind":"paragraph","spans":[{"id":"spn-10919","text":"respect escalation thresholds ("},{"id":"spn-10920","marks":["code"],"text":"confidence_below"},{"id":"spn-10921","text":", cost limits, boundary flags)"}]}],"id":"blk-11692","kind":"list-item"},{"blocks":[{"id":"blk-11695","kind":"paragraph","spans":[{"id":"spn-10922","text":"enforce hard constraints before downstream action dispatch"}]}],"id":"blk-11694","kind":"list-item"},{"blocks":[{"id":"blk-11697","kind":"paragraph","spans":[{"id":"spn-10923","text":"avoid auto-execution when autonomy level is limited to "},{"id":"spn-10924","marks":["code"],"text":"observe"},{"id":"spn-10925","text":" or "},{"id":"spn-10926","marks":["code"],"text":"advise"}]}],"id":"blk-11696","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11698","kind":"paragraph","spans":[{"id":"spn-10927","text":"A deliberation result should be treated as "},{"id":"spn-10928","marks":["bold"],"text":"decision support"},{"id":"spn-10929","text":", not unconditional permission to act."}]},{"id":"blk-11699","kind":"heading","level":2,"spans":[{"id":"spn-10930","text":"9. Provenance implications"}]},{"id":"blk-11700","kind":"paragraph","spans":[{"id":"spn-10931","text":"A deliberation step should preserve strong traceability, including:"}]},{"id":"blk-11701","items":[{"blocks":[{"id":"blk-11703","kind":"paragraph","spans":[{"id":"spn-10932","text":"topology basis (SCC IDs, κ values, fault-line edges)"}]}],"id":"blk-11702","kind":"list-item"},{"blocks":[{"id":"blk-11705","kind":"paragraph","spans":[{"id":"spn-10933","text":"operation name and provider"}]}],"id":"blk-11704","kind":"list-item"},{"blocks":[{"id":"blk-11707","kind":"paragraph","spans":[{"id":"spn-10934","text":"input and output hashes"}]}],"id":"blk-11706","kind":"list-item"},{"blocks":[{"id":"blk-11709","kind":"paragraph","spans":[{"id":"spn-10935","text":"parent trace linkage"}]}],"id":"blk-11708","kind":"list-item"},{"blocks":[{"id":"blk-11711","kind":"paragraph","spans":[{"id":"spn-10936","text":"timestamps and any transport trace IDs"}]}],"id":"blk-11710","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11712","kind":"paragraph","spans":[{"id":"spn-10937","text":"This is essential for replay, audit, and post-outcome learning loops."}]},{"id":"blk-11713","kind":"heading","level":2,"spans":[{"id":"spn-10938","text":"10. Compatible providers"}]},{"id":"blk-11714","kind":"paragraph","spans":[{"id":"spn-10939","text":"Current ecosystem-aligned provider:"}]},{"id":"blk-11715","items":[{"blocks":[{"id":"blk-11717","kind":"paragraph","spans":[{"id":"spn-10940","marks":["code"],"text":"graphonomous"}]}],"id":"blk-11716","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11718","kind":"paragraph","spans":[{"id":"spn-10941","text":"Protocol note: providers are implementations; "},{"id":"spn-10942","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10943","text":" remains the capability interface."}]},{"id":"blk-11719","kind":"heading","level":2,"spans":[{"id":"spn-10944","text":"11. Anti-patterns"}]},{"id":"blk-11720","items":[{"blocks":[{"id":"blk-11722","kind":"paragraph","spans":[{"id":"spn-10945","text":"Treating cyclic reasoning as plain one-shot ranking without topology context."}]}],"id":"blk-11721","kind":"list-item"},{"blocks":[{"id":"blk-11724","kind":"paragraph","spans":[{"id":"spn-10946","text":"Collapsing "},{"id":"spn-10947","marks":["code"],"text":"decompose"},{"id":"spn-10948","text":" and "},{"id":"spn-10949","marks":["code"],"text":"reconcile"},{"id":"spn-10950","text":" semantics into undocumented prompt hacks."}]}],"id":"blk-11723","kind":"list-item"},{"blocks":[{"id":"blk-11726","kind":"paragraph","spans":[{"id":"spn-10951","text":"Emitting deliberation outputs with no confidence or provenance linkage."}]}],"id":"blk-11725","kind":"list-item"},{"blocks":[{"id":"blk-11728","kind":"paragraph","spans":[{"id":"spn-10952","text":"Skipping governance checks and directly dispatching real-world actions."}]}],"id":"blk-11727","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11729","kind":"heading","level":2,"spans":[{"id":"spn-10953","text":"12. Summary"}]},{"id":"blk-11730","kind":"paragraph","spans":[{"id":"spn-10954","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10955","text":" formalizes a critical reasoning mode for cyclic, feedback-heavy domains."}]},{"id":"blk-11731","kind":"paragraph","spans":[{"id":"spn-10956","text":"It gives agent systems:"}]},{"id":"blk-11732","items":[{"blocks":[{"id":"blk-11734","kind":"paragraph","spans":[{"id":"spn-10957","text":"explicit topology-aware routing"}]}],"id":"blk-11733","kind":"list-item"},{"blocks":[{"id":"blk-11736","kind":"paragraph","spans":[{"id":"spn-10958","text":"scoped decomposition for hard reasoning regions"}]}],"id":"blk-11735","kind":"list-item"},{"blocks":[{"id":"blk-11738","kind":"paragraph","spans":[{"id":"spn-10959","text":"reconciled, confidence-bearing conclusions"}]}],"id":"blk-11737","kind":"list-item"},{"blocks":[{"id":"blk-11740","kind":"paragraph","spans":[{"id":"spn-10960","text":"clean composition with memory, governance, and provenance layers"}]}],"id":"blk-11739","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11741","kind":"paragraph","spans":[{"id":"spn-10961","text":"This makes deliberation a portable protocol capability rather than ad hoc prompt behavior."}]}],"edges":[],"id":"bagaaiera53yvmmz44mg2c5dy7e2poljbi7p7thg2awxz5ripxk5nanvom6va","vocabulary":"ampersand.docs.fs.v1"}