{"bendscript":"0.1","blocks":[{"id":"blk-11596","kind":"heading","level":1,"spans":[{"id":"spn-10625","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10626","text":" — κ-Aware Deliberation for the [&] Protocol"}]},{"id":"blk-11597","kind":"paragraph","spans":[{"id":"spn-10627","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10628","text":" is the capability page for the "},{"id":"spn-10629","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10630","text":" subtype in the [&] Protocol."}]},{"id":"blk-11598","kind":"paragraph","spans":[{"id":"spn-10631","text":"It represents a reasoning surface optimized for "},{"id":"spn-10632","marks":["bold"],"text":"cyclic knowledge regions"},{"id":"spn-10633","text":" where simple one-shot evaluation is often insufficient."}]},{"id":"blk-11599","kind":"paragraph","spans":[{"id":"spn-10634","text":"In short:"}]},{"blocks":[{"id":"blk-11601","kind":"paragraph","spans":[{"id":"spn-10635","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10636","text":" is the protocol capability for agents that must reason through feedback loops using topology-aware decomposition and reconciliation."}]}],"id":"blk-11600","kind":"quote"},{"id":"blk-11602","kind":"heading","level":2,"spans":[{"id":"spn-10637","text":"1. Definition"}]},{"id":"blk-11603","kind":"paragraph","spans":[{"id":"spn-10638","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10639","text":" is a subtype of "},{"id":"spn-10640","marks":["code"],"text":"&reason"},{"id":"spn-10641","text":"."}]},{"id":"blk-11604","kind":"paragraph","spans":[{"id":"spn-10642","text":"It describes a focused reasoning capability that consumes graph-structural context (for example SCCs, κ values, and fault lines) and produces:"}]},{"id":"blk-11605","items":[{"blocks":[{"id":"blk-11607","kind":"paragraph","spans":[{"id":"spn-10643","text":"reconciled conclusions"}]}],"id":"blk-11606","kind":"list-item"},{"blocks":[{"id":"blk-11609","kind":"paragraph","spans":[{"id":"spn-10644","text":"confidence-scored outputs"}]}],"id":"blk-11608","kind":"list-item"},{"blocks":[{"id":"blk-11611","kind":"paragraph","spans":[{"id":"spn-10645","text":"optional crystallized knowledge suitable for write-back into memory"}]}],"id":"blk-11610","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11612","kind":"paragraph","spans":[{"id":"spn-10646","text":"Unlike generic reasoning steps, "},{"id":"spn-10647","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10648","text":" is explicitly designed to operate on "},{"id":"spn-10649","marks":["bold"],"text":"non-acyclic"},{"id":"spn-10650","text":" knowledge structures."}]},{"id":"blk-11613","kind":"heading","level":2,"spans":[{"id":"spn-10651","text":"2. Why this capability exists"}]},{"id":"blk-11614","kind":"paragraph","spans":[{"id":"spn-10652","text":"Many decision problems are not DAG-shaped. They contain circular dependencies such as:"}]},{"id":"blk-11615","items":[{"blocks":[{"id":"blk-11617","kind":"paragraph","spans":[{"id":"spn-10653","text":"demand ↔ pricing feedback"}]}],"id":"blk-11616","kind":"list-item"},{"blocks":[{"id":"blk-11619","kind":"paragraph","spans":[{"id":"spn-10654","text":"quality ↔ retention feedback"}]}],"id":"blk-11618","kind":"list-item"},{"blocks":[{"id":"blk-11621","kind":"paragraph","spans":[{"id":"spn-10655","text":"risk ↔ intervention feedback"}]}],"id":"blk-11620","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11622","kind":"paragraph","spans":[{"id":"spn-10656","text":"In these cases, a direct “retrieve then decide” step can underperform because the model must juggle mutually dependent assumptions."}]},{"id":"blk-11623","kind":"paragraph","spans":[{"id":"spn-10657","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10658","text":" exists to make this structure explicit and routable:"}]},{"id":"blk-11624","items":[{"blocks":[{"id":"blk-11626","kind":"paragraph","spans":[{"id":"spn-10659","text":"detect cyclic structure from memory topology"}]}],"id":"blk-11625","kind":"list-item"},{"blocks":[{"id":"blk-11628","kind":"paragraph","spans":[{"id":"spn-10660","text":"decompose along weak links (fault lines)"}]}],"id":"blk-11627","kind":"list-item"},{"blocks":[{"id":"blk-11630","kind":"paragraph","spans":[{"id":"spn-10661","text":"run focused passes on scoped partitions"}]}],"id":"blk-11629","kind":"list-item"},{"blocks":[{"id":"blk-11632","kind":"paragraph","spans":[{"id":"spn-10662","text":"reconcile intermediate conclusions"}]}],"id":"blk-11631","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-11633","kind":"paragraph","spans":[{"id":"spn-10663","text":"This improves controllability, auditability, and consistency in high-friction reasoning regions."}]},{"id":"blk-11634","kind":"heading","level":2,"spans":[{"id":"spn-10664","text":"3. Where it fits in the protocol"}]},{"id":"blk-11635","kind":"paragraph","spans":[{"id":"spn-10665","text":"The [&] Protocol organizes cognition, embodiment, and governance into six primitive families:"}]},{"id":"blk-11636","items":[{"blocks":[{"id":"blk-11638","kind":"paragraph","spans":[{"id":"spn-10666","marks":["code"],"text":"&memory"},{"id":"spn-10667","text":" — what the agent knows"}]}],"id":"blk-11637","kind":"list-item"},{"blocks":[{"id":"blk-11640","kind":"paragraph","spans":[{"id":"spn-10668","marks":["code"],"text":"&reason"},{"id":"spn-10669","text":" — how the agent decides"}]}],"id":"blk-11639","kind":"list-item"},{"blocks":[{"id":"blk-11642","kind":"paragraph","spans":[{"id":"spn-10670","marks":["code"],"text":"&time"},{"id":"spn-10671","text":" — when things happen"}]}],"id":"blk-11641","kind":"list-item"},{"blocks":[{"id":"blk-11644","kind":"paragraph","spans":[{"id":"spn-10672","marks":["code"],"text":"&space"},{"id":"spn-10673","text":" — where things are"}]}],"id":"blk-11643","kind":"list-item"},{"blocks":[{"id":"blk-11646","kind":"paragraph","spans":[{"id":"spn-10674","marks":["code"],"text":"&body"},{"id":"spn-10675","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-11645","kind":"list-item"},{"blocks":[{"id":"blk-11648","kind":"paragraph","spans":[{"id":"spn-10676","marks":["code"],"text":"&govern"},{"id":"spn-10677","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-11647","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11649","kind":"paragraph","spans":[{"id":"spn-10678","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10679","text":" sits under "},{"id":"spn-10680","marks":["code"],"text":"&reason"},{"id":"spn-10681","text":" and composes most naturally with:"}]},{"id":"blk-11650","items":[{"blocks":[{"id":"blk-11652","kind":"paragraph","spans":[{"id":"spn-10682","marks":["code"],"text":"&memory.graph"},{"id":"spn-10683","text":" (topology and retrieval grounding)"}]}],"id":"blk-11651","kind":"list-item"},{"blocks":[{"id":"blk-11654","kind":"paragraph","spans":[{"id":"spn-10684","marks":["code"],"text":"&reason.attend"},{"id":"spn-10685","text":" (attention routing into deliberate work)"}]}],"id":"blk-11653","kind":"list-item"},{"blocks":[{"id":"blk-11656","kind":"paragraph","spans":[{"id":"spn-10686","marks":["code"],"text":"&memory.*"},{"id":"spn-10687","text":" write-back flows for crystallized conclusions"}]}],"id":"blk-11655","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11657","kind":"heading","level":2,"spans":[{"id":"spn-10688","text":"4. Capability contract (representative)"}]},{"id":"blk-11658","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&reason.deliberate\",\n  \"provider\": \"graphonomous\",\n  \"version\": \"0.1.0\",\n  \"description\": \"κ-driven deliberation contract for topology-aware focused reasoning over cyclic knowledge regions.\",\n  \"operations\": {\n    \"deliberate\": {\n      \"in\": \"topology_result\",\n      \"out\": \"deliberation_result\"\n    },\n    \"decompose\": {\n      \"in\": \"topology_result\",\n      \"out\": \"partitions\"\n    },\n    \"reconcile\": {\n      \"in\": \"intermediate_conclusions\",\n      \"out\": \"deliberation_result\"\n    }\n  },\n  \"accepts_from\": [\"&memory.graph\", \"&memory.*\", \"topology_result\", \"context\"],\n  \"feeds_into\": [\"&memory.graph\", \"&reason.*\", \"deliberation_result\", \"output\"],\n  \"a2a_skills\": [\"topology-aware-deliberation\", \"fault-line-reconciliation\"]\n}"},{"id":"blk-11659","kind":"heading","level":2,"spans":[{"id":"spn-10689","text":"5. Operations"}]},{"id":"blk-11660","kind":"heading","level":3,"spans":[{"id":"spn-10690","marks":["code"],"text":"deliberate"}]},{"id":"blk-11661","kind":"paragraph","spans":[{"id":"spn-10691","text":"Runs focused reasoning over selected SCC regions and returns reconciled conclusions with confidence metadata."}]},{"id":"blk-11662","kind":"heading","level":3,"spans":[{"id":"spn-10692","marks":["code"],"text":"decompose"}]},{"id":"blk-11663","kind":"paragraph","spans":[{"id":"spn-10693","text":"Splits cyclic regions into scoped partitions (typically by fault lines) for manageable passes."}]},{"id":"blk-11664","kind":"heading","level":3,"spans":[{"id":"spn-10694","marks":["code"],"text":"reconcile"}]},{"id":"blk-11665","kind":"paragraph","spans":[{"id":"spn-10695","text":"Combines partition-level intermediates into a coherent result suitable for downstream action or memory write-back."}]},{"id":"blk-11666","kind":"heading","level":2,"spans":[{"id":"spn-10696","text":"6. Composition patterns"}]},{"id":"blk-11667","kind":"heading","level":3,"spans":[{"id":"spn-10697","text":"Pattern A — Topology-aware reactive reasoning"}]},{"id":"blk-11668","kind":"code","language":"text","text":"query\n  -> &memory.graph.recall()\n  -> &memory.graph.topology()\n  -> &reason.deliberate.deliberate()\n  -> &memory.graph.learn()"},{"id":"blk-11669","kind":"paragraph","spans":[{"id":"spn-10698","text":"Use when a query touches cyclic regions and requires deeper reasoning before action."}]},{"id":"blk-11670","kind":"heading","level":3,"spans":[{"id":"spn-10699","text":"Pattern B — Attention-triggered deliberation"}]},{"id":"blk-11671","kind":"code","language":"text","text":"heartbeat_or_demand\n  -> &reason.attend.survey()\n  -> &reason.attend.triage()\n  -> &reason.deliberate.deliberate()\n  -> output"},{"id":"blk-11672","kind":"paragraph","spans":[{"id":"spn-10700","text":"Use when an attention engine routes high-friction regions into explicit deliberation."}]},{"id":"blk-11673","kind":"heading","level":3,"spans":[{"id":"spn-10701","text":"Pattern C — Deliberate then justify"}]},{"id":"blk-11674","kind":"code","language":"text","text":"topology_result\n  -> &reason.deliberate.deliberate()\n  -> &reason.argument.justify()\n  -> output"},{"id":"blk-11675","kind":"paragraph","spans":[{"id":"spn-10702","text":"Use when downstream stakeholders require structured justification artifacts."}]},{"id":"blk-11676","kind":"heading","level":2,"spans":[{"id":"spn-10703","text":"7. Tier-aware behavior"}]},{"id":"blk-11677","kind":"paragraph","spans":[{"id":"spn-10704","text":"Implementations may adapt "},{"id":"spn-10705","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10706","text":" by declared "},{"id":"spn-10707","marks":["code"],"text":"model_tier"},{"id":"spn-10708","text":":"}]},{"id":"blk-11678","items":[{"blocks":[{"id":"blk-11680","kind":"paragraph","spans":[{"id":"spn-10709","marks":["code"],"text":"local_small"}]}],"id":"blk-11679","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11681","kind":"paragraph","spans":[{"id":"spn-10710","text":"Often uses single-pass strategy for higher κ only; may skip low-κ cycles below a floor."}]},{"id":"blk-11682","items":[{"blocks":[{"id":"blk-11684","kind":"paragraph","spans":[{"id":"spn-10711","marks":["code"],"text":"local_large"}]}],"id":"blk-11683","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11685","kind":"paragraph","spans":[{"id":"spn-10712","text":"Typically supports multi-pass decomposition/reconciliation on κ > 0."}]},{"id":"blk-11686","items":[{"blocks":[{"id":"blk-11688","kind":"paragraph","spans":[{"id":"spn-10713","marks":["code"],"text":"cloud_frontier"}]}],"id":"blk-11687","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11689","kind":"paragraph","spans":[{"id":"spn-10714","text":"Supports deeper multi-pass budgets and larger partition scopes."}]},{"id":"blk-11690","kind":"paragraph","spans":[{"id":"spn-10715","text":"This keeps routing semantics stable while adapting execution depth to available inference capacity."}]},{"id":"blk-11691","kind":"heading","level":2,"spans":[{"id":"spn-10716","text":"8. Governance implications"}]},{"id":"blk-11692","kind":"paragraph","spans":[{"id":"spn-10717","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10718","text":" should honor governance boundaries in both routing and output handling:"}]},{"id":"blk-11693","items":[{"blocks":[{"id":"blk-11695","kind":"paragraph","spans":[{"id":"spn-10719","text":"respect escalation thresholds ("},{"id":"spn-10720","marks":["code"],"text":"confidence_below"},{"id":"spn-10721","text":", cost limits, boundary flags)"}]}],"id":"blk-11694","kind":"list-item"},{"blocks":[{"id":"blk-11697","kind":"paragraph","spans":[{"id":"spn-10722","text":"enforce hard constraints before downstream action dispatch"}]}],"id":"blk-11696","kind":"list-item"},{"blocks":[{"id":"blk-11699","kind":"paragraph","spans":[{"id":"spn-10723","text":"avoid auto-execution when autonomy level is limited to "},{"id":"spn-10724","marks":["code"],"text":"observe"},{"id":"spn-10725","text":" or "},{"id":"spn-10726","marks":["code"],"text":"advise"}]}],"id":"blk-11698","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11700","kind":"paragraph","spans":[{"id":"spn-10727","text":"A deliberation result should be treated as "},{"id":"spn-10728","marks":["bold"],"text":"decision support"},{"id":"spn-10729","text":", not unconditional permission to act."}]},{"id":"blk-11701","kind":"heading","level":2,"spans":[{"id":"spn-10730","text":"9. Provenance implications"}]},{"id":"blk-11702","kind":"paragraph","spans":[{"id":"spn-10731","text":"A deliberation step should preserve strong traceability, including:"}]},{"id":"blk-11703","items":[{"blocks":[{"id":"blk-11705","kind":"paragraph","spans":[{"id":"spn-10732","text":"topology basis (SCC IDs, κ values, fault-line edges)"}]}],"id":"blk-11704","kind":"list-item"},{"blocks":[{"id":"blk-11707","kind":"paragraph","spans":[{"id":"spn-10733","text":"operation name and provider"}]}],"id":"blk-11706","kind":"list-item"},{"blocks":[{"id":"blk-11709","kind":"paragraph","spans":[{"id":"spn-10734","text":"input and output hashes"}]}],"id":"blk-11708","kind":"list-item"},{"blocks":[{"id":"blk-11711","kind":"paragraph","spans":[{"id":"spn-10735","text":"parent trace linkage"}]}],"id":"blk-11710","kind":"list-item"},{"blocks":[{"id":"blk-11713","kind":"paragraph","spans":[{"id":"spn-10736","text":"timestamps and any transport trace IDs"}]}],"id":"blk-11712","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11714","kind":"paragraph","spans":[{"id":"spn-10737","text":"This is essential for replay, audit, and post-outcome learning loops."}]},{"id":"blk-11715","kind":"heading","level":2,"spans":[{"id":"spn-10738","text":"10. Compatible providers"}]},{"id":"blk-11716","kind":"paragraph","spans":[{"id":"spn-10739","text":"Current ecosystem-aligned provider:"}]},{"id":"blk-11717","items":[{"blocks":[{"id":"blk-11719","kind":"paragraph","spans":[{"id":"spn-10740","marks":["code"],"text":"graphonomous"}]}],"id":"blk-11718","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11720","kind":"paragraph","spans":[{"id":"spn-10741","text":"Protocol note: providers are implementations; "},{"id":"spn-10742","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10743","text":" remains the capability interface."}]},{"id":"blk-11721","kind":"heading","level":2,"spans":[{"id":"spn-10744","text":"11. Anti-patterns"}]},{"id":"blk-11722","items":[{"blocks":[{"id":"blk-11724","kind":"paragraph","spans":[{"id":"spn-10745","text":"Treating cyclic reasoning as plain one-shot ranking without topology context."}]}],"id":"blk-11723","kind":"list-item"},{"blocks":[{"id":"blk-11726","kind":"paragraph","spans":[{"id":"spn-10746","text":"Collapsing "},{"id":"spn-10747","marks":["code"],"text":"decompose"},{"id":"spn-10748","text":" and "},{"id":"spn-10749","marks":["code"],"text":"reconcile"},{"id":"spn-10750","text":" semantics into undocumented prompt hacks."}]}],"id":"blk-11725","kind":"list-item"},{"blocks":[{"id":"blk-11728","kind":"paragraph","spans":[{"id":"spn-10751","text":"Emitting deliberation outputs with no confidence or provenance linkage."}]}],"id":"blk-11727","kind":"list-item"},{"blocks":[{"id":"blk-11730","kind":"paragraph","spans":[{"id":"spn-10752","text":"Skipping governance checks and directly dispatching real-world actions."}]}],"id":"blk-11729","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11731","kind":"heading","level":2,"spans":[{"id":"spn-10753","text":"12. Summary"}]},{"id":"blk-11732","kind":"paragraph","spans":[{"id":"spn-10754","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10755","text":" formalizes a critical reasoning mode for cyclic, feedback-heavy domains."}]},{"id":"blk-11733","kind":"paragraph","spans":[{"id":"spn-10756","text":"It gives agent systems:"}]},{"id":"blk-11734","items":[{"blocks":[{"id":"blk-11736","kind":"paragraph","spans":[{"id":"spn-10757","text":"explicit topology-aware routing"}]}],"id":"blk-11735","kind":"list-item"},{"blocks":[{"id":"blk-11738","kind":"paragraph","spans":[{"id":"spn-10758","text":"scoped decomposition for hard reasoning regions"}]}],"id":"blk-11737","kind":"list-item"},{"blocks":[{"id":"blk-11740","kind":"paragraph","spans":[{"id":"spn-10759","text":"reconciled, confidence-bearing conclusions"}]}],"id":"blk-11739","kind":"list-item"},{"blocks":[{"id":"blk-11742","kind":"paragraph","spans":[{"id":"spn-10760","text":"clean composition with memory, governance, and provenance layers"}]}],"id":"blk-11741","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11743","kind":"paragraph","spans":[{"id":"spn-10761","text":"This makes deliberation a portable protocol capability rather than ad hoc prompt behavior."}]}],"edges":[],"id":"bagaaieradygw5vgufovygxs6nya2hp4wbsamuaf3qi2pccyhl34f7xqdf5da","vocabulary":"ampersand.docs.fs.v1"}