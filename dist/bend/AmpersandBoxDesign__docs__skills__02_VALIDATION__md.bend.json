:"Common Validation Errors"}]},{"head":[{"id":"blk-16406","spans":[{"id":"spn-14609","text":"Error"}]},{"id":"blk-16407","spans":[{"id":"spn-14610","text":"Cause"}]},{"id":"blk-16408","spans":[{"id":"spn-14611","text":"Fix"}]}],"id":"blk-16405","kind":"table","rows":[[{"id":"blk-16409","spans":[{"id":"spn-14612","marks":["code"],"text":"Required property 'agent' missing"}]},{"id":"blk-16410","spans":[{"id":"spn-14613","text":"No "},{"id":"spn-14614","marks":["code"],"text":"agent"},{"id":"spn-14615","text":" field"}]},{"id":"blk-16411","spans":[{"id":"spn-14616","text":"Add "},{"id":"spn-14617","marks":["code"],"text":"\"agent\": \"YourAgentName\""}]}],[{"id":"blk-16412","spans":[{"id":"spn-14618","marks":["code"],"text":"Invalid capability identifier"}]},{"id":"blk-16413","spans":[{"id":"spn-14619","text":"Key does not match "},{"id":"spn-14620","marks":["code"],"text":"&primitive.subtype"}]},{"id":"blk-16414","spans":[{"id":"spn-14621","text":"Use format "},{"id":"spn-14622","marks":["code"],"text":"&memory.graph"},{"id":"spn-14623","text":", not "},{"id":"spn-14624","marks":["code"],"text":"memory.graph"},{"id":"spn-14625","text":" or "},{"id":"spn-14626","marks":["code"],"text":"&memory"}]}],[{"id":"blk-16415","spans":[{"id":"spn-14627","marks":["code"],"text":"Empty capabilities object"}]},{"id":"blk-16416","spans":[{"id":"spn-14628","text":"No capabilities declared"}]},{"id":"blk-16417","spans":[{"id":"spn-14629","text":"Add at least one capability"}]}],[{"id":"blk-16418","spans":[{"id":"spn-14630","marks":["code"],"text":"Invalid version format"}]},{"id":"blk-16419","spans":[{"id":"spn-14631","text":"Non-semver string"}]},{"id":"blk-16420","spans":[{"id":"spn-14632","text":"Use "},{"id":"spn-14633","marks":["code"],"text":"\"1.0.0\""},{"id":"spn-14634","text":", not "},{"id":"spn-14635","marks":["code"],"text":"\"v1\""},{"id":"spn-14636","text":" or "},{"id":"spn-14637","marks":["code"],"text":"\"1.0\""}]}],[{"id":"blk-16421","spans":[{"id":"spn-14638","marks