{"bendscript":"0.1","blocks":[{"id":"blk-64346","kind":"heading","level":1,"spans":[{"id":"spn-123040","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-64348","kind":"paragraph","spans":[{"id":"spn-123041","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-64347","kind":"quote"},{"blocks":[{"id":"blk-64350","kind":"paragraph","spans":[{"id":"spn-123042","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-123043","text":" · "},{"id":"spn-123044","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-123045","text":" · "},{"id":"spn-123046","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-123047","text":" · "},{"id":"spn-123048","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-64349","kind":"quote"},{"id":"blk-64351","kind":"paragraph","spans":[{"id":"spn-123049","text":"Welcome to the documentation hub for "},{"id":"spn-123050","marks":["bold"],"text":"Deliberatic"},{"id":"spn-123051","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-64352","kind":"paragraph","spans":[{"id":"spn-123052","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-64353","kind":"heading","level":2,"spans":[{"id":"spn-123053","text":"Why Deliberatic?"}]},{"id":"blk-64354","kind":"paragraph","spans":[{"id":"spn-123054","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-64355","items":[{"blocks":[{"id":"blk-64357","kind":"paragraph","spans":[{"id":"spn-123055","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-123056","text":" — agents exchange opinions with no"}]}],"id":"blk-64356","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-64358","kind":"paragraph","spans":[{"id":"spn-123057","text":"structured way to compare, attack, or support positions"}]},{"id":"blk-64359","items":[{"blocks":[{"id":"blk-64361","kind":"paragraph","spans":[{"id":"spn-123058","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-123059","text":" — a compromised agent can corrupt the"}]}],"id":"blk-64360","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-64362","kind":"paragraph","spans":[{"id":"spn-123060","text":"entire cluster"}]},{"id":"blk-64363","items":[{"blocks":[{"id":"blk-64365","kind":"paragraph","spans":[{"id":"spn-123061","marks":["bold"],"text":"No audit trail"},{"id":"spn-123062","text":" — enterprise deployments require explainable, verifiable"}]}],"id":"blk-64364","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-64366","kind":"paragraph","spans":[{"id":"spn-123063","text":"decision chains"}]},{"id":"blk-64367","kind":"paragraph","spans":[{"id":"spn-123064","text":"Deliberatic addresses all three."}]},{"id":"blk-64368","kind":"heading","level":2,"spans":[{"id":"spn-123065","text":"Documentation Map"}]},{"id":"blk-64369","kind":"paragraph","spans":[{"id":"spn-123066","marks":["bold"],"text":"Homepages"}]},{"id":"blk-64370","items":[{"blocks":[{"id":"blk-64372","kind":"paragraph","spans":[{"id":"spn-123067","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-64371","kind":"list-item"},{"blocks":[{"id":"blk-64374","kind":"paragraph",