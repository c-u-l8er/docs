{"bendscript":"0.1","blocks":[{"id":"blk-37304","kind":"heading","level":1,"spans":[{"id":"spn-41099","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-37306","kind":"paragraph","spans":[{"id":"spn-41100","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-37305","kind":"quote"},{"blocks":[{"id":"blk-37308","kind":"paragraph","spans":[{"id":"spn-41101","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-41102","text":" · "},{"id":"spn-41103","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-41104","text":" · "},{"id":"spn-41105","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-41106","text":" · "},{"id":"spn-41107","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-37307","kind":"quote"},{"id":"blk-37309","kind":"paragraph","spans":[{"id":"spn-41108","text":"Welcome to the documentation hub for "},{"id":"spn-41109","marks":["bold"],"text":"Deliberatic"},{"id":"spn-41110","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-37310","kind":"paragraph","spans":[{"id":"spn-41111","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-37311","kind":"paragraph","spans":[{"id":"spn-41112","text":"---"}]},{"id":"blk-37312","kind":"heading","level":2,"spans":[{"id":"spn-41113","text":"Why Deliberatic?"}]},{"id":"blk-37313","kind":"paragraph","spans":[{"id":"spn-41114","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-37314","kind":"paragraph","spans":[{"id":"spn-41115","text":"1. "},{"id":"spn-41116","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-41117","text":" — agents exchange opinions with no structured way to compare, attack, or support positions 2. "},{"id":"spn-41118","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-41119","text":" — a compromised agent can corrupt the entire cluster 3. "},{"id":"spn-41120","marks":["bold"],"text":"No audit trail"},{"id":"spn-41121","text":" — enterprise deployments require explainable, verifiable decision chains"}]},{"id":"blk-37315","kind":"paragraph","spans":[{"id":"spn-41122","text":"Deliberatic addresses all three."}]},{"id":"blk-37316","kind":"paragraph","spans":[{"id":"spn-41123","text":"---"}]},{"id":"blk-37317","kind":"heading","level":2,"spans":[{"id":"spn-41124","text":"Documentation Map"}]},{"id":"blk-37318","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-37319","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-37320","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Deliberatic Docs\n\nspec/README"},{"id":"blk-37321","kind":"paragraph","spans":[{"id":"spn-41125","text":"---"}]},{"id":"blk-37322","kind":"heading","level":2,"spans":[{"id":"spn-41126","text":"Core Concepts"}]},{"id":"blk-37323","kind":"heading","level":3,"spans":[{"id":"spn-41127","text":"Deliberatic Argumentation Framework (DAF)"}]},{"id":"blk-37324","kind":"paragraph","spans":[{"id":"spn-41128","text":"A formal tuple "},{"id":"spn-41129","marks":["code"],"text":"DAF = <A, R-, R+, w, a, C, p>"},{"id":"spn-41130","text":" combining:"}]},{"id":"blk-37325","items":[{"blocks":[{"id":"blk-37327","kind":"paragraph","spans":[{"id":"spn-41131","marks":["bold"],"text":"Weighted bipolar argumentation"},{"id":"spn-41132","text":" (attacks + supports with evidence-derived weights)"}]}],"id":"blk-37326","kind":"list-item"},{"blocks":[{"id":"blk-37329","kind":"paragraph","spans":[{"id":"spn-41133","marks":["bold"],"text":"Agent authorship tracking"},{"id":"spn-41134","text":" (every argument traces to its submitting agent)"}]}],"id":"blk-37328","kind":"list-item"},{"blocks":[{"id":"blk-37331","kind":"paragraph","spans":[{"id":"spn-41135","marks":["bold"],"text":"Constitutional constraints"},{"id":"spn-41136","text":" (hard boundaries + soft preferences)"}]}],"id":"blk-37330","kind":"list-item"},{"blocks":[{"id":"blk-37333","kind":"paragraph","spans":[{"id":"spn-41137","marks":["bold"],"text":"Domain-aware reputation"},{"id":"spn-41138","text":" (ELO-derived, calibration-adjusted)"}]}],"id":"blk-37332","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37334","kind":"heading","level":3,"spans":[{"id":"spn-41139","text":"Two-Phase Adaptive Consensus"}]},{"id":"blk-37335","items":[{"blocks":[{"id":"blk-37337","kind":"paragraph","spans":[{"id":"spn-41140","marks":["bold"],"text":"Fast path (Raft-derived)"},{"id":"spn-41141","text":" — when positions have a clear winner (~50ms)"}]}],"id":"blk-37336","kind":"list-item"},{"blocks":[{"id":"blk-37339","kind":"paragraph","spans":[{"id":"spn-41142","marks":["bold"],"text":"Conflict path (PBFT-derived)"},{"id":"spn-41143","text":" — when positions are close, Byzantine-tolerant (~200ms)"}]}],"id":"blk-37338","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37340","kind":"heading","level":3,"spans":[{"id":"spn-41144","text":"Constitution DSL"}]},{"id":"blk-37341","kind":"paragraph","spans":[{"id":"spn-41145","text":"YAML-based normative constraints: hard boundaries (instant rejection on violation), soft preferences (score adjustments), and amendment rules (vindicated dissents trigger constitutional votes)."}]},{"id":"blk-37342","kind":"heading","level":3,"spans":[{"id":"spn-41146","text":"Merkle-Chained Evidence"}]},{"id":"blk-37343","kind":"paragraph","spans":[{"id":"spn-41147","text":"Every deliberation round produces an immutable evidence chain — SHA-256 hashed positions, challenges, votes, and verdicts with a verifiable Merkle root."}]},{"id":"blk-37344","kind":"paragraph","spans":[{"id":"spn-41148","text":"---"}]},{"id":"blk-37345","kind":"heading","level":2,"spans":[{"id":"spn-41149","text":"Transport Bindings"}]},{"head":[{"id":"blk-37347","spans":[{"id":"spn-41150","text":"Protocol"}]},{"id":"blk-37348","spans":[{"id":"spn-41151","text":"Support"}]}],"id":"blk-37346","kind":"table","rows":[[{"id":"blk-37349","spans":[{"id":"spn-41152","marks":["bold"],"text":"A2A"},{"id":"spn-41153","text":" (Google/Linux Foundation)"}]},{"id":"blk-37350","spans":[{"id":"spn-41154","text":"Native — agents advertise "},{"id":"spn-41155","marks":["code"],"text":"deliberation/v1"},{"id":"spn-41156","text":" skill"}]}],[{"id":"blk-37351","spans":[{"id":"spn-41157","marks":["bold"],"text":"MCP"},{"id":"spn-41158","text":" (Anthropic/AAIF)"}]},{"id":"blk-37352","spans":[{"id":"spn-41159","text":"MCP server with 7 tools"}]}],[{"id":"blk-37353","spans":[{"id":"spn-41160","marks":["bold"],"text":"HTTP"}]},{"id":"blk-37354","spans":[{"id":"spn-41161","text":"JSON-RPC 2.0 + SSE for streaming"}]}]]},{"id":"blk-37355","kind":"heading","level":3,"spans":[{"id":"spn-41162","text":"MCP Tools"}]},{"head":[{"id":"blk-37357","spans":[{"id":"spn-41163","text":"Tool"}]},{"id":"blk-37358","spans":[{"id":"spn-41164","text":"Description"}]}],"id":"blk-37356","kind":"table","rows":[[{"id":"blk-37359","spans":[{"id":"spn-41165","marks":["code"],"text":"deliberatic_open_round"}]},{"id":"blk-37360","spans":[{"id":"spn-41166","text":"Open a new deliberation round"}]}],[{"id":"blk-37361","spans":[{"id":"spn-41167","marks":["code"],"text":"deliberatic_submit_position"}]},{"id":"blk-37362","spans":[{"id":"spn-41168","text":"Submit a position with evidence"}]}],[{"id":"blk-37363","spans":[{"id":"spn-41169","marks":["code"],"text":"deliberatic_challenge"}]},{"id":"blk-37364","spans":[{"id":"spn-41170","text":"Challenge another agent's position"}]}],[{"id":"blk-37365","spans":[{"id":"spn-41171","marks":["code"],"text":"deliberatic_resolve"}]},{"id":"blk-37366","spans":[{"id":"spn-41172","text":"Trigger resolution and get verdict"}]}],[{"id":"blk-37367","spans":[{"id":"spn-41173","marks":["code"],"text":"deliberatic_query_evidence"}]},{"id":"blk-37368","spans":[{"id":"spn-41174","text":"Query evidence chains by round ID"}]}],[{"id":"blk-37369","spans":[{"id":"spn-41175","marks":["code"],"text":"deliberatic_get_reputation"}]},{"id":"blk-37370","spans":[{"id":"spn-41176","text":"Get agent reputation scores"}]}],[{"id":"blk-37371","spans":[{"id":"spn-41177","marks":["code"],"text":"deliberatic_amend_constitution"}]},{"id":"blk-37372","spans":[{"id":"spn-41178","text":"Propose constitutional amendment"}]}]]},{"id":"blk-37373","kind":"paragraph","spans":[{"id":"spn-41179","text":"---"}]},{"id":"blk-37374","kind":"heading","level":2,"spans":[{"id":"spn-41180","text":"Position in the [&] Ecosystem"}]},{"id":"blk-37375","kind":"paragraph","spans":[{"id":"spn-41181","text":"Deliberatic is the "},{"id":"spn-41182","marks":["bold"],"text":"decision layer"},{"id":"spn-41183","text":":"}]},{"head":[{"id":"blk-37377","spans":[{"id":"spn-41184","text":"Layer"}]},{"id":"blk-37378","spans":[{"id":"spn-41185","text":"Product"}]},{"id":"blk-37379","spans":[{"id":"spn-41186","text":"Role"}]}],"id":"blk-37376","kind":"table","rows":[[{"id":"blk-37380","spans":[{"id":"spn-41187","text":"Distribution"}]},{"id":"blk-37381","spans":[{"id":"spn-41188","text":"FleetPrompt"}]},{"id":"blk-37382","spans":[{"id":"spn-41189","text":"Agent runtime, skill execution"}]}],[{"id":"blk-37383","spans":[{"id":"spn-41190","text":"Standards"}]},{"id":"blk-37384","spans":[{"id":"spn-41191","text":"SpecPrompt"}]},{"id":"blk-37385","spans":[{"id":"spn-41192","text":"Execution specs, schema validation"}]}],[{"id":"blk-37386","spans":[{"id":"spn-41193","text":"Orchestration"}]},{"id":"blk-37387","spans":[{"id":"spn-41194","text":"Delegatic"}]},{"id":"blk-37388","spans":[{"id":"spn-41195","text":"Task routing, workflow graphs"}]}],[{"id":"blk-37389","spans":[{"id":"spn-41196","marks":["bold"],"text":"Decisions"}]},{"id":"blk-37390","spans":[{"id":"spn-41197","marks":["bold"],"text":"Deliberatic"}]},{"id":"blk-37391","spans":[{"id":"spn-41198","marks":["bold"],"text":"Argumentation, consensus, audit"}]}],[{"id":"blk-37392","spans":[{"id":"spn-41199","text":"Execution"}]},{"id":"blk-37393","spans":[{"id":"spn-41200","text":"AgenTroMatic"}]},{"id":"blk-37394","spans":[{"id":"spn-41201","text":"Autonomous task execution"}]}],[{"id":"blk-37395","spans":[{"id":"spn-41202","text":"Infrastructure"}]},{"id":"blk-37396","spans":[{"id":"spn-41203","text":"WebHost.Systems"}]},{"id":"blk-37397","spans":[{"id":"spn-41204","text":"Hosting, deployment"}]}],[{"id":"blk-37398","spans":[{"id":"spn-41205","text":"Spatial"}]},{"id":"blk-37399","spans":[{"id":"spn-41206","text":"GeoFleetic"}]},{"id":"blk-37400","spans":[{"id":"spn-41207","text":"Location-aware routing"}]}],[{"id":"blk-37401","spans":[{"id":"spn-41208","text":"Temporal"}]},{"id":"blk-37402","spans":[{"id":"spn-41209","text":"TickTickClock"}]},{"id":"blk-37403","spans":[{"id":"spn-41210","text":"Scheduling, deadlines"}]}]]},{"id":"blk-37404","kind":"paragraph","spans":[{"id":"spn-41211","text":"---"}]},{"id":"blk-37405","kind":"heading","level":2,"spans":[{"id":"spn-41212","text":"Project Links"}]},{"id":"blk-37406","items":[{"blocks":[{"id":"blk-37408","kind":"paragraph","spans":[{"id":"spn-41213","marks":["bold"],"text":"Spec:"},{"id":"spn-41214","text":" "},{"id":"spn-41215","marks":[{"kind":"link","predicate":"cites","target":"#/deliberatic.com/docs/spec/README.md"}],"text":"Protocol Specification"}]}],"id":"blk-37407","kind":"list-item"},{"blocks":[{"id":"blk-37410","kind":"paragraph","spans":[{"id":"spn-41216","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-41217","text":" "},{"id":"spn-41218","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-37409","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37411","kind":"paragraph","spans":[{"id":"spn-41219","text":"---"}]},{"id":"blk-37412","kind":"paragraph","spans":[{"id":"spn-41220","text":"*[&] Ampersand Box Design — deliberatic.com*"}]}],"edges":[],"id":"bagaaierari2iclptqqmcd7emqie7w35n7okbhyudeqfxndrhcadwdmfcvbiq","vocabulary":"ampersand.docs.fs.v1"}