{"bendscript":"0.1","blocks":[{"id":"blk-59323","kind":"heading","level":1,"spans":[{"id":"spn-88653","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-59325","kind":"paragraph","spans":[{"id":"spn-88654","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-59324","kind":"quote"},{"blocks":[{"id":"blk-59327","kind":"paragraph","spans":[{"id":"spn-88655","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-88656","text":" · "},{"id":"spn-88657","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-88658","text":" · "},{"id":"spn-88659","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-88660","text":" · "},{"id":"spn-88661","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-59326","kind":"quote"},{"id":"blk-59328","kind":"paragraph","spans":[{"id":"spn-88662","text":"Welcome to the documentation hub for "},{"id":"spn-88663","marks":["bold"],"text":"Deliberatic"},{"id":"spn-88664","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-59329","kind":"paragraph","spans":[{"id":"spn-88665","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-59330","kind":"heading","level":2,"spans":[{"id":"spn-88666","text":"Why Deliberatic?"}]},{"id":"blk-59331","kind":"paragraph","spans":[{"id":"spn-88667","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-59332","items":[{"blocks":[{"id":"blk-59334","kind":"paragraph","spans":[{"id":"spn-88668","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-88669","text":" — agents exchange opinions with no"}]}],"id":"blk-59333","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-59335","kind":"paragraph","spans":[{"id":"spn-88670","text":"structured way to compare, attack, or support positions"}]},{"id":"blk-59336","items":[{"blocks":[{"id":"blk-59338","kind":"paragraph","spans":[{"id":"spn-88671","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-88672","text":" — a compromised agent can corrupt the"}]}],"id":"blk-59337","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-59339","kind":"paragraph","spans":[{"id":"spn-88673","text":"entire cluster"}]},{"id":"blk-59340","items":[{"blocks":[{"id":"blk-59342","kind":"paragraph","spans":[{"id":"spn-88674","marks":["bold"],"text":"No audit trail"},{"id":"spn-88675","text":" — enterprise deployments require explainable, verifiable"}]}],"id":"blk-59341","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-59343","kind":"paragraph","spans":[{"id":"spn-88676","text":"decision chains"}]},{"id":"blk-59344","kind":"paragraph","spans":[{"id":"spn-88677","text":"Deliberatic addresses all three."}]},{"id":"blk-59345","kind":"heading","level":2,"spans":[{"id":"spn-88678","text":"Documentation Map"}]},{"id":"blk-59346","kind":"paragraph","spans":[{"id":"spn-88679","marks":["bold"],"text":"Homepages"}]},{"id":"blk-59347","items":[{"blocks":[{"id":"blk-59349","kind":"paragraph","spans":[{"id":"spn-88680","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-59348","kind":"list-item"},{"blocks":[{"id":"blk-59351","kind":"paragraph","spans":[{"id":"spn-88681","