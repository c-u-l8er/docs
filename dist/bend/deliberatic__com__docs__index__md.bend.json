{"bendscript":"0.1","blocks":[{"id":"blk-59334","kind":"heading","level":1,"spans":[{"id":"spn-88706","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-59336","kind":"paragraph","spans":[{"id":"spn-88707","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-59335","kind":"quote"},{"blocks":[{"id":"blk-59338","kind":"paragraph","spans":[{"id":"spn-88708","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-88709","text":" · "},{"id":"spn-88710","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-88711","text":" · "},{"id":"spn-88712","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-88713","text":" · "},{"id":"spn-88714","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-59337","kind":"quote"},{"id":"blk-59339","kind":"paragraph","spans":[{"id":"spn-88715","text":"Welcome to the documentation hub for "},{"id":"spn-88716","marks":["bold"],"text":"Deliberatic"},{"id":"spn-88717","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-59340","kind":"paragraph","spans":[{"id":"spn-88718","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-59341","kind":"heading","level":2,"spans":[{"id":"spn-88719","text":"Why Deliberatic?"}]},{"id":"blk-59342","kind":"paragraph","spans":[{"id":"spn-88720","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-59343","items":[{"blocks":[{"id":"blk-59345","kind":"paragraph","spans":[{"id":"spn-88721","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-88722","text":" — agents exchange opinions with no"}]}],"id":"blk-59344","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-59346","kind":"paragraph","spans":[{"id":"spn-88723","text":"structured way to compare, attack, or support positions"}]},{"id":"blk-59347","items":[{"blocks":[{"id":"blk-59349","kind":"paragraph","spans":[{"id":"spn-88724","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-88725","text":" — a compromised agent can corrupt the"}]}],"id":"blk-59348","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-59350","kind":"paragraph","spans":[{"id":"spn-88726","text":"entire cluster"}]},{"id":"blk-59351","items":[{"blocks":[{"id":"blk-59353","kind":"paragraph","spans":[{"id":"spn-88727","marks":["bold"],"text":"No audit trail"},{"id":"spn-88728","text":" — enterprise deployments require explainable, verifiable"}]}],"id":"blk-59352","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-59354","kind":"paragraph","spans":[{"id":"spn-88729","text":"decision chains"}]},{"id":"blk-59355","kind":"paragraph","spans":[{"id":"spn-88730","text":"Deliberatic addresses all three."}]},{"id":"blk-59356","kind":"heading","level":2,"spans":[{"id":"spn-88731","text":"Documentation Map"}]},{"id":"blk-59357","kind":"paragraph","spans":[{"id":"spn-88732","marks":["bold"],"text":"Homepages"}]},{"id":"blk-59358","items":[{"blocks":[{"id":"blk-59360","kind":"paragraph","spans":[{"id":"spn-88733","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-59359","kind":"list-item"},{"blocks":[{"id":"blk-59362","kind":"paragraph","spans":[{"id":"spn-88734","