{"bendscript":"0.1","blocks":[{"id":"blk-59460","kind":"heading","level":1,"spans":[{"id":"spn-88854","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-59462","kind":"paragraph","spans":[{"id":"spn-88855","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-59461","kind":"quote"},{"blocks":[{"id":"blk-59464","kind":"paragraph","spans":[{"id":"spn-88856","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-88857","text":" · "},{"id":"spn-88858","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-88859","text":" · "},{"id":"spn-88860","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-88861","text":" · "},{"id":"spn-88862","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-59463","kind":"quote"},{"id":"blk-59465","kind":"paragraph","spans":[{"id":"spn-88863","text":"Welcome to the documentation hub for "},{"id":"spn-88864","marks":["bold"],"text":"Deliberatic"},{"id":"spn-88865","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-59466","kind":"paragraph","spans":[{"id":"spn-88866","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-59467","kind":"heading","level":2,"spans":[{"id":"spn-88867","text":"Why Deliberatic?"}]},{"id":"blk-59468","kind":"paragraph","spans":[{"id":"spn-88868","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-59469","items":[{"blocks":[{"id":"blk-59471","kind":"paragraph","spans":[{"id":"spn-88869","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-88870","text":" — agents exchange opinions with no"}]}],"id":"blk-59470","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-59472","kind":"paragraph","spans":[{"id":"spn-88871","text":"structured way to compare, attack, or support positions"}]},{"id":"blk-59473","items":[{"blocks":[{"id":"blk-59475","kind":"paragraph","spans":[{"id":"spn-88872","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-88873","text":" — a compromised agent can corrupt the"}]}],"id":"blk-59474","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-59476","kind":"paragraph","spans":[{"id":"spn-88874","text":"entire cluster"}]},{"id":"blk-59477","items":[{"blocks":[{"id":"blk-59479","kind":"paragraph","spans":[{"id":"spn-88875","marks":["bold"],"text":"No audit trail"},{"id":"spn-88876","text":" — enterprise deployments require explainable, verifiable"}]}],"id":"blk-59478","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-59480","kind":"paragraph","spans":[{"id":"spn-88877","text":"decision chains"}]},{"id":"blk-59481","kind":"paragraph","spans":[{"id":"spn-88878","text":"Deliberatic addresses all three."}]},{"id":"blk-59482","kind":"heading","level":2,"spans":[{"id":"spn-88879","text":"Documentation Map"}]},{"id":"blk-59483","kind":"paragraph","spans":[{"id":"spn-88880","marks":["bold"],"text":"Homepages"}]},{"id":"blk-59484","items":[{"blocks":[{"id":"blk-59486","kind":"paragraph","spans":[{"id":"spn-88881","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-59485","kind":"list-item"},{"blocks":[{"id":"blk-59488","kind":"paragraph","spans":[{"id":"spn-88882","