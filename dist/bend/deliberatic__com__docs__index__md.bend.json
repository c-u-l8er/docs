{"bendscript":"0.1","blocks":[{"id":"blk-37790","kind":"heading","level":1,"spans":[{"id":"spn-42273","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-37792","kind":"paragraph","spans":[{"id":"spn-42274","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-37791","kind":"quote"},{"blocks":[{"id":"blk-37794","kind":"paragraph","spans":[{"id":"spn-42275","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-42276","text":" · "},{"id":"spn-42277","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-42278","text":" · "},{"id":"spn-42279","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-42280","text":" · "},{"id":"spn-42281","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-37793","kind":"quote"},{"id":"blk-37795","kind":"paragraph","spans":[{"id":"spn-42282","text":"Welcome to the documentation hub for "},{"id":"spn-42283","marks":["bold"],"text":"Deliberatic"},{"id":"spn-42284","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-37796","kind":"paragraph","spans":[{"id":"spn-42285","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-37797","kind":"paragraph","spans":[{"id":"spn-42286","text":"---"}]},{"id":"blk-37798","kind":"heading","level":2,"spans":[{"id":"spn-42287","text":"Why Deliberatic?"}]},{"id":"blk-37799","kind":"paragraph","spans":[{"id":"spn-42288","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-37800","kind":"paragraph","spans":[{"id":"spn-42289","text":"1. "},{"id":"spn-42290","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-42291","text":" — agents exchange opinions with no structured way to compare, attack, or support positions 2. "},{"id":"spn-42292","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-42293","text":" — a compromised agent can corrupt the entire cluster 3. "},{"id":"spn-42294","marks":["bold"],"text":"No audit trail"},{"id":"spn-42295","text":" — enterprise deployments require explainable, verifiable decision chains"}]},{"id":"blk-37801","kind":"paragraph","spans":[{"id":"spn-42296","text":"Deliberatic addresses all three."}]},{"id":"blk-37802","kind":"paragraph","spans":[{"id":"spn-42297","text":"---"}]},{"id":"blk-37803","kind":"heading","level":2,"spans":[{"id":"spn-42298","text":"Documentation Map"}]},{"id":"blk-37804","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-37805","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-37806","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Deliberatic Docs\n\nspec/README"},{"id":"blk-37807","kind":"paragraph","spans":[{"id":"spn-42299","text":"---"}]},{"id":"blk-37808","kind":"heading","level":2,"spans":[{"id":"spn-42300","text":"Core Concepts"}]},{"id":"blk-37809","kind":"heading","level":3,"spans":[{"id":"spn-42301","text":"Deliberatic Argumentation Framework (DAF)"}]},{"id":"blk-37810","kind":"paragraph","spans":[{"id":"spn-42302","text":"A formal tuple "},{"id":"spn-42303","marks":["code"],"text":"DAF = <A, R-, R+, w, a, C, p>"},{"id":"spn-42304","text":" combining:"}]},{"id":"blk-37811","items":[{"blocks":[{"id":"blk-37813","kind":"paragraph","spans":[{"id":"spn-42305","marks":["bold"],"text":"Weighted bipolar argumentation"},{"id":"spn-42306","text":" (attacks + supports with evidence-derived weights)"}]}],"id":"blk-37812","kind":"list-item"},{"blocks":[{"id":"blk-37815","kind":"paragraph","spans":[{"id":"spn-42307","marks":["bold"],"text":"Agent authorship tracking"},{"id":"spn-42308","text":" (every argument traces to its submitting agent)"}]}],"id":"blk-37814","kind":"list-item"},{"blocks":[{"id":"blk-37817","kind":"paragraph","spans":[{"id":"spn-42309","marks":["bold"],"text":"Constitutional constraints"},{"id":"spn-42310","text":" (hard boundaries + soft preferences)"}]}],"id":"blk-37816","kind":"list-item"},{"blocks":[{"id":"blk-37819","kind":"paragraph","spans":[{"id":"spn-42311","marks":["bold"],"text":"Domain-aware reputation"},{"id":"spn-42312","text":" (ELO-derived, calibration-adjusted)"}]}],"id":"blk-37818","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37820","kind":"heading","level":3,"spans":[{"id":"spn-42313","text":"Two-Phase Adaptive Consensus"}]},{"id":"blk-37821","items":[{"blocks":[{"id":"blk-37823","kind":"paragraph","spans":[{"id":"spn-42314","marks":["bold"],"text":"Fast path (Raft-derived)"},{"id":"spn-42315","text":" — when positions have a clear winner (~50ms)"}]}],"id":"blk-37822","kind":"list-item"},{"blocks":[{"id":"blk-37825","kind":"paragraph","spans":[{"id":"spn-42316","marks":["bold"],"text":"Conflict path (PBFT-derived)"},{"id":"spn-42317","text":" — when positions are close, Byzantine-tolerant (~200ms)"}]}],"id":"blk-37824","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37826","kind":"heading","level":3,"spans":[{"id":"spn-42318","text":"Constitution DSL"}]},{"id":"blk-37827","kind":"paragraph","spans":[{"id":"spn-42319","text":"YAML-based normative constraints: hard boundaries (instant rejection on violation), soft preferences (score adjustments), and amendment rules (vindicated dissents trigger constitutional votes)."}]},{"id":"blk-37828","kind":"heading","level":3,"spans":[{"id":"spn-42320","text":"Merkle-Chained Evidence"}]},{"id":"blk-37829","kind":"paragraph","spans":[{"id":"spn-42321","text":"Every deliberation round produces an immutable evidence chain — SHA-256 hashed positions, challenges, votes, and verdicts with a verifiable Merkle root."}]},{"id":"blk-37830","kind":"paragraph","spans":[{"id":"spn-42322","text":"---"}]},{"id":"blk-37831","kind":"heading","level":2,"spans":[{"id":"spn-42323","text":"Transport Bindings"}]},{"head":[{"id":"blk-37833","spans":[{"id":"spn-42324","text":"Protocol"}]},{"id":"blk-37834","spans":[{"id":"spn-42325","text":"Support"}]}],"id":"blk-37832","kind":"table","rows":[[{"id":"blk-37835","spans":[{"id":"spn-42326","marks":["bold"],"text":"A2A"},{"id":"spn-42327","text":" (Google/Linux Foundation)"}]},{"id":"blk-37836","spans":[{"id":"spn-42328","text":"Native — agents advertise "},{"id":"spn-42329","marks":["code"],"text":"deliberation/v1"},{"id":"spn-42330","text":" skill"}]}],[{"id":"blk-37837","spans":[{"id":"spn-42331","marks":["bold"],"text":"MCP"},{"id":"spn-42332","text":" (Anthropic/AAIF)"}]},{"id":"blk-37838","spans":[{"id":"spn-42333","text":"MCP server with 7 tools"}]}],[{"id":"blk-37839","spans":[{"id":"spn-42334","marks":["bold"],"text":"HTTP"}]},{"id":"blk-37840","spans":[{"id":"spn-42335","text":"JSON-RPC 2.0 + SSE for streaming"}]}]]},{"id":"blk-37841","kind":"heading","level":3,"spans":[{"id":"spn-42336","text":"MCP Tools"}]},{"head":[{"id":"blk-37843","spans":[{"id":"spn-42337","text":"Tool"}]},{"id":"blk-37844","spans":[{"id":"spn-42338","text":"Description"}]}],"id":"blk-37842","kind":"table","rows":[[{"id":"blk-37845","spans":[{"id":"spn-42339","marks":["code"],"text":"deliberatic_open_round"}]},{"id":"blk-37846","spans":[{"id":"spn-42340","text":"Open a new deliberation round"}]}],[{"id":"blk-37847","spans":[{"id":"spn-42341","marks":["code"],"text":"deliberatic_submit_position"}]},{"id":"blk-37848","spans":[{"id":"spn-42342","text":"Submit a position with evidence"}]}],[{"id":"blk-37849","spans":[{"id":"spn-42343","marks":["code"],"text":"deliberatic_challenge"}]},{"id":"blk-37850","spans":[{"id":"spn-42344","text":"Challenge another agent's position"}]}],[{"id":"blk-37851","spans":[{"id":"spn-42345","marks":["code"],"text":"deliberatic_resolve"}]},{"id":"blk-37852","spans":[{"id":"spn-42346","text":"Trigger resolution and get verdict"}]}],[{"id":"blk-37853","spans":[{"id":"spn-42347","marks":["code"],"text":"deliberatic_query_evidence"}]},{"id":"blk-37854","spans":[{"id":"spn-42348","text":"Query evidence chains by round ID"}]}],[{"id":"blk-37855","spans":[{"id":"spn-42349","marks":["code"],"text":"deliberatic_get_reputation"}]},{"id":"blk-37856","spans":[{"id":"spn-42350","text":"Get agent reputation scores"}]}],[{"id":"blk-37857","spans":[{"id":"spn-42351","marks":["code"],"text":"deliberatic_amend_constitution"}]},{"id":"blk-37858","spans":[{"id":"spn-42352","text":"Propose constitutional amendment"}]}]]},{"id":"blk-37859","kind":"paragraph","spans":[{"id":"spn-42353","text":"---"}]},{"id":"blk-37860","kind":"heading","level":2,"spans":[{"id":"spn-42354","text":"Position in the [&] Ecosystem"}]},{"id":"blk-37861","kind":"paragraph","spans":[{"id":"spn-42355","text":"Deliberatic is the "},{"id":"spn-42356","marks":["bold"],"text":"decision layer"},{"id":"spn-42357","text":":"}]},{"head":[{"id":"blk-37863","spans":[{"id":"spn-42358","text":"Layer"}]},{"id":"blk-37864","spans":[{"id":"spn-42359","text":"Product"}]},{"id":"blk-37865","spans":[{"id":"spn-42360","text":"Role"}]}],"id":"blk-37862","kind":"table","rows":[[{"id":"blk-37866","spans":[{"id":"spn-42361","text":"Distribution"}]},{"id":"blk-37867","spans":[{"id":"spn-42362","text":"FleetPrompt"}]},{"id":"blk-37868","spans":[{"id":"spn-42363","text":"Agent runtime, skill execution"}]}],[{"id":"blk-37869","spans":[{"id":"spn-42364","text":"Standards"}]},{"id":"blk-37870","spans":[{"id":"spn-42365","text":"SpecPrompt"}]},{"id":"blk-37871","spans":[{"id":"spn-42366","text":"Execution specs, schema validation"}]}],[{"id":"blk-37872","spans":[{"id":"spn-42367","text":"Orchestration"}]},{"id":"blk-37873","spans":[{"id":"spn-42368","text":"Delegatic"}]},{"id":"blk-37874","spans":[{"id":"spn-42369","text":"Task routing, workflow graphs"}]}],[{"id":"blk-37875","spans":[{"id":"spn-42370","marks":["bold"],"text":"Decisions"}]},{"id":"blk-37876","spans":[{"id":"spn-42371","marks":["bold"],"text":"Deliberatic"}]},{"id":"blk-37877","spans":[{"id":"spn-42372","marks":["bold"],"text":"Argumentation, consensus, audit"}]}],[{"id":"blk-37878","spans":[{"id":"spn-42373","text":"Execution"}]},{"id":"blk-37879","spans":[{"id":"spn-42374","text":"AgenTroMatic"}]},{"id":"blk-37880","spans":[{"id":"spn-42375","text":"Autonomous task execution"}]}],[{"id":"blk-37881","spans":[{"id":"spn-42376","text":"Infrastructure"}]},{"id":"blk-37882","spans":[{"id":"spn-42377","text":"WebHost.Systems"}]},{"id":"blk-37883","spans":[{"id":"spn-42378","text":"Hosting, deployment"}]}],[{"id":"blk-37884","spans":[{"id":"spn-42379","text":"Spatial"}]},{"id":"blk-37885","spans":[{"id":"spn-42380","text":"GeoFleetic"}]},{"id":"blk-37886","spans":[{"id":"spn-42381","text":"Location-aware routing"}]}],[{"id":"blk-37887","spans":[{"id":"spn-42382","text":"Temporal"}]},{"id":"blk-37888","spans":[{"id":"spn-42383","text":"TickTickClock"}]},{"id":"blk-37889","spans":[{"id":"spn-42384","text":"Scheduling, deadlines"}]}]]},{"id":"blk-37890","kind":"paragraph","spans":[{"id":"spn-42385","text":"---"}]},{"id":"blk-37891","kind":"heading","level":2,"spans":[{"id":"spn-42386","text":"Project Links"}]},{"id":"blk-37892","items":[{"blocks":[{"id":"blk-37894","kind":"paragraph","spans":[{"id":"spn-42387","marks":["bold"],"text":"Spec:"},{"id":"spn-42388","text":" "},{"id":"spn-42389","marks":[{"kind":"link","predicate":"cites","target":"#/deliberatic.com/docs/spec/README.md"}],"text":"Protocol Specification"}]}],"id":"blk-37893","kind":"list-item"},{"blocks":[{"id":"blk-37896","kind":"paragraph","spans":[{"id":"spn-42390","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-42391","text":" "},{"id":"spn-42392","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-37895","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37897","kind":"paragraph","spans":[{"id":"spn-42393","text":"---"}]},{"id":"blk-37898","kind":"paragraph","spans":[{"id":"spn-42394","text":"*[&] Ampersand Box Design — deliberatic.com*"}]}],"edges":[],"id":"bagaaieray4enqggot6242ezifev4hcfutt5gylvdtkkmuj5sbqbiprwlytdq","vocabulary":"ampersand.docs.fs.v1"}