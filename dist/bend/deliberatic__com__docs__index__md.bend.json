{"bendscript":"0.1","blocks":[{"id":"blk-60230","kind":"heading","level":1,"spans":[{"id":"spn-91316","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-60232","kind":"paragraph","spans":[{"id":"spn-91317","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-60231","kind":"quote"},{"blocks":[{"id":"blk-60234","kind":"paragraph","spans":[{"id":"spn-91318","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-91319","text":" · "},{"id":"spn-91320","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-91321","text":" · "},{"id":"spn-91322","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-91323","text":" · "},{"id":"spn-91324","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-60233","kind":"quote"},{"id":"blk-60235","kind":"paragraph","spans":[{"id":"spn-91325","text":"Welcome to the documentation hub for "},{"id":"spn-91326","marks":["bold"],"text":"Deliberatic"},{"id":"spn-91327","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-60236","kind":"paragraph","spans":[{"id":"spn-91328","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-60237","kind":"heading","level":2,"spans":[{"id":"spn-91329","text":"Why Deliberatic?"}]},{"id":"blk-60238","kind":"paragraph","spans":[{"id":"spn-91330","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-60239","items":[{"blocks":[{"id":"blk-60241","kind":"paragraph","spans":[{"id":"spn-91331","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-91332","text":" — agents exchange opinions with no"}]}],"id":"blk-60240","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-60242","kind":"paragraph","spans":[{"id":"spn-91333","text":"structured way to compare, attack, or support positions"}]},{"id":"blk-60243","items":[{"blocks":[{"id":"blk-60245","kind":"paragraph","spans":[{"id":"spn-91334","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-91335","text":" — a compromised agent can corrupt the"}]}],"id":"blk-60244","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-60246","kind":"paragraph","spans":[{"id":"spn-91336","text":"entire cluster"}]},{"id":"blk-60247","items":[{"blocks":[{"id":"blk-60249","kind":"paragraph","spans":[{"id":"spn-91337","marks":["bold"],"text":"No audit trail"},{"id":"spn-91338","text":" — enterprise deployments require explainable, verifiable"}]}],"id":"blk-60248","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-60250","kind":"paragraph","spans":[{"id":"spn-91339","text":"decision chains"}]},{"id":"blk-60251","kind":"paragraph","spans":[{"id":"spn-91340","text":"Deliberatic addresses all three."}]},{"id":"blk-60252","kind":"heading","level":2,"spans":[{"id":"spn-91341","text":"Documentation Map"}]},{"id":"blk-60253","kind":"paragraph","spans":[{"id":"spn-91342","marks":["bold"],"text":"Homepages"}]},{"id":"blk-60254","items":[{"blocks":[{"id":"blk-60256","kind":"paragraph","spans":[{"id":"spn-91343","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-60255","kind":"list-item"},{"blocks":[{"id":"blk-60258","kind":"paragraph","spans":[{"id":"spn-91344","