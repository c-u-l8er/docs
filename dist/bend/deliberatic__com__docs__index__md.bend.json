{"bendscript":"0.1","blocks":[{"id":"blk-38276","kind":"heading","level":1,"spans":[{"id":"spn-43389","text":"Deliberatic Documentation"}]},{"blocks":[{"id":"blk-38278","kind":"paragraph","spans":[{"id":"spn-43390","marks":["bold"],"text":"Structured argumentation. Fault-tolerant consensus. Cryptographic auditability."}]}],"id":"blk-38277","kind":"quote"},{"blocks":[{"id":"blk-38280","kind":"paragraph","spans":[{"id":"spn-43391","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-43392","text":" · "},{"id":"spn-43393","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-43394","text":" · "},{"id":"spn-43395","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-43396","text":" · "},{"id":"spn-43397","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-38279","kind":"quote"},{"id":"blk-38281","kind":"paragraph","spans":[{"id":"spn-43398","text":"Welcome to the documentation hub for "},{"id":"spn-43399","marks":["bold"],"text":"Deliberatic"},{"id":"spn-43400","text":" — an open-source deliberation protocol for multi-agent AI systems. Deliberatic provides structured argumentation, Byzantine fault-tolerant consensus, and Merkle-chained evidence logs for agent decision-making."}]},{"id":"blk-38282","kind":"paragraph","spans":[{"id":"spn-43401","text":"The protocol extends Dung's Abstract Argumentation Framework (1995) into a weighted bipolar system with agent authorship, integrates a two-phase consensus mechanism (Raft fast-path / PBFT conflict-path), and produces cryptographic evidence chains for regulatory compliance."}]},{"id":"blk-38283","kind":"paragraph","spans":[{"id":"spn-43402","text":"---"}]},{"id":"blk-38284","kind":"heading","level":2,"spans":[{"id":"spn-43403","text":"Why Deliberatic?"}]},{"id":"blk-38285","kind":"paragraph","spans":[{"id":"spn-43404","text":"Multi-Agent Debate (MAD) research has demonstrated that LLM agents improve decision quality through structured disagreement. But current MAD frameworks suffer three critical gaps:"}]},{"id":"blk-38286","kind":"paragraph","spans":[{"id":"spn-43405","text":"1. "},{"id":"spn-43406","marks":["bold"],"text":"No formal argumentation semantics"},{"id":"spn-43407","text":" — agents exchange opinions with no structured way to compare, attack, or support positions 2. "},{"id":"spn-43408","marks":["bold"],"text":"No Byzantine fault tolerance"},{"id":"spn-43409","text":" — a compromised agent can corrupt the entire cluster 3. "},{"id":"spn-43410","marks":["bold"],"text":"No audit trail"},{"id":"spn-43411","text":" — enterprise deployments require explainable, verifiable decision chains"}]},{"id":"blk-38287","kind":"paragraph","spans":[{"id":"spn-43412","text":"Deliberatic addresses all three."}]},{"id":"blk-38288","kind":"paragraph","spans":[{"id":"spn-43413","text":"---"}]},{"id":"blk-38289","kind":"heading","level":2,"spans":[{"id":"spn-43414","text":"Documentation Map"}]},{"id":"blk-38290","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-38291","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-38292","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Deliberatic Docs\n\nspec/README"},{"id":"blk-38293","kind":"paragraph","spans":[{"id":"spn-43415","text":"---"}]},{"id":"blk-38294","kind":"heading","level":2,"spans":[{"id":"spn-43416","text":"Core Concepts"}]},{"id":"blk-38295","kind":"heading","level":3,"spans":[{"id":"spn-43417","text":"Deliberatic Argumentation Framework (DAF)"}]},{"id":"blk-38296","kind":"paragraph","spans":[{"id":"spn-43418","text":"A formal tuple "},{"id":"spn-43419","marks":["code"],"text":"DAF = <A, R-, R+, w, a, C, p>"},{"id":"spn-43420","text":" combining:"}]},{"id":"blk-38297","items":[{"blocks":[{"id":"blk-38299","kind":"paragraph","spans":[{"id":"spn-43421","marks":["bold"],"text":"Weighted bipolar argumentation"},{"id":"spn-43422","text":" (attacks + supports with evidence-derived weights)"}]}],"id":"blk-38298","kind":"list-item"},{"blocks":[{"id":"blk-38301","kind":"paragraph","spans":[{"id":"spn-43423","marks":["bold"],"text":"Agent authorship tracking"},{"id":"spn-43424","text":" (every argument traces to its submitting agent)"}]}],"id":"blk-38300","kind":"list-item"},{"blocks":[{"id":"blk-38303","kind":"paragraph","spans":[{"id":"spn-43425","marks":["bold"],"text":"Constitutional constraints"},{"id":"spn-43426","text":" (hard boundaries + soft preferences)"}]}],"id":"blk-38302","kind":"list-item"},{"blocks":[{"id":"blk-38305","kind":"paragraph","spans":[{"id":"spn-43427","marks":["bold"],"text":"Domain-aware reputation"},{"id":"spn-43428","text":" (ELO-derived, calibration-adjusted)"}]}],"id":"blk-38304","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-38306","kind":"heading","level":3,"spans":[{"id":"spn-43429","text":"Two-Phase Adaptive Consensus"}]},{"id":"blk-38307","items":[{"blocks":[{"id":"blk-38309","kind":"paragraph","spans":[{"id":"spn-43430","marks":["bold"],"text":"Fast path (Raft-derived)"},{"id":"spn-43431","text":" — when positions have a clear winner (~50ms)"}]}],"id":"blk-38308","kind":"list-item"},{"blocks":[{"id":"blk-38311","kind":"paragraph","spans":[{"id":"spn-43432","marks":["bold"],"text":"Conflict path (PBFT-derived)"},{"id":"spn-43433","text":" — when positions are close, Byzantine-tolerant (~200ms)"}]}],"id":"blk-38310","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-38312","kind":"heading","level":3,"spans":[{"id":"spn-43434","text":"Constitution DSL"}]},{"id":"blk-38313","kind":"paragraph","spans":[{"id":"spn-43435","text":"YAML-based normative constraints: hard boundaries (instant rejection on violation), soft preferences (score adjustments), and amendment rules (vindicated dissents trigger constitutional votes)."}]},{"id":"blk-38314","kind":"heading","level":3,"spans":[{"id":"spn-43436","text":"Merkle-Chained Evidence"}]},{"id":"blk-38315","kind":"paragraph","spans":[{"id":"spn-43437","text":"Every deliberation round produces an immutable evidence chain — SHA-256 hashed positions, challenges, votes, and verdicts with a verifiable Merkle root."}]},{"id":"blk-38316","kind":"paragraph","spans":[{"id":"spn-43438","text":"---"}]},{"id":"blk-38317","kind":"heading","level":2,"spans":[{"id":"spn-43439","text":"Transport Bindings"}]},{"head":[{"id":"blk-38319","spans":[{"id":"spn-43440","text":"Protocol"}]},{"id":"blk-38320","spans":[{"id":"spn-43441","text":"Support"}]}],"id":"blk-38318","kind":"table","rows":[[{"id":"blk-38321","spans":[{"id":"spn-43442","marks":["bold"],"text":"A2A"},{"id":"spn-43443","text":" (Google/Linux Foundation)"}]},{"id":"blk-38322","spans":[{"id":"spn-43444","text":"Native — agents advertise "},{"id":"spn-43445","marks":["code"],"text":"deliberation/v1"},{"id":"spn-43446","text":" skill"}]}],[{"id":"blk-38323","spans":[{"id":"spn-43447","marks":["bold"],"text":"MCP"},{"id":"spn-43448","text":" (Anthropic/AAIF)"}]},{"id":"blk-38324","spans":[{"id":"spn-43449","text":"MCP server with 7 tools"}]}],[{"id":"blk-38325","spans":[{"id":"spn-43450","marks":["bold"],"text":"HTTP"}]},{"id":"blk-38326","spans":[{"id":"spn-43451","text":"JSON-RPC 2.0 + SSE for streaming"}]}]]},{"id":"blk-38327","kind":"heading","level":3,"spans":[{"id":"spn-43452","text":"MCP Tools"}]},{"head":[{"id":"blk-38329","spans":[{"id":"spn-43453","text":"Tool"}]},{"id":"blk-38330","spans":[{"id":"spn-43454","text":"Description"}]}],"id":"blk-38328","kind":"table","rows":[[{"id":"blk-38331","spans":[{"id":"spn-43455","marks":["code"],"text":"deliberatic_open_round"}]},{"id":"blk-38332","spans":[{"id":"spn-43456","text":"Open a new deliberation round"}]}],[{"id":"blk-38333","spans":[{"id":"spn-43457","marks":["code"],"text":"deliberatic_submit_position"}]},{"id":"blk-38334","spans":[{"id":"spn-43458","text":"Submit a position with evidence"}]}],[{"id":"blk-38335","spans":[{"id":"spn-43459","marks":["code"],"text":"deliberatic_challenge"}]},{"id":"blk-38336","spans":[{"id":"spn-43460","text":"Challenge another agent's position"}]}],[{"id":"blk-38337","spans":[{"id":"spn-43461","marks":["code"],"text":"deliberatic_resolve"}]},{"id":"blk-38338","spans":[{"id":"spn-43462","text":"Trigger resolution and get verdict"}]}],[{"id":"blk-38339","spans":[{"id":"spn-43463","marks":["code"],"text":"deliberatic_query_evidence"}]},{"id":"blk-38340","spans":[{"id":"spn-43464","text":"Query evidence chains by round ID"}]}],[{"id":"blk-38341","spans":[{"id":"spn-43465","marks":["code"],"text":"deliberatic_get_reputation"}]},{"id":"blk-38342","spans":[{"id":"spn-43466","text":"Get agent reputation scores"}]}],[{"id":"blk-38343","spans":[{"id":"spn-43467","marks":["code"],"text":"deliberatic_amend_constitution"}]},{"id":"blk-38344","spans":[{"id":"spn-43468","text":"Propose constitutional amendment"}]}]]},{"id":"blk-38345","kind":"paragraph","spans":[{"id":"spn-43469","text":"---"}]},{"id":"blk-38346","kind":"heading","level":2,"spans":[{"id":"spn-43470","text":"Position in the [&] Ecosystem"}]},{"id":"blk-38347","kind":"paragraph","spans":[{"id":"spn-43471","text":"Deliberatic is the "},{"id":"spn-43472","marks":["bold"],"text":"decision layer"},{"id":"spn-43473","text":":"}]},{"head":[{"id":"blk-38349","spans":[{"id":"spn-43474","text":"Layer"}]},{"id":"blk-38350","spans":[{"id":"spn-43475","text":"Product"}]},{"id":"blk-38351","spans":[{"id":"spn-43476","text":"Role"}]}],"id":"blk-38348","kind":"table","rows":[[{"id":"blk-38352","spans":[{"id":"spn-43477","text":"Distribution"}]},{"id":"blk-38353","spans":[{"id":"spn-43478","text":"FleetPrompt"}]},{"id":"blk-38354","spans":[{"id":"spn-43479","text":"Agent runtime, skill execution"}]}],[{"id":"blk-38355","spans":[{"id":"spn-43480","text":"Standards"}]},{"id":"blk-38356","spans":[{"id":"spn-43481","text":"SpecPrompt"}]},{"id":"blk-38357","spans":[{"id":"spn-43482","text":"Execution specs, schema validation"}]}],[{"id":"blk-38358","spans":[{"id":"spn-43483","text":"Orchestration"}]},{"id":"blk-38359","spans":[{"id":"spn-43484","text":"Delegatic"}]},{"id":"blk-38360","spans":[{"id":"spn-43485","text":"Task routing, workflow graphs"}]}],[{"id":"blk-38361","spans":[{"id":"spn-43486","marks":["bold"],"text":"Decisions"}]},{"id":"blk-38362","spans":[{"id":"spn-43487","marks":["bold"],"text":"Deliberatic"}]},{"id":"blk-38363","spans":[{"id":"spn-43488","marks":["bold"],"text":"Argumentation, consensus, audit"}]}],[{"id":"blk-38364","spans":[{"id":"spn-43489","text":"Execution"}]},{"id":"blk-38365","spans":[{"id":"spn-43490","text":"AgenTroMatic"}]},{"id":"blk-38366","spans":[{"id":"spn-43491","text":"Autonomous task execution"}]}],[{"id":"blk-38367","spans":[{"id":"spn-43492","text":"Infrastructure"}]},{"id":"blk-38368","spans":[{"id":"spn-43493","text":"WebHost.Systems"}]},{"id":"blk-38369","spans":[{"id":"spn-43494","text":"Hosting, deployment"}]}],[{"id":"blk-38370","spans":[{"id":"spn-43495","text":"Spatial"}]},{"id":"blk-38371","spans":[{"id":"spn-43496","text":"GeoFleetic"}]},{"id":"blk-38372","spans":[{"id":"spn-43497","text":"Location-aware routing"}]}],[{"id":"blk-38373","spans":[{"id":"spn-43498","text":"Temporal"}]},{"id":"blk-38374","spans":[{"id":"spn-43499","text":"TickTickClock"}]},{"id":"blk-38375","spans":[{"id":"spn-43500","text":"Scheduling, deadlines"}]}]]},{"id":"blk-38376","kind":"paragraph","spans":[{"id":"spn-43501","text":"---"}]},{"id":"blk-38377","kind":"heading","level":2,"spans":[{"id":"spn-43502","text":"Project Links"}]},{"id":"blk-38378","items":[{"blocks":[{"id":"blk-38380","kind":"paragraph","spans":[{"id":"spn-43503","marks":["bold"],"text":"Spec:"},{"id":"spn-43504","text":" "},{"id":"spn-43505","marks":[{"kind":"link","predicate":"cites","target":"#/deliberatic.com/docs/spec/README.md"}],"text":"Protocol Specification"}]}],"id":"blk-38379","kind":"list-item"},{"blocks":[{"id":"blk-38382","kind":"paragraph","spans":[{"id":"spn-43506","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-43507","text":" "},{"id":"spn-43508","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-38381","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-38383","kind":"paragraph","spans":[{"id":"spn-43509","text":"---"}]},{"id":"blk-38384","kind":"paragraph","spans":[{"id":"spn-43510","text":"*[&] Ampersand Box Design — deliberatic.com*"}]}],"edges":[],"id":"bagaaierawm24c3usklxxfhjvrktx4roebrwe6eew6rivaehqwdnt7lvahfwa","vocabulary":"ampersand.docs.fs.v1"}