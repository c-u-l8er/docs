omatic.com"}],"text":"AgenTroMatic Docs"}]}],"id":"blk-60293","kind":"list-item"},{"blocks":[{"id":"blk-60296","kind":"paragraph","spans":[{"id":"spn-91363","marks":[{"kind":"link","predicate":"cites","target":"https://docs.delegatic.com"}],"text":"Delegatic Docs"}]}],"id":"blk-60295","kind":"list-item"},{"blocks":[{"id":"blk-60298","kind":"paragraph","spans":[{"id":"spn-91364","marks":[{"kind":"link","predicate":"cites","target":"https://docs.deliberatic.com"}],"text":"Deliberatic Docs"}]}],"id":"blk-60297","kind":"list-item"},{"blocks":[{"id":"blk-60300","kind":"paragraph","spans":[{"id":"spn-91365","marks":[{"kind":"link","predicate":"cites","target":"https://docs.fleetprompt.com"}],"text":"FleetPrompt Docs"}]}],"id":"blk-60299","kind":"list-item"},{"blocks":[{"id":"blk-60302","kind":"paragraph","spans":[{"id":"spn-91366","marks":[{"kind":"link","predicate":"cites","target":"https://docs.geofleetic.com"}],"text":"GeoFleetic Docs"}]}],"id":"blk-60301","kind":"list-item"},{"blocks":[{"id":"blk-60304","kind":"paragraph","spans":[{"id":"spn-91367","marks":[{"kind":"link","predicate":"cites","target":"https://docs.opensentience.org"}],"text":"OpenSentience Docs"}]}],"id":"blk-60303","kind":"list-item"},{"blocks":[{"id":"blk-60306","kind":"paragraph","spans":[{"id":"spn-91368","marks":[{"kind":"link","predicate":"cites","target":"https://docs.specprompt.com"}],"text":"SpecPrompt Docs"}]}],"id":"blk-60305","kind":"list-item"},{"blocks":[{"id":"blk-60308","kind":"paragraph","spans":[{"id":"spn-91369","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ticktickclock.com"}],"text":"TickTickClock Docs"}]}],"id":"blk-60307","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-60309","kind":"paragraph","spans":[{"id":"spn-91370","marks":["bold"],"text":"Deliberatic Docs"}]},{"id":"blk-60310","items":[{"blocks":[{"id":"blk-60312","kind":"paragraph","spans":[{"id":"spn-91371","marks":[{"kind":"link","predicate":"cites","target":"#/deliberatic.com/docs/s