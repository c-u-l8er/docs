","predicate":"cites","target":"#/deliberatic.com/docs/spec/README.md"}],"text":"README"}]}],"id":"blk-64427","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-64429","kind":"heading","level":2,"spans":[{"id":"spn-123096","text":"Core Concepts"}]},{"id":"blk-64430","kind":"heading","level":3,"spans":[{"id":"spn-123097","text":"Deliberatic Argumentation Framework (DAF)"}]},{"id":"blk-64431","kind":"paragraph","spans":[{"id":"spn-123098","text":"A formal tuple "},{"id":"spn-123099","marks":["code"],"text":"DAF = <A, R-, R+, w, a, C, p>"},{"id":"spn-123100","text":" combining:"}]},{"id":"blk-64432","items":[{"blocks":[{"id":"blk-64434","kind":"paragraph","spans":[{"id":"spn-123101","marks":["bold"],"text":"Weighted bipolar argumentation"},{"id":"spn-123102","text":" (attacks + supports with evidence-derived weights)"}]}],"id":"blk-64433","kind":"list-item"},{"blocks":[{"id":"blk-64436","kind":"paragraph","spans":[{"id":"spn-123103","marks":["bold"],"text":"Agent authorship tracking"},{"id":"spn-123104","text":" (every argument traces to its submitting agent)"}]}],"id":"blk-64435","kind":"list-item"},{"blocks":[{"id":"blk-64438","kind":"paragraph","spans":[{"id":"spn-123105","marks":["bold"],"text":"Constitutional constraints"},{"id":"spn-123106","text":" (hard boundaries + soft preferences)"}]}],"id":"blk-64437","kind":"list-item"},{"blocks":[{"id":"blk-64440","kind":"paragraph","spans":[{"id":"spn-123107","marks":["bold"],"text":"Domain-aware reputation"},{"id":"spn-123108","text":" (ELO-derived, calibration-adjusted)"}]}],"id":"blk-64439","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-64441","kind":"heading","level":3,"spans":[{"id":"spn-123109","text":"Two-Phase Adaptive Consensus"}]},{"id":"blk-64442","items":[{"blocks":[{"id":"blk-64444","kind":"paragraph","spans":[{"id":"spn-123110","marks":["bold"],"text":"Fast path (Raft-derived)"},{"id":"spn-123111","text":" — when positions have a clear winner (~50ms)"}]}],"id":"blk-64443","kind":