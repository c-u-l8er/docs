{"bendscript":"0.1","blocks":[{"id":"blk-45503","kind":"heading","level":1,"spans":[{"id":"spn-52373","text":"Benchmark Expansion Prompt — Graphonomous v0.3.3+"}]},{"id":"blk-45504","kind":"paragraph","spans":[{"id":"spn-52374","text":"Use this prompt to build benchmark harnesses for Graphonomous one-by-one across chat sessions. Each session tackles one benchmark. The order below is the recommended build sequence (highest ROI first)."}]},{"id":"blk-45505","kind":"paragraph","spans":[{"id":"spn-52375","text":"---"}]},{"id":"blk-45506","kind":"heading","level":2,"spans":[{"id":"spn-52376","text":"Context"}]},{"id":"blk-45507","kind":"paragraph","spans":[{"id":"spn-52377","text":"Graphonomous already has two benchmark harnesses:"}]},{"id":"blk-45508","items":[{"blocks":[{"id":"blk-45510","kind":"paragraph","spans":[{"id":"spn-52378","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-52379","text":" — LongMemEval (ICLR 2025), 500 questions, 92.6% QA proxy"}]}],"id":"blk-45509","kind":"list-item"},{"blocks":[{"id":"blk-45512","kind":"paragraph","spans":[{"id":"spn-52380","marks":["code"],"text":"lib/mix/tasks/benchmark/graphmembench.ex"},{"id":"spn-52381","text":" — GraphMemBench, 120 scenarios, 100% pass"}]}],"id":"blk-45511","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45513","kind":"paragraph","spans":[{"id":"spn-52382","text":"Shared infrastructure:"}]},{"id":"blk-45514","items":[{"blocks":[{"id":"blk-45516","kind":"paragraph","spans":[{"id":"spn-52383","marks":["code"],"text":"lib/mix/tasks/benchmark/helpers.ex"},{"id":"spn-52384","text":" — corpus loading, timing, metrics, JSON output"}]}],"id":"blk-45515","kind":"list-item"},{"blocks":[{"id":"blk-45518","kind":"paragraph","spans":[{"id":"spn-52385","marks":["code"],"text":"lib/mix/tasks/benchmark/llm_judge.ex"},{"id":"spn-52386","text":" — LLM-free evaluation helpers"}]}],"id":"blk-45517","kind":"list-item"},{"blocks":[{"id":"blk-45520","kind":"paragraph","spans":[{"id":"spn-52387","marks":["code"],"text":"lib/mix/tasks/benchmark/run.ex"},{"id":"spn-52388","text":" — full suite orchestrator"}]}],"id":"blk-45519","kind":"list-item"},{"blocks":[{"id":"blk-45522","kind":"paragraph","spans":[{"id":"spn-52389","text":"Benchmark data lives in "},{"id":"spn-52390","marks":["code"],"text":"priv/<benchmark_name>/"}]}],"id":"blk-45521","kind":"list-item"},{"blocks":[{"id":"blk-45524","kind":"paragraph","spans":[{"id":"spn-52391","text":"Results are written as JSON to "},{"id":"spn-52392","marks":["code"],"text":"priv/<benchmark_name>/"},{"id":"spn-52393","text":" with timestamps"}]}],"id":"blk-45523","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45525","kind":"paragraph","spans":[{"id":"spn-52394","text":"Pattern for each new harness: 1. Create "},{"id":"spn-52395","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-52396","text":" to fetch dataset 2. Create "},{"id":"spn-52397","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-52398","text":" as a Mix task 3. Add the phase to "},{"id":"spn-52399","marks":["code"],"text":"run.ex"},{"id":"spn-52400","text":" orchestrator 4. Run, measure, record results 5. Update "},{"id":"spn-52401","marks":["code"],"text":"opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-52402","text":" with findings 6. Store results in Graphonomous via "},{"id":"spn-52403","marks":["code"],"text":"learn_from_outcome"}]},{"id":"blk-45526","kind":"paragraph","spans":[{"id":"spn-52404","text":"---"}]},{"id":"blk-45527","kind":"heading","level":2,"spans":[{"id":"spn-52405","text":"Session Instructions"}]},{"id":"blk-45528","kind":"paragraph","spans":[{"id":"spn-52406","text":"At the start of each session, paste this prompt and say:"}]},{"blocks":[{"id":"blk-45530","kind":"paragraph","spans":[{"id":"spn-52407","marks":["bold"],"text":"\"Build the benchmark harness for [BENCHMARK_NAME].\""}]}],"id":"blk-45529","kind":"quote"},{"id":"blk-45531","kind":"paragraph","spans":[{"id":"spn-52408","text":"The agent should:"}]},{"id":"blk-45532","kind":"paragraph","spans":[{"id":"spn-52409","text":"1. "},{"id":"spn-52410","marks":["bold"],"text":"Bootstrap Graphonomous"},{"id":"spn-52411","text":" — retrieve context for the benchmark goal and any prior benchmark work 2. "},{"id":"spn-52412","marks":["bold"],"text":"Transition the goal"},{"id":"spn-52413","text":" from "},{"id":"spn-52414","marks":["code"],"text":"proposed"},{"id":"spn-52415","text":" → "},{"id":"spn-52416","marks":["code"],"text":"active"},{"id":"spn-52417","text":" 3. "},{"id":"spn-52418","marks":["bold"],"text":"Research the benchmark"},{"id":"spn-52419","text":" — read the paper/repo, understand dataset format, evaluation metrics, and scoring methodology 4. "},{"id":"spn-52420","marks":["bold"],"text":"Download/prepare data"},{"id":"spn-52421","text":" — create "},{"id":"spn-52422","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-52423","text":" and fetch the dataset 5. "},{"id":"spn-52424","marks":["bold"],"text":"Build the harness"},{"id":"spn-52425","text":" — create "},{"id":"spn-52426","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-52427","text":" following the longmemeval.ex pattern:"}]},{"id":"blk-45533","items":[{"blocks":[{"id":"blk-45535","kind":"paragraph","spans":[{"id":"spn-52428","marks":["code"],"text":"use Mix.Task"},{"id":"spn-52429","text":" with "},{"id":"spn-52430","marks":["code"],"text":"@shortdoc"}]}],"id":"blk-45534","kind":"list-item"},{"blocks":[{"id":"blk-45537","kind":"paragraph","spans":[{"id":"spn-52431","text":"Parse CLI options ("},{"id":"spn-52432","marks":["code"],"text":"--limit"},{"id":"spn-52433","text":", "},{"id":"spn-52434","marks":["code"],"text":"--purge"},{"id":"spn-52435","text":", "},{"id":"spn-52436","marks":["code"],"text":"--neural"},{"id":"spn-52437","text":", "},{"id":"spn-52438","marks":["code"],"text":"--skip-ingest"},{"id":"spn-52439","text":")"}]}],"id":"blk-45536","kind":"list-item"},{"blocks":[{"id":"blk-45539","kind":"paragraph","spans":[{"id":"spn-52440","text":"Ingest benchmark data into a fresh Graphonomous graph"}]}],"id":"blk-45538","kind":"list-item"},{"blocks":[{"id":"blk-45541","kind":"paragraph","spans":[{"id":"spn-52441","text":"Run queries through "},{"id":"spn-52442","marks":["code"],"text":"retrieve_context"},{"id":"spn-52443","text":" (and other MCP tools as needed)"}]}],"id":"blk-45540","kind":"list-item"},{"blocks":[{"id":"blk-45543","kind":"paragraph","spans":[{"id":"spn-52444","text":"Score results using the benchmark's official metrics"}]}],"id":"blk-45542","kind":"list-item"},{"blocks":[{"id":"blk-45545","kind":"paragraph","spans":[{"id":"spn-52445","text":"Output competitive comparison table"}]}],"id":"blk-45544","kind":"list-item"},{"blocks":[{"id":"blk-45547","kind":"paragraph","spans":[{"id":"spn-52446","text":"Write results JSON to "},{"id":"spn-52447","marks":["code"],"text":"priv/<name>/"}]}],"id":"blk-45546","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45548","kind":"paragraph","spans":[{"id":"spn-52448","text":"6. "},{"id":"spn-52449","marks":["bold"],"text":"Wire into run.ex"},{"id":"spn-52450","text":" — add the new phase to the orchestrator 7. "},{"id":"spn-52451","marks":["bold"],"text":"Run the benchmark"},{"id":"spn-52452","text":" — execute with "},{"id":"spn-52453","marks":["code"],"text":"--limit 50"},{"id":"spn-52454","text":" first for a smoke test, then full run 8. "},{"id":"spn-52455","marks":["bold"],"text":"Record results"},{"id":"spn-52456","text":" — update OS-E001 evaluation doc, store in Graphonomous 9. "},{"id":"spn-52457","marks":["bold"],"text":"Update goal progress"},{"id":"spn-52458","text":" — set to 1.0 and transition to "},{"id":"spn-52459","marks":["code"],"text":"done"},{"id":"spn-52460","text":" if passing"}]},{"id":"blk-45549","kind":"paragraph","spans":[{"id":"spn-52461","text":"---"}]},{"id":"blk-45550","kind":"heading","level":2,"spans":[{"id":"spn-52462","text":"Benchmark Build Order"}]},{"id":"blk-45551","kind":"heading","level":3,"spans":[{"id":"spn-52463","text":"Session 1: BEAM (Beyond a Million Tokens)"}]},{"id":"blk-45552","items":[{"blocks":[{"id":"blk-45554","kind":"paragraph","spans":[{"id":"spn-52464","marks":["bold"],"text":"Goal ID"},{"id":"spn-52465","text":": "},{"id":"spn-52466","marks":["code"],"text":"goal_5e547ffb6d10787cae8d9a57a9f217f8"}]}],"id":"blk-45553","kind":"list-item"},{"blocks":[{"id":"blk-45556","kind":"paragraph","spans":[{"id":"spn-52467","marks":["bold"],"text":"Paper"},{"id":"spn-52468","text":": https://arxiv.org/abs/2510.27246"}]}],"id":"blk-45555","kind":"list-item"},{"blocks":[{"id":"blk-45558","kind":"paragraph","spans":[{"id":"spn-52469","marks":["bold"],"text":"Repo"},{"id":"spn-52470","text":": https://github.com/mohammadtavakoli78/BEAM"}]}],"id":"blk-45557","kind":"list-item"},{"blocks":[{"id":"blk-45560","kind":"paragraph","spans":[{"id":"spn-52471","marks":["bold"],"text":"Dataset"},{"id":"spn-52472","text":": 100 conversations, 2,000 questions at 128K/500K/1M/10M token scales"}]}],"id":"blk-45559","kind":"list-item"},{"blocks":[{"id":"blk-45562","kind":"paragraph","spans":[{"id":"spn-52473","marks":["bold"],"text":"Metrics"},{"id":"spn-52474","text":": QA accuracy across 10 memory abilities, per-scale breakdown"}]}],"id":"blk-45561","kind":"list-item"},{"blocks":[{"id":"blk-45564","kind":"paragraph","spans":[{"id":"spn-52475","marks":["bold"],"text":"SOTA"},{"id":"spn-52476","text":": Hindsight 64.1% (10M), 73.9% (1M)"}]}],"id":"blk-45563","kind":"list-item"},{"blocks":[{"id":"blk-45566","kind":"paragraph","spans":[{"id":"spn-52477","marks":["bold"],"text":"Key challenge"},{"id":"spn-52478","text":": Multi-scale evaluation. Start with 128K tier (fits in single graph). 10M tier will stress SQLite and retrieval latency."}]}],"id":"blk-45565","kind":"list-item"},{"blocks":[{"id":"blk-45568","kind":"paragraph","spans":[{"id":"spn-52479","marks":["bold"],"text":"Harness name"},{"id":"spn-52480","text":": "},{"id":"spn-52481","marks":["code"],"text":"mix benchmark.beam"}]}],"id":"blk-45567","kind":"list-item"},{"blocks":[{"id":"blk-45570","kind":"paragraph","spans":[{"id":"spn-52482","marks":["bold"],"text":"CLI"},{"id":"spn-52483","text":": "},{"id":"spn-52484","marks":["code"],"text":"mix benchmark.beam --tier 128k --limit 50"}]}],"id":"blk-45569","kind":"list-item"},{"blocks":[{"id":"blk-45572","kind":"paragraph","spans":[{"id":"spn-52485","marks":["bold"],"text":"Why first"},{"id":"spn-52486","text":": This is the new industry standard. Every competitor reports BEAM scores. Scaling behavior is where graph memory should differentiate from flat vector stores."}]}],"id":"blk-45571","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45573","kind":"heading","level":3,"spans":[{"id":"spn-52487","text":"Session 2: MemoryAgentBench"}]},{"id":"blk-45574","items":[{"blocks":[{"id":"blk-45576","kind":"paragraph","spans":[{"id":"spn-52488","marks":["bold"],"text":"Goal ID"},{"id":"spn-52489","text":": "},{"id":"spn-52490","marks":["code"],"text":"goal_8889e094cb2b904d65f6a29cd7861f1c"}]}],"id":"blk-45575","kind":"list-item"},{"blocks":[{"id":"blk-45578","kind":"paragraph","spans":[{"id":"spn-52491","marks":["bold"],"text":"Paper"},{"id":"spn-52492","text":": https://arxiv.org/abs/2507.05257"}]}],"id":"blk-45577","kind":"list-item"},{"blocks":[{"id":"blk-45580","kind":"paragraph","spans":[{"id":"spn-52493","marks":["bold"],"text":"Repo"},{"id":"spn-52494","text":": https://github.com/HUST-AI-HYZ/MemoryAgentBench"}]}],"id":"blk-45579","kind":"list-item"},{"blocks":[{"id":"blk-45582","kind":"paragraph","spans":[{"id":"spn-52495","marks":["bold"],"text":"Dataset"},{"id":"spn-52496","text":": Multi-turn incremental format, includes EventQA and FactConsolidation"}]}],"id":"blk-45581","kind":"list-item"},{"blocks":[{"id":"blk-45584","kind":"paragraph","spans":[{"id":"spn-52497","marks":["bold"],"text":"Metrics"},{"id":"spn-52498","text":": 4 competency scores — accurate retrieval, test-time learning, long-range understanding, selective forgetting"}]}],"id":"blk-45583","kind":"list-item"},{"blocks":[{"id":"blk-45586","kind":"paragraph","spans":[{"id":"spn-52499","marks":["bold"],"text":"Key challenge"},{"id":"spn-52500","text":": Multi-turn format requires simulating incremental store→query cycles, not batch ingest. Map \"selective forgetting\" to "},{"id":"spn-52501","marks":["code"],"text":"forget_by_policy"},{"id":"spn-52502","text":" / "},{"id":"spn-52503","marks":["code"],"text":"forget_node"},{"id":"spn-52504","text":"."}]}],"id":"blk-45585","kind":"list-item"},{"blocks":[{"id":"blk-45588","kind":"paragraph","spans":[{"id":"spn-52505","marks":["bold"],"text":"Harness name"},{"id":"spn-52506","text":": "},{"id":"spn-52507","marks":["code"],"text":"mix benchmark.memoryagentbench"}]}],"id":"blk-45587","kind":"list-item"},{"blocks":[{"id":"blk-45590","kind":"paragraph","spans":[{"id":"spn-52508","marks":["bold"],"text":"CLI"},{"id":"spn-52509","text":": "},{"id":"spn-52510","marks":["code"],"text":"mix benchmark.memoryagentbench --limit 50"}]}],"id":"blk-45589","kind":"list-item"},{"blocks":[{"id":"blk-45592","kind":"paragraph","spans":[{"id":"spn-52511","marks":["bold"],"text":"Why second"},{"id":"spn-52512","text":": Directly tests Graphonomous's differentiating features (forgetting, learning loop). ICLR 2026 paper — high credibility."}]}],"id":"blk-45591","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45593","kind":"heading","level":3,"spans":[{"id":"spn-52513","text":"Session 3: LMEB (Long-horizon Memory Embedding Benchmark)"}]},{"id":"blk-45594","items":[{"blocks":[{"id":"blk-45596","kind":"paragraph","spans":[{"id":"spn-52514","marks":["bold"],"text":"Goal ID"},{"id":"spn-52515","text":": "},{"id":"spn-52516","marks":["code"],"text":"goal_81c0f91f92b9b4a52e0a38b44c49a492"}]}],"id":"blk-45595","kind":"list-item"},{"blocks":[{"id":"blk-45598","kind":"paragraph","spans":[{"id":"spn-52517","marks":["bold"],"text":"Paper"},{"id":"spn-52518","text":": https://arxiv.org/abs/2603.12572"}]}],"id":"blk-45597","kind":"list-item"},{"blocks":[{"id":"blk-45600","kind":"paragraph","spans":[{"id":"spn-52519","marks":["bold"],"text":"Repo"},{"id":"spn-52520","text":": https://github.com/KaLM-Embedding/LMEB"}]}],"id":"blk-45599","kind":"list-item"},{"blocks":[{"id":"blk-45602","kind":"paragraph","spans":[{"id":"spn-52521","marks":["bold"],"text":"HuggingFace"},{"id":"spn-52522","text":": https://huggingface.co/datasets/KaLM-Embedding/LMEB"}]}],"id":"blk-45601","kind":"list-item"},{"blocks":[{"id":"blk-45604","kind":"paragraph","spans":[{"id":"spn-52523","marks":["bold"],"text":"Dataset"},{"id":"spn-52524","text":": 22 datasets, 193 zero-shot retrieval tasks across 4 memory types (episodic, dialogue, semantic, procedural)"}]}],"id":"blk-45603","kind":"list-item"},{"blocks":[{"id":"blk-45606","kind":"paragraph","spans":[{"id":"spn-52525","marks":["bold"],"text":"Metrics"},{"id":"spn-52526","text":": Retrieval accuracy per memory type, aggregate score"}]}],"id":"blk-45605","kind":"list-item"},{"blocks":[{"id":"blk-45608","kind":"paragraph","spans":[{"id":"spn-52527","marks":["bold"],"text":"Key challenge"},{"id":"spn-52528","text":": This benchmarks the *embedding model*, not the full system. Run nomic-embed-text-v2-moe through the LMEB eval harness (likely Python). May need a thin Python wrapper or direct Elixir port of the eval logic."}]}],"id":"blk-45607","kind":"list-item"},{"blocks":[{"id":"blk-45610","kind":"paragraph","spans":[{"id":"spn-52529","marks":["bold"],"text":"Harness name"},{"id":"spn-52530","text":": "},{"id":"spn-52531","marks":["code"],"text":"mix benchmark.lmeb"}]}],"id":"blk-45609","kind":"list-item"},{"blocks":[{"id":"blk-45612","kind":"paragraph","spans":[{"id":"spn-52532","marks":["bold"],"text":"CLI"},{"id":"spn-52533","text":": "},{"id":"spn-52534","marks":["code"],"text":"mix benchmark.lmeb --model nomic-embed-text-v2-moe"}]}],"id":"blk-45611","kind":"list-item"},{"blocks":[{"id":"blk-45614","kind":"paragraph","spans":[{"id":"spn-52535","marks":["bold"],"text":"Why third"},{"id":"spn-52536","text":": Cheapest to run (embedding-only, no LLM judge needed). Validates the foundational layer. If nomic scores poorly on memory-specific retrieval, that's a critical finding."}]}],"id":"blk-45613","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45615","kind":"heading","level":3,"spans":[{"id":"spn-52537","text":"Session 4: MemoryBench (Continual Learning from Feedback)"}]},{"id":"blk-45616","items":[{"blocks":[{"id":"blk-45618","kind":"paragraph","spans":[{"id":"spn-52538","marks":["bold"],"text":"Goal ID"},{"id":"spn-52539","text":": "},{"id":"spn-52540","marks":["code"],"text":"goal_8ef86ae124eb2f03375289107dcac5ae"}]}],"id":"blk-45617","kind":"list-item"},{"blocks":[{"id":"blk-45620","kind":"paragraph","spans":[{"id":"spn-52541","marks":["bold"],"text":"Paper"},{"id":"spn-52542","text":": https://arxiv.org/abs/2510.17281"}]}],"id":"blk-45619","kind":"list-item"},{"blocks":[{"id":"blk-45622","kind":"paragraph","spans":[{"id":"spn-52543","marks":["bold"],"text":"Dataset"},{"id":"spn-52544","text":": User feedback simulation across multiple domains and languages"}]}],"id":"blk-45621","kind":"list-item"},{"blocks":[{"id":"blk-45624","kind":"paragraph","spans":[{"id":"spn-52545","marks":["bold"],"text":"Metrics"},{"id":"spn-52546","text":": Continual learning accuracy, feedback utilization rate, cross-domain transfer"}]}],"id":"blk-45623","kind":"list-item"},{"blocks":[{"id":"blk-45626","kind":"paragraph","spans":[{"id":"spn-52547","marks":["bold"],"text":"Key challenge"},{"id":"spn-52548","text":": Requires simulating the feedback loop — "},{"id":"spn-52549","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-52550","text":" with explicit/action-based/implicit feedback types, then re-querying to measure improvement. Multi-domain and multilingual means varied corpus."}]}],"id":"blk-45625","kind":"list-item"},{"blocks":[{"id":"blk-45628","kind":"paragraph","spans":[{"id":"spn-52551","marks":["bold"],"text":"Harness name"},{"id":"spn-52552","text":": "},{"id":"spn-52553","marks":["code"],"text":"mix benchmark.memorybench"}]}],"id":"blk-45627","kind":"list-item"},{"blocks":[{"id":"blk-45630","kind":"paragraph","spans":[{"id":"spn-52554","marks":["bold"],"text":"CLI"},{"id":"spn-52555","text":": "},{"id":"spn-52556","marks":["code"],"text":"mix benchmark.memorybench --domain all --limit 100"}]}],"id":"blk-45629","kind":"list-item"},{"blocks":[{"id":"blk-45632","kind":"paragraph","spans":[{"id":"spn-52557","marks":["bold"],"text":"Why fourth"},{"id":"spn-52558","text":": Directly tests the learning loop. Published finding that no system beats RAG baseline — if Graphonomous does, that's a headline result."}]}],"id":"blk-45631","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45633","kind":"heading","level":3,"spans":[{"id":"spn-52559","text":"Session 5: LifeBench (Non-Declarative Memory)"}]},{"id":"blk-45634","items":[{"blocks":[{"id":"blk-45636","kind":"paragraph","spans":[{"id":"spn-52560","marks":["bold"],"text":"Goal ID"},{"id":"spn-52561","text":": "},{"id":"spn-52562","marks":["code"],"text":"goal_824059ff9230ff0953646ea7ac2e7d6a"}]}],"id":"blk-45635","kind":"list-item"},{"blocks":[{"id":"blk-45638","kind":"paragraph","spans":[{"id":"spn-52563","marks":["bold"],"text":"Paper"},{"id":"spn-52564","text":": https://arxiv.org/abs/2603.03781"}]}],"id":"blk-45637","kind":"list-item"},{"blocks":[{"id":"blk-45640","kind":"paragraph","spans":[{"id":"spn-52565","marks":["bold"],"text":"Dataset"},{"id":"spn-52566","text":": Long-horizon event simulations with real-world priors (surveys, maps, calendars)"}]}],"id":"blk-45639","kind":"list-item"},{"blocks":[{"id":"blk-45642","kind":"paragraph","spans":[{"id":"spn-52567","marks":["bold"],"text":"Metrics"},{"id":"spn-52568","text":": Accuracy on habitual/procedural memory inference, declarative vs non-declarative breakdown"}]}],"id":"blk-45641","kind":"list-item"},{"blocks":[{"id":"blk-45644","kind":"paragraph","spans":[{"id":"spn-52569","marks":["bold"],"text":"SOTA"},{"id":"spn-52570","text":": 55.2% (top system)"}]}],"id":"blk-45643","kind":"list-item"},{"blocks":[{"id":"blk-45646","kind":"paragraph","spans":[{"id":"spn-52571","marks":["bold"],"text":"Key challenge"},{"id":"spn-52572","text":": Tests *inferred* knowledge, not explicitly stored facts. Graphonomous procedural nodes + edge patterns may capture habitual patterns that flat stores miss. May need to extend "},{"id":"spn-52573","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-52574","text":" or add inference logic."}]}],"id":"blk-45645","kind":"list-item"},{"blocks":[{"id":"blk-45648","kind":"paragraph","spans":[{"id":"spn-52575","marks":["bold"],"text":"Harness name"},{"id":"spn-52576","text":": "},{"id":"spn-52577","marks":["code"],"text":"mix benchmark.lifebench"}]}],"id":"blk-45647","kind":"list-item"},{"blocks":[{"id":"blk-45650","kind":"paragraph","spans":[{"id":"spn-52578","marks":["bold"],"text":"CLI"},{"id":"spn-52579","text":": "},{"id":"spn-52580","marks":["code"],"text":"mix benchmark.lifebench --limit 50"}]}],"id":"blk-45649","kind":"list-item"},{"blocks":[{"id":"blk-45652","kind":"paragraph","spans":[{"id":"spn-52581","marks":["bold"],"text":"Why fifth"},{"id":"spn-52582","text":": Hardest benchmark (SOTA is 55%). Low expectations, high signal. If graph structure helps even marginally on non-declarative memory, that validates the architecture thesis."}]}],"id":"blk-45651","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45653","kind":"heading","level":3,"spans":[{"id":"spn-52583","text":"Session 6: AMemGym (On-Policy Interactive)"}]},{"id":"blk-45654","items":[{"blocks":[{"id":"blk-45656","kind":"paragraph","spans":[{"id":"spn-52584","marks":["bold"],"text":"Goal ID"},{"id":"spn-52585","text":": "},{"id":"spn-52586","marks":["code"],"text":"goal_b7ccffd9e67df8e7b42366ff24a9be82"}]}],"id":"blk-45655","kind":"list-item"},{"blocks":[{"id":"blk-45658","kind":"paragraph","spans":[{"id":"spn-52587","marks":["bold"],"text":"Paper"},{"id":"spn-52588","text":": https://arxiv.org/abs/2603.01966"}]}],"id":"blk-45657","kind":"list-item"},{"blocks":[{"id":"blk-45660","kind":"paragraph","spans":[{"id":"spn-52589","marks":["bold"],"text":"HuggingFace"},{"id":"spn-52590","text":": https://huggingface.co/datasets/AGI-Eval/AMemGym"}]}],"id":"blk-45659","kind":"list-item"},{"blocks":[{"id":"blk-45662","kind":"paragraph","spans":[{"id":"spn-52591","marks":["bold"],"text":"Dataset"},{"id":"spn-52592","text":": Interactive on-policy benchmark — agent generates its own conversation"}]}],"id":"blk-45661","kind":"list-item"},{"blocks":[{"id":"blk-45664","kind":"paragraph","spans":[{"id":"spn-52593","marks":["bold"],"text":"Metrics"},{"id":"spn-52594","text":": Structured state consistency, memory utilization, persona tracking"}]}],"id":"blk-45663","kind":"list-item"},{"blocks":[{"id":"blk-45666","kind":"paragraph","spans":[{"id":"spn-52595","marks":["bold"],"text":"Key challenge"},{"id":"spn-52596","text":": This is fundamentally different from other benchmarks. The agent must *participate* in the conversation, not just answer post-hoc questions. Requires wiring Graphonomous MCP into a simulated conversation loop with an LLM-simulated user. Most complex harness to build."}]}],"id":"blk-45665","kind":"list-item"},{"blocks":[{"id":"blk-45668","kind":"paragraph","spans":[{"id":"spn-52597","marks":["bold"],"text":"Harness name"},{"id":"spn-52598","text":": "},{"id":"spn-52599","marks":["code"],"text":"mix benchmark.amemgym"}]}],"id":"blk-45667","kind":"list-item"},{"blocks":[{"id":"blk-45670","kind":"paragraph","spans":[{"id":"spn-52600","marks":["bold"],"text":"CLI"},{"id":"spn-52601","text":": "},{"id":"spn-52602","marks":["code"],"text":"mix benchmark.amemgym --scenarios 10"}]}],"id":"blk-45669","kind":"list-item"},{"blocks":[{"id":"blk-45672","kind":"paragraph","spans":[{"id":"spn-52603","marks":["bold"],"text":"Why last"},{"id":"spn-52604","text":": Most complex integration. Requires LLM-in-the-loop (simulated user). But the most realistic test of how Graphonomous actually performs in production. Save for last when all other harnesses are proven."}]}],"id":"blk-45671","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45673","kind":"paragraph","spans":[{"id":"spn-52605","text":"---"}]},{"id":"blk-45674","kind":"heading","level":2,"spans":[{"id":"spn-52606","text":"Post-Completion"}]},{"id":"blk-45675","kind":"paragraph","spans":[{"id":"spn-52607","text":"After all 6 harnesses are built and run:"}]},{"id":"blk-45676","kind":"paragraph","spans":[{"id":"spn-52608","text":"1. Update "},{"id":"spn-52609","marks":["code"],"text":"OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-52610","text":" with a unified results table 2. Update "},{"id":"spn-52611","marks":["code"],"text":"graphonomous.com/benchmarks/"},{"id":"spn-52612","text":" pages with new benchmark results 3. Update "},{"id":"spn-52613","marks":["code"],"text":"AmpersandBoxDesign/site/portfolio-review.html"},{"id":"spn-52614","text":" competitive landscape 4. Store a comprehensive episodic node in Graphonomous summarizing the full evaluation 5. Consider adding top-line scores to "},{"id":"spn-52615","marks":["code"],"text":"graphonomous/README.md"}]},{"id":"blk-45677","kind":"paragraph","spans":[{"id":"spn-52616","text":"---"}]},{"id":"blk-45678","kind":"heading","level":2,"spans":[{"id":"spn-52617","text":"Anti-Patterns to Avoid"}]},{"id":"blk-45679","items":[{"blocks":[{"id":"blk-45681","kind":"paragraph","spans":[{"id":"spn-52618","text":"Do NOT modify "},{"id":"spn-52619","marks":["code"],"text":"retrieve_context"},{"id":"spn-52620","text":" or the retrieval pipeline to game a specific benchmark"}]}],"id":"blk-45680","kind":"list-item"},{"blocks":[{"id":"blk-45683","kind":"paragraph","spans":[{"id":"spn-52621","text":"Do NOT add benchmark-specific code paths to the core engine"}]}],"id":"blk-45682","kind":"list-item"},{"blocks":[{"id":"blk-45685","kind":"paragraph","spans":[{"id":"spn-52622","text":"Do NOT skip the smoke test ("},{"id":"spn-52623","marks":["code"],"text":"--limit 50"},{"id":"spn-52624","text":") before full runs"}]}],"id":"blk-45684","kind":"list-item"},{"blocks":[{"id":"blk-45687","kind":"paragraph","spans":[{"id":"spn-52625","text":"Do NOT fabricate competitive baselines — only cite published numbers with sources"}]}],"id":"blk-45686","kind":"list-item"},{"blocks":[{"id":"blk-45689","kind":"paragraph","spans":[{"id":"spn-52626","text":"Do NOT skip storing results in Graphonomous — the learning loop is the point"}]}],"id":"blk-45688","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierasl3bfldzayfpm3y6rmugmr3n2kzjwefjv3per5erxcgaksptbzsa","vocabulary":"ampersand.docs.fs.v1"}