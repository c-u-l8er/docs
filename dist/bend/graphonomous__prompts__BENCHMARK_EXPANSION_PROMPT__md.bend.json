{"bendscript":"0.1","blocks":[{"id":"blk-45989","kind":"heading","level":1,"spans":[{"id":"spn-53493","text":"Benchmark Expansion Prompt — Graphonomous v0.3.3+"}]},{"id":"blk-45990","kind":"paragraph","spans":[{"id":"spn-53494","text":"Use this prompt to build benchmark harnesses for Graphonomous one-by-one across chat sessions. Each session tackles one benchmark. The order below is the recommended build sequence (highest ROI first)."}]},{"id":"blk-45991","kind":"paragraph","spans":[{"id":"spn-53495","text":"---"}]},{"id":"blk-45992","kind":"heading","level":2,"spans":[{"id":"spn-53496","text":"Context"}]},{"id":"blk-45993","kind":"paragraph","spans":[{"id":"spn-53497","text":"Graphonomous already has two benchmark harnesses:"}]},{"id":"blk-45994","items":[{"blocks":[{"id":"blk-45996","kind":"paragraph","spans":[{"id":"spn-53498","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-53499","text":" — LongMemEval (ICLR 2025), 500 questions, 92.6% QA proxy"}]}],"id":"blk-45995","kind":"list-item"},{"blocks":[{"id":"blk-45998","kind":"paragraph","spans":[{"id":"spn-53500","marks":["code"],"text":"lib/mix/tasks/benchmark/graphmembench.ex"},{"id":"spn-53501","text":" — GraphMemBench, 120 scenarios, 100% pass"}]}],"id":"blk-45997","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45999","kind":"paragraph","spans":[{"id":"spn-53502","text":"Shared infrastructure:"}]},{"id":"blk-46000","items":[{"blocks":[{"id":"blk-46002","kind":"paragraph","spans":[{"id":"spn-53503","marks":["code"],"text":"lib/mix/tasks/benchmark/helpers.ex"},{"id":"spn-53504","text":" — corpus loading, timing, metrics, JSON output"}]}],"id":"blk-46001","kind":"list-item"},{"blocks":[{"id":"blk-46004","kind":"paragraph","spans":[{"id":"spn-53505","marks":["code"],"text":"lib/mix/tasks/benchmark/llm_judge.ex"},{"id":"spn-53506","text":" — LLM-free evaluation helpers"}]}],"id":"blk-46003","kind":"list-item"},{"blocks":[{"id":"blk-46006","kind":"paragraph","spans":[{"id":"spn-53507","marks":["code"],"text":"lib/mix/tasks/benchmark/run.ex"},{"id":"spn-53508","text":" — full suite orchestrator"}]}],"id":"blk-46005","kind":"list-item"},{"blocks":[{"id":"blk-46008","kind":"paragraph","spans":[{"id":"spn-53509","text":"Benchmark data lives in "},{"id":"spn-53510","marks":["code"],"text":"priv/<benchmark_name>/"}]}],"id":"blk-46007","kind":"list-item"},{"blocks":[{"id":"blk-46010","kind":"paragraph","spans":[{"id":"spn-53511","text":"Results are written as JSON to "},{"id":"spn-53512","marks":["code"],"text":"priv/<benchmark_name>/"},{"id":"spn-53513","text":" with timestamps"}]}],"id":"blk-46009","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46011","kind":"paragraph","spans":[{"id":"spn-53514","text":"Pattern for each new harness: 1. Create "},{"id":"spn-53515","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-53516","text":" to fetch dataset 2. Create "},{"id":"spn-53517","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-53518","text":" as a Mix task 3. Add the phase to "},{"id":"spn-53519","marks":["code"],"text":"run.ex"},{"id":"spn-53520","text":" orchestrator 4. Run, measure, record results 5. Update "},{"id":"spn-53521","marks":["code"],"text":"opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-53522","text":" with findings 6. Store results in Graphonomous via "},{"id":"spn-53523","marks":["code"],"text":"learn_from_outcome"}]},{"id":"blk-46012","kind":"paragraph","spans":[{"id":"spn-53524","text":"---"}]},{"id":"blk-46013","kind":"heading","level":2,"spans":[{"id":"spn-53525","text":"Session Instructions"}]},{"id":"blk-46014","kind":"paragraph","spans":[{"id":"spn-53526","text":"At the start of each session, paste this prompt and say:"}]},{"blocks":[{"id":"blk-46016","kind":"paragraph","spans":[{"id":"spn-53527","marks":["bold"],"text":"\"Build the benchmark harness for [BENCHMARK_NAME].\""}]}],"id":"blk-46015","kind":"quote"},{"id":"blk-46017","kind":"paragraph","spans":[{"id":"spn-53528","text":"The agent should:"}]},{"id":"blk-46018","kind":"paragraph","spans":[{"id":"spn-53529","text":"1. "},{"id":"spn-53530","marks":["bold"],"text":"Bootstrap Graphonomous"},{"id":"spn-53531","text":" — retrieve context for the benchmark goal and any prior benchmark work 2. "},{"id":"spn-53532","marks":["bold"],"text":"Transition the goal"},{"id":"spn-53533","text":" from "},{"id":"spn-53534","marks":["code"],"text":"proposed"},{"id":"spn-53535","text":" → "},{"id":"spn-53536","marks":["code"],"text":"active"},{"id":"spn-53537","text":" 3. "},{"id":"spn-53538","marks":["bold"],"text":"Research the benchmark"},{"id":"spn-53539","text":" — read the paper/repo, understand dataset format, evaluation metrics, and scoring methodology 4. "},{"id":"spn-53540","marks":["bold"],"text":"Download/prepare data"},{"id":"spn-53541","text":" — create "},{"id":"spn-53542","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-53543","text":" and fetch the dataset 5. "},{"id":"spn-53544","marks":["bold"],"text":"Build the harness"},{"id":"spn-53545","text":" — create "},{"id":"spn-53546","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-53547","text":" following the longmemeval.ex pattern:"}]},{"id":"blk-46019","items":[{"blocks":[{"id":"blk-46021","kind":"paragraph","spans":[{"id":"spn-53548","marks":["code"],"text":"use Mix.Task"},{"id":"spn-53549","text":" with "},{"id":"spn-53550","marks":["code"],"text":"@shortdoc"}]}],"id":"blk-46020","kind":"list-item"},{"blocks":[{"id":"blk-46023","kind":"paragraph","spans":[{"id":"spn-53551","text":"Parse CLI options ("},{"id":"spn-53552","marks":["code"],"text":"--limit"},{"id":"spn-53553","text":", "},{"id":"spn-53554","marks":["code"],"text":"--purge"},{"id":"spn-53555","text":", "},{"id":"spn-53556","marks":["code"],"text":"--neural"},{"id":"spn-53557","text":", "},{"id":"spn-53558","marks":["code"],"text":"--skip-ingest"},{"id":"spn-53559","text":")"}]}],"id":"blk-46022","kind":"list-item"},{"blocks":[{"id":"blk-46025","kind":"paragraph","spans":[{"id":"spn-53560","text":"Ingest benchmark data into a fresh Graphonomous graph"}]}],"id":"blk-46024","kind":"list-item"},{"blocks":[{"id":"blk-46027","kind":"paragraph","spans":[{"id":"spn-53561","text":"Run queries through "},{"id":"spn-53562","marks":["code"],"text":"retrieve_context"},{"id":"spn-53563","text":" (and other MCP tools as needed)"}]}],"id":"blk-46026","kind":"list-item"},{"blocks":[{"id":"blk-46029","kind":"paragraph","spans":[{"id":"spn-53564","text":"Score results using the benchmark's official metrics"}]}],"id":"blk-46028","kind":"list-item"},{"blocks":[{"id":"blk-46031","kind":"paragraph","spans":[{"id":"spn-53565","text":"Output competitive comparison table"}]}],"id":"blk-46030","kind":"list-item"},{"blocks":[{"id":"blk-46033","kind":"paragraph","spans":[{"id":"spn-53566","text":"Write results JSON to "},{"id":"spn-53567","marks":["code"],"text":"priv/<name>/"}]}],"id":"blk-46032","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46034","kind":"paragraph","spans":[{"id":"spn-53568","text":"6. "},{"id":"spn-53569","marks":["bold"],"text":"Wire into run.ex"},{"id":"spn-53570","text":" — add the new phase to the orchestrator 7. "},{"id":"spn-53571","marks":["bold"],"text":"Run the benchmark"},{"id":"spn-53572","text":" — execute with "},{"id":"spn-53573","marks":["code"],"text":"--limit 50"},{"id":"spn-53574","text":" first for a smoke test, then full run 8. "},{"id":"spn-53575","marks":["bold"],"text":"Record results"},{"id":"spn-53576","text":" — update OS-E001 evaluation doc, store in Graphonomous 9. "},{"id":"spn-53577","marks":["bold"],"text":"Update goal progress"},{"id":"spn-53578","text":" — set to 1.0 and transition to "},{"id":"spn-53579","marks":["code"],"text":"done"},{"id":"spn-53580","text":" if passing"}]},{"id":"blk-46035","kind":"paragraph","spans":[{"id":"spn-53581","text":"---"}]},{"id":"blk-46036","kind":"heading","level":2,"spans":[{"id":"spn-53582","text":"Benchmark Build Order"}]},{"id":"blk-46037","kind":"heading","level":3,"spans":[{"id":"spn-53583","text":"Session 1: BEAM (Beyond a Million Tokens)"}]},{"id":"blk-46038","items":[{"blocks":[{"id":"blk-46040","kind":"paragraph","spans":[{"id":"spn-53584","marks":["bold"],"text":"Goal ID"},{"id":"spn-53585","text":": "},{"id":"spn-53586","marks":["code"],"text":"goal_5e547ffb6d10787cae8d9a57a9f217f8"}]}],"id":"blk-46039","kind":"list-item"},{"blocks":[{"id":"blk-46042","kind":"paragraph","spans":[{"id":"spn-53587","marks":["bold"],"text":"Paper"},{"id":"spn-53588","text":": https://arxiv.org/abs/2510.27246"}]}],"id":"blk-46041","kind":"list-item"},{"blocks":[{"id":"blk-46044","kind":"paragraph","spans":[{"id":"spn-53589","marks":["bold"],"text":"Repo"},{"id":"spn-53590","text":": https://github.com/mohammadtavakoli78/BEAM"}]}],"id":"blk-46043","kind":"list-item"},{"blocks":[{"id":"blk-46046","kind":"paragraph","spans":[{"id":"spn-53591","marks":["bold"],"text":"Dataset"},{"id":"spn-53592","text":": 100 conversations, 2,000 questions at 128K/500K/1M/10M token scales"}]}],"id":"blk-46045","kind":"list-item"},{"blocks":[{"id":"blk-46048","kind":"paragraph","spans":[{"id":"spn-53593","marks":["bold"],"text":"Metrics"},{"id":"spn-53594","text":": QA accuracy across 10 memory abilities, per-scale breakdown"}]}],"id":"blk-46047","kind":"list-item"},{"blocks":[{"id":"blk-46050","kind":"paragraph","spans":[{"id":"spn-53595","marks":["bold"],"text":"SOTA"},{"id":"spn-53596","text":": Hindsight 64.1% (10M), 73.9% (1M)"}]}],"id":"blk-46049","kind":"list-item"},{"blocks":[{"id":"blk-46052","kind":"paragraph","spans":[{"id":"spn-53597","marks":["bold"],"text":"Key challenge"},{"id":"spn-53598","text":": Multi-scale evaluation. Start with 128K tier (fits in single graph). 10M tier will stress SQLite and retrieval latency."}]}],"id":"blk-46051","kind":"list-item"},{"blocks":[{"id":"blk-46054","kind":"paragraph","spans":[{"id":"spn-53599","marks":["bold"],"text":"Harness name"},{"id":"spn-53600","text":": "},{"id":"spn-53601","marks":["code"],"text":"mix benchmark.beam"}]}],"id":"blk-46053","kind":"list-item"},{"blocks":[{"id":"blk-46056","kind":"paragraph","spans":[{"id":"spn-53602","marks":["bold"],"text":"CLI"},{"id":"spn-53603","text":": "},{"id":"spn-53604","marks":["code"],"text":"mix benchmark.beam --tier 128k --limit 50"}]}],"id":"blk-46055","kind":"list-item"},{"blocks":[{"id":"blk-46058","kind":"paragraph","spans":[{"id":"spn-53605","marks":["bold"],"text":"Why first"},{"id":"spn-53606","text":": This is the new industry standard. Every competitor reports BEAM scores. Scaling behavior is where graph memory should differentiate from flat vector stores."}]}],"id":"blk-46057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46059","kind":"heading","level":3,"spans":[{"id":"spn-53607","text":"Session 2: MemoryAgentBench"}]},{"id":"blk-46060","items":[{"blocks":[{"id":"blk-46062","kind":"paragraph","spans":[{"id":"spn-53608","marks":["bold"],"text":"Goal ID"},{"id":"spn-53609","text":": "},{"id":"spn-53610","marks":["code"],"text":"goal_8889e094cb2b904d65f6a29cd7861f1c"}]}],"id":"blk-46061","kind":"list-item"},{"blocks":[{"id":"blk-46064","kind":"paragraph","spans":[{"id":"spn-53611","marks":["bold"],"text":"Paper"},{"id":"spn-53612","text":": https://arxiv.org/abs/2507.05257"}]}],"id":"blk-46063","kind":"list-item"},{"blocks":[{"id":"blk-46066","kind":"paragraph","spans":[{"id":"spn-53613","marks":["bold"],"text":"Repo"},{"id":"spn-53614","text":": https://github.com/HUST-AI-HYZ/MemoryAgentBench"}]}],"id":"blk-46065","kind":"list-item"},{"blocks":[{"id":"blk-46068","kind":"paragraph","spans":[{"id":"spn-53615","marks":["bold"],"text":"Dataset"},{"id":"spn-53616","text":": Multi-turn incremental format, includes EventQA and FactConsolidation"}]}],"id":"blk-46067","kind":"list-item"},{"blocks":[{"id":"blk-46070","kind":"paragraph","spans":[{"id":"spn-53617","marks":["bold"],"text":"Metrics"},{"id":"spn-53618","text":": 4 competency scores — accurate retrieval, test-time learning, long-range understanding, selective forgetting"}]}],"id":"blk-46069","kind":"list-item"},{"blocks":[{"id":"blk-46072","kind":"paragraph","spans":[{"id":"spn-53619","marks":["bold"],"text":"Key challenge"},{"id":"spn-53620","text":": Multi-turn format requires simulating incremental store→query cycles, not batch ingest. Map \"selective forgetting\" to "},{"id":"spn-53621","marks":["code"],"text":"forget_by_policy"},{"id":"spn-53622","text":" / "},{"id":"spn-53623","marks":["code"],"text":"forget_node"},{"id":"spn-53624","text":"."}]}],"id":"blk-46071","kind":"list-item"},{"blocks":[{"id":"blk-46074","kind":"paragraph","spans":[{"id":"spn-53625","marks":["bold"],"text":"Harness name"},{"id":"spn-53626","text":": "},{"id":"spn-53627","marks":["code"],"text":"mix benchmark.memoryagentbench"}]}],"id":"blk-46073","kind":"list-item"},{"blocks":[{"id":"blk-46076","kind":"paragraph","spans":[{"id":"spn-53628","marks":["bold"],"text":"CLI"},{"id":"spn-53629","text":": "},{"id":"spn-53630","marks":["code"],"text":"mix benchmark.memoryagentbench --limit 50"}]}],"id":"blk-46075","kind":"list-item"},{"blocks":[{"id":"blk-46078","kind":"paragraph","spans":[{"id":"spn-53631","marks":["bold"],"text":"Why second"},{"id":"spn-53632","text":": Directly tests Graphonomous's differentiating features (forgetting, learning loop). ICLR 2026 paper — high credibility."}]}],"id":"blk-46077","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46079","kind":"heading","level":3,"spans":[{"id":"spn-53633","text":"Session 3: LMEB (Long-horizon Memory Embedding Benchmark)"}]},{"id":"blk-46080","items":[{"blocks":[{"id":"blk-46082","kind":"paragraph","spans":[{"id":"spn-53634","marks":["bold"],"text":"Goal ID"},{"id":"spn-53635","text":": "},{"id":"spn-53636","marks":["code"],"text":"goal_81c0f91f92b9b4a52e0a38b44c49a492"}]}],"id":"blk-46081","kind":"list-item"},{"blocks":[{"id":"blk-46084","kind":"paragraph","spans":[{"id":"spn-53637","marks":["bold"],"text":"Paper"},{"id":"spn-53638","text":": https://arxiv.org/abs/2603.12572"}]}],"id":"blk-46083","kind":"list-item"},{"blocks":[{"id":"blk-46086","kind":"paragraph","spans":[{"id":"spn-53639","marks":["bold"],"text":"Repo"},{"id":"spn-53640","text":": https://github.com/KaLM-Embedding/LMEB"}]}],"id":"blk-46085","kind":"list-item"},{"blocks":[{"id":"blk-46088","kind":"paragraph","spans":[{"id":"spn-53641","marks":["bold"],"text":"HuggingFace"},{"id":"spn-53642","text":": https://huggingface.co/datasets/KaLM-Embedding/LMEB"}]}],"id":"blk-46087","kind":"list-item"},{"blocks":[{"id":"blk-46090","kind":"paragraph","spans":[{"id":"spn-53643","marks":["bold"],"text":"Dataset"},{"id":"spn-53644","text":": 22 datasets, 193 zero-shot retrieval tasks across 4 memory types (episodic, dialogue, semantic, procedural)"}]}],"id":"blk-46089","kind":"list-item"},{"blocks":[{"id":"blk-46092","kind":"paragraph","spans":[{"id":"spn-53645","marks":["bold"],"text":"Metrics"},{"id":"spn-53646","text":": Retrieval accuracy per memory type, aggregate score"}]}],"id":"blk-46091","kind":"list-item"},{"blocks":[{"id":"blk-46094","kind":"paragraph","spans":[{"id":"spn-53647","marks":["bold"],"text":"Key challenge"},{"id":"spn-53648","text":": This benchmarks the *embedding model*, not the full system. Run nomic-embed-text-v2-moe through the LMEB eval harness (likely Python). May need a thin Python wrapper or direct Elixir port of the eval logic."}]}],"id":"blk-46093","kind":"list-item"},{"blocks":[{"id":"blk-46096","kind":"paragraph","spans":[{"id":"spn-53649","marks":["bold"],"text":"Harness name"},{"id":"spn-53650","text":": "},{"id":"spn-53651","marks":["code"],"text":"mix benchmark.lmeb"}]}],"id":"blk-46095","kind":"list-item"},{"blocks":[{"id":"blk-46098","kind":"paragraph","spans":[{"id":"spn-53652","marks":["bold"],"text":"CLI"},{"id":"spn-53653","text":": "},{"id":"spn-53654","marks":["code"],"text":"mix benchmark.lmeb --model nomic-embed-text-v2-moe"}]}],"id":"blk-46097","kind":"list-item"},{"blocks":[{"id":"blk-46100","kind":"paragraph","spans":[{"id":"spn-53655","marks":["bold"],"text":"Why third"},{"id":"spn-53656","text":": Cheapest to run (embedding-only, no LLM judge needed). Validates the foundational layer. If nomic scores poorly on memory-specific retrieval, that's a critical finding."}]}],"id":"blk-46099","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46101","kind":"heading","level":3,"spans":[{"id":"spn-53657","text":"Session 4: MemoryBench (Continual Learning from Feedback)"}]},{"id":"blk-46102","items":[{"blocks":[{"id":"blk-46104","kind":"paragraph","spans":[{"id":"spn-53658","marks":["bold"],"text":"Goal ID"},{"id":"spn-53659","text":": "},{"id":"spn-53660","marks":["code"],"text":"goal_8ef86ae124eb2f03375289107dcac5ae"}]}],"id":"blk-46103","kind":"list-item"},{"blocks":[{"id":"blk-46106","kind":"paragraph","spans":[{"id":"spn-53661","marks":["bold"],"text":"Paper"},{"id":"spn-53662","text":": https://arxiv.org/abs/2510.17281"}]}],"id":"blk-46105","kind":"list-item"},{"blocks":[{"id":"blk-46108","kind":"paragraph","spans":[{"id":"spn-53663","marks":["bold"],"text":"Dataset"},{"id":"spn-53664","text":": User feedback simulation across multiple domains and languages"}]}],"id":"blk-46107","kind":"list-item"},{"blocks":[{"id":"blk-46110","kind":"paragraph","spans":[{"id":"spn-53665","marks":["bold"],"text":"Metrics"},{"id":"spn-53666","text":": Continual learning accuracy, feedback utilization rate, cross-domain transfer"}]}],"id":"blk-46109","kind":"list-item"},{"blocks":[{"id":"blk-46112","kind":"paragraph","spans":[{"id":"spn-53667","marks":["bold"],"text":"Key challenge"},{"id":"spn-53668","text":": Requires simulating the feedback loop — "},{"id":"spn-53669","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-53670","text":" with explicit/action-based/implicit feedback types, then re-querying to measure improvement. Multi-domain and multilingual means varied corpus."}]}],"id":"blk-46111","kind":"list-item"},{"blocks":[{"id":"blk-46114","kind":"paragraph","spans":[{"id":"spn-53671","marks":["bold"],"text":"Harness name"},{"id":"spn-53672","text":": "},{"id":"spn-53673","marks":["code"],"text":"mix benchmark.memorybench"}]}],"id":"blk-46113","kind":"list-item"},{"blocks":[{"id":"blk-46116","kind":"paragraph","spans":[{"id":"spn-53674","marks":["bold"],"text":"CLI"},{"id":"spn-53675","text":": "},{"id":"spn-53676","marks":["code"],"text":"mix benchmark.memorybench --domain all --limit 100"}]}],"id":"blk-46115","kind":"list-item"},{"blocks":[{"id":"blk-46118","kind":"paragraph","spans":[{"id":"spn-53677","marks":["bold"],"text":"Why fourth"},{"id":"spn-53678","text":": Directly tests the learning loop. Published finding that no system beats RAG baseline — if Graphonomous does, that's a headline result."}]}],"id":"blk-46117","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46119","kind":"heading","level":3,"spans":[{"id":"spn-53679","text":"Session 5: LifeBench (Non-Declarative Memory)"}]},{"id":"blk-46120","items":[{"blocks":[{"id":"blk-46122","kind":"paragraph","spans":[{"id":"spn-53680","marks":["bold"],"text":"Goal ID"},{"id":"spn-53681","text":": "},{"id":"spn-53682","marks":["code"],"text":"goal_824059ff9230ff0953646ea7ac2e7d6a"}]}],"id":"blk-46121","kind":"list-item"},{"blocks":[{"id":"blk-46124","kind":"paragraph","spans":[{"id":"spn-53683","marks":["bold"],"text":"Paper"},{"id":"spn-53684","text":": https://arxiv.org/abs/2603.03781"}]}],"id":"blk-46123","kind":"list-item"},{"blocks":[{"id":"blk-46126","kind":"paragraph","spans":[{"id":"spn-53685","marks":["bold"],"text":"Dataset"},{"id":"spn-53686","text":": Long-horizon event simulations with real-world priors (surveys, maps, calendars)"}]}],"id":"blk-46125","kind":"list-item"},{"blocks":[{"id":"blk-46128","kind":"paragraph","spans":[{"id":"spn-53687","marks":["bold"],"text":"Metrics"},{"id":"spn-53688","text":": Accuracy on habitual/procedural memory inference, declarative vs non-declarative breakdown"}]}],"id":"blk-46127","kind":"list-item"},{"blocks":[{"id":"blk-46130","kind":"paragraph","spans":[{"id":"spn-53689","marks":["bold"],"text":"SOTA"},{"id":"spn-53690","text":": 55.2% (top system)"}]}],"id":"blk-46129","kind":"list-item"},{"blocks":[{"id":"blk-46132","kind":"paragraph","spans":[{"id":"spn-53691","marks":["bold"],"text":"Key challenge"},{"id":"spn-53692","text":": Tests *inferred* knowledge, not explicitly stored facts. Graphonomous procedural nodes + edge patterns may capture habitual patterns that flat stores miss. May need to extend "},{"id":"spn-53693","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-53694","text":" or add inference logic."}]}],"id":"blk-46131","kind":"list-item"},{"blocks":[{"id":"blk-46134","kind":"paragraph","spans":[{"id":"spn-53695","marks":["bold"],"text":"Harness name"},{"id":"spn-53696","text":": "},{"id":"spn-53697","marks":["code"],"text":"mix benchmark.lifebench"}]}],"id":"blk-46133","kind":"list-item"},{"blocks":[{"id":"blk-46136","kind":"paragraph","spans":[{"id":"spn-53698","marks":["bold"],"text":"CLI"},{"id":"spn-53699","text":": "},{"id":"spn-53700","marks":["code"],"text":"mix benchmark.lifebench --limit 50"}]}],"id":"blk-46135","kind":"list-item"},{"blocks":[{"id":"blk-46138","kind":"paragraph","spans":[{"id":"spn-53701","marks":["bold"],"text":"Why fifth"},{"id":"spn-53702","text":": Hardest benchmark (SOTA is 55%). Low expectations, high signal. If graph structure helps even marginally on non-declarative memory, that validates the architecture thesis."}]}],"id":"blk-46137","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46139","kind":"heading","level":3,"spans":[{"id":"spn-53703","text":"Session 6: AMemGym (On-Policy Interactive)"}]},{"id":"blk-46140","items":[{"blocks":[{"id":"blk-46142","kind":"paragraph","spans":[{"id":"spn-53704","marks":["bold"],"text":"Goal ID"},{"id":"spn-53705","text":": "},{"id":"spn-53706","marks":["code"],"text":"goal_b7ccffd9e67df8e7b42366ff24a9be82"}]}],"id":"blk-46141","kind":"list-item"},{"blocks":[{"id":"blk-46144","kind":"paragraph","spans":[{"id":"spn-53707","marks":["bold"],"text":"Paper"},{"id":"spn-53708","text":": https://arxiv.org/abs/2603.01966"}]}],"id":"blk-46143","kind":"list-item"},{"blocks":[{"id":"blk-46146","kind":"paragraph","spans":[{"id":"spn-53709","marks":["bold"],"text":"HuggingFace"},{"id":"spn-53710","text":": https://huggingface.co/datasets/AGI-Eval/AMemGym"}]}],"id":"blk-46145","kind":"list-item"},{"blocks":[{"id":"blk-46148","kind":"paragraph","spans":[{"id":"spn-53711","marks":["bold"],"text":"Dataset"},{"id":"spn-53712","text":": Interactive on-policy benchmark — agent generates its own conversation"}]}],"id":"blk-46147","kind":"list-item"},{"blocks":[{"id":"blk-46150","kind":"paragraph","spans":[{"id":"spn-53713","marks":["bold"],"text":"Metrics"},{"id":"spn-53714","text":": Structured state consistency, memory utilization, persona tracking"}]}],"id":"blk-46149","kind":"list-item"},{"blocks":[{"id":"blk-46152","kind":"paragraph","spans":[{"id":"spn-53715","marks":["bold"],"text":"Key challenge"},{"id":"spn-53716","text":": This is fundamentally different from other benchmarks. The agent must *participate* in the conversation, not just answer post-hoc questions. Requires wiring Graphonomous MCP into a simulated conversation loop with an LLM-simulated user. Most complex harness to build."}]}],"id":"blk-46151","kind":"list-item"},{"blocks":[{"id":"blk-46154","kind":"paragraph","spans":[{"id":"spn-53717","marks":["bold"],"text":"Harness name"},{"id":"spn-53718","text":": "},{"id":"spn-53719","marks":["code"],"text":"mix benchmark.amemgym"}]}],"id":"blk-46153","kind":"list-item"},{"blocks":[{"id":"blk-46156","kind":"paragraph","spans":[{"id":"spn-53720","marks":["bold"],"text":"CLI"},{"id":"spn-53721","text":": "},{"id":"spn-53722","marks":["code"],"text":"mix benchmark.amemgym --scenarios 10"}]}],"id":"blk-46155","kind":"list-item"},{"blocks":[{"id":"blk-46158","kind":"paragraph","spans":[{"id":"spn-53723","marks":["bold"],"text":"Why last"},{"id":"spn-53724","text":": Most complex integration. Requires LLM-in-the-loop (simulated user). But the most realistic test of how Graphonomous actually performs in production. Save for last when all other harnesses are proven."}]}],"id":"blk-46157","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46159","kind":"paragraph","spans":[{"id":"spn-53725","text":"---"}]},{"id":"blk-46160","kind":"heading","level":2,"spans":[{"id":"spn-53726","text":"Post-Completion"}]},{"id":"blk-46161","kind":"paragraph","spans":[{"id":"spn-53727","text":"After all 6 harnesses are built and run:"}]},{"id":"blk-46162","kind":"paragraph","spans":[{"id":"spn-53728","text":"1. Update "},{"id":"spn-53729","marks":["code"],"text":"OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-53730","text":" with a unified results table 2. Update "},{"id":"spn-53731","marks":["code"],"text":"graphonomous.com/benchmarks/"},{"id":"spn-53732","text":" pages with new benchmark results 3. Update "},{"id":"spn-53733","marks":["code"],"text":"AmpersandBoxDesign/site/portfolio-review.html"},{"id":"spn-53734","text":" competitive landscape 4. Store a comprehensive episodic node in Graphonomous summarizing the full evaluation 5. Consider adding top-line scores to "},{"id":"spn-53735","marks":["code"],"text":"graphonomous/README.md"}]},{"id":"blk-46163","kind":"paragraph","spans":[{"id":"spn-53736","text":"---"}]},{"id":"blk-46164","kind":"heading","level":2,"spans":[{"id":"spn-53737","text":"Anti-Patterns to Avoid"}]},{"id":"blk-46165","items":[{"blocks":[{"id":"blk-46167","kind":"paragraph","spans":[{"id":"spn-53738","text":"Do NOT modify "},{"id":"spn-53739","marks":["code"],"text":"retrieve_context"},{"id":"spn-53740","text":" or the retrieval pipeline to game a specific benchmark"}]}],"id":"blk-46166","kind":"list-item"},{"blocks":[{"id":"blk-46169","kind":"paragraph","spans":[{"id":"spn-53741","text":"Do NOT add benchmark-specific code paths to the core engine"}]}],"id":"blk-46168","kind":"list-item"},{"blocks":[{"id":"blk-46171","kind":"paragraph","spans":[{"id":"spn-53742","text":"Do NOT skip the smoke test ("},{"id":"spn-53743","marks":["code"],"text":"--limit 50"},{"id":"spn-53744","text":") before full runs"}]}],"id":"blk-46170","kind":"list-item"},{"blocks":[{"id":"blk-46173","kind":"paragraph","spans":[{"id":"spn-53745","text":"Do NOT fabricate competitive baselines — only cite published numbers with sources"}]}],"id":"blk-46172","kind":"list-item"},{"blocks":[{"id":"blk-46175","kind":"paragraph","spans":[{"id":"spn-53746","text":"Do NOT skip storing results in Graphonomous — the learning loop is the point"}]}],"id":"blk-46174","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieranyi35e4rlhw3dbuwscby6zefxjshjyyzd7hjodrvz2tlzyg2v3pa","vocabulary":"ampersand.docs.fs.v1"}