:"spn-101121","text":": https://arxiv.org/abs/2510.27246"}]}],"id":"blk-70130","kind":"list-item"},{"blocks":[{"id":"blk-70133","kind":"paragraph","spans":[{"id":"spn-101122","marks":["bold"],"text":"Repo"},{"id":"spn-101123","text":": https://github.com/mohammadtavakoli78/BEAM"}]}],"id":"blk-70132","kind":"list-item"},{"blocks":[{"id":"blk-70135","kind":"paragraph","spans":[{"id":"spn-101124","marks":["bold"],"text":"Dataset"},{"id":"spn-101125","text":": 100 conversations, 2,000 questions at 128K/500K/1M/10M token scales"}]}],"id":"blk-70134","kind":"list-item"},{"blocks":[{"id":"blk-70137","kind":"paragraph","spans":[{"id":"spn-101126","marks":["bold"],"text":"Metrics"},{"id":"spn-101127","text":": QA accuracy across 10 memory abilities, per-scale breakdown"}]}],"id":"blk-70136","kind":"list-item"},{"blocks":[{"id":"blk-70139","kind":"paragraph","spans":[{"id":"spn-101128","marks":["bold"],"text":"SOTA"},{"id":"spn-101129","text":": Hindsight 64.1% (10M), 73.9% (1M)"}]}],"id":"blk-70138","kind":"list-item"},{"blocks":[{"id":"blk-70141","kind":"paragraph","spans":[{"id":"spn-101130","marks":["bold"],"text":"Key challenge"},{"id":"spn-101131","text":": Multi-scale evaluation. Start with 128K tier (fits in single graph). 10M tier will stress SQLite and retrieval latency."}]}],"id":"blk-70140","kind":"list-item"},{"blocks":[{"id":"blk-70143","kind":"paragraph","spans":[{"id":"spn-101132","marks":["bold"],"text":"Harness name"},{"id":"spn-101133","text":": "},{"id":"spn-101134","marks":["code"],"text":"mix benchmark.beam"}]}],"id":"blk-70142","kind":"list-item"},{"blocks":[{"id":"blk-70145","kind":"paragraph","spans":[{"id":"spn-101135","marks":["bold"],"text":"CLI"},{"id":"spn-101136","text":": "},{"id":"spn-101137","marks":["code"],"text":"mix benchmark.beam --tier 128k --limit 50"}]}],"id":"blk-70144","kind":"list-item"},{"blocks":[{"id":"blk-70147","kind":"paragraph","spans":[{"id":"spn-101138","marks":["bold"],"text":"Why first"},{"id":"spn-101139","text":": This is the new industry standard. Every competitor reports BEAM scores. Scaling behavior is where graph memory should differentiate from flat vector stores."}]}],"id":"blk-70146","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70148","kind":"heading","level":3,"spans":[{"id":"spn-101140","text":"Session 2: MemoryAgentBench"}]},{"id":"blk-70149","items":[{"blocks":[{"id":"blk-70151","kind":"paragraph","spans":[{"id":"spn-101141","marks":["bold"],"text":"Goal ID"},{"id":"spn-101142","text":": "},{"id":"spn-101143","marks":["code"],"text":"goal_8889e094cb2b904d65f6a29cd7861f1c"}]}],"id":"blk-70150","kind":"list-item"},{"blocks":[{"id":"blk-70153","kind":"paragraph","spans":[{"id":"spn-101144","marks":["bold"],"text":"Paper"},{"id":"spn-101145","text":": https://arxiv.org/abs/2507.05257"}]}],"id":"blk-70152","kind":"list-item"},{"blocks":[{"id":"blk-70155","kind":"paragraph","spans":[{"id":"spn-101146","marks":["bold"],"text":"Repo"},{"id":"spn-101147","text":": https://github.com/HUST-AI-HYZ/MemoryAgentBench"}]}],"id":"blk-70154","kind":"list-item"},{"blocks":[{"id":"blk-70157","kind":"paragraph","spans":[{"id":"spn-101148","marks":["bold"],"text":"Dataset"},{"id":"spn-101149","text":": Multi-turn incremental format, includes EventQA and FactConsolidation"}]}],"id":"blk-70156","kind":"list-item"},{"blocks":[{"id":"blk-70159","kind":"paragraph","spans":[{"id":"spn-101150","marks":["bold"],"text":"Metrics"},{"id":"spn-101151","text":": 4 competency scores — accurate retrieval, test-time learning, long-range understanding, selective forgetting"}]}],"id":"blk-70158","kind":"list-item"},{"blocks":[{"id":"blk-70161","kind":"paragraph","spans":[{"id":"spn-101152","marks":["bold"],"text":"Key challenge"},{"id":"spn-101153","text":": Multi-turn format requires simulating incremental store→query cycles, not batch ingest. Map \"selective forgetting\" to "},{"id":"spn-101154","marks":["code"],"text":"forget_by_policy"},{"id":"spn-101155","text":" / "},{"id":"spn-101156","marks":["code"],"text":"forget_node"},{"id":"spn-101157","text":"."}]}],"id":"blk-70160","kind":"list-item"},{"blocks":[{"id":"blk-70163","kind":"paragraph","spans":[{"id":"spn-101158","marks":["bold"],"text":"Harness name"},{"id":"spn-101159","text":": "},{"id":"spn-101160","marks":["code"],"text":"mix benchmark.memoryagentbench"}]}],"id":"blk-70162","kind":"list-item"},{"blocks":[{"id":"blk-70165","kind":"paragraph","spans":[{"id":"spn-101161","marks":["bold"],"text":"CLI"},{"id":"spn-101162","text":": "},{"id":"spn-101163","marks":["code"],"text":"mix benchmark.memoryagentbench --limit 50"}]}],"id":"blk-70164","kind":"list-item"},{"blocks":[{"id":"blk-70167","kind":"paragraph","spans":[{"id":"spn-101164","marks":["bold"],"text":"Why second"},{"id":"spn-101165","text":": Directly tests Graphonomous's differentiating features (forgetting, learning loop). ICLR 2026 paper — high credibility."}]}],"id":"blk-70166","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70168","kind":"heading","level":3,"spans":[{"id":"spn-101166","text":"Session 3: LMEB (Long-horizon Memory Embedding Benchmark)"}]},{"id":"blk-70169","items":[{"blocks":[{"id":"blk-70171","kind":"paragraph","spans":[{"id":"spn-101167","marks":["bold"],"text":"Goal ID"},{"id":"spn-101168","text":": "},{"id":"spn-101169","marks":["code"],"text":"goal_81c0f91f92b9b4a52e0a38b44c49a492"}]}],"id":"blk-70170","kind":"list-item"},{"blocks":[{"id":"blk-70173","kind":"paragraph","spans":[{"id":"spn-101170","marks":["bold"],"text":"Paper"},{"id":"spn-101171","text":": https://arxiv.org/abs/2603.12572"}]}],"id":"blk-70172","kind":"list-item"},{"blocks":[{"id":"blk-70175","kind":"paragraph","spans":[{"id":"spn-101172","marks":["bold"],"text":"Repo"},{"id":"spn-101173","text":": https://github.com/KaLM-Embedding/LMEB"}]}],"id":"blk-70174","kind":"list-item"},{"blocks":[{"id":"blk-70177","kind":"paragraph","spans":[{"id":"spn-101174","marks":["bold"],"text":"HuggingFace"},{"id":"spn-101175","text":": https://huggingface.co/datasets/KaLM-Embedding/LMEB"}]}],"id":"blk-70176","kind":"list-item"},{"blocks":[{"id":"blk-70179","kind":"paragraph","spans":[{"id":"spn-101176","marks":["bold"],"text":"Dataset"},{"id":"spn-101177","text":": 22 datasets, 193 zero-shot retrieval tasks across 4 memory types (episodic, dialogue, semantic, procedural)"}]}],"id":"blk-70178","kind":"list-item"},{"blocks":[{"id":"blk-70181","kind":"paragraph","spans":[{"id":"spn-101178","marks":["bold"],"text":"Metrics"},{"id":"spn-101179","text":": Retrieval accuracy per memory type, aggregate score"}]}],"id":"blk-70180","kind":"list-item"},{"blocks":[{"id":"blk-70183","kind":"paragraph","spans":[{"id":"spn-101180","marks":["bold"],"text":"Key challenge"},{"id":"spn-101181","text":": This benchmarks the "},{"id":"spn-101182","marks":["italic"],"text":"embedding model"},{"id":"spn-101183","text":", not the full system. Run nomic-embed-text-v2-moe through the LMEB eval harness (likely Python). May need a thin Python wrapper or direct Elixir port of the eval logic."}]}],"id":"blk-70182","kind":"list-item"},{"blocks":[{"id":"blk-70185","kind":"paragraph","spans":[{"id":"spn-101184","marks":["bold"],"text":"Harness name"},{"id":"spn-101185","text":": "},{"id":"spn-101186","marks":["code"],"text":"mix benchmark.lmeb"}]}],"id":"blk-70184","kind":"list-item"},{"blocks":[{"id":"blk-70187","kind":"paragraph","spans":[{"id":"spn-101187","marks":["bold"],"text":"CLI"},{"id":"spn-101188","text":": "},{"id":"spn-101189","marks":["code"],"text":"mix benchmark.lmeb --model nomic-embed-text-v2-moe"}]}],"id":"blk-70186","kind":"list-item"},{"blocks":[{"id":"blk-70189","kind":"paragraph","spans":[{"id":"spn-101190","marks":["bold"],"text":"Why third"},{"id":"spn-101191","text":": Cheapest to run (embedding-only, no LLM judge needed). Validates the foundational layer. If nomic scores poorly on memory-specific retrieval, that's a critical finding."}]}],"id":"blk-70188","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70190","kind":"heading","level":3,"spans":[{"id":"spn-101192","text":"Session 4: MemoryBench (Continual Learning from Feedback)"}]},{"id":"blk-70191","items":[{"blocks":[{"id":"blk-70193","kind":"paragraph","spans":[{"id":"spn-101193","marks":["bold"],"text":"Goal ID"},{"id":"spn-101194","text":": "},{"id":"spn-101195","marks":["code"],"text":"goal_8ef86ae124eb2f03375289107dcac5ae"}]}],"id":"blk-70192","kind":"list-item"},{"blocks":[{"id":"blk-70195","kind":"paragraph","spans":[{"id":"spn-101196","marks":["bold"],"text":"Paper"},{"id":"spn-101197","text":": https://arxiv.org/abs/2510.17281"}]}],"id":"blk-70194","kind":"list-item"},{"blocks":[{"id":"blk-70197","kind":"paragraph","spans":[{"id":"spn-101198","marks":["bold"],"text":"Dataset"},{"id":"spn-101199","text":": User feedback simulation across multiple domains and languages"}]}],"id":"blk-70196","kind":"list-item"},{"blocks":[{"id":"blk-70199","kind":"paragraph","spans":[{"id":"spn-101200","marks":["bold"],"text":"Metrics"},{"id":"spn-101201","text":": Continual learning accuracy, feedback utilization rate, cross-domain transfer"}]}],"id":"blk-70198","kind":"list-item"},{"blocks":[{"id":"blk-70201","kind":"paragraph","spans":[{"id":"spn-101202","marks":["bold"],"text":"Key challenge"},{"id":"spn-101203","text":": Requires simulating the feedback loop — "},{"id":"spn-101204","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-101205","text":" with explicit/action-based/implicit feedback types, then re-querying to measure improvement. Multi-domain and multilingual means varied corpus."}]}],"id":"blk-70200","kind":"list-item"},{"blocks":[{"id":"blk-70203","kind":"paragraph","spans":[{"id":"spn-101206","marks":["bold"],"text":"Harness name"},{"id":"spn-101207","text":": "},{"id":"spn-101208","marks":["code"],"text":"mix benchmark.memorybench"}]}],"id":"blk-70202","kind":"list-item"},{"blocks":[{"id":"blk-70205","kind":"paragraph","spans":[{"id":"spn-101209","marks":["bold"],"text":"CLI"},{"id":"spn-101210","text":": "},{"id":"spn-101211","marks":["code"],"text":"mix benchmark.memorybench --domain all --limit 100"}]}],"id":"blk-70204","kind":"list-item"},{"blocks":[{"id":"blk-70207","kind":"paragraph","spans":[{"id":"spn-101212","marks":["bold"],"text":"Why fourth"},{"id":"spn-101213","text":": Directly tests the learning loop. Published finding that no system beats RAG baseline — if Graphonomous does, that's a headline result."}]}],"id":"blk-70206","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70208","kind":"heading","level":3,"spans":[{"id":"spn-101214","text":"Session 5: LifeBench (Non-Declarative Memory)"}]},{"id":"blk-70209","items":[{"blocks":[{"id":"blk-70211","kind":"paragraph","spans":[{"id":"spn-101215","marks":["bold"],"text":"Goal ID"},{"id":"spn-101216","text":": "},{"id":"spn-101217","marks":["code"],"text":"goal_824059ff9230ff0953646ea7ac2e7d6a"}]}],"id":"blk-70210","kind":"list-item"},{"blocks":[{"id":"blk-70213","kind":"paragraph","spans":[{"id":"spn-101218","marks":["bold"],"text":"Paper"},{"id":"spn-101219","text":": https://arxiv.org/abs/2603.03781"}]}],"id":"blk-70212","kind":"list-item"},{"blocks":[{"id":"blk-70215","kind":"paragraph","spans":[{"id":"spn-101220","marks":["bold"],"text":"Dataset"},{"id":"spn-101221","text":": Long-horizon event simulations with real-world priors (surveys, maps, calendars)"}]}],"id":"blk-70214","kind":"list-item"},{"blocks":[{"id":"blk-70217","kind":"paragraph","spans":[{"id":"spn-101222","marks":["bold"],"text":"Metrics"},{"id":"spn-101223","text":": Accuracy on habitual/procedural memory inference, declarative vs non-declarative breakdown"}]}],"id":"blk-70216","kind":"list-item"},{"blocks":[{"id":"blk-70219","kind":"paragraph","spans":[{"id":"spn-101224","marks":["bold"],"text":"SOTA"},{"id":"spn-101225","text":": 55.2% (top system)"}]}],"id":"blk-70218","kind":"list-item"},{"blocks":[{"id":"blk-70221","kind":"paragraph","spans":[{"id":"spn-101226","marks":["bold"],"text":"Key challenge"},{"id":"spn-101227","text":": Tests "},{"id":"spn-101228","marks":["italic"],"text":"inferred"},{"id":"spn-101229","text":" knowledge, not explicitly stored facts. Graphonomous procedural nodes + edge patterns may capture habitual patterns that flat stores miss. May need to extend "},{"id":"spn-101230","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101231","text":" or add inference logic."}]}],"id":"blk-70220","kind":"list-item"},{"blocks":[{"id":"blk-70223","kind":"paragraph","spans":[{"id":"spn-101232","marks":["bold"],"text":"Harness name"},{"id":"spn-101233","text":": "},{"id":"spn-101234","marks":["code"],"text":"mix benchmark.lifebench"}]}],"id":"blk-70222","kind":"list-item"},{"blocks":[{"id":"blk-70225","kind":"paragraph","spans":[{"id":"spn-101235","marks":["bold"],"text":"CLI"},{"id":"spn-101236","text":": "},{"id":"spn-101237","marks":["code"],"text":"mix benchmark.lifebench --limit 50"}]}],"id":"blk-70224","kind":"list-item"},{"blocks":[{"id":"blk-70227","kind":"paragraph","spans":[{"id":"spn-101238","marks":["bold"],"text":"Why fifth"},{"id":"spn-101239","text":": Hardest benchmark (SOTA is 55%). Low expectations, high signal. If graph structure helps even marginally on non-declarative memory, that validates the architecture thesis."}]}],"id":"blk-70226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70228","kind":"heading","level":3,"spans":[{"id":"spn-101240","text":"Session 6: AMemGym (On-Policy Interactive)"}]},{"id":"blk-70229","items":[{"blocks":[{"id":"blk-70231","kind":"paragraph","spans":[{"id":"spn-101241","marks":["bold"],"text":"Goal ID"},{"id":"spn-101242","text":": "},{"id":"spn-101243","marks":["code"],"text":"goal_b7ccffd9e67df8e7b42366ff24a9be82"}]}],"id":"blk-70230","kind":"list-item"},{"blocks":[{"id":"blk-70233","kind":"paragraph","spans":[{"id":"spn-101244","marks":["bold"],"text":"Paper"},{"id":"spn-101245","text":": https://arxiv.org/abs/2603.01966"}]}],"id":"blk-70232","kind":"list-item"},{"blocks":[{"id":"blk-70235","kind":"paragraph","spans":[{"id":"spn-101246","marks":["bold"],"text":"HuggingFace"},{"id":"spn-101247","text":": https://huggingface.co/datasets/AGI-Eval/AMemGym"}]}],"id":"blk-70234","kind":"list-item"},{"blocks":[{"id":"blk-70237","kind":"paragraph","spans":[{"id":"spn-101248","marks":["bold"],"text":"Dataset"},{"id":"spn-101249","text":": Interactive on-policy benchmark — agent generates its own conversation"}]}],"id":"blk-70236","kind":"list-item"},{"blocks":[{"id":"blk-70239","kind":"paragraph","spans":[{"id":"spn-101250","marks":["bold"],"text":"Metrics"},{"id":"spn-101251","text":": Structured state consistency, memory utilization, persona tracking"}]}],"id":"blk-70238","kind":"list-item"},{"blocks":[{"id":"blk-70241","kind":"paragraph","spans":[{"id":"spn-101252","marks":["bold"],"text":"Key challenge"},{"id":"spn-101253","text":": This is fundamentally different from other benchmarks. The agent must "},{"id":"spn-101254","marks":["italic"],"text":"participate"},{"id":"spn-101255","text":" in the conversation, not just answer post-hoc questions. Requires wiring Graphonomous MCP into a simulated conversation loop with an LLM-simulated user. Most complex harness to build."}]}],"id":"blk-70240","kind":"list-item"},{"blocks":[{"id":"blk-70243","kind":"paragraph","spans":[{"id":"spn-101256","marks":["bold"],"text":"Harness name"},{"id":"spn-101257","text":": "},{"id":"spn-101258","marks":["code"],"text":"mix benchmark.amemgym"}]}],"id":"blk-70242","kind":"list-item"},{"blocks":[{"id":"blk-70245","kind":"paragraph","spans":[{"id":"spn-101259","marks":["bold"],"text":"CLI"},{"id":"spn-101260","text":": "},{"id":"spn-101261","marks":["code"],"text":"mix benchmark.amemgym --scenarios 10"}]}],"id":"blk-70244","kind":"list-item"},{"blocks":[{"id":"blk-70247","kind":"paragraph","spans":[{"id":"spn-101262","marks":["bold"],"text":"Why last"},{"id":"spn-101263","text":": Most complex integration. Requires LLM-in-the-loop (simulated user). But the most realistic test of how Graphonomous actually performs in production. Save for last when all other harnesses are proven."}]}],"id":"blk-70246","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70248","kind":"heading","level":2,"spans":[{"id":"spn-101264","text":"Post-Completion"}]},{"id":"blk-70249","kind":"paragraph","spans":[{"id":"spn-101265","text":"After all 6 harnesses are built and run:"}]},{"id":"blk-70250","items":[{"blocks":[{"id":"blk-70252","kind":"paragraph","spans":[{"id":"spn-101266","text":"Update "},{"id":"spn-101267","marks":["code"],"text":"OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-101268","text":" with a unified results table"}]}],"id":"blk-70251","kind":"list-item"},{"blocks":[{"id":"blk-70254","kind":"paragraph","spans":[{"id":"spn-101269","text":"Update "},{"id":"spn-101270","marks":["code"],"text":"graphonomous.com/benchmarks/"},{"id":"spn-101271","text":" pages with new benchmark results"}]}],"id":"blk-70253","kind":"list-item"},{"blocks":[{"id":"blk-70256","kind":"paragraph","spans":[{"id":"spn-101272","text":"Update "},{"id":"spn-101273","marks":["code"],"text":"AmpersandBoxDesign/site/portfolio-review.html"},{"id":"spn-101274","text":" competitive landscape"}]}],"id":"blk-70255","kind":"list-item"},{"blocks":[{"id":"blk-70258","kind":"paragraph","spans":[{"id":"spn-101275","text":"Store a comprehensive episodic node in Graphonomous summarizing the full evaluation"}]}],"id":"blk-70257","kind":"list-item"},{"blocks":[{"id":"blk-70260","kind":"paragraph","spans":[{"id":"spn-101276","text":"Consider adding top-line scores to "},{"id":"spn-101277","marks":["code"],"text":"graphonomous/README.md"}]}],"id":"blk-70259","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-70261","kind":"heading","level":2,"spans":[{"id":"spn-101278","text":"Anti-Patterns to Avoid"}]},{"id":"blk-70262","items":[{"blocks":[{"id":"blk-70264","kind":"paragraph","spans":[{"id":"spn-101279","text":"Do NOT modify "},{"id":"spn-101280","marks":["code"],"text":"retrieve_context"},{"id":"spn-101281","text":" or the retrieval pipeline to game a specific benchmark"}]}],"id":"blk-70263","kind":"list-item"},{"blocks":[{"id":"blk-70266","kind":"paragraph","spans":[{"id":"spn-101282","text":"Do NOT add benchmark-specific code paths to the core engine"}]}],"id":"blk-70265","kind":"list-item"},{"blocks":[{"id":"blk-70268","kind":"paragraph","spans":[{"id":"spn-101283","text":"Do NOT skip the smoke test ("},{"id":"spn-101284","marks":["code"],"text":"--limit 50"},{"id":"spn-101285","text":") before full runs"}]}],"id":"blk-70267","kind":"list-item"},{"blocks":[{"id":"blk-70270","kind":"paragraph","spans":[{"id":"spn-101286","text":"Do NOT fabricate competitive baselines — only cite published numbers with sources"}]}],"id":"blk-70269","kind":"list-item"},{"blocks":[{"id":"blk-70272","kind":"paragraph","spans":[{"id":"spn-101287","text":"Do NOT skip storing results in Graphonomous — the learning loop is the point"}]}],"id":"blk-70271","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera2t2rbcafkqpj76enikei7alf7a5jikwnqm3l2cc3ri4jj4xmmybq","vocabulary":"ampersand.docs.fs.v1"}