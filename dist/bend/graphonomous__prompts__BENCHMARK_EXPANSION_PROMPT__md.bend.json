d":"blk-71155","kind":"heading","level":3,"spans":[{"id":"spn-104006","text":"Session 4: MemoryBench (Continual Learning from Feedback)"}]},{"id":"blk-71156","items":[{"blocks":[{"id":"blk-71158","kind":"paragraph","spans":[{"id":"spn-104007","marks":["bold"],"text":"Goal ID"},{"id":"spn-104008","text":": "},{"id":"spn-104009","marks":["code"],"text":"goal_8ef86ae124eb2f03375289107dcac5ae"}]}],"id":"blk-71157","kind":"list-item"},{"blocks":[{"id":"blk-71160","kind":"paragraph","spans":[{"id":"spn-104010","marks":["bold"],"text":"Paper"},{"id":"spn-104011","text":": https://arxiv.org/abs/2510.17281"}]}],"id":"blk-71159","kind":"list-item"},{"blocks":[{"id":"blk-71162","kind":"paragraph","spans":[{"id":"spn-104012","marks":["bold"],"text":"Dataset"},{"id":"spn-104013","text":": User feedback simulation across multiple domains and languages"}]}],"id":"blk-71161","kind":"list-item"},{"blocks":[{"id":"blk-71164","kind":"paragraph","spans":[{"id":"spn-104014","marks":["bold"],"text":"Metrics"},{"id":"spn-104015","text":": Continual learning accuracy, feedback utilization rate, cross-domain transfer"}]}],"id":"blk-71163","kind":"list-item"},{"blocks":[{"id":"blk-71166","kind":"paragraph","spans":[{"id":"spn-104016","marks":["bold"],"text":"Key challenge"},{"id":"spn-104017","text":": Requires simulating the feedback loop — "},{"id":"spn-104018","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-104019","text":" with explicit/action-based/implicit feedback types, then re-querying to measure improvement. Multi-domain and multilingual means varied corpus."}]}],"id":"blk-71165","kind":"list-item"},{"blocks":[{"id":"blk-71168","kind":"paragraph","spans":[{"id":"spn-104020","marks":["bold"],"text":"Harness name"},{"id":"spn-104021","text":": "},{"id":"spn-104022","marks":["code"],"text":"mix benchmark.memorybench"}]}],"id":"blk-71167","kind":"list-item"},{"blocks":[{"id":"blk-71170","kind":"paragraph","spans":[{"id":"spn-104023","marks":["bold"],"text":"CLI"},{"id":"spn-104024","text":": "},{"id":"spn-104025","marks":["code"],"text":"mix benchmark.memorybench --domain all --limit 100"}]}],"id":"blk-71169","kind":"list-item"},{"blocks":[{"id":"blk-71172","kind":"paragraph","spans":[{"id":"spn-104026","marks":["bold"],"text":"Why fourth"},{"id":"spn-104027","text":": Directly tests the learning loop. Published finding that no system beats RAG baseline — if Graphonomous does, that's a headline result."}]}],"id":"blk-71171","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71173","kind":"heading","level":3,"spans":[{"id":"spn-104028","text":"Session 5: LifeBench (Non-Declarative Memory)"}]},{"id":"blk-71174","items":[{"blocks":[{"id":"blk-71176","kind":"paragraph","spans":[{"id":"spn-104029","marks":["bold"],"text":"Goal ID"},{"id":"spn-104030","text":": "},{"id":"spn-104031","marks":["code"],"text":"goal_824059ff9230ff0953646ea7ac2e7d6a"}]}],"id":"blk-71175","kind":"list-item"},{"blocks":[{"id":"blk-71178","kind":"paragraph","spans":[{"id":"spn-104032","marks":["bold"],"text":"Paper"},{"id":"spn-104033","text":": https://arxiv.org/abs/2603.03781"}]}],"id":"blk-71177","kind":"list-item"},{"blocks":[{"id":"blk-71180","kind":"paragraph","spans":[{"id":"spn-104034","marks":["bold"],"text":"Dataset"},{"id":"spn-104035","text":": Long-horizon event simulations with real-world priors (surveys, maps, calendars)"}]}],"id":"blk-71179","kind":"list-item"},{"blocks":[{"id":"blk-71182","kind":"paragraph","spans":[{"id":"spn-104036","marks":["bold"],"text":"Metrics"},{"id":"spn-104037","text":": Accuracy on habitual/procedural memory inference, declarative vs non-declarative breakdown"}]}],"id":"blk-71181","kind":"list-item"},{"blocks":[{"id":"blk-71184","kind":"paragraph","spans":[{"id":"spn-104038","marks":["bold"],"text":"SOTA"},{"id":"spn-104039","text":": 55.2% (top system)"}]}],"id":"blk-71183","kind":"list-item"},{"blocks":[{"id":"blk-71186","kind":"paragraph","spans":[{"id":"spn-104040","marks":["bold"],"text":"Key challenge"},{"id":"spn-104041","text":": Tests "},{"id":"spn-104042","marks":["italic"],"text":"inferred"},{"id":"spn-104043","text":" knowledge, not explicitly stored facts. Graphonomous procedural nodes + edge patterns may capture habitual patterns that flat stores miss. May need to extend "},{"id":"spn-104044","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-104045","text":" or add inference logic."}]}],"id":"blk-71185","kind":"list-item"},{"blocks":[{"id":"blk-71188","kind":"paragraph","spans":[{"id":"spn-104046","marks":["bold"],"text":"Harness name"},{"id":"spn-104047","text":": "},{"id":"spn-104048","marks":["code"],"text":"mix benchmark.lifebench"}]}],"id":"blk-71187","kind":"list-item"},{"blocks":[{"id":"blk-71190","kind":"paragraph","spans":[{"id":"spn-104049","marks":["bold"],"text":"CLI"},{"id":"spn-104050","text":": "},{"id":"spn-104051","marks":["code"],"text":"mix benchmark.lifebench --limit 50"}]}],"id":"blk-71189","kind":"list-item"},{"blocks":[{"id":"blk-71192","kind":"paragraph","spans":[{"id":"spn-104052","marks":["bold"],"text":"Why fifth"},{"id":"spn-104053","text":": Hardest benchmark (SOTA is 55%). Low expectations, high signal. If graph structure helps even marginally on non-declarative memory, that validates the architecture thesis."}]}],"id":"blk-71191","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71193","kind":"heading","level":3,"spans":[{"id":"spn-104054","text":"Session 6: AMemGym (On-Policy Interactive)"}]},{"id":"blk-71194","items":[{"blocks":[{"id":"blk-71196","kind":"paragraph","spans":[{"id":"spn-104055","marks":["bold"],"text":"Goal ID"},{"id":"spn-104056","text":": "},{"id":"spn-104057","marks":["code"],"text":"goal_b7ccffd9e67df8e7b42366ff24a9be82"}]}],"id":"blk-71195","kind":"list-item"},{"blocks":[{"id":"blk-71198","kind":"paragraph","spans":[{"id":"spn-104058","marks":["bold"],"text":"Paper"},{"id":"spn-104059","text":": https://arxiv.org/abs/2603.01966"}]}],"id":"blk-71197","kind":"list-item"},{"blocks":[{"id":"blk-71200","kind":"paragraph","spans":[{"id":"spn-104060","marks":["bold"],"text":"HuggingFace"},{"id":"spn-104061","text":": https://huggingface.co/datasets/AGI-Eval/AMemGym"}]}],"id":"blk-71199","kind":"list-item"},{"blocks":[{"id":"blk-71202","kind":"paragraph","spans":[{"id":"spn-104062","marks":["bold"],"text":"Dataset"},{"id":"spn-104063","text":": Interactive on-policy benchmark — agent generates its own conversation"}]}],"id":"blk-71201","kind":"list-item"},{"blocks":[{"id":"blk-71204","kind":"paragraph","spans":[{"id":"spn-104064","marks":["bold"],"text":"Metrics"},{"id":"spn-104065","text":": Structured state consistency, memory utilization, persona tracking"}]}],"id":"blk-71203","kind":"list-item"},{"blocks":[{"id":"blk-71206","kind":"paragraph","spans":[{"id":"spn-104066","marks":["bold"],"text":"Key challenge"},{"id":"spn-104067","text":": This is fundamentally different from other benchmarks. The agent must "},{"id":"spn-104068","marks":["italic"],"text":"participate"},{"id":"spn-104069","text":" in the conversation, not just answer post-hoc questions. Requires wiring Graphonomous MCP into a simulated conversation loop with an LLM-simulated user. Most complex harness to build."}]}],"id":"blk-71205","kind":"list-item"},{"blocks":[{"id":"blk-71208","kind":"paragraph","spans":[{"id":"spn-104070","marks":["bold"],"text":"Harness name"},{"id":"spn-104071","text":": "},{"id":"spn-104072","marks":["code"],"text":"mix benchmark.amemgym"}]}],"id":"blk-71207","kind":"list-item"},{"blocks":[{"id":"blk-71210","kind":"paragraph","spans":[{"id":"spn-104073","marks":["bold"],"text":"CLI"},{"id":"spn-104074","text":": "},{"id":"spn-104075","marks":["code"],"text":"mix benchmark.amemgym --scenarios 10"}]}],"id":"blk-71209","kind":"list-item"},{"blocks":[{"id":"blk-71212","kind":"paragraph","spans":[{"id":"spn-104076","marks":["bold"],"text":"Why last"},{"id":"spn-104077","text":": Most complex integration. Requires LLM-in-the-loop (simulated user). But the most realistic test of how Graphonomous actually performs in production. Save for last when all other harnesses are proven."}]}],"id":"blk-71211","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71213","kind":"heading","level":2,"spans":[{"id":"spn-104078","text":"Post-Completion"}]},{"id":"blk-71214","kind":"paragraph","spans":[{"id":"spn-104079","text":"After all 6 harnesses are built and run:"}]},{"id":"blk-71215","items":[{"blocks":[{"id":"blk-71217","kind":"paragraph","spans":[{"id":"spn-104080","text":"Update "},{"id":"spn-104081","marks":["code"],"text":"OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-104082","text":" with a unified results table"}]}],"id":"blk-71216","kind":"list-item"},{"blocks":[{"id":"blk-71219","kind":"paragraph","spans":[{"id":"spn-104083","text":"Update "},{"id":"spn-104084","marks":["code"],"text":"graphonomous.com/benchmarks/"},{"id":"spn-104085","text":" pages with new benchmark results"}]}],"id":"blk-71218","kind":"list-item"},{"blocks":[{"id":"blk-71221","kind":"paragraph","spans":[{"id":"spn-104086","text":"Update "},{"id":"spn-104087","marks":["code"],"text":"AmpersandBoxDesign/site/portfolio-review.html"},{"id":"spn-104088","text":" competitive landscape"}]}],"id":"blk-71220","kind":"list-item"},{"blocks":[{"id":"blk-71223","kind":"paragraph","spans":[{"id":"spn-104089","text":"Store a comprehensive episodic node in Graphonomous summarizing the full evaluation"}]}],"id":"blk-71222","kind":"list-item"},{"blocks":[{"id":"blk-71225","kind":"paragraph","spans":[{"id":"spn-104090","text":"Consider adding top-line scores to "},{"id":"spn-104091","marks":["code"],"text":"graphonomous/README.md"}]}],"id":"blk-71224","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71226","kind":"heading","level":2,"spans":[{"id":"spn-104092","text":"Anti-Patterns to Avoid"}]},{"id":"blk-71227","items":[{"blocks":[{"id":"blk-71229","kind":"paragraph","spans":[{"id":"spn-104093","text":"Do NOT modify "},{"id":"spn-104094","marks":["code"],"text":"retrieve_context"},{"id":"spn-104095","text":" or the retrieval pipeline to game a specific benchmark"}]}],"id":"blk-71228","kind":"list-item"},{"blocks":[{"id":"blk-71231","kind":"paragraph","spans":[{"id":"spn-104096","text":"Do NOT add benchmark-specific code paths to the core engine"}]}],"id":"blk-71230","kind":"list-item"},{"blocks":[{"id":"blk-71233","kind":"paragraph","spans":[{"id":"spn-104097","text":"Do NOT skip the smoke test ("},{"id":"spn-104098","marks":["code"],"text":"--limit 50"},{"id":"spn-104099","text":") before full runs"}]}],"id":"blk-71232","kind":"list-item"},{"blocks":[{"id":"blk-71235","kind":"paragraph","spans":[{"id":"spn-104100","text":"Do NOT fabricate competitive baselines — only cite published numbers with sources"}]}],"id":"blk-71234","kind":"list-item"},{"blocks":[{"id":"blk-71237","kind":"paragraph","spans":[{"id":"spn-104101","text":"Do NOT skip storing results in Graphonomous — the learning loop is the point"}]}],"id":"blk-71236","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierask63m44wmtkpwyhphf6wb5lmlbt6bkjkps33t6bi5pud3zgspgfa","vocabulary":"ampersand.docs.fs.v1"}