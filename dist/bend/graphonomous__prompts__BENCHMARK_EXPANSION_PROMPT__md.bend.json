{"bendscript":"0.1","blocks":[{"id":"blk-45017","kind":"heading","level":1,"spans":[{"id":"spn-51199","text":"Benchmark Expansion Prompt — Graphonomous v0.3.3+"}]},{"id":"blk-45018","kind":"paragraph","spans":[{"id":"spn-51200","text":"Use this prompt to build benchmark harnesses for Graphonomous one-by-one across chat sessions. Each session tackles one benchmark. The order below is the recommended build sequence (highest ROI first)."}]},{"id":"blk-45019","kind":"paragraph","spans":[{"id":"spn-51201","text":"---"}]},{"id":"blk-45020","kind":"heading","level":2,"spans":[{"id":"spn-51202","text":"Context"}]},{"id":"blk-45021","kind":"paragraph","spans":[{"id":"spn-51203","text":"Graphonomous already has two benchmark harnesses:"}]},{"id":"blk-45022","items":[{"blocks":[{"id":"blk-45024","kind":"paragraph","spans":[{"id":"spn-51204","marks":["code"],"text":"lib/mix/tasks/benchmark/longmemeval.ex"},{"id":"spn-51205","text":" — LongMemEval (ICLR 2025), 500 questions, 92.6% QA proxy"}]}],"id":"blk-45023","kind":"list-item"},{"blocks":[{"id":"blk-45026","kind":"paragraph","spans":[{"id":"spn-51206","marks":["code"],"text":"lib/mix/tasks/benchmark/graphmembench.ex"},{"id":"spn-51207","text":" — GraphMemBench, 120 scenarios, 100% pass"}]}],"id":"blk-45025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45027","kind":"paragraph","spans":[{"id":"spn-51208","text":"Shared infrastructure:"}]},{"id":"blk-45028","items":[{"blocks":[{"id":"blk-45030","kind":"paragraph","spans":[{"id":"spn-51209","marks":["code"],"text":"lib/mix/tasks/benchmark/helpers.ex"},{"id":"spn-51210","text":" — corpus loading, timing, metrics, JSON output"}]}],"id":"blk-45029","kind":"list-item"},{"blocks":[{"id":"blk-45032","kind":"paragraph","spans":[{"id":"spn-51211","marks":["code"],"text":"lib/mix/tasks/benchmark/llm_judge.ex"},{"id":"spn-51212","text":" — LLM-free evaluation helpers"}]}],"id":"blk-45031","kind":"list-item"},{"blocks":[{"id":"blk-45034","kind":"paragraph","spans":[{"id":"spn-51213","marks":["code"],"text":"lib/mix/tasks/benchmark/run.ex"},{"id":"spn-51214","text":" — full suite orchestrator"}]}],"id":"blk-45033","kind":"list-item"},{"blocks":[{"id":"blk-45036","kind":"paragraph","spans":[{"id":"spn-51215","text":"Benchmark data lives in "},{"id":"spn-51216","marks":["code"],"text":"priv/<benchmark_name>/"}]}],"id":"blk-45035","kind":"list-item"},{"blocks":[{"id":"blk-45038","kind":"paragraph","spans":[{"id":"spn-51217","text":"Results are written as JSON to "},{"id":"spn-51218","marks":["code"],"text":"priv/<benchmark_name>/"},{"id":"spn-51219","text":" with timestamps"}]}],"id":"blk-45037","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45039","kind":"paragraph","spans":[{"id":"spn-51220","text":"Pattern for each new harness: 1. Create "},{"id":"spn-51221","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-51222","text":" to fetch dataset 2. Create "},{"id":"spn-51223","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-51224","text":" as a Mix task 3. Add the phase to "},{"id":"spn-51225","marks":["code"],"text":"run.ex"},{"id":"spn-51226","text":" orchestrator 4. Run, measure, record results 5. Update "},{"id":"spn-51227","marks":["code"],"text":"opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-51228","text":" with findings 6. Store results in Graphonomous via "},{"id":"spn-51229","marks":["code"],"text":"learn_from_outcome"}]},{"id":"blk-45040","kind":"paragraph","spans":[{"id":"spn-51230","text":"---"}]},{"id":"blk-45041","kind":"heading","level":2,"spans":[{"id":"spn-51231","text":"Session Instructions"}]},{"id":"blk-45042","kind":"paragraph","spans":[{"id":"spn-51232","text":"At the start of each session, paste this prompt and say:"}]},{"blocks":[{"id":"blk-45044","kind":"paragraph","spans":[{"id":"spn-51233","marks":["bold"],"text":"\"Build the benchmark harness for [BENCHMARK_NAME].\""}]}],"id":"blk-45043","kind":"quote"},{"id":"blk-45045","kind":"paragraph","spans":[{"id":"spn-51234","text":"The agent should:"}]},{"id":"blk-45046","kind":"paragraph","spans":[{"id":"spn-51235","text":"1. "},{"id":"spn-51236","marks":["bold"],"text":"Bootstrap Graphonomous"},{"id":"spn-51237","text":" — retrieve context for the benchmark goal and any prior benchmark work 2. "},{"id":"spn-51238","marks":["bold"],"text":"Transition the goal"},{"id":"spn-51239","text":" from "},{"id":"spn-51240","marks":["code"],"text":"proposed"},{"id":"spn-51241","text":" → "},{"id":"spn-51242","marks":["code"],"text":"active"},{"id":"spn-51243","text":" 3. "},{"id":"spn-51244","marks":["bold"],"text":"Research the benchmark"},{"id":"spn-51245","text":" — read the paper/repo, understand dataset format, evaluation metrics, and scoring methodology 4. "},{"id":"spn-51246","marks":["bold"],"text":"Download/prepare data"},{"id":"spn-51247","text":" — create "},{"id":"spn-51248","marks":["code"],"text":"priv/<name>/download.sh"},{"id":"spn-51249","text":" and fetch the dataset 5. "},{"id":"spn-51250","marks":["bold"],"text":"Build the harness"},{"id":"spn-51251","text":" — create "},{"id":"spn-51252","marks":["code"],"text":"lib/mix/tasks/benchmark/<name>.ex"},{"id":"spn-51253","text":" following the longmemeval.ex pattern:"}]},{"id":"blk-45047","items":[{"blocks":[{"id":"blk-45049","kind":"paragraph","spans":[{"id":"spn-51254","marks":["code"],"text":"use Mix.Task"},{"id":"spn-51255","text":" with "},{"id":"spn-51256","marks":["code"],"text":"@shortdoc"}]}],"id":"blk-45048","kind":"list-item"},{"blocks":[{"id":"blk-45051","kind":"paragraph","spans":[{"id":"spn-51257","text":"Parse CLI options ("},{"id":"spn-51258","marks":["code"],"text":"--limit"},{"id":"spn-51259","text":", "},{"id":"spn-51260","marks":["code"],"text":"--purge"},{"id":"spn-51261","text":", "},{"id":"spn-51262","marks":["code"],"text":"--neural"},{"id":"spn-51263","text":", "},{"id":"spn-51264","marks":["code"],"text":"--skip-ingest"},{"id":"spn-51265","text":")"}]}],"id":"blk-45050","kind":"list-item"},{"blocks":[{"id":"blk-45053","kind":"paragraph","spans":[{"id":"spn-51266","text":"Ingest benchmark data into a fresh Graphonomous graph"}]}],"id":"blk-45052","kind":"list-item"},{"blocks":[{"id":"blk-45055","kind":"paragraph","spans":[{"id":"spn-51267","text":"Run queries through "},{"id":"spn-51268","marks":["code"],"text":"retrieve_context"},{"id":"spn-51269","text":" (and other MCP tools as needed)"}]}],"id":"blk-45054","kind":"list-item"},{"blocks":[{"id":"blk-45057","kind":"paragraph","spans":[{"id":"spn-51270","text":"Score results using the benchmark's official metrics"}]}],"id":"blk-45056","kind":"list-item"},{"blocks":[{"id":"blk-45059","kind":"paragraph","spans":[{"id":"spn-51271","text":"Output competitive comparison table"}]}],"id":"blk-45058","kind":"list-item"},{"blocks":[{"id":"blk-45061","kind":"paragraph","spans":[{"id":"spn-51272","text":"Write results JSON to "},{"id":"spn-51273","marks":["code"],"text":"priv/<name>/"}]}],"id":"blk-45060","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45062","kind":"paragraph","spans":[{"id":"spn-51274","text":"6. "},{"id":"spn-51275","marks":["bold"],"text":"Wire into run.ex"},{"id":"spn-51276","text":" — add the new phase to the orchestrator 7. "},{"id":"spn-51277","marks":["bold"],"text":"Run the benchmark"},{"id":"spn-51278","text":" — execute with "},{"id":"spn-51279","marks":["code"],"text":"--limit 50"},{"id":"spn-51280","text":" first for a smoke test, then full run 8. "},{"id":"spn-51281","marks":["bold"],"text":"Record results"},{"id":"spn-51282","text":" — update OS-E001 evaluation doc, store in Graphonomous 9. "},{"id":"spn-51283","marks":["bold"],"text":"Update goal progress"},{"id":"spn-51284","text":" — set to 1.0 and transition to "},{"id":"spn-51285","marks":["code"],"text":"done"},{"id":"spn-51286","text":" if passing"}]},{"id":"blk-45063","kind":"paragraph","spans":[{"id":"spn-51287","text":"---"}]},{"id":"blk-45064","kind":"heading","level":2,"spans":[{"id":"spn-51288","text":"Benchmark Build Order"}]},{"id":"blk-45065","kind":"heading","level":3,"spans":[{"id":"spn-51289","text":"Session 1: BEAM (Beyond a Million Tokens)"}]},{"id":"blk-45066","items":[{"blocks":[{"id":"blk-45068","kind":"paragraph","spans":[{"id":"spn-51290","marks":["bold"],"text":"Goal ID"},{"id":"spn-51291","text":": "},{"id":"spn-51292","marks":["code"],"text":"goal_5e547ffb6d10787cae8d9a57a9f217f8"}]}],"id":"blk-45067","kind":"list-item"},{"blocks":[{"id":"blk-45070","kind":"paragraph","spans":[{"id":"spn-51293","marks":["bold"],"text":"Paper"},{"id":"spn-51294","text":": https://arxiv.org/abs/2510.27246"}]}],"id":"blk-45069","kind":"list-item"},{"blocks":[{"id":"blk-45072","kind":"paragraph","spans":[{"id":"spn-51295","marks":["bold"],"text":"Repo"},{"id":"spn-51296","text":": https://github.com/mohammadtavakoli78/BEAM"}]}],"id":"blk-45071","kind":"list-item"},{"blocks":[{"id":"blk-45074","kind":"paragraph","spans":[{"id":"spn-51297","marks":["bold"],"text":"Dataset"},{"id":"spn-51298","text":": 100 conversations, 2,000 questions at 128K/500K/1M/10M token scales"}]}],"id":"blk-45073","kind":"list-item"},{"blocks":[{"id":"blk-45076","kind":"paragraph","spans":[{"id":"spn-51299","marks":["bold"],"text":"Metrics"},{"id":"spn-51300","text":": QA accuracy across 10 memory abilities, per-scale breakdown"}]}],"id":"blk-45075","kind":"list-item"},{"blocks":[{"id":"blk-45078","kind":"paragraph","spans":[{"id":"spn-51301","marks":["bold"],"text":"SOTA"},{"id":"spn-51302","text":": Hindsight 64.1% (10M), 73.9% (1M)"}]}],"id":"blk-45077","kind":"list-item"},{"blocks":[{"id":"blk-45080","kind":"paragraph","spans":[{"id":"spn-51303","marks":["bold"],"text":"Key challenge"},{"id":"spn-51304","text":": Multi-scale evaluation. Start with 128K tier (fits in single graph). 10M tier will stress SQLite and retrieval latency."}]}],"id":"blk-45079","kind":"list-item"},{"blocks":[{"id":"blk-45082","kind":"paragraph","spans":[{"id":"spn-51305","marks":["bold"],"text":"Harness name"},{"id":"spn-51306","text":": "},{"id":"spn-51307","marks":["code"],"text":"mix benchmark.beam"}]}],"id":"blk-45081","kind":"list-item"},{"blocks":[{"id":"blk-45084","kind":"paragraph","spans":[{"id":"spn-51308","marks":["bold"],"text":"CLI"},{"id":"spn-51309","text":": "},{"id":"spn-51310","marks":["code"],"text":"mix benchmark.beam --tier 128k --limit 50"}]}],"id":"blk-45083","kind":"list-item"},{"blocks":[{"id":"blk-45086","kind":"paragraph","spans":[{"id":"spn-51311","marks":["bold"],"text":"Why first"},{"id":"spn-51312","text":": This is the new industry standard. Every competitor reports BEAM scores. Scaling behavior is where graph memory should differentiate from flat vector stores."}]}],"id":"blk-45085","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45087","kind":"heading","level":3,"spans":[{"id":"spn-51313","text":"Session 2: MemoryAgentBench"}]},{"id":"blk-45088","items":[{"blocks":[{"id":"blk-45090","kind":"paragraph","spans":[{"id":"spn-51314","marks":["bold"],"text":"Goal ID"},{"id":"spn-51315","text":": "},{"id":"spn-51316","marks":["code"],"text":"goal_8889e094cb2b904d65f6a29cd7861f1c"}]}],"id":"blk-45089","kind":"list-item"},{"blocks":[{"id":"blk-45092","kind":"paragraph","spans":[{"id":"spn-51317","marks":["bold"],"text":"Paper"},{"id":"spn-51318","text":": https://arxiv.org/abs/2507.05257"}]}],"id":"blk-45091","kind":"list-item"},{"blocks":[{"id":"blk-45094","kind":"paragraph","spans":[{"id":"spn-51319","marks":["bold"],"text":"Repo"},{"id":"spn-51320","text":": https://github.com/HUST-AI-HYZ/MemoryAgentBench"}]}],"id":"blk-45093","kind":"list-item"},{"blocks":[{"id":"blk-45096","kind":"paragraph","spans":[{"id":"spn-51321","marks":["bold"],"text":"Dataset"},{"id":"spn-51322","text":": Multi-turn incremental format, includes EventQA and FactConsolidation"}]}],"id":"blk-45095","kind":"list-item"},{"blocks":[{"id":"blk-45098","kind":"paragraph","spans":[{"id":"spn-51323","marks":["bold"],"text":"Metrics"},{"id":"spn-51324","text":": 4 competency scores — accurate retrieval, test-time learning, long-range understanding, selective forgetting"}]}],"id":"blk-45097","kind":"list-item"},{"blocks":[{"id":"blk-45100","kind":"paragraph","spans":[{"id":"spn-51325","marks":["bold"],"text":"Key challenge"},{"id":"spn-51326","text":": Multi-turn format requires simulating incremental store→query cycles, not batch ingest. Map \"selective forgetting\" to "},{"id":"spn-51327","marks":["code"],"text":"forget_by_policy"},{"id":"spn-51328","text":" / "},{"id":"spn-51329","marks":["code"],"text":"forget_node"},{"id":"spn-51330","text":"."}]}],"id":"blk-45099","kind":"list-item"},{"blocks":[{"id":"blk-45102","kind":"paragraph","spans":[{"id":"spn-51331","marks":["bold"],"text":"Harness name"},{"id":"spn-51332","text":": "},{"id":"spn-51333","marks":["code"],"text":"mix benchmark.memoryagentbench"}]}],"id":"blk-45101","kind":"list-item"},{"blocks":[{"id":"blk-45104","kind":"paragraph","spans":[{"id":"spn-51334","marks":["bold"],"text":"CLI"},{"id":"spn-51335","text":": "},{"id":"spn-51336","marks":["code"],"text":"mix benchmark.memoryagentbench --limit 50"}]}],"id":"blk-45103","kind":"list-item"},{"blocks":[{"id":"blk-45106","kind":"paragraph","spans":[{"id":"spn-51337","marks":["bold"],"text":"Why second"},{"id":"spn-51338","text":": Directly tests Graphonomous's differentiating features (forgetting, learning loop). ICLR 2026 paper — high credibility."}]}],"id":"blk-45105","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45107","kind":"heading","level":3,"spans":[{"id":"spn-51339","text":"Session 3: LMEB (Long-horizon Memory Embedding Benchmark)"}]},{"id":"blk-45108","items":[{"blocks":[{"id":"blk-45110","kind":"paragraph","spans":[{"id":"spn-51340","marks":["bold"],"text":"Goal ID"},{"id":"spn-51341","text":": "},{"id":"spn-51342","marks":["code"],"text":"goal_81c0f91f92b9b4a52e0a38b44c49a492"}]}],"id":"blk-45109","kind":"list-item"},{"blocks":[{"id":"blk-45112","kind":"paragraph","spans":[{"id":"spn-51343","marks":["bold"],"text":"Paper"},{"id":"spn-51344","text":": https://arxiv.org/abs/2603.12572"}]}],"id":"blk-45111","kind":"list-item"},{"blocks":[{"id":"blk-45114","kind":"paragraph","spans":[{"id":"spn-51345","marks":["bold"],"text":"Repo"},{"id":"spn-51346","text":": https://github.com/KaLM-Embedding/LMEB"}]}],"id":"blk-45113","kind":"list-item"},{"blocks":[{"id":"blk-45116","kind":"paragraph","spans":[{"id":"spn-51347","marks":["bold"],"text":"HuggingFace"},{"id":"spn-51348","text":": https://huggingface.co/datasets/KaLM-Embedding/LMEB"}]}],"id":"blk-45115","kind":"list-item"},{"blocks":[{"id":"blk-45118","kind":"paragraph","spans":[{"id":"spn-51349","marks":["bold"],"text":"Dataset"},{"id":"spn-51350","text":": 22 datasets, 193 zero-shot retrieval tasks across 4 memory types (episodic, dialogue, semantic, procedural)"}]}],"id":"blk-45117","kind":"list-item"},{"blocks":[{"id":"blk-45120","kind":"paragraph","spans":[{"id":"spn-51351","marks":["bold"],"text":"Metrics"},{"id":"spn-51352","text":": Retrieval accuracy per memory type, aggregate score"}]}],"id":"blk-45119","kind":"list-item"},{"blocks":[{"id":"blk-45122","kind":"paragraph","spans":[{"id":"spn-51353","marks":["bold"],"text":"Key challenge"},{"id":"spn-51354","text":": This benchmarks the *embedding model*, not the full system. Run nomic-embed-text-v2-moe through the LMEB eval harness (likely Python). May need a thin Python wrapper or direct Elixir port of the eval logic."}]}],"id":"blk-45121","kind":"list-item"},{"blocks":[{"id":"blk-45124","kind":"paragraph","spans":[{"id":"spn-51355","marks":["bold"],"text":"Harness name"},{"id":"spn-51356","text":": "},{"id":"spn-51357","marks":["code"],"text":"mix benchmark.lmeb"}]}],"id":"blk-45123","kind":"list-item"},{"blocks":[{"id":"blk-45126","kind":"paragraph","spans":[{"id":"spn-51358","marks":["bold"],"text":"CLI"},{"id":"spn-51359","text":": "},{"id":"spn-51360","marks":["code"],"text":"mix benchmark.lmeb --model nomic-embed-text-v2-moe"}]}],"id":"blk-45125","kind":"list-item"},{"blocks":[{"id":"blk-45128","kind":"paragraph","spans":[{"id":"spn-51361","marks":["bold"],"text":"Why third"},{"id":"spn-51362","text":": Cheapest to run (embedding-only, no LLM judge needed). Validates the foundational layer. If nomic scores poorly on memory-specific retrieval, that's a critical finding."}]}],"id":"blk-45127","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45129","kind":"heading","level":3,"spans":[{"id":"spn-51363","text":"Session 4: MemoryBench (Continual Learning from Feedback)"}]},{"id":"blk-45130","items":[{"blocks":[{"id":"blk-45132","kind":"paragraph","spans":[{"id":"spn-51364","marks":["bold"],"text":"Goal ID"},{"id":"spn-51365","text":": "},{"id":"spn-51366","marks":["code"],"text":"goal_8ef86ae124eb2f03375289107dcac5ae"}]}],"id":"blk-45131","kind":"list-item"},{"blocks":[{"id":"blk-45134","kind":"paragraph","spans":[{"id":"spn-51367","marks":["bold"],"text":"Paper"},{"id":"spn-51368","text":": https://arxiv.org/abs/2510.17281"}]}],"id":"blk-45133","kind":"list-item"},{"blocks":[{"id":"blk-45136","kind":"paragraph","spans":[{"id":"spn-51369","marks":["bold"],"text":"Dataset"},{"id":"spn-51370","text":": User feedback simulation across multiple domains and languages"}]}],"id":"blk-45135","kind":"list-item"},{"blocks":[{"id":"blk-45138","kind":"paragraph","spans":[{"id":"spn-51371","marks":["bold"],"text":"Metrics"},{"id":"spn-51372","text":": Continual learning accuracy, feedback utilization rate, cross-domain transfer"}]}],"id":"blk-45137","kind":"list-item"},{"blocks":[{"id":"blk-45140","kind":"paragraph","spans":[{"id":"spn-51373","marks":["bold"],"text":"Key challenge"},{"id":"spn-51374","text":": Requires simulating the feedback loop — "},{"id":"spn-51375","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-51376","text":" with explicit/action-based/implicit feedback types, then re-querying to measure improvement. Multi-domain and multilingual means varied corpus."}]}],"id":"blk-45139","kind":"list-item"},{"blocks":[{"id":"blk-45142","kind":"paragraph","spans":[{"id":"spn-51377","marks":["bold"],"text":"Harness name"},{"id":"spn-51378","text":": "},{"id":"spn-51379","marks":["code"],"text":"mix benchmark.memorybench"}]}],"id":"blk-45141","kind":"list-item"},{"blocks":[{"id":"blk-45144","kind":"paragraph","spans":[{"id":"spn-51380","marks":["bold"],"text":"CLI"},{"id":"spn-51381","text":": "},{"id":"spn-51382","marks":["code"],"text":"mix benchmark.memorybench --domain all --limit 100"}]}],"id":"blk-45143","kind":"list-item"},{"blocks":[{"id":"blk-45146","kind":"paragraph","spans":[{"id":"spn-51383","marks":["bold"],"text":"Why fourth"},{"id":"spn-51384","text":": Directly tests the learning loop. Published finding that no system beats RAG baseline — if Graphonomous does, that's a headline result."}]}],"id":"blk-45145","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45147","kind":"heading","level":3,"spans":[{"id":"spn-51385","text":"Session 5: LifeBench (Non-Declarative Memory)"}]},{"id":"blk-45148","items":[{"blocks":[{"id":"blk-45150","kind":"paragraph","spans":[{"id":"spn-51386","marks":["bold"],"text":"Goal ID"},{"id":"spn-51387","text":": "},{"id":"spn-51388","marks":["code"],"text":"goal_824059ff9230ff0953646ea7ac2e7d6a"}]}],"id":"blk-45149","kind":"list-item"},{"blocks":[{"id":"blk-45152","kind":"paragraph","spans":[{"id":"spn-51389","marks":["bold"],"text":"Paper"},{"id":"spn-51390","text":": https://arxiv.org/abs/2603.03781"}]}],"id":"blk-45151","kind":"list-item"},{"blocks":[{"id":"blk-45154","kind":"paragraph","spans":[{"id":"spn-51391","marks":["bold"],"text":"Dataset"},{"id":"spn-51392","text":": Long-horizon event simulations with real-world priors (surveys, maps, calendars)"}]}],"id":"blk-45153","kind":"list-item"},{"blocks":[{"id":"blk-45156","kind":"paragraph","spans":[{"id":"spn-51393","marks":["bold"],"text":"Metrics"},{"id":"spn-51394","text":": Accuracy on habitual/procedural memory inference, declarative vs non-declarative breakdown"}]}],"id":"blk-45155","kind":"list-item"},{"blocks":[{"id":"blk-45158","kind":"paragraph","spans":[{"id":"spn-51395","marks":["bold"],"text":"SOTA"},{"id":"spn-51396","text":": 55.2% (top system)"}]}],"id":"blk-45157","kind":"list-item"},{"blocks":[{"id":"blk-45160","kind":"paragraph","spans":[{"id":"spn-51397","marks":["bold"],"text":"Key challenge"},{"id":"spn-51398","text":": Tests *inferred* knowledge, not explicitly stored facts. Graphonomous procedural nodes + edge patterns may capture habitual patterns that flat stores miss. May need to extend "},{"id":"spn-51399","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51400","text":" or add inference logic."}]}],"id":"blk-45159","kind":"list-item"},{"blocks":[{"id":"blk-45162","kind":"paragraph","spans":[{"id":"spn-51401","marks":["bold"],"text":"Harness name"},{"id":"spn-51402","text":": "},{"id":"spn-51403","marks":["code"],"text":"mix benchmark.lifebench"}]}],"id":"blk-45161","kind":"list-item"},{"blocks":[{"id":"blk-45164","kind":"paragraph","spans":[{"id":"spn-51404","marks":["bold"],"text":"CLI"},{"id":"spn-51405","text":": "},{"id":"spn-51406","marks":["code"],"text":"mix benchmark.lifebench --limit 50"}]}],"id":"blk-45163","kind":"list-item"},{"blocks":[{"id":"blk-45166","kind":"paragraph","spans":[{"id":"spn-51407","marks":["bold"],"text":"Why fifth"},{"id":"spn-51408","text":": Hardest benchmark (SOTA is 55%). Low expectations, high signal. If graph structure helps even marginally on non-declarative memory, that validates the architecture thesis."}]}],"id":"blk-45165","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45167","kind":"heading","level":3,"spans":[{"id":"spn-51409","text":"Session 6: AMemGym (On-Policy Interactive)"}]},{"id":"blk-45168","items":[{"blocks":[{"id":"blk-45170","kind":"paragraph","spans":[{"id":"spn-51410","marks":["bold"],"text":"Goal ID"},{"id":"spn-51411","text":": "},{"id":"spn-51412","marks":["code"],"text":"goal_b7ccffd9e67df8e7b42366ff24a9be82"}]}],"id":"blk-45169","kind":"list-item"},{"blocks":[{"id":"blk-45172","kind":"paragraph","spans":[{"id":"spn-51413","marks":["bold"],"text":"Paper"},{"id":"spn-51414","text":": https://arxiv.org/abs/2603.01966"}]}],"id":"blk-45171","kind":"list-item"},{"blocks":[{"id":"blk-45174","kind":"paragraph","spans":[{"id":"spn-51415","marks":["bold"],"text":"HuggingFace"},{"id":"spn-51416","text":": https://huggingface.co/datasets/AGI-Eval/AMemGym"}]}],"id":"blk-45173","kind":"list-item"},{"blocks":[{"id":"blk-45176","kind":"paragraph","spans":[{"id":"spn-51417","marks":["bold"],"text":"Dataset"},{"id":"spn-51418","text":": Interactive on-policy benchmark — agent generates its own conversation"}]}],"id":"blk-45175","kind":"list-item"},{"blocks":[{"id":"blk-45178","kind":"paragraph","spans":[{"id":"spn-51419","marks":["bold"],"text":"Metrics"},{"id":"spn-51420","text":": Structured state consistency, memory utilization, persona tracking"}]}],"id":"blk-45177","kind":"list-item"},{"blocks":[{"id":"blk-45180","kind":"paragraph","spans":[{"id":"spn-51421","marks":["bold"],"text":"Key challenge"},{"id":"spn-51422","text":": This is fundamentally different from other benchmarks. The agent must *participate* in the conversation, not just answer post-hoc questions. Requires wiring Graphonomous MCP into a simulated conversation loop with an LLM-simulated user. Most complex harness to build."}]}],"id":"blk-45179","kind":"list-item"},{"blocks":[{"id":"blk-45182","kind":"paragraph","spans":[{"id":"spn-51423","marks":["bold"],"text":"Harness name"},{"id":"spn-51424","text":": "},{"id":"spn-51425","marks":["code"],"text":"mix benchmark.amemgym"}]}],"id":"blk-45181","kind":"list-item"},{"blocks":[{"id":"blk-45184","kind":"paragraph","spans":[{"id":"spn-51426","marks":["bold"],"text":"CLI"},{"id":"spn-51427","text":": "},{"id":"spn-51428","marks":["code"],"text":"mix benchmark.amemgym --scenarios 10"}]}],"id":"blk-45183","kind":"list-item"},{"blocks":[{"id":"blk-45186","kind":"paragraph","spans":[{"id":"spn-51429","marks":["bold"],"text":"Why last"},{"id":"spn-51430","text":": Most complex integration. Requires LLM-in-the-loop (simulated user). But the most realistic test of how Graphonomous actually performs in production. Save for last when all other harnesses are proven."}]}],"id":"blk-45185","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45187","kind":"paragraph","spans":[{"id":"spn-51431","text":"---"}]},{"id":"blk-45188","kind":"heading","level":2,"spans":[{"id":"spn-51432","text":"Post-Completion"}]},{"id":"blk-45189","kind":"paragraph","spans":[{"id":"spn-51433","text":"After all 6 harnesses are built and run:"}]},{"id":"blk-45190","kind":"paragraph","spans":[{"id":"spn-51434","text":"1. Update "},{"id":"spn-51435","marks":["code"],"text":"OS-E001-EMPIRICAL-EVALUATION.md"},{"id":"spn-51436","text":" with a unified results table 2. Update "},{"id":"spn-51437","marks":["code"],"text":"graphonomous.com/benchmarks/"},{"id":"spn-51438","text":" pages with new benchmark results 3. Update "},{"id":"spn-51439","marks":["code"],"text":"AmpersandBoxDesign/site/portfolio-review.html"},{"id":"spn-51440","text":" competitive landscape 4. Store a comprehensive episodic node in Graphonomous summarizing the full evaluation 5. Consider adding top-line scores to "},{"id":"spn-51441","marks":["code"],"text":"graphonomous/README.md"}]},{"id":"blk-45191","kind":"paragraph","spans":[{"id":"spn-51442","text":"---"}]},{"id":"blk-45192","kind":"heading","level":2,"spans":[{"id":"spn-51443","text":"Anti-Patterns to Avoid"}]},{"id":"blk-45193","items":[{"blocks":[{"id":"blk-45195","kind":"paragraph","spans":[{"id":"spn-51444","text":"Do NOT modify "},{"id":"spn-51445","marks":["code"],"text":"retrieve_context"},{"id":"spn-51446","text":" or the retrieval pipeline to game a specific benchmark"}]}],"id":"blk-45194","kind":"list-item"},{"blocks":[{"id":"blk-45197","kind":"paragraph","spans":[{"id":"spn-51447","text":"Do NOT add benchmark-specific code paths to the core engine"}]}],"id":"blk-45196","kind":"list-item"},{"blocks":[{"id":"blk-45199","kind":"paragraph","spans":[{"id":"spn-51448","text":"Do NOT skip the smoke test ("},{"id":"spn-51449","marks":["code"],"text":"--limit 50"},{"id":"spn-51450","text":") before full runs"}]}],"id":"blk-45198","kind":"list-item"},{"blocks":[{"id":"blk-45201","kind":"paragraph","spans":[{"id":"spn-51451","text":"Do NOT fabricate competitive baselines — only cite published numbers with sources"}]}],"id":"blk-45200","kind":"list-item"},{"blocks":[{"id":"blk-45203","kind":"paragraph","spans":[{"id":"spn-51452","text":"Do NOT skip storing results in Graphonomous — the learning loop is the point"}]}],"id":"blk-45202","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieranwadlgqdq4oax4uqt3q2fnjjexrd6lqncq6yrv5frei2753jq4jq","vocabulary":"ampersand.docs.fs.v1"}