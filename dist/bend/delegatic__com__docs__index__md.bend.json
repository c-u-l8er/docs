{"bendscript":"0.1","blocks":[{"id":"blk-36691","kind":"heading","level":1,"spans":[{"id":"spn-39871","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-36693","kind":"paragraph","spans":[{"id":"spn-39872","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-36692","kind":"quote"},{"blocks":[{"id":"blk-36695","kind":"paragraph","spans":[{"id":"spn-39873","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-39874","text":" · "},{"id":"spn-39875","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-39876","text":" · "},{"id":"spn-39877","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-39878","text":" · "},{"id":"spn-39879","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-36694","kind":"quote"},{"id":"blk-36696","kind":"paragraph","spans":[{"id":"spn-39880","text":"Welcome to the documentation hub for "},{"id":"spn-39881","marks":["bold"],"text":"Delegatic"},{"id":"spn-39882","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-36697","kind":"paragraph","spans":[{"id":"spn-39883","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-36698","kind":"paragraph","spans":[{"id":"spn-39884","text":"---"}]},{"id":"blk-36699","kind":"heading","level":2,"spans":[{"id":"spn-39885","text":"Core Concepts"}]},{"id":"blk-36700","kind":"heading","level":3,"spans":[{"id":"spn-39886","text":"Containment Trees"}]},{"id":"blk-36701","kind":"paragraph","spans":[{"id":"spn-39887","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-36702","kind":"heading","level":3,"spans":[{"id":"spn-39888","text":"Monotonic Policy Inheritance"}]},{"id":"blk-36703","kind":"paragraph","spans":[{"id":"spn-39889","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-36704","items":[{"blocks":[{"id":"blk-36706","kind":"paragraph","spans":[{"id":"spn-39890","marks":["bold"],"text":"Booleans"},{"id":"spn-39891","text":" → AND (child can only disable)"}]}],"id":"blk-36705","kind":"list-item"},{"blocks":[{"id":"blk-36708","kind":"paragraph","spans":[{"id":"spn-39892","marks":["bold"],"text":"Numerics"},{"id":"spn-39893","text":" → MIN (child can only lower limits)"}]}],"id":"blk-36707","kind":"list-item"},{"blocks":[{"id":"blk-36710","kind":"paragraph","spans":[{"id":"spn-39894","marks":["bold"],"text":"Allow-lists"},{"id":"spn-39895","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-36709","kind":"list-item"},{"blocks":[{"id":"blk-36712","kind":"paragraph","spans":[{"id":"spn-39896","marks":["bold"],"text":"Deny-lists"},{"id":"spn-39897","text":" → UNION (child can only add)"}]}],"id":"blk-36711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36713","kind":"paragraph","spans":[{"id":"spn-39898","text":"Privilege escalation is impossible by design."}]},{"id":"blk-36714","kind":"heading","level":3,"spans":[{"id":"spn-39899","text":"Append-Only Audit"}]},{"id":"blk-36715","kind":"paragraph","spans":[{"id":"spn-39900","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-36716","kind":"heading","level":3,"spans":[{"id":"spn-39901","text":"Goal-Aware Governance"}]},{"id":"blk-36717","kind":"paragraph","spans":[{"id":"spn-39902","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-39903","marks":["code"],"text":"goal_id"},{"id":"spn-39904","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-36718","kind":"paragraph","spans":[{"id":"spn-39905","text":"---"}]},{"id":"blk-36719","kind":"heading","level":2,"spans":[{"id":"spn-39906","text":"Documentation Map"}]},{"id":"blk-36720","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-36721","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-36722","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Delegatic Docs\n\nspec/README"},{"id":"blk-36723","kind":"paragraph","spans":[{"id":"spn-39907","text":"---"}]},{"id":"blk-36724","kind":"heading","level":2,"spans":[{"id":"spn-39908","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-36726","spans":[{"id":"spn-39909","text":"Component"}]},{"id":"blk-36727","spans":[{"id":"spn-39910","text":"Role"}]},{"id":"blk-36728","spans":[{"id":"spn-39911","text":"OTP Pattern"}]}],"id":"blk-36725","kind":"table","rows":[[{"id":"blk-36729","spans":[{"id":"spn-39912","marks":["bold"],"text":"OrgNode"}]},{"id":"blk-36730","spans":[{"id":"spn-39913","text":"One org. Holds local policy, caches effective policy."}]},{"id":"blk-36731","spans":[{"id":"spn-39914","text":"GenServer"}]}],[{"id":"blk-36732","spans":[{"id":"spn-39915","marks":["bold"],"text":"PolicyEngine"}]},{"id":"blk-36733","spans":[{"id":"spn-39916","text":"Computes effective policies, enforces monotonic inheritance."}]},{"id":"blk-36734","spans":[{"id":"spn-39917","text":"GenServer + ETS"}]}],[{"id":"blk-36735","spans":[{"id":"spn-39918","marks":["bold"],"text":"AuditWriter"}]},{"id":"blk-36736","spans":[{"id":"spn-39919","text":"Batched, append-only audit event writes."}]},{"id":"blk-36737","spans":[{"id":"spn-39920","text":"Broadway pipeline"}]}],[{"id":"blk-36738","spans":[{"id":"spn-39921","marks":["bold"],"text":"OrgTreeCache"}]},{"id":"blk-36739","spans":[{"id":"spn-39922","text":"In-memory tree for cycle detection and path lookups."}]},{"id":"blk-36740","spans":[{"id":"spn-39923","text":"GenServer + ETS"}]}],[{"id":"blk-36741","spans":[{"id":"spn-39924","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-36742","spans":[{"id":"spn-39925","text":"Real-time org tree, policy editor, audit log viewer."}]},{"id":"blk-36743","spans":[{"id":"spn-39926","text":"Phoenix LiveView"}]}]]},{"id":"blk-36744","kind":"paragraph","spans":[{"id":"spn-39927","text":"---"}]},{"id":"blk-36745","kind":"heading","level":2,"spans":[{"id":"spn-39928","text":"Performance Targets"}]},{"head":[{"id":"blk-36747","spans":[{"id":"spn-39929","text":"Metric"}]},{"id":"blk-36748","spans":[{"id":"spn-39930","text":"Target"}]}],"id":"blk-36746","kind":"table","rows":[[{"id":"blk-36749","spans":[{"id":"spn-39931","text":"Effective policy lookup (ETS hot)"}]},{"id":"blk-36750","spans":[{"id":"spn-39932","text":"< 5us p99"}]}],[{"id":"blk-36751","spans":[{"id":"spn-39933","text":"Effective policy computation (cold)"}]},{"id":"blk-36752","spans":[{"id":"spn-39934","text":"< 20ms p99"}]}],[{"id":"blk-36753","spans":[{"id":"spn-39935","text":"Cycle detection (depth-50 tree)"}]},{"id":"blk-36754","spans":[{"id":"spn-39936","text":"< 1ms"}]}],[{"id":"blk-36755","spans":[{"id":"spn-39937","text":"Audit write throughput (Broadway)"}]},{"id":"blk-36756","spans":[{"id":"spn-39938","text":"> 10K events/sec"}]}]]},{"id":"blk-36757","kind":"paragraph","spans":[{"id":"spn-39939","text":"---"}]},{"id":"blk-36758","kind":"heading","level":2,"spans":[{"id":"spn-39940","text":"Tech Stack"}]},{"head":[{"id":"blk-36760","spans":[{"id":"spn-39941","text":"Layer"}]},{"id":"blk-36761","spans":[{"id":"spn-39942","text":"Technology"}]}],"id":"blk-36759","kind":"table","rows":[[{"id":"blk-36762","spans":[{"id":"spn-39943","text":"Language"}]},{"id":"blk-36763","spans":[{"id":"spn-39944","text":"Elixir 1.17+"}]}],[{"id":"blk-36764","spans":[{"id":"spn-39945","text":"Framework"}]},{"id":"blk-36765","spans":[{"id":"spn-39946","text":"Phoenix 1.8+ (LiveView for dashboard)"}]}],[{"id":"blk-36766","spans":[{"id":"spn-39947","text":"Database"}]},{"id":"blk-36767","spans":[{"id":"spn-39948","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-36768","spans":[{"id":"spn-39949","text":"Hot Cache"}]},{"id":"blk-36769","spans":[{"id":"spn-39950","text":"ETS (effective policies, org tree, memberships)"}]}],[{"id":"blk-36770","spans":[{"id":"spn-39951","text":"Audit Pipeline"}]},{"id":"blk-36771","spans":[{"id":"spn-39952","text":"Broadway (batched inserts, back-pressure)"}]}],[{"id":"blk-36772","spans":[{"id":"spn-39953","text":"Background Jobs"}]},{"id":"blk-36773","spans":[{"id":"spn-39954","text":"Oban (webhooks, compliance exports)"}]}],[{"id":"blk-36774","spans":[{"id":"spn-39955","text":"Telemetry"}]},{"id":"blk-36775","spans":[{"id":"spn-39956","text":":telemetry + Prometheus"}]}]]},{"id":"blk-36776","kind":"paragraph","spans":[{"id":"spn-39957","text":"---"}]},{"id":"blk-36777","kind":"heading","level":2,"spans":[{"id":"spn-39958","text":"Ecosystem Role"}]},{"id":"blk-36778","kind":"paragraph","spans":[{"id":"spn-39959","text":"Delegatic is the "},{"id":"spn-39960","marks":["bold"],"text":"governance layer"},{"id":"spn-39961","text":" of the [&] stack:"}]},{"head":[{"id":"blk-36780","spans":[{"id":"spn-39962","text":"Product"}]},{"id":"blk-36781","spans":[{"id":"spn-39963","text":"Relationship"}]}],"id":"blk-36779","kind":"table","rows":[[{"id":"blk-36782","spans":[{"id":"spn-39964","marks":["bold"],"text":"Agentelic"}]},{"id":"blk-36783","spans":[{"id":"spn-39965","text":"Telespace attachments — agents registered under orgs"}]}],[{"id":"blk-36784","spans":[{"id":"spn-39966","marks":["bold"],"text":"AgenTroMatic"}]},{"id":"blk-36785","spans":[{"id":"spn-39967","text":"Policy check API — deliberations respect governance"}]}],[{"id":"blk-36786","spans":[{"id":"spn-39968","marks":["bold"],"text":"WebHost.Systems"}]},{"id":"blk-36787","spans":[{"id":"spn-39969","text":"Deployment gates — deploy requires policy approval"}]}],[{"id":"blk-36788","spans":[{"id":"spn-39970","marks":["bold"],"text":"FleetPrompt"}]},{"id":"blk-36789","spans":[{"id":"spn-39971","text":"Install authorization — marketplace installs need org permission"}]}],[{"id":"blk-36790","spans":[{"id":"spn-39972","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-36791","spans":[{"id":"spn-39973","text":"Goal references — actions scoped to durable intent"}]}]]},{"id":"blk-36792","kind":"paragraph","spans":[{"id":"spn-39974","text":"---"}]},{"id":"blk-36793","kind":"heading","level":2,"spans":[{"id":"spn-39975","text":"Project Links"}]},{"id":"blk-36794","items":[{"blocks":[{"id":"blk-36796","kind":"paragraph","spans":[{"id":"spn-39976","marks":["bold"],"text":"Spec:"},{"id":"spn-39977","text":" "},