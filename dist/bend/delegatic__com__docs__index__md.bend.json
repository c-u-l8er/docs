{"bendscript":"0.1","blocks":[{"id":"blk-63623","kind":"heading","level":1,"spans":[{"id":"spn-122264","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-63625","kind":"paragraph","spans":[{"id":"spn-122265","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-63624","kind":"quote"},{"blocks":[{"id":"blk-63627","kind":"paragraph","spans":[{"id":"spn-122266","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-122267","text":" · "},{"id":"spn-122268","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-122269","text":" · "},{"id":"spn-122270","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-122271","text":" · "},{"id":"spn-122272","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-63626","kind":"quote"},{"id":"blk-63628","kind":"paragraph","spans":[{"id":"spn-122273","text":"Welcome to the documentation hub for "},{"id":"spn-122274","marks":["bold"],"text":"Delegatic"},{"id":"spn-122275","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-63629","kind":"paragraph","spans":[{"id":"spn-122276","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-63630","kind":"heading","level":2,"spans":[{"id":"spn-122277","text":"Core Concepts"}]},{"id":"blk-63631","kind":"heading","level":3,"spans":[{"id":"spn-122278","text":"Containment Trees"}]},{"id":"blk-63632","kind":"paragraph","spans":[{"id":"spn-122279","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-63633","kind":"heading","level":3,"spans":[{"id":"spn-122280","text":"Monotonic Policy Inheritance"}]},{"id":"blk-63634","kind":"paragraph","spans":[{"id":"spn-122281","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-63635","items":[{"blocks":[{"id":"blk-63637","kind":"paragraph","spans":[{"id":"spn-122282","marks":["bold"],"text":"Booleans"},{"id":"spn-122283","text":" → AND (child can only disable)"}]}],"id":"blk-63636","kind":"list-item"},{"blocks":[{"id":"blk-63639","kind":"paragraph","spans":[{"id":"spn-122284","marks":["bold"],"text":"Numerics"},{"id":"spn-122285","text":" → MIN (child can only lower limits)"}]}],"id":"blk-63638","kind":"list-item"},{"blocks":[{"id":"blk-63641","kind":"paragraph","spans":[{"id":"spn-122286","marks":["bold"],"text":"Allow-lists"},{"id":"spn-122287","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-63640","kind":"list-item"},{"blocks":[{"id":"blk-63643","kind":"paragraph","spans":[{"id":"spn-122288","marks":["bold"],"text":"Deny-lists"},{"id":"spn-122289","text":" → UNION (child can only add)"}]}],"id":"blk-63642","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63644","kind":"paragraph","spans":[{"id":"spn-122290","text":"Privilege escalation is impossible by design."}]},{"id":"blk-63645","kind":"heading","level":3,"spans":[{"id":"spn-122291","text":"Append-Only Audit"}]},{"id":"blk-63646","kind":"paragraph","spans":[{"id":"spn-122292","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-63647","kind":"heading","level":3,"spans":[{"id":"spn-122293","text":"Goal-Aware Governance"}]},{"id":"blk-63648","kind":"paragraph","spans":[{"id":"spn-122294","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-122295","marks":["code"],"text":"goal_id"},{"id":"spn-122296","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-63649","kind":"heading","level":2,"spans":[{"id":"spn-122297","text":"Documentation Map"}]},{"id":"blk-63650","kind":"paragraph","spans":[{"id":"spn-122298","marks":["bold"],"text":"Homepages"}]},{"id":"blk-63651","items":[{"blocks":[{"id":"blk-63653","kind":"paragraph","spans":[{"id":"spn-122299","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-63652","kind":"list-item"},{"blocks":[{"id":"blk-63655","kind":"paragraph","spans":[{"id":"spn-122300","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-63654","kind":"list-item"},{"blocks":[{"id":"blk-63657","kind":"paragraph","spans":[{"id":"spn-122301","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-63656","kind":"list-item"},{"blocks":[{"id":"blk-63659","kind":"paragraph","spans":[{"id":"spn-122302","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-63658","kind":"list-item"},{"blocks":[{"id":"blk-63661","kind":"paragraph","spans":[{"id":"spn-122303","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-63660","kind":"list-item"},{"blocks":[{"id":"blk-63663","kind":"paragraph","spans":[{"id":"spn-122304","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-63662","kind":"list-item"},{"blocks":[{"id":"blk-63665","kind":"paragraph","spans":[{"id":"spn-122305","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-63664","kind":"list-item"},{"blocks":[{"id":"blk-63667","kind":"paragraph","spans":[{"id":"spn-122306","marks":[{"kind":"link","pred