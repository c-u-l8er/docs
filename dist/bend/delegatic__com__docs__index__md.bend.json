{"bendscript":"0.1","blocks":[{"id":"blk-58737","kind":"heading","level":1,"spans":[{"id":"spn-88078","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-58739","kind":"paragraph","spans":[{"id":"spn-88079","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-58738","kind":"quote"},{"blocks":[{"id":"blk-58741","kind":"paragraph","spans":[{"id":"spn-88080","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-88081","text":" · "},{"id":"spn-88082","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-88083","text":" · "},{"id":"spn-88084","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-88085","text":" · "},{"id":"spn-88086","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-58740","kind":"quote"},{"id":"blk-58742","kind":"paragraph","spans":[{"id":"spn-88087","text":"Welcome to the documentation hub for "},{"id":"spn-88088","marks":["bold"],"text":"Delegatic"},{"id":"spn-88089","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-58743","kind":"paragraph","spans":[{"id":"spn-88090","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-58744","kind":"heading","level":2,"spans":[{"id":"spn-88091","text":"Core Concepts"}]},{"id":"blk-58745","kind":"heading","level":3,"spans":[{"id":"spn-88092","text":"Containment Trees"}]},{"id":"blk-58746","kind":"paragraph","spans":[{"id":"spn-88093","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-58747","kind":"heading","level":3,"spans":[{"id":"spn-88094","text":"Monotonic Policy Inheritance"}]},{"id":"blk-58748","kind":"paragraph","spans":[{"id":"spn-88095","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-58749","items":[{"blocks":[{"id":"blk-58751","kind":"paragraph","spans":[{"id":"spn-88096","marks":["bold"],"text":"Booleans"},{"id":"spn-88097","text":" → AND (child can only disable)"}]}],"id":"blk-58750","kind":"list-item"},{"blocks":[{"id":"blk-58753","kind":"paragraph","spans":[{"id":"spn-88098","marks":["bold"],"text":"Numerics"},{"id":"spn-88099","text":" → MIN (child can only lower limits)"}]}],"id":"blk-58752","kind":"list-item"},{"blocks":[{"id":"blk-58755","kind":"paragraph","spans":[{"id":"spn-88100","marks":["bold"],"text":"Allow-lists"},{"id":"spn-88101","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-58754","kind":"list-item"},{"blocks":[{"id":"blk-58757","kind":"paragraph","spans":[{"id":"spn-88102","marks":["bold"],"text":"Deny-lists"},{"id":"spn-88103","text":" → UNION (child can only add)"}]}],"id":"blk-58756","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58758","kind":"paragraph","spans":[{"id":"spn-88104","text":"Privilege escalation is impossible by design."}]},{"id":"blk-58759","kind":"heading","level":3,"spans":[{"id":"spn-88105","text":"Append-Only Audit"}]},{"id":"blk-58760","kind":"paragraph","spans":[{"id":"spn-88106","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-58761","kind":"heading","level":3,"spans":[{"id":"spn-88107","text":"Goal-Aware Governance"}]},{"id":"blk-58762","kind":"paragraph","spans":[{"id":"spn-88108","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-88109","marks":["code"],"text":"goal_id"},{"id":"spn-88110","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-58763","kind":"heading","level":2,"spans":[{"id":"spn-88111","text":"Documentation Map"}]},{"id":"blk-58764","kind":"paragraph","spans":[{"id":"spn-88112","marks":["bold"],"text":"Homepages"}]},{"id":"blk-58765","items":[{"blocks":[{"id":"blk-58767","kind":"paragraph","spans":[{"id":"spn-88113","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-58766","kind":"list-item"},{"blocks":[{"id":"blk-58769","kind":"paragraph","spans":[{"id":"spn-88114","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-58768","kind":"list-item"},{"blocks":[{"id":"blk-58771","kind":"paragraph","spans":[{"id":"spn-88115","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-58770","kind":"list-item"},{"blocks":[{"id":"blk-58773","kind":"paragraph","spans":[{"id":"spn-88116","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-58772","kind":"list-item"},{"blocks":[{"id":"blk-58775","kind":"paragraph","spans":[{"id":"spn-88117","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-58774","kind":"list-item"},{"blocks":[{"id":"blk-58777","kind":"paragraph","spans":[{"id":"spn-88118","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-58776","kind":"list-item"},{"blocks":[{"id":"blk-58779","kind":"paragraph","spans":[{"id":"spn-88119","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-58778","kind":"list-item"},{"blocks":[{"id":"blk-58781","kind":"paragraph","spans":[{"id":"spn-88120","marks":[{"kind":"link","predicate":"cites","target":"https://deliberati