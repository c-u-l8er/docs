{"bendscript":"0.1","blocks":[{"id":"blk-36801","kind":"heading","level":1,"spans":[{"id":"spn-40500","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-36803","kind":"paragraph","spans":[{"id":"spn-40501","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-36802","kind":"quote"},{"blocks":[{"id":"blk-36805","kind":"paragraph","spans":[{"id":"spn-40502","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-40503","text":" · "},{"id":"spn-40504","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-40505","text":" · "},{"id":"spn-40506","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-40507","text":" · "},{"id":"spn-40508","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-36804","kind":"quote"},{"id":"blk-36806","kind":"paragraph","spans":[{"id":"spn-40509","text":"Welcome to the documentation hub for "},{"id":"spn-40510","marks":["bold"],"text":"Delegatic"},{"id":"spn-40511","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-36807","kind":"paragraph","spans":[{"id":"spn-40512","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-36808","kind":"paragraph","spans":[{"id":"spn-40513","text":"---"}]},{"id":"blk-36809","kind":"heading","level":2,"spans":[{"id":"spn-40514","text":"Core Concepts"}]},{"id":"blk-36810","kind":"heading","level":3,"spans":[{"id":"spn-40515","text":"Containment Trees"}]},{"id":"blk-36811","kind":"paragraph","spans":[{"id":"spn-40516","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-36812","kind":"heading","level":3,"spans":[{"id":"spn-40517","text":"Monotonic Policy Inheritance"}]},{"id":"blk-36813","kind":"paragraph","spans":[{"id":"spn-40518","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-36814","items":[{"blocks":[{"id":"blk-36816","kind":"paragraph","spans":[{"id":"spn-40519","marks":["bold"],"text":"Booleans"},{"id":"spn-40520","text":" → AND (child can only disable)"}]}],"id":"blk-36815","kind":"list-item"},{"blocks":[{"id":"blk-36818","kind":"paragraph","spans":[{"id":"spn-40521","marks":["bold"],"text":"Numerics"},{"id":"spn-40522","text":" → MIN (child can only lower limits)"}]}],"id":"blk-36817","kind":"list-item"},{"blocks":[{"id":"blk-36820","kind":"paragraph","spans":[{"id":"spn-40523","marks":["bold"],"text":"Allow-lists"},{"id":"spn-40524","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-36819","kind":"list-item"},{"blocks":[{"id":"blk-36822","kind":"paragraph","spans":[{"id":"spn-40525","marks":["bold"],"text":"Deny-lists"},{"id":"spn-40526","text":" → UNION (child can only add)"}]}],"id":"blk-36821","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36823","kind":"paragraph","spans":[{"id":"spn-40527","text":"Privilege escalation is impossible by design."}]},{"id":"blk-36824","kind":"heading","level":3,"spans":[{"id":"spn-40528","text":"Append-Only Audit"}]},{"id":"blk-36825","kind":"paragraph","spans":[{"id":"spn-40529","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-36826","kind":"heading","level":3,"spans":[{"id":"spn-40530","text":"Goal-Aware Governance"}]},{"id":"blk-36827","kind":"paragraph","spans":[{"id":"spn-40531","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-40532","marks":["code"],"text":"goal_id"},{"id":"spn-40533","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-36828","kind":"paragraph","spans":[{"id":"spn-40534","text":"---"}]},{"id":"blk-36829","kind":"heading","level":2,"spans":[{"id":"spn-40535","text":"Documentation Map"}]},{"id":"blk-36830","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-36831","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-36832","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Delegatic Docs\n\nspec/README"},{"id":"blk-36833","kind":"paragraph","spans":[{"id":"spn-40536","text":"---"}]},{"id":"blk-36834","kind":"heading","level":2,"spans":[{"id":"spn-40537","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-36836","spans":[{"id":"spn-40538","text":"Component"}]},{"id":"blk-36837","spans":[{"id":"spn-40539","text":"Role"}]},{"id":"blk-36838","spans":[{"id":"spn-40540","text":"OTP Pattern"}]}],"id":"blk-36835","kind":"table","rows":[[{"id":"blk-36839","spans":[{"id":"spn-40541","marks":["bold"],"text":"OrgNode"}]},{"id":"blk-36840","spans":[{"id":"spn-40542","text":"One org. Holds local policy, caches effective policy."}]},{"id":"blk-36841","spans":[{"id":"spn-40543","text":"GenServer"}]}],[{"id":"blk-36842","spans":[{"id":"spn-40544","marks":["bold"],"text":"PolicyEngine"}]},{"id":"blk-36843","spans":[{"id":"spn-40545","text":"Computes effective policies, enforces monotonic inheritance."}]},{"id":"blk-36844","spans":[{"id":"spn-40546","text":"GenServer + ETS"}]}],[{"id":"blk-36845","spans":[{"id":"spn-40547","marks":["bold"],"text":"AuditWriter"}]},{"id":"blk-36846","spans":[{"id":"spn-40548","text":"Batched, append-only audit event writes."}]},{"id":"blk-36847","spans":[{"id":"spn-40549","text":"Broadway pipeline"}]}],[{"id":"blk-36848","spans":[{"id":"spn-40550","marks":["bold"],"text":"OrgTreeCache"}]},{"id":"blk-36849","spans":[{"id":"spn-40551","text":"In-memory tree for cycle detection and path lookups."}]},{"id":"blk-36850","spans":[{"id":"spn-40552","text":"GenServer + ETS"}]}],[{"id":"blk-36851","spans":[{"id":"spn-40553","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-36852","spans":[{"id":"spn-40554","text":"Real-time org tree, policy editor, audit log viewer."}]},{"id":"blk-36853","spans":[{"id":"spn-40555","text":"Phoenix LiveView"}]}]]},{"id":"blk-36854","kind":"paragraph","spans":[{"id":"spn-40556","text":"---"}]},{"id":"blk-36855","kind":"heading","level":2,"spans":[{"id":"spn-40557","text":"Performance Targets"}]},{"head":[{"id":"blk-36857","spans":[{"id":"spn-40558","text":"Metric"}]},{"id":"blk-36858","spans":[{"id":"spn-40559","text":"Target"}]}],"id":"blk-36856","kind":"table","rows":[[{"id":"blk-36859","spans":[{"id":"spn-40560","text":"Effective policy lookup (ETS hot)"}]},{"id":"blk-36860","spans":[{"id":"spn-40561","text":"< 5us p99"}]}],[{"id":"blk-36861","spans":[{"id":"spn-40562","text":"Effective policy computation (cold)"}]},{"id":"blk-36862","spans":[{"id":"spn-40563","text":"< 20ms p99"}]}],[{"id":"blk-36863","spans":[{"id":"spn-40564","text":"Cycle detection (depth-50 tree)"}]},{"id":"blk-36864","spans":[{"id":"spn-40565","text":"< 1ms"}]}],[{"id":"blk-36865","spans":[{"id":"spn-40566","text":"Audit write throughput (Broadway)"}]},{"id":"blk-36866","spans":[{"id":"spn-40567","text":"> 10K events/sec"}]}]]},{"id":"blk-36867","kind":"paragraph","spans":[{"id":"spn-40568","text":"---"}]},{"id":"blk-36868","kind":"heading","level":2,"spans":[{"id":"spn-40569","text":"Tech Stack"}]},{"head":[{"id":"blk-36870","spans":[{"id":"spn-40570","text":"Layer"}]},{"id":"blk-36871","spans":[{"id":"spn-40571","text":"Technology"}]}],"id":"blk-36869","kind":"table","rows":[[{"id":"blk-36872","spans":[{"id":"spn-40572","text":"Language"}]},{"id":"blk-36873","spans":[{"id":"spn-40573","text":"Elixir 1.17+"}]}],[{"id":"blk-36874","spans":[{"id":"spn-40574","text":"Framework"}]},{"id":"blk-36875","spans":[{"id":"spn-40575","text":"Phoenix 1.8+ (LiveView for dashboard)"}]}],[{"id":"blk-36876","spans":[{"id":"spn-40576","text":"Database"}]},{"id":"blk-36877","spans":[{"id":"spn-40577","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-36878","spans":[{"id":"spn-40578","text":"Hot Cache"}]},{"id":"blk-36879","spans":[{"id":"spn-40579","text":"ETS (effective policies, org tree, memberships)"}]}],[{"id":"blk-36880","spans":[{"id":"spn-40580","text":"Audit Pipeline"}]},{"id":"blk-36881","spans":[{"id":"spn-40581","text":"Broadway (batched inserts, back-pressure)"}]}],[{"id":"blk-36882","spans":[{"id":"spn-40582","text":"Background Jobs"}]},{"id":"blk-36883","spans":[{"id":"spn-40583","text":"Oban (webhooks, compliance exports)"}]}],[{"id":"blk-36884","spans":[{"id":"spn-40584","text":"Telemetry"}]},{"id":"blk-36885","spans":[{"id":"spn-40585","text":":telemetry + Prometheus"}]}]]},{"id":"blk-36886","kind":"paragraph","spans":[{"id":"spn-40586","text":"---"}]},{"id":"blk-36887","kind":"heading","level":2,"spans":[{"id":"spn-40587","text":"Ecosystem Role"}]},{"id":"blk-36888","kind":"paragraph","spans":[{"id":"spn-40588","text":"Delegatic is the "},{"id":"spn-40589","marks":["bold"],"text":"governance layer"},{"id":"spn-40590","text":" of the [&] stack:"}]},{"head":[{"id":"blk-36890","spans":[{"id":"spn-40591","text":"Product"}]},{"id":"blk-36891","spans":[{"id":"spn-40592","text":"Relationship"}]}],"id":"blk-36889","kind":"table","rows":[[{"id":"blk-36892","spans":[{"id":"spn-40593","marks":["bold"],"text":"Agentelic"}]},{"id":"blk-36893","spans":[{"id":"spn-40594","text":"Telespace attachments — agents registered under orgs"}]}],[{"id":"blk-36894","spans":[{"id":"spn-40595","marks":["bold"],"text":"AgenTroMatic"}]},{"id":"blk-36895","spans":[{"id":"spn-40596","text":"Policy check API — deliberations respect governance"}]}],[{"id":"blk-36896","spans":[{"id":"spn-40597","marks":["bold"],"text":"WebHost.Systems"}]},{"id":"blk-36897","spans":[{"id":"spn-40598","text":"Deployment gates — deploy requires policy approval"}]}],[{"id":"blk-36898","spans":[{"id":"spn-40599","marks":["bold"],"text":"FleetPrompt"}]},{"id":"blk-36899","spans":[{"id":"spn-40600","text":"Install authorization — marketplace installs need org permission"}]}],[{"id":"blk-36900","spans":[{"id":"spn-40601","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-36901","spans":[{"id":"spn-40602","text":"Goal references — actions scoped to durable intent"}]}]]},{"id":"blk-36902","kind":"paragraph","spans":[{"id":"spn-40603","text":"---"}]},{"id":"blk-36903","kind":"heading","level":2,"spans":[{"id":"spn-40604","text":"Project Links"}]},{"id":"blk-36904","items":[{"blocks":[{"id":"blk-36906","kind":"paragraph","spans":[{"id":"spn-40605","marks":["bold"],"text":"Spec:"},{"id":"spn-40606","text":" "},