{"bendscript":"0.1","blocks":[{"id":"blk-58611","kind":"heading","level":1,"spans":[{"id":"spn-87930","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-58613","kind":"paragraph","spans":[{"id":"spn-87931","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-58612","kind":"quote"},{"blocks":[{"id":"blk-58615","kind":"paragraph","spans":[{"id":"spn-87932","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-87933","text":" · "},{"id":"spn-87934","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-87935","text":" · "},{"id":"spn-87936","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-87937","text":" · "},{"id":"spn-87938","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-58614","kind":"quote"},{"id":"blk-58616","kind":"paragraph","spans":[{"id":"spn-87939","text":"Welcome to the documentation hub for "},{"id":"spn-87940","marks":["bold"],"text":"Delegatic"},{"id":"spn-87941","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-58617","kind":"paragraph","spans":[{"id":"spn-87942","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-58618","kind":"heading","level":2,"spans":[{"id":"spn-87943","text":"Core Concepts"}]},{"id":"blk-58619","kind":"heading","level":3,"spans":[{"id":"spn-87944","text":"Containment Trees"}]},{"id":"blk-58620","kind":"paragraph","spans":[{"id":"spn-87945","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-58621","kind":"heading","level":3,"spans":[{"id":"spn-87946","text":"Monotonic Policy Inheritance"}]},{"id":"blk-58622","kind":"paragraph","spans":[{"id":"spn-87947","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-58623","items":[{"blocks":[{"id":"blk-58625","kind":"paragraph","spans":[{"id":"spn-87948","marks":["bold"],"text":"Booleans"},{"id":"spn-87949","text":" → AND (child can only disable)"}]}],"id":"blk-58624","kind":"list-item"},{"blocks":[{"id":"blk-58627","kind":"paragraph","spans":[{"id":"spn-87950","marks":["bold"],"text":"Numerics"},{"id":"spn-87951","text":" → MIN (child can only lower limits)"}]}],"id":"blk-58626","kind":"list-item"},{"blocks":[{"id":"blk-58629","kind":"paragraph","spans":[{"id":"spn-87952","marks":["bold"],"text":"Allow-lists"},{"id":"spn-87953","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-58628","kind":"list-item"},{"blocks":[{"id":"blk-58631","kind":"paragraph","spans":[{"id":"spn-87954","marks":["bold"],"text":"Deny-lists"},{"id":"spn-87955","text":" → UNION (child can only add)"}]}],"id":"blk-58630","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58632","kind":"paragraph","spans":[{"id":"spn-87956","text":"Privilege escalation is impossible by design."}]},{"id":"blk-58633","kind":"heading","level":3,"spans":[{"id":"spn-87957","text":"Append-Only Audit"}]},{"id":"blk-58634","kind":"paragraph","spans":[{"id":"spn-87958","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-58635","kind":"heading","level":3,"spans":[{"id":"spn-87959","text":"Goal-Aware Governance"}]},{"id":"blk-58636","kind":"paragraph","spans":[{"id":"spn-87960","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-87961","marks":["code"],"text":"goal_id"},{"id":"spn-87962","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-58637","kind":"heading","level":2,"spans":[{"id":"spn-87963","text":"Documentation Map"}]},{"id":"blk-58638","kind":"paragraph","spans":[{"id":"spn-87964","marks":["bold"],"text":"Homepages"}]},{"id":"blk-58639","items":[{"blocks":[{"id":"blk-58641","kind":"paragraph","spans":[{"id":"spn-87965","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-58640","kind":"list-item"},{"blocks":[{"id":"blk-58643","kind":"paragraph","spans":[{"id":"spn-87966","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-58642","kind":"list-item"},{"blocks":[{"id":"blk-58645","kind":"paragraph","spans":[{"id":"spn-87967","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-58644","kind":"list-item"},{"blocks":[{"id":"blk-58647","kind":"paragraph","spans":[{"id":"spn-87968","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-58646","kind":"list-item"},{"blocks":[{"id":"blk-58649","kind":"paragraph","spans":[{"id":"spn-87969","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-58648","kind":"list-item"},{"blocks":[{"id":"blk-58651","kind":"paragraph","spans":[{"id":"spn-87970","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-58650","kind":"list-item"},{"blocks":[{"id":"blk-58653","kind":"paragraph","spans":[{"id":"spn-87971","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-58652","kind":"list-item"},{"blocks":[{"id":"blk-58655","kind":"paragraph","spans":[{"id":"spn-87972","marks":[{"kind":"link","predicate":"cites","target":"https://deliberati