{"bendscript":"0.1","blocks":[{"id":"blk-37287","kind":"heading","level":1,"spans":[{"id":"spn-41674","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-37289","kind":"paragraph","spans":[{"id":"spn-41675","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-37288","kind":"quote"},{"blocks":[{"id":"blk-37291","kind":"paragraph","spans":[{"id":"spn-41676","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-41677","text":" · "},{"id":"spn-41678","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-41679","text":" · "},{"id":"spn-41680","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-41681","text":" · "},{"id":"spn-41682","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-37290","kind":"quote"},{"id":"blk-37292","kind":"paragraph","spans":[{"id":"spn-41683","text":"Welcome to the documentation hub for "},{"id":"spn-41684","marks":["bold"],"text":"Delegatic"},{"id":"spn-41685","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-37293","kind":"paragraph","spans":[{"id":"spn-41686","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-37294","kind":"paragraph","spans":[{"id":"spn-41687","text":"---"}]},{"id":"blk-37295","kind":"heading","level":2,"spans":[{"id":"spn-41688","text":"Core Concepts"}]},{"id":"blk-37296","kind":"heading","level":3,"spans":[{"id":"spn-41689","text":"Containment Trees"}]},{"id":"blk-37297","kind":"paragraph","spans":[{"id":"spn-41690","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-37298","kind":"heading","level":3,"spans":[{"id":"spn-41691","text":"Monotonic Policy Inheritance"}]},{"id":"blk-37299","kind":"paragraph","spans":[{"id":"spn-41692","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-37300","items":[{"blocks":[{"id":"blk-37302","kind":"paragraph","spans":[{"id":"spn-41693","marks":["bold"],"text":"Booleans"},{"id":"spn-41694","text":" → AND (child can only disable)"}]}],"id":"blk-37301","kind":"list-item"},{"blocks":[{"id":"blk-37304","kind":"paragraph","spans":[{"id":"spn-41695","marks":["bold"],"text":"Numerics"},{"id":"spn-41696","text":" → MIN (child can only lower limits)"}]}],"id":"blk-37303","kind":"list-item"},{"blocks":[{"id":"blk-37306","kind":"paragraph","spans":[{"id":"spn-41697","marks":["bold"],"text":"Allow-lists"},{"id":"spn-41698","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-37305","kind":"list-item"},{"blocks":[{"id":"blk-37308","kind":"paragraph","spans":[{"id":"spn-41699","marks":["bold"],"text":"Deny-lists"},{"id":"spn-41700","text":" → UNION (child can only add)"}]}],"id":"blk-37307","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37309","kind":"paragraph","spans":[{"id":"spn-41701","text":"Privilege escalation is impossible by design."}]},{"id":"blk-37310","kind":"heading","level":3,"spans":[{"id":"spn-41702","text":"Append-Only Audit"}]},{"id":"blk-37311","kind":"paragraph","spans":[{"id":"spn-41703","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-37312","kind":"heading","level":3,"spans":[{"id":"spn-41704","text":"Goal-Aware Governance"}]},{"id":"blk-37313","kind":"paragraph","spans":[{"id":"spn-41705","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-41706","marks":["code"],"text":"goal_id"},{"id":"spn-41707","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-37314","kind":"paragraph","spans":[{"id":"spn-41708","text":"---"}]},{"id":"blk-37315","kind":"heading","level":2,"spans":[{"id":"spn-41709","text":"Documentation Map"}]},{"id":"blk-37316","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-37317","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-37318","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Delegatic Docs\n\nspec/README"},{"id":"blk-37319","kind":"paragraph","spans":[{"id":"spn-41710","text":"---"}]},{"id":"blk-37320","kind":"heading","level":2,"spans":[{"id":"spn-41711","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-37322","spans":[{"id":"spn-41712","text":"Component"}]},{"id":"blk-37323","spans":[{"id":"spn-41713","text":"Role"}]},{"id":"blk-37324","spans":[{"id":"spn-41714","text":"OTP Pattern"}]}],"id":"blk-37321","kind":"table","rows":[[{"id":"blk-37325","spans":[{"id":"spn-41715","marks":["bold"],"text":"OrgNode"}]},{"id":"blk-37326","spans":[{"id":"spn-41716","text":"One org. Holds local policy, caches effective policy."}]},{"id":"blk-37327","spans":[{"id":"spn-41717","text":"GenServer"}]}],[{"id":"blk-37328","spans":[{"id":"spn-41718","marks":["bold"],"text":"PolicyEngine"}]},{"id":"blk-37329","spans":[{"id":"spn-41719","text":"Computes effective policies, enforces monotonic inheritance."}]},{"id":"blk-37330","spans":[{"id":"spn-41720","text":"GenServer + ETS"}]}],[{"id":"blk-37331","spans":[{"id":"spn-41721","marks":["bold"],"text":"AuditWriter"}]},{"id":"blk-37332","spans":[{"id":"spn-41722","text":"Batched, append-only audit event writes."}]},{"id":"blk-37333","spans":[{"id":"spn-41723","text":"Broadway pipeline"}]}],[{"id":"blk-37334","spans":[{"id":"spn-41724","marks":["bold"],"text":"OrgTreeCache"}]},{"id":"blk-37335","spans":[{"id":"spn-41725","text":"In-memory tree for cycle detection and path lookups."}]},{"id":"blk-37336","spans":[{"id":"spn-41726","text":"GenServer + ETS"}]}],[{"id":"blk-37337","spans":[{"id":"spn-41727","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-37338","spans":[{"id":"spn-41728","text":"Real-time org tree, policy editor, audit log viewer."}]},{"id":"blk-37339","spans":[{"id":"spn-41729","text":"Phoenix LiveView"}]}]]},{"id":"blk-37340","kind":"paragraph","spans":[{"id":"spn-41730","text":"---"}]},{"id":"blk-37341","kind":"heading","level":2,"spans":[{"id":"spn-41731","text":"Performance Targets"}]},{"head":[{"id":"blk-37343","spans":[{"id":"spn-41732","text":"Metric"}]},{"id":"blk-37344","spans":[{"id":"spn-41733","text":"Target"}]}],"id":"blk-37342","kind":"table","rows":[[{"id":"blk-37345","spans":[{"id":"spn-41734","text":"Effective policy lookup (ETS hot)"}]},{"id":"blk-37346","spans":[{"id":"spn-41735","text":"< 5us p99"}]}],[{"id":"blk-37347","spans":[{"id":"spn-41736","text":"Effective policy computation (cold)"}]},{"id":"blk-37348","spans":[{"id":"spn-41737","text":"< 20ms p99"}]}],[{"id":"blk-37349","spans":[{"id":"spn-41738","text":"Cycle detection (depth-50 tree)"}]},{"id":"blk-37350","spans":[{"id":"spn-41739","text":"< 1ms"}]}],[{"id":"blk-37351","spans":[{"id":"spn-41740","text":"Audit write throughput (Broadway)"}]},{"id":"blk-37352","spans":[{"id":"spn-41741","text":"> 10K events/sec"}]}]]},{"id":"blk-37353","kind":"paragraph","spans":[{"id":"spn-41742","text":"---"}]},{"id":"blk-37354","kind":"heading","level":2,"spans":[{"id":"spn-41743","text":"Tech Stack"}]},{"head":[{"id":"blk-37356","spans":[{"id":"spn-41744","text":"Layer"}]},{"id":"blk-37357","spans":[{"id":"spn-41745","text":"Technology"}]}],"id":"blk-37355","kind":"table","rows":[[{"id":"blk-37358","spans":[{"id":"spn-41746","text":"Language"}]},{"id":"blk-37359","spans":[{"id":"spn-41747","text":"Elixir 1.17+"}]}],[{"id":"blk-37360","spans":[{"id":"spn-41748","text":"Framework"}]},{"id":"blk-37361","spans":[{"id":"spn-41749","text":"Phoenix 1.8+ (LiveView for dashboard)"}]}],[{"id":"blk-37362","spans":[{"id":"spn-41750","text":"Database"}]},{"id":"blk-37363","spans":[{"id":"spn-41751","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-37364","spans":[{"id":"spn-41752","text":"Hot Cache"}]},{"id":"blk-37365","spans":[{"id":"spn-41753","text":"ETS (effective policies, org tree, memberships)"}]}],[{"id":"blk-37366","spans":[{"id":"spn-41754","text":"Audit Pipeline"}]},{"id":"blk-37367","spans":[{"id":"spn-41755","text":"Broadway (batched inserts, back-pressure)"}]}],[{"id":"blk-37368","spans":[{"id":"spn-41756","text":"Background Jobs"}]},{"id":"blk-37369","spans":[{"id":"spn-41757","text":"Oban (webhooks, compliance exports)"}]}],[{"id":"blk-37370","spans":[{"id":"spn-41758","text":"Telemetry"}]},{"id":"blk-37371","spans":[{"id":"spn-41759","text":":telemetry + Prometheus"}]}]]},{"id":"blk-37372","kind":"paragraph","spans":[{"id":"spn-41760","text":"---"}]},{"id":"blk-37373","kind":"heading","level":2,"spans":[{"id":"spn-41761","text":"Ecosystem Role"}]},{"id":"blk-37374","kind":"paragraph","spans":[{"id":"spn-41762","text":"Delegatic is the "},{"id":"spn-41763","marks":["bold"],"text":"governance layer"},{"id":"spn-41764","text":" of the [&] stack:"}]},{"head":[{"id":"blk-37376","spans":[{"id":"spn-41765","text":"Product"}]},{"id":"blk-37377","spans":[{"id":"spn-41766","text":"Relationship"}]}],"id":"blk-37375","kind":"table","rows":[[{"id":"blk-37378","spans":[{"id":"spn-41767","marks":["bold"],"text":"Agentelic"}]},{"id":"blk-37379","spans":[{"id":"spn-41768","text":"Telespace attachments — agents registered under orgs"}]}],[{"id":"blk-37380","spans":[{"id":"spn-41769","marks":["bold"],"text":"AgenTroMatic"}]},{"id":"blk-37381","spans":[{"id":"spn-41770","text":"Policy check API — deliberations respect governance"}]}],[{"id":"blk-37382","spans":[{"id":"spn-41771","marks":["bold"],"text":"WebHost.Systems"}]},{"id":"blk-37383","spans":[{"id":"spn-41772","text":"Deployment gates — deploy requires policy approval"}]}],[{"id":"blk-37384","spans":[{"id":"spn-41773","marks":["bold"],"text":"FleetPrompt"}]},{"id":"blk-37385","spans":[{"id":"spn-41774","text":"Install authorization — marketplace installs need org permission"}]}],[{"id":"blk-37386","spans":[{"id":"spn-41775","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-37387","spans":[{"id":"spn-41776","text":"Goal references — actions scoped to durable intent"}]}]]},{"id":"blk-37388","kind":"paragraph","spans":[{"id":"spn-41777","text":"---"}]},{"id":"blk-37389","kind":"heading","level":2,"spans":[{"id":"spn-41778","text":"Project Links"}]},{"id":"blk-37390","items":[{"blocks":[{"id":"blk-37392","kind":"paragraph","spans":[{"id":"spn-41779","marks":["bold"],"text":"Spec:"},{"id":"spn-41780","text":" "},