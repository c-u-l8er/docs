{"bendscript":"0.1","blocks":[{"id":"blk-58600","kind":"heading","level":1,"spans":[{"id":"spn-87877","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-58602","kind":"paragraph","spans":[{"id":"spn-87878","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-58601","kind":"quote"},{"blocks":[{"id":"blk-58604","kind":"paragraph","spans":[{"id":"spn-87879","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-87880","text":" · "},{"id":"spn-87881","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-87882","text":" · "},{"id":"spn-87883","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-87884","text":" · "},{"id":"spn-87885","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-58603","kind":"quote"},{"id":"blk-58605","kind":"paragraph","spans":[{"id":"spn-87886","text":"Welcome to the documentation hub for "},{"id":"spn-87887","marks":["bold"],"text":"Delegatic"},{"id":"spn-87888","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-58606","kind":"paragraph","spans":[{"id":"spn-87889","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-58607","kind":"heading","level":2,"spans":[{"id":"spn-87890","text":"Core Concepts"}]},{"id":"blk-58608","kind":"heading","level":3,"spans":[{"id":"spn-87891","text":"Containment Trees"}]},{"id":"blk-58609","kind":"paragraph","spans":[{"id":"spn-87892","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-58610","kind":"heading","level":3,"spans":[{"id":"spn-87893","text":"Monotonic Policy Inheritance"}]},{"id":"blk-58611","kind":"paragraph","spans":[{"id":"spn-87894","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-58612","items":[{"blocks":[{"id":"blk-58614","kind":"paragraph","spans":[{"id":"spn-87895","marks":["bold"],"text":"Booleans"},{"id":"spn-87896","text":" → AND (child can only disable)"}]}],"id":"blk-58613","kind":"list-item"},{"blocks":[{"id":"blk-58616","kind":"paragraph","spans":[{"id":"spn-87897","marks":["bold"],"text":"Numerics"},{"id":"spn-87898","text":" → MIN (child can only lower limits)"}]}],"id":"blk-58615","kind":"list-item"},{"blocks":[{"id":"blk-58618","kind":"paragraph","spans":[{"id":"spn-87899","marks":["bold"],"text":"Allow-lists"},{"id":"spn-87900","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-58617","kind":"list-item"},{"blocks":[{"id":"blk-58620","kind":"paragraph","spans":[{"id":"spn-87901","marks":["bold"],"text":"Deny-lists"},{"id":"spn-87902","text":" → UNION (child can only add)"}]}],"id":"blk-58619","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58621","kind":"paragraph","spans":[{"id":"spn-87903","text":"Privilege escalation is impossible by design."}]},{"id":"blk-58622","kind":"heading","level":3,"spans":[{"id":"spn-87904","text":"Append-Only Audit"}]},{"id":"blk-58623","kind":"paragraph","spans":[{"id":"spn-87905","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-58624","kind":"heading","level":3,"spans":[{"id":"spn-87906","text":"Goal-Aware Governance"}]},{"id":"blk-58625","kind":"paragraph","spans":[{"id":"spn-87907","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-87908","marks":["code"],"text":"goal_id"},{"id":"spn-87909","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-58626","kind":"heading","level":2,"spans":[{"id":"spn-87910","text":"Documentation Map"}]},{"id":"blk-58627","kind":"paragraph","spans":[{"id":"spn-87911","marks":["bold"],"text":"Homepages"}]},{"id":"blk-58628","items":[{"blocks":[{"id":"blk-58630","kind":"paragraph","spans":[{"id":"spn-87912","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-58629","kind":"list-item"},{"blocks":[{"id":"blk-58632","kind":"paragraph","spans":[{"id":"spn-87913","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-58631","kind":"list-item"},{"blocks":[{"id":"blk-58634","kind":"paragraph","spans":[{"id":"spn-87914","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-58633","kind":"list-item"},{"blocks":[{"id":"blk-58636","kind":"paragraph","spans":[{"id":"spn-87915","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-58635","kind":"list-item"},{"blocks":[{"id":"blk-58638","kind":"paragraph","spans":[{"id":"spn-87916","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-58637","kind":"list-item"},{"blocks":[{"id":"blk-58640","kind":"paragraph","spans":[{"id":"spn-87917","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-58639","kind":"list-item"},{"blocks":[{"id":"blk-58642","kind":"paragraph","spans":[{"id":"spn-87918","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-58641","kind":"list-item"},{"blocks":[{"id":"blk-58644","kind":"paragraph","spans":[{"id":"spn-87919","marks":[{"kind":"link","predicate":"cites","target":"https://deliberati