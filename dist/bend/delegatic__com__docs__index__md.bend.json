{"bendscript":"0.1","blocks":[{"id":"blk-59507","kind":"heading","level":1,"spans":[{"id":"spn-90540","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-59509","kind":"paragraph","spans":[{"id":"spn-90541","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-59508","kind":"quote"},{"blocks":[{"id":"blk-59511","kind":"paragraph","spans":[{"id":"spn-90542","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-90543","text":" · "},{"id":"spn-90544","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-90545","text":" · "},{"id":"spn-90546","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-90547","text":" · "},{"id":"spn-90548","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-59510","kind":"quote"},{"id":"blk-59512","kind":"paragraph","spans":[{"id":"spn-90549","text":"Welcome to the documentation hub for "},{"id":"spn-90550","marks":["bold"],"text":"Delegatic"},{"id":"spn-90551","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-59513","kind":"paragraph","spans":[{"id":"spn-90552","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-59514","kind":"heading","level":2,"spans":[{"id":"spn-90553","text":"Core Concepts"}]},{"id":"blk-59515","kind":"heading","level":3,"spans":[{"id":"spn-90554","text":"Containment Trees"}]},{"id":"blk-59516","kind":"paragraph","spans":[{"id":"spn-90555","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-59517","kind":"heading","level":3,"spans":[{"id":"spn-90556","text":"Monotonic Policy Inheritance"}]},{"id":"blk-59518","kind":"paragraph","spans":[{"id":"spn-90557","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-59519","items":[{"blocks":[{"id":"blk-59521","kind":"paragraph","spans":[{"id":"spn-90558","marks":["bold"],"text":"Booleans"},{"id":"spn-90559","text":" → AND (child can only disable)"}]}],"id":"blk-59520","kind":"list-item"},{"blocks":[{"id":"blk-59523","kind":"paragraph","spans":[{"id":"spn-90560","marks":["bold"],"text":"Numerics"},{"id":"spn-90561","text":" → MIN (child can only lower limits)"}]}],"id":"blk-59522","kind":"list-item"},{"blocks":[{"id":"blk-59525","kind":"paragraph","spans":[{"id":"spn-90562","marks":["bold"],"text":"Allow-lists"},{"id":"spn-90563","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-59524","kind":"list-item"},{"blocks":[{"id":"blk-59527","kind":"paragraph","spans":[{"id":"spn-90564","marks":["bold"],"text":"Deny-lists"},{"id":"spn-90565","text":" → UNION (child can only add)"}]}],"id":"blk-59526","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-59528","kind":"paragraph","spans":[{"id":"spn-90566","text":"Privilege escalation is impossible by design."}]},{"id":"blk-59529","kind":"heading","level":3,"spans":[{"id":"spn-90567","text":"Append-Only Audit"}]},{"id":"blk-59530","kind":"paragraph","spans":[{"id":"spn-90568","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-59531","kind":"heading","level":3,"spans":[{"id":"spn-90569","text":"Goal-Aware Governance"}]},{"id":"blk-59532","kind":"paragraph","spans":[{"id":"spn-90570","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-90571","marks":["code"],"text":"goal_id"},{"id":"spn-90572","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-59533","kind":"heading","level":2,"spans":[{"id":"spn-90573","text":"Documentation Map"}]},{"id":"blk-59534","kind":"paragraph","spans":[{"id":"spn-90574","marks":["bold"],"text":"Homepages"}]},{"id":"blk-59535","items":[{"blocks":[{"id":"blk-59537","kind":"paragraph","spans":[{"id":"spn-90575","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-59536","kind":"list-item"},{"blocks":[{"id":"blk-59539","kind":"paragraph","spans":[{"id":"spn-90576","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-59538","kind":"list-item"},{"blocks":[{"id":"blk-59541","kind":"paragraph","spans":[{"id":"spn-90577","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-59540","kind":"list-item"},{"blocks":[{"id":"blk-59543","kind":"paragraph","spans":[{"id":"spn-90578","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-59542","kind":"list-item"},{"blocks":[{"id":"blk-59545","kind":"paragraph","spans":[{"id":"spn-90579","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-59544","kind":"list-item"},{"blocks":[{"id":"blk-59547","kind":"paragraph","spans":[{"id":"spn-90580","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-59546","kind":"list-item"},{"blocks":[{"id":"blk-59549","kind":"paragraph","spans":[{"id":"spn-90581","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-59548","kind":"list-item"},{"blocks":[{"id":"blk-59551","kind":"paragraph","spans":[{"id":"spn-90582","marks":[{"kind":"link","predicate":"cites","target":"https://deliberati