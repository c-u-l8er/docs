{"bendscript":"0.1","blocks":[{"id":"blk-37773","kind":"heading","level":1,"spans":[{"id":"spn-42790","text":"Delegatic Documentation"}]},{"blocks":[{"id":"blk-37775","kind":"paragraph","spans":[{"id":"spn-42791","marks":["bold"],"text":"Structure first. Then delegate."}]}],"id":"blk-37774","kind":"quote"},{"blocks":[{"id":"blk-37777","kind":"paragraph","spans":[{"id":"spn-42792","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-42793","text":" · "},{"id":"spn-42794","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-42795","text":" · "},{"id":"spn-42796","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-42797","text":" · "},{"id":"spn-42798","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-37776","kind":"quote"},{"id":"blk-37778","kind":"paragraph","spans":[{"id":"spn-42799","text":"Welcome to the documentation hub for "},{"id":"spn-42800","marks":["bold"],"text":"Delegatic"},{"id":"spn-42801","text":" — the governance and orchestration layer for multi-agent AI systems. Delegatic defines who can do what, enforces policy boundaries, manages organizational hierarchy, and provides immutable audit trails for every decision."}]},{"id":"blk-37779","kind":"paragraph","spans":[{"id":"spn-42802","text":"Delegatic does not execute tasks, host agents, or run workflows — it defines the structure within which all other [&] products operate."}]},{"id":"blk-37780","kind":"paragraph","spans":[{"id":"spn-42803","text":"---"}]},{"id":"blk-37781","kind":"heading","level":2,"spans":[{"id":"spn-42804","text":"Core Concepts"}]},{"id":"blk-37782","kind":"heading","level":3,"spans":[{"id":"spn-42805","text":"Containment Trees"}]},{"id":"blk-37783","kind":"paragraph","spans":[{"id":"spn-42806","text":"Organizations nest in a strict tree. No cycles. No DAGs. Structure IS the authorization model. Each org is a GenServer process supervised by its parent."}]},{"id":"blk-37784","kind":"heading","level":3,"spans":[{"id":"spn-42807","text":"Monotonic Policy Inheritance"}]},{"id":"blk-37785","kind":"paragraph","spans":[{"id":"spn-42808","text":"Children can tighten but never widen parent restrictions:"}]},{"id":"blk-37786","items":[{"blocks":[{"id":"blk-37788","kind":"paragraph","spans":[{"id":"spn-42809","marks":["bold"],"text":"Booleans"},{"id":"spn-42810","text":" → AND (child can only disable)"}]}],"id":"blk-37787","kind":"list-item"},{"blocks":[{"id":"blk-37790","kind":"paragraph","spans":[{"id":"spn-42811","marks":["bold"],"text":"Numerics"},{"id":"spn-42812","text":" → MIN (child can only lower limits)"}]}],"id":"blk-37789","kind":"list-item"},{"blocks":[{"id":"blk-37792","kind":"paragraph","spans":[{"id":"spn-42813","marks":["bold"],"text":"Allow-lists"},{"id":"spn-42814","text":" → INTERSECTION (child can only narrow)"}]}],"id":"blk-37791","kind":"list-item"},{"blocks":[{"id":"blk-37794","kind":"paragraph","spans":[{"id":"spn-42815","marks":["bold"],"text":"Deny-lists"},{"id":"spn-42816","text":" → UNION (child can only add)"}]}],"id":"blk-37793","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37795","kind":"paragraph","spans":[{"id":"spn-42817","text":"Privilege escalation is impossible by design."}]},{"id":"blk-37796","kind":"heading","level":3,"spans":[{"id":"spn-42818","text":"Append-Only Audit"}]},{"id":"blk-37797","kind":"paragraph","spans":[{"id":"spn-42819","text":"Every mutation is logged immutably with actor, timestamp, and provenance. Audit events are processed through a Broadway pipeline for guaranteed delivery."}]},{"id":"blk-37798","kind":"heading","level":3,"spans":[{"id":"spn-42820","text":"Goal-Aware Governance"}]},{"id":"blk-37799","kind":"paragraph","spans":[{"id":"spn-42821","text":"Delegatic stores references to Graphonomous GoalGraph "},{"id":"spn-42822","marks":["code"],"text":"goal_id"},{"id":"spn-42823","text":"s so that task requests, workflow runs, and sensitive mutations can be authorized and audited in the context of an explicit goal."}]},{"id":"blk-37800","kind":"paragraph","spans":[{"id":"spn-42824","text":"---"}]},{"id":"blk-37801","kind":"heading","level":2,"spans":[{"id":"spn-42825","text":"Documentation Map"}]},{"id":"blk-37802","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-37803","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-37804","kind":"code","language":"text","text":":maxdepth: 2\n:caption: Delegatic Docs\n\nspec/README"},{"id":"blk-37805","kind":"paragraph","spans":[{"id":"spn-42826","text":"---"}]},{"id":"blk-37806","kind":"heading","level":2,"spans":[{"id":"spn-42827","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-37808","spans":[{"id":"spn-42828","text":"Component"}]},{"id":"blk-37809","spans":[{"id":"spn-42829","text":"Role"}]},{"id":"blk-37810","spans":[{"id":"spn-42830","text":"OTP Pattern"}]}],"id":"blk-37807","kind":"table","rows":[[{"id":"blk-37811","spans":[{"id":"spn-42831","marks":["bold"],"text":"OrgNode"}]},{"id":"blk-37812","spans":[{"id":"spn-42832","text":"One org. Holds local policy, caches effective policy."}]},{"id":"blk-37813","spans":[{"id":"spn-42833","text":"GenServer"}]}],[{"id":"blk-37814","spans":[{"id":"spn-42834","marks":["bold"],"text":"PolicyEngine"}]},{"id":"blk-37815","spans":[{"id":"spn-42835","text":"Computes effective policies, enforces monotonic inheritance."}]},{"id":"blk-37816","spans":[{"id":"spn-42836","text":"GenServer + ETS"}]}],[{"id":"blk-37817","spans":[{"id":"spn-42837","marks":["bold"],"text":"AuditWriter"}]},{"id":"blk-37818","spans":[{"id":"spn-42838","text":"Batched, append-only audit event writes."}]},{"id":"blk-37819","spans":[{"id":"spn-42839","text":"Broadway pipeline"}]}],[{"id":"blk-37820","spans":[{"id":"spn-42840","marks":["bold"],"text":"OrgTreeCache"}]},{"id":"blk-37821","spans":[{"id":"spn-42841","text":"In-memory tree for cycle detection and path lookups."}]},{"id":"blk-37822","spans":[{"id":"spn-42842","text":"GenServer + ETS"}]}],[{"id":"blk-37823","spans":[{"id":"spn-42843","marks":["bold"],"text":"Dashboard"}]},{"id":"blk-37824","spans":[{"id":"spn-42844","text":"Real-time org tree, policy editor, audit log viewer."}]},{"id":"blk-37825","spans":[{"id":"spn-42845","text":"Phoenix LiveView"}]}]]},{"id":"blk-37826","kind":"paragraph","spans":[{"id":"spn-42846","text":"---"}]},{"id":"blk-37827","kind":"heading","level":2,"spans":[{"id":"spn-42847","text":"Performance Targets"}]},{"head":[{"id":"blk-37829","spans":[{"id":"spn-42848","text":"Metric"}]},{"id":"blk-37830","spans":[{"id":"spn-42849","text":"Target"}]}],"id":"blk-37828","kind":"table","rows":[[{"id":"blk-37831","spans":[{"id":"spn-42850","text":"Effective policy lookup (ETS hot)"}]},{"id":"blk-37832","spans":[{"id":"spn-42851","text":"< 5us p99"}]}],[{"id":"blk-37833","spans":[{"id":"spn-42852","text":"Effective policy computation (cold)"}]},{"id":"blk-37834","spans":[{"id":"spn-42853","text":"< 20ms p99"}]}],[{"id":"blk-37835","spans":[{"id":"spn-42854","text":"Cycle detection (depth-50 tree)"}]},{"id":"blk-37836","spans":[{"id":"spn-42855","text":"< 1ms"}]}],[{"id":"blk-37837","spans":[{"id":"spn-42856","text":"Audit write throughput (Broadway)"}]},{"id":"blk-37838","spans":[{"id":"spn-42857","text":"> 10K events/sec"}]}]]},{"id":"blk-37839","kind":"paragraph","spans":[{"id":"spn-42858","text":"---"}]},{"id":"blk-37840","kind":"heading","level":2,"spans":[{"id":"spn-42859","text":"Tech Stack"}]},{"head":[{"id":"blk-37842","spans":[{"id":"spn-42860","text":"Layer"}]},{"id":"blk-37843","spans":[{"id":"spn-42861","text":"Technology"}]}],"id":"blk-37841","kind":"table","rows":[[{"id":"blk-37844","spans":[{"id":"spn-42862","text":"Language"}]},{"id":"blk-37845","spans":[{"id":"spn-42863","text":"Elixir 1.17+"}]}],[{"id":"blk-37846","spans":[{"id":"spn-42864","text":"Framework"}]},{"id":"blk-37847","spans":[{"id":"spn-42865","text":"Phoenix 1.8+ (LiveView for dashboard)"}]}],[{"id":"blk-37848","spans":[{"id":"spn-42866","text":"Database"}]},{"id":"blk-37849","spans":[{"id":"spn-42867","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-37850","spans":[{"id":"spn-42868","text":"Hot Cache"}]},{"id":"blk-37851","spans":[{"id":"spn-42869","text":"ETS (effective policies, org tree, memberships)"}]}],[{"id":"blk-37852","spans":[{"id":"spn-42870","text":"Audit Pipeline"}]},{"id":"blk-37853","spans":[{"id":"spn-42871","text":"Broadway (batched inserts, back-pressure)"}]}],[{"id":"blk-37854","spans":[{"id":"spn-42872","text":"Background Jobs"}]},{"id":"blk-37855","spans":[{"id":"spn-42873","text":"Oban (webhooks, compliance exports)"}]}],[{"id":"blk-37856","spans":[{"id":"spn-42874","text":"Telemetry"}]},{"id":"blk-37857","spans":[{"id":"spn-42875","text":":telemetry + Prometheus"}]}]]},{"id":"blk-37858","kind":"paragraph","spans":[{"id":"spn-42876","text":"---"}]},{"id":"blk-37859","kind":"heading","level":2,"spans":[{"id":"spn-42877","text":"Ecosystem Role"}]},{"id":"blk-37860","kind":"paragraph","spans":[{"id":"spn-42878","text":"Delegatic is the "},{"id":"spn-42879","marks":["bold"],"text":"governance layer"},{"id":"spn-42880","text":" of the [&] stack:"}]},{"head":[{"id":"blk-37862","spans":[{"id":"spn-42881","text":"Product"}]},{"id":"blk-37863","spans":[{"id":"spn-42882","text":"Relationship"}]}],"id":"blk-37861","kind":"table","rows":[[{"id":"blk-37864","spans":[{"id":"spn-42883","marks":["bold"],"text":"Agentelic"}]},{"id":"blk-37865","spans":[{"id":"spn-42884","text":"Telespace attachments — agents registered under orgs"}]}],[{"id":"blk-37866","spans":[{"id":"spn-42885","marks":["bold"],"text":"AgenTroMatic"}]},{"id":"blk-37867","spans":[{"id":"spn-42886","text":"Policy check API — deliberations respect governance"}]}],[{"id":"blk-37868","spans":[{"id":"spn-42887","marks":["bold"],"text":"WebHost.Systems"}]},{"id":"blk-37869","spans":[{"id":"spn-42888","text":"Deployment gates — deploy requires policy approval"}]}],[{"id":"blk-37870","spans":[{"id":"spn-42889","marks":["bold"],"text":"FleetPrompt"}]},{"id":"blk-37871","spans":[{"id":"spn-42890","text":"Install authorization — marketplace installs need org permission"}]}],[{"id":"blk-37872","spans":[{"id":"spn-42891","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-37873","spans":[{"id":"spn-42892","text":"Goal references — actions scoped to durable intent"}]}]]},{"id":"blk-37874","kind":"paragraph","spans":[{"id":"spn-42893","text":"---"}]},{"id":"blk-37875","kind":"heading","level":2,"spans":[{"id":"spn-42894","text":"Project Links"}]},{"id":"blk-37876","items":[{"blocks":[{"id":"blk-37878","kind":"paragraph","spans":[{"id":"spn-42895","marks":["bold"],"text":"Spec:"},{"id":"spn-42896","text":" "},