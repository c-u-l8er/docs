{"bendscript":"0.1","blocks":[{"id":"blk-22258","kind":"heading","level":1,"spans":[{"id":"spn-22064","text":"PRISM × box-and-box — Arithmetic Integration Review"}]},{"id":"blk-22259","kind":"paragraph","spans":[{"id":"spn-22065","marks":["bold"],"text":"Status:"},{"id":"spn-22066","text":" review (no scoring break) · "},{"id":"spn-22067","marks":["bold"],"text":"Kernel:"},{"id":"spn-22068","text":" "},{"id":"spn-22069","marks":["code"],"text":"box-and-box"},{"id":"spn-22070","text":" v0.8.0 (8 rungs, 97 laws) "},{"id":"spn-22071","marks":["bold"],"text":"Scope:"},{"id":"spn-22072","text":" how the PRISM benchmark engine (OS-009) relates to the [&] governance kernel, which parts of the scoring pipeline are already the kernel's "},{"id":"spn-22073","marks":["bold"],"text":"axiological"},{"id":"spn-22074","text":" rung in disguise, and what additive wiring would make the correspondence exact."}]},{"id":"blk-22260","kind":"heading","level":2,"spans":[{"id":"spn-22075","text":"TL;DR"}]},{"id":"blk-22261","kind":"paragraph","spans":[{"id":"spn-22076","text":"PRISM "},{"id":"spn-22077","marks":["italic"],"text":"is"},{"id":"spn-22078","text":" the kernel's "},{"id":"spn-22079","marks":["bold"],"text":"axiological rung (rung 2, `score.mjs`) at scale."},{"id":"spn-22080","text":" Where the kernel ranks one decision ("},{"id":"spn-22081","marks":["code"],"text":"feasible ▸ permitted ▸ best"},{"id":"spn-22082","text":"), PRISM ranks "},{"id":"spn-22083","marks":["italic"],"text":"systems"},{"id":"spn-22084","text":" across many decisions. The two are the same algebra at different cardinalities, so the integration is mostly "},{"id":"spn-22085","marks":["bold"],"text":"naming + one optional semiring swap"},{"id":"spn-22086","text":", not a rewrite."}]},{"id":"blk-22262","kind":"paragraph","spans":[{"id":"spn-22087","text":"Three concrete touch-points, all additive:"}]},{"id":"blk-22263","items":[{"blocks":[{"id":"blk-22265","kind":"paragraph","spans":[{"id":"spn-22088","marks":["bold"],"text":"Composite scoring"},{"id":"spn-22089","text":" ("},{"id":"spn-22090","marks":["code"],"text":"Judge.Aggregator.compute_composite/2"},{"id":"spn-22091","text":") is already a"}]}],"id":"blk-22264","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22266","kind":"paragraph","spans":[{"id":"spn-22092","marks":["bold"],"text":"probability-semiring weighted sum"},{"id":"spn-22093","text":" — name it as rung 2."}]},{"id":"blk-22267","items":[{"blocks":[{"id":"blk-22269","kind":"paragraph","spans":[{"id":"spn-22094","marks":["bold"],"text":"Meta-judge \"reject\""},{"id":"spn-22095","text":" ("},{"id":"spn-22096","marks":["code"],"text":"Judge.Aggregator.quality_weight/1"},{"id":"spn-22097","text":") is already the kernel's"}]}],"id":"blk-22268","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-22270","kind":"paragraph","spans":[{"id":"spn-22098","marks":["bold"],"text":"`0̲` annihilation / `consume()` veto"},{"id":"spn-22099","text":" — a rejected judgment is annihilated, not averaged. Name it as the deontic floor under the score."}]},{"id":"blk-22271","items":[{"blocks":[{"id":"blk-22273","kind":"paragraph","spans":[{"id":"spn-22100","marks":["bold"],"text":"Per-pass means"},{"id":"spn-22101","text":" ("},{"id":"spn-22102","marks":["code"],"text":"Sequence.Scorer.per_pass_means/1"},{"id":"spn-22103","text":") use the "},{"id":"spn-22104","marks":["italic"],"text":"arithmetic"},{"id":"spn-22105","text":" mean. An"}]}],"id":"blk-22272","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-22274","kind":"paragraph","spans":[{"id":"spn-22106","marks":["bold"],"text":"optional tropical-semiring (min/bottleneck) view"},{"id":"spn-22107","text":" would surface the single weakest dimension — the \"is any rung failing?\" question the kernel's safety floor asks."}]},{"id":"blk-22275","kind":"heading","level":2,"spans":[{"id":"spn-22108","text":"Rung-by-rung alignment"}]},{"head":[{"id":"blk-22277","spans":[{"id":"spn-22109","text":"Kernel rung"}]},{"id":"blk-22278","spans":[{"id":"spn-22110","text":"PRISM construct"}]},{"id":"blk-22279","spans":[{"id":"spn-22111","text":"Already aligned?"}]}],"id":"blk-22276","kind":"table","rows":[[{"id":"blk-22280","spans":[{"id":"spn-22112","text":"1. alethic ("},{"id":"spn-22113","marks":["code"],"text":"value"},{"id":"spn-22114","text":")"}]},{"id":"blk-22281","spans":[{"id":"spn-22115","text":"scenario/transcript = the observable facts being judged"}]},{"id":"blk-22282","spans":[{"id":"spn-22116","text":"✅ (the L1 evidence layer)"}]}],[{"id":"blk-22283","spans":[{"id":"spn-22117","text":"2. axiological ("},{"id":"spn-22118","marks":["code"],"text":"score"},{"id":"spn-22119","text":")"}]},{"id":"blk-22284","spans":[{"id":"spn-22120","text":"the whole CL-dimension scoring pipeline"}]},{"id":"blk-22285","spans":[{"id":"spn-22121","text":"✅ this "},{"id":"spn-22122","marks":["italic"],"text":"is"},{"id":"spn-22123","text":" rung 2"}]}],[{"id":"blk-22286","spans":[{"id":"spn-22124","text":"3. deontic (norm/govern)"}]},{"id":"blk-22287","spans":[{"id":"spn-22125","text":"meta-judge "},{"id":"spn-22126","marks":["code"],"text":"reject"},{"id":"spn-22127","text":" → drop from aggregate (veto)"}]},{"id":"blk-22288","spans":[{"id":"spn-22128","text":"✅ approximated by "},{"id":"spn-22129","marks":["code"],"text":"quality_weight"}]}],[{"id":"blk-22289","spans":[{"id":"spn-22130","text":"4. temporal (LTL ▸ supervise)"}]},{"id":"blk-22290","spans":[{"id":"spn-22131","text":"closed-loop "},{"id":"spn-22132","marks":["code"],"text":"loop_closure_rate"},{"id":"spn-22133","text":" slope across passes"}]},{"id":"blk-22291","spans":[{"id":"spn-22134","text":"◻ partial — it's a gradient over time"}]}],[{"id":"blk-22292","spans":[{"id":"spn-22135","text":"6. epistemic (knows ▸ believes)"}]},{"id":"blk-22293","spans":[{"id":"spn-22136","text":"bootstrap confidence intervals; meta-judge audit"}]},{"id":"blk-22294","spans":[{"id":"spn-22137","text":"✅ uncertainty is first-class"}]}],[{"id":"blk-22295","spans":[{"id":"spn-22138","text":"8. resource (affine ledger)"}]},{"id":"blk-22296","spans":[{"id":"spn-22139","text":"IRT difficulty budget / cost per run"}]},{"id":"blk-22297","spans":[{"id":"spn-22140","text":"◻ implicit"}]}]]},{"id":"blk-22298","kind":"paragraph","spans":[{"id":"spn-22141","text":"(Rungs 5 reflexive and 7 strategic are out of PRISM's remit.)"}]},{"id":"blk-22299","kind":"heading","level":2,"spans":[{"id":"spn-22142","text":"Concrete alignments (grounded in the code)"}]},{"id":"blk-22300","kind":"heading","level":3,"spans":[{"id":"spn-22143","text":"1. Composite = probability-semiring weighted sum (rung 2)"}]},{"id":"blk-22301","kind":"paragraph","spans":[{"id":"spn-22144","marks":["code"],"text":"lib/prism/judge/aggregator.ex"},{"id":"spn-22145","text":" "},{"id":"spn-22146","marks":["code"],"text":"compute_composite/2"},{"id":"spn-22147","text":" (lines 93–100) computes "},{"id":"spn-22148","marks":["code"],"text":"Σ dim_score × weight"},{"id":"spn-22149","text":". That is precisely the kernel's "},{"id":"spn-22150","marks":["bold"],"text":"probability semiring"},{"id":"spn-22151","text":" in "},{"id":"spn-22152","marks":["code"],"text":"box-and-box/score.mjs"},{"id":"spn-22153","text":" ("},{"id":"spn-22154","marks":["code"],"text":"⊕ = +"},{"id":"spn-22155","text":", "},{"id":"spn-22156","marks":["code"],"text":"⊗ = ×"},{"id":"spn-22157","text":"). The CL-dimension weights in "},{"id":"spn-22158","marks":["code"],"text":"Prism.Benchmark.CLCategories.weights()"},{"id":"spn-22159","text":" are the axiological weight vector. No change needed — the recommendation is to "},{"id":"spn-22160","marks":["italic"],"text":"document"},{"id":"spn-22161","text":" that PRISM's composite is the axiological rung evaluated in the probability semiring, so the two systems share one vocabulary."}]},{"id":"blk-22302","kind":"heading","level":3,"spans":[{"id":"spn-22162","text":"2. Meta-judge reject = "},{"id":"spn-22163","marks":["code"],"text":"0̲"},{"id":"spn-22164","text":" annihilation (deontic floor under the score)"}]},{"id":"blk-22303","kind":"paragraph","spans":[{"id":"spn-22165","marks":["code"],"text":"quality_weight/1"},{"id":"spn-22166","text":" (lines 131–137) maps a meta-judge recommendation to a weight, and "},{"id":"spn-22167","marks":["code"],"text":"aggregate/3"},{"id":"spn-22168","text":" (line 40) then "},{"id":"spn-22169","marks":["bold"],"text":"filters out"},{"id":"spn-22170","text":" any judgment whose quality weight is "},{"id":"spn-22171","marks":["code"],"text":"0.0"},{"id":"spn-22172","text":". That filter is exactly the kernel's "},{"id":"spn-22173","marks":["bold"],"text":"`consume()` veto / `0̲` annihilation"},{"id":"spn-22174","text":": a rejected judgment does not get "},{"id":"spn-22175","marks":["italic"],"text":"down-weighted and averaged in"},{"id":"spn-22176","text":", it is "},{"id":"spn-22177","marks":["bold"],"text":"annihilated"},{"id":"spn-22178","text":" — removed from the aggregate entirely. This is the deontic safety floor: a verdict that violates the floor cannot be \"made up for\" by strong scores elsewhere. PRISM already does the right thing; naming it as the "},{"id":"spn-22179","marks":["code"],"text":"0̲"},{"id":"spn-22180","text":" rule makes the guarantee legible and testable against law "},{"id":"spn-22181","marks":["code"],"text":"DB2"},{"id":"spn-22182","text":" (annihilation) in the kernel's deontic suite."}]},{"id":"blk-22304","kind":"heading","level":3,"spans":[{"id":"spn-22183","text":"3. Per-pass mean: add an optional tropical (bottleneck) view"}]},{"id":"blk-22305","kind":"paragraph","spans":[{"id":"spn-22184","marks":["code"],"text":"lib/prism/sequence/scorer.ex"},{"id":"spn-22185","text":" "},{"id":"spn-22186","marks":["code"],"text":"per_pass_means/1"},{"id":"spn-22187","text":" (lines 82–92) takes the "},{"id":"spn-22188","marks":["bold"],"text":"arithmetic mean"},{"id":"spn-22189","text":" of dimension scores. That answers \"how good on average?\" The kernel's safety floor asks a different question — \"is "},{"id":"spn-22190","marks":["italic"],"text":"any"},{"id":"spn-22191","text":" rung failing?\" — which is the "},{"id":"spn-22192","marks":["bold"],"text":"tropical semiring"},{"id":"spn-22193","text":" ("},{"id":"spn-22194","marks":["code"],"text":"⊕ = min"},{"id":"spn-22195","text":") in "},{"id":"spn-22196","marks":["code"],"text":"score.mjs"},{"id":"spn-22197","text":". An "},{"id":"spn-22198","marks":["italic"],"text":"additive"},{"id":"spn-22199","text":" "},{"id":"spn-22200","marks":["code"],"text":"per_pass_floor/1"},{"id":"spn-22201","text":" companion (the min across dimensions per pass) would expose the bottleneck dimension without touching the existing mean-based metrics. This is the single most useful optional wiring: it turns \"average CL competence\" into \"average "},{"id":"spn-22202","marks":["bold"],"text":"and"},{"id":"spn-22203","text":" weakest-link CL competence,\" matching how the bridge gates on the floor before optimizing the gradient."}]},{"id":"blk-22306","kind":"heading","level":3,"spans":[{"id":"spn-22204","text":"4. Loop closure slope = the axiological gradient over time (rung 2 ▸ rung 4)"}]},{"id":"blk-22307","kind":"paragraph","spans":[{"id":"spn-22205","marks":["code"],"text":"loop_closure_rate/1"},{"id":"spn-22206","text":" (lines 36–40) is the linear-regression slope of per-pass means — literally the "},{"id":"spn-22207","marks":["bold"],"text":"gradient"},{"id":"spn-22208","text":" the kernel's bridge optimizes in its "},{"id":"spn-22209","marks":["code"],"text":"best"},{"id":"spn-22210","text":" step, but measured "},{"id":"spn-22211","marks":["italic"],"text":"across time"},{"id":"spn-22212","text":" (which makes it also a temporal-rung, rung-4, liveness signal: \"does the system eventually improve?\"). No change; worth citing the correspondence so \"loop closure\" and \"the best gradient\" are understood as the same quantity at different timescales."}]},{"id":"blk-22308","kind":"heading","level":2,"spans":[{"id":"spn-22213","text":"Suggested (optional, additive) wiring"}]},{"head":[{"id":"blk-22310","spans":[{"id":"spn-22214","text":"Change"}]},{"id":"blk-22311","spans":[{"id":"spn-22215","text":"File"}]},{"id":"blk-22312","spans":[{"id":"spn-22216","text":"Risk"}]},{"id":"blk-22313","spans":[{"id":"spn-22217","text":"Value"}]}],"id":"blk-22309","kind":"table","rows":[[{"id":"blk-22314","spans":[{"id":"spn-22218","text":"Document composite = probability semiring"}]},{"id":"blk-22315","spans":[{"id":"spn-22219","marks":["code"],"text":"aggregator.ex"},{"id":"spn-22220","text":" moduledoc"}]},{"id":"blk-22316","spans":[{"id":"spn-22221","text":"none"}]},{"id":"blk-22317","spans":[{"id":"spn-22222","text":"shared vocabulary"}]}],[{"id":"blk-22318","spans":[{"id":"spn-22223","text":"Name reject-filter as "},{"id":"spn-22224","marks":["code"],"text":"0̲"},{"id":"spn-22225","text":" annihilation"}]},{"id":"blk-22319","spans":[{"id":"spn-22226","marks":["code"],"text":"aggregator.ex"},{"id":"spn-22227","text":" "},{"id":"spn-22228","marks":["code"],"text":"quality_weight/1"},{"id":"spn-22229","text":" doc"}]},{"id":"blk-22320","spans":[{"id":"spn-22230","text":"none"}]},{"id":"blk-22321","spans":[{"id":"spn-22231","text":"legible safety floor"}]}],[{"id":"blk-22322","spans":[{"id":"spn-22232","text":"Add "},{"id":"spn-22233","marks":["code"],"text":"per_pass_floor/1"},{"id":"spn-22234","text":" (tropical/min view)"}]},{"id":"blk-22323","spans":[{"id":"spn-22235","marks":["code"],"text":"sequence/scorer.ex"}]},{"id":"blk-22324","spans":[{"id":"spn-22236","text":"low (new fn)"}]},{"id":"blk-22325","spans":[{"id":"spn-22237","text":"bottleneck visibility"}]}],[{"id":"blk-22326","spans":[{"id":"spn-22238","text":"Cite loop-closure ↔ best-gradient"}]},{"id":"blk-22327","spans":[{"id":"spn-22239","marks":["code"],"text":"sequence/scorer.ex"},{"id":"spn-22240","text":" moduledoc"}]},{"id":"blk-22328","spans":[{"id":"spn-22241","text":"none"}]},{"id":"blk-22329","spans":[{"id":"spn-22242","text":"conceptual unification"}]}]]},{"id":"blk-22330","kind":"paragraph","spans":[{"id":"spn-22243","text":"None of these change existing outputs, leaderboards, or the 9-dimension weights."}]},{"id":"blk-22331","kind":"heading","level":2,"spans":[{"id":"spn-22244","text":"What this review deliberately does NOT do"}]},{"id":"blk-22332","items":[{"blocks":[{"id":"blk-22334","kind":"paragraph","spans":[{"id":"spn-22245","text":"It does "},{"id":"spn-22246","marks":["bold"],"text":"not"},{"id":"spn-22247","text":" swap the arithmetic mean for tropical by default — the existing composite"}]}],"id":"blk-22333","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22335","kind":"paragraph","spans":[{"id":"spn-22248","text":"and per-pass-mean metrics are preserved exactly; tropical is an "},{"id":"spn-22249","marks":["italic"],"text":"additional"},{"id":"spn-22250","text":" view."}]},{"id":"blk-22336","items":[{"blocks":[{"id":"blk-22338","kind":"paragraph","spans":[{"id":"spn-22251","text":"It does "},{"id":"spn-22252","marks":["bold"],"text":"not"},{"id":"spn-22253","text":" re-weight any CL dimension or alter IRT calibration."}]}],"id":"blk-22337","kind":"list-item"},{"blocks":[{"id":"blk-22340","kind":"paragraph","spans":[{"id":"spn-22254","text":"It does "},{"id":"spn-22255","marks":["bold"],"text":"not"},{"id":"spn-22256","text":" make PRISM call into the JS kernel at runtime (the kernel is a spec/ref;"}]}],"id":"blk-22339","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22341","kind":"paragraph","spans":[{"id":"spn-22257","text":"PRISM stays self-contained Elixir)."}]},{"id":"blk-22342","kind":"heading","level":2,"spans":[{"id":"spn-22258","text":"Reference"}]},{"id":"blk-22343","items":[{"blocks":[{"id":"blk-22345","kind":"paragraph","spans":[{"id":"spn-22259","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/score.mjs"},{"id":"spn-22260","text":" — semirings (tropical/probability/log)"}]}],"id":"blk-22344","kind":"list-item"},{"blocks":[{"id":"blk-22347","kind":"paragraph","spans":[{"id":"spn-22261","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/bridge.mjs"},{"id":"spn-22262","text":" — floor-then-gradient, "},{"id":"spn-22263","marks":["code"],"text":"consume()"},{"id":"spn-22264","text":", "},{"id":"spn-22265","marks":["code"],"text":"0̲"}]}],"id":"blk-22346","kind":"list-item"},{"blocks":[{"id":"blk-22349","kind":"paragraph","spans":[{"id":"spn-22266","marks":["code"],"text":"AmpersandBoxDesign/docs/CC2-capability-composition.md"},{"id":"spn-22267","text":" — operators × arithmetics"}]}],"id":"blk-22348","kind":"list-item"},{"blocks":[{"id":"blk-22351","kind":"paragraph","spans":[{"id":"spn-22268","marks":["code"],"text":"lib/prism/judge/aggregator.ex"},{"id":"spn-22269","text":" — composite + meta-judge veto (this review's §1–2)"}]}],"id":"blk-22350","kind":"list-item"},{"blocks":[{"id":"blk-22353","kind":"paragraph","spans":[{"id":"spn-22270","marks":["code"],"text":"lib/prism/sequence/scorer.ex"},{"id":"spn-22271","text":" — per-pass means + loop closure (this review's §3–4)"}]}],"id":"blk-22352","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierade4kj6gyqcthfw5i7ueubnkkdjbfvsh3eox2bn2cptzssicn7jxa","vocabulary":"ampersand.docs.fs.v1"}