{"bendscript":"0.1","blocks":[{"id":"blk-22291","kind":"heading","level":1,"spans":[{"id":"spn-22180","text":"PRISM × box-and-box — Arithmetic Integration Review"}]},{"id":"blk-22292","kind":"paragraph","spans":[{"id":"spn-22181","marks":["bold"],"text":"Status:"},{"id":"spn-22182","text":" review (no scoring break) · "},{"id":"spn-22183","marks":["bold"],"text":"Kernel:"},{"id":"spn-22184","text":" "},{"id":"spn-22185","marks":["code"],"text":"box-and-box"},{"id":"spn-22186","text":" v0.8.0 (8 rungs, 97 laws) "},{"id":"spn-22187","marks":["bold"],"text":"Scope:"},{"id":"spn-22188","text":" how the PRISM benchmark engine (OS-009) relates to the [&] governance kernel, which parts of the scoring pipeline are already the kernel's "},{"id":"spn-22189","marks":["bold"],"text":"axiological"},{"id":"spn-22190","text":" rung in disguise, and what additive wiring would make the correspondence exact."}]},{"id":"blk-22293","kind":"heading","level":2,"spans":[{"id":"spn-22191","text":"TL;DR"}]},{"id":"blk-22294","kind":"paragraph","spans":[{"id":"spn-22192","text":"PRISM "},{"id":"spn-22193","marks":["italic"],"text":"is"},{"id":"spn-22194","text":" the kernel's "},{"id":"spn-22195","marks":["bold"],"text":"axiological rung (rung 2, `score.mjs`) at scale."},{"id":"spn-22196","text":" Where the kernel ranks one decision ("},{"id":"spn-22197","marks":["code"],"text":"feasible ▸ permitted ▸ best"},{"id":"spn-22198","text":"), PRISM ranks "},{"id":"spn-22199","marks":["italic"],"text":"systems"},{"id":"spn-22200","text":" across many decisions. The two are the same algebra at different cardinalities, so the integration is mostly "},{"id":"spn-22201","marks":["bold"],"text":"naming + one optional semiring swap"},{"id":"spn-22202","text":", not a rewrite."}]},{"id":"blk-22295","kind":"paragraph","spans":[{"id":"spn-22203","text":"Three concrete touch-points, all additive:"}]},{"id":"blk-22296","items":[{"blocks":[{"id":"blk-22298","kind":"paragraph","spans":[{"id":"spn-22204","marks":["bold"],"text":"Composite scoring"},{"id":"spn-22205","text":" ("},{"id":"spn-22206","marks":["code"],"text":"Judge.Aggregator.compute_composite/2"},{"id":"spn-22207","text":") is already a"}]}],"id":"blk-22297","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22299","kind":"paragraph","spans":[{"id":"spn-22208","marks":["bold"],"text":"probability-semiring weighted sum"},{"id":"spn-22209","text":" — name it as rung 2."}]},{"id":"blk-22300","items":[{"blocks":[{"id":"blk-22302","kind":"paragraph","spans":[{"id":"spn-22210","marks":["bold"],"text":"Meta-judge \"reject\""},{"id":"spn-22211","text":" ("},{"id":"spn-22212","marks":["code"],"text":"Judge.Aggregator.quality_weight/1"},{"id":"spn-22213","text":") is already the kernel's"}]}],"id":"blk-22301","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-22303","kind":"paragraph","spans":[{"id":"spn-22214","marks":["bold"],"text":"`0̲` annihilation / `consume()` veto"},{"id":"spn-22215","text":" — a rejected judgment is annihilated, not averaged. Name it as the deontic floor under the score."}]},{"id":"blk-22304","items":[{"blocks":[{"id":"blk-22306","kind":"paragraph","spans":[{"id":"spn-22216","marks":["bold"],"text":"Per-pass means"},{"id":"spn-22217","text":" ("},{"id":"spn-22218","marks":["code"],"text":"Sequence.Scorer.per_pass_means/1"},{"id":"spn-22219","text":") use the "},{"id":"spn-22220","marks":["italic"],"text":"arithmetic"},{"id":"spn-22221","text":" mean. An"}]}],"id":"blk-22305","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-22307","kind":"paragraph","spans":[{"id":"spn-22222","marks":["bold"],"text":"optional tropical-semiring (min/bottleneck) view"},{"id":"spn-22223","text":" would surface the single weakest dimension — the \"is any rung failing?\" question the kernel's safety floor asks."}]},{"id":"blk-22308","kind":"heading","level":2,"spans":[{"id":"spn-22224","text":"Rung-by-rung alignment"}]},{"head":[{"id":"blk-22310","spans":[{"id":"spn-22225","text":"Kernel rung"}]},{"id":"blk-22311","spans":[{"id":"spn-22226","text":"PRISM construct"}]},{"id":"blk-22312","spans":[{"id":"spn-22227","text":"Already aligned?"}]}],"id":"blk-22309","kind":"table","rows":[[{"id":"blk-22313","spans":[{"id":"spn-22228","text":"1. alethic ("},{"id":"spn-22229","marks":["code"],"text":"value"},{"id":"spn-22230","text":")"}]},{"id":"blk-22314","spans":[{"id":"spn-22231","text":"scenario/transcript = the observable facts being judged"}]},{"id":"blk-22315","spans":[{"id":"spn-22232","text":"✅ (the L1 evidence layer)"}]}],[{"id":"blk-22316","spans":[{"id":"spn-22233","text":"2. axiological ("},{"id":"spn-22234","marks":["code"],"text":"score"},{"id":"spn-22235","text":")"}]},{"id":"blk-22317","spans":[{"id":"spn-22236","text":"the whole CL-dimension scoring pipeline"}]},{"id":"blk-22318","spans":[{"id":"spn-22237","text":"✅ this "},{"id":"spn-22238","marks":["italic"],"text":"is"},{"id":"spn-22239","text":" rung 2"}]}],[{"id":"blk-22319","spans":[{"id":"spn-22240","text":"3. deontic (norm/govern)"}]},{"id":"blk-22320","spans":[{"id":"spn-22241","text":"meta-judge "},{"id":"spn-22242","marks":["code"],"text":"reject"},{"id":"spn-22243","text":" → drop from aggregate (veto)"}]},{"id":"blk-22321","spans":[{"id":"spn-22244","text":"✅ approximated by "},{"id":"spn-22245","marks":["code"],"text":"quality_weight"}]}],[{"id":"blk-22322","spans":[{"id":"spn-22246","text":"4. temporal (LTL ▸ supervise)"}]},{"id":"blk-22323","spans":[{"id":"spn-22247","text":"closed-loop "},{"id":"spn-22248","marks":["code"],"text":"loop_closure_rate"},{"id":"spn-22249","text":" slope across passes"}]},{"id":"blk-22324","spans":[{"id":"spn-22250","text":"◻ partial — it's a gradient over time"}]}],[{"id":"blk-22325","spans":[{"id":"spn-22251","text":"6. epistemic (knows ▸ believes)"}]},{"id":"blk-22326","spans":[{"id":"spn-22252","text":"bootstrap confidence intervals; meta-judge audit"}]},{"id":"blk-22327","spans":[{"id":"spn-22253","text":"✅ uncertainty is first-class"}]}],[{"id":"blk-22328","spans":[{"id":"spn-22254","text":"8. resource (affine ledger)"}]},{"id":"blk-22329","spans":[{"id":"spn-22255","text":"IRT difficulty budget / cost per run"}]},{"id":"blk-22330","spans":[{"id":"spn-22256","text":"◻ implicit"}]}]]},{"id":"blk-22331","kind":"paragraph","spans":[{"id":"spn-22257","text":"(Rungs 5 reflexive and 7 strategic are out of PRISM's remit.)"}]},{"id":"blk-22332","kind":"heading","level":2,"spans":[{"id":"spn-22258","text":"Concrete alignments (grounded in the code)"}]},{"id":"blk-22333","kind":"heading","level":3,"spans":[{"id":"spn-22259","text":"1. Composite = probability-semiring weighted sum (rung 2)"}]},{"id":"blk-22334","kind":"paragraph","spans":[{"id":"spn-22260","marks":["code"],"text":"lib/prism/judge/aggregator.ex"},{"id":"spn-22261","text":" "},{"id":"spn-22262","marks":["code"],"text":"compute_composite/2"},{"id":"spn-22263","text":" (lines 93–100) computes "},{"id":"spn-22264","marks":["code"],"text":"Σ dim_score × weight"},{"id":"spn-22265","text":". That is precisely the kernel's "},{"id":"spn-22266","marks":["bold"],"text":"probability semiring"},{"id":"spn-22267","text":" in "},{"id":"spn-22268","marks":["code"],"text":"box-and-box/score.mjs"},{"id":"spn-22269","text":" ("},{"id":"spn-22270","marks":["code"],"text":"⊕ = +"},{"id":"spn-22271","text":", "},{"id":"spn-22272","marks":["code"],"text":"⊗ = ×"},{"id":"spn-22273","text":"). The CL-dimension weights in "},{"id":"spn-22274","marks":["code"],"text":"Prism.Benchmark.CLCategories.weights()"},{"id":"spn-22275","text":" are the axiological weight vector. No change needed — the recommendation is to "},{"id":"spn-22276","marks":["italic"],"text":"document"},{"id":"spn-22277","text":" that PRISM's composite is the axiological rung evaluated in the probability semiring, so the two systems share one vocabulary."}]},{"id":"blk-22335","kind":"heading","level":3,"spans":[{"id":"spn-22278","text":"2. Meta-judge reject = "},{"id":"spn-22279","marks":["code"],"text":"0̲"},{"id":"spn-22280","text":" annihilation (deontic floor under the score)"}]},{"id":"blk-22336","kind":"paragraph","spans":[{"id":"spn-22281","marks":["code"],"text":"quality_weight/1"},{"id":"spn-22282","text":" (lines 131–137) maps a meta-judge recommendation to a weight, and "},{"id":"spn-22283","marks":["code"],"text":"aggregate/3"},{"id":"spn-22284","text":" (line 40) then "},{"id":"spn-22285","marks":["bold"],"text":"filters out"},{"id":"spn-22286","text":" any judgment whose quality weight is "},{"id":"spn-22287","marks":["code"],"text":"0.0"},{"id":"spn-22288","text":". That filter is exactly the kernel's "},{"id":"spn-22289","marks":["bold"],"text":"`consume()` veto / `0̲` annihilation"},{"id":"spn-22290","text":": a rejected judgment does not get "},{"id":"spn-22291","marks":["italic"],"text":"down-weighted and averaged in"},{"id":"spn-22292","text":", it is "},{"id":"spn-22293","marks":["bold"],"text":"annihilated"},{"id":"spn-22294","text":" — removed from the aggregate entirely. This is the deontic safety floor: a verdict that violates the floor cannot be \"made up for\" by strong scores elsewhere. PRISM already does the right thing; naming it as the "},{"id":"spn-22295","marks":["code"],"text":"0̲"},{"id":"spn-22296","text":" rule makes the guarantee legible and testable against law "},{"id":"spn-22297","marks":["code"],"text":"DB2"},{"id":"spn-22298","text":" (annihilation) in the kernel's deontic suite."}]},{"id":"blk-22337","kind":"heading","level":3,"spans":[{"id":"spn-22299","text":"3. Per-pass mean: add an optional tropical (bottleneck) view"}]},{"id":"blk-22338","kind":"paragraph","spans":[{"id":"spn-22300","marks":["code"],"text":"lib/prism/sequence/scorer.ex"},{"id":"spn-22301","text":" "},{"id":"spn-22302","marks":["code"],"text":"per_pass_means/1"},{"id":"spn-22303","text":" (lines 82–92) takes the "},{"id":"spn-22304","marks":["bold"],"text":"arithmetic mean"},{"id":"spn-22305","text":" of dimension scores. That answers \"how good on average?\" The kernel's safety floor asks a different question — \"is "},{"id":"spn-22306","marks":["italic"],"text":"any"},{"id":"spn-22307","text":" rung failing?\" — which is the "},{"id":"spn-22308","marks":["bold"],"text":"tropical semiring"},{"id":"spn-22309","text":" ("},{"id":"spn-22310","marks":["code"],"text":"⊕ = min"},{"id":"spn-22311","text":") in "},{"id":"spn-22312","marks":["code"],"text":"score.mjs"},{"id":"spn-22313","text":". An "},{"id":"spn-22314","marks":["italic"],"text":"additive"},{"id":"spn-22315","text":" "},{"id":"spn-22316","marks":["code"],"text":"per_pass_floor/1"},{"id":"spn-22317","text":" companion (the min across dimensions per pass) would expose the bottleneck dimension without touching the existing mean-based metrics. This is the single most useful optional wiring: it turns \"average CL competence\" into \"average "},{"id":"spn-22318","marks":["bold"],"text":"and"},{"id":"spn-22319","text":" weakest-link CL competence,\" matching how the bridge gates on the floor before optimizing the gradient."}]},{"id":"blk-22339","kind":"heading","level":3,"spans":[{"id":"spn-22320","text":"4. Loop closure slope = the axiological gradient over time (rung 2 ▸ rung 4)"}]},{"id":"blk-22340","kind":"paragraph","spans":[{"id":"spn-22321","marks":["code"],"text":"loop_closure_rate/1"},{"id":"spn-22322","text":" (lines 36–40) is the linear-regression slope of per-pass means — literally the "},{"id":"spn-22323","marks":["bold"],"text":"gradient"},{"id":"spn-22324","text":" the kernel's bridge optimizes in its "},{"id":"spn-22325","marks":["code"],"text":"best"},{"id":"spn-22326","text":" step, but measured "},{"id":"spn-22327","marks":["italic"],"text":"across time"},{"id":"spn-22328","text":" (which makes it also a temporal-rung, rung-4, liveness signal: \"does the system eventually improve?\"). No change; worth citing the correspondence so \"loop closure\" and \"the best gradient\" are understood as the same quantity at different timescales."}]},{"id":"blk-22341","kind":"heading","level":2,"spans":[{"id":"spn-22329","text":"Suggested (optional, additive) wiring"}]},{"head":[{"id":"blk-22343","spans":[{"id":"spn-22330","text":"Change"}]},{"id":"blk-22344","spans":[{"id":"spn-22331","text":"File"}]},{"id":"blk-22345","spans":[{"id":"spn-22332","text":"Risk"}]},{"id":"blk-22346","spans":[{"id":"spn-22333","text":"Value"}]}],"id":"blk-22342","kind":"table","rows":[[{"id":"blk-22347","spans":[{"id":"spn-22334","text":"Document composite = probability semiring"}]},{"id":"blk-22348","spans":[{"id":"spn-22335","marks":["code"],"text":"aggregator.ex"},{"id":"spn-22336","text":" moduledoc"}]},{"id":"blk-22349","spans":[{"id":"spn-22337","text":"none"}]},{"id":"blk-22350","spans":[{"id":"spn-22338","text":"shared vocabulary"}]}],[{"id":"blk-22351","spans":[{"id":"spn-22339","text":"Name reject-filter as "},{"id":"spn-22340","marks":["code"],"text":"0̲"},{"id":"spn-22341","text":" annihilation"}]},{"id":"blk-22352","spans":[{"id":"spn-22342","marks":["code"],"text":"aggregator.ex"},{"id":"spn-22343","text":" "},{"id":"spn-22344","marks":["code"],"text":"quality_weight/1"},{"id":"spn-22345","text":" doc"}]},{"id":"blk-22353","spans":[{"id":"spn-22346","text":"none"}]},{"id":"blk-22354","spans":[{"id":"spn-22347","text":"legible safety floor"}]}],[{"id":"blk-22355","spans":[{"id":"spn-22348","text":"Add "},{"id":"spn-22349","marks":["code"],"text":"per_pass_floor/1"},{"id":"spn-22350","text":" (tropical/min view)"}]},{"id":"blk-22356","spans":[{"id":"spn-22351","marks":["code"],"text":"sequence/scorer.ex"}]},{"id":"blk-22357","spans":[{"id":"spn-22352","text":"low (new fn)"}]},{"id":"blk-22358","spans":[{"id":"spn-22353","text":"bottleneck visibility"}]}],[{"id":"blk-22359","spans":[{"id":"spn-22354","text":"Cite loop-closure ↔ best-gradient"}]},{"id":"blk-22360","spans":[{"id":"spn-22355","marks":["code"],"text":"sequence/scorer.ex"},{"id":"spn-22356","text":" moduledoc"}]},{"id":"blk-22361","spans":[{"id":"spn-22357","text":"none"}]},{"id":"blk-22362","spans":[{"id":"spn-22358","text":"conceptual unification"}]}]]},{"id":"blk-22363","kind":"paragraph","spans":[{"id":"spn-22359","text":"None of these change existing outputs, leaderboards, or the 9-dimension weights."}]},{"id":"blk-22364","kind":"heading","level":2,"spans":[{"id":"spn-22360","text":"What this review deliberately does NOT do"}]},{"id":"blk-22365","items":[{"blocks":[{"id":"blk-22367","kind":"paragraph","spans":[{"id":"spn-22361","text":"It does "},{"id":"spn-22362","marks":["bold"],"text":"not"},{"id":"spn-22363","text":" swap the arithmetic mean for tropical by default — the existing composite"}]}],"id":"blk-22366","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22368","kind":"paragraph","spans":[{"id":"spn-22364","text":"and per-pass-mean metrics are preserved exactly; tropical is an "},{"id":"spn-22365","marks":["italic"],"text":"additional"},{"id":"spn-22366","text":" view."}]},{"id":"blk-22369","items":[{"blocks":[{"id":"blk-22371","kind":"paragraph","spans":[{"id":"spn-22367","text":"It does "},{"id":"spn-22368","marks":["bold"],"text":"not"},{"id":"spn-22369","text":" re-weight any CL dimension or alter IRT calibration."}]}],"id":"blk-22370","kind":"list-item"},{"blocks":[{"id":"blk-22373","kind":"paragraph","spans":[{"id":"spn-22370","text":"It does "},{"id":"spn-22371","marks":["bold"],"text":"not"},{"id":"spn-22372","text":" make PRISM call into the JS kernel at runtime (the kernel is a spec/ref;"}]}],"id":"blk-22372","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-22374","kind":"paragraph","spans":[{"id":"spn-22373","text":"PRISM stays self-contained Elixir)."}]},{"id":"blk-22375","kind":"heading","level":2,"spans":[{"id":"spn-22374","text":"Reference"}]},{"id":"blk-22376","items":[{"blocks":[{"id":"blk-22378","kind":"paragraph","spans":[{"id":"spn-22375","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/score.mjs"},{"id":"spn-22376","text":" — semirings (tropical/probability/log)"}]}],"id":"blk-22377","kind":"list-item"},{"blocks":[{"id":"blk-22380","kind":"paragraph","spans":[{"id":"spn-22377","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/bridge.mjs"},{"id":"spn-22378","text":" — floor-then-gradient, "},{"id":"spn-22379","marks":["code"],"text":"consume()"},{"id":"spn-22380","text":", "},{"id":"spn-22381","marks":["code"],"text":"0̲"}]}],"id":"blk-22379","kind":"list-item"},{"blocks":[{"id":"blk-22382","kind":"paragraph","spans":[{"id":"spn-22382","marks":["code"],"text":"AmpersandBoxDesign/docs/CC2-capability-composition.md"},{"id":"spn-22383","text":" — operators × arithmetics"}]}],"id":"blk-22381","kind":"list-item"},{"blocks":[{"id":"blk-22384","kind":"paragraph","spans":[{"id":"spn-22384","marks":["code"],"text":"lib/prism/judge/aggregator.ex"},{"id":"spn-22385","text":" — composite + meta-judge veto (this review's §1–2)"}]}],"id":"blk-22383","kind":"list-item"},{"blocks":[{"id":"blk-22386","kind":"paragraph","spans":[{"id":"spn-22386","marks":["code"],"text":"lib/prism/sequence/scorer.ex"},{"id":"spn-22387","text":" — per-pass means + loop closure (this review's §3–4)"}]}],"id":"blk-22385","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieramb3ordpss3seox6weurii5gemyitfbu23bvpmtis4477tcnnamjq","vocabulary":"ampersand.docs.fs.v1"}