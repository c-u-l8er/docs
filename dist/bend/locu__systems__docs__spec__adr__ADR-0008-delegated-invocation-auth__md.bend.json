{"bendscript":"0.1","blocks":[{"id":"blk-93228","kind":"heading","level":1,"spans":[{"id":"spn-156679","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-93229","items":[{"blocks":[{"id":"blk-93231","kind":"paragraph","spans":[{"id":"spn-156680","marks":["bold"],"text":"Status:"},{"id":"spn-156681","text":" Accepted"}]}],"id":"blk-93230","kind":"list-item"},{"blocks":[{"id":"blk-93233","kind":"paragraph","spans":[{"id":"spn-156682","marks":["bold"],"text":"Date:"},{"id":"spn-156683","text":" 2026-01-24"}]}],"id":"blk-93232","kind":"list-item"},{"blocks":[{"id":"blk-93235","kind":"paragraph","spans":[{"id":"spn-156684","marks":["bold"],"text":"Owners:"},{"id":"spn-156685","text":" Engineering"}]}],"id":"blk-93234","kind":"list-item"},{"blocks":[{"id":"blk-93237","kind":"paragraph","spans":[{"id":"spn-156686","marks":["bold"],"text":"Applies to:"},{"id":"spn-156687","text":" "},{"id":"spn-156688","marks":["code"],"text":"webhost.systems"},{"id":"spn-156689","text":" control plane"}]}],"id":"blk-93236","kind":"list-item"},{"blocks":[{"id":"blk-93239","kind":"paragraph","spans":[{"id":"spn-156690","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-156691","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-93238","kind":"list-item"},{"blocks":[{"id":"blk-93241","kind":"paragraph","spans":[{"id":"spn-156692","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-93240","kind":"list-item"},{"blocks":[{"id":"blk-93243","kind":"paragraph","spans":[{"id":"spn-156693","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-156694","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-93242","kind":"list-item"},{"blocks":[{"id":"blk-93245","kind":"paragraph","spans":[{"id":"spn-156695","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-156696","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-93244","kind":"list-item"},{"blocks":[{"id":"blk-93247","kind":"paragraph","spans":[{"id":"spn-156697","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-156698","text":" (invoke contract)"}]}],"id":"blk-93246","kind":"list-item"},{"blocks":[{"id":"blk-93249","kind":"paragraph","spans":[{"id":"spn-156699","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-156700","text":" (tenant isolation; access control)"}]}],"id":"blk-93248","kind":"list-item"},{"blocks":[{"id":"blk-93251","kind":"paragraph","spans":[{"id":"spn-156701","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-156702","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-93250","kind":"list-item"},{"blocks":[{"id":"blk-93253","kind":"paragraph","spans":[{"id":"spn-156703","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-156704","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-93252","kind":"list-item"},{"blocks":[{"id":"blk-93255","kind":"paragraph","spans":[{"id":"spn-156705","text":"External integration: "},{"id":"spn-156706","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-156707","text":" (consumer contract)"}]}],"id":"blk-93254","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93256","kind":"heading","level":2,"spans":[{"id":"spn-156708","text":"1) Context"}]},{"id":"blk-93257","kind":"paragraph","spans":[{"id":"spn-156709","text":"The canonical WHS invocation endpoint ("},{"id":"spn-156710","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-156711","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-93258","kind":"paragraph","spans":[{"id":"spn-156712","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-93259","items":[{"blocks":[{"id":"blk-93261","kind":"paragraph","spans":[{"id":"spn-156713","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-93260","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93262","kind":"paragraph","spans":[{"id":"spn-156714","text":"Constraints:"}]},{"id":"blk-93263","items":[{"blocks":[{"id":"blk-93265","kind":"paragraph","spans":[{"id":"spn-156715","text":"Server-side orchestrators should "},{"id":"spn-156716","marks":["bold"],"text":"not"},{"id":"spn-156717","text":" rely on browser tokens."}]}],"id":"blk-93264","kind":"list-item"},{"blocks":[{"id":"blk-93267","kind":"paragraph","spans":[{"id":"spn-156718","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-93266","kind":"list-item"},{"blocks":[{"id":"blk-93269","kind":"paragraph","spans":[{"id":"spn-156719","text":"WHS must remain authoritative for:"}]}],"id":"blk-93268","kind":"list-item"},{"blocks":[{"id":"blk-93271","kind":"paragraph","spans":[{"id":"spn-156720","text":"agent ownership/visibility,"}]}],"id":"blk-93270","kind":"list-item"},{"blocks":[{"id":"blk-93273","kind":"paragraph","spans":[{"id":"spn-156721","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-93272","kind":"list-item"},{"blocks":[{"id":"blk-93275","kind":"paragraph","spans":[{"id":"spn-156722","text":"telemetry, usage, billing."}]}],"id":"blk-93274","kind":"list-item"},{"blocks":[{"id":"blk-93277","kind":"paragraph","spans":[{"id":"spn-156723","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-93276","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93278","kind":"paragraph","spans":[{"id":"spn-156724","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-93279","items":[{"blocks":[{"id":"blk-93281","kind":"paragraph","spans":[{"id":"spn-156725","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-93280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93282","kind":"paragraph","spans":[{"id":"spn-156726","text":"We need an analogous but distinct mechanism for "},{"id":"spn-156727","marks":["bold"],"text":"delegated invocation"},{"id":"spn-156728","text":"."}]},{"id":"blk-93283","kind":"heading","level":2,"spans":[{"id":"spn-156729","text":"2) Decision"}]},{"id":"blk-93284","kind":"heading","level":3,"spans":[{"id":"spn-156730","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-93285","kind":"paragraph","spans":[{"id":"spn-156731","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-93286","items":[{"blocks":[{"id":"blk-93288","kind":"paragraph","spans":[{"id":"spn-156732","text":"The delegator sends a request with:"}]}],"id":"blk-93287","kind":"list-item"},{"blocks":[{"id":"blk-93290","kind":"paragraph","spans":[{"id":"spn-156733","text":"an HMAC signature computed over the "},{"id":"spn-156734","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-156735","text":"."}]}],"id":"blk-93289","kind":"list-item"},{"blocks":[{"id":"blk-93292","kind":"paragraph","spans":[{"id":"spn-156736","text":"a timestamp used for replay protection."}]}],"id":"blk-93291","kind":"list-item"},{"blocks":[{"id":"blk-93294","kind":"paragraph","spans":[{"id":"spn-156737","text":"a declared delegated end-user identity ("},{"id":"spn-156738","marks":["code"],"text":"externalUserId"},{"id":"spn-156739","text":") in the JSON body."}]}],"id":"blk-93293","kind":"list-item"},{"blocks":[{"id":"blk-93296","kind":"paragraph","spans":[{"id":"spn-156740","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-93295","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93297","kind":"paragraph","spans":[{"id":"spn-156741","text":"This is "},{"id":"spn-156742","marks":["bold"],"text":"service authentication"},{"id":"spn-156743","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-93298","kind":"heading","level":3,"spans":[{"id":"spn-156744","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-93299","kind":"paragraph","spans":[{"id":"spn-156745","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-93300","items":[{"blocks":[{"id":"blk-93302","kind":"paragraph","spans":[{"id":"spn-156746","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-93301","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93303","kind":"paragraph","spans":[{"id":"spn-156747","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-93304","kind":"heading","level":3,"spans":[{"id":"spn-156748","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-93305","kind":"paragraph","spans":[{"id":"spn-156749","text":"For delegated invocations:"}]},{"id":"blk-93306","items":[{"blocks":[{"id":"blk-93308","kind":"paragraph","spans":[{"id":"spn-156750","text":"WHS resolves "},{"id":"spn-156751","marks":["code"],"text":"externalUserId"},{"id":"spn-156752","text":" to a WHS "},{"id":"spn-156753","marks":["code"],"text":"users"},{"id":"spn-156754","text":" row."}]}],"id":"blk-93307","kind":"list-item"},{"blocks":[{"id":"blk-93310","kind":"paragraph","spans":[{"id":"spn-156755","text":"WHS enforces all standard checks "},{"id":"spn-156756","marks":["bold"],"text":"as that user"},{"id":"spn-156757","text":", including:"}]}],"id":"blk-93309","kind":"list-item"},{"blocks":[{"id":"blk-93312","kind":"paragraph","spans":[{"id":"spn-156758","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-93311","kind":"list-item"},{"blocks":[{"id":"blk-93314","kind":"paragraph","spans":[{"id":"spn-156759","text":"agent status (not disabled),"}]}],"id":"blk-93313","kind":"list-item"},{"blocks":[{"id":"blk-93316","kind":"paragraph","spans":[{"id":"spn-156760","text":"active deployment present,"}]}],"id":"blk-93315","kind":"list-item"},{"blocks":[{"id":"blk-93318","kind":"paragraph","spans":[{"id":"spn-156761","text":"plan entitlements and limits,"}]}],"id":"blk-93317","kind":"list-item"},{"blocks":[{"id":"blk-93320","kind":"paragraph","spans":[{"id":"spn-156762","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-93319","kind":"list-item"},{"blocks":[{"id":"blk-93322","kind":"paragraph","spans":[{"id":"spn-156763","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-93321","kind":"list-item"},{"blocks":[{"id":"blk-93324","kind":"paragraph","spans":[{"id":"spn-156764","text":"any additional internal safety controls."}]}],"id":"blk-93323","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93325","kind":"paragraph","spans":[{"id":"spn-156765","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-93326","kind":"heading","level":2,"spans":[{"id":"spn-156766","text":"3) Normative request authentication"}]},{"id":"blk-93327","kind":"heading","level":3,"spans":[{"id":"spn-156767","text":"3.1 Required headers"}]},{"id":"blk-93328","kind":"paragraph","spans":[{"id":"spn-156768","text":"Delegated requests MUST include:"}]},{"id":"blk-93329","items":[{"blocks":[{"id":"blk-93331","kind":"paragraph","spans":[{"id":"spn-156769","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-93330","kind":"list-item"},{"blocks":[{"id":"blk-93333","kind":"paragraph","spans":[{"id":"spn-156770","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-93332","kind":"list-item"},{"blocks":[{"id":"blk-93335","kind":"paragraph","spans":[{"id":"spn-156771","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-93334","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93336","kind":"paragraph","spans":[{"id":"spn-156772","text":"Rules:"}]},{"id":"blk-93337","items":[{"blocks":[{"id":"blk-93339","kind":"paragraph","spans":[{"id":"spn-156773","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-93338","kind":"list-item"},{"blocks":[{"id":"blk-93341","kind":"paragraph","spans":[{"id":"spn-156774","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-93340","kind":"list-item"},{"blocks":[{"id":"blk-93343","kind":"paragraph","spans":[{"id":"spn-156775","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-93342","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93344","kind":"paragraph","spans":[{"id":"spn-156776","text":"Recommended default skew window:"}]},{"id":"blk-93345","items":[{"blocks":[{"id":"blk-93347","kind":"paragraph","spans":[{"id":"spn-156777","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-156778","text":" (5 minutes)"}]}],"id":"blk-93346","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93348","kind":"paragraph","spans":[{"id":"spn-156779","text":"If signature or timestamp validation fails:"}]},{"id":"blk-93349","items":[{"blocks":[{"id":"blk-93351","kind":"paragraph","spans":[{"id":"spn-156780","text":"return a normalized error:"}]}],"id":"blk-93350","kind":"list-item"},{"blocks":[{"id":"blk-93353","kind":"paragraph","spans":[{"id":"spn-156781","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-93352","kind":"list-item"},{"blocks":[{"id":"blk-93355","kind":"paragraph","spans":[{"id":"spn-156782","text":"safe "},{"id":"spn-156783","marks":["code"],"text":"message"}]}],"id":"blk-93354","kind":"list-item"},{"blocks":[{"id":"blk-93357","kind":"paragraph","spans":[{"id":"spn-156784","marks":["code"],"text":"retryable: false"},{"id":"spn-156785","text":" (recommended)"}]}],"id":"blk-93356","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93358","kind":"heading","level":3,"spans":[{"id":"spn-156786","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-93359","kind":"paragraph","spans":[{"id":"spn-156787","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-93360","items":[{"blocks":[{"id":"blk-93362","kind":"paragraph","spans":[{"id":"spn-156788","text":"e.g., "},{"id":"spn-156789","marks":["code"],"text":"agentromatic"},{"id":"spn-156790","text":", "},{"id":"spn-156791","marks":["code"],"text":"agentelic"},{"id":"spn-156792","text":" (future), "},{"id":"spn-156793","marks":["code"],"text":"internal"}]}],"id":"blk-93361","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93363","kind":"paragraph","spans":[{"id":"spn-156794","text":"Requests with an unknown "},{"id":"spn-156795","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-156796","text":" SHOULD be rejected with "},{"id":"spn-156797","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-156798","text":"."}]},{"id":"blk-93364","kind":"paragraph","spans":[{"id":"spn-156799","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-93365","kind":"heading","level":3,"spans":[{"id":"spn-156800","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-93366","kind":"paragraph","spans":[{"id":"spn-156801","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-93367","items":[{"blocks":[{"id":"blk-93369","kind":"paragraph","spans":[{"id":"spn-156802","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-93368","kind":"list-item"},{"blocks":[{"id":"blk-93371","kind":"paragraph","spans":[{"id":"spn-156803","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-156804","text":" (stable external auth subject id)"}]}],"id":"blk-93370","kind":"list-item"},{"blocks":[{"id":"blk-93373","kind":"paragraph","spans":[{"id":"spn-156805","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-156806","text":" (see §5)"}]}],"id":"blk-93372","kind":"list-item"},{"blocks":[{"id":"blk-93375","kind":"paragraph","spans":[{"id":"spn-156807","text":"optional correlation metadata for observability:"}]}],"id":"blk-93374","kind":"list-item"},{"blocks":[{"id":"blk-93377","kind":"paragraph","spans":[{"id":"spn-156808","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-93376","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93378","kind":"paragraph","spans":[{"id":"spn-156809","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-156810","marks":["code"],"text":"invoke"},{"id":"spn-156811","text":" (compatible with "},{"id":"spn-156812","marks":["code"],"text":"InvokeRequest"},{"id":"spn-156813","text":")."}]},{"id":"blk-93379","kind":"paragraph","spans":[{"id":"spn-156814","text":"The body MUST NOT include:"}]},{"id":"blk-93380","items":[{"blocks":[{"id":"blk-93382","kind":"paragraph","spans":[{"id":"spn-156815","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-93381","kind":"list-item"},{"blocks":[{"id":"blk-93384","kind":"paragraph","spans":[{"id":"spn-156816","text":"raw end-user auth tokens"}]}],"id":"blk-93383","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93385","kind":"heading","level":2,"spans":[{"id":"spn-156817","text":"4) Error semantics"}]},{"id":"blk-93386","kind":"paragraph","spans":[{"id":"spn-156818","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-93387","kind":"paragraph","spans":[{"id":"spn-156819","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-93388","items":[{"blocks":[{"id":"blk-93390","kind":"paragraph","spans":[{"id":"spn-156820","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-156821","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-93389","kind":"list-item"},{"blocks":[{"id":"blk-93392","kind":"paragraph","spans":[{"id":"spn-156822","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-156823","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-93391","kind":"list-item"},{"blocks":[{"id":"blk-93394","kind":"paragraph","spans":[{"id":"spn-156824","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-156825","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-93393","kind":"list-item"},{"blocks":[{"id":"blk-93396","kind":"paragraph","spans":[{"id":"spn-156826","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-156827","text":" (plan limits)"}]}],"id":"blk-93395","kind":"list-item"},{"blocks":[{"id":"blk-93398","kind":"paragraph","spans":[{"id":"spn-156828","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-156829","text":" (bad schema, oversized payload)"}]}],"id":"blk-93397","kind":"list-item"},{"blocks":[{"id":"blk-93400","kind":"paragraph","spans":[{"id":"spn-156830","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-156831","text":" (provider/runtime failures)"}]}],"id":"blk-93399","kind":"list-item"},{"blocks":[{"id":"blk-93402","kind":"paragraph","spans":[{"id":"spn-156832","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-93401","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93403","kind":"paragraph","spans":[{"id":"spn-156833","text":"Consistency rule:"}]},{"id":"blk-93404","items":[{"blocks":[{"id":"blk-93406","kind":"paragraph","spans":[{"id":"spn-156834","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-156835","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-156836","text":" over "},{"id":"spn-156837","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-156838","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-93405","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93407","kind":"heading","level":2,"spans":[{"id":"spn-156839","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-93408","kind":"paragraph","spans":[{"id":"spn-156840","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-93409","kind":"heading","level":3,"spans":[{"id":"spn-156841","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-93410","kind":"paragraph","spans":[{"id":"spn-156842","text":"Delegated invocation requests MUST include "},{"id":"spn-156843","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-156844","text":"."}]},{"id":"blk-93411","kind":"paragraph","spans":[{"id":"spn-156845","text":"The key MUST be:"}]},{"id":"blk-93412","items":[{"blocks":[{"id":"blk-93414","kind":"paragraph","spans":[{"id":"spn-156846","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-93413","kind":"list-item"},{"blocks":[{"id":"blk-93416","kind":"paragraph","spans":[{"id":"spn-156847","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-93415","kind":"list-item"},{"blocks":[{"id":"blk-93418","kind":"paragraph","spans":[{"id":"spn-156848","text":"secret-free,"}]}],"id":"blk-93417","kind":"list-item"},{"blocks":[{"id":"blk-93420","kind":"paragraph","spans":[{"id":"spn-156849","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-93419","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93421","kind":"heading","level":3,"spans":[{"id":"spn-156850","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-93422","kind":"paragraph","spans":[{"id":"spn-156851","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-93423","items":[{"blocks":[{"id":"blk-93425","kind":"paragraph","spans":[{"id":"spn-156852","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-93424","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93426","kind":"paragraph","spans":[{"id":"spn-156853","text":"Behavior:"}]},{"id":"blk-93427","items":[{"blocks":[{"id":"blk-93429","kind":"paragraph","spans":[{"id":"spn-156854","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-93428","kind":"list-item"},{"blocks":[{"id":"blk-93431","kind":"paragraph","spans":[{"id":"spn-156855","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-93430","kind":"list-item"},{"blocks":[{"id":"blk-93433","kind":"paragraph","spans":[{"id":"spn-156856","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-93432","kind":"list-item"},{"blocks":[{"id":"blk-93435","kind":"paragraph","spans":[{"id":"spn-156857","marks":["code"],"text":"CONFLICT"},{"id":"spn-156858","text":" or "},{"id":"spn-156859","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-156860","text":" (choose one; keep consistent),"}]}],"id":"blk-93434","kind":"list-item"},{"blocks":[{"id":"blk-93437","kind":"paragraph","spans":[{"id":"spn-156861","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-93436","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93438","kind":"paragraph","spans":[{"id":"spn-156862","text":"Implementation guidance (non-normative):"}]},{"id":"blk-93439","items":[{"blocks":[{"id":"blk-93441","kind":"paragraph","spans":[{"id":"spn-156863","text":"Store an idempotency ledger row containing:"}]}],"id":"blk-93440","kind":"list-item"},{"blocks":[{"id":"blk-93443","kind":"paragraph","spans":[{"id":"spn-156864","text":"request hash (e.g., sha256 of raw bytes),"}]}],"id":"blk-93442","kind":"list-item"},{"blocks":[{"id":"blk-93445","kind":"paragraph","spans":[{"id":"spn-156865","text":"response payload or response reference (bounded),"}]}],"id":"blk-93444","kind":"list-item"},{"blocks":[{"id":"blk-93447","kind":"paragraph","spans":[{"id":"spn-156866","text":"traceId/sessionId,"}]}],"id":"blk-93446","kind":"list-item"},{"blocks":[{"id":"blk-93449","kind":"paragraph","spans":[{"id":"spn-156867","text":"timestamps and status."}]}],"id":"blk-93448","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93450","kind":"heading","level":2,"spans":[{"id":"spn-156868","text":"6) Security analysis (threats and mitigations)"}]},{"id":"blk-93451","kind":"heading","level":3,"spans":[{"id":"spn-156869","text":"6.1 Threat: delegator attempts to invoke as another user"}]},{"id":"blk-93452","kind":"paragraph","spans":[{"id":"spn-156870","text":"Mitigation:"}]},{"id":"blk-93453","items":[{"blocks":[{"id":"blk-93455","kind":"paragraph","spans":[{"id":"spn-156871","text":"WHS enforces authorization based on "},{"id":"spn-156872","marks":["code"],"text":"externalUserId"},{"id":"spn-156873","text":" resolved user row."}]}],"id":"blk-93454","kind":"list-item"},{"blocks":[{"id":"blk-93457","kind":"paragraph","spans":[{"id":"spn-156874","text":"WHS enforces ownership/visibility checks and entitlements."}]}],"id":"blk-93456","kind":"list-item"},{"blocks":[{"id":"blk-93459","kind":"paragraph","spans":[{"id":"spn-156875","text":"Delegation does not grant cross-tenant access."}]}],"id":"blk-93458","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93460","kind":"heading","level":3,"spans":[{"id":"spn-156876","text":"6.2 Threat: replay attacks"}]},{"id":"blk-93461","kind":"paragraph","spans":[{"id":"spn-156877","text":"Mitigation:"}]},{"id":"blk-93462","items":[{"blocks":[{"id":"blk-93464","kind":"paragraph","spans":[{"id":"spn-156878","text":"Timestamp window validation (required)."}]}],"id":"blk-93463","kind":"list-item"},{"blocks":[{"id":"blk-93466","kind":"paragraph","spans":[{"id":"spn-156879","text":"Idempotency key dedupe (required)."}]}],"id":"blk-93465","kind":"list-item"},{"blocks":[{"id":"blk-93468","kind":"paragraph","spans":[{"id":"spn-156880","text":"Optional: store "},{"id":"spn-156881","marks":["code"],"text":"(source, idempotencyKey, timestamp)"},{"id":"spn-156882","text":" replay ledger (recommended if attack surface warrants)."}]}],"id":"blk-93467","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93469","kind":"heading","level":3,"spans":[{"id":"spn-156883","text":"6.3 Threat: secret leakage (logs, errors)"}]},{"id":"blk-93470","kind":"paragraph","spans":[{"id":"spn-156884","text":"Mitigation:"}]},{"id":"blk-93471","items":[{"blocks":[{"id":"blk-93473","kind":"paragraph","spans":[{"id":"spn-156885","text":"Never log signature headers or secret material."}]}],"id":"blk-93472","kind":"list-item"},{"blocks":[{"id":"blk-93475","kind":"paragraph","spans":[{"id":"spn-156886","text":"Normalize errors with safe messages."}]}],"id":"blk-93474","kind":"list-item"},{"blocks":[{"id":"blk-93477","kind":"paragraph","spans":[{"id":"spn-156887","text":"Bound and redact any stored snippets (if any)."}]}],"id":"blk-93476","kind":"list-item"},{"blocks":[{"id":"blk-93479","kind":"paragraph","spans":[{"id":"spn-156888","text":"Do not persist raw request bodies unbounded."}]}],"id":"blk-93478","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93480","kind":"heading","level":3,"spans":[{"id":"spn-156889","text":"6.4 Threat: abuse / DoS via delegated endpoint"}]},{"id":"blk-93481","kind":"paragraph","spans":[{"id":"spn-156890","text":"Mitigation:"}]},{"id":"blk-93482","items":[{"blocks":[{"id":"blk-93484","kind":"paragraph","spans":[{"id":"spn-156891","text":"Apply rate limiting per delegated user and per source."}]}],"id":"blk-93483","kind":"list-item"},{"blocks":[{"id":"blk-93486","kind":"paragraph","spans":[{"id":"spn-156892","text":"Apply plan limits before invoking runtime providers."}]}],"id":"blk-93485","kind":"list-item"},{"blocks":[{"id":"blk-93488","kind":"paragraph","spans":[{"id":"spn-156893","text":"Enforce payload size limits."}]}],"id":"blk-93487","kind":"list-item"},{"blocks":[{"id":"blk-93490","kind":"paragraph","spans":[{"id":"spn-156894","text":"Consider additional internal caps per "},{"id":"spn-156895","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-156896","text":"."}]}],"id":"blk-93489","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93491","kind":"heading","level":2,"spans":[{"id":"spn-156897","text":"7) Consequences"}]},{"id":"blk-93492","kind":"heading","level":3,"spans":[{"id":"spn-156898","text":"Positive"}]},{"id":"blk-93493","items":[{"blocks":[{"id":"blk-93495","kind":"paragraph","spans":[{"id":"spn-156899","text":"Enables durable server-side orchestration systems to invoke WHS safely without browser token forwarding."}]}],"id":"blk-93494","kind":"list-item"},{"blocks":[{"id":"blk-93497","kind":"paragraph","spans":[{"id":"spn-156900","text":"Keeps WHS authoritative for cost/limits and tenant isolation."}]}],"id":"blk-93496","kind":"list-item"},{"blocks":[{"id":"blk-93499","kind":"paragraph","spans":[{"id":"spn-156901","text":"Reuses the proven HMAC-over-raw-bytes integrity pattern."}]}],"id":"blk-93498","kind":"list-item"},{"blocks":[{"id":"blk-93501","kind":"paragraph","spans":[{"id":"spn-156902","text":"Provides clean correlation between workflows (or other orchestrators) and WHS telemetry via metadata."}]}],"id":"blk-93500","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-93502","kind":"heading","level":