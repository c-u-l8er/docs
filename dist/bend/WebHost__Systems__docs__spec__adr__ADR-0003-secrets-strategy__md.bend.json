{"bendscript":"0.1","blocks":[{"id":"blk-31615","kind":"heading","level":1,"spans":[{"id":"spn-34457","text":"ADR-0003: Secrets Handling & Provider Injection Strategy"}]},{"id":"blk-31616","items":[{"blocks":[{"id":"blk-31618","kind":"paragraph","spans":[{"id":"spn-34458","marks":["bold"],"text":"Status:"},{"id":"spn-34459","text":" Accepted"}]}],"id":"blk-31617","kind":"list-item"},{"blocks":[{"id":"blk-31620","kind":"paragraph","spans":[{"id":"spn-34460","marks":["bold"],"text":"Date:"},{"id":"spn-34461","text":" 2026-01-21"}]}],"id":"blk-31619","kind":"list-item"},{"blocks":[{"id":"blk-31622","kind":"paragraph","spans":[{"id":"spn-34462","marks":["bold"],"text":"Owners:"},{"id":"spn-34463","text":" Engineering"}]}],"id":"blk-31621","kind":"list-item"},{"blocks":[{"id":"blk-31624","kind":"paragraph","spans":[{"id":"spn-34464","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-31623","kind":"list-item"},{"blocks":[{"id":"blk-31626","kind":"paragraph","spans":[{"id":"spn-34465","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-31625","kind":"list-item"},{"blocks":[{"id":"blk-31628","kind":"paragraph","spans":[{"id":"spn-34466","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-31627","kind":"list-item"},{"blocks":[{"id":"blk-31630","kind":"paragraph","spans":[{"id":"spn-34467","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-31629","kind":"list-item"},{"blocks":[{"id":"blk-31632","kind":"paragraph","spans":[{"id":"spn-34468","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-31631","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31633","kind":"heading","level":2,"spans":[{"id":"spn-34469","text":"Context"}]},{"id":"blk-31634","kind":"paragraph","spans":[{"id":"spn-34470","text":"webhost.systems is a multi-runtime AI agent deployment platform with:"}]},{"id":"blk-31635","items":[{"blocks":[{"id":"blk-31637","kind":"paragraph","spans":[{"id":"spn-34471","marks":["bold"],"text":"Control plane:"},{"id":"spn-34472","text":" Auth, dashboard, agent/deployment metadata, billing, limits, metrics aggregation."}]}],"id":"blk-31636","kind":"list-item"},{"blocks":[{"id":"blk-31639","kind":"paragraph","spans":[{"id":"spn-34473","marks":["bold"],"text":"Data plane:"},{"id":"spn-34474","text":" Executes customer agent code on runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore)."}]}],"id":"blk-31638","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31640","kind":"paragraph","spans":[{"id":"spn-34475","text":"The platform must handle several categories of secrets:"}]},{"id":"blk-31641","items":[{"blocks":[{"id":"blk-31643","kind":"paragraph","spans":[{"id":"spn-34476","marks":["bold"],"text":"Customer secrets:"},{"id":"spn-34477","text":" model keys (e.g., "},{"id":"spn-34478","marks":["code"],"text":"OPENAI_API_KEY"},{"id":"spn-34479","text":"), third-party API keys used by agent code."}]}],"id":"blk-31642","kind":"list-item"},{"blocks":[{"id":"blk-31645","kind":"paragraph","spans":[{"id":"spn-34480","marks":["bold"],"text":"Platform secrets:"},{"id":"spn-34481","text":" Cloudflare API tokens, AWS credentials/roles, billing webhook secret, internal signing keys."}]}],"id":"blk-31644","kind":"list-item"},{"blocks":[{"id":"blk-31647","kind":"paragraph","spans":[{"id":"spn-34482","marks":["bold"],"text":"Integrity secrets:"},{"id":"spn-34483","text":" telemetry signing keys (deployment-scoped)."}]}],"id":"blk-31646","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31648","kind":"paragraph","spans":[{"id":"spn-34484","text":"Constraints:"}]},{"id":"blk-31649","items":[{"blocks":[{"id":"blk-31651","kind":"paragraph","spans":[{"id":"spn-34485","text":"Customer agent code is "},{"id":"spn-34486","marks":["bold"],"text":"untrusted"},{"id":"spn-34487","text":" and may exfiltrate secrets it is given; therefore secrets must be scoped and minimized."}]}],"id":"blk-31650","kind":"list-item"},{"blocks":[{"id":"blk-31653","kind":"paragraph","spans":[{"id":"spn-34488","text":"The platform must support "},{"id":"spn-34489","marks":["bold"],"text":"multiple runtimes"},{"id":"spn-34490","text":", each with different secret injection mechanisms."}]}],"id":"blk-31652","kind":"list-item"},{"blocks":[{"id":"blk-31655","kind":"paragraph","spans":[{"id":"spn-34491","text":"The platform must enable "},{"id":"spn-34492","marks":["bold"],"text":"telemetry integrity"},{"id":"spn-34493","text":": data plane must report usage to control plane without allowing spoofing."}]}],"id":"blk-31654","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31656","kind":"paragraph","spans":[{"id":"spn-34494","text":"Security and operational requirements:"}]},{"id":"blk-31657","items":[{"blocks":[{"id":"blk-31659","kind":"paragraph","spans":[{"id":"spn-34495","text":"Minimize blast radius of a control-plane DB read breach."}]}],"id":"blk-31658","kind":"list-item"},{"blocks":[{"id":"blk-31661","kind":"paragraph","spans":[{"id":"spn-34496","text":"Prevent secret leakage via logs, errors, metrics, or UI."}]}],"id":"blk-31660","kind":"list-item"},{"blocks":[{"id":"blk-31663","kind":"paragraph","spans":[{"id":"spn-34497","text":"Support secret rotation with minimal operational burden."}]}],"id":"blk-31662","kind":"list-item"},{"blocks":[{"id":"blk-31665","kind":"paragraph","spans":[{"id":"spn-34498","text":"Keep implementation feasible for MVP while providing a clear path to stronger controls."}]}],"id":"blk-31664","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31666","kind":"heading","level":2,"spans":[{"id":"spn-34499","text":"Decision"}]},{"id":"blk-31667","kind":"paragraph","spans":[{"id":"spn-34500","text":"1. "},{"id":"spn-34501","marks":["bold"],"text":"No plaintext secrets are stored in the primary application database"},{"id":"spn-34502","text":" (Supabase)."}]},{"id":"blk-31668","items":[{"blocks":[{"id":"blk-31670","kind":"paragraph","spans":[{"id":"spn-34503","text":"The DB stores only:"}]}],"id":"blk-31669","kind":"list-item"},{"blocks":[{"id":"blk-31672","kind":"paragraph","spans":[{"id":"spn-34504","text":"secret key names (e.g., "},{"id":"spn-34505","marks":["code"],"text":"envVarKeys"},{"id":"spn-34506","text":"),"}]}],"id":"blk-31671","kind":"list-item"},{"blocks":[{"id":"blk-31674","kind":"paragraph","spans":[{"id":"spn-34507","text":"provider secret references (names/ids),"}]}],"id":"blk-31673","kind":"list-item"},{"blocks":[{"id":"blk-31676","kind":"paragraph","spans":[{"id":"spn-34508","text":"rotation metadata (timestamps, versions),"}]}],"id":"blk-31675","kind":"list-item"},{"blocks":[{"id":"blk-31678","kind":"paragraph","spans":[{"id":"spn-34509","text":"booleans like “is configured”."}]}],"id":"blk-31677","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31679","kind":"paragraph","spans":[{"id":"spn-34510","text":"2. "},{"id":"spn-34511","marks":["bold"],"text":"Secrets are injected into runtime providers using provider-native secret mechanisms"},{"id":"spn-34512","text":" (where possible)."}]},{"id":"blk-31680","items":[{"blocks":[{"id":"blk-31682","kind":"paragraph","spans":[{"id":"spn-34513","marks":["bold"],"text":"Cloudflare:"},{"id":"spn-34514","text":" Worker secret bindings (set via Cloudflare API)."}]}],"id":"blk-31681","kind":"list-item"},{"blocks":[{"id":"blk-31684","kind":"paragraph","spans":[{"id":"spn-34515","marks":["bold"],"text":"AWS / AgentCore:"},{"id":"spn-34516","text":" "},{"id":"spn-34517","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-34518","text":" via the AgentCore Runtime API (recommended default for v1), with "},{"id":"spn-34519","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-34520","text":" as an optional enhancement for advanced rotation and centralized secret management."}]}],"id":"blk-31683","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31685","kind":"paragraph","spans":[{"id":"spn-34521","text":"3. "},{"id":"spn-34522","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped signing keys"},{"id":"spn-34523","text":" injected into the runtime as secrets."}]},{"id":"blk-31686","items":[{"blocks":[{"id":"blk-31688","kind":"paragraph","spans":[{"id":"spn-34524","text":"Each deployment gets a unique "},{"id":"spn-34525","marks":["code"],"text":"telemetrySecret"},{"id":"spn-34526","text":" (HMAC key)."}]}],"id":"blk-31687","kind":"list-item"},{"blocks":[{"id":"blk-31690","kind":"paragraph","spans":[{"id":"spn-34527","text":"Data plane signs telemetry payloads with HMAC-SHA256 over raw request bytes."}]}],"id":"blk-31689","kind":"list-item"},{"blocks":[{"id":"blk-31692","kind":"paragraph","spans":[{"id":"spn-34528","text":"Control plane verifies signature using the secret reference associated with the deployment."}]}],"id":"blk-31691","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31693","kind":"paragraph","spans":[{"id":"spn-34529","text":"4. "},{"id":"spn-34530","marks":["bold"],"text":"Control plane never exposes secret values back to clients."}]},{"id":"blk-31694","items":[{"blocks":[{"id":"blk-31696","kind":"paragraph","spans":[{"id":"spn-34531","text":"A “set secrets” endpoint may exist and is write-only."}]}],"id":"blk-31695","kind":"list-item"},{"blocks":[{"id":"blk-31698","kind":"paragraph","spans":[{"id":"spn-34532","text":"A “get secrets” endpoint for plaintext MUST NOT exist."}]}],"id":"blk-31697","kind":"list-item"},{"blocks":[{"id":"blk-31700","kind":"paragraph","spans":[{"id":"spn-34533","text":"The UI can show only:"}]}],"id":"blk-31699","kind":"list-item"},{"blocks":[{"id":"blk-31702","kind":"paragraph","spans":[{"id":"spn-34534","text":"configured keys list,"}]}],"id":"blk-31701","kind":"list-item"},{"blocks":[{"id":"blk-31704","kind":"paragraph","spans":[{"id":"spn-34535","text":"status per key (set/not set),"}]}],"id":"blk-31703","kind":"list-item"},{"blocks":[{"id":"blk-31706","kind":"paragraph","spans":[{"id":"spn-34536","text":"last rotated timestamp (optional)."}]}],"id":"blk-31705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31707","kind":"heading","level":2,"spans":[{"id":"spn-34537","text":"Rationale"}]},{"id":"blk-31708","items":[{"blocks":[{"id":"blk-31710","kind":"paragraph","spans":[{"id":"spn-34538","marks":["bold"],"text":"Reduces breach impact:"},{"id":"spn-34539","text":" If the primary DB is compromised, attackers do not automatically obtain usable API keys."}]}],"id":"blk-31709","kind":"list-item"},{"blocks":[{"id":"blk-31712","kind":"paragraph","spans":[{"id":"spn-34540","marks":["bold"],"text":"Aligns with best practices:"},{"id":"spn-34541","text":" Provider secret stores are purpose-built for secret storage and rotation."}]}],"id":"blk-31711","kind":"list-item"},{"blocks":[{"id":"blk-31714","kind":"paragraph","spans":[{"id":"spn-34542","marks":["bold"],"text":"Enables multi-runtime:"},{"id":"spn-34543","text":" Provider injection allows per-runtime deployment without inventing a bespoke secret distribution system."}]}],"id":"blk-31713","kind":"list-item"},{"blocks":[{"id":"blk-31716","kind":"paragraph","spans":[{"id":"spn-34544","marks":["bold"],"text":"Supports telemetry integrity:"},{"id":"spn-34545","text":" Deployment-scoped secrets and HMAC signatures prevent spoofing of usage events, which protects billing and limit enforcement."}]}],"id":"blk-31715","kind":"list-item"},{"blocks":[{"id":"blk-31718","kind":"paragraph","spans":[{"id":"spn-34546","marks":["bold"],"text":"Keeps MVP achievable:"},{"id":"spn-34547","text":" Write-only secrets entry + provider injection is implementable without building a full secrets vault and policy engine."}]}],"id":"blk-31717","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31719","kind":"heading","level":2,"spans":[{"id":"spn-34548","text":"Alternatives considered"}]},{"id":"blk-31720","kind":"heading","level":3,"spans":[{"id":"spn-34549","text":"A) Store encrypted secrets in the primary DB (application-managed encryption)"}]},{"id":"blk-31721","kind":"paragraph","spans":[{"id":"spn-34550","marks":["bold"],"text":"Pros"}]},{"id":"blk-31722","items":[{"blocks":[{"id":"blk-31724","kind":"paragraph","spans":[{"id":"spn-34551","text":"Simple read/write path."}]}],"id":"blk-31723","kind":"list-item"},{"blocks":[{"id":"blk-31726","kind":"paragraph","spans":[{"id":"spn-34552","text":"Centralized regardless of runtime provider."}]}],"id":"blk-31725","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31727","kind":"paragraph","spans":[{"id":"spn-34553","marks":["bold"],"text":"Cons"}]},{"id":"blk-31728","items":[{"blocks":[{"id":"blk-31730","kind":"paragraph","spans":[{"id":"spn-34554","text":"Key management becomes a major responsibility (KMS integration, rotation, access controls)."}]}],"id":"blk-31729","kind":"list-item"},{"blocks":[{"id":"blk-31732","kind":"paragraph","spans":[{"id":"spn-34555","text":"If application and DB are compromised, secrets may still be exposed via runtime memory or logs."}]}],"id":"blk-31731","kind":"list-item"},{"blocks":[{"id":"blk-31734","kind":"paragraph","spans":[{"id":"spn-34556","text":"More complex than necessary for MVP given provider secret facilities."}]}],"id":"blk-31733","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31735","kind":"paragraph","spans":[{"id":"spn-34557","marks":["bold"],"text":"Decision:"},{"id":"spn-34558","text":" Rejected for v1 (may revisit if a centralized secrets vault is required)."}]},{"id":"blk-31736","kind":"heading","level":3,"spans":[{"id":"spn-34559","text":"B) Centralized secret store for all secrets (e.g., dedicated vault) + runtime fetch at execution time"}]},{"id":"blk-31737","kind":"paragraph","spans":[{"id":"spn-34560","marks":["bold"],"text":"Pros"}]},{"id":"blk-31738","items":[{"blocks":[{"id":"blk-31740","kind":"paragraph","spans":[{"id":"spn-34561","text":"Single system of record, policy controls, potential audit/compliance benefits."}]}],"id":"blk-31739","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31741","kind":"paragraph","spans":[{"id":"spn-34562","marks":["bold"],"text":"Cons"}]},{"id":"blk-31742","items":[{"blocks":[{"id":"blk-31744","kind":"paragraph","spans":[{"id":"spn-34563","text":"Adds significant infrastructure and operational complexity."}]}],"id":"blk-31743","kind":"list-item"},{"blocks":[{"id":"blk-31746","kind":"paragraph","spans":[{"id":"spn-34564","text":"Requires secure runtime access and network paths from every provider."}]}],"id":"blk-31745","kind":"list-item"},{"blocks":[{"id":"blk-31748","kind":"paragraph","spans":[{"id":"spn-34565","text":"Introduces availability coupling: vault outage can break invocations."}]}],"id":"blk-31747","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31749","kind":"paragraph","spans":[{"id":"spn-34566","marks":["bold"],"text":"Decision:"},{"id":"spn-34567","text":" Rejected for v1; consider for enterprise roadmap if needed."}]},{"id":"blk-31750","kind":"heading","level":3,"spans":[{"id":"spn-34568","text":"C) Embed secrets in deployment artifacts or config files"}]},{"id":"blk-31751","kind":"paragraph","spans":[{"id":"spn-34569","marks":["bold"],"text":"Pros"}]},{"id":"blk-31752","items":[{"blocks":[{"id":"blk-31754","kind":"paragraph","spans":[{"id":"spn-34570","text":"Easiest to implement."}]}],"id":"blk-31753","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31755","kind":"paragraph","spans":[{"id":"spn-34571","marks":["bold"],"text":"Cons"}]},{"id":"blk-31756","items":[{"blocks":[{"id":"blk-31758","kind":"paragraph","spans":[{"id":"spn-34572","text":"Catastrophic: secrets leak via artifacts, logs, and provider introspection."}]}],"id":"blk-31757","kind":"list-item"},{"blocks":[{"id":"blk-31760","kind":"paragraph","spans":[{"id":"spn-34573","text":"Violates core security requirement."}]}],"id":"blk-31759","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31761","kind":"paragraph","spans":[{"id":"spn-34574","marks":["bold"],"text":"Decision:"},{"id":"spn-34575","text":" Rejected."}]},{"id":"blk-31762","kind":"heading","level":3,"spans":[{"id":"spn-34576","text":"D) Adapter-side telemetry only (no runtime telemetry secret)"}]},{"id":"blk-31763","kind":"paragraph","spans":[{"id":"spn-34577","marks":["bold"],"text":"Pros"}]},{"id":"blk-31764","items":[{"blocks":[{"id":"blk-31766","kind":"paragraph","spans":[{"id":"spn-34578","text":"Avoids injecting telemetry secret into runtime."}]}],"id":"blk-31765","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31767","kind":"paragraph","spans":[{"id":"spn-34579","marks":["bold"],"text":"Cons"}]},{"id":"blk-31768","items":[{"blocks":[{"id":"blk-31770","kind":"paragraph","spans":[{"id":"spn-34580","text":"Often cannot capture accurate compute/tool usage."}]}],"id":"blk-31769","kind":"list-item"},{"blocks":[{"id":"blk-31772","kind":"paragraph","spans":[{"id":"spn-34581","text":"Harder to attribute reliably at high concurrency; may undercount or miscount."}]}],"id":"blk-31771","kind":"list-item"},{"blocks":[{"id":"blk-31774","kind":"paragraph","spans":[{"id":"spn-34582","text":"Still requires strong integrity controls in adapter pathway."}]}],"id":"blk-31773","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31775","kind":"paragraph","spans":[{"id":"spn-34583","marks":["bold"],"text":"Decision:"},{"id":"spn-34584","text":" Not the primary strategy. Allowed only as a constrained fallback if provider limitations require it, but must preserve attribution integrity."}]},{"id":"blk-31776","kind":"heading","level":2,"spans":[{"id":"spn-34585","text":"Consequences"}]},{"id":"blk-31777","kind":"heading","level":3,"spans":[{"id":"spn-34586","text":"Positive"}]},{"id":"blk-31778","items":[{"blocks":[{"id":"blk-31780","kind":"paragraph","spans":[{"id":"spn-34587","text":"Stronger baseline security posture without heavy infrastructure."}]}],"id":"blk-31779","kind":"list-item"},{"blocks":[{"id":"blk-31782","kind":"paragraph","spans":[{"id":"spn-34588","text":"Clear separation of responsibilities:"}]}],"id":"blk-31781","kind":"list-item"},{"blocks":[{"id":"blk-31784","kind":"paragraph","spans":[{"id":"spn-34589","text":"DB stores metadata and references,"}]}],"id":"blk-31783","kind":"list-item"},{"blocks":[{"id":"blk-31786","kind":"paragraph","spans":[{"id":"spn-34590","text":"providers store values."}]}],"id":"blk-31785","kind":"list-item"},{"blocks":[{"id":"blk-31788","kind":"paragraph","spans":[{"id":"spn-34591","text":"Enables per-deployment telemetry signing and robust anti-spoofing."}]}],"id":"blk-31787","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31789","kind":"heading","level":3,"spans":[{"id":"spn-34592","text":"Negative / tradeoffs"}]},{"id":"blk-31790","items":[{"blocks":[{"id":"blk-31792","kind":"paragraph","spans":[{"id":"spn-34593","text":"Secret management becomes provider-dependent; implementation must support multiple injection mechanisms."}]}],"id":"blk-31791","kind":"list-item"},{"blocks":[{"id":"blk-31794","kind":"paragraph","spans":[{"id":"spn-34594","text":"Secret rotation may require redeploy on some providers."}]}],"id":"blk-31793","kind":"list-item"},{"blocks":[{"id":"blk-31796","kind":"paragraph","spans":[{"id":"spn-34595","text":"Debugging becomes harder because plaintext is not retrievable; must rely on “configured/not configured” and test invocations."}]}],"id":"blk-31795","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31797","kind":"heading","level":2,"spans":[{"id":"spn-34596","text":"Implementation details (normative)"}]},{"id":"blk-31798","kind":"heading","level":3,"spans":[{"id":"spn-34597","text":"1) Data model requirements"}]},{"id":"blk-31799","items":[{"blocks":[{"id":"blk-31801","kind":"paragraph","spans":[{"id":"spn-34598","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-34599","text":": list of secret key names (never values)."}]}],"id":"blk-31800","kind":"list-item"},{"blocks":[{"id":"blk-31803","kind":"paragraph","spans":[{"id":"spn-34600","marks":["code"],"text":"deployments.telemetryAuthRef"},{"id":"spn-34601","text":": provider reference to telemetry signing secret (never plaintext)."}]}],"id":"blk-31802","kind":"list-item"},{"blocks":[{"id":"blk-31805","kind":"paragraph","spans":[{"id":"spn-34602","text":"Optional "},{"id":"spn-34603","marks":["code"],"text":"secrets"},{"id":"spn-34604","text":" metadata table (if implemented) stores only:"}]}],"id":"blk-31804","kind":"list-item"},{"blocks":[{"id":"blk-31807","kind":"paragraph","spans":[{"id":"spn-34605","marks":["code"],"text":"userId"},{"id":"spn-34606","text":", "},{"id":"spn-34607","marks":["code"],"text":"agentId"},{"id":"spn-34608","text":", "},{"id":"spn-34609","marks":["code"],"text":"key"},{"id":"spn-34610","text":", "},{"id":"spn-34611","marks":["code"],"text":"provider"},{"id":"spn-34612","text":", "},{"id":"spn-34613","marks":["code"],"text":"secretRef"},{"id":"spn-34614","text":", "},{"id":"spn-34615","marks":["code"],"text":"createdAtMs"},{"id":"spn-34616","text":", "},{"id":"spn-34617","marks":["code"],"text":"rotatedAtMs"},{"id":"spn-34618","text":"."}]}],"id":"blk-31806","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31808","kind":"heading","level":3,"spans":[{"id":"spn-34619","text":"2) Secrets write endpoint"}]},{"id":"blk-31809","kind":"paragraph","spans":[{"id":"spn-34620","text":"If implementing "},{"id":"spn-34621","marks":["code"],"text":"POST /v1/agents/{agentId}/secrets"},{"id":"spn-34622","text":" (write-only):"}]},{"id":"blk-31810","items":[{"blocks":[{"id":"blk-31812","kind":"paragraph","spans":[{"id":"spn-34623","text":"MUST authenticate and enforce tenant ownership."}]}],"id":"blk-31811","kind":"list-item"},{"blocks":[{"id":"blk-31814","kind":"paragraph","spans":[{"id":"spn-34624","text":"MUST validate keys against "},{"id":"spn-34625","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-34626","text":" (or allow adding new keys via "},{"id":"spn-34627","marks":["code"],"text":"agents.update"},{"id":"spn-34628","text":" first)."}]}],"id":"blk-31813","kind":"list-item"},{"blocks":[{"id":"blk-31816","kind":"paragraph","spans":[{"id":"spn-34629","text":"MUST store values only in provider secret store(s) and discard plaintext immediately after injection."}]}],"id":"blk-31815","kind":"list-item"},{"blocks":[{"id":"blk-31818","kind":"paragraph","spans":[{"id":"spn-34630","text":"MUST NOT return secret values."}]}],"id":"blk-31817","kind":"list-item"},{"blocks":[{"id":"blk-31820","kind":"paragraph","spans":[{"id":"spn-34631","text":"MUST redact secret values in logs and error messages."}]}],"id":"blk-31819","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31821","kind":"heading","level":3,"spans":[{"id":"spn-34632","text":"3) Provider injection requirements"}]},{"id":"blk-31822","items":[{"blocks":[{"id":"blk-31824","kind":"paragraph","spans":[{"id":"spn-34633","text":"Cloudflare adapter:"}]}],"id":"blk-31823","kind":"list-item"},{"blocks":[{"id":"blk-31826","kind":"paragraph","spans":[{"id":"spn-34634","text":"Use provider API to set Worker secrets per deployment or per agent, and ensure the active Worker uses the correct secrets."}]}],"id":"blk-31825","kind":"list-item"},{"blocks":[{"id":"blk-31828","kind":"paragraph","spans":[{"id":"spn-34635","text":"AgentCore adapter:"}]}],"id":"blk-31827","kind":"list-item"},{"blocks":[{"id":"blk-31830","kind":"paragraph","spans":[{"id":"spn-34636","text":"Use "},{"id":"spn-34637","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-34638","text":" (v1 default) to set deployment-scoped secrets (telemetry signing key, user-provided API keys) as runtime environment variables."}]}],"id":"blk-31829","kind":"list-item"},{"blocks":[{"id":"blk-31832","kind":"paragraph","spans":[{"id":"spn-34639","text":"Use "},{"id":"spn-34640","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-34641","text":" as an optional enhancement (post-v1 or enterprise hardening) to support rotation without redeploy and centralized secret governance."}]}],"id":"blk-31831","kind":"list-item"},{"blocks":[{"id":"blk-31834","kind":"paragraph","spans":[{"id":"spn-34642","text":"Store only "},{"id":"spn-34643","marks":["bold"],"text":"references/metadata"},{"id":"spn-34644","text":" in the control plane DB (e.g., runtime env var key names and/or Secrets Manager ARNs). Never store plaintext values."}]}],"id":"blk-31833","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31835","kind":"heading","level":4,"spans":[{"id":"spn-34645","text":"AgentCore secret injection (implementation note)"}]},{"id":"blk-31836","kind":"paragraph","spans":[{"id":"spn-34646","text":"AgentCore supports multiple secret injection patterns. For v1, prefer environment variables because it minimizes moving parts and matches the Cloudflare deployment model (provider-managed secret injection at deploy time)."}]},{"id":"blk-31837","items":[{"blocks":[{"id":"blk-31839","kind":"paragraph","spans":[{"id":"spn-34647","marks":["bold"],"text":"Option 1 (v1 default): Environment variables"}]}],"id":"blk-31838","kind":"list-item"},{"blocks":[{"id":"blk-31841","kind":"paragraph","spans":[{"id":"spn-34648","text":"Control plane sets runtime environment variables as part of the deploy/create/update runtime call."}]}],"id":"blk-31840","kind":"list-item"},{"blocks":[{"id":"blk-31843","kind":"paragraph","spans":[{"id":"spn-34649","text":"Example variables:"}]}],"id":"blk-31842","kind":"list-item"},{"blocks":[{"id":"blk-31845","kind":"paragraph","spans":[{"id":"spn-34650","marks":["code"],"text":"TELEMETRY_SECRET"},{"id":"spn-34651","text":" (deployment-scoped HMAC key)"}]}],"id":"blk-31844","kind":"list-item"},{"blocks":[{"id":"blk-31847","kind":"paragraph","spans":[{"id":"spn-34652","text":"user-provided keys like "},{"id":"spn-34653","marks":["code"],"text":"OPENAI_API_KEY"}]}],"id":"blk-31846","kind":"list-item"},{"blocks":[{"id":"blk-31849","kind":"paragraph","spans":[{"id":"spn-34654","text":"Operational note: rotation may require redeploy depending on provider behavior; document in UI."}]}],"id":"blk-31848","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31850","items":[{"blocks":[{"id":"blk-31852","kind":"paragraph","spans":[{"id":"spn-34655","marks":["bold"],"text":"Option 2 (optional): AWS Secrets Manager references"}]}],"id":"blk-31851","kind":"list-item"},{"blocks":[{"id":"blk-31854","kind":"paragraph","spans":[{"id":"spn-34656","text":"Store secret values in Secrets Manager."}]}],"id":"blk-31853","kind":"list-item"},{"blocks":[{"id":"blk-31856","kind":"paragraph","spans":[{"id":"spn-34657","text":"Provide the runtime with references (ARNs) and an IAM role that permits retrieval."}]}],"id":"blk-31855","kind":"list-item"},{"blocks":[{"id":"blk-31858","kind":"paragraph","spans":[{"id":"spn-34658","text":"Operational note: enables rotation without redeploy, but increases IAM + operational complexity."}]}],"id":"blk-31857","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31859","kind":"heading","level":3,"spans":[{"id":"spn-34659","text":"4) Telemetry signing requirements"}]},{"id":"blk-31860","items":[{"blocks":[{"id":"blk-31862","kind":"paragraph","spans":[{"id":"spn-34660","text":"Each deployment MUST have a unique telemetry signing secret."}]}],"id":"blk-31861","kind":"list-item"},{"blocks":[{"id":"blk-31864","kind":"paragraph","spans":[{"id":"spn-34661","text":"Runtime sends telemetry with:"}]}],"id":"blk-31863","kind":"list-item"},{"blocks":[{"id":"blk-31866","kind":"paragraph","spans":[{"id":"spn-34662","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-31865","kind":"list-item"},{"blocks":[{"id":"blk-31868","kind":"paragraph","spans":[{"id":"spn-34663","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex-hmac-sha256(body)>"}]}],"id":"blk-31867","kind":"list-item"},{"blocks":[{"id":"blk-31870","kind":"paragraph","spans":[{"id":"spn-34664","text":"Control plane MUST verify:"}]}],"id":"blk-31869","kind":"list-item"},{"blocks":[{"id":"blk-31872","kind":"paragraph","spans":[{"id":"spn-34665","text":"signature validity,"}]}],"id":"blk-31871","kind":"list-item"},{"blocks":[{"id":"blk-31874","kind":"paragraph","spans":[{"id":"spn-34666","text":"deployment ownership mapping to "},{"id":"spn-34667","marks":["code"],"text":"{userId, agentId}"},{"id":"spn-34668","text":","}]}],"id":"blk-31873","kind":"list-item"},{"blocks":[{"id":"blk-31876","kind":"paragraph","spans":[{"id":"spn-34669","text":"required attribution fields."}]}],"id":"blk-31875","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31877","kind":"heading","level":3,"spans":[{"id":"spn-34670","text":"5) Rotation policy"}]},{"id":"blk-31878","items":[{"blocks":[{"id":"blk-31880","kind":"paragraph","spans":[{"id":"spn-34671","text":"Telemetry secrets:"}]}],"id":"blk-31879","kind":"list-item"},{"blocks":[{"id":"blk-31882","kind":"paragraph","spans":[{"id":"spn-34672","text":"MUST rotate on every new deployment by default."}]}],"id":"blk-31881","kind":"list-item"},{"blocks":[{"id":"blk-31884","kind":"paragraph","spans":[{"id":"spn-34673","text":"Customer secrets:"}]}],"id":"blk-31883","kind":"list-item"},{"blocks":[{"id":"blk-31886","kind":"paragraph","spans":[{"id":"spn-34674","text":"MAY be rotated by user action; system SHOULD record rotation timestamp."}]}],"id":"blk-31885","kind":"list-item"},{"blocks":[{"id":"blk-31888","kind":"paragraph","spans":[{"id":"spn-34675","text":"If provider requires redeploy for new secret values to take effect, UI MUST make this explicit."}]}],"id":"blk-31887","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31889","kind":"heading","level":2,"spans":[{"id":"spn-34676","text":"Security & compliance notes"}]},{"id":"blk-31890","items":[{"blocks":[{"id":"blk-31892","kind":"paragraph","spans":[{"id":"spn-34677","text":"This ADR supports a SOC2-aligned posture by:"}]}],"id":"blk-31891","kind":"list-item"},{"blocks":[{"id":"blk-31894","kind":"paragraph","spans":[{"id":"spn-34678","text":"minimizing sensitive data stored in primary DB,"}]}],"id":"blk-31893","kind":"list-item"},{"blocks":[{"id":"blk-31896","kind":"paragraph","spans":[{"id":"spn-34679","text":"ensuring integrity of billing-relevant telemetry,"}]}],"id":"blk-31895","kind":"list-item"},{"blocks":[{"id":"blk-31898","kind":"paragraph","spans":[{"id":"spn-34680","text":"enabling auditability (via audit logs for secrets set and telemetry rejections)."}]}],"id":"blk-31897","kind":"list-item"},{"blocks":[{"id":"blk-31900","kind":"paragraph","spans":[{"id":"spn-34681","text":"This ADR does not eliminate the inherent risk that untrusted customer agent code can exfiltrate secrets it is given; the platform mitigates by scoping secrets per agent and avoiding cross-tenant exposure."}]}],"id":"blk-31899","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31901","kind":"heading","level":2,"spans":[{"id":"spn-34682","text":"Acceptance criteria"}]},{"id":"blk-31902","kind":"paragraph","spans":[{"id":"spn-34683","text":"This ADR is correctly implemented when: 1. No plaintext secret values exist in the primary DB (verified via code review and automated checks). 2. Secrets set via API are write-only; plaintext secrets are never returned. 3. Provider secrets are injected and required for runtime invocation (e.g., model keys, telemetry signing secret). 4. Telemetry ingestion rejects invalid signatures and mismatched ownership. 5. Logs and error messages are sanitized and do not contain secret values. 6. Secret rotation is supported at least via “set new value” flow and telemetry secrets rotate per deployment."}]}],"edges":[],"id":"bagaaieraz5ggw6xluxm6mqdvyxvfzxzl3hq5htmyz4eqxofxz4loxftnezoa","vocabulary":"ampersand.docs.fs.v1"}