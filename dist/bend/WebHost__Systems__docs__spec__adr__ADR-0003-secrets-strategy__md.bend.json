{"bendscript":"0.1","blocks":[{"id":"blk-51648","kind":"heading","level":1,"spans":[{"id":"spn-80144","text":"ADR-0003: Secrets Handling & Provider Injection Strategy"}]},{"id":"blk-51649","items":[{"blocks":[{"id":"blk-51651","kind":"paragraph","spans":[{"id":"spn-80145","marks":["bold"],"text":"Status:"},{"id":"spn-80146","text":" Accepted"}]}],"id":"blk-51650","kind":"list-item"},{"blocks":[{"id":"blk-51653","kind":"paragraph","spans":[{"id":"spn-80147","marks":["bold"],"text":"Date:"},{"id":"spn-80148","text":" 2026-01-21"}]}],"id":"blk-51652","kind":"list-item"},{"blocks":[{"id":"blk-51655","kind":"paragraph","spans":[{"id":"spn-80149","marks":["bold"],"text":"Owners:"},{"id":"spn-80150","text":" Engineering"}]}],"id":"blk-51654","kind":"list-item"},{"blocks":[{"id":"blk-51657","kind":"paragraph","spans":[{"id":"spn-80151","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-51656","kind":"list-item"},{"blocks":[{"id":"blk-51659","kind":"paragraph","spans":[{"id":"spn-80152","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-51658","kind":"list-item"},{"blocks":[{"id":"blk-51661","kind":"paragraph","spans":[{"id":"spn-80153","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-51660","kind":"list-item"},{"blocks":[{"id":"blk-51663","kind":"paragraph","spans":[{"id":"spn-80154","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-51662","kind":"list-item"},{"blocks":[{"id":"blk-51665","kind":"paragraph","spans":[{"id":"spn-80155","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-51664","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51666","kind":"heading","level":2,"spans":[{"id":"spn-80156","text":"Context"}]},{"id":"blk-51667","kind":"paragraph","spans":[{"id":"spn-80157","text":"webhost.systems is a multi-runtime AI agent deployment platform with:"}]},{"id":"blk-51668","items":[{"blocks":[{"id":"blk-51670","kind":"paragraph","spans":[{"id":"spn-80158","marks":["bold"],"text":"Control plane:"},{"id":"spn-80159","text":" Auth, dashboard, agent/deployment metadata, billing, limits, metrics aggregation."}]}],"id":"blk-51669","kind":"list-item"},{"blocks":[{"id":"blk-51672","kind":"paragraph","spans":[{"id":"spn-80160","marks":["bold"],"text":"Data plane:"},{"id":"spn-80161","text":" Executes customer agent code on runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore)."}]}],"id":"blk-51671","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51673","kind":"paragraph","spans":[{"id":"spn-80162","text":"The platform must handle several categories of secrets:"}]},{"id":"blk-51674","items":[{"blocks":[{"id":"blk-51676","kind":"paragraph","spans":[{"id":"spn-80163","marks":["bold"],"text":"Customer secrets:"},{"id":"spn-80164","text":" model keys (e.g., "},{"id":"spn-80165","marks":["code"],"text":"OPENAI_API_KEY"},{"id":"spn-80166","text":"), third-party API keys used by agent code."}]}],"id":"blk-51675","kind":"list-item"},{"blocks":[{"id":"blk-51678","kind":"paragraph","spans":[{"id":"spn-80167","marks":["bold"],"text":"Platform secrets:"},{"id":"spn-80168","text":" Cloudflare API tokens, AWS credentials/roles, billing webhook secret, internal signing keys."}]}],"id":"blk-51677","kind":"list-item"},{"blocks":[{"id":"blk-51680","kind":"paragraph","spans":[{"id":"spn-80169","marks":["bold"],"text":"Integrity secrets:"},{"id":"spn-80170","text":" telemetry signing keys (deployment-scoped)."}]}],"id":"blk-51679","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51681","kind":"paragraph","spans":[{"id":"spn-80171","text":"Constraints:"}]},{"id":"blk-51682","items":[{"blocks":[{"id":"blk-51684","kind":"paragraph","spans":[{"id":"spn-80172","text":"Customer agent code is "},{"id":"spn-80173","marks":["bold"],"text":"untrusted"},{"id":"spn-80174","text":" and may exfiltrate secrets it is given; therefore secrets must be scoped and minimized."}]}],"id":"blk-51683","kind":"list-item"},{"blocks":[{"id":"blk-51686","kind":"paragraph","spans":[{"id":"spn-80175","text":"The platform must support "},{"id":"spn-80176","marks":["bold"],"text":"multiple runtimes"},{"id":"spn-80177","text":", each with different secret injection mechanisms."}]}],"id":"blk-51685","kind":"list-item"},{"blocks":[{"id":"blk-51688","kind":"paragraph","spans":[{"id":"spn-80178","text":"The platform must enable "},{"id":"spn-80179","marks":["bold"],"text":"telemetry integrity"},{"id":"spn-80180","text":": data plane must report usage to control plane without allowing spoofing."}]}],"id":"blk-51687","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51689","kind":"paragraph","spans":[{"id":"spn-80181","text":"Security and operational requirements:"}]},{"id":"blk-51690","items":[{"blocks":[{"id":"blk-51692","kind":"paragraph","spans":[{"id":"spn-80182","text":"Minimize blast radius of a control-plane DB read breach."}]}],"id":"blk-51691","kind":"list-item"},{"blocks":[{"id":"blk-51694","kind":"paragraph","spans":[{"id":"spn-80183","text":"Prevent secret leakage via logs, errors, metrics, or UI."}]}],"id":"blk-51693","kind":"list-item"},{"blocks":[{"id":"blk-51696","kind":"paragraph","spans":[{"id":"spn-80184","text":"Support secret rotation with minimal operational burden."}]}],"id":"blk-51695","kind":"list-item"},{"blocks":[{"id":"blk-51698","kind":"paragraph","spans":[{"id":"spn-80185","text":"Keep implementation feasible for MVP while providing a clear path to stronger controls."}]}],"id":"blk-51697","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51699","kind":"heading","level":2,"spans":[{"id":"spn-80186","text":"Decision"}]},{"id":"blk-51700","items":[{"blocks":[{"id":"blk-51702","kind":"paragraph","spans":[{"id":"spn-80187","marks":["bold"],"text":"No plaintext secrets are stored in the primary application database"},{"id":"spn-80188","text":" (Supabase)."}]}],"id":"blk-51701","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51703","items":[{"blocks":[{"id":"blk-51705","kind":"paragraph","spans":[{"id":"spn-80189","text":"The DB stores only:"}]}],"id":"blk-51704","kind":"list-item"},{"blocks":[{"id":"blk-51707","kind":"paragraph","spans":[{"id":"spn-80190","text":"secret key names (e.g., "},{"id":"spn-80191","marks":["code"],"text":"envVarKeys"},{"id":"spn-80192","text":"),"}]}],"id":"blk-51706","kind":"list-item"},{"blocks":[{"id":"blk-51709","kind":"paragraph","spans":[{"id":"spn-80193","text":"provider secret references (names/ids),"}]}],"id":"blk-51708","kind":"list-item"},{"blocks":[{"id":"blk-51711","kind":"paragraph","spans":[{"id":"spn-80194","text":"rotation metadata (timestamps, versions),"}]}],"id":"blk-51710","kind":"list-item"},{"blocks":[{"id":"blk-51713","kind":"paragraph","spans":[{"id":"spn-80195","text":"booleans like “is configured”."}]}],"id":"blk-51712","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51714","items":[{"blocks":[{"id":"blk-51716","kind":"paragraph","spans":[{"id":"spn-80196","marks":["bold"],"text":"Secrets are injected into runtime providers using provider-native secret mechanisms"},{"id":"spn-80197","text":" (where possible)."}]}],"id":"blk-51715","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-51717","items":[{"blocks":[{"id":"blk-51719","kind":"paragraph","spans":[{"id":"spn-80198","marks":["bold"],"text":"Cloudflare:"},{"id":"spn-80199","text":" Worker secret bindings (set via Cloudflare API)."}]}],"id":"blk-51718","kind":"list-item"},{"blocks":[{"id":"blk-51721","kind":"paragraph","spans":[{"id":"spn-80200","marks":["bold"],"text":"AWS / AgentCore:"},{"id":"spn-80201","text":" "},{"id":"spn-80202","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-80203","text":" via the AgentCore Runtime API (recommended default for v1), with "},{"id":"spn-80204","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-80205","text":" as an optional enhancement for advanced rotation and centralized secret management."}]}],"id":"blk-51720","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51722","items":[{"blocks":[{"id":"blk-51724","kind":"paragraph","spans":[{"id":"spn-80206","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped signing keys"},{"id":"spn-80207","text":" injected into the runtime as secrets."}]}],"id":"blk-51723","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-51725","items":[{"blocks":[{"id":"blk-51727","kind":"paragraph","spans":[{"id":"spn-80208","text":"Each deployment gets a unique "},{"id":"spn-80209","marks":["code"],"text":"telemetrySecret"},{"id":"spn-80210","text":" (HMAC key)."}]}],"id":"blk-51726","kind":"list-item"},{"blocks":[{"id":"blk-51729","kind":"paragraph","spans":[{"id":"spn-80211","text":"Data plane signs telemetry payloads with HMAC-SHA256 over raw request bytes."}]}],"id":"blk-51728","kind":"list-item"},{"blocks":[{"id":"blk-51731","kind":"paragraph","spans":[{"id":"spn-80212","text":"Control plane verifies signature using the secret reference associated with the deployment."}]}],"id":"blk-51730","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51732","items":[{"blocks":[{"id":"blk-51734","kind":"paragraph","spans":[{"id":"spn-80213","marks":["bold"],"text":"Control plane never exposes secret values back to clients."}]}],"id":"blk-51733","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-51735","items":[{"blocks":[{"id":"blk-51737","kind":"paragraph","spans":[{"id":"spn-80214","text":"A “set secrets” endpoint may exist and is write-only."}]}],"id":"blk-51736","kind":"list-item"},{"blocks":[{"id":"blk-51739","kind":"paragraph","spans":[{"id":"spn-80215","text":"A “get secrets” endpoint for plaintext MUST NOT exist."}]}],"id":"blk-51738","kind":"list-item"},{"blocks":[{"id":"blk-51741","kind":"paragraph","spans":[{"id":"spn-80216","text":"The UI can show only:"}]}],"id":"blk-51740","kind":"list-item"},{"blocks":[{"id":"blk-51743","kind":"paragraph","spans":[{"id":"spn-80217","text":"configured keys list,"}]}],"id":"blk-51742","kind":"list-item"},{"blocks":[{"id":"blk-51745","kind":"paragraph","spans":[{"id":"spn-80218","text":"status per key (set/not set),"}]}],"id":"blk-51744","kind":"list-item"},{"blocks":[{"id":"blk-51747","kind":"paragraph","spans":[{"id":"spn-80219","text":"last rotated timestamp (optional)."}]}],"id":"blk-51746","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51748","kind":"heading","level":2,"spans":[{"id":"spn-80220","text":"Rationale"}]},{"id":"blk-51749","items":[{"blocks":[{"id":"blk-51751","kind":"paragraph","spans":[{"id":"spn-80221","marks":["bold"],"text":"Reduces breach impact:"},{"id":"spn-80222","text":" If the primary DB is compromised, attackers do not automatically obtain usable API keys."}]}],"id":"blk-51750","kind":"list-item"},{"blocks":[{"id":"blk-51753","kind":"paragraph","spans":[{"id":"spn-80223","marks":["bold"],"text":"Aligns with best practices:"},{"id":"spn-80224","text":" Provider secret stores are purpose-built for secret storage and rotation."}]}],"id":"blk-51752","kind":"list-item"},{"blocks":[{"id":"blk-51755","kind":"paragraph","spans":[{"id":"spn-80225","marks":["bold"],"text":"Enables multi-runtime:"},{"id":"spn-80226","text":" Provider injection allows per-runtime deployment without inventing a bespoke secret distribution system."}]}],"id":"blk-51754","kind":"list-item"},{"blocks":[{"id":"blk-51757","kind":"paragraph","spans":[{"id":"spn-80227","marks":["bold"],"text":"Supports telemetry integrity:"},{"id":"spn-80228","text":" Deployment-scoped secrets and HMAC signatures prevent spoofing of usage events, which protects billing and limit enforcement."}]}],"id":"blk-51756","kind":"list-item"},{"blocks":[{"id":"blk-51759","kind":"paragraph","spans":[{"id":"spn-80229","marks":["bold"],"text":"Keeps MVP achievable:"},{"id":"spn-80230","text":" Write-only secrets entry + provider injection is implementable without building a full secrets vault and policy engine."}]}],"id":"blk-51758","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51760","kind":"heading","level":2,"spans":[{"id":"spn-80231","text":"Alternatives considered"}]},{"id":"blk-51761","kind":"heading","level":3,"spans":[{"id":"spn-80232","text":"A) Store encrypted secrets in the primary DB (application-managed encryption)"}]},{"id":"blk-51762","kind":"paragraph","spans":[{"id":"spn-80233","marks":["bold"],"text":"Pros"}]},{"id":"blk-51763","items":[{"blocks":[{"id":"blk-51765","kind":"paragraph","spans":[{"id":"spn-80234","text":"Simple read/write path."}]}],"id":"blk-51764","kind":"list-item"},{"blocks":[{"id":"blk-51767","kind":"paragraph","spans":[{"id":"spn-80235","text":"Centralized regardless of runtime provider."}]}],"id":"blk-51766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51768","kind":"paragraph","spans":[{"id":"spn-80236","marks":["bold"],"text":"Cons"}]},{"id":"blk-51769","items":[{"blocks":[{"id":"blk-51771","kind":"paragraph","spans":[{"id":"spn-80237","text":"Key management becomes a major responsibility (KMS integration, rotation, access controls)."}]}],"id":"blk-51770","kind":"list-item"},{"blocks":[{"id":"blk-51773","kind":"paragraph","spans":[{"id":"spn-80238","text":"If application and DB are compromised, secrets may still be exposed via runtime memory or logs."}]}],"id":"blk-51772","kind":"list-item"},{"blocks":[{"id":"blk-51775","kind":"paragraph","spans":[{"id":"spn-80239","text":"More complex than necessary for MVP given provider secret facilities."}]}],"id":"blk-51774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51776","kind":"paragraph","spans":[{"id":"spn-80240","marks":["bold"],"text":"Decision:"},{"id":"spn-80241","text":" Rejected for v1 (may revisit if a centralized secrets vault is required)."}]},{"id":"blk-51777","kind":"heading","level":3,"spans":[{"id":"spn-80242","text":"B) Centralized secret store for all secrets (e.g., dedicated vault) + runtime fetch at execution time"}]},{"id":"blk-51778","kind":"paragraph","spans":[{"id":"spn-80243","marks":["bold"],"text":"Pros"}]},{"id":"blk-51779","items":[{"blocks":[{"id":"blk-51781","kind":"paragraph","spans":[{"id":"spn-80244","text":"Single system of record, policy controls, potential audit/compliance benefits."}]}],"id":"blk-51780","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51782","kind":"paragraph","spans":[{"id":"spn-80245","marks":["bold"],"text":"Cons"}]},{"id":"blk-51783","items":[{"blocks":[{"id":"blk-51785","kind":"paragraph","spans":[{"id":"spn-80246","text":"Adds significant infrastructure and operational complexity."}]}],"id":"blk-51784","kind":"list-item"},{"blocks":[{"id":"blk-51787","kind":"paragraph","spans":[{"id":"spn-80247","text":"Requires secure runtime access and network paths from every provider."}]}],"id":"blk-51786","kind":"list-item"},{"blocks":[{"id":"blk-51789","kind":"paragraph","spans":[{"id":"spn-80248","text":"Introduces availability coupling: vault outage can break invocations."}]}],"id":"blk-51788","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51790","kind":"paragraph","spans":[{"id":"spn-80249","marks":["bold"],"text":"Decision:"},{"id":"spn-80250","text":" Rejected for v1; consider for enterprise roadmap if needed."}]},{"id":"blk-51791","kind":"heading","level":3,"spans":[{"id":"spn-80251","text":"C) Embed secrets in deployment artifacts or config files"}]},{"id":"blk-51792","kind":"paragraph","spans":[{"id":"spn-80252","marks":["bold"],"text":"Pros"}]},{"id":"blk-51793","items":[{"blocks":[{"id":"blk-51795","kind":"paragraph","spans":[{"id":"spn-80253","text":"Easiest to implement."}]}],"id":"blk-51794","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51796","kind":"paragraph","spans":[{"id":"spn-80254","marks":["bold"],"text":"Cons"}]},{"id":"blk-51797","items":[{"blocks":[{"id":"blk-51799","kind":"paragraph","spans":[{"id":"spn-80255","text":"Catastrophic: secrets leak via artifacts, logs, and provider introspection."}]}],"id":"blk-51798","kind":"list-item"},{"blocks":[{"id":"blk-51801","kind":"paragraph","spans":[{"id":"spn-80256","text":"Violates core security requirement."}]}],"id":"blk-51800","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51802","kind":"paragraph","spans":[{"id":"spn-80257","marks":["bold"],"text":"Decision:"},{"id":"spn-80258","text":" Rejected."}]},{"id":"blk-51803","kind":"heading","level":3,"spans":[{"id":"spn-80259","text":"D) Adapter-side telemetry only (no runtime telemetry secret)"}]},{"id":"blk-51804","kind":"paragraph","spans":[{"id":"spn-80260","marks":["bold"],"text":"Pros"}]},{"id":"blk-51805","items":[{"blocks":[{"id":"blk-51807","kind":"paragraph","spans":[{"id":"spn-80261","text":"Avoids injecting telemetry secret into runtime."}]}],"id":"blk-51806","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51808","kind":"paragraph","spans":[{"id":"spn-80262","marks":["bold"],"text":"Cons"}]},{"id":"blk-51809","items":[{"blocks":[{"id":"blk-51811","kind":"paragraph","spans":[{"id":"spn-80263","text":"Often cannot capture accurate compute/tool usage."}]}],"id":"blk-51810","kind":"list-item"},{"blocks":[{"id":"blk-51813","kind":"paragraph","spans":[{"id":"spn-80264","text":"Harder to attribute reliably at high concurrency; may undercount or miscount."}]}],"id":"blk-51812","kind":"list-item"},{"blocks":[{"id":"blk-51815","kind":"paragraph","spans":[{"id":"spn-80265","text":"Still requires strong integrity controls in adapter pathway."}]}],"id":"blk-51814","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51816","kind":"paragraph","spans":[{"id":"spn-80266","marks":["bold"],"text":"Decision:"},{"id":"spn-80267","text":" Not the primary strategy. Allowed only as a constrained fallback if provider limitations require it, but must preserve attribution integrity."}]},{"id":"blk-51817","kind":"heading","level":2,"spans":[{"id":"spn-80268","text":"Consequences"}]},{"id":"blk-51818","kind":"heading","level":3,"spans":[{"id":"spn-80269","text":"Positive"}]},{"id":"blk-51819","items":[{"blocks":[{"id":"blk-51821","kind":"paragraph","spans":[{"id":"spn-80270","text":"Stronger baseline security posture without heavy infrastructure."}]}],"id":"blk-51820","kind":"list-item"},{"blocks":[{"id":"blk-51823","kind":"paragraph","spans":[{"id":"spn-80271","text":"Clear separation of responsibilities:"}]}],"id":"blk-51822","kind":"list-item"},{"blocks":[{"id":"blk-51825","kind":"paragraph","spans":[{"id":"spn-80272","text":"DB stores metadata and references,"}]}],"id":"blk-51824","kind":"list-item"},{"blocks":[{"id":"blk-51827","kind":"paragraph","spans":[{"id":"spn-80273","text":"providers store values."}]}],"id":"blk-51826","kind":"list-item"},{"blocks":[{"id":"blk-51829","kind":"paragraph","spans":[{"id":"spn-80274","text":"Enables per-deployment telemetry signing and robust anti-spoofing."}]}],"id":"blk-51828","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51830","kind":"heading","level":3,"spans":[{"id":"spn-80275","text":"Negative / tradeoffs"}]},{"id":"blk-51831","items":[{"blocks":[{"id":"blk-51833","kind":"paragraph","spans":[{"id":"spn-80276","text":"Secret management becomes provider-dependent; implementation must support multiple injection mechanisms."}]}],"id":"blk-51832","kind":"list-item"},{"blocks":[{"id":"blk-51835","kind":"paragraph","spans":[{"id":"spn-80277","text":"Secret rotation may require redeploy on some providers."}]}],"id":"blk-51834","kind":"list-item"},{"blocks":[{"id":"blk-51837","kind":"paragraph","spans":[{"id":"spn-80278","text":"Debugging becomes harder because plaintext is not retrievable; must rely on “configured/not configured” and test invocations."}]}],"id":"blk-51836","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51838","kind":"heading","level":2,"spans":[{"id":"spn-80279","text":"Implementation details (normative)"}]},{"id":"blk-51839","kind":"heading","level":3,"spans":[{"id":"spn-80280","text":"1) Data model requirements"}]},{"id":"blk-51840","items":[{"blocks":[{"id":"blk-51842","kind":"paragraph","spans":[{"id":"spn-80281","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-80282","text":": list of secret key names (never values)."}]}],"id":"blk-51841","kind":"list-item"},{"blocks":[{"id":"blk-51844","kind":"paragraph","spans":[{"id":"spn-80283","marks":["code"],"text":"deployments.telemetryAuthRef"},{"id":"spn-80284","text":": provider reference to telemetry signing secret (never plaintext)."}]}],"id":"blk-51843","kind":"list-item"},{"blocks":[{"id":"blk-51846","kind":"paragraph","spans":[{"id":"spn-80285","text":"Optional "},{"id":"spn-80286","marks":["code"],"text":"secrets"},{"id":"spn-80287","text":" metadata table (if implemented) stores only:"}]}],"id":"blk-51845","kind":"list-item"},{"blocks":[{"id":"blk-51848","kind":"paragraph","spans":[{"id":"spn-80288","marks":["code"],"text":"userId"},{"id":"spn-80289","text":", "},{"id":"spn-80290","marks":["code"],"text":"agentId"},{"id":"spn-80291","text":", "},{"id":"spn-80292","marks":["code"],"text":"key"},{"id":"spn-80293","text":", "},{"id":"spn-80294","marks":["code"],"text":"provider"},{"id":"spn-80295","text":", "},{"id":"spn-80296","marks":["code"],"text":"secretRef"},{"id":"spn-80297","text":", "},{"id":"spn-80298","marks":["code"],"text":"createdAtMs"},{"id":"spn-80299","text":", "},{"id":"spn-80300","marks":["code"],"text":"rotatedAtMs"},{"id":"spn-80301","text":"."}]}],"id":"blk-51847","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51849","kind":"heading","level":3,"spans":[{"id":"spn-80302","text":"2) Secrets write endpoint"}]},{"id":"blk-51850","kind":"paragraph","spans":[{"id":"spn-80303","text":"If implementing "},{"id":"spn-80304","marks":["code"],"text":"POST /v1/agents/{agentId}/secrets"},{"id":"spn-80305","text":" (write-only):"}]},{"id":"blk-51851","items":[{"blocks":[{"id":"blk-51853","kind":"paragraph","spans":[{"id":"spn-80306","text":"MUST authenticate and enforce tenant ownership."}]}],"id":"blk-51852","kind":"list-item"},{"blocks":[{"id":"blk-51855","kind":"paragraph","spans":[{"id":"spn-80307","text":"MUST validate keys against "},{"id":"spn-80308","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-80309","text":" (or allow adding new keys via "},{"id":"spn-80310","marks":["code"],"text":"agents.update"},{"id":"spn-80311","text":" first)."}]}],"id":"blk-51854","kind":"list-item"},{"blocks":[{"id":"blk-51857","kind":"paragraph","spans":[{"id":"spn-80312","text":"MUST store values only in provider secret store(s) and discard plaintext immediately after injection."}]}],"id":"blk-51856","kind":"list-item"},{"blocks":[{"id":"blk-51859","kind":"paragraph","spans":[{"id":"spn-80313","text":"MUST NOT return secret values."}]}],"id":"blk-51858","kind":"list-item"},{"blocks":[{"id":"blk-51861","kind":"paragraph","spans":[{"id":"spn-80314","text":"MUST redact secret values in logs and error messages."}]}],"id":"blk-51860","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51862","kind":"heading","level":3,"spans":[{"id":"spn-80315","text":"3) Provider injection requirements"}]},{"id":"blk-51863","items":[{"blocks":[{"id":"blk-51865","kind":"paragraph","spans":[{"id":"spn-80316","text":"Cloudflare adapter:"}]}],"id":"blk-51864","kind":"list-item"},{"blocks":[{"id":"blk-51867","kind":"paragraph","spans":[{"id":"spn-80317","text":"Use provider API to set Worker secrets per deployment or per agent, and ensure the active Worker uses the correct secrets."}]}],"id":"blk-51866","kind":"list-item"},{"blocks":[{"id":"blk-51869","kind":"paragraph","spans":[{"id":"spn-80318","text":"AgentCore adapter:"}]}],"id":"blk-51868","kind":"list-item"},{"blocks":[{"id":"blk-51871","kind":"paragraph","spans":[{"id":"spn-80319","text":"Use "},{"id":"spn-80320","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-80321","text":" (v1 default) to set deployment-scoped secrets (telemetry signing key, user-provided API keys) as runtime environment variables."}]}],"id":"blk-51870","kind":"list-item"},{"blocks":[{"id":"blk-51873","kind":"paragraph","spans":[{"id":"spn-80322","text":"Use "},{"id":"spn-80323","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-80324","text":" as an optional enhancement (post-v1 or enterprise hardening) to support rotation without redeploy and centralized secret governance."}]}],"id":"blk-51872","kind":"list-item"},{"blocks":[{"id":"blk-51875","kind":"paragraph","spans":[{"id":"spn-80325","text":"Store only "},{"id":"spn-80326","marks":["bold"],"text":"references/metadata"},{"id":"spn-80327","text":" in the control plane DB (e.g., runtime env var key names and/or Secrets Manager ARNs). Never store plaintext values."}]}],"id":"blk-51874","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51876","kind":"heading","level":4,"spans":[{"id":"spn-80328","text":"AgentCore secret injection (implementation note)"}]},{"id":"blk-51877","kind":"paragraph","spans":[{"id":"spn-80329","text":"AgentCore supports multiple secret injection patterns. For v1, prefer environment variables because it minimizes moving parts and matches the Cloudflare deployment model (provider-managed secret injection at deploy time)."}]},{"id":"blk-51878","items":[{"blocks":[{"id":"blk-51880","kind":"paragraph","spans":[{"id":"spn-80330","marks":["bold"],"text":"Option 1 (v1 default): Environment variables"}]}],"id":"blk-51879","kind":"list-item"},{"blocks":[{"id":"blk-51882","kind":"paragraph","spans":[{"id":"spn-80331","text":"Control plane sets runtime environment variables as part of the deploy/create/update runtime call."}]}],"id":"blk-51881","kind":"list-item"},{"blocks":[{"id":"blk-51884","kind":"paragraph","spans":[{"id":"spn-80332","text":"Example variables:"}]}],"id":"blk-51883","kind":"list-item"},{"blocks":[{"id":"blk-51886","kind":"paragraph","spans":[{"id":"spn-80333","marks":["code"],"text":"TELEMETRY_SECRET"},{"id":"spn-80334","text":" (deployment-scoped HMAC key)"}]}],"id":"blk-51885","kind":"list-item"},{"blocks":[{"id":"blk-51888","kind":"paragraph","spans":[{"id":"spn-80335","text":"user-provided keys like "},{"id":"spn-80336","marks":["code"],"text":"OPENAI_API_KEY"}]}],"id":"blk-51887","kind":"list-item"},{"blocks":[{"id":"blk-51890","kind":"paragraph","spans":[{"id":"spn-80337","text":"Operational note: rotation may require redeploy depending on provider behavior; document in UI."}]}],"id":"blk-51889","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51891","items":[{"blocks":[{"id":"blk-51893","kind":"paragraph","spans":[{"id":"spn-80338","marks":["bold"],"text":"Option 2 (optional): AWS Secrets Manager references"}]}],"id":"blk-51892","kind":"list-item"},{"blocks":[{"id":"blk-51895","kind":"paragraph","spans":[{"id":"spn-80339","text":"Store secret values in Secrets Manager."}]}],"id":"blk-51894","kind":"list-item"},{"blocks":[{"id":"blk-51897","kind":"paragraph","spans":[{"id":"spn-80340","text":"Provide the runtime with references (ARNs) and an IAM role that permits retrieval."}]}],"id":"blk-51896","kind":"list-item"},{"blocks":[{"id":"blk-51899","kind":"paragraph","spans":[{"id":"spn-80341","text":"Operational note: enables rotation without redeploy, but increases IAM + operational complexity."}]}],"id":"blk-51898","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51900","kind":"heading","level":3,"spans":[{"id":"spn-80342","text":"4) Telemetry signing requirements"}]},{"id":"blk-51901","items":[{"blocks":[{"id":"blk-51903","kind":"paragraph","spans":[{"id":"spn-80343","text":"Each deployment MUST have a unique telemetry signing secret."}]}],"id":"blk-51902","kind":"list-item"},{"blocks":[{"id":"blk-51905","kind":"paragraph","spans":[{"id":"spn-80344","text":"Runtime sends telemetry with:"}]}],"id":"blk-51904","kind":"list-item"},{"blocks":[{"id":"blk-51907","kind":"paragraph","spans":[{"id":"spn-80345","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-51906","kind":"list-item"},{"blocks":[{"id":"blk-51909","kind":"paragraph","spans":[{"id":"spn-80346","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex-hmac-sha256(body)>"}]}],"id":"blk-51908","kind":"list-item"},{"blocks":[{"id":"blk-51911","kind":"paragraph","spans":[{"id":"spn-80347","text":"Control plane MUST verify:"}]}],"id":"blk-51910","kind":"list-item"},{"blocks":[{"id":"blk-51913","kind":"paragraph","spans":[{"id":"spn-80348","text":"signature validity,"}]}],"id":"blk-51912","kind":"list-item"},{"blocks":[{"id":"blk-51915","kind":"paragraph","spans":[{"id":"spn-80349","text":"deployment ownership mapping to "},{"id":"spn-80350","marks":["code"],"text":"{userId, agentId}"},{"id":"spn-80351","text":","}]}],"id":"blk-51914","kind":"list-item"},{"blocks":[{"id":"blk-51917","kind":"paragraph","spans":[{"id":"spn-80352","text":"required attribution fields."}]}],"id":"blk-51916","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51918","kind":"heading","level":3,"spans":[{"id":"spn-80353","text":"5) Rotation policy"}]},{"id":"blk-51919","items":[{"blocks":[{"id":"blk-51921","kind":"paragraph","spans":[{"id":"spn-80354","text":"Telemetry secrets:"}]}],"id":"blk-51920","kind":"list-item"},{"blocks":[{"id":"blk-51923","kind":"paragraph","spans":[{"id":"spn-80355","text":"MUST rotate on every new deployment by default."}]}],"id":"blk-51922","kind":"list-item"},{"blocks":[{"id":"blk-51925","kind":"paragraph","spans":[{"id":"spn-80356","text":"Customer secrets:"}]}],"id":"blk-51924","kind":"list-item"},{"blocks":[{"id":"blk-51927","kind":"paragraph","spans":[{"id":"spn-80357","text":"MAY be rotated by user action; system SHOULD record rotation timestamp."}]}],"id":"blk-51926","kind":"list-item"},{"blocks":[{"id":"blk-51929","kind":"paragraph","spans":[{"id":"spn-80358","text":"If provider requires redeploy for new secret values to take effect, UI MUST make this explicit."}]}],"id":"blk-51928","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51930","kind":"heading","level":2,"spans":[{"id":"spn-80359","text":"Security & compliance notes"}]},{"id":"blk-51931","items":[{"blocks":[{"id":"blk-51933","kind":"paragraph","spans":[{"id":"spn-80360","text":"This ADR supports a SOC2-aligned posture by:"}]}],"id":"blk-51932","kind":"list-item"},{"blocks":[{"id":"blk-51935","kind":"paragraph","spans":[{"id":"spn-80361","text":"minimizing sensitive data stored in primary DB,"}]}],"id":"blk-51934","kind":"list-item"},{"blocks":[{"id":"blk-51937","kind":"paragraph","spans":[{"id":"spn-80362","text":"ensuring integrity of billing-relevant telemetry,"}]}],"id":"blk-51936","kind":"list-item"},{"blocks":[{"id":"blk-51939","kind":"paragraph","spans":[{"id":"spn-80363","text":"enabling auditability (via audit logs for secrets set and telemetry rejections)."}]}],"id":"blk-51938","kind":"list-item"},{"blocks":[{"id":"blk-51941","kind":"paragraph","spans":[{"id":"spn-80364","text":"This ADR does not eliminate the inherent risk that untrusted customer agent code can exfiltrate secrets it is given; the platform mitigates by scoping secrets per agent and avoiding cross-tenant exposure."}]}],"id":"blk-51940","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51942","kind":"heading","level":2,"spans":[{"id":"spn-80365","text":"Acceptance criteria"}]},{"id":"blk-51943","kind":"paragraph","spans":[{"id":"spn-80366","text":"This ADR is correctly implemented when:"}]},{"id":"blk-51944","items":[{"blocks":[{"id":"blk-51946","kind":"paragraph","spans":[{"id":"spn-80367","text":"No plaintext secret values exist in the primary DB (verified via code review and automated checks)."}]}],"id":"blk-51945","kind":"list-item"},{"blocks":[{"id":"blk-51948","kind":"paragraph","spans":[{"id":"spn-80368","text":"Secrets set via API are write-only; plaintext secrets are never returned."}]}],"id":"blk-51947","kind":"list-item"},{"blocks":[{"id":"blk-51950","kind":"paragraph","spans":[{"id":"spn-80369","text":"Provider secrets are injected and required for runtime invocation (e.g., model keys, telemetry signing secret)."}]}],"id":"blk-51949","kind":"list-item"},{"blocks":[{"id":"blk-51952","kind":"paragraph","spans":[{"id":"spn-80370","text":"Telemetry ingestion rejects invalid signatures and mismatched ownership."}]}],"id":"blk-51951","kind":"list-item"},{"blocks":[{"id":"blk-51954","kind":"paragraph","spans":[{"id":"spn-80371","text":"Logs and error messages are sanitized and do not contain secret values."}]}],"id":"blk-51953","kind":"list-item"},{"blocks":[{"id":"blk-51956","kind":"paragraph","spans":[{"id":"spn-80372","text":"Secret rotation is supported at least via “set new value” flow and telemetry secrets rotate per deployment."}]}],"id":"blk-51955","kind":"list-item"}],"kind":"list","ordered":true}],"edges":[],"id":"bagaaieraj22vv2wcnjaxbuuqmiiuogde662re6iwzfui4cb2w6ltmzwunb7q","vocabulary":"ampersand.docs.fs.v1"}