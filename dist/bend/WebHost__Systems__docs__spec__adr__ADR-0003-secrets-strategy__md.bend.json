{"bendscript":"0.1","blocks":[{"id":"blk-50932","kind":"heading","level":1,"spans":[{"id":"spn-77754","text":"ADR-0003: Secrets Handling & Provider Injection Strategy"}]},{"id":"blk-50933","items":[{"blocks":[{"id":"blk-50935","kind":"paragraph","spans":[{"id":"spn-77755","marks":["bold"],"text":"Status:"},{"id":"spn-77756","text":" Accepted"}]}],"id":"blk-50934","kind":"list-item"},{"blocks":[{"id":"blk-50937","kind":"paragraph","spans":[{"id":"spn-77757","marks":["bold"],"text":"Date:"},{"id":"spn-77758","text":" 2026-01-21"}]}],"id":"blk-50936","kind":"list-item"},{"blocks":[{"id":"blk-50939","kind":"paragraph","spans":[{"id":"spn-77759","marks":["bold"],"text":"Owners:"},{"id":"spn-77760","text":" Engineering"}]}],"id":"blk-50938","kind":"list-item"},{"blocks":[{"id":"blk-50941","kind":"paragraph","spans":[{"id":"spn-77761","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-50940","kind":"list-item"},{"blocks":[{"id":"blk-50943","kind":"paragraph","spans":[{"id":"spn-77762","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-50942","kind":"list-item"},{"blocks":[{"id":"blk-50945","kind":"paragraph","spans":[{"id":"spn-77763","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-50944","kind":"list-item"},{"blocks":[{"id":"blk-50947","kind":"paragraph","spans":[{"id":"spn-77764","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-50946","kind":"list-item"},{"blocks":[{"id":"blk-50949","kind":"paragraph","spans":[{"id":"spn-77765","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-50948","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50950","kind":"heading","level":2,"spans":[{"id":"spn-77766","text":"Context"}]},{"id":"blk-50951","kind":"paragraph","spans":[{"id":"spn-77767","text":"webhost.systems is a multi-runtime AI agent deployment platform with:"}]},{"id":"blk-50952","items":[{"blocks":[{"id":"blk-50954","kind":"paragraph","spans":[{"id":"spn-77768","marks":["bold"],"text":"Control plane:"},{"id":"spn-77769","text":" Auth, dashboard, agent/deployment metadata, billing, limits, metrics aggregation."}]}],"id":"blk-50953","kind":"list-item"},{"blocks":[{"id":"blk-50956","kind":"paragraph","spans":[{"id":"spn-77770","marks":["bold"],"text":"Data plane:"},{"id":"spn-77771","text":" Executes customer agent code on runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore)."}]}],"id":"blk-50955","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50957","kind":"paragraph","spans":[{"id":"spn-77772","text":"The platform must handle several categories of secrets:"}]},{"id":"blk-50958","items":[{"blocks":[{"id":"blk-50960","kind":"paragraph","spans":[{"id":"spn-77773","marks":["bold"],"text":"Customer secrets:"},{"id":"spn-77774","text":" model keys (e.g., "},{"id":"spn-77775","marks":["code"],"text":"OPENAI_API_KEY"},{"id":"spn-77776","text":"), third-party API keys used by agent code."}]}],"id":"blk-50959","kind":"list-item"},{"blocks":[{"id":"blk-50962","kind":"paragraph","spans":[{"id":"spn-77777","marks":["bold"],"text":"Platform secrets:"},{"id":"spn-77778","text":" Cloudflare API tokens, AWS credentials/roles, billing webhook secret, internal signing keys."}]}],"id":"blk-50961","kind":"list-item"},{"blocks":[{"id":"blk-50964","kind":"paragraph","spans":[{"id":"spn-77779","marks":["bold"],"text":"Integrity secrets:"},{"id":"spn-77780","text":" telemetry signing keys (deployment-scoped)."}]}],"id":"blk-50963","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50965","kind":"paragraph","spans":[{"id":"spn-77781","text":"Constraints:"}]},{"id":"blk-50966","items":[{"blocks":[{"id":"blk-50968","kind":"paragraph","spans":[{"id":"spn-77782","text":"Customer agent code is "},{"id":"spn-77783","marks":["bold"],"text":"untrusted"},{"id":"spn-77784","text":" and may exfiltrate secrets it is given; therefore secrets must be scoped and minimized."}]}],"id":"blk-50967","kind":"list-item"},{"blocks":[{"id":"blk-50970","kind":"paragraph","spans":[{"id":"spn-77785","text":"The platform must support "},{"id":"spn-77786","marks":["bold"],"text":"multiple runtimes"},{"id":"spn-77787","text":", each with different secret injection mechanisms."}]}],"id":"blk-50969","kind":"list-item"},{"blocks":[{"id":"blk-50972","kind":"paragraph","spans":[{"id":"spn-77788","text":"The platform must enable "},{"id":"spn-77789","marks":["bold"],"text":"telemetry integrity"},{"id":"spn-77790","text":": data plane must report usage to control plane without allowing spoofing."}]}],"id":"blk-50971","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50973","kind":"paragraph","spans":[{"id":"spn-77791","text":"Security and operational requirements:"}]},{"id":"blk-50974","items":[{"blocks":[{"id":"blk-50976","kind":"paragraph","spans":[{"id":"spn-77792","text":"Minimize blast radius of a control-plane DB read breach."}]}],"id":"blk-50975","kind":"list-item"},{"blocks":[{"id":"blk-50978","kind":"paragraph","spans":[{"id":"spn-77793","text":"Prevent secret leakage via logs, errors, metrics, or UI."}]}],"id":"blk-50977","kind":"list-item"},{"blocks":[{"id":"blk-50980","kind":"paragraph","spans":[{"id":"spn-77794","text":"Support secret rotation with minimal operational burden."}]}],"id":"blk-50979","kind":"list-item"},{"blocks":[{"id":"blk-50982","kind":"paragraph","spans":[{"id":"spn-77795","text":"Keep implementation feasible for MVP while providing a clear path to stronger controls."}]}],"id":"blk-50981","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50983","kind":"heading","level":2,"spans":[{"id":"spn-77796","text":"Decision"}]},{"id":"blk-50984","items":[{"blocks":[{"id":"blk-50986","kind":"paragraph","spans":[{"id":"spn-77797","marks":["bold"],"text":"No plaintext secrets are stored in the primary application database"},{"id":"spn-77798","text":" (Supabase)."}]}],"id":"blk-50985","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-50987","items":[{"blocks":[{"id":"blk-50989","kind":"paragraph","spans":[{"id":"spn-77799","text":"The DB stores only:"}]}],"id":"blk-50988","kind":"list-item"},{"blocks":[{"id":"blk-50991","kind":"paragraph","spans":[{"id":"spn-77800","text":"secret key names (e.g., "},{"id":"spn-77801","marks":["code"],"text":"envVarKeys"},{"id":"spn-77802","text":"),"}]}],"id":"blk-50990","kind":"list-item"},{"blocks":[{"id":"blk-50993","kind":"paragraph","spans":[{"id":"spn-77803","text":"provider secret references (names/ids),"}]}],"id":"blk-50992","kind":"list-item"},{"blocks":[{"id":"blk-50995","kind":"paragraph","spans":[{"id":"spn-77804","text":"rotation metadata (timestamps, versions),"}]}],"id":"blk-50994","kind":"list-item"},{"blocks":[{"id":"blk-50997","kind":"paragraph","spans":[{"id":"spn-77805","text":"booleans like “is configured”."}]}],"id":"blk-50996","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50998","items":[{"blocks":[{"id":"blk-51000","kind":"paragraph","spans":[{"id":"spn-77806","marks":["bold"],"text":"Secrets are injected into runtime providers using provider-native secret mechanisms"},{"id":"spn-77807","text":" (where possible)."}]}],"id":"blk-50999","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-51001","items":[{"blocks":[{"id":"blk-51003","kind":"paragraph","spans":[{"id":"spn-77808","marks":["bold"],"text":"Cloudflare:"},{"id":"spn-77809","text":" Worker secret bindings (set via Cloudflare API)."}]}],"id":"blk-51002","kind":"list-item"},{"blocks":[{"id":"blk-51005","kind":"paragraph","spans":[{"id":"spn-77810","marks":["bold"],"text":"AWS / AgentCore:"},{"id":"spn-77811","text":" "},{"id":"spn-77812","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-77813","text":" via the AgentCore Runtime API (recommended default for v1), with "},{"id":"spn-77814","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-77815","text":" as an optional enhancement for advanced rotation and centralized secret management."}]}],"id":"blk-51004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51006","items":[{"blocks":[{"id":"blk-51008","kind":"paragraph","spans":[{"id":"spn-77816","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped signing keys"},{"id":"spn-77817","text":" injected into the runtime as secrets."}]}],"id":"blk-51007","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-51009","items":[{"blocks":[{"id":"blk-51011","kind":"paragraph","spans":[{"id":"spn-77818","text":"Each deployment gets a unique "},{"id":"spn-77819","marks":["code"],"text":"telemetrySecret"},{"id":"spn-77820","text":" (HMAC key)."}]}],"id":"blk-51010","kind":"list-item"},{"blocks":[{"id":"blk-51013","kind":"paragraph","spans":[{"id":"spn-77821","text":"Data plane signs telemetry payloads with HMAC-SHA256 over raw request bytes."}]}],"id":"blk-51012","kind":"list-item"},{"blocks":[{"id":"blk-51015","kind":"paragraph","spans":[{"id":"spn-77822","text":"Control plane verifies signature using the secret reference associated with the deployment."}]}],"id":"blk-51014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51016","items":[{"blocks":[{"id":"blk-51018","kind":"paragraph","spans":[{"id":"spn-77823","marks":["bold"],"text":"Control plane never exposes secret values back to clients."}]}],"id":"blk-51017","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-51019","items":[{"blocks":[{"id":"blk-51021","kind":"paragraph","spans":[{"id":"spn-77824","text":"A “set secrets” endpoint may exist and is write-only."}]}],"id":"blk-51020","kind":"list-item"},{"blocks":[{"id":"blk-51023","kind":"paragraph","spans":[{"id":"spn-77825","text":"A “get secrets” endpoint for plaintext MUST NOT exist."}]}],"id":"blk-51022","kind":"list-item"},{"blocks":[{"id":"blk-51025","kind":"paragraph","spans":[{"id":"spn-77826","text":"The UI can show only:"}]}],"id":"blk-51024","kind":"list-item"},{"blocks":[{"id":"blk-51027","kind":"paragraph","spans":[{"id":"spn-77827","text":"configured keys list,"}]}],"id":"blk-51026","kind":"list-item"},{"blocks":[{"id":"blk-51029","kind":"paragraph","spans":[{"id":"spn-77828","text":"status per key (set/not set),"}]}],"id":"blk-51028","kind":"list-item"},{"blocks":[{"id":"blk-51031","kind":"paragraph","spans":[{"id":"spn-77829","text":"last rotated timestamp (optional)."}]}],"id":"blk-51030","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51032","kind":"heading","level":2,"spans":[{"id":"spn-77830","text":"Rationale"}]},{"id":"blk-51033","items":[{"blocks":[{"id":"blk-51035","kind":"paragraph","spans":[{"id":"spn-77831","marks":["bold"],"text":"Reduces breach impact:"},{"id":"spn-77832","text":" If the primary DB is compromised, attackers do not automatically obtain usable API keys."}]}],"id":"blk-51034","kind":"list-item"},{"blocks":[{"id":"blk-51037","kind":"paragraph","spans":[{"id":"spn-77833","marks":["bold"],"text":"Aligns with best practices:"},{"id":"spn-77834","text":" Provider secret stores are purpose-built for secret storage and rotation."}]}],"id":"blk-51036","kind":"list-item"},{"blocks":[{"id":"blk-51039","kind":"paragraph","spans":[{"id":"spn-77835","marks":["bold"],"text":"Enables multi-runtime:"},{"id":"spn-77836","text":" Provider injection allows per-runtime deployment without inventing a bespoke secret distribution system."}]}],"id":"blk-51038","kind":"list-item"},{"blocks":[{"id":"blk-51041","kind":"paragraph","spans":[{"id":"spn-77837","marks":["bold"],"text":"Supports telemetry integrity:"},{"id":"spn-77838","text":" Deployment-scoped secrets and HMAC signatures prevent spoofing of usage events, which protects billing and limit enforcement."}]}],"id":"blk-51040","kind":"list-item"},{"blocks":[{"id":"blk-51043","kind":"paragraph","spans":[{"id":"spn-77839","marks":["bold"],"text":"Keeps MVP achievable:"},{"id":"spn-77840","text":" Write-only secrets entry + provider injection is implementable without building a full secrets vault and policy engine."}]}],"id":"blk-51042","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51044","kind":"heading","level":2,"spans":[{"id":"spn-77841","text":"Alternatives considered"}]},{"id":"blk-51045","kind":"heading","level":3,"spans":[{"id":"spn-77842","text":"A) Store encrypted secrets in the primary DB (application-managed encryption)"}]},{"id":"blk-51046","kind":"paragraph","spans":[{"id":"spn-77843","marks":["bold"],"text":"Pros"}]},{"id":"blk-51047","items":[{"blocks":[{"id":"blk-51049","kind":"paragraph","spans":[{"id":"spn-77844","text":"Simple read/write path."}]}],"id":"blk-51048","kind":"list-item"},{"blocks":[{"id":"blk-51051","kind":"paragraph","spans":[{"id":"spn-77845","text":"Centralized regardless of runtime provider."}]}],"id":"blk-51050","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51052","kind":"paragraph","spans":[{"id":"spn-77846","marks":["bold"],"text":"Cons"}]},{"id":"blk-51053","items":[{"blocks":[{"id":"blk-51055","kind":"paragraph","spans":[{"id":"spn-77847","text":"Key management becomes a major responsibility (KMS integration, rotation, access controls)."}]}],"id":"blk-51054","kind":"list-item"},{"blocks":[{"id":"blk-51057","kind":"paragraph","spans":[{"id":"spn-77848","text":"If application and DB are compromised, secrets may still be exposed via runtime memory or logs."}]}],"id":"blk-51056","kind":"list-item"},{"blocks":[{"id":"blk-51059","kind":"paragraph","spans":[{"id":"spn-77849","text":"More complex than necessary for MVP given provider secret facilities."}]}],"id":"blk-51058","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51060","kind":"paragraph","spans":[{"id":"spn-77850","marks":["bold"],"text":"Decision:"},{"id":"spn-77851","text":" Rejected for v1 (may revisit if a centralized secrets vault is required)."}]},{"id":"blk-51061","kind":"heading","level":3,"spans":[{"id":"spn-77852","text":"B) Centralized secret store for all secrets (e.g., dedicated vault) + runtime fetch at execution time"}]},{"id":"blk-51062","kind":"paragraph","spans":[{"id":"spn-77853","marks":["bold"],"text":"Pros"}]},{"id":"blk-51063","items":[{"blocks":[{"id":"blk-51065","kind":"paragraph","spans":[{"id":"spn-77854","text":"Single system of record, policy controls, potential audit/compliance benefits."}]}],"id":"blk-51064","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51066","kind":"paragraph","spans":[{"id":"spn-77855","marks":["bold"],"text":"Cons"}]},{"id":"blk-51067","items":[{"blocks":[{"id":"blk-51069","kind":"paragraph","spans":[{"id":"spn-77856","text":"Adds significant infrastructure and operational complexity."}]}],"id":"blk-51068","kind":"list-item"},{"blocks":[{"id":"blk-51071","kind":"paragraph","spans":[{"id":"spn-77857","text":"Requires secure runtime access and network paths from every provider."}]}],"id":"blk-51070","kind":"list-item"},{"blocks":[{"id":"blk-51073","kind":"paragraph","spans":[{"id":"spn-77858","text":"Introduces availability coupling: vault outage can break invocations."}]}],"id":"blk-51072","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51074","kind":"paragraph","spans":[{"id":"spn-77859","marks":["bold"],"text":"Decision:"},{"id":"spn-77860","text":" Rejected for v1; consider for enterprise roadmap if needed."}]},{"id":"blk-51075","kind":"heading","level":3,"spans":[{"id":"spn-77861","text":"C) Embed secrets in deployment artifacts or config files"}]},{"id":"blk-51076","kind":"paragraph","spans":[{"id":"spn-77862","marks":["bold"],"text":"Pros"}]},{"id":"blk-51077","items":[{"blocks":[{"id":"blk-51079","kind":"paragraph","spans":[{"id":"spn-77863","text":"Easiest to implement."}]}],"id":"blk-51078","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51080","kind":"paragraph","spans":[{"id":"spn-77864","marks":["bold"],"text":"Cons"}]},{"id":"blk-51081","items":[{"blocks":[{"id":"blk-51083","kind":"paragraph","spans":[{"id":"spn-77865","text":"Catastrophic: secrets leak via artifacts, logs, and provider introspection."}]}],"id":"blk-51082","kind":"list-item"},{"blocks":[{"id":"blk-51085","kind":"paragraph","spans":[{"id":"spn-77866","text":"Violates core security requirement."}]}],"id":"blk-51084","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51086","kind":"paragraph","spans":[{"id":"spn-77867","marks":["bold"],"text":"Decision:"},{"id":"spn-77868","text":" Rejected."}]},{"id":"blk-51087","kind":"heading","level":3,"spans":[{"id":"spn-77869","text":"D) Adapter-side telemetry only (no runtime telemetry secret)"}]},{"id":"blk-51088","kind":"paragraph","spans":[{"id":"spn-77870","marks":["bold"],"text":"Pros"}]},{"id":"blk-51089","items":[{"blocks":[{"id":"blk-51091","kind":"paragraph","spans":[{"id":"spn-77871","text":"Avoids injecting telemetry secret into runtime."}]}],"id":"blk-51090","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51092","kind":"paragraph","spans":[{"id":"spn-77872","marks":["bold"],"text":"Cons"}]},{"id":"blk-51093","items":[{"blocks":[{"id":"blk-51095","kind":"paragraph","spans":[{"id":"spn-77873","text":"Often cannot capture accurate compute/tool usage."}]}],"id":"blk-51094","kind":"list-item"},{"blocks":[{"id":"blk-51097","kind":"paragraph","spans":[{"id":"spn-77874","text":"Harder to attribute reliably at high concurrency; may undercount or miscount."}]}],"id":"blk-51096","kind":"list-item"},{"blocks":[{"id":"blk-51099","kind":"paragraph","spans":[{"id":"spn-77875","text":"Still requires strong integrity controls in adapter pathway."}]}],"id":"blk-51098","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51100","kind":"paragraph","spans":[{"id":"spn-77876","marks":["bold"],"text":"Decision:"},{"id":"spn-77877","text":" Not the primary strategy. Allowed only as a constrained fallback if provider limitations require it, but must preserve attribution integrity."}]},{"id":"blk-51101","kind":"heading","level":2,"spans":[{"id":"spn-77878","text":"Consequences"}]},{"id":"blk-51102","kind":"heading","level":3,"spans":[{"id":"spn-77879","text":"Positive"}]},{"id":"blk-51103","items":[{"blocks":[{"id":"blk-51105","kind":"paragraph","spans":[{"id":"spn-77880","text":"Stronger baseline security posture without heavy infrastructure."}]}],"id":"blk-51104","kind":"list-item"},{"blocks":[{"id":"blk-51107","kind":"paragraph","spans":[{"id":"spn-77881","text":"Clear separation of responsibilities:"}]}],"id":"blk-51106","kind":"list-item"},{"blocks":[{"id":"blk-51109","kind":"paragraph","spans":[{"id":"spn-77882","text":"DB stores metadata and references,"}]}],"id":"blk-51108","kind":"list-item"},{"blocks":[{"id":"blk-51111","kind":"paragraph","spans":[{"id":"spn-77883","text":"providers store values."}]}],"id":"blk-51110","kind":"list-item"},{"blocks":[{"id":"blk-51113","kind":"paragraph","spans":[{"id":"spn-77884","text":"Enables per-deployment telemetry signing and robust anti-spoofing."}]}],"id":"blk-51112","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51114","kind":"heading","level":3,"spans":[{"id":"spn-77885","text":"Negative / tradeoffs"}]},{"id":"blk-51115","items":[{"blocks":[{"id":"blk-51117","kind":"paragraph","spans":[{"id":"spn-77886","text":"Secret management becomes provider-dependent; implementation must support multiple injection mechanisms."}]}],"id":"blk-51116","kind":"list-item"},{"blocks":[{"id":"blk-51119","kind":"paragraph","spans":[{"id":"spn-77887","text":"Secret rotation may require redeploy on some providers."}]}],"id":"blk-51118","kind":"list-item"},{"blocks":[{"id":"blk-51121","kind":"paragraph","spans":[{"id":"spn-77888","text":"Debugging becomes harder because plaintext is not retrievable; must rely on “configured/not configured” and test invocations."}]}],"id":"blk-51120","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51122","kind":"heading","level":2,"spans":[{"id":"spn-77889","text":"Implementation details (normative)"}]},{"id":"blk-51123","kind":"heading","level":3,"spans":[{"id":"spn-77890","text":"1) Data model requirements"}]},{"id":"blk-51124","items":[{"blocks":[{"id":"blk-51126","kind":"paragraph","spans":[{"id":"spn-77891","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-77892","text":": list of secret key names (never values)."}]}],"id":"blk-51125","kind":"list-item"},{"blocks":[{"id":"blk-51128","kind":"paragraph","spans":[{"id":"spn-77893","marks":["code"],"text":"deployments.telemetryAuthRef"},{"id":"spn-77894","text":": provider reference to telemetry signing secret (never plaintext)."}]}],"id":"blk-51127","kind":"list-item"},{"blocks":[{"id":"blk-51130","kind":"paragraph","spans":[{"id":"spn-77895","text":"Optional "},{"id":"spn-77896","marks":["code"],"text":"secrets"},{"id":"spn-77897","text":" metadata table (if implemented) stores only:"}]}],"id":"blk-51129","kind":"list-item"},{"blocks":[{"id":"blk-51132","kind":"paragraph","spans":[{"id":"spn-77898","marks":["code"],"text":"userId"},{"id":"spn-77899","text":", "},{"id":"spn-77900","marks":["code"],"text":"agentId"},{"id":"spn-77901","text":", "},{"id":"spn-77902","marks":["code"],"text":"key"},{"id":"spn-77903","text":", "},{"id":"spn-77904","marks":["code"],"text":"provider"},{"id":"spn-77905","text":", "},{"id":"spn-77906","marks":["code"],"text":"secretRef"},{"id":"spn-77907","text":", "},{"id":"spn-77908","marks":["code"],"text":"createdAtMs"},{"id":"spn-77909","text":", "},{"id":"spn-77910","marks":["code"],"text":"rotatedAtMs"},{"id":"spn-77911","text":"."}]}],"id":"blk-51131","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51133","kind":"heading","level":3,"spans":[{"id":"spn-77912","text":"2) Secrets write endpoint"}]},{"id":"blk-51134","kind":"paragraph","spans":[{"id":"spn-77913","text":"If implementing "},{"id":"spn-77914","marks":["code"],"text":"POST /v1/agents/{agentId}/secrets"},{"id":"spn-77915","text":" (write-only):"}]},{"id":"blk-51135","items":[{"blocks":[{"id":"blk-51137","kind":"paragraph","spans":[{"id":"spn-77916","text":"MUST authenticate and enforce tenant ownership."}]}],"id":"blk-51136","kind":"list-item"},{"blocks":[{"id":"blk-51139","kind":"paragraph","spans":[{"id":"spn-77917","text":"MUST validate keys against "},{"id":"spn-77918","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-77919","text":" (or allow adding new keys via "},{"id":"spn-77920","marks":["code"],"text":"agents.update"},{"id":"spn-77921","text":" first)."}]}],"id":"blk-51138","kind":"list-item"},{"blocks":[{"id":"blk-51141","kind":"paragraph","spans":[{"id":"spn-77922","text":"MUST store values only in provider secret store(s) and discard plaintext immediately after injection."}]}],"id":"blk-51140","kind":"list-item"},{"blocks":[{"id":"blk-51143","kind":"paragraph","spans":[{"id":"spn-77923","text":"MUST NOT return secret values."}]}],"id":"blk-51142","kind":"list-item"},{"blocks":[{"id":"blk-51145","kind":"paragraph","spans":[{"id":"spn-77924","text":"MUST redact secret values in logs and error messages."}]}],"id":"blk-51144","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51146","kind":"heading","level":3,"spans":[{"id":"spn-77925","text":"3) Provider injection requirements"}]},{"id":"blk-51147","items":[{"blocks":[{"id":"blk-51149","kind":"paragraph","spans":[{"id":"spn-77926","text":"Cloudflare adapter:"}]}],"id":"blk-51148","kind":"list-item"},{"blocks":[{"id":"blk-51151","kind":"paragraph","spans":[{"id":"spn-77927","text":"Use provider API to set Worker secrets per deployment or per agent, and ensure the active Worker uses the correct secrets."}]}],"id":"blk-51150","kind":"list-item"},{"blocks":[{"id":"blk-51153","kind":"paragraph","spans":[{"id":"spn-77928","text":"AgentCore adapter:"}]}],"id":"blk-51152","kind":"list-item"},{"blocks":[{"id":"blk-51155","kind":"paragraph","spans":[{"id":"spn-77929","text":"Use "},{"id":"spn-77930","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-77931","text":" (v1 default) to set deployment-scoped secrets (telemetry signing key, user-provided API keys) as runtime environment variables."}]}],"id":"blk-51154","kind":"list-item"},{"blocks":[{"id":"blk-51157","kind":"paragraph","spans":[{"id":"spn-77932","text":"Use "},{"id":"spn-77933","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-77934","text":" as an optional enhancement (post-v1 or enterprise hardening) to support rotation without redeploy and centralized secret governance."}]}],"id":"blk-51156","kind":"list-item"},{"blocks":[{"id":"blk-51159","kind":"paragraph","spans":[{"id":"spn-77935","text":"Store only "},{"id":"spn-77936","marks":["bold"],"text":"references/metadata"},{"id":"spn-77937","text":" in the control plane DB (e.g., runtime env var key names and/or Secrets Manager ARNs). Never store plaintext values."}]}],"id":"blk-51158","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51160","kind":"heading","level":4,"spans":[{"id":"spn-77938","text":"AgentCore secret injection (implementation note)"}]},{"id":"blk-51161","kind":"paragraph","spans":[{"id":"spn-77939","text":"AgentCore supports multiple secret injection patterns. For v1, prefer environment variables because it minimizes moving parts and matches the Cloudflare deployment model (provider-managed secret injection at deploy time)."}]},{"id":"blk-51162","items":[{"blocks":[{"id":"blk-51164","kind":"paragraph","spans":[{"id":"spn-77940","marks":["bold"],"text":"Option 1 (v1 default): Environment variables"}]}],"id":"blk-51163","kind":"list-item"},{"blocks":[{"id":"blk-51166","kind":"paragraph","spans":[{"id":"spn-77941","text":"Control plane sets runtime environment variables as part of the deploy/create/update runtime call."}]}],"id":"blk-51165","kind":"list-item"},{"blocks":[{"id":"blk-51168","kind":"paragraph","spans":[{"id":"spn-77942","text":"Example variables:"}]}],"id":"blk-51167","kind":"list-item"},{"blocks":[{"id":"blk-51170","kind":"paragraph","spans":[{"id":"spn-77943","marks":["code"],"text":"TELEMETRY_SECRET"},{"id":"spn-77944","text":" (deployment-scoped HMAC key)"}]}],"id":"blk-51169","kind":"list-item"},{"blocks":[{"id":"blk-51172","kind":"paragraph","spans":[{"id":"spn-77945","text":"user-provided keys like "},{"id":"spn-77946","marks":["code"],"text":"OPENAI_API_KEY"}]}],"id":"blk-51171","kind":"list-item"},{"blocks":[{"id":"blk-51174","kind":"paragraph","spans":[{"id":"spn-77947","text":"Operational note: rotation may require redeploy depending on provider behavior; document in UI."}]}],"id":"blk-51173","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51175","items":[{"blocks":[{"id":"blk-51177","kind":"paragraph","spans":[{"id":"spn-77948","marks":["bold"],"text":"Option 2 (optional): AWS Secrets Manager references"}]}],"id":"blk-51176","kind":"list-item"},{"blocks":[{"id":"blk-51179","kind":"paragraph","spans":[{"id":"spn-77949","text":"Store secret values in Secrets Manager."}]}],"id":"blk-51178","kind":"list-item"},{"blocks":[{"id":"blk-51181","kind":"paragraph","spans":[{"id":"spn-77950","text":"Provide the runtime with references (ARNs) and an IAM role that permits retrieval."}]}],"id":"blk-51180","kind":"list-item"},{"blocks":[{"id":"blk-51183","kind":"paragraph","spans":[{"id":"spn-77951","text":"Operational note: enables rotation without redeploy, but increases IAM + operational complexity."}]}],"id":"blk-51182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51184","kind":"heading","level":3,"spans":[{"id":"spn-77952","text":"4) Telemetry signing requirements"}]},{"id":"blk-51185","items":[{"blocks":[{"id":"blk-51187","kind":"paragraph","spans":[{"id":"spn-77953","text":"Each deployment MUST have a unique telemetry signing secret."}]}],"id":"blk-51186","kind":"list-item"},{"blocks":[{"id":"blk-51189","kind":"paragraph","spans":[{"id":"spn-77954","text":"Runtime sends telemetry with:"}]}],"id":"blk-51188","kind":"list-item"},{"blocks":[{"id":"blk-51191","kind":"paragraph","spans":[{"id":"spn-77955","marks":["code"],"text":"X-Telemetry-Deployment-Id: <deploymentId>"}]}],"id":"blk-51190","kind":"list-item"},{"blocks":[{"id":"blk-51193","kind":"paragraph","spans":[{"id":"spn-77956","marks":["code"],"text":"X-Telemetry-Signature: v1=<hex-hmac-sha256(body)>"}]}],"id":"blk-51192","kind":"list-item"},{"blocks":[{"id":"blk-51195","kind":"paragraph","spans":[{"id":"spn-77957","text":"Control plane MUST verify:"}]}],"id":"blk-51194","kind":"list-item"},{"blocks":[{"id":"blk-51197","kind":"paragraph","spans":[{"id":"spn-77958","text":"signature validity,"}]}],"id":"blk-51196","kind":"list-item"},{"blocks":[{"id":"blk-51199","kind":"paragraph","spans":[{"id":"spn-77959","text":"deployment ownership mapping to "},{"id":"spn-77960","marks":["code"],"text":"{userId, agentId}"},{"id":"spn-77961","text":","}]}],"id":"blk-51198","kind":"list-item"},{"blocks":[{"id":"blk-51201","kind":"paragraph","spans":[{"id":"spn-77962","text":"required attribution fields."}]}],"id":"blk-51200","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51202","kind":"heading","level":3,"spans":[{"id":"spn-77963","text":"5) Rotation policy"}]},{"id":"blk-51203","items":[{"blocks":[{"id":"blk-51205","kind":"paragraph","spans":[{"id":"spn-77964","text":"Telemetry secrets:"}]}],"id":"blk-51204","kind":"list-item"},{"blocks":[{"id":"blk-51207","kind":"paragraph","spans":[{"id":"spn-77965","text":"MUST rotate on every new deployment by default."}]}],"id":"blk-51206","kind":"list-item"},{"blocks":[{"id":"blk-51209","kind":"paragraph","spans":[{"id":"spn-77966","text":"Customer secrets:"}]}],"id":"blk-51208","kind":"list-item"},{"blocks":[{"id":"blk-51211","kind":"paragraph","spans":[{"id":"spn-77967","text":"MAY be rotated by user action; system SHOULD record rotation timestamp."}]}],"id":"blk-51210","kind":"list-item"},{"blocks":[{"id":"blk-51213","kind":"paragraph","spans":[{"id":"spn-77968","text":"If provider requires redeploy for new secret values to take effect, UI MUST make this explicit."}]}],"id":"blk-51212","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51214","kind":"heading","level":2,"spans":[{"id":"spn-77969","text":"Security & compliance notes"}]},{"id":"blk-51215","items":[{"blocks":[{"id":"blk-51217","kind":"paragraph","spans":[{"id":"spn-77970","text":"This ADR supports a SOC2-aligned posture by:"}]}],"id":"blk-51216","kind":"list-item"},{"blocks":[{"id":"blk-51219","kind":"paragraph","spans":[{"id":"spn-77971","text":"minimizing sensitive data stored in primary DB,"}]}],"id":"blk-51218","kind":"list-item"},{"blocks":[{"id":"blk-51221","kind":"paragraph","spans":[{"id":"spn-77972","text":"ensuring integrity of billing-relevant telemetry,"}]}],"id":"blk-51220","kind":"list-item"},{"blocks":[{"id":"blk-51223","kind":"paragraph","spans":[{"id":"spn-77973","text":"enabling auditability (via audit logs for secrets set and telemetry rejections)."}]}],"id":"blk-51222","kind":"list-item"},{"blocks":[{"id":"blk-51225","kind":"paragraph","spans":[{"id":"spn-77974","text":"This ADR does not eliminate the inherent risk that untrusted customer agent code can exfiltrate secrets it is given; the platform mitigates by scoping secrets per agent and avoiding cross-tenant exposure."}]}],"id":"blk-51224","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51226","kind":"heading","level":2,"spans":[{"id":"spn-77975","text":"Acceptance criteria"}]},{"id":"blk-51227","kind":"paragraph","spans":[{"id":"spn-77976","text":"This ADR is correctly implemented when:"}]},{"id":"blk-51228","items":[{"blocks":[{"id":"blk-51230","kind":"paragraph","spans":[{"id":"spn-77977","text":"No plaintext secret values exist in the primary DB (verified via code review and automated checks)."}]}],"id":"blk-51229","kind":"list-item"},{"blocks":[{"id":"blk-51232","kind":"paragraph","spans":[{"id":"spn-77978","text":"Secrets set via API are write-only; plaintext secrets are never returned."}]}],"id":"blk-51231","kind":"list-item"},{"blocks":[{"id":"blk-51234","kind":"paragraph","spans":[{"id":"spn-77979","text":"Provider secrets are injected and required for runtime invocation (e.g., model keys, telemetry signing secret)."}]}],"id":"blk-51233","kind":"list-item"},{"blocks":[{"id":"blk-51236","kind":"paragraph","spans":[{"id":"spn-77980","text":"Telemetry ingestion rejects invalid signatures and mismatched ownership."}]}],"id":"blk-51235","kind":"list-item"},{"blocks":[{"id":"blk-51238","kind":"paragraph","spans":[{"id":"spn-77981","text":"Logs and error messages are sanitized and do not contain secret values."}]}],"id":"blk-51237","kind":"list-item"},{"blocks":[{"id":"blk-51240","kind":"paragraph","spans":[{"id":"spn-77982","text":"Secret rotation is supported at least via “set new value” flow and telemetry secrets rotate per deployment."}]}],"id":"blk-51239","kind":"list-item"}],"kind":"list","ordered":true}],"edges":[],"id":"bagaaierarzhmj53zoo6rvxblufzosbmb6lqc7xfngp572e6umv64rz5clsta","vocabulary":"ampersand.docs.fs.v1"}