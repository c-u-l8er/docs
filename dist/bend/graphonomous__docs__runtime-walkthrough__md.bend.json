{"bendscript":"0.1","blocks":[{"id":"blk-42246","kind":"heading","level":1,"spans":[{"id":"spn-48080","text":"Runtime Walkthrough"}]},{"id":"blk-42247","kind":"paragraph","spans":[{"id":"spn-48081","text":"This page walks through the Graphonomous runtime from process startup to closed-loop learning, goal review, and maintenance."}]},{"id":"blk-42248","kind":"paragraph","spans":[{"id":"spn-48082","text":"If you want a practical mental model, think in this sequence:"}]},{"id":"blk-42249","kind":"paragraph","spans":[{"id":"spn-48083","text":"1. "},{"id":"spn-48084","marks":["bold"],"text":"Boot services"},{"id":"spn-48085","text":" 2. "},{"id":"spn-48086","marks":["bold"],"text":"Retrieve context"},{"id":"spn-48087","text":" 3. "},{"id":"spn-48088","marks":["bold"],"text":"Act"},{"id":"spn-48089","text":" 4. "},{"id":"spn-48090","marks":["bold"],"text":"Store durable knowledge"},{"id":"spn-48091","text":" 5. "},{"id":"spn-48092","marks":["bold"],"text":"Learn from outcomes"},{"id":"spn-48093","text":" 6. "},{"id":"spn-48094","marks":["bold"],"text":"Review goal coverage"},{"id":"spn-48095","text":" 7. "},{"id":"spn-48096","marks":["bold"],"text":"Run consolidation"}]},{"id":"blk-42250","kind":"paragraph","spans":[{"id":"spn-48097","text":"---"}]},{"id":"blk-42251","kind":"heading","level":2,"spans":[{"id":"spn-48098","text":"1) Boot and Supervision"}]},{"id":"blk-42252","kind":"paragraph","spans":[{"id":"spn-48099","text":"Graphonomous runs as an OTP application with supervised runtime components:"}]},{"id":"blk-42253","items":[{"blocks":[{"id":"blk-42255","kind":"paragraph","spans":[{"id":"spn-48100","text":"Store"}]}],"id":"blk-42254","kind":"list-item"},{"blocks":[{"id":"blk-42257","kind":"paragraph","spans":[{"id":"spn-48101","text":"Embedder"}]}],"id":"blk-42256","kind":"list-item"},{"blocks":[{"id":"blk-42259","kind":"paragraph","spans":[{"id":"spn-48102","text":"Graph"}]}],"id":"blk-42258","kind":"list-item"},{"blocks":[{"id":"blk-42261","kind":"paragraph","spans":[{"id":"spn-48103","text":"Retriever"}]}],"id":"blk-42260","kind":"list-item"},{"blocks":[{"id":"blk-42263","kind":"paragraph","spans":[{"id":"spn-48104","text":"Learner"}]}],"id":"blk-42262","kind":"list-item"},{"blocks":[{"id":"blk-42265","kind":"paragraph","spans":[{"id":"spn-48105","text":"GoalGraph"}]}],"id":"blk-42264","kind":"list-item"},{"blocks":[{"id":"blk-42267","kind":"paragraph","spans":[{"id":"spn-48106","text":"Attention"}]}],"id":"blk-42266","kind":"list-item"},{"blocks":[{"id":"blk-42269","kind":"paragraph","spans":[{"id":"spn-48107","text":"Consolidator"}]}],"id":"blk-42268","kind":"list-item"},{"blocks":[{"id":"blk-42271","kind":"paragraph","spans":[{"id":"spn-48108","text":"MCP registry/server plumbing"}]}],"id":"blk-42270","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42272","kind":"heading","level":3,"spans":[{"id":"spn-48109","text":"What happens at startup"}]},{"id":"blk-42273","items":[{"blocks":[{"id":"blk-42275","kind":"paragraph","spans":[{"id":"spn-48110","text":"Store opens the SQLite database."}]}],"id":"blk-42274","kind":"list-item"},{"blocks":[{"id":"blk-42277","kind":"paragraph","spans":[{"id":"spn-48111","text":"Schema/migrations are applied."}]}],"id":"blk-42276","kind":"list-item"},{"blocks":[{"id":"blk-42279","kind":"paragraph","spans":[{"id":"spn-48112","text":"ETS hot cache is rebuilt from durable state."}]}],"id":"blk-42278","kind":"list-item"},{"blocks":[{"id":"blk-42281","kind":"paragraph","spans":[{"id":"spn-48113","text":"Core services come online and MCP tools/resources are exposed."}]}],"id":"blk-42280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42282","kind":"heading","level":3,"spans":[{"id":"spn-48114","text":"Why this matters"}]},{"id":"blk-42283","kind":"paragraph","spans":[{"id":"spn-48115","text":"You get:"}]},{"id":"blk-42284","items":[{"blocks":[{"id":"blk-42286","kind":"paragraph","spans":[{"id":"spn-48116","text":"fast reads (ETS)"}]}],"id":"blk-42285","kind":"list-item"},{"blocks":[{"id":"blk-42288","kind":"paragraph","spans":[{"id":"spn-48117","text":"durable writes (SQLite)"}]}],"id":"blk-42287","kind":"list-item"},{"blocks":[{"id":"blk-42290","kind":"paragraph","spans":[{"id":"spn-48118","text":"process-level fault isolation (OTP supervision)"}]}],"id":"blk-42289","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42291","kind":"paragraph","spans":[{"id":"spn-48119","text":"---"}]},{"id":"blk-42292","kind":"heading","level":2,"spans":[{"id":"spn-48120","text":"2) MCP Session Entry"}]},{"id":"blk-42293","kind":"paragraph","spans":[{"id":"spn-48121","text":"Most integrations begin through MCP over stdio."}]},{"id":"blk-42294","kind":"paragraph","spans":[{"id":"spn-48122","text":"Typical first checks:"}]},{"id":"blk-42295","items":[{"blocks":[{"id":"blk-42297","kind":"paragraph","spans":[{"id":"spn-48123","text":"Runtime health snapshot"}]}],"id":"blk-42296","kind":"list-item"},{"blocks":[{"id":"blk-42299","kind":"paragraph","spans":[{"id":"spn-48124","text":"Goal snapshot"}]}],"id":"blk-42298","kind":"list-item"},{"blocks":[{"id":"blk-42301","kind":"paragraph","spans":[{"id":"spn-48125","text":"Lightweight context retrieval for the current task"}]}],"id":"blk-42300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42302","kind":"paragraph","spans":[{"id":"spn-48126","text":"This gives the agent session orientation before making changes."}]},{"id":"blk-42303","kind":"paragraph","spans":[{"id":"spn-48127","text":"---"}]},{"id":"blk-42304","kind":"heading","level":2,"spans":[{"id":"spn-48128","text":"3) Retrieval Path (Context Before Action)"}]},{"id":"blk-42305","kind":"paragraph","spans":[{"id":"spn-48129","text":"Graphonomous retrieval is not only semantic similarity. It combines:"}]},{"id":"blk-42306","kind":"paragraph","spans":[{"id":"spn-48130","text":"1. embedding similarity search 2. graph-neighbor expansion 3. confidence-aware ranking 4. topology analysis (SCC/κ routing metadata)"}]},{"id":"blk-42307","kind":"heading","level":3,"spans":[{"id":"spn-48131","text":"Retrieval output you should pay attention to"}]},{"id":"blk-42308","items":[{"blocks":[{"id":"blk-42310","kind":"paragraph","spans":[{"id":"spn-48132","marks":["code"],"text":"results"},{"id":"spn-48133","text":": ranked candidate context nodes"}]}],"id":"blk-42309","kind":"list-item"},{"blocks":[{"id":"blk-42312","kind":"paragraph","spans":[{"id":"spn-48134","marks":["code"],"text":"causal_context"},{"id":"spn-48135","text":": node IDs used later for outcome learning"}]}],"id":"blk-42311","kind":"list-item"},{"blocks":[{"id":"blk-42314","kind":"paragraph","spans":[{"id":"spn-48136","marks":["code"],"text":"topology.routing"},{"id":"spn-48137","text":": "},{"id":"spn-48138","marks":["code"],"text":"fast"},{"id":"spn-48139","text":" or "},{"id":"spn-48140","marks":["code"],"text":"deliberate"}]}],"id":"blk-42313","kind":"list-item"},{"blocks":[{"id":"blk-42316","kind":"paragraph","spans":[{"id":"spn-48141","marks":["code"],"text":"topology.max_kappa"},{"id":"spn-48142","text":": cycle complexity signal"}]}],"id":"blk-42315","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42317","kind":"heading","level":3,"spans":[{"id":"spn-48143","text":"Routing behavior"}]},{"id":"blk-42318","items":[{"blocks":[{"id":"blk-42320","kind":"paragraph","spans":[{"id":"spn-48144","marks":["bold"],"text":"fast"},{"id":"spn-48145","text":": proceed with normal reasoning"}]}],"id":"blk-42319","kind":"list-item"},{"blocks":[{"id":"blk-42322","kind":"paragraph","spans":[{"id":"spn-48146","marks":["bold"],"text":"deliberate"},{"id":"spn-48147","text":": use deeper deliberation for cyclic/conflicting regions"}]}],"id":"blk-42321","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42323","kind":"paragraph","spans":[{"id":"spn-48148","text":"---"}]},{"id":"blk-42324","kind":"heading","level":2,"spans":[{"id":"spn-48149","text":"4) Acting and Writing Memory"}]},{"id":"blk-42325","kind":"paragraph","spans":[{"id":"spn-48150","text":"After retrieval, the agent reasons and executes work. New durable knowledge should be stored in atomic form."}]},{"id":"blk-42326","kind":"heading","level":3,"spans":[{"id":"spn-48151","text":"Node types"}]},{"id":"blk-42327","items":[{"blocks":[{"id":"blk-42329","kind":"paragraph","spans":[{"id":"spn-48152","marks":["code"],"text":"semantic"},{"id":"spn-48153","text":": facts/architecture"}]}],"id":"blk-42328","kind":"list-item"},{"blocks":[{"id":"blk-42331","kind":"paragraph","spans":[{"id":"spn-48154","marks":["code"],"text":"procedural"},{"id":"spn-48155","text":": how-to/workflows"}]}],"id":"blk-42330","kind":"list-item"},{"blocks":[{"id":"blk-42333","kind":"paragraph","spans":[{"id":"spn-48156","marks":["code"],"text":"episodic"},{"id":"spn-48157","text":": observed events or session outcomes"}]}],"id":"blk-42332","kind":"list-item"},{"blocks":[{"id":"blk-42335","kind":"paragraph","spans":[{"id":"spn-48158","marks":["code"],"text":"temporal"},{"id":"spn-48159","text":": time-indexed observations, monitoring events"}]}],"id":"blk-42334","kind":"list-item"},{"blocks":[{"id":"blk-42337","kind":"paragraph","spans":[{"id":"spn-48160","marks":["code"],"text":"outcome"},{"id":"spn-48161","text":": empirical results of actions (grounding)"}]}],"id":"blk-42336","kind":"list-item"},{"blocks":[{"id":"blk-42339","kind":"paragraph","spans":[{"id":"spn-48162","marks":["code"],"text":"goal"},{"id":"spn-48163","text":": durable intent, objectives, targets"}]}],"id":"blk-42338","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42340","kind":"heading","level":3,"spans":[{"id":"spn-48164","text":"Good storage discipline"}]},{"id":"blk-42341","items":[{"blocks":[{"id":"blk-42343","kind":"paragraph","spans":[{"id":"spn-48165","text":"one claim/procedure/event per node"}]}],"id":"blk-42342","kind":"list-item"},{"blocks":[{"id":"blk-42345","kind":"paragraph","spans":[{"id":"spn-48166","text":"realistic confidence values"}]}],"id":"blk-42344","kind":"list-item"},{"blocks":[{"id":"blk-42347","kind":"paragraph","spans":[{"id":"spn-48167","text":"source attribution when possible"}]}],"id":"blk-42346","kind":"list-item"},{"blocks":[{"id":"blk-42349","kind":"paragraph","spans":[{"id":"spn-48168","text":"edges only when relationship quality justifies it"}]}],"id":"blk-42348","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42350","kind":"paragraph","spans":[{"id":"spn-48169","text":"---"}]},{"id":"blk-42351","kind":"heading","level":2,"spans":[{"id":"spn-48170","text":"5) Closed-Loop Learning (Outcome Feedback)"}]},{"id":"blk-42352","kind":"paragraph","spans":[{"id":"spn-48171","text":"After a meaningful action, Graphonomous can update confidence on the causal nodes that informed that action."}]},{"id":"blk-42353","kind":"heading","level":3,"spans":[{"id":"spn-48172","text":"Learning inputs"}]},{"id":"blk-42354","items":[{"blocks":[{"id":"blk-42356","kind":"paragraph","spans":[{"id":"spn-48173","marks":["code"],"text":"action_id"}]}],"id":"blk-42355","kind":"list-item"},{"blocks":[{"id":"blk-42358","kind":"paragraph","spans":[{"id":"spn-48174","marks":["code"],"text":"status"},{"id":"spn-48175","text":" ("},{"id":"spn-48176","marks":["code"],"text":"success"},{"id":"spn-48177","text":", "},{"id":"spn-48178","marks":["code"],"text":"partial_success"},{"id":"spn-48179","text":", "},{"id":"spn-48180","marks":["code"],"text":"failure"},{"id":"spn-48181","text":", "},{"id":"spn-48182","marks":["code"],"text":"timeout"},{"id":"spn-48183","text":")"}]}],"id":"blk-42357","kind":"list-item"},{"blocks":[{"id":"blk-42360","kind":"paragraph","spans":[{"id":"spn-48184","text":"outcome "},{"id":"spn-48185","marks":["code"],"text":"confidence"}]}],"id":"blk-42359","kind":"list-item"},{"blocks":[{"id":"blk-42362","kind":"paragraph","spans":[{"id":"spn-48186","marks":["code"],"text":"causal_node_ids"},{"id":"spn-48187","text":" (from retrieval causal context)"}]}],"id":"blk-42361","kind":"list-item"},{"blocks":[{"id":"blk-42364","kind":"paragraph","spans":[{"id":"spn-48188","text":"optional evidence/trace metadata"}]}],"id":"blk-42363","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42365","kind":"heading","level":3,"spans":[{"id":"spn-48189","text":"Confidence update model"}]},{"id":"blk-42366","kind":"paragraph","spans":[{"id":"spn-48190","text":"Learner applies a bounded, learning-rate blend from prior confidence and status-scaled signal, so graph trust adapts over time."}]},{"id":"blk-42367","kind":"heading","level":3,"spans":[{"id":"spn-48191","text":"Practical effect"}]},{"id":"blk-42368","items":[{"blocks":[{"id":"blk-42370","kind":"paragraph","spans":[{"id":"spn-48192","text":"useful nodes get reinforced"}]}],"id":"blk-42369","kind":"list-item"},{"blocks":[{"id":"blk-42372","kind":"paragraph","spans":[{"id":"spn-48193","text":"weak/wrong assumptions are down-weighted"}]}],"id":"blk-42371","kind":"list-item"},{"blocks":[{"id":"blk-42374","kind":"paragraph","spans":[{"id":"spn-48194","text":"retrieval quality improves across sessions"}]}],"id":"blk-42373","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42375","kind":"paragraph","spans":[{"id":"spn-48195","text":"---"}]},{"id":"blk-42376","kind":"heading","level":2,"spans":[{"id":"spn-48196","text":"6) GoalGraph and Coverage Gate"}]},{"id":"blk-42377","kind":"paragraph","spans":[{"id":"spn-48197","text":"For multi-step work, goals provide durable intent and lifecycle management."}]},{"id":"blk-42378","kind":"heading","level":3,"spans":[{"id":"spn-48198","text":"Goal lifecycle examples"}]},{"id":"blk-42379","items":[{"blocks":[{"id":"blk-42381","kind":"paragraph","spans":[{"id":"spn-48199","marks":["code"],"text":"proposed"},{"id":"spn-48200","text":" -> "},{"id":"spn-48201","marks":["code"],"text":"active"},{"id":"spn-48202","text":" -> "},{"id":"spn-48203","marks":["code"],"text":"completed"}]}],"id":"blk-42380","kind":"list-item"},{"blocks":[{"id":"blk-42383","kind":"paragraph","spans":[{"id":"spn-48204","marks":["code"],"text":"active"},{"id":"spn-48205","text":" -> "},{"id":"spn-48206","marks":["code"],"text":"blocked"},{"id":"spn-48207","text":" (if escalation needed)"}]}],"id":"blk-42382","kind":"list-item"},{"blocks":[{"id":"blk-42385","kind":"paragraph","spans":[{"id":"spn-48208","text":"optional pause/abandon transitions as policy requires"}]}],"id":"blk-42384","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42386","kind":"heading","level":3,"spans":[{"id":"spn-48209","text":"Coverage review"}]},{"id":"blk-42387","kind":"paragraph","spans":[{"id":"spn-48210","text":"Coverage computes:"}]},{"id":"blk-42388","items":[{"blocks":[{"id":"blk-42390","kind":"paragraph","spans":[{"id":"spn-48211","marks":["code"],"text":"coverage_score"}]}],"id":"blk-42389","kind":"list-item"},{"blocks":[{"id":"blk-42392","kind":"paragraph","spans":[{"id":"spn-48212","marks":["code"],"text":"uncertainty_score"}]}],"id":"blk-42391","kind":"list-item"},{"blocks":[{"id":"blk-42394","kind":"paragraph","spans":[{"id":"spn-48213","marks":["code"],"text":"risk_score"}]}],"id":"blk-42393","kind":"list-item"},{"blocks":[{"id":"blk-42396","kind":"paragraph","spans":[{"id":"spn-48214","text":"decision: "},{"id":"spn-48215","marks":["code"],"text":"act"},{"id":"spn-48216","text":" | "},{"id":"spn-48217","marks":["code"],"text":"learn"},{"id":"spn-48218","text":" | "},{"id":"spn-48219","marks":["code"],"text":"escalate"}]}],"id":"blk-42395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42397","kind":"paragraph","spans":[{"id":"spn-48220","text":"This lets the runtime gate actions based on epistemic readiness, not just availability of any context."}]},{"id":"blk-42398","kind":"paragraph","spans":[{"id":"spn-48221","text":"---"}]},{"id":"blk-42399","kind":"heading","level":2,"spans":[{"id":"spn-48222","text":"7) Attention Loop (Prioritization Across Goals)"}]},{"id":"blk-42400","kind":"paragraph","spans":[{"id":"spn-48223","text":"When many goals are in flight, attention can survey and rank what needs focus."}]},{"id":"blk-42401","kind":"paragraph","spans":[{"id":"spn-48224","text":"Autonomy modes:"}]},{"id":"blk-42402","items":[{"blocks":[{"id":"blk-42404","kind":"paragraph","spans":[{"id":"spn-48225","marks":["code"],"text":"observe"},{"id":"spn-48226","text":" (read-only prioritization)"}]}],"id":"blk-42403","kind":"list-item"},{"blocks":[{"id":"blk-42406","kind":"paragraph","spans":[{"id":"spn-48227","marks":["code"],"text":"advise"},{"id":"spn-48228","text":" (recommend actions)"}]}],"id":"blk-42405","kind":"list-item"},{"blocks":[{"id":"blk-42408","kind":"paragraph","spans":[{"id":"spn-48229","marks":["code"],"text":"act"},{"id":"spn-48230","text":" (dispatch bounded actions)"}]}],"id":"blk-42407","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42409","kind":"paragraph","spans":[{"id":"spn-48231","text":"Attention combines urgency, coverage state, and topology complexity to prioritize execution."}]},{"id":"blk-42410","kind":"paragraph","spans":[{"id":"spn-48232","text":"---"}]},{"id":"blk-42411","kind":"heading","level":2,"spans":[{"id":"spn-48233","text":"8) Consolidation Cycle (Memory Maintenance)"}]},{"id":"blk-42412","kind":"paragraph","spans":[{"id":"spn-48234","text":"Consolidation keeps memory quality healthy over time."}]},{"id":"blk-42413","kind":"paragraph","spans":[{"id":"spn-48235","text":"The 7-stage pipeline includes:"}]},{"id":"blk-42414","kind":"paragraph","spans":[{"id":"spn-48236","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-42415","kind":"paragraph","spans":[{"id":"spn-48237","text":"Operationally, run consolidation:"}]},{"id":"blk-42416","items":[{"blocks":[{"id":"blk-42418","kind":"paragraph","spans":[{"id":"spn-48238","text":"at session boundaries"}]}],"id":"blk-42417","kind":"list-item"},{"blocks":[{"id":"blk-42420","kind":"paragraph","spans":[{"id":"spn-48239","text":"after heavy write bursts"}]}],"id":"blk-42419","kind":"list-item"},{"blocks":[{"id":"blk-42422","kind":"paragraph","spans":[{"id":"spn-48240","text":"periodically during long autonomous loops"}]}],"id":"blk-42421","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42423","kind":"paragraph","spans":[{"id":"spn-48241","text":"---"}]},{"id":"blk-42424","kind":"heading","level":2,"spans":[{"id":"spn-48242","text":"9) End-to-End Example Walkthrough"}]},{"id":"blk-42425","kind":"paragraph","spans":[{"id":"spn-48243","text":"A complete interaction often looks like this:"}]},{"id":"blk-42426","kind":"paragraph","spans":[{"id":"spn-48244","text":"1. Agent retrieves context for user task. 2. Runtime returns ranked results + causal context + topology signal. 3. Agent performs work and returns output. 4. Agent stores key new semantic/procedural/episodic nodes. 5. Agent reports outcome against causal nodes. 6. Goal progress is updated. 7. Coverage is reviewed before next consequential step. 8. Consolidation runs to maintain graph quality."}]},{"id":"blk-42427","kind":"paragraph","spans":[{"id":"spn-48245","text":"---"}]},{"id":"blk-42428","kind":"heading","level":2,"spans":[{"id":"spn-48246","text":"10) Operational Checklist"}]},{"id":"blk-42429","kind":"paragraph","spans":[{"id":"spn-48247","text":"Before ending a productive session:"}]},{"id":"blk-42430","items":[{"blocks":[{"id":"blk-42432","kind":"paragraph","spans":[{"id":"spn-48248","text":"[ ] Store key durable knowledge"}]}],"id":"blk-42431","kind":"list-item"},{"blocks":[{"id":"blk-42434","kind":"paragraph","spans":[{"id":"spn-48249","text":"[ ] Report outcomes for consequential actions"}]}],"id":"blk-42433","kind":"list-item"},{"blocks":[{"id":"blk-42436","kind":"paragraph","spans":[{"id":"spn-48250","text":"[ ] Update linked goals/progress/status"}]}],"id":"blk-42435","kind":"list-item"},{"blocks":[{"id":"blk-42438","kind":"paragraph","spans":[{"id":"spn-48251","text":"[ ] Trigger or verify consolidation"}]}],"id":"blk-42437","kind":"list-item"},{"blocks":[{"id":"blk-42440","kind":"paragraph","spans":[{"id":"spn-48252","text":"[ ] Confirm runtime remains healthy"}]}],"id":"blk-42439","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42441","kind":"paragraph","spans":[{"id":"spn-48253","text":"---"}]},{"id":"blk-42442","kind":"heading","level":2,"spans":[{"id":"spn-48254","text":"11) Common Failure Patterns to Avoid"}]},{"id":"blk-42443","items":[{"blocks":[{"id":"blk-42445","kind":"paragraph","spans":[{"id":"spn-48255","text":"skipping retrieval on non-trivial tasks"}]}],"id":"blk-42444","kind":"list-item"},{"blocks":[{"id":"blk-42447","kind":"paragraph","spans":[{"id":"spn-48256","text":"losing causal context before outcome reporting"}]}],"id":"blk-42446","kind":"list-item"},{"blocks":[{"id":"blk-42449","kind":"paragraph","spans":[{"id":"spn-48257","text":"inflating confidence without evidence"}]}],"id":"blk-42448","kind":"list-item"},{"blocks":[{"id":"blk-42451","kind":"paragraph","spans":[{"id":"spn-48258","text":"storing kitchen-sink nodes"}]}],"id":"blk-42450","kind":"list-item"},{"blocks":[{"id":"blk-42453","kind":"paragraph","spans":[{"id":"spn-48259","text":"fabricating coverage or outcome signals"}]}],"id":"blk-42452","kind":"list-item"},{"blocks":[{"id":"blk-42455","kind":"paragraph","spans":[{"id":"spn-48260","text":"ignoring repeated "},{"id":"spn-48261","marks":["code"],"text":"learn"},{"id":"spn-48262","text":"/"},{"id":"spn-48263","marks":["code"],"text":"escalate"},{"id":"spn-48264","text":" routing"}]}],"id":"blk-42454","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42456","kind":"paragraph","spans":[{"id":"spn-48265","text":"---"}]},{"id":"blk-42457","kind":"heading","level":2,"spans":[{"id":"spn-48266","text":"12) Suggested Next Reads"}]},{"id":"blk-42458","items":[{"blocks":[{"id":"blk-42460","kind":"paragraph","spans":[{"id":"spn-48267","marks":["code"],"text":"quickstart"}]}],"id":"blk-42459","kind":"list-item"},{"blocks":[{"id":"blk-42462","kind":"paragraph","spans":[{"id":"spn-48268","marks":["code"],"text":"architecture"}]}],"id":"blk-42461","kind":"list-item"},{"blocks":[{"id":"blk-42464","kind":"paragraph","spans":[{"id":"spn-48269","marks":["code"],"text":"mcp-tools"}]}],"id":"blk-42463","kind":"list-item"},{"blocks":[{"id":"blk-42466","kind":"paragraph","spans":[{"id":"spn-48270","marks":["code"],"text":"operations"}]}],"id":"blk-42465","kind":"list-item"},{"blocks":[{"id":"blk-42468","kind":"paragraph","spans":[{"id":"spn-48271","marks":["code"],"text":"skills/SKILLS"}]}],"id":"blk-42467","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42469","kind":"paragraph","spans":[{"id":"spn-48272","text":"If you are integrating an autonomous agent, treat this walkthrough as the runtime backbone and the skills docs as strict operating policy."}]}],"edges":[],"id":"bagaaierahmigzhjrwbkgv5ft3d4ydjtqs2dbi2gbite7v5sydke5h77brvnq","vocabulary":"ampersand.docs.fs.v1"}