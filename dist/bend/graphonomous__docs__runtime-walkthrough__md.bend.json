{"bendscript":"0.1","blocks":[{"id":"blk-41760","kind":"heading","level":1,"spans":[{"id":"spn-46906","text":"Runtime Walkthrough"}]},{"id":"blk-41761","kind":"paragraph","spans":[{"id":"spn-46907","text":"This page walks through the Graphonomous runtime from process startup to closed-loop learning, goal review, and maintenance."}]},{"id":"blk-41762","kind":"paragraph","spans":[{"id":"spn-46908","text":"If you want a practical mental model, think in this sequence:"}]},{"id":"blk-41763","kind":"paragraph","spans":[{"id":"spn-46909","text":"1. "},{"id":"spn-46910","marks":["bold"],"text":"Boot services"},{"id":"spn-46911","text":" 2. "},{"id":"spn-46912","marks":["bold"],"text":"Retrieve context"},{"id":"spn-46913","text":" 3. "},{"id":"spn-46914","marks":["bold"],"text":"Act"},{"id":"spn-46915","text":" 4. "},{"id":"spn-46916","marks":["bold"],"text":"Store durable knowledge"},{"id":"spn-46917","text":" 5. "},{"id":"spn-46918","marks":["bold"],"text":"Learn from outcomes"},{"id":"spn-46919","text":" 6. "},{"id":"spn-46920","marks":["bold"],"text":"Review goal coverage"},{"id":"spn-46921","text":" 7. "},{"id":"spn-46922","marks":["bold"],"text":"Run consolidation"}]},{"id":"blk-41764","kind":"paragraph","spans":[{"id":"spn-46923","text":"---"}]},{"id":"blk-41765","kind":"heading","level":2,"spans":[{"id":"spn-46924","text":"1) Boot and Supervision"}]},{"id":"blk-41766","kind":"paragraph","spans":[{"id":"spn-46925","text":"Graphonomous runs as an OTP application with supervised runtime components:"}]},{"id":"blk-41767","items":[{"blocks":[{"id":"blk-41769","kind":"paragraph","spans":[{"id":"spn-46926","text":"Store"}]}],"id":"blk-41768","kind":"list-item"},{"blocks":[{"id":"blk-41771","kind":"paragraph","spans":[{"id":"spn-46927","text":"Embedder"}]}],"id":"blk-41770","kind":"list-item"},{"blocks":[{"id":"blk-41773","kind":"paragraph","spans":[{"id":"spn-46928","text":"Graph"}]}],"id":"blk-41772","kind":"list-item"},{"blocks":[{"id":"blk-41775","kind":"paragraph","spans":[{"id":"spn-46929","text":"Retriever"}]}],"id":"blk-41774","kind":"list-item"},{"blocks":[{"id":"blk-41777","kind":"paragraph","spans":[{"id":"spn-46930","text":"Learner"}]}],"id":"blk-41776","kind":"list-item"},{"blocks":[{"id":"blk-41779","kind":"paragraph","spans":[{"id":"spn-46931","text":"GoalGraph"}]}],"id":"blk-41778","kind":"list-item"},{"blocks":[{"id":"blk-41781","kind":"paragraph","spans":[{"id":"spn-46932","text":"Attention"}]}],"id":"blk-41780","kind":"list-item"},{"blocks":[{"id":"blk-41783","kind":"paragraph","spans":[{"id":"spn-46933","text":"Consolidator"}]}],"id":"blk-41782","kind":"list-item"},{"blocks":[{"id":"blk-41785","kind":"paragraph","spans":[{"id":"spn-46934","text":"MCP registry/server plumbing"}]}],"id":"blk-41784","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41786","kind":"heading","level":3,"spans":[{"id":"spn-46935","text":"What happens at startup"}]},{"id":"blk-41787","items":[{"blocks":[{"id":"blk-41789","kind":"paragraph","spans":[{"id":"spn-46936","text":"Store opens the SQLite database."}]}],"id":"blk-41788","kind":"list-item"},{"blocks":[{"id":"blk-41791","kind":"paragraph","spans":[{"id":"spn-46937","text":"Schema/migrations are applied."}]}],"id":"blk-41790","kind":"list-item"},{"blocks":[{"id":"blk-41793","kind":"paragraph","spans":[{"id":"spn-46938","text":"ETS hot cache is rebuilt from durable state."}]}],"id":"blk-41792","kind":"list-item"},{"blocks":[{"id":"blk-41795","kind":"paragraph","spans":[{"id":"spn-46939","text":"Core services come online and MCP tools/resources are exposed."}]}],"id":"blk-41794","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41796","kind":"heading","level":3,"spans":[{"id":"spn-46940","text":"Why this matters"}]},{"id":"blk-41797","kind":"paragraph","spans":[{"id":"spn-46941","text":"You get:"}]},{"id":"blk-41798","items":[{"blocks":[{"id":"blk-41800","kind":"paragraph","spans":[{"id":"spn-46942","text":"fast reads (ETS)"}]}],"id":"blk-41799","kind":"list-item"},{"blocks":[{"id":"blk-41802","kind":"paragraph","spans":[{"id":"spn-46943","text":"durable writes (SQLite)"}]}],"id":"blk-41801","kind":"list-item"},{"blocks":[{"id":"blk-41804","kind":"paragraph","spans":[{"id":"spn-46944","text":"process-level fault isolation (OTP supervision)"}]}],"id":"blk-41803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41805","kind":"paragraph","spans":[{"id":"spn-46945","text":"---"}]},{"id":"blk-41806","kind":"heading","level":2,"spans":[{"id":"spn-46946","text":"2) MCP Session Entry"}]},{"id":"blk-41807","kind":"paragraph","spans":[{"id":"spn-46947","text":"Most integrations begin through MCP over stdio."}]},{"id":"blk-41808","kind":"paragraph","spans":[{"id":"spn-46948","text":"Typical first checks:"}]},{"id":"blk-41809","items":[{"blocks":[{"id":"blk-41811","kind":"paragraph","spans":[{"id":"spn-46949","text":"Runtime health snapshot"}]}],"id":"blk-41810","kind":"list-item"},{"blocks":[{"id":"blk-41813","kind":"paragraph","spans":[{"id":"spn-46950","text":"Goal snapshot"}]}],"id":"blk-41812","kind":"list-item"},{"blocks":[{"id":"blk-41815","kind":"paragraph","spans":[{"id":"spn-46951","text":"Lightweight context retrieval for the current task"}]}],"id":"blk-41814","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41816","kind":"paragraph","spans":[{"id":"spn-46952","text":"This gives the agent session orientation before making changes."}]},{"id":"blk-41817","kind":"paragraph","spans":[{"id":"spn-46953","text":"---"}]},{"id":"blk-41818","kind":"heading","level":2,"spans":[{"id":"spn-46954","text":"3) Retrieval Path (Context Before Action)"}]},{"id":"blk-41819","kind":"paragraph","spans":[{"id":"spn-46955","text":"Graphonomous retrieval is not only semantic similarity. It combines:"}]},{"id":"blk-41820","kind":"paragraph","spans":[{"id":"spn-46956","text":"1. embedding similarity search 2. graph-neighbor expansion 3. confidence-aware ranking 4. topology analysis (SCC/κ routing metadata)"}]},{"id":"blk-41821","kind":"heading","level":3,"spans":[{"id":"spn-46957","text":"Retrieval output you should pay attention to"}]},{"id":"blk-41822","items":[{"blocks":[{"id":"blk-41824","kind":"paragraph","spans":[{"id":"spn-46958","marks":["code"],"text":"results"},{"id":"spn-46959","text":": ranked candidate context nodes"}]}],"id":"blk-41823","kind":"list-item"},{"blocks":[{"id":"blk-41826","kind":"paragraph","spans":[{"id":"spn-46960","marks":["code"],"text":"causal_context"},{"id":"spn-46961","text":": node IDs used later for outcome learning"}]}],"id":"blk-41825","kind":"list-item"},{"blocks":[{"id":"blk-41828","kind":"paragraph","spans":[{"id":"spn-46962","marks":["code"],"text":"topology.routing"},{"id":"spn-46963","text":": "},{"id":"spn-46964","marks":["code"],"text":"fast"},{"id":"spn-46965","text":" or "},{"id":"spn-46966","marks":["code"],"text":"deliberate"}]}],"id":"blk-41827","kind":"list-item"},{"blocks":[{"id":"blk-41830","kind":"paragraph","spans":[{"id":"spn-46967","marks":["code"],"text":"topology.max_kappa"},{"id":"spn-46968","text":": cycle complexity signal"}]}],"id":"blk-41829","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41831","kind":"heading","level":3,"spans":[{"id":"spn-46969","text":"Routing behavior"}]},{"id":"blk-41832","items":[{"blocks":[{"id":"blk-41834","kind":"paragraph","spans":[{"id":"spn-46970","marks":["bold"],"text":"fast"},{"id":"spn-46971","text":": proceed with normal reasoning"}]}],"id":"blk-41833","kind":"list-item"},{"blocks":[{"id":"blk-41836","kind":"paragraph","spans":[{"id":"spn-46972","marks":["bold"],"text":"deliberate"},{"id":"spn-46973","text":": use deeper deliberation for cyclic/conflicting regions"}]}],"id":"blk-41835","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41837","kind":"paragraph","spans":[{"id":"spn-46974","text":"---"}]},{"id":"blk-41838","kind":"heading","level":2,"spans":[{"id":"spn-46975","text":"4) Acting and Writing Memory"}]},{"id":"blk-41839","kind":"paragraph","spans":[{"id":"spn-46976","text":"After retrieval, the agent reasons and executes work. New durable knowledge should be stored in atomic form."}]},{"id":"blk-41840","kind":"heading","level":3,"spans":[{"id":"spn-46977","text":"Node types"}]},{"id":"blk-41841","items":[{"blocks":[{"id":"blk-41843","kind":"paragraph","spans":[{"id":"spn-46978","marks":["code"],"text":"semantic"},{"id":"spn-46979","text":": facts/architecture"}]}],"id":"blk-41842","kind":"list-item"},{"blocks":[{"id":"blk-41845","kind":"paragraph","spans":[{"id":"spn-46980","marks":["code"],"text":"procedural"},{"id":"spn-46981","text":": how-to/workflows"}]}],"id":"blk-41844","kind":"list-item"},{"blocks":[{"id":"blk-41847","kind":"paragraph","spans":[{"id":"spn-46982","marks":["code"],"text":"episodic"},{"id":"spn-46983","text":": observed events or session outcomes"}]}],"id":"blk-41846","kind":"list-item"},{"blocks":[{"id":"blk-41849","kind":"paragraph","spans":[{"id":"spn-46984","marks":["code"],"text":"temporal"},{"id":"spn-46985","text":": time-indexed observations, monitoring events"}]}],"id":"blk-41848","kind":"list-item"},{"blocks":[{"id":"blk-41851","kind":"paragraph","spans":[{"id":"spn-46986","marks":["code"],"text":"outcome"},{"id":"spn-46987","text":": empirical results of actions (grounding)"}]}],"id":"blk-41850","kind":"list-item"},{"blocks":[{"id":"blk-41853","kind":"paragraph","spans":[{"id":"spn-46988","marks":["code"],"text":"goal"},{"id":"spn-46989","text":": durable intent, objectives, targets"}]}],"id":"blk-41852","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41854","kind":"heading","level":3,"spans":[{"id":"spn-46990","text":"Good storage discipline"}]},{"id":"blk-41855","items":[{"blocks":[{"id":"blk-41857","kind":"paragraph","spans":[{"id":"spn-46991","text":"one claim/procedure/event per node"}]}],"id":"blk-41856","kind":"list-item"},{"blocks":[{"id":"blk-41859","kind":"paragraph","spans":[{"id":"spn-46992","text":"realistic confidence values"}]}],"id":"blk-41858","kind":"list-item"},{"blocks":[{"id":"blk-41861","kind":"paragraph","spans":[{"id":"spn-46993","text":"source attribution when possible"}]}],"id":"blk-41860","kind":"list-item"},{"blocks":[{"id":"blk-41863","kind":"paragraph","spans":[{"id":"spn-46994","text":"edges only when relationship quality justifies it"}]}],"id":"blk-41862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41864","kind":"paragraph","spans":[{"id":"spn-46995","text":"---"}]},{"id":"blk-41865","kind":"heading","level":2,"spans":[{"id":"spn-46996","text":"5) Closed-Loop Learning (Outcome Feedback)"}]},{"id":"blk-41866","kind":"paragraph","spans":[{"id":"spn-46997","text":"After a meaningful action, Graphonomous can update confidence on the causal nodes that informed that action."}]},{"id":"blk-41867","kind":"heading","level":3,"spans":[{"id":"spn-46998","text":"Learning inputs"}]},{"id":"blk-41868","items":[{"blocks":[{"id":"blk-41870","kind":"paragraph","spans":[{"id":"spn-46999","marks":["code"],"text":"action_id"}]}],"id":"blk-41869","kind":"list-item"},{"blocks":[{"id":"blk-41872","kind":"paragraph","spans":[{"id":"spn-47000","marks":["code"],"text":"status"},{"id":"spn-47001","text":" ("},{"id":"spn-47002","marks":["code"],"text":"success"},{"id":"spn-47003","text":", "},{"id":"spn-47004","marks":["code"],"text":"partial_success"},{"id":"spn-47005","text":", "},{"id":"spn-47006","marks":["code"],"text":"failure"},{"id":"spn-47007","text":", "},{"id":"spn-47008","marks":["code"],"text":"timeout"},{"id":"spn-47009","text":")"}]}],"id":"blk-41871","kind":"list-item"},{"blocks":[{"id":"blk-41874","kind":"paragraph","spans":[{"id":"spn-47010","text":"outcome "},{"id":"spn-47011","marks":["code"],"text":"confidence"}]}],"id":"blk-41873","kind":"list-item"},{"blocks":[{"id":"blk-41876","kind":"paragraph","spans":[{"id":"spn-47012","marks":["code"],"text":"causal_node_ids"},{"id":"spn-47013","text":" (from retrieval causal context)"}]}],"id":"blk-41875","kind":"list-item"},{"blocks":[{"id":"blk-41878","kind":"paragraph","spans":[{"id":"spn-47014","text":"optional evidence/trace metadata"}]}],"id":"blk-41877","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41879","kind":"heading","level":3,"spans":[{"id":"spn-47015","text":"Confidence update model"}]},{"id":"blk-41880","kind":"paragraph","spans":[{"id":"spn-47016","text":"Learner applies a bounded, learning-rate blend from prior confidence and status-scaled signal, so graph trust adapts over time."}]},{"id":"blk-41881","kind":"heading","level":3,"spans":[{"id":"spn-47017","text":"Practical effect"}]},{"id":"blk-41882","items":[{"blocks":[{"id":"blk-41884","kind":"paragraph","spans":[{"id":"spn-47018","text":"useful nodes get reinforced"}]}],"id":"blk-41883","kind":"list-item"},{"blocks":[{"id":"blk-41886","kind":"paragraph","spans":[{"id":"spn-47019","text":"weak/wrong assumptions are down-weighted"}]}],"id":"blk-41885","kind":"list-item"},{"blocks":[{"id":"blk-41888","kind":"paragraph","spans":[{"id":"spn-47020","text":"retrieval quality improves across sessions"}]}],"id":"blk-41887","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41889","kind":"paragraph","spans":[{"id":"spn-47021","text":"---"}]},{"id":"blk-41890","kind":"heading","level":2,"spans":[{"id":"spn-47022","text":"6) GoalGraph and Coverage Gate"}]},{"id":"blk-41891","kind":"paragraph","spans":[{"id":"spn-47023","text":"For multi-step work, goals provide durable intent and lifecycle management."}]},{"id":"blk-41892","kind":"heading","level":3,"spans":[{"id":"spn-47024","text":"Goal lifecycle examples"}]},{"id":"blk-41893","items":[{"blocks":[{"id":"blk-41895","kind":"paragraph","spans":[{"id":"spn-47025","marks":["code"],"text":"proposed"},{"id":"spn-47026","text":" -> "},{"id":"spn-47027","marks":["code"],"text":"active"},{"id":"spn-47028","text":" -> "},{"id":"spn-47029","marks":["code"],"text":"completed"}]}],"id":"blk-41894","kind":"list-item"},{"blocks":[{"id":"blk-41897","kind":"paragraph","spans":[