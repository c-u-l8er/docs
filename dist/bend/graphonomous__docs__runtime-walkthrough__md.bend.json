{"bendscript":"0.1","blocks":[{"id":"blk-42732","kind":"heading","level":1,"spans":[{"id":"spn-49200","text":"Runtime Walkthrough"}]},{"id":"blk-42733","kind":"paragraph","spans":[{"id":"spn-49201","text":"This page walks through the Graphonomous runtime from process startup to closed-loop learning, goal review, and maintenance."}]},{"id":"blk-42734","kind":"paragraph","spans":[{"id":"spn-49202","text":"If you want a practical mental model, think in this sequence:"}]},{"id":"blk-42735","kind":"paragraph","spans":[{"id":"spn-49203","text":"1. "},{"id":"spn-49204","marks":["bold"],"text":"Boot services"},{"id":"spn-49205","text":" 2. "},{"id":"spn-49206","marks":["bold"],"text":"Retrieve context"},{"id":"spn-49207","text":" 3. "},{"id":"spn-49208","marks":["bold"],"text":"Act"},{"id":"spn-49209","text":" 4. "},{"id":"spn-49210","marks":["bold"],"text":"Store durable knowledge"},{"id":"spn-49211","text":" 5. "},{"id":"spn-49212","marks":["bold"],"text":"Learn from outcomes"},{"id":"spn-49213","text":" 6. "},{"id":"spn-49214","marks":["bold"],"text":"Review goal coverage"},{"id":"spn-49215","text":" 7. "},{"id":"spn-49216","marks":["bold"],"text":"Run consolidation"}]},{"id":"blk-42736","kind":"paragraph","spans":[{"id":"spn-49217","text":"---"}]},{"id":"blk-42737","kind":"heading","level":2,"spans":[{"id":"spn-49218","text":"1) Boot and Supervision"}]},{"id":"blk-42738","kind":"paragraph","spans":[{"id":"spn-49219","text":"Graphonomous runs as an OTP application with supervised runtime components:"}]},{"id":"blk-42739","items":[{"blocks":[{"id":"blk-42741","kind":"paragraph","spans":[{"id":"spn-49220","text":"Store"}]}],"id":"blk-42740","kind":"list-item"},{"blocks":[{"id":"blk-42743","kind":"paragraph","spans":[{"id":"spn-49221","text":"Embedder"}]}],"id":"blk-42742","kind":"list-item"},{"blocks":[{"id":"blk-42745","kind":"paragraph","spans":[{"id":"spn-49222","text":"Graph"}]}],"id":"blk-42744","kind":"list-item"},{"blocks":[{"id":"blk-42747","kind":"paragraph","spans":[{"id":"spn-49223","text":"Retriever"}]}],"id":"blk-42746","kind":"list-item"},{"blocks":[{"id":"blk-42749","kind":"paragraph","spans":[{"id":"spn-49224","text":"Learner"}]}],"id":"blk-42748","kind":"list-item"},{"blocks":[{"id":"blk-42751","kind":"paragraph","spans":[{"id":"spn-49225","text":"GoalGraph"}]}],"id":"blk-42750","kind":"list-item"},{"blocks":[{"id":"blk-42753","kind":"paragraph","spans":[{"id":"spn-49226","text":"Attention"}]}],"id":"blk-42752","kind":"list-item"},{"blocks":[{"id":"blk-42755","kind":"paragraph","spans":[{"id":"spn-49227","text":"Consolidator"}]}],"id":"blk-42754","kind":"list-item"},{"blocks":[{"id":"blk-42757","kind":"paragraph","spans":[{"id":"spn-49228","text":"MCP registry/server plumbing"}]}],"id":"blk-42756","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42758","kind":"heading","level":3,"spans":[{"id":"spn-49229","text":"What happens at startup"}]},{"id":"blk-42759","items":[{"blocks":[{"id":"blk-42761","kind":"paragraph","spans":[{"id":"spn-49230","text":"Store opens the SQLite database."}]}],"id":"blk-42760","kind":"list-item"},{"blocks":[{"id":"blk-42763","kind":"paragraph","spans":[{"id":"spn-49231","text":"Schema/migrations are applied."}]}],"id":"blk-42762","kind":"list-item"},{"blocks":[{"id":"blk-42765","kind":"paragraph","spans":[{"id":"spn-49232","text":"ETS hot cache is rebuilt from durable state."}]}],"id":"blk-42764","kind":"list-item"},{"blocks":[{"id":"blk-42767","kind":"paragraph","spans":[{"id":"spn-49233","text":"Core services come online and MCP tools/resources are exposed."}]}],"id":"blk-42766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42768","kind":"heading","level":3,"spans":[{"id":"spn-49234","text":"Why this matters"}]},{"id":"blk-42769","kind":"paragraph","spans":[{"id":"spn-49235","text":"You get:"}]},{"id":"blk-42770","items":[{"blocks":[{"id":"blk-42772","kind":"paragraph","spans":[{"id":"spn-49236","text":"fast reads (ETS)"}]}],"id":"blk-42771","kind":"list-item"},{"blocks":[{"id":"blk-42774","kind":"paragraph","spans":[{"id":"spn-49237","text":"durable writes (SQLite)"}]}],"id":"blk-42773","kind":"list-item"},{"blocks":[{"id":"blk-42776","kind":"paragraph","spans":[{"id":"spn-49238","text":"process-level fault isolation (OTP supervision)"}]}],"id":"blk-42775","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42777","kind":"paragraph","spans":[{"id":"spn-49239","text":"---"}]},{"id":"blk-42778","kind":"heading","level":2,"spans":[{"id":"spn-49240","text":"2) MCP Session Entry"}]},{"id":"blk-42779","kind":"paragraph","spans":[{"id":"spn-49241","text":"Most integrations begin through MCP over stdio."}]},{"id":"blk-42780","kind":"paragraph","spans":[{"id":"spn-49242","text":"Typical first checks:"}]},{"id":"blk-42781","items":[{"blocks":[{"id":"blk-42783","kind":"paragraph","spans":[{"id":"spn-49243","text":"Runtime health snapshot"}]}],"id":"blk-42782","kind":"list-item"},{"blocks":[{"id":"blk-42785","kind":"paragraph","spans":[{"id":"spn-49244","text":"Goal snapshot"}]}],"id":"blk-42784","kind":"list-item"},{"blocks":[{"id":"blk-42787","kind":"paragraph","spans":[{"id":"spn-49245","text":"Lightweight context retrieval for the current task"}]}],"id":"blk-42786","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42788","kind":"paragraph","spans":[{"id":"spn-49246","text":"This gives the agent session orientation before making changes."}]},{"id":"blk-42789","kind":"paragraph","spans":[{"id":"spn-49247","text":"---"}]},{"id":"blk-42790","kind":"heading","level":2,"spans":[{"id":"spn-49248","text":"3) Retrieval Path (Context Before Action)"}]},{"id":"blk-42791","kind":"paragraph","spans":[{"id":"spn-49249","text":"Graphonomous retrieval is not only semantic similarity. It combines:"}]},{"id":"blk-42792","kind":"paragraph","spans":[{"id":"spn-49250","text":"1. embedding similarity search 2. graph-neighbor expansion 3. confidence-aware ranking 4. topology analysis (SCC/κ routing metadata)"}]},{"id":"blk-42793","kind":"heading","level":3,"spans":[{"id":"spn-49251","text":"Retrieval output you should pay attention to"}]},{"id":"blk-42794","items":[{"blocks":[{"id":"blk-42796","kind":"paragraph","spans":[{"id":"spn-49252","marks":["code"],"text":"results"},{"id":"spn-49253","text":": ranked candidate context nodes"}]}],"id":"blk-42795","kind":"list-item"},{"blocks":[{"id":"blk-42798","kind":"paragraph","spans":[{"id":"spn-49254","marks":["code"],"text":"causal_context"},{"id":"spn-49255","text":": node IDs used later for outcome learning"}]}],"id":"blk-42797","kind":"list-item"},{"blocks":[{"id":"blk-42800","kind":"paragraph","spans":[{"id":"spn-49256","marks":["code"],"text":"topology.routing"},{"id":"spn-49257","text":": "},{"id":"spn-49258","marks":["code"],"text":"fast"},{"id":"spn-49259","text":" or "},{"id":"spn-49260","marks":["code"],"text":"deliberate"}]}],"id":"blk-42799","kind":"list-item"},{"blocks":[{"id":"blk-42802","kind":"paragraph","spans":[{"id":"spn-49261","marks":["code"],"text":"topology.max_kappa"},{"id":"spn-49262","text":": cycle complexity signal"}]}],"id":"blk-42801","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42803","kind":"heading","level":3,"spans":[{"id":"spn-49263","text":"Routing behavior"}]},{"id":"blk-42804","items":[{"blocks":[{"id":"blk-42806","kind":"paragraph","spans":[{"id":"spn-49264","marks":["bold"],"text":"fast"},{"id":"spn-49265","text":": proceed with normal reasoning"}]}],"id":"blk-42805","kind":"list-item"},{"blocks":[{"id":"blk-42808","kind":"paragraph","spans":[{"id":"spn-49266","marks":["bold"],"text":"deliberate"},{"id":"spn-49267","text":": use deeper deliberation for cyclic/conflicting regions"}]}],"id":"blk-42807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42809","kind":"paragraph","spans":[{"id":"spn-49268","text":"---"}]},{"id":"blk-42810","kind":"heading","level":2,"spans":[{"id":"spn-49269","text":"4) Acting and Writing Memory"}]},{"id":"blk-42811","kind":"paragraph","spans":[{"id":"spn-49270","text":"After retrieval, the agent reasons and executes work. New durable knowledge should be stored in atomic form."}]},{"id":"blk-42812","kind":"heading","level":3,"spans":[{"id":"spn-49271","text":"Node types"}]},{"id":"blk-42813","items":[{"blocks":[{"id":"blk-42815","kind":"paragraph","spans":[{"id":"spn-49272","marks":["code"],"text":"semantic"},{"id":"spn-49273","text":": facts/architecture"}]}],"id":"blk-42814","kind":"list-item"},{"blocks":[{"id":"blk-42817","kind":"paragraph","spans":[{"id":"spn-49274","marks":["code"],"text":"procedural"},{"id":"spn-49275","text":": how-to/workflows"}]}],"id":"blk-42816","kind":"list-item"},{"blocks":[{"id":"blk-42819","kind":"paragraph","spans":[{"id":"spn-49276","marks":["code"],"text":"episodic"},{"id":"spn-49277","text":": observed events or session outcomes"}]}],"id":"blk-42818","kind":"list-item"},{"blocks":[{"id":"blk-42821","kind":"paragraph","spans":[{"id":"spn-49278","marks":["code"],"text":"temporal"},{"id":"spn-49279","text":": time-indexed observations, monitoring events"}]}],"id":"blk-42820","kind":"list-item"},{"blocks":[{"id":"blk-42823","kind":"paragraph","spans":[{"id":"spn-49280","marks":["code"],"text":"outcome"},{"id":"spn-49281","text":": empirical results of actions (grounding)"}]}],"id":"blk-42822","kind":"list-item"},{"blocks":[{"id":"blk-42825","kind":"paragraph","spans":[{"id":"spn-49282","marks":["code"],"text":"goal"},{"id":"spn-49283","text":": durable intent, objectives, targets"}]}],"id":"blk-42824","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42826","kind":"heading","level":3,"spans":[{"id":"spn-49284","text":"Good storage discipline"}]},{"id":"blk-42827","items":[{"blocks":[{"id":"blk-42829","kind":"paragraph","spans":[{"id":"spn-49285","text":"one claim/procedure/event per node"}]}],"id":"blk-42828","kind":"list-item"},{"blocks":[{"id":"blk-42831","kind":"paragraph","spans":[{"id":"spn-49286","text":"realistic confidence values"}]}],"id":"blk-42830","kind":"list-item"},{"blocks":[{"id":"blk-42833","kind":"paragraph","spans":[{"id":"spn-49287","text":"source attribution when possible"}]}],"id":"blk-42832","kind":"list-item"},{"blocks":[{"id":"blk-42835","kind":"paragraph","spans":[{"id":"spn-49288","text":"edges only when relationship quality justifies it"}]}],"id":"blk-42834","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42836","kind":"paragraph","spans":[{"id":"spn-49289","text":"---"}]},{"id":"blk-42837","kind":"heading","level":2,"spans":[{"id":"spn-49290","text":"5) Closed-Loop Learning (Outcome Feedback)"}]},{"id":"blk-42838","kind":"paragraph","spans":[{"id":"spn-49291","text":"After a meaningful action, Graphonomous can update confidence on the causal nodes that informed that action."}]},{"id":"blk-42839","kind":"heading","level":3,"spans":[{"id":"spn-49292","text":"Learning inputs"}]},{"id":"blk-42840","items":[{"blocks":[{"id":"blk-42842","kind":"paragraph","spans":[{"id":"spn-49293","marks":["code"],"text":"action_id"}]}],"id":"blk-42841","kind":"list-item"},{"blocks":[{"id":"blk-42844","kind":"paragraph","spans":[{"id":"spn-49294","marks":["code"],"text":"status"},{"id":"spn-49295","text":" ("},{"id":"spn-49296","marks":["code"],"text":"success"},{"id":"spn-49297","text":", "},{"id":"spn-49298","marks":["code"],"text":"partial_success"},{"id":"spn-49299","text":", "},{"id":"spn-49300","marks":["code"],"text":"failure"},{"id":"spn-49301","text":", "},{"id":"spn-49302","marks":["code"],"text":"timeout"},{"id":"spn-49303","text":")"}]}],"id":"blk-42843","kind":"list-item"},{"blocks":[{"id":"blk-42846","kind":"paragraph","spans":[{"id":"spn-49304","text":"outcome "},{"id":"spn-49305","marks":["code"],"text":"confidence"}]}],"id":"blk-42845","kind":"list-item"},{"blocks":[{"id":"blk-42848","kind":"paragraph","spans":[{"id":"spn-49306","marks":["code"],"text":"causal_node_ids"},{"id":"spn-49307","text":" (from retrieval causal context)"}]}],"id":"blk-42847","kind":"list-item"},{"blocks":[{"id":"blk-42850","kind":"paragraph","spans":[{"id":"spn-49308","text":"optional evidence/trace metadata"}]}],"id":"blk-42849","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42851","kind":"heading","level":3,"spans":[{"id":"spn-49309","text":"Confidence update model"}]},{"id":"blk-42852","kind":"paragraph","spans":[{"id":"spn-49310","text":"Learner applies a bounded, learning-rate blend from prior confidence and status-scaled signal, so graph trust adapts over time."}]},{"id":"blk-42853","kind":"heading","level":3,"spans":[{"id":"spn-49311","text":"Practical effect"}]},{"id":"blk-42854","items":[{"blocks":[{"id":"blk-42856","kind":"paragraph","spans":[{"id":"spn-49312","text":"useful nodes get reinforced"}]}],"id":"blk-42855","kind":"list-item"},{"blocks":[{"id":"blk-42858","kind":"paragraph","spans":[{"id":"spn-49313","text":"weak/wrong assumptions are down-weighted"}]}],"id":"blk-42857","kind":"list-item"},{"blocks":[{"id":"blk-42860","kind":"paragraph","spans":[{"id":"spn-49314","text":"retrieval quality improves across sessions"}]}],"id":"blk-42859","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42861","kind":"paragraph","spans":[{"id":"spn-49315","text":"---"}]},{"id":"blk-42862","kind":"heading","level":2,"spans":[{"id":"spn-49316","text":"6) GoalGraph and Coverage Gate"}]},{"id":"blk-42863","kind":"paragraph","spans":[{"id":"spn-49317","text":"For multi-step work, goals provide durable intent and lifecycle management."}]},{"id":"blk-42864","kind":"heading","level":3,"spans":[{"id":"spn-49318","text":"Goal lifecycle examples"}]},{"id":"blk-42865","items":[{"blocks":[{"id":"blk-42867","kind":"paragraph","spans":[{"id":"spn-49319","marks":["code"],"text":"proposed"},{"id":"spn-49320","text":" -> "},{"id":"spn-49321","marks":["code"],"text":"active"},{"id":"spn-49322","text":" -> "},{"id":"spn-49323","marks":["code"],"text":"completed"}]}],"id":"blk-42866","kind":"list-item"},{"blocks":[{"id":"blk-42869","kind":"paragraph","spans":[{"id":"spn-49324","marks":["code"],"text":"active"},{"id":"spn-49325","text":" -> "},{"id":"spn-49326","marks":["code"],"text":"blocked"},{"id":"spn-49327","text":" (if escalation needed)"}]}],"id":"blk-42868","kind":"list-item"},{"blocks":[{"id":"blk-42871","kind":"paragraph","spans":[{"id":"spn-49328","text":"optional pause/abandon transitions as policy requires"}]}],"id":"blk-42870","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42872","kind":"heading","level":3,"spans":[{"id":"spn-49329","text":"Coverage review"}]},{"id":"blk-42873","kind":"paragraph","spans":[{"id":"spn-49330","text":"Coverage computes:"}]},{"id":"blk-42874","items":[{"blocks":[{"id":"blk-42876","kind":"paragraph","spans":[{"id":"spn-49331","marks":["code"],"text":"coverage_score"}]}],"id":"blk-42875","kind":"list-item"},{"blocks":[{"id":"blk-42878","kind":"paragraph","spans":[{"id":"spn-49332","marks":["code"],"text":"uncertainty_score"}]}],"id":"blk-42877","kind":"list-item"},{"blocks":[{"id":"blk-42880","kind":"paragraph","spans":[{"id":"spn-49333","marks":["code"],"text":"risk_score"}]}],"id":"blk-42879","kind":"list-item"},{"blocks":[{"id":"blk-42882","kind":"paragraph","spans":[{"id":"spn-49334","text":"decision: "},{"id":"spn-49335","marks":["code"],"text":"act"},{"id":"spn-49336","text":" | "},{"id":"spn-49337","marks":["code"],"text":"learn"},{"id":"spn-49338","text":" | "},{"id":"spn-49339","marks":["code"],"text":"escalate"}]}],"id":"blk-42881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42883","kind":"paragraph","spans":[{"id":"spn-49340","text":"This lets the runtime gate actions based on epistemic readiness, not just availability of any context."}]},{"id":"blk-42884","kind":"paragraph","spans":[{"id":"spn-49341","text":"---"}]},{"id":"blk-42885","kind":"heading","level":2,"spans":[{"id":"spn-49342","text":"7) Attention Loop (Prioritization Across Goals)"}]},{"id":"blk-42886","kind":"paragraph","spans":[{"id":"spn-49343","text":"When many goals are in flight, attention can survey and rank what needs focus."}]},{"id":"blk-42887","kind":"paragraph","spans":[{"id":"spn-49344","text":"Autonomy modes:"}]},{"id":"blk-42888","items":[{"blocks":[{"id":"blk-42890","kind":"paragraph","spans":[{"id":"spn-49345","marks":["code"],"text":"observe"},{"id":"spn-49346","text":" (read-only prioritization)"}]}],"id":"blk-42889","kind":"list-item"},{"blocks":[{"id":"blk-42892","kind":"paragraph","spans":[{"id":"spn-49347","marks":["code"],"text":"advise"},{"id":"spn-49348","text":" (recommend actions)"}]}],"id":"blk-42891","kind":"list-item"},{"blocks":[{"id":"blk-42894","kind":"paragraph","spans":[{"id":"spn-49349","marks":["code"],"text":"act"},{"id":"spn-49350","text":" (dispatch bounded actions)"}]}],"id":"blk-42893","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42895","kind":"paragraph","spans":[{"id":"spn-49351","text":"Attention combines urgency, coverage state, and topology complexity to prioritize execution."}]},{"id":"blk-42896","kind":"paragraph","spans":[{"id":"spn-49352","text":"---"}]},{"id":"blk-42897","kind":"heading","level":2,"spans":[{"id":"spn-49353","text":"8) Consolidation Cycle (Memory Maintenance)"}]},{"id":"blk-42898","kind":"paragraph","spans":[{"id":"spn-49354","text":"Consolidation keeps memory quality healthy over time."}]},{"id":"blk-42899","kind":"paragraph","spans":[{"id":"spn-49355","text":"The 7-stage pipeline includes:"}]},{"id":"blk-42900","kind":"paragraph","spans":[{"id":"spn-49356","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-42901","kind":"paragraph","spans":[{"id":"spn-49357","text":"Operationally, run consolidation:"}]},{"id":"blk-42902","items":[{"blocks":[{"id":"blk-42904","kind":"paragraph","spans":[{"id":"spn-49358","text":"at session boundaries"}]}],"id":"blk-42903","kind":"list-item"},{"blocks":[{"id":"blk-42906","kind":"paragraph","spans":[{"id":"spn-49359","text":"after heavy write bursts"}]}],"id":"blk-42905","kind":"list-item"},{"blocks":[{"id":"blk-42908","kind":"paragraph","spans":[{"id":"spn-49360","text":"periodically during long autonomous loops"}]}],"id":"blk-42907","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42909","kind":"paragraph","spans":[{"id":"spn-49361","text":"---"}]},{"id":"blk-42910","kind":"heading","level":2,"spans":[{"id":"spn-49362","text":"9) End-to-End Example Walkthrough"}]},{"id":"blk-42911","kind":"paragraph","spans":[{"id":"spn-49363","text":"A complete interaction often looks like this:"}]},{"id":"blk-42912","kind":"paragraph","spans":[{"id":"spn-49364","text":"1. Agent retrieves context for user task. 2. Runtime returns ranked results + causal context + topology signal. 3. Agent performs work and returns output. 4. Agent stores key new semantic/procedural/episodic nodes. 5. Agent reports outcome against causal nodes. 6. Goal progress is updated. 7. Coverage is reviewed before next consequential step. 8. Consolidation runs to maintain graph quality."}]},{"id":"blk-42913","kind":"paragraph","spans":[{"id":"spn-49365","text":"---"}]},{"id":"blk-42914","kind":"heading","level":2,"spans":[{"id":"spn-49366","text":"10) Operational Checklist"}]},{"id":"blk-42915","kind":"paragraph","spans":[{"id":"spn-49367","text":"Before ending a productive session:"}]},{"id":"blk-42916","items":[{"blocks":[{"id":"blk-42918","kind":"paragraph","spans":[{"id":"spn-49368","text":"[ ] Store key durable knowledge"}]}],"id":"blk-42917","kind":"list-item"},{"blocks":[{"id":"blk-42920","kind":"paragraph","spans":[{"id":"spn-49369","text":"[ ] Report outcomes for consequential actions"}]}],"id":"blk-42919","kind":"list-item"},{"blocks":[{"id":"blk-42922","kind":"paragraph","spans":[{"id":"spn-49370","text":"[ ] Update linked goals/progress/status"}]}],"id":"blk-42921","kind":"list-item"},{"blocks":[{"id":"blk-42924","kind":"paragraph","spans":[{"id":"spn-49371","text":"[ ] Trigger or verify consolidation"}]}],"id":"blk-42923","kind":"list-item"},{"blocks":[{"id":"blk-42926","kind":"paragraph","spans":[{"id":"spn-49372","text":"[ ] Confirm runtime remains healthy"}]}],"id":"blk-42925","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42927","kind":"paragraph","spans":[{"id":"spn-49373","text":"---"}]},{"id":"blk-42928","kind":"heading","level":2,"spans":[{"id":"spn-49374","text":"11) Common Failure Patterns to Avoid"}]},{"id":"blk-42929","items":[{"blocks":[{"id":"blk-42931","kind":"paragraph","spans":[{"id":"spn-49375","text":"skipping retrieval on non-trivial tasks"}]}],"id":"blk-42930","kind":"list-item"},{"blocks":[{"id":"blk-42933","kind":"paragraph","spans":[{"id":"spn-49376","text":"losing causal context before outcome reporting"}]}],"id":"blk-42932","kind":"list-item"},{"blocks":[{"id":"blk-42935","kind":"paragraph","spans":[{"id":"spn-49377","text":"inflating confidence without evidence"}]}],"id":"blk-42934","kind":"list-item"},{"blocks":[{"id":"blk-42937","kind":"paragraph","spans":[{"id":"spn-49378","text":"storing kitchen-sink nodes"}]}],"id":"blk-42936","kind":"list-item"},{"blocks":[{"id":"blk-42939","kind":"paragraph","spans":[{"id":"spn-49379","text":"fabricating coverage or outcome signals"}]}],"id":"blk-42938","kind":"list-item"},{"blocks":[{"id":"blk-42941","kind":"paragraph","spans":[{"id":"spn-49380","text":"ignoring repeated "},{"id":"spn-49381","marks":["code"],"text":"learn"},{"id":"spn-49382","text":"/"},{"id":"spn-49383","marks":["code"],"text":"escalate"},{"id":"spn-49384","text":" routing"}]}],"id":"blk-42940","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42942","kind":"paragraph","spans":[{"id":"spn-49385","text":"---"}]},{"id":"blk-42943","kind":"heading","level":2,"spans":[{"id":"spn-49386","text":"12) Suggested Next Reads"}]},{"id":"blk-42944","items":[{"blocks":[{"id":"blk-42946","kind":"paragraph","spans":[{"id":"spn-49387","marks":["code"],"text":"quickstart"}]}],"id":"blk-42945","kind":"list-item"},{"blocks":[{"id":"blk-42948","kind":"paragraph","spans":[{"id":"spn-49388","marks":["code"],"text":"architecture"}]}],"id":"blk-42947","kind":"list-item"},{"blocks":[{"id":"blk-42950","kind":"paragraph","spans":[{"id":"spn-49389","marks":["code"],"text":"mcp-tools"}]}],"id":"blk-42949","kind":"list-item"},{"blocks":[{"id":"blk-42952","kind":"paragraph","spans":[{"id":"spn-49390","marks":["code"],"text":"operations"}]}],"id":"blk-42951","kind":"list-item"},{"blocks":[{"id":"blk-42954","kind":"paragraph","spans":[{"id":"spn-49391","marks":["code"],"text":"skills/SKILLS"}]}],"id":"blk-42953","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42955","kind":"paragraph","spans":[{"id":"spn-49392","text":"If you are integrating an autonomous agent, treat this walkthrough as the runtime backbone and the skills docs as strict operating policy."}]}],"edges":[],"id":"bagaaierauihrncm7yehs5sghwjxslufqxdetlkmz4oousm77us7vk7s4zoyq","vocabulary":"ampersand.docs.fs.v1"}