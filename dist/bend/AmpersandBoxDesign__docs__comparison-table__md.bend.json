{"bendscript":"0.1","blocks":[{"id":"blk-3844","kind":"heading","level":1,"spans":[{"id":"spn-3958","text":"[&] vs MCP vs A2A vs DALIA vs ACP"}]},{"id":"blk-3845","kind":"paragraph","spans":[{"id":"spn-3959","text":"This document positions the [&] Protocol relative to adjacent standards, research efforts, and ecosystem protocols."}]},{"id":"blk-3846","kind":"paragraph","spans":[{"id":"spn-3960","text":"The short version:"}]},{"id":"blk-3847","items":[{"blocks":[{"id":"blk-3849","kind":"paragraph","spans":[{"id":"spn-3961","marks":["bold"],"text":"MCP"},{"id":"spn-3962","text":" standardizes agent-to-tool connectivity."}]}],"id":"blk-3848","kind":"list-item"},{"blocks":[{"id":"blk-3851","kind":"paragraph","spans":[{"id":"spn-3963","marks":["bold"],"text":"A2A"},{"id":"spn-3964","text":" standardizes agent-to-agent coordination."}]}],"id":"blk-3850","kind":"list-item"},{"blocks":[{"id":"blk-3853","kind":"paragraph","spans":[{"id":"spn-3965","marks":["bold"],"text":"ACP"},{"id":"spn-3966","text":" standardizes lightweight agent communication over network APIs."}]}],"id":"blk-3852","kind":"list-item"},{"blocks":[{"id":"blk-3855","kind":"paragraph","spans":[{"id":"spn-3967","marks":["bold"],"text":"DALIA"},{"id":"spn-3968","text":" highlights the need for compositional intelligence architectures at the research level."}]}],"id":"blk-3854","kind":"list-item"},{"blocks":[{"id":"blk-3857","kind":"paragraph","spans":[{"id":"spn-3969","marks":["bold"],"text":"[&]"},{"id":"spn-3970","text":" defines the "},{"id":"spn-3971","marks":["bold"],"text":"capability composition layer"},{"id":"spn-3972","text":": how an agent declares, validates, binds, and governs its cognitive capabilities before compiling into runtime protocols."}]}],"id":"blk-3856","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-3858","kind":"paragraph","spans":[{"id":"spn-3973","text":"The right framing is not replacement, but composition:"}]},{"blocks":[{"id":"blk-3860","kind":"paragraph","spans":[{"id":"spn-3974","text":"[&] compiles into MCP + A2A configurations."}]}],"id":"blk-3859","kind":"quote"},{"id":"blk-3861","kind":"paragraph","spans":[{"id":"spn-3975","text":"---"}]},{"id":"blk-3862","kind":"heading","level":2,"spans":[{"id":"spn-3976","text":"Comparison Table"}]},{"head":[{"id":"blk-3864","spans":[{"id":"spn-3977","text":"System"}]},{"id":"blk-3865","spans":[{"id":"spn-3978","text":"Primary Scope"}]},{"id":"blk-3866","spans":[{"id":"spn-3979","text":"Layer in the Stack"}]},{"id":"blk-3867","spans":[{"id":"spn-3980","text":"Main Unit of Abstraction"}]},{"id":"blk-3868","spans":[{"id":"spn-3981","text":"What It Standardizes Well"}]},{"id":"blk-3869","spans":[{"id":"spn-3982","text":"What It Does "},{"id":"spn-3983","marks":["bold"],"text":"Not"},{"id":"spn-3984","text":" Standardize"}]},{"id":"blk-3870","spans":[{"id":"spn-3985","text":"Relationship to [&]"}]}],"id":"blk-3863","kind":"table","rows":[[{"id":"blk-3871","spans":[{"id":"spn-3986","marks":["bold"],"text":"[&] Protocol"}]},{"id":"blk-3872","spans":[{"id":"spn-3987","text":"Capability composition for agents"}]},{"id":"blk-3873","spans":[{"id":"spn-3988","text":"Composition"}]},{"id":"blk-3874","spans":[{"id":"spn-3989","text":"Capability declarations, contracts, provenance, governance"}]},{"id":"blk-3875","spans":[{"id":"spn-3990","text":"How memory, reasoning, time, space, and governance capabilities are declared, validated, composed, and compiled into downstream configs"}]},{"id":"blk-3876","spans":[{"id":"spn-3991","text":"Low-level transport protocols, direct tool RPC semantics, agent network communication"}]},{"id":"blk-3877","spans":[{"id":"spn-3992","text":"Source-of-truth layer"}]}],[{"id":"blk-3878","spans":[{"id":"spn-3993","marks":["bold"],"text":"MCP"}]},{"id":"blk-3879","spans":[{"id":"spn-3994","text":"Agent-to-tool connectivity"}]},{"id":"blk-3880","spans":[{"id":"spn-3995","text":"Context / Tooling"}]},{"id":"blk-3881","spans":[{"id":"spn-3996","text":"Tools, resources, prompts, client-server interaction"}]},{"id":"blk-3882","spans":[{"id":"spn-3997","text":"Tool discovery, tool invocation, structured context access, resource exposure"}]},{"id":"blk-3883","spans":[{"id":"spn-3998","text":"How an agent's cognitive capabilities are selected, composed, governed, or provenance-linked"}]},{"id":"blk-3884","spans":[{"id":"spn-3999","text":"[&] can generate MCP configuration"}]}],[{"id":"blk-3885","spans":[{"id":"spn-4000","marks":["bold"],"text":"A2A"}]},{"id":"blk-3886","spans":[{"id":"spn-4001","text":"Agent-to-agent coordination"}]},{"id":"blk-3887","spans":[{"id":"spn-4002","text":"Coordination"}]},{"id":"blk-3888","spans":[{"id":"spn-4003","text":"Agent cards, skills, tasks, delegation flows"}]},{"id":"blk-3889","spans":[{"id":"spn-4004","text":"Agent discovery, advertised skills, delegation and inter-agent interaction"}]},{"id":"blk-3890","spans":[{"id":"spn-4005","text":"How internal cognitive capabilities are composed or validated before publication"}]},{"id":"blk-3891","spans":[{"id":"spn-4006","text":"[&] can generate A2A agent cards"}]}],[{"id":"blk-3892","spans":[{"id":"spn-4007","marks":["bold"],"text":"ACP"}]},{"id":"blk-3893","spans":[{"id":"spn-4008","text":"Lightweight agent communication"}]},{"id":"blk-3894","spans":[{"id":"spn-4009","text":"Communication"}]},{"id":"blk-3895","spans":[{"id":"spn-4010","text":"HTTP/REST-style agent endpoints and message exchange"}]},{"id":"blk-3896","spans":[{"id":"spn-4011","text":"Inter-agent messaging and integration patterns over standard web infrastructure"}]},{"id":"blk-3897","spans":[{"id":"spn-4012","text":"Capability algebra, provenance semantics, governance-as-data, typed capability composition"}]},{"id":"blk-3898","spans":[{"id":"spn-4013","text":"Adjacent network protocol; [&] sits at a different concern boundary"}]}],[{"id":"blk-3899","spans":[{"id":"spn-4014","marks":["bold"],"text":"DALIA"}]},{"id":"blk-3900","spans":[{"id":"spn-4015","text":"Research framework for compositional intelligence"}]},{"id":"blk-3901","spans":[{"id":"spn-4016","text":"Research / Theory"}]},{"id":"blk-3902","spans":[{"id":"spn-4017","text":"Cognitive architecture model"}]},{"id":"blk-3903","spans":[{"id":"spn-4018","text":"Why modular, compositional agent intelligence matters; academic framing for layered capability systems"}]},{"id":"blk-3904","spans":[{"id":"spn-4019","text":"A production-ready protocol artifact, schema, CLI, registry, or runtime config format"}]},{"id":"blk-3905","spans":[{"id":"spn-4020","text":"Independent conceptual validation of the gap [&] addresses"}]}]]},{"id":"blk-3906","kind":"paragraph","spans":[{"id":"spn-4021","text":"---"}]},{"id":"blk-3907","kind":"heading","level":2,"spans":[{"id":"spn-4022","text":"Quick Definitions"}]},{"id":"blk-3908","kind":"heading","level":3,"spans":[{"id":"spn-4023","text":"[&] Protocol"}]},{"id":"blk-3909","kind":"paragraph","spans":[{"id":"spn-4024","text":"An open, language-agnostic protocol for composing agent cognitive capabilities. It defines:"}]},{"id":"blk-3910","items":[{"blocks":[{"id":"blk-3912","kind":"paragraph","spans":[{"id":"spn-4025","text":"canonical "},{"id":"spn-4026","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-3911","kind":"list-item"},{"blocks":[{"id":"blk-3914","kind":"paragraph","spans":[{"id":"spn-4027","text":"capability primitives like "},{"id":"spn-4028","marks":["code"],"text":"&memory"},{"id":"spn-4029","text":", "},{"id":"spn-4030","marks":["code"],"text":"&reason"},{"id":"spn-4031","text":", "},{"id":"spn-4032","marks":["code"],"text":"&time"},{"id":"spn-4033","text":", "},{"id":"spn-4034","marks":["code"],"text":"&space"},{"id":"spn-4035","text":", and "},{"id":"spn-4036","marks":["code"],"text":"&govern"}]}],"id":"blk-3913","kind":"list-item"},{"blocks":[{"id":"blk-3916","kind":"paragraph","spans":[{"id":"spn-4037","text":"namespaced subtypes like "},{"id":"spn-4038","marks":["code"],"text":"&memory.graph"},{"id":"spn-4039","text":" and "},{"id":"spn-4040","marks":["code"],"text":"&time.anomaly"}]}],"id":"blk-3915","kind":"list-item"},{"blocks":[{"id":"blk-3918","kind":"paragraph","spans":[{"id":"spn-4041","text":"capability contracts with typed operations"}]}],"id":"blk-3917","kind":"list-item"},{"blocks":[{"id":"blk-3920","kind":"paragraph","spans":[{"id":"spn-4042","text":"composition algebra properties"}]}],"id":"blk-3919","kind":"list-item"},{"blocks":[{"id":"blk-3922","kind":"paragraph","spans":[{"id":"spn-4043","text":"provenance records"}]}],"id":"blk-3921","kind":"list-item"},{"blocks":[{"id":"blk-3924","kind":"paragraph","spans":[{"id":"spn-4044","text":"governance constraints"}]}],"id":"blk-3923","kind":"list-item"},{"blocks":[{"id":"blk-3926","kind":"paragraph","spans":[{"id":"spn-4045","text":"compilation targets such as MCP and A2A artifacts"}]}],"id":"blk-3925","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-3927","kind":"heading","level":3,"spans":[{"id":"spn-4046","text":"MCP"}]},{"id":"blk-3928","kind":"paragraph","spans":[{"id":"spn-4047","text":"The Model Context Protocol focuses on connecting agents to tools, resources, and prompts. It standardizes the agent-to-tool interface, not the internal capability model of the agent."}]},{"id":"blk-3929","kind":"heading","level":3,"spans":[{"id":"spn-4048","text":"A2A"}]},{"id":"blk-3930","kind":"paragraph","spans":[{"id":"spn-4049","text":"The Agent-to-Agent Protocol focuses on how agents discover each other, advertise skills, and coordinate tasks. It assumes an agent already exists and exposes an interaction surface."}]},{"id":"blk-3931","kind":"heading","level":3,"spans":[{"id":"spn-4050","text":"ACP"}]},{"id":"blk-3932","kind":"paragraph","spans":[{"id":"spn-4051","text":"The Agent Communication Protocol focuses on interoperable communication between agents or agent-like services, often through lightweight network-native interfaces."}]},{"id":"blk-3933","kind":"heading","level":3,"spans":[{"id":"spn-4052","text":"DALIA"}]},{"id":"blk-3934","kind":"paragraph","spans":[{"id":"spn-4053","text":"A research effort that treats intelligence as compositional and layered. DALIA helps articulate why capability composition matters, but it is not itself a deployable protocol specification in the same sense."}]},{"id":"blk-3935","kind":"paragraph","spans":[{"id":"spn-4054","text":"---"}]},{"id":"blk-3936","kind":"heading","level":2,"spans":[{"id":"spn-4055","text":"The Stack View"}]},{"id":"blk-3937","kind":"paragraph","spans":[{"id":"spn-4056","text":"A useful mental model is:"}]},{"head":[{"id":"blk-3939","spans":[{"id":"spn-4057","text":"Layer"}]},{"id":"blk-3940","spans":[{"id":"spn-4058","text":"Question"}]},{"id":"blk-3941","spans":[{"id":"spn-4059","text":"Example Protocols"}]}],"id":"blk-3938","kind":"table","rows":[[{"id":"blk-3942","spans":[{"id":"spn-4060","text":"UI"}]},{"id":"blk-3943","spans":[{"id":"spn-4061","text":"How does the agent render and interact with users?"}]},{"id":"blk-3944","spans":[{"id":"spn-4062","text":"AG-UI, A2UI"}]}],[{"id":"blk-3945","spans":[{"id":"spn-4063","marks":["bold"],"text":"Composition"}]},{"id":"blk-3946","spans":[{"id":"spn-4064","text":"What capabilities make up this agent, and how do they fit together?"}]},{"id":"blk-3947","spans":[{"id":"spn-4065","marks":["bold"],"text":"[&]"}]}],[{"id":"blk-3948","spans":[{"id":"spn-4066","text":"Coordination"}]},{"id":"blk-3949","spans":[{"id":"spn-4067","text":"How do agents discover and delegate to each other?"}]},{"id":"blk-3950","spans":[{"id":"spn-4068","text":"A2A"}]}],[{"id":"blk-3951","spans":[{"id":"spn-4069","text":"Context"}]},{"id":"blk-3952","spans":[{"id":"spn-4070","text":"How does an agent access tools and resources?"}]},{"id":"blk-3953","spans":[{"id":"spn-4071","text":"MCP"}]}],[{"id":"blk-3954","spans":[{"id":"spn-4072","text":"Communication"}]},{"id":"blk-3955","spans":[{"id":"spn-4073","text":"How do services and agents exchange messages over networks?"}]},{"id":"blk-3956","spans":[{"id":"spn-4074","text":"ACP, HTTP, gRPC"}]}]]},{"id":"blk-3957","kind":"paragraph","spans":[{"id":"spn-4075","text":"This is why [&] should not be framed as \"above\" MCP or A2A in a political or replacement sense. A better and more accurate statement is:"}]},{"blocks":[{"id":"blk-3959","kind":"paragraph","spans":[{"id":"spn-4076","text":"[&] defines the composition layer and compiles into MCP + A2A configurations."}]}],"id":"blk-3958","kind":"quote"},{"id":"blk-3960","kind":"paragraph","spans":[{"id":"spn-4077","text":"---"}]},{"id":"blk-3961","kind":"heading","level":2,"spans":[{"id":"spn-4078","text":"Where MCP Is Strong"}]},{"id":"blk-3962","kind":"paragraph","spans":[{"id":"spn-4079","text":"MCP is strong when you need:"}]},{"id":"blk-3963","items":[{"blocks":[{"id":"blk-3965","kind":"paragraph","spans":[{"id":"spn-4080","text":"a standard way to expose tools"}]}],"id":"blk-3964","kind":"list-item"},{"blocks":[{"id":"blk-3967","kind":"paragraph","spans":[{"id":"spn-4081","text":"structured resources and prompts"}]}],"id":"blk-3966","kind":"list-item"},{"blocks":[{"id":"blk-3969","kind":"paragraph","spans":[{"id":"spn-4082","text":"agent access to external systems"}]}],"id":"blk-3968","kind":"list-item"},{"blocks":[{"id":"blk-3971","kind":"paragraph","spans":[{"id":"spn-4083","text":"clear client/server boundaries"}]}],"id":"blk-3970","kind":"list-item"},{"blocks":[{"id":"blk-3973","kind":"paragraph","spans":[{"id":"spn-4084","text":"tool interoperability across runtimes"}]}],"id":"blk-3972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-3974","kind":"paragraph","spans":[{"id":"spn-4085","text":"MCP is not trying to answer questions like:"}]},{"id":"blk-3975","items":[{"blocks":[{"id":"blk-3977","kind":"paragraph","spans":[{"id":"spn-4086","text":"Should this agent have episodic memory or graph memory?"}]}],"id":"blk-3976","kind":"list-item"},{"blocks":[{"id":"blk-3979","kind":"paragraph","spans":[{"id":"spn-4087","text":"Is "},{"id":"spn-4088","marks":["code"],"text":"&time.anomaly"},{"id":"spn-4089","text":" compatible with "},{"id":"spn-4090","marks":["code"],"text":"&reason.argument"},{"id":"spn-4091","text":" in this pipeline?"}]}],"id":"blk-3978","kind":"list-item"},{"blocks":[{"id":"blk-3981","kind":"paragraph","spans":[{"id":"spn-4092","text":"What governance rules constrain this agent's actions?"}]}],"id":"blk-3980","kind":"list-item"},{"blocks":[{"id":"blk-3983","kind":"paragraph","spans":[{"id":"spn-4093","text":"How do I preserve a provenance chain across composed cognition?"}]}],"id":"blk-3982","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-3984","kind":"paragraph","spans":[{"id":"spn-4094","text":"Those are composition-layer concerns, which is exactly why [&] exists."}]},{"id":"blk-3985","kind":"paragraph","spans":[{"id":"spn-4095","text":"---"}]},{"id":"blk-3986","kind":"heading","level":2,"spans":[{"id":"spn-4096","text":"Where A2A Is Strong"}]},{"id":"blk-3987","kind":"paragraph","spans":[{"id":"spn-4097","text":"A2A is strong when you need:"}]},{"id":"blk-3988","items":[{"blocks":[{"id":"blk-3990","kind":"paragraph","spans":[{"id":"spn-4098","text":"agent discovery"}]}],"id":"blk-3989","kind":"list-item"},{"blocks":[{"id":"blk-3992","kind":"paragraph","spans":[{"id":"spn-4099","text":"advertised skills"}]}],"id":"blk-3991","kind":"list-item"},{"blocks":[{"id":"blk-3994","kind":"paragraph","spans":[{"id":"spn-4100","text":"task delegation"}]}],"id":"blk-3993","kind":"list-item"},{"blocks":[{"id":"blk-3996","kind":"paragraph","spans":[{"id":"spn-4101","text":"multi-agent workflow handoff"}]}],"id":"blk-3995","kind":"list-item"},{"blocks":[{"id":"blk-3998","kind":"paragraph","spans":[{"id":"spn-4102","text":"machine-readable agent cards"}]}],"id":"blk-3997","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-3999","kind":"paragraph","spans":[{"id":"spn-4103","text":"A2A starts from the perspective that an agent has already been built and is now publishing its capabilities outward."}]},{"id":"blk-4000","kind":"paragraph","spans":[{"id":"spn-4104","text":"[&] starts earlier. It defines how the agent is composed in the first place."}]},{"id":"blk-4001","kind":"paragraph","spans":[{"id":"spn-4105","text":"That makes the relationship complementary:"}]},{"id":"blk-4002","items":[{"blocks":[{"id":"blk-4004","kind":"paragraph","spans":[{"id":"spn-4106","marks":["bold"],"text":"[&]"},{"id":"spn-4107","text":" describes internal composition"}]}],"id":"blk-4003","kind":"list-item"},{"blocks":[{"id":"blk-4006","kind":"paragraph","spans":[{"id":"spn-4108","marks":["bold"],"text":"A2A"},{"id":"spn-4109","text":" describes external coordination"}]}],"id":"blk-4005","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-4007","kind":"paragraph","spans":[{"id":"spn-4110","text":"---"}]},{"id":"blk-4008","kind":"heading","level":2,"spans":[{"id":"spn-4111","text":"Where ACP Is Strong"}]},{"id":"blk-4009","kind":"paragraph","spans":[{"id":"spn-4112","text":"ACP is strong when you need:"}]},{"id":"blk-4010","items":[{"blocks":[{"id":"blk-4012","kind":"paragraph","spans":[{"id":"spn-4113","text":"lightweight inter-agent communication"}]}],"id":"blk-4011","kind":"list-item"},{"blocks":[{"id":"blk-4014","kind":"paragraph","spans":[{"id":"spn-4114","text":"simple network-native interfaces"}]}],"id":"blk-4013","kind":"list-item"},{"blocks":[{"id":"blk-4016","kind":"paragraph","spans":[{"id":"spn-4115","text":"integration over common web patterns"}]}],"id":"blk-4015","kind":"list-item"},{"blocks":[{"id":"blk-4018","kind":"paragraph","spans":[{"id":"spn-4116","text":"deployable communication surfaces without requiring tool-specific semantics"}]}],"id":"blk-4017","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-4019","kind":"paragraph","spans":[{"id":"spn-4117","text":"ACP is closest to a communications substrate. It is useful for transport and interoperability, but it does not define:"}]},{"id":"blk-4020","items":[{"blocks":[{"id":"blk-4022","kind":"paragraph","spans":[{"id":"spn-4118","text":"capability primitives"}]}],"id":"blk-4021","kind":"list-item"},{"blocks":[{"id":"blk-4024","kind":"paragraph","spans":[{"id":"spn-4119","text":"capability subtypes"}]}],"id":"blk-4023","kind":"list-item"},{"blocks":[{"id":"blk-4026","kind":"paragraph","spans":[{"id":"spn-4120","text":"composition algebra"}]}],"id":"blk-4025","kind":"list-item"},{"blocks":[{"id":"blk-4028","kind":"paragraph","spans":[{"id":"spn-4121","text":"provenance chain structure"}]}],"id":"blk-4027","kind":"list-item"},{"blocks":[{"id":"blk-4030","kind":"paragraph","spans":[{"id":"spn-4122","text":"governance constraints as portable data"}]}],"id":"blk-4029","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-4031","kind":"paragraph","spans":[{"id":"spn-4123","text":"So ACP and [&] solve different problems."}]},{"id":"blk-4032","kind":"paragraph","spans":[{"id":"spn-4124","text":"---"}]},{"id":"blk-4033","kind":"heading","level":2,"spans":[{"id":"spn-4125","text":"Why DALIA Matters Here"}]},{"id":"blk-4034","kind":"paragraph","spans":[{"id":"spn-4126","text":"DALIA is important because it strengthens the claim that there is a real conceptual gap in the ecosystem."}]},{"id":"blk-4035","kind":"paragraph","spans":[{"id":"spn-4127","text":"It supports ideas like:"}]},{"id":"blk-4036","items":[{"blocks":[{"id":"blk-4038","kind":"paragraph","spans":[{"id":"spn-4128","text":"intelligence as composition rather than monolith"}]}],"id":"blk-4037","kind":"list-item"},{"blocks":[{"id":"blk-4040","kind":"paragraph","spans":[{"id":"spn-4129","text":"modular cognitive systems"}]}],"id":"blk-4039","kind":"list-item"},{"blocks":[{"id":"blk-4042","kind":"paragraph","spans":[{"id":"spn-4130","text":"layered capabilities"}]}],"id":"blk-4041","kind":"list-item"},{"blocks":[{"id":"blk-4044","kind":"paragraph","spans":[{"id":"spn-4131","text":"architectural clarity between memory, reasoning, planning, governance, and execution"}]}],"id":"blk-4043","kind":"list-item