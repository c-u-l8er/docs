{"bendscript":"0.1","blocks":[{"id":"blk-5733","kind":"heading","level":1,"spans":[{"id":"spn-5458","text":"[&] vs MCP vs A2A vs DALIA vs ACP"}]},{"id":"blk-5734","kind":"paragraph","spans":[{"id":"spn-5459","text":"This document positions the [&] Protocol relative to adjacent standards, research efforts, and ecosystem protocols."}]},{"id":"blk-5735","kind":"paragraph","spans":[{"id":"spn-5460","text":"The short version:"}]},{"id":"blk-5736","items":[{"blocks":[{"id":"blk-5738","kind":"paragraph","spans":[{"id":"spn-5461","marks":["bold"],"text":"MCP"},{"id":"spn-5462","text":" standardizes agent-to-tool connectivity."}]}],"id":"blk-5737","kind":"list-item"},{"blocks":[{"id":"blk-5740","kind":"paragraph","spans":[{"id":"spn-5463","marks":["bold"],"text":"A2A"},{"id":"spn-5464","text":" standardizes agent-to-agent coordination."}]}],"id":"blk-5739","kind":"list-item"},{"blocks":[{"id":"blk-5742","kind":"paragraph","spans":[{"id":"spn-5465","marks":["bold"],"text":"ACP"},{"id":"spn-5466","text":" standardizes lightweight agent communication over network APIs."}]}],"id":"blk-5741","kind":"list-item"},{"blocks":[{"id":"blk-5744","kind":"paragraph","spans":[{"id":"spn-5467","marks":["bold"],"text":"DALIA"},{"id":"spn-5468","text":" highlights the need for compositional intelligence architectures at the research level."}]}],"id":"blk-5743","kind":"list-item"},{"blocks":[{"id":"blk-5746","kind":"paragraph","spans":[{"id":"spn-5469","marks":["bold"],"text":"[&]"},{"id":"spn-5470","text":" defines the "},{"id":"spn-5471","marks":["bold"],"text":"capability composition layer"},{"id":"spn-5472","text":": how an agent declares, validates, binds, and governs its cognitive capabilities before compiling into runtime protocols."}]}],"id":"blk-5745","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5747","kind":"paragraph","spans":[{"id":"spn-5473","text":"The right framing is not replacement, but composition:"}]},{"blocks":[{"id":"blk-5749","kind":"paragraph","spans":[{"id":"spn-5474","text":"[&] compiles into MCP + A2A configurations."}]}],"id":"blk-5748","kind":"quote"},{"id":"blk-5750","kind":"heading","level":2,"spans":[{"id":"spn-5475","text":"Comparison Table"}]},{"head":[{"id":"blk-5752","spans":[{"id":"spn-5476","text":"System"}]},{"id":"blk-5753","spans":[{"id":"spn-5477","text":"Primary Scope"}]},{"id":"blk-5754","spans":[{"id":"spn-5478","text":"Layer in the Stack"}]},{"id":"blk-5755","spans":[{"id":"spn-5479","text":"Main Unit of Abstraction"}]},{"id":"blk-5756","spans":[{"id":"spn-5480","text":"What It Standardizes Well"}]},{"id":"blk-5757","spans":[{"id":"spn-5481","text":"What It Does "},{"id":"spn-5482","marks":["bold"],"text":"Not"},{"id":"spn-5483","text":" Standardize"}]},{"id":"blk-5758","spans":[{"id":"spn-5484","text":"Relationship to [&]"}]}],"id":"blk-5751","kind":"table","rows":[[{"id":"blk-5759","spans":[{"id":"spn-5485","marks":["bold"],"text":"[&] Protocol"}]},{"id":"blk-5760","spans":[{"id":"spn-5486","text":"Capability composition for agents"}]},{"id":"blk-5761","spans":[{"id":"spn-5487","text":"Composition"}]},{"id":"blk-5762","spans":[{"id":"spn-5488","text":"Capability declarations, contracts, provenance, governance"}]},{"id":"blk-5763","spans":[{"id":"spn-5489","text":"How memory, reasoning, time, space, and governance capabilities are declared, validated, composed, and compiled into downstream configs"}]},{"id":"blk-5764","spans":[{"id":"spn-5490","text":"Low-level transport protocols, direct tool RPC semantics, agent network communication"}]},{"id":"blk-5765","spans":[{"id":"spn-5491","text":"Source-of-truth layer"}]}],[{"id":"blk-5766","spans":[{"id":"spn-5492","marks":["bold"],"text":"MCP"}]},{"id":"blk-5767","spans":[{"id":"spn-5493","text":"Agent-to-tool connectivity"}]},{"id":"blk-5768","spans":[{"id":"spn-5494","text":"Context / Tooling"}]},{"id":"blk-5769","spans":[{"id":"spn-5495","text":"Tools, resources, prompts, client-server interaction"}]},{"id":"blk-5770","spans":[{"id":"spn-5496","text":"Tool discovery, tool invocation, structured context access, resource exposure"}]},{"id":"blk-5771","spans":[{"id":"spn-5497","text":"How an agent's cognitive capabilities are selected, composed, governed, or provenance-linked"}]},{"id":"blk-5772","spans":[{"id":"spn-5498","text":"[&] can generate MCP configuration"}]}],[{"id":"blk-5773","spans":[{"id":"spn-5499","marks":["bold"],"text":"A2A"}]},{"id":"blk-5774","spans":[{"id":"spn-5500","text":"Agent-to-agent coordination"}]},{"id":"blk-5775","spans":[{"id":"spn-5501","text":"Coordination"}]},{"id":"blk-5776","spans":[{"id":"spn-5502","text":"Agent cards, skills, tasks, delegation flows"}]},{"id":"blk-5777","spans":[{"id":"spn-5503","text":"Agent discovery, advertised skills, delegation and inter-agent interaction"}]},{"id":"blk-5778","spans":[{"id":"spn-5504","text":"How internal cognitive capabilities are composed or validated before publication"}]},{"id":"blk-5779","spans":[{"id":"spn-5505","text":"[&] can generate A2A agent cards"}]}],[{"id":"blk-5780","spans":[{"id":"spn-5506","marks":["bold"],"text":"ACP"}]},{"id":"blk-5781","spans":[{"id":"spn-5507","text":"Lightweight agent communication"}]},{"id":"blk-5782","spans":[{"id":"spn-5508","text":"Communication"}]},{"id":"blk-5783","spans":[{"id":"spn-5509","text":"HTTP/REST-style agent endpoints and message exchange"}]},{"id":"blk-5784","spans":[{"id":"spn-5510","text":"Inter-agent messaging and integration patterns over standard web infrastructure"}]},{"id":"blk-5785","spans":[{"id":"spn-5511","text":"Capability algebra, provenance semantics, governance-as-data, typed capability composition"}]},{"id":"blk-5786","spans":[{"id":"spn-5512","text":"Adjacent network protocol; [&] sits at a different concern boundary"}]}],[{"id":"blk-5787","spans":[{"id":"spn-5513","marks":["bold"],"text":"DALIA"}]},{"id":"blk-5788","spans":[{"id":"spn-5514","text":"Research framework for compositional intelligence"}]},{"id":"blk-5789","spans":[{"id":"spn-5515","text":"Research / Theory"}]},{"id":"blk-5790","spans":[{"id":"spn-5516","text":"Cognitive architecture model"}]},{"id":"blk-5791","spans":[{"id":"spn-5517","text":"Why modular, compositional agent intelligence matters; academic framing for layered capability systems"}]},{"id":"blk-5792","spans":[{"id":"spn-5518","text":"A production-ready protocol artifact, schema, CLI, registry, or runtime config format"}]},{"id":"blk-5793","spans":[{"id":"spn-5519","text":"Independent conceptual validation of the gap [&] addresses"}]}]]},{"id":"blk-5794","kind":"heading","level":2,"spans":[{"id":"spn-5520","text":"Quick Definitions"}]},{"id":"blk-5795","kind":"heading","level":3,"spans":[{"id":"spn-5521","text":"[&] Protocol"}]},{"id":"blk-5796","kind":"paragraph","spans":[{"id":"spn-5522","text":"An open, language-agnostic protocol for composing agent cognitive capabilities. It defines:"}]},{"id":"blk-5797","items":[{"blocks":[{"id":"blk-5799","kind":"paragraph","spans":[{"id":"spn-5523","text":"canonical "},{"id":"spn-5524","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-5798","kind":"list-item"},{"blocks":[{"id":"blk-5801","kind":"paragraph","spans":[{"id":"spn-5525","text":"capability primitives like "},{"id":"spn-5526","marks":["code"],"text":"&memory"},{"id":"spn-5527","text":", "},{"id":"spn-5528","marks":["code"],"text":"&reason"},{"id":"spn-5529","text":", "},{"id":"spn-5530","marks":["code"],"text":"&time"},{"id":"spn-5531","text":", "},{"id":"spn-5532","marks":["code"],"text":"&space"},{"id":"spn-5533","text":", and "},{"id":"spn-5534","marks":["code"],"text":"&govern"}]}],"id":"blk-5800","kind":"list-item"},{"blocks":[{"id":"blk-5803","kind":"paragraph","spans":[{"id":"spn-5535","text":"namespaced subtypes like "},{"id":"spn-5536","marks":["code"],"text":"&memory.graph"},{"id":"spn-5537","text":" and "},{"id":"spn-5538","marks":["code"],"text":"&time.anomaly"}]}],"id":"blk-5802","kind":"list-item"},{"blocks":[{"id":"blk-5805","kind":"paragraph","spans":[{"id":"spn-5539","text":"capability contracts with typed operations"}]}],"id":"blk-5804","kind":"list-item"},{"blocks":[{"id":"blk-5807","kind":"paragraph","spans":[{"id":"spn-5540","text":"composition algebra properties"}]}],"id":"blk-5806","kind":"list-item"},{"blocks":[{"id":"blk-5809","kind":"paragraph","spans":[{"id":"spn-5541","text":"provenance records"}]}],"id":"blk-5808","kind":"list-item"},{"blocks":[{"id":"blk-5811","kind":"paragraph","spans":[{"id":"spn-5542","text":"governance constraints"}]}],"id":"blk-5810","kind":"list-item"},{"blocks":[{"id":"blk-5813","kind":"paragraph","spans":[{"id":"spn-5543","text":"compilation targets such as MCP and A2A artifacts"}]}],"id":"blk-5812","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5814","kind":"heading","level":3,"spans":[{"id":"spn-5544","text":"MCP"}]},{"id":"blk-5815","kind":"paragraph","spans":[{"id":"spn-5545","text":"The Model Context Protocol focuses on connecting agents to tools, resources, and prompts. It standardizes the agent-to-tool interface, not the internal capability model of the agent."}]},{"id":"blk-5816","kind":"heading","level":3,"spans":[{"id":"spn-5546","text":"A2A"}]},{"id":"blk-5817","kind":"paragraph","spans":[{"id":"spn-5547","text":"The Agent-to-Agent Protocol focuses on how agents discover each other, advertise skills, and coordinate tasks. It assumes an agent already exists and exposes an interaction surface."}]},{"id":"blk-5818","kind":"heading","level":3,"spans":[{"id":"spn-5548","text":"ACP"}]},{"id":"blk-5819","kind":"paragraph","spans":[{"id":"spn-5549","text":"The Agent Communication Protocol focuses on interoperable communication between agents or agent-like services, often through lightweight network-native interfaces."}]},{"id":"blk-5820","kind":"heading","level":3,"spans":[{"id":"spn-5550","text":"DALIA"}]},{"id":"blk-5821","kind":"paragraph","spans":[{"id":"spn-5551","text":"A research effort that treats intelligence as compositional and layered. DALIA helps articulate why capability composition matters, but it is not itself a deployable protocol specification in the same sense."}]},{"id":"blk-5822","kind":"heading","level":2,"spans":[{"id":"spn-5552","text":"The Stack View"}]},{"id":"blk-5823","kind":"paragraph","spans":[{"id":"spn-5553","text":"A useful mental model is:"}]},{"head":[{"id":"blk-5825","spans":[{"id":"spn-5554","text":"Layer"}]},{"id":"blk-5826","spans":[{"id":"spn-5555","text":"Question"}]},{"id":"blk-5827","spans":[{"id":"spn-5556","text":"Example Protocols"}]}],"id":"blk-5824","kind":"table","rows":[[{"id":"blk-5828","spans":[{"id":"spn-5557","text":"UI"}]},{"id":"blk-5829","spans":[{"id":"spn-5558","text":"How does the agent render and interact with users?"}]},{"id":"blk-5830","spans":[{"id":"spn-5559","text":"AG-UI, A2UI"}]}],[{"id":"blk-5831","spans":[{"id":"spn-5560","marks":["bold"],"text":"Composition"}]},{"id":"blk-5832","spans":[{"id":"spn-5561","text":"What capabilities make up this agent, and how do they fit together?"}]},{"id":"blk-5833","spans":[{"id":"spn-5562","marks":["bold"],"text":"[&]"}]}],[{"id":"blk-5834","spans":[{"id":"spn-5563","text":"Coordination"}]},{"id":"blk-5835","spans":[{"id":"spn-5564","text":"How do agents discover and delegate to each other?"}]},{"id":"blk-5836","spans":[{"id":"spn-5565","text":"A2A"}]}],[{"id":"blk-5837","spans":[{"id":"spn-5566","text":"Context"}]},{"id":"blk-5838","spans":[{"id":"spn-5567","text":"How does an agent access tools and resources?"}]},{"id":"blk-5839","spans":[{"id":"spn-5568","text":"MCP"}]}],[{"id":"blk-5840","spans":[{"id":"spn-5569","text":"Communication"}]},{"id":"blk-5841","spans":[{"id":"spn-5570","text":"How do services and agents exchange messages over networks?"}]},{"id":"blk-5842","spans":[{"id":"spn-5571","text":"ACP, HTTP, gRPC"}]}]]},{"id":"blk-5843","kind":"paragraph","spans":[{"id":"spn-5572","text":"This is why [&] should not be framed as \"above\" MCP or A2A in a political or replacement sense. A better and more accurate statement is:"}]},{"blocks":[{"id":"blk-5845","kind":"paragraph","spans":[{"id":"spn-5573","text":"[&] defines the composition layer and compiles into MCP + A2A configurations."}]}],"id":"blk-5844","kind":"quote"},{"id":"blk-5846","kind":"heading","level":2,"spans":[{"id":"spn-5574","text":"Where MCP Is Strong"}]},{"id":"blk-5847","kind":"paragraph","spans":[{"id":"spn-5575","text":"MCP is strong when you need:"}]},{"id":"blk-5848","items":[{"blocks":[{"id":"blk-5850","kind":"paragraph","spans":[{"id":"spn-5576","text":"a standard way to expose tools"}]}],"id":"blk-5849","kind":"list-item"},{"blocks":[{"id":"blk-5852","kind":"paragraph","spans":[{"id":"spn-5577","text":"structured resources and prompts"}]}],"id":"blk-5851","kind":"list-item"},{"blocks":[{"id":"blk-5854","kind":"paragraph","spans":[{"id":"spn-5578","text":"agent access to external systems"}]}],"id":"blk-5853","kind":"list-item"},{"blocks":[{"id":"blk-5856","kind":"paragraph","spans":[{"id":"spn-5579","text":"clear client/server boundaries"}]}],"id":"blk-5855","kind":"list-item"},{"blocks":[{"id":"blk-5858","kind":"paragraph","spans":[{"id":"spn-5580","text":"tool interoperability across runtimes"}]}],"id":"blk-5857","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5859","kind":"paragraph","spans":[{"id":"spn-5581","text":"MCP is not trying to answer questions like:"}]},{"id":"blk-5860","items":[{"blocks":[{"id":"blk-5862","kind":"paragraph","spans":[{"id":"spn-5582","text":"Should this agent have episodic memory or graph memory?"}]}],"id":"blk-5861","kind":"list-item"},{"blocks":[{"id":"blk-5864","kind":"paragraph","spans":[{"id":"spn-5583","text":"Is "},{"id":"spn-5584","marks":["code"],"text":"&time.anomaly"},{"id":"spn-5585","text":" compatible with "},{"id":"spn-5586","marks":["code"],"text":"&reason.argument"},{"id":"spn-5587","text":" in this pipeline?"}]}],"id":"blk-5863","kind":"list-item"},{"blocks":[{"id":"blk-5866","kind":"paragraph","spans":[{"id":"spn-5588","text":"What governance rules constrain this agent's actions?"}]}],"id":"blk-5865","kind":"list-item"},{"blocks":[{"id":"blk-5868","kind":"paragraph","spans":[{"id":"spn-5589","text":"How do I preserve a provenance chain across composed cognition?"}]}],"id":"blk-5867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5869","kind":"paragraph","spans":[{"id":"spn-5590","text":"Those are composition-layer concerns, which is exactly why [&] exists."}]},{"id":"blk-5870","kind":"heading","level":2,"spans":[{"id":"spn-5591","text":"Where A2A Is Strong"}]},{"id":"blk-5871","kind":"paragraph","spans":[{"id":"spn-5592","text":"A2A is strong when you need:"}]},{"id":"blk-5872","items":[{"blocks":[{"id":"blk-5874","kind":"paragraph","spans":[{"id":"spn-5593","text":"agent discovery"}]}],"id":"blk-5873","kind":"list-item"},{"blocks":[{"id":"blk-5876","kind":"paragraph","spans":[{"id":"spn-5594","text":"advertised skills"}]}],"id":"blk-5875","kind":"list-item"},{"blocks":[{"id":"blk-5878","kind":"paragraph","spans":[{"id":"spn-5595","text":"task delegation"}]}],"id":"blk-5877","kind":"list-item"},{"blocks":[{"id":"blk-5880","kind":"paragraph","spans":[{"id":"spn-5596","text":"multi-agent workflow handoff"}]}],"id":"blk-5879","kind":"list-item"},{"blocks":[{"id":"blk-5882","kind":"paragraph","spans":[{"id":"spn-5597","text":"machine-readable agent cards"}]}],"id":"blk-5881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5883","kind":"paragraph","spans":[{"id":"spn-5598","text":"A2A starts from the perspective that an agent has already been built and is now publishing its capabilities outward."}]},{"id":"blk-5884","kind":"paragraph","spans":[{"id":"spn-5599","text":"[&] starts earlier. It defines how the agent is composed in the first place."}]},{"id":"blk-5885","kind":"paragraph","spans":[{"id":"spn-5600","text":"That makes the relationship complementary:"}]},{"id":"blk-5886","items":[{"blocks":[{"id":"blk-5888","kind":"paragraph","spans":[{"id":"spn-5601","marks":["bold"],"text":"[&]"},{"id":"spn-5602","text":" describes internal composition"}]}],"id":"blk-5887","kind":"list-item"},{"blocks":[{"id":"blk-5890","kind":"paragraph","spans":[{"id":"spn-5603","marks":["bold"],"text":"A2A"},{"id":"spn-5604","text":" describes external coordination"}]}],"id":"blk-5889","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5891","kind":"heading","level":2,"spans":[{"id":"spn-5605","text":"Where ACP Is Strong"}]},{"id":"blk-5892","kind":"paragraph","spans":[{"id":"spn-5606","text":"ACP is strong when you need:"}]},{"id":"blk-5893","items":[{"blocks":[{"id":"blk-5895","kind":"paragraph","spans":[{"id":"spn-5607","text":"lightweight inter-agent communication"}]}],"id":"blk-5894","kind":"list-item"},{"blocks":[{"id":"blk-5897","kind":"paragraph","spans":[{"id":"spn-5608","text":"simple network-native interfaces"}]}],"id":"blk-5896","kind":"list-item"},{"blocks":[{"id":"blk-5899","kind":"paragraph","spans":[{"id":"spn-5609","text":"integration over common web patterns"}]}],"id":"blk-5898","kind":"list-item"},{"blocks":[{"id":"blk-5901","kind":"paragraph","spans":[{"id":"spn-5610","text":"deployable communication surfaces without requiring tool-specific semantics"}]}],"id":"blk-5900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5902","kind":"paragraph","spans":[{"id":"spn-5611","text":"ACP is closest to a communications substrate. It is useful for transport and interoperability, but it does not define:"}]},{"id":"blk-5903","items":[{"blocks":[{"id":"blk-5905","kind":"paragraph","spans":[{"id":"spn-5612","text":"capability primitives"}]}],"id":"blk-5904","kind":"list-item"},{"blocks":[{"id":"blk-5907","kind":"paragraph","spans":[{"id":"spn-5613","text":"capability subtypes"}]}],"id":"blk-5906","kind":"list-item"},{"blocks":[{"id":"blk-5909","kind":"paragraph","spans":[{"id":"spn-5614","text":"composition algebra"}]}],"id":"blk-5908","kind":"list-item"},{"blocks":[{"id":"blk-5911","kind":"paragraph","spans":[{"id":"spn-5615","text":"provenance chain structure"}]}],"id":"blk-5910","kind":"list-item"},{"blocks":[{"id":"blk-5913","kind":"paragraph","spans":[{"id":"spn-5616","text":"governance constraints as portable data"}]}],"id":"blk-5912","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5914","kind":"paragraph","spans":[{"id":"spn-5617","text":"So ACP and [&] solve different problems."}]},{"id":"blk-5915","kind":"heading","level":2,"spans":[{"id":"spn-5618","text":"Why DALIA Matters Here"}]},{"id":"blk-5916","kind":"paragraph","spans":[{"id":"spn-5619","text":"DALIA is important because it strengthens the claim that there is a real conceptual gap in the ecosystem."}]},{"id":"blk-5917","kind":"paragraph","spans":[{"id":"spn-5620","text":"It supports ideas like:"}]},{"id":"blk-5918","items":[{"blocks":[{"id":"blk-5920","kind":"paragraph","spans":[{"id":"spn-5621","text":"intelligence as composition rather than monolith"}]}],"id":"blk-5919","kind":"list-item"},{"blocks":[{"id":"blk-5922","kind":"paragraph","spans":[{"id":"spn-5622","text":"modular cognitive systems"}]}],"id":"blk-5921","kind":"list-item"},{"blocks":[{"id":"blk-5924","kind":"paragraph","spans":[{"id":"spn-5623","text":"layered capabilities"}]}],"id":"blk-5923","kind":"list-item"},{"blocks":[{"id":"blk-5926","kind":"paragraph","spans":[{"id":"spn-5624","text":"architectural clarity between memory, reasoning, planning, governance, and execution"}]}],"id":"blk-5925","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5927","kind":"paragraph","spans":[{"id":"spn-5625","text":"That is useful because [&] is not just inventing a product category. It is operationalizing a real architectural need into:"}]},{"id":"blk-5928","items":[{"blocks":[{"id":"blk-5930","kind":"paragraph","spans":[{"id":"spn-5626","text":"schema artifacts"}]}],"id":"blk-5929","kind":"list-item"},{"blocks":[{"id":"blk-5932","kind":"paragraph","spans":[{"id":"spn-5627","text":"machine-readable contracts"}]}],"id":"blk-5931","kind":"list-item"}