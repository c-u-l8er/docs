{"bendscript":"0.1","blocks":[{"id":"blk-5731","kind":"heading","level":1,"spans":[{"id":"spn-5658","text":"[&] vs MCP vs A2A vs DALIA vs ACP"}]},{"id":"blk-5732","kind":"paragraph","spans":[{"id":"spn-5659","text":"This document positions the [&] Protocol relative to adjacent standards, research efforts, and ecosystem protocols."}]},{"id":"blk-5733","kind":"paragraph","spans":[{"id":"spn-5660","text":"The short version:"}]},{"id":"blk-5734","items":[{"blocks":[{"id":"blk-5736","kind":"paragraph","spans":[{"id":"spn-5661","marks":["bold"],"text":"MCP"},{"id":"spn-5662","text":" standardizes agent-to-tool connectivity."}]}],"id":"blk-5735","kind":"list-item"},{"blocks":[{"id":"blk-5738","kind":"paragraph","spans":[{"id":"spn-5663","marks":["bold"],"text":"A2A"},{"id":"spn-5664","text":" standardizes agent-to-agent coordination."}]}],"id":"blk-5737","kind":"list-item"},{"blocks":[{"id":"blk-5740","kind":"paragraph","spans":[{"id":"spn-5665","marks":["bold"],"text":"ACP"},{"id":"spn-5666","text":" standardizes lightweight agent communication over network APIs."}]}],"id":"blk-5739","kind":"list-item"},{"blocks":[{"id":"blk-5742","kind":"paragraph","spans":[{"id":"spn-5667","marks":["bold"],"text":"DALIA"},{"id":"spn-5668","text":" highlights the need for compositional intelligence architectures at the research level."}]}],"id":"blk-5741","kind":"list-item"},{"blocks":[{"id":"blk-5744","kind":"paragraph","spans":[{"id":"spn-5669","marks":["bold"],"text":"[&]"},{"id":"spn-5670","text":" defines the "},{"id":"spn-5671","marks":["bold"],"text":"capability composition layer"},{"id":"spn-5672","text":": how an agent declares, validates, binds, and governs its cognitive capabilities before compiling into runtime protocols."}]}],"id":"blk-5743","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5745","kind":"paragraph","spans":[{"id":"spn-5673","text":"The right framing is not replacement, but composition:"}]},{"blocks":[{"id":"blk-5747","kind":"paragraph","spans":[{"id":"spn-5674","text":"[&] compiles into MCP + A2A configurations."}]}],"id":"blk-5746","kind":"quote"},{"id":"blk-5748","kind":"heading","level":2,"spans":[{"id":"spn-5675","text":"Comparison Table"}]},{"head":[{"id":"blk-5750","spans":[{"id":"spn-5676","text":"System"}]},{"id":"blk-5751","spans":[{"id":"spn-5677","text":"Primary Scope"}]},{"id":"blk-5752","spans":[{"id":"spn-5678","text":"Layer in the Stack"}]},{"id":"blk-5753","spans":[{"id":"spn-5679","text":"Main Unit of Abstraction"}]},{"id":"blk-5754","spans":[{"id":"spn-5680","text":"What It Standardizes Well"}]},{"id":"blk-5755","spans":[{"id":"spn-5681","text":"What It Does "},{"id":"spn-5682","marks":["bold"],"text":"Not"},{"id":"spn-5683","text":" Standardize"}]},{"id":"blk-5756","spans":[{"id":"spn-5684","text":"Relationship to [&]"}]}],"id":"blk-5749","kind":"table","rows":[[{"id":"blk-5757","spans":[{"id":"spn-5685","marks":["bold"],"text":"[&] Protocol"}]},{"id":"blk-5758","spans":[{"id":"spn-5686","text":"Capability composition for agents"}]},{"id":"blk-5759","spans":[{"id":"spn-5687","text":"Composition"}]},{"id":"blk-5760","spans":[{"id":"spn-5688","text":"Capability declarations, contracts, provenance, governance"}]},{"id":"blk-5761","spans":[{"id":"spn-5689","text":"How memory, reasoning, time, space, and governance capabilities are declared, validated, composed, and compiled into downstream configs"}]},{"id":"blk-5762","spans":[{"id":"spn-5690","text":"Low-level transport protocols, direct tool RPC semantics, agent network communication"}]},{"id":"blk-5763","spans":[{"id":"spn-5691","text":"Source-of-truth layer"}]}],[{"id":"blk-5764","spans":[{"id":"spn-5692","marks":["bold"],"text":"MCP"}]},{"id":"blk-5765","spans":[{"id":"spn-5693","text":"Agent-to-tool connectivity"}]},{"id":"blk-5766","spans":[{"id":"spn-5694","text":"Context / Tooling"}]},{"id":"blk-5767","spans":[{"id":"spn-5695","text":"Tools, resources, prompts, client-server interaction"}]},{"id":"blk-5768","spans":[{"id":"spn-5696","text":"Tool discovery, tool invocation, structured context access, resource exposure"}]},{"id":"blk-5769","spans":[{"id":"spn-5697","text":"How an agent's cognitive capabilities are selected, composed, governed, or provenance-linked"}]},{"id":"blk-5770","spans":[{"id":"spn-5698","text":"[&] can generate MCP configuration"}]}],[{"id":"blk-5771","spans":[{"id":"spn-5699","marks":["bold"],"text":"A2A"}]},{"id":"blk-5772","spans":[{"id":"spn-5700","text":"Agent-to-agent coordination"}]},{"id":"blk-5773","spans":[{"id":"spn-5701","text":"Coordination"}]},{"id":"blk-5774","spans":[{"id":"spn-5702","text":"Agent cards, skills, tasks, delegation flows"}]},{"id":"blk-5775","spans":[{"id":"spn-5703","text":"Agent discovery, advertised skills, delegation and inter-agent interaction"}]},{"id":"blk-5776","spans":[{"id":"spn-5704","text":"How internal cognitive capabilities are composed or validated before publication"}]},{"id":"blk-5777","spans":[{"id":"spn-5705","text":"[&] can generate A2A agent cards"}]}],[{"id":"blk-5778","spans":[{"id":"spn-5706","marks":["bold"],"text":"ACP"}]},{"id":"blk-5779","spans":[{"id":"spn-5707","text":"Lightweight agent communication"}]},{"id":"blk-5780","spans":[{"id":"spn-5708","text":"Communication"}]},{"id":"blk-5781","spans":[{"id":"spn-5709","text":"HTTP/REST-style agent endpoints and message exchange"}]},{"id":"blk-5782","spans":[{"id":"spn-5710","text":"Inter-agent messaging and integration patterns over standard web infrastructure"}]},{"id":"blk-5783","spans":[{"id":"spn-5711","text":"Capability algebra, provenance semantics, governance-as-data, typed capability composition"}]},{"id":"blk-5784","spans":[{"id":"spn-5712","text":"Adjacent network protocol; [&] sits at a different concern boundary"}]}],[{"id":"blk-5785","spans":[{"id":"spn-5713","marks":["bold"],"text":"DALIA"}]},{"id":"blk-5786","spans":[{"id":"spn-5714","text":"Research framework for compositional intelligence"}]},{"id":"blk-5787","spans":[{"id":"spn-5715","text":"Research / Theory"}]},{"id":"blk-5788","spans":[{"id":"spn-5716","text":"Cognitive architecture model"}]},{"id":"blk-5789","spans":[{"id":"spn-5717","text":"Why modular, compositional agent intelligence matters; academic framing for layered capability systems"}]},{"id":"blk-5790","spans":[{"id":"spn-5718","text":"A production-ready protocol artifact, schema, CLI, registry, or runtime config format"}]},{"id":"blk-5791","spans":[{"id":"spn-5719","text":"Independent conceptual validation of the gap [&] addresses"}]}]]},{"id":"blk-5792","kind":"heading","level":2,"spans":[{"id":"spn-5720","text":"Quick Definitions"}]},{"id":"blk-5793","kind":"heading","level":3,"spans":[{"id":"spn-5721","text":"[&] Protocol"}]},{"id":"blk-5794","kind":"paragraph","spans":[{"id":"spn-5722","text":"An open, language-agnostic protocol for composing agent cognitive capabilities. It defines:"}]},{"id":"blk-5795","items":[{"blocks":[{"id":"blk-5797","kind":"paragraph","spans":[{"id":"spn-5723","text":"canonical "},{"id":"spn-5724","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-5796","kind":"list-item"},{"blocks":[{"id":"blk-5799","kind":"paragraph","spans":[{"id":"spn-5725","text":"capability primitives like "},{"id":"spn-5726","marks":["code"],"text":"&memory"},{"id":"spn-5727","text":", "},{"id":"spn-5728","marks":["code"],"text":"&reason"},{"id":"spn-5729","text":", "},{"id":"spn-5730","marks":["code"],"text":"&time"},{"id":"spn-5731","text":", "},{"id":"spn-5732","marks":["code"],"text":"&space"},{"id":"spn-5733","text":", and "},{"id":"spn-5734","marks":["code"],"text":"&govern"}]}],"id":"blk-5798","kind":"list-item"},{"blocks":[{"id":"blk-5801","kind":"paragraph","spans":[{"id":"spn-5735","text":"namespaced subtypes like "},{"id":"spn-5736","marks":["code"],"text":"&memory.graph"},{"id":"spn-5737","text":" and "},{"id":"spn-5738","marks":["code"],"text":"&time.anomaly"}]}],"id":"blk-5800","kind":"list-item"},{"blocks":[{"id":"blk-5803","kind":"paragraph","spans":[{"id":"spn-5739","text":"capability contracts with typed operations"}]}],"id":"blk-5802","kind":"list-item"},{"blocks":[{"id":"blk-5805","kind":"paragraph","spans":[{"id":"spn-5740","text":"composition algebra properties"}]}],"id":"blk-5804","kind":"list-item"},{"blocks":[{"id":"blk-5807","kind":"paragraph","spans":[{"id":"spn-5741","text":"provenance records"}]}],"id":"blk-5806","kind":"list-item"},{"blocks":[{"id":"blk-5809","kind":"paragraph","spans":[{"id":"spn-5742","text":"governance constraints"}]}],"id":"blk-5808","kind":"list-item"},{"blocks":[{"id":"blk-5811","kind":"paragraph","spans":[{"id":"spn-5743","text":"compilation targets such as MCP and A2A artifacts"}]}],"id":"blk-5810","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5812","kind":"heading","level":3,"spans":[{"id":"spn-5744","text":"MCP"}]},{"id":"blk-5813","kind":"paragraph","spans":[{"id":"spn-5745","text":"The Model Context Protocol focuses on connecting agents to tools, resources, and prompts. It standardizes the agent-to-tool interface, not the internal capability model of the agent."}]},{"id":"blk-5814","kind":"heading","level":3,"spans":[{"id":"spn-5746","text":"A2A"}]},{"id":"blk-5815","kind":"paragraph","spans":[{"id":"spn-5747","text":"The Agent-to-Agent Protocol focuses on how agents discover each other, advertise skills, and coordinate tasks. It assumes an agent already exists and exposes an interaction surface."}]},{"id":"blk-5816","kind":"heading","level":3,"spans":[{"id":"spn-5748","text":"ACP"}]},{"id":"blk-5817","kind":"paragraph","spans":[{"id":"spn-5749","text":"The Agent Communication Protocol focuses on interoperable communication between agents or agent-like services, often through lightweight network-native interfaces."}]},{"id":"blk-5818","kind":"heading","level":3,"spans":[{"id":"spn-5750","text":"DALIA"}]},{"id":"blk-5819","kind":"paragraph","spans":[{"id":"spn-5751","text":"A research effort that treats intelligence as compositional and layered. DALIA helps articulate why capability composition matters, but it is not itself a deployable protocol specification in the same sense."}]},{"id":"blk-5820","kind":"heading","level":2,"spans":[{"id":"spn-5752","text":"The Stack View"}]},{"id":"blk-5821","kind":"paragraph","spans":[{"id":"spn-5753","text":"A useful mental model is:"}]},{"head":[{"id":"blk-5823","spans":[{"id":"spn-5754","text":"Layer"}]},{"id":"blk-5824","spans":[{"id":"spn-5755","text":"Question"}]},{"id":"blk-5825","spans":[{"id":"spn-5756","text":"Example Protocols"}]}],"id":"blk-5822","kind":"table","rows":[[{"id":"blk-5826","spans":[{"id":"spn-5757","text":"UI"}]},{"id":"blk-5827","spans":[{"id":"spn-5758","text":"How does the agent render and interact with users?"}]},{"id":"blk-5828","spans":[{"id":"spn-5759","text":"AG-UI, A2UI"}]}],[{"id":"blk-5829","spans":[{"id":"spn-5760","marks":["bold"],"text":"Composition"}]},{"id":"blk-5830","spans":[{"id":"spn-5761","text":"What capabilities make up this agent, and how do they fit together?"}]},{"id":"blk-5831","spans":[{"id":"spn-5762","marks":["bold"],"text":"[&]"}]}],[{"id":"blk-5832","spans":[{"id":"spn-5763","text":"Coordination"}]},{"id":"blk-5833","spans":[{"id":"spn-5764","text":"How do agents discover and delegate to each other?"}]},{"id":"blk-5834","spans":[{"id":"spn-5765","text":"A2A"}]}],[{"id":"blk-5835","spans":[{"id":"spn-5766","text":"Context"}]},{"id":"blk-5836","spans":[{"id":"spn-5767","text":"How does an agent access tools and resources?"}]},{"id":"blk-5837","spans":[{"id":"spn-5768","text":"MCP"}]}],[{"id":"blk-5838","spans":[{"id":"spn-5769","text":"Communication"}]},{"id":"blk-5839","spans":[{"id":"spn-5770","text":"How do services and agents exchange messages over networks?"}]},{"id":"blk-5840","spans":[{"id":"spn-5771","text":"ACP, HTTP, gRPC"}]}]]},{"id":"blk-5841","kind":"paragraph","spans":[{"id":"spn-5772","text":"This is why [&] should not be framed as \"above\" MCP or A2A in a political or replacement sense. A better and more accurate statement is:"}]},{"blocks":[{"id":"blk-5843","kind":"paragraph","spans":[{"id":"spn-5773","text":"[&] defines the composition layer and compiles into MCP + A2A configurations."}]}],"id":"blk-5842","kind":"quote"},{"id":"blk-5844","kind":"heading","level":2,"spans":[{"id":"spn-5774","text":"Where MCP Is Strong"}]},{"id":"blk-5845","kind":"paragraph","spans":[{"id":"spn-5775","text":"MCP is strong when you need:"}]},{"id":"blk-5846","items":[{"blocks":[{"id":"blk-5848","kind":"paragraph","spans":[{"id":"spn-5776","text":"a standard way to expose tools"}]}],"id":"blk-5847","kind":"list-item"},{"blocks":[{"id":"blk-5850","kind":"paragraph","spans":[{"id":"spn-5777","text":"structured resources and prompts"}]}],"id":"blk-5849","kind":"list-item"},{"blocks":[{"id":"blk-5852","kind":"paragraph","spans":[{"id":"spn-5778","text":"agent access to external systems"}]}],"id":"blk-5851","kind":"list-item"},{"blocks":[{"id":"blk-5854","kind":"paragraph","spans":[{"id":"spn-5779","text":"clear client/server boundaries"}]}],"id":"blk-5853","kind":"list-item"},{"blocks":[{"id":"blk-5856","kind":"paragraph","spans":[{"id":"spn-5780","text":"tool interoperability across runtimes"}]}],"id":"blk-5855","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5857","kind":"paragraph","spans":[{"id":"spn-5781","text":"MCP is not trying to answer questions like:"}]},{"id":"blk-5858","items":[{"blocks":[{"id":"blk-5860","kind":"paragraph","spans":[{"id":"spn-5782","text":"Should this agent have episodic memory or graph memory?"}]}],"id":"blk-5859","kind":"list-item"},{"blocks":[{"id":"blk-5862","kind":"paragraph","spans":[{"id":"spn-5783","text":"Is "},{"id":"spn-5784","marks":["code"],"text":"&time.anomaly"},{"id":"spn-5785","text":" compatible with "},{"id":"spn-5786","marks":["code"],"text":"&reason.argument"},{"id":"spn-5787","text":" in this pipeline?"}]}],"id":"blk-5861","kind":"list-item"},{"blocks":[{"id":"blk-5864","kind":"paragraph","spans":[{"id":"spn-5788","text":"What governance rules constrain this agent's actions?"}]}],"id":"blk-5863","kind":"list-item"},{"blocks":[{"id":"blk-5866","kind":"paragraph","spans":[{"id":"spn-5789","text":"How do I preserve a provenance chain across composed cognition?"}]}],"id":"blk-5865","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5867","kind":"paragraph","spans":[{"id":"spn-5790","text":"Those are composition-layer concerns, which is exactly why [&] exists."}]},{"id":"blk-5868","kind":"heading","level":2,"spans":[{"id":"spn-5791","text":"Where A2A Is Strong"}]},{"id":"blk-5869","kind":"paragraph","spans":[{"id":"spn-5792","text":"A2A is strong when you need:"}]},{"id":"blk-5870","items":[{"blocks":[{"id":"blk-5872","kind":"paragraph","spans":[{"id":"spn-5793","text":"agent discovery"}]}],"id":"blk-5871","kind":"list-item"},{"blocks":[{"id":"blk-5874","kind":"paragraph","spans":[{"id":"spn-5794","text":"advertised skills"}]}],"id":"blk-5873","kind":"list-item"},{"blocks":[{"id":"blk-5876","kind":"paragraph","spans":[{"id":"spn-5795","text":"task delegation"}]}],"id":"blk-5875","kind":"list-item"},{"blocks":[{"id":"blk-5878","kind":"paragraph","spans":[{"id":"spn-5796","text":"multi-agent workflow handoff"}]}],"id":"blk-5877","kind":"list-item"},{"blocks":[{"id":"blk-5880","kind":"paragraph","spans":[{"id":"spn-5797","text":"machine-readable agent cards"}]}],"id":"blk-5879","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5881","kind":"paragraph","spans":[{"id":"spn-5798","text":"A2A starts from the perspective that an agent has already been built and is now publishing its capabilities outward."}]},{"id":"blk-5882","kind":"paragraph","spans":[{"id":"spn-5799","text":"[&] starts earlier. It defines how the agent is composed in the first place."}]},{"id":"blk-5883","kind":"paragraph","spans":[{"id":"spn-5800","text":"That makes the relationship complementary:"}]},{"id":"blk-5884","items":[{"blocks":[{"id":"blk-5886","kind":"paragraph","spans":[{"id":"spn-5801","marks":["bold"],"text":"[&]"},{"id":"spn-5802","text":" describes internal composition"}]}],"id":"blk-5885","kind":"list-item"},{"blocks":[{"id":"blk-5888","kind":"paragraph","spans":[{"id":"spn-5803","marks":["bold"],"text":"A2A"},{"id":"spn-5804","text":" describes external coordination"}]}],"id":"blk-5887","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5889","kind":"heading","level":2,"spans":[{"id":"spn-5805","text":"Where ACP Is Strong"}]},{"id":"blk-5890","kind":"paragraph","spans":[{"id":"spn-5806","text":"ACP is strong when you need:"}]},{"id":"blk-5891","items":[{"blocks":[{"id":"blk-5893","kind":"paragraph","spans":[{"id":"spn-5807","text":"lightweight inter-agent communication"}]}],"id":"blk-5892","kind":"list-item"},{"blocks":[{"id":"blk-5895","kind":"paragraph","spans":[{"id":"spn-5808","text":"simple network-native interfaces"}]}],"id":"blk-5894","kind":"list-item"},{"blocks":[{"id":"blk-5897","kind":"paragraph","spans":[{"id":"spn-5809","text":"integration over common web patterns"}]}],"id":"blk-5896","kind":"list-item"},{"blocks":[{"id":"blk-5899","kind":"paragraph","spans":[{"id":"spn-5810","text":"deployable communication surfaces without requiring tool-specific semantics"}]}],"id":"blk-5898","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5900","kind":"paragraph","spans":[{"id":"spn-5811","text":"ACP is closest to a communications substrate. It is useful for transport and interoperability, but it does not define:"}]},{"id":"blk-5901","items":[{"blocks":[{"id":"blk-5903","kind":"paragraph","spans":[{"id":"spn-5812","text":"capability primitives"}]}],"id":"blk-5902","kind":"list-item"},{"blocks":[{"id":"blk-5905","kind":"paragraph","spans":[{"id":"spn-5813","text":"capability subtypes"}]}],"id":"blk-5904","kind":"list-item"},{"blocks":[{"id":"blk-5907","kind":"paragraph","spans":[{"id":"spn-5814","text":"composition algebra"}]}],"id":"blk-5906","kind":"list-item"},{"blocks":[{"id":"blk-5909","kind":"paragraph","spans":[{"id":"spn-5815","text":"provenance chain structure"}]}],"id":"blk-5908","kind":"list-item"},{"blocks":[{"id":"blk-5911","kind":"paragraph","spans":[{"id":"spn-5816","text":"governance constraints as portable data"}]}],"id":"blk-5910","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5912","kind":"paragraph","spans":[{"id":"spn-5817","text":"So ACP and [&] solve different problems."}]},{"id":"blk-5913","kind":"heading","level":2,"spans":[{"id":"spn-5818","text":"Why DALIA Matters Here"}]},{"id":"blk-5914","kind":"paragraph","spans":[{"id":"spn-5819","text":"DALIA is important because it strengthens the claim that there is a real conceptual gap in the ecosystem."}]},{"id":"blk-5915","kind":"paragraph","spans":[{"id":"spn-5820","text":"It supports ideas like:"}]},{"id":"blk-5916","items":[{"blocks":[{"id":"blk-5918","kind":"paragraph","spans":[{"id":"spn-5821","text":"intelligence as composition rather than monolith"}]}],"id":"blk-5917","kind":"list-item"},{"blocks":[{"id":"blk-5920","kind":"paragraph","spans":[{"id":"spn-5822","text":"modular cognitive systems"}]}],"id":"blk-5919","kind":"list-item"},{"blocks":[{"id":"blk-5922","kind":"paragraph","spans":[{"id":"spn-5823","text":"layered capabilities"}]}],"id":"blk-5921","kind":"list-item"},{"blocks":[{"id":"blk-5924","kind":"paragraph","spans":[{"id":"spn-5824","text":"architectural clarity between memory, reasoning, planning, governance, and execution"}]}],"id":"blk-5923","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-5925","kind":"paragraph","spans":[{"id":"spn-5825","text":"That is useful because [&] is not just inventing a product category. It is operationalizing a real architectural need into:"}]},{"id":"blk-5926","items":[{"blocks":[{"id":"blk-5928","kind":"paragraph","spans":[{"id":"spn-5826","text":"schema artifacts"}]}],"id":"blk-5927","kind":"list-item"},{"blocks":[{"id":"blk-5930","kind":"paragraph","spans":[{"id":"spn-5827","text":"machine-readable contracts"}]}],"id":"blk-5929","kind":"list-item"}