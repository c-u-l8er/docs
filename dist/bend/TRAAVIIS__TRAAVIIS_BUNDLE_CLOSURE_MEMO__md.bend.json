:[{"id":"spn-46994","text":"pack writes and publishes the complete tree atomically"}]},{"id":"blk-32923","spans":[{"id":"spn-46995","marks":["code"],"text":"test_d19_pack_writes_and_publishes_the_complete_tree_atomically"}]}],[{"id":"blk-32924","spans":[{"id":"spn-46996","text":"D20"}]},{"id":"blk-32925","spans":[{"id":"spn-46997","text":"a failed pack leaves no destination or partial bundle"}]},{"id":"blk-32926","spans":[{"id":"spn-46998","marks":["code"],"text":"test_d20_a_failed_pack_leaves_no_destination_or_partial_bundle"}]}],[{"id":"blk-32927","spans":[{"id":"spn-46999","text":"D21"}]},{"id":"blk-32928","spans":[{"id":"spn-47000","text":"reopening proves "},{"id":"spn-47001","marks":["bold"],"text":"both"},{"id":"spn-47002","text":" identities"}]},{"id":"blk-32929","spans":[{"id":"spn-47003","marks":["code"],"text":"test_d21_reopening_proves_both_bundle_and_environment_identities"}]}],[{"id":"blk-32930","spans":[{"id":"spn-47004","text":"D22"}]},{"id":"blk-32931","spans":[{"id":"spn-47005","text":"ZIP metadata changes do not move "},{"id":"spn-47006","marks":["code"],"text":"bundle-…"}]},{"id":"blk-32932","spans":[{"id":"spn-47007","marks":["code"],"text":"test_d22_zip_metadata_changes_do_not_move_the_bundle"}]}],[{"id":"blk-32933","spans":[{"id":"spn-47008","text":"D23"}]},{"id":"blk-32934","spans":[{"id":"spn-47009","text":"ZIP and tar extractions of one tree derive the same id"}]},{"id":"blk-32935","spans":[{"id":"spn-47010","marks":["code"],"text":"test_d23_zip_and_tar_extractions_of_one_tree_derive_the_same_id"}]}],[{"id":"blk-32936","spans":[{"id":"spn-47011","text":"D24"}]},{"id":"blk-32937","spans":[{"id":"spn-47012","text":"canonical ZIP builds are byte-identical"}]},{"id":"blk-32938","spans":[{"id":"spn-47013","marks":["code"],"text":"test_d24_canonical_zip_builds_are_byte_identical"}]}],[{"id":"blk-32939","spans":[{"id":"spn-47014","text":"D25"}]},{"id":"blk-32940","spans":[{"id":"spn-47015","text":"the archive SHA-256 stays distinct from "},{"id":"spn-47016","marks":["code"],"text":"bundle-…"}]},{"id":"blk-32941","spans":[{"id":"spn-47017","marks":["code"],"text":"test_d25_the_archive_sha256_stays_distinct_from_the_bundle"}]}],[{"id":"blk-32942","spans":[{"id":"spn-47018","text":"D26"}]},{"id":"blk-32943","spans":[{"id":"spn-47019","text":"the packet SHA-256 is never interpreted as a bundle"}]},{"id":"blk-32944","spans":[{"id":"spn-47020","marks":["code"],"text":"test_d26_the_packet_sha256_is_never_interpreted_as_a_bundle"}]}],[{"id":"blk-32945","spans":[{"id":"spn-47021","text":"D27"}]},{"id":"blk-32946","spans":[{"id":"spn-47022","text":"evaluation and batch reports gain no bundle identity"}]},{"id":"blk-32947","spans":[{"id":"spn-47023","marks":["code"],"text":"test_d27_evaluation_and_batch_reports_gain_no_bundle_identity"}]}],[{"id":"blk-32948","spans":[{"id":"spn-47024","text":"D28"}]},{"id":"blk-32949","spans":[{"id":"spn-47025","text":"presentation-only edits move no "},{"id":"spn-47026","marks":["code"],"text":"episode-…"}]},{"id":"blk-32950","spans":[{"id":"spn-47027","marks":["code"],"text":"test_d28_presentation_only_edits_move_no_episode_identity"}]}],[{"id":"blk-32951","spans":[{"id":"spn-47028","text":"D29"}]},{"id":"blk-32952","spans":[{"id":"spn-47029","text":"the serial-batch and comparison batteries remain green"}]},{"id":"blk-32953","spans":[{"id":"spn-47030","marks":["code"],"text":"test_d29_the_serial_batch_and_comparison_batteries_remain_green"}]}],[{"id":"blk-32954","spans":[{"id":"spn-47031","text":"D30"}]},{"id":"blk-32955","spans":[{"id":"spn-47032","text":"the CLI surface is complete and typed"}]},{"id":"blk-32956","spans":[{"id":"spn-47033","marks":["code"],"text":"test_d30_the_cli_surface_is_complete_and_typed"}]}]]},{"id":"blk-32957","kind":"heading","level":2,"spans":[{"id":"spn-47034","text":"4. A latent defect this slice closed"}]},{"id":"blk-32958","kind":"paragraph","spans":[{"id":"spn-47035","marks":["code"],"text":"pack"},{"id":"spn-47036","text":" wrote every member at the process umask default. The Residency snapshot seals "},{"id":"spn-47037","marks":["bold"],"text":"raw four-digit `file_modes`"},{"id":"spn-47038","text":" into "},{"id":"spn-47039","marks":["code"],"text":"snap-…"},{"id":"spn-47040","text":", so a package shipping an executable subject file would have failed to reopen itself — "},{"id":"spn-47041","marks":["code"],"text":"pack"},{"id":"spn-47042","text":" would have recomputed a snapshot identity that disagreed with the one it had just written."}]},{"id":"blk-32959","kind":"paragraph","spans":[{"id":"spn-47043","text":"It stayed invisible only because every scaffolded template happens to be "},{"id":"spn-47044","marks":["code"],"text":"0644"},{"id":"spn-47045","text":", so the umask default coincided with the sealed mode. Closed by carrying a "},{"id":"spn-47046","marks":["code"],"text":"modes"},{"id":"spn-47047","text":" map through "},{"id":"spn-47048","marks":["code"],"text":"_read_member"},{"id":"spn-47049","text":" → "},{"id":"spn-47050","marks":["code"],"text":"_stage"},{"id":"spn-47051","text":" → "},{"id":"spn-47052","marks":["code"],"text":"os.chmod"},{"id":"spn-47053","text":", so members are written at their "},{"id":"spn-47054","marks":["bold"],"text":"exact"},{"id":"spn-47055","text":" source mode."}]},{"id":"blk-32960","kind":"heading","level":2,"spans":[{"id":"spn-47056","text":"5. Two defects the gates caught in the battery itself"}]},{"id":"blk-32961","kind":"paragraph","spans":[{"id":"spn-47057","text":"Both were found after D1–D30 was already green, by the acceptance gates rather than by the laws. Recording them because in both cases the "},{"id":"spn-47058","marks":["italic"],"text":"test"},{"id":"spn-47059","text":" was wrong in a way that made the code look better than it was."}]},{"id":"blk-32962","kind":"paragraph","spans":[{"id":"spn-47060","marks":["bold"],"text":"G5 — the battery crashed with no engine."},{"id":"spn-47061","text":" "},{"id":"spn-47062","marks":["code"],"text":"run_battery"},{"id":"spn-47063","text":" under a genuinely isolated extraction has no TRVM checkout above it, and every "},{"id":"spn-47064","marks":["code"],"text":"trvs pack"},{"id":"spn-47065","text":" needs the engine (the "},{"id":"spn-47066","marks":["code"],"text":"residency-repair"},{"id":"spn-47067","text":" template pins an "},{"id":"spn-47068","marks":["code"],"text":"identity_policy"},{"id":"spn-47069","text":" on a "},{"id":"spn-47070","marks":["code"],"text":".wrl"},{"id":"spn-47071","text":" world). The battery raised "},{"id":"spn-47072","marks":["code"],"text":"ENGINE_UNAVAILABLE"},{"id":"spn-47073","text":" out of the fixture instead of skipping. Its own docstring claimed \"the Residency substrate needs no engine, so nearly every law here runs everywhere\" — which was simply false."}]},{"id":"blk-32963","kind":"paragraph","spans":[{"id":"spn-47074","text":"Fixed in the direction that keeps the most coverage rather than the least: the manifest, closure and transport laws (D2, D3, D14–D16, D18, D22–D26, D30) now run against a "},{"id":"spn-47075","marks":["bold"],"text":"synthetic package tree"},{"id":"spn-47076","text":" that no substrate produced, so they need no engine at all. That is the honest home for them — those are exactly the laws a "},{"id":"spn-47077","marks":["italic"],"text":"recipient"},{"id":"spn-47078","text":" relies on, and a recipient verifying a downloaded package usually has no Forge checkout. Only the genuinely environment-shaped laws skip. Engine absent: "},{"id":"spn-47079","marks":["bold"],"text":"12 passed, 18 skipped, 0 failed"},{"id":"spn-47080","text":". Engine present: "},{"id":"spn-47081","marks":["bold"],"text":"30/30"},{"id":"spn-47082","text":"."}]},{"id":"blk-32964","kind":"paragraph","spans":[{"id":"spn-47083","marks":["bold"],"text":"D22's own fixture dropped the executable bit."},{"id":"spn-47084","text":" The synthetic tree added a "},{"id":"spn-47085","marks":["code"],"text":"0755"},{"id":"spn-47086","text":" member — the packed fixture has none, every scaffolded file being "},{"id":"spn-47087","marks":["code"],"text":"0644"},{"id":"spn-47088","text":" — and immediately failed "},{"id":"spn-47089","marks":["code"],"text":"BUNDLE_MEMBER_MODE"},{"id":"spn-47090","text":". The helper that builds a \"non-canonical\" ZIP was hardcoding "},{"id":"spn-47091","marks":["code"],"text":"0o644"},{"id":"spn-47092","text":" into "},{"id":"spn-47093","marks":["code"],"text":"external_attr"},{"id":"spn-47094","text":"."}]},{"id":"blk-32965","kind":"paragraph","spans":[{"id":"spn-47095","text":"That refusal was "},{"id":"spn-47096","marks":["bold"],"text":"correct"},{"id":"spn-47097","text":": mode is identity-bearing, so an archive that drops the executable bit is carrying different content and must fail. The bug was the fixture claiming to vary only transport while actually mutating the package. It now carries each member's declared canonical mode, so D22 varies order, compression, timestamps and comments — and nothing else, which is the claim it was always supposed to be making."}]},{"id":"blk-32966","kind":"heading","level":2,"spans":[{"id":"spn-47098","text":"6. Known caveat — canonical mode vs sealed mode"}]},{"blocks":[{"id":"blk-32968","kind":"paragraph","spans":[{"id":"spn-47099","marks":["bold"],"text":"Closed."},{"id":"spn-47100","text":" The fifth ruling's reviewer ruled this caveat a reachable correctness defect rather than an acceptable residual, and it was closed in the following slice exactly as §6 predicted it would have to be: "},{"id":"spn-47101","marks":["code"],"text":"pack"},{"id":"spn-47102","text":" now refuses to seal a subject with a non-canonical mode at authoring time. See "},{"id":"spn-47103","marks":["code"],"text":"TRAAVIIS_PORTABLE_MODE_MEMO.md"},{"id":"spn-47104","text":" and RFC §5c. The rest of this section is kept as written, because it is the analysis the fix was built from."}]}],"id":"blk-32967","kind":"quote"},{"id":"blk-32969","kind":"paragraph","spans":[{"id":"spn-47105","text":"The mode question has two correct answers and this slice ships both, on purpose:"}]},{"id":"blk-32970","items":[{"blocks":[{"id":"blk-32972","kind":"paragraph","spans":[{"id":"spn-47106","marks":["bold"],"text":"`bundle-…` carries the canonical mode"},{"id":"spn-47107","text":" ("},{"id":"spn-47108","marks":["code"],"text":"0644"},{"id":"spn-47109","text":"/"},{"id":"spn-47110","marks":["code"],"text":"0755"},{"id":"spn-47111","text":" — only the executable"}]}],"id":"blk-32971","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32973","kind":"paragraph","spans":[{"id":"spn-47112","text":"bit). It must, or a ZIP and tar round trip of one package would disagree, and group/other/umask noise would count as a package change."}]},{"id":"blk-32974","items":[{"blocks":[{"id":"blk-32976","kind":"paragraph","spans":[{"id":"spn-47113","marks":["bold"],"text":"`pack` writes the exact source mode."},{"id":"spn-47114","text":" It must, or "},{"id":"spn-47115","marks":["code"],"text":"snap-…"},{"id":"spn-47116","text":" would not"}]}],"id":"blk-32975","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32977","kind":"paragraph","spans":[{"id":"spn-47117","text":"reproduce."}]},{"id":"blk-32978","kind":"paragraph","spans":[{"id":"spn-47118","text":"The residual: a canonical archive normalizes e.g. "},{"id":"spn-47119","marks":["code"],"text":"0664"},{"id":"spn-47120","text":" → "},{"id":"spn-47121","marks":["code"],"text":"0644"},{"id":"spn-47122","text":". A substrate that seals raw modes would notice that, so a package whose subject files carry non-canonical modes can round-trip through an archive and fail its "},{"id":"spn-47123","marks":["italic"],"text":"substrate"},{"id":"spn-47124","text":" reopen while passing its "},{"id":"spn-47125","marks":["italic"],"text":"bundle"},{"id":"spn-47126","text":" reopen. Recording this rather than papering over it. It cannot be fixed by loosening either identity — the honest fix, if it ever bites, is for "},{"id":"spn-47127","marks":["code"],"text":"pack"},{"id":"spn-47128","text":" to refuse to seal a subject with a non-canonical mode at authoring time, which is a new admission law and needs a ruling."}]},{"id":"blk-32979","kind":"heading","level":2,"spans":[{"id":"spn-47129","text":"7. Autonomous decisions (flagged for review)"}]},{"id":"blk-32980","items":[{"blocks":[{"id":"blk-32982","kind":"paragraph","spans":[{"id":"spn-47130","marks":["bold"],"text":"`assets` added to the `distribution` block"},{"id":"spn-47131","text":" alongside the ruled"}]}],"id":"blk-32981","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-32983","kind":"paragraph","spans":[{"id":"spn-47132","marks":["code"],"text":"entrypoint"},{"id":"spn-47133","text":" / "},{"id":"spn-47134","marks":["code"],"text":"documentation"},{"id":"spn-47135","text":" / "},{"id":"spn-47136","marks":["code"],"text":"screenshots"},{"id":"spn-47137","text":". Presentation-only like its siblings; excluded from "},{"id":"spn-47138","marks":["code"],"text":"env-…"},{"id":"spn-47139","text":" by the same allowlist."}]},{"id":"blk-32984","items":[{"blocks":[{"id":"blk-32986","kind":"paragraph","spans":[{"id":"spn-47140","marks":["bold"],"text":"`TRAAVIIS_BUNDLE.json` skipped during tree scan"},{"id":"spn-47141","text":", so the manifest never"}]}],"id":"blk-32985","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-32987","kind":"paragraph","spans":[{"id":"spn-47142","text":"appears in its own "},{"id":"spn-47143","marks":["code"],"text":"members"},{"id":"spn-47144","text":". This is the ruled self-exclusion made operational."}]},{"id":"blk-32988","items":[{"blocks":[{"id":"blk-32990","kind":"paragraph","spans":[{"id":"spn-47145","marks":["bold"],"text":"Symlinks refused for directories as well as files."},{"id":"spn-47146","text":" The ruling said"}]}],"id":"blk-32989","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-32991","kind":"paragraph","spans":[{"id":"spn-47147","text":"symlinks are refused in v1; a symlinked "},{"id":"spn-47148","marks":["italic"],"text":"directory"},{"id":"spn-47149","text":" is the same escape."}]},{"id":"blk-32992","items":[{"blocks":[{"id":"blk-32994","kind":"paragraph","spans":[{"id":"spn-47150","marks":["bold"],"text":"`verify-bundle` accepts an archive"},{"id":"spn-47151","text":" as well as a directory, extracting to"}]}],"id":"blk-32993","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-32995","kind":"paragraph","spans":[{"id":"spn-47152","text":"a temp tree and running the identical verifier. Without it, D23's law is stated but not usable from the CLI."}]},{"id":"blk-32996","items":[{"blocks":[{"id":"blk-32998","kind":"paragraph","spans":[{"id":"spn-47153","marks":["bold"],"text":"Verification moved before publication."},{"id":"spn-47154","text":" The previous pack order published,"}]}],"id":"blk-32997","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-32999","kind":"paragraph","spans":[{"id":"spn-47155","text":"verified, then "},{"id":"spn-47156","marks":["code"],"text":"rmtree"},{"id":"spn-47157","text":"d on failure. The ruled order verifies the staged sibling, so a failed pack never occupies the destination even briefly. D20 asserts no "},{"id":"spn-47158","marks":["code"],"text":".trvs-pack-"},{"id":"spn-47159","text":" leftovers."}]},{"id":"blk-33000","items":[{"blocks":[{"id":"blk-33002","kind":"paragraph","spans":[{"id":"spn-47160","text":"**"},{"id":"spn-47161","marks":["code"],"text":"D27"},{"id":"spn-47162","text":" tests bundle "},{"id":"spn-47163","marks":["italic"],"text":"identity"},{"id":"spn-47164","text":", not the word \"bundle\".** "},{"id":"spn-47165","marks":["code"],"text":"EvaluationV1"},{"id":"spn-47166","text":" has"}]}],"id":"blk-33001","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-33003","kind":"paragraph","spans":[{"id":"spn-47167","text":"carried a field literally named "},{"id":"spn-47168","marks":["code"],"text":"bundle"},{"id":"spn-47169","text":" since the Episode Evidence Closure; it names the "},{"id":"spn-47170","marks":["code"],"text":"episode-…"},{"id":"spn-47171","text":" evidence directory an episode was kept in. Renaming it would break "},{"id":"spn-47172","marks":["code"],"text":"batch.py"},{"id":"spn-47173","text":" and the B-battery for no identity reason, and the ruling itself accepts the two senses coexisting (it froze "},{"id":"spn-47174","marks":["code"],"text":"TRAAVIIS_BUNDLE.json"},{"id":"spn-47175","text":" as distinct from "},{"id":"spn-47176","marks":["code"],"text":"bundle.json"},{"id":"spn-47177","text":"). So D27 asserts no "},{"id":"spn-47178","marks":["code"],"text":"bundle_id"},{"id":"spn-47179","text":" key and no "},{"id":"spn-47180","marks":["code"],"text":"bundle-…"},{"id":"spn-47181","text":" value anywhere, "},{"id":"spn-47182","marks":["bold"],"text":"and"},{"id":"spn-47183","text":" pins the collision shut from the other side by requiring every surviving "},{"id":"spn-47184","marks":["code"],"text":"bundle"},{"id":"spn-47185","text":" field to hold an "},{"id":"spn-47186","marks":["code"],"text":"episode-…"},{"id":"spn-47187","text":" directory — which is what stops the old field from ever being read as the new identity."}]},{"id":"blk-33004","items":[{"blocks":[{"id":"blk-33006","kind":"paragraph","spans":[{"id":"spn-47188","marks":["bold"],"text":"The structural laws were moved onto a synthetic tree"},{"id":"spn-47189","text":" rather than made to"}]}],"id":"blk-33005","kind":"list-item"}],"kind":"list","ordered":true,"start":7},{"id":"blk-33007","kind":"paragraph","spans":[{"id":"spn-47190","text":"skip, so a recipient's laws keep running on a recipient's machine. See §5."}]},{"id":"blk-33008","kind":"heading","level":2,"spans":[{"id":"spn-47191","text":"8. Not started (deferred by ruling)"}]},{"id":"blk-33009","kind":"paragraph","spans":[{"id":"spn-47192","text":"Batch-evidence distribution identity (needs a separate ruling), "},{"id":"spn-47193","marks":["code"],"text":"eval-…"},{"id":"spn-47194","text":", "},{"id":"spn-47195","marks":["code"],"text":"agent-…"},{"id":"spn-47196","text":", ORS, "},{"id":"spn-47197","marks":["code"],"text":"trvs serve --ors/--mcp"},{"id":"spn-47198","text":", MCP, the REPL."}]}],"edges":[],"id":"bagaaieranj47b3vzmjgwp7krht2gdbtk3gj6cn23jsiwufzprqgt5yn7o3ua","vocabulary":"ampersand.docs.fs.v1"}