{"bendscript":"0.1","blocks":[{"id":"blk-32820","kind":"heading","level":1,"spans":[{"id":"spn-46826","text":"Bundle Distribution Identity Closure — memo"}]},{"id":"blk-32821","kind":"paragraph","spans":[{"id":"spn-46827","marks":["bold"],"text":"Slice:"},{"id":"spn-46828","text":" "},{"id":"spn-46829","marks":["code"],"text":"bundle-…"},{"id":"spn-46830","text":", the eighth and topmost rung of the TRAAVIIS identity ladder. "},{"id":"spn-46831","marks":["bold"],"text":"Status:"},{"id":"spn-46832","text":" shipped. "},{"id":"spn-46833","marks":["bold"],"text":"Battery:"},{"id":"spn-46834","text":" D1–D30, 30 passed / 0 skipped / 0 failed."}]},{"id":"blk-32822","kind":"paragraph","spans":[{"id":"spn-46835","text":"Ruled by the fifth GPT-5.6 ruling, verbatim:"}]},{"blocks":[{"id":"blk-32824","kind":"paragraph","spans":[{"id":"spn-46836","text":"Implement "},{"id":"spn-46837","marks":["code"],"text":"bundle-…"},{"id":"spn-46838","text":" as the content address of the complete canonical environment-distribution tree emitted by "},{"id":"spn-46839","marks":["code"],"text":"trvs pack"},{"id":"spn-46840","text":": environment closure plus every shipped presentation, documentation and screenshot member, identified by normalized path, bytes and mode. Keep ZIP SHA-256 as a transport checksum, keep "},{"id":"spn-46841","marks":["code"],"text":"accept_packet.py"},{"id":"spn-46842","text":" as a source-release gate, and keep EvaluationV1, ComparisonV1 and SerialBatchV1 free of bundle identity."}]}],"id":"blk-32823","kind":"quote"},{"id":"blk-32825","kind":"heading","level":2,"spans":[{"id":"spn-46843","text":"1. What was built"}]},{"head":[{"id":"blk-32827","spans":[{"id":"spn-46844","text":"file"}]},{"id":"blk-32828","spans":[{"id":"spn-46845","text":"change"}]}],"id":"blk-32826","kind":"table","rows":[[{"id":"blk-32829","spans":[{"id":"spn-46846","marks":["code"],"text":"traaviis/identity.py"}]},{"id":"blk-32830","spans":[{"id":"spn-46847","text":"new rung: "},{"id":"spn-46848","marks":["code"],"text":"canonicalize_bundle"},{"id":"spn-46849","text":" / "},{"id":"spn-46850","marks":["code"],"text":"bundle_id"},{"id":"spn-46851","text":". Unlike every other rung nothing is projected out but the id field itself — the manifest "},{"id":"spn-46852","marks":["italic"],"text":"is"},{"id":"spn-46853","text":" the package, so an added field is a changed package."}]}],[{"id":"blk-32831","spans":[{"id":"spn-46854","marks":["code"],"text":"traaviis/bundle.py"}]},{"id":"blk-32832","spans":[{"id":"spn-46855","marks":["bold"],"text":"new."},{"id":"spn-46856","text":" "},{"id":"spn-46857","marks":["code"],"text":"BundleManifestV1"},{"id":"spn-46858","text":", tree scan, manifest read, bidirectional closure verification, canonical ZIP/tar emission and extraction, transport checksum."}]}],[{"id":"blk-32833","spans":[{"id":"spn-46859","marks":["code"],"text":"traaviis/pack.py"}]},{"id":"blk-32834","spans":[{"id":"spn-46860","text":"the "},{"id":"spn-46861","marks":["code"],"text":"distribution"},{"id":"spn-46862","text":" block, presentation members, exact-mode member writes, and the ruled staged-reopen-then-publish admission order."}]}],[{"id":"blk-32835","spans":[{"id":"spn-46863","marks":["code"],"text":"traaviis/scaffold.py"}]},{"id":"blk-32836","spans":[{"id":"spn-46864","text":"all three templates declare a "},{"id":"spn-46865","marks":["code"],"text":"distribution"},{"id":"spn-46866","text":" block."}]}],[{"id":"blk-32837","spans":[{"id":"spn-46867","marks":["code"],"text":"traaviis/cli.py"}]},{"id":"blk-32838","spans":[{"id":"spn-46868","marks":["code"],"text":"trvs verify-bundle"},{"id":"spn-46869","text":" (directory "},{"id":"spn-46870","marks":["bold"],"text":"or"},{"id":"spn-46871","text":" archive), "},{"id":"spn-46872","marks":["code"],"text":"trvs archive-bundle"},{"id":"spn-46873","text":"."}]}],[{"id":"blk-32839","spans":[{"id":"spn-46874","marks":["code"],"text":"test/test_bundle.py"}]},{"id":"blk-32840","spans":[{"id":"spn-46875","marks