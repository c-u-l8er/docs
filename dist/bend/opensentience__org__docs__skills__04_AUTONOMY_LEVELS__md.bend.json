{"bendscript":"0.1","blocks":[{"id":"blk-76135","kind":"heading","level":1,"spans":[{"id":"spn-109330","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-76137","kind":"paragraph","spans":[{"id":"spn-109331","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-76136","kind":"quote"},{"id":"blk-76138","kind":"heading","level":2,"spans":[{"id":"spn-109332","text":"Why This Matters"}]},{"id":"blk-76139","kind":"paragraph","spans":[{"id":"spn-109333","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-76140","kind":"heading","level":2,"spans":[{"id":"spn-109334","text":"The Three Levels"}]},{"id":"blk-76141","kind":"heading","level":3,"spans":[{"id":"spn-109335","text":"Observe"}]},{"id":"blk-76142","kind":"paragraph","spans":[{"id":"spn-109336","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-76143","items":[{"blocks":[{"id":"blk-76145","kind":"paragraph","spans":[{"id":"spn-109337","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-109338","marks":["code"],"text":"action_recommended"}]}],"id":"blk-76144","kind":"list-item"},{"blocks":[{"id":"blk-76147","kind":"paragraph","spans":[{"id":"spn-109339","text":"No side effects are produced"}]}],"id":"blk-76146","kind":"list-item"},{"blocks":[{"id":"blk-76149","kind":"paragraph","spans":[{"id":"spn-109340","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-76148","kind":"list-item"},{"blocks":[{"id":"blk-76151","kind":"paragraph","spans":[{"id":"spn-109341","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-76150","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76152","kind":"paragraph","spans":[{"id":"spn-109342","marks":["bold"],"text":"Enforcement:"},{"id":"spn-109343","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-76153","kind":"heading","level":3,"spans":[{"id":"spn-109344","text":"Advise"}]},{"id":"blk-76154","kind":"paragraph","spans":[{"id":"spn-109345","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-76155","items":[{"blocks":[{"id":"blk-76157","kind":"paragraph","spans":[{"id":"spn-109346","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-76156","kind":"list-item"},{"blocks":[{"id":"blk-76159","kind":"paragraph","spans":[{"id":"spn-109347","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-76158","kind":"list-item"},{"blocks":[{"id":"blk-76161","kind":"paragraph","spans":[{"id":"spn-109348","text":"The operator approves or rejects each queued action"}]}],"id":"blk-76160","kind":"list-item"},{"blocks":[{"id":"blk-76163","kind":"paragraph","spans":[{"id":"spn-109349","text":"Approved actions execute with full permission checking"}]}],"id":"blk-76162","kind":"list-item"},{"blocks":[{"id":"blk-76165","kind":"paragraph","spans":[{"id":"spn-109350","text":"Rejected actions are logged as "},{"id":"spn-109351","marks":["code"],"text":"action_blocked"},{"id":"spn-109352","text":" with the rejection reason"}]}],"id":"blk-76164","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76166","kind":"paragraph","spans":[{"id":"spn-109353","marks":["bold"],"text":"Enforcement:"},{"id":"spn-109354","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-76167","kind":"heading","level":3,"spans":[{"id":"spn-109355","text":"Act"}]},{"id":"blk-76168","kind":"paragraph","spans":[{"id":"spn-109356","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-76169","items":[{"blocks":[{"id":"blk-76171","kind":"paragraph","spans":[{"id":"spn-109357","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-76170","kind":"list-item"},{"blocks":[{"id":"blk-76173","kind":"paragraph","spans":[{"id":"spn-109358","text":"Permitted actions execute immediately"}]}],"id":"blk-76172","kind":"list-item"},{"blocks":[{"id":"blk-76175","kind":"paragraph","spans":[{"id":"spn-109359","text":"Denied actions are blocked and logged as "},{"id":"spn-109360","marks":["code"],"text":"action_blocked"}]}],"id":"blk-76174","kind":"list-item"},{"blocks":[{"id":"blk-76177","kind":"paragraph","spans":[{"id":"spn-109361","text":"No human approval step"}]}],"id":"blk-76176","kind":"list-item"},{"blocks":[{"id":"blk-76179","kind":"paragraph","spans":[{"id":"spn-109362","text":"All actions are still audited as "},{"id":"spn-109363","marks":["code"],"text":"action_executed"}]}],"id":"blk-76178","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76180","kind":"paragraph","spans":[{"id":"spn-109364","marks":["bold"],"text":"Enforcement:"},{"id":"spn-109365","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-76181","kind":"heading","level":2,"spans":[{"id":"spn-109366","text":"Trust-Building Workflow"}]},{"id":"blk-76182","kind":"paragraph","spans":[{"id":"spn-109367","text":"The recommended progression for any new agent:"}]},{"id":"blk-76183","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-76184","kind":"paragraph","spans":[{"id":"spn-109368","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-109369","marks":["code"],"text":"act"},{"id":"spn-109370","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-76185","kind":"heading","level":2,"spans":[{"id":"spn-109371","text":"autonomy_level Tool"}]},{"id":"blk-76186","kind":"heading","level":3,"spans":[{"id":"spn-109372","text":"Get Current Level"}]},{"id":"blk-76187","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-76188","kind":"heading","level":3,"spans":[{"id":"spn-109373","text":"Set Level"}]},{"id":"blk-76189","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-76190","kind":"heading","level":3,"spans":[{"id":"spn-109374","text":"Parameters"}]},{"head":[{"id":"blk-76192","spans":[{"id":"spn-109375","text":"Param"}]},{"id":"blk-76193","spans":[{"id":"spn-109376","text":"Required"}]},{"id":"blk-76194","spans":[{"id":"spn-109377","text":"Type"}]},{"id":"blk-76195","spans":[{"id":"spn-109378","text":"Description"}]}],"id":"blk-76191","kind":"table","rows":[[{"id":"blk-76196","spans":[{"id":"spn-109379","marks":["code"],"text":"agent_id"}]},{"id":"blk-76197","spans":[{"id":"spn-109380","text":"Yes"}]},{"id":"blk-76198","spans":[{"id":"spn-109381","text":"string"}]},{"id":"blk-76199","spans":[{"id":"spn-109382","text":"The agent to query or update"}]}],[{"id":"blk-76200","spans":[{"id":"spn-109383","marks":["code"],"text":"level"}]},{"id":"blk-76201","spans":[{"id":"spn-109384","text":"No"}]},{"id":"blk-76202","spans":[{"id":"spn-109385","text":"string"}]},{"id":"blk-76203","spans":[{"id":"spn-109386","text":"New level: "},{"id":"spn-109387","marks":["code"],"text":"observe"},{"id":"spn-109388","text":", "},{"id":"spn-109389","marks":["code"],"text":"advise"},{"id":"spn-109390","text":", or "},{"id":"spn-109391","marks":["code"],"text":"act"},{"id":"spn-109392","text":". Omit to query."}]}]]},{"id":"blk-76204","kind":"heading","level":2,"spans":[{"id":"spn-109393","text":"Enforcement Mechanics"}]},{"id":"blk-76205","kind":"heading","level":3,"spans":[{"id":"spn-109394","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-76206","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-76207","kind":"heading","level":3,"spans":[{"id":"spn-109395","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-76208","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-76209","kind":"heading","level":3,"spans":[{"id":"spn-109396","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-76210","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-76211","kind":"heading","level":2,"spans":[{"id":"spn-109397","text":"When to Use Each Level"}]},{"head":[{"id":"blk-76213","spans":[{"id":"spn-109398","text":"Scenario"}]},{"id":"blk-76214","spans":[{"id":"spn-109399","text":"Recommended Level"}]},{"id":"blk-76215","spans":[{"id":"spn-109400","text":"Reason"}]}],"id":"blk-76212","kind":"table","rows":[[{"id":"blk-76216","spans":[{"id":"spn-109401","text":"Agent just installed, source unknown"}]},{"id":"blk-76217","spans":[{"id":"spn-109402","marks":["code"],"text":"observe"}]},{"id":"blk-76218","spans":[{"id":"spn-109403","text":"Build trust before granting power"}]}],[{"id":"blk-76219","spans":[{"id":"spn-109404","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-76220","spans":[{"id":"spn-109405","marks":["code"],"text":"observe"}]},{"id":"blk-76221","spans":[{"id":"spn-109406","text":"Third-party code needs vetting"}]}],[{"id":"blk-76222","spans":[{"id":"spn-109407","text":"Internal tool, well-tested"}]},{"id":"blk-76223","spans":[{"id":"spn-109408","marks":["code"],"text":"advise"},{"id":"spn-109409","text":" or "},{"id":"spn-109410","marks":["code"],"text":"act"}]},{"id":"blk-76224","spans":[{"id":"spn-109411","text":"Known provenance reduces risk"}]}],[{"id":"blk-76225","spans":[{"id":"spn-109412","text":"Agent operating in production"}]},{"id":"blk-76226","spans":[{"id":"spn-109413","marks":["code"],"text":"act"}]},{"id":"blk-76227","spans":[{"id":"spn-109414","text":"Approval latency is unacceptable"}]}],[{"id":"blk-76228","spans":[{"id":"spn-109415","text":"Agent accessing sensitive data"}]},{"id":"blk-76229","spans":[{"id":"spn-109416","marks":["code"],"text":"advise"}]},{"id":"blk-76230","spans":[{"id":"spn-109417","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-76231","spans":[{"id":"spn-109418","text":"Debugging or investigating behavior"}]},{"id":"blk-76232","spans":[{"id":"spn-109419","marks":["code"],"text":"observe"}]},{"id":"blk-76233","spans":[{"id":"spn-109420","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-76234","kind":"heading","level":2,"spans":[{"id":"spn-109421","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-76235","kind":"paragraph","spans":[{"id":"spn-109422","text":"Every autonomy level change is recorded:"}]},{"id":"blk-76236","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-76237","kind":"heading","level":2,"spans":[{"id":"spn-109423","text":"Demotion"}]},{"id":"blk-76238","kind":"paragraph","spans":[{"id":"spn-109424","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-109425","marks":["code"],"text":"act"},{"id":"spn-109426","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-109427","marks":["code"],"text":"observe"},{"id":"spn-109428","text":" instantly:"}]},{"id":"blk-76239","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-76240","kind":"paragraph","spans":[{"id":"spn-109429","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaieratmu72spal4ejli6eu454d4qlnpg3o3c2tpya5onb7huz6d4qegba","vocabulary":"ampersand.docs.fs.v1"}