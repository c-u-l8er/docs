{"bendscript":"0.1","blocks":[{"id":"blk-50269","kind":"heading","level":1,"spans":[{"id":"spn-58477","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-50271","kind":"paragraph","spans":[{"id":"spn-58478","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-50270","kind":"quote"},{"id":"blk-50272","kind":"paragraph","spans":[{"id":"spn-58479","text":"---"}]},{"id":"blk-50273","kind":"heading","level":2,"spans":[{"id":"spn-58480","text":"Why This Matters"}]},{"id":"blk-50274","kind":"paragraph","spans":[{"id":"spn-58481","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-50275","kind":"paragraph","spans":[{"id":"spn-58482","text":"---"}]},{"id":"blk-50276","kind":"heading","level":2,"spans":[{"id":"spn-58483","text":"The Three Levels"}]},{"id":"blk-50277","kind":"heading","level":3,"spans":[{"id":"spn-58484","text":"Observe"}]},{"id":"blk-50278","kind":"paragraph","spans":[{"id":"spn-58485","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-50279","items":[{"blocks":[{"id":"blk-50281","kind":"paragraph","spans":[{"id":"spn-58486","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-58487","marks":["code"],"text":"action_recommended"}]}],"id":"blk-50280","kind":"list-item"},{"blocks":[{"id":"blk-50283","kind":"paragraph","spans":[{"id":"spn-58488","text":"No side effects are produced"}]}],"id":"blk-50282","kind":"list-item"},{"blocks":[{"id":"blk-50285","kind":"paragraph","spans":[{"id":"spn-58489","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-50284","kind":"list-item"},{"blocks":[{"id":"blk-50287","kind":"paragraph","spans":[{"id":"spn-58490","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-50286","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50288","kind":"paragraph","spans":[{"id":"spn-58491","marks":["bold"],"text":"Enforcement:"},{"id":"spn-58492","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-50289","kind":"heading","level":3,"spans":[{"id":"spn-58493","text":"Advise"}]},{"id":"blk-50290","kind":"paragraph","spans":[{"id":"spn-58494","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-50291","items":[{"blocks":[{"id":"blk-50293","kind":"paragraph","spans":[{"id":"spn-58495","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-50292","kind":"list-item"},{"blocks":[{"id":"blk-50295","kind":"paragraph","spans":[{"id":"spn-58496","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-50294","kind":"list-item"},{"blocks":[{"id":"blk-50297","kind":"paragraph","spans":[{"id":"spn-58497","text":"The operator approves or rejects each queued action"}]}],"id":"blk-50296","kind":"list-item"},{"blocks":[{"id":"blk-50299","kind":"paragraph","spans":[{"id":"spn-58498","text":"Approved actions execute with full permission checking"}]}],"id":"blk-50298","kind":"list-item"},{"blocks":[{"id":"blk-50301","kind":"paragraph","spans":[{"id":"spn-58499","text":"Rejected actions are logged as "},{"id":"spn-58500","marks":["code"],"text":"action_blocked"},{"id":"spn-58501","text":" with the rejection reason"}]}],"id":"blk-50300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50302","kind":"paragraph","spans":[{"id":"spn-58502","marks":["bold"],"text":"Enforcement:"},{"id":"spn-58503","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-50303","kind":"heading","level":3,"spans":[{"id":"spn-58504","text":"Act"}]},{"id":"blk-50304","kind":"paragraph","spans":[{"id":"spn-58505","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-50305","items":[{"blocks":[{"id":"blk-50307","kind":"paragraph","spans":[{"id":"spn-58506","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-50306","kind":"list-item"},{"blocks":[{"id":"blk-50309","kind":"paragraph","spans":[{"id":"spn-58507","text":"Permitted actions execute immediately"}]}],"id":"blk-50308","kind":"list-item"},{"blocks":[{"id":"blk-50311","kind":"paragraph","spans":[{"id":"spn-58508","text":"Denied actions are blocked and logged as "},{"id":"spn-58509","marks":["code"],"text":"action_blocked"}]}],"id":"blk-50310","kind":"list-item"},{"blocks":[{"id":"blk-50313","kind":"paragraph","spans":[{"id":"spn-58510","text":"No human approval step"}]}],"id":"blk-50312","kind":"list-item"},{"blocks":[{"id":"blk-50315","kind":"paragraph","spans":[{"id":"spn-58511","text":"All actions are still audited as "},{"id":"spn-58512","marks":["code"],"text":"action_executed"}]}],"id":"blk-50314","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50316","kind":"paragraph","spans":[{"id":"spn-58513","marks":["bold"],"text":"Enforcement:"},{"id":"spn-58514","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-50317","kind":"paragraph","spans":[{"id":"spn-58515","text":"---"}]},{"id":"blk-50318","kind":"heading","level":2,"spans":[{"id":"spn-58516","text":"Trust-Building Workflow"}]},{"id":"blk-50319","kind":"paragraph","spans":[{"id":"spn-58517","text":"The recommended progression for any new agent:"}]},{"id":"blk-50320","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-50321","kind":"paragraph","spans":[{"id":"spn-58518","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-58519","marks":["code"],"text":"act"},{"id":"spn-58520","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-50322","kind":"paragraph","spans":[{"id":"spn-58521","text":"---"}]},{"id":"blk-50323","kind":"heading","level":2,"spans":[{"id":"spn-58522","text":"autonomy_level Tool"}]},{"id":"blk-50324","kind":"heading","level":3,"spans":[{"id":"spn-58523","text":"Get Current Level"}]},{"id":"blk-50325","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-50326","kind":"heading","level":3,"spans":[{"id":"spn-58524","text":"Set Level"}]},{"id":"blk-50327","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-50328","kind":"heading","level":3,"spans":[{"id":"spn-58525","text":"Parameters"}]},{"head":[{"id":"blk-50330","spans":[{"id":"spn-58526","text":"Param"}]},{"id":"blk-50331","spans":[{"id":"spn-58527","text":"Required"}]},{"id":"blk-50332","spans":[{"id":"spn-58528","text":"Type"}]},{"id":"blk-50333","spans":[{"id":"spn-58529","text":"Description"}]}],"id":"blk-50329","kind":"table","rows":[[{"id":"blk-50334","spans":[{"id":"spn-58530","marks":["code"],"text":"agent_id"}]},{"id":"blk-50335","spans":[{"id":"spn-58531","text":"Yes"}]},{"id":"blk-50336","spans":[{"id":"spn-58532","text":"string"}]},{"id":"blk-50337","spans":[{"id":"spn-58533","text":"The agent to query or update"}]}],[{"id":"blk-50338","spans":[{"id":"spn-58534","marks":["code"],"text":"level"}]},{"id":"blk-50339","spans":[{"id":"spn-58535","text":"No"}]},{"id":"blk-50340","spans":[{"id":"spn-58536","text":"string"}]},{"id":"blk-50341","spans":[{"id":"spn-58537","text":"New level: "},{"id":"spn-58538","marks":["code"],"text":"observe"},{"id":"spn-58539","text":", "},{"id":"spn-58540","marks":["code"],"text":"advise"},{"id":"spn-58541","text":", or "},{"id":"spn-58542","marks":["code"],"text":"act"},{"id":"spn-58543","text":". Omit to query."}]}]]},{"id":"blk-50342","kind":"paragraph","spans":[{"id":"spn-58544","text":"---"}]},{"id":"blk-50343","kind":"heading","level":2,"spans":[{"id":"spn-58545","text":"Enforcement Mechanics"}]},{"id":"blk-50344","kind":"heading","level":3,"spans":[{"id":"spn-58546","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-50345","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-50346","kind":"heading","level":3,"spans":[{"id":"spn-58547","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-50347","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-50348","kind":"heading","level":3,"spans":[{"id":"spn-58548","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-50349","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-50350","kind":"paragraph","spans":[{"id":"spn-58549","text":"---"}]},{"id":"blk-50351","kind":"heading","level":2,"spans":[{"id":"spn-58550","text":"When to Use Each Level"}]},{"head":[{"id":"blk-50353","spans":[{"id":"spn-58551","text":"Scenario"}]},{"id":"blk-50354","spans":[{"id":"spn-58552","text":"Recommended Level"}]},{"id":"blk-50355","spans":[{"id":"spn-58553","text":"Reason"}]}],"id":"blk-50352","kind":"table","rows":[[{"id":"blk-50356","spans":[{"id":"spn-58554","text":"Agent just installed, source unknown"}]},{"id":"blk-50357","spans":[{"id":"spn-58555","marks":["code"],"text":"observe"}]},{"id":"blk-50358","spans":[{"id":"spn-58556","text":"Build trust before granting power"}]}],[{"id":"blk-50359","spans":[{"id":"spn-58557","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-50360","spans":[{"id":"spn-58558","marks":["code"],"text":"observe"}]},{"id":"blk-50361","spans":[{"id":"spn-58559","text":"Third-party code needs vetting"}]}],[{"id":"blk-50362","spans":[{"id":"spn-58560","text":"Internal tool, well-tested"}]},{"id":"blk-50363","spans":[{"id":"spn-58561","marks":["code"],"text":"advise"},{"id":"spn-58562","text":" or "},{"id":"spn-58563","marks":["code"],"text":"act"}]},{"id":"blk-50364","spans":[{"id":"spn-58564","text":"Known provenance reduces risk"}]}],[{"id":"blk-50365","spans":[{"id":"spn-58565","text":"Agent operating in production"}]},{"id":"blk-50366","spans":[{"id":"spn-58566","marks":["code"],"text":"act"}]},{"id":"blk-50367","spans":[{"id":"spn-58567","text":"Approval latency is unacceptable"}]}],[{"id":"blk-50368","spans":[{"id":"spn-58568","text":"Agent accessing sensitive data"}]},{"id":"blk-50369","spans":[{"id":"spn-58569","marks":["code"],"text":"advise"}]},{"id":"blk-50370","spans":[{"id":"spn-58570","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-50371","spans":[{"id":"spn-58571","text":"Debugging or investigating behavior"}]},{"id":"blk-50372","spans":[{"id":"spn-58572","marks":["code"],"text":"observe"}]},{"id":"blk-50373","spans":[{"id":"spn-58573","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-50374","kind":"paragraph","spans":[{"id":"spn-58574","text":"---"}]},{"id":"blk-50375","kind":"heading","level":2,"spans":[{"id":"spn-58575","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-50376","kind":"paragraph","spans":[{"id":"spn-58576","text":"Every autonomy level change is recorded:"}]},{"id":"blk-50377","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-50378","kind":"paragraph","spans":[{"id":"spn-58577","text":"---"}]},{"id":"blk-50379","kind":"heading","level":2,"spans":[{"id":"spn-58578","text":"Demotion"}]},{"id":"blk-50380","kind":"paragraph","spans":[{"id":"spn-58579","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-58580","marks":["code"],"text":"act"},{"id":"spn-58581","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-58582","marks":["code"],"text":"observe"},{"id":"spn-58583","text":" instantly:"}]},{"id":"blk-50381","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-50382","kind":"paragraph","spans":[{"id":"spn-58584","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaierayhz3zu2oqcf2aigirnztexmhb5h2qh7ont3gjhe427r3jcy5bbma","vocabulary":"ampersand.docs.fs.v1"}