{"bendscript":"0.1","blocks":[{"id":"blk-75181","kind":"heading","level":1,"spans":[{"id":"spn-106569","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-75183","kind":"paragraph","spans":[{"id":"spn-106570","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-75182","kind":"quote"},{"id":"blk-75184","kind":"heading","level":2,"spans":[{"id":"spn-106571","text":"Why This Matters"}]},{"id":"blk-75185","kind":"paragraph","spans":[{"id":"spn-106572","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-75186","kind":"heading","level":2,"spans":[{"id":"spn-106573","text":"The Three Levels"}]},{"id":"blk-75187","kind":"heading","level":3,"spans":[{"id":"spn-106574","text":"Observe"}]},{"id":"blk-75188","kind":"paragraph","spans":[{"id":"spn-106575","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-75189","items":[{"blocks":[{"id":"blk-75191","kind":"paragraph","spans":[{"id":"spn-106576","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-106577","marks":["code"],"text":"action_recommended"}]}],"id":"blk-75190","kind":"list-item"},{"blocks":[{"id":"blk-75193","kind":"paragraph","spans":[{"id":"spn-106578","text":"No side effects are produced"}]}],"id":"blk-75192","kind":"list-item"},{"blocks":[{"id":"blk-75195","kind":"paragraph","spans":[{"id":"spn-106579","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-75194","kind":"list-item"},{"blocks":[{"id":"blk-75197","kind":"paragraph","spans":[{"id":"spn-106580","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-75196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75198","kind":"paragraph","spans":[{"id":"spn-106581","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106582","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-75199","kind":"heading","level":3,"spans":[{"id":"spn-106583","text":"Advise"}]},{"id":"blk-75200","kind":"paragraph","spans":[{"id":"spn-106584","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-75201","items":[{"blocks":[{"id":"blk-75203","kind":"paragraph","spans":[{"id":"spn-106585","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-75202","kind":"list-item"},{"blocks":[{"id":"blk-75205","kind":"paragraph","spans":[{"id":"spn-106586","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-75204","kind":"list-item"},{"blocks":[{"id":"blk-75207","kind":"paragraph","spans":[{"id":"spn-106587","text":"The operator approves or rejects each queued action"}]}],"id":"blk-75206","kind":"list-item"},{"blocks":[{"id":"blk-75209","kind":"paragraph","spans":[{"id":"spn-106588","text":"Approved actions execute with full permission checking"}]}],"id":"blk-75208","kind":"list-item"},{"blocks":[{"id":"blk-75211","kind":"paragraph","spans":[{"id":"spn-106589","text":"Rejected actions are logged as "},{"id":"spn-106590","marks":["code"],"text":"action_blocked"},{"id":"spn-106591","text":" with the rejection reason"}]}],"id":"blk-75210","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75212","kind":"paragraph","spans":[{"id":"spn-106592","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106593","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-75213","kind":"heading","level":3,"spans":[{"id":"spn-106594","text":"Act"}]},{"id":"blk-75214","kind":"paragraph","spans":[{"id":"spn-106595","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-75215","items":[{"blocks":[{"id":"blk-75217","kind":"paragraph","spans":[{"id":"spn-106596","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-75216","kind":"list-item"},{"blocks":[{"id":"blk-75219","kind":"paragraph","spans":[{"id":"spn-106597","text":"Permitted actions execute immediately"}]}],"id":"blk-75218","kind":"list-item"},{"blocks":[{"id":"blk-75221","kind":"paragraph","spans":[{"id":"spn-106598","text":"Denied actions are blocked and logged as "},{"id":"spn-106599","marks":["code"],"text":"action_blocked"}]}],"id":"blk-75220","kind":"list-item"},{"blocks":[{"id":"blk-75223","kind":"paragraph","spans":[{"id":"spn-106600","text":"No human approval step"}]}],"id":"blk-75222","kind":"list-item"},{"blocks":[{"id":"blk-75225","kind":"paragraph","spans":[{"id":"spn-106601","text":"All actions are still audited as "},{"id":"spn-106602","marks":["code"],"text":"action_executed"}]}],"id":"blk-75224","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75226","kind":"paragraph","spans":[{"id":"spn-106603","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106604","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-75227","kind":"heading","level":2,"spans":[{"id":"spn-106605","text":"Trust-Building Workflow"}]},{"id":"blk-75228","kind":"paragraph","spans":[{"id":"spn-106606","text":"The recommended progression for any new agent:"}]},{"id":"blk-75229","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-75230","kind":"paragraph","spans":[{"id":"spn-106607","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-106608","marks":["code"],"text":"act"},{"id":"spn-106609","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-75231","kind":"heading","level":2,"spans":[{"id":"spn-106610","text":"autonomy_level Tool"}]},{"id":"blk-75232","kind":"heading","level":3,"spans":[{"id":"spn-106611","text":"Get Current Level"}]},{"id":"blk-75233","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-75234","kind":"heading","level":3,"spans":[{"id":"spn-106612","text":"Set Level"}]},{"id":"blk-75235","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-75236","kind":"heading","level":3,"spans":[{"id":"spn-106613","text":"Parameters"}]},{"head":[{"id":"blk-75238","spans":[{"id":"spn-106614","text":"Param"}]},{"id":"blk-75239","spans":[{"id":"spn-106615","text":"Required"}]},{"id":"blk-75240","spans":[{"id":"spn-106616","text":"Type"}]},{"id":"blk-75241","spans":[{"id":"spn-106617","text":"Description"}]}],"id":"blk-75237","kind":"table","rows":[[{"id":"blk-75242","spans":[{"id":"spn-106618","marks":["code"],"text":"agent_id"}]},{"id":"blk-75243","spans":[{"id":"spn-106619","text":"Yes"}]},{"id":"blk-75244","spans":[{"id":"spn-106620","text":"string"}]},{"id":"blk-75245","spans":[{"id":"spn-106621","text":"The agent to query or update"}]}],[{"id":"blk-75246","spans":[{"id":"spn-106622","marks":["code"],"text":"level"}]},{"id":"blk-75247","spans":[{"id":"spn-106623","text":"No"}]},{"id":"blk-75248","spans":[{"id":"spn-106624","text":"string"}]},{"id":"blk-75249","spans":[{"id":"spn-106625","text":"New level: "},{"id":"spn-106626","marks":["code"],"text":"observe"},{"id":"spn-106627","text":", "},{"id":"spn-106628","marks":["code"],"text":"advise"},{"id":"spn-106629","text":", or "},{"id":"spn-106630","marks":["code"],"text":"act"},{"id":"spn-106631","text":". Omit to query."}]}]]},{"id":"blk-75250","kind":"heading","level":2,"spans":[{"id":"spn-106632","text":"Enforcement Mechanics"}]},{"id":"blk-75251","kind":"heading","level":3,"spans":[{"id":"spn-106633","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-75252","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-75253","kind":"heading","level":3,"spans":[{"id":"spn-106634","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-75254","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-75255","kind":"heading","level":3,"spans":[{"id":"spn-106635","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-75256","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-75257","kind":"heading","level":2,"spans":[{"id":"spn-106636","text":"When to Use Each Level"}]},{"head":[{"id":"blk-75259","spans":[{"id":"spn-106637","text":"Scenario"}]},{"id":"blk-75260","spans":[{"id":"spn-106638","text":"Recommended Level"}]},{"id":"blk-75261","spans":[{"id":"spn-106639","text":"Reason"}]}],"id":"blk-75258","kind":"table","rows":[[{"id":"blk-75262","spans":[{"id":"spn-106640","text":"Agent just installed, source unknown"}]},{"id":"blk-75263","spans":[{"id":"spn-106641","marks":["code"],"text":"observe"}]},{"id":"blk-75264","spans":[{"id":"spn-106642","text":"Build trust before granting power"}]}],[{"id":"blk-75265","spans":[{"id":"spn-106643","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-75266","spans":[{"id":"spn-106644","marks":["code"],"text":"observe"}]},{"id":"blk-75267","spans":[{"id":"spn-106645","text":"Third-party code needs vetting"}]}],[{"id":"blk-75268","spans":[{"id":"spn-106646","text":"Internal tool, well-tested"}]},{"id":"blk-75269","spans":[{"id":"spn-106647","marks":["code"],"text":"advise"},{"id":"spn-106648","text":" or "},{"id":"spn-106649","marks":["code"],"text":"act"}]},{"id":"blk-75270","spans":[{"id":"spn-106650","text":"Known provenance reduces risk"}]}],[{"id":"blk-75271","spans":[{"id":"spn-106651","text":"Agent operating in production"}]},{"id":"blk-75272","spans":[{"id":"spn-106652","marks":["code"],"text":"act"}]},{"id":"blk-75273","spans":[{"id":"spn-106653","text":"Approval latency is unacceptable"}]}],[{"id":"blk-75274","spans":[{"id":"spn-106654","text":"Agent accessing sensitive data"}]},{"id":"blk-75275","spans":[{"id":"spn-106655","marks":["code"],"text":"advise"}]},{"id":"blk-75276","spans":[{"id":"spn-106656","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-75277","spans":[{"id":"spn-106657","text":"Debugging or investigating behavior"}]},{"id":"blk-75278","spans":[{"id":"spn-106658","marks":["code"],"text":"observe"}]},{"id":"blk-75279","spans":[{"id":"spn-106659","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-75280","kind":"heading","level":2,"spans":[{"id":"spn-106660","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-75281","kind":"paragraph","spans":[{"id":"spn-106661","text":"Every autonomy level change is recorded:"}]},{"id":"blk-75282","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-75283","kind":"heading","level":2,"spans":[{"id":"spn-106662","text":"Demotion"}]},{"id":"blk-75284","kind":"paragraph","spans":[{"id":"spn-106663","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-106664","marks":["code"],"text":"act"},{"id":"spn-106665","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-106666","marks":["code"],"text":"observe"},{"id":"spn-106667","text":" instantly:"}]},{"id":"blk-75285","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-75286","kind":"paragraph","spans":[{"id":"spn-106668","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaierapj6bp2l5xva5ilukjrgo6hangczjx6i4ph5slliobncb3jixnwmq","vocabulary":"ampersand.docs.fs.v1"}