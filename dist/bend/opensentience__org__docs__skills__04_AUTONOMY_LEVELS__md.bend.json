{"bendscript":"0.1","blocks":[{"id":"blk-49783","kind":"heading","level":1,"spans":[{"id":"spn-57357","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-49785","kind":"paragraph","spans":[{"id":"spn-57358","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-49784","kind":"quote"},{"id":"blk-49786","kind":"paragraph","spans":[{"id":"spn-57359","text":"---"}]},{"id":"blk-49787","kind":"heading","level":2,"spans":[{"id":"spn-57360","text":"Why This Matters"}]},{"id":"blk-49788","kind":"paragraph","spans":[{"id":"spn-57361","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-49789","kind":"paragraph","spans":[{"id":"spn-57362","text":"---"}]},{"id":"blk-49790","kind":"heading","level":2,"spans":[{"id":"spn-57363","text":"The Three Levels"}]},{"id":"blk-49791","kind":"heading","level":3,"spans":[{"id":"spn-57364","text":"Observe"}]},{"id":"blk-49792","kind":"paragraph","spans":[{"id":"spn-57365","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-49793","items":[{"blocks":[{"id":"blk-49795","kind":"paragraph","spans":[{"id":"spn-57366","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-57367","marks":["code"],"text":"action_recommended"}]}],"id":"blk-49794","kind":"list-item"},{"blocks":[{"id":"blk-49797","kind":"paragraph","spans":[{"id":"spn-57368","text":"No side effects are produced"}]}],"id":"blk-49796","kind":"list-item"},{"blocks":[{"id":"blk-49799","kind":"paragraph","spans":[{"id":"spn-57369","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-49798","kind":"list-item"},{"blocks":[{"id":"blk-49801","kind":"paragraph","spans":[{"id":"spn-57370","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-49800","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49802","kind":"paragraph","spans":[{"id":"spn-57371","marks":["bold"],"text":"Enforcement:"},{"id":"spn-57372","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-49803","kind":"heading","level":3,"spans":[{"id":"spn-57373","text":"Advise"}]},{"id":"blk-49804","kind":"paragraph","spans":[{"id":"spn-57374","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-49805","items":[{"blocks":[{"id":"blk-49807","kind":"paragraph","spans":[{"id":"spn-57375","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-49806","kind":"list-item"},{"blocks":[{"id":"blk-49809","kind":"paragraph","spans":[{"id":"spn-57376","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-49808","kind":"list-item"},{"blocks":[{"id":"blk-49811","kind":"paragraph","spans":[{"id":"spn-57377","text":"The operator approves or rejects each queued action"}]}],"id":"blk-49810","kind":"list-item"},{"blocks":[{"id":"blk-49813","kind":"paragraph","spans":[{"id":"spn-57378","text":"Approved actions execute with full permission checking"}]}],"id":"blk-49812","kind":"list-item"},{"blocks":[{"id":"blk-49815","kind":"paragraph","spans":[{"id":"spn-57379","text":"Rejected actions are logged as "},{"id":"spn-57380","marks":["code"],"text":"action_blocked"},{"id":"spn-57381","text":" with the rejection reason"}]}],"id":"blk-49814","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49816","kind":"paragraph","spans":[{"id":"spn-57382","marks":["bold"],"text":"Enforcement:"},{"id":"spn-57383","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-49817","kind":"heading","level":3,"spans":[{"id":"spn-57384","text":"Act"}]},{"id":"blk-49818","kind":"paragraph","spans":[{"id":"spn-57385","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-49819","items":[{"blocks":[{"id":"blk-49821","kind":"paragraph","spans":[{"id":"spn-57386","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-49820","kind":"list-item"},{"blocks":[{"id":"blk-49823","kind":"paragraph","spans":[{"id":"spn-57387","text":"Permitted actions execute immediately"}]}],"id":"blk-49822","kind":"list-item"},{"blocks":[{"id":"blk-49825","kind":"paragraph","spans":[{"id":"spn-57388","text":"Denied actions are blocked and logged as "},{"id":"spn-57389","marks":["code"],"text":"action_blocked"}]}],"id":"blk-49824","kind":"list-item"},{"blocks":[{"id":"blk-49827","kind":"paragraph","spans":[{"id":"spn-57390","text":"No human approval step"}]}],"id":"blk-49826","kind":"list-item"},{"blocks":[{"id":"blk-49829","kind":"paragraph","spans":[{"id":"spn-57391","text":"All actions are still audited as "},{"id":"spn-57392","marks":["code"],"text":"action_executed"}]}],"id":"blk-49828","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49830","kind":"paragraph","spans":[{"id":"spn-57393","marks":["bold"],"text":"Enforcement:"},{"id":"spn-57394","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-49831","kind":"paragraph","spans":[{"id":"spn-57395","text":"---"}]},{"id":"blk-49832","kind":"heading","level":2,"spans":[{"id":"spn-57396","text":"Trust-Building Workflow"}]},{"id":"blk-49833","kind":"paragraph","spans":[{"id":"spn-57397","text":"The recommended progression for any new agent:"}]},{"id":"blk-49834","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-49835","kind":"paragraph","spans":[{"id":"spn-57398","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-57399","marks":["code"],"text":"act"},{"id":"spn-57400","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-49836","kind":"paragraph","spans":[{"id":"spn-57401","text":"---"}]},{"id":"blk-49837","kind":"heading","level":2,"spans":[{"id":"spn-57402","text":"autonomy_level Tool"}]},{"id":"blk-49838","kind":"heading","level":3,"spans":[{"id":"spn-57403","text":"Get Current Level"}]},{"id":"blk-49839","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-49840","kind":"heading","level":3,"spans":[{"id":"spn-57404","text":"Set Level"}]},{"id":"blk-49841","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-49842","kind":"heading","level":3,"spans":[{"id":"spn-57405","text":"Parameters"}]},{"head":[{"id":"blk-49844","spans":[{"id":"spn-57406","text":"Param"}]},{"id":"blk-49845","spans":[{"id":"spn-57407","text":"Required"}]},{"id":"blk-49846","spans":[{"id":"spn-57408","text":"Type"}]},{"id":"blk-49847","spans":[{"id":"spn-57409","text":"Description"}]}],"id":"blk-49843","kind":"table","rows":[[{"id":"blk-49848","spans":[{"id":"spn-57410","marks":["code"],"text":"agent_id"}]},{"id":"blk-49849","spans":[{"id":"spn-57411","text":"Yes"}]},{"id":"blk-49850","spans":[{"id":"spn-57412","text":"string"}]},{"id":"blk-49851","spans":[{"id":"spn-57413","text":"The agent to query or update"}]}],[{"id":"blk-49852","spans":[{"id":"spn-57414","marks":["code"],"text":"level"}]},{"id":"blk-49853","spans":[{"id":"spn-57415","text":"No"}]},{"id":"blk-49854","spans":[{"id":"spn-57416","text":"string"}]},{"id":"blk-49855","spans":[{"id":"spn-57417","text":"New level: "},{"id":"spn-57418","marks":["code"],"text":"observe"},{"id":"spn-57419","text":", "},{"id":"spn-57420","marks":["code"],"text":"advise"},{"id":"spn-57421","text":", or "},{"id":"spn-57422","marks":["code"],"text":"act"},{"id":"spn-57423","text":". Omit to query."}]}]]},{"id":"blk-49856","kind":"paragraph","spans":[{"id":"spn-57424","text":"---"}]},{"id":"blk-49857","kind":"heading","level":2,"spans":[{"id":"spn-57425","text":"Enforcement Mechanics"}]},{"id":"blk-49858","kind":"heading","level":3,"spans":[{"id":"spn-57426","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-49859","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-49860","kind":"heading","level":3,"spans":[{"id":"spn-57427","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-49861","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-49862","kind":"heading","level":3,"spans":[{"id":"spn-57428","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-49863","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-49864","kind":"paragraph","spans":[{"id":"spn-57429","text":"---"}]},{"id":"blk-49865","kind":"heading","level":2,"spans":[{"id":"spn-57430","text":"When to Use Each Level"}]},{"head":[{"id":"blk-49867","spans":[{"id":"spn-57431","text":"Scenario"}]},{"id":"blk-49868","spans":[{"id":"spn-57432","text":"Recommended Level"}]},{"id":"blk-49869","spans":[{"id":"spn-57433","text":"Reason"}]}],"id":"blk-49866","kind":"table","rows":[[{"id":"blk-49870","spans":[{"id":"spn-57434","text":"Agent just installed, source unknown"}]},{"id":"blk-49871","spans":[{"id":"spn-57435","marks":["code"],"text":"observe"}]},{"id":"blk-49872","spans":[{"id":"spn-57436","text":"Build trust before granting power"}]}],[{"id":"blk-49873","spans":[{"id":"spn-57437","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-49874","spans":[{"id":"spn-57438","marks":["code"],"text":"observe"}]},{"id":"blk-49875","spans":[{"id":"spn-57439","text":"Third-party code needs vetting"}]}],[{"id":"blk-49876","spans":[{"id":"spn-57440","text":"Internal tool, well-tested"}]},{"id":"blk-49877","spans":[{"id":"spn-57441","marks":["code"],"text":"advise"},{"id":"spn-57442","text":" or "},{"id":"spn-57443","marks":["code"],"text":"act"}]},{"id":"blk-49878","spans":[{"id":"spn-57444","text":"Known provenance reduces risk"}]}],[{"id":"blk-49879","spans":[{"id":"spn-57445","text":"Agent operating in production"}]},{"id":"blk-49880","spans":[{"id":"spn-57446","marks":["code"],"text":"act"}]},{"id":"blk-49881","spans":[{"id":"spn-57447","text":"Approval latency is unacceptable"}]}],[{"id":"blk-49882","spans":[{"id":"spn-57448","text":"Agent accessing sensitive data"}]},{"id":"blk-49883","spans":[{"id":"spn-57449","marks":["code"],"text":"advise"}]},{"id":"blk-49884","spans":[{"id":"spn-57450","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-49885","spans":[{"id":"spn-57451","text":"Debugging or investigating behavior"}]},{"id":"blk-49886","spans":[{"id":"spn-57452","marks":["code"],"text":"observe"}]},{"id":"blk-49887","spans":[{"id":"spn-57453","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-49888","kind":"paragraph","spans":[{"id":"spn-57454","text":"---"}]},{"id":"blk-49889","kind":"heading","level":2,"spans":[{"id":"spn-57455","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-49890","kind":"paragraph","spans":[{"id":"spn-57456","text":"Every autonomy level change is recorded:"}]},{"id":"blk-49891","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-49892","kind":"paragraph","spans":[{"id":"spn-57457","text":"---"}]},{"id":"blk-49893","kind":"heading","level":2,"spans":[{"id":"spn-57458","text":"Demotion"}]},{"id":"blk-49894","kind":"paragraph","spans":[{"id":"spn-57459","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-57460","marks":["code"],"text":"act"},{"id":"spn-57461","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-57462","marks":["code"],"text":"observe"},{"id":"spn-57463","text":" instantly:"}]},{"id":"blk-49895","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-49896","kind":"paragraph","spans":[{"id":"spn-57464","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaierapfdckdxj2ie3eq6mumkoef7httmv32i7obdo3qred6cklyrdzjuq","vocabulary":"ampersand.docs.fs.v1"}