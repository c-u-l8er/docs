{"bendscript":"0.1","blocks":[{"id":"blk-98632","kind":"heading","level":1,"spans":[{"id":"spn-163032","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-98634","kind":"paragraph","spans":[{"id":"spn-163033","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-98633","kind":"quote"},{"id":"blk-98635","kind":"heading","level":2,"spans":[{"id":"spn-163034","text":"Why This Matters"}]},{"id":"blk-98636","kind":"paragraph","spans":[{"id":"spn-163035","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-98637","kind":"heading","level":2,"spans":[{"id":"spn-163036","text":"The Three Levels"}]},{"id":"blk-98638","kind":"heading","level":3,"spans":[{"id":"spn-163037","text":"Observe"}]},{"id":"blk-98639","kind":"paragraph","spans":[{"id":"spn-163038","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-98640","items":[{"blocks":[{"id":"blk-98642","kind":"paragraph","spans":[{"id":"spn-163039","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-163040","marks":["code"],"text":"action_recommended"}]}],"id":"blk-98641","kind":"list-item"},{"blocks":[{"id":"blk-98644","kind":"paragraph","spans":[{"id":"spn-163041","text":"No side effects are produced"}]}],"id":"blk-98643","kind":"list-item"},{"blocks":[{"id":"blk-98646","kind":"paragraph","spans":[{"id":"spn-163042","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-98645","kind":"list-item"},{"blocks":[{"id":"blk-98648","kind":"paragraph","spans":[{"id":"spn-163043","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-98647","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-98649","kind":"paragraph","spans":[{"id":"spn-163044","marks":["bold"],"text":"Enforcement:"},{"id":"spn-163045","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-98650","kind":"heading","level":3,"spans":[{"id":"spn-163046","text":"Advise"}]},{"id":"blk-98651","kind":"paragraph","spans":[{"id":"spn-163047","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-98652","items":[{"blocks":[{"id":"blk-98654","kind":"paragraph","spans":[{"id":"spn-163048","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-98653","kind":"list-item"},{"blocks":[{"id":"blk-98656","kind":"paragraph","spans":[{"id":"spn-163049","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-98655","kind":"list-item"},{"blocks":[{"id":"blk-98658","kind":"paragraph","spans":[{"id":"spn-163050","text":"The operator approves or rejects each queued action"}]}],"id":"blk-98657","kind":"list-item"},{"blocks":[{"id":"blk-98660","kind":"paragraph","spans":[{"id":"spn-163051","text":"Approved actions execute with full permission checking"}]}],"id":"blk-98659","kind":"list-item"},{"blocks":[{"id":"blk-98662","kind":"paragraph","spans":[{"id":"spn-163052","text":"Rejected actions are logged as "},{"id":"spn-163053","marks":["code"],"text":"action_blocked"},{"id":"spn-163054","text":" with the rejection reason"}]}],"id":"blk-98661","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-98663","kind":"paragraph","spans":[{"id":"spn-163055","marks":["bold"],"text":"Enforcement:"},{"id":"spn-163056","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-98664","kind":"heading","level":3,"spans":[{"id":"spn-163057","text":"Act"}]},{"id":"blk-98665","kind":"paragraph","spans":[{"id":"spn-163058","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-98666","items":[{"blocks":[{"id":"blk-98668","kind":"paragraph","spans":[{"id":"spn-163059","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-98667","kind":"list-item"},{"blocks":[{"id":"blk-98670","kind":"paragraph","spans":[{"id":"spn-163060","text":"Permitted actions execute immediately"}]}],"id":"blk-98669","kind":"list-item"},{"blocks":[{"id":"blk-98672","kind":"paragraph","spans":[{"id":"spn-163061","text":"Denied actions are blocked and logged as "},{"id":"spn-163062","marks":["code"],"text":"action_blocked"}]}],"id":"blk-98671","kind":"list-item"},{"blocks":[{"id":"blk-98674","kind":"paragraph","spans":[{"id":"spn-163063","text":"No human approval step"}]}],"id":"blk-98673","kind":"list-item"},{"blocks":[{"id":"blk-98676","kind":"paragraph","spans":[{"id":"spn-163064","text":"All actions are still audited as "},{"id":"spn-163065","marks":["code"],"text":"action_executed"}]}],"id":"blk-98675","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-98677","kind":"paragraph","spans":[{"id":"spn-163066","marks":["bold"],"text":"Enforcement:"},{"id":"spn-163067","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-98678","kind":"heading","level":2,"spans":[{"id":"spn-163068","text":"Trust-Building Workflow"}]},{"id":"blk-98679","kind":"paragraph","spans":[{"id":"spn-163069","text":"The recommended progression for any new agent:"}]},{"id":"blk-98680","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-98681","kind":"paragraph","spans":[{"id":"spn-163070","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-163071","marks":["code"],"text":"act"},{"id":"spn-163072","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-98682","kind":"heading","level":2,"spans":[{"id":"spn-163073","text":"autonomy_level Tool"}]},{"id":"blk-98683","kind":"heading","level":3,"spans":[{"id":"spn-163074","text":"Get Current Level"}]},{"id":"blk-98684","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-98685","kind":"heading","level":3,"spans":[{"id":"spn-163075","text":"Set Level"}]},{"id":"blk-98686","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-98687","kind":"heading","level":3,"spans":[{"id":"spn-163076","text":"Parameters"}]},{"head":[{"id":"blk-98689","spans":[{"id":"spn-163077","text":"Param"}]},{"id":"blk-98690","spans":[{"id":"spn-163078","text":"Required"}]},{"id":"blk-98691","spans":[{"id":"spn-163079","text":"Type"}]},{"id":"blk-98692","spans":[{"id":"spn-163080","text":"Description"}]}],"id":"blk-98688","kind":"table","rows":[[{"id":"blk-98693","spans":[{"id":"spn-163081","marks":["code"],"text":"agent_id"}]},{"id":"blk-98694","spans":[{"id":"spn-163082","text":"Yes"}]},{"id":"blk-98695","spans":[{"id":"spn-163083","text":"string"}]},{"id":"blk-98696","spans":[{"id":"spn-163084","text":"The agent to query or update"}]}],[{"id":"blk-98697","spans":[{"id":"spn-163085","marks":["code"],"text":"level"}]},{"id":"blk-98698","spans":[{"id":"spn-163086","text":"No"}]},{"id":"blk-98699","spans":[{"id":"spn-163087","text":"string"}]},{"id":"blk-98700","spans":[{"id":"spn-163088","text":"New level: "},{"id":"spn-163089","marks":["code"],"text":"observe"},{"id":"spn-163090","text":", "},{"id":"spn-163091","marks":["code"],"text":"advise"},{"id":"spn-163092","text":", or "},{"id":"spn-163093","marks":["code"],"text":"act"},{"id":"spn-163094","text":". Omit to query."}]}]]},{"id":"blk-98701","kind":"heading","level":2,"spans":[{"id":"spn-163095","text":"Enforcement Mechanics"}]},{"id":"blk-98702","kind":"heading","level":3,"spans":[{"id":"spn-163096","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-98703","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-98704","kind":"heading","level":3,"spans":[{"id":"spn-163097","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-98705","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-98706","kind":"heading","level":3,"spans":[{"id":"spn-163098","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-98707","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-98708","kind":"heading","level":2,"spans":[{"id":"spn-163099","text":"When to Use Each Level"}]},{"head":[{"id":"blk-98710","spans":[{"id":"spn-163100","text":"Scenario"}]},{"id":"blk-98711","spans":[{"id":"spn-163101","text":"Recommended Level"}]},{"id":"blk-98712","spans":[{"id":"spn-163102","text":"Reason"}]}],"id":"blk-98709","kind":"table","rows":[[{"id":"blk-98713","spans":[{"id":"spn-163103","text":"Agent just installed, source unknown"}]},{"id":"blk-98714","spans":[{"id":"spn-163104","marks":["code"],"text":"observe"}]},{"id":"blk-98715","spans":[{"id":"spn-163105","text":"Build trust before granting power"}]}],[{"id":"blk-98716","spans":[{"id":"spn-163106","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-98717","spans":[{"id":"spn-163107","marks":["code"],"text":"observe"}]},{"id":"blk-98718","spans":[{"id":"spn-163108","text":"Third-party code needs vetting"}]}],[{"id":"blk-98719","spans":[{"id":"spn-163109","text":"Internal tool, well-tested"}]},{"id":"blk-98720","spans":[{"id":"spn-163110","marks":["code"],"text":"advise"},{"id":"spn-163111","text":" or "},{"id":"spn-163112","marks":["code"],"text":"act"}]},{"id":"blk-98721","spans":[{"id":"spn-163113","text":"Known provenance reduces risk"}]}],[{"id":"blk-98722","spans":[{"id":"spn-163114","text":"Agent operating in production"}]},{"id":"blk-98723","spans":[{"id":"spn-163115","marks":["code"],"text":"act"}]},{"id":"blk-98724","spans":[{"id":"spn-163116","text":"Approval latency is unacceptable"}]}],[{"id":"blk-98725","spans":[{"id":"spn-163117","text":"Agent accessing sensitive data"}]},{"id":"blk-98726","spans":[{"id":"spn-163118","marks":["code"],"text":"advise"}]},{"id":"blk-98727","spans":[{"id":"spn-163119","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-98728","spans":[{"id":"spn-163120","text":"Debugging or investigating behavior"}]},{"id":"blk-98729","spans":[{"id":"spn-163121","marks":["code"],"text":"observe"}]},{"id":"blk-98730","spans":[{"id":"spn-163122","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-98731","kind":"heading","level":2,"spans":[{"id":"spn-163123","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-98732","kind":"paragraph","spans":[{"id":"spn-163124","text":"Every autonomy level change is recorded:"}]},{"id":"blk-98733","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-98734","kind":"heading","level":2,"spans":[{"id":"spn-163125","text":"Demotion"}]},{"id":"blk-98735","kind":"paragraph","spans":[{"id":"spn-163126","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-163127","marks":["code"],"text":"act"},{"id":"spn-163128","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-163129","marks":["code"],"text":"observe"},{"id":"spn-163130","text":" instantly:"}]},{"id":"blk-98736","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-98737","kind":"paragraph","spans":[{"id":"spn-163131","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaieraqcfurwuascwkdy5gxbiot25dphsmhvinmwgwolzp6pkec7lo7yaa","vocabulary":"ampersand.docs.fs.v1"}