{"bendscript":"0.1","blocks":[{"id":"blk-49297","kind":"heading","level":1,"spans":[{"id":"spn-56183","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-49299","kind":"paragraph","spans":[{"id":"spn-56184","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-49298","kind":"quote"},{"id":"blk-49300","kind":"paragraph","spans":[{"id":"spn-56185","text":"---"}]},{"id":"blk-49301","kind":"heading","level":2,"spans":[{"id":"spn-56186","text":"Why This Matters"}]},{"id":"blk-49302","kind":"paragraph","spans":[{"id":"spn-56187","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-49303","kind":"paragraph","spans":[{"id":"spn-56188","text":"---"}]},{"id":"blk-49304","kind":"heading","level":2,"spans":[{"id":"spn-56189","text":"The Three Levels"}]},{"id":"blk-49305","kind":"heading","level":3,"spans":[{"id":"spn-56190","text":"Observe"}]},{"id":"blk-49306","kind":"paragraph","spans":[{"id":"spn-56191","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-49307","items":[{"blocks":[{"id":"blk-49309","kind":"paragraph","spans":[{"id":"spn-56192","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-56193","marks":["code"],"text":"action_recommended"}]}],"id":"blk-49308","kind":"list-item"},{"blocks":[{"id":"blk-49311","kind":"paragraph","spans":[{"id":"spn-56194","text":"No side effects are produced"}]}],"id":"blk-49310","kind":"list-item"},{"blocks":[{"id":"blk-49313","kind":"paragraph","spans":[{"id":"spn-56195","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-49312","kind":"list-item"},{"blocks":[{"id":"blk-49315","kind":"paragraph","spans":[{"id":"spn-56196","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-49314","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49316","kind":"paragraph","spans":[{"id":"spn-56197","marks":["bold"],"text":"Enforcement:"},{"id":"spn-56198","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-49317","kind":"heading","level":3,"spans":[{"id":"spn-56199","text":"Advise"}]},{"id":"blk-49318","kind":"paragraph","spans":[{"id":"spn-56200","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-49319","items":[{"blocks":[{"id":"blk-49321","kind":"paragraph","spans":[{"id":"spn-56201","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-49320","kind":"list-item"},{"blocks":[{"id":"blk-49323","kind":"paragraph","spans":[{"id":"spn-56202","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-49322","kind":"list-item"},{"blocks":[{"id":"blk-49325","kind":"paragraph","spans":[{"id":"spn-56203","text":"The operator approves or rejects each queued action"}]}],"id":"blk-49324","kind":"list-item"},{"blocks":[{"id":"blk-49327","kind":"paragraph","spans":[{"id":"spn-56204","text":"Approved actions execute with full permission checking"}]}],"id":"blk-49326","kind":"list-item"},{"blocks":[{"id":"blk-49329","kind":"paragraph","spans":[{"id":"spn-56205","text":"Rejected actions are logged as "},{"id":"spn-56206","marks":["code"],"text":"action_blocked"},{"id":"spn-56207","text":" with the rejection reason"}]}],"id":"blk-49328","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49330","kind":"paragraph","spans":[{"id":"spn-56208","marks":["bold"],"text":"Enforcement:"},{"id":"spn-56209","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-49331","kind":"heading","level":3,"spans":[{"id":"spn-56210","text":"Act"}]},{"id":"blk-49332","kind":"paragraph","spans":[{"id":"spn-56211","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-49333","items":[{"blocks":[{"id":"blk-49335","kind":"paragraph","spans":[{"id":"spn-56212","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-49334","kind":"list-item"},{"blocks":[{"id":"blk-49337","kind":"paragraph","spans":[{"id":"spn-56213","text":"Permitted actions execute immediately"}]}],"id":"blk-49336","kind":"list-item"},{"blocks":[{"id":"blk-49339","kind":"paragraph","spans":[{"id":"spn-56214","text":"Denied actions are blocked and logged as "},{"id":"spn-56215","marks":["code"],"text":"action_blocked"}]}],"id":"blk-49338","kind":"list-item"},{"blocks":[{"id":"blk-49341","kind":"paragraph","spans":[{"id":"spn-56216","text":"No human approval step"}]}],"id":"blk-49340","kind":"list-item"},{"blocks":[{"id":"blk-49343","kind":"paragraph","spans":[{"id":"spn-56217","text":"All actions are still audited as "},{"id":"spn-56218","marks":["code"],"text":"action_executed"}]}],"id":"blk-49342","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49344","kind":"paragraph","spans":[{"id":"spn-56219","marks":["bold"],"text":"Enforcement:"},{"id":"spn-56220","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-49345","kind":"paragraph","spans":[{"id":"spn-56221","text":"---"}]},{"id":"blk-49346","kind":"heading","level":2,"spans":[{"id":"spn-56222","text":"Trust-Building Workflow"}]},{"id":"blk-49347","kind":"paragraph","spans":[{"id":"spn-56223","text":"The recommended progression for any new agent:"}]},{"id":"blk-49348","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-49349","kind":"paragraph","spans":[{"id":"spn-56224","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-56225","marks":["code"],"text":"act"},{"id":"spn-56226","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-49350","kind":"paragraph","spans":[{"id":"spn-56227","text":"---"}]},{"id":"blk-49351","kind":"heading","level":2,"spans":[{"id":"spn-56228","text":"autonomy_level Tool"}]},{"id":"blk-49352","kind":"heading","level":3,"spans":[{"id":"spn-56229","text":"Get Current Level"}]},{"id":"blk-49353","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-49354","kind":"heading","level":3,"spans":[{"id":"spn-56230","text":"Set Level"}]},{"id":"blk-49355","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-49356","kind":"heading","level":3,"spans":[{"id":"spn-56231","text":"Parameters"}]},{"head":[{"id":"blk-49358","spans":[{"id":"spn-56232","text":"Param"}]},{"id":"blk-49359","spans":[{"id":"spn-56233","text":"Required"}]},{"id":"blk-49360","spans":[{"id":"spn-56234","text":"Type"}]},{"id":"blk-49361","spans":[{"id":"spn-56235","text":"Description"}]}],"id":"blk-49357","kind":"table","rows":[[{"id":"blk-49362","spans":[{"id":"spn-56236","marks":["code"],"text":"agent_id"}]},{"id":"blk-49363","spans":[{"id":"spn-56237","text":"Yes"}]},{"id":"blk-49364","spans":[{"id":"spn-56238","text":"string"}]},{"id":"blk-49365","spans":[{"id":"spn-56239","text":"The agent to query or update"}]}],[{"id":"blk-49366","spans":[{"id":"spn-56240","marks":["code"],"text":"level"}]},{"id":"blk-49367","spans":[{"id":"spn-56241","text":"No"}]},{"id":"blk-49368","spans":[{"id":"spn-56242","text":"string"}]},{"id":"blk-49369","spans":[{"id":"spn-56243","text":"New level: "},{"id":"spn-56244","marks":["code"],"text":"observe"},{"id":"spn-56245","text":", "},{"id":"spn-56246","marks":["code"],"text":"advise"},{"id":"spn-56247","text":", or "},{"id":"spn-56248","marks":["code"],"text":"act"},{"id":"spn-56249","text":". Omit to query."}]}]]},{"id":"blk-49370","kind":"paragraph","spans":[{"id":"spn-56250","text":"---"}]},{"id":"blk-49371","kind":"heading","level":2,"spans":[{"id":"spn-56251","text":"Enforcement Mechanics"}]},{"id":"blk-49372","kind":"heading","level":3,"spans":[{"id":"spn-56252","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-49373","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-49374","kind":"heading","level":3,"spans":[{"id":"spn-56253","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-49375","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-49376","kind":"heading","level":3,"spans":[{"id":"spn-56254","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-49377","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-49378","kind":"paragraph","spans":[{"id":"spn-56255","text":"---"}]},{"id":"blk-49379","kind":"heading","level":2,"spans":[{"id":"spn-56256","text":"When to Use Each Level"}]},{"head":[{"id":"blk-49381","spans":[{"id":"spn-56257","text":"Scenario"}]},{"id":"blk-49382","spans":[{"id":"spn-56258","text":"Recommended Level"}]},{"id":"blk-49383","spans":[{"id":"spn-56259","text":"Reason"}]}],"id":"blk-49380","kind":"table","rows":[[{"id":"blk-49384","spans":[{"id":"spn-56260","text":"Agent just installed, source unknown"}]},{"id":"blk-49385","spans":[{"id":"spn-56261","marks":["code"],"text":"observe"}]},{"id":"blk-49386","spans":[{"id":"spn-56262","text":"Build trust before granting power"}]}],[{"id":"blk-49387","spans":[{"id":"spn-56263","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-49388","spans":[{"id":"spn-56264","marks":["code"],"text":"observe"}]},{"id":"blk-49389","spans":[{"id":"spn-56265","text":"Third-party code needs vetting"}]}],[{"id":"blk-49390","spans":[{"id":"spn-56266","text":"Internal tool, well-tested"}]},{"id":"blk-49391","spans":[{"id":"spn-56267","marks":["code"],"text":"advise"},{"id":"spn-56268","text":" or "},{"id":"spn-56269","marks":["code"],"text":"act"}]},{"id":"blk-49392","spans":[{"id":"spn-56270","text":"Known provenance reduces risk"}]}],[{"id":"blk-49393","spans":[{"id":"spn-56271","text":"Agent operating in production"}]},{"id":"blk-49394","spans":[{"id":"spn-56272","marks":["code"],"text":"act"}]},{"id":"blk-49395","spans":[{"id":"spn-56273","text":"Approval latency is unacceptable"}]}],[{"id":"blk-49396","spans":[{"id":"spn-56274","text":"Agent accessing sensitive data"}]},{"id":"blk-49397","spans":[{"id":"spn-56275","marks":["code"],"text":"advise"}]},{"id":"blk-49398","spans":[{"id":"spn-56276","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-49399","spans":[{"id":"spn-56277","text":"Debugging or investigating behavior"}]},{"id":"blk-49400","spans":[{"id":"spn-56278","marks":["code"],"text":"observe"}]},{"id":"blk-49401","spans":[{"id":"spn-56279","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-49402","kind":"paragraph","spans":[{"id":"spn-56280","text":"---"}]},{"id":"blk-49403","kind":"heading","level":2,"spans":[{"id":"spn-56281","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-49404","kind":"paragraph","spans":[{"id":"spn-56282","text":"Every autonomy level change is recorded:"}]},{"id":"blk-49405","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-49406","kind":"paragraph","spans":[{"id":"spn-56283","text":"---"}]},{"id":"blk-49407","kind":"heading","level":2,"spans":[{"id":"spn-56284","text":"Demotion"}]},{"id":"blk-49408","kind":"paragraph","spans":[{"id":"spn-56285","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-56286","marks":["code"],"text":"act"},{"id":"spn-56287","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-56288","marks":["code"],"text":"observe"},{"id":"spn-56289","text":" instantly:"}]},{"id":"blk-49409","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-49410","kind":"paragraph","spans":[{"id":"spn-56290","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaierar45mb47bi4meerlr6gicslrucpfe3glltzhxdizrlhog56nvksxq","vocabulary":"ampersand.docs.fs.v1"}