{"bendscript":"0.1","blocks":[{"id":"blk-75170","kind":"heading","level":1,"spans":[{"id":"spn-106516","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-75172","kind":"paragraph","spans":[{"id":"spn-106517","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-75171","kind":"quote"},{"id":"blk-75173","kind":"heading","level":2,"spans":[{"id":"spn-106518","text":"Why This Matters"}]},{"id":"blk-75174","kind":"paragraph","spans":[{"id":"spn-106519","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-75175","kind":"heading","level":2,"spans":[{"id":"spn-106520","text":"The Three Levels"}]},{"id":"blk-75176","kind":"heading","level":3,"spans":[{"id":"spn-106521","text":"Observe"}]},{"id":"blk-75177","kind":"paragraph","spans":[{"id":"spn-106522","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-75178","items":[{"blocks":[{"id":"blk-75180","kind":"paragraph","spans":[{"id":"spn-106523","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-106524","marks":["code"],"text":"action_recommended"}]}],"id":"blk-75179","kind":"list-item"},{"blocks":[{"id":"blk-75182","kind":"paragraph","spans":[{"id":"spn-106525","text":"No side effects are produced"}]}],"id":"blk-75181","kind":"list-item"},{"blocks":[{"id":"blk-75184","kind":"paragraph","spans":[{"id":"spn-106526","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-75183","kind":"list-item"},{"blocks":[{"id":"blk-75186","kind":"paragraph","spans":[{"id":"spn-106527","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-75185","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75187","kind":"paragraph","spans":[{"id":"spn-106528","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106529","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-75188","kind":"heading","level":3,"spans":[{"id":"spn-106530","text":"Advise"}]},{"id":"blk-75189","kind":"paragraph","spans":[{"id":"spn-106531","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-75190","items":[{"blocks":[{"id":"blk-75192","kind":"paragraph","spans":[{"id":"spn-106532","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-75191","kind":"list-item"},{"blocks":[{"id":"blk-75194","kind":"paragraph","spans":[{"id":"spn-106533","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-75193","kind":"list-item"},{"blocks":[{"id":"blk-75196","kind":"paragraph","spans":[{"id":"spn-106534","text":"The operator approves or rejects each queued action"}]}],"id":"blk-75195","kind":"list-item"},{"blocks":[{"id":"blk-75198","kind":"paragraph","spans":[{"id":"spn-106535","text":"Approved actions execute with full permission checking"}]}],"id":"blk-75197","kind":"list-item"},{"blocks":[{"id":"blk-75200","kind":"paragraph","spans":[{"id":"spn-106536","text":"Rejected actions are logged as "},{"id":"spn-106537","marks":["code"],"text":"action_blocked"},{"id":"spn-106538","text":" with the rejection reason"}]}],"id":"blk-75199","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75201","kind":"paragraph","spans":[{"id":"spn-106539","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106540","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-75202","kind":"heading","level":3,"spans":[{"id":"spn-106541","text":"Act"}]},{"id":"blk-75203","kind":"paragraph","spans":[{"id":"spn-106542","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-75204","items":[{"blocks":[{"id":"blk-75206","kind":"paragraph","spans":[{"id":"spn-106543","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-75205","kind":"list-item"},{"blocks":[{"id":"blk-75208","kind":"paragraph","spans":[{"id":"spn-106544","text":"Permitted actions execute immediately"}]}],"id":"blk-75207","kind":"list-item"},{"blocks":[{"id":"blk-75210","kind":"paragraph","spans":[{"id":"spn-106545","text":"Denied actions are blocked and logged as "},{"id":"spn-106546","marks":["code"],"text":"action_blocked"}]}],"id":"blk-75209","kind":"list-item"},{"blocks":[{"id":"blk-75212","kind":"paragraph","spans":[{"id":"spn-106547","text":"No human approval step"}]}],"id":"blk-75211","kind":"list-item"},{"blocks":[{"id":"blk-75214","kind":"paragraph","spans":[{"id":"spn-106548","text":"All actions are still audited as "},{"id":"spn-106549","marks":["code"],"text":"action_executed"}]}],"id":"blk-75213","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75215","kind":"paragraph","spans":[{"id":"spn-106550","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106551","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-75216","kind":"heading","level":2,"spans":[{"id":"spn-106552","text":"Trust-Building Workflow"}]},{"id":"blk-75217","kind":"paragraph","spans":[{"id":"spn-106553","text":"The recommended progression for any new agent:"}]},{"id":"blk-75218","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-75219","kind":"paragraph","spans":[{"id":"spn-106554","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-106555","marks":["code"],"text":"act"},{"id":"spn-106556","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-75220","kind":"heading","level":2,"spans":[{"id":"spn-106557","text":"autonomy_level Tool"}]},{"id":"blk-75221","kind":"heading","level":3,"spans":[{"id":"spn-106558","text":"Get Current Level"}]},{"id":"blk-75222","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-75223","kind":"heading","level":3,"spans":[{"id":"spn-106559","text":"Set Level"}]},{"id":"blk-75224","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-75225","kind":"heading","level":3,"spans":[{"id":"spn-106560","text":"Parameters"}]},{"head":[{"id":"blk-75227","spans":[{"id":"spn-106561","text":"Param"}]},{"id":"blk-75228","spans":[{"id":"spn-106562","text":"Required"}]},{"id":"blk-75229","spans":[{"id":"spn-106563","text":"Type"}]},{"id":"blk-75230","spans":[{"id":"spn-106564","text":"Description"}]}],"id":"blk-75226","kind":"table","rows":[[{"id":"blk-75231","spans":[{"id":"spn-106565","marks":["code"],"text":"agent_id"}]},{"id":"blk-75232","spans":[{"id":"spn-106566","text":"Yes"}]},{"id":"blk-75233","spans":[{"id":"spn-106567","text":"string"}]},{"id":"blk-75234","spans":[{"id":"spn-106568","text":"The agent to query or update"}]}],[{"id":"blk-75235","spans":[{"id":"spn-106569","marks":["code"],"text":"level"}]},{"id":"blk-75236","spans":[{"id":"spn-106570","text":"No"}]},{"id":"blk-75237","spans":[{"id":"spn-106571","text":"string"}]},{"id":"blk-75238","spans":[{"id":"spn-106572","text":"New level: "},{"id":"spn-106573","marks":["code"],"text":"observe"},{"id":"spn-106574","text":", "},{"id":"spn-106575","marks":["code"],"text":"advise"},{"id":"spn-106576","text":", or "},{"id":"spn-106577","marks":["code"],"text":"act"},{"id":"spn-106578","text":". Omit to query."}]}]]},{"id":"blk-75239","kind":"heading","level":2,"spans":[{"id":"spn-106579","text":"Enforcement Mechanics"}]},{"id":"blk-75240","kind":"heading","level":3,"spans":[{"id":"spn-106580","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-75241","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-75242","kind":"heading","level":3,"spans":[{"id":"spn-106581","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-75243","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-75244","kind":"heading","level":3,"spans":[{"id":"spn-106582","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-75245","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-75246","kind":"heading","level":2,"spans":[{"id":"spn-106583","text":"When to Use Each Level"}]},{"head":[{"id":"blk-75248","spans":[{"id":"spn-106584","text":"Scenario"}]},{"id":"blk-75249","spans":[{"id":"spn-106585","text":"Recommended Level"}]},{"id":"blk-75250","spans":[{"id":"spn-106586","text":"Reason"}]}],"id":"blk-75247","kind":"table","rows":[[{"id":"blk-75251","spans":[{"id":"spn-106587","text":"Agent just installed, source unknown"}]},{"id":"blk-75252","spans":[{"id":"spn-106588","marks":["code"],"text":"observe"}]},{"id":"blk-75253","spans":[{"id":"spn-106589","text":"Build trust before granting power"}]}],[{"id":"blk-75254","spans":[{"id":"spn-106590","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-75255","spans":[{"id":"spn-106591","marks":["code"],"text":"observe"}]},{"id":"blk-75256","spans":[{"id":"spn-106592","text":"Third-party code needs vetting"}]}],[{"id":"blk-75257","spans":[{"id":"spn-106593","text":"Internal tool, well-tested"}]},{"id":"blk-75258","spans":[{"id":"spn-106594","marks":["code"],"text":"advise"},{"id":"spn-106595","text":" or "},{"id":"spn-106596","marks":["code"],"text":"act"}]},{"id":"blk-75259","spans":[{"id":"spn-106597","text":"Known provenance reduces risk"}]}],[{"id":"blk-75260","spans":[{"id":"spn-106598","text":"Agent operating in production"}]},{"id":"blk-75261","spans":[{"id":"spn-106599","marks":["code"],"text":"act"}]},{"id":"blk-75262","spans":[{"id":"spn-106600","text":"Approval latency is unacceptable"}]}],[{"id":"blk-75263","spans":[{"id":"spn-106601","text":"Agent accessing sensitive data"}]},{"id":"blk-75264","spans":[{"id":"spn-106602","marks":["code"],"text":"advise"}]},{"id":"blk-75265","spans":[{"id":"spn-106603","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-75266","spans":[{"id":"spn-106604","text":"Debugging or investigating behavior"}]},{"id":"blk-75267","spans":[{"id":"spn-106605","marks":["code"],"text":"observe"}]},{"id":"blk-75268","spans":[{"id":"spn-106606","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-75269","kind":"heading","level":2,"spans":[{"id":"spn-106607","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-75270","kind":"paragraph","spans":[{"id":"spn-106608","text":"Every autonomy level change is recorded:"}]},{"id":"blk-75271","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-75272","kind":"heading","level":2,"spans":[{"id":"spn-106609","text":"Demotion"}]},{"id":"blk-75273","kind":"paragraph","spans":[{"id":"spn-106610","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-106611","marks":["code"],"text":"act"},{"id":"spn-106612","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-106613","marks":["code"],"text":"observe"},{"id":"spn-106614","text":" instantly:"}]},{"id":"blk-75274","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-75275","kind":"paragraph","spans":[{"id":"spn-106615","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaieraxfekk7qvhoqkjkinlk4e7l7xgamcd3rskqynxrrhwdu3p422tzoq","vocabulary":"ampersand.docs.fs.v1"}