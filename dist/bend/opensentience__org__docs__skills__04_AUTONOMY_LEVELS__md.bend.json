{"bendscript":"0.1","blocks":[{"id":"blk-75307","kind":"heading","level":1,"spans":[{"id":"spn-106717","text":"Skill 04 — Autonomy Levels"}]},{"blocks":[{"id":"blk-75309","kind":"paragraph","spans":[{"id":"spn-106718","text":"Graduated autonomy: observe, advise, act. Trust-building workflows, enforcement mechanics, and when to use each level."}]}],"id":"blk-75308","kind":"quote"},{"id":"blk-75310","kind":"heading","level":2,"spans":[{"id":"spn-106719","text":"Why This Matters"}]},{"id":"blk-75311","kind":"paragraph","spans":[{"id":"spn-106720","text":"Autonomy levels solve the trust problem in agent deployment. You do not want a newly installed agent executing actions unsupervised. You also do not want a proven agent waiting for human approval on every routine task. Graduated autonomy provides the middle ground — a progression from observation to full autonomy, with audit at every step."}]},{"id":"blk-75312","kind":"heading","level":2,"spans":[{"id":"spn-106721","text":"The Three Levels"}]},{"id":"blk-75313","kind":"heading","level":3,"spans":[{"id":"spn-106722","text":"Observe"}]},{"id":"blk-75314","kind":"paragraph","spans":[{"id":"spn-106723","text":"The agent generates recommendations but takes no action."}]},{"id":"blk-75315","items":[{"blocks":[{"id":"blk-75317","kind":"paragraph","spans":[{"id":"spn-106724","text":"All proposed actions are logged to the audit trail as "},{"id":"spn-106725","marks":["code"],"text":"action_recommended"}]}],"id":"blk-75316","kind":"list-item"},{"blocks":[{"id":"blk-75319","kind":"paragraph","spans":[{"id":"spn-106726","text":"No side effects are produced"}]}],"id":"blk-75318","kind":"list-item"},{"blocks":[{"id":"blk-75321","kind":"paragraph","spans":[{"id":"spn-106727","text":"The operator reviews recommendations and manually executes if appropriate"}]}],"id":"blk-75320","kind":"list-item"},{"blocks":[{"id":"blk-75323","kind":"paragraph","spans":[{"id":"spn-106728","text":"Useful for: new agents, untrusted agents, sensitive domains"}]}],"id":"blk-75322","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75324","kind":"paragraph","spans":[{"id":"spn-106729","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106730","text":" The AutonomyController intercepts the action dispatch and replaces execution with a recommendation log entry."}]},{"id":"blk-75325","kind":"heading","level":3,"spans":[{"id":"spn-106731","text":"Advise"}]},{"id":"blk-75326","kind":"paragraph","spans":[{"id":"spn-106732","text":"The agent prepares actions and queues them for human approval."}]},{"id":"blk-75327","items":[{"blocks":[{"id":"blk-75329","kind":"paragraph","spans":[{"id":"spn-106733","text":"Proposed actions are placed in an approval queue"}]}],"id":"blk-75328","kind":"list-item"},{"blocks":[{"id":"blk-75331","kind":"paragraph","spans":[{"id":"spn-106734","text":"The operator receives a notification (via MCP or PubSub)"}]}],"id":"blk-75330","kind":"list-item"},{"blocks":[{"id":"blk-75333","kind":"paragraph","spans":[{"id":"spn-106735","text":"The operator approves or rejects each queued action"}]}],"id":"blk-75332","kind":"list-item"},{"blocks":[{"id":"blk-75335","kind":"paragraph","spans":[{"id":"spn-106736","text":"Approved actions execute with full permission checking"}]}],"id":"blk-75334","kind":"list-item"},{"blocks":[{"id":"blk-75337","kind":"paragraph","spans":[{"id":"spn-106737","text":"Rejected actions are logged as "},{"id":"spn-106738","marks":["code"],"text":"action_blocked"},{"id":"spn-106739","text":" with the rejection reason"}]}],"id":"blk-75336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75338","kind":"paragraph","spans":[{"id":"spn-106740","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106741","text":" The AutonomyController holds the action in a GenServer queue. A separate approval interface (MCP tool or Elixir API) resolves the queue."}]},{"id":"blk-75339","kind":"heading","level":3,"spans":[{"id":"spn-106742","text":"Act"}]},{"id":"blk-75340","kind":"paragraph","spans":[{"id":"spn-106743","text":"The agent executes autonomously within its granted permissions."}]},{"id":"blk-75341","items":[{"blocks":[{"id":"blk-75343","kind":"paragraph","spans":[{"id":"spn-106744","text":"Actions proceed directly to the PermissionEngine for checking"}]}],"id":"blk-75342","kind":"list-item"},{"blocks":[{"id":"blk-75345","kind":"paragraph","spans":[{"id":"spn-106745","text":"Permitted actions execute immediately"}]}],"id":"blk-75344","kind":"list-item"},{"blocks":[{"id":"blk-75347","kind":"paragraph","spans":[{"id":"spn-106746","text":"Denied actions are blocked and logged as "},{"id":"spn-106747","marks":["code"],"text":"action_blocked"}]}],"id":"blk-75346","kind":"list-item"},{"blocks":[{"id":"blk-75349","kind":"paragraph","spans":[{"id":"spn-106748","text":"No human approval step"}]}],"id":"blk-75348","kind":"list-item"},{"blocks":[{"id":"blk-75351","kind":"paragraph","spans":[{"id":"spn-106749","text":"All actions are still audited as "},{"id":"spn-106750","marks":["code"],"text":"action_executed"}]}],"id":"blk-75350","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75352","kind":"paragraph","spans":[{"id":"spn-106751","marks":["bold"],"text":"Enforcement:"},{"id":"spn-106752","text":" The AutonomyController forwards the action directly to the PermissionEngine. No queuing or interception."}]},{"id":"blk-75353","kind":"heading","level":2,"spans":[{"id":"spn-106753","text":"Trust-Building Workflow"}]},{"id":"blk-75354","kind":"paragraph","spans":[{"id":"spn-106754","text":"The recommended progression for any new agent:"}]},{"id":"blk-75355","kind":"code","language":"text","text":"1. Install at observe (default)\n   --> Review audit trail for 1-2 sessions\n   --> Verify recommendations are sensible\n\n2. Promote to advise\n   --> Review and approve queued actions\n   --> Build confidence in the agent's judgment\n   --> Track approval/rejection ratio\n\n3. Promote to act (when ready)\n   --> Agent operates autonomously within permissions\n   --> Continue monitoring audit trail\n   --> Demote immediately if behavior degrades"},{"id":"blk-75356","kind":"paragraph","spans":[{"id":"spn-106755","text":"This progression is not mandatory. An operator who trusts the agent's provenance (e.g., a well-tested internal tool) can skip directly to "},{"id":"spn-106756","marks":["code"],"text":"act"},{"id":"spn-106757","text":". But the audit trail always records the autonomy level at every action."}]},{"id":"blk-75357","kind":"heading","level":2,"spans":[{"id":"spn-106758","text":"autonomy_level Tool"}]},{"id":"blk-75358","kind":"heading","level":3,"spans":[{"id":"spn-106759","text":"Get Current Level"}]},{"id":"blk-75359","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\")\n# => {ok, \"observe\"}"},{"id":"blk-75360","kind":"heading","level":3,"spans":[{"id":"spn-106760","text":"Set Level"}]},{"id":"blk-75361","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"advise\")\n# => {ok, \"autonomy changed: observe -> advise\"}"},{"id":"blk-75362","kind":"heading","level":3,"spans":[{"id":"spn-106761","text":"Parameters"}]},{"head":[{"id":"blk-75364","spans":[{"id":"spn-106762","text":"Param"}]},{"id":"blk-75365","spans":[{"id":"spn-106763","text":"Required"}]},{"id":"blk-75366","spans":[{"id":"spn-106764","text":"Type"}]},{"id":"blk-75367","spans":[{"id":"spn-106765","text":"Description"}]}],"id":"blk-75363","kind":"table","rows":[[{"id":"blk-75368","spans":[{"id":"spn-106766","marks":["code"],"text":"agent_id"}]},{"id":"blk-75369","spans":[{"id":"spn-106767","text":"Yes"}]},{"id":"blk-75370","spans":[{"id":"spn-106768","text":"string"}]},{"id":"blk-75371","spans":[{"id":"spn-106769","text":"The agent to query or update"}]}],[{"id":"blk-75372","spans":[{"id":"spn-106770","marks":["code"],"text":"level"}]},{"id":"blk-75373","spans":[{"id":"spn-106771","text":"No"}]},{"id":"blk-75374","spans":[{"id":"spn-106772","text":"string"}]},{"id":"blk-75375","spans":[{"id":"spn-106773","text":"New level: "},{"id":"spn-106774","marks":["code"],"text":"observe"},{"id":"spn-106775","text":", "},{"id":"spn-106776","marks":["code"],"text":"advise"},{"id":"spn-106777","text":", or "},{"id":"spn-106778","marks":["code"],"text":"act"},{"id":"spn-106779","text":". Omit to query."}]}]]},{"id":"blk-75376","kind":"heading","level":2,"spans":[{"id":"spn-106780","text":"Enforcement Mechanics"}]},{"id":"blk-75377","kind":"heading","level":3,"spans":[{"id":"spn-106781","text":"Observe Mode — Intercept and Recommend"}]},{"id":"blk-75378","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = observe\n  --> Action is NOT executed\n  --> AuditWriter logs: event_type=action_recommended, operation=<action details>\n  --> Agent receives: {blocked, \"autonomy: observe — action logged as recommendation\"}"},{"id":"blk-75379","kind":"heading","level":3,"spans":[{"id":"spn-106782","text":"Advise Mode — Queue and Await Approval"}]},{"id":"blk-75380","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = advise\n  --> Action is queued in GenServer state\n  --> Notification sent via PubSub\n  --> Operator approves/rejects via MCP or API\n  --> Approved: PermissionEngine.check() --> execute or block\n  --> Rejected: AuditWriter logs action_blocked with rejection reason"},{"id":"blk-75381","kind":"heading","level":3,"spans":[{"id":"spn-106783","text":"Act Mode — Forward to Permissions"}]},{"id":"blk-75382","kind":"code","language":"text","text":"Agent proposes action\n  --> AutonomyController checks level = act\n  --> PermissionEngine.check(agent_id, type, access, resource)\n  --> allow: execute action, log action_executed\n  --> deny: block action, log action_blocked"},{"id":"blk-75383","kind":"heading","level":2,"spans":[{"id":"spn-106784","text":"When to Use Each Level"}]},{"head":[{"id":"blk-75385","spans":[{"id":"spn-106785","text":"Scenario"}]},{"id":"blk-75386","spans":[{"id":"spn-106786","text":"Recommended Level"}]},{"id":"blk-75387","spans":[{"id":"spn-106787","text":"Reason"}]}],"id":"blk-75384","kind":"table","rows":[[{"id":"blk-75388","spans":[{"id":"spn-106788","text":"Agent just installed, source unknown"}]},{"id":"blk-75389","spans":[{"id":"spn-106789","marks":["code"],"text":"observe"}]},{"id":"blk-75390","spans":[{"id":"spn-106790","text":"Build trust before granting power"}]}],[{"id":"blk-75391","spans":[{"id":"spn-106791","text":"Agent from FleetPrompt marketplace"}]},{"id":"blk-75392","spans":[{"id":"spn-106792","marks":["code"],"text":"observe"}]},{"id":"blk-75393","spans":[{"id":"spn-106793","text":"Third-party code needs vetting"}]}],[{"id":"blk-75394","spans":[{"id":"spn-106794","text":"Internal tool, well-tested"}]},{"id":"blk-75395","spans":[{"id":"spn-106795","marks":["code"],"text":"advise"},{"id":"spn-106796","text":" or "},{"id":"spn-106797","marks":["code"],"text":"act"}]},{"id":"blk-75396","spans":[{"id":"spn-106798","text":"Known provenance reduces risk"}]}],[{"id":"blk-75397","spans":[{"id":"spn-106799","text":"Agent operating in production"}]},{"id":"blk-75398","spans":[{"id":"spn-106800","marks":["code"],"text":"act"}]},{"id":"blk-75399","spans":[{"id":"spn-106801","text":"Approval latency is unacceptable"}]}],[{"id":"blk-75400","spans":[{"id":"spn-106802","text":"Agent accessing sensitive data"}]},{"id":"blk-75401","spans":[{"id":"spn-106803","marks":["code"],"text":"advise"}]},{"id":"blk-75402","spans":[{"id":"spn-106804","text":"Human oversight for high-stakes operations"}]}],[{"id":"blk-75403","spans":[{"id":"spn-106805","text":"Debugging or investigating behavior"}]},{"id":"blk-75404","spans":[{"id":"spn-106806","marks":["code"],"text":"observe"}]},{"id":"blk-75405","spans":[{"id":"spn-106807","text":"See what the agent would do without consequences"}]}]]},{"id":"blk-75406","kind":"heading","level":2,"spans":[{"id":"spn-106808","text":"Audit Trail for Autonomy Changes"}]},{"id":"blk-75407","kind":"paragraph","spans":[{"id":"spn-106809","text":"Every autonomy level change is recorded:"}]},{"id":"blk-75408","kind":"code","language":"json","text":"{\n  \"id\": \"aud_...\",\n  \"timestamp\": \"2026-01-15T10:35:00Z\",\n  \"agent_id\": \"my-worker\",\n  \"event_type\": \"autonomy_change\",\n  \"operation\": \"observe -> advise\",\n  \"result\": \"ok\",\n  \"actor\": \"operator\",\n  \"reason\": \"Agent demonstrated consistent recommendations over 3 sessions\",\n  \"metadata\": {\n    \"previous_level\": \"observe\",\n    \"new_level\": \"advise\",\n    \"sessions_at_previous_level\": 3\n  }\n}"},{"id":"blk-75409","kind":"heading","level":2,"spans":[{"id":"spn-106810","text":"Demotion"}]},{"id":"blk-75410","kind":"paragraph","spans":[{"id":"spn-106811","text":"Autonomy demotion is always available and immediate. If an agent at "},{"id":"spn-106812","marks":["code"],"text":"act"},{"id":"spn-106813","text":" level produces unexpected behavior, the operator can demote to "},{"id":"spn-106814","marks":["code"],"text":"observe"},{"id":"spn-106815","text":" instantly:"}]},{"id":"blk-75411","kind":"code","language":"text","text":"autonomy_level(agent_id: \"my-worker\", level: \"observe\")"},{"id":"blk-75412","kind":"paragraph","spans":[{"id":"spn-106816","text":"The agent's next action will be intercepted and logged as a recommendation instead of executed. No restart is required."}]}],"edges":[],"id":"bagaaieraecvmzjz3sgous5ep3b4yo3mhhmdifd2vfun3xyoswom6m6bknlta","vocabulary":"ampersand.docs.fs.v1"}