{"bendscript":"0.1","blocks":[{"id":"blk-43730","kind":"heading","level":1,"spans":[{"id":"spn-73182","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-43732","kind":"paragraph","spans":[{"id":"spn-73183","marks":["bold"],"text":"Purpose:"},{"id":"spn-73184","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-43731","kind":"quote"},{"id":"blk-43733","kind":"heading","level":2,"spans":[{"id":"spn-73185","text":"What Is an Agent?"}]},{"id":"blk-43734","kind":"paragraph","spans":[{"id":"spn-73186","text":"An "},{"id":"spn-73187","marks":["bold"],"text":"agent"},{"id":"spn-73188","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-43735","kind":"heading","level":2,"spans":[{"id":"spn-73189","text":"Agent Fields"}]},{"head":[{"id":"blk-43737","spans":[{"id":"spn-73190","text":"Field"}]},{"id":"blk-43738","spans":[{"id":"spn-73191","text":"Type"}]},{"id":"blk-43739","spans":[{"id":"spn-73192","text":"Required"}]},{"id":"blk-43740","spans":[{"id":"spn-73193","text":"Description"}]}],"id":"blk-43736","kind":"table","rows":[[{"id":"blk-43741","spans":[{"id":"spn-73194","marks":["code"],"text":"name"}]},{"id":"blk-43742","spans":[{"id":"spn-73195","text":"string"}]},{"id":"blk-43743","spans":[{"id":"spn-73196","text":"Yes"}]},{"id":"blk-43744","spans":[{"id":"spn-73197","text":"Unique per user"}]}],[{"id":"blk-43745","spans":[{"id":"spn-73198","marks":["code"],"text":"description"}]},{"id":"blk-43746","spans":[{"id":"spn-73199","text":"string"}]},{"id":"blk-43747","spans":[{"id":"spn-73200","text":"No"}]},{"id":"blk-43748","spans":[{"id":"spn-73201","text":"Human-readable description"}]}],[{"id":"blk-43749","spans":[{"id":"spn-73202","marks":["code"],"text":"framework"}]},{"id":"blk-43750","spans":[{"id":"spn-73203","text":"string"}]},{"id":"blk-43751","spans":[{"id":"spn-73204","text":"Yes"}]},{"id":"blk-43752","spans":[{"id":"spn-73205","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-43753","spans":[{"id":"spn-73206","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-43754","spans":[{"id":"spn-73207","text":"enum"}]},{"id":"blk-43755","spans":[{"id":"spn-73208","text":"Yes"}]},{"id":"blk-43756","spans":[{"id":"spn-73209","marks":["code"],"text":"cloudflare"},{"id":"spn-73210","text":" or "},{"id":"spn-73211","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-43757","spans":[{"id":"spn-73212","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-43758","spans":[{"id":"spn-73213","text":"string[]"}]},{"id":"blk-43759","spans":[{"id":"spn-73214","text":"No"}]},{"id":"blk-43760","spans":[{"id":"spn-73215","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-43761","spans":[{"id":"spn-73216","marks":["code"],"text":"provider_config"}]},{"id":"blk-43762","spans":[{"id":"spn-73217","text":"JSONB"}]},{"id":"blk-43763","spans":[{"id":"spn-73218","text":"No"}]},{"id":"blk-43764","spans":[{"id":"spn-73219","text":"Runtime-specific configuration"}]}],[{"id":"blk-43765","spans":[{"id":"spn-73220","marks":["code"],"text":"status"}]},{"id":"blk-43766","spans":[{"id":"spn-73221","text":"enum"}]},{"id":"blk-43767","spans":[{"id":"spn-73222","text":"Auto"}]},{"id":"blk-43768","spans":[{"id":"spn-73223","text":"Managed by the platform"}]}]]},{"id":"blk-43769","kind":"heading","level":2,"spans":[{"id":"spn-73224","text":"Status State Machine"}]},{"id":"blk-43770","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-43772","spans":[{"id":"spn-73225","text":"Status"}]},{"id":"blk-43773","spans":[{"id":"spn-73226","text":"Meaning"}]},{"id":"blk-43774","spans":[{"id":"spn-73227","text":"Invocations Allowed"}]}],"id":"blk-43771","kind":"table","rows":[[{"id":"blk-43775","spans":[{"id":"spn-73228","marks":["code"],"text":"created"}]},{"id":"blk-43776","spans":[{"id":"spn-73229","text":"Agent exists but never deployed"}]},{"id":"blk-43777","spans":[{"id":"spn-73230","text":"No"}]}],[{"id":"blk-43778","spans":[{"id":"spn-73231","marks":["code"],"text":"deploying"}]},{"id":"blk-43779","spans":[{"id":"spn-73232","text":"Deployment in progress"}]},{"id":"blk-43780","spans":[{"id":"spn-73233","text":"No"}]}],[{"id":"blk-43781","spans":[{"id":"spn-73234","marks":["code"],"text":"active"}]},{"id":"blk-43782","spans":[{"id":"spn-73235","text":"Active deployment ready"}]},{"id":"blk-43783","spans":[{"id":"spn-73236","text":"Yes"}]}],[{"id":"blk-43784","spans":[{"id":"spn-73237","marks":["code"],"text":"error"}]},{"id":"blk-43785","spans":[{"id":"spn-73238","text":"Last deployment failed"}]},{"id":"blk-43786","spans":[{"id":"spn-73239","text":"No"}]}],[{"id":"blk-43787","spans":[{"id":"spn-73240","marks":["code"],"text":"disabled"}]},{"id":"blk-43788","spans":[{"id":"spn-73241","text":"Manually disabled by user"}]},{"id":"blk-43789","spans":[{"id":"spn-73242","text":"No"}]}]]},{"id":"blk-43790","kind":"paragraph","spans":[{"id":"spn-73243","marks":["bold"],"text":"Invariant:"},{"id":"spn-73244","text":" Only "},{"id":"spn-73245","marks":["code"],"text":"active"},{"id":"spn-73246","text":" agents accept invocations."}]},{"id":"blk-43791","kind":"heading","level":2,"spans":[{"id":"spn-73247","text":"CRUD Operations"}]},{"id":"blk-43792","kind":"heading","level":3,"spans":[{"id":"spn-73248","text":"Create Agent"}]},{"id":"blk-43793","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-43794","kind":"heading","level":3,"spans":[{"id":"spn-73249","text":"Update Agent"}]},{"id":"blk-43795","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-43796","kind":"heading","level":3,"spans":[{"id":"spn-73250","text":"List Agents"}]},{"id":"blk-43797","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-43798","kind":"paragraph","spans":[{"id":"spn-73251","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-43799","kind":"heading","level":3,"spans":[{"id":"spn-73252","text":"Disable Agent"}]},{"id":"blk-43800","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-43801","kind":"paragraph","spans":[{"id":"spn-73253","text":"Sets status to "},{"id":"spn-73254","marks":["code"],"text":"disabled"},{"id":"spn-73255","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-43802","kind":"heading","level":3,"spans":[{"id":"spn-73256","text":"Delete Agent (Soft)"}]},{"id":"blk-43803","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-43804","kind":"paragraph","spans":[{"id":"spn-73257","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-43805","kind":"heading","level":2,"spans":[{"id":"spn-73258","text":"Provider Config"}]},{"id":"blk-43806","kind":"paragraph","spans":[{"id":"spn-73259","text":"The "},{"id":"spn-73260","marks":["code"],"text":"provider_config"},{"id":"spn-73261","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-43807","kind":"paragraph","spans":[{"id":"spn-73262","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-43808","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-43809","kind":"paragraph","spans":[{"id":"spn-73263","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-43810","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-43811","kind":"heading","level":2,"spans":[{"id":"spn-73264","text":"RLS Isolation"}]},{"id":"blk-43812","kind":"paragraph","spans":[{"id":"spn-73265","text":"Every query against the "},{"id":"spn-73266","marks":["code"],"text":"agents"},{"id":"spn-73267","text":" table is filtered by:"}]},{"id":"blk-43813","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-43814","items":[{"blocks":[{"id":"blk-43816","kind":"paragraph","spans":[{"id":"spn-73268","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-43815","kind":"list-item"},{"blocks":[{"id":"blk-43818","kind":"paragraph","spans":[{"id":"spn-73269","text":"The "},{"id":"spn-73270","marks":["code"],"text":"user_id"},{"id":"spn-73271","text":" field is set automatically from "},{"id":"spn-73272","marks":["code"],"text":"auth.uid()"},{"id":"spn-73273","text":" on creation."}]}],"id":"blk-43817","kind":"list-item"},{"blocks":[{"id":"blk-43820","kind":"paragraph","spans":[{"id":"spn-73274","text":"No admin bypass exists in MVP."}]}],"id":"blk-43819","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43821","kind":"heading","level":2,"spans":[{"id":"spn-73275","text":"Checklist"}]},{"id":"blk-43822","items":[{"blocks":[{"id":"blk-43824","kind":"paragraph","spans":[{"id":"spn-73276","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-43823","kind":"list-item"},{"blocks":[{"id":"blk-43826","kind":"paragraph","spans":[{"id":"spn-73277","text":"[ ] "},{"id":"spn-73278","marks":["code"],"text":"runtime_provider"},{"id":"spn-73279","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-43825","kind":"list-item"},{"blocks":[{"id":"blk-43828","kind":"paragraph","spans":[{"id":"spn-73280","text":"[ ] Secret key names in "},{"id":"spn-73281","marks":["code"],"text":"env_var_keys"},{"id":"spn-73282","text":" have corresponding Vault entries"}]}],"id":"blk-43827","kind":"list-item"},{"blocks":[{"id":"blk-43830","kind":"paragraph","spans":[{"id":"spn-73283","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-43829","kind":"list-item"},{"blocks":[{"id":"blk-43832","kind":"paragraph","spans":[{"id":"spn-73284","text":"[ ] RLS policy is active on the "},{"id":"spn-73285","marks":["code"],"text":"agents"},{"id":"spn-73286","text":" table"}]}],"id":"blk-43831","kind":"list-item"},{"blocks":[{"id":"blk-43834","kind":"paragraph","spans":[{"id":"spn-73287","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-43833","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraloizma5jyoldy6d52c6sg6kyxxwnx6vnbbl6sbr7i5ivpdkjydlq","vocabulary":"ampersand.docs.fs.v1"}