{"bendscript":"0.1","blocks":[{"id":"blk-24492","kind":"heading","level":1,"spans":[{"id":"spn-29139","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-24494","kind":"paragraph","spans":[{"id":"spn-29140","marks":["bold"],"text":"Purpose:"},{"id":"spn-29141","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-24493","kind":"quote"},{"id":"blk-24495","kind":"paragraph","spans":[{"id":"spn-29142","text":"---"}]},{"id":"blk-24496","kind":"heading","level":2,"spans":[{"id":"spn-29143","text":"What Is an Agent?"}]},{"id":"blk-24497","kind":"paragraph","spans":[{"id":"spn-29144","text":"An "},{"id":"spn-29145","marks":["bold"],"text":"agent"},{"id":"spn-29146","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-24498","kind":"paragraph","spans":[{"id":"spn-29147","text":"---"}]},{"id":"blk-24499","kind":"heading","level":2,"spans":[{"id":"spn-29148","text":"Agent Fields"}]},{"head":[{"id":"blk-24501","spans":[{"id":"spn-29149","text":"Field"}]},{"id":"blk-24502","spans":[{"id":"spn-29150","text":"Type"}]},{"id":"blk-24503","spans":[{"id":"spn-29151","text":"Required"}]},{"id":"blk-24504","spans":[{"id":"spn-29152","text":"Description"}]}],"id":"blk-24500","kind":"table","rows":[[{"id":"blk-24505","spans":[{"id":"spn-29153","marks":["code"],"text":"name"}]},{"id":"blk-24506","spans":[{"id":"spn-29154","text":"string"}]},{"id":"blk-24507","spans":[{"id":"spn-29155","text":"Yes"}]},{"id":"blk-24508","spans":[{"id":"spn-29156","text":"Unique per user"}]}],[{"id":"blk-24509","spans":[{"id":"spn-29157","marks":["code"],"text":"description"}]},{"id":"blk-24510","spans":[{"id":"spn-29158","text":"string"}]},{"id":"blk-24511","spans":[{"id":"spn-29159","text":"No"}]},{"id":"blk-24512","spans":[{"id":"spn-29160","text":"Human-readable description"}]}],[{"id":"blk-24513","spans":[{"id":"spn-29161","marks":["code"],"text":"framework"}]},{"id":"blk-24514","spans":[{"id":"spn-29162","text":"string"}]},{"id":"blk-24515","spans":[{"id":"spn-29163","text":"Yes"}]},{"id":"blk-24516","spans":[{"id":"spn-29164","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-24517","spans":[{"id":"spn-29165","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24518","spans":[{"id":"spn-29166","text":"enum"}]},{"id":"blk-24519","spans":[{"id":"spn-29167","text":"Yes"}]},{"id":"blk-24520","spans":[{"id":"spn-29168","marks":["code"],"text":"cloudflare"},{"id":"spn-29169","text":" or "},{"id":"spn-29170","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24521","spans":[{"id":"spn-29171","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-24522","spans":[{"id":"spn-29172","text":"string[]"}]},{"id":"blk-24523","spans":[{"id":"spn-29173","text":"No"}]},{"id":"blk-24524","spans":[{"id":"spn-29174","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-24525","spans":[{"id":"spn-29175","marks":["code"],"text":"provider_config"}]},{"id":"blk-24526","spans":[{"id":"spn-29176","text":"JSONB"}]},{"id":"blk-24527","spans":[{"id":"spn-29177","text":"No"}]},{"id":"blk-24528","spans":[{"id":"spn-29178","text":"Runtime-specific configuration"}]}],[{"id":"blk-24529","spans":[{"id":"spn-29179","marks":["code"],"text":"status"}]},{"id":"blk-24530","spans":[{"id":"spn-29180","text":"enum"}]},{"id":"blk-24531","spans":[{"id":"spn-29181","text":"Auto"}]},{"id":"blk-24532","spans":[{"id":"spn-29182","text":"Managed by the platform"}]}]]},{"id":"blk-24533","kind":"paragraph","spans":[{"id":"spn-29183","text":"---"}]},{"id":"blk-24534","kind":"heading","level":2,"spans":[{"id":"spn-29184","text":"Status State Machine"}]},{"id":"blk-24535","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-24537","spans":[{"id":"spn-29185","text":"Status"}]},{"id":"blk-24538","spans":[{"id":"spn-29186","text":"Meaning"}]},{"id":"blk-24539","spans":[{"id":"spn-29187","text":"Invocations Allowed"}]}],"id":"blk-24536","kind":"table","rows":[[{"id":"blk-24540","spans":[{"id":"spn-29188","marks":["code"],"text":"created"}]},{"id":"blk-24541","spans":[{"id":"spn-29189","text":"Agent exists but never deployed"}]},{"id":"blk-24542","spans":[{"id":"spn-29190","text":"No"}]}],[{"id":"blk-24543","spans":[{"id":"spn-29191","marks":["code"],"text":"deploying"}]},{"id":"blk-24544","spans":[{"id":"spn-29192","text":"Deployment in progress"}]},{"id":"blk-24545","spans":[{"id":"spn-29193","text":"No"}]}],[{"id":"blk-24546","spans":[{"id":"spn-29194","marks":["code"],"text":"active"}]},{"id":"blk-24547","spans":[{"id":"spn-29195","text":"Active deployment ready"}]},{"id":"blk-24548","spans":[{"id":"spn-29196","text":"Yes"}]}],[{"id":"blk-24549","spans":[{"id":"spn-29197","marks":["code"],"text":"error"}]},{"id":"blk-24550","spans":[{"id":"spn-29198","text":"Last deployment failed"}]},{"id":"blk-24551","spans":[{"id":"spn-29199","text":"No"}]}],[{"id":"blk-24552","spans":[{"id":"spn-29200","marks":["code"],"text":"disabled"}]},{"id":"blk-24553","spans":[{"id":"spn-29201","text":"Manually disabled by user"}]},{"id":"blk-24554","spans":[{"id":"spn-29202","text":"No"}]}]]},{"id":"blk-24555","kind":"paragraph","spans":[{"id":"spn-29203","marks":["bold"],"text":"Invariant:"},{"id":"spn-29204","text":" Only "},{"id":"spn-29205","marks":["code"],"text":"active"},{"id":"spn-29206","text":" agents accept invocations."}]},{"id":"blk-24556","kind":"paragraph","spans":[{"id":"spn-29207","text":"---"}]},{"id":"blk-24557","kind":"heading","level":2,"spans":[{"id":"spn-29208","text":"CRUD Operations"}]},{"id":"blk-24558","kind":"heading","level":3,"spans":[{"id":"spn-29209","text":"Create Agent"}]},{"id":"blk-24559","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-24560","kind":"heading","level":3,"spans":[{"id":"spn-29210","text":"Update Agent"}]},{"id":"blk-24561","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-24562","kind":"heading","level":3,"spans":[{"id":"spn-29211","text":"List Agents"}]},{"id":"blk-24563","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-24564","kind":"paragraph","spans":[{"id":"spn-29212","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-24565","kind":"heading","level":3,"spans":[{"id":"spn-29213","text":"Disable Agent"}]},{"id":"blk-24566","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-24567","kind":"paragraph","spans":[{"id":"spn-29214","text":"Sets status to "},{"id":"spn-29215","marks":["code"],"text":"disabled"},{"id":"spn-29216","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-24568","kind":"heading","level":3,"spans":[{"id":"spn-29217","text":"Delete Agent (Soft)"}]},{"id":"blk-24569","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-24570","kind":"paragraph","spans":[{"id":"spn-29218","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-24571","kind":"paragraph","spans":[{"id":"spn-29219","text":"---"}]},{"id":"blk-24572","kind":"heading","level":2,"spans":[{"id":"spn-29220","text":"Provider Config"}]},{"id":"blk-24573","kind":"paragraph","spans":[{"id":"spn-29221","text":"The "},{"id":"spn-29222","marks":["code"],"text":"provider_config"},{"id":"spn-29223","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-24574","kind":"paragraph","spans":[{"id":"spn-29224","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-24575","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-24576","kind":"paragraph","spans":[{"id":"spn-29225","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-24577","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-24578","kind":"paragraph","spans":[{"id":"spn-29226","text":"---"}]},{"id":"blk-24579","kind":"heading","level":2,"spans":[{"id":"spn-29227","text":"RLS Isolation"}]},{"id":"blk-24580","kind":"paragraph","spans":[{"id":"spn-29228","text":"Every query against the "},{"id":"spn-29229","marks":["code"],"text":"agents"},{"id":"spn-29230","text":" table is filtered by:"}]},{"id":"blk-24581","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-24582","items":[{"blocks":[{"id":"blk-24584","kind":"paragraph","spans":[{"id":"spn-29231","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-24583","kind":"list-item"},{"blocks":[{"id":"blk-24586","kind":"paragraph","spans":[{"id":"spn-29232","text":"The "},{"id":"spn-29233","marks":["code"],"text":"user_id"},{"id":"spn-29234","text":" field is set automatically from "},{"id":"spn-29235","marks":["code"],"text":"auth.uid()"},{"id":"spn-29236","text":" on creation."}]}],"id":"blk-24585","kind":"list-item"},{"blocks":[{"id":"blk-24588","kind":"paragraph","spans":[{"id":"spn-29237","text":"No admin bypass exists in MVP."}]}],"id":"blk-24587","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24589","kind":"paragraph","spans":[{"id":"spn-29238","text":"---"}]},{"id":"blk-24590","kind":"heading","level":2,"spans":[{"id":"spn-29239","text":"Checklist"}]},{"id":"blk-24591","items":[{"blocks":[{"id":"blk-24593","kind":"paragraph","spans":[{"id":"spn-29240","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-24592","kind":"list-item"},{"blocks":[{"id":"blk-24595","kind":"paragraph","spans":[{"id":"spn-29241","text":"[ ] "},{"id":"spn-29242","marks":["code"],"text":"runtime_provider"},{"id":"spn-29243","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-24594","kind":"list-item"},{"blocks":[{"id":"blk-24597","kind":"paragraph","spans":[{"id":"spn-29244","text":"[ ] Secret key names in "},{"id":"spn-29245","marks":["code"],"text":"env_var_keys"},{"id":"spn-29246","text":" have corresponding Vault entries"}]}],"id":"blk-24596","kind":"list-item"},{"blocks":[{"id":"blk-24599","kind":"paragraph","spans":[{"id":"spn-29247","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-24598","kind":"list-item"},{"blocks":[{"id":"blk-24601","kind":"paragraph","spans":[{"id":"spn-29248","text":"[ ] RLS policy is active on the "},{"id":"spn-29249","marks":["code"],"text":"agents"},{"id":"spn-29250","text":" table"}]}],"id":"blk-24600","kind":"list-item"},{"blocks":[{"id":"blk-24603","kind":"paragraph","spans":[{"id":"spn-29251","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-24602","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieragunpmtfxcbz5ty3toce26dpgztk6yyoczhh3ctp4xdskeb5ehdra","vocabulary":"ampersand.docs.fs.v1"}