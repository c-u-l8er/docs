{"bendscript":"0.1","blocks":[{"id":"blk-24007","kind":"heading","level":1,"spans":[{"id":"spn-27966","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-24009","kind":"paragraph","spans":[{"id":"spn-27967","marks":["bold"],"text":"Purpose:"},{"id":"spn-27968","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-24008","kind":"quote"},{"id":"blk-24010","kind":"paragraph","spans":[{"id":"spn-27969","text":"---"}]},{"id":"blk-24011","kind":"heading","level":2,"spans":[{"id":"spn-27970","text":"What Is an Agent?"}]},{"id":"blk-24012","kind":"paragraph","spans":[{"id":"spn-27971","text":"An "},{"id":"spn-27972","marks":["bold"],"text":"agent"},{"id":"spn-27973","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-24013","kind":"paragraph","spans":[{"id":"spn-27974","text":"---"}]},{"id":"blk-24014","kind":"heading","level":2,"spans":[{"id":"spn-27975","text":"Agent Fields"}]},{"head":[{"id":"blk-24016","spans":[{"id":"spn-27976","text":"Field"}]},{"id":"blk-24017","spans":[{"id":"spn-27977","text":"Type"}]},{"id":"blk-24018","spans":[{"id":"spn-27978","text":"Required"}]},{"id":"blk-24019","spans":[{"id":"spn-27979","text":"Description"}]}],"id":"blk-24015","kind":"table","rows":[[{"id":"blk-24020","spans":[{"id":"spn-27980","marks":["code"],"text":"name"}]},{"id":"blk-24021","spans":[{"id":"spn-27981","text":"string"}]},{"id":"blk-24022","spans":[{"id":"spn-27982","text":"Yes"}]},{"id":"blk-24023","spans":[{"id":"spn-27983","text":"Unique per user"}]}],[{"id":"blk-24024","spans":[{"id":"spn-27984","marks":["code"],"text":"description"}]},{"id":"blk-24025","spans":[{"id":"spn-27985","text":"string"}]},{"id":"blk-24026","spans":[{"id":"spn-27986","text":"No"}]},{"id":"blk-24027","spans":[{"id":"spn-27987","text":"Human-readable description"}]}],[{"id":"blk-24028","spans":[{"id":"spn-27988","marks":["code"],"text":"framework"}]},{"id":"blk-24029","spans":[{"id":"spn-27989","text":"string"}]},{"id":"blk-24030","spans":[{"id":"spn-27990","text":"Yes"}]},{"id":"blk-24031","spans":[{"id":"spn-27991","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-24032","spans":[{"id":"spn-27992","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24033","spans":[{"id":"spn-27993","text":"enum"}]},{"id":"blk-24034","spans":[{"id":"spn-27994","text":"Yes"}]},{"id":"blk-24035","spans":[{"id":"spn-27995","marks":["code"],"text":"cloudflare"},{"id":"spn-27996","text":" or "},{"id":"spn-27997","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24036","spans":[{"id":"spn-27998","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-24037","spans":[{"id":"spn-27999","text":"string[]"}]},{"id":"blk-24038","spans":[{"id":"spn-28000","text":"No"}]},{"id":"blk-24039","spans":[{"id":"spn-28001","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-24040","spans":[{"id":"spn-28002","marks":["code"],"text":"provider_config"}]},{"id":"blk-24041","spans":[{"id":"spn-28003","text":"JSONB"}]},{"id":"blk-24042","spans":[{"id":"spn-28004","text":"No"}]},{"id":"blk-24043","spans":[{"id":"spn-28005","text":"Runtime-specific configuration"}]}],[{"id":"blk-24044","spans":[{"id":"spn-28006","marks":["code"],"text":"status"}]},{"id":"blk-24045","spans":[{"id":"spn-28007","text":"enum"}]},{"id":"blk-24046","spans":[{"id":"spn-28008","text":"Auto"}]},{"id":"blk-24047","spans":[{"id":"spn-28009","text":"Managed by the platform"}]}]]},{"id":"blk-24048","kind":"paragraph","spans":[{"id":"spn-28010","text":"---"}]},{"id":"blk-24049","kind":"heading","level":2,"spans":[{"id":"spn-28011","text":"Status State Machine"}]},{"id":"blk-24050","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-24052","spans":[{"id":"spn-28012","text":"Status"}]},{"id":"blk-24053","spans":[{"id":"spn-28013","text":"Meaning"}]},{"id":"blk-24054","spans":[{"id":"spn-28014","text":"Invocations Allowed"}]}],"id":"blk-24051","kind":"table","rows":[[{"id":"blk-24055","spans":[{"id":"spn-28015","marks":["code"],"text":"created"}]},{"id":"blk-24056","spans":[{"id":"spn-28016","text":"Agent exists but never deployed"}]},{"id":"blk-24057","spans":[{"id":"spn-28017","text":"No"}]}],[{"id":"blk-24058","spans":[{"id":"spn-28018","marks":["code"],"text":"deploying"}]},{"id":"blk-24059","spans":[{"id":"spn-28019","text":"Deployment in progress"}]},{"id":"blk-24060","spans":[{"id":"spn-28020","text":"No"}]}],[{"id":"blk-24061","spans":[{"id":"spn-28021","marks":["code"],"text":"active"}]},{"id":"blk-24062","spans":[{"id":"spn-28022","text":"Active deployment ready"}]},{"id":"blk-24063","spans":[{"id":"spn-28023","text":"Yes"}]}],[{"id":"blk-24064","spans":[{"id":"spn-28024","marks":["code"],"text":"error"}]},{"id":"blk-24065","spans":[{"id":"spn-28025","text":"Last deployment failed"}]},{"id":"blk-24066","spans":[{"id":"spn-28026","text":"No"}]}],[{"id":"blk-24067","spans":[{"id":"spn-28027","marks":["code"],"text":"disabled"}]},{"id":"blk-24068","spans":[{"id":"spn-28028","text":"Manually disabled by user"}]},{"id":"blk-24069","spans":[{"id":"spn-28029","text":"No"}]}]]},{"id":"blk-24070","kind":"paragraph","spans":[{"id":"spn-28030","marks":["bold"],"text":"Invariant:"},{"id":"spn-28031","text":" Only "},{"id":"spn-28032","marks":["code"],"text":"active"},{"id":"spn-28033","text":" agents accept invocations."}]},{"id":"blk-24071","kind":"paragraph","spans":[{"id":"spn-28034","text":"---"}]},{"id":"blk-24072","kind":"heading","level":2,"spans":[{"id":"spn-28035","text":"CRUD Operations"}]},{"id":"blk-24073","kind":"heading","level":3,"spans":[{"id":"spn-28036","text":"Create Agent"}]},{"id":"blk-24074","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-24075","kind":"heading","level":3,"spans":[{"id":"spn-28037","text":"Update Agent"}]},{"id":"blk-24076","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-24077","kind":"heading","level":3,"spans":[{"id":"spn-28038","text":"List Agents"}]},{"id":"blk-24078","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-24079","kind":"paragraph","spans":[{"id":"spn-28039","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-24080","kind":"heading","level":3,"spans":[{"id":"spn-28040","text":"Disable Agent"}]},{"id":"blk-24081","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-24082","kind":"paragraph","spans":[{"id":"spn-28041","text":"Sets status to "},{"id":"spn-28042","marks":["code"],"text":"disabled"},{"id":"spn-28043","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-24083","kind":"heading","level":3,"spans":[{"id":"spn-28044","text":"Delete Agent (Soft)"}]},{"id":"blk-24084","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-24085","kind":"paragraph","spans":[{"id":"spn-28045","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-24086","kind":"paragraph","spans":[{"id":"spn-28046","text":"---"}]},{"id":"blk-24087","kind":"heading","level":2,"spans":[{"id":"spn-28047","text":"Provider Config"}]},{"id":"blk-24088","kind":"paragraph","spans":[{"id":"spn-28048","text":"The "},{"id":"spn-28049","marks":["code"],"text":"provider_config"},{"id":"spn-28050","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-24089","kind":"paragraph","spans":[{"id":"spn-28051","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-24090","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-24091","kind":"paragraph","spans":[{"id":"spn-28052","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-24092","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-24093","kind":"paragraph","spans":[{"id":"spn-28053","text":"---"}]},{"id":"blk-24094","kind":"heading","level":2,"spans":[{"id":"spn-28054","text":"RLS Isolation"}]},{"id":"blk-24095","kind":"paragraph","spans":[{"id":"spn-28055","text":"Every query against the "},{"id":"spn-28056","marks":["code"],"text":"agents"},{"id":"spn-28057","text":" table is filtered by:"}]},{"id":"blk-24096","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-24097","items":[{"blocks":[{"id":"blk-24099","kind":"paragraph","spans":[{"id":"spn-28058","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-24098","kind":"list-item"},{"blocks":[{"id":"blk-24101","kind":"paragraph","spans":[{"id":"spn-28059","text":"The "},{"id":"spn-28060","marks":["code"],"text":"user_id"},{"id":"spn-28061","text":" field is set automatically from "},{"id":"spn-28062","marks":["code"],"text":"auth.uid()"},{"id":"spn-28063","text":" on creation."}]}],"id":"blk-24100","kind":"list-item"},{"blocks":[{"id":"blk-24103","kind":"paragraph","spans":[{"id":"spn-28064","text":"No admin bypass exists in MVP."}]}],"id":"blk-24102","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24104","kind":"paragraph","spans":[{"id":"spn-28065","text":"---"}]},{"id":"blk-24105","kind":"heading","level":2,"spans":[{"id":"spn-28066","text":"Checklist"}]},{"id":"blk-24106","items":[{"blocks":[{"id":"blk-24108","kind":"paragraph","spans":[{"id":"spn-28067","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-24107","kind":"list-item"},{"blocks":[{"id":"blk-24110","kind":"paragraph","spans":[{"id":"spn-28068","text":"[ ] "},{"id":"spn-28069","marks":["code"],"text":"runtime_provider"},{"id":"spn-28070","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-24109","kind":"list-item"},{"blocks":[{"id":"blk-24112","kind":"paragraph","spans":[{"id":"spn-28071","text":"[ ] Secret key names in "},{"id":"spn-28072","marks":["code"],"text":"env_var_keys"},{"id":"spn-28073","text":" have corresponding Vault entries"}]}],"id":"blk-24111","kind":"list-item"},{"blocks":[{"id":"blk-24114","kind":"paragraph","spans":[{"id":"spn-28074","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-24113","kind":"list-item"},{"blocks":[{"id":"blk-24116","kind":"paragraph","spans":[{"id":"spn-28075","text":"[ ] RLS policy is active on the "},{"id":"spn-28076","marks":["code"],"text":"agents"},{"id":"spn-28077","text":" table"}]}],"id":"blk-24115","kind":"list-item"},{"blocks":[{"id":"blk-24118","kind":"paragraph","spans":[{"id":"spn-28078","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-24117","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierarn3wlhdytfr2xbdbjmrothrmjwtahjnj3a6p46s44iqwvbarrula","vocabulary":"ampersand.docs.fs.v1"}