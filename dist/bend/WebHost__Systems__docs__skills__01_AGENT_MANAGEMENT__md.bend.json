{"bendscript":"0.1","blocks":[{"id":"blk-43012","kind":"heading","level":1,"spans":[{"id":"spn-70780","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-43014","kind":"paragraph","spans":[{"id":"spn-70781","marks":["bold"],"text":"Purpose:"},{"id":"spn-70782","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-43013","kind":"quote"},{"id":"blk-43015","kind":"heading","level":2,"spans":[{"id":"spn-70783","text":"What Is an Agent?"}]},{"id":"blk-43016","kind":"paragraph","spans":[{"id":"spn-70784","text":"An "},{"id":"spn-70785","marks":["bold"],"text":"agent"},{"id":"spn-70786","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-43017","kind":"heading","level":2,"spans":[{"id":"spn-70787","text":"Agent Fields"}]},{"head":[{"id":"blk-43019","spans":[{"id":"spn-70788","text":"Field"}]},{"id":"blk-43020","spans":[{"id":"spn-70789","text":"Type"}]},{"id":"blk-43021","spans":[{"id":"spn-70790","text":"Required"}]},{"id":"blk-43022","spans":[{"id":"spn-70791","text":"Description"}]}],"id":"blk-43018","kind":"table","rows":[[{"id":"blk-43023","spans":[{"id":"spn-70792","marks":["code"],"text":"name"}]},{"id":"blk-43024","spans":[{"id":"spn-70793","text":"string"}]},{"id":"blk-43025","spans":[{"id":"spn-70794","text":"Yes"}]},{"id":"blk-43026","spans":[{"id":"spn-70795","text":"Unique per user"}]}],[{"id":"blk-43027","spans":[{"id":"spn-70796","marks":["code"],"text":"description"}]},{"id":"blk-43028","spans":[{"id":"spn-70797","text":"string"}]},{"id":"blk-43029","spans":[{"id":"spn-70798","text":"No"}]},{"id":"blk-43030","spans":[{"id":"spn-70799","text":"Human-readable description"}]}],[{"id":"blk-43031","spans":[{"id":"spn-70800","marks":["code"],"text":"framework"}]},{"id":"blk-43032","spans":[{"id":"spn-70801","text":"string"}]},{"id":"blk-43033","spans":[{"id":"spn-70802","text":"Yes"}]},{"id":"blk-43034","spans":[{"id":"spn-70803","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-43035","spans":[{"id":"spn-70804","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-43036","spans":[{"id":"spn-70805","text":"enum"}]},{"id":"blk-43037","spans":[{"id":"spn-70806","text":"Yes"}]},{"id":"blk-43038","spans":[{"id":"spn-70807","marks":["code"],"text":"cloudflare"},{"id":"spn-70808","text":" or "},{"id":"spn-70809","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-43039","spans":[{"id":"spn-70810","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-43040","spans":[{"id":"spn-70811","text":"string[]"}]},{"id":"blk-43041","spans":[{"id":"spn-70812","text":"No"}]},{"id":"blk-43042","spans":[{"id":"spn-70813","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-43043","spans":[{"id":"spn-70814","marks":["code"],"text":"provider_config"}]},{"id":"blk-43044","spans":[{"id":"spn-70815","text":"JSONB"}]},{"id":"blk-43045","spans":[{"id":"spn-70816","text":"No"}]},{"id":"blk-43046","spans":[{"id":"spn-70817","text":"Runtime-specific configuration"}]}],[{"id":"blk-43047","spans":[{"id":"spn-70818","marks":["code"],"text":"status"}]},{"id":"blk-43048","spans":[{"id":"spn-70819","text":"enum"}]},{"id":"blk-43049","spans":[{"id":"spn-70820","text":"Auto"}]},{"id":"blk-43050","spans":[{"id":"spn-70821","text":"Managed by the platform"}]}]]},{"id":"blk-43051","kind":"heading","level":2,"spans":[{"id":"spn-70822","text":"Status State Machine"}]},{"id":"blk-43052","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-43054","spans":[{"id":"spn-70823","text":"Status"}]},{"id":"blk-43055","spans":[{"id":"spn-70824","text":"Meaning"}]},{"id":"blk-43056","spans":[{"id":"spn-70825","text":"Invocations Allowed"}]}],"id":"blk-43053","kind":"table","rows":[[{"id":"blk-43057","spans":[{"id":"spn-70826","marks":["code"],"text":"created"}]},{"id":"blk-43058","spans":[{"id":"spn-70827","text":"Agent exists but never deployed"}]},{"id":"blk-43059","spans":[{"id":"spn-70828","text":"No"}]}],[{"id":"blk-43060","spans":[{"id":"spn-70829","marks":["code"],"text":"deploying"}]},{"id":"blk-43061","spans":[{"id":"spn-70830","text":"Deployment in progress"}]},{"id":"blk-43062","spans":[{"id":"spn-70831","text":"No"}]}],[{"id":"blk-43063","spans":[{"id":"spn-70832","marks":["code"],"text":"active"}]},{"id":"blk-43064","spans":[{"id":"spn-70833","text":"Active deployment ready"}]},{"id":"blk-43065","spans":[{"id":"spn-70834","text":"Yes"}]}],[{"id":"blk-43066","spans":[{"id":"spn-70835","marks":["code"],"text":"error"}]},{"id":"blk-43067","spans":[{"id":"spn-70836","text":"Last deployment failed"}]},{"id":"blk-43068","spans":[{"id":"spn-70837","text":"No"}]}],[{"id":"blk-43069","spans":[{"id":"spn-70838","marks":["code"],"text":"disabled"}]},{"id":"blk-43070","spans":[{"id":"spn-70839","text":"Manually disabled by user"}]},{"id":"blk-43071","spans":[{"id":"spn-70840","text":"No"}]}]]},{"id":"blk-43072","kind":"paragraph","spans":[{"id":"spn-70841","marks":["bold"],"text":"Invariant:"},{"id":"spn-70842","text":" Only "},{"id":"spn-70843","marks":["code"],"text":"active"},{"id":"spn-70844","text":" agents accept invocations."}]},{"id":"blk-43073","kind":"heading","level":2,"spans":[{"id":"spn-70845","text":"CRUD Operations"}]},{"id":"blk-43074","kind":"heading","level":3,"spans":[{"id":"spn-70846","text":"Create Agent"}]},{"id":"blk-43075","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-43076","kind":"heading","level":3,"spans":[{"id":"spn-70847","text":"Update Agent"}]},{"id":"blk-43077","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-43078","kind":"heading","level":3,"spans":[{"id":"spn-70848","text":"List Agents"}]},{"id":"blk-43079","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-43080","kind":"paragraph","spans":[{"id":"spn-70849","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-43081","kind":"heading","level":3,"spans":[{"id":"spn-70850","text":"Disable Agent"}]},{"id":"blk-43082","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-43083","kind":"paragraph","spans":[{"id":"spn-70851","text":"Sets status to "},{"id":"spn-70852","marks":["code"],"text":"disabled"},{"id":"spn-70853","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-43084","kind":"heading","level":3,"spans":[{"id":"spn-70854","text":"Delete Agent (Soft)"}]},{"id":"blk-43085","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-43086","kind":"paragraph","spans":[{"id":"spn-70855","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-43087","kind":"heading","level":2,"spans":[{"id":"spn-70856","text":"Provider Config"}]},{"id":"blk-43088","kind":"paragraph","spans":[{"id":"spn-70857","text":"The "},{"id":"spn-70858","marks":["code"],"text":"provider_config"},{"id":"spn-70859","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-43089","kind":"paragraph","spans":[{"id":"spn-70860","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-43090","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-43091","kind":"paragraph","spans":[{"id":"spn-70861","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-43092","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-43093","kind":"heading","level":2,"spans":[{"id":"spn-70862","text":"RLS Isolation"}]},{"id":"blk-43094","kind":"paragraph","spans":[{"id":"spn-70863","text":"Every query against the "},{"id":"spn-70864","marks":["code"],"text":"agents"},{"id":"spn-70865","text":" table is filtered by:"}]},{"id":"blk-43095","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-43096","items":[{"blocks":[{"id":"blk-43098","kind":"paragraph","spans":[{"id":"spn-70866","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-43097","kind":"list-item"},{"blocks":[{"id":"blk-43100","kind":"paragraph","spans":[{"id":"spn-70867","text":"The "},{"id":"spn-70868","marks":["code"],"text":"user_id"},{"id":"spn-70869","text":" field is set automatically from "},{"id":"spn-70870","marks":["code"],"text":"auth.uid()"},{"id":"spn-70871","text":" on creation."}]}],"id":"blk-43099","kind":"list-item"},{"blocks":[{"id":"blk-43102","kind":"paragraph","spans":[{"id":"spn-70872","text":"No admin bypass exists in MVP."}]}],"id":"blk-43101","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43103","kind":"heading","level":2,"spans":[{"id":"spn-70873","text":"Checklist"}]},{"id":"blk-43104","items":[{"blocks":[{"id":"blk-43106","kind":"paragraph","spans":[{"id":"spn-70874","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-43105","kind":"list-item"},{"blocks":[{"id":"blk-43108","kind":"paragraph","spans":[{"id":"spn-70875","text":"[ ] "},{"id":"spn-70876","marks":["code"],"text":"runtime_provider"},{"id":"spn-70877","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-43107","kind":"list-item"},{"blocks":[{"id":"blk-43110","kind":"paragraph","spans":[{"id":"spn-70878","text":"[ ] Secret key names in "},{"id":"spn-70879","marks":["code"],"text":"env_var_keys"},{"id":"spn-70880","text":" have corresponding Vault entries"}]}],"id":"blk-43109","kind":"list-item"},{"blocks":[{"id":"blk-43112","kind":"paragraph","spans":[{"id":"spn-70881","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-43111","kind":"list-item"},{"blocks":[{"id":"blk-43114","kind":"paragraph","spans":[{"id":"spn-70882","text":"[ ] RLS policy is active on the "},{"id":"spn-70883","marks":["code"],"text":"agents"},{"id":"spn-70884","text":" table"}]}],"id":"blk-43113","kind":"list-item"},{"blocks":[{"id":"blk-43116","kind":"paragraph","spans":[{"id":"spn-70885","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-43115","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieragxlg3spfgoofx6yblzv6zgtnz24zqgz2dbeyhtejh2p2uvobqcpa","vocabulary":"ampersand.docs.fs.v1"}