{"bendscript":"0.1","blocks":[{"id":"blk-24978","kind":"heading","level":1,"spans":[{"id":"spn-30255","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-24980","kind":"paragraph","spans":[{"id":"spn-30256","marks":["bold"],"text":"Purpose:"},{"id":"spn-30257","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-24979","kind":"quote"},{"id":"blk-24981","kind":"paragraph","spans":[{"id":"spn-30258","text":"---"}]},{"id":"blk-24982","kind":"heading","level":2,"spans":[{"id":"spn-30259","text":"What Is an Agent?"}]},{"id":"blk-24983","kind":"paragraph","spans":[{"id":"spn-30260","text":"An "},{"id":"spn-30261","marks":["bold"],"text":"agent"},{"id":"spn-30262","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-24984","kind":"paragraph","spans":[{"id":"spn-30263","text":"---"}]},{"id":"blk-24985","kind":"heading","level":2,"spans":[{"id":"spn-30264","text":"Agent Fields"}]},{"head":[{"id":"blk-24987","spans":[{"id":"spn-30265","text":"Field"}]},{"id":"blk-24988","spans":[{"id":"spn-30266","text":"Type"}]},{"id":"blk-24989","spans":[{"id":"spn-30267","text":"Required"}]},{"id":"blk-24990","spans":[{"id":"spn-30268","text":"Description"}]}],"id":"blk-24986","kind":"table","rows":[[{"id":"blk-24991","spans":[{"id":"spn-30269","marks":["code"],"text":"name"}]},{"id":"blk-24992","spans":[{"id":"spn-30270","text":"string"}]},{"id":"blk-24993","spans":[{"id":"spn-30271","text":"Yes"}]},{"id":"blk-24994","spans":[{"id":"spn-30272","text":"Unique per user"}]}],[{"id":"blk-24995","spans":[{"id":"spn-30273","marks":["code"],"text":"description"}]},{"id":"blk-24996","spans":[{"id":"spn-30274","text":"string"}]},{"id":"blk-24997","spans":[{"id":"spn-30275","text":"No"}]},{"id":"blk-24998","spans":[{"id":"spn-30276","text":"Human-readable description"}]}],[{"id":"blk-24999","spans":[{"id":"spn-30277","marks":["code"],"text":"framework"}]},{"id":"blk-25000","spans":[{"id":"spn-30278","text":"string"}]},{"id":"blk-25001","spans":[{"id":"spn-30279","text":"Yes"}]},{"id":"blk-25002","spans":[{"id":"spn-30280","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-25003","spans":[{"id":"spn-30281","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-25004","spans":[{"id":"spn-30282","text":"enum"}]},{"id":"blk-25005","spans":[{"id":"spn-30283","text":"Yes"}]},{"id":"blk-25006","spans":[{"id":"spn-30284","marks":["code"],"text":"cloudflare"},{"id":"spn-30285","text":" or "},{"id":"spn-30286","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-25007","spans":[{"id":"spn-30287","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-25008","spans":[{"id":"spn-30288","text":"string[]"}]},{"id":"blk-25009","spans":[{"id":"spn-30289","text":"No"}]},{"id":"blk-25010","spans":[{"id":"spn-30290","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-25011","spans":[{"id":"spn-30291","marks":["code"],"text":"provider_config"}]},{"id":"blk-25012","spans":[{"id":"spn-30292","text":"JSONB"}]},{"id":"blk-25013","spans":[{"id":"spn-30293","text":"No"}]},{"id":"blk-25014","spans":[{"id":"spn-30294","text":"Runtime-specific configuration"}]}],[{"id":"blk-25015","spans":[{"id":"spn-30295","marks":["code"],"text":"status"}]},{"id":"blk-25016","spans":[{"id":"spn-30296","text":"enum"}]},{"id":"blk-25017","spans":[{"id":"spn-30297","text":"Auto"}]},{"id":"blk-25018","spans":[{"id":"spn-30298","text":"Managed by the platform"}]}]]},{"id":"blk-25019","kind":"paragraph","spans":[{"id":"spn-30299","text":"---"}]},{"id":"blk-25020","kind":"heading","level":2,"spans":[{"id":"spn-30300","text":"Status State Machine"}]},{"id":"blk-25021","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-25023","spans":[{"id":"spn-30301","text":"Status"}]},{"id":"blk-25024","spans":[{"id":"spn-30302","text":"Meaning"}]},{"id":"blk-25025","spans":[{"id":"spn-30303","text":"Invocations Allowed"}]}],"id":"blk-25022","kind":"table","rows":[[{"id":"blk-25026","spans":[{"id":"spn-30304","marks":["code"],"text":"created"}]},{"id":"blk-25027","spans":[{"id":"spn-30305","text":"Agent exists but never deployed"}]},{"id":"blk-25028","spans":[{"id":"spn-30306","text":"No"}]}],[{"id":"blk-25029","spans":[{"id":"spn-30307","marks":["code"],"text":"deploying"}]},{"id":"blk-25030","spans":[{"id":"spn-30308","text":"Deployment in progress"}]},{"id":"blk-25031","spans":[{"id":"spn-30309","text":"No"}]}],[{"id":"blk-25032","spans":[{"id":"spn-30310","marks":["code"],"text":"active"}]},{"id":"blk-25033","spans":[{"id":"spn-30311","text":"Active deployment ready"}]},{"id":"blk-25034","spans":[{"id":"spn-30312","text":"Yes"}]}],[{"id":"blk-25035","spans":[{"id":"spn-30313","marks":["code"],"text":"error"}]},{"id":"blk-25036","spans":[{"id":"spn-30314","text":"Last deployment failed"}]},{"id":"blk-25037","spans":[{"id":"spn-30315","text":"No"}]}],[{"id":"blk-25038","spans":[{"id":"spn-30316","marks":["code"],"text":"disabled"}]},{"id":"blk-25039","spans":[{"id":"spn-30317","text":"Manually disabled by user"}]},{"id":"blk-25040","spans":[{"id":"spn-30318","text":"No"}]}]]},{"id":"blk-25041","kind":"paragraph","spans":[{"id":"spn-30319","marks":["bold"],"text":"Invariant:"},{"id":"spn-30320","text":" Only "},{"id":"spn-30321","marks":["code"],"text":"active"},{"id":"spn-30322","text":" agents accept invocations."}]},{"id":"blk-25042","kind":"paragraph","spans":[{"id":"spn-30323","text":"---"}]},{"id":"blk-25043","kind":"heading","level":2,"spans":[{"id":"spn-30324","text":"CRUD Operations"}]},{"id":"blk-25044","kind":"heading","level":3,"spans":[{"id":"spn-30325","text":"Create Agent"}]},{"id":"blk-25045","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-25046","kind":"heading","level":3,"spans":[{"id":"spn-30326","text":"Update Agent"}]},{"id":"blk-25047","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-25048","kind":"heading","level":3,"spans":[{"id":"spn-30327","text":"List Agents"}]},{"id":"blk-25049","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-25050","kind":"paragraph","spans":[{"id":"spn-30328","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-25051","kind":"heading","level":3,"spans":[{"id":"spn-30329","text":"Disable Agent"}]},{"id":"blk-25052","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-25053","kind":"paragraph","spans":[{"id":"spn-30330","text":"Sets status to "},{"id":"spn-30331","marks":["code"],"text":"disabled"},{"id":"spn-30332","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-25054","kind":"heading","level":3,"spans":[{"id":"spn-30333","text":"Delete Agent (Soft)"}]},{"id":"blk-25055","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-25056","kind":"paragraph","spans":[{"id":"spn-30334","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-25057","kind":"paragraph","spans":[{"id":"spn-30335","text":"---"}]},{"id":"blk-25058","kind":"heading","level":2,"spans":[{"id":"spn-30336","text":"Provider Config"}]},{"id":"blk-25059","kind":"paragraph","spans":[{"id":"spn-30337","text":"The "},{"id":"spn-30338","marks":["code"],"text":"provider_config"},{"id":"spn-30339","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-25060","kind":"paragraph","spans":[{"id":"spn-30340","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-25061","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-25062","kind":"paragraph","spans":[{"id":"spn-30341","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-25063","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-25064","kind":"paragraph","spans":[{"id":"spn-30342","text":"---"}]},{"id":"blk-25065","kind":"heading","level":2,"spans":[{"id":"spn-30343","text":"RLS Isolation"}]},{"id":"blk-25066","kind":"paragraph","spans":[{"id":"spn-30344","text":"Every query against the "},{"id":"spn-30345","marks":["code"],"text":"agents"},{"id":"spn-30346","text":" table is filtered by:"}]},{"id":"blk-25067","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-25068","items":[{"blocks":[{"id":"blk-25070","kind":"paragraph","spans":[{"id":"spn-30347","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-25069","kind":"list-item"},{"blocks":[{"id":"blk-25072","kind":"paragraph","spans":[{"id":"spn-30348","text":"The "},{"id":"spn-30349","marks":["code"],"text":"user_id"},{"id":"spn-30350","text":" field is set automatically from "},{"id":"spn-30351","marks":["code"],"text":"auth.uid()"},{"id":"spn-30352","text":" on creation."}]}],"id":"blk-25071","kind":"list-item"},{"blocks":[{"id":"blk-25074","kind":"paragraph","spans":[{"id":"spn-30353","text":"No admin bypass exists in MVP."}]}],"id":"blk-25073","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25075","kind":"paragraph","spans":[{"id":"spn-30354","text":"---"}]},{"id":"blk-25076","kind":"heading","level":2,"spans":[{"id":"spn-30355","text":"Checklist"}]},{"id":"blk-25077","items":[{"blocks":[{"id":"blk-25079","kind":"paragraph","spans":[{"id":"spn-30356","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-25078","kind":"list-item"},{"blocks":[{"id":"blk-25081","kind":"paragraph","spans":[{"id":"spn-30357","text":"[ ] "},{"id":"spn-30358","marks":["code"],"text":"runtime_provider"},{"id":"spn-30359","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-25080","kind":"list-item"},{"blocks":[{"id":"blk-25083","kind":"paragraph","spans":[{"id":"spn-30360","text":"[ ] Secret key names in "},{"id":"spn-30361","marks":["code"],"text":"env_var_keys"},{"id":"spn-30362","text":" have corresponding Vault entries"}]}],"id":"blk-25082","kind":"list-item"},{"blocks":[{"id":"blk-25085","kind":"paragraph","spans":[{"id":"spn-30363","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-25084","kind":"list-item"},{"blocks":[{"id":"blk-25087","kind":"paragraph","spans":[{"id":"spn-30364","text":"[ ] RLS policy is active on the "},{"id":"spn-30365","marks":["code"],"text":"agents"},{"id":"spn-30366","text":" table"}]}],"id":"blk-25086","kind":"list-item"},{"blocks":[{"id":"blk-25089","kind":"paragraph","spans":[{"id":"spn-30367","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-25088","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierayh6e3cdacqjjemn3q4vvtw4h6cpf3fljn357j36iaqurju2rsbia","vocabulary":"ampersand.docs.fs.v1"}