{"bendscript":"0.1","blocks":[{"id":"blk-23897","kind":"heading","level":1,"spans":[{"id":"spn-27337","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-23899","kind":"paragraph","spans":[{"id":"spn-27338","marks":["bold"],"text":"Purpose:"},{"id":"spn-27339","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-23898","kind":"quote"},{"id":"blk-23900","kind":"paragraph","spans":[{"id":"spn-27340","text":"---"}]},{"id":"blk-23901","kind":"heading","level":2,"spans":[{"id":"spn-27341","text":"What Is an Agent?"}]},{"id":"blk-23902","kind":"paragraph","spans":[{"id":"spn-27342","text":"An "},{"id":"spn-27343","marks":["bold"],"text":"agent"},{"id":"spn-27344","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-23903","kind":"paragraph","spans":[{"id":"spn-27345","text":"---"}]},{"id":"blk-23904","kind":"heading","level":2,"spans":[{"id":"spn-27346","text":"Agent Fields"}]},{"head":[{"id":"blk-23906","spans":[{"id":"spn-27347","text":"Field"}]},{"id":"blk-23907","spans":[{"id":"spn-27348","text":"Type"}]},{"id":"blk-23908","spans":[{"id":"spn-27349","text":"Required"}]},{"id":"blk-23909","spans":[{"id":"spn-27350","text":"Description"}]}],"id":"blk-23905","kind":"table","rows":[[{"id":"blk-23910","spans":[{"id":"spn-27351","marks":["code"],"text":"name"}]},{"id":"blk-23911","spans":[{"id":"spn-27352","text":"string"}]},{"id":"blk-23912","spans":[{"id":"spn-27353","text":"Yes"}]},{"id":"blk-23913","spans":[{"id":"spn-27354","text":"Unique per user"}]}],[{"id":"blk-23914","spans":[{"id":"spn-27355","marks":["code"],"text":"description"}]},{"id":"blk-23915","spans":[{"id":"spn-27356","text":"string"}]},{"id":"blk-23916","spans":[{"id":"spn-27357","text":"No"}]},{"id":"blk-23917","spans":[{"id":"spn-27358","text":"Human-readable description"}]}],[{"id":"blk-23918","spans":[{"id":"spn-27359","marks":["code"],"text":"framework"}]},{"id":"blk-23919","spans":[{"id":"spn-27360","text":"string"}]},{"id":"blk-23920","spans":[{"id":"spn-27361","text":"Yes"}]},{"id":"blk-23921","spans":[{"id":"spn-27362","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-23922","spans":[{"id":"spn-27363","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-23923","spans":[{"id":"spn-27364","text":"enum"}]},{"id":"blk-23924","spans":[{"id":"spn-27365","text":"Yes"}]},{"id":"blk-23925","spans":[{"id":"spn-27366","marks":["code"],"text":"cloudflare"},{"id":"spn-27367","text":" or "},{"id":"spn-27368","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-23926","spans":[{"id":"spn-27369","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-23927","spans":[{"id":"spn-27370","text":"string[]"}]},{"id":"blk-23928","spans":[{"id":"spn-27371","text":"No"}]},{"id":"blk-23929","spans":[{"id":"spn-27372","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-23930","spans":[{"id":"spn-27373","marks":["code"],"text":"provider_config"}]},{"id":"blk-23931","spans":[{"id":"spn-27374","text":"JSONB"}]},{"id":"blk-23932","spans":[{"id":"spn-27375","text":"No"}]},{"id":"blk-23933","spans":[{"id":"spn-27376","text":"Runtime-specific configuration"}]}],[{"id":"blk-23934","spans":[{"id":"spn-27377","marks":["code"],"text":"status"}]},{"id":"blk-23935","spans":[{"id":"spn-27378","text":"enum"}]},{"id":"blk-23936","spans":[{"id":"spn-27379","text":"Auto"}]},{"id":"blk-23937","spans":[{"id":"spn-27380","text":"Managed by the platform"}]}]]},{"id":"blk-23938","kind":"paragraph","spans":[{"id":"spn-27381","text":"---"}]},{"id":"blk-23939","kind":"heading","level":2,"spans":[{"id":"spn-27382","text":"Status State Machine"}]},{"id":"blk-23940","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-23942","spans":[{"id":"spn-27383","text":"Status"}]},{"id":"blk-23943","spans":[{"id":"spn-27384","text":"Meaning"}]},{"id":"blk-23944","spans":[{"id":"spn-27385","text":"Invocations Allowed"}]}],"id":"blk-23941","kind":"table","rows":[[{"id":"blk-23945","spans":[{"id":"spn-27386","marks":["code"],"text":"created"}]},{"id":"blk-23946","spans":[{"id":"spn-27387","text":"Agent exists but never deployed"}]},{"id":"blk-23947","spans":[{"id":"spn-27388","text":"No"}]}],[{"id":"blk-23948","spans":[{"id":"spn-27389","marks":["code"],"text":"deploying"}]},{"id":"blk-23949","spans":[{"id":"spn-27390","text":"Deployment in progress"}]},{"id":"blk-23950","spans":[{"id":"spn-27391","text":"No"}]}],[{"id":"blk-23951","spans":[{"id":"spn-27392","marks":["code"],"text":"active"}]},{"id":"blk-23952","spans":[{"id":"spn-27393","text":"Active deployment ready"}]},{"id":"blk-23953","spans":[{"id":"spn-27394","text":"Yes"}]}],[{"id":"blk-23954","spans":[{"id":"spn-27395","marks":["code"],"text":"error"}]},{"id":"blk-23955","spans":[{"id":"spn-27396","text":"Last deployment failed"}]},{"id":"blk-23956","spans":[{"id":"spn-27397","text":"No"}]}],[{"id":"blk-23957","spans":[{"id":"spn-27398","marks":["code"],"text":"disabled"}]},{"id":"blk-23958","spans":[{"id":"spn-27399","text":"Manually disabled by user"}]},{"id":"blk-23959","spans":[{"id":"spn-27400","text":"No"}]}]]},{"id":"blk-23960","kind":"paragraph","spans":[{"id":"spn-27401","marks":["bold"],"text":"Invariant:"},{"id":"spn-27402","text":" Only "},{"id":"spn-27403","marks":["code"],"text":"active"},{"id":"spn-27404","text":" agents accept invocations."}]},{"id":"blk-23961","kind":"paragraph","spans":[{"id":"spn-27405","text":"---"}]},{"id":"blk-23962","kind":"heading","level":2,"spans":[{"id":"spn-27406","text":"CRUD Operations"}]},{"id":"blk-23963","kind":"heading","level":3,"spans":[{"id":"spn-27407","text":"Create Agent"}]},{"id":"blk-23964","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-23965","kind":"heading","level":3,"spans":[{"id":"spn-27408","text":"Update Agent"}]},{"id":"blk-23966","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-23967","kind":"heading","level":3,"spans":[{"id":"spn-27409","text":"List Agents"}]},{"id":"blk-23968","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-23969","kind":"paragraph","spans":[{"id":"spn-27410","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-23970","kind":"heading","level":3,"spans":[{"id":"spn-27411","text":"Disable Agent"}]},{"id":"blk-23971","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-23972","kind":"paragraph","spans":[{"id":"spn-27412","text":"Sets status to "},{"id":"spn-27413","marks":["code"],"text":"disabled"},{"id":"spn-27414","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-23973","kind":"heading","level":3,"spans":[{"id":"spn-27415","text":"Delete Agent (Soft)"}]},{"id":"blk-23974","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-23975","kind":"paragraph","spans":[{"id":"spn-27416","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-23976","kind":"paragraph","spans":[{"id":"spn-27417","text":"---"}]},{"id":"blk-23977","kind":"heading","level":2,"spans":[{"id":"spn-27418","text":"Provider Config"}]},{"id":"blk-23978","kind":"paragraph","spans":[{"id":"spn-27419","text":"The "},{"id":"spn-27420","marks":["code"],"text":"provider_config"},{"id":"spn-27421","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-23979","kind":"paragraph","spans":[{"id":"spn-27422","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-23980","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-23981","kind":"paragraph","spans":[{"id":"spn-27423","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-23982","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-23983","kind":"paragraph","spans":[{"id":"spn-27424","text":"---"}]},{"id":"blk-23984","kind":"heading","level":2,"spans":[{"id":"spn-27425","text":"RLS Isolation"}]},{"id":"blk-23985","kind":"paragraph","spans":[{"id":"spn-27426","text":"Every query against the "},{"id":"spn-27427","marks":["code"],"text":"agents"},{"id":"spn-27428","text":" table is filtered by:"}]},{"id":"blk-23986","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-23987","items":[{"blocks":[{"id":"blk-23989","kind":"paragraph","spans":[{"id":"spn-27429","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-23988","kind":"list-item"},{"blocks":[{"id":"blk-23991","kind":"paragraph","spans":[{"id":"spn-27430","text":"The "},{"id":"spn-27431","marks":["code"],"text":"user_id"},{"id":"spn-27432","text":" field is set automatically from "},{"id":"spn-27433","marks":["code"],"text":"auth.uid()"},{"id":"spn-27434","text":" on creation."}]}],"id":"blk-23990","kind":"list-item"},{"blocks":[{"id":"blk-23993","kind":"paragraph","spans":[{"id":"spn-27435","text":"No admin bypass exists in MVP."}]}],"id":"blk-23992","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23994","kind":"paragraph","spans":[{"id":"spn-27436","text":"---"}]},{"id":"blk-23995","kind":"heading","level":2,"spans":[{"id":"spn-27437","text":"Checklist"}]},{"id":"blk-23996","items":[{"blocks":[{"id":"blk-23998","kind":"paragraph","spans":[{"id":"spn-27438","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-23997","kind":"list-item"},{"blocks":[{"id":"blk-24000","kind":"paragraph","spans":[{"id":"spn-27439","text":"[ ] "},{"id":"spn-27440","marks":["code"],"text":"runtime_provider"},{"id":"spn-27441","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-23999","kind":"list-item"},{"blocks":[{"id":"blk-24002","kind":"paragraph","spans":[{"id":"spn-27442","text":"[ ] Secret key names in "},{"id":"spn-27443","marks":["code"],"text":"env_var_keys"},{"id":"spn-27444","text":" have corresponding Vault entries"}]}],"id":"blk-24001","kind":"list-item"},{"blocks":[{"id":"blk-24004","kind":"paragraph","spans":[{"id":"spn-27445","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-24003","kind":"list-item"},{"blocks":[{"id":"blk-24006","kind":"paragraph","spans":[{"id":"spn-27446","text":"[ ] RLS policy is active on the "},{"id":"spn-27447","marks":["code"],"text":"agents"},{"id":"spn-27448","text":" table"}]}],"id":"blk-24005","kind":"list-item"},{"blocks":[{"id":"blk-24008","kind":"paragraph","spans":[{"id":"spn-27449","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-24007","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierav4wklvkvvd3tbp3sgbriczsmxb64lnyggdyllbtlpiu5zciw3qnq","vocabulary":"ampersand.docs.fs.v1"}