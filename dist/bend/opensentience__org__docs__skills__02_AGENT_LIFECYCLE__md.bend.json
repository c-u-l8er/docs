{"bendscript":"0.1","blocks":[{"id":"blk-50006","kind":"heading","level":1,"spans":[{"id":"spn-58143","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-50008","kind":"paragraph","spans":[{"id":"spn-58144","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-50007","kind":"quote"},{"id":"blk-50009","kind":"paragraph","spans":[{"id":"spn-58145","text":"---"}]},{"id":"blk-50010","kind":"heading","level":2,"spans":[{"id":"spn-58146","text":"Why This Matters"}]},{"id":"blk-50011","kind":"paragraph","spans":[{"id":"spn-58147","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-50012","kind":"paragraph","spans":[{"id":"spn-58148","text":"---"}]},{"id":"blk-50013","kind":"heading","level":2,"spans":[{"id":"spn-58149","text":"The State Machine"}]},{"id":"blk-50014","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-50015","kind":"heading","level":3,"spans":[{"id":"spn-58150","text":"States"}]},{"head":[{"id":"blk-50017","spans":[{"id":"spn-58151","text":"State"}]},{"id":"blk-50018","spans":[{"id":"spn-58152","text":"Meaning"}]},{"id":"blk-50019","spans":[{"id":"spn-58153","text":"Process Running?"}]}],"id":"blk-50016","kind":"table","rows":[[{"id":"blk-50020","spans":[{"id":"spn-58154","marks":["code"],"text":"installed"}]},{"id":"blk-50021","spans":[{"id":"spn-58155","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-50022","spans":[{"id":"spn-58156","text":"No"}]}],[{"id":"blk-50023","spans":[{"id":"spn-58157","marks":["code"],"text":"enabled"}]},{"id":"blk-50024","spans":[{"id":"spn-58158","text":"Supervised process started"}]},{"id":"blk-50025","spans":[{"id":"spn-58159","text":"Yes (idle or working)"}]}],[{"id":"blk-50026","spans":[{"id":"spn-58160","marks":["code"],"text":"running"}]},{"id":"blk-50027","spans":[{"id":"spn-58161","text":"Actively executing a task"}]},{"id":"blk-50028","spans":[{"id":"spn-58162","text":"Yes"}]}],[{"id":"blk-50029","spans":[{"id":"spn-58163","marks":["code"],"text":"disabled"}]},{"id":"blk-50030","spans":[{"id":"spn-58164","text":"Process stopped, can be re-enabled"}]},{"id":"blk-50031","spans":[{"id":"spn-58165","text":"No"}]}],[{"id":"blk-50032","spans":[{"id":"spn-58166","marks":["code"],"text":"removed"}]},{"id":"blk-50033","spans":[{"id":"spn-58167","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-50034","spans":[{"id":"spn-58168","text":"No"}]}]]},{"id":"blk-50035","kind":"heading","level":3,"spans":[{"id":"spn-58169","text":"Valid Transitions"}]},{"head":[{"id":"blk-50037","spans":[{"id":"spn-58170","text":"From"}]},{"id":"blk-50038","spans":[{"id":"spn-58171","text":"To"}]},{"id":"blk-50039","spans":[{"id":"spn-58172","text":"Trigger"}]},{"id":"blk-50040","spans":[{"id":"spn-58173","text":"Tool"}]}],"id":"blk-50036","kind":"table","rows":[[{"id":"blk-50041","spans":[{"id":"spn-58174","marks":["code"],"text":"installed"}]},{"id":"blk-50042","spans":[{"id":"spn-58175","marks":["code"],"text":"enabled"}]},{"id":"blk-50043","spans":[{"id":"spn-58176","text":"Operator activates agent"}]},{"id":"blk-50044","spans":[{"id":"spn-58177","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-50045","spans":[{"id":"spn-58178","marks":["code"],"text":"enabled"}]},{"id":"blk-50046","spans":[{"id":"spn-58179","marks":["code"],"text":"running"}]},{"id":"blk-50047","spans":[{"id":"spn-58180","text":"Agent begins work"}]},{"id":"blk-50048","spans":[{"id":"spn-58181","text":"Automatic"}]}],[{"id":"blk-50049","spans":[{"id":"spn-58182","marks":["code"],"text":"running"}]},{"id":"blk-50050","spans":[{"id":"spn-58183","marks":["code"],"text":"enabled"}]},{"id":"blk-50051","spans":[{"id":"spn-58184","text":"Agent completes work"}]},{"id":"blk-50052","spans":[{"id":"spn-58185","text":"Automatic"}]}],[{"id":"blk-50053","spans":[{"id":"spn-58186","marks":["code"],"text":"enabled"}]},{"id":"blk-50054","spans":[{"id":"spn-58187","marks":["code"],"text":"disabled"}]},{"id":"blk-50055","spans":[{"id":"spn-58188","text":"Operator stops agent"}]},{"id":"blk-50056","spans":[{"id":"spn-58189","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-50057","spans":[{"id":"spn-58190","marks":["code"],"text":"running"}]},{"id":"blk-50058","spans":[{"id":"spn-58191","marks":["code"],"text":"disabled"}]},{"id":"blk-50059","spans":[{"id":"spn-58192","text":"Operator force-stops agent"}]},{"id":"blk-50060","spans":[{"id":"spn-58193","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-50061","spans":[{"id":"spn-58194","marks":["code"],"text":"disabled"}]},{"id":"blk-50062","spans":[{"id":"spn-58195","marks":["code"],"text":"enabled"}]},{"id":"blk-50063","spans":[{"id":"spn-58196","text":"Operator re-activates"}]},{"id":"blk-50064","spans":[{"id":"spn-58197","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-50065","spans":[{"id":"spn-58198","marks":["code"],"text":"disabled"}]},{"id":"blk-50066","spans":[{"id":"spn-58199","marks":["code"],"text":"removed"}]},{"id":"blk-50067","spans":[{"id":"spn-58200","text":"Operator deregisters"}]},{"id":"blk-50068","spans":[{"id":"spn-58201","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-50069","kind":"paragraph","spans":[{"id":"spn-58202","text":"Invalid transitions (e.g., "},{"id":"spn-58203","marks":["code"],"text":"installed"},{"id":"spn-58204","text":" directly to "},{"id":"spn-58205","marks":["code"],"text":"running"},{"id":"spn-58206","text":", or "},{"id":"spn-58207","marks":["code"],"text":"removed"},{"id":"spn-58208","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-50070","kind":"paragraph","spans":[{"id":"spn-58209","text":"---"}]},{"id":"blk-50071","kind":"heading","level":2,"spans":[{"id":"spn-58210","text":"agent_install — Registering an Agent"}]},{"id":"blk-50072","kind":"heading","level":3,"spans":[{"id":"spn-58211","text":"Manifest Schema"}]},{"id":"blk-50073","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-50074","kind":"heading","level":3,"spans":[{"id":"spn-58212","text":"What Happens on Install"}]},{"id":"blk-50075","kind":"paragraph","spans":[{"id":"spn-58213","text":"1. PermissionEngine writes grants and denials to ETS 2. AgentSupervisor starts a new AgentLifecycle GenStateMachine 3. Initial state is set to "},{"id":"spn-58214","marks":["code"],"text":":installed"},{"id":"spn-58215","text":" 4. AuditWriter logs the install event with full manifest"}]},{"id":"blk-50076","kind":"heading","level":3,"spans":[{"id":"spn-58216","text":"Denied Permissions"}]},{"id":"blk-50077","kind":"paragraph","spans":[{"id":"spn-58217","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-58218","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-58219","text":" but deny "},{"id":"spn-58220","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-58221","text":", the denial wins for any path matching "},{"id":"spn-58222","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-58223","text":"."}]},{"id":"blk-50078","kind":"paragraph","spans":[{"id":"spn-58224","text":"---"}]},{"id":"blk-50079","kind":"heading","level":2,"spans":[{"id":"spn-58225","text":"agent_enable — Starting the Agent"}]},{"id":"blk-50080","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-50081","kind":"paragraph","spans":[{"id":"spn-58226","text":"1. GenStateMachine validates the transition (must be in "},{"id":"spn-58227","marks":["code"],"text":"installed"},{"id":"spn-58228","text":" or "},{"id":"spn-58229","marks":["code"],"text":"disabled"},{"id":"spn-58230","text":") 2. The wrapped "},{"id":"spn-58231","marks":["code"],"text":"child_spec"},{"id":"spn-58232","text":" is started under AgentSupervisor 3. State transitions to "},{"id":"spn-58233","marks":["code"],"text":"enabled"},{"id":"spn-58234","text":" 4. Audit entry is written 5. AutonomyController sets default level ("},{"id":"spn-58235","marks":["code"],"text":"observe"},{"id":"spn-58236","text":") if not already set"}]},{"id":"blk-50082","kind":"paragraph","spans":[{"id":"spn-58237","text":"---"}]},{"id":"blk-50083","kind":"heading","level":2,"spans":[{"id":"spn-58238","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-50084","kind":"heading","level":3,"spans":[{"id":"spn-58239","text":"Graceful Stop"}]},{"id":"blk-50085","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-50086","kind":"paragraph","spans":[{"id":"spn-58240","text":"1. Sends a shutdown signal to the wrapped process 2. Waits for configurable timeout (default 5 seconds) 3. If process exits cleanly, state transitions to "},{"id":"spn-58241","marks":["code"],"text":"disabled"},{"id":"spn-58242","text":" 4. Audit entry records graceful shutdown"}]},{"id":"blk-50087","kind":"heading","level":3,"spans":[{"id":"spn-58243","text":"Emergency Stop"}]},{"id":"blk-50088","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-50089","kind":"paragraph","spans":[{"id":"spn-58244","text":"1. Immediately kills the wrapped process ("},{"id":"spn-58245","marks":["code"],"text":":kill"},{"id":"spn-58246","text":" signal) 2. State transitions to "},{"id":"spn-58247","marks":["code"],"text":"disabled"},{"id":"spn-58248","text":" 3. Audit entry records forced shutdown with reason"}]},{"id":"blk-50090","kind":"paragraph","spans":[{"id":"spn-58249","text":"---"}]},{"id":"blk-50091","kind":"heading","level":2,"spans":[{"id":"spn-58250","text":"GenStateMachine Internals"}]},{"id":"blk-50092","kind":"paragraph","spans":[{"id":"spn-58251","text":"Each AgentLifecycle is a "},{"id":"spn-58252","marks":["code"],"text":"gen_statem"},{"id":"spn-58253","text":" process with the following structure:"}]},{"id":"blk-50093","items":[{"blocks":[{"id":"blk-50095","kind":"paragraph","spans":[{"id":"spn-58254","marks":["bold"],"text":"State data:"},{"id":"spn-58255","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-50094","kind":"list-item"},{"blocks":[{"id":"blk-50097","kind":"paragraph","spans":[{"id":"spn-58256","marks":["bold"],"text":"Callbacks:"},{"id":"spn-58257","text":" "},{"id":"spn-58258","marks":["code"],"text":"handle_event/4"},{"id":"spn-58259","text":" for each valid transition"}]}],"id":"blk-50096","kind":"list-item"},{"blocks":[{"id":"blk-50099","kind":"paragraph","spans":[{"id":"spn-58260","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-58261","text":" return "},{"id":"spn-58262","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-58263","text":" with an error"}]}],"id":"blk-50098","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50100","kind":"paragraph","spans":[{"id":"spn-58264","text":"logged to the audit trail"}]},{"id":"blk-50101","items":[{"blocks":[{"id":"blk-50103","kind":"paragraph","spans":[{"id":"spn-58265","marks":["bold"],"text":"Crash handling:"},{"id":"spn-58266","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-50102","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50104","kind":"paragraph","spans":[{"id":"spn-58267","text":"transitions back to "},{"id":"spn-58268","marks":["code"],"text":"enabled"},{"id":"spn-58269","text":" (not "},{"id":"spn-58270","marks":["code"],"text":"disabled"},{"id":"spn-58271","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-50105","kind":"paragraph","spans":[{"id":"spn-58272","text":"---"}]},{"id":"blk-50106","kind":"heading","level":2,"spans":[{"id":"spn-58273","text":"Common Lifecycle Patterns"}]},{"id":"blk-50107","kind":"heading","level":3,"spans":[{"id":"spn-58274","text":"Install-and-Observe"}]},{"id":"blk-50108","kind":"paragraph","spans":[{"id":"spn-58275","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-58276","marks":["code"],"text":"observe"},{"id":"spn-58277","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-58278","marks":["code"],"text":"advise"},{"id":"spn-58279","text":" and "},{"id":"spn-58280","marks":["code"],"text":"act"},{"id":"spn-58281","text":"."}]},{"id":"blk-50109","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-50110","kind":"heading","level":3,"spans":[{"id":"spn-58282","text":"Temporary Agent"}]},{"id":"blk-50111","kind":"paragraph","spans":[{"id":"spn-58283","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-50112","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-50113","kind":"heading","level":3,"spans":[{"id":"spn-58284","text":"Rolling Restart"}]},{"id":"blk-50114","kind":"paragraph","spans":[{"id":"spn-58285","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-50115","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-50116","kind":"paragraph","spans":[{"id":"spn-58286","text":"---"}]},{"id":"blk-50117","kind":"heading","level":2,"spans":[{"id":"spn-58287","text":"Querying State"}]},{"id":"blk-50118","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-50119","kind":"paragraph","spans":[{"id":"spn-58288","text":"Returns:"}]},{"id":"blk-50120","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[],"id":"bagaaierakqr3xzwkewcmxr7w3hxp636oelxlkoentrdawh5o4am34mycu7ya","vocabulary":"ampersand.docs.fs.v1"}