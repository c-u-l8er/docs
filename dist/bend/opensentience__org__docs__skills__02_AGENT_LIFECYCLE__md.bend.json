{"bendscript":"0.1","blocks":[{"id":"blk-49034","kind":"heading","level":1,"spans":[{"id":"spn-55849","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-49036","kind":"paragraph","spans":[{"id":"spn-55850","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-49035","kind":"quote"},{"id":"blk-49037","kind":"paragraph","spans":[{"id":"spn-55851","text":"---"}]},{"id":"blk-49038","kind":"heading","level":2,"spans":[{"id":"spn-55852","text":"Why This Matters"}]},{"id":"blk-49039","kind":"paragraph","spans":[{"id":"spn-55853","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-49040","kind":"paragraph","spans":[{"id":"spn-55854","text":"---"}]},{"id":"blk-49041","kind":"heading","level":2,"spans":[{"id":"spn-55855","text":"The State Machine"}]},{"id":"blk-49042","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-49043","kind":"heading","level":3,"spans":[{"id":"spn-55856","text":"States"}]},{"head":[{"id":"blk-49045","spans":[{"id":"spn-55857","text":"State"}]},{"id":"blk-49046","spans":[{"id":"spn-55858","text":"Meaning"}]},{"id":"blk-49047","spans":[{"id":"spn-55859","text":"Process Running?"}]}],"id":"blk-49044","kind":"table","rows":[[{"id":"blk-49048","spans":[{"id":"spn-55860","marks":["code"],"text":"installed"}]},{"id":"blk-49049","spans":[{"id":"spn-55861","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-49050","spans":[{"id":"spn-55862","text":"No"}]}],[{"id":"blk-49051","spans":[{"id":"spn-55863","marks":["code"],"text":"enabled"}]},{"id":"blk-49052","spans":[{"id":"spn-55864","text":"Supervised process started"}]},{"id":"blk-49053","spans":[{"id":"spn-55865","text":"Yes (idle or working)"}]}],[{"id":"blk-49054","spans":[{"id":"spn-55866","marks":["code"],"text":"running"}]},{"id":"blk-49055","spans":[{"id":"spn-55867","text":"Actively executing a task"}]},{"id":"blk-49056","spans":[{"id":"spn-55868","text":"Yes"}]}],[{"id":"blk-49057","spans":[{"id":"spn-55869","marks":["code"],"text":"disabled"}]},{"id":"blk-49058","spans":[{"id":"spn-55870","text":"Process stopped, can be re-enabled"}]},{"id":"blk-49059","spans":[{"id":"spn-55871","text":"No"}]}],[{"id":"blk-49060","spans":[{"id":"spn-55872","marks":["code"],"text":"removed"}]},{"id":"blk-49061","spans":[{"id":"spn-55873","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-49062","spans":[{"id":"spn-55874","text":"No"}]}]]},{"id":"blk-49063","kind":"heading","level":3,"spans":[{"id":"spn-55875","text":"Valid Transitions"}]},{"head":[{"id":"blk-49065","spans":[{"id":"spn-55876","text":"From"}]},{"id":"blk-49066","spans":[{"id":"spn-55877","text":"To"}]},{"id":"blk-49067","spans":[{"id":"spn-55878","text":"Trigger"}]},{"id":"blk-49068","spans":[{"id":"spn-55879","text":"Tool"}]}],"id":"blk-49064","kind":"table","rows":[[{"id":"blk-49069","spans":[{"id":"spn-55880","marks":["code"],"text":"installed"}]},{"id":"blk-49070","spans":[{"id":"spn-55881","marks":["code"],"text":"enabled"}]},{"id":"blk-49071","spans":[{"id":"spn-55882","text":"Operator activates agent"}]},{"id":"blk-49072","spans":[{"id":"spn-55883","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-49073","spans":[{"id":"spn-55884","marks":["code"],"text":"enabled"}]},{"id":"blk-49074","spans":[{"id":"spn-55885","marks":["code"],"text":"running"}]},{"id":"blk-49075","spans":[{"id":"spn-55886","text":"Agent begins work"}]},{"id":"blk-49076","spans":[{"id":"spn-55887","text":"Automatic"}]}],[{"id":"blk-49077","spans":[{"id":"spn-55888","marks":["code"],"text":"running"}]},{"id":"blk-49078","spans":[{"id":"spn-55889","marks":["code"],"text":"enabled"}]},{"id":"blk-49079","spans":[{"id":"spn-55890","text":"Agent completes work"}]},{"id":"blk-49080","spans":[{"id":"spn-55891","text":"Automatic"}]}],[{"id":"blk-49081","spans":[{"id":"spn-55892","marks":["code"],"text":"enabled"}]},{"id":"blk-49082","spans":[{"id":"spn-55893","marks":["code"],"text":"disabled"}]},{"id":"blk-49083","spans":[{"id":"spn-55894","text":"Operator stops agent"}]},{"id":"blk-49084","spans":[{"id":"spn-55895","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-49085","spans":[{"id":"spn-55896","marks":["code"],"text":"running"}]},{"id":"blk-49086","spans":[{"id":"spn-55897","marks":["code"],"text":"disabled"}]},{"id":"blk-49087","spans":[{"id":"spn-55898","text":"Operator force-stops agent"}]},{"id":"blk-49088","spans":[{"id":"spn-55899","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-49089","spans":[{"id":"spn-55900","marks":["code"],"text":"disabled"}]},{"id":"blk-49090","spans":[{"id":"spn-55901","marks":["code"],"text":"enabled"}]},{"id":"blk-49091","spans":[{"id":"spn-55902","text":"Operator re-activates"}]},{"id":"blk-49092","spans":[{"id":"spn-55903","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-49093","spans":[{"id":"spn-55904","marks":["code"],"text":"disabled"}]},{"id":"blk-49094","spans":[{"id":"spn-55905","marks":["code"],"text":"removed"}]},{"id":"blk-49095","spans":[{"id":"spn-55906","text":"Operator deregisters"}]},{"id":"blk-49096","spans":[{"id":"spn-55907","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-49097","kind":"paragraph","spans":[{"id":"spn-55908","text":"Invalid transitions (e.g., "},{"id":"spn-55909","marks":["code"],"text":"installed"},{"id":"spn-55910","text":" directly to "},{"id":"spn-55911","marks":["code"],"text":"running"},{"id":"spn-55912","text":", or "},{"id":"spn-55913","marks":["code"],"text":"removed"},{"id":"spn-55914","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-49098","kind":"paragraph","spans":[{"id":"spn-55915","text":"---"}]},{"id":"blk-49099","kind":"heading","level":2,"spans":[{"id":"spn-55916","text":"agent_install — Registering an Agent"}]},{"id":"blk-49100","kind":"heading","level":3,"spans":[{"id":"spn-55917","text":"Manifest Schema"}]},{"id":"blk-49101","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-49102","kind":"heading","level":3,"spans":[{"id":"spn-55918","text":"What Happens on Install"}]},{"id":"blk-49103","kind":"paragraph","spans":[{"id":"spn-55919","text":"1. PermissionEngine writes grants and denials to ETS 2. AgentSupervisor starts a new AgentLifecycle GenStateMachine 3. Initial state is set to "},{"id":"spn-55920","marks":["code"],"text":":installed"},{"id":"spn-55921","text":" 4. AuditWriter logs the install event with full manifest"}]},{"id":"blk-49104","kind":"heading","level":3,"spans":[{"id":"spn-55922","text":"Denied Permissions"}]},{"id":"blk-49105","kind":"paragraph","spans":[{"id":"spn-55923","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-55924","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-55925","text":" but deny "},{"id":"spn-55926","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-55927","text":", the denial wins for any path matching "},{"id":"spn-55928","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-55929","text":"."}]},{"id":"blk-49106","kind":"paragraph","spans":[{"id":"spn-55930","text":"---"}]},{"id":"blk-49107","kind":"heading","level":2,"spans":[{"id":"spn-55931","text":"agent_enable — Starting the Agent"}]},{"id":"blk-49108","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-49109","kind":"paragraph","spans":[{"id":"spn-55932","text":"1. GenStateMachine validates the transition (must be in "},{"id":"spn-55933","marks":["code"],"text":"installed"},{"id":"spn-55934","text":" or "},{"id":"spn-55935","marks":["code"],"text":"disabled"},{"id":"spn-55936","text":") 2. The wrapped "},{"id":"spn-55937","marks":["code"],"text":"child_spec"},{"id":"spn-55938","text":" is started under AgentSupervisor 3. State transitions to "},{"id":"spn-55939","marks":["code"],"text":"enabled"},{"id":"spn-55940","text":" 4. Audit entry is written 5. AutonomyController sets default level ("},{"id":"spn-55941","marks":["code"],"text":"observe"},{"id":"spn-55942","text":") if not already set"}]},{"id":"blk-49110","kind":"paragraph","spans":[{"id":"spn-55943","text":"---"}]},{"id":"blk-49111","kind":"heading","level":2,"spans":[{"id":"spn-55944","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-49112","kind":"heading","level":3,"spans":[{"id":"spn-55945","text":"Graceful Stop"}]},{"id":"blk-49113","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-49114","kind":"paragraph","spans":[{"id":"spn-55946","text":"1. Sends a shutdown signal to the wrapped process 2. Waits for configurable timeout (default 5 seconds) 3. If process exits cleanly, state transitions to "},{"id":"spn-55947","marks":["code"],"text":"disabled"},{"id":"spn-55948","text":" 4. Audit entry records graceful shutdown"}]},{"id":"blk-49115","kind":"heading","level":3,"spans":[{"id":"spn-55949","text":"Emergency Stop"}]},{"id":"blk-49116","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-49117","kind":"paragraph","spans":[{"id":"spn-55950","text":"1. Immediately kills the wrapped process ("},{"id":"spn-55951","marks":["code"],"text":":kill"},{"id":"spn-55952","text":" signal) 2. State transitions to "},{"id":"spn-55953","marks":["code"],"text":"disabled"},{"id":"spn-55954","text":" 3. Audit entry records forced shutdown with reason"}]},{"id":"blk-49118","kind":"paragraph","spans":[{"id":"spn-55955","text":"---"}]},{"id":"blk-49119","kind":"heading","level":2,"spans":[{"id":"spn-55956","text":"GenStateMachine Internals"}]},{"id":"blk-49120","kind":"paragraph","spans":[{"id":"spn-55957","text":"Each AgentLifecycle is a "},{"id":"spn-55958","marks":["code"],"text":"gen_statem"},{"id":"spn-55959","text":" process with the following structure:"}]},{"id":"blk-49121","items":[{"blocks":[{"id":"blk-49123","kind":"paragraph","spans":[{"id":"spn-55960","marks":["bold"],"text":"State data:"},{"id":"spn-55961","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-49122","kind":"list-item"},{"blocks":[{"id":"blk-49125","kind":"paragraph","spans":[{"id":"spn-55962","marks":["bold"],"text":"Callbacks:"},{"id":"spn-55963","text":" "},{"id":"spn-55964","marks":["code"],"text":"handle_event/4"},{"id":"spn-55965","text":" for each valid transition"}]}],"id":"blk-49124","kind":"list-item"},{"blocks":[{"id":"blk-49127","kind":"paragraph","spans":[{"id":"spn-55966","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-55967","text":" return "},{"id":"spn-55968","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-55969","text":" with an error"}]}],"id":"blk-49126","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49128","kind":"paragraph","spans":[{"id":"spn-55970","text":"logged to the audit trail"}]},{"id":"blk-49129","items":[{"blocks":[{"id":"blk-49131","kind":"paragraph","spans":[{"id":"spn-55971","marks":["bold"],"text":"Crash handling:"},{"id":"spn-55972","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-49130","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49132","kind":"paragraph","spans":[{"id":"spn-55973","text":"transitions back to "},{"id":"spn-55974","marks":["code"],"text":"enabled"},{"id":"spn-55975","text":" (not "},{"id":"spn-55976","marks":["code"],"text":"disabled"},{"id":"spn-55977","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-49133","kind":"paragraph","spans":[{"id":"spn-55978","text":"---"}]},{"id":"blk-49134","kind":"heading","level":2,"spans":[{"id":"spn-55979","text":"Common Lifecycle Patterns"}]},{"id":"blk-49135","kind":"heading","level":3,"spans":[{"id":"spn-55980","text":"Install-and-Observe"}]},{"id":"blk-49136","kind":"paragraph","spans":[{"id":"spn-55981","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-55982","marks":["code"],"text":"observe"},{"id":"spn-55983","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-55984","marks":["code"],"text":"advise"},{"id":"spn-55985","text":" and "},{"id":"spn-55986","marks":["code"],"text":"act"},{"id":"spn-55987","text":"."}]},{"id":"blk-49137","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-49138","kind":"heading","level":3,"spans":[{"id":"spn-55988","text":"Temporary Agent"}]},{"id":"blk-49139","kind":"paragraph","spans":[{"id":"spn-55989","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-49140","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-49141","kind":"heading","level":3,"spans":[{"id":"spn-55990","text":"Rolling Restart"}]},{"id":"blk-49142","kind":"paragraph","spans":[{"id":"spn-55991","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-49143","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-49144","kind":"paragraph","spans":[{"id":"spn-55992","text":"---"}]},{"id":"blk-49145","kind":"heading","level":2,"spans":[{"id":"spn-55993","text":"Querying State"}]},{"id":"blk-49146","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-49147","kind":"paragraph","spans":[{"id":"spn-55994","text":"Returns:"}]},{"id":"blk-49148","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[],"id":"bagaaierams42gvwvusrjyphmdbg3ww5oa22bzit5qfyj5v43poustdqc7lra","vocabulary":"ampersand.docs.fs.v1"}