75043","spans":[{"id":"spn-106420","text":"Agent completes work"}]},{"id":"blk-75044","spans":[{"id":"spn-106421","text":"Automatic"}]}],[{"id":"blk-75045","spans":[{"id":"spn-106422","marks":["code"],"text":"enabled"}]},{"id":"blk-75046","spans":[{"id":"spn-106423","marks":["code"],"text":"disabled"}]},{"id":"blk-75047","spans":[{"id":"spn-106424","text":"Operator stops agent"}]},{"id":"blk-75048","spans":[{"id":"spn-106425","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-75049","spans":[{"id":"spn-106426","marks":["code"],"text":"running"}]},{"id":"blk-75050","spans":[{"id":"spn-106427","marks":["code"],"text":"disabled"}]},{"id":"blk-75051","spans":[{"id":"spn-106428","text":"Operator force-stops agent"}]},{"id":"blk-75052","spans":[{"id":"spn-106429","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-75053","spans":[{"id":"spn-106430","marks":["code"],"text":"disabled"}]},{"id":"blk-75054","spans":[{"id":"spn-106431","marks":["code"],"text":"enabled"}]},{"id":"blk-75055","spans":[{"id":"spn-106432","text":"Operator re-activates"}]},{"id":"blk-75056","spans":[{"id":"spn-106433","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-75057","spans":[{"id":"spn-106434","marks":["code"],"text":"disabled"}]},{"id":"blk-75058","spans":[{"id":"spn-106435","marks":["code"],"text":"removed"}]},{"id":"blk-75059","spans":[{"id":"spn-106436","text":"Operator deregisters"}]},{"id":"blk-75060","spans":[{"id":"spn-106437","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-75061","kind":"paragraph","spans":[{"id":"spn-106438","text":"Invalid transitions (e.g., "},{"id":"spn-106439","marks":["code"],"text":"installed"},{"id":"spn-106440","text":" directly to "},{"id":"spn-106441","marks":["code"],"text":"running"},{"id":"spn-106442","text":", or "},{"id":"spn-106443","marks":["code"],"text":"removed"},{"id":"spn-106444","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-75062","kind":"heading","level":2,"spans":[{"id":"spn-106445","text":"agent_install — Registering an Agent"}]},{"id":"blk-75063","kind":"heading","level":3,"spans":[{"id":"spn-106446","text":"Manifest Schema"}]},{"id":"blk-75064","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-75065","kind":"heading","level":3,"spans":[{"id":"spn-106447","text":"What Happens on Install"}]},{"id":"blk-75066","items":[{"blocks":[{"id":"blk-75068","kind":"paragraph","spans":[{"id":"spn-106448","text":"PermissionEngine writes grants and denials to ETS"}]}],"id":"blk-75067","kind":"list-item"},{"blocks":[{"id":"blk-75070","kind":"paragraph","spans":[{"id":"spn-106449","text":"AgentSupervisor starts a new AgentLifecycle GenStateMachine"}]}],"id":"blk-75069","kind":"list-item"},{"blocks":[{"id":"blk-75072","kind":"paragraph","spans":[{"id":"spn-106450","text":"Initial state is set to "},{"id":"spn-106451","marks":["code"],"text":":installed"}]}],"id":"blk-75071","kind":"list-item"},{"blocks":[{"id":"blk-75074","kind":"paragraph","spans":[{"id":"spn-106452","text":"AuditWriter logs the install event with full manifest"}]}],"id":"blk-75073","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75075","kind":"heading","level":3,"spans":[{"id":"spn-106453","text":"Denied Permissions"}]},{"id":"blk-75076","kind":"paragraph","spans":[{"id":"spn-106454","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-106455","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-106456","text":" but deny "},{"id":"spn-106457","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-106458","text":", the denial wins for any path matching "},{"id":"spn-106459","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-106460","text":"."}]},{"id":"blk-75077","kind":"heading","level":2,"spans":[{"id":"spn-106461","text":"agent_enable — Starting the Agent"}]},{"id":"blk-75078","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-75079","items":[{"blocks":[{"id":"blk-75081","kind":"paragraph","spans":[{"id":"spn-106462","text":"GenStateMachine validates the transition (must be in "},{"id":"spn-106463","marks":["code"],"text":"installed"},{"id":"spn-106464","text":" or "},{"id":"spn-106465","marks":["code"],"text":"disabled"},{"id":"spn-106466","text":")"}]}],"id":"blk-75080","kind":"list-item"},{"blocks":[{"id":"blk-75083","kind":"paragraph","spans":[{"id":"spn-106467","text":"The wrapped "},{"id":"spn-106468","marks":["code"],"text":"child_spec"},{"id":"spn-106469","text":" is started under AgentSupervisor"}]}],"id":"blk-75082","kind":"list-item"},{"blocks":[{"id":"blk-75085","kind":"paragraph","spans":[{"id":"spn-106470","text":"State transitions to "},{"id":"spn-106471","marks":["code"],"text":"enabled"}]}],"id":"blk-75084","kind":"list-item"},{"blocks":[{"id":"blk-75087","kind":"paragraph","spans":[{"id":"spn-106472","text":"Audit entry is written"}]}],"id":"blk-75086","kind":"list-item"},{"blocks":[{"id":"blk-75089","kind":"paragraph","spans":[{"id":"spn-106473","text":"AutonomyController sets default level ("},{"id":"spn-106474","marks":["code"],"text":"observe"},{"id":"spn-106475","text":") if not already set"}]}],"id":"blk-75088","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75090","kind":"heading","level":2,"spans":[{"id":"spn-106476","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-75091","kind":"heading","level":3,"spans":[{"id":"spn-106477","text":"Graceful Stop"}]},{"id":"blk-75092","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-75093","items":[{"blocks":[{"id":"blk-75095","kind":"paragraph","spans":[{"id":"spn-106478","text":"Sends a shutdown signal to the wrapped process"}]}],"id":"blk-75094","kind":"list-item"},{"blocks":[{"id":"blk-75097","kind":"paragraph","spans":[{"id":"spn-106479","text":"Waits for configurable timeout (default 5 seconds)"}]}],"id":"blk-75096","kind":"list-item"},{"blocks":[{"id":"blk-75099","kind":"paragraph","spans":[{"id":"spn-106480","text":"If process exits cleanly, state transitions to "},{"id":"spn-106481","marks":["code"],"text":"disabled"}]}],"id":"blk-75098","kind":"list-item"},{"blocks":[{"id":"blk-75101","kind":"paragraph","spans":[{"id":"spn-106482","text":"Audit entry records graceful shutdown"}]}],"id":"blk-75100","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75102","kind":"heading","level":3,"spans":[{"id":"spn-106483","text":"Emergency Stop"}]},{"id":"blk-75103","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-75104","items":[{"blocks":[{"id":"blk-75106","kind":"paragraph","spans":[{"id":"spn-106484","text":"Immediately kills the wrapped process ("},{"id":"spn-106485","marks":["code"],"text":":kill"},{"id":"spn-106486","text":" signal)"}]}],"id":"blk-75105","kind":"list-item"},{"blocks":[{"id":"blk-75108","kind":"paragraph","spans":[{"id":"spn-106487","text":"State transitions to "},{"id":"spn-106488","marks":["code"],"text":"disabled"}]}],"id":"blk-75107","kind":"list-item"},{"blocks":[{"id":"blk-75110","kind":"paragraph","spans":[{"id":"spn-106489","text":"Audit entry records forced shutdown with reason"}]}],"id":"blk-75109","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75111","kind":"heading","level":2,"spans":[{"id":"spn-106490","text":"GenStateMachine Internals"}]},{"id":"blk-75112","kind":"paragraph","spans":[{"id":"spn-106491","text":"Each AgentLifecycle is a "},{"id":"spn-106492","marks":["code"],"text":"gen_statem"},{"id":"spn-106493","text":" process with the following structure:"}]},{"id":"blk-75113","items":[{"blocks":[{"id":"blk-75115","kind":"paragraph","spans":[{"id":"spn-106494","marks":["bold"],"text":"State data:"},{"id":"spn-106495","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-75114","kind":"list-item"},{"blocks":[{"id":"blk-75117","kind":"paragraph","spans":[{"id":"spn-106496","marks":["bold"],"text":"Callbacks:"},{"id":"spn-106497","text":" "},{"id":"spn-106498","marks":["code"],"text":"handle_event/4"},{"id":"spn-106499","text":" for each valid transition"}]}],"id":"blk-75116","kind":"list-item"},{"blocks":[{"id":"blk-75119","kind":"paragraph","spans":[{"id":"spn-106500","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-106501","text":" return "},{"id":"spn-106502","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-106503","text":" with an error"}]}],"id":"blk-75118","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75120","kind":"paragraph","spans":[{"id":"spn-106504","text":"logged to the audit trail"}]},{"id":"blk-75121","items":[{"blocks":[{"id":"blk-75123","kind":"paragraph","spans":[{"id":"spn-106505","marks":["bold"],"text":"Crash handling:"},{"id":"spn-106506","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-75122","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75124","kind":"paragraph","spans":[{"id":"spn-106507","text":"transitions back to "},{"id":"spn-106508","marks":["code"],"text":"enabled"},{"id":"spn-106509","text":" (not "},{"id":"spn-106510","marks":["code"],"text":"disabled"},{"id":"spn-106511","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-75125","kind":"heading","level":2,"spans":[{"id":"spn-106512","text":"Common Lifecycle Patterns"}]},{"id":"blk-75126","kind":"heading","level":3,"spans":[{"id":"spn-106513","text":"Install-and-Observe"}]},{"id":"blk-75127","kind":"paragraph","spans":[{"id":"spn-106514","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-106515","marks":["code"],"text":"observe"},{"id":"spn-106516","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-106517","marks":["code"],"text":"advise"},{"id":"spn-106518","text":" and "},{"id":"spn-106519","marks":["code"],"text":"act"},{"id":"spn-106520","text":"."}]},{"id":"blk-75128","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-75129","kind":"heading","level":3,"spans":[{"id":"spn-106521","text":"Temporary Agent"}]},{"id":"blk-75130","kind":"paragraph","spans":[{"id":"spn-106522","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-75131","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-75132","kind":"heading","level":3,"spans":[{"id":"spn-106523","text":"Rolling Restart"}]},{"id":"blk-75133","kind":"paragraph","spans":[{"id":"spn-106524","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-75134","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-75135","kind":"heading","level":2,"spans":[{"id":"spn-106525","text":"Querying State"}]},{"id":"blk-75136","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-75137","kind":"paragraph","spans":[{"id":"spn-106526","text":"Returns:"}]},{"id":"blk-75138","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[]