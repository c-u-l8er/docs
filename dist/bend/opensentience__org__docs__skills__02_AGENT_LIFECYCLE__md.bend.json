{"bendscript":"0.1","blocks":[{"id":"blk-98325","kind":"heading","level":1,"spans":[{"id":"spn-162696","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-98327","kind":"paragraph","spans":[{"id":"spn-162697","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-98326","kind":"quote"},{"id":"blk-98328","kind":"heading","level":2,"spans":[{"id":"spn-162698","text":"Why This Matters"}]},{"id":"blk-98329","kind":"paragraph","spans":[{"id":"spn-162699","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-98330","kind":"heading","level":2,"spans":[{"id":"spn-162700","text":"The State Machine"}]},{"id":"blk-98331","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-98332","kind":"heading","level":3,"spans":[{"id":"spn-162701","text":"States"}]},{"head":[{"id":"blk-98334","spans":[{"id":"spn-162702","text":"State"}]},{"id":"blk-98335","spans":[{"id":"spn-162703","text":"Meaning"}]},{"id":"blk-98336","spans":[{"id":"spn-162704","text":"Process Running?"}]}],"id":"blk-98333","kind":"table","rows":[[{"id":"blk-98337","spans":[{"id":"spn-162705","marks":["code"],"text":"installed"}]},{"id":"blk-98338","spans":[{"id":"spn-162706","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-98339","spans":[{"id":"spn-162707","text":"No"}]}],[{"id":"blk-98340","spans":[{"id":"spn-162708","marks":["code"],"text":"enabled"}]},{"id":"blk-98341","spans":[{"id":"spn-162709","text":"Supervised process started"}]},{"id":"blk-98342","spans":[{"id":"spn-162710","text":"Yes (idle or working)"}]}],[{"id":"blk-98343","spans":[{"id":"spn-162711","marks":["code"],"text":"running"}]},{"id":"blk-98344","spans":[{"id":"spn-162712","text":"Actively executing a task"}]},{"id":"blk-98345","spans":[{"id":"spn-162713","text":"Yes"}]}],[{"id":"blk-98346","spans":[{"id":"spn-162714","marks":["code"],"text":"disabled"}]},{"id":"blk-98347","spans":[{"id":"spn-162715","text":"Process stopped, can be re-enabled"}]},{"id":"blk-98348","spans":[{"id":"spn-162716","text":"No"}]}],[{"id":"blk-98349","spans":[{"id":"spn-162717","marks":["code"],"text":"removed"}]},{"id":"blk-98350","spans":[{"id":"spn-162718","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-98351","spans":[{"id":"spn-162719","text":"No"}]}]]},{"id":"blk-98352","kind":"heading","level":3,"spans":[{"id":"spn-162720","text":"Valid Transitions"}]},{"head":[{"id":"blk-98354","spans":[{"id":"spn-162721","text":"From"}]},{"id":"blk-98355","spans":[{"id":"spn-162722","text":"To"}]},{"id":"blk-98356","spans":[{"id":"spn-162723","text":"Trigger"}]},{"id":"blk-98357","spans":[{"id":"spn-162724","text":"Tool"}]}],"id":"blk-98353","kind":"table","rows":[[{"id":"blk-98358","spans":[{"id":"spn-162725","marks":["code"],"text":"installed"}]},{"id":"blk-98359","spans":[{"id":"spn-162726","marks":["code"],"text":"enabled"}]},{"id":"blk-98360","spans":[{"id":"spn-162727","text":"Operator activates agent"}]},{"id":"blk-98361","spans":[{"id":"spn-162728","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-98362","spans":[{"id":"spn-162729","marks":["code"],"text":"enabled"}]},{"id":"blk-98363","spans":[{"id":"spn-162730","marks":["code"],"text":"running"}]},{"id":"blk-98364","spans":[{"id":"spn-162731","text":"Agent begins work"}]},{"id":"blk-98365","spans":[{"id":"spn-162732","text":"Automatic"}]}],[{"id":"blk-98366","spans":[{"id":"spn-162733","marks":["code"],"text":"running"}]},{"id":"blk-98367","spans":[{"id":"spn-162734","marks":["code"],"text":"enabled"}]},{"id":"blk-98368","spans":[{"id":"spn-162735","text":"Agent completes work"}]},{"id":"blk-98369","spans":[{"id":"spn-162736","text":"Automatic"}]}],[{"id":"blk-98370","spans":[{"id":"spn-162737","marks":["code"],"text":"enabled"}]},{"id":"blk-98371","spans":[{"id":"spn-162738","marks":["code"],"text":"disabled"}]},{"id":"blk-98372","spans":[{"id":"spn-162739","text":"Operator stops agent"}]},{"id":"blk-98373","spans":[{"id":"spn-162740","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-98374","spans":[{"id":"spn-162741","marks":["code"],"text":"running"}]},{"id":"blk-98375","spans":[{"id":"spn-162742","marks":["code"],"text":"disabled"}]},{"id":"blk-98376","spans":[{"id":"spn-162743","text":"Operator force-stops agent"}]},{"id":"blk-98377","spans":[{"id":"spn-162744","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-98378","spans":[{"id":"spn-162745","marks":["code"],"text":"disabled"}]},{"id":"blk-98379","spans":[{"id":"spn-162746","marks":["code"],"text":"enabled"}]},{"id":"blk-98380","spans":[{"id":"spn-162747","text":"Operator re-activates"}]},{"id":"blk-98381","spans":[{"id":"spn-162748","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-98382","spans":[{"id":"spn-162749","marks":["code"],"text":"disabled"}]},{"id":"blk-98383","spans":[{"id":"spn-162750","marks":["code"],"text":"removed"}]},{"id":"blk-98384","spans":[{"id":"spn-162751","text":"Operator deregisters"}]},{"id":"blk-98385","spans":[{"id":"spn-162752","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-98386","kind":"paragraph","spans":[{"id":"spn-162753","text":"Invalid transitions (e.g., "},{"id":"spn-162754","marks":["code"],"text":"installed"},{"id":"spn-162755","text":" directly to "},{"id":"spn-162756","marks":["code"],"text":"running"},{"id":"spn-162757","text":", or "},{"id":"spn-162758","marks":["code"],"text":"removed"},{"id":"spn-162759","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-98387","kind":"heading","level":2,"spans":[{"id":"spn-162760","text":"agent_install — Registering an Agent"}]},{"id":"blk-98388","kind":"heading","level":3,"spans":[{"id":"spn-162761","text":"Manifest Schema"}]},{"id":"blk-98389","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-98390","kind":"heading","level":3,"spans":[{"id":"spn-162762","text":"What Happens on Install"}]},{"id":"blk-98391","items":[{"blocks":[{"id":"blk-98393","kind":"paragraph","spans":[{"id":"spn-162763","text":"PermissionEngine writes grants and denials to ETS"}]}],"id":"blk-98392","kind":"list-item"},{"blocks":[{"id":"blk-98395","kind":"paragraph","spans":[{"id":"spn-162764","text":"AgentSupervisor starts a new AgentLifecycle GenStateMachine"}]}],"id":"blk-98394","kind":"list-item"},{"blocks":[{"id":"blk-98397","kind":"paragraph","spans":[{"id":"spn-162765","text":"Initial state is set to "},{"id":"spn-162766","marks":["code"],"text":":installed"}]}],"id":"blk-98396","kind":"list-item"},{"blocks":[{"id":"blk-98399","kind":"paragraph","spans":[{"id":"spn-162767","text":"AuditWriter logs the install event with full manifest"}]}],"id":"blk-98398","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-98400","kind":"heading","level":3,"spans":[{"id":"spn-162768","text":"Denied Permissions"}]},{"id":"blk-98401","kind":"paragraph","spans":[{"id":"spn-162769","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-162770","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-162771","text":" but deny "},{"id":"spn-162772","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-162773","text":", the denial wins for any path matching "},{"id":"spn-162774","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-162775","text":"."}]},{"id":"blk-98402","kind":"heading","level":2,"spans":[{"id":"spn-162776","text":"agent_enable — Starting the Agent"}]},{"id":"blk-98403","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-98404","items":[{"blocks":[{"id":"blk-98406","kind":"paragraph","spans":[{"id":"spn-162777","text":"GenStateMachine validates the transition (must be in "},{"id":"spn-162778","marks":["code"],"text":"installed"},{"id":"spn-162779","text":" or "},{"id":"spn-162780","marks":["code"],"text":"disabled"},{"id":"spn-162781","text":")"}]}],"id":"blk-98405","kind":"list-item"},{"blocks":[{"id":"blk-98408","kind":"paragraph","spans":[{"id":"spn-162782","text":"The wrapped "},{"id":"spn-162783","marks":["code"],"text":"child_spec"},{"id":"spn-162784","text":" is started under AgentSupervisor"}]}],"id":"blk-98407","kind":"list-item"},{"blocks":[{"id":"blk-98410","kind":"paragraph","spans":[{"id":"spn-162785","text":"State transitions to "},{"id":"spn-162786","marks":["code"],"text":"enabled"}]}],"id":"blk-98409","kind":"list-item"},{"blocks":[{"id":"blk-98412","kind":"paragraph","spans":[{"id":"spn-162787","text":"Audit entry is written"}]}],"id":"blk-98411","kind":"list-item"},{"blocks":[{"id":"blk-98414","kind":"paragraph","spans":[{"id":"spn-162788","text":"AutonomyController sets default level ("},{"id":"spn-162789","marks":["code"],"text":"observe"},{"id":"spn-162790","text":") if not already set"}]}],"id":"blk-98413","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-98415","kind":"heading","level":2,"spans":[{"id":"spn-162791","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-98416","kind":"heading","level":3,"spans":[{"id":"spn-162792","text":"Graceful Stop"}]},{"id":"blk-98417","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-98418","items":[{"blocks":[{"id":"blk-98420","kind":"paragraph","spans":[{"id":"spn-162793","text":"Sends a shutdown signal to the wrapped process"}]}],"id":"blk-98419","kind":"list-item"},{"blocks":[{"id":"blk-98422","kind":"paragraph","spans":[{"id":"spn-162794","text":"Waits for configurable timeout (default 5 seconds)"}]}],"id":"blk-98421","kind":"list-item"},{"blocks":[{"id":"blk-98424","kind":"paragraph","spans":[{"id":"spn-162795","text":"If process exits cleanly, state transitions to "},{"id":"spn-162796","marks":["code"],"text":"disabled"}]}],"id":"blk-98423","kind":"list-item"},{"blocks":[{"id":"blk-98426","kind":"paragraph","spans":[{"id":"spn-162797","text":"Audit entry records graceful shutdown"}]}],"id":"blk-98425","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-98427","kind":"heading","level":3,"spans":[{"id":"spn-162798","text":"Emergency Stop"}]},{"id":"blk-98428","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-98429","items":[{"blocks":[{"id":"blk-98431","kind":"paragraph","spans":[{"id":"spn-162799","text":"Immediately kills the wrapped process ("},{"id":"spn-162800","marks":["code"],"text":":kill"},{"id":"spn-162801","text":" signal)"}]}],"id":"blk-98430","kind":"list-item"},{"blocks":[{"id":"blk-98433","kind":"paragraph","spans":[{"id":"spn-162802","text":"State transitions to "},{"id":"spn-162803","marks":["code"],"text":"disabled"}]}],"id":"blk-98432","kind":"list-item"},{"blocks":[{"id":"blk-98435","kind":"paragraph","spans":[{"id":"spn-162804","text":"Audit entry records forced shutdown with reason"}]}],"id":"blk-98434","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-98436","kind":"heading","level":2,"spans":[{"id":"spn-162805","text":"GenStateMachine Internals"}]},{"id":"blk-98437","kind":"paragraph","spans":[{"id":"spn-162806","text":"Each AgentLifecycle is a "},{"id":"spn-162807","marks":["code"],"text":"gen_statem"},{"id":"spn-162808","text":" process with the following structure:"}]},{"id":"blk-98438","items":[{"blocks":[{"id":"blk-98440","kind":"paragraph","spans":[{"id":"spn-162809","marks":["bold"],"text":"State data:"},{"id":"spn-162810","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-98439","kind":"list-item"},{"blocks":[{"id":"blk-98442","kind":"paragraph","spans":[{"id":"spn-162811","marks":["bold"],"text":"Callbacks:"},{"id":"spn-162812","text":" "},{"id":"spn-162813","marks":["code"],"text":"handle_event/4"},{"id":"spn-162814","text":" for each valid transition"}]}],"id":"blk-98441","kind":"list-item"},{"blocks":[{"id":"blk-98444","kind":"paragraph","spans":[{"id":"spn-162815","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-162816","text":" return "},{"id":"spn-162817","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-162818","text":" with an error"}]}],"id":"blk-98443","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-98445","kind":"paragraph","spans":[{"id":"spn-162819","text":"logged to the audit trail"}]},{"id":"blk-98446","items":[{"blocks":[{"id":"blk-98448","kind":"paragraph","spans":[{"id":"spn-162820","marks":["bold"],"text":"Crash handling:"},{"id":"spn-162821","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-98447","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-98449","kind":"paragraph","spans":[{"id":"spn-162822","text":"transitions back to "},{"id":"spn-162823","marks":["code"],"text":"enabled"},{"id":"spn-162824","text":" (not "},{"id":"spn-162825","marks":["code"],"text":"disabled"},{"id":"spn-162826","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-98450","kind":"heading","level":2,"spans":[{"id":"spn-162827","text":"Common Lifecycle Patterns"}]},{"id":"blk-98451","kind":"heading","level":3,"spans":[{"id":"spn-162828","text":"Install-and-Observe"}]},{"id":"blk-98452","kind":"paragraph","spans":[{"id":"spn-162829","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-162830","marks":["code"],"text":"observe"},{"id":"spn-162831","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-162832","marks":["code"],"text":"advise"},{"id":"spn-162833","text":" and "},{"id":"spn-162834","marks":["code"],"text":"act"},{"id":"spn-162835","text":"."}]},{"id":"blk-98453","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-98454","kind":"heading","level":3,"spans":[{"id":"spn-162836","text":"Temporary Agent"}]},{"id":"blk-98455","kind":"paragraph","spans":[{"id":"spn-162837","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-98456","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-98457","kind":"heading","level":3,"spans":[{"id":"spn-162838","text":"Rolling Restart"}]},{"id":"blk-98458","kind":"paragraph","spans":[{"id":"spn-162839","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-98459","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-98460","kind":"heading","level":2,"spans":[{"id":"spn-162840","text":"Querying State"}]},{"id":"blk-98461","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-98462","kind":"paragraph","spans":[{"id":"spn-162841","text":"Returns:"}]},{"id":"blk-98463","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[],"id":"bagaaieraplcfylbpzhjimhlch2yt6tjsqyjugjrnyhqxckywucivcbbdkl2a","vocabulary":"ampersand.docs.fs.v1"}