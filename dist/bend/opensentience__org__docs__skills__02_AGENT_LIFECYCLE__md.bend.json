{"bendscript":"0.1","blocks":[{"id":"blk-49520","kind":"heading","level":1,"spans":[{"id":"spn-57023","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-49522","kind":"paragraph","spans":[{"id":"spn-57024","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-49521","kind":"quote"},{"id":"blk-49523","kind":"paragraph","spans":[{"id":"spn-57025","text":"---"}]},{"id":"blk-49524","kind":"heading","level":2,"spans":[{"id":"spn-57026","text":"Why This Matters"}]},{"id":"blk-49525","kind":"paragraph","spans":[{"id":"spn-57027","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-49526","kind":"paragraph","spans":[{"id":"spn-57028","text":"---"}]},{"id":"blk-49527","kind":"heading","level":2,"spans":[{"id":"spn-57029","text":"The State Machine"}]},{"id":"blk-49528","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-49529","kind":"heading","level":3,"spans":[{"id":"spn-57030","text":"States"}]},{"head":[{"id":"blk-49531","spans":[{"id":"spn-57031","text":"State"}]},{"id":"blk-49532","spans":[{"id":"spn-57032","text":"Meaning"}]},{"id":"blk-49533","spans":[{"id":"spn-57033","text":"Process Running?"}]}],"id":"blk-49530","kind":"table","rows":[[{"id":"blk-49534","spans":[{"id":"spn-57034","marks":["code"],"text":"installed"}]},{"id":"blk-49535","spans":[{"id":"spn-57035","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-49536","spans":[{"id":"spn-57036","text":"No"}]}],[{"id":"blk-49537","spans":[{"id":"spn-57037","marks":["code"],"text":"enabled"}]},{"id":"blk-49538","spans":[{"id":"spn-57038","text":"Supervised process started"}]},{"id":"blk-49539","spans":[{"id":"spn-57039","text":"Yes (idle or working)"}]}],[{"id":"blk-49540","spans":[{"id":"spn-57040","marks":["code"],"text":"running"}]},{"id":"blk-49541","spans":[{"id":"spn-57041","text":"Actively executing a task"}]},{"id":"blk-49542","spans":[{"id":"spn-57042","text":"Yes"}]}],[{"id":"blk-49543","spans":[{"id":"spn-57043","marks":["code"],"text":"disabled"}]},{"id":"blk-49544","spans":[{"id":"spn-57044","text":"Process stopped, can be re-enabled"}]},{"id":"blk-49545","spans":[{"id":"spn-57045","text":"No"}]}],[{"id":"blk-49546","spans":[{"id":"spn-57046","marks":["code"],"text":"removed"}]},{"id":"blk-49547","spans":[{"id":"spn-57047","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-49548","spans":[{"id":"spn-57048","text":"No"}]}]]},{"id":"blk-49549","kind":"heading","level":3,"spans":[{"id":"spn-57049","text":"Valid Transitions"}]},{"head":[{"id":"blk-49551","spans":[{"id":"spn-57050","text":"From"}]},{"id":"blk-49552","spans":[{"id":"spn-57051","text":"To"}]},{"id":"blk-49553","spans":[{"id":"spn-57052","text":"Trigger"}]},{"id":"blk-49554","spans":[{"id":"spn-57053","text":"Tool"}]}],"id":"blk-49550","kind":"table","rows":[[{"id":"blk-49555","spans":[{"id":"spn-57054","marks":["code"],"text":"installed"}]},{"id":"blk-49556","spans":[{"id":"spn-57055","marks":["code"],"text":"enabled"}]},{"id":"blk-49557","spans":[{"id":"spn-57056","text":"Operator activates agent"}]},{"id":"blk-49558","spans":[{"id":"spn-57057","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-49559","spans":[{"id":"spn-57058","marks":["code"],"text":"enabled"}]},{"id":"blk-49560","spans":[{"id":"spn-57059","marks":["code"],"text":"running"}]},{"id":"blk-49561","spans":[{"id":"spn-57060","text":"Agent begins work"}]},{"id":"blk-49562","spans":[{"id":"spn-57061","text":"Automatic"}]}],[{"id":"blk-49563","spans":[{"id":"spn-57062","marks":["code"],"text":"running"}]},{"id":"blk-49564","spans":[{"id":"spn-57063","marks":["code"],"text":"enabled"}]},{"id":"blk-49565","spans":[{"id":"spn-57064","text":"Agent completes work"}]},{"id":"blk-49566","spans":[{"id":"spn-57065","text":"Automatic"}]}],[{"id":"blk-49567","spans":[{"id":"spn-57066","marks":["code"],"text":"enabled"}]},{"id":"blk-49568","spans":[{"id":"spn-57067","marks":["code"],"text":"disabled"}]},{"id":"blk-49569","spans":[{"id":"spn-57068","text":"Operator stops agent"}]},{"id":"blk-49570","spans":[{"id":"spn-57069","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-49571","spans":[{"id":"spn-57070","marks":["code"],"text":"running"}]},{"id":"blk-49572","spans":[{"id":"spn-57071","marks":["code"],"text":"disabled"}]},{"id":"blk-49573","spans":[{"id":"spn-57072","text":"Operator force-stops agent"}]},{"id":"blk-49574","spans":[{"id":"spn-57073","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-49575","spans":[{"id":"spn-57074","marks":["code"],"text":"disabled"}]},{"id":"blk-49576","spans":[{"id":"spn-57075","marks":["code"],"text":"enabled"}]},{"id":"blk-49577","spans":[{"id":"spn-57076","text":"Operator re-activates"}]},{"id":"blk-49578","spans":[{"id":"spn-57077","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-49579","spans":[{"id":"spn-57078","marks":["code"],"text":"disabled"}]},{"id":"blk-49580","spans":[{"id":"spn-57079","marks":["code"],"text":"removed"}]},{"id":"blk-49581","spans":[{"id":"spn-57080","text":"Operator deregisters"}]},{"id":"blk-49582","spans":[{"id":"spn-57081","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-49583","kind":"paragraph","spans":[{"id":"spn-57082","text":"Invalid transitions (e.g., "},{"id":"spn-57083","marks":["code"],"text":"installed"},{"id":"spn-57084","text":" directly to "},{"id":"spn-57085","marks":["code"],"text":"running"},{"id":"spn-57086","text":", or "},{"id":"spn-57087","marks":["code"],"text":"removed"},{"id":"spn-57088","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-49584","kind":"paragraph","spans":[{"id":"spn-57089","text":"---"}]},{"id":"blk-49585","kind":"heading","level":2,"spans":[{"id":"spn-57090","text":"agent_install — Registering an Agent"}]},{"id":"blk-49586","kind":"heading","level":3,"spans":[{"id":"spn-57091","text":"Manifest Schema"}]},{"id":"blk-49587","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-49588","kind":"heading","level":3,"spans":[{"id":"spn-57092","text":"What Happens on Install"}]},{"id":"blk-49589","kind":"paragraph","spans":[{"id":"spn-57093","text":"1. PermissionEngine writes grants and denials to ETS 2. AgentSupervisor starts a new AgentLifecycle GenStateMachine 3. Initial state is set to "},{"id":"spn-57094","marks":["code"],"text":":installed"},{"id":"spn-57095","text":" 4. AuditWriter logs the install event with full manifest"}]},{"id":"blk-49590","kind":"heading","level":3,"spans":[{"id":"spn-57096","text":"Denied Permissions"}]},{"id":"blk-49591","kind":"paragraph","spans":[{"id":"spn-57097","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-57098","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-57099","text":" but deny "},{"id":"spn-57100","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-57101","text":", the denial wins for any path matching "},{"id":"spn-57102","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-57103","text":"."}]},{"id":"blk-49592","kind":"paragraph","spans":[{"id":"spn-57104","text":"---"}]},{"id":"blk-49593","kind":"heading","level":2,"spans":[{"id":"spn-57105","text":"agent_enable — Starting the Agent"}]},{"id":"blk-49594","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-49595","kind":"paragraph","spans":[{"id":"spn-57106","text":"1. GenStateMachine validates the transition (must be in "},{"id":"spn-57107","marks":["code"],"text":"installed"},{"id":"spn-57108","text":" or "},{"id":"spn-57109","marks":["code"],"text":"disabled"},{"id":"spn-57110","text":") 2. The wrapped "},{"id":"spn-57111","marks":["code"],"text":"child_spec"},{"id":"spn-57112","text":" is started under AgentSupervisor 3. State transitions to "},{"id":"spn-57113","marks":["code"],"text":"enabled"},{"id":"spn-57114","text":" 4. Audit entry is written 5. AutonomyController sets default level ("},{"id":"spn-57115","marks":["code"],"text":"observe"},{"id":"spn-57116","text":") if not already set"}]},{"id":"blk-49596","kind":"paragraph","spans":[{"id":"spn-57117","text":"---"}]},{"id":"blk-49597","kind":"heading","level":2,"spans":[{"id":"spn-57118","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-49598","kind":"heading","level":3,"spans":[{"id":"spn-57119","text":"Graceful Stop"}]},{"id":"blk-49599","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-49600","kind":"paragraph","spans":[{"id":"spn-57120","text":"1. Sends a shutdown signal to the wrapped process 2. Waits for configurable timeout (default 5 seconds) 3. If process exits cleanly, state transitions to "},{"id":"spn-57121","marks":["code"],"text":"disabled"},{"id":"spn-57122","text":" 4. Audit entry records graceful shutdown"}]},{"id":"blk-49601","kind":"heading","level":3,"spans":[{"id":"spn-57123","text":"Emergency Stop"}]},{"id":"blk-49602","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-49603","kind":"paragraph","spans":[{"id":"spn-57124","text":"1. Immediately kills the wrapped process ("},{"id":"spn-57125","marks":["code"],"text":":kill"},{"id":"spn-57126","text":" signal) 2. State transitions to "},{"id":"spn-57127","marks":["code"],"text":"disabled"},{"id":"spn-57128","text":" 3. Audit entry records forced shutdown with reason"}]},{"id":"blk-49604","kind":"paragraph","spans":[{"id":"spn-57129","text":"---"}]},{"id":"blk-49605","kind":"heading","level":2,"spans":[{"id":"spn-57130","text":"GenStateMachine Internals"}]},{"id":"blk-49606","kind":"paragraph","spans":[{"id":"spn-57131","text":"Each AgentLifecycle is a "},{"id":"spn-57132","marks":["code"],"text":"gen_statem"},{"id":"spn-57133","text":" process with the following structure:"}]},{"id":"blk-49607","items":[{"blocks":[{"id":"blk-49609","kind":"paragraph","spans":[{"id":"spn-57134","marks":["bold"],"text":"State data:"},{"id":"spn-57135","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-49608","kind":"list-item"},{"blocks":[{"id":"blk-49611","kind":"paragraph","spans":[{"id":"spn-57136","marks":["bold"],"text":"Callbacks:"},{"id":"spn-57137","text":" "},{"id":"spn-57138","marks":["code"],"text":"handle_event/4"},{"id":"spn-57139","text":" for each valid transition"}]}],"id":"blk-49610","kind":"list-item"},{"blocks":[{"id":"blk-49613","kind":"paragraph","spans":[{"id":"spn-57140","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-57141","text":" return "},{"id":"spn-57142","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-57143","text":" with an error"}]}],"id":"blk-49612","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49614","kind":"paragraph","spans":[{"id":"spn-57144","text":"logged to the audit trail"}]},{"id":"blk-49615","items":[{"blocks":[{"id":"blk-49617","kind":"paragraph","spans":[{"id":"spn-57145","marks":["bold"],"text":"Crash handling:"},{"id":"spn-57146","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-49616","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49618","kind":"paragraph","spans":[{"id":"spn-57147","text":"transitions back to "},{"id":"spn-57148","marks":["code"],"text":"enabled"},{"id":"spn-57149","text":" (not "},{"id":"spn-57150","marks":["code"],"text":"disabled"},{"id":"spn-57151","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-49619","kind":"paragraph","spans":[{"id":"spn-57152","text":"---"}]},{"id":"blk-49620","kind":"heading","level":2,"spans":[{"id":"spn-57153","text":"Common Lifecycle Patterns"}]},{"id":"blk-49621","kind":"heading","level":3,"spans":[{"id":"spn-57154","text":"Install-and-Observe"}]},{"id":"blk-49622","kind":"paragraph","spans":[{"id":"spn-57155","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-57156","marks":["code"],"text":"observe"},{"id":"spn-57157","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-57158","marks":["code"],"text":"advise"},{"id":"spn-57159","text":" and "},{"id":"spn-57160","marks":["code"],"text":"act"},{"id":"spn-57161","text":"."}]},{"id":"blk-49623","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-49624","kind":"heading","level":3,"spans":[{"id":"spn-57162","text":"Temporary Agent"}]},{"id":"blk-49625","kind":"paragraph","spans":[{"id":"spn-57163","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-49626","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-49627","kind":"heading","level":3,"spans":[{"id":"spn-57164","text":"Rolling Restart"}]},{"id":"blk-49628","kind":"paragraph","spans":[{"id":"spn-57165","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-49629","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-49630","kind":"paragraph","spans":[{"id":"spn-57166","text":"---"}]},{"id":"blk-49631","kind":"heading","level":2,"spans":[{"id":"spn-57167","text":"Querying State"}]},{"id":"blk-49632","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-49633","kind":"paragraph","spans":[{"id":"spn-57168","text":"Returns:"}]},{"id":"blk-49634","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[],"id":"bagaaiera6fvvnip4x3klvinjsvbhoo6rbdb7xbtsaselzskroyw3at57acsq","vocabulary":"ampersand.docs.fs.v1"}