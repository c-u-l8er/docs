{"bendscript":"0.1","blocks":[{"id":"blk-75828","kind":"heading","level":1,"spans":[{"id":"spn-108994","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-75830","kind":"paragraph","spans":[{"id":"spn-108995","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-75829","kind":"quote"},{"id":"blk-75831","kind":"heading","level":2,"spans":[{"id":"spn-108996","text":"Why This Matters"}]},{"id":"blk-75832","kind":"paragraph","spans":[{"id":"spn-108997","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-75833","kind":"heading","level":2,"spans":[{"id":"spn-108998","text":"The State Machine"}]},{"id":"blk-75834","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-75835","kind":"heading","level":3,"spans":[{"id":"spn-108999","text":"States"}]},{"head":[{"id":"blk-75837","spans":[{"id":"spn-109000","text":"State"}]},{"id":"blk-75838","spans":[{"id":"spn-109001","text":"Meaning"}]},{"id":"blk-75839","spans":[{"id":"spn-109002","text":"Process Running?"}]}],"id":"blk-75836","kind":"table","rows":[[{"id":"blk-75840","spans":[{"id":"spn-109003","marks":["code"],"text":"installed"}]},{"id":"blk-75841","spans":[{"id":"spn-109004","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-75842","spans":[{"id":"spn-109005","text":"No"}]}],[{"id":"blk-75843","spans":[{"id":"spn-109006","marks":["code"],"text":"enabled"}]},{"id":"blk-75844","spans":[{"id":"spn-109007","text":"Supervised process started"}]},{"id":"blk-75845","spans":[{"id":"spn-109008","text":"Yes (idle or working)"}]}],[{"id":"blk-75846","spans":[{"id":"spn-109009","marks":["code"],"text":"running"}]},{"id":"blk-75847","spans":[{"id":"spn-109010","text":"Actively executing a task"}]},{"id":"blk-75848","spans":[{"id":"spn-109011","text":"Yes"}]}],[{"id":"blk-75849","spans":[{"id":"spn-109012","marks":["code"],"text":"disabled"}]},{"id":"blk-75850","spans":[{"id":"spn-109013","text":"Process stopped, can be re-enabled"}]},{"id":"blk-75851","spans":[{"id":"spn-109014","text":"No"}]}],[{"id":"blk-75852","spans":[{"id":"spn-109015","marks":["code"],"text":"removed"}]},{"id":"blk-75853","spans":[{"id":"spn-109016","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-75854","spans":[{"id":"spn-109017","text":"No"}]}]]},{"id":"blk-75855","kind":"heading","level":3,"spans":[{"id":"spn-109018","text":"Valid Transitions"}]},{"head":[{"id":"blk-75857","spans":[{"id":"spn-109019","text":"From"}]},{"id":"blk-75858","spans":[{"id":"spn-109020","text":"To"}]},{"id":"blk-75859","spans":[{"id":"spn-109021","text":"Trigger"}]},{"id":"blk-75860","spans":[{"id":"spn-109022","text":"Tool"}]}],"id":"blk-75856","kind":"table","rows":[[{"id":"blk-75861","spans":[{"id":"spn-109023","marks":["code"],"text":"installed"}]},{"id":"blk-75862","spans":[{"id":"spn-109024","marks":["code"],"text":"enabled"}]},{"id":"blk-75863","spans":[{"id":"spn-109025","text":"Operator activates agent"}]},{"id":"blk-75864","spans":[{"id":"spn-109026","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-75865","spans":[{"id":"spn-109027","marks":["code"],"text":"enabled"}]},{"id":"blk-75866","spans":[{"id":"spn-109028","marks":["code"],"text":"running"}]},{"id":"blk-75867","spans":[{"id":"spn-109029","text":"Agent begins work"}]},{"id":"blk-75868","spans":[{"id":"spn-109030","text":"Automatic"}]}],[{"id":"blk-75869","spans":[{"id":"spn-109031","marks":["code"],"text":"running"}]},{"id":"blk-75870","spans":[{"id":"spn-109032","marks":["code"],"text":"enabled"}]},{"id":"blk-75871","spans":[{"id":"spn-109033","text":"Agent completes work"}]},{"id":"blk-75872","spans":[{"id":"spn-109034","text":"Automatic"}]}],[{"id":"blk-75873","spans":[{"id":"spn-109035","marks":["code"],"text":"enabled"}]},{"id":"blk-75874","spans":[{"id":"spn-109036","marks":["code"],"text":"disabled"}]},{"id":"blk-75875","spans":[{"id":"spn-109037","text":"Operator stops agent"}]},{"id":"blk-75876","spans":[{"id":"spn-109038","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-75877","spans":[{"id":"spn-109039","marks":["code"],"text":"running"}]},{"id":"blk-75878","spans":[{"id":"spn-109040","marks":["code"],"text":"disabled"}]},{"id":"blk-75879","spans":[{"id":"spn-109041","text":"Operator force-stops agent"}]},{"id":"blk-75880","spans":[{"id":"spn-109042","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-75881","spans":[{"id":"spn-109043","marks":["code"],"text":"disabled"}]},{"id":"blk-75882","spans":[{"id":"spn-109044","marks":["code"],"text":"enabled"}]},{"id":"blk-75883","spans":[{"id":"spn-109045","text":"Operator re-activates"}]},{"id":"blk-75884","spans":[{"id":"spn-109046","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-75885","spans":[{"id":"spn-109047","marks":["code"],"text":"disabled"}]},{"id":"blk-75886","spans":[{"id":"spn-109048","marks":["code"],"text":"removed"}]},{"id":"blk-75887","spans":[{"id":"spn-109049","text":"Operator deregisters"}]},{"id":"blk-75888","spans":[{"id":"spn-109050","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-75889","kind":"paragraph","spans":[{"id":"spn-109051","text":"Invalid transitions (e.g., "},{"id":"spn-109052","marks":["code"],"text":"installed"},{"id":"spn-109053","text":" directly to "},{"id":"spn-109054","marks":["code"],"text":"running"},{"id":"spn-109055","text":", or "},{"id":"spn-109056","marks":["code"],"text":"removed"},{"id":"spn-109057","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-75890","kind":"heading","level":2,"spans":[{"id":"spn-109058","text":"agent_install — Registering an Agent"}]},{"id":"blk-75891","kind":"heading","level":3,"spans":[{"id":"spn-109059","text":"Manifest Schema"}]},{"id":"blk-75892","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-75893","kind":"heading","level":3,"spans":[{"id":"spn-109060","text":"What Happens on Install"}]},{"id":"blk-75894","items":[{"blocks":[{"id":"blk-75896","kind":"paragraph","spans":[{"id":"spn-109061","text":"PermissionEngine writes grants and denials to ETS"}]}],"id":"blk-75895","kind":"list-item"},{"blocks":[{"id":"blk-75898","kind":"paragraph","spans":[{"id":"spn-109062","text":"AgentSupervisor starts a new AgentLifecycle GenStateMachine"}]}],"id":"blk-75897","kind":"list-item"},{"blocks":[{"id":"blk-75900","kind":"paragraph","spans":[{"id":"spn-109063","text":"Initial state is set to "},{"id":"spn-109064","marks":["code"],"text":":installed"}]}],"id":"blk-75899","kind":"list-item"},{"blocks":[{"id":"blk-75902","kind":"paragraph","spans":[{"id":"spn-109065","text":"AuditWriter logs the install event with full manifest"}]}],"id":"blk-75901","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75903","kind":"heading","level":3,"spans":[{"id":"spn-109066","text":"Denied Permissions"}]},{"id":"blk-75904","kind":"paragraph","spans":[{"id":"spn-109067","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-109068","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-109069","text":" but deny "},{"id":"spn-109070","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-109071","text":", the denial wins for any path matching "},{"id":"spn-109072","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-109073","text":"."}]},{"id":"blk-75905","kind":"heading","level":2,"spans":[{"id":"spn-109074","text":"agent_enable — Starting the Agent"}]},{"id":"blk-75906","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-75907","items":[{"blocks":[{"id":"blk-75909","kind":"paragraph","spans":[{"id":"spn-109075","text":"GenStateMachine validates the transition (must be in "},{"id":"spn-109076","marks":["code"],"text":"installed"},{"id":"spn-109077","text":" or "},{"id":"spn-109078","marks":["code"],"text":"disabled"},{"id":"spn-109079","text":")"}]}],"id":"blk-75908","kind":"list-item"},{"blocks":[{"id":"blk-75911","kind":"paragraph","spans":[{"id":"spn-109080","text":"The wrapped "},{"id":"spn-109081","marks":["code"],"text":"child_spec"},{"id":"spn-109082","text":" is started under AgentSupervisor"}]}],"id":"blk-75910","kind":"list-item"},{"blocks":[{"id":"blk-75913","kind":"paragraph","spans":[{"id":"spn-109083","text":"State transitions to "},{"id":"spn-109084","marks":["code"],"text":"enabled"}]}],"id":"blk-75912","kind":"list-item"},{"blocks":[{"id":"blk-75915","kind":"paragraph","spans":[{"id":"spn-109085","text":"Audit entry is written"}]}],"id":"blk-75914","kind":"list-item"},{"blocks":[{"id":"blk-75917","kind":"paragraph","spans":[{"id":"spn-109086","text":"AutonomyController sets default level ("},{"id":"spn-109087","marks":["code"],"text":"observe"},{"id":"spn-109088","text":") if not already set"}]}],"id":"blk-75916","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75918","kind":"heading","level":2,"spans":[{"id":"spn-109089","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-75919","kind":"heading","level":3,"spans":[{"id":"spn-109090","text":"Graceful Stop"}]},{"id":"blk-75920","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-75921","items":[{"blocks":[{"id":"blk-75923","kind":"paragraph","spans":[{"id":"spn-109091","text":"Sends a shutdown signal to the wrapped process"}]}],"id":"blk-75922","kind":"list-item"},{"blocks":[{"id":"blk-75925","kind":"paragraph","spans":[{"id":"spn-109092","text":"Waits for configurable timeout (default 5 seconds)"}]}],"id":"blk-75924","kind":"list-item"},{"blocks":[{"id":"blk-75927","kind":"paragraph","spans":[{"id":"spn-109093","text":"If process exits cleanly, state transitions to "},{"id":"spn-109094","marks":["code"],"text":"disabled"}]}],"id":"blk-75926","kind":"list-item"},{"blocks":[{"id":"blk-75929","kind":"paragraph","spans":[{"id":"spn-109095","text":"Audit entry records graceful shutdown"}]}],"id":"blk-75928","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75930","kind":"heading","level":3,"spans":[{"id":"spn-109096","text":"Emergency Stop"}]},{"id":"blk-75931","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-75932","items":[{"blocks":[{"id":"blk-75934","kind":"paragraph","spans":[{"id":"spn-109097","text":"Immediately kills the wrapped process ("},{"id":"spn-109098","marks":["code"],"text":":kill"},{"id":"spn-109099","text":" signal)"}]}],"id":"blk-75933","kind":"list-item"},{"blocks":[{"id":"blk-75936","kind":"paragraph","spans":[{"id":"spn-109100","text":"State transitions to "},{"id":"spn-109101","marks":["code"],"text":"disabled"}]}],"id":"blk-75935","kind":"list-item"},{"blocks":[{"id":"blk-75938","kind":"paragraph","spans":[{"id":"spn-109102","text":"Audit entry records forced shutdown with reason"}]}],"id":"blk-75937","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75939","kind":"heading","level":2,"spans":[{"id":"spn-109103","text":"GenStateMachine Internals"}]},{"id":"blk-75940","kind":"paragraph","spans":[{"id":"spn-109104","text":"Each AgentLifecycle is a "},{"id":"spn-109105","marks":["code"],"text":"gen_statem"},{"id":"spn-109106","text":" process with the following structure:"}]},{"id":"blk-75941","items":[{"blocks":[{"id":"blk-75943","kind":"paragraph","spans":[{"id":"spn-109107","marks":["bold"],"text":"State data:"},{"id":"spn-109108","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-75942","kind":"list-item"},{"blocks":[{"id":"blk-75945","kind":"paragraph","spans":[{"id":"spn-109109","marks":["bold"],"text":"Callbacks:"},{"id":"spn-109110","text":" "},{"id":"spn-109111","marks":["code"],"text":"handle_event/4"},{"id":"spn-109112","text":" for each valid transition"}]}],"id":"blk-75944","kind":"list-item"},{"blocks":[{"id":"blk-75947","kind":"paragraph","spans":[{"id":"spn-109113","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-109114","text":" return "},{"id":"spn-109115","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-109116","text":" with an error"}]}],"id":"blk-75946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75948","kind":"paragraph","spans":[{"id":"spn-109117","text":"logged to the audit trail"}]},{"id":"blk-75949","items":[{"blocks":[{"id":"blk-75951","kind":"paragraph","spans":[{"id":"spn-109118","marks":["bold"],"text":"Crash handling:"},{"id":"spn-109119","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-75950","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75952","kind":"paragraph","spans":[{"id":"spn-109120","text":"transitions back to "},{"id":"spn-109121","marks":["code"],"text":"enabled"},{"id":"spn-109122","text":" (not "},{"id":"spn-109123","marks":["code"],"text":"disabled"},{"id":"spn-109124","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-75953","kind":"heading","level":2,"spans":[{"id":"spn-109125","text":"Common Lifecycle Patterns"}]},{"id":"blk-75954","kind":"heading","level":3,"spans":[{"id":"spn-109126","text":"Install-and-Observe"}]},{"id":"blk-75955","kind":"paragraph","spans":[{"id":"spn-109127","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-109128","marks":["code"],"text":"observe"},{"id":"spn-109129","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-109130","marks":["code"],"text":"advise"},{"id":"spn-109131","text":" and "},{"id":"spn-109132","marks":["code"],"text":"act"},{"id":"spn-109133","text":"."}]},{"id":"blk-75956","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-75957","kind":"heading","level":3,"spans":[{"id":"spn-109134","text":"Temporary Agent"}]},{"id":"blk-75958","kind":"paragraph","spans":[{"id":"spn-109135","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-75959","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-75960","kind":"heading","level":3,"spans":[{"id":"spn-109136","text":"Rolling Restart"}]},{"id":"blk-75961","kind":"paragraph","spans":[{"id":"spn-109137","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-75962","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-75963","kind":"heading","level":2,"spans":[{"id":"spn-109138","text":"Querying State"}]},{"id":"blk-75964","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-75965","kind":"paragraph","spans":[{"id":"spn-109139","text":"Returns:"}]},{"id":"blk-75966","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[]