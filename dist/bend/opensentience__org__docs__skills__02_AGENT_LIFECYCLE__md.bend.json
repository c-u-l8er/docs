{"bendscript":"0.1","blocks":[{"id":"blk-48924","kind":"heading","level":1,"spans":[{"id":"spn-55220","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-48926","kind":"paragraph","spans":[{"id":"spn-55221","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-48925","kind":"quote"},{"id":"blk-48927","kind":"paragraph","spans":[{"id":"spn-55222","text":"---"}]},{"id":"blk-48928","kind":"heading","level":2,"spans":[{"id":"spn-55223","text":"Why This Matters"}]},{"id":"blk-48929","kind":"paragraph","spans":[{"id":"spn-55224","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-48930","kind":"paragraph","spans":[{"id":"spn-55225","text":"---"}]},{"id":"blk-48931","kind":"heading","level":2,"spans":[{"id":"spn-55226","text":"The State Machine"}]},{"id":"blk-48932","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-48933","kind":"heading","level":3,"spans":[{"id":"spn-55227","text":"States"}]},{"head":[{"id":"blk-48935","spans":[{"id":"spn-55228","text":"State"}]},{"id":"blk-48936","spans":[{"id":"spn-55229","text":"Meaning"}]},{"id":"blk-48937","spans":[{"id":"spn-55230","text":"Process Running?"}]}],"id":"blk-48934","kind":"table","rows":[[{"id":"blk-48938","spans":[{"id":"spn-55231","marks":["code"],"text":"installed"}]},{"id":"blk-48939","spans":[{"id":"spn-55232","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-48940","spans":[{"id":"spn-55233","text":"No"}]}],[{"id":"blk-48941","spans":[{"id":"spn-55234","marks":["code"],"text":"enabled"}]},{"id":"blk-48942","spans":[{"id":"spn-55235","text":"Supervised process started"}]},{"id":"blk-48943","spans":[{"id":"spn-55236","text":"Yes (idle or working)"}]}],[{"id":"blk-48944","spans":[{"id":"spn-55237","marks":["code"],"text":"running"}]},{"id":"blk-48945","spans":[{"id":"spn-55238","text":"Actively executing a task"}]},{"id":"blk-48946","spans":[{"id":"spn-55239","text":"Yes"}]}],[{"id":"blk-48947","spans":[{"id":"spn-55240","marks":["code"],"text":"disabled"}]},{"id":"blk-48948","spans":[{"id":"spn-55241","text":"Process stopped, can be re-enabled"}]},{"id":"blk-48949","spans":[{"id":"spn-55242","text":"No"}]}],[{"id":"blk-48950","spans":[{"id":"spn-55243","marks":["code"],"text":"removed"}]},{"id":"blk-48951","spans":[{"id":"spn-55244","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-48952","spans":[{"id":"spn-55245","text":"No"}]}]]},{"id":"blk-48953","kind":"heading","level":3,"spans":[{"id":"spn-55246","text":"Valid Transitions"}]},{"head":[{"id":"blk-48955","spans":[{"id":"spn-55247","text":"From"}]},{"id":"blk-48956","spans":[{"id":"spn-55248","text":"To"}]},{"id":"blk-48957","spans":[{"id":"spn-55249","text":"Trigger"}]},{"id":"blk-48958","spans":[{"id":"spn-55250","text":"Tool"}]}],"id":"blk-48954","kind":"table","rows":[[{"id":"blk-48959","spans":[{"id":"spn-55251","marks":["code"],"text":"installed"}]},{"id":"blk-48960","spans":[{"id":"spn-55252","marks":["code"],"text":"enabled"}]},{"id":"blk-48961","spans":[{"id":"spn-55253","text":"Operator activates agent"}]},{"id":"blk-48962","spans":[{"id":"spn-55254","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-48963","spans":[{"id":"spn-55255","marks":["code"],"text":"enabled"}]},{"id":"blk-48964","spans":[{"id":"spn-55256","marks":["code"],"text":"running"}]},{"id":"blk-48965","spans":[{"id":"spn-55257","text":"Agent begins work"}]},{"id":"blk-48966","spans":[{"id":"spn-55258","text":"Automatic"}]}],[{"id":"blk-48967","spans":[{"id":"spn-55259","marks":["code"],"text":"running"}]},{"id":"blk-48968","spans":[{"id":"spn-55260","marks":["code"],"text":"enabled"}]},{"id":"blk-48969","spans":[{"id":"spn-55261","text":"Agent completes work"}]},{"id":"blk-48970","spans":[{"id":"spn-55262","text":"Automatic"}]}],[{"id":"blk-48971","spans":[{"id":"spn-55263","marks":["code"],"text":"enabled"}]},{"id":"blk-48972","spans":[{"id":"spn-55264","marks":["code"],"text":"disabled"}]},{"id":"blk-48973","spans":[{"id":"spn-55265","text":"Operator stops agent"}]},{"id":"blk-48974","spans":[{"id":"spn-55266","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-48975","spans":[{"id":"spn-55267","marks":["code"],"text":"running"}]},{"id":"blk-48976","spans":[{"id":"spn-55268","marks":["code"],"text":"disabled"}]},{"id":"blk-48977","spans":[{"id":"spn-55269","text":"Operator force-stops agent"}]},{"id":"blk-48978","spans":[{"id":"spn-55270","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-48979","spans":[{"id":"spn-55271","marks":["code"],"text":"disabled"}]},{"id":"blk-48980","spans":[{"id":"spn-55272","marks":["code"],"text":"enabled"}]},{"id":"blk-48981","spans":[{"id":"spn-55273","text":"Operator re-activates"}]},{"id":"blk-48982","spans":[{"id":"spn-55274","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-48983","spans":[{"id":"spn-55275","marks":["code"],"text":"disabled"}]},{"id":"blk-48984","spans":[{"id":"spn-55276","marks":["code"],"text":"removed"}]},{"id":"blk-48985","spans":[{"id":"spn-55277","text":"Operator deregisters"}]},{"id":"blk-48986","spans":[{"id":"spn-55278","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-48987","kind":"paragraph","spans":[{"id":"spn-55279","text":"Invalid transitions (e.g., "},{"id":"spn-55280","marks":["code"],"text":"installed"},{"id":"spn-55281","text":" directly to "},{"id":"spn-55282","marks":["code"],"text":"running"},{"id":"spn-55283","text":", or "},{"id":"spn-55284","marks":["code"],"text":"removed"},{"id":"spn-55285","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-48988","kind":"paragraph","spans":[{"id":"spn-55286","text":"---"}]},{"id":"blk-48989","kind":"heading","level":2,"spans":[{"id":"spn-55287","text":"agent_install — Registering an Agent"}]},{"id":"blk-48990","kind":"heading","level":3,"spans":[{"id":"spn-55288","text":"Manifest Schema"}]},{"id":"blk-48991","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-48992","kind":"heading","level":3,"spans":[{"id":"spn-55289","text":"What Happens on Install"}]},{"id":"blk-48993","kind":"paragraph","spans":[{"id":"spn-55290","text":"1. PermissionEngine writes grants and denials to ETS 2. AgentSupervisor starts a new AgentLifecycle GenStateMachine 3. Initial state is set to "},{"id":"spn-55291","marks":["code"],"text":":installed"},{"id":"spn-55292","text":" 4. AuditWriter logs the install event with full manifest"}]},{"id":"blk-48994","kind":"heading","level":3,"spans":[{"id":"spn-55293","text":"Denied Permissions"}]},{"id":"blk-48995","kind":"paragraph","spans":[{"id":"spn-55294","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-55295","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-55296","text":" but deny "},{"id":"spn-55297","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-55298","text":", the denial wins for any path matching "},{"id":"spn-55299","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-55300","text":"."}]},{"id":"blk-48996","kind":"paragraph","spans":[{"id":"spn-55301","text":"---"}]},{"id":"blk-48997","kind":"heading","level":2,"spans":[{"id":"spn-55302","text":"agent_enable — Starting the Agent"}]},{"id":"blk-48998","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-48999","kind":"paragraph","spans":[{"id":"spn-55303","text":"1. GenStateMachine validates the transition (must be in "},{"id":"spn-55304","marks":["code"],"text":"installed"},{"id":"spn-55305","text":" or "},{"id":"spn-55306","marks":["code"],"text":"disabled"},{"id":"spn-55307","text":") 2. The wrapped "},{"id":"spn-55308","marks":["code"],"text":"child_spec"},{"id":"spn-55309","text":" is started under AgentSupervisor 3. State transitions to "},{"id":"spn-55310","marks":["code"],"text":"enabled"},{"id":"spn-55311","text":" 4. Audit entry is written 5. AutonomyController sets default level ("},{"id":"spn-55312","marks":["code"],"text":"observe"},{"id":"spn-55313","text":") if not already set"}]},{"id":"blk-49000","kind":"paragraph","spans":[{"id":"spn-55314","text":"---"}]},{"id":"blk-49001","kind":"heading","level":2,"spans":[{"id":"spn-55315","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-49002","kind":"heading","level":3,"spans":[{"id":"spn-55316","text":"Graceful Stop"}]},{"id":"blk-49003","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-49004","kind":"paragraph","spans":[{"id":"spn-55317","text":"1. Sends a shutdown signal to the wrapped process 2. Waits for configurable timeout (default 5 seconds) 3. If process exits cleanly, state transitions to "},{"id":"spn-55318","marks":["code"],"text":"disabled"},{"id":"spn-55319","text":" 4. Audit entry records graceful shutdown"}]},{"id":"blk-49005","kind":"heading","level":3,"spans":[{"id":"spn-55320","text":"Emergency Stop"}]},{"id":"blk-49006","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-49007","kind":"paragraph","spans":[{"id":"spn-55321","text":"1. Immediately kills the wrapped process ("},{"id":"spn-55322","marks":["code"],"text":":kill"},{"id":"spn-55323","text":" signal) 2. State transitions to "},{"id":"spn-55324","marks":["code"],"text":"disabled"},{"id":"spn-55325","text":" 3. Audit entry records forced shutdown with reason"}]},{"id":"blk-49008","kind":"paragraph","spans":[{"id":"spn-55326","text":"---"}]},{"id":"blk-49009","kind":"heading","level":2,"spans":[{"id":"spn-55327","text":"GenStateMachine Internals"}]},{"id":"blk-49010","kind":"paragraph","spans":[{"id":"spn-55328","text":"Each AgentLifecycle is a "},{"id":"spn-55329","marks":["code"],"text":"gen_statem"},{"id":"spn-55330","text":" process with the following structure:"}]},{"id":"blk-49011","items":[{"blocks":[{"id":"blk-49013","kind":"paragraph","spans":[{"id":"spn-55331","marks":["bold"],"text":"State data:"},{"id":"spn-55332","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-49012","kind":"list-item"},{"blocks":[{"id":"blk-49015","kind":"paragraph","spans":[{"id":"spn-55333","marks":["bold"],"text":"Callbacks:"},{"id":"spn-55334","text":" "},{"id":"spn-55335","marks":["code"],"text":"handle_event/4"},{"id":"spn-55336","text":" for each valid transition"}]}],"id":"blk-49014","kind":"list-item"},{"blocks":[{"id":"blk-49017","kind":"paragraph","spans":[{"id":"spn-55337","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-55338","text":" return "},{"id":"spn-55339","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-55340","text":" with an error"}]}],"id":"blk-49016","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49018","kind":"paragraph","spans":[{"id":"spn-55341","text":"logged to the audit trail"}]},{"id":"blk-49019","items":[{"blocks":[{"id":"blk-49021","kind":"paragraph","spans":[{"id":"spn-55342","marks":["bold"],"text":"Crash handling:"},{"id":"spn-55343","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-49020","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49022","kind":"paragraph","spans":[{"id":"spn-55344","text":"transitions back to "},{"id":"spn-55345","marks":["code"],"text":"enabled"},{"id":"spn-55346","text":" (not "},{"id":"spn-55347","marks":["code"],"text":"disabled"},{"id":"spn-55348","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-49023","kind":"paragraph","spans":[{"id":"spn-55349","text":"---"}]},{"id":"blk-49024","kind":"heading","level":2,"spans":[{"id":"spn-55350","text":"Common Lifecycle Patterns"}]},{"id":"blk-49025","kind":"heading","level":3,"spans":[{"id":"spn-55351","text":"Install-and-Observe"}]},{"id":"blk-49026","kind":"paragraph","spans":[{"id":"spn-55352","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-55353","marks":["code"],"text":"observe"},{"id":"spn-55354","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-55355","marks":["code"],"text":"advise"},{"id":"spn-55356","text":" and "},{"id":"spn-55357","marks":["code"],"text":"act"},{"id":"spn-55358","text":"."}]},{"id":"blk-49027","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-49028","kind":"heading","level":3,"spans":[{"id":"spn-55359","text":"Temporary Agent"}]},{"id":"blk-49029","kind":"paragraph","spans":[{"id":"spn-55360","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-49030","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-49031","kind":"heading","level":3,"spans":[{"id":"spn-55361","text":"Rolling Restart"}]},{"id":"blk-49032","kind":"paragraph","spans":[{"id":"spn-55362","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-49033","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-49034","kind":"paragraph","spans":[{"id":"spn-55363","text":"---"}]},{"id":"blk-49035","kind":"heading","level":2,"spans":[{"id":"spn-55364","text":"Querying State"}]},{"id":"blk-49036","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-49037","kind":"paragraph","spans":[{"id":"spn-55365","text":"Returns:"}]},{"id":"blk-49038","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[],"id":"bagaaieracvvzts2kzwzr5pinvxrn5wth6qeg4bpg57n74yprmova7vwattiq","vocabulary":"ampersand.docs.fs.v1"}