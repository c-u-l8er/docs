{"bendscript":"0.1","blocks":[{"id":"blk-75000","kind":"heading","level":1,"spans":[{"id":"spn-106381","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-75002","kind":"paragraph","spans":[{"id":"spn-106382","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-75001","kind":"quote"},{"id":"blk-75003","kind":"heading","level":2,"spans":[{"id":"spn-106383","text":"Why This Matters"}]},{"id":"blk-75004","kind":"paragraph","spans":[{"id":"spn-106384","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-75005","kind":"heading","level":2,"spans":[{"id":"spn-106385","text":"The State Machine"}]},{"id":"blk-75006","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-75007","kind":"heading","level":3,"spans":[{"id":"spn-106386","text":"States"}]},{"head":[{"id":"blk-75009","spans":[{"id":"spn-106387","text":"State"}]},{"id":"blk-75010","spans":[{"id":"spn-106388","text":"Meaning"}]},{"id":"blk-75011","spans":[{"id":"spn-106389","text":"Process Running?"}]}],"id":"blk-75008","kind":"table","rows":[[{"id":"blk-75012","spans":[{"id":"spn-106390","marks":["code"],"text":"installed"}]},{"id":"blk-75013","spans":[{"id":"spn-106391","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-75014","spans":[{"id":"spn-106392","text":"No"}]}],[{"id":"blk-75015","spans":[{"id":"spn-106393","marks":["code"],"text":"enabled"}]},{"id":"blk-75016","spans":[{"id":"spn-106394","text":"Supervised process started"}]},{"id":"blk-75017","spans":[{"id":"s