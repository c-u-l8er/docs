{"bendscript":"0.1","blocks":[{"id":"blk-74874","kind":"heading","level":1,"spans":[{"id":"spn-106233","text":"Skill 02 — Agent Lifecycle"}]},{"blocks":[{"id":"blk-74876","kind":"paragraph","spans":[{"id":"spn-106234","text":"Managing agent lifecycle: the state machine, transitions, and GenStateMachine internals."}]}],"id":"blk-74875","kind":"quote"},{"id":"blk-74877","kind":"heading","level":2,"spans":[{"id":"spn-106235","text":"Why This Matters"}]},{"id":"blk-74878","kind":"paragraph","spans":[{"id":"spn-106236","text":"Every governed agent has a lifecycle. The state machine ensures agents cannot skip steps — you cannot run an agent that has not been enabled, and you cannot remove an agent that is still running. This prevents orphaned processes, ungoverned execution, and permission leaks."}]},{"id":"blk-74879","kind":"heading","level":2,"spans":[{"id":"spn-106237","text":"The State Machine"}]},{"id":"blk-74880","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-74881","kind":"heading","level":3,"spans":[{"id":"spn-106238","text":"States"}]},{"head":[{"id":"blk-74883","spans":[{"id":"spn-106239","text":"State"}]},{"id":"blk-74884","spans":[{"id":"spn-106240","text":"Meaning"}]},{"id":"blk-74885","spans":[{"id":"spn-106241","text":"Process Running?"}]}],"id":"blk-74882","kind":"table","rows":[[{"id":"blk-74886","spans":[{"id":"spn-106242","marks":["code"],"text":"installed"}]},{"id":"blk-74887","spans":[{"id":"spn-106243","text":"Registered with permissions, awaiting activation"}]},{"id":"blk-74888","spans":[{"id":"spn-106244","text":"No"}]}],[{"id":"blk-74889","spans":[{"id":"spn-106245","marks":["code"],"text":"enabled"}]},{"id":"blk-74890","spans":[{"id":"spn-106246","text":"Supervised process started"}]},{"id":"blk-74891","spans":[{"id":"spn-106247","text":"Yes (idle or working)"}]}],[{"id":"blk-74892","spans":[{"id":"spn-106248","marks":["code"],"text":"running"}]},{"id":"blk-74893","spans":[{"id":"spn-106249","text":"Actively executing a task"}]},{"id":"blk-74894","spans":[{"id":"spn-106250","text":"Yes"}]}],[{"id":"blk-74895","spans":[{"id":"spn-106251","marks":["code"],"text":"disabled"}]},{"id":"blk-74896","spans":[{"id":"spn-106252","text":"Process stopped, can be re-enabled"}]},{"id":"blk-74897","spans":[{"id":"spn-106253","text":"No"}]}],[{"id":"blk-74898","spans":[{"id":"spn-106254","marks":["code"],"text":"removed"}]},{"id":"blk-74899","spans":[{"id":"spn-106255","text":"Fully deregistered, permissions cleared"}]},{"id":"blk-74900","spans":[{"id":"spn-106256","text":"No"}]}]]},{"id":"blk-74901","kind":"heading","level":3,"spans":[{"id":"spn-106257","text":"Valid Transitions"}]},{"head":[{"id":"blk-74903","spans":[{"id":"spn-106258","text":"From"}]},{"id":"blk-74904","spans":[{"id":"spn-106259","text":"To"}]},{"id":"blk-74905","spans":[{"id":"spn-106260","text":"Trigger"}]},{"id":"blk-74906","spans":[{"id":"spn-106261","text":"Tool"}]}],"id":"blk-74902","kind":"table","rows":[[{"id":"blk-74907","spans":[{"id":"spn-106262","marks":["code"],"text":"installed"}]},{"id":"blk-74908","spans":[{"id":"spn-106263","marks":["code"],"text":"enabled"}]},{"id":"blk-74909","spans":[{"id":"spn-106264","text":"Operator activates agent"}]},{"id":"blk-74910","spans":[{"id":"spn-106265","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-74911","spans":[{"id":"spn-106266","marks":["code"],"text":"enabled"}]},{"id":"blk-74912","spans":[{"id":"spn-106267","marks":["code"],"text":"running"}]},{"id":"blk-74913","spans":[{"id":"spn-106268","text":"Agent begins work"}]},{"id":"blk-74914","spans":[{"id":"spn-106269","text":"Automatic"}]}],[{"id":"blk-74915","spans":[{"id":"spn-106270","marks":["code"],"text":"running"}]},{"id":"blk-74916","spans":[{"id":"spn-106271","marks":["code"],"text":"enabled"}]},{"id":"blk-74917","spans":[{"id":"spn-106272","text":"Agent completes work"}]},{"id":"blk-74918","spans":[{"id":"spn-106273","text":"Automatic"}]}],[{"id":"blk-74919","spans":[{"id":"spn-106274","marks":["code"],"text":"enabled"}]},{"id":"blk-74920","spans":[{"id":"spn-106275","marks":["code"],"text":"disabled"}]},{"id":"blk-74921","spans":[{"id":"spn-106276","text":"Operator stops agent"}]},{"id":"blk-74922","spans":[{"id":"spn-106277","marks":["code"],"text":"agent_disable"}]}],[{"id":"blk-74923","spans":[{"id":"spn-106278","marks":["code"],"text":"running"}]},{"id":"blk-74924","spans":[{"id":"spn-106279","marks":["code"],"text":"disabled"}]},{"id":"blk-74925","spans":[{"id":"spn-106280","text":"Operator force-stops agent"}]},{"id":"blk-74926","spans":[{"id":"spn-106281","marks":["code"],"text":"agent_disable(force: true)"}]}],[{"id":"blk-74927","spans":[{"id":"spn-106282","marks":["code"],"text":"disabled"}]},{"id":"blk-74928","spans":[{"id":"spn-106283","marks":["code"],"text":"enabled"}]},{"id":"blk-74929","spans":[{"id":"spn-106284","text":"Operator re-activates"}]},{"id":"blk-74930","spans":[{"id":"spn-106285","marks":["code"],"text":"agent_enable"}]}],[{"id":"blk-74931","spans":[{"id":"spn-106286","marks":["code"],"text":"disabled"}]},{"id":"blk-74932","spans":[{"id":"spn-106287","marks":["code"],"text":"removed"}]},{"id":"blk-74933","spans":[{"id":"spn-106288","text":"Operator deregisters"}]},{"id":"blk-74934","spans":[{"id":"spn-106289","marks":["code"],"text":"agent_remove"}]}]]},{"id":"blk-74935","kind":"paragraph","spans":[{"id":"spn-106290","text":"Invalid transitions (e.g., "},{"id":"spn-106291","marks":["code"],"text":"installed"},{"id":"spn-106292","text":" directly to "},{"id":"spn-106293","marks":["code"],"text":"running"},{"id":"spn-106294","text":", or "},{"id":"spn-106295","marks":["code"],"text":"removed"},{"id":"spn-106296","text":" to any state) are rejected by the GenStateMachine."}]},{"id":"blk-74936","kind":"heading","level":2,"spans":[{"id":"spn-106297","text":"agent_install — Registering an Agent"}]},{"id":"blk-74937","kind":"heading","level":3,"spans":[{"id":"spn-106298","text":"Manifest Schema"}]},{"id":"blk-74938","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"name\": \"My Worker Agent\",\n  \"child_spec\": {\"module\": \"MyApp.Worker\", \"args\": []},\n  \"permissions\": {\n    \"granted\": [\n      {\"type\": \"filesystem\", \"access\": \"read\", \"resource\": \"/data/**\"}\n    ],\n    \"denied\": [\n      {\"type\": \"filesystem\", \"access\": \"write\", \"resource\": \"/etc/**\"}\n    ]\n  },\n  \"metadata\": {\n    \"version\": \"1.0.0\",\n    \"source\": \"agentelic\"\n  }\n}"},{"id":"blk-74939","kind":"heading","level":3,"spans":[{"id":"spn-106299","text":"What Happens on Install"}]},{"id":"blk-74940","items":[{"blocks":[{"id":"blk-74942","kind":"paragraph","spans":[{"id":"spn-106300","text":"PermissionEngine writes grants and denials to ETS"}]}],"id":"blk-74941","kind":"list-item"},{"blocks":[{"id":"blk-74944","kind":"paragraph","spans":[{"id":"spn-106301","text":"AgentSupervisor starts a new AgentLifecycle GenStateMachine"}]}],"id":"blk-74943","kind":"list-item"},{"blocks":[{"id":"blk-74946","kind":"paragraph","spans":[{"id":"spn-106302","text":"Initial state is set to "},{"id":"spn-106303","marks":["code"],"text":":installed"}]}],"id":"blk-74945","kind":"list-item"},{"blocks":[{"id":"blk-74948","kind":"paragraph","spans":[{"id":"spn-106304","text":"AuditWriter logs the install event with full manifest"}]}],"id":"blk-74947","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74949","kind":"heading","level":3,"spans":[{"id":"spn-106305","text":"Denied Permissions"}]},{"id":"blk-74950","kind":"paragraph","spans":[{"id":"spn-106306","text":"Explicit denials take precedence over grants. If you grant "},{"id":"spn-106307","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-106308","text":" but deny "},{"id":"spn-106309","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-106310","text":", the denial wins for any path matching "},{"id":"spn-106311","marks":["code"],"text":"/data/secrets/**"},{"id":"spn-106312","text":"."}]},{"id":"blk-74951","kind":"heading","level":2,"spans":[{"id":"spn-106313","text":"agent_enable — Starting the Agent"}]},{"id":"blk-74952","kind":"code","language":"text","text":"agent_enable(agent_id: \"my-worker\")"},{"id":"blk-74953","items":[{"blocks":[{"id":"blk-74955","kind":"paragraph","spans":[{"id":"spn-106314","text":"GenStateMachine validates the transition (must be in "},{"id":"spn-106315","marks":["code"],"text":"installed"},{"id":"spn-106316","text":" or "},{"id":"spn-106317","marks":["code"],"text":"disabled"},{"id":"spn-106318","text":")"}]}],"id":"blk-74954","kind":"list-item"},{"blocks":[{"id":"blk-74957","kind":"paragraph","spans":[{"id":"spn-106319","text":"The wrapped "},{"id":"spn-106320","marks":["code"],"text":"child_spec"},{"id":"spn-106321","text":" is started under AgentSupervisor"}]}],"id":"blk-74956","kind":"list-item"},{"blocks":[{"id":"blk-74959","kind":"paragraph","spans":[{"id":"spn-106322","text":"State transitions to "},{"id":"spn-106323","marks":["code"],"text":"enabled"}]}],"id":"blk-74958","kind":"list-item"},{"blocks":[{"id":"blk-74961","kind":"paragraph","spans":[{"id":"spn-106324","text":"Audit entry is written"}]}],"id":"blk-74960","kind":"list-item"},{"blocks":[{"id":"blk-74963","kind":"paragraph","spans":[{"id":"spn-106325","text":"AutonomyController sets default level ("},{"id":"spn-106326","marks":["code"],"text":"observe"},{"id":"spn-106327","text":") if not already set"}]}],"id":"blk-74962","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74964","kind":"heading","level":2,"spans":[{"id":"spn-106328","text":"agent_disable — Stopping the Agent"}]},{"id":"blk-74965","kind":"heading","level":3,"spans":[{"id":"spn-106329","text":"Graceful Stop"}]},{"id":"blk-74966","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\")"},{"id":"blk-74967","items":[{"blocks":[{"id":"blk-74969","kind":"paragraph","spans":[{"id":"spn-106330","text":"Sends a shutdown signal to the wrapped process"}]}],"id":"blk-74968","kind":"list-item"},{"blocks":[{"id":"blk-74971","kind":"paragraph","spans":[{"id":"spn-106331","text":"Waits for configurable timeout (default 5 seconds)"}]}],"id":"blk-74970","kind":"list-item"},{"blocks":[{"id":"blk-74973","kind":"paragraph","spans":[{"id":"spn-106332","text":"If process exits cleanly, state transitions to "},{"id":"spn-106333","marks":["code"],"text":"disabled"}]}],"id":"blk-74972","kind":"list-item"},{"blocks":[{"id":"blk-74975","kind":"paragraph","spans":[{"id":"spn-106334","text":"Audit entry records graceful shutdown"}]}],"id":"blk-74974","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74976","kind":"heading","level":3,"spans":[{"id":"spn-106335","text":"Emergency Stop"}]},{"id":"blk-74977","kind":"code","language":"text","text":"agent_disable(agent_id: \"my-worker\", force: true)"},{"id":"blk-74978","items":[{"blocks":[{"id":"blk-74980","kind":"paragraph","spans":[{"id":"spn-106336","text":"Immediately kills the wrapped process ("},{"id":"spn-106337","marks":["code"],"text":":kill"},{"id":"spn-106338","text":" signal)"}]}],"id":"blk-74979","kind":"list-item"},{"blocks":[{"id":"blk-74982","kind":"paragraph","spans":[{"id":"spn-106339","text":"State transitions to "},{"id":"spn-106340","marks":["code"],"text":"disabled"}]}],"id":"blk-74981","kind":"list-item"},{"blocks":[{"id":"blk-74984","kind":"paragraph","spans":[{"id":"spn-106341","text":"Audit entry records forced shutdown with reason"}]}],"id":"blk-74983","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74985","kind":"heading","level":2,"spans":[{"id":"spn-106342","text":"GenStateMachine Internals"}]},{"id":"blk-74986","kind":"paragraph","spans":[{"id":"spn-106343","text":"Each AgentLifecycle is a "},{"id":"spn-106344","marks":["code"],"text":"gen_statem"},{"id":"spn-106345","text":" process with the following structure:"}]},{"id":"blk-74987","items":[{"blocks":[{"id":"blk-74989","kind":"paragraph","spans":[{"id":"spn-106346","marks":["bold"],"text":"State data:"},{"id":"spn-106347","text":" agent_id, child_spec, current PID (when running), metadata"}]}],"id":"blk-74988","kind":"list-item"},{"blocks":[{"id":"blk-74991","kind":"paragraph","spans":[{"id":"spn-106348","marks":["bold"],"text":"Callbacks:"},{"id":"spn-106349","text":" "},{"id":"spn-106350","marks":["code"],"text":"handle_event/4"},{"id":"spn-106351","text":" for each valid transition"}]}],"id":"blk-74990","kind":"list-item"},{"blocks":[{"id":"blk-74993","kind":"paragraph","spans":[{"id":"spn-106352","marks":["bold"],"text":"Invalid transitions:"},{"id":"spn-106353","text":" return "},{"id":"spn-106354","marks":["code"],"text":"{:keep_state_and_data, []}"},{"id":"spn-106355","text":" with an error"}]}],"id":"blk-74992","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74994","kind":"paragraph","spans":[{"id":"spn-106356","text":"logged to the audit trail"}]},{"id":"blk-74995","items":[{"blocks":[{"id":"blk-74997","kind":"paragraph","spans":[{"id":"spn-106357","marks":["bold"],"text":"Crash handling:"},{"id":"spn-106358","text":" if the wrapped process crashes, the AgentLifecycle"}]}],"id":"blk-74996","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74998","kind":"paragraph","spans":[{"id":"spn-106359","text":"transitions back to "},{"id":"spn-106360","marks":["code"],"text":"enabled"},{"id":"spn-106361","text":" (not "},{"id":"spn-106362","marks":["code"],"text":"disabled"},{"id":"spn-106363","text":") and the DynamicSupervisor restart strategy applies"}]},{"id":"blk-74999","kind":"heading","level":2,"spans":[{"id":"spn-106364","text":"Common Lifecycle Patterns"}]},{"id":"blk-75000","kind":"heading","level":3,"spans":[{"id":"spn-106365","text":"Install-and-Observe"}]},{"id":"blk-75001","kind":"paragraph","spans":[{"id":"spn-106366","text":"The most conservative pattern. Install the agent, enable it at "},{"id":"spn-106367","marks":["code"],"text":"observe"},{"id":"spn-106368","text":" level, review its recommendations in the audit trail, then gradually promote to "},{"id":"spn-106369","marks":["code"],"text":"advise"},{"id":"spn-106370","text":" and "},{"id":"spn-106371","marks":["code"],"text":"act"},{"id":"spn-106372","text":"."}]},{"id":"blk-75002","kind":"code","language":"text","text":"agent_install(manifest) --> agent_enable(agent_id) --> review audit --> autonomy_level(advise) --> review --> autonomy_level(act)"},{"id":"blk-75003","kind":"heading","level":3,"spans":[{"id":"spn-106373","text":"Temporary Agent"}]},{"id":"blk-75004","kind":"paragraph","spans":[{"id":"spn-106374","text":"Install, enable, run a specific task, disable, remove. Useful for one-off jobs that should not persist."}]},{"id":"blk-75005","kind":"code","language":"text","text":"agent_install --> agent_enable --> (task completes) --> agent_disable --> agent_remove"},{"id":"blk-75006","kind":"heading","level":3,"spans":[{"id":"spn-106375","text":"Rolling Restart"}]},{"id":"blk-75007","kind":"paragraph","spans":[{"id":"spn-106376","text":"Disable the agent, update its child_spec or permissions, re-enable."}]},{"id":"blk-75008","kind":"code","language":"text","text":"agent_disable --> (update config) --> agent_enable"},{"id":"blk-75009","kind":"heading","level":2,"spans":[{"id":"spn-106377","text":"Querying State"}]},{"id":"blk-75010","kind":"code","language":"text","text":"agent_status(agent_id: \"my-worker\")"},{"id":"blk-75011","kind":"paragraph","spans":[{"id":"spn-106378","text":"Returns:"}]},{"id":"blk-75012","kind":"code","language":"json","text":"{\n  \"agent_id\": \"my-worker\",\n  \"state\": \"enabled\",\n  \"autonomy_level\": \"observe\",\n  \"permissions_granted\": 3,\n  \"permissions_denied\": 1,\n  \"installed_at\": \"2026-01-15T10:30:00Z\",\n  \"last_transition\": \"2026-01-15T10:31:00Z\"\n}"}],"edges":[]