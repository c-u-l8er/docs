{"bendscript":"0.1","blocks":[{"id":"blk-43611","kind":"paragraph","spans":[{"id":"spn-50324","text":"--- name: forgetting description: Use when nodes need to be removed from the knowledge graph — soft-hide from retrieval, hard-delete, cascade-delete orphans, GDPR-erase with audit, or run budget-aware priority pruning. Use when the user says \"forget this\", \"delete node\", \"remove node\", \"GDPR erase\", \"prune low-priority\", \"run forgetting policy\", or \"remove from memory\". For graph-wide cleanup use "},{"id":"spn-50325","marks":["code"],"text":"consolidate"},{"id":"spn-50326","text":"; for aggregate diagnostics use "},{"id":"spn-50327","marks":["code"],"text":"graph-health"},{"id":"spn-50328","text":". Routes through the "},{"id":"spn-50329","marks":["code"],"text":"act"},{"id":"spn-50330","text":" machine. argument-hint: <soft|hard|cascade|gdpr|policy> [node_id] ---"}]},{"id":"blk-43612","kind":"heading","level":1,"spans":[{"id":"spn-50331","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-43613","kind":"paragraph","spans":[{"id":"spn-50332","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-43614","kind":"heading","level":2,"spans":[{"id":"spn-50333","text":"Arguments"}]},{"id":"blk-43615","kind":"paragraph","spans":[{"id":"spn-50334","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-43616","kind":"heading","level":2,"spans":[{"id":"spn-50335","text":"Forgetting Modes"}]},{"id":"blk-43617","kind":"heading","level":3,"spans":[{"id":"spn-50336","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-43618","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-43619","kind":"paragraph","spans":[{"id":"spn-50337","text":"Node gets "},{"id":"spn-50338","marks":["code"],"text":"forgotten_at"},{"id":"spn-50339","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-43620","kind":"heading","level":3,"spans":[{"id":"spn-50340","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-43621","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-43622","kind":"paragraph","spans":[{"id":"spn-50341","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-43623","kind":"heading","level":3,"spans":[{"id":"spn-50342","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-43624","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-43625","kind":"paragraph","spans":[{"id":"spn-50343","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-43626","kind":"heading","level":3,"spans":[{"id":"spn-50344","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-43627","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-43628","kind":"paragraph","spans":[{"id":"spn-50345","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-43629","kind":"heading","level":2,"spans":[{"id":"spn-50346","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-43630","kind":"paragraph","spans":[{"id":"spn-50347","text":"Preview what would be forgotten:"}]},{"id":"blk-43631","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-43632","kind":"paragraph","spans":[{"id":"spn-50348","text":"Execute the policy:"}]},{"id":"blk-43633","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-43634","kind":"paragraph","spans":[{"id":"spn-50349","text":"Priority scoring: "},{"id":"spn-50350","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-50351","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-43635","kind":"heading","level":2,"spans":[{"id":"spn-50352","text":"When to Use Which"}]},{"head":[{"id":"blk-43637","spans":[{"id":"spn-50353","text":"Scenario"}]},{"id":"blk-43638","spans":[{"id":"spn-50354","text":"Mode"}]}],"id":"blk-43636","kind":"table","rows":[[{"id":"blk-43639","spans":[{"id":"spn-50355","text":"Outdated but might be useful later"}]},{"id":"blk-43640","spans":[{"id":"spn-50356","marks":["code"],"text":"forget_node"},{"id":"spn-50357","text":" mode: "},{"id":"spn-50358","marks":["code"],"text":"soft"}]}],[{"id":"blk-43641","spans":[{"id":"spn-50359","text":"Definitely wrong, no dependents"}]},{"id":"blk-43642","spans":[{"id":"spn-50360","marks":["code"],"text":"forget_node"},{"id":"spn-50361","text":" mode: "},{"id":"spn-50362","marks":["code"],"text":"hard"}]}],[{"id":"blk-43643","spans":[{"id":"spn-50363","text":"Wrong + has orphaned dependents"}]},{"id":"blk-43644","spans":[{"id":"spn-50364","marks":["code"],"text":"forget_node"},{"id":"spn-50365","text":" mode: "},{"id":"spn-50366","marks":["code"],"text":"cascade"}]}],[{"id":"blk-43645","spans":[{"id":"spn-50367","text":"Contains PII / user data"}]},{"id":"blk-43646","spans":[{"id":"spn-50368","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-43647","spans":[{"id":"spn-50369","text":"Graph getting too large"}]},{"id":"blk-43648","spans":[{"id":"spn-50370","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-43649","spans":[{"id":"spn-50371","text":"Want to weaken, not remove"}]},{"id":"blk-43650","spans":[{"id":"spn-50372","text":"Use "},{"id":"spn-50373","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-50374","text":" instead"}]}]]},{"id":"blk-43651","kind":"heading","level":2,"spans":[{"id":"spn-50375","text":"Anti-patterns to avoid"}]},{"id":"blk-43652","items":[{"blocks":[{"id":"blk-43654","kind":"paragraph","spans":[{"id":"spn-50376","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-43653","kind":"list-item"},{"blocks":[{"id":"blk-43656","kind":"paragraph","spans":[{"id":"spn-50377","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-43655","kind":"list-item"},{"blocks":[{"id":"blk-43658","kind":"paragraph","spans":[{"id":"spn-50378","text":"Always dry_run policy before executing"}]}],"id":"blk-43657","kind":"list-item"},{"blocks":[{"id":"blk-43660","kind":"paragraph","spans":[{"id":"spn-50379","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-43659","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera5kaqx4tu4xxjaez5we3zcatbdv3arbqbuacyjekjuuk6corfyvza","vocabulary":"ampersand.docs.fs.v1"}