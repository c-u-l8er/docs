{"bendscript":"0.1","blocks":[{"id":"blk-68291","kind":"heading","level":1,"spans":[{"id":"spn-100746","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-68292","kind":"paragraph","spans":[{"id":"spn-100747","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-68293","kind":"heading","level":2,"spans":[{"id":"spn-100748","text":"Arguments"}]},{"id":"blk-68294","kind":"paragraph","spans":[{"id":"spn-100749","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-68295","kind":"heading","level":2,"spans":[{"id":"spn-100750","text":"Forgetting Modes"}]},{"id":"blk-68296","kind":"heading","level":3,"spans":[{"id":"spn-100751","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-68297","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-68298","kind":"paragraph","spans":[{"id":"spn-100752","text":"Node gets "},{"id":"spn-100753","marks":["code"],"text":"forgotten_at"},{"id":"spn-100754","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-68299","kind":"heading","level":3,"spans":[{"id":"spn-100755","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-68300","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-68301","kind":"paragraph","spans":[{"id":"spn-100756","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-68302","kind":"heading","level":3,"spans":[{"id":"spn-100757","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-68303","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-68304","kind":"paragraph","spans":[{"id":"spn-100758","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-68305","kind":"heading","level":3,"spans":[{"id":"spn-100759","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-68306","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-68307","kind":"paragraph","spans":[{"id":"spn-100760","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-68308","kind":"heading","level":2,"spans":[{"id":"spn-100761","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-68309","kind":"paragraph","spans":[{"id":"spn-100762","text":"Preview what would be forgotten:"}]},{"id":"blk-68310","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-68311","kind":"paragraph","spans":[{"id":"spn-100763","text":"Execute the policy:"}]},{"id":"blk-68312","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-68313","kind":"paragraph","spans":[{"id":"spn-100764","text":"Priority scoring: "},{"id":"spn-100765","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-100766","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-68314","kind":"heading","level":2,"spans":[{"id":"spn-100767","text":"When to Use Which"}]},{"head":[{"id":"blk-68316","spans":[{"id":"spn-100768","text":"Scenario"}]},{"id":"blk-68317","spans":[{"id":"spn-100769","text":"Mode"}]}],"id":"blk-68315","kind":"table","rows":[[{"id":"blk-68318","spans":[{"id":"spn-100770","text":"Outdated but might be useful later"}]},{"id":"blk-68319","spans":[{"id":"spn-100771","marks":["code"],"text":"forget_node"},{"id":"spn-100772","text":" mode: "},{"id":"spn-100773","marks":["code"],"text":"soft"}]}],[{"id":"blk-68320","spans":[{"id":"spn-100774","text":"Definitely wrong, no dependents"}]},{"id":"blk-68321","spans":[{"id":"spn-100775","marks":["code"],"text":"forget_node"},{"id":"spn-100776","text":" mode: "},{"id":"spn-100777","marks":["code"],"text":"hard"}]}],[{"id":"blk-68322","spans":[{"id":"spn-100778","text":"Wrong + has orphaned dependents"}]},{"id":"blk-68323","spans":[{"id":"spn-100779","marks":["code"],"text":"forget_node"},{"id":"spn-100780","text":" mode: "},{"id":"spn-100781","marks":["code"],"text":"cascade"}]}],[{"id":"blk-68324","spans":[{"id":"spn-100782","text":"Contains PII / user data"}]},{"id":"blk-68325","spans":[{"id":"spn-100783","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-68326","spans":[{"id":"spn-100784","text":"Graph getting too large"}]},{"id":"blk-68327","spans":[{"id":"spn-100785","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-68328","spans":[{"id":"spn-100786","text":"Want to weaken, not remove"}]},{"id":"blk-68329","spans":[{"id":"spn-100787","text":"Use "},{"id":"spn-100788","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-100789","text":" instead"}]}]]},{"id":"blk-68330","kind":"heading","level":2,"spans":[{"id":"spn-100790","text":"Anti-patterns to avoid"}]},{"id":"blk-68331","items":[{"blocks":[{"id":"blk-68333","kind":"paragraph","spans":[{"id":"spn-100791","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-68332","kind":"list-item"},{"blocks":[{"id":"blk-68335","kind":"paragraph","spans":[{"id":"spn-100792","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-68334","kind":"list-item"},{"blocks":[{"id":"blk-68337","kind":"paragraph","spans":[{"id":"spn-100793","text":"Always dry_run policy before executing"}]}],"id":"blk-68336","kind":"list-item"},{"blocks":[{"id":"blk-68339","kind":"paragraph","spans":[{"id":"spn-100794","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-68338","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieragr4w3w6upp43bpk5xo6dmfktjcs5oen54t5qmcs6qt2trjlt2k6a","vocabulary":"ampersand.docs.fs.v1"}