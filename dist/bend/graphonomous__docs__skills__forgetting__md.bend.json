{"bendscript":"0.1","blocks":[{"id":"blk-74820","kind":"heading","level":1,"spans":[{"id":"spn-137470","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-74821","kind":"paragraph","spans":[{"id":"spn-137471","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-74822","kind":"heading","level":2,"spans":[{"id":"spn-137472","text":"Arguments"}]},{"id":"blk-74823","kind":"paragraph","spans":[{"id":"spn-137473","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-74824","kind":"heading","level":2,"spans":[{"id":"spn-137474","text":"Forgetting Modes"}]},{"id":"blk-74825","kind":"heading","level":3,"spans":[{"id":"spn-137475","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-74826","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-74827","kind":"paragraph","spans":[{"id":"spn-137476","text":"Node gets "},{"id":"spn-137477","marks":["code"],"text":"forgotten_at"},{"id":"spn-137478","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-74828","kind":"heading","level":3,"spans":[{"id":"spn-137479","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-74829","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-74830","kind":"paragraph","spans":[{"id":"spn-137480","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-74831","kind":"heading","level":3,"spans":[{"id":"spn-137481","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-74832","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-74833","kind":"paragraph","spans":[{"id":"spn-137482","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-74834","kind":"heading","level":3,"spans":[{"id":"spn-137483","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-74835","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-74836","kind":"paragraph","spans":[{"id":"spn-137484","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-74837","kind":"heading","level":2,"spans":[{"id":"spn-137485","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-74838","kind":"paragraph","spans":[{"id":"spn-137486","text":"Preview what would be forgotten:"}]},{"id":"blk-74839","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-74840","kind":"paragraph","spans":[{"id":"spn-137487","text":"Execute the policy:"}]},{"id":"blk-74841","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-74842","kind":"paragraph","spans":[{"id":"spn-137488","text":"Priority scoring: "},{"id":"spn-137489","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-137490","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-74843","kind":"heading","level":2,"spans":[{"id":"spn-137491","text":"When to Use Which"}]},{"head":[{"id":"blk-74845","spans":[{"id":"spn-137492","text":"Scenario"}]},{"id":"blk-74846","spans":[{"id":"spn-137493","text":"Mode"}]}],"id":"blk-74844","kind":"table","rows":[[{"id":"blk-74847","spans":[{"id":"spn-137494","text":"Outdated but might be useful later"}]},{"id":"blk-74848","spans":[{"id":"spn-137495","marks":["code"],"text":"forget_node"},{"id":"spn-137496","text":" mode: "},{"id":"spn-137497","marks":["code"],"text":"soft"}]}],[{"id":"blk-74849","spans":[{"id":"spn-137498","text":"Definitely wrong, no dependents"}]},{"id":"blk-74850","spans":[{"id":"spn-137499","marks":["code"],"text":"forget_node"},{"id":"spn-137500","text":" mode: "},{"id":"spn-137501","marks":["code"],"text":"hard"}]}],[{"id":"blk-74851","spans":[{"id":"spn-137502","text":"Wrong + has orphaned dependents"}]},{"id":"blk-74852","spans":[{"id":"spn-137503","marks":["code"],"text":"forget_node"},{"id":"spn-137504","text":" mode: "},{"id":"spn-137505","marks":["code"],"text":"cascade"}]}],[{"id":"blk-74853","spans":[{"id":"spn-137506","text":"Contains PII / user data"}]},{"id":"blk-74854","spans":[{"id":"spn-137507","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-74855","spans":[{"id":"spn-137508","text":"Graph getting too large"}]},{"id":"blk-74856","spans":[{"id":"spn-137509","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-74857","spans":[{"id":"spn-137510","text":"Want to weaken, not remove"}]},{"id":"blk-74858","spans":[{"id":"spn-137511","text":"Use "},{"id":"spn-137512","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-137513","text":" instead"}]}]]},{"id":"blk-74859","kind":"heading","level":2,"spans":[{"id":"spn-137514","text":"Anti-patterns to avoid"}]},{"id":"blk-74860","items":[{"blocks":[{"id":"blk-74862","kind":"paragraph","spans":[{"id":"spn-137515","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-74861","kind":"list-item"},{"blocks":[{"id":"blk-74864","kind":"paragraph","spans":[{"id":"spn-137516","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-74863","kind":"list-item"},{"blocks":[{"id":"blk-74866","kind":"paragraph","spans":[{"id":"spn-137517","text":"Always dry_run policy before executing"}]}],"id":"blk-74865","kind":"list-item"},{"blocks":[{"id":"blk-74868","kind":"paragraph","spans":[{"id":"spn-137518","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-74867","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierarv6ml2jmj7prd4ylfhh6eg3spgfcpy3gbtgzedbo56fo7vd745jq","vocabulary":"ampersand.docs.fs.v1"}