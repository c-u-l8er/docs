{"bendscript":"0.1","blocks":[{"id":"blk-67326","kind":"heading","level":1,"spans":[{"id":"spn-97906","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-67327","kind":"paragraph","spans":[{"id":"spn-97907","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-67328","kind":"heading","level":2,"spans":[{"id":"spn-97908","text":"Arguments"}]},{"id":"blk-67329","kind":"paragraph","spans":[{"id":"spn-97909","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-67330","kind":"heading","level":2,"spans":[{"id":"spn-97910","text":"Forgetting Modes"}]},{"id":"blk-67331","kind":"heading","level":3,"spans":[{"id":"spn-97911","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-67332","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-67333","kind":"paragraph","spans":[{"id":"spn-97912","text":"Node gets "},{"id":"spn-97913","marks":["code"],"text":"forgotten_at"},{"id":"spn-97914","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-67334","kind":"heading","level":3,"spans":[{"id":"spn-97915","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-67335","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-67336","kind":"paragraph","spans":[{"id":"spn-97916","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-67337","kind":"heading","level":3,"spans":[{"id":"spn-97917","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-67338","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-67339","kind":"paragraph","spans":[{"id":"spn-97918","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-67340","kind":"heading","level":3,"spans":[{"id":"spn-97919","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-67341","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-67342","kind":"paragraph","spans":[{"id":"spn-97920","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-67343","kind":"heading","level":2,"spans":[{"id":"spn-97921","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-67344","kind":"paragraph","spans":[{"id":"spn-97922","text":"Preview what would be forgotten:"}]},{"id":"blk-67345","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-67346","kind":"paragraph","spans":[{"id":"spn-97923","text":"Execute the policy:"}]},{"id":"blk-67347","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-67348","kind":"paragraph","spans":[{"id":"spn-97924","text":"Priority scoring: "},{"id":"spn-97925","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-97926","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-67349","kind":"heading","level":2,"spans":[{"id":"spn-97927","text":"When to Use Which"}]},{"head":[{"id":"blk-67351","spans":[{"id":"spn-97928","text":"Scenario"}]},{"id":"blk-67352","spans":[{"id":"spn-97929","text":"Mode"}]}],"id":"blk-67350","kind":"table","rows":[[{"id":"blk-67353","spans":[{"id":"spn-97930","text":"Outdated but might be useful later"}]},{"id":"blk-67354","spans":[{"id":"spn-97931","marks":["code"],"text":"forget_node"},{"id":"spn-97932","text":" mode: "},{"id":"spn-97933","marks":["code"],"text":"soft"}]}],[{"id":"blk-67355","spans":[{"id":"spn-97934","text":"Definitely wrong, no dependents"}]},{"id":"blk-67356","spans":[{"id":"spn-97935","marks":["code"],"text":"forget_node"},{"id":"spn-97936","text":" mode: "},{"id":"spn-97937","marks":["code"],"text":"hard"}]}],[{"id":"blk-67357","spans":[{"id":"spn-97938","text":"Wrong + has orphaned dependents"}]},{"id":"blk-67358","spans":[{"id":"spn-97939","marks":["code"],"text":"forget_node"},{"id":"spn-97940","text":" mode: "},{"id":"spn-97941","marks":["code"],"text":"cascade"}]}],[{"id":"blk-67359","spans":[{"id":"spn-97942","text":"Contains PII / user data"}]},{"id":"blk-67360","spans":[{"id":"spn-97943","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-67361","spans":[{"id":"spn-97944","text":"Graph getting too large"}]},{"id":"blk-67362","spans":[{"id":"spn-97945","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-67363","spans":[{"id":"spn-97946","text":"Want to weaken, not remove"}]},{"id":"blk-67364","spans":[{"id":"spn-97947","text":"Use "},{"id":"spn-97948","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-97949","text":" instead"}]}]]},{"id":"blk-67365","kind":"heading","level":2,"spans":[{"id":"spn-97950","text":"Anti-patterns to avoid"}]},{"id":"blk-67366","items":[{"blocks":[{"id":"blk-67368","kind":"paragraph","spans":[{"id":"spn-97951","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-67367","kind":"list-item"},{"blocks":[{"id":"blk-67370","kind":"paragraph","spans":[{"id":"spn-97952","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-67369","kind":"list-item"},{"blocks":[{"id":"blk-67372","kind":"paragraph","spans":[{"id":"spn-97953","text":"Always dry_run policy before executing"}]}],"id":"blk-67371","kind":"list-item"},{"blocks":[{"id":"blk-67374","kind":"paragraph","spans":[{"id":"spn-97954","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-67373","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierazexaix3f4qqbo3ccdxjf3qudyjul3dw373zdpkh6eivfmaypxngq","vocabulary":"ampersand.docs.fs.v1"}