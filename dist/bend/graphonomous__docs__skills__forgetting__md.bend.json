{"bendscript":"0.1","blocks":[{"id":"blk-67463","kind":"heading","level":1,"spans":[{"id":"spn-98107","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-67464","kind":"paragraph","spans":[{"id":"spn-98108","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-67465","kind":"heading","level":2,"spans":[{"id":"spn-98109","text":"Arguments"}]},{"id":"blk-67466","kind":"paragraph","spans":[{"id":"spn-98110","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-67467","kind":"heading","level":2,"spans":[{"id":"spn-98111","text":"Forgetting Modes"}]},{"id":"blk-67468","kind":"heading","level":3,"spans":[{"id":"spn-98112","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-67469","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-67470","kind":"paragraph","spans":[{"id":"spn-98113","text":"Node gets "},{"id":"spn-98114","marks":["code"],"text":"forgotten_at"},{"id":"spn-98115","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-67471","kind":"heading","level":3,"spans":[{"id":"spn-98116","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-67472","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-67473","kind":"paragraph","spans":[{"id":"spn-98117","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-67474","kind":"heading","level":3,"spans":[{"id":"spn-98118","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-67475","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-67476","kind":"paragraph","spans":[{"id":"spn-98119","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-67477","kind":"heading","level":3,"spans":[{"id":"spn-98120","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-67478","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-67479","kind":"paragraph","spans":[{"id":"spn-98121","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-67480","kind":"heading","level":2,"spans":[{"id":"spn-98122","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-67481","kind":"paragraph","spans":[{"id":"spn-98123","text":"Preview what would be forgotten:"}]},{"id":"blk-67482","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-67483","kind":"paragraph","spans":[{"id":"spn-98124","text":"Execute the policy:"}]},{"id":"blk-67484","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-67485","kind":"paragraph","spans":[{"id":"spn-98125","text":"Priority scoring: "},{"id":"spn-98126","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-98127","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-67486","kind":"heading","level":2,"spans":[{"id":"spn-98128","text":"When to Use Which"}]},{"head":[{"id":"blk-67488","spans":[{"id":"spn-98129","text":"Scenario"}]},{"id":"blk-67489","spans":[{"id":"spn-98130","text":"Mode"}]}],"id":"blk-67487","kind":"table","rows":[[{"id":"blk-67490","spans":[{"id":"spn-98131","text":"Outdated but might be useful later"}]},{"id":"blk-67491","spans":[{"id":"spn-98132","marks":["code"],"text":"forget_node"},{"id":"spn-98133","text":" mode: "},{"id":"spn-98134","marks":["code"],"text":"soft"}]}],[{"id":"blk-67492","spans":[{"id":"spn-98135","text":"Definitely wrong, no dependents"}]},{"id":"blk-67493","spans":[{"id":"spn-98136","marks":["code"],"text":"forget_node"},{"id":"spn-98137","text":" mode: "},{"id":"spn-98138","marks":["code"],"text":"hard"}]}],[{"id":"blk-67494","spans":[{"id":"spn-98139","text":"Wrong + has orphaned dependents"}]},{"id":"blk-67495","spans":[{"id":"spn-98140","marks":["code"],"text":"forget_node"},{"id":"spn-98141","text":" mode: "},{"id":"spn-98142","marks":["code"],"text":"cascade"}]}],[{"id":"blk-67496","spans":[{"id":"spn-98143","text":"Contains PII / user data"}]},{"id":"blk-67497","spans":[{"id":"spn-98144","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-67498","spans":[{"id":"spn-98145","text":"Graph getting too large"}]},{"id":"blk-67499","spans":[{"id":"spn-98146","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-67500","spans":[{"id":"spn-98147","text":"Want to weaken, not remove"}]},{"id":"blk-67501","spans":[{"id":"spn-98148","text":"Use "},{"id":"spn-98149","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-98150","text":" instead"}]}]]},{"id":"blk-67502","kind":"heading","level":2,"spans":[{"id":"spn-98151","text":"Anti-patterns to avoid"}]},{"id":"blk-67503","items":[{"blocks":[{"id":"blk-67505","kind":"paragraph","spans":[{"id":"spn-98152","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-67504","kind":"list-item"},{"blocks":[{"id":"blk-67507","kind":"paragraph","spans":[{"id":"spn-98153","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-67506","kind":"list-item"},{"blocks":[{"id":"blk-67509","kind":"paragraph","spans":[{"id":"spn-98154","text":"Always dry_run policy before executing"}]}],"id":"blk-67508","kind":"list-item"},{"blocks":[{"id":"blk-67511","kind":"paragraph","spans":[{"id":"spn-98155","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-67510","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierasywfg53exhkcc5pgnpmp4bvhfakeqbvox3wipcwq25kv7lpzu6nq","vocabulary":"ampersand.docs.fs.v1"}