{"bendscript":"0.1","blocks":[{"id":"blk-67337","kind":"heading","level":1,"spans":[{"id":"spn-97959","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-67338","kind":"paragraph","spans":[{"id":"spn-97960","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-67339","kind":"heading","level":2,"spans":[{"id":"spn-97961","text":"Arguments"}]},{"id":"blk-67340","kind":"paragraph","spans":[{"id":"spn-97962","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-67341","kind":"heading","level":2,"spans":[{"id":"spn-97963","text":"Forgetting Modes"}]},{"id":"blk-67342","kind":"heading","level":3,"spans":[{"id":"spn-97964","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-67343","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-67344","kind":"paragraph","spans":[{"id":"spn-97965","text":"Node gets "},{"id":"spn-97966","marks":["code"],"text":"forgotten_at"},{"id":"spn-97967","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-67345","kind":"heading","level":3,"spans":[{"id":"spn-97968","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-67346","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-67347","kind":"paragraph","spans":[{"id":"spn-97969","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-67348","kind":"heading","level":3,"spans":[{"id":"spn-97970","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-67349","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-67350","kind":"paragraph","spans":[{"id":"spn-97971","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-67351","kind":"heading","level":3,"spans":[{"id":"spn-97972","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-67352","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-67353","kind":"paragraph","spans":[{"id":"spn-97973","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-67354","kind":"heading","level":2,"spans":[{"id":"spn-97974","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-67355","kind":"paragraph","spans":[{"id":"spn-97975","text":"Preview what would be forgotten:"}]},{"id":"blk-67356","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-67357","kind":"paragraph","spans":[{"id":"spn-97976","text":"Execute the policy:"}]},{"id":"blk-67358","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-67359","kind":"paragraph","spans":[{"id":"spn-97977","text":"Priority scoring: "},{"id":"spn-97978","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-97979","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-67360","kind":"heading","level":2,"spans":[{"id":"spn-97980","text":"When to Use Which"}]},{"head":[{"id":"blk-67362","spans":[{"id":"spn-97981","text":"Scenario"}]},{"id":"blk-67363","spans":[{"id":"spn-97982","text":"Mode"}]}],"id":"blk-67361","kind":"table","rows":[[{"id":"blk-67364","spans":[{"id":"spn-97983","text":"Outdated but might be useful later"}]},{"id":"blk-67365","spans":[{"id":"spn-97984","marks":["code"],"text":"forget_node"},{"id":"spn-97985","text":" mode: "},{"id":"spn-97986","marks":["code"],"text":"soft"}]}],[{"id":"blk-67366","spans":[{"id":"spn-97987","text":"Definitely wrong, no dependents"}]},{"id":"blk-67367","spans":[{"id":"spn-97988","marks":["code"],"text":"forget_node"},{"id":"spn-97989","text":" mode: "},{"id":"spn-97990","marks":["code"],"text":"hard"}]}],[{"id":"blk-67368","spans":[{"id":"spn-97991","text":"Wrong + has orphaned dependents"}]},{"id":"blk-67369","spans":[{"id":"spn-97992","marks":["code"],"text":"forget_node"},{"id":"spn-97993","text":" mode: "},{"id":"spn-97994","marks":["code"],"text":"cascade"}]}],[{"id":"blk-67370","spans":[{"id":"spn-97995","text":"Contains PII / user data"}]},{"id":"blk-67371","spans":[{"id":"spn-97996","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-67372","spans":[{"id":"spn-97997","text":"Graph getting too large"}]},{"id":"blk-67373","spans":[{"id":"spn-97998","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-67374","spans":[{"id":"spn-97999","text":"Want to weaken, not remove"}]},{"id":"blk-67375","spans":[{"id":"spn-98000","text":"Use "},{"id":"spn-98001","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-98002","text":" instead"}]}]]},{"id":"blk-67376","kind":"heading","level":2,"spans":[{"id":"spn-98003","text":"Anti-patterns to avoid"}]},{"id":"blk-67377","items":[{"blocks":[{"id":"blk-67379","kind":"paragraph","spans":[{"id":"spn-98004","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-67378","kind":"list-item"},{"blocks":[{"id":"blk-67381","kind":"paragraph","spans":[{"id":"spn-98005","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-67380","kind":"list-item"},{"blocks":[{"id":"blk-67383","kind":"paragraph","spans":[{"id":"spn-98006","text":"Always dry_run policy before executing"}]}],"id":"blk-67382","kind":"list-item"},{"blocks":[{"id":"blk-67385","kind":"paragraph","spans":[{"id":"spn-98007","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-67384","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierah7qn2ro2ikgjaqzz2lnkdzq3ivdvmrwumiappj4nvtm4rqecycnq","vocabulary":"ampersand.docs.fs.v1"}