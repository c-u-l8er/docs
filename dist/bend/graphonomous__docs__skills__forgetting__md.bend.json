{"bendscript":"0.1","blocks":[{"id":"blk-42639","kind":"paragraph","spans":[{"id":"spn-48030","text":"--- name: forgetting description: Use when nodes need to be removed from the knowledge graph — soft-hide from retrieval, hard-delete, cascade-delete orphans, GDPR-erase with audit, or run budget-aware priority pruning. Use when the user says \"forget this\", \"delete node\", \"remove node\", \"GDPR erase\", \"prune low-priority\", \"run forgetting policy\", or \"remove from memory\". For graph-wide cleanup use "},{"id":"spn-48031","marks":["code"],"text":"consolidate"},{"id":"spn-48032","text":"; for aggregate diagnostics use "},{"id":"spn-48033","marks":["code"],"text":"graph-health"},{"id":"spn-48034","text":". Routes through the "},{"id":"spn-48035","marks":["code"],"text":"act"},{"id":"spn-48036","text":" machine. argument-hint: <soft|hard|cascade|gdpr|policy> [node_id] ---"}]},{"id":"blk-42640","kind":"heading","level":1,"spans":[{"id":"spn-48037","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-42641","kind":"paragraph","spans":[{"id":"spn-48038","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-42642","kind":"heading","level":2,"spans":[{"id":"spn-48039","text":"Arguments"}]},{"id":"blk-42643","kind":"paragraph","spans":[{"id":"spn-48040","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-42644","kind":"heading","level":2,"spans":[{"id":"spn-48041","text":"Forgetting Modes"}]},{"id":"blk-42645","kind":"heading","level":3,"spans":[{"id":"spn-48042","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-42646","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-42647","kind":"paragraph","spans":[{"id":"spn-48043","text":"Node gets "},{"id":"spn-48044","marks":["code"],"text":"forgotten_at"},{"id":"spn-48045","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-42648","kind":"heading","level":3,"spans":[{"id":"spn-48046","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-42649","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-42650","kind":"paragraph","spans":[{"id":"spn-48047","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-42651","kind":"heading","level":3,"spans":[{"id":"spn-48048","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-42652","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-42653","kind":"paragraph","spans":[{"id":"spn-48049","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-42654","kind":"heading","level":3,"spans":[{"id":"spn-48050","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-42655","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-42656","kind":"paragraph","spans":[{"id":"spn-48051","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-42657","kind":"heading","level":2,"spans":[{"id":"spn-48052","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-42658","kind":"paragraph","spans":[{"id":"spn-48053","text":"Preview what would be forgotten:"}]},{"id":"blk-42659","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-42660","kind":"paragraph","spans":[{"id":"spn-48054","text":"Execute the policy:"}]},{"id":"blk-42661","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-42662","kind":"paragraph","spans":[{"id":"spn-48055","text":"Priority scoring: "},{"id":"spn-48056","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-48057","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-42663","kind":"heading","level":2,"spans":[{"id":"spn-48058","text":"When to Use Which"}]},{"head":[{"id":"blk-42665","spans":[{"id":"spn-48059","text":"Scenario"}]},{"id":"blk-42666","spans":[{"id":"spn-48060","text":"Mode"}]}],"id":"blk-42664","kind":"table","rows":[[{"id":"blk-42667","spans":[{"id":"spn-48061","text":"Outdated but might be useful later"}]},{"id":"blk-42668","spans":[{"id":"spn-48062","marks":["code"],"text":"forget_node"},{"id":"spn-48063","text":" mode: "},{"id":"spn-48064","marks":["code"],"text":"soft"}]}],[{"id":"blk-42669","spans":[{"id":"spn-48065","text":"Definitely wrong, no dependents"}]},{"id":"blk-42670","spans":[{"id":"spn-48066","marks":["code"],"text":"forget_node"},{"id":"spn-48067","text":" mode: "},{"id":"spn-48068","marks":["code"],"text":"hard"}]}],[{"id":"blk-42671","spans":[{"id":"spn-48069","text":"Wrong + has orphaned dependents"}]},{"id":"blk-42672","spans":[{"id":"spn-48070","marks":["code"],"text":"forget_node"},{"id":"spn-48071","text":" mode: "},{"id":"spn-48072","marks":["code"],"text":"cascade"}]}],[{"id":"blk-42673","spans":[{"id":"spn-48073","text":"Contains PII / user data"}]},{"id":"blk-42674","spans":[{"id":"spn-48074","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-42675","spans":[{"id":"spn-48075","text":"Graph getting too large"}]},{"id":"blk-42676","spans":[{"id":"spn-48076","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-42677","spans":[{"id":"spn-48077","text":"Want to weaken, not remove"}]},{"id":"blk-42678","spans":[{"id":"spn-48078","text":"Use "},{"id":"spn-48079","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-48080","text":" instead"}]}]]},{"id":"blk-42679","kind":"heading","level":2,"spans":[{"id":"spn-48081","text":"Anti-patterns to avoid"}]},{"id":"blk-42680","items":[{"blocks":[{"id":"blk-42682","kind":"paragraph","spans":[{"id":"spn-48082","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-42681","kind":"list-item"},{"blocks":[{"id":"blk-42684","kind":"paragraph","spans":[{"id":"spn-48083","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-42683","kind":"list-item"},{"blocks":[{"id":"blk-42686","kind":"paragraph","spans":[{"id":"spn-48084","text":"Always dry_run policy before executing"}]}],"id":"blk-42685","kind":"list-item"},{"blocks":[{"id":"blk-42688","kind":"paragraph","spans":[{"id":"spn-48085","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-42687","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera6xy2kisrrq7abolfcnnxx74hutxeng7piptnpctwaseay7wyrssq","vocabulary":"ampersand.docs.fs.v1"}