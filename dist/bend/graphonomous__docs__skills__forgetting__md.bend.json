{"bendscript":"0.1","blocks":[{"id":"blk-43125","kind":"paragraph","spans":[{"id":"spn-49204","text":"--- name: forgetting description: Use when nodes need to be removed from the knowledge graph — soft-hide from retrieval, hard-delete, cascade-delete orphans, GDPR-erase with audit, or run budget-aware priority pruning. Use when the user says \"forget this\", \"delete node\", \"remove node\", \"GDPR erase\", \"prune low-priority\", \"run forgetting policy\", or \"remove from memory\". For graph-wide cleanup use "},{"id":"spn-49205","marks":["code"],"text":"consolidate"},{"id":"spn-49206","text":"; for aggregate diagnostics use "},{"id":"spn-49207","marks":["code"],"text":"graph-health"},{"id":"spn-49208","text":". Routes through the "},{"id":"spn-49209","marks":["code"],"text":"act"},{"id":"spn-49210","text":" machine. argument-hint: <soft|hard|cascade|gdpr|policy> [node_id] ---"}]},{"id":"blk-43126","kind":"heading","level":1,"spans":[{"id":"spn-49211","text":"Intentional Forgetting — Structured Knowledge Removal"}]},{"id":"blk-43127","kind":"paragraph","spans":[{"id":"spn-49212","text":"Four forgetting modes plus budget-aware policy pruning."}]},{"id":"blk-43128","kind":"heading","level":2,"spans":[{"id":"spn-49213","text":"Arguments"}]},{"id":"blk-43129","kind":"paragraph","spans":[{"id":"spn-49214","text":"Mode and target: $ARGUMENTS"}]},{"id":"blk-43130","kind":"heading","level":2,"spans":[{"id":"spn-49215","text":"Forgetting Modes"}]},{"id":"blk-43131","kind":"heading","level":3,"spans":[{"id":"spn-49216","text":"Soft Forget — Hide from Retrieval"}]},{"id":"blk-43132","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"soft\", reason: \"Outdated reference\")"},{"id":"blk-43133","kind":"paragraph","spans":[{"id":"spn-49217","text":"Node gets "},{"id":"spn-49218","marks":["code"],"text":"forgotten_at"},{"id":"spn-49219","text":" timestamp internally, excluded from retrieval, but structure/edges preserved. Reversible."}]},{"id":"blk-43134","kind":"heading","level":3,"spans":[{"id":"spn-49220","text":"Hard Forget — Delete Node + Edges"}]},{"id":"blk-43135","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"hard\")"},{"id":"blk-43136","kind":"paragraph","spans":[{"id":"spn-49221","text":"UtU-style constant-time unlink: severs all edges, deletes node. Irreversible."}]},{"id":"blk-43137","kind":"heading","level":3,"spans":[{"id":"spn-49222","text":"Cascade Forget — Delete + Orphaned Dependents"}]},{"id":"blk-43138","kind":"code","language":"text","text":"act(action: \"forget_node\", node_id: \"<id>\", mode: \"cascade\", reason: \"Removing stale test data\")"},{"id":"blk-43139","kind":"paragraph","spans":[{"id":"spn-49223","text":"Also deletes orphaned dependents — nodes whose ONLY incoming support was from the deleted node."}]},{"id":"blk-43140","kind":"heading","level":3,"spans":[{"id":"spn-49224","text":"GDPR Erase — Permanent Audit-Logged Deletion"}]},{"id":"blk-43141","kind":"code","language":"text","text":"act(action: \"gdpr_erase\", node_id: \"<id>\")"},{"id":"blk-43142","kind":"paragraph","spans":[{"id":"spn-49225","text":"Permanently removes node, all edges, and embedding data. Audit-logged per GDPR Article 17. No recovery possible."}]},{"id":"blk-43143","kind":"heading","level":2,"spans":[{"id":"spn-49226","text":"Budget-Aware Policy Pruning"}]},{"id":"blk-43144","kind":"paragraph","spans":[{"id":"spn-49227","text":"Preview what would be forgotten:"}]},{"id":"blk-43145","kind":"code","language":"text","text":"act(action: \"forget_policy\", dry_run: true, max_nodes: 500)"},{"id":"blk-43146","kind":"paragraph","spans":[{"id":"spn-49228","text":"Execute the policy:"}]},{"id":"blk-43147","kind":"code","language":"text","text":"act(action: \"forget_policy\", max_nodes: 500)"},{"id":"blk-43148","kind":"paragraph","spans":[{"id":"spn-49229","text":"Priority scoring: "},{"id":"spn-49230","marks":["code"],"text":"confidence x recency x (1 + log(access_count + 1)) x (1 + connectivity)"},{"id":"spn-49231","text":". Lowest-priority nodes forgotten first via soft-forget."}]},{"id":"blk-43149","kind":"heading","level":2,"spans":[{"id":"spn-49232","text":"When to Use Which"}]},{"head":[{"id":"blk-43151","spans":[{"id":"spn-49233","text":"Scenario"}]},{"id":"blk-43152","spans":[{"id":"spn-49234","text":"Mode"}]}],"id":"blk-43150","kind":"table","rows":[[{"id":"blk-43153","spans":[{"id":"spn-49235","text":"Outdated but might be useful later"}]},{"id":"blk-43154","spans":[{"id":"spn-49236","marks":["code"],"text":"forget_node"},{"id":"spn-49237","text":" mode: "},{"id":"spn-49238","marks":["code"],"text":"soft"}]}],[{"id":"blk-43155","spans":[{"id":"spn-49239","text":"Definitely wrong, no dependents"}]},{"id":"blk-43156","spans":[{"id":"spn-49240","marks":["code"],"text":"forget_node"},{"id":"spn-49241","text":" mode: "},{"id":"spn-49242","marks":["code"],"text":"hard"}]}],[{"id":"blk-43157","spans":[{"id":"spn-49243","text":"Wrong + has orphaned dependents"}]},{"id":"blk-43158","spans":[{"id":"spn-49244","marks":["code"],"text":"forget_node"},{"id":"spn-49245","text":" mode: "},{"id":"spn-49246","marks":["code"],"text":"cascade"}]}],[{"id":"blk-43159","spans":[{"id":"spn-49247","text":"Contains PII / user data"}]},{"id":"blk-43160","spans":[{"id":"spn-49248","marks":["code"],"text":"gdpr_erase"}]}],[{"id":"blk-43161","spans":[{"id":"spn-49249","text":"Graph getting too large"}]},{"id":"blk-43162","spans":[{"id":"spn-49250","marks":["code"],"text":"forget_policy"}]}],[{"id":"blk-43163","spans":[{"id":"spn-49251","text":"Want to weaken, not remove"}]},{"id":"blk-43164","spans":[{"id":"spn-49252","text":"Use "},{"id":"spn-49253","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"contract\")"},{"id":"spn-49254","text":" instead"}]}]]},{"id":"blk-43165","kind":"heading","level":2,"spans":[{"id":"spn-49255","text":"Anti-patterns to avoid"}]},{"id":"blk-43166","items":[{"blocks":[{"id":"blk-43168","kind":"paragraph","spans":[{"id":"spn-49256","text":"Don't GDPR-erase non-PII nodes — use soft/hard instead"}]}],"id":"blk-43167","kind":"list-item"},{"blocks":[{"id":"blk-43170","kind":"paragraph","spans":[{"id":"spn-49257","text":"Don't forget without checking dependents — use cascade if unsure"}]}],"id":"blk-43169","kind":"list-item"},{"blocks":[{"id":"blk-43172","kind":"paragraph","spans":[{"id":"spn-49258","text":"Always dry_run policy before executing"}]}],"id":"blk-43171","kind":"list-item"},{"blocks":[{"id":"blk-43174","kind":"paragraph","spans":[{"id":"spn-49259","text":"Don't forget nodes that are part of active goals — check goal linkage first"}]}],"id":"blk-43173","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieracunidwbdt3fmxv6rro5ztd2q7zzgozbzfr4kdkrqmckt7d7dx2rq","vocabulary":"ampersand.docs.fs.v1"}