{"bendscript":"0.1","blocks":[{"id":"blk-31498","kind":"heading","level":1,"spans":[{"id":"spn-36113","text":"webhost.systems — [&] Protocol Integration Spec (v1)"}]},{"id":"blk-31499","kind":"paragraph","spans":[{"id":"spn-36114","text":"Version: 1.0 Status: Draft Audience: Engineering Last updated: 2026-03-28"}]},{"blocks":[{"id":"blk-31501","kind":"paragraph","spans":[{"id":"spn-36115","text":"This document extends the v1 spec to make WebHost.Systems the canonical hosting layer for [&] Protocol agents."}]}],"id":"blk-31500","kind":"quote"},{"id":"blk-31502","kind":"paragraph","spans":[{"id":"spn-36116","text":"---"}]},{"id":"blk-31503","kind":"heading","level":2,"spans":[{"id":"spn-36117","text":"0) Context"}]},{"id":"blk-31504","kind":"paragraph","spans":[{"id":"spn-36118","text":"WebHost.Systems currently treats agents as opaque code bundles deployed to Cloudflare Workers or AWS AgentCore. To serve as the hosting platform for the [&] Protocol ecosystem, WHS must understand "},{"id":"spn-36119","marks":["bold"],"text":"capability declarations"},{"id":"spn-36120","text":", "},{"id":"spn-36121","marks":["bold"],"text":"MCP sidecar orchestration"},{"id":"spn-36122","text":", "},{"id":"spn-36123","marks":["bold"],"text":"agent-to-agent skill routing"},{"id":"spn-36124","text":", and "},{"id":"spn-36125","marks":["bold"],"text":"governance enforcement"},{"id":"spn-36126","text":"."}]},{"id":"blk-31505","kind":"paragraph","spans":[{"id":"spn-36127","text":"This spec adds [&]-aware features as phased extensions to the existing v1 architecture. The current CRUD/deploy/invoke/telemetry foundation remains intact."}]},{"id":"blk-31506","kind":"paragraph","spans":[{"id":"spn-36128","text":"---"}]},{"id":"blk-31507","kind":"heading","level":2,"spans":[{"id":"spn-36129","text":"1) Capability Manifests (ampersand.json)"}]},{"id":"blk-31508","kind":"heading","level":3,"spans":[{"id":"spn-36130","text":"1.1 Problem"}]},{"id":"blk-31509","kind":"paragraph","spans":[{"id":"spn-36131","text":"Agents currently declare only "},{"id":"spn-36132","marks":["code"],"text":"name"},{"id":"spn-36133","text":", "},{"id":"spn-36134","marks":["code"],"text":"description"},{"id":"spn-36135","text":", "},{"id":"spn-36136","marks":["code"],"text":"framework"},{"id":"spn-36137","text":", and "},{"id":"spn-36138","marks":["code"],"text":"runtimeProvider"},{"id":"spn-36139","text":". There is no way for the platform to know what capabilities an agent uses ("},{"id":"spn-36140","marks":["code"],"text":"&memory.graph"},{"id":"spn-36141","text":", "},{"id":"spn-36142","marks":["code"],"text":"&time.anomaly"},{"id":"spn-36143","text":", etc.) or what it provides."}]},{"id":"blk-31510","kind":"heading","level":3,"spans":[{"id":"spn-36144","text":"1.2 Solution"}]},{"id":"blk-31511","kind":"paragraph","spans":[{"id":"spn-36145","text":"Support an optional "},{"id":"spn-36146","marks":["code"],"text":"ampersand.json"},{"id":"spn-36147","text":" manifest alongside the agent code bundle. When present, WHS validates it against the [&] Protocol schema and uses it for:"}]},{"id":"blk-31512","items":[{"blocks":[{"id":"blk-31514","kind":"paragraph","spans":[{"id":"spn-36148","text":"Capability-aware deployment (auto-provision required MCP sidecars)"}]}],"id":"blk-31513","kind":"list-item"},{"blocks":[{"id":"blk-31516","kind":"paragraph","spans":[{"id":"spn-36149","text":"FleetPrompt registry integration (publish agent capabilities)"}]}],"id":"blk-31515","kind":"list-item"},{"blocks":[{"id":"blk-31518","kind":"paragraph","spans":[{"id":"spn-36150","text":"Governance enforcement (Delegatic policy checks)"}]}],"id":"blk-31517","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31519","kind":"heading","level":3,"spans":[{"id":"spn-36151","text":"1.3 Schema"}]},{"id":"blk-31520","kind":"paragraph","spans":[{"id":"spn-36152","text":"The manifest follows "},{"id":"spn-36153","marks":["code"],"text":"AmpersandBoxDesign/protocol/schema/v0.1.0/ampersand.schema.json"},{"id":"spn-36154","text":"."}]},{"id":"blk-31521","kind":"paragraph","spans":[{"id":"spn-36155","text":"Key fields for WHS:"}]},{"id":"blk-31522","kind":"code","language":"json","text":"{\n  \"agent\": \"my-agent\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": {\n    \"uses\": [\"&memory.graph\", \"&time.anomaly\", \"&reason.deliberate\"],\n    \"provides\": [\"&space.fleet.locate\"]\n  },\n  \"providers\": {\n    \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"db\": \"auto\" } },\n    \"&time.anomaly\": { \"provider\": \"ticktickclock\" },\n    \"&reason.deliberate\": { \"provider\": \"auto\" }\n  },\n  \"governance\": {\n    \"autonomy\": \"advise\",\n    \"constraints\": { \"hard\": [\"no_network_without_approval\"], \"soft\": [] }\n  },\n  \"mcp_servers\": [\"graphonomous\", \"ticktickclock\"]\n}"},{"id":"blk-31523","kind":"heading","level":3,"spans":[{"id":"spn-36156","text":"1.4 Data Model Extension"}]},{"id":"blk-31524","kind":"paragraph","spans":[{"id":"spn-36157","text":"Add to "},{"id":"spn-36158","marks":["code"],"text":"agents"},{"id":"spn-36159","text":" table:"}]},{"id":"blk-31525","kind":"code","language":"text","text":"ampersandManifest: optional JSON blob (validated against schema on deploy)\ncapabilitiesUsed: optional string[] (denormalized from manifest for search/filter)\ncapabilitiesProvided: optional string[] (denormalized for registry)"},{"id":"blk-31526","kind":"heading","level":3,"spans":[{"id":"spn-36160","text":"1.5 Validation"}]},{"id":"blk-31527","kind":"paragraph","spans":[{"id":"spn-36161","text":"On deployment, if "},{"id":"spn-36162","marks":["code"],"text":"ampersand.json"},{"id":"spn-36163","text":" is present in the bundle: 1. Validate against [&] schema (reuse "},{"id":"spn-36164","marks":["code"],"text":"@ampersand-protocol/validate"},{"id":"spn-36165","text":" npm package) 2. Extract "},{"id":"spn-36166","marks":["code"],"text":"capabilities.uses"},{"id":"spn-36167","text":" and "},{"id":"spn-36168","marks":["code"],"text":"capabilities.provides"},{"id":"spn-36169","text":" 3. Verify all declared providers are available in the deployment environment 4. Store validated manifest in "},{"id":"spn-36170","marks":["code"],"text":"agents.ampersandManifest"}]},{"id":"blk-31528","kind":"paragraph","spans":[{"id":"spn-36171","text":"---"}]},{"id":"blk-31529","kind":"heading","level":2,"spans":[{"id":"spn-36172","text":"2) MCP Sidecar Orchestration"}]},{"id":"blk-31530","kind":"heading","level":3,"spans":[{"id":"spn-36173","text":"2.1 Problem"}]},{"id":"blk-31531","kind":"paragraph","spans":[{"id":"spn-36174","text":"[&] agents compose capabilities via MCP servers (Graphonomous for "},{"id":"spn-36175","marks":["code"],"text":"&memory"},{"id":"spn-36176","text":", TickTickClock for "},{"id":"spn-36177","marks":["code"],"text":"&time"},{"id":"spn-36178","text":", etc.). Currently WHS deploys agents in isolation with no MCP server connectivity."}]},{"id":"blk-31532","kind":"heading","level":3,"spans":[{"id":"spn-36179","text":"2.2 Solution"}]},{"id":"blk-31533","kind":"paragraph","spans":[{"id":"spn-36180","marks":["bold"],"text":"Phase 1 — Linked MCP services"},{"id":"spn-36181","text":": Allow agents to declare MCP server dependencies. WHS provisions and manages these as linked services (similar to linked databases in PaaS platforms)."}]},{"id":"blk-31534","kind":"paragraph","spans":[{"id":"spn-36182","marks":["bold"],"text":"Phase 2 — MCP sidecar model"},{"id":"spn-36183","text":": For Cloudflare Workers, run MCP servers as Durable Object sidecars. For AgentCore, use linked Lambda/container sidecars."}]},{"id":"blk-31535","kind":"heading","level":3,"spans":[{"id":"spn-36184","text":"2.3 Configuration"}]},{"id":"blk-31536","kind":"paragraph","spans":[{"id":"spn-36185","text":"In "},{"id":"spn-36186","marks":["code"],"text":"ampersand.json"},{"id":"spn-36187","text":":"}]},{"id":"blk-31537","kind":"code","language":"json","text":"{\n  \"mcp_servers\": [\n    {\n      \"name\": \"graphonomous\",\n      \"transport\": \"streamable_http\",\n      \"config\": {\n        \"db_path\": \"auto\",\n        \"embedder_backend\": \"fallback\"\n      }\n    }\n  ]\n}"},{"id":"blk-31538","kind":"heading","level":3,"spans":[{"id":"spn-36188","text":"2.4 Data Model Extension"}]},{"id":"blk-31539","kind":"paragraph","spans":[{"id":"spn-36189","text":"New table: "},{"id":"spn-36190","marks":["code"],"text":"linkedServices"}]},{"id":"blk-31540","kind":"code","language":"text","text":"agentId: Id<\"agents\">\nserviceType: \"mcp_server\" | \"database\" | \"cache\"\nserviceName: string\nproviderRef: string (provider-specific endpoint/identifier)\nconfig: JSON\nstatus: \"provisioning\" | \"active\" | \"error\" | \"deprovisioned\"\ncreatedAt: number"},{"id":"blk-31541","kind":"heading","level":3,"spans":[{"id":"spn-36191","text":"2.5 Runtime Provider Interface Extension"}]},{"id":"blk-31542","kind":"paragraph","spans":[{"id":"spn-36192","text":"Add to RPI (§20):"}]},{"id":"blk-31543","kind":"code","language":"typescript","text":"interface RuntimeProviderAdapter {\n  // ... existing methods ...\n\n  // Phase 2: MCP sidecar support\n  provisionLinkedService?(agentId: string, service: LinkedServiceConfig): Promise<ServiceRef>;\n  deprovisionLinkedService?(agentId: string, serviceRef: string): Promise<void>;\n  getLinkedServiceEndpoint?(agentId: string, serviceName: string): Promise<string>;\n}"},{"id":"blk-31544","kind":"paragraph","spans":[{"id":"spn-36193","text":"---"}]},{"id":"blk-31545","kind":"heading","level":2,"spans":[{"id":"spn-36194","text":"3) Agent-to-Agent Skill Routing (A2A)"}]},{"id":"blk-31546","kind":"heading","level":3,"spans":[{"id":"spn-36195","text":"3.1 Problem"}]},{"id":"blk-31547","kind":"paragraph","spans":[{"id":"spn-36196","text":"Currently only human→agent invocation is supported. [&] agents need to invoke skills on other agents (e.g., a fleet coordinator querying a spatial intelligence agent)."}]},{"id":"blk-31548","kind":"heading","level":3,"spans":[{"id":"spn-36197","text":"3.2 Solution"}]},{"id":"blk-31549","kind":"paragraph","spans":[{"id":"spn-36198","text":"Add A2A invocation support using the A2A protocol (agent-to-agent, complementary to MCP):"}]},{"id":"blk-31550","kind":"paragraph","spans":[{"id":"spn-36199","text":"1. "},{"id":"spn-36200","marks":["bold"],"text":"Skill declaration"},{"id":"spn-36201","text":": Agents declare "},{"id":"spn-36202","marks":["code"],"text":"a2a_skills"},{"id":"spn-36203","text":" in their manifest 2. "},{"id":"spn-36204","marks":["bold"],"text":"Skill discovery"},{"id":"spn-36205","text":": WHS maintains an internal skill registry (derived from manifests) 3. "},{"id":"spn-36206","marks":["bold"],"text":"Skill invocation"},{"id":"spn-36207","text":": Agents can invoke skills on other agents via a WHS-mediated endpoint 4. "},{"id":"spn-36208","marks":["bold"],"text":"Governance"},{"id":"spn-36209","text":": All A2A calls pass through Delegatic policy checks"}]},{"id":"blk-31551","kind":"heading","level":3,"spans":[{"id":"spn-36210","text":"3.3 API Extension"}]},{"id":"blk-31552","kind":"code","language":"text","text":"POST /api/v1/a2a/invoke\n{\n  \"caller_agent_id\": \"agent_abc\",\n  \"skill\": \"fleet-state-enrichment\",\n  \"input\": { ... },\n  \"session_id\": \"optional\"\n}"},{"id":"blk-31553","kind":"paragraph","spans":[{"id":"spn-36211","text":"WHS resolves the skill to a target agent, checks governance policies, invokes the target, and returns the result."}]},{"id":"blk-31554","kind":"heading","level":3,"spans":[{"id":"spn-36212","text":"3.4 Data Model Extension"}]},{"id":"blk-31555","kind":"paragraph","spans":[{"id":"spn-36213","text":"New table: "},{"id":"spn-36214","marks":["code"],"text":"skillRegistry"}]},{"id":"blk-31556","kind":"code","language":"text","text":"agentId: Id<\"agents\">\nskill: string\ncapability: string (&space.fleet, etc.)\nstatus: \"active\" | \"inactive\""},{"id":"blk-31557","kind":"paragraph","spans":[{"id":"spn-36215","text":"---"}]},{"id":"blk-31558","kind":"heading","level":2,"spans":[{"id":"spn-36216","text":"4) Governance Enforcement (Delegatic Integration)"}]},{"id":"blk-31559","kind":"heading","level":3,"spans":[{"id":"spn-36217","text":"4.1 Problem"}]},{"id":"blk-31560","kind":"paragraph","spans":[{"id":"spn-36218","text":"WHS currently enforces only tier-based billing limits. [&] agents need governance enforcement: hard/soft constraints, autonomy levels, goal-aware authorization, and audit trails."}]},{"id":"blk-31561","kind":"heading","level":3,"spans":[{"id":"spn-36219","text":"4.2 Solution"}]},{"id":"blk-31562","kind":"paragraph","spans":[{"id":"spn-36220","text":"Integrate with Delegatic for governance:"}]},{"id":"blk-31563","kind":"paragraph","spans":[{"id":"spn-36221","text":"1. "},{"id":"spn-36222","marks":["bold"],"text":"Policy attachment"},{"id":"spn-36223","text":": Link agents to Delegatic org/policy trees 2. "},{"id":"spn-36224","marks":["bold"],"text":"Pre-invocation check"},{"id":"spn-36225","text":": Before invoking an agent, check Delegatic policies 3. "},{"id":"spn-36226","marks":["bold"],"text":"Audit forwarding"},{"id":"spn-36227","text":": Forward invocation telemetry to Delegatic audit trail 4. "},{"id":"spn-36228","marks":["bold"],"text":"Autonomy enforcement"},{"id":"spn-36229","text":": Respect "},{"id":"spn-36230","marks":["code"],"text":"observe | advise | act"},{"id":"spn-36231","text":" autonomy levels from manifests"}]},{"id":"blk-31564","kind":"heading","level":3,"spans":[{"id":"spn-36232","text":"4.3 Configuration"}]},{"id":"blk-31565","kind":"paragraph","spans":[{"id":"spn-36233","text":"In "},{"id":"spn-36234","marks":["code"],"text":"ampersand.json"},{"id":"spn-36235","text":":"}]},{"id":"blk-31566","kind":"code","language":"json","text":"{\n  \"governance\": {\n    \"delegatic_org_id\": \"org_xyz\",\n    \"autonomy\": \"advise\",\n    \"constraints\": {\n      \"hard\": [\"no_network_without_approval\", \"no_filesystem_write\"],\n      \"soft\": [\"prefer_local_inference\"]\n    }\n  }\n}"},{"id":"blk-31567","kind":"heading","level":3,"spans":[{"id":"spn-36236","text":"4.4 Invocation Flow Change"}]},{"id":"blk-31568","kind":"paragraph","spans":[{"id":"spn-36237","text":"Updated Flow C (Invoke agent): 1. Client calls "},{"id":"spn-36238","marks":["code"],"text":"POST /invoke/:agentId"},{"id":"spn-36239","text":" 2. Control plane authenticates/authorizes 3. "},{"id":"spn-36240","marks":["bold"],"text":"NEW"},{"id":"spn-36241","text":": If agent has governance config, call Delegatic policy check 4. Check plan limits and agent status 5. Route to runtime provider 6. "},{"id":"spn-36242","marks":["bold"],"text":"NEW"},{"id":"spn-36243","text":": Forward telemetry to Delegatic audit 7. Return response"}]},{"id":"blk-31569","kind":"paragraph","spans":[{"id":"spn-36244","text":"---"}]},{"id":"blk-31570","kind":"heading","level":2,"spans":[{"id":"spn-36245","text":"5) Provider Registry (Dynamic Resolution)"}]},{"id":"blk-31571","kind":"heading","level":3,"spans":[{"id":"spn-36246","text":"5.1 Problem"}]},{"id":"blk-31572","kind":"paragraph","spans":[{"id":"spn-36247","text":"Runtime providers (Cloudflare, AgentCore) are hardcoded. [&] agents declare capability providers that should be resolved dynamically (e.g., "},{"id":"spn-36248","marks":["code"],"text":"\"provider\": \"auto\""},{"id":"spn-36249","text":" should resolve to the best available provider for "},{"id":"spn-36250","marks":["code"],"text":"&memory.graph"},{"id":"spn-36251","text":")."}]},{"id":"blk-31573","kind":"heading","level":3,"spans":[{"id":"spn-36252","text":"5.2 Solution"}]},{"id":"blk-31574","kind":"paragraph","spans":[{"id":"spn-36253","text":"Add a capability provider registry to WHS:"}]},{"id":"blk-31575","kind":"code","language":"text","text":"Provider: graphonomous → Capabilities: [&memory.graph, &memory.consolidate, &reason.deliberate, &reason.attend]\nProvider: ticktickclock → Capabilities: [&time.anomaly, &time.forecast, &time.pattern]\nProvider: geofleetic → Capabilities: [&space.fleet, &space.route, &space.geofence]\nProvider: bendscript → Capabilities: [&memory.graph (KAG)]"},{"id":"blk-31576","kind":"paragraph","spans":[{"id":"spn-36254","text":"When "},{"id":"spn-36255","marks":["code"],"text":"\"provider\": \"auto\""},{"id":"spn-36256","text":", WHS resolves to the best available provider based on: 1. Capability match 2. Provider availability in deployment region 3. Cost tier of the user's plan 4. Governance constraints"}]},{"id":"blk-31577","kind":"paragraph","spans":[{"id":"spn-36257","text":"---"}]},{"id":"blk-31578","kind":"heading","level":2,"spans":[{"id":"spn-36258","text":"6) Provenance and Audit Trail"}]},{"id":"blk-31579","kind":"heading","level":3,"spans":[{"id":"spn-36259","text":"6.1 Problem"}]},{"id":"blk-31580","kind":"paragraph","spans":[{"id":"spn-36260","text":"Currently invocations have basic "},{"id":"spn-36261","marks":["code"],"text":"traceId"},{"id":"spn-36262","text":" but no hash-linked provenance chain. For [&] agents, every decision should be traceable back through the capability calls that informed it."}]},{"id":"blk-31581","kind":"heading","level":3,"spans":[{"id":"spn-36263","text":"6.2 Solution"}]},{"id":"blk-31582","kind":"paragraph","spans":[{"id":"spn-36264","text":"Extend telemetry events with provenance fields:"}]},{"id":"blk-31583","kind":"code","language":"typescript","text":"interface TelemetryEvent {\n  // ... existing fields ...\n\n  // [&] provenance extension\n  ampersand?: {\n    capabilities_invoked: string[];      // [\"&memory.graph.recall\", \"&time.anomaly.detect\"]\n    routing_decision: \"fast\" | \"deliberate\";  // κ routing result\n    kappa_value?: number;                // cyclicity score if deliberation was triggered\n    goal_id?: string;                    // Graphonomous GoalGraph reference\n    provenance_hash?: string;            // hash-linked to parent invocation\n    a2a_calls?: {\n      target_agent: string;\n      skill: string;\n      duration_ms: number;\n    }[];\n  };\n}"},{"id":"blk-31584","kind":"paragraph","spans":[{"id":"spn-36265","text":"---"}]},{"id":"blk-31585","kind":"heading","level":2,"spans":[{"id":"spn-36266","text":"7) Implementation Phases"}]},{"id":"blk-31586","kind":"heading","level":3,"spans":[{"id":"spn-36267","text":"Phase 1 — Manifest Support (lowest lift, highest signal)"}]},{"id":"blk-31587","items":[{"blocks":[{"id":"blk-31589","kind":"paragraph","spans":[{"id":"spn-36268","text":"[ ] Accept "},{"id":"spn-36269","marks":["code"],"text":"ampersand.json"},{"id":"spn-36270","text":" in deployment bundles"}]}],"id":"blk-31588","kind":"list-item"},{"blocks":[{"id":"blk-31591","kind":"paragraph","spans":[{"id":"spn-36271","text":"[ ] Validate against [&] schema using "},{"id":"spn-36272","marks":["code"],"text":"@ampersand-protocol/validate"}]}],"id":"blk-31590","kind":"list-item"},{"blocks":[{"id":"blk-31593","kind":"paragraph","spans":[{"id":"spn-36273","text":"[ ] Store manifest + denormalized capabilities in "},{"id":"spn-36274","marks":["code"],"text":"agents"},{"id":"spn-36275","text":" table"}]}],"id":"blk-31592","kind":"list-item"},{"blocks":[{"id":"blk-31595","kind":"paragraph","spans":[{"id":"spn-36276","text":"[ ] Add capability filter to agent list API"}]}],"id":"blk-31594","kind":"list-item"},{"blocks":[{"id":"blk-31597","kind":"paragraph","spans":[{"id":"spn-36277","text":"[ ] Update dashboard to show declared capabilities"}]}],"id":"blk-31596","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31598","kind":"heading","level":3,"spans":[{"id":"spn-36278","text":"Phase 2 — MCP Linked Services"}]},{"id":"blk-31599","items":[{"blocks":[{"id":"blk-31601","kind":"paragraph","spans":[{"id":"spn-36279","text":"[ ] Design linked service provisioning for Cloudflare (Durable Object sidecars)"}]}],"id":"blk-31600","kind":"list-item"},{"blocks":[{"id":"blk-31603","kind":"paragraph","spans":[{"id":"spn-36280","text":"[ ] Design linked service provisioning for AgentCore (Lambda sidecars)"}]}],"id":"blk-31602","kind":"list-item"},{"blocks":[{"id":"blk-31605","kind":"paragraph","spans":[{"id":"spn-36281","text":"[ ] Implement RPI extensions for linked service lifecycle"}]}],"id":"blk-31604","kind":"list-item"},{"blocks":[{"id":"blk-31607","kind":"paragraph","spans":[{"id":"spn-36282","text":"[ ] Auto-provision declared "},{"id":"spn-36283","marks":["code"],"text":"mcp_servers"},{"id":"spn-36284","text":" on deploy"}]}],"id":"blk-31606","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31608","kind":"heading","level":3,"spans":[{"id":"spn-36285","text":"Phase 3 — A2A Skill Routing"}]},{"id":"blk-31609","items":[{"blocks":[{"id":"blk-31611","kind":"paragraph","spans":[{"id":"spn-36286","text":"[ ] Build internal skill registry from agent manifests"}]}],"id":"blk-31610","kind":"list-item"},{"blocks":[{"id":"blk-31613","kind":"paragraph","spans":[{"id":"spn-36287","text":"[ ] Implement "},{"id":"spn-36288","marks":["code"],"text":"/api/v1/a2a/invoke"},{"id":"spn-36289","text":" endpoint"}]}],"id":"blk-31612","kind":"list-item"},{"blocks":[{"id":"blk-31615","kind":"paragraph","spans":[{"id":"spn-36290","text":"[ ] Add governance check gate to A2A calls"}]}],"id":"blk-31614","kind":"list-item"},{"blocks":[{"id":"blk-31617","kind":"paragraph","spans":[{"id":"spn-36291","text":"[ ] Dashboard: show skill graph visualization"}]}],"id":"blk-31616","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31618","kind":"heading","level":3,"spans":[{"id":"spn-36292","text":"Phase 4 — Governance Integration"}]},{"id":"blk-31619","items":[{"blocks":[{"id":"blk-31621","kind":"paragraph","spans":[{"id":"spn-36293","text":"[ ] Integrate Delegatic policy check in invocation flow"}]}],"id":"blk-31620","kind":"list-item"},{"blocks":[{"id":"blk-31623","kind":"paragraph","spans":[{"id":"spn-36294","text":"[ ] Forward audit events to Delegatic"}]}],"id":"blk-31622","kind":"list-item"},{"blocks":[{"id":"blk-31625","kin