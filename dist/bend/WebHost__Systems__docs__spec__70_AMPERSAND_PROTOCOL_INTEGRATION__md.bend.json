{"bendscript":"0.1","blocks":[{"id":"blk-49622","kind":"heading","level":1,"spans":[{"id":"spn-76509","text":"webhost.systems — [&] Protocol Integration Spec (v1)"}]},{"id":"blk-49623","kind":"paragraph","spans":[{"id":"spn-76510","text":"Version: 1.0 Status: Draft Audience: Engineering Last updated: 2026-03-28"}]},{"blocks":[{"id":"blk-49625","kind":"paragraph","spans":[{"id":"spn-76511","text":"This document extends the v1 spec to make WebHost.Systems the canonical hosting layer for [&] Protocol agents."}]}],"id":"blk-49624","kind":"quote"},{"id":"blk-49626","kind":"heading","level":2,"spans":[{"id":"spn-76512","text":"0) Context"}]},{"id":"blk-49627","kind":"paragraph","spans":[{"id":"spn-76513","text":"WebHost.Systems currently treats agents as opaque code bundles deployed to Cloudflare Workers or AWS AgentCore. To serve as the hosting platform for the [&] Protocol ecosystem, WHS must understand "},{"id":"spn-76514","marks":["bold"],"text":"capability declarations"},{"id":"spn-76515","text":", "},{"id":"spn-76516","marks":["bold"],"text":"MCP sidecar orchestration"},{"id":"spn-76517","text":", "},{"id":"spn-76518","marks":["bold"],"text":"agent-to-agent skill routing"},{"id":"spn-76519","text":", and "},{"id":"spn-76520","marks":["bold"],"text":"governance enforcement"},{"id":"spn-76521","text":"."}]},{"id":"blk-49628","kind":"paragraph","spans":[{"id":"spn-76522","text":"This spec adds [&]-aware features as phased extensions to the existing v1 architecture. The current CRUD/deploy/invoke/telemetry foundation remains intact."}]},{"id":"blk-49629","kind":"heading","level":2,"spans":[{"id":"spn-76523","text":"1) Capability Manifests (ampersand.json)"}]},{"id":"blk-49630","kind":"heading","level":3,"spans":[{"id":"spn-76524","text":"1.1 Problem"}]},{"id":"blk-49631","kind":"paragraph","spans":[{"id":"spn-76525","text":"Agents currently declare only "},{"id":"spn-76526","marks":["code"],"text":"name"},{"id":"spn-76527","text":", "},{"id":"spn-76528","marks":["code"],"text":"description"},{"id":"spn-76529","text":", "},{"id":"spn-76530","marks":["code"],"text":"framework"},{"id":"spn-76531","text":", and "},{"id":"spn-76532","marks":["code"],"text":"runtimeProvider"},{"id":"spn-76533","text":". There is no way for the platform to know what capabilities an agent uses ("},{"id":"spn-76534","marks":["code"],"text":"&memory.graph"},{"id":"spn-76535","text":", "},{"id":"spn-76536","marks":["code"],"text":"&time.anomaly"},{"id":"spn-76537","text":", etc.) or what it provides."}]},{"id":"blk-49632","kind":"heading","level":3,"spans":[{"id":"spn-76538","text":"1.2 Solution"}]},{"id":"blk-49633","kind":"paragraph","spans":[{"id":"spn-76539","text":"Support an optional "},{"id":"spn-76540","marks":["code"],"text":"ampersand.json"},{"id":"spn-76541","text":" manifest alongside the agent code bundle. When present, WHS validates it against the [&] Protocol schema and uses it for:"}]},{"id":"blk-49634","items":[{"blocks":[{"id":"blk-49636","kind":"paragraph","spans":[{"id":"spn-76542","text":"Capability-aware deployment (auto-provision required MCP sidecars)"}]}],"id":"blk-49635","kind":"list-item"},{"blocks":[{"id":"blk-49638","kind":"paragraph","spans":[{"id":"spn-76543","text":"FleetPrompt registry integration (publish agent capabilities)"}]}],"id":"blk-49637","kind":"list-item"},{"blocks":[{"id":"blk-49640","kind":"paragraph","spans":[{"id":"spn-76544","text":"Governance enforcement (Delegatic policy checks)"}]}],"id":"blk-49639","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49641","kind":"heading","level":3,"spans":[{"id":"spn-76545","text":"1.3 Schema"}]},{"id":"blk-49642","kind":"paragraph","spans":[{"id":"spn-76546","text":"The manifest follows "},{"id":"spn-76547","marks":["code"],"text":"AmpersandBoxDesign/protocol/schema/v0.1.0/ampersand.schema.json"},{"id":"spn-76548","text":"."}]},{"id":"blk-49643","kind":"paragraph","spans":[{"id":"spn-76549","text":"Key fields for WHS:"}]},{"id":"blk-49644","kind":"code","language":"json","text":"{\n  \"agent\": \"my-agent\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": {\n    \"uses\": [\"&memory.graph\", \"&time.anomaly\", \"&reason.deliberate\"],\n    \"provides\": [\"&space.fleet.locate\"]\n  },\n  \"providers\": {\n    \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"db\": \"auto\" } },\n    \"&time.anomaly\": { \"provider\": \"ticktickclock\" },\n    \"&reason.deliberate\": { \"provider\": \"auto\" }\n  },\n  \"governance\": {\n    \"autonomy\": \"advise\",\n    \"constraints\": { \"hard\": [\"no_network_without_approval\"], \"soft\": [] }\n  },\n  \"mcp_servers\": [\"graphonomous\", \"ticktickclock\"]\n}"},{"id":"blk-49645","kind":"heading","level":3,"spans":[{"id":"spn-76550","text":"1.4 Data Model Extension"}]},{"id":"blk-49646","kind":"paragraph","spans":[{"id":"spn-76551","text":"Add to "},{"id":"spn-76552","marks":["code"],"text":"agents"},{"id":"spn-76553","text":" table:"}]},{"id":"blk-49647","kind":"code","language":"text","text":"ampersandManifest: optional JSON blob (validated against schema on deploy)\ncapabilitiesUsed: optional string[] (denormalized from manifest for search/filter)\ncapabilitiesProvided: optional string[] (denormalized for registry)"},{"id":"blk-49648","kind":"heading","level":3,"spans":[{"id":"spn-76554","text":"1.5 Validation"}]},{"id":"blk-49649","kind":"paragraph","spans":[{"id":"spn-76555","text":"On deployment, if "},{"id":"spn-76556","marks":["code"],"text":"ampersand.json"},{"id":"spn-76557","text":" is present in the bundle:"}]},{"id":"blk-49650","items":[{"blocks":[{"id":"blk-49652","kind":"paragraph","spans":[{"id":"spn-76558","text":"Validate against [&] schema (reuse "},{"id":"spn-76559","marks":["code"],"text":"@ampersand-protocol/validate"},{"id":"spn-76560","text":" npm package)"}]}],"id":"blk-49651","kind":"list-item"},{"blocks":[{"id":"blk-49654","kind":"paragraph","spans":[{"id":"spn-76561","text":"Extract "},{"id":"spn-76562","marks":["code"],"text":"capabilities.uses"},{"id":"spn-76563","text":" and "},{"id":"spn-76564","marks":["code"],"text":"capabilities.provides"}]}],"id":"blk-49653","kind":"list-item"},{"blocks":[{"id":"blk-49656","kind":"paragraph","spans":[{"id":"spn-76565","text":"Verify all declared providers are available in the deployment environment"}]}],"id":"blk-49655","kind":"list-item"},{"blocks":[{"id":"blk-49658","kind":"paragraph","spans":[{"id":"spn-76566","text":"Store validated manifest in "},{"id":"spn-76567","marks":["code"],"text":"agents.ampersandManifest"}]}],"id":"blk-49657","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49659","kind":"heading","level":2,"spans":[{"id":"spn-76568","text":"2) MCP Sidecar Orchestration"}]},{"id":"blk-49660","kind":"heading","level":3,"spans":[{"id":"spn-76569","text":"2.1 Problem"}]},{"id":"blk-49661","kind":"paragraph","spans":[{"id":"spn-76570","text":"[&] agents compose capabilities via MCP servers (Graphonomous for "},{"id":"spn-76571","marks":["code"],"text":"&memory"},{"id":"spn-76572","text":", TickTickClock for "},{"id":"spn-76573","marks":["code"],"text":"&time"},{"id":"spn-76574","text":", etc.). Currently WHS deploys agents in isolation with no MCP server connectivity."}]},{"id":"blk-49662","kind":"heading","level":3,"spans":[{"id":"spn-76575","text":"2.2 Solution"}]},{"id":"blk-49663","kind":"paragraph","spans":[{"id":"spn-76576","marks":["bold"],"text":"Phase 1 — Linked MCP services"},{"id":"spn-76577","text":": Allow agents to declare MCP server dependencies. WHS provisions and manages these as linked services (similar to linked databases in PaaS platforms)."}]},{"id":"blk-49664","kind":"paragraph","spans":[{"id":"spn-76578","marks":["bold"],"text":"Phase 2 — MCP sidecar model"},{"id":"spn-76579","text":": For Cloudflare Workers, run MCP servers as Durable Object sidecars. For AgentCore, use linked Lambda/container sidecars."}]},{"id":"blk-49665","kind":"heading","level":3,"spans":[{"id":"spn-76580","text":"2.3 Configuration"}]},{"id":"blk-49666","kind":"paragraph","spans":[{"id":"spn-76581","text":"In "},{"id":"spn-76582","marks":["code"],"text":"ampersand.json"},{"id":"spn-76583","text":":"}]},{"id":"blk-49667","kind":"code","language":"json","text":"{\n  \"mcp_servers\": [\n    {\n      \"name\": \"graphonomous\",\n      \"transport\": \"streamable_http\",\n      \"config\": {\n        \"db_path\": \"auto\",\n        \"embedder_backend\": \"fallback\"\n      }\n    }\n  ]\n}"},{"id":"blk-49668","kind":"heading","level":3,"spans":[{"id":"spn-76584","text":"2.4 Data Model Extension"}]},{"id":"blk-49669","kind":"paragraph","spans":[{"id":"spn-76585","text":"New table: "},{"id":"spn-76586","marks":["code"],"text":"linkedServices"}]},{"id":"blk-49670","kind":"code","language":"text","text":"agentId: Id<\"agents\">\nserviceType: \"mcp_server\" | \"database\" | \"cache\"\nserviceName: string\nproviderRef: string (provider-specific endpoint/identifier)\nconfig: JSON\nstatus: \"provisioning\" | \"active\" | \"error\" | \"deprovisioned\"\ncreatedAt: number"},{"id":"blk-49671","kind":"heading","level":3,"spans":[{"id":"spn-76587","text":"2.5 Runtime Provider Interface Extension"}]},{"id":"blk-49672","kind":"paragraph","spans":[{"id":"spn-76588","text":"Add to RPI (§20):"}]},{"id":"blk-49673","kind":"code","language":"typescript","text":"interface RuntimeProviderAdapter {\n  // ... existing methods ...\n\n  // Phase 2: MCP sidecar support\n  provisionLinkedService?(agentId: string, service: LinkedServiceConfig): Promise<ServiceRef>;\n  deprovisionLinkedService?(agentId: string, serviceRef: string): Promise<void>;\n  getLinkedServiceEndpoint?(agentId: string, serviceName: string): Promise<string>;\n}"},{"id":"blk-49674","kind":"heading","level":2,"spans":[{"id":"spn-76589","text":"3) Agent-to-Agent Skill Routing (A2A)"}]},{"id":"blk-49675","kind":"heading","level":3,"spans":[{"id":"spn-76590","text":"3.1 Problem"}]},{"id":"blk-49676","kind":"paragraph","spans":[{"id":"spn-76591","text":"Currently only human→agent invocation is supported. [&] agents need to invoke skills on other agents (e.g., a fleet coordinator querying a spatial intelligence agent)."}]},{"id":"blk-49677","kind":"heading","level":3,"spans":[{"id":"spn-76592","text":"3.2 Solution"}]},{"id":"blk-49678","kind":"paragraph","spans":[{"id":"spn-76593","text":"Add A2A invocation support using the A2A protocol (agent-to-agent, complementary to MCP):"}]},{"id":"blk-49679","items":[{"blocks":[{"id":"blk-49681","kind":"paragraph","spans":[{"id":"spn-76594","marks":["bold"],"text":"Skill declaration"},{"id":"spn-76595","text":": Agents declare "},{"id":"spn-76596","marks":["code"],"text":"a2a_skills"},{"id":"spn-76597","text":" in their manifest"}]}],"id":"blk-49680","kind":"list-item"},{"blocks":[{"id":"blk-49683","kind":"paragraph","spans":[{"id":"spn-76598","marks":["bold"],"text":"Skill discovery"},{"id":"spn-76599","text":": WHS maintains an internal skill registry (derived from manifests)"}]}],"id":"blk-49682","kind":"list-item"},{"blocks":[{"id":"blk-49685","kind":"paragraph","spans":[{"id":"spn-76600","marks":["bold"],"text":"Skill invocation"},{"id":"spn-76601","text":": Agents can invoke skills on other agents via a WHS-mediated endpoint"}]}],"id":"blk-49684","kind":"list-item"},{"blocks":[{"id":"blk-49687","kind":"paragraph","spans":[{"id":"spn-76602","marks":["bold"],"text":"Governance"},{"id":"spn-76603","text":": All A2A calls pass through Delegatic policy checks"}]}],"id":"blk-49686","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49688","kind":"heading","level":3,"spans":[{"id":"spn-76604","text":"3.3 API Extension"}]},{"id":"blk-49689","kind":"code","language":"text","text":"POST /api/v1/a2a/invoke\n{\n  \"caller_agent_id\": \"agent_abc\",\n  \"skill\": \"fleet-state-enrichment\",\n  \"input\": { ... },\n  \"session_id\": \"optional\"\n}"},{"id":"blk-49690","kind":"paragraph","spans":[{"id":"spn-76605","text":"WHS resolves the skill to a target agent, checks governance policies, invokes the target, and returns the result."}]},{"id":"blk-49691","kind":"heading","level":3,"spans":[{"id":"spn-76606","text":"3.4 Data Model Extension"}]},{"id":"blk-49692","kind":"paragraph","spans":[{"id":"spn-76607","text":"New table: "},{"id":"spn-76608","marks":["code"],"text":"skillRegistry"}]},{"id":"blk-49693","kind":"code","language":"text","text":"agentId: Id<\"agents\">\nskill: string\ncapability: string (&space.fleet, etc.)\nstatus: \"active\" | \"inactive\""},{"id":"blk-49694","kind":"heading","level":2,"spans":[{"id":"spn-76609","text":"4) Governance Enforcement (Delegatic Integration)"}]},{"id":"blk-49695","kind":"heading","level":3,"spans":[{"id":"spn-76610","text":"4.1 Problem"}]},{"id":"blk-49696","kind":"paragraph","spans":[{"id":"spn-76611","text":"WHS currently enforces only tier-based billing limits. [&] agents need governance enforcement: hard/soft constraints, autonomy levels, goal-aware authorization, and audit trails."}]},{"id":"blk-49697","kind":"heading","level":3,"spans":[{"id":"spn-76612","text":"4.2 Solution"}]},{"id":"blk-49698","kind":"paragraph","spans":[{"id":"spn-76613","text":"Integrate with Delegatic for governance:"}]},{"id":"blk-49699","items":[{"blocks":[{"id":"blk-49701","kind":"paragraph","spans":[{"id":"spn-76614","marks":["bold"],"text":"Policy attachment"},{"id":"spn-76615","text":": Link agents to Delegatic org/policy trees"}]}],"id":"blk-49700","kind":"list-item"},{"blocks":[{"id":"blk-49703","kind":"paragraph","spans":[{"id":"spn-76616","marks":["bold"],"text":"Pre-invocation check"},{"id":"spn-76617","text":": Before invoking an agent, check Delegatic policies"}]}],"id":"blk-49702","kind":"list-item"},{"blocks":[{"id":"blk-49705","kind":"paragraph","spans":[{"id":"spn-76618","marks":["bold"],"text":"Audit forwarding"},{"id":"spn-76619","text":": Forward invocation telemetry to Delegatic audit trail"}]}],"id":"blk-49704","kind":"list-item"},{"blocks":[{"id":"blk-49707","kind":"paragraph","spans":[{"id":"spn-76620","marks":["bold"],"text":"Autonomy enforcement"},{"id":"spn-76621","text":": Respect "},{"id":"spn-76622","marks":["code"],"text":"observe | advise | act"},{"id":"spn-76623","text":" autonomy levels from manifests"}]}],"id":"blk-49706","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49708","kind":"heading","level":3,"spans":[{"id":"spn-76624","text":"4.3 Configuration"}]},{"id":"blk-49709","kind":"paragraph","spans":[{"id":"spn-76625","text":"In "},{"id":"spn-76626","marks":["code"],"text":"ampersand.json"},{"id":"spn-76627","text":":"}]},{"id":"blk-49710","kind":"code","language":"json","text":"{\n  \"governance\": {\n    \"delegatic_org_id\": \"org_xyz\",\n    \"autonomy\": \"advise\",\n    \"constraints\": {\n      \"hard\": [\"no_network_without_approval\", \"no_filesystem_write\"],\n      \"soft\": [\"prefer_local_inference\"]\n    }\n  }\n}"},{"id":"blk-49711","kind":"heading","level":3,"spans":[{"id":"spn-76628","text":"4.4 Invocation Flow Change"}]},{"id":"blk-49712","kind":"paragraph","spans":[{"id":"spn-76629","text":"Updated Flow C (Invoke agent):"}]},{"id":"blk-49713","items":[{"blocks":[{"id":"blk-49715","kind":"paragraph","spans":[{"id":"spn-76630","text":"Client calls "},{"id":"spn-76631","marks":["code"],"text":"POST /invoke/:agentId"}]}],"id":"blk-49714","kind":"list-item"},{"blocks":[{"id":"blk-49717","kind":"paragraph","spans":[{"id":"spn-76632","text":"Control plane authenticates/authorizes"}]}],"id":"blk-49716","kind":"list-item"},{"blocks":[{"id":"blk-49719","kind":"paragraph","spans":[{"id":"spn-76633","marks":["bold"],"text":"NEW"},{"id":"spn-76634","text":": If agent has governance config, call Delegatic policy check"}]}],"id":"blk-49718","kind":"list-item"},{"blocks":[{"id":"blk-49721","kind":"paragraph","spans":[{"id":"spn-76635","text":"Check plan limits and agent status"}]}],"id":"blk-49720","kind":"list-item"},{"blocks":[{"id":"blk-49723","kind":"paragraph","spans":[{"id":"spn-76636","text":"Route to runtime provider"}]}],"id":"blk-49722","kind":"list-item"},{"blocks":[{"id":"blk-49725","kind":"paragraph","spans":[{"id":"spn-76637","marks":["bold"],"text":"NEW"},{"id":"spn-76638","text":": Forward telemetry to Delegatic audit"}]}],"id":"blk-49724","kind":"list-item"},{"blocks":[{"id":"blk-49727","kind":"paragraph","spans":[{"id":"spn-76639","text":"Return response"}]}],"id":"blk-49726","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49728","kind":"heading","level":2,"spans":[{"id":"spn-76640","text":"5) Provider Registry (Dynamic Resolution)"}]},{"id":"blk-49729","kind":"heading","level":3,"spans":[{"id":"spn-76641","text":"5.1 Problem"}]},{"id":"blk-49730","kind":"paragraph","spans":[{"id":"spn-76642","text":"Runtime providers (Cloudflare, AgentCore) are hardcoded. [&] agents declare capability providers that should be resolved dynamically (e.g., "},{"id":"spn-76643","marks":["code"],"text":"\"provider\": \"auto\""},{"id":"spn-76644","text":" should resolve to the best available provider for "},{"id":"spn-76645","marks":["code"],"text":"&memory.graph"},{"id":"spn-76646","text":")."}]},{"id":"blk-49731","kind":"heading","level":3,"spans":[{"id":"spn-76647","text":"5.2 Solution"}]},{"id":"blk-49732","kind":"paragraph","spans":[{"id":"spn-76648","text":"Add a capability provider registry to WHS:"}]},{"id":"blk-49733","kind":"code","language":"text","text":"Provider: graphonomous → Capabilities: [&memory.graph, &memory.consolidate, &reason.deliberate, &reason.attend]\nProvider: ticktickclock → Capabilities: [&time.anomaly, &time.forecast, &time.pattern]\nProvider: geofleetic → Capabilities: [&space.fleet, &space.route, &space.geofence]\nProvider: bendscript → Capabilities: [&memory.graph (KAG)]"},{"id":"blk-49734","kind":"paragraph","spans":[{"id":"spn-76649","text":"When "},{"id":"spn-76650","marks":["code"],"text":"\"provider\": \"auto\""},{"id":"spn-76651","text":", WHS resolves to the best available provider based on:"}]},{"id":"blk-49735","items":[{"blocks":[{"id":"blk-49737","kind":"paragraph","spans":[{"id":"spn-76652","text":"Capability match"}]}],"id":"blk-49736","kind":"list-item"},{"blocks":[{"id":"blk-49739","kind":"paragraph","spans":[{"id":"spn-76653","text":"Provider availability in deployment region"}]}],"id":"blk-49738","kind":"list-item"},{"blocks":[{"id":"blk-49741","kind":"paragraph","spans":[{"id":"spn-76654","text":"Cost tier of the user's plan"}]}],"id":"blk-49740","kind":"list-item"},{"blocks":[{"id":"blk-49743","kind":"paragraph","spans":[{"id":"spn-76655","text":"Governance constraints"}]}],"id":"blk-49742","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49744","kind":"heading","level":2,"spans":[{"id":"spn-76656","text":"6) Provenance and Audit Trail"}]},{"id":"blk-49745","kind":"heading","level":3,"spans":[{"id":"spn-76657","text":"6.1 Problem"}]},{"id":"blk-49746","kind":"paragraph","spans":[{"id":"spn-76658","text":"Currently invocations have basic "},{"id":"spn-76659","marks":["code"],"text":"traceId"},{"id":"spn-76660","text":" but no hash-linked provenance chain. For [&] agents, every decision should be traceable back through the capability calls that informed it."}]},{"id":"blk-49747","kind":"heading","level":3,"spans":[{"id":"spn-76661","text":"6.2 Solution"}]},{"id":"blk-49748","kind":"paragraph","spans":[{"id":"spn-76662","text":"Extend telemetry events with provenance fields:"}]},{"id":"blk-49749","kind":"code","language":"typescript","text":"interface TelemetryEvent {\n  // ... existing fields ...\n\n  // [&] provenance extension\n  ampersand?: {\n    capabilities_invoked: string[];      // [\"&memory.graph.recall\", \"&time.anomaly.detect\"]\n    routing_decision: \"fast\" | \"deliberate\";  // κ routing result\n    kappa_value?: number;                // cyclicity score if deliberation was triggered\n    goal_id?: string;                    // Graphonomous GoalGraph reference\n    provenance_hash?: string;            // hash-linked to parent invocation\n    a2a_calls?: {\n      