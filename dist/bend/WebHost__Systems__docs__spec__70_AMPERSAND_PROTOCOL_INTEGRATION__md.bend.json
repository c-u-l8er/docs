{"bendscript":"0.1","blocks":[{"id":"blk-31012","kind":"heading","level":1,"spans":[{"id":"spn-34997","text":"webhost.systems — [&] Protocol Integration Spec (v1)"}]},{"id":"blk-31013","kind":"paragraph","spans":[{"id":"spn-34998","text":"Version: 1.0 Status: Draft Audience: Engineering Last updated: 2026-03-28"}]},{"blocks":[{"id":"blk-31015","kind":"paragraph","spans":[{"id":"spn-34999","text":"This document extends the v1 spec to make WebHost.Systems the canonical hosting layer for [&] Protocol agents."}]}],"id":"blk-31014","kind":"quote"},{"id":"blk-31016","kind":"paragraph","spans":[{"id":"spn-35000","text":"---"}]},{"id":"blk-31017","kind":"heading","level":2,"spans":[{"id":"spn-35001","text":"0) Context"}]},{"id":"blk-31018","kind":"paragraph","spans":[{"id":"spn-35002","text":"WebHost.Systems currently treats agents as opaque code bundles deployed to Cloudflare Workers or AWS AgentCore. To serve as the hosting platform for the [&] Protocol ecosystem, WHS must understand "},{"id":"spn-35003","marks":["bold"],"text":"capability declarations"},{"id":"spn-35004","text":", "},{"id":"spn-35005","marks":["bold"],"text":"MCP sidecar orchestration"},{"id":"spn-35006","text":", "},{"id":"spn-35007","marks":["bold"],"text":"agent-to-agent skill routing"},{"id":"spn-35008","text":", and "},{"id":"spn-35009","marks":["bold"],"text":"governance enforcement"},{"id":"spn-35010","text":"."}]},{"id":"blk-31019","kind":"paragraph","spans":[{"id":"spn-35011","text":"This spec adds [&]-aware features as phased extensions to the existing v1 architecture. The current CRUD/deploy/invoke/telemetry foundation remains intact."}]},{"id":"blk-31020","kind":"paragraph","spans":[{"id":"spn-35012","text":"---"}]},{"id":"blk-31021","kind":"heading","level":2,"spans":[{"id":"spn-35013","text":"1) Capability Manifests (ampersand.json)"}]},{"id":"blk-31022","kind":"heading","level":3,"spans":[{"id":"spn-35014","text":"1.1 Problem"}]},{"id":"blk-31023","kind":"paragraph","spans":[{"id":"spn-35015","text":"Agents currently declare only "},{"id":"spn-35016","marks":["code"],"text":"name"},{"id":"spn-35017","text":", "},{"id":"spn-35018","marks":["code"],"text":"description"},{"id":"spn-35019","text":", "},{"id":"spn-35020","marks":["code"],"text":"framework"},{"id":"spn-35021","text":", and "},{"id":"spn-35022","marks":["code"],"text":"runtimeProvider"},{"id":"spn-35023","text":". There is no way for the platform to know what capabilities an agent uses ("},{"id":"spn-35024","marks":["code"],"text":"&memory.graph"},{"id":"spn-35025","text":", "},{"id":"spn-35026","marks":["code"],"text":"&time.anomaly"},{"id":"spn-35027","text":", etc.) or what it provides."}]},{"id":"blk-31024","kind":"heading","level":3,"spans":[{"id":"spn-35028","text":"1.2 Solution"}]},{"id":"blk-31025","kind":"paragraph","spans":[{"id":"spn-35029","text":"Support an optional "},{"id":"spn-35030","marks":["code"],"text":"ampersand.json"},{"id":"spn-35031","text":" manifest alongside the agent code bundle. When present, WHS validates it against the [&] Protocol schema and uses it for:"}]},{"id":"blk-31026","items":[{"blocks":[{"id":"blk-31028","kind":"paragraph","spans":[{"id":"spn-35032","text":"Capability-aware deployment (auto-provision required MCP sidecars)"}]}],"id":"blk-31027","kind":"list-item"},{"blocks":[{"id":"blk-31030","kind":"paragraph","spans":[{"id":"spn-35033","text":"FleetPrompt registry integration (publish agent capabilities)"}]}],"id":"blk-31029","kind":"list-item"},{"blocks":[{"id":"blk-31032","kind":"paragraph","spans":[{"id":"spn-35034","text":"Governance enforcement (Delegatic policy checks)"}]}],"id":"blk-31031","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31033","kind":"heading","level":3,"spans":[{"id":"spn-35035","text":"1.3 Schema"}]},{"id":"blk-31034","kind":"paragraph","spans":[{"id":"spn-35036","text":"The manifest follows "},{"id":"spn-35037","marks":["code"],"text":"AmpersandBoxDesign/protocol/schema/v0.1.0/ampersand.schema.json"},{"id":"spn-35038","text":"."}]},{"id":"blk-31035","kind":"paragraph","spans":[{"id":"spn-35039","text":"Key fields for WHS:"}]},{"id":"blk-31036","kind":"code","language":"json","text":"{\n  \"agent\": \"my-agent\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": {\n    \"uses\": [\"&memory.graph\", \"&time.anomaly\", \"&reason.deliberate\"],\n    \"provides\": [\"&space.fleet.locate\"]\n  },\n  \"providers\": {\n    \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"db\": \"auto\" } },\n    \"&time.anomaly\": { \"provider\": \"ticktickclock\" },\n    \"&reason.deliberate\": { \"provider\": \"auto\" }\n  },\n  \"governance\": {\n    \"autonomy\": \"advise\",\n    \"constraints\": { \"hard\": [\"no_network_without_approval\"], \"soft\": [] }\n  },\n  \"mcp_servers\": [\"graphonomous\", \"ticktickclock\"]\n}"},{"id":"blk-31037","kind":"heading","level":3,"spans":[{"id":"spn-35040","text":"1.4 Data Model Extension"}]},{"id":"blk-31038","kind":"paragraph","spans":[{"id":"spn-35041","text":"Add to "},{"id":"spn-35042","marks":["code"],"text":"agents"},{"id":"spn-35043","text":" table:"}]},{"id":"blk-31039","kind":"code","language":"text","text":"ampersandManifest: optional JSON blob (validated against schema on deploy)\ncapabilitiesUsed: optional string[] (denormalized from manifest for search/filter)\ncapabilitiesProvided: optional string[] (denormalized for registry)"},{"id":"blk-31040","kind":"heading","level":3,"spans":[{"id":"spn-35044","text":"1.5 Validation"}]},{"id":"blk-31041","kind":"paragraph","spans":[{"id":"spn-35045","text":"On deployment, if "},{"id":"spn-35046","marks":["code"],"text":"ampersand.json"},{"id":"spn-35047","text":" is present in the bundle: 1. Validate against [&] schema (reuse "},{"id":"spn-35048","marks":["code"],"text":"@ampersand-protocol/validate"},{"id":"spn-35049","text":" npm package) 2. Extract "},{"id":"spn-35050","marks":["code"],"text":"capabilities.uses"},{"id":"spn-35051","text":" and "},{"id":"spn-35052","marks":["code"],"text":"capabilities.provides"},{"id":"spn-35053","text":" 3. Verify all declared providers are available in the deployment environment 4. Store validated manifest in "},{"id":"spn-35054","marks":["code"],"text":"agents.ampersandManifest"}]},{"id":"blk-31042","kind":"paragraph","spans":[{"id":"spn-35055","text":"---"}]},{"id":"blk-31043","kind":"heading","level":2,"spans":[{"id":"spn-35056","text":"2) MCP Sidecar Orchestration"}]},{"id":"blk-31044","kind":"heading","level":3,"spans":[{"id":"spn-35057","text":"2.1 Problem"}]},{"id":"blk-31045","kind":"paragraph","spans":[{"id":"spn-35058","text":"[&] agents compose capabilities via MCP servers (Graphonomous for "},{"id":"spn-35059","marks":["code"],"text":"&memory"},{"id":"spn-35060","text":", TickTickClock for "},{"id":"spn-35061","marks":["code"],"text":"&time"},{"id":"spn-35062","text":", etc.). Currently WHS deploys agents in isolation with no MCP server connectivity."}]},{"id":"blk-31046","kind":"heading","level":3,"spans":[{"id":"spn-35063","text":"2.2 Solution"}]},{"id":"blk-31047","kind":"paragraph","spans":[{"id":"spn-35064","marks":["bold"],"text":"Phase 1 — Linked MCP services"},{"id":"spn-35065","text":": Allow agents to declare MCP server dependencies. WHS provisions and manages these as linked services (similar to linked databases in PaaS platforms)."}]},{"id":"blk-31048","kind":"paragraph","spans":[{"id":"spn-35066","marks":["bold"],"text":"Phase 2 — MCP sidecar model"},{"id":"spn-35067","text":": For Cloudflare Workers, run MCP servers as Durable Object sidecars. For AgentCore, use linked Lambda/container sidecars."}]},{"id":"blk-31049","kind":"heading","level":3,"spans":[{"id":"spn-35068","text":"2.3 Configuration"}]},{"id":"blk-31050","kind":"paragraph","spans":[{"id":"spn-35069","text":"In "},{"id":"spn-35070","marks":["code"],"text":"ampersand.json"},{"id":"spn-35071","text":":"}]},{"id":"blk-31051","kind":"code","language":"json","text":"{\n  \"mcp_servers\": [\n    {\n      \"name\": \"graphonomous\",\n      \"transport\": \"streamable_http\",\n      \"config\": {\n        \"db_path\": \"auto\",\n        \"embedder_backend\": \"fallback\"\n      }\n    }\n  ]\n}"},{"id":"blk-31052","kind":"heading","level":3,"spans":[{"id":"spn-35072","text":"2.4 Data Model Extension"}]},{"id":"blk-31053","kind":"paragraph","spans":[{"id":"spn-35073","text":"New table: "},{"id":"spn-35074","marks":["code"],"text":"linkedServices"}]},{"id":"blk-31054","kind":"code","language":"text","text":"agentId: Id<\"agents\">\nserviceType: \"mcp_server\" | \"database\" | \"cache\"\nserviceName: string\nproviderRef: string (provider-specific endpoint/identifier)\nconfig: JSON\nstatus: \"provisioning\" | \"active\" | \"error\" | \"deprovisioned\"\ncreatedAt: number"},{"id":"blk-31055","kind":"heading","level":3,"spans":[{"id":"spn-35075","text":"2.5 Runtime Provider Interface Extension"}]},{"id":"blk-31056","kind":"paragraph","spans":[{"id":"spn-35076","text":"Add to RPI (§20):"}]},{"id":"blk-31057","kind":"code","language":"typescript","text":"interface RuntimeProviderAdapter {\n  // ... existing methods ...\n\n  // Phase 2: MCP sidecar support\n  provisionLinkedService?(agentId: string, service: LinkedServiceConfig): Promise<ServiceRef>;\n  deprovisionLinkedService?(agentId: string, serviceRef: string): Promise<void>;\n  getLinkedServiceEndpoint?(agentId: string, serviceName: string): Promise<string>;\n}"},{"id":"blk-31058","kind":"paragraph","spans":[{"id":"spn-35077","text":"---"}]},{"id":"blk-31059","kind":"heading","level":2,"spans":[{"id":"spn-35078","text":"3) Agent-to-Agent Skill Routing (A2A)"}]},{"id":"blk-31060","kind":"heading","level":3,"spans":[{"id":"spn-35079","text":"3.1 Problem"}]},{"id":"blk-31061","kind":"paragraph","spans":[{"id":"spn-35080","text":"Currently only human→agent invocation is supported. [&] agents need to invoke skills on other agents (e.g., a fleet coordinator querying a spatial intelligence agent)."}]},{"id":"blk-31062","kind":"heading","level":3,"spans":[{"id":"spn-35081","text":"3.2 Solution"}]},{"id":"blk-31063","kind":"paragraph","spans":[{"id":"spn-35082","text":"Add A2A invocation support using the A2A protocol (agent-to-agent, complementary to MCP):"}]},{"id":"blk-31064","kind":"paragraph","spans":[{"id":"spn-35083","text":"1. "},{"id":"spn-35084","marks":["bold"],"text":"Skill declaration"},{"id":"spn-35085","text":": Agents declare "},{"id":"spn-35086","marks":["code"],"text":"a2a_skills"},{"id":"spn-35087","text":" in their manifest 2. "},{"id":"spn-35088","marks":["bold"],"text":"Skill discovery"},{"id":"spn-35089","text":": WHS maintains an internal skill registry (derived from manifests) 3. "},{"id":"spn-35090","marks":["bold"],"text":"Skill invocation"},{"id":"spn-35091","text":": Agents can invoke skills on other agents via a WHS-mediated endpoint 4. "},{"id":"spn-35092","marks":["bold"],"text":"Governance"},{"id":"spn-35093","text":": All A2A calls pass through Delegatic policy checks"}]},{"id":"blk-31065","kind":"heading","level":3,"spans":[{"id":"spn-35094","text":"3.3 API Extension"}]},{"id":"blk-31066","kind":"code","language":"text","text":"POST /api/v1/a2a/invoke\n{\n  \"caller_agent_id\": \"agent_abc\",\n  \"skill\": \"fleet-state-enrichment\",\n  \"input\": { ... },\n  \"session_id\": \"optional\"\n}"},{"id":"blk-31067","kind":"paragraph","spans":[{"id":"spn-35095","text":"WHS resolves the skill to a target agent, checks governance policies, invokes the target, and returns the result."}]},{"id":"blk-31068","kind":"heading","level":3,"spans":[{"id":"spn-35096","text":"3.4 Data Model Extension"}]},{"id":"blk-31069","kind":"paragraph","spans":[{"id":"spn-35097","text":"New table: "},{"id":"spn-35098","marks":["code"],"text":"skillRegistry"}]},{"id":"blk-31070","kind":"code","language":"text","text":"agentId: Id<\"agents\">\nskill: string\ncapability: string (&space.fleet, etc.)\nstatus: \"active\" | \"inactive\""},{"id":"blk-31071","kind":"paragraph","spans":[{"id":"spn-35099","text":"---"}]},{"id":"blk-31072","kind":"heading","level":2,"spans":[{"id":"spn-35100","text":"4) Governance Enforcement (Delegatic Integration)"}]},{"id":"blk-31073","kind":"heading","level":3,"spans":[{"id":"spn-35101","text":"4.1 Problem"}]},{"id":"blk-31074","kind":"paragraph","spans":[{"id":"spn-35102","text":"WHS currently enforces only tier-based billing limits. [&] agents need governance enforcement: hard/soft constraints, autonomy levels, goal-aware authorization, and audit trails."}]},{"id":"blk-31075","kind":"heading","level":3,"spans":[{"id":"spn-35103","text":"4.2 Solution"}]},{"id":"blk-31076","kind":"paragraph","spans":[{"id":"spn-35104","text":"Integrate with Delegatic for governance:"}]},{"id":"blk-31077","kind":"paragraph","spans":[{"id":"spn-35105","text":"1. "},{"id":"spn-35106","marks":["bold"],"text":"Policy attachment"},{"id":"spn-35107","text":": Link agents to Delegatic org/policy trees 2. "},{"id":"spn-35108","marks":["bold"],"text":"Pre-invocation check"},{"id":"spn-35109","text":": Before invoking an agent, check Delegatic policies 3. "},{"id":"spn-35110","marks":["bold"],"text":"Audit forwarding"},{"id":"spn-35111","text":": Forward invocation telemetry to Delegatic audit trail 4. "},{"id":"spn-35112","marks":["bold"],"text":"Autonomy enforcement"},{"id":"spn-35113","text":": Respect "},{"id":"spn-35114","marks":["code"],"text":"observe | advise | act"},{"id":"spn-35115","text":" autonomy levels from manifests"}]},{"id":"blk-31078","kind":"heading","level":3,"spans":[{"id":"spn-35116","text":"4.3 Configuration"}]},{"id":"blk-31079","kind":"paragraph","spans":[{"id":"spn-35117","text":"In "},{"id":"spn-35118","marks":["code"],"text":"ampersand.json"},{"id":"spn-35119","text":":"}]},{"id":"blk-31080","kind":"code","language":"json","text":"{\n  \"governance\": {\n    \"delegatic_org_id\": \"org_xyz\",\n    \"autonomy\": \"advise\",\n    \"constraints\": {\n      \"hard\": [\"no_network_without_approval\", \"no_filesystem_write\"],\n      \"soft\": [\"prefer_local_inference\"]\n    }\n  }\n}"},{"id":"blk-31081","kind":"heading","level":3,"spans":[{"id":"spn-35120","text":"4.4 Invocation Flow Change"}]},{"id":"blk-31082","kind":"paragraph","spans":[{"id":"spn-35121","text":"Updated Flow C (Invoke agent): 1. Client calls "},{"id":"spn-35122","marks":["code"],"text":"POST /invoke/:agentId"},{"id":"spn-35123","text":" 2. Control plane authenticates/authorizes 3. "},{"id":"spn-35124","marks":["bold"],"text":"NEW"},{"id":"spn-35125","text":": If agent has governance config, call Delegatic policy check 4. Check plan limits and agent status 5. Route to runtime provider 6. "},{"id":"spn-35126","marks":["bold"],"text":"NEW"},{"id":"spn-35127","text":": Forward telemetry to Delegatic audit 7. Return response"}]},{"id":"blk-31083","kind":"paragraph","spans":[{"id":"spn-35128","text":"---"}]},{"id":"blk-31084","kind":"heading","level":2,"spans":[{"id":"spn-35129","text":"5) Provider Registry (Dynamic Resolution)"}]},{"id":"blk-31085","kind":"heading","level":3,"spans":[{"id":"spn-35130","text":"5.1 Problem"}]},{"id":"blk-31086","kind":"paragraph","spans":[{"id":"spn-35131","text":"Runtime providers (Cloudflare, AgentCore) are hardcoded. [&] agents declare capability providers that should be resolved dynamically (e.g., "},{"id":"spn-35132","marks":["code"],"text":"\"provider\": \"auto\""},{"id":"spn-35133","text":" should resolve to the best available provider for "},{"id":"spn-35134","marks":["code"],"text":"&memory.graph"},{"id":"spn-35135","text":")."}]},{"id":"blk-31087","kind":"heading","level":3,"spans":[{"id":"spn-35136","text":"5.2 Solution"}]},{"id":"blk-31088","kind":"paragraph","spans":[{"id":"spn-35137","text":"Add a capability provider registry to WHS:"}]},{"id":"blk-31089","kind":"code","language":"text","text":"Provider: graphonomous → Capabilities: [&memory.graph, &memory.consolidate, &reason.deliberate, &reason.attend]\nProvider: ticktickclock → Capabilities: [&time.anomaly, &time.forecast, &time.pattern]\nProvider: geofleetic → Capabilities: [&space.fleet, &space.route, &space.geofence]\nProvider: bendscript → Capabilities: [&memory.graph (KAG)]"},{"id":"blk-31090","kind":"paragraph","spans":[{"id":"spn-35138","text":"When "},{"id":"spn-35139","marks":["code"],"text":"\"provider\": \"auto\""},{"id":"spn-35140","text":", WHS resolves to the best available provider based on: 1. Capability match 2. Provider availability in deployment region 3. Cost tier of the user's plan 4. Governance constraints"}]},{"id":"blk-31091","kind":"paragraph","spans":[{"id":"spn-35141","text":"---"}]},{"id":"blk-31092","kind":"heading","level":2,"spans":[{"id":"spn-35142","text":"6) Provenance and Audit Trail"}]},{"id":"blk-31093","kind":"heading","level":3,"spans":[{"id":"spn-35143","text":"6.1 Problem"}]},{"id":"blk-31094","kind":"paragraph","spans":[{"id":"spn-35144","text":"Currently invocations have basic "},{"id":"spn-35145","marks":["code"],"text":"traceId"},{"id":"spn-35146","text":" but no hash-linked provenance chain. For [&] agents, every decision should be traceable back through the capability calls that informed it."}]},{"id":"blk-31095","kind":"heading","level":3,"spans":[{"id":"spn-35147","text":"6.2 Solution"}]},{"id":"blk-31096","kind":"paragraph","spans":[{"id":"spn-35148","text":"Extend telemetry events with provenance fields:"}]},{"id":"blk-31097","kind":"code","language":"typescript","text":"interface TelemetryEvent {\n  // ... existing fields ...\n\n  // [&] provenance extension\n  ampersand?: {\n    capabilities_invoked: string[];      // [\"&memory.graph.recall\", \"&time.anomaly.detect\"]\n    routing_decision: \"fast\" | \"deliberate\";  // κ routing result\n    kappa_value?: number;                // cyclicity score if deliberation was triggered\n    goal_id?: string;                    // Graphonomous GoalGraph reference\n    provenance_hash?: string;            // hash-linked to parent invocation\n    a2a_calls?: {\n      target_agent: string;\n      skill: string;\n      duration_ms: number;\n    }[];\n  };\n}"},{"id":"blk-31098","kind":"paragraph","spans":[{"id":"spn-35149","text":"---"}]},{"id":"blk-31099","kind":"heading","level":2,"spans":[{"id":"spn-35150","text":"7) Implementation Phases"}]},{"id":"blk-31100","kind":"heading","level":3,"spans":[{"id":"spn-35151","text":"Phase 1 — Manifest Support (lowest lift, highest signal)"}]},{"id":"blk-31101","items":[{"blocks":[{"id":"blk-31103","kind":"paragraph","spans":[{"id":"spn-35152","text":"[ ] Accept "},{"id":"spn-35153","marks":["code"],"text":"ampersand.json"},{"id":"spn-35154","text":" in deployment bundles"}]}],"id":"blk-31102","kind":"list-item"},{"blocks":[{"id":"blk-31105","kind":"paragraph","spans":[{"id":"spn-35155","text":"[ ] Validate against [&] schema using "},{"id":"spn-35156","marks":["code"],"text":"@ampersand-protocol/validate"}]}],"id":"blk-31104","kind":"list-item"},{"blocks":[{"id":"blk-31107","kind":"paragraph","spans":[{"id":"spn-35157","text":"[ ] Store manifest + denormalized capabilities in "},{"id":"spn-35158","marks":["code"],"text":"agents"},{"id":"spn-35159","text":" table"}]}],"id":"blk-31106","kind":"list-item"},{"blocks":[{"id":"blk-31109","kind":"paragraph","spans":[{"id":"spn-35160","text":"[ ] Add capability filter to agent list API"}]}],"id":"blk-31108","kind":"list-item"},{"blocks":[{"id":"blk-31111","kind":"paragraph","spans":[{"id":"spn-35161","text":"[ ] Update dashboard to show declared capabilities"}]}],"id":"blk-31110","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31112","kind":"heading","level":3,"spans":[{"id":"spn-35162","text":"Phase 2 — MCP Linked Services"}]},{"id":"blk-31113","items":[{"blocks":[{"id":"blk-31115","kind":"paragraph","spans":[{"id":"spn-35163","text":"[ ] Design linked service provisioning for Cloudflare (Durable Object sidecars)"}]}],"id":"blk-31114","kind":"list-item"},{"blocks":[{"id":"blk-31117","kind":"paragraph","spans":[{"id":"spn-35164","text":"[ ] Design linked service provi