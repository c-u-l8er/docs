{"bendscript":"0.1","blocks":[{"id":"blk-49757","kind":"heading","level":1,"spans":[{"id":"spn-57826","text":"Skill 01 — The Ten Protocols"}]},{"blocks":[{"id":"blk-49759","kind":"paragraph","spans":[{"id":"spn-57827","text":"OS-001 through OS-010: what each protocol specifies, which product implements it, and the cognitive science behind it. Eight cognitive primitives plus two cross-cutting protocols (PRISM diagnostic, PULSE temporal)."}]}],"id":"blk-49758","kind":"quote"},{"id":"blk-49760","kind":"paragraph","spans":[{"id":"spn-57828","text":"---"}]},{"id":"blk-49761","kind":"heading","level":2,"spans":[{"id":"spn-57829","text":"Overview"}]},{"id":"blk-49762","kind":"paragraph","spans":[{"id":"spn-57830","text":"OpenSentience publishes ten numbered protocols organized in two layers:"}]},{"id":"blk-49763","items":[{"blocks":[{"id":"blk-49765","kind":"paragraph","spans":[{"id":"spn-57831","marks":["bold"],"text":"Cognitive primitives (OS-001 — OS-008)"},{"id":"spn-57832","text":" — eight individual capabilities,"}]}],"id":"blk-49764","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49766","kind":"paragraph","spans":[{"id":"spn-57833","text":"each grounded in a cognitive science thread."}]},{"id":"blk-49767","items":[{"blocks":[{"id":"blk-49769","kind":"paragraph","spans":[{"id":"spn-57834","marks":["bold"],"text":"Cross-cutting protocols (OS-009 PRISM, OS-010 PULSE)"},{"id":"spn-57835","text":" — two sibling"}]}],"id":"blk-49768","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49770","kind":"paragraph","spans":[{"id":"spn-57836","text":"protocols that sit above the cognitive primitives and above the [&] structural composition layer. PULSE declares how every loop in the ecosystem cycles, nests, and signals; PRISM measures how well those loops actually learn over time."}]},{"id":"blk-49771","kind":"paragraph","spans":[{"id":"spn-57837","text":"The protocols are independent specifications — they can be adopted individually or composed together. A system may publish a PULSE manifest without implementing any cognitive primitive, and PRISM can benchmark any PULSE-conforming system without bespoke per-system integration."}]},{"id":"blk-49772","kind":"paragraph","spans":[{"id":"spn-57838","text":"---"}]},{"id":"blk-49773","kind":"heading","level":2,"spans":[{"id":"spn-57839","text":"OS-001: Continual Learning"}]},{"id":"blk-49774","kind":"paragraph","spans":[{"id":"spn-57840","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57841","text":" Hippocampal consolidation (McClelland et al. 1995)"}]},{"id":"blk-49775","kind":"paragraph","spans":[{"id":"spn-57842","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49776","items":[{"blocks":[{"id":"blk-49778","kind":"paragraph","spans":[{"id":"spn-57843","text":"Three node types: episodic (events), semantic (facts), procedural (workflows)"}]}],"id":"blk-49777","kind":"list-item"},{"blocks":[{"id":"blk-49780","kind":"paragraph","spans":[{"id":"spn-57844","text":"Typed, weighted edges between nodes"}]}],"id":"blk-49779","kind":"list-item"},{"blocks":[{"id":"blk-49782","kind":"paragraph","spans":[{"id":"spn-57845","text":"Confidence scores with evidence-calibrated assignment"}]}],"id":"blk-49781","kind":"list-item"},{"blocks":[{"id":"blk-49784","kind":"paragraph","spans":[{"id":"spn-57846","text":"Consolidation cycle: decay low-confidence nodes, prune stale entries,"}]}],"id":"blk-49783","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49785","kind":"paragraph","spans":[{"id":"spn-57847","text":"merge near-duplicates, strengthen co-retrieved edges"}]},{"id":"blk-49786","items":[{"blocks":[{"id":"blk-49788","kind":"paragraph","spans":[{"id":"spn-57848","text":"Memory timescales: working memory (session), short-term (hours), long-term"}]}],"id":"blk-49787","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49789","kind":"paragraph","spans":[{"id":"spn-57849","text":"(persistent)"}]},{"id":"blk-49790","kind":"paragraph","spans":[{"id":"spn-57850","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-57851","text":" New memories must be stored quickly (hippocampal fast-write) without disrupting existing knowledge (neocortical slow-consolidation). This maps to immediate ETS/SQLite writes with background consolidation."}]},{"id":"blk-49791","kind":"paragraph","spans":[{"id":"spn-57852","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57853","text":" Graphonomous ("},{"id":"spn-57854","marks":["code"],"text":"store_node"},{"id":"spn-57855","text":", "},{"id":"spn-57856","marks":["code"],"text":"store_edge"},{"id":"spn-57857","text":", "},{"id":"spn-57858","marks":["code"],"text":"retrieve_context"},{"id":"spn-57859","text":", "},{"id":"spn-57860","marks":["code"],"text":"run_consolidation"},{"id":"spn-57861","text":")"}]},{"id":"blk-49792","kind":"paragraph","spans":[{"id":"spn-57862","text":"---"}]},{"id":"blk-49793","kind":"heading","level":2,"spans":[{"id":"spn-57863","text":"OS-002: Topological Routing (kappa)"}]},{"id":"blk-49794","kind":"paragraph","spans":[{"id":"spn-57864","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57865","text":" Working memory gating (O'Reilly & Frank 2006)"}]},{"id":"blk-49795","kind":"paragraph","spans":[{"id":"spn-57866","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49796","items":[{"blocks":[{"id":"blk-49798","kind":"paragraph","spans":[{"id":"spn-57867","text":"The kappa parameter: a measure of cyclicity in a knowledge subgraph"}]}],"id":"blk-49797","kind":"list-item"},{"blocks":[{"id":"blk-49800","kind":"paragraph","spans":[{"id":"spn-57868","text":"Strongly connected component (SCC) detection on retrieved neighborhoods"}]}],"id":"blk-49799","kind":"list-item"},{"blocks":[{"id":"blk-49802","kind":"paragraph","spans":[{"id":"spn-57869","text":"Routing decision: kappa = 0 implies fast path (acyclic, no conflict),"}]}],"id":"blk-49801","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49803","kind":"paragraph","spans":[{"id":"spn-57870","text":"kappa > 0 implies deliberate path (cycles exist, may contain contradictions)"}]},{"id":"blk-49804","items":[{"blocks":[{"id":"blk-49806","kind":"paragraph","spans":[{"id":"spn-57871","text":"Topological features: SCC count, max SCC size, edge density within cycles"}]}],"id":"blk-49805","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49807","kind":"paragraph","spans":[{"id":"spn-57872","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-57873","text":" The prefrontal cortex gates information into working memory based on relevance and conflict signals. Kappa serves as the conflict signal — cyclic knowledge regions indicate unresolved tension that requires deliberation before action."}]},{"id":"blk-49808","kind":"paragraph","spans":[{"id":"spn-57874","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57875","text":" Graphonomous routing layer ("},{"id":"spn-57876","marks":["code"],"text":"topology_analyze"},{"id":"spn-57877","text":", "},{"id":"spn-57878","marks":["code"],"text":"retrieve_context"},{"id":"spn-57879","text":" topology annotations)"}]},{"id":"blk-49809","kind":"paragraph","spans":[{"id":"spn-57880","text":"---"}]},{"id":"blk-49810","kind":"heading","level":2,"spans":[{"id":"spn-57881","text":"OS-003: Deliberation Orchestrator"}]},{"id":"blk-49811","kind":"paragraph","spans":[{"id":"spn-57882","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57883","text":" Dual-process theory (Kahneman 2011)"}]},{"id":"blk-49812","kind":"paragraph","spans":[{"id":"spn-57884","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49813","items":[{"blocks":[{"id":"blk-49815","kind":"paragraph","spans":[{"id":"spn-57885","text":"Four-phase deliberation: bid, debate, vote, commit"}]}],"id":"blk-49814","kind":"list-item"},{"blocks":[{"id":"blk-49817","kind":"paragraph","spans":[{"id":"spn-57886","text":"Argumentation framework: claims, warrants, rebuttals"}]}],"id":"blk-49816","kind":"list-item"},{"blocks":[{"id":"blk-49819","kind":"paragraph","spans":[{"id":"spn-57887","text":"Consensus mechanisms: majority, supermajority, unanimity"}]}],"id":"blk-49818","kind":"list-item"},{"blocks":[{"id":"blk-49821","kind":"paragraph","spans":[{"id":"spn-57888","text":"Timeout and escalation policies"}]}],"id":"blk-49820","kind":"list-item"},{"blocks":[{"id":"blk-49823","kind":"paragraph","spans":[{"id":"spn-57889","text":"Triggered when kappa routing indicates deliberation is needed"}]}],"id":"blk-49822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49824","kind":"paragraph","spans":[{"id":"spn-57890","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-57891","text":" System 1 (fast, automatic) handles routine decisions. System 2 (slow, deliberate) engages when conflict is detected. The kappa threshold is the trigger that shifts from fast to deliberate processing."}]},{"id":"blk-49825","kind":"paragraph","spans":[{"id":"spn-57892","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57893","text":" AgenTroMatic ("},{"id":"spn-57894","marks":["code"],"text":"deliberate"},{"id":"spn-57895","text":" tool in Graphonomous provides the single-agent deliberation path)"}]},{"id":"blk-49826","kind":"paragraph","spans":[{"id":"spn-57896","text":"---"}]},{"id":"blk-49827","kind":"heading","level":2,"spans":[{"id":"spn-57897","text":"OS-004: Attention Engine"}]},{"id":"blk-49828","kind":"paragraph","spans":[{"id":"spn-57898","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57899","text":" Endogenous attention (Desimone & Duncan 1995)"}]},{"id":"blk-49829","kind":"paragraph","spans":[{"id":"spn-57900","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49830","items":[{"blocks":[{"id":"blk-49832","kind":"paragraph","spans":[{"id":"spn-57901","text":"Three-phase cycle: survey (scan environment), triage (rank by salience),"}]}],"id":"blk-49831","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49833","kind":"paragraph","spans":[{"id":"spn-57902","text":"dispatch (act on highest-priority items)"}]},{"id":"blk-49834","items":[{"blocks":[{"id":"blk-49836","kind":"paragraph","spans":[{"id":"spn-57903","text":"Salience scoring: combines urgency, recency, goal relevance, and confidence"}]}],"id":"blk-49835","kind":"list-item"},{"blocks":[{"id":"blk-49838","kind":"paragraph","spans":[{"id":"spn-57904","text":"Goal bias: active goals increase salience of related knowledge"}]}],"id":"blk-49837","kind":"list-item"},{"blocks":[{"id":"blk-49840","kind":"paragraph","spans":[{"id":"spn-57905","text":"Dispatch modes: act (execute), learn (gather more context), escalate"}]}],"id":"blk-49839","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49841","kind":"paragraph","spans":[{"id":"spn-57906","text":"(request human intervention), idle (nothing needed)"}]},{"id":"blk-49842","kind":"paragraph","spans":[{"id":"spn-57907","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-57908","text":" Biological attention is goal-directed (endogenous) not just stimulus-driven (exogenous). The attention engine prioritizes based on the agent's active goals, not just what is new or loud."}]},{"id":"blk-49843","kind":"paragraph","spans":[{"id":"spn-57909","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57910","text":" Graphonomous attention module ("},{"id":"spn-57911","marks":["code"],"text":"attention_survey"},{"id":"spn-57912","text":", "},{"id":"spn-57913","marks":["code"],"text":"attention_run_cycle"},{"id":"spn-57914","text":")"}]},{"id":"blk-49844","kind":"paragraph","spans":[{"id":"spn-57915","text":"---"}]},{"id":"blk-49845","kind":"heading","level":2,"spans":[{"id":"spn-57916","text":"OS-005: Model Tier Adaptation"}]},{"id":"blk-49846","kind":"paragraph","spans":[{"id":"spn-57917","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57918","text":" Resource rationality (Lieder & Griffiths 2020)"}]},{"id":"blk-49847","kind":"paragraph","spans":[{"id":"spn-57919","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49848","items":[{"blocks":[{"id":"blk-49850","kind":"paragraph","spans":[{"id":"spn-57920","text":"Three tiers: "},{"id":"spn-57921","marks":["code"],"text":"local_small"},{"id":"spn-57922","text":" (8B parameter models), "},{"id":"spn-57923","marks":["code"],"text":"local_large"},{"id":"spn-57924","text":" (70B+),"}]}],"id":"blk-49849","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49851","kind":"paragraph","spans":[{"id":"spn-57925","marks":["code"],"text":"cloud_frontier"},{"id":"spn-57926","text":" (largest available)"}]},{"id":"blk-49852","items":[{"blocks":[{"id":"blk-49854","kind":"paragraph","spans":[{"id":"spn-57927","text":"Same topology and tool surface at every tier — only depth and latency differ"}]}],"id":"blk-49853","kind":"list-item"},{"blocks":[{"id":"blk-49856","kind":"paragraph","spans":[{"id":"spn-57928","text":"Escalation rules: when local_small confidence is below threshold, escalate"}]}],"id":"blk-49855","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49857","kind":"paragraph","spans":[{"id":"spn-57929","text":"to local_large; when local_large is insufficient, escalate to cloud_frontier"}]},{"id":"blk-49858","items":[{"blocks":[{"id":"blk-49860","kind":"paragraph","spans":[{"id":"spn-57930","text":"Budget constraints: token limits, latency targets, cost caps per tier"}]}],"id":"blk-49859","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49861","kind":"paragraph","spans":[{"id":"spn-57931","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-57932","text":" Optimal cognition allocates computational resources proportional to decision importance. Simple decisions use fast/cheap processing; high-stakes decisions justify expensive computation."}]},{"id":"blk-49862","kind":"paragraph","spans":[{"id":"spn-57933","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57934","text":" Graphonomous and Agentelic (tier selection and escalation logic)"}]},{"id":"blk-49863","kind":"paragraph","spans":[{"id":"spn-57935","text":"---"}]},{"id":"blk-49864","kind":"heading","level":2,"spans":[{"id":"spn-57936","text":"OS-006: Agent Governance Shim"}]},{"id":"blk-49865","kind":"paragraph","spans":[{"id":"spn-57937","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57938","text":" Executive function (Miyake et al. 2000)"}]},{"id":"blk-49866","kind":"paragraph","spans":[{"id":"spn-57939","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49867","items":[{"blocks":[{"id":"blk-49869","kind":"paragraph","spans":[{"id":"spn-57940","text":"Permission taxonomy: filesystem, network, tool_invocation, graph_access"}]}],"id":"blk-49868","kind":"list-item"},{"blocks":[{"id":"blk-49871","kind":"paragraph","spans":[{"id":"spn-57941","text":"Lifecycle state machine: installed, enabled, running, disabled, removed"}]}],"id":"blk-49870","kind":"list-item"},{"blocks":[{"id":"blk-49873","kind":"paragraph","spans":[{"id":"spn-57942","text":"Graduated autonomy: observe, advise, act"}]}],"id":"blk-49872","kind":"list-item"},{"blocks":[{"id":"blk-49875","kind":"paragraph","spans":[{"id":"spn-57943","text":"Append-only audit trail with typed events"}]}],"id":"blk-49874","kind":"list-item"},{"blocks":[{"id":"blk-49877","kind":"paragraph","spans":[{"id":"spn-57944","text":"OTP-native implementation: GenStateMachine, ETS, DynamicSupervisor"}]}],"id":"blk-49876","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49878","kind":"paragraph","spans":[{"id":"spn-57945","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-57946","text":" Executive function provides inhibitory control (permissions), task switching (lifecycle), and cognitive flexibility (autonomy levels). Without executive function, an agent cannot self-regulate — it either does nothing or does everything."}]},{"id":"blk-49879","kind":"paragraph","spans":[{"id":"spn-57947","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57948","text":" "},{"id":"spn-57949","marks":["code"],"text":"open_sentience"},{"id":"spn-57950","text":" hex package (this project)"}]},{"id":"blk-49880","kind":"paragraph","spans":[{"id":"spn-57951","text":"---"}]},{"id":"blk-49881","kind":"heading","level":2,"spans":[{"id":"spn-57952","text":"OS-007: Adversarial Robustness"}]},{"id":"blk-49882","kind":"paragraph","spans":[{"id":"spn-57953","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57954","text":" Immune system — self/non-self discrimination"}]},{"id":"blk-49883","kind":"paragraph","spans":[{"id":"spn-57955","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49884","items":[{"blocks":[{"id":"blk-49886","kind":"paragraph","spans":[{"id":"spn-57956","text":"Five threat categories: prompt injection, model poisoning, side-channel,"}]}],"id":"blk-49885","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49887","kind":"paragraph","spans":[{"id":"spn-57957","text":"identity spoofing, resource exhaustion"}]},{"id":"blk-49888","items":[{"blocks":[{"id":"blk-49890","kind":"paragraph","spans":[{"id":"spn-57958","text":"Detection rules per category"}]}],"id":"blk-49889","kind":"list-item"},{"blocks":[{"id":"blk-49892","kind":"paragraph","spans":[{"id":"spn-57959","text":"Defense protocols: quarantine, circuit-break, escalate"}]}],"id":"blk-49891","kind":"list-item"},{"blocks":[{"id":"blk-49894","kind":"paragraph","spans":[{"id":"spn-57960","text":"Integration with OS-006 for permission revocation and OS-008 for circuit"}]}],"id":"blk-49893","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49895","kind":"paragraph","spans":[{"id":"spn-57961","text":"breaking"}]},{"id":"blk-49896","kind":"paragraph","spans":[{"id":"spn-57962","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57963","text":" OpenSentience security module (draft)"}]},{"id":"blk-49897","kind":"paragraph","spans":[{"id":"spn-57964","text":"---"}]},{"id":"blk-49898","kind":"heading","level":2,"spans":[{"id":"spn-57965","text":"OS-008: Agent Harness"}]},{"id":"blk-49899","kind":"paragraph","spans":[{"id":"spn-57966","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57967","text":" Supervisory attentional system (Norman & Shallice 1986)"}]},{"id":"blk-49900","kind":"paragraph","spans":[{"id":"spn-57968","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49901","items":[{"blocks":[{"id":"blk-49903","kind":"paragraph","spans":[{"id":"spn-57969","text":"Pipeline ordering enforcement (retrieve → route → act → learn)"}]}],"id":"blk-49902","kind":"list-item"},{"blocks":[{"id":"blk-49905","kind":"paragraph","spans":[{"id":"spn-57970","text":"Quality gates between pipeline stages"}]}],"id":"blk-49904","kind":"list-item"},{"blocks":[{"id":"blk-49907","kind":"paragraph","spans":[{"id":"spn-57971","text":"Sprint contracts: bounded execution with explicit goals and success criteria"}]}],"id":"blk-49906","kind":"list-item"},{"blocks":[{"id":"blk-49909","kind":"paragraph","spans":[{"id":"spn-57972","text":"Context management: 60% threshold, compaction, Graphonomous overflow"}]}],"id":"blk-49908","kind":"list-item"},{"blocks":[{"id":"blk-49911","kind":"paragraph","spans":[{"id":"spn-57973","text":"Generator-evaluator separation for adversarial grading"}]}],"id":"blk-49910","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49912","kind":"paragraph","spans":[{"id":"spn-57974","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57975","text":" OpenSentience harness module (draft)"}]},{"id":"blk-49913","kind":"paragraph","spans":[{"id":"spn-57976","text":"---"}]},{"id":"blk-49914","kind":"heading","level":2,"spans":[{"id":"spn-57977","text":"OS-009: PRISM — Protocol for Rating Iterative System Memory"}]},{"id":"blk-49915","kind":"paragraph","spans":[{"id":"spn-57978","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-57979","text":" Meta-cognition + psychometrics (Item Response Theory, signal detection theory)"}]},{"id":"bl