{"bendscript":"0.1","blocks":[{"id":"blk-48785","kind":"heading","level":1,"spans":[{"id":"spn-55532","text":"Skill 01 — The Ten Protocols"}]},{"blocks":[{"id":"blk-48787","kind":"paragraph","spans":[{"id":"spn-55533","text":"OS-001 through OS-010: what each protocol specifies, which product implements it, and the cognitive science behind it. Eight cognitive primitives plus two cross-cutting protocols (PRISM diagnostic, PULSE temporal)."}]}],"id":"blk-48786","kind":"quote"},{"id":"blk-48788","kind":"paragraph","spans":[{"id":"spn-55534","text":"---"}]},{"id":"blk-48789","kind":"heading","level":2,"spans":[{"id":"spn-55535","text":"Overview"}]},{"id":"blk-48790","kind":"paragraph","spans":[{"id":"spn-55536","text":"OpenSentience publishes ten numbered protocols organized in two layers:"}]},{"id":"blk-48791","items":[{"blocks":[{"id":"blk-48793","kind":"paragraph","spans":[{"id":"spn-55537","marks":["bold"],"text":"Cognitive primitives (OS-001 — OS-008)"},{"id":"spn-55538","text":" — eight individual capabilities,"}]}],"id":"blk-48792","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48794","kind":"paragraph","spans":[{"id":"spn-55539","text":"each grounded in a cognitive science thread."}]},{"id":"blk-48795","items":[{"blocks":[{"id":"blk-48797","kind":"paragraph","spans":[{"id":"spn-55540","marks":["bold"],"text":"Cross-cutting protocols (OS-009 PRISM, OS-010 PULSE)"},{"id":"spn-55541","text":" — two sibling"}]}],"id":"blk-48796","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48798","kind":"paragraph","spans":[{"id":"spn-55542","text":"protocols that sit above the cognitive primitives and above the [&] structural composition layer. PULSE declares how every loop in the ecosystem cycles, nests, and signals; PRISM measures how well those loops actually learn over time."}]},{"id":"blk-48799","kind":"paragraph","spans":[{"id":"spn-55543","text":"The protocols are independent specifications — they can be adopted individually or composed together. A system may publish a PULSE manifest without implementing any cognitive primitive, and PRISM can benchmark any PULSE-conforming system without bespoke per-system integration."}]},{"id":"blk-48800","kind":"paragraph","spans":[{"id":"spn-55544","text":"---"}]},{"id":"blk-48801","kind":"heading","level":2,"spans":[{"id":"spn-55545","text":"OS-001: Continual Learning"}]},{"id":"blk-48802","kind":"paragraph","spans":[{"id":"spn-55546","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55547","text":" Hippocampal consolidation (McClelland et al. 1995)"}]},{"id":"blk-48803","kind":"paragraph","spans":[{"id":"spn-55548","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48804","items":[{"blocks":[{"id":"blk-48806","kind":"paragraph","spans":[{"id":"spn-55549","text":"Three node types: episodic (events), semantic (facts), procedural (workflows)"}]}],"id":"blk-48805","kind":"list-item"},{"blocks":[{"id":"blk-48808","kind":"paragraph","spans":[{"id":"spn-55550","text":"Typed, weighted edges between nodes"}]}],"id":"blk-48807","kind":"list-item"},{"blocks":[{"id":"blk-48810","kind":"paragraph","spans":[{"id":"spn-55551","text":"Confidence scores with evidence-calibrated assignment"}]}],"id":"blk-48809","kind":"list-item"},{"blocks":[{"id":"blk-48812","kind":"paragraph","spans":[{"id":"spn-55552","text":"Consolidation cycle: decay low-confidence nodes, prune stale entries,"}]}],"id":"blk-48811","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48813","kind":"paragraph","spans":[{"id":"spn-55553","text":"merge near-duplicates, strengthen co-retrieved edges"}]},{"id":"blk-48814","items":[{"blocks":[{"id":"blk-48816","kind":"paragraph","spans":[{"id":"spn-55554","text":"Memory timescales: working memory (session), short-term (hours), long-term"}]}],"id":"blk-48815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48817","kind":"paragraph","spans":[{"id":"spn-55555","text":"(persistent)"}]},{"id":"blk-48818","kind":"paragraph","spans":[{"id":"spn-55556","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55557","text":" New memories must be stored quickly (hippocampal fast-write) without disrupting existing knowledge (neocortical slow-consolidation). This maps to immediate ETS/SQLite writes with background consolidation."}]},{"id":"blk-48819","kind":"paragraph","spans":[{"id":"spn-55558","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55559","text":" Graphonomous ("},{"id":"spn-55560","marks":["code"],"text":"store_node"},{"id":"spn-55561","text":", "},{"id":"spn-55562","marks":["code"],"text":"store_edge"},{"id":"spn-55563","text":", "},{"id":"spn-55564","marks":["code"],"text":"retrieve_context"},{"id":"spn-55565","text":", "},{"id":"spn-55566","marks":["code"],"text":"run_consolidation"},{"id":"spn-55567","text":")"}]},{"id":"blk-48820","kind":"paragraph","spans":[{"id":"spn-55568","text":"---"}]},{"id":"blk-48821","kind":"heading","level":2,"spans":[{"id":"spn-55569","text":"OS-002: Topological Routing (kappa)"}]},{"id":"blk-48822","kind":"paragraph","spans":[{"id":"spn-55570","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55571","text":" Working memory gating (O'Reilly & Frank 2006)"}]},{"id":"blk-48823","kind":"paragraph","spans":[{"id":"spn-55572","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48824","items":[{"blocks":[{"id":"blk-48826","kind":"paragraph","spans":[{"id":"spn-55573","text":"The kappa parameter: a measure of cyclicity in a knowledge subgraph"}]}],"id":"blk-48825","kind":"list-item"},{"blocks":[{"id":"blk-48828","kind":"paragraph","spans":[{"id":"spn-55574","text":"Strongly connected component (SCC) detection on retrieved neighborhoods"}]}],"id":"blk-48827","kind":"list-item"},{"blocks":[{"id":"blk-48830","kind":"paragraph","spans":[{"id":"spn-55575","text":"Routing decision: kappa = 0 implies fast path (acyclic, no conflict),"}]}],"id":"blk-48829","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48831","kind":"paragraph","spans":[{"id":"spn-55576","text":"kappa > 0 implies deliberate path (cycles exist, may contain contradictions)"}]},{"id":"blk-48832","items":[{"blocks":[{"id":"blk-48834","kind":"paragraph","spans":[{"id":"spn-55577","text":"Topological features: SCC count, max SCC size, edge density within cycles"}]}],"id":"blk-48833","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48835","kind":"paragraph","spans":[{"id":"spn-55578","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55579","text":" The prefrontal cortex gates information into working memory based on relevance and conflict signals. Kappa serves as the conflict signal — cyclic knowledge regions indicate unresolved tension that requires deliberation before action."}]},{"id":"blk-48836","kind":"paragraph","spans":[{"id":"spn-55580","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55581","text":" Graphonomous routing layer ("},{"id":"spn-55582","marks":["code"],"text":"topology_analyze"},{"id":"spn-55583","text":", "},{"id":"spn-55584","marks":["code"],"text":"retrieve_context"},{"id":"spn-55585","text":" topology annotations)"}]},{"id":"blk-48837","kind":"paragraph","spans":[{"id":"spn-55586","text":"---"}]},{"id":"blk-48838","kind":"heading","level":2,"spans":[{"id":"spn-55587","text":"OS-003: Deliberation Orchestrator"}]},{"id":"blk-48839","kind":"paragraph","spans":[{"id":"spn-55588","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55589","text":" Dual-process theory (Kahneman 2011)"}]},{"id":"blk-48840","kind":"paragraph","spans":[{"id":"spn-55590","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48841","items":[{"blocks":[{"id":"blk-48843","kind":"paragraph","spans":[{"id":"spn-55591","text":"Four-phase deliberation: bid, debate, vote, commit"}]}],"id":"blk-48842","kind":"list-item"},{"blocks":[{"id":"blk-48845","kind":"paragraph","spans":[{"id":"spn-55592","text":"Argumentation framework: claims, warrants, rebuttals"}]}],"id":"blk-48844","kind":"list-item"},{"blocks":[{"id":"blk-48847","kind":"paragraph","spans":[{"id":"spn-55593","text":"Consensus mechanisms: majority, supermajority, unanimity"}]}],"id":"blk-48846","kind":"list-item"},{"blocks":[{"id":"blk-48849","kind":"paragraph","spans":[{"id":"spn-55594","text":"Timeout and escalation policies"}]}],"id":"blk-48848","kind":"list-item"},{"blocks":[{"id":"blk-48851","kind":"paragraph","spans":[{"id":"spn-55595","text":"Triggered when kappa routing indicates deliberation is needed"}]}],"id":"blk-48850","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48852","kind":"paragraph","spans":[{"id":"spn-55596","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55597","text":" System 1 (fast, automatic) handles routine decisions. System 2 (slow, deliberate) engages when conflict is detected. The kappa threshold is the trigger that shifts from fast to deliberate processing."}]},{"id":"blk-48853","kind":"paragraph","spans":[{"id":"spn-55598","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55599","text":" AgenTroMatic ("},{"id":"spn-55600","marks":["code"],"text":"deliberate"},{"id":"spn-55601","text":" tool in Graphonomous provides the single-agent deliberation path)"}]},{"id":"blk-48854","kind":"paragraph","spans":[{"id":"spn-55602","text":"---"}]},{"id":"blk-48855","kind":"heading","level":2,"spans":[{"id":"spn-55603","text":"OS-004: Attention Engine"}]},{"id":"blk-48856","kind":"paragraph","spans":[{"id":"spn-55604","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55605","text":" Endogenous attention (Desimone & Duncan 1995)"}]},{"id":"blk-48857","kind":"paragraph","spans":[{"id":"spn-55606","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48858","items":[{"blocks":[{"id":"blk-48860","kind":"paragraph","spans":[{"id":"spn-55607","text":"Three-phase cycle: survey (scan environment), triage (rank by salience),"}]}],"id":"blk-48859","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48861","kind":"paragraph","spans":[{"id":"spn-55608","text":"dispatch (act on highest-priority items)"}]},{"id":"blk-48862","items":[{"blocks":[{"id":"blk-48864","kind":"paragraph","spans":[{"id":"spn-55609","text":"Salience scoring: combines urgency, recency, goal relevance, and confidence"}]}],"id":"blk-48863","kind":"list-item"},{"blocks":[{"id":"blk-48866","kind":"paragraph","spans":[{"id":"spn-55610","text":"Goal bias: active goals increase salience of related knowledge"}]}],"id":"blk-48865","kind":"list-item"},{"blocks":[{"id":"blk-48868","kind":"paragraph","spans":[{"id":"spn-55611","text":"Dispatch modes: act (execute), learn (gather more context), escalate"}]}],"id":"blk-48867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48869","kind":"paragraph","spans":[{"id":"spn-55612","text":"(request human intervention), idle (nothing needed)"}]},{"id":"blk-48870","kind":"paragraph","spans":[{"id":"spn-55613","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55614","text":" Biological attention is goal-directed (endogenous) not just stimulus-driven (exogenous). The attention engine prioritizes based on the agent's active goals, not just what is new or loud."}]},{"id":"blk-48871","kind":"paragraph","spans":[{"id":"spn-55615","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55616","text":" Graphonomous attention module ("},{"id":"spn-55617","marks":["code"],"text":"attention_survey"},{"id":"spn-55618","text":", "},{"id":"spn-55619","marks":["code"],"text":"attention_run_cycle"},{"id":"spn-55620","text":")"}]},{"id":"blk-48872","kind":"paragraph","spans":[{"id":"spn-55621","text":"---"}]},{"id":"blk-48873","kind":"heading","level":2,"spans":[{"id":"spn-55622","text":"OS-005: Model Tier Adaptation"}]},{"id":"blk-48874","kind":"paragraph","spans":[{"id":"spn-55623","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55624","text":" Resource rationality (Lieder & Griffiths 2020)"}]},{"id":"blk-48875","kind":"paragraph","spans":[{"id":"spn-55625","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48876","items":[{"blocks":[{"id":"blk-48878","kind":"paragraph","spans":[{"id":"spn-55626","text":"Three tiers: "},{"id":"spn-55627","marks":["code"],"text":"local_small"},{"id":"spn-55628","text":" (8B parameter models), "},{"id":"spn-55629","marks":["code"],"text":"local_large"},{"id":"spn-55630","text":" (70B+),"}]}],"id":"blk-48877","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48879","kind":"paragraph","spans":[{"id":"spn-55631","marks":["code"],"text":"cloud_frontier"},{"id":"spn-55632","text":" (largest available)"}]},{"id":"blk-48880","items":[{"blocks":[{"id":"blk-48882","kind":"paragraph","spans":[{"id":"spn-55633","text":"Same topology and tool surface at every tier — only depth and latency differ"}]}],"id":"blk-48881","kind":"list-item"},{"blocks":[{"id":"blk-48884","kind":"paragraph","spans":[{"id":"spn-55634","text":"Escalation rules: when local_small confidence is below threshold, escalate"}]}],"id":"blk-48883","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48885","kind":"paragraph","spans":[{"id":"spn-55635","text":"to local_large; when local_large is insufficient, escalate to cloud_frontier"}]},{"id":"blk-48886","items":[{"blocks":[{"id":"blk-48888","kind":"paragraph","spans":[{"id":"spn-55636","text":"Budget constraints: token limits, latency targets, cost caps per tier"}]}],"id":"blk-48887","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48889","kind":"paragraph","spans":[{"id":"spn-55637","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55638","text":" Optimal cognition allocates computational resources proportional to decision importance. Simple decisions use fast/cheap processing; high-stakes decisions justify expensive computation."}]},{"id":"blk-48890","kind":"paragraph","spans":[{"id":"spn-55639","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55640","text":" Graphonomous and Agentelic (tier selection and escalation logic)"}]},{"id":"blk-48891","kind":"paragraph","spans":[{"id":"spn-55641","text":"---"}]},{"id":"blk-48892","kind":"heading","level":2,"spans":[{"id":"spn-55642","text":"OS-006: Agent Governance Shim"}]},{"id":"blk-48893","kind":"paragraph","spans":[{"id":"spn-55643","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55644","text":" Executive function (Miyake et al. 2000)"}]},{"id":"blk-48894","kind":"paragraph","spans":[{"id":"spn-55645","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48895","items":[{"blocks":[{"id":"blk-48897","kind":"paragraph","spans":[{"id":"spn-55646","text":"Permission taxonomy: filesystem, network, tool_invocation, graph_access"}]}],"id":"blk-48896","kind":"list-item"},{"blocks":[{"id":"blk-48899","kind":"paragraph","spans":[{"id":"spn-55647","text":"Lifecycle state machine: installed, enabled, running, disabled, removed"}]}],"id":"blk-48898","kind":"list-item"},{"blocks":[{"id":"blk-48901","kind":"paragraph","spans":[{"id":"spn-55648","text":"Graduated autonomy: observe, advise, act"}]}],"id":"blk-48900","kind":"list-item"},{"blocks":[{"id":"blk-48903","kind":"paragraph","spans":[{"id":"spn-55649","text":"Append-only audit trail with typed events"}]}],"id":"blk-48902","kind":"list-item"},{"blocks":[{"id":"blk-48905","kind":"paragraph","spans":[{"id":"spn-55650","text":"OTP-native implementation: GenStateMachine, ETS, DynamicSupervisor"}]}],"id":"blk-48904","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48906","kind":"paragraph","spans":[{"id":"spn-55651","marks":["bold"],"text":"Design constraint from cognitive science:"},{"id":"spn-55652","text":" Executive function provides inhibitory control (permissions), task switching (lifecycle), and cognitive flexibility (autonomy levels). Without executive function, an agent cannot self-regulate — it either does nothing or does everything."}]},{"id":"blk-48907","kind":"paragraph","spans":[{"id":"spn-55653","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55654","text":" "},{"id":"spn-55655","marks":["code"],"text":"open_sentience"},{"id":"spn-55656","text":" hex package (this project)"}]},{"id":"blk-48908","kind":"paragraph","spans":[{"id":"spn-55657","text":"---"}]},{"id":"blk-48909","kind":"heading","level":2,"spans":[{"id":"spn-55658","text":"OS-007: Adversarial Robustness"}]},{"id":"blk-48910","kind":"paragraph","spans":[{"id":"spn-55659","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55660","text":" Immune system — self/non-self discrimination"}]},{"id":"blk-48911","kind":"paragraph","spans":[{"id":"spn-55661","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48912","items":[{"blocks":[{"id":"blk-48914","kind":"paragraph","spans":[{"id":"spn-55662","text":"Five threat categories: prompt injection, model poisoning, side-channel,"}]}],"id":"blk-48913","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48915","kind":"paragraph","spans":[{"id":"spn-55663","text":"identity spoofing, resource exhaustion"}]},{"id":"blk-48916","items":[{"blocks":[{"id":"blk-48918","kind":"paragraph","spans":[{"id":"spn-55664","text":"Detection rules per category"}]}],"id":"blk-48917","kind":"list-item"},{"blocks":[{"id":"blk-48920","kind":"paragraph","spans":[{"id":"spn-55665","text":"Defense protocols: quarantine, circuit-break, escalate"}]}],"id":"blk-48919","kind":"list-item"},{"blocks":[{"id":"blk-48922","kind":"paragraph","spans":[{"id":"spn-55666","text":"Integration with OS-006 for permission revocation and OS-008 for circuit"}]}],"id":"blk-48921","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48923","kind":"paragraph","spans":[{"id":"spn-55667","text":"breaking"}]},{"id":"blk-48924","kind":"paragraph","spans":[{"id":"spn-55668","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55669","text":" OpenSentience security module (draft)"}]},{"id":"blk-48925","kind":"paragraph","spans":[{"id":"spn-55670","text":"---"}]},{"id":"blk-48926","kind":"heading","level":2,"spans":[{"id":"spn-55671","text":"OS-008: Agent Harness"}]},{"id":"blk-48927","kind":"paragraph","spans":[{"id":"spn-55672","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55673","text":" Supervisory attentional system (Norman & Shallice 1986)"}]},{"id":"blk-48928","kind":"paragraph","spans":[{"id":"spn-55674","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48929","items":[{"blocks":[{"id":"blk-48931","kind":"paragraph","spans":[{"id":"spn-55675","text":"Pipeline ordering enforcement (retrieve → route → act → learn)"}]}],"id":"blk-48930","kind":"list-item"},{"blocks":[{"id":"blk-48933","kind":"paragraph","spans":[{"id":"spn-55676","text":"Quality gates between pipeline stages"}]}],"id":"blk-48932","kind":"list-item"},{"blocks":[{"id":"blk-48935","kind":"paragraph","spans":[{"id":"spn-55677","text":"Sprint contracts: bounded execution with explicit goals and success criteria"}]}],"id":"blk-48934","kind":"list-item"},{"blocks":[{"id":"blk-48937","kind":"paragraph","spans":[{"id":"spn-55678","text":"Context management: 60% threshold, compaction, Graphonomous overflow"}]}],"id":"blk-48936","kind":"list-item"},{"blocks":[{"id":"blk-48939","kind":"paragraph","spans":[{"id":"spn-55679","text":"Generator-evaluator separation for adversarial grading"}]}],"id":"blk-48938","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-48940","kind":"paragraph","spans":[{"id":"spn-55680","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55681","text":" OpenSentience harness module (draft)"}]},{"id":"blk-48941","kind":"paragraph","spans":[{"id":"spn-55682","text":"---"}]},{"id":"blk-48942","kind":"heading","level":2,"spans":[{"id":"spn-55683","text":"OS-009: PRISM — Protocol for Rating Iterative System Memory"}]},{"id":"blk-48943","kind":"paragraph","spans":[{"id":"spn-55684","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55685","text":" Meta-cognition + psychometrics (Item Response Theory, signal detection theory)"}]},{"id":"bl