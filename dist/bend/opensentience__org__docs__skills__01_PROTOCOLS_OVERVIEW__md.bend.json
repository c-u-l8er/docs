aragraph","spans":[{"id":"spn-57995","marks":["bold"],"text":"Design constraint:"},{"id":"spn-57996","text":" A diagnostic that measures *learning over time* must itself be a closed loop — it must reflect on its own scenarios and evolve them based on what the inner loop fails on. Hence the 4-phase evaluation structure."}]},{"id":"blk-49936","kind":"paragraph","spans":[{"id":"spn-57997","marks":["bold"],"text":"Implemented by:"},{"id":"spn-57998","text":" "},{"id":"spn-57999","marks":["code"],"text":"/PRISM/"},{"id":"spn-58000","text":" Elixir/OTP codebase, Fly.io, 6 MCP machines ("},{"id":"spn-58001","marks":["code"],"text":"compose"},{"id":"spn-58002","text":", "},{"id":"spn-58003","marks":["code"],"text":"interact"},{"id":"spn-58004","text":", "},{"id":"spn-58005","marks":["code"],"text":"observe"},{"id":"spn-58006","text":", "},{"id":"spn-58007","marks":["code"],"text":"reflect"},{"id":"spn-58008","text":", "},{"id":"spn-58009","marks":["code"],"text":"diagnose"},{"id":"spn-58010","text":", "},{"id":"spn-58011","marks":["code"],"text":"config"},{"id":"spn-58012","text":"), "},{"id":"spn-58013","marks":[{"kind":"link","predicate":"cites","target":"https://prism.opensentience.org"}],"text":"prism.opensentience.org"}]},{"id":"blk-49937","kind":"paragraph","spans":[{"id":"spn-58014","text":"---"}]},{"id":"blk-49938","kind":"heading","level":2,"spans":[{"id":"spn-58015","text":"OS-010: PULSE — Protocol for Uniform Loop State Exchange"}]},{"id":"blk-49939","kind":"paragraph","spans":[{"id":"spn-58016","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-58017","text":" Closed-loop control theory (Wiener cybernetics 1948) + temporal cognition (Allen interval algebra 1983)"}]},{"id":"blk-49940","kind":"paragraph","spans":[{"id":"spn-58018","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-49941","items":[{"blocks":[{"id":"blk-49943","kind":"paragraph","spans":[{"id":"spn-58019","text":"Loop manifest schema (JSON Schema): "},{"id":"spn-58020","marks":["code"],"