aragraph","spans":[{"id":"spn-55701","marks":["bold"],"text":"Design constraint:"},{"id":"spn-55702","text":" A diagnostic that measures *learning over time* must itself be a closed loop — it must reflect on its own scenarios and evolve them based on what the inner loop fails on. Hence the 4-phase evaluation structure."}]},{"id":"blk-48964","kind":"paragraph","spans":[{"id":"spn-55703","marks":["bold"],"text":"Implemented by:"},{"id":"spn-55704","text":" "},{"id":"spn-55705","marks":["code"],"text":"/PRISM/"},{"id":"spn-55706","text":" Elixir/OTP codebase, Fly.io, 6 MCP machines ("},{"id":"spn-55707","marks":["code"],"text":"compose"},{"id":"spn-55708","text":", "},{"id":"spn-55709","marks":["code"],"text":"interact"},{"id":"spn-55710","text":", "},{"id":"spn-55711","marks":["code"],"text":"observe"},{"id":"spn-55712","text":", "},{"id":"spn-55713","marks":["code"],"text":"reflect"},{"id":"spn-55714","text":", "},{"id":"spn-55715","marks":["code"],"text":"diagnose"},{"id":"spn-55716","text":", "},{"id":"spn-55717","marks":["code"],"text":"config"},{"id":"spn-55718","text":"), "},{"id":"spn-55719","marks":[{"kind":"link","predicate":"cites","target":"https://prism.opensentience.org"}],"text":"prism.opensentience.org"}]},{"id":"blk-48965","kind":"paragraph","spans":[{"id":"spn-55720","text":"---"}]},{"id":"blk-48966","kind":"heading","level":2,"spans":[{"id":"spn-55721","text":"OS-010: PULSE — Protocol for Uniform Loop State Exchange"}]},{"id":"blk-48967","kind":"paragraph","spans":[{"id":"spn-55722","marks":["bold"],"text":"Cognitive basis:"},{"id":"spn-55723","text":" Closed-loop control theory (Wiener cybernetics 1948) + temporal cognition (Allen interval algebra 1983)"}]},{"id":"blk-48968","kind":"paragraph","spans":[{"id":"spn-55724","marks":["bold"],"text":"What it specifies:"}]},{"id":"blk-48969","items":[{"blocks":[{"id":"blk-48971","kind":"paragraph","spans":[{"id":"spn-55725","text":"Loop manifest schema (JSON Schema): "},{"id":"spn-55726","marks":["code"],"