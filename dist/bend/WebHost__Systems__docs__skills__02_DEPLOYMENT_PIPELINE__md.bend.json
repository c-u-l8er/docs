{"bendscript":"0.1","blocks":[{"id":"blk-25090","kind":"heading","level":1,"spans":[{"id":"spn-30368","text":"02 — Deployment Pipeline"}]},{"blocks":[{"id":"blk-25092","kind":"paragraph","spans":[{"id":"spn-30369","marks":["bold"],"text":"Purpose:"},{"id":"spn-30370","text":" How bundles are uploaded, validated, and deployed to runtime providers. Covers the immutable deployment model, version monotonicity, rollback mechanics, and the AgentCore container build pipeline."}]}],"id":"blk-25091","kind":"quote"},{"id":"blk-25093","kind":"paragraph","spans":[{"id":"spn-30371","text":"---"}]},{"id":"blk-25094","kind":"heading","level":2,"spans":[{"id":"spn-30372","text":"Deployment Model"}]},{"id":"blk-25095","kind":"paragraph","spans":[{"id":"spn-30373","text":"Deployments are "},{"id":"spn-30374","marks":["bold"],"text":"immutable records"},{"id":"spn-30375","text":". Once created, a deployment's artifact, version, and configuration never change. Only "},{"id":"spn-30376","marks":["code"],"text":"status"},{"id":"spn-30377","text":" and "},{"id":"spn-30378","marks":["code"],"text":"error_message"},{"id":"spn-30379","text":" are updated during the lifecycle. Rollback works by switching the agent's "},{"id":"spn-30380","marks":["code"],"text":"active_deployment_id"},{"id":"spn-30381","text":" pointer -- not by modifying old deployments."}]},{"id":"blk-25096","kind":"paragraph","spans":[{"id":"spn-30382","text":"---"}]},{"id":"blk-25097","kind":"heading","level":2,"spans":[{"id":"spn-30383","text":"Deployment Fields"}]},{"head":[{"id":"blk-25099","spans":[{"id":"spn-30384","text":"Field"}]},{"id":"blk-25100","spans":[{"id":"spn-30385","text":"Type"}]},{"id":"blk-25101","spans":[{"id":"spn-30386","text":"Description"}]}],"id":"blk-25098","kind":"table","rows":[[{"id":"blk-25102","spans":[{"id":"spn-30387","marks":["code"],"text":"id"}]},{"id":"blk-25103","spans":[{"id":"spn-30388","text":"UUID"}]},{"id":"blk-25104","spans":[{"id":"spn-30389","text":"Immutable deployment identifier"}]}],[{"id":"blk-25105","spans":[{"id":"spn-30390","marks":["code"],"text":"agent_id"}]},{"id":"blk-25106","spans":[{"id":"spn-30391","text":"UUID"}]},{"id":"blk-25107","spans":[{"id":"spn-30392","text":"Parent agent"}]}],[{"id":"blk-25108","spans":[{"id":"spn-30393","marks":["code"],"text":"version"}]},{"id":"blk-25109","spans":[{"id":"spn-30394","text":"int"}]},{"id":"blk-25110","spans":[{"id":"spn-30395","text":"Monotonically increasing per agent"}]}],[{"id":"blk-25111","spans":[{"id":"spn-30396","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-25112","spans":[{"id":"spn-30397","text":"enum"}]},{"id":"blk-25113","spans":[{"id":"spn-30398","marks":["code"],"text":"cloudflare"},{"id":"spn-30399","text":" or "},{"id":"spn-30400","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-25114","spans":[{"id":"spn-30401","marks":["code"],"text":"status"}]},{"id":"blk-25115","spans":[{"id":"spn-30402","text":"enum"}]},{"id":"blk-25116","spans":[{"id":"spn-30403","marks":["code"],"text":"deploying"},{"id":"spn-30404","text":" / "},{"id":"spn-30405","marks":["code"],"text":"active"},{"id":"spn-30406","text":" / "},{"id":"spn-30407","marks":["code"],"text":"failed"},{"id":"spn-30408","text":" / "},{"id":"spn-30409","marks":["code"],"text":"rolled_back"}]}],[{"id":"blk-25117","spans":[{"id":"spn-30410","marks":["code"],"text":"artifact"}]},{"id":"blk-25118","spans":[{"id":"spn-30411","text":"JSONB"}]},{"id":"blk-25119","spans":[{"id":"spn-30412","text":"Upload reference (checksum, size)"}]}],[{"id":"blk-25120","spans":[{"id":"spn-30413","marks":["code"],"text":"provider_ref"}]},{"id":"blk-25121","spans":[{"id":"spn-30414","text":"JSONB"}]},{"id":"blk-25122","spans":[{"id":"spn-30415","text":"Provider-specific deployment reference"}]}],[{"id":"blk-25123","spans":[{"id":"spn-30416","marks":["code"],"text":"commit_hash"}]},{"id":"blk-25124","spans":[{"id":"spn-30417","text":"string?"}]},{"id":"blk-25125","spans":[{"id":"spn-30418","text":"Optional git commit"}]}],[{"id":"blk-25126","spans":[{"id":"spn-30419","marks":["code"],"text":"error_message"}]},{"id":"blk-25127","spans":[{"id":"spn-30420","text":"string?"}]},{"id":"blk-25128","spans":[{"id":"spn-30421","text":"Failure details (sanitized, no secrets)"}]}]]},{"id":"blk-25129","kind":"paragraph","spans":[{"id":"spn-30422","text":"---"}]},{"id":"blk-25130","kind":"heading","level":2,"spans":[{"id":"spn-30423","text":"Deploy Flow"}]},{"id":"blk-25131","kind":"code","language":"text","text":"1. UI uploads bundle (zip/tar)\n2. POST /functions/v1/deploy\n3. Edge Function:\n   a. Validate bundle (see validation rules below)\n   b. INSERT deployment (status: deploying)\n   c. Call RPI adapter: deploy(artifact, config, secrets)\n   d. On success:\n      - UPDATE deployment status -> active\n      - SET agents.active_deployment_id = deployment.id\n      - SET agents.status -> active\n   e. On failure:\n      - UPDATE deployment status -> failed\n      - SET error_message\n      - SET agents.status -> error"},{"id":"blk-25132","kind":"paragraph","spans":[{"id":"spn-30424","text":"---"}]},{"id":"blk-25133","kind":"heading","level":2,"spans":[{"id":"spn-30425","text":"Required Manifest: "},{"id":"spn-30426","marks":["code"],"text":"agent.config.json"}]},{"id":"blk-25134","kind":"paragraph","spans":[{"id":"spn-30427","text":"Every bundle must include this file at the root:"}]},{"id":"blk-25135","kind":"code","language":"json","text":"{\n  \"entrypoint\": \"src/index.ts\",\n  \"runtime\": \"cloudflare\",\n  \"protocol\": \"invoke/v1\",\n  \"env\": {\n    \"requiredKeys\": [\"OPENAI_API_KEY\"],\n    \"optionalKeys\": [\"DEBUG\"]\n  },\n  \"capabilities\": {\n    \"streaming\": true,\n    \"tools\": false\n  }\n}"},{"head":[{"id":"blk-25137","spans":[{"id":"spn-30428","text":"Field"}]},{"id":"blk-25138","spans":[{"id":"spn-30429","text":"Required"}]},{"id":"blk-25139","spans":[{"id":"spn-30430","text":"Description"}]}],"id":"blk-25136","kind":"table","rows":[[{"id":"blk-25140","spans":[{"id":"spn-30431","marks":["code"],"text":"entrypoint"}]},{"id":"blk-25141","spans":[{"id":"spn-30432","text":"Yes"}]},{"id":"blk-25142","spans":[{"id":"spn-30433","text":"Path to main file"}]}],[{"id":"blk-25143","spans":[{"id":"spn-30434","marks":["code"],"text":"runtime"}]},{"id":"blk-25144","spans":[{"id":"spn-30435","text":"Yes"}]},{"id":"blk-25145","spans":[{"id":"spn-30436","text":"Must match agent's "},{"id":"spn-30437","marks":["code"],"text":"runtime_provider"}]}],[{"id":"blk-25146","spans":[{"id":"spn-30438","marks":["code"],"text":"protocol"}]},{"id":"blk-25147","spans":[{"id":"spn-30439","text":"Yes"}]},{"id":"blk-25148","spans":[{"id":"spn-30440","text":"Must be "},{"id":"spn-30441","marks":["code"],"text":"invoke/v1"}]}],[{"id":"blk-25149","spans":[{"id":"spn-30442","marks":["code"],"text":"env.requiredKeys"}]},{"id":"blk-25150","spans":[{"id":"spn-30443","text":"Yes"}]},{"id":"blk-25151","spans":[{"id":"spn-30444","text":"Secret keys that must exist in Vault"}]}],[{"id":"blk-25152","spans":[{"id":"spn-30445","marks":["code"],"text":"capabilities"}]},{"id":"blk-25153","spans":[{"id":"spn-30446","text":"Yes"}]},{"id":"blk-25154","spans":[{"id":"spn-30447","text":"Feature flags"}]}]]},{"id":"blk-25155","kind":"paragraph","spans":[{"id":"spn-30448","text":"---"}]},{"id":"blk-25156","kind":"heading","level":2,"spans":[{"id":"spn-30449","text":"Validation Rules (MUST)"}]},{"id":"blk-25157","items":[{"blocks":[{"id":"blk-25159","kind":"paragraph","spans":[{"id":"spn-30450","text":"[ ] "},{"id":"spn-30451","marks":["code"],"text":"agent.config.json"},{"id":"spn-30452","text":" exists and parses as valid JSON"}]}],"id":"blk-25158","kind":"list-item"},{"blocks":[{"id":"blk-25161","kind":"paragraph","spans":[{"id":"spn-30453","text":"[ ] "},{"id":"spn-30454","marks":["code"],"text":"entrypoint"},{"id":"spn-30455","text":" file exists in the bundle"}]}],"id":"blk-25160","kind":"list-item"},{"blocks":[{"id":"blk-25163","kind":"paragraph","spans":[{"id":"spn-30456","text":"[ ] "},{"id":"spn-30457","marks":["code"],"text":"runtime"},{"id":"spn-30458","text":" matches the agent's "},{"id":"spn-30459","marks":["code"],"text":"runtime_provider"}]}],"id":"blk-25162","kind":"list-item"},{"blocks":[{"id":"blk-25165","kind":"paragraph","spans":[{"id":"spn-30460","text":"[ ] "},{"id":"spn-30461","marks":["code"],"text":"protocol"},{"id":"spn-30462","text":" is "},{"id":"spn-30463","marks":["code"],"text":"invoke/v1"}]}],"id":"blk-25164","kind":"list-item"},{"blocks":[{"id":"blk-25167","kind":"paragraph","spans":[{"id":"spn-30464","text":"[ ] Bundle size within limits (compressed and extracted)"}]}],"id":"blk-25166","kind":"list-item"},{"blocks":[{"id":"blk-25169","kind":"paragraph","spans":[{"id":"spn-30465","text":"[ ] File count within limits"}]}],"id":"blk-25168","kind":"list-item"},{"blocks":[{"id":"blk-25171","kind":"paragraph","spans":[{"id":"spn-30466","text":"[ ] No path traversal entries or unsafe symlinks"}]}],"id":"blk-25170","kind":"list-item"},{"blocks":[{"id":"blk-25173","kind":"paragraph","spans":[{"id":"spn-30467","text":"[ ] Version is strictly greater than the previous deployment's version"}]}],"id":"blk-25172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25174","kind":"paragraph","spans":[{"id":"spn-30468","text":"---"}]},{"id":"blk-25175","kind":"heading","level":2,"spans":[{"id":"spn-30469","text":"Version Monotonicity"}]},{"id":"blk-25176","kind":"paragraph","spans":[{"id":"spn-30470","text":"Versions are monotonically increasing integers per agent. The platform auto-assigns the next version if not provided. Attempting to deploy a version less than or equal to the current maximum is rejected."}]},{"id":"blk-25177","kind":"code","language":"text","text":"agent_id | version | status\n---------+---------+--------\nabc      | 1       | rolled_back\nabc      | 2       | rolled_back\nabc      | 3       | active     <-- current"},{"id":"blk-25178","kind":"paragraph","spans":[{"id":"spn-30471","text":"---"}]},{"id":"blk-25179","kind":"heading","level":2,"spans":[{"id":"spn-30472","text":"Rollback"}]},{"id":"blk-25180","kind":"paragraph","spans":[{"id":"spn-30473","text":"Rollback does "},{"id":"spn-30474","marks":["bold"],"text":"not"},{"id":"spn-30475","text":" create a new deployment. It switches the active pointer:"}]},{"id":"blk-25181","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/rollback_deployment\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"deployment_id\": \"<target-uuid>\" }'"},{"id":"blk-25182","kind":"paragraph","spans":[{"id":"spn-30476","text":"The target deployment must have status "},{"id":"spn-30477","marks":["code"],"text":"active"},{"id":"spn-30478","text":" or "},{"id":"spn-30479","marks":["code"],"text":"rolled_back"},{"id":"spn-30480","text":" and belong to the same agent. The current active deployment is marked "},{"id":"spn-30481","marks":["code"],"text":"rolled_back"},{"id":"spn-30482","text":"."}]},{"id":"blk-25183","kind":"paragraph","spans":[{"id":"spn-30483","text":"---"}]},{"id":"blk-25184","kind":"heading","level":2,"spans":[{"id":"spn-30484","text":"AgentCore Container Build Pipeline"}]},{"id":"blk-25185","kind":"paragraph","spans":[{"id":"spn-30485","text":"When "},{"id":"spn-30486","marks":["code"],"text":"runtime=agentcore"},{"id":"spn-30487","text":", the control plane converts the uploaded bundle into a container image:"}]},{"id":"blk-25186","kind":"code","language":"text","text":"1. Extract and validate archive\n2. Build user code (TypeScript -> Node.js 20 artifact)\n3. Generate HTTP wrapper (invoke/v1 handler)\n4. Build OCI container image\n5. Push to ECR registry\n6. Create/update AgentCore runtime with image URI\n7. Inject env vars (telemetry key + user secrets)"},{"id":"blk-25187","kind":"paragraph","spans":[{"id":"spn-30488","text":"The pipeline is idempotent per "},{"id":"spn-30489","marks":["code"],"text":"deployment_id"},{"id":"spn-30490","text":" -- retries produce the same provider state."}]},{"id":"blk-25188","kind":"paragraph","spans":[{"id":"spn-30491","text":"---"}]},{"id":"blk-25189","kind":"heading","level":2,"spans":[{"id":"spn-30492","text":"Concurrent Deploy Guard"}]},{"id":"blk-25190","kind":"paragraph","spans":[{"id":"spn-30493","text":"Only one deployment can be in "},{"id":"spn-30494","marks":["code"],"text":"deploying"},{"id":"spn-30495","text":" status per agent at a time. The Edge Function must check for existing in-progress deployments and reject concurrent attempts with an appropriate error."}]},{"id":"blk-25191","kind":"paragraph","spans":[{"id":"spn-30496","text":"---"}]},{"id":"blk-25192","kind":"heading","level":2,"spans":[{"id":"spn-30497","text":"Checklist"}]},{"id":"blk-25193","items":[{"blocks":[{"id":"blk-25195","kind":"paragraph","spans":[{"id":"spn-30498","text":"[ ] Bundle includes valid "},{"id":"spn-30499","marks":["code"],"text":"agent.config.json"}]}],"id":"blk-25194","kind":"list-item"},{"blocks":[{"id":"blk-25197","kind":"paragraph","spans":[{"id":"spn-30500","text":"[ ] Entrypoint file exists"}]}],"id":"blk-25196","kind":"list-item"},{"blocks":[{"id":"blk-25199","kind":"paragraph","spans":[{"id":"spn-30501","text":"[ ] Runtime matches agent configuration"}]}],"id":"blk-25198","kind":"list-item"},{"blocks":[{"id":"blk-25201","kind":"paragraph","spans":[{"id":"spn-30502","text":"[ ] Version is monotonically increasing"}]}],"id":"blk-25200","kind":"list-item"},{"blocks":[{"id":"blk-25203","kind":"paragraph","spans":[{"id":"spn-30503","text":"[ ] Bundle passes size and file count limits"}]}],"id":"blk-25202","kind":"list-item"},{"blocks":[{"id":"blk-25205","kind":"paragraph","spans":[{"id":"spn-30504","text":"[ ] No concurrent deploys for the same agent"}]}],"id":"blk-25204","kind":"list-item"},{"blocks":[{"id":"blk-25207","kind":"paragraph","spans":[{"id":"spn-30505","text":"[ ] Secrets referenced in manifest exist in Vault"}]}],"id":"blk-25206","kind":"list-item"},{"blocks":[{"id":"blk-25209","kind":"paragraph","spans":[{"id":"spn-30506","text":"[ ] Deployment record is immutable after creation (except status/error)"}]}],"id":"blk-25208","kind":"list-item"},{"blocks":[{"id":"blk-25211","kind":"paragraph","spans":[{"id":"spn-30507","text":"[ ] AgentCore builds produce deterministic container images"}]}],"id":"blk-25210","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraazqu7v6ynsahda2qejjcr4g3kyyna5ihd75u7doswnhuqhpmvywq","vocabulary":"ampersand.docs.fs.v1"}