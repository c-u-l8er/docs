{"bendscript":"0.1","blocks":[{"id":"blk-24604","kind":"heading","level":1,"spans":[{"id":"spn-29252","text":"02 — Deployment Pipeline"}]},{"blocks":[{"id":"blk-24606","kind":"paragraph","spans":[{"id":"spn-29253","marks":["bold"],"text":"Purpose:"},{"id":"spn-29254","text":" How bundles are uploaded, validated, and deployed to runtime providers. Covers the immutable deployment model, version monotonicity, rollback mechanics, and the AgentCore container build pipeline."}]}],"id":"blk-24605","kind":"quote"},{"id":"blk-24607","kind":"paragraph","spans":[{"id":"spn-29255","text":"---"}]},{"id":"blk-24608","kind":"heading","level":2,"spans":[{"id":"spn-29256","text":"Deployment Model"}]},{"id":"blk-24609","kind":"paragraph","spans":[{"id":"spn-29257","text":"Deployments are "},{"id":"spn-29258","marks":["bold"],"text":"immutable records"},{"id":"spn-29259","text":". Once created, a deployment's artifact, version, and configuration never change. Only "},{"id":"spn-29260","marks":["code"],"text":"status"},{"id":"spn-29261","text":" and "},{"id":"spn-29262","marks":["code"],"text":"error_message"},{"id":"spn-29263","text":" are updated during the lifecycle. Rollback works by switching the agent's "},{"id":"spn-29264","marks":["code"],"text":"active_deployment_id"},{"id":"spn-29265","text":" pointer -- not by modifying old deployments."}]},{"id":"blk-24610","kind":"paragraph","spans":[{"id":"spn-29266","text":"---"}]},{"id":"blk-24611","kind":"heading","level":2,"spans":[{"id":"spn-29267","text":"Deployment Fields"}]},{"head":[{"id":"blk-24613","spans":[{"id":"spn-29268","text":"Field"}]},{"id":"blk-24614","spans":[{"id":"spn-29269","text":"Type"}]},{"id":"blk-24615","spans":[{"id":"spn-29270","text":"Description"}]}],"id":"blk-24612","kind":"table","rows":[[{"id":"blk-24616","spans":[{"id":"spn-29271","marks":["code"],"text":"id"}]},{"id":"blk-24617","spans":[{"id":"spn-29272","text":"UUID"}]},{"id":"blk-24618","spans":[{"id":"spn-29273","text":"Immutable deployment identifier"}]}],[{"id":"blk-24619","spans":[{"id":"spn-29274","marks":["code"],"text":"agent_id"}]},{"id":"blk-24620","spans":[{"id":"spn-29275","text":"UUID"}]},{"id":"blk-24621","spans":[{"id":"spn-29276","text":"Parent agent"}]}],[{"id":"blk-24622","spans":[{"id":"spn-29277","marks":["code"],"text":"version"}]},{"id":"blk-24623","spans":[{"id":"spn-29278","text":"int"}]},{"id":"blk-24624","spans":[{"id":"spn-29279","text":"Monotonically increasing per agent"}]}],[{"id":"blk-24625","spans":[{"id":"spn-29280","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24626","spans":[{"id":"spn-29281","text":"enum"}]},{"id":"blk-24627","spans":[{"id":"spn-29282","marks":["code"],"text":"cloudflare"},{"id":"spn-29283","text":" or "},{"id":"spn-29284","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24628","spans":[{"id":"spn-29285","marks":["code"],"text":"status"}]},{"id":"blk-24629","spans":[{"id":"spn-29286","text":"enum"}]},{"id":"blk-24630","spans":[{"id":"spn-29287","marks":["code"],"text":"deploying"},{"id":"spn-29288","text":" / "},{"id":"spn-29289","marks":["code"],"text":"active"},{"id":"spn-29290","text":" / "},{"id":"spn-29291","marks":["code"],"text":"failed"},{"id":"spn-29292","text":" / "},{"id":"spn-29293","marks":["code"],"text":"rolled_back"}]}],[{"id":"blk-24631","spans":[{"id":"spn-29294","marks":["code"],"text":"artifact"}]},{"id":"blk-24632","spans":[{"id":"spn-29295","text":"JSONB"}]},{"id":"blk-24633","spans":[{"id":"spn-29296","text":"Upload reference (checksum, size)"}]}],[{"id":"blk-24634","spans":[{"id":"spn-29297","marks":["code"],"text":"provider_ref"}]},{"id":"blk-24635","spans":[{"id":"spn-29298","text":"JSONB"}]},{"id":"blk-24636","spans":[{"id":"spn-29299","text":"Provider-specific deployment reference"}]}],[{"id":"blk-24637","spans":[{"id":"spn-29300","marks":["code"],"text":"commit_hash"}]},{"id":"blk-24638","spans":[{"id":"spn-29301","text":"string?"}]},{"id":"blk-24639","spans":[{"id":"spn-29302","text":"Optional git commit"}]}],[{"id":"blk-24640","spans":[{"id":"spn-29303","marks":["code"],"text":"error_message"}]},{"id":"blk-24641","spans":[{"id":"spn-29304","text":"string?"}]},{"id":"blk-24642","spans":[{"id":"spn-29305","text":"Failure details (sanitized, no secrets)"}]}]]},{"id":"blk-24643","kind":"paragraph","spans":[{"id":"spn-29306","text":"---"}]},{"id":"blk-24644","kind":"heading","level":2,"spans":[{"id":"spn-29307","text":"Deploy Flow"}]},{"id":"blk-24645","kind":"code","language":"text","text":"1. UI uploads bundle (zip/tar)\n2. POST /functions/v1/deploy\n3. Edge Function:\n   a. Validate bundle (see validation rules below)\n   b. INSERT deployment (status: deploying)\n   c. Call RPI adapter: deploy(artifact, config, secrets)\n   d. On success:\n      - UPDATE deployment status -> active\n      - SET agents.active_deployment_id = deployment.id\n      - SET agents.status -> active\n   e. On failure:\n      - UPDATE deployment status -> failed\n      - SET error_message\n      - SET agents.status -> error"},{"id":"blk-24646","kind":"paragraph","spans":[{"id":"spn-29308","text":"---"}]},{"id":"blk-24647","kind":"heading","level":2,"spans":[{"id":"spn-29309","text":"Required Manifest: "},{"id":"spn-29310","marks":["code"],"text":"agent.config.json"}]},{"id":"blk-24648","kind":"paragraph","spans":[{"id":"spn-29311","text":"Every bundle must include this file at the root:"}]},{"id":"blk-24649","kind":"code","language":"json","text":"{\n  \"entrypoint\": \"src/index.ts\",\n  \"runtime\": \"cloudflare\",\n  \"protocol\": \"invoke/v1\",\n  \"env\": {\n    \"requiredKeys\": [\"OPENAI_API_KEY\"],\n    \"optionalKeys\": [\"DEBUG\"]\n  },\n  \"capabilities\": {\n    \"streaming\": true,\n    \"tools\": false\n  }\n}"},{"head":[{"id":"blk-24651","spans":[{"id":"spn-29312","text":"Field"}]},{"id":"blk-24652","spans":[{"id":"spn-29313","text":"Required"}]},{"id":"blk-24653","spans":[{"id":"spn-29314","text":"Description"}]}],"id":"blk-24650","kind":"table","rows":[[{"id":"blk-24654","spans":[{"id":"spn-29315","marks":["code"],"text":"entrypoint"}]},{"id":"blk-24655","spans":[{"id":"spn-29316","text":"Yes"}]},{"id":"blk-24656","spans":[{"id":"spn-29317","text":"Path to main file"}]}],[{"id":"blk-24657","spans":[{"id":"spn-29318","marks":["code"],"text":"runtime"}]},{"id":"blk-24658","spans":[{"id":"spn-29319","text":"Yes"}]},{"id":"blk-24659","spans":[{"id":"spn-29320","text":"Must match agent's "},{"id":"spn-29321","marks":["code"],"text":"runtime_provider"}]}],[{"id":"blk-24660","spans":[{"id":"spn-29322","marks":["code"],"text":"protocol"}]},{"id":"blk-24661","spans":[{"id":"spn-29323","text":"Yes"}]},{"id":"blk-24662","spans":[{"id":"spn-29324","text":"Must be "},{"id":"spn-29325","marks":["code"],"text":"invoke/v1"}]}],[{"id":"blk-24663","spans":[{"id":"spn-29326","marks":["code"],"text":"env.requiredKeys"}]},{"id":"blk-24664","spans":[{"id":"spn-29327","text":"Yes"}]},{"id":"blk-24665","spans":[{"id":"spn-29328","text":"Secret keys that must exist in Vault"}]}],[{"id":"blk-24666","spans":[{"id":"spn-29329","marks":["code"],"text":"capabilities"}]},{"id":"blk-24667","spans":[{"id":"spn-29330","text":"Yes"}]},{"id":"blk-24668","spans":[{"id":"spn-29331","text":"Feature flags"}]}]]},{"id":"blk-24669","kind":"paragraph","spans":[{"id":"spn-29332","text":"---"}]},{"id":"blk-24670","kind":"heading","level":2,"spans":[{"id":"spn-29333","text":"Validation Rules (MUST)"}]},{"id":"blk-24671","items":[{"blocks":[{"id":"blk-24673","kind":"paragraph","spans":[{"id":"spn-29334","text":"[ ] "},{"id":"spn-29335","marks":["code"],"text":"agent.config.json"},{"id":"spn-29336","text":" exists and parses as valid JSON"}]}],"id":"blk-24672","kind":"list-item"},{"blocks":[{"id":"blk-24675","kind":"paragraph","spans":[{"id":"spn-29337","text":"[ ] "},{"id":"spn-29338","marks":["code"],"text":"entrypoint"},{"id":"spn-29339","text":" file exists in the bundle"}]}],"id":"blk-24674","kind":"list-item"},{"blocks":[{"id":"blk-24677","kind":"paragraph","spans":[{"id":"spn-29340","text":"[ ] "},{"id":"spn-29341","marks":["code"],"text":"runtime"},{"id":"spn-29342","text":" matches the agent's "},{"id":"spn-29343","marks":["code"],"text":"runtime_provider"}]}],"id":"blk-24676","kind":"list-item"},{"blocks":[{"id":"blk-24679","kind":"paragraph","spans":[{"id":"spn-29344","text":"[ ] "},{"id":"spn-29345","marks":["code"],"text":"protocol"},{"id":"spn-29346","text":" is "},{"id":"spn-29347","marks":["code"],"text":"invoke/v1"}]}],"id":"blk-24678","kind":"list-item"},{"blocks":[{"id":"blk-24681","kind":"paragraph","spans":[{"id":"spn-29348","text":"[ ] Bundle size within limits (compressed and extracted)"}]}],"id":"blk-24680","kind":"list-item"},{"blocks":[{"id":"blk-24683","kind":"paragraph","spans":[{"id":"spn-29349","text":"[ ] File count within limits"}]}],"id":"blk-24682","kind":"list-item"},{"blocks":[{"id":"blk-24685","kind":"paragraph","spans":[{"id":"spn-29350","text":"[ ] No path traversal entries or unsafe symlinks"}]}],"id":"blk-24684","kind":"list-item"},{"blocks":[{"id":"blk-24687","kind":"paragraph","spans":[{"id":"spn-29351","text":"[ ] Version is strictly greater than the previous deployment's version"}]}],"id":"blk-24686","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24688","kind":"paragraph","spans":[{"id":"spn-29352","text":"---"}]},{"id":"blk-24689","kind":"heading","level":2,"spans":[{"id":"spn-29353","text":"Version Monotonicity"}]},{"id":"blk-24690","kind":"paragraph","spans":[{"id":"spn-29354","text":"Versions are monotonically increasing integers per agent. The platform auto-assigns the next version if not provided. Attempting to deploy a version less than or equal to the current maximum is rejected."}]},{"id":"blk-24691","kind":"code","language":"text","text":"agent_id | version | status\n---------+---------+--------\nabc      | 1       | rolled_back\nabc      | 2       | rolled_back\nabc      | 3       | active     <-- current"},{"id":"blk-24692","kind":"paragraph","spans":[{"id":"spn-29355","text":"---"}]},{"id":"blk-24693","kind":"heading","level":2,"spans":[{"id":"spn-29356","text":"Rollback"}]},{"id":"blk-24694","kind":"paragraph","spans":[{"id":"spn-29357","text":"Rollback does "},{"id":"spn-29358","marks":["bold"],"text":"not"},{"id":"spn-29359","text":" create a new deployment. It switches the active pointer:"}]},{"id":"blk-24695","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/rollback_deployment\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"deployment_id\": \"<target-uuid>\" }'"},{"id":"blk-24696","kind":"paragraph","spans":[{"id":"spn-29360","text":"The target deployment must have status "},{"id":"spn-29361","marks":["code"],"text":"active"},{"id":"spn-29362","text":" or "},{"id":"spn-29363","marks":["code"],"text":"rolled_back"},{"id":"spn-29364","text":" and belong to the same agent. The current active deployment is marked "},{"id":"spn-29365","marks":["code"],"text":"rolled_back"},{"id":"spn-29366","text":"."}]},{"id":"blk-24697","kind":"paragraph","spans":[{"id":"spn-29367","text":"---"}]},{"id":"blk-24698","kind":"heading","level":2,"spans":[{"id":"spn-29368","text":"AgentCore Container Build Pipeline"}]},{"id":"blk-24699","kind":"paragraph","spans":[{"id":"spn-29369","text":"When "},{"id":"spn-29370","marks":["code"],"text":"runtime=agentcore"},{"id":"spn-29371","text":", the control plane converts the uploaded bundle into a container image:"}]},{"id":"blk-24700","kind":"code","language":"text","text":"1. Extract and validate archive\n2. Build user code (TypeScript -> Node.js 20 artifact)\n3. Generate HTTP wrapper (invoke/v1 handler)\n4. Build OCI container image\n5. Push to ECR registry\n6. Create/update AgentCore runtime with image URI\n7. Inject env vars (telemetry key + user secrets)"},{"id":"blk-24701","kind":"paragraph","spans":[{"id":"spn-29372","text":"The pipeline is idempotent per "},{"id":"spn-29373","marks":["code"],"text":"deployment_id"},{"id":"spn-29374","text":" -- retries produce the same provider state."}]},{"id":"blk-24702","kind":"paragraph","spans":[{"id":"spn-29375","text":"---"}]},{"id":"blk-24703","kind":"heading","level":2,"spans":[{"id":"spn-29376","text":"Concurrent Deploy Guard"}]},{"id":"blk-24704","kind":"paragraph","spans":[{"id":"spn-29377","text":"Only one deployment can be in "},{"id":"spn-29378","marks":["code"],"text":"deploying"},{"id":"spn-29379","text":" status per agent at a time. The Edge Function must check for existing in-progress deployments and reject concurrent attempts with an appropriate error."}]},{"id":"blk-24705","kind":"paragraph","spans":[{"id":"spn-29380","text":"---"}]},{"id":"blk-24706","kind":"heading","level":2,"spans":[{"id":"spn-29381","text":"Checklist"}]},{"id":"blk-24707","items":[{"blocks":[{"id":"blk-24709","kind":"paragraph","spans":[{"id":"spn-29382","text":"[ ] Bundle includes valid "},{"id":"spn-29383","marks":["code"],"text":"agent.config.json"}]}],"id":"blk-24708","kind":"list-item"},{"blocks":[{"id":"blk-24711","kind":"paragraph","spans":[{"id":"spn-29384","text":"[ ] Entrypoint file exists"}]}],"id":"blk-24710","kind":"list-item"},{"blocks":[{"id":"blk-24713","kind":"paragraph","spans":[{"id":"spn-29385","text":"[ ] Runtime matches agent configuration"}]}],"id":"blk-24712","kind":"list-item"},{"blocks":[{"id":"blk-24715","kind":"paragraph","spans":[{"id":"spn-29386","text":"[ ] Version is monotonically increasing"}]}],"id":"blk-24714","kind":"list-item"},{"blocks":[{"id":"blk-24717","kind":"paragraph","spans":[{"id":"spn-29387","text":"[ ] Bundle passes size and file count limits"}]}],"id":"blk-24716","kind":"list-item"},{"blocks":[{"id":"blk-24719","kind":"paragraph","spans":[{"id":"spn-29388","text":"[ ] No concurrent deploys for the same agent"}]}],"id":"blk-24718","kind":"list-item"},{"blocks":[{"id":"blk-24721","kind":"paragraph","spans":[{"id":"spn-29389","text":"[ ] Secrets referenced in manifest exist in Vault"}]}],"id":"blk-24720","kind":"list-item"},{"blocks":[{"id":"blk-24723","kind":"paragraph","spans":[{"id":"spn-29390","text":"[ ] Deployment record is immutable after creation (except status/error)"}]}],"id":"blk-24722","kind":"list-item"},{"blocks":[{"id":"blk-24725","kind":"paragraph","spans":[{"id":"spn-29391","text":"[ ] AgentCore builds produce deterministic container images"}]}],"id":"blk-24724","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieral5qzuyredowemcbfbakzvxgecspm3jpqfj3vxgxjmlbaq4i7lzrq","vocabulary":"ampersand.docs.fs.v1"}