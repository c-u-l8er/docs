{"bendscript":"0.1","blocks":[{"id":"blk-24119","kind":"heading","level":1,"spans":[{"id":"spn-28079","text":"02 — Deployment Pipeline"}]},{"blocks":[{"id":"blk-24121","kind":"paragraph","spans":[{"id":"spn-28080","marks":["bold"],"text":"Purpose:"},{"id":"spn-28081","text":" How bundles are uploaded, validated, and deployed to runtime providers. Covers the immutable deployment model, version monotonicity, rollback mechanics, and the AgentCore container build pipeline."}]}],"id":"blk-24120","kind":"quote"},{"id":"blk-24122","kind":"paragraph","spans":[{"id":"spn-28082","text":"---"}]},{"id":"blk-24123","kind":"heading","level":2,"spans":[{"id":"spn-28083","text":"Deployment Model"}]},{"id":"blk-24124","kind":"paragraph","spans":[{"id":"spn-28084","text":"Deployments are "},{"id":"spn-28085","marks":["bold"],"text":"immutable records"},{"id":"spn-28086","text":". Once created, a deployment's artifact, version, and configuration never change. Only "},{"id":"spn-28087","marks":["code"],"text":"status"},{"id":"spn-28088","text":" and "},{"id":"spn-28089","marks":["code"],"text":"error_message"},{"id":"spn-28090","text":" are updated during the lifecycle. Rollback works by switching the agent's "},{"id":"spn-28091","marks":["code"],"text":"active_deployment_id"},{"id":"spn-28092","text":" pointer -- not by modifying old deployments."}]},{"id":"blk-24125","kind":"paragraph","spans":[{"id":"spn-28093","text":"---"}]},{"id":"blk-24126","kind":"heading","level":2,"spans":[{"id":"spn-28094","text":"Deployment Fields"}]},{"head":[{"id":"blk-24128","spans":[{"id":"spn-28095","text":"Field"}]},{"id":"blk-24129","spans":[{"id":"spn-28096","text":"Type"}]},{"id":"blk-24130","spans":[{"id":"spn-28097","text":"Description"}]}],"id":"blk-24127","kind":"table","rows":[[{"id":"blk-24131","spans":[{"id":"spn-28098","marks":["code"],"text":"id"}]},{"id":"blk-24132","spans":[{"id":"spn-28099","text":"UUID"}]},{"id":"blk-24133","spans":[{"id":"spn-28100","text":"Immutable deployment identifier"}]}],[{"id":"blk-24134","spans":[{"id":"spn-28101","marks":["code"],"text":"agent_id"}]},{"id":"blk-24135","spans":[{"id":"spn-28102","text":"UUID"}]},{"id":"blk-24136","spans":[{"id":"spn-28103","text":"Parent agent"}]}],[{"id":"blk-24137","spans":[{"id":"spn-28104","marks":["code"],"text":"version"}]},{"id":"blk-24138","spans":[{"id":"spn-28105","text":"int"}]},{"id":"blk-24139","spans":[{"id":"spn-28106","text":"Monotonically increasing per agent"}]}],[{"id":"blk-24140","spans":[{"id":"spn-28107","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-24141","spans":[{"id":"spn-28108","text":"enum"}]},{"id":"blk-24142","spans":[{"id":"spn-28109","marks":["code"],"text":"cloudflare"},{"id":"spn-28110","text":" or "},{"id":"spn-28111","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-24143","spans":[{"id":"spn-28112","marks":["code"],"text":"status"}]},{"id":"blk-24144","spans":[{"id":"spn-28113","text":"enum"}]},{"id":"blk-24145","spans":[{"id":"spn-28114","marks":["code"],"text":"deploying"},{"id":"spn-28115","text":" / "},{"id":"spn-28116","marks":["code"],"text":"active"},{"id":"spn-28117","text":" / "},{"id":"spn-28118","marks":["code"],"text":"failed"},{"id":"spn-28119","text":" / "},{"id":"spn-28120","marks":["code"],"text":"rolled_back"}]}],[{"id":"blk-24146","spans":[{"id":"spn-28121","marks":["code"],"text":"artifact"}]},{"id":"blk-24147","spans":[{"id":"spn-28122","text":"JSONB"}]},{"id":"blk-24148","spans":[{"id":"spn-28123","text":"Upload reference (checksum, size)"}]}],[{"id":"blk-24149","spans":[{"id":"spn-28124","marks":["code"],"text":"provider_ref"}]},{"id":"blk-24150","spans":[{"id":"spn-28125","text":"JSONB"}]},{"id":"blk-24151","spans":[{"id":"spn-28126","text":"Provider-specific deployment reference"}]}],[{"id":"blk-24152","spans":[{"id":"spn-28127","marks":["code"],"text":"commit_hash"}]},{"id":"blk-24153","spans":[{"id":"spn-28128","text":"string?"}]},{"id":"blk-24154","spans":[{"id":"spn-28129","text":"Optional git commit"}]}],[{"id":"blk-24155","spans":[{"id":"spn-28130","marks":["code"],"text":"error_message"}]},{"id":"blk-24156","spans":[{"id":"spn-28131","text":"string?"}]},{"id":"blk-24157","spans":[{"id":"spn-28132","text":"Failure details (sanitized, no secrets)"}]}]]},{"id":"blk-24158","kind":"paragraph","spans":[{"id":"spn-28133","text":"---"}]},{"id":"blk-24159","kind":"heading","level":2,"spans":[{"id":"spn-28134","text":"Deploy Flow"}]},{"id":"blk-24160","kind":"code","language":"text","text":"1. UI uploads bundle (zip/tar)\n2. POST /functions/v1/deploy\n3. Edge Function:\n   a. Validate bundle (see validation rules below)\n   b. INSERT deployment (status: deploying)\n   c. Call RPI adapter: deploy(artifact, config, secrets)\n   d. On success:\n      - UPDATE deployment status -> active\n      - SET agents.active_deployment_id = deployment.id\n      - SET agents.status -> active\n   e. On failure:\n      - UPDATE deployment status -> failed\n      - SET error_message\n      - SET agents.status -> error"},{"id":"blk-24161","kind":"paragraph","spans":[{"id":"spn-28135","text":"---"}]},{"id":"blk-24162","kind":"heading","level":2,"spans":[{"id":"spn-28136","text":"Required Manifest: "},{"id":"spn-28137","marks":["code"],"text":"agent.config.json"}]},{"id":"blk-24163","kind":"paragraph","spans":[{"id":"spn-28138","text":"Every bundle must include this file at the root:"}]},{"id":"blk-24164","kind":"code","language":"json","text":"{\n  \"entrypoint\": \"src/index.ts\",\n  \"runtime\": \"cloudflare\",\n  \"protocol\": \"invoke/v1\",\n  \"env\": {\n    \"requiredKeys\": [\"OPENAI_API_KEY\"],\n    \"optionalKeys\": [\"DEBUG\"]\n  },\n  \"capabilities\": {\n    \"streaming\": true,\n    \"tools\": false\n  }\n}"},{"head":[{"id":"blk-24166","spans":[{"id":"spn-28139","text":"Field"}]},{"id":"blk-24167","spans":[{"id":"spn-28140","text":"Required"}]},{"id":"blk-24168","spans":[{"id":"spn-28141","text":"Description"}]}],"id":"blk-24165","kind":"table","rows":[[{"id":"blk-24169","spans":[{"id":"spn-28142","marks":["code"],"text":"entrypoint"}]},{"id":"blk-24170","spans":[{"id":"spn-28143","text":"Yes"}]},{"id":"blk-24171","spans":[{"id":"spn-28144","text":"Path to main file"}]}],[{"id":"blk-24172","spans":[{"id":"spn-28145","marks":["code"],"text":"runtime"}]},{"id":"blk-24173","spans":[{"id":"spn-28146","text":"Yes"}]},{"id":"blk-24174","spans":[{"id":"spn-28147","text":"Must match agent's "},{"id":"spn-28148","marks":["code"],"text":"runtime_provider"}]}],[{"id":"blk-24175","spans":[{"id":"spn-28149","marks":["code"],"text":"protocol"}]},{"id":"blk-24176","spans":[{"id":"spn-28150","text":"Yes"}]},{"id":"blk-24177","spans":[{"id":"spn-28151","text":"Must be "},{"id":"spn-28152","marks":["code"],"text":"invoke/v1"}]}],[{"id":"blk-24178","spans":[{"id":"spn-28153","marks":["code"],"text":"env.requiredKeys"}]},{"id":"blk-24179","spans":[{"id":"spn-28154","text":"Yes"}]},{"id":"blk-24180","spans":[{"id":"spn-28155","text":"Secret keys that must exist in Vault"}]}],[{"id":"blk-24181","spans":[{"id":"spn-28156","marks":["code"],"text":"capabilities"}]},{"id":"blk-24182","spans":[{"id":"spn-28157","text":"Yes"}]},{"id":"blk-24183","spans":[{"id":"spn-28158","text":"Feature flags"}]}]]},{"id":"blk-24184","kind":"paragraph","spans":[{"id":"spn-28159","text":"---"}]},{"id":"blk-24185","kind":"heading","level":2,"spans":[{"id":"spn-28160","text":"Validation Rules (MUST)"}]},{"id":"blk-24186","items":[{"blocks":[{"id":"blk-24188","kind":"paragraph","spans":[{"id":"spn-28161","text":"[ ] "},{"id":"spn-28162","marks":["code"],"text":"agent.config.json"},{"id":"spn-28163","text":" exists and parses as valid JSON"}]}],"id":"blk-24187","kind":"list-item"},{"blocks":[{"id":"blk-24190","kind":"paragraph","spans":[{"id":"spn-28164","text":"[ ] "},{"id":"spn-28165","marks":["code"],"text":"entrypoint"},{"id":"spn-28166","text":" file exists in the bundle"}]}],"id":"blk-24189","kind":"list-item"},{"blocks":[{"id":"blk-24192","kind":"paragraph","spans":[{"id":"spn-28167","text":"[ ] "},{"id":"spn-28168","marks":["code"],"text":"runtime"},{"id":"spn-28169","text":" matches the agent's "},{"id":"spn-28170","marks":["code"],"text":"runtime_provider"}]}],"id":"blk-24191","kind":"list-item"},{"blocks":[{"id":"blk-24194","kind":"paragraph","spans":[{"id":"spn-28171","text":"[ ] "},{"id":"spn-28172","marks":["code"],"text":"protocol"},{"id":"spn-28173","text":" is "},{"id":"spn-28174","marks":["code"],"text":"invoke/v1"}]}],"id":"blk-24193","kind":"list-item"},{"blocks":[{"id":"blk-24196","kind":"paragraph","spans":[{"id":"spn-28175","text":"[ ] Bundle size within limits (compressed and extracted)"}]}],"id":"blk-24195","kind":"list-item"},{"blocks":[{"id":"blk-24198","kind":"paragraph","spans":[{"id":"spn-28176","text":"[ ] File count within limits"}]}],"id":"blk-24197","kind":"list-item"},{"blocks":[{"id":"blk-24200","kind":"paragraph","spans":[{"id":"spn-28177","text":"[ ] No path traversal entries or unsafe symlinks"}]}],"id":"blk-24199","kind":"list-item"},{"blocks":[{"id":"blk-24202","kind":"paragraph","spans":[{"id":"spn-28178","text":"[ ] Version is strictly greater than the previous deployment's version"}]}],"id":"blk-24201","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24203","kind":"paragraph","spans":[{"id":"spn-28179","text":"---"}]},{"id":"blk-24204","kind":"heading","level":2,"spans":[{"id":"spn-28180","text":"Version Monotonicity"}]},{"id":"blk-24205","kind":"paragraph","spans":[{"id":"spn-28181","text":"Versions are monotonically increasing integers per agent. The platform auto-assigns the next version if not provided. Attempting to deploy a version less than or equal to the current maximum is rejected."}]},{"id":"blk-24206","kind":"code","language":"text","text":"agent_id | version | status\n---------+---------+--------\nabc      | 1       | rolled_back\nabc      | 2       | rolled_back\nabc      | 3       | active     <-- current"},{"id":"blk-24207","kind":"paragraph","spans":[{"id":"spn-28182","text":"---"}]},{"id":"blk-24208","kind":"heading","level":2,"spans":[{"id":"spn-28183","text":"Rollback"}]},{"id":"blk-24209","kind":"paragraph","spans":[{"id":"spn-28184","text":"Rollback does "},{"id":"spn-28185","marks":["bold"],"text":"not"},{"id":"spn-28186","text":" create a new deployment. It switches the active pointer:"}]},{"id":"blk-24210","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/rollback_deployment\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"deployment_id\": \"<target-uuid>\" }'"},{"id":"blk-24211","kind":"paragraph","spans":[{"id":"spn-28187","text":"The target deployment must have status "},{"id":"spn-28188","marks":["code"],"text":"active"},{"id":"spn-28189","text":" or "},{"id":"spn-28190","marks":["code"],"text":"rolled_back"},{"id":"spn-28191","text":" and belong to the same agent. The current active deployment is marked "},{"id":"spn-28192","marks":["code"],"text":"rolled_back"},{"id":"spn-28193","text":"."}]},{"id":"blk-24212","kind":"paragraph","spans":[{"id":"spn-28194","text":"---"}]},{"id":"blk-24213","kind":"heading","level":2,"spans":[{"id":"spn-28195","text":"AgentCore Container Build Pipeline"}]},{"id":"blk-24214","kind":"paragraph","spans":[{"id":"spn-28196","text":"When "},{"id":"spn-28197","marks":["code"],"text":"runtime=agentcore"},{"id":"spn-28198","text":", the control plane converts the uploaded bundle into a container image:"}]},{"id":"blk-24215","kind":"code","language":"text","text":"1. Extract and validate archive\n2. Build user code (TypeScript -> Node.js 20 artifact)\n3. Generate HTTP wrapper (invoke/v1 handler)\n4. Build OCI container image\n5. Push to ECR registry\n6. Create/update AgentCore runtime with image URI\n7. Inject env vars (telemetry key + user secrets)"},{"id":"blk-24216","kind":"paragraph","spans":[{"id":"spn-28199","text":"The pipeline is idempotent per "},{"id":"spn-28200","marks":["code"],"text":"deployment_id"},{"id":"spn-28201","text":" -- retries produce the same provider state."}]},{"id":"blk-24217","kind":"paragraph","spans":[{"id":"spn-28202","text":"---"}]},{"id":"blk-24218","kind":"heading","level":2,"spans":[{"id":"spn-28203","text":"Concurrent Deploy Guard"}]},{"id":"blk-24219","kind":"paragraph","spans":[{"id":"spn-28204","text":"Only one deployment can be in "},{"id":"spn-28205","marks":["code"],"text":"deploying"},{"id":"spn-28206","text":" status per agent at a time. The Edge Function must check for existing in-progress deployments and reject concurrent attempts with an appropriate error."}]},{"id":"blk-24220","kind":"paragraph","spans":[{"id":"spn-28207","text":"---"}]},{"id":"blk-24221","kind":"heading","level":2,"spans":[{"id":"spn-28208","text":"Checklist"}]},{"id":"blk-24222","items":[{"blocks":[{"id":"blk-24224","kind":"paragraph","spans":[{"id":"spn-28209","text":"[ ] Bundle includes valid "},{"id":"spn-28210","marks":["code"],"text":"agent.config.json"}]}],"id":"blk-24223","kind":"list-item"},{"blocks":[{"id":"blk-24226","kind":"paragraph","spans":[{"id":"spn-28211","text":"[ ] Entrypoint file exists"}]}],"id":"blk-24225","kind":"list-item"},{"blocks":[{"id":"blk-24228","kind":"paragraph","spans":[{"id":"spn-28212","text":"[ ] Runtime matches agent configuration"}]}],"id":"blk-24227","kind":"list-item"},{"blocks":[{"id":"blk-24230","kind":"paragraph","spans":[{"id":"spn-28213","text":"[ ] Version is monotonically increasing"}]}],"id":"blk-24229","kind":"list-item"},{"blocks":[{"id":"blk-24232","kind":"paragraph","spans":[{"id":"spn-28214","text":"[ ] Bundle passes size and file count limits"}]}],"id":"blk-24231","kind":"list-item"},{"blocks":[{"id":"blk-24234","kind":"paragraph","spans":[{"id":"spn-28215","text":"[ ] No concurrent deploys for the same agent"}]}],"id":"blk-24233","kind":"list-item"},{"blocks":[{"id":"blk-24236","kind":"paragraph","spans":[{"id":"spn-28216","text":"[ ] Secrets referenced in manifest exist in Vault"}]}],"id":"blk-24235","kind":"list-item"},{"blocks":[{"id":"blk-24238","kind":"paragraph","spans":[{"id":"spn-28217","text":"[ ] Deployment record is immutable after creation (except status/error)"}]}],"id":"blk-24237","kind":"list-item"},{"blocks":[{"id":"blk-24240","kind":"paragraph","spans":[{"id":"spn-28218","text":"[ ] AgentCore builds produce deterministic container images"}]}],"id":"blk-24239","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraq3efp3p4p55cwxzr4lxa5nc7glmdlpxoltjmgtywd5zoxcmmjfaa","vocabulary":"ampersand.docs.fs.v1"}