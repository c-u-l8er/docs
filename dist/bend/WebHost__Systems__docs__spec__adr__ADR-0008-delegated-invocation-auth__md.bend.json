{"bendscript":"0.1","blocks":[{"id":"blk-34561","kind":"heading","level":1,"spans":[{"id":"spn-38918","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-34562","items":[{"blocks":[{"id":"blk-34564","kind":"paragraph","spans":[{"id":"spn-38919","marks":["bold"],"text":"Status:"},{"id":"spn-38920","text":" Accepted"}]}],"id":"blk-34563","kind":"list-item"},{"blocks":[{"id":"blk-34566","kind":"paragraph","spans":[{"id":"spn-38921","marks":["bold"],"text":"Date:"},{"id":"spn-38922","text":" 2026-01-24"}]}],"id":"blk-34565","kind":"list-item"},{"blocks":[{"id":"blk-34568","kind":"paragraph","spans":[{"id":"spn-38923","marks":["bold"],"text":"Owners:"},{"id":"spn-38924","text":" Engineering"}]}],"id":"blk-34567","kind":"list-item"},{"blocks":[{"id":"blk-34570","kind":"paragraph","spans":[{"id":"spn-38925","marks":["bold"],"text":"Applies to:"},{"id":"spn-38926","text":" "},{"id":"spn-38927","marks":["code"],"text":"webhost.systems"},{"id":"spn-38928","text":" control plane"}]}],"id":"blk-34569","kind":"list-item"},{"blocks":[{"id":"blk-34572","kind":"paragraph","spans":[{"id":"spn-38929","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-38930","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-34571","kind":"list-item"},{"blocks":[{"id":"blk-34574","kind":"paragraph","spans":[{"id":"spn-38931","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-34573","kind":"list-item"},{"blocks":[{"id":"blk-34576","kind":"paragraph","spans":[{"id":"spn-38932","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-38933","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-34575","kind":"list-item"},{"blocks":[{"id":"blk-34578","kind":"paragraph","spans":[{"id":"spn-38934","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-38935","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-34577","kind":"list-item"},{"blocks":[{"id":"blk-34580","kind":"paragraph","spans":[{"id":"spn-38936","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-38937","text":" (invoke contract)"}]}],"id":"blk-34579","kind":"list-item"},{"blocks":[{"id":"blk-34582","kind":"paragraph","spans":[{"id":"spn-38938","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-38939","text":" (tenant isolation; access control)"}]}],"id":"blk-34581","kind":"list-item"},{"blocks":[{"id":"blk-34584","kind":"paragraph","spans":[{"id":"spn-38940","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-38941","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-34583","kind":"list-item"},{"blocks":[{"id":"blk-34586","kind":"paragraph","spans":[{"id":"spn-38942","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-38943","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-34585","kind":"list-item"},{"blocks":[{"id":"blk-34588","kind":"paragraph","spans":[{"id":"spn-38944","text":"External integration: "},{"id":"spn-38945","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-38946","text":" (consumer contract)"}]}],"id":"blk-34587","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34589","kind":"paragraph","spans":[{"id":"spn-38947","text":"---"}]},{"id":"blk-34590","kind":"heading","level":2,"spans":[{"id":"spn-38948","text":"1) Context"}]},{"id":"blk-34591","kind":"paragraph","spans":[{"id":"spn-38949","text":"The canonical WHS invocation endpoint ("},{"id":"spn-38950","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-38951","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-34592","kind":"paragraph","spans":[{"id":"spn-38952","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-34593","items":[{"blocks":[{"id":"blk-34595","kind":"paragraph","spans":[{"id":"spn-38953","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-34594","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34596","kind":"paragraph","spans":[{"id":"spn-38954","text":"Constraints:"}]},{"id":"blk-34597","items":[{"blocks":[{"id":"blk-34599","kind":"paragraph","spans":[{"id":"spn-38955","text":"Server-side orchestrators should "},{"id":"spn-38956","marks":["bold"],"text":"not"},{"id":"spn-38957","text":" rely on browser tokens."}]}],"id":"blk-34598","kind":"list-item"},{"blocks":[{"id":"blk-34601","kind":"paragraph","spans":[{"id":"spn-38958","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-34600","kind":"list-item"},{"blocks":[{"id":"blk-34603","kind":"paragraph","spans":[{"id":"spn-38959","text":"WHS must remain authoritative for:"}]}],"id":"blk-34602","kind":"list-item"},{"blocks":[{"id":"blk-34605","kind":"paragraph","spans":[{"id":"spn-38960","text":"agent ownership/visibility,"}]}],"id":"blk-34604","kind":"list-item"},{"blocks":[{"id":"blk-34607","kind":"paragraph","spans":[{"id":"spn-38961","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-34606","kind":"list-item"},{"blocks":[{"id":"blk-34609","kind":"paragraph","spans":[{"id":"spn-38962","text":"telemetry, usage, billing."}]}],"id":"blk-34608","kind":"list-item"},{"blocks":[{"id":"blk-34611","kind":"paragraph","spans":[{"id":"spn-38963","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-34610","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34612","kind":"paragraph","spans":[{"id":"spn-38964","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-34613","items":[{"blocks":[{"id":"blk-34615","kind":"paragraph","spans":[{"id":"spn-38965","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-34614","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34616","kind":"paragraph","spans":[{"id":"spn-38966","text":"We need an analogous but distinct mechanism for "},{"id":"spn-38967","marks":["bold"],"text":"delegated invocation"},{"id":"spn-38968","text":"."}]},{"id":"blk-34617","kind":"paragraph","spans":[{"id":"spn-38969","text":"---"}]},{"id":"blk-34618","kind":"heading","level":2,"spans":[{"id":"spn-38970","text":"2) Decision"}]},{"id":"blk-34619","kind":"heading","level":3,"spans":[{"id":"spn-38971","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-34620","kind":"paragraph","spans":[{"id":"spn-38972","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-34621","items":[{"blocks":[{"id":"blk-34623","kind":"paragraph","spans":[{"id":"spn-38973","text":"The delegator sends a request with:"}]}],"id":"blk-34622","kind":"list-item"},{"blocks":[{"id":"blk-34625","kind":"paragraph","spans":[{"id":"spn-38974","text":"an HMAC signature computed over the "},{"id":"spn-38975","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-38976","text":"."}]}],"id":"blk-34624","kind":"list-item"},{"blocks":[{"id":"blk-34627","kind":"paragraph","spans":[{"id":"spn-38977","text":"a timestamp used for replay protection."}]}],"id":"blk-34626","kind":"list-item"},{"blocks":[{"id":"blk-34629","kind":"paragraph","spans":[{"id":"spn-38978","text":"a declared delegated end-user identity ("},{"id":"spn-38979","marks":["code"],"text":"externalUserId"},{"id":"spn-38980","text":") in the JSON body."}]}],"id":"blk-34628","kind":"list-item"},{"blocks":[{"id":"blk-34631","kind":"paragraph","spans":[{"id":"spn-38981","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-34630","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34632","kind":"paragraph","spans":[{"id":"spn-38982","text":"This is "},{"id":"spn-38983","marks":["bold"],"text":"service authentication"},{"id":"spn-38984","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-34633","kind":"heading","level":3,"spans":[{"id":"spn-38985","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-34634","kind":"paragraph","spans":[{"id":"spn-38986","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-34635","items":[{"blocks":[{"id":"blk-34637","kind":"paragraph","spans":[{"id":"spn-38987","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-34636","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34638","kind":"paragraph","spans":[{"id":"spn-38988","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-34639","kind":"heading","level":3,"spans":[{"id":"spn-38989","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-34640","kind":"paragraph","spans":[{"id":"spn-38990","text":"For delegated invocations:"}]},{"id":"blk-34641","items":[{"blocks":[{"id":"blk-34643","kind":"paragraph","spans":[{"id":"spn-38991","text":"WHS resolves "},{"id":"spn-38992","marks":["code"],"text":"externalUserId"},{"id":"spn-38993","text":" to a WHS "},{"id":"spn-38994","marks":["code"],"text":"users"},{"id":"spn-38995","text":" row."}]}],"id":"blk-34642","kind":"list-item"},{"blocks":[{"id":"blk-34645","kind":"paragraph","spans":[{"id":"spn-38996","text":"WHS enforces all standard checks "},{"id":"spn-38997","marks":["bold"],"text":"as that user"},{"id":"spn-38998","text":", including:"}]}],"id":"blk-34644","kind":"list-item"},{"blocks":[{"id":"blk-34647","kind":"paragraph","spans":[{"id":"spn-38999","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-34646","kind":"list-item"},{"blocks":[{"id":"blk-34649","kind":"paragraph","spans":[{"id":"spn-39000","text":"agent status (not disabled),"}]}],"id":"blk-34648","kind":"list-item"},{"blocks":[{"id":"blk-34651","kind":"paragraph","spans":[{"id":"spn-39001","text":"active deployment present,"}]}],"id":"blk-34650","kind":"list-item"},{"blocks":[{"id":"blk-34653","kind":"paragraph","spans":[{"id":"spn-39002","text":"plan entitlements and limits,"}]}],"id":"blk-34652","kind":"list-item"},{"blocks":[{"id":"blk-34655","kind":"paragraph","spans":[{"id":"spn-39003","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-34654","kind":"list-item"},{"blocks":[{"id":"blk-34657","kind":"paragraph","spans":[{"id":"spn-39004","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-34656","kind":"list-item"},{"blocks":[{"id":"blk-34659","kind":"paragraph","spans":[{"id":"spn-39005","text":"any additional internal safety controls."}]}],"id":"blk-34658","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34660","kind":"paragraph","spans":[{"id":"spn-39006","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-34661","kind":"paragraph","spans":[{"id":"spn-39007","text":"---"}]},{"id":"blk-34662","kind":"heading","level":2,"spans":[{"id":"spn-39008","text":"3) Normative request authentication"}]},{"id":"blk-34663","kind":"heading","level":3,"spans":[{"id":"spn-39009","text":"3.1 Required headers"}]},{"id":"blk-34664","kind":"paragraph","spans":[{"id":"spn-39010","text":"Delegated requests MUST include:"}]},{"id":"blk-34665","items":[{"blocks":[{"id":"blk-34667","kind":"paragraph","spans":[{"id":"spn-39011","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-34666","kind":"list-item"},{"blocks":[{"id":"blk-34669","kind":"paragraph","spans":[{"id":"spn-39012","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-34668","kind":"list-item"},{"blocks":[{"id":"blk-34671","kind":"paragraph","spans":[{"id":"spn-39013","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-34670","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34672","kind":"paragraph","spans":[{"id":"spn-39014","text":"Rules:"}]},{"id":"blk-34673","items":[{"blocks":[{"id":"blk-34675","kind":"paragraph","spans":[{"id":"spn-39015","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-34674","kind":"list-item"},{"blocks":[{"id":"blk-34677","kind":"paragraph","spans":[{"id":"spn-39016","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-34676","kind":"list-item"},{"blocks":[{"id":"blk-34679","kind":"paragraph","spans":[{"id":"spn-39017","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-34678","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34680","kind":"paragraph","spans":[{"id":"spn-39018","text":"Recommended default skew window:"}]},{"id":"blk-34681","items":[{"blocks":[{"id":"blk-34683","kind":"paragraph","spans":[{"id":"spn-39019","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-39020","text":" (5 minutes)"}]}],"id":"blk-34682","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34684","kind":"paragraph","spans":[{"id":"spn-39021","text":"If signature or timestamp validation fails:"}]},{"id":"blk-34685","items":[{"blocks":[{"id":"blk-34687","kind":"paragraph","spans":[{"id":"spn-39022","text":"return a normalized error:"}]}],"id":"blk-34686","kind":"list-item"},{"blocks":[{"id":"blk-34689","kind":"paragraph","spans":[{"id":"spn-39023","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-34688","kind":"list-item"},{"blocks":[{"id":"blk-34691","kind":"paragraph","spans":[{"id":"spn-39024","text":"safe "},{"id":"spn-39025","marks":["code"],"text":"message"}]}],"id":"blk-34690","kind":"list-item"},{"blocks":[{"id":"blk-34693","kind":"paragraph","spans":[{"id":"spn-39026","marks":["code"],"text":"retryable: false"},{"id":"spn-39027","text":" (recommended)"}]}],"id":"blk-34692","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34694","kind":"heading","level":3,"spans":[{"id":"spn-39028","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-34695","kind":"paragraph","spans":[{"id":"spn-39029","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-34696","items":[{"blocks":[{"id":"blk-34698","kind":"paragraph","spans":[{"id":"spn-39030","text":"e.g., "},{"id":"spn-39031","marks":["code"],"text":"agentromatic"},{"id":"spn-39032","text":", "},{"id":"spn-39033","marks":["code"],"text":"agentelic"},{"id":"spn-39034","text":" (future), "},{"id":"spn-39035","marks":["code"],"text":"internal"}]}],"id":"blk-34697","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34699","kind":"paragraph","spans":[{"id":"spn-39036","text":"Requests with an unknown "},{"id":"spn-39037","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-39038","text":" SHOULD be rejected with "},{"id":"spn-39039","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-39040","text":"."}]},{"id":"blk-34700","kind":"paragraph","spans":[{"id":"spn-39041","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-34701","kind":"heading","level":3,"spans":[{"id":"spn-39042","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-34702","kind":"paragraph","spans":[{"id":"spn-39043","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-34703","items":[{"blocks":[{"id":"blk-34705","kind":"paragraph","spans":[{"id":"spn-39044","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-34704","kind":"list-item"},{"blocks":[{"id":"blk-34707","kind":"paragraph","spans":[{"id":"spn-39045","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-39046","text":" (stable external auth subject id)"}]}],"id":"blk-34706","kind":"list-item"},{"blocks":[{"id":"blk-34709","kind":"paragraph","spans":[{"id":"spn-39047","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-39048","text":" (see §5)"}]}],"id":"blk-34708","kind":"list-item"},{"blocks":[{"id":"blk-34711","kind":"paragraph","spans":[{"id":"spn-39049","text":"optional correlation metadata for observability:"}]}],"id":"blk-34710","kind":"list-item"},{"blocks":[{"id":"blk-34713","kind":"paragraph","spans":[{"id":"spn-39050","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-34712","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34714","kind":"paragraph","spans":[{"id":"spn-39051","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-39052","marks":["code"],"text":"invoke"},{"id":"spn-39053","text":" (compatible with "},{"id":"spn-39054","marks":["code"],"text":"InvokeRequest"},{"id":"spn-39055","text":")."}]},{"id":"blk-34715","kind":"paragraph","spans":[{"id":"spn-39056","text":"The body MUST NOT include:"}]},{"id":"blk-34716","items":[{"blocks":[{"id":"blk-34718","kind":"paragraph","spans":[{"id":"spn-39057","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-34717","kind":"list-item"},{"blocks":[{"id":"blk-34720","kind":"paragraph","spans":[{"id":"spn-39058","text":"raw end-user auth tokens"}]}],"id":"blk-34719","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34721","kind":"paragraph","spans":[{"id":"spn-39059","text":"---"}]},{"id":"blk-34722","kind":"heading","level":2,"spans":[{"id":"spn-39060","text":"4) Error semantics"}]},{"id":"blk-34723","kind":"paragraph","spans":[{"id":"spn-39061","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-34724","kind":"paragraph","spans":[{"id":"spn-39062","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-34725","items":[{"blocks":[{"id":"blk-34727","kind":"paragraph","spans":[{"id":"spn-39063","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-39064","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-34726","kind":"list-item"},{"blocks":[{"id":"blk-34729","kind":"paragraph","spans":[{"id":"spn-39065","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-39066","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-34728","kind":"list-item"},{"blocks":[{"id":"blk-34731","kind":"paragraph","spans":[{"id":"spn-39067","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-39068","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-34730","kind":"list-item"},{"blocks":[{"id":"blk-34733","kind":"paragraph","spans":[{"id":"spn-39069","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-39070","text":" (plan limits)"}]}],"id":"blk-34732","kind":"list-item"},{"blocks":[{"id":"blk-34735","kind":"paragraph","spans":[{"id":"spn-39071","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-39072","text":" (bad schema, oversized payload)"}]}],"id":"blk-34734","kind":"list-item"},{"blocks":[{"id":"blk-34737","kind":"paragraph","spans":[{"id":"spn-39073","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-39074","text":" (provider/runtime failures)"}]}],"id":"blk-34736","kind":"list-item"},{"blocks":[{"id":"blk-34739","kind":"paragraph","spans":[{"id":"spn-39075","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-34738","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34740","kind":"paragraph","spans":[{"id":"spn-39076","text":"Consistency rule:"}]},{"id":"blk-34741","items":[{"blocks":[{"id":"blk-34743","kind":"paragraph","spans":[{"id":"spn-39077","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-39078","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-39079","text":" over "},{"id":"spn-39080","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-39081","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-34742","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34744","kind":"paragraph","spans":[{"id":"spn-39082","text":"---"}]},{"id":"blk-34745","kind":"heading","level":2,"spans":[{"id":"spn-39083","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-34746","kind":"paragraph","spans":[{"id":"spn-39084","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-34747","kind":"heading","level":3,"spans":[{"id":"spn-39085","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-34748","kind":"paragraph","spans":[{"id":"spn-39086","text":"Delegated invocation requests MUST include "},{"id":"spn-39087","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-39088","text":"."}]},{"id":"blk-34749","kind":"paragraph","spans":[{"id":"spn-39089","text":"The key MUST be:"}]},{"id":"blk-34750","items":[{"blocks":[{"id":"blk-34752","kind":"paragraph","spans":[{"id":"spn-39090","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-34751","kind":"list-item"},{"blocks":[{"id":"blk-34754","kind":"paragraph","spans":[{"id":"spn-39091","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-34753","kind":"list-item"},{"blocks":[{"id":"blk-34756","kind":"paragraph","spans":[{"id":"spn-39092","text":"secret-free,"}]}],"id":"blk-34755","kind":"list-item"},{"blocks":[{"id":"blk-34758","kind":"paragraph","spans":[{"id":"spn-39093","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-34757","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34759","kind":"heading","level":3,"spans":[{"id":"spn-39094","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-34760","kind":"paragraph","spans":[{"id":"spn-39095","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-34761","items":[{"blocks":[{"id":"blk-34763","kind":"paragraph","spans":[{"id":"spn-39096","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-34762","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34764","kind":"paragraph","spans":[{"id":"spn-39097","text":"Behavior:"}]},{"id":"blk-34765","items":[{"blocks":[{"id":"blk-34767","kind":"paragraph","spans":[{"id":"spn-39098","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-34766","kind":"list-item"},{"blocks":[{"id":"blk-34769","kind":"paragraph","spans":[{"id":"spn-39099","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-34768","kind":"list-item"},{"blocks":[{"id":"blk-34771","kind":"paragraph","spans":[{"id":"spn-39100","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-34770","kind":"list-item"},{"blocks":[{"id":"blk-34773","kind":"paragraph","spans":[{"id":"spn-39101","marks":["code"],"text":"CONFLICT"},{"id":"spn-39102","text":" or "},{"id":"spn-39103","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-39104","text":" (choose one; keep consistent),"}]}],"id":"blk-34772","kind":"list-item"},{"blocks":[{"id":"blk-34775","kind":"paragraph","spans":[{"id":"spn-39105","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-34774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34776","kind":"paragraph","spans":[{"id":"spn-39106","text":"Implementation guidance (non-normative):"}]},{"id":"blk-34777","items":[{"blocks":[{"id":"blk-34779","kind":"paragraph","spans":[{"id":"spn-39107","text":"Store an idempotency ledger row containing:"}]}],"id":"blk-34778","kind":"list-item"},{"blocks":[{"id":"blk-34781","kind":"paragraph","spans":[{"id":"spn-39108","text":"request hash (e.g., sha256 of raw bytes),"}]}],"id":"blk-34780","kind":"list-item"},{"blocks":[{"id":"blk-34783","kind":"paragraph","spans":[{"id":"spn-39109","text":"response payload or response reference (bounded),"}]}],"id":"blk-34782","kind":"list-item"},{"blocks":[{"id":"blk-34785","kind":"paragraph","spans":[{"id":"spn-39110","text":"traceId/sessionId,"}]}],"id":"blk-34784","kind":"list-item"},{"blocks":[{"id":"blk-34787","kind":"paragraph","spans":[{"id":"spn-39111","text":"timestamps and status."}]}],"id":"blk-34786","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34788","kind":"paragraph","spans":[{"id":"spn-39112","text":"---"}]},{"id":"blk-34789","kind":"heading","level":2,"spans":[{"id":"spn-39113","text":"6) Security analysis (threats and mitigations)"}]},{"id":"blk-34790","kind":"heading","level":3,"spans":[{"id":"spn-39114","text":"6.1 Threat: delegator attempts to invoke as another user"}]},{"id":"blk-34791","kind":"paragraph","spans":[{"id":"spn-39115","text":"Mitigation:"}]},{"id":"blk-34792","items":[{"blocks":[{"id":"blk-34794","kind":"paragraph","spans":[{"id":"spn-39116","text":"WHS enforces authorization based on "},{"id":"spn-39117","marks":["code"],"text":"externalUserId"},{"id":"spn-39118","text":" resolved user row."}]}],"id":"blk-34793","kind":"list-item"},{"blocks":[{"id":"blk-34796","kind":"paragraph","spans":[{"id":"spn-39119","text":"WHS enforces ownership/visibility checks and entitlements."}]}],