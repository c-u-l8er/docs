{"bendscript":"0.1","blocks":[{"id":"blk-52945","kind":"heading","level":1,"spans":[{"id":"spn-79295","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-52946","items":[{"blocks":[{"id":"blk-52948","kind":"paragraph","spans":[{"id":"spn-79296","marks":["bold"],"text":"Status:"},{"id":"spn-79297","text":" Accepted"}]}],"id":"blk-52947","kind":"list-item"},{"blocks":[{"id":"blk-52950","kind":"paragraph","spans":[{"id":"spn-79298","marks":["bold"],"text":"Date:"},{"id":"spn-79299","text":" 2026-01-24"}]}],"id":"blk-52949","kind":"list-item"},{"blocks":[{"id":"blk-52952","kind":"paragraph","spans":[{"id":"spn-79300","marks":["bold"],"text":"Owners:"},{"id":"spn-79301","text":" Engineering"}]}],"id":"blk-52951","kind":"list-item"},{"blocks":[{"id":"blk-52954","kind":"paragraph","spans":[{"id":"spn-79302","marks":["bold"],"text":"Applies to:"},{"id":"spn-79303","text":" "},{"id":"spn-79304","marks":["code"],"text":"webhost.systems"},{"id":"spn-79305","text":" control plane"}]}],"id":"blk-52953","kind":"list-item"},{"blocks":[{"id":"blk-52956","kind":"paragraph","spans":[{"id":"spn-79306","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-79307","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-52955","kind":"list-item"},{"blocks":[{"id":"blk-52958","kind":"paragraph","spans":[{"id":"spn-79308","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-52957","kind":"list-item"},{"blocks":[{"id":"blk-52960","kind":"paragraph","spans":[{"id":"spn-79309","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-79310","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-52959","kind":"list-item"},{"blocks":[{"id":"blk-52962","kind":"paragraph","spans":[{"id":"spn-79311","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-79312","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-52961","kind":"list-item"},{"blocks":[{"id":"blk-52964","kind":"paragraph","spans":[{"id":"spn-79313","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-79314","text":" (invoke contract)"}]}],"id":"blk-52963","kind":"list-item"},{"blocks":[{"id":"blk-52966","kind":"paragraph","spans":[{"id":"spn-79315","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-79316","text":" (tenant isolation; access control)"}]}],"id":"blk-52965","kind":"list-item"},{"blocks":[{"id":"blk-52968","kind":"paragraph","spans":[{"id":"spn-79317","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-79318","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-52967","kind":"list-item"},{"blocks":[{"id":"blk-52970","kind":"paragraph","spans":[{"id":"spn-79319","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-79320","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-52969","kind":"list-item"},{"blocks":[{"id":"blk-52972","kind":"paragraph","spans":[{"id":"spn-79321","text":"External integration: "},{"id":"spn-79322","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-79323","text":" (consumer contract)"}]}],"id":"blk-52971","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52973","kind":"heading","level":2,"spans":[{"id":"spn-79324","text":"1) Context"}]},{"id":"blk-52974","kind":"paragraph","spans":[{"id":"spn-79325","text":"The canonical WHS invocation endpoint ("},{"id":"spn-79326","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-79327","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-52975","kind":"paragraph","spans":[{"id":"spn-79328","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-52976","items":[{"blocks":[{"id":"blk-52978","kind":"paragraph","spans":[{"id":"spn-79329","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-52977","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52979","kind":"paragraph","spans":[{"id":"spn-79330","text":"Constraints:"}]},{"id":"blk-52980","items":[{"blocks":[{"id":"blk-52982","kind":"paragraph","spans":[{"id":"spn-79331","text":"Server-side orchestrators should "},{"id":"spn-79332","marks":["bold"],"text":"not"},{"id":"spn-79333","text":" rely on browser tokens."}]}],"id":"blk-52981","kind":"list-item"},{"blocks":[{"id":"blk-52984","kind":"paragraph","spans":[{"id":"spn-79334","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-52983","kind":"list-item"},{"blocks":[{"id":"blk-52986","kind":"paragraph","spans":[{"id":"spn-79335","text":"WHS must remain authoritative for:"}]}],"id":"blk-52985","kind":"list-item"},{"blocks":[{"id":"blk-52988","kind":"paragraph","spans":[{"id":"spn-79336","text":"agent ownership/visibility,"}]}],"id":"blk-52987","kind":"list-item"},{"blocks":[{"id":"blk-52990","kind":"paragraph","spans":[{"id":"spn-79337","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-52989","kind":"list-item"},{"blocks":[{"id":"blk-52992","kind":"paragraph","spans":[{"id":"spn-79338","text":"telemetry, usage, billing."}]}],"id":"blk-52991","kind":"list-item"},{"blocks":[{"id":"blk-52994","kind":"paragraph","spans":[{"id":"spn-79339","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-52993","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52995","kind":"paragraph","spans":[{"id":"spn-79340","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-52996","items":[{"blocks":[{"id":"blk-52998","kind":"paragraph","spans":[{"id":"spn-79341","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-52997","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52999","kind":"paragraph","spans":[{"id":"spn-79342","text":"We need an analogous but distinct mechanism for "},{"id":"spn-79343","marks":["bold"],"text":"delegated invocation"},{"id":"spn-79344","text":"."}]},{"id":"blk-53000","kind":"heading","level":2,"spans":[{"id":"spn-79345","text":"2) Decision"}]},{"id":"blk-53001","kind":"heading","level":3,"spans":[{"id":"spn-79346","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-53002","kind":"paragraph","spans":[{"id":"spn-79347","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-53003","items":[{"blocks":[{"id":"blk-53005","kind":"paragraph","spans":[{"id":"spn-79348","text":"The delegator sends a request with:"}]}],"id":"blk-53004","kind":"list-item"},{"blocks":[{"id":"blk-53007","kind":"paragraph","spans":[{"id":"spn-79349","text":"an HMAC signature computed over the "},{"id":"spn-79350","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-79351","text":"."}]}],"id":"blk-53006","kind":"list-item"},{"blocks":[{"id":"blk-53009","kind":"paragraph","spans":[{"id":"spn-79352","text":"a timestamp used for replay protection."}]}],"id":"blk-53008","kind":"list-item"},{"blocks":[{"id":"blk-53011","kind":"paragraph","spans":[{"id":"spn-79353","text":"a declared delegated end-user identity ("},{"id":"spn-79354","marks":["code"],"text":"externalUserId"},{"id":"spn-79355","text":") in the JSON body."}]}],"id":"blk-53010","kind":"list-item"},{"blocks":[{"id":"blk-53013","kind":"paragraph","spans":[{"id":"spn-79356","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-53012","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53014","kind":"paragraph","spans":[{"id":"spn-79357","text":"This is "},{"id":"spn-79358","marks":["bold"],"text":"service authentication"},{"id":"spn-79359","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-53015","kind":"heading","level":3,"spans":[{"id":"spn-79360","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-53016","kind":"paragraph","spans":[{"id":"spn-79361","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-53017","items":[{"blocks":[{"id":"blk-53019","kind":"paragraph","spans":[{"id":"spn-79362","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-53018","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53020","kind":"paragraph","spans":[{"id":"spn-79363","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-53021","kind":"heading","level":3,"spans":[{"id":"spn-79364","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-53022","kind":"paragraph","spans":[{"id":"spn-79365","text":"For delegated invocations:"}]},{"id":"blk-53023","items":[{"blocks":[{"id":"blk-53025","kind":"paragraph","spans":[{"id":"spn-79366","text":"WHS resolves "},{"id":"spn-79367","marks":["code"],"text":"externalUserId"},{"id":"spn-79368","text":" to a WHS "},{"id":"spn-79369","marks":["code"],"text":"users"},{"id":"spn-79370","text":" row."}]}],"id":"blk-53024","kind":"list-item"},{"blocks":[{"id":"blk-53027","kind":"paragraph","spans":[{"id":"spn-79371","text":"WHS enforces all standard checks "},{"id":"spn-79372","marks":["bold"],"text":"as that user"},{"id":"spn-79373","text":", including:"}]}],"id":"blk-53026","kind":"list-item"},{"blocks":[{"id":"blk-53029","kind":"paragraph","spans":[{"id":"spn-79374","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-53028","kind":"list-item"},{"blocks":[{"id":"blk-53031","kind":"paragraph","spans":[{"id":"spn-79375","text":"agent status (not disabled),"}]}],"id":"blk-53030","kind":"list-item"},{"blocks":[{"id":"blk-53033","kind":"paragraph","spans":[{"id":"spn-79376","text":"active deployment present,"}]}],"id":"blk-53032","kind":"list-item"},{"blocks":[{"id":"blk-53035","kind":"paragraph","spans":[{"id":"spn-79377","text":"plan entitlements and limits,"}]}],"id":"blk-53034","kind":"list-item"},{"blocks":[{"id":"blk-53037","kind":"paragraph","spans":[{"id":"spn-79378","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-53036","kind":"list-item"},{"blocks":[{"id":"blk-53039","kind":"paragraph","spans":[{"id":"spn-79379","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-53038","kind":"list-item"},{"blocks":[{"id":"blk-53041","kind":"paragraph","spans":[{"id":"spn-79380","text":"any additional internal safety controls."}]}],"id":"blk-53040","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53042","kind":"paragraph","spans":[{"id":"spn-79381","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-53043","kind":"heading","level":2,"spans":[{"id":"spn-79382","text":"3) Normative request authentication"}]},{"id":"blk-53044","kind":"heading","level":3,"spans":[{"id":"spn-79383","text":"3.1 Required headers"}]},{"id":"blk-53045","kind":"paragraph","spans":[{"id":"spn-79384","text":"Delegated requests MUST include:"}]},{"id":"blk-53046","items":[{"blocks":[{"id":"blk-53048","kind":"paragraph","spans":[{"id":"spn-79385","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-53047","kind":"list-item"},{"blocks":[{"id":"blk-53050","kind":"paragraph","spans":[{"id":"spn-79386","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-53049","kind":"list-item"},{"blocks":[{"id":"blk-53052","kind":"paragraph","spans":[{"id":"spn-79387","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-53051","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53053","kind":"paragraph","spans":[{"id":"spn-79388","text":"Rules:"}]},{"id":"blk-53054","items":[{"blocks":[{"id":"blk-53056","kind":"paragraph","spans":[{"id":"spn-79389","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-53055","kind":"list-item"},{"blocks":[{"id":"blk-53058","kind":"paragraph","spans":[{"id":"spn-79390","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-53057","kind":"list-item"},{"blocks":[{"id":"blk-53060","kind":"paragraph","spans":[{"id":"spn-79391","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-53059","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53061","kind":"paragraph","spans":[{"id":"spn-79392","text":"Recommended default skew window:"}]},{"id":"blk-53062","items":[{"blocks":[{"id":"blk-53064","kind":"paragraph","spans":[{"id":"spn-79393","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-79394","text":" (5 minutes)"}]}],"id":"blk-53063","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53065","kind":"paragraph","spans":[{"id":"spn-79395","text":"If signature or timestamp validation fails:"}]},{"id":"blk-53066","items":[{"blocks":[{"id":"blk-53068","kind":"paragraph","spans":[{"id":"spn-79396","text":"return a normalized error:"}]}],"id":"blk-53067","kind":"list-item"},{"blocks":[{"id":"blk-53070","kind":"paragraph","spans":[{"id":"spn-79397","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-53069","kind":"list-item"},{"blocks":[{"id":"blk-53072","kind":"paragraph","spans":[{"id":"spn-79398","text":"safe "},{"id":"spn-79399","marks":["code"],"text":"message"}]}],"id":"blk-53071","kind":"list-item"},{"blocks":[{"id":"blk-53074","kind":"paragraph","spans":[{"id":"spn-79400","marks":["code"],"text":"retryable: false"},{"id":"spn-79401","text":" (recommended)"}]}],"id":"blk-53073","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53075","kind":"heading","level":3,"spans":[{"id":"spn-79402","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-53076","kind":"paragraph","spans":[{"id":"spn-79403","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-53077","items":[{"blocks":[{"id":"blk-53079","kind":"paragraph","spans":[{"id":"spn-79404","text":"e.g., "},{"id":"spn-79405","marks":["code"],"text":"agentromatic"},{"id":"spn-79406","text":", "},{"id":"spn-79407","marks":["code"],"text":"agentelic"},{"id":"spn-79408","text":" (future), "},{"id":"spn-79409","marks":["code"],"text":"internal"}]}],"id":"blk-53078","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53080","kind":"paragraph","spans":[{"id":"spn-79410","text":"Requests with an unknown "},{"id":"spn-79411","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-79412","text":" SHOULD be rejected with "},{"id":"spn-79413","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-79414","text":"."}]},{"id":"blk-53081","kind":"paragraph","spans":[{"id":"spn-79415","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-53082","kind":"heading","level":3,"spans":[{"id":"spn-79416","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-53083","kind":"paragraph","spans":[{"id":"spn-79417","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-53084","items":[{"blocks":[{"id":"blk-53086","kind":"paragraph","spans":[{"id":"spn-79418","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-53085","kind":"list-item"},{"blocks":[{"id":"blk-53088","kind":"paragraph","spans":[{"id":"spn-79419","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-79420","text":" (stable external auth subject id)"}]}],"id":"blk-53087","kind":"list-item"},{"blocks":[{"id":"blk-53090","kind":"paragraph","spans":[{"id":"spn-79421","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-79422","text":" (see §5)"}]}],"id":"blk-53089","kind":"list-item"},{"blocks":[{"id":"blk-53092","kind":"paragraph","spans":[{"id":"spn-79423","text":"optional correlation metadata for observability:"}]}],"id":"blk-53091","kind":"list-item"},{"blocks":[{"id":"blk-53094","kind":"paragraph","spans":[{"id":"spn-79424","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-53093","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53095","kind":"paragraph","spans":[{"id":"spn-79425","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-79426","marks":["code"],"text":"invoke"},{"id":"spn-79427","text":" (compatible with "},{"id":"spn-79428","marks":["code"],"text":"InvokeRequest"},{"id":"spn-79429","text":")."}]},{"id":"blk-53096","kind":"paragraph","spans":[{"id":"spn-79430","text":"The body MUST NOT include:"}]},{"id":"blk-53097","items":[{"blocks":[{"id":"blk-53099","kind":"paragraph","spans":[{"id":"spn-79431","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-53098","kind":"list-item"},{"blocks":[{"id":"blk-53101","kind":"paragraph","spans":[{"id":"spn-79432","text":"raw end-user auth tokens"}]}],"id":"blk-53100","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53102","kind":"heading","level":2,"spans":[{"id":"spn-79433","text":"4) Error semantics"}]},{"id":"blk-53103","kind":"paragraph","spans":[{"id":"spn-79434","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-53104","kind":"paragraph","spans":[{"id":"spn-79435","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-53105","items":[{"blocks":[{"id":"blk-53107","kind":"paragraph","spans":[{"id":"spn-79436","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-79437","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-53106","kind":"list-item"},{"blocks":[{"id":"blk-53109","kind":"paragraph","spans":[{"id":"spn-79438","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-79439","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-53108","kind":"list-item"},{"blocks":[{"id":"blk-53111","kind":"paragraph","spans":[{"id":"spn-79440","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-79441","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-53110","kind":"list-item"},{"blocks":[{"id":"blk-53113","kind":"paragraph","spans":[{"id":"spn-79442","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-79443","text":" (plan limits)"}]}],"id":"blk-53112","kind":"list-item"},{"blocks":[{"id":"blk-53115","kind":"paragraph","spans":[{"id":"spn-79444","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-79445","text":" (bad schema, oversized payload)"}]}],"id":"blk-53114","kind":"list-item"},{"blocks":[{"id":"blk-53117","kind":"paragraph","spans":[{"id":"spn-79446","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-79447","text":" (provider/runtime failures)"}]}],"id":"blk-53116","kind":"list-item"},{"blocks":[{"id":"blk-53119","kind":"paragraph","spans":[{"id":"spn-79448","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-53118","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53120","kind":"paragraph","spans":[{"id":"spn-79449","text":"Consistency rule:"}]},{"id":"blk-53121","items":[{"blocks":[{"id":"blk-53123","kind":"paragraph","spans":[{"id":"spn-79450","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-79451","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-79452","text":" over "},{"id":"spn-79453","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-79454","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-53122","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53124","kind":"heading","level":2,"spans":[{"id":"spn-79455","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-53125","kind":"paragraph","spans":[{"id":"spn-79456","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-53126","kind":"heading","level":3,"spans":[{"id":"spn-79457","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-53127","kind":"paragraph","spans":[{"id":"spn-79458","text":"Delegated invocation requests MUST include "},{"id":"spn-79459","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-79460","text":"."}]},{"id":"blk-53128","kind":"paragraph","spans":[{"id":"spn-79461","text":"The key MUST be:"}]},{"id":"blk-53129","items":[{"blocks":[{"id":"blk-53131","kind":"paragraph","spans":[{"id":"spn-79462","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-53130","kind":"list-item"},{"blocks":[{"id":"blk-53133","kind":"paragraph","spans":[{"id":"spn-79463","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-53132","kind":"list-item"},{"blocks":[{"id":"blk-53135","kind":"paragraph","spans":[{"id":"spn-79464","text":"secret-free,"}]}],"id":"blk-53134","kind":"list-item"},{"blocks":[{"id":"blk-53137","kind":"paragraph","spans":[{"id":"spn-79465","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-53136","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53138","kind":"heading","level":3,"spans":[{"id":"spn-79466","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-53139","kind":"paragraph","spans":[{"id":"spn-79467","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-53140","items":[{"blocks":[{"id":"blk-53142","kind":"paragraph","spans":[{"id":"spn-79468","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-53141","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53143","kind":"paragraph","spans":[{"id":"spn-79469","text":"Behavior:"}]},{"id":"blk-53144","items":[{"blocks":[{"id":"blk-53146","kind":"paragraph","spans":[{"id":"spn-79470","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-53145","kind":"list-item"},{"blocks":[{"id":"blk-53148","kind":"paragraph","spans":[{"id":"spn-79471","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-53147","kind":"list-item"},{"blocks":[{"id":"blk-53150","kind":"paragraph","spans":[{"id":"spn-79472","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-53149","kind":"list-item"},{"blocks":[{"id":"blk-53152","kind":"paragraph","spans":[{"id":"spn-79473","marks":["code"],"text":"CONFLICT"},{"id":"spn-79474","text":" or "},{"id":"spn-79475","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-79476","text":" (choose one; keep consistent),"}]}],"id":"blk-53151","kind":"list-item"},{"blocks":[{"id":"blk-53154","kind":"paragraph","spans":[{"id":"spn-79477","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-53153","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53155","kind":"paragraph","spans":[{"id":"spn-79478","text":"Implementation guidance (non-normative):"}]},{"id":"blk-53156","items":[{"blocks":[{"id":"blk-53158","kind":"paragraph","spans":[{"id":"spn-79479","text":"Store an idempotency ledger row containing:"}]}],"id":"blk-53157","kind":"list-item"},{"blocks":[{"id":"blk-53160","kind":"paragraph","spans":[{"id":"spn-79480","text":"request hash (e.g., sha256 of raw bytes),"}]}],"id":"blk-53159","kind":"list-item"},{"blocks":[{"id":"blk-53162","kind":"paragraph","spans":[{"id":"spn-79481","text":"response payload or response reference (bounded),"}]}],"id":"blk-53161","kind":"list-item"},{"blocks":[{"id":"blk-53164","kind":"paragraph","spans":[{"id":"spn-79482","text":"traceId/sessionId,"}]}],"id":"blk-53163","kind":"list-item"},{"blocks":[{"id":"blk-53166","kind":"paragraph","spans":[{"id":"spn-79483","text":"timestamps and status."}]}],"id":"blk-53165","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53167","kind":"heading","level":2,"spans":[{"id":"spn-79484","text":"6) Security analysis (threats and mitigations)"}]},{"id":"blk-53168","kind":"heading","level":3,"spans":[{"id":"spn-79485","text":"6.1 Threat: delegator attempts to invoke as another user"}]},{"id":"blk-53169","kind":"paragraph","spans":[{"id":"spn-79486","text":"Mitigation:"}]},{"id":"blk-53170","items":[{"blocks":[{"id":"blk-53172","kind":"paragraph","spans":[{"id":"spn-79487","text":"WHS enforces authorization based on "},{"id":"spn-79488","marks":["code"],"text":"externalUserId"},{"id":"spn-79489","text":" resolved user row."}]}],"id":"blk-53171","kind":"list-item"},{"blocks":[{"id":"blk-53174","kind":"paragraph","spans":[{"id":"spn-79490","text":"WHS enforces ownership/visibility checks and entitlements."}]}],"id":"blk-53173","kind":"list-item"},{"blocks":[{"id":"blk-53176","kind":"paragraph","spans":[{"id":"spn-79491","text":"Delegation does not grant cross-tenant access."}]}],"id":"blk-53175","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53177","kind":"heading","level":3,"spans":[{"id":"spn-79492","text":"6.2 Threat: replay attacks"}]},{"id":"blk-53178","kind":"paragraph","spans":[{"id":"spn-79493","text":"Mitigation:"}]},{"id":"blk-53179","items":[{"blocks":[{"