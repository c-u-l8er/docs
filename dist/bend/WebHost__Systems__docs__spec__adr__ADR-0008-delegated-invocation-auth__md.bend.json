{"bendscript":"0.1","blocks":[{"id":"blk-34075","kind":"heading","level":1,"spans":[{"id":"spn-37802","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-34076","items":[{"blocks":[{"id":"blk-34078","kind":"paragraph","spans":[{"id":"spn-37803","marks":["bold"],"text":"Status:"},{"id":"spn-37804","text":" Accepted"}]}],"id":"blk-34077","kind":"list-item"},{"blocks":[{"id":"blk-34080","kind":"paragraph","spans":[{"id":"spn-37805","marks":["bold"],"text":"Date:"},{"id":"spn-37806","text":" 2026-01-24"}]}],"id":"blk-34079","kind":"list-item"},{"blocks":[{"id":"blk-34082","kind":"paragraph","spans":[{"id":"spn-37807","marks":["bold"],"text":"Owners:"},{"id":"spn-37808","text":" Engineering"}]}],"id":"blk-34081","kind":"list-item"},{"blocks":[{"id":"blk-34084","kind":"paragraph","spans":[{"id":"spn-37809","marks":["bold"],"text":"Applies to:"},{"id":"spn-37810","text":" "},{"id":"spn-37811","marks":["code"],"text":"webhost.systems"},{"id":"spn-37812","text":" control plane"}]}],"id":"blk-34083","kind":"list-item"},{"blocks":[{"id":"blk-34086","kind":"paragraph","spans":[{"id":"spn-37813","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-37814","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-34085","kind":"list-item"},{"blocks":[{"id":"blk-34088","kind":"paragraph","spans":[{"id":"spn-37815","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-34087","kind":"list-item"},{"blocks":[{"id":"blk-34090","kind":"paragraph","spans":[{"id":"spn-37816","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-37817","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-34089","kind":"list-item"},{"blocks":[{"id":"blk-34092","kind":"paragraph","spans":[{"id":"spn-37818","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-37819","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-34091","kind":"list-item"},{"blocks":[{"id":"blk-34094","kind":"paragraph","spans":[{"id":"spn-37820","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-37821","text":" (invoke contract)"}]}],"id":"blk-34093","kind":"list-item"},{"blocks":[{"id":"blk-34096","kind":"paragraph","spans":[{"id":"spn-37822","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-37823","text":" (tenant isolation; access control)"}]}],"id":"blk-34095","kind":"list-item"},{"blocks":[{"id":"blk-34098","kind":"paragraph","spans":[{"id":"spn-37824","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-37825","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-34097","kind":"list-item"},{"blocks":[{"id":"blk-34100","kind":"paragraph","spans":[{"id":"spn-37826","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-37827","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-34099","kind":"list-item"},{"blocks":[{"id":"blk-34102","kind":"paragraph","spans":[{"id":"spn-37828","text":"External integration: "},{"id":"spn-37829","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-37830","text":" (consumer contract)"}]}],"id":"blk-34101","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34103","kind":"paragraph","spans":[{"id":"spn-37831","text":"---"}]},{"id":"blk-34104","kind":"heading","level":2,"spans":[{"id":"spn-37832","text":"1) Context"}]},{"id":"blk-34105","kind":"paragraph","spans":[{"id":"spn-37833","text":"The canonical WHS invocation endpoint ("},{"id":"spn-37834","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-37835","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-34106","kind":"paragraph","spans":[{"id":"spn-37836","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-34107","items":[{"blocks":[{"id":"blk-34109","kind":"paragraph","spans":[{"id":"spn-37837","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-34108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34110","kind":"paragraph","spans":[{"id":"spn-37838","text":"Constraints:"}]},{"id":"blk-34111","items":[{"blocks":[{"id":"blk-34113","kind":"paragraph","spans":[{"id":"spn-37839","text":"Server-side orchestrators should "},{"id":"spn-37840","marks":["bold"],"text":"not"},{"id":"spn-37841","text":" rely on browser tokens."}]}],"id":"blk-34112","kind":"list-item"},{"blocks":[{"id":"blk-34115","kind":"paragraph","spans":[{"id":"spn-37842","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-34114","kind":"list-item"},{"blocks":[{"id":"blk-34117","kind":"paragraph","spans":[{"id":"spn-37843","text":"WHS must remain authoritative for:"}]}],"id":"blk-34116","kind":"list-item"},{"blocks":[{"id":"blk-34119","kind":"paragraph","spans":[{"id":"spn-37844","text":"agent ownership/visibility,"}]}],"id":"blk-34118","kind":"list-item"},{"blocks":[{"id":"blk-34121","kind":"paragraph","spans":[{"id":"spn-37845","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-34120","kind":"list-item"},{"blocks":[{"id":"blk-34123","kind":"paragraph","spans":[{"id":"spn-37846","text":"telemetry, usage, billing."}]}],"id":"blk-34122","kind":"list-item"},{"blocks":[{"id":"blk-34125","kind":"paragraph","spans":[{"id":"spn-37847","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-34124","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34126","kind":"paragraph","spans":[{"id":"spn-37848","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-34127","items":[{"blocks":[{"id":"blk-34129","kind":"paragraph","spans":[{"id":"spn-37849","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-34128","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34130","kind":"paragraph","spans":[{"id":"spn-37850","text":"We need an analogous but distinct mechanism for "},{"id":"spn-37851","marks":["bold"],"text":"delegated invocation"},{"id":"spn-37852","text":"."}]},{"id":"blk-34131","kind":"paragraph","spans":[{"id":"spn-37853","text":"---"}]},{"id":"blk-34132","kind":"heading","level":2,"spans":[{"id":"spn-37854","text":"2) Decision"}]},{"id":"blk-34133","kind":"heading","level":3,"spans":[{"id":"spn-37855","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-34134","kind":"paragraph","spans":[{"id":"spn-37856","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-34135","items":[{"blocks":[{"id":"blk-34137","kind":"paragraph","spans":[{"id":"spn-37857","text":"The delegator sends a request with:"}]}],"id":"blk-34136","kind":"list-item"},{"blocks":[{"id":"blk-34139","kind":"paragraph","spans":[{"id":"spn-37858","text":"an HMAC signature computed over the "},{"id":"spn-37859","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-37860","text":"."}]}],"id":"blk-34138","kind":"list-item"},{"blocks":[{"id":"blk-34141","kind":"paragraph","spans":[{"id":"spn-37861","text":"a timestamp used for replay protection."}]}],"id":"blk-34140","kind":"list-item"},{"blocks":[{"id":"blk-34143","kind":"paragraph","spans":[{"id":"spn-37862","text":"a declared delegated end-user identity ("},{"id":"spn-37863","marks":["code"],"text":"externalUserId"},{"id":"spn-37864","text":") in the JSON body."}]}],"id":"blk-34142","kind":"list-item"},{"blocks":[{"id":"blk-34145","kind":"paragraph","spans":[{"id":"spn-37865","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-34144","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34146","kind":"paragraph","spans":[{"id":"spn-37866","text":"This is "},{"id":"spn-37867","marks":["bold"],"text":"service authentication"},{"id":"spn-37868","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-34147","kind":"heading","level":3,"spans":[{"id":"spn-37869","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-34148","kind":"paragraph","spans":[{"id":"spn-37870","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-34149","items":[{"blocks":[{"id":"blk-34151","kind":"paragraph","spans":[{"id":"spn-37871","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-34150","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34152","kind":"paragraph","spans":[{"id":"spn-37872","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-34153","kind":"heading","level":3,"spans":[{"id":"spn-37873","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-34154","kind":"paragraph","spans":[{"id":"spn-37874","text":"For delegated invocations:"}]},{"id":"blk-34155","items":[{"blocks":[{"id":"blk-34157","kind":"paragraph","spans":[{"id":"spn-37875","text":"WHS resolves "},{"id":"spn-37876","marks":["code"],"text":"externalUserId"},{"id":"spn-37877","text":" to a WHS "},{"id":"spn-37878","marks":["code"],"text":"users"},{"id":"spn-37879","text":" row."}]}],"id":"blk-34156","kind":"list-item"},{"blocks":[{"id":"blk-34159","kind":"paragraph","spans":[{"id":"spn-37880","text":"WHS enforces all standard checks "},{"id":"spn-37881","marks":["bold"],"text":"as that user"},{"id":"spn-37882","text":", including:"}]}],"id":"blk-34158","kind":"list-item"},{"blocks":[{"id":"blk-34161","kind":"paragraph","spans":[{"id":"spn-37883","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-34160","kind":"list-item"},{"blocks":[{"id":"blk-34163","kind":"paragraph","spans":[{"id":"spn-37884","text":"agent status (not disabled),"}]}],"id":"blk-34162","kind":"list-item"},{"blocks":[{"id":"blk-34165","kind":"paragraph","spans":[{"id":"spn-37885","text":"active deployment present,"}]}],"id":"blk-34164","kind":"list-item"},{"blocks":[{"id":"blk-34167","kind":"paragraph","spans":[{"id":"spn-37886","text":"plan entitlements and limits,"}]}],"id":"blk-34166","kind":"list-item"},{"blocks":[{"id":"blk-34169","kind":"paragraph","spans":[{"id":"spn-37887","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-34168","kind":"list-item"},{"blocks":[{"id":"blk-34171","kind":"paragraph","spans":[{"id":"spn-37888","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-34170","kind":"list-item"},{"blocks":[{"id":"blk-34173","kind":"paragraph","spans":[{"id":"spn-37889","text":"any additional internal safety controls."}]}],"id":"blk-34172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34174","kind":"paragraph","spans":[{"id":"spn-37890","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-34175","kind":"paragraph","spans":[{"id":"spn-37891","text":"---"}]},{"id":"blk-34176","kind":"heading","level":2,"spans":[{"id":"spn-37892","text":"3) Normative request authentication"}]},{"id":"blk-34177","kind":"heading","level":3,"spans":[{"id":"spn-37893","text":"3.1 Required headers"}]},{"id":"blk-34178","kind":"paragraph","spans":[{"id":"spn-37894","text":"Delegated requests MUST include:"}]},{"id":"blk-34179","items":[{"blocks":[{"id":"blk-34181","kind":"paragraph","spans":[{"id":"spn-37895","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-34180","kind":"list-item"},{"blocks":[{"id":"blk-34183","kind":"paragraph","spans":[{"id":"spn-37896","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-34182","kind":"list-item"},{"blocks":[{"id":"blk-34185","kind":"paragraph","spans":[{"id":"spn-37897","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-34184","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34186","kind":"paragraph","spans":[{"id":"spn-37898","text":"Rules:"}]},{"id":"blk-34187","items":[{"blocks":[{"id":"blk-34189","kind":"paragraph","spans":[{"id":"spn-37899","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-34188","kind":"list-item"},{"blocks":[{"id":"blk-34191","kind":"paragraph","spans":[{"id":"spn-37900","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-34190","kind":"list-item"},{"blocks":[{"id":"blk-34193","kind":"paragraph","spans":[{"id":"spn-37901","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-34192","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34194","kind":"paragraph","spans":[{"id":"spn-37902","text":"Recommended default skew window:"}]},{"id":"blk-34195","items":[{"blocks":[{"id":"blk-34197","kind":"paragraph","spans":[{"id":"spn-37903","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-37904","text":" (5 minutes)"}]}],"id":"blk-34196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34198","kind":"paragraph","spans":[{"id":"spn-37905","text":"If signature or timestamp validation fails:"}]},{"id":"blk-34199","items":[{"blocks":[{"id":"blk-34201","kind":"paragraph","spans":[{"id":"spn-37906","text":"return a normalized error:"}]}],"id":"blk-34200","kind":"list-item"},{"blocks":[{"id":"blk-34203","kind":"paragraph","spans":[{"id":"spn-37907","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-34202","kind":"list-item"},{"blocks":[{"id":"blk-34205","kind":"paragraph","spans":[{"id":"spn-37908","text":"safe "},{"id":"spn-37909","marks":["code"],"text":"message"}]}],"id":"blk-34204","kind":"list-item"},{"blocks":[{"id":"blk-34207","kind":"paragraph","spans":[{"id":"spn-37910","marks":["code"],"text":"retryable: false"},{"id":"spn-37911","text":" (recommended)"}]}],"id":"blk-34206","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34208","kind":"heading","level":3,"spans":[{"id":"spn-37912","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-34209","kind":"paragraph","spans":[{"id":"spn-37913","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-34210","items":[{"blocks":[{"id":"blk-34212","kind":"paragraph","spans":[{"id":"spn-37914","text":"e.g., "},{"id":"spn-37915","marks":["code"],"text":"agentromatic"},{"id":"spn-37916","text":", "},{"id":"spn-37917","marks":["code"],"text":"agentelic"},{"id":"spn-37918","text":" (future), "},{"id":"spn-37919","marks":["code"],"text":"internal"}]}],"id":"blk-34211","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34213","kind":"paragraph","spans":[{"id":"spn-37920","text":"Requests with an unknown "},{"id":"spn-37921","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-37922","text":" SHOULD be rejected with "},{"id":"spn-37923","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-37924","text":"."}]},{"id":"blk-34214","kind":"paragraph","spans":[{"id":"spn-37925","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-34215","kind":"heading","level":3,"spans":[{"id":"spn-37926","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-34216","kind":"paragraph","spans":[{"id":"spn-37927","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-34217","items":[{"blocks":[{"id":"blk-34219","kind":"paragraph","spans":[{"id":"spn-37928","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-34218","kind":"list-item"},{"blocks":[{"id":"blk-34221","kind":"paragraph","spans":[{"id":"spn-37929","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-37930","text":" (stable external auth subject id)"}]}],"id":"blk-34220","kind":"list-item"},{"blocks":[{"id":"blk-34223","kind":"paragraph","spans":[{"id":"spn-37931","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-37932","text":" (see §5)"}]}],"id":"blk-34222","kind":"list-item"},{"blocks":[{"id":"blk-34225","kind":"paragraph","spans":[{"id":"spn-37933","text":"optional correlation metadata for observability:"}]}],"id":"blk-34224","kind":"list-item"},{"blocks":[{"id":"blk-34227","kind":"paragraph","spans":[{"id":"spn-37934","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-34226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34228","kind":"paragraph","spans":[{"id":"spn-37935","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-37936","marks":["code"],"text":"invoke"},{"id":"spn-37937","text":" (compatible with "},{"id":"spn-37938","marks":["code"],"text":"InvokeRequest"},{"id":"spn-37939","text":")."}]},{"id":"blk-34229","kind":"paragraph","spans":[{"id":"spn-37940","text":"The body MUST NOT include:"}]},{"id":"blk-34230","items":[{"blocks":[{"id":"blk-34232","kind":"paragraph","spans":[{"id":"spn-37941","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-34231","kind":"list-item"},{"blocks":[{"id":"blk-34234","kind":"paragraph","spans":[{"id":"spn-37942","text":"raw end-user auth tokens"}]}],"id":"blk-34233","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34235","kind":"paragraph","spans":[{"id":"spn-37943","text":"---"}]},{"id":"blk-34236","kind":"heading","level":2,"spans":[{"id":"spn-37944","text":"4) Error semantics"}]},{"id":"blk-34237","kind":"paragraph","spans":[{"id":"spn-37945","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-34238","kind":"paragraph","spans":[{"id":"spn-37946","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-34239","items":[{"blocks":[{"id":"blk-34241","kind":"paragraph","spans":[{"id":"spn-37947","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-37948","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-34240","kind":"list-item"},{"blocks":[{"id":"blk-34243","kind":"paragraph","spans":[{"id":"spn-37949","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-37950","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-34242","kind":"list-item"},{"blocks":[{"id":"blk-34245","kind":"paragraph","spans":[{"id":"spn-37951","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-37952","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-34244","kind":"list-item"},{"blocks":[{"id":"blk-34247","kind":"paragraph","spans":[{"id":"spn-37953","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-37954","text":" (plan limits)"}]}],"id":"blk-34246","kind":"list-item"},{"blocks":[{"id":"blk-34249","kind":"paragraph","spans":[{"id":"spn-37955","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-37956","text":" (bad schema, oversized payload)"}]}],"id":"blk-34248","kind":"list-item"},{"blocks":[{"id":"blk-34251","kind":"paragraph","spans":[{"id":"spn-37957","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-37958","text":" (provider/runtime failures)"}]}],"id":"blk-34250","kind":"list-item"},{"blocks":[{"id":"blk-34253","kind":"paragraph","spans":[{"id":"spn-37959","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-34252","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34254","kind":"paragraph","spans":[{"id":"spn-37960","text":"Consistency rule:"}]},{"id":"blk-34255","items":[{"blocks":[{"id":"blk-34257","kind":"paragraph","spans":[{"id":"spn-37961","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-37962","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-37963","text":" over "},{"id":"spn-37964","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-37965","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-34256","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34258","kind":"paragraph","spans":[{"id":"spn-37966","text":"---"}]},{"id":"blk-34259","kind":"heading","level":2,"spans":[{"id":"spn-37967","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-34260","kind":"paragraph","spans":[{"id":"spn-37968","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-34261","kind":"heading","level":3,"spans":[{"id":"spn-37969","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-34262","kind":"paragraph","spans":[{"id":"spn-37970","text":"Delegated invocation requests MUST include "},{"id":"spn-37971","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-37972","text":"."}]},{"id":"blk-34263","kind":"paragraph","spans":[{"id":"spn-37973","text":"The key MUST be:"}]},{"id":"blk-34264","items":[{"blocks":[{"id":"blk-34266","kind":"paragraph","spans":[{"id":"spn-37974","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-34265","kind":"list-item"},{"blocks":[{"id":"blk-34268","kind":"paragraph","spans":[{"id":"spn-37975","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-34267","kind":"list-item"},{"blocks":[{"id":"blk-34270","kind":"paragraph","spans":[{"id":"spn-37976","text":"secret-free,"}]}],"id":"blk-34269","kind":"list-item"},{"blocks":[{"id":"blk-34272","kind":"paragraph","spans":[{"id":"spn-37977","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-34271","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34273","kind":"heading","level":3,"spans":[{"id":"spn-37978","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-34274","kind":"paragraph","spans":[{"id":"spn-37979","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-34275","items":[{"blocks":[{"id":"blk-34277","kind":"paragraph","spans":[{"id":"spn-37980","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-34276","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34278","kind":"paragraph","spans":[{"id":"spn-37981","text":"Behavior:"}]},{"id":"blk-34279","items":[{"blocks":[{"id":"blk-34281","kind":"paragraph","spans":[{"id":"spn-37982","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-34280","kind":"list-item"},{"blocks":[{"id":"blk-34283","kind":"paragraph","spans":[{"id":"spn-37983","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-34282","kind":"list-item"},{"blocks":[{"id":"blk-34285","kind":"paragraph","spans":[{"id":"spn-37984","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-34284","kind":"list-item"},{"blocks":[{"id":"blk-34287","kind":"paragraph","spans":[{"id":"spn-37985","marks":["code"],"text":"CONFLICT"},{"id":"spn-37986","text":" or "},{"id":"spn-37987","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-37988","text":" (choose one; keep consistent),"}]}],"id":"blk-34286","kind":"list-item"},{"blocks":[{"id":"blk-34289","kind":"paragraph","spans":[{"id":"spn-37989","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-34288","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34290","kind":"paragraph","spans":[{"id":"spn-37990","text":"Implementation guidance (non-normative):"}]},{"id":"blk-34291","items":[{"blocks":[{"id":"blk-34293","kind":"paragraph","spans":[{"id":"spn-37991","text":"Store an idempotency ledger row containing:"}]}],"id":"blk-34292","kind":"list-item"},{"blocks":[{"id":"blk-34295","kind":"paragraph","spans":[{"id":"spn-37992","text":"request hash (e.g., sha256 of raw bytes),"}]}],"id":"blk-34294","kind":"list-item"},{"blocks":[{"id":"blk-34297","kind":"paragraph","spans":[{"id":"spn-37993","text":"response payload or response reference (bounded),"}]}],"id":"blk-34296","kind":"list-item"},{"blocks":[{"id":"blk-34299","kind":"paragraph","spans":[{"id":"spn-37994","text":"traceId/sessionId,"}]}],"id":"blk-34298","kind":"list-item"},{"blocks":[{"id":"blk-34301","kind":"paragraph","spans":[{"id":"spn-37995","text":"timestamps and status."}]}],"id":"blk-34300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34302","kind":"paragraph","spans":[{"id":"spn-37996","text":"---"}]},{"id":"blk-34303","kind":"heading","level":2,"spans":[{"id":"spn-37997","text":"6) Security analysis (threats and mitigations)"}]},{"id":"blk-34304","kind":"heading","level":3,"spans":[{"id":"spn-37998","text":"6.1 Threat: delegator attempts to invoke as another user"}]},{"id":"blk-34305","kind":"paragraph","spans":[{"id":"spn-37999","text":"Mitigation:"}]},{"id":"blk-34306","items":[{"blocks":[{"id":"blk-34308","kind":"paragraph","spans":[{"id":"spn-38000","text":"WHS enforces authorization based on "},{"id":"spn-38001","marks":["code"],"text":"externalUserId"},{"id":"spn-38002","text":" resolved user row."}]}],"id":"blk-34307","kind":"list-item"},{"blocks":[{"id":"blk-34310","kind":"paragraph","spans":[{"id":"spn-38003","text":"WHS enforces ownership/visibility checks and entitlements."}]}],