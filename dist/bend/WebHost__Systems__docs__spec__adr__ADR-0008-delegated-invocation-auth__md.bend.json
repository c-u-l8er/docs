{"bendscript":"0.1","blocks":[{"id":"blk-33590","kind":"heading","level":1,"spans":[{"id":"spn-36629","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-33591","items":[{"blocks":[{"id":"blk-33593","kind":"paragraph","spans":[{"id":"spn-36630","marks":["bold"],"text":"Status:"},{"id":"spn-36631","text":" Accepted"}]}],"id":"blk-33592","kind":"list-item"},{"blocks":[{"id":"blk-33595","kind":"paragraph","spans":[{"id":"spn-36632","marks":["bold"],"text":"Date:"},{"id":"spn-36633","text":" 2026-01-24"}]}],"id":"blk-33594","kind":"list-item"},{"blocks":[{"id":"blk-33597","kind":"paragraph","spans":[{"id":"spn-36634","marks":["bold"],"text":"Owners:"},{"id":"spn-36635","text":" Engineering"}]}],"id":"blk-33596","kind":"list-item"},{"blocks":[{"id":"blk-33599","kind":"paragraph","spans":[{"id":"spn-36636","marks":["bold"],"text":"Applies to:"},{"id":"spn-36637","text":" "},{"id":"spn-36638","marks":["code"],"text":"webhost.systems"},{"id":"spn-36639","text":" control plane"}]}],"id":"blk-33598","kind":"list-item"},{"blocks":[{"id":"blk-33601","kind":"paragraph","spans":[{"id":"spn-36640","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-36641","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-33600","kind":"list-item"},{"blocks":[{"id":"blk-33603","kind":"paragraph","spans":[{"id":"spn-36642","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-33602","kind":"list-item"},{"blocks":[{"id":"blk-33605","kind":"paragraph","spans":[{"id":"spn-36643","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-36644","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-33604","kind":"list-item"},{"blocks":[{"id":"blk-33607","kind":"paragraph","spans":[{"id":"spn-36645","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-36646","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-33606","kind":"list-item"},{"blocks":[{"id":"blk-33609","kind":"paragraph","spans":[{"id":"spn-36647","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-36648","text":" (invoke contract)"}]}],"id":"blk-33608","kind":"list-item"},{"blocks":[{"id":"blk-33611","kind":"paragraph","spans":[{"id":"spn-36649","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-36650","text":" (tenant isolation; access control)"}]}],"id":"blk-33610","kind":"list-item"},{"blocks":[{"id":"blk-33613","kind":"paragraph","spans":[{"id":"spn-36651","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-36652","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-33612","kind":"list-item"},{"blocks":[{"id":"blk-33615","kind":"paragraph","spans":[{"id":"spn-36653","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-36654","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-33614","kind":"list-item"},{"blocks":[{"id":"blk-33617","kind":"paragraph","spans":[{"id":"spn-36655","text":"External integration: "},{"id":"spn-36656","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-36657","text":" (consumer contract)"}]}],"id":"blk-33616","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33618","kind":"paragraph","spans":[{"id":"spn-36658","text":"---"}]},{"id":"blk-33619","kind":"heading","level":2,"spans":[{"id":"spn-36659","text":"1) Context"}]},{"id":"blk-33620","kind":"paragraph","spans":[{"id":"spn-36660","text":"The canonical WHS invocation endpoint ("},{"id":"spn-36661","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-36662","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-33621","kind":"paragraph","spans":[{"id":"spn-36663","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-33622","items":[{"blocks":[{"id":"blk-33624","kind":"paragraph","spans":[{"id":"spn-36664","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-33623","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33625","kind":"paragraph","spans":[{"id":"spn-36665","text":"Constraints:"}]},{"id":"blk-33626","items":[{"blocks":[{"id":"blk-33628","kind":"paragraph","spans":[{"id":"spn-36666","text":"Server-side orchestrators should "},{"id":"spn-36667","marks":["bold"],"text":"not"},{"id":"spn-36668","text":" rely on browser tokens."}]}],"id":"blk-33627","kind":"list-item"},{"blocks":[{"id":"blk-33630","kind":"paragraph","spans":[{"id":"spn-36669","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-33629","kind":"list-item"},{"blocks":[{"id":"blk-33632","kind":"paragraph","spans":[{"id":"spn-36670","text":"WHS must remain authoritative for:"}]}],"id":"blk-33631","kind":"list-item"},{"blocks":[{"id":"blk-33634","kind":"paragraph","spans":[{"id":"spn-36671","text":"agent ownership/visibility,"}]}],"id":"blk-33633","kind":"list-item"},{"blocks":[{"id":"blk-33636","kind":"paragraph","spans":[{"id":"spn-36672","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-33635","kind":"list-item"},{"blocks":[{"id":"blk-33638","kind":"paragraph","spans":[{"id":"spn-36673","text":"telemetry, usage, billing."}]}],"id":"blk-33637","kind":"list-item"},{"blocks":[{"id":"blk-33640","kind":"paragraph","spans":[{"id":"spn-36674","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-33639","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33641","kind":"paragraph","spans":[{"id":"spn-36675","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-33642","items":[{"blocks":[{"id":"blk-33644","kind":"paragraph","spans":[{"id":"spn-36676","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-33643","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33645","kind":"paragraph","spans":[{"id":"spn-36677","text":"We need an analogous but distinct mechanism for "},{"id":"spn-36678","marks":["bold"],"text":"delegated invocation"},{"id":"spn-36679","text":"."}]},{"id":"blk-33646","kind":"paragraph","spans":[{"id":"spn-36680","text":"---"}]},{"id":"blk-33647","kind":"heading","level":2,"spans":[{"id":"spn-36681","text":"2) Decision"}]},{"id":"blk-33648","kind":"heading","level":3,"spans":[{"id":"spn-36682","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-33649","kind":"paragraph","spans":[{"id":"spn-36683","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-33650","items":[{"blocks":[{"id":"blk-33652","kind":"paragraph","spans":[{"id":"spn-36684","text":"The delegator sends a request with:"}]}],"id":"blk-33651","kind":"list-item"},{"blocks":[{"id":"blk-33654","kind":"paragraph","spans":[{"id":"spn-36685","text":"an HMAC signature computed over the "},{"id":"spn-36686","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-36687","text":"."}]}],"id":"blk-33653","kind":"list-item"},{"blocks":[{"id":"blk-33656","kind":"paragraph","spans":[{"id":"spn-36688","text":"a timestamp used for replay protection."}]}],"id":"blk-33655","kind":"list-item"},{"blocks":[{"id":"blk-33658","kind":"paragraph","spans":[{"id":"spn-36689","text":"a declared delegated end-user identity ("},{"id":"spn-36690","marks":["code"],"text":"externalUserId"},{"id":"spn-36691","text":") in the JSON body."}]}],"id":"blk-33657","kind":"list-item"},{"blocks":[{"id":"blk-33660","kind":"paragraph","spans":[{"id":"spn-36692","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-33659","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33661","kind":"paragraph","spans":[{"id":"spn-36693","text":"This is "},{"id":"spn-36694","marks":["bold"],"text":"service authentication"},{"id":"spn-36695","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-33662","kind":"heading","level":3,"spans":[{"id":"spn-36696","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-33663","kind":"paragraph","spans":[{"id":"spn-36697","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-33664","items":[{"blocks":[{"id":"blk-33666","kind":"paragraph","spans":[{"id":"spn-36698","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-33665","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33667","kind":"paragraph","spans":[{"id":"spn-36699","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-33668","kind":"heading","level":3,"spans":[{"id":"spn-36700","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-33669","kind":"paragraph","spans":[{"id":"spn-36701","text":"For delegated invocations:"}]},{"id":"blk-33670","items":[{"blocks":[{"id":"blk-33672","kind":"paragraph","spans":[{"id":"spn-36702","text":"WHS resolves "},{"id":"spn-36703","marks":["code"],"text":"externalUserId"},{"id":"spn-36704","text":" to a WHS "},{"id":"spn-36705","marks":["code"],"text":"users"},{"id":"spn-36706","text":" row."}]}],"id":"blk-33671","kind":"list-item"},{"blocks":[{"id":"blk-33674","kind":"paragraph","spans":[{"id":"spn-36707","text":"WHS enforces all standard checks "},{"id":"spn-36708","marks":["bold"],"text":"as that user"},{"id":"spn-36709","text":", including:"}]}],"id":"blk-33673","kind":"list-item"},{"blocks":[{"id":"blk-33676","kind":"paragraph","spans":[{"id":"spn-36710","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-33675","kind":"list-item"},{"blocks":[{"id":"blk-33678","kind":"paragraph","spans":[{"id":"spn-36711","text":"agent status (not disabled),"}]}],"id":"blk-33677","kind":"list-item"},{"blocks":[{"id":"blk-33680","kind":"paragraph","spans":[{"id":"spn-36712","text":"active deployment present,"}]}],"id":"blk-33679","kind":"list-item"},{"blocks":[{"id":"blk-33682","kind":"paragraph","spans":[{"id":"spn-36713","text":"plan entitlements and limits,"}]}],"id":"blk-33681","kind":"list-item"},{"blocks":[{"id":"blk-33684","kind":"paragraph","spans":[{"id":"spn-36714","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-33683","kind":"list-item"},{"blocks":[{"id":"blk-33686","kind":"paragraph","spans":[{"id":"spn-36715","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-33685","kind":"list-item"},{"blocks":[{"id":"blk-33688","kind":"paragraph","spans":[{"id":"spn-36716","text":"any additional internal safety controls."}]}],"id":"blk-33687","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33689","kind":"paragraph","spans":[{"id":"spn-36717","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-33690","kind":"paragraph","spans":[{"id":"spn-36718","text":"---"}]},{"id":"blk-33691","kind":"heading","level":2,"spans":[{"id":"spn-36719","text":"3) Normative request authentication"}]},{"id":"blk-33692","kind":"heading","level":3,"spans":[{"id":"spn-36720","text":"3.1 Required headers"}]},{"id":"blk-33693","kind":"paragraph","spans":[{"id":"spn-36721","text":"Delegated requests MUST include:"}]},{"id":"blk-33694","items":[{"blocks":[{"id":"blk-33696","kind":"paragraph","spans":[{"id":"spn-36722","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-33695","kind":"list-item"},{"blocks":[{"id":"blk-33698","kind":"paragraph","spans":[{"id":"spn-36723","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-33697","kind":"list-item"},{"blocks":[{"id":"blk-33700","kind":"paragraph","spans":[{"id":"spn-36724","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-33699","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33701","kind":"paragraph","spans":[{"id":"spn-36725","text":"Rules:"}]},{"id":"blk-33702","items":[{"blocks":[{"id":"blk-33704","kind":"paragraph","spans":[{"id":"spn-36726","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-33703","kind":"list-item"},{"blocks":[{"id":"blk-33706","kind":"paragraph","spans":[{"id":"spn-36727","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-33705","kind":"list-item"},{"blocks":[{"id":"blk-33708","kind":"paragraph","spans":[{"id":"spn-36728","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-33707","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33709","kind":"paragraph","spans":[{"id":"spn-36729","text":"Recommended default skew window:"}]},{"id":"blk-33710","items":[{"blocks":[{"id":"blk-33712","kind":"paragraph","spans":[{"id":"spn-36730","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-36731","text":" (5 minutes)"}]}],"id":"blk-33711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33713","kind":"paragraph","spans":[{"id":"spn-36732","text":"If signature or timestamp validation fails:"}]},{"id":"blk-33714","items":[{"blocks":[{"id":"blk-33716","kind":"paragraph","spans":[{"id":"spn-36733","text":"return a normalized error:"}]}],"id":"blk-33715","kind":"list-item"},{"blocks":[{"id":"blk-33718","kind":"paragraph","spans":[{"id":"spn-36734","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-33717","kind":"list-item"},{"blocks":[{"id":"blk-33720","kind":"paragraph","spans":[{"id":"spn-36735","text":"safe "},{"id":"spn-36736","marks":["code"],"text":"message"}]}],"id":"blk-33719","kind":"list-item"},{"blocks":[{"id":"blk-33722","kind":"paragraph","spans":[{"id":"spn-36737","marks":["code"],"text":"retryable: false"},{"id":"spn-36738","text":" (recommended)"}]}],"id":"blk-33721","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33723","kind":"heading","level":3,"spans":[{"id":"spn-36739","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-33724","kind":"paragraph","spans":[{"id":"spn-36740","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-33725","items":[{"blocks":[{"id":"blk-33727","kind":"paragraph","spans":[{"id":"spn-36741","text":"e.g., "},{"id":"spn-36742","marks":["code"],"text":"agentromatic"},{"id":"spn-36743","text":", "},{"id":"spn-36744","marks":["code"],"text":"agentelic"},{"id":"spn-36745","text":" (future), "},{"id":"spn-36746","marks":["code"],"text":"internal"}]}],"id":"blk-33726","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33728","kind":"paragraph","spans":[{"id":"spn-36747","text":"Requests with an unknown "},{"id":"spn-36748","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-36749","text":" SHOULD be rejected with "},{"id":"spn-36750","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-36751","text":"."}]},{"id":"blk-33729","kind":"paragraph","spans":[{"id":"spn-36752","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-33730","kind":"heading","level":3,"spans":[{"id":"spn-36753","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-33731","kind":"paragraph","spans":[{"id":"spn-36754","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-33732","items":[{"blocks":[{"id":"blk-33734","kind":"paragraph","spans":[{"id":"spn-36755","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-33733","kind":"list-item"},{"blocks":[{"id":"blk-33736","kind":"paragraph","spans":[{"id":"spn-36756","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-36757","text":" (stable external auth subject id)"}]}],"id":"blk-33735","kind":"list-item"},{"blocks":[{"id":"blk-33738","kind":"paragraph","spans":[{"id":"spn-36758","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-36759","text":" (see §5)"}]}],"id":"blk-33737","kind":"list-item"},{"blocks":[{"id":"blk-33740","kind":"paragraph","spans":[{"id":"spn-36760","text":"optional correlation metadata for observability:"}]}],"id":"blk-33739","kind":"list-item"},{"blocks":[{"id":"blk-33742","kind":"paragraph","spans":[{"id":"spn-36761","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-33741","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33743","kind":"paragraph","spans":[{"id":"spn-36762","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-36763","marks":["code"],"text":"invoke"},{"id":"spn-36764","text":" (compatible with "},{"id":"spn-36765","marks":["code"],"text":"InvokeRequest"},{"id":"spn-36766","text":")."}]},{"id":"blk-33744","kind":"paragraph","spans":[{"id":"spn-36767","text":"The body MUST NOT include:"}]},{"id":"blk-33745","items":[{"blocks":[{"id":"blk-33747","kind":"paragraph","spans":[{"id":"spn-36768","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-33746","kind":"list-item"},{"blocks":[{"id":"blk-33749","kind":"paragraph","spans":[{"id":"spn-36769","text":"raw end-user auth tokens"}]}],"id":"blk-33748","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33750","kind":"paragraph","spans":[{"id":"spn-36770","text":"---"}]},{"id":"blk-33751","kind":"heading","level":2,"spans":[{"id":"spn-36771","text":"4) Error semantics"}]},{"id":"blk-33752","kind":"paragraph","spans":[{"id":"spn-36772","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-33753","kind":"paragraph","spans":[{"id":"spn-36773","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-33754","items":[{"blocks":[{"id":"blk-33756","kind":"paragraph","spans":[{"id":"spn-36774","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-36775","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-33755","kind":"list-item"},{"blocks":[{"id":"blk-33758","kind":"paragraph","spans":[{"id":"spn-36776","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-36777","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-33757","kind":"list-item"},{"blocks":[{"id":"blk-33760","kind":"paragraph","spans":[{"id":"spn-36778","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-36779","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-33759","kind":"list-item"},{"blocks":[{"id":"blk-33762","kind":"paragraph","spans":[{"id":"spn-36780","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-36781","text":" (plan limits)"}]}],"id":"blk-33761","kind":"list-item"},{"blocks":[{"id":"blk-33764","kind":"paragraph","spans":[{"id":"spn-36782","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-36783","text":" (bad schema, oversized payload)"}]}],"id":"blk-33763","kind":"list-item"},{"blocks":[{"id":"blk-33766","kind":"paragraph","spans":[{"id":"spn-36784","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-36785","text":" (provider/runtime failures)"}]}],"id":"blk-33765","kind":"list-item"},{"blocks":[{"id":"blk-33768","kind":"paragraph","spans":[{"id":"spn-36786","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-33767","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33769","kind":"paragraph","spans":[{"id":"spn-36787","text":"Consistency rule:"}]},{"id":"blk-33770","items":[{"blocks":[{"id":"blk-33772","kind":"paragraph","spans":[{"id":"spn-36788","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-36789","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-36790","text":" over "},{"id":"spn-36791","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-36792","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-33771","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33773","kind":"paragraph","spans":[{"id":"spn-36793","text":"---"}]},{"id":"blk-33774","kind":"heading","level":2,"spans":[{"id":"spn-36794","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-33775","kind":"paragraph","spans":[{"id":"spn-36795","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-33776","kind":"heading","level":3,"spans":[{"id":"spn-36796","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-33777","kind":"paragraph","spans":[{"id":"spn-36797","text":"Delegated invocation requests MUST include "},{"id":"spn-36798","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-36799","text":"."}]},{"id":"blk-33778","kind":"paragraph","spans":[{"id":"spn-36800","text":"The key MUST be:"}]},{"id":"blk-33779","items":[{"blocks":[{"id":"blk-33781","kind":"paragraph","spans":[{"id":"spn-36801","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-33780","kind":"list-item"},{"blocks":[{"id":"blk-33783","kind":"paragraph","spans":[{"id":"spn-36802","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-33782","kind":"list-item"},{"blocks":[{"id":"blk-33785","kind":"paragraph","spans":[{"id":"spn-36803","text":"secret-free,"}]}],"id":"blk-33784","kind":"list-item"},{"blocks":[{"id":"blk-33787","kind":"paragraph","spans":[{"id":"spn-36804","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-33786","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33788","kind":"heading","level":3,"spans":[{"id":"spn-36805","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-33789","kind":"paragraph","spans":[{"id":"spn-36806","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-33790","items":[{"blocks":[{"id":"blk-33792","kind":"paragraph","spans":[{"id":"spn-36807","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-33791","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33793","kind":"paragraph","spans":[{"id":"spn-36808","text":"Behavior:"}]},{"id":"blk-33794","items":[{"blocks":[{"id":"blk-33796","kind":"paragraph","spans":[{"id":"spn-36809","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-33795","kind":"list-item"},{"blocks":[{"id":"blk-33798","kind":"paragraph","spans":[{"id":"spn-36810","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-33797","kind":"list-item"},{"blocks":[{"id":"blk-33800","kind":"paragraph","spans":[{"id":"spn-36811","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-33799","kind":"list-item"},{"blocks":[{"id":"blk-33802","kind":"paragraph","spans":[{"id":"spn-36812","marks":["code"],"text":"CONFLICT"},{"id":"spn-36813","text":" or "},{"id":"spn-36814","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-36815","text":" (choose one; keep consistent),"}]}],"id":"blk-33801","kind":"list-item"},{"blocks":[{"id":"blk-33804","kind":"paragraph","spans":[{"id":"spn-36816","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-33803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33805","kind":"paragraph","spans":[{"id":"spn-36817","text":"Implementation guidance (non-normative):"}]},{"id":"blk-33806","items":[{"blocks":[{"id":"blk-33808","kind":"paragraph","spans":[{"id":"spn-36818","text":"Store an idempotency ledger row containing:"}]}],"id":"blk-33807","kind":"list-item"},{"blocks":[{"id":"blk-33810","kind":"paragraph","spans":[{"id":"spn-36819","text":"request hash (e.g., sha256 of raw bytes),"}]}],"id":"blk-33809","kind":"list-item"},{"blocks":[{"id":"blk-33812","kind":"paragraph","spans":[{"id":"spn-36820","text":"response payload or response reference (bounded),"}]}],"id":"blk-33811","kind":"list-item"},{"blocks":[{"id":"blk-33814","kind":"paragraph","spans":[{"id":"spn-36821","text":"traceId/sessionId,"}]}],"id":"blk-33813","kind":"list-item"},{"blocks":[{"id":"blk-33816","kind":"paragraph","spans":[{"id":"spn-36822","text":"timestamps and status."}]}],"id":"blk-33815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33817","kind":"paragraph","spans":[{"id":"spn-36823","text":"---"}]},{"id":"blk-33818","kind":"heading","level":2,"spans":[{"id":"spn-36824","text":"6) Security analysis (threats and mitigations)"}]},{"id":"blk-33819","kind":"heading","level":3,"spans":[{"id":"spn-36825","text":"6.1 Threat: delegator attempts to invoke as another user"}]},{"id":"blk-33820","kind":"paragraph","spans":[{"id":"spn-36826","text":"Mitigation:"}]},{"id":"blk-33821","items":[{"blocks":[{"id":"blk-33823","kind":"paragraph","spans":[{"id":"spn-36827","text":"WHS enforces authorization based on "},{"id":"spn-36828","marks":["code"],"text":"externalUserId"},{"id":"spn-36829","text":" resolved user row."}]}],"id":"blk-33822","kind":"list-item"},{"blocks":[{"id":"blk-33825","kind":"paragraph","spans":[{"id":"spn-36830","text":"WHS enforces ownership/visibility checks and entitlements."}]}],