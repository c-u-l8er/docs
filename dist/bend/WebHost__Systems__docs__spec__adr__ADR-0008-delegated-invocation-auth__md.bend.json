":"blk-34352","kind":"list-item"},{"blocks":[{"id":"blk-34355","kind":"paragraph","spans":[{"id":"spn-38032","text":"Provides clean correlation between workflows (or other orchestrators) and WHS telemetry via metadata."}]}],"id":"blk-34354","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34356","kind":"heading","level":3,"spans":[{"id":"spn-38033","text":"Tradeoffs"}]},{"id":"blk-34357","items":[{"blocks":[{"id":"blk-34359","kind":"paragraph","spans":[{"id":"spn-38034","text":"Requires managing a shared secret and secure deployment across systems."}]}],"id":"blk-34358","kind":"list-item"},{"blocks":[{"id":"blk-34361","kind":"paragraph","spans":[{"id":"spn-38035","text":"Introduces a new internal endpoint surface that must be rate-limited and monitored."}]}],"id":"blk-34360","kind":"list-item"},{"blocks":[{"id":"blk-34363","kind":"paragraph","spans":[{"id":"spn-38036","text":"Requires idempotency ledger storage and conflict handling."}]}],"id":"blk-34362","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34364","kind":"paragraph","spans":[{"id":"spn-38037","text":"---"}]},{"id":"blk-34365","kind":"heading","level":2,"spans":[{"id":"spn-38038","text":"8) Implementation checklist (v1)"}]},{"id":"blk-34366","kind":"paragraph","spans":[{"id":"spn-38039","text":"WHS control plane MUST implement: 1. "},{"id":"spn-38040","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"},{"id":"spn-38041","text":" 2. Raw-bytes HMAC verification:"}]},{"id":"blk-34367","items":[{"blocks":[{"id":"blk-34369","kind":"paragraph","spans":[{"id":"spn-38042","text":"signature header parsing"}]}],"id":"blk-34368","kind":"list-item"},{"blocks":[{"id":"blk-34371","kind":"paragraph","spans":[{"id":"spn-38043","text":"timestamp window checks"}]}],"id":"blk-34370","kind":"list-item"},{"blocks":[{"id":"blk-34373","kind":"paragraph","spans":[{"id":"spn-38044","text":"source allowlist (recommended)"}]}],"id":"blk-34372","kind":"list-item"}],"kind":"list","ordered":false