{"bendscript":"0.1","blocks":[{"id":"blk-53663","kind":"heading","level":1,"spans":[{"id":"spn-81675","text":"ADR-0008: Delegated Invocation Auth Mode (Server-to-Server HMAC)"}]},{"id":"blk-53664","items":[{"blocks":[{"id":"blk-53666","kind":"paragraph","spans":[{"id":"spn-81676","marks":["bold"],"text":"Status:"},{"id":"spn-81677","text":" Accepted"}]}],"id":"blk-53665","kind":"list-item"},{"blocks":[{"id":"blk-53668","kind":"paragraph","spans":[{"id":"spn-81678","marks":["bold"],"text":"Date:"},{"id":"spn-81679","text":" 2026-01-24"}]}],"id":"blk-53667","kind":"list-item"},{"blocks":[{"id":"blk-53670","kind":"paragraph","spans":[{"id":"spn-81680","marks":["bold"],"text":"Owners:"},{"id":"spn-81681","text":" Engineering"}]}],"id":"blk-53669","kind":"list-item"},{"blocks":[{"id":"blk-53672","kind":"paragraph","spans":[{"id":"spn-81682","marks":["bold"],"text":"Applies to:"},{"id":"spn-81683","text":" "},{"id":"spn-81684","marks":["code"],"text":"webhost.systems"},{"id":"spn-81685","text":" control plane"}]}],"id":"blk-53671","kind":"list-item"},{"blocks":[{"id":"blk-53674","kind":"paragraph","spans":[{"id":"spn-81686","marks":["bold"],"text":"Decision Scope:"},{"id":"spn-81687","text":" Add a service-authenticated “delegated invocation” mode so trusted backend systems (e.g., workflow orchestrators) can invoke WHS agents on behalf of an end user without forwarding browser tokens."}]}],"id":"blk-53673","kind":"list-item"},{"blocks":[{"id":"blk-53676","kind":"paragraph","spans":[{"id":"spn-81688","marks":["bold"],"text":"Related Specs:"}]}],"id":"blk-53675","kind":"list-item"},{"blocks":[{"id":"blk-53678","kind":"paragraph","spans":[{"id":"spn-81689","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-81690","text":" (control plane vs data plane boundary; invocation semantics)"}]}],"id":"blk-53677","kind":"list-item"},{"blocks":[{"id":"blk-53680","kind":"paragraph","spans":[{"id":"spn-81691","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-81692","text":" (invocation gateway; normalized errors; telemetry auth model)"}]}],"id":"blk-53679","kind":"list-item"},{"blocks":[{"id":"blk-53682","kind":"paragraph","spans":[{"id":"spn-81693","marks":["code"],"text":"docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-81694","text":" (invoke contract)"}]}],"id":"blk-53681","kind":"list-item"},{"blocks":[{"id":"blk-53684","kind":"paragraph","spans":[{"id":"spn-81695","marks":["code"],"text":"docs/spec/30_DATA_MODEL_CONVEX.md"},{"id":"spn-81696","text":" (tenant isolation; access control)"}]}],"id":"blk-53683","kind":"list-item"},{"blocks":[{"id":"blk-53686","kind":"paragraph","spans":[{"id":"spn-81697","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"},{"id":"spn-81698","text":" (threat model; secrets; abuse controls)"}]}],"id":"blk-53685","kind":"list-item"},{"blocks":[{"id":"blk-53688","kind":"paragraph","spans":[{"id":"spn-81699","marks":["code"],"text":"docs/spec/adr/ADR-0004-telemetry-integrity.md"},{"id":"spn-81700","text":" (HMAC over raw bytes precedent)"}]}],"id":"blk-53687","kind":"list-item"},{"blocks":[{"id":"blk-53690","kind":"paragraph","spans":[{"id":"spn-81701","text":"External integration: "},{"id":"spn-81702","marks":["code"],"text":"ProjectWHS/agentromatic.com/docs/spec/whs_integration.md"},{"id":"spn-81703","text":" (consumer contract)"}]}],"id":"blk-53689","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53691","kind":"heading","level":2,"spans":[{"id":"spn-81704","text":"1) Context"}]},{"id":"blk-53692","kind":"paragraph","spans":[{"id":"spn-81705","text":"The canonical WHS invocation endpoint ("},{"id":"spn-81706","marks":["code"],"text":"POST /v1/invoke/:agentId"},{"id":"spn-81707","text":") is authenticated using the product’s normal control-plane auth mechanism (e.g., Clerk JWT). This works for browser clients and first-party UIs."}]},{"id":"blk-53693","kind":"paragraph","spans":[{"id":"spn-81708","text":"However, some portfolio systems execute server-side and need to invoke WHS agents as part of durable orchestration. Example:"}]},{"id":"blk-53694","items":[{"blocks":[{"id":"blk-53696","kind":"paragraph","spans":[{"id":"spn-81709","text":"Agentromatic executes workflow runs in its backend (server-side action), and wants to run an “agent step” by invoking a WHS agent."}]}],"id":"blk-53695","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53697","kind":"paragraph","spans":[{"id":"spn-81710","text":"Constraints:"}]},{"id":"blk-53698","items":[{"blocks":[{"id":"blk-53700","kind":"paragraph","spans":[{"id":"spn-81711","text":"Server-side orchestrators should "},{"id":"spn-81712","marks":["bold"],"text":"not"},{"id":"spn-81713","text":" rely on browser tokens."}]}],"id":"blk-53699","kind":"list-item"},{"blocks":[{"id":"blk-53702","kind":"paragraph","spans":[{"id":"spn-81714","text":"Forwarding end-user JWTs through backend systems increases leakage risk and couples execution to user session semantics."}]}],"id":"blk-53701","kind":"list-item"},{"blocks":[{"id":"blk-53704","kind":"paragraph","spans":[{"id":"spn-81715","text":"WHS must remain authoritative for:"}]}],"id":"blk-53703","kind":"list-item"},{"blocks":[{"id":"blk-53706","kind":"paragraph","spans":[{"id":"spn-81716","text":"agent ownership/visibility,"}]}],"id":"blk-53705","kind":"list-item"},{"blocks":[{"id":"blk-53708","kind":"paragraph","spans":[{"id":"spn-81717","text":"plan entitlements and limit enforcement,"}]}],"id":"blk-53707","kind":"list-item"},{"blocks":[{"id":"blk-53710","kind":"paragraph","spans":[{"id":"spn-81718","text":"telemetry, usage, billing."}]}],"id":"blk-53709","kind":"list-item"},{"blocks":[{"id":"blk-53712","kind":"paragraph","spans":[{"id":"spn-81719","text":"Multi-tenant safety MUST be preserved: delegated invocations must not allow cross-tenant invocation."}]}],"id":"blk-53711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53713","kind":"paragraph","spans":[{"id":"spn-81720","text":"We already have a proven pattern for signed service-originated traffic:"}]},{"id":"blk-53714","items":[{"blocks":[{"id":"blk-53716","kind":"paragraph","spans":[{"id":"spn-81721","text":"Telemetry ingestion is protected using deployment-scoped HMAC verification over raw bytes."}]}],"id":"blk-53715","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53717","kind":"paragraph","spans":[{"id":"spn-81722","text":"We need an analogous but distinct mechanism for "},{"id":"spn-81723","marks":["bold"],"text":"delegated invocation"},{"id":"spn-81724","text":"."}]},{"id":"blk-53718","kind":"heading","level":2,"spans":[{"id":"spn-81725","text":"2) Decision"}]},{"id":"blk-53719","kind":"heading","level":3,"spans":[{"id":"spn-81726","text":"2.1 Introduce a delegated invocation auth mode using HMAC over raw bytes (v1)"}]},{"id":"blk-53720","kind":"paragraph","spans":[{"id":"spn-81727","text":"WHS will support an additional invocation auth mode for trusted backend callers (“delegators”):"}]},{"id":"blk-53721","items":[{"blocks":[{"id":"blk-53723","kind":"paragraph","spans":[{"id":"spn-81728","text":"The delegator sends a request with:"}]}],"id":"blk-53722","kind":"list-item"},{"blocks":[{"id":"blk-53725","kind":"paragraph","spans":[{"id":"spn-81729","text":"an HMAC signature computed over the "},{"id":"spn-81730","marks":["bold"],"text":"raw request body bytes"},{"id":"spn-81731","text":"."}]}],"id":"blk-53724","kind":"list-item"},{"blocks":[{"id":"blk-53727","kind":"paragraph","spans":[{"id":"spn-81732","text":"a timestamp used for replay protection."}]}],"id":"blk-53726","kind":"list-item"},{"blocks":[{"id":"blk-53729","kind":"paragraph","spans":[{"id":"spn-81733","text":"a declared delegated end-user identity ("},{"id":"spn-81734","marks":["code"],"text":"externalUserId"},{"id":"spn-81735","text":") in the JSON body."}]}],"id":"blk-53728","kind":"list-item"},{"blocks":[{"id":"blk-53731","kind":"paragraph","spans":[{"id":"spn-81736","text":"an idempotency key to prevent duplicate cost/side effects across retries."}]}],"id":"blk-53730","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53732","kind":"paragraph","spans":[{"id":"spn-81737","text":"This is "},{"id":"spn-81738","marks":["bold"],"text":"service authentication"},{"id":"spn-81739","text":" for the delegator, not user authentication. WHS must still enforce user-scoped authorization using the delegated user identity."}]},{"id":"blk-53733","kind":"heading","level":3,"spans":[{"id":"spn-81740","text":"2.2 Dedicated endpoint is preferred"}]},{"id":"blk-53734","kind":"paragraph","spans":[{"id":"spn-81741","text":"To avoid ambiguity and reduce accidental exposure, WHS SHOULD expose a dedicated endpoint:"}]},{"id":"blk-53735","items":[{"blocks":[{"id":"blk-53737","kind":"paragraph","spans":[{"id":"spn-81742","marks":["code"],"text":"POST /v1/delegated/invoke/:agentId"}]}],"id":"blk-53736","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53738","kind":"paragraph","spans":[{"id":"spn-81743","text":"This endpoint is intended for server-to-server traffic and MUST NOT accept browser JWT auth as a substitute for the delegated signature scheme. (If a combined endpoint is introduced later, it must be explicitly designed and re-reviewed.)"}]},{"id":"blk-53739","kind":"heading","level":3,"spans":[{"id":"spn-81744","text":"2.3 Delegated invocation does not bypass WHS authorization"}]},{"id":"blk-53740","kind":"paragraph","spans":[{"id":"spn-81745","text":"For delegated invocations:"}]},{"id":"blk-53741","items":[{"blocks":[{"id":"blk-53743","kind":"paragraph","spans":[{"id":"spn-81746","text":"WHS resolves "},{"id":"spn-81747","marks":["code"],"text":"externalUserId"},{"id":"spn-81748","text":" to a WHS "},{"id":"spn-81749","marks":["code"],"text":"users"},{"id":"spn-81750","text":" row."}]}],"id":"blk-53742","kind":"list-item"},{"blocks":[{"id":"blk-53745","kind":"paragraph","spans":[{"id":"spn-81751","text":"WHS enforces all standard checks "},{"id":"spn-81752","marks":["bold"],"text":"as that user"},{"id":"spn-81753","text":", including:"}]}],"id":"blk-53744","kind":"list-item"},{"blocks":[{"id":"blk-53747","kind":"paragraph","spans":[{"id":"spn-81754","text":"agent ownership/visibility (no cross-tenant access),"}]}],"id":"blk-53746","kind":"list-item"},{"blocks":[{"id":"blk-53749","kind":"paragraph","spans":[{"id":"spn-81755","text":"agent status (not disabled),"}]}],"id":"blk-53748","kind":"list-item"},{"blocks":[{"id":"blk-53751","kind":"paragraph","spans":[{"id":"spn-81756","text":"active deployment present,"}]}],"id":"blk-53750","kind":"list-item"},{"blocks":[{"id":"blk-53753","kind":"paragraph","spans":[{"id":"spn-81757","text":"plan entitlements and limits,"}]}],"id":"blk-53752","kind":"list-item"},{"blocks":[{"id":"blk-53755","kind":"paragraph","spans":[{"id":"spn-81758","text":"runtime provider gating (e.g., AgentCore tier gating),"}]}],"id":"blk-53754","kind":"list-item"},{"blocks":[{"id":"blk-53757","kind":"paragraph","spans":[{"id":"spn-81759","text":"request-limit enforcement (pre-invoke),"}]}],"id":"blk-53756","kind":"list-item"},{"blocks":[{"id":"blk-53759","kind":"paragraph","spans":[{"id":"spn-81760","text":"any additional internal safety controls."}]}],"id":"blk-53758","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53760","kind":"paragraph","spans":[{"id":"spn-81761","text":"The delegator’s HMAC signature proves only that the request came from an approved delegator. It does not grant permission to invoke arbitrary agents as arbitrary users."}]},{"id":"blk-53761","kind":"heading","level":2,"spans":[{"id":"spn-81762","text":"3) Normative request authentication"}]},{"id":"blk-53762","kind":"heading","level":3,"spans":[{"id":"spn-81763","text":"3.1 Required headers"}]},{"id":"blk-53763","kind":"paragraph","spans":[{"id":"spn-81764","text":"Delegated requests MUST include:"}]},{"id":"blk-53764","items":[{"blocks":[{"id":"blk-53766","kind":"paragraph","spans":[{"id":"spn-81765","marks":["code"],"text":"X-WHS-Delegation-Source: <string>"}]}],"id":"blk-53765","kind":"list-item"},{"blocks":[{"id":"blk-53768","kind":"paragraph","spans":[{"id":"spn-81766","marks":["code"],"text":"X-WHS-Delegation-Timestamp: <epoch_ms_as_string>"}]}],"id":"blk-53767","kind":"list-item"},{"blocks":[{"id":"blk-53770","kind":"paragraph","spans":[{"id":"spn-81767","marks":["code"],"text":"X-WHS-Delegation-Signature: v1=<hex(hmac_sha256(raw_body_bytes, WHS_DELEGATION_SECRET))>"}]}],"id":"blk-53769","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53771","kind":"paragraph","spans":[{"id":"spn-81768","text":"Rules:"}]},{"id":"blk-53772","items":[{"blocks":[{"id":"blk-53774","kind":"paragraph","spans":[{"id":"spn-81769","text":"Signature MUST be computed over the exact raw bytes received (no re-serialization differences)."}]}],"id":"blk-53773","kind":"list-item"},{"blocks":[{"id":"blk-53776","kind":"paragraph","spans":[{"id":"spn-81770","text":"Signature verification MUST occur before parsing the JSON body (except to read raw bytes)."}]}],"id":"blk-53775","kind":"list-item"},{"blocks":[{"id":"blk-53778","kind":"paragraph","spans":[{"id":"spn-81771","text":"Timestamp MUST be validated against an allowed skew window."}]}],"id":"blk-53777","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53779","kind":"paragraph","spans":[{"id":"spn-81772","text":"Recommended default skew window:"}]},{"id":"blk-53780","items":[{"blocks":[{"id":"blk-53782","kind":"paragraph","spans":[{"id":"spn-81773","marks":["code"],"text":"abs(nowMs - timestampMs) <= 300000"},{"id":"spn-81774","text":" (5 minutes)"}]}],"id":"blk-53781","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53783","kind":"paragraph","spans":[{"id":"spn-81775","text":"If signature or timestamp validation fails:"}]},{"id":"blk-53784","items":[{"blocks":[{"id":"blk-53786","kind":"paragraph","spans":[{"id":"spn-81776","text":"return a normalized error:"}]}],"id":"blk-53785","kind":"list-item"},{"blocks":[{"id":"blk-53788","kind":"paragraph","spans":[{"id":"spn-81777","marks":["code"],"text":"code: UNAUTHENTICATED"}]}],"id":"blk-53787","kind":"list-item"},{"blocks":[{"id":"blk-53790","kind":"paragraph","spans":[{"id":"spn-81778","text":"safe "},{"id":"spn-81779","marks":["code"],"text":"message"}]}],"id":"blk-53789","kind":"list-item"},{"blocks":[{"id":"blk-53792","kind":"paragraph","spans":[{"id":"spn-81780","marks":["code"],"text":"retryable: false"},{"id":"spn-81781","text":" (recommended)"}]}],"id":"blk-53791","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53793","kind":"heading","level":3,"spans":[{"id":"spn-81782","text":"3.2 Delegation source allowlist (recommended)"}]},{"id":"blk-53794","kind":"paragraph","spans":[{"id":"spn-81783","text":"WHS SHOULD maintain a small allowlist of approved delegation sources:"}]},{"id":"blk-53795","items":[{"blocks":[{"id":"blk-53797","kind":"paragraph","spans":[{"id":"spn-81784","text":"e.g., "},{"id":"spn-81785","marks":["code"],"text":"agentromatic"},{"id":"spn-81786","text":", "},{"id":"spn-81787","marks":["code"],"text":"agentelic"},{"id":"spn-81788","text":" (future), "},{"id":"spn-81789","marks":["code"],"text":"internal"}]}],"id":"blk-53796","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53798","kind":"paragraph","spans":[{"id":"spn-81790","text":"Requests with an unknown "},{"id":"spn-81791","marks":["code"],"text":"X-WHS-Delegation-Source"},{"id":"spn-81792","text":" SHOULD be rejected with "},{"id":"spn-81793","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-81794","text":"."}]},{"id":"blk-53799","kind":"paragraph","spans":[{"id":"spn-81795","text":"This reduces blast radius if the shared secret leaks to an unintended system."}]},{"id":"blk-53800","kind":"heading","level":3,"spans":[{"id":"spn-81796","text":"3.3 Body requirements (delegation envelope)"}]},{"id":"blk-53801","kind":"paragraph","spans":[{"id":"spn-81797","text":"The request body MUST include a delegation envelope:"}]},{"id":"blk-53802","items":[{"blocks":[{"id":"blk-53804","kind":"paragraph","spans":[{"id":"spn-81798","marks":["code"],"text":"delegation.mode = \"hmac_v1\""}]}],"id":"blk-53803","kind":"list-item"},{"blocks":[{"id":"blk-53806","kind":"paragraph","spans":[{"id":"spn-81799","marks":["code"],"text":"delegation.externalUserId: string"},{"id":"spn-81800","text":" (stable external auth subject id)"}]}],"id":"blk-53805","kind":"list-item"},{"blocks":[{"id":"blk-53808","kind":"paragraph","spans":[{"id":"spn-81801","marks":["code"],"text":"delegation.idempotencyKey: string"},{"id":"spn-81802","text":" (see §5)"}]}],"id":"blk-53807","kind":"list-item"},{"blocks":[{"id":"blk-53810","kind":"paragraph","spans":[{"id":"spn-81803","text":"optional correlation metadata for observability:"}]}],"id":"blk-53809","kind":"list-item"},{"blocks":[{"id":"blk-53812","kind":"paragraph","spans":[{"id":"spn-81804","text":"workflow ids, execution ids, node ids, etc."}]}],"id":"blk-53811","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53813","kind":"paragraph","spans":[{"id":"spn-81805","text":"The request body MUST include the normal invocation request shape under "},{"id":"spn-81806","marks":["code"],"text":"invoke"},{"id":"spn-81807","text":" (compatible with "},{"id":"spn-81808","marks":["code"],"text":"InvokeRequest"},{"id":"spn-81809","text":")."}]},{"id":"blk-53814","kind":"paragraph","spans":[{"id":"spn-81810","text":"The body MUST NOT include:"}]},{"id":"blk-53815","items":[{"blocks":[{"id":"blk-53817","kind":"paragraph","spans":[{"id":"spn-81811","text":"plaintext secret values (keys, tokens, credentials)"}]}],"id":"blk-53816","kind":"list-item"},{"blocks":[{"id":"blk-53819","kind":"paragraph","spans":[{"id":"spn-81812","text":"raw end-user auth tokens"}]}],"id":"blk-53818","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53820","kind":"heading","level":2,"spans":[{"id":"spn-81813","text":"4) Error semantics"}]},{"id":"blk-53821","kind":"paragraph","spans":[{"id":"spn-81814","text":"Delegated invoke MUST use the same normalized error envelope as the WHS API contracts, with stable codes, safe messages, and no secrets."}]},{"id":"blk-53822","kind":"paragraph","spans":[{"id":"spn-81815","text":"Minimum codes relevant to delegated invocation:"}]},{"id":"blk-53823","items":[{"blocks":[{"id":"blk-53825","kind":"paragraph","spans":[{"id":"spn-81816","marks":["code"],"text":"UNAUTHENTICATED"},{"id":"spn-81817","text":" (bad signature, unknown source, timestamp invalid)"}]}],"id":"blk-53824","kind":"list-item"},{"blocks":[{"id":"blk-53827","kind":"paragraph","spans":[{"id":"spn-81818","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-81819","text":" (delegated user not allowed to invoke agent)"}]}],"id":"blk-53826","kind":"list-item"},{"blocks":[{"id":"blk-53829","kind":"paragraph","spans":[{"id":"spn-81820","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-81821","text":" (agent not found or not visible to delegated user)"}]}],"id":"blk-53828","kind":"list-item"},{"blocks":[{"id":"blk-53831","kind":"paragraph","spans":[{"id":"spn-81822","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-81823","text":" (plan limits)"}]}],"id":"blk-53830","kind":"list-item"},{"blocks":[{"id":"blk-53833","kind":"paragraph","spans":[{"id":"spn-81824","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-81825","text":" (bad schema, oversized payload)"}]}],"id":"blk-53832","kind":"list-item"},{"blocks":[{"id":"blk-53835","kind":"paragraph","spans":[{"id":"spn-81826","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-81827","text":" (provider/runtime failures)"}]}],"id":"blk-53834","kind":"list-item"},{"blocks":[{"id":"blk-53837","kind":"paragraph","spans":[{"id":"spn-81828","marks":["code"],"text":"INTERNAL_ERROR"}]}],"id":"blk-53836","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53838","kind":"paragraph","spans":[{"id":"spn-81829","text":"Consistency rule:"}]},{"id":"blk-53839","items":[{"blocks":[{"id":"blk-53841","kind":"paragraph","spans":[{"id":"spn-81830","text":"Tenant isolation MUST not leak resource existence. If the delegated user cannot see the agent, prefer "},{"id":"spn-81831","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-81832","text":" over "},{"id":"spn-81833","marks":["code"],"text":"UNAUTHORIZED"},{"id":"spn-81834","text":" (align with the system’s broader IDOR strategy)."}]}],"id":"blk-53840","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53842","kind":"heading","level":2,"spans":[{"id":"spn-81835","text":"5) Idempotency requirements (MUST)"}]},{"id":"blk-53843","kind":"paragraph","spans":[{"id":"spn-81836","text":"Delegated invocations are commonly retried by orchestrators and can be executed under “at least once” semantics. Therefore:"}]},{"id":"blk-53844","kind":"heading","level":3,"spans":[{"id":"spn-81837","text":"5.1 Client-provided idempotency key is required"}]},{"id":"blk-53845","kind":"paragraph","spans":[{"id":"spn-81838","text":"Delegated invocation requests MUST include "},{"id":"spn-81839","marks":["code"],"text":"delegation.idempotencyKey"},{"id":"spn-81840","text":"."}]},{"id":"blk-53846","kind":"paragraph","spans":[{"id":"spn-81841","text":"The key MUST be:"}]},{"id":"blk-53847","items":[{"blocks":[{"id":"blk-53849","kind":"paragraph","spans":[{"id":"spn-81842","text":"stable across retries of the same logical invocation,"}]}],"id":"blk-53848","kind":"list-item"},{"blocks":[{"id":"blk-53851","kind":"paragraph","spans":[{"id":"spn-81843","text":"scoped to the logical operation (e.g., workflow execution step),"}]}],"id":"blk-53850","kind":"list-item"},{"blocks":[{"id":"blk-53853","kind":"paragraph","spans":[{"id":"spn-81844","text":"secret-free,"}]}],"id":"blk-53852","kind":"list-item"},{"blocks":[{"id":"blk-53855","kind":"paragraph","spans":[{"id":"spn-81845","text":"bounded in length (recommended <= 200 chars)."}]}],"id":"blk-53854","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53856","kind":"heading","level":3,"spans":[{"id":"spn-81846","text":"5.2 WHS idempotency behavior is required"}]},{"id":"blk-53857","kind":"paragraph","spans":[{"id":"spn-81847","text":"WHS MUST dedupe delegated invocations at minimum by:"}]},{"id":"blk-53858","items":[{"blocks":[{"id":"blk-53860","kind":"paragraph","spans":[{"id":"spn-81848","marks":["code"],"text":"(externalUserId, agentId, delegation.idempotencyKey)"}]}],"id":"blk-53859","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53861","kind":"paragraph","spans":[{"id":"spn-81849","text":"Behavior:"}]},{"id":"blk-53862","items":[{"blocks":[{"id":"blk-53864","kind":"paragraph","spans":[{"id":"spn-81850","text":"If a request is received again with the same tuple, WHS MUST return:"}]}],"id":"blk-53863","kind":"list-item"},{"blocks":[{"id":"blk-53866","kind":"paragraph","spans":[{"id":"spn-81851","text":"the same logical response (or a stable reference), and MUST NOT double-charge or double-run side effects."}]}],"id":"blk-53865","kind":"list-item"},{"blocks":[{"id":"blk-53868","kind":"paragraph","spans":[{"id":"spn-81852","text":"If the same idempotency key is reused with a different payload (material difference), WHS MUST return:"}]}],"id":"blk-53867","kind":"list-item"},{"blocks":[{"id":"blk-53870","kind":"paragraph","spans":[{"id":"spn-81853","marks":["code"],"text":"CONFLICT"},{"id":"spn-81854","text":" or "},{"id":"spn-81855","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-81856","text":" (choose one; keep consistent),"}]}],"id":"blk-53869","kind":"list-item"},{"blocks":[{"id":"blk-53872","kind":"paragraph","spans":[{"id":"spn-81857","text":"safe message: “Idempotency key reused with different payload.”"}]}],"id":"blk-53871","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53873","kind":"paragraph","spans":[{"id":"spn-81858","text":"Implementation guidance (non-normative):"}]},{"id":"blk-53874","items":[{"blocks":[{"id":"blk-53876","kind":"paragraph","spans":[{"id":"spn-81859","text":"Store an idempotency ledger row cont