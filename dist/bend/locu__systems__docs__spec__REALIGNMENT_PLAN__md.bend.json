ext":" row."}]}],"id":"blk-90327","kind":"list-item"},{"blocks":[{"id":"blk-90330","kind":"paragraph","spans":[{"id":"spn-154423","text":"[ ] Every control plane query/mutation is scoped to authenticated user."}]}],"id":"blk-90329","kind":"list-item"},{"blocks":[{"id":"blk-90332","kind":"paragraph","spans":[{"id":"spn-154424","text":"[ ] All “get by id” endpoints verify ownership/membership before returning data."}]}],"id":"blk-90331","kind":"list-item"},{"blocks":[{"id":"blk-90334","kind":"paragraph","spans":[{"id":"spn-154425","text":"[ ] Cross-tenant IDs do not leak existence (recommended: "},{"id":"spn-154426","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-154427","text":" for foreign ids, consistently applied)."}]}],"id":"blk-90333","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90335","kind":"paragraph","spans":[{"id":"spn-154428","text":"Done when:"}]},{"id":"blk-90336","items":[{"blocks":[{"id":"blk-90338","kind":"paragraph","spans":[{"id":"spn-154429","text":"You have an automated “IDOR suite” that tries random IDs from other users and always gets safe failures."}]}],"id":"blk-90337","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90339","kind":"heading","level":2,"spans":[{"id":"spn-154430","text":"3) Normalized errors: one envelope, stable codes"}]},{"id":"blk-90340","kind":"paragraph","spans":[{"id":"spn-154431","marks":["bold"],"text":"Spec sources:"},{"id":"spn-154432","text":" "},{"id":"spn-154433","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-154434","text":" (Normalized errors REQUIRED)"}]},{"id":"blk-90341","kind":"paragraph","spans":[{"id":"spn-154435","text":"Checklist:"}]},{"id":"blk-90342","items":[{"blocks":[{"id":"blk-90344","kind":"paragraph","spans":[{"id":"spn-154436","text":"[ ] All API responses use the normalized error envelope."}]}],"id":"blk-90343","kind":"list-item"},{"blocks":[{"id":"blk-90346","kind":"paragraph","spans":[{"id":"spn-154437","text":"[ ] Error "},{"id":"spn-154438","marks":[