der (hard-stop in MVP)."}]}],"id":"blk-90413","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90415","kind":"heading","level":3,"spans":[{"id":"spn-154516","text":"5.3 Streaming (if implemented)"}]},{"id":"blk-90416","kind":"paragraph","spans":[{"id":"spn-154517","text":"Checklist:"}]},{"id":"blk-90417","items":[{"blocks":[{"id":"blk-90419","kind":"paragraph","spans":[{"id":"spn-154518","text":"[ ] SSE format is consistent and versioned."}]}],"id":"blk-90418","kind":"list-item"},{"blocks":[{"id":"blk-90421","kind":"paragraph","spans":[{"id":"spn-154519","text":"[ ] Non-streaming remains the canonical contract; streaming is additive."}]}],"id":"blk-90420","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90422","kind":"paragraph","spans":[{"id":"spn-154520","text":"Done when:"}]},{"id":"blk-90423","items":[{"blocks":[{"id":"blk-90425","kind":"paragraph","spans":[{"id":"spn-154521","text":"Contract tests run against a local server and validate request/response JSON exactly as per "},{"id":"spn-154522","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-154523","text":"."}]}],"id":"blk-90424","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90426","kind":"heading","level":2,"spans":[{"id":"spn-154524","text":"6) Secrets strategy: enforce “no plaintext in DB” while remaining implementable"}]},{"id":"blk-90427","kind":"paragraph","spans":[{"id":"spn-154525","marks":["bold"],"text":"Spec sources:"},{"id":"spn-154526","text":" "},{"id":"spn-154527","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-154528","text":", "},{"id":"spn-154529","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-154530","text":", "},{"id":"spn-154531","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-154532","text":", "},{"id":"spn-154533","marks":["code"],"text":"40_SECURITY_SECRETS_COMPLIANCE.md"}]},{"id":"blk-90428","kind":"heading","level":3,"spans":[{"id":"spn-154534","text":"6.1 Customer env secrets"}]},{"id":"b