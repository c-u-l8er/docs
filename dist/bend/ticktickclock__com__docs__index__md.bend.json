{"bendscript":"0.1","blocks":[{"id":"blk-86692","kind":"heading","level":1,"spans":[{"id":"spn-121731","text":"TickTickClock Documentation"}]},{"blocks":[{"id":"blk-86694","kind":"paragraph","spans":[{"id":"spn-121732","marks":["bold"],"text":"Every tick is a learning opportunity. Every pattern has a rhythm. Temporal intelligence that never forgets."}]}],"id":"blk-86693","kind":"quote"},{"blocks":[{"id":"blk-86696","kind":"paragraph","spans":[{"id":"spn-121733","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-121734","text":" · "},{"id":"spn-121735","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-121736","text":" · "},{"id":"spn-121737","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-121738","text":" · "},{"id":"spn-121739","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-86695","kind":"quote"},{"id":"blk-86697","kind":"paragraph","spans":[{"id":"spn-121740","text":"Welcome to the documentation hub for "},{"id":"spn-121741","marks":["bold"],"text":"TickTickClock"},{"id":"spn-121742","text":" — the temporal intelligence layer for the [&] Protocol ecosystem. TickTickClock provides time-series anomaly detection, forecasting, and pattern recognition as continual learning services."}]},{"id":"blk-86698","kind":"paragraph","spans":[{"id":"spn-121743","text":"TickTickClock is the "},{"id":"spn-121744","marks":["code"],"text":"&time"},{"id":"spn-121745","text":" primitive provider, exposing "},{"id":"spn-121746","marks":["code"],"text":"&time.anomaly"},{"id":"spn-121747","text":", "},{"id":"spn-121748","marks":["code"],"text":"&time.forecast"},{"id":"spn-121749","text":", and "},{"id":"spn-121750","marks":["code"],"text":"&time.pattern"},{"id":"spn-121751","text":" capability contracts. It does not store business data, host agents, or manage workflows — it ingests temporal signals, learns their structure continuously, and returns intelligence to upstream consumers."}]},{"id":"blk-86699","kind":"heading","level":2,"spans":[{"id":"spn-121752","text":"The Problem"}]},{"id":"blk-86700","kind":"paragraph","spans":[{"id":"spn-121753","text":"Time-series intelligence in production systems is fragmented. Anomaly detection runs as a batch job. Forecasting lives in a notebook. Pattern detection is a dashboard someone checks on Mondays. None of these systems learn continuously, and none of them talk to each other."}]},{"id":"blk-86701","kind":"paragraph","spans":[{"id":"spn-121754","text":"Meanwhile, underlying models suffer from catastrophic forgetting — retrained monthly on a window of recent data, discarding everything about long-range seasonality. Multi-timescale temporal behavior requires multi-timescale memory, and no production system provides it."}]},{"id":"blk-86702","kind":"paragraph","spans":[{"id":"spn-121755","text":"TickTickClock solves this with:"}]},{"id":"blk-86703","items":[{"blocks":[{"id":"blk-86705","kind":"paragraph","spans":[{"id":"spn-121756","marks":["bold"],"text":"Continual learning"},{"id":"spn-121757","text":" — models update at inference time, no batch retraining"}]}],"id":"blk-86704","kind":"list-item"},{"blocks":[{"id":"blk-86707","kind":"paragraph","spans":[{"id":"spn-121758","marks":["bold"],"text":"Multi-timescale memory"},{"id":"spn-121759","text":" — fast (seconds), medium (hours), slow (days), glacial (months)"}]}],"id":"blk-86706","kind":"list-item"},{"blocks":[{"id":"blk-86709","kind":"paragraph","spans":[{"id":"spn-121760","marks":["bold"],"text":"Streaming-first"},{"id":"spn-121761","text":" — designed for unbounded streams, not fixed datasets"}]}],"id":"blk-86708","kind":"list-item"},{"blocks":[{"id":"blk-86711","kind":"paragraph","spans":[{"id":"spn-121762","marks":["bold"],"text":"Edge-capable"},{"id":"spn-121763","text":" — SQLite + Bumblebee on constrained devices"}]}],"id":"blk-86710","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-86712","kind":"heading","level":2,"spans":[{"id":"spn-121764","text":"Documentation Map"}]},{"id":"blk-86713","kind":"paragraph","spans":[{"id":"spn-121765","marks":["bold"],"text":"Homepages"}]},{"id":"blk-86714","items":[{"blocks":[{"id":"blk-86716","kind":"paragraph","spans":[{"id":"spn-121766","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-86715","kind":"list-item"},{"blocks":[{"id":"blk-86718","kind":"paragraph","spans":[{"id":"spn-121767","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-86717","kind":"list-item"},{"blocks":[{"id":"blk-86720","kind":"paragraph","spans":[{"id":"spn-121768","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-86719","kind":"list-item"},{"blocks":[{"id":"blk-86722","kind":"paragraph","spans":[{"id":"spn-121769","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-86721","kind":"list-item"},{"blocks":[{"id":"blk-86724","kind":"paragraph","spans":[{"id":"spn-121770","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-86723","kind":"list-item"},{"blocks":[{"id":"blk-86726","kind":"paragraph","spans":[{"id":"spn-121771","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-86725","kind":"list-item"},{"blocks":[{"id":"blk-86728","kind":"paragraph","spans":[{"id":"spn-121772","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-86727","kind":"list-item"},{"blocks":[{"id":"blk-86730","kind":"paragraph","spans":[{"id":"spn-121773","marks":[{"kind":"link","predicate":"cites","target":"https://deliberatic.com"}],"text":"Deliberatic"}]}],"id":"blk-86729","kind":"list-item"},{"blocks":[{"id":"blk-86732","kind":"paragraph","spans":[{"id":"spn-121774","marks":[{"kind":"link","predicate":"cites","target":"https://fleetprompt.com"}],"text":"FleetPrompt"}]}],"id":"blk-86731","kind":"list-item"},{"blocks":[{"id":"blk-86734","kind":"paragraph","spans":[{"id":"spn-121775","marks":[{"kind":"link","predicate":"cites","target":"https://geofleetic.com"}],"text":"GeoFleetic"}]}],"id":"blk-86733","kind":"list-item"},{"blocks":[{"id":"blk-86736","kind":"paragraph","spans":[{"id":"spn-121776","marks":[{"kind":"link","predicate":"cites","target":"https://opensentience.org"}],"text":"OpenSentience"}]}],"id":"blk-86735","kind":"list-item"},{"blocks":[{"id":"blk-86738","kind":"paragraph","spans":[{"id":"spn-121777","marks":[{"kind":"link","predicate":"cites","target":"https://specprompt.com"}],"text":"SpecPrompt"}]}],"id":"blk-86737","kind":"list-item"},{"blocks":[{"id":"blk-86740","kind":"paragraph","spans":[{"id":"spn-121778","marks":[{"kind":"link","predicate":"cites","target":"https://ticktickclock.com"}],"text":"TickTickClock"}]}],"id":"blk-86739","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-86741","kind":"paragraph","spans":[{"id":"spn-121779","marks":["bold"],"text":"Root Docs"}]},{"id":"blk-86742","items":[{"blocks":[{"id":"blk-86744","kind":"paragraph","spans":[{"id":"spn-121780","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ampersandboxdesign.com"}],"text":"[&] Protocol Docs"}]}],"id":"blk-86743","kind":"list-item"},{"blocks":[{"id":"blk-86746","kind":"paragraph","spans":[{"id":"spn-121781","marks":[{"kind":"link","predicate":"cites","target":"https://docs.graphonomous.com"}],"text":"Graphonomous Docs"}]}],"id":"blk-86745","kind":"list-item"},{"blocks":[{"id":"blk-86748","kind":"paragraph","spans":[{"id":"spn-121782","marks":[{"kind":"link","predicate":"cites","target":"https://docs.bendscript.com"}],"text":"BendScript Docs"}]}],"id":"blk-