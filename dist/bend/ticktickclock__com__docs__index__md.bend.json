{"bendscript":"0.1","blocks":[{"id":"blk-85864","kind":"heading","level":1,"spans":[{"id":"spn-119118","text":"TickTickClock Documentation"}]},{"blocks":[{"id":"blk-85866","kind":"paragraph","spans":[{"id":"spn-119119","marks":["bold"],"text":"Every tick is a learning opportunity. Every pattern has a rhythm. Temporal intelligence that never forgets."}]}],"id":"blk-85865","kind":"quote"},{"blocks":[{"id":"blk-85868","kind":"paragraph","spans":[{"id":"spn-119120","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-119121","text":" · "},{"id":"spn-119122","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-119123","text":" · "},{"id":"spn-119124","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-119125","text":" · "},{"id":"spn-119126","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-85867","kind":"quote"},{"id":"blk-85869","kind":"paragraph","spans":[{"id":"spn-119127","text":"Welcome to the documentation hub for "},{"id":"spn-119128","marks":["bold"],"text":"TickTickClock"},{"id":"spn-119129","text":" — the temporal intelligence layer for the [&] Protocol ecosystem. TickTickClock provides time-series anomaly detection, forecasting, and pattern recognition as continual learning services."}]},{"id":"blk-85870","kind":"paragraph","spans":[{"id":"spn-119130","text":"TickTickClock is the "},{"id":"spn-119131","marks":["code"],"text":"&time"},{"id":"spn-119132","text":" primitive provider, exposing "},{"id":"spn-119133","marks":["code"],"text":"&time.anomaly"},{"id":"spn-119134","text":", "},{"id":"spn-119135","marks":["code"],"text":"&time.forecast"},{"id":"spn-119136","text":", and "},{"id":"spn-119137","marks":["code"],"text":"&time.pattern"},{"id":"spn-119138","text":" capability contracts. It does not store business data, host agents, or manage workflows — it ingests temporal signals, learns their structure continuously, and returns intelligence to upstream consumers."}]},{"id":"blk-85871","kind":"heading","level":2,"spans":[{"id":"spn-119139","text":"The Problem"}]},{"id":"blk-85872","kind":"paragraph","spans":[{"id":"spn-119140","text":"Time-series intelligence in production systems is fragmented. Anomaly detection runs as a batch job. Forecasting lives in a notebook. Pattern detection is a dashboard someone checks on Mondays. None of these systems learn continuously, and none of them talk to each other."}]},{"id":"blk-85873","kind":"paragraph","spans":[{"id":"spn-119141","text":"Meanwhile, underlying models suffer from catastrophic forgetting — retrained monthly on a window of recent data, discarding everything about long-range seasonality. Multi-timescale temporal behavior requires multi-timescale memory, and no production system provides it."}]},{"id":"blk-85874","kind":"paragraph","spans":[{"id":"spn-119142","text":"TickTickClock solves this with:"}]},{"id":"blk-85875","items":[{"blocks":[{"id":"blk-85877","kind":"paragraph","spans":[{"id":"spn-119143","marks":["bold"],"text":"Continual learning"},{"id":"spn-119144","text":" — models update at inference time, no batch retraining"}]}],"id":"blk-85876","kind":"list-item"},{"blocks":[{"id":"blk-85879","kind":"paragraph","spans":[{"id":"spn-119145","marks":["bold"],"text":"Multi-timescale memory"},{"id":"spn-119146","text":" — fast (seconds), medium (hours), slow (days), glacial (months)"}]}],"id":"blk-85878","kind":"list-item"},{"blocks":[{"id":"blk-85881","kind":"paragraph","spans":[{"id":"spn-119147","marks":["bold"],"text":"Streaming-first"},{"id":"spn-119148","text":" — designed for unbounded streams, not fixed datasets"}]}],"id":"blk-85880","kind":"list-item"},{"blocks":[{"id":"blk-85883","kind":"paragraph","spans":[{"id":"spn-119149","marks":["bold"],"text":"Edge-capable"},{"id":"spn-119150","text":" — SQLite + Bumblebee on constrained devices"}]}],"id":"blk-85882","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-85884","kind":"heading","level":2,"spans":[{"id":"spn-119151","text":"Documentation Map"}]},{"id":"blk-85885","kind":"paragraph","spans":[{"id":"spn-119152","marks":["bold"],"text":"Homepages"}]},{"id":"blk-85886","items":[{"blocks":[{"id":"blk-85888","kind":"paragraph","spans":[{"id":"spn-119153","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-85887","kind":"list-item"},{"blocks":[{"id":"blk-85890","kind":"paragraph","spans":[{"id":"spn-119154","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-85889","kind":"list-item"},{"blocks":[{"id":"blk-85892","kind":"paragraph","spans":[{"id":"spn-119155","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-85891","kind":"list-item"},{"blocks":[{"id":"blk-85894","kind":"paragraph","spans":[{"id":"spn-119156","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-85893","kind":"list-item"},{"blocks":[{"id":"blk-85896","kind":"paragraph","spans":[{"id":"spn-119157","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-85895","kind":"list-item"},{"blocks":[{"id":"blk-85898","kind":"paragraph","spans":[{"id":"spn-119158","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-85897","kind":"list-item"},{"blocks":[{"id":"blk-85900","kind":"paragraph","spans":[{"id":"spn-119159","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-85899","kind":"list-item"},{"blocks":[{"id":"blk-85902","kind":"paragraph","spans":[{"id":"spn-119160","marks":[{"kind":"link","predicate":"cites","target":"https://deliberatic.com"}],"text":"Deliberatic"}]}],"id":"blk-85901","kind":"list-item"},{"blocks":[{"id":"blk-85904","kind":"paragraph","spans":[{"id":"spn-119161","marks":[{"kind":"link","predicate":"cites","target":"https://fleetprompt.com"}],"text":"FleetPrompt"}]}],"id":"blk-85903","kind":"list-item"},{"blocks":[{"id":"blk-85906","kind":"paragraph","spans":[{"id":"spn-119162","marks":[{"kind":"link","predicate":"cites","target":"https://geofleetic.com"}],"text":"GeoFleetic"}]}],"id":"blk-85905","kind":"list-item"},{"blocks":[{"id":"blk-85908","kind":"paragraph","spans":[{"id":"spn-119163","marks":[{"kind":"link","predicate":"cites","target":"https://opensentience.org"}],"text":"OpenSentience"}]}],"id":"blk-85907","kind":"list-item"},{"blocks":[{"id":"blk-85910","kind":"paragraph","spans":[{"id":"spn-119164","marks":[{"kind":"link","predicate":"cites","target":"https://specprompt.com"}],"text":"SpecPrompt"}]}],"id":"blk-85909","kind":"list-item"},{"blocks":[{"id":"blk-85912","kind":"paragraph","spans":[{"id":"spn-119165","marks":[{"kind":"link","predicate":"cites","target":"https://ticktickclock.com"}],"text":"TickTickClock"}]}],"id":"blk-85911","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-85913","kind":"paragraph","spans":[{"id":"spn-119166","marks":["bold"],"text":"Root Docs"}]},{"id":"blk-85914","items":[{"blocks":[{"id":"blk-85916","kind":"paragraph","spans":[{"id":"spn-119167","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ampersandboxdesign.com"}],"text":"[&] Protocol Docs"}]}],"id":"blk-85915","kind":"list-item"},{"blocks":[{"id":"blk-85918","kind":"paragraph","spans":[{"id":"spn-119168","marks":[{"kind":"link","predicate":"cites","target":"https://docs.graphonomous.com"}],"text":"Graphonomous Docs"}]}],"id":"blk-85917","kind":"list-item"},{"blocks":[{"id":"blk-85920","kind":"paragraph","spans":[{"id":"spn-119169","marks":[{"kind":"link","predicate":"cites","target":"https://docs.bendscript.com"}],"text":"BendScript Docs"}]}],"id":"blk-