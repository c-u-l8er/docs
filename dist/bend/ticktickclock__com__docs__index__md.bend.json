vals"}]}],[{"id":"blk-59117","spans":[{"id":"spn-69737","marks":["code"],"text":"forecast_explain"}]},{"id":"blk-59118","spans":[{"id":"spn-69738","text":"Explain forecast reasoning"}]}],[{"id":"blk-59119","spans":[{"id":"spn-69739","marks":["code"],"text":"pattern_detect"}]},{"id":"blk-59120","spans":[{"id":"spn-69740","text":"Detect cycles and motifs in time series"}]}],[{"id":"blk-59121","spans":[{"id":"spn-69741","marks":["code"],"text":"pattern_summarize"}]},{"id":"blk-59122","spans":[{"id":"spn-69742","text":"Summarize detected patterns"}]}],[{"id":"blk-59123","spans":[{"id":"spn-69743","marks":["code"],"text":"temporal_enrich"}]},{"id":"blk-59124","spans":[{"id":"spn-69744","text":"Enrich external data with temporal context"}]}],[{"id":"blk-59125","spans":[{"id":"spn-69745","marks":["code"],"text":"temporal_learn"}]},{"id":"blk-59126","spans":[{"id":"spn-69746","text":"Submit outcome data for model updates"}]}]]},{"id":"blk-59127","kind":"paragraph","spans":[{"id":"spn-69747","text":"---"}]},{"id":"blk-59128","kind":"heading","level":2,"spans":[{"id":"spn-69748","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-59130","spans":[{"id":"spn-69749","text":"Component"}]},{"id":"blk-59131","spans":[{"id":"spn-69750","text":"Role"}]},{"id":"blk-59132","spans":[{"id":"spn-69751","text":"OTP Pattern"}]}],"id":"blk-59129","kind":"table","rows":[[{"id":"blk-59133","spans":[{"id":"spn-69752","marks":["bold"],"text":"Anomaly Engine"}]},{"id":"blk-59134","spans":[{"id":"spn-69753","text":"Adaptive SSM (Mamba-style) with selective state gating"}]},{"id":"blk-59135","spans":[{"id":"spn-69754","text":"GenServer per stream"}]}],[{"id":"blk-59136","spans":[{"id":"spn-69755","marks":["bold"],"text":"Forecast Engine"}]},{"id":"blk-59137","spans":[{"id":"spn-69756","text":"Multi-timescale CCO prediction, no forgetting"}]},{"id":"blk-59138","spans":[{"id":"spn-69757","text":"GenServer + Nx"}]}],[{"id":"blk-59139","spans":[{"id":"spn-69758","marks":["bold"],"text":"Pattern Engine"}]},{"id":"blk-59140","spans":[{"id":"spn-69759","text":"Spectral + autocorrelation cycle detection"}]},{"id":"blk-59141","spans":[{"id":"spn-69760","text":"Concurrent tasks"}]}],[{"id":"blk-59142","spans":[{"id":"spn-69761","marks":["bold"],"text":"Multi-Timescale Store"}]},{"id":"blk-59143","spans":[{"id":"spn-69762","text":"Fast (ETS) → Medium → Slow → Glacial memory"}]},{"id":"blk-59144","spans":[{"id":"spn-69763","text":"Tiered storage"}]}],[{"id":"blk-59145","spans":[{"id":"spn-69764","marks":["bold"],"text":"Stream Dashboard"}]},{"id":"blk-59146","spans":[{"id":"spn-69765","text":"Anomaly timeline, forecast explorer, pattern viewer"}]},{"id":"blk-59147","spans":[{"id":"spn-69766","text":"Phoenix LiveView"}]}]]},{"id":"blk-59148","kind":"heading","level":3,"spans":[{"id":"spn-69767","text":"Multi-Timescale Memory"}]},{"head":[{"id":"blk-59150","spans":[{"id":"spn-69768","text":"Tier"}]},{"id":"blk-59151","spans":[{"id":"spn-69769","text":"Latency"}]},{"id":"blk-59152","spans":[{"id":"spn-69770","text":"Storage"}]},{"id":"blk-59153","spans":[{"id":"spn-69771","text":"Contents"}]}],"id":"blk-59149","kind":"table","rows":[[{"id":"blk-59154","spans":[{"id":"spn-69772","marks":["bold"],"text":"Fast"}]},{"id":"blk-59155","spans":[{"id":"spn-69773","text":"seconds"}]},{"id":"blk-59156","spans":[{"id":"spn-69774","text":"ETS"}]},{"id":"blk-59157","spans":[{"id":"spn-69775","text":"Per-tick state snapshots"}]}],[{"id":"blk-59158","spans":[{"id":"spn-69776","marks":["bold"],"text":"Medium"}]},{"id":"blk-59159","spans":[{"id":"spn-69777","text":"hours"}]},{"id":"blk-59160","spans":[{"id":"spn-69778","text":"SQLite/TimescaleDB"}]},{"id":"blk-59161","spans":[{"id":"spn-69779","text":"Aggregated state vectors"}]}],[{"id":"blk-59162","spans":[{"id":"spn-69780","marks":["bold"],"text":"Slow"}]},{"id":"blk-59163","spans":[{"id":"spn-69781","text":"days"}]},{"id":"blk-59164","spans":[{"id":"spn-69782","text":"SQLite/TimescaleDB"}]},{"id":"blk-59165","spans":[{"id":"spn-69783","text":"Consolidated summaries"}]}],[{"id":"blk-59166","spans":[{"id":"spn-69784","marks":["bold"],"text":"Glacial"}]},{"id":"blk-59167","spans":[{"id":"spn-69785","text":"months"}]},{"id":"blk-59168","spans":[{"id":"spn-69786","text":"SQLite/TimescaleDB"}]},{"id":"blk-59169","spans":[{"id":"spn-69787","text":"Long-range seasonal models"}]}]]},{"id":"blk-59170","kind":"paragraph","spans":[{"id":"spn-69788","text":"---"}]},{"id":"blk-59171","kind":"heading","level":2,"spans":[{"id":"spn-69789","text":"Paired With"}]},{"head":[{"id":"blk-59173","spans":[{"id":"spn-69790","text":"Product"}]},{"id":"blk-59174","spans":[{"id":"spn-69791","text":"Relationship"}]}],"id":"blk-59172","kind":"table","rows":[[{"id":"blk-59175","spans":[{"id":"spn-69792","marks":["bold"],"text":"GeoFleetic"}]},{"id":"blk-59176","spans":[{"id":"spn-69793","text":"Spatial intelligence — when + where = complete situational awareness"}]}],[{"id":"blk-59177","spans":[{"id":"spn-69794","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-59178","spans":[{"id":"spn-69795","text":"Continual learning substrate for temporal knowledge"}]}],[{"id":"blk-59179","spans":[{"id":"spn-69796","marks":["bold"],"text":"Delegatic"}]},{"id":"blk-59180","spans":[{"id":"spn-69797","text":"Governance enforcement for temporal operations"}]}]]},{"id":"blk-59181","kind":"paragraph","spans":[{"id":"spn-69798","text":"---"}]},{"id":"blk-59182","kind":"heading","level":2,"spans":[{"id":"spn-69799","text":"Tech Stack"}]},{"head":[{"id":"blk-59184","spans":[{"id":"spn-69800","text":"Layer"}]},{"id":"blk-59185","spans":[{"id":"spn-69801","text":"Technology"}]}],"id":"blk-59183","kind":"table","rows":[[{"id":"blk-59186","spans":[{"id":"spn-69802","text":"Language"}]},{"id":"blk-59187","spans":[{"id":"spn-69803","text":"Elixir 1.17+"}]}],[{"id":"blk-59188","spans":[{"id":"spn-69804","text":"Framework"}]},{"id":"blk-59189","spans":[{"id":"spn-69805","text":"Phoenix 1.8+"}]}],[{"id":"blk-59190","spans":[{"id":"spn-69806","text":