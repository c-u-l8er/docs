{"bendscript":"0.1","blocks":[{"id":"blk-118229","kind":"heading","level":1,"spans":[{"id":"spn-194678","text":"TickTickClock Documentation"}]},{"blocks":[{"id":"blk-118231","kind":"paragraph","spans":[{"id":"spn-194679","marks":["bold"],"text":"Every tick is a learning opportunity. Every pattern has a rhythm. Temporal intelligence that never forgets."}]}],"id":"blk-118230","kind":"quote"},{"blocks":[{"id":"blk-118233","kind":"paragraph","spans":[{"id":"spn-194680","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-194681","text":" · "},{"id":"spn-194682","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-194683","text":" · "},{"id":"spn-194684","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-194685","text":" · "},{"id":"spn-194686","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-118232","kind":"quote"},{"id":"blk-118234","kind":"paragraph","spans":[{"id":"spn-194687","text":"Welcome to the documentation hub for "},{"id":"spn-194688","marks":["bold"],"text":"TickTickClock"},{"id":"spn-194689","text":" — the temporal intelligence layer for the [&] Protocol ecosystem. TickTickClock provides time-series anomaly detection, forecasting, and pattern recognition as continual learning services."}]},{"id":"blk-118235","kind":"paragraph","spans":[{"id":"spn-194690","text":"TickTickClock is the "},{"id":"spn-194691","marks":["code"],"text":"&time"},{"id":"spn-194692","text":" primitive provider, exposing "},{"id":"spn-194693","marks":["code"],"text":"&time.anomaly"},{"id":"spn-194694","text":", "},{"id":"spn-194695","marks":["code"],"text":"&time.forecast"},{"id":"spn-194696","text":", and "},{"id":"spn-194697","marks":["code"],"text":"&time.pattern"},{"id":"spn-194698","text":" capability contracts. It does not store business data, host agents, or manage workflows — it ingests temporal signals, learns their structure continuously, and returns intelligence to upstream consumers."}]},{"id":"blk-118236","kind":"heading","level":2,"spans":[{"id":"spn-194699","text":"The Problem"}]},{"id":"blk-118237","kind":"paragraph","spans":[{"id":"spn-194700","text":"Time-series intelligence in production systems is fragmented. Anomaly detection runs as a batch job. Forecasting lives in a notebook. Pattern detection is a dashboard someone checks on Mondays. None of these systems learn continuously, and none of them talk to each other."}]},{"id":"blk-118238","kind":"paragraph","spans":[{"id":"spn-194701","text":"Meanwhile, underlying models suffer from catastrophic forgetting — retrained monthly on a window of recent data, discarding everything about long-range seasonality. Multi-timescale temporal behavior requires multi-timescale memory, and no production system provides it."}]},{"id":"blk-118239","kind":"paragraph","spans":[{"id":"spn-194702","text":"TickTickClock solves this with:"}]},{"id":"blk-118240","items":[{"blocks":[{"id":"blk-118242","kind":"paragraph","spans":[{"id":"spn-194703","marks":["bold"],"text":"Continual learning"},{"id":"spn-194704","text":" — models update at inference time, no batch retraining"}]}],"id":"blk-118241","kind":"list-item"},{"blocks":[{"id":"blk-118244","kind":"paragraph","spans":[{"id":"spn-194705","marks":["bold"],"text":"Multi-timescale memory"},{"id":"spn-194706","text":" — fast (seconds), medium (hours), slow (days), glacial (months)"}]}],"id":"blk-118243","kind":"list-item"},{"blocks":[{"id":"blk-118246","kind":"paragraph","spans":[{"id":"spn-194707","marks":["bold"],"text":"Streaming-first"},{"id":"spn-194708","text":" — designed for unbounded streams, not fixed datasets"}]}],"id":"blk-118245","kind":"list-item"},{"blocks":[{"id":"blk-118248","kind":"paragraph","spans":[{"id":"spn-194709","marks":["bold"],"text":"Edge-capable"},{"id":"spn-194710","text":" — SQLite + Bumblebee on constrained devices"}]}],"id":"blk-118247","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-118249","kind":"heading","level":2,"spans":[{"id":"spn-194711","text":"Documentation Map"}]},{"id":"blk-118250","kind":"paragraph","spans":[{"id":"spn-194712","marks":["bold"],"text":"Homepages"}]},{"id":"blk-118251","items":[{"blocks":[{"id":"blk-118253","kind":"paragraph","spans":[{"id":"spn-194713","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-118252","kind":"list-item"},{"blocks":[{"id":"blk-118255","kind":"paragraph","spans":[{"id":"spn-194714","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-118254","kind":"list-item"},{"blocks":[{"id":"blk-118257","kind":"paragraph","spans":[{"id":"spn-194715","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-118256","kind":"list-item"},{"blocks":[{"id":"blk-118259","kind":"paragraph","spans":[{"id":"spn-194716","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-118258","kind":"list-item"},{"blocks":[{"id":"blk-118261","kind":"paragraph","spans":[{"id":"spn-194717","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-118260","kind":"list-item"},{"blocks":[{"id":"blk-118263","kind":"paragraph","spans":[{"id":"spn-194718","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-118262","kind":"list-item"},{"blocks":[{"id":"blk-118265","kind":"paragraph","spans":[{"id":"spn-194719","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-118264","kind":"list-item"},{"blocks":[{"id":"blk-118267","kind":"paragraph","spans":[{"id":"spn-194720","marks":[{"kind":"link","predicate"