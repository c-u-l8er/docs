{"bendscript":"0.1","blocks":[{"id":"blk-85738","kind":"heading","level":1,"spans":[{"id":"spn-118970","text":"TickTickClock Documentation"}]},{"blocks":[{"id":"blk-85740","kind":"paragraph","spans":[{"id":"spn-118971","marks":["bold"],"text":"Every tick is a learning opportunity. Every pattern has a rhythm. Temporal intelligence that never forgets."}]}],"id":"blk-85739","kind":"quote"},{"blocks":[{"id":"blk-85742","kind":"paragraph","spans":[{"id":"spn-118972","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-118973","text":" · "},{"id":"spn-118974","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-118975","text":" · "},{"id":"spn-118976","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-118977","text":" · "},{"id":"spn-118978","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-85741","kind":"quote"},{"id":"blk-85743","kind":"paragraph","spans":[{"id":"spn-118979","text":"Welcome to the documentation hub for "},{"id":"spn-118980","marks":["bold"],"text":"TickTickClock"},{"id":"spn-118981","text":" — the temporal intelligence layer for the [&] Protocol ecosystem. TickTickClock provides time-series anomaly detection, forecasting, and pattern recognition as continual learning services."}]},{"id":"blk-85744","kind":"paragraph","spans":[{"id":"spn-118982","text":"TickTickClock is the "},{"id":"spn-118983","marks":["code"],"text":"&time"},{"id":"spn-118984","text":" primitive provider, exposing "},{"id":"spn-118985","marks":["code"],"text":"&time.anomaly"},{"id":"spn-118986","text":", "},{"id":"spn-118987","marks":["code"],"text":"&time.forecast"},{"id":"spn-118988","text":", and "},{"id":"spn-118989","marks":["code"],"text":"&time.pattern"},{"id":"spn-118990","text":" capability contracts. It does not store business data, host agents, or manage workflows — it ingests temporal signals, learns their structure continuously, and returns intelligence to upstream consumers."}]},{"id":"blk-85745","kind":"heading","level":2,"spans":[{"id":"spn-118991","text":"The Problem"}]},{"id":"blk-85746","kind":"paragraph","spans":[{"id":"spn-118992","text":"Time-series intelligence in production systems is fragmented. Anomaly detection runs as a batch job. Forecasting lives in a notebook. Pattern detection is a dashboard someone checks on Mondays. None of these systems learn continuously, and none of them talk to each other."}]},{"id":"blk-85747","kind":"paragraph","spans":[{"id":"spn-118993","text":"Meanwhile, underlying models suffer from catastrophic forgetting — retrained monthly on a window of recent data, discarding everything about long-range seasonality. Multi-timescale temporal behavior requires multi-timescale memory, and no production system provides it."}]},{"id":"blk-85748","kind":"paragraph","spans":[{"id":"spn-118994","text":"TickTickClock solves this with:"}]},{"id":"blk-85749","items":[{"blocks":[{"id":"blk-85751","kind":"paragraph","spans":[{"id":"spn-118995","marks":["bold"],"text":"Continual learning"},{"id":"spn-118996","text":" — models update at inference time, no batch retraining"}]}],"id":"blk-85750","kind":"list-item"},{"blocks":[{"id":"blk-85753","kind":"paragraph","spans":[{"id":"spn-118997","marks":["bold"],"text":"Multi-timescale memory"},{"id":"spn-118998","text":" — fast (seconds), medium (hours), slow (days), glacial (months)"}]}],"id":"blk-85752","kind":"list-item"},{"blocks":[{"id":"blk-85755","kind":"paragraph","spans":[{"id":"spn-118999","marks":["bold"],"text":"Streaming-first"},{"id":"spn-119000","text":" — designed for unbounded streams, not fixed datasets"}]}],"id":"blk-85754","kind":"list-item"},{"blocks":[{"id":"blk-85757","kind":"paragraph","spans":[{"id":"spn-119001","marks":["bold"],"text":"Edge-capable"},{"id":"spn-119002","text":" — SQLite + Bumblebee on constrained devices"}]}],"id":"blk-85756","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-85758","kind":"heading","level":2,"spans":[{"id":"spn-119003","text":"Documentation Map"}]},{"id":"blk-85759","kind":"paragraph","spans":[{"id":"spn-119004","marks":["bold"],"text":"Homepages"}]},{"id":"blk-85760","items":[{"blocks":[{"id":"blk-85762","kind":"paragraph","spans":[{"id":"spn-119005","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-85761","kind":"list-item"},{"blocks":[{"id":"blk-85764","kind":"paragraph","spans":[{"id":"spn-119006","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-85763","kind":"list-item"},{"blocks":[{"id":"blk-85766","kind":"paragraph","spans":[{"id":"spn-119007","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-85765","kind":"list-item"},{"blocks":[{"id":"blk-85768","kind":"paragraph","spans":[{"id":"spn-119008","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-85767","kind":"list-item"},{"blocks":[{"id":"blk-85770","kind":"paragraph","spans":[{"id":"spn-119009","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-85769","kind":"list-item"},{"blocks":[{"id":"blk-85772","kind":"paragraph","spans":[{"id":"spn-119010","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-85771","kind":"list-item"},{"blocks":[{"id":"blk-85774","kind":"paragraph","spans":[{"id":"spn-119011","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-85773","kind":"list-item"},{"blocks":[{"id":"blk-85776","kind":"paragraph","spans":[{"id":"spn-119012","marks":[{"kind":"link","predicate":"cites","target":"https://deliberatic.com"}],"text":"Deliberatic"}]}],"id":"blk-85775","kind":"list-item"},{"blocks":[{"id":"blk-85778","kind":"paragraph","spans":[{"id":"spn-119013","marks":[{"kind":"link","predicate":"cites","target":"https://fleetprompt.com"}],"text":"FleetPrompt"}]}],"id":"blk-85777","kind":"list-item"},{"blocks":[{"id":"blk-85780","kind":"paragraph","spans":[{"id":"spn-119014","marks":[{"kind":"link","predicate":"cites","target":"https://geofleetic.com"}],"text":"GeoFleetic"}]}],"id":"blk-85779","kind":"list-item"},{"blocks":[{"id":"blk-85782","kind":"paragraph","spans":[{"id":"spn-119015","marks":[{"kind":"link","predicate":"cites","target":"https://opensentience.org"}],"text":"OpenSentience"}]}],"id":"blk-85781","kind":"list-item"},{"blocks":[{"id":"blk-85784","kind":"paragraph","spans":[{"id":"spn-119016","marks":[{"kind":"link","predicate":"cites","target":"https://specprompt.com"}],"text":"SpecPrompt"}]}],"id":"blk-85783","kind":"list-item"},{"blocks":[{"id":"blk-85786","kind":"paragraph","spans":[{"id":"spn-119017","marks":[{"kind":"link","predicate":"cites","target":"https://ticktickclock.com"}],"text":"TickTickClock"}]}],"id":"blk-85785","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-85787","kind":"paragraph","spans":[{"id":"spn-119018","marks":["bold"],"text":"Root Docs"}]},{"id":"blk-85788","items":[{"blocks":[{"id":"blk-85790","kind":"paragraph","spans":[{"id":"spn-119019","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ampersandboxdesign.com"}],"text":"[&] Protocol Docs"}]}],"id":"blk-85789","kind":"list-item"},{"blocks":[{"id":"blk-85792","kind":"paragraph","spans":[{"id":"spn-119020","marks":[{"kind":"link","predicate":"cites","target":"https://docs.graphonomous.com"}],"text":"Graphonomous Docs"}]}],"id":"blk-85791","kind":"list-item"},{"blocks":[{"id":"blk-85794","kind":"paragraph","spans":[{"id":"spn-119021","marks":[{"kind":"link","predicate":"cites","target":"https://docs.bendscript.com"}],"text":"BendScript Docs"}]}],"id":"blk-