vals"}]}],[{"id":"blk-58631","spans":[{"id":"spn-68617","marks":["code"],"text":"forecast_explain"}]},{"id":"blk-58632","spans":[{"id":"spn-68618","text":"Explain forecast reasoning"}]}],[{"id":"blk-58633","spans":[{"id":"spn-68619","marks":["code"],"text":"pattern_detect"}]},{"id":"blk-58634","spans":[{"id":"spn-68620","text":"Detect cycles and motifs in time series"}]}],[{"id":"blk-58635","spans":[{"id":"spn-68621","marks":["code"],"text":"pattern_summarize"}]},{"id":"blk-58636","spans":[{"id":"spn-68622","text":"Summarize detected patterns"}]}],[{"id":"blk-58637","spans":[{"id":"spn-68623","marks":["code"],"text":"temporal_enrich"}]},{"id":"blk-58638","spans":[{"id":"spn-68624","text":"Enrich external data with temporal context"}]}],[{"id":"blk-58639","spans":[{"id":"spn-68625","marks":["code"],"text":"temporal_learn"}]},{"id":"blk-58640","spans":[{"id":"spn-68626","text":"Submit outcome data for model updates"}]}]]},{"id":"blk-58641","kind":"paragraph","spans":[{"id":"spn-68627","text":"---"}]},{"id":"blk-58642","kind":"heading","level":2,"spans":[{"id":"spn-68628","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-58644","spans":[{"id":"spn-68629","text":"Component"}]},{"id":"blk-58645","spans":[{"id":"spn-68630","text":"Role"}]},{"id":"blk-58646","spans":[{"id":"spn-68631","text":"OTP Pattern"}]}],"id":"blk-58643","kind":"table","rows":[[{"id":"blk-58647","spans":[{"id":"spn-68632","marks":["bold"],"text":"Anomaly Engine"}]},{"id":"blk-58648","spans":[{"id":"spn-68633","text":"Adaptive SSM (Mamba-style) with selective state gating"}]},{"id":"blk-58649","spans":[{"id":"spn-68634","text":"GenServer per stream"}]}],[{"id":"blk-58650","spans":[{"id":"spn-68635","marks":["bold"],"text":"Forecast Engine"}]},{"id":"blk-58651","spans":[{"id":"spn-68636","text":"Multi-timescale CCO prediction, no forgetting"}]},{"id":"blk-58652","spans":[{"id":"spn-68637","text":"GenServer + Nx"}]}],[{"id":"blk-58653","spans":[{"id":"spn-68638","marks":["bold"],"text":"Pattern Engine"}]},{"id":"blk-58654","spans":[{"id":"spn-68639","text":"Spectral + autocorrelation cycle detection"}]},{"id":"blk-58655","spans":[{"id":"spn-68640","text":"Concurrent tasks"}]}],[{"id":"blk-58656","spans":[{"id":"spn-68641","marks":["bold"],"text":"Multi-Timescale Store"}]},{"id":"blk-58657","spans":[{"id":"spn-68642","text":"Fast (ETS) → Medium → Slow → Glacial memory"}]},{"id":"blk-58658","spans":[{"id":"spn-68643","text":"Tiered storage"}]}],[{"id":"blk-58659","spans":[{"id":"spn-68644","marks":["bold"],"text":"Stream Dashboard"}]},{"id":"blk-58660","spans":[{"id":"spn-68645","text":"Anomaly timeline, forecast explorer, pattern viewer"}]},{"id":"blk-58661","spans":[{"id":"spn-68646","text":"Phoenix LiveView"}]}]]},{"id":"blk-58662","kind":"heading","level":3,"spans":[{"id":"spn-68647","text":"Multi-Timescale Memory"}]},{"head":[{"id":"blk-58664","spans":[{"id":"spn-68648","text":"Tier"}]},{"id":"blk-58665","spans":[{"id":"spn-68649","text":"Latency"}]},{"id":"blk-58666","spans":[{"id":"spn-68650","text":"Storage"}]},{"id":"blk-58667","spans":[{"id":"spn-68651","text":"Contents"}]}],"id":"blk-58663","kind":"table","rows":[[{"id":"blk-58668","spans":[{"id":"spn-68652","marks":["bold"],"text":"Fast"}]},{"id":"blk-58669","spans":[{"id":"spn-68653","text":"seconds"}]},{"id":"blk-58670","spans":[{"id":"spn-68654","text":"ETS"}]},{"id":"blk-58671","spans":[{"id":"spn-68655","text":"Per-tick state snapshots"}]}],[{"id":"blk-58672","spans":[{"id":"spn-68656","marks":["bold"],"text":"Medium"}]},{"id":"blk-58673","spans":[{"id":"spn-68657","text":"hours"}]},{"id":"blk-58674","spans":[{"id":"spn-68658","text":"SQLite/TimescaleDB"}]},{"id":"blk-58675","spans":[{"id":"spn-68659","text":"Aggregated state vectors"}]}],[{"id":"blk-58676","spans":[{"id":"spn-68660","marks":["bold"],"text":"Slow"}]},{"id":"blk-58677","spans":[{"id":"spn-68661","text":"days"}]},{"id":"blk-58678","spans":[{"id":"spn-68662","text":"SQLite/TimescaleDB"}]},{"id":"blk-58679","spans":[{"id":"spn-68663","text":"Consolidated summaries"}]}],[{"id":"blk-58680","spans":[{"id":"spn-68664","marks":["bold"],"text":"Glacial"}]},{"id":"blk-58681","spans":[{"id":"spn-68665","text":"months"}]},{"id":"blk-58682","spans":[{"id":"spn-68666","text":"SQLite/TimescaleDB"}]},{"id":"blk-58683","spans":[{"id":"spn-68667","text":"Long-range seasonal models"}]}]]},{"id":"blk-58684","kind":"paragraph","spans":[{"id":"spn-68668","text":"---"}]},{"id":"blk-58685","kind":"heading","level":2,"spans":[{"id":"spn-68669","text":"Paired With"}]},{"head":[{"id":"blk-58687","spans":[{"id":"spn-68670","text":"Product"}]},{"id":"blk-58688","spans":[{"id":"spn-68671","text":"Relationship"}]}],"id":"blk-58686","kind":"table","rows":[[{"id":"blk-58689","spans":[{"id":"spn-68672","marks":["bold"],"text":"GeoFleetic"}]},{"id":"blk-58690","spans":[{"id":"spn-68673","text":"Spatial intelligence — when + where = complete situational awareness"}]}],[{"id":"blk-58691","spans":[{"id":"spn-68674","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-58692","spans":[{"id":"spn-68675","text":"Continual learning substrate for temporal knowledge"}]}],[{"id":"blk-58693","spans":[{"id":"spn-68676","marks":["bold"],"text":"Delegatic"}]},{"id":"blk-58694","spans":[{"id":"spn-68677","text":"Governance enforcement for temporal operations"}]}]]},{"id":"blk-58695","kind":"paragraph","spans":[{"id":"spn-68678","text":"---"}]},{"id":"blk-58696","kind":"heading","level":2,"spans":[{"id":"spn-68679","text":"Tech Stack"}]},{"head":[{"id":"blk-58698","spans":[{"id":"spn-68680","text":"Layer"}]},{"id":"blk-58699","spans":[{"id":"spn-68681","text":"Technology"}]}],"id":"blk-58697","kind":"table","rows":[[{"id":"blk-58700","spans":[{"id":"spn-68682","text":"Language"}]},{"id":"blk-58701","spans":[{"id":"spn-68683","text":"Elixir 1.17+"}]}],[{"id":"blk-58702","spans":[{"id":"spn-68684","text":"Framework"}]},{"id":"blk-58703","spans":[{"id":"spn-68685","text":"Phoenix 1.8+"}]}],[{"id":"blk-58704","spans":[{"id":"spn-68686","text":