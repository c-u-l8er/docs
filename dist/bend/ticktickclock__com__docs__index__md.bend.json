vals"}]}],[{"id":"blk-58145","spans":[{"id":"spn-67443","marks":["code"],"text":"forecast_explain"}]},{"id":"blk-58146","spans":[{"id":"spn-67444","text":"Explain forecast reasoning"}]}],[{"id":"blk-58147","spans":[{"id":"spn-67445","marks":["code"],"text":"pattern_detect"}]},{"id":"blk-58148","spans":[{"id":"spn-67446","text":"Detect cycles and motifs in time series"}]}],[{"id":"blk-58149","spans":[{"id":"spn-67447","marks":["code"],"text":"pattern_summarize"}]},{"id":"blk-58150","spans":[{"id":"spn-67448","text":"Summarize detected patterns"}]}],[{"id":"blk-58151","spans":[{"id":"spn-67449","marks":["code"],"text":"temporal_enrich"}]},{"id":"blk-58152","spans":[{"id":"spn-67450","text":"Enrich external data with temporal context"}]}],[{"id":"blk-58153","spans":[{"id":"spn-67451","marks":["code"],"text":"temporal_learn"}]},{"id":"blk-58154","spans":[{"id":"spn-67452","text":"Submit outcome data for model updates"}]}]]},{"id":"blk-58155","kind":"paragraph","spans":[{"id":"spn-67453","text":"---"}]},{"id":"blk-58156","kind":"heading","level":2,"spans":[{"id":"spn-67454","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-58158","spans":[{"id":"spn-67455","text":"Component"}]},{"id":"blk-58159","spans":[{"id":"spn-67456","text":"Role"}]},{"id":"blk-58160","spans":[{"id":"spn-67457","text":"OTP Pattern"}]}],"id":"blk-58157","kind":"table","rows":[[{"id":"blk-58161","spans":[{"id":"spn-67458","marks":["bold"],"text":"Anomaly Engine"}]},{"id":"blk-58162","spans":[{"id":"spn-67459","text":"Adaptive SSM (Mamba-style) with selective state gating"}]},{"id":"blk-58163","spans":[{"id":"spn-67460","text":"GenServer per stream"}]}],[{"id":"blk-58164","spans":[{"id":"spn-67461","marks":["bold"],"text":"Forecast Engine"}]},{"id":"blk-58165","spans":[{"id":"spn-67462","text":"Multi-timescale CCO prediction, no forgetting"}]},{"id":"blk-58166","spans":[{"id":"spn-67463","text":"GenServer + Nx"}]}],[{"id":"blk-58167","spans":[{"id":"spn-67464","marks":["bold"],"text":"Pattern Engine"}]},{"id":"blk-58168","spans":[{"id":"spn-67465","text":"Spectral + autocorrelation cycle detection"}]},{"id":"blk-58169","spans":[{"id":"spn-67466","text":"Concurrent tasks"}]}],[{"id":"blk-58170","spans":[{"id":"spn-67467","marks":["bold"],"text":"Multi-Timescale Store"}]},{"id":"blk-58171","spans":[{"id":"spn-67468","text":"Fast (ETS) → Medium → Slow → Glacial memory"}]},{"id":"blk-58172","spans":[{"id":"spn-67469","text":"Tiered storage"}]}],[{"id":"blk-58173","spans":[{"id":"spn-67470","marks":["bold"],"text":"Stream Dashboard"}]},{"id":"blk-58174","spans":[{"id":"spn-67471","text":"Anomaly timeline, forecast explorer, pattern viewer"}]},{"id":"blk-58175","spans":[{"id":"spn-67472","text":"Phoenix LiveView"}]}]]},{"id":"blk-58176","kind":"heading","level":3,"spans":[{"id":"spn-67473","text":"Multi-Timescale Memory"}]},{"head":[{"id":"blk-58178","spans":[{"id":"spn-67474","text":"Tier"}]},{"id":"blk-58179","spans":[{"id":"spn-67475","text":"Latency"}]},{"id":"blk-58180","spans":[{"id":"spn-67476","text":"Storage"}]},{"id":"blk-58181","spans":[{"id":"spn-67477","text":"Contents"}]}],"id":"blk-58177","kind":"table","rows":[[{"id":"blk-58182","spans":[{"id":"spn-67478","marks":["bold"],"text":"Fast"}]},{"id":"blk-58183","spans":[{"id":"spn-67479","text":"seconds"}]},{"id":"blk-58184","spans":[{"id":"spn-67480","text":"ETS"}]},{"id":"blk-58185","spans":[{"id":"spn-67481","text":"Per-tick state snapshots"}]}],[{"id":"blk-58186","spans":[{"id":"spn-67482","marks":["bold"],"text":"Medium"}]},{"id":"blk-58187","spans":[{"id":"spn-67483","text":"hours"}]},{"id":"blk-58188","spans":[{"id":"spn-67484","text":"SQLite/TimescaleDB"}]},{"id":"blk-58189","spans":[{"id":"spn-67485","text":"Aggregated state vectors"}]}],[{"id":"blk-58190","spans":[{"id":"spn-67486","marks":["bold"],"text":"Slow"}]},{"id":"blk-58191","spans":[{"id":"spn-67487","text":"days"}]},{"id":"blk-58192","spans":[{"id":"spn-67488","text":"SQLite/TimescaleDB"}]},{"id":"blk-58193","spans":[{"id":"spn-67489","text":"Consolidated summaries"}]}],[{"id":"blk-58194","spans":[{"id":"spn-67490","marks":["bold"],"text":"Glacial"}]},{"id":"blk-58195","spans":[{"id":"spn-67491","text":"months"}]},{"id":"blk-58196","spans":[{"id":"spn-67492","text":"SQLite/TimescaleDB"}]},{"id":"blk-58197","spans":[{"id":"spn-67493","text":"Long-range seasonal models"}]}]]},{"id":"blk-58198","kind":"paragraph","spans":[{"id":"spn-67494","text":"---"}]},{"id":"blk-58199","kind":"heading","level":2,"spans":[{"id":"spn-67495","text":"Paired With"}]},{"head":[{"id":"blk-58201","spans":[{"id":"spn-67496","text":"Product"}]},{"id":"blk-58202","spans":[{"id":"spn-67497","text":"Relationship"}]}],"id":"blk-58200","kind":"table","rows":[[{"id":"blk-58203","spans":[{"id":"spn-67498","marks":["bold"],"text":"GeoFleetic"}]},{"id":"blk-58204","spans":[{"id":"spn-67499","text":"Spatial intelligence — when + where = complete situational awareness"}]}],[{"id":"blk-58205","spans":[{"id":"spn-67500","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-58206","spans":[{"id":"spn-67501","text":"Continual learning substrate for temporal knowledge"}]}],[{"id":"blk-58207","spans":[{"id":"spn-67502","marks":["bold"],"text":"Delegatic"}]},{"id":"blk-58208","spans":[{"id":"spn-67503","text":"Governance enforcement for temporal operations"}]}]]},{"id":"blk-58209","kind":"paragraph","spans":[{"id":"spn-67504","text":"---"}]},{"id":"blk-58210","kind":"heading","level":2,"spans":[{"id":"spn-67505","text":"Tech Stack"}]},{"head":[{"id":"blk-58212","spans":[{"id":"spn-67506","text":"Layer"}]},{"id":"blk-58213","spans":[{"id":"spn-67507","text":"Technology"}]}],"id":"blk-58211","kind":"table","rows":[[{"id":"blk-58214","spans":[{"id":"spn-67508","text":"Language"}]},{"id":"blk-58215","spans":[{"id":"spn-67509","text":"Elixir 1.17+"}]}],[{"id":"blk-58216","spans":[{"id":"spn-67510","text":"Framework"}]},{"id":"blk-58217","spans":[{"id":"spn-67511","text":"Phoenix 1.8+"}]}],[{"id":"blk-58218","spans":[{"id":"spn-67512","text":