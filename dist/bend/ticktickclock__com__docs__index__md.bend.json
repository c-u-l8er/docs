vals"}]}],[{"id":"blk-58015","spans":[{"id":"spn-66731","marks":["code"],"text":"forecast_explain"}]},{"id":"blk-58016","spans":[{"id":"spn-66732","text":"Explain forecast reasoning"}]}],[{"id":"blk-58017","spans":[{"id":"spn-66733","marks":["code"],"text":"pattern_detect"}]},{"id":"blk-58018","spans":[{"id":"spn-66734","text":"Detect cycles and motifs in time series"}]}],[{"id":"blk-58019","spans":[{"id":"spn-66735","marks":["code"],"text":"pattern_summarize"}]},{"id":"blk-58020","spans":[{"id":"spn-66736","text":"Summarize detected patterns"}]}],[{"id":"blk-58021","spans":[{"id":"spn-66737","marks":["code"],"text":"temporal_enrich"}]},{"id":"blk-58022","spans":[{"id":"spn-66738","text":"Enrich external data with temporal context"}]}],[{"id":"blk-58023","spans":[{"id":"spn-66739","marks":["code"],"text":"temporal_learn"}]},{"id":"blk-58024","spans":[{"id":"spn-66740","text":"Submit outcome data for model updates"}]}]]},{"id":"blk-58025","kind":"paragraph","spans":[{"id":"spn-66741","text":"---"}]},{"id":"blk-58026","kind":"heading","level":2,"spans":[{"id":"spn-66742","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-58028","spans":[{"id":"spn-66743","text":"Component"}]},{"id":"blk-58029","spans":[{"id":"spn-66744","text":"Role"}]},{"id":"blk-58030","spans":[{"id":"spn-66745","text":"OTP Pattern"}]}],"id":"blk-58027","kind":"table","rows":[[{"id":"blk-58031","spans":[{"id":"spn-66746","marks":["bold"],"text":"Anomaly Engine"}]},{"id":"blk-58032","spans":[{"id":"spn-66747","text":"Adaptive SSM (Mamba-style) with selective state gating"}]},{"id":"blk-58033","spans":[{"id":"spn-66748","text":"GenServer per stream"}]}],[{"id":"blk-58034","spans":[{"id":"spn-66749","marks":["bold"],"text":"Forecast Engine"}]},{"id":"blk-58035","spans":[{"id":"spn-66750","text":"Multi-timescale CCO prediction, no forgetting"}]},{"id":"blk-58036","spans":[{"id":"spn-66751","text":"GenServer + Nx"}]}],[{"id":"blk-58037","spans":[{"id":"spn-66752","marks":["bold"],"text":"Pattern Engine"}]},{"id":"blk-58038","spans":[{"id":"spn-66753","text":"Spectral + autocorrelation cycle detection"}]},{"id":"blk-58039","spans":[{"id":"spn-66754","text":"Concurrent tasks"}]}],[{"id":"blk-58040","spans":[{"id":"spn-66755","marks":["bold"],"text":"Multi-Timescale Store"}]},{"id":"blk-58041","spans":[{"id":"spn-66756","text":"Fast (ETS) → Medium → Slow → Glacial memory"}]},{"id":"blk-58042","spans":[{"id":"spn-66757","text":"Tiered storage"}]}],[{"id":"blk-58043","spans":[{"id":"spn-66758","marks":["bold"],"text":"Stream Dashboard"}]},{"id":"blk-58044","spans":[{"id":"spn-66759","text":"Anomaly timeline, forecast explorer, pattern viewer"}]},{"id":"blk-58045","spans":[{"id":"spn-66760","text":"Phoenix LiveView"}]}]]},{"id":"blk-58046","kind":"heading","level":3,"spans":[{"id":"spn-66761","text":"Multi-Timescale Memory"}]},{"head":[{"id":"blk-58048","spans":[{"id":"spn-66762","text":"Tier"}]},{"id":"blk-58049","spans":[{"id":"spn-66763","text":"Latency"}]},{"id":"blk-58050","spans":[{"id":"spn-66764","text":"Storage"}]},{"id":"blk-58051","spans":[{"id":"spn-66765","text":"Contents"}]}],"id":"blk-58047","kind":"table","rows":[[{"id":"blk-58052","spans":[{"id":"spn-66766","marks":["bold"],"text":"Fast"}]},{"id":"blk-58053","spans":[{"id":"spn-66767","text":"seconds"}]},{"id":"blk-58054","spans":[{"id":"spn-66768","text":"ETS"}]},{"id":"blk-58055","spans":[{"id":"spn-66769","text":"Per-tick state snapshots"}]}],[{"id":"blk-58056","spans":[{"id":"spn-66770","marks":["bold"],"text":"Medium"}]},{"id":"blk-58057","spans":[{"id":"spn-66771","text":"hours"}]},{"id":"blk-58058","spans":[{"id":"spn-66772","text":"SQLite/TimescaleDB"}]},{"id":"blk-58059","spans":[{"id":"spn-66773","text":"Aggregated state vectors"}]}],[{"id":"blk-58060","spans":[{"id":"spn-66774","marks":["bold"],"text":"Slow"}]},{"id":"blk-58061","spans":[{"id":"spn-66775","text":"days"}]},{"id":"blk-58062","spans":[{"id":"spn-66776","text":"SQLite/TimescaleDB"}]},{"id":"blk-58063","spans":[{"id":"spn-66777","text":"Consolidated summaries"}]}],[{"id":"blk-58064","spans":[{"id":"spn-66778","marks":["bold"],"text":"Glacial"}]},{"id":"blk-58065","spans":[{"id":"spn-66779","text":"months"}]},{"id":"blk-58066","spans":[{"id":"spn-66780","text":"SQLite/TimescaleDB"}]},{"id":"blk-58067","spans":[{"id":"spn-66781","text":"Long-range seasonal models"}]}]]},{"id":"blk-58068","kind":"paragraph","spans":[{"id":"spn-66782","text":"---"}]},{"id":"blk-58069","kind":"heading","level":2,"spans":[{"id":"spn-66783","text":"Paired With"}]},{"head":[{"id":"blk-58071","spans":[{"id":"spn-66784","text":"Product"}]},{"id":"blk-58072","spans":[{"id":"spn-66785","text":"Relationship"}]}],"id":"blk-58070","kind":"table","rows":[[{"id":"blk-58073","spans":[{"id":"spn-66786","marks":["bold"],"text":"GeoFleetic"}]},{"id":"blk-58074","spans":[{"id":"spn-66787","text":"Spatial intelligence — when + where = complete situational awareness"}]}],[{"id":"blk-58075","spans":[{"id":"spn-66788","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-58076","spans":[{"id":"spn-66789","text":"Continual learning substrate for temporal knowledge"}]}],[{"id":"blk-58077","spans":[{"id":"spn-66790","marks":["bold"],"text":"Delegatic"}]},{"id":"blk-58078","spans":[{"id":"spn-66791","text":"Governance enforcement for temporal operations"}]}]]},{"id":"blk-58079","kind":"paragraph","spans":[{"id":"spn-66792","text":"---"}]},{"id":"blk-58080","kind":"heading","level":2,"spans":[{"id":"spn-66793","text":"Tech Stack"}]},{"head":[{"id":"blk-58082","spans":[{"id":"spn-66794","text":"Layer"}]},{"id":"blk-58083","spans":[{"id":"spn-66795","text":"Technology"}]}],"id":"blk-58081","kind":"table","rows":[[{"id":"blk-58084","spans":[{"id":"spn-66796","text":"Language"}]},{"id":"blk-58085","spans":[{"id":"spn-66797","text":"Elixir 1.17+"}]}],[{"id":"blk-58086","spans":[{"id":"spn-66798","text":"Framework"}]},{"id":"blk-58087","spans":[{"id":"spn-66799","text":"Phoenix 1.8+"}]}],[{"id":"blk-58088","spans":[{"id":"spn-66800","text":