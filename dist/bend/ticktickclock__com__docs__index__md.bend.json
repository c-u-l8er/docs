{"bendscript":"0.1","blocks":[{"id":"blk-85727","kind":"heading","level":1,"spans":[{"id":"spn-118917","text":"TickTickClock Documentation"}]},{"blocks":[{"id":"blk-85729","kind":"paragraph","spans":[{"id":"spn-118918","marks":["bold"],"text":"Every tick is a learning opportunity. Every pattern has a rhythm. Temporal intelligence that never forgets."}]}],"id":"blk-85728","kind":"quote"},{"blocks":[{"id":"blk-85731","kind":"paragraph","spans":[{"id":"spn-118919","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-118920","text":" · "},{"id":"spn-118921","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-118922","text":" · "},{"id":"spn-118923","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-118924","text":" · "},{"id":"spn-118925","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-85730","kind":"quote"},{"id":"blk-85732","kind":"paragraph","spans":[{"id":"spn-118926","text":"Welcome to the documentation hub for "},{"id":"spn-118927","marks":["bold"],"text":"TickTickClock"},{"id":"spn-118928","text":" — the temporal intelligence layer for the [&] Protocol ecosystem. TickTickClock provides time-series anomaly detection, forecasting, and pattern recognition as continual learning services."}]},{"id":"blk-85733","kind":"paragraph","spans":[{"id":"spn-118929","text":"TickTickClock is the "},{"id":"spn-118930","marks":["code"],"text":"&time"},{"id":"spn-118931","text":" primitive provider, exposing "},{"id":"spn-118932","marks":["code"],"text":"&time.anomaly"},{"id":"spn-118933","text":", "},{"id":"spn-118934","marks":["code"],"text":"&time.forecast"},{"id":"spn-118935","text":", and "},{"id":"spn-118936","marks":["code"],"text":"&time.pattern"},{"id":"spn-118937","text":" capability contracts. It does not store business data, host agents, or manage workflows — it ingests temporal signals, learns their structure continuously, and returns intelligence to upstream consumers."}]},{"id":"blk-85734","kind":"heading","level":2,"spans":[{"id":"spn-118938","text":"The Problem"}]},{"id":"blk-85735","kind":"paragraph","spans":[{"id":"spn-118939","text":"Time-series intelligence in production systems is fragmented. Anomaly detection runs as a batch job. Forecasting lives in a notebook. Pattern detection is a dashboard someone checks on Mondays. None of these systems learn continuously, and none of them talk to each other."}]},{"id":"blk-85736","kind":"paragraph","spans":[{"id":"spn-118940","text":"Meanwhile, underlying models suffer from catastrophic forgetting — retrained monthly on a window of recent data, discarding everything about long-range seasonality. Multi-timescale temporal behavior requires multi-timescale memory, and no production system provides it."}]},{"id":"blk-85737","kind":"paragraph","spans":[{"id":"spn-118941","text":"TickTickClock solves this with:"}]},{"id":"blk-85738","items":[{"blocks":[{"id":"blk-85740","kind":"paragraph","spans":[{"id":"spn-118942","marks":["bold"],"text":"Continual learning"},{"id":"spn-118943","text":" — models update at inference time, no batch retraining"}]}],"id":"blk-85739","kind":"list-item"},{"blocks":[{"id":"blk-85742","kind":"paragraph","spans":[{"id":"spn-118944","marks":["bold"],"text":"Multi-timescale memory"},{"id":"spn-118945","text":" — fast (seconds), medium (hours), slow (days), glacial (months)"}]}],"id":"blk-85741","kind":"list-item"},{"blocks":[{"id":"blk-85744","kind":"paragraph","spans":[{"id":"spn-118946","marks":["bold"],"text":"Streaming-first"},{"id":"spn-118947","text":" — designed for unbounded streams, not fixed datasets"}]}],"id":"blk-85743","kind":"list-item"},{"blocks":[{"id":"blk-85746","kind":"paragraph","spans":[{"id":"spn-118948","marks":["bold"],"text":"Edge-capable"},{"id":"spn-118949","text":" — SQLite + Bumblebee on constrained devices"}]}],"id":"blk-85745","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-85747","kind":"heading","level":2,"spans":[{"id":"spn-118950","text":"Documentation Map"}]},{"id":"blk-85748","kind":"paragraph","spans":[{"id":"spn-118951","marks":["bold"],"text":"Homepages"}]},{"id":"blk-85749","items":[{"blocks":[{"id":"blk-85751","kind":"paragraph","spans":[{"id":"spn-118952","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"[&] Ampersand Box"}]}],"id":"blk-85750","kind":"list-item"},{"blocks":[{"id":"blk-85753","kind":"paragraph","spans":[{"id":"spn-118953","marks":[{"kind":"link","predicate":"cites","target":"https://graphonomous.com"}],"text":"Graphonomous"}]}],"id":"blk-85752","kind":"list-item"},{"blocks":[{"id":"blk-85755","kind":"paragraph","spans":[{"id":"spn-118954","marks":[{"kind":"link","predicate":"cites","target":"https://bendscript.com"}],"text":"BendScript"}]}],"id":"blk-85754","kind":"list-item"},{"blocks":[{"id":"blk-85757","kind":"paragraph","spans":[{"id":"spn-118955","marks":[{"kind":"link","predicate":"cites","target":"https://webhost.systems"}],"text":"WebHost.Systems"}]}],"id":"blk-85756","kind":"list-item"},{"blocks":[{"id":"blk-85759","kind":"paragraph","spans":[{"id":"spn-118956","marks":[{"kind":"link","predicate":"cites","target":"https://agentelic.com"}],"text":"Agentelic"}]}],"id":"blk-85758","kind":"list-item"},{"blocks":[{"id":"blk-85761","kind":"paragraph","spans":[{"id":"spn-118957","marks":[{"kind":"link","predicate":"cites","target":"https://agentromatic.com"}],"text":"AgenTroMatic"}]}],"id":"blk-85760","kind":"list-item"},{"blocks":[{"id":"blk-85763","kind":"paragraph","spans":[{"id":"spn-118958","marks":[{"kind":"link","predicate":"cites","target":"https://delegatic.com"}],"text":"Delegatic"}]}],"id":"blk-85762","kind":"list-item"},{"blocks":[{"id":"blk-85765","kind":"paragraph","spans":[{"id":"spn-118959","marks":[{"kind":"link","predicate":"cites","target":"https://deliberatic.com"}],"text":"Deliberatic"}]}],"id":"blk-85764","kind":"list-item"},{"blocks":[{"id":"blk-85767","kind":"paragraph","spans":[{"id":"spn-118960","marks":[{"kind":"link","predicate":"cites","target":"https://fleetprompt.com"}],"text":"FleetPrompt"}]}],"id":"blk-85766","kind":"list-item"},{"blocks":[{"id":"blk-85769","kind":"paragraph","spans":[{"id":"spn-118961","marks":[{"kind":"link","predicate":"cites","target":"https://geofleetic.com"}],"text":"GeoFleetic"}]}],"id":"blk-85768","kind":"list-item"},{"blocks":[{"id":"blk-85771","kind":"paragraph","spans":[{"id":"spn-118962","marks":[{"kind":"link","predicate":"cites","target":"https://opensentience.org"}],"text":"OpenSentience"}]}],"id":"blk-85770","kind":"list-item"},{"blocks":[{"id":"blk-85773","kind":"paragraph","spans":[{"id":"spn-118963","marks":[{"kind":"link","predicate":"cites","target":"https://specprompt.com"}],"text":"SpecPrompt"}]}],"id":"blk-85772","kind":"list-item"},{"blocks":[{"id":"blk-85775","kind":"paragraph","spans":[{"id":"spn-118964","marks":[{"kind":"link","predicate":"cites","target":"https://ticktickclock.com"}],"text":"TickTickClock"}]}],"id":"blk-85774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-85776","kind":"paragraph","spans":[{"id":"spn-118965","marks":["bold"],"text":"Root Docs"}]},{"id":"blk-85777","items":[{"blocks":[{"id":"blk-85779","kind":"paragraph","spans":[{"id":"spn-118966","marks":[{"kind":"link","predicate":"cites","target":"https://docs.ampersandboxdesign.com"}],"text":"[&] Protocol Docs"}]}],"id":"blk-85778","kind":"list-item"},{"blocks":[{"id":"blk-85781","kind":"paragraph","spans":[{"id":"spn-118967","marks":[{"kind":"link","predicate":"cites","target":"https://docs.graphonomous.com"}],"text":"Graphonomous Docs"}]}],"id":"blk-85780","kind":"list-item"},{"blocks":[{"id":"blk-85783","kind":"paragraph","spans":[{"id":"spn-118968","marks":[{"kind":"link","predicate":"cites","target":"https://docs.bendscript.com"}],"text":"BendScript Docs"}]}],"id":"blk-