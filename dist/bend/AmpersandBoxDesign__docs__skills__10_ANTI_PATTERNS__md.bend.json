{"bendscript":"0.1","blocks":[{"id":"blk-17239","kind":"heading","level":1,"spans":[{"id":"spn-15412","text":"Skill 10 — Anti-Patterns"}]},{"blocks":[{"id":"blk-17241","kind":"paragraph","spans":[{"id":"spn-15413","text":"Common mistakes when writing [&] Protocol declarations and how to avoid them. Every anti-pattern here comes from real failure modes: broken compositions, unenforceable governance, unportable agents, and silent pipeline failures."}]}],"id":"blk-17240","kind":"quote"},{"id":"blk-17242","kind":"heading","level":2,"spans":[{"id":"spn-15414","text":"Overview"}]},{"id":"blk-17243","kind":"paragraph","spans":[{"id":"spn-15415","text":"Each anti-pattern follows this structure:"}]},{"id":"blk-17244","items":[{"blocks":[{"id":"blk-17246","kind":"paragraph","spans":[{"id":"spn-15416","marks":["bold"],"text":"The mistake"},{"id":"spn-15417","text":" — what it looks like"}]}],"id":"blk-17245","kind":"list-item"},{"blocks":[{"id":"blk-17248","kind":"paragraph","spans":[{"id":"spn-15418","marks":["bold"],"text":"Why it's harmful"},{"id":"spn-15419","text":" — the concrete damage"}]}],"id":"blk-17247","kind":"list-item"},{"blocks":[{"id":"blk-17250","kind":"paragraph","spans":[{"id":"spn-15420","marks":["bold"],"text":"The fix"},{"id":"spn-15421","text":" — what to do instead"}]}],"id":"blk-17249","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-17251","kind":"heading","level":2,"spans":[{"id":"spn-15422","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-17253","spans":[{"id":"spn-15423","text":"#"}]},{"id":"blk-17254","spans":[{"id":"spn-15424","text":"Name"}]},{"id":"blk-17255","spans":[{"id":"spn-15425","text":"Severity"}]}],"id":"blk-17252","kind":"table","rows":[[{"id":"blk-17256","spans":[{"id":"spn-15426","text":"1"}]},{"id":"blk-17257","spans":[{"id":"spn-15427","marks":[{"kind":"link","predicate":"cites","target":"#1--capabilities-without-providers"}],"text":"Capabilities Without Providers"}]},{"id":"blk-17258","spans":[{"id":"spn-15428","text":"Critical"}]}],[{"id":"blk-17259","spans":[{"id":"spn-15429","text":"2"}]},{"id":"blk-17260","spans":[{"id":"spn-15430","marks":[{"kind":"link","predicate":"cites","target":"#2--ignoring-composition-type-checks"}],"text":"Ignoring Composition Type Checks"}]},{"id":"blk-17261","spans":[{"id":"spn-15431","text":"Critical"}]}],[{"id":"blk-17262","spans":[{"id":"spn-15432","text":"3"}]},{"id":"blk-17263","spans":[{"id":"spn-15433","marks":[{"kind":"link","predicate":"cites","target":"#3--kitchen-sink-declarations"}],"text":"Kitchen-Sink Declarations"}]},{"id":"blk-17264","spans":[{"id":"spn-15434","text":"High"}]}],[{"id":"blk-17265","spans":[{"id":"spn-15435","text":"4"}]},{"id":"blk-17266","spans":[{"id":"spn-15436","marks":[{"kind":"link","predicate":"cites","target":"#4--missing-provenance-on-critical-capabilities"}],"text":"Missing Provenance on Critical Capabilities"}]},{"id":"blk-17267","spans":[{"id":"spn-15437","text":"High"}]}],[{"id":"blk-17268","spans":[{"id":"spn-15438","text":"5"}]},{"id":"blk-17269","spans":[{"id":"spn-15439","marks":[{"kind":"link","predicate":"cites","target":"#5--governance-gaps"}],"text":"Governance Gaps"}]},{"id":"blk-17270","spans":[{"id":"spn-15440","text":"High"}]}],[{"id":"blk-17271","spans":[{"id":"spn-15441","text":"6"}]},{"id":"blk-17272","spans":[{"id":"spn-15442","marks":[{"kind":"link","predicate":"cites","target":"#6--over-specifying-providers"}],"text":"Over-Specifying Providers"}]},{"id":"blk-17273","spans":[{"id":"spn-15443","text":"Medium"}]}],[{"id":"blk-17274","spans":[{"id":"spn-15444","text":"7"}]},{"id":"blk-17275","spans":[{"id":"spn-15445","marks":[{"kind":"link","predicate":"cites","target":"#7--ignoring-contract-versioning"}],"text":"Ignoring Contract Versioning"}]},{"id":"blk-17276","spans":[{"id":"spn-15446","text":"Medium"}]}],[{"id":"blk-17277","spans":[{"id":"spn-15447","text":"8"}]},{"id":"blk-17278","spans":[{"id":"spn-15448","marks":[{"kind":"link","predicate":"cites","target":"#8--pipeline-without-validation"}],"text":"Pipeline Without Validation"}]},{"id":"blk-17279","spans":[{"id":"spn-15449","text":"Medium"}]}],[{"id":"blk-17280","spans":[{"id":"spn-15450","text":"9"}]},{"id":"blk-17281","spans":[{"id":"spn-15451","marks":[{"kind":"link","predicate":"cites","target":"#9--bare-primitive-references"}],"text":"Bare Primitive References"}]},{"id":"blk-17282","spans":[{"id":"spn-15452","text":"Low"}]}],[{"id":"blk-17283","spans":[{"id":"spn-15453","text":"10"}]},{"id":"blk-17284","spans":[{"id":"spn-15454","marks":[{"kind":"link","predicate":"cites","target":"#10--copy-paste-governance"}],"text":"Copy-Paste Governance"}]},{"id":"blk-17285","spans":[{"id":"spn-15455","text":"Low"}]}]]},{"id":"blk-17286","kind":"heading","level":2,"spans":[{"id":"spn-15456","text":"Critical Anti-Patterns"}]},{"id":"blk-17287","kind":"heading","level":3,"spans":[{"id":"spn-15457","text":"1 — Capabilities Without Providers"}]},{"id":"blk-17288","kind":"paragraph","spans":[{"id":"spn-15458","marks":["bold"],"text":"The mistake:"},{"id":"spn-15459","text":" Declaring capabilities but omitting or leaving blank the provider field."}]},{"id":"blk-17289","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\": { \"config\": { \"instance\": \"ops\" } },\n  \"&time.anomaly\": { \"provider\": \"\", \"config\": {} }\n}"},{"id":"blk-17290","kind":"paragraph","spans":[{"id":"spn-15460","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17291","items":[{"blocks":[{"id":"blk-17293","kind":"paragraph","spans":[{"id":"spn-15461","text":"The runtime cannot bind the capability to any service"}]}],"id":"blk-17292","kind":"list-item"},{"blocks":[{"id":"blk-17295","kind":"paragraph","spans":[{"id":"spn-15462","text":"Generation produces empty MCP server entries"}]}],"id":"blk-17294","kind":"list-item"},{"blocks":[{"id":"blk-17297","kind":"paragraph","spans":[{"id":"spn-15463","text":"The agent appears to have capabilities it cannot actually use"}]}],"id":"blk-17296","kind":"list-item"},{"blocks":[{"id":"blk-17299","kind":"paragraph","spans":[{"id":"spn-15464","text":"Composition passes but generation fails silently or produces broken output"}]}],"id":"blk-17298","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17300","kind":"paragraph","spans":[{"id":"spn-15465","marks":["bold"],"text":"The fix:"},{"id":"spn-15466","text":" Always specify a provider. Use "},{"id":"spn-15467","marks":["code"],"text":"\"auto\""},{"id":"spn-15468","text":" if you want the runtime to resolve it from the registry:"}]},{"id":"blk-17301","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"ops\" } }\n\"&time.anomaly\": { \"provider\": \"auto\", \"config\": {} }"},{"id":"blk-17302","kind":"heading","level":3,"spans":[{"id":"spn-15469","text":"2 — Ignoring Composition Type Checks"}]},{"id":"blk-17303","kind":"paragraph","spans":[{"id":"spn-15470","marks":["bold"],"text":"The mistake:"},{"id":"spn-15471","text":" Building pipelines without verifying that step N's output type matches step N+1's "},{"id":"spn-15472","marks":["code"],"text":"accepts_from"},{"id":"spn-15473","text":" list."}]},{"id":"blk-17304","kind":"code","language":"json","text":"\"steps\": [\n  { \"capability\": \"&time.forecast\", \"operation\": \"predict\" },\n  { \"capability\": \"&memory.graph\", \"operation\": \"enrich\" }\n]"},{"id":"blk-17305","kind":"paragraph","spans":[{"id":"spn-15474","text":"If "},{"id":"spn-15475","marks":["code"],"text":"&time.forecast.predict()"},{"id":"spn-15476","text":" outputs "},{"id":"spn-15477","marks":["code"],"text":"forecast_set"},{"id":"spn-15478","text":" but "},{"id":"spn-15479","marks":["code"],"text":"&memory.graph.enrich()"},{"id":"spn-15480","text":" does not accept "},{"id":"spn-15481","marks":["code"],"text":"forecast_set"},{"id":"spn-15482","text":", the pipeline breaks at runtime."}]},{"id":"blk-17306","kind":"paragraph","spans":[{"id":"spn-15483","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17307","items":[{"blocks":[{"id":"blk-17309","kind":"paragraph","spans":[{"id":"spn-15484","text":"Runtime errors instead of compile-time errors"}]}],"id":"blk-17308","kind":"list-item"},{"blocks":[{"id":"blk-17311","kind":"paragraph","spans":[{"id":"spn-15485","text":"Silent data loss or unexpected behavior"}]}],"id":"blk-17310","kind":"list-item"},{"blocks":[{"id":"blk-17313","kind":"paragraph","spans":[{"id":"spn-15486","text":"Difficult to debug in production"}]}],"id":"blk-17312","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17314","kind":"paragraph","spans":[{"id":"spn-15487","marks":["bold"],"text":"The fix:"},{"id":"spn-15488","text":" Run "},{"id":"spn-15489","marks":["code"],"text":"ampersand compose"},{"id":"spn-15490","text":" before "},{"id":"spn-15491","marks":["code"],"text":"ampersand generate"},{"id":"spn-15492","text":". Always check the type flow:"}]},{"id":"blk-17315","kind":"code","language":"bash","text":"ampersand compose agent.ampersand.json --verbose"},{"id":"blk-17316","kind":"paragraph","spans":[{"id":"spn-15493","text":"The verbose output shows the type at each pipeline step, making mismatches immediately visible."}]},{"id":"blk-17317","kind":"heading","level":2,"spans":[{"id":"spn-15494","text":"High-Severity Anti-Patterns"}]},{"id":"blk-17318","kind":"heading","level":3,"spans":[{"id":"spn-15495","text":"3 — Kitchen-Sink Declarations"}]},{"id":"blk-17319","kind":"paragraph","spans":[{"id":"spn-15496","marks":["bold"],"text":"The mistake:"},{"id":"spn-15497","text":" Declaring every available capability even when the agent does not need most of them."}]},{"id":"blk-17320","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\": { ... },\n  \"&memory.vector\": { ... },\n  \"&memory.episodic\": { ... },\n  \"&memory.semantic\": { ... },\n  \"&time.anomaly\": { ... },\n  \"&time.forecast\": { ... },\n  \"&time.pattern\": { ... },\n  \"&time.baseline\": { ... },\n  \"&space.fleet\": { ... },\n  \"&space.geofence\": { ... },\n  \"&reason.argument\": { ... },\n  \"&reason.vote\": { ... },\n  \"&reason.plan\": { ... },\n  \"&reason.deliberate\": { ... },\n  \"&reason.attend\": { ... }\n}"},{"id":"blk-17321","kind":"paragraph","spans":[{"id":"spn-15498","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17322","items":[{"blocks":[{"id":"blk-17324","kind":"paragraph","spans":[{"id":"spn-15499","text":"Generated MCP config starts 8+ servers, most unused"}]}],"id":"blk-17323","kind":"list-item"},{"blocks":[{"id":"blk-17326","kind":"paragraph","spans":[{"id":"spn-15500","text":"A2A agent card advertises skills the agent cannot meaningfully perform"}]}],"id":"blk-17325","kind":"list-item"},{"blocks":[{"id":"blk-17328","kind":"paragraph","spans":[{"id":"spn-15501","text":"More providers means more failure points"}]}],"id":"blk-17327","kind":"list-item"},{"blocks":[{"id":"blk-17330","kind":"paragraph","spans":[{"id":"spn-15502","text":"Harder to reason about what the agent actually does"}]}],"id":"blk-17329","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17331","kind":"paragraph","spans":[{"id":"spn-15503","marks":["bold"],"text":"The fix:"},{"id":"spn-15504","text":" Start with the minimum set of capabilities your use case requires. Add more only when a concrete need emerges:"}]},{"id":"blk-17332","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\":    { \"provider\": \"graphonomous\", \"config\": {} },\n  \"&time.anomaly\":    { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&reason.argument\": { \"provider\": \"deliberatic\", \"config\": {} }\n}"},{"id":"blk-17333","kind":"paragraph","spans":[{"id":"spn-15505","text":"Three capabilities that work together is better than fifteen that sit idle."}]},{"id":"blk-17334","kind":"heading","level":3,"spans":[{"id":"spn-15506","text":"4 — Missing Provenance on Critical Capabilities"}]},{"id":"blk-17335","kind":"paragraph","spans":[{"id":"spn-15507","marks":["bold"],"text":"The mistake:"},{"id":"spn-15508","text":" Omitting "},{"id":"spn-15509","marks":["code"],"text":"\"provenance\": true"},{"id":"spn-15510","text":" on agents that make consequential decisions."}]},{"id":"blk-17336","kind":"paragraph","spans":[{"id":"spn-15511","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17337","items":[{"blocks":[{"id":"blk-17339","kind":"paragraph","spans":[{"id":"spn-15512","text":"No audit trail for decisions"}]}],"id":"blk-17338","kind":"list-item"},{"blocks":[{"id":"blk-17341","kind":"paragraph","spans":[{"id":"spn-15513","text":"Cannot trace which capability contributed to an outcome"}]}],"id":"blk-17340","kind":"list-item"},{"blocks":[{"id":"blk-17343","kind":"paragraph","spans":[{"id":"spn-15514","text":"Compliance requirements cannot be verified"}]}],"id":"blk-17342","kind":"list-item"},{"blocks":[{"id":"blk-17345","kind":"paragraph","spans":[{"id":"spn-15515","text":"Debugging production issues requires reproducing the full pipeline"}]}],"id":"blk-17344","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17346","kind":"paragraph","spans":[{"id":"spn-15516","marks":["bold"],"text":"The fix:"},{"id":"spn-15517","text":" Enable provenance on any agent that makes decisions affecting users, infrastructure, or finances:"}]},{"id":"blk-17347","kind":"code","language":"json","text":"\"provenance\": true"},{"id":"blk-17348","kind":"paragraph","spans":[{"id":"spn-15518","text":"The overhead is minimal — a hash computation per operation. The value is significant — a complete, verifiable decision trail."}]},{"id":"blk-17349","kind":"heading","level":3,"spans":[{"id":"spn-15519","text":"5 — Governance Gaps"}]},{"id":"blk-17350","kind":"paragraph","spans":[{"id":"spn-15520","marks":["bold"],"text":"The mistake:"},{"id":"spn-15521","text":" Declaring autonomous agents without escalation rules or hard constraints."}]},{"id":"blk-17351","kind":"code","language":"json","text":"\"governance\": {\n  \"autonomy\": { \"level\": \"act\" }\n}"},{"id":"blk-17352","kind":"paragraph","spans":[{"id":"spn-15522","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17353","items":[{"blocks":[{"id":"blk-17355","kind":"paragraph","spans":[{"id":"spn-15523","text":"The agent has full autonomy with no guardrails"}]}],"id":"blk-17354","kind":"list-item"},{"blocks":[{"id":"blk-17357","kind":"paragraph","spans":[{"id":"spn-15524","text":"No mechanism to stop it from taking harmful actions"}]}],"id":"blk-17356","kind":"list-item"},{"blocks":[{"id":"blk-17359","kind":"paragraph","spans":[{"id":"spn-15525","text":"No escalation path when confidence is low"}]}],"id":"blk-17358","kind":"list-item"},{"blocks":[{"id":"blk-17361","kind":"paragraph","spans":[{"id":"spn-15526","text":"Violates the principle that autonomy requires governance"}]}],"id":"blk-17360","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17362","kind":"paragraph","spans":[{"id":"spn-15527","marks":["bold"],"text":"The fix:"},{"id":"spn-15528","text":" Every "},{"id":"spn-15529","marks":["code"],"text":"act"},{"id":"spn-15530","text":"-level agent needs hard constraints and escalation:"}]},{"id":"blk-17363","kind":"code","language":"json","text":"\"governance\": {\n  \"hard\": [\"Never exceed budget allocation\"],\n  \"escalate_when\": { \"confidence_below\": 0.6 },\n  \"autonomy\": {\n    \"level\": \"act\",\n    \"budget\": { \"max_actions_per_hour\": 10 }\n  }\n}"},{"id":"blk-17364","kind":"paragraph","spans":[{"id":"spn-15531","text":"The higher the autonomy, the more governance is required."}]},{"id":"blk-17365","kind":"heading","level":2,"spans":[{"id":"spn-15532","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-17366","kind":"heading","level":3,"spans":[{"id":"spn-15533","text":"6 — Over-Specifying Providers"}]},{"id":"blk-17367","kind":"paragraph","spans":[{"id":"spn-15534","marks":["bold"],"text":"The mistake:"},{"id":"spn-15535","text":" Hardcoding specific provider names when the agent could work with any conforming provider."}]},{"id":"blk-17368","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": {} }"},{"id":"blk-17369","kind":"paragraph","spans":[{"id":"spn-15536","marks":["bold"],"text":"Why it's harmful (when portability matters):"}]},{"id":"blk-17370","items":[{"blocks":[{"id":"blk-17372","kind":"paragraph","spans":[{"id":"spn-15537","text":"Locks the agent to a specific provider"}]}],"id":"blk-17371","kind":"list-item"},{"blocks":[{"id":"blk-17374","kind":"paragraph","spans":[{"id":"spn-15538","text":"Cannot swap to an alternative without modifying the declaration"}]}],"id":"blk-17373","kind":"list-item"},{"blocks":[{"id":"blk-17376","kind":"paragraph","spans":[{"id":"spn-15539","text":"Reduces adoption — users without access to that provider cannot use the agent"}]}],"id":"blk-17375","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17377","kind":"paragraph","spans":[{"id":"spn-15540","marks":["bold"],"text":"The fix:"},{"id":"spn-15541","text":" Use "},{"id":"spn-15542","marks":["code"],"text":"\"auto\""},{"id":"spn-15543","text":" for capabilities where the specific provider does not matter, and explicit providers only when provider-specific features are required:"}]},{"id":"blk-17378","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"auto\", \"config\": { \"index\": \"docs\" } }"},{"id":"blk-17379","kind":"paragraph","spans":[{"id":"spn-15544","text":"Note: This is only an anti-pattern when portability is a goal. For internal agents with known infrastructure, explicit providers are fine."}]},{"id":"blk-17380","kind":"heading","level":3,"spans":[{"id":"spn-15545","text":"7 — Ignoring Contract Versioning"}]},{"id":"blk-17381","kind":"paragraph","spans":[{"id":"spn-15546","marks":["bold"],"text":"The mistake:"},{"id":"spn-15547","text":" Never specifying which contract version a declaration was built against."}]},{"id":"blk-17382","kind":"paragraph","spans":[{"id":"spn-15548","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17383","items":[{"blocks":[{"id":"blk-17385","kind":"paragraph","spans":[{"id":"spn-15549","text":"A provider updates its contract, breaking your pipeline"}]}],"id":"blk-17384","kind":"list-item"},{"blocks":[{"id":"blk-17387","kind":"paragraph","spans":[{"id":"spn-15550","text":"No way to pin to a known-working version"}]}],"id":"blk-17386","kind":"list-item"},{"blocks":[{"id":"blk-17389","kind":"paragraph","spans":[{"id":"spn-15551","text":"Composition may pass today and fail tomorrow"}]}],"id":"blk-17388","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17390","kind":"paragraph","spans":[{"id":"spn-15552","marks":["bold"],"text":"The fix:"},{"id":"spn-15553","text":" Pin your declarations to specific contract versions and test against them in CI:"}]},{"id":"blk-17391","kind":"code","language":"bash","text":"ampersand validate agent.ampersand.json --schema protocol/schema/v0.1.0/"},{"id":"blk-17392","kind":"paragraph","spans":[{"id":"spn-15554","text":"When upgrading, review the contract changelog for breaking changes."}]},{"id":"blk-17393","kind":"heading","level":3,"spans":[{"id":"spn-15555","text":"8 — Pipeline Without Validation"}]},{"id":"blk-17394","kind":"paragraph","spans":[{"id":"spn-15556","marks":["bold"],"text":"The mistake:"},{"id":"spn-15557","text":" Defining pipelines in the declaration but only running "},{"id":"spn-15558","marks":["code"],"text":"validate"},{"id":"spn-15559","text":" (schema check) and never "},{"id":"spn-15560","marks":["code"],"text":"compose"},{"id":"spn-15561","text":" (type check)."}]},{"id":"blk-17395","kind":"paragraph","spans":[{"id":"spn-15562","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17396","items":[{"blocks":[{"id":"blk-17398","kind":"paragraph","spans":[{"id":"spn-15563","marks":["code"],"text":"validate"},{"id":"spn-15564","text":" checks structure, not semantics"}]}],"id":"blk-17397","kind":"list-item"},{"blocks":[{"id":"blk-17400","kind":"paragraph","spans":[{"id":"spn-15565","text":"A structurally valid pipeline can have type mismatches"}]}],"id":"blk-17399","kind":"list-item"},{"blocks":[{"id":"blk-17402","kind":"paragraph","spans":[{"id":"spn-15566","text":"Errors surface at generation or runtime instead of composition time"}]}],"id":"blk-17401","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17403","kind":"paragraph","spans":[{"id":"spn-15567","marks":["bold"],"text":"The fix:"},{"id":"spn-15568","text":" Always run "},{"id":"spn-15569","marks":["code"],"text":"compose"},{"id":"spn-15570","text":" after "},{"id":"spn-15571","marks":["code"],"text":"validate"},{"id":"spn-15572","text":":"}]},{"id":"blk-17404","kind":"code","language":"bash","text":"ampersand validate agent.ampersand.json && ampersand compose agent.ampersand.json"},{"id":"blk-17405","kind":"paragraph","spans":[{"id":"spn-15573","text":"Or just run "},{"id":"spn-15574","marks":["code"],"text":"generate"},{"id":"spn-15575","text":", which includes both checks."}]},{"id":"blk-17406","kind":"heading","level":2,"spans":[{"id":"spn-15576","text":"Low-Severity Anti-Patterns"}]},{"id":"blk-17407","kind":"heading","level":3,"spans":[{"id":"spn-15577","text":"9 — Bare Primitive References"}]},{"id":"blk-17408","kind":"paragraph","spans":[{"id":"spn-15578","marks":["bold"],"text":"The mistake:"},{"id":"spn-15579","text":" Using "},{"id":"spn-15580","marks":["code"],"text":"&memory"},{"id":"spn-15581","text":" instead of "},{"id":"spn-15582","marks":["code"],"text":"&memory.graph"},{"id":"spn-15583","text":" in discussions, documentation, or (attempted) declarations."}]},{"id":"blk-17409","kind":"paragraph","spans":[{"id":"spn-15584","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17410","items":[{"blocks":[{"id":"blk-17412","kind":"paragraph","spans":[{"id":"spn-15585","text":"Declarations require subtypes — "},{"id":"spn-15586","marks":["code"],"text":"&memory"},{"id":"spn-15587","text":" alone is not valid"}]}],"id":"blk-17411","kind":"list-item"},{"blocks":[{"id":"blk-17414","kind":"paragraph","spans":[{"id":"spn-15588","text":"Creates ambiguity about which specific capability is meant"}]}],"id":"blk-17413","kind":"list-item"},{"blocks":[{"id":"blk-17416","kind":"paragraph","spans":[{"id":"spn-15589","text":"New users may think bare primitives work and get confused by errors"}]}],"id":"blk-17415","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17417","kind":"paragraph","spans":[{"id":"spn-15590","marks":["bold"],"text":"The fix:"},{"id":"spn-15591","text":" Always use the full "},{"id":"spn-15592","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-15593","text":" form:"}]},{"id":"blk-17418","kind":"code","language":"text","text":"&memory.graph    (not &memory)\n&reason.argument (not &reason)\n&time.anomaly    (not &time)\n&space.fleet     (not &space)"},{"id":"blk-17419","kind":"heading","level":3,"spans":[{"id":"spn-15594","text":"10 — Copy-Paste Governance"}]},{"id":"blk-17420","kind":"paragraph","spans":[{"id":"spn-15595","marks":["bold"],"text":"The mistake:"},{"id":"spn-15596","text":" Copying governance blocks from examples without adapting them to the agent's actual requirements."}]},{"id":"blk-17421","kind":"paragraph","spans":[{"id":"spn-15597","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17422","items":[{"blocks":[{"id":"blk-17424","kind":"paragraph","spans":[{"id":"spn-15598","text":"Constraints may be too loose or too strict for the use case"}]}],"id":"blk-17423","kind":"list-item"},{"blocks":[{"id":"blk-17426","kind":"paragraph","spans":[{"id":"spn-15599","text":"Escalation thresholds may not match operational reality"}]}],"id":"blk-17425","kind":"list-item"},{"blocks":[{"id":"blk-17428","kind":"paragraph","spans":[{"id":"spn-15600","text":"Budget limits may be inappropriate"}]}],"id":"blk-17427","kind":"list-item"},{"blocks":[{"id":"blk-17430","kind":"paragraph","spans":[{"id":"spn-15601","text":"Creates a false sense of security"}]}],"id":"blk-17429","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17431","kind":"paragraph","spans":[{"id":"spn-15602","marks":["bold"],"text":"The fix:"},{"id":"spn-15603","text":" Write governance constraints specific to your agent's domain, risk profile, and operational context. Use examples as templates, not as final answers."}]},{"id":"blk-17432","kind":"heading","level":2,"spans":[{"id":"spn-15604","text":"Self-Audit Checklist"}]},{"id":"blk-17433","kind":"paragraph","spans":[{"id":"spn-15605","text":"Run through this before deploying an agent declaration:"}]},{"id":"blk-17434","kind":"heading","level":3,"spans":[{"id":"spn-15606","text":"Declaration"}]},{"id":"blk-17435","items":[{"blocks":[{"id":"blk-17437","kind":"paragraph","spans":[{"id":"spn-15607","text":"[ ] Every capability has an explicit provider (or "},{"id":"spn-15608","marks":["code"],"text":"\"auto\""},{"id":"spn-15609","text":")"}]}],"id":"blk-17436","kind":"list-item"},{"blocks":[{"id":"blk-17439","kind":"paragraph","spans":[{"id":"spn-15610","text":"[ ] Agent name and version are set"}]}],"id":"blk-17438","kind":"list-item"},{"blocks":[{"id":"blk-17441","kind":"paragraph","spans":[{"id":"spn-15611","text":"[ ] Only needed capabilities are declared"}]}],"id":"blk-17440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17442","kind":"heading","level":3,"spans":[{"id":"spn-15612","text":"Composition"}]},{"id":"blk-17443","items":[{"blocks":[{"id":"blk-17445","kind":"paragraph","spans":[{"id":"spn-15613","text":"[ ] "},{"id":"spn-15614","marks":["code"],"text":"ampersand compose"},{"id":"spn-15615","text":" passes with no errors"}]}],"id":"blk-17444","kind":"list-item"},{"blocks":[{"id":"blk-17447","kind":"paragraph","spans":[{"id":"spn-15616","text":"[ ] Pipeline type flow is verified (use "},{"id":"spn-15617","marks":["code"],"text":"--verbose"},{"id":"spn-15618","text":")"}]}],"id":"blk-17446","kind":"list-item"},{"blocks":[{"id":"blk-17449","kind":"paragraph","spans":[{"id":"spn-15619","text":"[ ] No circular pipeline dependencies"}]}],"id":"blk-17448","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17450","kind":"heading","level":3,"spans":[{"id":"spn-15620","text":"Governance"}]},{"id":"blk-17451","items":[{"blocks":[{"id":"blk-17453","kind":"paragraph","spans":[{"id":"spn-15621","text":"[ ] Hard constraints cover critical boundaries"}]}],"id":"blk-17452","kind":"list-item"},{"blocks":[{"id":"blk-17455","kind":"paragraph","spans":[{"id":"spn-15622","text":"[ ] Escalation triggers are set for autonomous agents"}]}],"id":"blk-17454","kind":"list-item"},{"blocks":[{"id":"blk-17457","kind":"paragraph","spans":[{"id":"spn-15623","text":"[ ] Autonomy level matches operational trust level"}]}],"id":"blk-17456","kind":"list-item"},{"blocks":[{"id":"blk-17459","kind":"paragraph","spans":[{"id":"spn-15624","text":"[ ] Budget limits are appropriate"}]}],"id":"blk-17458","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17460","kind":"heading","level":3,"spans":[{"id":"spn-15625","text":"Provenance"}]},{"id":"blk-17461","items":[{"blocks":[{"id":"blk-17463","kind":"paragraph","spans":[{"id":"spn-15626","text":"[ ] "},{"id":"spn-15627","marks":["code"],"text":"provenance: true"},{"id":"spn-15628","text":" for agents making consequential decisions"}]}],"id":"blk-17462","kind":"list-item"},{"blocks":[{"id":"blk-17465","kind":"paragraph","spans":[{"id":"spn-15629","text":"[ ] Audit trail requirements are met"}]}],"id":"blk-17464","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17466","kind":"heading","level":3,"spans":[{"id":"spn-15630","text":"Portability"}]},{"id":"blk-17467","items":[{"blocks":[{"id":"blk-17469","kind":"paragraph","spans":[{"id":"spn-15631","text":"[ ] Providers are explicit only when provider-specific features are needed"}]}],"id":"blk-17468","kind":"list-item"},{"blocks":[{"id":"blk-17471","kind":"paragraph","spans":[{"id":"spn-15632","text":"[ ] Contract versions are pinned for production agents"}]}],"id":"blk-17470","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraxm2ci4pkcjx3blgm3u3zxhrinh7adtslkkql7ruogjxbhjzmb6iq","vocabulary":"ampersand.docs.fs.v1"}