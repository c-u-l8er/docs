{"bendscript":"0.1","blocks":[{"id":"blk-17237","kind":"heading","level":1,"spans":[{"id":"spn-15612","text":"Skill 10 — Anti-Patterns"}]},{"blocks":[{"id":"blk-17239","kind":"paragraph","spans":[{"id":"spn-15613","text":"Common mistakes when writing [&] Protocol declarations and how to avoid them. Every anti-pattern here comes from real failure modes: broken compositions, unenforceable governance, unportable agents, and silent pipeline failures."}]}],"id":"blk-17238","kind":"quote"},{"id":"blk-17240","kind":"heading","level":2,"spans":[{"id":"spn-15614","text":"Overview"}]},{"id":"blk-17241","kind":"paragraph","spans":[{"id":"spn-15615","text":"Each anti-pattern follows this structure:"}]},{"id":"blk-17242","items":[{"blocks":[{"id":"blk-17244","kind":"paragraph","spans":[{"id":"spn-15616","marks":["bold"],"text":"The mistake"},{"id":"spn-15617","text":" — what it looks like"}]}],"id":"blk-17243","kind":"list-item"},{"blocks":[{"id":"blk-17246","kind":"paragraph","spans":[{"id":"spn-15618","marks":["bold"],"text":"Why it's harmful"},{"id":"spn-15619","text":" — the concrete damage"}]}],"id":"blk-17245","kind":"list-item"},{"blocks":[{"id":"blk-17248","kind":"paragraph","spans":[{"id":"spn-15620","marks":["bold"],"text":"The fix"},{"id":"spn-15621","text":" — what to do instead"}]}],"id":"blk-17247","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-17249","kind":"heading","level":2,"spans":[{"id":"spn-15622","text":"Table of Anti-Patterns"}]},{"head":[{"id":"blk-17251","spans":[{"id":"spn-15623","text":"#"}]},{"id":"blk-17252","spans":[{"id":"spn-15624","text":"Name"}]},{"id":"blk-17253","spans":[{"id":"spn-15625","text":"Severity"}]}],"id":"blk-17250","kind":"table","rows":[[{"id":"blk-17254","spans":[{"id":"spn-15626","text":"1"}]},{"id":"blk-17255","spans":[{"id":"spn-15627","marks":[{"kind":"link","predicate":"cites","target":"#1--capabilities-without-providers"}],"text":"Capabilities Without Providers"}]},{"id":"blk-17256","spans":[{"id":"spn-15628","text":"Critical"}]}],[{"id":"blk-17257","spans":[{"id":"spn-15629","text":"2"}]},{"id":"blk-17258","spans":[{"id":"spn-15630","marks":[{"kind":"link","predicate":"cites","target":"#2--ignoring-composition-type-checks"}],"text":"Ignoring Composition Type Checks"}]},{"id":"blk-17259","spans":[{"id":"spn-15631","text":"Critical"}]}],[{"id":"blk-17260","spans":[{"id":"spn-15632","text":"3"}]},{"id":"blk-17261","spans":[{"id":"spn-15633","marks":[{"kind":"link","predicate":"cites","target":"#3--kitchen-sink-declarations"}],"text":"Kitchen-Sink Declarations"}]},{"id":"blk-17262","spans":[{"id":"spn-15634","text":"High"}]}],[{"id":"blk-17263","spans":[{"id":"spn-15635","text":"4"}]},{"id":"blk-17264","spans":[{"id":"spn-15636","marks":[{"kind":"link","predicate":"cites","target":"#4--missing-provenance-on-critical-capabilities"}],"text":"Missing Provenance on Critical Capabilities"}]},{"id":"blk-17265","spans":[{"id":"spn-15637","text":"High"}]}],[{"id":"blk-17266","spans":[{"id":"spn-15638","text":"5"}]},{"id":"blk-17267","spans":[{"id":"spn-15639","marks":[{"kind":"link","predicate":"cites","target":"#5--governance-gaps"}],"text":"Governance Gaps"}]},{"id":"blk-17268","spans":[{"id":"spn-15640","text":"High"}]}],[{"id":"blk-17269","spans":[{"id":"spn-15641","text":"6"}]},{"id":"blk-17270","spans":[{"id":"spn-15642","marks":[{"kind":"link","predicate":"cites","target":"#6--over-specifying-providers"}],"text":"Over-Specifying Providers"}]},{"id":"blk-17271","spans":[{"id":"spn-15643","text":"Medium"}]}],[{"id":"blk-17272","spans":[{"id":"spn-15644","text":"7"}]},{"id":"blk-17273","spans":[{"id":"spn-15645","marks":[{"kind":"link","predicate":"cites","target":"#7--ignoring-contract-versioning"}],"text":"Ignoring Contract Versioning"}]},{"id":"blk-17274","spans":[{"id":"spn-15646","text":"Medium"}]}],[{"id":"blk-17275","spans":[{"id":"spn-15647","text":"8"}]},{"id":"blk-17276","spans":[{"id":"spn-15648","marks":[{"kind":"link","predicate":"cites","target":"#8--pipeline-without-validation"}],"text":"Pipeline Without Validation"}]},{"id":"blk-17277","spans":[{"id":"spn-15649","text":"Medium"}]}],[{"id":"blk-17278","spans":[{"id":"spn-15650","text":"9"}]},{"id":"blk-17279","spans":[{"id":"spn-15651","marks":[{"kind":"link","predicate":"cites","target":"#9--bare-primitive-references"}],"text":"Bare Primitive References"}]},{"id":"blk-17280","spans":[{"id":"spn-15652","text":"Low"}]}],[{"id":"blk-17281","spans":[{"id":"spn-15653","text":"10"}]},{"id":"blk-17282","spans":[{"id":"spn-15654","marks":[{"kind":"link","predicate":"cites","target":"#10--copy-paste-governance"}],"text":"Copy-Paste Governance"}]},{"id":"blk-17283","spans":[{"id":"spn-15655","text":"Low"}]}]]},{"id":"blk-17284","kind":"heading","level":2,"spans":[{"id":"spn-15656","text":"Critical Anti-Patterns"}]},{"id":"blk-17285","kind":"heading","level":3,"spans":[{"id":"spn-15657","text":"1 — Capabilities Without Providers"}]},{"id":"blk-17286","kind":"paragraph","spans":[{"id":"spn-15658","marks":["bold"],"text":"The mistake:"},{"id":"spn-15659","text":" Declaring capabilities but omitting or leaving blank the provider field."}]},{"id":"blk-17287","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\": { \"config\": { \"instance\": \"ops\" } },\n  \"&time.anomaly\": { \"provider\": \"\", \"config\": {} }\n}"},{"id":"blk-17288","kind":"paragraph","spans":[{"id":"spn-15660","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17289","items":[{"blocks":[{"id":"blk-17291","kind":"paragraph","spans":[{"id":"spn-15661","text":"The runtime cannot bind the capability to any service"}]}],"id":"blk-17290","kind":"list-item"},{"blocks":[{"id":"blk-17293","kind":"paragraph","spans":[{"id":"spn-15662","text":"Generation produces empty MCP server entries"}]}],"id":"blk-17292","kind":"list-item"},{"blocks":[{"id":"blk-17295","kind":"paragraph","spans":[{"id":"spn-15663","text":"The agent appears to have capabilities it cannot actually use"}]}],"id":"blk-17294","kind":"list-item"},{"blocks":[{"id":"blk-17297","kind":"paragraph","spans":[{"id":"spn-15664","text":"Composition passes but generation fails silently or produces broken output"}]}],"id":"blk-17296","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17298","kind":"paragraph","spans":[{"id":"spn-15665","marks":["bold"],"text":"The fix:"},{"id":"spn-15666","text":" Always specify a provider. Use "},{"id":"spn-15667","marks":["code"],"text":"\"auto\""},{"id":"spn-15668","text":" if you want the runtime to resolve it from the registry:"}]},{"id":"blk-17299","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"ops\" } }\n\"&time.anomaly\": { \"provider\": \"auto\", \"config\": {} }"},{"id":"blk-17300","kind":"heading","level":3,"spans":[{"id":"spn-15669","text":"2 — Ignoring Composition Type Checks"}]},{"id":"blk-17301","kind":"paragraph","spans":[{"id":"spn-15670","marks":["bold"],"text":"The mistake:"},{"id":"spn-15671","text":" Building pipelines without verifying that step N's output type matches step N+1's "},{"id":"spn-15672","marks":["code"],"text":"accepts_from"},{"id":"spn-15673","text":" list."}]},{"id":"blk-17302","kind":"code","language":"json","text":"\"steps\": [\n  { \"capability\": \"&time.forecast\", \"operation\": \"predict\" },\n  { \"capability\": \"&memory.graph\", \"operation\": \"enrich\" }\n]"},{"id":"blk-17303","kind":"paragraph","spans":[{"id":"spn-15674","text":"If "},{"id":"spn-15675","marks":["code"],"text":"&time.forecast.predict()"},{"id":"spn-15676","text":" outputs "},{"id":"spn-15677","marks":["code"],"text":"forecast_set"},{"id":"spn-15678","text":" but "},{"id":"spn-15679","marks":["code"],"text":"&memory.graph.enrich()"},{"id":"spn-15680","text":" does not accept "},{"id":"spn-15681","marks":["code"],"text":"forecast_set"},{"id":"spn-15682","text":", the pipeline breaks at runtime."}]},{"id":"blk-17304","kind":"paragraph","spans":[{"id":"spn-15683","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17305","items":[{"blocks":[{"id":"blk-17307","kind":"paragraph","spans":[{"id":"spn-15684","text":"Runtime errors instead of compile-time errors"}]}],"id":"blk-17306","kind":"list-item"},{"blocks":[{"id":"blk-17309","kind":"paragraph","spans":[{"id":"spn-15685","text":"Silent data loss or unexpected behavior"}]}],"id":"blk-17308","kind":"list-item"},{"blocks":[{"id":"blk-17311","kind":"paragraph","spans":[{"id":"spn-15686","text":"Difficult to debug in production"}]}],"id":"blk-17310","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17312","kind":"paragraph","spans":[{"id":"spn-15687","marks":["bold"],"text":"The fix:"},{"id":"spn-15688","text":" Run "},{"id":"spn-15689","marks":["code"],"text":"ampersand compose"},{"id":"spn-15690","text":" before "},{"id":"spn-15691","marks":["code"],"text":"ampersand generate"},{"id":"spn-15692","text":". Always check the type flow:"}]},{"id":"blk-17313","kind":"code","language":"bash","text":"ampersand compose agent.ampersand.json --verbose"},{"id":"blk-17314","kind":"paragraph","spans":[{"id":"spn-15693","text":"The verbose output shows the type at each pipeline step, making mismatches immediately visible."}]},{"id":"blk-17315","kind":"heading","level":2,"spans":[{"id":"spn-15694","text":"High-Severity Anti-Patterns"}]},{"id":"blk-17316","kind":"heading","level":3,"spans":[{"id":"spn-15695","text":"3 — Kitchen-Sink Declarations"}]},{"id":"blk-17317","kind":"paragraph","spans":[{"id":"spn-15696","marks":["bold"],"text":"The mistake:"},{"id":"spn-15697","text":" Declaring every available capability even when the agent does not need most of them."}]},{"id":"blk-17318","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\": { ... },\n  \"&memory.vector\": { ... },\n  \"&memory.episodic\": { ... },\n  \"&memory.semantic\": { ... },\n  \"&time.anomaly\": { ... },\n  \"&time.forecast\": { ... },\n  \"&time.pattern\": { ... },\n  \"&time.baseline\": { ... },\n  \"&space.fleet\": { ... },\n  \"&space.geofence\": { ... },\n  \"&reason.argument\": { ... },\n  \"&reason.vote\": { ... },\n  \"&reason.plan\": { ... },\n  \"&reason.deliberate\": { ... },\n  \"&reason.attend\": { ... }\n}"},{"id":"blk-17319","kind":"paragraph","spans":[{"id":"spn-15698","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17320","items":[{"blocks":[{"id":"blk-17322","kind":"paragraph","spans":[{"id":"spn-15699","text":"Generated MCP config starts 8+ servers, most unused"}]}],"id":"blk-17321","kind":"list-item"},{"blocks":[{"id":"blk-17324","kind":"paragraph","spans":[{"id":"spn-15700","text":"A2A agent card advertises skills the agent cannot meaningfully perform"}]}],"id":"blk-17323","kind":"list-item"},{"blocks":[{"id":"blk-17326","kind":"paragraph","spans":[{"id":"spn-15701","text":"More providers means more failure points"}]}],"id":"blk-17325","kind":"list-item"},{"blocks":[{"id":"blk-17328","kind":"paragraph","spans":[{"id":"spn-15702","text":"Harder to reason about what the agent actually does"}]}],"id":"blk-17327","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17329","kind":"paragraph","spans":[{"id":"spn-15703","marks":["bold"],"text":"The fix:"},{"id":"spn-15704","text":" Start with the minimum set of capabilities your use case requires. Add more only when a concrete need emerges:"}]},{"id":"blk-17330","kind":"code","language":"json","text":"\"capabilities\": {\n  \"&memory.graph\":    { \"provider\": \"graphonomous\", \"config\": {} },\n  \"&time.anomaly\":    { \"provider\": \"ticktickclock\", \"config\": {} },\n  \"&reason.argument\": { \"provider\": \"deliberatic\", \"config\": {} }\n}"},{"id":"blk-17331","kind":"paragraph","spans":[{"id":"spn-15705","text":"Three capabilities that work together is better than fifteen that sit idle."}]},{"id":"blk-17332","kind":"heading","level":3,"spans":[{"id":"spn-15706","text":"4 — Missing Provenance on Critical Capabilities"}]},{"id":"blk-17333","kind":"paragraph","spans":[{"id":"spn-15707","marks":["bold"],"text":"The mistake:"},{"id":"spn-15708","text":" Omitting "},{"id":"spn-15709","marks":["code"],"text":"\"provenance\": true"},{"id":"spn-15710","text":" on agents that make consequential decisions."}]},{"id":"blk-17334","kind":"paragraph","spans":[{"id":"spn-15711","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17335","items":[{"blocks":[{"id":"blk-17337","kind":"paragraph","spans":[{"id":"spn-15712","text":"No audit trail for decisions"}]}],"id":"blk-17336","kind":"list-item"},{"blocks":[{"id":"blk-17339","kind":"paragraph","spans":[{"id":"spn-15713","text":"Cannot trace which capability contributed to an outcome"}]}],"id":"blk-17338","kind":"list-item"},{"blocks":[{"id":"blk-17341","kind":"paragraph","spans":[{"id":"spn-15714","text":"Compliance requirements cannot be verified"}]}],"id":"blk-17340","kind":"list-item"},{"blocks":[{"id":"blk-17343","kind":"paragraph","spans":[{"id":"spn-15715","text":"Debugging production issues requires reproducing the full pipeline"}]}],"id":"blk-17342","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17344","kind":"paragraph","spans":[{"id":"spn-15716","marks":["bold"],"text":"The fix:"},{"id":"spn-15717","text":" Enable provenance on any agent that makes decisions affecting users, infrastructure, or finances:"}]},{"id":"blk-17345","kind":"code","language":"json","text":"\"provenance\": true"},{"id":"blk-17346","kind":"paragraph","spans":[{"id":"spn-15718","text":"The overhead is minimal — a hash computation per operation. The value is significant — a complete, verifiable decision trail."}]},{"id":"blk-17347","kind":"heading","level":3,"spans":[{"id":"spn-15719","text":"5 — Governance Gaps"}]},{"id":"blk-17348","kind":"paragraph","spans":[{"id":"spn-15720","marks":["bold"],"text":"The mistake:"},{"id":"spn-15721","text":" Declaring autonomous agents without escalation rules or hard constraints."}]},{"id":"blk-17349","kind":"code","language":"json","text":"\"governance\": {\n  \"autonomy\": { \"level\": \"act\" }\n}"},{"id":"blk-17350","kind":"paragraph","spans":[{"id":"spn-15722","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17351","items":[{"blocks":[{"id":"blk-17353","kind":"paragraph","spans":[{"id":"spn-15723","text":"The agent has full autonomy with no guardrails"}]}],"id":"blk-17352","kind":"list-item"},{"blocks":[{"id":"blk-17355","kind":"paragraph","spans":[{"id":"spn-15724","text":"No mechanism to stop it from taking harmful actions"}]}],"id":"blk-17354","kind":"list-item"},{"blocks":[{"id":"blk-17357","kind":"paragraph","spans":[{"id":"spn-15725","text":"No escalation path when confidence is low"}]}],"id":"blk-17356","kind":"list-item"},{"blocks":[{"id":"blk-17359","kind":"paragraph","spans":[{"id":"spn-15726","text":"Violates the principle that autonomy requires governance"}]}],"id":"blk-17358","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17360","kind":"paragraph","spans":[{"id":"spn-15727","marks":["bold"],"text":"The fix:"},{"id":"spn-15728","text":" Every "},{"id":"spn-15729","marks":["code"],"text":"act"},{"id":"spn-15730","text":"-level agent needs hard constraints and escalation:"}]},{"id":"blk-17361","kind":"code","language":"json","text":"\"governance\": {\n  \"hard\": [\"Never exceed budget allocation\"],\n  \"escalate_when\": { \"confidence_below\": 0.6 },\n  \"autonomy\": {\n    \"level\": \"act\",\n    \"budget\": { \"max_actions_per_hour\": 10 }\n  }\n}"},{"id":"blk-17362","kind":"paragraph","spans":[{"id":"spn-15731","text":"The higher the autonomy, the more governance is required."}]},{"id":"blk-17363","kind":"heading","level":2,"spans":[{"id":"spn-15732","text":"Medium-Severity Anti-Patterns"}]},{"id":"blk-17364","kind":"heading","level":3,"spans":[{"id":"spn-15733","text":"6 — Over-Specifying Providers"}]},{"id":"blk-17365","kind":"paragraph","spans":[{"id":"spn-15734","marks":["bold"],"text":"The mistake:"},{"id":"spn-15735","text":" Hardcoding specific provider names when the agent could work with any conforming provider."}]},{"id":"blk-17366","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": {} }"},{"id":"blk-17367","kind":"paragraph","spans":[{"id":"spn-15736","marks":["bold"],"text":"Why it's harmful (when portability matters):"}]},{"id":"blk-17368","items":[{"blocks":[{"id":"blk-17370","kind":"paragraph","spans":[{"id":"spn-15737","text":"Locks the agent to a specific provider"}]}],"id":"blk-17369","kind":"list-item"},{"blocks":[{"id":"blk-17372","kind":"paragraph","spans":[{"id":"spn-15738","text":"Cannot swap to an alternative without modifying the declaration"}]}],"id":"blk-17371","kind":"list-item"},{"blocks":[{"id":"blk-17374","kind":"paragraph","spans":[{"id":"spn-15739","text":"Reduces adoption — users without access to that provider cannot use the agent"}]}],"id":"blk-17373","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17375","kind":"paragraph","spans":[{"id":"spn-15740","marks":["bold"],"text":"The fix:"},{"id":"spn-15741","text":" Use "},{"id":"spn-15742","marks":["code"],"text":"\"auto\""},{"id":"spn-15743","text":" for capabilities where the specific provider does not matter, and explicit providers only when provider-specific features are required:"}]},{"id":"blk-17376","kind":"code","language":"json","text":"\"&memory.graph\": { \"provider\": \"auto\", \"config\": { \"index\": \"docs\" } }"},{"id":"blk-17377","kind":"paragraph","spans":[{"id":"spn-15744","text":"Note: This is only an anti-pattern when portability is a goal. For internal agents with known infrastructure, explicit providers are fine."}]},{"id":"blk-17378","kind":"heading","level":3,"spans":[{"id":"spn-15745","text":"7 — Ignoring Contract Versioning"}]},{"id":"blk-17379","kind":"paragraph","spans":[{"id":"spn-15746","marks":["bold"],"text":"The mistake:"},{"id":"spn-15747","text":" Never specifying which contract version a declaration was built against."}]},{"id":"blk-17380","kind":"paragraph","spans":[{"id":"spn-15748","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17381","items":[{"blocks":[{"id":"blk-17383","kind":"paragraph","spans":[{"id":"spn-15749","text":"A provider updates its contract, breaking your pipeline"}]}],"id":"blk-17382","kind":"list-item"},{"blocks":[{"id":"blk-17385","kind":"paragraph","spans":[{"id":"spn-15750","text":"No way to pin to a known-working version"}]}],"id":"blk-17384","kind":"list-item"},{"blocks":[{"id":"blk-17387","kind":"paragraph","spans":[{"id":"spn-15751","text":"Composition may pass today and fail tomorrow"}]}],"id":"blk-17386","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17388","kind":"paragraph","spans":[{"id":"spn-15752","marks":["bold"],"text":"The fix:"},{"id":"spn-15753","text":" Pin your declarations to specific contract versions and test against them in CI:"}]},{"id":"blk-17389","kind":"code","language":"bash","text":"ampersand validate agent.ampersand.json --schema protocol/schema/v0.1.0/"},{"id":"blk-17390","kind":"paragraph","spans":[{"id":"spn-15754","text":"When upgrading, review the contract changelog for breaking changes."}]},{"id":"blk-17391","kind":"heading","level":3,"spans":[{"id":"spn-15755","text":"8 — Pipeline Without Validation"}]},{"id":"blk-17392","kind":"paragraph","spans":[{"id":"spn-15756","marks":["bold"],"text":"The mistake:"},{"id":"spn-15757","text":" Defining pipelines in the declaration but only running "},{"id":"spn-15758","marks":["code"],"text":"validate"},{"id":"spn-15759","text":" (schema check) and never "},{"id":"spn-15760","marks":["code"],"text":"compose"},{"id":"spn-15761","text":" (type check)."}]},{"id":"blk-17393","kind":"paragraph","spans":[{"id":"spn-15762","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17394","items":[{"blocks":[{"id":"blk-17396","kind":"paragraph","spans":[{"id":"spn-15763","marks":["code"],"text":"validate"},{"id":"spn-15764","text":" checks structure, not semantics"}]}],"id":"blk-17395","kind":"list-item"},{"blocks":[{"id":"blk-17398","kind":"paragraph","spans":[{"id":"spn-15765","text":"A structurally valid pipeline can have type mismatches"}]}],"id":"blk-17397","kind":"list-item"},{"blocks":[{"id":"blk-17400","kind":"paragraph","spans":[{"id":"spn-15766","text":"Errors surface at generation or runtime instead of composition time"}]}],"id":"blk-17399","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17401","kind":"paragraph","spans":[{"id":"spn-15767","marks":["bold"],"text":"The fix:"},{"id":"spn-15768","text":" Always run "},{"id":"spn-15769","marks":["code"],"text":"compose"},{"id":"spn-15770","text":" after "},{"id":"spn-15771","marks":["code"],"text":"validate"},{"id":"spn-15772","text":":"}]},{"id":"blk-17402","kind":"code","language":"bash","text":"ampersand validate agent.ampersand.json && ampersand compose agent.ampersand.json"},{"id":"blk-17403","kind":"paragraph","spans":[{"id":"spn-15773","text":"Or just run "},{"id":"spn-15774","marks":["code"],"text":"generate"},{"id":"spn-15775","text":", which includes both checks."}]},{"id":"blk-17404","kind":"heading","level":2,"spans":[{"id":"spn-15776","text":"Low-Severity Anti-Patterns"}]},{"id":"blk-17405","kind":"heading","level":3,"spans":[{"id":"spn-15777","text":"9 — Bare Primitive References"}]},{"id":"blk-17406","kind":"paragraph","spans":[{"id":"spn-15778","marks":["bold"],"text":"The mistake:"},{"id":"spn-15779","text":" Using "},{"id":"spn-15780","marks":["code"],"text":"&memory"},{"id":"spn-15781","text":" instead of "},{"id":"spn-15782","marks":["code"],"text":"&memory.graph"},{"id":"spn-15783","text":" in discussions, documentation, or (attempted) declarations."}]},{"id":"blk-17407","kind":"paragraph","spans":[{"id":"spn-15784","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17408","items":[{"blocks":[{"id":"blk-17410","kind":"paragraph","spans":[{"id":"spn-15785","text":"Declarations require subtypes — "},{"id":"spn-15786","marks":["code"],"text":"&memory"},{"id":"spn-15787","text":" alone is not valid"}]}],"id":"blk-17409","kind":"list-item"},{"blocks":[{"id":"blk-17412","kind":"paragraph","spans":[{"id":"spn-15788","text":"Creates ambiguity about which specific capability is meant"}]}],"id":"blk-17411","kind":"list-item"},{"blocks":[{"id":"blk-17414","kind":"paragraph","spans":[{"id":"spn-15789","text":"New users may think bare primitives work and get confused by errors"}]}],"id":"blk-17413","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17415","kind":"paragraph","spans":[{"id":"spn-15790","marks":["bold"],"text":"The fix:"},{"id":"spn-15791","text":" Always use the full "},{"id":"spn-15792","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-15793","text":" form:"}]},{"id":"blk-17416","kind":"code","language":"text","text":"&memory.graph    (not &memory)\n&reason.argument (not &reason)\n&time.anomaly    (not &time)\n&space.fleet     (not &space)"},{"id":"blk-17417","kind":"heading","level":3,"spans":[{"id":"spn-15794","text":"10 — Copy-Paste Governance"}]},{"id":"blk-17418","kind":"paragraph","spans":[{"id":"spn-15795","marks":["bold"],"text":"The mistake:"},{"id":"spn-15796","text":" Copying governance blocks from examples without adapting them to the agent's actual requirements."}]},{"id":"blk-17419","kind":"paragraph","spans":[{"id":"spn-15797","marks":["bold"],"text":"Why it's harmful:"}]},{"id":"blk-17420","items":[{"blocks":[{"id":"blk-17422","kind":"paragraph","spans":[{"id":"spn-15798","text":"Constraints may be too loose or too strict for the use case"}]}],"id":"blk-17421","kind":"list-item"},{"blocks":[{"id":"blk-17424","kind":"paragraph","spans":[{"id":"spn-15799","text":"Escalation thresholds may not match operational reality"}]}],"id":"blk-17423","kind":"list-item"},{"blocks":[{"id":"blk-17426","kind":"paragraph","spans":[{"id":"spn-15800","text":"Budget limits may be inappropriate"}]}],"id":"blk-17425","kind":"list-item"},{"blocks":[{"id":"blk-17428","kind":"paragraph","spans":[{"id":"spn-15801","text":"Creates a false sense of security"}]}],"id":"blk-17427","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17429","kind":"paragraph","spans":[{"id":"spn-15802","marks":["bold"],"text":"The fix:"},{"id":"spn-15803","text":" Write governance constraints specific to your agent's domain, risk profile, and operational context. Use examples as templates, not as final answers."}]},{"id":"blk-17430","kind":"heading","level":2,"spans":[{"id":"spn-15804","text":"Self-Audit Checklist"}]},{"id":"blk-17431","kind":"paragraph","spans":[{"id":"spn-15805","text":"Run through this before deploying an agent declaration:"}]},{"id":"blk-17432","kind":"heading","level":3,"spans":[{"id":"spn-15806","text":"Declaration"}]},{"id":"blk-17433","items":[{"blocks":[{"id":"blk-17435","kind":"paragraph","spans":[{"id":"spn-15807","text":"[ ] Every capability has an explicit provider (or "},{"id":"spn-15808","marks":["code"],"text":"\"auto\""},{"id":"spn-15809","text":")"}]}],"id":"blk-17434","kind":"list-item"},{"blocks":[{"id":"blk-17437","kind":"paragraph","spans":[{"id":"spn-15810","text":"[ ] Agent name and version are set"}]}],"id":"blk-17436","kind":"list-item"},{"blocks":[{"id":"blk-17439","kind":"paragraph","spans":[{"id":"spn-15811","text":"[ ] Only needed capabilities are declared"}]}],"id":"blk-17438","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17440","kind":"heading","level":3,"spans":[{"id":"spn-15812","text":"Composition"}]},{"id":"blk-17441","items":[{"blocks":[{"id":"blk-17443","kind":"paragraph","spans":[{"id":"spn-15813","text":"[ ] "},{"id":"spn-15814","marks":["code"],"text":"ampersand compose"},{"id":"spn-15815","text":" passes with no errors"}]}],"id":"blk-17442","kind":"list-item"},{"blocks":[{"id":"blk-17445","kind":"paragraph","spans":[{"id":"spn-15816","text":"[ ] Pipeline type flow is verified (use "},{"id":"spn-15817","marks":["code"],"text":"--verbose"},{"id":"spn-15818","text":")"}]}],"id":"blk-17444","kind":"list-item"},{"blocks":[{"id":"blk-17447","kind":"paragraph","spans":[{"id":"spn-15819","text":"[ ] No circular pipeline dependencies"}]}],"id":"blk-17446","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17448","kind":"heading","level":3,"spans":[{"id":"spn-15820","text":"Governance"}]},{"id":"blk-17449","items":[{"blocks":[{"id":"blk-17451","kind":"paragraph","spans":[{"id":"spn-15821","text":"[ ] Hard constraints cover critical boundaries"}]}],"id":"blk-17450","kind":"list-item"},{"blocks":[{"id":"blk-17453","kind":"paragraph","spans":[{"id":"spn-15822","text":"[ ] Escalation triggers are set for autonomous agents"}]}],"id":"blk-17452","kind":"list-item"},{"blocks":[{"id":"blk-17455","kind":"paragraph","spans":[{"id":"spn-15823","text":"[ ] Autonomy level matches operational trust level"}]}],"id":"blk-17454","kind":"list-item"},{"blocks":[{"id":"blk-17457","kind":"paragraph","spans":[{"id":"spn-15824","text":"[ ] Budget limits are appropriate"}]}],"id":"blk-17456","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17458","kind":"heading","level":3,"spans":[{"id":"spn-15825","text":"Provenance"}]},{"id":"blk-17459","items":[{"blocks":[{"id":"blk-17461","kind":"paragraph","spans":[{"id":"spn-15826","text":"[ ] "},{"id":"spn-15827","marks":["code"],"text":"provenance: true"},{"id":"spn-15828","text":" for agents making consequential decisions"}]}],"id":"blk-17460","kind":"list-item"},{"blocks":[{"id":"blk-17463","kind":"paragraph","spans":[{"id":"spn-15829","text":"[ ] Audit trail requirements are met"}]}],"id":"blk-17462","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17464","kind":"heading","level":3,"spans":[{"id":"spn-15830","text":"Portability"}]},{"id":"blk-17465","items":[{"blocks":[{"id":"blk-17467","kind":"paragraph","spans":[{"id":"spn-15831","text":"[ ] Providers are explicit only when provider-specific features are needed"}]}],"id":"blk-17466","kind":"list-item"},{"blocks":[{"id":"blk-17469","kind":"paragraph","spans":[{"id":"spn-15832","text":"[ ] Contract versions are pinned for production agents"}]}],"id":"blk-17468","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierajakxggkvsc3joj3s7mrqk6uzpz5btrksvpgllsfud3u5yx4ofgra","vocabulary":"ampersand.docs.fs.v1"}