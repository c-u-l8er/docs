head":[{"id":"blk-2228","spans":[{"id":"spn-2823","text":"Stage"}]},{"id":"blk-2229","spans":[{"id":"spn-2824","text":"Question it answers"}]},{"id":"blk-2230","spans":[{"id":"spn-2825","text":"Owned by"}]},{"id":"blk-2231","spans":[{"id":"spn-2826","text":"Status"}]}],"id":"blk-2227","kind":"table","rows":[[{"id":"blk-2232","spans":[{"id":"spn-2827","marks":["bold"],"text":"declare"}]},{"id":"blk-2233","spans":[{"id":"spn-2828","text":"what capabilities, held by whom, piped how?"}]},{"id":"blk-2234","spans":[{"id":"spn-2829","marks":["code"],"text":"[&]"},{"id":"spn-2830","text":" schema ("},{"id":"spn-2831","marks":["code"],"text":"ampersand.json"},{"id":"spn-2832","text":"); CC2 coalition object"}]},{"id":"blk-2235","spans":[{"id":"spn-2833","text":"CC1 ✅ shipped · CC2 "},{"id":"spn-2834","marks":["code"],"text":"coalition.schema.json"},{"id":"spn-2835","text":" ✅ shipped (no runtime yet)"}]}],[{"id":"blk-2236","spans":[{"id":"spn-2836","marks":["bold"],"text":"validate"}]},{"id":"blk-2237","spans":[{"id":"spn-2837","text":"does the declaration conform?"}]},{"id":"blk-2238","spans":[{"id":"spn-2838","marks":["code"],"text":"@ampersand-protocol/validate"},{"id":"spn-2839","text":" (npm), Python SDK, Elixir "},{"id":"spn-2840","marks":["code"],"text":"schema.ex"}]},{"id":"blk-2239","spans":[{"id":"spn-2841","text":"✅ — "},{"id":"spn-2842","marks":["bold"],"text":"CC1 only"},{"id":"spn-2843","text":" (CC2 validates via the schema directly, ajv)"}]}],[{"id":"blk-2240","spans":[{"id":"spn-2844","marks":["bold"],"text":"compose"}]},{"id":"blk-2241","spans":[{"id":"spn-2845","text":"do the "},{"id":"spn-2846","marks":["code"],"text":"&"},{"id":"spn-2847","text":" / `\\"}]},{"id":"blk-2242","spans":[{"id":"spn-2848","text":">` combinations hold?"}]},{"id":"blk-2243","spans":[{"id":"spn-2849","text":"Elixir "},{"id":"spn-2850","marks":["code"],"text":"compose.ex"},{"id":"spn-2851","text":"; CC2 lifts `\\"}]},{"id":"blk-2244","spans":[{"id":"spn-2852","text":">` to a governed pipeline"}]},{"id":"blk-2245","spans":[{"id":"spn-2853","text":"CC1 "},{"id":"spn-2854","marks":["code"],"text":"&"},{"id":"spn-2855","text":" ✅ · `\\"}]},{"id":"blk-2246","spans":[{"id":"spn-2856","text":">"},{"id":"spn-2857","marks":["code"],"text":" still lawless · CC1→singleton-coalition lift ✅ ("},{"id":"spn-2858","text":"box-and-box lift`) · cross-agent coalition compose ❌"}]}],[{"id":"blk-2247","spans":[{"id":"spn-2859","marks":["bold"],"text":"govern"}]},{"id":"blk-2248","spans":[{"id":"spn-2860","text":"is this action "},{"id":"spn-2861","marks":["code"],"text":"feasible ▸ permitted ▸ best"},{"id":"spn-2862","text":"?"}]},{"id":"blk-2249","spans":[{"id":"spn-2863","marks":["bold"],"text":"box-and-box"},{"id":"spn-2864","text":" (8 rungs, 103 laws)"}]},{"id":"blk-2250","spans":[{"id":"spn-2865","text":"engine ✅ · CC1 governance bridge ✅ ("},{"id":"spn-2866","marks":["code"],"text":"box-and-box compile"},{"id":"spn-2867","text":") · coalition wiring ❌"}]}],[{"id":"blk-2251","spans":[{"id":"spn-2868","marks":["bold"],"text":"wire"}]},{"id":"blk-2252","spans":[{"id":"spn-2869","text":"emit MCP + A2A configs"}]},{"id":"blk-2253","spans":[{"id":"spn-2870","text":"Elixir "},{"id":"spn-2871","marks":["code"],"text":"mcp.ex"},{"id":"spn-2872","text":" + "},{"id":"spn-2873","marks":["code"],"text":"a2a.ex"}]},{"id":"blk-2254","spans":[{"id":"spn-2874","text":"✅ — CC1 only"}]}],[{"id":"blk-2255","spans":[{"id":"spn-2875","marks":["bold"],"text":"run"}]},{"id":"blk-2256","spans":[{"id":"spn-2876","text":"gate every effect "},{"id":"spn-2877","marks":["italic"],"text":"before"},{"id":"spn-2878","text":" it fires (interpositional host)"}]},{"id":"blk-2257","spans":[{"id":"spn-2879","marks":["code"],"text":"box-and-box/aios/"},{"id":"spn-2880","text":" reference host"}]},{"id":"blk-2258","spans":[{"id":"spn-2881","text":"illustrative only ❌ no real runtime"}]}],[{"id":"blk-2259","spans":[{"id":"spn-2882","marks":["bold"],"text":"observe"}]},{"id":"blk-2260","spans":[{"id":"spn-2883","text":"emit an auditable decision certificate + evolve the policy on a provenance chain"}]},{"id":"blk-2261","spans":[{"id":"spn-2884","text":"box-and-box certs + "},{"id":"spn-2885","marks":["code"],"text":"evolution.mjs"},{"id":"spn-2886","text":" hash-chain + PULSE cross-loop bus"}]},{"id":"blk-2262","spans":[{"id":"spn-2887","text":"certs ✅ · provenance chain + measured/priced/certified "},{"id":"spn-2888","marks":["code"],"text":"evolve()"},{"id":"spn-2889","text":" ✅ (EV1–EV6) · CloudEvents emission (CC2 §7) ❌"}]}]]},{"id":"blk-2263","kind":"paragraph","spans":[{"id":"spn-2890","text":"Two supporting artifacts sit alongside: the "},{"id":"spn-2891","marks":["bold"],"text":"registry"},{"id":"spn-2892","text":" ("},{"id":"spn-2893","marks":["code"],"text":"protocol/registry/v0.1.0/"},{"id":"spn-2894","text":", ✅) and the "},{"id":"spn-2895","marks":["bold"],"text":"conformance suite"},{"id":"spn-2896","text":" (103 laws — ✅ in JS, no second-host cross-language harness yet ❌)."}]},{"id":"blk-2264","kind":"heading","level":2,"spans":[{"id":"spn-2897","text":"2. The govern stage is split in two (the keystone gap)"}]},{"id":"blk-2265","kind":"paragraph","spans":[{"id":"spn-2898","text":"Today there are "},{"id":"spn-2899","marks":["bold"],"text":"two governance implementations that do not talk to each other"},{"id":"spn-2900","text":":"}]},{"id":"blk-2266","items":[{"blocks":[{"id":"blk-2268","kind":"paragraph","spans":[{"id":"spn-2901","marks":["code"],"text":"reference/elixir/ampersand_core/governance.ex"},{"id":"spn-2902","text":" — the CC1 governance block evaluator. Parses flat compact conditions ("},{"id":"spn-2903","marks":["code"],"text":"confidence_below:0.75"},{"id":"spn-2904","text":", "},{"id":"spn-2905","marks":["code"],"text":"cost_exceeds_usd:1000"},{"id":"spn-2906","text":") into "},{"id":"spn-2907","marks":["code"],"text":"pass"},{"id":"spn-2908","text":" / "},{"id":"spn-2909","marks":["code"],"text":"escalate"},{"id":"spn-2910","text":" / "},{"id":"spn-2911","marks":["code"],"text":"block"},{"id":"spn-2912","text":". Ad-hoc, no algebra. This is the \"flat governance block\" CC2 §0 explicitly sets out to replace."}]}],"id":"blk-2267","kind":"list-item"},{"blocks":[{"id":"blk-2270","kind":"paragraph","spans":[{"id":"spn-2913","marks":["code"],"text":"box-and-box/"},{"id":"spn-2914","text":" — the real 8-rung modal arithmetic with 103 property-tested laws. Takes its "},{"id":"spn-2915","marks":["bold"],"text":"own"},{"id":"spn-2916","text":" decision-spec JSON ("},{"id":"spn-2917","marks":["code"],"text":"{req, norms, options}"},{"id":"spn-2918","text":"), not an "},{"id":"spn-2919","marks":["code"],"text":"ampersand.json"},{"id":"spn-2920","text":"."}]}],"id":"blk-2269","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-2271","kind":"paragraph","spans":[{"id":"spn-2921","text":"Nothing bridges them. Until a composed "},{"id":"spn-2922","marks":["code"],"text":"[&]"},{"id":"spn-2923","text":" capability set's "},{"id":"spn-2924","marks":["code"],"text":"governance"},{"id":"spn-2925","text":" block is evaluated "},{"id":"spn-2926","marks":["italic"],"text":"through"},{"id":"spn-2927","text":" the box-and-box rungs, the umbrella is two products in one repo. "},{"id":"spn-2928","marks":["bold"],"text":"Closing this is the single highest-leverage step"},{"id":"spn-2929","text":"; everything else (CC2 schema, coalition compose, interpositional host) builds on it."}]},{"id":"blk-2272","kind":"paragraph","spans":[{"id":"spn-2930","text":"The bridge is a deterministic translation (no LLM, no network) from the CC1 governance block to a box-and-box policy:"}]},{"head":[{"id":"blk-2274","spans":[{"id":"spn-2931","marks":["code"],"text":"[&]"},{"id":"spn-2932","text":" governance (CC1)"}]},{"id":"blk-2275","spans":[{"id":"spn-2933","text":"box-and-box"}]},{"id":"blk-2276","spans":[{"id":"spn-2934","text":"Rung"}]}],"id":"blk-2273","kind":"table","rows":[[{"id":"blk-2277","spans":[{"id":"spn-2935"