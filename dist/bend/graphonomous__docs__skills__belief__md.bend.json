{"bendscript":"0.1","blocks":[{"id":"blk-67858","kind":"heading","level":1,"spans":[{"id":"spn-100238","text":"Belief Revision"}]},{"id":"blk-67859","kind":"paragraph","spans":[{"id":"spn-100239","text":"AGM-style belief management — expand, revise, or contract beliefs with automatic contradiction detection and confidence propagation."}]},{"id":"blk-67860","kind":"heading","level":2,"spans":[{"id":"spn-100240","text":"Arguments"}]},{"id":"blk-67861","kind":"paragraph","spans":[{"id":"spn-100241","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-67862","kind":"heading","level":2,"spans":[{"id":"spn-100242","text":"Operations"}]},{"id":"blk-67863","kind":"heading","level":3,"spans":[{"id":"spn-100243","text":"Expand — Add a New Belief"}]},{"id":"blk-67864","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"expand\", content: \"New fact here\", confidence: 0.8)"},{"id":"blk-67865","kind":"paragraph","spans":[{"id":"spn-100244","text":"Automatically checks for contradictions. Creates bidirectional "},{"id":"spn-100245","marks":["code"],"text":":contradicts"},{"id":"spn-100246","text":" edges if found (forming kappa=1 SCCs)."}]},{"id":"blk-67866","kind":"heading","level":3,"spans":[{"id":"spn-100247","text":"Revise — Replace a Wrong Belief"}]},{"id":"blk-67867","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"revise\", node_id: \"<old_node>\", content: \"Corrected fact\", rationale: \"why\")"},{"id":"blk-67868","kind":"paragraph","spans":[{"id":"spn-100248","text":"Creates new node, supersedes old (confidence -> 30%), propagates 0.6x decay through dependents."}]},{"id":"blk-67869","kind":"heading","level":3,"spans":[{"id":"spn-100249","text":"Contract — Withdraw Without Replacement"}]},{"id":"blk-67870","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"contract\", node_id: \"<wrong_node>\", rationale: \"why\")"},{"id":"blk-67871","kind":"paragraph","spans":[{"id":"spn-100250","text":"Sets confidence to 0.05, propagates decay. Node preserved for provenance."}]},{"id":"blk-67872","kind":"heading","level":2,"spans":[{"id":"spn-100251","text":"Detect Contradictions"}]},{"id":"blk-67873","kind":"code","language":"text","text":"learn(action: \"contradictions\", content: \"<new info>\")\nlearn(action: \"contradictions\", node_id: \"<existing_node>\")"},{"id":"blk-67874","kind":"paragraph","spans":[{"id":"spn-100252","text":"Returns detected conflicts with similarity scores and negation markers."}]},{"id":"blk-67875","kind":"heading","level":2,"spans":[{"id":"spn-100253","text":"Workflow"}]},{"id":"blk-67876","items":[{"blocks":[{"id":"blk-67878","kind":"paragraph","spans":[{"id":"spn-100254","marks":["code"],"text":"learn(action: \"contradictions\", content: \"<new info>\")"},{"id":"spn-100255","text":" — check first"}]}],"id":"blk-67877","kind":"list-item"},{"blocks":[{"id":"blk-67880","kind":"paragraph","spans":[{"id":"spn-100256","text":"Assess: is the contradiction real?"}]}],"id":"blk-67879","kind":"list-item"},{"blocks":[{"id":"blk-67882","kind":"paragraph","spans":[{"id":"spn-100257","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"revise|contract|expand\")"},{"id":"spn-100258","text":" — act"}]}],"id":"blk-67881","kind":"list-item"},{"blocks":[{"id":"blk-67884","kind":"paragraph","spans":[{"id":"spn-100259","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-100260","text":" — check for new cycles"}]}],"id":"blk-67883","kind":"list-item"},{"blocks":[{"id":"blk-67886","kind":"paragraph","spans":[{"id":"spn-100261","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-100262","text":" — if kappa > 0 on affected region"}]}],"id":"blk-67885","kind":"list-item"},{"blocks":[{"id":"blk-67888","kind":"paragraph","spans":[{"id":"spn-100263","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-100264","text":" — report the revision result"}]}],"id":"blk-67887","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67889","kind":"heading","level":2,"spans":[{"id":"spn-100265","text":"Key Rules"}]},{"id":"blk-67890","items":[{"blocks":[{"id":"blk-67892","kind":"paragraph","spans":[{"id":"spn-100266","text":"Always check contradictions before revising"}]}],"id":"blk-67891","kind":"list-item"},{"blocks":[{"id":"blk-67894","kind":"paragraph","spans":[{"id":"spn-100267","text":"Use "},{"id":"spn-100268","marks":["code"],"text":"revise"},{"id":"spn-100269","text":" when old is wrong (not "},{"id":"spn-100270","marks":["code"],"text":"expand"},{"id":"spn-100271","text":" — that creates contradictions)"}]}],"id":"blk-67893","kind":"list-item"},{"blocks":[{"id":"blk-67896","kind":"paragraph","spans":[{"id":"spn-100272","text":"Use "},{"id":"spn-100273","marks":["code"],"text":"contract"},{"id":"spn-100274","text":" when wrong but no replacement available"}]}],"id":"blk-67895","kind":"list-item"},{"blocks":[{"id":"blk-67898","kind":"paragraph","spans":[{"id":"spn-100275","text":"Review "},{"id":"spn-100276","marks":["code"],"text":"affected_node_ids"},{"id":"spn-100277","text":" after revision to assess cascade impact"}]}],"id":"blk-67897","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67899","kind":"heading","level":2,"spans":[{"id":"spn-100278","text":"Anti-patterns to avoid"}]},{"id":"blk-67900","items":[{"blocks":[{"id":"blk-67902","kind":"paragraph","spans":[{"id":"spn-100279","text":"Expanding without checking for contradictions first"}]}],"id":"blk-67901","kind":"list-item"},{"blocks":[{"id":"blk-67904","kind":"paragraph","spans":[{"id":"spn-100280","text":"Using "},{"id":"spn-100281","marks":["code"],"text":"contract"},{"id":"spn-100282","text":" when you have a correction (use "},{"id":"spn-100283","marks":["code"],"text":"revise"},{"id":"spn-100284","text":" instead)"}]}],"id":"blk-67903","kind":"list-item"},{"blocks":[{"id":"blk-67906","kind":"paragraph","spans":[{"id":"spn-100285","text":"Ignoring cascade effects on dependent nodes"}]}],"id":"blk-67905","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierahtsulp2ee236aaie4csdpqgxxpneln3jbu3qpm5p2pjmm4m6kldq","vocabulary":"ampersand.docs.fs.v1"}