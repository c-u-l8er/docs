{"bendscript":"0.1","blocks":[{"id":"blk-43251","kind":"paragraph","spans":[{"id":"spn-49788","text":"--- name: belief description: Use when knowledge changes, contradictions are detected, facts become outdated, or corrections are needed. Triggers on \"revise belief\", \"correct knowledge\", \"contradictions\", \"knowledge is wrong\", \"update fact\", \"expand belief\", \"contract belief\", or when learn_from_outcome reveals failures. Uses "},{"id":"spn-49789","marks":["code"],"text":"act"},{"id":"spn-49790","text":" and "},{"id":"spn-49791","marks":["code"],"text":"learn"},{"id":"spn-49792","text":" machines. argument-hint: [expand|revise|contract] <content or node_id> ---"}]},{"id":"blk-43252","kind":"heading","level":1,"spans":[{"id":"spn-49793","text":"Belief Revision"}]},{"id":"blk-43253","kind":"paragraph","spans":[{"id":"spn-49794","text":"AGM-style belief management — expand, revise, or contract beliefs with automatic contradiction detection and confidence propagation."}]},{"id":"blk-43254","kind":"heading","level":2,"spans":[{"id":"spn-49795","text":"Arguments"}]},{"id":"blk-43255","kind":"paragraph","spans":[{"id":"spn-49796","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-43256","kind":"heading","level":2,"spans":[{"id":"spn-49797","text":"Operations"}]},{"id":"blk-43257","kind":"heading","level":3,"spans":[{"id":"spn-49798","text":"Expand — Add a New Belief"}]},{"id":"blk-43258","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"expand\", content: \"New fact here\", confidence: 0.8)"},{"id":"blk-43259","kind":"paragraph","spans":[{"id":"spn-49799","text":"Automatically checks for contradictions. Creates bidirectional "},{"id":"spn-49800","marks":["code"],"text":":contradicts"},{"id":"spn-49801","text":" edges if found (forming kappa=1 SCCs)."}]},{"id":"blk-43260","kind":"heading","level":3,"spans":[{"id":"spn-49802","text":"Revise — Replace a Wrong Belief"}]},{"id":"blk-43261","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"revise\", node_id: \"<old_node>\", content: \"Corrected fact\", rationale: \"why\")"},{"id":"blk-43262","kind":"paragraph","spans":[{"id":"spn-49803","text":"Creates new node, supersedes old (confidence -> 30%), propagates 0.6x decay through dependents."}]},{"id":"blk-43263","kind":"heading","level":3,"spans":[{"id":"spn-49804","text":"Contract — Withdraw Without Replacement"}]},{"id":"blk-43264","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"contract\", node_id: \"<wrong_node>\", rationale: \"why\")"},{"id":"blk-43265","kind":"paragraph","spans":[{"id":"spn-49805","text":"Sets confidence to 0.05, propagates decay. Node preserved for provenance."}]},{"id":"blk-43266","kind":"heading","level":2,"spans":[{"id":"spn-49806","text":"Detect Contradictions"}]},{"id":"blk-43267","kind":"code","language":"text","text":"learn(action: \"contradictions\", content: \"<new info>\")\nlearn(action: \"contradictions\", node_id: \"<existing_node>\")"},{"id":"blk-43268","kind":"paragraph","spans":[{"id":"spn-49807","text":"Returns detected conflicts with similarity scores and negation markers."}]},{"id":"blk-43269","kind":"heading","level":2,"spans":[{"id":"spn-49808","text":"Workflow"}]},{"id":"blk-43270","kind":"paragraph","spans":[{"id":"spn-49809","text":"1. "},{"id":"spn-49810","marks":["code"],"text":"learn(action: \"contradictions\", content: \"<new info>\")"},{"id":"spn-49811","text":" — check first 2. Assess: is the contradiction real? 3. "},{"id":"spn-49812","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"revise|contract|expand\")"},{"id":"spn-49813","text":" — act 4. "},{"id":"spn-49814","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-49815","text":" — check for new cycles 5. "},{"id":"spn-49816","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-49817","text":" — if kappa > 0 on affected region 6. "},{"id":"spn-49818","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-49819","text":" — report the revision result"}]},{"id":"blk-43271","kind":"heading","level":2,"spans":[{"id":"spn-49820","text":"Key Rules"}]},{"id":"blk-43272","items":[{"blocks":[{"id":"blk-43274","kind":"paragraph","spans":[{"id":"spn-49821","text":"Always check contradictions before revising"}]}],"id":"blk-43273","kind":"list-item"},{"blocks":[{"id":"blk-43276","kind":"paragraph","spans":[{"id":"spn-49822","text":"Use "},{"id":"spn-49823","marks":["code"],"text":"revise"},{"id":"spn-49824","text":" when old is wrong (not "},{"id":"spn-49825","marks":["code"],"text":"expand"},{"id":"spn-49826","text":" — that creates contradictions)"}]}],"id":"blk-43275","kind":"list-item"},{"blocks":[{"id":"blk-43278","kind":"paragraph","spans":[{"id":"spn-49827","text":"Use "},{"id":"spn-49828","marks":["code"],"text":"contract"},{"id":"spn-49829","text":" when wrong but no replacement available"}]}],"id":"blk-43277","kind":"list-item"},{"blocks":[{"id":"blk-43280","kind":"paragraph","spans":[{"id":"spn-49830","text":"Review "},{"id":"spn-49831","marks":["code"],"text":"affected_node_ids"},{"id":"spn-49832","text":" after revision to assess cascade impact"}]}],"id":"blk-43279","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43281","kind":"heading","level":2,"spans":[{"id":"spn-49833","text":"Anti-patterns to avoid"}]},{"id":"blk-43282","items":[{"blocks":[{"id":"blk-43284","kind":"paragraph","spans":[{"id":"spn-49834","text":"Expanding without checking for contradictions first"}]}],"id":"blk-43283","kind":"list-item"},{"blocks":[{"id":"blk-43286","kind":"paragraph","spans":[{"id":"spn-49835","text":"Using "},{"id":"spn-49836","marks":["code"],"text":"contract"},{"id":"spn-49837","text":" when you have a correction (use "},{"id":"spn-49838","marks":["code"],"text":"revise"},{"id":"spn-49839","text":" instead)"}]}],"id":"blk-43285","kind":"list-item"},{"blocks":[{"id":"blk-43288","kind":"paragraph","spans":[{"id":"spn-49840","text":"Ignoring cascade effects on dependent nodes"}]}],"id":"blk-43287","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieranm32jxglinjsyubcs5jimzfud5v42vrmgdfutdn4fodindm5dq6a","vocabulary":"ampersand.docs.fs.v1"}