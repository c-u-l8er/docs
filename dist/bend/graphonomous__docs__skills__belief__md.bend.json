{"bendscript":"0.1","blocks":[{"id":"blk-66904","kind":"heading","level":1,"spans":[{"id":"spn-97451","text":"Belief Revision"}]},{"id":"blk-66905","kind":"paragraph","spans":[{"id":"spn-97452","text":"AGM-style belief management — expand, revise, or contract beliefs with automatic contradiction detection and confidence propagation."}]},{"id":"blk-66906","kind":"heading","level":2,"spans":[{"id":"spn-97453","text":"Arguments"}]},{"id":"blk-66907","kind":"paragraph","spans":[{"id":"spn-97454","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-66908","kind":"heading","level":2,"spans":[{"id":"spn-97455","text":"Operations"}]},{"id":"blk-66909","kind":"heading","level":3,"spans":[{"id":"spn-97456","text":"Expand — Add a New Belief"}]},{"id":"blk-66910","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"expand\", content: \"New fact here\", confidence: 0.8)"},{"id":"blk-66911","kind":"paragraph","spans":[{"id":"spn-97457","text":"Automatically checks for contradictions. Creates bidirectional "},{"id":"spn-97458","marks":["code"],"text":":contradicts"},{"id":"spn-97459","text":" edges if found (forming kappa=1 SCCs)."}]},{"id":"blk-66912","kind":"heading","level":3,"spans":[{"id":"spn-97460","text":"Revise — Replace a Wrong Belief"}]},{"id":"blk-66913","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"revise\", node_id: \"<old_node>\", content: \"Corrected fact\", rationale: \"why\")"},{"id":"blk-66914","kind":"paragraph","spans":[{"id":"spn-97461","text":"Creates new node, supersedes old (confidence -> 30%), propagates 0.6x decay through dependents."}]},{"id":"blk-66915","kind":"heading","level":3,"spans":[{"id":"spn-97462","text":"Contract — Withdraw Without Replacement"}]},{"id":"blk-66916","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"contract\", node_id: \"<wrong_node>\", rationale: \"why\")"},{"id":"blk-66917","kind":"paragraph","spans":[{"id":"spn-97463","text":"Sets confidence to 0.05, propagates decay. Node preserved for provenance."}]},{"id":"blk-66918","kind":"heading","level":2,"spans":[{"id":"spn-97464","text":"Detect Contradictions"}]},{"id":"blk-66919","kind":"code","language":"text","text":"learn(action: \"contradictions\", content: \"<new info>\")\nlearn(action: \"contradictions\", node_id: \"<existing_node>\")"},{"id":"blk-66920","kind":"paragraph","spans":[{"id":"spn-97465","text":"Returns detected conflicts with similarity scores and negation markers."}]},{"id":"blk-66921","kind":"heading","level":2,"spans":[{"id":"spn-97466","text":"Workflow"}]},{"id":"blk-66922","items":[{"blocks":[{"id":"blk-66924","kind":"paragraph","spans":[{"id":"spn-97467","marks":["code"],"text":"learn(action: \"contradictions\", content: \"<new info>\")"},{"id":"spn-97468","text":" — check first"}]}],"id":"blk-66923","kind":"list-item"},{"blocks":[{"id":"blk-66926","kind":"paragraph","spans":[{"id":"spn-97469","text":"Assess: is the contradiction real?"}]}],"id":"blk-66925","kind":"list-item"},{"blocks":[{"id":"blk-66928","kind":"paragraph","spans":[{"id":"spn-97470","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"revise|contract|expand\")"},{"id":"spn-97471","text":" — act"}]}],"id":"blk-66927","kind":"list-item"},{"blocks":[{"id":"blk-66930","kind":"paragraph","spans":[{"id":"spn-97472","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-97473","text":" — check for new cycles"}]}],"id":"blk-66929","kind":"list-item"},{"blocks":[{"id":"blk-66932","kind":"paragraph","spans":[{"id":"spn-97474","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-97475","text":" — if kappa > 0 on affected region"}]}],"id":"blk-66931","kind":"list-item"},{"blocks":[{"id":"blk-66934","kind":"paragraph","spans":[{"id":"spn-97476","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-97477","text":" — report the revision result"}]}],"id":"blk-66933","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-66935","kind":"heading","level":2,"spans":[{"id":"spn-97478","text":"Key Rules"}]},{"id":"blk-66936","items":[{"blocks":[{"id":"blk-66938","kind":"paragraph","spans":[{"id":"spn-97479","text":"Always check contradictions before revising"}]}],"id":"blk-66937","kind":"list-item"},{"blocks":[{"id":"blk-66940","kind":"paragraph","spans":[{"id":"spn-97480","text":"Use "},{"id":"spn-97481","marks":["code"],"text":"revise"},{"id":"spn-97482","text":" when old is wrong (not "},{"id":"spn-97483","marks":["code"],"text":"expand"},{"id":"spn-97484","text":" — that creates contradictions)"}]}],"id":"blk-66939","kind":"list-item"},{"blocks":[{"id":"blk-66942","kind":"paragraph","spans":[{"id":"spn-97485","text":"Use "},{"id":"spn-97486","marks":["code"],"text":"contract"},{"id":"spn-97487","text":" when wrong but no replacement available"}]}],"id":"blk-66941","kind":"list-item"},{"blocks":[{"id":"blk-66944","kind":"paragraph","spans":[{"id":"spn-97488","text":"Review "},{"id":"spn-97489","marks":["code"],"text":"affected_node_ids"},{"id":"spn-97490","text":" after revision to assess cascade impact"}]}],"id":"blk-66943","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66945","kind":"heading","level":2,"spans":[{"id":"spn-97491","text":"Anti-patterns to avoid"}]},{"id":"blk-66946","items":[{"blocks":[{"id":"blk-66948","kind":"paragraph","spans":[{"id":"spn-97492","text":"Expanding without checking for contradictions first"}]}],"id":"blk-66947","kind":"list-item"},{"blocks":[{"id":"blk-66950","kind":"paragraph","spans":[{"id":"spn-97493","text":"Using "},{"id":"spn-97494","marks":["code"],"text":"contract"},{"id":"spn-97495","text":" when you have a correction (use "},{"id":"spn-97496","marks":["code"],"text":"revise"},{"id":"spn-97497","text":" instead)"}]}],"id":"blk-66949","kind":"list-item"},{"blocks":[{"id":"blk-66952","kind":"paragraph","spans":[{"id":"spn-97498","text":"Ignoring cascade effects on dependent nodes"}]}],"id":"blk-66951","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierawc7443qog74gf23joj4kvscbk4dyug3r2jd3bhh2uoqvkqbc7gka","vocabulary":"ampersand.docs.fs.v1"}