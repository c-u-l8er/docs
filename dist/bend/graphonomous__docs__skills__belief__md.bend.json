{"bendscript":"0.1","blocks":[{"id":"blk-66893","kind":"heading","level":1,"spans":[{"id":"spn-97398","text":"Belief Revision"}]},{"id":"blk-66894","kind":"paragraph","spans":[{"id":"spn-97399","text":"AGM-style belief management — expand, revise, or contract beliefs with automatic contradiction detection and confidence propagation."}]},{"id":"blk-66895","kind":"heading","level":2,"spans":[{"id":"spn-97400","text":"Arguments"}]},{"id":"blk-66896","kind":"paragraph","spans":[{"id":"spn-97401","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-66897","kind":"heading","level":2,"spans":[{"id":"spn-97402","text":"Operations"}]},{"id":"blk-66898","kind":"heading","level":3,"spans":[{"id":"spn-97403","text":"Expand — Add a New Belief"}]},{"id":"blk-66899","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"expand\", content: \"New fact here\", confidence: 0.8)"},{"id":"blk-66900","kind":"paragraph","spans":[{"id":"spn-97404","text":"Automatically checks for contradictions. Creates bidirectional "},{"id":"spn-97405","marks":["code"],"text":":contradicts"},{"id":"spn-97406","text":" edges if found (forming kappa=1 SCCs)."}]},{"id":"blk-66901","kind":"heading","level":3,"spans":[{"id":"spn-97407","text":"Revise — Replace a Wrong Belief"}]},{"id":"blk-66902","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"revise\", node_id: \"<old_node>\", content: \"Corrected fact\", rationale: \"why\")"},{"id":"blk-66903","kind":"paragraph","spans":[{"id":"spn-97408","text":"Creates new node, supersedes old (confidence -> 30%), propagates 0.6x decay through dependents."}]},{"id":"blk-66904","kind":"heading","level":3,"spans":[{"id":"spn-97409","text":"Contract — Withdraw Without Replacement"}]},{"id":"blk-66905","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"contract\", node_id: \"<wrong_node>\", rationale: \"why\")"},{"id":"blk-66906","kind":"paragraph","spans":[{"id":"spn-97410","text":"Sets confidence to 0.05, propagates decay. Node preserved for provenance."}]},{"id":"blk-66907","kind":"heading","level":2,"spans":[{"id":"spn-97411","text":"Detect Contradictions"}]},{"id":"blk-66908","kind":"code","language":"text","text":"learn(action: \"contradictions\", content: \"<new info>\")\nlearn(action: \"contradictions\", node_id: \"<existing_node>\")"},{"id":"blk-66909","kind":"paragraph","spans":[{"id":"spn-97412","text":"Returns detected conflicts with similarity scores and negation markers."}]},{"id":"blk-66910","kind":"heading","level":2,"spans":[{"id":"spn-97413","text":"Workflow"}]},{"id":"blk-66911","items":[{"blocks":[{"id":"blk-66913","kind":"paragraph","spans":[{"id":"spn-97414","marks":["code"],"text":"learn(action: \"contradictions\", content: \"<new info>\")"},{"id":"spn-97415","text":" — check first"}]}],"id":"blk-66912","kind":"list-item"},{"blocks":[{"id":"blk-66915","kind":"paragraph","spans":[{"id":"spn-97416","text":"Assess: is the contradiction real?"}]}],"id":"blk-66914","kind":"list-item"},{"blocks":[{"id":"blk-66917","kind":"paragraph","spans":[{"id":"spn-97417","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"revise|contract|expand\")"},{"id":"spn-97418","text":" — act"}]}],"id":"blk-66916","kind":"list-item"},{"blocks":[{"id":"blk-66919","kind":"paragraph","spans":[{"id":"spn-97419","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-97420","text":" — check for new cycles"}]}],"id":"blk-66918","kind":"list-item"},{"blocks":[{"id":"blk-66921","kind":"paragraph","spans":[{"id":"spn-97421","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-97422","text":" — if kappa > 0 on affected region"}]}],"id":"blk-66920","kind":"list-item"},{"blocks":[{"id":"blk-66923","kind":"paragraph","spans":[{"id":"spn-97423","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-97424","text":" — report the revision result"}]}],"id":"blk-66922","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-66924","kind":"heading","level":2,"spans":[{"id":"spn-97425","text":"Key Rules"}]},{"id":"blk-66925","items":[{"blocks":[{"id":"blk-66927","kind":"paragraph","spans":[{"id":"spn-97426","text":"Always check contradictions before revising"}]}],"id":"blk-66926","kind":"list-item"},{"blocks":[{"id":"blk-66929","kind":"paragraph","spans":[{"id":"spn-97427","text":"Use "},{"id":"spn-97428","marks":["code"],"text":"revise"},{"id":"spn-97429","text":" when old is wrong (not "},{"id":"spn-97430","marks":["code"],"text":"expand"},{"id":"spn-97431","text":" — that creates contradictions)"}]}],"id":"blk-66928","kind":"list-item"},{"blocks":[{"id":"blk-66931","kind":"paragraph","spans":[{"id":"spn-97432","text":"Use "},{"id":"spn-97433","marks":["code"],"text":"contract"},{"id":"spn-97434","text":" when wrong but no replacement available"}]}],"id":"blk-66930","kind":"list-item"},{"blocks":[{"id":"blk-66933","kind":"paragraph","spans":[{"id":"spn-97435","text":"Review "},{"id":"spn-97436","marks":["code"],"text":"affected_node_ids"},{"id":"spn-97437","text":" after revision to assess cascade impact"}]}],"id":"blk-66932","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66934","kind":"heading","level":2,"spans":[{"id":"spn-97438","text":"Anti-patterns to avoid"}]},{"id":"blk-66935","items":[{"blocks":[{"id":"blk-66937","kind":"paragraph","spans":[{"id":"spn-97439","text":"Expanding without checking for contradictions first"}]}],"id":"blk-66936","kind":"list-item"},{"blocks":[{"id":"blk-66939","kind":"paragraph","spans":[{"id":"spn-97440","text":"Using "},{"id":"spn-97441","marks":["code"],"text":"contract"},{"id":"spn-97442","text":" when you have a correction (use "},{"id":"spn-97443","marks":["code"],"text":"revise"},{"id":"spn-97444","text":" instead)"}]}],"id":"blk-66938","kind":"list-item"},{"blocks":[{"id":"blk-66941","kind":"paragraph","spans":[{"id":"spn-97445","text":"Ignoring cascade effects on dependent nodes"}]}],"id":"blk-66940","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieradttod5yafc7ae6jf7n3rok4zpduoutwq47fb7tcy5uvnaqgbsdwq","vocabulary":"ampersand.docs.fs.v1"}