{"bendscript":"0.1","blocks":[{"id":"blk-67030","kind":"heading","level":1,"spans":[{"id":"spn-97599","text":"Belief Revision"}]},{"id":"blk-67031","kind":"paragraph","spans":[{"id":"spn-97600","text":"AGM-style belief management — expand, revise, or contract beliefs with automatic contradiction detection and confidence propagation."}]},{"id":"blk-67032","kind":"heading","level":2,"spans":[{"id":"spn-97601","text":"Arguments"}]},{"id":"blk-67033","kind":"paragraph","spans":[{"id":"spn-97602","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-67034","kind":"heading","level":2,"spans":[{"id":"spn-97603","text":"Operations"}]},{"id":"blk-67035","kind":"heading","level":3,"spans":[{"id":"spn-97604","text":"Expand — Add a New Belief"}]},{"id":"blk-67036","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"expand\", content: \"New fact here\", confidence: 0.8)"},{"id":"blk-67037","kind":"paragraph","spans":[{"id":"spn-97605","text":"Automatically checks for contradictions. Creates bidirectional "},{"id":"spn-97606","marks":["code"],"text":":contradicts"},{"id":"spn-97607","text":" edges if found (forming kappa=1 SCCs)."}]},{"id":"blk-67038","kind":"heading","level":3,"spans":[{"id":"spn-97608","text":"Revise — Replace a Wrong Belief"}]},{"id":"blk-67039","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"revise\", node_id: \"<old_node>\", content: \"Corrected fact\", rationale: \"why\")"},{"id":"blk-67040","kind":"paragraph","spans":[{"id":"spn-97609","text":"Creates new node, supersedes old (confidence -> 30%), propagates 0.6x decay through dependents."}]},{"id":"blk-67041","kind":"heading","level":3,"spans":[{"id":"spn-97610","text":"Contract — Withdraw Without Replacement"}]},{"id":"blk-67042","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"contract\", node_id: \"<wrong_node>\", rationale: \"why\")"},{"id":"blk-67043","kind":"paragraph","spans":[{"id":"spn-97611","text":"Sets confidence to 0.05, propagates decay. Node preserved for provenance."}]},{"id":"blk-67044","kind":"heading","level":2,"spans":[{"id":"spn-97612","text":"Detect Contradictions"}]},{"id":"blk-67045","kind":"code","language":"text","text":"learn(action: \"contradictions\", content: \"<new info>\")\nlearn(action: \"contradictions\", node_id: \"<existing_node>\")"},{"id":"blk-67046","kind":"paragraph","spans":[{"id":"spn-97613","text":"Returns detected conflicts with similarity scores and negation markers."}]},{"id":"blk-67047","kind":"heading","level":2,"spans":[{"id":"spn-97614","text":"Workflow"}]},{"id":"blk-67048","items":[{"blocks":[{"id":"blk-67050","kind":"paragraph","spans":[{"id":"spn-97615","marks":["code"],"text":"learn(action: \"contradictions\", content: \"<new info>\")"},{"id":"spn-97616","text":" — check first"}]}],"id":"blk-67049","kind":"list-item"},{"blocks":[{"id":"blk-67052","kind":"paragraph","spans":[{"id":"spn-97617","text":"Assess: is the contradiction real?"}]}],"id":"blk-67051","kind":"list-item"},{"blocks":[{"id":"blk-67054","kind":"paragraph","spans":[{"id":"spn-97618","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"revise|contract|expand\")"},{"id":"spn-97619","text":" — act"}]}],"id":"blk-67053","kind":"list-item"},{"blocks":[{"id":"blk-67056","kind":"paragraph","spans":[{"id":"spn-97620","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-97621","text":" — check for new cycles"}]}],"id":"blk-67055","kind":"list-item"},{"blocks":[{"id":"blk-67058","kind":"paragraph","spans":[{"id":"spn-97622","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-97623","text":" — if kappa > 0 on affected region"}]}],"id":"blk-67057","kind":"list-item"},{"blocks":[{"id":"blk-67060","kind":"paragraph","spans":[{"id":"spn-97624","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-97625","text":" — report the revision result"}]}],"id":"blk-67059","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67061","kind":"heading","level":2,"spans":[{"id":"spn-97626","text":"Key Rules"}]},{"id":"blk-67062","items":[{"blocks":[{"id":"blk-67064","kind":"paragraph","spans":[{"id":"spn-97627","text":"Always check contradictions before revising"}]}],"id":"blk-67063","kind":"list-item"},{"blocks":[{"id":"blk-67066","kind":"paragraph","spans":[{"id":"spn-97628","text":"Use "},{"id":"spn-97629","marks":["code"],"text":"revise"},{"id":"spn-97630","text":" when old is wrong (not "},{"id":"spn-97631","marks":["code"],"text":"expand"},{"id":"spn-97632","text":" — that creates contradictions)"}]}],"id":"blk-67065","kind":"list-item"},{"blocks":[{"id":"blk-67068","kind":"paragraph","spans":[{"id":"spn-97633","text":"Use "},{"id":"spn-97634","marks":["code"],"text":"contract"},{"id":"spn-97635","text":" when wrong but no replacement available"}]}],"id":"blk-67067","kind":"list-item"},{"blocks":[{"id":"blk-67070","kind":"paragraph","spans":[{"id":"spn-97636","text":"Review "},{"id":"spn-97637","marks":["code"],"text":"affected_node_ids"},{"id":"spn-97638","text":" after revision to assess cascade impact"}]}],"id":"blk-67069","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67071","kind":"heading","level":2,"spans":[{"id":"spn-97639","text":"Anti-patterns to avoid"}]},{"id":"blk-67072","items":[{"blocks":[{"id":"blk-67074","kind":"paragraph","spans":[{"id":"spn-97640","text":"Expanding without checking for contradictions first"}]}],"id":"blk-67073","kind":"list-item"},{"blocks":[{"id":"blk-67076","kind":"paragraph","spans":[{"id":"spn-97641","text":"Using "},{"id":"spn-97642","marks":["code"],"text":"contract"},{"id":"spn-97643","text":" when you have a correction (use "},{"id":"spn-97644","marks":["code"],"text":"revise"},{"id":"spn-97645","text":" instead)"}]}],"id":"blk-67075","kind":"list-item"},{"blocks":[{"id":"blk-67078","kind":"paragraph","spans":[{"id":"spn-97646","text":"Ignoring cascade effects on dependent nodes"}]}],"id":"blk-67077","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieras2vetz5s5xm7nv5boayet3zezpnqik3bax2v4gjb24uoajdthadq","vocabulary":"ampersand.docs.fs.v1"}