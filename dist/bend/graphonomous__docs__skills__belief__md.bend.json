{"bendscript":"0.1","blocks":[{"id":"blk-74387","kind":"heading","level":1,"spans":[{"id":"spn-136962","text":"Belief Revision"}]},{"id":"blk-74388","kind":"paragraph","spans":[{"id":"spn-136963","text":"AGM-style belief management — expand, revise, or contract beliefs with automatic contradiction detection and confidence propagation."}]},{"id":"blk-74389","kind":"heading","level":2,"spans":[{"id":"spn-136964","text":"Arguments"}]},{"id":"blk-74390","kind":"paragraph","spans":[{"id":"spn-136965","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-74391","kind":"heading","level":2,"spans":[{"id":"spn-136966","text":"Operations"}]},{"id":"blk-74392","kind":"heading","level":3,"spans":[{"id":"spn-136967","text":"Expand — Add a New Belief"}]},{"id":"blk-74393","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"expand\", content: \"New fact here\", confidence: 0.8)"},{"id":"blk-74394","kind":"paragraph","spans":[{"id":"spn-136968","text":"Automatically checks for contradictions. Creates bidirectional "},{"id":"spn-136969","marks":["code"],"text":":contradicts"},{"id":"spn-136970","text":" edges if found (forming kappa=1 SCCs)."}]},{"id":"blk-74395","kind":"heading","level":3,"spans":[{"id":"spn-136971","text":"Revise — Replace a Wrong Belief"}]},{"id":"blk-74396","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"revise\", node_id: \"<old_node>\", content: \"Corrected fact\", rationale: \"why\")"},{"id":"blk-74397","kind":"paragraph","spans":[{"id":"spn-136972","text":"Creates new node, supersedes old (confidence -> 30%), propagates 0.6x decay through dependents."}]},{"id":"blk-74398","kind":"heading","level":3,"spans":[{"id":"spn-136973","text":"Contract — Withdraw Without Replacement"}]},{"id":"blk-74399","kind":"code","language":"text","text":"act(action: \"belief_revise\", operation: \"contract\", node_id: \"<wrong_node>\", rationale: \"why\")"},{"id":"blk-74400","kind":"paragraph","spans":[{"id":"spn-136974","text":"Sets confidence to 0.05, propagates decay. Node preserved for provenance."}]},{"id":"blk-74401","kind":"heading","level":2,"spans":[{"id":"spn-136975","text":"Detect Contradictions"}]},{"id":"blk-74402","kind":"code","language":"text","text":"learn(action: \"contradictions\", content: \"<new info>\")\nlearn(action: \"contradictions\", node_id: \"<existing_node>\")"},{"id":"blk-74403","kind":"paragraph","spans":[{"id":"spn-136976","text":"Returns detected conflicts with similarity scores and negation markers."}]},{"id":"blk-74404","kind":"heading","level":2,"spans":[{"id":"spn-136977","text":"Workflow"}]},{"id":"blk-74405","items":[{"blocks":[{"id":"blk-74407","kind":"paragraph","spans":[{"id":"spn-136978","marks":["code"],"text":"learn(action: \"contradictions\", content: \"<new info>\")"},{"id":"spn-136979","text":" — check first"}]}],"id":"blk-74406","kind":"list-item"},{"blocks":[{"id":"blk-74409","kind":"paragraph","spans":[{"id":"spn-136980","text":"Assess: is the contradiction real?"}]}],"id":"blk-74408","kind":"list-item"},{"blocks":[{"id":"blk-74411","kind":"paragraph","spans":[{"id":"spn-136981","marks":["code"],"text":"act(action: \"belief_revise\", operation: \"revise|contract|expand\")"},{"id":"spn-136982","text":" — act"}]}],"id":"blk-74410","kind":"list-item"},{"blocks":[{"id":"blk-74413","kind":"paragraph","spans":[{"id":"spn-136983","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-136984","text":" — check for new cycles"}]}],"id":"blk-74412","kind":"list-item"},{"blocks":[{"id":"blk-74415","kind":"paragraph","spans":[{"id":"spn-136985","marks":["code"],"text":"route(action: \"deliberate\", ...)"},{"id":"spn-136986","text":" — if kappa > 0 on affected region"}]}],"id":"blk-74414","kind":"list-item"},{"blocks":[{"id":"blk-74417","kind":"paragraph","spans":[{"id":"spn-136987","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-136988","text":" — report the revision result"}]}],"id":"blk-74416","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74418","kind":"heading","level":2,"spans":[{"id":"spn-136989","text":"Key Rules"}]},{"id":"blk-74419","items":[{"blocks":[{"id":"blk-74421","kind":"paragraph","spans":[{"id":"spn-136990","text":"Always check contradictions before revising"}]}],"id":"blk-74420","kind":"list-item"},{"blocks":[{"id":"blk-74423","kind":"paragraph","spans":[{"id":"spn-136991","text":"Use "},{"id":"spn-136992","marks":["code"],"text":"revise"},{"id":"spn-136993","text":" when old is wrong (not "},{"id":"spn-136994","marks":["code"],"text":"expand"},{"id":"spn-136995","text":" — that creates contradictions)"}]}],"id":"blk-74422","kind":"list-item"},{"blocks":[{"id":"blk-74425","kind":"paragraph","spans":[{"id":"spn-136996","text":"Use "},{"id":"spn-136997","marks":["code"],"text":"contract"},{"id":"spn-136998","text":" when wrong but no replacement available"}]}],"id":"blk-74424","kind":"list-item"},{"blocks":[{"id":"blk-74427","kind":"paragraph","spans":[{"id":"spn-136999","text":"Review "},{"id":"spn-137000","marks":["code"],"text":"affected_node_ids"},{"id":"spn-137001","text":" after revision to assess cascade impact"}]}],"id":"blk-74426","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74428","kind":"heading","level":2,"spans":[{"id":"spn-137002","text":"Anti-patterns to avoid"}]},{"id":"blk-74429","items":[{"blocks":[{"id":"blk-74431","kind":"paragraph","spans":[{"id":"spn-137003","text":"Expanding without checking for contradictions first"}]}],"id":"blk-74430","kind":"list-item"},{"blocks":[{"id":"blk-74433","kind":"paragraph","spans":[{"id":"spn-137004","text":"Using "},{"id":"spn-137005","marks":["code"],"text":"contract"},{"id":"spn-137006","text":" when you have a correction (use "},{"id":"spn-137007","marks":["code"],"text":"revise"},{"id":"spn-137008","text":" instead)"}]}],"id":"blk-74432","kind":"list-item"},{"blocks":[{"id":"blk-74435","kind":"paragraph","spans":[{"id":"spn-137009","text":"Ignoring cascade effects on dependent nodes"}]}],"id":"blk-74434","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraheymjsg4zqenah7dqi6sgj6xls4m5vxxynaryiy4z7jghazvusgq","vocabulary":"ampersand.docs.fs.v1"}