{"bendscript":"0.1","blocks":[{"id":"blk-69233","kind":"heading","level":1,"spans":[{"id":"spn-130756","text":"GeoFleetic — Spatial Intelligence Layer"}]},{"id":"blk-69234","kind":"paragraph","spans":[{"id":"spn-130757","text":"Geo-distributed fleet intelligence collaboration. The "},{"id":"spn-130758","marks":["code"],"text":"&space"},{"id":"spn-130759","text":" primitive provider for the [&] Protocol ecosystem."}]},{"id":"blk-69235","kind":"heading","level":2,"spans":[{"id":"spn-130760","text":"Source-of-truth spec"}]},{"id":"blk-69236","items":[{"blocks":[{"id":"blk-69238","kind":"paragraph","spans":[{"id":"spn-130761","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-130762","text":" — GeoFleetic technical specification"}]}],"id":"blk-69237","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69239","kind":"heading","level":2,"spans":[{"id":"spn-130763","text":"[&] Capabilities provided"}]},{"head":[{"id":"blk-69241","spans":[{"id":"spn-130764","text":"Capability"}]},{"id":"blk-69242","spans":[{"id":"spn-130765","text":"Contract"}]},{"id":"blk-69243","spans":[{"id":"spn-130766","text":"Operations"}]}],"id":"blk-69240","kind":"table","rows":[[{"id":"blk-69244","spans":[{"id":"spn-130767","marks":["code"],"text":"&space.fleet"}]},{"id":"blk-69245","spans":[{"id":"spn-130768","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/space.fleet.contract.json"}]},{"id":"blk-69246","spans":[{"id":"spn-130769","text":"locate, enrich, capacity, route"}]}],[{"id":"blk-69247","spans":[{"id":"spn-130770","marks":["code"],"text":"&space.route"}]},{"id":"blk-69248","spans":[{"id":"spn-130771","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/space.route.contract.json"}]},{"id":"blk-69249","spans":[{"id":"spn-130772","text":"route, optimize, explain"}]}],[{"id":"blk-69250","spans":[{"id":"spn-130773","marks":["code"],"text":"&space.geofence"}]},{"id":"blk-69251","spans":[{"id":"spn-130774","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/space.geofence.contract.json"}]},{"id":"blk-69252","spans":[{"id":"spn-130775","text":"contains, enter_exit, enrich"}]}]]},{"id":"blk-69253","kind":"heading","level":2,"spans":[{"id":"spn-130776","text":"Key technologies"}]},{"id":"blk-69254","items":[{"blocks":[{"id":"blk-69256","kind":"paragraph","spans":[{"id":"spn-130777","text":"Epoch-aware delta-CRDTs for convergent fleet state"}]}],"id":"blk-69255","kind":"list-item"},{"blocks":[{"id":"blk-69258","kind":"paragraph","spans":[{"id":"spn-130778","text":"Federated continual learning (LoRA adapters, no raw data sharing)"}]}],"id":"blk-69257","kind":"list-item"},{"blocks":[{"id":"blk-69260","kind":"paragraph","spans":[{"id":"spn-130779","text":"Spatial digital twins (IEEE COMST 2025 research)"}]}],"id":"blk-69259","kind":"list-item"},{"blocks":[{"id":"blk-69262","kind":"paragraph","spans":[{"id":"spn-130780","text":"GNN route optimization with continual spatial learning"}]}],"id":"blk-69261","kind":"list-item"},{"blocks":[{"id":"blk-69264","kind":"paragraph","spans":[{"id":"spn-130781","text":"MCP + A2A agent protocols"}]}],"id":"blk-69263","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69265","kind":"heading","level":2,"spans":[{"id":"spn-130782","text":"Paired with"}]},{"id":"blk-69266","items":[{"blocks":[{"id":"blk-69268","kind":"paragraph","spans":[{"id":"spn-130783","marks":["bold"],"text":"TickTickClock"},{"id":"spn-130784","text":" — temporal intelligence (when + where = complete situational awareness)"}]}],"id":"blk-69267","kind":"list-item"},{"blocks":[{"id":"blk-69270","kind":"paragraph","spans":[{"id":"spn-130785","marks":["bold"],"text":"Graphonomous"},{"id":"spn-130786","text":" — continual learning substrate"}]}],"id":"blk-69269","kind":"list-item"},{"blocks":[{"id":"blk-69272","kind":"paragraph","spans":[{"id":"spn-130787","marks":["bold"],"text":"Delegatic"},{"id":"spn-130788","text":" — governance enforcement for fleet operations"}]}],"id":"blk-69271","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69273","kind":"heading","level":2,"spans":[{"id":"spn-130789","text":"Status"}]},{"id":"blk-69274","kind":"paragraph","spans":[{"id":"spn-130790","text":"This is a spec site. "},{"id":"spn-130791","marks":["bold"],"text":"No implementation code — none, anywhere."},{"id":"spn-130792","text":" "},{"id":"spn-130793","marks":["code"],"text":"build-site.mjs"},{"id":"spn-130794","text":" recounts that on every run ("},{"id":"spn-130795","marks":["code"],"text":".ex"},{"id":"spn-130796","text":"/"},{"id":"spn-130797","marks":["code"],"text":".exs"},{"id":"spn-130798","text":" lines outside "},{"id":"spn-130799","marks":["code"],"text":"old_scrap/"},{"id":"spn-130800","text":") and the page publishes the number. Implementation will be Elixir/OTP when it starts; the nearest honest first step is the spec's own "},{"id":"spn-130801","marks":["bold"],"text":"FV-1"},{"id":"spn-130802","text":", the delta-CRDT convergence prototype, and it has not been started."}]},{"id":"blk-69275","kind":"heading","level":2,"spans":[{"id":"spn-130803","text":"The landing page is GENERATED. Do not hand-edit "},{"id":"spn-130804","marks":["code"],"text":"index.html"},{"id":"spn-130805","text":"."}]},{"id":"blk-69276","kind":"paragraph","spans":[{"id":"spn-130806","marks":["code"],"text":"/index.html"},{"id":"spn-130807","text":", "},{"id":"spn-130808","marks":["code"],"text":"/fences.js"},{"id":"spn-130809","text":" and "},{"id":"spn-130810","marks":["code"],"text":"/say.js"},{"id":"spn-130811","text":" are emitted by "},{"id":"spn-130812","marks":["code"],"text":"build-site.mjs"},{"id":"spn-130813","text":" from "},{"id":"spn-130814","marks":["code"],"text":"records/surface.json"},{"id":"spn-130815","text":", "},{"id":"spn-130816","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-130817","text":", "},{"id":"spn-130818","marks":["code"],"text":"records/contracts/*.contract.json"},{"id":"spn-130819","text":", "},{"id":"spn-130820","marks":["code"],"text":"src/landing.html"},{"id":"spn-130821","text":", "},{"id":"spn-130822","marks":["code"],"text":"src/shell.css"},{"id":"spn-130823","text":", "},{"id":"spn-130824","marks":["code"],"text":"src/fences.js"},{"id":"spn-130825","text":" and "},{"id":"spn-130826","marks":["code"],"text":"src/say.js"},{"id":"spn-130827","text":". "},{"id":"spn-130828","marks":["bold"],"text":"An edit to the served HTML is reverted by the next build — and refused before that"},{"id":"spn-130829","text":", because "},{"id":"spn-130830","marks":["code"],"text":"records/build.json"},{"id":"spn-130831","text":" fingerprints every input and hashes every emitted artifact. Change the record or the template."}]},{"id":"blk-69277","kind":"code","language":"text","text":"npm run test:launch   # re-derive the facts, emit the site, run the gate"},{"id":"blk-69278","kind":"paragraph","spans":[{"id":"spn-130832","marks":["code"],"text":"launch-gate.mjs"},{"id":"spn-130833","text":" reads the emitted artifact and refuses to publish when it and the records disagree: a retracted claim reinstated anywhere outside the retraction, a rung invented, a CTA the "},{"id":"spn-130834","marks":["code"],"text":"spec"},{"id":"spn-130835","text":" rung has not earned, a "},{"id":"spn-130836","marks":["code"],"text":"§N"},{"id":"spn-130837","text":" that resolves to no heading, an unrendered token, a "},{"id":"spn-130838","marks":["code"],"text":"mailto:"},{"id":"spn-130839","text":", a text token below 4.5:1, a same-origin link that resolves to nothing, a stale or hand-edited artifact, or an identifying-animation constant leaking into the copy. "},{"id":"spn-130840","marks":["bold"],"text":"It has been made to refuse 22 times deliberately, against a throwaway copy, with an unmodified control run first"},{"id":"spn-130841","text":" — the control matters: the first run of that harness reported 20 refusals that were all refusing for an unrelated reason."}]},{"id":"blk-69279","kind":"paragraph","spans":[{"id":"spn-130842","text":"Do not hand-type the check count anywhere; the gate prints its own total."}]},{"id":"blk-69280","kind":"paragraph","spans":[{"id":"spn-130843","text":"Two checks are newer than the rest and are the ones to understand first:"}]},{"id":"blk-69281","items":[{"blocks":[{"id":"blk-69283","kind":"paragraph","spans":[{"id":"spn-130844","marks":["bold"],"text":"The cascade resolver"},{"id":"spn-130845","text":" (SHELL.md r7/r8). Every contrast check reads a"}]}],"id":"blk-69282","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69284","kind":"paragraph","spans":[{"id":"spn-130846","marks":["italic"],"text":"declared"},{"id":"spn-130847","text":" token, and r7's header-CTA defect — "},{"id":"spn-130848","marks":["code"],"text":".top nav a"},{"id":"spn-130849","text":" (0,2,1) beating "},{"id":"spn-130850","marks":["code"],"text":".btn"},{"id":"spn-130851","text":" (0,1,0), so the button painted "},{"id":"spn-130852","marks":["code"],"text":"--fg2"},{"id":"spn-130853","text":" on the accent — passed all of them for as long as it shipped on nine surfaces. The gate now parses the emitted markup into elements with their ancestor chains, parses the emitted stylesheet with specificity, source order, "},{"id":"spn-130854","marks":["code"],"text":"!important"},{"id":"spn-130855","text":" and "},{"id":"spn-130856","marks":["code"],"text":"@media"},{"id":"spn-130857","text":", and resolves "},{"id":"spn-130858","marks":["code"],"text":"color"},{"id":"spn-130859","text":" for every button at 390px and 1280px, hovered and not. Cross-checked against the browser's own computed styles for all four buttons: they agreed. It also resolves "},{"id":"spn-130860","marks":["code"],"text":"min-height"},{"id":"spn-130861","text":" on the animation panel, because §8 placement is a computed height and not a string in a stylesheet."}]},{"id":"blk-69285","items":[{"blocks":[{"id":"blk-69287","kind":"paragraph","spans":[{"id":"spn-130862","marks":["bold"],"text":"Comment stripping is its own pass"},{"id":"spn-130863","text":" (SHELL.md r8), and the page text is"}]}],"id":"blk-69286","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69288","kind":"paragraph","spans":[{"id":"spn-130864","text":"built by SPLITTING on tags rather than replacing them with a space. "},{"id":"spn-130865","marks":["code"],"text":"<[^>]+>"},{"id":"spn-130866","text":" stops at the first "},{"id":"spn-130867","marks":["code"],"text":">"},{"id":"spn-130868","text":", so a comment containing one leaks its remainder into \"page text\"; and replace-then-split-on-spaces shreds every text node into single words, which made every multi-word rule — including \"no signup at the "},{"id":"spn-130869","marks":["code"],"text":"spec"},{"id":"spn-130870","text":" rung\" — silently unfalsifiable until a deliberate break failed to fire. The gate proves its own extractor on every run: "},{"id":"spn-130871","marks":["code"],"text":"SHELL.md"},{"id":"spn-130872","text":" appears in this page's source comments and in none of its text nodes."}]},{"id":"blk-69289","kind":"paragraph","spans":[{"id":"spn-130873","marks":["bold"],"text":"The band says \"a specification in the ComputeDriven world\", not \"the spatial layer of ComputeDriven\", and that is deliberate."},{"id":"spn-130874","text":" "},{"id":"spn-130875","marks":["code"],"text":"ampersand-nav"},{"id":"spn-130876","text":" records geofleetic as "},{"id":"spn-130877","marks":["code"],"text":"place: 3"},{"id":"spn-130878","text":", and its own "},{"id":"spn-130879","marks":["code"],"text":"renderPlacement()"},{"id":"spn-130880","text":" gives the layer sentence to "},{"id":"spn-130881","marks":["code"],"text":"place: 2"},{"id":"spn-130882","text":" only; place 3 gets the specification sentence plus a spec link, place 4 gets attribution alone. Three variants, not two."}]}],"edges":[],"id":"bagaaieralxtxnjdbuzfb7jjrf2gxr4v2ho5hrj5o7txe54ppsoqf77stwmha","vocabulary":"ampersand.docs.fs.v1"}