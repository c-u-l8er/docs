{"bendscript":"0.1","blocks":[{"id":"blk-67464","kind":"heading","level":1,"spans":[{"id":"spn-98118","text":"Graph Health Check"}]},{"id":"blk-67465","kind":"paragraph","spans":[{"id":"spn-98119","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-67466","kind":"heading","level":2,"spans":[{"id":"spn-98120","text":"Arguments"}]},{"id":"blk-67467","kind":"paragraph","spans":[{"id":"spn-98121","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-67468","items":[{"blocks":[{"id":"blk-67470","kind":"paragraph","spans":[{"id":"spn-98122","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-67469","kind":"list-item"},{"blocks":[{"id":"blk-67472","kind":"paragraph","spans":[{"id":"spn-98123","marks":["code"],"text":"--full"},{"id":"spn-98124","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-67471","kind":"list-item"},{"blocks":[{"id":"blk-67474","kind":"paragraph","spans":[{"id":"spn-98125","marks":["code"],"text":"--fix"},{"id":"spn-98126","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-67473","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67475","kind":"heading","level":2,"spans":[{"id":"spn-98127","text":"Quick Health Check"}]},{"id":"blk-67476","kind":"heading","level":3,"spans":[{"id":"spn-98128","text":"Step 1 — Graph stats"}]},{"id":"blk-67477","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-67478","kind":"paragraph","spans":[{"id":"spn-98129","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-67479","kind":"heading","level":3,"spans":[{"id":"spn-98130","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-67481","spans":[{"id":"spn-98131","text":"Metric"}]},{"id":"blk-67482","spans":[{"id":"spn-98132","text":"Healthy"}]},{"id":"blk-67483","spans":[{"id":"spn-98133","text":"Warning"}]},{"id":"blk-67484","spans":[{"id":"spn-98134","text":"Critical"}]}],"id":"blk-67480","kind":"table","rows":[[{"id":"blk-67485","spans":[{"id":"spn-98135","text":"Orphan ratio"}]},{"id":"blk-67486","spans":[{"id":"spn-98136","text":"< 10%"}]},{"id":"blk-67487","spans":[{"id":"spn-98137","text":"10–30%"}]},{"id":"blk-67488","spans":[{"id":"spn-98138","text":"> 30%"}]}],[{"id":"blk-67489","spans":[{"id":"spn-98139","text":"Mean confidence"}]},{"id":"blk-67490","spans":[{"id":"spn-98140","text":"> 0.5"}]},{"id":"blk-67491","spans":[{"id":"spn-98141","text":"0.3–0.5"}]},{"id":"blk-67492","spans":[{"id":"spn-98142","text":"< 0.3"}]}],[{"id":"blk-67493","spans":[{"id":"spn-98143","text":"Edge/node ratio"}]},{"id":"blk-67494","spans":[{"id":"spn-98144","text":"> 1.5"}]},{"id":"blk-67495","spans":[{"id":"spn-98145","text":"0.5–1.5"}]},{"id":"blk-67496","spans":[{"id":"spn-98146","text":"< 0.5"}]}],[{"id":"blk-67497","spans":[{"id":"spn-98147","text":"Confidence std_dev"}]},{"id":"blk-67498","spans":[{"id":"spn-98148","text":"< 0.25"}]},{"id":"blk-67499","spans":[{"id":"spn-98149","text":"0.25–0.35"}]},{"id":"blk-67500","spans":[{"id":"spn-98150","text":"> 0.35"}]}]]},{"id":"blk-67501","kind":"paragraph","spans":[{"id":"spn-98151","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-67503","kind":"paragraph","spans":[{"id":"spn-98152","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-98153","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-67502","kind":"quote"},{"id":"blk-67504","kind":"heading","level":2,"spans":[{"id":"spn-98154","text":"Full Audit (--full)"}]},{"id":"blk-67505","kind":"heading","level":3,"spans":[{"id":"spn-98155","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-67506","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-67507","kind":"paragraph","spans":[{"id":"spn-98156","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-67508","kind":"heading","level":3,"spans":[{"id":"spn-98157","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-67509","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-67510","kind":"paragraph","spans":[{"id":"spn-98158","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-67511","kind":"heading","level":3,"spans":[{"id":"spn-98159","text":"Step 5 — Check for staleness"}]},{"id":"blk-67512","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-67513","kind":"paragraph","spans":[{"id":"spn-98160","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-67514","kind":"heading","level":3,"spans":[{"id":"spn-98161","text":"Step 6 — Orphan details"}]},{"id":"blk-67515","kind":"paragraph","spans":[{"id":"spn-98162","text":"If orphan count > 10%, list them:"}]},{"id":"blk-67516","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-67517","kind":"paragraph","spans":[{"id":"spn-98163","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-67518","kind":"heading","level":2,"spans":[{"id":"spn-98164","text":"Auto-Fix (--fix)"}]},{"id":"blk-67519","kind":"paragraph","spans":[{"id":"spn-98165","text":"When "},{"id":"spn-98166","marks":["code"],"text":"--fix"},{"id":"spn-98167","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-67520","kind":"heading","level":3,"spans":[{"id":"spn-98168","text":"Fix orphans — connect or prune"}]},{"id":"blk-67521","kind":"paragraph","spans":[{"id":"spn-98169","text":"For each orphan node:"}]},{"id":"blk-67522","items":[{"blocks":[{"id":"blk-67524","kind":"paragraph","spans":[{"id":"spn-98170","text":"Search for related nodes: "},{"id":"spn-98171","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"}]}],"id":"blk-67523","kind":"list-item"},{"blocks":[{"id":"blk-67526","kind":"paragraph","spans":[{"id":"spn-98172","text":"If similarity > 0.5 with any node → create "},{"id":"spn-98173","marks":["code"],"text":"related_to"},{"id":"spn-98174","text":" edge"}]}],"id":"blk-67525","kind":"list-item"},{"blocks":[{"id":"blk-67528","kind":"paragraph","spans":[{"id":"spn-98175","text":"If no matches and confidence < 0.3 → prune: "},{"id":"spn-98176","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-67527","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67529","kind":"heading","level":3,"spans":[{"id":"spn-98177","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-67530","kind":"paragraph","spans":[{"id":"spn-98178","text":"For nodes with confidence < 0.2:"}]},{"id":"blk-67531","items":[{"blocks":[{"id":"blk-67533","kind":"paragraph","spans":[{"id":"spn-98179","text":"Check if still relevant (search for supporting context)"}]}],"id":"blk-67532","kind":"list-item"},{"blocks":[{"id":"blk-67535","kind":"paragraph","spans":[{"id":"spn-98180","text":"If supporting evidence exists → "},{"id":"spn-98181","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"}]}],"id":"blk-67534","kind":"list-item"},{"blocks":[{"id":"blk-67537","kind":"paragraph","spans":[{"id":"spn-98182","text":"If no support → "},{"id":"spn-98183","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-67536","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67538","kind":"heading","level":3,"spans":[{"id":"spn-98184","text":"Fix staleness — flag for sync"}]},{"id":"blk-67539","kind":"paragraph","spans":[{"id":"spn-98185","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-98186","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-98187","text":" to ingest recent filesystem changes."}]},{"id":"blk-67540","kind":"heading","level":2,"spans":[{"id":"spn-98188","text":"Health Report Format"}]},{"id":"blk-67541","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-67542","kind":"heading","level":2,"spans":[{"id":"spn-98189","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-67544","spans":[{"id":"spn-98190","text":"Situation"}]},{"id":"blk-67545","spans":[{"id":"spn-98191","text":"Follow-up"}]}],"id":"blk-67543","kind":"table","rows":[[{"id":"blk-67546","spans":[{"id":"spn-98192","text":"High orphan count"}]},{"id":"blk-67547","spans":[{"id":"spn-98193","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-98194","text":" to rebuild edges"}]}],[{"id":"blk-67548","spans":[{"id":"spn-98195","text":"Low mean confidence"}]},{"id":"blk-67549","spans":[{"id":"spn-98196","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-98197","text":" to merge and strengthen"}]}],[{"id":"blk-67550","spans":[{"id":"spn-98198","text":"Frontier gaps"}]},{"id":"blk-67551","spans":[{"id":"spn-98199","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-98200","text":" to fill gaps"}]}],[{"id":"blk-67552","spans":[{"id":"spn-98201","text":"Stale graph"}]},{"id":"blk-67553","spans":[{"id":"spn-98202","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-98203","text":" for continuous sync"}]}]]},{"id":"blk-67554","kind":"heading","level":2,"spans":[{"id":"spn-98204","text":"Anti-patterns to avoid"}]},{"id":"blk-67555","items":[{"blocks":[{"id":"blk-67557","kind":"paragraph","spans":[{"id":"spn-98205","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-67556","kind":"list-item"},{"blocks":[{"id":"blk-67559","kind":"paragraph","spans":[{"id":"spn-98206","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-67558","kind":"list-item"},{"blocks":[{"id":"blk-67561","kind":"paragraph","spans":[{"id":"spn-98207","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-67560","kind":"list-item"},{"blocks":[{"id":"blk-67563","kind":"paragraph","spans":[{"id":"spn-98208","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-67562","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierazfg3bjgxhrv4puv5pgf4mphjvmlypaux3dxtgvi2a6ipg67kwquq","vocabulary":"ampersand.docs.fs.v1"}