{"bendscript":"0.1","blocks":[{"id":"blk-67590","kind":"heading","level":1,"spans":[{"id":"spn-98266","text":"Graph Health Check"}]},{"id":"blk-67591","kind":"paragraph","spans":[{"id":"spn-98267","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-67592","kind":"heading","level":2,"spans":[{"id":"spn-98268","text":"Arguments"}]},{"id":"blk-67593","kind":"paragraph","spans":[{"id":"spn-98269","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-67594","items":[{"blocks":[{"id":"blk-67596","kind":"paragraph","spans":[{"id":"spn-98270","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-67595","kind":"list-item"},{"blocks":[{"id":"blk-67598","kind":"paragraph","spans":[{"id":"spn-98271","marks":["code"],"text":"--full"},{"id":"spn-98272","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-67597","kind":"list-item"},{"blocks":[{"id":"blk-67600","kind":"paragraph","spans":[{"id":"spn-98273","marks":["code"],"text":"--fix"},{"id":"spn-98274","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-67599","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67601","kind":"heading","level":2,"spans":[{"id":"spn-98275","text":"Quick Health Check"}]},{"id":"blk-67602","kind":"heading","level":3,"spans":[{"id":"spn-98276","text":"Step 1 — Graph stats"}]},{"id":"blk-67603","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-67604","kind":"paragraph","spans":[{"id":"spn-98277","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-67605","kind":"heading","level":3,"spans":[{"id":"spn-98278","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-67607","spans":[{"id":"spn-98279","text":"Metric"}]},{"id":"blk-67608","spans":[{"id":"spn-98280","text":"Healthy"}]},{"id":"blk-67609","spans":[{"id":"spn-98281","text":"Warning"}]},{"id":"blk-67610","spans":[{"id":"spn-98282","text":"Critical"}]}],"id":"blk-67606","kind":"table","rows":[[{"id":"blk-67611","spans":[{"id":"spn-98283","text":"Orphan ratio"}]},{"id":"blk-67612","spans":[{"id":"spn-98284","text":"< 10%"}]},{"id":"blk-67613","spans":[{"id":"spn-98285","text":"10–30%"}]},{"id":"blk-67614","spans":[{"id":"spn-98286","text":"> 30%"}]}],[{"id":"blk-67615","spans":[{"id":"spn-98287","text":"Mean confidence"}]},{"id":"blk-67616","spans":[{"id":"spn-98288","text":"> 0.5"}]},{"id":"blk-67617","spans":[{"id":"spn-98289","text":"0.3–0.5"}]},{"id":"blk-67618","spans":[{"id":"spn-98290","text":"< 0.3"}]}],[{"id":"blk-67619","spans":[{"id":"spn-98291","text":"Edge/node ratio"}]},{"id":"blk-67620","spans":[{"id":"spn-98292","text":"> 1.5"}]},{"id":"blk-67621","spans":[{"id":"spn-98293","text":"0.5–1.5"}]},{"id":"blk-67622","spans":[{"id":"spn-98294","text":"< 0.5"}]}],[{"id":"blk-67623","spans":[{"id":"spn-98295","text":"Confidence std_dev"}]},{"id":"blk-67624","spans":[{"id":"spn-98296","text":"< 0.25"}]},{"id":"blk-67625","spans":[{"id":"spn-98297","text":"0.25–0.35"}]},{"id":"blk-67626","spans":[{"id":"spn-98298","text":"> 0.35"}]}]]},{"id":"blk-67627","kind":"paragraph","spans":[{"id":"spn-98299","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-67629","kind":"paragraph","spans":[{"id":"spn-98300","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-98301","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-67628","kind":"quote"},{"id":"blk-67630","kind":"heading","level":2,"spans":[{"id":"spn-98302","text":"Full Audit (--full)"}]},{"id":"blk-67631","kind":"heading","level":3,"spans":[{"id":"spn-98303","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-67632","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-67633","kind":"paragraph","spans":[{"id":"spn-98304","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-67634","kind":"heading","level":3,"spans":[{"id":"spn-98305","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-67635","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-67636","kind":"paragraph","spans":[{"id":"spn-98306","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-67637","kind":"heading","level":3,"spans":[{"id":"spn-98307","text":"Step 5 — Check for staleness"}]},{"id":"blk-67638","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-67639","kind":"paragraph","spans":[{"id":"spn-98308","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-67640","kind":"heading","level":3,"spans":[{"id":"spn-98309","text":"Step 6 — Orphan details"}]},{"id":"blk-67641","kind":"paragraph","spans":[{"id":"spn-98310","text":"If orphan count > 10%, list them:"}]},{"id":"blk-67642","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-67643","kind":"paragraph","spans":[{"id":"spn-98311","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-67644","kind":"heading","level":2,"spans":[{"id":"spn-98312","text":"Auto-Fix (--fix)"}]},{"id":"blk-67645","kind":"paragraph","spans":[{"id":"spn-98313","text":"When "},{"id":"spn-98314","marks":["code"],"text":"--fix"},{"id":"spn-98315","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-67646","kind":"heading","level":3,"spans":[{"id":"spn-98316","text":"Fix orphans — connect or prune"}]},{"id":"blk-67647","kind":"paragraph","spans":[{"id":"spn-98317","text":"For each orphan node:"}]},{"id":"blk-67648","items":[{"blocks":[{"id":"blk-67650","kind":"paragraph","spans":[{"id":"spn-98318","text":"Search for related nodes: "},{"id":"spn-98319","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"}]}],"id":"blk-67649","kind":"list-item"},{"blocks":[{"id":"blk-67652","kind":"paragraph","spans":[{"id":"spn-98320","text":"If similarity > 0.5 with any node → create "},{"id":"spn-98321","marks":["code"],"text":"related_to"},{"id":"spn-98322","text":" edge"}]}],"id":"blk-67651","kind":"list-item"},{"blocks":[{"id":"blk-67654","kind":"paragraph","spans":[{"id":"spn-98323","text":"If no matches and confidence < 0.3 → prune: "},{"id":"spn-98324","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-67653","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67655","kind":"heading","level":3,"spans":[{"id":"spn-98325","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-67656","kind":"paragraph","spans":[{"id":"spn-98326","text":"For nodes with confidence < 0.2:"}]},{"id":"blk-67657","items":[{"blocks":[{"id":"blk-67659","kind":"paragraph","spans":[{"id":"spn-98327","text":"Check if still relevant (search for supporting context)"}]}],"id":"blk-67658","kind":"list-item"},{"blocks":[{"id":"blk-67661","kind":"paragraph","spans":[{"id":"spn-98328","text":"If supporting evidence exists → "},{"id":"spn-98329","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"}]}],"id":"blk-67660","kind":"list-item"},{"blocks":[{"id":"blk-67663","kind":"paragraph","spans":[{"id":"spn-98330","text":"If no support → "},{"id":"spn-98331","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-67662","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67664","kind":"heading","level":3,"spans":[{"id":"spn-98332","text":"Fix staleness — flag for sync"}]},{"id":"blk-67665","kind":"paragraph","spans":[{"id":"spn-98333","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-98334","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-98335","text":" to ingest recent filesystem changes."}]},{"id":"blk-67666","kind":"heading","level":2,"spans":[{"id":"spn-98336","text":"Health Report Format"}]},{"id":"blk-67667","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-67668","kind":"heading","level":2,"spans":[{"id":"spn-98337","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-67670","spans":[{"id":"spn-98338","text":"Situation"}]},{"id":"blk-67671","spans":[{"id":"spn-98339","text":"Follow-up"}]}],"id":"blk-67669","kind":"table","rows":[[{"id":"blk-67672","spans":[{"id":"spn-98340","text":"High orphan count"}]},{"id":"blk-67673","spans":[{"id":"spn-98341","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-98342","text":" to rebuild edges"}]}],[{"id":"blk-67674","spans":[{"id":"spn-98343","text":"Low mean confidence"}]},{"id":"blk-67675","spans":[{"id":"spn-98344","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-98345","text":" to merge and strengthen"}]}],[{"id":"blk-67676","spans":[{"id":"spn-98346","text":"Frontier gaps"}]},{"id":"blk-67677","spans":[{"id":"spn-98347","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-98348","text":" to fill gaps"}]}],[{"id":"blk-67678","spans":[{"id":"spn-98349","text":"Stale graph"}]},{"id":"blk-67679","spans":[{"id":"spn-98350","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-98351","text":" for continuous sync"}]}]]},{"id":"blk-67680","kind":"heading","level":2,"spans":[{"id":"spn-98352","text":"Anti-patterns to avoid"}]},{"id":"blk-67681","items":[{"blocks":[{"id":"blk-67683","kind":"paragraph","spans":[{"id":"spn-98353","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-67682","kind":"list-item"},{"blocks":[{"id":"blk-67685","kind":"paragraph","spans":[{"id":"spn-98354","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-67684","kind":"list-item"},{"blocks":[{"id":"blk-67687","kind":"paragraph","spans":[{"id":"spn-98355","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-67686","kind":"list-item"},{"blocks":[{"id":"blk-67689","kind":"paragraph","spans":[{"id":"spn-98356","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-67688","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieravw24lvzo5ebtedn5ofxnizglbfjcfvwii24xhgrm6tza47biy7uq","vocabulary":"ampersand.docs.fs.v1"}