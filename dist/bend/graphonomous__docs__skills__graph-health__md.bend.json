{"bendscript":"0.1","blocks":[{"id":"blk-43734","kind":"paragraph","spans":[{"id":"spn-50495","text":"--- name: graph-health description: Use when the user asks \"is the graph healthy?\", \"run diagnostics\", \"graph quality\", \"check graph health\", \"memory health\", \"audit the graph\", \"how big is the graph?\", \"any problems?\", or wants a combined health report. Runs stats, identifies weak nodes, checks for orphans, and reports frontier uncertainty. Routes through "},{"id":"spn-50496","marks":["code"],"text":"consolidate"},{"id":"spn-50497","text":", "},{"id":"spn-50498","marks":["code"],"text":"retrieve"},{"id":"spn-50499","text":", and "},{"id":"spn-50500","marks":["code"],"text":"act"},{"id":"spn-50501","text":" machines. argument-hint: [--full] [--fix] ---"}]},{"id":"blk-43735","kind":"heading","level":1,"spans":[{"id":"spn-50502","text":"Graph Health Check"}]},{"id":"blk-43736","kind":"paragraph","spans":[{"id":"spn-50503","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-43737","kind":"heading","level":2,"spans":[{"id":"spn-50504","text":"Arguments"}]},{"id":"blk-43738","kind":"paragraph","spans":[{"id":"spn-50505","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-43739","items":[{"blocks":[{"id":"blk-43741","kind":"paragraph","spans":[{"id":"spn-50506","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-43740","kind":"list-item"},{"blocks":[{"id":"blk-43743","kind":"paragraph","spans":[{"id":"spn-50507","marks":["code"],"text":"--full"},{"id":"spn-50508","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-43742","kind":"list-item"},{"blocks":[{"id":"blk-43745","kind":"paragraph","spans":[{"id":"spn-50509","marks":["code"],"text":"--fix"},{"id":"spn-50510","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-43744","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43746","kind":"heading","level":2,"spans":[{"id":"spn-50511","text":"Quick Health Check"}]},{"id":"blk-43747","kind":"heading","level":3,"spans":[{"id":"spn-50512","text":"Step 1 — Graph stats"}]},{"id":"blk-43748","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-43749","kind":"paragraph","spans":[{"id":"spn-50513","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-43750","kind":"heading","level":3,"spans":[{"id":"spn-50514","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-43752","spans":[{"id":"spn-50515","text":"Metric"}]},{"id":"blk-43753","spans":[{"id":"spn-50516","text":"Healthy"}]},{"id":"blk-43754","spans":[{"id":"spn-50517","text":"Warning"}]},{"id":"blk-43755","spans":[{"id":"spn-50518","text":"Critical"}]}],"id":"blk-43751","kind":"table","rows":[[{"id":"blk-43756","spans":[{"id":"spn-50519","text":"Orphan ratio"}]},{"id":"blk-43757","spans":[{"id":"spn-50520","text":"< 10%"}]},{"id":"blk-43758","spans":[{"id":"spn-50521","text":"10–30%"}]},{"id":"blk-43759","spans":[{"id":"spn-50522","text":"> 30%"}]}],[{"id":"blk-43760","spans":[{"id":"spn-50523","text":"Mean confidence"}]},{"id":"blk-43761","spans":[{"id":"spn-50524","text":"> 0.5"}]},{"id":"blk-43762","spans":[{"id":"spn-50525","text":"0.3–0.5"}]},{"id":"blk-43763","spans":[{"id":"spn-50526","text":"< 0.3"}]}],[{"id":"blk-43764","spans":[{"id":"spn-50527","text":"Edge/node ratio"}]},{"id":"blk-43765","spans":[{"id":"spn-50528","text":"> 1.5"}]},{"id":"blk-43766","spans":[{"id":"spn-50529","text":"0.5–1.5"}]},{"id":"blk-43767","spans":[{"id":"spn-50530","text":"< 0.5"}]}],[{"id":"blk-43768","spans":[{"id":"spn-50531","text":"Confidence std_dev"}]},{"id":"blk-43769","spans":[{"id":"spn-50532","text":"< 0.25"}]},{"id":"blk-43770","spans":[{"id":"spn-50533","text":"0.25–0.35"}]},{"id":"blk-43771","spans":[{"id":"spn-50534","text":"> 0.35"}]}]]},{"id":"blk-43772","kind":"paragraph","spans":[{"id":"spn-50535","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-43774","kind":"paragraph","spans":[{"id":"spn-50536","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-50537","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-43773","kind":"quote"},{"id":"blk-43775","kind":"heading","level":2,"spans":[{"id":"spn-50538","text":"Full Audit (--full)"}]},{"id":"blk-43776","kind":"heading","level":3,"spans":[{"id":"spn-50539","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-43777","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-43778","kind":"paragraph","spans":[{"id":"spn-50540","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-43779","kind":"heading","level":3,"spans":[{"id":"spn-50541","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-43780","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-43781","kind":"paragraph","spans":[{"id":"spn-50542","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-43782","kind":"heading","level":3,"spans":[{"id":"spn-50543","text":"Step 5 — Check for staleness"}]},{"id":"blk-43783","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-43784","kind":"paragraph","spans":[{"id":"spn-50544","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-43785","kind":"heading","level":3,"spans":[{"id":"spn-50545","text":"Step 6 — Orphan details"}]},{"id":"blk-43786","kind":"paragraph","spans":[{"id":"spn-50546","text":"If orphan count > 10%, list them:"}]},{"id":"blk-43787","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-43788","kind":"paragraph","spans":[{"id":"spn-50547","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-43789","kind":"heading","level":2,"spans":[{"id":"spn-50548","text":"Auto-Fix (--fix)"}]},{"id":"blk-43790","kind":"paragraph","spans":[{"id":"spn-50549","text":"When "},{"id":"spn-50550","marks":["code"],"text":"--fix"},{"id":"spn-50551","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-43791","kind":"heading","level":3,"spans":[{"id":"spn-50552","text":"Fix orphans — connect or prune"}]},{"id":"blk-43792","kind":"paragraph","spans":[{"id":"spn-50553","text":"For each orphan node: 1. Search for related nodes: "},{"id":"spn-50554","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"},{"id":"spn-50555","text":" 2. If similarity > 0.5 with any node → create "},{"id":"spn-50556","marks":["code"],"text":"related_to"},{"id":"spn-50557","text":" edge 3. If no matches and confidence < 0.3 → prune: "},{"id":"spn-50558","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-43793","kind":"heading","level":3,"spans":[{"id":"spn-50559","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-43794","kind":"paragraph","spans":[{"id":"spn-50560","text":"For nodes with confidence < 0.2: 1. Check if still relevant (search for supporting context) 2. If supporting evidence exists → "},{"id":"spn-50561","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"},{"id":"spn-50562","text":" 3. If no support → "},{"id":"spn-50563","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-43795","kind":"heading","level":3,"spans":[{"id":"spn-50564","text":"Fix staleness — flag for sync"}]},{"id":"blk-43796","kind":"paragraph","spans":[{"id":"spn-50565","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-50566","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-50567","text":" to ingest recent filesystem changes."}]},{"id":"blk-43797","kind":"heading","level":2,"spans":[{"id":"spn-50568","text":"Health Report Format"}]},{"id":"blk-43798","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-43799","kind":"heading","level":2,"spans":[{"id":"spn-50569","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-43801","spans":[{"id":"spn-50570","text":"Situation"}]},{"id":"blk-43802","spans":[{"id":"spn-50571","text":"Follow-up"}]}],"id":"blk-43800","kind":"table","rows":[[{"id":"blk-43803","spans":[{"id":"spn-50572","text":"High orphan count"}]},{"id":"blk-43804","spans":[{"id":"spn-50573","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-50574","text":" to rebuild edges"}]}],[{"id":"blk-43805","spans":[{"id":"spn-50575","text":"Low mean confidence"}]},{"id":"blk-43806","spans":[{"id":"spn-50576","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-50577","text":" to merge and strengthen"}]}],[{"id":"blk-43807","spans":[{"id":"spn-50578","text":"Frontier gaps"}]},{"id":"blk-43808","spans":[{"id":"spn-50579","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-50580","text":" to fill gaps"}]}],[{"id":"blk-43809","spans":[{"id":"spn-50581","text":"Stale graph"}]},{"id":"blk-43810","spans":[{"id":"spn-50582","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-50583","text":" for continuous sync"}]}]]},{"id":"blk-43811","kind":"heading","level":2,"spans":[{"id":"spn-50584","text":"Anti-patterns to avoid"}]},{"id":"blk-43812","items":[{"blocks":[{"id":"blk-43814","kind":"paragraph","spans":[{"id":"spn-50585","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-43813","kind":"list-item"},{"blocks":[{"id":"blk-43816","kind":"paragraph","spans":[{"id":"spn-50586","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-43815","kind":"list-item"},{"blocks":[{"id":"blk-43818","kind":"paragraph","spans":[{"id":"spn-50587","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-43817","kind":"list-item"},{"blocks":[{"id":"blk-43820","kind":"paragraph","spans":[{"id":"spn-50588","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-43819","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierarvaaticbgmanf5ynie4rinpq5tb3an2u23pd77i6flywgl4glp3q","vocabulary":"ampersand.docs.fs.v1"}