{"bendscript":"0.1","blocks":[{"id":"blk-43248","kind":"paragraph","spans":[{"id":"spn-49375","text":"--- name: graph-health description: Use when the user asks \"is the graph healthy?\", \"run diagnostics\", \"graph quality\", \"check graph health\", \"memory health\", \"audit the graph\", \"how big is the graph?\", \"any problems?\", or wants a combined health report. Runs stats, identifies weak nodes, checks for orphans, and reports frontier uncertainty. Routes through "},{"id":"spn-49376","marks":["code"],"text":"consolidate"},{"id":"spn-49377","text":", "},{"id":"spn-49378","marks":["code"],"text":"retrieve"},{"id":"spn-49379","text":", and "},{"id":"spn-49380","marks":["code"],"text":"act"},{"id":"spn-49381","text":" machines. argument-hint: [--full] [--fix] ---"}]},{"id":"blk-43249","kind":"heading","level":1,"spans":[{"id":"spn-49382","text":"Graph Health Check"}]},{"id":"blk-43250","kind":"paragraph","spans":[{"id":"spn-49383","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-43251","kind":"heading","level":2,"spans":[{"id":"spn-49384","text":"Arguments"}]},{"id":"blk-43252","kind":"paragraph","spans":[{"id":"spn-49385","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-43253","items":[{"blocks":[{"id":"blk-43255","kind":"paragraph","spans":[{"id":"spn-49386","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-43254","kind":"list-item"},{"blocks":[{"id":"blk-43257","kind":"paragraph","spans":[{"id":"spn-49387","marks":["code"],"text":"--full"},{"id":"spn-49388","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-43256","kind":"list-item"},{"blocks":[{"id":"blk-43259","kind":"paragraph","spans":[{"id":"spn-49389","marks":["code"],"text":"--fix"},{"id":"spn-49390","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-43258","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43260","kind":"heading","level":2,"spans":[{"id":"spn-49391","text":"Quick Health Check"}]},{"id":"blk-43261","kind":"heading","level":3,"spans":[{"id":"spn-49392","text":"Step 1 — Graph stats"}]},{"id":"blk-43262","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-43263","kind":"paragraph","spans":[{"id":"spn-49393","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-43264","kind":"heading","level":3,"spans":[{"id":"spn-49394","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-43266","spans":[{"id":"spn-49395","text":"Metric"}]},{"id":"blk-43267","spans":[{"id":"spn-49396","text":"Healthy"}]},{"id":"blk-43268","spans":[{"id":"spn-49397","text":"Warning"}]},{"id":"blk-43269","spans":[{"id":"spn-49398","text":"Critical"}]}],"id":"blk-43265","kind":"table","rows":[[{"id":"blk-43270","spans":[{"id":"spn-49399","text":"Orphan ratio"}]},{"id":"blk-43271","spans":[{"id":"spn-49400","text":"< 10%"}]},{"id":"blk-43272","spans":[{"id":"spn-49401","text":"10–30%"}]},{"id":"blk-43273","spans":[{"id":"spn-49402","text":"> 30%"}]}],[{"id":"blk-43274","spans":[{"id":"spn-49403","text":"Mean confidence"}]},{"id":"blk-43275","spans":[{"id":"spn-49404","text":"> 0.5"}]},{"id":"blk-43276","spans":[{"id":"spn-49405","text":"0.3–0.5"}]},{"id":"blk-43277","spans":[{"id":"spn-49406","text":"< 0.3"}]}],[{"id":"blk-43278","spans":[{"id":"spn-49407","text":"Edge/node ratio"}]},{"id":"blk-43279","spans":[{"id":"spn-49408","text":"> 1.5"}]},{"id":"blk-43280","spans":[{"id":"spn-49409","text":"0.5–1.5"}]},{"id":"blk-43281","spans":[{"id":"spn-49410","text":"< 0.5"}]}],[{"id":"blk-43282","spans":[{"id":"spn-49411","text":"Confidence std_dev"}]},{"id":"blk-43283","spans":[{"id":"spn-49412","text":"< 0.25"}]},{"id":"blk-43284","spans":[{"id":"spn-49413","text":"0.25–0.35"}]},{"id":"blk-43285","spans":[{"id":"spn-49414","text":"> 0.35"}]}]]},{"id":"blk-43286","kind":"paragraph","spans":[{"id":"spn-49415","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-43288","kind":"paragraph","spans":[{"id":"spn-49416","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-49417","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-43287","kind":"quote"},{"id":"blk-43289","kind":"heading","level":2,"spans":[{"id":"spn-49418","text":"Full Audit (--full)"}]},{"id":"blk-43290","kind":"heading","level":3,"spans":[{"id":"spn-49419","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-43291","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-43292","kind":"paragraph","spans":[{"id":"spn-49420","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-43293","kind":"heading","level":3,"spans":[{"id":"spn-49421","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-43294","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-43295","kind":"paragraph","spans":[{"id":"spn-49422","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-43296","kind":"heading","level":3,"spans":[{"id":"spn-49423","text":"Step 5 — Check for staleness"}]},{"id":"blk-43297","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-43298","kind":"paragraph","spans":[{"id":"spn-49424","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-43299","kind":"heading","level":3,"spans":[{"id":"spn-49425","text":"Step 6 — Orphan details"}]},{"id":"blk-43300","kind":"paragraph","spans":[{"id":"spn-49426","text":"If orphan count > 10%, list them:"}]},{"id":"blk-43301","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-43302","kind":"paragraph","spans":[{"id":"spn-49427","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-43303","kind":"heading","level":2,"spans":[{"id":"spn-49428","text":"Auto-Fix (--fix)"}]},{"id":"blk-43304","kind":"paragraph","spans":[{"id":"spn-49429","text":"When "},{"id":"spn-49430","marks":["code"],"text":"--fix"},{"id":"spn-49431","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-43305","kind":"heading","level":3,"spans":[{"id":"spn-49432","text":"Fix orphans — connect or prune"}]},{"id":"blk-43306","kind":"paragraph","spans":[{"id":"spn-49433","text":"For each orphan node: 1. Search for related nodes: "},{"id":"spn-49434","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"},{"id":"spn-49435","text":" 2. If similarity > 0.5 with any node → create "},{"id":"spn-49436","marks":["code"],"text":"related_to"},{"id":"spn-49437","text":" edge 3. If no matches and confidence < 0.3 → prune: "},{"id":"spn-49438","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-43307","kind":"heading","level":3,"spans":[{"id":"spn-49439","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-43308","kind":"paragraph","spans":[{"id":"spn-49440","text":"For nodes with confidence < 0.2: 1. Check if still relevant (search for supporting context) 2. If supporting evidence exists → "},{"id":"spn-49441","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"},{"id":"spn-49442","text":" 3. If no support → "},{"id":"spn-49443","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-43309","kind":"heading","level":3,"spans":[{"id":"spn-49444","text":"Fix staleness — flag for sync"}]},{"id":"blk-43310","kind":"paragraph","spans":[{"id":"spn-49445","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-49446","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-49447","text":" to ingest recent filesystem changes."}]},{"id":"blk-43311","kind":"heading","level":2,"spans":[{"id":"spn-49448","text":"Health Report Format"}]},{"id":"blk-43312","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-43313","kind":"heading","level":2,"spans":[{"id":"spn-49449","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-43315","spans":[{"id":"spn-49450","text":"Situation"}]},{"id":"blk-43316","spans":[{"id":"spn-49451","text":"Follow-up"}]}],"id":"blk-43314","kind":"table","rows":[[{"id":"blk-43317","spans":[{"id":"spn-49452","text":"High orphan count"}]},{"id":"blk-43318","spans":[{"id":"spn-49453","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-49454","text":" to rebuild edges"}]}],[{"id":"blk-43319","spans":[{"id":"spn-49455","text":"Low mean confidence"}]},{"id":"blk-43320","spans":[{"id":"spn-49456","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-49457","text":" to merge and strengthen"}]}],[{"id":"blk-43321","spans":[{"id":"spn-49458","text":"Frontier gaps"}]},{"id":"blk-43322","spans":[{"id":"spn-49459","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-49460","text":" to fill gaps"}]}],[{"id":"blk-43323","spans":[{"id":"spn-49461","text":"Stale graph"}]},{"id":"blk-43324","spans":[{"id":"spn-49462","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-49463","text":" for continuous sync"}]}]]},{"id":"blk-43325","kind":"heading","level":2,"spans":[{"id":"spn-49464","text":"Anti-patterns to avoid"}]},{"id":"blk-43326","items":[{"blocks":[{"id":"blk-43328","kind":"paragraph","spans":[{"id":"spn-49465","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-43327","kind":"list-item"},{"blocks":[{"id":"blk-43330","kind":"paragraph","spans":[{"id":"spn-49466","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-43329","kind":"list-item"},{"blocks":[{"id":"blk-43332","kind":"paragraph","spans":[{"id":"spn-49467","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-43331","kind":"list-item"},{"blocks":[{"id":"blk-43334","kind":"paragraph","spans":[{"id":"spn-49468","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-43333","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraod6bi4fjfudamxmpav7rap3wwo7bmezxkokr5cv7gh62kuxndkoq","vocabulary":"ampersand.docs.fs.v1"}