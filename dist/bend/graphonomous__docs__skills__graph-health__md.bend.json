{"bendscript":"0.1","blocks":[{"id":"blk-68418","kind":"heading","level":1,"spans":[{"id":"spn-100905","text":"Graph Health Check"}]},{"id":"blk-68419","kind":"paragraph","spans":[{"id":"spn-100906","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-68420","kind":"heading","level":2,"spans":[{"id":"spn-100907","text":"Arguments"}]},{"id":"blk-68421","kind":"paragraph","spans":[{"id":"spn-100908","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-68422","items":[{"blocks":[{"id":"blk-68424","kind":"paragraph","spans":[{"id":"spn-100909","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-68423","kind":"list-item"},{"blocks":[{"id":"blk-68426","kind":"paragraph","spans":[{"id":"spn-100910","marks":["code"],"text":"--full"},{"id":"spn-100911","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-68425","kind":"list-item"},{"blocks":[{"id":"blk-68428","kind":"paragraph","spans":[{"id":"spn-100912","marks":["code"],"text":"--fix"},{"id":"spn-100913","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-68427","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68429","kind":"heading","level":2,"spans":[{"id":"spn-100914","text":"Quick Health Check"}]},{"id":"blk-68430","kind":"heading","level":3,"spans":[{"id":"spn-100915","text":"Step 1 — Graph stats"}]},{"id":"blk-68431","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-68432","kind":"paragraph","spans":[{"id":"spn-100916","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-68433","kind":"heading","level":3,"spans":[{"id":"spn-100917","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-68435","spans":[{"id":"spn-100918","text":"Metric"}]},{"id":"blk-68436","spans":[{"id":"spn-100919","text":"Healthy"}]},{"id":"blk-68437","spans":[{"id":"spn-100920","text":"Warning"}]},{"id":"blk-68438","spans":[{"id":"spn-100921","text":"Critical"}]}],"id":"blk-68434","kind":"table","rows":[[{"id":"blk-68439","spans":[{"id":"spn-100922","text":"Orphan ratio"}]},{"id":"blk-68440","spans":[{"id":"spn-100923","text":"< 10%"}]},{"id":"blk-68441","spans":[{"id":"spn-100924","text":"10–30%"}]},{"id":"blk-68442","spans":[{"id":"spn-100925","text":"> 30%"}]}],[{"id":"blk-68443","spans":[{"id":"spn-100926","text":"Mean confidence"}]},{"id":"blk-68444","spans":[{"id":"spn-100927","text":"> 0.5"}]},{"id":"blk-68445","spans":[{"id":"spn-100928","text":"0.3–0.5"}]},{"id":"blk-68446","spans":[{"id":"spn-100929","text":"< 0.3"}]}],[{"id":"blk-68447","spans":[{"id":"spn-100930","text":"Edge/node ratio"}]},{"id":"blk-68448","spans":[{"id":"spn-100931","text":"> 1.5"}]},{"id":"blk-68449","spans":[{"id":"spn-100932","text":"0.5–1.5"}]},{"id":"blk-68450","spans":[{"id":"spn-100933","text":"< 0.5"}]}],[{"id":"blk-68451","spans":[{"id":"spn-100934","text":"Confidence std_dev"}]},{"id":"blk-68452","spans":[{"id":"spn-100935","text":"< 0.25"}]},{"id":"blk-68453","spans":[{"id":"spn-100936","text":"0.25–0.35"}]},{"id":"blk-68454","spans":[{"id":"spn-100937","text":"> 0.35"}]}]]},{"id":"blk-68455","kind":"paragraph","spans":[{"id":"spn-100938","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-68457","kind":"paragraph","spans":[{"id":"spn-100939","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-100940","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-68456","kind":"quote"},{"id":"blk-68458","kind":"heading","level":2,"spans":[{"id":"spn-100941","text":"Full Audit (--full)"}]},{"id":"blk-68459","kind":"heading","level":3,"spans":[{"id":"spn-100942","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-68460","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-68461","kind":"paragraph","spans":[{"id":"spn-100943","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-68462","kind":"heading","level":3,"spans":[{"id":"spn-100944","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-68463","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-68464","kind":"paragraph","spans":[{"id":"spn-100945","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-68465","kind":"heading","level":3,"spans":[{"id":"spn-100946","text":"Step 5 — Check for staleness"}]},{"id":"blk-68466","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-68467","kind":"paragraph","spans":[{"id":"spn-100947","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-68468","kind":"heading","level":3,"spans":[{"id":"spn-100948","text":"Step 6 — Orphan details"}]},{"id":"blk-68469","kind":"paragraph","spans":[{"id":"spn-100949","text":"If orphan count > 10%, list them:"}]},{"id":"blk-68470","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-68471","kind":"paragraph","spans":[{"id":"spn-100950","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-68472","kind":"heading","level":2,"spans":[{"id":"spn-100951","text":"Auto-Fix (--fix)"}]},{"id":"blk-68473","kind":"paragraph","spans":[{"id":"spn-100952","text":"When "},{"id":"spn-100953","marks":["code"],"text":"--fix"},{"id":"spn-100954","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-68474","kind":"heading","level":3,"spans":[{"id":"spn-100955","text":"Fix orphans — connect or prune"}]},{"id":"blk-68475","kind":"paragraph","spans":[{"id":"spn-100956","text":"For each orphan node:"}]},{"id":"blk-68476","items":[{"blocks":[{"id":"blk-68478","kind":"paragraph","spans":[{"id":"spn-100957","text":"Search for related nodes: "},{"id":"spn-100958","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"}]}],"id":"blk-68477","kind":"list-item"},{"blocks":[{"id":"blk-68480","kind":"paragraph","spans":[{"id":"spn-100959","text":"If similarity > 0.5 with any node → create "},{"id":"spn-100960","marks":["code"],"text":"related_to"},{"id":"spn-100961","text":" edge"}]}],"id":"blk-68479","kind":"list-item"},{"blocks":[{"id":"blk-68482","kind":"paragraph","spans":[{"id":"spn-100962","text":"If no matches and confidence < 0.3 → prune: "},{"id":"spn-100963","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-68481","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68483","kind":"heading","level":3,"spans":[{"id":"spn-100964","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-68484","kind":"paragraph","spans":[{"id":"spn-100965","text":"For nodes with confidence < 0.2:"}]},{"id":"blk-68485","items":[{"blocks":[{"id":"blk-68487","kind":"paragraph","spans":[{"id":"spn-100966","text":"Check if still relevant (search for supporting context)"}]}],"id":"blk-68486","kind":"list-item"},{"blocks":[{"id":"blk-68489","kind":"paragraph","spans":[{"id":"spn-100967","text":"If supporting evidence exists → "},{"id":"spn-100968","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"}]}],"id":"blk-68488","kind":"list-item"},{"blocks":[{"id":"blk-68491","kind":"paragraph","spans":[{"id":"spn-100969","text":"If no support → "},{"id":"spn-100970","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-68490","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68492","kind":"heading","level":3,"spans":[{"id":"spn-100971","text":"Fix staleness — flag for sync"}]},{"id":"blk-68493","kind":"paragraph","spans":[{"id":"spn-100972","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-100973","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-100974","text":" to ingest recent filesystem changes."}]},{"id":"blk-68494","kind":"heading","level":2,"spans":[{"id":"spn-100975","text":"Health Report Format"}]},{"id":"blk-68495","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-68496","kind":"heading","level":2,"spans":[{"id":"spn-100976","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-68498","spans":[{"id":"spn-100977","text":"Situation"}]},{"id":"blk-68499","spans":[{"id":"spn-100978","text":"Follow-up"}]}],"id":"blk-68497","kind":"table","rows":[[{"id":"blk-68500","spans":[{"id":"spn-100979","text":"High orphan count"}]},{"id":"blk-68501","spans":[{"id":"spn-100980","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-100981","text":" to rebuild edges"}]}],[{"id":"blk-68502","spans":[{"id":"spn-100982","text":"Low mean confidence"}]},{"id":"blk-68503","spans":[{"id":"spn-100983","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-100984","text":" to merge and strengthen"}]}],[{"id":"blk-68504","spans":[{"id":"spn-100985","text":"Frontier gaps"}]},{"id":"blk-68505","spans":[{"id":"spn-100986","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-100987","text":" to fill gaps"}]}],[{"id":"blk-68506","spans":[{"id":"spn-100988","text":"Stale graph"}]},{"id":"blk-68507","spans":[{"id":"spn-100989","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-100990","text":" for continuous sync"}]}]]},{"id":"blk-68508","kind":"heading","level":2,"spans":[{"id":"spn-100991","text":"Anti-patterns to avoid"}]},{"id":"blk-68509","items":[{"blocks":[{"id":"blk-68511","kind":"paragraph","spans":[{"id":"spn-100992","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-68510","kind":"list-item"},{"blocks":[{"id":"blk-68513","kind":"paragraph","spans":[{"id":"spn-100993","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-68512","kind":"list-item"},{"blocks":[{"id":"blk-68515","kind":"paragraph","spans":[{"id":"spn-100994","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-68514","kind":"list-item"},{"blocks":[{"id":"blk-68517","kind":"paragraph","spans":[{"id":"spn-100995","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-68516","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraso7hzj4ibyd54rtrqsv5hwfz5gadk3sgq326e7zpnfgruervyoyq","vocabulary":"ampersand.docs.fs.v1"}