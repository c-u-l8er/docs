{"bendscript":"0.1","blocks":[{"id":"blk-67453","kind":"heading","level":1,"spans":[{"id":"spn-98065","text":"Graph Health Check"}]},{"id":"blk-67454","kind":"paragraph","spans":[{"id":"spn-98066","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-67455","kind":"heading","level":2,"spans":[{"id":"spn-98067","text":"Arguments"}]},{"id":"blk-67456","kind":"paragraph","spans":[{"id":"spn-98068","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-67457","items":[{"blocks":[{"id":"blk-67459","kind":"paragraph","spans":[{"id":"spn-98069","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-67458","kind":"list-item"},{"blocks":[{"id":"blk-67461","kind":"paragraph","spans":[{"id":"spn-98070","marks":["code"],"text":"--full"},{"id":"spn-98071","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-67460","kind":"list-item"},{"blocks":[{"id":"blk-67463","kind":"paragraph","spans":[{"id":"spn-98072","marks":["code"],"text":"--fix"},{"id":"spn-98073","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-67462","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67464","kind":"heading","level":2,"spans":[{"id":"spn-98074","text":"Quick Health Check"}]},{"id":"blk-67465","kind":"heading","level":3,"spans":[{"id":"spn-98075","text":"Step 1 — Graph stats"}]},{"id":"blk-67466","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-67467","kind":"paragraph","spans":[{"id":"spn-98076","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-67468","kind":"heading","level":3,"spans":[{"id":"spn-98077","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-67470","spans":[{"id":"spn-98078","text":"Metric"}]},{"id":"blk-67471","spans":[{"id":"spn-98079","text":"Healthy"}]},{"id":"blk-67472","spans":[{"id":"spn-98080","text":"Warning"}]},{"id":"blk-67473","spans":[{"id":"spn-98081","text":"Critical"}]}],"id":"blk-67469","kind":"table","rows":[[{"id":"blk-67474","spans":[{"id":"spn-98082","text":"Orphan ratio"}]},{"id":"blk-67475","spans":[{"id":"spn-98083","text":"< 10%"}]},{"id":"blk-67476","spans":[{"id":"spn-98084","text":"10–30%"}]},{"id":"blk-67477","spans":[{"id":"spn-98085","text":"> 30%"}]}],[{"id":"blk-67478","spans":[{"id":"spn-98086","text":"Mean confidence"}]},{"id":"blk-67479","spans":[{"id":"spn-98087","text":"> 0.5"}]},{"id":"blk-67480","spans":[{"id":"spn-98088","text":"0.3–0.5"}]},{"id":"blk-67481","spans":[{"id":"spn-98089","text":"< 0.3"}]}],[{"id":"blk-67482","spans":[{"id":"spn-98090","text":"Edge/node ratio"}]},{"id":"blk-67483","spans":[{"id":"spn-98091","text":"> 1.5"}]},{"id":"blk-67484","spans":[{"id":"spn-98092","text":"0.5–1.5"}]},{"id":"blk-67485","spans":[{"id":"spn-98093","text":"< 0.5"}]}],[{"id":"blk-67486","spans":[{"id":"spn-98094","text":"Confidence std_dev"}]},{"id":"blk-67487","spans":[{"id":"spn-98095","text":"< 0.25"}]},{"id":"blk-67488","spans":[{"id":"spn-98096","text":"0.25–0.35"}]},{"id":"blk-67489","spans":[{"id":"spn-98097","text":"> 0.35"}]}]]},{"id":"blk-67490","kind":"paragraph","spans":[{"id":"spn-98098","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-67492","kind":"paragraph","spans":[{"id":"spn-98099","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-98100","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-67491","kind":"quote"},{"id":"blk-67493","kind":"heading","level":2,"spans":[{"id":"spn-98101","text":"Full Audit (--full)"}]},{"id":"blk-67494","kind":"heading","level":3,"spans":[{"id":"spn-98102","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-67495","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-67496","kind":"paragraph","spans":[{"id":"spn-98103","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-67497","kind":"heading","level":3,"spans":[{"id":"spn-98104","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-67498","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-67499","kind":"paragraph","spans":[{"id":"spn-98105","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-67500","kind":"heading","level":3,"spans":[{"id":"spn-98106","text":"Step 5 — Check for staleness"}]},{"id":"blk-67501","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-67502","kind":"paragraph","spans":[{"id":"spn-98107","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-67503","kind":"heading","level":3,"spans":[{"id":"spn-98108","text":"Step 6 — Orphan details"}]},{"id":"blk-67504","kind":"paragraph","spans":[{"id":"spn-98109","text":"If orphan count > 10%, list them:"}]},{"id":"blk-67505","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-67506","kind":"paragraph","spans":[{"id":"spn-98110","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-67507","kind":"heading","level":2,"spans":[{"id":"spn-98111","text":"Auto-Fix (--fix)"}]},{"id":"blk-67508","kind":"paragraph","spans":[{"id":"spn-98112","text":"When "},{"id":"spn-98113","marks":["code"],"text":"--fix"},{"id":"spn-98114","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-67509","kind":"heading","level":3,"spans":[{"id":"spn-98115","text":"Fix orphans — connect or prune"}]},{"id":"blk-67510","kind":"paragraph","spans":[{"id":"spn-98116","text":"For each orphan node:"}]},{"id":"blk-67511","items":[{"blocks":[{"id":"blk-67513","kind":"paragraph","spans":[{"id":"spn-98117","text":"Search for related nodes: "},{"id":"spn-98118","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"}]}],"id":"blk-67512","kind":"list-item"},{"blocks":[{"id":"blk-67515","kind":"paragraph","spans":[{"id":"spn-98119","text":"If similarity > 0.5 with any node → create "},{"id":"spn-98120","marks":["code"],"text":"related_to"},{"id":"spn-98121","text":" edge"}]}],"id":"blk-67514","kind":"list-item"},{"blocks":[{"id":"blk-67517","kind":"paragraph","spans":[{"id":"spn-98122","text":"If no matches and confidence < 0.3 → prune: "},{"id":"spn-98123","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-67516","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67518","kind":"heading","level":3,"spans":[{"id":"spn-98124","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-67519","kind":"paragraph","spans":[{"id":"spn-98125","text":"For nodes with confidence < 0.2:"}]},{"id":"blk-67520","items":[{"blocks":[{"id":"blk-67522","kind":"paragraph","spans":[{"id":"spn-98126","text":"Check if still relevant (search for supporting context)"}]}],"id":"blk-67521","kind":"list-item"},{"blocks":[{"id":"blk-67524","kind":"paragraph","spans":[{"id":"spn-98127","text":"If supporting evidence exists → "},{"id":"spn-98128","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"}]}],"id":"blk-67523","kind":"list-item"},{"blocks":[{"id":"blk-67526","kind":"paragraph","spans":[{"id":"spn-98129","text":"If no support → "},{"id":"spn-98130","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-67525","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67527","kind":"heading","level":3,"spans":[{"id":"spn-98131","text":"Fix staleness — flag for sync"}]},{"id":"blk-67528","kind":"paragraph","spans":[{"id":"spn-98132","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-98133","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-98134","text":" to ingest recent filesystem changes."}]},{"id":"blk-67529","kind":"heading","level":2,"spans":[{"id":"spn-98135","text":"Health Report Format"}]},{"id":"blk-67530","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-67531","kind":"heading","level":2,"spans":[{"id":"spn-98136","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-67533","spans":[{"id":"spn-98137","text":"Situation"}]},{"id":"blk-67534","spans":[{"id":"spn-98138","text":"Follow-up"}]}],"id":"blk-67532","kind":"table","rows":[[{"id":"blk-67535","spans":[{"id":"spn-98139","text":"High orphan count"}]},{"id":"blk-67536","spans":[{"id":"spn-98140","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-98141","text":" to rebuild edges"}]}],[{"id":"blk-67537","spans":[{"id":"spn-98142","text":"Low mean confidence"}]},{"id":"blk-67538","spans":[{"id":"spn-98143","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-98144","text":" to merge and strengthen"}]}],[{"id":"blk-67539","spans":[{"id":"spn-98145","text":"Frontier gaps"}]},{"id":"blk-67540","spans":[{"id":"spn-98146","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-98147","text":" to fill gaps"}]}],[{"id":"blk-67541","spans":[{"id":"spn-98148","text":"Stale graph"}]},{"id":"blk-67542","spans":[{"id":"spn-98149","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-98150","text":" for continuous sync"}]}]]},{"id":"blk-67543","kind":"heading","level":2,"spans":[{"id":"spn-98151","text":"Anti-patterns to avoid"}]},{"id":"blk-67544","items":[{"blocks":[{"id":"blk-67546","kind":"paragraph","spans":[{"id":"spn-98152","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-67545","kind":"list-item"},{"blocks":[{"id":"blk-67548","kind":"paragraph","spans":[{"id":"spn-98153","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-67547","kind":"list-item"},{"blocks":[{"id":"blk-67550","kind":"paragraph","spans":[{"id":"spn-98154","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-67549","kind":"list-item"},{"blocks":[{"id":"blk-67552","kind":"paragraph","spans":[{"id":"spn-98155","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-67551","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierav4q266sprwnvongfzdwigkaqpdvntumeptltfdn6b7dkbx6m6klq","vocabulary":"ampersand.docs.fs.v1"}