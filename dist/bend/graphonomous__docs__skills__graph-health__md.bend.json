{"bendscript":"0.1","blocks":[{"id":"blk-42762","kind":"paragraph","spans":[{"id":"spn-48201","text":"--- name: graph-health description: Use when the user asks \"is the graph healthy?\", \"run diagnostics\", \"graph quality\", \"check graph health\", \"memory health\", \"audit the graph\", \"how big is the graph?\", \"any problems?\", or wants a combined health report. Runs stats, identifies weak nodes, checks for orphans, and reports frontier uncertainty. Routes through "},{"id":"spn-48202","marks":["code"],"text":"consolidate"},{"id":"spn-48203","text":", "},{"id":"spn-48204","marks":["code"],"text":"retrieve"},{"id":"spn-48205","text":", and "},{"id":"spn-48206","marks":["code"],"text":"act"},{"id":"spn-48207","text":" machines. argument-hint: [--full] [--fix] ---"}]},{"id":"blk-42763","kind":"heading","level":1,"spans":[{"id":"spn-48208","text":"Graph Health Check"}]},{"id":"blk-42764","kind":"paragraph","spans":[{"id":"spn-48209","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-42765","kind":"heading","level":2,"spans":[{"id":"spn-48210","text":"Arguments"}]},{"id":"blk-42766","kind":"paragraph","spans":[{"id":"spn-48211","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-42767","items":[{"blocks":[{"id":"blk-42769","kind":"paragraph","spans":[{"id":"spn-48212","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-42768","kind":"list-item"},{"blocks":[{"id":"blk-42771","kind":"paragraph","spans":[{"id":"spn-48213","marks":["code"],"text":"--full"},{"id":"spn-48214","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-42770","kind":"list-item"},{"blocks":[{"id":"blk-42773","kind":"paragraph","spans":[{"id":"spn-48215","marks":["code"],"text":"--fix"},{"id":"spn-48216","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-42772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42774","kind":"heading","level":2,"spans":[{"id":"spn-48217","text":"Quick Health Check"}]},{"id":"blk-42775","kind":"heading","level":3,"spans":[{"id":"spn-48218","text":"Step 1 — Graph stats"}]},{"id":"blk-42776","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-42777","kind":"paragraph","spans":[{"id":"spn-48219","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-42778","kind":"heading","level":3,"spans":[{"id":"spn-48220","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-42780","spans":[{"id":"spn-48221","text":"Metric"}]},{"id":"blk-42781","spans":[{"id":"spn-48222","text":"Healthy"}]},{"id":"blk-42782","spans":[{"id":"spn-48223","text":"Warning"}]},{"id":"blk-42783","spans":[{"id":"spn-48224","text":"Critical"}]}],"id":"blk-42779","kind":"table","rows":[[{"id":"blk-42784","spans":[{"id":"spn-48225","text":"Orphan ratio"}]},{"id":"blk-42785","spans":[{"id":"spn-48226","text":"< 10%"}]},{"id":"blk-42786","spans":[{"id":"spn-48227","text":"10–30%"}]},{"id":"blk-42787","spans":[{"id":"spn-48228","text":"> 30%"}]}],[{"id":"blk-42788","spans":[{"id":"spn-48229","text":"Mean confidence"}]},{"id":"blk-42789","spans":[{"id":"spn-48230","text":"> 0.5"}]},{"id":"blk-42790","spans":[{"id":"spn-48231","text":"0.3–0.5"}]},{"id":"blk-42791","spans":[{"id":"spn-48232","text":"< 0.3"}]}],[{"id":"blk-42792","spans":[{"id":"spn-48233","text":"Edge/node ratio"}]},{"id":"blk-42793","spans":[{"id":"spn-48234","text":"> 1.5"}]},{"id":"blk-42794","spans":[{"id":"spn-48235","text":"0.5–1.5"}]},{"id":"blk-42795","spans":[{"id":"spn-48236","text":"< 0.5"}]}],[{"id":"blk-42796","spans":[{"id":"spn-48237","text":"Confidence std_dev"}]},{"id":"blk-42797","spans":[{"id":"spn-48238","text":"< 0.25"}]},{"id":"blk-42798","spans":[{"id":"spn-48239","text":"0.25–0.35"}]},{"id":"blk-42799","spans":[{"id":"spn-48240","text":"> 0.35"}]}]]},{"id":"blk-42800","kind":"paragraph","spans":[{"id":"spn-48241","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-42802","kind":"paragraph","spans":[{"id":"spn-48242","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-48243","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-42801","kind":"quote"},{"id":"blk-42803","kind":"heading","level":2,"spans":[{"id":"spn-48244","text":"Full Audit (--full)"}]},{"id":"blk-42804","kind":"heading","level":3,"spans":[{"id":"spn-48245","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-42805","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-42806","kind":"paragraph","spans":[{"id":"spn-48246","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-42807","kind":"heading","level":3,"spans":[{"id":"spn-48247","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-42808","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-42809","kind":"paragraph","spans":[{"id":"spn-48248","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-42810","kind":"heading","level":3,"spans":[{"id":"spn-48249","text":"Step 5 — Check for staleness"}]},{"id":"blk-42811","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-42812","kind":"paragraph","spans":[{"id":"spn-48250","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-42813","kind":"heading","level":3,"spans":[{"id":"spn-48251","text":"Step 6 — Orphan details"}]},{"id":"blk-42814","kind":"paragraph","spans":[{"id":"spn-48252","text":"If orphan count > 10%, list them:"}]},{"id":"blk-42815","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-42816","kind":"paragraph","spans":[{"id":"spn-48253","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-42817","kind":"heading","level":2,"spans":[{"id":"spn-48254","text":"Auto-Fix (--fix)"}]},{"id":"blk-42818","kind":"paragraph","spans":[{"id":"spn-48255","text":"When "},{"id":"spn-48256","marks":["code"],"text":"--fix"},{"id":"spn-48257","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-42819","kind":"heading","level":3,"spans":[{"id":"spn-48258","text":"Fix orphans — connect or prune"}]},{"id":"blk-42820","kind":"paragraph","spans":[{"id":"spn-48259","text":"For each orphan node: 1. Search for related nodes: "},{"id":"spn-48260","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"},{"id":"spn-48261","text":" 2. If similarity > 0.5 with any node → create "},{"id":"spn-48262","marks":["code"],"text":"related_to"},{"id":"spn-48263","text":" edge 3. If no matches and confidence < 0.3 → prune: "},{"id":"spn-48264","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-42821","kind":"heading","level":3,"spans":[{"id":"spn-48265","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-42822","kind":"paragraph","spans":[{"id":"spn-48266","text":"For nodes with confidence < 0.2: 1. Check if still relevant (search for supporting context) 2. If supporting evidence exists → "},{"id":"spn-48267","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"},{"id":"spn-48268","text":" 3. If no support → "},{"id":"spn-48269","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]},{"id":"blk-42823","kind":"heading","level":3,"spans":[{"id":"spn-48270","text":"Fix staleness — flag for sync"}]},{"id":"blk-42824","kind":"paragraph","spans":[{"id":"spn-48271","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-48272","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-48273","text":" to ingest recent filesystem changes."}]},{"id":"blk-42825","kind":"heading","level":2,"spans":[{"id":"spn-48274","text":"Health Report Format"}]},{"id":"blk-42826","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-42827","kind":"heading","level":2,"spans":[{"id":"spn-48275","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-42829","spans":[{"id":"spn-48276","text":"Situation"}]},{"id":"blk-42830","spans":[{"id":"spn-48277","text":"Follow-up"}]}],"id":"blk-42828","kind":"table","rows":[[{"id":"blk-42831","spans":[{"id":"spn-48278","text":"High orphan count"}]},{"id":"blk-42832","spans":[{"id":"spn-48279","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-48280","text":" to rebuild edges"}]}],[{"id":"blk-42833","spans":[{"id":"spn-48281","text":"Low mean confidence"}]},{"id":"blk-42834","spans":[{"id":"spn-48282","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-48283","text":" to merge and strengthen"}]}],[{"id":"blk-42835","spans":[{"id":"spn-48284","text":"Frontier gaps"}]},{"id":"blk-42836","spans":[{"id":"spn-48285","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-48286","text":" to fill gaps"}]}],[{"id":"blk-42837","spans":[{"id":"spn-48287","text":"Stale graph"}]},{"id":"blk-42838","spans":[{"id":"spn-48288","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-48289","text":" for continuous sync"}]}]]},{"id":"blk-42839","kind":"heading","level":2,"spans":[{"id":"spn-48290","text":"Anti-patterns to avoid"}]},{"id":"blk-42840","items":[{"blocks":[{"id":"blk-42842","kind":"paragraph","spans":[{"id":"spn-48291","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-42841","kind":"list-item"},{"blocks":[{"id":"blk-42844","kind":"paragraph","spans":[{"id":"spn-48292","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-42843","kind":"list-item"},{"blocks":[{"id":"blk-42846","kind":"paragraph","spans":[{"id":"spn-48293","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-42845","kind":"list-item"},{"blocks":[{"id":"blk-42848","kind":"paragraph","spans":[{"id":"spn-48294","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-42847","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieradxhliezd4ld4skfr4p72fq5xiivyamxykaluygex5xr6rbv6eujq","vocabulary":"ampersand.docs.fs.v1"}