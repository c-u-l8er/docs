{"bendscript":"0.1","blocks":[{"id":"blk-74947","kind":"heading","level":1,"spans":[{"id":"spn-137629","text":"Graph Health Check"}]},{"id":"blk-74948","kind":"paragraph","spans":[{"id":"spn-137630","text":"Combined diagnostic that assesses knowledge graph quality in one pass."}]},{"id":"blk-74949","kind":"heading","level":2,"spans":[{"id":"spn-137631","text":"Arguments"}]},{"id":"blk-74950","kind":"paragraph","spans":[{"id":"spn-137632","text":"Optional flags: $ARGUMENTS"}]},{"id":"blk-74951","items":[{"blocks":[{"id":"blk-74953","kind":"paragraph","spans":[{"id":"spn-137633","text":"No arguments: quick health summary (stats + top issues)"}]}],"id":"blk-74952","kind":"list-item"},{"blocks":[{"id":"blk-74955","kind":"paragraph","spans":[{"id":"spn-137634","marks":["code"],"text":"--full"},{"id":"spn-137635","text":": deep audit (stats + weak nodes + orphans + frontier + staleness)"}]}],"id":"blk-74954","kind":"list-item"},{"blocks":[{"id":"blk-74957","kind":"paragraph","spans":[{"id":"spn-137636","marks":["code"],"text":"--fix"},{"id":"spn-137637","text":": auto-fix found issues (prune orphans, decay stale nodes)"}]}],"id":"blk-74956","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74958","kind":"heading","level":2,"spans":[{"id":"spn-137638","text":"Quick Health Check"}]},{"id":"blk-74959","kind":"heading","level":3,"spans":[{"id":"spn-137639","text":"Step 1 — Graph stats"}]},{"id":"blk-74960","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-74961","kind":"paragraph","spans":[{"id":"spn-137640","text":"Returns: node count, edge count, type distributions, confidence stats (mean/min/max/std_dev), orphan count."}]},{"id":"blk-74962","kind":"heading","level":3,"spans":[{"id":"spn-137641","text":"Step 2 — Interpret and report"}]},{"head":[{"id":"blk-74964","spans":[{"id":"spn-137642","text":"Metric"}]},{"id":"blk-74965","spans":[{"id":"spn-137643","text":"Healthy"}]},{"id":"blk-74966","spans":[{"id":"spn-137644","text":"Warning"}]},{"id":"blk-74967","spans":[{"id":"spn-137645","text":"Critical"}]}],"id":"blk-74963","kind":"table","rows":[[{"id":"blk-74968","spans":[{"id":"spn-137646","text":"Orphan ratio"}]},{"id":"blk-74969","spans":[{"id":"spn-137647","text":"< 10%"}]},{"id":"blk-74970","spans":[{"id":"spn-137648","text":"10–30%"}]},{"id":"blk-74971","spans":[{"id":"spn-137649","text":"> 30%"}]}],[{"id":"blk-74972","spans":[{"id":"spn-137650","text":"Mean confidence"}]},{"id":"blk-74973","spans":[{"id":"spn-137651","text":"> 0.5"}]},{"id":"blk-74974","spans":[{"id":"spn-137652","text":"0.3–0.5"}]},{"id":"blk-74975","spans":[{"id":"spn-137653","text":"< 0.3"}]}],[{"id":"blk-74976","spans":[{"id":"spn-137654","text":"Edge/node ratio"}]},{"id":"blk-74977","spans":[{"id":"spn-137655","text":"> 1.5"}]},{"id":"blk-74978","spans":[{"id":"spn-137656","text":"0.5–1.5"}]},{"id":"blk-74979","spans":[{"id":"spn-137657","text":"< 0.5"}]}],[{"id":"blk-74980","spans":[{"id":"spn-137658","text":"Confidence std_dev"}]},{"id":"blk-74981","spans":[{"id":"spn-137659","text":"< 0.25"}]},{"id":"blk-74982","spans":[{"id":"spn-137660","text":"0.25–0.35"}]},{"id":"blk-74983","spans":[{"id":"spn-137661","text":"> 0.35"}]}]]},{"id":"blk-74984","kind":"paragraph","spans":[{"id":"spn-137662","text":"Report a summary like:"}]},{"blocks":[{"id":"blk-74986","kind":"paragraph","spans":[{"id":"spn-137663","marks":["bold"],"text":"Graph Health: Good"},{"id":"spn-137664","text":" — 142 nodes, 238 edges (1.68 edge/node), mean confidence 0.64, 8 orphans (5.6%)"}]}],"id":"blk-74985","kind":"quote"},{"id":"blk-74987","kind":"heading","level":2,"spans":[{"id":"spn-137665","text":"Full Audit (--full)"}]},{"id":"blk-74988","kind":"heading","level":3,"spans":[{"id":"spn-137666","text":"Step 3 — Find weak knowledge"}]},{"id":"blk-74989","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3, limit: 20)"},{"id":"blk-74990","kind":"paragraph","spans":[{"id":"spn-137667","text":"Nodes below 0.3 confidence are speculative — candidates for reinforcement or pruning."}]},{"id":"blk-74991","kind":"heading","level":3,"spans":[{"id":"spn-137668","text":"Step 4 — Epistemic frontier"}]},{"id":"blk-74992","kind":"code","language":"text","text":"retrieve(action: \"frontier\", limit: 10)"},{"id":"blk-74993","kind":"paragraph","spans":[{"id":"spn-137669","text":"Identifies where uncertainty is highest — the most valuable areas to investigate next."}]},{"id":"blk-74994","kind":"heading","level":3,"spans":[{"id":"spn-137670","text":"Step 5 — Check for staleness"}]},{"id":"blk-74995","kind":"code","language":"text","text":"retrieve(action: \"episodic\", since: null, until: null, limit: 5)"},{"id":"blk-74996","kind":"paragraph","spans":[{"id":"spn-137671","text":"If the most recent episodic node is old, the graph may be stale."}]},{"id":"blk-74997","kind":"heading","level":3,"spans":[{"id":"spn-137672","text":"Step 6 — Orphan details"}]},{"id":"blk-74998","kind":"paragraph","spans":[{"id":"spn-137673","text":"If orphan count > 10%, list them:"}]},{"id":"blk-74999","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", limit: 50)"},{"id":"blk-75000","kind":"paragraph","spans":[{"id":"spn-137674","text":"Cross-reference with edge data to identify which nodes lack connections."}]},{"id":"blk-75001","kind":"heading","level":2,"spans":[{"id":"spn-137675","text":"Auto-Fix (--fix)"}]},{"id":"blk-75002","kind":"paragraph","spans":[{"id":"spn-137676","text":"When "},{"id":"spn-137677","marks":["code"],"text":"--fix"},{"id":"spn-137678","text":" is passed, take corrective action on found issues:"}]},{"id":"blk-75003","kind":"heading","level":3,"spans":[{"id":"spn-137679","text":"Fix orphans — connect or prune"}]},{"id":"blk-75004","kind":"paragraph","spans":[{"id":"spn-137680","text":"For each orphan node:"}]},{"id":"blk-75005","items":[{"blocks":[{"id":"blk-75007","kind":"paragraph","spans":[{"id":"spn-137681","text":"Search for related nodes: "},{"id":"spn-137682","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<orphan content>\", limit: 3)"}]}],"id":"blk-75006","kind":"list-item"},{"blocks":[{"id":"blk-75009","kind":"paragraph","spans":[{"id":"spn-137683","text":"If similarity > 0.5 with any node → create "},{"id":"spn-137684","marks":["code"],"text":"related_to"},{"id":"spn-137685","text":" edge"}]}],"id":"blk-75008","kind":"list-item"},{"blocks":[{"id":"blk-75011","kind":"paragraph","spans":[{"id":"spn-137686","text":"If no matches and confidence < 0.3 → prune: "},{"id":"spn-137687","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-75010","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75012","kind":"heading","level":3,"spans":[{"id":"spn-137688","text":"Fix weak nodes — reinforce or decay"}]},{"id":"blk-75013","kind":"paragraph","spans":[{"id":"spn-137689","text":"For nodes with confidence < 0.2:"}]},{"id":"blk-75014","items":[{"blocks":[{"id":"blk-75016","kind":"paragraph","spans":[{"id":"spn-137690","text":"Check if still relevant (search for supporting context)"}]}],"id":"blk-75015","kind":"list-item"},{"blocks":[{"id":"blk-75018","kind":"paragraph","spans":[{"id":"spn-137691","text":"If supporting evidence exists → "},{"id":"spn-137692","marks":["code"],"text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")"}]}],"id":"blk-75017","kind":"list-item"},{"blocks":[{"id":"blk-75020","kind":"paragraph","spans":[{"id":"spn-137693","text":"If no support → "},{"id":"spn-137694","marks":["code"],"text":"act(action: \"forget_node\", node_id: \"<id>\", strategy: \"soft\")"}]}],"id":"blk-75019","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75021","kind":"heading","level":3,"spans":[{"id":"spn-137695","text":"Fix staleness — flag for sync"}]},{"id":"blk-75022","kind":"paragraph","spans":[{"id":"spn-137696","text":"If graph is stale (no episodic nodes in 7+ days), recommend running "},{"id":"spn-137697","marks":["code"],"text":"/graphonomous:sync"},{"id":"spn-137698","text":" to ingest recent filesystem changes."}]},{"id":"blk-75023","kind":"heading","level":2,"spans":[{"id":"spn-137699","text":"Health Report Format"}]},{"id":"blk-75024","kind":"code","language":"text","text":"## Graph Health Report\n\n**Overall: [Good|Warning|Critical]**\n\n| Metric          | Value | Status |\n|-----------------|-------|--------|\n| Nodes           | 142   | —      |\n| Edges           | 238   | —      |\n| Edge/Node Ratio | 1.68  | ✓      |\n| Mean Confidence | 0.64  | ✓      |\n| Orphans         | 8 (5.6%) | ✓   |\n| Weakest Nodes   | 3 below 0.2 | ⚠  |\n\n**Top Issues:**\n1. 3 nodes below 0.2 confidence — candidates for reinforcement\n2. Frontier suggests investigating: [topic areas]\n\n**Recommendations:**\n- Run `/graphonomous:sync` to update filesystem nodes\n- Review weak nodes: [list IDs]"},{"id":"blk-75025","kind":"heading","level":2,"spans":[{"id":"spn-137700","text":"Combining with Other Skills"}]},{"head":[{"id":"blk-75027","spans":[{"id":"spn-137701","text":"Situation"}]},{"id":"blk-75028","spans":[{"id":"spn-137702","text":"Follow-up"}]}],"id":"blk-75026","kind":"table","rows":[[{"id":"blk-75029","spans":[{"id":"spn-137703","text":"High orphan count"}]},{"id":"blk-75030","spans":[{"id":"spn-137704","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-137705","text":" to rebuild edges"}]}],[{"id":"blk-75031","spans":[{"id":"spn-137706","text":"Low mean confidence"}]},{"id":"blk-75032","spans":[{"id":"spn-137707","marks":["code"],"text":"/graphonomous:consolidate"},{"id":"spn-137708","text":" to merge and strengthen"}]}],[{"id":"blk-75033","spans":[{"id":"spn-137709","text":"Frontier gaps"}]},{"id":"blk-75034","spans":[{"id":"spn-137710","marks":["code"],"text":"/graphonomous:retrieve <frontier topic>"},{"id":"spn-137711","text":" to fill gaps"}]}],[{"id":"blk-75035","spans":[{"id":"spn-137712","text":"Stale graph"}]},{"id":"blk-75036","spans":[{"id":"spn-137713","marks":["code"],"text":"/graphonomous:watch <dir>"},{"id":"spn-137714","text":" for continuous sync"}]}]]},{"id":"blk-75037","kind":"heading","level":2,"spans":[{"id":"spn-137715","text":"Anti-patterns to avoid"}]},{"id":"blk-75038","items":[{"blocks":[{"id":"blk-75040","kind":"paragraph","spans":[{"id":"spn-137716","text":"Running health checks too frequently — once per session or after major changes is enough"}]}],"id":"blk-75039","kind":"list-item"},{"blocks":[{"id":"blk-75042","kind":"paragraph","spans":[{"id":"spn-137717","text":"Auto-fixing without reporting what was changed — always show the user what --fix did"}]}],"id":"blk-75041","kind":"list-item"},{"blocks":[{"id":"blk-75044","kind":"paragraph","spans":[{"id":"spn-137718","text":"Treating orphans as always bad — some nodes are intentionally standalone (e.g., one-off observations)"}]}],"id":"blk-75043","kind":"list-item"},{"blocks":[{"id":"blk-75046","kind":"paragraph","spans":[{"id":"spn-137719","text":"Ignoring the frontier — it tells you where to invest learning effort next"}]}],"id":"blk-75045","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraioic3wqb77myg4ldolscbjfk5zqx2bxlvbtmjrywlxshz4aap4qq","vocabulary":"ampersand.docs.fs.v1"}