tem"},{"blocks":[{"id":"blk-39818","kind":"paragraph","spans":[{"id":"spn-45336","marks":["bold"],"text":"Multi-timescale memory"},{"id":"spn-45337","text":" — edge SQLite + sqlite-vec, fleet-level PostGIS + Tile38"}]}],"id":"blk-39817","kind":"list-item"},{"blocks":[{"id":"blk-39820","kind":"paragraph","spans":[{"id":"spn-45338","marks":["bold"],"text":"MCP + A2A protocols"},{"id":"spn-45339","text":" — all capabilities exposed as MCP tools"}]}],"id":"blk-39819","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-39821","kind":"paragraph","spans":[{"id":"spn-45340","text":"---"}]},{"id":"blk-39822","kind":"heading","level":2,"spans":[{"id":"spn-45341","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-39824","spans":[{"id":"spn-45342","text":"Component"}]},{"id":"blk-39825","spans":[{"id":"spn-45343","text":"Role"}]},{"id":"blk-39826","spans":[{"id":"spn-45344","text":"OTP Pattern"}]}],"id":"blk-39823","kind":"table","rows":[[{"id":"blk-39827","spans":[{"id":"spn-45345","marks":["bold"],"text":"Fleet Tracker"}]},{"id":"blk-39828","spans":[{"id":"spn-45346","text":"Delta-CRDT spatial digital twins"}]},{"id":"blk-39829","spans":[{"id":"spn-45347","text":"GenServer per asset"}]}],[{"id":"blk-39830","spans":[{"id":"spn-45348","marks":["bold"],"text":"Route Optimizer"}]},{"id":"blk-39831","spans":[{"id":"spn-45349","text":"GNN-based continual route learning"}]},{"id":"blk-39832","spans":[{"id":"spn-45350","text":"GenServer + Nx"}]}],[{"id":"blk-39833","spans":[{"id":"spn-45351","marks":["bold"],"text":"Geofence Engine"}]},{"id":"blk-39834","spans":[{"id":"spn-45352","text":"Tile38-inspired boundary evaluation"}]},{"id":"blk-39835","spans":[{"id":"spn-45353","text":"Concurrent tasks"}]}],[{"id":"blk-39836","spans":[{"id":"spn-45354","marks":["bold"],"text":"Federated Coordinator"}]},{"id":"blk-39837","spans":[{"id":"spn-45355","text":"LoRA delta aggregation, privacy budgets"}]},{"id":"blk-39838","spans":[{"id":"spn-45356","text":"GenServer"}]}],[{"id":"b