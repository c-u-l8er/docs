{"bendscript":"0.1","blocks":[{"id":"blk-39965","kind":"heading","level":1,"spans":[{"id":"spn-44453","text":"graphonomous — NPM Package Specification"}]},{"id":"blk-39966","kind":"paragraph","spans":[{"id":"spn-44454","marks":["bold"],"text":"Package"},{"id":"spn-44455","text":": "},{"id":"spn-44456","marks":["code"],"text":"graphonomous"},{"id":"spn-44457","text":" "},{"id":"spn-44458","marks":["bold"],"text":"Version"},{"id":"spn-44459","text":": "},{"id":"spn-44460","marks":["code"],"text":"0.4.0"},{"id":"spn-44461","text":" (current) → "},{"id":"spn-44462","marks":["code"],"text":"0.4.1"},{"id":"spn-44463","text":" (three-package alignment bump) "},{"id":"spn-44464","marks":["bold"],"text":"Language"},{"id":"spn-44465","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-44466","marks":["bold"],"text":"License"},{"id":"spn-44467","text":": Apache-2.0 "},{"id":"spn-44468","marks":["bold"],"text":"Registry"},{"id":"spn-44469","text":": https://www.npmjs.com/package/graphonomous "},{"id":"spn-44470","marks":["bold"],"text":"Repository"},{"id":"spn-44471","text":": "},{"id":"spn-44472","marks":["code"],"text":"AmpersandBoxDesign/graphonomous"},{"id":"spn-44473","text":" (monorepo subdir)"}]},{"id":"blk-39967","kind":"heading","level":2,"spans":[{"id":"spn-44474","text":"Purpose"}]},{"id":"blk-39968","kind":"paragraph","spans":[{"id":"spn-44475","marks":["code"],"text":"graphonomous"},{"id":"spn-44476","text":" is the MCP server for the continual learning engine. It exposes the 5 Graphonomous loop-phase machines ("},{"id":"spn-44477","marks":["code"],"text":"retrieve"},{"id":"spn-44478","text":", "},{"id":"spn-44479","marks":["code"],"text":"route"},{"id":"spn-44480","text":", "},{"id":"spn-44481","marks":["code"],"text":"act"},{"id":"spn-44482","text":", "},{"id":"spn-44483","marks":["code"],"text":"learn"},{"id":"spn-44484","text":", "},{"id":"spn-44485","marks":["code"],"text":"consolidate"},{"id":"spn-44486","text":") over stdio and persists knowledge in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-39969","kind":"paragraph","spans":[{"id":"spn-44487","text":"This package already ships at v0.4.0 and serves as the "},{"id":"spn-44488","marks":["bold"],"text":"template"},{"id":"spn-44489","text":" for the other two packages in the three-package MCP stack. A v0.4.1 bump is required to:"}]},{"id":"blk-39970","kind":"paragraph","spans":[{"id":"spn-44490","text":"1. Update the package description to name the 5-machine surface (no more \"28 tools\" wording — the v1 tool surface is now legacy). 2. Update the README to reference the three-package install story. 3. Publish a "},{"id":"spn-44491","marks":["code"],"text":"graphonomous.continual_learning.pulse.json"},{"id":"spn-44492","text":" manifest so "},{"id":"spn-44493","marks":["code"],"text":"os-prism"},{"id":"spn-44494","text":" can benchmark against a canonical PULSE manifest. 4. Register itself with a running "},{"id":"spn-44495","marks":["code"],"text":"os-pulse"},{"id":"spn-44496","text":" instance at startup if one is configured (optional)."}]},{"id":"blk-39971","kind":"paragraph","spans":[{"id":"spn-44497","text":"No Elixir code changes are required. The existing vendored escript at "},{"id":"spn-44498","marks":["code"],"text":"graphonomous/npm/vendor/"},{"id":"spn-44499","text":" and the existing postinstall script continue to work."}]},{"id":"blk-39972","kind":"heading","level":2,"spans":[{"id":"spn-44500","text":"Install"}]},{"id":"blk-39973","kind":"code","language":"bash","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db"},{"id":"blk-39974","kind":"paragraph","spans":[{"id":"spn-44501","text":"Or in "},{"id":"spn-44502","marks":["code"],"text":".mcp.json"},{"id":"spn-44503","text":":"}]},{"id":"blk-39975","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"]\n    }\n  }\n}"},{"id":"blk-39976","kind":"heading","level":2,"spans":[{"id":"spn-44504","text":"MCP Surface — 5 Loop-Phase Machines"}]},{"head":[{"id":"blk-39978","spans":[{"id":"spn-44505","text":"Machine"}]},{"id":"blk-39979","spans":[{"id":"spn-44506","text":"Phase"}]},{"id":"blk-39980","spans":[{"id":"spn-44507","text":"Actions"}]}],"id":"blk-39977","kind":"table","rows":[[{"id":"blk-39981","spans":[{"id":"spn-44508","marks":["code"],"text":"retrieve"}]},{"id":"blk-39982","spans":[{"id":"spn-44509","text":"\"What do I know?\""}]},{"id":"blk-39983","spans":[{"id":"spn-44510","marks":["code"],"text":"context"},{"id":"spn-44511","text":", "},{"id":"spn-44512","marks":["code"],"text":"episodic"},{"id":"spn-44513","text":", "},{"id":"spn-44514","marks":["code"],"text":"procedural"},{"id":"spn-44515","text":", "},{"id":"spn-44516","marks":["code"],"text":"coverage"},{"id":"spn-44517","text":", "},{"id":"spn-44518","marks":["code"],"text":"trace_evidence"},{"id":"spn-44519","text":", "},{"id":"spn-44520","marks":["code"],"text":"frontier"}]}],[{"id":"blk-39984","spans":[{"id":"spn-44521","marks":["code"],"text":"route"}]},{"id":"blk-39985","spans":[{"id":"spn-44522","text":"\"What should I do?\""}]},{"id":"blk-39986","spans":[{"id":"spn-44523","marks":["code"],"text":"topology"},{"id":"spn-44524","text":", "},{"id":"spn-44525","marks":["code"],"text":"deliberate"},{"id":"spn-44526","text":", "},{"id":"spn-44527","marks":["code"],"text":"attention_survey"},{"id":"spn-44528","text":", "},{"id":"spn-44529","marks":["code"],"text":"attention_cycle"},{"id":"spn-44530","text":", "},{"id":"spn-44531","marks":["code"],"text":"review_goal"}]}],[{"id":"blk-39987","spans":[{"id":"spn-44532","marks":["code"],"text":"act"}]},{"id":"blk-39988","spans":[{"id":"spn-44533","text":"\"Do it\""}]},{"id":"blk-39989","spans":[{"id":"spn-44534","marks":["code"],"text":"store_node"},{"id":"spn-44535","text":", "},{"id":"spn-44536","marks":["code"],"text":"store_edge"},{"id":"spn-44537","text":",