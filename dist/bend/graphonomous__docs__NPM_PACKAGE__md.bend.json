{"bendscript":"0.1","blocks":[{"id":"blk-40451","kind":"heading","level":1,"spans":[{"id":"spn-45627","text":"graphonomous — NPM Package Specification"}]},{"id":"blk-40452","kind":"paragraph","spans":[{"id":"spn-45628","marks":["bold"],"text":"Package"},{"id":"spn-45629","text":": "},{"id":"spn-45630","marks":["code"],"text":"graphonomous"},{"id":"spn-45631","text":" "},{"id":"spn-45632","marks":["bold"],"text":"Version"},{"id":"spn-45633","text":": "},{"id":"spn-45634","marks":["code"],"text":"0.4.0"},{"id":"spn-45635","text":" (current) → "},{"id":"spn-45636","marks":["code"],"text":"0.4.1"},{"id":"spn-45637","text":" (three-package alignment bump) "},{"id":"spn-45638","marks":["bold"],"text":"Language"},{"id":"spn-45639","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-45640","marks":["bold"],"text":"License"},{"id":"spn-45641","text":": Apache-2.0 "},{"id":"spn-45642","marks":["bold"],"text":"Registry"},{"id":"spn-45643","text":": https://www.npmjs.com/package/graphonomous "},{"id":"spn-45644","marks":["bold"],"text":"Repository"},{"id":"spn-45645","text":": "},{"id":"spn-45646","marks":["code"],"text":"AmpersandBoxDesign/graphonomous"},{"id":"spn-45647","text":" (monorepo subdir)"}]},{"id":"blk-40453","kind":"heading","level":2,"spans":[{"id":"spn-45648","text":"Purpose"}]},{"id":"blk-40454","kind":"paragraph","spans":[{"id":"spn-45649","marks":["code"],"text":"graphonomous"},{"id":"spn-45650","text":" is the MCP server for the continual learning engine. It exposes the 5 Graphonomous loop-phase machines ("},{"id":"spn-45651","marks":["code"],"text":"retrieve"},{"id":"spn-45652","text":", "},{"id":"spn-45653","marks":["code"],"text":"route"},{"id":"spn-45654","text":", "},{"id":"spn-45655","marks":["code"],"text":"act"},{"id":"spn-45656","text":", "},{"id":"spn-45657","marks":["code"],"text":"learn"},{"id":"spn-45658","text":", "},{"id":"spn-45659","marks":["code"],"text":"consolidate"},{"id":"spn-45660","text":") over stdio and persists knowledge in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-40455","kind":"paragraph","spans":[{"id":"spn-45661","text":"This package already ships at v0.4.0 and serves as the "},{"id":"spn-45662","marks":["bold"],"text":"template"},{"id":"spn-45663","text":" for the other two packages in the three-package MCP stack. A v0.4.1 bump is required to:"}]},{"id":"blk-40456","kind":"paragraph","spans":[{"id":"spn-45664","text":"1. Update the package description to name the 5-machine surface (no more \"28 tools\" wording — the v1 tool surface is now legacy). 2. Update the README to reference the three-package install story. 3. Publish a "},{"id":"spn-45665","marks":["code"],"text":"graphonomous.continual_learning.pulse.json"},{"id":"spn-45666","text":" manifest so "},{"id":"spn-45667","marks":["code"],"text":"os-prism"},{"id":"spn-45668","text":" can benchmark against a canonical PULSE manifest. 4. Register itself with a running "},{"id":"spn-45669","marks":["code"],"text":"os-pulse"},{"id":"spn-45670","text":" instance at startup if one is configured (optional)."}]},{"id":"blk-40457","kind":"paragraph","spans":[{"id":"spn-45671","text":"No Elixir code changes are required. The existing vendored escript at "},{"id":"spn-45672","marks":["code"],"text":"graphonomous/npm/vendor/"},{"id":"spn-45673","text":" and the existing postinstall script continue to work."}]},{"id":"blk-40458","kind":"heading","level":2,"spans":[{"id":"spn-45674","text":"Install"}]},{"id":"blk-40459","kind":"code","language":"bash","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db"},{"id":"blk-40460","kind":"paragraph","spans":[{"id":"spn-45675","text":"Or in "},{"id":"spn-45676","marks":["code"],"text":".mcp.json"},{"id":"spn-45677","text":":"}]},{"id":"blk-40461","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"]\n    }\n  }\n}"},{"id":"blk-40462","kind":"heading","level":2,"spans":[{"id":"spn-45678","text":"MCP Surface — 5 Loop-Phase Machines"}]},{"head":[{"id":"blk-40464","spans":[{"id":"spn-45679","text":"Machine"}]},{"id":"blk-40465","spans":[{"id":"spn-45680","text":"Phase"}]},{"id":"blk-40466","spans":[{"id":"spn-45681","text":"Actions"}]}],"id":"blk-40463","kind":"table","rows":[[{"id":"blk-40467","spans":[{"id":"spn-45682","marks":["code"],"text":"retrieve"}]},{"id":"blk-40468","spans":[{"id":"spn-45683","text":"\"What do I know?\""}]},{"id":"blk-40469","spans":[{"id":"spn-45684","marks":["code"],"text":"context"},{"id":"spn-45685","text":", "},{"id":"spn-45686","marks":["code"],"text":"episodic"},{"id":"spn-45687","text":", "},{"id":"spn-45688","marks":["code"],"text":"procedural"},{"id":"spn-45689","text":", "},{"id":"spn-45690","marks":["code"],"text":"coverage"},{"id":"spn-45691","text":", "},{"id":"spn-45692","marks":["code"],"text":"trace_evidence"},{"id":"spn-45693","text":", "},{"id":"spn-45694","marks":["code"],"text":"frontier"}]}],[{"id":"blk-40470","spans":[{"id":"spn-45695","marks":["code"],"text":"route"}]},{"id":"blk-40471","spans":[{"id":"spn-45696","text":"\"What should I do?\""}]},{"id":"blk-40472","spans":[{"id":"spn-45697","marks":["code"],"text":"topology"},{"id":"spn-45698","text":", "},{"id":"spn-45699","marks":["code"],"text":"deliberate"},{"id":"spn-45700","text":", "},{"id":"spn-45701","marks":["code"],"text":"attention_survey"},{"id":"spn-45702","text":", "},{"id":"spn-45703","marks":["code"],"text":"attention_cycle"},{"id":"spn-45704","text":", "},{"id":"spn-45705","marks":["code"],"text":"review_goal"}]}],[{"id":"blk-40473","spans":[{"id":"spn-45706","marks":["code"],"text":"act"}]},{"id":"blk-40474","spans":[{"id":"spn-45707","text":"\"Do it\""}]},{"id":"blk-40475","spans":[{"id":"spn-45708","marks":["code"],"text":"store_node"},{"id":"spn-45709","text":", "},{"id":"spn-45710","marks":["code"],"text":"store_edge"},{"id":"spn-45711","text":",