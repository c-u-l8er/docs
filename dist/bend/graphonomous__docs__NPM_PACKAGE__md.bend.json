{"bendscript":"0.1","blocks":[{"id":"blk-40937","kind":"heading","level":1,"spans":[{"id":"spn-46747","text":"graphonomous — NPM Package Specification"}]},{"id":"blk-40938","kind":"paragraph","spans":[{"id":"spn-46748","marks":["bold"],"text":"Package"},{"id":"spn-46749","text":": "},{"id":"spn-46750","marks":["code"],"text":"graphonomous"},{"id":"spn-46751","text":" "},{"id":"spn-46752","marks":["bold"],"text":"Version"},{"id":"spn-46753","text":": "},{"id":"spn-46754","marks":["code"],"text":"0.4.0"},{"id":"spn-46755","text":" (current) → "},{"id":"spn-46756","marks":["code"],"text":"0.4.1"},{"id":"spn-46757","text":" (three-package alignment bump) "},{"id":"spn-46758","marks":["bold"],"text":"Language"},{"id":"spn-46759","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-46760","marks":["bold"],"text":"License"},{"id":"spn-46761","text":": Apache-2.0 "},{"id":"spn-46762","marks":["bold"],"text":"Registry"},{"id":"spn-46763","text":": https://www.npmjs.com/package/graphonomous "},{"id":"spn-46764","marks":["bold"],"text":"Repository"},{"id":"spn-46765","text":": "},{"id":"spn-46766","marks":["code"],"text":"AmpersandBoxDesign/graphonomous"},{"id":"spn-46767","text":" (monorepo subdir)"}]},{"id":"blk-40939","kind":"heading","level":2,"spans":[{"id":"spn-46768","text":"Purpose"}]},{"id":"blk-40940","kind":"paragraph","spans":[{"id":"spn-46769","marks":["code"],"text":"graphonomous"},{"id":"spn-46770","text":" is the MCP server for the continual learning engine. It exposes the 5 Graphonomous loop-phase machines ("},{"id":"spn-46771","marks":["code"],"text":"retrieve"},{"id":"spn-46772","text":", "},{"id":"spn-46773","marks":["code"],"text":"route"},{"id":"spn-46774","text":", "},{"id":"spn-46775","marks":["code"],"text":"act"},{"id":"spn-46776","text":", "},{"id":"spn-46777","marks":["code"],"text":"learn"},{"id":"spn-46778","text":", "},{"id":"spn-46779","marks":["code"],"text":"consolidate"},{"id":"spn-46780","text":") over stdio and persists knowledge in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-40941","kind":"paragraph","spans":[{"id":"spn-46781","text":"This package already ships at v0.4.0 and serves as the "},{"id":"spn-46782","marks":["bold"],"text":"template"},{"id":"spn-46783","text":" for the other two packages in the three-package MCP stack. A v0.4.1 bump is required to:"}]},{"id":"blk-40942","kind":"paragraph","spans":[{"id":"spn-46784","text":"1. Update the package description to name the 5-machine surface (no more \"28 tools\" wording — the v1 tool surface is now legacy). 2. Update the README to reference the three-package install story. 3. Publish a "},{"id":"spn-46785","marks":["code"],"text":"graphonomous.continual_learning.pulse.json"},{"id":"spn-46786","text":" manifest so "},{"id":"spn-46787","marks":["code"],"text":"os-prism"},{"id":"spn-46788","text":" can benchmark against a canonical PULSE manifest. 4. Register itself with a running "},{"id":"spn-46789","marks":["code"],"text":"os-pulse"},{"id":"spn-46790","text":" instance at startup if one is configured (optional)."}]},{"id":"blk-40943","kind":"paragraph","spans":[{"id":"spn-46791","text":"No Elixir code changes are required. The existing vendored escript at "},{"id":"spn-46792","marks":["code"],"text":"graphonomous/npm/vendor/"},{"id":"spn-46793","text":" and the existing postinstall script continue to work."}]},{"id":"blk-40944","kind":"heading","level":2,"spans":[{"id":"spn-46794","text":"Install"}]},{"id":"blk-40945","kind":"code","language":"bash","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db"},{"id":"blk-40946","kind":"paragraph","spans":[{"id":"spn-46795","text":"Or in "},{"id":"spn-46796","marks":["code"],"text":".mcp.json"},{"id":"spn-46797","text":":"}]},{"id":"blk-40947","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"]\n    }\n  }\n}"},{"id":"blk-40948","kind":"heading","level":2,"spans":[{"id":"spn-46798","text":"MCP Surface — 5 Loop-Phase Machines"}]},{"head":[{"id":"blk-40950","spans":[{"id":"spn-46799","text":"Machine"}]},{"id":"blk-40951","spans":[{"id":"spn-46800","text":"Phase"}]},{"id":"blk-40952","spans":[{"id":"spn-46801","text":"Actions"}]}],"id":"blk-40949","kind":"table","rows":[[{"id":"blk-40953","spans":[{"id":"spn-46802","marks":["code"],"text":"retrieve"}]},{"id":"blk-40954","spans":[{"id":"spn-46803","text":"\"What do I know?\""}]},{"id":"blk-40955","spans":[{"id":"spn-46804","marks":["code"],"text":"context"},{"id":"spn-46805","text":", "},{"id":"spn-46806","marks":["code"],"text":"episodic"},{"id":"spn-46807","text":", "},{"id":"spn-46808","marks":["code"],"text":"procedural"},{"id":"spn-46809","text":", "},{"id":"spn-46810","marks":["code"],"text":"coverage"},{"id":"spn-46811","text":", "},{"id":"spn-46812","marks":["code"],"text":"trace_evidence"},{"id":"spn-46813","text":", "},{"id":"spn-46814","marks":["code"],"text":"frontier"}]}],[{"id":"blk-40956","spans":[{"id":"spn-46815","marks":["code"],"text":"route"}]},{"id":"blk-40957","spans":[{"id":"spn-46816","text":"\"What should I do?\""}]},{"id":"blk-40958","spans":[{"id":"spn-46817","marks":["code"],"text":"topology"},{"id":"spn-46818","text":", "},{"id":"spn-46819","marks":["code"],"text":"deliberate"},{"id":"spn-46820","text":", "},{"id":"spn-46821","marks":["code"],"text":"attention_survey"},{"id":"spn-46822","text":", "},{"id":"spn-46823","marks":["code"],"text":"attention_cycle"},{"id":"spn-46824","text":", "},{"id":"spn-46825","marks":["code"],"text":"review_goal"}]}],[{"id":"blk-40959","spans":[{"id":"spn-46826","marks":["code"],"text":"act"}]},{"id":"blk-40960","spans":[{"id":"spn-46827","text":"\"Do it\""}]},{"id":"blk-40961","spans":[{"id":"spn-46828","marks":["code"],"text":"store_node"},{"id":"spn-46829","text":", "},{"id":"spn-46830","marks":["code"],"text":"store_edge"},{"id":"spn-46831","text":",