{"bendscript":"0.1","blocks":[{"id":"blk-32362","kind":"heading","level":1,"spans":[{"id":"spn-37096","text":"ADR-0002: Use Supabase as the Control Plane Backend (PostgreSQL + Edge Functions)"}]},{"id":"blk-32363","items":[{"blocks":[{"id":"blk-32365","kind":"paragraph","spans":[{"id":"spn-37097","marks":["bold"],"text":"Status:"},{"id":"spn-37098","text":" Accepted (v1)"}]}],"id":"blk-32364","kind":"list-item"},{"blocks":[{"id":"blk-32367","kind":"paragraph","spans":[{"id":"spn-37099","marks":["bold"],"text":"Date:"},{"id":"spn-37100","text":" 2026-03-28"}]}],"id":"blk-32366","kind":"list-item"},{"blocks":[{"id":"blk-32369","kind":"paragraph","spans":[{"id":"spn-37101","marks":["bold"],"text":"Supersedes:"},{"id":"spn-37102","text":" ADR-0002 (Convex, 2026-01-21)"}]}],"id":"blk-32368","kind":"list-item"},{"blocks":[{"id":"blk-32371","kind":"paragraph","spans":[{"id":"spn-37103","marks":["bold"],"text":"Owners:"},{"id":"spn-37104","text":" webhost.systems engineering"}]}],"id":"blk-32370","kind":"list-item"},{"blocks":[{"id":"blk-32373","kind":"paragraph","spans":[{"id":"spn-37105","marks":["bold"],"text":"Related docs:"},{"id":"spn-37106","text":" "},{"id":"spn-37107","marks":["code"],"text":"docs/spec/00_MASTER_SPEC.md"},{"id":"spn-37108","text":", "},{"id":"spn-37109","marks":["code"],"text":"docs/spec/10_API_CONTRACTS.md"},{"id":"spn-37110","text":", "},{"id":"spn-37111","marks":["code"],"text":"docs/spec/30_DATA_MODEL_SUPABASE.md"},{"id":"spn-37112","text":", "},{"id":"spn-37113","marks":["code"],"text":"docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-32372","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32374","kind":"paragraph","spans":[{"id":"spn-37114","text":"---"}]},{"id":"blk-32375","kind":"heading","level":2,"spans":[{"id":"spn-37115","text":"1) Context"}]},{"id":"blk-32376","kind":"paragraph","spans":[{"id":"spn-37116","text":"webhost.systems is a multi-runtime AI agent platform. The system has a clear separation:"}]},{"id":"blk-32377","items":[{"blocks":[{"id":"blk-32379","kind":"paragraph","spans":[{"id":"spn-37117","marks":["bold"],"text":"Data plane:"},{"id":"spn-37118","text":" runtime providers where untrusted customer agent code executes (Cloudflare Workers/DO, AWS Bedrock AgentCore)."}]}],"id":"blk-32378","kind":"list-item"},{"blocks":[{"id":"blk-32381","kind":"paragraph","spans":[{"id":"spn-37119","marks":["bold"],"text":"Control plane:"},{"id":"spn-37120","text":" trusted backend responsible for:"}]}],"id":"blk-32380","kind":"list-item"},{"blocks":[{"id":"blk-32383","kind":"paragraph","spans":[{"id":"spn-37121","text":"authentication/authorization and tenant isolation,"}]}],"id":"blk-32382","kind":"list-item"},{"blocks":[{"id":"blk-32385","kind":"paragraph","spans":[{"id":"spn-37122","text":"agent + deployment orchestration,"}]}],"id":"blk-32384","kind":"list-item"},{"blocks":[{"id":"blk-32387","kind":"paragraph","spans":[{"id":"spn-37123","text":"secrets metadata and provider secret injection workflows,"}]}],"id":"blk-32386","kind":"list-item"},{"blocks":[{"id":"blk-32389","kind":"paragraph","spans":[{"id":"spn-37124","text":"invocation gateway routing + plan enforcement,"}]}],"id":"blk-32388","kind":"list-item"},{"blocks":[{"id":"blk-32391","kind":"paragraph","spans":[{"id":"spn-37125","text":"telemetry ingestion integrity and aggregation,"}]}],"id":"blk-32390","kind":"list-item"},{"blocks":[{"id":"blk-32393","kind":"paragraph","spans":[{"id":"spn-37126","text":"billing provider integration (checkout + webhook entitlement updates),"}]}],"id":"blk-32392","kind":"list-item"},{"blocks":[{"id":"blk-32395","kind":"paragraph","spans":[{"id":"spn-37127","text":"audit logging and operational tooling."}]}],"id":"blk-32394","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32396","kind":"paragraph","spans":[{"id":"spn-37128","text":"The control plane needs:"}]},{"id":"blk-32397","items":[{"blocks":[{"id":"blk-32399","kind":"paragraph","spans":[{"id":"spn-37129","text":"strong consistency for critical operations (deploy versioning, entitlement updates, limit enforcement),"}]}],"id":"blk-32398","kind":"list-item"},{"blocks":[{"id":"blk-32401","kind":"paragraph","spans":[{"id":"spn-37130","text":"near-real-time updates for UI (deployment status, usage updates),"}]}],"id":"blk-32400","kind":"list-item"},{"blocks":[{"id":"blk-32403","kind":"paragraph","spans":[{"id":"spn-37131","text":"a straightforward developer experience that supports rapid iteration,"}]}],"id":"blk-32402","kind":"list-item"},{"blocks":[{"id":"blk-32405","kind":"paragraph","spans":[{"id":"spn-37132","text":"good fit for TypeScript-first development,"}]}],"id":"blk-32404","kind":"list-item"},{"blocks":[{"id":"blk-32407","kind":"paragraph","spans":[{"id":"spn-37133","text":"a path to implement server-only operations safely (provider API calls, webhook handlers, telemetry signature verification),"}]}],"id":"blk-32406","kind":"list-item"},{"blocks":[{"id":"blk-32409","kind":"paragraph","spans":[{"id":"spn-37134","text":"mature relational querying for complex aggregation and reporting,"}]}],"id":"blk-32408","kind":"list-item"},{"blocks":[{"id":"blk-32411","kind":"paragraph","spans":[{"id":"spn-37135","text":"built-in authentication that eliminates a separate auth provider dependency."}]}],"id":"blk-32410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32412","kind":"heading","level":3,"spans":[{"id":"spn-37136","text":"1.1 Migration context"}]},{"id":"blk-32413","kind":"paragraph","spans":[{"id":"spn-37137","text":"The v1 control plane was originally designed around Convex (see superseded ADR-0002). After initial implementation experience, the team decided to migrate to Supabase for:"}]},{"id":"blk-32414","items":[{"blocks":[{"id":"blk-32416","kind":"paragraph","spans":[{"id":"spn-37138","text":"native PostgreSQL with full SQL power (JOINs, window functions, CTEs) for aggregation and reporting,"}]}],"id":"blk-32415","kind":"list-item"},{"blocks":[{"id":"blk-32418","kind":"paragraph","spans":[{"id":"spn-37139","text":"Row Level Security (RLS) as a declarative, auditable tenant isolation mechanism,"}]}],"id":"blk-32417","kind":"list-item"},{"blocks":[{"id":"blk-32420","kind":"paragraph","spans":[{"id":"spn-37140","text":"built-in auth (Supabase Auth) eliminating the Clerk dependency,"}]}],"id":"blk-32419","kind":"list-item"},{"blocks":[{"id":"blk-32422","kind":"paragraph","spans":[{"id":"spn-37141","text":"pg_cron for scheduled retention and aggregation jobs without external orchestration,"}]}],"id":"blk-32421","kind":"list-item"},{"blocks":[{"id":"blk-32424","kind":"paragraph","spans":[{"id":"spn-37142","text":"Supabase Vault for secrets management,"}]}],"id":"blk-32423","kind":"list-item"},{"blocks":[{"id":"blk-32426","kind":"paragraph","spans":[{"id":"spn-37143","text":"broader ecosystem and portability (standard PostgreSQL)."}]}],"id":"blk-32425","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32427","kind":"paragraph","spans":[{"id":"spn-37144","text":"---"}]},{"id":"blk-32428","kind":"heading","level":2,"spans":[{"id":"spn-37145","text":"2) Decision"}]},{"id":"blk-32429","kind":"paragraph","spans":[{"id":"spn-37146","text":"Use "},{"id":"spn-37147","marks":["bold"],"text":"Supabase"},{"id":"spn-37148","text":" as the primary control plane backend for v1, including:"}]},{"id":"blk-32430","kind":"paragraph","spans":[{"id":"spn-37149","text":"1. "},{"id":"spn-37150","marks":["bold"],"text":"PostgreSQL"},{"id":"spn-37151","text":" (via Supabase) as the system of record for:"}]},{"id":"blk-32431","items":[{"blocks":[{"id":"blk-32433","kind":"paragraph","spans":[{"id":"spn-37152","marks":["code"],"text":"users"},{"id":"spn-37153","text":", "},{"id":"spn-37154","marks":["code"],"text":"agents"},{"id":"spn-37155","text":", "},{"id":"spn-37156","marks":["code"],"text":"deployments"},{"id":"spn-37157","text":", "},{"id":"spn-37158","marks":["code"],"text":"metrics_events"},{"id":"spn-37159","text":", "},{"id":"spn-37160","marks":["code"],"text":"billing_usage"},{"id":"spn-37161","text":","}]}],"id":"blk-32432","kind":"list-item"},{"blocks":[{"id":"blk-32435","kind":"paragraph","spans":[{"id":"spn-37162","text":"optional "},{"id":"spn-37163","marks":["code"],"text":"subscriptions"},{"id":"spn-37164","text":", "},{"id":"spn-37165","marks":["code"],"text":"audit_log"},{"id":"spn-37166","text":"."}]}],"id":"blk-32434","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32436","kind":"paragraph","spans":[{"id":"spn-37167","text":"2. "},{"id":"spn-37168","marks":["bold"],"text":"Row Level Security (RLS)"},{"id":"spn-37169","text":" as the primary tenant isolation mechanism:"}]},{"id":"blk-32437","items":[{"blocks":[{"id":"blk-32439","kind":"paragraph","spans":[{"id":"spn-37170","text":"all application tables have RLS enabled,"}]}],"id":"blk-32438","kind":"list-item"},{"blocks":[{"id":"blk-32441","kind":"paragraph","spans":[{"id":"spn-37171","text":"policies use "},{"id":"spn-37172","marks":["code"],"text":"auth.uid()"},{"id":"spn-37173","text":" to enforce per-user ownership,"}]}],"id":"blk-32440","kind":"list-item"},{"blocks":[{"id":"blk-32443","kind":"paragraph","spans":[{"id":"spn-37174","text":"server-side operations use "},{"id":"spn-37175","marks":["code"],"text":"service_role"},{"id":"spn-37176","text":" key to bypass RLS intentionally."}]}],"id":"blk-32442","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32444","kind":"paragraph","spans":[{"id":"spn-37177","text":"3. "},{"id":"spn-37178","marks":["bold"],"text":"Supabase Edge Functions"},{"id":"spn-37179","text":" (Deno-based) as the server-side API implementation surface for:"}]},{"id":"blk-32445","items":[{"blocks":[{"id":"blk-32447","kind":"paragraph","spans":[{"id":"spn-37180","text":"deployment orchestration workflows,"}]}],"id":"blk-32446","kind":"list-item"},{"blocks":[{"id":"blk-32449","kind":"paragraph","spans":[{"id":"spn-37181","text":"telemetry ingestion and validation,"}]}],"id":"blk-32448","kind":"list-item"},{"blocks":[{"id":"blk-32451","kind":"paragraph","spans":[{"id":"spn-37182","text":"billing checkout and webhook processing,"}]}],"id":"blk-32450","kind":"list-item"},{"blocks":[{"id":"blk-32453","kind":"paragraph","spans":[{"id":"spn-37183","text":"metrics aggregation jobs (supplementing pg_cron)."}]}],"id":"blk-32452","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32454","kind":"paragraph","spans":[{"id":"spn-37184","text":"4. "},{"id":"spn-37185","marks":["bold"],"text":"Supabase Auth"},{"id":"spn-37186","text":" as the authentication provider:"}]},{"id":"blk-32455","items":[{"blocks":[{"id":"blk-32457","kind":"paragraph","spans":[{"id":"spn-37187","text":"replaces Clerk for user authentication,"}]}],"id":"blk-32456","kind":"list-item"},{"blocks":[{"id":"blk-32459","kind":"paragraph","spans":[{"id":"spn-37188","marks":["code"],"text":"auth.uid()"},{"id":"spn-37189","text":" maps directly to "},{"id":"spn-37190","marks":["code"],"text":"users.id"},{"id":"spn-37191","text":","}]}],"id":"blk-32458","kind":"list-item"},{"blocks":[{"id":"blk-32461","kind":"paragraph","spans":[{"id":"spn-37192","text":"supports social login, magic link, and email/password flows."}]}],"id":"blk-32460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32462","kind":"paragraph","spans":[{"id":"spn-37193","text":"5. "},{"id":"spn-37194","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-37195","text":" for secrets storage:"}]},{"id":"blk-32463","items":[{"blocks":[{"id":"blk-32465","kind":"paragraph","spans":[{"id":"spn-37196","text":"provider API keys and credentials stored in "},{"id":"spn-37197","marks":["code"],"text":"vault.secrets"},{"id":"spn-37198","text":","}]}],"id":"blk-32464","kind":"list-item"},{"blocks":[{"id":"blk-32467","kind":"paragraph","spans":[{"id":"spn-37199","text":"application tables store only key names and vault references."}]}],"id":"blk-32466","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32468","kind":"paragraph","spans":[{"id":"spn-37200","text":"6. "},{"id":"spn-37201","marks":["bold"],"text":"pg_cron"},{"id":"spn-37202","text":" for scheduled jobs:"}]},{"id":"blk-32469","items":[{"blocks":[{"id":"blk-32471","kind":"paragraph","spans":[{"id":"spn-37203","text":"metrics retention cleanup,"}]}],"id":"blk-32470","kind":"list-item"},{"blocks":[{"id":"blk-32473","kind":"paragraph","spans":[{"id":"spn-37204","text":"billing usage aggregation,"}]}],"id":"blk-32472","kind":"list-item"},{"blocks":[{"id":"blk-32475","kind":"paragraph","spans":[{"id":"spn-37205","text":"any periodic maintenance tasks."}]}],"id":"blk-32474","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32476","kind":"paragraph","spans":[{"id":"spn-37206","text":"7. "},{"id":"spn-37207","marks":["bold"],"text":"Supabase Realtime"},{"id":"spn-37208","text":" MAY be used for live UI updates (deployment status, metrics) via PostgreSQL LISTEN/NOTIFY or Realtime subscriptions."}]},{"id":"blk-32477","kind":"paragraph","spans":[{"id":"spn-37209","text":"Supabase is the control plane implementation choice. It does not change the multi-runtime architecture; runtime providers remain Cloudflare (default) and AgentCore (premium/enterprise), behind a Runtime Provider Interface (RPI)."}]},{"id":"blk-32478","kind":"paragraph","spans":[{"id":"spn-37210","text":"---"}]},{"id":"blk-32479","kind":"heading","level":2,"spans":[{"id":"spn-37211","text":"3) Rationale"}]},{"id":"blk-32480","kind":"heading","level":3,"spans":[{"id":"spn-37212","text":"3.1 Mature relational model"}]},{"id":"blk-32481","kind":"paragraph","spans":[{"id":"spn-37213","text":"PostgreSQL provides full SQL expressiveness (JOINs, window functions, CTEs, partial indexes) that simplifies aggregation queries, reporting, and complex access patterns. The UNIQUE and CHECK constraints enforce data invariants at the database level."}]},{"id":"blk-32482","kind":"heading","level":3,"spans":[{"id":"spn-37214","text":"3.2 Declarative tenant isolation via RLS"}]},{"id":"blk-32483","kind":"paragraph","spans":[{"id":"spn-37215","text":"Row Level Security provides a declarative, auditable, and database-enforced tenant isolation layer. Every query is automatically filtered by "},{"id":"spn-37216","marks":["code"],"text":"auth.uid()"},{"id":"spn-37217","text":", reducing the surface area for IDOR-style bugs compared to application-level ownership checks."}]},{"id":"blk-32484","kind":"heading","level":3,"spans":[{"id":"spn-37218","text":"3.3 Integrated auth"}]},{"id":"blk-32485","kind":"paragraph","spans":[{"id":"spn-37219","text":"Supabase Auth eliminates the need for a separate auth provider (Clerk), reducing vendor dependencies and simplifying the identity-to-database mapping ("},{"id":"spn-37220","marks":["code"],"text":"auth.uid()"},{"id":"spn-37221","text":" = "},{"id":"spn-37222","marks":["code"],"text":"users.id"},{"id":"spn-37223","text":")."}]},{"id":"blk-32486","kind":"heading","level":3,"spans":[{"id":"spn-37224","text":"3.4 Built-in scheduled jobs"}]},{"id":"blk-32487","kind":"paragraph","spans":[{"id":"spn-37225","text":"pg_cron enables retention policies and aggregation jobs to run directly in the database without external cron infrastructure or serverless scheduler setup."}]},{"id":"blk-32488","kind":"heading","level":3,"spans":[{"id":"spn-37226","text":"3.5 Secrets management"}]},{"id":"blk-32489","kind":"paragraph","spans":[{"id":"spn-37227","text":"Supabase Vault provides encrypted-at-rest secrets storage integrated with the database, avoiding the need for a separate secrets manager for provider credentials."}]},{"id":"blk-32490","kind":"heading","level":3,"spans":[{"id":"spn-37228","text":"3.6 TypeScript developer experience"}]},{"id":"blk-32491","kind":"paragraph","spans":[{"id":"spn-37229","text":"Supabase provides auto-generated TypeScript types from the database schema, a well-documented JS client library, and Edge Functions (Deno/TypeScript) for server-side logic. This maintains TypeScript-first development across the stack."}]},{"id":"blk-32492","kind":"heading","level":3,"spans":[{"id":"spn-37230","text":"3.7 Portability"}]},{"id":"blk-32493","kind":"paragraph","spans":[{"id":"spn-37231","text":"Standard PostgreSQL means the data layer is portable to any PostgreSQL host. Edge Functions can be replaced with any server-side runtime. There is no proprietary query language or data format lock-in."}]},{"id":"blk-32494","kind":"heading","level":3,"spans":[{"id":"spn-37232","text":"3.8 Real-time UX"}]},{"id":"blk-32495","kind":"paragraph","spans":[{"id":"spn-37233","text":"Supabase Realtime (backed by PostgreSQL LISTEN/NOTIFY) supports live UI updates for deployment status transitions, near-real-time metrics rollups, and invocation error visibility."}]},{"id":"blk-32496","kind":"paragraph","spans":[{"id":"spn-37234","text":"---"}]},{"id":"blk-32497","kind":"heading","level":2,"spans":[{"id":"spn-37235","text":"4) Alternatives considered"}]},{"id":"blk-32498","kind":"heading","level":3,"spans":[{"id":"spn-37236","text":"4.1 Convex (original v1 choice, now superseded)"}]},{"id":"blk-32499","kind":"paragraph","spans":[{"id":"spn-37237","marks":["bold"],"text":"Pros:"}]},{"id":"blk-32500","items":[{"blocks":[{"id":"blk-32502","kind":"paragraph","spans":[{"id":"spn-37238","text":"cohesive data + server function model,"}]}],"id":"blk-32501","kind":"list-item"},{"blocks":[{"id":"blk-32504","kind":"paragraph","spans":[{"id":"spn-37239","text":"built-in reactive subscriptions,"}]}],"id":"blk-32503","kind":"list-item"},{"blocks":[{"id":"blk-32506","kind":"paragraph","spans":[{"id":"spn-37240","text":"fast initial prototyping."}]}],"id":"blk-32505","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32507","kind":"paragraph","spans":[{"id":"spn-37241","marks":["bold"],"text":"Cons:"}]},{"id":"blk-32508","items":[{"blocks":[{"id":"blk-32510","kind":"paragraph","spans":[{"id":"spn-37242","text":"limited query expressiveness (no JOINs, no window functions),"}]}],"id":"blk-32509","kind":"list-item"},{"blocks":[{"id":"blk-32512","kind":"paragraph","spans":[{"id":"spn-37243","text":"access control is application-level only (no declarative RLS),"}]}],"id":"blk-32511","kind":"list-item"},{"blocks":[{"id":"blk-32514","kind":"paragraph","spans":[{"id":"spn-37244","text":"vendor lock-in with proprietary data format and query language,"}]}],"id":"blk-32513","kind":"list-item"},{"blocks":[{"id":"blk-32516","kind":"paragraph","spans":[{"id":"spn-37245","text":"requires separate auth provider (Clerk),"}]}],"id":"blk-32515","kind":"list-item"},{"blocks":[{"id":"blk-32518","kind":"paragraph","spans":[{"id":"spn-37246","text":"no built-in secrets management or scheduled jobs."}]}],"id":"blk-32517","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32519","kind":"heading","level":3,"spans":[{"id":"spn-37247","text":"4.2 Firebase"}]},{"id":"blk-32520","kind":"paragraph","spans":[{"id":"spn-37248","marks":["bold"],"text":"Pros:"}]},{"id":"blk-32521","items":[{"blocks":[{"id":"blk-32523","kind":"paragraph","spans":[{"id":"spn-37249","text":"fast prototyping,"}]}],"id":"blk-32522","kind":"list-item"},{"blocks":[{"id":"blk-32525","kind":"paragraph","spans":[{"id":"spn-37250","text":"built-in auth."}]}],"id":"blk-32524","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32526","kind":"paragraph","spans":[{"id":"spn-37251","marks":["bold"],"text":"Cons:"}]},{"id":"blk-32527","items":[{"blocks":[{"id":"blk-32529","kind":"paragraph","spans":[{"id":"spn-37252","text":"NoSQL limitations for aggregation,"}]}],"id":"blk-32528","kind":"list-item"},{"blocks":[{"id":"blk-32531","kind":"paragraph","spans":[{"id":"spn-37253","text":"security rules can become complex and error-prone for multi-tenant workflows,"}]}],"id":"blk-32530","kind":"list-item"},{"blocks":[{"id":"blk-32533","kind":"paragraph","spans":[{"id":"spn-37254","text":"no relational model."}]}],"id":"blk-32532","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32534","kind":"heading","level":3,"spans":[{"id":"spn-37255","text":"4.3 Traditional Postgres + custom backend (e.g., Express/Fastify)"}]},{"id":"blk-32535","kind":"paragraph","spans":[{"id":"spn-37256","marks":["bold"],"text":"Pros:"}]},{"id":"blk-32536","items":[{"blocks":[{"id":"blk-32538","kind":"paragraph","spans":[{"id":"spn-37257","text":"full control,"}]}],"id":"blk-32537","kind":"list-item"},{"blocks":[{"id":"blk-32540","kind":"paragraph","spans":[{"id":"spn-37258","text":"mature ecosystem."}]}],"id":"blk-32539","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32541","kind":"paragraph","spans":[{"id":"spn-37259","marks":["bold"],"text":"Cons:"}]},{"id":"blk-32542","items":[{"blocks":[{"id":"blk-32544","kind":"paragraph","spans":[{"id":"spn-37260","text":"more infrastructure to operate,"}]}],"id":"blk-32543","kind":"list-item"},{"blocks":[{"id":"blk-32546","kind":"paragraph","spans":[{"id":"spn-37261","text":"must build auth, realtime, and secrets management from scratch,"}]}],"id":"blk-32545","kind":"list-item"},{"blocks":[{"id":"blk-32548","kind":"paragraph","spans":[{"id":"spn-37262","text":"slower initial velocity for an early-stage product."}]}],"id":"blk-32547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32549","kind":"heading","level":3,"spans":[{"id":"spn-37263","text":"4.4 \"Runtime-first\" approach: host control plane on a single provider (e.g., Cloudflare only)"}]},{"id":"blk-32550","kind":"paragraph","spans":[{"id":"spn-37264","marks":["bold"],"text":"Pros:"}]},{"id":"blk-32551","items":[{"blocks":[{"id":"blk-32553","kind":"paragraph","spans":[{"id":"spn-37265","text":"fewer vendors,"}]}],"id":"blk-32552","kind":"list-item"},{"blocks":[{"id":"blk-32555","kind":"paragraph","spans":[{"id":"spn-37266","text":"potentially simpler deployment story."}]}],"id":"blk-32554","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32556","kind":"paragraph","spans":[{"id":"spn-37267","marks":["bold"],"text":"Cons:"}]},{"id":"blk-32557","items":[{"blocks":[{"id":"blk-32559","kind":"paragraph","spans":[{"id":"spn-37268","text":"control plane requirements (webhooks, secure secret workflows, reliable aggregation) push toward a richer backend model,"}]}],"id":"blk-32558","kind":"list-item"},{"blocks":[{"id":"blk-32561","kind":"paragraph","spans":[{"id":"spn-37269","text":"does not inherently provide the same DB + RLS ergonomics."}]}],"id":"blk-32560","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32562","kind":"paragraph","spans":[{"id":"spn-37270","text":"---"}]},{"id":"blk-32563","kind":"heading","level":2,"spans":[{"id":"spn-37271","text":"5) Consequences"}]},{"id":"blk-32564","kind":"heading","level":3,"spans":[{"id":"spn-37272","text":"5.1 Positive consequences"}]},{"id":"blk-32565","items":[{"blocks":[{"id":"blk-32567","kind":"paragraph","spans":[{"id":"spn-37273","text":"Declarative tenant isolation via RLS reduces IDOR risk."}]}],"id":"blk-32566","kind":"list-item"},{"blocks":[{"id":"blk-32569","kind":"paragraph","spans":[{"id":"spn-37274","text":"Full SQL power for aggregation, reporting, and complex queries."}]}],"id":"blk-32568","kind":"list-item"},{"blocks":[{"id":"blk-32571","kind":"paragraph","spans":[{"id":"spn-37275","text":"Integrated auth eliminates Clerk dependency."}]}],"id":"blk-32570","kind":"list-item"},{"blocks":[{"id":"blk-32573","kind":"paragraph","spans":[{"id":"spn-37276","text":"pg_cron handles scheduled jobs without external infrastructure."}]}],"id":"blk-32572","kind":"list-item"},{"blocks":[{"id":"blk-32575","kind":"paragraph","spans":[{"id":"spn-37277","text":"Supabase Vault centralizes secrets management."}]}],"id":"blk-32574","kind":"list-item"},{"blocks":[{"id":"blk-32577","kind":"paragraph","spans":[{"id":"spn-37278","text":"Standard PostgreSQL ensures portability."}]}],"id":"blk-32576","kind":"list-item"},{"blocks":[{"id":"blk-32579","kind":"paragraph","spans":[{"id":"spn-37279","text":"Auto-generated TypeScript types from DB schema."}]}],"id":"blk-32578","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32580","kind":"heading","level":3,"spans":[{"id":"spn-37280","text":"5.2 Negative consequences / tradeoffs"}]},{"id":"blk-32581","items":[{"blocks":[{"id":"blk-32583","kind":"paragraph","spans":[{"id":"spn-37281","text":"Adds a vendor dependency (Supabase) in the control plane, though PostgreSQL itself is portable."}]}],"id":"blk-32582","kind":"list-item"},{"blocks":[{"id":"blk-32585","kind":"paragraph","spans":[{"id":"spn-37282","text":"RLS policies require careful design and testing to avoid overly permissive or restrictive rules."}]}],"id":"blk-32584","kind":"list-item"},{"blocks":[{"id":"blk-32587","kind":"paragraph","spans":[{"id":"spn-37283","text":"Edge Functions (Deno) have a different runtime than Node.js; some npm packages may need adaptation."}]}],"id":"blk-32586","kind":"list-item"},{"blocks":[{"id":"blk-32589","kind":"paragraph","spans":[{"id":"spn-37284","text":"Realtime subscriptions require explicit setup compared to Convex's automatic reactivity."}]}],"id":"blk-32588","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32590","kind":"heading","level":3,"spans":[{"id":"spn-37285","text":"5.3 Neutral consequences"}]},{"id":"blk-32591","items":[{"blocks":[{"id":"blk-32593","kind":"paragraph","spans":[{"id":"spn-37286","text":"The RPI and provider adapters remain necessary regardless of control plane backend choice."}]}],"id":"blk-32592","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32594","kind":"paragraph","spans":[{"id":"spn-37287","text":"---"}]},{"id":"blk-32595","kind":"heading","level":2,"spans":[{"id":"spn-37288","text":"6) Implementation notes (normative requirements)"}]},{"id":"blk-32596","kind":"paragraph","spans":[{"id":"spn-37289","text":"These requirements apply because we chose Supabase; they are considered part of the \"decision contract\"."}]},{"id":"blk-32597","kind":"heading","level":3,"spans":[{"id":"spn-37290","text":"6.1 Access control (MUST)"}]},{"id":"blk-32598","items":[{"blocks":[{"id":"blk-32600","kind":"paragraph","spans":[{"id":"spn-37291","text":"RLS MUST be enabled on all application tables."}]}],"id":"blk-32599","kind":"list-item"},{"blocks":[{"id":"blk-32602","kind":"paragraph","spans":[{"id":"spn-37292","text":"Every RLS policy MUST use "},{"id":"spn-37293","marks":["code"],"text":"auth.uid()"},{"id":"spn-37294","text":" to enforce tenant isolation."}]}],"id":"blk-32601","kind":"list-item"},{"blocks":[{"id":"blk-32604","kind":"paragraph","spans":[{"id":"spn-37295","text":"Server-side Edge Functions that need to bypass RLS MUST use the "},{"id":"spn-37296","marks":["code"],"text":"service_role"},{"id":"spn-37297","text":" key."}]}],"id":"blk-32603","kind":"list-item"},{"blocks":[{"id":"blk-32606","kind":"paragraph","spans":[{"id":"spn-37298","text":"Client-supplied "},{"id":"spn-37299","marks":["code"],"text":"user_id"},{"id":"spn-37300","text":" MUST be ignored for authorization decisions; "},{"id":"spn-37301","marks":["code"],"text":"auth.uid()"},{"id":"spn-37302","text":" is the sole source of identity."}]}],"id":"blk-32605","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32607","kind":"heading","level":3,"spans":[{"id":"spn-37303","text":"6.2 Server-only sensitive operations (MUST)"}]},{"id":"blk-32608","kind":"paragraph","spans":[{"id":"spn-37304","text":"The following MUST be implemented as Edge Functions using "},{"id":"spn-37305","marks":["code"],"text":"service_role"},{"id":"spn-37306","text":" and must never trust browser clients:"}]},{"id":"blk-32609","items":[{"blocks":[{"id":"blk-32611","kind":"paragraph","spans":[{"id":"spn-37307","text":"runtime provider deploy operations,"}]}],"id":"blk-32610","kind":"list-item"},{"blocks":[{"id":"blk-32613","kind":"paragraph","spans":[{"id":"spn-37308","text":"runtime provider secret injection (via Supabase Vault),"}]}],"id":"blk-32612","kind":"list-item"},{"blocks":[{"id":"blk-32615","kind":"paragraph","spans":[{"id":"spn-37309","text":"telemetry ingestion and signature verification,"}]}],"id":"blk-32614","kind":"list-item"},{"blocks":[{"id":"blk-32617","kind":"paragraph","spans":[{"id":"spn-37310","text":"billing webhook processing and tier updates,"}]}],"id":"blk-32616","kind":"list-item"},{"blocks":[{"id":"blk-32619","kind":"paragraph","spans":[{"id":"spn-37311","text":"usage aggregation writes."}]}],"id":"blk-32618","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32620","kind":"heading","level":3,"spans":[{"id":"spn-37312","text":"6.3 Immutability and state machines (MUST)"}]},{"id":"blk-32621","items":[{"blocks":[{"id":"blk-32623","kind":"paragraph","spans":[{"id":"spn-37313","text":"Deployments are immutable except status/provider_ref/error fields."}]}],"id":"blk-32622","kind":"list-item"},{"blocks":[{"id":"blk-32625","kind":"paragraph","spans":[{"id":"spn-37314","text":"Agent "},{"id":"spn-37315","marks":["code"],"text":"active_deployment_id"},{"id":"spn-37316","text":" is the only routing pointer for invocations."}]}],"id":"blk-32624","kind":"list-item"},{"blocks":[{"id":"blk-32627","kind":"paragraph","spans":[{"id":"spn-37317","text":"State transitions MUST match "},{"id":"spn-37318","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-37319","text":" and "},{"id":"spn-37320","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-37321","text":"."}]}],"id":"blk-32626","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32628","kind":"heading","level":3,"spans":[{"id":"spn-37322","text":"6.4 Telemetry ingestion integrity (MUST)"}]},{"id":"blk-32629","items":[{"blocks":[{"id":"blk-32631","kind":"paragraph","spans":[{"id":"spn-37323","text":"Telemetry events MUST be authenticated (deployment-scoped signing) and cross-checked for ownership."}]}],"id":"blk-32630","kind":"list-item"},{"blocks":[{"id":"blk-32633","kind":"paragraph","spans":[{"id":"spn-37324","text":"Telemetry ingestion MUST be robust to retries (dedupe recommended via "},{"id":"spn-37325","marks":["code"],"text":"idempotency_key"},{"id":"spn-37326","text":" or "},{"id":"spn-37327","marks":["code"],"text":"ON CONFLICT"},{"id":"spn-37328","text":")."}]}],"id":"blk-32632","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32634","kind":"heading","level":3,"spans":[{"id":"spn-37329","text":"6.5 Secrets handling (MUST)"}]},{"id":"blk-32635","items":[{"blocks":[{"id":"blk-32637","kind":"paragraph","spans":[{"id":"spn-37330","text":"No plaintext secrets stored in application tables."}]}],"id":"blk-32636","kind":"list-item"},{"blocks":[{"id":"blk-32639","kind":"paragraph","spans":[{"id":"spn-37331","text":"Supabase Vault ("},{"id":"spn-37332","marks":["code"],"text":"vault.secrets"},{"id":"spn-37333","text":") stores all sensitive credentials."}]}],"id":"blk-32638","kind":"list-item"},{"blocks":[{"id":"blk-32641","kind":"paragraph","spans":[{"id":"spn-37334","text":"No endpoint returns secret values."}]}],"id":"blk-32640","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32642","kind":"heading","level":3,"spans":[{"id":"spn-37335","text":"6.6 Aggregation and limits (MUST)"}]},{"id":"blk-32643","items":[{"blocks":[{"id":"blk-32645","kind":"paragraph","spans":[{"id":"spn-37336","text":"Limit enforcement MUST occur before provider invocation whenever possible."}]}],"id":"blk-32644","kind":"list-item"},{"blocks":[{"id":"blk-32647","kind":"paragraph","spans":[{"id":"spn-37337","text":"Aggregated "},{"id":"spn-37338","marks":["code"],"text":"billing_usage"},{"id":"spn-37339","text":" is derived from raw "},{"id":"spn-37340","marks":["code"],"text":"metrics_events"},{"id":"spn-37341","text":" and must be recomputable/idempotent."}]}],"id":"blk-32646","kind":"list-item"},{"blocks":[{"id":"blk-32649","kind":"paragraph","spans":[{"id":"spn-37342","text":"pg_cron SHOULD handle periodic aggregation and retention."}]}],"id":"blk-32648","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32650","kind":"paragraph","spans":[{"id":"spn-37343","text":"---"}]},{"id":"blk-32651","kind":"heading","level":2,"spans":[{"id":"spn-37344","text":"7) Security considerations specific to this decision"}]},{"id":"blk-32652","items":[{"blocks":[{"id":"blk-32654","kind":"paragraph","spans":[{"id":"spn-37345","text":"RLS is the primary defense against cross-tenant data access; policies MUST be reviewed and tested thoroughly."}]}],"id":"blk-32653","kind":"list-item"},{"blocks":[{"id":"blk-32656","kind":"paragraph","spans":[{"id":"spn-37346","text":"Implement defensive patterns:"}]}],"id":"blk-32655","kind":"list-item"},{"blocks":[{"id":"blk-32658","kind":"paragraph","spans":[{"id":"spn-37347","text":"RLS policies on all tables (no table should have RLS disabled in production),"}]}],"id":"blk-32657","kind":"list-item"},{"blocks":[{"id":"blk-32660","kind":"paragraph","spans":[{"id":"spn-37348","text":"Edge Functions validate ownership even when using "},{"id":"spn-37349","marks":["code"],"text":"service_role"},{"id":"spn-37350","text":","}]}],"id":"blk-32659","kind":"list-item"},{"blocks":[{"id":"blk-32662","kind":"paragraph","spans":[{"id":"spn-37351","text":"centralized error normalization (no secrets in errors),"}]}],"id":"blk-32661","kind":"list-item"},{"blocks":[{"id":"blk-32664","kind":"paragraph","spans":[{"id":"spn-37352","text":"audit logging for privileged actions (deploy, secrets updates, webhook processing, telemetry rejects)."}]}],"id":"blk-32663","kind":"list-item"},{"blocks":[{"id":"blk-32666","kind":"paragraph","spans":[{"id":"spn-37353","text":"Treat Supabase as \"control plane only\"; never run untrusted customer agent code within Supabase Edge Functions."}]}],"id":"blk-32665","kind":"list-item"},{"blocks":[{"id":"blk-32668","kind":"paragraph","spans":[{"id":"spn-37354","text":"Supabase Vault encryption keys are managed by the platform; rotate credentials periodically."}]}],"id":"blk-32667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32669","kind":"paragraph","spans":[{"id":"spn-37355","text":"---"}]},{"id":"blk-32670","kind":"heading","level":2,"spans":[{"id":"spn-37356","text":"8) Migration / exit strategy (if Supabase is replaced later)"}]},{"id":"blk-32671","kind":"paragraph","spans":[{"id":"spn-37357","text":"If future requirements or constraints motivate replacing Supabase:"}]},{"id":"blk-32672","items":[{"blocks":[{"id":"blk-32674","kind":"paragraph","spans":[{"id":"spn-37358","text":"The system should remain portable because:"}]}],"id":"blk-32673","kind":"list-item"},{"blocks":[{"id":"blk-32676","kind":"paragraph","spans":[{"id":"spn-37359","text":"data model is standard PostgreSQL (tables, constraints, indexes, RLS),"}]}],"id":"blk-32675","kind":"list-item"},{"blocks":[{"id":"blk-32678","kind":"paragraph","spans":[{"id":"spn-37360","text":"API contracts are documented (request/response/error envelopes),"}]}],"id":"blk-32677","kind":"list-item"},{"blocks":[{"id":"blk-32680","kind":"paragraph","spans":[{"id":"spn-37361","text":"runtime adapters are defined via RPI and independent of Supabase specifics."}]}],"id":"blk-32679","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32681","kind":"paragraph","spans":[{"id":"spn-37362","text":"Migration plan (high-level): 1. Export PostgreSQL schema and data via "},{"id":"spn-37363","marks":["code"],"text":"pg_dump"},{"id":"spn-37364","text":". 2. Re-implement Edge Functions as equivalent server-side handlers on the new platform. 3. Replace Supabase Auth with the new auth provider, mapping "},{"id":"spn-37365","marks":["code"],"text":"auth.uid()"},{"id":"spn-37366","text":" to the equivalent identity. 4. Replace Supabase Vault with the new secrets manager. 5. Replace pg_cron with the new scheduler. 6. Cut over UI and runtime telemetry endpoints once stable."}]},{"id":"blk-32682","kind":"paragraph","spans":[{"id":"spn-37367","text":"---"}]},{"id":"blk-32683","kind":"heading","level":2,"spans":[{"id":"spn-37368","text":"9) Decision acceptance criteria"}]},{"id":"blk-32684","kind":"paragraph","spans":[{"id":"spn-37369","text":"This ADR is considered successfully implemented when:"}]},{"id":"blk-32685","items":[{"blocks":[{"id":"blk-32687","kind":"paragraph","spans":[{"id":"spn-37370","text":"Control plane features (agent CRUD, deploy orchestration, telemetry ingestion, billing webhook processing, usage aggregation) are implemented as Edge Functions and SQL with correct RLS-based tenant isolation."}]}],"id":"blk-32686","kind":"list-item"},{"blocks":[{"id":"blk-32689","kind":"paragraph","spans":[{"id":"spn-37371","text":"No plaintext secrets exist in application tables (all in Supabase Vault)."}]}],"id":"blk-32688","kind":"list-item"},{"blocks":[{"id":"blk-32691","kind":"paragraph","spans":[{"id":"spn-37372","text":"Telemetry and billing webhooks are integrity-protected and cannot be spoofed to alter usage or tier."}]}],"id":"blk-32690","kind":"list-item"},{"blocks":[{"id":"blk-32693","kind":"paragraph","spans":[{"id":"spn-37373","text":"The system can deploy and invoke at least one agent on Cloudflare end-to-end, and produce usage metrics in the dashboard."}]}],"id":"blk-32692","kind":"list-item"},{"blocks":[{"id":"blk-32695","kind":"paragraph","spans":[{"id":"spn-37374","text":"The architecture remains consistent with the multi-runtime strategy and RPI contract."}]}],"id":"blk-32694","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera2ti2apg6u6x7o7x3xgrbmzwwuhnk5n5uqw5qtdxyli65lexplcca","vocabulary":"ampersand.docs.fs.v1"}