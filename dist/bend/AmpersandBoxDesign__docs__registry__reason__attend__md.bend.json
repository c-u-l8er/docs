{"bendscript":"0.1","blocks":[{"id":"blk-11368","kind":"heading","level":1,"spans":[{"id":"spn-10601","marks":["code"],"text":"&reason.attend"},{"id":"spn-10602","text":" — Proactive Attention and Bounded Autonomy for the [&] Protocol"}]},{"id":"blk-11369","kind":"paragraph","spans":[{"id":"spn-10603","marks":["code"],"text":"&reason.attend"},{"id":"spn-10604","text":" is the capability page for the "},{"id":"spn-10605","marks":["code"],"text":"&reason.attend"},{"id":"spn-10606","text":" subtype in the [&] Protocol."}]},{"id":"blk-11370","kind":"paragraph","spans":[{"id":"spn-10607","text":"It represents a meta-reasoning surface for deciding "},{"id":"spn-10608","marks":["bold"],"text":"what should receive attention next"},{"id":"spn-10609","text":", under governance and budget constraints."}]},{"id":"blk-11371","kind":"paragraph","spans":[{"id":"spn-10610","text":"In short:"}]},{"blocks":[{"id":"blk-11373","kind":"paragraph","spans":[{"id":"spn-10611","marks":["code"],"text":"&reason.attend"},{"id":"spn-10612","text":" is the protocol capability for agents that should not only reason about a task, but also reason about "},{"id":"spn-10613","marks":["bold"],"text":"which tasks to prioritize, defer, escalate, or propose"},{"id":"spn-10614","text":"."}]}],"id":"blk-11372","kind":"quote"},{"id":"blk-11374","kind":"heading","level":2,"spans":[{"id":"spn-10615","text":"1. Definition"}]},{"id":"blk-11375","kind":"paragraph","spans":[{"id":"spn-10616","marks":["code"],"text":"&reason.attend"},{"id":"spn-10617","text":" is a subtype of the "},{"id":"spn-10618","marks":["code"],"text":"&reason"},{"id":"spn-10619","text":" primitive."}]},{"id":"blk-11376","kind":"paragraph","spans":[{"id":"spn-10620","text":"It describes a capability that continuously or on-demand:"}]},{"id":"blk-11377","items":[{"blocks":[{"id":"blk-11379","kind":"paragraph","spans":[{"id":"spn-10621","text":"surveys active context and goals"}]}],"id":"blk-11378","kind":"list-item"},{"blocks":[{"id":"blk-11381","kind":"paragraph","spans":[{"id":"spn-10622","text":"triages attention candidates"}]}],"id":"blk-11380","kind":"list-item"},{"blocks":[{"id":"blk-11383","kind":"paragraph","spans":[{"id":"spn-10623","text":"dispatches bounded actions according to autonomy policy"}]}],"id":"blk-11382","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11384","kind":"paragraph","spans":[{"id":"spn-10624","text":"Typical outputs include:"}]},{"id":"blk-11385","items":[{"blocks":[{"id":"blk-11387","kind":"paragraph","spans":[{"id":"spn-10625","text":"ranked attention maps"}]}],"id":"blk-11386","kind":"list-item"},{"blocks":[{"id":"blk-11389","kind":"paragraph","spans":[{"id":"spn-10626","text":"dispatch decisions ("},{"id":"spn-10627","marks":["code"],"text":"explore"},{"id":"spn-10628","text":", "},{"id":"spn-10629","marks":["code"],"text":"focus"},{"id":"spn-10630","text":", "},{"id":"spn-10631","marks":["code"],"text":"act"},{"id":"spn-10632","text":", "},{"id":"spn-10633","marks":["code"],"text":"escalate"},{"id":"spn-10634","text":", "},{"id":"spn-10635","marks":["code"],"text":"propose"},{"id":"spn-10636","text":", "},{"id":"spn-10637","marks":["code"],"text":"idle"},{"id":"spn-10638","text":")"}]}],"id":"blk-11388","kind":"list-item"},{"blocks":[{"id":"blk-11391","kind":"paragraph","spans":[{"id":"spn-10639","text":"cycle results suitable for storage, audit, and later learning"}]}],"id":"blk-11390","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11392","kind":"paragraph","spans":[{"id":"spn-10640","text":"Unlike generic scheduling logic hidden in runtime code, "},{"id":"spn-10641","marks":["code"],"text":"&reason.attend"},{"id":"spn-10642","text":" makes this behavior explicit and composable."}]},{"id":"blk-11393","kind":"heading","level":2,"spans":[{"id":"spn-10643","text":"2. Why this capability exists"}]},{"id":"blk-11394","kind":"paragraph","spans":[{"id":"spn-10644","text":"Many agent systems fail not because they cannot reason, but because they cannot "},{"id":"spn-10645","marks":["bold"],"text":"allocate reasoning effort"},{"id":"spn-10646","text":" well."}]},{"id":"blk-11395","kind":"paragraph","spans":[{"id":"spn-10647","text":"Real deployments need to answer:"}]},{"id":"blk-11396","items":[{"blocks":[{"id":"blk-11398","kind":"paragraph","spans":[{"id":"spn-10648","text":"Which goal is most urgent now?"}]}],"id":"blk-11397","kind":"list-item"},{"blocks":[{"id":"blk-11400","kind":"paragraph","spans":[{"id":"spn-10649","text":"Is coverage sufficient to act, or should we learn first?"}]}],"id":"blk-11399","kind":"list-item"},{"blocks":[{"id":"blk-11402","kind":"paragraph","spans":[{"id":"spn-10650","text":"Is this region cyclic/uncertain and requiring deeper deliberation?"}]}],"id":"blk-11401","kind":"list-item"},{"blocks":[{"id":"blk-11404","kind":"paragraph","spans":[{"id":"spn-10651","text":"Should we defer for approval, escalate, or proceed?"}]}],"id":"blk-11403","kind":"list-item"},{"blocks":[{"id":"blk-11406","kind":"paragraph","spans":[{"id":"spn-10652","text":"Are we within autonomy and budget constraints?"}]}],"id":"blk-11405","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11407","kind":"paragraph","spans":[{"id":"spn-10653","marks":["code"],"text":"&reason.attend"},{"id":"spn-10654","text":" exists so that these decisions are part of the protocol surface, not ad hoc internal glue."}]},{"id":"blk-11408","kind":"paragraph","spans":[{"id":"spn-10655","text":"This is especially important for:"}]},{"id":"blk-11409","items":[{"blocks":[{"id":"blk-11411","kind":"paragraph","spans":[{"id":"spn-10656","text":"long-running agents"}]}],"id":"blk-11410","kind":"list-item"},{"blocks":[{"id":"blk-11413","kind":"paragraph","spans":[{"id":"spn-10657","text":"multi-goal systems"}]}],"id":"blk-11412","kind":"list-item"},{"blocks":[{"id":"blk-11415","kind":"paragraph","spans":[{"id":"spn-10658","text":"cost-constrained deployments"}]}],"id":"blk-11414","kind":"list-item"},{"blocks":[{"id":"blk-11417","kind":"paragraph","spans":[{"id":"spn-10659","text":"safety-sensitive domains requiring escalation policy"}]}],"id":"blk-11416","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11418","kind":"heading","level":2,"spans":[{"id":"spn-10660","text":"3. Where it fits in the protocol"}]},{"id":"blk-11419","kind":"paragraph","spans":[{"id":"spn-10661","text":"The [&] Protocol organizes cognition, embodiment, and governance into six primitive families:"}]},{"id":"blk-11420","items":[{"blocks":[{"id":"blk-11422","kind":"paragraph","spans":[{"id":"spn-10662","marks":["code"],"text":"&memory"},{"id":"spn-10663","text":" — what the agent knows"}]}],"id":"blk-11421","kind":"list-item"},{"blocks":[{"id":"blk-11424","kind":"paragraph","spans":[{"id":"spn-10664","marks":["code"],"text":"&reason"},{"id":"spn-10665","text":" — how the agent decides"}]}],"id":"blk-11423","kind":"list-item"},{"blocks":[{"id":"blk-11426","kind":"paragraph","spans":[{"id":"spn-10666","marks":["code"],"text":"&time"},{"id":"spn-10667","text":" — when things happen"}]}],"id":"blk-11425","kind":"list-item"},{"blocks":[{"id":"blk-11428","kind":"paragraph","spans":[{"id":"spn-10668","marks":["code"],"text":"&space"},{"id":"spn-10669","text":" — where things are"}]}],"id":"blk-11427","kind":"list-item"},{"blocks":[{"id":"blk-11430","kind":"paragraph","spans":[{"id":"spn-10670","marks":["code"],"text":"&body"},{"id":"spn-10671","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-11429","kind":"list-item"},{"blocks":[{"id":"blk-11432","kind":"paragraph","spans":[{"id":"spn-10672","marks":["code"],"text":"&govern"},{"id":"spn-10673","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-11431","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11433","kind":"paragraph","spans":[{"id":"spn-10674","marks":["code"],"text":"&reason.attend"},{"id":"spn-10675","text":" sits under "},{"id":"spn-10676","marks":["code"],"text":"&reason"},{"id":"spn-10677","text":" and complements local decision subtypes by adding "},{"id":"spn-10678","marks":["bold"],"text":"meta-level control"},{"id":"spn-10679","text":":"}]},{"id":"blk-11434","items":[{"blocks":[{"id":"blk-11436","kind":"paragraph","spans":[{"id":"spn-10680","marks":["code"],"text":"&reason.argument"},{"id":"spn-10681","text":" helps decide "},{"id":"spn-10682","marks":["italic"],"text":"between options"}]}],"id":"blk-11435","kind":"list-item"},{"blocks":[{"id":"blk-11438","kind":"paragraph","spans":[{"id":"spn-10683","marks":["code"],"text":"&reason.plan"},{"id":"spn-10684","text":" helps decide "},{"id":"spn-10685","marks":["italic"],"text":"sequences of actions"}]}],"id":"blk-11437","kind":"list-item"},{"blocks":[{"id":"blk-11440","kind":"paragraph","spans":[{"id":"spn-10686","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10687","text":" helps reason through "},{"id":"spn-10688","marks":["italic"],"text":"cyclic dependencies"}]}],"id":"blk-11439","kind":"list-item"},{"blocks":[{"id":"blk-11442","kind":"paragraph","spans":[{"id":"spn-10689","marks":["code"],"text":"&reason.attend"},{"id":"spn-10690","text":" helps decide "},{"id":"spn-10691","marks":["italic"],"text":"what to reason or act on next"}]}],"id":"blk-11441","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11443","kind":"heading","level":2,"spans":[{"id":"spn-10692","text":"4. Capability contract"}]},{"id":"blk-11444","kind":"paragraph","spans":[{"id":"spn-10693","text":"A representative contract for "},{"id":"spn-10694","marks":["code"],"text":"&reason.attend"},{"id":"spn-10695","text":":"}]},{"id":"blk-11445","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&reason.attend\",\n  \"provider\": \"graphonomous\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Proactive attention contract for surveying active goals, triaging epistemic gaps, and dispatching bounded autonomy actions.\",\n  \"operations\": {\n    \"survey\": {\n      \"in\": \"context\",\n      \"out\": \"attention_map\",\n      \"description\": \"Build a ranked attention map from active goals, coverage assessments, and topology signals.\"\n    },\n    \"triage\": {\n      \"in\": \"attention_map\",\n      \"out\": \"attention_map\",\n      \"description\": \"Assign urgency, gap scores, and dispatch modes to attention items under governance and budget constraints.\"\n    },\n    \"dispatch\": {\n      \"in\": \"attention_map\",\n      \"out\": \"attention_cycle\",\n      \"description\": \"Execute or defer bounded explore/focus/act/escalate/propose dispatches according to autonomy level.\"\n    }\n  }\n}"},{"id":"blk-11446","kind":"heading","level":2,"spans":[{"id":"spn-10696","text":"5. Operations"}]},{"id":"blk-11447","kind":"heading","level":3,"spans":[{"id":"spn-10697","marks":["code"],"text":"survey(context) -> attention_map"}]},{"id":"blk-11448","kind":"paragraph","spans":[{"id":"spn-10698","text":"Builds a ranked set of attention candidates from available context, for example:"}]},{"id":"blk-11449","items":[{"blocks":[{"id":"blk-11451","kind":"paragraph","spans":[{"id":"spn-10699","text":"active goals"}]}],"id":"blk-11450","kind":"list-item"},{"blocks":[{"id":"blk-11453","kind":"paragraph","spans":[{"id":"spn-10700","text":"retrieval signals"}]}],"id":"blk-11452","kind":"list-item"},{"blocks":[{"id":"blk-11455","kind":"paragraph","spans":[{"id":"spn-10701","text":"coverage assessments"}]}],"id":"blk-11454","kind":"list-item"},{"blocks":[{"id":"blk-11457","kind":"paragraph","spans":[{"id":"spn-10702","text":"topology/κ signals"}]}],"id":"blk-11456","kind":"list-item"},{"blocks":[{"id":"blk-11459","kind":"paragraph","spans":[{"id":"spn-10703","text":"recent outcomes"}]}],"id":"blk-11458","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11460","kind":"heading","level":3,"spans":[{"id":"spn-10704","marks":["code"],"text":"triage(attention_map) -> attention_map"}]},{"id":"blk-11461","kind":"paragraph","spans":[{"id":"spn-10705","text":"Annotates and reorders attention items with fields such as:"}]},{"id":"blk-11462","items":[{"blocks":[{"id":"blk-11464","kind":"paragraph","spans":[{"id":"spn-10706","text":"urgency"}]}],"id":"blk-11463","kind":"list-item"},{"blocks":[{"id":"blk-11466","kind":"paragraph","spans":[{"id":"spn-10707","text":"epistemic gap"}]}],"id":"blk-11465","kind":"list-item"},{"blocks":[{"id":"blk-11468","kind":"paragraph","spans":[{"id":"spn-10708","text":"confidence/risk notes"}]}],"id":"blk-11467","kind":"list-item"},{"blocks":[{"id":"blk-11470","kind":"paragraph","spans":[{"id":"spn-10709","text":"selected dispatch mode"}]}],"id":"blk-11469","kind":"list-item"},{"blocks":[{"id":"blk-11472","kind":"paragraph","spans":[{"id":"spn-10710","text":"bounded rationale"}]}],"id":"blk-11471","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11473","kind":"heading","level":3,"spans":[{"id":"spn-10711","marks":["code"],"text":"dispatch(attention_map) -> attention_cycle"}]},{"id":"blk-11474","kind":"paragraph","spans":[{"id":"spn-10712","text":"Executes or defers actions under policy and budget:"}]},{"id":"blk-11475","items":[{"blocks":[{"id":"blk-11477","kind":"paragraph","spans":[{"id":"spn-10713","marks":["code"],"text":"explore"},{"id":"spn-10714","text":" — enrich memory/coverage"}]}],"id":"blk-11476","kind":"list-item"},{"blocks":[{"id":"blk-11479","kind":"paragraph","spans":[{"id":"spn-10715","marks":["code"],"text":"focus"},{"id":"spn-10716","text":" — invoke deeper deliberation"}]}],"id":"blk-11478","kind":"list-item"},{"blocks":[{"id":"blk-11481","kind":"paragraph","spans":[{"id":"spn-10717","marks":["code"],"text":"act"},{"id":"spn-10718","text":" — execute bounded action"}]}],"id":"blk-11480","kind":"list-item"},{"blocks":[{"id":"blk-11483","kind":"paragraph","spans":[{"id":"spn-10719","marks":["code"],"text":"escalate"},{"id":"spn-10720","text":" — defer to higher-trust/human path"}]}],"id":"blk-11482","kind":"list-item"},{"blocks":[{"id":"blk-11485","kind":"paragraph","spans":[{"id":"spn-10721","marks":["code"],"text":"propose"},{"id":"spn-10722","text":" — suggest new goal (if allowed)"}]}],"id":"blk-11484","kind":"list-item"},{"blocks":[{"id":"blk-11487","kind":"paragraph","spans":[{"id":"spn-10723","marks":["code"],"text":"idle"},{"id":"spn-10724","text":" — no action"}]}],"id":"blk-11486","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11488","kind":"heading","level":2,"spans":[{"id":"spn-10725","text":"6. Architecture pattern"}]},{"id":"blk-11489","kind":"paragraph","spans":[{"id":"spn-10726","text":"A common proactive loop:"}]},{"id":"blk-11490","kind":"code","language":"text","text":"heartbeat\n  |> &reason.attend.survey()\n  |> &reason.attend.triage()\n  |> &reason.attend.dispatch()\n  |> &memory.graph.store()"},{"id":"blk-11491","kind":"paragraph","spans":[{"id":"spn-10727","text":"A common demand-triggered loop (constrained tier):"}]},{"id":"blk-11492","kind":"code","language":"text","text":"query\n  |> &memory.graph.recall()\n  |> &memory.graph.topology()\n  |> &reason.attend.survey()\n  |> &reason.attend.dispatch()"},{"id":"blk-11493","kind":"paragraph","spans":[{"id":"spn-10728","text":"Interpretation:"}]},{"id":"blk-11494","items":[{"blocks":[{"id":"blk-11496","kind":"paragraph","spans":[{"id":"spn-10729","text":"survey/triage gives explicit prioritization"}]}],"id":"blk-11495","kind":"list-item"},{"blocks":[{"id":"blk-11498","kind":"paragraph","spans":[{"id":"spn-10730","text":"dispatch is budgeted and governed"}]}],"id":"blk-11497","kind":"list-item"},{"blocks":[{"id":"blk-11500","kind":"paragraph","spans":[{"id":"spn-10731","text":"cycle artifacts can be persisted for provenance and learning feedback"}]}],"id":"blk-11499","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11501","kind":"heading","level":2,"spans":[{"id":"spn-10732","text":"7. Example declaration snippet ("},{"id":"spn-10733","marks":["code"],"text":"ampersand.json"},{"id":"spn-10734","text":")"}]},{"id":"blk-11502","kind":"code","language":"json","text":"{\n  \"capabilities\": {\n    \"&reason.attend\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  },\n  \"governance\": {\n    \"autonomy\": {\n      \"level\": \"advise\",\n      \"model_tier\": \"local_small\",\n      \"heartbeat_seconds\": 300,\n      \"budget\": {\n        \"max_actions_per_hour\": 5,\n        \"max_deliberation_calls_per_query\": 1,\n        \"require_approval_for\": [\"act\", \"propose\"]\n      }\n    }\n  }\n}"},{"id":"blk-11503","kind":"heading","level":2,"spans":[{"id":"spn-10735","text":"8. Governance implications"}]},{"id":"blk-11504","kind":"paragraph","spans":[{"id":"spn-10736","marks":["code"],"text":"&reason.attend"},{"id":"spn-10737","text":" is where autonomy policy becomes operational."}]},{"id":"blk-11505","kind":"paragraph","spans":[{"id":"spn-10738","text":"Relevant governance fields:"}]},{"id":"blk-11506","items":[{"blocks":[{"id":"blk-11508","kind":"paragraph","spans":[{"id":"spn-10739","marks":["code"],"text":"hard"},{"id":"spn-10740","text":" / "},{"id":"spn-10741","marks":["code"],"text":"soft"}]}],"id":"blk-11507","kind":"list-item"},{"blocks":[{"id":"blk-11510","kind":"paragraph","spans":[{"id":"spn-10742","marks":["code"],"text":"escalate_when"}]}],"id":"blk-11509","kind":"list-item"},{"blocks":[{"id":"blk-11512","kind":"paragraph","spans":[{"id":"spn-10743","marks":["code"],"text":"autonomy.level"},{"id":"spn-10744","text":" ("},{"id":"spn-10745","marks":["code"],"text":"observe"},{"id":"spn-10746","text":", "},{"id":"spn-10747","marks":["code"],"text":"advise"},{"id":"spn-10748","text":", "},{"id":"spn-10749","marks":["code"],"text":"act"},{"id":"spn-10750","text":")"}]}],"id":"blk-11511","kind":"list-item"},{"blocks":[{"id":"blk-11514","kind":"paragraph","spans":[{"id":"spn-10751","marks":["code"],"text":"autonomy.model_tier"},{"id":"spn-10752","text":" ("},{"id":"spn-10753","marks":["code"],"text":"local_small"},{"id":"spn-10754","text":", "},{"id":"spn-10755","marks":["code"],"text":"local_large"},{"id":"spn-10756","text":", "},{"id":"spn-10757","marks":["code"],"text":"cloud_frontier"},{"id":"spn-10758","text":")"}]}],"id":"blk-11513","kind":"list-item"},{"blocks":[{"id":"blk-11516","kind":"paragraph","spans":[{"id":"spn-10759","marks":["code"],"text":"autonomy.heartbeat_seconds"}]}],"id":"blk-11515","kind":"list-item"},{"blocks":[{"id":"blk-11518","kind":"paragraph","spans":[{"id":"spn-10760","marks":["code"],"text":"autonomy.budget"},{"id":"spn-10761","text":" controls"}]}],"id":"blk-11517","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11519","kind":"paragraph","spans":[{"id":"spn-10762","text":"Typical effect:"}]},{"id":"blk-11520","items":[{"blocks":[{"id":"blk-11522","kind":"paragraph","spans":[{"id":"spn-10763","marks":["code"],"text":"observe"},{"id":"spn-10764","text":" → survey/triage only, no execution"}]}],"id":"blk-11521","kind":"list-item"},{"blocks":[{"id":"blk-11524","kind":"paragraph","spans":[{"id":"spn-10765","marks":["code"],"text":"advise"},{"id":"spn-10766","text":" → propose actions, wait for approval"}]}],"id":"blk-11523","kind":"list-item"},{"blocks":[{"id":"blk-11526","kind":"paragraph","spans":[{"id":"spn-10767","marks":["code"],"text":"act"},{"id":"spn-10768","text":" → execute bounded actions inside policy limits"}]}],"id":"blk-11525","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11527","kind":"heading","level":2,"spans":[{"id":"spn-10769","text":"9. Provenance implications"}]},{"id":"blk-11528","kind":"paragraph","spans":[{"id":"spn-10770","text":"Attention decisions should be auditable."}]},{"id":"blk-11529","kind":"paragraph","spans":[{"id":"spn-10771","text":"A useful provenance chain should preserve:"}]},{"id":"blk-11530","items":[{"blocks":[{"id":"blk-11532","kind":"paragraph","spans":[{"id":"spn-10772","text":"s