{"bendscript":"0.1","blocks":[{"id":"blk-11370","kind":"heading","level":1,"spans":[{"id":"spn-10401","marks":["code"],"text":"&reason.attend"},{"id":"spn-10402","text":" — Proactive Attention and Bounded Autonomy for the [&] Protocol"}]},{"id":"blk-11371","kind":"paragraph","spans":[{"id":"spn-10403","marks":["code"],"text":"&reason.attend"},{"id":"spn-10404","text":" is the capability page for the "},{"id":"spn-10405","marks":["code"],"text":"&reason.attend"},{"id":"spn-10406","text":" subtype in the [&] Protocol."}]},{"id":"blk-11372","kind":"paragraph","spans":[{"id":"spn-10407","text":"It represents a meta-reasoning surface for deciding "},{"id":"spn-10408","marks":["bold"],"text":"what should receive attention next"},{"id":"spn-10409","text":", under governance and budget constraints."}]},{"id":"blk-11373","kind":"paragraph","spans":[{"id":"spn-10410","text":"In short:"}]},{"blocks":[{"id":"blk-11375","kind":"paragraph","spans":[{"id":"spn-10411","marks":["code"],"text":"&reason.attend"},{"id":"spn-10412","text":" is the protocol capability for agents that should not only reason about a task, but also reason about "},{"id":"spn-10413","marks":["bold"],"text":"which tasks to prioritize, defer, escalate, or propose"},{"id":"spn-10414","text":"."}]}],"id":"blk-11374","kind":"quote"},{"id":"blk-11376","kind":"heading","level":2,"spans":[{"id":"spn-10415","text":"1. Definition"}]},{"id":"blk-11377","kind":"paragraph","spans":[{"id":"spn-10416","marks":["code"],"text":"&reason.attend"},{"id":"spn-10417","text":" is a subtype of the "},{"id":"spn-10418","marks":["code"],"text":"&reason"},{"id":"spn-10419","text":" primitive."}]},{"id":"blk-11378","kind":"paragraph","spans":[{"id":"spn-10420","text":"It describes a capability that continuously or on-demand:"}]},{"id":"blk-11379","items":[{"blocks":[{"id":"blk-11381","kind":"paragraph","spans":[{"id":"spn-10421","text":"surveys active context and goals"}]}],"id":"blk-11380","kind":"list-item"},{"blocks":[{"id":"blk-11383","kind":"paragraph","spans":[{"id":"spn-10422","text":"triages attention candidates"}]}],"id":"blk-11382","kind":"list-item"},{"blocks":[{"id":"blk-11385","kind":"paragraph","spans":[{"id":"spn-10423","text":"dispatches bounded actions according to autonomy policy"}]}],"id":"blk-11384","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11386","kind":"paragraph","spans":[{"id":"spn-10424","text":"Typical outputs include:"}]},{"id":"blk-11387","items":[{"blocks":[{"id":"blk-11389","kind":"paragraph","spans":[{"id":"spn-10425","text":"ranked attention maps"}]}],"id":"blk-11388","kind":"list-item"},{"blocks":[{"id":"blk-11391","kind":"paragraph","spans":[{"id":"spn-10426","text":"dispatch decisions ("},{"id":"spn-10427","marks":["code"],"text":"explore"},{"id":"spn-10428","text":", "},{"id":"spn-10429","marks":["code"],"text":"focus"},{"id":"spn-10430","text":", "},{"id":"spn-10431","marks":["code"],"text":"act"},{"id":"spn-10432","text":", "},{"id":"spn-10433","marks":["code"],"text":"escalate"},{"id":"spn-10434","text":", "},{"id":"spn-10435","marks":["code"],"text":"propose"},{"id":"spn-10436","text":", "},{"id":"spn-10437","marks":["code"],"text":"idle"},{"id":"spn-10438","text":")"}]}],"id":"blk-11390","kind":"list-item"},{"blocks":[{"id":"blk-11393","kind":"paragraph","spans":[{"id":"spn-10439","text":"cycle results suitable for storage, audit, and later learning"}]}],"id":"blk-11392","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11394","kind":"paragraph","spans":[{"id":"spn-10440","text":"Unlike generic scheduling logic hidden in runtime code, "},{"id":"spn-10441","marks":["code"],"text":"&reason.attend"},{"id":"spn-10442","text":" makes this behavior explicit and composable."}]},{"id":"blk-11395","kind":"heading","level":2,"spans":[{"id":"spn-10443","text":"2. Why this capability exists"}]},{"id":"blk-11396","kind":"paragraph","spans":[{"id":"spn-10444","text":"Many agent systems fail not because they cannot reason, but because they cannot "},{"id":"spn-10445","marks":["bold"],"text":"allocate reasoning effort"},{"id":"spn-10446","text":" well."}]},{"id":"blk-11397","kind":"paragraph","spans":[{"id":"spn-10447","text":"Real deployments need to answer:"}]},{"id":"blk-11398","items":[{"blocks":[{"id":"blk-11400","kind":"paragraph","spans":[{"id":"spn-10448","text":"Which goal is most urgent now?"}]}],"id":"blk-11399","kind":"list-item"},{"blocks":[{"id":"blk-11402","kind":"paragraph","spans":[{"id":"spn-10449","text":"Is coverage sufficient to act, or should we learn first?"}]}],"id":"blk-11401","kind":"list-item"},{"blocks":[{"id":"blk-11404","kind":"paragraph","spans":[{"id":"spn-10450","text":"Is this region cyclic/uncertain and requiring deeper deliberation?"}]}],"id":"blk-11403","kind":"list-item"},{"blocks":[{"id":"blk-11406","kind":"paragraph","spans":[{"id":"spn-10451","text":"Should we defer for approval, escalate, or proceed?"}]}],"id":"blk-11405","kind":"list-item"},{"blocks":[{"id":"blk-11408","kind":"paragraph","spans":[{"id":"spn-10452","text":"Are we within autonomy and budget constraints?"}]}],"id":"blk-11407","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11409","kind":"paragraph","spans":[{"id":"spn-10453","marks":["code"],"text":"&reason.attend"},{"id":"spn-10454","text":" exists so that these decisions are part of the protocol surface, not ad hoc internal glue."}]},{"id":"blk-11410","kind":"paragraph","spans":[{"id":"spn-10455","text":"This is especially important for:"}]},{"id":"blk-11411","items":[{"blocks":[{"id":"blk-11413","kind":"paragraph","spans":[{"id":"spn-10456","text":"long-running agents"}]}],"id":"blk-11412","kind":"list-item"},{"blocks":[{"id":"blk-11415","kind":"paragraph","spans":[{"id":"spn-10457","text":"multi-goal systems"}]}],"id":"blk-11414","kind":"list-item"},{"blocks":[{"id":"blk-11417","kind":"paragraph","spans":[{"id":"spn-10458","text":"cost-constrained deployments"}]}],"id":"blk-11416","kind":"list-item"},{"blocks":[{"id":"blk-11419","kind":"paragraph","spans":[{"id":"spn-10459","text":"safety-sensitive domains requiring escalation policy"}]}],"id":"blk-11418","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11420","kind":"heading","level":2,"spans":[{"id":"spn-10460","text":"3. Where it fits in the protocol"}]},{"id":"blk-11421","kind":"paragraph","spans":[{"id":"spn-10461","text":"The [&] Protocol organizes cognition, embodiment, and governance into six primitive families:"}]},{"id":"blk-11422","items":[{"blocks":[{"id":"blk-11424","kind":"paragraph","spans":[{"id":"spn-10462","marks":["code"],"text":"&memory"},{"id":"spn-10463","text":" — what the agent knows"}]}],"id":"blk-11423","kind":"list-item"},{"blocks":[{"id":"blk-11426","kind":"paragraph","spans":[{"id":"spn-10464","marks":["code"],"text":"&reason"},{"id":"spn-10465","text":" — how the agent decides"}]}],"id":"blk-11425","kind":"list-item"},{"blocks":[{"id":"blk-11428","kind":"paragraph","spans":[{"id":"spn-10466","marks":["code"],"text":"&time"},{"id":"spn-10467","text":" — when things happen"}]}],"id":"blk-11427","kind":"list-item"},{"blocks":[{"id":"blk-11430","kind":"paragraph","spans":[{"id":"spn-10468","marks":["code"],"text":"&space"},{"id":"spn-10469","text":" — where things are"}]}],"id":"blk-11429","kind":"list-item"},{"blocks":[{"id":"blk-11432","kind":"paragraph","spans":[{"id":"spn-10470","marks":["code"],"text":"&body"},{"id":"spn-10471","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-11431","kind":"list-item"},{"blocks":[{"id":"blk-11434","kind":"paragraph","spans":[{"id":"spn-10472","marks":["code"],"text":"&govern"},{"id":"spn-10473","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-11433","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11435","kind":"paragraph","spans":[{"id":"spn-10474","marks":["code"],"text":"&reason.attend"},{"id":"spn-10475","text":" sits under "},{"id":"spn-10476","marks":["code"],"text":"&reason"},{"id":"spn-10477","text":" and complements local decision subtypes by adding "},{"id":"spn-10478","marks":["bold"],"text":"meta-level control"},{"id":"spn-10479","text":":"}]},{"id":"blk-11436","items":[{"blocks":[{"id":"blk-11438","kind":"paragraph","spans":[{"id":"spn-10480","marks":["code"],"text":"&reason.argument"},{"id":"spn-10481","text":" helps decide "},{"id":"spn-10482","marks":["italic"],"text":"between options"}]}],"id":"blk-11437","kind":"list-item"},{"blocks":[{"id":"blk-11440","kind":"paragraph","spans":[{"id":"spn-10483","marks":["code"],"text":"&reason.plan"},{"id":"spn-10484","text":" helps decide "},{"id":"spn-10485","marks":["italic"],"text":"sequences of actions"}]}],"id":"blk-11439","kind":"list-item"},{"blocks":[{"id":"blk-11442","kind":"paragraph","spans":[{"id":"spn-10486","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-10487","text":" helps reason through "},{"id":"spn-10488","marks":["italic"],"text":"cyclic dependencies"}]}],"id":"blk-11441","kind":"list-item"},{"blocks":[{"id":"blk-11444","kind":"paragraph","spans":[{"id":"spn-10489","marks":["code"],"text":"&reason.attend"},{"id":"spn-10490","text":" helps decide "},{"id":"spn-10491","marks":["italic"],"text":"what to reason or act on next"}]}],"id":"blk-11443","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11445","kind":"heading","level":2,"spans":[{"id":"spn-10492","text":"4. Capability contract"}]},{"id":"blk-11446","kind":"paragraph","spans":[{"id":"spn-10493","text":"A representative contract for "},{"id":"spn-10494","marks":["code"],"text":"&reason.attend"},{"id":"spn-10495","text":":"}]},{"id":"blk-11447","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&reason.attend\",\n  \"provider\": \"graphonomous\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Proactive attention contract for surveying active goals, triaging epistemic gaps, and dispatching bounded autonomy actions.\",\n  \"operations\": {\n    \"survey\": {\n      \"in\": \"context\",\n      \"out\": \"attention_map\",\n      \"description\": \"Build a ranked attention map from active goals, coverage assessments, and topology signals.\"\n    },\n    \"triage\": {\n      \"in\": \"attention_map\",\n      \"out\": \"attention_map\",\n      \"description\": \"Assign urgency, gap scores, and dispatch modes to attention items under governance and budget constraints.\"\n    },\n    \"dispatch\": {\n      \"in\": \"attention_map\",\n      \"out\": \"attention_cycle\",\n      \"description\": \"Execute or defer bounded explore/focus/act/escalate/propose dispatches according to autonomy level.\"\n    }\n  }\n}"},{"id":"blk-11448","kind":"heading","level":2,"spans":[{"id":"spn-10496","text":"5. Operations"}]},{"id":"blk-11449","kind":"heading","level":3,"spans":[{"id":"spn-10497","marks":["code"],"text":"survey(context) -> attention_map"}]},{"id":"blk-11450","kind":"paragraph","spans":[{"id":"spn-10498","text":"Builds a ranked set of attention candidates from available context, for example:"}]},{"id":"blk-11451","items":[{"blocks":[{"id":"blk-11453","kind":"paragraph","spans":[{"id":"spn-10499","text":"active goals"}]}],"id":"blk-11452","kind":"list-item"},{"blocks":[{"id":"blk-11455","kind":"paragraph","spans":[{"id":"spn-10500","text":"retrieval signals"}]}],"id":"blk-11454","kind":"list-item"},{"blocks":[{"id":"blk-11457","kind":"paragraph","spans":[{"id":"spn-10501","text":"coverage assessments"}]}],"id":"blk-11456","kind":"list-item"},{"blocks":[{"id":"blk-11459","kind":"paragraph","spans":[{"id":"spn-10502","text":"topology/κ signals"}]}],"id":"blk-11458","kind":"list-item"},{"blocks":[{"id":"blk-11461","kind":"paragraph","spans":[{"id":"spn-10503","text":"recent outcomes"}]}],"id":"blk-11460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11462","kind":"heading","level":3,"spans":[{"id":"spn-10504","marks":["code"],"text":"triage(attention_map) -> attention_map"}]},{"id":"blk-11463","kind":"paragraph","spans":[{"id":"spn-10505","text":"Annotates and reorders attention items with fields such as:"}]},{"id":"blk-11464","items":[{"blocks":[{"id":"blk-11466","kind":"paragraph","spans":[{"id":"spn-10506","text":"urgency"}]}],"id":"blk-11465","kind":"list-item"},{"blocks":[{"id":"blk-11468","kind":"paragraph","spans":[{"id":"spn-10507","text":"epistemic gap"}]}],"id":"blk-11467","kind":"list-item"},{"blocks":[{"id":"blk-11470","kind":"paragraph","spans":[{"id":"spn-10508","text":"confidence/risk notes"}]}],"id":"blk-11469","kind":"list-item"},{"blocks":[{"id":"blk-11472","kind":"paragraph","spans":[{"id":"spn-10509","text":"selected dispatch mode"}]}],"id":"blk-11471","kind":"list-item"},{"blocks":[{"id":"blk-11474","kind":"paragraph","spans":[{"id":"spn-10510","text":"bounded rationale"}]}],"id":"blk-11473","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11475","kind":"heading","level":3,"spans":[{"id":"spn-10511","marks":["code"],"text":"dispatch(attention_map) -> attention_cycle"}]},{"id":"blk-11476","kind":"paragraph","spans":[{"id":"spn-10512","text":"Executes or defers actions under policy and budget:"}]},{"id":"blk-11477","items":[{"blocks":[{"id":"blk-11479","kind":"paragraph","spans":[{"id":"spn-10513","marks":["code"],"text":"explore"},{"id":"spn-10514","text":" — enrich memory/coverage"}]}],"id":"blk-11478","kind":"list-item"},{"blocks":[{"id":"blk-11481","kind":"paragraph","spans":[{"id":"spn-10515","marks":["code"],"text":"focus"},{"id":"spn-10516","text":" — invoke deeper deliberation"}]}],"id":"blk-11480","kind":"list-item"},{"blocks":[{"id":"blk-11483","kind":"paragraph","spans":[{"id":"spn-10517","marks":["code"],"text":"act"},{"id":"spn-10518","text":" — execute bounded action"}]}],"id":"blk-11482","kind":"list-item"},{"blocks":[{"id":"blk-11485","kind":"paragraph","spans":[{"id":"spn-10519","marks":["code"],"text":"escalate"},{"id":"spn-10520","text":" — defer to higher-trust/human path"}]}],"id":"blk-11484","kind":"list-item"},{"blocks":[{"id":"blk-11487","kind":"paragraph","spans":[{"id":"spn-10521","marks":["code"],"text":"propose"},{"id":"spn-10522","text":" — suggest new goal (if allowed)"}]}],"id":"blk-11486","kind":"list-item"},{"blocks":[{"id":"blk-11489","kind":"paragraph","spans":[{"id":"spn-10523","marks":["code"],"text":"idle"},{"id":"spn-10524","text":" — no action"}]}],"id":"blk-11488","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11490","kind":"heading","level":2,"spans":[{"id":"spn-10525","text":"6. Architecture pattern"}]},{"id":"blk-11491","kind":"paragraph","spans":[{"id":"spn-10526","text":"A common proactive loop:"}]},{"id":"blk-11492","kind":"code","language":"text","text":"heartbeat\n  |> &reason.attend.survey()\n  |> &reason.attend.triage()\n  |> &reason.attend.dispatch()\n  |> &memory.graph.store()"},{"id":"blk-11493","kind":"paragraph","spans":[{"id":"spn-10527","text":"A common demand-triggered loop (constrained tier):"}]},{"id":"blk-11494","kind":"code","language":"text","text":"query\n  |> &memory.graph.recall()\n  |> &memory.graph.topology()\n  |> &reason.attend.survey()\n  |> &reason.attend.dispatch()"},{"id":"blk-11495","kind":"paragraph","spans":[{"id":"spn-10528","text":"Interpretation:"}]},{"id":"blk-11496","items":[{"blocks":[{"id":"blk-11498","kind":"paragraph","spans":[{"id":"spn-10529","text":"survey/triage gives explicit prioritization"}]}],"id":"blk-11497","kind":"list-item"},{"blocks":[{"id":"blk-11500","kind":"paragraph","spans":[{"id":"spn-10530","text":"dispatch is budgeted and governed"}]}],"id":"blk-11499","kind":"list-item"},{"blocks":[{"id":"blk-11502","kind":"paragraph","spans":[{"id":"spn-10531","text":"cycle artifacts can be persisted for provenance and learning feedback"}]}],"id":"blk-11501","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11503","kind":"heading","level":2,"spans":[{"id":"spn-10532","text":"7. Example declaration snippet ("},{"id":"spn-10533","marks":["code"],"text":"ampersand.json"},{"id":"spn-10534","text":")"}]},{"id":"blk-11504","kind":"code","language":"json","text":"{\n  \"capabilities\": {\n    \"&reason.attend\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  },\n  \"governance\": {\n    \"autonomy\": {\n      \"level\": \"advise\",\n      \"model_tier\": \"local_small\",\n      \"heartbeat_seconds\": 300,\n      \"budget\": {\n        \"max_actions_per_hour\": 5,\n        \"max_deliberation_calls_per_query\": 1,\n        \"require_approval_for\": [\"act\", \"propose\"]\n      }\n    }\n  }\n}"},{"id":"blk-11505","kind":"heading","level":2,"spans":[{"id":"spn-10535","text":"8. Governance implications"}]},{"id":"blk-11506","kind":"paragraph","spans":[{"id":"spn-10536","marks":["code"],"text":"&reason.attend"},{"id":"spn-10537","text":" is where autonomy policy becomes operational."}]},{"id":"blk-11507","kind":"paragraph","spans":[{"id":"spn-10538","text":"Relevant governance fields:"}]},{"id":"blk-11508","items":[{"blocks":[{"id":"blk-11510","kind":"paragraph","spans":[{"id":"spn-10539","marks":["code"],"text":"hard"},{"id":"spn-10540","text":" / "},{"id":"spn-10541","marks":["code"],"text":"soft"}]}],"id":"blk-11509","kind":"list-item"},{"blocks":[{"id":"blk-11512","kind":"paragraph","spans":[{"id":"spn-10542","marks":["code"],"text":"escalate_when"}]}],"id":"blk-11511","kind":"list-item"},{"blocks":[{"id":"blk-11514","kind":"paragraph","spans":[{"id":"spn-10543","marks":["code"],"text":"autonomy.level"},{"id":"spn-10544","text":" ("},{"id":"spn-10545","marks":["code"],"text":"observe"},{"id":"spn-10546","text":", "},{"id":"spn-10547","marks":["code"],"text":"advise"},{"id":"spn-10548","text":", "},{"id":"spn-10549","marks":["code"],"text":"act"},{"id":"spn-10550","text":")"}]}],"id":"blk-11513","kind":"list-item"},{"blocks":[{"id":"blk-11516","kind":"paragraph","spans":[{"id":"spn-10551","marks":["code"],"text":"autonomy.model_tier"},{"id":"spn-10552","text":" ("},{"id":"spn-10553","marks":["code"],"text":"local_small"},{"id":"spn-10554","text":", "},{"id":"spn-10555","marks":["code"],"text":"local_large"},{"id":"spn-10556","text":", "},{"id":"spn-10557","marks":["code"],"text":"cloud_frontier"},{"id":"spn-10558","text":")"}]}],"id":"blk-11515","kind":"list-item"},{"blocks":[{"id":"blk-11518","kind":"paragraph","spans":[{"id":"spn-10559","marks":["code"],"text":"autonomy.heartbeat_seconds"}]}],"id":"blk-11517","kind":"list-item"},{"blocks":[{"id":"blk-11520","kind":"paragraph","spans":[{"id":"spn-10560","marks":["code"],"text":"autonomy.budget"},{"id":"spn-10561","text":" controls"}]}],"id":"blk-11519","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11521","kind":"paragraph","spans":[{"id":"spn-10562","text":"Typical effect:"}]},{"id":"blk-11522","items":[{"blocks":[{"id":"blk-11524","kind":"paragraph","spans":[{"id":"spn-10563","marks":["code"],"text":"observe"},{"id":"spn-10564","text":" → survey/triage only, no execution"}]}],"id":"blk-11523","kind":"list-item"},{"blocks":[{"id":"blk-11526","kind":"paragraph","spans":[{"id":"spn-10565","marks":["code"],"text":"advise"},{"id":"spn-10566","text":" → propose actions, wait for approval"}]}],"id":"blk-11525","kind":"list-item"},{"blocks":[{"id":"blk-11528","kind":"paragraph","spans":[{"id":"spn-10567","marks":["code"],"text":"act"},{"id":"spn-10568","text":" → execute bounded actions inside policy limits"}]}],"id":"blk-11527","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-11529","kind":"heading","level":2,"spans":[{"id":"spn-10569","text":"9. Provenance implications"}]},{"id":"blk-11530","kind":"paragraph","spans":[{"id":"spn-10570","text":"Attention decisions should be auditable."}]},{"id":"blk-11531","kind":"paragraph","spans":[{"id":"spn-10571","text":"A useful provenance chain should preserve:"}]},{"id":"blk-11532","items":[{"blocks":[{"id":"blk-11534","kind":"paragraph","spans":[{"id":"spn-10572","text":"s