{"bendscript":"0.1","blocks":[{"id":"blk-25176","kind":"heading","level":1,"spans":[{"id":"spn-29883","text":"07 — Security and Secrets"}]},{"blocks":[{"id":"blk-25178","kind":"paragraph","spans":[{"id":"spn-29884","marks":["bold"],"text":"Purpose:"},{"id":"spn-29885","text":" Tenant isolation via RLS, encrypted secret storage via Supabase Vault, telemetry authentication, abuse prevention, supply chain validation, and audit logging requirements."}]}],"id":"blk-25177","kind":"quote"},{"id":"blk-25179","kind":"paragraph","spans":[{"id":"spn-29886","text":"---"}]},{"id":"blk-25180","kind":"heading","level":2,"spans":[{"id":"spn-29887","text":"Tenant Isolation (RLS)"}]},{"id":"blk-25181","kind":"paragraph","spans":[{"id":"spn-29888","text":"Every table in the control plane database enforces Row-Level Security:"}]},{"id":"blk-25182","kind":"code","language":"sql","text":"-- Example: agents table policy\nCREATE POLICY \"users can only access own agents\"\n  ON agents\n  FOR ALL\n  USING (auth.uid() = user_id)\n  WITH CHECK (auth.uid() = user_id);"},{"id":"blk-25183","kind":"heading","level":3,"spans":[{"id":"spn-29889","text":"RLS Rules"}]},{"head":[{"id":"blk-25185","spans":[{"id":"spn-29890","text":"Table"}]},{"id":"blk-25186","spans":[{"id":"spn-29891","text":"Policy"}]}],"id":"blk-25184","kind":"table","rows":[[{"id":"blk-25187","spans":[{"id":"spn-29892","marks":["code"],"text":"users"}]},{"id":"blk-25188","spans":[{"id":"spn-29893","marks":["code"],"text":"auth.uid() = id"}]}],[{"id":"blk-25189","spans":[{"id":"spn-29894","marks":["code"],"text":"agents"}]},{"id":"blk-25190","spans":[{"id":"spn-29895","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-25191","spans":[{"id":"spn-29896","marks":["code"],"text":"deployments"}]},{"id":"blk-25192","spans":[{"id":"spn-29897","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-25193","spans":[{"id":"spn-29898","marks":["code"],"text":"metrics_events"}]},{"id":"blk-25194","spans":[{"id":"spn-29899","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-25195","spans":[{"id":"spn-29900","marks":["code"],"text":"billing_usage"}]},{"id":"blk-25196","spans":[{"id":"spn-29901","marks":["code"],"text":"auth.uid() = user_id"}]}]]},{"id":"blk-25197","kind":"paragraph","spans":[{"id":"spn-29902","marks":["bold"],"text":"Hard rule:"},{"id":"spn-29903","text":" No table is accessible without an RLS policy. If a new table is added, an RLS policy must be created before any data is inserted."}]},{"id":"blk-25198","kind":"heading","level":3,"spans":[{"id":"spn-29904","text":"Provider Namespace Isolation"}]},{"id":"blk-25199","kind":"paragraph","spans":[{"id":"spn-29905","text":"Runtime provider resources are namespaced per user:"}]},{"id":"blk-25200","items":[{"blocks":[{"id":"blk-25202","kind":"paragraph","spans":[{"id":"spn-29906","text":"Cloudflare: Worker names include user ID prefix"}]}],"id":"blk-25201","kind":"list-item"},{"blocks":[{"id":"blk-25204","kind":"paragraph","spans":[{"id":"spn-29907","text":"AgentCore: Runtime resources tagged with user ID"}]}],"id":"blk-25203","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25205","kind":"paragraph","spans":[{"id":"spn-29908","text":"---"}]},{"id":"blk-25206","kind":"heading","level":2,"spans":[{"id":"spn-29909","text":"Secrets Handling"}]},{"id":"blk-25207","kind":"heading","level":3,"spans":[{"id":"spn-29910","text":"Supabase Vault"}]},{"id":"blk-25208","kind":"paragraph","spans":[{"id":"spn-29911","text":"Secrets are stored in "},{"id":"spn-29912","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-29913","text":" -- an encrypted key-value store built into Supabase. The primary database ("},{"id":"spn-29914","marks":["code"],"text":"agents"},{"id":"spn-29915","text":", "},{"id":"spn-29916","marks":["code"],"text":"deployments"},{"id":"spn-29917","text":", etc.) never contains plaintext secret values."}]},{"id":"blk-25209","kind":"code","language":"text","text":"User adds secret \"OPENAI_API_KEY\" via dashboard\n  -> Value encrypted and stored in Vault (vault.secrets)\n  -> agents.env_var_keys = [\"OPENAI_API_KEY\"] (key name only)"},{"id":"blk-25210","kind":"heading","level":3,"spans":[{"id":"spn-29918","text":"Secret Lifecycle"}]},{"id":"blk-25211","kind":"code","language":"text","text":"1. User creates secret via UI -> stored in Vault\n2. Deploy triggers -> Edge Function reads from Vault\n3. Secret pushed to provider mechanism:\n   - Cloudflare: Workers Secrets API\n   - AgentCore: Environment variable injection / Secrets Manager\n4. Vault reference remains; plaintext never logged"},{"id":"blk-25212","kind":"heading","level":3,"spans":[{"id":"spn-29919","text":"Secret Rotation"}]},{"id":"blk-25213","kind":"paragraph","spans":[{"id":"spn-29920","text":"1. User updates secret value in Vault via dashboard 2. User triggers a re-deploy to push the new value to the provider 3. Old provider secret is overwritten"}]},{"id":"blk-25214","kind":"paragraph","spans":[{"id":"spn-29921","marks":["bold"],"text":"Rule:"},{"id":"spn-29922","text":" Never log secret values. Never include secrets in error messages, telemetry events, or API responses."}]},{"id":"blk-25215","kind":"paragraph","spans":[{"id":"spn-29923","text":"---"}]},{"id":"blk-25216","kind":"heading","level":2,"spans":[{"id":"spn-29924","text":"Telemetry Authentication"}]},{"id":"blk-25217","kind":"paragraph","spans":[{"id":"spn-29925","text":"The telemetry ingestion endpoint rejects unauthenticated events. See "},{"id":"spn-29926","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"},{"id":"spn-29927","text":" for HMAC and JWT details."}]},{"id":"blk-25218","kind":"paragraph","spans":[{"id":"spn-29928","text":"Key requirements:"}]},{"id":"blk-25219","items":[{"blocks":[{"id":"blk-25221","kind":"paragraph","spans":[{"id":"spn-29929","text":"[ ] Per-deployment signing key generated at deploy time"}]}],"id":"blk-25220","kind":"list-item"},{"blocks":[{"id":"blk-25223","kind":"paragraph","spans":[{"id":"spn-29930","text":"[ ] Signing key stored in Vault (not in the deployments table)"}]}],"id":"blk-25222","kind":"list-item"},{"blocks":[{"id":"blk-25225","kind":"paragraph","spans":[{"id":"spn-29931","text":"[ ] Anti-replay: timestamp within 5-minute window"}]}],"id":"blk-25224","kind":"list-item"},{"blocks":[{"id":"blk-25227","kind":"paragraph","spans":[{"id":"spn-29932","text":"[ ] Attribution verified against deployment records"}]}],"id":"blk-25226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25228","kind":"paragraph","spans":[{"id":"spn-29933","text":"---"}]},{"id":"blk-25229","kind":"heading","level":2,"spans":[{"id":"spn-29934","text":"Abuse Prevention"}]},{"id":"blk-25230","kind":"heading","level":3,"spans":[{"id":"spn-29935","text":"Rate Limiting"}]},{"head":[{"id":"blk-25232","spans":[{"id":"spn-29936","text":"Scope"}]},{"id":"blk-25233","spans":[{"id":"spn-29937","text":"Limit"}]}],"id":"blk-25231","kind":"table","rows":[[{"id":"blk-25234","spans":[{"id":"spn-29938","text":"Per-user, all agents"}]},{"id":"blk-25235","spans":[{"id":"spn-29939","text":"N requests/second (configurable)"}]}],[{"id":"blk-25236","spans":[{"id":"spn-29940","text":"Per-agent"}]},{"id":"blk-25237","spans":[{"id":"spn-29941","text":"M requests/second (configurable)"}]}],[{"id":"blk-25238","spans":[{"id":"spn-29942","text":"Payload size"}]},{"id":"blk-25239","spans":[{"id":"spn-29943","text":"Max 1 MB request body"}]}]]},{"id":"blk-25240","kind":"heading","level":3,"spans":[{"id":"spn-29944","text":"Input Validation"}]},{"id":"blk-25241","items":[{"blocks":[{"id":"blk-25243","kind":"paragraph","spans":[{"id":"spn-29945","text":"Reject oversized payloads before parsing"}]}],"id":"blk-25242","kind":"list-item"},{"blocks":[{"id":"blk-25245","kind":"paragraph","spans":[{"id":"spn-29946","text":"Validate JSON structure before processing"}]}],"id":"blk-25244","kind":"list-item"},{"blocks":[{"id":"blk-25247","kind":"paragraph","spans":[{"id":"spn-29947","text":"Prevent prompt bombing (excessively long message arrays)"}]}],"id":"blk-25246","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25248","kind":"heading","level":3,"spans":[{"id":"spn-29948","text":"Account-Level"}]},{"id":"blk-25249","items":[{"blocks":[{"id":"blk-25251","kind":"paragraph","spans":[{"id":"spn-29949","text":"Disable agent on repeated errors"}]}],"id":"blk-25250","kind":"list-item"},{"blocks":[{"id":"blk-25253","kind":"paragraph","spans":[{"id":"spn-29950","text":"Flag accounts with anomalous usage patterns"}]}],"id":"blk-25252","kind":"list-item"},{"blocks":[{"id":"blk-25255","kind":"paragraph","spans":[{"id":"spn-29951","text":"Hard-stop on plan limits (see "},{"id":"spn-29952","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"},{"id":"spn-29953","text":")"}]}],"id":"blk-25254","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25256","kind":"paragraph","spans":[{"id":"spn-29954","text":"---"}]},{"id":"blk-25257","kind":"heading","level":2,"spans":[{"id":"spn-29955","text":"Supply Chain Validation"}]},{"id":"blk-25258","kind":"paragraph","spans":[{"id":"spn-29956","text":"Uploaded bundles must pass validation before deployment:"}]},{"head":[{"id":"blk-25260","spans":[{"id":"spn-29957","text":"Check"}]},{"id":"blk-25261","spans":[{"id":"spn-29958","text":"Rule"}]}],"id":"blk-25259","kind":"table","rows":[[{"id":"blk-25262","spans":[{"id":"spn-29959","text":"Size limit"}]},{"id":"blk-25263","spans":[{"id":"spn-29960","text":"Max compressed size (e.g., 50 MB)"}]}],[{"id":"blk-25264","spans":[{"id":"spn-29961","text":"File count"}]},{"id":"blk-25265","spans":[{"id":"spn-29962","text":"Max files (e.g., 10,000)"}]}],[{"id":"blk-25266","spans":[{"id":"spn-29963","text":"Path traversal"}]},{"id":"blk-25267","spans":[{"id":"spn-29964","text":"Reject entries with "},{"id":"spn-29965","marks":["code"],"text":"../"},{"id":"spn-29966","text":" or absolute paths"}]}],[{"id":"blk-25268","spans":[{"id":"spn-29967","text":"Symlinks"}]},{"id":"blk-25269","spans":[{"id":"spn-29968","text":"Reject unsafe symlinks"}]}],[{"id":"blk-25270","spans":[{"id":"spn-29969","text":"Required files"}]},{"id":"blk-25271","spans":[{"id":"spn-29970","marks":["code"],"text":"agent.config.json"},{"id":"spn-29971","text":" + entrypoint must exist"}]}],[{"id":"blk-25272","spans":[{"id":"spn-29972","text":"Manifest validity"}]},{"id":"blk-25273","spans":[{"id":"spn-29973","text":"JSON parses, required fields present"}]}]]},{"id":"blk-25274","kind":"paragraph","spans":[{"id":"spn-29974","text":"Post-MVP: dependency scanning for known vulnerabilities."}]},{"id":"blk-25275","kind":"paragraph","spans":[{"id":"spn-29975","text":"---"}]},{"id":"blk-25276","kind":"heading","level":2,"spans":[{"id":"spn-29976","text":"Audit Log"}]},{"id":"blk-25277","kind":"paragraph","spans":[{"id":"spn-29977","text":"The platform SHOULD maintain an audit log for security-sensitive operations:"}]},{"head":[{"id":"blk-25279","spans":[{"id":"spn-29978","text":"Event"}]},{"id":"blk-25280","spans":[{"id":"spn-29979","text":"Fields"}]}],"id":"blk-25278","kind":"table","rows":[[{"id":"blk-25281","spans":[{"id":"spn-29980","text":"Agent created"}]},{"id":"blk-25282","spans":[{"id":"spn-29981","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-25283","spans":[{"id":"spn-29982","text":"Agent disabled"}]},{"id":"blk-25284","spans":[{"id":"spn-29983","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-25285","spans":[{"id":"spn-29984","text":"Deployment created"}]},{"id":"blk-25286","spans":[{"id":"spn-29985","text":"user_id, agent_id, deployment_id, timestamp"}]}],[{"id":"blk-25287","spans":[{"id":"spn-29986","text":"Secret created/rotated"}]},{"id":"blk-25288","spans":[{"id":"spn-29987","text":"user_id, secret_key (not value), timestamp"}]}],[{"id":"blk-25289","spans":[{"id":"spn-29988","text":"Tier changed"}]},{"id":"blk-25290","spans":[{"id":"spn-29989","text":"user_id, old_tier, new_tier, timestamp"}]}],[{"id":"blk-25291","spans":[{"id":"spn-29990","text":"Invocation rejected (limit)"}]},{"id":"blk-25292","spans":[{"id":"spn-29991","text":"user_id, agent_id, reason, timestamp"}]}]]},{"id":"blk-25293","kind":"paragraph","spans":[{"id":"spn-29992","text":"Audit log entries are append-only and retained for at least 90 days regardless of tier."}]},{"id":"blk-25294","kind":"paragraph","spans":[{"id":"spn-29993","text":"---"}]},{"id":"blk-25295","kind":"heading","level":2,"spans":[{"id":"spn-29994","text":"Security Checklist"}]},{"id":"blk-25296","items":[{"blocks":[{"id":"blk-25298","kind":"paragraph","spans":[{"id":"spn-29995","text":"[ ] RLS policy exists on every table"}]}],"id":"blk-25297","kind":"list-item"},{"blocks":[{"id":"blk-25300","kind":"paragraph","spans":[{"id":"spn-29996","text":"[ ] No plaintext secrets in "},{"id":"spn-29997","marks":["code"],"text":"agents"},{"id":"spn-29998","text":", "},{"id":"spn-29999","marks":["code"],"text":"deployments"},{"id":"spn-30000","text":", or "},{"id":"spn-30001","marks":["code"],"text":"metrics_events"},{"id":"spn-30002","text":" tables"}]}],"id":"blk-25299","kind":"list-item"},{"blocks":[{"id":"blk-25302","kind":"paragraph","spans":[{"id":"spn-30003","text":"[ ] Secrets stored exclusively in Supabase Vault"}]}],"id":"blk-25301","kind":"list-item"},{"blocks":[{"id":"blk-25304","kind":"paragraph","spans":[{"id":"spn-30004","text":"[ ] Secret values never appear in logs, errors, or telemetry"}]}],"id":"blk-25303","kind":"list-item"},{"blocks":[{"id":"blk-25306","kind":"paragraph","spans":[{"id":"spn-30005","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-25305","kind":"list-item"},{"blocks":[{"id":"blk-25308","kind":"paragraph","spans":[{"id":"spn-30006","text":"[ ] Rate limiting is enforced per-user and per-agent"}]}],"id":"blk-25307","kind":"list-item"},{"blocks":[{"id":"blk-25310","kind":"paragraph","spans":[{"id":"spn-30007","text":"[ ] Uploaded bundles pass all supply chain validation checks"}]}],"id":"blk-25309","kind":"list-item"},{"blocks":[{"id":"bl