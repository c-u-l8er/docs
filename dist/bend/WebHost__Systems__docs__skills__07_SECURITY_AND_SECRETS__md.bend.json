{"bendscript":"0.1","blocks":[{"id":"blk-24581","kind":"heading","level":1,"spans":[{"id":"spn-28081","text":"07 — Security and Secrets"}]},{"blocks":[{"id":"blk-24583","kind":"paragraph","spans":[{"id":"spn-28082","marks":["bold"],"text":"Purpose:"},{"id":"spn-28083","text":" Tenant isolation via RLS, encrypted secret storage via Supabase Vault, telemetry authentication, abuse prevention, supply chain validation, and audit logging requirements."}]}],"id":"blk-24582","kind":"quote"},{"id":"blk-24584","kind":"paragraph","spans":[{"id":"spn-28084","text":"---"}]},{"id":"blk-24585","kind":"heading","level":2,"spans":[{"id":"spn-28085","text":"Tenant Isolation (RLS)"}]},{"id":"blk-24586","kind":"paragraph","spans":[{"id":"spn-28086","text":"Every table in the control plane database enforces Row-Level Security:"}]},{"id":"blk-24587","kind":"code","language":"sql","text":"-- Example: agents table policy\nCREATE POLICY \"users can only access own agents\"\n  ON agents\n  FOR ALL\n  USING (auth.uid() = user_id)\n  WITH CHECK (auth.uid() = user_id);"},{"id":"blk-24588","kind":"heading","level":3,"spans":[{"id":"spn-28087","text":"RLS Rules"}]},{"head":[{"id":"blk-24590","spans":[{"id":"spn-28088","text":"Table"}]},{"id":"blk-24591","spans":[{"id":"spn-28089","text":"Policy"}]}],"id":"blk-24589","kind":"table","rows":[[{"id":"blk-24592","spans":[{"id":"spn-28090","marks":["code"],"text":"users"}]},{"id":"blk-24593","spans":[{"id":"spn-28091","marks":["code"],"text":"auth.uid() = id"}]}],[{"id":"blk-24594","spans":[{"id":"spn-28092","marks":["code"],"text":"agents"}]},{"id":"blk-24595","spans":[{"id":"spn-28093","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-24596","spans":[{"id":"spn-28094","marks":["code"],"text":"deployments"}]},{"id":"blk-24597","spans":[{"id":"spn-28095","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-24598","spans":[{"id":"spn-28096","marks":["code"],"text":"metrics_events"}]},{"id":"blk-24599","spans":[{"id":"spn-28097","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-24600","spans":[{"id":"spn-28098","marks":["code"],"text":"billing_usage"}]},{"id":"blk-24601","spans":[{"id":"spn-28099","marks":["code"],"text":"auth.uid() = user_id"}]}]]},{"id":"blk-24602","kind":"paragraph","spans":[{"id":"spn-28100","marks":["bold"],"text":"Hard rule:"},{"id":"spn-28101","text":" No table is accessible without an RLS policy. If a new table is added, an RLS policy must be created before any data is inserted."}]},{"id":"blk-24603","kind":"heading","level":3,"spans":[{"id":"spn-28102","text":"Provider Namespace Isolation"}]},{"id":"blk-24604","kind":"paragraph","spans":[{"id":"spn-28103","text":"Runtime provider resources are namespaced per user:"}]},{"id":"blk-24605","items":[{"blocks":[{"id":"blk-24607","kind":"paragraph","spans":[{"id":"spn-28104","text":"Cloudflare: Worker names include user ID prefix"}]}],"id":"blk-24606","kind":"list-item"},{"blocks":[{"id":"blk-24609","kind":"paragraph","spans":[{"id":"spn-28105","text":"AgentCore: Runtime resources tagged with user ID"}]}],"id":"blk-24608","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24610","kind":"paragraph","spans":[{"id":"spn-28106","text":"---"}]},{"id":"blk-24611","kind":"heading","level":2,"spans":[{"id":"spn-28107","text":"Secrets Handling"}]},{"id":"blk-24612","kind":"heading","level":3,"spans":[{"id":"spn-28108","text":"Supabase Vault"}]},{"id":"blk-24613","kind":"paragraph","spans":[{"id":"spn-28109","text":"Secrets are stored in "},{"id":"spn-28110","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-28111","text":" -- an encrypted key-value store built into Supabase. The primary database ("},{"id":"spn-28112","marks":["code"],"text":"agents"},{"id":"spn-28113","text":", "},{"id":"spn-28114","marks":["code"],"text":"deployments"},{"id":"spn-28115","text":", etc.) never contains plaintext secret values."}]},{"id":"blk-24614","kind":"code","language":"text","text":"User adds secret \"OPENAI_API_KEY\" via dashboard\n  -> Value encrypted and stored in Vault (vault.secrets)\n  -> agents.env_var_keys = [\"OPENAI_API_KEY\"] (key name only)"},{"id":"blk-24615","kind":"heading","level":3,"spans":[{"id":"spn-28116","text":"Secret Lifecycle"}]},{"id":"blk-24616","kind":"code","language":"text","text":"1. User creates secret via UI -> stored in Vault\n2. Deploy triggers -> Edge Function reads from Vault\n3. Secret pushed to provider mechanism:\n   - Cloudflare: Workers Secrets API\n   - AgentCore: Environment variable injection / Secrets Manager\n4. Vault reference remains; plaintext never logged"},{"id":"blk-24617","kind":"heading","level":3,"spans":[{"id":"spn-28117","text":"Secret Rotation"}]},{"id":"blk-24618","kind":"paragraph","spans":[{"id":"spn-28118","text":"1. User updates secret value in Vault via dashboard 2. User triggers a re-deploy to push the new value to the provider 3. Old provider secret is overwritten"}]},{"id":"blk-24619","kind":"paragraph","spans":[{"id":"spn-28119","marks":["bold"],"text":"Rule:"},{"id":"spn-28120","text":" Never log secret values. Never include secrets in error messages, telemetry events, or API responses."}]},{"id":"blk-24620","kind":"paragraph","spans":[{"id":"spn-28121","text":"---"}]},{"id":"blk-24621","kind":"heading","level":2,"spans":[{"id":"spn-28122","text":"Telemetry Authentication"}]},{"id":"blk-24622","kind":"paragraph","spans":[{"id":"spn-28123","text":"The telemetry ingestion endpoint rejects unauthenticated events. See "},{"id":"spn-28124","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"},{"id":"spn-28125","text":" for HMAC and JWT details."}]},{"id":"blk-24623","kind":"paragraph","spans":[{"id":"spn-28126","text":"Key requirements:"}]},{"id":"blk-24624","items":[{"blocks":[{"id":"blk-24626","kind":"paragraph","spans":[{"id":"spn-28127","text":"[ ] Per-deployment signing key generated at deploy time"}]}],"id":"blk-24625","kind":"list-item"},{"blocks":[{"id":"blk-24628","kind":"paragraph","spans":[{"id":"spn-28128","text":"[ ] Signing key stored in Vault (not in the deployments table)"}]}],"id":"blk-24627","kind":"list-item"},{"blocks":[{"id":"blk-24630","kind":"paragraph","spans":[{"id":"spn-28129","text":"[ ] Anti-replay: timestamp within 5-minute window"}]}],"id":"blk-24629","kind":"list-item"},{"blocks":[{"id":"blk-24632","kind":"paragraph","spans":[{"id":"spn-28130","text":"[ ] Attribution verified against deployment records"}]}],"id":"blk-24631","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24633","kind":"paragraph","spans":[{"id":"spn-28131","text":"---"}]},{"id":"blk-24634","kind":"heading","level":2,"spans":[{"id":"spn-28132","text":"Abuse Prevention"}]},{"id":"blk-24635","kind":"heading","level":3,"spans":[{"id":"spn-28133","text":"Rate Limiting"}]},{"head":[{"id":"blk-24637","spans":[{"id":"spn-28134","text":"Scope"}]},{"id":"blk-24638","spans":[{"id":"spn-28135","text":"Limit"}]}],"id":"blk-24636","kind":"table","rows":[[{"id":"blk-24639","spans":[{"id":"spn-28136","text":"Per-user, all agents"}]},{"id":"blk-24640","spans":[{"id":"spn-28137","text":"N requests/second (configurable)"}]}],[{"id":"blk-24641","spans":[{"id":"spn-28138","text":"Per-agent"}]},{"id":"blk-24642","spans":[{"id":"spn-28139","text":"M requests/second (configurable)"}]}],[{"id":"blk-24643","spans":[{"id":"spn-28140","text":"Payload size"}]},{"id":"blk-24644","spans":[{"id":"spn-28141","text":"Max 1 MB request body"}]}]]},{"id":"blk-24645","kind":"heading","level":3,"spans":[{"id":"spn-28142","text":"Input Validation"}]},{"id":"blk-24646","items":[{"blocks":[{"id":"blk-24648","kind":"paragraph","spans":[{"id":"spn-28143","text":"Reject oversized payloads before parsing"}]}],"id":"blk-24647","kind":"list-item"},{"blocks":[{"id":"blk-24650","kind":"paragraph","spans":[{"id":"spn-28144","text":"Validate JSON structure before processing"}]}],"id":"blk-24649","kind":"list-item"},{"blocks":[{"id":"blk-24652","kind":"paragraph","spans":[{"id":"spn-28145","text":"Prevent prompt bombing (excessively long message arrays)"}]}],"id":"blk-24651","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24653","kind":"heading","level":3,"spans":[{"id":"spn-28146","text":"Account-Level"}]},{"id":"blk-24654","items":[{"blocks":[{"id":"blk-24656","kind":"paragraph","spans":[{"id":"spn-28147","text":"Disable agent on repeated errors"}]}],"id":"blk-24655","kind":"list-item"},{"blocks":[{"id":"blk-24658","kind":"paragraph","spans":[{"id":"spn-28148","text":"Flag accounts with anomalous usage patterns"}]}],"id":"blk-24657","kind":"list-item"},{"blocks":[{"id":"blk-24660","kind":"paragraph","spans":[{"id":"spn-28149","text":"Hard-stop on plan limits (see "},{"id":"spn-28150","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"},{"id":"spn-28151","text":")"}]}],"id":"blk-24659","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24661","kind":"paragraph","spans":[{"id":"spn-28152","text":"---"}]},{"id":"blk-24662","kind":"heading","level":2,"spans":[{"id":"spn-28153","text":"Supply Chain Validation"}]},{"id":"blk-24663","kind":"paragraph","spans":[{"id":"spn-28154","text":"Uploaded bundles must pass validation before deployment:"}]},{"head":[{"id":"blk-24665","spans":[{"id":"spn-28155","text":"Check"}]},{"id":"blk-24666","spans":[{"id":"spn-28156","text":"Rule"}]}],"id":"blk-24664","kind":"table","rows":[[{"id":"blk-24667","spans":[{"id":"spn-28157","text":"Size limit"}]},{"id":"blk-24668","spans":[{"id":"spn-28158","text":"Max compressed size (e.g., 50 MB)"}]}],[{"id":"blk-24669","spans":[{"id":"spn-28159","text":"File count"}]},{"id":"blk-24670","spans":[{"id":"spn-28160","text":"Max files (e.g., 10,000)"}]}],[{"id":"blk-24671","spans":[{"id":"spn-28161","text":"Path traversal"}]},{"id":"blk-24672","spans":[{"id":"spn-28162","text":"Reject entries with "},{"id":"spn-28163","marks":["code"],"text":"../"},{"id":"spn-28164","text":" or absolute paths"}]}],[{"id":"blk-24673","spans":[{"id":"spn-28165","text":"Symlinks"}]},{"id":"blk-24674","spans":[{"id":"spn-28166","text":"Reject unsafe symlinks"}]}],[{"id":"blk-24675","spans":[{"id":"spn-28167","text":"Required files"}]},{"id":"blk-24676","spans":[{"id":"spn-28168","marks":["code"],"text":"agent.config.json"},{"id":"spn-28169","text":" + entrypoint must exist"}]}],[{"id":"blk-24677","spans":[{"id":"spn-28170","text":"Manifest validity"}]},{"id":"blk-24678","spans":[{"id":"spn-28171","text":"JSON parses, required fields present"}]}]]},{"id":"blk-24679","kind":"paragraph","spans":[{"id":"spn-28172","text":"Post-MVP: dependency scanning for known vulnerabilities."}]},{"id":"blk-24680","kind":"paragraph","spans":[{"id":"spn-28173","text":"---"}]},{"id":"blk-24681","kind":"heading","level":2,"spans":[{"id":"spn-28174","text":"Audit Log"}]},{"id":"blk-24682","kind":"paragraph","spans":[{"id":"spn-28175","text":"The platform SHOULD maintain an audit log for security-sensitive operations:"}]},{"head":[{"id":"blk-24684","spans":[{"id":"spn-28176","text":"Event"}]},{"id":"blk-24685","spans":[{"id":"spn-28177","text":"Fields"}]}],"id":"blk-24683","kind":"table","rows":[[{"id":"blk-24686","spans":[{"id":"spn-28178","text":"Agent created"}]},{"id":"blk-24687","spans":[{"id":"spn-28179","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-24688","spans":[{"id":"spn-28180","text":"Agent disabled"}]},{"id":"blk-24689","spans":[{"id":"spn-28181","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-24690","spans":[{"id":"spn-28182","text":"Deployment created"}]},{"id":"blk-24691","spans":[{"id":"spn-28183","text":"user_id, agent_id, deployment_id, timestamp"}]}],[{"id":"blk-24692","spans":[{"id":"spn-28184","text":"Secret created/rotated"}]},{"id":"blk-24693","spans":[{"id":"spn-28185","text":"user_id, secret_key (not value), timestamp"}]}],[{"id":"blk-24694","spans":[{"id":"spn-28186","text":"Tier changed"}]},{"id":"blk-24695","spans":[{"id":"spn-28187","text":"user_id, old_tier, new_tier, timestamp"}]}],[{"id":"blk-24696","spans":[{"id":"spn-28188","text":"Invocation rejected (limit)"}]},{"id":"blk-24697","spans":[{"id":"spn-28189","text":"user_id, agent_id, reason, timestamp"}]}]]},{"id":"blk-24698","kind":"paragraph","spans":[{"id":"spn-28190","text":"Audit log entries are append-only and retained for at least 90 days regardless of tier."}]},{"id":"blk-24699","kind":"paragraph","spans":[{"id":"spn-28191","text":"---"}]},{"id":"blk-24700","kind":"heading","level":2,"spans":[{"id":"spn-28192","text":"Security Checklist"}]},{"id":"blk-24701","items":[{"blocks":[{"id":"blk-24703","kind":"paragraph","spans":[{"id":"spn-28193","text":"[ ] RLS policy exists on every table"}]}],"id":"blk-24702","kind":"list-item"},{"blocks":[{"id":"blk-24705","kind":"paragraph","spans":[{"id":"spn-28194","text":"[ ] No plaintext secrets in "},{"id":"spn-28195","marks":["code"],"text":"agents"},{"id":"spn-28196","text":", "},{"id":"spn-28197","marks":["code"],"text":"deployments"},{"id":"spn-28198","text":", or "},{"id":"spn-28199","marks":["code"],"text":"metrics_events"},{"id":"spn-28200","text":" tables"}]}],"id":"blk-24704","kind":"list-item"},{"blocks":[{"id":"blk-24707","kind":"paragraph","spans":[{"id":"spn-28201","text":"[ ] Secrets stored exclusively in Supabase Vault"}]}],"id":"blk-24706","kind":"list-item"},{"blocks":[{"id":"blk-24709","kind":"paragraph","spans":[{"id":"spn-28202","text":"[ ] Secret values never appear in logs, errors, or telemetry"}]}],"id":"blk-24708","kind":"list-item"},{"blocks":[{"id":"blk-24711","kind":"paragraph","spans":[{"id":"spn-28203","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-24710","kind":"list-item"},{"blocks":[{"id":"blk-24713","kind":"paragraph","spans":[{"id":"spn-28204","text":"[ ] Rate limiting is enforced per-user and per-agent"}]}],"id":"blk-24712","kind":"list-item"},{"blocks":[{"id":"blk-24715","kind":"paragraph","spans":[{"id":"spn-28205","text":"[ ] Uploaded bundles pass all supply chain validation checks"}]}],"id":"blk-24714","kind":"list-item"},{"blocks":[{"id":"bl