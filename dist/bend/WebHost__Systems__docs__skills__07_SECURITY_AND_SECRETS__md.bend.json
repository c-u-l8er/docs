{"bendscript":"0.1","blocks":[{"id":"blk-43681","kind":"heading","level":1,"spans":[{"id":"spn-71483","text":"07 — Security and Secrets"}]},{"blocks":[{"id":"blk-43683","kind":"paragraph","spans":[{"id":"spn-71484","marks":["bold"],"text":"Purpose:"},{"id":"spn-71485","text":" Tenant isolation via RLS, encrypted secret storage via Supabase Vault, telemetry authentication, abuse prevention, supply chain validation, and audit logging requirements."}]}],"id":"blk-43682","kind":"quote"},{"id":"blk-43684","kind":"heading","level":2,"spans":[{"id":"spn-71486","text":"Tenant Isolation (RLS)"}]},{"id":"blk-43685","kind":"paragraph","spans":[{"id":"spn-71487","text":"Every table in the control plane database enforces Row-Level Security:"}]},{"id":"blk-43686","kind":"code","language":"sql","text":"-- Example: agents table policy\nCREATE POLICY \"users can only access own agents\"\n  ON agents\n  FOR ALL\n  USING (auth.uid() = user_id)\n  WITH CHECK (auth.uid() = user_id);"},{"id":"blk-43687","kind":"heading","level":3,"spans":[{"id":"spn-71488","text":"RLS Rules"}]},{"head":[{"id":"blk-43689","spans":[{"id":"spn-71489","text":"Table"}]},{"id":"blk-43690","spans":[{"id":"spn-71490","text":"Policy"}]}],"id":"blk-43688","kind":"table","rows":[[{"id":"blk-43691","spans":[{"id":"spn-71491","marks":["code"],"text":"users"}]},{"id":"blk-43692","spans":[{"id":"spn-71492","marks":["code"],"text":"auth.uid() = id"}]}],[{"id":"blk-43693","spans":[{"id":"spn-71493","marks":["code"],"text":"agents"}]},{"id":"blk-43694","spans":[{"id":"spn-71494","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-43695","spans":[{"id":"spn-71495","marks":["code"],"text":"deployments"}]},{"id":"blk-43696","spans":[{"id":"spn-71496","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-43697","spans":[{"id":"spn-71497","marks":["code"],"text":"metrics_events"}]},{"id":"blk-43698","spans":[{"id":"spn-71498","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-43699","spans":[{"id":"spn-71499","marks":["code"],"text":"billing_usage"}]},{"id":"blk-43700","spans":[{"id":"spn-71500","marks":["code"],"text":"auth.uid() = user_id"}]}]]},{"id":"blk-43701","kind":"paragraph","spans":[{"id":"spn-71501","marks":["bold"],"text":"Hard rule:"},{"id":"spn-71502","text":" No table is accessible without an RLS policy. If a new table is added, an RLS policy must be created before any data is inserted."}]},{"id":"blk-43702","kind":"heading","level":3,"spans":[{"id":"spn-71503","text":"Provider Namespace Isolation"}]},{"id":"blk-43703","kind":"paragraph","spans":[{"id":"spn-71504","text":"Runtime provider resources are namespaced per user:"}]},{"id":"blk-43704","items":[{"blocks":[{"id":"blk-43706","kind":"paragraph","spans":[{"id":"spn-71505","text":"Cloudflare: Worker names include user ID prefix"}]}],"id":"blk-43705","kind":"list-item"},{"blocks":[{"id":"blk-43708","kind":"paragraph","spans":[{"id":"spn-71506","text":"AgentCore: Runtime resources tagged with user ID"}]}],"id":"blk-43707","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43709","kind":"heading","level":2,"spans":[{"id":"spn-71507","text":"Secrets Handling"}]},{"id":"blk-43710","kind":"heading","level":3,"spans":[{"id":"spn-71508","text":"Supabase Vault"}]},{"id":"blk-43711","kind":"paragraph","spans":[{"id":"spn-71509","text":"Secrets are stored in "},{"id":"spn-71510","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-71511","text":" -- an encrypted key-value store built into Supabase. The primary database ("},{"id":"spn-71512","marks":["code"],"text":"agents"},{"id":"spn-71513","text":", "},{"id":"spn-71514","marks":["code"],"text":"deployments"},{"id":"spn-71515","text":", etc.) never contains plaintext secret values."}]},{"id":"blk-43712","kind":"code","language":"text","text":"User adds secret \"OPENAI_API_KEY\" via dashboard\n  -> Value encrypted and stored in Vault (vault.secrets)\n  -> agents.env_var_keys = [\"OPENAI_API_KEY\"] (key name only)"},{"id":"blk-43713","kind":"heading","level":3,"spans":[{"id":"spn-71516","text":"Secret Lifecycle"}]},{"id":"blk-43714","kind":"code","language":"text","text":"1. User creates secret via UI -> stored in Vault\n2. Deploy triggers -> Edge Function reads from Vault\n3. Secret pushed to provider mechanism:\n   - Cloudflare: Workers Secrets API\n   - AgentCore: Environment variable injection / Secrets Manager\n4. Vault reference remains; plaintext never logged"},{"id":"blk-43715","kind":"heading","level":3,"spans":[{"id":"spn-71517","text":"Secret Rotation"}]},{"id":"blk-43716","items":[{"blocks":[{"id":"blk-43718","kind":"paragraph","spans":[{"id":"spn-71518","text":"User updates secret value in Vault via dashboard"}]}],"id":"blk-43717","kind":"list-item"},{"blocks":[{"id":"blk-43720","kind":"paragraph","spans":[{"id":"spn-71519","text":"User triggers a re-deploy to push the new value to the provider"}]}],"id":"blk-43719","kind":"list-item"},{"blocks":[{"id":"blk-43722","kind":"paragraph","spans":[{"id":"spn-71520","text":"Old provider secret is overwritten"}]}],"id":"blk-43721","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43723","kind":"paragraph","spans":[{"id":"spn-71521","marks":["bold"],"text":"Rule:"},{"id":"spn-71522","text":" Never log secret values. Never include secrets in error messages, telemetry events, or API responses."}]},{"id":"blk-43724","kind":"heading","level":2,"spans":[{"id":"spn-71523","text":"Telemetry Authentication"}]},{"id":"blk-43725","kind":"paragraph","spans":[{"id":"spn-71524","text":"The telemetry ingestion endpoint rejects unauthenticated events. See "},{"id":"spn-71525","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"},{"id":"spn-71526","text":" for HMAC and JWT details."}]},{"id":"blk-43726","kind":"paragraph","spans":[{"id":"spn-71527","text":"Key requirements:"}]},{"id":"blk-43727","items":[{"blocks":[{"id":"blk-43729","kind":"paragraph","spans":[{"id":"spn-71528","text":"[ ] Per-deployment signing key generated at deploy time"}]}],"id":"blk-43728","kind":"list-item"},{"blocks":[{"id":"blk-43731","kind":"paragraph","spans":[{"id":"spn-71529","text":"[ ] Signing key stored in Vault (not in the deployments table)"}]}],"id":"blk-43730","kind":"list-item"},{"blocks":[{"id":"blk-43733","kind":"paragraph","spans":[{"id":"spn-71530","text":"[ ] Anti-replay: timestamp within 5-minute window"}]}],"id":"blk-43732","kind":"list-item"},{"blocks":[{"id":"blk-43735","kind":"paragraph","spans":[{"id":"spn-71531","text":"[ ] Attribution verified against deployment records"}]}],"id":"blk-43734","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43736","kind":"heading","level":2,"spans":[{"id":"spn-71532","text":"Abuse Prevention"}]},{"id":"blk-43737","kind":"heading","level":3,"spans":[{"id":"spn-71533","text":"Rate Limiting"}]},{"head":[{"id":"blk-43739","spans":[{"id":"spn-71534","text":"Scope"}]},{"id":"blk-43740","spans":[{"id":"spn-71535","text":"Limit"}]}],"id":"blk-43738","kind":"table","rows":[[{"id":"blk-43741","spans":[{"id":"spn-71536","text":"Per-user, all agents"}]},{"id":"blk-43742","spans":[{"id":"spn-71537","text":"N requests/second (configurable)"}]}],[{"id":"blk-43743","spans":[{"id":"spn-71538","text":"Per-agent"}]},{"id":"blk-43744","spans":[{"id":"spn-71539","text":"M requests/second (configurable)"}]}],[{"id":"blk-43745","spans":[{"id":"spn-71540","text":"Payload size"}]},{"id":"blk-43746","spans":[{"id":"spn-71541","text":"Max 1 MB request body"}]}]]},{"id":"blk-43747","kind":"heading","level":3,"spans":[{"id":"spn-71542","text":"Input Validation"}]},{"id":"blk-43748","items":[{"blocks":[{"id":"blk-43750","kind":"paragraph","spans":[{"id":"spn-71543","text":"Reject oversized payloads before parsing"}]}],"id":"blk-43749","kind":"list-item"},{"blocks":[{"id":"blk-43752","kind":"paragraph","spans":[{"id":"spn-71544","text":"Validate JSON structure before processing"}]}],"id":"blk-43751","kind":"list-item"},{"blocks":[{"id":"blk-43754","kind":"paragraph","spans":[{"id":"spn-71545","text":"Prevent prompt bombing (excessively long message arrays)"}]}],"id":"blk-43753","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43755","kind":"heading","level":3,"spans":[{"id":"spn-71546","text":"Account-Level"}]},{"id":"blk-43756","items":[{"blocks":[{"id":"blk-43758","kind":"paragraph","spans":[{"id":"spn-71547","text":"Disable agent on repeated errors"}]}],"id":"blk-43757","kind":"list-item"},{"blocks":[{"id":"blk-43760","kind":"paragraph","spans":[{"id":"spn-71548","text":"Flag accounts with anomalous usage patterns"}]}],"id":"blk-43759","kind":"list-item"},{"blocks":[{"id":"blk-43762","kind":"paragraph","spans":[{"id":"spn-71549","text":"Hard-stop on plan limits (see "},{"id":"spn-71550","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"},{"id":"spn-71551","text":")"}]}],"id":"blk-43761","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43763","kind":"heading","level":2,"spans":[{"id":"spn-71552","text":"Supply Chain Validation"}]},{"id":"blk-43764","kind":"paragraph","spans":[{"id":"spn-71553","text":"Uploaded bundles must pass validation before deployment:"}]},{"head":[{"id":"blk-43766","spans":[{"id":"spn-71554","text":"Check"}]},{"id":"blk-43767","spans":[{"id":"spn-71555","text":"Rule"}]}],"id":"blk-43765","kind":"table","rows":[[{"id":"blk-43768","spans":[{"id":"spn-71556","text":"Size limit"}]},{"id":"blk-43769","spans":[{"id":"spn-71557","text":"Max compressed size (e.g., 50 MB)"}]}],[{"id":"blk-43770","spans":[{"id":"spn-71558","text":"File count"}]},{"id":"blk-43771","spans":[{"id":"spn-71559","text":"Max files (e.g., 10,000)"}]}],[{"id":"blk-43772","spans":[{"id":"spn-71560","text":"Path traversal"}]},{"id":"blk-43773","spans":[{"id":"spn-71561","text":"Reject entries with "},{"id":"spn-71562","marks":["code"],"text":"../"},{"id":"spn-71563","text":" or absolute paths"}]}],[{"id":"blk-43774","spans":[{"id":"spn-71564","text":"Symlinks"}]},{"id":"blk-43775","spans":[{"id":"spn-71565","text":"Reject unsafe symlinks"}]}],[{"id":"blk-43776","spans":[{"id":"spn-71566","text":"Required files"}]},{"id":"blk-43777","spans":[{"id":"spn-71567","marks":["code"],"text":"agent.config.json"},{"id":"spn-71568","text":" + entrypoint must exist"}]}],[{"id":"blk-43778","spans":[{"id":"spn-71569","text":"Manifest validity"}]},{"id":"blk-43779","spans":[{"id":"spn-71570","text":"JSON parses, required fields present"}]}]]},{"id":"blk-43780","kind":"paragraph","spans":[{"id":"spn-71571","text":"Post-MVP: dependency scanning for known vulnerabilities."}]},{"id":"blk-43781","kind":"heading","level":2,"spans":[{"id":"spn-71572","text":"Audit Log"}]},{"id":"blk-43782","kind":"paragraph","spans":[{"id":"spn-71573","text":"The platform SHOULD maintain an audit log for security-sensitive operations:"}]},{"head":[{"id":"blk-43784","spans":[{"id":"spn-71574","text":"Event"}]},{"id":"blk-43785","spans":[{"id":"spn-71575","text":"Fields"}]}],"id":"blk-43783","kind":"table","rows":[[{"id":"blk-43786","spans":[{"id":"spn-71576","text":"Agent created"}]},{"id":"blk-43787","spans":[{"id":"spn-71577","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-43788","spans":[{"id":"spn-71578","text":"Agent disabled"}]},{"id":"blk-43789","spans":[{"id":"spn-71579","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-43790","spans":[{"id":"spn-71580","text":"Deployment created"}]},{"id":"blk-43791","spans":[{"id":"spn-71581","text":"user_id, agent_id, deployment_id, timestamp"}]}],[{"id":"blk-43792","spans":[{"id":"spn-71582","text":"Secret created/rotated"}]},{"id":"blk-43793","spans":[{"id":"spn-71583","text":"user_id, secret_key (not value), timestamp"}]}],[{"id":"blk-43794","spans":[{"id":"spn-71584","text":"Tier changed"}]},{"id":"blk-43795","spans":[{"id":"spn-71585","text":"user_id, old_tier, new_tier, timestamp"}]}],[{"id":"blk-43796","spans":[{"id":"spn-71586","text":"Invocation rejected (limit)"}]},{"id":"blk-43797","spans":[{"id":"spn-71587","text":"user_id, agent_id, reason, timestamp"}]}]]},{"id":"blk-43798","kind":"paragraph","spans":[{"id":"spn-71588","text":"Audit log entries are append-only and retained for at least 90 days regardless of tier."}]},{"id":"blk-43799","kind":"heading","level":2,"spans":[{"id":"spn-71589","text":"Security Checklist"}]},{"id":"blk-43800","items":[{"blocks":[{"id":"blk-43802","kind":"paragraph","spans":[{"id":"spn-71590","text":"[ ] RLS policy exists on every table"}]}],"id":"blk-43801","kind":"list-item"},{"blocks":[{"id":"blk-43804","kind":"paragraph","spans":[{"id":"spn-71591","text":"[ ] No plaintext secrets in "},{"id":"spn-71592","marks":["code"],"text":"agents"},{"id":"spn-71593","text":", "},{"id":"spn-71594","marks":["code"],"text":"deployments"},{"id":"spn-71595","text":", or "},{"id":"spn-71596","marks":["code"],"text":"metrics_events"},{"id":"spn-71597","text":" tables"}]}],"id":"blk-43803","kind":"list-item"},{"blocks":[{"id":"blk-43806","kind":"paragraph","spans":[{"id":"spn-71598","text":"[ ] Secrets stored exclusively in Supabase Vault"}]}],"id":"blk-43805","kind":"list-item"},{"blocks":[{"id":"blk-43808","kind":"paragraph","spans":[{"id":"spn-71599","text":"[ ] Secret values never appear in logs, errors, or telemetry"}]}],"id":"blk-43807","kind":"list-item"},{"blocks":[{"id":"blk-43810","kind":"paragraph","spans":[{"id":"spn-71600","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-43809","kind":"list-item"},{"blocks":[{"id":"blk-43812","kind":"paragraph","spans":[{"id":"spn-71601","text":"[ ] Rate limiting is enforced per-user and per-agent"}]}],"id":"blk-43811","kind":"list-item"},{"blocks":[{"id":"blk-43814","kind":"paragraph","spans":[{"id":"spn-71602","text":"[ ] Uploaded bundles pass all supply chain validation checks"}]}],"id":"blk-43813","kind":"list-item"},{"blocks":[{"id":"blk-43816","kind":"paragraph","spans":[{"id":"spn-71603","text":"[ ] Provider resources are namespaced per user"}]}],"id":"blk-43815","kind":"list-item"},{"blocks":[{"id":"blk-43818","kind":"paragraph","spans":[{"i