{"bendscript":"0.1","blocks":[{"id":"blk-44399","kind":"heading","level":1,"spans":[{"id":"spn-73863","text":"07 — Security and Secrets"}]},{"blocks":[{"id":"blk-44401","kind":"paragraph","spans":[{"id":"spn-73864","marks":["bold"],"text":"Purpose:"},{"id":"spn-73865","text":" Tenant isolation via RLS, encrypted secret storage via Supabase Vault, telemetry authentication, abuse prevention, supply chain validation, and audit logging requirements."}]}],"id":"blk-44400","kind":"quote"},{"id":"blk-44402","kind":"heading","level":2,"spans":[{"id":"spn-73866","text":"Tenant Isolation (RLS)"}]},{"id":"blk-44403","kind":"paragraph","spans":[{"id":"spn-73867","text":"Every table in the control plane database enforces Row-Level Security:"}]},{"id":"blk-44404","kind":"code","language":"sql","text":"-- Example: agents table policy\nCREATE POLICY \"users can only access own agents\"\n  ON agents\n  FOR ALL\n  USING (auth.uid() = user_id)\n  WITH CHECK (auth.uid() = user_id);"},{"id":"blk-44405","kind":"heading","level":3,"spans":[{"id":"spn-73868","text":"RLS Rules"}]},{"head":[{"id":"blk-44407","spans":[{"id":"spn-73869","text":"Table"}]},{"id":"blk-44408","spans":[{"id":"spn-73870","text":"Policy"}]}],"id":"blk-44406","kind":"table","rows":[[{"id":"blk-44409","spans":[{"id":"spn-73871","marks":["code"],"text":"users"}]},{"id":"blk-44410","spans":[{"id":"spn-73872","marks":["code"],"text":"auth.uid() = id"}]}],[{"id":"blk-44411","spans":[{"id":"spn-73873","marks":["code"],"text":"agents"}]},{"id":"blk-44412","spans":[{"id":"spn-73874","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-44413","spans":[{"id":"spn-73875","marks":["code"],"text":"deployments"}]},{"id":"blk-44414","spans":[{"id":"spn-73876","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-44415","spans":[{"id":"spn-73877","marks":["code"],"text":"metrics_events"}]},{"id":"blk-44416","spans":[{"id":"spn-73878","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-44417","spans":[{"id":"spn-73879","marks":["code"],"text":"billing_usage"}]},{"id":"blk-44418","spans":[{"id":"spn-73880","marks":["code"],"text":"auth.uid() = user_id"}]}]]},{"id":"blk-44419","kind":"paragraph","spans":[{"id":"spn-73881","marks":["bold"],"text":"Hard rule:"},{"id":"spn-73882","text":" No table is accessible without an RLS policy. If a new table is added, an RLS policy must be created before any data is inserted."}]},{"id":"blk-44420","kind":"heading","level":3,"spans":[{"id":"spn-73883","text":"Provider Namespace Isolation"}]},{"id":"blk-44421","kind":"paragraph","spans":[{"id":"spn-73884","text":"Runtime provider resources are namespaced per user:"}]},{"id":"blk-44422","items":[{"blocks":[{"id":"blk-44424","kind":"paragraph","spans":[{"id":"spn-73885","text":"Cloudflare: Worker names include user ID prefix"}]}],"id":"blk-44423","kind":"list-item"},{"blocks":[{"id":"blk-44426","kind":"paragraph","spans":[{"id":"spn-73886","text":"AgentCore: Runtime resources tagged with user ID"}]}],"id":"blk-44425","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44427","kind":"heading","level":2,"spans":[{"id":"spn-73887","text":"Secrets Handling"}]},{"id":"blk-44428","kind":"heading","level":3,"spans":[{"id":"spn-73888","text":"Supabase Vault"}]},{"id":"blk-44429","kind":"paragraph","spans":[{"id":"spn-73889","text":"Secrets are stored in "},{"id":"spn-73890","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-73891","text":" -- an encrypted key-value store built into Supabase. The primary database ("},{"id":"spn-73892","marks":["code"],"text":"agents"},{"id":"spn-73893","text":", "},{"id":"spn-73894","marks":["code"],"text":"deployments"},{"id":"spn-73895","text":", etc.) never contains plaintext secret values."}]},{"id":"blk-44430","kind":"code","language":"text","text":"User adds secret \"OPENAI_API_KEY\" via dashboard\n  -> Value encrypted and stored in Vault (vault.secrets)\n  -> agents.env_var_keys = [\"OPENAI_API_KEY\"] (key name only)"},{"id":"blk-44431","kind":"heading","level":3,"spans":[{"id":"spn-73896","text":"Secret Lifecycle"}]},{"id":"blk-44432","kind":"code","language":"text","text":"1. User creates secret via UI -> stored in Vault\n2. Deploy triggers -> Edge Function reads from Vault\n3. Secret pushed to provider mechanism:\n   - Cloudflare: Workers Secrets API\n   - AgentCore: Environment variable injection / Secrets Manager\n4. Vault reference remains; plaintext never logged"},{"id":"blk-44433","kind":"heading","level":3,"spans":[{"id":"spn-73897","text":"Secret Rotation"}]},{"id":"blk-44434","items":[{"blocks":[{"id":"blk-44436","kind":"paragraph","spans":[{"id":"spn-73898","text":"User updates secret value in Vault via dashboard"}]}],"id":"blk-44435","kind":"list-item"},{"blocks":[{"id":"blk-44438","kind":"paragraph","spans":[{"id":"spn-73899","text":"User triggers a re-deploy to push the new value to the provider"}]}],"id":"blk-44437","kind":"list-item"},{"blocks":[{"id":"blk-44440","kind":"paragraph","spans":[{"id":"spn-73900","text":"Old provider secret is overwritten"}]}],"id":"blk-44439","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-44441","kind":"paragraph","spans":[{"id":"spn-73901","marks":["bold"],"text":"Rule:"},{"id":"spn-73902","text":" Never log secret values. Never include secrets in error messages, telemetry events, or API responses."}]},{"id":"blk-44442","kind":"heading","level":2,"spans":[{"id":"spn-73903","text":"Telemetry Authentication"}]},{"id":"blk-44443","kind":"paragraph","spans":[{"id":"spn-73904","text":"The telemetry ingestion endpoint rejects unauthenticated events. See "},{"id":"spn-73905","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"},{"id":"spn-73906","text":" for HMAC and JWT details."}]},{"id":"blk-44444","kind":"paragraph","spans":[{"id":"spn-73907","text":"Key requirements:"}]},{"id":"blk-44445","items":[{"blocks":[{"id":"blk-44447","kind":"paragraph","spans":[{"id":"spn-73908","text":"[ ] Per-deployment signing key generated at deploy time"}]}],"id":"blk-44446","kind":"list-item"},{"blocks":[{"id":"blk-44449","kind":"paragraph","spans":[{"id":"spn-73909","text":"[ ] Signing key stored in Vault (not in the deployments table)"}]}],"id":"blk-44448","kind":"list-item"},{"blocks":[{"id":"blk-44451","kind":"paragraph","spans":[{"id":"spn-73910","text":"[ ] Anti-replay: timestamp within 5-minute window"}]}],"id":"blk-44450","kind":"list-item"},{"blocks":[{"id":"blk-44453","kind":"paragraph","spans":[{"id":"spn-73911","text":"[ ] Attribution verified against deployment records"}]}],"id":"blk-44452","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44454","kind":"heading","level":2,"spans":[{"id":"spn-73912","text":"Abuse Prevention"}]},{"id":"blk-44455","kind":"heading","level":3,"spans":[{"id":"spn-73913","text":"Rate Limiting"}]},{"head":[{"id":"blk-44457","spans":[{"id":"spn-73914","text":"Scope"}]},{"id":"blk-44458","spans":[{"id":"spn-73915","text":"Limit"}]}],"id":"blk-44456","kind":"table","rows":[[{"id":"blk-44459","spans":[{"id":"spn-73916","text":"Per-user, all agents"}]},{"id":"blk-44460","spans":[{"id":"spn-73917","text":"N requests/second (configurable)"}]}],[{"id":"blk-44461","spans":[{"id":"spn-73918","text":"Per-agent"}]},{"id":"blk-44462","spans":[{"id":"spn-73919","text":"M requests/second (configurable)"}]}],[{"id":"blk-44463","spans":[{"id":"spn-73920","text":"Payload size"}]},{"id":"blk-44464","spans":[{"id":"spn-73921","text":"Max 1 MB request body"}]}]]},{"id":"blk-44465","kind":"heading","level":3,"spans":[{"id":"spn-73922","text":"Input Validation"}]},{"id":"blk-44466","items":[{"blocks":[{"id":"blk-44468","kind":"paragraph","spans":[{"id":"spn-73923","text":"Reject oversized payloads before parsing"}]}],"id":"blk-44467","kind":"list-item"},{"blocks":[{"id":"blk-44470","kind":"paragraph","spans":[{"id":"spn-73924","text":"Validate JSON structure before processing"}]}],"id":"blk-44469","kind":"list-item"},{"blocks":[{"id":"blk-44472","kind":"paragraph","spans":[{"id":"spn-73925","text":"Prevent prompt bombing (excessively long message arrays)"}]}],"id":"blk-44471","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44473","kind":"heading","level":3,"spans":[{"id":"spn-73926","text":"Account-Level"}]},{"id":"blk-44474","items":[{"blocks":[{"id":"blk-44476","kind":"paragraph","spans":[{"id":"spn-73927","text":"Disable agent on repeated errors"}]}],"id":"blk-44475","kind":"list-item"},{"blocks":[{"id":"blk-44478","kind":"paragraph","spans":[{"id":"spn-73928","text":"Flag accounts with anomalous usage patterns"}]}],"id":"blk-44477","kind":"list-item"},{"blocks":[{"id":"blk-44480","kind":"paragraph","spans":[{"id":"spn-73929","text":"Hard-stop on plan limits (see "},{"id":"spn-73930","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"},{"id":"spn-73931","text":")"}]}],"id":"blk-44479","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44481","kind":"heading","level":2,"spans":[{"id":"spn-73932","text":"Supply Chain Validation"}]},{"id":"blk-44482","kind":"paragraph","spans":[{"id":"spn-73933","text":"Uploaded bundles must pass validation before deployment:"}]},{"head":[{"id":"blk-44484","spans":[{"id":"spn-73934","text":"Check"}]},{"id":"blk-44485","spans":[{"id":"spn-73935","text":"Rule"}]}],"id":"blk-44483","kind":"table","rows":[[{"id":"blk-44486","spans":[{"id":"spn-73936","text":"Size limit"}]},{"id":"blk-44487","spans":[{"id":"spn-73937","text":"Max compressed size (e.g., 50 MB)"}]}],[{"id":"blk-44488","spans":[{"id":"spn-73938","text":"File count"}]},{"id":"blk-44489","spans":[{"id":"spn-73939","text":"Max files (e.g., 10,000)"}]}],[{"id":"blk-44490","spans":[{"id":"spn-73940","text":"Path traversal"}]},{"id":"blk-44491","spans":[{"id":"spn-73941","text":"Reject entries with "},{"id":"spn-73942","marks":["code"],"text":"../"},{"id":"spn-73943","text":" or absolute paths"}]}],[{"id":"blk-44492","spans":[{"id":"spn-73944","text":"Symlinks"}]},{"id":"blk-44493","spans":[{"id":"spn-73945","text":"Reject unsafe symlinks"}]}],[{"id":"blk-44494","spans":[{"id":"spn-73946","text":"Required files"}]},{"id":"blk-44495","spans":[{"id":"spn-73947","marks":["code"],"text":"agent.config.json"},{"id":"spn-73948","text":" + entrypoint must exist"}]}],[{"id":"blk-44496","spans":[{"id":"spn-73949","text":"Manifest validity"}]},{"id":"blk-44497","spans":[{"id":"spn-73950","text":"JSON parses, required fields present"}]}]]},{"id":"blk-44498","kind":"paragraph","spans":[{"id":"spn-73951","text":"Post-MVP: dependency scanning for known vulnerabilities."}]},{"id":"blk-44499","kind":"heading","level":2,"spans":[{"id":"spn-73952","text":"Audit Log"}]},{"id":"blk-44500","kind":"paragraph","spans":[{"id":"spn-73953","text":"The platform SHOULD maintain an audit log for security-sensitive operations:"}]},{"head":[{"id":"blk-44502","spans":[{"id":"spn-73954","text":"Event"}]},{"id":"blk-44503","spans":[{"id":"spn-73955","text":"Fields"}]}],"id":"blk-44501","kind":"table","rows":[[{"id":"blk-44504","spans":[{"id":"spn-73956","text":"Agent created"}]},{"id":"blk-44505","spans":[{"id":"spn-73957","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-44506","spans":[{"id":"spn-73958","text":"Agent disabled"}]},{"id":"blk-44507","spans":[{"id":"spn-73959","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-44508","spans":[{"id":"spn-73960","text":"Deployment created"}]},{"id":"blk-44509","spans":[{"id":"spn-73961","text":"user_id, agent_id, deployment_id, timestamp"}]}],[{"id":"blk-44510","spans":[{"id":"spn-73962","text":"Secret created/rotated"}]},{"id":"blk-44511","spans":[{"id":"spn-73963","text":"user_id, secret_key (not value), timestamp"}]}],[{"id":"blk-44512","spans":[{"id":"spn-73964","text":"Tier changed"}]},{"id":"blk-44513","spans":[{"id":"spn-73965","text":"user_id, old_tier, new_tier, timestamp"}]}],[{"id":"blk-44514","spans":[{"id":"spn-73966","text":"Invocation rejected (limit)"}]},{"id":"blk-44515","spans":[{"id":"spn-73967","text":"user_id, agent_id, reason, timestamp"}]}]]},{"id":"blk-44516","kind":"paragraph","spans":[{"id":"spn-73968","text":"Audit log entries are append-only and retained for at least 90 days regardless of tier."}]},{"id":"blk-44517","kind":"heading","level":2,"spans":[{"id":"spn-73969","text":"Security Checklist"}]},{"id":"blk-44518","items":[{"blocks":[{"id":"blk-44520","kind":"paragraph","spans":[{"id":"spn-73970","text":"[ ] RLS policy exists on every table"}]}],"id":"blk-44519","kind":"list-item"},{"blocks":[{"id":"blk-44522","kind":"paragraph","spans":[{"id":"spn-73971","text":"[ ] No plaintext secrets in "},{"id":"spn-73972","marks":["code"],"text":"agents"},{"id":"spn-73973","text":", "},{"id":"spn-73974","marks":["code"],"text":"deployments"},{"id":"spn-73975","text":", or "},{"id":"spn-73976","marks":["code"],"text":"metrics_events"},{"id":"spn-73977","text":" tables"}]}],"id":"blk-44521","kind":"list-item"},{"blocks":[{"id":"blk-44524","kind":"paragraph","spans":[{"id":"spn-73978","text":"[ ] Secrets stored exclusively in Supabase Vault"}]}],"id":"blk-44523","kind":"list-item"},{"blocks":[{"id":"blk-44526","kind":"paragraph","spans":[{"id":"spn-73979","text":"[ ] Secret values never appear in logs, errors, or telemetry"}]}],"id":"blk-44525","kind":"list-item"},{"blocks":[{"id":"blk-44528","kind":"paragraph","spans":[{"id":"spn-73980","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-44527","kind":"list-item"},{"blocks":[{"id":"blk-44530","kind":"paragraph","spans":[{"id":"spn-73981","text":"[ ] Rate limiting is enforced per-user and per-agent"}]}],"id":"blk-44529","kind":"list-item"},{"blocks":[{"id":"blk-44532","kind":"paragraph","spans":[{"id":"spn-73982","text":"[ ] Uploaded bundles pass all supply chain validation checks"}]}],"id":"blk-44531","kind":"list-item"},{"blocks":[{"id":"blk-44534","kind":"paragraph","spans":[{"id":"spn-73983","text":"[ ] Provider resources are namespaced per user"}]}],"id":"blk-44533","kind":"list-item"},{"blocks":[{"id":"blk-44536","kind":"paragraph","spans":[{"id":"spn-73984","text":"[ ] Audit log captures security-sensitive operations"}]}],"id":"blk-44535","kind":"list-item"},{"blocks":[{"id":"blk-44538","kind":"paragraph","spans":[{"id":"spn-73985","text":"[ ] New tables require an RLS policy before first use"}]}],"id":"blk-44537","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7dhi6setbpcdlebkieyjc2r75okv2mjc3hge72zeuwu63eyt6lma","vocabulary":"ampersand.docs.fs.v1"}