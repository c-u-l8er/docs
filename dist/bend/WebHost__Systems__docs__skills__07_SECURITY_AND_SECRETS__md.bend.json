{"bendscript":"0.1","blocks":[{"id":"blk-24691","kind":"heading","level":1,"spans":[{"id":"spn-28710","text":"07 — Security and Secrets"}]},{"blocks":[{"id":"blk-24693","kind":"paragraph","spans":[{"id":"spn-28711","marks":["bold"],"text":"Purpose:"},{"id":"spn-28712","text":" Tenant isolation via RLS, encrypted secret storage via Supabase Vault, telemetry authentication, abuse prevention, supply chain validation, and audit logging requirements."}]}],"id":"blk-24692","kind":"quote"},{"id":"blk-24694","kind":"paragraph","spans":[{"id":"spn-28713","text":"---"}]},{"id":"blk-24695","kind":"heading","level":2,"spans":[{"id":"spn-28714","text":"Tenant Isolation (RLS)"}]},{"id":"blk-24696","kind":"paragraph","spans":[{"id":"spn-28715","text":"Every table in the control plane database enforces Row-Level Security:"}]},{"id":"blk-24697","kind":"code","language":"sql","text":"-- Example: agents table policy\nCREATE POLICY \"users can only access own agents\"\n  ON agents\n  FOR ALL\n  USING (auth.uid() = user_id)\n  WITH CHECK (auth.uid() = user_id);"},{"id":"blk-24698","kind":"heading","level":3,"spans":[{"id":"spn-28716","text":"RLS Rules"}]},{"head":[{"id":"blk-24700","spans":[{"id":"spn-28717","text":"Table"}]},{"id":"blk-24701","spans":[{"id":"spn-28718","text":"Policy"}]}],"id":"blk-24699","kind":"table","rows":[[{"id":"blk-24702","spans":[{"id":"spn-28719","marks":["code"],"text":"users"}]},{"id":"blk-24703","spans":[{"id":"spn-28720","marks":["code"],"text":"auth.uid() = id"}]}],[{"id":"blk-24704","spans":[{"id":"spn-28721","marks":["code"],"text":"agents"}]},{"id":"blk-24705","spans":[{"id":"spn-28722","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-24706","spans":[{"id":"spn-28723","marks":["code"],"text":"deployments"}]},{"id":"blk-24707","spans":[{"id":"spn-28724","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-24708","spans":[{"id":"spn-28725","marks":["code"],"text":"metrics_events"}]},{"id":"blk-24709","spans":[{"id":"spn-28726","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-24710","spans":[{"id":"spn-28727","marks":["code"],"text":"billing_usage"}]},{"id":"blk-24711","spans":[{"id":"spn-28728","marks":["code"],"text":"auth.uid() = user_id"}]}]]},{"id":"blk-24712","kind":"paragraph","spans":[{"id":"spn-28729","marks":["bold"],"text":"Hard rule:"},{"id":"spn-28730","text":" No table is accessible without an RLS policy. If a new table is added, an RLS policy must be created before any data is inserted."}]},{"id":"blk-24713","kind":"heading","level":3,"spans":[{"id":"spn-28731","text":"Provider Namespace Isolation"}]},{"id":"blk-24714","kind":"paragraph","spans":[{"id":"spn-28732","text":"Runtime provider resources are namespaced per user:"}]},{"id":"blk-24715","items":[{"blocks":[{"id":"blk-24717","kind":"paragraph","spans":[{"id":"spn-28733","text":"Cloudflare: Worker names include user ID prefix"}]}],"id":"blk-24716","kind":"list-item"},{"blocks":[{"id":"blk-24719","kind":"paragraph","spans":[{"id":"spn-28734","text":"AgentCore: Runtime resources tagged with user ID"}]}],"id":"blk-24718","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24720","kind":"paragraph","spans":[{"id":"spn-28735","text":"---"}]},{"id":"blk-24721","kind":"heading","level":2,"spans":[{"id":"spn-28736","text":"Secrets Handling"}]},{"id":"blk-24722","kind":"heading","level":3,"spans":[{"id":"spn-28737","text":"Supabase Vault"}]},{"id":"blk-24723","kind":"paragraph","spans":[{"id":"spn-28738","text":"Secrets are stored in "},{"id":"spn-28739","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-28740","text":" -- an encrypted key-value store built into Supabase. The primary database ("},{"id":"spn-28741","marks":["code"],"text":"agents"},{"id":"spn-28742","text":", "},{"id":"spn-28743","marks":["code"],"text":"deployments"},{"id":"spn-28744","text":", etc.) never contains plaintext secret values."}]},{"id":"blk-24724","kind":"code","language":"text","text":"User adds secret \"OPENAI_API_KEY\" via dashboard\n  -> Value encrypted and stored in Vault (vault.secrets)\n  -> agents.env_var_keys = [\"OPENAI_API_KEY\"] (key name only)"},{"id":"blk-24725","kind":"heading","level":3,"spans":[{"id":"spn-28745","text":"Secret Lifecycle"}]},{"id":"blk-24726","kind":"code","language":"text","text":"1. User creates secret via UI -> stored in Vault\n2. Deploy triggers -> Edge Function reads from Vault\n3. Secret pushed to provider mechanism:\n   - Cloudflare: Workers Secrets API\n   - AgentCore: Environment variable injection / Secrets Manager\n4. Vault reference remains; plaintext never logged"},{"id":"blk-24727","kind":"heading","level":3,"spans":[{"id":"spn-28746","text":"Secret Rotation"}]},{"id":"blk-24728","kind":"paragraph","spans":[{"id":"spn-28747","text":"1. User updates secret value in Vault via dashboard 2. User triggers a re-deploy to push the new value to the provider 3. Old provider secret is overwritten"}]},{"id":"blk-24729","kind":"paragraph","spans":[{"id":"spn-28748","marks":["bold"],"text":"Rule:"},{"id":"spn-28749","text":" Never log secret values. Never include secrets in error messages, telemetry events, or API responses."}]},{"id":"blk-24730","kind":"paragraph","spans":[{"id":"spn-28750","text":"---"}]},{"id":"blk-24731","kind":"heading","level":2,"spans":[{"id":"spn-28751","text":"Telemetry Authentication"}]},{"id":"blk-24732","kind":"paragraph","spans":[{"id":"spn-28752","text":"The telemetry ingestion endpoint rejects unauthenticated events. See "},{"id":"spn-28753","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"},{"id":"spn-28754","text":" for HMAC and JWT details."}]},{"id":"blk-24733","kind":"paragraph","spans":[{"id":"spn-28755","text":"Key requirements:"}]},{"id":"blk-24734","items":[{"blocks":[{"id":"blk-24736","kind":"paragraph","spans":[{"id":"spn-28756","text":"[ ] Per-deployment signing key generated at deploy time"}]}],"id":"blk-24735","kind":"list-item"},{"blocks":[{"id":"blk-24738","kind":"paragraph","spans":[{"id":"spn-28757","text":"[ ] Signing key stored in Vault (not in the deployments table)"}]}],"id":"blk-24737","kind":"list-item"},{"blocks":[{"id":"blk-24740","kind":"paragraph","spans":[{"id":"spn-28758","text":"[ ] Anti-replay: timestamp within 5-minute window"}]}],"id":"blk-24739","kind":"list-item"},{"blocks":[{"id":"blk-24742","kind":"paragraph","spans":[{"id":"spn-28759","text":"[ ] Attribution verified against deployment records"}]}],"id":"blk-24741","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24743","kind":"paragraph","spans":[{"id":"spn-28760","text":"---"}]},{"id":"blk-24744","kind":"heading","level":2,"spans":[{"id":"spn-28761","text":"Abuse Prevention"}]},{"id":"blk-24745","kind":"heading","level":3,"spans":[{"id":"spn-28762","text":"Rate Limiting"}]},{"head":[{"id":"blk-24747","spans":[{"id":"spn-28763","text":"Scope"}]},{"id":"blk-24748","spans":[{"id":"spn-28764","text":"Limit"}]}],"id":"blk-24746","kind":"table","rows":[[{"id":"blk-24749","spans":[{"id":"spn-28765","text":"Per-user, all agents"}]},{"id":"blk-24750","spans":[{"id":"spn-28766","text":"N requests/second (configurable)"}]}],[{"id":"blk-24751","spans":[{"id":"spn-28767","text":"Per-agent"}]},{"id":"blk-24752","spans":[{"id":"spn-28768","text":"M requests/second (configurable)"}]}],[{"id":"blk-24753","spans":[{"id":"spn-28769","text":"Payload size"}]},{"id":"blk-24754","spans":[{"id":"spn-28770","text":"Max 1 MB request body"}]}]]},{"id":"blk-24755","kind":"heading","level":3,"spans":[{"id":"spn-28771","text":"Input Validation"}]},{"id":"blk-24756","items":[{"blocks":[{"id":"blk-24758","kind":"paragraph","spans":[{"id":"spn-28772","text":"Reject oversized payloads before parsing"}]}],"id":"blk-24757","kind":"list-item"},{"blocks":[{"id":"blk-24760","kind":"paragraph","spans":[{"id":"spn-28773","text":"Validate JSON structure before processing"}]}],"id":"blk-24759","kind":"list-item"},{"blocks":[{"id":"blk-24762","kind":"paragraph","spans":[{"id":"spn-28774","text":"Prevent prompt bombing (excessively long message arrays)"}]}],"id":"blk-24761","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24763","kind":"heading","level":3,"spans":[{"id":"spn-28775","text":"Account-Level"}]},{"id":"blk-24764","items":[{"blocks":[{"id":"blk-24766","kind":"paragraph","spans":[{"id":"spn-28776","text":"Disable agent on repeated errors"}]}],"id":"blk-24765","kind":"list-item"},{"blocks":[{"id":"blk-24768","kind":"paragraph","spans":[{"id":"spn-28777","text":"Flag accounts with anomalous usage patterns"}]}],"id":"blk-24767","kind":"list-item"},{"blocks":[{"id":"blk-24770","kind":"paragraph","spans":[{"id":"spn-28778","text":"Hard-stop on plan limits (see "},{"id":"spn-28779","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"},{"id":"spn-28780","text":")"}]}],"id":"blk-24769","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24771","kind":"paragraph","spans":[{"id":"spn-28781","text":"---"}]},{"id":"blk-24772","kind":"heading","level":2,"spans":[{"id":"spn-28782","text":"Supply Chain Validation"}]},{"id":"blk-24773","kind":"paragraph","spans":[{"id":"spn-28783","text":"Uploaded bundles must pass validation before deployment:"}]},{"head":[{"id":"blk-24775","spans":[{"id":"spn-28784","text":"Check"}]},{"id":"blk-24776","spans":[{"id":"spn-28785","text":"Rule"}]}],"id":"blk-24774","kind":"table","rows":[[{"id":"blk-24777","spans":[{"id":"spn-28786","text":"Size limit"}]},{"id":"blk-24778","spans":[{"id":"spn-28787","text":"Max compressed size (e.g., 50 MB)"}]}],[{"id":"blk-24779","spans":[{"id":"spn-28788","text":"File count"}]},{"id":"blk-24780","spans":[{"id":"spn-28789","text":"Max files (e.g., 10,000)"}]}],[{"id":"blk-24781","spans":[{"id":"spn-28790","text":"Path traversal"}]},{"id":"blk-24782","spans":[{"id":"spn-28791","text":"Reject entries with "},{"id":"spn-28792","marks":["code"],"text":"../"},{"id":"spn-28793","text":" or absolute paths"}]}],[{"id":"blk-24783","spans":[{"id":"spn-28794","text":"Symlinks"}]},{"id":"blk-24784","spans":[{"id":"spn-28795","text":"Reject unsafe symlinks"}]}],[{"id":"blk-24785","spans":[{"id":"spn-28796","text":"Required files"}]},{"id":"blk-24786","spans":[{"id":"spn-28797","marks":["code"],"text":"agent.config.json"},{"id":"spn-28798","text":" + entrypoint must exist"}]}],[{"id":"blk-24787","spans":[{"id":"spn-28799","text":"Manifest validity"}]},{"id":"blk-24788","spans":[{"id":"spn-28800","text":"JSON parses, required fields present"}]}]]},{"id":"blk-24789","kind":"paragraph","spans":[{"id":"spn-28801","text":"Post-MVP: dependency scanning for known vulnerabilities."}]},{"id":"blk-24790","kind":"paragraph","spans":[{"id":"spn-28802","text":"---"}]},{"id":"blk-24791","kind":"heading","level":2,"spans":[{"id":"spn-28803","text":"Audit Log"}]},{"id":"blk-24792","kind":"paragraph","spans":[{"id":"spn-28804","text":"The platform SHOULD maintain an audit log for security-sensitive operations:"}]},{"head":[{"id":"blk-24794","spans":[{"id":"spn-28805","text":"Event"}]},{"id":"blk-24795","spans":[{"id":"spn-28806","text":"Fields"}]}],"id":"blk-24793","kind":"table","rows":[[{"id":"blk-24796","spans":[{"id":"spn-28807","text":"Agent created"}]},{"id":"blk-24797","spans":[{"id":"spn-28808","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-24798","spans":[{"id":"spn-28809","text":"Agent disabled"}]},{"id":"blk-24799","spans":[{"id":"spn-28810","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-24800","spans":[{"id":"spn-28811","text":"Deployment created"}]},{"id":"blk-24801","spans":[{"id":"spn-28812","text":"user_id, agent_id, deployment_id, timestamp"}]}],[{"id":"blk-24802","spans":[{"id":"spn-28813","text":"Secret created/rotated"}]},{"id":"blk-24803","spans":[{"id":"spn-28814","text":"user_id, secret_key (not value), timestamp"}]}],[{"id":"blk-24804","spans":[{"id":"spn-28815","text":"Tier changed"}]},{"id":"blk-24805","spans":[{"id":"spn-28816","text":"user_id, old_tier, new_tier, timestamp"}]}],[{"id":"blk-24806","spans":[{"id":"spn-28817","text":"Invocation rejected (limit)"}]},{"id":"blk-24807","spans":[{"id":"spn-28818","text":"user_id, agent_id, reason, timestamp"}]}]]},{"id":"blk-24808","kind":"paragraph","spans":[{"id":"spn-28819","text":"Audit log entries are append-only and retained for at least 90 days regardless of tier."}]},{"id":"blk-24809","kind":"paragraph","spans":[{"id":"spn-28820","text":"---"}]},{"id":"blk-24810","kind":"heading","level":2,"spans":[{"id":"spn-28821","text":"Security Checklist"}]},{"id":"blk-24811","items":[{"blocks":[{"id":"blk-24813","kind":"paragraph","spans":[{"id":"spn-28822","text":"[ ] RLS policy exists on every table"}]}],"id":"blk-24812","kind":"list-item"},{"blocks":[{"id":"blk-24815","kind":"paragraph","spans":[{"id":"spn-28823","text":"[ ] No plaintext secrets in "},{"id":"spn-28824","marks":["code"],"text":"agents"},{"id":"spn-28825","text":", "},{"id":"spn-28826","marks":["code"],"text":"deployments"},{"id":"spn-28827","text":", or "},{"id":"spn-28828","marks":["code"],"text":"metrics_events"},{"id":"spn-28829","text":" tables"}]}],"id":"blk-24814","kind":"list-item"},{"blocks":[{"id":"blk-24817","kind":"paragraph","spans":[{"id":"spn-28830","text":"[ ] Secrets stored exclusively in Supabase Vault"}]}],"id":"blk-24816","kind":"list-item"},{"blocks":[{"id":"blk-24819","kind":"paragraph","spans":[{"id":"spn-28831","text":"[ ] Secret values never appear in logs, errors, or telemetry"}]}],"id":"blk-24818","kind":"list-item"},{"blocks":[{"id":"blk-24821","kind":"paragraph","spans":[{"id":"spn-28832","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-24820","kind":"list-item"},{"blocks":[{"id":"blk-24823","kind":"paragraph","spans":[{"id":"spn-28833","text":"[ ] Rate limiting is enforced per-user and per-agent"}]}],"id":"blk-24822","kind":"list-item"},{"blocks":[{"id":"blk-24825","kind":"paragraph","spans":[{"id":"spn-28834","text":"[ ] Uploaded bundles pass all supply chain validation checks"}]}],"id":"blk-24824","kind":"list-item"},{"blocks":[{"id":"bl