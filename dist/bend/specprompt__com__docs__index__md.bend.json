Kit, AWS Kiro, Cursor rules, and Next Moca ADL all use different specification formats. Teams switching tools lose context."}]},{"id":"blk-85008","kind":"paragraph","spans":[{"id":"spn-119511","text":"SpecPrompt defines the interoperable standard — a Markdown-native format that is:"}]},{"id":"blk-85009","items":[{"blocks":[{"id":"blk-85011","kind":"paragraph","spans":[{"id":"spn-119512","marks":["bold"],"text":"Markdown-native"},{"id":"spn-119513","text":" — "},{"id":"spn-119514","marks":["code"],"text":".md"},{"id":"spn-119515","text":" files, no proprietary format"}]}],"id":"blk-85010","kind":"list-item"},{"blocks":[{"id":"blk-85013","kind":"paragraph","spans":[{"id":"spn-119516","marks":["bold"],"text":"Human-first"},{"id":"spn-119517","text":" — readable by any team member, parseable by any agent"}]}],"id":"blk-85012","kind":"list-item"},{"blocks":[{"id":"blk-85015","kind":"paragraph","spans":[{"id":"spn-119518","marks":["bold"],"text":"Versioned"},{"id":"spn-119519","text":" — lives in git. Branching, diffing, merging."}]}],"id":"blk-85014","kind":"list-item"},{"blocks":[{"id":"blk-85017","kind":"paragraph","spans":[{"id":"spn-119520","marks":["bold"],"text":"Testable"},{"id":"spn-119521","text":" — acceptance criteria are machine-executable"}]}],"id":"blk-85016","kind":"list-item"},{"blocks":[{"id":"blk-85019","kind":"paragraph","spans":[{"id":"spn-119522","marks":["bold"],"text":"Composable"},{"id":"spn-119523","text":" — specs reference other specs"}]}],"id":"blk-85018","kind":"list-item"},{"blocks":[{"id":"blk-85021","kind":"paragraph","spans":[{"id":"spn-119524","marks":["bold"],"text":"Tool-agnostic"},{"id":"spn-119525","text":" — works with any SDD-compatible tool"}]}],"id":"blk-85020","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-85022","kind":"heading","level":2,"spans":[{"id":"spn-119526","text":"Documentation Map"}]},{"id":"blk-85023","kind":"paragraph","spans":[{"id":"spn-119527","marks":["bold"],"text":"Homepages"}]},{"id":"blk-8502