      # Publish to FleetPrompt registry"},{"id":"blk-107708","kind":"heading","level":3,"spans":[{"id":"spn-173655","text":"MCP Tools"}]},{"head":[{"id":"blk-107710","spans":[{"id":"spn-173656","text":"Tool"}]},{"id":"blk-107711","spans":[{"id":"spn-173657","text":"Description"}]}],"id":"blk-107709","kind":"table","rows":[[{"id":"blk-107712","spans":[{"id":"spn-173658","marks":["code"],"text":"spec_validate"}]},{"id":"blk-107713","spans":[{"id":"spn-173659","text":"Validate against format standard"}]}],[{"id":"blk-107714","spans":[{"id":"spn-173660","marks":["code"],"text":"spec_lint"}]},{"id":"blk-107715","spans":[{"id":"spn-173661","text":"Check for best practices"}]}],[{"id":"blk-107716","spans":[{"id":"spn-173662","marks":["code"],"text":"spec_generate"}]},{"id":"blk-107717","spans":[{"id":"spn-173663","text":"Generate from natural language"}]}],[{"id":"blk-107718","spans":[{"id":"spn-173664","marks":["code"],"text":"spec_test_gen"}]},{"id":"blk-107719","spans":[{"id":"spn-173665","text":"Generate test cases from acceptance criteria"}]}],[{"id":"blk-107720","spans":[{"id":"spn-173666","marks":["code"],"text":"spec_diff"}]},{"id":"blk-107721","spans":[{"id":"spn-173667","text":"Compare two spec versions"}]}],[{"id":"blk-107722","spans":[{"id":"spn-173668","marks":["code"],"text":"spec_search"}]},{"id":"blk-107723","spans":[{"id":"spn-173669","text":"Search FleetPrompt registry"}]}]]},{"id":"blk-107724","kind":"heading","level":3,"spans":[{"id":"spn-173670","text":"Reference Parsers"}]},{"id":"blk-107725","kind":"paragraph","spans":[{"id":"spn-173671","text":"Available in "},{"id":"spn-173672","marks":["bold"],"text":"Elixir"},{"id":"spn-173673","text":" and "},{"id":"spn-173674","marks":["bold"],"text":"TypeScript"},{"id":"spn-173675","text":". Formal PEG grammar included in the specification for building conformant parsers."}]},{"id":"blk-107726","kind":"heading","level":2,"spans":[{"id":"spn-173676","text":"Ecosystem Integration"}]},{"head":[{"id":"blk-107728",