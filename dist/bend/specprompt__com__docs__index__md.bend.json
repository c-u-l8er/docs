Kit, AWS Kiro, Cursor rules, and Next Moca ADL all use different specification formats. Teams switching tools lose context."}]},{"id":"blk-84054","kind":"paragraph","spans":[{"id":"spn-116750","text":"SpecPrompt defines the interoperable standard — a Markdown-native format that is:"}]},{"id":"blk-84055","items":[{"blocks":[{"id":"blk-84057","kind":"paragraph","spans":[{"id":"spn-116751","marks":["bold"],"text":"Markdown-native"},{"id":"spn-116752","text":" — "},{"id":"spn-116753","marks":["code"],"text":".md"},{"id":"spn-116754","text":" files, no proprietary format"}]}],"id":"blk-84056","kind":"list-item"},{"blocks":[{"id":"blk-84059","kind":"paragraph","spans":[{"id":"spn-116755","marks":["bold"],"text":"Human-first"},{"id":"spn-116756","text":" — readable by any team member, parseable by any agent"}]}],"id":"blk-84058","kind":"list-item"},{"blocks":[{"id":"blk-84061","kind":"paragraph","spans":[{"id":"spn-116757","marks":["bold"],"text":"Versioned"},{"id":"spn-116758","text":" — lives in git. Branching, diffing, merging."}]}],"id":"blk-84060","kind":"list-item"},{"blocks":[{"id":"blk-84063","kind":"paragraph","spans":[{"id":"spn-116759","marks":["bold"],"text":"Testable"},{"id":"spn-116760","text":" — acceptance criteria are machine-executable"}]}],"id":"blk-84062","kind":"list-item"},{"blocks":[{"id":"blk-84065","kind":"paragraph","spans":[{"id":"spn-116761","marks":["bold"],"text":"Composable"},{"id":"spn-116762","text":" — specs reference other specs"}]}],"id":"blk-84064","kind":"list-item"},{"blocks":[{"id":"blk-84067","kind":"paragraph","spans":[{"id":"spn-116763","marks":["bold"],"text":"Tool-agnostic"},{"id":"spn-116764","text":" — works with any SDD-compatible tool"}]}],"id":"blk-84066","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-84068","kind":"heading","level":2,"spans":[{"id":"spn-116765","text":"Documentation Map"}]},{"id":"blk-84069","kind":"paragraph","spans":[{"id":"spn-116766","marks":["bold"],"text":"Homepages"}]},{"id":"blk-8407