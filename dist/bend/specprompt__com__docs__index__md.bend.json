Kit, AWS Kiro, Cursor rules, and Next Moca ADL all use different specification formats. Teams switching tools lose context."}]},{"id":"blk-84180","kind":"paragraph","spans":[{"id":"spn-116898","text":"SpecPrompt defines the interoperable standard — a Markdown-native format that is:"}]},{"id":"blk-84181","items":[{"blocks":[{"id":"blk-84183","kind":"paragraph","spans":[{"id":"spn-116899","marks":["bold"],"text":"Markdown-native"},{"id":"spn-116900","text":" — "},{"id":"spn-116901","marks":["code"],"text":".md"},{"id":"spn-116902","text":" files, no proprietary format"}]}],"id":"blk-84182","kind":"list-item"},{"blocks":[{"id":"blk-84185","kind":"paragraph","spans":[{"id":"spn-116903","marks":["bold"],"text":"Human-first"},{"id":"spn-116904","text":" — readable by any team member, parseable by any agent"}]}],"id":"blk-84184","kind":"list-item"},{"blocks":[{"id":"blk-84187","kind":"paragraph","spans":[{"id":"spn-116905","marks":["bold"],"text":"Versioned"},{"id":"spn-116906","text":" — lives in git. Branching, diffing, merging."}]}],"id":"blk-84186","kind":"list-item"},{"blocks":[{"id":"blk-84189","kind":"paragraph","spans":[{"id":"spn-116907","marks":["bold"],"text":"Testable"},{"id":"spn-116908","text":" — acceptance criteria are machine-executable"}]}],"id":"blk-84188","kind":"list-item"},{"blocks":[{"id":"blk-84191","kind":"paragraph","spans":[{"id":"spn-116909","marks":["bold"],"text":"Composable"},{"id":"spn-116910","text":" — specs reference other specs"}]}],"id":"blk-84190","kind":"list-item"},{"blocks":[{"id":"blk-84193","kind":"paragraph","spans":[{"id":"spn-116911","marks":["bold"],"text":"Tool-agnostic"},{"id":"spn-116912","text":" — works with any SDD-compatible tool"}]}],"id":"blk-84192","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-84194","kind":"heading","level":2,"spans":[{"id":"spn-116913","text":"Documentation Map"}]},{"id":"blk-84195","kind":"paragraph","spans":[{"id":"spn-116914","marks":["bold"],"text":"Homepages"}]},{"id":"blk-8419