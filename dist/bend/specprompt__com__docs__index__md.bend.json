{"bendscript":"0.1","blocks":[{"id":"blk-107617","kind":"heading","level":1,"spans":[{"id":"spn-173586","text":"SpecPrompt Documentation"}]},{"blocks":[{"id":"blk-107619","kind":"paragraph","spans":[{"id":"spn-173587","marks":["bold"],"text":"Prompts are transient. Specs persist."}]}],"id":"blk-107618","kind":"quote"},{"blocks":[{"id":"blk-107621","kind":"paragraph","spans":[{"id":"spn-173588","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-173589","text":" · "},{"id":"spn-173590","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-173591","text":" · "},{"id":"spn-173592","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-173593","text":" · "},{"id":"spn-173594","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-107620","kind":"quote"},{"id":"blk-107622","kind":"paragraph","spans":[{"id":"spn-173595","text":"Welcome to the documentation hub for "},{"id":"spn-173596","marks":["bold"],"text":"SpecPrompt"},{"id":"spn-173597","text":" — an open standard and toolchain for spec-driven AI development. SpecPrompt defines a Markdown-based specification format (SPEC.md) that is both human-readable and machine-parseable, serving as the source of truth for agent behavior."}]},{"id":"blk-107623","kind":"paragraph","spans":[{"id":"spn-173598","text":"SpecPrompt is the "},{"id":"spn-173599","marks":["bold"],"text":"standards layer"},{"id":"spn-173600","text":" of the [&] Protocol ecosystem — the format that bridges agent definition with execution, testing, and deployment."}]},{"id":"blk-107624","kind":"heading","level":2,"spans":[{"id":"spn-173601","text":"Why SpecPrompt?"}]},{"id":"blk-107625","kind":"paragraph","spans":[{"id":"spn-173602","text":"Spec-Driven Development (SDD) has emerged as the industry consensus for AI-assisted development in 2026. GitHub Spec Kit, AWS Kiro, Cursor rules, and Next Moca ADL all use different specification formats. Teams switching tools lose context."}]},{"id":"blk-107626","kind":"paragraph","spans":[{"id":"spn-173603","text":"SpecPrompt defines the interoperable standard — a Markdown-native format that is:"}]},{"id":"blk-107627","items":[{"blocks":[{"id":"blk-107629","kind":"paragraph","spans":[{"id":"spn-173604","marks":["bold"],"text":"Markdown-native"},{"id":"spn-173605","text":" — "},{"id":"spn-173606","marks":["code"],"text":".md"},{"id":"spn-173607","text":" files, no proprietary format"}]}],"id":"blk-107628","kind":"list-item"},{"blocks":[{"id":"blk-107631","kind":"paragraph","spans":[{"id":"spn-173608","marks":["bold"],"text":"Human-first"},{"id":"spn-173609","text":" — readable by any team member, parseable by any agent"}]}],"id":"blk-107630","kind":"list-item"},{"blocks":[{"id":"blk-107633","kind":"paragraph","spans":[{"id":"spn-173610","marks":["bold"],"text":"Versioned"},{"id":"spn-173611","text":" — lives in git. Branching, diffing, merging."}]}],"id":"blk-107632","kind":"list-item"},{"blocks":[{"id":"blk-107635","kind":"paragraph","spans":[{"id":"spn-173612","marks":["bold"],"text":"Testable"},{"id":"spn-173613","text":" — acceptance criteria are machine-executable"}]}],"id":"blk-107634","kind":"list-item"},{"blocks":[{"id":"blk-107637","kind":"paragraph","spans":[{"id":"spn-173614","marks":["bold"],"text":"Composable"},{"id":"spn-173615","text":" — specs reference other specs"}]}],"id":"blk-107636","kind":"list-item"},{"blocks":[{"id":"blk-107639","kind":"paragraph","spans":[{"id":"spn-173616","marks":["bold"],"text":"Tool-agnostic"},{"id":"spn-173617","text":" — works with any SDD-compatible tool"}]}],"id":"blk-107638","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-107640","kind":"heading","level":2,"spans":[{"id":"spn-173618","text":"Documentation Map"}]},{"id":"blk-107641","kind":"paragraph","spans":[{"id":"spn-173619","marks":["bold"],"text":"Home