{"bendscript":"0.1","blocks":[{"id":"blk-83983","kind":"heading","level":1,"spans":[{"id":"spn-116636","text":"SpecPrompt — Open Standard for Spec-Driven AI Development"}]},{"id":"blk-83984","kind":"paragraph","spans":[{"id":"spn-116637","text":"Open standard and toolchain for spec-driven AI development. Defines a Markdown-based specification format (SPEC.md) that is human-readable and machine-parseable."}]},{"id":"blk-83985","kind":"heading","level":2,"spans":[{"id":"spn-116638","text":"Source-of-truth spec"}]},{"id":"blk-83986","items":[{"blocks":[{"id":"blk-83988","kind":"paragraph","spans":[{"id":"spn-116639","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-116640","text":" — SpecPrompt product specification"}]}],"id":"blk-83987","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83989","kind":"heading","level":2,"spans":[{"id":"spn-116641","text":"Role in [&] Ecosystem"}]},{"id":"blk-83990","kind":"paragraph","spans":[{"id":"spn-116642","text":"SpecPrompt is the "},{"id":"spn-116643","marks":["bold"],"text":"standards layer"},{"id":"spn-116644","text":":"}]},{"id":"blk-83991","kind":"code","language":"text","text":"SpecPrompt (Standards) → Agentelic (Engineering) → OpenSentience (Runtime) → Graphonomous (Memory)"},{"id":"blk-83992","kind":"paragraph","spans":[{"id":"spn-116645","text":"SpecPrompt defines the interoperable format that bridges agent definition with execution, testing, and deployment."}]},{"id":"blk-83993","kind":"heading","level":2,"spans":[{"id":"spn-116646","text":"The SPEC.md format"}]},{"id":"blk-83994","kind":"paragraph","spans":[{"id":"spn-116647","text":"Markdown files with YAML frontmatter. Required sections: Purpose, Capabilities, Constraints, Acceptance Tests. Human-readable, machine-parseable, git-versioned."}]},{"id":"blk-83995","kind":"heading","level":2,"spans":[{"id":"spn-116648","text":"Toolchain"}]},{"id":"blk-83996","items":[{"blocks":[{"id":"blk-83998","kind":"paragraph","spans":[{"id":"spn-116649","text":"CLI: validate, lint, test-gen, test-compile (--output/--approve/--status), diff, publish"}]}],"id":"blk-83997","kind":"list-item"},{"blocks":[{"id":"blk-84000","kind":"paragraph","spans":[{"id":"spn-116650","text":"MCP server: 8 tools (spec_validate, spec_lint, spec_generate, spec_test_gen, spec_test_compile, spec_test_approve, spec_diff, spec_search)"}]}],"id":"blk-83999","kind":"list-item"},{"blocks":[{"id":"blk-84002","kind":"paragraph","spans":[{"id":"spn-116651","text":"Reference parser in Elixir (TypeScript parser planned)"}]}],"id":"blk-84001","kind":"list-item"},{"blocks":[{"id":"blk-84004","kind":"paragraph","spans":[{"id":"spn-116652","text":"Formal PEG grammar for conformant parser development"}]}],"id":"blk-84003","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84005","kind":"heading","level":2,"spans":[{"id":"spn-116653","text":"Interoperability"}]},{"id":"blk-84006","items":[{"blocks":[{"id":"blk-84008","kind":"paragraph","spans":[{"id":"spn-116654","text":"Bidirectional with Next Moca ADL ("},{"id":"spn-116655","marks":["code"],"text":"lib/specprompt/interop/adl.ex"},{"id":"spn-116656","text":")"}]}],"id":"blk-84007","kind":"list-item"},{"blocks":[{"id":"blk-84010","kind":"paragraph","spans":[{"id":"spn-116657","text":"Bidirectional with ampersand.json ("},{"id":"spn-116658","marks":["code"],"text":"lib/specprompt/interop/ampersand.ex"},{"id":"spn-116659","text":")"}]}],"id":"blk-84009","kind":"list-item"},{"blocks":[{"id":"blk-84012","kind":"paragraph","spans":[{"id":"spn-116660","text":"Complementary to AGENTS.md"}]}],"id":"blk-84011","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84013","kind":"heading","level":2,"spans":[{"id":"spn-116661","text":"Build commands"}]},{"id":"blk-84014","kind":"code","language":"text","text":"# Elixir\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nmix format --check-formatted\nmix escript.build    # produces ./specprompt CLI\n\n# TypeScript parser\ncd npm && npm install && npm test"},{"id":"blk-84015","kind":"heading","level":2,"spans":[{"id":"spn-116662","text":"Status"}]},{"id":"blk-84016","kind":"paragraph","spans":[{"id":"spn-116663","text":"All 6 BUILD.md phases implemented. 93 tests (71 Elixir + 22 TypeScript), 0 failures."}]},{"id":"blk-84017","items":[{"blocks":[{"id":"blk-84019","kind":"paragraph","spans":[{"id":"spn-116664","text":"Phase 1: Parser + Validator + Linter + Differ + CLI (validate, lint, diff)"}]}],"id":"blk-84018","kind":"list-item"},{"blocks":[{"id":"blk-84021","kind":"paragraph","spans":[{"id":"spn-116665","text":"Phase 2: Test Compiler (compile prompts, approve, status) + Test Generator"}]}],"id":"blk-84020","kind":"list-item"},{"blocks":[{"id":"blk-84023","kind":"paragraph","spans":[{"id":"spn-116666","text":"Phase 3: MCP Server (all 8 tools) + Publisher (CloudEvents)"}]}],"id":"blk-84022","kind":"list-item"},{"blocks":[{"id":"blk-84025","kind":"paragraph","spans":[{"id":"spn-116667","text":"Phase 4: Supabase migration ("},{"id":"spn-116668","marks":["code"],"text":"ampersand-supabase/migrations/100_spec_schema.sql"},{"id":"spn-116669","text":", "},{"id":"spn-116670","marks":["code"],"text":"101_spec_rls.sql"},{"id":"spn-116671","text":")"}]}],"id":"blk-84024","kind":"list-item"},{"blocks":[{"id":"blk-84027","kind":"paragraph","spans":[{"id":"spn-116672","text":"Phase 5: Registry CRUD ("},{"id":"spn-116673","marks":["code"],"text":"lib/specprompt/registry.ex"},{"id":"spn-116674","text":" — Supabase client via :httpc)"}]}],"id":"blk-84026","kind":"list-item"},{"blocks":[{"id":"blk-84029","kind":"paragraph","spans":[{"id":"spn-116675","text":"Phase 6: TypeScript parser ("},{"id":"spn-116676","marks":["code"],"text":"npm/"},{"id":"spn-116677","text":" — @specprompt/parser, identical output to Elixir parser)"}]}],"id":"blk-84028","kind":"list-item"},{"blocks":[{"id":"blk-84031","kind":"paragraph","spans":[{"id":"spn-116678","text":"Interop: ampersand.json + ADL bidirectional mapping"}]}],"id":"blk-84030","kind":"