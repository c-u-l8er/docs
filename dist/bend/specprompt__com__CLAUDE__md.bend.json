{"bendscript":"0.1","blocks":[{"id":"blk-83994","kind":"heading","level":1,"spans":[{"id":"spn-116689","text":"SpecPrompt — Open Standard for Spec-Driven AI Development"}]},{"id":"blk-83995","kind":"paragraph","spans":[{"id":"spn-116690","text":"Open standard and toolchain for spec-driven AI development. Defines a Markdown-based specification format (SPEC.md) that is human-readable and machine-parseable."}]},{"id":"blk-83996","kind":"heading","level":2,"spans":[{"id":"spn-116691","text":"Source-of-truth spec"}]},{"id":"blk-83997","items":[{"blocks":[{"id":"blk-83999","kind":"paragraph","spans":[{"id":"spn-116692","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-116693","text":" — SpecPrompt product specification"}]}],"id":"blk-83998","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84000","kind":"heading","level":2,"spans":[{"id":"spn-116694","text":"Role in [&] Ecosystem"}]},{"id":"blk-84001","kind":"paragraph","spans":[{"id":"spn-116695","text":"SpecPrompt is the "},{"id":"spn-116696","marks":["bold"],"text":"standards layer"},{"id":"spn-116697","text":":"}]},{"id":"blk-84002","kind":"code","language":"text","text":"SpecPrompt (Standards) → Agentelic (Engineering) → OpenSentience (Runtime) → Graphonomous (Memory)"},{"id":"blk-84003","kind":"paragraph","spans":[{"id":"spn-116698","text":"SpecPrompt defines the interoperable format that bridges agent definition with execution, testing, and deployment."}]},{"id":"blk-84004","kind":"heading","level":2,"spans":[{"id":"spn-116699","text":"The SPEC.md format"}]},{"id":"blk-84005","kind":"paragraph","spans":[{"id":"spn-116700","text":"Markdown files with YAML frontmatter. Required sections: Purpose, Capabilities, Constraints, Acceptance Tests. Human-readable, machine-parseable, git-versioned."}]},{"id":"blk-84006","kind":"heading","level":2,"spans":[{"id":"spn-116701","text":"Toolchain"}]},{"id":"blk-84007","items":[{"blocks":[{"id":"blk-84009","kind":"paragraph","spans":[{"id":"spn-116702","text":"CLI: validate, lint, test-gen, test-compile (--output/--approve/--status), diff, publish"}]}],"id":"blk-84008","kind":"list-item"},{"blocks":[{"id":"blk-84011","kind":"paragraph","spans":[{"id":"spn-116703","text":"MCP server: 8 tools (spec_validate, spec_lint, spec_generate, spec_test_gen, spec_test_compile, spec_test_approve, spec_diff, spec_search)"}]}],"id":"blk-84010","kind":"list-item"},{"blocks":[{"id":"blk-84013","kind":"paragraph","spans":[{"id":"spn-116704","text":"Reference parser in Elixir (TypeScript parser planned)"}]}],"id":"blk-84012","kind":"list-item"},{"blocks":[{"id":"blk-84015","kind":"paragraph","spans":[{"id":"spn-116705","text":"Formal PEG grammar for conformant parser development"}]}],"id":"blk-84014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84016","kind":"heading","level":2,"spans":[{"id":"spn-116706","text":"Interoperability"}]},{"id":"blk-84017","items":[{"blocks":[{"id":"blk-84019","kind":"paragraph","spans":[{"id":"spn-116707","text":"Bidirectional with Next Moca ADL ("},{"id":"spn-116708","marks":["code"],"text":"lib/specprompt/interop/adl.ex"},{"id":"spn-116709","text":")"}]}],"id":"blk-84018","kind":"list-item"},{"blocks":[{"id":"blk-84021","kind":"paragraph","spans":[{"id":"spn-116710","text":"Bidirectional with ampersand.json ("},{"id":"spn-116711","marks":["code"],"text":"lib/specprompt/interop/ampersand.ex"},{"id":"spn-116712","text":")"}]}],"id":"blk-84020","kind":"list-item"},{"blocks":[{"id":"blk-84023","kind":"paragraph","spans":[{"id":"spn-116713","text":"Complementary to AGENTS.md"}]}],"id":"blk-84022","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84024","kind":"heading","level":2,"spans":[{"id":"spn-116714","text":"Build commands"}]},{"id":"blk-84025","kind":"code","language":"text","text":"# Elixir\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nmix format --check-formatted\nmix escript.build    # produces ./specprompt CLI\n\n# TypeScript parser\ncd npm && npm install && npm test"},{"id":"blk-84026","kind":"heading","level":2,"spans":[{"id":"spn-116715","text":"Status"}]},{"id":"blk-84027","kind":"paragraph","spans":[{"id":"spn-116716","text":"All 6 BUILD.md phases implemented. 93 tests (71 Elixir + 22 TypeScript), 0 failures."}]},{"id":"blk-84028","items":[{"blocks":[{"id":"blk-84030","kind":"paragraph","spans":[{"id":"spn-116717","text":"Phase 1: Parser + Validator + Linter + Differ + CLI (validate, lint, diff)"}]}],"id":"blk-84029","kind":"list-item"},{"blocks":[{"id":"blk-84032","kind":"paragraph","spans":[{"id":"spn-116718","text":"Phase 2: Test Compiler (compile prompts, approve, status) + Test Generator"}]}],"id":"blk-84031","kind":"list-item"},{"blocks":[{"id":"blk-84034","kind":"paragraph","spans":[{"id":"spn-116719","text":"Phase 3: MCP Server (all 8 tools) + Publisher (CloudEvents)"}]}],"id":"blk-84033","kind":"list-item"},{"blocks":[{"id":"blk-84036","kind":"paragraph","spans":[{"id":"spn-116720","text":"Phase 4: Supabase migration ("},{"id":"spn-116721","marks":["code"],"text":"ampersand-supabase/migrations/100_spec_schema.sql"},{"id":"spn-116722","text":", "},{"id":"spn-116723","marks":["code"],"text":"101_spec_rls.sql"},{"id":"spn-116724","text":")"}]}],"id":"blk-84035","kind":"list-item"},{"blocks":[{"id":"blk-84038","kind":"paragraph","spans":[{"id":"spn-116725","text":"Phase 5: Registry CRUD ("},{"id":"spn-116726","marks":["code"],"text":"lib/specprompt/registry.ex"},{"id":"spn-116727","text":" — Supabase client via :httpc)"}]}],"id":"blk-84037","kind":"list-item"},{"blocks":[{"id":"blk-84040","kind":"paragraph","spans":[{"id":"spn-116728","text":"Phase 6: TypeScript parser ("},{"id":"spn-116729","marks":["code"],"text":"npm/"},{"id":"spn-116730","text":" — @specprompt/parser, identical output to Elixir parser)"}]}],"id":"blk-84039","kind":"list-item"},{"blocks":[{"id":"blk-84042","kind":"paragraph","spans":[{"id":"spn-116731","text":"Interop: ampersand.json + ADL bidirectional mapping"}]}],"id":"blk-84041","kind":"list-item"},{"blocks":[{"id":"blk-84044","kind":"paragraph","spans":[{"id":"spn-116732","text":"Deploy: Dockerfile + fly.toml"}]}],"id":"blk-84043","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraz5glav22rji6ixto4jv6ctyhaggsoaf5w5oymr4rlpkejzsohtjq","vocabulary":"ampersand.docs.fs.v1"}