{"bendscript":"0.1","blocks":[{"id":"blk-84120","kind":"heading","level":1,"spans":[{"id":"spn-116837","text":"SpecPrompt — Open Standard for Spec-Driven AI Development"}]},{"id":"blk-84121","kind":"paragraph","spans":[{"id":"spn-116838","text":"Open standard and toolchain for spec-driven AI development. Defines a Markdown-based specification format (SPEC.md) that is human-readable and machine-parseable."}]},{"id":"blk-84122","kind":"heading","level":2,"spans":[{"id":"spn-116839","text":"Source-of-truth spec"}]},{"id":"blk-84123","items":[{"blocks":[{"id":"blk-84125","kind":"paragraph","spans":[{"id":"spn-116840","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-116841","text":" — SpecPrompt product specification"}]}],"id":"blk-84124","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84126","kind":"heading","level":2,"spans":[{"id":"spn-116842","text":"Role in [&] Ecosystem"}]},{"id":"blk-84127","kind":"paragraph","spans":[{"id":"spn-116843","text":"SpecPrompt is the "},{"id":"spn-116844","marks":["bold"],"text":"standards layer"},{"id":"spn-116845","text":":"}]},{"id":"blk-84128","kind":"code","language":"text","text":"SpecPrompt (Standards) → Agentelic (Engineering) → OpenSentience (Runtime) → Graphonomous (Memory)"},{"id":"blk-84129","kind":"paragraph","spans":[{"id":"spn-116846","text":"SpecPrompt defines the interoperable format that bridges agent definition with execution, testing, and deployment."}]},{"id":"blk-84130","kind":"heading","level":2,"spans":[{"id":"spn-116847","text":"The SPEC.md format"}]},{"id":"blk-84131","kind":"paragraph","spans":[{"id":"spn-116848","text":"Markdown files with YAML frontmatter. Required sections: Purpose, Capabilities, Constraints, Acceptance Tests. Human-readable, machine-parseable, git-versioned."}]},{"id":"blk-84132","kind":"heading","level":2,"spans":[{"id":"spn-116849","text":"Toolchain"}]},{"id":"blk-84133","items":[{"blocks":[{"id":"blk-84135","kind":"paragraph","spans":[{"id":"spn-116850","text":"CLI: validate, lint, test-gen, test-compile (--output/--approve/--status), diff, publish"}]}],"id":"blk-84134","kind":"list-item"},{"blocks":[{"id":"blk-84137","kind":"paragraph","spans":[{"id":"spn-116851","text":"MCP server: 8 tools (spec_validate, spec_lint, spec_generate, spec_test_gen, spec_test_compile, spec_test_approve, spec_diff, spec_search)"}]}],"id":"blk-84136","kind":"list-item"},{"blocks":[{"id":"blk-84139","kind":"paragraph","spans":[{"id":"spn-116852","text":"Reference parser in Elixir (TypeScript parser planned)"}]}],"id":"blk-84138","kind":"list-item"},{"blocks":[{"id":"blk-84141","kind":"paragraph","spans":[{"id":"spn-116853","text":"Formal PEG grammar for conformant parser development"}]}],"id":"blk-84140","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84142","kind":"heading","level":2,"spans":[{"id":"spn-116854","text":"Interoperability"}]},{"id":"blk-84143","items":[{"blocks":[{"id":"blk-84145","kind":"paragraph","spans":[{"id":"spn-116855","text":"Bidirectional with Next Moca ADL ("},{"id":"spn-116856","marks":["code"],"text":"lib/specprompt/interop/adl.ex"},{"id":"spn-116857","text":")"}]}],"id":"blk-84144","kind":"list-item"},{"blocks":[{"id":"blk-84147","kind":"paragraph","spans":[{"id":"spn-116858","text":"Bidirectional with ampersand.json ("},{"id":"spn-116859","marks":["code"],"text":"lib/specprompt/interop/ampersand.ex"},{"id":"spn-116860","text":")"}]}],"id":"blk-84146","kind":"list-item"},{"blocks":[{"id":"blk-84149","kind":"paragraph","spans":[{"id":"spn-116861","text":"Complementary to AGENTS.md"}]}],"id":"blk-84148","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84150","kind":"heading","level":2,"spans":[{"id":"spn-116862","text":"Build commands"}]},{"id":"blk-84151","kind":"code","language":"text","text":"# Elixir\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nmix format --check-formatted\nmix escript.build    # produces ./specprompt CLI\n\n# TypeScript parser\ncd npm && npm install && npm test"},{"id":"blk-84152","kind":"heading","level":2,"spans":[{"id":"spn-116863","text":"Status"}]},{"id":"blk-84153","kind":"paragraph","spans":[{"id":"spn-116864","text":"All 6 BUILD.md phases implemented. 93 tests (71 Elixir + 22 TypeScript), 0 failures."}]},{"id":"blk-84154","items":[{"blocks":[{"id":"blk-84156","kind":"paragraph","spans":[{"id":"spn-116865","text":"Phase 1: Parser + Validator + Linter + Differ + CLI (validate, lint, diff)"}]}],"id":"blk-84155","kind":"list-item"},{"blocks":[{"id":"blk-84158","kind":"paragraph","spans":[{"id":"spn-116866","text":"Phase 2: Test Compiler (compile prompts, approve, status) + Test Generator"}]}],"id":"blk-84157","kind":"list-item"},{"blocks":[{"id":"blk-84160","kind":"paragraph","spans":[{"id":"spn-116867","text":"Phase 3: MCP Server (all 8 tools) + Publisher (CloudEvents)"}]}],"id":"blk-84159","kind":"list-item"},{"blocks":[{"id":"blk-84162","kind":"paragraph","spans":[{"id":"spn-116868","text":"Phase 4: Supabase migration ("},{"id":"spn-116869","marks":["code"],"text":"ampersand-supabase/migrations/100_spec_schema.sql"},{"id":"spn-116870","text":", "},{"id":"spn-116871","marks":["code"],"text":"101_spec_rls.sql"},{"id":"spn-116872","text":")"}]}],"id":"blk-84161","kind":"list-item"},{"blocks":[{"id":"blk-84164","kind":"paragraph","spans":[{"id":"spn-116873","text":"Phase 5: Registry CRUD ("},{"id":"spn-116874","marks":["code"],"text":"lib/specprompt/registry.ex"},{"id":"spn-116875","text":" — Supabase client via :httpc)"}]}],"id":"blk-84163","kind":"list-item"},{"blocks":[{"id":"blk-84166","kind":"paragraph","spans":[{"id":"spn-116876","text":"Phase 6: TypeScript parser ("},{"id":"spn-116877","marks":["code"],"text":"npm/"},{"id":"spn-116878","text":" — @specprompt/parser, identical output to Elixir parser)"}]}],"id":"blk-84165","kind":"list-item"},{"blocks":[{"id":"blk-84168","kind":"paragraph","spans":[{"id":"spn-116879","text":"Interop: ampersand.json + ADL bidirectional mapping"}]}],"id":"blk-84167","kind":"list-item"},{"blocks":[{"id":"blk-84170","kind":"paragraph","spans":[{"id":"spn-116880","text":"Deploy: Dockerfile + fly.toml"}]}],"id":"blk-84169","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraao26i7ttvgmzryd6byrp4aso7rkaqvopogna47gfc4edof7s2rxq","vocabulary":"ampersand.docs.fs.v1"}