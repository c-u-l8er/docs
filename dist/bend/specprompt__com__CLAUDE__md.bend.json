{"bendscript":"0.1","blocks":[{"id":"blk-84948","kind":"heading","level":1,"spans":[{"id":"spn-119450","text":"SpecPrompt — Open Standard for Spec-Driven AI Development"}]},{"id":"blk-84949","kind":"paragraph","spans":[{"id":"spn-119451","text":"Open standard and toolchain for spec-driven AI development. Defines a Markdown-based specification format (SPEC.md) that is human-readable and machine-parseable."}]},{"id":"blk-84950","kind":"heading","level":2,"spans":[{"id":"spn-119452","text":"Source-of-truth spec"}]},{"id":"blk-84951","items":[{"blocks":[{"id":"blk-84953","kind":"paragraph","spans":[{"id":"spn-119453","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-119454","text":" — SpecPrompt product specification"}]}],"id":"blk-84952","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84954","kind":"heading","level":2,"spans":[{"id":"spn-119455","text":"Role in [&] Ecosystem"}]},{"id":"blk-84955","kind":"paragraph","spans":[{"id":"spn-119456","text":"SpecPrompt is the "},{"id":"spn-119457","marks":["bold"],"text":"standards layer"},{"id":"spn-119458","text":":"}]},{"id":"blk-84956","kind":"code","language":"text","text":"SpecPrompt (Standards) → Agentelic (Engineering) → OpenSentience (Runtime) → Graphonomous (Memory)"},{"id":"blk-84957","kind":"paragraph","spans":[{"id":"spn-119459","text":"SpecPrompt defines the interoperable format that bridges agent definition with execution, testing, and deployment."}]},{"id":"blk-84958","kind":"heading","level":2,"spans":[{"id":"spn-119460","text":"The SPEC.md format"}]},{"id":"blk-84959","kind":"paragraph","spans":[{"id":"spn-119461","text":"Markdown files with YAML frontmatter. Required sections: Purpose, Capabilities, Constraints, Acceptance Tests. Human-readable, machine-parseable, git-versioned."}]},{"id":"blk-84960","kind":"heading","level":2,"spans":[{"id":"spn-119462","text":"Toolchain"}]},{"id":"blk-84961","items":[{"blocks":[{"id":"blk-84963","kind":"paragraph","spans":[{"id":"spn-119463","text":"CLI: validate, lint, test-gen, test-compile (--output/--approve/--status), diff, publish"}]}],"id":"blk-84962","kind":"list-item"},{"blocks":[{"id":"blk-84965","kind":"paragraph","spans":[{"id":"spn-119464","text":"MCP server: 8 tools (spec_validate, spec_lint, spec_generate, spec_test_gen, spec_test_compile, spec_test_approve, spec_diff, spec_search)"}]}],"id":"blk-84964","kind":"list-item"},{"blocks":[{"id":"blk-84967","kind":"paragraph","spans":[{"id":"spn-119465","text":"Reference parser in Elixir (TypeScript parser planned)"}]}],"id":"blk-84966","kind":"list-item"},{"blocks":[{"id":"blk-84969","kind":"paragraph","spans":[{"id":"spn-119466","text":"Formal PEG grammar for conformant parser development"}]}],"id":"blk-84968","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84970","kind":"heading","level":2,"spans":[{"id":"spn-119467","text":"Interoperability"}]},{"id":"blk-84971","items":[{"blocks":[{"id":"blk-84973","kind":"paragraph","spans":[{"id":"spn-119468","text":"Bidirectional with Next Moca ADL ("},{"id":"spn-119469","marks":["code"],"text":"lib/specprompt/interop/adl.ex"},{"id":"spn-119470","text":")"}]}],"id":"blk-84972","kind":"list-item"},{"blocks":[{"id":"blk-84975","kind":"paragraph","spans":[{"id":"spn-119471","text":"Bidirectional with ampersand.json ("},{"id":"spn-119472","marks":["code"],"text":"lib/specprompt/interop/ampersand.ex"},{"id":"spn-119473","text":")"}]}],"id":"blk-84974","kind":"list-item"},{"blocks":[{"id":"blk-84977","kind":"paragraph","spans":[{"id":"spn-119474","text":"Complementary to AGENTS.md"}]}],"id":"blk-84976","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-84978","kind":"heading","level":2,"spans":[{"id":"spn-119475","text":"Build commands"}]},{"id":"blk-84979","kind":"code","language":"text","text":"# Elixir\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nmix format --check-formatted\nmix escript.build    # produces ./specprompt CLI\n\n# TypeScript parser\ncd npm && npm install && npm test"},{"id":"blk-84980","kind":"heading","level":2,"spans":[{"id":"spn-119476","text":"Status"}]},{"id":"blk-84981","kind":"paragraph","spans":[{"id":"spn-119477","text":"All 6 BUILD.md phases implemented. 93 tests (71 Elixir + 22 TypeScript), 0 failures."}]},{"id":"blk-84982","items":[{"blocks":[{"id":"blk-84984","kind":"paragraph","spans":[{"id":"spn-119478","text":"Phase 1: Parser + Validator + Linter + Differ + CLI (validate, lint, diff)"}]}],"id":"blk-84983","kind":"list-item"},{"blocks":[{"id":"blk-84986","kind":"paragraph","spans":[{"id":"spn-119479","text":"Phase 2: Test Compiler (compile prompts, approve, status) + Test Generator"}]}],"id":"blk-84985","kind":"list-item"},{"blocks":[{"id":"blk-84988","kind":"paragraph","spans":[{"id":"spn-119480","text":"Phase 3: MCP Server (all 8 tools) + Publisher (CloudEvents)"}]}],"id":"blk-84987","kind":"list-item"},{"blocks":[{"id":"blk-84990","kind":"paragraph","spans":[{"id":"spn-119481","text":"Phase 4: Supabase migration ("},{"id":"spn-119482","marks":["code"],"text":"ampersand-supabase/migrations/100_spec_schema.sql"},{"id":"spn-119483","text":", "},{"id":"spn-119484","marks":["code"],"text":"101_spec_rls.sql"},{"id":"spn-119485","text":")"}]}],"id":"blk-84989","kind":"list-item"},{"blocks":[{"id":"blk-84992","kind":"paragraph","spans":[{"id":"spn-119486","text":"Phase 5: Registry CRUD ("},{"id":"spn-119487","marks":["code"],"text":"lib/specprompt/registry.ex"},{"id":"spn-119488","text":" — Supabase client via :httpc)"}]}],"id":"blk-84991","kind":"list-item"},{"blocks":[{"id":"blk-84994","kind":"paragraph","spans":[{"id":"spn-119489","text":"Phase 6: TypeScript parser ("},{"id":"spn-119490","marks":["code"],"text":"npm/"},{"id":"spn-119491","text":" — @specprompt/parser, identical output to Elixir parser)"}]}],"id":"blk-84993","kind":"list-item"},{"blocks":[{"id":"blk-84996","kind":"paragraph","spans":[{"id":"spn-119492","text":"Interop: ampersand.json + ADL bidirectional mapping"}]}],"id":"blk-84995","kind":"list-item"},{"blocks":[{"id":"blk-84998","kind":"paragraph","spans":[{"id":"spn-119493","text":"Deploy: Dockerfile + fly.toml"}]}],"id":"blk-84997","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraeblvjidxhqkkigscvhsxwi7ccgy4nggw3c6ueuenyutldjseqgua","vocabulary":"ampersand.docs.fs.v1"}