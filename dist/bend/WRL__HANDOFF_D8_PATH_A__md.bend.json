{"bendscript":"0.1","blocks":[{"id":"blk-49564","kind":"heading","level":1,"spans":[{"id":"spn-94887","text":"Handoff — A.3 closure commit, Relation Identity Kernel 0.1.2"}]},{"id":"blk-49565","kind":"paragraph","spans":[{"id":"spn-94888","marks":["bold"],"text":"Status: all eight items of your commit ruling are landed, the battery is green at 782/782, and both pinned `sem-` ids are unmoved. Path A is ready to commit."}]},{"id":"blk-49566","kind":"paragraph","spans":[{"id":"spn-94889","text":"This memo replaces the 0.1.1 handoff. It is organised as your ruling was: one section per commit item, each stating what was wrong, what the repair is, and which check would catch a regression. Section 9 is the part that needs you — Path B, and two things I decided that I would rather you overturn now than later."}]},{"id":"blk-49567","kind":"heading","level":2,"spans":[{"id":"spn-94890","text":"The verdict first"}]},{"id":"blk-49568","kind":"code","language":"text","text":"node test/conformance.mjs\n  782 passed, 0 failed  (70 annotated doc blocks of 113 swept, 26/26 capabilities cited)"},{"id":"blk-49569","kind":"paragraph","spans":[{"id":"spn-94891","text":"Pinned ids, re-verified live in the browser after every edit:"}]},{"head":[{"id":"blk-49571","spans":[{"id":"spn-94892","text":""}]},{"id":"blk-49572","spans":[{"id":"spn-94893","text":""}]}],"id":"blk-49570","kind":"table","rows":[[{"id":"blk-49573","spans":[{"id":"spn-94894","text":"starter world"}]},{"id":"blk-49574","spans":[{"id":"spn-94895","marks":["code"],"text":"sem-67e954cfe3115166b49388366df3f062a46572ba2baf53380f1520f4050b60ae"}]}],[{"id":"blk-49575","spans":[{"id":"spn-94896","text":"pinned fixture"}]},{"id":"blk-49576","spans":[{"id":"spn-94897","marks":["code"],"text":"sem-8ae91fe9cbc5fd086ce4356d587c403211e5c7b2b3ebdd316496367429ecfe4a"}]}]]},{"id":"blk-49577","kind":"paragraph","spans":[{"id":"spn-94898","text":"Neither moved. That is not incidental to this commit — items 1, 2 and 3 all change what the adapter "},{"id":"spn-94899","marks":["italic"],"text":"produces"},{"id":"spn-94900","text":", and if any of them had leaked into the spine's preimage those two lines would be different. The suite asserts byte equality between "},{"id":"spn-94901","marks":["code"],"text":"sealWithRelations"},{"id":"spn-94902","text":" and "},{"id":"spn-94903","marks":["code"],"text":"sealWorld"},{"id":"spn-94904","text":" for both fixtures before it runs anything else, so a leak fails loudly and first."}]},{"id":"blk-49578","kind":"paragraph","spans":[{"id":"spn-94905","marks":["code"],"text":"rev-"},{"id":"spn-94906","text":" ids "},{"id":"spn-94907","marks":["bold"],"text":"did"},{"id":"spn-94908","text":" move, as expected and as designed: a revision now carries "},{"id":"spn-94909","marks":["code"],"text":"domain: \"signal\""},{"id":"spn-94910","text":" and "},{"id":"spn-94911","marks":["code"],"text":"texture: \"solid\""},{"id":"spn-94912","text":" where it previously carried "},{"id":"spn-94913","marks":["code"],"text":"domain: \"forge.world.core.v1\""},{"id":"spn-94914","text":" and no texture key. "},{"id":"spn-94915","marks":["code"],"text":"rev-"},{"id":"spn-94916","text":" is unpinned and world-independent by §D8.3; nothing published depends on its value."}]},{"id":"blk-49579","kind":"heading","level":2,"spans":[{"id":"spn-94917","text":"1. "},{"id":"spn-94918","marks":["code"],"text":"domain = signal"}]},{"id":"blk-49580","kind":"paragraph","spans":[{"id":"spn-94919","marks":["bold"],"text":"Was."},{"id":"spn-94920","text":" "},{"id":"spn-94921","marks":["code"],"text":"edgeToRelationRevision"},{"id":"spn-94922","text":" wrote "},{"id":"spn-94923","marks":["code"],"text":"artifact.profile_id"},{"id":"spn-94924","text":" — the string "},{"id":"spn-94925","marks":["code"],"text":"forge.world.core.v1"},{"id":"spn-94926","text":" — into the "},{"id":"spn-94927","marks":["code"],"text":"domain"},{"id":"spn-94928","text":" slot."}]},{"id":"blk-49581","kind":"paragraph","spans":[{"id":"spn-94929","marks":["bold"],"text":"Why it is wrong."},{"id":"spn-94930","text":" §D8's field table says a domain is a "},{"id":"spn-94931","marks":["italic"],"text":"profile-declared namespace"},{"id":"spn-94932","text":": "},{"id":"spn-94933","marks":["code"],"text":"signal"},{"id":"spn-94934","text":", "},{"id":"spn-94935","marks":["code"],"text":"digital"},{"id":"spn-94936","text":", "},{"id":"spn-94937","marks":["code"],"text":"mobility"},{"id":"spn-94938","text":", "},{"id":"spn-94939","marks":["code"],"text":"electrical"},{"id":"spn-94940","text":". A profile "},{"id":"spn-94941","marks":["bold"],"text":"declares"},{"id":"spn-94942","text":" domains; it is not one. And §D8.8's own recovery table already fixed the value for the frozen route at "},{"id":"spn-94943","marks":["code"],"text":"domain = signal"},{"id":"spn-94944","text":" — so the adapter was contradicting a normative table sitting 300 lines away in the same document."}]},{"id":"blk-49582","kind":"paragraph","spans":[{"id":"spn-94945","marks":["bold"],"text":"Repair."},{"id":"spn-94946","text":" A declared map, not an expression:"}]},{"id":"blk-49583","kind":"code","language":"js","text":"export const PROFILE_DEFAULT_DOMAIN = deepFreeze({ \"forge.world.core.v1\": \"signal\" });\nexport function profileDefaultDomain(profileId)   // → WRL_UNKNOWN_PROFILE_DOMAIN"},{"id":"blk-49584","kind":"paragraph","spans":[{"id":"spn-94947","text":"An unknown profile is refused rather than defaulted, because defaulting is how the original defect would come back."}]},{"id":"blk-49585","kind":"paragraph","spans":[{"id":"spn-94948","marks":["bold"],"text":"Consequence I did not expect, and want you to look at."},{"id":"spn-94949","text":" "},{"id":"spn-94950","marks":["code"],"text":"domain"},{"id":"spn-94951","text":" moved out of the "},{"id":"spn-94952","marks":["bold"],"text":"free"},{"id":"spn-94953","text":" row of the field partition and into "},{"id":"spn-94954","marks":["bold"],"text":"no V1 form"},{"id":"spn-94955","text":". It had been filed free on the reasoning \"a V1 edge writes no domain, so changing one cannot disturb the id\" — true, and irrelevant. A V1 edge writes no domain because it is "},{"id":"spn-94956","marks":["italic"],"text":"entirely"},{"id":"spn-94957","text":" a signal-domain encoding; its two kinds are the two kinds of that one domain. An "},{"id":"spn-94958","marks":["code"],"text":"electrical"},{"id":"spn-94959","text":" relation is therefore not a relation whose domain V1 forgets to mention, it is one V1 "},{"id":"spn-94960","marks":["bold"],"text":"cannot represent"},{"id":"spn-94961","text":" — exactly like an "},{"id":"spn-94962","marks":["code"],"text":"acausal"},{"id":"spn-94963","text":" one. So the projection now refuses it, and the partition reads:"}]},{"head":[{"id":"blk-49587","spans":[{"id":"spn-94964","text":""}]},{"id":"blk-49588","spans":[{"id":"spn-94965","text":"fields"}]},{"id":"blk-49589","spans":[{"id":"spn-94966","text":""}]}],"id":"blk-49586","kind":"table","rows":[[{"id":"blk-49590","spans":[{"id":"spn-94967","text":"names it"}]},{"id":"blk-49591","spans":[{"id":"spn-94968","marks":["code"],"text":"kind"},{"id":"spn-94969","text":", "},{"id":"spn-94970","marks":["code"],"text":"endpoints"}]},{"id":"blk-49592","spans":[{"id":"spn-94971","text":"2"}]}],[{"id":"blk-49593","spans":[{"id":"spn-94972","text":"free"}]},{"id":"blk-49594","spans":[{"id":"spn-94973","marks":["code"],"text":"policy"}]},{"id":"blk-49595","spans":[{"id":"spn-94974","text":"1"}]}],[{"id":"blk-49596","spans":[{"id":"spn-94975","text":"no V1 form"}]},{"id":"blk-49597","spans":[{"id":"spn-94976","marks":["code"],"text":"domain"},{"id":"spn-94977","text":", "},{"id":"spn-94978","marks":["code"],"text":"orientation"},{"id":"spn-94979","text":", "},{"id":"spn-94980","marks":["code"],"text":"texture"},{"id":"spn-94981","text":", "},{"id":"spn-94982","marks":["code"],"text":"attributes"}]},{"id":"blk-49598","spans":[{"id":"spn-94983","text":"4"}]}]]},{"id":"blk-49599","kind":"paragraph","spans":[{"id":"spn-94984","text":"Four of seven, not three. The spec's numeric claim was updated to match."}]},{"id":"blk-49600","kind":"paragraph","spans":[{"id":"spn-94985","marks":["bold"],"text":"Checks."},{"id":"spn-94986","text":" "},{"id":"spn-94987","marks":["code"],"text":"relation/only-the-key-names-the-relation"},{"id":"spn-94988","text":" (partition, mutating each field in turn and classifying the result), "},{"id":"spn-94989","marks":["code"],"text":"relation/revision-field-partition-is-total"},{"id":"spn-94990","text":" (the partition covers "},{"id":"spn-94991","marks":["code"],"text":"REVISION_FIELDS"},{"id":"spn-94992","text":" exactly), "},{"id":"spn-94993","marks":["code"],"text":"relation/the-import-supplies-only-declared-constants"},{"id":"spn-94994","text":" (asserts the resolved domain is "},{"id":"spn-94995","marks":["italic"],"text":"not"},{"id":"spn-94996","text":" the profile id — the specific defect, named)."}]},{"id":"blk-49601","kind":"heading","level":2,"spans":[{"id":"spn-94997","text":"2. "},{"id":"spn-94998","marks":["code"],"text":"texture = solid"},{"id":"spn-94999","text":", and directed-texture enforcement"}]},{"id":"blk-49602","kind":"paragraph","spans":[{"id":"spn-95000","text":"You rejected my decision #1 with \"V1 semantically implies "},{"id":"spn-95001","marks":["code"],"text":"solid"},{"id":"spn-95002","text":"; restore and enforce it.\" Implemented, and you were right for a reason I had not seen."}]},{"id":"blk-49603","kind":"paragraph","spans":[{"id":"spn-95003","marks":["bold"],"text":"Was."},{"id":"spn-95004","text":" The adapter emitted no "},{"id":"spn-95005","marks":["code"],"text":"texture"},{"id":"spn-95006","text":" key. My argument: a missing key and a "},{"id":"spn-95007","marks":["code"],"text":"texture: null"},{"id":"spn-95008","text":" are different claims, and no V1 world ever "},{"id":"spn-95009","marks":["italic"],"text":"considered"},{"id":"spn-95010","text":" texture, so inventing one would put an authored-looking value in an artifact that never carried it."}]},{"id":"blk-49604","kind":"paragraph","spans":[{"id":"spn-95011","marks":["bold"],"text":"Why it is wrong."},{"id":"spn-95012","text":" That argument answers "},{"id":"spn-95013","marks":["italic"],"text":"may the adapter invent a value?"},{"id":"spn-95014","text":" when the question is "},{"id":"spn-95015","marks":["italic"],"text":"what does this encoding mean?"},{"id":"spn-95016","text":" §5 gives V1 exactly one writable texture, "},{"id":"spn-95017","marks":["code"],"text":"--"},{"id":"spn-95018","text":" solid. So a V1 structural edge does not "},{"id":"spn-95019","marks":["bold"],"text":"omit"},{"id":"spn-95020","text":" a texture, it "},{"id":"spn-95021","marks":["bold"],"text":"elides"},{"id":"spn-95022","text":" one — the same relationship the artifact has to "},{"id":"spn-95023","marks":["code"],"text":"orientation"},{"id":"spn-95024","text":", which the adapter had been restoring all along without anyone calling it authorship. The test is whether the omitted value is "},{"id":"spn-95025","marks":["italic"],"text":"determined"},{"id":"spn-95026","text":", not whether the bytes contain it."}]},{"id":"blk-49605","kind":"paragraph","spans":[{"id":"spn-95027","marks":["bold"],"text":"What the mistake actually cost"},{"id":"spn-95028","text":", which is the part I think is worth keeping on the page: it made "},{"id":"spn-95029","marks":["italic"],"text":"texture required for directed"},{"id":"spn-95030","text":" — a rule §D8.7 "},{"id":"spn-95031","marks":["bold"],"text":"states"},{"id":"spn-95032","text":" — unenforceable, because the kernel's own relations violated it. So the rule got filed as a V2 obligation, and §D8's texture row shipped as one enforced half and one commented half. A table with a commented row has stopped being a table."}]},{"id":"blk-49606","kind":"paragraph","spans":[{"id":"spn-95033","marks":["bold"],"text":"Repair."},{"id":"spn-95034","text":" Both halves now come off one declaration:"}]},{"id":"blk-49607","kind":"code","language":"js","text":"export const ORIENTATION_TEXTURE = deepFreeze({\n  directed: \"required\", symmetric: \"optional\", acausal: \"forbidden\",\n});\nexport const TEXTURES   = deepFreeze([\"solid\", \"async\", \"verified\", \"fault\"]);\nexport const V1_TEXTURE = \"solid\";"},{"id":"blk-49608","kind":"paragraph","spans":[{"id":"spn-95035","marks":["code"],"text":"WRL_MISSING_TEXTURE"},{"id":"spn-95036","text":" is new. "},{"id":"spn-95037","marks":["code"],"text":"projectRelationRevisionToV1Edge"},{"id":"spn-95038","text":" now "},{"id":"spn-95039","marks":["italic"],"text":"elides"},{"id":"spn-95040","text":" a solid texture on the way out and refuses any other — where the 0.1.1 rule was the opposite, "},{"id":"spn-95041","marks":["italic"],"text":"refuse any texture"},{"id":"spn-95042","text":", which round-tripped only because the adapter had never restored one."}]},{"id":"blk-49609","kind":"paragraph","spans":[{"id":"spn-95043","marks":["bold"],"text":"Checks."},{"id":"spn-95044","text":" "},{"id":"spn-95045","marks":["code"],"text":"relation/directed-carries-a-texture"},{"id":"spn-95046","text":" (missing → "},{"id":"spn-95047","marks":["code"],"text":"WRL_MISSING_TEXTURE"},{"id":"spn-95048","text":", and the well-formed one still accepted — both halves, so a validator that refused everything would not pass), "},{"id":"spn-95049","marks":["code"],"text":"relation/acausal-carries-no-texture"},{"id":"spn-95050","text":", "},{"id":"spn-95051","marks":["code"],"text":"relation/texture-vocabulary-is-the-specs"},{"id":"spn-95052","text":" (asserts §5's "},{"id":"spn-95053","marks":["bold"],"text":"four"},{"id":"spn-95054","text":" and that V1 writes one of them; narrowing the model's enumeration to what the surface can write would delete three guarantee classes while every other texture check still passed)."}]},{"id":"blk-49610","kind":"paragraph","spans":[{"id":"spn-95055","marks":["bold"],"text":"Test-authoring note."},{"id":"spn-95056","text":" Two acausal specimens were silently testing the wrong rule after this change: they spread a directed "},{"id":"spn-95057","marks":["code"],"text":"base"},{"id":"spn-95058","text":" that now carries "},{"id":"spn-95059","marks":["code"],"text":"solid"},{"id":"spn-95060","text":", so they failed on "},{"id":"spn-95061","marks":["code"],"text":"WRL_ACAUSAL_TEXTURE"},{"id":"spn-95062","text":" under names like "},{"id":"spn-95063","marks":["code"],"text":"relation/canonical-order-is-role-then-terminal"},{"id":"spn-95064","text":". The specimen builder now drops an inherited texture for acausal unless the check is deliberately supplying one. And "},{"id":"spn-95065","marks":["code"],"text":"relation/acausal-carries-no-texture"},{"id":"spn-95066","text":" now supplies a "},{"id":"spn-95067","marks":["bold"],"text":"legal"},{"id":"spn-95068","text":" texture, because an invented one ("},{"id":"spn-95069","marks":["code"],"text":"\"braided\""},{"id":"spn-95070","text":") is refused by the vocabulary first and leaves the orientation rule untested. Same class of error as the \"a law about a seam must parse, not grep\" rule."}]},{"id":"blk-49611","kind":"heading","level":2,"spans":[{"id":"spn-95071","text":"3. Semantic-ID / artifact binding"}]},{"id":"blk-49612","kind":"paragraph","spans":[{"id":"spn-95072","marks":["bold"],"text":"Was."},{"id":"spn-95073","text":" "},{"id":"spn-95074","marks":["code"],"text":"deriveRelations(artifact, semanticId)"},{"id":"spn-95075","text":" took the world id as an argument and trusted it. Callers passed the one "},{"id":"spn-95076","marks":["code"],"text":"sealWorld"},{"id":"spn-95077","text":" had just returned, so it was always right, and it was checked by nothing."}]},{"id":"blk-49613","kind":"paragraph","spans":[{"id":"spn-95078","marks":["bold"],"text":"Why it is wrong."},{"id":"spn-95079","text":" You demonstrated it: an artifact handed over with "},{"id":"spn-95080","marks":["code"],"text":"sem-000…0"},{"id":"spn-95081","text":" beside it minted a complete, well-formed set of relation ids scoped to a world that does not exist. A world-scoped identity is only as scoped as the world id it is scoped "},{"id":"spn-95082","marks":["italic"],"text":"to"},{"id":"spn-95083","text":", and a value whose meaning depends on an unverified claim travelling next to it has no meaning. The failure is silent — every id well-formed, every round trip green."}]},{"id":"blk-49614","kind":"paragraph","spans":[{"id":"spn-95084","marks":["bold"],"text":"Repair."},{"id":"spn-95085","text":" The id is "},{"id":"spn-95086","marks":["bold"],"text":"recomputed"},{"id":"spn-95087","text":" from the artifact's own canonical bytes inside "},{"id":"spn-95088","marks":["code"],"text":"deriveRelations"},{"id":"spn-95089","text":"; a supplied "},{"id":"spn-95090","marks":["code"],"text":"sem-"},{"id":"spn-95091","text":" becomes a cross-check refused on mismatch ("},{"id":"spn-95092","marks":["code"],"text":"WRL_SEMANTIC_ID_MISMATCH"},{"id":"spn-95093","text":"). The recomputed path is the "},{"id":"spn-95094","marks":["italic"],"text":"only"},{"id":"spn-95095","text":" path — there is no faster one to fall back to. "},{"id":"spn-95096","marks":["code"],"text":"deriveLegacyEdgeCorrespondence"},{"id":"spn-95097","text":" routes both of its sides through the same checked boundary, so a sealed-looking record carrying a forged id is refused there too rather than only in the single-world path."}]},{"id":"blk-49615","kind":"paragraph","spans":[{"id":"spn-95098","marks":["bold"],"text":"Checks."},{"id":"spn-95099","text":" "},{"id":"spn-95100","marks":["code"],"text":"relation/binding/a-forged-world-id-is-refused"},{"id":"spn-95101","text":", "},{"id":"spn-95102","marks":["code"],"text":"relation/binding/the-world-id-is-recomputed-not-supplied"},{"id":"spn-95103","text":" (running with "},{"id":"spn-95104","marks":["bold"],"text":"no"},{"id":"spn-95105","text":" claim gives the same ids — so the two paths cannot disagree and there is no unchecked way in)."}]},{"id":"blk-49616","kind":"heading","level":2,"spans":[{"id":"spn-95106","text":"4. Explicit V1 source-version validation"}]},{"id":"blk-49617","kind":"paragraph","spans":[{"id":"spn-95107","text":"The adapter's constants — "},{"id":"spn-95108","marks":["code"],"text":"directed"},{"id":"spn-95109","text":", "},{"id":"spn-95110","marks":["code"],"text":"solid"},{"id":"spn-95111","text":", "},{"id":"spn-95112","marks":["code"],"text":"signal"},{"id":"spn-95113","text":", the frozen port pairs — are V1's elisions. Applied to an artifact of a later version whose elisions differ, they would not fail; they would produce confident, wrong relations."}]},{"id":"blk-49618","kind":"code","language":"js","text":"export const V1_IR_VERSIONS = deepFreeze([\"1.0\", \"1.1\"]);\nexport function assertV1Artifact(artifact)   // → WRL_UNSUPPORTED_IR_VERSION"},{"id":"blk-49619","kind":"paragraph","spans":[{"id":"spn-95114","text":"Called before any edge is read, on both the single-world and the correspondence paths."}]},{"id":"blk-49620","kind":"paragraph","spans":[{"id":"spn-95115","marks":["bold"],"text":"Check."},{"id":"spn-95116","text":" "},{"id":"spn-95117","marks":["code"],"text":"relation/binding/an-unknown-ir-version-is-refused"},{"id":"spn-95118","text":"."}]},{"id":"blk-49621","kind":"paragraph","spans":[{"id":"spn-95119","marks":["bold"],"text":"Flagged:"},{"id":"spn-95120","text":" I admitted "},{"id":"spn-95121","marks":["code"],"text":"\"1.1\""},{"id":"spn-95122","text":" alongside "},{"id":"spn-95123","marks":["code"],"text":"\"1.0\""},{"id":"spn-95124","text":" because the frozen corpus contains both and the elisions are identical across them. If you consider that too permissive — i.e. that the adapter should be pinned to exactly the versions whose elisions it has been "},{"id":"spn-95125","marks":["italic"],"text":"tested"},{"id":"spn-95126","text":" against — say so and I will narrow it."}]},{"id":"blk-49622","kind":"heading","level":2,"spans":[{"id":"spn-95127","text":"5. Deep-frozen identity tables"}]},{"id":"blk-49623","kind":"paragraph","spans":[{"id":"spn-95128","marks":["bold"],"text":"Was."},{"id":"spn-95129","text":" Every exported vocabulary was an ordinary array or object."}]},{"id":"blk-49624","kind":"paragraph","spans":[{"id":"spn-95130","marks":["bold"],"text":"Why it is wrong."},{"id":"spn-95131","text":" You reversed "},{"id":"spn-95132","marks":["code"],"text":"ENDPOINT_ROLES"},{"id":"spn-95133","text":" and widened "},{"id":"spn-95134","marks":["code"],"text":"ORIENTATION_ROLES"},{"id":"spn-95135","text":" after import, and canonicalisation obligingly produced a different id for the same relation and admitted roles §D8 forbids. The role enumeration is not merely a list — it is the "},{"id":"spn-95136","marks":["bold"],"text":"sort key"},{"id":"spn-95137","text":" of the canonical form. A closed enumeration a consumer can reopen is an open enumeration with a comment attached."}]},{"id":"blk-49625","kind":"paragraph","spans":[{"id":"spn-95138","marks":["bold"],"text":"Repair."},{"id":"spn-95139","text":" A recursive "},{"id":"spn-95140","marks":["code"],"text":"deepFreeze"},{"id":"spn-95141","text":" applied to every exported table: "},{"id":"spn-95142","marks":["code"],"text":"ENDPOINT_ROLES"},{"id":"spn-95143","text":", "},{"id":"spn-95144","marks":["code"],"text":"ORIENTATIONS"},{"id":"spn-95145","text":", "},{"id":"spn-95146","marks":["code"],"text":"TEXTURES"},{"id":"spn-95147","text":", "},{"id":"spn-95148","marks":["code"],"text":"ORIENTATION_ROLES"},{"id":"spn-95149","text":", "},{"id":"spn-95150","marks":["code"],"text":"ORIENTATION_TEXTURE"},{"id":"spn-95151","text":", "},{"id":"spn-95152","marks":["code"],"text":"ALLOCATION_FIELDS"},{"id":"spn-95153","text":", "},{"id":"spn-95154","marks":["code"],"text":"PROFILE_DEFAULT_DOMAIN"},{"id":"spn-95155","text":", "},{"id":"spn-95156","marks":["code"],"text":"V1_IR_VERSIONS"},{"id":"spn-95157","text":", "},{"id":"spn-95158","marks":["code"],"text":"RELATION_IMPORTED_FIELDS"},{"id":"spn-95159","text":", "},{"id":"spn-95160","marks":["code"],"text":"REVISION_FIELDS"},{"id":"spn-95161","text":"."}]},{"id":"blk-49626","kind":"paragraph","spans":[{"id":"spn-95162","marks":["bold"],"text":"Check."},{"id":"spn-95163","text":" "},{"id":"spn-95164","marks":["code"],"text":"relation/immutability/the-canon-cannot-be-moved-from-outside"},{"id":"spn-95165","text":" — tampers with all of them, then re-asserts canonical order "},{"id":"spn-95166","marks":["italic"],"text":"and"},{"id":"spn-95167","text":" role legality. It checks the consequence, not the "},{"id":"spn-95168","marks":["code"],"text":"Object.isFrozen"},{"id":"spn-95169","text":" flag."}]},{"id":"blk-49627","kind":"heading","level":2,"spans":[{"id":"spn-95170","text":"6. Correspondence separated from "},{"id":"spn-95171","marks":["code"],"text":"RelationImported"}]},{"id":"blk-49628","kind":"paragraph","spans":[{"id":"spn-95172","text":"This is the item I think was most valuable, and I want to state the general rule rather than just the fix."}]},{"id":"blk-49629","kind":"paragraph","spans":[{"id":"spn-95173","marks":["bold"],"text":"Was."},{"id":"spn-95174","text":" "},{"id":"spn-95175","marks":["code"],"text":"deriveCorrespondence"},{"id":"spn-95176","text":" returned a field called "},{"id":"spn-95177","marks":["code"],"text":"imported"},{"id":"spn-95178","text":", whose entries had the four fields of a "},{"id":"spn-95179","marks":["code"],"text":"RelationImported"},{"id":"spn-95180","text":"."}]},{"id":"blk-49630","kind":"paragraph","spans":[{"id":"spn-95181","marks":["bold"],"text":"Why it is wrong."},{"id":"spn-95182","text":" The arithmetic was fine. What was wrong is that a "},{"id":"spn-95183","marks":["italic"],"text":"derivation"},{"id":"spn-95184","text":" produced a record whose entire content is "},{"id":"spn-95185","marks":["italic"],"text":"an operation was accepted"},{"id":"spn-95186","text":" — from two artifacts, which know nothing about operations. Read strictly it says two worlds are related by a migration because they contain matching edge keys, so two unrelated worlds built from the same starter template would be full of imports nobody performed."}]},{"id":"blk-49631","kind":"paragraph","spans":[{"id":"spn-95187","marks":["bold"],"text":"Repair."},{"id":"spn-95188","text":" Three functions where there was one:"}]},{"id":"blk-49632","kind":"code","language":"js","text":"deriveLegacyEdgeCorrespondence(from, to)  // structural, derived: { pairs, dropped, added }\ncandidateImportedFacts(correspondence)    // what a fact would have to be backed by\ncheckRelationImported(facts, corr)        // the join → WRL_UNVERIFIED_IMPORT"},{"id":"blk-49633","kind":"paragraph","spans":[{"id":"spn-95189","marks":["bold"],"text":"The rule underneath it."},{"id":"spn-95190","text":" Derived values do not need checking against their own inputs; "},{"id":"spn-95191","marks":["bold"],"text":"asserted"},{"id":"spn-95192","text":" ones do. "},{"id":"spn-95193","marks":["code"],"text":"RelationImported"},{"id":"spn-95194","text":" is emitted by an accepted migration operation, which makes it — uniquely in this kernel — a thing that can be "},{"id":"spn-95195","marks":["italic"],"text":"maintained wrongly"},{"id":"spn-95196","text":", which is exactly why it is the one thing joined against something derived. Merging the two loses the only join that could catch a wrong assertion, and loses it by making the assertion "},{"id":"spn-95197","marks":["bold"],"text":"unfalsifiable"},{"id":"spn-95198","text":" rather than by making it false."}]},{"id":"blk-49634","kind":"paragraph","spans":[{"id":"spn-95199","marks":["bold"],"text":"Checks."},{"id":"spn-95200","text":" "},{"id":"spn-95201","marks":["code"],"text":"relation/migration/a-pairing-is-not-an-import-fact"},{"id":"spn-95202","text":" (asserts "},{"id":"spn-95203","marks":["code"],"text":"deriveCorrespondence"},{"id":"spn-95204","text":" is "},{"id":"spn-95205","marks":["italic"],"text":"gone"},{"id":"spn-95206","text":", that no "},{"id":"spn-95207","marks":["code"],"text":"imported"},{"id":"spn-95208","text":" key exists, and that a pair entry's keys are exactly "},{"id":"spn-95209","marks":["code"],"text":"key"},{"id":"spn-95210","text":"/"},{"id":"spn-95211","marks":["code"],"text":"from_relation"},{"id":"spn-95212","text":"/"},{"id":"spn-95213","marks":["code"],"text":"to_relation"},{"id":"spn-95214","text":"), "},{"id":"spn-95215","marks":["code"],"text":"relation/migration/an-unbacked-import-fact-is-refused"},{"id":"spn-95216","text":", "},{"id":"spn-95217","marks":["code"],"text":"relation/migration/the-fact-has-exactly-four-fields"},{"id":"spn-95218","text":"."}]},{"id":"blk-49635","kind":"paragraph","spans":[{"id":"spn-95219","marks":["code"],"text":"playground.html"},{"id":"spn-95220","text":" was updated to the new API and re-verified live — it renders "},{"id":"spn-95221","marks":["code"],"text":"3 paired · 1 dropped · 0 added"},{"id":"spn-95222","text":" against the pinned fixture."}]},{"id":"blk-49636","kind":"heading","level":2,"spans":[{"id":"spn-95223","text":"7. Empty-world correspondence"}]},{"id":"blk-49637","kind":"paragraph","spans":[{"id":"spn-95224","marks":["code"],"text":"relation/migration/an-empty-world-still-corresponds-to-itself"},{"id":"spn-95225","text":" — a world with no relations mapped against itself reports "},{"id":"spn-95226","marks":["code"],"text":"identityPreserved: true"},{"id":"spn-95227","text":" with all three lists empty. This is the degenerate case a correspondence that fails by returning nothing would be "},{"id":"spn-95228","marks":["bold"],"text":"indistinguishable"},{"id":"spn-95229","text":" from, which is why you asked for it and why the other migration checks do not cover it. Verified live in the playground on the \"Empty world\" preset as well."}]},{"id":"blk-49638","kind":"heading","level":2,"spans":[{"id":"spn-95230","text":"8. The missing model-register rows, and the B7 re-stage"}]},{"id":"blk-49639","kind":"paragraph","spans":[{"id":"spn-95231","text":"The register went "},{"id":"spn-95232","marks":["bold"],"text":"34 → 47 rows"},{"id":"spn-95233","text":"; "},{"id":"spn-95234","marks":["code"],"text":"model · executable"},{"id":"spn-95235","text":" went "},{"id":"spn-95236","marks":["bold"],"text":"22 → 35"},{"id":"spn-95237","text":"; "},{"id":"spn-95238","marks":["code"],"text":"model · awaiting"},{"id":"spn-95239","text":" remains "},{"id":"spn-95240","marks":["bold"],"text":"0"},{"id":"spn-95241","text":", so the "},{"id":"spn-95242","marks":["code"],"text":"REGISTERED_MODEL_DEBT_CAP = 0"},{"id":"spn-95243","text":" ratchet holds."}]},{"id":"blk-49640","kind":"heading","level":3,"spans":[{"id":"spn-95244","text":"8a. The B7 split you ordered"}]},{"id":"blk-49641","kind":"paragraph","spans":[{"id":"spn-95245","text":"Two rows were "},{"id":"spn-95246","marks":["italic"],"text":"half"},{"id":"spn-95247","text":" misfiled, and I think this is the sharpest instance of the register's own failure mode that has come up:"}]},{"head":[{"id":"blk-49643","spans":[{"id":"spn-95248","text":"law"}]},{"id":"blk-49644","spans":[{"id":"spn-95249","text":"was"}]},{"id":"blk-49645","spans":[{"id":"spn-95250","text":"is now"}]}],"id":"blk-49642","kind":"table","rows":[[{"id":"blk-49646","spans":[{"id":"spn-95251","marks":["code"],"text":"same-name-different-world-differs"}]},{"id":"blk-49647","spans":[{"id":"spn-95252","text":"surface · awaiting"}]},{"id":"blk-49648","spans":[{"id":"spn-95253","marks":["bold"],"text":"split"},{"id":"spn-95254","text":": "},{"id":"spn-95255","marks":["code"],"text":"named-allocation-is-world-scoped"},{"id":"spn-95256","text":" (model · executable) + itself, narrowed, still surface · awaiting"}]}],[{"id":"blk-49649","spans":[{"id":"spn-95257","marks":["code"],"text":"overlapping-grants-do-not-collide"}]},{"id":"blk-49650","spans":[{"id":"spn-95258","text":"runtime · awaiting"}]},{"id":"blk-49651","spans":[{"id":"spn-95259","marks":["bold"],"text":"split"},{"id":"spn-95260","text":": "},{"id":"spn-95261","marks":["code"],"text":"granted-allocation-separates-grants"},{"id":"spn-95262","text":" (model · executable) + itself, narrowed, still runtime · awaiting"}]}]]},{"id":"blk-49652","kind":"paragraph","spans":[{"id":"spn-95263","text":"Both were filed correctly "},{"id":"spn-95264","marks":["italic"],"text":"as far as it went"},{"id":"spn-95265","text":" — there is no syntax for naming a relation and no machinery for issuing a grant. But an identity is a function of a "},{"id":"spn-95266","marks":["bold"],"text":"preimage"},{"id":"spn-95267","text":", and both preimages are writable today: a "},{"id":"spn-95268","marks":["code"],"text":"NamedInitialAllocation"},{"id":"spn-95269","text":" carries its "},{"id":"spn-95270","marks":["code"],"text":"world_id"},{"id":"spn-95271","text":", a "},{"id":"spn-95272","marks":["code"],"text":"GrantedAllocation"},{"id":"spn-95273","text":" carries its "},{"id":"spn-95274","marks":["code"],"text":"grant_id"},{"id":"spn-95275","text":". The arithmetic was never blocked; only the way a "},{"id":"spn-95276","marks":["italic"],"text":"person"},{"id":"spn-95277","text":" reaches it was. A single row covering both had the effect of hiding a settled property behind an unsettled one, and reported "},{"id":"spn-95278","marks":["bold"],"text":"less"},{"id":"spn-95279","text":" than was known."}]},{"id":"blk-49653","kind":"paragraph","spans":[{"id":"spn-95280","text":"This is what forced the three-authorities separation:"}]},{"id":"blk-49654","items":[{"blocks":[{"id":"blk-49656","kind":"paragraph","spans":[{"id":"spn-95281","marks":["bold"],"text":"Which variants exist"},{"id":"spn-95282","text":" — all three. "},{"id":"spn-95283","marks":["code"],"text":"relationIdFromAllocation"},{"id":"spn-95284","text":" mints any"}]}],"id":"blk-49655","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49657","kind":"paragraph","spans":[{"id":"spn-95285","text":"well-formed allocation, and mints it the same way for everyone."}]},{"id":"blk-49658","items":[{"blocks":[{"id":"blk-49660","kind":"paragraph","spans":[{"id":"spn-95286","marks":["bold"],"text":"Which a trusted importer may construct"},{"id":"spn-95287","text":" — only "},{"id":"spn-95288","marks":["code"],"text":"legacy-edge"},{"id":"spn-95289","text":"."}]}],"id":"blk-49659","kind":"list-item"},{"blocks":[{"id":"blk-49662","kind":"paragraph","spans":[{"id":"spn-95290","marks":["bold"],"text":"Which an authoring surface may emit"},{"id":"spn-95291","text":" — none, today."}]}],"id":"blk-49661","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-49663","kind":"paragraph","spans":[{"id":"spn-95292","marks":["code"],"text":"assertImportableAllocation"},{"id":"spn-95293","text":" and "},{"id":"spn-95294","marks":["code"],"text":"assertAuthorableAllocation"},{"id":"spn-95295","text":" are separate boundaries; the mint refuses nothing. Folding them into the hash, as 0.1.1 did, made identity depend on "},{"id":"spn-95296","marks":["bold"],"text":"who was asking"},{"id":"spn-95297","text":" — which is the property a content address exists to not have."}]},{"id":"blk-49664","kind":"heading","level":3,"spans":[{"id":"spn-95298","text":"8b. The other new rows"}]},{"head":[{"id":"blk-49666","spans":[{"id":"spn-95299","text":"law"}]},{"id":"blk-49667","spans":[{"id":"spn-95300","text":"check"}]}],"id":"blk-49665","kind":"table","rows":[[{"id":"blk-49668","spans":[{"id":"spn-95301","marks":["code"],"text":"directed-carries-a-texture"}]},{"id":"blk-49669","spans":[{"id":"spn-95302","marks":["code"],"text":"relation/directed-carries-a-texture"}]}],[{"id":"blk-49670","spans":[{"id":"spn-95303","marks":["code"],"text":"texture-vocabulary-is-closed"}]},{"id":"blk-49671","spans":[{"id":"spn-95304","marks":["code"],"text":"relation/texture-vocabulary-is-the-specs"}]}],[{"id":"blk-49672","spans":[{"id":"spn-95305","marks":["code"],"text":"declared-vocabularies-are-immutable"}]},{"id":"blk-49673","spans":[{"id":"spn-95306","marks":["code"],"text":"relation/immutability/the-canon-cannot-be-moved-from-outside"}]}],[{"id":"blk-49674","spans":[{"id":"spn-95307","marks":["code"],"text":"allocation-variants-have-declared-fields"}]},{"id":"blk-49675","spans":[{"id":"spn-95308","marks":["code"],"text":"relation/allocations/each-variant-has-exactly-its-declared-fields"}]}],[{"id":"blk-49676","spans":[{"id":"spn-95309","marks":["code"],"text":"relation-id-binds-to-the-artifact-it-claims"}]},{"id":"blk-49677","spans":[{"id":"spn-95310","marks":["code"],"text":"relation/binding/a-forged-world-id-is-refused"}]}],[{"id":"blk-49678","spans":[{"id":"spn-95311","marks":["code"],"text":"world-id-is-recomputed-not-supplied"}]},{"id":"blk-49679","spans":[{"id":"spn-95312","marks":["code"],"text":"relation/binding/the-world-id-is-recomputed-not-supplied"}]}],[{"id":"blk-49680","spans":[{"id":"spn-95313","marks":["code"],"text":"import-admits-only-declared-artifact-versions"}]},{"id":"blk-49681","spans":[{"id":"spn-95314","marks":["code"],"text":"relation/binding/an-unknown-ir-version-is-refused"}]}],[{"id":"blk-49682","spans":[{"id":"spn-95315","marks":["code"],"text":"an-empty-world-corresponds-to-itself"}]},{"id":"blk-49683","spans":[{"id":"spn-95316","marks":["code"],"text":"relation/migration/an-empty-world-still-corresponds-to-itself"}]}],[{"id":"blk-49684","spans":[{"id":"spn-95317","marks":["code"],"text":"a-pairing-is-not-an-import-fact"}]},{"id":"blk-49685","spans":[{"id":"spn-95318","marks":["code"],"text":"relation/migration/a-pairing-is-not-an-import-fact"}]}],[{"id":"blk-49686","spans":[{"id":"spn-95319","marks":["code"],"text":"an-import-fact-is-backed-by-a-pairing"}]},{"id":"blk-49687","spans":[{"id":"spn-95320","marks":["code"],"text":"relation/migration/an-unbacked-import-fact-is-refused"}]}]]},{"id":"blk-49688","kind":"paragraph","spans":[{"id":"spn-95321","text":"Four existing rows had their "},{"id":"spn-95322","marks":["bold"],"text":"wording"},{"id":"spn-95323","text":" corrected rather than their status, because they were describing behaviour this commit changed: "},{"id":"spn-95324","marks":["code"],"text":"revision-does-not-move-relation-id"},{"id":"spn-95325","text":" (partition is now 2/1/4), "},{"id":"spn-95326","marks":["code"],"text":"import-supplies-only-declared-constants"},{"id":"spn-95327","text":" (adds the "},{"id":"spn-95328","marks":["italic"],"text":"resolved"},{"id":"spn-95329","text":" class; texture is no longer \"a missing key, never a null\"), "},{"id":"spn-95330","marks":["code"],"text":"import-mints-one-allocation-variant"},{"id":"spn-95331","text":" (the refusal moved from the mint to the two writer boundaries), "},{"id":"spn-95332","marks":["code"],"text":"migration-correspondence-is-derivable"},{"id":"spn-95333","text":" (no longer calls the derived pairing a "},{"id":"spn-95334","marks":["code"],"text":"RelationImported"},{"id":"spn-95335","text":")."}]},{"id":"blk-49689","kind":"heading","level":2,"spans":[{"id":"spn-95336","text":"9. What I need from you"}]},{"id":"blk-49690","kind":"heading","level":3,"spans":[{"id":"spn-95337","text":"9a. Two decisions I took autonomously"}]},{"id":"blk-49691","items":[{"blocks":[{"id":"blk-49693","kind":"paragraph","spans":[{"id":"spn-95338","marks":["bold"],"text":"`V1_IR_VERSIONS = [\"1.0\", \"1.1\"]`"},{"id":"spn-95339","text":" — see §4. Narrow it if you disagree."}]}],"id":"blk-49692","kind":"list-item"},{"blocks":[{"id":"blk-49695","kind":"paragraph","spans":[{"id":"spn-95340","text":"**"},{"id":"spn-95341","marks":["code"],"text":"ir_version"},{"id":"spn-95342","text":" and profile are checked; the "},{"id":"spn-95343","marks":["italic"],"text":"rulepack"},{"id":"spn-95344","text":" is not.** The adapter"}]}],"id":"blk-49694","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-49696","kind":"paragraph","spans":[{"id":"spn-95345","text":"reads "},{"id":"spn-95346","marks":["code"],"text":"semantic_policies.rulepack_id"},{"id":"spn-95347","text":" into "},{"id":"spn-95348","marks":["code"],"text":"policy"},{"id":"spn-95349","text":" without validating it against a declared set, on the grounds that "},{"id":"spn-95350","marks":["code"],"text":"policy"},{"id":"spn-95351","text":" is the one "},{"id":"spn-95352","marks":["bold"],"text":"free"},{"id":"spn-95353","text":" field and so cannot reach an id. That is true today and stops being true the moment anything else consumes it. I left it, and I am flagging it rather than quietly relying on it."}]},{"id":"blk-49697","kind":"heading","level":3,"spans":[{"id":"spn-95354","text":"9b. Path B — "},{"id":"spn-95355","marks":["bold"],"text":"answered, and built"}]},{"blocks":[{"id":"blk-49699","kind":"paragraph","spans":[{"id":"spn-95356","text":"The two questions below were the ones I could not answer myself. You ruled both, and Path B is now built to that ruling: "},{"id":"spn-95357","marks":["code"],"text":"relations"},{"id":"spn-95358","text":" replaces "},{"id":"spn-95359","marks":["code"],"text":"edges"},{"id":"spn-95360","text":" outright at V2, §D8.8's projection is the V1 compatibility adapter only, and "},{"id":"spn-95361","marks":["code"],"text":"NamedInitialAllocation"},{"id":"spn-95362","text":"'s surface landed "},{"id":"spn-95363","marks":["italic"],"text":"inside"},{"id":"spn-95364","text":" B as slice B.4. Slices B.1 – B.5 are green at 828/828 with model debt 0. "},{"id":"spn-95365","marks":["bold"],"text":"See `HANDOFF_D8_PATH_B.md`"},{"id":"spn-95366","text":" — this section is left standing as the record of where Path A stopped."}]}],"id":"blk-49698","kind":"quote"},{"id":"blk-49700","kind":"paragraph","spans":[{"id":"spn-95367","text":"I have your B1–B7 rulings. Path A is now closed on my side and I can start B under the byte-layout rulings, but B is a Semantic IR "},{"id":"spn-95368","marks":["bold"],"text":"V2"},{"id":"spn-95369","text":" design task, and the two things I do not have are:"}]},{"id":"blk-49701","items":[{"blocks":[{"id":"blk-49703","kind":"paragraph","spans":[{"id":"spn-95370","text":"the V2 byte layout ruled at the level of detail A had — specifically: does the"}]}],"id":"blk-49702","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49704","kind":"paragraph","spans":[{"id":"spn-95371","marks":["code"],"text":"relations"},{"id":"spn-95372","text":" array replace "},{"id":"spn-95373","marks":["code"],"text":"edges"},{"id":"spn-95374","text":" outright at V2 or coexist with it, and does the frozen legacy projection of §D8.8 remain "},{"id":"spn-95375","marks":["bold"],"text":"normative"},{"id":"spn-95376","text":" at V2 or become a read-only import path?"}]},{"id":"blk-49705","items":[{"blocks":[{"id":"blk-49707","kind":"paragraph","spans":[{"id":"spn-95377","text":"whether the surface for "},{"id":"spn-95378","marks":["code"],"text":"NamedInitialAllocation"},{"id":"spn-95379","text":" lands "},{"id":"spn-95380","marks":["italic"],"text":"inside"},{"id":"spn-95381","text":" B or after it."}]}],"id":"blk-49706","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-49708","kind":"paragraph","spans":[{"id":"spn-95382","text":"B7's split leaves one "},{"id":"spn-95383","marks":["code"],"text":"surface · awaiting"},{"id":"spn-95384","text":" row that only a surface can close, and I would rather not invent naming syntax to close a register row."}]},{"id":"blk-49709","kind":"paragraph","spans":[{"id":"spn-95385","text":"Everything in this memo is committed as one A.3 closure commit inside "},{"id":"spn-95386","marks":["code"],"text":"WRL/"},{"id":"spn-95387","text":" (own repo "},{"id":"spn-95388","marks":["code"],"text":"c-u-l8er/WRL"},{"id":"spn-95389","text":", branch "},{"id":"spn-95390","marks":["code"],"text":"main"},{"id":"spn-95391","text":") — per your ruling, \"after that battery is green and the pinned V1 IDs remain unchanged\"."}]},{"id":"blk-49710","kind