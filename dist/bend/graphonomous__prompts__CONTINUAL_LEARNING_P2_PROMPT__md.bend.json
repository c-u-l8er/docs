{"bendscript":"0.1","blocks":[{"id":"blk-45304","kind":"heading","level":1,"spans":[{"id":"spn-51031","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-45305","kind":"heading","level":2,"spans":[{"id":"spn-51032","text":"Prerequisites"}]},{"id":"blk-45306","kind":"paragraph","spans":[{"id":"spn-51033","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-45307","items":[{"blocks":[{"id":"blk-45309","kind":"paragraph","spans":[{"id":"spn-51034","text":"[ ] "},{"id":"spn-51035","marks":["code"],"text":"mix test"},{"id":"spn-51036","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-45308","kind":"list-item"},{"blocks":[{"id":"blk-45311","kind":"paragraph","spans":[{"id":"spn-51037","text":"[ ] "},{"id":"spn-51038","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-51039","text":" — 40/40 pass"}]}],"id":"blk-45310","kind":"list-item"},{"blocks":[{"id":"blk-45313","kind":"paragraph","spans":[{"id":"spn-51040","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-45312","kind":"list-item"},{"blocks":[{"id":"blk-45315","kind":"paragraph","spans":[{"id":"spn-51041","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-45314","kind":"list-item"},{"blocks":[{"id":"blk-45317","kind":"paragraph","spans":[{"id":"spn-51042","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-45316","kind":"list-item"},{"blocks":[{"id":"blk-45319","kind":"paragraph","spans":[{"id":"spn-51043","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-45318","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45320","kind":"heading","level":2,"spans":[{"id":"spn-51044","text":"Session Goal"}]},{"id":"blk-45321","kind":"paragraph","spans":[{"id":"spn-51045","text":"Implement P2 capabilities: "},{"id":"spn-51046","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-51047","text":", "},{"id":"spn-51048","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-51049","text":", and "},{"id":"spn-51050","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-51051","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-45322","kind":"heading","level":2,"spans":[{"id":"spn-51052","text":"Active Goal"}]},{"id":"blk-45323","kind":"paragraph","spans":[{"id":"spn-51053","text":"Retrieve and update: "},{"id":"spn-51054","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-45324","kind":"paragraph","spans":[{"id":"spn-51055","text":"---"}]},{"id":"blk-45325","kind":"heading","level":2,"spans":[{"id":"spn-51056","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-45326","kind":"heading","level":3,"spans":[{"id":"spn-51057","text":"What it does"}]},{"id":"blk-45327","kind":"paragraph","spans":[{"id":"spn-51058","text":"Adds "},{"id":"spn-51059","marks":["code"],"text":"evidence_count"},{"id":"spn-51060","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-51061","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-51062","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-45328","kind":"heading","level":3,"spans":[{"id":"spn-51063","text":"Why scoped (not universal)"}]},{"id":"blk-45329","kind":"paragraph","spans":[{"id":"spn-51064","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-51065","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-51066","text":" or "},{"id":"spn-51067","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-51068","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-45330","kind":"heading","level":3,"spans":[{"id":"spn-51069","text":"Research basis"}]},{"id":"blk-45331","kind":"paragraph","spans":[{"id":"spn-51070","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-45332","kind":"heading","level":3,"spans":[{"id":"spn-51071","text":"Schema migration"}]},{"id":"blk-45333","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-45334","kind":"heading","level":3,"spans":[{"id":"spn-51072","text":"New file: "},{"id":"spn-51073","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-45335","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-45336","kind":"heading","level":3,"spans":[{"id":"spn-51074","text":"New MCP tool"}]},{"id":"blk-45337","items":[{"blocks":[{"id":"blk-45339","kind":"paragraph","spans":[{"id":"spn-51075","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-51076","text":" — "},{"id":"spn-51077","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-45338","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45340","kind":"paragraph","spans":[{"id":"spn-51078","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-45341","kind":"heading","level":3,"spans":[{"id":"spn-51079","text":"Integration points"}]},{"id":"blk-45342","kind":"paragraph","spans":[{"id":"spn-51080","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-51081","text":" In "},{"id":"spn-51082","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-51083","text":" and "},{"id":"spn-51084","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-51085","text":": increment "},{"id":"spn-51086","marks":["code"],"text":"evidence_count"},{"id":"spn-51087","text":" on causal nodes."}]},{"id":"blk-45343","kind":"paragraph","spans":[{"id":"spn-51088","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-51089","text":" Replace "},{"id":"spn-51090","marks":["code"],"text":"uncertainty_score"},{"id":"spn-51091","text":" heuristic with "},{"id":"spn-51092","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-51093","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-45344","kind":"paragraph","spans":[{"id":"spn-51094","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-51095","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-45345","kind":"heading","level":3,"spans":[{"id":"spn-51096","text":"Tests"}]},{"id":"blk-45346","items":[{"blocks":[{"id":"blk-45348","kind":"paragraph","spans":[{"id":"spn-51097","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-45347","kind":"list-item"},{"blocks":[{"id":"blk-45350","kind":"paragraph","spans":[{"id":"spn-51098","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-45349","kind":"list-item"},{"blocks":[{"id":"blk-45352","kind":"paragraph","spans":[{"id":"spn-51099","text":"Node with evidence_count=0 → returns "},{"id":"spn-51100","marks":["code"],"text":":no_evidence"}]}],"id":"blk-45351","kind":"list-item"},{"blocks":[{"id":"blk-45354","kind":"paragraph","spans":[{"id":"spn-51101","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-45353","kind":"list-item"},{"blocks":[{"id":"blk-45356","kind":"paragraph","spans":[{"id":"spn-51102","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-45355","kind":"list-item"},{"blocks":[{"id":"blk-45358","kind":"paragraph","spans":[{"id":"spn-51103","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-45357","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45359","kind":"paragraph","spans":[{"id":"spn-51104","text":"---"}]},{"id":"blk-45360","kind":"heading","level":2,"spans":[{"id":"spn-51105","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-45361","kind":"heading","level":3,"spans":[{"id":"spn-51106","text":"What it does"}]},{"id":"blk-45362","kind":"paragraph","spans":[{"id":"spn-51107","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-51108","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51109","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-45363","kind":"heading","level":3,"spans":[{"id":"spn-51110","text":"Why metadata-only (not full composition)"}]},{"id":"blk-45364","kind":"paragraph","spans":[{"id":"spn-51111","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-45365","kind":"heading","level":3,"spans":[{"id":"spn-51112","text":"Research basis"}]},{"id":"blk-45366","kind":"paragraph","spans":[{"id":"spn-51113","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-45367","kind":"heading","level":3,"spans":[{"id":"spn-51114","text":"Schema note"}]},{"id":"blk-45368","kind":"paragraph","spans":[{"id":"spn-51115","text":"No migration needed — use existing "},{"id":"spn-51116","marks":["code"],"text":"metadata"},{"id":"spn-51117","text":" JSON field on nodes:"}]},{"id":"blk-45369","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-45370","kind":"heading","level":3,"spans":[{"id":"spn-51118","text":"File: "},{"id":"spn-51119","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45371","kind":"paragraph","spans":[{"id":"spn-51120","text":"Enhance "},{"id":"spn-51121","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51122","text":" to support precondition matching:"}]},{"id":"blk-45372","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-45373","kind":"heading","level":3,"spans":[{"id":"spn-51123","text":"File: "},{"id":"spn-51124","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-45374","kind":"paragraph","spans":[{"id":"spn-51125","text":"When "},{"id":"spn-51126","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-51127","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-45375","kind":"heading","level":3,"spans":[{"id":"spn-51128","text":"File: "},{"id":"spn-51129","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45376","kind":"paragraph","spans":[{"id":"spn-51130","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-45377","kind":"heading","level":3,"spans":[{"id":"spn-51131","text":"Modify "},{"id":"spn-51132","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51133","text":" MCP tool"}]},{"id":"blk-45378","kind":"paragraph","spans":[{"id":"spn-51134","text":"Add optional "},{"id":"spn-51135","marks":["code"],"text":"preconditions"},{"id":"spn-51136","text":" parameter:"}]},{"id":"blk-45379","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-45380","kind":"heading","level":3,"spans":[{"id":"spn-51137","text":"Tests"}]},{"id":"blk-45381","items":[{"blocks":[{"id":"blk-45383","kind":"paragraph","spans":[{"id":"spn-51138","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-45382","kind":"list-item"},{"blocks":[{"id":"blk-45385","kind":"paragraph","spans":[{"id":"spn-51139","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-45384","kind":"list-item"},{"blocks":[{"id":"blk-45387","kind":"paragraph","spans":[{"id":"spn-51140","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-45386","kind":"list-item"},{"blocks":[{"id":"blk-45389","kind":"paragraph","spans":[{"id":"spn-51141","text":"Skill metadata survives consolidation"}]}],"id":"blk-45388","kind":"list-item"},{"blocks":[{"id":"blk-45391","kind":"paragraph","spans":[{"id":"spn-51142","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-45390","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45392","kind":"paragraph","spans":[{"id":"spn-51143","text":"---"}]},{"id":"blk-45393","kind":"heading","level":2,"spans":[{"id":"spn-51144","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-45394","kind":"heading","level":3,"spans":[{"id":"spn-51145","text":"What it does"}]},{"id":"blk-45395","kind":"paragraph","spans":[{"id":"spn-51146","text":"Adds "},{"id":"spn-51147","marks":["code"],"text":"agent_id"},{"id":"spn-51148","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-45396","kind":"heading","level":3,"spans":[{"id":"spn-51149","text":"Schema migration"}]},{"id":"blk-45397","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-45398","kind":"heading","level":3,"spans":[{"id":"spn-51150","text":"File: "},{"id":"spn-51151","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-45399","kind":"paragraph","spans":[{"id":"spn-51152","text":"Add "},{"id":"spn-51153","marks":["code"],"text":"agent_id"},{"id":"spn-51154","text":" to the Node struct with default "},{"id":"spn-51155","marks":["code"],"text":"\"default\""},{"id":"spn-51156","text":"."}]},{"id":"blk-45400","kind":"heading","level":3,"spans":[{"id":"spn-51157","text":"File: "},{"id":"spn-51158","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-45401","kind":"paragraph","spans":[{"id":"spn-51159","text":"Add "},{"id":"spn-51160","marks":["code"],"text":"agent_id"},{"id":"spn-51161","text":" to the Edge struct with default "},{"id":"spn-51162","marks":["code"],"text":"\"default\""},{"id":"spn-51163","text":"."}]},{"id":"blk-45402","kind":"heading","level":3,"spans":[{"id":"spn-51164","text":"File: "},{"id":"spn-51165","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-45403","items":[{"blocks":[{"id":"blk-45405","kind":"paragraph","spans":[{"id":"spn-51166","text":"Include "},{"id":"spn-51167","marks":["code"],"text":"agent_id"},{"id":"spn-51168","text":" in INSERT statements"}]}],"id":"blk-45404","kind":"list-item"},{"blocks":[{"id":"blk-45407","kind":"paragraph","spans":[{"id":"spn-51169","text":"Add "},{"id":"spn-51170","marks":["code"],"text":"agent_id"},{"id":"spn-51171","text":" to SELECT result mapping"}]}],"id":"blk-45406","kind":"list-item"},{"blocks":[{"id":"blk-45409","kind":"paragraph","spans":[{"id":"spn-51172","text":"Add "},{"id":"spn-51173","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-51174","text":" query (for future use)"}]}],"id":"blk-45408","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45410","kind":"heading","level":3,"spans":[{"id":"spn-51175","text":"Tests"}]},{"id":"blk-45411","items":[{"blocks":[{"id":"blk-45413","kind":"paragraph","spans":[{"id":"spn-51176","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-45412","kind":"list-item"},{"blocks":[{"id":"blk-45415","kind":"paragraph","spans":[{"id":"spn-51177","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-45414","kind":"list-item"},{"blocks":[{"id":"blk-45417","kind":"paragraph","spans":[{"id":"spn-51178","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-45416","kind":"list-item"},{"blocks"