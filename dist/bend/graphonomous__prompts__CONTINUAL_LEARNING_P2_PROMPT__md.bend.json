{"bendscript":"0.1","blocks":[{"id":"blk-70509","kind":"heading","level":1,"spans":[{"id":"spn-101543","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-70510","kind":"heading","level":2,"spans":[{"id":"spn-101544","text":"Prerequisites"}]},{"id":"blk-70511","kind":"paragraph","spans":[{"id":"spn-101545","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-70512","items":[{"blocks":[{"id":"blk-70514","kind":"paragraph","spans":[{"id":"spn-101546","text":"[ ] "},{"id":"spn-101547","marks":["code"],"text":"mix test"},{"id":"spn-101548","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-70513","kind":"list-item"},{"blocks":[{"id":"blk-70516","kind":"paragraph","spans":[{"id":"spn-101549","text":"[ ] "},{"id":"spn-101550","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-101551","text":" — 40/40 pass"}]}],"id":"blk-70515","kind":"list-item"},{"blocks":[{"id":"blk-70518","kind":"paragraph","spans":[{"id":"spn-101552","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-70517","kind":"list-item"},{"blocks":[{"id":"blk-70520","kind":"paragraph","spans":[{"id":"spn-101553","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-70519","kind":"list-item"},{"blocks":[{"id":"blk-70522","kind":"paragraph","spans":[{"id":"spn-101554","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-70521","kind":"list-item"},{"blocks":[{"id":"blk-70524","kind":"paragraph","spans":[{"id":"spn-101555","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-70523","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70525","kind":"heading","level":2,"spans":[{"id":"spn-101556","text":"Session Goal"}]},{"id":"blk-70526","kind":"paragraph","spans":[{"id":"spn-101557","text":"Implement P2 capabilities: "},{"id":"spn-101558","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-101559","text":", "},{"id":"spn-101560","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-101561","text":", and "},{"id":"spn-101562","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-101563","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-70527","kind":"heading","level":2,"spans":[{"id":"spn-101564","text":"Active Goal"}]},{"id":"blk-70528","kind":"paragraph","spans":[{"id":"spn-101565","text":"Retrieve and update: "},{"id":"spn-101566","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-70529","kind":"heading","level":2,"spans":[{"id":"spn-101567","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-70530","kind":"heading","level":3,"spans":[{"id":"spn-101568","text":"What it does"}]},{"id":"blk-70531","kind":"paragraph","spans":[{"id":"spn-101569","text":"Adds "},{"id":"spn-101570","marks":["code"],"text":"evidence_count"},{"id":"spn-101571","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-101572","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-101573","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-70532","kind":"heading","level":3,"spans":[{"id":"spn-101574","text":"Why scoped (not universal)"}]},{"id":"blk-70533","kind":"paragraph","spans":[{"id":"spn-101575","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-101576","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101577","text":" or "},{"id":"spn-101578","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-101579","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-70534","kind":"heading","level":3,"spans":[{"id":"spn-101580","text":"Research basis"}]},{"id":"blk-70535","kind":"paragraph","spans":[{"id":"spn-101581","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-70536","kind":"heading","level":3,"spans":[{"id":"spn-101582","text":"Schema migration"}]},{"id":"blk-70537","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-70538","kind":"heading","level":3,"spans":[{"id":"spn-101583","text":"New file: "},{"id":"spn-101584","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-70539","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-70540","kind":"heading","level":3,"spans":[{"id":"spn-101585","text":"New MCP tool"}]},{"id":"blk-70541","items":[{"blocks":[{"id":"blk-70543","kind":"paragraph","spans":[{"id":"spn-101586","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-101587","text":" — "},{"id":"spn-101588","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-70542","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70544","kind":"paragraph","spans":[{"id":"spn-101589","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-70545","kind":"heading","level":3,"spans":[{"id":"spn-101590","text":"Integration points"}]},{"id":"blk-70546","kind":"paragraph","spans":[{"id":"spn-101591","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-101592","text":" In "},{"id":"spn-101593","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101594","text":" and "},{"id":"spn-101595","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-101596","text":": increment "},{"id":"spn-101597","marks":["code"],"text":"evidence_count"},{"id":"spn-101598","text":" on causal nodes."}]},{"id":"blk-70547","kind":"paragraph","spans":[{"id":"spn-101599","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-101600","text":" Replace "},{"id":"spn-101601","marks":["code"],"text":"uncertainty_score"},{"id":"spn-101602","text":" heuristic with "},{"id":"spn-101603","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-101604","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-70548","kind":"paragraph","spans":[{"id":"spn-101605","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-101606","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-70549","kind":"heading","level":3,"spans":[{"id":"spn-101607","text":"Tests"}]},{"id":"blk-70550","items":[{"blocks":[{"id":"blk-70552","kind":"paragraph","spans":[{"id":"spn-101608","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-70551","kind":"list-item"},{"blocks":[{"id":"blk-70554","kind":"paragraph","spans":[{"id":"spn-101609","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-70553","kind":"list-item"},{"blocks":[{"id":"blk-70556","kind":"paragraph","spans":[{"id":"spn-101610","text":"Node with evidence_count=0 → returns "},{"id":"spn-101611","marks":["code"],"text":":no_evidence"}]}],"id":"blk-70555","kind":"list-item"},{"blocks":[{"id":"blk-70558","kind":"paragraph","spans":[{"id":"spn-101612","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-70557","kind":"list-item"},{"blocks":[{"id":"blk-70560","kind":"paragraph","spans":[{"id":"spn-101613","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-70559","kind":"list-item"},{"blocks":[{"id":"blk-70562","kind":"paragraph","spans":[{"id":"spn-101614","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-70561","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70563","kind":"heading","level":2,"spans":[{"id":"spn-101615","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-70564","kind":"heading","level":3,"spans":[{"id":"spn-101616","text":"What it does"}]},{"id":"blk-70565","kind":"paragraph","spans":[{"id":"spn-101617","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-101618","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101619","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-70566","kind":"heading","level":3,"spans":[{"id":"spn-101620","text":"Why metadata-only (not full composition)"}]},{"id":"blk-70567","kind":"paragraph","spans":[{"id":"spn-101621","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-70568","kind":"heading","level":3,"spans":[{"id":"spn-101622","text":"Research basis"}]},{"id":"blk-70569","kind":"paragraph","spans":[{"id":"spn-101623","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-70570","kind":"heading","level":3,"spans":[{"id":"spn-101624","text":"Schema note"}]},{"id":"blk-70571","kind":"paragraph","spans":[{"id":"spn-101625","text":"No migration needed — use existing "},{"id":"spn-101626","marks":["code"],"text":"metadata"},{"id":"spn-101627","text":" JSON field on nodes:"}]},{"id":"blk-70572","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-70573","kind":"heading","level":3,"spans":[{"id":"spn-101628","text":"File: "},{"id":"spn-101629","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-70574","kind":"paragraph","spans":[{"id":"spn-101630","text":"Enhance "},{"id":"spn-101631","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101632","text":" to support precondition matching:"}]},{"id":"blk-70575","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-70576","kind":"heading","level":3,"spans":[{"id":"spn-101633","text":"File: "},{"id":"spn-101634","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-70577","kind":"paragraph","spans":[{"id":"spn-101635","text":"When "},{"id":"spn-101636","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-101637","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-70578","kind":"heading","level":3,"spans":[{"id":"spn-101638","text":"File: "},{"id":"spn-101639","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-70579","kind":"paragraph","spans":[{"id":"spn-101640","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-70580","kind":"heading","level":3,"spans":[{"id":"spn-101641","text":"Modify "},{"id":"spn-101642","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101643","text":" MCP tool"}]},{"id":"blk-70581","kind":"paragraph","spans":[{"id":"spn-101644","text":"Add optional "},{"id":"spn-101645","marks":["code"],"text":"preconditions"},{"id":"spn-101646","text":" parameter:"}]},{"id":"blk-70582","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-70583","kind":"heading","level":3,"spans":[{"id":"spn-101647","text":"Tests"}]},{"id":"blk-70584","items":[{"blocks":[{"id":"blk-70586","kind":"paragraph","spans":[{"id":"spn-101648","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-70585","kind":"list-item"},{"blocks":[{"id":"blk-70588","kind":"paragraph","spans":[{"id":"spn-101649","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-70587","kind":"list-item"},{"blocks":[{"id":"blk-70590","kind":"paragraph","spans":[{"id":"spn-101650","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-70589","kind":"list-item"},{"blocks":[{"id":"blk-70592","kind":"paragraph","spans":[{"id":"spn-101651","text":"Skill metadata survives consolidation"}]}],"id":"blk-70591","kind":"list-item"},{"blocks":[{"id":"blk-70594","kind":"paragraph","spans":[{"id":"spn-101652","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-70593","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70595","kind":"heading","level":2,"spans":[{"id":"spn-101653","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-70596","kind":"heading","level":3,"spans":[{"id":"spn-101654","text":"What it does"}]},{"id":"blk-70597","kind":"paragraph","spans":[{"id":"spn-101655","text":"Adds "},{"id":"spn-101656","marks":["code"],"text":"agent_id"},{"id":"spn-101657","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-70598","kind":"heading","level":3,"spans":[{"id":"spn-101658","text":"Schema migration"}]},{"id":"blk-70599","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-70600","kind":"heading","level":3,"spans":[{"id":"spn-101659","text":"File: "},{"id":"spn-101660","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-70601","kind":"paragraph","spans":[{"id":"spn-101661","text":"Add "},{"id":"spn-101662","marks":["code"],"text":"agent_id"},{"id":"spn-101663","text":" to the Node struct with default "},{"id":"spn-101664","marks":["code"],"text":"\"default\""},{"id":"spn-101665","text":"."}]},{"id":"blk-70602","kind":"heading","level":3,"spans":[{"id":"spn-101666","text":"File: "},{"id":"spn-101667","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-70603","kind":"paragraph","spans":[{"id":"spn-101668","text":"Add "},{"id":"spn-101669","marks":["code"],"text":"agent_id"},{"id":"spn-101670","text":" to the Edge struct with default "},{"id":"spn-101671","marks":["code"],"text":"\"default\""},{"id":"spn-101672","text":"."}]},{"id":"blk-70604","kind":"heading","level":3,"spans":[{"id":"spn-101673","text":"File: "},{"id":"spn-101674","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-70605","items":[{"blocks":[{"id":"blk-70607","kind":"paragraph","spans":[{"id":"spn-101675","text":"Include "},{"id":"spn-101676","marks":["code"],"text":"agent_id"},{"id":"spn-101677","text":" in INSERT statements"}]}],"id":"blk-70606","kind":"list-item"},{"blocks":[{"id":"blk-70609","kind":"paragraph","spans":[{"id":"spn-101678","text":"Add "},{"id":"spn-101679","marks":["code"],"text":"agent_id"},{"id":"spn-101680","text":" to SELECT result mapping"}]}],"id":"blk-70608","kind":"list-item"},{"blocks":[{"id":"blk-70611","kind":"paragraph","spans":[{"id":"spn-101681","text":"Add "},{"id":"spn-101682","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-101683","text":" query (for future use)"}]}],"id":"blk-70610","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70612","kind":"heading","level":3,"spans":[{"id":"spn-101684","text":"Tests"}]},{"id":"blk-70613","items":[{"blocks":[{"id":"blk-70615","kind":"paragraph","spans":[{"id":"spn-101685","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-70614","kind":"list-item"},{"blocks":[{"id":"blk-70617","kind":"paragraph","spans":[{"id":"spn-101686","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-70616","kind":"list-item"},{"blocks":[{"id":"blk-70619","kind":"paragraph","spans":[{"id":"spn-101687","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-70618","kind":"list-item"},{"blocks":[{"id":"blk-70621","kind":"paragraph","spans":[{"id":"spn-101688","text":"Existing behavior un