{"bendscript":"0.1","blocks":[{"id":"blk-70635","kind":"heading","level":1,"spans":[{"id":"spn-101691","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-70636","kind":"heading","level":2,"spans":[{"id":"spn-101692","text":"Prerequisites"}]},{"id":"blk-70637","kind":"paragraph","spans":[{"id":"spn-101693","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-70638","items":[{"blocks":[{"id":"blk-70640","kind":"paragraph","spans":[{"id":"spn-101694","text":"[ ] "},{"id":"spn-101695","marks":["code"],"text":"mix test"},{"id":"spn-101696","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-70639","kind":"list-item"},{"blocks":[{"id":"blk-70642","kind":"paragraph","spans":[{"id":"spn-101697","text":"[ ] "},{"id":"spn-101698","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-101699","text":" — 40/40 pass"}]}],"id":"blk-70641","kind":"list-item"},{"blocks":[{"id":"blk-70644","kind":"paragraph","spans":[{"id":"spn-101700","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-70643","kind":"list-item"},{"blocks":[{"id":"blk-70646","kind":"paragraph","spans":[{"id":"spn-101701","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-70645","kind":"list-item"},{"blocks":[{"id":"blk-70648","kind":"paragraph","spans":[{"id":"spn-101702","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-70647","kind":"list-item"},{"blocks":[{"id":"blk-70650","kind":"paragraph","spans":[{"id":"spn-101703","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-70649","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70651","kind":"heading","level":2,"spans":[{"id":"spn-101704","text":"Session Goal"}]},{"id":"blk-70652","kind":"paragraph","spans":[{"id":"spn-101705","text":"Implement P2 capabilities: "},{"id":"spn-101706","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-101707","text":", "},{"id":"spn-101708","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-101709","text":", and "},{"id":"spn-101710","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-101711","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-70653","kind":"heading","level":2,"spans":[{"id":"spn-101712","text":"Active Goal"}]},{"id":"blk-70654","kind":"paragraph","spans":[{"id":"spn-101713","text":"Retrieve and update: "},{"id":"spn-101714","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-70655","kind":"heading","level":2,"spans":[{"id":"spn-101715","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-70656","kind":"heading","level":3,"spans":[{"id":"spn-101716","text":"What it does"}]},{"id":"blk-70657","kind":"paragraph","spans":[{"id":"spn-101717","text":"Adds "},{"id":"spn-101718","marks":["code"],"text":"evidence_count"},{"id":"spn-101719","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-101720","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-101721","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-70658","kind":"heading","level":3,"spans":[{"id":"spn-101722","text":"Why scoped (not universal)"}]},{"id":"blk-70659","kind":"paragraph","spans":[{"id":"spn-101723","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-101724","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101725","text":" or "},{"id":"spn-101726","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-101727","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-70660","kind":"heading","level":3,"spans":[{"id":"spn-101728","text":"Research basis"}]},{"id":"blk-70661","kind":"paragraph","spans":[{"id":"spn-101729","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-70662","kind":"heading","level":3,"spans":[{"id":"spn-101730","text":"Schema migration"}]},{"id":"blk-70663","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-70664","kind":"heading","level":3,"spans":[{"id":"spn-101731","text":"New file: "},{"id":"spn-101732","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-70665","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-70666","kind":"heading","level":3,"spans":[{"id":"spn-101733","text":"New MCP tool"}]},{"id":"blk-70667","items":[{"blocks":[{"id":"blk-70669","kind":"paragraph","spans":[{"id":"spn-101734","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-101735","text":" — "},{"id":"spn-101736","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-70668","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70670","kind":"paragraph","spans":[{"id":"spn-101737","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-70671","kind":"heading","level":3,"spans":[{"id":"spn-101738","text":"Integration points"}]},{"id":"blk-70672","kind":"paragraph","spans":[{"id":"spn-101739","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-101740","text":" In "},{"id":"spn-101741","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101742","text":" and "},{"id":"spn-101743","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-101744","text":": increment "},{"id":"spn-101745","marks":["code"],"text":"evidence_count"},{"id":"spn-101746","text":" on causal nodes."}]},{"id":"blk-70673","kind":"paragraph","spans":[{"id":"spn-101747","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-101748","text":" Replace "},{"id":"spn-101749","marks":["code"],"text":"uncertainty_score"},{"id":"spn-101750","text":" heuristic with "},{"id":"spn-101751","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-101752","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-70674","kind":"paragraph","spans":[{"id":"spn-101753","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-101754","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-70675","kind":"heading","level":3,"spans":[{"id":"spn-101755","text":"Tests"}]},{"id":"blk-70676","items":[{"blocks":[{"id":"blk-70678","kind":"paragraph","spans":[{"id":"spn-101756","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-70677","kind":"list-item"},{"blocks":[{"id":"blk-70680","kind":"paragraph","spans":[{"id":"spn-101757","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-70679","kind":"list-item"},{"blocks":[{"id":"blk-70682","kind":"paragraph","spans":[{"id":"spn-101758","text":"Node with evidence_count=0 → returns "},{"id":"spn-101759","marks":["code"],"text":":no_evidence"}]}],"id":"blk-70681","kind":"list-item"},{"blocks":[{"id":"blk-70684","kind":"paragraph","spans":[{"id":"spn-101760","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-70683","kind":"list-item"},{"blocks":[{"id":"blk-70686","kind":"paragraph","spans":[{"id":"spn-101761","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-70685","kind":"list-item"},{"blocks":[{"id":"blk-70688","kind":"paragraph","spans":[{"id":"spn-101762","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-70687","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70689","kind":"heading","level":2,"spans":[{"id":"spn-101763","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-70690","kind":"heading","level":3,"spans":[{"id":"spn-101764","text":"What it does"}]},{"id":"blk-70691","kind":"paragraph","spans":[{"id":"spn-101765","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-101766","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101767","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-70692","kind":"heading","level":3,"spans":[{"id":"spn-101768","text":"Why metadata-only (not full composition)"}]},{"id":"blk-70693","kind":"paragraph","spans":[{"id":"spn-101769","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-70694","kind":"heading","level":3,"spans":[{"id":"spn-101770","text":"Research basis"}]},{"id":"blk-70695","kind":"paragraph","spans":[{"id":"spn-101771","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-70696","kind":"heading","level":3,"spans":[{"id":"spn-101772","text":"Schema note"}]},{"id":"blk-70697","kind":"paragraph","spans":[{"id":"spn-101773","text":"No migration needed — use existing "},{"id":"spn-101774","marks":["code"],"text":"metadata"},{"id":"spn-101775","text":" JSON field on nodes:"}]},{"id":"blk-70698","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-70699","kind":"heading","level":3,"spans":[{"id":"spn-101776","text":"File: "},{"id":"spn-101777","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-70700","kind":"paragraph","spans":[{"id":"spn-101778","text":"Enhance "},{"id":"spn-101779","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101780","text":" to support precondition matching:"}]},{"id":"blk-70701","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-70702","kind":"heading","level":3,"spans":[{"id":"spn-101781","text":"File: "},{"id":"spn-101782","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-70703","kind":"paragraph","spans":[{"id":"spn-101783","text":"When "},{"id":"spn-101784","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-101785","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-70704","kind":"heading","level":3,"spans":[{"id":"spn-101786","text":"File: "},{"id":"spn-101787","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-70705","kind":"paragraph","spans":[{"id":"spn-101788","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-70706","kind":"heading","level":3,"spans":[{"id":"spn-101789","text":"Modify "},{"id":"spn-101790","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-101791","text":" MCP tool"}]},{"id":"blk-70707","kind":"paragraph","spans":[{"id":"spn-101792","text":"Add optional "},{"id":"spn-101793","marks":["code"],"text":"preconditions"},{"id":"spn-101794","text":" parameter:"}]},{"id":"blk-70708","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-70709","kind":"heading","level":3,"spans":[{"id":"spn-101795","text":"Tests"}]},{"id":"blk-70710","items":[{"blocks":[{"id":"blk-70712","kind":"paragraph","spans":[{"id":"spn-101796","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-70711","kind":"list-item"},{"blocks":[{"id":"blk-70714","kind":"paragraph","spans":[{"id":"spn-101797","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-70713","kind":"list-item"},{"blocks":[{"id":"blk-70716","kind":"paragraph","spans":[{"id":"spn-101798","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-70715","kind":"list-item"},{"blocks":[{"id":"blk-70718","kind":"paragraph","spans":[{"id":"spn-101799","text":"Skill metadata survives consolidation"}]}],"id":"blk-70717","kind":"list-item"},{"blocks":[{"id":"blk-70720","kind":"paragraph","spans":[{"id":"spn-101800","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-70719","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70721","kind":"heading","level":2,"spans":[{"id":"spn-101801","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-70722","kind":"heading","level":3,"spans":[{"id":"spn-101802","text":"What it does"}]},{"id":"blk-70723","kind":"paragraph","spans":[{"id":"spn-101803","text":"Adds "},{"id":"spn-101804","marks":["code"],"text":"agent_id"},{"id":"spn-101805","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-70724","kind":"heading","level":3,"spans":[{"id":"spn-101806","text":"Schema migration"}]},{"id":"blk-70725","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-70726","kind":"heading","level":3,"spans":[{"id":"spn-101807","text":"File: "},{"id":"spn-101808","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-70727","kind":"paragraph","spans":[{"id":"spn-101809","text":"Add "},{"id":"spn-101810","marks":["code"],"text":"agent_id"},{"id":"spn-101811","text":" to the Node struct with default "},{"id":"spn-101812","marks":["code"],"text":"\"default\""},{"id":"spn-101813","text":"."}]},{"id":"blk-70728","kind":"heading","level":3,"spans":[{"id":"spn-101814","text":"File: "},{"id":"spn-101815","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-70729","kind":"paragraph","spans":[{"id":"spn-101816","text":"Add "},{"id":"spn-101817","marks":["code"],"text":"agent_id"},{"id":"spn-101818","text":" to the Edge struct with default "},{"id":"spn-101819","marks":["code"],"text":"\"default\""},{"id":"spn-101820","text":"."}]},{"id":"blk-70730","kind":"heading","level":3,"spans":[{"id":"spn-101821","text":"File: "},{"id":"spn-101822","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-70731","items":[{"blocks":[{"id":"blk-70733","kind":"paragraph","spans":[{"id":"spn-101823","text":"Include "},{"id":"spn-101824","marks":["code"],"text":"agent_id"},{"id":"spn-101825","text":" in INSERT statements"}]}],"id":"blk-70732","kind":"list-item"},{"blocks":[{"id":"blk-70735","kind":"paragraph","spans":[{"id":"spn-101826","text":"Add "},{"id":"spn-101827","marks":["code"],"text":"agent_id"},{"id":"spn-101828","text":" to SELECT result mapping"}]}],"id":"blk-70734","kind":"list-item"},{"blocks":[{"id":"blk-70737","kind":"paragraph","spans":[{"id":"spn-101829","text":"Add "},{"id":"spn-101830","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-101831","text":" query (for future use)"}]}],"id":"blk-70736","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70738","kind":"heading","level":3,"spans":[{"id":"spn-101832","text":"Tests"}]},{"id":"blk-70739","items":[{"blocks":[{"id":"blk-70741","kind":"paragraph","spans":[{"id":"spn-101833","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-70740","kind":"list-item"},{"blocks":[{"id":"blk-70743","kind":"paragraph","spans":[{"id":"spn-101834","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-70742","kind":"list-item"},{"blocks":[{"id":"blk-70745","kind":"paragraph","spans":[{"id":"spn-101835","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-70744","kind":"list-item"},{"blocks":[{"id":"blk-70747","kind":"paragraph","spans":[{"id":"spn-101836","text":"Existing behavior un