{"bendscript":"0.1","blocks":[{"id":"blk-46386","kind":"heading","level":1,"spans":[{"id":"spn-53954","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-46387","kind":"heading","level":2,"spans":[{"id":"spn-53955","text":"Prerequisites"}]},{"id":"blk-46388","kind":"paragraph","spans":[{"id":"spn-53956","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-46389","items":[{"blocks":[{"id":"blk-46391","kind":"paragraph","spans":[{"id":"spn-53957","text":"[ ] "},{"id":"spn-53958","marks":["code"],"text":"mix test"},{"id":"spn-53959","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-46390","kind":"list-item"},{"blocks":[{"id":"blk-46393","kind":"paragraph","spans":[{"id":"spn-53960","text":"[ ] "},{"id":"spn-53961","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-53962","text":" — 40/40 pass"}]}],"id":"blk-46392","kind":"list-item"},{"blocks":[{"id":"blk-46395","kind":"paragraph","spans":[{"id":"spn-53963","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-46394","kind":"list-item"},{"blocks":[{"id":"blk-46397","kind":"paragraph","spans":[{"id":"spn-53964","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-46396","kind":"list-item"},{"blocks":[{"id":"blk-46399","kind":"paragraph","spans":[{"id":"spn-53965","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-46398","kind":"list-item"},{"blocks":[{"id":"blk-46401","kind":"paragraph","spans":[{"id":"spn-53966","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-46400","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46402","kind":"heading","level":2,"spans":[{"id":"spn-53967","text":"Session Goal"}]},{"id":"blk-46403","kind":"paragraph","spans":[{"id":"spn-53968","text":"Implement P2 capabilities: "},{"id":"spn-53969","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-53970","text":", "},{"id":"spn-53971","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-53972","text":", and "},{"id":"spn-53973","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-53974","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-46404","kind":"heading","level":2,"spans":[{"id":"spn-53975","text":"Active Goal"}]},{"id":"blk-46405","kind":"paragraph","spans":[{"id":"spn-53976","text":"Retrieve and update: "},{"id":"spn-53977","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-46406","kind":"paragraph","spans":[{"id":"spn-53978","text":"---"}]},{"id":"blk-46407","kind":"heading","level":2,"spans":[{"id":"spn-53979","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-46408","kind":"heading","level":3,"spans":[{"id":"spn-53980","text":"What it does"}]},{"id":"blk-46409","kind":"paragraph","spans":[{"id":"spn-53981","text":"Adds "},{"id":"spn-53982","marks":["code"],"text":"evidence_count"},{"id":"spn-53983","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-53984","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-53985","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-46410","kind":"heading","level":3,"spans":[{"id":"spn-53986","text":"Why scoped (not universal)"}]},{"id":"blk-46411","kind":"paragraph","spans":[{"id":"spn-53987","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-53988","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-53989","text":" or "},{"id":"spn-53990","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-53991","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-46412","kind":"heading","level":3,"spans":[{"id":"spn-53992","text":"Research basis"}]},{"id":"blk-46413","kind":"paragraph","spans":[{"id":"spn-53993","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-46414","kind":"heading","level":3,"spans":[{"id":"spn-53994","text":"Schema migration"}]},{"id":"blk-46415","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-46416","kind":"heading","level":3,"spans":[{"id":"spn-53995","text":"New file: "},{"id":"spn-53996","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-46417","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-46418","kind":"heading","level":3,"spans":[{"id":"spn-53997","text":"New MCP tool"}]},{"id":"blk-46419","items":[{"blocks":[{"id":"blk-46421","kind":"paragraph","spans":[{"id":"spn-53998","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-53999","text":" — "},{"id":"spn-54000","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-46420","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46422","kind":"paragraph","spans":[{"id":"spn-54001","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-46423","kind":"heading","level":3,"spans":[{"id":"spn-54002","text":"Integration points"}]},{"id":"blk-46424","kind":"paragraph","spans":[{"id":"spn-54003","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-54004","text":" In "},{"id":"spn-54005","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-54006","text":" and "},{"id":"spn-54007","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-54008","text":": increment "},{"id":"spn-54009","marks":["code"],"text":"evidence_count"},{"id":"spn-54010","text":" on causal nodes."}]},{"id":"blk-46425","kind":"paragraph","spans":[{"id":"spn-54011","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-54012","text":" Replace "},{"id":"spn-54013","marks":["code"],"text":"uncertainty_score"},{"id":"spn-54014","text":" heuristic with "},{"id":"spn-54015","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-54016","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-46426","kind":"paragraph","spans":[{"id":"spn-54017","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-54018","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-46427","kind":"heading","level":3,"spans":[{"id":"spn-54019","text":"Tests"}]},{"id":"blk-46428","items":[{"blocks":[{"id":"blk-46430","kind":"paragraph","spans":[{"id":"spn-54020","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-46429","kind":"list-item"},{"blocks":[{"id":"blk-46432","kind":"paragraph","spans":[{"id":"spn-54021","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-46431","kind":"list-item"},{"blocks":[{"id":"blk-46434","kind":"paragraph","spans":[{"id":"spn-54022","text":"Node with evidence_count=0 → returns "},{"id":"spn-54023","marks":["code"],"text":":no_evidence"}]}],"id":"blk-46433","kind":"list-item"},{"blocks":[{"id":"blk-46436","kind":"paragraph","spans":[{"id":"spn-54024","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-46435","kind":"list-item"},{"blocks":[{"id":"blk-46438","kind":"paragraph","spans":[{"id":"spn-54025","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-46437","kind":"list-item"},{"blocks":[{"id":"blk-46440","kind":"paragraph","spans":[{"id":"spn-54026","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-46439","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46441","kind":"paragraph","spans":[{"id":"spn-54027","text":"---"}]},{"id":"blk-46442","kind":"heading","level":2,"spans":[{"id":"spn-54028","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-46443","kind":"heading","level":3,"spans":[{"id":"spn-54029","text":"What it does"}]},{"id":"blk-46444","kind":"paragraph","spans":[{"id":"spn-54030","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-54031","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-54032","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-46445","kind":"heading","level":3,"spans":[{"id":"spn-54033","text":"Why metadata-only (not full composition)"}]},{"id":"blk-46446","kind":"paragraph","spans":[{"id":"spn-54034","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-46447","kind":"heading","level":3,"spans":[{"id":"spn-54035","text":"Research basis"}]},{"id":"blk-46448","kind":"paragraph","spans":[{"id":"spn-54036","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-46449","kind":"heading","level":3,"spans":[{"id":"spn-54037","text":"Schema note"}]},{"id":"blk-46450","kind":"paragraph","spans":[{"id":"spn-54038","text":"No migration needed — use existing "},{"id":"spn-54039","marks":["code"],"text":"metadata"},{"id":"spn-54040","text":" JSON field on nodes:"}]},{"id":"blk-46451","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-46452","kind":"heading","level":3,"spans":[{"id":"spn-54041","text":"File: "},{"id":"spn-54042","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-46453","kind":"paragraph","spans":[{"id":"spn-54043","text":"Enhance "},{"id":"spn-54044","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-54045","text":" to support precondition matching:"}]},{"id":"blk-46454","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-46455","kind":"heading","level":3,"spans":[{"id":"spn-54046","text":"File: "},{"id":"spn-54047","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-46456","kind":"paragraph","spans":[{"id":"spn-54048","text":"When "},{"id":"spn-54049","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-54050","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-46457","kind":"heading","level":3,"spans":[{"id":"spn-54051","text":"File: "},{"id":"spn-54052","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-46458","kind":"paragraph","spans":[{"id":"spn-54053","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-46459","kind":"heading","level":3,"spans":[{"id":"spn-54054","text":"Modify "},{"id":"spn-54055","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-54056","text":" MCP tool"}]},{"id":"blk-46460","kind":"paragraph","spans":[{"id":"spn-54057","text":"Add optional "},{"id":"spn-54058","marks":["code"],"text":"preconditions"},{"id":"spn-54059","text":" parameter:"}]},{"id":"blk-46461","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-46462","kind":"heading","level":3,"spans":[{"id":"spn-54060","text":"Tests"}]},{"id":"blk-46463","items":[{"blocks":[{"id":"blk-46465","kind":"paragraph","spans":[{"id":"spn-54061","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-46464","kind":"list-item"},{"blocks":[{"id":"blk-46467","kind":"paragraph","spans":[{"id":"spn-54062","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-46466","kind":"list-item"},{"blocks":[{"id":"blk-46469","kind":"paragraph","spans":[{"id":"spn-54063","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-46468","kind":"list-item"},{"blocks":[{"id":"blk-46471","kind":"paragraph","spans":[{"id":"spn-54064","text":"Skill metadata survives consolidation"}]}],"id":"blk-46470","kind":"list-item"},{"blocks":[{"id":"blk-46473","kind":"paragraph","spans":[{"id":"spn-54065","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-46472","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46474","kind":"paragraph","spans":[{"id":"spn-54066","text":"---"}]},{"id":"blk-46475","kind":"heading","level":2,"spans":[{"id":"spn-54067","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-46476","kind":"heading","level":3,"spans":[{"id":"spn-54068","text":"What it does"}]},{"id":"blk-46477","kind":"paragraph","spans":[{"id":"spn-54069","text":"Adds "},{"id":"spn-54070","marks":["code"],"text":"agent_id"},{"id":"spn-54071","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-46478","kind":"heading","level":3,"spans":[{"id":"spn-54072","text":"Schema migration"}]},{"id":"blk-46479","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-46480","kind":"heading","level":3,"spans":[{"id":"spn-54073","text":"File: "},{"id":"spn-54074","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-46481","kind":"paragraph","spans":[{"id":"spn-54075","text":"Add "},{"id":"spn-54076","marks":["code"],"text":"agent_id"},{"id":"spn-54077","text":" to the Node struct with default "},{"id":"spn-54078","marks":["code"],"text":"\"default\""},{"id":"spn-54079","text":"."}]},{"id":"blk-46482","kind":"heading","level":3,"spans":[{"id":"spn-54080","text":"File: "},{"id":"spn-54081","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-46483","kind":"paragraph","spans":[{"id":"spn-54082","text":"Add "},{"id":"spn-54083","marks":["code"],"text":"agent_id"},{"id":"spn-54084","text":" to the Edge struct with default "},{"id":"spn-54085","marks":["code"],"text":"\"default\""},{"id":"spn-54086","text":"."}]},{"id":"blk-46484","kind":"heading","level":3,"spans":[{"id":"spn-54087","text":"File: "},{"id":"spn-54088","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-46485","items":[{"blocks":[{"id":"blk-46487","kind":"paragraph","spans":[{"id":"spn-54089","text":"Include "},{"id":"spn-54090","marks":["code"],"text":"agent_id"},{"id":"spn-54091","text":" in INSERT statements"}]}],"id":"blk-46486","kind":"list-item"},{"blocks":[{"id":"blk-46489","kind":"paragraph","spans":[{"id":"spn-54092","text":"Add "},{"id":"spn-54093","marks":["code"],"text":"agent_id"},{"id":"spn-54094","text":" to SELECT result mapping"}]}],"id":"blk-46488","kind":"list-item"},{"blocks":[{"id":"blk-46491","kind":"paragraph","spans":[{"id":"spn-54095","text":"Add "},{"id":"spn-54096","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-54097","text":" query (for future use)"}]}],"id":"blk-46490","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46492","kind":"heading","level":3,"spans":[{"id":"spn-54098","text":"Tests"}]},{"id":"blk-46493","items":[{"blocks":[{"id":"blk-46495","kind":"paragraph","spans":[{"id":"spn-54099","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-46494","kind":"list-item"},{"blocks":[{"id":"blk-46497","kind":"paragraph","spans":[{"id":"spn-54100","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-46496","kind":"list-item"},{"blocks":[{"id":"blk-46499","kind":"paragraph","spans":[{"id":"spn-54101","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-46498","kind":"list-item"},{"blocks"