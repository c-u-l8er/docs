{"bendscript":"0.1","blocks":[{"id":"blk-45414","kind":"heading","level":1,"spans":[{"id":"spn-51660","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-45415","kind":"heading","level":2,"spans":[{"id":"spn-51661","text":"Prerequisites"}]},{"id":"blk-45416","kind":"paragraph","spans":[{"id":"spn-51662","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-45417","items":[{"blocks":[{"id":"blk-45419","kind":"paragraph","spans":[{"id":"spn-51663","text":"[ ] "},{"id":"spn-51664","marks":["code"],"text":"mix test"},{"id":"spn-51665","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-45418","kind":"list-item"},{"blocks":[{"id":"blk-45421","kind":"paragraph","spans":[{"id":"spn-51666","text":"[ ] "},{"id":"spn-51667","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-51668","text":" — 40/40 pass"}]}],"id":"blk-45420","kind":"list-item"},{"blocks":[{"id":"blk-45423","kind":"paragraph","spans":[{"id":"spn-51669","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-45422","kind":"list-item"},{"blocks":[{"id":"blk-45425","kind":"paragraph","spans":[{"id":"spn-51670","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-45424","kind":"list-item"},{"blocks":[{"id":"blk-45427","kind":"paragraph","spans":[{"id":"spn-51671","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-45426","kind":"list-item"},{"blocks":[{"id":"blk-45429","kind":"paragraph","spans":[{"id":"spn-51672","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-45428","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45430","kind":"heading","level":2,"spans":[{"id":"spn-51673","text":"Session Goal"}]},{"id":"blk-45431","kind":"paragraph","spans":[{"id":"spn-51674","text":"Implement P2 capabilities: "},{"id":"spn-51675","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-51676","text":", "},{"id":"spn-51677","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-51678","text":", and "},{"id":"spn-51679","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-51680","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-45432","kind":"heading","level":2,"spans":[{"id":"spn-51681","text":"Active Goal"}]},{"id":"blk-45433","kind":"paragraph","spans":[{"id":"spn-51682","text":"Retrieve and update: "},{"id":"spn-51683","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-45434","kind":"paragraph","spans":[{"id":"spn-51684","text":"---"}]},{"id":"blk-45435","kind":"heading","level":2,"spans":[{"id":"spn-51685","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-45436","kind":"heading","level":3,"spans":[{"id":"spn-51686","text":"What it does"}]},{"id":"blk-45437","kind":"paragraph","spans":[{"id":"spn-51687","text":"Adds "},{"id":"spn-51688","marks":["code"],"text":"evidence_count"},{"id":"spn-51689","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-51690","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-51691","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-45438","kind":"heading","level":3,"spans":[{"id":"spn-51692","text":"Why scoped (not universal)"}]},{"id":"blk-45439","kind":"paragraph","spans":[{"id":"spn-51693","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-51694","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-51695","text":" or "},{"id":"spn-51696","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-51697","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-45440","kind":"heading","level":3,"spans":[{"id":"spn-51698","text":"Research basis"}]},{"id":"blk-45441","kind":"paragraph","spans":[{"id":"spn-51699","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-45442","kind":"heading","level":3,"spans":[{"id":"spn-51700","text":"Schema migration"}]},{"id":"blk-45443","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-45444","kind":"heading","level":3,"spans":[{"id":"spn-51701","text":"New file: "},{"id":"spn-51702","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-45445","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-45446","kind":"heading","level":3,"spans":[{"id":"spn-51703","text":"New MCP tool"}]},{"id":"blk-45447","items":[{"blocks":[{"id":"blk-45449","kind":"paragraph","spans":[{"id":"spn-51704","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-51705","text":" — "},{"id":"spn-51706","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-45448","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45450","kind":"paragraph","spans":[{"id":"spn-51707","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-45451","kind":"heading","level":3,"spans":[{"id":"spn-51708","text":"Integration points"}]},{"id":"blk-45452","kind":"paragraph","spans":[{"id":"spn-51709","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-51710","text":" In "},{"id":"spn-51711","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-51712","text":" and "},{"id":"spn-51713","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-51714","text":": increment "},{"id":"spn-51715","marks":["code"],"text":"evidence_count"},{"id":"spn-51716","text":" on causal nodes."}]},{"id":"blk-45453","kind":"paragraph","spans":[{"id":"spn-51717","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-51718","text":" Replace "},{"id":"spn-51719","marks":["code"],"text":"uncertainty_score"},{"id":"spn-51720","text":" heuristic with "},{"id":"spn-51721","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-51722","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-45454","kind":"paragraph","spans":[{"id":"spn-51723","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-51724","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-45455","kind":"heading","level":3,"spans":[{"id":"spn-51725","text":"Tests"}]},{"id":"blk-45456","items":[{"blocks":[{"id":"blk-45458","kind":"paragraph","spans":[{"id":"spn-51726","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-45457","kind":"list-item"},{"blocks":[{"id":"blk-45460","kind":"paragraph","spans":[{"id":"spn-51727","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-45459","kind":"list-item"},{"blocks":[{"id":"blk-45462","kind":"paragraph","spans":[{"id":"spn-51728","text":"Node with evidence_count=0 → returns "},{"id":"spn-51729","marks":["code"],"text":":no_evidence"}]}],"id":"blk-45461","kind":"list-item"},{"blocks":[{"id":"blk-45464","kind":"paragraph","spans":[{"id":"spn-51730","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-45463","kind":"list-item"},{"blocks":[{"id":"blk-45466","kind":"paragraph","spans":[{"id":"spn-51731","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-45465","kind":"list-item"},{"blocks":[{"id":"blk-45468","kind":"paragraph","spans":[{"id":"spn-51732","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-45467","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45469","kind":"paragraph","spans":[{"id":"spn-51733","text":"---"}]},{"id":"blk-45470","kind":"heading","level":2,"spans":[{"id":"spn-51734","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-45471","kind":"heading","level":3,"spans":[{"id":"spn-51735","text":"What it does"}]},{"id":"blk-45472","kind":"paragraph","spans":[{"id":"spn-51736","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-51737","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51738","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-45473","kind":"heading","level":3,"spans":[{"id":"spn-51739","text":"Why metadata-only (not full composition)"}]},{"id":"blk-45474","kind":"paragraph","spans":[{"id":"spn-51740","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-45475","kind":"heading","level":3,"spans":[{"id":"spn-51741","text":"Research basis"}]},{"id":"blk-45476","kind":"paragraph","spans":[{"id":"spn-51742","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-45477","kind":"heading","level":3,"spans":[{"id":"spn-51743","text":"Schema note"}]},{"id":"blk-45478","kind":"paragraph","spans":[{"id":"spn-51744","text":"No migration needed — use existing "},{"id":"spn-51745","marks":["code"],"text":"metadata"},{"id":"spn-51746","text":" JSON field on nodes:"}]},{"id":"blk-45479","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-45480","kind":"heading","level":3,"spans":[{"id":"spn-51747","text":"File: "},{"id":"spn-51748","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45481","kind":"paragraph","spans":[{"id":"spn-51749","text":"Enhance "},{"id":"spn-51750","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51751","text":" to support precondition matching:"}]},{"id":"blk-45482","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-45483","kind":"heading","level":3,"spans":[{"id":"spn-51752","text":"File: "},{"id":"spn-51753","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-45484","kind":"paragraph","spans":[{"id":"spn-51754","text":"When "},{"id":"spn-51755","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-51756","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-45485","kind":"heading","level":3,"spans":[{"id":"spn-51757","text":"File: "},{"id":"spn-51758","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45486","kind":"paragraph","spans":[{"id":"spn-51759","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-45487","kind":"heading","level":3,"spans":[{"id":"spn-51760","text":"Modify "},{"id":"spn-51761","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-51762","text":" MCP tool"}]},{"id":"blk-45488","kind":"paragraph","spans":[{"id":"spn-51763","text":"Add optional "},{"id":"spn-51764","marks":["code"],"text":"preconditions"},{"id":"spn-51765","text":" parameter:"}]},{"id":"blk-45489","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-45490","kind":"heading","level":3,"spans":[{"id":"spn-51766","text":"Tests"}]},{"id":"blk-45491","items":[{"blocks":[{"id":"blk-45493","kind":"paragraph","spans":[{"id":"spn-51767","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-45492","kind":"list-item"},{"blocks":[{"id":"blk-45495","kind":"paragraph","spans":[{"id":"spn-51768","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-45494","kind":"list-item"},{"blocks":[{"id":"blk-45497","kind":"paragraph","spans":[{"id":"spn-51769","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-45496","kind":"list-item"},{"blocks":[{"id":"blk-45499","kind":"paragraph","spans":[{"id":"spn-51770","text":"Skill metadata survives consolidation"}]}],"id":"blk-45498","kind":"list-item"},{"blocks":[{"id":"blk-45501","kind":"paragraph","spans":[{"id":"spn-51771","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-45500","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45502","kind":"paragraph","spans":[{"id":"spn-51772","text":"---"}]},{"id":"blk-45503","kind":"heading","level":2,"spans":[{"id":"spn-51773","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-45504","kind":"heading","level":3,"spans":[{"id":"spn-51774","text":"What it does"}]},{"id":"blk-45505","kind":"paragraph","spans":[{"id":"spn-51775","text":"Adds "},{"id":"spn-51776","marks":["code"],"text":"agent_id"},{"id":"spn-51777","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-45506","kind":"heading","level":3,"spans":[{"id":"spn-51778","text":"Schema migration"}]},{"id":"blk-45507","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-45508","kind":"heading","level":3,"spans":[{"id":"spn-51779","text":"File: "},{"id":"spn-51780","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-45509","kind":"paragraph","spans":[{"id":"spn-51781","text":"Add "},{"id":"spn-51782","marks":["code"],"text":"agent_id"},{"id":"spn-51783","text":" to the Node struct with default "},{"id":"spn-51784","marks":["code"],"text":"\"default\""},{"id":"spn-51785","text":"."}]},{"id":"blk-45510","kind":"heading","level":3,"spans":[{"id":"spn-51786","text":"File: "},{"id":"spn-51787","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-45511","kind":"paragraph","spans":[{"id":"spn-51788","text":"Add "},{"id":"spn-51789","marks":["code"],"text":"agent_id"},{"id":"spn-51790","text":" to the Edge struct with default "},{"id":"spn-51791","marks":["code"],"text":"\"default\""},{"id":"spn-51792","text":"."}]},{"id":"blk-45512","kind":"heading","level":3,"spans":[{"id":"spn-51793","text":"File: "},{"id":"spn-51794","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-45513","items":[{"blocks":[{"id":"blk-45515","kind":"paragraph","spans":[{"id":"spn-51795","text":"Include "},{"id":"spn-51796","marks":["code"],"text":"agent_id"},{"id":"spn-51797","text":" in INSERT statements"}]}],"id":"blk-45514","kind":"list-item"},{"blocks":[{"id":"blk-45517","kind":"paragraph","spans":[{"id":"spn-51798","text":"Add "},{"id":"spn-51799","marks":["code"],"text":"agent_id"},{"id":"spn-51800","text":" to SELECT result mapping"}]}],"id":"blk-45516","kind":"list-item"},{"blocks":[{"id":"blk-45519","kind":"paragraph","spans":[{"id":"spn-51801","text":"Add "},{"id":"spn-51802","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-51803","text":" query (for future use)"}]}],"id":"blk-45518","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45520","kind":"heading","level":3,"spans":[{"id":"spn-51804","text":"Tests"}]},{"id":"blk-45521","items":[{"blocks":[{"id":"blk-45523","kind":"paragraph","spans":[{"id":"spn-51805","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-45522","kind":"list-item"},{"blocks":[{"id":"blk-45525","kind":"paragraph","spans":[{"id":"spn-51806","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-45524","kind":"list-item"},{"blocks":[{"id":"blk-45527","kind":"paragraph","spans":[{"id":"spn-51807","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-45526","kind":"list-item"},{"blocks"