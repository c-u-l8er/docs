{"bendscript":"0.1","blocks":[{"id":"blk-71463","kind":"heading","level":1,"spans":[{"id":"spn-104304","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-71464","kind":"heading","level":2,"spans":[{"id":"spn-104305","text":"Prerequisites"}]},{"id":"blk-71465","kind":"paragraph","spans":[{"id":"spn-104306","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-71466","items":[{"blocks":[{"id":"blk-71468","kind":"paragraph","spans":[{"id":"spn-104307","text":"[ ] "},{"id":"spn-104308","marks":["code"],"text":"mix test"},{"id":"spn-104309","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-71467","kind":"list-item"},{"blocks":[{"id":"blk-71470","kind":"paragraph","spans":[{"id":"spn-104310","text":"[ ] "},{"id":"spn-104311","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-104312","text":" — 40/40 pass"}]}],"id":"blk-71469","kind":"list-item"},{"blocks":[{"id":"blk-71472","kind":"paragraph","spans":[{"id":"spn-104313","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-71471","kind":"list-item"},{"blocks":[{"id":"blk-71474","kind":"paragraph","spans":[{"id":"spn-104314","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-71473","kind":"list-item"},{"blocks":[{"id":"blk-71476","kind":"paragraph","spans":[{"id":"spn-104315","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-71475","kind":"list-item"},{"blocks":[{"id":"blk-71478","kind":"paragraph","spans":[{"id":"spn-104316","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-71477","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71479","kind":"heading","level":2,"spans":[{"id":"spn-104317","text":"Session Goal"}]},{"id":"blk-71480","kind":"paragraph","spans":[{"id":"spn-104318","text":"Implement P2 capabilities: "},{"id":"spn-104319","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-104320","text":", "},{"id":"spn-104321","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-104322","text":", and "},{"id":"spn-104323","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-104324","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-71481","kind":"heading","level":2,"spans":[{"id":"spn-104325","text":"Active Goal"}]},{"id":"blk-71482","kind":"paragraph","spans":[{"id":"spn-104326","text":"Retrieve and update: "},{"id":"spn-104327","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-71483","kind":"heading","level":2,"spans":[{"id":"spn-104328","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-71484","kind":"heading","level":3,"spans":[{"id":"spn-104329","text":"What it does"}]},{"id":"blk-71485","kind":"paragraph","spans":[{"id":"spn-104330","text":"Adds "},{"id":"spn-104331","marks":["code"],"text":"evidence_count"},{"id":"spn-104332","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-104333","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-104334","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-71486","kind":"heading","level":3,"spans":[{"id":"spn-104335","text":"Why scoped (not universal)"}]},{"id":"blk-71487","kind":"paragraph","spans":[{"id":"spn-104336","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-104337","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-104338","text":" or "},{"id":"spn-104339","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-104340","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-71488","kind":"heading","level":3,"spans":[{"id":"spn-104341","text":"Research basis"}]},{"id":"blk-71489","kind":"paragraph","spans":[{"id":"spn-104342","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-71490","kind":"heading","level":3,"spans":[{"id":"spn-104343","text":"Schema migration"}]},{"id":"blk-71491","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-71492","kind":"heading","level":3,"spans":[{"id":"spn-104344","text":"New file: "},{"id":"spn-104345","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-71493","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-71494","kind":"heading","level":3,"spans":[{"id":"spn-104346","text":"New MCP tool"}]},{"id":"blk-71495","items":[{"blocks":[{"id":"blk-71497","kind":"paragraph","spans":[{"id":"spn-104347","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-104348","text":" — "},{"id":"spn-104349","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-71496","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71498","kind":"paragraph","spans":[{"id":"spn-104350","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-71499","kind":"heading","level":3,"spans":[{"id":"spn-104351","text":"Integration points"}]},{"id":"blk-71500","kind":"paragraph","spans":[{"id":"spn-104352","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-104353","text":" In "},{"id":"spn-104354","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-104355","text":" and "},{"id":"spn-104356","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-104357","text":": increment "},{"id":"spn-104358","marks":["code"],"text":"evidence_count"},{"id":"spn-104359","text":" on causal nodes."}]},{"id":"blk-71501","kind":"paragraph","spans":[{"id":"spn-104360","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-104361","text":" Replace "},{"id":"spn-104362","marks":["code"],"text":"uncertainty_score"},{"id":"spn-104363","text":" heuristic with "},{"id":"spn-104364","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-104365","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-71502","kind":"paragraph","spans":[{"id":"spn-104366","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-104367","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-71503","kind":"heading","level":3,"spans":[{"id":"spn-104368","text":"Tests"}]},{"id":"blk-71504","items":[{"blocks":[{"id":"blk-71506","kind":"paragraph","spans":[{"id":"spn-104369","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-71505","kind":"list-item"},{"blocks":[{"id":"blk-71508","kind":"paragraph","spans":[{"id":"spn-104370","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-71507","kind":"list-item"},{"blocks":[{"id":"blk-71510","kind":"paragraph","spans":[{"id":"spn-104371","text":"Node with evidence_count=0 → returns "},{"id":"spn-104372","marks":["code"],"text":":no_evidence"}]}],"id":"blk-71509","kind":"list-item"},{"blocks":[{"id":"blk-71512","kind":"paragraph","spans":[{"id":"spn-104373","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-71511","kind":"list-item"},{"blocks":[{"id":"blk-71514","kind":"paragraph","spans":[{"id":"spn-104374","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-71513","kind":"list-item"},{"blocks":[{"id":"blk-71516","kind":"paragraph","spans":[{"id":"spn-104375","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-71515","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71517","kind":"heading","level":2,"spans":[{"id":"spn-104376","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-71518","kind":"heading","level":3,"spans":[{"id":"spn-104377","text":"What it does"}]},{"id":"blk-71519","kind":"paragraph","spans":[{"id":"spn-104378","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-104379","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-104380","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-71520","kind":"heading","level":3,"spans":[{"id":"spn-104381","text":"Why metadata-only (not full composition)"}]},{"id":"blk-71521","kind":"paragraph","spans":[{"id":"spn-104382","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-71522","kind":"heading","level":3,"spans":[{"id":"spn-104383","text":"Research basis"}]},{"id":"blk-71523","kind":"paragraph","spans":[{"id":"spn-104384","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-71524","kind":"heading","level":3,"spans":[{"id":"spn-104385","text":"Schema note"}]},{"id":"blk-71525","kind":"paragraph","spans":[{"id":"spn-104386","text":"No migration needed — use existing "},{"id":"spn-104387","marks":["code"],"text":"metadata"},{"id":"spn-104388","text":" JSON field on nodes:"}]},{"id":"blk-71526","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-71527","kind":"heading","level":3,"spans":[{"id":"spn-104389","text":"File: "},{"id":"spn-104390","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-71528","kind":"paragraph","spans":[{"id":"spn-104391","text":"Enhance "},{"id":"spn-104392","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-104393","text":" to support precondition matching:"}]},{"id":"blk-71529","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-71530","kind":"heading","level":3,"spans":[{"id":"spn-104394","text":"File: "},{"id":"spn-104395","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-71531","kind":"paragraph","spans":[{"id":"spn-104396","text":"When "},{"id":"spn-104397","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-104398","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-71532","kind":"heading","level":3,"spans":[{"id":"spn-104399","text":"File: "},{"id":"spn-104400","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-71533","kind":"paragraph","spans":[{"id":"spn-104401","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-71534","kind":"heading","level":3,"spans":[{"id":"spn-104402","text":"Modify "},{"id":"spn-104403","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-104404","text":" MCP tool"}]},{"id":"blk-71535","kind":"paragraph","spans":[{"id":"spn-104405","text":"Add optional "},{"id":"spn-104406","marks":["code"],"text":"preconditions"},{"id":"spn-104407","text":" parameter:"}]},{"id":"blk-71536","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-71537","kind":"heading","level":3,"spans":[{"id":"spn-104408","text":"Tests"}]},{"id":"blk-71538","items":[{"blocks":[{"id":"blk-71540","kind":"paragraph","spans":[{"id":"spn-104409","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-71539","kind":"list-item"},{"blocks":[{"id":"blk-71542","kind":"paragraph","spans":[{"id":"spn-104410","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-71541","kind":"list-item"},{"blocks":[{"id":"blk-71544","kind":"paragraph","spans":[{"id":"spn-104411","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-71543","kind":"list-item"},{"blocks":[{"id":"blk-71546","kind":"paragraph","spans":[{"id":"spn-104412","text":"Skill metadata survives consolidation"}]}],"id":"blk-71545","kind":"list-item"},{"blocks":[{"id":"blk-71548","kind":"paragraph","spans":[{"id":"spn-104413","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-71547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71549","kind":"heading","level":2,"spans":[{"id":"spn-104414","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-71550","kind":"heading","level":3,"spans":[{"id":"spn-104415","text":"What it does"}]},{"id":"blk-71551","kind":"paragraph","spans":[{"id":"spn-104416","text":"Adds "},{"id":"spn-104417","marks":["code"],"text":"agent_id"},{"id":"spn-104418","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-71552","kind":"heading","level":3,"spans":[{"id":"spn-104419","text":"Schema migration"}]},{"id":"blk-71553","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-71554","kind":"heading","level":3,"spans":[{"id":"spn-104420","text":"File: "},{"id":"spn-104421","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-71555","kind":"paragraph","spans":[{"id":"spn-104422","text":"Add "},{"id":"spn-104423","marks":["code"],"text":"agent_id"},{"id":"spn-104424","text":" to the Node struct with default "},{"id":"spn-104425","marks":["code"],"text":"\"default\""},{"id":"spn-104426","text":"."}]},{"id":"blk-71556","kind":"heading","level":3,"spans":[{"id":"spn-104427","text":"File: "},{"id":"spn-104428","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-71557","kind":"paragraph","spans":[{"id":"spn-104429","text":"Add "},{"id":"spn-104430","marks":["code"],"text":"agent_id"},{"id":"spn-104431","text":" to the Edge struct with default "},{"id":"spn-104432","marks":["code"],"text":"\"default\""},{"id":"spn-104433","text":"."}]},{"id":"blk-71558","kind":"heading","level":3,"spans":[{"id":"spn-104434","text":"File: "},{"id":"spn-104435","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-71559","items":[{"blocks":[{"id":"blk-71561","kind":"paragraph","spans":[{"id":"spn-104436","text":"Include "},{"id":"spn-104437","marks":["code"],"text":"agent_id"},{"id":"spn-104438","text":" in INSERT statements"}]}],"id":"blk-71560","kind":"list-item"},{"blocks":[{"id":"blk-71563","kind":"paragraph","spans":[{"id":"spn-104439","text":"Add "},{"id":"spn-104440","marks":["code"],"text":"agent_id"},{"id":"spn-104441","text":" to SELECT result mapping"}]}],"id":"blk-71562","kind":"list-item"},{"blocks":[{"id":"blk-71565","kind":"paragraph","spans":[{"id":"spn-104442","text":"Add "},{"id":"spn-104443","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-104444","text":" query (for future use)"}]}],"id":"blk-71564","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71566","kind":"heading","level":3,"spans":[{"id":"spn-104445","text":"Tests"}]},{"id":"blk-71567","items":[{"blocks":[{"id":"blk-71569","kind":"paragraph","spans":[{"id":"spn-104446","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-71568","kind":"list-item"},{"blocks":[{"id":"blk-71571","kind":"paragraph","spans":[{"id":"spn-104447","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-71570","kind":"list-item"},{"blocks":[{"id":"blk-71573","kind":"paragraph","spans":[{"id":"spn-104448","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-71572","kind":"list-item"},{"blocks":[{"id":"blk-71575","kind":"paragraph","spans":[{"id":"spn-104449","text":"Existing behavior un