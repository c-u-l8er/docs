{"bendscript":"0.1","blocks":[{"id":"blk-78610","kind":"heading","level":1,"spans":[{"id":"spn-142041","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-78611","kind":"heading","level":2,"spans":[{"id":"spn-142042","text":"Prerequisites"}]},{"id":"blk-78612","kind":"paragraph","spans":[{"id":"spn-142043","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-78613","items":[{"blocks":[{"id":"blk-78615","kind":"paragraph","spans":[{"id":"spn-142044","text":"[ ] "},{"id":"spn-142045","marks":["code"],"text":"mix test"},{"id":"spn-142046","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-78614","kind":"list-item"},{"blocks":[{"id":"blk-78617","kind":"paragraph","spans":[{"id":"spn-142047","text":"[ ] "},{"id":"spn-142048","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-142049","text":" — 40/40 pass"}]}],"id":"blk-78616","kind":"list-item"},{"blocks":[{"id":"blk-78619","kind":"paragraph","spans":[{"id":"spn-142050","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-78618","kind":"list-item"},{"blocks":[{"id":"blk-78621","kind":"paragraph","spans":[{"id":"spn-142051","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-78620","kind":"list-item"},{"blocks":[{"id":"blk-78623","kind":"paragraph","spans":[{"id":"spn-142052","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-78622","kind":"list-item"},{"blocks":[{"id":"blk-78625","kind":"paragraph","spans":[{"id":"spn-142053","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-78624","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78626","kind":"heading","level":2,"spans":[{"id":"spn-142054","text":"Session Goal"}]},{"id":"blk-78627","kind":"paragraph","spans":[{"id":"spn-142055","text":"Implement P2 capabilities: "},{"id":"spn-142056","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-142057","text":", "},{"id":"spn-142058","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-142059","text":", and "},{"id":"spn-142060","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-142061","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-78628","kind":"heading","level":2,"spans":[{"id":"spn-142062","text":"Active Goal"}]},{"id":"blk-78629","kind":"paragraph","spans":[{"id":"spn-142063","text":"Retrieve and update: "},{"id":"spn-142064","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-78630","kind":"heading","level":2,"spans":[{"id":"spn-142065","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-78631","kind":"heading","level":3,"spans":[{"id":"spn-142066","text":"What it does"}]},{"id":"blk-78632","kind":"paragraph","spans":[{"id":"spn-142067","text":"Adds "},{"id":"spn-142068","marks":["code"],"text":"evidence_count"},{"id":"spn-142069","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-142070","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-142071","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-78633","kind":"heading","level":3,"spans":[{"id":"spn-142072","text":"Why scoped (not universal)"}]},{"id":"blk-78634","kind":"paragraph","spans":[{"id":"spn-142073","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-142074","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-142075","text":" or "},{"id":"spn-142076","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-142077","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-78635","kind":"heading","level":3,"spans":[{"id":"spn-142078","text":"Research basis"}]},{"id":"blk-78636","kind":"paragraph","spans":[{"id":"spn-142079","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-78637","kind":"heading","level":3,"spans":[{"id":"spn-142080","text":"Schema migration"}]},{"id":"blk-78638","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-78639","kind":"heading","level":3,"spans":[{"id":"spn-142081","text":"New file: "},{"id":"spn-142082","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-78640","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-78641","kind":"heading","level":3,"spans":[{"id":"spn-142083","text":"New MCP tool"}]},{"id":"blk-78642","items":[{"blocks":[{"id":"blk-78644","kind":"paragraph","spans":[{"id":"spn-142084","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-142085","text":" — "},{"id":"spn-142086","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-78643","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78645","kind":"paragraph","spans":[{"id":"spn-142087","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-78646","kind":"heading","level":3,"spans":[{"id":"spn-142088","text":"Integration points"}]},{"id":"blk-78647","kind":"paragraph","spans":[{"id":"spn-142089","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-142090","text":" In "},{"id":"spn-142091","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-142092","text":" and "},{"id":"spn-142093","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-142094","text":": increment "},{"id":"spn-142095","marks":["code"],"text":"evidence_count"},{"id":"spn-142096","text":" on causal nodes."}]},{"id":"blk-78648","kind":"paragraph","spans":[{"id":"spn-142097","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-142098","text":" Replace "},{"id":"spn-142099","marks":["code"],"text":"uncertainty_score"},{"id":"spn-142100","text":" heuristic with "},{"id":"spn-142101","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-142102","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-78649","kind":"paragraph","spans":[{"id":"spn-142103","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-142104","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-78650","kind":"heading","level":3,"spans":[{"id":"spn-142105","text":"Tests"}]},{"id":"blk-78651","items":[{"blocks":[{"id":"blk-78653","kind":"paragraph","spans":[{"id":"spn-142106","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-78652","kind":"list-item"},{"blocks":[{"id":"blk-78655","kind":"paragraph","spans":[{"id":"spn-142107","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-78654","kind":"list-item"},{"blocks":[{"id":"blk-78657","kind":"paragraph","spans":[{"id":"spn-142108","text":"Node with evidence_count=0 → returns "},{"id":"spn-142109","marks":["code"],"text":":no_evidence"}]}],"id":"blk-78656","kind":"list-item"},{"blocks":[{"id":"blk-78659","kind":"paragraph","spans":[{"id":"spn-142110","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-78658","kind":"list-item"},{"blocks":[{"id":"blk-78661","kind":"paragraph","spans":[{"id":"spn-142111","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-78660","kind":"list-item"},{"blocks":[{"id":"blk-78663","kind":"paragraph","spans":[{"id":"spn-142112","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-78662","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78664","kind":"heading","level":2,"spans":[{"id":"spn-142113","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-78665","kind":"heading","level":3,"spans":[{"id":"spn-142114","text":"What it does"}]},{"id":"blk-78666","kind":"paragraph","spans":[{"id":"spn-142115","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-142116","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-142117","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-78667","kind":"heading","level":3,"spans":[{"id":"spn-142118","text":"Why metadata-only (not full composition)"}]},{"id":"blk-78668","kind":"paragraph","spans":[{"id":"spn-142119","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-78669","kind":"heading","level":3,"spans":[{"id":"spn-142120","text":"Research basis"}]},{"id":"blk-78670","kind":"paragraph","spans":[{"id":"spn-142121","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-78671","kind":"heading","level":3,"spans":[{"id":"spn-142122","text":"Schema note"}]},{"id":"blk-78672","kind":"paragraph","spans":[{"id":"spn-142123","text":"No migration needed — use existing "},{"id":"spn-142124","marks":["code"],"text":"metadata"},{"id":"spn-142125","text":" JSON field on nodes:"}]},{"id":"blk-78673","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-78674","kind":"heading","level":3,"spans":[{"id":"spn-142126","text":"File: "},{"id":"spn-142127","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-78675","kind":"paragraph","spans":[{"id":"spn-142128","text":"Enhance "},{"id":"spn-142129","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-142130","text":" to support precondition matching:"}]},{"id":"blk-78676","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-78677","kind":"heading","level":3,"spans":[{"id":"spn-142131","text":"File: "},{"id":"spn-142132","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-78678","kind":"paragraph","spans":[{"id":"spn-142133","text":"When "},{"id":"spn-142134","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-142135","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-78679","kind":"heading","level":3,"spans":[{"id":"spn-142136","text":"File: "},{"id":"spn-142137","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-78680","kind":"paragraph","spans":[{"id":"spn-142138","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-78681","kind":"heading","level":3,"spans":[{"id":"spn-142139","text":"Modify "},{"id":"spn-142140","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-142141","text":" MCP tool"}]},{"id":"blk-78682","kind":"paragraph","spans":[{"id":"spn-142142","text":"Add optional "},{"id":"spn-142143","marks":["code"],"text":"preconditions"},{"id":"spn-142144","text":" parameter:"}]},{"id":"blk-78683","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-78684","kind":"heading","level":3,"spans":[{"id":"spn-142145","text":"Tests"}]},{"id":"blk-78685","items":[{"blocks":[{"id":"blk-78687","kind":"paragraph","spans":[{"id":"spn-142146","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-78686","kind":"list-item"},{"blocks":[{"id":"blk-78689","kind":"paragraph","spans":[{"id":"spn-142147","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-78688","kind":"list-item"},{"blocks":[{"id":"blk-78691","kind":"paragraph","spans":[{"id":"spn-142148","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-78690","kind":"list-item"},{"blocks":[{"id":"blk-78693","kind":"paragraph","spans":[{"id":"spn-142149","text":"Skill metadata survives consolidation"}]}],"id":"blk-78692","kind":"list-item"},{"blocks":[{"id":"blk-78695","kind":"paragraph","spans":[{"id":"spn-142150","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-78694","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78696","kind":"heading","level":2,"spans":[{"id":"spn-142151","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-78697","kind":"heading","level":3,"spans":[{"id":"spn-142152","text":"What it does"}]},{"id":"blk-78698","kind":"paragraph","spans":[{"id":"spn-142153","text":"Adds "},{"id":"spn-142154","marks":["code"],"text":"agent_id"},{"id":"spn-142155","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-78699","kind":"heading","level":3,"spans":[{"id":"spn-142156","text":"Schema migration"}]},{"id":"blk-78700","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-78701","kind":"heading","level":3,"spans":[{"id":"spn-142157","text":"File: "},{"id":"spn-142158","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-78702","kind":"paragraph","spans":[{"id":"spn-142159","text":"Add "},{"id":"spn-142160","marks":["code"],"text":"agent_id"},{"id":"spn-142161","text":" to the Node struct with default "},{"id":"spn-142162","marks":["code"],"text":"\"default\""},{"id":"spn-142163","text":"."}]},{"id":"blk-78703","kind":"heading","level":3,"spans":[{"id":"spn-142164","text":"File: "},{"id":"spn-142165","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-78704","kind":"paragraph","spans":[{"id":"spn-142166","text":"Add "},{"id":"spn-142167","marks":["code"],"text":"agent_id"},{"id":"spn-142168","text":" to the Edge struct with default "},{"id":"spn-142169","marks":["code"],"text":"\"default\""},{"id":"spn-142170","text":"."}]},{"id":"blk-78705","kind":"heading","level":3,"spans":[{"id":"spn-142171","text":"File: "},{"id":"spn-142172","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-78706","items":[{"blocks":[{"id":"blk-78708","kind":"paragraph","spans":[{"id":"spn-142173","text":"Include "},{"id":"spn-142174","marks":["code"],"text":"agent_id"},{"id":"spn-142175","text":" in INSERT statements"}]}],"id":"blk-78707","kind":"list-item"},{"blocks":[{"id":"blk-78710","kind":"paragraph","spans":[{"id":"spn-142176","text":"Add "},{"id":"spn-142177","marks":["code"],"text":"agent_id"},{"id":"spn-142178","text":" to SELECT result mapping"}]}],"id":"blk-78709","kind":"list-item"},{"blocks":[{"id":"blk-78712","kind":"paragraph","spans":[{"id":"spn-142179","text":"Add "},{"id":"spn-142180","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-142181","text":" query (for future use)"}]}],"id":"blk-78711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78713","kind":"heading","level":3,"spans":[{"id":"spn-142182","text":"Tests"}]},{"id":"blk-78714","items":[{"blocks":[{"id":"blk-78716","kind":"paragraph","spans":[{"id":"spn-142183","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-78715","kind":"list-item"},{"blocks":[{"id":"blk-78718","kind":"paragraph","spans":[{"id":"spn-142184","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-78717","kind":"list-item"},{"blocks":[{"id":"blk-78720","kind":"paragraph","spans":[{"id":"spn-142185","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-78719","kind":"list-item"},{"blocks":[{"id":"blk-78722","kind":"paragraph","spans":[{"id":"spn-142186","text":"Existing behavior un