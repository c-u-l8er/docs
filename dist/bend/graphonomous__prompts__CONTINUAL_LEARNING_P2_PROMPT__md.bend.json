{"bendscript":"0.1","blocks":[{"id":"blk-45900","kind":"heading","level":1,"spans":[{"id":"spn-52834","text":"Graphonomous v0.3 — P2 Implementation Prompt (Week 5+)"}]},{"id":"blk-45901","kind":"heading","level":2,"spans":[{"id":"spn-52835","text":"Prerequisites"}]},{"id":"blk-45902","kind":"paragraph","spans":[{"id":"spn-52836","text":"P0 and P1 must be complete before starting P2. Verify:"}]},{"id":"blk-45903","items":[{"blocks":[{"id":"blk-45905","kind":"paragraph","spans":[{"id":"spn-52837","text":"[ ] "},{"id":"spn-52838","marks":["code"],"text":"mix test"},{"id":"spn-52839","text":" passes (all existing + P0 + P1 tests)"}]}],"id":"blk-45904","kind":"list-item"},{"blocks":[{"id":"blk-45907","kind":"paragraph","spans":[{"id":"spn-52840","text":"[ ] "},{"id":"spn-52841","marks":["code"],"text":"mix benchmark.capability_spec"},{"id":"spn-52842","text":" — 40/40 pass"}]}],"id":"blk-45906","kind":"list-item"},{"blocks":[{"id":"blk-45909","kind":"paragraph","spans":[{"id":"spn-52843","text":"[ ] LongMemEval SHR >= 90.4% with two-phase retrieval"}]}],"id":"blk-45908","kind":"list-item"},{"blocks":[{"id":"blk-45911","kind":"paragraph","spans":[{"id":"spn-52844","text":"[ ] kappa > 0 activates on real queries"}]}],"id":"blk-45910","kind":"list-item"},{"blocks":[{"id":"blk-45913","kind":"paragraph","spans":[{"id":"spn-52845","text":"[ ] Forgetting respects memory budget"}]}],"id":"blk-45912","kind":"list-item"},{"blocks":[{"id":"blk-45915","kind":"paragraph","spans":[{"id":"spn-52846","text":"[ ] Goal progress at 0.5"}]}],"id":"blk-45914","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45916","kind":"heading","level":2,"spans":[{"id":"spn-52847","text":"Session Goal"}]},{"id":"blk-45917","kind":"paragraph","spans":[{"id":"spn-52848","text":"Implement P2 capabilities: "},{"id":"spn-52849","marks":["bold"],"text":"scoped uncertainty propagation"},{"id":"spn-52850","text":", "},{"id":"spn-52851","marks":["bold"],"text":"procedural metadata + enhanced retrieval"},{"id":"spn-52852","text":", and "},{"id":"spn-52853","marks":["bold"],"text":"multi-agent schema prep"},{"id":"spn-52854","text":". These are lower-priority capabilities that serve future portfolio products (AgenTroMatic, FleetPrompt, GeoFleetic) while improving current Graphonomous quality."}]},{"id":"blk-45918","kind":"heading","level":2,"spans":[{"id":"spn-52855","text":"Active Goal"}]},{"id":"blk-45919","kind":"paragraph","spans":[{"id":"spn-52856","text":"Retrieve and update: "},{"id":"spn-52857","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"}]},{"id":"blk-45920","kind":"paragraph","spans":[{"id":"spn-52858","text":"---"}]},{"id":"blk-45921","kind":"heading","level":2,"spans":[{"id":"spn-52859","text":"Capability 8: Scoped Uncertainty Propagation (3 days)"}]},{"id":"blk-45922","kind":"heading","level":3,"spans":[{"id":"spn-52860","text":"What it does"}]},{"id":"blk-45923","kind":"paragraph","spans":[{"id":"spn-52861","text":"Adds "},{"id":"spn-52862","marks":["code"],"text":"evidence_count"},{"id":"spn-52863","text":" to nodes. For nodes with outcome/feedback signals (evidence_count > 0), computes Wilson score confidence intervals instead of point estimates. Propagates uncertainty through edges: nodes derived from uncertain parents inherit wider intervals. New "},{"id":"spn-52864","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-52865","text":" query returns nodes where investigation would most reduce uncertainty."}]},{"id":"blk-45924","kind":"heading","level":3,"spans":[{"id":"spn-52866","text":"Why scoped (not universal)"}]},{"id":"blk-45925","kind":"paragraph","spans":[{"id":"spn-52867","text":"Most nodes come from file ingestion — they're either current or stale, not \"uncertain.\" Interval confidence only makes sense for nodes that have been tested against reality via "},{"id":"spn-52868","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-52869","text":" or "},{"id":"spn-52870","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-52871","text":". This avoids the complexity of interval math on 27K+ ingested file nodes."}]},{"id":"blk-45926","kind":"heading","level":3,"spans":[{"id":"spn-52872","text":"Research basis"}]},{"id":"blk-45927","kind":"paragraph","spans":[{"id":"spn-52873","text":"UQ position paper (arxiv 2505.22655) — point estimates conflate \"I'm 70% sure\" with \"I have no idea.\" Wilson score intervals (used in Reddit's ranking algorithm) provide principled intervals from binary success/failure counts."}]},{"id":"blk-45928","kind":"heading","level":3,"spans":[{"id":"spn-52874","text":"Schema migration"}]},{"id":"blk-45929","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN evidence_count INTEGER DEFAULT 0;"},{"id":"blk-45930","kind":"heading","level":3,"spans":[{"id":"spn-52875","text":"New file: "},{"id":"spn-52876","marks":["code"],"text":"graphonomous/lib/graphonomous/uncertainty.ex"}]},{"id":"blk-45931","kind":"code","language":"elixir","text":"defmodule Graphonomous.Uncertainty do\n  @moduledoc \"\"\"\n  Uncertainty quantification for outcome-bearing nodes.\n  Uses Wilson score intervals for confidence bounds.\n  Only applies to nodes with evidence_count > 0.\n  \"\"\"\n\n  @type interval :: {lower :: float(), upper :: float()}\n\n  def interval(%{evidence_count: 0}), do: :no_evidence\n  def interval(%{confidence: c, evidence_count: n}) do\n    # Wilson score interval at 95% confidence (z = 1.96)\n    z = 1.96\n    phat = c\n    denom = 1 + z * z / n\n    center = (phat + z * z / (2 * n)) / denom\n    spread = z * :math.sqrt((phat * (1 - phat) + z * z / (4 * n)) / n) / denom\n    {max(0.0, center - spread), min(1.0, center + spread)}\n  end\n\n  def propagate(node_id)\n  # Walk :derived_from and :supports edges outward.\n  # For each child: if parent interval is wider than child's, widen child's.\n  # Widening factor: child_width = max(child_width, parent_width * edge_weight)\n\n  def frontier(opts \\\\ [])\n  # Return nodes where: evidence_count > 0 AND interval width > min_gap\n  # Sorted by information_gain (widest intervals with highest access_count first)\n  # These are the nodes where one more outcome would most narrow uncertainty.\n\n  def entropy(%{confidence: c, evidence_count: 0}), do: 1.0  # Maximum uncertainty\n  def entropy(node) do\n    {lo, hi} = interval(node)\n    hi - lo  # Simple width as entropy proxy\n  end\n\n  def information_gain(node) do\n    # Expected interval narrowing from one additional evidence point\n    current = entropy(node)\n    projected = interval(%{node | evidence_count: node.evidence_count + 1})\n    case projected do\n      :no_evidence -> 0.0\n      {lo, hi} -> current - (hi - lo)\n    end\n  end\nend"},{"id":"blk-45932","kind":"heading","level":3,"spans":[{"id":"spn-52877","text":"New MCP tool"}]},{"id":"blk-45933","items":[{"blocks":[{"id":"blk-45935","kind":"paragraph","spans":[{"id":"spn-52878","marks":["code"],"text":"epistemic_frontier"},{"id":"spn-52879","text":" — "},{"id":"spn-52880","marks":["code"],"text":"{min_gap: float (default 0.3), limit: integer (default 10)}"}]}],"id":"blk-45934","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45936","kind":"paragraph","spans":[{"id":"spn-52881","text":"Returns nodes with widest intervals, sorted by information gain."}]},{"id":"blk-45937","kind":"heading","level":3,"spans":[{"id":"spn-52882","text":"Integration points"}]},{"id":"blk-45938","kind":"paragraph","spans":[{"id":"spn-52883","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/learner.ex`"},{"id":"spn-52884","text":" In "},{"id":"spn-52885","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-52886","text":" and "},{"id":"spn-52887","marks":["code"],"text":"learn_from_feedback"},{"id":"spn-52888","text":": increment "},{"id":"spn-52889","marks":["code"],"text":"evidence_count"},{"id":"spn-52890","text":" on causal nodes."}]},{"id":"blk-45939","kind":"paragraph","spans":[{"id":"spn-52891","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/coverage.ex`"},{"id":"spn-52892","text":" Replace "},{"id":"spn-52893","marks":["code"],"text":"uncertainty_score"},{"id":"spn-52894","text":" heuristic with "},{"id":"spn-52895","marks":["code"],"text":"Uncertainty.entropy/1"},{"id":"spn-52896","text":" averaged over retrieved nodes with evidence. For nodes without evidence, use the existing heuristic (they're file-ingested, not tested)."}]},{"id":"blk-45940","kind":"paragraph","spans":[{"id":"spn-52897","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/attention.ex`"},{"id":"spn-52898","text":" Add frontier nodes to survey: high-information-gain nodes with wide intervals are candidates for \"investigate further\" attention items."}]},{"id":"blk-45941","kind":"heading","level":3,"spans":[{"id":"spn-52899","text":"Tests"}]},{"id":"blk-45942","items":[{"blocks":[{"id":"blk-45944","kind":"paragraph","spans":[{"id":"spn-52900","text":"Node with confidence=0.7, evidence_count=1 → wide interval ~[0.35, 0.93]"}]}],"id":"blk-45943","kind":"list-item"},{"blocks":[{"id":"blk-45946","kind":"paragraph","spans":[{"id":"spn-52901","text":"Same node after 10 successful outcomes → narrow interval ~[0.60, 0.80]"}]}],"id":"blk-45945","kind":"list-item"},{"blocks":[{"id":"blk-45948","kind":"paragraph","spans":[{"id":"spn-52902","text":"Node with evidence_count=0 → returns "},{"id":"spn-52903","marks":["code"],"text":":no_evidence"}]}],"id":"blk-45947","kind":"list-item"},{"blocks":[{"id":"blk-45950","kind":"paragraph","spans":[{"id":"spn-52904","text":"Propagation: parent with wide interval → child inherits wider interval"}]}],"id":"blk-45949","kind":"list-item"},{"blocks":[{"id":"blk-45952","kind":"paragraph","spans":[{"id":"spn-52905","text":"Frontier returns widest-interval nodes sorted by information gain"}]}],"id":"blk-45951","kind":"list-item"},{"blocks":[{"id":"blk-45954","kind":"paragraph","spans":[{"id":"spn-52906","text":"Coverage uses entropy for evidence-bearing nodes, heuristic for others"}]}],"id":"blk-45953","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45955","kind":"paragraph","spans":[{"id":"spn-52907","text":"---"}]},{"id":"blk-45956","kind":"heading","level":2,"spans":[{"id":"spn-52908","text":"Capability 9: Procedural Metadata + Enhanced Retrieval (3 days)"}]},{"id":"blk-45957","kind":"heading","level":3,"spans":[{"id":"spn-52909","text":"What it does"}]},{"id":"blk-45958","kind":"paragraph","spans":[{"id":"spn-52910","text":"Adds structured metadata to procedural nodes (preconditions, postconditions, parameters, domain) without building a full skill composition engine. Enhances "},{"id":"spn-52911","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-52912","text":" to match by preconditions AND semantic similarity. Makes procedures discoverable by what they need and what they produce."}]},{"id":"blk-45959","kind":"heading","level":3,"spans":[{"id":"spn-52913","text":"Why metadata-only (not full composition)"}]},{"id":"blk-45960","kind":"paragraph","spans":[{"id":"spn-52914","text":"Agentelic and FleetPrompt (the primary consumers of skill composition) are spec-only. The main beneficiary today is Claude Code using Graphonomous MCP tools. Structured metadata + enhanced retrieval gives 80% of the value at 20% of the effort. Composition engine deferred until FleetPrompt ships."}]},{"id":"blk-45961","kind":"heading","level":3,"spans":[{"id":"spn-52915","text":"Research basis"}]},{"id":"blk-45962","kind":"paragraph","spans":[{"id":"spn-52916","text":"Agent KB (TechRxiv 2025) shows 51-78% procedure reuse rates when procedures are well-indexed. Voyager's skill library pattern works because procedures are semantically searchable."}]},{"id":"blk-45963","kind":"heading","level":3,"spans":[{"id":"spn-52917","text":"Schema note"}]},{"id":"blk-45964","kind":"paragraph","spans":[{"id":"spn-52918","text":"No migration needed — use existing "},{"id":"spn-52919","marks":["code"],"text":"metadata"},{"id":"spn-52920","text":" JSON field on nodes:"}]},{"id":"blk-45965","kind":"code","language":"json","text":"{\n  \"skill\": {\n    \"preconditions\": [\"has_git_repo\", \"has_test_suite\"],\n    \"postconditions\": [\"tests_passing\", \"code_formatted\"],\n    \"parameters\": [{\"name\": \"branch\", \"type\": \"string\", \"default\": \"main\"}],\n    \"domain\": \"software_development\",\n    \"success_rate\": 0.85,\n    \"usage_count\": 12\n  }\n}"},{"id":"blk-45966","kind":"heading","level":3,"spans":[{"id":"spn-52921","text":"File: "},{"id":"spn-52922","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"}]},{"id":"blk-45967","kind":"paragraph","spans":[{"id":"spn-52923","text":"Enhance "},{"id":"spn-52924","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-52925","text":" to support precondition matching:"}]},{"id":"blk-45968","kind":"code","language":"elixir","text":"def retrieve_procedural(query, opts) do\n  # Existing: semantic similarity search scoped to procedural nodes\n  semantic_results = existing_procedural_retrieval(query, opts)\n\n  # NEW: If opts[:preconditions] provided, boost nodes whose preconditions match\n  case Keyword.get(opts, :preconditions) do\n    nil -> semantic_results\n    required_preconds ->\n      semantic_results\n      |> Enum.map(fn result ->\n        node_preconds = get_in(result.metadata, [\"skill\", \"preconditions\"]) || []\n        match_score = precondition_match_score(required_preconds, node_preconds)\n        %{result | score: result.score * (1.0 + match_score)}\n      end)\n      |> Enum.sort_by(& &1.score, :desc)\n  end\nend\n\ndefp precondition_match_score(required, available) do\n  return 0.0 if required == [] or available == []\n  matched = Enum.count(required, &(&1 in available))\n  matched / length(required)  # 0.0 to 1.0\nend"},{"id":"blk-45969","kind":"heading","level":3,"spans":[{"id":"spn-52926","text":"File: "},{"id":"spn-52927","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-45970","kind":"paragraph","spans":[{"id":"spn-52928","text":"When "},{"id":"spn-52929","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-52930","text":" stores a procedural node, auto-extract skill metadata if the content contains structured indicators (e.g., \"Prerequisites:\", \"Steps:\", \"Result:\")."}]},{"id":"blk-45971","kind":"heading","level":3,"spans":[{"id":"spn-52931","text":"File: "},{"id":"spn-52932","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"}]},{"id":"blk-45972","kind":"paragraph","spans":[{"id":"spn-52933","text":"In Stage 7 (generate abstractions): when 3+ procedural nodes share similar postconditions (>60% overlap), note this in the generated abstraction's metadata as a composition candidate (but don't compose yet)."}]},{"id":"blk-45973","kind":"heading","level":3,"spans":[{"id":"spn-52934","text":"Modify "},{"id":"spn-52935","marks":["code"],"text":"retrieve_procedural"},{"id":"spn-52936","text":" MCP tool"}]},{"id":"blk-45974","kind":"paragraph","spans":[{"id":"spn-52937","text":"Add optional "},{"id":"spn-52938","marks":["code"],"text":"preconditions"},{"id":"spn-52939","text":" parameter:"}]},{"id":"blk-45975","kind":"code","language":"json","text":"{\n  \"name\": \"retrieve_procedural\",\n  \"parameters\": {\n    \"query\": \"string\",\n    \"preconditions\": \"JSON array of required precondition strings (optional)\",\n    \"limit\": \"integer\"\n  }\n}"},{"id":"blk-45976","kind":"heading","level":3,"spans":[{"id":"spn-52940","text":"Tests"}]},{"id":"blk-45977","items":[{"blocks":[{"id":"blk-45979","kind":"paragraph","spans":[{"id":"spn-52941","text":"Store procedural node with skill metadata → retrieve by precondition match"}]}],"id":"blk-45978","kind":"list-item"},{"blocks":[{"id":"blk-45981","kind":"paragraph","spans":[{"id":"spn-52942","text":"Precondition boosting: node matching 3/3 preconditions ranks above node matching 1/3"}]}],"id":"blk-45980","kind":"list-item"},{"blocks":[{"id":"blk-45983","kind":"paragraph","spans":[{"id":"spn-52943","text":"No preconditions provided → existing behavior unchanged"}]}],"id":"blk-45982","kind":"list-item"},{"blocks":[{"id":"blk-45985","kind":"paragraph","spans":[{"id":"spn-52944","text":"Skill metadata survives consolidation"}]}],"id":"blk-45984","kind":"list-item"},{"blocks":[{"id":"blk-45987","kind":"paragraph","spans":[{"id":"spn-52945","text":"Stage 7 identifies composition candidates but doesn't compose"}]}],"id":"blk-45986","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45988","kind":"paragraph","spans":[{"id":"spn-52946","text":"---"}]},{"id":"blk-45989","kind":"heading","level":2,"spans":[{"id":"spn-52947","text":"Capability 10: Multi-Agent Schema Prep (1 day)"}]},{"id":"blk-45990","kind":"heading","level":3,"spans":[{"id":"spn-52948","text":"What it does"}]},{"id":"blk-45991","kind":"paragraph","spans":[{"id":"spn-52949","text":"Adds "},{"id":"spn-52950","marks":["code"],"text":"agent_id"},{"id":"spn-52951","text":" to nodes and edges. This is schema-only — no behavioral changes. Prepares the data substrate for when AgenTroMatic, Delegatic, or FleetPrompt ship and need agent-scoped memory."}]},{"id":"blk-45992","kind":"heading","level":3,"spans":[{"id":"spn-52952","text":"Schema migration"}]},{"id":"blk-45993","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN agent_id TEXT DEFAULT 'default';\nALTER TABLE edges ADD COLUMN agent_id TEXT DEFAULT 'default';"},{"id":"blk-45994","kind":"heading","level":3,"spans":[{"id":"spn-52953","text":"File: "},{"id":"spn-52954","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"}]},{"id":"blk-45995","kind":"paragraph","spans":[{"id":"spn-52955","text":"Add "},{"id":"spn-52956","marks":["code"],"text":"agent_id"},{"id":"spn-52957","text":" to the Node struct with default "},{"id":"spn-52958","marks":["code"],"text":"\"default\""},{"id":"spn-52959","text":"."}]},{"id":"blk-45996","kind":"heading","level":3,"spans":[{"id":"spn-52960","text":"File: "},{"id":"spn-52961","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"}]},{"id":"blk-45997","kind":"paragraph","spans":[{"id":"spn-52962","text":"Add "},{"id":"spn-52963","marks":["code"],"text":"agent_id"},{"id":"spn-52964","text":" to the Edge struct with default "},{"id":"spn-52965","marks":["code"],"text":"\"default\""},{"id":"spn-52966","text":"."}]},{"id":"blk-45998","kind":"heading","level":3,"spans":[{"id":"spn-52967","text":"File: "},{"id":"spn-52968","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"}]},{"id":"blk-45999","items":[{"blocks":[{"id":"blk-46001","kind":"paragraph","spans":[{"id":"spn-52969","text":"Include "},{"id":"spn-52970","marks":["code"],"text":"agent_id"},{"id":"spn-52971","text":" in INSERT statements"}]}],"id":"blk-46000","kind":"list-item"},{"blocks":[{"id":"blk-46003","kind":"paragraph","spans":[{"id":"spn-52972","text":"Add "},{"id":"spn-52973","marks":["code"],"text":"agent_id"},{"id":"spn-52974","text":" to SELECT result mapping"}]}],"id":"blk-46002","kind":"list-item"},{"blocks":[{"id":"blk-46005","kind":"paragraph","spans":[{"id":"spn-52975","text":"Add "},{"id":"spn-52976","marks":["code"],"text":"list_nodes_by_agent(agent_id)"},{"id":"spn-52977","text":" query (for future use)"}]}],"id":"blk-46004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46006","kind":"heading","level":3,"spans":[{"id":"spn-52978","text":"Tests"}]},{"id":"blk-46007","items":[{"blocks":[{"id":"blk-46009","kind":"paragraph","spans":[{"id":"spn-52979","text":"Store node without agent_id → defaults to \"default\""}]}],"id":"blk-46008","kind":"list-item"},{"blocks":[{"id":"blk-46011","kind":"paragraph","spans":[{"id":"spn-52980","text":"Store node with agent_id → persists correctly"}]}],"id":"blk-46010","kind":"list-item"},{"blocks":[{"id":"blk-46013","kind":"paragraph","spans":[{"id":"spn-52981","text":"Query by agent_id returns only that agent's nodes"}]}],"id":"blk-46012","kind":"list-item"},{"blocks"