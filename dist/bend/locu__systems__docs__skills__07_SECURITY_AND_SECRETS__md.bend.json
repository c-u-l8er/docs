{"bendscript":"0.1","blocks":[{"id":"blk-83393","kind":"heading","level":1,"spans":[{"id":"spn-147861","text":"07 — Security and Secrets"}]},{"blocks":[{"id":"blk-83395","kind":"paragraph","spans":[{"id":"spn-147862","marks":["bold"],"text":"Purpose:"},{"id":"spn-147863","text":" Tenant isolation via RLS, encrypted secret storage via Supabase Vault, telemetry authentication, abuse prevention, supply chain validation, and audit logging requirements."}]}],"id":"blk-83394","kind":"quote"},{"id":"blk-83396","kind":"heading","level":2,"spans":[{"id":"spn-147864","text":"Tenant Isolation (RLS)"}]},{"id":"blk-83397","kind":"paragraph","spans":[{"id":"spn-147865","text":"Every table in the control plane database enforces Row-Level Security:"}]},{"id":"blk-83398","kind":"code","language":"sql","text":"-- Example: agents table policy\nCREATE POLICY \"users can only access own agents\"\n  ON agents\n  FOR ALL\n  USING (auth.uid() = user_id)\n  WITH CHECK (auth.uid() = user_id);"},{"id":"blk-83399","kind":"heading","level":3,"spans":[{"id":"spn-147866","text":"RLS Rules"}]},{"head":[{"id":"blk-83401","spans":[{"id":"spn-147867","text":"Table"}]},{"id":"blk-83402","spans":[{"id":"spn-147868","text":"Policy"}]}],"id":"blk-83400","kind":"table","rows":[[{"id":"blk-83403","spans":[{"id":"spn-147869","marks":["code"],"text":"users"}]},{"id":"blk-83404","spans":[{"id":"spn-147870","marks":["code"],"text":"auth.uid() = id"}]}],[{"id":"blk-83405","spans":[{"id":"spn-147871","marks":["code"],"text":"agents"}]},{"id":"blk-83406","spans":[{"id":"spn-147872","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-83407","spans":[{"id":"spn-147873","marks":["code"],"text":"deployments"}]},{"id":"blk-83408","spans":[{"id":"spn-147874","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-83409","spans":[{"id":"spn-147875","marks":["code"],"text":"metrics_events"}]},{"id":"blk-83410","spans":[{"id":"spn-147876","marks":["code"],"text":"auth.uid() = user_id"}]}],[{"id":"blk-83411","spans":[{"id":"spn-147877","marks":["code"],"text":"billing_usage"}]},{"id":"blk-83412","spans":[{"id":"spn-147878","marks":["code"],"text":"auth.uid() = user_id"}]}]]},{"id":"blk-83413","kind":"paragraph","spans":[{"id":"spn-147879","marks":["bold"],"text":"Hard rule:"},{"id":"spn-147880","text":" No table is accessible without an RLS policy. If a new table is added, an RLS policy must be created before any data is inserted."}]},{"id":"blk-83414","kind":"heading","level":3,"spans":[{"id":"spn-147881","text":"Provider Namespace Isolation"}]},{"id":"blk-83415","kind":"paragraph","spans":[{"id":"spn-147882","text":"Runtime provider resources are namespaced per user:"}]},{"id":"blk-83416","items":[{"blocks":[{"id":"blk-83418","kind":"paragraph","spans":[{"id":"spn-147883","text":"Cloudflare: Worker names include user ID prefix"}]}],"id":"blk-83417","kind":"list-item"},{"blocks":[{"id":"blk-83420","kind":"paragraph","spans":[{"id":"spn-147884","text":"AgentCore: Runtime resources tagged with user ID"}]}],"id":"blk-83419","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83421","kind":"heading","level":2,"spans":[{"id":"spn-147885","text":"Secrets Handling"}]},{"id":"blk-83422","kind":"heading","level":3,"spans":[{"id":"spn-147886","text":"Supabase Vault"}]},{"id":"blk-83423","kind":"paragraph","spans":[{"id":"spn-147887","text":"Secrets are stored in "},{"id":"spn-147888","marks":["bold"],"text":"Supabase Vault"},{"id":"spn-147889","text":" -- an encrypted key-value store built into Supabase. The primary database ("},{"id":"spn-147890","marks":["code"],"text":"agents"},{"id":"spn-147891","text":", "},{"id":"spn-147892","marks":["code"],"text":"deployments"},{"id":"spn-147893","text":", etc.) never contains plaintext secret values."}]},{"id":"blk-83424","kind":"code","language":"text","text":"User adds secret \"OPENAI_API_KEY\" via dashboard\n  -> Value encrypted and stored in Vault (vault.secrets)\n  -> agents.env_var_keys = [\"OPENAI_API_KEY\"] (key name only)"},{"id":"blk-83425","kind":"heading","level":3,"spans":[{"id":"spn-147894","text":"Secret Lifecycle"}]},{"id":"blk-83426","kind":"code","language":"text","text":"1. User creates secret via UI -> stored in Vault\n2. Deploy triggers -> Edge Function reads from Vault\n3. Secret pushed to provider mechanism:\n   - Cloudflare: Workers Secrets API\n   - AgentCore: Environment variable injection / Secrets Manager\n4. Vault reference remains; plaintext never logged"},{"id":"blk-83427","kind":"heading","level":3,"spans":[{"id":"spn-147895","text":"Secret Rotation"}]},{"id":"blk-83428","items":[{"blocks":[{"id":"blk-83430","kind":"paragraph","spans":[{"id":"spn-147896","text":"User updates secret value in Vault via dashboard"}]}],"id":"blk-83429","kind":"list-item"},{"blocks":[{"id":"blk-83432","kind":"paragraph","spans":[{"id":"spn-147897","text":"User triggers a re-deploy to push the new value to the provider"}]}],"id":"blk-83431","kind":"list-item"},{"blocks":[{"id":"blk-83434","kind":"paragraph","spans":[{"id":"spn-147898","text":"Old provider secret is overwritten"}]}],"id":"blk-83433","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-83435","kind":"paragraph","spans":[{"id":"spn-147899","marks":["bold"],"text":"Rule:"},{"id":"spn-147900","text":" Never log secret values. Never include secrets in error messages, telemetry events, or API responses."}]},{"id":"blk-83436","kind":"heading","level":2,"spans":[{"id":"spn-147901","text":"Telemetry Authentication"}]},{"id":"blk-83437","kind":"paragraph","spans":[{"id":"spn-147902","text":"The telemetry ingestion endpoint rejects unauthenticated events. See "},{"id":"spn-147903","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"},{"id":"spn-147904","text":" for HMAC and JWT details."}]},{"id":"blk-83438","kind":"paragraph","spans":[{"id":"spn-147905","text":"Key requirements:"}]},{"id":"blk-83439","items":[{"blocks":[{"id":"blk-83441","kind":"paragraph","spans":[{"id":"spn-147906","text":"[ ] Per-deployment signing key generated at deploy time"}]}],"id":"blk-83440","kind":"list-item"},{"blocks":[{"id":"blk-83443","kind":"paragraph","spans":[{"id":"spn-147907","text":"[ ] Signing key stored in Vault (not in the deployments table)"}]}],"id":"blk-83442","kind":"list-item"},{"blocks":[{"id":"blk-83445","kind":"paragraph","spans":[{"id":"spn-147908","text":"[ ] Anti-replay: timestamp within 5-minute window"}]}],"id":"blk-83444","kind":"list-item"},{"blocks":[{"id":"blk-83447","kind":"paragraph","spans":[{"id":"spn-147909","text":"[ ] Attribution verified against deployment records"}]}],"id":"blk-83446","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83448","kind":"heading","level":2,"spans":[{"id":"spn-147910","text":"Abuse Prevention"}]},{"id":"blk-83449","kind":"heading","level":3,"spans":[{"id":"spn-147911","text":"Rate Limiting"}]},{"head":[{"id":"blk-83451","spans":[{"id":"spn-147912","text":"Scope"}]},{"id":"blk-83452","spans":[{"id":"spn-147913","text":"Limit"}]}],"id":"blk-83450","kind":"table","rows":[[{"id":"blk-83453","spans":[{"id":"spn-147914","text":"Per-user, all agents"}]},{"id":"blk-83454","spans":[{"id":"spn-147915","text":"N requests/second (configurable)"}]}],[{"id":"blk-83455","spans":[{"id":"spn-147916","text":"Per-agent"}]},{"id":"blk-83456","spans":[{"id":"spn-147917","text":"M requests/second (configurable)"}]}],[{"id":"blk-83457","spans":[{"id":"spn-147918","text":"Payload size"}]},{"id":"blk-83458","spans":[{"id":"spn-147919","text":"Max 1 MB request body"}]}]]},{"id":"blk-83459","kind":"heading","level":3,"spans":[{"id":"spn-147920","text":"Input Validation"}]},{"id":"blk-83460","items":[{"blocks":[{"id":"blk-83462","kind":"paragraph","spans":[{"id":"spn-147921","text":"Reject oversized payloads before parsing"}]}],"id":"blk-83461","kind":"list-item"},{"blocks":[{"id":"blk-83464","kind":"paragraph","spans":[{"id":"spn-147922","text":"Validate JSON structure before processing"}]}],"id":"blk-83463","kind":"list-item"},{"blocks":[{"id":"blk-83466","kind":"paragraph","spans":[{"id":"spn-147923","text":"Prevent prompt bombing (excessively long message arrays)"}]}],"id":"blk-83465","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83467","kind":"heading","level":3,"spans":[{"id":"spn-147924","text":"Account-Level"}]},{"id":"blk-83468","items":[{"blocks":[{"id":"blk-83470","kind":"paragraph","spans":[{"id":"spn-147925","text":"Disable agent on repeated errors"}]}],"id":"blk-83469","kind":"list-item"},{"blocks":[{"id":"blk-83472","kind":"paragraph","spans":[{"id":"spn-147926","text":"Flag accounts with anomalous usage patterns"}]}],"id":"blk-83471","kind":"list-item"},{"blocks":[{"id":"blk-83474","kind":"paragraph","spans":[{"id":"spn-147927","text":"Hard-stop on plan limits (see "},{"id":"spn-147928","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"},{"id":"spn-147929","text":")"}]}],"id":"blk-83473","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83475","kind":"heading","level":2,"spans":[{"id":"spn-147930","text":"Supply Chain Validation"}]},{"id":"blk-83476","kind":"paragraph","spans":[{"id":"spn-147931","text":"Uploaded bundles must pass validation before deployment:"}]},{"head":[{"id":"blk-83478","spans":[{"id":"spn-147932","text":"Check"}]},{"id":"blk-83479","spans":[{"id":"spn-147933","text":"Rule"}]}],"id":"blk-83477","kind":"table","rows":[[{"id":"blk-83480","spans":[{"id":"spn-147934","text":"Size limit"}]},{"id":"blk-83481","spans":[{"id":"spn-147935","text":"Max compressed size (e.g., 50 MB)"}]}],[{"id":"blk-83482","spans":[{"id":"spn-147936","text":"File count"}]},{"id":"blk-83483","spans":[{"id":"spn-147937","text":"Max files (e.g., 10,000)"}]}],[{"id":"blk-83484","spans":[{"id":"spn-147938","text":"Path traversal"}]},{"id":"blk-83485","spans":[{"id":"spn-147939","text":"Reject entries with "},{"id":"spn-147940","marks":["code"],"text":"../"},{"id":"spn-147941","text":" or absolute paths"}]}],[{"id":"blk-83486","spans":[{"id":"spn-147942","text":"Symlinks"}]},{"id":"blk-83487","spans":[{"id":"spn-147943","text":"Reject unsafe symlinks"}]}],[{"id":"blk-83488","spans":[{"id":"spn-147944","text":"Required files"}]},{"id":"blk-83489","spans":[{"id":"spn-147945","marks":["code"],"text":"agent.config.json"},{"id":"spn-147946","text":" + entrypoint must exist"}]}],[{"id":"blk-83490","spans":[{"id":"spn-147947","text":"Manifest validity"}]},{"id":"blk-83491","spans":[{"id":"spn-147948","text":"JSON parses, required fields present"}]}]]},{"id":"blk-83492","kind":"paragraph","spans":[{"id":"spn-147949","text":"Post-MVP: dependency scanning for known vulnerabilities."}]},{"id":"blk-83493","kind":"heading","level":2,"spans":[{"id":"spn-147950","text":"Audit Log"}]},{"id":"blk-83494","kind":"paragraph","spans":[{"id":"spn-147951","text":"The platform SHOULD maintain an audit log for security-sensitive operations:"}]},{"head":[{"id":"blk-83496","spans":[{"id":"spn-147952","text":"Event"}]},{"id":"blk-83497","spans":[{"id":"spn-147953","text":"Fields"}]}],"id":"blk-83495","kind":"table","rows":[[{"id":"blk-83498","spans":[{"id":"spn-147954","text":"Agent created"}]},{"id":"blk-83499","spans":[{"id":"spn-147955","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-83500","spans":[{"id":"spn-147956","text":"Agent disabled"}]},{"id":"blk-83501","spans":[{"id":"spn-147957","text":"user_id, agent_id, timestamp"}]}],[{"id":"blk-83502","spans":[{"id":"spn-147958","text":"Deployment created"}]},{"id":"blk-83503","spans":[{"id":"spn-147959","text":"user_id, agent_id, deployment_id, timestamp"}]}],[{"id":"blk-83504","spans":[{"id":"spn-147960","text":"Secret created/rotated"}]},{"id":"blk-83505","spans":[{"id":"spn-147961","text":"user_id, secret_key (not value), timestamp"}]}],[{"id":"blk-83506","spans":[{"id":"spn-147962","text":"Tier changed"}]},{"id":"blk-83507","spans":[{"id":"spn-147963","text":"user_id, old_tier, new_tier, timestamp"}]}],[{"id":"blk-83508","spans":[{"id":"spn-147964","text":"Invocation rejected (limit)"}]},{"id":"blk-83509","spans":[{"id":"spn-147965","text":"user_id, agent_id, reason, timestamp"}]}]]},{"id":"blk-83510","kind":"paragraph","spans":[{"id":"spn-147966","text":"Audit log entries are append-only and retained for at least 90 days regardless of tier."}]},{"id":"blk-83511","kind":"heading","level":2,"spans":[{"id":"spn-147967","text":"Security Checklist"}]},{"id":"blk-83512","items":[{"blocks":[{"id":"blk-83514","kind":"paragraph","spans":[{"id":"spn-147968","text":"[ ] RLS policy exists on every table"}]}],"id":"blk-83513","kind":"list-item"},{"blocks":[{"id":"blk-83516","kind":"paragraph","spans":[{"id":"spn-147969","text":"[ ] No plaintext secrets in "},{"id":"spn-147970","marks":["code"],"text":"agents"},{"id":"spn-147971","text":", "},{"id":"spn-147972","marks":["code"],"text":"deployments"},{"id":"spn-147973","text":", or "},{"id":"spn-147974","marks":["code"],"text":"metrics_events"},{"id":"spn-147975","text":" tables"}]}],"id":"blk-83515","kind":"list-item"},{"blocks":[{"id":"blk-83518","kind":"paragraph","spans":[{"id":"spn-147976","text":"[ ] Secrets stored exclusively in Supabase Vault"}]}],"id":"blk-83517","kind":"list-item"},{"blocks":[{"id":"blk-83520","kind":"paragraph","spans":[{"id":"spn-147977","text":"[ ] Secret values never appear in logs, errors, or telemetry"}]}],"id":"blk-83519","kind":"list-item"},{"blocks":[{"id":"blk-83522","kind":"paragraph","spans":[{"id":"spn-147978","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-83521","kind":"list-item"},{"blocks":[{"id":"blk-83524","kind":"paragraph","spans":[{"id":"spn-147979","text":"[ ] Rate limiting is enforced per-user and per-agent"}]}],"id":"blk-83523","kind":"list-item"},{"blocks":[{"id":"blk-83526","kind":"paragraph","spans":[{"id":"spn-147980","text":"[ ] Uploaded bundles pass all supply chain validation checks"}]}],"id":"blk-83525","kind":"list-item"},{"blocks":[{"id":"blk-83528","kind":"paragraph","spans":[{"id":"spn-147981","text":"[ ] Provider resources are namespaced per user"}]}],"id":"blk-83527","kind":"list-item"},{"blocks":[{"id":"blk-83530","kind":"paragraph","spans":[{"id":"spn-147982","text":"[ ] Audit log captures security-sensitive operations"}]}],"id":"blk-83529","kind":"list-item"},{"blocks":[{"id":"blk-83532","kind":"paragraph","spans":[{"id":"spn-147983","text":"[ ] New tables require an RLS policy before first use"}]}],"id":"blk-83531","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieralefdcfldrlfi5o4y6vjk77u7typni5xd4mnvmmo7kuaxj2ddiuca","vocabulary":"ampersand.docs.fs.v1"}