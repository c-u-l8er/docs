{"bendscript":"0.1","blocks":[{"id":"blk-83649","kind":"heading","level":1,"spans":[{"id":"spn-148092","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-83651","kind":"paragraph","spans":[{"id":"spn-148093","marks":["bold"],"text":"Purpose:"},{"id":"spn-148094","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-83650","kind":"quote"},{"id":"blk-83652","kind":"heading","level":2,"spans":[{"id":"spn-148095","text":"1. Skipping RLS Policies"}]},{"id":"blk-83653","kind":"paragraph","spans":[{"id":"spn-148096","marks":["bold"],"text":"Mistake:"},{"id":"spn-148097","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-148098","marks":["code"],"text":"service_role"},{"id":"spn-148099","text":" key in client-side code."}]},{"id":"blk-83654","kind":"paragraph","spans":[{"id":"spn-148100","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148101","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-83655","kind":"paragraph","spans":[{"id":"spn-148102","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83656","items":[{"blocks":[{"id":"blk-83658","kind":"paragraph","spans":[{"id":"spn-148103","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-83657","kind":"list-item"},{"blocks":[{"id":"blk-83660","kind":"paragraph","spans":[{"id":"spn-148104","text":"Use "},{"id":"spn-148105","marks":["code"],"text":"anon"},{"id":"spn-148106","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-148107","marks":["code"],"text":"service_role"},{"id":"spn-148108","text":" for"}]}],"id":"blk-83659","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83661","kind":"paragraph","spans":[{"id":"spn-148109","text":"Edge Functions only."}]},{"id":"blk-83662","items":[{"blocks":[{"id":"blk-83664","kind":"paragraph","spans":[{"id":"spn-148110","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-83663","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83665","kind":"heading","level":2,"spans":[{"id":"spn-148111","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-83666","kind":"paragraph","spans":[{"id":"spn-148112","marks":["bold"],"text":"Mistake:"},{"id":"spn-148113","text":" Putting API keys or credentials directly in "},{"id":"spn-148114","marks":["code"],"text":"agents.provider_config"},{"id":"spn-148115","text":" or "},{"id":"spn-148116","marks":["code"],"text":"deployments.artifact"},{"id":"spn-148117","text":"."}]},{"id":"blk-83667","kind":"paragraph","spans":[{"id":"spn-148118","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148119","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-83668","kind":"paragraph","spans":[{"id":"spn-148120","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83669","items":[{"blocks":[{"id":"blk-83671","kind":"paragraph","spans":[{"id":"spn-148121","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-83670","kind":"list-item"},{"blocks":[{"id":"blk-83673","kind":"paragraph","spans":[{"id":"spn-148122","text":"Store only key names (not values) in "},{"id":"spn-148123","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-148124","text":"."}]}],"id":"blk-83672","kind":"list-item"},{"blocks":[{"id":"blk-83675","kind":"paragraph","spans":[{"id":"spn-148125","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-83674","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83676","kind":"paragraph","spans":[{"id":"spn-148126","text":"Manager) at deploy time."}]},{"id":"blk-83677","kind":"heading","level":2,"spans":[{"id":"spn-148127","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-83678","kind":"paragraph","spans":[{"id":"spn-148128","marks":["bold"],"text":"Mistake:"},{"id":"spn-148129","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-83679","kind":"paragraph","spans":[{"id":"spn-148130","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148131","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-83680","kind":"paragraph","spans":[{"id":"spn-148132","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83681","items":[{"blocks":[{"id":"blk-83683","kind":"paragraph","spans":[{"id":"spn-148133","text":"Deployments are append-only. Only "},{"id":"spn-148134","marks":["code"],"text":"status"},{"id":"spn-148135","text":" and "},{"id":"spn-148136","marks":["code"],"text":"error_message"},{"id":"spn-148137","text":" can be updated."}]}],"id":"blk-83682","kind":"list-item"},{"blocks":[{"id":"blk-83685","kind":"paragraph","spans":[{"id":"spn-148138","text":"To change code or config, create a new deployment."}]}],"id":"blk-83684","kind":"list-item"},{"blocks":[{"id":"blk-83687","kind":"paragraph","spans":[{"id":"spn-148139","text":"Rollback by switching "},{"id":"spn-148140","marks":["code"],"text":"active_deployment_id"},{"id":"spn-148141","text":", not by modifying old records."}]}],"id":"blk-83686","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83688","kind":"heading","level":2,"spans":[{"id":"spn-148142","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-83689","kind":"paragraph","spans":[{"id":"spn-148143","marks":["bold"],"text":"Mistake:"},{"id":"spn-148144","text":" Not checking for an existing "},{"id":"spn-148145","marks":["code"],"text":"deploying"},{"id":"spn-148146","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-83690","kind":"paragraph","spans":[{"id":"spn-148147","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148148","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-83691","kind":"paragraph","spans":[{"id":"spn-148149","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83692","items":[{"blocks":[{"id":"blk-83694","kind":"paragraph","spans":[{"id":"spn-148150","text":"Check for "},{"id":"spn-148151","marks":["code"],"text":"deploying"},{"id":"spn-148152","text":" status on the agent before creating a new deployment."}]}],"id":"blk-83693","kind":"list-item"},{"blocks":[{"id":"blk-83696","kind":"paragraph","spans":[{"id":"spn-148153","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-83695","kind":"list-item"},{"blocks":[{"id":"blk-83698","kind":"paragraph","spans":[{"id":"spn-148154","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-83697","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83699","kind":"heading","level":2,"spans":[{"id":"spn-148155","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-83700","kind":"paragraph","spans":[{"id":"spn-148156","marks":["bold"],"text":"Mistake:"},{"id":"spn-148157","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-83701","kind":"paragraph","spans":[{"id":"spn-148158","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148159","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-83702","kind":"paragraph","spans":[{"id":"spn-148160","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83703","items":[{"blocks":[{"id":"blk-83705","kind":"paragraph","spans":[{"id":"spn-148161","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-83704","kind":"list-item"},{"blocks":[{"id":"blk-83707","kind":"paragraph","spans":[{"id":"spn-148162","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-83706","kind":"list-item"},{"blocks":[{"id":"blk-83709","kind":"paragraph","spans":[{"id":"spn-148163","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-83708","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83710","kind":"heading","level":2,"spans":[{"id":"spn-148164","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-83711","kind":"paragraph","spans":[{"id":"spn-148165","marks":["bold"],"text":"Mistake:"},{"id":"spn-148166","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-83712","kind":"paragraph","spans":[{"id":"spn-148167","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148168","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-83713","kind":"paragraph","spans":[{"id":"spn-148169","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83714","items":[{"blocks":[{"id":"blk-83716","kind":"paragraph","spans":[{"id":"spn-148170","text":"Normalize all errors to the standard code set (see "},{"id":"spn-148171","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-148172","text":")."}]}],"id":"blk-83715","kind":"list-item"},{"blocks":[{"id":"blk-83718","kind":"paragraph","spans":[{"id":"spn-148173","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-83717","kind":"list-item"},{"blocks":[{"id":"blk-83720","kind":"paragraph","spans":[{"id":"spn-148174","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-83719","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83721","kind":"heading","level":2,"spans":[{"id":"spn-148175","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-83722","kind":"paragraph","spans":[{"id":"spn-148176","marks":["bold"],"text":"Mistake:"},{"id":"spn-148177","text":" Accepting "},{"id":"spn-148178","marks":["code"],"text":"user_id"},{"id":"spn-148179","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-83723","kind":"paragraph","spans":[{"id":"spn-148180","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148181","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-83724","kind":"paragraph","spans":[{"id":"spn-148182","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83725","items":[{"blocks":[{"id":"blk-83727","kind":"paragraph","spans":[{"id":"spn-148183","text":"Always derive "},{"id":"spn-148184","marks":["code"],"text":"user_id"},{"id":"spn-148185","text":" from "},{"id":"spn-148186","marks":["code"],"text":"auth.uid()"},{"id":"spn-148187","text":" (Supabase Auth JWT)."}]}],"id":"blk-83726","kind":"list-item"},{"blocks":[{"id":"blk-83729","kind":"paragraph","spans":[{"id":"spn-148188","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-83728","kind":"list-item"},{"blocks":[{"id":"blk-83731","kind":"paragraph","spans":[{"id":"spn-148189","text":"RLS policies enforce this at the database level."}]}],"id":"blk-83730","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83732","kind":"heading","level":2,"spans":[{"id":"spn-148190","text":"8. Skipping Bundle Validation"}]},{"id":"blk-83733","kind":"paragraph","spans":[{"id":"spn-148191","marks":["bold"],"text":"Mistake:"},{"id":"spn-148192","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-83734","kind":"paragraph","spans":[{"id":"spn-148193","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148194","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-83735","kind":"paragraph","spans":[{"id":"spn-148195","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83736","items":[{"blocks":[{"id":"blk-83738","kind":"paragraph","spans":[{"id":"spn-148196","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-83737","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83739","kind":"paragraph","spans":[{"id":"spn-148197","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-148198","text":"."}]},{"id":"blk-83740","items":[{"blocks":[{"id":"blk-83742","kind":"paragraph","spans":[{"id":"spn-148199","text":"Reject bundles with "},{"id":"spn-148200","marks":["code"],"text":"../"},{"id":"spn-148201","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-83741","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83743","kind":"paragraph","spans":[{"id":"spn-148202","marks":["code"],"text":"agent.config.json"},{"id":"spn-148203","text":"."}]},{"id":"blk-83744","items":[{"blocks":[{"id":"blk-83746","kind":"paragraph","spans":[{"id":"spn-148204","text":"Enforce size and file count limits."}]}],"id":"blk-83745","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83747","kind":"heading","level":2,"spans":[{"id":"spn-148205","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-83748","kind":"paragraph","spans":[{"id":"spn-148206","marks":["bold"],"text":"Mistake:"},{"id":"spn-148207","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-83749","kind":"paragraph","spans":[{"id":"spn-148208","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148209","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-83750","kind":"paragraph","spans":[{"id":"spn-148210","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83751","items":[{"blocks":[{"id":"blk-83753","kind":"paragraph","spans":[{"id":"spn-148211","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-83752","kind":"list-item"},{"blocks":[{"id":"blk-83755","kind":"paragraph","spans":[{"id":"spn-148212","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-83754","kind":"list-item"},{"blocks":[{"id":"blk-83757","kind":"paragraph","spans":[{"id":"spn-148213","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-83756","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83758","kind":"heading","level":2,"spans":[{"id":"spn-148214","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-83759","kind":"paragraph","spans":[{"id":"spn-148215","marks":["bold"],"text":"Mistake:"},{"id":"spn-148216","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-83760","kind":"paragraph","spans":[{"id":"spn-148217","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148218","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-83761","kind":"paragraph","spans":[{"id":"spn-148219","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83762","items":[{"blocks":[{"id":"blk-83764","kind":"paragraph","spans":[{"id":"spn-148220","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-83763","kind":"list-item"},{"blocks":[{"id":"blk-83766","kind":"paragraph","spans":[{"id":"spn-148221","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-83765","kind":"list-item"},{"blocks":[{"id":"blk-83768","kind":"paragraph","spans":[{"id":"spn-148222","text":"Test telemetry emission in integration tests."}]}],"id":"blk-83767","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83769","kind":"heading","level":2,"spans":[{"id":"spn-148223","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-83770","kind":"paragraph","spans":[{"id":"spn-148224","marks":["bold"],"text":"Mistake:"},{"id":"spn-148225","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-83771","kind":"paragraph","spans":[{"id":"spn-148226","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148227","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-83772","kind":"paragraph","spans":[{"id":"spn-148228","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83773","items":[{"blocks":[{"id":"blk-83775","kind":"paragraph","spans":[{"id":"spn-148229","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-83774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83776","kind":"paragraph","spans":[{"id":"spn-148230","text":"ingestion, billing webhooks."}]},{"id":"blk-83777","items":[{"blocks":[{"id":"blk-83779","kind":"paragraph","spans":[{"id":"spn-148231","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-83778","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83780","kind":"heading","level":2,"spans":[{"id":"spn-148232","text":"12. Circular A2A Delegation"}]},{"id":"blk-83781","kind":"paragraph","spans":[{"id":"spn-148233","marks":["bold"],"text":"Mistake:"},{"id":"spn-148234","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-83782","kind":"paragraph","spans":[{"id":"spn-148235","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-148236","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-83783","kind":"paragraph","spans":[{"id":"spn-148237","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-83784","items":[{"blocks":[{"id":"blk-83786","kind":"paragraph","spans":[{"id":"spn-148238","text":"Track "},{"id":"spn-148239","marks":["code"],"text":"delegation_depth"},{"id":"spn-148240","text":" in every A2A invocation."}]}],"id":"blk-83785","kind":"list-item"},{"blocks":[{"id":"blk-83788","kind":"paragraph","spans":[{"id":"spn-148241","text":"Enforce "},{"id":"spn-148242","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-148243","text":" from the governance policy."}]}],"id":"blk-83787","kind":"list-item"},{"blocks":[{"id":"blk-83790","kind":"paragraph","spans":[{"id":"spn-148244","text":"Detect and reject circular call chains."}]}],"id":"blk-83789","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83791","kind":"heading","level":2,"spans":[{"id":"spn-148245","text":"Summary Table"}]},{"head":[{"id":"blk-83793","spans":[{"id":"spn-148246","text":"#"}]},{"id":"blk-83794","spans":[{"id":"spn-148247","text":"Anti-Pattern"}]},{"id":"blk-83795","spans":[{"id":"spn-148248","text":"Severity"}]},{"id":"blk-83796","spans":[{"id":"spn-148249","text":"Fix Reference"}]}],"id":"blk-83792","kind":"table","rows":[[{"id":"blk-83797","spans":[{"id":"spn-148250","text":"1"}]},{"id":"blk-83798","spans":[{"id":"spn-148251","text":"Skipping RLS"}]},{"id":"blk-83799","spans":[{"id":"spn-148252","text":"Critical"}]},{"id":"blk-83800","spans":[{"id":"spn-148253","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-83801","spans":[{"id":"spn-148254","text":"2"}]},{"id":"blk-83802","spans":[{"id":"spn-148255","text":"Plaintext secrets"}]},{"id":"blk-83803","spans":[{"id":"spn-148256","text":"Critical"}]},{"id":"blk-83804","spans":[{"id":"spn-148257","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-83805","spans":[{"id":"spn-148258","text":"3"}]},{"id":"blk-83806","spans":[{"id":"spn-148259","text":"Mutable deployments"}]},{"id":"blk-83807","spans":[{"id":"spn-148260","text":"High"}]},{"id":"blk-83808","spans":[{"id":"spn-148261","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-83809","spans":[{"id":"spn-148262","text":"4"}]},{"id":"blk-83810","spans":[{"id":"spn-148263","text":"Concurrent deploys"}]},{"id":"blk-83811","spans":[{"id":"spn-148264","text":"High"}]},{"id":"blk-83812","spans":[{"id":"spn-148265","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-83813","spans":[{"id":"spn-148266","text":"5"}]},{"id":"blk-83814","spans":[{"id":"spn-148267","text":"Unauthenticated telemetry"}]},{"id":"blk-83815","spans":[{"id":"spn-148268","text":"High"}]},{"id":"blk-83816","spans":[{"id":"spn-148269","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-83817","spans":[{"id":"spn-148270","text":"6"}]},{"id":"blk-83818","spans":[{"id":"spn-148271","text":"Secret leaks in errors"}]},{"id":"blk-83819","spans":[{"id":"spn-148272","text":"High"}]},{"id":"blk-83820","spans":[{"id":"spn-148273","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-83821","spans":[{"id":"spn-148274","text":"7"}]},{"id":"blk-83822","spans":[{"id":"spn-148275","text":"Client-provided user IDs"}]},{"id":"blk-83823","spans":[{"id":"spn-148276","text":"Critical"}]},{"id":"blk-83824","spans":[{"id":"spn-148277","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-83825","spans":[{"id":"spn-148278","text":"8"}]},{"id":"blk-83826","spans":[{"id":"spn-148279","text":"Skipping bundle validation"}]},{"id":"blk-83827","spans":[{"id":"spn-148280","text":"High"}]},{"id":"blk-83828","spans":[{"id":"spn-148281","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-83829","spans":[{"id":"spn-148282","text":"9"}]},{"id":"blk-83830","spans":[{"id":"spn-148283","text":"Hard-coded tier limits"}]},{"id":"blk-83831","spans":[{"id":"spn-148284","text":"Medium"}]},{"id":"blk-83832","spans":[{"id":"spn-148285","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-83833","spans":[{"id":"spn-148286","text":"10"}]},{"id":"blk-83834","spans":[{"id":"spn-148287","text":"Missing telemetry"}]},{"id":"blk-83835","spans":[{"id":"spn-148288","text":"High"}]},{"id":"blk-83836","spans":[{"id":"spn-148289","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-83837","spans":[{"id":"spn-148290","text":"11"}]},{"id":"blk-83838","spans":[{"id":"spn-148291","text":"Edge Functions as hosting"}]},{"id":"blk-83839","spans":[{"id":"spn-148292","text":"High"}]},{"id":"blk-83840","spans":[{"id":"spn-148293","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-83841","spans":[{"id":"spn-148294","text":"12"}]},{"id":"blk-83842","spans":[{"id":"spn-148295","text":"Circular A2A delegation"}]},{"id":"blk-83843","spans":[{"id":"spn-148296","text":"High"}]},{"id":"blk-83844","spans":[{"id":"spn-148297","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaiera32na77vn6x5vcnzhkrvywdz24bnylojft4msodyfh7pcegy6zmbq","vocabulary":"ampersand.docs.fs.v1"}