{"bendscript":"0.1","blocks":[{"id":"blk-67564","kind":"heading","level":1,"spans":[{"id":"spn-98209","text":"Graph Inspection"}]},{"id":"blk-67565","kind":"paragraph","spans":[{"id":"spn-98210","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-67566","kind":"heading","level":2,"spans":[{"id":"spn-98211","text":"Arguments"}]},{"id":"blk-67567","kind":"paragraph","spans":[{"id":"spn-98212","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-67568","kind":"heading","level":2,"spans":[{"id":"spn-98213","text":"Operations"}]},{"id":"blk-67569","kind":"heading","level":3,"spans":[{"id":"spn-98214","text":"List nodes"}]},{"id":"blk-67570","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-67571","kind":"paragraph","spans":[{"id":"spn-98215","text":"Browse what's stored. Filter by "},{"id":"spn-98216","marks":["code"],"text":"node_type"},{"id":"spn-98217","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-98218","marks":["code"],"text":"min_confidence"},{"id":"spn-98219","text":", "},{"id":"spn-98220","marks":["code"],"text":"max_confidence"},{"id":"spn-98221","text":", "},{"id":"spn-98222","marks":["code"],"text":"limit"},{"id":"spn-98223","text":"."}]},{"id":"blk-67572","kind":"heading","level":3,"spans":[{"id":"spn-98224","text":"Get a specific node"}]},{"id":"blk-67573","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-67574","kind":"paragraph","spans":[{"id":"spn-98225","text":"Returns: "},{"id":"spn-98226","marks":["code"],"text":"content"},{"id":"spn-98227","text":", "},{"id":"spn-98228","marks":["code"],"text":"confidence"},{"id":"spn-98229","text":", "},{"id":"spn-98230","marks":["code"],"text":"source"},{"id":"spn-98231","text":", "},{"id":"spn-98232","marks":["code"],"text":"metadata"},{"id":"spn-98233","text":", "},{"id":"spn-98234","marks":["code"],"text":"node_type"},{"id":"spn-98235","text":", "},{"id":"spn-98236","marks":["code"],"text":"timescale"},{"id":"spn-98237","text":" (fast/medium/slow/glacial), "},{"id":"spn-98238","marks":["code"],"text":"access_count"},{"id":"spn-98239","text":", "},{"id":"spn-98240","marks":["code"],"text":"created_at"},{"id":"spn-98241","text":", "},{"id":"spn-98242","marks":["code"],"text":"updated_at"},{"id":"spn-98243","text":"."}]},{"id":"blk-67575","kind":"heading","level":3,"spans":[{"id":"spn-98244","text":"Trace edges from a node"}]},{"id":"blk-67576","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-67577","kind":"paragraph","spans":[{"id":"spn-98245","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-67578","kind":"heading","level":3,"spans":[{"id":"spn-98246","text":"Similarity search"}]},{"id":"blk-67579","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-67580","kind":"paragraph","spans":[{"id":"spn-98247","text":"Embedding-based search. Returns nodes with similarity scores."}]},{"id":"blk-67581","kind":"paragraph","spans":[{"id":"spn-98248","marks":["bold"],"text":"Operation aliases:"},{"id":"spn-98249","text":" "},{"id":"spn-98250","marks":["code"],"text":"\"get\""},{"id":"spn-98251","text":", "},{"id":"spn-98252","marks":["code"],"text":"\"edges\""},{"id":"spn-98253","text":", "},{"id":"spn-98254","marks":["code"],"text":"\"list\""},{"id":"spn-98255","text":" also work as shorthand."}]},{"id":"blk-67582","kind":"heading","level":3,"spans":[{"id":"spn-98256","text":"Graph traverse (BFS walk)"}]},{"id":"blk-67583","kind":"code","language":"text","text":"consolidate(action: \"traverse\", start_node_id: \"<id>\", max_depth: 3, relationship_types: \"causal,supports\")"},{"id":"blk-67584","kind":"paragraph","spans":[{"id":"spn-98257","text":"BFS walk from a starting node. Returns visited nodes, edges, depth map, and traversal metadata. Optionally filter by relationship types (comma-separated)."}]},{"id":"blk-67585","kind":"heading","level":3,"spans":[{"id":"spn-98258","text":"Graph stats (aggregate health)"}]},{"id":"blk-67586","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-67587","kind":"paragraph","spans":[{"id":"spn-98259","text":"Returns node/edge counts, type distributions, confidence statistics (mean/min/max/std_dev), and orphan count (nodes with no edges). No parameters required."}]},{"id":"blk-67588","kind":"heading","level":3,"spans":[{"id":"spn-98260","text":"Manage edges"}]},{"id":"blk-67589","kind":"code","language":"text","text":"act(action: \"manage_edge\", operation: \"list_all\")\nact(action: \"manage_edge\", operation: \"list_for_node\", node_id: \"<id>\")\nact(action: \"manage_edge\", operation: \"update\", edge_id: \"<id>\", weight: 0.9, co_activation_count: 5)\nact(action: \"manage_edge\", operation: \"delete\", edge_id: \"<id>\")"},{"id":"blk-67590","kind":"paragraph","spans":[{"id":"spn-98261","text":"Full edge lifecycle management: list, update weight/co_activation_count/decay_rate, or delete."}]},{"id":"blk-67591","kind":"heading","level":3,"spans":[{"id":"spn-98262","text":"Delete a node"}]},{"id":"blk-67592","kind":"code","language":"text","text":"act(action: \"delete_node\", node_id: \"<id>\")"},{"id":"blk-67593","kind":"paragraph","spans":[{"id":"spn-98263","text":"Remove a node and its connected edges from the graph."}]},{"id":"blk-67594","kind":"heading","level":2,"spans":[{"id":"spn-98264","text":"Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-67596","spans":[{"id":"spn-98265","text":"URI"}]},{"id":"blk-67597","spans":[{"id":"spn-98266","text":"What It Returns"}]}],"id":"blk-67595","kind":"table","rows":[[{"i