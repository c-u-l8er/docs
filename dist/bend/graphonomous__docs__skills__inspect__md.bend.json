{"bendscript":"0.1","blocks":[{"id":"blk-42739","kind":"paragraph","spans":[{"id":"spn-47666","text":"--- name: inspect description: Use when the user asks to \"show the graph\", \"list nodes\", \"what's stored\", \"check for duplicates\", \"trace edges\", \"get node\", \"browse memory\", or wants to query specific nodes/edges in the knowledge graph. Read-only graph inspection. For aggregate health diagnostics, use "},{"id":"spn-47667","marks":["code"],"text":"graph-health"},{"id":"spn-47668","text":" instead. Routes through "},{"id":"spn-47669","marks":["code"],"text":"consolidate"},{"id":"spn-47670","text":" and "},{"id":"spn-47671","marks":["code"],"text":"act"},{"id":"spn-47672","text":" machines. argument-hint: [list|get|edges|search|stats|traverse] [query or node_id] ---"}]},{"id":"blk-42740","kind":"heading","level":1,"spans":[{"id":"spn-47673","text":"Graph Inspection"}]},{"id":"blk-42741","kind":"paragraph","spans":[{"id":"spn-47674","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-42742","kind":"heading","level":2,"spans":[{"id":"spn-47675","text":"Arguments"}]},{"id":"blk-42743","kind":"paragraph","spans":[{"id":"spn-47676","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-42744","kind":"heading","level":2,"spans":[{"id":"spn-47677","text":"Operations"}]},{"id":"blk-42745","kind":"heading","level":3,"spans":[{"id":"spn-47678","text":"List nodes"}]},{"id":"blk-42746","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-42747","kind":"paragraph","spans":[{"id":"spn-47679","text":"Browse what's stored. Filter by "},{"id":"spn-47680","marks":["code"],"text":"node_type"},{"id":"spn-47681","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-47682","marks":["code"],"text":"min_confidence"},{"id":"spn-47683","text":", "},{"id":"spn-47684","marks":["code"],"text":"max_confidence"},{"id":"spn-47685","text":", "},{"id":"spn-47686","marks":["code"],"text":"limit"},{"id":"spn-47687","text":"."}]},{"id":"blk-42748","kind":"heading","level":3,"spans":[{"id":"spn-47688","text":"Get a specific node"}]},{"id":"blk-42749","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-42750","kind":"paragraph","spans":[{"id":"spn-47689","text":"Returns: "},{"id":"spn-47690","marks":["code"],"text":"content"},{"id":"spn-47691","text":", "},{"id":"spn-47692","marks":["code"],"text":"confidence"},{"id":"spn-47693","text":", "},{"id":"spn-47694","marks":["code"],"text":"source"},{"id":"spn-47695","text":", "},{"id":"spn-47696","marks":["code"],"text":"metadata"},{"id":"spn-47697","text":", "},{"id":"spn-47698","marks":["code"],"text":"node_type"},{"id":"spn-47699","text":", "},{"id":"spn-47700","marks":["code"],"text":"timescale"},{"id":"spn-47701","text":" (fast/medium/slow/glacial), "},{"id":"spn-47702","marks":["code"],"text":"access_count"},{"id":"spn-47703","text":", "},{"id":"spn-47704","marks":["code"],"text":"created_at"},{"id":"spn-47705","text":", "},{"id":"spn-47706","marks":["code"],"text":"updated_at"},{"id":"spn-47707","text":"."}]},{"id":"blk-42751","kind":"heading","level":3,"spans":[{"id":"spn-47708","text":"Trace edges from a node"}]},{"id":"blk-42752","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-42753","kind":"paragraph","spans":[{"id":"spn-47709","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-42754","kind":"heading","level":3,"spans":[{"id":"spn-47710","text":"Similarity search"}]},{"id":"blk-42755","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-42756","kind":"para