{"bendscript":"0.1","blocks":[{"id":"blk-68518","kind":"heading","level":1,"spans":[{"id":"spn-100970","text":"Graph Inspection"}]},{"id":"blk-68519","kind":"paragraph","spans":[{"id":"spn-100971","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-68520","kind":"heading","level":2,"spans":[{"id":"spn-100972","text":"Arguments"}]},{"id":"blk-68521","kind":"paragraph","spans":[{"id":"spn-100973","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-68522","kind":"heading","level":2,"spans":[{"id":"spn-100974","text":"Operations"}]},{"id":"blk-68523","kind":"heading","level":3,"spans":[{"id":"spn-100975","text":"List nodes"}]},{"id":"blk-68524","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-68525","kind":"paragraph","spans":[{"id":"spn-100976","text":"Browse what's stored. Filter by "},{"id":"spn-100977","marks":["code"],"text":"node_type"},{"id":"spn-100978","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-100979","marks":["code"],"text":"min_confidence"},{"id":"spn-100980","text":", "},{"id":"spn-100981","marks":["code"],"text":"max_confidence"},{"id":"spn-100982","text":", "},{"id":"spn-100983","marks":["code"],"text":"limit"},{"id":"spn-100984","text":"."}]},{"id":"blk-68526","kind":"heading","level":3,"spans":[{"id":"spn-100985","text":"Get a specific node"}]},{"id":"blk-68527","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-68528","kind":"paragraph","spans":[{"id":"spn-100986","text":"Returns: "},{"id":"spn-100987","marks":["code"],"text":"content"},{"id":"spn-100988","text":", "},{"id":"spn-100989","marks":["code"],"text":"confidence"},{"id":"spn-100990","text":", "},{"id":"spn-100991","marks":["code"],"text":"source"},{"id":"spn-100992","text":", "},{"id":"spn-100993","marks":["code"],"text":"metadata"},{"id":"spn-100994","text":", "},{"id":"spn-100995","marks":["code"],"text":"node_type"},{"id":"spn-100996","text":", "},{"id":"spn-100997","marks":["code"],"text":"timescale"},{"id":"spn-100998","text":" (fast/medium/slow/glacial), "},{"id":"spn-100999","marks":["code"],"text":"access_count"},{"id":"spn-101000","text":", "},{"id":"spn-101001","marks":["code"],"text":"created_at"},{"id":"spn-101002","text":", "},{"id":"spn-101003","marks":["code"],"text":"updated_at"},{"id":"spn-101004","text":"."}]},{"id":"blk-68529","kind":"heading","level":3,"spans":[{"id":"spn-101005","text":"Trace edges from a node"}]},{"id":"blk-68530","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-68531","kind":"paragraph","spans":[{"id":"spn-101006","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-68532","kind":"heading","level":3,"spans":[{"id":"spn-101007","text":"Similarity search"}]},{"id":"blk-68533","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-68534","kind":"paragraph","spans":[{"id":"spn-101008","text":"Embedding-based search. Returns nodes with similarity scores."}]},{"id":"blk-68535","kind":"paragraph","spans":[{"id":"spn-101009","marks":["bold"],"text":"Operation aliases:"},{"id":"spn-101010","text":" "},{"id":"spn-101011","marks":["code"],"text":"\"get\""},{"id":"spn-101012","text":", "},{"id":"spn-101013","marks":["code"],"text":"\"edges\""},{"id":"spn-101014","text":", "},{"id":"spn-101015","marks":["code"],"text":"\"list\""},{"id":"spn-101016","text":" also work as shorthand."}]},{"id":"blk-68536","kind":"heading","level":3,"spans":[{"id":"spn-101017","text":"Graph traverse (BFS walk)"}]},{"id":"blk-68537","kind":"code","language":"text","text":"consolidate(action: \"traverse\", start_node_id: \"<id>\", max_depth: 3, relationship_types: \"causal,supports\")"},{"id":"blk-68538","kind":"paragraph","spans":[{"id":"spn-101018","text":"BFS walk from a starting node. Returns visited nodes, edges, depth map, and traversal metadata. Optionally filter by relationship types (comma-separated)."}]},{"id":"blk-68539","kind":"heading","level":3,"spans":[{"id":"spn-101019","text":"Graph stats (aggregate health)"}]},{"id":"blk-68540","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-68541","kind":"paragraph","spans":[{"id":"spn-101020","text":"Returns node/edge counts, type distributions, confidence statistics (mean/min/max/std_dev), and orphan count (nodes with no edges). No parameters required."}]},{"id":"blk-68542","kind":"heading","level":3,"spans":[{"id":"spn-101021","text":"Manage edges"}]},{"id":"blk-68543","kind":"code","language":"text","text":"act(action: \"manage_edge\", operation: \"list_all\")\nact(action: \"manage_edge\", operation: \"list_for_node\", node_id: \"<id>\")\nact(action: \"manage_edge\", operation: \"update\", edge_id: \"<id>\", weight: 0.9, co_activation_count: 5)\nact(action: \"manage_edge\", operation: \"delete\", edge_id: \"<id>\")"},{"id":"blk-68544","kind":"paragraph","spans":[{"id":"spn-101022","text":"Full edge lifecycle management: list, update weight/co_activation_count/decay_rate, or delete."}]},{"id":"blk-68545","kind":"heading","level":3,"spans":[{"id":"spn-101023","text":"Delete a node"}]},{"id":"blk-68546","kind":"code","language":"text","text":"act(action: \"delete_node\", node_id: \"<id>\")"},{"id":"blk-68547","kind":"paragraph","spans":[{"id":"spn-101024","text":"Remove a node and its connected edges from the graph."}]},{"id":"blk-68548","kind":"heading","level":2,"spans":[{"id":"spn-101025","text":"Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-68550","spans":[{"id":"spn-101026","text":"URI"}]},{"id":"blk-68551","spans":[{"id":"spn-101027","text":"What It Returns"}]}],"id":"blk-68549","kind":"table","rows":[[{"id":"blk-68552","spans":[{"id":"spn-101028","marks":["code"],"text":"graphonomous://runtime/health"}]},{"id":"blk-68553","spans":[{"id":"spn-101029","text":"Runtime health, service status, lightweight counts"}]}],[{"id":"blk-68554","spans":[{"id":"spn-101030","marks":["code"],"text":"graphonomous://goals/snapshot"}]},{"id":"blk-68555","spans":[{"id":"spn-101031","text":"Goal totals, status breakdown, serialized goals"}]}],[{"id":"blk-68556","spans":[{"id":"spn-101032","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-68557","spans":[{"id":"spn-101033","text":"Individual node details + connected edges"}]}],[{"id":"blk-68558","spans":[{"id":"spn-101034","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-68559","spans":[{"id":"spn-101035","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-68560","spans":[{"id":"spn-101036","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-68561","spans":[{"id":"spn-101037","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-68562","kind":"heading","level":2,"spans":[{"id":"spn-101038","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-101039","text":" vs "},{"id":"spn-101040","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\")"}]},{"head":[{"id":"blk-68564","spans":[{"id":"spn-101041","text":""}]},{"id":"blk-68565","spans":[{"id":"spn-101042","marks":["code"],"text":"retrieve(action: \"context\")"}]},{"id":"blk-68566","spans":[{"id":"spn-101043","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\")"}]}],"id":"blk-68563","kind":"table","rows":[[{"id":"blk-68567","spans":[{"id":"spn-101044","marks":["bold"],"text":"Neighborhood expansion"}]},{"id":"blk-68568","spans":[{"id":"spn-101045","text":"Yes (hops)"}]},{"id":"blk-68569","spans":[{"id":"spn-101046","text":"No"}]}],[{"id":"blk-68570","spans":[{"id":"spn-101047","marks":["bold"],"text":"Topology annotations"}]},{"id":"blk-68571","spans":[{"id":"spn-101048","text":"Yes (routing, kappa)"}]},{"id":"blk-68572","spans":[{"id":"spn-101049","text":"No"}]}],[{"id":"blk-68573","spans":[{"id":"spn-101050","marks":["bold"],"text":"Causal context"}]},{"id":"blk-68574","spans":[{"id":"spn-101051","text":"Yes (for outcome learning)"}]},{"id":"blk-68575","spans":[{"id":"spn-101052","text":"No"}]}],[{"id":"blk-68576","spans":[{"id":"spn-101053","marks":["bold"],"text":"Side effects"}]},{"id":"blk-68577","spans":[{"id":"spn-101054","text":"Updates access counts"}]},{"id":"blk-68578","spans":[{"id":"spn-101055","text":"None"}]}],[{"id":"blk-68579","spans":[{"id":"spn-101056","marks":["bold"],"text":"Use when"}]},{"id":"blk-68580","spans":[{"id":"spn-101057","text":"Acting on results (need causal tracking)"}]},{"id":"blk-68581","spans":[{"id":"spn-101058","text":"Checking duplicates, auditing, browsing"}]}]]},{"id":"blk-68582","kind":"paragraph","spans":[{"id":"spn-101059","marks":["bold"],"text":"Rule:"},{"id":"spn-101060","text":" Use "},{"id":"spn-101061","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-101062","text":" when you plan to act on results. Use "},{"id":"spn-101063","marks":["code"],"text":"consolidate(action: \"query\")"},{"id":"spn-101064","text":" for read-only inspection."}]},{"id":"blk-68583","kind":"heading","level":2,"spans":[{"id":"spn-101065","text":"Common Patterns"}]},{"id":"blk-68584","kind":"heading","level":3,"spans":[{"id":"spn-101066","text":"Duplicate prevention (check before storing)"}]},{"id":"blk-68585","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"the fact I want to store\", limit: 3)"},{"id":"blk-68586","items":[{"blocks":[{"id":"blk-68588","kind":"paragraph","spans":[{"id":"spn-101067","text":"similarity > 0.90 — "},{"id":"spn-101068","marks":["bold"],"text":"duplicate"},{"id":"spn-101069","text":" — update the existing node instead"}]}],"id":"blk-68587","kind":"list-item"},{"blocks":[{"id":"blk-68590","kind":"paragraph","spans":[{"id":"spn-101070","text":"similarity 0.70-0.90 — "},{"id":"spn-101071","marks":["bold"],"text":"related"},{"id":"spn-101072","text":" — store new node + add "},{"id":"spn-101073","marks":["code"],"text":"related"},{"id":"spn-101074","text":" edge"}]}],"id":"blk-68589","kind":"list-item"},{"blocks":[{"id":"blk-68592","kind":"paragraph","spans":[{"id":"spn-101075","text":"similarity < 0.70 — "},{"id":"spn-101076","marks":["bold"],"text":"novel"},{"id":"spn-101077","text":" — safe to store as new node"}]}],"id":"blk-68591","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68593","kind":"heading","level":3,"spans":[{"id":"spn-101078","text":"Audit weak knowledge"}]},{"id":"blk-68594","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3)"},{"id":"blk-68595","kind":"paragraph","spans":[{"id":"spn-101079","text":"Find speculative or likely-wrong nodes needing reinforcement or pruning."}]},{"id":"blk-68596","kind":"heading","level":3,"spans":[{"id":"spn-101080","text":"Trace decision chains"}]},{"id":"blk-68597","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")\nconsolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-68598","kind":"paragraph","spans":[{"id":"spn-101081","text":"Follow "},{"id":"spn-101082","marks":["code"],"text":"causal"},{"id":"spn-101083","text":" and "},{"id":"spn-101084","marks":["code"],"text":"supports"},{"id":"spn-101085","text":" edges to reconstruct reasoning. Check for "},{"id":"spn-101086","marks":["code"],"text":"contradicts"},{"id":"spn-101087","text":" edges that indicate unresolved conflicts."}]},{"id":"blk-68599","kind":"heading","level":2,"spans":[{"id":"spn-101088","text":"Anti-patterns to avoid"}]},