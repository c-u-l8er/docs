s"}]},{"id":"blk-67617","spans":[{"id":"spn-98287","text":"Yes (routing, kappa)"}]},{"id":"blk-67618","spans":[{"id":"spn-98288","text":"No"}]}],[{"id":"blk-67619","spans":[{"id":"spn-98289","marks":["bold"],"text":"Causal context"}]},{"id":"blk-67620","spans":[{"id":"spn-98290","text":"Yes (for outcome learning)"}]},{"id":"blk-67621","spans":[{"id":"spn-98291","text":"No"}]}],[{"id":"blk-67622","spans":[{"id":"spn-98292","marks":["bold"],"text":"Side effects"}]},{"id":"blk-67623","spans":[{"id":"spn-98293","text":"Updates access counts"}]},{"id":"blk-67624","spans":[{"id":"spn-98294","text":"None"}]}],[{"id":"blk-67625","spans":[{"id":"spn-98295","marks":["bold"],"text":"Use when"}]},{"id":"blk-67626","spans":[{"id":"spn-98296","text":"Acting on results (need causal tracking)"}]},{"id":"blk-67627","spans":[{"id":"spn-98297","text":"Checking duplicates, auditing, browsing"}]}]]},{"id":"blk-67628","kind":"paragraph","spans":[{"id":"spn-98298","marks":["bold"],"text":"Rule:"},{"id":"spn-98299","text":" Use "},{"id":"spn-98300","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-98301","text":" when you plan to act on results. Use "},{"id":"spn-98302","marks":["code"],"text":"consolidate(action: \"query\")"},{"id":"spn-98303","text":" for read-only inspection."}]},{"id":"blk-67629","kind":"heading","level":2,"spans":[{"id":"spn-98304","text":"Common Patterns"}]},{"id":"blk-67630","kind":"heading","level":3,"spans":[{"id":"spn-98305","text":"Duplicate prevention (check before storing)"}]},{"id":"blk-67631","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"the fact I want to store\", limit: 3)"},{"id":"blk-67632","items":[{"blocks":[{"id":"blk-67634","kind":"paragraph","spans":[{"id":"spn-98306","text":"similarity > 0.90 — "},{"id":"spn-98307","marks":["bold"],"text":"duplicate"},{"id":"spn-98308","text":" — update the existing node instead"}]}],"id":"blk-67633","kind":"list-item"},{"blocks":