s"}]},{"id":"blk-67743","spans":[{"id":"spn-98435","text":"Yes (routing, kappa)"}]},{"id":"blk-67744","spans":[{"id":"spn-98436","text":"No"}]}],[{"id":"blk-67745","spans":[{"id":"spn-98437","marks":["bold"],"text":"Causal context"}]},{"id":"blk-67746","spans":[{"id":"spn-98438","text":"Yes (for outcome learning)"}]},{"id":"blk-67747","spans":[{"id":"spn-98439","text":"No"}]}],[{"id":"blk-67748","spans":[{"id":"spn-98440","marks":["bold"],"text":"Side effects"}]},{"id":"blk-67749","spans":[{"id":"spn-98441","text":"Updates access counts"}]},{"id":"blk-67750","spans":[{"id":"spn-98442","text":"None"}]}],[{"id":"blk-67751","spans":[{"id":"spn-98443","marks":["bold"],"text":"Use when"}]},{"id":"blk-67752","spans":[{"id":"spn-98444","text":"Acting on results (need causal tracking)"}]},{"id":"blk-67753","spans":[{"id":"spn-98445","text":"Checking duplicates, auditing, browsing"}]}]]},{"id":"blk-67754","kind":"paragraph","spans":[{"id":"spn-98446","marks":["bold"],"text":"Rule:"},{"id":"spn-98447","text":" Use "},{"id":"spn-98448","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-98449","text":" when you plan to act on results. Use "},{"id":"spn-98450","marks":["code"],"text":"consolidate(action: \"query\")"},{"id":"spn-98451","text":" for read-only inspection."}]},{"id":"blk-67755","kind":"heading","level":2,"spans":[{"id":"spn-98452","text":"Common Patterns"}]},{"id":"blk-67756","kind":"heading","level":3,"spans":[{"id":"spn-98453","text":"Duplicate prevention (check before storing)"}]},{"id":"blk-67757","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"the fact I want to store\", limit: 3)"},{"id":"blk-67758","items":[{"blocks":[{"id":"blk-67760","kind":"paragraph","spans":[{"id":"spn-98454","text":"similarity > 0.90 — "},{"id":"spn-98455","marks":["bold"],"text":"duplicate"},{"id":"spn-98456","text":" — update the existing node instead"}]}],"id":"blk-67759","kind":"list-item"},{"blocks":