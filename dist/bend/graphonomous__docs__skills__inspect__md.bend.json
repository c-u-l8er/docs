{"bendscript":"0.1","blocks":[{"id":"blk-42849","kind":"paragraph","spans":[{"id":"spn-48295","text":"--- name: inspect description: Use when the user asks to \"show the graph\", \"list nodes\", \"what's stored\", \"check for duplicates\", \"trace edges\", \"get node\", \"browse memory\", or wants to query specific nodes/edges in the knowledge graph. Read-only graph inspection. For aggregate health diagnostics, use "},{"id":"spn-48296","marks":["code"],"text":"graph-health"},{"id":"spn-48297","text":" instead. Routes through "},{"id":"spn-48298","marks":["code"],"text":"consolidate"},{"id":"spn-48299","text":" and "},{"id":"spn-48300","marks":["code"],"text":"act"},{"id":"spn-48301","text":" machines. argument-hint: [list|get|edges|search|stats|traverse] [query or node_id] ---"}]},{"id":"blk-42850","kind":"heading","level":1,"spans":[{"id":"spn-48302","text":"Graph Inspection"}]},{"id":"blk-42851","kind":"paragraph","spans":[{"id":"spn-48303","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-42852","kind":"heading","level":2,"spans":[{"id":"spn-48304","text":"Arguments"}]},{"id":"blk-42853","kind":"paragraph","spans":[{"id":"spn-48305","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-42854","kind":"heading","level":2,"spans":[{"id":"spn-48306","text":"Operations"}]},{"id":"blk-42855","kind":"heading","level":3,"spans":[{"id":"spn-48307","text":"List nodes"}]},{"id":"blk-42856","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-42857","kind":"paragraph","spans":[{"id":"spn-48308","text":"Browse what's stored. Filter by "},{"id":"spn-48309","marks":["code"],"text":"node_type"},{"id":"spn-48310","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-48311","marks":["code"],"text":"min_confidence"},{"id":"spn-48312","text":", "},{"id":"spn-48313","marks":["code"],"text":"max_confidence"},{"id":"spn-48314","text":", "},{"id":"spn-48315","marks":["code"],"text":"limit"},{"id":"spn-48316","text":"."}]},{"id":"blk-42858","kind":"heading","level":3,"spans":[{"id":"spn-48317","text":"Get a specific node"}]},{"id":"blk-42859","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-42860","kind":"paragraph","spans":[{"id":"spn-48318","text":"Returns: "},{"id":"spn-48319","marks":["code"],"text":"content"},{"id":"spn-48320","text":", "},{"id":"spn-48321","marks":["code"],"text":"confidence"},{"id":"spn-48322","text":", "},{"id":"spn-48323","marks":["code"],"text":"source"},{"id":"spn-48324","text":", "},{"id":"spn-48325","marks":["code"],"text":"metadata"},{"id":"spn-48326","text":", "},{"id":"spn-48327","marks":["code"],"text":"node_type"},{"id":"spn-48328","text":", "},{"id":"spn-48329","marks":["code"],"text":"timescale"},{"id":"spn-48330","text":" (fast/medium/slow/glacial), "},{"id":"spn-48331","marks":["code"],"text":"access_count"},{"id":"spn-48332","text":", "},{"id":"spn-48333","marks":["code"],"text":"created_at"},{"id":"spn-48334","text":", "},{"id":"spn-48335","marks":["code"],"text":"updated_at"},{"id":"spn-48336","text":"."}]},{"id":"blk-42861","kind":"heading","level":3,"spans":[{"id":"spn-48337","text":"Trace edges from a node"}]},{"id":"blk-42862","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-42863","kind":"paragraph","spans":[{"id":"spn-48338","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-42864","kind":"heading","level":3,"spans":[{"id":"spn-48339","text":"Similarity search"}]},{"id":"blk-42865","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-42866","kind":"para