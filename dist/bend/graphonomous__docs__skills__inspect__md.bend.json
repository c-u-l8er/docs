{"bendscript":"0.1","blocks":[{"id":"blk-67553","kind":"heading","level":1,"spans":[{"id":"spn-98156","text":"Graph Inspection"}]},{"id":"blk-67554","kind":"paragraph","spans":[{"id":"spn-98157","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-67555","kind":"heading","level":2,"spans":[{"id":"spn-98158","text":"Arguments"}]},{"id":"blk-67556","kind":"paragraph","spans":[{"id":"spn-98159","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-67557","kind":"heading","level":2,"spans":[{"id":"spn-98160","text":"Operations"}]},{"id":"blk-67558","kind":"heading","level":3,"spans":[{"id":"spn-98161","text":"List nodes"}]},{"id":"blk-67559","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-67560","kind":"paragraph","spans":[{"id":"spn-98162","text":"Browse what's stored. Filter by "},{"id":"spn-98163","marks":["code"],"text":"node_type"},{"id":"spn-98164","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-98165","marks":["code"],"text":"min_confidence"},{"id":"spn-98166","text":", "},{"id":"spn-98167","marks":["code"],"text":"max_confidence"},{"id":"spn-98168","text":", "},{"id":"spn-98169","marks":["code"],"text":"limit"},{"id":"spn-98170","text":"."}]},{"id":"blk-67561","kind":"heading","level":3,"spans":[{"id":"spn-98171","text":"Get a specific node"}]},{"id":"blk-67562","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-67563","kind":"paragraph","spans":[{"id":"spn-98172","text":"Returns: "},{"id":"spn-98173","marks":["code"],"text":"content"},{"id":"spn-98174","text":", "},{"id":"spn-98175","marks":["code"],"text":"confidence"},{"id":"spn-98176","text":", "},{"id":"spn-98177","marks":["code"],"text":"source"},{"id":"spn-98178","text":", "},{"id":"spn-98179","marks":["code"],"text":"metadata"},{"id":"spn-98180","text":", "},{"id":"spn-98181","marks":["code"],"text":"node_type"},{"id":"spn-98182","text":", "},{"id":"spn-98183","marks":["code"],"text":"timescale"},{"id":"spn-98184","text":" (fast/medium/slow/glacial), "},{"id":"spn-98185","marks":["code"],"text":"access_count"},{"id":"spn-98186","text":", "},{"id":"spn-98187","marks":["code"],"text":"created_at"},{"id":"spn-98188","text":", "},{"id":"spn-98189","marks":["code"],"text":"updated_at"},{"id":"spn-98190","text":"."}]},{"id":"blk-67564","kind":"heading","level":3,"spans":[{"id":"spn-98191","text":"Trace edges from a node"}]},{"id":"blk-67565","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-67566","kind":"paragraph","spans":[{"id":"spn-98192","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-67567","kind":"heading","level":3,"spans":[{"id":"spn-98193","text":"Similarity search"}]},{"id":"blk-67568","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-67569","kind":"paragraph","spans":[{"id":"spn-98194","text":"Embedding-based search. Returns nodes with similarity scores."}]},{"id":"blk-67570","kind":"paragraph","spans":[{"id":"spn-98195","marks":["bold"],"text":"Operation aliases:"},{"id":"spn-98196","text":" "},{"id":"spn-98197","marks":["code"],"text":"\"get\""},{"id":"spn-98198","text":", "},{"id":"spn-98199","marks":["code"],"text":"\"edges\""},{"id":"spn-98200","text":", "},{"id":"spn-98201","marks":["code"],"text":"\"list\""},{"id":"spn-98202","text":" also work as shorthand."}]},{"id":"blk-67571","kind":"heading","level":3,"spans":[{"id":"spn-98203","text":"Graph traverse (BFS walk)"}]},{"id":"blk-67572","kind":"code","language":"text","text":"consolidate(action: \"traverse\", start_node_id: \"<id>\", max_dept