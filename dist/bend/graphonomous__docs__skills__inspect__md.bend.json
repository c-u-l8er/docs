{"bendscript":"0.1","blocks":[{"id":"blk-67690","kind":"heading","level":1,"spans":[{"id":"spn-98357","text":"Graph Inspection"}]},{"id":"blk-67691","kind":"paragraph","spans":[{"id":"spn-98358","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-67692","kind":"heading","level":2,"spans":[{"id":"spn-98359","text":"Arguments"}]},{"id":"blk-67693","kind":"paragraph","spans":[{"id":"spn-98360","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-67694","kind":"heading","level":2,"spans":[{"id":"spn-98361","text":"Operations"}]},{"id":"blk-67695","kind":"heading","level":3,"spans":[{"id":"spn-98362","text":"List nodes"}]},{"id":"blk-67696","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-67697","kind":"paragraph","spans":[{"id":"spn-98363","text":"Browse what's stored. Filter by "},{"id":"spn-98364","marks":["code"],"text":"node_type"},{"id":"spn-98365","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-98366","marks":["code"],"text":"min_confidence"},{"id":"spn-98367","text":", "},{"id":"spn-98368","marks":["code"],"text":"max_confidence"},{"id":"spn-98369","text":", "},{"id":"spn-98370","marks":["code"],"text":"limit"},{"id":"spn-98371","text":"."}]},{"id":"blk-67698","kind":"heading","level":3,"spans":[{"id":"spn-98372","text":"Get a specific node"}]},{"id":"blk-67699","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-67700","kind":"paragraph","spans":[{"id":"spn-98373","text":"Returns: "},{"id":"spn-98374","marks":["code"],"text":"content"},{"id":"spn-98375","text":", "},{"id":"spn-98376","marks":["code"],"text":"confidence"},{"id":"spn-98377","text":", "},{"id":"spn-98378","marks":["code"],"text":"source"},{"id":"spn-98379","text":", "},{"id":"spn-98380","marks":["code"],"text":"metadata"},{"id":"spn-98381","text":", "},{"id":"spn-98382","marks":["code"],"text":"node_type"},{"id":"spn-98383","text":", "},{"id":"spn-98384","marks":["code"],"text":"timescale"},{"id":"spn-98385","text":" (fast/medium/slow/glacial), "},{"id":"spn-98386","marks":["code"],"text":"access_count"},{"id":"spn-98387","text":", "},{"id":"spn-98388","marks":["code"],"text":"created_at"},{"id":"spn-98389","text":", "},{"id":"spn-98390","marks":["code"],"text":"updated_at"},{"id":"spn-98391","text":"."}]},{"id":"blk-67701","kind":"heading","level":3,"spans":[{"id":"spn-98392","text":"Trace edges from a node"}]},{"id":"blk-67702","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-67703","kind":"paragraph","spans":[{"id":"spn-98393","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-67704","kind":"heading","level":3,"spans":[{"id":"spn-98394","text":"Similarity search"}]},{"id":"blk-67705","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-67706","kind":"paragraph","spans":[{"id":"spn-98395","text":"Embedding-based search. Returns nodes with similarity scores."}]},{"id":"blk-67707","kind":"paragraph","spans":[{"id":"spn-98396","marks":["bold"],"text":"Operation aliases:"},{"id":"spn-98397","text":" "},{"id":"spn-98398","marks":["code"],"text":"\"get\""},{"id":"spn-98399","text":", "},{"id":"spn-98400","marks":["code"],"text":"\"edges\""},{"id":"spn-98401","text":", "},{"id":"spn-98402","marks":["code"],"text":"\"list\""},{"id":"spn-98403","text":" also work as shorthand."}]},{"id":"blk-67708","kind":"heading","level":3,"spans":[{"id":"spn-98404","text":"Graph traverse (BFS walk)"}]},{"id":"blk-67709","kind":"code","language":"text","text":"consolidate(action: \"traverse\", start_node_id: \"<id>\", max_dept