{"bendscript":"0.1","blocks":[{"id":"blk-75047","kind":"heading","level":1,"spans":[{"id":"spn-137720","text":"Graph Inspection"}]},{"id":"blk-75048","kind":"paragraph","spans":[{"id":"spn-137721","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-75049","kind":"heading","level":2,"spans":[{"id":"spn-137722","text":"Arguments"}]},{"id":"blk-75050","kind":"paragraph","spans":[{"id":"spn-137723","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-75051","kind":"heading","level":2,"spans":[{"id":"spn-137724","text":"Operations"}]},{"id":"blk-75052","kind":"heading","level":3,"spans":[{"id":"spn-137725","text":"List nodes"}]},{"id":"blk-75053","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-75054","kind":"paragraph","spans":[{"id":"spn-137726","text":"Browse what's stored. Filter by "},{"id":"spn-137727","marks":["code"],"text":"node_type"},{"id":"spn-137728","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-137729","marks":["code"],"text":"min_confidence"},{"id":"spn-137730","text":", "},{"id":"spn-137731","marks":["code"],"text":"max_confidence"},{"id":"spn-137732","text":", "},{"id":"spn-137733","marks":["code"],"text":"limit"},{"id":"spn-137734","text":"."}]},{"id":"blk-75055","kind":"heading","level":3,"spans":[{"id":"spn-137735","text":"Get a specific node"}]},{"id":"blk-75056","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-75057","kind":"paragraph","spans":[{"id":"spn-137736","text":"Returns: "},{"id":"spn-137737","marks":["code"],"text":"content"},{"id":"spn-137738","text":", "},{"id":"spn-137739","marks":["code"],"text":"confidence"},{"id":"spn-137740","text":", "},{"id":"spn-137741","marks":["code"],"text":"source"},{"id":"spn-137742","text":", "},{"id":"spn-137743","marks":["code"],"text":"metadata"},{"id":"spn-137744","text":", "},{"id":"spn-137745","marks":["code"],"text":"node_type"},{"id":"spn-137746","text":", "},{"id":"spn-137747","marks":["code"],"text":"timescale"},{"id":"spn-137748","text":" (fast/medium/slow/glacial), "},{"id":"spn-137749","marks":["code"],"text":"access_count"},{"id":"spn-137750","text":", "},{"id":"spn-137751","marks":["code"],"text":"created_at"},{"id":"spn-137752","text":", "},{"id":"spn-137753","marks":["code"],"text":"updated_at"},{"id":"spn-137754","text":"."}]},{"id":"blk-75058","kind":"heading","level":3,"spans":[{"id":"spn-137755","text":"Trace edges from a node"}]},{"id":"blk-75059","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-75060","kind":"paragraph","spans":[{"id":"spn-137756","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-75061","kind":"heading","level":3,"spans":[{"id":"spn-137757","text":"Similarity search"}]},{"id":"blk-75062","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-75063","kind":"paragraph","spans":[{"id":"spn-137758","text":"Embedding-based search. Returns nodes with similarity scores."}]},{"id":"blk-75064","kind":"paragraph","spans":[{"id":"spn-137759","marks":["bold"],"text":"Operation aliases:"},{"id":"spn-137760","text":" "},{"id":"spn-137761","marks":["code"],"text":"\"get\""},{"id":"spn-137762","text":", "},{"id":"spn-137763","marks":["code"],"text":"\"edges\""},{"id":"spn-137764","text":", "},{"id":"spn-137765","marks":["code"],"text":"\"list\""},{"id":"spn-137766","text":" also work as shorthand."}]},{"id":"blk-75065","kind":"heading","level":3,"spans":[{"id":"spn-137767","text":"Graph traverse (BFS walk)"}]},{"id":"blk-75066","kind":"code","language":"text","text":"consolidate(action: \"traverse\", start_node_id: \"<id>\", max_depth: 3, relationship_types: \"causal,supports\")"},{"id":"blk-75067","kind":"paragraph","spans":[{"id":"spn-137768","text":"BFS walk from a starting node. Returns visited nodes, edges, depth map, and traversal metadata. Optionally filter by relationship types (comma-separated)."}]},{"id":"blk-75068","kind":"heading","level":3,"spans":[{"id":"spn-137769","text":"Graph stats (aggregate health)"}]},{"id":"blk-75069","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-75070","kind":"paragraph","spans":[{"id":"spn-137770","text":"Returns node/edge counts, type distributions, confidence statistics (mean/min/max/std_dev), and orphan count (nodes with no edges). No parameters required."}]},{"id":"blk-75071","kind":"heading","level":3,"spans":[{"id":"spn-137771","text":"Manage edges"}]},{"id":"blk-75072","kind":"code","language":"text","text":"act(action: \"manage_edge\", operation: \"list_all\")\nact(action: \"manage_edge\", operation: \"list_for_node\", node_id: \"<id>\")\nact(action: \"manage_edge\", operation: \"update\", edge_id: \"<id>\", weight: 0.9, co_activation_count: 5)\nact(action: \"manage_edge\", operation: \"delete\", edge_id: \"<id>\")"},{"id":"blk-75073","kind":"paragraph","spans":[{"id":"spn-137772","text":"Full edge lifecycle management: list, update weight/co_activation_count/decay_rate, or delete."}]},{"id":"blk-75074","kind":"heading","level":3,"spans":[{"id":"spn-137773","text":"Delete a node"}]},{"id":"blk-75075","kind":"code","language":"text","text":"act(action: \"delete_node\", node_id: \"<id>\")"},{"id":"blk-75076","kind":"paragraph","spans":[{"id":"spn-137774","text":"Remove a node and its connected edges from the graph."}]},{"id":"blk-75077","kind":"heading","level":2,"spans":[{"id":"spn-137775","text":"Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-75079","spans":[{"id":"spn-137776","text":"URI"}]},{"id":"blk-75080","spans":[{"id":"spn-137777","text":"What It Returns"}]}],"id":"blk-75078","kind":"table","rows":[[{"id":"blk-75081","spans":[{"id":"spn-137778","marks":["code"],"text":"graphonomous://runtime/health"}]},{"id":"blk-75082","spans":[{"id":"spn-137779","text":"Runtime health, service status, lightweight counts"}]}],[{"id":"blk-75083","spans":[{"id":"spn-137780","marks":["code"],"text":"graphonomous://goals/snapshot"}]},{"id":"blk-75084","spans":[{"id":"spn-137781","text":"Goal totals, status breakdown, serialized goals"}]}],[{"id":"blk-75085","spans":[{"id":"spn-137782","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-75086","spans":[{"id":"spn-137783","text":"Individual node details + connected edges"}]}],[{"id":"blk-75087","spans":[{"id":"spn-137784","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-75088","spans":[{"id":"spn-137785","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-75089","spans":[{"id":"spn-137786","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-75090","spans":[{"id":"spn-137787","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-75091","kind":"heading","level":2,"spans":[{"id":"spn-137788","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-137789","text":" vs "},{"id":"spn-137790","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\")"}]},{"head":[{"id":"blk-75093","spans":[{"id":"spn-137791","text":""}]},{"id":"blk-75094","spans":[{"id":"spn-137792","marks":["code"],"text":"retrieve(action: \"context\")"}]},{"id":"blk-75095","spans":[{"id":"spn-137793","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\")"}]}],"id":"blk-75092","kind":"table","rows":[[{"id":"blk-75096","spans":[{"id":"spn-137794","marks":["bold"],"text":"Neighborhood expansion"}]},{"id":"blk-75097","spans":[{"id":"spn-137795","text":"Yes (hops)"}]},{"id":"blk-75098","spans":[{"id":"spn-137796","text":"No"}]}],[{"id":"blk-75099","spans":[{"id":"spn-137797","marks":["bold"],"text":"Topology annotations"}]},{"id":"blk-75100","spans":[{"id":"spn-137798","text":"Yes (routing, kappa)"}]},{"id":"blk-75101","spans":[{"id":"spn-137799","text":"No"}]}],[{"id":"blk-75102","spans":[{"id":"spn-137800","marks":["bold"],"text":"Causal context"}]},{"id":"blk-75103","spans":[{"id":"spn-137801","text":"Yes (for outcome learning)"}]},{"id":"blk-75104","spans":[{"id":"spn-137802","text":"No"}]}],[{"id":"blk-75105","spans":[{"id":"spn-137803","marks":["bold"],"text":"Side effects"}]},{"id":"blk-75106","spans":[{"id":"spn-137804","text":"Updates access counts"}]},{"id":"blk-75107","spans":[{"id":"spn-137805","text":"None"}]}],[{"id":"blk-75108","spans":[{"id":"spn-137806","marks":["bold"],"text":"Use when"}]},{"id":"blk-75109","spans":[{"id":"spn-137807","text":"Acting on results (need causal tracking)"}]},{"id":"blk-75110","spans":[{"id":"spn-137808","text":"Checking duplicates, auditing, browsing"}]}]]},{"id":"blk-75111","kind":"paragraph","spans":[{"id":"spn-137809","marks":["bold"],"text":"Rule:"},{"id":"spn-137810","text":" Use "},{"id":"spn-137811","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-137812","text":" when you plan to act on results. Use "},{"id":"spn-137813","marks":["code"],"text":"consolidate(action: \"query\")"},{"id":"spn-137814","text":" for read-only inspection."}]},{"id":"blk-75112","kind":"heading","level":2,"spans":[{"id":"spn-137815","text":"Common Patterns"}]},{"id":"blk-75113","kind":"heading","level":3,"spans":[{"id":"spn-137816","text":"Duplicate prevention (check before storing)"}]},{"id":"blk-75114","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"the fact I want to store\", limit: 3)"},{"id":"blk-75115","items":[{"blocks":[{"id":"blk-75117","kind":"paragraph","spans":[{"id":"spn-137817","text":"similarity > 0.90 — "},{"id":"spn-137818","marks":["bold"],"text":"duplicate"},{"id":"spn-137819","text":" — update the existing node instead"}]}],"id":"blk-75116","kind":"list-item"},{"blocks":[{"id":"blk-75119","kind":"paragraph","spans":[{"id":"spn-137820","text":"similarity 0.70-0.90 — "},{"id":"spn-137821","marks":["bold"],"text":"related"},{"id":"spn-137822","text":" — store new node + add "},{"id":"spn-137823","marks":["code"],"text":"related"},{"id":"spn-137824","text":" edge"}]}],"id":"blk-75118","kind":"list-item"},{"blocks":[{"id":"blk-75121","kind":"paragraph","spans":[{"id":"spn-137825","text":"similarity < 0.70 — "},{"id":"spn-137826","marks":["bold"],"text":"novel"},{"id":"spn-137827","text":" — safe to store as new node"}]}],"id":"blk-75120","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75122","kind":"heading","level":3,"spans":[{"id":"spn-137828","text":"Audit weak knowledge"}]},{"id":"blk-75123","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", min_confidence: 0.0, max_confidence: 0.3)"},{"id":"blk-75124","kind":"paragraph","spans":[{"id":"spn-137829","text":"Find speculative or likely-wrong nodes needing reinforcement or pruning."}]},{"id":"blk-75125","kind":"heading","level":3,"spans":[{"id":"spn-137830","text":"Trace decision chains"}]},{"id":"blk-75126","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")\nconsolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-75127","kind":"paragraph","spans":[{"id":"spn-137831","text":"Follow "},{"id":"spn-137832","marks":["code"],"text":"causal"},{"id":"spn-137833","text":" and "},{"id":"spn-137834","marks":["code"],"text":"supports"},{"id":"spn-137835","text":" edges to reconstruct reasoning. Check for "},{"id":"spn-137836","marks":["code"],"text":"contradicts"},{"id":"spn-137837","text":" edges that indicate unresolved conflicts."}]},{"id":"blk-75128","kind":"heading","level":2,"spans":[{"id":"spn-137838","text":"Anti-patterns to avoid"}]},{"id":"blk-75129","items":[{"blocks":[{"id":"blk-75131","kind":"paragraph","spans":[{"id":"spn-137839","text":"Using "},{"id":"spn-137840","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-137841","text":" for browsing — it has side effects (updates access counts)"}]}],"id":"blk-75130","kind":"list-item"},{"blocks":[{"id":"blk-75133","kind":"paragraph","spans":[{"id":"spn-137842","text":"Forgetting to check for duplicates before storing new nodes"}]}],"id":"blk-75132","kind":"list-item"},{"blocks":[{"id":"blk-75135","kind":"paragraph","spans":[{"id":"spn-137843","text":"Running traversals with very high max_depth on large graphs — start with 2-3"}]}],"id":"blk-75134","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieravx6ea6ia347ffhgqekut6n774pwvotv2drn7igs5pz3wyfwgyfkq","vocabulary":"ampersand.docs.fs.v1"}