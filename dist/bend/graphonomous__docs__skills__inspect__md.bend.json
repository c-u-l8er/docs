d":"spn-47725","text":"Full edge lifecycle management: list, update weight/co_activation_count/decay_rate, or delete."}]},{"id":"blk-42767","kind":"heading","level":3,"spans":[{"id":"spn-47726","text":"Delete a node"}]},{"id":"blk-42768","kind":"code","language":"text","text":"act(action: \"delete_node\", node_id: \"<id>\")"},{"id":"blk-42769","kind":"paragraph","spans":[{"id":"spn-47727","text":"Remove a node and its connected edges from the graph."}]},{"id":"blk-42770","kind":"heading","level":2,"spans":[{"id":"spn-47728","text":"Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-42772","spans":[{"id":"spn-47729","text":"URI"}]},{"id":"blk-42773","spans":[{"id":"spn-47730","text":"What It Returns"}]}],"id":"blk-42771","kind":"table","rows":[[{"id":"blk-42774","spans":[{"id":"spn-47731","marks":["code"],"text":"graphonomous://runtime/health"}]},{"id":"blk-42775","spans":[{"id":"spn-47732","text":"Runtime health, service status, lightweight counts"}]}],[{"id":"blk-42776","spans":[{"id":"spn-47733","marks":["code"],"text":"graphonomous://goals/snapshot"}]},{"id":"blk-42777","spans":[{"id":"spn-47734","text":"Goal totals, status breakdown, serialized goals"}]}],[{"id":"blk-42778","spans":[{"id":"spn-47735","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-42779","spans":[{"id":"spn-47736","text":"Individual node details + connected edges"}]}],[{"id":"blk-42780","spans":[{"id":"spn-47737","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-42781","spans":[{"id":"spn-47738","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-42782","spans":[{"id":"spn-47739","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-42783","spans":[{"id":"spn-47740","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-42784","kind":"heading","level":2,"spans":[{"id":"spn-47741","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-47742","text":" vs "},{"id":"spn-47743",