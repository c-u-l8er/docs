s"}]},{"id":"blk-67606","spans":[{"id":"spn-98234","text":"Yes (routing, kappa)"}]},{"id":"blk-67607","spans":[{"id":"spn-98235","text":"No"}]}],[{"id":"blk-67608","spans":[{"id":"spn-98236","marks":["bold"],"text":"Causal context"}]},{"id":"blk-67609","spans":[{"id":"spn-98237","text":"Yes (for outcome learning)"}]},{"id":"blk-67610","spans":[{"id":"spn-98238","text":"No"}]}],[{"id":"blk-67611","spans":[{"id":"spn-98239","marks":["bold"],"text":"Side effects"}]},{"id":"blk-67612","spans":[{"id":"spn-98240","text":"Updates access counts"}]},{"id":"blk-67613","spans":[{"id":"spn-98241","text":"None"}]}],[{"id":"blk-67614","spans":[{"id":"spn-98242","marks":["bold"],"text":"Use when"}]},{"id":"blk-67615","spans":[{"id":"spn-98243","text":"Acting on results (need causal tracking)"}]},{"id":"blk-67616","spans":[{"id":"spn-98244","text":"Checking duplicates, auditing, browsing"}]}]]},{"id":"blk-67617","kind":"paragraph","spans":[{"id":"spn-98245","marks":["bold"],"text":"Rule:"},{"id":"spn-98246","text":" Use "},{"id":"spn-98247","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-98248","text":" when you plan to act on results. Use "},{"id":"spn-98249","marks":["code"],"text":"consolidate(action: \"query\")"},{"id":"spn-98250","text":" for read-only inspection."}]},{"id":"blk-67618","kind":"heading","level":2,"spans":[{"id":"spn-98251","text":"Common Patterns"}]},{"id":"blk-67619","kind":"heading","level":3,"spans":[{"id":"spn-98252","text":"Duplicate prevention (check before storing)"}]},{"id":"blk-67620","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"the fact I want to store\", limit: 3)"},{"id":"blk-67621","items":[{"blocks":[{"id":"blk-67623","kind":"paragraph","spans":[{"id":"spn-98253","text":"similarity > 0.90 — "},{"id":"spn-98254","marks":["bold"],"text":"duplicate"},{"id":"spn-98255","text":" — update the existing node instead"}]}],"id":"blk-67622","kind":"list-item"},{"blocks":