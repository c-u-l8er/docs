d":"spn-50648","text":"Full edge lifecycle management: list, update weight/co_activation_count/decay_rate, or delete."}]},{"id":"blk-43849","kind":"heading","level":3,"spans":[{"id":"spn-50649","text":"Delete a node"}]},{"id":"blk-43850","kind":"code","language":"text","text":"act(action: \"delete_node\", node_id: \"<id>\")"},{"id":"blk-43851","kind":"paragraph","spans":[{"id":"spn-50650","text":"Remove a node and its connected edges from the graph."}]},{"id":"blk-43852","kind":"heading","level":2,"spans":[{"id":"spn-50651","text":"Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-43854","spans":[{"id":"spn-50652","text":"URI"}]},{"id":"blk-43855","spans":[{"id":"spn-50653","text":"What It Returns"}]}],"id":"blk-43853","kind":"table","rows":[[{"id":"blk-43856","spans":[{"id":"spn-50654","marks":["code"],"text":"graphonomous://runtime/health"}]},{"id":"blk-43857","spans":[{"id":"spn-50655","text":"Runtime health, service status, lightweight counts"}]}],[{"id":"blk-43858","spans":[{"id":"spn-50656","marks":["code"],"text":"graphonomous://goals/snapshot"}]},{"id":"blk-43859","spans":[{"id":"spn-50657","text":"Goal totals, status breakdown, serialized goals"}]}],[{"id":"blk-43860","spans":[{"id":"spn-50658","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-43861","spans":[{"id":"spn-50659","text":"Individual node details + connected edges"}]}],[{"id":"blk-43862","spans":[{"id":"spn-50660","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-43863","spans":[{"id":"spn-50661","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-43864","spans":[{"id":"spn-50662","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-43865","spans":[{"id":"spn-50663","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-43866","kind":"heading","level":2,"spans":[{"id":"spn-50664","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-50665","text":" vs "},{"id":"spn-50666",