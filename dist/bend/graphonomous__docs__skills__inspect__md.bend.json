{"bendscript":"0.1","blocks":[{"id":"blk-43821","kind":"paragraph","spans":[{"id":"spn-50589","text":"--- name: inspect description: Use when the user asks to \"show the graph\", \"list nodes\", \"what's stored\", \"check for duplicates\", \"trace edges\", \"get node\", \"browse memory\", or wants to query specific nodes/edges in the knowledge graph. Read-only graph inspection. For aggregate health diagnostics, use "},{"id":"spn-50590","marks":["code"],"text":"graph-health"},{"id":"spn-50591","text":" instead. Routes through "},{"id":"spn-50592","marks":["code"],"text":"consolidate"},{"id":"spn-50593","text":" and "},{"id":"spn-50594","marks":["code"],"text":"act"},{"id":"spn-50595","text":" machines. argument-hint: [list|get|edges|search|stats|traverse] [query or node_id] ---"}]},{"id":"blk-43822","kind":"heading","level":1,"spans":[{"id":"spn-50596","text":"Graph Inspection"}]},{"id":"blk-43823","kind":"paragraph","spans":[{"id":"spn-50597","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-43824","kind":"heading","level":2,"spans":[{"id":"spn-50598","text":"Arguments"}]},{"id":"blk-43825","kind":"paragraph","spans":[{"id":"spn-50599","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-43826","kind":"heading","level":2,"spans":[{"id":"spn-50600","text":"Operations"}]},{"id":"blk-43827","kind":"heading","level":3,"spans":[{"id":"spn-50601","text":"List nodes"}]},{"id":"blk-43828","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-43829","kind":"paragraph","spans":[{"id":"spn-50602","text":"Browse what's stored. Filter by "},{"id":"spn-50603","marks":["code"],"text":"node_type"},{"id":"spn-50604","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-50605","marks":["code"],"text":"min_confidence"},{"id":"spn-50606","text":", "},{"id":"spn-50607","marks":["code"],"text":"max_confidence"},{"id":"spn-50608","text":", "},{"id":"spn-50609","marks":["code"],"text":"limit"},{"id":"spn-50610","text":"."}]},{"id":"blk-43830","kind":"heading","level":3,"spans":[{"id":"spn-50611","text":"Get a specific node"}]},{"id":"blk-43831","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-43832","kind":"paragraph","spans":[{"id":"spn-50612","text":"Returns: "},{"id":"spn-50613","marks":["code"],"text":"content"},{"id":"spn-50614","text":", "},{"id":"spn-50615","marks":["code"],"text":"confidence"},{"id":"spn-50616","text":", "},{"id":"spn-50617","marks":["code"],"text":"source"},{"id":"spn-50618","text":", "},{"id":"spn-50619","marks":["code"],"text":"metadata"},{"id":"spn-50620","text":", "},{"id":"spn-50621","marks":["code"],"text":"node_type"},{"id":"spn-50622","text":", "},{"id":"spn-50623","marks":["code"],"text":"timescale"},{"id":"spn-50624","text":" (fast/medium/slow/glacial), "},{"id":"spn-50625","marks":["code"],"text":"access_count"},{"id":"spn-50626","text":", "},{"id":"spn-50627","marks":["code"],"text":"created_at"},{"id":"spn-50628","text":", "},{"id":"spn-50629","marks":["code"],"text":"updated_at"},{"id":"spn-50630","text":"."}]},{"id":"blk-43833","kind":"heading","level":3,"spans":[{"id":"spn-50631","text":"Trace edges from a node"}]},{"id":"blk-43834","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-43835","kind":"paragraph","spans":[{"id":"spn-50632","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-43836","kind":"heading","level":3,"spans":[{"id":"spn-50633","text":"Similarity search"}]},{"id":"blk-43837","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-43838","kind":"para