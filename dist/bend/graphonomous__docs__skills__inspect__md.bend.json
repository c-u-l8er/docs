{"bendscript":"0.1","blocks":[{"id":"blk-43335","kind":"paragraph","spans":[{"id":"spn-49469","text":"--- name: inspect description: Use when the user asks to \"show the graph\", \"list nodes\", \"what's stored\", \"check for duplicates\", \"trace edges\", \"get node\", \"browse memory\", or wants to query specific nodes/edges in the knowledge graph. Read-only graph inspection. For aggregate health diagnostics, use "},{"id":"spn-49470","marks":["code"],"text":"graph-health"},{"id":"spn-49471","text":" instead. Routes through "},{"id":"spn-49472","marks":["code"],"text":"consolidate"},{"id":"spn-49473","text":" and "},{"id":"spn-49474","marks":["code"],"text":"act"},{"id":"spn-49475","text":" machines. argument-hint: [list|get|edges|search|stats|traverse] [query or node_id] ---"}]},{"id":"blk-43336","kind":"heading","level":1,"spans":[{"id":"spn-49476","text":"Graph Inspection"}]},{"id":"blk-43337","kind":"paragraph","spans":[{"id":"spn-49477","text":"Read-only inspection of the knowledge graph — no side effects."}]},{"id":"blk-43338","kind":"heading","level":2,"spans":[{"id":"spn-49478","text":"Arguments"}]},{"id":"blk-43339","kind":"paragraph","spans":[{"id":"spn-49479","text":"Operation and target: $ARGUMENTS"}]},{"id":"blk-43340","kind":"heading","level":2,"spans":[{"id":"spn-49480","text":"Operations"}]},{"id":"blk-43341","kind":"heading","level":3,"spans":[{"id":"spn-49481","text":"List nodes"}]},{"id":"blk-43342","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"list_nodes\", node_type: \"semantic\", min_confidence: 0.5, limit: 20)"},{"id":"blk-43343","kind":"paragraph","spans":[{"id":"spn-49482","text":"Browse what's stored. Filter by "},{"id":"spn-49483","marks":["code"],"text":"node_type"},{"id":"spn-49484","text":" (semantic, procedural, episodic, temporal, outcome, goal), "},{"id":"spn-49485","marks":["code"],"text":"min_confidence"},{"id":"spn-49486","text":", "},{"id":"spn-49487","marks":["code"],"text":"max_confidence"},{"id":"spn-49488","text":", "},{"id":"spn-49489","marks":["code"],"text":"limit"},{"id":"spn-49490","text":"."}]},{"id":"blk-43344","kind":"heading","level":3,"spans":[{"id":"spn-49491","text":"Get a specific node"}]},{"id":"blk-43345","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_node\", node_id: \"<id>\")"},{"id":"blk-43346","kind":"paragraph","spans":[{"id":"spn-49492","text":"Returns: "},{"id":"spn-49493","marks":["code"],"text":"content"},{"id":"spn-49494","text":", "},{"id":"spn-49495","marks":["code"],"text":"confidence"},{"id":"spn-49496","text":", "},{"id":"spn-49497","marks":["code"],"text":"source"},{"id":"spn-49498","text":", "},{"id":"spn-49499","marks":["code"],"text":"metadata"},{"id":"spn-49500","text":", "},{"id":"spn-49501","marks":["code"],"text":"node_type"},{"id":"spn-49502","text":", "},{"id":"spn-49503","marks":["code"],"text":"timescale"},{"id":"spn-49504","text":" (fast/medium/slow/glacial), "},{"id":"spn-49505","marks":["code"],"text":"access_count"},{"id":"spn-49506","text":", "},{"id":"spn-49507","marks":["code"],"text":"created_at"},{"id":"spn-49508","text":", "},{"id":"spn-49509","marks":["code"],"text":"updated_at"},{"id":"spn-49510","text":"."}]},{"id":"blk-43347","kind":"heading","level":3,"spans":[{"id":"spn-49511","text":"Trace edges from a node"}]},{"id":"blk-43348","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"get_edges\", node_id: \"<id>\")"},{"id":"blk-43349","kind":"paragraph","spans":[{"id":"spn-49512","text":"Returns both outgoing and incoming edges with types and weights. Useful for tracing causal chains, finding contradictions, and understanding provenance."}]},{"id":"blk-43350","kind":"heading","level":3,"spans":[{"id":"spn-49513","text":"Similarity search"}]},{"id":"blk-43351","kind":"code","language":"text","text":"consolidate(action: \"query\", operation: \"similarity_search\", query: \"<text>\", limit: 5)"},{"id":"blk-43352","kind":"paragraph","spans":[{"id":"spn-49514","text":"Embedding-based search. Returns nodes with similarity scores."}]},{"id":"blk-43353","kind":"paragraph","spans":[{"id":"spn-49515","marks":["bold"],"text":"Operation aliases:"},{"id":"spn-49516","text":" "},{"id":"spn-49517","marks":["code"],"text":"\"get\""},{"id":"spn-49518","text":", "},{"id":"spn-49519","marks":["code"],"text":"\"edges\""},{"id":"spn-49520","text":", "},{"id":"spn-49521","marks":["code"],"text":"\"list\""},{"id":"spn-49522","text":" also work as shorthand."}]},{"id":"blk-43354","kind":"heading","level":3,"spans":[{"id":"spn-49523","text":"Graph traverse (BFS walk)"}]},{"id":"blk-43355","kind":"code","language":"text","text":"consolidate(action: \"traverse\", start_node_id: \"<id>\", max_depth: 3, relationship_types: \"causal,supports\")"},{"id":"blk-43356","kind":"paragraph","spans":[{"id":"spn-49524","text":"BFS walk from a starting node. Returns visited nodes, edges, depth map, and traversal metadata. Optionally filter by relationship types (comma-separated)."}]},{"id":"blk-43357","kind":"heading","level":3,"spans":[{"id":"spn-49525","text":"Graph stats (aggregate health)"}]},{"id":"blk-43358","kind":"code","language":"text","text":"consolidate(action: \"stats\")"},{"id":"blk-43359","kind":"paragraph","spans":[{"id":"spn-49526","text":"Returns node/edge counts, type distributions, confidence statistics (mean/min/max/std_dev), and orphan count (nodes with no edges). No parameters required."}]},{"id":"blk-43360","kind":"heading","level":3,"spans":[{"id":"spn-49527","text":"Manage edges"}]},{"id":"blk-43361","kind":"code","language":"text","text":"act(action: \"manage_edge\", operation: \"list_all\")\nact(action: \"manage_edge\", operation: \"list_for_node\", node_id: \"<id>\")\nact(action: \"manage_edge\", operation: \"update\", edge_id: \"<id>\", weight: 0.9, co_activation_count: 5)\nact(action: \"manage_edge\", operation: \"delete\", edge_id: \"<id>\")"},{"id":"blk-43362","kind":"paragraph","spans":[{"id":"spn-49528","text":"Full edge lifecycle management: list, update weight/co_activation_count/decay_rate, or delete."}]},{"id":"blk-43363","kind":"heading","level":3,"spans":[{"id":"spn-49529","text":"Delete a node"}]},{"id":"blk-43364","kind":"code","language":"text","text":"act(action: \"delete_node\", node_id: \"<id>\")"},{"id":"blk-43365","kind":"paragraph","spans":[{"id":"spn-49530","text":"Remove a node and its connected edges from the graph."}]},{"id":"blk-43366","kind":"heading","level":2,"spans":[{"id":"spn-49531","text":"Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-43368","spans":[{"id":"spn-49532","text":"URI"}]},{"id":"blk-43369","spans":[{"id":"spn-49533","text":"What It Returns"}]}],"id":"blk-43367","kind":"table","rows":[[{"id":"blk-43370","spans":[{"id":"spn-49534","marks":["code"],"text":"graphonomous://runtime/health"}]},{"id":"blk-43371","spans":[{"id":"spn-49535","text":"Runtime health, service status, lightweight counts"}]}],[{"id":"blk-43372","spans":[{"id":"spn-49536","marks":["code"],"text":"graphonomous://goals/snapshot"}]},{"id":"blk-43373","spans":[{"id":"spn-49537","text":"Goal totals, status breakdown, serialized goals"}]}],[{"id":"blk-43374","spans":[{"id":"spn-49538","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-43375","spans":[{"id":"spn-49539","text":"Individual node details + connected edges"}]}],[{"id":"blk-43376","spans":[{"id":"spn-49540","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-43377","spans":[{"id":"spn-49541","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-43378","spans":[{"id":"spn-49542","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-43379","spans":[{"id":"spn-49543","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-43380","kind":"heading","level":2,"spans":[{"id":"spn-49544","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-49545","text":" vs "},{"id":"spn-49546","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\")"}]},{"head":[{"id":"blk-43382","spans":[{"id":"spn-49547","text":""}]},{"id":"blk-43383","spans":[{"id":"spn-49548","marks":["code"],"text":"retrieve(action: \"context\")"}]},{"id":"blk-43384","spans":[{"id":"spn-49549","marks":["code"],"text":"consolidate(action: \"query\", operation: \"similarity_search\")"}]}],"id":"blk-43381","kind":"table","rows":[[{"id":"blk-43385","spans":[{"id":"spn-49550","marks":["bold"],"text":"Neighborhood expansion"}]},{"id":"blk-43386","spans":[{"id":"spn-49551","text":"Yes (hops)"}]},{"id":"blk-43387","spans":[{"id":"spn-49552","text":"No"}]}],[{"id":"blk-43388","spans":[{"id":"spn-49553","marks":["bold"],"text":"Topology annotations"}]},{"id":"blk-43389","spans":[{"id":"spn-49554","text":"Yes (routing, kappa)"}]},{"id":"blk-43390","spans":[{"id":"spn-49555","text":"No"}]}],[{"id":"blk-43391","spans":[{"id":"spn-49556","marks":["bold"],"text":"Causal context"}]},{"id":"blk-43392","spans":[{"id":"spn-49557","text":"Yes (for outcome learning)"}]},{"id":"blk-43393","spans":[{"id":"spn-49558","text":"No"}]}],[{"id":"blk-43394","spans":[{"id":"spn-49559","marks":["bold"],"text":"Side effects"}]},{"id":"blk-43395","spans":[{"id":"spn-49560","text":"Updates access counts"}]},{"id":"blk-43396","spans":[{"id":"spn-49561","text":"None"}]}],[{"id":"blk-43397","spans":[{"id":"spn-49562","marks":["bold"],"text":"Use when"}]},{"id":"blk-43398","spans":[{"id":"spn-49563","text":"Acting on results (need causal tracking)"}]},{"id":"blk-43399","spans":[{"id":"spn-49564","text":"Checking duplicates, auditing, browsing"}]}]]},{"id":"blk-43400","kind":"paragraph","spans":[{"id":"spn-49565","marks":["bold"],"text":"Rule:"},{"id":"spn-49566","text":" Use "},{"id":"spn-49567","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-49568","text":" when you plan to act on results. Use "},{"id":"spn-49569","marks":["code"],"text":"consolidate(action: \"query\")