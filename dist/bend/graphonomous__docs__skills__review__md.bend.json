{"bendscript":"0.1","blocks":[{"id":"blk-75323","kind":"heading","level":1,"spans":[{"id":"spn-138074","text":"Coverage and Review"}]},{"id":"blk-75324","kind":"paragraph","spans":[{"id":"spn-138075","text":"Evaluate whether you know enough to act on a goal, or need to learn more."}]},{"id":"blk-75325","kind":"heading","level":2,"spans":[{"id":"spn-138076","text":"Arguments"}]},{"id":"blk-75326","kind":"paragraph","spans":[{"id":"spn-138077","text":"Goal to review: $ARGUMENTS"}]},{"id":"blk-75327","kind":"heading","level":2,"spans":[{"id":"spn-138078","text":"Review Coverage"}]},{"id":"blk-75328","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: {\n    \"retrieved_nodes\": [{\"node_id\": \"abc\", \"confidence\": 0.8, \"similarity\": 0.85}],\n    \"outcomes\": [{\"action_id\": \"fix-auth\", \"status\": \"success\", \"confidence\": 0.9}],\n    \"contradictions\": 0,\n    \"knowledge_gaps\": [\"How does the rate limiter interact with auth?\"],\n    \"supporting_evidence_count\": 5,\n    \"coverage_estimate\": 0.7\n  },\n  apply_decision: true\n)"},{"id":"blk-75329","kind":"paragraph","spans":[{"id":"spn-138079","marks":["bold"],"text":"Returns:"},{"id":"spn-138080","text":" "},{"id":"spn-138081","marks":["code"],"text":"decision"},{"id":"spn-138082","text":" (act/learn/escalate), "},{"id":"spn-138083","marks":["code"],"text":"coverage_score"},{"id":"spn-138084","text":", "},{"id":"spn-138085","marks":["code"],"text":"uncertainty_score"},{"id":"spn-138086","text":", "},{"id":"spn-138087","marks":["code"],"text":"risk_score"},{"id":"spn-138088","text":", "},{"id":"spn-138089","marks":["code"],"text":"rationale"},{"id":"spn-138090","text":", "},{"id":"spn-138091","marks":["code"],"text":"applied_review"},{"id":"spn-138092","text":", "},{"id":"spn-138093","marks":["code"],"text":"transition"},{"id":"spn-138094","text":" (if apply_decision was true), "},{"id":"spn-138095","marks":["code"],"text":"evaluation"},{"id":"spn-138096","text":"."}]},{"id":"blk-75330","kind":"heading","level":2,"spans":[{"id":"spn-138097","text":"Decision Policy"}]},{"id":"blk-75331","items":[{"blocks":[{"id":"blk-75333","kind":"paragraph","spans":[{"id":"spn-138098","marks":["bold"],"text":"act"},{"id":"spn-138099","text":" — coverage adequate, proceed with execution"}]}],"id":"blk-75332","kind":"list-item"},{"blocks":[{"id":"blk-75335","kind":"paragraph","spans":[{"id":"spn-138100","marks":["bold"],"text":"learn"},{"id":"spn-138101","text":" — gaps exist, gather more info, then re-review"}]}],"id":"blk-75334","kind":"list-item"},{"blocks":[{"id":"blk-75337","kind":"paragraph","spans":[{"id":"spn-138102","marks":["bold"],"text":"escalate"},{"id":"spn-138103","text":" — critically low coverage or high risk, mark blocked, get external help"}]}],"id":"blk-75336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75338","kind":"paragraph","spans":[{"id":"spn-138104","text":"If "},{"id":"spn-138105","marks":["code"],"text":"apply_decision: true"},{"id":"spn-138106","text":", the goal auto-transitions: act -> active, learn -> proposed, escalate -> blocked."}]},{"id":"blk-75339","kind":"heading","level":2,"spans":[{"id":"spn-138107","text":"Tuning Options"}]},{"id":"blk-75340","kind":"paragraph","spans":[{"id":"spn-138108","text":"Pass "},{"id":"spn-138109","marks":["code"],"text":"options"},{"id":"spn-138110","text":" to customize evaluation thresholds:"}]},{"id":"blk-75341","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: { ... },\n  options: {\n    \"top_k\": 10,\n    \"min_context_nodes\": 3,\n    \"freshness_half_life_hours\": 48,\n    \"graph_support_target\": 0.6,\n    \"weights\": {\"coverage\": 0.4, \"confidence\": 0.3, \"freshness\": 0.2, \"support\": 0.1},\n    \"thresholds\": {\"act\": 0.7, \"learn\": 0.4}\n  }\n)"},{"id":"blk-75342","items":[{"blocks":[{"id":"blk-75344","kind":"paragraph","spans":[{"id":"spn-138111","marks":["code"],"