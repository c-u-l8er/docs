[{"id":"spn-138169","text":"Pre-action gate"}]},{"id":"blk-75395","kind":"paragraph","spans":[{"id":"spn-138170","marks":["code"],"text":"retrieve"},{"id":"spn-138171","text":" -> build signal -> "},{"id":"spn-138172","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-138173","text":" -> if "},{"id":"spn-138174","marks":["code"],"text":"act"},{"id":"spn-138175","text":", proceed; if "},{"id":"spn-138176","marks":["code"],"text":"learn"},{"id":"spn-138177","text":", gather more; if "},{"id":"spn-138178","marks":["code"],"text":"escalate"},{"id":"spn-138179","text":", block."}]},{"id":"blk-75396","kind":"heading","level":3,"spans":[{"id":"spn-138180","text":"Iterative review loop"}]},{"id":"blk-75397","kind":"paragraph","spans":[{"id":"spn-138181","text":"After a "},{"id":"spn-138182","marks":["code"],"text":"learn"},{"id":"spn-138183","text":" decision: retrieve more -> store findings -> re-review -> eventually reach "},{"id":"spn-138184","marks":["code"],"text":"act"},{"id":"spn-138185","text":" or "},{"id":"spn-138186","marks":["code"],"text":"escalate"},{"id":"spn-138187","text":"."}]},{"id":"blk-75398","kind":"heading","level":3,"spans":[{"id":"spn-138188","text":"Post-failure review"}]},{"id":"blk-75399","kind":"paragraph","spans":[{"id":"spn-138189","text":"After "},{"id":"spn-138190","marks":["code"],"text":"learn(action: \"from_outcome\", status: \"failure\")"},{"id":"spn-138191","text":": re-review the goal to reassess coverage with the new negative signal."}]},{"id":"blk-75400","kind":"heading","level":3,"spans":[{"id":"spn-138192","text":"High-stakes review (strict thresholds)"}]},{"id":"blk-75401","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"<id>\", signal: { ... }, options: {\"thresholds\": {\"act\": 0.85, \"learn\": 0.5}})"},{"id":"blk-75402","kind":"heading","level":2,"spans":[{"id":"spn-138193","text":"Anti-patterns to avoid"}]},{"id":"blk-75403","items":[{"blocks":[{"id":"blk-75405","kind":"parag