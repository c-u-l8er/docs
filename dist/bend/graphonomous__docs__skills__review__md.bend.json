{"bendscript":"0.1","blocks":[{"id":"blk-43012","kind":"paragraph","spans":[{"id":"spn-48032","text":"--- name: review description: Use before high-stakes actions, after learning phases, after outcome failures, or when the user asks \"do we know enough?\", \"should we proceed?\", \"review coverage\", \"check readiness\", \"coverage check\". Epistemic self-modeling — decides act/learn/escalate. Routes through "},{"id":"spn-48033","marks":["code"],"text":"route"},{"id":"spn-48034","text":" and "},{"id":"spn-48035","marks":["code"],"text":"retrieve"},{"id":"spn-48036","text":" machines. argument-hint: <goal_id> ---"}]},{"id":"blk-43013","kind":"heading","level":1,"spans":[{"id":"spn-48037","text":"Coverage and Review"}]},{"id":"blk-43014","kind":"paragraph","spans":[{"id":"spn-48038","text":"Evaluate whether you know enough to act on a goal, or need to learn more."}]},{"id":"blk-43015","kind":"heading","level":2,"spans":[{"id":"spn-48039","text":"Arguments"}]},{"id":"blk-43016","kind":"paragraph","spans":[{"id":"spn-48040","text":"Goal to review: $ARGUMENTS"}]},{"id":"blk-43017","kind":"heading","level":2,"spans":[{"id":"spn-48041","text":"Review Coverage"}]},{"id":"blk-43018","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: {\n    \"retrieved_nodes\": [{\"node_id\": \"abc\", \"confidence\": 0.8, \"similarity\": 0.85}],\n    \"outcomes\": [{\"action_id\": \"fix-auth\", \"status\": \"success\", \"confidence\": 0.9}],\n    \"contradictions\": 0,\n    \"knowledge_gaps\": [\"How does the rate limiter interact with auth?\"],\n    \"supporting_evidence_count\": 5,\n    \"coverage_estimate\": 0.7\n  },\n  apply_decision: true\n)"},{"id":"blk-43019","kind":"paragraph","spans":[{"id":"spn-48042","marks":["bold"],"text":"Returns:"},{"id":"spn-48043","text":" "},{"id":"spn-48044","marks":["code"],"text":"decision"},{"id":"spn-48045","text":" (act/learn/escalate), "},{"id":"spn-48046","marks":["code"],"text":"coverage_score"},{"id":"spn-48047","text":", "},{"id":"spn-48048","marks":["code"],"text":"uncertainty_score"},{"id":"spn-48049","text":", "},{"id":"spn-48050","marks":["code"],"text":"risk_score"},{"id":"spn-48051","text":", "},{"id":"spn-48052","marks":["code"],"text":"rationale"},{"id":"spn-48053","text":", "},{"id":"spn-48054","marks":["code"],"text":"applied_review"},{"id":"spn-48055","text":", "},{"id":"spn-48056","marks":["code"],"text":"transition"},{"id":"spn-48057","text":" (if apply_decision was true), "},{"id":"spn-48058","marks":["code"],"text":"evaluation"},{"id":"spn-48059","text":"."}]},{"id":"blk-43020","kind":"heading","level":2,"spans":[{"id":"spn-48060","text":"Decision Policy"}]},{"id":"blk-43021","items":[{"blocks":[{"id":"blk-43023","kind":"paragraph","spans":[{"id":"spn-48061","marks":["bold"],"text":"act"},{"id":"spn-48062","text":" — coverage adequate, proceed with execution"}]}],"id":"blk-43022","kind":"list-item"},{"blocks":[{"id":"blk-43025","kind":"paragraph","spans":[{"id":"spn-48063","marks":["bold"],"text":"learn"},{"id":"spn-48064","text":" — gaps exist, gather more info, then re-review"}]}],"id":"blk-43024","kind":"list-item"},{"blocks":[{"id":"blk-43027","kind":"paragraph","spans":[{"id":"spn-48065","marks":["bold"],"text":"escalate"},{"id":"spn-48066","text":" — critically low coverage or high risk, mark blocked, get external help"}]}],"id":"blk-43026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43028","kind":"paragraph","spans":[{"id":"spn-48067","text":"If "},{"id":"spn-48068","marks":["code"],"text":"apply_decision: true"},{"id":"spn-48069","text":", the goal auto-transitions: act -> active, learn -> proposed, escalate -> blocked."}]},{"id":"blk-43029","kind":"heading","level":2,"spans":[{"id":"spn-48070","text":"Tuning Options"}]},{"id":"blk-43030","kind":"paragraph","spans":[{"id":"spn-48071","text":"Pass "},{"id":"spn-48072","marks":["code"],"text":"options"},{"id":"spn-48073","text":" to customize evaluation thresholds:"}]},{"id":"blk-43031","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: { ... },\n  options: {\n    \"top_k\": 10,\n    \"min_context_nodes\": 3,\n    \"freshness_half_life_hours\": 48,\n    \"graph_support_target\": 0.6,\n    \"weights\": {\"coverage\": 0.4, \"confidence\": 0.3, \"freshness\": 0.2, \"support\": 0.1},\n    \"thresholds\": {\"act\": 0.7, \"learn\": 0.4}\n  }\n)"},{"id":"blk-43032","items":[{"blocks":[{"id":"blk-43034","kind":"paragraph","spans":[{"id":"spn-48074","marks":["code"],"text":"top_k"},{"id":"spn-48075","text":" — how many top nodes to consider for scoring"}]}],"id":"blk-43033","kind":"list-item"},{"blocks":[{"id":"blk-43036","kind":"paragraph","spans":[{"id":"spn-48076","marks":["code"],"text":"min_context_nodes"},{"id":"spn-48077","text":" — minimum linked nodes needed for adequate coverage"}]}],"id":"blk-43035","kind":"list-item"},{"blocks":[{"id":"blk-43038","kind":"paragraph","spans":[{"id":"spn-48078","marks":["code"],"text":"freshness_half_life_hours"},{"id":"spn-48079","text":" — decay rate for old evidence"}]}],"id":"blk-43037","kind":"list-item"},{"blocks":[{"id":"blk-43040","kind":"paragraph","spans":[{"id":"spn-48080","marks":["code"],"text":"graph_support_target"},{"id":"spn-48081","text":" — target ratio of supporting edges"}]}],"id":"blk-43039","kind":"list-item"},{"blocks":[{"id":"blk-43042","kind":"paragraph","spans":[{"id":"spn-48082","marks":["code"],"text":"weights"},{"id":"spn-48083","text":" — custom scoring dimension weights"}]}],"id":"blk-43041","kind":"list-item"},{"blocks":[{"id":"blk-43044","kind":"paragraph","spans":[{"id":"spn-48084","marks":["code"],"text":"thresholds"},{"id":"spn-48085","text":" — custom decision boundaries (above act threshold = act, below learn threshold = escalate)"}]}],"id":"blk-43043","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43045","kind":"heading","level":2,"spans":[{"id":"spn-48086","text":"Building Honest Signals"}]},{"id":"blk-43046","kind":"paragraph","spans":[{"id":"spn-48087","text":"Build the "},{"id":"spn-48088","marks":["code"],"text":"signal"},{"id":"spn-48089","text":" from REAL retrieval data — never fabricate:"}]},{"id":"blk-43047","kind":"paragraph","spans":[{"id":"spn-48090","text":"1. "},{"id":"spn-48091","marks":["bold"],"text":"Always retrieve first"},{"id":"spn-48092","text":" — run "},{"id":"spn-48093","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-48094","text":" before building the signal 2. "},{"id":"spn-48095","marks":["code"],"text":"retrieved_nodes"},{"id":"spn-48096","text":" — from actual results (include node_id, confidence, similarity) 3. "},{"id":"spn-48097","marks":["code"],"text":"outcomes"},{"id":"spn-48098","text":" — from actual "},{"id":"spn-48099","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-48100","text":" calls 4. "},{"id":"spn-48101","marks":["code"],"text":"contradictions"},{"id":"spn-48102","text":" — count "},{"id":"spn-48103","marks":["code"],"text":"contradicts"},{"id":"spn-48104","text":" edges found during inspection 5. "},{"id":"spn-48105","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-48106","text":" — questions the graph couldn't answer 6. "},{"id":"spn-48107","marks":["code"],"text":"supporting_evidence_count"},{"id":"spn-48108","text":" — number of "},{"id":"spn-48109","marks":["code"],"text":"supports"},{"id":"spn-48110","text":" edges found 7. "},{"id":"spn-48111","marks":["code"],"text":"coverage_estimate"},{"id":"spn-48112","text":" — your honest assessment (0.0-1.0)"}]},{"id":"blk-43048","kind":"heading","level":2,"spans":[{"id":"spn-48113","text":"Standalone Coverage Query (No Goal Required)"}]},{"id":"blk-43049","kind":"paragraph","spans":[{"id":"spn-48114","text":"For quick coverage assessment without a goal:"}]},{"id":"blk-43050","kind":"code","language":"text","text":"retrieve(action: \"coverage\", query: \"auth middleware token validation\", limit: 10, expansion_hops: 1)"},{"id":"blk-43051","kind":"paragraph","spans":[{"id":"spn-48115","text":"Returns coverage score, decision (act/learn/escalate), relevant nodes, and confidence stats. Use this when you want a fast coverage check without creating or linking to a goal."}]},{"id":"blk-43052","kind":"paragraph","spans":[{"id":"spn-48116","marks":["bold"],"text":"`retrieve(action: \"coverage\")` vs `route(action: \"review_goal\")`:"}]},{"head":[{"id":"blk-43054","spans":[{"id":"spn-48117","text":""}]},{"id":"blk-43055","spans":[{"id":"spn-48118","marks":["code"],"text":"retrieve(action: \"coverage\")"}]},{"id":"blk-43056","spans":[{"id":"spn-48119","marks":["code"],"text":"route(action: \"review_goal\")"}]}],"id":"blk-43053","kind":"table","rows":[[{"id":"blk-43057","spans":[{"id":"spn-48120","marks":["bold"],"text":"Requires goal"}]},{"id":"blk-43058","spans":[{"id":"spn-48121","text":"No"}]},{"id":"blk-43059","spans":[{"id":"spn-48122","text":"Yes"}]}],[{"id":"blk-43060","spans":[{"id":"spn-48123","marks":["bold"],"text":"Requires signal"}]},{"id":"blk-43061","spans":[{"id":"spn-48124","text":"No (auto-retrieves)"}]},{"id":"blk-43062","spans":[{"id":"spn-48125","text":"Yes (you build the signal)"}]}],[{"id":"blk-43063","spans":[{"id":"spn-48126","marks":["bold"],"text":"State transitions"}]},{"id":"blk-43064","spans":[{"id":"spn-48127","text":"None"}]},{"id":"blk-43065","spans":[{"id":"spn-48128","text":"Optional (apply_decision)"}]}],[{"id":"blk-43066","spans":[{"id":"spn-48129","marks":["bold"],"text":"Use when"}]},{"id":"blk-43067","spans":[{"id":"spn-48130","text":"Quick pre-action check"}]},{"id":"blk-43068","spans":[{"id":"spn-48131","text":"Formal goal-driven review"}]}]]},{"id":"blk-43069","kind":"heading","level":2,"spans":[{"id":"spn-48132","text":"Workflow Patterns"}]},{"id":"blk-43070","kind":"heading","level":3,"spans":[{"id":"spn-48133","text":"Pre-action gate"}]},{"id":"blk-43071","kind":"paragraph","spans":[{"id":"spn-48134","marks":["code"],"text":"retrieve"},{"id":"spn-48135","text":" -> build signal -> "},{"id":"spn-48136","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-48137","text":" -> if "},{"id":"spn-48138","marks":["code"],"text":"act"},{"id":"spn-48139","text":", proceed; if "},{"id":"spn-48140","marks":["code"],"text":"learn"},{"id":"spn-48141","text":", gather more; if "},{"id":"spn-48142","marks":["code"],"text":"escalate"},{"id":"spn-48143","text":", block."}]},{"id":"blk-43072","kind":"heading","level":3,"spans":[{"id":"spn-48144","text":"Iterative review loop"}]},{"id":"blk-43073","kind":"paragraph","spans":[{"id":"spn-48145","text":"After a "},{"id":"spn-48146","marks":["code"],"text":"learn"},{"id":"spn-48147","text":" decision: retrieve more -> store findings -> re-review -> eventually reach "},{"id":"spn-48148","marks":["code"],"text":"act"},{"id":"spn-48149","text":" or "},{"id":"spn-48150","marks":["code"],"text":"escalate"},{"id":"spn-48151","text":"."}]},{"id":"blk-43074","kind":"heading","level":3,"spans":[{"id":"spn-48152","text":"Post-failure review"}]},{"id":"blk-43075","kind":"paragraph","spans":[{"id":"spn-48153","text":"After "},{"id":"spn-48154","marks":["code"],"text":"learn(action: \"from_outcome\", status: \"failure\")"},{"id":"spn-48155","text":": re-review the goal to reassess coverage with the new negative signal."}]},{"id":"blk-43076","kind":"heading","level":3,"spans":[{"id":"spn-48156","text":"High-stakes review (strict thresholds)"}]},{"id":"blk-43077","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"<id>\", signal: { ... }, options: {\"thresholds\": {\"act\": 0.85, \"learn\": 0.5}})"},{"id":"blk-43078","kind":"heading","level":2,"spans":[{"id":"spn-48157","text":"Anti-patterns to avoid"}]},{"id":"blk-43079","items":[{"blocks":[{"id":"blk-43081","kind":"paragraph","spans":[{"id":"spn-48158","text":"Signal fabrication — building signals from made-up data instead of real retrieval"}]}],"id":"blk-43080","kind":"list-item"},{"blocks":[{"id":"blk-43083","kind":"paragraph","spans":[{"id":"spn-48159","text":"Review theater — calling review_goal but ignoring the act/learn/escalate decision"}]}],"id":"blk-43082","kind":"list-item"},{"blocks":[{"id":"blk-43085","kind":"paragraph","spans":[{"id":"spn-48160","text":"Skipping review before high-stakes actions"}]}],"id":"blk-43084","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierawguqxab3oatmytvrcpeduik7ivspanasajhk4gdp5ddaf3pmc3kq","vocabulary":"ampersand.docs.fs.v1"}