{"bendscript":"0.1","blocks":[{"id":"blk-44094","kind":"paragraph","spans":[{"id":"spn-50955","text":"--- name: review description: Use before high-stakes actions, after learning phases, after outcome failures, or when the user asks \"do we know enough?\", \"should we proceed?\", \"review coverage\", \"check readiness\", \"coverage check\". Epistemic self-modeling — decides act/learn/escalate. Routes through "},{"id":"spn-50956","marks":["code"],"text":"route"},{"id":"spn-50957","text":" and "},{"id":"spn-50958","marks":["code"],"text":"retrieve"},{"id":"spn-50959","text":" machines. argument-hint: <goal_id> ---"}]},{"id":"blk-44095","kind":"heading","level":1,"spans":[{"id":"spn-50960","text":"Coverage and Review"}]},{"id":"blk-44096","kind":"paragraph","spans":[{"id":"spn-50961","text":"Evaluate whether you know enough to act on a goal, or need to learn more."}]},{"id":"blk-44097","kind":"heading","level":2,"spans":[{"id":"spn-50962","text":"Arguments"}]},{"id":"blk-44098","kind":"paragraph","spans":[{"id":"spn-50963","text":"Goal to review: $ARGUMENTS"}]},{"id":"blk-44099","kind":"heading","level":2,"spans":[{"id":"spn-50964","text":"Review Coverage"}]},{"id":"blk-44100","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: {\n    \"retrieved_nodes\": [{\"node_id\": \"abc\", \"confidence\": 0.8, \"similarity\": 0.85}],\n    \"outcomes\": [{\"action_id\": \"fix-auth\", \"status\": \"success\", \"confidence\": 0.9}],\n    \"contradictions\": 0,\n    \"knowledge_gaps\": [\"How does the rate limiter interact with auth?\"],\n    \"supporting_evidence_count\": 5,\n    \"coverage_estimate\": 0.7\n  },\n  apply_decision: true\n)"},{"id":"blk-44101","kind":"paragraph","spans":[{"id":"spn-50965","marks":["bold"],"text":"Returns:"},{"id":"spn-50966","text":" "},{"id":"spn-50967","marks":["code"],"text":"decision"},{"id":"spn-50968","text":" (act/learn/escalate), "},{"id":"spn-50969","marks":["code"],"text":"coverage_score"},{"id":"spn-50970","text":", "},{"id":"spn-50971","marks":["code"],"text":"uncertainty_score"},{"id":"spn-50972","text":", "},{"id":"spn-50973","marks":["code"],"text":"risk_score"},{"id":"spn-50974","text":", "},{"id":"spn-50975","marks":["code"],"text":"rationale"},{"id":"spn-50976","text":", "},{"id":"spn-50977","marks":["code"],"text":"applied_review"},{"id":"spn-50978","text":", "},{"id":"spn-50979","marks":["code"],"text":"transition"},{"id":"spn-50980","text":" (if apply_decision was true), "},{"id":"spn-50981","marks":["code"],"text":"evaluation"},{"id":"spn-50982","text":"."}]},{"id":"blk-44102","kind":"heading","level":2,"spans":[{"id":"spn-50983","text":"Decision Policy"}]},{"id":"blk-44103","items":[{"blocks":[{"id":"blk-44105","kind":"paragraph","spans":[{"id":"spn-50984","marks":["bold"],"text":"act"},{"id":"spn-50985","text":" — coverage adequate, proceed with execution"}]}],"id":"blk-44104","kind":"list-item"},{"blocks":[{"id":"blk-44107","kind":"paragraph","spans":[{"id":"spn-50986","marks":["bold"],"text":"learn"},{"id":"spn-50987","text":" — gaps exist, gather more info, then re-review"}]}],"id":"blk-44106","kind":"list-item"},{"blocks":[{"id":"blk-44109","kind":"paragraph","spans":[{"id":"spn-50988","marks":["bold"],"text":"escalate"},{"id":"spn-50989","text":" — critically low coverage or high risk, mark blocked, get external help"}]}],"id":"blk-44108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44110","kind":"paragraph","spans":[{"id":"spn-50990","text":"If "},{"id":"spn-50991","marks":["code"],"text":"apply_decision: true"},{"id":"spn-50992","text":", the goal auto-transitions: act -> active, learn -> proposed, escalate -> blocked."}]},{"id":"blk-44111","kind":"heading","level":2,"spans":[{"id":"spn-50993","text":"Tuning Options"}]},{"id":"blk-44112","kind":"paragraph","spans":[{"id":"spn-50994","text":"Pass "},{"id":"spn-50995","marks":["code"],"text":"options"},{"id":"spn-50996","text":" to customize evaluation thresholds:"}]},{"id":"blk-44113","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: { ... },\n  options: {\n    \"top_k\": 10,\n    \"min_context_nodes\": 3,\n    \"freshness_half_life_hours\": 48,\n    \"graph_support_target\": 0.6,\n    \"weights\": {\"coverage\": 0.4, \"confidence\": 0.3, \"freshness\": 0.2, \"support\": 0.1},\n    \"thresholds\": {\"act\": 0.7, \"learn\": 0.4}\n  }\n)"},{"id":"blk-44114","items":[{"blocks":[{"id":"blk-44116","kind":"paragraph","spans":[{"id":"spn-50997","marks":["code"],"text":"top_k"},{"id":"spn-50998","text":" — how many top nodes to consider for scoring"}]}],"id":"blk-44115","kind":"list-item"},{"blocks":[{"id":"blk-44118","kind":"paragraph","spans":[{"id":"spn-50999","marks":["code"],"text":"min_context_nodes"},{"id":"spn-51000","text":" — minimum linked nodes needed for adequate coverage"}]}],"id":"blk-44117","kind":"list-item"},{"blocks":[{"id":"blk-44120","kind":"paragraph","spans":[{"id":"spn-51001","marks":["code"],"text":"freshness_half_life_hours"},{"id":"spn-51002","text":" — decay rate for old evidence"}]}],"id":"blk-44119","kind":"list-item"},{"blocks":[{"id":"blk-44122","kind":"paragraph","spans":[{"id":"spn-51003","marks":["code"],"text":"graph_support_target"},{"id":"spn-51004","text":" — target ratio of supporting edges"}]}],"id":"blk-44121","kind":"list-item"},{"blocks":[{"id":"blk-44124","kind":"paragraph","spans":[{"id":"spn-51005","marks":["code"],"text":"weights"},{"id":"spn-51006","text":" — custom scoring dimension weights"}]}],"id":"blk-44123","kind":"list-item"},{"blocks":[{"id":"blk-44126","kind":"paragraph","spans":[{"id":"spn-51007","marks":["code"],"text":"thresholds"},{"id":"spn-51008","text":" — custom decision boundaries (above act threshold = act, below learn threshold = escalate)"}]}],"id":"blk-44125","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44127","kind":"heading","level":2,"spans":[{"id":"spn-51009","text":"Building Honest Signals"}]},{"id":"blk-44128","kind":"paragraph","spans":[{"id":"spn-51010","text":"Build the "},{"id":"spn-51011","marks":["code"],"text":"signal"},{"id":"spn-51012","text":" from REAL retrieval data — never fabricate:"}]},{"id":"blk-44129","kind":"paragraph","spans":[{"id":"spn-51013","text":"1. "},{"id":"spn-51014","marks":["bold"],"text":"Always retrieve first"},{"id":"spn-51015","text":" — run "},{"id":"spn-51016","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-51017","text":" before building the signal 2. "},{"id":"spn-51018","marks":["code"],"text":"retrieved_nodes"},{"id":"spn-51019","text":" — from actual results (include node_id, confidence, similarity) 3. "},{"id":"spn-51020","marks":["code"],"text":"outcomes"},{"id":"spn-51021","text":" — from actual "},{"id":"spn-51022","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-51023","text":" calls 4. "},{"id":"spn-51024","marks":["code"],"text":"contradictions"},{"id":"spn-51025","text":" — count "},{"id":"spn-51026","marks":["code"],"text":"contradicts"},{"id":"spn-51027","text":" edges found during inspection 5. "},{"id":"spn-51028","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-51029","text":" — questions the graph couldn't answer 6. "},{"id":"spn-51030","marks":["code"],"text":"supporting_evidence_count"},{"id":"spn-51031","text":" — number of "},{"id":"spn-51032","marks":["code"],"text":"supports"},{"id":"spn-51033","text":" edges found 7. "},{"id":"spn-51034","marks":["code"],"text":"coverage_estimate"},{"id":"spn-51035","text":" — your honest assessment (0.0-1.0)"}]},{"id":"blk-44130","kind":"heading","level":2,"spans":[{"id":"spn-51036","text":"Standalone Coverage Query (No Goal Required)"}]},{"id":"blk-44131","kind":"paragraph","spans":[{"id":"spn-51037","text":"For quick coverage assessment without a goal:"}]},{"id":"blk-44132","kind":"code","language":"text","text":"retrieve(action: \"coverage\", query: \"auth middleware token validation\", limit: 10, expansion_hops: 1)"},{"id":"blk-44133","kind":"paragraph","spans":[{"id":"spn-51038","text":"Returns coverage score, decision (act/learn/escalate), relevant nodes, and confidence stats. Use this when you want a fast coverage check without creating or linking to a goal."}]},{"id":"blk-44134","kind":"paragraph","spans":[{"id":"spn-51039","marks":["bold"],"text":"`retrieve(action: \"coverage\")` vs `route(action: \"review_goal\")`:"}]},{"head":[{"id":"blk-44136","spans":[{"id":"spn-51040","text":""}]},{"id":"blk-44137","spans":[{"id":"spn-51041","marks":["code"],"text":"retrieve(action: \"coverage\")"}]},{"id":"blk-44138","spans":[{"id":"spn-51042","marks":["code"],"text":"route(action: \"review_goal\")"}]}],"id":"blk-44135","kind":"table","rows":[[{"id":"blk-44139","spans":[{"id":"spn-51043","marks":["bold"],"text":"Requires goal"}]},{"id":"blk-44140","spans":[{"id":"spn-51044","text":"No"}]},{"id":"blk-44141","spans":[{"id":"spn-51045","text":"Yes"}]}],[{"id":"blk-44142","spans":[{"id":"spn-51046","marks":["bold"],"text":"Requires signal"}]},{"id":"blk-44143","spans":[{"id":"spn-51047","text":"No (auto-retrieves)"}]},{"id":"blk-44144","spans":[{"id":"spn-51048","text":"Yes (you build the signal)"}]}],[{"id":"blk-44145","spans":[{"id":"spn-51049","marks":["bold"],"text":"State transitions"}]},{"id":"blk-44146","spans":[{"id":"spn-51050","text":"None"}]},{"id":"blk-44147","spans":[{"id":"spn-51051","text":"Optional (apply_decision)"}]}],[{"id":"blk-44148","spans":[{"id":"spn-51052","marks":["bold"],"text":"Use when"}]},{"id":"blk-44149","spans":[{"id":"spn-51053","text":"Quick pre-action check"}]},{"id":"blk-44150","spans":[{"id":"spn-51054","text":"Formal goal-driven review"}]}]]},{"id":"blk-44151","kind":"heading","level":2,"spans":[{"id":"spn-51055","text":"Workflow Patterns"}]},{"id":"blk-44152","kind":"heading","level":3,"spans":[{"id":"spn-51056","text":"Pre-action gate"}]},{"id":"blk-44153","kind":"paragraph","spans":[{"id":"spn-51057","marks":["code"],"text":"retrieve"},{"id":"spn-51058","text":" -> build signal -> "},{"id":"spn-51059","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-51060","text":" -> if "},{"id":"spn-51061","marks":["code"],"text":"act"},{"id":"spn-51062","text":", proceed; if "},{"id":"spn-51063","marks":["code"],"text":"learn"},{"id":"spn-51064","text":", gather more; if "},{"id":"spn-51065","marks":["code"],"text":"escalate"},{"id":"spn-51066","text":", block."}]},{"id":"blk-44154","kind":"heading","level":3,"spans":[{"id":"spn-51067","text":"Iterative review loop"}]},{"id":"blk-44155","kind":"paragraph","spans":[{"id":"spn-51068","text":"After a "},{"id":"spn-51069","marks":["code"],"text":"learn"},{"id":"spn-51070","text":" decision: retrieve more -> store findings -> re-review -> eventually reach "},{"id":"spn-51071","marks":["code"],"text":"act"},{"id":"spn-51072","text":" or "},{"id":"spn-51073","marks":["code"],"text":"escalate"},{"id":"spn-51074","text":"."}]},{"id":"blk-44156","kind":"heading","level":3,"spans":[{"id":"spn-51075","text":"Post-failure review"}]},{"id":"blk-44157","kind":"paragraph","spans":[{"id":"spn-51076","text":"After "},{"id":"spn-51077","marks":["code"],"text":"learn(action: \"from_outcome\", status: \"failure\")"},{"id":"spn-51078","text":": re-review the goal to reassess coverage with the new negative signal."}]},{"id":"blk-44158","kind":"heading","level":3,"spans":[{"id":"spn-51079","text":"High-stakes review (strict thresholds)"}]},{"id":"blk-44159","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"<id>\", signal: { ... }, options: {\"thresholds\": {\"act\": 0.85, \"learn\": 0.5}})"},{"id":"blk-44160","kind":"heading","level":2,"spans":[{"id":"spn-51080","text":"Anti-patterns to avoid"}]},{"id":"blk-44161","items":[{"blocks":[{"id":"blk-44163","kind":"paragraph","spans":[{"id":"spn-51081","text":"Signal fabrication — building signals from made-up data instead of real retrieval"}]}],"id":"blk-44162","kind":"list-item"},{"blocks":[{"id":"blk-44165","kind":"paragraph","spans":[{"id":"spn-51082","text":"Review theater — calling review_goal but ignoring the act/learn/escalate decision"}]}],"id":"blk-44164","kind":"list-item"},{"blocks":[{"id":"blk-44167","kind":"paragraph","spans":[{"id":"spn-51083","text":"Skipping review before high-stakes actions"}]}],"id":"blk-44166","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieracnjwzs2r7ov5ekirxocmtakbeduta2lc73xaynvyjisz4ddt7w7q","vocabulary":"ampersand.docs.fs.v1"}