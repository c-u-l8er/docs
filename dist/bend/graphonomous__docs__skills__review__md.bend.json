al"}]}],"id":"blk-68829","kind":"list-item"},{"blocks":[{"id":"blk-68832","kind":"paragraph","spans":[{"id":"spn-101407","marks":["code"],"text":"retrieved_nodes"},{"id":"spn-101408","text":" — from actual results (include node_id, confidence, similarity)"}]}],"id":"blk-68831","kind":"list-item"},{"blocks":[{"id":"blk-68834","kind":"paragraph","spans":[{"id":"spn-101409","marks":["code"],"text":"outcomes"},{"id":"spn-101410","text":" — from actual "},{"id":"spn-101411","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-101412","text":" calls"}]}],"id":"blk-68833","kind":"list-item"},{"blocks":[{"id":"blk-68836","kind":"paragraph","spans":[{"id":"spn-101413","marks":["code"],"text":"contradictions"},{"id":"spn-101414","text":" — count "},{"id":"spn-101415","marks":["code"],"text":"contradicts"},{"id":"spn-101416","text":" edges found during inspection"}]}],"id":"blk-68835","kind":"list-item"},{"blocks":[{"id":"blk-68838","kind":"paragraph","spans":[{"id":"spn-101417","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-101418","text":" — questions the graph couldn't answer"}]}],"id":"blk-68837","kind":"list-item"},{"blocks":[{"id":"blk-68840","kind":"paragraph","spans":[{"id":"spn-101419","marks":["code"],"text":"supporting_evidence_count"},{"id":"spn-101420","text":" — number of "},{"id":"spn-101421","marks":["code"],"text":"supports"},{"id":"spn-101422","text":" edges found"}]}],"id":"blk-68839","kind":"list-item"},{"blocks":[{"id":"blk-68842","kind":"paragraph","spans":[{"id":"spn-101423","marks":["code"],"text":"coverage_estimate"},{"id":"spn-101424","text":" — your honest assessment (0.0-1.0)"}]}],"id":"blk-68841","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68843","kind":"heading","level":2,"spans":[{"id":"spn-101425","text":"Standalone Coverage Query (No Goal Required)"}]},{"id":"blk-68844","kind":"paragraph","spans":[{"id":"spn-101426","text":"For quick coverage assessment without a goal:"}]},{"id":"blk-68845","kind":"code","language":"text","text":"retrieve(action: \"coverage\", query: \"auth middleware token validation\", limit: 10, expansion_hops: 1)"},{"id":"blk-68846","kind":"paragraph","spans":[{"id":"spn-101427","text":"Returns coverage score, decision (act/learn/escalate), relevant nodes, and confidence stats. Use this when you want a fast coverage check without creating or linking to a goal."}]},{"id":"blk-68847","kind":"paragraph","spans":[{"id":"spn-101428","marks":["bold"],"text":"`retrieve(action: \"coverage\")` vs `route(action: \"review_goal\")`:"}]},{"head":[{"id":"blk-68849","spans":[{"id":"spn-101429","text":""}]},{"id":"blk-68850","spans":[{"id":"spn-101430","marks":["code"],"text":"retrieve(action: \"coverage\")"}]},{"id":"blk-68851","spans":[{"id":"spn-101431","marks":["code"],"text":"route(action: \"review_goal\")"}]}],"id":"blk-68848","kind":"table","rows":[[{"id":"blk-68852","spans":[{"id":"spn-101432","marks":["bold"],"text":"Requires goal"}]},{"id":"blk-68853","spans":[{"id":"spn-101433","text":"No"}]},{"id":"blk-68854","spans":[{"id":"spn-101434","text":"Yes"}]}],[{"id":"blk-68855","spans":[{"id":"spn-101435","marks":["bold"],"text":"Requires signal"}]},{"id":"blk-68856","spans":[{"id":"spn-101436","text":"No (auto-retrieves)"}]},{"id":"blk-68857","spans":[{"id":"spn-101437","text":"Yes (you build the signal)"}]}],[{"id":"blk-68858","spans":[{"id":"spn-101438","marks":["bold"],"text":"State transitions"}]},{"id":"blk-68859","spans":[{"id":"spn-101439","text":"None"}]},{"id":"blk-68860","spans":[{"id":"spn-101440","text":"Optional (apply_decision)"}]}],[{"id":"blk-68861","spans":[{"id":"spn-101441","marks":["bold"],"text":"Use when"}]},{"id":"blk-68862","spans":[{"id":"spn-101442","text":"Quick pre-action check"}]},{"id":"blk-68863","spans":[{"id":"spn-101443","text":"Formal goal-driven review"}]}]]},{"id":"blk-68864","kind":"heading","level":2,"spans":[{"id":"spn-101444","text":"Workflow Patterns"}]},{"id":"blk-68865","kind":"heading","level":3,"spans":[{"id":"spn-101445","text":"Pre-action gate"}]},{"id":"blk-68866","kind":"paragraph","spans":[{"id":"spn-101446","marks":["code"],"text":"retrieve"},{"id":"spn-101447","text":" -> build signal -> "},{"id":"spn-101448","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-101449","text":" -> if "},{"id":"spn-101450","marks":["code"],"text":"act"},{"id":"spn-101451","text":", proceed; if "},{"id":"spn-101452","marks":["code"],"text":"learn"},{"id":"spn-101453","text":", gather more; if "},{"id":"spn-101454","marks":["code"],"text":"escalate"},{"id":"spn-101455","text":", block."}]},{"id":"blk-68867","kind":"heading","level":3,"spans":[{"id":"spn-101456","text":"Iterative review loop"}]},{"id":"blk-68868","kind":"paragraph","spans":[{"id":"spn-101457","text":"After a "},{"id":"spn-101458","marks":["code"],"text":"learn"},{"id":"spn-101459","text":" decision: retrieve more -> store findings -> re-review -> eventually reach "},{"id":"spn-101460","marks":["code"],"text":"act"},{"id":"spn-101461","text":" or "},{"id":"spn-101462","marks":["code"],"text":"escalate"},{"id":"spn-101463","text":"."}]},{"id":"blk-68869","kind":"heading","level":3,"spans":[{"id":"spn-101464","text":"Post-failure review"}]},{"id":"blk-68870","kind":"paragraph","spans":[{"id":"spn-101465","text":"After "},{"id":"spn-101466","marks":["code"],"text":"learn(action: \"from_outcome\", status: \"failure\")"},{"id":"spn-101467","text":": re-review the goal to reassess coverage with the new negative signal."}]},{"id":"blk-68871","kind":"heading","level":3,"spans":[{"id":"spn-101468","text":"High-stakes review (strict thresholds)"}]},{"id":"blk-68872","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"<id>\", signal: { ... }, options: {\"thresholds\": {\"act\": 0.85, \"learn\": 0.5}})"},{"id":"blk-68873","kind":"heading","level":2,"spans":[{"id":"spn-101469","text":"Anti-patterns to avoid"}]},{"id":"blk-68874","items":[{"blocks":[{"id":"blk-68876","kind":"paragraph","spans":[{"id":"spn-101470","text":"Signal fabrication — building signals from made-up data instead of real retrieval"}]}],"id":"blk-68875","kind":"list-item"},{"blocks":[{"id":"blk-68878","kind":"paragraph","spans":[{"id":"spn-101471","text":"Review theater — calling review_goal but ignoring the act/learn/escalate decision"}]}],"id":"blk-68877","kind":"list-item"},{"blocks":[{"id":"blk-68880","kind":"paragraph","spans":[{"id":"spn-101472","text":"Skipping review before high-stakes actions"}]}],"id":"blk-68879","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraarajjsdpl2jgv5i6v3cyt7p6vjwmlasdkb5uc5mendvrmwaaqnqa","vocabulary":"ampersand.docs.fs.v1"}