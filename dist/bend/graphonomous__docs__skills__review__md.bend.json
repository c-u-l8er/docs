id":"spn-98606","marks":["code"],"text":"retrieve"},{"id":"spn-98607","text":" -> build signal -> "},{"id":"spn-98608","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-98609","text":" -> if "},{"id":"spn-98610","marks":["code"],"text":"act"},{"id":"spn-98611","text":", proceed; if "},{"id":"spn-98612","marks":["code"],"text":"learn"},{"id":"spn-98613","text":", gather more; if "},{"id":"spn-98614","marks":["code"],"text":"escalate"},{"id":"spn-98615","text":", block."}]},{"id":"blk-67902","kind":"heading","level":3,"spans":[{"id":"spn-98616","text":"Iterative review loop"}]},{"id":"blk-67903","kind":"paragraph","spans":[{"id":"spn-98617","text":"After a "},{"id":"spn-98618","marks":["code"],"text":"learn"},{"id":"spn-98619","text":" decision: retrieve more -> store findings -> re-review -> eventually reach "},{"id":"spn-98620","marks":["code"],"text":"act"},{"id":"spn-98621","text":" or "},{"id":"spn-98622","marks":["code"],"text":"escalate"},{"id":"spn-98623","text":"."}]},{"id":"blk-67904","kind":"heading","level":3,"spans":[{"id":"spn-98624","text":"Post-failure review"}]},{"id":"blk-67905","kind":"paragraph","spans":[{"id":"spn-98625","text":"After "},{"id":"spn-98626","marks":["code"],"text":"learn(action: \"from_outcome\", status: \"failure\")"},{"id":"spn-98627","text":": re-review the goal to reassess coverage with the new negative signal."}]},{"id":"blk-67906","kind":"heading","level":3,"spans":[{"id":"spn-98628","text":"High-stakes review (strict thresholds)"}]},{"id":"blk-67907","kind":"code","language":"text","text":"route(action: \"review_goal\", goal_id: \"<id>\", signal: { ... }, options: {\"thresholds\": {\"act\": 0.85, \"learn\": 0.5}})"},{"id":"blk-67908","kind":"heading","level":2,"spans":[{"id":"spn-98629","text":"Anti-patterns to avoid"}]},{"id":"blk-67909","items":[{"blocks":[{"id":"blk-67911","kind":"paragraph","spans":[{"id":"spn-98630","text":"Signal fabrication — building signals from made-up data instead of real retriev