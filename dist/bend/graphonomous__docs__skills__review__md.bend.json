{"bendscript":"0.1","blocks":[{"id":"blk-67966","kind":"heading","level":1,"spans":[{"id":"spn-98711","text":"Coverage and Review"}]},{"id":"blk-67967","kind":"paragraph","spans":[{"id":"spn-98712","text":"Evaluate whether you know enough to act on a goal, or need to learn more."}]},{"id":"blk-67968","kind":"heading","level":2,"spans":[{"id":"spn-98713","text":"Arguments"}]},{"id":"blk-67969","kind":"paragraph","spans":[{"id":"spn-98714","text":"Goal to review: $ARGUMENTS"}]},{"id":"blk-67970","kind":"heading","level":2,"spans":[{"id":"spn-98715","text":"Review Coverage"}]},{"id":"blk-67971","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: {\n    \"retrieved_nodes\": [{\"node_id\": \"abc\", \"confidence\": 0.8, \"similarity\": 0.85}],\n    \"outcomes\": [{\"action_id\": \"fix-auth\", \"status\": \"success\", \"confidence\": 0.9}],\n    \"contradictions\": 0,\n    \"knowledge_gaps\": [\"How does the rate limiter interact with auth?\"],\n    \"supporting_evidence_count\": 5,\n    \"coverage_estimate\": 0.7\n  },\n  apply_decision: true\n)"},{"id":"blk-67972","kind":"paragraph","spans":[{"id":"spn-98716","marks":["bold"],"text":"Returns:"},{"id":"spn-98717","text":" "},{"id":"spn-98718","marks":["code"],"text":"decision"},{"id":"spn-98719","text":" (act/learn/escalate), "},{"id":"spn-98720","marks":["code"],"text":"coverage_score"},{"id":"spn-98721","text":", "},{"id":"spn-98722","marks":["code"],"text":"uncertainty_score"},{"id":"spn-98723","text":", "},{"id":"spn-98724","marks":["code"],"text":"risk_score"},{"id":"spn-98725","text":", "},{"id":"spn-98726","marks":["code"],"text":"rationale"},{"id":"spn-98727","text":", "},{"id":"spn-98728","marks":["code"],"text":"applied_review"},{"id":"spn-98729","text":", "},{"id":"spn-98730","marks":["code"],"text":"transition"},{"id":"spn-98731","text":" (if apply_decision was true), "},{"id":"spn-98732","marks":["code"],"text":"evaluation"},{"id":"spn-98733","text":"."}]},{