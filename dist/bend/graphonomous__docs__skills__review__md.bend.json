{"bendscript":"0.1","blocks":[{"id":"blk-67840","kind":"heading","level":1,"spans":[{"id":"spn-98563","text":"Coverage and Review"}]},{"id":"blk-67841","kind":"paragraph","spans":[{"id":"spn-98564","text":"Evaluate whether you know enough to act on a goal, or need to learn more."}]},{"id":"blk-67842","kind":"heading","level":2,"spans":[{"id":"spn-98565","text":"Arguments"}]},{"id":"blk-67843","kind":"paragraph","spans":[{"id":"spn-98566","text":"Goal to review: $ARGUMENTS"}]},{"id":"blk-67844","kind":"heading","level":2,"spans":[{"id":"spn-98567","text":"Review Coverage"}]},{"id":"blk-67845","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: {\n    \"retrieved_nodes\": [{\"node_id\": \"abc\", \"confidence\": 0.8, \"similarity\": 0.85}],\n    \"outcomes\": [{\"action_id\": \"fix-auth\", \"status\": \"success\", \"confidence\": 0.9}],\n    \"contradictions\": 0,\n    \"knowledge_gaps\": [\"How does the rate limiter interact with auth?\"],\n    \"supporting_evidence_count\": 5,\n    \"coverage_estimate\": 0.7\n  },\n  apply_decision: true\n)"},{"id":"blk-67846","kind":"paragraph","spans":[{"id":"spn-98568","marks":["bold"],"text":"Returns:"},{"id":"spn-98569","text":" "},{"id":"spn-98570","marks":["code"],"text":"decision"},{"id":"spn-98571","text":" (act/learn/escalate), "},{"id":"spn-98572","marks":["code"],"text":"coverage_score"},{"id":"spn-98573","text":", "},{"id":"spn-98574","marks":["code"],"text":"uncertainty_score"},{"id":"spn-98575","text":", "},{"id":"spn-98576","marks":["code"],"text":"risk_score"},{"id":"spn-98577","text":", "},{"id":"spn-98578","marks":["code"],"text":"rationale"},{"id":"spn-98579","text":", "},{"id":"spn-98580","marks":["code"],"text":"applied_review"},{"id":"spn-98581","text":", "},{"id":"spn-98582","marks":["code"],"text":"transition"},{"id":"spn-98583","text":" (if apply_decision was true), "},{"id":"spn-98584","marks":["code"],"text":"evaluation"},{"id":"spn-98585","text":"."}]},{