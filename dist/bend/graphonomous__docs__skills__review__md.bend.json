al"}]}],"id":"blk-75358","kind":"list-item"},{"blocks":[{"id":"blk-75361","kind":"paragraph","spans":[{"id":"spn-138131","marks":["code"],"text":"retrieved_nodes"},{"id":"spn-138132","text":" — from actual results (include node_id, confidence, similarity)"}]}],"id":"blk-75360","kind":"list-item"},{"blocks":[{"id":"blk-75363","kind":"paragraph","spans":[{"id":"spn-138133","marks":["code"],"text":"outcomes"},{"id":"spn-138134","text":" — from actual "},{"id":"spn-138135","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-138136","text":" calls"}]}],"id":"blk-75362","kind":"list-item"},{"blocks":[{"id":"blk-75365","kind":"paragraph","spans":[{"id":"spn-138137","marks":["code"],"text":"contradictions"},{"id":"spn-138138","text":" — count "},{"id":"spn-138139","marks":["code"],"text":"contradicts"},{"id":"spn-138140","text":" edges found during inspection"}]}],"id":"blk-75364","kind":"list-item"},{"blocks":[{"id":"blk-75367","kind":"paragraph","spans":[{"id":"spn-138141","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-138142","text":" — questions the graph couldn't answer"}]}],"id":"blk-75366","kind":"list-item"},{"blocks":[{"id":"blk-75369","kind":"paragraph","spans":[{"id":"spn-138143","marks":["code"],"text":"supporting_evidence_count"},{"id":"spn-138144","text":" — number of "},{"id":"spn-138145","marks":["code"],"text":"supports"},{"id":"spn-138146","text":" edges found"}]}],"id":"blk-75368","kind":"list-item"},{"blocks":[{"id":"blk-75371","kind":"paragraph","spans":[{"id":"spn-138147","marks":["code"],"text":"coverage_estimate"},{"id":"spn-138148","text":" — your honest assessment (0.0-1.0)"}]}],"id":"blk-75370","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75372","kind":"heading","level":2,"spans":[{"id":"spn-138149","text":"Standalone Coverage Query (No Goal Required)"}]},{"id":"blk-75373","kind":"paragraph","spans":[{"id":"spn-138150","text":"For quick coverage assessment without a goal:"}]},{"id":"blk-75374","kind":"