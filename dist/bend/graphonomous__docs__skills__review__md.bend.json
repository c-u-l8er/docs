{"bendscript":"0.1","blocks":[{"id":"blk-68794","kind":"heading","level":1,"spans":[{"id":"spn-101350","text":"Coverage and Review"}]},{"id":"blk-68795","kind":"paragraph","spans":[{"id":"spn-101351","text":"Evaluate whether you know enough to act on a goal, or need to learn more."}]},{"id":"blk-68796","kind":"heading","level":2,"spans":[{"id":"spn-101352","text":"Arguments"}]},{"id":"blk-68797","kind":"paragraph","spans":[{"id":"spn-101353","text":"Goal to review: $ARGUMENTS"}]},{"id":"blk-68798","kind":"heading","level":2,"spans":[{"id":"spn-101354","text":"Review Coverage"}]},{"id":"blk-68799","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: {\n    \"retrieved_nodes\": [{\"node_id\": \"abc\", \"confidence\": 0.8, \"similarity\": 0.85}],\n    \"outcomes\": [{\"action_id\": \"fix-auth\", \"status\": \"success\", \"confidence\": 0.9}],\n    \"contradictions\": 0,\n    \"knowledge_gaps\": [\"How does the rate limiter interact with auth?\"],\n    \"supporting_evidence_count\": 5,\n    \"coverage_estimate\": 0.7\n  },\n  apply_decision: true\n)"},{"id":"blk-68800","kind":"paragraph","spans":[{"id":"spn-101355","marks":["bold"],"text":"Returns:"},{"id":"spn-101356","text":" "},{"id":"spn-101357","marks":["code"],"text":"decision"},{"id":"spn-101358","text":" (act/learn/escalate), "},{"id":"spn-101359","marks":["code"],"text":"coverage_score"},{"id":"spn-101360","text":", "},{"id":"spn-101361","marks":["code"],"text":"uncertainty_score"},{"id":"spn-101362","text":", "},{"id":"spn-101363","marks":["code"],"text":"risk_score"},{"id":"spn-101364","text":", "},{"id":"spn-101365","marks":["code"],"text":"rationale"},{"id":"spn-101366","text":", "},{"id":"spn-101367","marks":["code"],"text":"applied_review"},{"id":"spn-101368","text":", "},{"id":"spn-101369","marks":["code"],"text":"transition"},{"id":"spn-101370","text":" (if apply_decision was true), "},{"id":"spn-101371","marks":["code"],"text":"evaluation"},{"id":"spn-101372","text":"."}]},{"id":"blk-68801","kind":"heading","level":2,"spans":[{"id":"spn-101373","text":"Decision Policy"}]},{"id":"blk-68802","items":[{"blocks":[{"id":"blk-68804","kind":"paragraph","spans":[{"id":"spn-101374","marks":["bold"],"text":"act"},{"id":"spn-101375","text":" — coverage adequate, proceed with execution"}]}],"id":"blk-68803","kind":"list-item"},{"blocks":[{"id":"blk-68806","kind":"paragraph","spans":[{"id":"spn-101376","marks":["bold"],"text":"learn"},{"id":"spn-101377","text":" — gaps exist, gather more info, then re-review"}]}],"id":"blk-68805","kind":"list-item"},{"blocks":[{"id":"blk-68808","kind":"paragraph","spans":[{"id":"spn-101378","marks":["bold"],"text":"escalate"},{"id":"spn-101379","text":" — critically low coverage or high risk, mark blocked, get external help"}]}],"id":"blk-68807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68809","kind":"paragraph","spans":[{"id":"spn-101380","text":"If "},{"id":"spn-101381","marks":["code"],"text":"apply_decision: true"},{"id":"spn-101382","text":", the goal auto-transitions: act -> active, learn -> proposed, escalate -> blocked."}]},{"id":"blk-68810","kind":"heading","level":2,"spans":[{"id":"spn-101383","text":"Tuning Options"}]},{"id":"blk-68811","kind":"paragraph","spans":[{"id":"spn-101384","text":"Pass "},{"id":"spn-101385","marks":["code"],"text":"options"},{"id":"spn-101386","text":" to customize evaluation thresholds:"}]},{"id":"blk-68812","kind":"code","language":"text","text":"route(action: \"review_goal\",\n  goal_id: \"<id>\",\n  signal: { ... },\n  options: {\n    \"top_k\": 10,\n    \"min_context_nodes\": 3,\n    \"freshness_half_life_hours\": 48,\n    \"graph_support_target\": 0.6,\n    \"weights\": {\"coverage\": 0.4, \"confidence\": 0.3, \"freshness\": 0.2, \"support\": 0.1},\n    \"thresholds\": {\"act\": 0.7, \"learn\": 0.4}\n  }\n)"},{"id":"blk-68813","items":[{"blocks":[{"id":"blk-68815","kind":"paragraph","spans":[{"id":"spn-101387","marks":["code"],"