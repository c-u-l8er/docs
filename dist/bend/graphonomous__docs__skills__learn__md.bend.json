{"bendscript":"0.1","blocks":[{"id":"blk-68607","kind":"heading","level":1,"spans":[{"id":"spn-101120","text":"Learning Loop"}]},{"id":"blk-68608","kind":"paragraph","spans":[{"id":"spn-101121","text":"Close the feedback loop so the graph learns what works and what doesn't."}]},{"id":"blk-68609","kind":"heading","level":2,"spans":[{"id":"spn-101122","text":"Arguments"}]},{"id":"blk-68610","kind":"paragraph","spans":[{"id":"spn-101123","text":"Action and status: $ARGUMENTS"}]},{"id":"blk-68611","kind":"heading","level":2,"spans":[{"id":"spn-101124","text":"Report an Outcome"}]},{"id":"blk-68612","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"descriptive-slug-of-what-you-did\",\n  status: \"success\",\n  confidence: 0.8,\n  causal_node_ids: [\"<id1>\", \"<id2>\"]\n)"},{"id":"blk-68613","kind":"paragraph","spans":[{"id":"spn-101125","marks":["bold"],"text":"Required fields:"}]},{"id":"blk-68614","items":[{"blocks":[{"id":"blk-68616","kind":"paragraph","spans":[{"id":"spn-101126","marks":["code"],"text":"action_id"},{"id":"spn-101127","text":" — descriptive slug of the action taken"}]}],"id":"blk-68615","kind":"list-item"},{"blocks":[{"id":"blk-68618","kind":"paragraph","spans":[{"id":"spn-101128","marks":["code"],"text":"status"},{"id":"spn-101129","text":" — one of: "},{"id":"spn-101130","marks":["code"],"text":"success"},{"id":"spn-101131","text":", "},{"id":"spn-101132","marks":["code"],"text":"partial_success"},{"id":"spn-101133","text":", "},{"id":"spn-101134","marks":["code"],"text":"failure"},{"id":"spn-101135","text":", "},{"id":"spn-101136","marks":["code"],"text":"timeout"}]}],"id":"blk-68617","kind":"list-item"},{"blocks":[{"id":"blk-68620","kind":"paragraph","spans":[{"id":"spn-101137","marks":["code"],"text":"confidence"},{"id":"spn-101138","text":" — 0.0–1.0, reliability of this feedback signal (NOT the original decision quality)"}]}],"id":"blk-68619","kind":"list-item"},{"blocks":[{"id":"blk-68622","kind":"paragraph","spans":[{"id":"spn-101139","marks":["code"],"text":"causal_node_ids"},{"id":"spn-101140","text":" — from "},{"id":"spn-101141","marks":["code"],"text":"causal_context"},{"id":"spn-101142","text":" saved during retrieval"}]}],"id":"blk-68621","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68623","kind":"paragraph","spans":[{"id":"spn-101143","marks":["bold"],"text":"Optional fields:"}]},{"id":"blk-68624","items":[{"blocks":[{"id":"blk-68626","kind":"paragraph","spans":[{"id":"spn-101144","marks":["code"],"text":"evidence"},{"id":"spn-101145","text":" — structured evidence object (test results, metrics, user feedback)"}]}],"id":"blk-68625","kind":"list-item"},{"blocks":[{"id":"blk-68628","kind":"paragraph","spans":[{"id":"spn-101146","marks":["code"],"text":"retrieval_trace_id"},{"id":"spn-101147","text":" — audit trail linking back to the retrieval call"}]}],"id":"blk-68627","kind":"list-item"},{"blocks":[{"id":"blk-68630","kind":"paragraph","spans":[{"id":"spn-101148","marks":["code"],"text":"decision_trace_id"},{"id":"spn-101149","text":" — for multi-agent setups tracking decision provenance"}]}],"id":"blk-68629","kind":"list-item"},{"blocks":[{"id":"blk-68632","kind":"paragraph","spans":[{"id":"spn-101150","marks":["code"],"text":"action_linkage"},{"id":"spn-101151","text":" — metadata about what action was taken"}]}],"id":"blk-68631","kind":"list-item"},{"blocks":[{"id":"blk-68634","kind":"paragraph","spans":[{"id":"spn-101152","marks":["code"],"text":"grounding"},{"id":"spn-101153","text":" — outcome provenance (where the feedback signal came from)"}]}],"id":"blk-68633","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68635","kind":"paragraph","spans":[{"id":"spn-101154","marks":["bold"],"text":"Status meanings and confidence effects:"}]},{"id":"blk-68636","items":[{"blocks":[{"id":"blk-68638","kind":"paragraph","spans":[{"id":"spn-101155","marks":["code"],"text":"success"},{"id":"spn-101156","text":" → boosts confidence of causal nodes"}]}],"id":"blk-68637","kind":"list-item"},{"blocks":[{"id":"blk-68640","kind":"paragraph","spans":[{"id":"spn-101157","marks":["code"],"text":"failure"},{"id":"spn-101158","text":" → reduces confidence of causal nodes (the knowledge was wrong/misleading)"}]}],"id":"blk-68639","kind":"list-item"},{"blocks":[{"id":"blk-68642","kind":"paragraph","spans":[{"id":"spn-101159","marks":["code"],"text":"partial_success"},{"id":"spn-101160","text":" → small boost"}]}],"id":"blk-68641","kind":"list-item"},{"blocks":[{"id":"blk-68644","kind":"paragraph","spans":[{"id":"spn-101161","marks":["code"],"text":"timeout"},{"id":"spn-101162","text":" → minimal change — "},{"id":"spn-101163","marks":["bold"],"text":"NOT the same as failure!"},{"id":"spn-101164","text":" Use when outcome is unknown."}]}],"id":"blk-68643","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68645","kind":"heading","level":3,"spans":[{"id":"spn-101165","text":"Response structure"}]},{"id":"blk-68646","kind":"paragraph","spans":[{"id":"spn-101166","text":"The response contains per-node confidence updates:"}]},{"id":"blk-68647","kind":"code","language":"json","text":"{\n  \"processed\": 3,\n  \"skipped\": 0,\n  \"updates\": [\n    {\"node_id\": \"abc\", \"old_confidence\": 0.7, \"new_confidence\": 0.78},\n    {\"node_id\": \"def\", \"old_confidence\": 0.6, \"new_confidence\": 0.67}\n  ]\n}"},{"id":"blk-68648","kind":"paragraph","spans":[{"id":"spn-101167","marks":["code"],"text":"processed"},{"id":"spn-101168","text":" = causal nodes examined; "},{"id":"spn-101169","marks":["code"],"text":"skipped"},{"id":"spn-101170","text":" = nodes not found. Confidence adjustments are bounded — outcome confidence scales the delta (high-confidence feedback produces larger changes)."}]},{"id":"blk-68649","kind":"heading","level":2,"spans":[{"id":"spn-101171","text":"Full provenance example"}]},{"id":"blk-68650","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"fix-auth-middleware\",\n  status: \"success\",\n  confidence: 0.9,\n  causal_node_ids: [\"node-abc\", \"node-def\"],\n  evidence: {\"test_passed\": true, \"error_resolved\": true, \"regression_check\": \"clean\"},\n  retrieval_trace_id: \"ret-12345\",\n  grounding: \"test suite output confirmed fix\"\n)"},{"id":"blk-68651","kind":"heading","level":2,"spans":[{"id":"spn-101172","text":"Pattern"}]},{"id":"blk-68652","items":[{"blocks":[{"id":"blk-68654","kind":"paragraph","spans":[{"id":"spn-101173","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-101174","text":" → save "},{"id":"spn-101175","marks":["code"],"text":"causal_context"}]}],"id":"blk-68653","kind":"list-item"},{"blocks":[{"id":"blk-68656","kind":"paragraph","spans":[{"id":"spn-101176","text":"Act on retrieved knowledge"}]}],"id":"blk-68655","kind":"list-item"},{"blocks":[{"id":"blk-68658","kind":"paragraph","spans":[{"id":"spn-101177","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-101178","text":" with real causal IDs and honest status"}]}],"id":"blk-68657","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68659","kind":"heading","level":2,"spans":[{"id":"spn-101179","text":"Learn from Feedback"}]},{"id":"blk-68660","kind":"paragraph","spans":[{"id":"spn-101180","text":"Process explicit feedback on a specific node:"}]},{"id":"blk-68661","kind":"code","language":"text","text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"negative\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"correction\", correction: \"The correct fact is...\")"},{"id":"blk-68662","items":[{"blocks":[{"id":"blk-68664","kind":"paragraph","spans":[{"id":"spn-101181","marks":["code"],"text":"positive"},{"id":"spn-101182","text":" → routes through "},{"id":"spn-101183","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101184","text":" with status "},{"id":"spn-101185","marks":["code"],"text":"success"}]}],"id":"blk-68663","kind":"list-item"},{"blocks":[{"id":"blk-68666","kind":"paragraph","spans":[{"id":"spn-101186","marks":["code"],"text":"negative"},{"id":"spn-101187","text":" → routes through "},{"id":"spn-101188","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101189","text":" with status "},{"id":"spn-101190","marks":["code"],"text":"failure"}]}],"id":"blk-68665","kind":"list-item"},{"blocks":[{"id":"blk-68668","kind":"paragraph","spans":[{"id":"spn-101191","marks":["code"],"text":"correction"},{"id":"spn-101192","text":" → directly updates the node content"}]}],"id":"blk-68667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68669","kind":"heading","level":2,"spans":[{"id":"spn-101193","text":"Detect Novelty"}]},{"id":"blk-68670","kind":"paragraph","spans":[{"id":"spn-101194","text":"Check if a query represents knowledge not yet in the graph:"}]},{"id":"blk-68671","kind":"code","language":"text","text":"learn(action: \"detect_novelty\", query: \"some new concept\", threshold: 0.35)"},{"id":"blk-68672","kind":"paragraph","spans":[{"id":"spn-101195","text":"Returns "},{"id":"spn-101196","marks":["code"],"text":"is_novel"},{"id":"spn-101197","text":" (bool), "},{"id":"spn-101198","marks":["code"],"text":"novelty_score"},{"id":"spn-101199","text":" (0.0–1.0), and "},{"id":"spn-101200","marks":["code"],"text":"nearest_nodes"},{"id":"spn-101201","text":" with similarity scores. Higher novelty = less existing coverage."}]},{"id":"blk-68673","kind":"heading","level":2,"spans":[{"id":"spn-101202","text":"Learn from Interaction"}]},{"id":"blk-68674","kind":"paragraph","spans":[{"id":"spn-101203","text":"Full learning pipeline for a user-model exchange:"}]},{"id":"blk-68675","kind":"code","language":"text","text":"learn(\n  action: \"from_interaction\",\n  user_message: \"How does the auth middleware work?\",\n  model_response: \"The auth middleware validates JWT tokens and...\",\n  novelty_threshold: 0.35\n)"},{"id":"blk-68676","kind":"paragraph","spans":[{"id":"spn-101204","text":"Pipeline: novelty check → store episodic node → extract semantic claims from response → create "},{"id":"spn-101205","marks":["code"],"text":"derived_from"},{"id":"spn-101206","text":" edges → link to nearest existing nodes."}]},{"id":"blk-68677","kind":"heading","level":2,"spans":[{"id":"spn-101207","text":"Anti-patterns to avoid"}]},{"id":"blk-68678","items":[{"blocks":[{"id":"blk-68680","kind":"paragraph","spans":[{"id":"spn-101208","text":"Fire and forget — never reporting outcomes after using retrieved knowledge"}]}],"id":"blk-68679","kind":"list-item"},{"blocks":[{"id":"blk-68682","kind":"paragraph","spans":[{"id":"spn-101209","text":"Using "},{"id":"spn-101210","marks":["code"],"text":"failure"},{"id":"spn-101211","text":" when you mean "},{"id":"spn-101212","marks":["code"],"text":"timeout"},{"id":"spn-101213","text":" — timeout means unknown, not wrong"}]}],"id":"blk-68681","kind":"list-item"},{"blocks":[{"id":"blk-68684","kind":"paragraph","spans":[{"id":"spn-101214","text":"Fabricating causal node IDs — only use IDs from actual "},{"id":"spn-101215","marks":["code"],"text":"causal_context"}]}],"id":"blk-68683","kind":"list-item"},{"blocks":[{"id":"blk-68686","kind":"paragraph","spans":[{"id":"spn-101216","text":"Setting confidence to 1.0 on every outcome — calibrate by signal reliability"}]}],"id":"blk-68685","kind":"list-item"},{"blocks":[{"id":"blk-68688","kind":"paragraph","spans":[{"id":"spn-101217","text":"Discarding "},{"id":"spn-101218","marks":["code"],"text":"causal_context"},{"id":"spn-101219","text":" between retrieval and outcome — hold it in working memory"}]}],"id":"blk-68687","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieratyhcvkeydd2qahwqet4bogeocvum7myuq5voapmh7n653axvnvsq","vocabulary":"ampersand.docs.fs.v1"}