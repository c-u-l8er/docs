{"bendscript":"0.1","blocks":[{"id":"blk-67779","kind":"heading","level":1,"spans":[{"id":"spn-98481","text":"Learning Loop"}]},{"id":"blk-67780","kind":"paragraph","spans":[{"id":"spn-98482","text":"Close the feedback loop so the graph learns what works and what doesn't."}]},{"id":"blk-67781","kind":"heading","level":2,"spans":[{"id":"spn-98483","text":"Arguments"}]},{"id":"blk-67782","kind":"paragraph","spans":[{"id":"spn-98484","text":"Action and status: $ARGUMENTS"}]},{"id":"blk-67783","kind":"heading","level":2,"spans":[{"id":"spn-98485","text":"Report an Outcome"}]},{"id":"blk-67784","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"descriptive-slug-of-what-you-did\",\n  status: \"success\",\n  confidence: 0.8,\n  causal_node_ids: [\"<id1>\", \"<id2>\"]\n)"},{"id":"blk-67785","kind":"paragraph","spans":[{"id":"spn-98486","marks":["bold"],"text":"Required fields:"}]},{"id":"blk-67786","items":[{"blocks":[{"id":"blk-67788","kind":"paragraph","spans":[{"id":"spn-98487","marks":["code"],"text":"action_id"},{"id":"spn-98488","text":" — descriptive slug of the action taken"}]}],"id":"blk-67787","kind":"list-item"},{"blocks":[{"id":"blk-67790","kind":"paragraph","spans":[{"id":"spn-98489","marks":["code"],"text":"status"},{"id":"spn-98490","text":" — one of: "},{"id":"spn-98491","marks":["code"],"text":"success"},{"id":"spn-98492","text":", "},{"id":"spn-98493","marks":["code"],"text":"partial_success"},{"id":"spn-98494","text":", "},{"id":"spn-98495","marks":["code"],"text":"failure"},{"id":"spn-98496","text":", "},{"id":"spn-98497","marks":["code"],"text":"timeout"}]}],"id":"blk-67789","kind":"list-item"},{"blocks":[{"id":"blk-67792","kind":"paragraph","spans":[{"id":"spn-98498","marks":["code"],"text":"confidence"},{"id":"spn-98499","text":" — 0.0–1.0, reliability of this feedback signal (NOT the original decision quality)"}]}],"id":"blk-67791","kind":"list-item"},{"blocks":[{"id":"blk-67794","kind":"paragraph","spans":[{"id":"spn-98500","marks":["code"],"text":"causal_node_ids"},{"id":"spn-98501","text":" — from "},{"id":"spn-98502","marks":["code"],"text":"causal_context"},{"id":"spn-98503","text":" saved during retrieval"}]}],"id":"blk-67793","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67795","kind":"paragraph","spans":[{"id":"spn-98504","marks":["bold"],"text":"Optional fields:"}]},{"id":"blk-67796","items":[{"blocks":[{"id":"blk-67798","kind":"paragraph","spans":[{"id":"spn-98505","marks":["code"],"text":"evidence"},{"id":"spn-98506","text":" — structured evidence object (test results, metrics, user feedback)"}]}],"id":"blk-67797","kind":"list-item"},{"blocks":[{"id":"blk-67800","kind":"paragraph","spans":[{"id":"spn-98507","marks":["code"],"text":"retrieval_trace_id"},{"id":"spn-98508","text":" — audit trail linking back to the retrieval call"}]}],"id":"blk-67799","kind":"list-item"},{"blocks":[{"id":"blk-67802","kind":"paragraph","spans":[{"id":"spn-98509","marks":["code"],"text":"decision_trace_id"},{"id":"spn-98510","text":" — for multi-agent setups tracking decision provenance"}]}],"id":"blk-67801","kind":"list-item"},{"blocks":[{"id":"blk-67804","kind":"paragraph","spans":[{"id":"spn-98511","marks":["code"],"text":"action_linkage"},{"id":"spn-98512","text":" — metadata about what action was taken"}]}],"id":"blk-67803","kind":"list-item"},{"blocks":[{"id":"blk-67806","kind":"paragraph","spans":[{"id":"spn-98513","marks":["code"],"text":"grounding"},{"id":"spn-98514","text":" — outcome provenance (where the feedback signal came from)"}]}],"id":"blk-67805","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67807","kind":"paragraph","spans":[{"id":"spn-98515","marks":["bold"],"text":"Status meanings and confidence effects:"}]},{"id":"blk-67808","items":[{"blocks":[{"id":"blk-67810","kind":"paragraph","spans":[{"id":"spn-98516","marks":["code"],"text":"success"},{"id":"spn-98517","text":" → boosts confidence of causal nodes"}]}],"id":"blk-67809","kind":"list-item"},{"blocks":[{"id":"blk-67812","kind":"paragraph","spans":[{"id":"spn-98518","marks":["code"],"text":"failure"},{"id":"spn-98519","text":" → reduces confidence of causal nodes (the knowledge was wrong/misleading)"}]}],"id":"blk-67811","kind":"list-item"},{"blocks":[{"id":"blk-67814","kind":"paragraph","spans":[{"id":"spn-98520","marks":["code"],"text":"partial_success"},{"id":"spn-98521","text":" → small boost"}]}],"id":"blk-67813","kind":"list-item"},{"blocks":[{"id":"blk-67816","kind":"paragraph","spans":[{"id":"spn-98522","marks":["code"],"text":"timeout"},{"id":"spn-98523","text":" → minimal change — "},{"id":"spn-98524","marks":["bold"],"text":"NOT the same as failure!"},{"id":"spn-98525","text":" Use when outcome is unknown."}]}],"id":"blk-67815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67817","kind":"heading","level":3,"spans":[{"id":"spn-98526","text":"Response structure"}]},{"id":"blk-67818","kind":"paragraph","spans":[{"id":"spn-98527","text":"The response contains per-node confidence updates:"}]},{"id":"blk-67819","kind":"code","language":"json","text":"{\n  \"processed\": 3,\n  \"skipped\": 0,\n  \"updates\": [\n    {\"node_id\": \"abc\", \"old_confidence\": 0.7, \"new_confidence\": 0.78},\n    {\"node_id\": \"def\", \"old_confidence\": 0.6, \"new_confidence\": 0.67}\n  ]\n}"},{"id":"blk-67820","kind":"paragraph","spans":[{"id":"spn-98528","marks":["code"],"text":"processed"},{"id":"spn-98529","text":" = causal nodes examined; "},{"id":"spn-98530","marks":["code"],"text":"skipped"},{"id":"spn-98531","text":" = nodes not found. Confidence adjustments are bounded — outcome confidence scales the delta (high-confidence feedback produces larger changes)."}]},{"id":"blk-67821","kind":"heading","level":2,"spans":[{"id":"spn-98532","text":"Full provenance example"}]},{"id":"blk-67822","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"fix-auth-middleware\",\n  status: \"success\",\n  confidence: 0.9,\n  causal_node_ids: [\"node-abc\", \"node-def\"],\n  evidence: {\"test_passed\": true, \"error_resolved\": true, \"regression_check\": \"clean\"},\n  retrieval_trace_id: \"ret-12345\",\n  grounding: \"test suite output confirmed fix\"\n)"},{"id":"blk-67823","kind":"heading","level":2,"spans":[{"id":"spn-98533","text":"Pattern"}]},{"id":"blk-67824","items":[{"blocks":[{"id":"blk-67826","kind":"paragraph","spans":[{"id":"spn-98534","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-98535","text":" → save "},{"id":"spn-98536","marks":["code"],"text":"causal_context"}]}],"id":"blk-67825","kind":"list-item"},{"blocks":[{"id":"blk-67828","kind":"paragraph","spans":[{"id":"spn-98537","text":"Act on retrieved knowledge"}]}],"id":"blk-67827","kind":"list-item"},{"blocks":[{"id":"blk-67830","kind":"paragraph","spans":[{"id":"spn-98538","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-98539","text":" with real causal IDs and honest status"}]}],"id":"blk-67829","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67831","kind":"heading","level":2,"spans":[{"id":"spn-98540","text":"Learn from Feedback"}]},{"id":"blk-67832","kind":"paragraph","spans":[{"id":"spn-98541","text":"Process explicit feedback on a specific node:"}]},{"id":"blk-67833","kind":"code","language":"text","text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"negative\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"correction\", correction: \"The correct fact is...\")"},{"id":"blk-67834","items":[{"blocks":[{"id":"blk-67836","kind":"paragraph","spans":[{"id":"spn-98542","marks":["code"],"text":"positive"},{"id":"spn-98543","text":" → routes through "},{"id":"spn-98544","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98545","text":" with status "},{"id":"spn-98546","marks":["code"],"text":"success"}]}],"id":"blk-67835","kind":"list-item"},{"blocks":[{"id":"blk-67838","kind":"paragraph","spans":[{"id":"spn-98547","marks":["code"],"text":"negative"},{"id":"spn-98548","text":" → routes through "},{"id":"spn-98549","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98550","text":" with status "},{"id":"spn-98551","marks":["code"],"text":"failure"}]}],"id":"blk-67837","kind":"list-item"},{"blocks":[{"id":"blk-67840","kind":"paragraph","spans":[{"id":"spn-98552","marks":["code"],"text":"correction"},{"id":"spn-98553","text":" → directly updates the node content"}]}],"id":"blk-67839","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67841","kind":"heading","level":2,"spans":[{"id":"spn-98554","text":"Detect Novelty"}]},{"id":"blk-67842","kind":"paragraph","spans":[{"id":"spn-98555","text":"Check if a query represents knowledge not yet in the graph:"}]},{"id":"blk-67843","kind":"code","language":"text","text":"learn(action: \"detect_novelty\", query: \"some new concept\", threshold: 0.35)"},{"id":"blk-67844","kind":"paragraph","spans":[{"id":"spn-98556","text":"Returns "},{"id":"spn-98557","marks":["code"],"text":"is_novel"},{"id":"spn-98558","text":" (bool), "},{"id":"spn-98559","marks":["code"],"text":"novelty_score"},{"id":"spn-98560","text":" (0.0–1.0), and "},{"id":"spn-98561","marks":["code"],"text":"nearest_nodes"},{"id":"spn-98562","text":" with similarity scores. Higher novelty = less existing coverage."}]},{"id":"blk-67845","kind":"heading","level":2,"spans":[{"id":"spn-98563","text":"Learn from Interaction"}]},{"id":"blk-67846","kind":"paragraph","spans":[{"id":"spn-98564","text":"Full learning pipeline for a user-model exchange:"}]},{"id":"blk-67847","kind":"code","language":"text","text":"learn(\n  action: \"from_interaction\",\n  user_message: \"How does the auth middleware work?\",\n  model_response: \"The auth middleware validates JWT tokens and...\",\n  novelty_threshold: 0.35\n)"},{"id":"blk-67848","kind":"paragraph","spans":[{"id":"spn-98565","text":"Pipeline: novelty check → store episodic node → extract semantic claims from response → create "},{"id":"spn-98566","marks":["code"],"text":"derived_from"},{"id":"spn-98567","text":" edges → link to nearest existing nodes."}]},{"id":"blk-67849","kind":"heading","level":2,"spans":[{"id":"spn-98568","text":"Anti-patterns to avoid"}]},{"id":"blk-67850","items":[{"blocks":[{"id":"blk-67852","kind":"paragraph","spans":[{"id":"spn-98569","text":"Fire and forget — never reporting outcomes after using retrieved knowledge"}]}],"id":"blk-67851","kind":"list-item"},{"blocks":[{"id":"blk-67854","kind":"paragraph","spans":[{"id":"spn-98570","text":"Using "},{"id":"spn-98571","marks":["code"],"text":"failure"},{"id":"spn-98572","text":" when you mean "},{"id":"spn-98573","marks":["code"],"text":"timeout"},{"id":"spn-98574","text":" — timeout means unknown, not wrong"}]}],"id":"blk-67853","kind":"list-item"},{"blocks":[{"id":"blk-67856","kind":"paragraph","spans":[{"id":"spn-98575","text":"Fabricating causal node IDs — only use IDs from actual "},{"id":"spn-98576","marks":["code"],"text":"causal_context"}]}],"id":"blk-67855","kind":"list-item"},{"blocks":[{"id":"blk-67858","kind":"paragraph","spans":[{"id":"spn-98577","text":"Setting confidence to 1.0 on every outcome — calibrate by signal reliability"}]}],"id":"blk-67857","kind":"list-item"},{"blocks":[{"id":"blk-67860","kind":"paragraph","spans":[{"id":"spn-98578","text":"Discarding "},{"id":"spn-98579","marks":["code"],"text":"causal_context"},{"id":"spn-98580","text":" between retrieval and outcome — hold it in working memory"}]}],"id":"blk-67859","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraqncwzzz3qkecczjg6ebtn56vrgczawzos4cnkz3c4uej7vc7g64a","vocabulary":"ampersand.docs.fs.v1"}