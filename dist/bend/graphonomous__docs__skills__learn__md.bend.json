{"bendscript":"0.1","blocks":[{"id":"blk-43911","kind":"paragraph","spans":[{"id":"spn-50720","text":"--- name: learn description: Use after completing a consequential action informed by retrieved knowledge. Reports outcomes to update confidence in the knowledge graph. Use when the user says \"report outcome\", \"learn from this\", \"update confidence\", or after any action that used retrieved context. argument-hint: <action-description> <success|failure|partial_success|timeout> ---"}]},{"id":"blk-43912","kind":"heading","level":1,"spans":[{"id":"spn-50721","text":"Learning Loop"}]},{"id":"blk-43913","kind":"paragraph","spans":[{"id":"spn-50722","text":"Close the feedback loop so the graph learns what works and what doesn't."}]},{"id":"blk-43914","kind":"heading","level":2,"spans":[{"id":"spn-50723","text":"Arguments"}]},{"id":"blk-43915","kind":"paragraph","spans":[{"id":"spn-50724","text":"Action and status: $ARGUMENTS"}]},{"id":"blk-43916","kind":"heading","level":2,"spans":[{"id":"spn-50725","text":"Report an Outcome"}]},{"id":"blk-43917","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"descriptive-slug-of-what-you-did\",\n  status: \"success\",\n  confidence: 0.8,\n  causal_node_ids: [\"<id1>\", \"<id2>\"]\n)"},{"id":"blk-43918","kind":"paragraph","spans":[{"id":"spn-50726","marks":["bold"],"text":"Required fields:"}]},{"id":"blk-43919","items":[{"blocks":[{"id":"blk-43921","kind":"paragraph","spans":[{"id":"spn-50727","marks":["code"],"text":"action_id"},{"id":"spn-50728","text":" — descriptive slug of the action taken"}]}],"id":"blk-43920","kind":"list-item"},{"blocks":[{"id":"blk-43923","kind":"paragraph","spans":[{"id":"spn-50729","marks":["code"],"text":"status"},{"id":"spn-50730","text":" — one of: "},{"id":"spn-50731","marks":["code"],"text":"success"},{"id":"spn-50732","text":", "},{"id":"spn-50733","marks":["code"],"text":"partial_success"},{"id":"spn-50734","text":", "},{"id":"spn-50735","marks":["code"],"text":"failure"},{"id":"spn-50736","text":", "},{"id":"spn-50737","marks":["code"],"text":"timeout"}]}],"id":"blk-43922","kind":"list-item"},{"blocks":[{"id":"blk-43925","kind":"paragraph","spans":[{"id":"spn-50738","marks":["code"],"text":"confidence"},{"id":"spn-50739","text":" — 0.0–1.0, reliability of this feedback signal (NOT the original decision quality)"}]}],"id":"blk-43924","kind":"list-item"},{"blocks":[{"id":"blk-43927","kind":"paragraph","spans":[{"id":"spn-50740","marks":["code"],"text":"causal_node_ids"},{"id":"spn-50741","text":" — from "},{"id":"spn-50742","marks":["code"],"text":"causal_context"},{"id":"spn-50743","text":" saved during retrieval"}]}],"id":"blk-43926","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43928","kind":"paragraph","spans":[{"id":"spn-50744","marks":["bold"],"text":"Optional fields:"}]},{"id":"blk-43929","items":[{"blocks":[{"id":"blk-43931","kind":"paragraph","spans":[{"id":"spn-50745","marks":["code"],"text":"evidence"},{"id":"spn-50746","text":" — structured evidence object (test results, metrics, user feedback)"}]}],"id":"blk-43930","kind":"list-item"},{"blocks":[{"id":"blk-43933","kind":"paragraph","spans":[{"id":"spn-50747","marks":["code"],"text":"retrieval_trace_id"},{"id":"spn-50748","text":" — audit trail linking back to the retrieval call"}]}],"id":"blk-43932","kind":"list-item"},{"blocks":[{"id":"blk-43935","kind":"paragraph","spans":[{"id":"spn-50749","marks":["code"],"text":"decision_trace_id"},{"id":"spn-50750","text":" — for multi-agent setups tracking decision provenance"}]}],"id":"blk-43934","kind":"list-item"},{"blocks":[{"id":"blk-43937","kind":"paragraph","spans":[{"id":"spn-50751","marks":["code"],"text":"action_linkage"},{"id":"spn-50752","text":" — metadata about what action was taken"}]}],"id":"blk-43936","kind":"list-item"},{"blocks":[{"id":"blk-43939","kind":"paragraph","spans":[{"id":"spn-50753","marks":["code"],"text":"grounding"},{"id":"spn-50754","text":" — outcome provenance (where the feedback signal came from)"}]}],"id":"blk-43938","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43940","kind":"paragraph","spans":[{"id":"spn-50755","marks":["bold"],"text":"Status meanings and confidence effects:"}]},{"id":"blk-43941","items":[{"blocks":[{"id":"blk-43943","kind":"paragraph","spans":[{"id":"spn-50756","marks":["code"],"text":"success"},{"id":"spn-50757","text":" → boosts confidence of causal nodes"}]}],"id":"blk-43942","kind":"list-item"},{"blocks":[{"id":"blk-43945","kind":"paragraph","spans":[{"id":"spn-50758","marks":["code"],"text":"failure"},{"id":"spn-50759","text":" → reduces confidence of causal nodes (the knowledge was wrong/misleading)"}]}],"id":"blk-43944","kind":"list-item"},{"blocks":[{"id":"blk-43947","kind":"paragraph","spans":[{"id":"spn-50760","marks":["code"],"text":"partial_success"},{"id":"spn-50761","text":" → small boost"}]}],"id":"blk-43946","kind":"list-item"},{"blocks":[{"id":"blk-43949","kind":"paragraph","spans":[{"id":"spn-50762","marks":["code"],"text":"timeout"},{"id":"spn-50763","text":" → minimal change — "},{"id":"spn-50764","marks":["bold"],"text":"NOT the same as failure!"},{"id":"spn-50765","text":" Use when outcome is unknown."}]}],"id":"blk-43948","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43950","kind":"heading","level":3,"spans":[{"id":"spn-50766","text":"Response structure"}]},{"id":"blk-43951","kind":"paragraph","spans":[{"id":"spn-50767","text":"The response contains per-node confidence updates:"}]},{"id":"blk-43952","kind":"code","language":"json","text":"{\n  \"processed\": 3,\n  \"skipped\": 0,\n  \"updates\": [\n    {\"node_id\": \"abc\", \"old_confidence\": 0.7, \"new_confidence\": 0.78},\n    {\"node_id\": \"def\", \"old_confidence\": 0.6, \"new_confidence\": 0.67}\n  ]\n}"},{"id":"blk-43953","kind":"paragraph","spans":[{"id":"spn-50768","marks":["code"],"text":"processed"},{"id":"spn-50769","text":" = causal nodes examined; "},{"id":"spn-50770","marks":["code"],"text":"skipped"},{"id":"spn-50771","text":" = nodes not found. Confidence adjustments are bounded — outcome confidence scales the delta (high-confidence feedback produces larger changes)."}]},{"id":"blk-43954","kind":"heading","level":2,"spans":[{"id":"spn-50772","text":"Full provenance example"}]},{"id":"blk-43955","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"fix-auth-middleware\",\n  status: \"success\",\n  confidence: 0.9,\n  causal_node_ids: [\"node-abc\", \"node-def\"],\n  evidence: {\"test_passed\": true, \"error_resolved\": true, \"regression_check\": \"clean\"},\n  retrieval_trace_id: \"ret-12345\",\n  grounding: \"test suite output confirmed fix\"\n)"},{"id":"blk-43956","kind":"heading","level":2,"spans":[{"id":"spn-50773","text":"Pattern"}]},{"id":"blk-43957","kind":"paragraph","spans":[{"id":"spn-50774","text":"1. "},{"id":"spn-50775","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-50776","text":" → save "},{"id":"spn-50777","marks":["code"],"text":"causal_context"},{"id":"spn-50778","text":" 2. Act on retrieved knowledge 3. "},{"id":"spn-50779","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-50780","text":" with real causal IDs and honest status"}]},{"id":"blk-43958","kind":"heading","level":2,"spans":[{"id":"spn-50781","text":"Learn from Feedback"}]},{"id":"blk-43959","kind":"paragraph","spans":[{"id":"spn-50782","text":"Process explicit feedback on a specific node:"}]},{"id":"blk-43960","kind":"code","language":"text","text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"negative\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"correction\", correction: \"The correct fact is...\")"},{"id":"blk-43961","items":[{"blocks":[{"id":"blk-43963","kind":"paragraph","spans":[{"id":"spn-50783","marks":["code"],"text":"positive"},{"id":"spn-50784","text":" → routes through "},{"id":"spn-50785","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-50786","text":" with status "},{"id":"spn-50787","marks":["code"],"text":"success"}]}],"id":"blk-43962","kind":"list-item"},{"blocks":[{"id":"blk-43965","kind":"paragraph","spans":[{"id":"spn-50788","marks":["code"],"text":"negative"},{"id":"spn-50789","text":" → routes through "},{"id":"spn-50790","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-50791","text":" with status "},{"id":"spn-50792","marks":["code"],"text":"failure"}]}],"id":"blk-43964","kind":"list-item"},{"blocks":[{"id":"blk-43967","kind":"paragraph","spans":[{"id":"spn-50793","marks":["code"],"text":"correction"},{"id":"spn-50794","text":" → directly updates the node content"}]}],"id":"blk-43966","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43968","kind":"heading","level":2,"spans":[{"id":"spn-50795","text":"Detect Novelty"}]},{"id":"blk-43969","kind":"paragraph","spans":[{"id":"spn-50796","text":"Check if a query represents knowledge not yet in the graph:"}]},{"id":"blk-43970","kind":"code","language":"text","text":"learn(action: \"detect_novelty\", query: \"some new concept\", threshold: 0.35)"},{"id":"blk-43971","kind":"paragraph","spans":[{"id":"spn-50797","text":"Returns "},{"id":"spn-50798","marks":["code"],"text":"is_novel"},{"id":"spn-50799","text":" (bool), "},{"id":"spn-50800","marks":["code"],"text":"novelty_score"},{"id":"spn-50801","text":" (0.0–1.0), and "},{"id":"spn-50802","marks":["code"],"text":"nearest_nodes"},{"id":"spn-50803","text":" with similarity scores. Higher novelty = less existing coverage."}]},{"id":"blk-43972","kind":"heading","level":2,"spans":[{"id":"spn-50804","text":"Learn from Interaction"}]},{"id":"blk-43973","kind":"paragraph","spans":[{"id":"spn-50805","text":"Full learning pipeline for a user-model exchange:"}]},{"id":"blk-43974","kind":"code","language":"text","text":"learn(\n  action: \"from_interaction\",\n  user_message: \"How does the auth middleware work?\",\n  model_response: \"The auth middleware validates JWT tokens and...\",\n  novelty_threshold: 0.35\n)"},{"id":"blk-43975","kind":"paragraph","spans":[{"id":"spn-50806","text":"Pipeline: novelty check → store episodic node → extract semantic claims from response → create "},{"id":"spn-50807","marks":["code"],"text":"derived_from"},{"id":"spn-50808","text":" edges → link to nearest existing nodes."}]},{"id":"blk-43976","kind":"heading","level":2,"spans":[{"id":"spn-50809","text":"Anti-patterns to avoid"}]},{"id":"blk-43977","items":[{"blocks":[{"id":"blk-43979","kind":"paragraph","spans":[{"id":"spn-50810","text":"Fire and forget — never reporting outcomes after using retrieved knowledge"}]}],"id":"blk-43978","kind":"list-item"},{"blocks":[{"id":"blk-43981","kind":"paragraph","spans":[{"id":"spn-50811","text":"Using "},{"id":"spn-50812","marks":["code"],"text":"failure"},{"id":"spn-50813","text":" when you mean "},{"id":"spn-50814","marks":["code"],"text":"timeout"},{"id":"spn-50815","text":" — timeout means unknown, not wrong"}]}],"id":"blk-43980","kind":"list-item"},{"blocks":[{"id":"blk-43983","kind":"paragraph","spans":[{"id":"spn-50816","text":"Fabricating causal node IDs — only use IDs from actual "},{"id":"spn-50817","marks":["code"],"text":"causal_context"}]}],"id":"blk-43982","kind":"list-item"},{"blocks":[{"id":"blk-43985","kind":"paragraph","spans":[{"id":"spn-50818","text":"Setting confidence to 1.0 on every outcome — calibrate by signal reliability"}]}],"id":"blk-43984","kind":"list-item"},{"blocks":[{"id":"blk-43987","kind":"paragraph","spans":[{"id":"spn-50819","text":"Discarding "},{"id":"spn-50820","marks":["code"],"text":"causal_context"},{"id":"spn-50821","text":" between retrieval and outcome — hold it in working memory"}]}],"id":"blk-43986","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera4qifmb6azsi3fbd2gn55u4jxkckcfcm6vjj3hvr3uos4i5x3wp5q","vocabulary":"ampersand.docs.fs.v1"}