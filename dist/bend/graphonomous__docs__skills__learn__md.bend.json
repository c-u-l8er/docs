{"bendscript":"0.1","blocks":[{"id":"blk-75136","kind":"heading","level":1,"spans":[{"id":"spn-137844","text":"Learning Loop"}]},{"id":"blk-75137","kind":"paragraph","spans":[{"id":"spn-137845","text":"Close the feedback loop so the graph learns what works and what doesn't."}]},{"id":"blk-75138","kind":"heading","level":2,"spans":[{"id":"spn-137846","text":"Arguments"}]},{"id":"blk-75139","kind":"paragraph","spans":[{"id":"spn-137847","text":"Action and status: $ARGUMENTS"}]},{"id":"blk-75140","kind":"heading","level":2,"spans":[{"id":"spn-137848","text":"Report an Outcome"}]},{"id":"blk-75141","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"descriptive-slug-of-what-you-did\",\n  status: \"success\",\n  confidence: 0.8,\n  causal_node_ids: [\"<id1>\", \"<id2>\"]\n)"},{"id":"blk-75142","kind":"paragraph","spans":[{"id":"spn-137849","marks":["bold"],"text":"Required fields:"}]},{"id":"blk-75143","items":[{"blocks":[{"id":"blk-75145","kind":"paragraph","spans":[{"id":"spn-137850","marks":["code"],"text":"action_id"},{"id":"spn-137851","text":" — descriptive slug of the action taken"}]}],"id":"blk-75144","kind":"list-item"},{"blocks":[{"id":"blk-75147","kind":"paragraph","spans":[{"id":"spn-137852","marks":["code"],"text":"status"},{"id":"spn-137853","text":" — one of: "},{"id":"spn-137854","marks":["code"],"text":"success"},{"id":"spn-137855","text":", "},{"id":"spn-137856","marks":["code"],"text":"partial_success"},{"id":"spn-137857","text":", "},{"id":"spn-137858","marks":["code"],"text":"failure"},{"id":"spn-137859","text":", "},{"id":"spn-137860","marks":["code"],"text":"timeout"}]}],"id":"blk-75146","kind":"list-item"},{"blocks":[{"id":"blk-75149","kind":"paragraph","spans":[{"id":"spn-137861","marks":["code"],"text":"confidence"},{"id":"spn-137862","text":" — 0.0–1.0, reliability of this feedback signal (NOT the original decision quality)"}]}],"id":"blk-75148","kind":"list-item"},{"blocks":[{"id":"blk-75151","kind":"paragraph","spans":[{"id":"spn-137863","marks":["code"],"text":"causal_node_ids"},{"id":"spn-137864","text":" — from "},{"id":"spn-137865","marks":["code"],"text":"causal_context"},{"id":"spn-137866","text":" saved during retrieval"}]}],"id":"blk-75150","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75152","kind":"paragraph","spans":[{"id":"spn-137867","marks":["bold"],"text":"Optional fields:"}]},{"id":"blk-75153","items":[{"blocks":[{"id":"blk-75155","kind":"paragraph","spans":[{"id":"spn-137868","marks":["code"],"text":"evidence"},{"id":"spn-137869","text":" — structured evidence object (test results, metrics, user feedback)"}]}],"id":"blk-75154","kind":"list-item"},{"blocks":[{"id":"blk-75157","kind":"paragraph","spans":[{"id":"spn-137870","marks":["code"],"text":"retrieval_trace_id"},{"id":"spn-137871","text":" — audit trail linking back to the retrieval call"}]}],"id":"blk-75156","kind":"list-item"},{"blocks":[{"id":"blk-75159","kind":"paragraph","spans":[{"id":"spn-137872","marks":["code"],"text":"decision_trace_id"},{"id":"spn-137873","text":" — for multi-agent setups tracking decision provenance"}]}],"id":"blk-75158","kind":"list-item"},{"blocks":[{"id":"blk-75161","kind":"paragraph","spans":[{"id":"spn-137874","marks":["code"],"text":"action_linkage"},{"id":"spn-137875","text":" — metadata about what action was taken"}]}],"id":"blk-75160","kind":"list-item"},{"blocks":[{"id":"blk-75163","kind":"paragraph","spans":[{"id":"spn-137876","marks":["code"],"text":"grounding"},{"id":"spn-137877","text":" — outcome provenance (where the feedback signal came from)"}]}],"id":"blk-75162","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75164","kind":"paragraph","spans":[{"id":"spn-137878","marks":["bold"],"text":"Status meanings and confidence effects:"}]},{"id":"blk-75165","items":[{"blocks":[{"id":"blk-75167","kind":"paragraph","spans":[{"id":"spn-137879","marks":["code"],"text":"success"},{"id":"spn-137880","text":" → boosts confidence of causal nodes"}]}],"id":"blk-75166","kind":"list-item"},{"blocks":[{"id":"blk-75169","kind":"paragraph","spans":[{"id":"spn-137881","marks":["code"],"text":"failure"},{"id":"spn-137882","text":" → reduces confidence of causal nodes (the knowledge was wrong/misleading)"}]}],"id":"blk-75168","kind":"list-item"},{"blocks":[{"id":"blk-75171","kind":"paragraph","spans":[{"id":"spn-137883","marks":["code"],"text":"partial_success"},{"id":"spn-137884","text":" → small boost"}]}],"id":"blk-75170","kind":"list-item"},{"blocks":[{"id":"blk-75173","kind":"paragraph","spans":[{"id":"spn-137885","marks":["code"],"text":"timeout"},{"id":"spn-137886","text":" → minimal change — "},{"id":"spn-137887","marks":["bold"],"text":"NOT the same as failure!"},{"id":"spn-137888","text":" Use when outcome is unknown."}]}],"id":"blk-75172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75174","kind":"heading","level":3,"spans":[{"id":"spn-137889","text":"Response structure"}]},{"id":"blk-75175","kind":"paragraph","spans":[{"id":"spn-137890","text":"The response contains per-node confidence updates:"}]},{"id":"blk-75176","kind":"code","language":"json","text":"{\n  \"processed\": 3,\n  \"skipped\": 0,\n  \"updates\": [\n    {\"node_id\": \"abc\", \"old_confidence\": 0.7, \"new_confidence\": 0.78},\n    {\"node_id\": \"def\", \"old_confidence\": 0.6, \"new_confidence\": 0.67}\n  ]\n}"},{"id":"blk-75177","kind":"paragraph","spans":[{"id":"spn-137891","marks":["code"],"text":"processed"},{"id":"spn-137892","text":" = causal nodes examined; "},{"id":"spn-137893","marks":["code"],"text":"skipped"},{"id":"spn-137894","text":" = nodes not found. Confidence adjustments are bounded — outcome confidence scales the delta (high-confidence feedback produces larger changes)."}]},{"id":"blk-75178","kind":"heading","level":2,"spans":[{"id":"spn-137895","text":"Full provenance example"}]},{"id":"blk-75179","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"fix-auth-middleware\",\n  status: \"success\",\n  confidence: 0.9,\n  causal_node_ids: [\"node-abc\", \"node-def\"],\n  evidence: {\"test_passed\": true, \"error_resolved\": true, \"regression_check\": \"clean\"},\n  retrieval_trace_id: \"ret-12345\",\n  grounding: \"test suite output confirmed fix\"\n)"},{"id":"blk-75180","kind":"heading","level":2,"spans":[{"id":"spn-137896","text":"Pattern"}]},{"id":"blk-75181","items":[{"blocks":[{"id":"blk-75183","kind":"paragraph","spans":[{"id":"spn-137897","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-137898","text":" → save "},{"id":"spn-137899","marks":["code"],"text":"causal_context"}]}],"id":"blk-75182","kind":"list-item"},{"blocks":[{"id":"blk-75185","kind":"paragraph","spans":[{"id":"spn-137900","text":"Act on retrieved knowledge"}]}],"id":"blk-75184","kind":"list-item"},{"blocks":[{"id":"blk-75187","kind":"paragraph","spans":[{"id":"spn-137901","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-137902","text":" with real causal IDs and honest status"}]}],"id":"blk-75186","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75188","kind":"heading","level":2,"spans":[{"id":"spn-137903","text":"Learn from Feedback"}]},{"id":"blk-75189","kind":"paragraph","spans":[{"id":"spn-137904","text":"Process explicit feedback on a specific node:"}]},{"id":"blk-75190","kind":"code","language":"text","text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"negative\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"correction\", correction: \"The correct fact is...\")"},{"id":"blk-75191","items":[{"blocks":[{"id":"blk-75193","kind":"paragraph","spans":[{"id":"spn-137905","marks":["code"],"text":"positive"},{"id":"spn-137906","text":" → routes through "},{"id":"spn-137907","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-137908","text":" with status "},{"id":"spn-137909","marks":["code"],"text":"success"}]}],"id":"blk-75192","kind":"list-item"},{"blocks":[{"id":"blk-75195","kind":"paragraph","spans":[{"id":"spn-137910","marks":["code"],"text":"negative"},{"id":"spn-137911","text":" → routes through "},{"id":"spn-137912","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-137913","text":" with status "},{"id":"spn-137914","marks":["code"],"text":"failure"}]}],"id":"blk-75194","kind":"list-item"},{"blocks":[{"id":"blk-75197","kind":"paragraph","spans":[{"id":"spn-137915","marks":["code"],"text":"correction"},{"id":"spn-137916","text":" → directly updates the node content"}]}],"id":"blk-75196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75198","kind":"heading","level":2,"spans":[{"id":"spn-137917","text":"Detect Novelty"}]},{"id":"blk-75199","kind":"paragraph","spans":[{"id":"spn-137918","text":"Check if a query represents knowledge not yet in the graph:"}]},{"id":"blk-75200","kind":"code","language":"text","text":"learn(action: \"detect_novelty\", query: \"some new concept\", threshold: 0.35)"},{"id":"blk-75201","kind":"paragraph","spans":[{"id":"spn-137919","text":"Returns "},{"id":"spn-137920","marks":["code"],"text":"is_novel"},{"id":"spn-137921","text":" (bool), "},{"id":"spn-137922","marks":["code"],"text":"novelty_score"},{"id":"spn-137923","text":" (0.0–1.0), and "},{"id":"spn-137924","marks":["code"],"text":"nearest_nodes"},{"id":"spn-137925","text":" with similarity scores. Higher novelty = less existing coverage."}]},{"id":"blk-75202","kind":"heading","level":2,"spans":[{"id":"spn-137926","text":"Learn from Interaction"}]},{"id":"blk-75203","kind":"paragraph","spans":[{"id":"spn-137927","text":"Full learning pipeline for a user-model exchange:"}]},{"id":"blk-75204","kind":"code","language":"text","text":"learn(\n  action: \"from_interaction\",\n  user_message: \"How does the auth middleware work?\",\n  model_response: \"The auth middleware validates JWT tokens and...\",\n  novelty_threshold: 0.35\n)"},{"id":"blk-75205","kind":"paragraph","spans":[{"id":"spn-137928","text":"Pipeline: novelty check → store episodic node → extract semantic claims from response → create "},{"id":"spn-137929","marks":["code"],"text":"derived_from"},{"id":"spn-137930","text":" edges → link to nearest existing nodes."}]},{"id":"blk-75206","kind":"heading","level":2,"spans":[{"id":"spn-137931","text":"Anti-patterns to avoid"}]},{"id":"blk-75207","items":[{"blocks":[{"id":"blk-75209","kind":"paragraph","spans":[{"id":"spn-137932","text":"Fire and forget — never reporting outcomes after using retrieved knowledge"}]}],"id":"blk-75208","kind":"list-item"},{"blocks":[{"id":"blk-75211","kind":"paragraph","spans":[{"id":"spn-137933","text":"Using "},{"id":"spn-137934","marks":["code"],"text":"failure"},{"id":"spn-137935","text":" when you mean "},{"id":"spn-137936","marks":["code"],"text":"timeout"},{"id":"spn-137937","text":" — timeout means unknown, not wrong"}]}],"id":"blk-75210","kind":"list-item"},{"blocks":[{"id":"blk-75213","kind":"paragraph","spans":[{"id":"spn-137938","text":"Fabricating causal node IDs — only use IDs from actual "},{"id":"spn-137939","marks":["code"],"text":"causal_context"}]}],"id":"blk-75212","kind":"list-item"},{"blocks":[{"id":"blk-75215","kind":"paragraph","spans":[{"id":"spn-137940","text":"Setting confidence to 1.0 on every outcome — calibrate by signal reliability"}]}],"id":"blk-75214","kind":"list-item"},{"blocks":[{"id":"blk-75217","kind":"paragraph","spans":[{"id":"spn-137941","text":"Discarding "},{"id":"spn-137942","marks":["code"],"text":"causal_context"},{"id":"spn-137943","text":" between retrieval and outcome — hold it in working memory"}]}],"id":"blk-75216","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraldixulxndwu47vuqcjdjhr5fcishn2wsgkvpl24or54ao5tdyssq","vocabulary":"ampersand.docs.fs.v1"}