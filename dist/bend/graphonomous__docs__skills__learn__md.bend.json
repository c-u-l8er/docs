{"bendscript":"0.1","blocks":[{"id":"blk-67642","kind":"heading","level":1,"spans":[{"id":"spn-98280","text":"Learning Loop"}]},{"id":"blk-67643","kind":"paragraph","spans":[{"id":"spn-98281","text":"Close the feedback loop so the graph learns what works and what doesn't."}]},{"id":"blk-67644","kind":"heading","level":2,"spans":[{"id":"spn-98282","text":"Arguments"}]},{"id":"blk-67645","kind":"paragraph","spans":[{"id":"spn-98283","text":"Action and status: $ARGUMENTS"}]},{"id":"blk-67646","kind":"heading","level":2,"spans":[{"id":"spn-98284","text":"Report an Outcome"}]},{"id":"blk-67647","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"descriptive-slug-of-what-you-did\",\n  status: \"success\",\n  confidence: 0.8,\n  causal_node_ids: [\"<id1>\", \"<id2>\"]\n)"},{"id":"blk-67648","kind":"paragraph","spans":[{"id":"spn-98285","marks":["bold"],"text":"Required fields:"}]},{"id":"blk-67649","items":[{"blocks":[{"id":"blk-67651","kind":"paragraph","spans":[{"id":"spn-98286","marks":["code"],"text":"action_id"},{"id":"spn-98287","text":" — descriptive slug of the action taken"}]}],"id":"blk-67650","kind":"list-item"},{"blocks":[{"id":"blk-67653","kind":"paragraph","spans":[{"id":"spn-98288","marks":["code"],"text":"status"},{"id":"spn-98289","text":" — one of: "},{"id":"spn-98290","marks":["code"],"text":"success"},{"id":"spn-98291","text":", "},{"id":"spn-98292","marks":["code"],"text":"partial_success"},{"id":"spn-98293","text":", "},{"id":"spn-98294","marks":["code"],"text":"failure"},{"id":"spn-98295","text":", "},{"id":"spn-98296","marks":["code"],"text":"timeout"}]}],"id":"blk-67652","kind":"list-item"},{"blocks":[{"id":"blk-67655","kind":"paragraph","spans":[{"id":"spn-98297","marks":["code"],"text":"confidence"},{"id":"spn-98298","text":" — 0.0–1.0, reliability of this feedback signal (NOT the original decision quality)"}]}],"id":"blk-67654","kind":"list-item"},{"blocks":[{"id":"blk-67657","kind":"paragraph","spans":[{"id":"spn-98299","marks":["code"],"text":"causal_node_ids"},{"id":"spn-98300","text":" — from "},{"id":"spn-98301","marks":["code"],"text":"causal_context"},{"id":"spn-98302","text":" saved during retrieval"}]}],"id":"blk-67656","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67658","kind":"paragraph","spans":[{"id":"spn-98303","marks":["bold"],"text":"Optional fields:"}]},{"id":"blk-67659","items":[{"blocks":[{"id":"blk-67661","kind":"paragraph","spans":[{"id":"spn-98304","marks":["code"],"text":"evidence"},{"id":"spn-98305","text":" — structured evidence object (test results, metrics, user feedback)"}]}],"id":"blk-67660","kind":"list-item"},{"blocks":[{"id":"blk-67663","kind":"paragraph","spans":[{"id":"spn-98306","marks":["code"],"text":"retrieval_trace_id"},{"id":"spn-98307","text":" — audit trail linking back to the retrieval call"}]}],"id":"blk-67662","kind":"list-item"},{"blocks":[{"id":"blk-67665","kind":"paragraph","spans":[{"id":"spn-98308","marks":["code"],"text":"decision_trace_id"},{"id":"spn-98309","text":" — for multi-agent setups tracking decision provenance"}]}],"id":"blk-67664","kind":"list-item"},{"blocks":[{"id":"blk-67667","kind":"paragraph","spans":[{"id":"spn-98310","marks":["code"],"text":"action_linkage"},{"id":"spn-98311","text":" — metadata about what action was taken"}]}],"id":"blk-67666","kind":"list-item"},{"blocks":[{"id":"blk-67669","kind":"paragraph","spans":[{"id":"spn-98312","marks":["code"],"text":"grounding"},{"id":"spn-98313","text":" — outcome provenance (where the feedback signal came from)"}]}],"id":"blk-67668","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67670","kind":"paragraph","spans":[{"id":"spn-98314","marks":["bold"],"text":"Status meanings and confidence effects:"}]},{"id":"blk-67671","items":[{"blocks":[{"id":"blk-67673","kind":"paragraph","spans":[{"id":"spn-98315","marks":["code"],"text":"success"},{"id":"spn-98316","text":" → boosts confidence of causal nodes"}]}],"id":"blk-67672","kind":"list-item"},{"blocks":[{"id":"blk-67675","kind":"paragraph","spans":[{"id":"spn-98317","marks":["code"],"text":"failure"},{"id":"spn-98318","text":" → reduces confidence of causal nodes (the knowledge was wrong/misleading)"}]}],"id":"blk-67674","kind":"list-item"},{"blocks":[{"id":"blk-67677","kind":"paragraph","spans":[{"id":"spn-98319","marks":["code"],"text":"partial_success"},{"id":"spn-98320","text":" → small boost"}]}],"id":"blk-67676","kind":"list-item"},{"blocks":[{"id":"blk-67679","kind":"paragraph","spans":[{"id":"spn-98321","marks":["code"],"text":"timeout"},{"id":"spn-98322","text":" → minimal change — "},{"id":"spn-98323","marks":["bold"],"text":"NOT the same as failure!"},{"id":"spn-98324","text":" Use when outcome is unknown."}]}],"id":"blk-67678","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67680","kind":"heading","level":3,"spans":[{"id":"spn-98325","text":"Response structure"}]},{"id":"blk-67681","kind":"paragraph","spans":[{"id":"spn-98326","text":"The response contains per-node confidence updates:"}]},{"id":"blk-67682","kind":"code","language":"json","text":"{\n  \"processed\": 3,\n  \"skipped\": 0,\n  \"updates\": [\n    {\"node_id\": \"abc\", \"old_confidence\": 0.7, \"new_confidence\": 0.78},\n    {\"node_id\": \"def\", \"old_confidence\": 0.6, \"new_confidence\": 0.67}\n  ]\n}"},{"id":"blk-67683","kind":"paragraph","spans":[{"id":"spn-98327","marks":["code"],"text":"processed"},{"id":"spn-98328","text":" = causal nodes examined; "},{"id":"spn-98329","marks":["code"],"text":"skipped"},{"id":"spn-98330","text":" = nodes not found. Confidence adjustments are bounded — outcome confidence scales the delta (high-confidence feedback produces larger changes)."}]},{"id":"blk-67684","kind":"heading","level":2,"spans":[{"id":"spn-98331","text":"Full provenance example"}]},{"id":"blk-67685","kind":"code","language":"text","text":"learn(\n  action: \"from_outcome\",\n  action_id: \"fix-auth-middleware\",\n  status: \"success\",\n  confidence: 0.9,\n  causal_node_ids: [\"node-abc\", \"node-def\"],\n  evidence: {\"test_passed\": true, \"error_resolved\": true, \"regression_check\": \"clean\"},\n  retrieval_trace_id: \"ret-12345\",\n  grounding: \"test suite output confirmed fix\"\n)"},{"id":"blk-67686","kind":"heading","level":2,"spans":[{"id":"spn-98332","text":"Pattern"}]},{"id":"blk-67687","items":[{"blocks":[{"id":"blk-67689","kind":"paragraph","spans":[{"id":"spn-98333","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-98334","text":" → save "},{"id":"spn-98335","marks":["code"],"text":"causal_context"}]}],"id":"blk-67688","kind":"list-item"},{"blocks":[{"id":"blk-67691","kind":"paragraph","spans":[{"id":"spn-98336","text":"Act on retrieved knowledge"}]}],"id":"blk-67690","kind":"list-item"},{"blocks":[{"id":"blk-67693","kind":"paragraph","spans":[{"id":"spn-98337","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-98338","text":" with real causal IDs and honest status"}]}],"id":"blk-67692","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67694","kind":"heading","level":2,"spans":[{"id":"spn-98339","text":"Learn from Feedback"}]},{"id":"blk-67695","kind":"paragraph","spans":[{"id":"spn-98340","text":"Process explicit feedback on a specific node:"}]},{"id":"blk-67696","kind":"code","language":"text","text":"learn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"positive\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"negative\")\nlearn(action: \"from_feedback\", node_id: \"<id>\", feedback_type: \"correction\", correction: \"The correct fact is...\")"},{"id":"blk-67697","items":[{"blocks":[{"id":"blk-67699","kind":"paragraph","spans":[{"id":"spn-98341","marks":["code"],"text":"positive"},{"id":"spn-98342","text":" → routes through "},{"id":"spn-98343","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98344","text":" with status "},{"id":"spn-98345","marks":["code"],"text":"success"}]}],"id":"blk-67698","kind":"list-item"},{"blocks":[{"id":"blk-67701","kind":"paragraph","spans":[{"id":"spn-98346","marks":["code"],"text":"negative"},{"id":"spn-98347","text":" → routes through "},{"id":"spn-98348","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98349","text":" with status "},{"id":"spn-98350","marks":["code"],"text":"failure"}]}],"id":"blk-67700","kind":"list-item"},{"blocks":[{"id":"blk-67703","kind":"paragraph","spans":[{"id":"spn-98351","marks":["code"],"text":"correction"},{"id":"spn-98352","text":" → directly updates the node content"}]}],"id":"blk-67702","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67704","kind":"heading","level":2,"spans":[{"id":"spn-98353","text":"Detect Novelty"}]},{"id":"blk-67705","kind":"paragraph","spans":[{"id":"spn-98354","text":"Check if a query represents knowledge not yet in the graph:"}]},{"id":"blk-67706","kind":"code","language":"text","text":"learn(action: \"detect_novelty\", query: \"some new concept\", threshold: 0.35)"},{"id":"blk-67707","kind":"paragraph","spans":[{"id":"spn-98355","text":"Returns "},{"id":"spn-98356","marks":["code"],"text":"is_novel"},{"id":"spn-98357","text":" (bool), "},{"id":"spn-98358","marks":["code"],"text":"novelty_score"},{"id":"spn-98359","text":" (0.0–1.0), and "},{"id":"spn-98360","marks":["code"],"text":"nearest_nodes"},{"id":"spn-98361","text":" with similarity scores. Higher novelty = less existing coverage."}]},{"id":"blk-67708","kind":"heading","level":2,"spans":[{"id":"spn-98362","text":"Learn from Interaction"}]},{"id":"blk-67709","kind":"paragraph","spans":[{"id":"spn-98363","text":"Full learning pipeline for a user-model exchange:"}]},{"id":"blk-67710","kind":"code","language":"text","text":"learn(\n  action: \"from_interaction\",\n  user_message: \"How does the auth middleware work?\",\n  model_response: \"The auth middleware validates JWT tokens and...\",\n  novelty_threshold: 0.35\n)"},{"id":"blk-67711","kind":"paragraph","spans":[{"id":"spn-98364","text":"Pipeline: novelty check → store episodic node → extract semantic claims from response → create "},{"id":"spn-98365","marks":["code"],"text":"derived_from"},{"id":"spn-98366","text":" edges → link to nearest existing nodes."}]},{"id":"blk-67712","kind":"heading","level":2,"spans":[{"id":"spn-98367","text":"Anti-patterns to avoid"}]},{"id":"blk-67713","items":[{"blocks":[{"id":"blk-67715","kind":"paragraph","spans":[{"id":"spn-98368","text":"Fire and forget — never reporting outcomes after using retrieved knowledge"}]}],"id":"blk-67714","kind":"list-item"},{"blocks":[{"id":"blk-67717","kind":"paragraph","spans":[{"id":"spn-98369","text":"Using "},{"id":"spn-98370","marks":["code"],"text":"failure"},{"id":"spn-98371","text":" when you mean "},{"id":"spn-98372","marks":["code"],"text":"timeout"},{"id":"spn-98373","text":" — timeout means unknown, not wrong"}]}],"id":"blk-67716","kind":"list-item"},{"blocks":[{"id":"blk-67719","kind":"paragraph","spans":[{"id":"spn-98374","text":"Fabricating causal node IDs — only use IDs from actual "},{"id":"spn-98375","marks":["code"],"text":"causal_context"}]}],"id":"blk-67718","kind":"list-item"},{"blocks":[{"id":"blk-67721","kind":"paragraph","spans":[{"id":"spn-98376","text":"Setting confidence to 1.0 on every outcome — calibrate by signal reliability"}]}],"id":"blk-67720","kind":"list-item"},{"blocks":[{"id":"blk-67723","kind":"paragraph","spans":[{"id":"spn-98377","text":"Discarding "},{"id":"spn-98378","marks":["code"],"text":"causal_context"},{"id":"spn-98379","text":" between retrieval and outcome — hold it in working memory"}]}],"id":"blk-67722","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera4hjn5bsziggrbjowqjua7vwdy5vuf2plr5ympcunodnpxqak3esa","vocabulary":"ampersand.docs.fs.v1"}