{"bendscript":"0.1","blocks":[{"id":"blk-14684","kind":"heading","level":1,"spans":[{"id":"spn-13008","marks":["code"],"text":"&time.forecast"},{"id":"spn-13009","text":" — Forecasting as a Capability"}]},{"id":"blk-14685","kind":"paragraph","spans":[{"id":"spn-13010","marks":["code"],"text":"&time.forecast"},{"id":"spn-13011","text":" is a capability page for the [&] Protocol's temporal forecasting subtype."}]},{"id":"blk-14686","kind":"paragraph","spans":[{"id":"spn-13012","text":"It describes a composable interface for agents that need to predict future state from historical or streaming temporal data. The goal is not to standardize one forecasting algorithm. The goal is to standardize how an agent declares, validates, and composes forecasting ability as part of its cognitive architecture."}]},{"id":"blk-14687","kind":"paragraph","spans":[{"id":"spn-13013","text":"In protocol terms:"}]},{"id":"blk-14688","items":[{"blocks":[{"id":"blk-14690","kind":"paragraph","spans":[{"id":"spn-13014","text":"primitive: "},{"id":"spn-13015","marks":["code"],"text":"&time"}]}],"id":"blk-14689","kind":"list-item"},{"blocks":[{"id":"blk-14692","kind":"paragraph","spans":[{"id":"spn-13016","text":"subtype: "},{"id":"spn-13017","marks":["code"],"text":"forecast"}]}],"id":"blk-14691","kind":"list-item"},{"blocks":[{"id":"blk-14694","kind":"paragraph","spans":[{"id":"spn-13018","text":"full capability id: "},{"id":"spn-13019","marks":["code"],"text":"&time.forecast"}]}],"id":"blk-14693","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14695","kind":"heading","level":2,"spans":[{"id":"spn-13020","text":"1. Definition"}]},{"id":"blk-14696","kind":"paragraph","spans":[{"id":"spn-13021","marks":["code"],"text":"&time.forecast"},{"id":"spn-13022","text":" is the protocol capability for "},{"id":"spn-13023","marks":["bold"],"text":"predictive temporal inference"},{"id":"spn-13024","text":"."}]},{"id":"blk-14697","kind":"paragraph","spans":[{"id":"spn-13025","text":"It answers questions like:"}]},{"id":"blk-14698","items":[{"blocks":[{"id":"blk-14700","kind":"paragraph","spans":[{"id":"spn-13026","text":"What is likely to happen next?"}]}],"id":"blk-14699","kind":"list-item"},{"blocks":[{"id":"blk-14702","kind":"paragraph","spans":[{"id":"spn-13027","text":"How much demand should we expect over the next hour, day, or week?"}]}],"id":"blk-14701","kind":"list-item"},{"blocks":[{"id":"blk-14704","kind":"paragraph","spans":[{"id":"spn-13028","text":"Which regions are likely to exceed capacity soon?"}]}],"id":"blk-14703","kind":"list-item"},{"blocks":[{"id":"blk-14706","kind":"paragraph","spans":[{"id":"spn-13029","text":"What future load should a planner or reasoner prepare for?"}]}],"id":"blk-14705","kind":"list-item"},{"blocks":[{"id":"blk-14708","kind":"paragraph","spans":[{"id":"spn-13030","text":"How confident is the system in its temporal prediction?"}]}],"id":"blk-14707","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14709","kind":"paragraph","spans":[{"id":"spn-13031","text":"A provider that satisfies "},{"id":"spn-13032","marks":["code"],"text":"&time.forecast"},{"id":"spn-13033","text":" should expose operations that turn temporal data into forecast-oriented artifacts that downstream capabilities can consume."}]},{"id":"blk-14710","kind":"paragraph","spans":[{"id":"spn-13034","text":"This is distinct from:"}]},{"id":"blk-14711","items":[{"blocks":[{"id":"blk-14713","kind":"paragraph","spans":[{"id":"spn-13035","marks":["code"],"text":"&time.anomaly"},{"id":"spn-13036","text":" — detecting unusual current or recent behavior"}]}],"id":"blk-14712","kind":"list-item"},{"blocks":[{"id":"blk-14715","kind":"paragraph","spans":[{"id":"spn-13037","marks":["code"],"text":"&time.pattern"},{"id":"spn-13038","text":" — identifying recurring or structural behavior over time"}]}],"id":"blk-14714","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14716","kind":"paragraph","spans":[{"id":"spn-13039","marks":["code"],"text":"&time.forecast"},{"id":"spn-13040","text":" is about "},{"id":"spn-13041","marks":["bold"],"text":"future-oriented estimation"},{"id":"spn-13042","text":"."}]},{"id":"blk-14717","kind":"heading","level":2,"spans":[{"id":"spn-13043","text":"2. Why this capability matters"}]},{"id":"blk-14718","kind":"paragraph","spans":[{"id":"spn-13044","text":"A large class of useful agents need more than retrieval and reasoning over current context."}]},{"id":"blk-14719","kind":"paragraph","spans":[{"id":"spn-13045","text":"They need to anticipate:"}]},{"id":"blk-14720","items":[{"blocks":[{"id":"blk-14722","kind":"paragraph","spans":[{"id":"spn-13046","text":"traffic spikes"}]}],"id":"blk-14721","kind":"list-item"},{"blocks":[{"id":"blk-14724","kind":"paragraph","spans":[{"id":"spn-13047","text":"incident volume"}]}],"id":"blk-14723","kind":"list-item"},{"blocks":[{"id":"blk-14726","kind":"paragraph","spans":[{"id":"spn-13048","text":"regional load"}]}],"id":"blk-14725","kind":"list-item"},{"blocks":[{"id":"blk-14728","kind":"paragraph","spans":[{"id":"spn-13049","text":"staffing demand"}]}],"id":"blk-14727","kind":"list-item"},{"blocks":[{"id":"blk-14730","kind":"paragraph","spans":[{"id":"spn-13050","text":"inventory or route pressure"}]}],"id":"blk-14729","kind":"list-item"},{"blocks":[{"id":"blk-14732","kind":"paragraph","spans":[{"id":"spn-13051","text":"support queue growth"}]}],"id":"blk-14731","kind":"list-item"},{"blocks":[{"id":"blk-14734","kind":"paragraph","spans":[{"id":"spn-13052","text":"resource exhaustion"}]}],"id":"blk-14733","kind":"list-item"},{"blocks":[{"id":"blk-14736","kind":"paragraph","spans":[{"id":"spn-13053","text":"maintenance windows"}]}],"id":"blk-14735","kind":"list-item"},{"blocks":[{"id":"blk-14738","kind":"paragraph","spans":[{"id":"spn-13054","text":"operational drift"}]}],"id":"blk-14737","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14739","kind":"paragraph","spans":[{"id":"spn-13055","text":"Without an explicit forecasting capability, systems often hide predictive logic inside:"}]},{"id":"blk-14740","items":[{"blocks":[{"id":"blk-14742","kind":"paragraph","spans":[{"id":"spn-13056","text":"custom analytics code"}]}],"id":"blk-14741","kind":"list-item"},{"blocks":[{"id":"blk-14744","kind":"paragraph","spans":[{"id":"spn-13057","text":"prompts"}]}],"id":"blk-14743","kind":"list-item"},{"blocks":[{"id":"blk-14746","kind":"paragraph","spans":[{"id":"spn-13058","text":"ad hoc tool wrappers"}]}],"id":"blk-14745","kind":"list-item"},{"blocks":[{"id":"blk-14748","kind":"paragraph","spans":[{"id":"spn-13059","text":"vendor-specific integrations"}]}],"id":"blk-14747","kind":"list-item"},{"blocks":[{"id":"blk-14750","kind":"paragraph","spans":[{"id":"spn-13060","text":"application business logic"}]}],"id":"blk-14749","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14751","kind":"paragraph","spans":[{"id":"spn-13061","text":"That makes architectures hard to compare, validate, and reuse."}]},{"id":"blk-14752","kind":"paragraph","spans":[{"id":"spn-13062","text":"By treating forecasting as a protocol capability, the [&] Protocol makes it possible to:"}]},{"id":"blk-14753","items":[{"blocks":[{"id":"blk-14755","kind":"paragraph","spans":[{"id":"spn-13063","text":"declare forecasting explicitly"}]}],"id":"blk-14754","kind":"list-item"},{"blocks":[{"id":"blk-14757","kind":"paragraph","spans":[{"id":"spn-13064","text":"bind it to a provider"}]}],"id":"blk-14756","kind":"list-item"},{"blocks":[{"id":"blk-14759","kind":"paragraph","spans":[{"id":"spn-13065","text":"validate pipelines that depend on forecast output"}]}],"id":"blk-14758","kind":"list-item"},{"blocks":[{"id":"blk-14761","kind":"paragraph","spans":[{"id":"spn-13066","text":"preserve provenance for forecast-driven decisions"}]}],"id":"blk-14760","kind":"list-item"},{"blocks":[{"id":"blk-14763","kind":"paragraph","spans":[{"id":"spn-13067","text":"generate downstream MCP and A2A artifacts from the same declaration"}]}],"id":"blk-14762","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14764","kind":"heading","level":2,"spans":[{"id":"spn-13068","text":"3. Capability role in the four-primitive model"}]},{"id":"blk-14765","kind":"paragraph","spans":[{"id":"spn-13069","text":"The [&] Protocol organizes cognition around four top-level domains:"}]},{"id":"blk-14766","items":[{"blocks":[{"id":"blk-14768","kind":"paragraph","spans":[{"id":"spn-13070","marks":["code"],"text":"&memory"},{"id":"spn-13071","text":" — what the agent knows"}]}],"id":"blk-14767","kind":"list-item"},{"blocks":[{"id":"blk-14770","kind":"paragraph","spans":[{"id":"spn-13072","marks":["code"],"text":"&reason"},{"id":"spn-13073","text":" — how the agent decides"}]}],"id":"blk-14769","kind":"list-item"},{"blocks":[{"id":"blk-14772","kind":"paragraph","spans":[{"id":"spn-13074","marks":["code"],"text":"&time"},{"id":"spn-13075","text":" — when things happen"}]}],"id":"blk-14771","kind":"list-item"},{"blocks":[{"id":"blk-14774","kind":"paragraph","spans":[{"id":"spn-13076","marks":["code"],"text":"&space"},{"id":"spn-13077","text":" — where things are"}]}],"id":"blk-14773","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14775","kind":"paragraph","spans":[{"id":"spn-13078","text":"Within that model, "},{"id":"spn-13079","marks":["code"],"text":"&time.forecast"},{"id":"spn-13080","text":" provides the agent's ability to project temporal context forward."}]},{"id":"blk-14776","kind":"paragraph","spans":[{"id":"spn-13081","text":"It often works best when composed with:"}]},{"id":"blk-14777","items":[{"blocks":[{"id":"blk-14779","kind":"paragraph","spans":[{"id":"spn-13082","marks":["code"],"text":"&memory.*"},{"id":"spn-13083","text":" for historical evidence"}]}],"id":"blk-14778","kind":"list-item"},{"blocks":[{"id":"blk-14781","kind":"paragraph","spans":[{"id":"spn-13084","marks":["code"],"text":"&space.*"},{"id":"spn-13085","text":" for region- or fleet-aware forecasting"}]}],"id":"blk-14780","kind":"list-item"},{"blocks":[{"id":"blk-14783","kind":"paragraph","spans":[{"id":"spn-13086","marks":["code"],"text":"&reason.*"},{"id":"spn-13087","text":" for turning predictions into decisions"}]}],"id":"blk-14782","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14784","kind":"paragraph","spans":[{"id":"spn-13088","text":"A useful shorthand is:"}]},{"blocks":[{"id":"blk-14786","kind":"paragraph","spans":[{"id":"spn-13089","marks":["code"],"text":"&time.forecast"},{"id":"spn-13090","text":" tells the agent what future state is plausible enough to plan around."}]}],"id":"blk-14785","kind":"quote"},{"id":"blk-14787","kind":"heading","level":2,"spans":[{"id":"spn-13091","text":"4. Typical use cases"}]},{"id":"blk-14788","kind":"heading","level":3,"spans":[{"id":"spn-13092","text":"Capacity planning"}]},{"id":"blk-14789","kind":"paragraph","spans":[{"id":"spn-13093","text":"Forecast expected demand or load before thresholds are crossed."}]},{"id":"blk-14790","kind":"heading","level":3,"spans":[{"id":"spn-13094","text":"Staffing and support"}]},{"id":"blk-14791","kind":"paragraph","spans":[{"id":"spn-13095","text":"Predict inbound ticket volume or call center load."}]},{"id":"blk-14792","kind":"heading","level":3,"spans":[{"id":"spn-13096","text":"Infrastructure operations"}]},{"id":"blk-14793","kind":"paragraph","spans":[{"id":"spn-13097","text":"Estimate future CPU, memory, traffic, or storage pressure."}]},{"id":"blk-14794","kind":"heading","level":3,"spans":[{"id":"spn-13098","text":"Logistics and fleet management"}]},{"id":"blk-14795","kind":"paragraph","spans":[{"id":"spn-13099","text":"Forecast regional fleet demand, route congestion, or service backlog."}]},{"id":"blk-14796","kind":"heading","level":3,"spans":[{"id":"spn-13100","text":"Maintenance and reliability"}]},{"id":"blk-14797","kind":"paragraph","spans":[{"id":"spn-13101","text":"Project failure likelihood, incident volume, or wear-related workload windows."}]},{"id":"blk-14798","kind":"heading","level":3,"spans":[{"id":"spn-13102","text":"Research and trend monitoring"}]},{"id":"blk-14799","kind":"paragraph","spans":[{"id":"spn-13103","text":"Predict likely changes in topic volume, signal growth, or event frequency."}]},{"id":"blk-14800","kind":"heading","level":2,"spans":[{"id":"spn-13104","text":"5. Example declaration"}]},{"id":"blk-14801","kind":"paragraph","spans":[{"id":"spn-13105","text":"A basic "},{"id":"spn-13106","marks":["code"],"text":"ampersand.json"},{"id":"spn-13107","text":" fragment using "},{"id":"spn-13108","marks":["code"],"text":"&time.forecast"},{"id":"spn-13109","text":":"}]},{"id":"blk-14802","kind":"code","language":"json","text":"{\n  \"&time.forecast\": {\n    \"provider\": \"ticktickclock\",\n    \"config\": {\n      \"horizon_hours\": 24,\n      \"granularity\": \"hourly\",\n      \"targets\": [\"regional_demand\", \"support_volume\"]\n    }\n  }\n}"},{"id":"blk-14803","kind":"paragraph","spans":[{"id":"spn-13110","text":"A goal-driven version using auto resolution:"}]},{"id":"blk-14804","kind":"code","language":"json","text":"{\n  \"&time.forecast\": {\n    \"provider\": \"auto\",\n    \"need\": \"predict next-day support ticket demand by region\"\n  }\n}"},{"id":"blk-14805","kind":"heading","level":2,"spans":[{"id":"spn-13111","text":"6. Compatible providers"}]},{"id":"blk-14806","kind":"paragraph","spans":[{"id":"spn-13112","text":"The protocol is provider-agnostic. The capability is the contract; providers are implementations."}]},{"id":"blk-14807","kind":"paragraph","spans":[{"id":"spn-13113","text":"Representative providers for "},{"id":"spn-13114","marks":["code"],"text":"&time.forecast"},{"id":"spn-13115","text":" may include:"}]},{"id":"blk-14808","items":[{"blocks":[{"id":"blk-14810","kind":"paragraph","spans":[{"id":"spn-13116","marks":["code"],"text":"ticktickclock"}]}],"id":"blk-14809","kind":"list-item"},{"blocks":[{"id":"blk-14812","kind":"paragraph","spans":[{"id":"spn-13117","text":"Prophet-based forecasting services"}]}],"id":"blk-14811","kind":"list-item"},{"blocks":[{"id":"blk-14814","kind":"paragraph","spans":[{"id":"spn-13118","text":"custom forecasting engines"}]}],"id":"blk-14813","kind":"list-item"},{"blocks":[{"id":"blk-14816","kind":"paragraph","spans":[{"id":"spn-13119","text":"time-series platforms with predictive APIs"}]}],"id":"blk-14815","kind":"list-item"},{"blocks":[{"id":"blk-14818","kind":"paragraph","spans":[{"id":"spn-13120","text":"domain-specific planning and prediction services"}]}],"id":"blk-14817","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14819","kind":"paragraph","spans":[{"id":"spn-13121","text":"A provider should be considered compatible when it can satisfy the capability contract, not merely because it performs some predictive function in marketing language."}]},{"id":"blk-14820","kind":"heading","level":2,"spans":[{"id":"spn-13122","text":"7. Example capability contract"}]},{"id":"blk-14821","kind":"paragraph","spans":[{"id":"spn-13123","text":"A representative contract artifact for "},{"id":"spn-13124","marks":["code"],"text":"&time.forecast"},{"id":"spn-13125","text":":"}]},{"id":"blk-14822","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&time.forecast\",\n  \"provider\": \"ticktickclock\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Temporal forecasting contract for predicting near-term demand, load, and trend-driven state changes.\",\n  \"operations\": {\n    \"predict\": {\n      \"in\": \"time_series\",\n      \"out\": \"forecast_set\",\n      \"description\": \"Generate a forecast over a requested horizon from historical or streaming temporal data.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"explain\": {\n      \"in\": \"forecast_set\",\n      \"out\": \"forecast_explanation\",\n      \"description\": \"Return an explanation of forecast drivers, confidence, and major contributing signals.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"enrich\": {\n      \"in\": \"context\",\n      \"out\": \"enriched_context\",\n      \"description\": \"Attach forecast-derived temporal context to an existing decision or planning payload.\",\n      \"deterministic\": false,\n      \"side_effects\": false\n    },\n    \"learn\": {\n      \"in\": \"observation\",\n      \"out\": \"ack\",\n      \"description\": \"Incorporate realized outcomes for later calibration or model improvement.\",\n      \"deterministic\": false,\n      \"side_effects\": true\n    }\n  },\n  \"accepts_from\": [\n    \"&memory.*\",\n    \"&space.*\",\n    \"raw_data\",\n    \"time_series\",\n    \"context\",\n    \"observation\"\n  ],\n  \"feeds_into\": [\n    \"&reason.*\",\n    \"&space.*\",\n    \"&memory.*\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"temporal-forecasting\",\n    \"demand-prediction\",\n    \"trend-explanation\"\n  ]\n}"},{"id":"blk-14823","kind":"paragraph","spans":[{"id":"spn-13126","text":"This contract matters because it makes forecasting composable in a typed system."}]},{"id":"blk-14824","kind":"heading","level":2,"spans":[{"id":"spn-13127","text":"8. Example provider configuration patterns"}]},{"id":"blk-14825","kind":"paragraph","spans":[{"id":"spn-13128","text":"The protocol does not hardcode one configuration shape, but these fields are common and useful."}]},{"id":"blk-14826","kind":"heading","level":3,"spans":[{"id":"spn-13129","text":"Horizon"}]},{"id":"blk-14827","kind":"paragraph","spans":[{"id":"spn-13130","text":"How far forward to predict."}]},{"id":"blk-14828","kind":"code","language":"json","text":"{\n  \"horizon_hours\": 24\n}"},{"id":"blk-14829","kind":"heading","level":3,"spans":[{"id":"spn-13131","text":"Granularity"}]},{"id":"blk-14830","kind":"paragraph","spans":[{"id":"spn-13132","text":"How coarse or fine the forecast should be."}]},{"id":"blk-14831","kind":"code","language":"json","text":"{\n  \"granularity\": \"hourly\"\n}"},{"id":"blk-14832","kind":"heading","level":3,"spans":[{"id":"spn-13133","text":"Targets"}]},{"id":"blk-14833","kind":"paragraph","spans":[{"id":"spn-13134","text":"Which signals or domains are being forecast."}]},{"id":"blk-14834","kind":"code","language":"json","text":"{\n  \"targets\": [\"regional_demand\", \"support_volume\"]\n}"},{"id":"blk-14835","kind":"heading","level":3,"spans":[{"id":"spn-13135","text":"Confidence threshold"}]},{"id":"blk-14836","kind":"paragraph","spans":[{"id":"spn-13136","text":"Useful when forecast output should trigger escalation or downstream filtering."}]},{"id":"blk-14837","kind":"code","language":"json","text":"{\n  \"min_confidence\": 0.7\n}"},{"id":"blk-14838","kind":"heading","level":3,"spans":[{"id":"spn-13137","text":"Region or segment scope"}]},{"id":"blk-14839","kind":"paragraph","spans":[{"id":"spn-13138","text":"Useful for spatially-aware forecasts."}]},{"id":"blk-14840","kind":"code","language":"json","text":"{\n  \"regions\": [\"us-east\", \"eu-west\"]\n}"},{"id":"blk-14841","kind":"paragraph","spans":[{"id":"spn-13139","text":"These are implementation patterns, not mandatory protocol fields."}]},{"id":"blk-14842","kind":"heading","level":2,"spans":[{"id":"spn-13140","text":"9. Architecture patterns"}]},{"id":"blk-14843","kind":"heading","level":3,"spans":[{"id":"spn-13141","text":"Pattern A: forecast -> reason"}]},{"id":"blk-14844","kind":"paragraph","spans":[{"id":"spn-13142","text":"Use a forecast directly as decision input."}]},{"id":"blk-14845","kind":"code","language":"text","text":"time_series\n|> &time.forecast.predict()\n|> &reason.argument.evaluate()"},{"id":"blk-14846","kind":"paragraph","spans":[{"id":"spn-13143","text":"Use when a forecast can directly support a decision, recommendation, or escalation."}]},{"id":"blk-14847","kind":"heading","level":3,"spans":[{"id":"spn-13144","text":"Pattern B: forecast -> space -> reason"}]},{"id":"blk-14848","kind":"paragraph","spans":[{"id":"spn-13145","text":"Add region or fleet state before deciding."}]},{"id":"blk-14849","kind":"code","language":"text","text":"demand_history\n|> &time.forecast.predict()\n|> &space.fleet.enrich()\n|> &reason.plan.evaluate()"},{"id":"blk-14850","kind":"paragraph","spans":[{"id":"spn-13146","text":"Use when future demand must be interpreted in spatial context."}]},{"id":"blk-14851","kind":"heading","level":3,"spans":[{"id":"spn-13147","text":"Pattern C: memory -> forecast -> reason"}]},{"id":"blk-14852","kind":"paragraph","spans":[{"id":"spn-13148","text":"Use historical memory before or alongside forecasting."}]},{"id":"blk-14853","kind":"code","language":"text","text":"query_context\n|> &memory.graph.recall()\n|> &time.forecast.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-14854","kind":"paragraph","spans":[{"id":"spn-13149","text":"Use when forecast interpretation benefits from prior incidents, structural memory, or analogous cases."}]},{"id":"blk-14855","kind":"heading","level":3,"spans":[{"id":"spn-13150","text":"Pattern D: forecast -> memory.learn"}]},{"id":"blk-14856","kind":"paragraph","spans":[{"id":"spn-13151","text":"Use realized outcomes to improve future behavior."}]},{"id":"blk-14857","kind":"code","language":"text","text":"time_series\n|> &time.forecast.predict()\n|> &reason.argument.evaluate()\n|> &memory.graph.learn()"},{"id":"blk-14858","kind":"paragraph","spans":[{"id":"spn-13152","text":"Use when forecast-driven decisions should become part of durable organizational memory."}]},{"id":"blk-14859","kind":"heading","level":2,"spans":[{"id":"spn-13153","text":"10. Architecture diagram"}]},{"id":"blk-14860","kind":"paragraph","spans":[{"id":"spn-13154","text":"A simple conceptual view of "},{"id":"spn-13155","marks":["code"],"text":"&time.forecast"},{"id":"spn-13156","text":" in composition:"}]},{"id":"blk-14861","kind":"code","language":"text","text":"historical data / stream data\n            |\n            v\n   +----------------------+\n   |   &time.forecast     |\n   |  predict / explain   |\n   +----------------------+\n            |\n            v\n      forecast_set\n            |\n     +------+------+\n     |             |\n     v             v\n&space.*       &reason.*\n enrich         evaluate\n     |             |\n     +------+------+\n            |\n            v\n         output"},{"id":"blk-14862","kind":"paragraph","spans":[{"id":"spn-13157","text":"This is why contract typing matters: downstream capabilities need to know what kind of artifact they are receiving."}]},{"id":"blk-14863","kind":"heading","level":2,"spans":[{"id":"spn-13158","text":"11. Example API shape"}]},{"id":"blk-14864","kind":"paragraph","spans":[{"id":"spn-13159","text":"A provider-specific API will vary, but a forecast provider commonly exposes a shape like:"}]},{"id":"blk-14865","kind":"code","language":"json","text":"{\n  \"operation\": \"predict\",\n  \"input\": {\n    \"series\": [\n      { \"timestamp\": \"2026-03-15T00:00:00Z\", \"value\": 142 },\n      { \"timestamp\": \"2026-03-15T01:00:00Z\", \"value\": 155 }\n    ],\n    \"horizon_hours\": 24,\n    \"granularity\": \"hourly\"\n  }\n}"},{"id":"blk-14866","kind":"paragraph","spans":[{"id":"spn-13160","text":"Representative response:"}]},{"id":"blk-14867","kind":"code","language":"json","text":"{\n  \"forecast\": [\n    { \"timestamp\": \"2026-03-16T00:00:00Z\", \"value\": 181, \"confidence\": 0.83 },\n    { \"timestamp\": \"2026-03-16T01:00:00Z\", \"value\": 187, \"confidence\": 0.81 }\n  ],\n  \"summary\": \"Demand is likely to increase overnight with moderate confidence.\"\n}"},{"id":"blk-14868","kind":"paragraph","spans":[{"id":"spn-13161","text":"The protocol does not require this exact transport shape. It requires that the provider satisfy the declared capability contract."}]},{"id":"blk-14869","kind":"heading","level":2,"spans":[{"id":"spn-13162","text":"12. Governance implications"}]},{"id":"blk-14870","kind":"paragraph","spans":[{"id":"spn-13163","text":"Forecasts are often used to justify action before a situation fully materializes. That makes governance important."}]},{"id":"blk-14871","kind":"paragraph","spans":[{"id":"spn-13164","text":"Common governance examples for forecast-driven systems:"}]},{"id":"blk-14872","kind":"heading","level":3,"spans":[{"id":"spn-13165","text":"Hard constraints"}]},{"id":"blk-14873","items":[{"blocks":[{"id":"blk-14875","kind":"paragraph","spans":[{"id":"spn-13166","text":"never trigger irreversible action from a forecast alone"}]}],"id":"blk-14874","kind":"list-item"},{"blocks":[{"id":"blk-14877","kind":"paragraph","spans":[{"id":"spn-13167","text":"never exceed regional scale limits without human approval"}]}],"id":"blk-14876","kind":"list-item"},{"blocks":[{"id":"blk-14879","kind":"paragraph","spans":[{"id":"spn-13168","text":"never suppress audit logging for forecast-driven decisions"}]}],"id":"blk-14878","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14880","kind":"heading","level":3,"spans":[{"id":"spn-13169","text":"Soft constraints"}]},{"id":"blk-14881","items":[{"blocks":[{"id":"blk-14883","kind":"paragraph","spans":[{"id":"spn-13170","text":"prefer gradual changes over aggressive one-step responses"}]}],"id":"blk-14882","kind":"list-item"},{"blocks":[{"id":"blk-14885","kind":"paragraph","spans":[{"id":"spn-13171","text":"prefer conservative capacity increases when forecast confidence is moderate"}]}],"id":"blk-14884","kind":"list-item"},{"blocks":[{"id":"blk-14887","kind":"paragraph","spans":[{"id":"spn-13172","text":"prefer recent calibrated models over stale forecasting baselines"}]}],"id":"blk-14886","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14888","kind":"heading","level":3,"spans":[{"id":"spn-13173","text":"Escalation rules"}]},{"id":"blk-14889","kind":"paragraph","spans":[{"id":"spn-13174","text":"Forecast-heavy systems often combine well with:"}]},{"id":"blk-14890","kind":"code","language":"json","text":"{\n  \"escalate_when\": {\n    \"confidence_below\": 0.7,\n    \"cost_exceeds_usd\": 1000,\n    \"hard_boundary_approached\": true\n  }\n}"},{"id":"blk-14891","kind":"paragraph","spans":[{"id":"spn-13175","text":"This is one reason "},{"id":"spn-13176","marks":["code"],"text":"&time.forecast"},{"id":"spn-13177","text":" often composes closely with "},{"id":"spn-13178","marks":["code"],"text":"&reason.argument"},{"id":"spn-13179","text":" or "},{"id":"spn-13180","marks":["code"],"text":"&reason.plan"},{"id":"spn-13181","text":"."}]},{"id":"blk-14892","kind":"heading","level":2,"spans":[{"id":"spn-13182","text":"13. Provenance implications"}]},{"id":"blk-14893","kind":"paragraph","spans":[{"id":"spn-13183","text":"Forecasts can strongly influence planning, cost, and operational risk, so provenance should be explicit."}]},{"id":"blk-14894","kind":"paragraph","spans":[{"id":"spn-13184","text":"A provenance record for a forecasting step may include:"}]},{"id":"blk-14895","kind":"code","language":"json","text":"{\n  \"source\": \"&time.forecast\",\n  \"provider\": \"ticktickclock\",\n  \"operation\": \"predict\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"input_hash\": \"sha256:abcd1234...\",\n  \"output_hash\": \"sha256:efgh5678...\",\n  \"parent_hash\": \"sha256:0000...\",\n  \"mcp_trace_id\": \"ttc-forecast-42\"\n}"},{"id":"blk-14896","kind":"paragraph","spans":[{"id":"spn-13185","text":"This helps answer questions like:"}]},{"id":"blk-14897","items":[{"blocks":[{"id":"blk-14899","kind":"paragraph","spans":[{"id":"spn-13186","text":"Why did the system scale this region?"}]}],"id":"blk-14898","kind":"list-item"},{"blocks":[{"id":"blk-14901","kind":"paragraph","spans":[{"id":"spn-13187","text":"Which forecast provider influenced the decision?"}]}],"id":"blk-14900","kind":"list-item"},{"blocks":[{"id":"blk-14903","kind":"paragraph","spans":[{"id":"spn-13188","text":"What horizon and confidence profile informed the action?"}]}],"id":"blk-14902","kind":"list-item"},{"blocks":[{"id":"blk-14905","kind":"paragraph","spans":[{"id":"spn-13189","text":"Which upstream context produced this prediction?"}]}],"id":"blk-14904","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14906","kind":"paragraph","spans":[{"id":"spn-13190","text":"Forecasts without provenance are difficult to audit and easy to over-trust."}]},{"id":"blk-14907","kind":"heading","level":2,"spans":[{"id":"spn-13191","text":"14. A2A implications"}]},{"id":"blk-14908","kind":"paragraph","spans":[{"id":"spn-13192","text":"A forecast capability may map naturally to A2A-advertised skills such as:"}]},{"id":"blk-14909","items":[{"blocks":[{"id":"blk-14911","kind":"paragraph","spans":[{"id":"spn-13193","marks":["code"],"text":"temporal-forecasting"}]}],"id":"blk-14910","kind":"list-item"},{"blocks":[{"id":"blk-14913","kind":"paragraph","spans":[{"id":"spn-13194","marks":["code"],"text":"demand-prediction"}]}],"id":"blk-14912","kind":"list-item"},{"blocks":[{"id":"blk-14915","kind":"paragraph","spans":[{"id":"spn-13195","marks":["code"],"text":"trend-explanation"}]}],"id":"blk-14914","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14916","kind":"paragraph","spans":[{"id":"spn-13196","text":"That means an agent card generated from an "},{"id":"spn-13197","marks":["code"],"text":"ampersand.json"},{"id":"spn-13198","text":" declaration can advertise forecasting as a reusable, discoverable coordination-facing skill."}]},{"id":"blk-14917","kind":"paragraph","spans":[{"id":"spn-13199","text":"This is one example of how the [&] Protocol complements A2A rather than replacing it."}]},{"id":"blk-14918","kind":"heading","level":2,"spans":[{"id":"spn-13200","text":"15. MCP implications"}]},{"id":"blk-14919","kind":"paragraph","spans":[{"id":"spn-13201","text":"A forecast provider may also compile into MCP-facing configuration if the implementation exposes a tool or service endpoint."}]},{"id":"blk-14920","kind":"paragraph","spans":[{"id":"spn-13202","text":"For example, a declaration containing "},{"id":"spn-13203","marks":["code"],"text":"&time.forecast"},{"id":"spn-13204","text":" may generate MCP configuration that wires in a forecasting provider alongside memory and reasoning providers."}]},{"id":"blk-14921","kind":"paragraph","spans":[{"id":"spn-13205","text":"This is one example of how the [&] Protocol complements MCP rather than replacing it."}]},{"id":"blk-14922","kind":"heading","level":2,"spans":[{"id":"spn-13206","text":"16. Research references and grounding"}]},{"id":"blk-14923","kind":"paragraph","spans":[{"id":"spn-13207","text":"The design of "},{"id":"spn-13208","marks":["code"],"text":"&time.forecast"},{"id":"spn-13209","text":" is informed by overlapping areas of work:"}]},{"id":"blk-14924","items":[{"blocks":[{"id":"blk-14926","kind":"paragraph","spans":[{"id":"spn-13210","text":"time-series forecasting"}]}],"id":"blk-14925","kind":"list-item"},{"blocks":[{"id":"blk-14928","kind":"paragraph","spans":[{"id":"spn-13211","text":"predictive analytics"}]}],"id":"blk-14927","kind":"list-item"},{"blocks":[{"id":"blk-14930","kind":"paragraph","spans":[{"id":"spn-13212","text":"trend analysis"}]}],"id":"blk-14929","kind":"list-item"},{"blocks":[{"id":"blk-14932","kind":"paragraph","spans":[{"id":"spn-13213","text":"operational forecasting"}]}],"id":"blk-14931","kind":"list-item"},{"blocks":[{"id":"blk-14934","kind":"paragraph","spans":[{"id":"spn-13214","text":"demand planning"}]}],"id":"blk-14933","kind":"list-item"},{"blocks":[{"id":"blk-14936","kind":"paragraph","spans":[{"id":"spn-13215","text":"sequence-aware decision systems"}]}],"id":"blk-14935","kind":"list-item"},{"blocks":[{"id":"blk-14938","kind":"paragraph","spans":[{"id":"spn-13216","text":"temporal context in agent and planning architectures"}]}],"id":"blk-14937","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14939","kind":"paragraph","spans":[{"id":"spn-13217","text":"The important protocol-level insight is not that forecasting is new. It is that "},{"id":"spn-13218","marks":["bold"],"text":"forecasting should be represented explicitly as a composable capability"},{"id":"spn-13219","text":" rather than hidden in framework logic."}]},{"id":"blk-14940","kind":"paragraph","spans":[{"id":"spn-13220","text":"That shift enables:"}]},{"id":"blk-14941","items":[{"blocks":[{"id":"blk-14943","kind":"paragraph","spans":[{"id":"spn-13221","text":"schema validation"}]}],"id":"blk-14942","kind":"list-item"},{"blocks":[{"id":"blk-14945","kind":"paragraph","spans":[{"id":"spn-13222","text":"typed pipelines"}]}],"id":"blk-14944","kind":"list-item"},{"blocks":[{"id":"blk-14947","kind":"paragraph","spans":[{"id":"spn-13223","text":"provider interchangeability"}]}],"id":"blk-14946","kind":"list-item"},{"blocks":[{"id":"blk-14949","kind":"paragraph","spans":[{"id":"spn-13224","text":"governance-aware decisions"}]}],"id":"blk-14948","kind":"list-item"},{"blocks":[{"id":"blk-14951","kind":"paragraph","spans":[{"id":"spn-13225","text":"provenance-preserving execution"}]}],"id":"blk-14950","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14952","kind":"heading","level":2,"spans":[{"id":"spn-13226","text":"17. Anti-patterns"}]},{"id":"blk-14953","kind":"heading","level":3,"spans":[{"id":"spn-13227","text":"Anti-pattern 1: treat forecasting as generic analytics"}]},{"id":"blk-14954","kind":"paragraph","spans":[{"id":"spn-13228","text":"If forecasting is bundled into a broad \"analytics\" block, its contract and pipeline role become unclear."}]},{"id":"blk-14955","kind":"heading","level":3,"spans":[{"id":"spn-13229","text":"Anti-pattern 2: treat forecast output as self-justifying"}]},{"id":"blk-14956","kind":"paragraph","spans":[{"id":"spn-13230","text":"A forecast is often strong evidence, but not always enough for unsupervised action."}]},{"id":"blk-14957","kind":"heading","level":3,"spans":[{"id":"spn-13231","text":"Anti-pattern 3: conflate anomaly detection and forecasting"}]},{"id":"blk-14958","kind":"paragraph","spans":[{"id":"spn-13232","text":"They are related temporal capabilities, but they are not the same interface."}]},{"id":"blk-14959","kind":"heading","level":3,"spans":[{"id":"spn-13233","text":"Anti-pattern 4: hardwire the protocol to one provider"}]},{"id":"blk-14960","kind":"paragraph","spans":[{"id":"spn-13234","marks":["code"],"text":"&time.forecast"},{"id":"spn-13235","text":" should remain a portable capability contract."}]},{"id":"blk-14961","kind":"heading","level":2,"spans":[{"id":"spn-13236","text":"18. Good default guidance"}]},{"id":"blk-14962","kind":"paragraph","spans":[{"id":"spn-13237","text":"Use "},{"id":"spn-13238","marks":["code"],"text":"&time.forecast"},{"id":"spn-13239","text":" when:"}]},{"id":"blk-14963","items":[{"blocks":[{"id":"blk-14965","kind":"paragraph","spans":[{"id":"spn-13240","text":"the system needs future-oriented temporal estimates"}]}],"id":"blk-14964","kind":"list-item"},{"blocks":[{"id":"blk-14967","kind":"paragraph","spans":[{"id":"spn-13241","text":"a planner or reasoner must act on projected state"}]}],"id":"blk-14966","kind":"list-item"},{"blocks":[{"id":"blk-14969","kind":"paragraph","spans":[{"id":"spn-13242","text":"demand, load, or trend pressure matters operationally"}]}],"id":"blk-14968","kind":"list-item"},{"blocks":[{"id":"blk-14971","kind":"paragraph","spans":[{"id":"spn-13243","text":"a declaration should express predictive temporal intelligence explicitly"}]}],"id":"blk-14970","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14972","kind":"paragraph","spans":[{"id":"spn-13244","text":"Prefer composing it with:"}]},{"id":"blk-14973","items":[{"blocks":[{"id":"blk-14975","kind":"paragraph","spans":[{"id":"spn-13245","marks":["code"],"text":"&space.*"},{"id":"spn-13246","text":" when geography or regional state matters"}]}],"id":"blk-14974","kind":"list-item"},{"blocks":[{"id":"blk-14977","kind":"paragraph","spans":[{"id":"spn-13247","marks":["code"],"text":"&memory.*"},{"id":"spn-13248","text":" when historical structure improves interpretation"}]}],"id":"blk-14976","kind":"list-item"},{"blocks":[{"id":"blk-14979","kind":"paragraph","spans":[{"id":"spn-13249","marks":["code"],"text":"&reason.*"},{"id":"spn-13250","text":" when predictions influence action selection"}]}],"id":"blk-14978","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14980","kind":"heading","level":2,"spans":[{"id":"spn-13251","text":"19. Summary"}]},{"id":"blk-14981","kind":"paragraph","spans":[{"id":"spn-13252","marks":["code"],"text":"time.forecast"},{"id":"spn-13253","text":" is the [&] Protocol capability for forecasting future temporal state."}]},{"id":"blk-14982","kind":"paragraph","spans":[{"id":"spn-13254","text":"It exists to make predictive temporal intelligence:"}]},{"id":"blk-14983","items":[{"blocks":[{"id":"blk-14985","kind":"paragraph","spans":[{"id":"spn-13255","text":"explicit"}]}],"id":"blk-14984","kind":"list-item"},{"blocks":[{"id":"blk-14987","kind":"paragraph","spans":[{"id":"spn-13256","text":"composable"}]}],"id":"blk-14986","kind":"list-item"},{"blocks":[{"id":"blk-14989","kind":"paragraph","spans":[{"id":"spn-13257","text":"contract-aware"}]}],"id":"blk-14988","kind":"list-item"},{"blocks":[{"id":"blk-14991","kind":"paragraph","spans":[{"id":"spn-13258","text":"provider-agnostic"}]}],"id":"blk-14990","kind":"list-item"},{"blocks":[{"id":"blk-14993","kind":"paragraph","spans":[{"id":"spn-13259","text":"governable"}]}],"id":"blk-14992","kind":"list-item"},{"blocks":[{"id":"blk-14995","kind":"paragraph","spans":[{"id":"spn-13260","text":"provenance-friendly"}]}],"id":"blk-14994","kind":"list-item"},{"blocks":[{"id":"blk-14997","kind":"paragraph","spans":[{"id":"spn-13261","text":"generatable into MCP and A2A surfaces"}]}],"id":"blk-14996","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-14998","kind":"paragraph","spans":[{"id":"spn-13262","text":"In short:"}]},{"blocks":[{"id":"blk-15000","kind":"paragraph","spans":[{"id":"spn-13263","marks":["code"],"text":"&time.forecast"},{"id":"spn-13264","text":" gives an agent a standard way to declare that it can project likely future state and use that projection safely within a composed cognitive system."}]}],"id":"blk-14999","kind":"quote"}],"edges":[],"id":"bagaaierajeezz4qk3jwc3bqnsmtdyilex6dm5bumkw3wyd6f3atbq5b2uzyq","vocabulary":"ampersand.docs.fs.v1"}