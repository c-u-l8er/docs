{"bendscript":"0.1","blocks":[{"id":"blk-8508","kind":"heading","level":1,"spans":[{"id":"spn-8266","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8267","text":" — Human-in-the-Loop Escalation and Governance Handoff"}]},{"id":"blk-8509","kind":"paragraph","spans":[{"id":"spn-8268","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8269","text":" is the [&] Protocol capability for "},{"id":"spn-8270","marks":["bold"],"text":"governance-mandated escalation"},{"id":"spn-8271","text":"."}]},{"id":"blk-8510","kind":"paragraph","spans":[{"id":"spn-8272","text":"It describes an agent's ability to:"}]},{"id":"blk-8511","items":[{"blocks":[{"id":"blk-8513","kind":"paragraph","spans":[{"id":"spn-8273","text":"detect when a decision exceeds its authorized autonomy"}]}],"id":"blk-8512","kind":"list-item"},{"blocks":[{"id":"blk-8515","kind":"paragraph","spans":[{"id":"spn-8274","text":"surface that decision to a human operator or governance layer"}]}],"id":"blk-8514","kind":"list-item"},{"blocks":[{"id":"blk-8517","kind":"paragraph","spans":[{"id":"spn-8275","text":"pause execution until a response is received or timeout expires"}]}],"id":"blk-8516","kind":"list-item"},{"blocks":[{"id":"blk-8519","kind":"paragraph","spans":[{"id":"spn-8276","text":"resume with an approved, rejected, or modified action"}]}],"id":"blk-8518","kind":"list-item"},{"blocks":[{"id":"blk-8521","kind":"paragraph","spans":[{"id":"spn-8277","text":"maintain a queryable history of all escalation events"}]}],"id":"blk-8520","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8522","kind":"paragraph","spans":[{"id":"spn-8278","text":"In the protocol's five-primitive model:"}]},{"id":"blk-8523","items":[{"blocks":[{"id":"blk-8525","kind":"paragraph","spans":[{"id":"spn-8279","marks":["code"],"text":"&memory"},{"id":"spn-8280","text":" answers "},{"id":"spn-8281","marks":["bold"],"text":"what"},{"id":"spn-8282","text":" the agent knows"}]}],"id":"blk-8524","kind":"list-item"},{"blocks":[{"id":"blk-8527","kind":"paragraph","spans":[{"id":"spn-8283","marks":["code"],"text":"&reason"},{"id":"spn-8284","text":" answers "},{"id":"spn-8285","marks":["bold"],"text":"how"},{"id":"spn-8286","text":" the agent decides"}]}],"id":"blk-8526","kind":"list-item"},{"blocks":[{"id":"blk-8529","kind":"paragraph","spans":[{"id":"spn-8287","marks":["code"],"text":"&time"},{"id":"spn-8288","text":" answers "},{"id":"spn-8289","marks":["bold"],"text":"when"},{"id":"spn-8290","text":" things change"}]}],"id":"blk-8528","kind":"list-item"},{"blocks":[{"id":"blk-8531","kind":"paragraph","spans":[{"id":"spn-8291","marks":["code"],"text":"&space"},{"id":"spn-8292","text":" answers "},{"id":"spn-8293","marks":["bold"],"text":"where"},{"id":"spn-8294","text":" things are"}]}],"id":"blk-8530","kind":"list-item"},{"blocks":[{"id":"blk-8533","kind":"paragraph","spans":[{"id":"spn-8295","marks":["code"],"text":"&govern"},{"id":"spn-8296","text":" answers "},{"id":"spn-8297","marks":["bold"],"text":"who approves, what limits apply, and how decisions are audited"}]}],"id":"blk-8532","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8534","kind":"paragraph","spans":[{"id":"spn-8298","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8299","text":" is the subtype that handles the critical handoff between autonomous agent action and human oversight."}]},{"id":"blk-8535","kind":"heading","level":2,"spans":[{"id":"spn-8300","text":"1. Definition"}]},{"id":"blk-8536","kind":"paragraph","spans":[{"id":"spn-8301","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8302","text":" is the capability interface for "},{"id":"spn-8303","marks":["bold"],"text":"human-in-the-loop decision escalation"},{"id":"spn-8304","text":"."}]},{"id":"blk-8537","kind":"paragraph","spans":[{"id":"spn-8305","text":"It is used when an agent must:"}]},{"id":"blk-8538","items":[{"blocks":[{"id":"blk-8540","kind":"paragraph","spans":[{"id":"spn-8306","text":"pause before executing an action that crosses a governance threshold"}]}],"id":"blk-8539","kind":"list-item"},{"blocks":[{"id":"blk-8542","kind":"paragraph","spans":[{"id":"spn-8307","text":"present a proposed action with rationale to a human reviewer"}]}],"id":"blk-8541","kind":"list-item"},{"blocks":[{"id":"blk-8544","kind":"paragraph","spans":[{"id":"spn-8308","text":"wait for approval, rejection, or modification"}]}],"id":"blk-8543","kind":"list-item"},{"blocks":[{"id":"blk-8546","kind":"paragraph","spans":[{"id":"spn-8309","text":"handle timeout behavior according to autonomy level"}]}],"id":"blk-8545","kind":"list-item"},{"blocks":[{"id":"blk-8548","kind":"paragraph","spans":[{"id":"spn-8310","text":"record the full escalation lifecycle for audit"}]}],"id":"blk-8547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8549","kind":"paragraph","spans":[{"id":"spn-8311","text":"Escalation is NOT failure. It is a governance-mandated handoff when agent confidence or cost crosses thresholds defined by policy."}]},{"id":"blk-8550","kind":"paragraph","spans":[{"id":"spn-8312","text":"This distinction matters because agents that treat escalation as error will:"}]},{"id":"blk-8551","items":[{"blocks":[{"id":"blk-8553","kind":"paragraph","spans":[{"id":"spn-8313","text":"suppress legitimate governance signals"}]}],"id":"blk-8552","kind":"list-item"},{"blocks":[{"id":"blk-8555","kind":"paragraph","spans":[{"id":"spn-8314","text":"avoid surfacing uncertainty"}]}],"id":"blk-8554","kind":"list-item"},{"blocks":[{"id":"blk-8557","kind":"paragraph","spans":[{"id":"spn-8315","text":"degrade trust over time"}]}],"id":"blk-8556","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8558","kind":"paragraph","spans":[{"id":"spn-8316","text":"The protocol treats escalation as a first-class capability, not an exception path."}]},{"id":"blk-8559","kind":"heading","level":2,"spans":[{"id":"spn-8317","text":"2. Why this capability exists"}]},{"id":"blk-8560","kind":"paragraph","spans":[{"id":"spn-8318","text":"Many agent systems either operate fully autonomously or halt completely when uncertainty arises."}]},{"id":"blk-8561","kind":"paragraph","spans":[{"id":"spn-8319","text":"Neither extreme is acceptable in production governance:"}]},{"id":"blk-8562","items":[{"blocks":[{"id":"blk-8564","kind":"paragraph","spans":[{"id":"spn-8320","text":"A logistics agent proposes a high-cost reallocation but has no mechanism to ask a human before committing."}]}],"id":"blk-8563","kind":"list-item"},{"blocks":[{"id":"blk-8566","kind":"paragraph","spans":[{"id":"spn-8321","text":"An infrastructure agent detects a hard boundary violation but silently logs it instead of requesting approval."}]}],"id":"blk-8565","kind":"list-item"},{"blocks":[{"id":"blk-8568","kind":"paragraph","spans":[{"id":"spn-8322","text":"A support agent encounters a policy-sensitive case but lacks a structured way to surface it to a supervisor."}]}],"id":"blk-8567","kind":"list-item"},{"blocks":[{"id":"blk-8570","kind":"paragraph","spans":[{"id":"spn-8323","text":"A planning agent operates below its confidence threshold but proceeds anyway because no escalation path exists."}]}],"id":"blk-8569","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8571","kind":"paragraph","spans":[{"id":"spn-8324","text":"In all of these cases, the missing layer is "},{"id":"spn-8325","marks":["bold"],"text":"structured escalation with defined trigger conditions, timeout behavior, and response semantics"},{"id":"spn-8326","text":"."}]},{"id":"blk-8572","kind":"paragraph","spans":[{"id":"spn-8327","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8328","text":" gives the protocol a standard way to declare that capability."}]},{"id":"blk-8573","kind":"heading","level":2,"spans":[{"id":"spn-8329","text":"3. What problems "},{"id":"spn-8330","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8331","text":" solves"}]},{"id":"blk-8574","kind":"paragraph","spans":[{"id":"spn-8332","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8333","text":" is useful when an agent needs to answer questions like:"}]},{"id":"blk-8575","items":[{"blocks":[{"id":"blk-8577","kind":"paragraph","spans":[{"id":"spn-8334","text":"Should I proceed with this action given my current confidence level?"}]}],"id":"blk-8576","kind":"list-item"},{"blocks":[{"id":"blk-8579","kind":"paragraph","spans":[{"id":"spn-8335","text":"Does this action exceed the cost threshold defined by Delegatic policy?"}]}],"id":"blk-8578","kind":"list-item"},{"blocks":[{"id":"blk-8581","kind":"paragraph","spans":[{"id":"spn-8336","text":"Am I approaching a hard boundary that requires human sign-off?"}]}],"id":"blk-8580","kind":"list-item"},{"blocks":[{"id":"blk-8583","kind":"paragraph","spans":[{"id":"spn-8337","text":"Does the current autonomy level (observe, advise, act) permit this operation?"}]}],"id":"blk-8582","kind":"list-item"},{"blocks":[{"id":"blk-8585","kind":"paragraph","spans":[{"id":"spn-8338","text":"What should happen if no human responds within the timeout window?"}]}],"id":"blk-8584","kind":"list-item"},{"blocks":[{"id":"blk-8587","kind":"paragraph","spans":[{"id":"spn-8339","text":"How do I resume execution after receiving approval or modification?"}]}],"id":"blk-8586","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8588","kind":"paragraph","spans":[{"id":"spn-8340","text":"Without this capability, escalation logic tends to get buried inside:"}]},{"id":"blk-8589","items":[{"blocks":[{"id":"blk-8591","kind":"paragraph","spans":[{"id":"spn-8341","text":"ad-hoc if/else blocks in application code"}]}],"id":"blk-8590","kind":"list-item"},{"blocks":[{"id":"blk-8593","kind":"paragraph","spans":[{"id":"spn-8342","text":"implicit confidence thresholds with no auditability"}]}],"id":"blk-8592","kind":"list-item"},{"blocks":[{"id":"blk-8595","kind":"paragraph","spans":[{"id":"spn-8343","text":"custom notification systems with no structured response path"}]}],"id":"blk-8594","kind":"list-item"},{"blocks":[{"id":"blk-8597","kind":"paragraph","spans":[{"id":"spn-8344","text":"provider-specific approval workflows with no interoperability"}]}],"id":"blk-8596","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8598","kind":"paragraph","spans":[{"id":"spn-8345","text":"The protocol makes it explicit instead."}]},{"id":"blk-8599","kind":"heading","level":2,"spans":[{"id":"spn-8346","text":"4. Capability role in the "},{"id":"spn-8347","marks":["code"],"text":"&govern"},{"id":"spn-8348","text":" namespace"}]},{"id":"blk-8600","kind":"paragraph","spans":[{"id":"spn-8349","text":"The "},{"id":"spn-8350","marks":["code"],"text":"&govern"},{"id":"spn-8351","text":" primitive supports multiple subtypes, including:"}]},{"id":"blk-8601","items":[{"blocks":[{"id":"blk-8603","kind":"paragraph","spans":[{"id":"spn-8352","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-8602","kind":"list-item"},{"blocks":[{"id":"blk-8605","kind":"paragraph","spans":[{"id":"spn-8353","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-8604","kind":"list-item"},{"blocks":[{"id":"blk-8607","kind":"paragraph","spans":[{"id":"spn-8354","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-8606","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8608","kind":"paragraph","spans":[{"id":"spn-8355","text":"A helpful distinction is:"}]},{"id":"blk-8609","items":[{"blocks":[{"id":"blk-8611","kind":"paragraph","spans":[{"id":"spn-8356","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8357","text":" = decision handoff when thresholds are crossed"}]}],"id":"blk-8610","kind":"list-item"},{"blocks":[{"id":"blk-8613","kind":"paragraph","spans":[{"id":"spn-8358","marks":["code"],"text":"&govern.identity"},{"id":"spn-8359","text":" = agent authentication and trust verification"}]}],"id":"blk-8612","kind":"list-item"},{"blocks":[{"id":"blk-8615","kind":"paragraph","spans":[{"id":"spn-8360","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-8361","text":" = observability, cost tracking, and budget enforcement"}]}],"id":"blk-8614","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8616","kind":"paragraph","spans":[{"id":"spn-8362","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8363","text":" is the right subtype when the main problem is "},{"id":"spn-8364","marks":["bold"],"text":"controlling what happens at the boundary between autonomous action and human oversight"},{"id":"spn-8365","text":"."}]},{"id":"blk-8617","kind":"heading","level":2,"spans":[{"id":"spn-8366","text":"5. Typical use cases"}]},{"id":"blk-8618","kind":"heading","level":3,"spans":[{"id":"spn-8367","text":"Confidence-based escalation"}]},{"id":"blk-8619","kind":"paragraph","spans":[{"id":"spn-8368","text":"Agent confidence drops below the configured threshold during reasoning. The proposed action is surfaced for human review before execution."}]},{"id":"blk-8620","kind":"heading","level":3,"spans":[{"id":"spn-8369","text":"Cost-based escalation"}]},{"id":"blk-8621","kind":"paragraph","spans":[{"id":"spn-8370","text":"A planned action would exceed the per-task or per-period cost budget defined in Delegatic policy. The agent requests approval before committing resources."}]},{"id":"blk-8622","kind":"heading","level":3,"spans":[{"id":"spn-8371","text":"Hard boundary escalation"}]},{"id":"blk-8623","kind":"paragraph","spans":[{"id":"spn-8372","text":"The agent approaches a governance hard constraint (e.g., \"never deploy to production without approval\"). The boundary rule triggers mandatory human review."}]},{"id":"blk-8624","kind":"heading","level":3,"spans":[{"id":"spn-8373","text":"Policy-required approval"}]},{"id":"blk-8625","kind":"paragraph","spans":[{"id":"spn-8374","text":"The autonomy level or org policy requires human sign-off for certain capability operations regardless of confidence or cost."}]},{"id":"blk-8626","kind":"heading","level":3,"spans":[{"id":"spn-8375","text":"Cross-agent escalation"}]},{"id":"blk-8627","kind":"paragraph","spans":[{"id":"spn-8376","text":"In multi-agent workflows, one agent escalates to another agent's human operator when a collaborative decision crosses governance boundaries."}]},{"id":"blk-8628","kind":"heading","level":3,"spans":[{"id":"spn-8377","text":"Audit-driven escalation"}]},{"id":"blk-8629","kind":"paragraph","spans":[{"id":"spn-8378","text":"Retrospective analysis of telemetry reveals that an action should have been escalated. The system flags it for review and updates escalation policy."}]},{"id":"blk-8630","kind":"heading","level":2,"spans":[{"id":"spn-8379","text":"6. Example capability contract"}]},{"id":"blk-8631","kind":"paragraph","spans":[{"id":"spn-8380","text":"The authoritative contract is at "},{"id":"spn-8381","marks":["code"],"text":"contracts/v0.1.0/govern.escalation.contract.json"},{"id":"spn-8382","text":"."}]},{"id":"blk-8632","kind":"paragraph","spans":[{"id":"spn-8383","text":"A representative summary:"}]},{"id":"blk-8633","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&govern.escalation\",\n  \"provider\": \"opensentience\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Human-in-the-loop escalation contract for governance-mandated decision handoff.\",\n  \"operations\": {\n    \"escalate\": {\n      \"in\": \"escalation_request\",\n      \"out\": \"escalation_ack\",\n      \"description\": \"Submit an action for human review. Agent pauses until response or timeout.\"\n    },\n    \"respond\": {\n      \"in\": \"escalation_response\",\n      \"out\": \"resolution\",\n      \"description\": \"Human operator approves, rejects, or modifies the escalated action.\"\n    },\n    \"query\": {\n      \"in\": \"escalation_query\",\n      \"out\": \"escalation_history\",\n      \"description\": \"Query pending, resolved, or expired escalations by agent, org, goal, or time range.\"\n    }\n  },\n  \"accepts_from\": [\n    \"&reason.*\",\n    \"&govern.telemetry\",\n    \"escalation_request\",\n    \"escalation_response\"\n  ],\n  \"feeds_into\": [\n    \"&reason.*\",\n    \"&govern.telemetry\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"human-escalation-bridge\",\n    \"approval-workflow\"\n  ]\n}"},{"id":"blk-8634","kind":"heading","level":3,"spans":[{"id":"spn-8384","text":"What this contract means"}]},{"id":"blk-8635","kind":"paragraph","spans":[{"id":"spn-8385","text":"This contract says that "},{"id":"spn-8386","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8387","text":" can:"}]},{"id":"blk-8636","items":[{"blocks":[{"id":"blk-8638","kind":"paragraph","spans":[{"id":"spn-8388","text":"accept escalation requests from reasoning capabilities or telemetry triggers"}]}],"id":"blk-8637","kind":"list-item"},{"blocks":[{"id":"blk-8640","kind":"paragraph","spans":[{"id":"spn-8389","text":"present them to a human operator via the escalation bridge"}]}],"id":"blk-8639","kind":"list-item"},{"blocks":[{"id":"blk-8642","kind":"paragraph","spans":[{"id":"spn-8390","text":"return structured resolutions (approve, reject, modify)"}]}],"id":"blk-8641","kind":"list-item"},{"blocks":[{"id":"blk-8644","kind":"paragraph","spans":[{"id":"spn-8391","text":"feed resolution outcomes back into reasoning and telemetry"}]}],"id":"blk-8643","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8645","kind":"paragraph","spans":[{"id":"spn-8392","text":"It also says that this capability composes well with:"}]},{"id":"blk-8646","items":[{"blocks":[{"id":"blk-8648","kind":"paragraph","spans":[{"id":"spn-8393","marks":["code"],"text":"&reason.*"},{"id":"spn-8394","text":" upstream, where reasoning produces actions that may require approval"}]}],"id":"blk-8647","kind":"list-item"},{"blocks":[{"id":"blk-8650","kind":"paragraph","spans":[{"id":"spn-8395","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-8396","text":" upstream, where cost or usage signals trigger escalation"}]}],"id":"blk-8649","kind":"list-item"},{"blocks":[{"id":"blk-8652","kind":"paragraph","spans":[{"id":"spn-8397","marks":["code"],"text":"&reason.*"},{"id":"spn-8398","text":" downstream, where approved or modified actions resume execution"}]}],"id":"blk-8651","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8653","kind":"heading","level":2,"spans":[{"id":"spn-8399","text":"7. Core operations"}]},{"id":"blk-8654","kind":"heading","level":3,"spans":[{"id":"spn-8400","marks":["code"],"text":"escalate"}]},{"id":"blk-8655","kind":"paragraph","spans":[{"id":"spn-8401","text":"Purpose:"}]},{"id":"blk-8656","items":[{"blocks":[{"id":"blk-8658","kind":"paragraph","spans":[{"id":"spn-8402","text":"submit a proposed action for human review"}]}],"id":"blk-8657","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8659","kind":"paragraph","spans":[{"id":"spn-8403","text":"Typical input:"}]},{"id":"blk-8660","items":[{"blocks":[{"id":"blk-8662","kind":"paragraph","spans":[{"id":"spn-8404","marks":["code"],"text":"escalation_request"}]}],"id":"blk-8661","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8663","kind":"paragraph","spans":[{"id":"spn-8405","text":"Typical output:"}]},{"id":"blk-8664","items":[{"blocks":[{"id":"blk-8666","kind":"paragraph","spans":[{"id":"spn-8406","marks":["code"],"text":"escalation_ack"}]}],"id":"blk-8665","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8667","kind":"paragraph","spans":[{"id":"spn-8407","text":"Use when:"}]},{"id":"blk-8668","items":[{"blocks":[{"id":"blk-8670","kind":"paragraph","spans":[{"id":"spn-8408","text":"the agent's confidence is below the configured threshold"}]}],"id":"blk-8669","kind":"list-item"},{"blocks":[{"id":"blk-8672","kind":"paragraph","spans":[{"id":"spn-8409","text":"the estimated cost exceeds Delegatic policy limits"}]}],"id":"blk-8671","kind":"list-item"},{"blocks":[{"id":"blk-8674","kind":"paragraph","spans":[{"id":"spn-8410","text":"a hard boundary constraint is approaching"}]}],"id":"blk-8673","kind":"list-item"},{"blocks":[{"id":"blk-8676","kind":"paragraph","spans":[{"id":"spn-8411","text":"the autonomy level requires approval for this operation type"}]}],"id":"blk-8675","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8677","kind":"heading","level":3,"spans":[{"id":"spn-8412","marks":["code"],"text":"respond"}]},{"id":"blk-8678","kind":"paragraph","spans":[{"id":"spn-8413","text":"Purpose:"}]},{"id":"blk-8679","items":[{"blocks":[{"id":"blk-8681","kind":"paragraph","spans":[{"id":"spn-8414","text":"deliver a human operator's decision back to the requesting agent"}]}],"id":"blk-8680","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8682","kind":"paragraph","spans":[{"id":"spn-8415","text":"Typical input:"}]},{"id":"blk-8683","items":[{"blocks":[{"id":"blk-8685","kind":"paragraph","spans":[{"id":"spn-8416","marks":["code"],"text":"escalation_response"}]}],"id":"blk-8684","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8686","kind":"paragraph","spans":[{"id":"spn-8417","text":"Typical output:"}]},{"id":"blk-8687","items":[{"blocks":[{"id":"blk-8689","kind":"paragraph","spans":[{"id":"spn-8418","marks":["code"],"text":"resolution"}]}],"id":"blk-8688","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8690","kind":"paragraph","spans":[{"id":"spn-8419","text":"Use when:"}]},{"id":"blk-8691","items":[{"blocks":[{"id":"blk-8693","kind":"paragraph","spans":[{"id":"spn-8420","text":"a human has reviewed the escalated action and chosen to approve, reject, or modify it"}]}],"id":"blk-8692","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8694","kind":"heading","level":3,"spans":[{"id":"spn-8421","marks":["code"],"text":"query"}]},{"id":"blk-8695","kind":"paragraph","spans":[{"id":"spn-8422","text":"Purpose:"}]},{"id":"blk-8696","items":[{"blocks":[{"id":"blk-8698","kind":"paragraph","spans":[{"id":"spn-8423","text":"inspect the history and status of escalation events"}]}],"id":"blk-8697","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8699","kind":"paragraph","spans":[{"id":"spn-8424","text":"Typical input:"}]},{"id":"blk-8700","items":[{"blocks":[{"id":"blk-8702","kind":"paragraph","spans":[{"id":"spn-8425","marks":["code"],"text":"escalation_query"}]}],"id":"blk-8701","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8703","kind":"paragraph","spans":[{"id":"spn-8426","text":"Typical output:"}]},{"id":"blk-8704","items":[{"blocks":[{"id":"blk-8706","kind":"paragraph","spans":[{"id":"spn-8427","marks":["code"],"text":"escalation_history"}]}],"id":"blk-8705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8707","kind":"paragraph","spans":[{"id":"spn-8428","text":"Use when:"}]},{"id":"blk-8708","items":[{"blocks":[{"id":"blk-8710","kind":"paragraph","spans":[{"id":"spn-8429","text":"auditing past escalation decisions"}]}],"id":"blk-8709","kind":"list-item"},{"blocks":[{"id":"blk-8712","kind":"paragraph","spans":[{"id":"spn-8430","text":"checking for pending escalations that need attention"}]}],"id":"blk-8711","kind":"list-item"},{"blocks":[{"id":"blk-8714","kind":"paragraph","spans":[{"id":"spn-8431","text":"analyzing escalation patterns across agents or time ranges"}]}],"id":"blk-8713","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8715","kind":"heading","level":2,"spans":[{"id":"spn-8432","text":"8. Trigger types"}]},{"id":"blk-8716","kind":"paragraph","spans":[{"id":"spn-8433","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8434","text":" defines four trigger types that cause an escalation event:"}]},{"id":"blk-8717","kind":"heading","level":3,"spans":[{"id":"spn-8435","marks":["code"],"text":"confidence_below"}]},{"id":"blk-8718","kind":"paragraph","spans":[{"id":"spn-8436","text":"The agent's confidence in the proposed action falls below the threshold configured in the governance block of its "},{"id":"spn-8437","marks":["code"],"text":"ampersand.json"},{"id":"spn-8438","text":" declaration."}]},{"id":"blk-8719","kind":"heading","level":3,"spans":[{"id":"spn-8439","marks":["code"],"text":"cost_exceeds"}]},{"id":"blk-8720","kind":"paragraph","spans":[{"id":"spn-8440","text":"The estimated cost of the proposed action exceeds Delegatic budget limits (per-task or per-period)."}]},{"id":"blk-8721","kind":"heading","level":3,"spans":[{"id":"spn-8441","marks":["code"],"text":"hard_boundary"}]},{"id":"blk-8722","kind":"paragraph","spans":[{"id":"spn-8442","text":"A governance hard constraint is about to be violated. Hard boundaries are never overridable by the agent — they always require human review."}]},{"id":"blk-8723","kind":"heading","level":3,"spans":[{"id":"spn-8443","marks":["code"],"text":"policy_requires_approval"}]},{"id":"blk-8724","kind":"paragraph","spans":[{"id":"spn-8444","text":"The agent's autonomy level or org-level policy mandates human sign-off for this category of action, regardless of confidence or cost."}]},{"id":"blk-8725","kind":"heading","level":2,"spans":[{"id":"spn-8445","text":"9. Timeout behavior"}]},{"id":"blk-8726","kind":"paragraph","spans":[{"id":"spn-8446","text":"When an escalation times out without a human response, behavior depends on the agent's autonomy level:"}]},{"id":"blk-8727","kind":"heading","level":3,"spans":[{"id":"spn-8447","marks":["code"],"text":"observe"},{"id":"spn-8448","text":" autonomy level"}]},{"id":"blk-8728","kind":"paragraph","spans":[{"id":"spn-8449","text":"Timeout action: "},{"id":"spn-8450","marks":["bold"],"text":"auto-reject"},{"id":"spn-8451","text":". The agent logs the escalation as expired and does not execute the proposed action. Rationale: observe-mode agents should never act autonomously."}]},{"id":"blk-8729","kind":"heading","level":3,"spans":[{"id":"spn-8452","marks":["code"],"text":"advise"},{"id":"spn-8453","text":" autonomy level"}]},{"id":"blk-8730","kind":"paragraph","spans":[{"id":"spn-8454","text":"Timeout action: "},{"id":"spn-8455","marks":["bold"],"text":"auto-escalate"},{"id":"spn-8456","text":". The escalation is re-routed to a higher-priority channel or fallback operator. The agent does not act. Rationale: advise-mode agents should surface decisions but not resolve them unilaterally."}]},{"id":"blk-8731","kind":"heading","level":3,"spans":[{"id":"spn-8457","marks":["code"],"text":"act"},{"id":"spn-8458","text":" autonomy level"}]},{"id":"blk-8732","kind":"paragraph","spans":[{"id":"spn-8459","text":"Timeout action: "},{"id":"spn-8460","marks":["bold"],"text":"auto-approve with audit"},{"id":"spn-8461","text":". If the agent's confidence exceeds a fallback threshold, it proceeds with execution and logs a full audit trail. If confidence is below the fallback threshold, the action is rejected. Rationale: act-mode agents are authorized to proceed under defined conditions, but every timeout-triggered action must be auditable."}]},{"id":"blk-8733","kind":"heading","level":2,"spans":[{"id":"spn-8462","text":"10. Response decisions"}]},{"id":"blk-8734","kind":"paragraph","spans":[{"id":"spn-8463","text":"Human operators can respond to an escalation with one of three decisions:"}]},{"id":"blk-8735","kind":"heading","level":3,"spans":[{"id":"spn-8464","marks":["code"],"text":"approve"}]},{"id":"blk-8736","kind":"paragraph","spans":[{"id":"spn-8465","text":"The proposed action is authorized. The agent resumes execution with the original input."}]},{"id":"blk-8737","kind":"heading","level":3,"spans":[{"id":"spn-8466","marks":["code"],"text":"reject"}]},{"id":"blk-8738","kind":"paragraph","spans":[{"id":"spn-8467","text":"The proposed action is denied. The agent must not execute it and should log the rejection reason."}]},{"id":"blk-8739","kind":"heading","level":3,"spans":[{"id":"spn-8468","marks":["code"],"text":"modify"}]},{"id":"blk-8740","kind":"paragraph","spans":[{"id":"spn-8469","text":"The proposed action is partially authorized with changes. The human provides a modified input, and the agent resumes with the modified version."}]},{"id":"blk-8741","kind":"heading","level":2,"spans":[{"id":"spn-8470","text":"11. Architecture patterns"}]},{"id":"blk-8742","kind":"heading","level":3,"spans":[{"id":"spn-8471","text":"Pattern A: reasoning -> escalation -> execution"}]},{"id":"blk-8743","kind":"code","language":"text","text":"context\n|> &reason.plan.plan()\n|> &govern.escalation.escalate()\n|> execute_if_approved()"},{"id":"blk-8744","kind":"paragraph","spans":[{"id":"spn-8472","text":"Use this when:"}]},{"id":"blk-8745","items":[{"blocks":[{"id":"blk-8747","kind":"paragraph","spans":[{"id":"spn-8473","text":"the reasoning step produces a plan that may exceed governance thresholds"}]}],"id":"blk-8746","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8748","kind":"heading","level":3,"spans":[{"id":"spn-8474","text":"Pattern B: telemetry -> escalation -> reasoning"}]},{"id":"blk-8749","kind":"code","language":"text","text":"telemetry_event\n|> &govern.telemetry.budget_check()\n|> &govern.escalation.escalate()\n|> &reason.plan.replan()"},{"id":"blk-8750","kind":"paragraph","spans":[{"id":"spn-8475","text":"Use this when:"}]},{"id":"blk-8751","items":[{"blocks":[{"id":"blk-8753","kind":"paragraph","spans":[{"id":"spn-8476","text":"a budget threshold is crossed and the agent needs human input before adjusting its plan"}]}],"id":"blk-8752","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8754","kind":"heading","level":3,"spans":[{"id":"spn-8477","text":"Pattern C: multi-agent escalation bridge"}]},{"id":"blk-8755","kind":"code","language":"text","text":"agent_a_action\n|> &govern.identity.verify()\n|> &govern.escalation.escalate()\n|> agent_b_respond()"},{"id":"blk-8756","kind":"paragraph","spans":[{"id":"spn-8478","text":"Use this when:"}]},{"id":"blk-8757","items":[{"blocks":[{"id":"blk-8759","kind":"paragraph","spans":[{"id":"spn-8479","text":"one agent's proposed action requires approval from another agent's governance context"}]}],"id":"blk-8758","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8760","kind":"heading","level":3,"spans":[{"id":"spn-8480","text":"Pattern D: escalation with audit trail"}]},{"id":"blk-8761","kind":"code","language":"text","text":"proposed_action\n|> &govern.escalation.escalate()\n|> &govern.telemetry.emit()\n|> execute_or_skip()"},{"id":"blk-8762","kind":"paragraph","spans":[{"id":"spn-8481","text":"Use this when:"}]},{"id":"blk-8763","items":[{"blocks":[{"id":"blk-8765","kind":"paragraph","spans":[{"id":"spn-8482","text":"every escalation event, including its outcome, must be recorded in the telemetry stream"}]}],"id":"blk-8764","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8766","kind":"heading","level":2,"spans":[{"id":"spn-8483","text":"12. Example declaration"}]},{"id":"blk-8767","kind":"paragraph","spans":[{"id":"spn-8484","text":"A concrete "},{"id":"spn-8485","marks":["code"],"text":"ampersand.json"},{"id":"spn-8486","text":" fragment:"}]},{"id":"blk-8768","kind":"code","language":"json","text":"{\n  \"&govern.escalation\": {\n    \"provider\": \"opensentience\",\n    \"config\": {\n      \"timeout_seconds\": 3600,\n      \"fallback_threshold\": 0.85\n    }\n  }\n}"},{"id":"blk-8769","kind":"paragraph","spans":[{"id":"spn-8487","text":"A fuller declaration:"}]},{"id":"blk-8770","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"InfraRemediation\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&reason.plan\": {\n      \"provider\": \"auto\",\n      \"need\": \"infrastructure remediation planning with policy-aware tradeoffs\"\n    },\n    \"&govern.escalation\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"timeout_seconds\": 3600,\n        \"fallback_threshold\": 0.85\n      }\n    },\n    \"&govern.telemetry\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"emit_all_operations\": true\n      }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\n      \"Never deploy to production without human approval\",\n      \"Never modify security groups without escalation\"\n    ],\n    \"soft\": [\n      \"Prefer least-disruption remediation paths\"\n    ],\n    \"escalate_when\": {\n      \"confidence_below\": 0.75,\n      \"cost_exceeds_usd\": 500,\n      \"hard_boundary_approached\": true,\n      \"policy_requires_approval\": [\"deploy\", \"security_modify\"]\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-8771","kind":"heading","level":2,"spans":[{"id":"spn-8488","text":"13. Governance and provenance implications"}]},{"id":"blk-8772","kind":"paragraph","spans":[{"id":"spn-8489","text":"Escalation events are themselves governance artifacts and must participate in the provenance chain."}]},{"id":"blk-8773","kind":"heading","level":3,"spans":[{"id":"spn-8490","text":"Cross-references"}]},{"id":"blk-8774","items":[{"blocks":[{"id":"blk-8776","kind":"paragraph","spans":[{"id":"spn-8491","marks":["bold"],"text":"OpenSentience OS-006"},{"id":"spn-8492","text":": defines autonomy levels (observe, advise, act) that determine escalation behavior and timeout semantics"}]}],"id":"blk-8775","kind":"list-item"},{"blocks":[{"id":"blk-8778","kind":"paragraph","spans":[{"id":"spn-8493","marks":["bold"],"text":"OpenSentience OS-007"},{"id":"spn-8494","text":": addresses threat model for agent impersonation — escalation requests must be attributable to verified agent identities via "},{"id":"spn-8495","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-8777","kind":"list-item"},{"blocks":[{"id":"blk-8780","kind":"paragraph","spans":[{"id":"spn-8496","marks":["bold"],"text":"Delegatic budget policies"},{"id":"spn-8497","text":": cost-based escalation triggers are derived from Delegatic org-level and agent-level budget limits"}]}],"id":"blk-8779","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8781","kind":"heading","level":3,"spans":[{"id":"spn-8498","text":"Representative provenance record"}]},{"id":"blk-8782","kind":"code","language":"json","text":"{\n  \"source\": \"&govern.escalation\",\n  \"provider\": \"opensentience\",\n  \"operation\": \"escalate\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"escalation_id\": \"esc-01JQ7...\",\n  \"trigger\": \"confidence_below\",\n  \"trigger_detail\": {\n    \"confidence\": 0.62,\n    \"threshold\": 0.75\n  },\n  \"decision\": \"approve\",\n  \"responder\": \"ops-lead-42\",\n  \"mcp_trace_id\": \"os-esc-301\"\n}"},{"id":"blk-8783","kind":"paragraph","spans":[{"id":"spn-8499","text":"This matters because escalation decisions can fundamentally alter the execution path."}]},{"id":"blk-8784","kind":"paragraph","spans":[{"id":"spn-8500","text":"Provenance should help answer questions like:"}]},{"id":"blk-8785","items":[{"blocks":[{"id":"blk-8787","kind":"paragraph","spans":[{"id":"spn-8501","text":"Why was this action escalated instead of executed directly?"}]}],"id":"blk-8786","kind":"list-item"},{"blocks":[{"id":"blk-8789","kind":"paragraph","spans":[{"id":"spn-8502","text":"Which trigger condition fired?"}]}],"id":"blk-8788","kind":"list-item"},{"blocks":[{"id":"blk-8791","kind":"paragraph","spans":[{"id":"spn-8503","text":"Who approved or rejected it, and when?"}]}],"id":"blk-8790","kind":"list-item"},{"blocks":[{"id":"blk-8793","kind":"paragraph","spans":[{"id":"spn-8504","text":"Did the action execute under timeout-based auto-approval?"}]}],"id":"blk-8792","kind":"list-item"},{"blocks":[{"id":"blk-8795","kind":"paragraph","spans":[{"id":"spn-8505","text":"Which Delegatic budget policy caused the cost-based trigger?"}]}],"id":"blk-8794","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8796","kind":"heading","level":2,"spans":[{"id":"spn-8506","text":"14. Compatible providers"}]},{"id":"blk-8797","kind":"paragraph","spans":[{"id":"spn-8507","text":"Representative compatible providers include:"}]},{"id":"blk-8798","items":[{"blocks":[{"id":"blk-8800","kind":"paragraph","spans":[{"id":"spn-8508","marks":["code"],"text":"opensentience"},{"id":"spn-8509","text":" (primary runtime provider for escalation bridge)"}]}],"id":"blk-8799","kind":"list-item"},{"blocks":[{"id":"blk-8802","kind":"paragraph","spans":[{"id":"spn-8510","marks":["code"],"text":"delegatic"},{"id":"spn-8511","text":" (policy source for cost and approval thresholds)"}]}],"id":"blk-8801","kind":"list-item"},{"blocks":[{"id":"blk-8804","kind":"paragraph","spans":[{"id":"spn-8512","text":"custom human-review UX systems exposed behind MCP-compatible surfaces"}]}],"id":"blk-8803","kind":"list-item"},{"blocks":[{"id":"blk-8806","kind":"paragraph","spans":[{"id":"spn-8513","text":"enterprise approval workflow engines with structured response semantics"}]}],"id":"blk-8805","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8807","kind":"heading","level":3,"spans":[{"id":"spn-8514","text":"Default ecosystem fit"}]},{"id":"blk-8808","kind":"paragraph","spans":[{"id":"spn-8515","text":"The most natural default ecosystem pairing is:"}]},{"id":"blk-8809","items":[{"blocks":[{"id":"blk-8811","kind":"paragraph","spans":[{"id":"spn-8516","marks":["code"],"text":"opensentience"},{"id":"spn-8517","text":" for the escalation runtime"}]}],"id":"blk-8810","kind":"list-item"},{"blocks":[{"id":"blk-8813","kind":"paragraph","spans":[{"id":"spn-8518","marks":["code"],"text":"delegatic"},{"id":"spn-8519","text":" for the policy definitions that trigger escalation"}]}],"id":"blk-8812","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8814","kind":"paragraph","spans":[{"id":"spn-8520","text":"Why they fit together:"}]},{"id":"blk-8815","items":[{"blocks":[{"id":"blk-8817","kind":"paragraph","spans":[{"id":"spn-8521","text":"OpenSentience defines autonomy levels and timeout semantics"}]}],"id":"blk-8816","kind":"list-item"},{"blocks":[{"id":"blk-8819","kind":"paragraph","spans":[{"id":"spn-8522","text":"Delegatic defines org-level budget and approval policies"}]}],"id":"blk-8818","kind":"list-item"},{"blocks":[{"id":"blk-8821","kind":"paragraph","spans":[{"id":"spn-8523","text":"Together they form the complete escalation governance stack"}]}],"id":"blk-8820","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8822","kind":"paragraph","spans":[{"id":"spn-8524","text":"The protocol stance remains:"}]},{"blocks":[{"id":"blk-8824","kind":"paragraph","spans":[{"id":"spn-8525","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8526","text":" is the capability. "},{"id":"spn-8527","marks":["code"],"text":"opensentience"},{"id":"spn-8528","text":" is one provider that may satisfy it."}]}],"id":"blk-8823","kind":"quote"},{"id":"blk-8825","kind":"heading","level":2,"spans":[{"id":"spn-8529","text":"15. A2A-facing skills"}]},{"id":"blk-8826","kind":"paragraph","spans":[{"id":"spn-8530","text":"A "},{"id":"spn-8531","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8532","text":" capability may advertise skills such as:"}]},{"id":"blk-8827","items":[{"blocks":[{"id":"blk-8829","kind":"paragraph","spans":[{"id":"spn-8533","marks":["code"],"text":"human-escalation-bridge"}]}],"id":"blk-8828","kind":"list-item"},{"blocks":[{"id":"blk-8831","kind":"paragraph","spans":[{"id":"spn-8534","marks":["code"],"text":"approval-workflow"}]}],"id":"blk-8830","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8832","kind":"paragraph","spans":[{"id":"spn-8535","text":"These are useful when generating A2A-style agent cards, because they let an external coordination surface say more than \"has escalation support.\""}]},{"id":"blk-8833","kind":"paragraph","spans":[{"id":"spn-8536","text":"Instead, it can say the agent can:"}]},{"id":"blk-8834","items":[{"blocks":[{"id":"blk-8836","kind":"paragraph","spans":[{"id":"spn-8537","text":"bridge decisions to human operators when governance thresholds are crossed"}]}],"id":"blk-8835","kind":"list-item"},{"blocks":[{"id":"blk-8838","kind":"paragraph","spans":[{"id":"spn-8538","text":"participate in structured approval workflows with approve/reject/modify semantics"}]}],"id":"blk-8837","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8839","kind":"heading","level":2,"spans":[{"id":"spn-8539","text":"16. Anti-patterns"}]},{"id":"blk-8840","kind":"heading","level":3,"spans":[{"id":"spn-8540","text":"Anti-pattern 1: treat escalation as error handling"}]},{"id":"blk-8841","kind":"paragraph","spans":[{"id":"spn-8541","text":"Escalation is a governance mechanism, not an exception path. Agents that only escalate on errors miss the core purpose: structured human oversight of normal decisions that cross thresholds."}]},{"id":"blk-8842","kind":"heading","level":3,"spans":[{"id":"spn-8542","text":"Anti-pattern 2: escalate everything"}]},{"id":"blk-8843","kind":"paragraph","spans":[{"id":"spn-8543","text":"If every action is escalated, the human operator becomes a bottleneck and trust in the agent degrades. Escalation thresholds should be calibrated to surface only meaningful decisions."}]},{"id":"blk-8844","kind":"heading","level":3,"spans":[{"id":"spn-8544","text":"Anti-pattern 3: ignore timeout semantics"}]},{"id":"blk-8845","kind":"paragraph","spans":[{"id":"spn-8545","text":"Timeout behavior varies by autonomy level for good reasons. Implementing a single timeout policy across all levels defeats the purpose of differentiated autonomy."}]},{"id":"blk-8846","kind":"heading","level":3,"spans":[{"id":"spn-8546","text":"Anti-pattern 4: escalate without context"}]},{"id":"blk-8847","kind":"paragraph","spans":[{"id":"spn-8547","text":"An escalation request without rationale, confidence scores, or trigger details forces the human to reconstruct the decision context. Always include the agent's reasoning and the specific trigger condition."}]},{"id":"blk-8848","kind":"heading","level":3,"spans":[{"id":"spn-8548","text":"Anti-pattern 5: skip provenance on auto-approved timeouts"}]},{"id":"blk-8849","kind":"paragraph","spans":[{"id":"spn-8549","text":"When an act-mode agent auto-approves on timeout, the audit trail is especially important. Skipping provenance on these events creates governance blind spots."}]},{"id":"blk-8850","kind":"heading","level":2,"spans":[{"id":"spn-8550","text":"17. Summary"}]},{"id":"blk-8851","kind":"paragraph","spans":[{"id":"spn-8551","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8552","text":" is the [&] Protocol capability for "},{"id":"spn-8553","marks":["bold"],"text":"governance-mandated decision handoff"},{"id":"spn-8554","text":"."}]},{"id":"blk-8852","kind":"paragraph","spans":[{"id":"spn-8555","text":"It is the right capability when an agent needs to:"}]},{"id":"blk-8853","items":[{"blocks":[{"id":"blk-8855","kind":"paragraph","spans":[{"id":"spn-8556","text":"pause before executing actions that cross confidence, cost, or policy thresholds"}]}],"id":"blk-8854","kind":"list-item"},{"blocks":[{"id":"blk-8857","kind":"paragraph","spans":[{"id":"spn-8557","text":"present proposed actions to human operators with full context"}]}],"id":"blk-8856","kind":"list-item"},{"blocks":[{"id":"blk-8859","kind":"paragraph","spans":[{"id":"spn-8558","text":"handle timeout behavior differently based on autonomy level"}]}],"id":"blk-8858","kind":"list-item"},{"blocks":[{"id":"blk-8861","kind":"paragraph","spans":[{"id":"spn-8559","text":"maintain auditable records of every escalation lifecycle"}]}],"id":"blk-8860","kind":"list-item"},{"blocks":[{"id":"blk-8863","kind":"paragraph","spans":[{"id":"spn-8560","text":"compose escalation with reasoning, telemetry, and identity capabilities"}]}],"id":"blk-8862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8864","kind":"paragraph","spans":[{"id":"spn-8561","text":"In one sentence:"}]},{"blocks":[{"id":"blk-8866","kind":"paragraph","spans":[{"id":"spn-8562","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8563","text":" gives an agent a protocol-native way to hand off decisions to humans when governance thresholds require it."}]}],"id":"blk-8865","kind":"quote"}],"edges":[],"id":"bagaaiera2izv57u4vvcfn4kufjvh7qdh3mdm653vuy7tvzvvtrubixun4iga","vocabulary":"ampersand.docs.fs.v1"}