{"bendscript":"0.1","blocks":[{"id":"blk-8510","kind":"heading","level":1,"spans":[{"id":"spn-8066","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8067","text":" — Human-in-the-Loop Escalation and Governance Handoff"}]},{"id":"blk-8511","kind":"paragraph","spans":[{"id":"spn-8068","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8069","text":" is the [&] Protocol capability for "},{"id":"spn-8070","marks":["bold"],"text":"governance-mandated escalation"},{"id":"spn-8071","text":"."}]},{"id":"blk-8512","kind":"paragraph","spans":[{"id":"spn-8072","text":"It describes an agent's ability to:"}]},{"id":"blk-8513","items":[{"blocks":[{"id":"blk-8515","kind":"paragraph","spans":[{"id":"spn-8073","text":"detect when a decision exceeds its authorized autonomy"}]}],"id":"blk-8514","kind":"list-item"},{"blocks":[{"id":"blk-8517","kind":"paragraph","spans":[{"id":"spn-8074","text":"surface that decision to a human operator or governance layer"}]}],"id":"blk-8516","kind":"list-item"},{"blocks":[{"id":"blk-8519","kind":"paragraph","spans":[{"id":"spn-8075","text":"pause execution until a response is received or timeout expires"}]}],"id":"blk-8518","kind":"list-item"},{"blocks":[{"id":"blk-8521","kind":"paragraph","spans":[{"id":"spn-8076","text":"resume with an approved, rejected, or modified action"}]}],"id":"blk-8520","kind":"list-item"},{"blocks":[{"id":"blk-8523","kind":"paragraph","spans":[{"id":"spn-8077","text":"maintain a queryable history of all escalation events"}]}],"id":"blk-8522","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8524","kind":"paragraph","spans":[{"id":"spn-8078","text":"In the protocol's five-primitive model:"}]},{"id":"blk-8525","items":[{"blocks":[{"id":"blk-8527","kind":"paragraph","spans":[{"id":"spn-8079","marks":["code"],"text":"&memory"},{"id":"spn-8080","text":" answers "},{"id":"spn-8081","marks":["bold"],"text":"what"},{"id":"spn-8082","text":" the agent knows"}]}],"id":"blk-8526","kind":"list-item"},{"blocks":[{"id":"blk-8529","kind":"paragraph","spans":[{"id":"spn-8083","marks":["code"],"text":"&reason"},{"id":"spn-8084","text":" answers "},{"id":"spn-8085","marks":["bold"],"text":"how"},{"id":"spn-8086","text":" the agent decides"}]}],"id":"blk-8528","kind":"list-item"},{"blocks":[{"id":"blk-8531","kind":"paragraph","spans":[{"id":"spn-8087","marks":["code"],"text":"&time"},{"id":"spn-8088","text":" answers "},{"id":"spn-8089","marks":["bold"],"text":"when"},{"id":"spn-8090","text":" things change"}]}],"id":"blk-8530","kind":"list-item"},{"blocks":[{"id":"blk-8533","kind":"paragraph","spans":[{"id":"spn-8091","marks":["code"],"text":"&space"},{"id":"spn-8092","text":" answers "},{"id":"spn-8093","marks":["bold"],"text":"where"},{"id":"spn-8094","text":" things are"}]}],"id":"blk-8532","kind":"list-item"},{"blocks":[{"id":"blk-8535","kind":"paragraph","spans":[{"id":"spn-8095","marks":["code"],"text":"&govern"},{"id":"spn-8096","text":" answers "},{"id":"spn-8097","marks":["bold"],"text":"who approves, what limits apply, and how decisions are audited"}]}],"id":"blk-8534","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8536","kind":"paragraph","spans":[{"id":"spn-8098","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8099","text":" is the subtype that handles the critical handoff between autonomous agent action and human oversight."}]},{"id":"blk-8537","kind":"heading","level":2,"spans":[{"id":"spn-8100","text":"1. Definition"}]},{"id":"blk-8538","kind":"paragraph","spans":[{"id":"spn-8101","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8102","text":" is the capability interface for "},{"id":"spn-8103","marks":["bold"],"text":"human-in-the-loop decision escalation"},{"id":"spn-8104","text":"."}]},{"id":"blk-8539","kind":"paragraph","spans":[{"id":"spn-8105","text":"It is used when an agent must:"}]},{"id":"blk-8540","items":[{"blocks":[{"id":"blk-8542","kind":"paragraph","spans":[{"id":"spn-8106","text":"pause before executing an action that crosses a governance threshold"}]}],"id":"blk-8541","kind":"list-item"},{"blocks":[{"id":"blk-8544","kind":"paragraph","spans":[{"id":"spn-8107","text":"present a proposed action with rationale to a human reviewer"}]}],"id":"blk-8543","kind":"list-item"},{"blocks":[{"id":"blk-8546","kind":"paragraph","spans":[{"id":"spn-8108","text":"wait for approval, rejection, or modification"}]}],"id":"blk-8545","kind":"list-item"},{"blocks":[{"id":"blk-8548","kind":"paragraph","spans":[{"id":"spn-8109","text":"handle timeout behavior according to autonomy level"}]}],"id":"blk-8547","kind":"list-item"},{"blocks":[{"id":"blk-8550","kind":"paragraph","spans":[{"id":"spn-8110","text":"record the full escalation lifecycle for audit"}]}],"id":"blk-8549","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8551","kind":"paragraph","spans":[{"id":"spn-8111","text":"Escalation is NOT failure. It is a governance-mandated handoff when agent confidence or cost crosses thresholds defined by policy."}]},{"id":"blk-8552","kind":"paragraph","spans":[{"id":"spn-8112","text":"This distinction matters because agents that treat escalation as error will:"}]},{"id":"blk-8553","items":[{"blocks":[{"id":"blk-8555","kind":"paragraph","spans":[{"id":"spn-8113","text":"suppress legitimate governance signals"}]}],"id":"blk-8554","kind":"list-item"},{"blocks":[{"id":"blk-8557","kind":"paragraph","spans":[{"id":"spn-8114","text":"avoid surfacing uncertainty"}]}],"id":"blk-8556","kind":"list-item"},{"blocks":[{"id":"blk-8559","kind":"paragraph","spans":[{"id":"spn-8115","text":"degrade trust over time"}]}],"id":"blk-8558","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8560","kind":"paragraph","spans":[{"id":"spn-8116","text":"The protocol treats escalation as a first-class capability, not an exception path."}]},{"id":"blk-8561","kind":"heading","level":2,"spans":[{"id":"spn-8117","text":"2. Why this capability exists"}]},{"id":"blk-8562","kind":"paragraph","spans":[{"id":"spn-8118","text":"Many agent systems either operate fully autonomously or halt completely when uncertainty arises."}]},{"id":"blk-8563","kind":"paragraph","spans":[{"id":"spn-8119","text":"Neither extreme is acceptable in production governance:"}]},{"id":"blk-8564","items":[{"blocks":[{"id":"blk-8566","kind":"paragraph","spans":[{"id":"spn-8120","text":"A logistics agent proposes a high-cost reallocation but has no mechanism to ask a human before committing."}]}],"id":"blk-8565","kind":"list-item"},{"blocks":[{"id":"blk-8568","kind":"paragraph","spans":[{"id":"spn-8121","text":"An infrastructure agent detects a hard boundary violation but silently logs it instead of requesting approval."}]}],"id":"blk-8567","kind":"list-item"},{"blocks":[{"id":"blk-8570","kind":"paragraph","spans":[{"id":"spn-8122","text":"A support agent encounters a policy-sensitive case but lacks a structured way to surface it to a supervisor."}]}],"id":"blk-8569","kind":"list-item"},{"blocks":[{"id":"blk-8572","kind":"paragraph","spans":[{"id":"spn-8123","text":"A planning agent operates below its confidence threshold but proceeds anyway because no escalation path exists."}]}],"id":"blk-8571","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8573","kind":"paragraph","spans":[{"id":"spn-8124","text":"In all of these cases, the missing layer is "},{"id":"spn-8125","marks":["bold"],"text":"structured escalation with defined trigger conditions, timeout behavior, and response semantics"},{"id":"spn-8126","text":"."}]},{"id":"blk-8574","kind":"paragraph","spans":[{"id":"spn-8127","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8128","text":" gives the protocol a standard way to declare that capability."}]},{"id":"blk-8575","kind":"heading","level":2,"spans":[{"id":"spn-8129","text":"3. What problems "},{"id":"spn-8130","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8131","text":" solves"}]},{"id":"blk-8576","kind":"paragraph","spans":[{"id":"spn-8132","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8133","text":" is useful when an agent needs to answer questions like:"}]},{"id":"blk-8577","items":[{"blocks":[{"id":"blk-8579","kind":"paragraph","spans":[{"id":"spn-8134","text":"Should I proceed with this action given my current confidence level?"}]}],"id":"blk-8578","kind":"list-item"},{"blocks":[{"id":"blk-8581","kind":"paragraph","spans":[{"id":"spn-8135","text":"Does this action exceed the cost threshold defined by Delegatic policy?"}]}],"id":"blk-8580","kind":"list-item"},{"blocks":[{"id":"blk-8583","kind":"paragraph","spans":[{"id":"spn-8136","text":"Am I approaching a hard boundary that requires human sign-off?"}]}],"id":"blk-8582","kind":"list-item"},{"blocks":[{"id":"blk-8585","kind":"paragraph","spans":[{"id":"spn-8137","text":"Does the current autonomy level (observe, advise, act) permit this operation?"}]}],"id":"blk-8584","kind":"list-item"},{"blocks":[{"id":"blk-8587","kind":"paragraph","spans":[{"id":"spn-8138","text":"What should happen if no human responds within the timeout window?"}]}],"id":"blk-8586","kind":"list-item"},{"blocks":[{"id":"blk-8589","kind":"paragraph","spans":[{"id":"spn-8139","text":"How do I resume execution after receiving approval or modification?"}]}],"id":"blk-8588","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8590","kind":"paragraph","spans":[{"id":"spn-8140","text":"Without this capability, escalation logic tends to get buried inside:"}]},{"id":"blk-8591","items":[{"blocks":[{"id":"blk-8593","kind":"paragraph","spans":[{"id":"spn-8141","text":"ad-hoc if/else blocks in application code"}]}],"id":"blk-8592","kind":"list-item"},{"blocks":[{"id":"blk-8595","kind":"paragraph","spans":[{"id":"spn-8142","text":"implicit confidence thresholds with no auditability"}]}],"id":"blk-8594","kind":"list-item"},{"blocks":[{"id":"blk-8597","kind":"paragraph","spans":[{"id":"spn-8143","text":"custom notification systems with no structured response path"}]}],"id":"blk-8596","kind":"list-item"},{"blocks":[{"id":"blk-8599","kind":"paragraph","spans":[{"id":"spn-8144","text":"provider-specific approval workflows with no interoperability"}]}],"id":"blk-8598","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8600","kind":"paragraph","spans":[{"id":"spn-8145","text":"The protocol makes it explicit instead."}]},{"id":"blk-8601","kind":"heading","level":2,"spans":[{"id":"spn-8146","text":"4. Capability role in the "},{"id":"spn-8147","marks":["code"],"text":"&govern"},{"id":"spn-8148","text":" namespace"}]},{"id":"blk-8602","kind":"paragraph","spans":[{"id":"spn-8149","text":"The "},{"id":"spn-8150","marks":["code"],"text":"&govern"},{"id":"spn-8151","text":" primitive supports multiple subtypes, including:"}]},{"id":"blk-8603","items":[{"blocks":[{"id":"blk-8605","kind":"paragraph","spans":[{"id":"spn-8152","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-8604","kind":"list-item"},{"blocks":[{"id":"blk-8607","kind":"paragraph","spans":[{"id":"spn-8153","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-8606","kind":"list-item"},{"blocks":[{"id":"blk-8609","kind":"paragraph","spans":[{"id":"spn-8154","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-8608","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8610","kind":"paragraph","spans":[{"id":"spn-8155","text":"A helpful distinction is:"}]},{"id":"blk-8611","items":[{"blocks":[{"id":"blk-8613","kind":"paragraph","spans":[{"id":"spn-8156","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8157","text":" = decision handoff when thresholds are crossed"}]}],"id":"blk-8612","kind":"list-item"},{"blocks":[{"id":"blk-8615","kind":"paragraph","spans":[{"id":"spn-8158","marks":["code"],"text":"&govern.identity"},{"id":"spn-8159","text":" = agent authentication and trust verification"}]}],"id":"blk-8614","kind":"list-item"},{"blocks":[{"id":"blk-8617","kind":"paragraph","spans":[{"id":"spn-8160","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-8161","text":" = observability, cost tracking, and budget enforcement"}]}],"id":"blk-8616","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8618","kind":"paragraph","spans":[{"id":"spn-8162","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8163","text":" is the right subtype when the main problem is "},{"id":"spn-8164","marks":["bold"],"text":"controlling what happens at the boundary between autonomous action and human oversight"},{"id":"spn-8165","text":"."}]},{"id":"blk-8619","kind":"heading","level":2,"spans":[{"id":"spn-8166","text":"5. Typical use cases"}]},{"id":"blk-8620","kind":"heading","level":3,"spans":[{"id":"spn-8167","text":"Confidence-based escalation"}]},{"id":"blk-8621","kind":"paragraph","spans":[{"id":"spn-8168","text":"Agent confidence drops below the configured threshold during reasoning. The proposed action is surfaced for human review before execution."}]},{"id":"blk-8622","kind":"heading","level":3,"spans":[{"id":"spn-8169","text":"Cost-based escalation"}]},{"id":"blk-8623","kind":"paragraph","spans":[{"id":"spn-8170","text":"A planned action would exceed the per-task or per-period cost budget defined in Delegatic policy. The agent requests approval before committing resources."}]},{"id":"blk-8624","kind":"heading","level":3,"spans":[{"id":"spn-8171","text":"Hard boundary escalation"}]},{"id":"blk-8625","kind":"paragraph","spans":[{"id":"spn-8172","text":"The agent approaches a governance hard constraint (e.g., \"never deploy to production without approval\"). The boundary rule triggers mandatory human review."}]},{"id":"blk-8626","kind":"heading","level":3,"spans":[{"id":"spn-8173","text":"Policy-required approval"}]},{"id":"blk-8627","kind":"paragraph","spans":[{"id":"spn-8174","text":"The autonomy level or org policy requires human sign-off for certain capability operations regardless of confidence or cost."}]},{"id":"blk-8628","kind":"heading","level":3,"spans":[{"id":"spn-8175","text":"Cross-agent escalation"}]},{"id":"blk-8629","kind":"paragraph","spans":[{"id":"spn-8176","text":"In multi-agent workflows, one agent escalates to another agent's human operator when a collaborative decision crosses governance boundaries."}]},{"id":"blk-8630","kind":"heading","level":3,"spans":[{"id":"spn-8177","text":"Audit-driven escalation"}]},{"id":"blk-8631","kind":"paragraph","spans":[{"id":"spn-8178","text":"Retrospective analysis of telemetry reveals that an action should have been escalated. The system flags it for review and updates escalation policy."}]},{"id":"blk-8632","kind":"heading","level":2,"spans":[{"id":"spn-8179","text":"6. Example capability contract"}]},{"id":"blk-8633","kind":"paragraph","spans":[{"id":"spn-8180","text":"The authoritative contract is at "},{"id":"spn-8181","marks":["code"],"text":"contracts/v0.1.0/govern.escalation.contract.json"},{"id":"spn-8182","text":"."}]},{"id":"blk-8634","kind":"paragraph","spans":[{"id":"spn-8183","text":"A representative summary:"}]},{"id":"blk-8635","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\",\n  \"capability\": \"&govern.escalation\",\n  \"provider\": \"opensentience\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Human-in-the-loop escalation contract for governance-mandated decision handoff.\",\n  \"operations\": {\n    \"escalate\": {\n      \"in\": \"escalation_request\",\n      \"out\": \"escalation_ack\",\n      \"description\": \"Submit an action for human review. Agent pauses until response or timeout.\"\n    },\n    \"respond\": {\n      \"in\": \"escalation_response\",\n      \"out\": \"resolution\",\n      \"description\": \"Human operator approves, rejects, or modifies the escalated action.\"\n    },\n    \"query\": {\n      \"in\": \"escalation_query\",\n      \"out\": \"escalation_history\",\n      \"description\": \"Query pending, resolved, or expired escalations by agent, org, goal, or time range.\"\n    }\n  },\n  \"accepts_from\": [\n    \"&reason.*\",\n    \"&govern.telemetry\",\n    \"escalation_request\",\n    \"escalation_response\"\n  ],\n  \"feeds_into\": [\n    \"&reason.*\",\n    \"&govern.telemetry\",\n    \"output\"\n  ],\n  \"a2a_skills\": [\n    \"human-escalation-bridge\",\n    \"approval-workflow\"\n  ]\n}"},{"id":"blk-8636","kind":"heading","level":3,"spans":[{"id":"spn-8184","text":"What this contract means"}]},{"id":"blk-8637","kind":"paragraph","spans":[{"id":"spn-8185","text":"This contract says that "},{"id":"spn-8186","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8187","text":" can:"}]},{"id":"blk-8638","items":[{"blocks":[{"id":"blk-8640","kind":"paragraph","spans":[{"id":"spn-8188","text":"accept escalation requests from reasoning capabilities or telemetry triggers"}]}],"id":"blk-8639","kind":"list-item"},{"blocks":[{"id":"blk-8642","kind":"paragraph","spans":[{"id":"spn-8189","text":"present them to a human operator via the escalation bridge"}]}],"id":"blk-8641","kind":"list-item"},{"blocks":[{"id":"blk-8644","kind":"paragraph","spans":[{"id":"spn-8190","text":"return structured resolutions (approve, reject, modify)"}]}],"id":"blk-8643","kind":"list-item"},{"blocks":[{"id":"blk-8646","kind":"paragraph","spans":[{"id":"spn-8191","text":"feed resolution outcomes back into reasoning and telemetry"}]}],"id":"blk-8645","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8647","kind":"paragraph","spans":[{"id":"spn-8192","text":"It also says that this capability composes well with:"}]},{"id":"blk-8648","items":[{"blocks":[{"id":"blk-8650","kind":"paragraph","spans":[{"id":"spn-8193","marks":["code"],"text":"&reason.*"},{"id":"spn-8194","text":" upstream, where reasoning produces actions that may require approval"}]}],"id":"blk-8649","kind":"list-item"},{"blocks":[{"id":"blk-8652","kind":"paragraph","spans":[{"id":"spn-8195","marks":["code"],"text":"&govern.telemetry"},{"id":"spn-8196","text":" upstream, where cost or usage signals trigger escalation"}]}],"id":"blk-8651","kind":"list-item"},{"blocks":[{"id":"blk-8654","kind":"paragraph","spans":[{"id":"spn-8197","marks":["code"],"text":"&reason.*"},{"id":"spn-8198","text":" downstream, where approved or modified actions resume execution"}]}],"id":"blk-8653","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8655","kind":"heading","level":2,"spans":[{"id":"spn-8199","text":"7. Core operations"}]},{"id":"blk-8656","kind":"heading","level":3,"spans":[{"id":"spn-8200","marks":["code"],"text":"escalate"}]},{"id":"blk-8657","kind":"paragraph","spans":[{"id":"spn-8201","text":"Purpose:"}]},{"id":"blk-8658","items":[{"blocks":[{"id":"blk-8660","kind":"paragraph","spans":[{"id":"spn-8202","text":"submit a proposed action for human review"}]}],"id":"blk-8659","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8661","kind":"paragraph","spans":[{"id":"spn-8203","text":"Typical input:"}]},{"id":"blk-8662","items":[{"blocks":[{"id":"blk-8664","kind":"paragraph","spans":[{"id":"spn-8204","marks":["code"],"text":"escalation_request"}]}],"id":"blk-8663","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8665","kind":"paragraph","spans":[{"id":"spn-8205","text":"Typical output:"}]},{"id":"blk-8666","items":[{"blocks":[{"id":"blk-8668","kind":"paragraph","spans":[{"id":"spn-8206","marks":["code"],"text":"escalation_ack"}]}],"id":"blk-8667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8669","kind":"paragraph","spans":[{"id":"spn-8207","text":"Use when:"}]},{"id":"blk-8670","items":[{"blocks":[{"id":"blk-8672","kind":"paragraph","spans":[{"id":"spn-8208","text":"the agent's confidence is below the configured threshold"}]}],"id":"blk-8671","kind":"list-item"},{"blocks":[{"id":"blk-8674","kind":"paragraph","spans":[{"id":"spn-8209","text":"the estimated cost exceeds Delegatic policy limits"}]}],"id":"blk-8673","kind":"list-item"},{"blocks":[{"id":"blk-8676","kind":"paragraph","spans":[{"id":"spn-8210","text":"a hard boundary constraint is approaching"}]}],"id":"blk-8675","kind":"list-item"},{"blocks":[{"id":"blk-8678","kind":"paragraph","spans":[{"id":"spn-8211","text":"the autonomy level requires approval for this operation type"}]}],"id":"blk-8677","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8679","kind":"heading","level":3,"spans":[{"id":"spn-8212","marks":["code"],"text":"respond"}]},{"id":"blk-8680","kind":"paragraph","spans":[{"id":"spn-8213","text":"Purpose:"}]},{"id":"blk-8681","items":[{"blocks":[{"id":"blk-8683","kind":"paragraph","spans":[{"id":"spn-8214","text":"deliver a human operator's decision back to the requesting agent"}]}],"id":"blk-8682","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8684","kind":"paragraph","spans":[{"id":"spn-8215","text":"Typical input:"}]},{"id":"blk-8685","items":[{"blocks":[{"id":"blk-8687","kind":"paragraph","spans":[{"id":"spn-8216","marks":["code"],"text":"escalation_response"}]}],"id":"blk-8686","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8688","kind":"paragraph","spans":[{"id":"spn-8217","text":"Typical output:"}]},{"id":"blk-8689","items":[{"blocks":[{"id":"blk-8691","kind":"paragraph","spans":[{"id":"spn-8218","marks":["code"],"text":"resolution"}]}],"id":"blk-8690","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8692","kind":"paragraph","spans":[{"id":"spn-8219","text":"Use when:"}]},{"id":"blk-8693","items":[{"blocks":[{"id":"blk-8695","kind":"paragraph","spans":[{"id":"spn-8220","text":"a human has reviewed the escalated action and chosen to approve, reject, or modify it"}]}],"id":"blk-8694","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8696","kind":"heading","level":3,"spans":[{"id":"spn-8221","marks":["code"],"text":"query"}]},{"id":"blk-8697","kind":"paragraph","spans":[{"id":"spn-8222","text":"Purpose:"}]},{"id":"blk-8698","items":[{"blocks":[{"id":"blk-8700","kind":"paragraph","spans":[{"id":"spn-8223","text":"inspect the history and status of escalation events"}]}],"id":"blk-8699","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8701","kind":"paragraph","spans":[{"id":"spn-8224","text":"Typical input:"}]},{"id":"blk-8702","items":[{"blocks":[{"id":"blk-8704","kind":"paragraph","spans":[{"id":"spn-8225","marks":["code"],"text":"escalation_query"}]}],"id":"blk-8703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8705","kind":"paragraph","spans":[{"id":"spn-8226","text":"Typical output:"}]},{"id":"blk-8706","items":[{"blocks":[{"id":"blk-8708","kind":"paragraph","spans":[{"id":"spn-8227","marks":["code"],"text":"escalation_history"}]}],"id":"blk-8707","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8709","kind":"paragraph","spans":[{"id":"spn-8228","text":"Use when:"}]},{"id":"blk-8710","items":[{"blocks":[{"id":"blk-8712","kind":"paragraph","spans":[{"id":"spn-8229","text":"auditing past escalation decisions"}]}],"id":"blk-8711","kind":"list-item"},{"blocks":[{"id":"blk-8714","kind":"paragraph","spans":[{"id":"spn-8230","text":"checking for pending escalations that need attention"}]}],"id":"blk-8713","kind":"list-item"},{"blocks":[{"id":"blk-8716","kind":"paragraph","spans":[{"id":"spn-8231","text":"analyzing escalation patterns across agents or time ranges"}]}],"id":"blk-8715","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8717","kind":"heading","level":2,"spans":[{"id":"spn-8232","text":"8. Trigger types"}]},{"id":"blk-8718","kind":"paragraph","spans":[{"id":"spn-8233","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8234","text":" defines four trigger types that cause an escalation event:"}]},{"id":"blk-8719","kind":"heading","level":3,"spans":[{"id":"spn-8235","marks":["code"],"text":"confidence_below"}]},{"id":"blk-8720","kind":"paragraph","spans":[{"id":"spn-8236","text":"The agent's confidence in the proposed action falls below the threshold configured in the governance block of its "},{"id":"spn-8237","marks":["code"],"text":"ampersand.json"},{"id":"spn-8238","text":" declaration."}]},{"id":"blk-8721","kind":"heading","level":3,"spans":[{"id":"spn-8239","marks":["code"],"text":"cost_exceeds"}]},{"id":"blk-8722","kind":"paragraph","spans":[{"id":"spn-8240","text":"The estimated cost of the proposed action exceeds Delegatic budget limits (per-task or per-period)."}]},{"id":"blk-8723","kind":"heading","level":3,"spans":[{"id":"spn-8241","marks":["code"],"text":"hard_boundary"}]},{"id":"blk-8724","kind":"paragraph","spans":[{"id":"spn-8242","text":"A governance hard constraint is about to be violated. Hard boundaries are never overridable by the agent — they always require human review."}]},{"id":"blk-8725","kind":"heading","level":3,"spans":[{"id":"spn-8243","marks":["code"],"text":"policy_requires_approval"}]},{"id":"blk-8726","kind":"paragraph","spans":[{"id":"spn-8244","text":"The agent's autonomy level or org-level policy mandates human sign-off for this category of action, regardless of confidence or cost."}]},{"id":"blk-8727","kind":"heading","level":2,"spans":[{"id":"spn-8245","text":"9. Timeout behavior"}]},{"id":"blk-8728","kind":"paragraph","spans":[{"id":"spn-8246","text":"When an escalation times out without a human response, behavior depends on the agent's autonomy level:"}]},{"id":"blk-8729","kind":"heading","level":3,"spans":[{"id":"spn-8247","marks":["code"],"text":"observe"},{"id":"spn-8248","text":" autonomy level"}]},{"id":"blk-8730","kind":"paragraph","spans":[{"id":"spn-8249","text":"Timeout action: "},{"id":"spn-8250","marks":["bold"],"text":"auto-reject"},{"id":"spn-8251","text":". The agent logs the escalation as expired and does not execute the proposed action. Rationale: observe-mode agents should never act autonomously."}]},{"id":"blk-8731","kind":"heading","level":3,"spans":[{"id":"spn-8252","marks":["code"],"text":"advise"},{"id":"spn-8253","text":" autonomy level"}]},{"id":"blk-8732","kind":"paragraph","spans":[{"id":"spn-8254","text":"Timeout action: "},{"id":"spn-8255","marks":["bold"],"text":"auto-escalate"},{"id":"spn-8256","text":". The escalation is re-routed to a higher-priority channel or fallback operator. The agent does not act. Rationale: advise-mode agents should surface decisions but not resolve them unilaterally."}]},{"id":"blk-8733","kind":"heading","level":3,"spans":[{"id":"spn-8257","marks":["code"],"text":"act"},{"id":"spn-8258","text":" autonomy level"}]},{"id":"blk-8734","kind":"paragraph","spans":[{"id":"spn-8259","text":"Timeout action: "},{"id":"spn-8260","marks":["bold"],"text":"auto-approve with audit"},{"id":"spn-8261","text":". If the agent's confidence exceeds a fallback threshold, it proceeds with execution and logs a full audit trail. If confidence is below the fallback threshold, the action is rejected. Rationale: act-mode agents are authorized to proceed under defined conditions, but every timeout-triggered action must be auditable."}]},{"id":"blk-8735","kind":"heading","level":2,"spans":[{"id":"spn-8262","text":"10. Response decisions"}]},{"id":"blk-8736","kind":"paragraph","spans":[{"id":"spn-8263","text":"Human operators can respond to an escalation with one of three decisions:"}]},{"id":"blk-8737","kind":"heading","level":3,"spans":[{"id":"spn-8264","marks":["code"],"text":"approve"}]},{"id":"blk-8738","kind":"paragraph","spans":[{"id":"spn-8265","text":"The proposed action is authorized. The agent resumes execution with the original input."}]},{"id":"blk-8739","kind":"heading","level":3,"spans":[{"id":"spn-8266","marks":["code"],"text":"reject"}]},{"id":"blk-8740","kind":"paragraph","spans":[{"id":"spn-8267","text":"The proposed action is denied. The agent must not execute it and should log the rejection reason."}]},{"id":"blk-8741","kind":"heading","level":3,"spans":[{"id":"spn-8268","marks":["code"],"text":"modify"}]},{"id":"blk-8742","kind":"paragraph","spans":[{"id":"spn-8269","text":"The proposed action is partially authorized with changes. The human provides a modified input, and the agent resumes with the modified version."}]},{"id":"blk-8743","kind":"heading","level":2,"spans":[{"id":"spn-8270","text":"11. Architecture patterns"}]},{"id":"blk-8744","kind":"heading","level":3,"spans":[{"id":"spn-8271","text":"Pattern A: reasoning -> escalation -> execution"}]},{"id":"blk-8745","kind":"code","language":"text","text":"context\n|> &reason.plan.plan()\n|> &govern.escalation.escalate()\n|> execute_if_approved()"},{"id":"blk-8746","kind":"paragraph","spans":[{"id":"spn-8272","text":"Use this when:"}]},{"id":"blk-8747","items":[{"blocks":[{"id":"blk-8749","kind":"paragraph","spans":[{"id":"spn-8273","text":"the reasoning step produces a plan that may exceed governance thresholds"}]}],"id":"blk-8748","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8750","kind":"heading","level":3,"spans":[{"id":"spn-8274","text":"Pattern B: telemetry -> escalation -> reasoning"}]},{"id":"blk-8751","kind":"code","language":"text","text":"telemetry_event\n|> &govern.telemetry.budget_check()\n|> &govern.escalation.escalate()\n|> &reason.plan.replan()"},{"id":"blk-8752","kind":"paragraph","spans":[{"id":"spn-8275","text":"Use this when:"}]},{"id":"blk-8753","items":[{"blocks":[{"id":"blk-8755","kind":"paragraph","spans":[{"id":"spn-8276","text":"a budget threshold is crossed and the agent needs human input before adjusting its plan"}]}],"id":"blk-8754","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8756","kind":"heading","level":3,"spans":[{"id":"spn-8277","text":"Pattern C: multi-agent escalation bridge"}]},{"id":"blk-8757","kind":"code","language":"text","text":"agent_a_action\n|> &govern.identity.verify()\n|> &govern.escalation.escalate()\n|> agent_b_respond()"},{"id":"blk-8758","kind":"paragraph","spans":[{"id":"spn-8278","text":"Use this when:"}]},{"id":"blk-8759","items":[{"blocks":[{"id":"blk-8761","kind":"paragraph","spans":[{"id":"spn-8279","text":"one agent's proposed action requires approval from another agent's governance context"}]}],"id":"blk-8760","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8762","kind":"heading","level":3,"spans":[{"id":"spn-8280","text":"Pattern D: escalation with audit trail"}]},{"id":"blk-8763","kind":"code","language":"text","text":"proposed_action\n|> &govern.escalation.escalate()\n|> &govern.telemetry.emit()\n|> execute_or_skip()"},{"id":"blk-8764","kind":"paragraph","spans":[{"id":"spn-8281","text":"Use this when:"}]},{"id":"blk-8765","items":[{"blocks":[{"id":"blk-8767","kind":"paragraph","spans":[{"id":"spn-8282","text":"every escalation event, including its outcome, must be recorded in the telemetry stream"}]}],"id":"blk-8766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8768","kind":"heading","level":2,"spans":[{"id":"spn-8283","text":"12. Example declaration"}]},{"id":"blk-8769","kind":"paragraph","spans":[{"id":"spn-8284","text":"A concrete "},{"id":"spn-8285","marks":["code"],"text":"ampersand.json"},{"id":"spn-8286","text":" fragment:"}]},{"id":"blk-8770","kind":"code","language":"json","text":"{\n  \"&govern.escalation\": {\n    \"provider\": \"opensentience\",\n    \"config\": {\n      \"timeout_seconds\": 3600,\n      \"fallback_threshold\": 0.85\n    }\n  }\n}"},{"id":"blk-8771","kind":"paragraph","spans":[{"id":"spn-8287","text":"A fuller declaration:"}]},{"id":"blk-8772","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"InfraRemediation\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&reason.plan\": {\n      \"provider\": \"auto\",\n      \"need\": \"infrastructure remediation planning with policy-aware tradeoffs\"\n    },\n    \"&govern.escalation\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"timeout_seconds\": 3600,\n        \"fallback_threshold\": 0.85\n      }\n    },\n    \"&govern.telemetry\": {\n      \"provider\": \"opensentience\",\n      \"config\": {\n        \"emit_all_operations\": true\n      }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\n      \"Never deploy to production without human approval\",\n      \"Never modify security groups without escalation\"\n    ],\n    \"soft\": [\n      \"Prefer least-disruption remediation paths\"\n    ],\n    \"escalate_when\": {\n      \"confidence_below\": 0.75,\n      \"cost_exceeds_usd\": 500,\n      \"hard_boundary_approached\": true,\n      \"policy_requires_approval\": [\"deploy\", \"security_modify\"]\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-8773","kind":"heading","level":2,"spans":[{"id":"spn-8288","text":"13. Governance and provenance implications"}]},{"id":"blk-8774","kind":"paragraph","spans":[{"id":"spn-8289","text":"Escalation events are themselves governance artifacts and must participate in the provenance chain."}]},{"id":"blk-8775","kind":"heading","level":3,"spans":[{"id":"spn-8290","text":"Cross-references"}]},{"id":"blk-8776","items":[{"blocks":[{"id":"blk-8778","kind":"paragraph","spans":[{"id":"spn-8291","marks":["bold"],"text":"OpenSentience OS-006"},{"id":"spn-8292","text":": defines autonomy levels (observe, advise, act) that determine escalation behavior and timeout semantics"}]}],"id":"blk-8777","kind":"list-item"},{"blocks":[{"id":"blk-8780","kind":"paragraph","spans":[{"id":"spn-8293","marks":["bold"],"text":"OpenSentience OS-007"},{"id":"spn-8294","text":": addresses threat model for agent impersonation — escalation requests must be attributable to verified agent identities via "},{"id":"spn-8295","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-8779","kind":"list-item"},{"blocks":[{"id":"blk-8782","kind":"paragraph","spans":[{"id":"spn-8296","marks":["bold"],"text":"Delegatic budget policies"},{"id":"spn-8297","text":": cost-based escalation triggers are derived from Delegatic org-level and agent-level budget limits"}]}],"id":"blk-8781","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8783","kind":"heading","level":3,"spans":[{"id":"spn-8298","text":"Representative provenance record"}]},{"id":"blk-8784","kind":"code","language":"json","text":"{\n  \"source\": \"&govern.escalation\",\n  \"provider\": \"opensentience\",\n  \"operation\": \"escalate\",\n  \"timestamp\": \"2026-03-15T12:00:00Z\",\n  \"escalation_id\": \"esc-01JQ7...\",\n  \"trigger\": \"confidence_below\",\n  \"trigger_detail\": {\n    \"confidence\": 0.62,\n    \"threshold\": 0.75\n  },\n  \"decision\": \"approve\",\n  \"responder\": \"ops-lead-42\",\n  \"mcp_trace_id\": \"os-esc-301\"\n}"},{"id":"blk-8785","kind":"paragraph","spans":[{"id":"spn-8299","text":"This matters because escalation decisions can fundamentally alter the execution path."}]},{"id":"blk-8786","kind":"paragraph","spans":[{"id":"spn-8300","text":"Provenance should help answer questions like:"}]},{"id":"blk-8787","items":[{"blocks":[{"id":"blk-8789","kind":"paragraph","spans":[{"id":"spn-8301","text":"Why was this action escalated instead of executed directly?"}]}],"id":"blk-8788","kind":"list-item"},{"blocks":[{"id":"blk-8791","kind":"paragraph","spans":[{"id":"spn-8302","text":"Which trigger condition fired?"}]}],"id":"blk-8790","kind":"list-item"},{"blocks":[{"id":"blk-8793","kind":"paragraph","spans":[{"id":"spn-8303","text":"Who approved or rejected it, and when?"}]}],"id":"blk-8792","kind":"list-item"},{"blocks":[{"id":"blk-8795","kind":"paragraph","spans":[{"id":"spn-8304","text":"Did the action execute under timeout-based auto-approval?"}]}],"id":"blk-8794","kind":"list-item"},{"blocks":[{"id":"blk-8797","kind":"paragraph","spans":[{"id":"spn-8305","text":"Which Delegatic budget policy caused the cost-based trigger?"}]}],"id":"blk-8796","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8798","kind":"heading","level":2,"spans":[{"id":"spn-8306","text":"14. Compatible providers"}]},{"id":"blk-8799","kind":"paragraph","spans":[{"id":"spn-8307","text":"Representative compatible providers include:"}]},{"id":"blk-8800","items":[{"blocks":[{"id":"blk-8802","kind":"paragraph","spans":[{"id":"spn-8308","marks":["code"],"text":"opensentience"},{"id":"spn-8309","text":" (primary runtime provider for escalation bridge)"}]}],"id":"blk-8801","kind":"list-item"},{"blocks":[{"id":"blk-8804","kind":"paragraph","spans":[{"id":"spn-8310","marks":["code"],"text":"delegatic"},{"id":"spn-8311","text":" (policy source for cost and approval thresholds)"}]}],"id":"blk-8803","kind":"list-item"},{"blocks":[{"id":"blk-8806","kind":"paragraph","spans":[{"id":"spn-8312","text":"custom human-review UX systems exposed behind MCP-compatible surfaces"}]}],"id":"blk-8805","kind":"list-item"},{"blocks":[{"id":"blk-8808","kind":"paragraph","spans":[{"id":"spn-8313","text":"enterprise approval workflow engines with structured response semantics"}]}],"id":"blk-8807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8809","kind":"heading","level":3,"spans":[{"id":"spn-8314","text":"Default ecosystem fit"}]},{"id":"blk-8810","kind":"paragraph","spans":[{"id":"spn-8315","text":"The most natural default ecosystem pairing is:"}]},{"id":"blk-8811","items":[{"blocks":[{"id":"blk-8813","kind":"paragraph","spans":[{"id":"spn-8316","marks":["code"],"text":"opensentience"},{"id":"spn-8317","text":" for the escalation runtime"}]}],"id":"blk-8812","kind":"list-item"},{"blocks":[{"id":"blk-8815","kind":"paragraph","spans":[{"id":"spn-8318","marks":["code"],"text":"delegatic"},{"id":"spn-8319","text":" for the policy definitions that trigger escalation"}]}],"id":"blk-8814","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8816","kind":"paragraph","spans":[{"id":"spn-8320","text":"Why they fit together:"}]},{"id":"blk-8817","items":[{"blocks":[{"id":"blk-8819","kind":"paragraph","spans":[{"id":"spn-8321","text":"OpenSentience defines autonomy levels and timeout semantics"}]}],"id":"blk-8818","kind":"list-item"},{"blocks":[{"id":"blk-8821","kind":"paragraph","spans":[{"id":"spn-8322","text":"Delegatic defines org-level budget and approval policies"}]}],"id":"blk-8820","kind":"list-item"},{"blocks":[{"id":"blk-8823","kind":"paragraph","spans":[{"id":"spn-8323","text":"Together they form the complete escalation governance stack"}]}],"id":"blk-8822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8824","kind":"paragraph","spans":[{"id":"spn-8324","text":"The protocol stance remains:"}]},{"blocks":[{"id":"blk-8826","kind":"paragraph","spans":[{"id":"spn-8325","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8326","text":" is the capability. "},{"id":"spn-8327","marks":["code"],"text":"opensentience"},{"id":"spn-8328","text":" is one provider that may satisfy it."}]}],"id":"blk-8825","kind":"quote"},{"id":"blk-8827","kind":"heading","level":2,"spans":[{"id":"spn-8329","text":"15. A2A-facing skills"}]},{"id":"blk-8828","kind":"paragraph","spans":[{"id":"spn-8330","text":"A "},{"id":"spn-8331","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8332","text":" capability may advertise skills such as:"}]},{"id":"blk-8829","items":[{"blocks":[{"id":"blk-8831","kind":"paragraph","spans":[{"id":"spn-8333","marks":["code"],"text":"human-escalation-bridge"}]}],"id":"blk-8830","kind":"list-item"},{"blocks":[{"id":"blk-8833","kind":"paragraph","spans":[{"id":"spn-8334","marks":["code"],"text":"approval-workflow"}]}],"id":"blk-8832","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8834","kind":"paragraph","spans":[{"id":"spn-8335","text":"These are useful when generating A2A-style agent cards, because they let an external coordination surface say more than \"has escalation support.\""}]},{"id":"blk-8835","kind":"paragraph","spans":[{"id":"spn-8336","text":"Instead, it can say the agent can:"}]},{"id":"blk-8836","items":[{"blocks":[{"id":"blk-8838","kind":"paragraph","spans":[{"id":"spn-8337","text":"bridge decisions to human operators when governance thresholds are crossed"}]}],"id":"blk-8837","kind":"list-item"},{"blocks":[{"id":"blk-8840","kind":"paragraph","spans":[{"id":"spn-8338","text":"participate in structured approval workflows with approve/reject/modify semantics"}]}],"id":"blk-8839","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8841","kind":"heading","level":2,"spans":[{"id":"spn-8339","text":"16. Anti-patterns"}]},{"id":"blk-8842","kind":"heading","level":3,"spans":[{"id":"spn-8340","text":"Anti-pattern 1: treat escalation as error handling"}]},{"id":"blk-8843","kind":"paragraph","spans":[{"id":"spn-8341","text":"Escalation is a governance mechanism, not an exception path. Agents that only escalate on errors miss the core purpose: structured human oversight of normal decisions that cross thresholds."}]},{"id":"blk-8844","kind":"heading","level":3,"spans":[{"id":"spn-8342","text":"Anti-pattern 2: escalate everything"}]},{"id":"blk-8845","kind":"paragraph","spans":[{"id":"spn-8343","text":"If every action is escalated, the human operator becomes a bottleneck and trust in the agent degrades. Escalation thresholds should be calibrated to surface only meaningful decisions."}]},{"id":"blk-8846","kind":"heading","level":3,"spans":[{"id":"spn-8344","text":"Anti-pattern 3: ignore timeout semantics"}]},{"id":"blk-8847","kind":"paragraph","spans":[{"id":"spn-8345","text":"Timeout behavior varies by autonomy level for good reasons. Implementing a single timeout policy across all levels defeats the purpose of differentiated autonomy."}]},{"id":"blk-8848","kind":"heading","level":3,"spans":[{"id":"spn-8346","text":"Anti-pattern 4: escalate without context"}]},{"id":"blk-8849","kind":"paragraph","spans":[{"id":"spn-8347","text":"An escalation request without rationale, confidence scores, or trigger details forces the human to reconstruct the decision context. Always include the agent's reasoning and the specific trigger condition."}]},{"id":"blk-8850","kind":"heading","level":3,"spans":[{"id":"spn-8348","text":"Anti-pattern 5: skip provenance on auto-approved timeouts"}]},{"id":"blk-8851","kind":"paragraph","spans":[{"id":"spn-8349","text":"When an act-mode agent auto-approves on timeout, the audit trail is especially important. Skipping provenance on these events creates governance blind spots."}]},{"id":"blk-8852","kind":"heading","level":2,"spans":[{"id":"spn-8350","text":"17. Summary"}]},{"id":"blk-8853","kind":"paragraph","spans":[{"id":"spn-8351","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8352","text":" is the [&] Protocol capability for "},{"id":"spn-8353","marks":["bold"],"text":"governance-mandated decision handoff"},{"id":"spn-8354","text":"."}]},{"id":"blk-8854","kind":"paragraph","spans":[{"id":"spn-8355","text":"It is the right capability when an agent needs to:"}]},{"id":"blk-8855","items":[{"blocks":[{"id":"blk-8857","kind":"paragraph","spans":[{"id":"spn-8356","text":"pause before executing actions that cross confidence, cost, or policy thresholds"}]}],"id":"blk-8856","kind":"list-item"},{"blocks":[{"id":"blk-8859","kind":"paragraph","spans":[{"id":"spn-8357","text":"present proposed actions to human operators with full context"}]}],"id":"blk-8858","kind":"list-item"},{"blocks":[{"id":"blk-8861","kind":"paragraph","spans":[{"id":"spn-8358","text":"handle timeout behavior differently based on autonomy level"}]}],"id":"blk-8860","kind":"list-item"},{"blocks":[{"id":"blk-8863","kind":"paragraph","spans":[{"id":"spn-8359","text":"maintain auditable records of every escalation lifecycle"}]}],"id":"blk-8862","kind":"list-item"},{"blocks":[{"id":"blk-8865","kind":"paragraph","spans":[{"id":"spn-8360","text":"compose escalation with reasoning, telemetry, and identity capabilities"}]}],"id":"blk-8864","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-8866","kind":"paragraph","spans":[{"id":"spn-8361","text":"In one sentence:"}]},{"blocks":[{"id":"blk-8868","kind":"paragraph","spans":[{"id":"spn-8362","marks":["code"],"text":"&govern.escalation"},{"id":"spn-8363","text":" gives an agent a protocol-native way to hand off decisions to humans when governance thresholds require it."}]}],"id":"blk-8867","kind":"quote"}],"edges":[],"id":"bagaaiera5g3zxhldvarf6kmr4mvowuzyl6bubdzrw2aj3mjdjy2l34nlgndq","vocabulary":"ampersand.docs.fs.v1"}