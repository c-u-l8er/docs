{"bendscript":"0.1","blocks":[{"id":"blk-40031","kind":"heading","level":1,"spans":[{"id":"spn-44619","text":"Graphonomous npm Publishing + Maintenance Runbook (Manual-First)"}]},{"id":"blk-40032","kind":"paragraph","spans":[{"id":"spn-44620","text":"This runbook is the "},{"id":"spn-44621","marks":["bold"],"text":"manual release path"},{"id":"spn-44622","text":" for publishing "},{"id":"spn-44623","marks":["code"],"text":"graphonomous"},{"id":"spn-44624","text":" without relying on long-lived CI publish credentials."}]},{"id":"blk-40033","kind":"paragraph","spans":[{"id":"spn-44625","text":"It is designed for the reality that npm credentials/tokens may rotate or expire frequently."}]},{"id":"blk-40034","kind":"paragraph","spans":[{"id":"spn-44626","text":"---"}]},{"id":"blk-40035","kind":"heading","level":2,"spans":[{"id":"spn-44627","text":"1) Goal"}]},{"id":"blk-40036","kind":"paragraph","spans":[{"id":"spn-44628","text":"Publish Graphonomous so users can run:"}]},{"id":"blk-40037","items":[{"blocks":[{"id":"blk-40039","kind":"paragraph","spans":[{"id":"spn-44629","marks":["code"],"text":"npx graphonomous --help"}]}],"id":"blk-40038","kind":"list-item"},{"blocks":[{"id":"blk-40041","kind":"paragraph","spans":[{"id":"spn-44630","marks":["code"],"text":"npm i -g graphonomous"}]}],"id":"blk-40040","kind":"list-item"},{"blocks":[{"id":"blk-40043","kind":"paragraph","spans":[{"id":"spn-44631","marks":["code"],"text":"graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]}],"id":"blk-40042","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40044","kind":"paragraph","spans":[{"id":"spn-44632","text":"while keeping the Elixir implementation as source of truth."}]},{"id":"blk-40045","kind":"paragraph","spans":[{"id":"spn-44633","text":"---"}]},{"id":"blk-40046","kind":"heading","level":2,"spans":[{"id":"spn-44634","text":"2) Principles"}]},{"id":"blk-40047","kind":"paragraph","spans":[{"id":"spn-44635","text":"1. "},{"id":"spn-44636","marks":["bold"],"text":"Manual over automated publish"}]},{"id":"blk-40048","items":[{"blocks":[{"id":"blk-40050","kind":"paragraph","spans":[{"id":"spn-44637","text":"You run the release and npm publish commands locally."}]}],"id":"blk-40049","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40051","kind":"paragraph","spans":[{"id":"spn-44638","text":"2. "},{"id":"spn-44639","marks":["bold"],"text":"No dependency on permanent CI tokens"}]},{"id":"blk-40052","items":[{"blocks":[{"id":"blk-40054","kind":"paragraph","spans":[{"id":"spn-44640","text":"No long-lived npm automation token required."}]}],"id":"blk-40053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40055","kind":"paragraph","spans":[{"id":"spn-44641","text":"3. "},{"id":"spn-44642","marks":["bold"],"text":"Version parity is strict"}]},{"id":"blk-40056","items":[{"blocks":[{"id":"blk-40058","kind":"paragraph","spans":[{"id":"spn-44643","marks":["code"],"text":"mix.exs"},{"id":"spn-44644","text":", "},{"id":"spn-44645","marks":["code"],"text":"npm/package.json"},{"id":"spn-44646","text":", git tag, and release assets must all match."}]}],"id":"blk-40057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40059","kind":"paragraph","spans":[{"id":"spn-44647","text":"4. "},{"id":"spn-44648","marks":["bold"],"text":"Never overwrite versions"}]},{"id":"blk-40060","items":[{"blocks":[{"id":"blk-40062","kind":"paragraph","spans":[{"id":"spn-44649","text":"npm versions are immutable once published."}]}],"id":"blk-40061","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40063","kind":"paragraph","spans":[{"id":"spn-44650","text":"---"}]},{"id":"blk-40064","kind":"heading","level":2,"spans":[{"id":"spn-44651","text":"3) Required Local Tooling"}]},{"id":"blk-40065","items":[{"blocks":[{"id":"blk-40067","kind":"paragraph","spans":[{"id":"spn-44652","text":"Elixir "},{"id":"spn-44653","marks":["code"],"text":"1.17.x"}]}],"id":"blk-40066","kind":"list-item"},{"blocks":[{"id":"blk-40069","kind":"paragraph","spans":[{"id":"spn-44654","text":"Erlang/OTP "},{"id":"spn-44655","marks":["code"],"text":"27.x"}]}],"id":"blk-40068","kind":"list-item"},{"blocks":[{"id":"blk-40071","kind":"paragraph","spans":[{"id":"spn-44656","text":"Node.js "},{"id":"spn-44657","marks":["code"],"text":">= 18"}]}],"id":"blk-40070","kind":"list-item"},{"blocks":[{"id":"blk-40073","kind":"paragraph","spans":[{"id":"spn-44658","text":"npm account with publish permission"}]}],"id":"blk-40072","kind":"list-item"},{"blocks":[{"id":"blk-40075","kind":"paragraph","spans":[{"id":"spn-44659","marks":["code"],"text":"git"}]}],"id":"blk-40074","kind":"list-item"},{"blocks":[{"id":"blk-40077","kind":"paragraph","spans":[{"id":"spn-44660","marks":["code"],"text":"tar"},{"id":"spn-44661","text":" (for packaging release assets)"}]}],"id":"blk-40076","kind":"list-item"},{"blocks":[{"id":"blk-40079","kind":"paragraph","spans":[{"id":"spn-44662","text":"Optional: "},{"id":"spn-44663","marks":["code"],"text":"gh"},{"id":"spn-44664","text":" CLI (otherwise use GitHub web UI)"}]}],"id":"blk-40078","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40080","kind":"paragraph","spans":[{"id":"spn-44665","text":"---"}]},{"id":"blk-40081","kind":"heading","level":2,"spans":[{"id":"spn-44666","text":"4) One-Time Setup"}]},{"id":"blk-40082","kind":"heading","level":2,"spans":[{"id":"spn-44667","text":"4.1 npm auth"}]},{"id":"blk-40083","items":[{"blocks":[{"id":"blk-40085","kind":"paragraph","spans":[{"id":"spn-44668","text":"Run "},{"id":"spn-44669","marks":["code"],"text":"npm login"}]}],"id":"blk-40084","kind":"list-item"},{"blocks":[{"id":"blk-40087","kind":"paragraph","spans":[{"id":"spn-44670","text":"Verify with "},{"id":"spn-44671","marks":["code"],"text":"npm whoami"}]}],"id":"blk-40086","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40088","kind":"paragraph","spans":[{"id":"spn-44672","text":"If your org/package requires 2FA, keep your authenticato