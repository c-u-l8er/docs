":[{"id":"spn-44711","text":"6.3 Quality checks"}]},{"id":"blk-40126","kind":"paragraph","spans":[{"id":"spn-44712","text":"mix deps.get mix format --check-formatted mix compile --warnings-as-errors mix test"}]},{"id":"blk-40127","kind":"heading","level":2,"spans":[{"id":"spn-44713","text":"6.4 Build OTP release locally"}]},{"id":"blk-40128","kind":"paragraph","spans":[{"id":"spn-44714","text":"MIX_ENV=prod mix release --overwrite"}]},{"id":"blk-40129","kind":"paragraph","spans":[{"id":"spn-44715","text":"Sanity check command path: _build/prod/rel/graphonomous/bin/graphonomous version"}]},{"id":"blk-40130","kind":"paragraph","spans":[{"id":"spn-44716","text":"CLI sanity check via eval entrypoint: _build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"}]},{"id":"blk-40131","kind":"heading","level":2,"spans":[{"id":"spn-44717","text":"6.5 Create release assets locally"}]},{"id":"blk-40132","kind":"paragraph","spans":[{"id":"spn-44718","text":"Example for your current machine target: VERSION=X.Y.Z TARGET=linux-x64 mkdir -p dist tar -czf \"dist/graphonomous-v${VERSION}-${TARGET}.tar.gz\" -C \"_build/prod/rel\" graphonomous"}]},{"id":"blk-40133","kind":"paragraph","spans":[{"id":"spn-44719","text":"Repeat on each required OS/arch machine to produce all target artifacts:"}]},{"id":"blk-40134","items":[{"blocks":[{"id":"blk-40136","kind":"paragraph","spans":[{"id":"spn-44720","text":"linux x64"}]}],"id":"blk-40135","kind":"list-item"},{"blocks":[{"id":"blk-40138","kind":"paragraph","spans":[{"id":"spn-44721","text":"linux arm64"}]}],"id":"blk-40137","kind":"list-item"},{"blocks":[{"id":"blk-40140","kind":"paragraph","spans":[{"id":"spn-44722","text":"macOS x64"}]}],"id":"blk-40139","kind":"list-item"},{"blocks":[{"id":"blk-40142","kind":"paragraph","spans":[{"id":"spn-44723","text":"macOS arm64"}]}],"id":"blk-40141","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40143","kind":"heading","level":2,"spans":[{"id":"spn-44724","text":"6.6 Commit + tag"}]},{"id":"blk-40144","kind":"paragraph","spans":[{"id":"spn-44725","text":"git add . git commit -m \"release: vX.Y.Z\" git tag vX.Y.Z git push origin release/vX.Y.Z git push origin vX.Y.Z"}]},{"id":"blk-40145","kind":"heading","level":2,"spans":[{"id":"spn-44726","text":"6.7 Create GitHub Release manually"}]},{"id":"blk-40146","kind":"paragraph","spans":[{"id":"spn-44727","text":"Option A: GitHub Web UI 1. Open Releases → Draft new release 2. Tag: "},{"id":"spn-44728","marks":["code"],"text":"vX.Y.Z"},{"id":"spn-44729","text":" 3. Title: "},{"id":"spn-44730","marks":["code"],"text":"vX.Y.Z"},{"id":"spn-44731","text":" 4. Upload all "},{"id":"spn-44732","marks":["code"],"text":"dist/*.tar.gz"},{"id":"spn-44733","text":" assets 5. Publish release"}]},{"id":"blk-40147","kind":"paragraph","spans":[{"id":"spn-44734","text":"Option B: "},{"id":"spn-44735","marks":["code"],"text":"gh"},{"id":"spn-44736","text":" CLI gh release create \"vX.Y.Z\" dist/*.tar.gz --title \"vX.Y.Z\" --notes \"Manual release\""}]},{"id":"blk-40148","kind":"paragraph","spans":[{"id":"spn-44737","text":"Verify uploaded assets match naming convention exactly."}]},{"id":"blk-40149","kind":"heading","level":2,"spans":[{"id":"spn-44738","text":"6.8 npm pre-publish smoke test (local)"}]},{"id":"blk-40150","kind":"paragraph","spans":[{"id":"spn-44739","text":"From "},{"id":"spn-44740","marks":["code"],"text":"npm/"},{"id":"spn-44741","text":": cd npm npm pack --dry-run npm pack"}]},{"id":"blk-40151","kind":"paragraph","spans":[{"id":"spn-44742","text":"In a temporary directory: mkdir -p /tmp/graphonomous-npm-smoke cd /tmp/graphonomous-npm-smoke npm init -y npm i /absolute/path/to/ProjectAmp2/graphonomous/npm/graphonomous-X.Y.Z.tgz npx graphonomous --help"}]},{"id":"blk-40152","kind":"heading","level":2,"spans":[{"id":"spn-44743","text":"6.9 Publish npm manually (local machine)"}]},{"id":"blk-40153","kind":"paragraph","spans":[{"id":"spn-44744","text":"From "},{"id":"spn-44745","marks":["code"],"text":"ProjectAmp2/graphonomous/npm"},{"id":"spn-44746","text":": npm publish --access public"}]},{"id":"blk-40154","kind":"paragraph","spans":[{"id":"spn-44747","text":"If 2FA is enabled, complete OTP prompt."}]},{"id":"blk-40155","kind":"heading","level":2,"spans":[{"id":"spn-44748","text":"6.10 Post-publish verification"}]},{"id":"blk-40156","kind":"paragraph","spans":[{"id":"spn-44749","text":"npm view graphonomous version npx -y graphonomous --help npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-40157","kind":"paragraph","spans":[{"id":"spn-44750","text":"---"}]},{"id":"blk-40158","kind":"heading","level":2,"spans":[{"id":"spn-44751","text":"7) Zed Config (npm-installed command)"}]},{"id":"blk-40159","kind":"paragraph","spans":[{"id":"spn-44752","text":"Use in Zed settings JSON:"}]},{"id":"blk-40160","kind":"paragraph","spans":[{"id":"spn-44753","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"graphonomous\", \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\" } } } }"}]},{"id":"blk-40161","kind":"paragraph","spans":[{"id":"spn-44754","text":"Or one-off via "},{"id":"spn-44755","marks":["code"],"text":"npx"},{"id":"spn-44756","text":":"}]},{"id":"blk-40162","kind":"paragraph","spans":[{"id":"spn-44757","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": {} } } }"}]},{"id":"blk-40163","kind":"paragraph","spans":[{"id":"spn-44758","text":"---"}]},{"id":"blk-40164","kind":"heading","level":2,"spans":[{"id":"spn-44759","text":"8) Maintenance Routine"}]},{"id":"blk-40165","kind":"paragraph","spans":[{"id":"spn-44760","text":"For each shipped change: 1. Update "},{"id":"spn-44761","marks":["code"],