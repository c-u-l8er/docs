":[{"id":"spn-45885","text":"6.3 Quality checks"}]},{"id":"blk-40612","kind":"paragraph","spans":[{"id":"spn-45886","text":"mix deps.get mix format --check-formatted mix compile --warnings-as-errors mix test"}]},{"id":"blk-40613","kind":"heading","level":2,"spans":[{"id":"spn-45887","text":"6.4 Build OTP release locally"}]},{"id":"blk-40614","kind":"paragraph","spans":[{"id":"spn-45888","text":"MIX_ENV=prod mix release --overwrite"}]},{"id":"blk-40615","kind":"paragraph","spans":[{"id":"spn-45889","text":"Sanity check command path: _build/prod/rel/graphonomous/bin/graphonomous version"}]},{"id":"blk-40616","kind":"paragraph","spans":[{"id":"spn-45890","text":"CLI sanity check via eval entrypoint: _build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"}]},{"id":"blk-40617","kind":"heading","level":2,"spans":[{"id":"spn-45891","text":"6.5 Create release assets locally"}]},{"id":"blk-40618","kind":"paragraph","spans":[{"id":"spn-45892","text":"Example for your current machine target: VERSION=X.Y.Z TARGET=linux-x64 mkdir -p dist tar -czf \"dist/graphonomous-v${VERSION}-${TARGET}.tar.gz\" -C \"_build/prod/rel\" graphonomous"}]},{"id":"blk-40619","kind":"paragraph","spans":[{"id":"spn-45893","text":"Repeat on each required OS/arch machine to produce all target artifacts:"}]},{"id":"blk-40620","items":[{"blocks":[{"id":"blk-40622","kind":"paragraph","spans":[{"id":"spn-45894","text":"linux x64"}]}],"id":"blk-40621","kind":"list-item"},{"blocks":[{"id":"blk-40624","kind":"paragraph","spans":[{"id":"spn-45895","text":"linux arm64"}]}],"id":"blk-40623","kind":"list-item"},{"blocks":[{"id":"blk-40626","kind":"paragraph","spans":[{"id":"spn-45896","text":"macOS x64"}]}],"id":"blk-40625","kind":"list-item"},{"blocks":[{"id":"blk-40628","kind":"paragraph","spans":[{"id":"spn-45897","text":"macOS arm64"}]}],"id":"blk-40627","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40629","kind":"heading","level":2,"spans":[{"id":"spn-45898","text":"6.6 Commit + tag"}]},{"id":"blk-40630","kind":"paragraph","spans":[{"id":"spn-45899","text":"git add . git commit -m \"release: vX.Y.Z\" git tag vX.Y.Z git push origin release/vX.Y.Z git push origin vX.Y.Z"}]},{"id":"blk-40631","kind":"heading","level":2,"spans":[{"id":"spn-45900","text":"6.7 Create GitHub Release manually"}]},{"id":"blk-40632","kind":"paragraph","spans":[{"id":"spn-45901","text":"Option A: GitHub Web UI 1. Open Releases → Draft new release 2. Tag: "},{"id":"spn-45902","marks":["code"],"text":"vX.Y.Z"},{"id":"spn-45903","text":" 3. Title: "},{"id":"spn-45904","marks":["code"],"text":"vX.Y.Z"},{"id":"spn-45905","text":" 4. Upload all "},{"id":"spn-45906","marks":["code"],"text":"dist/*.tar.gz"},{"id":"spn-45907","text":" assets 5. Publish release"}]},{"id":"blk-40633","kind":"paragraph","spans":[{"id":"spn-45908","text":"Option B: "},{"id":"spn-45909","marks":["code"],"text":"gh"},{"id":"spn-45910","text":" CLI gh release create \"vX.Y.Z\" dist/*.tar.gz --title \"vX.Y.Z\" --notes \"Manual release\""}]},{"id":"blk-40634","kind":"paragraph","spans":[{"id":"spn-45911","text":"Verify uploaded assets match naming convention exactly."}]},{"id":"blk-40635","kind":"heading","level":2,"spans":[{"id":"spn-45912","text":"6.8 npm pre-publish smoke test (local)"}]},{"id":"blk-40636","kind":"paragraph","spans":[{"id":"spn-45913","text":"From "},{"id":"spn-45914","marks":["code"],"text":"npm/"},{"id":"spn-45915","text":": cd npm npm pack --dry-run npm pack"}]},{"id":"blk-40637","kind":"paragraph","spans":[{"id":"spn-45916","text":"In a temporary directory: mkdir -p /tmp/graphonomous-npm-smoke cd /tmp/graphonomous-npm-smoke npm init -y npm i /absolute/path/to/ProjectAmp2/graphonomous/npm/graphonomous-X.Y.Z.tgz npx graphonomous --help"}]},{"id":"blk-40638","kind":"heading","level":2,"spans":[{"id":"spn-45917","text":"6.9 Publish npm manually (local machine)"}]},{"id":"blk-40639","kind":"paragraph","spans":[{"id":"spn-45918","text":"From "},{"id":"spn-45919","marks":["code"],"text":"ProjectAmp2/graphonomous/npm"},{"id":"spn-45920","text":": npm publish --access public"}]},{"id":"blk-40640","kind":"paragraph","spans":[{"id":"spn-45921","text":"If 2FA is enabled, complete OTP prompt."}]},{"id":"blk-40641","kind":"heading","level":2,"spans":[{"id":"spn-45922","text":"6.10 Post-publish verification"}]},{"id":"blk-40642","kind":"paragraph","spans":[{"id":"spn-45923","text":"npm view graphonomous version npx -y graphonomous --help npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-40643","kind":"paragraph","spans":[{"id":"spn-45924","text":"---"}]},{"id":"blk-40644","kind":"heading","level":2,"spans":[{"id":"spn-45925","text":"7) Zed Config (npm-installed command)"}]},{"id":"blk-40645","kind":"paragraph","spans":[{"id":"spn-45926","text":"Use in Zed settings JSON:"}]},{"id":"blk-40646","kind":"paragraph","spans":[{"id":"spn-45927","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"graphonomous\", \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\" } } } }"}]},{"id":"blk-40647","kind":"paragraph","spans":[{"id":"spn-45928","text":"Or one-off via "},{"id":"spn-45929","marks":["code"],"text":"npx"},{"id":"spn-45930","text":":"}]},{"id":"blk-40648","kind":"paragraph","spans":[{"id":"spn-45931","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": {} } } }"}]},{"id":"blk-40649","kind":"paragraph","spans":[{"id":"spn-45932","text":"---"}]},{"id":"blk-40650","kind":"heading","level":2,"spans":[{"id":"spn-45933","text":"8) Maintenance Routine"}]},{"id":"blk-40651","kind":"paragraph","spans":[{"id":"spn-45934","text":"For each shipped change: 1. Update "},{"id":"spn-45935","marks":["code"],"text":"PROGRESS.md"},{"id":"spn-45936","text":". 2. Update root "},{"id":"spn-45937","marks":["code"],"text":"README.md"},{"id":"spn-45938","text":" user docs. 3. Update "},{"id":"spn-45939","marks":["code"],"text":"docs/ZED.md"},{"id":"spn-45940","text":" if editor setup changed. 4. If CLI args changed, update:"}]},{"id":"blk-40652","items":[{"blocks":[{"id":"blk-40654","kind":"paragraph","spans":[{"id":"spn-45941","marks":["code"],"text":"Graphonomous.CLI"},{"id":"spn-45942","text":" help text"}]}],"id":"blk-40653","kind":"list-item"},{"blocks":[{"id":"blk-40656","kind":"paragraph","spans":[{"id":"spn-45943","marks":["code"],"text":"npm/README.md"}]}],"id":"blk-40655","kind":"list-item"},{"blocks":[{"id":"blk-40658","kind":"paragraph","spans":[{"id":"spn-45944","text":"this runbook if needed"}]}],"id":"blk-40657","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40659","kind":"paragraph","spans":[{"id":"spn-45945","text":"5. Cut next SemVer release ("},{"id":"spn-45946","marks":["code"],"text":"X.Y.Z"},{"id":"spn-45947","text":")."}]},{"id":"blk-40660","kind":"paragraph","spans":[{"id":"spn-45948","text":"Monthly:"}]},{"id":"blk-40661","items":[{"blocks":[{"id":"blk-40663","kind":"paragraph","spans":[{"id":"spn-45949","text":"Test "},{"id":"spn-45950","marks":["code"],"text":"npx -y graphonomous --help"},{"id":"spn-45951","text":" on Linux + macOS."}]}],"id":"blk-40662","kind":"list-item"},{"blocks":[{"id":"blk-40665","kind":"paragraph","spans":[{"id":"spn-45952","text":"Verify GitHub release assets are accessible."}]}],"id":"blk-40664","kind":"list-item"},{"blocks":[{"id":"blk-40667","kind":"paragraph","spans":[{"id":"spn-45953","text":"Verify fresh npm install works."}]}],"id":"blk-40666","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40668","kind":"paragraph","spans":[{"id":"spn-45954","text":"---"}]},{"id":"blk-40669","kind":"heading","level":2,"spans":[{"id":"spn-45955","text":"9) Rollback / Hotfix Policy"}]},{"id":"blk-40670","k