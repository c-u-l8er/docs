{"bendscript":"0.1","blocks":[{"id":"blk-71713","kind":"heading","level":1,"spans":[{"id":"spn-134087","text":"Graphonomous npm Publishing + Maintenance Runbook (Manual-First)"}]},{"id":"blk-71714","kind":"paragraph","spans":[{"id":"spn-134088","text":"This runbook is the "},{"id":"spn-134089","marks":["bold"],"text":"manual release path"},{"id":"spn-134090","text":" for publishing "},{"id":"spn-134091","marks":["code"],"text":"graphonomous"},{"id":"spn-134092","text":" without relying on long-lived CI publish credentials."}]},{"id":"blk-71715","kind":"paragraph","spans":[{"id":"spn-134093","text":"It is designed for the reality that npm credentials/tokens may rotate or expire frequently."}]},{"id":"blk-71716","kind":"heading","level":2,"spans":[{"id":"spn-134094","text":"1) Goal"}]},{"id":"blk-71717","kind":"paragraph","spans":[{"id":"spn-134095","text":"Publish Graphonomous so users can run:"}]},{"id":"blk-71718","items":[{"blocks":[{"id":"blk-71720","kind":"paragraph","spans":[{"id":"spn-134096","marks":["code"],"text":"npx graphonomous --help"}]}],"id":"blk-71719","kind":"list-item"},{"blocks":[{"id":"blk-71722","kind":"paragraph","spans":[{"id":"spn-134097","marks":["code"],"text":"npm i -g graphonomous"}]}],"id":"blk-71721","kind":"list-item"},{"blocks":[{"id":"blk-71724","kind":"paragraph","spans":[{"id":"spn-134098","marks":["code"],"text":"graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]}],"id":"blk-71723","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71725","kind":"paragraph","spans":[{"id":"spn-134099","text":"while keeping the Elixir implementation as source of truth."}]},{"id":"blk-71726","kind":"heading","level":2,"spans":[{"id":"spn-134100","text":"2) Principles"}]},{"id":"blk-71727","items":[{"blocks":[{"id":"blk-71729","kind":"paragraph","spans":[{"id":"spn-134101","marks":["bold"],"text":"Manual over automated publish"}]}],"id":"blk-71728","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71