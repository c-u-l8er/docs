h","spans":[{"id":"spn-47090","text":"---"}]},{"id":"blk-41174","kind":"heading","level":2,"spans":[{"id":"spn-47091","text":"11) Minimal Command Cheat Sheet"}]},{"id":"blk-41175","kind":"paragraph","spans":[{"id":"spn-47092","text":"From repo root: mix deps.get mix format --check-formatted mix compile --warnings-as-errors mix test MIX_ENV=prod mix release --overwrite"}]},{"id":"blk-41176","kind":"paragraph","spans":[{"id":"spn-47093","text":"Asset packaging: VERSION=X.Y.Z TARGET=linux-x64 mkdir -p dist tar -czf \"dist/graphonomous-v${VERSION}-${TARGET}.tar.gz\" -C \"_build/prod/rel\" graphonomous"}]},{"id":"blk-41177","kind":"paragraph","spans":[{"id":"spn-47094","text":"Tagging: git tag vX.Y.Z git push origin vX.Y.Z"}]},{"id":"blk-41178","kind":"paragraph","spans":[{"id":"spn-47095","text":"npm publish (manual): cd npm npm pack --dry-run npm publish --access public npm view graphonomous version"}]},{"id":"blk-41179","kind":"paragraph","spans":[{"id":"spn-47096","text":"---"}]},{"id":"blk-41180","kind":"heading","level":2,"spans":[{"id":"spn-47097","text":"12) Current Status"}]},{"id":"blk-41181","kind":"paragraph","spans":[{"id":"spn-47098","text":"Graphonomous already has:"}]},{"id":"blk-41182","items":[{"blocks":[{"id":"blk-41184","kind":"paragraph","spans":[{"id":"spn-47099","marks":["code"],"text":"Graphonomous.CLI"},{"id":"spn-47100","text":" entrypoint"}]}],"id":"blk-41183","kind":"list-item"},{"blocks":[{"id":"blk-41186","kind":"paragraph","spans":[{"id":"spn-47101","text":"stdio MCP launch path"}]}],"id":"blk-41185","kind":"list-item"},{"blocks":[{"id":"blk-41188","kind":"paragraph","spans":[{"id":"spn-47102","text":"npm wrapper scaffold under "},{"id":"spn-47103","marks":["code"],"text":"npm/"}]}],"id":"blk-41187","kind":"list-item"},{"blocks":[{"id":"blk-41190","kind":"paragraph","spans":[{"id":"spn-47104","text":"docs for bootstrap and Zed integration"}]}],"id":"blk-41189","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41191","kind":"par