h","spans":[{"id":"spn-45970","text":"---"}]},{"id":"blk-40688","kind":"heading","level":2,"spans":[{"id":"spn-45971","text":"11) Minimal Command Cheat Sheet"}]},{"id":"blk-40689","kind":"paragraph","spans":[{"id":"spn-45972","text":"From repo root: mix deps.get mix format --check-formatted mix compile --warnings-as-errors mix test MIX_ENV=prod mix release --overwrite"}]},{"id":"blk-40690","kind":"paragraph","spans":[{"id":"spn-45973","text":"Asset packaging: VERSION=X.Y.Z TARGET=linux-x64 mkdir -p dist tar -czf \"dist/graphonomous-v${VERSION}-${TARGET}.tar.gz\" -C \"_build/prod/rel\" graphonomous"}]},{"id":"blk-40691","kind":"paragraph","spans":[{"id":"spn-45974","text":"Tagging: git tag vX.Y.Z git push origin vX.Y.Z"}]},{"id":"blk-40692","kind":"paragraph","spans":[{"id":"spn-45975","text":"npm publish (manual): cd npm npm pack --dry-run npm publish --access public npm view graphonomous version"}]},{"id":"blk-40693","kind":"paragraph","spans":[{"id":"spn-45976","text":"---"}]},{"id":"blk-40694","kind":"heading","level":2,"spans":[{"id":"spn-45977","text":"12) Current Status"}]},{"id":"blk-40695","kind":"paragraph","spans":[{"id":"spn-45978","text":"Graphonomous already has:"}]},{"id":"blk-40696","items":[{"blocks":[{"id":"blk-40698","kind":"paragraph","spans":[{"id":"spn-45979","marks":["code"],"text":"Graphonomous.CLI"},{"id":"spn-45980","text":" entrypoint"}]}],"id":"blk-40697","kind":"list-item"},{"blocks":[{"id":"blk-40700","kind":"paragraph","spans":[{"id":"spn-45981","text":"stdio MCP launch path"}]}],"id":"blk-40699","kind":"list-item"},{"blocks":[{"id":"blk-40702","kind":"paragraph","spans":[{"id":"spn-45982","text":"npm wrapper scaffold under "},{"id":"spn-45983","marks":["code"],"text":"npm/"}]}],"id":"blk-40701","kind":"list-item"},{"blocks":[{"id":"blk-40704","kind":"paragraph","spans":[{"id":"spn-45984","text":"docs for bootstrap and Zed integration"}]}],"id":"blk-40703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40705","kind":"par