{"bendscript":"0.1","blocks":[{"id":"blk-40517","kind":"heading","level":1,"spans":[{"id":"spn-45793","text":"Graphonomous npm Publishing + Maintenance Runbook (Manual-First)"}]},{"id":"blk-40518","kind":"paragraph","spans":[{"id":"spn-45794","text":"This runbook is the "},{"id":"spn-45795","marks":["bold"],"text":"manual release path"},{"id":"spn-45796","text":" for publishing "},{"id":"spn-45797","marks":["code"],"text":"graphonomous"},{"id":"spn-45798","text":" without relying on long-lived CI publish credentials."}]},{"id":"blk-40519","kind":"paragraph","spans":[{"id":"spn-45799","text":"It is designed for the reality that npm credentials/tokens may rotate or expire frequently."}]},{"id":"blk-40520","kind":"paragraph","spans":[{"id":"spn-45800","text":"---"}]},{"id":"blk-40521","kind":"heading","level":2,"spans":[{"id":"spn-45801","text":"1) Goal"}]},{"id":"blk-40522","kind":"paragraph","spans":[{"id":"spn-45802","text":"Publish Graphonomous so users can run:"}]},{"id":"blk-40523","items":[{"blocks":[{"id":"blk-40525","kind":"paragraph","spans":[{"id":"spn-45803","marks":["code"],"text":"npx graphonomous --help"}]}],"id":"blk-40524","kind":"list-item"},{"blocks":[{"id":"blk-40527","kind":"paragraph","spans":[{"id":"spn-45804","marks":["code"],"text":"npm i -g graphonomous"}]}],"id":"blk-40526","kind":"list-item"},{"blocks":[{"id":"blk-40529","kind":"paragraph","spans":[{"id":"spn-45805","marks":["code"],"text":"graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]}],"id":"blk-40528","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40530","kind":"paragraph","spans":[{"id":"spn-45806","text":"while keeping the Elixir implementation as source of truth."}]},{"id":"blk-40531","kind":"paragraph","spans":[{"id":"spn-45807","text":"---"}]},{"id":"blk-40532","kind":"heading","level":2,"spans":[{"id":"spn-45808","text":"2) Principles"}]},{"id":"blk-40533","kind":"paragraph","spans":[{"id":"spn-45809","text":"1. "},{"id":"spn-45810","marks":["bold"],"text":"Manual over automated publish"}]},{"id":"blk-40534","items":[{"blocks":[{"id":"blk-40536","kind":"paragraph","spans":[{"id":"spn-45811","text":"You run the release and npm publish commands locally."}]}],"id":"blk-40535","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40537","kind":"paragraph","spans":[{"id":"spn-45812","text":"2. "},{"id":"spn-45813","marks":["bold"],"text":"No dependency on permanent CI tokens"}]},{"id":"blk-40538","items":[{"blocks":[{"id":"blk-40540","kind":"paragraph","spans":[{"id":"spn-45814","text":"No long-lived npm automation token required."}]}],"id":"blk-40539","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40541","kind":"paragraph","spans":[{"id":"spn-45815","text":"3. "},{"id":"spn-45816","marks":["bold"],"text":"Version parity is strict"}]},{"id":"blk-40542","items":[{"blocks":[{"id":"blk-40544","kind":"paragraph","spans":[{"id":"spn-45817","marks":["code"],"text":"mix.exs"},{"id":"spn-45818","text":", "},{"id":"spn-45819","marks":["code"],"text":"npm/package.json"},{"id":"spn-45820","text":", git tag, and release assets must all match."}]}],"id":"blk-40543","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40545","kind":"paragraph","spans":[{"id":"spn-45821","text":"4. "},{"id":"spn-45822","marks":["bold"],"text":"Never overwrite versions"}]},{"id":"blk-40546","items":[{"blocks":[{"id":"blk-40548","kind":"paragraph","spans":[{"id":"spn-45823","text":"npm versions are immutable once published."}]}],"id":"blk-40547","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40549","kind":"paragraph","spans":[{"id":"spn-45824","text":"---"}]},{"id":"blk-40550","kind":"heading","level":2,"spans":[{"id":"spn-45825","text":"3) Required Local Tooling"}]},{"id":"blk-40551","items":[{"blocks":[{"id":"blk-40553","kind":"paragraph","spans":[{"id":"spn-45826","text":"Elixir "},{"id":"spn-45827","marks":["code"],"text":"1.17.x"}]}],"id":"blk-40552","kind":"list-item"},{"blocks":[{"id":"blk-40555","kind":"paragraph","spans":[{"id":"spn-45828","text":"Erlang/OTP "},{"id":"spn-45829","marks":["code"],"text":"27.x"}]}],"id":"blk-40554","kind":"list-item"},{"blocks":[{"id":"blk-40557","kind":"paragraph","spans":[{"id":"spn-45830","text":"Node.js "},{"id":"spn-45831","marks":["code"],"text":">= 18"}]}],"id":"blk-40556","kind":"list-item"},{"blocks":[{"id":"blk-40559","kind":"paragraph","spans":[{"id":"spn-45832","text":"npm account with publish permission"}]}],"id":"blk-40558","kind":"list-item"},{"blocks":[{"id":"blk-40561","kind":"paragraph","spans":[{"id":"spn-45833","marks":["code"],"text":"git"}]}],"id":"blk-40560","kind":"list-item"},{"blocks":[{"id":"blk-40563","kind":"paragraph","spans":[{"id":"spn-45834","marks":["code"],"text":"tar"},{"id":"spn-45835","text":" (for packaging release assets)"}]}],"id":"blk-40562","kind":"list-item"},{"blocks":[{"id":"blk-40565","kind":"paragraph","spans":[{"id":"spn-45836","text":"Optional: "},{"id":"spn-45837","marks":["code"],"text":"gh"},{"id":"spn-45838","text":" CLI (otherwise use GitHub web UI)"}]}],"id":"blk-40564","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40566","kind":"paragraph","spans":[{"id":"spn-45839","text":"---"}]},{"id":"blk-40567","kind":"heading","level":2,"spans":[{"id":"spn-45840","text":"4) One-Time Setup"}]},{"id":"blk-40568","kind":"heading","level":2,"spans":[{"id":"spn-45841","text":"4.1 npm auth"}]},{"id":"blk-40569","items":[{"blocks":[{"id":"blk-40571","kind":"paragraph","spans":[{"id":"spn-45842","text":"Run "},{"id":"spn-45843","marks":["code"],"text":"npm login"}]}],"id":"blk-40570","kind":"list-item"},{"blocks":[{"id":"blk-40573","kind":"paragraph","spans":[{"id":"spn-45844","text":"Verify with "},{"id":"spn-45845","marks":["code"],"text":"npm whoami"}]}],"id":"blk-40572","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40574","kind":"paragraph","spans":[{"id":"spn-45846","text":"If your org/package requires 2FA, keep your authenticator available during "},{"id":"spn-45847","marks":["code"],"text":"npm publish"},{"id":"spn-45848","text":"."}]},{"id":"blk-40575","kind":"heading","level":2,"spans":[{"id":"spn-45849","text":"4.2 Repo/package naming"}]},{"id":"blk-40576","kind":"paragraph","spans":[{"id":"spn-45850","text":"Package is expected as:"}]},{"id":"blk-40577","items":[{"blocks":[{"id":"blk-40579","kind":"paragraph","spans":[{"id":"spn-45851","marks":["code"],"text":"graphonomous"},{"id":"spn-45852","text":" (unscoped)"}]}],"id":"blk-40578","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40580","kind":"paragraph","spans":[{"id":"spn-45853","text":"or"}]},{"id":"blk-40581","items":[{"blocks":[{"id":"blk-40583","kind":"paragraph","spans":[{"id":"spn-45854","marks":["code"],"text":"@your-org/graphonomous"},{"id":"spn-45855","text":" (scoped)"}]}],"id":"blk-40582","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40584","kind":"paragraph","spans":[{"id":"spn-45856","text":"---"}]},{"id":"blk-40585","kind":"heading","level":2,"spans":[{"id":"spn-45857","text":"5) Release Asset Convention"}]},{"id":"blk-40586","kind":"paragraph","spans":[{"id":"spn-45858","text":"Release assets are platform-specific "},{"id":"spn-45859","marks":["code"],"text":".tar.gz"},{"id":"spn-45860","text":" files:"}]},{"id":"blk-40587","items":[{"blocks":[{"id":"blk-40589","kind":"paragraph","spans":[{"id":"spn-45861","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]}],"id":"blk-40588","kind":"list-item"},{"blocks":[{"id":"blk-40591","kind":"paragraph","spans":[{"id":"spn-45862","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-arm64.tar.gz"}]}],"id":"blk-40590","kind":"list-item"},{"blocks":[{"id":"blk-40593","kind":"paragraph","spans":[{"id":"spn-45863","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-x64.tar.gz"}]}],"id":"blk-40592","kind":"list-item"},{"blocks":[{"id":"blk-40595","kind":"paragraph","spans":[{"id":"spn-45864","marks":["code"],"text":"graphonomous-vX.Y.Z-darw