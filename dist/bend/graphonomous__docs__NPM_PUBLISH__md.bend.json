{"bendscript":"0.1","blocks":[{"id":"blk-41003","kind":"heading","level":1,"spans":[{"id":"spn-46913","text":"Graphonomous npm Publishing + Maintenance Runbook (Manual-First)"}]},{"id":"blk-41004","kind":"paragraph","spans":[{"id":"spn-46914","text":"This runbook is the "},{"id":"spn-46915","marks":["bold"],"text":"manual release path"},{"id":"spn-46916","text":" for publishing "},{"id":"spn-46917","marks":["code"],"text":"graphonomous"},{"id":"spn-46918","text":" without relying on long-lived CI publish credentials."}]},{"id":"blk-41005","kind":"paragraph","spans":[{"id":"spn-46919","text":"It is designed for the reality that npm credentials/tokens may rotate or expire frequently."}]},{"id":"blk-41006","kind":"paragraph","spans":[{"id":"spn-46920","text":"---"}]},{"id":"blk-41007","kind":"heading","level":2,"spans":[{"id":"spn-46921","text":"1) Goal"}]},{"id":"blk-41008","kind":"paragraph","spans":[{"id":"spn-46922","text":"Publish Graphonomous so users can run:"}]},{"id":"blk-41009","items":[{"blocks":[{"id":"blk-41011","kind":"paragraph","spans":[{"id":"spn-46923","marks":["code"],"text":"npx graphonomous --help"}]}],"id":"blk-41010","kind":"list-item"},{"blocks":[{"id":"blk-41013","kind":"paragraph","spans":[{"id":"spn-46924","marks":["code"],"text":"npm i -g graphonomous"}]}],"id":"blk-41012","kind":"list-item"},{"blocks":[{"id":"blk-41015","kind":"paragraph","spans":[{"id":"spn-46925","marks":["code"],"text":"graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]}],"id":"blk-41014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41016","kind":"paragraph","spans":[{"id":"spn-46926","text":"while keeping the Elixir implementation as source of truth."}]},{"id":"blk-41017","kind":"paragraph","spans":[{"id":"spn-46927","text":"---"}]},{"id":"blk-41018","kind":"heading","level":2,"spans":[{"id":"spn-46928","text":"2) Principles"}]},{"id":"blk-41019","kind":"paragraph","spans":[{"id":"spn-46929","text":"1. "},{"id":"spn-46930","marks":["bold"],"text":"Manual over automated publish"}]},{"id":"blk-41020","items":[{"blocks":[{"id":"blk-41022","kind":"paragraph","spans":[{"id":"spn-46931","text":"You run the release and npm publish commands locally."}]}],"id":"blk-41021","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41023","kind":"paragraph","spans":[{"id":"spn-46932","text":"2. "},{"id":"spn-46933","marks":["bold"],"text":"No dependency on permanent CI tokens"}]},{"id":"blk-41024","items":[{"blocks":[{"id":"blk-41026","kind":"paragraph","spans":[{"id":"spn-46934","text":"No long-lived npm automation token required."}]}],"id":"blk-41025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41027","kind":"paragraph","spans":[{"id":"spn-46935","text":"3. "},{"id":"spn-46936","marks":["bold"],"text":"Version parity is strict"}]},{"id":"blk-41028","items":[{"blocks":[{"id":"blk-41030","kind":"paragraph","spans":[{"id":"spn-46937","marks":["code"],"text":"mix.exs"},{"id":"spn-46938","text":", "},{"id":"spn-46939","marks":["code"],"text":"npm/package.json"},{"id":"spn-46940","text":", git tag, and release assets must all match."}]}],"id":"blk-41029","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41031","kind":"paragraph","spans":[{"id":"spn-46941","text":"4. "},{"id":"spn-46942","marks":["bold"],"text":"Never overwrite versions"}]},{"id":"blk-41032","items":[{"blocks":[{"id":"blk-41034","kind":"paragraph","spans":[{"id":"spn-46943","text":"npm versions are immutable once published."}]}],"id":"blk-41033","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41035","kind":"paragraph","spans":[{"id":"spn-46944","text":"---"}]},{"id":"blk-41036","kind":"heading","level":2,"spans":[{"id":"spn-46945","text":"3) Required Local Tooling"}]},{"id":"blk-41037","items":[{"blocks":[{"id":"blk-41039","kind":"paragraph","spans":[{"id":"spn-46946","text":"Elixir "},{"id":"spn-46947","marks":["code"],"text":"1.17.x"}]}],"id":"blk-41038","kind":"list-item"},{"blocks":[{"id":"blk-41041","kind":"paragraph","spans":[{"id":"spn-46948","text":"Erlang/OTP "},{"id":"spn-46949","marks":["code"],"text":"27.x"}]}],"id":"blk-41040","kind":"list-item"},{"blocks":[{"id":"blk-41043","kind":"paragraph","spans":[{"id":"spn-46950","text":"Node.js "},{"id":"spn-46951","marks":["code"],"text":">= 18"}]}],"id":"blk-41042","kind":"list-item"},{"blocks":[{"id":"blk-41045","kind":"paragraph","spans":[{"id":"spn-46952","text":"npm account with publish permission"}]}],"id":"blk-41044","kind":"list-item"},{"blocks":[{"id":"blk-41047","kind":"paragraph","spans":[{"id":"spn-46953","marks":["code"],"text":"git"}]}],"id":"blk-41046","kind":"list-item"},{"blocks":[{"id":"blk-41049","kind":"paragraph","spans":[{"id":"spn-46954","marks":["code"],"text":"tar"},{"id":"spn-46955","text":" (for packaging release assets)"}]}],"id":"blk-41048","kind":"list-item"},{"blocks":[{"id":"blk-41051","kind":"paragraph","spans":[{"id":"spn-46956","text":"Optional: "},{"id":"spn-46957","marks":["code"],"text":"gh"},{"id":"spn-46958","text":" CLI (otherwise use GitHub web UI)"}]}],"id":"blk-41050","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41052","kind":"paragraph","spans":[{"id":"spn-46959","text":"---"}]},{"id":"blk-41053","kind":"heading","level":2,"spans":[{"id":"spn-46960","text":"4) One-Time Setup"}]},{"id":"blk-41054","kind":"heading","level":2,"spans":[{"id":"spn-46961","text":"4.1 npm auth"}]},{"id":"blk-41055","items":[{"blocks":[{"id":"blk-41057","kind":"paragraph","spans":[{"id":"spn-46962","text":"Run "},{"id":"spn-46963","marks":["code"],"text":"npm login"}]}],"id":"blk-41056","kind":"list-item"},{"blocks":[{"id":"blk-41059","kind":"paragraph","spans":[{"id":"spn-46964","text":"Verify with "},{"id":"spn-46965","marks":["code"],"text":"npm whoami"}]}],"id":"blk-41058","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41060","kind":"paragraph","spans":[{"id":"spn-46966","text":"If your org/package requires 2FA, keep your authenticator available during "},{"id":"spn-46967","marks":["code"],"text":"npm publish"},{"id":"spn-46968","text":"."}]},{"id":"blk-41061","kind":"heading","level":2,"spans":[{"id":"spn-46969","text":"4.2 Repo/package naming"}]},{"id":"blk-41062","kind":"paragraph","spans":[{"id":"spn-46970","text":"Package is expected as:"}]},{"id":"blk-41063","items":[{"blocks":[{"id":"blk-41065","kind":"paragraph","spans":[{"id":"spn-46971","marks":["code"],"text":"graphonomous"},{"id":"spn-46972","text":" (unscoped)"}]}],"id":"blk-41064","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41066","kind":"paragraph","spans":[{"id":"spn-46973","text":"or"}]},{"id":"blk-41067","items":[{"blocks":[{"id":"blk-41069","kind":"paragraph","spans":[{"id":"spn-46974","marks":["code"],"text":"@your-org/graphonomous"},{"id":"spn-46975","text":" (scoped)"}]}],"id":"blk-41068","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41070","kind":"paragraph","spans":[{"id":"spn-46976","text":"---"}]},{"id":"blk-41071","kind":"heading","level":2,"spans":[{"id":"spn-46977","text":"5) Release Asset Convention"}]},{"id":"blk-41072","kind":"paragraph","spans":[{"id":"spn-46978","text":"Release assets are platform-specific "},{"id":"spn-46979","marks":["code"],"text":".tar.gz"},{"id":"spn-46980","text":" files:"}]},{"id":"blk-41073","items":[{"blocks":[{"id":"blk-41075","kind":"paragraph","spans":[{"id":"spn-46981","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]}],"id":"blk-41074","kind":"list-item"},{"blocks":[{"id":"blk-41077","kind":"paragraph","spans":[{"id":"spn-46982","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-arm64.tar.gz"}]}],"id":"blk-41076","kind":"list-item"},{"blocks":[{"id":"blk-41079","kind":"paragraph","spans":[{"id":"spn-46983","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-x64.tar.gz"}]}],"id":"blk-41078","kind":"list-item"},{"blocks":[{"id":"blk-41081","kind":"paragraph","spans":[{"id":"spn-46984","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-arm64.tar.gz"}]}],"id":"blk-41080","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41082","kind":"paragraph","spans":[{"id":"spn-46985","text":"Each archive should contain the OTP release root:"}]},{"id":"blk-41083","items":[{"blocks":[{"id":"blk-41085","kind":"paragraph","spans":[{"id":"spn-46986","marks":["code"],"text":"graphonomous/"}]}],"id":"blk-41084","kind":"list-item"},{"blocks":[{"id":"blk-41087","kind":"paragraph","spans":[{"id":"spn-46987","marks":["code"],"text":"graphonomous/bin/graphonomous"}]}],"id":"blk-41086","kind":"list-item"},{"blocks":[{"id":"blk-41089","kind":"paragraph","spans":[{"id":"spn-46988","text":"required runtime dirs/files for BEAM + NIFs"}]}],"id":"blk-41088","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41090","kind":"paragraph","spans":[{"id":"spn-46989","text":"---"}]},{"id":"blk-41091","kind":"heading","level":2,"spans":[{"id":"spn-46990","text":"6) Full Manual Release Procedure (No GitHub Actions Publish Step)"}]},{"id":"blk-41092","kind":"paragraph","spans":[{"id":"spn-46991","text":"Perform from repo root ("},{"id":"spn-46992","marks":["code"],"text":"ProjectAmp2/graphonomous"},{"id":"spn-46993","text":")."}]},{"id":"blk-41093","kind":"heading","level":2,"spans":[{"id":"spn-46994","text":"6.1 Create release branch"}]},{"id":"blk-41094","kind":"paragraph","spans":[{"id":"spn-46995","text":"git checkout -b release/vX.Y.Z"}]},{"id":"blk-41095","kind":"heading","level":2,"spans":[{"id":"spn-46996","text":"6.2 Update versions"}]},{"id":"blk-41096","kind":"paragraph","spans":[{"id":"spn-46997","text":"1. "},{"id":"spn-46998","marks":["code"],"text":"mix.exs"},{"id":"spn-46999","text":" → "},{"id":"spn-47000","marks":["code"],"text":"version: \"X.Y.Z\""},{"id":"spn-47001","text":" 2. "},{"id":"spn-47002","marks":["code"],"text":"npm/package.json"},{"id":"spn-47003","text":" → "},{"id":"spn-47004","marks":["code"],"text":"\"version\": \"X.Y.Z\""}]},{"id":"blk-41097","kind":"heading","level":2,"spans":[{"id":"spn-47005","text":"6.3 Quality checks"}]},{"id":"blk-41098","kind":"paragraph","spans":[{"id":"spn-47006","text":"mix deps.get mix format --check-formatted mix compile --warnings-as-errors mix test"}]},{"id":"blk-41099","kind":"heading","level":2,"spans":[{"id":"spn-47007","text":"6.4 Build OTP release locally"}]},{"id":"blk-41100","kind":"paragraph","spans":[{"id":"spn-47008","text":"MIX_ENV=prod mix release --overwrite"}]},{"id":"blk-41101","kind":"paragraph","spans":[{"id":"spn-47009","text":"Sanity check command path: _build/prod/rel/graphonomous/bin/graphonomous version"}]},{"id":"blk-41102","kind":"paragraph","spans":[{"id":"spn-47010","text":"CLI sanity check via eval entrypoint: _build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"}]},{"id":"blk-41103","kind":"heading","level":2,"spans":[{"id":"spn-47011","text":"6.5 Create release assets locally"}]},{"id":"blk-41104","kind":"paragraph","spans":[{"id":"spn-47012","text":"Example for your current machine target: VERSION=X.Y.Z TARGET=linux-x64 mkdir -p dist tar -czf \"dist/graphonomous-v${VERSION}-${TARGET}.tar.gz\" -C \"_build/prod/rel\" graphonomous"}]},{"id":"blk-41105","kind":"paragraph","spans":[{"id":"spn-47013","text":"Repeat on each required OS/arch machine to produce all target artifacts:"}]},{"id":"blk-41106","items":[{"blocks":[{"id":"blk-41108","kind":"paragraph","spans":[{"id":"spn-47014","text":"linux x64"}]}],"id":"blk-41107","kind":"list-item"},{"blocks":[{"id":"blk-41110","kind":"paragraph","spans":[{"id":"spn-47015","text":"linux arm64"}]}],"id":"blk-41109","kind":"list-item"},{"blocks":[{"id":"blk-41112","kind":"paragraph","spans":[{"id":"spn-47016","text":"macOS x64"}]}],"id":"blk-41111","kind":"list-item"},{"blocks":[{"id":"blk-41114","kind":"paragraph","spans":[{"id":"spn-47017","text":"macOS arm64"}]}],"id":"blk-41113","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41115","kind":"heading","level":2,"spans":[{"id":"spn-47018","text":"6.6 Commit + tag"}]},{"id":"blk-41116","kind":"paragraph","spans":[{"id":"spn-47019","text":"git add . git commit -m \"release: vX.Y.Z\" git tag vX.Y.Z git push origin release/vX.Y.Z git push origin vX.Y.Z"}]},{"id":"blk-41117","kind":"heading","level":2,"spans":[{"id":"spn-47020","text":"6.7 Create GitHub Release manually"}]},{"id":"blk-41118","kind":"paragraph","spans":[{"id":"spn-47021","text":"Option A: GitHub Web UI 1. Open Releases → Draft new release 2. Tag: "},{"id":"spn-47022","marks":["code"],"text":"vX.Y.Z"},{"id":"spn-47023","text":" 3. Title: "},{"id":"spn-47024","marks":["code"],"text":"vX.Y.Z"},{"id":"spn-47025","text":" 4. Upload all "},{"id":"spn-47026","marks":["code"],"text":"dist/*.tar.gz"},{"id":"spn-47027","text":" assets 5. Publish release"}]},{"id":"blk-41119","kind":"paragraph","spans":[{"id":"spn-47028","text":"Option B: "},{"id":"spn-47029","marks":["code"],"text":"gh"},{"id":"spn-47030","text":" CLI gh release create \"vX.Y.Z\" dist/*.tar.gz --title \"vX.Y.Z\" --notes \"Manual release\""}]},{"id":"blk-41120","kind":"paragraph","spans":[{"id":"spn-47031","text":"Verify uploaded assets match naming convention exactly."}]},{"id":"blk-41121","kind":"heading","level":2,"spans":[{"id":"spn-47032","text":"6.8 npm pre-publish smoke test (local)"}]},{"id":"blk-41122","kind":"paragraph","spans":[{"id":"spn-47033","text":"From "},{"id":"spn-47034","marks":["code"],"text":"npm/"},{"id":"spn-47035","text":": cd npm npm pack --dry-run npm pack"}]},{"id":"blk-41123","kind":"paragraph","spans":[{"id":"spn-47036","text":"In a temporary directory: mkdir -p /tmp/graphonomous-npm-smoke cd /tmp/graphonomous-npm-smoke npm init -y npm i /absolute/path/to/ProjectAmp2/graphonomous/npm/graphonomous-X.Y.Z.tgz npx graphonomous --help"}]},{"id":"blk-41124","kind":"heading","level":2,"spans":[{"id":"spn-47037","text":"6.9 Publish npm manually (local machine)"}]},{"id":"blk-41125","kind":"paragraph","spans":[{"id":"spn-47038","text":"From "},{"id":"spn-47039","marks":["code"],"text":"ProjectAmp2/graphonomous/npm"},{"id":"spn-47040","text":": npm publish --access public"}]},{"id":"blk-41126","kind":"paragraph","spans":[{"id":"spn-47041","text":"If 2FA is enabled, complete OTP prompt."}]},{"id":"blk-41127","kind":"heading","level":2,"spans":[{"id":"spn-47042","text":"6.10 Post-publish verification"}]},{"id":"blk-41128","kind":"paragraph","spans":[{"id":"spn-47043","text":"npm view graphonomous version npx -y graphonomous --help npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-41129","kind":"paragraph","spans":[{"id":"spn-47044","text":"---"}]},{"id":"blk-41130","kind":"heading","level":2,"spans":[{"id":"spn-47045","text":"7) Zed Config (npm-installed command)"}]},{"id":"blk-41131","kind":"paragraph","spans":[{"id":"spn-47046","text":"Use in Zed settings JSON:"}]},{"id":"blk-41132","kind":"paragraph","spans":[{"id":"spn-47047","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"graphonomous\", \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\" } } } }"}]},{"id":"blk-41133","kind":"paragraph","spans":[{"id":"spn-47048","text":"Or one-off via "},{"id":"spn-47049","marks":["code"],"text":"npx"},{"id":"spn-47050","text":":"}]},{"id":"blk-41134","kind":"paragraph","spans":[{"id":"spn-47051","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"], \"env\": {} } } }"}]},{"id":"blk-41135","kind":"paragraph","spans":[{"id":"spn-47052","text":"---"}]},{"id":"blk-41136","kind":"heading","level":2,"spans":[{"id":"spn-47053","text":"8) Maintenance Routine"}]},{"id":"blk-41137","kind":"paragraph","spans":[{"id":"spn-47054","text":"For each shipped change: 1. Update "},{"id":"spn-47055","marks":["code"],"text":"PROGRESS.md"},{"id":"spn-47056","text":". 2. Update root "},{"id":"spn-47057","marks":["code"],"text":"README.md"},{"id":"spn-47058","text":" user docs. 3. Update "},{"id":"spn-47059","marks":["code"],"text":"docs/ZED.md"},{"id":"spn-47060","text":" if editor setup changed. 4. If CLI args changed, update:"}]},{"id":"blk-41138","items":[{"blocks":[{"id":"blk-41140","kind":"paragraph","spans":[{"id":"spn-47061","marks":["code"],"text":"Graphonomous.CLI"},{"id":"spn-47062","text":" help text"}]}],"id":"blk-41139","kind":"list-item"},{"blocks":[{"id":"blk-41142","kind":"paragraph","spans":[{"id":"spn-47063","marks":["code"],"text":"npm/README.md"}]}],"id":"blk-41141","kind":"list-item"},{"blocks":[{"id":"blk-41144","kind":"paragraph","spans":[{"id":"spn-47064","text":"this runbook if needed"}]}],"id":"blk-41143","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41145","kind":"paragraph","spans":[{"id":"spn-47065","text":"5. Cut next SemVer release ("},{"id":"spn-47066","marks":["code"],"text":"X.Y.Z"},{"id":"spn-47067","text":")."}]},{"id":"blk-41146","kind":"paragraph","spans":[{"id":"spn-47068","text":"Monthly:"}]},{"id":"blk-41147","items":[{"blocks":[{"id":"blk-41149","kind":"paragraph","spans":[{"id":"spn-47069","text":"Test "},{"id":"spn-47070","marks":["code"],"text":"npx -y graphonomous --help"},{"id":"spn-47071","text":" on Linux + macOS."}]}],"id":"blk-41148","kind":"list-item"},{"blocks":[{"id":"blk-41151","kind":"paragraph","spans":[{"id":"spn-47072","text":"Verify GitHub release assets are accessible."}]}],"id":"blk-41150","kind":"list-item"},{"blocks":[{"id":"blk-41153","kind":"paragraph","spans":[{"id":"spn-47073","text":"Verify fresh npm install works."}]}],"id":"blk-41152","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41154","kind":"paragraph","spans":[{"id":"spn-47074","text":"---"}]},{"id":"blk-41155","kind":"heading","level":2,"spans":[{"id":"spn-47075","text":"9) Rollback / Hotfix Policy"}]},{"id":"blk-41156","k