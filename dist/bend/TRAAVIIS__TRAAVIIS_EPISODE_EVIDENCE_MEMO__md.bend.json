ressed artifacts plus the raw process bytes."}]},{"id":"blk-33741","kind":"heading","level":3,"spans":[{"id":"spn-49347","text":"Req 3 — "},{"id":"spn-49348","marks":["code"],"text":"verification_evidence"},{"id":"spn-49349","text":" alongside "},{"id":"spn-49350","marks":["code"],"text":"verification"},{"id":"spn-49351","text":", entering "},{"id":"spn-49352","marks":["code"],"text":"episode-"}]},{"id":"blk-33742","kind":"paragraph","spans":[{"id":"spn-49353","text":"The receipt now carries "},{"id":"spn-49354","marks":["code"],"text":"verification_evidence[sig] = {format, digest}"},{"id":"spn-49355","text":" where "},{"id":"spn-49356","marks":["code"],"text":"digest"},{"id":"spn-49357","text":" is "},{"id":"spn-49358","marks":["code"],"text":"sha256:"},{"id":"spn-49359","text":" over the canonical bytes of the per-signal evidence object ("},{"id":"spn-49360","marks":["code"],"text":"{evidence_version, signal, state, detail}"},{"id":"spn-49361","text":"). "},{"id":"spn-49362","marks":["code"],"text":"\"verification_evidence\""},{"id":"spn-49363","text":" was added to "},{"id":"spn-49364","marks":["code"],"text":"identity._EPISODE_IDENTITY_KEYS"},{"id":"spn-49365","text":", so the digest map "},{"id":"spn-49366","marks":["bold"],"text":"enters `episode-`"},{"id":"spn-49367","text":": the saved "},{"id":"spn-49368","marks":["code"],"text":"evidence/verifiers/<sig>.json"},{"id":"spn-49369","text":" cannot drift without moving the episode id."}]},{"id":"blk-33743","items":[{"blocks":[{"id":"blk-33745","kind":"paragraph","spans":[{"id":"spn-49370","marks":["bold"],"text":"tests"},{"id":"spn-49371","text":" evidence detail = baseline + patched `[{command_id, exit_code,"}]}],"id":"blk-33744","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33746","kind":"paragraph","spans":[{"id":"spn-49372","text":"stdout_digest, stderr_digest}]"},{"id":"spn-49373","marks":["code"],"text":". "},{"id":"spn-49374","text":"command_id"},{"id":"spn-49375","marks":["code"],"text"