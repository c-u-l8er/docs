ressed artifacts plus the raw process bytes."}]},{"id":"blk-33741","kind":"heading","level":3,"spans":[{"id":"spn-49325","text":"Req 3 — "},{"id":"spn-49326","marks":["code"],"text":"verification_evidence"},{"id":"spn-49327","text":" alongside "},{"id":"spn-49328","marks":["code"],"text":"verification"},{"id":"spn-49329","text":", entering "},{"id":"spn-49330","marks":["code"],"text":"episode-"}]},{"id":"blk-33742","kind":"paragraph","spans":[{"id":"spn-49331","text":"The receipt now carries "},{"id":"spn-49332","marks":["code"],"text":"verification_evidence[sig] = {format, digest}"},{"id":"spn-49333","text":" where "},{"id":"spn-49334","marks":["code"],"text":"digest"},{"id":"spn-49335","text":" is "},{"id":"spn-49336","marks":["code"],"text":"sha256:"},{"id":"spn-49337","text":" over the canonical bytes of the per-signal evidence object ("},{"id":"spn-49338","marks":["code"],"text":"{evidence_version, signal, state, detail}"},{"id":"spn-49339","text":"). "},{"id":"spn-49340","marks":["code"],"text":"\"verification_evidence\""},{"id":"spn-49341","text":" was added to "},{"id":"spn-49342","marks":["code"],"text":"identity._EPISODE_IDENTITY_KEYS"},{"id":"spn-49343","text":", so the digest map "},{"id":"spn-49344","marks":["bold"],"text":"enters `episode-`"},{"id":"spn-49345","text":": the saved "},{"id":"spn-49346","marks":["code"],"text":"evidence/verifiers/<sig>.json"},{"id":"spn-49347","text":" cannot drift without moving the episode id."}]},{"id":"blk-33743","items":[{"blocks":[{"id":"blk-33745","kind":"paragraph","spans":[{"id":"spn-49348","marks":["bold"],"text":"tests"},{"id":"spn-49349","text":" evidence detail = baseline + patched `[{command_id, exit_code,"}]}],"id":"blk-33744","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33746","kind":"paragraph","spans":[{"id":"spn-49350","text":"stdout_digest, stderr_digest}]"},{"id":"spn-49351","marks":["code"],"text":". "},{"id":"spn-49352","text":"command_id"},{"id":"spn-49353","marks":["code"],"text"