n-70240","marks":["code"],"text":"OUT_PORTS = {pulser: sig_out, relay: sig_out, spinner: socket}"}]}],"id":"blk-40284","kind":"list-item"},{"blocks":[{"id":"blk-40287","kind":"paragraph","spans":[{"id":"spn-70241","text":"Receiving ports: "},{"id":"spn-70242","marks":["code"],"text":"sig_in"},{"id":"spn-70243","text":" (door/relay/spinner), "},{"id":"spn-70244","marks":["code"],"text":"pose"},{"id":"spn-70245","text":" (orb)."}]}],"id":"blk-40286","kind":"list-item"},{"blocks":[{"id":"blk-40289","kind":"paragraph","spans":[{"id":"spn-70246","marks":["code"],"text":"LEGAL_PAIRS = {(sig_out, sig_in), (socket, pose)}"},{"id":"spn-70247","text":" → "},{"id":"spn-70248","marks":["bold"],"text":"two edge kinds"},{"id":"spn-70249","text":": "},{"id":"spn-70250","marks":["bold"],"text":"sig-wire"},{"id":"spn-70251","text":" and "},{"id":"spn-70252","marks":["bold"],"text":"socket"},{"id":"spn-70253","text":"."}]}],"id":"blk-40288","kind":"list-item"},{"blocks":[{"id":"blk-40291","kind":"paragraph","spans":[{"id":"spn-70254","text":"Constraints frozen in fixture schema: spinner needs exactly one sig-in + one socket; orb controller exclusivity (≤1 socket)."}]}],"id":"blk-40290","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40292","kind":"heading","level":3,"spans":[{"id":"spn-70255","text":"1.3 State schema (per-node field shapes)"}]},{"id":"blk-40293","items":[{"blocks":[{"id":"blk-40295","kind":"paragraph","spans":[{"id":"spn-70256","text":"counters: one-hot Scott enum (period ≤ 32) or binary ripple counter — same semantics (Binding Law 5)."}]}],"id":"blk-40294","kind":"list-item"},{"blocks":[{"id":"blk-40297","kind":"paragraph","spans":[{"id":"spn-70257","text":"wire: "},{"id":"spn-70258","marks":["code"],"text":"cur"},{"id":"spn-70259","text":" / "},{"id":"spn-70260","marks":["code"],"text":"nxt"},{"id":"spn-70261","text":"; door: "},{"id":"spn-70262","marks":["code"],"text":"open"},{"id":"spn-70263","text":" / "},{"id":"spn-70264","marks":["code"],"text":"next_open"},{"id":"spn-70265","text":"; relay: "},{"id":"spn-70266","marks":["code"],"text":"cur_out"},{"id":"spn-70267","text":" / "},{"id":"spn-70268","marks":["code"],"text":"next_out"},{"id":"spn-70269","text":"."}]}],"id":"blk-40296","kind":"list-item"},{"blocks":[{"id":"blk-40299","kind":"paragraph","spans":[{"id":"spn-70270","text":"spinner: "},{"id":"spn-70271","marks":["code"],"text":"rotor"},{"id":"spn-70272","text":" as "},{"id":"spn-70273","marks":["bold"],"text":"runtime STATE"},{"id":"spn-70274","text":" (Q32.32 lanes), permission fixed\\|configurable."}]}],"id":"blk-40298","kind":"list-item"},{"blocks":[{"id":"blk-40301","kind":"paragraph","spans":[{"id":"spn-70275","text":"orb: "},{"id":"spn-70276","marks":["code"],"text":"pose4"},{"id":"spn-70277","text":" + authoritative "},{"id":"spn-70278","marks":["bold"],"text":"sticky"},{"id":"spn-70279","text":" "},{"id":"spn-70280","marks":["code"],"text":"numeric_fault"},{"id":"spn-70281","text":" bit."}]}],"id":"blk-40300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40302","kind":"heading","level":3,"spans":[{"id":"spn-70282","text":"1.4 Epoch input (ADMIT layer)"}]},{"id":"blk-40303","items":[{"blocks":[{"id":"blk-40305","kind":"paragraph","spans":[{"id":"spn-70283","text":"Input = batch of typed "},{"id":"spn-70284","marks":["bold"],"text":"prehashed claim envelopes"},{"id":"spn-70285","text":" "},{"id":"spn-70286","marks":["code"],"text":"SetRotor(spinner, rotor4)"},{"id":"spn-70287","text":" \\| "},{"id":"spn-70288","marks":["code"],"text":"ResetFault(orb)"},{"id":"spn-70289","text":"."}]}],"id":"blk-40304","kind":"list-item"},{"blocks":[{"id":"blk-40307","kind":"paragraph","spans":[{"id":"spn-70290","text":"Reducer output = "},{"id":"spn-70291","marks":["bold"],"text":"EpochControl"},{"id":"spn-70292","text":" = "},{"id":"spn-70293","marks":["code"],"text":"TUP(rotor_bundle, fault_bundle)"},{"id":"spn-70294","text":" = per-spinner "},{"id":"spn-70295","marks":["code"],"text":"NoChange|SetRotor(rotor4)"},{"id":"spn-70296","text":" + per-orb "},{"id":"spn-70297","marks":["code"],"text":"KeepFault|ResetFault"},{"id":"spn-70298","text":"."}]}],"id":"blk-40306","kind":"list-item"},{"blocks":[{"id":"blk-40309","kind":"paragraph","spans":[{"id":"spn-70299","text":"Claim state = bounded sorted "},{"id":"spn-70300","marks":["bold"],"text":"fact vector"},{"id":"spn-70301","text":" + separate immutable "},{"id":"spn-70302","marks":["bold"],"text":"receipt vector"},{"id":"spn-70303","text":" (Option A occupied-prefix sorted); CandidateKey identity."}]}],"id":"blk-40308","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40310","kind":"heading","level":3,"spans":[{"id":"spn-70304","text":"1.5 Transition law + observability"}]},{"id":"blk-40311","items":[{"blocks":[{"id":"blk-40313","kind":"paragraph","spans":[{"id":"spn-70305","text":"Per epoch "},{"id":"spn-70306","marks":["code"],"text":"t"},{"id":"spn-70307","text":": "},{"id":"spn-70308","marks":["bold"],"text":"ADMIT → COMMIT (rotor writes + fault resets) → REACT (token cascade) → latch overflow → FILM"},{"id":"spn-70309","text":"."}]}],"id":"blk-40312","kind":"list-item"},{"blocks":[{"id":"blk-40315","kind":"paragraph","spans":[{"id":"spn-70310","text":"Identity: content-addressed rulepack hash; oid↔role binding; CandidateKey for claims."}]}],"id":"blk-40314","kind":"list-item"},{"blocks":[{"id":"blk-40317","kind":"paragraph","spans":[{"id":"spn-70311","text":"Film: "},{"id":"spn-70312","marks":["bold"],"text":"v0.6"},{"id":"spn-70313","text":" (physical: rotor-as-state, spinner permission, orb sticky fault) / "},{"id":"spn-70314","marks":["bold"],"text":"v0.7"},{"id":"spn-70315","text":" (claim-aware: policy id + facts + receipts/outcomes + recognition + capacity faults)."}]}],"id":"blk-40316","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40318","kind":"heading","level":2,"spans":[{"id":"spn-70316","text":"2. WRL Core 0.1 family → IR vocabulary map"}]},{"head":[{"id":"blk-40320","spans":[{"id":"spn-70317","text":"WRL Core family"}]},{"id":"blk-40321","spans":[{"id":"spn-70318","text":"Forge IR grounding"}]},{"id":"blk-40322","spans":[{"id":"spn-70319","text":"Coverage"}]}],"id":"blk-40319","kind":"table","rows":[[{"id":"blk-40323","spans":[{"id":"spn-70320","text":"Actor "},{"id":"spn-70321","marks":["code"],"text":"[x]"},{"id":"spn-70322","text":" (identity)"}]},{"id":"blk-40324","spans":[{"id":"spn-70323","text":"5 node kinds (pulser/relay/door/spinner/orb)"}]},{"id":"blk-40325","spans":[{"id":"spn-70324","text":"GROUNDED (concrete)"}]}],[{"id":"blk-40326","spans":[{"id":"spn-70325","text":"State "},{"id":"spn-70326","marks":["code"],"text":"(x)"}]},{"id":"blk-40327","spans":[{"id":"spn-70327","text":"§1.3 state schema"}]},{"id":"blk-40328","spans":[{"id":"spn-70328","text":"GROUNDED"}]}],[{"id":"blk-40329","spans":[{"id":"spn-70329","text":"Wiring "},{"id":"spn-70330","marks":["code"],"text":"{x}"}]},{"id":"blk-40330","spans":[{"id":"spn-70331","text":"edges (sig/socket) + ports + permission"}]},{"id":"blk-40331","spans":[{"id":"spn-70332","text":"GROUNDED"}]}],[{"id":"blk-40332","spans":[{"id":"spn-70333","text":"Route: solid "},{"id":"spn-70334","marks":["code"],"text":"--"}]},{"id":"blk-40333","spans":[{"id":"spn-70335","text":"sig-wire deterministic delivery"}]},{"id":"blk-40334","spans":[{"id":"spn-70336","text":"GROUNDED"}]}],[{"id":"blk-40335","spans":[{"id":"spn-70337","text":"Route: verified "},{"id":"spn-70338","marks":["code"],"text":"=="}]},{"id":"blk-40336","spans":[{"id":"spn-70339","text":"ADMIT accepted receipt / COMMIT"}]},{"id":"blk-40337","spans":[{"id":"spn-70340","text":"GROUNDED"}]}],[{"id":"blk-40338","spans":[{"id":"spn-70341","text":"Route: fault "},{"id":"spn-70342","marks":["code"],"text":"!!"}]},{"id":"blk-40339","spans":[{"id":"spn-70343","text":"numeric_fault latch"}]},{"id":"blk-40340","spans":[{"id":"spn-70344","text":"GROUNDED"}]}],[{"id":"blk-40341","spans":[{"id":"spn-70345","text":"Route: async "},{"id":"spn-70346","marks":["code"],"text":"~~"}]},{"id":"blk-40342","spans":[{"id":"spn-70347","text":"mailbox append"}]},{"id":"blk-40343","spans":[{"id":"spn-70348","marks":["bold"],"text":"NOT grounded"},{"id":"spn-70349","text":" (no mailbox node yet; ADMIT batch is the only async-ish input)"}]}],[{"id":"blk-40344","spans":[{"id":"spn-70350","text":"Period"}]},{"id":"blk-40345","spans":[{"id":"spn-70351","text":"epoch "},{"id":"spn-70352","marks":["code"],"text":"t"},{"id":"spn-70353","text":" + COMMIT/REACT phases"}]},{"id":"blk-40346","spans":[{"id":"spn-70354","text":"GROUNDED"}]}],[{"id":"blk-40347","spans":[{"id":"spn-70355","text":"Film"}]},{"id":"blk-40348","spans":[{"id":"spn-70356","text":"film_bytes_v6/v7"}]},{"id":"blk-40349","spans":[{"id":"spn-70357","text":"GROUNDED"}]}],[{"id":"blk-40350","spans":[{"id":"spn-70358","text":"Hash / content-id"}]},{"id":"blk-40351","spans":[{"id":"spn-70359","text":"rulepack hash + CandidateKey"}]},{"id":"blk-40352","spans":[{"id":"spn-70360","text":"GROUNDED"}]}],[{"id":"blk-40353","spans":[{"id":"spn-70361","text":"Fact-merge union"}]},{"id":"blk-40354","spans":[{"id":"spn-70362","text":"claim-fact SET UNION"}]},{"id":"blk-40355","spans":[{"id":"spn-70363","text":"GROUNDED"}]}],[{"id":"blk-40356","spans":[{"id":"spn-70364","text":"Boundary gate/commit/seal"}]},{"id":"blk-40357","spans":[{"id":"spn-70365","text":"COMMIT (rotor writes) + acceptance receipt + ADMIT gate"}]},{"id":"blk-40358","spans":[{"id":"spn-70366","text":"PARTIAL (commit grounded; explicit "},{"id":"spn-70367","marks":["code"],"text":"/gate"},{"id":"spn-70368","text":" capability node + "},{"id":"spn-70369","marks":["code"],"text":"///seal"},{"id":"spn-70370","text":" artifact registry not yet a node kind)"}]}]]},{"id":"blk-40359","kind":"paragraph","spans":[{"id":"spn-70371","marks":["bold"],"text":"Reading:"},{"id":"spn-70372","text":" 10 of 12 Core families are grounded by the concrete forge vocabulary. Two are not: "},{"id":"spn-70373","marks":["bold"],"text":"async route/mailbox"},{"id":"spn-70374","text":" and "},{"id":"spn-70375","marks":["bold"],"text":"explicit capability-gate / seal boundary nodes"},{"id":"spn-70376","text":"."}]},{"id":"blk-40360","kind":"heading","level":2,"spans":[{"id":"spn-70377","text":"3. Open freeze-decisions (need a GPT-5.6 ruling)"}]},{"id":"blk-40361","kind":"paragraph","spans":[{"id":"spn-70378","text":"These are the genuinely undecidable-without-authority questions. Each has a recommended option, but freezing is high-commitment and prior IR/spec freezes all went through GPT-5.6."}]},{"id":"blk-40362","kind":"paragraph","spans":[{"id":"spn-70379","marks":["bold"],"text":"D1 — Abstraction level of the node vocabulary."},{"id":"spn-70380","text":" WRL Core says "},{"id":"spn-70381","marks":["italic"],"text":"Actor"},{"id":"spn-70382","text":" is ONE kind; forge has FIVE concrete kinds. Is IR v1 frozen at the "},{"id":"spn-70383","marks":["bold"],"text":"concrete"},{"id":"spn-70384","text":" layer (pulser/relay/door/spinner/orb as IR primitives) or the "},{"id":"spn-70385","marks":["bold"],"text":"abstract"},{"id":"spn-70386","text":" layer (one "},{"id":"spn-70387","marks":["code"],"text":"Actor"},{"id":"spn-70388","text":" primitive parameterized by a behavior/state schema, with the 5 as library prefabs)? "},{"id":"spn-70389","marks":["italic"],"text":"Recommendation: freeze CONCRETE (the 5 grounded kinds are what actually lower + film; an abstract actor is Experimental until a second instantiation exists)."}]},{"id":"blk-40363","kind":"paragraph","spans":[{"id":"spn-70390","marks":["bold"],"text":"D2 — Edge vocabulary closure."},{"id":"spn-70391","text":" Freeze "},{"id":"spn-70392","marks":["bold"],"text":"2"},{"id":"spn-70393","text":" grounded edge kinds (sig-wire, socket) or reserve all "},{"id":"spn-70394","marks":["bold"],"text":"4"},{"id":"spn-70395","text":" WRL route textures (adding async "},{"id":"spn-70396","marks":["code"],"text":"~~"},{"id":"spn-70397","text":" + fault "},{"id":"spn-70398","marks":["code"],"text":"!!"},{"id":"spn-70399","text":" as declared-but-unlowered)? "},{"id":"spn-70400","marks":["italic"],"text":"Recommendation: freeze 2 as IR-normative; RESERVE async/fault names as declared-only (no lowering), mirroring how WRL.md reserves undefined forms."}]},{"id":"blk-40364","kind":"paragraph","spans":[{"id":"spn-70401","marks":["bold"],"text":"D3 — Is ADMIT graph structure or epoch input?"},{"id":"spn-70402","text":" Currently claims/receipts/EpochControl are a per-epoch INPUT, not graph topology. Does IR v1 (a) keep ADMIT as a separate \"epoch-input IR\" beside the graph IR, or (b) fold claim/receipt vectors into node state? "},{"id":"spn-70403","marks":["italic"],"text":"Recommendation: (a) — keep the graph IR (durable topology + state schema) separate from the epoch-input IR (batch → EpochControl). They have different lifetimes; conflating them re-introduces the merge problem the ruling warned about."}]},{"id":"blk-40365","kind":"paragraph","spans":[{"id":"spn-70404","marks":["bold"],"text":"D4 — State schema: part of IR v1 or a sidecar?"},{"id":"spn-70405","text":" Per-node field shapes (Q32.32 rotor, sticky fault, one-hot/binary counter) — frozen INSIDE IR v1 as each node kind's typed state signature, or a separate versioned \"state schema\" so representation (Law 5) can evolve without rev'ing the IR? "},{"id":"spn-70406","marks":["italic"],"text":"Recommendation: freeze the state SIGNATURE (field names + semantic types) in IR v1; leave REPRESENTATION (one-hot vs binary, lane width) to a sidecar (Law 5: representation ≠ meaning)."}]},{"id":"blk-40366","kind":"paragraph","spans":[{"id":"spn-70407","marks":["bold"],"text":"D5 — Scope: freeze now, or after a second grounded instantiation?"},{"id":"spn-70408","text":" IR v1 would freeze on a SINGLE grounded instantiation (the E2a circuit + SetRotor/ResetFault ADMIT). Freeze v1 now on that basis, or hold until a second, structurally different graph is lowered (to avoid baking in E2a-specific shape)? *Recommendation: this is the crux for GPT-5.6. Freezing on one instantiation risks over-fitting; waiting delays the sanctioned lowering target. Prior discipline (\"measure before building\", finite-before-open-ended) leans toward: freeze a "},{"id":"spn-70409","marks":["bold"],"text":"minimal v1 core"},{"id":"spn-70410","text":" (D1 concrete + D2 two-edge + D3 separate + D4 signature) explicitly SCOPED to the grounded surface, versioned so a second instantiation drives v1.1 — rather than a speculative general IR.*"}]},{"id":"blk-40367","kind":"heading","level":2,"spans":[{"id":"spn-70411","text":"4. Recommendation summary (for ruling)"}]},{"id":"blk-40368","kind":"paragraph","spans":[{"id":"spn-70412","text":"Freeze "},{"id":"spn-70413","marks":["bold"],"text":"Forge Semantic IR v1"},{"id":"spn-70414","text":" as a MINIMAL, grounded-only core:"}]},{"id":"blk-40369","items":[{"blocks":[{"id":"blk-40371","kind":"paragraph","spans":[{"id":"spn-70415","text":"5 concrete node kinds (D1), 2 edge kinds + 2 reserved route names (D2),"}]}],"id":"blk-40370","kind":"list-item"},{"blocks":[{"id":"blk-40373","kind":"paragraph","spans":[{"id":"spn-70416","text":"graph IR separate from epoch-input IR (D3),"}]}],"id":"blk-40372","kind":"list-item"},{"blocks":[{"id":"blk-40375","kind":"paragraph","spans":[{"id":"spn-70417","text":"typed state signatures with representation as a sidecar (D4),"}]}],"id":"blk-40374","kind":"list-item"},{"blocks":[{"id":"blk-40377","kind":"paragraph","spans":[{"id":"spn-70418","text":"explicitly scoped to the single grounded instantiation, versioned for a second (D5)."}]}],"id":"blk-40376","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40378","kind":"paragraph","spans":[{"id":"spn-70419","marks":["bold"],"text":"Halting for GPT-5.6 on D1–D5 before writing the frozen `FORGE_SEMANTIC_IR_v1.md`."},{"id":"spn-70420","text":" No freeze is committed until these are ruled."}]}],"edges":[],"id":"bagaaieraesgvryv6d7yeo3cnsdoxho3yewv2xrliwrcdwbn2c2ei3khvzn7q","vocabulary":"ampersand.docs.fs.v1"}