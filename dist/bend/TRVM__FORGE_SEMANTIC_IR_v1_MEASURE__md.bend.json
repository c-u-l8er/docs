n-55604","marks":["code"],"text":"OUT_PORTS = {pulser: sig_out, relay: sig_out, spinner: socket}"}]}],"id":"blk-36323","kind":"list-item"},{"blocks":[{"id":"blk-36326","kind":"paragraph","spans":[{"id":"spn-55605","text":"Receiving ports: "},{"id":"spn-55606","marks":["code"],"text":"sig_in"},{"id":"spn-55607","text":" (door/relay/spinner), "},{"id":"spn-55608","marks":["code"],"text":"pose"},{"id":"spn-55609","text":" (orb)."}]}],"id":"blk-36325","kind":"list-item"},{"blocks":[{"id":"blk-36328","kind":"paragraph","spans":[{"id":"spn-55610","marks":["code"],"text":"LEGAL_PAIRS = {(sig_out, sig_in), (socket, pose)}"},{"id":"spn-55611","text":" → "},{"id":"spn-55612","marks":["bold"],"text":"two edge kinds"},{"id":"spn-55613","text":": "},{"id":"spn-55614","marks":["bold"],"text":"sig-wire"},{"id":"spn-55615","text":" and "},{"id":"spn-55616","marks":["bold"],"text":"socket"},{"id":"spn-55617","text":"."}]}],"id":"blk-36327","kind":"list-item"},{"blocks":[{"id":"blk-36330","kind":"paragraph","spans":[{"id":"spn-55618","text":"Constraints frozen in fixture schema: spinner needs exactly one sig-in + one socket; orb controller exclusivity (≤1 socket)."}]}],"id":"blk-36329","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36331","kind":"heading","level":3,"spans":[{"id":"spn-55619","text":"1.3 State schema (per-node field shapes)"}]},{"id":"blk-36332","items":[{"blocks":[{"id":"blk-36334","kind":"paragraph","spans":[{"id":"spn-55620","text":"counters: one-hot Scott enum (period ≤ 32) or binary ripple counter — same semantics (Binding Law 5)."}]}],"id":"blk-36333","kind":"list-item"},{"blocks":[{"id":"blk-36336","kind":"paragraph","spans":[{"id":"spn-55621","text":"wire: "},{"id":"spn-55622","marks":["code"],"text":"cur"},{"id":"spn-55623","text":" / "},{"id":"spn-55624","marks":["code"],"text":"nxt"},{"id":"spn-55625","text":"; door: "},{"id":"spn-55626","marks":["code"],"text":"open"},{"id":"spn-55627","text":" / "},{"id":"spn-55628","marks":["code"],"text":"next_open"},{"id":"spn-55629","text":"; relay: "},{"id":"spn-55630","marks":["code"],"text":"cur_out"},{"id":"spn-55631","text":" / "},{"id":"spn-55632","marks":["code"],"text":"next_out"},{"id":"spn-55633","text":"."}]}],"id":"blk-36335","kind":"list-item"},{"blocks":[{"id":"blk-36338","kind":"paragraph","spans":[{"id":"spn-55634","text":"spinner: "},{"id":"spn-55635","marks":["code"],"text":"rotor"},{"id":"spn-55636","text":" as "},{"id":"spn-55637","marks":["bold"],"text":"runtime STATE"},{"id":"spn-55638","text":" (Q32.32 lanes), permission fixed\\|configurable."}]}],"id":"blk-36337","kind":"list-item"},{"blocks":[{"id":"blk-36340","kind":"paragraph","spans":[{"id":"spn-55639","text":"orb: "},{"id":"spn-55640","marks":["code"],"text":"pose4"},{"id":"spn-55641","text":" + authoritative "},{"id":"spn-55642","marks":["bold"],"text":"sticky"},{"id":"spn-55643","text":" "},{"id":"spn-55644","marks":["code"],"text":"numeric_fault"},{"id":"spn-55645","text":" bit."}]}],"id":"blk-36339","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36341","kind":"heading","level":3,"spans":[{"id":"spn-55646","text":"1.4 Epoch input (ADMIT layer)"}]},{"id":"blk-36342","items":[{"blocks":[{"id":"blk-36344","kind":"paragraph","spans":[{"id":"spn-55647","text":"Input = batch of typed "},{"id":"spn-55648","marks":["bold"],"text":"prehashed claim envelopes"},{"id":"spn-55649","text":" "},{"id":"spn-55650","marks":["code"],"text":"SetRotor(spinner, rotor4)"},{"id":"spn-55651","text":" \\| "},{"id":"spn-55652","marks":["code"],"text":"ResetFault(orb)"},{"id":"spn-55653","text":"."}]}],"id":"blk-36343","kind":"list-item"},{"blocks":[{"id":"blk-36346","kind":"paragraph","spans":[{"id":"spn-55654","text":"Reducer output = "},{"id":"spn-55655","marks":["bold"],"text":"EpochControl"},{"id":"spn-55656","text":" = "},{"id":"spn-55657","marks":["code"],"text":"TUP(rotor_bundle, fault_bundle)"},{"id":"spn-55658","text":" = per-spinner "},{"id":"spn-55659","marks":["code"],"text":"NoChange|SetRotor(rotor4)"},{"id":"spn-55660","text":" + per-orb "},{"id":"spn-55661","marks":["code"],"text":"KeepFault|ResetFault"},{"id":"spn-55662","text":"."}]}],"id":"blk-36345","kind":"list-item"},{"blocks":[{"id":"blk-36348","kind":"paragraph","spans":[{"id":"spn-55663","text":"Claim state = bounded sorted "},{"id":"spn-55664","marks":["bold"],"text":"fact vector"},{"id":"spn-55665","text":" + separate immutable "},{"id":"spn-55666","marks":["bold"],"text":"receipt vector"},{"id":"spn-55667","text":" (Option A occupied-prefix sorted); CandidateKey identity."}]}],"id":"blk-36347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36349","kind":"heading","level":3,"spans":[{"id":"spn-55668","text":"1.5 Transition law + observability"}]},{"id":"blk-36350","items":[{"blocks":[{"id":"blk-36352","kind":"paragraph","spans":[{"id":"spn-55669","text":"Per epoch "},{"id":"spn-55670","marks":["code"],"text":"t"},{"id":"spn-55671","text":": "},{"id":"spn-55672","marks":["bold"],"text":"ADMIT → COMMIT (rotor writes + fault resets) → REACT (token cascade) → latch overflow → FILM"},{"id":"spn-55673","text":"."}]}],"id":"blk-36351","kind":"list-item"},{"blocks":[{"id":"blk-36354","kind":"paragraph","spans":[{"id":"spn-55674","text":"Identity: content-addressed rulepack hash; oid↔role binding; CandidateKey for claims."}]}],"id":"blk-36353","kind":"list-item"},{"blocks":[{"id":"blk-36356","kind":"paragraph","spans":[{"id":"spn-55675","text":"Film: "},{"id":"spn-55676","marks":["bold"],"text":"v0.6"},{"id":"spn-55677","text":" (physical: rotor-as-state, spinner permission, orb sticky fault) / "},{"id":"spn-55678","marks":["bold"],"text":"v0.7"},{"id":"spn-55679","text":" (claim-aware: policy id + facts + receipts/outcomes + recognition + capacity faults)."}]}],"id":"blk-36355","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36357","kind":"heading","level":2,"spans":[{"id":"spn-55680","text":"2. WRL Core 0.1 family → IR vocabulary map"}]},{"head":[{"id":"blk-36359","spans":[{"id":"spn-55681","text":"WRL Core family"}]},{"id":"blk-36360","spans":[{"id":"spn-55682","text":"Forge IR grounding"}]},{"id":"blk-36361","spans":[{"id":"spn-55683","text":"Coverage"}]}],"id":"blk-36358","kind":"table","rows":[[{"id":"blk-36362","spans":[{"id":"spn-55684","text":"Actor "},{"id":"spn-55685","marks":["code"],"text":"[x]"},{"id":"spn-55686","text":" (identity)"}]},{"id":"blk-36363","spans":[{"id":"spn-55687","text":"5 node kinds (pulser/relay/door/spinner/orb)"}]},{"id":"blk-36364","spans":[{"id":"spn-55688","text":"GROUNDED (concrete)"}]}],[{"id":"blk-36365","spans":[{"id":"spn-55689","text":"State "},{"id":"spn-55690","marks":["code"],"text":"(x)"}]},{"id":"blk-36366","spans":[{"id":"spn-55691","text":"§1.3 state schema"}]},{"id":"blk-36367","spans":[{"id":"spn-55692","text":"GROUNDED"}]}],[{"id":"blk-36368","spans":[{"id":"spn-55693","text":"Wiring "},{"id":"spn-55694","marks":["code"],"text":"{x}"}]},{"id":"blk-36369","spans":[{"id":"spn-55695","text":"edges (sig/socket) + ports + permission"}]},{"id":"blk-36370","spans":[{"id":"spn-55696","text":"GROUNDED"}]}],[{"id":"blk-36371","spans":[{"id":"spn-55697","text":"Route: solid "},{"id":"spn-55698","marks":["code"],"text":"--"}]},{"id":"blk-36372","spans":[{"id":"spn-55699","text":"sig-wire deterministic delivery"}]},{"id":"blk-36373","spans":[{"id":"spn-55700","text":"GROUNDED"}]}],[{"id":"blk-36374","spans":[{"id":"spn-55701","text":"Route: verified "},{"id":"spn-55702","marks":["code"],"text":"=="}]},{"id":"blk-36375","spans":[{"id":"spn-55703","text":"ADMIT accepted receipt / COMMIT"}]},{"id":"blk-36376","spans":[{"id":"spn-55704","text":"GROUNDED"}]}],[{"id":"blk-36377","spans":[{"id":"spn-55705","text":"Route: fault "},{"id":"spn-55706","marks":["code"],"text":"!!"}]},{"id":"blk-36378","spans":[{"id":"spn-55707","text":"numeric_fault latch"}]},{"id":"blk-36379","spans":[{"id":"spn-55708","text":"GROUNDED"}]}],[{"id":"blk-36380","spans":[{"id":"spn-55709","text":"Route: async "},{"id":"spn-55710","marks":["code"],"text":"~~"}]},{"id":"blk-36381","spans":[{"id":"spn-55711","text":"mailbox append"}]},{"id":"blk-36382","spans":[{"id":"spn-55712","marks":["bold"],"text":"NOT grounded"},{"id":"spn-55713","text":" (no mailbox node yet; ADMIT batch is the only async-ish input)"}]}],[{"id":"blk-36383","spans":[{"id":"spn-55714","text":"Period"}]},{"id":"blk-36384","spans":[{"id":"spn-55715","text":"epoch "},{"id":"spn-55716","marks":["code"],"text":"t"},{"id":"spn-55717","text":" + COMMIT/REACT phases"}]},{"id":"blk-36385","spans":[{"id":"spn-55718","text":"GROUNDED"}]}],[{"id":"blk-36386","spans":[{"id":"spn-55719","text":"Film"}]},{"id":"blk-36387","spans":[{"id":"spn-55720","text":"film_bytes_v6/v7"}]},{"id":"blk-36388","spans":[{"id":"spn-55721","text":"GROUNDED"}]}],[{"id":"blk-36389","spans":[{"id":"spn-55722","text":"Hash / content-id"}]},{"id":"blk-36390","spans":[{"id":"spn-55723","text":"rulepack hash + CandidateKey"}]},{"id":"blk-36391","spans":[{"id":"spn-55724","text":"GROUNDED"}]}],[{"id":"blk-36392","spans":[{"id":"spn-55725","text":"Fact-merge union"}]},{"id":"blk-36393","spans":[{"id":"spn-55726","text":"claim-fact SET UNION"}]},{"id":"blk-36394","spans":[{"id":"spn-55727","text":"GROUNDED"}]}],[{"id":"blk-36395","spans":[{"id":"spn-55728","text":"Boundary gate/commit/seal"}]},{"id":"blk-36396","spans":[{"id":"spn-55729","text":"COMMIT (rotor writes) + acceptance receipt + ADMIT gate"}]},{"id":"blk-36397","spans":[{"id":"spn-55730","text":"PARTIAL (commit grounded; explicit "},{"id":"spn-55731","marks":["code"],"text":"/gate"},{"id":"spn-55732","text":" capability node + "},{"id":"spn-55733","marks":["code"],"text":"///seal"},{"id":"spn-55734","text":" artifact registry not yet a node kind)"}]}]]},{"id":"blk-36398","kind":"paragraph","spans":[{"id":"spn-55735","marks":["bold"],"text":"Reading:"},{"id":"spn-55736","text":" 10 of 12 Core families are grounded by the concrete forge vocabulary. Two are not: "},{"id":"spn-55737","marks":["bold"],"text":"async route/mailbox"},{"id":"spn-55738","text":" and "},{"id":"spn-55739","marks":["bold"],"text":"explicit capability-gate / seal boundary nodes"},{"id":"spn-55740","text":"."}]},{"id":"blk-36399","kind":"heading","level":2,"spans":[{"id":"spn-55741","text":"3. Open freeze-decisions (need a GPT-5.6 ruling)"}]},{"id":"blk-36400","kind":"paragraph","spans":[{"id":"spn-55742","text":"These are the genuinely undecidable-without-authority questions. Each has a recommended option, but freezing is high-commitment and prior IR/spec freezes all went through GPT-5.6."}]},{"id":"blk-36401","kind":"paragraph","spans":[{"id":"spn-55743","marks":["bold"],"text":"D1 — Abstraction level of the node vocabulary."},{"id":"spn-55744","text":" WRL Core says "},{"id":"spn-55745","marks":["italic"],"text":"Actor"},{"id":"spn-55746","text":" is ONE kind; forge has FIVE concrete kinds. Is IR v1 frozen at the "},{"id":"spn-55747","marks":["bold"],"text":"concrete"},{"id":"spn-55748","text":" layer (pulser/relay/door/spinner/orb as IR primitives) or the "},{"id":"spn-55749","marks":["bold"],"text":"abstract"},{"id":"spn-55750","text":" layer (one "},{"id":"spn-55751","marks":["code"],"text":"Actor"},{"id":"spn-55752","text":" primitive parameterized by a behavior/state schema, with the 5 as library prefabs)? "},{"id":"spn-55753","marks":["italic"],"text":"Recommendation: freeze CONCRETE (the 5 grounded kinds are what actually lower + film; an abstract actor is Experimental until a second instantiation exists)."}]},{"id":"blk-36402","kind":"paragraph","spans":[{"id":"spn-55754","marks":["bold"],"text":"D2 — Edge vocabulary closure."},{"id":"spn-55755","text":" Freeze "},{"id":"spn-55756","marks":["bold"],"text":"2"},{"id":"spn-55757","text":" grounded edge kinds (sig-wire, socket) or reserve all "},{"id":"spn-55758","marks":["bold"],"text":"4"},{"id":"spn-55759","text":" WRL route textures (adding async "},{"id":"spn-55760","marks":["code"],"text":"~~"},{"id":"spn-55761","text":" + fault "},{"id":"spn-55762","marks":["code"],"text":"!!"},{"id":"spn-55763","text":" as declared-but-unlowered)? "},{"id":"spn-55764","marks":["italic"],"text":"Recommendation: freeze 2 as IR-normative; RESERVE async/fault names as declared-only (no lowering), mirroring how WRL.md reserves undefined forms."}]},{"id":"blk-36403","kind":"paragraph","spans":[{"id":"spn-55765","marks":["bold"],"text":"D3 — Is ADMIT graph structure or epoch input?"},{"id":"spn-55766","text":" Currently claims/receipts/EpochControl are a per-epoch INPUT, not graph topology. Does IR v1 (a) keep ADMIT as a separate \"epoch-input IR\" beside the graph IR, or (b) fold claim/receipt vectors into node state? "},{"id":"spn-55767","marks":["italic"],"text":"Recommendation: (a) — keep the graph IR (durable topology + state schema) separate from the epoch-input IR (batch → EpochControl). They have different lifetimes; conflating them re-introduces the merge problem the ruling warned about."}]},{"id":"blk-36404","kind":"paragraph","spans":[{"id":"spn-55768","marks":["bold"],"text":"D4 — State schema: part of IR v1 or a sidecar?"},{"id":"spn-55769","text":" Per-node field shapes (Q32.32 rotor, sticky fault, one-hot/binary counter) — frozen INSIDE IR v1 as each node kind's typed state signature, or a separate versioned \"state schema\" so representation (Law 5) can evolve without rev'ing the IR? "},{"id":"spn-55770","marks":["italic"],"text":"Recommendation: freeze the state SIGNATURE (field names + semantic types) in IR v1; leave REPRESENTATION (one-hot vs binary, lane width) to a sidecar (Law 5: representation ≠ meaning)."}]},{"id":"blk-36405","kind":"paragraph","spans":[{"id":"spn-55771","marks":["bold"],"text":"D5 — Scope: freeze now, or after a second grounded instantiation?"},{"id":"spn-55772","text":" IR v1 would freeze on a SINGLE grounded instantiation (the E2a circuit + SetRotor/ResetFault ADMIT). Freeze v1 now on that basis, or hold until a second, structurally different graph is lowered (to avoid baking in E2a-specific shape)? *Recommendation: this is the crux for GPT-5.6. Freezing on one instantiation risks over-fitting; waiting delays the sanctioned lowering target. Prior discipline (\"measure before building\", finite-before-open-ended) leans toward: freeze a "},{"id":"spn-55773","marks":["bold"],"text":"minimal v1 core"},{"id":"spn-55774","text":" (D1 concrete + D2 two-edge + D3 separate + D4 signature) explicitly SCOPED to the grounded surface, versioned so a second instantiation drives v1.1 — rather than a speculative general IR.*"}]},{"id":"blk-36406","kind":"heading","level":2,"spans":[{"id":"spn-55775","text":"4. Recommendation summary (for ruling)"}]},{"id":"blk-36407","kind":"paragraph","spans":[{"id":"spn-55776","text":"Freeze "},{"id":"spn-55777","marks":["bold"],"text":"Forge Semantic IR v1"},{"id":"spn-55778","text":" as a MINIMAL, grounded-only core:"}]},{"id":"blk-36408","items":[{"blocks":[{"id":"blk-36410","kind":"paragraph","spans":[{"id":"spn-55779","text":"5 concrete node kinds (D1), 2 edge kinds + 2 reserved route names (D2),"}]}],"id":"blk-36409","kind":"list-item"},{"blocks":[{"id":"blk-36412","kind":"paragraph","spans":[{"id":"spn-55780","text":"graph IR separate from epoch-input IR (D3),"}]}],"id":"blk-36411","kind":"list-item"},{"blocks":[{"id":"blk-36414","kind":"paragraph","spans":[{"id":"spn-55781","text":"typed state signatures with representation as a sidecar (D4),"}]}],"id":"blk-36413","kind":"list-item"},{"blocks":[{"id":"blk-36416","kind":"paragraph","spans":[{"id":"spn-55782","text":"explicitly scoped to the single grounded instantiation, versioned for a second (D5)."}]}],"id":"blk-36415","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36417","kind":"paragraph","spans":[{"id":"spn-55783","marks":["bold"],"text":"Halting for GPT-5.6 on D1–D5 before writing the frozen `FORGE_SEMANTIC_IR_v1.md`."},{"id":"spn-55784","text":" No freeze is committed until these are ruled."}]}],"edges":[],"id":"bagaaieraoqb6ix5hqxhb3ac2k4q3pdxogdvozqoysc73vxq2noejfpxmqkhq","vocabulary":"ampersand.docs.fs.v1"}