ce for B"}]},{"id":"blk-74204","spans":[{"id":"spn-136730","text":"\"Test result → hypothesis\""}]}],[{"id":"blk-74205","spans":[{"id":"spn-136731","marks":["code"],"text":"contradicts"}]},{"id":"blk-74206","spans":[{"id":"spn-136732","text":"A conflicts with B"}]},{"id":"blk-74207","spans":[{"id":"spn-136733","text":"\"Doc says X, but code does Y\""}]}],[{"id":"blk-74208","spans":[{"id":"spn-136734","marks":["code"],"text":"related"},{"id":"spn-136735","text":" / "},{"id":"spn-136736","marks":["code"],"text":"related_to"}]},{"id":"blk-74209","spans":[{"id":"spn-136737","text":"Thematically connected"}]},{"id":"blk-74210","spans":[{"id":"spn-136738","text":"\"Auth module ↔ User module\""}]}],[{"id":"blk-74211","spans":[{"id":"spn-136739","marks":["code"],"text":"derived_from"}]},{"id":"blk-74212","spans":[{"id":"spn-136740","text":"Extracted or derived from"}]},{"id":"blk-74213","spans":[{"id":"spn-136741","text":"\"Summary ← source document\""}]}],[{"id":"blk-74214","spans":[{"id":"spn-136742","marks":["code"],"text":"supersedes"}]},{"id":"blk-74215","spans":[{"id":"spn-136743","text":"Replaced by newer version"}]},{"id":"blk-74216","spans":[{"id":"spn-136744","text":"\"Old preference → updated preference\""}]}],[{"id":"blk-74217","spans":[{"id":"spn-136745","marks":["code"],"text":"resolves"}]},{"id":"blk-74218","spans":[{"id":"spn-136746","text":"A resolves issue B"}]},{"id":"blk-74219","spans":[{"id":"spn-136747","text":"\"Fix → bug report\""}]}],[{"id":"blk-74220","spans":[{"id":"spn-136748","marks":["code"],"text":"part_of"}]},{"id":"blk-74221","spans":[{"id":"spn-136749","text":"A is a component of B"}]},{"id":"blk-74222","spans":[{"id":"spn-136750","text":"\"Function → module\""}]}],[{"id":"blk-74223","spans":[{"id":"spn-136751","marks":["code"],"text":"follows"}]},{"id":"blk-74224","spans":[{"id":"spn-136752","text":"A comes after B"}]},{"id":"blk-74225","spans":[{"id":"spn-136753","text":"\"Step 2 → Step 1\""}]}],[{"id":"blk-74226","spans":[{"id":"spn-1367