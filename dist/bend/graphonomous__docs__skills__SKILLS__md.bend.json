{"bendscript":"0.1","blocks":[{"id":"blk-66585","kind":"heading","level":1,"spans":[{"id":"spn-97073","text":"Graphonomous MCP — Agent Skills"}]},{"blocks":[{"id":"blk-66587","kind":"paragraph","spans":[{"id":"spn-97074","marks":["bold"],"text":"Purpose:"},{"id":"spn-97075","text":" Teach any LLM connected to Graphonomous how to use its MCP machines correctly, idiomatically, and in the right sequence. These reference docs mirror the skills in the "},{"id":"spn-97076","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-97077","text":" Claude Code plugin. For Claude Code users, install the plugin directly: "},{"id":"spn-97078","marks":["code"],"text":"claude plugin add c-u-l8er/ampersand-plugins"}]}],"id":"blk-66586","kind":"quote"},{"id":"blk-66588","kind":"heading","level":2,"spans":[{"id":"spn-97079","text":"Quick Orientation"}]},{"id":"blk-66589","kind":"paragraph","spans":[{"id":"spn-97080","text":"Graphonomous is a "},{"id":"spn-97081","marks":["bold"],"text":"continual learning engine"},{"id":"spn-97082","text":" exposed as 5 MCP machines. It maintains a "},{"id":"spn-97083","marks":["bold"],"text":"self-evolving knowledge graph"},{"id":"spn-97084","text":" of semantic, procedural, episodic, temporal, outcome, and goal nodes connected by typed, weighted edges. Your job as an LLM agent is to "},{"id":"spn-97085","marks":["bold"],"text":"read from and write to this graph"},{"id":"spn-97086","text":" as you work, creating a durable memory that improves over time."}]},{"id":"blk-66590","kind":"heading","level":3,"spans":[{"id":"spn-97087","text":"The Core Loop"}]},{"id":"blk-66591","kind":"paragraph","spans":[{"id":"spn-97088","text":"Every interaction should follow this rhythm:"}]},{"id":"blk-66592","kind":"code","language":"text","text":"retrieve → route → act → learn → consolidate\n\"What do I know?\" → \"What should I do?\" → \"Do it\" → \"Did it work?\" → \"Clean up\""},{"id":"blk-66593","kind":"heading","level":3,"spans":[{"id":"spn-97089","text":"Machine Architecture (v0.4)"}]},{"id":"blk-66594","kind":"paragraph","spans":[{"id":"spn-97090","text":"Graphonomous v0.4 exposes "},{"id":"spn-97091","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-97092","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-97093","marks":["code"],"text":"action"},{"id":"spn-97094","text":" parameter:"}]},{"head":[{"id":"blk-66596","spans":[{"id":"spn-97095","text":"Machine"}]},{"id":"blk-66597","spans":[{"id":"spn-97096","text":"Phase"}]},{"id":"blk-66598","spans":[{"id":"spn-97097","text":"Actions"}]}],"id":"blk-66595","kind":"table","rows":[[{"id":"blk-66599","spans":[{"id":"spn-97098","marks":["code"],"text":"retrieve"}]},{"id":"blk-66600","spans":[{"id":"spn-97099","text":"\"What do I know?\""}]},{"id":"blk-66601","spans":[{"id":"spn-97100","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-66602","spans":[{"id":"spn-97101","marks":["code"],"text":"route"}]},{"id":"blk-66603","spans":[{"id":"spn-97102","text":"\"What should I do?\""}]},{"id":"blk-66604","spans":[{"id":"spn-97103","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-66605","spans":[{"id":"spn-97104","marks":["code"],"text":"act"}]},{"id":"blk-66606","spans":[{"id":"spn-97105","text":"\"Do it\""}]},{"id":"blk-66607","spans":[{"id":"spn-97106","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-66608","spans":[{"id":"spn-97107","marks":["code"],"text":"learn"}]},{"id":"blk-66609","spans":[{"id":"spn-97108","text":"\"Did it work?\""}]},{"id":"blk-66610","spans":[{"id":"spn-97109","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-66611","spans":[{"id":"spn-97110","marks":["code"],"text":"consolidate"}]},{"id":"blk-66612","spans":[{"id":"spn-97111","text":"\"Clean up\""}]},{"id":"blk-66613","spans":[{"id":"spn-97112","text":"run, stats, query, traverse"}]}]]},{"id":"blk-66614","kind":"heading","level":2,"spans":[{"id":"spn-97113","text":"Skill Reference Files"}]},{"head":[{"id":"blk-66616","spans":[{"id":"spn-97114","text":"File"}]},{"id":"blk-66617","spans":[{"id":"spn-97115","text":"Skill"}]},{"id":"blk-66618","spans":[{"id":"spn-97116","text":"What It Teaches"}]}],"id":"blk-66615","kind":"table","rows":[[{"id":"blk-66619","spans":[{"id":"spn-97117","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/bootstrap.md"}],"text":"bootstrap.md"}]},{"id":"blk-66620","spans":[{"id":"spn-97118","marks":["code"],"text":"/graphonomous:bootstrap"}]},{"id":"blk-66621","spans":[{"id":"spn-97119","text":"Session initialization — retrieve context, check goals, survey attention"}]}],[{"id":"blk-66622","spans":[{"id":"spn-97120","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/retrieve.md"}],"text":"retrieve.md"}]},{"id":"blk-66623","spans":[{"id":"spn-97121","marks":["code"],"text":"/graphonomous:retrieve"}]},{"id":"blk-66624","spans":[{"id":"spn-97122","text":"The foundational read loop — κ-aware ranked retrieval + store new knowledge"}]}],[{"id":"blk-66625","spans":[{"id":"spn-97123","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/store.md"}],"text":"store.md"}]},{"id":"blk-66626","spans":[{"id":"spn-97124","marks":["code"],"text":"/graphonomous:store"}]},{"id":"blk-66627","spans":[{"id":"spn-97125","text":"Dedicated write path — atomic nodes, confidence calibration, edges"}]}],[{"id":"blk-66628","spans":[{"id":"spn-97126","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/learn.md"}],"text":"learn.md"}]},{"id":"blk-66629","spans":[{"id":"spn-97127","marks":["code"],"text":"/graphonomous:learn"}]},{"id":"blk-66630","spans":[{"id":"spn-97128","text":"Closed-loop learning — outcome, fee