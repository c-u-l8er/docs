{"bendscript":"0.1","blocks":[{"id":"blk-74068","kind":"heading","level":1,"spans":[{"id":"spn-136584","text":"Graphonomous MCP — Agent Skills"}]},{"blocks":[{"id":"blk-74070","kind":"paragraph","spans":[{"id":"spn-136585","marks":["bold"],"text":"Purpose:"},{"id":"spn-136586","text":" Teach any LLM connected to Graphonomous how to use its MCP machines correctly, idiomatically, and in the right sequence. These reference docs mirror the skills in the "},{"id":"spn-136587","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-136588","text":" Claude Code plugin. For Claude Code users, install the plugin directly: "},{"id":"spn-136589","marks":["code"],"text":"claude plugin add c-u-l8er/ampersand-plugins"}]}],"id":"blk-74069","kind":"quote"},{"id":"blk-74071","kind":"heading","level":2,"spans":[{"id":"spn-136590","text":"Quick Orientation"}]},{"id":"blk-74072","kind":"paragraph","spans":[{"id":"spn-136591","text":"Graphonomous is a "},{"id":"spn-136592","marks":["bold"],"text":"continual learning engine"},{"id":"spn-136593","text":" exposed as 5 MCP machines. It maintains a "},{"id":"spn-136594","marks":["bold"],"text":"self-evolving knowledge graph"},{"id":"spn-136595","text":" of semantic, procedural, episodic, temporal, outcome, and goal nodes connected by typed, weighted edges. Your job as an LLM agent is to "},{"id":"spn-136596","marks":["bold"],"text":"read from and write to this graph"},{"id":"spn-136597","text":" as you work, creating a durable memory that improves over time."}]},{"id":"blk-74073","kind":"heading","level":3,"spans":[{"id":"spn-136598","text":"The Core Loop"}]},{"id":"blk-74074","kind":"paragraph","spans":[{"id":"spn-136599","text":"Every interaction should follow this rhythm:"}]},{"id":"blk-74075","kind":"code","language":"text","text":"retrieve → route → act → learn → consolidate\n\"What do I know?\" → \"What should I do?\" → \"Do it\" → \"Did it work?\" → \"Clean up\""},{"id":"blk-74076","kind":"heading","level":3,"spans":[{"id":"spn-136600","text":"Machine Architecture (v0.4)"}]},{"id":"blk-74077","kind":"paragraph","spans":[{"id":"spn-136601","text":"Graphonomous v0.4 exposes "},{"id":"spn-136602","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-136603","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-136604","marks":["code"],"text":"action"},{"id":"spn-136605","text":" parameter:"}]},{"head":[{"id":"blk-74079","spans":[{"id":"spn-136606","text":"Machine"}]},{"id":"blk-74080","spans":[{"id":"spn-136607","text":"Phase"}]},{"id":"blk-74081","spans":[{"id":"spn-136608","text":"Actions"}]}],"id":"blk-74078","kind":"table","rows":[[{"id":"blk-74082","spans":[{"id":"spn-136609","marks":["code"],"text":"retrieve"}]},{"id":"blk-74083","spans":[{"id":"spn-136610","text":"\"What do I know?\""}]},{"id":"blk-74084","spans":[{"id":"spn-136611","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-74085","spans":[{"id":"spn-136612","marks":["code"],"text":"route"}]},{"id":"blk-74086","spans":[{"id":"spn-136613","text":"\"What should I do?\""}]},{"id":"blk-74087","spans":[{"id":"spn-136614","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-74088","spans":[{"id":"spn-136615","marks":["code"],"text":"act"}]},{"id":"blk-74089","spans":[{"id":"spn-136616","text":"\"Do it\""}]},{"id":"blk-74090","spans":[{"id":"spn-136617","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-74091","spans":[{"id":"spn-136618","marks":["code"],"text":"learn"}]},{"id":"blk-74092","spans":[{"id":"spn-136619","text":"\"Did it work?\""}]},{"id":"blk-74093","spans":[{"id":"spn-136620","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-74094","spans":[{"id":"spn-136621","marks":["code"],"text":"consolidate"}]},{"id":"blk-74095","spans":[{"id":"spn-136622","text":"\"Clean up\""}]},{"id":"blk-74096","spans":[{"id":"spn-136623","text":"run, stats, query, traverse"}]}]]},{"id":"blk-74097","kind":"heading","level":2,"spans":[{"id":"spn-136624","text":"Skill Reference Files"}]},{"head":[{"id":"blk-74099","spans":[{"id":"spn-136625","text":"File"}]},{"id":"blk-74100","spans":[{"id":"spn-136626","text":"Skill"}]},{"id":"blk-74101","spans":[{"id":"spn-136627","text":"What It Teaches"}]}],"id":"blk-74098","kind":"table","rows":[[{"id":"blk-74102","spans":[{"id":"spn-136628","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/bootstrap.md"}],"text":"bootstrap.md"}]},{"id":"blk-74103","spans":[{"id":"spn-136629","marks":["code"],"text":"/graphonomous:bootstrap"}]},{"id":"blk-74104","spans":[{"id":"spn-136630","text":"Session initialization — retrieve context, check goals, survey attention"}]}],[{"id":"blk-74105","spans":[{"id":"spn-136631","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/retrieve.md"}],"text":"retrieve.md"}]},{"id":"blk-74106","spans":[{"id":"spn-136632","marks":["code"],"text":"/graphonomous:retrieve"}]},{"id":"blk-74107","spans":[{"id":"spn-136633","text":"The foundational read loop — κ-aware ranked retrieval + store new knowledge"}]}],[{"id":"blk-74108","spans":[{"id":"spn-136634","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/store.md"}],"text":"store.md"}]},{"id":"blk-74109","spans":[{"id":"spn-136635","marks":["code"],"text":"/graphonomous:store"}]},{"id":"blk-74110","spans":[{"id":"spn-136636","text":"Dedicated write path — atomic nodes, confidence calibration, edges"}]}],[{"id":"blk-74111","spans":[{"id":"spn-136637","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/learn.md"}],"text":"learn.md"}]},{"id":"blk-74112","spans":[{"id":"spn-136638","marks":["code"],"text":"/graphonomous:learn"}]},{"id":"blk-74113","spans":[{"id":