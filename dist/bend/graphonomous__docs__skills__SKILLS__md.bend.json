{"bendscript":"0.1","blocks":[{"id":"blk-66574","kind":"heading","level":1,"spans":[{"id":"spn-97020","text":"Graphonomous MCP — Agent Skills"}]},{"blocks":[{"id":"blk-66576","kind":"paragraph","spans":[{"id":"spn-97021","marks":["bold"],"text":"Purpose:"},{"id":"spn-97022","text":" Teach any LLM connected to Graphonomous how to use its MCP machines correctly, idiomatically, and in the right sequence. These reference docs mirror the skills in the "},{"id":"spn-97023","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-97024","text":" Claude Code plugin. For Claude Code users, install the plugin directly: "},{"id":"spn-97025","marks":["code"],"text":"claude plugin add c-u-l8er/ampersand-plugins"}]}],"id":"blk-66575","kind":"quote"},{"id":"blk-66577","kind":"heading","level":2,"spans":[{"id":"spn-97026","text":"Quick Orientation"}]},{"id":"blk-66578","kind":"paragraph","spans":[{"id":"spn-97027","text":"Graphonomous is a "},{"id":"spn-97028","marks":["bold"],"text":"continual learning engine"},{"id":"spn-97029","text":" exposed as 5 MCP machines. It maintains a "},{"id":"spn-97030","marks":["bold"],"text":"self-evolving knowledge graph"},{"id":"spn-97031","text":" of semantic, procedural, episodic, temporal, outcome, and goal nodes connected by typed, weighted edges. Your job as an LLM agent is to "},{"id":"spn-97032","marks":["bold"],"text":"read from and write to this graph"},{"id":"spn-97033","text":" as you work, creating a durable memory that improves over time."}]},{"id":"blk-66579","kind":"heading","level":3,"spans":[{"id":"spn-97034","text":"The Core Loop"}]},{"id":"blk-66580","kind":"paragraph","spans":[{"id":"spn-97035","text":"Every interaction should follow this rhythm:"}]},{"id":"blk-66581","kind":"code","language":"text","text":"retrieve → route → act → learn → consolidate\n\"What do I know?\" → \"What should I do?\" → \"Do it\" → \"Did it work?\" → \"Clean up\""},{"id":"blk-66582","kind":"heading","level":3,"spans":[{"id":"spn-97036","text":"Machine Architecture (v0.4)"}]},{"id":"blk-66583","kind":"paragraph","spans":[{"id":"spn-97037","text":"Graphonomous v0.4 exposes "},{"id":"spn-97038","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-97039","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-97040","marks":["code"],"text":"action"},{"id":"spn-97041","text":" parameter:"}]},{"head":[{"id":"blk-66585","spans":[{"id":"spn-97042","text":"Machine"}]},{"id":"blk-66586","spans":[{"id":"spn-97043","text":"Phase"}]},{"id":"blk-66587","spans":[{"id":"spn-97044","text":"Actions"}]}],"id":"blk-66584","kind":"table","rows":[[{"id":"blk-66588","spans":[{"id":"spn-97045","marks":["code"],"text":"retrieve"}]},{"id":"blk-66589","spans":[{"id":"spn-97046","text":"\"What do I know?\""}]},{"id":"blk-66590","spans":[{"id":"spn-97047","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-66591","spans":[{"id":"spn-97048","marks":["code"],"text":"route"}]},{"id":"blk-66592","spans":[{"id":"spn-97049","text":"\"What should I do?\""}]},{"id":"blk-66593","spans":[{"id":"spn-97050","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-66594","spans":[{"id":"spn-97051","marks":["code"],"text":"act"}]},{"id":"blk-66595","spans":[{"id":"spn-97052","text":"\"Do it\""}]},{"id":"blk-66596","spans":[{"id":"spn-97053","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-66597","spans":[{"id":"spn-97054","marks":["code"],"text":"learn"}]},{"id":"blk-66598","spans":[{"id":"spn-97055","text":"\"Did it work?\""}]},{"id":"blk-66599","spans":[{"id":"spn-97056","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-66600","spans":[{"id":"spn-97057","marks":["code"],"text":"consolidate"}]},{"id":"blk-66601","spans":[{"id":"spn-97058","text":"\"Clean up\""}]},{"id":"blk-66602","spans":[{"id":"spn-97059","text":"run, stats, query, traverse"}]}]]},{"id":"blk-66603","kind":"heading","level":2,"spans":[{"id":"spn-97060","text":"Skill Reference Files"}]},{"head":[{"id":"blk-66605","spans":[{"id":"spn-97061","text":"File"}]},{"id":"blk-66606","spans":[{"id":"spn-97062","text":"Skill"}]},{"id":"blk-66607","spans":[{"id":"spn-97063","text":"What It Teaches"}]}],"id":"blk-66604","kind":"table","rows":[[{"id":"blk-66608","spans":[{"id":"spn-97064","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/bootstrap.md"}],"text":"bootstrap.md"}]},{"id":"blk-66609","spans":[{"id":"spn-97065","marks":["code"],"text":"/graphonomous:bootstrap"}]},{"id":"blk-66610","spans":[{"id":"spn-97066","text":"Session initialization — retrieve context, check goals, survey attention"}]}],[{"id":"blk-66611","spans":[{"id":"spn-97067","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/retrieve.md"}],"text":"retrieve.md"}]},{"id":"blk-66612","spans":[{"id":"spn-97068","marks":["code"],"text":"/graphonomous:retrieve"}]},{"id":"blk-66613","spans":[{"id":"spn-97069","text":"The foundational read loop — κ-aware ranked retrieval + store new knowledge"}]}],[{"id":"blk-66614","spans":[{"id":"spn-97070","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/store.md"}],"text":"store.md"}]},{"id":"blk-66615","spans":[{"id":"spn-97071","marks":["code"],"text":"/graphonomous:store"}]},{"id":"blk-66616","spans":[{"id":"spn-97072","text":"Dedicated write path — atomic nodes, confidence calibration, edges"}]}],[{"id":"blk-66617","spans":[{"id":"spn-97073","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/learn.md"}],"text":"learn.md"}]},{"id":"blk-66618","spans":[{"id":"spn-97074","marks":["code"],"text":"/graphonomous:learn"}]},{"id":"blk-66619","spans":[{"id":"spn-97075","text":"Closed-loop learning — outcome, fee