":"blk-66680","spans":[{"id":"spn-97177","text":"Current GoalGraph snapshot: all goals with status/progress"}]}],[{"id":"blk-66681","spans":[{"id":"spn-97178","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-66682","spans":[{"id":"spn-97179","text":"Individual node details + connected edges"}]}],[{"id":"blk-66683","spans":[{"id":"spn-97180","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-66684","spans":[{"id":"spn-97181","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-66685","spans":[{"id":"spn-97182","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-66686","spans":[{"id":"spn-97183","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-66687","kind":"heading","level":2,"spans":[{"id":"spn-97184","text":"Node Types"}]},{"head":[{"id":"blk-66689","spans":[{"id":"spn-97185","text":"Type"}]},{"id":"blk-66690","spans":[{"id":"spn-97186","text":"Store When You Learn..."}]},{"id":"blk-66691","spans":[{"id":"spn-97187","text":"Examples"}]}],"id":"blk-66688","kind":"table","rows":[[{"id":"blk-66692","spans":[{"id":"spn-97188","marks":["bold"],"text":"semantic"}]},{"id":"blk-66693","spans":[{"id":"spn-97189","text":"A fact, definition, or architectural truth"}]},{"id":"blk-66694","spans":[{"id":"spn-97190","text":"\"Module X is responsible for Y\", \"The API uses JWT auth\""}]}],[{"id":"blk-66695","spans":[{"id":"spn-97191","marks":["bold"],"text":"procedural"}]},{"id":"blk-66696","spans":[{"id":"spn-97192","text":"A procedure, workflow, or recipe"}]},{"id":"blk-66697","spans":[{"id":"spn-97193","text":"\"To deploy: run X then Y then Z\""}]}],[{"id":"blk-66698","spans":[{"id":"spn-97194","marks":["bold"],"text":"episodic"}]},{"id":"blk-66699","spans":[{"id":"spn-97195","text":"Something that happened — an event or observation"}]},{"id":"blk-66700","spans":[{"id":"spn-97196","text":"\"Build failed due to missing dep\""}]}],[{"id":"blk-66701","spans":[{"id":"spn-