{"bendscript":"0.1","blocks":[{"id":"blk-67539","kind":"heading","level":1,"spans":[{"id":"spn-99860","text":"Graphonomous MCP — Agent Skills"}]},{"blocks":[{"id":"blk-67541","kind":"paragraph","spans":[{"id":"spn-99861","marks":["bold"],"text":"Purpose:"},{"id":"spn-99862","text":" Teach any LLM connected to Graphonomous how to use its MCP machines correctly, idiomatically, and in the right sequence. These reference docs mirror the skills in the "},{"id":"spn-99863","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-99864","text":" Claude Code plugin. For Claude Code users, install the plugin directly: "},{"id":"spn-99865","marks":["code"],"text":"claude plugin add c-u-l8er/ampersand-plugins"}]}],"id":"blk-67540","kind":"quote"},{"id":"blk-67542","kind":"heading","level":2,"spans":[{"id":"spn-99866","text":"Quick Orientation"}]},{"id":"blk-67543","kind":"paragraph","spans":[{"id":"spn-99867","text":"Graphonomous is a "},{"id":"spn-99868","marks":["bold"],"text":"continual learning engine"},{"id":"spn-99869","text":" exposed as 5 MCP machines. It maintains a "},{"id":"spn-99870","marks":["bold"],"text":"self-evolving knowledge graph"},{"id":"spn-99871","text":" of semantic, procedural, episodic, temporal, outcome, and goal nodes connected by typed, weighted edges. Your job as an LLM agent is to "},{"id":"spn-99872","marks":["bold"],"text":"read from and write to this graph"},{"id":"spn-99873","text":" as you work, creating a durable memory that improves over time."}]},{"id":"blk-67544","kind":"heading","level":3,"spans":[{"id":"spn-99874","text":"The Core Loop"}]},{"id":"blk-67545","kind":"paragraph","spans":[{"id":"spn-99875","text":"Every interaction should follow this rhythm:"}]},{"id":"blk-67546","kind":"code","language":"text","text":"retrieve → route → act → learn → consolidate\n\"What do I know?\" → \"What should I do?\" → \"Do it\" → \"Did it work?\" → \"Clean up\""},{"id":"blk-67547","kind":"heading","level":3,"spans":[{"id":"spn-99876","text":"Machine Architecture (v0.4)"}]},{"id":"blk-67548","kind":"paragraph","spans":[{"id":"spn-99877","text":"Graphonomous v0.4 exposes "},{"id":"spn-99878","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-99879","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-99880","marks":["code"],"text":"action"},{"id":"spn-99881","text":" parameter:"}]},{"head":[{"id":"blk-67550","spans":[{"id":"spn-99882","text":"Machine"}]},{"id":"blk-67551","spans":[{"id":"spn-99883","text":"Phase"}]},{"id":"blk-67552","spans":[{"id":"spn-99884","text":"Actions"}]}],"id":"blk-67549","kind":"table","rows":[[{"id":"blk-67553","spans":[{"id":"spn-99885","marks":["code"],"text":"retrieve"}]},{"id":"blk-67554","spans":[{"id":"spn-99886","text":"\"What do I know?\""}]},{"id":"blk-67555","spans":[{"id":"spn-99887","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-67556","spans":[{"id":"spn-99888","marks":["code"],"text":"route"}]},{"id":"blk-67557","spans":[{"id":"spn-99889","text":"\"What should I do?\""}]},{"id":"blk-67558","spans":[{"id":"spn-99890","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-67559","spans":[{"id":"spn-99891","marks":["code"],"text":"act"}]},{"id":"blk-67560","spans":[{"id":"spn-99892","text":"\"Do it\""}]},{"id":"blk-67561","spans":[{"id":"spn-99893","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-67562","spans":[{"id":"spn-99894","marks":["code"],"text":"learn"}]},{"id":"blk-67563","spans":[{"id":"spn-99895","text":"\"Did it work?\""}]},{"id":"blk-67564","spans":[{"id":"spn-99896","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-67565","spans":[{"id":"spn-99897","marks":["code"],"text":"consolidate"}]},{"id":"blk-67566","spans":[{"id":"spn-99898","text":"\"Clean up\""}]},{"id":"blk-67567","spans":[{"id":"spn-99899","text":"run, stats, query, traverse"}]}]]},{"id":"blk-67568","kind":"heading","level":2,"spans":[{"id":"spn-99900","text":"Skill Reference Files"}]},{"head":[{"id":"blk-67570","spans":[{"id":"spn-99901","text":"File"}]},{"id":"blk-67571","spans":[{"id":"spn-99902","text":"Skill"}]},{"id":"blk-67572","spans":[{"id":"spn-99903","text":"What It Teaches"}]}],"id":"blk-67569","kind":"table","rows":[[{"id":"blk-67573","spans":[{"id":"spn-99904","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/bootstrap.md"}],"text":"bootstrap.md"}]},{"id":"blk-67574","spans":[{"id":"spn-99905","marks":["code"],"text":"/graphonomous:bootstrap"}]},{"id":"blk-67575","spans":[{"id":"spn-99906","text":"Session initialization — retrieve context, check goals, survey attention"}]}],[{"id":"blk-67576","spans":[{"id":"spn-99907","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/retrieve.md"}],"text":"retrieve.md"}]},{"id":"blk-67577","spans":[{"id":"spn-99908","marks":["code"],"text":"/graphonomous:retrieve"}]},{"id":"blk-67578","spans":[{"id":"spn-99909","text":"The foundational read loop — κ-aware ranked retrieval + store new knowledge"}]}],[{"id":"blk-67579","spans":[{"id":"spn-99910","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/store.md"}],"text":"store.md"}]},{"id":"blk-67580","spans":[{"id":"spn-99911","marks":["code"],"text":"/graphonomous:store"}]},{"id":"blk-67581","spans":[{"id":"spn-99912","text":"Dedicated write path — atomic nodes, confidence calibration, edges"}]}],[{"id":"blk-67582","spans":[{"id":"spn-99913","marks":[{"kind":"link","predicate":"cites","target":"#/graphonomous/docs/skills/learn.md"}],"text":"learn.md"}]},{"id":"blk-67583","spans":[{"id":"spn-99914","marks":["code"],"text":"/graphonomous:learn"}]},{"id":"blk-67584","spans":[{"id":"spn-99915","text":"Closed-loop learning — outcome, fee