":"blk-66669","spans":[{"id":"spn-97124","text":"Current GoalGraph snapshot: all goals with status/progress"}]}],[{"id":"blk-66670","spans":[{"id":"spn-97125","marks":["code"],"text":"graphonomous://graph/node/{id}"}]},{"id":"blk-66671","spans":[{"id":"spn-97126","text":"Individual node details + connected edges"}]}],[{"id":"blk-66672","spans":[{"id":"spn-97127","marks":["code"],"text":"graphonomous://graph/recent"}]},{"id":"blk-66673","spans":[{"id":"spn-97128","text":"Recently added/accessed nodes, sorted by recency"}]}],[{"id":"blk-66674","spans":[{"id":"spn-97129","marks":["code"],"text":"graphonomous://consolidation/log"}]},{"id":"blk-66675","spans":[{"id":"spn-97130","text":"Consolidator state + orchestrator plasticity metrics"}]}]]},{"id":"blk-66676","kind":"heading","level":2,"spans":[{"id":"spn-97131","text":"Node Types"}]},{"head":[{"id":"blk-66678","spans":[{"id":"spn-97132","text":"Type"}]},{"id":"blk-66679","spans":[{"id":"spn-97133","text":"Store When You Learn..."}]},{"id":"blk-66680","spans":[{"id":"spn-97134","text":"Examples"}]}],"id":"blk-66677","kind":"table","rows":[[{"id":"blk-66681","spans":[{"id":"spn-97135","marks":["bold"],"text":"semantic"}]},{"id":"blk-66682","spans":[{"id":"spn-97136","text":"A fact, definition, or architectural truth"}]},{"id":"blk-66683","spans":[{"id":"spn-97137","text":"\"Module X is responsible for Y\", \"The API uses JWT auth\""}]}],[{"id":"blk-66684","spans":[{"id":"spn-97138","marks":["bold"],"text":"procedural"}]},{"id":"blk-66685","spans":[{"id":"spn-97139","text":"A procedure, workflow, or recipe"}]},{"id":"blk-66686","spans":[{"id":"spn-97140","text":"\"To deploy: run X then Y then Z\""}]}],[{"id":"blk-66687","spans":[{"id":"spn-97141","marks":["bold"],"text":"episodic"}]},{"id":"blk-66688","spans":[{"id":"spn-97142","text":"Something that happened — an event or observation"}]},{"id":"blk-66689","spans":[{"id":"spn-97143","text":"\"Build failed due to missing dep\""}]}],[{"id":"blk-66690","spans":[{"id":"spn-