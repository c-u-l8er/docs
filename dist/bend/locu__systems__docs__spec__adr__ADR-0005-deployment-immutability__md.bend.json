":"list-item"},{"blocks":[{"id":"blk-92273","kind":"paragraph","spans":[{"id":"spn-155943","text":"Activation validation (wrong agent/user/state rejected)."}]}],"id":"blk-92272","kind":"list-item"},{"blocks":[{"id":"blk-92275","kind":"paragraph","spans":[{"id":"spn-155944","text":"Routing resolver uses "},{"id":"spn-155945","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-155946","text":" only."}]}],"id":"blk-92274","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92276","kind":"heading","level":3,"spans":[{"id":"spn-155947","text":"7.2 Integration tests (MUST)"}]},{"id":"blk-92277","items":[{"blocks":[{"id":"blk-92279","kind":"paragraph","spans":[{"id":"spn-155948","text":"Deploy creates new immutable record; a second deploy creates a second record."}]}],"id":"blk-92278","kind":"list-item"},{"blocks":[{"id":"blk-92281","kind":"paragraph","spans":[{"id":"spn-155949","text":"Activate (rollback) changes routing immediately."}]}],"id":"blk-92280","kind":"list-item"},{"blocks":[{"id":"blk-92283","kind":"paragraph","spans":[{"id":"spn-155950","text":"Concurrent deploy attempts are rejected with "},{"id":"spn-155951","marks":["code"],"text":"CONFLICT"},{"id":"spn-155952","text":" (v1)."}]}],"id":"blk-92282","kind":"list-item"},{"blocks":[{"id":"blk-92285","kind":"paragraph","spans":[{"id":"spn-155953","text":"Telemetry attribution includes correct "},{"id":"spn-155954","marks":["code"],"text":"deploymentId"},{"id":"spn-155955","text":"."}]}],"id":"blk-92284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92286","kind":"heading","level":3,"spans":[{"id":"spn-155956","text":"7.3 E2E tests (MUST)"}]},{"id":"blk-92287","items":[{"blocks":[{"id":"blk-92289","kind":"paragraph","spans":[{"id":"spn-155957","text":"Deploy v1 → invoke returns v1 output."}]}],"id":"blk-92288","kind":"list-item"},{"blocks":[{"id":"blk-92291","kind":"paragraph","spans":[{"id":"spn-155958","text":"Deploy v2 → invoke returns v2 output."}]}],"id":"blk-92290","kind":"list-item"},{"blocks":[{"id":"blk-92293","kind":"paragraph","spans":[{"id":"spn-155959","text":"Activate v1 → invoke returns v1 output again."}]}],"id":"blk-92292","kind":"list-item"},{"blocks":[{"id":"blk-92295","kind":"paragraph","spans":[{"id":"spn-155960","text":"Deployment history remains intact and visible."}]}],"id":"blk-92294","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92296","kind":"heading","level":2,"spans":[{"id":"spn-155961","text":"8) Future extensions enabled by this ADR"}]},{"id":"blk-92297","kind":"paragraph","spans":[{"id":"spn-155962","text":"This model is a foundation for:"}]},{"id":"blk-92298","items":[{"blocks":[{"id":"blk-92300","kind":"paragraph","spans":[{"id":"spn-155963","text":"canary/blue-green deployments (multiple “active” pointers with traffic split policies),"}]}],"id":"blk-92299","kind":"list-item"},{"blocks":[{"id":"blk-92302","kind":"paragraph","spans":[{"id":"spn-155964","text":"environment promotion (dev → staging → prod) with deployment immutability preserved,"}]}],"id":"blk-92301","kind":"list-item"},{"blocks":[{"id":"blk-92304","kind":"paragraph","spans":[{"id":"spn-155965","text":"signed deployment manifests / provenance,"}]}],"id":"blk-92303","kind":"list-item"},{"blocks":[{"id":"blk-92306","kind":"paragraph","spans":[{"id":"spn-155966","text":"provider billing reconciliation (resource tags + immutable providerRef),"}]}],"id":"blk-92305","kind":"list-item"},{"blocks":[{"id":"blk-92308","kind":"paragraph","spans":[{"id":"spn-155967","text":"more advanced rollback policies (automatic rollback on error rate thresholds)."}]}],"id":"blk-92307","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92309","kind":"heading","level":2,"spans":[{"id":"spn-155968","text":"9) Acceptance criteria"}]},{"id":"blk-92310","kind":"paragraph","spans":[{"id":"spn-155969","text":"This ADR is correctly implemented when:"}]},{"id":"blk-92311","items":[{"blocks":[{"id":"blk-92313","kind":"paragraph","spans":[{"id":"spn-155970","text":"Every deployment attempt creates a new deployment record and does not mutate previous deployments’ immutable fields."}]}],"id":"blk-92312","kind":"list-item"},{"blocks":[{"id":"blk-92315","kind":"paragraph","spans":[{"id":"spn-155971","text":"An agent’s invocations always route to "},{"id":"spn-155972","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-155973","text":" (no “latest deploy” routing)."}]}],"id":"blk-92314","kind":"list-item"},{"blocks":[{"id":"blk-92317","kind":"paragraph","spans":[{"id":"spn-155974","text":"Rollback is implemented as an activation/pointer update and takes effect immediately for new invocations."}]}],"id":"blk-92316","kind":"list-item"},{"blocks":[{"id":"blk-92319","kind":"paragraph","spans":[{"id":"spn-155975","text":"Deployment status transitions are correct and failures do not corrupt the active deployment pointer."}]}],"id":"blk-92318","kind":"list-item"},{"blocks":[{"id":"blk-92321","kind":"paragraph","spans":[{"id":"spn-155976","text":"Provider resources are tagged with "},{"id":"spn-155977","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-155978","text":"."}]}],"id":"blk-92320","kind":"list-item"},{"blocks":[{"id":"blk-92323","kind":"paragraph","spans":[{"id":"spn-155979","text":"E2E tests demonstrate deploy v1 → deploy v2 → rollback to v1 with correct outputs and preserved history."}]}],"id":"blk-92322","kind":"list-item"}],"kind":"list","ordered":true}],"edges":[],"id":"bagaaieraryu6bipjibr5its4fq6fxn3aim7tyflwz5mmkbwft7qodfittgnq","vocabulary":"ampersand.docs.fs.v1"}