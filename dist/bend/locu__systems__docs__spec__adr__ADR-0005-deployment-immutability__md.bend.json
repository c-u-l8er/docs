-item"},{"blocks":[{"id":"blk-92197","kind":"paragraph","spans":[{"id":"spn-155883","text":"The system SHOULD record an audit log entry:"}]}],"id":"blk-92196","kind":"list-item"},{"blocks":[{"id":"blk-92199","kind":"paragraph","spans":[{"id":"spn-155884","marks":["code"],"text":"deployment.activate"},{"id":"spn-155885","text":" with "},{"id":"spn-155886","marks":["code"],"text":"{agentId, deploymentId}"},{"id":"spn-155887","text":" and optional reason."}]}],"id":"blk-92198","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92200","kind":"heading","level":3,"spans":[{"id":"spn-155888","text":"6.4 Routing rules"}]},{"id":"blk-92201","kind":"paragraph","spans":[{"id":"spn-155889","text":"The invocation gateway MUST route using:"}]},{"id":"blk-92202","items":[{"blocks":[{"id":"blk-92204","kind":"paragraph","spans":[{"id":"spn-155890","text":"resolve agent and enforce ownership (unless public agents exist post-v1),"}]}],"id":"blk-92203","kind":"list-item"},{"blocks":[{"id":"blk-92206","kind":"paragraph","spans":[{"id":"spn-155891","text":"verify agent is not "},{"id":"spn-155892","marks":["code"],"text":"disabled"},{"id":"spn-155893","text":"/deleted,"}]}],"id":"blk-92205","kind":"list-item"},{"blocks":[{"id":"blk-92208","kind":"paragraph","spans":[{"id":"spn-155894","text":"read "},{"id":"spn-155895","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-155896","text":","}]}],"id":"blk-92207","kind":"list-item"},{"blocks":[{"id":"blk-92210","kind":"paragraph","spans":[{"id":"spn-155897","text":"load deployment by id and verify it belongs to agent and user,"}]}],"id":"blk-92209","kind":"list-item"},{"blocks":[{"id":"blk-92212","kind":"paragraph","spans":[{"id":"spn-155898","text":"route via runtime adapter selected by "},{"id":"spn-155899","marks":["code"],"text":"deployment.runtimeProvider"},{"id":"spn-155900","text":","}]}],"id":"blk-92211","kind":"list-item"},{"blocks":[{"id":"blk-92214","kind":"paragraph","spans":[{"id":"spn-155901","text":"invoke using "},{"id":"spn-155902","marks":["code"],"text":"deployment.providerRef"},{"id":"spn-155903","text":"."}]}],"id":"blk-92213","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-92215","kind":"paragraph","spans":[{"id":"spn-155904","text":"Routing MUST NOT use “latest deployment” heuristics."}]},{"id":"blk-92216","kind":"heading","level":3,"spans":[{"id":"spn-155905","text":"6.5 Deploy flow atomicity and failure handling"}]},{"id":"blk-92217","kind":"paragraph","spans":[{"id":"spn-155906","text":"A deployment flow typically spans multiple systems (DB + provider). The platform MUST handle partial failures."}]},{"id":"blk-92218","kind":"paragraph","spans":[{"id":"spn-155907","text":"Minimum v1 requirement:"}]},{"id":"blk-92219","items":[{"blocks":[{"id":"blk-92221","kind":"paragraph","spans":[{"id":"spn-155908","text":"The system MUST persist a deployment row with "},{"id":"spn-155909","marks":["code"],"text":"status=deploying"},{"id":"spn-155910","text":" before making provider calls."}]}],"id":"blk-92220","kind":"list-item"},{"blocks":[{"id":"blk-92223","kind":"paragraph","spans":[{"id":"spn-155911","text":"If provider deployment fails:"}]}],"id":"blk-92222","kind":"list-item"},{"blocks":[{"id":"blk-92225","kind":"paragraph","spans":[{"id":"spn-155912","text":"set deployment "},{"id":"spn-155913","marks":["code"],"text":"status=failed"},{"id":"spn-155914","text":" and store sanitized "},{"id":"spn-155915","marks":["code"],"text":"errorMessage"},{"id":"spn-155916","text":"."}]}],"id":"blk-92224","kind":"list-item"},{"blocks":[{"id":"blk-92227","kind":"paragraph","spans":[{"id":"spn-155917","text":"set agent "},{"id":"spn-155918","marks":["code"],"text":"status=error"},{"id":"spn-155919","text":" (or keep existing status but expose failure)."}]}],"id":"blk-92226","kind":"list-item"},{"blocks":[{"id":"blk-92229","kind":"paragraph","spans":[{"id":"spn-155920","text":"If provider deployment succeeds but DB update fails:"}]}],"id":"blk-92228","kind":"list-item"},{"blocks":[{"id":"blk-92231","kind":"paragraph","spans":[{"id":"spn-155921","text":"the system MUST have a retry mechanism (manual or automated) to reconcile:"}]}],"id":"blk-92230","kind":"list-item"},{"blocks":[{"id":"blk-92233","kind":"paragraph","spans":[{"id":"spn-155922","text":"either re-run the “finalize deploy” step idempotently, or"}]}],"id":"blk-92232","kind":"list-item"},{"blocks":[{"id":"blk-92235","kind":"paragraph","spans":[{"id":"spn-155923","text":"detect orphaned provider resources via tags and mark deployment active later."}]}],"id":"blk-92234","kind":"list-item"},{"blocks":[{"id":"blk-92237","kind":"paragraph","spans":[{"id":"spn-155924","text":"If DB update succeeds but provider deployment later fails (rare but possible due to eventual consistency):"}]}],"id":"blk-92236","kind":"list-item"},{"blocks":[{"id":"blk-92239","kind":"paragraph","spans":[{"id":"spn-155925","text":"system must reconcile on next healthcheck/invoke attempt and mark deployment failed if unusable."}]}],"id":"blk-92238","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92240","kind":"heading","level":3,"spans":[{"id":"spn-155926","text":"6.6 Provider resource tagging (required for cleanup and reconciliation)"}]},{"id":"blk-92241","kind":"paragraph","spans":[{"id":"spn-155927","text":"All provider resources created for a deployment MUST be tagged/labelled with:"}]},{"id":"blk-92242","items":[{"blocks":[{"id":"blk-92244","kind":"paragraph","spans":[{"id":"spn-155928","marks":["code"],"text":"userId"}]}],"id":"blk-92243","kind":"list-item"},{"blocks":[{"id":"blk-92246","kind":"paragraph","spans":[{"id":"spn-155929","marks":["code"],"text":"agentId"}]}],"id":"blk-92245","kind":"list-item"},{"blocks":[{"id":"blk-92248","kind":"paragraph","spans":[{"id":"spn-155930","marks":["code"],"text":"deploymentId"}]}],"id":"blk-92247","kind":"list-item"},{"blocks":[{"id":"blk-92250","kind":"paragraph","spans":[{"id":"spn-155931","marks":["code"],"text":"deploymentVersion"}]}],"i