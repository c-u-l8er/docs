{"bendscript":"0.1","blocks":[{"id":"blk-91939","kind":"heading","level":1,"spans":[{"id":"spn-155663","text":"ADR-0005: Deployment Immutability + Active Deployment Pointer Model"}]},{"id":"blk-91940","items":[{"blocks":[{"id":"blk-91942","kind":"paragraph","spans":[{"id":"spn-155664","marks":["bold"],"text":"Status:"},{"id":"spn-155665","text":" Accepted (v1)"}]}],"id":"blk-91941","kind":"list-item"},{"blocks":[{"id":"blk-91944","kind":"paragraph","spans":[{"id":"spn-155666","marks":["bold"],"text":"Date:"},{"id":"spn-155667","text":" 2026-01-21"}]}],"id":"blk-91943","kind":"list-item"},{"blocks":[{"id":"blk-91946","kind":"paragraph","spans":[{"id":"spn-155668","marks":["bold"],"text":"Owners:"},{"id":"spn-155669","text":" webhost.systems engineering"}]}],"id":"blk-91945","kind":"list-item"},{"blocks":[{"id":"blk-91948","kind":"paragraph","spans":[{"id":"spn-155670","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-91947","kind":"list-item"},{"blocks":[{"id":"blk-91950","kind":"paragraph","spans":[{"id":"spn-155671","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-91949","kind":"list-item"},{"blocks":[{"id":"blk-91952","kind":"paragraph","spans":[{"id":"spn-155672","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-91951","kind":"list-item"},{"blocks":[{"id":"blk-91954","kind":"paragraph","spans":[{"id":"spn-155673","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-91953","kind":"list-item"},{"blocks":[{"id":"blk-91956","kind":"paragraph","spans":[{"id":"spn-155674","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-91955","kind":"list-item"},{"blocks":[{"id":"blk-91958","kind":"paragraph","spans":[{"id":"spn-155675","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-91957","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91959","kind":"heading","level":2,"spans":[{"id":"spn-155676","text":"1) Context"}]},{"id":"blk-91960","kind":"paragraph","spans":[{"id":"spn-155677","text":"webhost.systems deploys untrusted customer agent code to one of multiple runtime providers and routes invocations to the correct deployed version. The platform must support:"}]},{"id":"blk-91961","items":[{"blocks":[{"id":"blk-91963","kind":"paragraph","spans":[{"id":"spn-155678","text":"safe, repeatable deployments,"}]}],"id":"blk-91962","kind":"list-item"},{"blocks":[{"id":"blk-91965","kind":"paragraph","spans":[{"id":"spn-155679","text":"rapid iteration with reliable rollbacks,"}]}],"id":"blk-91964","kind":"list-item"},{"blocks":[{"id":"blk-91967","kind":"paragraph","spans":[{"id":"spn-155680","text":"clear auditability (“what is running now, and who changed it?”),"}]}],"id":"blk-91966","kind":"list-item"},{"blocks":[{"id":"blk-91969","kind":"paragraph","spans":[{"id":"spn-155681","text":"consistent routing across multiple runtime providers,"}]}],"id":"blk-91968","kind":"list-item"},{"blocks":[{"id":"blk-91971","kind":"paragraph","spans":[{"id":"spn-155682","text":"robust handling of partial failures (deploy succeeded on provider but DB update failed; or vice versa),"}]}],"id":"blk-91970","kind":"list-item"},{"blocks":[{"id":"blk-91973","kind":"paragraph","spans":[{"id":"spn-155683","text":"deterministic metering attribution to "},{"id":"spn-155684","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-155685","text":"."}]}],"id":"blk-91972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91974","kind":"paragraph","spans":[{"id":"spn-155686","text":"Early prototypes often store deployment state “in place” on the agent record (e.g., overwriting "},{"id":"spn-155687","marks":["code"],"text":"workerUrl"},{"id":"spn-155688","text":", updating "},{"id":"spn-155689","marks":["code"],"text":"codeHash"},{"id":"spn-155690","text":", etc.). This tends to create correctness and support problems:"}]},{"id":"blk-91975","items":[{"blocks":[{"id":"blk-91977","kind":"paragraph","spans":[{"id":"spn-155691","text":"You lose historical context (“what changed?”)."}]}],"id":"blk-91976","kind":"list-item"},{"blocks":[{"id":"blk-91979","kind":"paragraph","spans":[{"id":"spn-155692","text":"Rollback is difficult or impossible without redeploying."}]}],"id":"blk-91978","kind":"list-item"},{"blocks":[{"id":"blk-91981","kind":"paragraph","spans":[{"id":"spn-155693","text":"In-flight deploys can corrupt the “current” state if they fail midway."}]}],"id":"blk-91980","kind":"list-item"},{"blocks":[{"id":"blk-91983","kind":"paragraph","spans":[{"id":"spn-155694","text":"Auditing, debugging, and cost reconciliation become fragile."}]}],"id":"blk-91982","kind":"list-item"},{"blocks":[{"id":"blk-91985","kind":"paragraph","spans":[{"id":"spn-155695","text":"Concurrency introduces race conditions: two deploys can interleave and leave the agent in an inconsistent state."}]}],"id":"blk-91984","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91986","kind":"paragraph","spans":[{"id":"spn-155696","text":"Therefore, the system needs a durable, auditable, and concurrency-tolerant model for deployments and routing."}]},{"id":"blk-91987","kind":"heading","level":2,"spans":[{"id":"spn-155697","text":"2) Decision"}]},{"id":"blk-91988","kind":"heading","level":3,"spans":[{"id":"spn-155698","text":"2.1 Deployment immutability"}]},{"id":"blk-91989","kind":"paragraph","spans":[{"id":"spn-155699","text":"A "},{"id":"spn-155700","marks":["bold"],"text":"Deployment"},{"id":"spn-155701","text":" is an immutable record representing a specific released version of an agent."}]},{"id":"blk-91990","items":[{"blocks":[{"id":"blk-91992","kind":"paragraph","spans":[{"id":"spn-155702","text":"A new deployment attempt MUST create a "},{"id":"spn-155703","marks":["bold"],"text":"new deployment record"},{"id":"spn-155704","text":" ("},{"id":"spn-155705","marks":["code"],"text":"deployments"},{"id":"spn-155706","text":" table row)."}]}],"id":"blk-91991","kind":"list-item"},{"blocks":[{"id":"blk-91994","kind":"paragraph","spans":[{"id":"spn-155707","text":"Deployment records MUST be treated as immutable after creation, except for a narrowly defined mutable subset:"}]}],"id":"blk-91993","kind":"list-item"},{"blocks":[{"id":"blk-91996","kind":"paragraph","spans":[{"id":"spn-155708","marks":["code"],"text":"status"},{"id":"spn-155709","text":" (e.g., deploying → active/failed)"}]}],"id":"blk-91995","kind":"list-item"},{"blocks":[{"id":"blk-91998","kind":"paragraph","spans":[{"id":"spn-155710","marks":["code"],"text":"providerRef"},{"id":"spn-155711","text":" (filled once known)"}]}],"id":"blk-91997","kind":"list-item"},{"blocks":[{"id":"blk-92000","kind":"paragraph","spans":[{"id":"spn-155712","marks":["code"],"text":"errorMessage"},{"id":"spn-155713","text":" (sanitized)"}]}],"id":"blk-91999","kind":"list-item"},{"blocks":[{"id":"blk-92002","kind":"paragraph","spans":[{"id":"spn-155714","text":"timestamps like "},{"id":"spn-155715","marks":["code"],"text":"deployedAtMs"},{"id":"spn-155716","text":" / "},{"id":"spn-155717","marks":["code"],"text":"finishedAtMs"}]}],"id":"blk-92001","kind":"list-item"},{"blocks":[{"id":"blk-92004","kind":"paragraph","spans":[{"id":"spn-155718","text":"optional "},{"id":"spn-155719","marks":["code"],"text":"logsRef"},{"id":"spn-155720","text":" pointer"}]}],"id":"blk-92003","kind":"list-item"},{"blocks":[{"id":"blk-92006","kind":"paragraph","spans":[{"id":"spn-155721","text":"Any new code/artifact/provider configuration change MUST create a new deployment record (never modify an existing deployment to “become” the new version)."}]}],"id":"blk-92005","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92007","kind":"heading","level":3,"spans":[{"id":"spn-155722","text":"2.2 Active deployment pointer"}]},{"id":"blk-92008","kind":"paragraph","spans":[{"id":"spn-155723","text":"Each agent has a single routing pointer:"}]},{"id":"blk-92009","items":[{"blocks":[{"id":"blk-92011","kind":"paragraph","spans":[{"id":"spn-155724","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-155725","text":" points to the deployment that should receive invocations."}]}],"id":"blk-92010","kind":"list-item"},{"blocks":[{"id":"blk-92013","kind":"paragraph","spans":[{"id":"spn-155726","text":"Rollback (and “activate old deployment”) is implemented by updating "},{"id":"spn-155727","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-155728","text":" to a previous deployment id."}]}],"id":"blk-92012","kind":"list-item"},{"blocks":[{"id":"blk-92015","kind":"paragraph","spans":[{"id":"spn-155729","text":"Invocation routing uses ONLY:"}]}],"id":"blk-92014","kind":"list-item"},{"blocks":[{"id":"blk-92017","kind":"paragraph","spans":[{"id":"spn-155730","text":"agent ownership checks + status checks, then"}]}],"id":"blk-92016","kind":"list-item"},{"blocks":[{"id":"blk-92019","kind":"paragraph","spans":[{"id":"spn-155731","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-155732","text":" → "},{"id":"spn-155733","marks":["code"],"text":"deployments.providerRef"},{"id":"spn-155734","text":" and "},{"id":"spn-155735","marks":["code"],"text":"deployments.runtimeProvider"},{"id":"spn-155736","text":" to select runtime adapter and invoke."}]}],"id":"blk-92018","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92020","kind":"heading","level":3,"spans":[{"id":"spn-155737","text":"2.3 Single-writer rule per agent during deploy (v1 simplification)"}]},{"id":"blk-92021","kind":"paragraph","spans":[{"id":"spn-155738","text":"To reduce complexity and prevent version races in v1:"}]},{"id":"blk-92022","items":[{"blocks":[{"id":"blk-92024","kind":"paragraph","spans":[{"id":"spn-155739","text":"The platform MUST prevent concurrent deployments per agent (e.g., guard with "},{"id":"spn-155740","marks":["code"],"text":"agents.status=deploying"},{"id":"spn-155741","text":" or a server-side mutex mechanism)."}]}],"id":"blk-92023","kind":"list-item"},{"blocks":[{"id":"blk-92026","kind":"paragraph","spans":[{"id":"spn-155742","text":"A second deploy attempt while "},{"id":"spn-155743","marks":["code"],"text":"deploying"},{"id":"spn-155744","text":" SHOULD fail with "},{"id":"spn-155745","marks":["code"],"text":"CONFLICT"},{"id":"spn-155746","text":" (or be queued post-v1)."}]}],"id":"blk-92025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92027","kind":"heading","level":2,"spans":[{"id":"spn-155747","text":"3) Rationale"}]},{"id":"blk-92028","kind":"heading","level":3,"spans":[{"id":"spn-155748","text":"3.1 Safety and correctness"}]},{"id":"blk-92029","kind":"paragraph","spans":[{"id":"spn-155749","text":"Immutability avoids a class of “torn writes” where partial updates leave the system in an inconsistent state. If deployment artifacts and references are immutable, you can always answer:"}]},{"id":"blk-92030","items":[{"blocks":[{"id":"blk-92032","kind":"paragraph","spans":[{"id":"spn-155750","text":"exactly what was deployed,"}]}],"id":"blk-92031","kind":"list-item"},{"blocks":[{"id":"blk-92034","kind":"paragraph","spans":[{"id":"spn-155751","text":"where it was deployed,"}]}],"id":"blk-92033","kind":"list-item"},{"blocks":[{"id":"blk-92036","kind":"paragraph","spans":[{"id":"spn-155752","text":"and when it changed."}]}],"id":"blk-92035","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92037","kind":"heading","level":3,"spans":[{"id":"spn-155753","text":"3.2 Rollbacks become fast and reliable"}]},{"id":"blk-92038","kind":"paragraph","spans":[{"id":"spn-155754","text":"With immutable deployments, rollback is primarily a pointer change:"}]},{"id":"blk-92039","items":[{"blocks":[{"id":"blk-92041","kind":"paragraph","spans":[{"id":"spn-155755","text":"no redeploy required (unless provider forces it for technical reasons),"}]}],"id":"blk-92040","kind":"list-item"},{"blocks":[{"id":"blk-92043","kind":"paragraph","spans":[{"id":"spn-155756","text":"quick recovery from bad deploys,"}]}],"id":"blk-92042","kind":"list-item"},{"blocks":[{"id":"blk-92045","kind":"paragraph","spans":[{"id":"spn-155757","text":"repeatable and auditable."}]}],"id":"blk-92044","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92046","kind":"heading","level":3,"spans":[{"id":"spn-155758","text":"3.3 Auditing and supportability"}]},{"id":"blk-92047","kind":"paragraph","spans":[{"id":"spn-155759","text":"A permanent deployment history supports:"}]},{"id":"blk-92048","items":[{"blocks":[{"id":"blk-92050","kind":"paragraph","spans":[{"id":"spn-155760","text":"customer support (“what changed?”),"}]}],"id":"blk-92049","kind":"list-item"},{"blocks":[{"id":"blk-92052","kind":"paragraph","spans":[{"id":"spn-155761","text":"incident response (“who activated what?”),"}]}],"id":"blk-92051","kind":"list-item"},{"blocks":[{"id":"blk-92054","kind":"paragraph","spans":[{"id":"spn-155762","text":"compliance-aligned audits."}]}],"id":"blk-92053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92055","kind":"heading","level":3,"spans":[{"id":"spn-155763","text":"3.4 Metering attribution and future cost reconciliation"}]},{"id":"blk-92056","kind":"paragraph","spans":[{"id":"spn-155764","text":"When telemetry references a "},{"id":"spn-155765","marks":["code"],"text":"deploymentId"},{"id":"spn-155766","text":" and deployments are immutable, usage can always be attributed to an exact version and provider resource set. This also enables future provider cost reconciliation by tagging provider resources per deployment."}]},{"id":"blk-92057","kind":"heading","level":3,"spans":[{"id":"spn-155767","text":"3.5 Multi-runtime routing simplicity"}]},{"id":"blk-92058","kind":"paragraph","spans":[{"id":"spn-155768","text":"A single "},{"id":"spn-155769","marks":["code"],"text":"activeDeploymentId"},{"id":"spn-155770","text":" model works uniformly across providers:"}]},{"id":"blk-92059","items":[{"blocks":[{"id":"blk-92061","kind":"paragraph","spans":[{"id":"spn-155771","text":"Cloudflare: "},{"id":"spn-155772","marks":["code"],"text":"providerRef.cloudflare.workerUrl"},{"id":"spn-155773","text":" etc."}]}],"id":"blk-92060","kind":"list-item"},{"blocks":[{"id":"blk-92063","kind":"paragraph","spans":[{"id":"spn-155774","text":"AgentCore: "},{"id":"spn-155775","marks":["code"],"text":"providerRef.agentcore.agentRuntimeArn"},{"id":"spn-155776","text":" etc."}]}],"id":"blk-92062","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92064","kind":"paragraph","spans":[{"id":"spn-155777","text":"The control plane remains provider-agnostic; provider-specific details are confined to adapter implementations."}]},{"id":"blk-92065","kind":"heading","level":2,"spans":[{"id":"spn-155778","text":"4) Alternatives considered"}]},{"id":"blk-92066","kind":"heading","level":3,"spans":[{"id":"spn-155779","text":"A) Mutable deployment state stored on the agent row only"}]},{"id":"blk-92067","kind":"paragraph","spans":[{"id":"spn-155780","marks":["bold"],"text":"Pros"}]},{"id":"blk-92068","items":[{"blocks":[{"id":"blk-92070","kind":"paragraph","spans":[{"id":"spn-155781","text":"Minimal schema."}]}],"id":"blk-92069","kind":"list-item"},{"blocks":[{"id":"blk-92072","kind":"paragraph","spans":[{"id":"spn-155782","text":"Simplifies “what’s currently active” (single record)."}]}],"id":"blk-92071","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92073","kind":"paragraph","spans":[{"id":"spn-155783","marks":["bold"],"text":"Cons"}]},{"id":"blk-92074","items":[{"blocks":[{"id":"blk-92076","kind":"paragraph","spans":[{"id":"spn-155784","text":"Loses history."}]}],"id":"blk-92075","kind":"list-item"},{"blocks":[{"id":"blk-92078","kind":"paragraph","spans":[{"id":"spn-155785","text":"Hard to rollback."}]}],"id":"blk-92077","kind":"list-item"},{"blocks":[{"id":"blk-92080","kind":"paragraph","spans":[{"id":"spn-155786","text":"Partial failures can corrupt the running pointer."}]}],"id":"blk-92079","kind":"list-item"},{"blocks":[{"id":"blk-92082","kind":"paragraph","spans":[{"id":"spn-155787","text":"Difficult to audit and debug."}]}],"id":"blk-92081","kind":"list-item"},{"blocks":[{"id":"blk-92084","kind":"paragraph","spans":[{"id":"spn-155788","text":"Makes telemetry attribution ambiguous when “current deployment” changes."}]}],"id":"blk-92083","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92085","kind":"paragraph","spans":[{"id":"spn-155789","marks":["bold"],"text":"Decision:"},{"id":"spn-155790","text":" Rejected."}]},{"id":"blk-92086","kind":"heading","level":3,"spans":[{"id":"spn-155791","text":"B) Immutable deployments without an active pointer (derive “active” from latest successful deploy)"}]},{"id":"blk-92087","kind":"paragraph","spans":[{"id":"spn-155792","marks":["bold"],"text":"Pros"}]},{"id":"blk-92088","items":[{"blocks":[{"id":"blk-92090","kind":"paragraph","spans":[{"id":"spn-155793","text":"No pointer updates; “active” is last successful deployment."}]}],"id":"blk-92089","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92091","kind":"paragraph","spans":[{"id":"spn-155794","marks":["bold"],"text":"Cons"}]},{"id":"blk-92092","items":[{"blocks":[{"id":"blk-92094","kind":"paragraph","spans":[{"id":"spn-155795","text":"Rollback becomes non-trivial (must “fake” a new deploy or add flags)."}]}],"id":"blk-92093","kind":"list-item"},{"blocks":[{"id":"blk-92096","kind":"paragraph","spans":[{"id":"spn-155796","text":"“Latest” is not always what you want running (e.g., canary, manual pinning)."}]}],"id":"blk-92095","kind":"list-item"},{"blocks":[{"id":"blk-92098","kind":"paragraph","spans":[{"id":"spn-155797","text":"In-flight deploys complicate “latest success” semantics."}]}],"id":"blk-92097","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92099","kind":"paragraph","spans":[{"id":"spn-155798","marks":["bold"],"text":"Decision:"},{"id":"spn-155799","text":" Rejected."}]},{"id":"blk-92100","kind":"heading","level":3,"spans":[{"id":"spn-155800","text":"C) Mutable “active deployment” record plus separate immutable history"}]},{"id":"blk-92101","kind":"paragraph","spans":[{"id":"spn-155801","marks":["bold"],"text":"Pros"}]},{"id":"blk-92102","items":[{"blocks":[{"id":"blk-92104","kind":"paragraph","spans":[{"id":"spn-155802","text":"A dedicated active record could simplify reads."}]}],"id":"blk-92103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92105","kind":"paragraph","spans":[{"id":"spn-155803","marks":["bold"],"text":"Cons"}]},{"id":"blk-92106","items":[{"blocks":[{"id":"blk-92108","kind":"paragraph","spans":[{"id":"spn-155804","text":"You now have two sources of truth to keep consistent."}]}],"id":"blk-92107","kind":"list-item"},{"blocks":[{"id":"blk-92110","kind":"paragraph","spans":[{"id":"spn-155805","text":"Reintroduces mutability issues for the “active” record."}]}],"id":"blk-92109","kind":"list-item"},{"blocks":[{"id":"blk-92112","kind":"paragraph","spans":[{"id":"spn-155806","text":"Added complexity with limited benefit over a pointer."}]}],"id":"blk-92111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92113","kind":"paragraph","spans":[{"id":"spn-155807","marks":["bold"],"text":"Decision:"},{"id":"spn-155808","text":" Rejected."}]},{"id":"blk-92114","kind":"heading","level":3,"spans":[{"id":"spn-155809","text":"D) Blue/green or canary routing model as default"}]},{"id":"blk-92115","kind":"paragraph","spans":[{"id":"spn-155810","marks":["bold"],"text":"Pros"}]},{"id":"blk-92116","items":[{"blocks":[{"id":"blk-92118","kind":"paragraph","spans":[{"id":"spn-155811","text":"Advanced rollout safety."}]}],"id":"blk-92117","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92119","kind":"paragraph","spans":[{"id":"spn-155812","marks":["bold"],"text":"Cons"}]},{"id":"blk-92120","items":[{"blocks":[{"id":"blk-92122","kind":"paragraph","spans":[{"id":"spn-155813","text":"Too complex for v1."}]}],"id":"blk-92121","kind":"list-item"},{"blocks":[{"id":"blk-92124","kind":"paragraph","spans":[{"id":"spn-155814","text":"Requires traffic splitting, per-request routing policies, and richer metrics gating."}]}],"id":"blk-92123","kind":"list-item"},{"blocks":[{"id":"blk-92126","kind":"paragraph","spans":[{"id":"spn-155815","text":"Still requires immutable deployments underneath."}]}],"id":"blk-92125","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92127","kind":"paragraph","spans":[{"id":"spn-155816","marks":["bold"],"text":"Decision:"},{"id":"spn-155817","text":" Deferred to post-v1; can be built on top of this ADR."}]},{"id":"blk-92128","kind":"heading","level":2,"spans":[{"id":"spn-155818","text":"5) Consequences"}]},{"id":"blk-92129","kind":"heading","level":3,"spans":[{"id":"spn-155819","text":"5.1 Positive consequences"}]},{"id":"blk-92130","items":[{"blocks":[{"id":"blk-92132","kind":"paragraph","spans":[{"id":"spn-155820","text":"Reliable rollback (pointer flip)."}]}],"id":"blk-92131","kind":"list-item"},{"blocks":[{"id":"blk-92134","kind":"paragraph","spans":[{"id":"spn-155821","text":"Clear deployment audit trail."}]}],"id":"blk-92133","kind":"list-item"},{"blocks":[{"id":"blk-92136","kind":"paragraph","spans":[{"id":"spn-155822","text":"Strong basis for incident response and debugging."}]}],"id":"blk-92135","kind":"list-item"},{"blocks":[{"id":"blk-92138","kind":"paragraph","spans":[{"id":"spn-155823","text":"Simplified multi-runtime invocation routing."}]}],"id":"blk-92137","kind":"list-item"},{"blocks":[{"id":"blk-92140","kind":"paragraph","spans":[{"id":"spn-155824","text":"Enables deterministic telemetry attribution and later cost reconciliation."}]}],"id":"blk-92139","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92141","kind":"heading","level":3,"spans":[{"id":"spn-155825","text":"5.2 Negative consequences / tradeoffs"}]},{"id":"blk-92142","items":[{"blocks":[{"id":"blk-92144","kind":"paragraph","spans":[{"id":"spn-155826","text":"More schema and records (deployments grow over time)."}]}],"id":"blk-92143","kind":"list-item"},{"blocks":[{"id":"blk-92146","kind":"paragraph","spans":[{"id":"spn-155827","text":"Requires retention policy decisions for old deployments (storage cleanup, provider resource deprovisioning)."}]}],"id":"blk-92145","kind":"list-item"},{"blocks":[{"id":"blk-92148","kind":"paragraph","spans":[{"id":"spn-155828","text":"Requires careful handling of “deploy succeeded but DB update failed” and vice versa."}]}],"id":"blk-92147","kind":"list-item"},{"blocks":[{"id":"blk-92150","kind":"paragraph","spans":[{"id":"spn-155829","text":"Requires a versioning strategy (monotonic per agent) and concurrency controls."}]}],"id":"blk-92149","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-92151","kind":"heading","level":2,"spans":[{"id":"spn-155830","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-92152","kind":"heading","level":3,"spans":[{"id":"spn-155831","text":"6.1 Data model requirements"}]},{"id":"blk-92153","kind":"paragraph","spans":[{"id":"spn-155832","text":"The following fields/semantics MUST exist (names may vary if consistent):"}]},{"id":"blk-92154","items":[{"blocks":[{"id":"blk-92156","kind":"paragraph","spans":[{"id":"spn-155833","marks":["code"],"text":"deployments"},{"id":"spn-155834","text":" table with:"}]}],"id":"blk-92155","kind":"list-item"},{"blocks":[{"id":"blk-92158","kind":"paragraph","spans":[{"id":"spn-155835","marks":["code"],"text":"agentId"},{"id":"spn-155836","text":", "},{"id":"spn-155837","marks":["code"],"text":"userId"}]}],"id":"blk-92157","kind":"list-item"},{"blocks":[{"id":"blk-92160","kind":"paragraph","spans":[{"id":"spn-155838","marks":["code"],"text":"version"},{"id":"spn-155839","text":" (monotonic per agent)"}]}],"id":"blk-92159","kind":"list-item"},{"blocks":[{"id":"blk-92162","kind":"paragraph","spans":[{"id":"spn-155840","marks":["code"],"text":"runtimeProvider"}]}],"id":"blk-92161","kind":"list-item"},{"blocks":[{"id":