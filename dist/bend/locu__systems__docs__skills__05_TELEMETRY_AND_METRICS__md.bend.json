{"bendscript":"0.1","blocks":[{"id":"blk-83166","kind":"heading","level":1,"spans":[{"id":"spn-147622","text":"05 — Telemetry and Metrics"}]},{"blocks":[{"id":"blk-83168","kind":"paragraph","spans":[{"id":"spn-147623","marks":["bold"],"text":"Purpose:"},{"id":"spn-147624","text":" How telemetry events flow from the data plane to the control plane, the metrics schema, authentication (HMAC/signed JWT), ingestion, aggregation into billing_usage, and time-series queries."}]}],"id":"blk-83167","kind":"quote"},{"id":"blk-83169","kind":"heading","level":2,"spans":[{"id":"spn-147625","text":"Telemetry Flow"}]},{"id":"blk-83170","kind":"code","language":"text","text":"Data Plane (Worker/DO or AgentCore)\n  |\n  | POST /functions/v1/metrics/report (HMAC-signed)\n  |\n  v\nEdge Function (telemetry ingestion)\n  |\n  | Verify HMAC -> INSERT into metrics_events\n  |\n  v\npg_cron (periodic aggregation)\n  |\n  | SUM/GROUP BY user_id + period_key\n  |\n  v\nbilling_usage table\n  |\n  v\nDashboard / Limit Checks"},{"id":"blk-83171","kind":"heading","level":2,"spans":[{"id":"spn-147626","text":"Metrics Event Schema"}]},{"head":[{"id":"blk-83173","spans":[{"id":"spn-147627","text":"Field"}]},{"id":"blk-83174","spans":[{"id":"spn-147628","text":"Type"}]},{"id":"blk-83175","spans":[{"id":"spn-147629","text":"Description"}]}],"id":"blk-83172","kind":"table","rows":[[{"id":"blk-83176","spans":[{"id":"spn-147630","marks":["code"],"text":"id"}]},{"id":"blk-83177","spans":[{"id":"spn-147631","text":"UUID"}]},{"id":"blk-83178","spans":[{"id":"spn-147632","text":"Auto-generated"}]}],[{"id":"blk-83179","spans":[{"id":"spn-147633","marks":["code"],"text":"user_id"}]},{"id":"blk-83180","spans":[{"id":"spn-147634","text":"UUID"}]},{"id":"blk-83181","spans":[{"id":"spn-147635","text":"Event owner"}]}],[{"id":"blk-83182","spans":[{"id":"spn-147636","marks":["code"],"text":"agent_id"}]},{"id":"blk-83183","spans":[{"id":"spn-147637","text":"UUID"}]},{"id":"blk-83184","spans":[{"id":"spn-147638","text":"Agent that was invoked"}]}],[{"id":"blk-83185","spans":[{"id":"spn-147639","marks":["code"],"text":"deployment_id"}]},{"id":"blk-83186","spans":[{"id":"spn-147640","text":"UUID"}]},{"id":"blk-83187","spans":[{"id":"spn-147641","text":"Specific deployment version"}]}],[{"id":"blk-83188","spans":[{"id":"spn-147642","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-83189","spans":[{"id":"spn-147643","text":"enum"}]},{"id":"blk-83190","spans":[{"id":"spn-147644","marks":["code"],"text":"cloudflare"},{"id":"spn-147645","text":" or "},{"id":"spn-147646","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-83191","spans":[{"id":"spn-147647","marks":["code"],"text":"timestamp_ms"}]},{"id":"blk-83192","spans":[{"id":"spn-147648","text":"bigint"}]},{"id":"blk-83193","spans":[{"id":"spn-147649","text":"Unix ms when invocation occurred"}]}],[{"id":"blk-83194","spans":[{"id":"spn-147650","marks":["code"],"text":"requests"}]},{"id":"blk-83195","spans":[{"id":"spn-147651","text":"int"}]},{"id":"blk-83196","spans":[{"id":"spn-147652","text":"Always 1 per event"}]}],[{"id":"blk-83197","spans":[{"id":"spn-147653","marks":["code"],"text":"llm_tokens"}]},{"id":"blk-83198","spans":[{"id":"spn-147654","text":"int"}]},{"id":"blk-83199","spans":[{"id":"spn-147655","text":"Token count (actual or estimated)"}]}],[{"id":"blk-83200","spans":[{"id":"spn-147656","marks":["code"],"text":"compute_ms"}]},{"id":"blk-83201","spans":[{"id":"spn-147657","text":"int"}]},{"id":"blk-83202","spans":[{"id":"spn-147658","text":"Wall-clock execution time"}]}],[{"id":"blk-83203","spans":[{"id":"spn-147659","marks":["code"],"text":"errors"}]},{"id":"blk-83204","spans":[{"id":"spn-147660","text":"int"}]},{"id":"blk-83205","spans":[{"id":"spn-147661","text":"0 or 1"}]}],[{"id":"blk-83206","spans":[{"id":"spn-147662","marks":["code"],"text":"error_class"}]},{"id":"blk-83207","spans":[{"id":"spn-147663","text":"string?"}]},{"id":"blk-83208","spans":[{"id":"spn-147664","text":"Error category if errors > 0"}]}],[{"id":"blk-83209","spans":[{"id":"spn-147665","marks":["code"],"text":"provider_details"}]},{"id":"blk-83210","spans":[{"id":"spn-147666","text":"JSONB"}]},{"id":"blk-83211","spans":[{"id":"spn-147667","text":"Provider-specific metadata"}]}],[{"id":"blk-83212","spans":[{"id":"spn-147668","marks":["code"],"text":"cost_usd_estimated"}]},{"id":"blk-83213","spans":[{"id":"spn-147669","text":"numeric"}]},{"id":"blk-83214","spans":[{"id":"spn-147670","text":"Estimated cost in USD"}]}],[{"id":"blk-83215","spans":[{"id":"spn-147671","marks":["code"],"text":"trace_id"}]},{"id":"blk-83216","spans":[{"id":"spn-147672","text":"string"}]},{"id":"blk-83217","spans":[{"id":"spn-147673","text":"Correlation ID for tracing"}]}]]},{"id":"blk-83218","kind":"heading","level":2,"spans":[{"id":"spn-147674","text":"Telemetry Authentication"}]},{"id":"blk-83219","kind":"paragraph","spans":[{"id":"spn-147675","text":"Unauthenticated telemetry events are "},{"id":"spn-147676","marks":["bold"],"text":"rejected"},{"id":"spn-147677","text":". Two authentication methods are supported:"}]},{"id":"blk-83220","kind":"heading","level":3,"spans":[{"id":"spn-147678","text":"Option A: HMAC Signature"}]},{"id":"blk-83221","kind":"paragraph","spans":[{"id":"spn-147679","text":"A per-deployment HMAC key is generated at deploy time, stored in Supabase Vault, and injected into the runtime as an environment variable."}]},{"id":"blk-83222","kind":"code","language":"text","text":"X-Telemetry-Signature: sha256=<hmac-hex>\nX-Telemetry-Timestamp: <unix-ms>"},{"id":"blk-83223","kind":"paragraph","spans":[{"id":"spn-147680","text":"The ingestion endpoint verifies:"}]},{"id":"blk-83224","items":[{"blocks":[{"id":"blk-83226","kind":"paragraph","spans":[{"id":"spn-147681","text":"Timestamp is within 5-minute window (anti-replay)"}]}],"id":"blk-83225","kind":"list-item"},{"blocks":[{"id":"blk-83228","kind":"paragraph","spans":[{"id":"spn-147682","text":"HMAC matches "},{"id":"spn-147683","marks":["code"],"text":"HMAC-SHA256(key, timestamp + body)"}]}],"id":"blk-83227","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-83229","kind":"heading","level":3,"spans":[{"id":"spn-147684","text":"Option B: Signed JWT"}]},{"id":"blk-83230","kind":"paragraph","spans":[{"id":"spn-147685","text":"The control plane mints a short-lived JWT at deploy time, embedded in the runtime config. The ingestion endpoint validates the JWT signature and claims."}]},{"id":"blk-83231","kind":"heading","level":2,"spans":[{"id":"spn-147686","text":"Ingestion Endpoint"}]},{"id":"blk-83232","kind":"code","language":"text","text":"POST /functions/v1/metrics/report\nContent-Type: application/json\nX-Telemetry-Signature: sha256=<hmac>\nX-Telemetry-Timestamp: 1706832000000\n\n{\n  \"agent_id\": \"<uuid>\",\n  \"deployment_id\": \"<uuid>\",\n  \"user_id\": \"<uuid>\",\n  \"runtime_provider\": \"cloudflare\",\n  \"timestamp_ms\": 1706832000000,\n  \"requests\": 1,\n  \"llm_tokens\": 150,\n  \"compute_ms\": 340,\n  \"errors\": 0,\n  \"cost_usd_estimated\": 0.0023,\n  \"trace_id\": \"tr_abc123\"\n}"},{"id":"blk-83233","kind":"paragraph","spans":[{"id":"spn-147687","text":"The Edge Function validates the signature, then inserts into "},{"id":"spn-147688","marks":["code"],"text":"metrics_events"},{"id":"spn-147689","text":". Attribution fields ("},{"id":"spn-147690","marks":["code"],"text":"agent_id"},{"id":"spn-147691","text":", "},{"id":"spn-147692","marks":["code"],"text":"deployment_id"},{"id":"spn-147693","text":", "},{"id":"spn-147694","marks":["code"],"text":"user_id"},{"id":"spn-147695","text":") are verified against the deployment record to prevent spoofing."}]},{"id":"blk-83234","kind":"heading","level":2,"spans":[{"id":"spn-147696","text":"Aggregation via pg_cron"}]},{"id":"blk-83235","kind":"paragraph","spans":[{"id":"spn-147697","text":"A scheduled PostgreSQL job runs periodically (e.g., every 5 minutes) to aggregate raw events into "},{"id":"spn-147698","marks":["code"],"text":"billing_usage"},{"id":"spn-147699","text":":"}]},{"id":"blk-83236","kind":"code","language":"sql","text":"INSERT INTO billing_usage (user_id, period_key,\n  total_requests, total_tokens, total_compute_ms, total_cost_usd_estimated)\nSELECT\n  user_id,\n  to_char(to_timestamp(timestamp_ms / 1000), 'YYYY-MM') AS period_key,\n  SUM(requests),\n  SUM(llm_tokens),\n  SUM(compute_ms),\n  SUM(cost_usd_estimated)\nFROM metrics_events\nWHERE timestamp_ms > last_aggregated_ms()\nGROUP BY user_id, period_key\nON CONFLICT (user_id, period_key) DO UPDATE SET\n  total_requests = billing_usage.total_requests + EXCLUDED.total_requests,\n  total_tokens = billing_usage.total_tokens + EXCLUDED.total_tokens,\n  total_compute_ms = billing_usage.total_compute_ms + EXCLUDED.total_compute_ms,\n  total_cost_usd_estimated = billing_usage.total_cost_usd_estimated + EXCLUDED.total_cost_usd_estimated,\n  updated_at = now();"},{"id":"blk-83237","kind":"heading","level":2,"spans":[{"id":"spn-147700","text":"Time-Series Queries"}]},{"id":"blk-83238","kind":"paragraph","spans":[{"id":"spn-147701","text":"The dashboard queries "},{"id":"spn-147702","marks":["code"],"text":"metrics_events"},{"id":"spn-147703","text":" for time-series visualization:"}]},{"id":"blk-83239","kind":"code","language":"sql","text":"SELECT\n  date_trunc('hour', to_timestamp(timestamp_ms / 1000)) AS bucket,\n  SUM(requests) AS requests,\n  SUM(llm_tokens) AS tokens,\n  SUM(compute_ms) AS compute_ms,\n  SUM(errors) AS errors\nFROM metrics_events\nWHERE agent_id = $1\n  AND timestamp_ms BETWEEN $2 AND $3\nGROUP BY bucket\nORDER BY bucket;"},{"id":"blk-83240","kind":"paragraph","spans":[{"id":"spn-147704","text":"Supported windows: 1h, 6h, 24h, 7d, 30d."}]},{"id":"blk-83241","kind":"heading","level":2,"spans":[{"id":"spn-147705","text":"Checklist"}]},{"id":"blk-83242","items":[{"blocks":[{"id":"blk-83244","kind":"paragraph","spans":[{"id":"spn-147706","text":"[ ] Every invocation emits exactly one telemetry event"}]}],"id":"blk-83243","kind":"list-item"},{"blocks":[{"id":"blk-83246","kind":"paragraph","spans":[{"id":"spn-147707","text":"[ ] Telemetry endpoint rejects unauthenticated events"}]}],"id":"blk-83245","kind":"list-item"},{"blocks":[{"id":"blk-83248","kind":"paragraph","spans":[{"id":"spn-147708","text":"[ ] HMAC key is generated per deployment and stored in Vault"}]}],"id":"blk-83247","kind":"list-item"},{"blocks":[{"id":"blk-83250","kind":"paragraph","spans":[{"id":"spn-147709","text":"[ ] Timestamp anti-replay window is enforced (5 minutes)"}]}],"id":"blk-83249","kind":"list-item"},{"blocks":[{"id":"blk-83252","kind":"paragraph","spans":[{"id":"spn-147710","text":"[ ] Attribution fields are verified against deployment records"}]}],"id":"blk-83251","kind":"list-item"},{"blocks":[{"id":"blk-83254","kind":"paragraph","spans":[{"id":"spn-147711","text":"[ ] pg_cron aggregation runs on schedule"}]}],"id":"blk-83253","kind":"list-item"},{"blocks":[{"id":"blk-83256","kind":"paragraph","spans":[{"id":"spn-147712","text":"[ ] billing_usage is updated incrementally (not full recompute)"}]}],"id":"blk-83255","kind":"list-item"},{"blocks":[{"id":"blk-83258","kind":"paragraph","spans":[{"id":"spn-147713","text":"[ ] Time-series queries use indexed columns ("},{"id":"spn-147714","marks":["code"],"text":"agent_id"},{"id":"spn-147715","text":", "},{"id":"spn-147716","marks":["code"],"text":"timestamp_ms"},{"id":"spn-147717","text":")"}]}],"id":"blk-83257","kind":"list-item"},{"blocks":[{"id":"blk-83260","kind":"paragraph","spans":[{"id":"spn-147718","text":"[ ] "},{"id":"spn-147719","marks":["code"],"text":"cost_usd_estimated"},{"id":"spn-147720","text":" uses provider-specific calculators"}]}],"id":"blk-83259","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierah3c3dqpst35rwihc2qzrlpum3b32gnsarl2mcenfw5hblewlgqma","vocabulary":"ampersand.docs.fs.v1"}