{"bendscript":"0.1","blocks":[{"id":"blk-55595","kind":"heading","level":1,"spans":[{"id":"spn-106874","text":"body-browser"}]},{"id":"blk-55596","kind":"paragraph","spans":[{"id":"spn-106875","text":"GRASP "},{"id":"spn-106876","marks":["code"],"text":"&body.browser"},{"id":"spn-106877","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-55597","kind":"paragraph","spans":[{"id":"spn-106878","text":"Provides the authoritative substrate for browser embodiment: typed perception, affordance enumeration, StateHash-anchored replay, and InteractionTrace recording — the missing half of Graphonomous's "},{"id":"spn-106879","marks":["code"],"text":"&memory.episodic.store/replay"},{"id":"spn-106880","text":" loop."}]},{"id":"blk-55598","kind":"heading","level":2,"spans":[{"id":"spn-106881","text":"Status"}]},{"id":"blk-55599","items":[{"blocks":[{"id":"blk-55601","kind":"paragraph","spans":[{"id":"spn-106882","marks":["bold"],"text":"Library:"},{"id":"spn-106883","text":" production-ready"}]}],"id":"blk-55600","kind":"list-item"},{"blocks":[{"id":"blk-55603","kind":"paragraph","spans":[{"id":"spn-106884","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-106885","text":" 12/12 GRASP §9 conformance tests pass"}]}],"id":"blk-55602","kind":"list-item"},{"blocks":[{"id":"blk-55605","kind":"paragraph","spans":[{"id":"spn-106886","marks":["bold"],"text":"MCP server:"},{"id":"spn-106887","text":" shipped — 7 tools on the "},{"id":"spn-106888","marks":["code"],"text":"body-browser"},{"id":"spn-106889","text":" namespace (ensure_session + 6 GRASP operations), 12 MCP unit tests"}]}],"id":"blk-55604","kind":"list-item"},{"blocks":[{"id":"blk-55607","kind":"paragraph","spans":[{"id":"spn-106890","marks":["bold"],"text":"AgentBrowser backend (real Chromium):"},{"id":"spn-106891","text":" skeleton — subprocess wiring documented, pending"}]}],"id":"blk-55606","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55608","kind":"heading","level":2,"spans":[{"id":"spn-106892","text":"MCP surface"}]},{"id":"blk-55609","kind":"code","language":"text","text":"body_browser_ensure_session  — create or re-bind a session by id\nbody_browser_perceive        — typed observation (EnvironmentObservation)\nbody_browser_affordances     — policy-filtered AffordanceSet\nbody_browser_encode_state    — deterministic StateHash\nbody_browser_act             — execute one TypedAction\nbody_browser_dry_run         — predicted outcome (no mutation)\nbody_browser_replay          — fail-fast replay of an InteractionTrace"},{"id":"blk-55610","kind":"paragraph","spans":[{"id":"spn-106893","text":"Every tool takes a "},{"id":"spn-106894","marks":["code"],"text":"session_id"},{"id":"spn-106895","text":" so multiple agents can drive independent browser sessions concurrently from the same server process. Sessions are supervised under "},{"id":"spn-106896","marks":["code"],"text":"BodyBrowser.SessionSupervisor"},{"id":"spn-106897","text":" and addressed through the "},{"id":"spn-106898","marks":["code"],"text":"BodyBrowser.SessionRegistry"},{"id":"spn-106899","text":"."}]},{"id":"blk-55611","kind":"heading","level":2,"spans":[{"id":"spn-106900","text":"The contract (GRASP §11)"}]},{"id":"blk-55612","kind":"paragraph","spans":[{"id":"spn-106901","text":"A conforming "},{"id":"spn-106902","marks":["code"],"text":"&body.browser"},{"id":"spn-106903","text":" provider exposes six operations:"}]},{"head":[{"id":"blk-55614","spans":[{"id":"spn-106904","text":"operation"}]},{"id":"blk-55615","spans":[{"id":"spn-106905","text":"input"}]},{"id":"blk-55616","spans":[{"id":"spn-106906","text":"output"}]},{"id":"blk-55617","spans":[{"id":"spn-106907","text":"deterministic"}]}],"id":"blk-55613","kind":"table","rows":[[{"id":"blk-55618","spans":[{"id":"spn-106908","marks":["code"],"text":"perceive"}]},{"id":"blk-55619","spans":[{"id":"spn-106909","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-55620","spans":[{"id":"spn-106910","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-55621","spans":[{"id":"spn-106911","text":"✅"}]}],[{"id":"blk-55622","spans":[{"id":"spn-106912","marks":["code"],"text":"affordances"}]},{"id":"blk-55623","spans":[{"id":"spn-106913","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-55624","spans":[{"id":"spn-106914","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-55625","spans":[{"id":"spn-106915","text":"✅"}]}],[{"id":"blk-55626","spans":[{"id":"spn-106916","marks":["code"],"text":"encode_state"}]},{"id":"blk-55627","spans":[{"id":"spn-106917","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-55628","spans":[{"id":"spn-106918","marks":["code"],"text":"StateHash"}]},{"id":"blk-55629","spans":[{"id":"spn-106919","text":"✅"}]}],[{"id":"blk-55630","spans":[{"id":"spn-106920","marks":["code"],"text":"act"}]},{"id":"blk-55631","spans":[{"id":"spn-106921","marks":["code"],"text":"TypedAction"}]},{"id":"blk-55632","spans":[{"id":"spn-106922","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-55633","spans":[{"id":"spn-106923","text":"❌ side-effecting"}]}],[{"id":"blk-55634","spans":[{"id":"spn-106924","marks":["code"],"text":"replay"}]},{"id":"blk-55635","spans":[{"id":"spn-106925","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-55636","spans":[{"id":"spn-106926","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-55637","spans":[{"id":"spn-106927","text":"❌ side-effecting"}]}],[{"id":"blk-55638","spans":[{"id":"spn-106928","marks":["code"],"text":"dry_run"}]},{"id":"blk-55639","spans":[{"id":"spn-106929","marks":["code"],"text":"TypedAction"}]},{"id":"blk-55640","spans":[{"id":"spn-106930","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-55641","spans":[{"id":"spn-106931","text":"✅"}]}]]},{"id":"blk-55642","kind":"heading","level":2,"spans":[{"id":"spn-106932","text":"Five invariants (GRASP §7, all enforced by "},{"id":"spn-106933","marks":["code"],"text":"BodyBrowser.Session"},{"id":"spn-106934","text":")"}]},{"head":[{"id":"blk-55644","spans":[{"id":"spn-106935","text":"#"}]},{"id":"blk-55645","spans":[{"id":"spn-106936","text":"invariant"}]},{"id":"blk-55646","spans":[{"id":"spn-106937","text":"where enforced"}]}],"id":"blk-55643","kind":"table","rows":[[{"id":"blk-55647","spans":[{"id":"spn-106938","text":"I1"}]},{"id":"blk-55648","spans":[{"id":"spn-106939","text":"perceive-before-act (stale refs rejected)"}]},{"id":"blk-55649","spans":[{"id":"spn-106940","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-55650","spans":[{"id":"spn-106941","text":"I2"}]},{"id":"blk-55651","spans":[{"id":"spn-106942","text":"affordance-bounded action"}]},{"id":"blk-55652","spans":[{"id":"spn-106943","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-55653","spans":[{"id":"spn-106944","text":"I3"}]},{"id":"blk-55654","spans":[{"id":"spn-106945","text":"policy-filtered affordances"}]},{"id":"blk-55655","spans":[{"id":"spn-106946","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-55656","spans":[{"id":"spn-106947","text":"I4"}]},{"id":"blk-55657","spans":[{"id":"spn-106948","text":"deterministic state encoding"}]},{"id":"blk-55658","spans":[{"id":"spn-106949","marks":["code"],"text":"BodyBrowser.StateHash.of/1"}]}],[{"id":"blk-55659","spans":[{"id":"spn-106950","text":"I5"}]},{"id":"blk-55660","spans":[{"id":"spn-106951","text":"replay fail-fast"}]},{"id":"blk-55661","spans":[{"id":"spn-106952","marks":["code"],"text":"BodyBrowser.Replay.execute/3"}]}]]},{"id":"blk-55662","kind":"heading","level":2,"spans":[{"id":"spn-106953","text":"Quick start"}]},{"id":"blk-55663","kind":"code","language":"elixir","text":"alias BodyBrowser.Backend.Simulator\nalias BodyBrowser.Backend.Simulator.{Element, Page}\nalias BodyBrowser.Session\n\npages = %{\n  \"https://example.test/login\" => %Page{\n    url: \"https://example.test/login\",\n    elements: [\n      %Element{role: \"textbox\", name: \"username\", actions: [\"fill\"]},\n      %Element{role: \"button\", name: \"Log in\", actions: [\"click\"]}\n    ]\n  }\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator, initial_url: \"https://example.test/login\", pages: pages},\n  agent_id: \"demo\",\n  provider: \"body-browser-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"click\",\n  \"target\" => Enum.at(obs.a11y_tree, 1).ref\n})\n\ntrace = Session.trace(s)  # ready for Graphonomous act(store_trace)"},{"id":"blk-55664","kind":"heading","level":2,"spans":[{"id":"spn-106954","text":"Wiring to Graphonomous"}]},{"id":"blk-55665","kind":"paragraph","spans":[{"id":"spn-106955","text":"The recorded trace is compatible with the Graphonomous "},{"id":"spn-106956","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-106957","text":" MCP tool (see "},{"id":"spn-106958","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/store_trace.ex"},{"id":"spn-106959","text":"). Finalize via "},{"id":"spn-106960","marks":["code"],"text":"TraceRecorder.finalize/2"},{"id":"spn-106961","text":" and pass the resulting map's JSON encoding as "},{"id":"spn-106962","marks":["code"],"text":"interaction_trace"},{"id":"spn-106963","text":"."}]},{"id":"blk-55666","kind":"paragraph","spans":[{"id":"spn-106964","text":"Replay the other direction: call Graphonomous "},{"id":"spn-106965","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-106966","text":", decode the returned manifest, and pass it to "},{"id":"spn-106967","marks":["code"],"text":"BodyBrowser.Replay.execute/3"},{"id":"spn-106968","text":"."}]},{"id":"blk-55667","kind":"heading","level":2,"spans":[{"id":"spn-106969","text":"Running the conformance suite"}]},{"id":"blk-55668","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-55669","kind":"paragraph","spans":[{"id":"spn-106970","text":"Twelve tests, 1:1 with GRASP §9. Run against "},{"id":"spn-106971","marks":["code"],"text":"Simulator"},{"id":"spn-106972","text":"; an in-progress "},{"id":"spn-106973","marks":["code"],"text":"AgentBrowser"},{"id":"spn-106974","text":" backend is expected to pass the same suite once its CLI adapter lands."}]},{"id":"blk-55670","kind":"heading","level":2,"spans":[{"id":"spn-106975","text":"References"}]},{"id":"blk-55671","items":[{"blocks":[{"id":"blk-55673","kind":"paragraph","spans":[{"id":"spn-106976","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-106977","text":" — normative spec"}]}],"id":"blk-55672","kind":"list-item"},{"blocks":[{"id":"blk-55675","kind":"paragraph","spans":[{"id":"spn-106978","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/body.browser.contract.json"},{"id":"spn-106979","text":" — capability contract"}]}],"id":"blk-55674","kind":"list-item"},{"blocks":[{"id":"blk-55677","kind":"paragraph","spans":[{"id":"spn-106980","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.browser.md"},{"id":"spn-106981","text":" — registry entry"}]}],"id":"blk-55676","kind":"list-item"},{"blocks":[{"id":"blk-55679","kind":"paragraph","spans":[{"id":"spn-106982","marks":["code"],"text":"PULSE/manifests/body-browser.embodiment.json"},{"id":"spn-106983","text":" — loop manifest"}]}],"id":"blk-55678","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55680","kind":"heading","level":2,"spans":[{"id":"spn-106984","text":"License"}]},{"id":"blk-55681","kind":"paragraph","spans":[{"id":"spn-106985","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaiera7yscn2m72mymxbeifupvlgxltoglfzyy4qrvddkymcwfsfmfdigq","vocabulary":"ampersand.docs.fs.v1"}