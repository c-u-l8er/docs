{"bendscript":"0.1","blocks":[{"id":"blk-57411","kind":"heading","level":1,"spans":[{"id":"spn-84687","text":"body-browser"}]},{"id":"blk-57412","kind":"paragraph","spans":[{"id":"spn-84688","text":"OS-011 "},{"id":"spn-84689","marks":["code"],"text":"&body.browser"},{"id":"spn-84690","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-57413","kind":"paragraph","spans":[{"id":"spn-84691","text":"Provides the authoritative substrate for browser embodiment: typed perception, affordance enumeration, StateHash-anchored replay, and InteractionTrace recording — the missing half of Graphonomous's "},{"id":"spn-84692","marks":["code"],"text":"&memory.episodic.store/replay"},{"id":"spn-84693","text":" loop."}]},{"id":"blk-57414","kind":"heading","level":2,"spans":[{"id":"spn-84694","text":"Status"}]},{"id":"blk-57415","items":[{"blocks":[{"id":"blk-57417","kind":"paragraph","spans":[{"id":"spn-84695","marks":["bold"],"text":"Library:"},{"id":"spn-84696","text":" production-ready"}]}],"id":"blk-57416","kind":"list-item"},{"blocks":[{"id":"blk-57419","kind":"paragraph","spans":[{"id":"spn-84697","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-84698","text":" 12/12 OS-011 §9 conformance tests pass"}]}],"id":"blk-57418","kind":"list-item"},{"blocks":[{"id":"blk-57421","kind":"paragraph","spans":[{"id":"spn-84699","marks":["bold"],"text":"MCP server:"},{"id":"spn-84700","text":" shipped — 7 tools on the "},{"id":"spn-84701","marks":["code"],"text":"body-browser"},{"id":"spn-84702","text":" namespace (ensure_session + 6 OS-011 operations), 12 MCP unit tests"}]}],"id":"blk-57420","kind":"list-item"},{"blocks":[{"id":"blk-57423","kind":"paragraph","spans":[{"id":"spn-84703","marks":["bold"],"text":"AgentBrowser backend (real Chromium):"},{"id":"spn-84704","text":" skeleton — subprocess wiring documented, pending"}]}],"id":"blk-57422","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57424","kind":"heading","level":2,"spans":[{"id":"spn-84705","text":"MCP surface"}]},{"id":"blk-57425","kind":"code","language":"text","text":"body_browser_ensure_session  — create or re-bind a session by id\nbody_browser_perceive        — typed observation (EnvironmentObservation)\nbody_browser_affordances     — policy-filtered AffordanceSet\nbody_browser_encode_state    — deterministic StateHash\nbody_browser_act             — execute one TypedAction\nbody_browser_dry_run         — predicted outcome (no mutation)\nbody_browser_replay          — fail-fast replay of an InteractionTrace"},{"id":"blk-57426","kind":"paragraph","spans":[{"id":"spn-84706","text":"Every tool takes a "},{"id":"spn-84707","marks":["code"],"text":"session_id"},{"id":"spn-84708","text":" so multiple agents can drive independent browser sessions concurrently from the same server process. Sessions are supervised under "},{"id":"spn-84709","marks":["code"],"text":"BodyBrowser.SessionSupervisor"},{"id":"spn-84710","text":" and addressed through the "},{"id":"spn-84711","marks":["code"],"text":"BodyBrowser.SessionRegistry"},{"id":"spn-84712","text":"."}]},{"id":"blk-57427","kind":"heading","level":2,"spans":[{"id":"spn-84713","text":"The contract (OS-011 §11)"}]},{"id":"blk-57428","kind":"paragraph","spans":[{"id":"spn-84714","text":"A conforming "},{"id":"spn-84715","marks":["code"],"text":"&body.browser"},{"id":"spn-84716","text":" provider exposes six operations:"}]},{"head":[{"id":"blk-57430","spans":[{"id":"spn-84717","text":"operation"}]},{"id":"blk-57431","spans":[{"id":"spn-84718","text":"input"}]},{"id":"blk-57432","spans":[{"id":"spn-84719","text":"output"}]},{"id":"blk-57433","spans":[{"id":"spn-84720","text":"deterministic"}]}],"id":"blk-57429","kind":"table","rows":[[{"id":"blk-57434","spans":[{"id":"spn-84721","marks":["code"],"text":"perceive"}]},{"id":"blk-57435","spans":[{"id":"spn-84722","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57436","spans":[{"id":"spn-84723","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-57437","spans":[{"id":"spn-84724","text":"✅"}]}],[{"id":"blk-57438","spans":[{"id":"spn-84725","marks":["code"],"text":"affordances"}]},{"id":"blk-57439","spans":[{"id":"spn-84726","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-57440","spans":[{"id":"spn-84727","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-57441","spans":[{"id":"spn-84728","text":"✅"}]}],[{"id":"blk-57442","spans":[{"id":"spn-84729","marks":["code"],"text":"encode_state"}]},{"id":"blk-57443","spans":[{"id":"spn-84730","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57444","spans":[{"id":"spn-84731","marks":["code"],"text":"StateHash"}]},{"id":"blk-57445","spans":[{"id":"spn-84732","text":"✅"}]}],[{"id":"blk-57446","spans":[{"id":"spn-84733","marks":["code"],"text":"act"}]},{"id":"blk-57447","spans":[{"id":"spn-84734","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57448","spans":[{"id":"spn-84735","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-57449","spans":[{"id":"spn-84736","text":"❌ side-effecting"}]}],[{"id":"blk-57450","spans":[{"id":"spn-84737","marks":["code"],"text":"replay"}]},{"id":"blk-57451","spans":[{"id":"spn-84738","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-57452","spans":[{"id":"spn-84739","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-57453","spans":[{"id":"spn-84740","text":"❌ side-effecting"}]}],[{"id":"blk-57454","spans":[{"id":"spn-84741","marks":["code"],"text":"dry_run"}]},{"id":"blk-57455","spans":[{"id":"spn-84742","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57456","spans":[{"id":"spn-84743","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-57457","spans":[{"id":"spn-84744","text":"✅"}]}]]},{"id":"blk-57458","kind":"heading","level":2,"spans":[{"id":"spn-84745","text":"Five invariants (OS-011 §7, all enforced by "},{"id":"spn-84746","marks":["code"],"text":"BodyBrowser.Session"},{"id":"spn-84747","text":")"}]},{"head":[{"id":"blk-57460","spans":[{"id":"spn-84748","text":"#"}]},{"id":"blk-57461","spans":[{"id":"spn-84749","text":"invariant"}]},{"id":"blk-57462","spans":[{"id":"spn-84750","text":"where enforced"}]}],"id":"blk-57459","kind":"table","rows":[[{"id":"blk-57463","spans":[{"id":"spn-84751","text":"I1"}]},{"id":"blk-57464","spans":[{"id":"spn-84752","text":"perceive-before-act (stale refs rejected)"}]},{"id":"blk-57465","spans":[{"id":"spn-84753","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-57466","spans":[{"id":"spn-84754","text":"I2"}]},{"id":"blk-57467","spans":[{"id":"spn-84755","text":"affordance-bounded action"}]},{"id":"blk-57468","spans":[{"id":"spn-84756","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-57469","spans":[{"id":"spn-84757","text":"I3"}]},{"id":"blk-57470","spans":[{"id":"spn-84758","text":"policy-filtered affordances"}]},{"id":"blk-57471","spans":[{"id":"spn-84759","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-57472","spans":[{"id":"spn-84760","text":"I4"}]},{"id":"blk-57473","spans":[{"id":"spn-84761","text":"deterministic state encoding"}]},{"id":"blk-57474","spans":[{"id":"spn-84762","marks":["code"],"text":"BodyBrowser.StateHash.of/1"}]}],[{"id":"blk-57475","spans":[{"id":"spn-84763","text":"I5"}]},{"id":"blk-57476","spans":[{"id":"spn-84764","text":"replay fail-fast"}]},{"id":"blk-57477","spans":[{"id":"spn-84765","marks":["code"],"text":"BodyBrowser.Replay.execute/3"}]}]]},{"id":"blk-57478","kind":"heading","level":2,"spans":[{"id":"spn-84766","text":"Quick start"}]},{"id":"blk-57479","kind":"code","language":"elixir","text":"alias BodyBrowser.Backend.Simulator\nalias BodyBrowser.Backend.Simulator.{Element, Page}\nalias BodyBrowser.Session\n\npages = %{\n  \"https://example.test/login\" => %Page{\n    url: \"https://example.test/login\",\n    elements: [\n      %Element{role: \"textbox\", name: \"username\", actions: [\"fill\"]},\n      %Element{role: \"button\", name: \"Log in\", actions: [\"click\"]}\n    ]\n  }\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator, initial_url: \"https://example.test/login\", pages: pages},\n  agent_id: \"demo\",\n  provider: \"body-browser-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"click\",\n  \"target\" => Enum.at(obs.a11y_tree, 1).ref\n})\n\ntrace = Session.trace(s)  # ready for Graphonomous act(store_trace)"},{"id":"blk-57480","kind":"heading","level":2,"spans":[{"id":"spn-84767","text":"Wiring to Graphonomous"}]},{"id":"blk-57481","kind":"paragraph","spans":[{"id":"spn-84768","text":"The recorded trace is compatible with the Graphonomous "},{"id":"spn-84769","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-84770","text":" MCP tool (see "},{"id":"spn-84771","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/store_trace.ex"},{"id":"spn-84772","text":"). Finalize via "},{"id":"spn-84773","marks":["code"],"text":"TraceRecorder.finalize/2"},{"id":"spn-84774","text":" and pass the resulting map's JSON encoding as "},{"id":"spn-84775","marks":["code"],"text":"interaction_trace"},{"id":"spn-84776","text":"."}]},{"id":"blk-57482","kind":"paragraph","spans":[{"id":"spn-84777","text":"Replay the other direction: call Graphonomous "},{"id":"spn-84778","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-84779","text":", decode the returned manifest, and pass it to "},{"id":"spn-84780","marks":["code"],"text":"BodyBrowser.Replay.execute/3"},{"id":"spn-84781","text":"."}]},{"id":"blk-57483","kind":"heading","level":2,"spans":[{"id":"spn-84782","text":"Running the conformance suite"}]},{"id":"blk-57484","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-57485","kind":"paragraph","spans":[{"id":"spn-84783","text":"Twelve tests, 1:1 with OS-011 §9. Run against "},{"id":"spn-84784","marks":["code"],"text":"Simulator"},{"id":"spn-84785","text":"; an in-progress "},{"id":"spn-84786","marks":["code"],"text":"AgentBrowser"},{"id":"spn-84787","text":" backend is expected to pass the same suite once its CLI adapter lands."}]},{"id":"blk-57486","kind":"heading","level":2,"spans":[{"id":"spn-84788","text":"References"}]},{"id":"blk-57487","items":[{"blocks":[{"id":"blk-57489","kind":"paragraph","spans":[{"id":"spn-84789","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-84790","text":" — normative spec"}]}],"id":"blk-57488","kind":"list-item"},{"blocks":[{"id":"blk-57491","kind":"paragraph","spans":[{"id":"spn-84791","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/body.browser.contract.json"},{"id":"spn-84792","text":" — capability contract"}]}],"id":"blk-57490","kind":"list-item"},{"blocks":[{"id":"blk-57493","kind":"paragraph","spans":[{"id":"spn-84793","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.browser.md"},{"id":"spn-84794","text":" — registry entry"}]}],"id":"blk-57492","kind":"list-item"},{"blocks":[{"id":"blk-57495","kind":"paragraph","spans":[{"id":"spn-84795","marks":["code"],"text":"PULSE/manifests/body-browser.embodiment.json"},{"id":"spn-84796","text":" — loop manifest"}]}],"id":"blk-57494","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57496","kind":"heading","level":2,"spans":[{"id":"spn-84797","text":"License"}]},{"id":"blk-57497","kind":"paragraph","spans":[{"id":"spn-84798","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaieraicpqh64ewec4r2ncjckmkmuaohjroimhq35psvqlxsmmluq6ljcq","vocabulary":"ampersand.docs.fs.v1"}