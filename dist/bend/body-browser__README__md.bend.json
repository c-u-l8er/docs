{"bendscript":"0.1","blocks":[{"id":"blk-57539","kind":"heading","level":1,"spans":[{"id":"spn-84847","text":"body-browser"}]},{"id":"blk-57540","kind":"paragraph","spans":[{"id":"spn-84848","text":"OS-011 "},{"id":"spn-84849","marks":["code"],"text":"&body.browser"},{"id":"spn-84850","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-57541","kind":"paragraph","spans":[{"id":"spn-84851","text":"Provides the authoritative substrate for browser embodiment: typed perception, affordance enumeration, StateHash-anchored replay, and InteractionTrace recording — the missing half of Graphonomous's "},{"id":"spn-84852","marks":["code"],"text":"&memory.episodic.store/replay"},{"id":"spn-84853","text":" loop."}]},{"id":"blk-57542","kind":"heading","level":2,"spans":[{"id":"spn-84854","text":"Status"}]},{"id":"blk-57543","items":[{"blocks":[{"id":"blk-57545","kind":"paragraph","spans":[{"id":"spn-84855","marks":["bold"],"text":"Library:"},{"id":"spn-84856","text":" production-ready"}]}],"id":"blk-57544","kind":"list-item"},{"blocks":[{"id":"blk-57547","kind":"paragraph","spans":[{"id":"spn-84857","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-84858","text":" 12/12 OS-011 §9 conformance tests pass"}]}],"id":"blk-57546","kind":"list-item"},{"blocks":[{"id":"blk-57549","kind":"paragraph","spans":[{"id":"spn-84859","marks":["bold"],"text":"MCP server:"},{"id":"spn-84860","text":" shipped — 7 tools on the "},{"id":"spn-84861","marks":["code"],"text":"body-browser"},{"id":"spn-84862","text":" namespace (ensure_session + 6 OS-011 operations), 12 MCP unit tests"}]}],"id":"blk-57548","kind":"list-item"},{"blocks":[{"id":"blk-57551","kind":"paragraph","spans":[{"id":"spn-84863","marks":["bold"],"text":"AgentBrowser backend (real Chromium):"},{"id":"spn-84864","text":" skeleton — subprocess wiring documented, pending"}]}],"id":"blk-57550","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57552","kind":"heading","level":2,"spans":[{"id":"spn-84865","text":"MCP surface"}]},{"id":"blk-57553","kind":"code","language":"text","text":"body_browser_ensure_session  — create or re-bind a session by id\nbody_browser_perceive        — typed observation (EnvironmentObservation)\nbody_browser_affordances     — policy-filtered AffordanceSet\nbody_browser_encode_state    — deterministic StateHash\nbody_browser_act             — execute one TypedAction\nbody_browser_dry_run         — predicted outcome (no mutation)\nbody_browser_replay          — fail-fast replay of an InteractionTrace"},{"id":"blk-57554","kind":"paragraph","spans":[{"id":"spn-84866","text":"Every tool takes a "},{"id":"spn-84867","marks":["code"],"text":"session_id"},{"id":"spn-84868","text":" so multiple agents can drive independent browser sessions concurrently from the same server process. Sessions are supervised under "},{"id":"spn-84869","marks":["code"],"text":"BodyBrowser.SessionSupervisor"},{"id":"spn-84870","text":" and addressed through the "},{"id":"spn-84871","marks":["code"],"text":"BodyBrowser.SessionRegistry"},{"id":"spn-84872","text":"."}]},{"id":"blk-57555","kind":"heading","level":2,"spans":[{"id":"spn-84873","text":"The contract (OS-011 §11)"}]},{"id":"blk-57556","kind":"paragraph","spans":[{"id":"spn-84874","text":"A conforming "},{"id":"spn-84875","marks":["code"],"text":"&body.browser"},{"id":"spn-84876","text":" provider exposes six operations:"}]},{"head":[{"id":"blk-57558","spans":[{"id":"spn-84877","text":"operation"}]},{"id":"blk-57559","spans":[{"id":"spn-84878","text":"input"}]},{"id":"blk-57560","spans":[{"id":"spn-84879","text":"output"}]},{"id":"blk-57561","spans":[{"id":"spn-84880","text":"deterministic"}]}],"id":"blk-57557","kind":"table","rows":[[{"id":"blk-57562","spans":[{"id":"spn-84881","marks":["code"],"text":"perceive"}]},{"id":"blk-57563","spans":[{"id":"spn-84882","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57564","spans":[{"id":"spn-84883","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-57565","spans":[{"id":"spn-84884","text":"✅"}]}],[{"id":"blk-57566","spans":[{"id":"spn-84885","marks":["code"],"text":"affordances"}]},{"id":"blk-57567","spans":[{"id":"spn-84886","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-57568","spans":[{"id":"spn-84887","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-57569","spans":[{"id":"spn-84888","text":"✅"}]}],[{"id":"blk-57570","spans":[{"id":"spn-84889","marks":["code"],"text":"encode_state"}]},{"id":"blk-57571","spans":[{"id":"spn-84890","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57572","spans":[{"id":"spn-84891","marks":["code"],"text":"StateHash"}]},{"id":"blk-57573","spans":[{"id":"spn-84892","text":"✅"}]}],[{"id":"blk-57574","spans":[{"id":"spn-84893","marks":["code"],"text":"act"}]},{"id":"blk-57575","spans":[{"id":"spn-84894","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57576","spans":[{"id":"spn-84895","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-57577","spans":[{"id":"spn-84896","text":"❌ side-effecting"}]}],[{"id":"blk-57578","spans":[{"id":"spn-84897","marks":["code"],"text":"replay"}]},{"id":"blk-57579","spans":[{"id":"spn-84898","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-57580","spans":[{"id":"spn-84899","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-57581","spans":[{"id":"spn-84900","text":"❌ side-effecting"}]}],[{"id":"blk-57582","spans":[{"id":"spn-84901","marks":["code"],"text":"dry_run"}]},{"id":"blk-57583","spans":[{"id":"spn-84902","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57584","spans":[{"id":"spn-84903","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-57585","spans":[{"id":"spn-84904","text":"✅"}]}]]},{"id":"blk-57586","kind":"heading","level":2,"spans":[{"id":"spn-84905","text":"Five invariants (OS-011 §7, all enforced by "},{"id":"spn-84906","marks":["code"],"text":"BodyBrowser.Session"},{"id":"spn-84907","text":")"}]},{"head":[{"id":"blk-57588","spans":[{"id":"spn-84908","text":"#"}]},{"id":"blk-57589","spans":[{"id":"spn-84909","text":"invariant"}]},{"id":"blk-57590","spans":[{"id":"spn-84910","text":"where enforced"}]}],"id":"blk-57587","kind":"table","rows":[[{"id":"blk-57591","spans":[{"id":"spn-84911","text":"I1"}]},{"id":"blk-57592","spans":[{"id":"spn-84912","text":"perceive-before-act (stale refs rejected)"}]},{"id":"blk-57593","spans":[{"id":"spn-84913","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-57594","spans":[{"id":"spn-84914","text":"I2"}]},{"id":"blk-57595","spans":[{"id":"spn-84915","text":"affordance-bounded action"}]},{"id":"blk-57596","spans":[{"id":"spn-84916","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-57597","spans":[{"id":"spn-84917","text":"I3"}]},{"id":"blk-57598","spans":[{"id":"spn-84918","text":"policy-filtered affordances"}]},{"id":"blk-57599","spans":[{"id":"spn-84919","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-57600","spans":[{"id":"spn-84920","text":"I4"}]},{"id":"blk-57601","spans":[{"id":"spn-84921","text":"deterministic state encoding"}]},{"id":"blk-57602","spans":[{"id":"spn-84922","marks":["code"],"text":"BodyBrowser.StateHash.of/1"}]}],[{"id":"blk-57603","spans":[{"id":"spn-84923","text":"I5"}]},{"id":"blk-57604","spans":[{"id":"spn-84924","text":"replay fail-fast"}]},{"id":"blk-57605","spans":[{"id":"spn-84925","marks":["code"],"text":"BodyBrowser.Replay.execute/3"}]}]]},{"id":"blk-57606","kind":"heading","level":2,"spans":[{"id":"spn-84926","text":"Quick start"}]},{"id":"blk-57607","kind":"code","language":"elixir","text":"alias BodyBrowser.Backend.Simulator\nalias BodyBrowser.Backend.Simulator.{Element, Page}\nalias BodyBrowser.Session\n\npages = %{\n  \"https://example.test/login\" => %Page{\n    url: \"https://example.test/login\",\n    elements: [\n      %Element{role: \"textbox\", name: \"username\", actions: [\"fill\"]},\n      %Element{role: \"button\", name: \"Log in\", actions: [\"click\"]}\n    ]\n  }\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator, initial_url: \"https://example.test/login\", pages: pages},\n  agent_id: \"demo\",\n  provider: \"body-browser-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"click\",\n  \"target\" => Enum.at(obs.a11y_tree, 1).ref\n})\n\ntrace = Session.trace(s)  # ready for Graphonomous act(store_trace)"},{"id":"blk-57608","kind":"heading","level":2,"spans":[{"id":"spn-84927","text":"Wiring to Graphonomous"}]},{"id":"blk-57609","kind":"paragraph","spans":[{"id":"spn-84928","text":"The recorded trace is compatible with the Graphonomous "},{"id":"spn-84929","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-84930","text":" MCP tool (see "},{"id":"spn-84931","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/store_trace.ex"},{"id":"spn-84932","text":"). Finalize via "},{"id":"spn-84933","marks":["code"],"text":"TraceRecorder.finalize/2"},{"id":"spn-84934","text":" and pass the resulting map's JSON encoding as "},{"id":"spn-84935","marks":["code"],"text":"interaction_trace"},{"id":"spn-84936","text":"."}]},{"id":"blk-57610","kind":"paragraph","spans":[{"id":"spn-84937","text":"Replay the other direction: call Graphonomous "},{"id":"spn-84938","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-84939","text":", decode the returned manifest, and pass it to "},{"id":"spn-84940","marks":["code"],"text":"BodyBrowser.Replay.execute/3"},{"id":"spn-84941","text":"."}]},{"id":"blk-57611","kind":"heading","level":2,"spans":[{"id":"spn-84942","text":"Running the conformance suite"}]},{"id":"blk-57612","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-57613","kind":"paragraph","spans":[{"id":"spn-84943","text":"Twelve tests, 1:1 with OS-011 §9. Run against "},{"id":"spn-84944","marks":["code"],"text":"Simulator"},{"id":"spn-84945","text":"; an in-progress "},{"id":"spn-84946","marks":["code"],"text":"AgentBrowser"},{"id":"spn-84947","text":" backend is expected to pass the same suite once its CLI adapter lands."}]},{"id":"blk-57614","kind":"heading","level":2,"spans":[{"id":"spn-84948","text":"References"}]},{"id":"blk-57615","items":[{"blocks":[{"id":"blk-57617","kind":"paragraph","spans":[{"id":"spn-84949","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-84950","text":" — normative spec"}]}],"id":"blk-57616","kind":"list-item"},{"blocks":[{"id":"blk-57619","kind":"paragraph","spans":[{"id":"spn-84951","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/body.browser.contract.json"},{"id":"spn-84952","text":" — capability contract"}]}],"id":"blk-57618","kind":"list-item"},{"blocks":[{"id":"blk-57621","kind":"paragraph","spans":[{"id":"spn-84953","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.browser.md"},{"id":"spn-84954","text":" — registry entry"}]}],"id":"blk-57620","kind":"list-item"},{"blocks":[{"id":"blk-57623","kind":"paragraph","spans":[{"id":"spn-84955","marks":["code"],"text":"PULSE/manifests/body-browser.embodiment.json"},{"id":"spn-84956","text":" — loop manifest"}]}],"id":"blk-57622","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57624","kind":"heading","level":2,"spans":[{"id":"spn-84957","text":"License"}]},{"id":"blk-57625","kind":"paragraph","spans":[{"id":"spn-84958","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaieraxonek6detj7ejwyzmc5cjd4g42fdbw4psh76u4lbk2es6q66c5ba","vocabulary":"ampersand.docs.fs.v1"}