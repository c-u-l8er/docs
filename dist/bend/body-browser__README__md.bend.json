{"bendscript":"0.1","blocks":[{"id":"blk-58309","kind":"heading","level":1,"spans":[{"id":"spn-87331","text":"body-browser"}]},{"id":"blk-58310","kind":"paragraph","spans":[{"id":"spn-87332","text":"OS-011 "},{"id":"spn-87333","marks":["code"],"text":"&body.browser"},{"id":"spn-87334","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-58311","kind":"paragraph","spans":[{"id":"spn-87335","text":"Provides the authoritative substrate for browser embodiment: typed perception, affordance enumeration, StateHash-anchored replay, and InteractionTrace recording — the missing half of Graphonomous's "},{"id":"spn-87336","marks":["code"],"text":"&memory.episodic.store/replay"},{"id":"spn-87337","text":" loop."}]},{"id":"blk-58312","kind":"heading","level":2,"spans":[{"id":"spn-87338","text":"Status"}]},{"id":"blk-58313","items":[{"blocks":[{"id":"blk-58315","kind":"paragraph","spans":[{"id":"spn-87339","marks":["bold"],"text":"Library:"},{"id":"spn-87340","text":" production-ready"}]}],"id":"blk-58314","kind":"list-item"},{"blocks":[{"id":"blk-58317","kind":"paragraph","spans":[{"id":"spn-87341","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-87342","text":" 12/12 OS-011 §9 conformance tests pass"}]}],"id":"blk-58316","kind":"list-item"},{"blocks":[{"id":"blk-58319","kind":"paragraph","spans":[{"id":"spn-87343","marks":["bold"],"text":"MCP server:"},{"id":"spn-87344","text":" shipped — 7 tools on the "},{"id":"spn-87345","marks":["code"],"text":"body-browser"},{"id":"spn-87346","text":" namespace (ensure_session + 6 OS-011 operations), 12 MCP unit tests"}]}],"id":"blk-58318","kind":"list-item"},{"blocks":[{"id":"blk-58321","kind":"paragraph","spans":[{"id":"spn-87347","marks":["bold"],"text":"AgentBrowser backend (real Chromium):"},{"id":"spn-87348","text":" skeleton — subprocess wiring documented, pending"}]}],"id":"blk-58320","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58322","kind":"heading","level":2,"spans":[{"id":"spn-87349","text":"MCP surface"}]},{"id":"blk-58323","kind":"code","language":"text","text":"body_browser_ensure_session  — create or re-bind a session by id\nbody_browser_perceive        — typed observation (EnvironmentObservation)\nbody_browser_affordances     — policy-filtered AffordanceSet\nbody_browser_encode_state    — deterministic StateHash\nbody_browser_act             — execute one TypedAction\nbody_browser_dry_run         — predicted outcome (no mutation)\nbody_browser_replay          — fail-fast replay of an InteractionTrace"},{"id":"blk-58324","kind":"paragraph","spans":[{"id":"spn-87350","text":"Every tool takes a "},{"id":"spn-87351","marks":["code"],"text":"session_id"},{"id":"spn-87352","text":" so multiple agents can drive independent browser sessions concurrently from the same server process. Sessions are supervised under "},{"id":"spn-87353","marks":["code"],"text":"BodyBrowser.SessionSupervisor"},{"id":"spn-87354","text":" and addressed through the "},{"id":"spn-87355","marks":["code"],"text":"BodyBrowser.SessionRegistry"},{"id":"spn-87356","text":"."}]},{"id":"blk-58325","kind":"heading","level":2,"spans":[{"id":"spn-87357","text":"The contract (OS-011 §11)"}]},{"id":"blk-58326","kind":"paragraph","spans":[{"id":"spn-87358","text":"A conforming "},{"id":"spn-87359","marks":["code"],"text":"&body.browser"},{"id":"spn-87360","text":" provider exposes six operations:"}]},{"head":[{"id":"blk-58328","spans":[{"id":"spn-87361","text":"operation"}]},{"id":"blk-58329","spans":[{"id":"spn-87362","text":"input"}]},{"id":"blk-58330","spans":[{"id":"spn-87363","text":"output"}]},{"id":"blk-58331","spans":[{"id":"spn-87364","text":"deterministic"}]}],"id":"blk-58327","kind":"table","rows":[[{"id":"blk-58332","spans":[{"id":"spn-87365","marks":["code"],"text":"perceive"}]},{"id":"blk-58333","spans":[{"id":"spn-87366","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-58334","spans":[{"id":"spn-87367","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-58335","spans":[{"id":"spn-87368","text":"✅"}]}],[{"id":"blk-58336","spans":[{"id":"spn-87369","marks":["code"],"text":"affordances"}]},{"id":"blk-58337","spans":[{"id":"spn-87370","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-58338","spans":[{"id":"spn-87371","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-58339","spans":[{"id":"spn-87372","text":"✅"}]}],[{"id":"blk-58340","spans":[{"id":"spn-87373","marks":["code"],"text":"encode_state"}]},{"id":"blk-58341","spans":[{"id":"spn-87374","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-58342","spans":[{"id":"spn-87375","marks":["code"],"text":"StateHash"}]},{"id":"blk-58343","spans":[{"id":"spn-87376","text":"✅"}]}],[{"id":"blk-58344","spans":[{"id":"spn-87377","marks":["code"],"text":"act"}]},{"id":"blk-58345","spans":[{"id":"spn-87378","marks":["code"],"text":"TypedAction"}]},{"id":"blk-58346","spans":[{"id":"spn-87379","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-58347","spans":[{"id":"spn-87380","text":"❌ side-effecting"}]}],[{"id":"blk-58348","spans":[{"id":"spn-87381","marks":["code"],"text":"replay"}]},{"id":"blk-58349","spans":[{"id":"spn-87382","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-58350","spans":[{"id":"spn-87383","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-58351","spans":[{"id":"spn-87384","text":"❌ side-effecting"}]}],[{"id":"blk-58352","spans":[{"id":"spn-87385","marks":["code"],"text":"dry_run"}]},{"id":"blk-58353","spans":[{"id":"spn-87386","marks":["code"],"text":"TypedAction"}]},{"id":"blk-58354","spans":[{"id":"spn-87387","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-58355","spans":[{"id":"spn-87388","text":"✅"}]}]]},{"id":"blk-58356","kind":"heading","level":2,"spans":[{"id":"spn-87389","text":"Five invariants (OS-011 §7, all enforced by "},{"id":"spn-87390","marks":["code"],"text":"BodyBrowser.Session"},{"id":"spn-87391","text":")"}]},{"head":[{"id":"blk-58358","spans":[{"id":"spn-87392","text":"#"}]},{"id":"blk-58359","spans":[{"id":"spn-87393","text":"invariant"}]},{"id":"blk-58360","spans":[{"id":"spn-87394","text":"where enforced"}]}],"id":"blk-58357","kind":"table","rows":[[{"id":"blk-58361","spans":[{"id":"spn-87395","text":"I1"}]},{"id":"blk-58362","spans":[{"id":"spn-87396","text":"perceive-before-act (stale refs rejected)"}]},{"id":"blk-58363","spans":[{"id":"spn-87397","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-58364","spans":[{"id":"spn-87398","text":"I2"}]},{"id":"blk-58365","spans":[{"id":"spn-87399","text":"affordance-bounded action"}]},{"id":"blk-58366","spans":[{"id":"spn-87400","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-58367","spans":[{"id":"spn-87401","text":"I3"}]},{"id":"blk-58368","spans":[{"id":"spn-87402","text":"policy-filtered affordances"}]},{"id":"blk-58369","spans":[{"id":"spn-87403","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-58370","spans":[{"id":"spn-87404","text":"I4"}]},{"id":"blk-58371","spans":[{"id":"spn-87405","text":"deterministic state encoding"}]},{"id":"blk-58372","spans":[{"id":"spn-87406","marks":["code"],"text":"BodyBrowser.StateHash.of/1"}]}],[{"id":"blk-58373","spans":[{"id":"spn-87407","text":"I5"}]},{"id":"blk-58374","spans":[{"id":"spn-87408","text":"replay fail-fast"}]},{"id":"blk-58375","spans":[{"id":"spn-87409","marks":["code"],"text":"BodyBrowser.Replay.execute/3"}]}]]},{"id":"blk-58376","kind":"heading","level":2,"spans":[{"id":"spn-87410","text":"Quick start"}]},{"id":"blk-58377","kind":"code","language":"elixir","text":"alias BodyBrowser.Backend.Simulator\nalias BodyBrowser.Backend.Simulator.{Element, Page}\nalias BodyBrowser.Session\n\npages = %{\n  \"https://example.test/login\" => %Page{\n    url: \"https://example.test/login\",\n    elements: [\n      %Element{role: \"textbox\", name: \"username\", actions: [\"fill\"]},\n      %Element{role: \"button\", name: \"Log in\", actions: [\"click\"]}\n    ]\n  }\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator, initial_url: \"https://example.test/login\", pages: pages},\n  agent_id: \"demo\",\n  provider: \"body-browser-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"click\",\n  \"target\" => Enum.at(obs.a11y_tree, 1).ref\n})\n\ntrace = Session.trace(s)  # ready for Graphonomous act(store_trace)"},{"id":"blk-58378","kind":"heading","level":2,"spans":[{"id":"spn-87411","text":"Wiring to Graphonomous"}]},{"id":"blk-58379","kind":"paragraph","spans":[{"id":"spn-87412","text":"The recorded trace is compatible with the Graphonomous "},{"id":"spn-87413","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-87414","text":" MCP tool (see "},{"id":"spn-87415","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/store_trace.ex"},{"id":"spn-87416","text":"). Finalize via "},{"id":"spn-87417","marks":["code"],"text":"TraceRecorder.finalize/2"},{"id":"spn-87418","text":" and pass the resulting map's JSON encoding as "},{"id":"spn-87419","marks":["code"],"text":"interaction_trace"},{"id":"spn-87420","text":"."}]},{"id":"blk-58380","kind":"paragraph","spans":[{"id":"spn-87421","text":"Replay the other direction: call Graphonomous "},{"id":"spn-87422","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-87423","text":", decode the returned manifest, and pass it to "},{"id":"spn-87424","marks":["code"],"text":"BodyBrowser.Replay.execute/3"},{"id":"spn-87425","text":"."}]},{"id":"blk-58381","kind":"heading","level":2,"spans":[{"id":"spn-87426","text":"Running the conformance suite"}]},{"id":"blk-58382","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-58383","kind":"paragraph","spans":[{"id":"spn-87427","text":"Twelve tests, 1:1 with OS-011 §9. Run against "},{"id":"spn-87428","marks":["code"],"text":"Simulator"},{"id":"spn-87429","text":"; an in-progress "},{"id":"spn-87430","marks":["code"],"text":"AgentBrowser"},{"id":"spn-87431","text":" backend is expected to pass the same suite once its CLI adapter lands."}]},{"id":"blk-58384","kind":"heading","level":2,"spans":[{"id":"spn-87432","text":"References"}]},{"id":"blk-58385","items":[{"blocks":[{"id":"blk-58387","kind":"paragraph","spans":[{"id":"spn-87433","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-87434","text":" — normative spec"}]}],"id":"blk-58386","kind":"list-item"},{"blocks":[{"id":"blk-58389","kind":"paragraph","spans":[{"id":"spn-87435","marks":["code"],"text":"AmpersandBoxDesign/contracts/v0.1.0/body.browser.contract.json"},{"id":"spn-87436","text":" — capability contract"}]}],"id":"blk-58388","kind":"list-item"},{"blocks":[{"id":"blk-58391","kind":"paragraph","spans":[{"id":"spn-87437","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.browser.md"},{"id":"spn-87438","text":" — registry entry"}]}],"id":"blk-58390","kind":"list-item"},{"blocks":[{"id":"blk-58393","kind":"paragraph","spans":[{"id":"spn-87439","marks":["code"],"text":"PULSE/manifests/body-browser.embodiment.json"},{"id":"spn-87440","text":" — loop manifest"}]}],"id":"blk-58392","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58394","kind":"heading","level":2,"spans":[{"id":"spn-87441","text":"License"}]},{"id":"blk-58395","kind":"paragraph","spans":[{"id":"spn-87442","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaierab764ptajhphg5f2dsfyrvkk2umbhmgjp2yqhuk6xj7vqwl2ic6la","vocabulary":"ampersand.docs.fs.v1"}