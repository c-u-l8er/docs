},{"id":"spn-20443","text":" (Claude in Chrome MCP)"}]}],"id":"blk-21439","kind":"list-item"},{"blocks":[{"id":"blk-21442","kind":"paragraph","spans":[{"id":"spn-20444","marks":["code"],"text":"mcp__plugin_chrome-devtools-mcp_chrome-devtools__*"},{"id":"spn-20445","text":" (chrome-devtools MCP)"}]}],"id":"blk-21441","kind":"list-item"},{"blocks":[{"id":"blk-21444","kind":"paragraph","spans":[{"id":"spn-20446","marks":["code"],"text":"mcp__Claude_Preview__*"},{"id":"spn-20447","text":" for browser-level testing (preview_* is still fine for dev-server management and HMR; use "},{"id":"spn-20448","marks":["code"],"text":"agent-browser"},{"id":"spn-20449","text":" once a server is running and you want real browser interaction)"}]}],"id":"blk-21443","kind":"list-item"},{"blocks":[{"id":"blk-21446","kind":"paragraph","spans":[{"id":"spn-20450","text":"Any ad-hoc Playwright / Puppeteer / Selenium scripts"}]}],"id":"blk-21445","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-21447","kind":"paragraph","spans":[{"id":"spn-20451","text":"Bootstrap pattern for any session doing browser work:"}]},{"id":"blk-21448","kind":"code","language":"text","text":"agent-browser skills get core --full    # load the core skill\nagent-browser open <url>                # navigate\nagent-browser snapshot                  # a11y-tree snapshot (preferred over screenshot for assertions)\nagent-browser screenshot                # visual proof when sharing with the user"},{"id":"blk-21449","kind":"paragraph","spans":[{"id":"spn-20452","text":"Exception: if a task is narrowly about Chrome DevTools-specific features (Lighthouse audits, performance traces, heap snapshots), the "},{"id":"spn-20453","marks":["code"],"text":"chrome-devtools"},{"id":"spn-20454","text":" MCP may be used — but default to "},{"id":"spn-20455","marks":["code"],"text":"agent-browser"},{"id":"spn-20456","text":" for everything else."}]},{"id":"blk-21450","kind":"heading","level":2,"spans":[{"id":"spn-20457","text":"Graphonomous session policy (ALL ProjectAmp2 sessions)"}]},{"id":"blk-21451","kind":"paragraph","spans":[{"id":"spn-20458","text":"Treat Graphonomous MCP as the "},{"id":"spn-20459","marks":["bold"],"text":"always-on memory and learning loop"},{"id":"spn-20460","text":" for every chat session in this repository — regardless of which subdirectory the task is in. Graphonomous is the shared knowledge substrate for the entire [&] ecosystem."}]},{"id":"blk-21452","kind":"paragraph","spans":[{"id":"spn-20461","text":"Adopt this internal policy at session start:"}]},{"id":"blk-21453","kind":"paragraph","spans":[{"id":"spn-20462","marks":["bold"],"text":"\"Graphonomous-first memory loop is active.\""}]},{"id":"blk-21454","kind":"heading","level":3,"spans":[{"id":"spn-20463","text":"Required prompt/context wiring"}]},{"id":"blk-21455","kind":"paragraph","spans":[{"id":"spn-20464","text":"Skills live in "},{"id":"spn-20465","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-20466","text":" as Claude Code skills. Reference docs are mirrored in "},{"id":"spn-20467","marks":["code"],"text":"graphonomous/docs/skills/"},{"id":"spn-20468","text":"."}]},{"id":"blk-21456","kind":"paragraph","spans":[{"id":"spn-20469","text":"Load at session start (or before first non-trivial action):"}]},{"id":"blk-21457","items":[{"blocks":[{"id":"blk-21459","kind":"paragraph","spans":[{"id":"spn-20470","marks":["code"],"text":"graphonomous/docs/skills/SKILLS.md"},{"id":"spn-20471","text":" (index + machine architecture)"}]}],"id":"blk-21458","kind":"list-item"},{"blocks":[{"id":"blk-21461","kind":"paragraph","spans":[{"id":"spn-20472","marks":["code"],"text":"graphonomous/docs/skills/bootstrap.md"},{"id":"spn-20473","text":" (session initialization)"}]}],"id":"blk-21460","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-21462","kind":"paragraph","spans":[{"id":"spn-20474","text":"Recommended full load for complex sessions:"}]},{"id":"blk-21463","items":[{"blocks":[{"id":"blk-21465","kind":"paragraph","spans":[{"id":"spn-20475","marks":["code"],"text":"graphonomous/docs/skills/retrieve.md"}]}],"id":"blk-21464","kind":"list-item"},{"blocks":[{"id":"blk-21467","kind":"paragraph","spans":[{"id":"spn-20476","marks":["code"],"text":"graphonomous/docs/skills/learn.md"}]}],"id":"blk-21466","kind":"list-item"},{"blocks":[{"id":"blk-21469","kind":"paragraph","spans":[{"id":"spn-20477","marks":["code"],"text":"graphonomous/docs/skills/deliberate.md"}]}],"id":"blk-21468","kind":"list-item"},{"blocks":[{"id":"blk-21471","kind":"paragraph","spans":[{"id":"spn-20478","marks":["code"],"text":"graphonomous/docs/skills/consolidate.md"}]}],"id":"blk-21470","kind":"list-item"},{"blocks":[{"id":"blk-21473","kind":"paragraph","spans":[{"id":"spn-20479","marks":["code"],"text":"graphonomous/docs/skills/goals.md"}]}],"id":"blk-21472","kind":"list-item"},{"blocks":[{"id":"blk-21475","kind":"paragraph","spans":[{"id":"spn-20480","marks":["code"],"text":"graphonomous/docs/skills/attention.md"}]}],"id":"blk-21474","kind":"list-item"},{"blocks":[{"id":"blk-21477","kind":"paragraph","spans":[{"id":"spn-20481","marks":["code"],"text":"graphonomous/docs/skills/workflows.md"}]}],"id":"blk-21476","kind":"list-item"},{"blocks":[{"id":"blk-21479","kind":"paragraph","spans":[{"id":"spn-20482","marks":["code"],"text":"graphonomous/docs/skills/store.md"}]}],"id":"blk-21478","kind":"list-item"},{"blocks":[{"id":"blk-21481","kind":"paragraph","spans":[{"id":"spn-20483","marks":["code"],"text":"graphonomous/docs/skills/belief.md"}]}],"id":"blk-21480","kind":"list-item"},{"blocks":[{"id":"blk-21483","kind":"paragraph","spans":[{"id":"spn-20484","marks":["code"],"text":"graphonomous/docs/skills/review.md"}]}],"id":"blk-21482","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-21484","kind":"heading","level":3,"spans":[{"id":"spn-20485","text":"Default loop (every non-trivial task)"}]},{"id":"blk-21485","kind":"paragraph","spans":[{"id":"spn-20486","text":"Graphonomous v0.4 exposes "},{"id":"spn-20487","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-20488","text":" (down from 29 individual tools). Each machine maps to a phase of the closed memory loop:"}]},{"id":"blk-21486","items":[{"blocks":[{"id":"blk-21488","kind":"paragraph","spans":[{"id":"spn-20489","marks":["bold"],"text":"Retrieve"},{"id":"spn-20490","text":" — "},{"id":"spn-20491","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-20492","text":" before reasoning"}]}],"id":"blk-21487","kind":"list-item"},{"blocks":[{"id":"blk-21490","kind":"paragraph","spans":[{"id":"spn-20493","marks":["bold"],"text":"Route"},{"id":"spn-20494","text":" — check "},{"id":"spn-20495","marks":["code"],"text":"topology.routing"},{"id":"spn-20496","text":"; if "},{"id":"spn-20497","marks":["code"],"text":"\"deliberate\""},{"id":"spn-20498","text":", run "},{"id":"spn-20499","marks":["code"],"text":"route(action: \"deliberate\", ...)"}]}],"id":"blk-21489","kind":"list-item"},{"blocks":[{"id":"blk-21492","kind":"paragraph","spans":[{"id":"spn-20500","marks":["bold"],"text":"Act"},{"id":"spn-20501","text":" — "},{"id":"spn-20502","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-20503","text":" to mutate the graph"}]}],"id":"blk-21491","kind":"list-item"},{"blocks":[{"id":"blk-21494","kind":"paragraph","spans":[{"id":"spn-20504","marks":["bold"],"text":"Learn"},{"id":"spn-20505","text":" — "},{"id":"spn-20506","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-20507","text":" to close the feedback loop"}]}],"id":"blk-21493","kind":"list-item"},{"blocks":[{"id":"blk-21496","kind":"paragraph","spans":[{"id":"spn-20508","marks":["bold"],"text":"Consolidate"},{"id":"spn-20509","text":" — "},{"id":"spn-20510","marks":["code"],"text":"consolidate(action: \"run\")"},{"id":"spn-20511","text":" at session boundaries"}]}],"id":"blk-21495","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-21497","kind":"paragraph","spans":[{"id":"spn-20512","text":"This applies whether you're working in "},{"id":"spn-20513","marks":["code"],"text":"graphonomous/"},{"id":"spn-20514","text":", "},{"id":"spn-20515","marks":["code"],"text":"WebHost.Systems/"},{"id":"spn-20516","text":", "},{"id":"spn-20517","marks":["code"],"text":"AmpersandBoxDesign/"},{"id":"spn-20518","text":", "},{"id":"spn-20519","marks":["code"],"text":"bendscript.com/"},{"id":"spn-20520","text":", or any portfolio site spec."}]},{"id":"blk-21498","kind":"heading","level":3,"spans":[{"id":"spn-20521","text":"Dual-loop architecture"}]},{"id":"blk-21499","kind":"paragraph","spans":[{"id":"spn-20522","text":"When PRISM (OS-009) benchmarks Graphonomous, both closed loops interlock — 5 Graphonomous machines + 6 PRISM machines = 11 tools total, down from 76. See "},{"id":"spn-20523","marks":["code"],"text":"AmpersandBoxDesign/prompts/DUAL_LOOP_MACHINES.md"},{"id":"spn-20524","text":" and "},{"id":"spn-20525","marks":["code"],"text":"PRISM/docs/DUAL_LOOP_MACHINES.md"},{"id":"spn-20526","text":" (which now also covers triple-loop nesting via PULSE)."}]},{"id":"blk-21500","kind":"heading","level":3,"spans":[{"id":"spn-20527","text":"Three-protocol stack: [&] + PULSE + PRISM"}]},{"id":"blk-21501","kind":"paragraph","spans":[{"id":"spn-20528","text":"OS-010 PULSE is the temporal algebra that lets every loop in the [&] portfolio declare its phases, cadence, nesting, substrates, invariants, and cross-loop signal connections in a single JSON file ("},{"id":"spn-20529","marks":["code"],"text":"<loop>.pulse.json"},{"id":"spn-20530","text":"). Together with [&] (structural composition) and PRISM (diagnostic measurement), they form the three-protocol stack:"}]},{"id":"blk-21502","items":[{"blocks":[{"id":"blk-21504","kind":"paragraph","spans":[{"id":"spn-20531","marks":["bold"],"text":"[&]"},{"id":"spn-20532","text":" composes capabilities ("},{"id":"spn-20533","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-20534","text":") — structural"}]}],"id":"blk-21503","kind":"list-item"},{"blocks":[{"id":"blk-21506","kind":"paragraph","spans":[{"id":"spn-20535","marks":["bold"],"text":"PULSE"},{"id":"spn-20536","text":" declares loops + circulation ("},{"id":"spn-20537","marks":["code"],"text":"*.pulse.json"},{"id":"spn-20538","text":") — temporal — see "},{"id":"spn-20539","marks":["code"],"text":"PULSE/schemas/pulse-loop-manifest.v0.1.json"}]}],"id":"blk-21505","kind":"list-item"},{"blocks":[{"id":"blk-21508","kind":"paragraph","spans":[{"id":"spn-20540","marks":["bold"],"text":"PRISM"},{"id":"spn-20541","text":" measures loops over time (BYOR benchmark) — diagnostic"}]}],"id":"blk-21507","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-21509","kind":"paragraph","spans":[{"id":"spn-20542","text":"Every portfolio product declares its own loop topology in a \"PULSE Loop Manifest\" section of "},{"id":"spn-20543","marks":["code"],"text":"<project>/docs/spec/README.md"},{"id":"spn-20544","text":". Reference manifests live in "},{"id":"spn-20545","marks":["code"],"text":"PULSE/manifests/"},{"id":"spn-20546","text":" (graphonomous, prism, agentromatic). PRISM does not require a separate file — it reads any system's PULSE manifest directly to discover phases, signatures, and substrates."}]},{"id":"blk-21510","kind":"paragraph","spans":[{"id":"spn-20547","text":"The five canonical PULSE phase kinds — "},{"id":"spn-20548","marks":["code"],"text":"retrieve"},{"id":"spn-20549","text":", "},{"id":"spn-20550","marks":["code"],"text":"route"},{"id":"spn-20551","text":", "},{"id":"spn-20552","marks":["code"],"text":"act"},{"id":"spn-20553","text":", "},{"id":"spn-20554","marks":["code"],"text":"learn"},{"id":"spn-20555","text":", "},{"id":"spn-20556","marks":["code"],"text":"consolidate"},{"id":"spn-20557","text":" — match the Graphonomous machine architecture exactly. The six canonical cross-loop tokens (as of PULSE v0.1.1) — "},{"id":"spn-20558","marks":["code"],"text":"TopologyContext"},{"id":"spn-20559","text":", "},{"id":"spn-20560","marks":["code"],"text":"DeliberationResult"},{"id":"spn-20561","text":", "},{"id":"spn-20562","marks":["code"],"text":"OutcomeSignal"},{"id":"spn-20563","text":", "},{"id":"spn-20564","marks":["code"],"text":"ReputationUpdate"},{"id":"spn-20565","text":", "},{"id":"spn-20566","marks":["code"],"text":"ConsolidationEvent"},{"id":"spn-20567","text":", "},{"id":"spn-20568","marks":["code"],"text":"SurpriseSignal"},{"id":"spn-20569","text":" — flow through CloudEvents v1 envelopes between loops. "},{"id":"spn-20570","marks":["code"],"text":"SurpriseSignal"},{"id":"spn-20571","text":" was added in v0.1.1 for OS-011 (Embodiment Protocol) forward-model-prediction-error emission."}]},{"id":"blk-21511","kind":"paragraph","spans":[{"id":"spn-20572","text":"When working in any subdirectory, treat the local PULSE Loop Manifest as authoritative for that project's loop topology. Cross-loop integrations should reference manifest connections, not hard-coded coupling."}]},{"id":"blk-21512","kind":"heading","level":3,"spans":[{"id":"spn-20573","text":"Arithmetic ladder / box-and-box (the governance kernel)"}]},{"id":"blk-21513","kind":"paragraph","spans":[{"id":"spn-20574","marks":["code"],"text":"box-and-box"},{"id":"spn-20575","text":" (at "},{"id":"spn-20576","marks":["code"],"text":"AmpersandBoxDesign/box-and-box/"},{"id":"spn-20577","text":") is the [&] "},{"id":"spn-20578","marks":["bold"],"text":"governance kernel"},{"id":"spn-20579","text":" — an "},{"id":"spn-20580","marks":["bold"],"text":"eight-rung modality ladder"},{"id":"spn-20581","text":", each rung a small algebra with stated laws:"}]},{"id":"blk-21514","items":[{"blocks":[{"id":"blk-21516","kind":"paragraph","spans":[{"id":"spn-20582","marks":["bold"],"text":"alethic"},{"id":"spn-20583","text":" (value) — what "},{"id":"spn-20584","marks":["italic"],"text":"can"},{"id":"spn-20585","text":" happen · 2. "},{"id":"spn-20586","marks":["bold"],"text":"axiological"},{"id":"spn-20587","text":" (score) — how to rank · 3. "},{"id":"spn-20588","marks":["bold"],"text":"deontic"},{"id":"spn-20589","text":" (norm/govern) — what's "},{"id":"spn-20590","marks":["italic"],"text":"allowed"},{"id":"spn-20591","text":" · 4. "},{"id":"spn-20592","marks":["bold"],"text":"temporal"},{"id":"spn-20593","text":" (supervise) — safe over time · 5. "},{"id":"spn-20594","marks":["bold"],"text":"reflexive"},{"id":"spn-20595","text":" — may the rules change (entrenched ring-0 core) · 6. "},{"id":"spn-20596","marks":["bold"],"text":"epistemic"},{"id":"spn-20597","text":" — do we know enough · 7. "},{"id":"spn-20598","marks":["bold"],"text":"strategic"},{"id":"spn-20599","text":" — who can ensure it · 8. "},{"id":"spn-20600","marks":["bold"],"text":"resource"},{"id":"spn-20601","text":" — can we afford it (affine ledger)."}]}],"id":"blk-21515","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-21517","kind":"paragraph","spans":[{"id":"spn-20602","text":"One composing "},{"id":"spn-20603","marks":["bold"],"text":"bridge"},{"id":"spn-20604","text":" ("},{"id":"spn-20605","marks":["code"],"text":"bridge.mjs"},{"id":"spn-20606","text":") runs floor-then-gradient: "},{"id":"spn-20607","marks":["bold"],"text":"`feasible ▸ permitted ▸ best`"},{"id":"spn-20608","text":" over an un-weakenable safety floor; every verdict ships a certificate. "},{"id":"spn-20609","marks":["bold"],"text":"116 property-tested laws"},{"id":"spn-20610","text":" (103 kernel + 13 compose/CC2; "},{"id":"spn-20611","marks":["code"],"text":"node test/laws.mjs && node test/compose-laws.mjs"},{"id":"spn-20612","text":", 2000 trials each). "},{"id":"spn-20613","marks":["bold"],"text":"Invariant Arithmetic"},{"id":"spn-20614","text":" (the prior "},{"id":"spn-20615","marks":["code"],"text":"opensentience.org/invariant-arithmetic.html"},{"id":"spn-20616","text":" + the TS port in "},{"id":"spn-20617","marks":["code"],"text":"workbench/app/src/lib/ia/"},{"id":"spn-20618","text":") is "},{"id":"spn-20619","marks":["bold"],"text":"rungs 1–2"},{"id":"spn-20620","text":" of this same ladder."}]},{"id":"blk-21518","kind":"paragraph","spans":[{"id":"spn-20621","marks":["bold"],"text":"Important — the 8 rungs are orthogonal to PULSE's 5 phase kinds."},{"id":"spn-20622","text":" Do NOT claim a 1:1 mapping. The rungs govern a "},{"id":"spn-20623","marks":["italic"],"text":"single decision"},{"id":"spn-20624","text":" (a one-shot verdict: may this action proceed, and is it best?); PULSE's "},{"id":"spn-20625","marks":["code"],"text":"retrieve/route/act/learn/consolidate"},{"id":"spn-20626","text":" "},{"id":"spn-20627","marks":["italic"],"text":"sequence a loop over time"},{"id":"spn-20628","text":". The kernel governs "},{"id":"spn-20629","marks":["bold"],"text":"what is allowed to happen at"},{"id":"spn-20630","text":" a phase — it is not itself a set of phases. The package is "},{"id":"spn-20631","marks":["bold"],"text":"pure library, code only"},{"id":"spn-20632","text":" (no bundled HTML); the rung \"living-paper\" pages + interactive "},{"id":"spn-20633","marks":["code"],"text":"playground.html"},{"id":"spn-20634","text":" (64 of 116 laws wired client-side) are website content at "},{"id":"spn-20635","marks":["code"],"text":"opensentience.org/"},{"id":"spn-20636","text":" root; conformance is published at "},{"id":"spn-20637","marks":["code"],"text":"ampersandboxdesign.com/laws.html"},{"id":"spn-20638","text":"."}]},{"id":"blk-21519","kind":"heading","level":3,"spans":[{"id":"spn-20639","text":"Hard requirements"}]},{"id":"blk-21520","items":[{"blocks":[{"id":"blk-21522","kind":"paragraph","spans":[{"id":"spn-20640","text":"Do not skip retrieval habitually — prior context likely exists for most tasks"}]}],"id":"blk-21521","kind":"list-item"},{"blocks":[{"id":"blk-21524","kind":"paragraph","spans":[{"id":"spn-20641","text":"Do not fabricate causal provenance, outcomes, or coverage signals"}]}],"id":"blk-21523","kind":"list-item"},{"blocks":[{"id":"blk-21526","kind":"paragraph","spans":[{"id":"spn-20642","text":"Do not inflate confidence indiscriminately"}]}],"id":"blk-21525","kind":"list-item"},{"blocks":[{"id":"blk-21528","kind":"paragraph","spans":[{"id":"spn-20643","text":"Respect act/learn/escalate routing from goal coverage decisions"}]}],"id":"blk-21527","kind":"list-item"},{"blocks":[{"id":"blk-21530","kind":"paragraph","spans":[{"id":"spn-20644","text":"Store cross-project learnings (e.g., spec decisions that affect multiple apps) as semantic nodes with appropriate edges"}]}],"id":"blk-21529","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraoqvrt7bd6pohqjaoouqp6d3vtdaa5m522mdzlpgjf6msozadcpaa","vocabulary":"ampersand.docs.fs.v1"}