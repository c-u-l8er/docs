9998e19f363c1519679b15d24744d"}]},{"id":"blk-78867","kind":"heading","level":2,"spans":[{"id":"spn-142286","text":"Capability 11: Causal Edge Metadata Prep (1 day)"}]},{"id":"blk-78868","kind":"heading","level":3,"spans":[{"id":"spn-142287","text":"What it does"}]},{"id":"blk-78869","kind":"paragraph","spans":[{"id":"spn-142288","text":"Extends "},{"id":"spn-142289","marks":["code"],"text":":causal"},{"id":"spn-142290","text":" edge metadata to support future CausalEngine (deferred until TickTickClock/WebHost ship). No behavioral changes — just ensuring the data substrate can store causal strength, confounders, and intervention history."}]},{"id":"blk-78870","kind":"heading","level":3,"spans":[{"id":"spn-142291","text":"No schema migration needed"}]},{"id":"blk-78871","kind":"paragraph","spans":[{"id":"spn-142292","text":"Uses existing edge "},{"id":"spn-142293","marks":["code"],"text":"metadata"},{"id":"spn-142294","text":" JSON field:"}]},{"id":"blk-78872","kind":"code","language":"json","text":"{\n  \"causal_strength\": 0.75,\n  \"confounders\": [\"node_id_1\", \"node_id_2\"],\n  \"intervention_history\": [\n    {\"at\": \"2026-04-10T...\", \"action\": \"do(X=0.8)\", \"result\": \"Y increased\"}\n  ]\n}"},{"id":"blk-78873","kind":"heading","level":3,"spans":[{"id":"spn-142295","text":"File: "},{"id":"spn-142296","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-78874","kind":"paragraph","spans":[{"id":"spn-142297","text":"When "},{"id":"spn-142298","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-142299","text":" updates a causal edge, also compute and store "},{"id":"spn-142300","marks":["code"],"text":"causal_strength"},{"id":"spn-142301","text":":"}]},{"id":"blk-78875","kind":"code","language":"elixir","text":"causal_strength = case outcome.status do\n  :success -> min(1.0, old_strength + 0.1)\n  :partial_success -> old_strength  # No change\n  :failure -> max(0.0, old_strength - 0.15)\n  :timeout -> max(0.0, old_strength - 0.05)\nend"},{"id":"blk-78876","kind":"heading","level":3,"spans":[{"id":"spn-142302","text":"Tests"}]},{"id":"blk-78877","items":[{"blocks":[{"id":"blk-78879","kind":"paragraph","spans":[{"id":"spn-142303","text":"Successful outcome strengthens causal edge"}]}],"id":"blk-78878","kind":"list-item"},{"blocks":[{"id":"blk-78881","kind":"paragraph","spans":[{"id":"spn-142304","text":"Failed outcome weakens causal edge"}]}],"id":"blk-78880","kind":"list-item"},{"blocks":[{"id":"blk-78883","kind":"paragraph","spans":[{"id":"spn-142305","text":"causal_strength persists in edge metadata"}]}],"id":"blk-78882","kind":"list-item"},{"blocks":[{"id":"blk-78885","kind":"paragraph","spans":[{"id":"spn-142306","text":"confounders field accepted and stored"}]}],"id":"blk-78884","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-78886","kind":"heading","level":2,"spans":[{"id":"spn-142307","text":"GraphMemBench Phase 3: Full Suite + Competitor Stubs (3 days)"}]},{"id":"blk-78887","kind":"heading","level":3,"spans":[{"id":"spn-142308","text":"Add remaining 40 scenarios (Categories 11-15, 8 each)"}]},{"id":"blk-78888","kind":"paragraph","spans":[{"id":"spn-142309","marks":["bold"],"text":"Category 11: Causal Metadata (8 scenarios)"}]},{"id":"blk-78889","items":[{"blocks":[{"id":"blk-78891","kind":"paragraph","spans":[{"id":"spn-142310","text":"causal_strength updates on outcome success"}]}],"id":"blk-78890","kind":"list-item"},{"blocks":[{"id":"blk-78893","kind":"paragraph","spans":[{"id":"spn-142311","text":"causal_strength decreases on failure"}]}],"id":"blk-78892","kind":"list-item"},{"blocks":[{"id":"blk-78895","kind":"paragraph","spans":[{"id":"spn-142312","text":"confounders stored in edge metadata"}]}],"id":"blk-78894","kind":"list-item"},{"blocks":[{"id":"blk-78897","kind":"paragraph","spans":[{"id":"spn-142313","text":"Causal subgraph extraction (all causal edges from a node)"}]}],"id":"blk-78896","kind":"list-item"},{"blocks":[{"id":"blk-78899","kind":"paragra