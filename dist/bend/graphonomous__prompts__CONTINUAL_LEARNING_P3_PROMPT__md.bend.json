9998e19f363c1519679b15d24744d"}]},{"id":"blk-70766","kind":"heading","level":2,"spans":[{"id":"spn-101788","text":"Capability 11: Causal Edge Metadata Prep (1 day)"}]},{"id":"blk-70767","kind":"heading","level":3,"spans":[{"id":"spn-101789","text":"What it does"}]},{"id":"blk-70768","kind":"paragraph","spans":[{"id":"spn-101790","text":"Extends "},{"id":"spn-101791","marks":["code"],"text":":causal"},{"id":"spn-101792","text":" edge metadata to support future CausalEngine (deferred until TickTickClock/WebHost ship). No behavioral changes — just ensuring the data substrate can store causal strength, confounders, and intervention history."}]},{"id":"blk-70769","kind":"heading","level":3,"spans":[{"id":"spn-101793","text":"No schema migration needed"}]},{"id":"blk-70770","kind":"paragraph","spans":[{"id":"spn-101794","text":"Uses existing edge "},{"id":"spn-101795","marks":["code"],"text":"metadata"},{"id":"spn-101796","text":" JSON field:"}]},{"id":"blk-70771","kind":"code","language":"json","text":"{\n  \"causal_strength\": 0.75,\n  \"confounders\": [\"node_id_1\", \"node_id_2\"],\n  \"intervention_history\": [\n    {\"at\": \"2026-04-10T...\", \"action\": \"do(X=0.8)\", \"result\": \"Y increased\"}\n  ]\n}"},{"id":"blk-70772","kind":"heading","level":3,"spans":[{"id":"spn-101797","text":"File: "},{"id":"spn-101798","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-70773","kind":"paragraph","spans":[{"id":"spn-101799","text":"When "},{"id":"spn-101800","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-101801","text":" updates a causal edge, also compute and store "},{"id":"spn-101802","marks":["code"],"text":"causal_strength"},{"id":"spn-101803","text":":"}]},{"id":"blk-70774","kind":"code","language":"elixir","text":"causal_strength = case outcome.status do\n  :success -> min(1.0, old_strength + 0.1)\n  :partial_success -> old_strength  # No change\n  :failure -> max(0.0, old_strength - 0.15)\n  :timeout -> max(0.0, old_strength - 0.05)\nend"},{"id":"blk-70775","kind":"heading","level":3,"spans":[{"id":"spn-101804","text":"Tests"}]},{"id":"blk-70776","items":[{"blocks":[{"id":"blk-70778","kind":"paragraph","spans":[{"id":"spn-101805","text":"Successful outcome strengthens causal edge"}]}],"id":"blk-70777","kind":"list-item"},{"blocks":[{"id":"blk-70780","kind":"paragraph","spans":[{"id":"spn-101806","text":"Failed outcome weakens causal edge"}]}],"id":"blk-70779","kind":"list-item"},{"blocks":[{"id":"blk-70782","kind":"paragraph","spans":[{"id":"spn-101807","text":"causal_strength persists in edge metadata"}]}],"id":"blk-70781","kind":"list-item"},{"blocks":[{"id":"blk-70784","kind":"paragraph","spans":[{"id":"spn-101808","text":"confounders field accepted and stored"}]}],"id":"blk-70783","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70785","kind":"heading","level":2,"spans":[{"id":"spn-101809","text":"GraphMemBench Phase 3: Full Suite + Competitor Stubs (3 days)"}]},{"id":"blk-70786","kind":"heading","level":3,"spans":[{"id":"spn-101810","text":"Add remaining 40 scenarios (Categories 11-15, 8 each)"}]},{"id":"blk-70787","kind":"paragraph","spans":[{"id":"spn-101811","marks":["bold"],"text":"Category 11: Causal Metadata (8 scenarios)"}]},{"id":"blk-70788","items":[{"blocks":[{"id":"blk-70790","kind":"paragraph","spans":[{"id":"spn-101812","text":"causal_strength updates on outcome success"}]}],"id":"blk-70789","kind":"list-item"},{"blocks":[{"id":"blk-70792","kind":"paragraph","spans":[{"id":"spn-101813","text":"causal_strength decreases on failure"}]}],"id":"blk-70791","kind":"list-item"},{"blocks":[{"id":"blk-70794","kind":"paragraph","spans":[{"id":"spn-101814","text":"confounders stored in edge metadata"}]}],"id":"blk-70793","kind":"list-item"},{"blocks":[{"id":"blk-70796","kind":"paragraph","spans":[{"id":"spn-101815","text":"Causal subgraph extraction (all causal edges from a node)"}]}],"id":"blk-70795","kind":"list-item"},{"blocks":[{"id":"blk-70798","kind":"paragra