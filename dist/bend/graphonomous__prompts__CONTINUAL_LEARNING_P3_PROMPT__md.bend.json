9998e19f363c1519679b15d24744d"}]},{"id":"blk-71720","kind":"heading","level":2,"spans":[{"id":"spn-104575","text":"Capability 11: Causal Edge Metadata Prep (1 day)"}]},{"id":"blk-71721","kind":"heading","level":3,"spans":[{"id":"spn-104576","text":"What it does"}]},{"id":"blk-71722","kind":"paragraph","spans":[{"id":"spn-104577","text":"Extends "},{"id":"spn-104578","marks":["code"],"text":":causal"},{"id":"spn-104579","text":" edge metadata to support future CausalEngine (deferred until TickTickClock/WebHost ship). No behavioral changes — just ensuring the data substrate can store causal strength, confounders, and intervention history."}]},{"id":"blk-71723","kind":"heading","level":3,"spans":[{"id":"spn-104580","text":"No schema migration needed"}]},{"id":"blk-71724","kind":"paragraph","spans":[{"id":"spn-104581","text":"Uses existing edge "},{"id":"spn-104582","marks":["code"],"text":"metadata"},{"id":"spn-104583","text":" JSON field:"}]},{"id":"blk-71725","kind":"code","language":"json","text":"{\n  \"causal_strength\": 0.75,\n  \"confounders\": [\"node_id_1\", \"node_id_2\"],\n  \"intervention_history\": [\n    {\"at\": \"2026-04-10T...\", \"action\": \"do(X=0.8)\", \"result\": \"Y increased\"}\n  ]\n}"},{"id":"blk-71726","kind":"heading","level":3,"spans":[{"id":"spn-104584","text":"File: "},{"id":"spn-104585","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"}]},{"id":"blk-71727","kind":"paragraph","spans":[{"id":"spn-104586","text":"When "},{"id":"spn-104587","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-104588","text":" updates a causal edge, also compute and store "},{"id":"spn-104589","marks":["code"],"text":"causal_strength"},{"id":"spn-104590","text":":"}]},{"id":"blk-71728","kind":"code","language":"elixir","text":"causal_strength = case outcome.status do\n  :success -> min(1.0, old_strength + 0.1)\n  :partial_success -> old_strength  # No change\n  :failure -> max(0.0, old_strength - 0.15)\n  :timeout -> max(0.0, old_strength - 0.05)\nend"},{"id":"blk-71729","kind":"heading","level":3,"spans":[{"id":"spn-104591","text":"Tests"}]},{"id":"blk-71730","items":[{"blocks":[{"id":"blk-71732","kind":"paragraph","spans":[{"id":"spn-104592","text":"Successful outcome strengthens causal edge"}]}],"id":"blk-71731","kind":"list-item"},{"blocks":[{"id":"blk-71734","kind":"paragraph","spans":[{"id":"spn-104593","text":"Failed outcome weakens causal edge"}]}],"id":"blk-71733","kind":"list-item"},{"blocks":[{"id":"blk-71736","kind":"paragraph","spans":[{"id":"spn-104594","text":"causal_strength persists in edge metadata"}]}],"id":"blk-71735","kind":"list-item"},{"blocks":[{"id":"blk-71738","kind":"paragraph","spans":[{"id":"spn-104595","text":"confounders field accepted and stored"}]}],"id":"blk-71737","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71739","kind":"heading","level":2,"spans":[{"id":"spn-104596","text":"GraphMemBench Phase 3: Full Suite + Competitor Stubs (3 days)"}]},{"id":"blk-71740","kind":"heading","level":3,"spans":[{"id":"spn-104597","text":"Add remaining 40 scenarios (Categories 11-15, 8 each)"}]},{"id":"blk-71741","kind":"paragraph","spans":[{"id":"spn-104598","marks":["bold"],"text":"Category 11: Causal Metadata (8 scenarios)"}]},{"id":"blk-71742","items":[{"blocks":[{"id":"blk-71744","kind":"paragraph","spans":[{"id":"spn-104599","text":"causal_strength updates on outcome success"}]}],"id":"blk-71743","kind":"list-item"},{"blocks":[{"id":"blk-71746","kind":"paragraph","spans":[{"id":"spn-104600","text":"causal_strength decreases on failure"}]}],"id":"blk-71745","kind":"list-item"},{"blocks":[{"id":"blk-71748","kind":"paragraph","spans":[{"id":"spn-104601","text":"confounders stored in edge metadata"}]}],"id":"blk-71747","kind":"list-item"},{"blocks":[{"id":"blk-71750","kind":"paragraph","spans":[{"id":"spn-104602","text":"Causal subgraph extraction (all causal edges from a node)"}]}],"id":"blk-71749","kind":"list-item"},{"blocks":[{"id":"blk-71752","kind":"paragra