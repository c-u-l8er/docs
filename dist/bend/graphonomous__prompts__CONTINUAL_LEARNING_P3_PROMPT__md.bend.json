 - 0.05)\nend"},{"id":"blk-70901","kind":"heading","level":3,"spans":[{"id":"spn-101952","text":"Tests"}]},{"id":"blk-70902","items":[{"blocks":[{"id":"blk-70904","kind":"paragraph","spans":[{"id":"spn-101953","text":"Successful outcome strengthens causal edge"}]}],"id":"blk-70903","kind":"list-item"},{"blocks":[{"id":"blk-70906","kind":"paragraph","spans":[{"id":"spn-101954","text":"Failed outcome weakens causal edge"}]}],"id":"blk-70905","kind":"list-item"},{"blocks":[{"id":"blk-70908","kind":"paragraph","spans":[{"id":"spn-101955","text":"causal_strength persists in edge metadata"}]}],"id":"blk-70907","kind":"list-item"},{"blocks":[{"id":"blk-70910","kind":"paragraph","spans":[{"id":"spn-101956","text":"confounders field accepted and stored"}]}],"id":"blk-70909","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70911","kind":"heading","level":2,"spans":[{"id":"spn-101957","text":"GraphMemBench Phase 3: Full Suite + Competitor Stubs (3 days)"}]},{"id":"blk-70912","kind":"heading","level":3,"spans":[{"id":"spn-101958","text":"Add remaining 40 scenarios (Categories 11-15, 8 each)"}]},{"id":"blk-70913","kind":"paragraph","spans":[{"id":"spn-101959","marks":["bold"],"text":"Category 11: Causal Metadata (8 scenarios)"}]},{"id":"blk-70914","items":[{"blocks":[{"id":"blk-70916","kind":"paragraph","spans":[{"id":"spn-101960","text":"causal_strength updates on outcome success"}]}],"id":"blk-70915","kind":"list-item"},{"blocks":[{"id":"blk-70918","kind":"paragraph","spans":[{"id":"spn-101961","text":"causal_strength decreases on failure"}]}],"id":"blk-70917","kind":"list-item"},{"blocks":[{"id":"blk-70920","kind":"paragraph","spans":[{"id":"spn-101962","text":"confounders stored in edge metadata"}]}],"id":"blk-70919","kind":"list-item"},{"blocks":[{"id":"blk-70922","kind":"paragraph","spans":[{"id":"spn-101963","text":"Causal subgraph extraction (all causal edges from a node)"}]}],"id":"blk-70921","kind":"list-item"},{"blocks":[{"id":"blk-70924","kind":"paragra