{"bendscript":"0.1","blocks":[{"id":"blk-62883","kind":"paragraph","spans":[{"id":"spn-92615","text":"BUILD ========"}]},{"id":"blk-62884","kind":"paragraph","spans":[{"id":"spn-92616","text":"Manual npm Publish Path (No CI Token Dependency) ------------------------------------------------"}]},{"id":"blk-62885","kind":"paragraph","spans":[{"id":"spn-92617","text":"This guide handles the exact case where "},{"id":"spn-92618","marks":["code"],"text":"npm i -g graphonomous"},{"id":"spn-92619","text":" fails because the expected GitHub release asset does not exist yet."}]},{"id":"blk-62886","kind":"paragraph","spans":[{"id":"spn-92620","text":"Error pattern:"}]},{"id":"blk-62887","items":[{"blocks":[{"id":"blk-62889","kind":"paragraph","spans":[{"id":"spn-92621","text":"npm postinstall tries to download:"}]}],"id":"blk-62888","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62890","kind":"paragraph","spans":[{"id":"spn-92622","marks":["code"],"text":"https://github.com/c-u-l8er/graphonomous/releases/download/vX.Y.Z/graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-62891","items":[{"blocks":[{"id":"blk-62893","kind":"paragraph","spans":[{"id":"spn-92623","text":"install fails with "},{"id":"spn-92624","marks":["code"],"text":"HTTP 404"},{"id":"spn-92625","text":" when release/tag/assets are missing."}]}],"id":"blk-62892","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62894","kind":"paragraph","spans":[{"id":"spn-92626","text":"Prerequisites -------------"}]},{"id":"blk-62895","items":[{"blocks":[{"id":"blk-62897","kind":"paragraph","spans":[{"id":"spn-92627","text":"You are in this repo: "},{"id":"spn-92628","marks":["code"],"text":"ProjectAmp2/graphonomous"}]}],"id":"blk-62896","kind":"list-item"},{"blocks":[{"id":"blk-62899","kind":"paragraph","spans":[{"id":"spn-92629","marks":["code"],"text":"gh auth status"},{"id":"spn-92630","text":" is valid for the target GitHub account/org"}]}],"id":"blk-62898","kind":"list-item"},{"blocks":[{"id":"blk-62901","kind":"paragraph","spans":[{"id":"spn-92631","marks":["code"],"text":"npm whoami"},{"id":"spn-92632","text":" is valid for the npm publisher account"}]}],"id":"blk-62900","kind":"list-item"},{"blocks":[{"id":"blk-62903","kind":"paragraph","spans":[{"id":"spn-92633","text":"Local toolchain is installed (Elixir/OTP, Node/npm, git, tar)"}]}],"id":"blk-62902","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62904","items":[{"blocks":[{"id":"blk-62906","kind":"paragraph","spans":[{"id":"spn-92634","text":"Set version once (important)"}]}],"id":"blk-62905","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-62907","kind":"paragraph","spans":[{"id":"spn-92635","text":"Pick one version and use it consistently in all commands below."}]},{"id":"blk-62908","kind":"code","language":"bash","text":"VERSION=\"0.1.1\"\nTAG=\"v${VERSION}\"\nTARGET=\"linux-x64\"\nASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\""},{"id":"blk-62909","items":[{"blocks":[{"id":"blk-62911","kind":"paragraph","spans":[{"id":"spn-92636","text":"Ensure local project version matches"}]}],"id":"blk-62910","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-62912","kind":"paragraph","spans":[{"id":"spn-92637","text":"Confirm versions:"}]},{"id":"blk-62913","items":[{"blocks":[{"id":"blk-62915","kind":"paragraph","spans":[{"id":"spn-92638","marks":["code"],"text":"mix.exs"},{"id":"spn-92639","text":" -> "},{"id":"spn-92640","marks":["code"],"text":"version: \"0.1.1\""}]}],"id":"blk-62914","kind":"list-item"},{"blocks":[{"id":"blk-62917","kind":"paragraph","spans":[{"id":"spn-92641","marks":["code"],"text":"npm/package.json"},{"id":"spn-92642","text":" -> "},{"id":"spn-92643","marks":["code"],"text":"\"version\": \"0.1.1\""}]}],"id":"blk-62916","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62918","kind":"paragraph","spans":[{"id":"spn-92644","text":"Quick checks:"}]},{"id":"blk-62919","kind":"code","language":"bash","text":"grep -n 'version:' mix.exs\nnode -p \"require('./npm/package.json').version\""},{"id":"blk-62920","items":[{"blocks":[{"id":"blk-62922","kind":"paragraph","spans":[{"id":"spn-92645","text":"Build OTP release and package asset"}]}],"id":"blk-62921","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-62923","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\nls -lh \"dist/${ASSET}\""},{"id":"blk-62924","kind":"paragraph","spans":[{"id":"spn-92646","text":"Sanity check the release command:"}]},{"id":"blk-62925","kind":"code","language":"bash","text":"_build/prod/rel/graphonomous/bin/graphonomous version\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"},{"id":"blk-62926","items":[{"blocks":[{"id":"blk-62928","kind":"paragraph","spans":[{"id":"spn-92647","text":"Create tag if missing and push it"}]}],"id":"blk-62927","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-62929","kind":"paragraph","spans":[{"id":"spn-92648","text":"Check if the tag exists locally/remotely:"}]},{"id":"blk-62930","kind":"code","language":"bash","text":"git tag --list \"${TAG}\"\ngit ls-remote --tags origin \"${TAG}\""},{"id":"blk-62931","kind":"paragraph","spans":[{"id":"spn-92649","text":"If missing locally:"}]},{"id":"blk-62932","kind":"code","language":"bash","text":"git tag \"${TAG}\""},{"id":"blk-62933","kind":"paragraph","spans":[{"id":"spn-92650","text":"Push tag (safe if already present remotely; it will fail noisily if conflicting):"}]},{"id":"blk-62934","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-62935","items":[{"blocks":[{"id":"blk-62937","kind":"paragraph","spans":[{"id":"spn-92651","text":"Create GitHub release if missing"}]}],"id":"blk-62936","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-62938","kind":"paragraph","spans":[{"id":"spn-92652","text":"Your previous error "},{"id":"spn-92653","marks":["code"],"text":"release not found"},{"id":"spn-92654","text":" means this step is required."}]},{"id":"blk-62939","kind":"paragraph","spans":[{"id":"spn-92655","text":"Create release and upload first asset in one command:"}]},{"id":"blk-62940","kind":"code","language":"bash","text":"gh release create \"${TAG}\" \"dist/${ASSET}\" \\\n  --title \"${TAG}\" \\\n  --notes \"Manual release assets upload\""},{"id":"blk-62941","kind":"paragraph","spans":[{"id":"spn-92656","text":"If release already exists, upload (or replace) asset:"}]},{"id":"blk-62942","kind":"code","language":"bash","text":"gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber"},{"id":"blk-62943","kind":"paragraph","spans":[{"id":"spn-92657","text":"Verify release + assets:"}]},{"id":"blk-62944","kind":"code","language":"bash","text":"gh release view \"${TAG}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-62945","items":[{"blocks":[{"id":"blk-62947","kind":"paragraph","spans":[{"id":"spn-92658","text":"Re-test npm install"}]}],"id":"blk-62946","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-62948","kind":"code","language":"bash","text":"npm i -g graphonomous\ngraphonomous --help"},{"id":"blk-62949","kind":"paragraph","spans":[{"id":"spn-92659","text":"If global install was partially broken earlier, clean and retry:"}]},{"id":"blk-62950","kind":"code","language":"bash","text":"npm uninstall -g graphonomous\nnpm cache verify\nnpm i -g graphonomous"},{"id":"blk-62951","items":[{"blocks":[{"id":"blk-62953","kind":"paragraph","spans":[{"id":"spn-92660","text":"Optional: Quick runtime smoke test"}]}],"id":"blk-62952","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-62954","kind":"code","language":"bash","text":"mkdir -p ~/.graphonomous\ngraphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-62955","kind":"paragraph","spans":[{"id":"spn-92661","text":"(Stop with "},{"id":"spn-92662","marks":["code"],"text":"Ctrl+C"},{"id":"spn-92663","text":" after startup confirmation.)"}]},{"id":"blk-62956","kind":"paragraph","spans":[{"id":"spn-92664","text":"If release creation still fails -------------------------------"}]},{"id":"blk-62957","kind":"heading","level":3,"spans":[{"id":"spn-92665","text":"A) "},{"id":"spn-92666","marks":["code"],"text":"gh release create ..."},{"id":"spn-92667","text":" says tag is missing"}]},{"id":"blk-62958","kind":"paragraph","spans":[{"id":"spn-92668","text":"Push the tag first:"}]},{"id":"blk-62959","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-62960","kind":"heading","level":3,"spans":[{"id":"spn-92669","text":"B) Permission error on release create/upload"}]},{"id":"blk-62961","kind":"paragraph","spans":[{"id":"spn-92670","text":"Check GitHub auth/account:"}]},{"id":"blk-62962","kind":"code","language":"bash","text":"gh auth status\ngh repo view"},{"id":"blk-62963","kind":"paragraph","spans":[{"id":"spn-92671","text":"Ensure you have write access to "},{"id":"spn-92672","marks":["code"],"text":"c-u-l8er/graphonomous"},{"id":"spn-92673","text":"."}]},{"id":"blk-62964","kind":"heading","level":3,"spans":[{"id":"spn-92674","text":"C) npm still fails with 404"}]},{"id":"blk-62965","kind":"paragraph","spans":[{"id":"spn-92675","text":"Confirm asset naming exactly matches what installer expects:"}]},{"id":"blk-62966","kind":"code","language":"bash","text":"echo \"Expected: ${ASSET}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-62967","kind":"paragraph","spans":[{"id":"spn-92676","text":"Name must match exactly: "},{"id":"spn-92677","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-62968","kind":"heading","level":3,"spans":[{"id":"spn-92678","text":"D) Zed shows \"context server request timeout\""}]},{"id":"blk-62969","kind":"paragraph"