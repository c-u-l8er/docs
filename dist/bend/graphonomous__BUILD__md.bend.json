n "},{"id":"spn-92692","marks":["code"],"text":"graphonomous --help"},{"id":"spn-92693","text":" in shell from the same environment as Zed launch."}]}],"id":"blk-62986","kind":"list-item"},{"blocks":[{"id":"blk-62989","kind":"paragraph","spans":[{"id":"spn-92694","text":"Re-check npm package version and release source:"}]}],"id":"blk-62988","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-62990","items":[{"blocks":[{"id":"blk-62992","kind":"paragraph","spans":[{"id":"spn-92695","marks":["code"],"text":"npm view graphonomous version"}]}],"id":"blk-62991","kind":"list-item"},{"blocks":[{"id":"blk-62994","kind":"paragraph","spans":[{"id":"spn-92696","marks":["code"],"text":"npm ls -g --depth=0 graphonomous"}]}],"id":"blk-62993","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62995","kind":"paragraph","spans":[{"id":"spn-92697","text":"Multi-platform publishing (later) ---------------------------------"}]},{"id":"blk-62996","kind":"paragraph","spans":[{"id":"spn-92698","text":"For broader support, repeat asset build/upload on each target machine:"}]},{"id":"blk-62997","items":[{"blocks":[{"id":"blk-62999","kind":"paragraph","spans":[{"id":"spn-92699","marks":["code"],"text":"linux-x64"}]}],"id":"blk-62998","kind":"list-item"},{"blocks":[{"id":"blk-63001","kind":"paragraph","spans":[{"id":"spn-92700","marks":["code"],"text":"linux-arm64"}]}],"id":"blk-63000","kind":"list-item"},{"blocks":[{"id":"blk-63003","kind":"paragraph","spans":[{"id":"spn-92701","marks":["code"],"text":"darwin-x64"}]}],"id":"blk-63002","kind":"list-item"},{"blocks":[{"id":"blk-63005","kind":"paragraph","spans":[{"id":"spn-92702","marks":["code"],"text":"darwin-arm64"}]}],"id":"blk-63004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63006","kind":"paragraph","spans":[{"id":"spn-92703","text":"Asset names must follow:"}]},{"id":"blk-63007","items":[{"blocks":[{"id":"blk-63009","kind":"paragraph","spans":[{"id":"spn-92704","marks":["code"],"text":"graphono