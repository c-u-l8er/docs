{"bendscript":"0.1","blocks":[{"id":"blk-63020","kind":"paragraph","spans":[{"id":"spn-92816","text":"BUILD ========"}]},{"id":"blk-63021","kind":"paragraph","spans":[{"id":"spn-92817","text":"Manual npm Publish Path (No CI Token Dependency) ------------------------------------------------"}]},{"id":"blk-63022","kind":"paragraph","spans":[{"id":"spn-92818","text":"This guide handles the exact case where "},{"id":"spn-92819","marks":["code"],"text":"npm i -g graphonomous"},{"id":"spn-92820","text":" fails because the expected GitHub release asset does not exist yet."}]},{"id":"blk-63023","kind":"paragraph","spans":[{"id":"spn-92821","text":"Error pattern:"}]},{"id":"blk-63024","items":[{"blocks":[{"id":"blk-63026","kind":"paragraph","spans":[{"id":"spn-92822","text":"npm postinstall tries to download:"}]}],"id":"blk-63025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63027","kind":"paragraph","spans":[{"id":"spn-92823","marks":["code"],"text":"https://github.com/c-u-l8er/graphonomous/releases/download/vX.Y.Z/graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-63028","items":[{"blocks":[{"id":"blk-63030","kind":"paragraph","spans":[{"id":"spn-92824","text":"install fails with "},{"id":"spn-92825","marks":["code"],"text":"HTTP 404"},{"id":"spn-92826","text":" when release/tag/assets are missing."}]}],"id":"blk-63029","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63031","kind":"paragraph","spans":[{"id":"spn-92827","text":"Prerequisites -------------"}]},{"id":"blk-63032","items":[{"blocks":[{"id":"blk-63034","kind":"paragraph","spans":[{"id":"spn-92828","text":"You are in this repo: "},{"id":"spn-92829","marks":["code"],"text":"ProjectAmp2/graphonomous"}]}],"id":"blk-63033","kind":"list-item"},{"blocks":[{"id":"blk-63036","kind":"paragraph","spans":[{"id":"spn-92830","marks":["code"],"text":"gh auth status"},{"id":"spn-92831","text":" is valid for the target GitHub account/org"}]}],"id":"blk-63035","kind":"list-item"},{"blocks":[{"id":"blk-63038","kind":"paragraph","spans":[{"id":"spn-92832","marks":["code"],"text":"npm whoami"},{"id":"spn-92833","text":" is valid for the npm publisher account"}]}],"id":"blk-63037","kind":"list-item"},{"blocks":[{"id":"blk-63040","kind":"paragraph","spans":[{"id":"spn-92834","text":"Local toolchain is installed (Elixir/OTP, Node/npm, git, tar)"}]}],"id":"blk-63039","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63041","items":[{"blocks":[{"id":"blk-63043","kind":"paragraph","spans":[{"id":"spn-92835","text":"Set version once (important)"}]}],"id":"blk-63042","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63044","kind":"paragraph","spans":[{"id":"spn-92836","text":"Pick one version and use it consistently in all commands below."}]},{"id":"blk-63045","kind":"code","language":"bash","text":"VERSION=\"0.1.1\"\nTAG=\"v${VERSION}\"\nTARGET=\"linux-x64\"\nASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\""},{"id":"blk-63046","items":[{"blocks":[{"id":"blk-63048","kind":"paragraph","spans":[{"id":"spn-92837","text":"Ensure local project version matches"}]}],"id":"blk-63047","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63049","kind":"paragraph","spans":[{"id":"spn-92838","text":"Confirm versions:"}]},{"id":"blk-63050","items":[{"blocks":[{"id":"blk-63052","kind":"paragraph","spans":[{"id":"spn-92839","marks":["code"],"text":"mix.exs"},{"id":"spn-92840","text":" -> "},{"id":"spn-92841","marks":["code"],"text":"version: \"0.1.1\""}]}],"id":"blk-63051","kind":"list-item"},{"blocks":[{"id":"blk-63054","kind":"paragraph","spans":[{"id":"spn-92842","marks":["code"],"text":"npm/package.json"},{"id":"spn-92843","text":" -> "},{"id":"spn-92844","marks":["code"],"text":"\"version\": \"0.1.1\""}]}],"id":"blk-63053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63055","kind":"paragraph","spans":[{"id":"spn-92845","text":"Quick checks:"}]},{"id":"blk-63056","kind":"code","language":"bash","text":"grep -n 'version:' mix.exs\nnode -p \"require('./npm/package.json').version\""},{"id":"blk-63057","items":[{"blocks":[{"id":"blk-63059","kind":"paragraph","spans":[{"id":"spn-92846","text":"Build OTP release and package asset"}]}],"id":"blk-63058","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-63060","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\nls -lh \"dist/${ASSET}\""},{"id":"blk-63061","kind":"paragraph","spans":[{"id":"spn-92847","text":"Sanity check the release command:"}]},{"id":"blk-63062","kind":"code","language":"bash","text":"_build/prod/rel/graphonomous/bin/graphonomous version\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"},{"id":"blk-63063","items":[{"blocks":[{"id":"blk-63065","kind":"paragraph","spans":[{"id":"spn-92848","text":"Create tag if missing and push it"}]}],"id":"blk-63064","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-63066","kind":"paragraph","spans":[{"id":"spn-92849","text":"Check if the tag exists locally/remotely:"}]},{"id":"blk-63067","kind":"code","language":"bash","text":"git tag --list \"${TAG}\"\ngit ls-remote --tags origin \"${TAG}\""},{"id":"blk-63068","kind":"paragraph","spans":[{"id":"spn-92850","text":"If missing locally:"}]},{"id":"blk-63069","kind":"code","language":"bash","text":"git tag \"${TAG}\""},{"id":"blk-63070","kind":"paragraph","spans":[{"id":"spn-92851","text":"Push tag (safe if already present remotely; it will fail noisily if conflicting):"}]},{"id":"blk-63071","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-63072","items":[{"blocks":[{"id":"blk-63074","kind":"paragraph","spans":[{"id":"spn-92852","text":"Create GitHub release if missing"}]}],"id":"blk-63073","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-63075","kind":"paragraph","spans":[{"id":"spn-92853","text":"Your previous error "},{"id":"spn-92854","marks":["code"],"text":"release not found"},{"id":"spn-92855","text":" means this step is required."}]},{"id":"blk-63076","kind":"paragraph","spans":[{"id":"spn-92856","text":"Create release and upload first asset in one command:"}]},{"id":"blk-63077","kind":"code","language":"bash","text":"gh release create \"${TAG}\" \"dist/${ASSET}\" \\\n  --title \"${TAG}\" \\\n  --notes \"Manual release assets upload\""},{"id":"blk-63078","kind":"paragraph","spans":[{"id":"spn-92857","text":"If release already exists, upload (or replace) asset:"}]},{"id":"blk-63079","kind":"code","language":"bash","text":"gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber"},{"id":"blk-63080","kind":"paragraph","spans":[{"id":"spn-92858","text":"Verify release + assets:"}]},{"id":"blk-63081","kind":"code","language":"bash","text":"gh release view \"${TAG}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-63082","items":[{"blocks":[{"id":"blk-63084","kind":"paragraph","spans":[{"id":"spn-92859","text":"Re-test npm install"}]}],"id":"blk-63083","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-63085","kind":"code","language":"bash","text":"npm i -g graphonomous\ngraphonomous --help"},{"id":"blk-63086","kind":"paragraph","spans":[{"id":"spn-92860","text":"If global install was partially broken earlier, clean and retry:"}]},{"id":"blk-63087","kind":"code","language":"bash","text":"npm uninstall -g graphonomous\nnpm cache verify\nnpm i -g graphonomous"},{"id":"blk-63088","items":[{"blocks":[{"id":"blk-63090","kind":"paragraph","spans":[{"id":"spn-92861","text":"Optional: Quick runtime smoke test"}]}],"id":"blk-63089","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-63091","kind":"code","language":"bash","text":"mkdir -p ~/.graphonomous\ngraphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-63092","kind":"paragraph","spans":[{"id":"spn-92862","text":"(Stop with "},{"id":"spn-92863","marks":["code"],"text":"Ctrl+C"},{"id":"spn-92864","text":" after startup confirmation.)"}]},{"id":"blk-63093","kind":"paragraph","spans":[{"id":"spn-92865","text":"If release creation still fails -------------------------------"}]},{"id":"blk-63094","kind":"heading","level":3,"spans":[{"id":"spn-92866","text":"A) "},{"id":"spn-92867","marks":["code"],"text":"gh release create ..."},{"id":"spn-92868","text":" says tag is missing"}]},{"id":"blk-63095","kind":"paragraph","spans":[{"id":"spn-92869","text":"Push the tag first:"}]},{"id":"blk-63096","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-63097","kind":"heading","level":3,"spans":[{"id":"spn-92870","text":"B) Permission error on release create/upload"}]},{"id":"blk-63098","kind":"paragraph","spans":[{"id":"spn-92871","text":"Check GitHub auth/account:"}]},{"id":"blk-63099","kind":"code","language":"bash","text":"gh auth status\ngh repo view"},{"id":"blk-63100","kind":"paragraph","spans":[{"id":"spn-92872","text":"Ensure you have write access to "},{"id":"spn-92873","marks":["code"],"text":"c-u-l8er/graphonomous"},{"id":"spn-92874","text":"."}]},{"id":"blk-63101","kind":"heading","level":3,"spans":[{"id":"spn-92875","text":"C) npm still fails with 404"}]},{"id":"blk-63102","kind":"paragraph","spans":[{"id":"spn-92876","text":"Confirm asset naming exactly matches what installer expects:"}]},{"id":"blk-63103","kind":"code","language":"bash","text":"echo \"Expected: ${ASSET}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-63104","kind":"paragraph","spans":[{"id":"spn-92877","text":"Name must match exactly: "},{"id":"spn-92878","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-63105","kind":"heading","level":3,"spans":[{"id":"spn-92879","text":"D) Zed shows \"context server request timeout\""}]},{"id":"blk-63106","kind":"paragraph","spans":[{"id":"spn-92880","text":"This can occur if your runtime is using older stdio transport behavior from upstream Anubis MCP (decoded message list handling / stdio response write issues)."}]},{"id":"blk-63107","kind":"paragraph","spans":[{"id":"spn-92881","text":"Graphonomous production path uses a vendored Anubis patch:"}]},{"id":"blk-63108","items":[{"blocks":[{"id":"blk-63110","kind":"paragraph","spans":[{"id":"spn-92882","text":"dependency is pinned to "},{"id":"spn-92883","marks":["code"],"text":"vendor/anubis_mcp"}]}],"id":"blk-63109","kind":"list-item"},{"blocks":[{"id":"blk-63112","kind":"paragraph","spans":[{"id":"spn-92884","text":"stdio transport fixes are in:"}]}],"id":"blk-63111","kind":"list-item"},{"blocks":[{"id":"blk-63114","kind":"paragraph","spans":[{"id":"spn-92885","marks":["code"],"text":"vendor/anubis_mcp/lib/anubis/server/transport/stdio.ex"}]}],"id":"blk-63113","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63115","kind":"paragraph","spans":[{"id":"spn-92886","text":"Verify your runtime is actually using vendored dependency code (not stale compiled deps):"}]},{"id":"blk-63116","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nmix deps.get\nmix clean\nrm -rf _build deps\nmix deps.get\nmix compile --warnings-as-errors\nmix test test/mcp_integration_test.exs"},{"id":"blk-63117","kind":"paragraph","spans":[{"id":"spn-92887","text":"If timeout persists in Zed:"}]},{"id":"blk-63118","items":[{"blocks":[{"id":"blk-63120","kind":"paragraph","spans":[{"id":"spn-92888","text":"Restart Zed completely."}]}],"id":"blk-63119","kind":"list-item"},{"blocks":[{"id":"blk-63122","kind":"paragraph","spans":[{"id":"spn-92889","text":"Confirm your MCP command points at the expected "},{"id":"spn-92890","marks":["code"],"text":"graphonomous"},{"id":"spn-92891","text":" binary/version."}]}],"id":"blk-63121","kind":"list-item"},{"blocks":[{"id":"blk-63124","kind":"paragraph","spans":[{"id":"spn-92892","text":"Run "},{"id":"spn-92893","marks":["code"],"text":"graphonomous --help"},{"id":"spn-92894","text":" in shell from the same environment as Zed launch."}]}],"id":"blk-63123","kind":"list-item"},{"blocks":[{"id":"blk-63126","kind":"paragraph","spans":[{"id":"spn-92895","text":"Re-check npm package version and release source:"}]}],"id":"blk-63125","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63127","items":[{"blocks":[{"id":"blk-63129","kind":"paragraph","spans":[{"id":"spn-92896","marks":["code"],"text":"npm view graphonomous version"}]}],"id":"blk-63128","kind":"list-item"},{"blocks":[{"id":"blk-63131","kind":"paragraph","spans":[{"id":"spn-92897","marks":["code"],"text":"npm ls -g --depth=0 graphonomous"}]}],"id":"blk-63130","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63132","kind":"paragraph","spans":[{"id":"spn-92898","text":"Multi-platform publishing (later) ---------------------------------"}]},{"id":"blk-63133","kind":"paragraph","spans":[{"id":"spn-92899","text":"For broader support, repeat asset build/upload on each target machine:"}]},{"id":"blk-63134","items":[{"blocks":[{"id":"blk-63136","kind":"paragraph","spans":[{"id":"spn-92900","marks":["code"],"text":"linux-x64"}]}],"id":"blk-63135","kind":"list-item"},{"blocks":[{"id":"blk-63138","kind":"paragraph","spans":[{"id":"spn-92901","marks":["code"],"text":"linux-arm64"}]}],"id":"blk-63137","kind":"list-item"},{"blocks":[{"id":"blk-63140","kind":"paragraph","spans":[{"id":"spn-92902","marks":["code"],"text":"darwin-x64"}]}],"id":"blk-63139","kind":"list-item"},{"blocks":[{"id":"blk-63142","kind":"paragraph","spans":[{"id":"spn-92903","marks":["code"],"text":"darwin-arm64"}]}],"id":"blk-63141","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63143","kind":"paragraph","spans":[{"id":"spn-92904","text":"Asset names must follow:"}]},{"id":"blk-63144","items":[{"blocks":[{"id":"blk-63146","kind":"paragraph","spans":[{"id":"spn-92905","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]}],"id":"blk-63145","kind":"list-item"},{"blocks":[{"id":"blk-63148","kind":"paragraph","spans":[{"id":"spn-92906","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-arm64.tar.gz"}]}],"id":"blk-63147","kind":"list-item"},{"blocks":[{"id":"blk-63150","kind":"paragraph","spans":[{"id":"spn-92907","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-x64.tar.gz"}]}],"id":"blk-63149","kind":"list-item"},{"blocks":[{"id":"blk-63152","kind":"paragraph","spans":[{"id":"spn-92908","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-arm64.tar.gz"}]}],"id":"blk-63151","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63153","kind":"paragraph","spans":[{"id":"spn-92909","text":"Minimal command checklist -------------------------"}]},{"id":"blk-63154","kind":"code","language":"bash","text":"# note: bump version here, in mix.exs, and npm/package.json too\n# then git push with version as commit name after running:\ncd /home/travis/ProjectAmp2/graphonomous\nVERSION=\"0.1.10\"; TAG=\"v${VERSION}\"; TARGET=\"linux-x64\"; ASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\"\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\ngit tag \"${TAG}\" 2>/dev/null || true\ngit push origin \"${TAG}\"\ngh release create \"${TAG}\" \"dist/${ASSET}\" --title \"${TAG}\" --notes \"Manual release assets upload\" || gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber\nnpm i -g graphonomous\ngraphonomous --help\ncd ./npm\nnpm publish"}],"edges":[],"id":"bagaaieraltphgch6hqhrxxkjbkao4plcnt4kw7tsoou25ewwr4zitt4lj23a","vocabulary":"ampersand.docs.fs.v1"}