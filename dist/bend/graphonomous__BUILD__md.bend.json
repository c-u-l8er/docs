{"bendscript":"0.1","blocks":[{"id":"blk-70501","kind":"paragraph","spans":[{"id":"spn-132282","text":"BUILD ========"}]},{"id":"blk-70502","kind":"paragraph","spans":[{"id":"spn-132283","text":"Manual npm Publish Path (No CI Token Dependency) ------------------------------------------------"}]},{"id":"blk-70503","kind":"paragraph","spans":[{"id":"spn-132284","text":"This guide handles the exact case where "},{"id":"spn-132285","marks":["code"],"text":"npm i -g graphonomous"},{"id":"spn-132286","text":" fails because the expected GitHub release asset does not exist yet."}]},{"id":"blk-70504","kind":"paragraph","spans":[{"id":"spn-132287","text":"Error pattern:"}]},{"id":"blk-70505","items":[{"blocks":[{"id":"blk-70507","kind":"paragraph","spans":[{"id":"spn-132288","text":"npm postinstall tries to download:"}]}],"id":"blk-70506","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70508","kind":"paragraph","spans":[{"id":"spn-132289","marks":["code"],"text":"https://github.com/c-u-l8er/graphonomous/releases/download/vX.Y.Z/graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-70509","items":[{"blocks":[{"id":"blk-70511","kind":"paragraph","spans":[{"id":"spn-132290","text":"install fails with "},{"id":"spn-132291","marks":["code"],"text":"HTTP 404"},{"id":"spn-132292","text":" when release/tag/assets are missing."}]}],"id":"blk-70510","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70512","kind":"paragraph","spans":[{"id":"spn-132293","text":"Prerequisites -------------"}]},{"id":"blk-70513","items":[{"blocks":[{"id":"blk-70515","kind":"paragraph","spans":[{"id":"spn-132294","text":"You are in this repo: "},{"id":"spn-132295","marks":["code"],"text":"ProjectAmp2/graphonomous"}]}],"id":"blk-70514","kind":"list-item"},{"blocks":[{"id":"blk-70517","kind":"paragraph","spans":[{"id":"spn-132296","marks":["code"],"text":"gh auth status"},{"id":"spn-132297","text":" is valid for the target GitHub account/org"}]}],"id":"blk-70516","kind":"list-item"},{"blocks":[{"id":"blk-70519","kind":"paragraph","spans":[{"id":"spn-132298","marks":["code"],"text":"npm whoami"},{"id":"spn-132299","text":" is valid for the npm publisher account"}]}],"id":"blk-70518","kind":"list-item"},{"blocks":[{"id":"blk-70521","kind":"paragraph","spans":[{"id":"spn-132300","text":"Local toolchain is installed (Elixir/OTP, Node/npm, git, tar)"}]}],"id":"blk-70520","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70522","items":[{"blocks":[{"id":"blk-70524","kind":"paragraph","spans":[{"id":"spn-132301","text":"Set version once (important)"}]}],"id":"blk-70523","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-70525","kind":"paragraph","spans":[{"id":"spn-132302","text":"Pick one version and use it consistently in all commands below."}]},{"id":"blk-70526","kind":"code","language":"bash","text":"VERSION=\"0.1.1\"\nTAG=\"v${VERSION}\"\nTARGET=\"linux-x64\"\nASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\""},{"id":"blk-70527","items":[{"blocks":[{"id":"blk-70529","kind":"paragraph","spans":[{"id":"spn-132303","text":"Ensure local project version matches"}]}],"id":"blk-70528","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-70530","kind":"paragraph","spans":[{"id":"spn-132304","text":"Confirm versions:"}]},{"id":"blk-70531","items":[{"blocks":[{"id":"blk-70533","kind":"paragraph","spans":[{"id":"spn-132305","marks":["code"],"text":"mix.exs"},{"id":"spn-132306","text":" -> "},{"id":"spn-132307","marks":["code"],"text":"version: \"0.1.1\""}]}],"id":"blk-70532","kind":"list-item"},{"blocks":[{"id":"blk-70535","kind":"paragraph","spans":[{"id":"spn-132308","marks":["code"],"text":"npm/package.json"},{"id":"spn-132309","text":" -> "},{"id":"spn-132310","marks":["code"],"text":"\"version\": \"0.1.1\""}]}],"id":"blk-70534","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70536","kind":"paragraph","spans":[{"id":"spn-132311","text":"Quick checks:"}]},{"id":"blk-70537","kind":"code","language":"bash","text":"grep -n 'version:' mix.exs\nnode -p \"require('./npm/package.json').version\""},{"id":"blk-70538","items":[{"blocks":[{"id":"blk-70540","kind":"paragraph","spans":[{"id":"spn-132312","text":"Build OTP release and package asset"}]}],"id":"blk-70539","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-70541","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\nls -lh \"dist/${ASSET}\""},{"id":"blk-70542","kind":"paragraph","spans":[{"id":"spn-132313","text":"Sanity check the release command:"}]},{"id":"blk-70543","kind":"code","language":"bash","text":"_build/prod/rel/graphonomous/bin/graphonomous version\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"},{"id":"blk-70544","items":[{"blocks":[{"id":"blk-70546","kind":"paragraph","spans":[{"id":"spn-132314","text":"Create tag if missing and push it"}]}],"id":"blk-70545","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-70547","kind":"paragraph","spans":[{"id":"spn-132315","text":"Check if the tag exists locally/remotely:"}]},{"id":"blk-70548","kind":"code","language":"bash","text":"git tag --list \"${TAG}\"\ngit ls-remote --tags origin \"${TAG}\""},{"id":"blk-70549","kind":"paragraph","spans":[{"id":"spn-132316","text":"If missing locally:"}]},{"id":"blk-70550","kind":"code","language":"bash","text":"git tag \"${TAG}\""},{"id":"blk-70551","kind":"paragraph","spans":[{"id":"spn-132317","text":"Push tag (safe if already present remotely; it will fail noisily if conflicting):"}]},{"id":"blk-70552","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-70553","items":[{"blocks":[{"id":"blk-70555","kind":"paragraph","spans":[{"id":"spn-132318","text":"Create GitHub release if missing"}]}],"id":"blk-70554","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-70556","kind":"paragraph","spans":[{"id":"spn-132319","text":"Your previous error "},{"id":"spn-132320","marks":["code"],"text":"release not found"},{"id":"spn-132321","text":" means this step is required."}]},{"id":"blk-70557","kind":"paragraph","spans":[{"id":"spn-132322","text":"Create release and upload first asset in one command:"}]},{"id":"blk-70558","kind":"code","language":"bash","text":"gh release create \"${TAG}\" \"dist/${ASSET}\" \\\n  --title \"${TAG}\" \\\n  --notes \"Manual release assets upload\""},{"id":"blk-70559","kind":"paragraph","spans":[{"id":"spn-132323","text":"If release already exists, upload (or replace) asset:"}]},{"id":"blk-70560","kind":"code","language":"bash","text":"gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber"},{"id":"blk-70561","kind":"paragraph","spans":[{"id":"spn-132324","text":"Verify release + assets:"}]},{"id":"blk-70562","kind":"code","language":"bash","text":"gh release view \"${TAG}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-70563","items":[{"blocks":[{"id":"blk-70565","kind":"paragraph","spans":[{"id":"spn-132325","text":"Re-test npm install"}]}],"id":"blk-70564","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-70566","kind":"code","language":"bash","text":"npm i -g graphonomous\ngraphonomous --help"},{"id":"blk-70567","kind":"paragraph","spans":[{"id":"spn-132326","text":"If global install was partially broken earlier, clean and retry:"}]},{"id":"blk-70568","kind":"code","language":"bash","text":"npm uninstall -g graphonomous\nnpm cache verify\nnpm i -g graphonomous"},{"id":"blk-70569","items":[{"blocks":[{"id":"blk-70571","kind":"paragraph","spans":[{"id":"spn-132327","text":"Optional: Quick runtime smoke test"}]}],"id":"blk-70570","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-70572","kind":"code","language":"bash","text":"mkdir -p ~/.graphonomous\ngraphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-70573","kind":"paragraph","spans":[{"id":"spn-132328","text":"(Stop with "},{"id":"spn-132329","marks":["code"],"text":"Ctrl+C"},{"id":"spn-132330","text":" after startup confirmation.)"}]},{"id":"blk-70574","kind":"paragraph","spans":[{"id":"spn-132331","text":"If release creation still fails -------------------------------"}]},{"id":"blk-70575","kind":"heading","level":3,"spans":[{"id":"spn-132332","text":"A) "},{"id":"spn-132333","marks":["code"],"text":"gh release create ..."},{"id":"spn-132334","text":" says tag is missing"}]},{"id":"blk-70576","kind":"paragraph","spans":[{"id":"spn-132335","text":"Push the tag first:"}]},{"id":"blk-70577","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-70578","kind":"heading","level":3,"spans":[{"id":"spn-132336","text":"B) Permission error on release create/upload"}]},{"id":"blk-70579","kind":"paragraph","spans":[{"id":"spn-132337","text":"Check GitHub auth/account:"}]},{"id":"blk-70580","kind":"code","language":"bash","text":"gh auth status\ngh repo view"},{"id":"blk-70581","kind":"paragraph","spans":[{"id":"spn-132338","text":"Ensure you have write access to "},{"id":"spn-132339","marks":["code"],"text":"c-u-l8er/graphonomous"},{"id":"spn-132340","text":"."}]},{"id":"blk-70582","kind":"heading","level":3,"spans":[{"id":"spn-132341","text":"C) npm still fails with 404"}]},{"id":"blk-70583","kind":"paragraph","spans":[{"id":"spn-132342","text":"Confirm asset naming exactly matches what installer expects:"}]},{"id":"blk-70584","kind":"code","language":"bash","text":"echo \"Expected: ${ASSET}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-70585","kind":"paragraph","spans":[{"id":"spn-132343","text":"Name must match exactly: "},{"id":"spn-132344","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-70586","kind":"heading","level":3,"spans":[{"id":"spn-132345","text":"D) Zed shows \"context server request timeout\""}]},{"id":"blk-70587","kind":"paragraph","spans":[{"id":"spn-132346","text":"This can occur if your runtime is using older stdio transport behavior from upstream Anubis MCP (decoded message list handling / stdio response write issues)."}]},{"id":"blk-70588","kind":"paragraph","spans":[{"id":"spn-132347","text":"Graphonomous production path uses a vendored Anubis patch:"}]},{"id":"blk-70589","items":[{"blocks":[{"id":"blk-70591","kind":"paragraph","spans":[{"id":"spn-132348","text":"dependency is pinned to "},{"id":"spn-132349","marks":["code"],"text":"vendor/anubis_mcp"}]}],"id":"blk-70590","kind":"list-item"},{"blocks":[{"id":"blk-70593","kind":"paragraph","spans":[{"id":"spn-132350","text":"stdio transport fixes are in:"}]}],"id":"blk-70592","kind":"list-item"},{"blocks":[{"id":"blk-70595","kind":"paragraph","spans":[{"id":"spn-132351","marks":["code"],"text":"vendor/anubis_mcp/lib/anubis/server/transport/stdio.ex"}]}],"id":"blk-70594","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70596","kind":"paragraph","spans":[{"id":"spn-132352","text":"Verify your runtime is actually using vendored dependency code (not stale compiled deps):"}]},{"id":"blk-70597","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nmix deps.get\nmix clean\nrm -rf _build deps\nmix deps.get\nmix compile --warnings-as-errors\nmix test test/mcp_integration_test.exs"},{"id":"blk-70598","kind":"paragraph","spans":[{"id":"spn-132353","text":"If timeout persists in Zed:"}]},{"id":"blk-70599","items":[{"blocks":[{"id":"blk-70601","kind":"paragraph","spans":[{"id":"spn-132354","text":"Restart Zed completely."}]}],"id":"blk-70600","kind":"list-item"},{"blocks":[{"id":"blk-70603","kind":"paragraph","spans":[{"id":"spn-132355","text":"Confirm your MCP command points at the expected "},{"id":"spn-132356","marks":["code"],"text":"graphonomous"},{"id":"spn-132357","text":" binary/version."}]}],"id":"blk-70602","kind":"list-item"},{"blocks":[{"id":"blk-70605","kind":"paragraph","spans":[{"id":"spn-132358","text":"Run "},{"id":"spn-132359","marks":["code"],"text":"graphonomous --help"},{"id":"spn-132360","text":" in shell from the same environment as Zed launch."}]}],"id":"blk-70604","kind":"list-item"},{"blocks":[{"id":"blk-70607","kind":"paragraph","spans":[{"id":"spn-132361","text":"Re-check npm package version and release source:"}]}],"id":"blk-70606","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-70608","items":[{"blocks":[{"id":"blk-70610","kind":"paragraph","spans":[{"id":"spn-132362","marks":["code"],"text":"npm view graphonomous version"}]}],"id":"blk-70609","kind":"list-item"},{"blocks":[{"id":"blk-70612","kind":"paragraph","spans":[{"id":"spn-132363","marks":["code"],"text":"npm ls -g --depth=0 graphonomous"}]}],"id":"blk-70611","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70613","kind":"paragraph","spans":[{"id":"spn-132364","text":"Multi-platform publishing (later) ---------------------------------"}]},{"id":"blk-70614","kind":"paragraph","spans":[{"id":"spn-132365","text":"For broader support, repeat asset build/upload on each target machine:"}]},{"id":"blk-70615","items":[{"blocks":[{"id":"blk-70617","kind":"paragraph","spans":[{"id":"spn-132366","marks":["code"],"text":"linux-x64"}]}],"id":"blk-70616","kind":"list-item"},{"blocks":[{"id":"blk-70619","kind":"paragraph","spans":[{"id":"spn-132367","marks":["code"],"text":"linux-arm64"}]}],"id":"blk-70618","kind":"list-item"},{"blocks":[{"id":"blk-70621","kind":"paragraph","spans":[{"id":"spn-132368","marks":["code"],"text":"darwin-x64"}]}],"id":"blk-70620","kind":"list-item"},{"blocks":[{"id":"blk-70623","kind":"paragraph","spans":[{"id":"spn-132369","marks":["code"],"text":"darwin-arm64"}]}],"id":"blk-70622","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70624","kind":"paragraph","spans":[{"id":"spn-132370","text":"Asset names must follow:"}]},{"id":"blk-70625","items":[{"blocks":[{"id":"blk-70627","kind":"paragraph","spans":[{"id":"spn-132371","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]}],"id":"blk-70626","kind":"list-item"},{"blocks":[{"id":"blk-70629","kind":"paragraph","spans":[{"id":"spn-132372","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-arm64.tar.gz"}]}],"id":"blk-70628","kind":"list-item"},{"blocks":[{"id":"blk-70631","kind":"paragraph","spans":[{"id":"spn-132373","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-x64.tar.gz"}]}],"id":"blk-70630","kind":"list-item"},{"blocks":[{"id":"blk-70633","kind":"paragraph","spans":[{"id":"spn-132374","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-arm64.tar.gz"}]}],"id":"blk-70632","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70634","kind":"paragraph","spans":[{"id":"spn-132375","text":"Minimal command checklist -------------------------"}]},{"id":"blk-70635","kind":"code","language":"bash","text":"# note: bump version here, in mix.exs, and npm/package.json too\n# then git push with version as commit name after running:\ncd /home/travis/ProjectAmp2/graphonomous\nVERSION=\"0.1.10\"; TAG=\"v${VERSION}\"; TARGET=\"linux-x64\"; ASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\"\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\ngit tag \"${TAG}\" 2>/dev/null || true\ngit push origin \"${TAG}\"\ngh release create \"${TAG}\" \"dist/${ASSET}\" --title \"${TAG}\" --notes \"Manual release assets upload\" || gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber\nnpm i -g graphonomous\ngraphonomous --help\ncd ./npm\nnpm publish"}],"edges":[],"id":"bagaaieramn3dfhnc347jtn74udprwsfjihensa6lcwze2m42f6moresud7ua","vocabulary":"ampersand.docs.fs.v1"}