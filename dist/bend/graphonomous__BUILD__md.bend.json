{"bendscript":"0.1","blocks":[{"id":"blk-63848","kind":"paragraph","spans":[{"id":"spn-95429","text":"BUILD ========"}]},{"id":"blk-63849","kind":"paragraph","spans":[{"id":"spn-95430","text":"Manual npm Publish Path (No CI Token Dependency) ------------------------------------------------"}]},{"id":"blk-63850","kind":"paragraph","spans":[{"id":"spn-95431","text":"This guide handles the exact case where "},{"id":"spn-95432","marks":["code"],"text":"npm i -g graphonomous"},{"id":"spn-95433","text":" fails because the expected GitHub release asset does not exist yet."}]},{"id":"blk-63851","kind":"paragraph","spans":[{"id":"spn-95434","text":"Error pattern:"}]},{"id":"blk-63852","items":[{"blocks":[{"id":"blk-63854","kind":"paragraph","spans":[{"id":"spn-95435","text":"npm postinstall tries to download:"}]}],"id":"blk-63853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63855","kind":"paragraph","spans":[{"id":"spn-95436","marks":["code"],"text":"https://github.com/c-u-l8er/graphonomous/releases/download/vX.Y.Z/graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-63856","items":[{"blocks":[{"id":"blk-63858","kind":"paragraph","spans":[{"id":"spn-95437","text":"install fails with "},{"id":"spn-95438","marks":["code"],"text":"HTTP 404"},{"id":"spn-95439","text":" when release/tag/assets are missing."}]}],"id":"blk-63857","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63859","kind":"paragraph","spans":[{"id":"spn-95440","text":"Prerequisites -------------"}]},{"id":"blk-63860","items":[{"blocks":[{"id":"blk-63862","kind":"paragraph","spans":[{"id":"spn-95441","text":"You are in this repo: "},{"id":"spn-95442","marks":["code"],"text":"ProjectAmp2/graphonomous"}]}],"id":"blk-63861","kind":"list-item"},{"blocks":[{"id":"blk-63864","kind":"paragraph","spans":[{"id":"spn-95443","marks":["code"],"text":"gh auth status"},{"id":"spn-95444","text":" is valid for the target GitHub account/org"}]}],"id":"blk-63863","kind":"list-item"},{"blocks":[{"id":"blk-63866","kind":"paragraph","spans":[{"id":"spn-95445","marks":["code"],"text":"npm whoami"},{"id":"spn-95446","text":" is valid for the npm publisher account"}]}],"id":"blk-63865","kind":"list-item"},{"blocks":[{"id":"blk-63868","kind":"paragraph","spans":[{"id":"spn-95447","text":"Local toolchain is installed (Elixir/OTP, Node/npm, git, tar)"}]}],"id":"blk-63867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63869","items":[{"blocks":[{"id":"blk-63871","kind":"paragraph","spans":[{"id":"spn-95448","text":"Set version once (important)"}]}],"id":"blk-63870","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63872","kind":"paragraph","spans":[{"id":"spn-95449","text":"Pick one version and use it consistently in all commands below."}]},{"id":"blk-63873","kind":"code","language":"bash","text":"VERSION=\"0.1.1\"\nTAG=\"v${VERSION}\"\nTARGET=\"linux-x64\"\nASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\""},{"id":"blk-63874","items":[{"blocks":[{"id":"blk-63876","kind":"paragraph","spans":[{"id":"spn-95450","text":"Ensure local project version matches"}]}],"id":"blk-63875","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63877","kind":"paragraph","spans":[{"id":"spn-95451","text":"Confirm versions:"}]},{"id":"blk-63878","items":[{"blocks":[{"id":"blk-63880","kind":"paragraph","spans":[{"id":"spn-95452","marks":["code"],"text":"mix.exs"},{"id":"spn-95453","text":" -> "},{"id":"spn-95454","marks":["code"],"text":"version: \"0.1.1\""}]}],"id":"blk-63879","kind":"list-item"},{"blocks":[{"id":"blk-63882","kind":"paragraph","spans":[{"id":"spn-95455","marks":["code"],"text":"npm/package.json"},{"id":"spn-95456","text":" -> "},{"id":"spn-95457","marks":["code"],"text":"\"version\": \"0.1.1\""}]}],"id":"blk-63881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63883","kind":"paragraph","spans":[{"id":"spn-95458","text":"Quick checks:"}]},{"id":"blk-63884","kind":"code","language":"bash","text":"grep -n 'version:' mix.exs\nnode -p \"require('./npm/package.json').version\""},{"id":"blk-63885","items":[{"blocks":[{"id":"blk-63887","kind":"paragraph","spans":[{"id":"spn-95459","text":"Build OTP release and package asset"}]}],"id":"blk-63886","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-63888","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\nls -lh \"dist/${ASSET}\""},{"id":"blk-63889","kind":"paragraph","spans":[{"id":"spn-95460","text":"Sanity check the release command:"}]},{"id":"blk-63890","kind":"code","language":"bash","text":"_build/prod/rel/graphonomous/bin/graphonomous version\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"},{"id":"blk-63891","items":[{"blocks":[{"id":"blk-63893","kind":"paragraph","spans":[{"id":"spn-95461","text":"Create tag if missing and push it"}]}],"id":"blk-63892","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-63894","kind":"paragraph","spans":[{"id":"spn-95462","text":"Check if the tag exists locally/remotely:"}]},{"id":"blk-63895","kind":"code","language":"bash","text":"git tag --list \"${TAG}\"\ngit ls-remote --tags origin \"${TAG}\""},{"id":"blk-63896","kind":"paragraph","spans":[{"id":"spn-95463","text":"If missing locally:"}]},{"id":"blk-63897","kind":"code","language":"bash","text":"git tag \"${TAG}\""},{"id":"blk-63898","kind":"paragraph","spans":[{"id":"spn-95464","text":"Push tag (safe if already present remotely; it will fail noisily if conflicting):"}]},{"id":"blk-63899","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-63900","items":[{"blocks":[{"id":"blk-63902","kind":"paragraph","spans":[{"id":"spn-95465","text":"Create GitHub release if missing"}]}],"id":"blk-63901","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-63903","kind":"paragraph","spans":[{"id":"spn-95466","text":"Your previous error "},{"id":"spn-95467","marks":["code"],"text":"release not found"},{"id":"spn-95468","text":" means this step is required."}]},{"id":"blk-63904","kind":"paragraph","spans":[{"id":"spn-95469","text":"Create release and upload first asset in one command:"}]},{"id":"blk-63905","kind":"code","language":"bash","text":"gh release create \"${TAG}\" \"dist/${ASSET}\" \\\n  --title \"${TAG}\" \\\n  --notes \"Manual release assets upload\""},{"id":"blk-63906","kind":"paragraph","spans":[{"id":"spn-95470","text":"If release already exists, upload (or replace) asset:"}]},{"id":"blk-63907","kind":"code","language":"bash","text":"gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber"},{"id":"blk-63908","kind":"paragraph","spans":[{"id":"spn-95471","text":"Verify release + assets:"}]},{"id":"blk-63909","kind":"code","language":"bash","text":"gh release view \"${TAG}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-63910","items":[{"blocks":[{"id":"blk-63912","kind":"paragraph","spans":[{"id":"spn-95472","text":"Re-test npm install"}]}],"id":"blk-63911","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-63913","kind":"code","language":"bash","text":"npm i -g graphonomous\ngraphonomous --help"},{"id":"blk-63914","kind":"paragraph","spans":[{"id":"spn-95473","text":"If global install was partially broken earlier, clean and retry:"}]},{"id":"blk-63915","kind":"code","language":"bash","text":"npm uninstall -g graphonomous\nnpm cache verify\nnpm i -g graphonomous"},{"id":"blk-63916","items":[{"blocks":[{"id":"blk-63918","kind":"paragraph","spans":[{"id":"spn-95474","text":"Optional: Quick runtime smoke test"}]}],"id":"blk-63917","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-63919","kind":"code","language":"bash","text":"mkdir -p ~/.graphonomous\ngraphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-63920","kind":"paragraph","spans":[{"id":"spn-95475","text":"(Stop with "},{"id":"spn-95476","marks":["code"],"text":"Ctrl+C"},{"id":"spn-95477","text":" after startup confirmation.)"}]},{"id":"blk-63921","kind":"paragraph","spans":[{"id":"spn-95478","text":"If release creation still fails -------------------------------"}]},{"id":"blk-63922","kind":"heading","level":3,"spans":[{"id":"spn-95479","text":"A) "},{"id":"spn-95480","marks":["code"],"text":"gh release create ..."},{"id":"spn-95481","text":" says tag is missing"}]},{"id":"blk-63923","kind":"paragraph","spans":[{"id":"spn-95482","text":"Push the tag first:"}]},{"id":"blk-63924","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-63925","kind":"heading","level":3,"spans":[{"id":"spn-95483","text":"B) Permission error on release create/upload"}]},{"id":"blk-63926","kind":"paragraph","spans":[{"id":"spn-95484","text":"Check GitHub auth/account:"}]},{"id":"blk-63927","kind":"code","language":"bash","text":"gh auth status\ngh repo view"},{"id":"blk-63928","kind":"paragraph","spans":[{"id":"spn-95485","text":"Ensure you have write access to "},{"id":"spn-95486","marks":["code"],"text":"c-u-l8er/graphonomous"},{"id":"spn-95487","text":"."}]},{"id":"blk-63929","kind":"heading","level":3,"spans":[{"id":"spn-95488","text":"C) npm still fails with 404"}]},{"id":"blk-63930","kind":"paragraph","spans":[{"id":"spn-95489","text":"Confirm asset naming exactly matches what installer expects:"}]},{"id":"blk-63931","kind":"code","language":"bash","text":"echo \"Expected: ${ASSET}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-63932","kind":"paragraph","spans":[{"id":"spn-95490","text":"Name must match exactly: "},{"id":"spn-95491","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-63933","kind":"heading","level":3,"spans":[{"id":"spn-95492","text":"D) Zed shows \"context server request timeout\""}]},{"id":"blk-63934","kind":"paragraph","spans":[{"id":"spn-95493","text":"This can occur if your runtime is using older stdio transport behavior from upstream Anubis MCP (decoded message list handling / stdio response write issues)."}]},{"id":"blk-63935","kind":"paragraph","spans":[{"id":"spn-95494","text":"Graphonomous production path uses a vendored Anubis patch:"}]},{"id":"blk-63936","items":[{"blocks":[{"id":"blk-63938","kind":"paragraph","spans":[{"id":"spn-95495","text":"dependency is pinned to "},{"id":"spn-95496","marks":["code"],"text":"vendor/anubis_mcp"}]}],"id":"blk-63937","kind":"list-item"},{"blocks":[{"id":"blk-63940","kind":"paragraph","spans":[{"id":"spn-95497","text":"stdio transport fixes are in:"}]}],"id":"blk-63939","kind":"list-item"},{"blocks":[{"id":"blk-63942","kind":"paragraph","spans":[{"id":"spn-95498","marks":["code"],"text":"vendor/anubis_mcp/lib/anubis/server/transport/stdio.ex"}]}],"id":"blk-63941","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63943","kind":"paragraph","spans":[{"id":"spn-95499","text":"Verify your runtime is actually using vendored dependency code (not stale compiled deps):"}]},{"id":"blk-63944","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nmix deps.get\nmix clean\nrm -rf _build deps\nmix deps.get\nmix compile --warnings-as-errors\nmix test test/mcp_integration_test.exs"},{"id":"blk-63945","kind":"paragraph","spans":[{"id":"spn-95500","text":"If timeout persists in Zed:"}]},{"id":"blk-63946","items":[{"blocks":[{"id":"blk-63948","kind":"paragraph","spans":[{"id":"spn-95501","text":"Restart Zed completely."}]}],"id":"blk-63947","kind":"list-item"},{"blocks":[{"id":"blk-63950","kind":"paragraph","spans":[{"id":"spn-95502","text":"Confirm your MCP command points at the expected "},{"id":"spn-95503","marks":["code"],"text":"graphonomous"},{"id":"spn-95504","text":" binary/version."}]}],"id":"blk-63949","kind":"list-item"},{"blocks":[{"id":"blk-63952","kind":"paragraph","spans":[{"id":"spn-95505","text":"Run "},{"id":"spn-95506","marks":["code"],"text":"graphonomous --help"},{"id":"spn-95507","text":" in shell from the same environment as Zed launch."}]}],"id":"blk-63951","kind":"list-item"},{"blocks":[{"id":"blk-63954","kind":"paragraph","spans":[{"id":"spn-95508","text":"Re-check npm package version and release source:"}]}],"id":"blk-63953","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63955","items":[{"blocks":[{"id":"blk-63957","kind":"paragraph","spans":[{"id":"spn-95509","marks":["code"],"text":"npm view graphonomous version"}]}],"id":"blk-63956","kind":"list-item"},{"blocks":[{"id":"blk-63959","kind":"paragraph","spans":[{"id":"spn-95510","marks":["code"],"text":"npm ls -g --depth=0 graphonomous"}]}],"id":"blk-63958","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63960","kind":"paragraph","spans":[{"id":"spn-95511","text":"Multi-platform publishing (later) ---------------------------------"}]},{"id":"blk-63961","kind":"paragraph","spans":[{"id":"spn-95512","text":"For broader support, repeat asset build/upload on each target machine:"}]},{"id":"blk-63962","items":[{"blocks":[{"id":"blk-63964","kind":"paragraph","spans":[{"id":"spn-95513","marks":["code"],"text":"linux-x64"}]}],"id":"blk-63963","kind":"list-item"},{"blocks":[{"id":"blk-63966","kind":"paragraph","spans":[{"id":"spn-95514","marks":["code"],"text":"linux-arm64"}]}],"id":"blk-63965","kind":"list-item"},{"blocks":[{"id":"blk-63968","kind":"paragraph","spans":[{"id":"spn-95515","marks":["code"],"text":"darwin-x64"}]}],"id":"blk-63967","kind":"list-item"},{"blocks":[{"id":"blk-63970","kind":"paragraph","spans":[{"id":"spn-95516","marks":["code"],"text":"darwin-arm64"}]}],"id":"blk-63969","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63971","kind":"paragraph","spans":[{"id":"spn-95517","text":"Asset names must follow:"}]},{"id":"blk-63972","items":[{"blocks":[{"id":"blk-63974","kind":"paragraph","spans":[{"id":"spn-95518","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]}],"id":"blk-63973","kind":"list-item"},{"blocks":[{"id":"blk-63976","kind":"paragraph","spans":[{"id":"spn-95519","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-arm64.tar.gz"}]}],"id":"blk-63975","kind":"list-item"},{"blocks":[{"id":"blk-63978","kind":"paragraph","spans":[{"id":"spn-95520","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-x64.tar.gz"}]}],"id":"blk-63977","kind":"list-item"},{"blocks":[{"id":"blk-63980","kind":"paragraph","spans":[{"id":"spn-95521","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-arm64.tar.gz"}]}],"id":"blk-63979","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63981","kind":"paragraph","spans":[{"id":"spn-95522","text":"Minimal command checklist -------------------------"}]},{"id":"blk-63982","kind":"code","language":"bash","text":"# note: bump version here, in mix.exs, and npm/package.json too\n# then git push with version as commit name after running:\ncd /home/travis/ProjectAmp2/graphonomous\nVERSION=\"0.1.10\"; TAG=\"v${VERSION}\"; TARGET=\"linux-x64\"; ASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\"\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\ngit tag \"${TAG}\" 2>/dev/null || true\ngit push origin \"${TAG}\"\ngh release create \"${TAG}\" \"dist/${ASSET}\" --title \"${TAG}\" --notes \"Manual release assets upload\" || gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber\nnpm i -g graphonomous\ngraphonomous --help\ncd ./npm\nnpm publish"}],"edges":[],"id":"bagaaierasbrtug7o6uljrv4ptvrfu3qqx7ali3ssvebyjw5jscxxdrwuckqq","vocabulary":"ampersand.docs.fs.v1"}