{"bendscript":"0.1","blocks":[{"id":"blk-62894","kind":"paragraph","spans":[{"id":"spn-92668","text":"BUILD ========"}]},{"id":"blk-62895","kind":"paragraph","spans":[{"id":"spn-92669","text":"Manual npm Publish Path (No CI Token Dependency) ------------------------------------------------"}]},{"id":"blk-62896","kind":"paragraph","spans":[{"id":"spn-92670","text":"This guide handles the exact case where "},{"id":"spn-92671","marks":["code"],"text":"npm i -g graphonomous"},{"id":"spn-92672","text":" fails because the expected GitHub release asset does not exist yet."}]},{"id":"blk-62897","kind":"paragraph","spans":[{"id":"spn-92673","text":"Error pattern:"}]},{"id":"blk-62898","items":[{"blocks":[{"id":"blk-62900","kind":"paragraph","spans":[{"id":"spn-92674","text":"npm postinstall tries to download:"}]}],"id":"blk-62899","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62901","kind":"paragraph","spans":[{"id":"spn-92675","marks":["code"],"text":"https://github.com/c-u-l8er/graphonomous/releases/download/vX.Y.Z/graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-62902","items":[{"blocks":[{"id":"blk-62904","kind":"paragraph","spans":[{"id":"spn-92676","text":"install fails with "},{"id":"spn-92677","marks":["code"],"text":"HTTP 404"},{"id":"spn-92678","text":" when release/tag/assets are missing."}]}],"id":"blk-62903","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62905","kind":"paragraph","spans":[{"id":"spn-92679","text":"Prerequisites -------------"}]},{"id":"blk-62906","items":[{"blocks":[{"id":"blk-62908","kind":"paragraph","spans":[{"id":"spn-92680","text":"You are in this repo: "},{"id":"spn-92681","marks":["code"],"text":"ProjectAmp2/graphonomous"}]}],"id":"blk-62907","kind":"list-item"},{"blocks":[{"id":"blk-62910","kind":"paragraph","spans":[{"id":"spn-92682","marks":["code"],"text":"gh auth status"},{"id":"spn-92683","text":" is valid for the target GitHub account/org"}]}],"id":"blk-62909","kind":"list-item"},{"blocks":[{"id":"blk-62912","kind":"paragraph","spans":[{"id":"spn-92684","marks":["code"],"text":"npm whoami"},{"id":"spn-92685","text":" is valid for the npm publisher account"}]}],"id":"blk-62911","kind":"list-item"},{"blocks":[{"id":"blk-62914","kind":"paragraph","spans":[{"id":"spn-92686","text":"Local toolchain is installed (Elixir/OTP, Node/npm, git, tar)"}]}],"id":"blk-62913","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62915","items":[{"blocks":[{"id":"blk-62917","kind":"paragraph","spans":[{"id":"spn-92687","text":"Set version once (important)"}]}],"id":"blk-62916","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-62918","kind":"paragraph","spans":[{"id":"spn-92688","text":"Pick one version and use it consistently in all commands below."}]},{"id":"blk-62919","kind":"code","language":"bash","text":"VERSION=\"0.1.1\"\nTAG=\"v${VERSION}\"\nTARGET=\"linux-x64\"\nASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\""},{"id":"blk-62920","items":[{"blocks":[{"id":"blk-62922","kind":"paragraph","spans":[{"id":"spn-92689","text":"Ensure local project version matches"}]}],"id":"blk-62921","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-62923","kind":"paragraph","spans":[{"id":"spn-92690","text":"Confirm versions:"}]},{"id":"blk-62924","items":[{"blocks":[{"id":"blk-62926","kind":"paragraph","spans":[{"id":"spn-92691","marks":["code"],"text":"mix.exs"},{"id":"spn-92692","text":" -> "},{"id":"spn-92693","marks":["code"],"text":"version: \"0.1.1\""}]}],"id":"blk-62925","kind":"list-item"},{"blocks":[{"id":"blk-62928","kind":"paragraph","spans":[{"id":"spn-92694","marks":["code"],"text":"npm/package.json"},{"id":"spn-92695","text":" -> "},{"id":"spn-92696","marks":["code"],"text":"\"version\": \"0.1.1\""}]}],"id":"blk-62927","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62929","kind":"paragraph","spans":[{"id":"spn-92697","text":"Quick checks:"}]},{"id":"blk-62930","kind":"code","language":"bash","text":"grep -n 'version:' mix.exs\nnode -p \"require('./npm/package.json').version\""},{"id":"blk-62931","items":[{"blocks":[{"id":"blk-62933","kind":"paragraph","spans":[{"id":"spn-92698","text":"Build OTP release and package asset"}]}],"id":"blk-62932","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-62934","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\nls -lh \"dist/${ASSET}\""},{"id":"blk-62935","kind":"paragraph","spans":[{"id":"spn-92699","text":"Sanity check the release command:"}]},{"id":"blk-62936","kind":"code","language":"bash","text":"_build/prod/rel/graphonomous/bin/graphonomous version\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" --help"},{"id":"blk-62937","items":[{"blocks":[{"id":"blk-62939","kind":"paragraph","spans":[{"id":"spn-92700","text":"Create tag if missing and push it"}]}],"id":"blk-62938","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-62940","kind":"paragraph","spans":[{"id":"spn-92701","text":"Check if the tag exists locally/remotely:"}]},{"id":"blk-62941","kind":"code","language":"bash","text":"git tag --list \"${TAG}\"\ngit ls-remote --tags origin \"${TAG}\""},{"id":"blk-62942","kind":"paragraph","spans":[{"id":"spn-92702","text":"If missing locally:"}]},{"id":"blk-62943","kind":"code","language":"bash","text":"git tag \"${TAG}\""},{"id":"blk-62944","kind":"paragraph","spans":[{"id":"spn-92703","text":"Push tag (safe if already present remotely; it will fail noisily if conflicting):"}]},{"id":"blk-62945","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-62946","items":[{"blocks":[{"id":"blk-62948","kind":"paragraph","spans":[{"id":"spn-92704","text":"Create GitHub release if missing"}]}],"id":"blk-62947","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-62949","kind":"paragraph","spans":[{"id":"spn-92705","text":"Your previous error "},{"id":"spn-92706","marks":["code"],"text":"release not found"},{"id":"spn-92707","text":" means this step is required."}]},{"id":"blk-62950","kind":"paragraph","spans":[{"id":"spn-92708","text":"Create release and upload first asset in one command:"}]},{"id":"blk-62951","kind":"code","language":"bash","text":"gh release create \"${TAG}\" \"dist/${ASSET}\" \\\n  --title \"${TAG}\" \\\n  --notes \"Manual release assets upload\""},{"id":"blk-62952","kind":"paragraph","spans":[{"id":"spn-92709","text":"If release already exists, upload (or replace) asset:"}]},{"id":"blk-62953","kind":"code","language":"bash","text":"gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber"},{"id":"blk-62954","kind":"paragraph","spans":[{"id":"spn-92710","text":"Verify release + assets:"}]},{"id":"blk-62955","kind":"code","language":"bash","text":"gh release view \"${TAG}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-62956","items":[{"blocks":[{"id":"blk-62958","kind":"paragraph","spans":[{"id":"spn-92711","text":"Re-test npm install"}]}],"id":"blk-62957","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-62959","kind":"code","language":"bash","text":"npm i -g graphonomous\ngraphonomous --help"},{"id":"blk-62960","kind":"paragraph","spans":[{"id":"spn-92712","text":"If global install was partially broken earlier, clean and retry:"}]},{"id":"blk-62961","kind":"code","language":"bash","text":"npm uninstall -g graphonomous\nnpm cache verify\nnpm i -g graphonomous"},{"id":"blk-62962","items":[{"blocks":[{"id":"blk-62964","kind":"paragraph","spans":[{"id":"spn-92713","text":"Optional: Quick runtime smoke test"}]}],"id":"blk-62963","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-62965","kind":"code","language":"bash","text":"mkdir -p ~/.graphonomous\ngraphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-62966","kind":"paragraph","spans":[{"id":"spn-92714","text":"(Stop with "},{"id":"spn-92715","marks":["code"],"text":"Ctrl+C"},{"id":"spn-92716","text":" after startup confirmation.)"}]},{"id":"blk-62967","kind":"paragraph","spans":[{"id":"spn-92717","text":"If release creation still fails -------------------------------"}]},{"id":"blk-62968","kind":"heading","level":3,"spans":[{"id":"spn-92718","text":"A) "},{"id":"spn-92719","marks":["code"],"text":"gh release create ..."},{"id":"spn-92720","text":" says tag is missing"}]},{"id":"blk-62969","kind":"paragraph","spans":[{"id":"spn-92721","text":"Push the tag first:"}]},{"id":"blk-62970","kind":"code","language":"bash","text":"git push origin \"${TAG}\""},{"id":"blk-62971","kind":"heading","level":3,"spans":[{"id":"spn-92722","text":"B) Permission error on release create/upload"}]},{"id":"blk-62972","kind":"paragraph","spans":[{"id":"spn-92723","text":"Check GitHub auth/account:"}]},{"id":"blk-62973","kind":"code","language":"bash","text":"gh auth status\ngh repo view"},{"id":"blk-62974","kind":"paragraph","spans":[{"id":"spn-92724","text":"Ensure you have write access to "},{"id":"spn-92725","marks":["code"],"text":"c-u-l8er/graphonomous"},{"id":"spn-92726","text":"."}]},{"id":"blk-62975","kind":"heading","level":3,"spans":[{"id":"spn-92727","text":"C) npm still fails with 404"}]},{"id":"blk-62976","kind":"paragraph","spans":[{"id":"spn-92728","text":"Confirm asset naming exactly matches what installer expects:"}]},{"id":"blk-62977","kind":"code","language":"bash","text":"echo \"Expected: ${ASSET}\"\ngh release view \"${TAG}\" --json assets --jq '.assets[].name'"},{"id":"blk-62978","kind":"paragraph","spans":[{"id":"spn-92729","text":"Name must match exactly: "},{"id":"spn-92730","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]},{"id":"blk-62979","kind":"heading","level":3,"spans":[{"id":"spn-92731","text":"D) Zed shows \"context server request timeout\""}]},{"id":"blk-62980","kind":"paragraph","spans":[{"id":"spn-92732","text":"This can occur if your runtime is using older stdio transport behavior from upstream Anubis MCP (decoded message list handling / stdio response write issues)."}]},{"id":"blk-62981","kind":"paragraph","spans":[{"id":"spn-92733","text":"Graphonomous production path uses a vendored Anubis patch:"}]},{"id":"blk-62982","items":[{"blocks":[{"id":"blk-62984","kind":"paragraph","spans":[{"id":"spn-92734","text":"dependency is pinned to "},{"id":"spn-92735","marks":["code"],"text":"vendor/anubis_mcp"}]}],"id":"blk-62983","kind":"list-item"},{"blocks":[{"id":"blk-62986","kind":"paragraph","spans":[{"id":"spn-92736","text":"stdio transport fixes are in:"}]}],"id":"blk-62985","kind":"list-item"},{"blocks":[{"id":"blk-62988","kind":"paragraph","spans":[{"id":"spn-92737","marks":["code"],"text":"vendor/anubis_mcp/lib/anubis/server/transport/stdio.ex"}]}],"id":"blk-62987","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-62989","kind":"paragraph","spans":[{"id":"spn-92738","text":"Verify your runtime is actually using vendored dependency code (not stale compiled deps):"}]},{"id":"blk-62990","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/graphonomous\nmix deps.get\nmix clean\nrm -rf _build deps\nmix deps.get\nmix compile --warnings-as-errors\nmix test test/mcp_integration_test.exs"},{"id":"blk-62991","kind":"paragraph","spans":[{"id":"spn-92739","text":"If timeout persists in Zed:"}]},{"id":"blk-62992","items":[{"blocks":[{"id":"blk-62994","kind":"paragraph","spans":[{"id":"spn-92740","text":"Restart Zed completely."}]}],"id":"blk-62993","kind":"list-item"},{"blocks":[{"id":"blk-62996","kind":"paragraph","spans":[{"id":"spn-92741","text":"Confirm your MCP command points at the expected "},{"id":"spn-92742","marks":["code"],"text":"graphonomous"},{"id":"spn-92743","text":" binary/version."}]}],"id":"blk-62995","kind":"list-item"},{"blocks":[{"id":"blk-62998","kind":"paragraph","spans":[{"id":"spn-92744","text":"Run "},{"id":"spn-92745","marks":["code"],"text":"graphonomous --help"},{"id":"spn-92746","text":" in shell from the same environment as Zed launch."}]}],"id":"blk-62997","kind":"list-item"},{"blocks":[{"id":"blk-63000","kind":"paragraph","spans":[{"id":"spn-92747","text":"Re-check npm package version and release source:"}]}],"id":"blk-62999","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-63001","items":[{"blocks":[{"id":"blk-63003","kind":"paragraph","spans":[{"id":"spn-92748","marks":["code"],"text":"npm view graphonomous version"}]}],"id":"blk-63002","kind":"list-item"},{"blocks":[{"id":"blk-63005","kind":"paragraph","spans":[{"id":"spn-92749","marks":["code"],"text":"npm ls -g --depth=0 graphonomous"}]}],"id":"blk-63004","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63006","kind":"paragraph","spans":[{"id":"spn-92750","text":"Multi-platform publishing (later) ---------------------------------"}]},{"id":"blk-63007","kind":"paragraph","spans":[{"id":"spn-92751","text":"For broader support, repeat asset build/upload on each target machine:"}]},{"id":"blk-63008","items":[{"blocks":[{"id":"blk-63010","kind":"paragraph","spans":[{"id":"spn-92752","marks":["code"],"text":"linux-x64"}]}],"id":"blk-63009","kind":"list-item"},{"blocks":[{"id":"blk-63012","kind":"paragraph","spans":[{"id":"spn-92753","marks":["code"],"text":"linux-arm64"}]}],"id":"blk-63011","kind":"list-item"},{"blocks":[{"id":"blk-63014","kind":"paragraph","spans":[{"id":"spn-92754","marks":["code"],"text":"darwin-x64"}]}],"id":"blk-63013","kind":"list-item"},{"blocks":[{"id":"blk-63016","kind":"paragraph","spans":[{"id":"spn-92755","marks":["code"],"text":"darwin-arm64"}]}],"id":"blk-63015","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63017","kind":"paragraph","spans":[{"id":"spn-92756","text":"Asset names must follow:"}]},{"id":"blk-63018","items":[{"blocks":[{"id":"blk-63020","kind":"paragraph","spans":[{"id":"spn-92757","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-x64.tar.gz"}]}],"id":"blk-63019","kind":"list-item"},{"blocks":[{"id":"blk-63022","kind":"paragraph","spans":[{"id":"spn-92758","marks":["code"],"text":"graphonomous-vX.Y.Z-linux-arm64.tar.gz"}]}],"id":"blk-63021","kind":"list-item"},{"blocks":[{"id":"blk-63024","kind":"paragraph","spans":[{"id":"spn-92759","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-x64.tar.gz"}]}],"id":"blk-63023","kind":"list-item"},{"blocks":[{"id":"blk-63026","kind":"paragraph","spans":[{"id":"spn-92760","marks":["code"],"text":"graphonomous-vX.Y.Z-darwin-arm64.tar.gz"}]}],"id":"blk-63025","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-63027","kind":"paragraph","spans":[{"id":"spn-92761","text":"Minimal command checklist -------------------------"}]},{"id":"blk-63028","kind":"code","language":"bash","text":"# note: bump version here, in mix.exs, and npm/package.json too\n# then git push with version as commit name after running:\ncd /home/travis/ProjectAmp2/graphonomous\nVERSION=\"0.1.10\"; TAG=\"v${VERSION}\"; TARGET=\"linux-x64\"; ASSET=\"graphonomous-v${VERSION}-${TARGET}.tar.gz\"\nMIX_ENV=prod mix release --overwrite\nmkdir -p dist\ntar -czf \"dist/${ASSET}\" --exclude='*/priv/beam' -C _build/prod/rel graphonomous\ngit tag \"${TAG}\" 2>/dev/null || true\ngit push origin \"${TAG}\"\ngh release create \"${TAG}\" \"dist/${ASSET}\" --title \"${TAG}\" --notes \"Manual release assets upload\" || gh release upload \"${TAG}\" \"dist/${ASSET}\" --clobber\nnpm i -g graphonomous\ngraphonomous --help\ncd ./npm\nnpm publish"}],"edges":[],"id":"bagaaieral4cgwhbhpgz6mkprkjpor2rlpfxhkwpl7ltvoycrvag4rdhbtb7q","vocabulary":"ampersand.docs.fs.v1"}