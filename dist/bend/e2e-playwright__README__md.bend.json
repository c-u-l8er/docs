{"bendscript":"0.1","blocks":[{"id":"blk-61158","kind":"heading","level":1,"spans":[{"id":"spn-92736","text":"[&] Playwright Showcase"}]},{"id":"blk-61159","kind":"paragraph","spans":[{"id":"spn-92737","text":"Marketing-quality proof that every [&] Protocol product works through a real browser. Sibling to "},{"id":"spn-92738","marks":["code"],"text":"e2e-dashboard/"},{"id":"spn-92739","text":" (which is the internal diagnostic/QA artifact)."}]},{"id":"blk-61160","kind":"heading","level":2,"spans":[{"id":"spn-92740","text":"Usage"}]},{"id":"blk-61161","kind":"code","language":"bash","text":"cd /home/travis/ProjectAmp2/e2e-playwright\nnpm install                       # first time only\nnpx playwright install chromium   # first time only\n./run.sh                          # full run: boots SPA dev servers, tests all 4 tiers, generates showcase\n./run.sh --skip-spa               # skip SPA tier (no local Vite)\n./run.sh --only marketing-desktop # run one project"},{"id":"blk-61162","kind":"paragraph","spans":[{"id":"spn-92741","text":"Output:"}]},{"id":"blk-61163","items":[{"blocks":[{"id":"blk-61165","kind":"paragraph","spans":[{"id":"spn-92742","marks":["code"],"text":"out/<ISO-timestamp>/showcase.html"},{"id":"spn-92743","text":" — the investor-facing artifact. Self-contained (relative image/video refs), dark marketing polish. Hero stats + 4 tier sections with embedded videos."}]}],"id":"blk-61164","kind":"list-item"},{"blocks":[{"id":"blk-61167","kind":"paragraph","spans":[{"id":"spn-92744","marks":["code"],"text":"out/<ISO-timestamp>/results.json"},{"id":"spn-92745","text":" — structured card data for programmatic consumers."}]}],"id":"blk-61166","kind":"list-item"},{"blocks":[{"id":"blk-61169","kind":"paragraph","spans":[{"id":"spn-92746","marks":["code"],"text":"out/<ISO-timestamp>/media/<tier>/<card>/{video.webm,screenshot.png}"},{"id":"spn-92747","text":" — curated media per card."}]}],"id":"blk-61168","kind":"list-item"},{"blocks":[{"id":"blk-61171","kind":"p