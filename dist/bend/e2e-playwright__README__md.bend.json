2767","text":"BendScript + WebHost.Systems (4 tests)"}]}],[{"id":"blk-61191","spans":[{"id":"spn-92768","marks":["bold"],"text":"E · user-stories"}]},{"id":"blk-61192","spans":[{"id":"spn-92769","text":"End-to-end user journeys that transitively exercise dozens of unit tests per story. Includes the "},{"id":"spn-92770","marks":["bold"],"text":"dark-factory loop"},{"id":"spn-92771","text":" that spans all 6 MCP products in a single video."}]},{"id":"blk-61193","spans":[{"id":"spn-92772","text":"4 stories (fleetprompt discover · specprompt validate · graphonomous learn · dark-factory loop)"}]}]]},{"id":"blk-61194","kind":"paragraph","spans":[{"id":"spn-92773","marks":["bold"],"text":"Total:"},{"id":"spn-92774","text":" 46 tests, ~37 videos, ~40 screenshots per run."}]},{"id":"blk-61195","kind":"paragraph","spans":[{"id":"spn-92775","text":"Each user-story spec has a header comment listing which "},{"id":"spn-92776","marks":["code"],"text":"test/**"},{"id":"spn-92777","text":" unit tests it transitively covers — source of truth for coverage claims."}]},{"id":"blk-61196","kind":"heading","level":2,"spans":[{"id":"spn-92778","text":"Key technical choices"}]},{"id":"blk-61197","items":[{"blocks":[{"id":"blk-61199","kind":"paragraph","spans":[{"id":"spn-92779","marks":["bold"],"text":"MCP handshake runs Node-side via `page.request`"},{"id":"spn-92780","text":" — not browser "},{"id":"spn-92781","marks":["code"],"text":"fetch"},{"id":"spn-92782","text":". Verified: the Fly MCP servers set "},{"id":"spn-92783","marks":["code"],"text":"access-control-allow-origin: *"},{"id":"spn-92784","text":" but NOT "},{"id":"spn-92785","marks":["code"],"text":"access-control-expose-headers: mcp-session-id"},{"id":"spn-92786","text":", so browser JS can't read the session ID. See "},{"id":"spn-92787","marks":["code"],"text":"lib/mcp-handshake.ts"},{"id":"spn-92788","text":"."}]}],"id":"blk-61198","kind":"list-item"},{"blocks":[{"id":"blk-61201","kind":"paragraph","spans":[{"id":"spn-92789"