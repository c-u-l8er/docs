-67722","kind":"paragraph","spans":[{"id":"spn-129068","marks":["bold"],"text":"No `waitForLoadState('networkidle')`"},{"id":"spn-129069","text":" on Phoenix LiveView pages. LiveSocket never idles."}]}],"id":"blk-67721","kind":"list-item"},{"blocks":[{"id":"blk-67724","kind":"paragraph","spans":[{"id":"spn-129070","marks":["bold"],"text":"`page.evaluate` scroll loop"},{"id":"spn-129071","text":" for marketing lazy-load (not "},{"id":"spn-129072","marks":["code"],"text":"page.mouse.wheel"},{"id":"spn-129073","text":", which is flaky)."}]}],"id":"blk-67723","kind":"list-item"},{"blocks":[{"id":"blk-67726","kind":"paragraph","spans":[{"id":"spn-129074","marks":["bold"],"text":"iPhone 14 preset forced to chromium"},{"id":"spn-129075","text":" — the preset defaults to webkit; we only install chromium."}]}],"id":"blk-67725","kind":"list-item"},{"blocks":[{"id":"blk-67728","kind":"paragraph","spans":[{"id":"spn-129076","marks":["bold"],"text":"Single fixture server"},{"id":"spn-129077","text":" (port 7788) serves both the MCP inspector page and marketing sites, reducing the number of background processes."}]}],"id":"blk-67727","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67729","kind":"heading","level":2,"spans":[{"id":"spn-129078","text":"Fixtures"}]},{"id":"blk-67730","items":[{"blocks":[{"id":"blk-67732","kind":"paragraph","spans":[{"id":"spn-129079","marks":["code"],"text":"fixtures/inspector.html"},{"id":"spn-129080","text":" + "},{"id":"spn-129081","marks":["code"],"text":"fixtures/inspector.js"},{"id":"spn-129082","text":" — rendering-only MCP inspector page. The test injects the already-resolved handshake data; the fixture doesn't make any network calls. This is the proof-by-screenshot that investors see."}]}],"id":"blk-67731","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67733","kind":"heading","level":2,"spans":[{"id":"spn-129083","text":"Environment"}]},{"id":"blk-67734","items":[{"blocks":[{"id":"blk-67736","kind":"paragraph",