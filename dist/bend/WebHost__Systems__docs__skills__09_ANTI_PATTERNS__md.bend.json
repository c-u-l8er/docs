{"bendscript":"0.1","blocks":[{"id":"blk-25919","kind":"heading","level":1,"spans":[{"id":"spn-31240","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-25921","kind":"paragraph","spans":[{"id":"spn-31241","marks":["bold"],"text":"Purpose:"},{"id":"spn-31242","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-25920","kind":"quote"},{"id":"blk-25922","kind":"paragraph","spans":[{"id":"spn-31243","text":"---"}]},{"id":"blk-25923","kind":"heading","level":2,"spans":[{"id":"spn-31244","text":"1. Skipping RLS Policies"}]},{"id":"blk-25924","kind":"paragraph","spans":[{"id":"spn-31245","marks":["bold"],"text":"Mistake:"},{"id":"spn-31246","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-31247","marks":["code"],"text":"service_role"},{"id":"spn-31248","text":" key in client-side code."}]},{"id":"blk-25925","kind":"paragraph","spans":[{"id":"spn-31249","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31250","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-25926","kind":"paragraph","spans":[{"id":"spn-31251","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25927","items":[{"blocks":[{"id":"blk-25929","kind":"paragraph","spans":[{"id":"spn-31252","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-25928","kind":"list-item"},{"blocks":[{"id":"blk-25931","kind":"paragraph","spans":[{"id":"spn-31253","text":"Use "},{"id":"spn-31254","marks":["code"],"text":"anon"},{"id":"spn-31255","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-31256","marks":["code"],"text":"service_role"},{"id":"spn-31257","text":" for"}]}],"id":"blk-25930","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25932","kind":"paragraph","spans":[{"id":"spn-31258","text":"Edge Functions only."}]},{"id":"blk-25933","items":[{"blocks":[{"id":"blk-25935","kind":"paragraph","spans":[{"id":"spn-31259","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-25934","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25936","kind":"paragraph","spans":[{"id":"spn-31260","text":"---"}]},{"id":"blk-25937","kind":"heading","level":2,"spans":[{"id":"spn-31261","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-25938","kind":"paragraph","spans":[{"id":"spn-31262","marks":["bold"],"text":"Mistake:"},{"id":"spn-31263","text":" Putting API keys or credentials directly in "},{"id":"spn-31264","marks":["code"],"text":"agents.provider_config"},{"id":"spn-31265","text":" or "},{"id":"spn-31266","marks":["code"],"text":"deployments.artifact"},{"id":"spn-31267","text":"."}]},{"id":"blk-25939","kind":"paragraph","spans":[{"id":"spn-31268","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31269","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-25940","kind":"paragraph","spans":[{"id":"spn-31270","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25941","items":[{"blocks":[{"id":"blk-25943","kind":"paragraph","spans":[{"id":"spn-31271","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-25942","kind":"list-item"},{"blocks":[{"id":"blk-25945","kind":"paragraph","spans":[{"id":"spn-31272","text":"Store only key names (not values) in "},{"id":"spn-31273","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-31274","text":"."}]}],"id":"blk-25944","kind":"list-item"},{"blocks":[{"id":"blk-25947","kind":"paragraph","spans":[{"id":"spn-31275","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-25946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25948","kind":"paragraph","spans":[{"id":"spn-31276","text":"Manager) at deploy time."}]},{"id":"blk-25949","kind":"paragraph","spans":[{"id":"spn-31277","text":"---"}]},{"id":"blk-25950","kind":"heading","level":2,"spans":[{"id":"spn-31278","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-25951","kind":"paragraph","spans":[{"id":"spn-31279","marks":["bold"],"text":"Mistake:"},{"id":"spn-31280","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-25952","kind":"paragraph","spans":[{"id":"spn-31281","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31282","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-25953","kind":"paragraph","spans":[{"id":"spn-31283","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25954","items":[{"blocks":[{"id":"blk-25956","kind":"paragraph","spans":[{"id":"spn-31284","text":"Deployments are append-only. Only "},{"id":"spn-31285","marks":["code"],"text":"status"},{"id":"spn-31286","text":" and "},{"id":"spn-31287","marks":["code"],"text":"error_message"},{"id":"spn-31288","text":" can be updated."}]}],"id":"blk-25955","kind":"list-item"},{"blocks":[{"id":"blk-25958","kind":"paragraph","spans":[{"id":"spn-31289","text":"To change code or config, create a new deployment."}]}],"id":"blk-25957","kind":"list-item"},{"blocks":[{"id":"blk-25960","kind":"paragraph","spans":[{"id":"spn-31290","text":"Rollback by switching "},{"id":"spn-31291","marks":["code"],"text":"active_deployment_id"},{"id":"spn-31292","text":", not by modifying old records."}]}],"id":"blk-25959","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25961","kind":"paragraph","spans":[{"id":"spn-31293","text":"---"}]},{"id":"blk-25962","kind":"heading","level":2,"spans":[{"id":"spn-31294","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-25963","kind":"paragraph","spans":[{"id":"spn-31295","marks":["bold"],"text":"Mistake:"},{"id":"spn-31296","text":" Not checking for an existing "},{"id":"spn-31297","marks":["code"],"text":"deploying"},{"id":"spn-31298","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-25964","kind":"paragraph","spans":[{"id":"spn-31299","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31300","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-25965","kind":"paragraph","spans":[{"id":"spn-31301","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25966","items":[{"blocks":[{"id":"blk-25968","kind":"paragraph","spans":[{"id":"spn-31302","text":"Check for "},{"id":"spn-31303","marks":["code"],"text":"deploying"},{"id":"spn-31304","text":" status on the agent before creating a new deployment."}]}],"id":"blk-25967","kind":"list-item"},{"blocks":[{"id":"blk-25970","kind":"paragraph","spans":[{"id":"spn-31305","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-25969","kind":"list-item"},{"blocks":[{"id":"blk-25972","kind":"paragraph","spans":[{"id":"spn-31306","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-25971","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25973","kind":"paragraph","spans":[{"id":"spn-31307","text":"---"}]},{"id":"blk-25974","kind":"heading","level":2,"spans":[{"id":"spn-31308","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-25975","kind":"paragraph","spans":[{"id":"spn-31309","marks":["bold"],"text":"Mistake:"},{"id":"spn-31310","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-25976","kind":"paragraph","spans":[{"id":"spn-31311","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31312","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-25977","kind":"paragraph","spans":[{"id":"spn-31313","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25978","items":[{"blocks":[{"id":"blk-25980","kind":"paragraph","spans":[{"id":"spn-31314","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-25979","kind":"list-item"},{"blocks":[{"id":"blk-25982","kind":"paragraph","spans":[{"id":"spn-31315","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-25981","kind":"list-item"},{"blocks":[{"id":"blk-25984","kind":"paragraph","spans":[{"id":"spn-31316","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-25983","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25985","kind":"paragraph","spans":[{"id":"spn-31317","text":"---"}]},{"id":"blk-25986","kind":"heading","level":2,"spans":[{"id":"spn-31318","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-25987","kind":"paragraph","spans":[{"id":"spn-31319","marks":["bold"],"text":"Mistake:"},{"id":"spn-31320","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-25988","kind":"paragraph","spans":[{"id":"spn-31321","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31322","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-25989","kind":"paragraph","spans":[{"id":"spn-31323","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25990","items":[{"blocks":[{"id":"blk-25992","kind":"paragraph","spans":[{"id":"spn-31324","text":"Normalize all errors to the standard code set (see "},{"id":"spn-31325","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-31326","text":")."}]}],"id":"blk-25991","kind":"list-item"},{"blocks":[{"id":"blk-25994","kind":"paragraph","spans":[{"id":"spn-31327","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-25993","kind":"list-item"},{"blocks":[{"id":"blk-25996","kind":"paragraph","spans":[{"id":"spn-31328","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-25995","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25997","kind":"paragraph","spans":[{"id":"spn-31329","text":"---"}]},{"id":"blk-25998","kind":"heading","level":2,"spans":[{"id":"spn-31330","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-25999","kind":"paragraph","spans":[{"id":"spn-31331","marks":["bold"],"text":"Mistake:"},{"id":"spn-31332","text":" Accepting "},{"id":"spn-31333","marks":["code"],"text":"user_id"},{"id":"spn-31334","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-26000","kind":"paragraph","spans":[{"id":"spn-31335","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31336","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-26001","kind":"paragraph","spans":[{"id":"spn-31337","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-26002","items":[{"blocks":[{"id":"blk-26004","kind":"paragraph","spans":[{"id":"spn-31338","text":"Always derive "},{"id":"spn-31339","marks":["code"],"text":"user_id"},{"id":"spn-31340","text":" from "},{"id":"spn-31341","marks":["code"],"text":"auth.uid()"},{"id":"spn-31342","text":" (Supabase Auth JWT)."}]}],"id":"blk-26003","kind":"list-item"},{"blocks":[{"id":"blk-26006","kind":"paragraph","spans":[{"id":"spn-31343","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-26005","kind":"list-item"},{"blocks":[{"id":"blk-26008","kind":"paragraph","spans":[{"id":"spn-31344","text":"RLS policies enforce this at the database level."}]}],"id":"blk-26007","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26009","kind":"paragraph","spans":[{"id":"spn-31345","text":"---"}]},{"id":"blk-26010","kind":"heading","level":2,"spans":[{"id":"spn-31346","text":"8. Skipping Bundle Validation"}]},{"id":"blk-26011","kind":"paragraph","spans":[{"id":"spn-31347","marks":["bold"],"text":"Mistake:"},{"id":"spn-31348","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-26012","kind":"paragraph","spans":[{"id":"spn-31349","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31350","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-26013","kind":"paragraph","spans":[{"id":"spn-31351","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-26014","items":[{"blocks":[{"id":"blk-26016","kind":"paragraph","spans":[{"id":"spn-31352","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-26015","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26017","kind":"paragraph","spans":[{"id":"spn-31353","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-31354","text":"."}]},{"id":"blk-26018","items":[{"blocks":[{"id":"blk-26020","kind":"paragraph","spans":[{"id":"spn-31355","text":"Reject bundles with "},{"id":"spn-31356","marks":["code"],"text":"../"},{"id":"spn-31357","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-26019","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26021","kind":"paragraph","spans":[{"id":"spn-31358","marks":["code"],"text":"agent.config.json"},{"id":"spn-31359","text":"."}]},{"id":"blk-26022","items":[{"blocks":[{"id":"blk-26024","kind":"paragraph","spans":[{"id":"spn-31360","text":"Enforce size and file count limits."}]}],"id":"blk-26023","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26025","kind":"paragraph","spans":[{"id":"spn-31361","text":"---"}]},{"id":"blk-26026","kind":"heading","level":2,"spans":[{"id":"spn-31362","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-26027","kind":"paragraph","spans":[{"id":"spn-31363","marks":["bold"],"text":"Mistake:"},{"id":"spn-31364","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-26028","kind":"paragraph","spans":[{"id":"spn-31365","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31366","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-26029","kind":"paragraph","spans":[{"id":"spn-31367","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-26030","items":[{"blocks":[{"id":"blk-26032","kind":"paragraph","spans":[{"id":"spn-31368","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-26031","kind":"list-item"},{"blocks":[{"id":"blk-26034","kind":"paragraph","spans":[{"id":"spn-31369","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-26033","kind":"list-item"},{"blocks":[{"id":"blk-26036","kind":"paragraph","spans":[{"id":"spn-31370","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-26035","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26037","kind":"paragraph","spans":[{"id":"spn-31371","text":"---"}]},{"id":"blk-26038","kind":"heading","level":2,"spans":[{"id":"spn-31372","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-26039","kind":"paragraph","spans":[{"id":"spn-31373","marks":["bold"],"text":"Mistake:"},{"id":"spn-31374","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-26040","kind":"paragraph","spans":[{"id":"spn-31375","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31376","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-26041","kind":"paragraph","spans":[{"id":"spn-31377","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-26042","items":[{"blocks":[{"id":"blk-26044","kind":"paragraph","spans":[{"id":"spn-31378","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-26043","kind":"list-item"},{"blocks":[{"id":"blk-26046","kind":"paragraph","spans":[{"id":"spn-31379","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-26045","kind":"list-item"},{"blocks":[{"id":"blk-26048","kind":"paragraph","spans":[{"id":"spn-31380","text":"Test telemetry emission in integration tests."}]}],"id":"blk-26047","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26049","kind":"paragraph","spans":[{"id":"spn-31381","text":"---"}]},{"id":"blk-26050","kind":"heading","level":2,"spans":[{"id":"spn-31382","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-26051","kind":"paragraph","spans":[{"id":"spn-31383","marks":["bold"],"text":"Mistake:"},{"id":"spn-31384","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-26052","kind":"paragraph","spans":[{"id":"spn-31385","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31386","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-26053","kind":"paragraph","spans":[{"id":"spn-31387","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-26054","items":[{"blocks":[{"id":"blk-26056","kind":"paragraph","spans":[{"id":"spn-31388","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-26055","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26057","kind":"paragraph","spans":[{"id":"spn-31389","text":"ingestion, billing webhooks."}]},{"id":"blk-26058","items":[{"blocks":[{"id":"blk-26060","kind":"paragraph","spans":[{"id":"spn-31390","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-26059","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26061","kind":"paragraph","spans":[{"id":"spn-31391","text":"---"}]},{"id":"blk-26062","kind":"heading","level":2,"spans":[{"id":"spn-31392","text":"12. Circular A2A Delegation"}]},{"id":"blk-26063","kind":"paragraph","spans":[{"id":"spn-31393","marks":["bold"],"text":"Mistake:"},{"id":"spn-31394","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-26064","kind":"paragraph","spans":[{"id":"spn-31395","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-31396","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-26065","kind":"paragraph","spans":[{"id":"spn-31397","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-26066","items":[{"blocks":[{"id":"blk-26068","kind":"paragraph","spans":[{"id":"spn-31398","text":"Track "},{"id":"spn-31399","marks":["code"],"text":"delegation_depth"},{"id":"spn-31400","text":" in every A2A invocation."}]}],"id":"blk-26067","kind":"list-item"},{"blocks":[{"id":"blk-26070","kind":"paragraph","spans":[{"id":"spn-31401","text":"Enforce "},{"id":"spn-31402","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-31403","text":" from the governance policy."}]}],"id":"blk-26069","kind":"list-item"},{"blocks":[{"id":"blk-26072","kind":"paragraph","spans":[{"id":"spn-31404","text":"Detect and reject circular call chains."}]}],"id":"blk-26071","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-26073","kind":"paragraph","spans":[{"id":"spn-31405","text":"---"}]},{"id":"blk-26074","kind":"heading","level":2,"spans":[{"id":"spn-31406","text":"Summary Table"}]},{"head":[{"id":"blk-26076","spans":[{"id":"spn-31407","text":"#"}]},{"id":"blk-26077","spans":[{"id":"spn-31408","text":"Anti-Pattern"}]},{"id":"blk-26078","spans":[{"id":"spn-31409","text":"Severity"}]},{"id":"blk-26079","spans":[{"id":"spn-31410","text":"Fix Reference"}]}],"id":"blk-26075","kind":"table","rows":[[{"id":"blk-26080","spans":[{"id":"spn-31411","text":"1"}]},{"id":"blk-26081","spans":[{"id":"spn-31412","text":"Skipping RLS"}]},{"id":"blk-26082","spans":[{"id":"spn-31413","text":"Critical"}]},{"id":"blk-26083","spans":[{"id":"spn-31414","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-26084","spans":[{"id":"spn-31415","text":"2"}]},{"id":"blk-26085","spans":[{"id":"spn-31416","text":"Plaintext secrets"}]},{"id":"blk-26086","spans":[{"id":"spn-31417","text":"Critical"}]},{"id":"blk-26087","spans":[{"id":"spn-31418","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-26088","spans":[{"id":"spn-31419","text":"3"}]},{"id":"blk-26089","spans":[{"id":"spn-31420","text":"Mutable deployments"}]},{"id":"blk-26090","spans":[{"id":"spn-31421","text":"High"}]},{"id":"blk-26091","spans":[{"id":"spn-31422","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-26092","spans":[{"id":"spn-31423","text":"4"}]},{"id":"blk-26093","spans":[{"id":"spn-31424","text":"Concurrent deploys"}]},{"id":"blk-26094","spans":[{"id":"spn-31425","text":"High"}]},{"id":"blk-26095","spans":[{"id":"spn-31426","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-26096","spans":[{"id":"spn-31427","text":"5"}]},{"id":"blk-26097","spans":[{"id":"spn-31428","text":"Unauthenticated telemetry"}]},{"id":"blk-26098","spans":[{"id":"spn-31429","text":"High"}]},{"id":"blk-26099","spans":[{"id":"spn-31430","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-26100","spans":[{"id":"spn-31431","text":"6"}]},{"id":"blk-26101","spans":[{"id":"spn-31432","text":"Secret leaks in errors"}]},{"id":"blk-26102","spans":[{"id":"spn-31433","text":"High"}]},{"id":"blk-26103","spans":[{"id":"spn-31434","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-26104","spans":[{"id":"spn-31435","text":"7"}]},{"id":"blk-26105","spans":[{"id":"spn-31436","text":"Client-provided user IDs"}]},{"id":"blk-26106","spans":[{"id":"spn-31437","text":"Critical"}]},{"id":"blk-26107","spans":[{"id":"spn-31438","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-26108","spans":[{"id":"spn-31439","text":"8"}]},{"id":"blk-26109","spans":[{"id":"spn-31440","text":"Skipping bundle validation"}]},{"id":"blk-26110","spans":[{"id":"spn-31441","text":"High"}]},{"id":"blk-26111","spans":[{"id":"spn-31442","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-26112","spans":[{"id":"spn-31443","text":"9"}]},{"id":"blk-26113","spans":[{"id":"spn-31444","text":"Hard-coded tier limits"}]},{"id":"blk-26114","spans":[{"id":"spn-31445","text":"Medium"}]},{"id":"blk-26115","spans":[{"id":"spn-31446","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-26116","spans":[{"id":"spn-31447","text":"10"}]},{"id":"blk-26117","spans":[{"id":"spn-31448","text":"Missing telemetry"}]},{"id":"blk-26118","spans":[{"id":"spn-31449","text":"High"}]},{"id":"blk-26119","spans":[{"id":"spn-31450","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-26120","spans":[{"id":"spn-31451","text":"11"}]},{"id":"blk-26121","spans":[{"id":"spn-31452","text":"Edge Functions as hosting"}]},{"id":"blk-26122","spans":[{"id":"spn-31453","text":"High"}]},{"id":"blk-26123","spans":[{"id":"spn-31454","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-26124","spans":[{"id":"spn-31455","text":"12"}]},{"id":"blk-26125","spans":[{"id":"spn-31456","text":"Circular A2A delegation"}]},{"id":"blk-26126","spans":[{"id":"spn-31457","text":"High"}]},{"id":"blk-26127","spans":[{"id":"spn-31458","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaieraep2dbnbeyrv3pl5uspib7345gqaejaya6rcmngczmqapkjvtz2tq","vocabulary":"ampersand.docs.fs.v1"}