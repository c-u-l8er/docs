{"bendscript":"0.1","blocks":[{"id":"blk-43939","kind":"heading","level":1,"spans":[{"id":"spn-71726","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-43941","kind":"paragraph","spans":[{"id":"spn-71727","marks":["bold"],"text":"Purpose:"},{"id":"spn-71728","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-43940","kind":"quote"},{"id":"blk-43942","kind":"heading","level":2,"spans":[{"id":"spn-71729","text":"1. Skipping RLS Policies"}]},{"id":"blk-43943","kind":"paragraph","spans":[{"id":"spn-71730","marks":["bold"],"text":"Mistake:"},{"id":"spn-71731","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-71732","marks":["code"],"text":"service_role"},{"id":"spn-71733","text":" key in client-side code."}]},{"id":"blk-43944","kind":"paragraph","spans":[{"id":"spn-71734","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71735","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-43945","kind":"paragraph","spans":[{"id":"spn-71736","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-43946","items":[{"blocks":[{"id":"blk-43948","kind":"paragraph","spans":[{"id":"spn-71737","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-43947","kind":"list-item"},{"blocks":[{"id":"blk-43950","kind":"paragraph","spans":[{"id":"spn-71738","text":"Use "},{"id":"spn-71739","marks":["code"],"text":"anon"},{"id":"spn-71740","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-71741","marks":["code"],"text":"service_role"},{"id":"spn-71742","text":" for"}]}],"id":"blk-43949","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43951","kind":"paragraph","spans":[{"id":"spn-71743","text":"Edge Functions only."}]},{"id":"blk-43952","items":[{"blocks":[{"id":"blk-43954","kind":"paragraph","spans":[{"id":"spn-71744","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-43953","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43955","kind":"heading","level":2,"spans":[{"id":"spn-71745","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-43956","kind":"paragraph","spans":[{"id":"spn-71746","marks":["bold"],"text":"Mistake:"},{"id":"spn-71747","text":" Putting API keys or credentials directly in "},{"id":"spn-71748","marks":["code"],"text":"agents.provider_config"},{"id":"spn-71749","text":" or "},{"id":"spn-71750","marks":["code"],"text":"deployments.artifact"},{"id":"spn-71751","text":"."}]},{"id":"blk-43957","kind":"paragraph","spans":[{"id":"spn-71752","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71753","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-43958","kind":"paragraph","spans":[{"id":"spn-71754","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-43959","items":[{"blocks":[{"id":"blk-43961","kind":"paragraph","spans":[{"id":"spn-71755","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-43960","kind":"list-item"},{"blocks":[{"id":"blk-43963","kind":"paragraph","spans":[{"id":"spn-71756","text":"Store only key names (not values) in "},{"id":"spn-71757","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-71758","text":"."}]}],"id":"blk-43962","kind":"list-item"},{"blocks":[{"id":"blk-43965","kind":"paragraph","spans":[{"id":"spn-71759","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-43964","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43966","kind":"paragraph","spans":[{"id":"spn-71760","text":"Manager) at deploy time."}]},{"id":"blk-43967","kind":"heading","level":2,"spans":[{"id":"spn-71761","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-43968","kind":"paragraph","spans":[{"id":"spn-71762","marks":["bold"],"text":"Mistake:"},{"id":"spn-71763","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-43969","kind":"paragraph","spans":[{"id":"spn-71764","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71765","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-43970","kind":"paragraph","spans":[{"id":"spn-71766","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-43971","items":[{"blocks":[{"id":"blk-43973","kind":"paragraph","spans":[{"id":"spn-71767","text":"Deployments are append-only. Only "},{"id":"spn-71768","marks":["code"],"text":"status"},{"id":"spn-71769","text":" and "},{"id":"spn-71770","marks":["code"],"text":"error_message"},{"id":"spn-71771","text":" can be updated."}]}],"id":"blk-43972","kind":"list-item"},{"blocks":[{"id":"blk-43975","kind":"paragraph","spans":[{"id":"spn-71772","text":"To change code or config, create a new deployment."}]}],"id":"blk-43974","kind":"list-item"},{"blocks":[{"id":"blk-43977","kind":"paragraph","spans":[{"id":"spn-71773","text":"Rollback by switching "},{"id":"spn-71774","marks":["code"],"text":"active_deployment_id"},{"id":"spn-71775","text":", not by modifying old records."}]}],"id":"blk-43976","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43978","kind":"heading","level":2,"spans":[{"id":"spn-71776","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-43979","kind":"paragraph","spans":[{"id":"spn-71777","marks":["bold"],"text":"Mistake:"},{"id":"spn-71778","text":" Not checking for an existing "},{"id":"spn-71779","marks":["code"],"text":"deploying"},{"id":"spn-71780","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-43980","kind":"paragraph","spans":[{"id":"spn-71781","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71782","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-43981","kind":"paragraph","spans":[{"id":"spn-71783","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-43982","items":[{"blocks":[{"id":"blk-43984","kind":"paragraph","spans":[{"id":"spn-71784","text":"Check for "},{"id":"spn-71785","marks":["code"],"text":"deploying"},{"id":"spn-71786","text":" status on the agent before creating a new deployment."}]}],"id":"blk-43983","kind":"list-item"},{"blocks":[{"id":"blk-43986","kind":"paragraph","spans":[{"id":"spn-71787","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-43985","kind":"list-item"},{"blocks":[{"id":"blk-43988","kind":"paragraph","spans":[{"id":"spn-71788","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-43987","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43989","kind":"heading","level":2,"spans":[{"id":"spn-71789","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-43990","kind":"paragraph","spans":[{"id":"spn-71790","marks":["bold"],"text":"Mistake:"},{"id":"spn-71791","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-43991","kind":"paragraph","spans":[{"id":"spn-71792","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71793","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-43992","kind":"paragraph","spans":[{"id":"spn-71794","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-43993","items":[{"blocks":[{"id":"blk-43995","kind":"paragraph","spans":[{"id":"spn-71795","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-43994","kind":"list-item"},{"blocks":[{"id":"blk-43997","kind":"paragraph","spans":[{"id":"spn-71796","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-43996","kind":"list-item"},{"blocks":[{"id":"blk-43999","kind":"paragraph","spans":[{"id":"spn-71797","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-43998","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44000","kind":"heading","level":2,"spans":[{"id":"spn-71798","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-44001","kind":"paragraph","spans":[{"id":"spn-71799","marks":["bold"],"text":"Mistake:"},{"id":"spn-71800","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-44002","kind":"paragraph","spans":[{"id":"spn-71801","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71802","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-44003","kind":"paragraph","spans":[{"id":"spn-71803","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44004","items":[{"blocks":[{"id":"blk-44006","kind":"paragraph","spans":[{"id":"spn-71804","text":"Normalize all errors to the standard code set (see "},{"id":"spn-71805","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-71806","text":")."}]}],"id":"blk-44005","kind":"list-item"},{"blocks":[{"id":"blk-44008","kind":"paragraph","spans":[{"id":"spn-71807","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-44007","kind":"list-item"},{"blocks":[{"id":"blk-44010","kind":"paragraph","spans":[{"id":"spn-71808","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-44009","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44011","kind":"heading","level":2,"spans":[{"id":"spn-71809","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-44012","kind":"paragraph","spans":[{"id":"spn-71810","marks":["bold"],"text":"Mistake:"},{"id":"spn-71811","text":" Accepting "},{"id":"spn-71812","marks":["code"],"text":"user_id"},{"id":"spn-71813","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-44013","kind":"paragraph","spans":[{"id":"spn-71814","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71815","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-44014","kind":"paragraph","spans":[{"id":"spn-71816","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44015","items":[{"blocks":[{"id":"blk-44017","kind":"paragraph","spans":[{"id":"spn-71817","text":"Always derive "},{"id":"spn-71818","marks":["code"],"text":"user_id"},{"id":"spn-71819","text":" from "},{"id":"spn-71820","marks":["code"],"text":"auth.uid()"},{"id":"spn-71821","text":" (Supabase Auth JWT)."}]}],"id":"blk-44016","kind":"list-item"},{"blocks":[{"id":"blk-44019","kind":"paragraph","spans":[{"id":"spn-71822","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-44018","kind":"list-item"},{"blocks":[{"id":"blk-44021","kind":"paragraph","spans":[{"id":"spn-71823","text":"RLS policies enforce this at the database level."}]}],"id":"blk-44020","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44022","kind":"heading","level":2,"spans":[{"id":"spn-71824","text":"8. Skipping Bundle Validation"}]},{"id":"blk-44023","kind":"paragraph","spans":[{"id":"spn-71825","marks":["bold"],"text":"Mistake:"},{"id":"spn-71826","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-44024","kind":"paragraph","spans":[{"id":"spn-71827","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71828","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-44025","kind":"paragraph","spans":[{"id":"spn-71829","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44026","items":[{"blocks":[{"id":"blk-44028","kind":"paragraph","spans":[{"id":"spn-71830","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-44027","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44029","kind":"paragraph","spans":[{"id":"spn-71831","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-71832","text":"."}]},{"id":"blk-44030","items":[{"blocks":[{"id":"blk-44032","kind":"paragraph","spans":[{"id":"spn-71833","text":"Reject bundles with "},{"id":"spn-71834","marks":["code"],"text":"../"},{"id":"spn-71835","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-44031","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44033","kind":"paragraph","spans":[{"id":"spn-71836","marks":["code"],"text":"agent.config.json"},{"id":"spn-71837","text":"."}]},{"id":"blk-44034","items":[{"blocks":[{"id":"blk-44036","kind":"paragraph","spans":[{"id":"spn-71838","text":"Enforce size and file count limits."}]}],"id":"blk-44035","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44037","kind":"heading","level":2,"spans":[{"id":"spn-71839","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-44038","kind":"paragraph","spans":[{"id":"spn-71840","marks":["bold"],"text":"Mistake:"},{"id":"spn-71841","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-44039","kind":"paragraph","spans":[{"id":"spn-71842","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71843","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-44040","kind":"paragraph","spans":[{"id":"spn-71844","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44041","items":[{"blocks":[{"id":"blk-44043","kind":"paragraph","spans":[{"id":"spn-71845","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-44042","kind":"list-item"},{"blocks":[{"id":"blk-44045","kind":"paragraph","spans":[{"id":"spn-71846","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-44044","kind":"list-item"},{"blocks":[{"id":"blk-44047","kind":"paragraph","spans":[{"id":"spn-71847","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-44046","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44048","kind":"heading","level":2,"spans":[{"id":"spn-71848","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-44049","kind":"paragraph","spans":[{"id":"spn-71849","marks":["bold"],"text":"Mistake:"},{"id":"spn-71850","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-44050","kind":"paragraph","spans":[{"id":"spn-71851","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71852","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-44051","kind":"paragraph","spans":[{"id":"spn-71853","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44052","items":[{"blocks":[{"id":"blk-44054","kind":"paragraph","spans":[{"id":"spn-71854","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-44053","kind":"list-item"},{"blocks":[{"id":"blk-44056","kind":"paragraph","spans":[{"id":"spn-71855","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-44055","kind":"list-item"},{"blocks":[{"id":"blk-44058","kind":"paragraph","spans":[{"id":"spn-71856","text":"Test telemetry emission in integration tests."}]}],"id":"blk-44057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44059","kind":"heading","level":2,"spans":[{"id":"spn-71857","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-44060","kind":"paragraph","spans":[{"id":"spn-71858","marks":["bold"],"text":"Mistake:"},{"id":"spn-71859","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-44061","kind":"paragraph","spans":[{"id":"spn-71860","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71861","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-44062","kind":"paragraph","spans":[{"id":"spn-71862","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44063","items":[{"blocks":[{"id":"blk-44065","kind":"paragraph","spans":[{"id":"spn-71863","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-44064","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44066","kind":"paragraph","spans":[{"id":"spn-71864","text":"ingestion, billing webhooks."}]},{"id":"blk-44067","items":[{"blocks":[{"id":"blk-44069","kind":"paragraph","spans":[{"id":"spn-71865","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-44068","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44070","kind":"heading","level":2,"spans":[{"id":"spn-71866","text":"12. Circular A2A Delegation"}]},{"id":"blk-44071","kind":"paragraph","spans":[{"id":"spn-71867","marks":["bold"],"text":"Mistake:"},{"id":"spn-71868","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-44072","kind":"paragraph","spans":[{"id":"spn-71869","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-71870","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-44073","kind":"paragraph","spans":[{"id":"spn-71871","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44074","items":[{"blocks":[{"id":"blk-44076","kind":"paragraph","spans":[{"id":"spn-71872","text":"Track "},{"id":"spn-71873","marks":["code"],"text":"delegation_depth"},{"id":"spn-71874","text":" in every A2A invocation."}]}],"id":"blk-44075","kind":"list-item"},{"blocks":[{"id":"blk-44078","kind":"paragraph","spans":[{"id":"spn-71875","text":"Enforce "},{"id":"spn-71876","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-71877","text":" from the governance policy."}]}],"id":"blk-44077","kind":"list-item"},{"blocks":[{"id":"blk-44080","kind":"paragraph","spans":[{"id":"spn-71878","text":"Detect and reject circular call chains."}]}],"id":"blk-44079","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44081","kind":"heading","level":2,"spans":[{"id":"spn-71879","text":"Summary Table"}]},{"head":[{"id":"blk-44083","spans":[{"id":"spn-71880","text":"#"}]},{"id":"blk-44084","spans":[{"id":"spn-71881","text":"Anti-Pattern"}]},{"id":"blk-44085","spans":[{"id":"spn-71882","text":"Severity"}]},{"id":"blk-44086","spans":[{"id":"spn-71883","text":"Fix Reference"}]}],"id":"blk-44082","kind":"table","rows":[[{"id":"blk-44087","spans":[{"id":"spn-71884","text":"1"}]},{"id":"blk-44088","spans":[{"id":"spn-71885","text":"Skipping RLS"}]},{"id":"blk-44089","spans":[{"id":"spn-71886","text":"Critical"}]},{"id":"blk-44090","spans":[{"id":"spn-71887","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-44091","spans":[{"id":"spn-71888","text":"2"}]},{"id":"blk-44092","spans":[{"id":"spn-71889","text":"Plaintext secrets"}]},{"id":"blk-44093","spans":[{"id":"spn-71890","text":"Critical"}]},{"id":"blk-44094","spans":[{"id":"spn-71891","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-44095","spans":[{"id":"spn-71892","text":"3"}]},{"id":"blk-44096","spans":[{"id":"spn-71893","text":"Mutable deployments"}]},{"id":"blk-44097","spans":[{"id":"spn-71894","text":"High"}]},{"id":"blk-44098","spans":[{"id":"spn-71895","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-44099","spans":[{"id":"spn-71896","text":"4"}]},{"id":"blk-44100","spans":[{"id":"spn-71897","text":"Concurrent deploys"}]},{"id":"blk-44101","spans":[{"id":"spn-71898","text":"High"}]},{"id":"blk-44102","spans":[{"id":"spn-71899","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-44103","spans":[{"id":"spn-71900","text":"5"}]},{"id":"blk-44104","spans":[{"id":"spn-71901","text":"Unauthenticated telemetry"}]},{"id":"blk-44105","spans":[{"id":"spn-71902","text":"High"}]},{"id":"blk-44106","spans":[{"id":"spn-71903","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-44107","spans":[{"id":"spn-71904","text":"6"}]},{"id":"blk-44108","spans":[{"id":"spn-71905","text":"Secret leaks in errors"}]},{"id":"blk-44109","spans":[{"id":"spn-71906","text":"High"}]},{"id":"blk-44110","spans":[{"id":"spn-71907","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-44111","spans":[{"id":"spn-71908","text":"7"}]},{"id":"blk-44112","spans":[{"id":"spn-71909","text":"Client-provided user IDs"}]},{"id":"blk-44113","spans":[{"id":"spn-71910","text":"Critical"}]},{"id":"blk-44114","spans":[{"id":"spn-71911","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-44115","spans":[{"id":"spn-71912","text":"8"}]},{"id":"blk-44116","spans":[{"id":"spn-71913","text":"Skipping bundle validation"}]},{"id":"blk-44117","spans":[{"id":"spn-71914","text":"High"}]},{"id":"blk-44118","spans":[{"id":"spn-71915","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-44119","spans":[{"id":"spn-71916","text":"9"}]},{"id":"blk-44120","spans":[{"id":"spn-71917","text":"Hard-coded tier limits"}]},{"id":"blk-44121","spans":[{"id":"spn-71918","text":"Medium"}]},{"id":"blk-44122","spans":[{"id":"spn-71919","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-44123","spans":[{"id":"spn-71920","text":"10"}]},{"id":"blk-44124","spans":[{"id":"spn-71921","text":"Missing telemetry"}]},{"id":"blk-44125","spans":[{"id":"spn-71922","text":"High"}]},{"id":"blk-44126","spans":[{"id":"spn-71923","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-44127","spans":[{"id":"spn-71924","text":"11"}]},{"id":"blk-44128","spans":[{"id":"spn-71925","text":"Edge Functions as hosting"}]},{"id":"blk-44129","spans":[{"id":"spn-71926","text":"High"}]},{"id":"blk-44130","spans":[{"id":"spn-71927","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-44131","spans":[{"id":"spn-71928","text":"12"}]},{"id":"blk-44132","spans":[{"id":"spn-71929","text":"Circular A2A delegation"}]},{"id":"blk-44133","spans":[{"id":"spn-71930","text":"High"}]},{"id":"blk-44134","spans":[{"id":"spn-71931","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaierads6z3o2f5m5kjofsydlg36uweoqdps5yvysnrpkh2bn3besj6lea","vocabulary":"ampersand.docs.fs.v1"}