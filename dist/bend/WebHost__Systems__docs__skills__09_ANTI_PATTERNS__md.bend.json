{"bendscript":"0.1","blocks":[{"id":"blk-24948","kind":"heading","level":1,"spans":[{"id":"spn-28951","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-24950","kind":"paragraph","spans":[{"id":"spn-28952","marks":["bold"],"text":"Purpose:"},{"id":"spn-28953","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-24949","kind":"quote"},{"id":"blk-24951","kind":"paragraph","spans":[{"id":"spn-28954","text":"---"}]},{"id":"blk-24952","kind":"heading","level":2,"spans":[{"id":"spn-28955","text":"1. Skipping RLS Policies"}]},{"id":"blk-24953","kind":"paragraph","spans":[{"id":"spn-28956","marks":["bold"],"text":"Mistake:"},{"id":"spn-28957","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-28958","marks":["code"],"text":"service_role"},{"id":"spn-28959","text":" key in client-side code."}]},{"id":"blk-24954","kind":"paragraph","spans":[{"id":"spn-28960","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28961","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-24955","kind":"paragraph","spans":[{"id":"spn-28962","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24956","items":[{"blocks":[{"id":"blk-24958","kind":"paragraph","spans":[{"id":"spn-28963","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-24957","kind":"list-item"},{"blocks":[{"id":"blk-24960","kind":"paragraph","spans":[{"id":"spn-28964","text":"Use "},{"id":"spn-28965","marks":["code"],"text":"anon"},{"id":"spn-28966","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-28967","marks":["code"],"text":"service_role"},{"id":"spn-28968","text":" for"}]}],"id":"blk-24959","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24961","kind":"paragraph","spans":[{"id":"spn-28969","text":"Edge Functions only."}]},{"id":"blk-24962","items":[{"blocks":[{"id":"blk-24964","kind":"paragraph","spans":[{"id":"spn-28970","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-24963","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24965","kind":"paragraph","spans":[{"id":"spn-28971","text":"---"}]},{"id":"blk-24966","kind":"heading","level":2,"spans":[{"id":"spn-28972","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-24967","kind":"paragraph","spans":[{"id":"spn-28973","marks":["bold"],"text":"Mistake:"},{"id":"spn-28974","text":" Putting API keys or credentials directly in "},{"id":"spn-28975","marks":["code"],"text":"agents.provider_config"},{"id":"spn-28976","text":" or "},{"id":"spn-28977","marks":["code"],"text":"deployments.artifact"},{"id":"spn-28978","text":"."}]},{"id":"blk-24968","kind":"paragraph","spans":[{"id":"spn-28979","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28980","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-24969","kind":"paragraph","spans":[{"id":"spn-28981","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24970","items":[{"blocks":[{"id":"blk-24972","kind":"paragraph","spans":[{"id":"spn-28982","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-24971","kind":"list-item"},{"blocks":[{"id":"blk-24974","kind":"paragraph","spans":[{"id":"spn-28983","text":"Store only key names (not values) in "},{"id":"spn-28984","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-28985","text":"."}]}],"id":"blk-24973","kind":"list-item"},{"blocks":[{"id":"blk-24976","kind":"paragraph","spans":[{"id":"spn-28986","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-24975","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24977","kind":"paragraph","spans":[{"id":"spn-28987","text":"Manager) at deploy time."}]},{"id":"blk-24978","kind":"paragraph","spans":[{"id":"spn-28988","text":"---"}]},{"id":"blk-24979","kind":"heading","level":2,"spans":[{"id":"spn-28989","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-24980","kind":"paragraph","spans":[{"id":"spn-28990","marks":["bold"],"text":"Mistake:"},{"id":"spn-28991","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-24981","kind":"paragraph","spans":[{"id":"spn-28992","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28993","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-24982","kind":"paragraph","spans":[{"id":"spn-28994","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24983","items":[{"blocks":[{"id":"blk-24985","kind":"paragraph","spans":[{"id":"spn-28995","text":"Deployments are append-only. Only "},{"id":"spn-28996","marks":["code"],"text":"status"},{"id":"spn-28997","text":" and "},{"id":"spn-28998","marks":["code"],"text":"error_message"},{"id":"spn-28999","text":" can be updated."}]}],"id":"blk-24984","kind":"list-item"},{"blocks":[{"id":"blk-24987","kind":"paragraph","spans":[{"id":"spn-29000","text":"To change code or config, create a new deployment."}]}],"id":"blk-24986","kind":"list-item"},{"blocks":[{"id":"blk-24989","kind":"paragraph","spans":[{"id":"spn-29001","text":"Rollback by switching "},{"id":"spn-29002","marks":["code"],"text":"active_deployment_id"},{"id":"spn-29003","text":", not by modifying old records."}]}],"id":"blk-24988","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24990","kind":"paragraph","spans":[{"id":"spn-29004","text":"---"}]},{"id":"blk-24991","kind":"heading","level":2,"spans":[{"id":"spn-29005","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-24992","kind":"paragraph","spans":[{"id":"spn-29006","marks":["bold"],"text":"Mistake:"},{"id":"spn-29007","text":" Not checking for an existing "},{"id":"spn-29008","marks":["code"],"text":"deploying"},{"id":"spn-29009","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-24993","kind":"paragraph","spans":[{"id":"spn-29010","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29011","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-24994","kind":"paragraph","spans":[{"id":"spn-29012","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24995","items":[{"blocks":[{"id":"blk-24997","kind":"paragraph","spans":[{"id":"spn-29013","text":"Check for "},{"id":"spn-29014","marks":["code"],"text":"deploying"},{"id":"spn-29015","text":" status on the agent before creating a new deployment."}]}],"id":"blk-24996","kind":"list-item"},{"blocks":[{"id":"blk-24999","kind":"paragraph","spans":[{"id":"spn-29016","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-24998","kind":"list-item"},{"blocks":[{"id":"blk-25001","kind":"paragraph","spans":[{"id":"spn-29017","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-25000","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25002","kind":"paragraph","spans":[{"id":"spn-29018","text":"---"}]},{"id":"blk-25003","kind":"heading","level":2,"spans":[{"id":"spn-29019","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-25004","kind":"paragraph","spans":[{"id":"spn-29020","marks":["bold"],"text":"Mistake:"},{"id":"spn-29021","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-25005","kind":"paragraph","spans":[{"id":"spn-29022","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29023","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-25006","kind":"paragraph","spans":[{"id":"spn-29024","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25007","items":[{"blocks":[{"id":"blk-25009","kind":"paragraph","spans":[{"id":"spn-29025","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-25008","kind":"list-item"},{"blocks":[{"id":"blk-25011","kind":"paragraph","spans":[{"id":"spn-29026","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-25010","kind":"list-item"},{"blocks":[{"id":"blk-25013","kind":"paragraph","spans":[{"id":"spn-29027","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-25012","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25014","kind":"paragraph","spans":[{"id":"spn-29028","text":"---"}]},{"id":"blk-25015","kind":"heading","level":2,"spans":[{"id":"spn-29029","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-25016","kind":"paragraph","spans":[{"id":"spn-29030","marks":["bold"],"text":"Mistake:"},{"id":"spn-29031","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-25017","kind":"paragraph","spans":[{"id":"spn-29032","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29033","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-25018","kind":"paragraph","spans":[{"id":"spn-29034","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25019","items":[{"blocks":[{"id":"blk-25021","kind":"paragraph","spans":[{"id":"spn-29035","text":"Normalize all errors to the standard code set (see "},{"id":"spn-29036","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-29037","text":")."}]}],"id":"blk-25020","kind":"list-item"},{"blocks":[{"id":"blk-25023","kind":"paragraph","spans":[{"id":"spn-29038","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-25022","kind":"list-item"},{"blocks":[{"id":"blk-25025","kind":"paragraph","spans":[{"id":"spn-29039","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-25024","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25026","kind":"paragraph","spans":[{"id":"spn-29040","text":"---"}]},{"id":"blk-25027","kind":"heading","level":2,"spans":[{"id":"spn-29041","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-25028","kind":"paragraph","spans":[{"id":"spn-29042","marks":["bold"],"text":"Mistake:"},{"id":"spn-29043","text":" Accepting "},{"id":"spn-29044","marks":["code"],"text":"user_id"},{"id":"spn-29045","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-25029","kind":"paragraph","spans":[{"id":"spn-29046","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29047","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-25030","kind":"paragraph","spans":[{"id":"spn-29048","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25031","items":[{"blocks":[{"id":"blk-25033","kind":"paragraph","spans":[{"id":"spn-29049","text":"Always derive "},{"id":"spn-29050","marks":["code"],"text":"user_id"},{"id":"spn-29051","text":" from "},{"id":"spn-29052","marks":["code"],"text":"auth.uid()"},{"id":"spn-29053","text":" (Supabase Auth JWT)."}]}],"id":"blk-25032","kind":"list-item"},{"blocks":[{"id":"blk-25035","kind":"paragraph","spans":[{"id":"spn-29054","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-25034","kind":"list-item"},{"blocks":[{"id":"blk-25037","kind":"paragraph","spans":[{"id":"spn-29055","text":"RLS policies enforce this at the database level."}]}],"id":"blk-25036","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25038","kind":"paragraph","spans":[{"id":"spn-29056","text":"---"}]},{"id":"blk-25039","kind":"heading","level":2,"spans":[{"id":"spn-29057","text":"8. Skipping Bundle Validation"}]},{"id":"blk-25040","kind":"paragraph","spans":[{"id":"spn-29058","marks":["bold"],"text":"Mistake:"},{"id":"spn-29059","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-25041","kind":"paragraph","spans":[{"id":"spn-29060","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29061","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-25042","kind":"paragraph","spans":[{"id":"spn-29062","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25043","items":[{"blocks":[{"id":"blk-25045","kind":"paragraph","spans":[{"id":"spn-29063","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-25044","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25046","kind":"paragraph","spans":[{"id":"spn-29064","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-29065","text":"."}]},{"id":"blk-25047","items":[{"blocks":[{"id":"blk-25049","kind":"paragraph","spans":[{"id":"spn-29066","text":"Reject bundles with "},{"id":"spn-29067","marks":["code"],"text":"../"},{"id":"spn-29068","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-25048","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25050","kind":"paragraph","spans":[{"id":"spn-29069","marks":["code"],"text":"agent.config.json"},{"id":"spn-29070","text":"."}]},{"id":"blk-25051","items":[{"blocks":[{"id":"blk-25053","kind":"paragraph","spans":[{"id":"spn-29071","text":"Enforce size and file count limits."}]}],"id":"blk-25052","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25054","kind":"paragraph","spans":[{"id":"spn-29072","text":"---"}]},{"id":"blk-25055","kind":"heading","level":2,"spans":[{"id":"spn-29073","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-25056","kind":"paragraph","spans":[{"id":"spn-29074","marks":["bold"],"text":"Mistake:"},{"id":"spn-29075","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-25057","kind":"paragraph","spans":[{"id":"spn-29076","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29077","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-25058","kind":"paragraph","spans":[{"id":"spn-29078","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25059","items":[{"blocks":[{"id":"blk-25061","kind":"paragraph","spans":[{"id":"spn-29079","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-25060","kind":"list-item"},{"blocks":[{"id":"blk-25063","kind":"paragraph","spans":[{"id":"spn-29080","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-25062","kind":"list-item"},{"blocks":[{"id":"blk-25065","kind":"paragraph","spans":[{"id":"spn-29081","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-25064","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25066","kind":"paragraph","spans":[{"id":"spn-29082","text":"---"}]},{"id":"blk-25067","kind":"heading","level":2,"spans":[{"id":"spn-29083","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-25068","kind":"paragraph","spans":[{"id":"spn-29084","marks":["bold"],"text":"Mistake:"},{"id":"spn-29085","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-25069","kind":"paragraph","spans":[{"id":"spn-29086","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29087","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-25070","kind":"paragraph","spans":[{"id":"spn-29088","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25071","items":[{"blocks":[{"id":"blk-25073","kind":"paragraph","spans":[{"id":"spn-29089","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-25072","kind":"list-item"},{"blocks":[{"id":"blk-25075","kind":"paragraph","spans":[{"id":"spn-29090","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-25074","kind":"list-item"},{"blocks":[{"id":"blk-25077","kind":"paragraph","spans":[{"id":"spn-29091","text":"Test telemetry emission in integration tests."}]}],"id":"blk-25076","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25078","kind":"paragraph","spans":[{"id":"spn-29092","text":"---"}]},{"id":"blk-25079","kind":"heading","level":2,"spans":[{"id":"spn-29093","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-25080","kind":"paragraph","spans":[{"id":"spn-29094","marks":["bold"],"text":"Mistake:"},{"id":"spn-29095","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-25081","kind":"paragraph","spans":[{"id":"spn-29096","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29097","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-25082","kind":"paragraph","spans":[{"id":"spn-29098","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25083","items":[{"blocks":[{"id":"blk-25085","kind":"paragraph","spans":[{"id":"spn-29099","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-25084","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25086","kind":"paragraph","spans":[{"id":"spn-29100","text":"ingestion, billing webhooks."}]},{"id":"blk-25087","items":[{"blocks":[{"id":"blk-25089","kind":"paragraph","spans":[{"id":"spn-29101","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-25088","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25090","kind":"paragraph","spans":[{"id":"spn-29102","text":"---"}]},{"id":"blk-25091","kind":"heading","level":2,"spans":[{"id":"spn-29103","text":"12. Circular A2A Delegation"}]},{"id":"blk-25092","kind":"paragraph","spans":[{"id":"spn-29104","marks":["bold"],"text":"Mistake:"},{"id":"spn-29105","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-25093","kind":"paragraph","spans":[{"id":"spn-29106","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-29107","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-25094","kind":"paragraph","spans":[{"id":"spn-29108","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25095","items":[{"blocks":[{"id":"blk-25097","kind":"paragraph","spans":[{"id":"spn-29109","text":"Track "},{"id":"spn-29110","marks":["code"],"text":"delegation_depth"},{"id":"spn-29111","text":" in every A2A invocation."}]}],"id":"blk-25096","kind":"list-item"},{"blocks":[{"id":"blk-25099","kind":"paragraph","spans":[{"id":"spn-29112","text":"Enforce "},{"id":"spn-29113","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-29114","text":" from the governance policy."}]}],"id":"blk-25098","kind":"list-item"},{"blocks":[{"id":"blk-25101","kind":"paragraph","spans":[{"id":"spn-29115","text":"Detect and reject circular call chains."}]}],"id":"blk-25100","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25102","kind":"paragraph","spans":[{"id":"spn-29116","text":"---"}]},{"id":"blk-25103","kind":"heading","level":2,"spans":[{"id":"spn-29117","text":"Summary Table"}]},{"head":[{"id":"blk-25105","spans":[{"id":"spn-29118","text":"#"}]},{"id":"blk-25106","spans":[{"id":"spn-29119","text":"Anti-Pattern"}]},{"id":"blk-25107","spans":[{"id":"spn-29120","text":"Severity"}]},{"id":"blk-25108","spans":[{"id":"spn-29121","text":"Fix Reference"}]}],"id":"blk-25104","kind":"table","rows":[[{"id":"blk-25109","spans":[{"id":"spn-29122","text":"1"}]},{"id":"blk-25110","spans":[{"id":"spn-29123","text":"Skipping RLS"}]},{"id":"blk-25111","spans":[{"id":"spn-29124","text":"Critical"}]},{"id":"blk-25112","spans":[{"id":"spn-29125","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25113","spans":[{"id":"spn-29126","text":"2"}]},{"id":"blk-25114","spans":[{"id":"spn-29127","text":"Plaintext secrets"}]},{"id":"blk-25115","spans":[{"id":"spn-29128","text":"Critical"}]},{"id":"blk-25116","spans":[{"id":"spn-29129","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25117","spans":[{"id":"spn-29130","text":"3"}]},{"id":"blk-25118","spans":[{"id":"spn-29131","text":"Mutable deployments"}]},{"id":"blk-25119","spans":[{"id":"spn-29132","text":"High"}]},{"id":"blk-25120","spans":[{"id":"spn-29133","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25121","spans":[{"id":"spn-29134","text":"4"}]},{"id":"blk-25122","spans":[{"id":"spn-29135","text":"Concurrent deploys"}]},{"id":"blk-25123","spans":[{"id":"spn-29136","text":"High"}]},{"id":"blk-25124","spans":[{"id":"spn-29137","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25125","spans":[{"id":"spn-29138","text":"5"}]},{"id":"blk-25126","spans":[{"id":"spn-29139","text":"Unauthenticated telemetry"}]},{"id":"blk-25127","spans":[{"id":"spn-29140","text":"High"}]},{"id":"blk-25128","spans":[{"id":"spn-29141","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-25129","spans":[{"id":"spn-29142","text":"6"}]},{"id":"blk-25130","spans":[{"id":"spn-29143","text":"Secret leaks in errors"}]},{"id":"blk-25131","spans":[{"id":"spn-29144","text":"High"}]},{"id":"blk-25132","spans":[{"id":"spn-29145","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-25133","spans":[{"id":"spn-29146","text":"7"}]},{"id":"blk-25134","spans":[{"id":"spn-29147","text":"Client-provided user IDs"}]},{"id":"blk-25135","spans":[{"id":"spn-29148","text":"Critical"}]},{"id":"blk-25136","spans":[{"id":"spn-29149","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25137","spans":[{"id":"spn-29150","text":"8"}]},{"id":"blk-25138","spans":[{"id":"spn-29151","text":"Skipping bundle validation"}]},{"id":"blk-25139","spans":[{"id":"spn-29152","text":"High"}]},{"id":"blk-25140","spans":[{"id":"spn-29153","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25141","spans":[{"id":"spn-29154","text":"9"}]},{"id":"blk-25142","spans":[{"id":"spn-29155","text":"Hard-coded tier limits"}]},{"id":"blk-25143","spans":[{"id":"spn-29156","text":"Medium"}]},{"id":"blk-25144","spans":[{"id":"spn-29157","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-25145","spans":[{"id":"spn-29158","text":"10"}]},{"id":"blk-25146","spans":[{"id":"spn-29159","text":"Missing telemetry"}]},{"id":"blk-25147","spans":[{"id":"spn-29160","text":"High"}]},{"id":"blk-25148","spans":[{"id":"spn-29161","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-25149","spans":[{"id":"spn-29162","text":"11"}]},{"id":"blk-25150","spans":[{"id":"spn-29163","text":"Edge Functions as hosting"}]},{"id":"blk-25151","spans":[{"id":"spn-29164","text":"High"}]},{"id":"blk-25152","spans":[{"id":"spn-29165","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-25153","spans":[{"id":"spn-29166","text":"12"}]},{"id":"blk-25154","spans":[{"id":"spn-29167","text":"Circular A2A delegation"}]},{"id":"blk-25155","spans":[{"id":"spn-29168","text":"High"}]},{"id":"blk-25156","spans":[{"id":"spn-29169","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaierafa3cu2g5fyh5p76fjxrd2pwbmldgve2d234a2cepkhpybfzkjwwq","vocabulary":"ampersand.docs.fs.v1"}