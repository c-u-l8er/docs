{"bendscript":"0.1","blocks":[{"id":"blk-44655","kind":"heading","level":1,"spans":[{"id":"spn-74116","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-44657","kind":"paragraph","spans":[{"id":"spn-74117","marks":["bold"],"text":"Purpose:"},{"id":"spn-74118","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-44656","kind":"quote"},{"id":"blk-44658","kind":"heading","level":2,"spans":[{"id":"spn-74119","text":"1. Skipping RLS Policies"}]},{"id":"blk-44659","kind":"paragraph","spans":[{"id":"spn-74120","marks":["bold"],"text":"Mistake:"},{"id":"spn-74121","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-74122","marks":["code"],"text":"service_role"},{"id":"spn-74123","text":" key in client-side code."}]},{"id":"blk-44660","kind":"paragraph","spans":[{"id":"spn-74124","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74125","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-44661","kind":"paragraph","spans":[{"id":"spn-74126","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44662","items":[{"blocks":[{"id":"blk-44664","kind":"paragraph","spans":[{"id":"spn-74127","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-44663","kind":"list-item"},{"blocks":[{"id":"blk-44666","kind":"paragraph","spans":[{"id":"spn-74128","text":"Use "},{"id":"spn-74129","marks":["code"],"text":"anon"},{"id":"spn-74130","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-74131","marks":["code"],"text":"service_role"},{"id":"spn-74132","text":" for"}]}],"id":"blk-44665","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44667","kind":"paragraph","spans":[{"id":"spn-74133","text":"Edge Functions only."}]},{"id":"blk-44668","items":[{"blocks":[{"id":"blk-44670","kind":"paragraph","spans":[{"id":"spn-74134","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-44669","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44671","kind":"heading","level":2,"spans":[{"id":"spn-74135","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-44672","kind":"paragraph","spans":[{"id":"spn-74136","marks":["bold"],"text":"Mistake:"},{"id":"spn-74137","text":" Putting API keys or credentials directly in "},{"id":"spn-74138","marks":["code"],"text":"agents.provider_config"},{"id":"spn-74139","text":" or "},{"id":"spn-74140","marks":["code"],"text":"deployments.artifact"},{"id":"spn-74141","text":"."}]},{"id":"blk-44673","kind":"paragraph","spans":[{"id":"spn-74142","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74143","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-44674","kind":"paragraph","spans":[{"id":"spn-74144","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44675","items":[{"blocks":[{"id":"blk-44677","kind":"paragraph","spans":[{"id":"spn-74145","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-44676","kind":"list-item"},{"blocks":[{"id":"blk-44679","kind":"paragraph","spans":[{"id":"spn-74146","text":"Store only key names (not values) in "},{"id":"spn-74147","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-74148","text":"."}]}],"id":"blk-44678","kind":"list-item"},{"blocks":[{"id":"blk-44681","kind":"paragraph","spans":[{"id":"spn-74149","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-44680","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44682","kind":"paragraph","spans":[{"id":"spn-74150","text":"Manager) at deploy time."}]},{"id":"blk-44683","kind":"heading","level":2,"spans":[{"id":"spn-74151","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-44684","kind":"paragraph","spans":[{"id":"spn-74152","marks":["bold"],"text":"Mistake:"},{"id":"spn-74153","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-44685","kind":"paragraph","spans":[{"id":"spn-74154","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74155","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-44686","kind":"paragraph","spans":[{"id":"spn-74156","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44687","items":[{"blocks":[{"id":"blk-44689","kind":"paragraph","spans":[{"id":"spn-74157","text":"Deployments are append-only. Only "},{"id":"spn-74158","marks":["code"],"text":"status"},{"id":"spn-74159","text":" and "},{"id":"spn-74160","marks":["code"],"text":"error_message"},{"id":"spn-74161","text":" can be updated."}]}],"id":"blk-44688","kind":"list-item"},{"blocks":[{"id":"blk-44691","kind":"paragraph","spans":[{"id":"spn-74162","text":"To change code or config, create a new deployment."}]}],"id":"blk-44690","kind":"list-item"},{"blocks":[{"id":"blk-44693","kind":"paragraph","spans":[{"id":"spn-74163","text":"Rollback by switching "},{"id":"spn-74164","marks":["code"],"text":"active_deployment_id"},{"id":"spn-74165","text":", not by modifying old records."}]}],"id":"blk-44692","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44694","kind":"heading","level":2,"spans":[{"id":"spn-74166","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-44695","kind":"paragraph","spans":[{"id":"spn-74167","marks":["bold"],"text":"Mistake:"},{"id":"spn-74168","text":" Not checking for an existing "},{"id":"spn-74169","marks":["code"],"text":"deploying"},{"id":"spn-74170","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-44696","kind":"paragraph","spans":[{"id":"spn-74171","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74172","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-44697","kind":"paragraph","spans":[{"id":"spn-74173","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44698","items":[{"blocks":[{"id":"blk-44700","kind":"paragraph","spans":[{"id":"spn-74174","text":"Check for "},{"id":"spn-74175","marks":["code"],"text":"deploying"},{"id":"spn-74176","text":" status on the agent before creating a new deployment."}]}],"id":"blk-44699","kind":"list-item"},{"blocks":[{"id":"blk-44702","kind":"paragraph","spans":[{"id":"spn-74177","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-44701","kind":"list-item"},{"blocks":[{"id":"blk-44704","kind":"paragraph","spans":[{"id":"spn-74178","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-44703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44705","kind":"heading","level":2,"spans":[{"id":"spn-74179","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-44706","kind":"paragraph","spans":[{"id":"spn-74180","marks":["bold"],"text":"Mistake:"},{"id":"spn-74181","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-44707","kind":"paragraph","spans":[{"id":"spn-74182","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74183","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-44708","kind":"paragraph","spans":[{"id":"spn-74184","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44709","items":[{"blocks":[{"id":"blk-44711","kind":"paragraph","spans":[{"id":"spn-74185","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-44710","kind":"list-item"},{"blocks":[{"id":"blk-44713","kind":"paragraph","spans":[{"id":"spn-74186","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-44712","kind":"list-item"},{"blocks":[{"id":"blk-44715","kind":"paragraph","spans":[{"id":"spn-74187","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-44714","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44716","kind":"heading","level":2,"spans":[{"id":"spn-74188","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-44717","kind":"paragraph","spans":[{"id":"spn-74189","marks":["bold"],"text":"Mistake:"},{"id":"spn-74190","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-44718","kind":"paragraph","spans":[{"id":"spn-74191","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74192","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-44719","kind":"paragraph","spans":[{"id":"spn-74193","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44720","items":[{"blocks":[{"id":"blk-44722","kind":"paragraph","spans":[{"id":"spn-74194","text":"Normalize all errors to the standard code set (see "},{"id":"spn-74195","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-74196","text":")."}]}],"id":"blk-44721","kind":"list-item"},{"blocks":[{"id":"blk-44724","kind":"paragraph","spans":[{"id":"spn-74197","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-44723","kind":"list-item"},{"blocks":[{"id":"blk-44726","kind":"paragraph","spans":[{"id":"spn-74198","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-44725","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44727","kind":"heading","level":2,"spans":[{"id":"spn-74199","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-44728","kind":"paragraph","spans":[{"id":"spn-74200","marks":["bold"],"text":"Mistake:"},{"id":"spn-74201","text":" Accepting "},{"id":"spn-74202","marks":["code"],"text":"user_id"},{"id":"spn-74203","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-44729","kind":"paragraph","spans":[{"id":"spn-74204","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74205","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-44730","kind":"paragraph","spans":[{"id":"spn-74206","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44731","items":[{"blocks":[{"id":"blk-44733","kind":"paragraph","spans":[{"id":"spn-74207","text":"Always derive "},{"id":"spn-74208","marks":["code"],"text":"user_id"},{"id":"spn-74209","text":" from "},{"id":"spn-74210","marks":["code"],"text":"auth.uid()"},{"id":"spn-74211","text":" (Supabase Auth JWT)."}]}],"id":"blk-44732","kind":"list-item"},{"blocks":[{"id":"blk-44735","kind":"paragraph","spans":[{"id":"spn-74212","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-44734","kind":"list-item"},{"blocks":[{"id":"blk-44737","kind":"paragraph","spans":[{"id":"spn-74213","text":"RLS policies enforce this at the database level."}]}],"id":"blk-44736","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44738","kind":"heading","level":2,"spans":[{"id":"spn-74214","text":"8. Skipping Bundle Validation"}]},{"id":"blk-44739","kind":"paragraph","spans":[{"id":"spn-74215","marks":["bold"],"text":"Mistake:"},{"id":"spn-74216","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-44740","kind":"paragraph","spans":[{"id":"spn-74217","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74218","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-44741","kind":"paragraph","spans":[{"id":"spn-74219","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44742","items":[{"blocks":[{"id":"blk-44744","kind":"paragraph","spans":[{"id":"spn-74220","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-44743","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44745","kind":"paragraph","spans":[{"id":"spn-74221","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-74222","text":"."}]},{"id":"blk-44746","items":[{"blocks":[{"id":"blk-44748","kind":"paragraph","spans":[{"id":"spn-74223","text":"Reject bundles with "},{"id":"spn-74224","marks":["code"],"text":"../"},{"id":"spn-74225","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-44747","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44749","kind":"paragraph","spans":[{"id":"spn-74226","marks":["code"],"text":"agent.config.json"},{"id":"spn-74227","text":"."}]},{"id":"blk-44750","items":[{"blocks":[{"id":"blk-44752","kind":"paragraph","spans":[{"id":"spn-74228","text":"Enforce size and file count limits."}]}],"id":"blk-44751","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44753","kind":"heading","level":2,"spans":[{"id":"spn-74229","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-44754","kind":"paragraph","spans":[{"id":"spn-74230","marks":["bold"],"text":"Mistake:"},{"id":"spn-74231","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-44755","kind":"paragraph","spans":[{"id":"spn-74232","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74233","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-44756","kind":"paragraph","spans":[{"id":"spn-74234","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44757","items":[{"blocks":[{"id":"blk-44759","kind":"paragraph","spans":[{"id":"spn-74235","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-44758","kind":"list-item"},{"blocks":[{"id":"blk-44761","kind":"paragraph","spans":[{"id":"spn-74236","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-44760","kind":"list-item"},{"blocks":[{"id":"blk-44763","kind":"paragraph","spans":[{"id":"spn-74237","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-44762","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44764","kind":"heading","level":2,"spans":[{"id":"spn-74238","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-44765","kind":"paragraph","spans":[{"id":"spn-74239","marks":["bold"],"text":"Mistake:"},{"id":"spn-74240","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-44766","kind":"paragraph","spans":[{"id":"spn-74241","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74242","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-44767","kind":"paragraph","spans":[{"id":"spn-74243","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44768","items":[{"blocks":[{"id":"blk-44770","kind":"paragraph","spans":[{"id":"spn-74244","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-44769","kind":"list-item"},{"blocks":[{"id":"blk-44772","kind":"paragraph","spans":[{"id":"spn-74245","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-44771","kind":"list-item"},{"blocks":[{"id":"blk-44774","kind":"paragraph","spans":[{"id":"spn-74246","text":"Test telemetry emission in integration tests."}]}],"id":"blk-44773","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44775","kind":"heading","level":2,"spans":[{"id":"spn-74247","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-44776","kind":"paragraph","spans":[{"id":"spn-74248","marks":["bold"],"text":"Mistake:"},{"id":"spn-74249","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-44777","kind":"paragraph","spans":[{"id":"spn-74250","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74251","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-44778","kind":"paragraph","spans":[{"id":"spn-74252","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44779","items":[{"blocks":[{"id":"blk-44781","kind":"paragraph","spans":[{"id":"spn-74253","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-44780","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44782","kind":"paragraph","spans":[{"id":"spn-74254","text":"ingestion, billing webhooks."}]},{"id":"blk-44783","items":[{"blocks":[{"id":"blk-44785","kind":"paragraph","spans":[{"id":"spn-74255","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-44784","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44786","kind":"heading","level":2,"spans":[{"id":"spn-74256","text":"12. Circular A2A Delegation"}]},{"id":"blk-44787","kind":"paragraph","spans":[{"id":"spn-74257","marks":["bold"],"text":"Mistake:"},{"id":"spn-74258","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-44788","kind":"paragraph","spans":[{"id":"spn-74259","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-74260","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-44789","kind":"paragraph","spans":[{"id":"spn-74261","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-44790","items":[{"blocks":[{"id":"blk-44792","kind":"paragraph","spans":[{"id":"spn-74262","text":"Track "},{"id":"spn-74263","marks":["code"],"text":"delegation_depth"},{"id":"spn-74264","text":" in every A2A invocation."}]}],"id":"blk-44791","kind":"list-item"},{"blocks":[{"id":"blk-44794","kind":"paragraph","spans":[{"id":"spn-74265","text":"Enforce "},{"id":"spn-74266","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-74267","text":" from the governance policy."}]}],"id":"blk-44793","kind":"list-item"},{"blocks":[{"id":"blk-44796","kind":"paragraph","spans":[{"id":"spn-74268","text":"Detect and reject circular call chains."}]}],"id":"blk-44795","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44797","kind":"heading","level":2,"spans":[{"id":"spn-74269","text":"Summary Table"}]},{"head":[{"id":"blk-44799","spans":[{"id":"spn-74270","text":"#"}]},{"id":"blk-44800","spans":[{"id":"spn-74271","text":"Anti-Pattern"}]},{"id":"blk-44801","spans":[{"id":"spn-74272","text":"Severity"}]},{"id":"blk-44802","spans":[{"id":"spn-74273","text":"Fix Reference"}]}],"id":"blk-44798","kind":"table","rows":[[{"id":"blk-44803","spans":[{"id":"spn-74274","text":"1"}]},{"id":"blk-44804","spans":[{"id":"spn-74275","text":"Skipping RLS"}]},{"id":"blk-44805","spans":[{"id":"spn-74276","text":"Critical"}]},{"id":"blk-44806","spans":[{"id":"spn-74277","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-44807","spans":[{"id":"spn-74278","text":"2"}]},{"id":"blk-44808","spans":[{"id":"spn-74279","text":"Plaintext secrets"}]},{"id":"blk-44809","spans":[{"id":"spn-74280","text":"Critical"}]},{"id":"blk-44810","spans":[{"id":"spn-74281","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-44811","spans":[{"id":"spn-74282","text":"3"}]},{"id":"blk-44812","spans":[{"id":"spn-74283","text":"Mutable deployments"}]},{"id":"blk-44813","spans":[{"id":"spn-74284","text":"High"}]},{"id":"blk-44814","spans":[{"id":"spn-74285","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-44815","spans":[{"id":"spn-74286","text":"4"}]},{"id":"blk-44816","spans":[{"id":"spn-74287","text":"Concurrent deploys"}]},{"id":"blk-44817","spans":[{"id":"spn-74288","text":"High"}]},{"id":"blk-44818","spans":[{"id":"spn-74289","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-44819","spans":[{"id":"spn-74290","text":"5"}]},{"id":"blk-44820","spans":[{"id":"spn-74291","text":"Unauthenticated telemetry"}]},{"id":"blk-44821","spans":[{"id":"spn-74292","text":"High"}]},{"id":"blk-44822","spans":[{"id":"spn-74293","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-44823","spans":[{"id":"spn-74294","text":"6"}]},{"id":"blk-44824","spans":[{"id":"spn-74295","text":"Secret leaks in errors"}]},{"id":"blk-44825","spans":[{"id":"spn-74296","text":"High"}]},{"id":"blk-44826","spans":[{"id":"spn-74297","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-44827","spans":[{"id":"spn-74298","text":"7"}]},{"id":"blk-44828","spans":[{"id":"spn-74299","text":"Client-provided user IDs"}]},{"id":"blk-44829","spans":[{"id":"spn-74300","text":"Critical"}]},{"id":"blk-44830","spans":[{"id":"spn-74301","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-44831","spans":[{"id":"spn-74302","text":"8"}]},{"id":"blk-44832","spans":[{"id":"spn-74303","text":"Skipping bundle validation"}]},{"id":"blk-44833","spans":[{"id":"spn-74304","text":"High"}]},{"id":"blk-44834","spans":[{"id":"spn-74305","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-44835","spans":[{"id":"spn-74306","text":"9"}]},{"id":"blk-44836","spans":[{"id":"spn-74307","text":"Hard-coded tier limits"}]},{"id":"blk-44837","spans":[{"id":"spn-74308","text":"Medium"}]},{"id":"blk-44838","spans":[{"id":"spn-74309","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-44839","spans":[{"id":"spn-74310","text":"10"}]},{"id":"blk-44840","spans":[{"id":"spn-74311","text":"Missing telemetry"}]},{"id":"blk-44841","spans":[{"id":"spn-74312","text":"High"}]},{"id":"blk-44842","spans":[{"id":"spn-74313","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-44843","spans":[{"id":"spn-74314","text":"11"}]},{"id":"blk-44844","spans":[{"id":"spn-74315","text":"Edge Functions as hosting"}]},{"id":"blk-44845","spans":[{"id":"spn-74316","text":"High"}]},{"id":"blk-44846","spans":[{"id":"spn-74317","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-44847","spans":[{"id":"spn-74318","text":"12"}]},{"id":"blk-44848","spans":[{"id":"spn-74319","text":"Circular A2A delegation"}]},{"id":"blk-44849","spans":[{"id":"spn-74320","text":"High"}]},{"id":"blk-44850","spans":[{"id":"spn-74321","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaieranhhhulmcvspzk67tgvzy4rrb2naebdzrpz64wwaam2jqlwdezveq","vocabulary":"ampersand.docs.fs.v1"}