{"bendscript":"0.1","blocks":[{"id":"blk-24838","kind":"heading","level":1,"spans":[{"id":"spn-28322","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-24840","kind":"paragraph","spans":[{"id":"spn-28323","marks":["bold"],"text":"Purpose:"},{"id":"spn-28324","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-24839","kind":"quote"},{"id":"blk-24841","kind":"paragraph","spans":[{"id":"spn-28325","text":"---"}]},{"id":"blk-24842","kind":"heading","level":2,"spans":[{"id":"spn-28326","text":"1. Skipping RLS Policies"}]},{"id":"blk-24843","kind":"paragraph","spans":[{"id":"spn-28327","marks":["bold"],"text":"Mistake:"},{"id":"spn-28328","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-28329","marks":["code"],"text":"service_role"},{"id":"spn-28330","text":" key in client-side code."}]},{"id":"blk-24844","kind":"paragraph","spans":[{"id":"spn-28331","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28332","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-24845","kind":"paragraph","spans":[{"id":"spn-28333","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24846","items":[{"blocks":[{"id":"blk-24848","kind":"paragraph","spans":[{"id":"spn-28334","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-24847","kind":"list-item"},{"blocks":[{"id":"blk-24850","kind":"paragraph","spans":[{"id":"spn-28335","text":"Use "},{"id":"spn-28336","marks":["code"],"text":"anon"},{"id":"spn-28337","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-28338","marks":["code"],"text":"service_role"},{"id":"spn-28339","text":" for"}]}],"id":"blk-24849","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24851","kind":"paragraph","spans":[{"id":"spn-28340","text":"Edge Functions only."}]},{"id":"blk-24852","items":[{"blocks":[{"id":"blk-24854","kind":"paragraph","spans":[{"id":"spn-28341","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-24853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24855","kind":"paragraph","spans":[{"id":"spn-28342","text":"---"}]},{"id":"blk-24856","kind":"heading","level":2,"spans":[{"id":"spn-28343","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-24857","kind":"paragraph","spans":[{"id":"spn-28344","marks":["bold"],"text":"Mistake:"},{"id":"spn-28345","text":" Putting API keys or credentials directly in "},{"id":"spn-28346","marks":["code"],"text":"agents.provider_config"},{"id":"spn-28347","text":" or "},{"id":"spn-28348","marks":["code"],"text":"deployments.artifact"},{"id":"spn-28349","text":"."}]},{"id":"blk-24858","kind":"paragraph","spans":[{"id":"spn-28350","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28351","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-24859","kind":"paragraph","spans":[{"id":"spn-28352","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24860","items":[{"blocks":[{"id":"blk-24862","kind":"paragraph","spans":[{"id":"spn-28353","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-24861","kind":"list-item"},{"blocks":[{"id":"blk-24864","kind":"paragraph","spans":[{"id":"spn-28354","text":"Store only key names (not values) in "},{"id":"spn-28355","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-28356","text":"."}]}],"id":"blk-24863","kind":"list-item"},{"blocks":[{"id":"blk-24866","kind":"paragraph","spans":[{"id":"spn-28357","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-24865","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24867","kind":"paragraph","spans":[{"id":"spn-28358","text":"Manager) at deploy time."}]},{"id":"blk-24868","kind":"paragraph","spans":[{"id":"spn-28359","text":"---"}]},{"id":"blk-24869","kind":"heading","level":2,"spans":[{"id":"spn-28360","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-24870","kind":"paragraph","spans":[{"id":"spn-28361","marks":["bold"],"text":"Mistake:"},{"id":"spn-28362","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-24871","kind":"paragraph","spans":[{"id":"spn-28363","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28364","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-24872","kind":"paragraph","spans":[{"id":"spn-28365","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24873","items":[{"blocks":[{"id":"blk-24875","kind":"paragraph","spans":[{"id":"spn-28366","text":"Deployments are append-only. Only "},{"id":"spn-28367","marks":["code"],"text":"status"},{"id":"spn-28368","text":" and "},{"id":"spn-28369","marks":["code"],"text":"error_message"},{"id":"spn-28370","text":" can be updated."}]}],"id":"blk-24874","kind":"list-item"},{"blocks":[{"id":"blk-24877","kind":"paragraph","spans":[{"id":"spn-28371","text":"To change code or config, create a new deployment."}]}],"id":"blk-24876","kind":"list-item"},{"blocks":[{"id":"blk-24879","kind":"paragraph","spans":[{"id":"spn-28372","text":"Rollback by switching "},{"id":"spn-28373","marks":["code"],"text":"active_deployment_id"},{"id":"spn-28374","text":", not by modifying old records."}]}],"id":"blk-24878","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24880","kind":"paragraph","spans":[{"id":"spn-28375","text":"---"}]},{"id":"blk-24881","kind":"heading","level":2,"spans":[{"id":"spn-28376","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-24882","kind":"paragraph","spans":[{"id":"spn-28377","marks":["bold"],"text":"Mistake:"},{"id":"spn-28378","text":" Not checking for an existing "},{"id":"spn-28379","marks":["code"],"text":"deploying"},{"id":"spn-28380","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-24883","kind":"paragraph","spans":[{"id":"spn-28381","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28382","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-24884","kind":"paragraph","spans":[{"id":"spn-28383","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24885","items":[{"blocks":[{"id":"blk-24887","kind":"paragraph","spans":[{"id":"spn-28384","text":"Check for "},{"id":"spn-28385","marks":["code"],"text":"deploying"},{"id":"spn-28386","text":" status on the agent before creating a new deployment."}]}],"id":"blk-24886","kind":"list-item"},{"blocks":[{"id":"blk-24889","kind":"paragraph","spans":[{"id":"spn-28387","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-24888","kind":"list-item"},{"blocks":[{"id":"blk-24891","kind":"paragraph","spans":[{"id":"spn-28388","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-24890","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24892","kind":"paragraph","spans":[{"id":"spn-28389","text":"---"}]},{"id":"blk-24893","kind":"heading","level":2,"spans":[{"id":"spn-28390","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-24894","kind":"paragraph","spans":[{"id":"spn-28391","marks":["bold"],"text":"Mistake:"},{"id":"spn-28392","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-24895","kind":"paragraph","spans":[{"id":"spn-28393","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28394","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-24896","kind":"paragraph","spans":[{"id":"spn-28395","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24897","items":[{"blocks":[{"id":"blk-24899","kind":"paragraph","spans":[{"id":"spn-28396","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-24898","kind":"list-item"},{"blocks":[{"id":"blk-24901","kind":"paragraph","spans":[{"id":"spn-28397","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-24900","kind":"list-item"},{"blocks":[{"id":"blk-24903","kind":"paragraph","spans":[{"id":"spn-28398","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-24902","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24904","kind":"paragraph","spans":[{"id":"spn-28399","text":"---"}]},{"id":"blk-24905","kind":"heading","level":2,"spans":[{"id":"spn-28400","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-24906","kind":"paragraph","spans":[{"id":"spn-28401","marks":["bold"],"text":"Mistake:"},{"id":"spn-28402","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-24907","kind":"paragraph","spans":[{"id":"spn-28403","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28404","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-24908","kind":"paragraph","spans":[{"id":"spn-28405","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24909","items":[{"blocks":[{"id":"blk-24911","kind":"paragraph","spans":[{"id":"spn-28406","text":"Normalize all errors to the standard code set (see "},{"id":"spn-28407","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-28408","text":")."}]}],"id":"blk-24910","kind":"list-item"},{"blocks":[{"id":"blk-24913","kind":"paragraph","spans":[{"id":"spn-28409","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-24912","kind":"list-item"},{"blocks":[{"id":"blk-24915","kind":"paragraph","spans":[{"id":"spn-28410","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-24914","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24916","kind":"paragraph","spans":[{"id":"spn-28411","text":"---"}]},{"id":"blk-24917","kind":"heading","level":2,"spans":[{"id":"spn-28412","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-24918","kind":"paragraph","spans":[{"id":"spn-28413","marks":["bold"],"text":"Mistake:"},{"id":"spn-28414","text":" Accepting "},{"id":"spn-28415","marks":["code"],"text":"user_id"},{"id":"spn-28416","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-24919","kind":"paragraph","spans":[{"id":"spn-28417","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28418","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-24920","kind":"paragraph","spans":[{"id":"spn-28419","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24921","items":[{"blocks":[{"id":"blk-24923","kind":"paragraph","spans":[{"id":"spn-28420","text":"Always derive "},{"id":"spn-28421","marks":["code"],"text":"user_id"},{"id":"spn-28422","text":" from "},{"id":"spn-28423","marks":["code"],"text":"auth.uid()"},{"id":"spn-28424","text":" (Supabase Auth JWT)."}]}],"id":"blk-24922","kind":"list-item"},{"blocks":[{"id":"blk-24925","kind":"paragraph","spans":[{"id":"spn-28425","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-24924","kind":"list-item"},{"blocks":[{"id":"blk-24927","kind":"paragraph","spans":[{"id":"spn-28426","text":"RLS policies enforce this at the database level."}]}],"id":"blk-24926","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24928","kind":"paragraph","spans":[{"id":"spn-28427","text":"---"}]},{"id":"blk-24929","kind":"heading","level":2,"spans":[{"id":"spn-28428","text":"8. Skipping Bundle Validation"}]},{"id":"blk-24930","kind":"paragraph","spans":[{"id":"spn-28429","marks":["bold"],"text":"Mistake:"},{"id":"spn-28430","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-24931","kind":"paragraph","spans":[{"id":"spn-28431","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28432","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-24932","kind":"paragraph","spans":[{"id":"spn-28433","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24933","items":[{"blocks":[{"id":"blk-24935","kind":"paragraph","spans":[{"id":"spn-28434","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-24934","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24936","kind":"paragraph","spans":[{"id":"spn-28435","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-28436","text":"."}]},{"id":"blk-24937","items":[{"blocks":[{"id":"blk-24939","kind":"paragraph","spans":[{"id":"spn-28437","text":"Reject bundles with "},{"id":"spn-28438","marks":["code"],"text":"../"},{"id":"spn-28439","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-24938","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24940","kind":"paragraph","spans":[{"id":"spn-28440","marks":["code"],"text":"agent.config.json"},{"id":"spn-28441","text":"."}]},{"id":"blk-24941","items":[{"blocks":[{"id":"blk-24943","kind":"paragraph","spans":[{"id":"spn-28442","text":"Enforce size and file count limits."}]}],"id":"blk-24942","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24944","kind":"paragraph","spans":[{"id":"spn-28443","text":"---"}]},{"id":"blk-24945","kind":"heading","level":2,"spans":[{"id":"spn-28444","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-24946","kind":"paragraph","spans":[{"id":"spn-28445","marks":["bold"],"text":"Mistake:"},{"id":"spn-28446","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-24947","kind":"paragraph","spans":[{"id":"spn-28447","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28448","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-24948","kind":"paragraph","spans":[{"id":"spn-28449","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24949","items":[{"blocks":[{"id":"blk-24951","kind":"paragraph","spans":[{"id":"spn-28450","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-24950","kind":"list-item"},{"blocks":[{"id":"blk-24953","kind":"paragraph","spans":[{"id":"spn-28451","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-24952","kind":"list-item"},{"blocks":[{"id":"blk-24955","kind":"paragraph","spans":[{"id":"spn-28452","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-24954","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24956","kind":"paragraph","spans":[{"id":"spn-28453","text":"---"}]},{"id":"blk-24957","kind":"heading","level":2,"spans":[{"id":"spn-28454","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-24958","kind":"paragraph","spans":[{"id":"spn-28455","marks":["bold"],"text":"Mistake:"},{"id":"spn-28456","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-24959","kind":"paragraph","spans":[{"id":"spn-28457","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28458","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-24960","kind":"paragraph","spans":[{"id":"spn-28459","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24961","items":[{"blocks":[{"id":"blk-24963","kind":"paragraph","spans":[{"id":"spn-28460","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-24962","kind":"list-item"},{"blocks":[{"id":"blk-24965","kind":"paragraph","spans":[{"id":"spn-28461","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-24964","kind":"list-item"},{"blocks":[{"id":"blk-24967","kind":"paragraph","spans":[{"id":"spn-28462","text":"Test telemetry emission in integration tests."}]}],"id":"blk-24966","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24968","kind":"paragraph","spans":[{"id":"spn-28463","text":"---"}]},{"id":"blk-24969","kind":"heading","level":2,"spans":[{"id":"spn-28464","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-24970","kind":"paragraph","spans":[{"id":"spn-28465","marks":["bold"],"text":"Mistake:"},{"id":"spn-28466","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-24971","kind":"paragraph","spans":[{"id":"spn-28467","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28468","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-24972","kind":"paragraph","spans":[{"id":"spn-28469","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24973","items":[{"blocks":[{"id":"blk-24975","kind":"paragraph","spans":[{"id":"spn-28470","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-24974","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24976","kind":"paragraph","spans":[{"id":"spn-28471","text":"ingestion, billing webhooks."}]},{"id":"blk-24977","items":[{"blocks":[{"id":"blk-24979","kind":"paragraph","spans":[{"id":"spn-28472","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-24978","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24980","kind":"paragraph","spans":[{"id":"spn-28473","text":"---"}]},{"id":"blk-24981","kind":"heading","level":2,"spans":[{"id":"spn-28474","text":"12. Circular A2A Delegation"}]},{"id":"blk-24982","kind":"paragraph","spans":[{"id":"spn-28475","marks":["bold"],"text":"Mistake:"},{"id":"spn-28476","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-24983","kind":"paragraph","spans":[{"id":"spn-28477","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-28478","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-24984","kind":"paragraph","spans":[{"id":"spn-28479","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-24985","items":[{"blocks":[{"id":"blk-24987","kind":"paragraph","spans":[{"id":"spn-28480","text":"Track "},{"id":"spn-28481","marks":["code"],"text":"delegation_depth"},{"id":"spn-28482","text":" in every A2A invocation."}]}],"id":"blk-24986","kind":"list-item"},{"blocks":[{"id":"blk-24989","kind":"paragraph","spans":[{"id":"spn-28483","text":"Enforce "},{"id":"spn-28484","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-28485","text":" from the governance policy."}]}],"id":"blk-24988","kind":"list-item"},{"blocks":[{"id":"blk-24991","kind":"paragraph","spans":[{"id":"spn-28486","text":"Detect and reject circular call chains."}]}],"id":"blk-24990","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24992","kind":"paragraph","spans":[{"id":"spn-28487","text":"---"}]},{"id":"blk-24993","kind":"heading","level":2,"spans":[{"id":"spn-28488","text":"Summary Table"}]},{"head":[{"id":"blk-24995","spans":[{"id":"spn-28489","text":"#"}]},{"id":"blk-24996","spans":[{"id":"spn-28490","text":"Anti-Pattern"}]},{"id":"blk-24997","spans":[{"id":"spn-28491","text":"Severity"}]},{"id":"blk-24998","spans":[{"id":"spn-28492","text":"Fix Reference"}]}],"id":"blk-24994","kind":"table","rows":[[{"id":"blk-24999","spans":[{"id":"spn-28493","text":"1"}]},{"id":"blk-25000","spans":[{"id":"spn-28494","text":"Skipping RLS"}]},{"id":"blk-25001","spans":[{"id":"spn-28495","text":"Critical"}]},{"id":"blk-25002","spans":[{"id":"spn-28496","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25003","spans":[{"id":"spn-28497","text":"2"}]},{"id":"blk-25004","spans":[{"id":"spn-28498","text":"Plaintext secrets"}]},{"id":"blk-25005","spans":[{"id":"spn-28499","text":"Critical"}]},{"id":"blk-25006","spans":[{"id":"spn-28500","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25007","spans":[{"id":"spn-28501","text":"3"}]},{"id":"blk-25008","spans":[{"id":"spn-28502","text":"Mutable deployments"}]},{"id":"blk-25009","spans":[{"id":"spn-28503","text":"High"}]},{"id":"blk-25010","spans":[{"id":"spn-28504","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25011","spans":[{"id":"spn-28505","text":"4"}]},{"id":"blk-25012","spans":[{"id":"spn-28506","text":"Concurrent deploys"}]},{"id":"blk-25013","spans":[{"id":"spn-28507","text":"High"}]},{"id":"blk-25014","spans":[{"id":"spn-28508","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25015","spans":[{"id":"spn-28509","text":"5"}]},{"id":"blk-25016","spans":[{"id":"spn-28510","text":"Unauthenticated telemetry"}]},{"id":"blk-25017","spans":[{"id":"spn-28511","text":"High"}]},{"id":"blk-25018","spans":[{"id":"spn-28512","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-25019","spans":[{"id":"spn-28513","text":"6"}]},{"id":"blk-25020","spans":[{"id":"spn-28514","text":"Secret leaks in errors"}]},{"id":"blk-25021","spans":[{"id":"spn-28515","text":"High"}]},{"id":"blk-25022","spans":[{"id":"spn-28516","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-25023","spans":[{"id":"spn-28517","text":"7"}]},{"id":"blk-25024","spans":[{"id":"spn-28518","text":"Client-provided user IDs"}]},{"id":"blk-25025","spans":[{"id":"spn-28519","text":"Critical"}]},{"id":"blk-25026","spans":[{"id":"spn-28520","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25027","spans":[{"id":"spn-28521","text":"8"}]},{"id":"blk-25028","spans":[{"id":"spn-28522","text":"Skipping bundle validation"}]},{"id":"blk-25029","spans":[{"id":"spn-28523","text":"High"}]},{"id":"blk-25030","spans":[{"id":"spn-28524","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25031","spans":[{"id":"spn-28525","text":"9"}]},{"id":"blk-25032","spans":[{"id":"spn-28526","text":"Hard-coded tier limits"}]},{"id":"blk-25033","spans":[{"id":"spn-28527","text":"Medium"}]},{"id":"blk-25034","spans":[{"id":"spn-28528","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-25035","spans":[{"id":"spn-28529","text":"10"}]},{"id":"blk-25036","spans":[{"id":"spn-28530","text":"Missing telemetry"}]},{"id":"blk-25037","spans":[{"id":"spn-28531","text":"High"}]},{"id":"blk-25038","spans":[{"id":"spn-28532","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-25039","spans":[{"id":"spn-28533","text":"11"}]},{"id":"blk-25040","spans":[{"id":"spn-28534","text":"Edge Functions as hosting"}]},{"id":"blk-25041","spans":[{"id":"spn-28535","text":"High"}]},{"id":"blk-25042","spans":[{"id":"spn-28536","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-25043","spans":[{"id":"spn-28537","text":"12"}]},{"id":"blk-25044","spans":[{"id":"spn-28538","text":"Circular A2A delegation"}]},{"id":"blk-25045","spans":[{"id":"spn-28539","text":"High"}]},{"id":"blk-25046","spans":[{"id":"spn-28540","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaiera6o5odmhyiokr7kxovw32gxgyxwka7zaqv25cxo6ifzpejrlypeiq","vocabulary":"ampersand.docs.fs.v1"}