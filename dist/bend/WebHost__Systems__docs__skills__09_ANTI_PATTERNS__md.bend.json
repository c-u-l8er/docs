{"bendscript":"0.1","blocks":[{"id":"blk-25433","kind":"heading","level":1,"spans":[{"id":"spn-30124","text":"09 — Anti-Patterns"}]},{"blocks":[{"id":"blk-25435","kind":"paragraph","spans":[{"id":"spn-30125","marks":["bold"],"text":"Purpose:"},{"id":"spn-30126","text":" Common mistakes when building, operating, and integrating with WebHost.Systems. Each anti-pattern includes the mistake, why it is dangerous, and how to do it correctly."}]}],"id":"blk-25434","kind":"quote"},{"id":"blk-25436","kind":"paragraph","spans":[{"id":"spn-30127","text":"---"}]},{"id":"blk-25437","kind":"heading","level":2,"spans":[{"id":"spn-30128","text":"1. Skipping RLS Policies"}]},{"id":"blk-25438","kind":"paragraph","spans":[{"id":"spn-30129","marks":["bold"],"text":"Mistake:"},{"id":"spn-30130","text":" Creating a new table without an RLS policy, or using "},{"id":"spn-30131","marks":["code"],"text":"service_role"},{"id":"spn-30132","text":" key in client-side code."}]},{"id":"blk-25439","kind":"paragraph","spans":[{"id":"spn-30133","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30134","text":" Any authenticated user can read or modify other tenants' data. This is a data breach waiting to happen."}]},{"id":"blk-25440","kind":"paragraph","spans":[{"id":"spn-30135","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25441","items":[{"blocks":[{"id":"blk-25443","kind":"paragraph","spans":[{"id":"spn-30136","text":"Add an RLS policy to every table before inserting data."}]}],"id":"blk-25442","kind":"list-item"},{"blocks":[{"id":"blk-25445","kind":"paragraph","spans":[{"id":"spn-30137","text":"Use "},{"id":"spn-30138","marks":["code"],"text":"anon"},{"id":"spn-30139","text":" or user-scoped JWT on the client; reserve "},{"id":"spn-30140","marks":["code"],"text":"service_role"},{"id":"spn-30141","text":" for"}]}],"id":"blk-25444","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25446","kind":"paragraph","spans":[{"id":"spn-30142","text":"Edge Functions only."}]},{"id":"blk-25447","items":[{"blocks":[{"id":"blk-25449","kind":"paragraph","spans":[{"id":"spn-30143","text":"Test RLS by attempting cross-tenant access in integration tests."}]}],"id":"blk-25448","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25450","kind":"paragraph","spans":[{"id":"spn-30144","text":"---"}]},{"id":"blk-25451","kind":"heading","level":2,"spans":[{"id":"spn-30145","text":"2. Storing Plaintext Secrets in the Database"}]},{"id":"blk-25452","kind":"paragraph","spans":[{"id":"spn-30146","marks":["bold"],"text":"Mistake:"},{"id":"spn-30147","text":" Putting API keys or credentials directly in "},{"id":"spn-30148","marks":["code"],"text":"agents.provider_config"},{"id":"spn-30149","text":" or "},{"id":"spn-30150","marks":["code"],"text":"deployments.artifact"},{"id":"spn-30151","text":"."}]},{"id":"blk-25453","kind":"paragraph","spans":[{"id":"spn-30152","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30153","text":" A database leak exposes all customer secrets. RLS does not protect against a full DB compromise."}]},{"id":"blk-25454","kind":"paragraph","spans":[{"id":"spn-30154","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25455","items":[{"blocks":[{"id":"blk-25457","kind":"paragraph","spans":[{"id":"spn-30155","text":"Store secret values exclusively in Supabase Vault."}]}],"id":"blk-25456","kind":"list-item"},{"blocks":[{"id":"blk-25459","kind":"paragraph","spans":[{"id":"spn-30156","text":"Store only key names (not values) in "},{"id":"spn-30157","marks":["code"],"text":"agents.env_var_keys"},{"id":"spn-30158","text":"."}]}],"id":"blk-25458","kind":"list-item"},{"blocks":[{"id":"blk-25461","kind":"paragraph","spans":[{"id":"spn-30159","text":"Push secrets to provider mechanisms (Cloudflare Secrets API, AWS Secrets"}]}],"id":"blk-25460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25462","kind":"paragraph","spans":[{"id":"spn-30160","text":"Manager) at deploy time."}]},{"id":"blk-25463","kind":"paragraph","spans":[{"id":"spn-30161","text":"---"}]},{"id":"blk-25464","kind":"heading","level":2,"spans":[{"id":"spn-30162","text":"3. Ignoring Deployment Immutability"}]},{"id":"blk-25465","kind":"paragraph","spans":[{"id":"spn-30163","marks":["bold"],"text":"Mistake:"},{"id":"spn-30164","text":" Updating a deployment record's artifact, version, or config after creation."}]},{"id":"blk-25466","kind":"paragraph","spans":[{"id":"spn-30165","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30166","text":" Breaks audit trail, makes rollbacks unreliable, and can cause inconsistent state between the DB and the runtime provider."}]},{"id":"blk-25467","kind":"paragraph","spans":[{"id":"spn-30167","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25468","items":[{"blocks":[{"id":"blk-25470","kind":"paragraph","spans":[{"id":"spn-30168","text":"Deployments are append-only. Only "},{"id":"spn-30169","marks":["code"],"text":"status"},{"id":"spn-30170","text":" and "},{"id":"spn-30171","marks":["code"],"text":"error_message"},{"id":"spn-30172","text":" can be updated."}]}],"id":"blk-25469","kind":"list-item"},{"blocks":[{"id":"blk-25472","kind":"paragraph","spans":[{"id":"spn-30173","text":"To change code or config, create a new deployment."}]}],"id":"blk-25471","kind":"list-item"},{"blocks":[{"id":"blk-25474","kind":"paragraph","spans":[{"id":"spn-30174","text":"Rollback by switching "},{"id":"spn-30175","marks":["code"],"text":"active_deployment_id"},{"id":"spn-30176","text":", not by modifying old records."}]}],"id":"blk-25473","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25475","kind":"paragraph","spans":[{"id":"spn-30177","text":"---"}]},{"id":"blk-25476","kind":"heading","level":2,"spans":[{"id":"spn-30178","text":"4. Allowing Concurrent Deploys"}]},{"id":"blk-25477","kind":"paragraph","spans":[{"id":"spn-30179","marks":["bold"],"text":"Mistake:"},{"id":"spn-30180","text":" Not checking for an existing "},{"id":"spn-30181","marks":["code"],"text":"deploying"},{"id":"spn-30182","text":" status before starting a new deployment for the same agent."}]},{"id":"blk-25478","kind":"paragraph","spans":[{"id":"spn-30183","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30184","text":" Two concurrent deploys can race on provider state, leaving the agent in an inconsistent state (e.g., wrong version active)."}]},{"id":"blk-25479","kind":"paragraph","spans":[{"id":"spn-30185","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25480","items":[{"blocks":[{"id":"blk-25482","kind":"paragraph","spans":[{"id":"spn-30186","text":"Check for "},{"id":"spn-30187","marks":["code"],"text":"deploying"},{"id":"spn-30188","text":" status on the agent before creating a new deployment."}]}],"id":"blk-25481","kind":"list-item"},{"blocks":[{"id":"blk-25484","kind":"paragraph","spans":[{"id":"spn-30189","text":"Reject concurrent deploy attempts with a clear error message."}]}],"id":"blk-25483","kind":"list-item"},{"blocks":[{"id":"blk-25486","kind":"paragraph","spans":[{"id":"spn-30190","text":"Use database-level locking or a status check in the deploy Edge Function."}]}],"id":"blk-25485","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25487","kind":"paragraph","spans":[{"id":"spn-30191","text":"---"}]},{"id":"blk-25488","kind":"heading","level":2,"spans":[{"id":"spn-30192","text":"5. Missing Telemetry Authentication"}]},{"id":"blk-25489","kind":"paragraph","spans":[{"id":"spn-30193","marks":["bold"],"text":"Mistake:"},{"id":"spn-30194","text":" Accepting telemetry events without verifying the HMAC signature or JWT."}]},{"id":"blk-25490","kind":"paragraph","spans":[{"id":"spn-30195","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30196","text":" Malicious actors can spoof telemetry to inflate or deflate usage numbers, affecting billing and observability accuracy."}]},{"id":"blk-25491","kind":"paragraph","spans":[{"id":"spn-30197","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25492","items":[{"blocks":[{"id":"blk-25494","kind":"paragraph","spans":[{"id":"spn-30198","text":"Generate a per-deployment HMAC key at deploy time."}]}],"id":"blk-25493","kind":"list-item"},{"blocks":[{"id":"blk-25496","kind":"paragraph","spans":[{"id":"spn-30199","text":"Verify signature and timestamp on every telemetry event."}]}],"id":"blk-25495","kind":"list-item"},{"blocks":[{"id":"blk-25498","kind":"paragraph","spans":[{"id":"spn-30200","text":"Reject events with invalid or expired signatures."}]}],"id":"blk-25497","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25499","kind":"paragraph","spans":[{"id":"spn-30201","text":"---"}]},{"id":"blk-25500","kind":"heading","level":2,"spans":[{"id":"spn-30202","text":"6. Leaking Secrets in Error Messages"}]},{"id":"blk-25501","kind":"paragraph","spans":[{"id":"spn-30203","marks":["bold"],"text":"Mistake:"},{"id":"spn-30204","text":" Including secret values, provider credentials, or internal stack traces in error responses or telemetry events."}]},{"id":"blk-25502","kind":"paragraph","spans":[{"id":"spn-30205","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30206","text":" Secrets end up in client-visible responses, browser logs, or monitoring systems."}]},{"id":"blk-25503","kind":"paragraph","spans":[{"id":"spn-30207","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25504","items":[{"blocks":[{"id":"blk-25506","kind":"paragraph","spans":[{"id":"spn-30208","text":"Normalize all errors to the standard code set (see "},{"id":"spn-30209","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"},{"id":"spn-30210","text":")."}]}],"id":"blk-25505","kind":"list-item"},{"blocks":[{"id":"blk-25508","kind":"paragraph","spans":[{"id":"spn-30211","text":"Sanitize error messages before returning to clients."}]}],"id":"blk-25507","kind":"list-item"},{"blocks":[{"id":"blk-25510","kind":"paragraph","spans":[{"id":"spn-30212","text":"Log detailed errors server-side only; return safe messages to clients."}]}],"id":"blk-25509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25511","kind":"paragraph","spans":[{"id":"spn-30213","text":"---"}]},{"id":"blk-25512","kind":"heading","level":2,"spans":[{"id":"spn-30214","text":"7. Trusting Client-Provided User IDs"}]},{"id":"blk-25513","kind":"paragraph","spans":[{"id":"spn-30215","marks":["bold"],"text":"Mistake:"},{"id":"spn-30216","text":" Accepting "},{"id":"spn-30217","marks":["code"],"text":"user_id"},{"id":"spn-30218","text":" from the request body instead of extracting it from the authenticated JWT."}]},{"id":"blk-25514","kind":"paragraph","spans":[{"id":"spn-30219","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30220","text":" Allows privilege escalation -- any user can claim to be another user."}]},{"id":"blk-25515","kind":"paragraph","spans":[{"id":"spn-30221","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25516","items":[{"blocks":[{"id":"blk-25518","kind":"paragraph","spans":[{"id":"spn-30222","text":"Always derive "},{"id":"spn-30223","marks":["code"],"text":"user_id"},{"id":"spn-30224","text":" from "},{"id":"spn-30225","marks":["code"],"text":"auth.uid()"},{"id":"spn-30226","text":" (Supabase Auth JWT)."}]}],"id":"blk-25517","kind":"list-item"},{"blocks":[{"id":"blk-25520","kind":"paragraph","spans":[{"id":"spn-30227","text":"Never trust client-supplied identity fields for authorization decisions."}]}],"id":"blk-25519","kind":"list-item"},{"blocks":[{"id":"blk-25522","kind":"paragraph","spans":[{"id":"spn-30228","text":"RLS policies enforce this at the database level."}]}],"id":"blk-25521","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25523","kind":"paragraph","spans":[{"id":"spn-30229","text":"---"}]},{"id":"blk-25524","kind":"heading","level":2,"spans":[{"id":"spn-30230","text":"8. Skipping Bundle Validation"}]},{"id":"blk-25525","kind":"paragraph","spans":[{"id":"spn-30231","marks":["bold"],"text":"Mistake:"},{"id":"spn-30232","text":" Deploying uploaded bundles without checking for path traversal, oversized files, or missing manifest."}]},{"id":"blk-25526","kind":"paragraph","spans":[{"id":"spn-30233","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30234","text":" Path traversal can overwrite system files. Missing validation leads to runtime failures that are hard to debug."}]},{"id":"blk-25527","kind":"paragraph","spans":[{"id":"spn-30235","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25528","items":[{"blocks":[{"id":"blk-25530","kind":"paragraph","spans":[{"id":"spn-30236","text":"Validate every bundle against the full checklist in"}]}],"id":"blk-25529","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25531","kind":"paragraph","spans":[{"id":"spn-30237","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-30238","text":"."}]},{"id":"blk-25532","items":[{"blocks":[{"id":"blk-25534","kind":"paragraph","spans":[{"id":"spn-30239","text":"Reject bundles with "},{"id":"spn-30240","marks":["code"],"text":"../"},{"id":"spn-30241","text":" paths, unsafe symlinks, or missing"}]}],"id":"blk-25533","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25535","kind":"paragraph","spans":[{"id":"spn-30242","marks":["code"],"text":"agent.config.json"},{"id":"spn-30243","text":"."}]},{"id":"blk-25536","items":[{"blocks":[{"id":"blk-25538","kind":"paragraph","spans":[{"id":"spn-30244","text":"Enforce size and file count limits."}]}],"id":"blk-25537","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25539","kind":"paragraph","spans":[{"id":"spn-30245","text":"---"}]},{"id":"blk-25540","kind":"heading","level":2,"spans":[{"id":"spn-30246","text":"9. Hard-Coding Tier Limits"}]},{"id":"blk-25541","kind":"paragraph","spans":[{"id":"spn-30247","marks":["bold"],"text":"Mistake:"},{"id":"spn-30248","text":" Embedding tier limit values directly in application code instead of a configuration table."}]},{"id":"blk-25542","kind":"paragraph","spans":[{"id":"spn-30249","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30250","text":" Changing limits requires a code deploy instead of a config update. Easy to have inconsistent limits across enforcement points."}]},{"id":"blk-25543","kind":"paragraph","spans":[{"id":"spn-30251","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25544","items":[{"blocks":[{"id":"blk-25546","kind":"paragraph","spans":[{"id":"spn-30252","text":"Define tier limits in a configuration table or constants file."}]}],"id":"blk-25545","kind":"list-item"},{"blocks":[{"id":"blk-25548","kind":"paragraph","spans":[{"id":"spn-30253","text":"Reference limits from both the invocation gateway and deploy Edge Function."}]}],"id":"blk-25547","kind":"list-item"},{"blocks":[{"id":"blk-25550","kind":"paragraph","spans":[{"id":"spn-30254","text":"Ensure all enforcement points read from the same source of truth."}]}],"id":"blk-25549","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25551","kind":"paragraph","spans":[{"id":"spn-30255","text":"---"}]},{"id":"blk-25552","kind":"heading","level":2,"spans":[{"id":"spn-30256","text":"10. Forgetting to Emit Telemetry"}]},{"id":"blk-25553","kind":"paragraph","spans":[{"id":"spn-30257","marks":["bold"],"text":"Mistake:"},{"id":"spn-30258","text":" Adding a new runtime adapter or code path that does not emit telemetry events after invocation."}]},{"id":"blk-25554","kind":"paragraph","spans":[{"id":"spn-30259","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30260","text":" Usage goes untracked. Billing is inaccurate. Limits cannot be enforced. Observability has blind spots."}]},{"id":"blk-25555","kind":"paragraph","spans":[{"id":"spn-30261","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25556","items":[{"blocks":[{"id":"blk-25558","kind":"paragraph","spans":[{"id":"spn-30262","text":"Every invocation code path must emit exactly one telemetry event."}]}],"id":"blk-25557","kind":"list-item"},{"blocks":[{"id":"blk-25560","kind":"paragraph","spans":[{"id":"spn-30263","text":"Include telemetry emission in the RPI adapter contract (not optional)."}]}],"id":"blk-25559","kind":"list-item"},{"blocks":[{"id":"blk-25562","kind":"paragraph","spans":[{"id":"spn-30264","text":"Test telemetry emission in integration tests."}]}],"id":"blk-25561","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25563","kind":"paragraph","spans":[{"id":"spn-30265","text":"---"}]},{"id":"blk-25564","kind":"heading","level":2,"spans":[{"id":"spn-30266","text":"11. Using Supabase Edge Functions for Agent Hosting"}]},{"id":"blk-25565","kind":"paragraph","spans":[{"id":"spn-30267","marks":["bold"],"text":"Mistake:"},{"id":"spn-30268","text":" Running customer agent code inside Supabase Edge Functions instead of the data plane (Cloudflare or AgentCore)."}]},{"id":"blk-25566","kind":"paragraph","spans":[{"id":"spn-30269","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30270","text":" Edge Functions have runtime limits, different execution models, and are meant for control plane operations only. Mixing concerns compromises both reliability and security."}]},{"id":"blk-25567","kind":"paragraph","spans":[{"id":"spn-30271","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25568","items":[{"blocks":[{"id":"blk-25570","kind":"paragraph","spans":[{"id":"spn-30272","text":"Edge Functions handle: deploy orchestration, invocation gateway, telemetry"}]}],"id":"blk-25569","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25571","kind":"paragraph","spans":[{"id":"spn-30273","text":"ingestion, billing webhooks."}]},{"id":"blk-25572","items":[{"blocks":[{"id":"blk-25574","kind":"paragraph","spans":[{"id":"spn-30274","text":"Agent code runs exclusively on Cloudflare Workers/DO or AgentCore."}]}],"id":"blk-25573","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25575","kind":"paragraph","spans":[{"id":"spn-30275","text":"---"}]},{"id":"blk-25576","kind":"heading","level":2,"spans":[{"id":"spn-30276","text":"12. Circular A2A Delegation"}]},{"id":"blk-25577","kind":"paragraph","spans":[{"id":"spn-30277","marks":["bold"],"text":"Mistake:"},{"id":"spn-30278","text":" Not tracking delegation depth in agent-to-agent calls, allowing Agent A to call Agent B which calls Agent A indefinitely."}]},{"id":"blk-25578","kind":"paragraph","spans":[{"id":"spn-30279","marks":["bold"],"text":"Why it is dangerous:"},{"id":"spn-30280","text":" Infinite loops consume resources and can cause cascading failures."}]},{"id":"blk-25579","kind":"paragraph","spans":[{"id":"spn-30281","marks":["bold"],"text":"Correct approach:"}]},{"id":"blk-25580","items":[{"blocks":[{"id":"blk-25582","kind":"paragraph","spans":[{"id":"spn-30282","text":"Track "},{"id":"spn-30283","marks":["code"],"text":"delegation_depth"},{"id":"spn-30284","text":" in every A2A invocation."}]}],"id":"blk-25581","kind":"list-item"},{"blocks":[{"id":"blk-25584","kind":"paragraph","spans":[{"id":"spn-30285","text":"Enforce "},{"id":"spn-30286","marks":["code"],"text":"max_delegation_depth"},{"id":"spn-30287","text":" from the governance policy."}]}],"id":"blk-25583","kind":"list-item"},{"blocks":[{"id":"blk-25586","kind":"paragraph","spans":[{"id":"spn-30288","text":"Detect and reject circular call chains."}]}],"id":"blk-25585","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-25587","kind":"paragraph","spans":[{"id":"spn-30289","text":"---"}]},{"id":"blk-25588","kind":"heading","level":2,"spans":[{"id":"spn-30290","text":"Summary Table"}]},{"head":[{"id":"blk-25590","spans":[{"id":"spn-30291","text":"#"}]},{"id":"blk-25591","spans":[{"id":"spn-30292","text":"Anti-Pattern"}]},{"id":"blk-25592","spans":[{"id":"spn-30293","text":"Severity"}]},{"id":"blk-25593","spans":[{"id":"spn-30294","text":"Fix Reference"}]}],"id":"blk-25589","kind":"table","rows":[[{"id":"blk-25594","spans":[{"id":"spn-30295","text":"1"}]},{"id":"blk-25595","spans":[{"id":"spn-30296","text":"Skipping RLS"}]},{"id":"blk-25596","spans":[{"id":"spn-30297","text":"Critical"}]},{"id":"blk-25597","spans":[{"id":"spn-30298","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25598","spans":[{"id":"spn-30299","text":"2"}]},{"id":"blk-25599","spans":[{"id":"spn-30300","text":"Plaintext secrets"}]},{"id":"blk-25600","spans":[{"id":"spn-30301","text":"Critical"}]},{"id":"blk-25601","spans":[{"id":"spn-30302","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25602","spans":[{"id":"spn-30303","text":"3"}]},{"id":"blk-25603","spans":[{"id":"spn-30304","text":"Mutable deployments"}]},{"id":"blk-25604","spans":[{"id":"spn-30305","text":"High"}]},{"id":"blk-25605","spans":[{"id":"spn-30306","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25606","spans":[{"id":"spn-30307","text":"4"}]},{"id":"blk-25607","spans":[{"id":"spn-30308","text":"Concurrent deploys"}]},{"id":"blk-25608","spans":[{"id":"spn-30309","text":"High"}]},{"id":"blk-25609","spans":[{"id":"spn-30310","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25610","spans":[{"id":"spn-30311","text":"5"}]},{"id":"blk-25611","spans":[{"id":"spn-30312","text":"Unauthenticated telemetry"}]},{"id":"blk-25612","spans":[{"id":"spn-30313","text":"High"}]},{"id":"blk-25613","spans":[{"id":"spn-30314","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-25614","spans":[{"id":"spn-30315","text":"6"}]},{"id":"blk-25615","spans":[{"id":"spn-30316","text":"Secret leaks in errors"}]},{"id":"blk-25616","spans":[{"id":"spn-30317","text":"High"}]},{"id":"blk-25617","spans":[{"id":"spn-30318","marks":["code"],"text":"03_INVOCATION_GATEWAY.md"}]}],[{"id":"blk-25618","spans":[{"id":"spn-30319","text":"7"}]},{"id":"blk-25619","spans":[{"id":"spn-30320","text":"Client-provided user IDs"}]},{"id":"blk-25620","spans":[{"id":"spn-30321","text":"Critical"}]},{"id":"blk-25621","spans":[{"id":"spn-30322","marks":["code"],"text":"07_SECURITY_AND_SECRETS.md"}]}],[{"id":"blk-25622","spans":[{"id":"spn-30323","text":"8"}]},{"id":"blk-25623","spans":[{"id":"spn-30324","text":"Skipping bundle validation"}]},{"id":"blk-25624","spans":[{"id":"spn-30325","text":"High"}]},{"id":"blk-25625","spans":[{"id":"spn-30326","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"}]}],[{"id":"blk-25626","spans":[{"id":"spn-30327","text":"9"}]},{"id":"blk-25627","spans":[{"id":"spn-30328","text":"Hard-coded tier limits"}]},{"id":"blk-25628","spans":[{"id":"spn-30329","text":"Medium"}]},{"id":"blk-25629","spans":[{"id":"spn-30330","marks":["code"],"text":"06_BILLING_AND_LIMITS.md"}]}],[{"id":"blk-25630","spans":[{"id":"spn-30331","text":"10"}]},{"id":"blk-25631","spans":[{"id":"spn-30332","text":"Missing telemetry"}]},{"id":"blk-25632","spans":[{"id":"spn-30333","text":"High"}]},{"id":"blk-25633","spans":[{"id":"spn-30334","marks":["code"],"text":"05_TELEMETRY_AND_METRICS.md"}]}],[{"id":"blk-25634","spans":[{"id":"spn-30335","text":"11"}]},{"id":"blk-25635","spans":[{"id":"spn-30336","text":"Edge Functions as hosting"}]},{"id":"blk-25636","spans":[{"id":"spn-30337","text":"High"}]},{"id":"blk-25637","spans":[{"id":"spn-30338","marks":["code"],"text":"04_RUNTIME_PROVIDERS.md"}]}],[{"id":"blk-25638","spans":[{"id":"spn-30339","text":"12"}]},{"id":"blk-25639","spans":[{"id":"spn-30340","text":"Circular A2A delegation"}]},{"id":"blk-25640","spans":[{"id":"spn-30341","text":"High"}]},{"id":"blk-25641","spans":[{"id":"spn-30342","marks":["code"],"text":"08_AMPERSAND_INTEGRATION.md"}]}]]}],"edges":[],"id":"bagaaierazupvmadgnllxhcusoutapaupfgvkwhdiilgxvohryad2t3qde6zq","vocabulary":"ampersand.docs.fs.v1"}