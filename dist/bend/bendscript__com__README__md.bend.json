{"bendscript":"0.1","blocks":[{"id":"blk-57717","kind":"heading","level":1,"spans":[{"id":"spn-86238","text":"@bendscript/core"}]},{"id":"blk-57718","kind":"paragraph","spans":[{"id":"spn-86239","text":"Reference parser, validator, and round-trip harness for the "},{"id":"spn-86240","marks":["bold"],"text":"BendScript Protocol v0.1"},{"id":"spn-86241","text":" — a graph-first document format with typed inline link facets, for agent-native systems."}]},{"blocks":[{"id":"blk-57720","kind":"paragraph","spans":[{"id":"spn-86242","text":"Status: "},{"id":"spn-86243","marks":["bold"],"text":"v0.1 alpha (sections 0–6 of the spec)."},{"id":"spn-86244","text":" API may shift before "},{"id":"spn-86245","marks":["code"],"text":"0.1.0"},{"id":"spn-86246","text":" final."}]}],"id":"blk-57719","kind":"quote"},{"id":"blk-57721","kind":"heading","level":2,"spans":[{"id":"spn-86247","text":"What is BendScript?"}]},{"id":"blk-57722","kind":"paragraph","spans":[{"id":"spn-86248","text":"BendScript is a JSON document format that treats prose, structure, and a knowledge graph as one thing. Every document is content-addressable, every inline link can carry a typed predicate, and every typed link expands into a deterministic graph edge."}]},{"id":"blk-57723","items":[{"blocks":[{"id":"blk-57725","kind":"paragraph","spans":[{"id":"spn-86249","marks":["bold"],"text":"`bend:` URI scheme"},{"id":"spn-86250","text":" — content-addressable doc ids, span-addressable edges"}]}],"id":"blk-57724","kind":"list-item"},{"blocks":[{"id":"blk-57727","kind":"paragraph","spans":[{"id":"spn-86251","marks":["bold"],"text":"Five reserved vocabularies"},{"id":"spn-86252","text":" — core, memory, argument, spec, runefort"}]}],"id":"blk-57726","kind":"list-item"},{"blocks":[{"id":"blk-57729","kind":"paragraph","spans":[{"id":"spn-86253","marks":["bold"],"text":"§2.5.1 link-mark expansion"},{"id":"spn-86254","text":" — typed inline link facets become first-class graph edges"}]}],"id":"blk-57728","kind":"list-item"},{"blocks":[{"id":"blk-57731","kind":"paragraph","spans":[{"id":"spn-86255","marks":["bold"],"text":"§8.1.1 strict round-trip"},{"id":"spn-86256","text":" — "},{"id":"spn-86257","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-86258","text":" for every conforming document"}]}],"id":"blk-57730","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57732","kind":"paragraph","spans":[{"id":"spn-86259","text":"The full spec lives at <https://bendscript.com> and in "},{"id":"spn-86260","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/bendscript.com/blob/main/docs/spec/README.md"}],"text":"docs/spec/"},{"id":"spn-86261","text":"."}]},{"id":"blk-57733","kind":"heading","level":2,"spans":[{"id":"spn-86262","text":"Install"}]},{"id":"blk-57734","kind":"code","language":"bash","text":"npm install @bendscript/core"},{"id":"blk-57735","kind":"paragraph","spans":[{"id":"spn-86263","text":"Requires Node 20+."}]},{"id":"blk-57736","kind":"heading","level":2,"spans":[{"id":"spn-86264","text":"Usage"}]},{"id":"blk-57737","kind":"code","language":"ts","text":"import {\n  parse,\n  parseAndNormalize,\n  serialize,\n  serializeCanonical,\n  validate,\n  expandLinkMarks,\n  computeDocumentId,\n} from \"@bendscript/core\";\n\nconst text = `{\n  \"version\": \"bendscript/0.1\",\n  \"id\": \"bafy...\",\n  \"vocabulary\": \"core\",\n  \"blocks\": [\n    { \"id\": \"blk-1\", \"kind\": \"paragraph\", \"spans\": [{ \"id\": \"spn-1\", \"text\": \"Hello.\" }] }\n  ]\n}`;\n\nconst doc = parseAndNormalize(text);\nvalidate(doc);                         // throws ValidationError on structural errors\nconst id = await computeDocumentId(doc);\nconst edges = expandLinkMarks(doc);    // typed link marks → graph edges\nconst canonical = serializeCanonical(doc);"},{"id":"blk-57738","kind":"heading","level":3,"spans":[{"id":"spn-86265","text":"Round-trip / drift harness"}]},{"id":"blk-57739","kind":"paragraph","spans":[{"id":"spn-86266","text":"The harness used by the spec's §8 LLM round-trip evaluation is exposed as a subpath import:"}]},{"id":"blk-57740","kind":"code","language":"ts","text":"import {\n  MockModel,\n  loadCorpus,\n  runHarness,\n  computeDrift,\n  median,\n  p95,\n} from \"@bendscript/core/harness\";"},{"id":"blk-57741","kind":"paragraph","spans":[{"id":"spn-86267","text":"Bring your own "},{"id":"spn-86268","marks":["code"],"text":"ModelClient"},{"id":"spn-86269","text":" to evaluate any model against the BendScript corpus, or use "},{"id":"spn-86270","marks":["code"],"text":"MockModel"},{"id":"spn-86271","text":" for harness-mechanic tests with no API costs."}]},{"id":"blk-57742","kind":"heading","level":2,"spans":[{"id":"spn-86272","text":"API surface"}]},{"id":"blk-57743","kind":"paragraph","spans":[{"id":"spn-86273","marks":["bold"],"text":"Main entry (`@bendscript/core`)"}]},{"id":"blk-57744","items":[{"blocks":[{"id":"blk-57746","kind":"paragraph","spans":[{"id":"spn-86274","marks":["code"],"text":"parse(text)"},{"id":"spn-86275","text":", "},{"id":"spn-86276","marks":["code"],"text":"normalize(doc)"},{"id":"spn-86277","text":", "},{"id":"spn-86278","marks":["code"],"text":"parseAndNormalize(text)"}]}],"id":"blk-57745","kind":"list-item"},{"blocks":[{"id":"blk-57748","kind":"paragraph","spans":[{"id":"spn-86279","marks":["code"],"text":"serialize(doc)"},{"id":"spn-86280","text":", "},{"id":"spn-86281","marks":["code"],"text":"serializeCanonical(doc)"}]}],"id":"blk-57747","kind":"list-item"},{"blocks":[{"id":"blk-57750","kind":"paragraph","spans":[{"id":"spn-86282","marks":["code"],"text":"canonicalize(value)"},{"id":"spn-86283","text":" — RFC 8785 (JCS) wrapper"}]}],"id":"blk-57749","kind":"list-item"},{"blocks":[{"id":"blk-57752","kind":"paragraph","spans":[{"id":"spn-86284","marks":["code"],"text":"computeDocumentId(doc)"},{"id":"spn-86285","text":", "},{"id":"spn-86286","marks":["code"],"text":"expectedDocumentId(doc)"},{"id":"spn-86287","text":", "},{"id":"spn-86288","marks":["code"],"text":"canonicalHashInput(doc)"}]}],"id":"blk-57751","kind":"list-item"},{"blocks":[{"id":"blk-57754","kind":"paragraph","spans":[{"id":"spn-86289","marks":["code"],"text":"expandLinkMarks(doc)"},{"id":"spn-86290","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-57753","kind":"list-item"},{"blocks":[{"id":"blk-57756","kind":"paragraph","spans":[{"id":"spn-86291","marks":["code"],"text":"validate(doc)"},{"id":"spn-86292","text":", "},{"id":"spn-86293","marks":["code"],"text":"ValidationError"},{"id":"spn-86294","text":", "},{"id":"spn-86295","marks":["code"],"text":"isBendUri(s)"}]}],"id":"blk-57755","kind":"list-item"},{"blocks":[{"id":"blk-57758","kind":"paragraph","spans":[{"id":"spn-86296","text":"Types: "},{"id":"spn-86297","marks":["code"],"text":"Document"},{"id":"spn-86298","text":", "},{"id":"spn-86299","marks":["code"],"text":"NormalizedDocument"},{"id":"spn-86300","text":", "},{"id":"spn-86301","marks":["code"],"text":"Block"},{"id":"spn-86302","text":", "},{"id":"spn-86303","marks":["code"],"text":"Span"},{"id":"spn-86304","text":", "},{"id":"spn-86305","marks":["code"],"text":"Edge"},{"id":"spn-86306","text":", "},{"id":"spn-86307","marks":["code"],"text":"Mark"},{"id":"spn-86308","text":", "},{"id":"spn-86309","marks":["code"],"text":"LinkMark"},{"id":"spn-86310","text":", "},{"id":"spn-86311","marks":["code"],"text":"MarkKind"},{"id":"spn-86312","text":", "},{"id":"spn-86313","marks":["code"],"text":"Predicate"},{"id":"spn-86314","text":", "},{"id":"spn-86315","marks":["code"],"text":"ProtocolVersion"}]}],"id":"blk-57757","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57759","kind":"paragraph","spans":[{"id":"spn-86316","marks":["bold"],"text":"Harness subpath (`@bendscript/core/harness`)"}]},{"id":"blk-57760","items":[{"blocks":[{"id":"blk-57762","kind":"paragraph","spans":[{"id":"spn-86317","marks":["code"],"text":"runHarness({ corpus, models, classes })"},{"id":"spn-86318","text":", "},{"id":"spn-86319","marks":["code"],"text":"runOne(...)"}]}],"id":"blk-57761","kind":"list-item"},{"blocks":[{"id":"blk-57764","kind":"paragraph","spans":[{"id":"spn-86320","marks":["code"],"text":"loadCorpus(dir)"},{"id":"spn-86321","text":", "},{"id":"spn-86322","marks":["code"],"text":"buildPrompt(...)"}]}],"id":"blk-57763","kind":"list-item"},{"blocks":[{"id":"blk-57766","kind":"paragraph","spans":[{"id":"spn-86323","marks":["code"],"text":"computeDrift(before, after)"},{"id":"spn-86324","text":", "},{"id":"spn-86325","marks":["code"],"text":"median(arr)"},{"id":"spn-86326","text":", "},{"id":"spn-86327","marks":["code"],"text":"p95(arr)"},{"id":"spn-86328","text":", "},{"id":"spn-86329","marks":["code"],"text":"aggregate(...)"}]}],"id":"blk-57765","kind":"list-item"},{"blocks":[{"id":"blk-57768","kind":"paragraph","spans":[{"id":"spn-86330","marks":["code"],"text":"MockModel(name, { mode })"},{"id":"spn-86331","text":", "},{"id":"spn-86332","marks":["code"],"text":"MockMode"}]}],"id":"blk-57767","kind":"list-item"},{"blocks":[{"id":"blk-57770","kind":"paragraph","spans":[{"id":"spn-86333","marks":["code"],"text":"THRESHOLDS"},{"id":"spn-86334","text":", "},{"id":"spn-86335","marks":["code"],"text":"DRIFT_WEIGHTS"}]}],"id":"blk-57769","kind":"list-item"},{"blocks":[{"id":"blk-57772","kind":"paragraph","spans":[{"id":"spn-86336","text":"Types: "},{"id":"spn-86337","marks":["code"],"text":"CorpusEntry"},{"id":"spn-86338","text":", "},{"id":"spn-86339","marks":["code"],"text":"DriftScore"},{"id":"spn-86340","text":", "},{"id":"spn-86341","marks":["code"],"text":"DriftComponents"},{"id":"spn-86342","text":", "},{"id":"spn-86343","marks":["code"],"text":"ModelClient"},{"id":"spn-86344","text":", "},{"id":"spn-86345","marks":["code"],"text":"RunReport"},{"id":"spn-86346","text":", "},{"id":"spn-86347","marks":["code"],"text":"Transcript"},{"id":"spn-86348","text":", "},{"id":"spn-86349","marks":["code"],"text":"TaskClass"}]}],"id":"blk-57771","kind":"list-item"}]