{"bendscript":"0.1","blocks":[{"id":"blk-56947","kind":"heading","level":1,"spans":[{"id":"spn-83776","text":"@bendscript/core"}]},{"id":"blk-56948","kind":"paragraph","spans":[{"id":"spn-83777","text":"Reference parser, validator, and round-trip harness for the "},{"id":"spn-83778","marks":["bold"],"text":"BendScript Protocol v0.1"},{"id":"spn-83779","text":" — a graph-first document format with typed inline link facets, for agent-native systems."}]},{"blocks":[{"id":"blk-56950","kind":"paragraph","spans":[{"id":"spn-83780","text":"Status: "},{"id":"spn-83781","marks":["bold"],"text":"v0.1 alpha (sections 0–6 of the spec)."},{"id":"spn-83782","text":" API may shift before "},{"id":"spn-83783","marks":["code"],"text":"0.1.0"},{"id":"spn-83784","text":" final."}]}],"id":"blk-56949","kind":"quote"},{"id":"blk-56951","kind":"heading","level":2,"spans":[{"id":"spn-83785","text":"What is BendScript?"}]},{"id":"blk-56952","kind":"paragraph","spans":[{"id":"spn-83786","text":"BendScript is a JSON document format that treats prose, structure, and a knowledge graph as one thing. Every document is content-addressable, every inline link can carry a typed predicate, and every typed link expands into a deterministic graph edge."}]},{"id":"blk-56953","items":[{"blocks":[{"id":"blk-56955","kind":"paragraph","spans":[{"id":"spn-83787","marks":["bold"],"text":"`bend:` URI scheme"},{"id":"spn-83788","text":" — content-addressable doc ids, span-addressable edges"}]}],"id":"blk-56954","kind":"list-item"},{"blocks":[{"id":"blk-56957","kind":"paragraph","spans":[{"id":"spn-83789","marks":["bold"],"text":"Five reserved vocabularies"},{"id":"spn-83790","text":" — core, memory, argument, spec, runefort"}]}],"id":"blk-56956","kind":"list-item"},{"blocks":[{"id":"blk-56959","kind":"paragraph","spans":[{"id":"spn-83791","marks":["bold"],"text":"§2.5.1 link-mark expansion"},{"id":"spn-83792","text":" — typed inline link facets become first-class graph edges"}]}],"id":"blk-56958","kind":"list-item"},{"blocks":[{"id":"blk-56961","kind":"paragraph","spans":[{"id":"spn-83793","marks":["bold"],"text":"§8.1.1 strict round-trip"},{"id":"spn-83794","text":" — "},{"id":"spn-83795","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-83796","text":" for every conforming document"}]}],"id":"blk-56960","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56962","kind":"paragraph","spans":[{"id":"spn-83797","text":"The full spec lives at <https://bendscript.com> and in "},{"id":"spn-83798","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/bendscript.com/blob/main/docs/spec/README.md"}],"text":"docs/spec/"},{"id":"spn-83799","text":"."}]},{"id":"blk-56963","kind":"heading","level":2,"spans":[{"id":"spn-83800","text":"Install"}]},{"id":"blk-56964","kind":"code","language":"bash","text":"npm install @bendscript/core"},{"id":"blk-56965","kind":"paragraph","spans":[{"id":"spn-83801","text":"Requires Node 20+."}]},{"id":"blk-56966","kind":"heading","level":2,"spans":[{"id":"spn-83802","text":"Usage"}]},{"id":"blk-56967","kind":"code","language":"ts","text":"import {\n  parse,\n  parseAndNormalize,\n  serialize,\n  serializeCanonical,\n  validate,\n  expandLinkMarks,\n  computeDocumentId,\n} from \"@bendscript/core\";\n\nconst text = `{\n  \"version\": \"bendscript/0.1\",\n  \"id\": \"bafy...\",\n  \"vocabulary\": \"core\",\n  \"blocks\": [\n    { \"id\": \"blk-1\", \"kind\": \"paragraph\", \"spans\": [{ \"id\": \"spn-1\", \"text\": \"Hello.\" }] }\n  ]\n}`;\n\nconst doc = parseAndNormalize(text);\nvalidate(doc);                         // throws ValidationError on structural errors\nconst id = await computeDocumentId(doc);\nconst edges = expandLinkMarks(doc);    // typed link marks → graph edges\nconst canonical = serializeCanonical(doc);"},{"id":"blk-56968","kind":"heading","level":3,"spans":[{"id":"spn-83803","text":"Round-trip / drift harness"}]},{"id":"blk-56969","kind":"paragraph","spans":[{"id":"spn-83804","text":"The harness used by the spec's §8 LLM round-trip evaluation is exposed as a subpath import:"}]},{"id":"blk-56970","kind":"code","language":"ts","text":"import {\n  MockModel,\n  loadCorpus,\n  runHarness,\n  computeDrift,\n  median,\n  p95,\n} from \"@bendscript/core/harness\";"},{"id":"blk-56971","kind":"paragraph","spans":[{"id":"spn-83805","text":"Bring your own "},{"id":"spn-83806","marks":["code"],"text":"ModelClient"},{"id":"spn-83807","text":" to evaluate any model against the BendScript corpus, or use "},{"id":"spn-83808","marks":["code"],"text":"MockModel"},{"id":"spn-83809","text":" for harness-mechanic tests with no API costs."}]},{"id":"blk-56972","kind":"heading","level":2,"spans":[{"id":"spn-83810","text":"API surface"}]},{"id":"blk-56973","kind":"paragraph","spans":[{"id":"spn-83811","marks":["bold"],"text":"Main entry (`@bendscript/core`)"}]},{"id":"blk-56974","items":[{"blocks":[{"id":"blk-56976","kind":"paragraph","spans":[{"id":"spn-83812","marks":["code"],"text":"parse(text)"},{"id":"spn-83813","text":", "},{"id":"spn-83814","marks":["code"],"text":"normalize(doc)"},{"id":"spn-83815","text":", "},{"id":"spn-83816","marks":["code"],"text":"parseAndNormalize(text)"}]}],"id":"blk-56975","kind":"list-item"},{"blocks":[{"id":"blk-56978","kind":"paragraph","spans":[{"id":"spn-83817","marks":["code"],"text":"serialize(doc)"},{"id":"spn-83818","text":", "},{"id":"spn-83819","marks":["code"],"text":"serializeCanonical(doc)"}]}],"id":"blk-56977","kind":"list-item"},{"blocks":[{"id":"blk-56980","kind":"paragraph","spans":[{"id":"spn-83820","marks":["code"],"text":"canonicalize(value)"},{"id":"spn-83821","text":" — RFC 8785 (JCS) wrapper"}]}],"id":"blk-56979","kind":"list-item"},{"blocks":[{"id":"blk-56982","kind":"paragraph","spans":[{"id":"spn-83822","marks":["code"],"text":"computeDocumentId(doc)"},{"id":"spn-83823","text":", "},{"id":"spn-83824","marks":["code"],"text":"expectedDocumentId(doc)"},{"id":"spn-83825","text":", "},{"id":"spn-83826","marks":["code"],"text":"canonicalHashInput(doc)"}]}],"id":"blk-56981","kind":"list-item"},{"blocks":[{"id":"blk-56984","kind":"paragraph","spans":[{"id":"spn-83827","marks":["code"],"text":"expandLinkMarks(doc)"},{"id":"spn-83828","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-56983","kind":"list-item"},{"blocks":[{"id":"blk-56986","kind":"paragraph","spans":[{"id":"spn-83829","marks":["code"],"text":"validate(doc)"},{"id":"spn-83830","text":", "},{"id":"spn-83831","marks":["code"],"text":"ValidationError"},{"id":"spn-83832","text":", "},{"id":"spn-83833","marks":["code"],"text":"isBendUri(s)"}]}],"id":"blk-56985","kind":"list-item"},{"blocks":[{"id":"blk-56988","kind":"paragraph","spans":[{"id":"spn-83834","text":"Types: "},{"id":"spn-83835","marks":["code"],"text":"Document"},{"id":"spn-83836","text":", "},{"id":"spn-83837","marks":["code"],"text":"NormalizedDocument"},{"id":"spn-83838","text":", "},{"id":"spn-83839","marks":["code"],"text":"Block"},{"id":"spn-83840","text":", "},{"id":"spn-83841","marks":["code"],"text":"Span"},{"id":"spn-83842","text":", "},{"id":"spn-83843","marks":["code"],"text":"Edge"},{"id":"spn-83844","text":", "},{"id":"spn-83845","marks":["code"],"text":"Mark"},{"id":"spn-83846","text":", "},{"id":"spn-83847","marks":["code"],"text":"LinkMark"},{"id":"spn-83848","text":", "},{"id":"spn-83849","marks":["code"],"text":"MarkKind"},{"id":"spn-83850","text":", "},{"id":"spn-83851","marks":["code"],"text":"Predicate"},{"id":"spn-83852","text":", "},{"id":"spn-83853","marks":["code"],"text":"ProtocolVersion"}]}],"id":"blk-56987","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56989","kind":"paragraph","spans":[{"id":"spn-83854","marks":["bold"],"text":"Harness subpath (`@bendscript/core/harness`)"}]},{"id":"blk-56990","items":[{"blocks":[{"id":"blk-56992","kind":"paragraph","spans":[{"id":"spn-83855","marks":["code"],"text":"runHarness({ corpus, models, classes })"},{"id":"spn-83856","text":", "},{"id":"spn-83857","marks":["code"],"text":"runOne(...)"}]}],"id":"blk-56991","kind":"list-item"},{"blocks":[{"id":"blk-56994","kind":"paragraph","spans":[{"id":"spn-83858","marks":["code"],"text":"loadCorpus(dir)"},{"id":"spn-83859","text":", "},{"id":"spn-83860","marks":["code"],"text":"buildPrompt(...)"}]}],"id":"blk-56993","kind":"list-item"},{"blocks":[{"id":"blk-56996","kind":"paragraph","spans":[{"id":"spn-83861","marks":["code"],"text":"computeDrift(before, after)"},{"id":"spn-83862","text":", "},{"id":"spn-83863","marks":["code"],"text":"median(arr)"},{"id":"spn-83864","text":", "},{"id":"spn-83865","marks":["code"],"text":"p95(arr)"},{"id":"spn-83866","text":", "},{"id":"spn-83867","marks":["code"],"text":"aggregate(...)"}]}],"id":"blk-56995","kind":"list-item"},{"blocks":[{"id":"blk-56998","kind":"paragraph","spans":[{"id":"spn-83868","marks":["code"],"text":"MockModel(name, { mode })"},{"id":"spn-83869","text":", "},{"id":"spn-83870","marks":["code"],"text":"MockMode"}]}],"id":"blk-56997","kind":"list-item"},{"blocks":[{"id":"blk-57000","kind":"paragraph","spans":[{"id":"spn-83871","marks":["code"],"text":"THRESHOLDS"},{"id":"spn-83872","text":", "},{"id":"spn-83873","marks":["code"],"text":"DRIFT_WEIGHTS"}]}],"id":"blk-56999","kind":"list-item"},{"blocks":[{"id":"blk-57002","kind":"paragraph","spans":[{"id":"spn-83874","text":"Types: "},{"id":"spn-83875","marks":["code"],"text":"CorpusEntry"},{"id":"spn-83876","text":", "},{"id":"spn-83877","marks":["code"],"text":"DriftScore"},{"id":"spn-83878","text":", "},{"id":"spn-83879","marks":["code"],"text":"DriftComponents"},{"id":"spn-83880","text":", "},{"id":"spn-83881","marks":["code"],"text":"ModelClient"},{"id":"spn-83882","text":", "},{"id":"spn-83883","marks":["code"],"text":"RunReport"},{"id":"spn-83884","text":", "},{"id":"spn-83885","marks":["code"],"text":"Transcript"},{"id":"spn-83886","text":", "},{"id":"spn-83887","marks":["code"],"text":"TaskClass"}]}],"id":"blk-57001","kind":"list-item"}]