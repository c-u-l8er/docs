{"bendscript":"0.1","blocks":[{"id":"blk-56819","kind":"heading","level":1,"spans":[{"id":"spn-83616","text":"@bendscript/core"}]},{"id":"blk-56820","kind":"paragraph","spans":[{"id":"spn-83617","text":"Reference parser, validator, and round-trip harness for the "},{"id":"spn-83618","marks":["bold"],"text":"BendScript Protocol v0.1"},{"id":"spn-83619","text":" — a graph-first document format with typed inline link facets, for agent-native systems."}]},{"blocks":[{"id":"blk-56822","kind":"paragraph","spans":[{"id":"spn-83620","text":"Status: "},{"id":"spn-83621","marks":["bold"],"text":"v0.1 alpha (sections 0–6 of the spec)."},{"id":"spn-83622","text":" API may shift before "},{"id":"spn-83623","marks":["code"],"text":"0.1.0"},{"id":"spn-83624","text":" final."}]}],"id":"blk-56821","kind":"quote"},{"id":"blk-56823","kind":"heading","level":2,"spans":[{"id":"spn-83625","text":"What is BendScript?"}]},{"id":"blk-56824","kind":"paragraph","spans":[{"id":"spn-83626","text":"BendScript is a JSON document format that treats prose, structure, and a knowledge graph as one thing. Every document is content-addressable, every inline link can carry a typed predicate, and every typed link expands into a deterministic graph edge."}]},{"id":"blk-56825","items":[{"blocks":[{"id":"blk-56827","kind":"paragraph","spans":[{"id":"spn-83627","marks":["bold"],"text":"`bend:` URI scheme"},{"id":"spn-83628","text":" — content-addressable doc ids, span-addressable edges"}]}],"id":"blk-56826","kind":"list-item"},{"blocks":[{"id":"blk-56829","kind":"paragraph","spans":[{"id":"spn-83629","marks":["bold"],"text":"Five reserved vocabularies"},{"id":"spn-83630","text":" — core, memory, argument, spec, runefort"}]}],"id":"blk-56828","kind":"list-item"},{"blocks":[{"id":"blk-56831","kind":"paragraph","spans":[{"id":"spn-83631","marks":["bold"],"text":"§2.5.1 link-mark expansion"},{"id":"spn-83632","text":" — typed inline link facets become first-class graph edges"}]}],"id":"blk-56830","kind":"list-item"},{"blocks":[{"id":"blk-56833","kind":"paragraph","spans":[{"id":"spn-83633","marks":["bold"],"text":"§8.1.1 strict round-trip"},{"id":"spn-83634","text":" — "},{"id":"spn-83635","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-83636","text":" for every conforming document"}]}],"id":"blk-56832","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56834","kind":"paragraph","spans":[{"id":"spn-83637","text":"The full spec lives at <https://bendscript.com> and in "},{"id":"spn-83638","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/bendscript.com/blob/main/docs/spec/README.md"}],"text":"docs/spec/"},{"id":"spn-83639","text":"."}]},{"id":"blk-56835","kind":"heading","level":2,"spans":[{"id":"spn-83640","text":"Install"}]},{"id":"blk-56836","kind":"code","language":"bash","text":"npm install @bendscript/core"},{"id":"blk-56837","kind":"paragraph","spans":[{"id":"spn-83641","text":"Requires Node 20+."}]},{"id":"blk-56838","kind":"heading","level":2,"spans":[{"id":"spn-83642","text":"Usage"}]},{"id":"blk-56839","kind":"code","language":"ts","text":"import {\n  parse,\n  parseAndNormalize,\n  serialize,\n  serializeCanonical,\n  validate,\n  expandLinkMarks,\n  computeDocumentId,\n} from \"@bendscript/core\";\n\nconst text = `{\n  \"version\": \"bendscript/0.1\",\n  \"id\": \"bafy...\",\n  \"vocabulary\": \"core\",\n  \"blocks\": [\n    { \"id\": \"blk-1\", \"kind\": \"paragraph\", \"spans\": [{ \"id\": \"spn-1\", \"text\": \"Hello.\" }] }\n  ]\n}`;\n\nconst doc = parseAndNormalize(text);\nvalidate(doc);                         // throws ValidationError on structural errors\nconst id = await computeDocumentId(doc);\nconst edges = expandLinkMarks(doc);    // typed link marks → graph edges\nconst canonical = serializeCanonical(doc);"},{"id":"blk-56840","kind":"heading","level":3,"spans":[{"id":"spn-83643","text":"Round-trip / drift harness"}]},{"id":"blk-56841","kind":"paragraph","spans":[{"id":"spn-83644","text":"The harness used by the spec's §8 LLM round-trip evaluation is exposed as a subpath import:"}]},{"id":"blk-56842","kind":"code","language":"ts","text":"import {\n  MockModel,\n  loadCorpus,\n  runHarness,\n  computeDrift,\n  median,\n  p95,\n} from \"@bendscript/core/harness\";"},{"id":"blk-56843","kind":"paragraph","spans":[{"id":"spn-83645","text":"Bring your own "},{"id":"spn-83646","marks":["code"],"text":"ModelClient"},{"id":"spn-83647","text":" to evaluate any model against the BendScript corpus, or use "},{"id":"spn-83648","marks":["code"],"text":"MockModel"},{"id":"spn-83649","text":" for harness-mechanic tests with no API costs."}]},{"id":"blk-56844","kind":"heading","level":2,"spans":[{"id":"spn-83650","text":"API surface"}]},{"id":"blk-56845","kind":"paragraph","spans":[{"id":"spn-83651","marks":["bold"],"text":"Main entry (`@bendscript/core`)"}]},{"id":"blk-56846","items":[{"blocks":[{"id":"blk-56848","kind":"paragraph","spans":[{"id":"spn-83652","marks":["code"],"text":"parse(text)"},{"id":"spn-83653","text":", "},{"id":"spn-83654","marks":["code"],"text":"normalize(doc)"},{"id":"spn-83655","text":", "},{"id":"spn-83656","marks":["code"],"text":"parseAndNormalize(text)"}]}],"id":"blk-56847","kind":"list-item"},{"blocks":[{"id":"blk-56850","kind":"paragraph","spans":[{"id":"spn-83657","marks":["code"],"text":"serialize(doc)"},{"id":"spn-83658","text":", "},{"id":"spn-83659","marks":["code"],"text":"serializeCanonical(doc)"}]}],"id":"blk-56849","kind":"list-item"},{"blocks":[{"id":"blk-56852","kind":"paragraph","spans":[{"id":"spn-83660","marks":["code"],"text":"canonicalize(value)"},{"id":"spn-83661","text":" — RFC 8785 (JCS) wrapper"}]}],"id":"blk-56851","kind":"list-item"},{"blocks":[{"id":"blk-56854","kind":"paragraph","spans":[{"id":"spn-83662","marks":["code"],"text":"computeDocumentId(doc)"},{"id":"spn-83663","text":", "},{"id":"spn-83664","marks":["code"],"text":"expectedDocumentId(doc)"},{"id":"spn-83665","text":", "},{"id":"spn-83666","marks":["code"],"text":"canonicalHashInput(doc)"}]}],"id":"blk-56853","kind":"list-item"},{"blocks":[{"id":"blk-56856","kind":"paragraph","spans":[{"id":"spn-83667","marks":["code"],"text":"expandLinkMarks(doc)"},{"id":"spn-83668","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-56855","kind":"list-item"},{"blocks":[{"id":"blk-56858","kind":"paragraph","spans":[{"id":"spn-83669","marks":["code"],"text":"validate(doc)"},{"id":"spn-83670","text":", "},{"id":"spn-83671","marks":["code"],"text":"ValidationError"},{"id":"spn-83672","text":", "},{"id":"spn-83673","marks":["code"],"text":"isBendUri(s)"}]}],"id":"blk-56857","kind":"list-item"},{"blocks":[{"id":"blk-56860","kind":"paragraph","spans":[{"id":"spn-83674","text":"Types: "},{"id":"spn-83675","marks":["code"],"text":"Document"},{"id":"spn-83676","text":", "},{"id":"spn-83677","marks":["code"],"text":"NormalizedDocument"},{"id":"spn-83678","text":", "},{"id":"spn-83679","marks":["code"],"text":"Block"},{"id":"spn-83680","text":", "},{"id":"spn-83681","marks":["code"],"text":"Span"},{"id":"spn-83682","text":", "},{"id":"spn-83683","marks":["code"],"text":"Edge"},{"id":"spn-83684","text":", "},{"id":"spn-83685","marks":["code"],"text":"Mark"},{"id":"spn-83686","text":", "},{"id":"spn-83687","marks":["code"],"text":"LinkMark"},{"id":"spn-83688","text":", "},{"id":"spn-83689","marks":["code"],"text":"MarkKind"},{"id":"spn-83690","text":", "},{"id":"spn-83691","marks":["code"],"text":"Predicate"},{"id":"spn-83692","text":", "},{"id":"spn-83693","marks":["code"],"text":"ProtocolVersion"}]}],"id":"blk-56859","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56861","kind":"paragraph","spans":[{"id":"spn-83694","marks":["bold"],"text":"Harness subpath (`@bendscript/core/harness`)"}]},{"id":"blk-56862","items":[{"blocks":[{"id":"blk-56864","kind":"paragraph","spans":[{"id":"spn-83695","marks":["code"],"text":"runHarness({ corpus, models, classes })"},{"id":"spn-83696","text":", "},{"id":"spn-83697","marks":["code"],"text":"runOne(...)"}]}],"id":"blk-56863","kind":"list-item"},{"blocks":[{"id":"blk-56866","kind":"paragraph","spans":[{"id":"spn-83698","marks":["code"],"text":"loadCorpus(dir)"},{"id":"spn-83699","text":", "},{"id":"spn-83700","marks":["code"],"text":"buildPrompt(...)"}]}],"id":"blk-56865","kind":"list-item"},{"blocks":[{"id":"blk-56868","kind":"paragraph","spans":[{"id":"spn-83701","marks":["code"],"text":"computeDrift(before, after)"},{"id":"spn-83702","text":", "},{"id":"spn-83703","marks":["code"],"text":"median(arr)"},{"id":"spn-83704","text":", "},{"id":"spn-83705","marks":["code"],"text":"p95(arr)"},{"id":"spn-83706","text":", "},{"id":"spn-83707","marks":["code"],"text":"aggregate(...)"}]}],"id":"blk-56867","kind":"list-item"},{"blocks":[{"id":"blk-56870","kind":"paragraph","spans":[{"id":"spn-83708","marks":["code"],"text":"MockModel(name, { mode })"},{"id":"spn-83709","text":", "},{"id":"spn-83710","marks":["code"],"text":"MockMode"}]}],"id":"blk-56869","kind":"list-item"},{"blocks":[{"id":"blk-56872","kind":"paragraph","spans":[{"id":"spn-83711","marks":["code"],"text":"THRESHOLDS"},{"id":"spn-83712","text":", "},{"id":"spn-83713","marks":["code"],"text":"DRIFT_WEIGHTS"}]}],"id":"blk-56871","kind":"list-item"},{"blocks":[{"id":"blk-56874","kind":"paragraph","spans":[{"id":"spn-83714","text":"Types: "},{"id":"spn-83715","marks":["code"],"text":"CorpusEntry"},{"id":"spn-83716","text":", "},{"id":"spn-83717","marks":["code"],"text":"DriftScore"},{"id":"spn-83718","text":", "},{"id":"spn-83719","marks":["code"],"text":"DriftComponents"},{"id":"spn-83720","text":", "},{"id":"spn-83721","marks":["code"],"text":"ModelClient"},{"id":"spn-83722","text":", "},{"id":"spn-83723","marks":["code"],"text":"RunReport"},{"id":"spn-83724","text":", "},{"id":"spn-83725","marks":["code"],"text":"Transcript"},{"id":"spn-83726","text":", "},{"id":"spn-83727","marks":["code"],"text":"TaskClass"}]}],"id":"blk-56873","kind":"list-item"}]