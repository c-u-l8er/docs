{"bendscript":"0.1","blocks":[{"id":"blk-55003","kind":"heading","level":1,"spans":[{"id":"spn-105803","text":"@bendscript/core"}]},{"id":"blk-55004","kind":"paragraph","spans":[{"id":"spn-105804","text":"Reference parser, validator, and round-trip harness for the "},{"id":"spn-105805","marks":["bold"],"text":"BendScript Protocol v0.1"},{"id":"spn-105806","text":" — a graph-first document format with typed inline link facets, for agent-native systems."}]},{"blocks":[{"id":"blk-55006","kind":"paragraph","spans":[{"id":"spn-105807","text":"Status: "},{"id":"spn-105808","marks":["bold"],"text":"v0.1 alpha (sections 0–6 of the spec)."},{"id":"spn-105809","text":" API may shift before "},{"id":"spn-105810","marks":["code"],"text":"0.1.0"},{"id":"spn-105811","text":" final."}]}],"id":"blk-55005","kind":"quote"},{"id":"blk-55007","kind":"heading","level":2,"spans":[{"id":"spn-105812","text":"What is BendScript?"}]},{"id":"blk-55008","kind":"paragraph","spans":[{"id":"spn-105813","text":"BendScript is a JSON document format that treats prose, structure, and a knowledge graph as one thing. Every document is content-addressable, every inline link can carry a typed predicate, and every typed link expands into a deterministic graph edge."}]},{"id":"blk-55009","items":[{"blocks":[{"id":"blk-55011","kind":"paragraph","spans":[{"id":"spn-105814","marks":["bold"],"text":"`bend:` URI scheme"},{"id":"spn-105815","text":" — content-addressable doc ids, span-addressable edges"}]}],"id":"blk-55010","kind":"list-item"},{"blocks":[{"id":"blk-55013","kind":"paragraph","spans":[{"id":"spn-105816","marks":["bold"],"text":"Five reserved vocabularies"},{"id":"spn-105817","text":" — core, memory, argument, spec, runefort"}]}],"id":"blk-55012","kind":"list-item"},{"blocks":[{"id":"blk-55015","kind":"paragraph","spans":[{"id":"spn-105818","marks":["bold"],"text":"§2.5.1 link-mark expansion"},{"id":"spn-105819","text":" — typed inline link facets become first-class graph edges"}]}],"id":"blk-55014","kind":"list-item"},{"blocks":[{"id":"blk-55017","kind":"paragraph","spans":[{"id":"spn-105820","marks":["bold"],"text":"§8.1.1 strict round-trip"},{"id":"spn-105821","text":" — "},{"id":"spn-105822","marks":["code"],"text":"parse(serialize(parse(d))) === parse(d)"},{"id":"spn-105823","text":" for every conforming document"}]}],"id":"blk-55016","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55018","kind":"paragraph","spans":[{"id":"spn-105824","text":"The full spec lives at <https://bendscript.com> and in "},{"id":"spn-105825","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/bendscript.com/blob/main/docs/spec/README.md"}],"text":"docs/spec/"},{"id":"spn-105826","text":"."}]},{"id":"blk-55019","kind":"heading","level":2,"spans":[{"id":"spn-105827","text":"Install"}]},{"id":"blk-55020","kind":"code","language":"bash","text":"npm install @bendscript/core"},{"id":"blk-55021","kind":"paragraph","spans":[{"id":"spn-105828","text":"Requires Node 20+."}]},{"id":"blk-55022","kind":"heading","level":2,"spans":[{"id":"spn-105829","text":"Usage"}]},{"id":"blk-55023","kind":"code","language":"ts","text":"import {\n  parse,\n  parseAndNormalize,\n  serialize,\n  serializeCanonical,\n  validate,\n  expandLinkMarks,\n  computeDocumentId,\n} from \"@bendscript/core\";\n\nconst text = `{\n  \"bendscript\": \"0.1\",\n  \"id\": \"PLACEHOLDER\",\n  \"vocabulary\": \"core\",\n  \"blocks\": [\n    { \"id\": \"blk-1\", \"kind\": \"paragraph\", \"spans\": [{ \"id\": \"spn-1\", \"text\": \"Hello.\" }] }\n  ],\n  \"edges\": []\n}`;\n\nconst doc = parseAndNormalize(text);\nvalidate(doc);                         // throws ValidationError on structural errors\nconst id = await computeDocumentId(doc);\nconst edges = expandLinkMarks(doc);    // typed link marks → graph edges\nconst canonical = serializeCanonical(doc);"},{"id":"blk-55024","kind":"heading","level":3,"spans":[{"id":"spn-105830","text":"Round-trip / drift harness"}]},{"id":"blk-55025","kind":"paragraph","spans":[{"id":"spn-105831","text":"The harness used by the spec's §8 LLM round-trip evaluation is exposed as a subpath import:"}]},{"id":"blk-55026","kind":"code","language":"ts","text":"import {\n  MockModel,\n  loadCorpus,\n  runHarness,\n  computeDrift,\n  median,\n  p95,\n} from \"@bendscript/core/harness\";"},{"id":"blk-55027","kind":"paragraph","spans":[{"id":"spn-105832","text":"Bring your own "},{"id":"spn-105833","marks":["code"],"text":"ModelClient"},{"id":"spn-105834","text":" to evaluate any model against the BendScript corpus, or use "},{"id":"spn-105835","marks":["code"],"text":"MockModel"},{"id":"spn-105836","text":" for harness-mechanic tests with no API costs."}]},{"id":"blk-55028","kind":"heading","level":2,"spans":[{"id":"spn-105837","text":"API surface"}]},{"id":"blk-55029","kind":"paragraph","spans":[{"id":"spn-105838","marks":["bold"],"text":"Main entry (`@bendscript/core`)"}]},{"id":"blk-55030","items":[{"blocks":[{"id":"blk-55032","kind":"paragraph","spans":[{"id":"spn-105839","marks":["code"],"text":"parse(text)"},{"id":"spn-105840","text":", "},{"id":"spn-105841","marks":["code"],"text":"normalize(doc)"},{"id":"spn-105842","text":", "},{"id":"spn-105843","marks":["code"],"text":"parseAndNormalize(text)"}]}],"id":"blk-55031","kind":"list-item"},{"blocks":[{"id":"blk-55034","kind":"paragraph","spans":[{"id":"spn-105844","marks":["code"],"text":"serialize(doc)"},{"id":"spn-105845","text":", "},{"id":"spn-105846","marks":["code"],"text":"serializeCanonical(doc)"}]}],"id":"blk-55033","kind":"list-item"},{"blocks":[{"id":"blk-55036","kind":"paragraph","spans":[{"id":"spn-105847","marks":["code"],"text":"canonicalize(value)"},{"id":"spn-105848","text":" — RFC 8785 (JCS) wrapper"}]}],"id":"blk-55035","kind":"list-item"},{"blocks":[{"id":"blk-55038","kind":"paragraph","spans":[{"id":"spn-105849","marks":["code"],"text":"computeDocumentId(doc)"},{"id":"spn-105850","text":", "},{"id":"spn-105851","marks":["code"],"text":"expectedDocumentId(doc)"},{"id":"spn-105852","text":", "},{"id":"spn-105853","marks":["code"],"text":"canonicalHashInput(doc)"}]}],"id":"blk-55037","kind":"list-item"},{"blocks":[{"id":"blk-55040","kind":"paragraph","spans":[{"id":"spn-105854","marks":["code"],"text":"expandLinkMarks(doc)"},{"id":"spn-105855","text":" — §2.5.1 link-mark → edge expansion (idempotent, dedup'd)"}]}],"id":"blk-55039","kind":"list-item"},{"blocks":[{"id":"blk-55042","kind":"paragraph","spans":[{"id":"spn-105856","marks":["code"],"text":"validate(doc)"},{"id":"spn-105857","text":", "},{"id":"spn-105858","marks":["code"],"text":"ValidationError"},{"id":"spn-105859","text":", "},{"id":"spn-105860","marks":["code"],"text":"isBendUri(s)"}]}],"id":"blk-55041","kind":"list-item"},{"blocks":[{"id":"blk-55044","kind":"paragraph","spans":[{"id":"spn-105861","text":"Types: "},{"id":"spn-105862","marks":["code"],"text":"Document"},{"id":"spn-105863","text":", "},{"id":"spn-105864","marks":["code"],"text":"NormalizedDocument"},{"id":"spn-105865","text":", "},{"id":"spn-105866","marks":["code"],"text":"Block"},{"id":"spn-105867","text":", "},{"id":"spn-105868","marks":["code"],"text":"Span"},{"id":"spn-105869","text":", "},{"id":"spn-105870","marks":["code"],"text":"Edge"},{"id":"spn-105871","text":", "},{"id":"spn-105872","marks":["code"],"text":"Mark"},{"id":"spn-105873","text":", "},{"id":"spn-105874","marks":["code"],"text":"LinkMark"},{"id":"spn-105875","text":", "},{"id":"spn-105876","marks":["code"],"text":"MarkKind"},{"id":"spn-105877","text":", "},{"id":"spn-105878","marks":["code"],"text":"Predicate"},{"id":"spn-105879","text":", "},{"id":"spn-105880","marks":["code"],"text":"ProtocolVersion"}]}],"id":"blk-55043","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55045","kind":"paragraph","spans":[{"id":"spn-105881","marks":["bold"],"text":"Harness subpath (`@bendscript/core/harness`)"}]},{"id":"blk-55046","items":[{"blocks":[{"id":"blk-55048","kind":"paragraph","spans":[{"id":"spn-105882","marks":["code"],"text":"runHarness({ corpus, models, classes })"},{"id":"spn-105883","text":", "},{"id":"spn-105884","marks":["code"],"text":"runOne(...)"}]}],"id":"blk-55047","kind":"list-item"},{"blocks":[{"id":"blk-55050","kind":"paragraph","spans":[{"id":"spn-105885","marks":["code"],"text":"loadCorpus(dir)"},{"id":"spn-105886","text":", "},{"id":"spn-105887","marks":["code"],"text":"buildPrompt(...)"}]}],"id":"blk-55049","kind":"list-item"},{"blocks":[{"id":"blk-55052","kind":"paragraph","spans":[{"id":"spn-105888","marks":["code"],"text":"computeDrift(before, after)"},{"id":"spn-105889","text":", "},{"id":"spn-105890","marks":["code"],"text":"median(arr)"},{"id":"spn-105891","text":", "},{"id":"spn-105892","marks":["code"],"text":"p95(arr)"},{"id":"spn-105893","text":", "},{"id":"spn-105894","marks":["code"],"text":"aggregate(...)"}]}],"id":"blk-55051","kind":"list-item"},{"blocks":[{"id":"blk-55054","kind":"paragraph","spans":[{"id":"spn-105895","marks":["code"],"text":"MockModel(name, { mode })"},{"id":"spn-105896","text":", "},{"id":"spn-105897","marks":["code"],"text":"MockMode"}]}],"id":"blk-55053","kind":"list-item"},{"blocks":[{"id":"blk-55056","kind":"paragraph","spans":[{"id":"spn-105898","marks":["code"],"text":"THRESHOLDS"},{"id":"spn-105899","text":", "},{"id":"spn-105900","marks":["code"],"text":"DRIFT_WEIGHTS"}]}],"id":"blk-55055","kind":"list-item"},{"blocks":[{"id":"blk-55058","kind":"paragraph","spans":[{"id":"spn-105901","text":"Types: "},{"id":"spn-105902","marks":["code"],"text":"CorpusEntry"},{"id":"spn-105903","text":", "},{"id":"spn-105904","marks":["code"],"text":"DriftScore"},{"id":"spn-105905","text":", "},{"id":"spn-105906","marks":["code"],"text":"DriftComponents"},{"id":"spn-105907","text":", "},{"id":"spn-105908","marks":["code"],"text":"ModelClient"},{"id":"spn-105909","text":", "},{"id":"spn-105910","marks":["code"],"text":"RunReport"},{"id":"spn-105911","text":", "},{"id":"spn-105912","marks":["code"],"text":"Transcript"},{"id":"spn-105913","text":", "},{"id":"spn-105914","marks":["code"],"text":"TaskClass"}]}],"id":"blk-55057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55059","kind":"heading","level":2,"spans":[{"id":"spn-105915","text":"License"}]},{"id":"blk-55060","kind":"paragraph","spans":[{"id":"spn-105916","text":"MIT © Travis Burandt — see "},{"id":"spn-105917","marks":[{"kind":"link","predicate":"cites","target":"./LICENSE"}],"text":"LICENSE"},{"id":"spn-105918","text":"."}]}],"edges":[],"id":"bagaaieraoij4t6ktccmgib4guysue2zkwhd5dehzurnridsa2nxsznabcgoa","vocabulary":"ampersand.docs.fs.v1"}