ol plane query/mutation is scoped to authenticated user."}]}],"id":"blk-31858","kind":"list-item"},{"blocks":[{"id":"blk-31861","kind":"paragraph","spans":[{"id":"spn-36650","text":"[ ] All “get by id” endpoints verify ownership/membership before returning data."}]}],"id":"blk-31860","kind":"list-item"},{"blocks":[{"id":"blk-31863","kind":"paragraph","spans":[{"id":"spn-36651","text":"[ ] Cross-tenant IDs do not leak existence (recommended: "},{"id":"spn-36652","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-36653","text":" for foreign ids, consistently applied)."}]}],"id":"blk-31862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31864","kind":"paragraph","spans":[{"id":"spn-36654","text":"Done when:"}]},{"id":"blk-31865","items":[{"blocks":[{"id":"blk-31867","kind":"paragraph","spans":[{"id":"spn-36655","text":"You have an automated “IDOR suite” that tries random IDs from other users and always gets safe failures."}]}],"id":"blk-31866","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31868","kind":"paragraph","spans":[{"id":"spn-36656","text":"---"}]},{"id":"blk-31869","kind":"heading","level":2,"spans":[{"id":"spn-36657","text":"3) Normalized errors: one envelope, stable codes"}]},{"id":"blk-31870","kind":"paragraph","spans":[{"id":"spn-36658","marks":["bold"],"text":"Spec sources:"},{"id":"spn-36659","text":" "},{"id":"spn-36660","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-36661","text":" (Normalized errors REQUIRED)"}]},{"id":"blk-31871","kind":"paragraph","spans":[{"id":"spn-36662","text":"Checklist:"}]},{"id":"blk-31872","items":[{"blocks":[{"id":"blk-31874","kind":"paragraph","spans":[{"id":"spn-36663","text":"[ ] All API responses use the normalized error envelope."}]}],"id":"blk-31873","kind":"list-item"},{"blocks":[{"id":"blk-31876","kind":"paragraph","spans":[{"id":"spn-36664","text":"[ ] Error "},{"id":"spn-36665","marks":["code"],"text":"code"},{"id":"spn-36666","text":" values are stable and used across the 