cks":[{"id":"blk-31608","kind":"paragraph","spans":[{"id":"spn-35770","text":"[ ] Invoke golden path:"}]}],"id":"blk-31607","kind":"list-item"},{"blocks":[{"id":"blk-31610","kind":"paragraph","spans":[{"id":"spn-35771","text":"invoke → response → telemetry event accepted and attributed"}]}],"id":"blk-31609","kind":"list-item"},{"blocks":[{"id":"blk-31612","kind":"paragraph","spans":[{"id":"spn-35772","text":"[ ] Limits tests:"}]}],"id":"blk-31611","kind":"list-item"},{"blocks":[{"id":"blk-31614","kind":"paragraph","spans":[{"id":"spn-35773","text":"exceed requests/tokens/computeMs and verify hard-stop behavior"}]}],"id":"blk-31613","kind":"list-item"},{"blocks":[{"id":"blk-31616","kind":"paragraph","spans":[{"id":"spn-35774","text":"[ ] Secrets tests:"}]}],"id":"blk-31615","kind":"list-item"},{"blocks":[{"id":"blk-31618","kind":"paragraph","spans":[{"id":"spn-35775","text":"ensure no plaintext secrets in DB fields and logs"}]}],"id":"blk-31617","kind":"list-item"},{"blocks":[{"id":"blk-31620","kind":"paragraph","spans":[{"id":"spn-35776","text":"telemetry signature verification works"}]}],"id":"blk-31619","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31621","kind":"paragraph","spans":[{"id":"spn-35777","text":"Done when:"}]},{"id":"blk-31622","items":[{"blocks":[{"id":"blk-31624","kind":"paragraph","spans":[{"id":"spn-35778","text":"You can demonstrate the v1 acceptance criteria from "},{"id":"spn-35779","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-35780","text":" end-to-end on Cloudflare, and (if enabled) on AgentCore for a paid tier."}]}],"id":"blk-31623","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31625","kind":"paragraph","spans":[{"id":"spn-35781","text":"---"}]},{"id":"blk-31626","kind":"heading","level":2,"spans":[{"id":"spn-35782","text":"Appendix A) Known spec-sensitive integration points (watch these)"}]},{"id":"blk-31627","kind":"paragraph","spans":[{"id":"spn-35783","text":"1. "},{"id":"spn-35784","marks":["bold"],"text":"Telemetry secret verification"},{"id":"spn-35785","text":": must be implementable without storing plaintext secrets in DB. 2. "},{"id":"spn-35786","marks":["bold"],"text":"Delegated invocation"},{"id":"spn-35787","text":": must bill/enforce as the delegated user, never as the caller service. 3. "},{"id":"spn-35788","marks":["bold"],"text":"Deployment immutability"},{"id":"spn-35789","text":": avoid “editing deployments in place”; use status transitions and active pointer. 4. "},{"id":"spn-35790","marks":["bold"],"text":"Error normalization"},{"id":"spn-35791","text":": keep provider errors internal; map to stable codes."}]},{"id":"blk-31628","kind":"paragraph","spans":[{"id":"spn-35792","text":"---"}]},{"id":"blk-31629","kind":"heading","level":2,"spans":[{"id":"spn-35793","text":"Appendix B) If the codebase already exists: recommended realignment sequence"}]},{"id":"blk-31630","kind":"paragraph","spans":[{"id":"spn-35794","text":"1. Lock down identity + tenancy checks (stop data leaks first). 2. Normalize errors across endpoints. 3. Enforce secrets handling and redact logs. 4. Make deployments immutable + active pointer. 5. Ensure telemetry is authenticated and attributable. 6. Add billing usage aggregation + limit enforcement. 7. Finish provider conformance tests and acceptance suite."}]}],"edges":[],"id":"bagaaieraqj7wml2kj6gt36whcm2qtft4arazmryqi6bqgiwq7xmazdq62w7q","vocabulary":"ampersand.docs.fs.v1"}