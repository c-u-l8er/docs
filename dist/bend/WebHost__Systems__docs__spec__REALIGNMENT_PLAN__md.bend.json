cks":[{"id":"blk-32094","kind":"paragraph","spans":[{"id":"spn-36886","text":"[ ] Invoke golden path:"}]}],"id":"blk-32093","kind":"list-item"},{"blocks":[{"id":"blk-32096","kind":"paragraph","spans":[{"id":"spn-36887","text":"invoke → response → telemetry event accepted and attributed"}]}],"id":"blk-32095","kind":"list-item"},{"blocks":[{"id":"blk-32098","kind":"paragraph","spans":[{"id":"spn-36888","text":"[ ] Limits tests:"}]}],"id":"blk-32097","kind":"list-item"},{"blocks":[{"id":"blk-32100","kind":"paragraph","spans":[{"id":"spn-36889","text":"exceed requests/tokens/computeMs and verify hard-stop behavior"}]}],"id":"blk-32099","kind":"list-item"},{"blocks":[{"id":"blk-32102","kind":"paragraph","spans":[{"id":"spn-36890","text":"[ ] Secrets tests:"}]}],"id":"blk-32101","kind":"list-item"},{"blocks":[{"id":"blk-32104","kind":"paragraph","spans":[{"id":"spn-36891","text":"ensure no plaintext secrets in DB fields and logs"}]}],"id":"blk-32103","kind":"list-item"},{"blocks":[{"id":"blk-32106","kind":"paragraph","spans":[{"id":"spn-36892","text":"telemetry signature verification works"}]}],"id":"blk-32105","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32107","kind":"paragraph","spans":[{"id":"spn-36893","text":"Done when:"}]},{"id":"blk-32108","items":[{"blocks":[{"id":"blk-32110","kind":"paragraph","spans":[{"id":"spn-36894","text":"You can demonstrate the v1 acceptance criteria from "},{"id":"spn-36895","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-36896","text":" end-to-end on Cloudflare, and (if enabled) on AgentCore for a paid tier."}]}],"id":"blk-32109","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32111","kind":"paragraph","spans":[{"id":"spn-36897","text":"---"}]},{"id":"blk-32112","kind":"heading","level":2,"spans":[{"id":"spn-36898","text":"Appendix A) Known spec-sensitive integration points (watch these)"}]},{"id":"blk-32113","kind":"paragraph","spans":[{"id":"spn-36899","text":"1. "},{"id":"spn-36900","marks":["bold"],"text":"Telemetry secret verification"},{"id":"spn-36901","text":": must be implementable without storing plaintext secrets in DB. 2. "},{"id":"spn-36902","marks":["bold"],"text":"Delegated invocation"},{"id":"spn-36903","text":": must bill/enforce as the delegated user, never as the caller service. 3. "},{"id":"spn-36904","marks":["bold"],"text":"Deployment immutability"},{"id":"spn-36905","text":": avoid “editing deployments in place”; use status transitions and active pointer. 4. "},{"id":"spn-36906","marks":["bold"],"text":"Error normalization"},{"id":"spn-36907","text":": keep provider errors internal; map to stable codes."}]},{"id":"blk-32114","kind":"paragraph","spans":[{"id":"spn-36908","text":"---"}]},{"id":"blk-32115","kind":"heading","level":2,"spans":[{"id":"spn-36909","text":"Appendix B) If the codebase already exists: recommended realignment sequence"}]},{"id":"blk-32116","kind":"paragraph","spans":[{"id":"spn-36910","text":"1. Lock down identity + tenancy checks (stop data leaks first). 2. Normalize errors across endpoints. 3. Enforce secrets handling and redact logs. 4. Make deployments immutable + active pointer. 5. Ensure telemetry is authenticated and attributable. 6. Add billing usage aggregation + limit enforcement. 7. Finish provider conformance tests and acceptance suite."}]}],"edges":[],"id":"bagaaieraixyt7hopwk24fbal4bhmk3uaz5zav3dzd5nloqgraitt5upevwea","vocabulary":"ampersand.docs.fs.v1"}