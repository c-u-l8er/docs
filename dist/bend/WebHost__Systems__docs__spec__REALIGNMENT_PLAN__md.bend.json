ragraph","spans":[{"id":"spn-35517","text":"[ ] Data plane executes customer agent code; control plane never does."}]}],"id":"blk-31355","kind":"list-item"},{"blocks":[{"id":"blk-31358","kind":"paragraph","spans":[{"id":"spn-35518","text":"[ ] Control plane stores metadata/config and orchestrates deploy/invoke/billing only."}]}],"id":"blk-31357","kind":"list-item"},{"blocks":[{"id":"blk-31360","kind":"paragraph","spans":[{"id":"spn-35519","text":"[ ] No control-plane endpoint directly runs untrusted bundles."}]}],"id":"blk-31359","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31361","kind":"paragraph","spans":[{"id":"spn-35520","text":"Done when:"}]},{"id":"blk-31362","items":[{"blocks":[{"id":"blk-31364","kind":"paragraph","spans":[{"id":"spn-35521","text":"A code review can point to one “data plane entrypoint contract” per provider and confirm control-plane code does not execute customer code."}]}],"id":"blk-31363","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31365","kind":"paragraph","spans":[{"id":"spn-35522","text":"---"}]},{"id":"blk-31366","kind":"heading","level":2,"spans":[{"id":"spn-35523","text":"2) Identity model and tenancy (user-scoped v1)"}]},{"id":"blk-31367","kind":"paragraph","spans":[{"id":"spn-35524","marks":["bold"],"text":"Spec sources:"},{"id":"spn-35525","text":" "},{"id":"spn-35526","marks":["code"],"text":"30_DATA_MODEL_CONVEX.md"},{"id":"spn-35527","text":", "},{"id":"spn-35528","marks":["code"],"text":"10_API_CONTRACTS.md"}]},{"id":"blk-31368","kind":"paragraph","spans":[{"id":"spn-35529","text":"Checklist:"}]},{"id":"blk-31369","items":[{"blocks":[{"id":"blk-31371","kind":"paragraph","spans":[{"id":"spn-35530","text":"[ ] One canonical mapping from auth provider identity → internal "},{"id":"spn-35531","marks":["code"],"text":"users"},{"id":"spn-35532","text":" row."}]}],"id":"blk-31370","kind":"list-item"},{"blocks":[{"id":"blk-31373","kind":"paragraph","spans":[{"id":"spn-35533","text":"[ ] Every control plane query/mutation is scoped to authenticated user."}]}],"id":"blk-31372","kind":"list-item"},{"blocks":[{"id":"blk-31375","kind":"paragraph","spans":[{"id":"spn-35534","text":"[ ] All “get by id” endpoints verify ownership/membership before returning data."}]}],"id":"blk-31374","kind":"list-item"},{"blocks":[{"id":"blk-31377","kind":"paragraph","spans":[{"id":"spn-35535","text":"[ ] Cross-tenant IDs do not leak existence (recommended: "},{"id":"spn-35536","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-35537","text":" for foreign ids, consistently applied)."}]}],"id":"blk-31376","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31378","kind":"paragraph","spans":[{"id":"spn-35538","text":"Done when:"}]},{"id":"blk-31379","items":[{"blocks":[{"id":"blk-31381","kind":"paragraph","spans":[{"id":"spn-35539","text":"You have an automated “IDOR suite” that tries random IDs from other users and always gets safe failures."}]}],"id":"blk-31380","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31382","kind":"paragraph","spans":[{"id":"spn-35540","text":"---"}]},{"id":"blk-31383","kind":"heading","level":2,"spans":[{"id":"spn-35541","text":"3) Normalized errors: one envelope, stable codes"}]},{"id":"blk-31384","kind":"paragraph","spans":[{"id":"spn-35542","marks":["bold"],"text":"Spec sources:"},{"id":"spn-35543","text":" "},{"id":"spn-35544","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-35545","text":" (Normalized errors REQUIRED)"}]},{"id":"blk-31385","kind":"paragraph","spans":[{"id":"spn-35546","text":"Checklist:"}]},{"id":"blk-31386","items":[{"blocks":[{"id":"blk-31388","kind":"paragraph","spans":[{"id":"spn-35547","text":"[ ] All API responses use the normalized error envelope."}]}],"id":"blk-31387","kind":"list-item"},{"blocks":[{"id":"blk-31390","kind":"paragraph","spans":[{"id":"spn-35548","text":"[ ] Error "},{"id":"spn-35549","marks":["code"],"text":"code"},{"id":"spn-35550","text":" values are stable and used across the 