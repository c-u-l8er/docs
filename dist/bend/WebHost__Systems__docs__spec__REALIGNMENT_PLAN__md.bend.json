:[{"id":"spn-79477","text":"[ ] "},{"id":"spn-79478","marks":["code"],"text":"agents"},{"id":"spn-79479","text":" exists and is indexed by "},{"id":"spn-79480","marks":["code"],"text":"userId"},{"id":"spn-79481","text":" (+ optional "},{"id":"spn-79482","marks":["code"],"text":"userId+name"},{"id":"spn-79483","text":" uniqueness)."}]}],"id":"blk-50797","kind":"list-item"},{"blocks":[{"id":"blk-50800","kind":"paragraph","spans":[{"id":"spn-79484","text":"[ ] "},{"id":"spn-79485","marks":["code"],"text":"deployments"},{"id":"spn-79486","text":" exists with immutable history and "},{"id":"spn-79487","marks":["code"],"text":"agentId+version"},{"id":"spn-79488","text":" monotonic enforcement."}]}],"id":"blk-50799","kind":"list-item"},{"blocks":[{"id":"blk-50802","kind":"paragraph","spans":[{"id":"spn-79489","text":"[ ] "},{"id":"spn-79490","marks":["code"],"text":"metrics"},{"id":"spn-79491","text":" raw telemetry exists and can store per-invocation events."}]}],"id":"blk-50801","kind":"list-item"},{"blocks":[{"id":"blk-50804","kind":"paragraph","spans":[{"id":"spn-79492","text":"[ ] "},{"id":"spn-79493","marks":["code"],"text":"billingUsage"},{"id":"spn-79494","text":" aggregates exist per user+period."}]}],"id":"blk-50803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50805","kind":"heading","level":3,"spans":[{"id":"spn-79495","text":"4.2 Required invariants"}]},{"id":"blk-50806","kind":"paragraph","spans":[{"id":"spn-79496","text":"Checklist:"}]},{"id":"blk-50807","items":[{"blocks":[{"id":"blk-50809","kind":"paragraph","spans":[{"id":"spn-79497","text":"[ ] "},{"id":"spn-79498","marks":["code"],"text":"agents.activeDeploymentId"},{"id":"spn-79499","text":" always points to a deployment for that agent (or null)."}]}],"id":"blk-50808","kind":"list-item"},{"blocks":[{"id":"blk-50811","kind":"paragraph","spans":[{"id":"spn-79500","text":"[ ] Deployments are immutable except allowed status/error/providerRef transitions."}]}],"id":"blk-50810","kind":"list-item"},{"blocks":[{"id":"blk-50813","kind":"paragraph","spans":[{"id":"spn-79501","text":"[ ] No plaintext secrets are stored in DB fields (see §6)."}]}],"id":"blk-50812","kind":"list-item"},{"blocks":[{"id":"blk-50815","kind":"paragraph","spans":[{"id":"spn-79502","text":"[ ] Indices exist for:"}]}],"id":"blk-50814","kind":"list-item"},{"blocks":[{"id":"blk-50817","kind":"paragraph","spans":[{"id":"spn-79503","text":"agents by user"}]}],"id":"blk-50816","kind":"list-item"},{"blocks":[{"id":"blk-50819","kind":"paragraph","spans":[{"id":"spn-79504","text":"deployments by agent"}]}],"id":"blk-50818","kind":"list-item"},{"blocks":[{"id":"blk-50821","kind":"paragraph","spans":[{"id":"spn-79505","text":"metrics by agent/time and user/time"}]}],"id":"blk-50820","kind":"list-item"},{"blocks":[{"id":"blk-50823","kind":"paragraph","spans":[{"id":"spn-79506","text":"billingUsage by user/period"}]}],"id":"blk-50822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50824","kind":"paragraph","spans":[{"id":"spn-79507","text":"Done when:"}]},{"id":"blk-50825","items":[{"blocks":[{"id":"blk-50827","kind":"paragraph","spans":[{"id":"spn-79508","text":"You can run a “schema audit script” (or manual check) verifying fields and indexes match the spec’s semantics."}]}],"id":"blk-50826","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50828","kind":"heading","level":2,"spans":[{"id":"spn-79509","text":"5) API surface realignment (HTTP contracts)"}]},{"id":"blk-50829","kind":"paragraph","spans":[{"id":"spn-79510","marks":["bold"],"text":"Spec sources:"},{"id":"spn-79511","text":" "},{"id":"spn-79512","marks":["code"],"text":"10_API_CONTRACTS.md"}]},{"id":"blk-50830","kind":"heading","level":3,"spans":[{"id":"spn-79513","text":"5.1 Control plane endpoints"}]},{"id":"blk-50831","kind":"paragraph","spans":[{"id":"spn-79514","text":"Checklist:"}]},{"id":"blk-50832","items":[{"blocks":[{"id":"blk-50834","kind":"paragraph","spans":[{"id":"spn-79515","text":"[ ] Age