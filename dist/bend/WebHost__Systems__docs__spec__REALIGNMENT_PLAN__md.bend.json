ol plane query/mutation is scoped to authenticated user."}]}],"id":"blk-30887","kind":"list-item"},{"blocks":[{"id":"blk-30890","kind":"paragraph","spans":[{"id":"spn-34361","text":"[ ] All “get by id” endpoints verify ownership/membership before returning data."}]}],"id":"blk-30889","kind":"list-item"},{"blocks":[{"id":"blk-30892","kind":"paragraph","spans":[{"id":"spn-34362","text":"[ ] Cross-tenant IDs do not leak existence (recommended: "},{"id":"spn-34363","marks":["code"],"text":"NOT_FOUND"},{"id":"spn-34364","text":" for foreign ids, consistently applied)."}]}],"id":"blk-30891","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30893","kind":"paragraph","spans":[{"id":"spn-34365","text":"Done when:"}]},{"id":"blk-30894","items":[{"blocks":[{"id":"blk-30896","kind":"paragraph","spans":[{"id":"spn-34366","text":"You have an automated “IDOR suite” that tries random IDs from other users and always gets safe failures."}]}],"id":"blk-30895","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-30897","kind":"paragraph","spans":[{"id":"spn-34367","text":"---"}]},{"id":"blk-30898","kind":"heading","level":2,"spans":[{"id":"spn-34368","text":"3) Normalized errors: one envelope, stable codes"}]},{"id":"blk-30899","kind":"paragraph","spans":[{"id":"spn-34369","marks":["bold"],"text":"Spec sources:"},{"id":"spn-34370","text":" "},{"id":"spn-34371","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-34372","text":" (Normalized errors REQUIRED)"}]},{"id":"blk-30900","kind":"paragraph","spans":[{"id":"spn-34373","text":"Checklist:"}]},{"id":"blk-30901","items":[{"blocks":[{"id":"blk-30903","kind":"paragraph","spans":[{"id":"spn-34374","text":"[ ] All API responses use the normalized error envelope."}]}],"id":"blk-30902","kind":"list-item"},{"blocks":[{"id":"blk-30905","kind":"paragraph","spans":[{"id":"spn-34375","text":"[ ] Error "},{"id":"spn-34376","marks":["code"],"text":"code"},{"id":"spn-34377","text":" values are stable and used across the 