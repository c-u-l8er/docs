cks":[{"id":"blk-31013","kind":"paragraph","spans":[{"id":"spn-33968","text":"[ ] Invoke golden path:"}]}],"id":"blk-31012","kind":"list-item"},{"blocks":[{"id":"blk-31015","kind":"paragraph","spans":[{"id":"spn-33969","text":"invoke → response → telemetry event accepted and attributed"}]}],"id":"blk-31014","kind":"list-item"},{"blocks":[{"id":"blk-31017","kind":"paragraph","spans":[{"id":"spn-33970","text":"[ ] Limits tests:"}]}],"id":"blk-31016","kind":"list-item"},{"blocks":[{"id":"blk-31019","kind":"paragraph","spans":[{"id":"spn-33971","text":"exceed requests/tokens/computeMs and verify hard-stop behavior"}]}],"id":"blk-31018","kind":"list-item"},{"blocks":[{"id":"blk-31021","kind":"paragraph","spans":[{"id":"spn-33972","text":"[ ] Secrets tests:"}]}],"id":"blk-31020","kind":"list-item"},{"blocks":[{"id":"blk-31023","kind":"paragraph","spans":[{"id":"spn-33973","text":"ensure no plaintext secrets in DB fields and logs"}]}],"id":"blk-31022","kind":"list-item"},{"blocks":[{"id":"blk-31025","kind":"paragraph","spans":[{"id":"spn-33974","text":"telemetry signature verification works"}]}],"id":"blk-31024","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31026","kind":"paragraph","spans":[{"id":"spn-33975","text":"Done when:"}]},{"id":"blk-31027","items":[{"blocks":[{"id":"blk-31029","kind":"paragraph","spans":[{"id":"spn-33976","text":"You can demonstrate the v1 acceptance criteria from "},{"id":"spn-33977","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-33978","text":" end-to-end on Cloudflare, and (if enabled) on AgentCore for a paid tier."}]}],"id":"blk-31028","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31030","kind":"paragraph","spans":[{"id":"spn-33979","text":"---"}]},{"id":"blk-31031","kind":"heading","level":2,"spans":[{"id":"spn-33980","text":"Appendix A) Known spec-sensitive integration points (watch these)"}]},{"id":"blk-31032","kind":"paragraph","spans":[{"id":"spn-33981","text":"1. "},{"id":"spn-33982","marks":["bold"],"text":"Telemetry secret verification"},{"id":"spn-33983","text":": must be implementable without storing plaintext secrets in DB. 2. "},{"id":"spn-33984","marks":["bold"],"text":"Delegated invocation"},{"id":"spn-33985","text":": must bill/enforce as the delegated user, never as the caller service. 3. "},{"id":"spn-33986","marks":["bold"],"text":"Deployment immutability"},{"id":"spn-33987","text":": avoid “editing deployments in place”; use status transitions and active pointer. 4. "},{"id":"spn-33988","marks":["bold"],"text":"Error normalization"},{"id":"spn-33989","text":": keep provider errors internal; map to stable codes."}]},{"id":"blk-31033","kind":"paragraph","spans":[{"id":"spn-33990","text":"---"}]},{"id":"blk-31034","kind":"heading","level":2,"spans":[{"id":"spn-33991","text":"Appendix B) If the codebase already exists: recommended realignment sequence"}]},{"id":"blk-31035","kind":"paragraph","spans":[{"id":"spn-33992","text":"1. Lock down identity + tenancy checks (stop data leaks first). 2. Normalize errors across endpoints. 3. Enforce secrets handling and redact logs. 4. Make deployments immutable + active pointer. 5. Ensure telemetry is authenticated and attributable. 6. Add billing usage aggregation + limit enforcement. 7. Finish provider conformance tests and acceptance suite."}]}],"edges":[],"id":"bagaaieraaar3fvtcpwwnk5se4autposjd26ugeyeghywvs5gawrrpakcdrnq","vocabulary":"ampersand.docs.fs.v1"}