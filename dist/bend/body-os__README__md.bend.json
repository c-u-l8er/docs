{"bendscript":"0.1","blocks":[{"id":"blk-57626","kind":"heading","level":1,"spans":[{"id":"spn-84959","text":"body-os"}]},{"id":"blk-57627","kind":"paragraph","spans":[{"id":"spn-84960","text":"OS-011 "},{"id":"spn-84961","marks":["code"],"text":"&body.os"},{"id":"spn-84962","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-57628","kind":"paragraph","spans":[{"id":"spn-84963","text":"Typed perception of the host OS (cwd, env, filesystem snapshot, process list), typed action execution with destructive-edge authorization, StateHash-anchored replay, InteractionTrace recording — the OS-subtype counterpart to "},{"id":"spn-84964","marks":["code"],"text":"body-browser"},{"id":"spn-84965","text":", completing the "},{"id":"spn-84966","marks":["code"],"text":"&body.*"},{"id":"spn-84967","text":" primitive family."}]},{"id":"blk-57629","kind":"heading","level":2,"spans":[{"id":"spn-84968","text":"Status"}]},{"id":"blk-57630","items":[{"blocks":[{"id":"blk-57632","kind":"paragraph","spans":[{"id":"spn-84969","marks":["bold"],"text":"Library:"},{"id":"spn-84970","text":" production-ready"}]}],"id":"blk-57631","kind":"list-item"},{"blocks":[{"id":"blk-57634","kind":"paragraph","spans":[{"id":"spn-84971","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-84972","text":" 12/12 OS-011 §9 conformance tests pass"}]}],"id":"blk-57633","kind":"list-item"},{"blocks":[{"id":"blk-57636","kind":"paragraph","spans":[{"id":"spn-84973","marks":["bold"],"text":"MCP server:"},{"id":"spn-84974","text":" shipped — 7 tools on the "},{"id":"spn-84975","marks":["code"],"text":"body-os"},{"id":"spn-84976","text":" namespace (ensure_session + 6 OS-011 operations), 12 MCP unit tests covering the destructive-action authorization gate"}]}],"id":"blk-57635","kind":"list-item"},{"blocks":[{"id":"blk-57638","kind":"paragraph","spans":[{"id":"spn-84977","marks":["bold"],"text":"ComputerUse backend (Claude Computer Use / OpenClaw):"},{"id":"spn-84978","text":" skeleton — subprocess wiring pending"}]}],"id":"blk-57637","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57639","kind":"heading","level":2,"spans":[{"id":"spn-84979","text":"MCP surface"}]},{"id":"blk-57640","kind":"code","language":"text","text":"body_os_ensure_session  — create or re-bind a session by id\nbody_os_perceive        — typed OS observation (cwd, env, fs, processes)\nbody_os_affordances     — policy-filtered AffordanceSet\nbody_os_encode_state    — deterministic StateHash\nbody_os_act             — execute one TypedAction (destructive ones need auth)\nbody_os_dry_run         — predicted outcome (no mutation)\nbody_os_replay          — fail-fast replay with destructive re-authorization"},{"id":"blk-57641","kind":"paragraph","spans":[{"id":"spn-84980","text":"Every tool takes a "},{"id":"spn-84981","marks":["code"],"text":"session_id"},{"id":"spn-84982","text":" so multiple agents can drive independent host sessions concurrently. Sessions are supervised under "},{"id":"spn-84983","marks":["code"],"text":"BodyOs.SessionSupervisor"},{"id":"spn-84984","text":" and addressed through the "},{"id":"spn-84985","marks":["code"],"text":"BodyOs.SessionRegistry"},{"id":"spn-84986","text":"."}]},{"id":"blk-57642","kind":"paragraph","spans":[{"id":"spn-84987","marks":["bold"],"text":"Safety:"},{"id":"spn-84988","text":" the destructive-action authorization gate at the Session boundary is necessary but not sufficient. For a real "},{"id":"spn-84989","marks":["code"],"text":"ComputerUse"},{"id":"spn-84990","text":" backend, combine it with a sandboxed execution environment (containers, jails, restricted filesystems). The two are complementary, not redundant."}]},{"id":"blk-57643","kind":"heading","level":2,"spans":[{"id":"spn-84991","text":"The contract (OS-011 §11)"}]},{"id":"blk-57644","kind":"paragraph","spans":[{"id":"spn-84992","text":"Identical six-operation surface as "},{"id":"spn-84993","marks":["code"],"text":"body-browser"},{"id":"spn-84994","text":", but with the OS action set:"}]},{"head":[{"id":"blk-57646","spans":[{"id":"spn-84995","text":"operation"}]},{"id":"blk-57647","spans":[{"id":"spn-84996","text":"input"}]},{"id":"blk-57648","spans":[{"id":"spn-84997","text":"output"}]},{"id":"blk-57649","spans":[{"id":"spn-84998","text":"deterministic"}]}],"id":"blk-57645","kind":"table","rows":[[{"id":"blk-57650","spans":[{"id":"spn-84999","marks":["code"],"text":"perceive"}]},{"id":"blk-57651","spans":[{"id":"spn-85000","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57652","spans":[{"id":"spn-85001","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-57653","spans":[{"id":"spn-85002","text":"✅"}]}],[{"id":"blk-57654","spans":[{"id":"spn-85003","marks":["code"],"text":"affordances"}]},{"id":"blk-57655","spans":[{"id":"spn-85004","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-57656","spans":[{"id":"spn-85005","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-57657","spans":[{"id":"spn-85006","text":"✅"}]}],[{"id":"blk-57658","spans":[{"id":"spn-85007","marks":["code"],"text":"encode_state"}]},{"id":"blk-57659","spans":[{"id":"spn-85008","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57660","spans":[{"id":"spn-85009","marks":["code"],"text":"StateHash"}]},{"id":"blk-57661","spans":[{"id":"spn-85010","text":"✅"}]}],[{"id":"blk-57662","spans":[{"id":"spn-85011","marks":["code"],"text":"act"}]},{"id":"blk-57663","spans":[{"id":"spn-85012","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57664","spans":[{"id":"spn-85013","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-57665","spans":[{"id":"spn-85014","text":"❌ side-effecting"}]}],[{"id":"blk-57666","spans":[{"id":"spn-85015","marks":["code"],"text":"replay"}]},{"id":"blk-57667","spans":[{"id":"spn-85016","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-57668","spans":[{"id":"spn-85017","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-57669","spans":[{"id":"spn-85018","text":"❌ side-effecting"}]}],[{"id":"blk-57670","spans":[{"id":"spn-85019","marks":["code"],"text":"dry_run"}]},{"id":"blk-57671","spans":[{"id":"spn-85020","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57672","spans":[{"id":"spn-85021","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-57673","spans":[{"id":"spn-85022","text":"✅"}]}]]},{"id":"blk-57674","kind":"heading","level":2,"spans":[{"id":"spn-85023","text":"OS action types (OS-011 v0.1, 11 types)"}]},{"id":"blk-57675","kind":"code","language":"text","text":"shell_exec  file_read  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nscreen_capture  process_spawn  process_signal"},{"id":"blk-57676","kind":"paragraph","spans":[{"id":"spn-85024","marks":["bold"],"text":"Destructive subset"},{"id":"spn-85025","text":" (require "},{"id":"spn-85026","marks":["code"],"text":"authorization"},{"id":"spn-85027","text":" block, fresh per replay):"}]},{"id":"blk-57677","kind":"code","language":"text","text":"shell_exec  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nprocess_spawn  process_signal"},{"id":"blk-57678","kind":"paragraph","spans":[{"id":"spn-85028","text":"Only "},{"id":"spn-85029","marks":["code"],"text":"file_read"},{"id":"spn-85030","text":" and "},{"id":"spn-85031","marks":["code"],"text":"screen_capture"},{"id":"spn-85032","text":" are strictly read-only."}]},{"id":"blk-57679","kind":"heading","level":2,"spans":[{"id":"spn-85033","text":"StateHash stable fields"}]},{"id":"blk-57680","kind":"code","language":"text","text":"sha256(canonical_json({cwd, env_summary, fs_snapshot_hash, process_list_hash}))"},{"id":"blk-57681","items":[{"blocks":[{"id":"blk-57683","kind":"paragraph","spans":[{"id":"spn-85034","marks":["code"],"text":"fs_snapshot_hash"},{"id":"spn-85035","text":" hashes each entry's "},{"id":"spn-85036","marks":["code"],"text":"{path, kind, size, permissions, content_hash}"},{"id":"spn-85037","text":" — fresh refs dropped."}]}],"id":"blk-57682","kind":"list-item"},{"blocks":[{"id":"blk-57685","kind":"paragraph","spans":[{"id":"spn-85038","marks":["code"],"text":"process_list_hash"},{"id":"spn-85039","text":" hashes each entry's "},{"id":"spn-85040","marks":["code"],"text":"{command, state}"},{"id":"spn-85041","text":" — raw pids dropped."}]}],"id":"blk-57684","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57686","kind":"heading","level":2,"spans":[{"id":"spn-85042","text":"Five invariants (all enforced by "},{"id":"spn-85043","marks":["code"],"text":"BodyOs.Session"},{"id":"spn-85044","text":")"}]},{"head":[{"id":"blk-57688","spans":[{"id":"spn-85045","text":"#"}]},{"id":"blk-57689","spans":[{"id":"spn-85046","text":"invariant"}]},{"id":"blk-57690","spans":[{"id":"spn-85047","text":"where"}]}],"id":"blk-57687","kind":"table","rows":[[{"id":"blk-57691","spans":[{"id":"spn-85048","text":"I1"}]},{"id":"blk-57692","spans":[{"id":"spn-85049","text":"perceive-before-act"}]},{"id":"blk-57693","spans":[{"id":"spn-85050","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-57694","spans":[{"id":"spn-85051","text":"I2"}]},{"id":"blk-57695","spans":[{"id":"spn-85052","text":"affordance-bounded action"}]},{"id":"blk-57696","spans":[{"id":"spn-85053","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-57697","spans":[{"id":"spn-85054","text":"I3"}]},{"id":"blk-57698","spans":[{"id":"spn-85055","text":"policy-filtered affordances"}]},{"id":"blk-57699","spans":[{"id":"spn-85056","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-57700","spans":[{"id":"spn-85057","text":"I4"}]},{"id":"blk-57701","spans":[{"id":"spn-85058","text":"deterministic state encoding"}]},{"id":"blk-57702","spans":[{"id":"spn-85059","marks":["code"],"text":"BodyOs.StateHash.of/1"}]}],[{"id":"blk-57703","spans":[{"id":"spn-85060","text":"I5"}]},{"id":"blk-57704","spans":[{"id":"spn-85061","text":"replay fail-fast + destructive re-auth"}]},{"id":"blk-57705","spans":[{"id":"spn-85062","marks":["code"],"text":"BodyOs.Replay.execute/3"}]}]]},{"id":"blk-57706","kind":"heading","level":2,"spans":[{"id":"spn-85063","text":"Quick start"}]},{"id":"blk-57707","kind":"code","language":"elixir","text":"alias BodyOs.Backend.Simulator\nalias BodyOs.Backend.Simulator.{FsNode, Proc}\nalias BodyOs.Session\n\nfs = %{\n  \"/home/user/hello.txt\" => %FsNode{kind: \"file\", size: 5, content: \"hello\"}\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator,\n    cwd: \"/home/user\",\n    fs: fs,\n    processes: %{},\n    env: %{\"USER\" => \"user\"}\n  },\n  agent_id: \"demo\",\n  provider: \"body-os-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n# Destructive action REQUIRES authorization block.\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"file_delete\",\n  \"target\" => \"@fs1/g1\",\n  \"authorization\" => %{\n    \"policy_id\" => \"delegatic://my-workspace/ops\",\n    \"approved_by\" => \"supervisor@co\",\n    \"approved_at\" => DateTime.utc_now() |> DateTime.to_iso8601(),\n    \"authorization_token\" => \"sha256:...\"\n  }\n})"},{"id":"blk-57708","kind":"heading","level":2,"spans":[{"id":"spn-85064","text":"Wiring to Graphonomous"}]},{"id":"blk-57709","kind":"paragraph","spans":[{"id":"spn-85065","text":"Every recorded trace carries "},{"id":"spn-85066","marks":["code"],"text":"provenance.capability == \"&body.os\""},{"id":"spn-85067","text":". Submit via Graphonomous's "},{"id":"spn-85068","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-85069","text":"; retrieve for replay via "},{"id":"spn-85070","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-85071","text":"."}]},{"id":"blk-57710","kind":"heading","level":2,"spans":[{"id":"spn-85072","text":"Running the conformance suite"}]},{"id":"blk-57711","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-57712","kind":"paragraph","spans":[{"id":"spn-85073","text":"Twelve tests, 1:1 with OS-011 §9. A real-host backend (Claude Computer Use, OpenClaw, …) must pass the same suite to claim OS-011 conformance for the "},{"id":"spn-85074","marks":["code"],"text":"os"},{"id":"spn-85075","text":" subtype."}]},{"id":"blk-57713","kind":"heading","level":2,"spans":[{"id":"spn-85076","text":"Safety note"}]},{"id":"blk-57714","kind":"paragraph","spans":[{"id":"spn-85077","text":"The "},{"id":"spn-85078","marks":["code"],"text":"ComputerUse"},{"id":"spn-85079","text":" backend (when wired) will execute real shell commands, real file writes, and real process signals on the host. Sandbox strongly (containers, jails, restricted filesystems) AND rely on the "},{"id":"spn-85080","marks":["code"],"text":"authorization"},{"id":"spn-85081","text":" block gate — the two are complementary, not redundant."}]},{"id":"blk-57715","kind":"heading","level":2,"spans":[{"id":"spn-85082","text":"References"}]},{"id":"blk-57716","items":[{"blocks":[{"id":"blk-57718","kind":"paragraph","spans":[{"id":"spn-85083","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-85084","text":" — normative spec"}]}],"id":"blk-57717","kind":"list-item"},{"blocks":[{"id":"blk-57720","kind":"paragraph","spans":[{"id":"spn-85085","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.os.md"},{"id":"spn-85086","text":" — registry entry"}]}],"id":"blk-57719","kind":"list-item"},{"blocks":[{"id":"blk-57722","kind":"paragraph","spans":[{"id":"spn-85087","marks":["code"],"text":"PULSE/manifests/body-os.embodiment.json"},{"id":"spn-85088","text":" — loop manifest"}]}],"id":"blk-57721","kind":"list-item"},{"blocks":[{"id":"blk-57724","kind":"paragraph","spans":[{"id":"spn-85089","text":"Sibling: "},{"id":"spn-85090","marks":["code"],"text":"body-browser/"},{"id":"spn-85091","text":" — "},{"id":"spn-85092","marks":["code"],"text":"&body.browser"},{"id":"spn-85093","text":" reference implementation"}]}],"id":"blk-57723","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57725","kind":"heading","level":2,"spans":[{"id":"spn-85094","text":"License"}]},{"id":"blk-57726","kind":"paragraph","spans":[{"id":"spn-85095","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaierajingx22ydk2uzspc5ypvh4wgp32qtnv42gja4p6aidw6wz5dc2qq","vocabulary":"ampersand.docs.fs.v1"}