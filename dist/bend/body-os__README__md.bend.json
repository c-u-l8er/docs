{"bendscript":"0.1","blocks":[{"id":"blk-55682","kind":"heading","level":1,"spans":[{"id":"spn-106986","text":"body-os"}]},{"id":"blk-55683","kind":"paragraph","spans":[{"id":"spn-106987","text":"GRASP "},{"id":"spn-106988","marks":["code"],"text":"&body.os"},{"id":"spn-106989","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-55684","kind":"paragraph","spans":[{"id":"spn-106990","text":"Typed perception of the host OS (cwd, env, filesystem snapshot, process list), typed action execution with destructive-edge authorization, StateHash-anchored replay, InteractionTrace recording — the OS-subtype counterpart to "},{"id":"spn-106991","marks":["code"],"text":"body-browser"},{"id":"spn-106992","text":", completing the "},{"id":"spn-106993","marks":["code"],"text":"&body.*"},{"id":"spn-106994","text":" primitive family."}]},{"id":"blk-55685","kind":"heading","level":2,"spans":[{"id":"spn-106995","text":"Status"}]},{"id":"blk-55686","items":[{"blocks":[{"id":"blk-55688","kind":"paragraph","spans":[{"id":"spn-106996","marks":["bold"],"text":"Library:"},{"id":"spn-106997","text":" production-ready"}]}],"id":"blk-55687","kind":"list-item"},{"blocks":[{"id":"blk-55690","kind":"paragraph","spans":[{"id":"spn-106998","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-106999","text":" 12/12 GRASP §9 conformance tests pass"}]}],"id":"blk-55689","kind":"list-item"},{"blocks":[{"id":"blk-55692","kind":"paragraph","spans":[{"id":"spn-107000","marks":["bold"],"text":"MCP server:"},{"id":"spn-107001","text":" shipped — 7 tools on the "},{"id":"spn-107002","marks":["code"],"text":"body-os"},{"id":"spn-107003","text":" namespace (ensure_session + 6 GRASP operations), 12 MCP unit tests covering the destructive-action authorization gate"}]}],"id":"blk-55691","kind":"list-item"},{"blocks":[{"id":"blk-55694","kind":"paragraph","spans":[{"id":"spn-107004","marks":["bold"],"text":"ComputerUse backend (Claude Computer Use / OpenClaw):"},{"id":"spn-107005","text":" skeleton — subprocess wiring pending"}]}],"id":"blk-55693","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55695","kind":"heading","level":2,"spans":[{"id":"spn-107006","text":"MCP surface"}]},{"id":"blk-55696","kind":"code","language":"text","text":"body_os_ensure_session  — create or re-bind a session by id\nbody_os_perceive        — typed OS observation (cwd, env, fs, processes)\nbody_os_affordances     — policy-filtered AffordanceSet\nbody_os_encode_state    — deterministic StateHash\nbody_os_act             — execute one TypedAction (destructive ones need auth)\nbody_os_dry_run         — predicted outcome (no mutation)\nbody_os_replay          — fail-fast replay with destructive re-authorization"},{"id":"blk-55697","kind":"paragraph","spans":[{"id":"spn-107007","text":"Every tool takes a "},{"id":"spn-107008","marks":["code"],"text":"session_id"},{"id":"spn-107009","text":" so multiple agents can drive independent host sessions concurrently. Sessions are supervised under "},{"id":"spn-107010","marks":["code"],"text":"BodyOs.SessionSupervisor"},{"id":"spn-107011","text":" and addressed through the "},{"id":"spn-107012","marks":["code"],"text":"BodyOs.SessionRegistry"},{"id":"spn-107013","text":"."}]},{"id":"blk-55698","kind":"paragraph","spans":[{"id":"spn-107014","marks":["bold"],"text":"Safety:"},{"id":"spn-107015","text":" the destructive-action authorization gate at the Session boundary is necessary but not sufficient. For a real "},{"id":"spn-107016","marks":["code"],"text":"ComputerUse"},{"id":"spn-107017","text":" backend, combine it with a sandboxed execution environment (containers, jails, restricted filesystems). The two are complementary, not redundant."}]},{"id":"blk-55699","kind":"heading","level":2,"spans":[{"id":"spn-107018","text":"The contract (GRASP §11)"}]},{"id":"blk-55700","kind":"paragraph","spans":[{"id":"spn-107019","text":"Identical six-operation surface as "},{"id":"spn-107020","marks":["code"],"text":"body-browser"},{"id":"spn-107021","text":", but with the OS action set:"}]},{"head":[{"id":"blk-55702","spans":[{"id":"spn-107022","text":"operation"}]},{"id":"blk-55703","spans":[{"id":"spn-107023","text":"input"}]},{"id":"blk-55704","spans":[{"id":"spn-107024","text":"output"}]},{"id":"blk-55705","spans":[{"id":"spn-107025","text":"deterministic"}]}],"id":"blk-55701","kind":"table","rows":[[{"id":"blk-55706","spans":[{"id":"spn-107026","marks":["code"],"text":"perceive"}]},{"id":"blk-55707","spans":[{"id":"spn-107027","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-55708","spans":[{"id":"spn-107028","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-55709","spans":[{"id":"spn-107029","text":"✅"}]}],[{"id":"blk-55710","spans":[{"id":"spn-107030","marks":["code"],"text":"affordances"}]},{"id":"blk-55711","spans":[{"id":"spn-107031","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-55712","spans":[{"id":"spn-107032","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-55713","spans":[{"id":"spn-107033","text":"✅"}]}],[{"id":"blk-55714","spans":[{"id":"spn-107034","marks":["code"],"text":"encode_state"}]},{"id":"blk-55715","spans":[{"id":"spn-107035","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-55716","spans":[{"id":"spn-107036","marks":["code"],"text":"StateHash"}]},{"id":"blk-55717","spans":[{"id":"spn-107037","text":"✅"}]}],[{"id":"blk-55718","spans":[{"id":"spn-107038","marks":["code"],"text":"act"}]},{"id":"blk-55719","spans":[{"id":"spn-107039","marks":["code"],"text":"TypedAction"}]},{"id":"blk-55720","spans":[{"id":"spn-107040","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-55721","spans":[{"id":"spn-107041","text":"❌ side-effecting"}]}],[{"id":"blk-55722","spans":[{"id":"spn-107042","marks":["code"],"text":"replay"}]},{"id":"blk-55723","spans":[{"id":"spn-107043","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-55724","spans":[{"id":"spn-107044","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-55725","spans":[{"id":"spn-107045","text":"❌ side-effecting"}]}],[{"id":"blk-55726","spans":[{"id":"spn-107046","marks":["code"],"text":"dry_run"}]},{"id":"blk-55727","spans":[{"id":"spn-107047","marks":["code"],"text":"TypedAction"}]},{"id":"blk-55728","spans":[{"id":"spn-107048","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-55729","spans":[{"id":"spn-107049","text":"✅"}]}]]},{"id":"blk-55730","kind":"heading","level":2,"spans":[{"id":"spn-107050","text":"OS action types (GRASP v0.1, 11 types)"}]},{"id":"blk-55731","kind":"code","language":"text","text":"shell_exec  file_read  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nscreen_capture  process_spawn  process_signal"},{"id":"blk-55732","kind":"paragraph","spans":[{"id":"spn-107051","marks":["bold"],"text":"Destructive subset"},{"id":"spn-107052","text":" (require "},{"id":"spn-107053","marks":["code"],"text":"authorization"},{"id":"spn-107054","text":" block, fresh per replay):"}]},{"id":"blk-55733","kind":"code","language":"text","text":"shell_exec  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nprocess_spawn  process_signal"},{"id":"blk-55734","kind":"paragraph","spans":[{"id":"spn-107055","text":"Only "},{"id":"spn-107056","marks":["code"],"text":"file_read"},{"id":"spn-107057","text":" and "},{"id":"spn-107058","marks":["code"],"text":"screen_capture"},{"id":"spn-107059","text":" are strictly read-only."}]},{"id":"blk-55735","kind":"heading","level":2,"spans":[{"id":"spn-107060","text":"StateHash stable fields"}]},{"id":"blk-55736","kind":"code","language":"text","text":"sha256(canonical_json({cwd, env_summary, fs_snapshot_hash, process_list_hash}))"},{"id":"blk-55737","items":[{"blocks":[{"id":"blk-55739","kind":"paragraph","spans":[{"id":"spn-107061","marks":["code"],"text":"fs_snapshot_hash"},{"id":"spn-107062","text":" hashes each entry's "},{"id":"spn-107063","marks":["code"],"text":"{path, kind, size, permissions, content_hash}"},{"id":"spn-107064","text":" — fresh refs dropped."}]}],"id":"blk-55738","kind":"list-item"},{"blocks":[{"id":"blk-55741","kind":"paragraph","spans":[{"id":"spn-107065","marks":["code"],"text":"process_list_hash"},{"id":"spn-107066","text":" hashes each entry's "},{"id":"spn-107067","marks":["code"],"text":"{command, state}"},{"id":"spn-107068","text":" — raw pids dropped."}]}],"id":"blk-55740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55742","kind":"heading","level":2,"spans":[{"id":"spn-107069","text":"Five invariants (all enforced by "},{"id":"spn-107070","marks":["code"],"text":"BodyOs.Session"},{"id":"spn-107071","text":")"}]},{"head":[{"id":"blk-55744","spans":[{"id":"spn-107072","text":"#"}]},{"id":"blk-55745","spans":[{"id":"spn-107073","text":"invariant"}]},{"id":"blk-55746","spans":[{"id":"spn-107074","text":"where"}]}],"id":"blk-55743","kind":"table","rows":[[{"id":"blk-55747","spans":[{"id":"spn-107075","text":"I1"}]},{"id":"blk-55748","spans":[{"id":"spn-107076","text":"perceive-before-act"}]},{"id":"blk-55749","spans":[{"id":"spn-107077","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-55750","spans":[{"id":"spn-107078","text":"I2"}]},{"id":"blk-55751","spans":[{"id":"spn-107079","text":"affordance-bounded action"}]},{"id":"blk-55752","spans":[{"id":"spn-107080","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-55753","spans":[{"id":"spn-107081","text":"I3"}]},{"id":"blk-55754","spans":[{"id":"spn-107082","text":"policy-filtered affordances"}]},{"id":"blk-55755","spans":[{"id":"spn-107083","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-55756","spans":[{"id":"spn-107084","text":"I4"}]},{"id":"blk-55757","spans":[{"id":"spn-107085","text":"deterministic state encoding"}]},{"id":"blk-55758","spans":[{"id":"spn-107086","marks":["code"],"text":"BodyOs.StateHash.of/1"}]}],[{"id":"blk-55759","spans":[{"id":"spn-107087","text":"I5"}]},{"id":"blk-55760","spans":[{"id":"spn-107088","text":"replay fail-fast + destructive re-auth"}]},{"id":"blk-55761","spans":[{"id":"spn-107089","marks":["code"],"text":"BodyOs.Replay.execute/3"}]}]]},{"id":"blk-55762","kind":"heading","level":2,"spans":[{"id":"spn-107090","text":"Quick start"}]},{"id":"blk-55763","kind":"code","language":"elixir","text":"alias BodyOs.Backend.Simulator\nalias BodyOs.Backend.Simulator.{FsNode, Proc}\nalias BodyOs.Session\n\nfs = %{\n  \"/home/user/hello.txt\" => %FsNode{kind: \"file\", size: 5, content: \"hello\"}\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator,\n    cwd: \"/home/user\",\n    fs: fs,\n    processes: %{},\n    env: %{\"USER\" => \"user\"}\n  },\n  agent_id: \"demo\",\n  provider: \"body-os-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n# Destructive action REQUIRES authorization block.\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"file_delete\",\n  \"target\" => \"@fs1/g1\",\n  \"authorization\" => %{\n    \"policy_id\" => \"delegatic://my-workspace/ops\",\n    \"approved_by\" => \"supervisor@co\",\n    \"approved_at\" => DateTime.utc_now() |> DateTime.to_iso8601(),\n    \"authorization_token\" => \"sha256:...\"\n  }\n})"},{"id":"blk-55764","kind":"heading","level":2,"spans":[{"id":"spn-107091","text":"Wiring to Graphonomous"}]},{"id":"blk-55765","kind":"paragraph","spans":[{"id":"spn-107092","text":"Every recorded trace carries "},{"id":"spn-107093","marks":["code"],"text":"provenance.capability == \"&body.os\""},{"id":"spn-107094","text":". Submit via Graphonomous's "},{"id":"spn-107095","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-107096","text":"; retrieve for replay via "},{"id":"spn-107097","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-107098","text":"."}]},{"id":"blk-55766","kind":"heading","level":2,"spans":[{"id":"spn-107099","text":"Running the conformance suite"}]},{"id":"blk-55767","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-55768","kind":"paragraph","spans":[{"id":"spn-107100","text":"Twelve tests, 1:1 with GRASP §9. A real-host backend (Claude Computer Use, OpenClaw, …) must pass the same suite to claim GRASP conformance for the "},{"id":"spn-107101","marks":["code"],"text":"os"},{"id":"spn-107102","text":" subtype."}]},{"id":"blk-55769","kind":"heading","level":2,"spans":[{"id":"spn-107103","text":"Safety note"}]},{"id":"blk-55770","kind":"paragraph","spans":[{"id":"spn-107104","text":"The "},{"id":"spn-107105","marks":["code"],"text":"ComputerUse"},{"id":"spn-107106","text":" backend (when wired) will execute real shell commands, real file writes, and real process signals on the host. Sandbox strongly (containers, jails, restricted filesystems) AND rely on the "},{"id":"spn-107107","marks":["code"],"text":"authorization"},{"id":"spn-107108","text":" block gate — the two are complementary, not redundant."}]},{"id":"blk-55771","kind":"heading","level":2,"spans":[{"id":"spn-107109","text":"References"}]},{"id":"blk-55772","items":[{"blocks":[{"id":"blk-55774","kind":"paragraph","spans":[{"id":"spn-107110","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-107111","text":" — normative spec"}]}],"id":"blk-55773","kind":"list-item"},{"blocks":[{"id":"blk-55776","kind":"paragraph","spans":[{"id":"spn-107112","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.os.md"},{"id":"spn-107113","text":" — registry entry"}]}],"id":"blk-55775","kind":"list-item"},{"blocks":[{"id":"blk-55778","kind":"paragraph","spans":[{"id":"spn-107114","marks":["code"],"text":"PULSE/manifests/body-os.embodiment.json"},{"id":"spn-107115","text":" — loop manifest"}]}],"id":"blk-55777","kind":"list-item"},{"blocks":[{"id":"blk-55780","kind":"paragraph","spans":[{"id":"spn-107116","text":"Sibling: "},{"id":"spn-107117","marks":["code"],"text":"body-browser/"},{"id":"spn-107118","text":" — "},{"id":"spn-107119","marks":["code"],"text":"&body.browser"},{"id":"spn-107120","text":" reference implementation"}]}],"id":"blk-55779","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55781","kind":"heading","level":2,"spans":[{"id":"spn-107121","text":"License"}]},{"id":"blk-55782","kind":"paragraph","spans":[{"id":"spn-107122","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaieraparoynf6ts2dp7u5vauo3r7ykmxezx5h6cogah3amar6wwmfdqfa","vocabulary":"ampersand.docs.fs.v1"}