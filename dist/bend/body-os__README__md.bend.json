{"bendscript":"0.1","blocks":[{"id":"blk-57498","kind":"heading","level":1,"spans":[{"id":"spn-84799","text":"body-os"}]},{"id":"blk-57499","kind":"paragraph","spans":[{"id":"spn-84800","text":"OS-011 "},{"id":"spn-84801","marks":["code"],"text":"&body.os"},{"id":"spn-84802","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-57500","kind":"paragraph","spans":[{"id":"spn-84803","text":"Typed perception of the host OS (cwd, env, filesystem snapshot, process list), typed action execution with destructive-edge authorization, StateHash-anchored replay, InteractionTrace recording — the OS-subtype counterpart to "},{"id":"spn-84804","marks":["code"],"text":"body-browser"},{"id":"spn-84805","text":", completing the "},{"id":"spn-84806","marks":["code"],"text":"&body.*"},{"id":"spn-84807","text":" primitive family."}]},{"id":"blk-57501","kind":"heading","level":2,"spans":[{"id":"spn-84808","text":"Status"}]},{"id":"blk-57502","items":[{"blocks":[{"id":"blk-57504","kind":"paragraph","spans":[{"id":"spn-84809","marks":["bold"],"text":"Library:"},{"id":"spn-84810","text":" production-ready"}]}],"id":"blk-57503","kind":"list-item"},{"blocks":[{"id":"blk-57506","kind":"paragraph","spans":[{"id":"spn-84811","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-84812","text":" 12/12 OS-011 §9 conformance tests pass"}]}],"id":"blk-57505","kind":"list-item"},{"blocks":[{"id":"blk-57508","kind":"paragraph","spans":[{"id":"spn-84813","marks":["bold"],"text":"MCP server:"},{"id":"spn-84814","text":" shipped — 7 tools on the "},{"id":"spn-84815","marks":["code"],"text":"body-os"},{"id":"spn-84816","text":" namespace (ensure_session + 6 OS-011 operations), 12 MCP unit tests covering the destructive-action authorization gate"}]}],"id":"blk-57507","kind":"list-item"},{"blocks":[{"id":"blk-57510","kind":"paragraph","spans":[{"id":"spn-84817","marks":["bold"],"text":"ComputerUse backend (Claude Computer Use / OpenClaw):"},{"id":"spn-84818","text":" skeleton — subprocess wiring pending"}]}],"id":"blk-57509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57511","kind":"heading","level":2,"spans":[{"id":"spn-84819","text":"MCP surface"}]},{"id":"blk-57512","kind":"code","language":"text","text":"body_os_ensure_session  — create or re-bind a session by id\nbody_os_perceive        — typed OS observation (cwd, env, fs, processes)\nbody_os_affordances     — policy-filtered AffordanceSet\nbody_os_encode_state    — deterministic StateHash\nbody_os_act             — execute one TypedAction (destructive ones need auth)\nbody_os_dry_run         — predicted outcome (no mutation)\nbody_os_replay          — fail-fast replay with destructive re-authorization"},{"id":"blk-57513","kind":"paragraph","spans":[{"id":"spn-84820","text":"Every tool takes a "},{"id":"spn-84821","marks":["code"],"text":"session_id"},{"id":"spn-84822","text":" so multiple agents can drive independent host sessions concurrently. Sessions are supervised under "},{"id":"spn-84823","marks":["code"],"text":"BodyOs.SessionSupervisor"},{"id":"spn-84824","text":" and addressed through the "},{"id":"spn-84825","marks":["code"],"text":"BodyOs.SessionRegistry"},{"id":"spn-84826","text":"."}]},{"id":"blk-57514","kind":"paragraph","spans":[{"id":"spn-84827","marks":["bold"],"text":"Safety:"},{"id":"spn-84828","text":" the destructive-action authorization gate at the Session boundary is necessary but not sufficient. For a real "},{"id":"spn-84829","marks":["code"],"text":"ComputerUse"},{"id":"spn-84830","text":" backend, combine it with a sandboxed execution environment (containers, jails, restricted filesystems). The two are complementary, not redundant."}]},{"id":"blk-57515","kind":"heading","level":2,"spans":[{"id":"spn-84831","text":"The contract (OS-011 §11)"}]},{"id":"blk-57516","kind":"paragraph","spans":[{"id":"spn-84832","text":"Identical six-operation surface as "},{"id":"spn-84833","marks":["code"],"text":"body-browser"},{"id":"spn-84834","text":", but with the OS action set:"}]},{"head":[{"id":"blk-57518","spans":[{"id":"spn-84835","text":"operation"}]},{"id":"blk-57519","spans":[{"id":"spn-84836","text":"input"}]},{"id":"blk-57520","spans":[{"id":"spn-84837","text":"output"}]},{"id":"blk-57521","spans":[{"id":"spn-84838","text":"deterministic"}]}],"id":"blk-57517","kind":"table","rows":[[{"id":"blk-57522","spans":[{"id":"spn-84839","marks":["code"],"text":"perceive"}]},{"id":"blk-57523","spans":[{"id":"spn-84840","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57524","spans":[{"id":"spn-84841","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-57525","spans":[{"id":"spn-84842","text":"✅"}]}],[{"id":"blk-57526","spans":[{"id":"spn-84843","marks":["code"],"text":"affordances"}]},{"id":"blk-57527","spans":[{"id":"spn-84844","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-57528","spans":[{"id":"spn-84845","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-57529","spans":[{"id":"spn-84846","text":"✅"}]}],[{"id":"blk-57530","spans":[{"id":"spn-84847","marks":["code"],"text":"encode_state"}]},{"id":"blk-57531","spans":[{"id":"spn-84848","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-57532","spans":[{"id":"spn-84849","marks":["code"],"text":"StateHash"}]},{"id":"blk-57533","spans":[{"id":"spn-84850","text":"✅"}]}],[{"id":"blk-57534","spans":[{"id":"spn-84851","marks":["code"],"text":"act"}]},{"id":"blk-57535","spans":[{"id":"spn-84852","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57536","spans":[{"id":"spn-84853","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-57537","spans":[{"id":"spn-84854","text":"❌ side-effecting"}]}],[{"id":"blk-57538","spans":[{"id":"spn-84855","marks":["code"],"text":"replay"}]},{"id":"blk-57539","spans":[{"id":"spn-84856","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-57540","spans":[{"id":"spn-84857","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-57541","spans":[{"id":"spn-84858","text":"❌ side-effecting"}]}],[{"id":"blk-57542","spans":[{"id":"spn-84859","marks":["code"],"text":"dry_run"}]},{"id":"blk-57543","spans":[{"id":"spn-84860","marks":["code"],"text":"TypedAction"}]},{"id":"blk-57544","spans":[{"id":"spn-84861","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-57545","spans":[{"id":"spn-84862","text":"✅"}]}]]},{"id":"blk-57546","kind":"heading","level":2,"spans":[{"id":"spn-84863","text":"OS action types (OS-011 v0.1, 11 types)"}]},{"id":"blk-57547","kind":"code","language":"text","text":"shell_exec  file_read  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nscreen_capture  process_spawn  process_signal"},{"id":"blk-57548","kind":"paragraph","spans":[{"id":"spn-84864","marks":["bold"],"text":"Destructive subset"},{"id":"spn-84865","text":" (require "},{"id":"spn-84866","marks":["code"],"text":"authorization"},{"id":"spn-84867","text":" block, fresh per replay):"}]},{"id":"blk-57549","kind":"code","language":"text","text":"shell_exec  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nprocess_spawn  process_signal"},{"id":"blk-57550","kind":"paragraph","spans":[{"id":"spn-84868","text":"Only "},{"id":"spn-84869","marks":["code"],"text":"file_read"},{"id":"spn-84870","text":" and "},{"id":"spn-84871","marks":["code"],"text":"screen_capture"},{"id":"spn-84872","text":" are strictly read-only."}]},{"id":"blk-57551","kind":"heading","level":2,"spans":[{"id":"spn-84873","text":"StateHash stable fields"}]},{"id":"blk-57552","kind":"code","language":"text","text":"sha256(canonical_json({cwd, env_summary, fs_snapshot_hash, process_list_hash}))"},{"id":"blk-57553","items":[{"blocks":[{"id":"blk-57555","kind":"paragraph","spans":[{"id":"spn-84874","marks":["code"],"text":"fs_snapshot_hash"},{"id":"spn-84875","text":" hashes each entry's "},{"id":"spn-84876","marks":["code"],"text":"{path, kind, size, permissions, content_hash}"},{"id":"spn-84877","text":" — fresh refs dropped."}]}],"id":"blk-57554","kind":"list-item"},{"blocks":[{"id":"blk-57557","kind":"paragraph","spans":[{"id":"spn-84878","marks":["code"],"text":"process_list_hash"},{"id":"spn-84879","text":" hashes each entry's "},{"id":"spn-84880","marks":["code"],"text":"{command, state}"},{"id":"spn-84881","text":" — raw pids dropped."}]}],"id":"blk-57556","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57558","kind":"heading","level":2,"spans":[{"id":"spn-84882","text":"Five invariants (all enforced by "},{"id":"spn-84883","marks":["code"],"text":"BodyOs.Session"},{"id":"spn-84884","text":")"}]},{"head":[{"id":"blk-57560","spans":[{"id":"spn-84885","text":"#"}]},{"id":"blk-57561","spans":[{"id":"spn-84886","text":"invariant"}]},{"id":"blk-57562","spans":[{"id":"spn-84887","text":"where"}]}],"id":"blk-57559","kind":"table","rows":[[{"id":"blk-57563","spans":[{"id":"spn-84888","text":"I1"}]},{"id":"blk-57564","spans":[{"id":"spn-84889","text":"perceive-before-act"}]},{"id":"blk-57565","spans":[{"id":"spn-84890","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-57566","spans":[{"id":"spn-84891","text":"I2"}]},{"id":"blk-57567","spans":[{"id":"spn-84892","text":"affordance-bounded action"}]},{"id":"blk-57568","spans":[{"id":"spn-84893","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-57569","spans":[{"id":"spn-84894","text":"I3"}]},{"id":"blk-57570","spans":[{"id":"spn-84895","text":"policy-filtered affordances"}]},{"id":"blk-57571","spans":[{"id":"spn-84896","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-57572","spans":[{"id":"spn-84897","text":"I4"}]},{"id":"blk-57573","spans":[{"id":"spn-84898","text":"deterministic state encoding"}]},{"id":"blk-57574","spans":[{"id":"spn-84899","marks":["code"],"text":"BodyOs.StateHash.of/1"}]}],[{"id":"blk-57575","spans":[{"id":"spn-84900","text":"I5"}]},{"id":"blk-57576","spans":[{"id":"spn-84901","text":"replay fail-fast + destructive re-auth"}]},{"id":"blk-57577","spans":[{"id":"spn-84902","marks":["code"],"text":"BodyOs.Replay.execute/3"}]}]]},{"id":"blk-57578","kind":"heading","level":2,"spans":[{"id":"spn-84903","text":"Quick start"}]},{"id":"blk-57579","kind":"code","language":"elixir","text":"alias BodyOs.Backend.Simulator\nalias BodyOs.Backend.Simulator.{FsNode, Proc}\nalias BodyOs.Session\n\nfs = %{\n  \"/home/user/hello.txt\" => %FsNode{kind: \"file\", size: 5, content: \"hello\"}\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator,\n    cwd: \"/home/user\",\n    fs: fs,\n    processes: %{},\n    env: %{\"USER\" => \"user\"}\n  },\n  agent_id: \"demo\",\n  provider: \"body-os-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n# Destructive action REQUIRES authorization block.\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"file_delete\",\n  \"target\" => \"@fs1/g1\",\n  \"authorization\" => %{\n    \"policy_id\" => \"delegatic://my-workspace/ops\",\n    \"approved_by\" => \"supervisor@co\",\n    \"approved_at\" => DateTime.utc_now() |> DateTime.to_iso8601(),\n    \"authorization_token\" => \"sha256:...\"\n  }\n})"},{"id":"blk-57580","kind":"heading","level":2,"spans":[{"id":"spn-84904","text":"Wiring to Graphonomous"}]},{"id":"blk-57581","kind":"paragraph","spans":[{"id":"spn-84905","text":"Every recorded trace carries "},{"id":"spn-84906","marks":["code"],"text":"provenance.capability == \"&body.os\""},{"id":"spn-84907","text":". Submit via Graphonomous's "},{"id":"spn-84908","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-84909","text":"; retrieve for replay via "},{"id":"spn-84910","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-84911","text":"."}]},{"id":"blk-57582","kind":"heading","level":2,"spans":[{"id":"spn-84912","text":"Running the conformance suite"}]},{"id":"blk-57583","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-57584","kind":"paragraph","spans":[{"id":"spn-84913","text":"Twelve tests, 1:1 with OS-011 §9. A real-host backend (Claude Computer Use, OpenClaw, …) must pass the same suite to claim OS-011 conformance for the "},{"id":"spn-84914","marks":["code"],"text":"os"},{"id":"spn-84915","text":" subtype."}]},{"id":"blk-57585","kind":"heading","level":2,"spans":[{"id":"spn-84916","text":"Safety note"}]},{"id":"blk-57586","kind":"paragraph","spans":[{"id":"spn-84917","text":"The "},{"id":"spn-84918","marks":["code"],"text":"ComputerUse"},{"id":"spn-84919","text":" backend (when wired) will execute real shell commands, real file writes, and real process signals on the host. Sandbox strongly (containers, jails, restricted filesystems) AND rely on the "},{"id":"spn-84920","marks":["code"],"text":"authorization"},{"id":"spn-84921","text":" block gate — the two are complementary, not redundant."}]},{"id":"blk-57587","kind":"heading","level":2,"spans":[{"id":"spn-84922","text":"References"}]},{"id":"blk-57588","items":[{"blocks":[{"id":"blk-57590","kind":"paragraph","spans":[{"id":"spn-84923","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-84924","text":" — normative spec"}]}],"id":"blk-57589","kind":"list-item"},{"blocks":[{"id":"blk-57592","kind":"paragraph","spans":[{"id":"spn-84925","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.os.md"},{"id":"spn-84926","text":" — registry entry"}]}],"id":"blk-57591","kind":"list-item"},{"blocks":[{"id":"blk-57594","kind":"paragraph","spans":[{"id":"spn-84927","marks":["code"],"text":"PULSE/manifests/body-os.embodiment.json"},{"id":"spn-84928","text":" — loop manifest"}]}],"id":"blk-57593","kind":"list-item"},{"blocks":[{"id":"blk-57596","kind":"paragraph","spans":[{"id":"spn-84929","text":"Sibling: "},{"id":"spn-84930","marks":["code"],"text":"body-browser/"},{"id":"spn-84931","text":" — "},{"id":"spn-84932","marks":["code"],"text":"&body.browser"},{"id":"spn-84933","text":" reference implementation"}]}],"id":"blk-57595","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57597","kind":"heading","level":2,"spans":[{"id":"spn-84934","text":"License"}]},{"id":"blk-57598","kind":"paragraph","spans":[{"id":"spn-84935","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaierasp7ybndqre74ohsoaikdps2h5s7effmpxe3t5qxaohr6mhqlpq6q","vocabulary":"ampersand.docs.fs.v1"}