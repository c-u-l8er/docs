{"bendscript":"0.1","blocks":[{"id":"blk-58396","kind":"heading","level":1,"spans":[{"id":"spn-87443","text":"body-os"}]},{"id":"blk-58397","kind":"paragraph","spans":[{"id":"spn-87444","text":"OS-011 "},{"id":"spn-87445","marks":["code"],"text":"&body.os"},{"id":"spn-87446","text":" reference implementation for the [&] Protocol ecosystem."}]},{"id":"blk-58398","kind":"paragraph","spans":[{"id":"spn-87447","text":"Typed perception of the host OS (cwd, env, filesystem snapshot, process list), typed action execution with destructive-edge authorization, StateHash-anchored replay, InteractionTrace recording — the OS-subtype counterpart to "},{"id":"spn-87448","marks":["code"],"text":"body-browser"},{"id":"spn-87449","text":", completing the "},{"id":"spn-87450","marks":["code"],"text":"&body.*"},{"id":"spn-87451","text":" primitive family."}]},{"id":"blk-58399","kind":"heading","level":2,"spans":[{"id":"spn-87452","text":"Status"}]},{"id":"blk-58400","items":[{"blocks":[{"id":"blk-58402","kind":"paragraph","spans":[{"id":"spn-87453","marks":["bold"],"text":"Library:"},{"id":"spn-87454","text":" production-ready"}]}],"id":"blk-58401","kind":"list-item"},{"blocks":[{"id":"blk-58404","kind":"paragraph","spans":[{"id":"spn-87455","marks":["bold"],"text":"Simulator backend:"},{"id":"spn-87456","text":" 12/12 OS-011 §9 conformance tests pass"}]}],"id":"blk-58403","kind":"list-item"},{"blocks":[{"id":"blk-58406","kind":"paragraph","spans":[{"id":"spn-87457","marks":["bold"],"text":"MCP server:"},{"id":"spn-87458","text":" shipped — 7 tools on the "},{"id":"spn-87459","marks":["code"],"text":"body-os"},{"id":"spn-87460","text":" namespace (ensure_session + 6 OS-011 operations), 12 MCP unit tests covering the destructive-action authorization gate"}]}],"id":"blk-58405","kind":"list-item"},{"blocks":[{"id":"blk-58408","kind":"paragraph","spans":[{"id":"spn-87461","marks":["bold"],"text":"ComputerUse backend (Claude Computer Use / OpenClaw):"},{"id":"spn-87462","text":" skeleton — subprocess wiring pending"}]}],"id":"blk-58407","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58409","kind":"heading","level":2,"spans":[{"id":"spn-87463","text":"MCP surface"}]},{"id":"blk-58410","kind":"code","language":"text","text":"body_os_ensure_session  — create or re-bind a session by id\nbody_os_perceive        — typed OS observation (cwd, env, fs, processes)\nbody_os_affordances     — policy-filtered AffordanceSet\nbody_os_encode_state    — deterministic StateHash\nbody_os_act             — execute one TypedAction (destructive ones need auth)\nbody_os_dry_run         — predicted outcome (no mutation)\nbody_os_replay          — fail-fast replay with destructive re-authorization"},{"id":"blk-58411","kind":"paragraph","spans":[{"id":"spn-87464","text":"Every tool takes a "},{"id":"spn-87465","marks":["code"],"text":"session_id"},{"id":"spn-87466","text":" so multiple agents can drive independent host sessions concurrently. Sessions are supervised under "},{"id":"spn-87467","marks":["code"],"text":"BodyOs.SessionSupervisor"},{"id":"spn-87468","text":" and addressed through the "},{"id":"spn-87469","marks":["code"],"text":"BodyOs.SessionRegistry"},{"id":"spn-87470","text":"."}]},{"id":"blk-58412","kind":"paragraph","spans":[{"id":"spn-87471","marks":["bold"],"text":"Safety:"},{"id":"spn-87472","text":" the destructive-action authorization gate at the Session boundary is necessary but not sufficient. For a real "},{"id":"spn-87473","marks":["code"],"text":"ComputerUse"},{"id":"spn-87474","text":" backend, combine it with a sandboxed execution environment (containers, jails, restricted filesystems). The two are complementary, not redundant."}]},{"id":"blk-58413","kind":"heading","level":2,"spans":[{"id":"spn-87475","text":"The contract (OS-011 §11)"}]},{"id":"blk-58414","kind":"paragraph","spans":[{"id":"spn-87476","text":"Identical six-operation surface as "},{"id":"spn-87477","marks":["code"],"text":"body-browser"},{"id":"spn-87478","text":", but with the OS action set:"}]},{"head":[{"id":"blk-58416","spans":[{"id":"spn-87479","text":"operation"}]},{"id":"blk-58417","spans":[{"id":"spn-87480","text":"input"}]},{"id":"blk-58418","spans":[{"id":"spn-87481","text":"output"}]},{"id":"blk-58419","spans":[{"id":"spn-87482","text":"deterministic"}]}],"id":"blk-58415","kind":"table","rows":[[{"id":"blk-58420","spans":[{"id":"spn-87483","marks":["code"],"text":"perceive"}]},{"id":"blk-58421","spans":[{"id":"spn-87484","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-58422","spans":[{"id":"spn-87485","marks":["code"],"text":"EnvironmentObservation"}]},{"id":"blk-58423","spans":[{"id":"spn-87486","text":"✅"}]}],[{"id":"blk-58424","spans":[{"id":"spn-87487","marks":["code"],"text":"affordances"}]},{"id":"blk-58425","spans":[{"id":"spn-87488","marks":["code"],"text":"ScopeQuery?"}]},{"id":"blk-58426","spans":[{"id":"spn-87489","marks":["code"],"text":"AffordanceSet"}]},{"id":"blk-58427","spans":[{"id":"spn-87490","text":"✅"}]}],[{"id":"blk-58428","spans":[{"id":"spn-87491","marks":["code"],"text":"encode_state"}]},{"id":"blk-58429","spans":[{"id":"spn-87492","marks":["code"],"text":"PerceptionQuery"}]},{"id":"blk-58430","spans":[{"id":"spn-87493","marks":["code"],"text":"StateHash"}]},{"id":"blk-58431","spans":[{"id":"spn-87494","text":"✅"}]}],[{"id":"blk-58432","spans":[{"id":"spn-87495","marks":["code"],"text":"act"}]},{"id":"blk-58433","spans":[{"id":"spn-87496","marks":["code"],"text":"TypedAction"}]},{"id":"blk-58434","spans":[{"id":"spn-87497","marks":["code"],"text":"ActionOutcome"}]},{"id":"blk-58435","spans":[{"id":"spn-87498","text":"❌ side-effecting"}]}],[{"id":"blk-58436","spans":[{"id":"spn-87499","marks":["code"],"text":"replay"}]},{"id":"blk-58437","spans":[{"id":"spn-87500","marks":["code"],"text":"InteractionTrace"}]},{"id":"blk-58438","spans":[{"id":"spn-87501","marks":["code"],"text":"ReplayResult"}]},{"id":"blk-58439","spans":[{"id":"spn-87502","text":"❌ side-effecting"}]}],[{"id":"blk-58440","spans":[{"id":"spn-87503","marks":["code"],"text":"dry_run"}]},{"id":"blk-58441","spans":[{"id":"spn-87504","marks":["code"],"text":"TypedAction"}]},{"id":"blk-58442","spans":[{"id":"spn-87505","marks":["code"],"text":"PredictedOutcome"}]},{"id":"blk-58443","spans":[{"id":"spn-87506","text":"✅"}]}]]},{"id":"blk-58444","kind":"heading","level":2,"spans":[{"id":"spn-87507","text":"OS action types (OS-011 v0.1, 11 types)"}]},{"id":"blk-58445","kind":"code","language":"text","text":"shell_exec  file_read  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nscreen_capture  process_spawn  process_signal"},{"id":"blk-58446","kind":"paragraph","spans":[{"id":"spn-87508","marks":["bold"],"text":"Destructive subset"},{"id":"spn-87509","text":" (require "},{"id":"spn-87510","marks":["code"],"text":"authorization"},{"id":"spn-87511","text":" block, fresh per replay):"}]},{"id":"blk-58447","kind":"code","language":"text","text":"shell_exec  file_write  file_edit  file_delete\nkeyboard_input  mouse_click  mouse_drag\nprocess_spawn  process_signal"},{"id":"blk-58448","kind":"paragraph","spans":[{"id":"spn-87512","text":"Only "},{"id":"spn-87513","marks":["code"],"text":"file_read"},{"id":"spn-87514","text":" and "},{"id":"spn-87515","marks":["code"],"text":"screen_capture"},{"id":"spn-87516","text":" are strictly read-only."}]},{"id":"blk-58449","kind":"heading","level":2,"spans":[{"id":"spn-87517","text":"StateHash stable fields"}]},{"id":"blk-58450","kind":"code","language":"text","text":"sha256(canonical_json({cwd, env_summary, fs_snapshot_hash, process_list_hash}))"},{"id":"blk-58451","items":[{"blocks":[{"id":"blk-58453","kind":"paragraph","spans":[{"id":"spn-87518","marks":["code"],"text":"fs_snapshot_hash"},{"id":"spn-87519","text":" hashes each entry's "},{"id":"spn-87520","marks":["code"],"text":"{path, kind, size, permissions, content_hash}"},{"id":"spn-87521","text":" — fresh refs dropped."}]}],"id":"blk-58452","kind":"list-item"},{"blocks":[{"id":"blk-58455","kind":"paragraph","spans":[{"id":"spn-87522","marks":["code"],"text":"process_list_hash"},{"id":"spn-87523","text":" hashes each entry's "},{"id":"spn-87524","marks":["code"],"text":"{command, state}"},{"id":"spn-87525","text":" — raw pids dropped."}]}],"id":"blk-58454","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58456","kind":"heading","level":2,"spans":[{"id":"spn-87526","text":"Five invariants (all enforced by "},{"id":"spn-87527","marks":["code"],"text":"BodyOs.Session"},{"id":"spn-87528","text":")"}]},{"head":[{"id":"blk-58458","spans":[{"id":"spn-87529","text":"#"}]},{"id":"blk-58459","spans":[{"id":"spn-87530","text":"invariant"}]},{"id":"blk-58460","spans":[{"id":"spn-87531","text":"where"}]}],"id":"blk-58457","kind":"table","rows":[[{"id":"blk-58461","spans":[{"id":"spn-87532","text":"I1"}]},{"id":"blk-58462","spans":[{"id":"spn-87533","text":"perceive-before-act"}]},{"id":"blk-58463","spans":[{"id":"spn-87534","marks":["code"],"text":"Session.check_ref_freshness/2"}]}],[{"id":"blk-58464","spans":[{"id":"spn-87535","text":"I2"}]},{"id":"blk-58465","spans":[{"id":"spn-87536","text":"affordance-bounded action"}]},{"id":"blk-58466","spans":[{"id":"spn-87537","marks":["code"],"text":"Session.check_affordance/4"}]}],[{"id":"blk-58467","spans":[{"id":"spn-87538","text":"I3"}]},{"id":"blk-58468","spans":[{"id":"spn-87539","text":"policy-filtered affordances"}]},{"id":"blk-58469","spans":[{"id":"spn-87540","marks":["code"],"text":"Session.apply_policy/2"}]}],[{"id":"blk-58470","spans":[{"id":"spn-87541","text":"I4"}]},{"id":"blk-58471","spans":[{"id":"spn-87542","text":"deterministic state encoding"}]},{"id":"blk-58472","spans":[{"id":"spn-87543","marks":["code"],"text":"BodyOs.StateHash.of/1"}]}],[{"id":"blk-58473","spans":[{"id":"spn-87544","text":"I5"}]},{"id":"blk-58474","spans":[{"id":"spn-87545","text":"replay fail-fast + destructive re-auth"}]},{"id":"blk-58475","spans":[{"id":"spn-87546","marks":["code"],"text":"BodyOs.Replay.execute/3"}]}]]},{"id":"blk-58476","kind":"heading","level":2,"spans":[{"id":"spn-87547","text":"Quick start"}]},{"id":"blk-58477","kind":"code","language":"elixir","text":"alias BodyOs.Backend.Simulator\nalias BodyOs.Backend.Simulator.{FsNode, Proc}\nalias BodyOs.Session\n\nfs = %{\n  \"/home/user/hello.txt\" => %FsNode{kind: \"file\", size: 5, content: \"hello\"}\n}\n\n{:ok, s} = Session.start_link(\n  backend: {Simulator,\n    cwd: \"/home/user\",\n    fs: fs,\n    processes: %{},\n    env: %{\"USER\" => \"user\"}\n  },\n  agent_id: \"demo\",\n  provider: \"body-os-simulator\"\n)\n\n{:ok, obs} = Session.perceive(s)\n{:ok, aset} = Session.affordances(s)\n{:ok, hash} = Session.encode_state(s)\n\n# Destructive action REQUIRES authorization block.\n{:ok, outcome} = Session.act(s, %{\n  \"type\" => \"file_delete\",\n  \"target\" => \"@fs1/g1\",\n  \"authorization\" => %{\n    \"policy_id\" => \"delegatic://my-workspace/ops\",\n    \"approved_by\" => \"supervisor@co\",\n    \"approved_at\" => DateTime.utc_now() |> DateTime.to_iso8601(),\n    \"authorization_token\" => \"sha256:...\"\n  }\n})"},{"id":"blk-58478","kind":"heading","level":2,"spans":[{"id":"spn-87548","text":"Wiring to Graphonomous"}]},{"id":"blk-58479","kind":"paragraph","spans":[{"id":"spn-87549","text":"Every recorded trace carries "},{"id":"spn-87550","marks":["code"],"text":"provenance.capability == \"&body.os\""},{"id":"spn-87551","text":". Submit via Graphonomous's "},{"id":"spn-87552","marks":["code"],"text":"act(action: \"store_trace\", interaction_trace: ...)"},{"id":"spn-87553","text":"; retrieve for replay via "},{"id":"spn-87554","marks":["code"],"text":"retrieve(action: \"replay\", trace_id: \"...\")"},{"id":"spn-87555","text":"."}]},{"id":"blk-58480","kind":"heading","level":2,"spans":[{"id":"spn-87556","text":"Running the conformance suite"}]},{"id":"blk-58481","kind":"code","language":"text","text":"mix deps.get\nmix test"},{"id":"blk-58482","kind":"paragraph","spans":[{"id":"spn-87557","text":"Twelve tests, 1:1 with OS-011 §9. A real-host backend (Claude Computer Use, OpenClaw, …) must pass the same suite to claim OS-011 conformance for the "},{"id":"spn-87558","marks":["code"],"text":"os"},{"id":"spn-87559","text":" subtype."}]},{"id":"blk-58483","kind":"heading","level":2,"spans":[{"id":"spn-87560","text":"Safety note"}]},{"id":"blk-58484","kind":"paragraph","spans":[{"id":"spn-87561","text":"The "},{"id":"spn-87562","marks":["code"],"text":"ComputerUse"},{"id":"spn-87563","text":" backend (when wired) will execute real shell commands, real file writes, and real process signals on the host. Sandbox strongly (containers, jails, restricted filesystems) AND rely on the "},{"id":"spn-87564","marks":["code"],"text":"authorization"},{"id":"spn-87565","text":" block gate — the two are complementary, not redundant."}]},{"id":"blk-58485","kind":"heading","level":2,"spans":[{"id":"spn-87566","text":"References"}]},{"id":"blk-58486","items":[{"blocks":[{"id":"blk-58488","kind":"paragraph","spans":[{"id":"spn-87567","marks":["code"],"text":"opensentience.org/docs/spec/OS-011-EMBODIMENT.md"},{"id":"spn-87568","text":" — normative spec"}]}],"id":"blk-58487","kind":"list-item"},{"blocks":[{"id":"blk-58490","kind":"paragraph","spans":[{"id":"spn-87569","marks":["code"],"text":"AmpersandBoxDesign/docs/registry/body.os.md"},{"id":"spn-87570","text":" — registry entry"}]}],"id":"blk-58489","kind":"list-item"},{"blocks":[{"id":"blk-58492","kind":"paragraph","spans":[{"id":"spn-87571","marks":["code"],"text":"PULSE/manifests/body-os.embodiment.json"},{"id":"spn-87572","text":" — loop manifest"}]}],"id":"blk-58491","kind":"list-item"},{"blocks":[{"id":"blk-58494","kind":"paragraph","spans":[{"id":"spn-87573","text":"Sibling: "},{"id":"spn-87574","marks":["code"],"text":"body-browser/"},{"id":"spn-87575","text":" — "},{"id":"spn-87576","marks":["code"],"text":"&body.browser"},{"id":"spn-87577","text":" reference implementation"}]}],"id":"blk-58493","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-58495","kind":"heading","level":2,"spans":[{"id":"spn-87578","text":"License"}]},{"id":"blk-58496","kind":"paragraph","spans":[{"id":"spn-87579","text":"Apache-2.0"}]}],"edges":[],"id":"bagaaieracczaaa3bss36ho3djrw4aayv2voedci7g5bszfyecnnch5rivfrq","vocabulary":"ampersand.docs.fs.v1"}