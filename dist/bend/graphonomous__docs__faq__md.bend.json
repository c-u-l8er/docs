pn-45726","marks":["code"],"text":"causal_context"},{"id":"spn-45727","text":" and why does it matter?"}]},{"id":"blk-41044","kind":"paragraph","spans":[{"id":"spn-45728","marks":["code"],"text":"causal_context"},{"id":"spn-45729","text":" is the list of node IDs that informed the current action. You should pass those IDs into "},{"id":"spn-45730","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-45731","text":" so Graphonomous can update confidence on the actual causal nodes."}]},{"id":"blk-41045","kind":"paragraph","spans":[{"id":"spn-45732","text":"---"}]},{"id":"blk-41046","kind":"heading","level":2,"spans":[{"id":"spn-45733","text":"What outcomes can I report?"}]},{"id":"blk-41047","kind":"paragraph","spans":[{"id":"spn-45734","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-45735","text":" supports:"}]},{"id":"blk-41048","items":[{"blocks":[{"id":"blk-41050","kind":"paragraph","spans":[{"id":"spn-45736","marks":["code"],"text":"success"}]}],"id":"blk-41049","kind":"list-item"},{"blocks":[{"id":"blk-41052","kind":"paragraph","spans":[{"id":"spn-45737","marks":["code"],"text":"partial_success"}]}],"id":"blk-41051","kind":"list-item"},{"blocks":[{"id":"blk-41054","kind":"paragraph","spans":[{"id":"spn-45738","marks":["code"],"text":"failure"}]}],"id":"blk-41053","kind":"list-item"},{"blocks":[{"id":"blk-41056","kind":"paragraph","spans":[{"id":"spn-45739","marks":["code"],"text":"timeout"}]}],"id":"blk-41055","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41057","kind":"paragraph","spans":[{"id":"spn-45740","text":"Use "},{"id":"spn-45741","marks":["code"],"text":"timeout"},{"id":"spn-45742","text":" when an action did not complete in time (instead of incorrectly marking it as failure)."}]},{"id":"blk-41058","kind":"paragraph","spans":[{"id":"spn-45743","text":"---"}]},{"id":"blk-41059","kind":"heading","level":2,"spans":[{"id":"spn-45744","text":"How do goals work?"}]},{"id":"blk-41060","kind":"paragraph","spans":[{"id":"spn-45745","text":"Graphonomous includes durable GoalGraph operations:"}]},{"id":"blk-41061","items":[{"blocks":[{"id":"blk-41063","kind":"paragraph","spans":[{"id":"spn-45746","text":"create/list/get/update/delete goals"}]}],"id":"blk-41062","kind":"list-item"},{"blocks":[{"id":"blk-41065","kind":"paragraph","spans":[{"id":"spn-45747","text":"transition status"}]}],"id":"blk-41064","kind":"list-item"},{"blocks":[{"id":"blk-41067","kind":"paragraph","spans":[{"id":"spn-45748","text":"set progress"}]}],"id":"blk-41066","kind":"list-item"},{"blocks":[{"id":"blk-41069","kind":"paragraph","spans":[{"id":"spn-45749","text":"link/unlink evidence nodes"}]}],"id":"blk-41068","kind":"list-item"},{"blocks":[{"id":"blk-41071","kind":"paragraph","spans":[{"id":"spn-45750","text":"run epistemic review ("},{"id":"spn-45751","marks":["code"],"text":"review_goal"},{"id":"spn-45752","text":")"}]}],"id":"blk-41070","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41072","kind":"paragraph","spans":[{"id":"spn-45753","text":"Typical statuses include "},{"id":"spn-45754","marks":["code"],"text":"proposed"},{"id":"spn-45755","text":", "},{"id":"spn-45756","marks":["code"],"text":"active"},{"id":"spn-45757","text":", "},{"id":"spn-45758","marks":["code"],"text":"blocked"},{"id":"spn-45759","text":", "},{"id":"spn-45760","marks":["code"],"text":"completed"},{"id":"spn-45761","text":", and "},{"id":"spn-45762","marks":["code"],"text":"abandoned"},{"id":"spn-45763","text":"."}]},{"id":"blk-41073","kind":"paragraph","spans":[{"id":"spn-45764","text":"---"}]},{"id":"blk-41074","kind":"heading","level":2,"spans":[{"id":"spn-45765","text":"What is coverage review?"}]},{"id":"blk-41075","kind":"paragraph","spans":[{"id":"spn-45766","marks":["code"],"text":"review_goal"},{"id":"spn-45767","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-41076","items":[{"blocks":[{"id":"blk-41078","kind":"paragraph","spans":[{"id":"spn-45768","marks":["code"],"text":"act"},{"id":"spn-45769","text":" (enough coverage)"}]}],"id":"blk-41077","kind":"list-item"},{"blocks":[{"id":"blk-41080","kind":"paragraph","spans":[{"id":"spn-45770","marks":["code"],"text":"learn"},{"id":"spn-45771","text":" (need more context)"}]}],"id":"blk-41079","kind":"list-item"},{"blocks":[{"id":"blk-41082","kind":"paragraph","spans":[{"id":"spn-45772","marks":["code"],"text":"escalate"},{"id":"spn-45773","text":" (insufficient/too risky)"}]}],"id":"blk-41081","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41083","kind":"paragraph","spans":[{"id":"spn-45774","text":"---"}]},{"id":"blk-41084","kind":"heading","level":2,"spans":[{"id":"spn-45775","text":"What does topology-aware routing mean?"}]},{"id":"blk-41085","kind":"paragraph","spans":[{"id":"spn-45776","text":"Graphonomous analyzes retrieved subgraphs for cycles and complexity. If topology is simple, routing is "},{"id":"spn-45777","marks":["code"],"text":"fast"},{"id":"spn-45778","text":". If cyclic complexity is higher, routing may indicate "},{"id":"spn-45779","marks":["code"],"text":"deliberate"},{"id":"spn-45780","text":", signaling deeper reasoning is safer."}]},{"id":"blk-41086","kind":"paragraph","spans":[{"id":"spn-45781","text":"---"}]},{"id":"blk-41087","kind":"heading","level":2,"spans":[{"id":"spn-45782","text":"What does consolidation do?"}]},{"id":"blk-41088","kind":"paragraph","spans":[{"id":"spn-45783","text":"Consolidation is a 7-stage periodic memory maintenance pipeline:"}]},{"id":"blk-41089","kind":"paragraph","spans":[{"id":"spn-45784","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-41090","kind":"paragraph","spans":[{"id":"spn-45785","text":"Use "},{"id":"spn-45786","marks":["code"],"text":"run_consolidation"},{"id":"spn-45787","text":" to trigger/inspect cycles manually when needed."}]},{"id":"blk-41091","kind":"paragraph","spans":[{"id":"spn-45788","text":"---"}]},{"id":"blk-41092","kind":"heading","level":2,"spans":[{"id":"spn-45789","text":"Is Graphonomous usable from constrained machines?"}]},{"id":"blk-41093","kind":"paragraph","spans":[{"id":"spn-45790","text":"Yes. It is designed for local operation with practical defaults and fallback modes. A common setup uses a local SQLite DB path and a lightweight embedder backend configuration for reliability."}]},{"id":"blk-41094","kind":"paragraph","spans":[{"id":"spn-45791","text":"---"}]},{"id":"blk-41095","kind":"heading","level":2,"spans":[{"id":"spn-45792","text":"How do I run it quickly?"}]},{"id":"blk-41096","kind":"paragraph","spans":[{"id":"spn-45793","text":"Typical options:"}]},{"id":"blk-41097","items":[{"blocks":[{"id":"blk-41099","kind":"paragraph","spans":[{"id":"spn-45794","text":"run as MCP server over stdio"}]}],"id":"blk-41098","kind":"list-item"},{"blocks":[{"id":"blk-41101","kind":"paragraph","spans":[{"id":"spn-45795","text":"run one-shot traversal/scan mode"}]}],"id":"blk-41100","kind":"list-item"},{"blocks":[{"id":"blk-41103","kind":"paragraph","spans":[{"id":"spn-45796","text":"run watch mode for ongoing ingestion"}]}],"id":"blk-41102","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41104","kind":"paragraph","spans":[{"id":"spn-45797","text":"See "},{"id":"spn-45798","marks":["code"],"text":"quickstart"},{"id":"spn-45799","text":" and "},{"id":"spn-45800","marks":["code"],"text":"runtime"},{"id":"spn-45801","text":" docs pages for exact commands and settings."}]},{"id":"blk-41105","kind":"paragraph","spans":[{"id":"spn-45802","text":"---"}]},{"id":"blk-41106","kind":"heading","level":2,"spans":[{"id":"spn-45803","text":"How should agents use Graphonomous by default?"}]},{"id":"blk-41107","kind":"paragraph","spans":[{"id":"spn-45804","text":"For non-trivial work, use this loop:"}]},{"id":"blk-41108","kind":"paragraph","spans":[{"id":"spn-45805","text":"1. retrieve context 2. reason and act 3. store durable knowledge 4. report outcomes 5. maintain via consolidation"}]},{"id":"blk-41109","kind":"paragraph","spans":[{"id":"spn-45806","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-41110","kind":"paragraph","spans":[{"id":"spn-45807","text":"---"}]},{"id":"blk-41111","kind":"heading","level":2,"spans":[{"id":"spn-45808","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-41112","kind":"paragraph","spans":[{"id":"spn-45809","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-41113","items":[{"blocks":[{"id":"blk-41115","kind":"paragraph","spans":[{"id":"spn-45810","text":"retrieval and graph query"}]}],"id":"blk-41114","kind":"list-item"},{"blocks":[{"id":"blk-41117","kind":"paragraph","spans":[{"id":"spn-45811","text":"node/edge storage"}]}],"id":"blk-41116","kind":"list-item"},{"blocks":[{"id":"blk-41119","kind":"paragraph","spans":[{"id":"spn-45812","text":"outcome learning"}]}],"id":"blk-41118","kind":"list-item"},{"blocks":[{"id":"blk-41121","kind":"paragraph","spans":[{"id":"spn-45813","text":"goal management and review"}]}],"id":"blk-41120","kind":"list-item"},{"blocks":[{"id":"blk-41123","kind":"paragraph","spans":[{"id":"spn-45814","text":"topology analysis and deliberation"}]}],"id":"blk-41122","kind":"list-item"},{"blocks":[{"id":"blk-41125","kind":"paragraph","spans":[{"id":"spn-45815","text":"attention and consolidation"}]}],"id":"blk-41124","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41126","kind":"paragraph","spans":[{"id":"spn-45816","text":"---"}]},{"id":"blk-41127","kind":"heading","level":2,"spans":[{"id":"spn-45817","text":"Is there a best-practice checklist?"}]},{"id":"blk-41128","kind":"paragraph","spans":[{"id":"spn-45818","text":"Yes—short version:"}]},{"id":"blk-41129","items":[{"blocks":[{"id":"blk-41131","kind":"paragraph","spans":[{"id":"spn-45819","text":"retrieve first for meaningful tasks"}]}],"id":"blk-41130","kind":"list-item"},{"blocks":[{"id":"blk-41133","kind":"paragraph","spans":[{"id":"spn-45820","text":"store atomic nodes (avoid “kitchen-sink” nodes)"}]}],"id":"blk-41132","kind":"list-item"},{"blocks":[{"id":"blk-41135","kind":"paragraph","spans":[{"id":"spn-45821","text":"keep confidence calibrated to evidence quality"}]}],"id":"blk-41134","kind":"list-item"},{"blocks":[{"id":"blk-41137","kind":"paragraph","spans":[{"id":"spn-45822","text":"preserve causal IDs for feedback"}]}],"id":"blk-41136","kind":"list-item"},{"blocks":[{"id":"blk-41139","kind":"paragraph","spans":[{"id":"spn-45823","text":"avoid fabricated provenance/signals"}]}],"id":"blk-41138","kind":"list-item"},{"blocks":[{"id":"blk-41141","kind":"paragraph","spans":[{"id":"spn-45824","text":"review goals before consequential actions"}]}],"id":"blk-41140","kind":"list-item"},{"blocks":[{"id":"blk-41143","kind":"paragraph","spans":[{"id":"spn-45825","text":"consolidate periodically"}]}],"id":"blk-41142","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41144","kind":"paragraph","spans":[{"id":"spn-45826","text":"---"}]},{"id":"blk-41145","kind":"paragraph","spans":[{"id":"spn-45827","text":"If you want a deeper operational playbook, start with the docs "},{"id":"spn-45828","marks":["code"],"text":"quickstart"},{"id":"spn-45829","text":", then "},{"id":"spn-45830","marks":["code"],"text":"architecture"},{"id":"spn-45831","text":", then the workflows and anti-patterns sections."}]}],"edges":[],"id":"bagaaieraxph4s766wcnd7imasmpf44o3zkasfoevamedbmof23rzkmyloqxa","vocabulary":"ampersand.docs.fs.v1"}