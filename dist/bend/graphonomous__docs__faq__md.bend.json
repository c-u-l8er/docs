xt":"create/list/get/update/delete goals"}]}],"id":"blk-65390","kind":"list-item"},{"blocks":[{"id":"blk-65393","kind":"paragraph","spans":[{"id":"spn-95669","text":"transition status"}]}],"id":"blk-65392","kind":"list-item"},{"blocks":[{"id":"blk-65395","kind":"paragraph","spans":[{"id":"spn-95670","text":"set progress"}]}],"id":"blk-65394","kind":"list-item"},{"blocks":[{"id":"blk-65397","kind":"paragraph","spans":[{"id":"spn-95671","text":"link/unlink evidence nodes"}]}],"id":"blk-65396","kind":"list-item"},{"blocks":[{"id":"blk-65399","kind":"paragraph","spans":[{"id":"spn-95672","text":"run epistemic review ("},{"id":"spn-95673","marks":["code"],"text":"review_goal"},{"id":"spn-95674","text":")"}]}],"id":"blk-65398","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65400","kind":"paragraph","spans":[{"id":"spn-95675","text":"Typical statuses include "},{"id":"spn-95676","marks":["code"],"text":"proposed"},{"id":"spn-95677","text":", "},{"id":"spn-95678","marks":["code"],"text":"active"},{"id":"spn-95679","text":", "},{"id":"spn-95680","marks":["code"],"text":"blocked"},{"id":"spn-95681","text":", "},{"id":"spn-95682","marks":["code"],"text":"completed"},{"id":"spn-95683","text":", and "},{"id":"spn-95684","marks":["code"],"text":"abandoned"},{"id":"spn-95685","text":"."}]},{"id":"blk-65401","kind":"heading","level":2,"spans":[{"id":"spn-95686","text":"What is coverage review?"}]},{"id":"blk-65402","kind":"paragraph","spans":[{"id":"spn-95687","marks":["code"],"text":"review_goal"},{"id":"spn-95688","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-65403","items":[{"blocks":[{"id":"blk-65405","kind":"paragraph","spans":[{"id":"spn-95689","marks":["code"],"text":"act"},{"id":"spn-95690","text":" (enough coverage)"}]}],"id":"blk-65404","kind":"list-item"},{"blocks":[{"id":"blk-65407","kind":"paragraph","spans":[{"id":"spn-95691","marks":["code"],"text":"learn"},{"id":"spn-95692","text":" (need more context)"}]}],"id":"blk-65406","kind":"list-item"},{"blocks":[{"id":"blk-65409","kind":"paragraph","spans":[{"id":"spn-95693","marks":["code"],"text":"escalate"},{"id":"spn-95694","text":" (insufficient/too risky)"}]}],"id":"blk-65408","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65410","kind":"heading","level":2,"spans":[{"id":"spn-95695","text":"What does topology-aware routing mean?"}]},{"id":"blk-65411","kind":"paragraph","spans":[{"id":"spn-95696","text":"Graphonomous analyzes retrieved subgraphs for cycles and complexity. If topology is simple, routing is "},{"id":"spn-95697","marks":["code"],"text":"fast"},{"id":"spn-95698","text":". If cyclic complexity is higher, routing may indicate "},{"id":"spn-95699","marks":["code"],"text":"deliberate"},{"id":"spn-95700","text":", signaling deeper reasoning is safer."}]},{"id":"blk-65412","kind":"heading","level":2,"spans":[{"id":"spn-95701","text":"What does consolidation do?"}]},{"id":"blk-65413","kind":"paragraph","spans":[{"id":"spn-95702","text":"Consolidation is a 7-stage periodic memory maintenance pipeline:"}]},{"id":"blk-65414","items":[{"blocks":[{"id":"blk-65416","kind":"paragraph","spans":[{"id":"spn-95703","text":"Confidence decay"}]}],"id":"blk-65415","kind":"list-item"},{"blocks":[{"id":"blk-65418","kind":"paragraph","spans":[{"id":"spn-95704","text":"Prune weak nodes"}]}],"id":"blk-65417","kind":"list-item"},{"blocks":[{"id":"blk-65420","kind":"paragraph","spans":[{"id":"spn-95705","text":"Prune weak edges"}]}],"id":"blk-65419","kind":"list-item"},{"blocks":[{"id":"blk-65422","kind":"paragraph","spans":[{"id":"spn-95706","text":"Strengthen co-activated edges"}]}],"id":"blk-65421","kind":"list-item"},{"blocks":[{"id":"blk-65424","kind":"paragraph","spans":[{"id":"spn-95707","text":"Merge similar nodes"}]}],"id":"blk-65423","kind":"list-item"},{"blocks":[{"id":"blk-65426","kind":"paragraph","spans":[{"id":"spn-95708","text":"Promote timescale (fast → medium →