":[{"id":"spn-98388","text":"What are the core edge types?"}]},{"id":"blk-66298","kind":"paragraph","spans":[{"id":"spn-98389","text":"16 edge types (including 2 legacy aliases):"}]},{"id":"blk-66299","items":[{"blocks":[{"id":"blk-66301","kind":"paragraph","spans":[{"id":"spn-98390","marks":["code"],"text":"causes"},{"id":"spn-98391","text":", "},{"id":"spn-98392","marks":["code"],"text":"resolves"},{"id":"spn-98393","text":" — causal attribution"}]}],"id":"blk-66300","kind":"list-item"},{"blocks":[{"id":"blk-66303","kind":"paragraph","spans":[{"id":"spn-98394","marks":["code"],"text":"supports"},{"id":"spn-98395","text":", "},{"id":"spn-98396","marks":["code"],"text":"contradicts"},{"id":"spn-98397","text":" — evidential"}]}],"id":"blk-66302","kind":"list-item"},{"blocks":[{"id":"blk-66305","kind":"paragraph","spans":[{"id":"spn-98398","marks":["code"],"text":"related_to"},{"id":"spn-98399","text":", "},{"id":"spn-98400","marks":["code"],"text":"similar_to"},{"id":"spn-98401","text":" — topical affinity"}]}],"id":"blk-66304","kind":"list-item"},{"blocks":[{"id":"blk-66307","kind":"paragraph","spans":[{"id":"spn-98402","marks":["code"],"text":"part_of"},{"id":"spn-98403","text":", "},{"id":"spn-98404","marks":["code"],"text":"follows"},{"id":"spn-98405","text":", "},{"id":"spn-98406","marks":["code"],"text":"supersedes"},{"id":"spn-98407","text":", "},{"id":"spn-98408","marks":["code"],"text":"depends_on"},{"id":"spn-98409","text":" — structural"}]}],"id":"blk-66306","kind":"list-item"},{"blocks":[{"id":"blk-66309","kind":"paragraph","spans":[{"id":"spn-98410","marks":["code"],"text":"temporal_before"},{"id":"spn-98411","text":", "},{"id":"spn-98412","marks":["code"],"text":"temporal_after"},{"id":"spn-98413","text":", "},{"id":"spn-98414","marks":["code"],"text":"co_occurs"},{"id":"spn-98415","text":" — temporal ordering"}]}],"id":"blk-66308","kind":"list-item"},{"blocks":[{"id":"blk-66311","kind":"paragraph","spans":[{"id":"spn-98416","marks":["code"],"text":"derived_from"},{"id":"spn-98417","text":" — provenance"}]}],"id":"blk-66310","kind":"list-item"},{"blocks":[{"id":"blk-66313","kind":"paragraph","spans":[{"id":"spn-98418","text":"Legacy aliases: "},{"id":"spn-98419","marks":["code"],"text":"causal"},{"id":"spn-98420","text":", "},{"id":"spn-98421","marks":["code"],"text":"related"},{"id":"spn-98422","text":" (backward-compatible)"}]}],"id":"blk-66312","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66314","kind":"paragraph","spans":[{"id":"spn-98423","text":"Default edge weight is 0.3. Edges should be added only when they improve retrieval quality or provenance clarity."}]},{"id":"blk-66315","kind":"heading","level":2,"spans":[{"id":"spn-98424","text":"How does retrieval work?"}]},{"id":"blk-66316","kind":"paragraph","spans":[{"id":"spn-98425","marks":["code"],"text":"retrieve_context"},{"id":"spn-98426","text":" generally does:"}]},{"id":"blk-66317","items":[{"blocks":[{"id":"blk-66319","kind":"paragraph","spans":[{"id":"spn-98427","text":"similarity retrieval"}]}],"id":"blk-66318","kind":"list-item"},{"blocks":[{"id":"blk-66321","kind":"paragraph","spans":[{"id":"spn-98428","text":"graph expansion"}]}],"id":"blk-66320","kind":"list-item"},{"blocks":[{"id":"blk-66323","kind":"paragraph","spans":[{"id":"spn-98429","text":"ranking with confidence-aware scoring"}]}],"id":"blk-66322","kind":"list-item"},{"blocks":[{"id":"blk-66325","kind":"paragraph","spans":[{"id":"spn-98430","text":"topology analysis (SCC/κ-aware metadata)"}]}],"id":"blk-66324","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-66326","kind":"paragraph","spans":[{"id":"spn-98431","text":"Results include a "},{"id":"spn-98432","marks":["code"],"text":"causal_context"},{"id":"spn-98433","text":" array for later feedback via "},{"id":"spn-98434","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98435","text":"."}]},{"id":"blk-66327","kind":"heading","level":2,"spans":[{"id":"spn-98436","text":"What is "},{"id":"spn-98437","marks":["code"],"text":"causal_context"},{"id":"spn-98438","text":" and why does it matter?"}]},{"id":"blk-66328","kind":"paragraph","spans":[{"id":"spn-98439","marks":["code"],"text":"causal_context"},{"id":"spn-98440","text":" is the list of node IDs that informed the current action. You should pass those IDs into "},{"id":"spn-98441","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98442","text":" so Graphonomous can update confidence on the actual causal nodes."}]},{"id":"blk-66329","kind":"heading","level":2,"spans":[{"id":"spn-98443","text":"What outcomes can I report?"}]},{"id":"blk-66330","kind":"paragraph","spans":[{"id":"spn-98444","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-98445","text":" supports:"}]},{"id":"blk-66331","items":[{"blocks":[{"id":"blk-66333","kind":"paragraph","spans":[{"id":"spn-98446","marks":["code"],"text":"success"}]}],"id":"blk-66332","kind":"list-item"},{"blocks":[{"id":"blk-66335","kind":"paragraph","spans":[{"id":"spn-98447","marks":["code"],"text":"partial_success"}]}],"id":"blk-66334","kind":"list-item"},{"blocks":[{"id":"blk-66337","kind":"paragraph","spans":[{"id":"spn-98448","marks":["code"],"text":"failure"}]}],"id":"blk-66336","kind":"list-item"},{"blocks":[{"id":"blk-66339","kind":"paragraph","spans":[{"id":"spn-98449","marks":["code"],"text":"timeout"}]}],"id":"blk-66338","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66340","kind":"paragraph","spans":[{"id":"spn-98450","text":"Use "},{"id":"spn-98451","marks":["code"],"text":"timeout"},{"id":"spn-98452","text":" when an action did not complete in time (instead of incorrectly marking it as failure)."}]},{"id":"blk-66341","kind":"heading","level":2,"spans":[{"id":"spn-98453","text":"How do goals work?"}]},{"id":"blk-66342","kind":"paragraph","spans":[{"id":"spn-98454","text":"Graphonomous includes durable GoalGraph operations:"}]},{"id":"blk-66343","items":[{"blocks":[{"id":"blk-66345","kind":"paragraph","spans":[{"id":"spn-98455","text":"create/list/get/update/delete goals"}]}],"id":"blk-66344","kind":"list-item"},{"blocks":[{"id":"blk-66347","kind":"paragraph","spans":[{"id":"spn-98456","text":"transition status"}]}],"id":"blk-66346","kind":"list-item"},{"blocks":[{"id":"blk-66349","kind":"paragraph","spans":[{"id":"spn-98457","text":"set progress"}]}],"id":"blk-66348","kind":"list-item"},{"blocks":[{"id":"blk-66351","kind":"paragraph","spans":[{"id":"spn-98458","text":"link/unlink evidence nodes"}]}],"id":"blk-66350","kind":"list-item"},{"blocks":[{"id":"blk-66353","kind":"paragraph","spans":[{"id":"spn-98459","text":"run epistemic review ("},{"id":"spn-98460","marks":["code"],"text":"review_goal"},{"id":"spn-98461","text":")"}]}],"id":"blk-66352","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66354","kind":"paragraph","spans":[{"id":"spn-98462","text":"Typical statuses include "},{"id":"spn-98463","marks":["code"],"text":"proposed"},{"id":"spn-98464","text":", "},{"id":"spn-98465","marks":["code"],"text":"active"},{"id":"spn-98466","text":", "},{"id":"spn-98467","marks":["code"],"text":"blocked"},{"id":"spn-98468","text":", "},{"id":"spn-98469","marks":["code"],"text":"completed"},{"id":"spn-98470","text":", and "},{"id":"spn-98471","marks":["code"],"text":"abandoned"},{"id":"spn-98472","text":"."}]},{"id":"blk-66355","kind":"heading","level":2,"spans":[{"id":"spn-98473","text":"What is coverage review?"}]},{"id":"blk-66356","kind":"paragraph","spans":[{"id":"spn-98474","marks":["code"],"text":"review_goal"},{"id":"spn-98475","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-66357","items":[{"blocks":[{"id":"blk-66359","kind":"paragraph","spans":[{"id":"spn-98476","marks":["code"],"text":"act"},{"id":"spn-98477","text":" (enough coverage)"}]}],"id":"blk-66358","kind":"list-item"},{"blocks":[{"id":"blk-66361","kind":"paragraph","spans":[{"id":"spn-98478","marks":["code"],"text":"learn"},{"id":"spn-98479","text":" (need more context)"}]}],"id":"blk-66360","kind":"list-item"},{"blocks":[{"id":"blk-66363","kind":"paragraph","spans":[{"id":"spn-98480","marks":["code"],"text":"escalate"},{"id":"spn-98481","text":" (insufficient/too risky)"}]}],"id":"blk-66362","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-66364","kind":"heading","level":2,"spans":[{"id":"spn-98482","text":"What does topology-aware routing mean?"}]},{"id":"blk-66365","kind":"paragraph","spans":[{"id":"spn-98483","text":"Graphonomous analyzes retrieved subgraphs for cycles and complexity. If topology is simple, routing is "},{"id":"spn-98484","marks":["code"],"text":"fast"},{"id":"spn-98485","text":". If cyclic complexity is higher, routing may indicate "},{"id":"spn-98486","marks":["code"],"text":"deliberate"},{"id":"spn-98487","text":", signaling deeper reasoning is safer."}]},{"id":"blk-66366","kind":"heading","level":2,"spans":[{"id":"spn-98488","text":"What does consolidation do?"}]},{"id":"blk-66367","kind":"paragraph","spans":[{"id":"spn-98489","text":"Consolidation is a 7-stage periodic memory maintenance pipeline:"}]},{"id":"blk-66368","items":[{"blocks":[{"id":"blk-66370","kind":"paragraph","spans":[{"id":"spn-98490","text":"Confidence decay"}]}],"id":"blk-66369","kind":"list-item"},{"blocks":[{"id":"blk-66372","kind":"paragraph","spans":[{"id":"spn-98491","text":"Prune weak nodes"}]}],"id":"blk-66371","kind":"list-item"},{"blocks":[{"id":"blk-66374","kind":"paragraph","spans":[{"id":"spn-98492","text":"Prune weak edges"}]}],"id":"blk-66373","kind":"list-item"},{"blocks":[{"id":"blk-66376","kind":"paragraph","spans":[{"id":"spn-98493","text":"Strengthen co-activated edges"}]}],"id":"blk-66375","kind":"list-item"},{"blocks":[{"id":"blk-66378","kind":"paragraph","spans":[{"id":"spn-98494","text":"Merge similar nodes"}]}],"id":"blk-66377","kind":"list-item"},{"blocks":[{"id":"blk-66380","kind":"paragraph","spans":[{"id":"spn-98495","text":"Promote timescale (fast → medium →