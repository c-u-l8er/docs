":[{"id":"spn-95548","text":"What are the core edge types?"}]},{"id":"blk-65333","kind":"paragraph","spans":[{"id":"spn-95549","text":"16 edge types (including 2 legacy aliases):"}]},{"id":"blk-65334","items":[{"blocks":[{"id":"blk-65336","kind":"paragraph","spans":[{"id":"spn-95550","marks":["code"],"text":"causes"},{"id":"spn-95551","text":", "},{"id":"spn-95552","marks":["code"],"text":"resolves"},{"id":"spn-95553","text":" — causal attribution"}]}],"id":"blk-65335","kind":"list-item"},{"blocks":[{"id":"blk-65338","kind":"paragraph","spans":[{"id":"spn-95554","marks":["code"],"text":"supports"},{"id":"spn-95555","text":", "},{"id":"spn-95556","marks":["code"],"text":"contradicts"},{"id":"spn-95557","text":" — evidential"}]}],"id":"blk-65337","kind":"list-item"},{"blocks":[{"id":"blk-65340","kind":"paragraph","spans":[{"id":"spn-95558","marks":["code"],"text":"related_to"},{"id":"spn-95559","text":", "},{"id":"spn-95560","marks":["code"],"text":"similar_to"},{"id":"spn-95561","text":" — topical affinity"}]}],"id":"blk-65339","kind":"list-item"},{"blocks":[{"id":"blk-65342","kind":"paragraph","spans":[{"id":"spn-95562","marks":["code"],"text":"part_of"},{"id":"spn-95563","text":", "},{"id":"spn-95564","marks":["code"],"text":"follows"},{"id":"spn-95565","text":", "},{"id":"spn-95566","marks":["code"],"text":"supersedes"},{"id":"spn-95567","text":", "},{"id":"spn-95568","marks":["code"],"text":"depends_on"},{"id":"spn-95569","text":" — structural"}]}],"id":"blk-65341","kind":"list-item"},{"blocks":[{"id":"blk-65344","kind":"paragraph","spans":[{"id":"spn-95570","marks":["code"],"text":"temporal_before"},{"id":"spn-95571","text":", "},{"id":"spn-95572","marks":["code"],"text":"temporal_after"},{"id":"spn-95573","text":", "},{"id":"spn-95574","marks":["code"],"text":"co_occurs"},{"id":"spn-95575","text":" — temporal ordering"}]}],"id":"blk-65343","kind":"list-item"},{"blocks":[{"id":"blk-65346","kind":"paragraph","spans":[{"id":"spn-95576","marks":["code"],"text":"der