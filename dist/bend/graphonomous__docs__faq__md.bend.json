{"bendscript":"0.1","blocks":[{"id":"blk-65309","kind":"heading","level":1,"spans":[{"id":"spn-95568","text":"Graphonomous FAQ"}]},{"id":"blk-65310","kind":"paragraph","spans":[{"id":"spn-95569","text":"This page answers the most common questions about Graphonomous, its MCP interface, and operating model."}]},{"id":"blk-65311","kind":"heading","level":2,"spans":[{"id":"spn-95570","text":"What is Graphonomous?"}]},{"id":"blk-65312","kind":"paragraph","spans":[{"id":"spn-95571","text":"Graphonomous is a continual-learning memory engine for AI agents. It stores knowledge as a graph, supports confidence-updating feedback loops, and exposes all capabilities through MCP tools/resources."}]},{"id":"blk-65313","kind":"heading","level":2,"spans":[{"id":"spn-95572","text":"Does Graphonomous retrain model weights?"}]},{"id":"blk-65314","kind":"paragraph","spans":[{"id":"spn-95573","text":"No. Graphonomous does "},{"id":"spn-95574","marks":["bold"],"text":"not"},{"id":"spn-95575","text":" retrain model weights. Learning happens in the memory graph by storing knowledge and updating confidence based on outcomes."}]},{"id":"blk-65315","kind":"heading","level":2,"spans":[{"id":"spn-95576","text":"What problem does it solve?"}]},{"id":"blk-65316","kind":"paragraph","spans":[{"id":"spn-95577","text":"It gives agents durable, evolving memory and better decision quality over time by combining:"}]},{"id":"blk-65317","items":[{"blocks":[{"id":"blk-65319","kind":"paragraph","spans":[{"id":"spn-95578","text":"semantic retrieval"}]}],"id":"blk-65318","kind":"list-item"},{"blocks":[{"id":"blk-65321","kind":"paragraph","spans":[{"id":"spn-95579","text":"graph neighborhood expansion"}]}],"id":"blk-65320","kind":"list-item"},{"blocks":[{"id":"blk-65323","kind":"paragraph","spans":[{"id":"spn-95580","text":"causal outcome feedback"}]}],"id":"blk-65322","kind":"list-item"},{"blocks":[{"id":"blk-65325","kind":"paragraph","spans":[{"id":"spn-95581","text":"goal tracking"}]}],"id":"blk-65324","kind":"list-item"},{"blocks":[{"id":"blk-65327","kind":"paragraph","spans":[{"id":"spn-95582","text":"topology-aware routing ("},{"id":"spn-95583","marks":["code"],"text":"fast"},{"id":"spn-95584","text":" vs "},{"id":"spn-95585","marks":["code"],"text":"deliberate"},{"id":"spn-95586","text":")"}]}],"id":"blk-65326","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65328","kind":"heading","level":2,"spans":[{"id":"spn-95587","text":"What are the core node types?"}]},{"id":"blk-65329","kind":"paragraph","spans":[{"id":"spn-95588","text":"Use node types intentionally (6 types):"}]},{"id":"blk-65330","items":[{"blocks":[{"id":"blk-65332","kind":"paragraph","spans":[{"id":"spn-95589","marks":["code"],"text":"semantic"},{"id":"spn-95590","text":" — facts, architecture, definitions"}]}],"id":"blk-65331","kind":"list-item"},{"blocks":[{"id":"blk-65334","kind":"paragraph","spans":[{"id":"spn-95591","marks":["code"],"text":"procedural"},{"id":"spn-95592","text":" — workflows and how-to steps"}]}],"id":"blk-65333","kind":"list-item"},{"blocks":[{"id":"blk-65336","kind":"paragraph","spans":[{"id":"spn-95593","marks":["code"],"text":"episodic"},{"id":"spn-95594","text":" — events and observations"}]}],"id":"blk-65335","kind":"list-item"},{"blocks":[{"id":"blk-65338","kind":"paragraph","spans":[{"id":"spn-95595","marks":["code"],"text":"temporal"},{"id":"spn-95596","text":" — time-indexed observations, monitoring events"}]}],"id":"blk-65337","kind":"list-item"},{"blocks":[{"id":"blk-65340","kind":"paragraph","spans":[{"id":"spn-95597","marks":["code"],"text":"outcome"},{"id":"spn-95598","text":" — empirical results of actions (grounding)"}]}],"id":"blk-65339","kind":"list-item"},{"blocks":[{"id":"blk-65342","kind":"paragraph","spans":[{"id":"spn-95599","marks":["code"],"text":"goal"},{"id":"spn-95600","text":" — durable intent, objectives, targets"}]}],"id":"blk-65341","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65343","kind":"heading","level":2,"spans":[{"id":"spn-95601","text":"What are the core edge types?"}]},{"id":"blk-65344","kind":"paragraph","spans":[{"id":"spn-95602","text":"16 edge types (including 2 legacy aliases):"}]},{"id":"blk-65345","items":[{"blocks":[{"id":"blk-65347","kind":"paragraph","spans":[{"id":"spn-95603","marks":["code"],"text":"causes"},{"id":"spn-95604","text":", "},{"id":"spn-95605","marks":["code"],"text":"resolves"},{"id":"spn-95606","text":" — causal attribution"}]}],"id":"blk-65346","kind":"list-item"},{"blocks":[{"id":"blk-65349","kind":"paragraph","spans":[{"id":"spn-95607","marks":["code"],"text":"supports"},{"id":"spn-95608","text":", "},{"id":"spn-95609","marks":["code"],"text":"contradicts"},{"id":"spn-95610","text":" — evidential"}]}],"id":"blk-65348","kind":"list-item"},{"blocks":[{"id":"blk-65351","kind":"paragraph","spans":[{"id":"spn-95611","marks":["code"],"text":"related_to"},{"id":"spn-95612","text":", "},{"id":"spn-95613","marks":["code"],"text":"similar_to"},{"id":"spn-95614","text":" — topical affinity"}]}],"id":"blk-65350","kind":"list-item"},{"blocks":[{"id":"blk-65353","kind":"paragraph","spans":[{"id":"spn-95615","marks":["code"],"text":"part_of"},{"id":"spn-95616","text":", "},{"id":"spn-95617","marks":["code"],"text":"follows"},{"id":"spn-95618","text":", "},{"id":"spn-95619","marks":["code"],"text":"supersedes"},{"id":"spn-95620","text":", "},{"id":"spn-95621","marks":["code"],"text":"depends_on"},{"id":"spn-95622","text":" — structural"}]}],"id":"blk-65352","kind":"list-item"},{"blocks":[{"id":"blk-65355","kind":"paragraph","spans":[{"id":"spn-95623","marks":["code"],"text":"temporal_before"},{"id":"spn-95624","text":", "},{"id":"spn-95625","marks":["code"],"text":"temporal_after"},{"id":"spn-95626","text":", "},{"id":"spn-95627","marks":["code"],"text":"co_occurs"},{"id":"spn-95628","text":" — temporal ordering"}]}],"id":"blk-65354","kind":"list-item"},{"blocks":[{"id":"blk-65357","kind":"paragraph","spans":[{"id":"spn-95629","marks":["code"],"text":"derived_from"},{"id":"spn-95630","text":" — provenance"}]}],"id":"blk-65356","kind":"list-item"},{"blocks":[{"id":"blk-65359","kind":"paragraph","spans":[{"id":"spn-95631","text":"Legacy aliases: "},{"id":"spn-95632","marks":["code"],"text":"causal"},{"id":"spn-95633","text":", "},{"id":"spn-95634","marks":["code"],"text":"related"},{"id":"spn-95635","text":" (backward-compatible)"}]}],"id":"blk-65358","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65360","kind":"paragraph","spans":[{"id":"spn-95636","text":"Default edge weight is 0.3. Edges should be added only when they improve retrieval quality or provenance clarity."}]},{"id":"blk-65361","kind":"heading","level":2,"spans":[{"id":"spn-95637","text":"How does retrieval work?"}]},{"id":"blk-65362","kind":"paragraph","spans":[{"id":"spn-95638","marks":["code"],"text":"retrieve_context"},{"id":"spn-95639","text":" generally does:"}]},{"id":"blk-65363","items":[{"blocks":[{"id":"blk-65365","kind":"paragraph","spans":[{"id":"spn-95640","text":"similarity retrieval"}]}],"id":"blk-65364","kind":"list-item"},{"blocks":[{"id":"blk-65367","kind":"paragraph","spans":[{"id":"spn-95641","text":"graph expansion"}]}],"id":"blk-65366","kind":"list-item"},{"blocks":[{"id":"blk-65369","kind":"paragraph","spans":[{"id":"spn-95642","text":"ranking with confidence-aware scoring"}]}],"id":"blk-65368","kind":"list-item"},{"blocks":[{"id":"blk-65371","kind":"paragraph","spans":[{"id":"spn-95643","text":"topology analysis (SCC/κ-aware metadata)"}]}],"id":"blk-65370","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65372","kind":"paragraph","spans":[{"id":"spn-95644","text":"Results include a "},{"id":"spn-95645","marks":["code"],"text":"causal_context"},{"id":"spn-95646","text":" array for later feedback via "},{"id":"spn-95647","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-95648","text":"."}]},{"id":"blk-65373","kind":"heading","level":2,"spans":[{"id":"spn-95649","text":"What is "},{"id":"spn-95650",