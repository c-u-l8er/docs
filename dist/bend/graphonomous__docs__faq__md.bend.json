{"bendscript":"0.1","blocks":[{"id":"blk-40981","kind":"heading","level":1,"spans":[{"id":"spn-45641","text":"Graphonomous FAQ"}]},{"id":"blk-40982","kind":"paragraph","spans":[{"id":"spn-45642","text":"This page answers the most common questions about Graphonomous, its MCP interface, and operating model."}]},{"id":"blk-40983","kind":"heading","level":2,"spans":[{"id":"spn-45643","text":"What is Graphonomous?"}]},{"id":"blk-40984","kind":"paragraph","spans":[{"id":"spn-45644","text":"Graphonomous is a continual-learning memory engine for AI agents. It stores knowledge as a graph, supports confidence-updating feedback loops, and exposes all capabilities through MCP tools/resources."}]},{"id":"blk-40985","kind":"paragraph","spans":[{"id":"spn-45645","text":"---"}]},{"id":"blk-40986","kind":"heading","level":2,"spans":[{"id":"spn-45646","text":"Does Graphonomous retrain model weights?"}]},{"id":"blk-40987","kind":"paragraph","spans":[{"id":"spn-45647","text":"No. Graphonomous does "},{"id":"spn-45648","marks":["bold"],"text":"not"},{"id":"spn-45649","text":" retrain model weights. Learning happens in the memory graph by storing knowledge and updating confidence based on outcomes."}]},{"id":"blk-40988","kind":"paragraph","spans":[{"id":"spn-45650","text":"---"}]},{"id":"blk-40989","kind":"heading","level":2,"spans":[{"id":"spn-45651","text":"What problem does it solve?"}]},{"id":"blk-40990","kind":"paragraph","spans":[{"id":"spn-45652","text":"It gives agents durable, evolving memory and better decision quality over time by combining:"}]},{"id":"blk-40991","items":[{"blocks":[{"id":"blk-40993","kind":"paragraph","spans":[{"id":"spn-45653","text":"semantic retrieval"}]}],"id":"blk-40992","kind":"list-item"},{"blocks":[{"id":"blk-40995","kind":"paragraph","spans":[{"id":"spn-45654","text":"graph neighborhood expansion"}]}],"id":"blk-40994","kind":"list-item"},{"blocks":[{"id":"blk-40997","kind":"paragraph","spans":[{"id":"spn-45655","text":"causal outcome feedback"}]}],"id":"blk-40996","kind":"list-item"},{"blocks":[{"id":"blk-40999","kind":"paragraph","spans":[{"id":"spn-45656","text":"goal tracking"}]}],"id":"blk-40998","kind":"list-item"},{"blocks":[{"id":"blk-41001","kind":"paragraph","spans":[{"id":"spn-45657","text":"topology-aware routing ("},{"id":"spn-45658","marks":["code"],"text":"fast"},{"id":"spn-45659","text":" vs "},{"id":"spn-45660","marks":["code"],"text":"deliberate"},{"id":"spn-45661","text":")"}]}],"id":"blk-41000","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41002","kind":"paragraph","spans":[{"id":"spn-45662","text":"---"}]},{"id":"blk-41003","kind":"heading","level":2,"spans":[{"id":"spn-45663","text":"What are the core node types?"}]},{"id":"blk-41004","kind":"paragraph","spans":[{"id":"spn-45664","text":"Use node types intentionally (6 types):"}]},{"id":"blk-41005","items":[{"blocks":[{"id":"blk-41007","kind":"paragraph","spans":[{"id":"spn-45665","marks":["code"],"text":"semantic"},{"id":"spn-45666","text":" — facts, architecture, definitions"}]}],"id":"blk-41006","kind":"list-item"},{"blocks":[{"id":"blk-41009","kind":"paragraph","spans":[{"id":"spn-45667","marks":["code"],"text":"procedural"},{"id":"spn-45668","text":" — workflows and how-to steps"}]}],"id":"blk-41008","kind":"list-item"},{"blocks":[{"id":"blk-41011","kind":"paragraph","spans":[{"id":"spn-45669","marks":["code"],"text":"episodic"},{"id":"spn-45670","text":" — events and observations"}]}],"id":"blk-41010","kind":"list-item"},{"blocks":[{"id":"blk-41013","kind":"paragraph","spans":[{"id":"spn-45671","marks":["code"],"text":"temporal"},{"id":"spn-45672","text":" — time-indexed observations, monitoring events"}]}],"id":"blk-41012","kind":"list-item"},{"blocks":[{"id":"blk-41015","kind":"paragraph","spans":[{"id":"spn-45673","marks":["code"],"text":"outcome"},{"id":"spn-45674","text":" — empirical results of actions (grounding)"}]}],"id":"blk-41014","kind":"list-item"},{"blocks":[{"id":"blk-41017","kind":"paragraph","spans":[