pn-46900","marks":["code"],"text":"causal_context"},{"id":"spn-46901","text":" and why does it matter?"}]},{"id":"blk-41530","kind":"paragraph","spans":[{"id":"spn-46902","marks":["code"],"text":"causal_context"},{"id":"spn-46903","text":" is the list of node IDs that informed the current action. You should pass those IDs into "},{"id":"spn-46904","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-46905","text":" so Graphonomous can update confidence on the actual causal nodes."}]},{"id":"blk-41531","kind":"paragraph","spans":[{"id":"spn-46906","text":"---"}]},{"id":"blk-41532","kind":"heading","level":2,"spans":[{"id":"spn-46907","text":"What outcomes can I report?"}]},{"id":"blk-41533","kind":"paragraph","spans":[{"id":"spn-46908","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-46909","text":" supports:"}]},{"id":"blk-41534","items":[{"blocks":[{"id":"blk-41536","kind":"paragraph","spans":[{"id":"spn-46910","marks":["code"],"text":"success"}]}],"id":"blk-41535","kind":"list-item"},{"blocks":[{"id":"blk-41538","kind":"paragraph","spans":[{"id":"spn-46911","marks":["code"],"text":"partial_success"}]}],"id":"blk-41537","kind":"list-item"},{"blocks":[{"id":"blk-41540","kind":"paragraph","spans":[{"id":"spn-46912","marks":["code"],"text":"failure"}]}],"id":"blk-41539","kind":"list-item"},{"blocks":[{"id":"blk-41542","kind":"paragraph","spans":[{"id":"spn-46913","marks":["code"],"text":"timeout"}]}],"id":"blk-41541","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41543","kind":"paragraph","spans":[{"id":"spn-46914","text":"Use "},{"id":"spn-46915","marks":["code"],"text":"timeout"},{"id":"spn-46916","text":" when an action did not complete in time (instead of incorrectly marking it as failure)."}]},{"id":"blk-41544","kind":"paragraph","spans":[{"id":"spn-46917","text":"---"}]},{"id":"blk-41545","kind":"heading","level":2,"spans":[{"id":"spn-46918","text":"How do goals work?"}]},{"id":"blk-41546","kind":"paragraph","spans":[{"id":"spn-46919","text":"Graphonomous includes durable GoalGraph operations:"}]},{"id":"blk-41547","items":[{"blocks":[{"id":"blk-41549","kind":"paragraph","spans":[{"id":"spn-46920","text":"create/list/get/update/delete goals"}]}],"id":"blk-41548","kind":"list-item"},{"blocks":[{"id":"blk-41551","kind":"paragraph","spans":[{"id":"spn-46921","text":"transition status"}]}],"id":"blk-41550","kind":"list-item"},{"blocks":[{"id":"blk-41553","kind":"paragraph","spans":[{"id":"spn-46922","text":"set progress"}]}],"id":"blk-41552","kind":"list-item"},{"blocks":[{"id":"blk-41555","kind":"paragraph","spans":[{"id":"spn-46923","text":"link/unlink evidence nodes"}]}],"id":"blk-41554","kind":"list-item"},{"blocks":[{"id":"blk-41557","kind":"paragraph","spans":[{"id":"spn-46924","text":"run epistemic review ("},{"id":"spn-46925","marks":["code"],"text":"review_goal"},{"id":"spn-46926","text":")"}]}],"id":"blk-41556","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41558","kind":"paragraph","spans":[{"id":"spn-46927","text":"Typical statuses include "},{"id":"spn-46928","marks":["code"],"text":"proposed"},{"id":"spn-46929","text":", "},{"id":"spn-46930","marks":["code"],"text":"active"},{"id":"spn-46931","text":", "},{"id":"spn-46932","marks":["code"],"text":"blocked"},{"id":"spn-46933","text":", "},{"id":"spn-46934","marks":["code"],"text":"completed"},{"id":"spn-46935","text":", and "},{"id":"spn-46936","marks":["code"],"text":"abandoned"},{"id":"spn-46937","text":"."}]},{"id":"blk-41559","kind":"paragraph","spans":[{"id":"spn-46938","text":"---"}]},{"id":"blk-41560","kind":"heading","level":2,"spans":[{"id":"spn-46939","text":"What is coverage review?"}]},{"id":"blk-41561","kind":"paragraph","spans":[{"id":"spn-46940","marks":["code"],"text":"review_goal"},{"id":"spn-46941","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-41562","items":[{"blocks":[{"id":"blk-41564","kind":"paragraph","spans":[{"id":"spn-46942","marks":["code"],"text":"act"},{"id":"spn-46943","text":" (enough coverage)"}]}],"id":"blk-41563","kind":"list-item"},{"blocks":[{"id":"blk-41566","kind":"paragraph","spans":[{"id":"spn-46944","marks":["code"],"text":"learn"},{"id":"spn-46945","text":" (need more context)"}]}],"id":"blk-41565","kind":"list-item"},{"blocks":[{"id":"blk-41568","kind":"paragraph","spans":[{"id":"spn-46946","marks":["code"],"text":"escalate"},{"id":"spn-46947","text":" (insufficient/too risky)"}]}],"id":"blk-41567","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41569","kind":"paragraph","spans":[{"id":"spn-46948","text":"---"}]},{"id":"blk-41570","kind":"heading","level":2,"spans":[{"id":"spn-46949","text":"What does topology-aware routing mean?"}]},{"id":"blk-41571","kind":"paragraph","spans":[{"id":"spn-46950","text":"Graphonomous analyzes retrieved subgraphs for cycles and complexity. If topology is simple, routing is "},{"id":"spn-46951","marks":["code"],"text":"fast"},{"id":"spn-46952","text":". If cyclic complexity is higher, routing may indicate "},{"id":"spn-46953","marks":["code"],"text":"deliberate"},{"id":"spn-46954","text":", signaling deeper reasoning is safer."}]},{"id":"blk-41572","kind":"paragraph","spans":[{"id":"spn-46955","text":"---"}]},{"id":"blk-41573","kind":"heading","level":2,"spans":[{"id":"spn-46956","text":"What does consolidation do?"}]},{"id":"blk-41574","kind":"paragraph","spans":[{"id":"spn-46957","text":"Consolidation is a 7-stage periodic memory maintenance pipeline:"}]},{"id":"blk-41575","kind":"paragraph","spans":[{"id":"spn-46958","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-41576","kind":"paragraph","spans":[{"id":"spn-46959","text":"Use "},{"id":"spn-46960","marks":["code"],"text":"run_consolidation"},{"id":"spn-46961","text":" to trigger/inspect cycles manually when needed."}]},{"id":"blk-41577","kind":"paragraph","spans":[{"id":"spn-46962","text":"---"}]},{"id":"blk-41578","kind":"heading","level":2,"spans":[{"id":"spn-46963","text":"Is Graphonomous usable from constrained machines?"}]},{"id":"blk-41579","kind":"paragraph","spans":[{"id":"spn-46964","text":"Yes. It is designed for local operation with practical defaults and fallback modes. A common setup uses a local SQLite DB path and a lightweight embedder backend configuration for reliability."}]},{"id":"blk-41580","kind":"paragraph","spans":[{"id":"spn-46965","text":"---"}]},{"id":"blk-41581","kind":"heading","level":2,"spans":[{"id":"spn-46966","text":"How do I run it quickly?"}]},{"id":"blk-41582","kind":"paragraph","spans":[{"id":"spn-46967","text":"Typical options:"}]},{"id":"blk-41583","items":[{"blocks":[{"id":"blk-41585","kind":"paragraph","spans":[{"id":"spn-46968","text":"run as MCP server over stdio"}]}],"id":"blk-41584","kind":"list-item"},{"blocks":[{"id":"blk-41587","kind":"paragraph","spans":[{"id":"spn-46969","text":"run one-shot traversal/scan mode"}]}],"id":"blk-41586","kind":"list-item"},{"blocks":[{"id":"blk-41589","kind":"paragraph","spans":[{"id":"spn-46970","text":"run watch mode for ongoing ingestion"}]}],"id":"blk-41588","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41590","kind":"paragraph","spans":[{"id":"spn-46971","text":"See "},{"id":"spn-46972","marks":["code"],"text":"quickstart"},{"id":"spn-46973","text":" and "},{"id":"spn-46974","marks":["code"],"text":"runtime"},{"id":"spn-46975","text":" docs pages for exact commands and settings."}]},{"id":"blk-41591","kind":"paragraph","spans":[{"id":"spn-46976","text":"---"}]},{"id":"blk-41592","kind":"heading","level":2,"spans":[{"id":"spn-46977","text":"How should agents use Graphonomous by default?"}]},{"id":"blk-41593","kind":"paragraph","spans":[{"id":"spn-46978","text":"For non-trivial work, use this loop:"}]},{"id":"blk-41594","kind":"paragraph","spans":[{"id":"spn-46979","text":"1. retrieve context 2. reason and act 3. store durable knowledge 4. report outcomes 5. maintain via consolidation"}]},{"id":"blk-41595","kind":"paragraph","spans":[{"id":"spn-46980","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-41596","kind":"paragraph","spans":[{"id":"spn-46981","text":"---"}]},{"id":"blk-41597","kind":"heading","level":2,"spans":[{"id":"spn-46982","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-41598","kind":"paragraph","spans":[{"id":"spn-46983","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-41599","items":[{"blocks":[{"id":"blk-41601","kind":"paragraph","spans":[{"id":"spn-46984","text":"retrieval and graph query"}]}],"id":"blk-41600","kind":"list-item"},{"blocks":[{"id":"blk-41603","kind":"paragraph","spans":[{"id":"spn-46985","text":"node/edge storage"}]}],"id":"blk-41602","kind":"list-item"},{"blocks":[{"id":"blk-41605","kind":"paragraph","spans":[{"id":"spn-46986","text":"outcome learning"}]}],"id":"blk-41604","kind":"list-item"},{"blocks":[{"id":"blk-41607","kind":"paragraph","spans":[{"id":"spn-46987","text":"goal management and review"}]}],"id":"blk-41606","kind":"list-item"},{"blocks":[{"id":"blk-41609","kind":"paragraph","spans":[{"id":"spn-46988","text":"topology analysis and deliberation"}]}],"id":"blk-41608","kind":"list-item"},{"blocks":[{"id":"blk-41611","kind":"paragraph","spans":[{"id":"spn-46989","text":"attention and consolidation"}]}],"id":"blk-41610","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41612","kind":"paragraph","spans":[{"id":"spn-46990","text":"---"}]},{"id":"blk-41613","kind":"heading","level":2,"spans":[{"id":"spn-46991","text":"Is there a best-practice checklist?"}]},{"id":"blk-41614","kind":"paragraph","spans":[{"id":"spn-46992","text":"Yes—short version:"}]},{"id":"blk-41615","items":[{"blocks":[{"id":"blk-41617","kind":"paragraph","spans":[{"id":"spn-46993","text":"retrieve first for meaningful tasks"}]}],"id":"blk-41616","kind":"list-item"},{"blocks":[{"id":"blk-41619","kind":"paragraph","spans":[{"id":"spn-46994","text":"store atomic nodes (avoid “kitchen-sink” nodes)"}]}],"id":"blk-41618","kind":"list-item"},{"blocks":[{"id":"blk-41621","kind":"paragraph","spans":[{"id":"spn-46995","text":"keep confidence calibrated to evidence quality"}]}],"id":"blk-41620","kind":"list-item"},{"blocks":[{"id":"blk-41623","kind":"paragraph","spans":[{"id":"spn-46996","text":"preserve causal IDs for feedback"}]}],"id":"blk-41622","kind":"list-item"},{"blocks":[{"id":"blk-41625","kind":"paragraph","spans":[{"id":"spn-46997","text":"avoid fabricated provenance/signals"}]}],"id":"blk-41624","kind":"list-item"},{"blocks":[{"id":"blk-41627","kind":"paragraph","spans":[{"id":"spn-46998","text":"review goals before consequential actions"}]}],"id":"blk-41626","kind":"list-item"},{"blocks":[{"id":"blk-41629","kind":"paragraph","spans":[{"id":"spn-46999","text":"consolidate periodically"}]}],"id":"blk-41628","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41630","kind":"paragraph","spans":[{"id":"spn-47000","text":"---"}]},{"id":"blk-41631","kind":"paragraph","spans":[{"id":"spn-47001","text":"If you want a deeper operational playbook, start with the docs "},{"id":"spn-47002","marks":["code"],"text":"quickstart"},{"id":"spn-47003","text":", then "},{"id":"spn-47004","marks":["code"],"text":"architecture"},{"id":"spn-47005","text":", then the workflows and anti-patterns sections."}]}],"edges":[],"id":"bagaaieralj2jjrccr7uamibjfhqclvle35abndwscojqpwkcdkktbxnxorvq","vocabulary":"ampersand.docs.fs.v1"}