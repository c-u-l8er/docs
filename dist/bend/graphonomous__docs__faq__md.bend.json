should agents use Graphonomous by default?"}]},{"id":"blk-65432","kind":"paragraph","spans":[{"id":"spn-95673","text":"For non-trivial work, use this loop:"}]},{"id":"blk-65433","items":[{"blocks":[{"id":"blk-65435","kind":"paragraph","spans":[{"id":"spn-95674","text":"retrieve context"}]}],"id":"blk-65434","kind":"list-item"},{"blocks":[{"id":"blk-65437","kind":"paragraph","spans":[{"id":"spn-95675","text":"reason and act"}]}],"id":"blk-65436","kind":"list-item"},{"blocks":[{"id":"blk-65439","kind":"paragraph","spans":[{"id":"spn-95676","text":"store durable knowledge"}]}],"id":"blk-65438","kind":"list-item"},{"blocks":[{"id":"blk-65441","kind":"paragraph","spans":[{"id":"spn-95677","text":"report outcomes"}]}],"id":"blk-65440","kind":"list-item"},{"blocks":[{"id":"blk-65443","kind":"paragraph","spans":[{"id":"spn-95678","text":"maintain via consolidation"}]}],"id":"blk-65442","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65444","kind":"paragraph","spans":[{"id":"spn-95679","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-65445","kind":"heading","level":2,"spans":[{"id":"spn-95680","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-65446","kind":"paragraph","spans":[{"id":"spn-95681","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-65447","items":[{"blocks":[{"id":"blk-65449","kind":"paragraph","spans":[{"id":"spn-95682","text":"retrieval and graph query"}]}],"id":"blk-65448","kind":"list-item"},{"blocks":[{"id":"blk-65451","kind":"paragraph","spans":[{"id":"spn-95683","text":"node/edge storage"}]}],"id":"blk-65450","kind":"list-item"},{"blocks":[{"id":"blk-65453","kind":"paragraph","spans":[{"id":"spn-95684","text":"outcome learning"}]}],"id":"blk-65452","kind":"list-item"},{"blocks":[{"id":"blk-65455","kind":"paragraph","spans":[{"id":"spn-95685","text":"goal management and review"}]}],"id":"blk-65454","kind":"list-item"},{"blocks":[{"