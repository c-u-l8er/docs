xt":"create/list/get/update/delete goals"}]}],"id":"blk-65379","kind":"list-item"},{"blocks":[{"id":"blk-65382","kind":"paragraph","spans":[{"id":"spn-95616","text":"transition status"}]}],"id":"blk-65381","kind":"list-item"},{"blocks":[{"id":"blk-65384","kind":"paragraph","spans":[{"id":"spn-95617","text":"set progress"}]}],"id":"blk-65383","kind":"list-item"},{"blocks":[{"id":"blk-65386","kind":"paragraph","spans":[{"id":"spn-95618","text":"link/unlink evidence nodes"}]}],"id":"blk-65385","kind":"list-item"},{"blocks":[{"id":"blk-65388","kind":"paragraph","spans":[{"id":"spn-95619","text":"run epistemic review ("},{"id":"spn-95620","marks":["code"],"text":"review_goal"},{"id":"spn-95621","text":")"}]}],"id":"blk-65387","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65389","kind":"paragraph","spans":[{"id":"spn-95622","text":"Typical statuses include "},{"id":"spn-95623","marks":["code"],"text":"proposed"},{"id":"spn-95624","text":", "},{"id":"spn-95625","marks":["code"],"text":"active"},{"id":"spn-95626","text":", "},{"id":"spn-95627","marks":["code"],"text":"blocked"},{"id":"spn-95628","text":", "},{"id":"spn-95629","marks":["code"],"text":"completed"},{"id":"spn-95630","text":", and "},{"id":"spn-95631","marks":["code"],"text":"abandoned"},{"id":"spn-95632","text":"."}]},{"id":"blk-65390","kind":"heading","level":2,"spans":[{"id":"spn-95633","text":"What is coverage review?"}]},{"id":"blk-65391","kind":"paragraph","spans":[{"id":"spn-95634","marks":["code"],"text":"review_goal"},{"id":"spn-95635","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-65392","items":[{"blocks":[{"id":"blk-65394","kind":"paragraph","spans":[{"id":"spn-95636","marks":["code"],"text":"act"},{"id":"spn-95637","text":" (enough coverage)"}]}],"id":"blk-65393","kind":"list-item"},{"blocks":[{"id":"blk-65396","kind":"paragraph","spans":[{"id":"spn-95638","marks":["code"],"text":"learn"},{"id":"sp