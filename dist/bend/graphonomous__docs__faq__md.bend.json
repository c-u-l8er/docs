{"bendscript":"0.1","blocks":[{"id":"blk-41953","kind":"heading","level":1,"spans":[{"id":"spn-47935","text":"Graphonomous FAQ"}]},{"id":"blk-41954","kind":"paragraph","spans":[{"id":"spn-47936","text":"This page answers the most common questions about Graphonomous, its MCP interface, and operating model."}]},{"id":"blk-41955","kind":"heading","level":2,"spans":[{"id":"spn-47937","text":"What is Graphonomous?"}]},{"id":"blk-41956","kind":"paragraph","spans":[{"id":"spn-47938","text":"Graphonomous is a continual-learning memory engine for AI agents. It stores knowledge as a graph, supports confidence-updating feedback loops, and exposes all capabilities through MCP tools/resources."}]},{"id":"blk-41957","kind":"paragraph","spans":[{"id":"spn-47939","text":"---"}]},{"id":"blk-41958","kind":"heading","level":2,"spans":[{"id":"spn-47940","text":"Does Graphonomous retrain model weights?"}]},{"id":"blk-41959","kind":"paragraph","spans":[{"id":"spn-47941","text":"No. Graphonomous does "},{"id":"spn-47942","marks":["bold"],"text":"not"},{"id":"spn-47943","text":" retrain model weights. Learning happens in the memory graph by storing knowledge and updating confidence based on outcomes."}]},{"id":"blk-41960","kind":"paragraph","spans":[{"id":"spn-47944","text":"---"}]},{"id":"blk-41961","kind":"heading","level":2,"spans":[{"id":"spn-47945","text":"What problem does it solve?"}]},{"id":"blk-41962","kind":"paragraph","spans":[{"id":"spn-47946","text":"It gives agents durable, evolving memory and better decision quality over time by combining:"}]},{"id":"blk-41963","items":[{"blocks":[{"id":"blk-41965","kind":"paragraph","spans":[{"id":"spn-47947","text":"semantic retrieval"}]}],"id":"blk-41964","kind":"list-item"},{"blocks":[{"id":"blk-41967","kind":"paragraph","spans":[{"id":"spn-47948","text":"graph neighborhood expansion"}]}],"id":"blk-41966","kind":"list-item"},{"blocks":[{"id":"blk-41969","kind":"paragraph","spans":[{"id":"spn-47949","text":"causal outcome feedback"}]}],"id":"blk-41968","kind":"list-item"},{"blocks":[{"id":"blk-41971","kind":"paragraph","spans":[{"id":"spn-47950","text":"goal tracking"}]}],"id":"blk-41970","kind":"list-item"},{"blocks":[{"id":"blk-41973","kind":"paragraph","spans":[{"id":"spn-47951","text":"topology-aware routing ("},{"id":"spn-47952","marks":["code"],"text":"fast"},{"id":"spn-47953","text":" vs "},{"id":"spn-47954","marks":["code"],"text":"deliberate"},{"id":"spn-47955","text":")"}]}],"id":"blk-41972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41974","kind":"paragraph","spans":[{"id":"spn-47956","text":"---"}]},{"id":"blk-41975","kind":"heading","level":2,"spans":[{"id":"spn-47957","text":"What are the core node types?"}]},{"id":"blk-41976","kind":"paragraph","spans":[{"id":"spn-47958","text":"Use node types intentionally (6 types):"}]},{"id":"blk-41977","items":[{"blocks":[{"id":"blk-41979","kind":"paragraph","spans":[{"id":"spn-47959","marks":["code"],"text":"semantic"},{"id":"spn-47960","text":" — facts, architecture, definitions"}]}],"id":"blk-41978","kind":"list-item"},{"blocks":[{"id":"blk-41981","kind":"paragraph","spans":[{"id":"spn-47961","marks":["code"],"text":"procedural"},{"id":"spn-47962","text":" — workflows and how-to steps"}]}],"id":"blk-41980","kind":"list-item"},{"blocks":[{"id":"blk-41983","kind":"paragraph","spans":[{"id":"spn-47963","marks":["code"],"text":"episodic"},{"id":"spn-47964","text":" — events and observations"}]}],"id":"blk-41982","kind":"list-item"},{"blocks":[{"id":"blk-41985","kind":"paragraph","spans":[{"id":"spn-47965","marks":["code"],"text":"temporal"},{"id":"spn-47966","text":" — time-indexed observations, monitoring events"}]}],"id":"blk-41984","kind":"list-item"},{"blocks":[{"id":"blk-41987","kind":"paragraph","spans":[{"id":"spn-47967","marks":["code"],"text":"outcome"},{"id":"spn-47968","text":" — empirical results of actions (grounding)"}]}],"id":"blk-41986","kind":"list-item"},{"blocks":[{"id":"blk-41989","kind":"paragraph","spans":[