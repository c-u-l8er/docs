xt":"create/list/get/update/delete goals"}]}],"id":"blk-65516","kind":"list-item"},{"blocks":[{"id":"blk-65519","kind":"paragraph","spans":[{"id":"spn-95817","text":"transition status"}]}],"id":"blk-65518","kind":"list-item"},{"blocks":[{"id":"blk-65521","kind":"paragraph","spans":[{"id":"spn-95818","text":"set progress"}]}],"id":"blk-65520","kind":"list-item"},{"blocks":[{"id":"blk-65523","kind":"paragraph","spans":[{"id":"spn-95819","text":"link/unlink evidence nodes"}]}],"id":"blk-65522","kind":"list-item"},{"blocks":[{"id":"blk-65525","kind":"paragraph","spans":[{"id":"spn-95820","text":"run epistemic review ("},{"id":"spn-95821","marks":["code"],"text":"review_goal"},{"id":"spn-95822","text":")"}]}],"id":"blk-65524","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65526","kind":"paragraph","spans":[{"id":"spn-95823","text":"Typical statuses include "},{"id":"spn-95824","marks":["code"],"text":"proposed"},{"id":"spn-95825","text":", "},{"id":"spn-95826","marks":["code"],"text":"active"},{"id":"spn-95827","text":", "},{"id":"spn-95828","marks":["code"],"text":"blocked"},{"id":"spn-95829","text":", "},{"id":"spn-95830","marks":["code"],"text":"completed"},{"id":"spn-95831","text":", and "},{"id":"spn-95832","marks":["code"],"text":"abandoned"},{"id":"spn-95833","text":"."}]},{"id":"blk-65527","kind":"heading","level":2,"spans":[{"id":"spn-95834","text":"What is coverage review?"}]},{"id":"blk-65528","kind":"paragraph","spans":[{"id":"spn-95835","marks":["code"],"text":"review_goal"},{"id":"spn-95836","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-65529","items":[{"blocks":[{"id":"blk-65531","kind":"paragraph","spans":[{"id":"spn-95837","marks":["code"],"text":"act"},{"id":"spn-95838","text":" (enough coverage)"}]}],"id":"blk-65530","kind":"list-item"},{"blocks":[{"id":"blk-65533","kind":"paragraph","spans":[{"id":"spn-95839","marks":["code"],"text":"learn"},{"id":"sp