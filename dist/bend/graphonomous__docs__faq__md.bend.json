":[{"id":"spn-95749","text":"What are the core edge types?"}]},{"id":"blk-65470","kind":"paragraph","spans":[{"id":"spn-95750","text":"16 edge types (including 2 legacy aliases):"}]},{"id":"blk-65471","items":[{"blocks":[{"id":"blk-65473","kind":"paragraph","spans":[{"id":"spn-95751","marks":["code"],"text":"causes"},{"id":"spn-95752","text":", "},{"id":"spn-95753","marks":["code"],"text":"resolves"},{"id":"spn-95754","text":" — causal attribution"}]}],"id":"blk-65472","kind":"list-item"},{"blocks":[{"id":"blk-65475","kind":"paragraph","spans":[{"id":"spn-95755","marks":["code"],"text":"supports"},{"id":"spn-95756","text":", "},{"id":"spn-95757","marks":["code"],"text":"contradicts"},{"id":"spn-95758","text":" — evidential"}]}],"id":"blk-65474","kind":"list-item"},{"blocks":[{"id":"blk-65477","kind":"paragraph","spans":[{"id":"spn-95759","marks":["code"],"text":"related_to"},{"id":"spn-95760","text":", "},{"id":"spn-95761","marks":["code"],"text":"similar_to"},{"id":"spn-95762","text":" — topical affinity"}]}],"id":"blk-65476","kind":"list-item"},{"blocks":[{"id":"blk-65479","kind":"paragraph","spans":[{"id":"spn-95763","marks":["code"],"text":"part_of"},{"id":"spn-95764","text":", "},{"id":"spn-95765","marks":["code"],"text":"follows"},{"id":"spn-95766","text":", "},{"id":"spn-95767","marks":["code"],"text":"supersedes"},{"id":"spn-95768","text":", "},{"id":"spn-95769","marks":["code"],"text":"depends_on"},{"id":"spn-95770","text":" — structural"}]}],"id":"blk-65478","kind":"list-item"},{"blocks":[{"id":"blk-65481","kind":"paragraph","spans":[{"id":"spn-95771","marks":["code"],"text":"temporal_before"},{"id":"spn-95772","text":", "},{"id":"spn-95773","marks":["code"],"text":"temporal_after"},{"id":"spn-95774","text":", "},{"id":"spn-95775","marks":["code"],"text":"co_occurs"},{"id":"spn-95776","text":" — temporal ordering"}]}],"id":"blk-65480","kind":"list-item"},{"blocks":[{"id":"blk-65483","kind":"paragraph","spans":[{"id":"spn-95777","marks":["code"],"text":"der