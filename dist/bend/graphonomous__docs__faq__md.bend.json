pn-48020","marks":["code"],"text":"causal_context"},{"id":"spn-48021","text":" and why does it matter?"}]},{"id":"blk-42016","kind":"paragraph","spans":[{"id":"spn-48022","marks":["code"],"text":"causal_context"},{"id":"spn-48023","text":" is the list of node IDs that informed the current action. You should pass those IDs into "},{"id":"spn-48024","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-48025","text":" so Graphonomous can update confidence on the actual causal nodes."}]},{"id":"blk-42017","kind":"paragraph","spans":[{"id":"spn-48026","text":"---"}]},{"id":"blk-42018","kind":"heading","level":2,"spans":[{"id":"spn-48027","text":"What outcomes can I report?"}]},{"id":"blk-42019","kind":"paragraph","spans":[{"id":"spn-48028","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-48029","text":" supports:"}]},{"id":"blk-42020","items":[{"blocks":[{"id":"blk-42022","kind":"paragraph","spans":[{"id":"spn-48030","marks":["code"],"text":"success"}]}],"id":"blk-42021","kind":"list-item"},{"blocks":[{"id":"blk-42024","kind":"paragraph","spans":[{"id":"spn-48031","marks":["code"],"text":"partial_success"}]}],"id":"blk-42023","kind":"list-item"},{"blocks":[{"id":"blk-42026","kind":"paragraph","spans":[{"id":"spn-48032","marks":["code"],"text":"failure"}]}],"id":"blk-42025","kind":"list-item"},{"blocks":[{"id":"blk-42028","kind":"paragraph","spans":[{"id":"spn-48033","marks":["code"],"text":"timeout"}]}],"id":"blk-42027","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42029","kind":"paragraph","spans":[{"id":"spn-48034","text":"Use "},{"id":"spn-48035","marks":["code"],"text":"timeout"},{"id":"spn-48036","text":" when an action did not complete in time (instead of incorrectly marking it as failure)."}]},{"id":"blk-42030","kind":"paragraph","spans":[{"id":"spn-48037","text":"---"}]},{"id":"blk-42031","kind":"heading","level":2,"spans":[{"id":"spn-48038","text":"How do goals work?"}]},{"id":"blk-42032","kind":"paragraph","spans":[{"id":"spn-48039","text":"Graphonomous includes durable GoalGraph operations:"}]},{"id":"blk-42033","items":[{"blocks":[{"id":"blk-42035","kind":"paragraph","spans":[{"id":"spn-48040","text":"create/list/get/update/delete goals"}]}],"id":"blk-42034","kind":"list-item"},{"blocks":[{"id":"blk-42037","kind":"paragraph","spans":[{"id":"spn-48041","text":"transition status"}]}],"id":"blk-42036","kind":"list-item"},{"blocks":[{"id":"blk-42039","kind":"paragraph","spans":[{"id":"spn-48042","text":"set progress"}]}],"id":"blk-42038","kind":"list-item"},{"blocks":[{"id":"blk-42041","kind":"paragraph","spans":[{"id":"spn-48043","text":"link/unlink evidence nodes"}]}],"id":"blk-42040","kind":"list-item"},{"blocks":[{"id":"blk-42043","kind":"paragraph","spans":[{"id":"spn-48044","text":"run epistemic review ("},{"id":"spn-48045","marks":["code"],"text":"review_goal"},{"id":"spn-48046","text":")"}]}],"id":"blk-42042","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42044","kind":"paragraph","spans":[{"id":"spn-48047","text":"Typical statuses include "},{"id":"spn-48048","marks":["code"],"text":"proposed"},{"id":"spn-48049","text":", "},{"id":"spn-48050","marks":["code"],"text":"active"},{"id":"spn-48051","text":", "},{"id":"spn-48052","marks":["code"],"text":"blocked"},{"id":"spn-48053","text":", "},{"id":"spn-48054","marks":["code"],"text":"completed"},{"id":"spn-48055","text":", and "},{"id":"spn-48056","marks":["code"],"text":"abandoned"},{"id":"spn-48057","text":"."}]},{"id":"blk-42045","kind":"paragraph","spans":[{"id":"spn-48058","text":"---"}]},{"id":"blk-42046","kind":"heading","level":2,"spans":[{"id":"spn-48059","text":"What is coverage review?"}]},{"id":"blk-42047","kind":"paragraph","spans":[{"id":"spn-48060","marks":["code"],"text":"review_goal"},{"id":"spn-48061","text":" evaluates whether current knowledge is sufficient to proceed. It returns decision-oriented signals such as:"}]},{"id":"blk-42048","items":[{"blocks":[{"id":"blk-42050","kind":"paragraph","spans":[{"id":"spn-48062","marks":["code"],"text":"act"},{"id":"spn-48063","text":" (enough coverage)"}]}],"id":"blk-42049","kind":"list-item"},{"blocks":[{"id":"blk-42052","kind":"paragraph","spans":[{"id":"spn-48064","marks":["code"],"text":"learn"},{"id":"spn-48065","text":" (need more context)"}]}],"id":"blk-42051","kind":"list-item"},{"blocks":[{"id":"blk-42054","kind":"paragraph","spans":[{"id":"spn-48066","marks":["code"],"text":"escalate"},{"id":"spn-48067","text":" (insufficient/too risky)"}]}],"id":"blk-42053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42055","kind":"paragraph","spans":[{"id":"spn-48068","text":"---"}]},{"id":"blk-42056","kind":"heading","level":2,"spans":[{"id":"spn-48069","text":"What does topology-aware routing mean?"}]},{"id":"blk-42057","kind":"paragraph","spans":[{"id":"spn-48070","text":"Graphonomous analyzes retrieved subgraphs for cycles and complexity. If topology is simple, routing is "},{"id":"spn-48071","marks":["code"],"text":"fast"},{"id":"spn-48072","text":". If cyclic complexity is higher, routing may indicate "},{"id":"spn-48073","marks":["code"],"text":"deliberate"},{"id":"spn-48074","text":", signaling deeper reasoning is safer."}]},{"id":"blk-42058","kind":"paragraph","spans":[{"id":"spn-48075","text":"---"}]},{"id":"blk-42059","kind":"heading","level":2,"spans":[{"id":"spn-48076","text":"What does consolidation do?"}]},{"id":"blk-42060","kind":"paragraph","spans":[{"id":"spn-48077","text":"Consolidation is a 7-stage periodic memory maintenance pipeline:"}]},{"id":"blk-42061","kind":"paragraph","spans":[{"id":"spn-48078","text":"1. Confidence decay 2. Prune weak nodes 3. Prune weak edges 4. Strengthen co-activated edges 5. Merge similar nodes 6. Promote timescale (fast → medium → slow → glacial) 7. Generate abstractions from episodic clusters"}]},{"id":"blk-42062","kind":"paragraph","spans":[{"id":"spn-48079","text":"Use "},{"id":"spn-48080","marks":["code"],"text":"run_consolidation"},{"id":"spn-48081","text":" to trigger/inspect cycles manually when needed."}]},{"id":"blk-42063","kind":"paragraph","spans":[{"id":"spn-48082","text":"---"}]},{"id":"blk-42064","kind":"heading","level":2,"spans":[{"id":"spn-48083","text":"Is Graphonomous usable from constrained machines?"}]},{"id":"blk-42065","kind":"paragraph","spans":[{"id":"spn-48084","text":"Yes. It is designed for local operation with practical defaults and fallback modes. A common setup uses a local SQLite DB path and a lightweight embedder backend configuration for reliability."}]},{"id":"blk-42066","kind":"paragraph","spans":[{"id":"spn-48085","text":"---"}]},{"id":"blk-42067","kind":"heading","level":2,"spans":[{"id":"spn-48086","text":"How do I run it quickly?"}]},{"id":"blk-42068","kind":"paragraph","spans":[{"id":"spn-48087","text":"Typical options:"}]},{"id":"blk-42069","items":[{"blocks":[{"id":"blk-42071","kind":"paragraph","spans":[{"id":"spn-48088","text":"run as MCP server over stdio"}]}],"id":"blk-42070","kind":"list-item"},{"blocks":[{"id":"blk-42073","kind":"paragraph","spans":[{"id":"spn-48089","text":"run one-shot traversal/scan mode"}]}],"id":"blk-42072","kind":"list-item"},{"blocks":[{"id":"blk-42075","kind":"paragraph","spans":[{"id":"spn-48090","text":"run watch mode for ongoing ingestion"}]}],"id":"blk-42074","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42076","kind":"paragraph","spans":[{"id":"spn-48091","text":"See "},{"id":"spn-48092","marks":["code"],"text":"quickstart"},{"id":"spn-48093","text":" and "},{"id":"spn-48094","marks":["code"],"text":"runtime"},{"id":"spn-48095","text":" docs pages for exact commands and settings."}]},{"id":"blk-42077","kind":"paragraph","spans":[{"id":"spn-48096","text":"---"}]},{"id":"blk-42078","kind":"heading","level":2,"spans":[{"id":"spn-48097","text":"How should agents use Graphonomous by default?"}]},{"id":"blk-42079","kind":"paragraph","spans":[{"id":"spn-48098","text":"For non-trivial work, use this loop:"}]},{"id":"blk-42080","kind":"paragraph","spans":[{"id":"spn-48099","text":"1. retrieve context 2. reason and act 3. store durable knowledge 4. report outcomes 5. maintain via consolidation"}]},{"id":"blk-42081","kind":"paragraph","spans":[{"id":"spn-48100","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-42082","kind":"paragraph","spans":[{"id":"spn-48101","text":"---"}]},{"id":"blk-42083","kind":"heading","level":2,"spans":[{"id":"spn-48102","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-42084","kind":"paragraph","spans":[{"id":"spn-48103","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-42085","items":[{"blocks":[{"id":"blk-42087","kind":"paragraph","spans":[{"id":"spn-48104","text":"retrieval and graph query"}]}],"id":"blk-42086","kind":"list-item"},{"blocks":[{"id":"blk-42089","kind":"paragraph","spans":[{"id":"spn-48105","text":"node/edge storage"}]}],"id":"blk-42088","kind":"list-item"},{"blocks":[{"id":"blk-42091","kind":"paragraph","spans":[{"id":"spn-48106","text":"outcome learning"}]}],"id":"blk-42090","kind":"list-item"},{"blocks":[{"id":"blk-42093","kind":"paragraph","spans":[{"id":"spn-48107","text":"goal management and review"}]}],"id":"blk-42092","kind":"list-item"},{"blocks":[{"id":"blk-42095","kind":"paragraph","spans":[{"id":"spn-48108","text":"topology analysis and deliberation"}]}],"id":"blk-42094","kind":"list-item"},{"blocks":[{"id":"blk-42097","kind":"paragraph","spans":[{"id":"spn-48109","text":"attention and consolidation"}]}],"id":"blk-42096","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42098","kind":"paragraph","spans":[{"id":"spn-48110","text":"---"}]},{"id":"blk-42099","kind":"heading","level":2,"spans":[{"id":"spn-48111","text":"Is there a best-practice checklist?"}]},{"id":"blk-42100","kind":"paragraph","spans":[{"id":"spn-48112","text":"Yes—short version:"}]},{"id":"blk-42101","items":[{"blocks":[{"id":"blk-42103","kind":"paragraph","spans":[{"id":"spn-48113","text":"retrieve first for meaningful tasks"}]}],"id":"blk-42102","kind":"list-item"},{"blocks":[{"id":"blk-42105","kind":"paragraph","spans":[{"id":"spn-48114","text":"store atomic nodes (avoid “kitchen-sink” nodes)"}]}],"id":"blk-42104","kind":"list-item"},{"blocks":[{"id":"blk-42107","kind":"paragraph","spans":[{"id":"spn-48115","text":"keep confidence calibrated to evidence quality"}]}],"id":"blk-42106","kind":"list-item"},{"blocks":[{"id":"blk-42109","kind":"paragraph","spans":[{"id":"spn-48116","text":"preserve causal IDs for feedback"}]}],"id":"blk-42108","kind":"list-item"},{"blocks":[{"id":"blk-42111","kind":"paragraph","spans":[{"id":"spn-48117","text":"avoid fabricated provenance/signals"}]}],"id":"blk-42110","kind":"list-item"},{"blocks":[{"id":"blk-42113","kind":"paragraph","spans":[{"id":"spn-48118","text":"review goals before consequential actions"}]}],"id":"blk-42112","kind":"list-item"},{"blocks":[{"id":"blk-42115","kind":"paragraph","spans":[{"id":"spn-48119","text":"consolidate periodically"}]}],"id":"blk-42114","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42116","kind":"paragraph","spans":[{"id":"spn-48120","text":"---"}]},{"id":"blk-42117","kind":"paragraph","spans":[{"id":"spn-48121","text":"If you want a deeper operational playbook, start with the docs "},{"id":"spn-48122","marks":["code"],"text":"quickstart"},{"id":"spn-48123","text":", then "},{"id":"spn-48124","marks":["code"],"text":"architecture"},{"id":"spn-48125","text":", then the workflows and anti-patterns sections."}]}],"edges":[],"id":"bagaaieralv652qehfbxud4hdnneij52ddybe7s7jnmumnso5cdev74pbi7sq","vocabulary":"ampersand.docs.fs.v1"}