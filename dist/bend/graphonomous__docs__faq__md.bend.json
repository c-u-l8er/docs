should agents use Graphonomous by default?"}]},{"id":"blk-66397","kind":"paragraph","spans":[{"id":"spn-98513","text":"For non-trivial work, use this loop:"}]},{"id":"blk-66398","items":[{"blocks":[{"id":"blk-66400","kind":"paragraph","spans":[{"id":"spn-98514","text":"retrieve context"}]}],"id":"blk-66399","kind":"list-item"},{"blocks":[{"id":"blk-66402","kind":"paragraph","spans":[{"id":"spn-98515","text":"reason and act"}]}],"id":"blk-66401","kind":"list-item"},{"blocks":[{"id":"blk-66404","kind":"paragraph","spans":[{"id":"spn-98516","text":"store durable knowledge"}]}],"id":"blk-66403","kind":"list-item"},{"blocks":[{"id":"blk-66406","kind":"paragraph","spans":[{"id":"spn-98517","text":"report outcomes"}]}],"id":"blk-66405","kind":"list-item"},{"blocks":[{"id":"blk-66408","kind":"paragraph","spans":[{"id":"spn-98518","text":"maintain via consolidation"}]}],"id":"blk-66407","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-66409","kind":"paragraph","spans":[{"id":"spn-98519","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-66410","kind":"heading","level":2,"spans":[{"id":"spn-98520","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-66411","kind":"paragraph","spans":[{"id":"spn-98521","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-66412","items":[{"blocks":[{"id":"blk-66414","kind":"paragraph","spans":[{"id":"spn-98522","text":"retrieval and graph query"}]}],"id":"blk-66413","kind":"list-item"},{"blocks":[{"id":"blk-66416","kind":"paragraph","spans":[{"id":"spn-98523","text":"node/edge storage"}]}],"id":"blk-66415","kind":"list-item"},{"blocks":[{"id":"blk-66418","kind":"paragraph","spans":[{"id":"spn-98524","text":"outcome learning"}]}],"id":"blk-66417","kind":"list-item"},{"blocks":[{"id":"blk-66420","kind":"paragraph","spans":[{"id":"spn-98525","text":"goal management and review"}]}],"id":"blk-66419","kind":"list-item"},{"blocks":[{"