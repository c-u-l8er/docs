{"bendscript":"0.1","blocks":[{"id":"blk-41467","kind":"heading","level":1,"spans":[{"id":"spn-46815","text":"Graphonomous FAQ"}]},{"id":"blk-41468","kind":"paragraph","spans":[{"id":"spn-46816","text":"This page answers the most common questions about Graphonomous, its MCP interface, and operating model."}]},{"id":"blk-41469","kind":"heading","level":2,"spans":[{"id":"spn-46817","text":"What is Graphonomous?"}]},{"id":"blk-41470","kind":"paragraph","spans":[{"id":"spn-46818","text":"Graphonomous is a continual-learning memory engine for AI agents. It stores knowledge as a graph, supports confidence-updating feedback loops, and exposes all capabilities through MCP tools/resources."}]},{"id":"blk-41471","kind":"paragraph","spans":[{"id":"spn-46819","text":"---"}]},{"id":"blk-41472","kind":"heading","level":2,"spans":[{"id":"spn-46820","text":"Does Graphonomous retrain model weights?"}]},{"id":"blk-41473","kind":"paragraph","spans":[{"id":"spn-46821","text":"No. Graphonomous does "},{"id":"spn-46822","marks":["bold"],"text":"not"},{"id":"spn-46823","text":" retrain model weights. Learning happens in the memory graph by storing knowledge and updating confidence based on outcomes."}]},{"id":"blk-41474","kind":"paragraph","spans":[{"id":"spn-46824","text":"---"}]},{"id":"blk-41475","kind":"heading","level":2,"spans":[{"id":"spn-46825","text":"What problem does it solve?"}]},{"id":"blk-41476","kind":"paragraph","spans":[{"id":"spn-46826","text":"It gives agents durable, evolving memory and better decision quality over time by combining:"}]},{"id":"blk-41477","items":[{"blocks":[{"id":"blk-41479","kind":"paragraph","spans":[{"id":"spn-46827","text":"semantic retrieval"}]}],"id":"blk-41478","kind":"list-item"},{"blocks":[{"id":"blk-41481","kind":"paragraph","spans":[{"id":"spn-46828","text":"graph neighborhood expansion"}]}],"id":"blk-41480","kind":"list-item"},{"blocks":[{"id":"blk-41483","kind":"paragraph","spans":[{"id":"spn-46829","text":"causal outcome feedback"}]}],"id":"blk-41482","kind":"list-item"},{"blocks":[{"id":"blk-41485","kind":"paragraph","spans":[{"id":"spn-46830","text":"goal tracking"}]}],"id":"blk-41484","kind":"list-item"},{"blocks":[{"id":"blk-41487","kind":"paragraph","spans":[{"id":"spn-46831","text":"topology-aware routing ("},{"id":"spn-46832","marks":["code"],"text":"fast"},{"id":"spn-46833","text":" vs "},{"id":"spn-46834","marks":["code"],"text":"deliberate"},{"id":"spn-46835","text":")"}]}],"id":"blk-41486","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41488","kind":"paragraph","spans":[{"id":"spn-46836","text":"---"}]},{"id":"blk-41489","kind":"heading","level":2,"spans":[{"id":"spn-46837","text":"What are the core node types?"}]},{"id":"blk-41490","kind":"paragraph","spans":[{"id":"spn-46838","text":"Use node types intentionally (6 types):"}]},{"id":"blk-41491","items":[{"blocks":[{"id":"blk-41493","kind":"paragraph","spans":[{"id":"spn-46839","marks":["code"],"text":"semantic"},{"id":"spn-46840","text":" — facts, architecture, definitions"}]}],"id":"blk-41492","kind":"list-item"},{"blocks":[{"id":"blk-41495","kind":"paragraph","spans":[{"id":"spn-46841","marks":["code"],"text":"procedural"},{"id":"spn-46842","text":" — workflows and how-to steps"}]}],"id":"blk-41494","kind":"list-item"},{"blocks":[{"id":"blk-41497","kind":"paragraph","spans":[{"id":"spn-46843","marks":["code"],"text":"episodic"},{"id":"spn-46844","text":" — events and observations"}]}],"id":"blk-41496","kind":"list-item"},{"blocks":[{"id":"blk-41499","kind":"paragraph","spans":[{"id":"spn-46845","marks":["code"],"text":"temporal"},{"id":"spn-46846","text":" — time-indexed observations, monitoring events"}]}],"id":"blk-41498","kind":"list-item"},{"blocks":[{"id":"blk-41501","kind":"paragraph","spans":[{"id":"spn-46847","marks":["code"],"text":"outcome"},{"id":"spn-46848","text":" — empirical results of actions (grounding)"}]}],"id":"blk-41500","kind":"list-item"},{"blocks":[{"id":"blk-41503","kind":"paragraph","spans":[