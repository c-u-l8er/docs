should agents use Graphonomous by default?"}]},{"id":"blk-65443","kind":"paragraph","spans":[{"id":"spn-95726","text":"For non-trivial work, use this loop:"}]},{"id":"blk-65444","items":[{"blocks":[{"id":"blk-65446","kind":"paragraph","spans":[{"id":"spn-95727","text":"retrieve context"}]}],"id":"blk-65445","kind":"list-item"},{"blocks":[{"id":"blk-65448","kind":"paragraph","spans":[{"id":"spn-95728","text":"reason and act"}]}],"id":"blk-65447","kind":"list-item"},{"blocks":[{"id":"blk-65450","kind":"paragraph","spans":[{"id":"spn-95729","text":"store durable knowledge"}]}],"id":"blk-65449","kind":"list-item"},{"blocks":[{"id":"blk-65452","kind":"paragraph","spans":[{"id":"spn-95730","text":"report outcomes"}]}],"id":"blk-65451","kind":"list-item"},{"blocks":[{"id":"blk-65454","kind":"paragraph","spans":[{"id":"spn-95731","text":"maintain via consolidation"}]}],"id":"blk-65453","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65455","kind":"paragraph","spans":[{"id":"spn-95732","text":"This is the recommended operating pattern for robust continual learning."}]},{"id":"blk-65456","kind":"heading","level":2,"spans":[{"id":"spn-95733","text":"Where can I find the full tool list and payload shapes?"}]},{"id":"blk-65457","kind":"paragraph","spans":[{"id":"spn-95734","text":"See the MCP tools reference pages in this docs site, especially:"}]},{"id":"blk-65458","items":[{"blocks":[{"id":"blk-65460","kind":"paragraph","spans":[{"id":"spn-95735","text":"retrieval and graph query"}]}],"id":"blk-65459","kind":"list-item"},{"blocks":[{"id":"blk-65462","kind":"paragraph","spans":[{"id":"spn-95736","text":"node/edge storage"}]}],"id":"blk-65461","kind":"list-item"},{"blocks":[{"id":"blk-65464","kind":"paragraph","spans":[{"id":"spn-95737","text":"outcome learning"}]}],"id":"blk-65463","kind":"list-item"},{"blocks":[{"id":"blk-65466","kind":"paragraph","spans":[{"id":"spn-95738","text":"goal management and review"}]}],"id":"blk-65465","kind":"list-item"},{"blocks":[{"