{"bendscript":"0.1","blocks":[{"id":"blk-67080","kind":"heading","level":1,"spans":[{"id":"spn-97635","text":"Consolidation"}]},{"id":"blk-67081","kind":"paragraph","spans":[{"id":"spn-97636","text":"Trigger graph maintenance — decay weak knowledge, prune, merge duplicates, strengthen relationships."}]},{"id":"blk-67082","kind":"heading","level":2,"spans":[{"id":"spn-97637","text":"Trigger Consolidation"}]},{"id":"blk-67083","kind":"code","language":"text","text":"consolidate(action: \"run\", wait_ms: 2000)"},{"id":"blk-67084","kind":"paragraph","spans":[{"id":"spn-97638","text":"The "},{"id":"spn-97639","marks":["code"],"text":"consolidate"},{"id":"spn-97640","text":" machine supports these actions:"}]},{"id":"blk-67085","items":[{"blocks":[{"id":"blk-67087","kind":"paragraph","spans":[{"id":"spn-97641","marks":["code"],"text":"run"},{"id":"spn-97642","text":" — trigger consolidation (optionally wait with "},{"id":"spn-97643","marks":["code"],"text":"wait_ms"},{"id":"spn-97644","text":")"}]}],"id":"blk-67086","kind":"list-item"},{"blocks":[{"id":"blk-67089","kind":"paragraph","spans":[{"id":"spn-97645","marks":["code"],"text":"stats"},{"id":"spn-97646","text":" — aggregate graph health without triggering"}]}],"id":"blk-67088","kind":"list-item"},{"blocks":[{"id":"blk-67091","kind":"paragraph","spans":[{"id":"spn-97647","marks":["code"],"text":"query"},{"id":"spn-97648","text":" — operation-based graph inspection"}]}],"id":"blk-67090","kind":"list-item"},{"blocks":[{"id":"blk-67093","kind":"paragraph","spans":[{"id":"spn-97649","marks":["code"],"text":"traverse"},{"id":"spn-97650","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-67092","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67094","kind":"paragraph","spans":[{"id":"spn-97651","marks":["bold"],"text":"`wait_ms`:"},{"id":"spn-97652","text":" 0–30000 (max 30 seconds). How long to wait for completion before returning status."}]},{"id":"blk-67095","kind":"heading","level":2,"spans":[{"id":"spn-97653","text":"The 7-Stage Pipeline"}]},{"id":"blk-67096","items":[{"blocks":[{"id":"blk-67098","kind":"paragraph","spans":[{"id":"spn-97654","marks":["bold"],"text":"Decay confidence"},{"id":"spn-97655","text":" — time-based confidence reduction. Nodes not accessed or reinforced gradually lose confidence."}]}],"id":"blk-67097","kind":"list-item"},{"blocks":[{"id":"blk-67100","kind":"paragraph","spans":[{"id":"spn-97656","marks":["bold"],"text":"Prune weak nodes"},{"id":"spn-97657","text":" — remove nodes below the confidence threshold. Eliminates knowledge that has decayed past usefulness."}]}],"id":"blk-67099","kind":"list-item"},{"blocks":[{"id":"blk-67102","kind":"paragraph","spans":[{"id":"spn-97658","marks":["bold"],"text":"Prune weak edges"},{"id":"spn-97659","text":" — remove edges below the weight threshold. Cleans up tenuous connections."}]}],"id":"blk-67101","kind":"list-item"},{"blocks":[{"id":"blk-67104","kind":"paragraph","spans":[{"id":"spn-97660","marks":["bold"],"text":"Strengthen co-activated"},{"id":"spn-97661","text":" — boost edges between nodes frequently retrieved together (\"neurons that fire together wire together\")."}]}],"id":"blk-67103","kind":"list-item"},{"blocks":[{"id":"blk-67106","kind":"paragraph","spans":[{"id":"spn-97662","marks":["bold"],"text":"Merge similar nodes"},{"id":"spn-97663","text":" — combine near-duplicate nodes (similarity > 0.95 default). Consolidates redundant knowledge."}]}],"id":"blk-67105","kind":"list-item"},{"blocks":[{"id":"blk-67108","kind":"paragraph","spans":[{"id":"spn-97664","marks":["bold"],"text":"Promote timescale"},{"id":"spn-97665","text":" — move valuable, frequently-accessed nodes to slower decay tiers (fast → medium → slow → glacial)."}]}],"id":"blk-67107","kind":"list-item"},{"blocks":[{"id":"blk-67110","kind":"paragraph","spans":[{"id":"spn-97666","marks":["bold"],"text":"Generate abstractions"},{"id":"spn-97667","text":" — create semantic summary nodes from clusters of episodic observations."}]}],"id":"blk-67109","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67111","kind":"heading","level":2,"spans":[{"id":"spn-97668","text":"Timescale System"}]},{"id":"blk-67112","kind":"paragraph","spans":[{"id":"spn-97669","text":"Nodes live on one of 4 decay tiers:"}]},{"head":[{"id":"blk-67114","spans":[{"id":"spn-97670","text":"Tier"}]},{"id":"blk-67115","spans":[{"id":"spn-97671","text":"TTL"}]},{"id":"blk-67116","spans":[{"id":"spn-97672","text":"Decay Rate"}]},{"id":"blk-67117","spans":[{"id":"spn-97673","text":"Purpose"}]}],"id":"blk-67113","kind":"table","rows":[[{"id":"blk-67118","spans":[{"id":"spn-97674","marks":["bold"],"text":"fast"}]},{"id":"blk-67119","spans":[{"id":"spn-97675","text":"Hours"}]},{"id":"blk-67120","spans":[{"id":"spn-97676","text":"High"}]},{"id":"blk-67121","spans":[{"id":"spn-97677","text":"Working memory, session-local observations"}]}],[{"id":"blk-67122","spans":[{"id":"spn-97678","marks":["bold"],"text":"medium"}]},{"id":"blk-67123","spans":[{"id":"spn-97679","text":"Days"}]},{"id":"blk-67124","spans":[{"id":"spn-97680","text":"Moderate"}]},{"id":"blk-67125","spans":[{"id":"spn-97681","text":"Recently reinforced knowledge"}]}],[{"id":"blk-67126","spans":[{"id":"spn-97682","marks":["bold"],"text":"slow"}]},{"id":"blk-67127","spans":[{"id":"spn-97683","text":"Weeks"}]},{"id":"blk-67128","spans":[{"id":"spn-97684","text":"Low"}]},{"id":"blk-67129","spans":[{"id":"spn-97685","text":"Well-established, frequently-used facts"}]}],[{"id":"blk-67130","spans":[{"id":"spn-97686","marks":["bold"],"text":"glacial"}]},{"id":"blk-67131","spans":[{"id":"spn-97687","text":"Months+"}]},{"id":"blk-67132","spans":[{"id":"spn-97688","text":"Minimal"}]},{"id":"blk-67133","spans":[{"id":"spn-97689","text":"Core architectural knowledge, proven procedures"}]}]]},{"id":"blk-67134","kind":"paragraph","spans":[{"id":"spn-97690","text":"Consolidation promotes nodes up tiers based on access frequency and confidence. Decay happens within each tier at its own rate."}]},{"id":"blk-67135","kind":"heading","level":2,"spans":[{"id":"spn-97691","text":"When to Consolidate"}]},{"id":"blk-67136","items":[{"blocks":[{"id":"blk-67138","kind":"paragraph","spans":[{"id":"spn-97692","text":"End of every productive session"}]}],"id":"blk-67137","kind":"list-item"},{"blocks":[{"id":"blk-67140","kind":"paragraph","spans":[{"id":"spn-97693","text":"Every 4–5 heavy storage/learning iterations"}]}],"id":"blk-67139","kind":"list-item"},{"blocks":[{"id":"blk-67142","kind":"paragraph","spans":[{"id":"spn-97694","text":"After outcome learning bursts"}]}],"id":"blk-67141","kind":"list-item"},{"blocks":[{"id":"blk-67144","kind":"paragraph","spans":[{"id":"spn-97695","text":"Before critical retrievals (ensures clean, high-quality graph)"}]}],"id":"blk-67143","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67145","kind":"paragraph","spans":[{"id":"spn-97696","text":"Consolidation also runs automatically during idle — manual triggers supplement this."}]},{"id":"blk-67146","kind":"heading","level":2,"spans":[{"id":"spn-97697","text":"Consolidation Log Resource"}]},{"id":"blk-67147","kind":"paragraph","spans":[{"id":"spn-97698","text":"Read the current consolidation state and orchestrator metrics without triggering a cycle:"}]},{"id":"blk-67148","kind":"code","language":"text","text":"Resource URI: graphonomous://consolidation/log"},{"id":"blk-67149","kind":"paragraph","spans":[{"id":"spn-97699","text":"Returns consolidator state (cycle count, last run, config) and orchestrator plasticity metrics (current learning rate, churn estimate, counters). Useful for monitoring without side effects."}]},{"id":"blk-67150","kind":"heading","level":2,"spans":[{"id":"spn-97700","text":"Health Indicators"}]},{"head":[{"id":"blk-67152","spans":[{"id":"spn-97701","text":"Metric"}]},{"id":"blk-67153","spans":[{"id":"spn-97702","text":"Healthy Range"}]},{"id":"blk-67154","spans":[{"id":"spn-97703","text":"Problem If"}]}],"id":"blk-67151","kind":"table","rows":[[{"id":"blk-67155","spans":[{"id":"spn-97704","text":"Node count"}]},{"id":"blk-67156","spans":[{"id":"spn-97705","text":"Growing steadily"}]},{"id":"blk-67157","spans":[{"id":"spn-97706","text":"Stagnant or shrinking rapidly"}]}],[{"id":"blk-67158","spans":[{"id":"spn-97707","text":"Pruned count"}]},{"id":"blk-67159","spans":[{"id":"spn-97708","text":"> 0 occasionally"}]},{"id":"blk-67160","spans":[{"id":"spn-97709","text":"Always 0 (no decay) or very high (over-aggressive)"}]}],[{"id":"blk-67161","spans":[{"id":"spn-97710","text":"Merged count"}]},{"id":"blk-67162","spans":[{"id":"spn-97711","text":"Occasional"}]},{"id":"blk-67163","spans":[{"id":"spn-97712","text":"Never (duplicates accumulating)"}]}],[{"id":"blk-67164","spans":[{"id":"spn-97713","text":"Edge/node ratio"}]},{"id":"blk-67165","spans":[{"id":"spn-97714","text":"0.5–3.0"}]},{"id":"blk-67166","spans":[{"id":"spn-97715","text":"< 0.5 (isolated nodes) or > 3.0 (edge spaghetti)"}]}],[{"id":"blk-67167","spans":[{"id":"spn-97716","text":"Cycle count"}]},{"id":"blk-67168","spans":[{"id":"spn-97717","text":"Increasing"}]},{"id":"blk-67169","spans":[{"id":"spn-97718","text":"N/A (just informational)"}]}]]},{"id":"blk-67170","kind":"heading","level":2,"spans":[{"id":"spn-97719","text":"Consolidation and Goals"}]},{"id":"blk-67171","kind":"paragraph","spans":[{"id":"spn-97720","text":"Consolidation can prune nodes that are linked to goals, which affects coverage scores. After heavy consolidation, consider re-reviewing active goals with "},{"id":"spn-97721","marks":["code"],"text":"review_goal"},{"id":"spn-97722","text":" to ensure coverage hasn't dropped below thresholds."}]},{"id":"blk-67172","kind":"heading","level":2,"spans":[{"id":"spn-97723","text":"Anti-patterns to avoid"}]},{"id":"blk-67173","items":[{"blocks":[{"id":"blk-67175","kind":"paragraph","spans":[{"id":"spn-97724","text":"Consolidation neglect — never running consolidation, letting the graph accumulate noise"}]}],"id":"blk-67174","kind":"list-item"},{"blocks":[{"id":"blk-67177","kind":"paragraph","spans":[{"id":"spn-97725","text":"Running consolidation too frequently during active work (once per session boundary is usually enough)"}]}],"id":"blk-67176","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraqeesy2zio3p6l7etvugr35e2m3rhfgzjm3rwoqcbupkwyded6gta","vocabulary":"ampersand.docs.fs.v1"}