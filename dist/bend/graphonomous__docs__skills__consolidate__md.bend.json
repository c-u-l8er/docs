}]}],"id":"blk-67185","kind":"list-item"},{"blocks":[{"id":"blk-67188","kind":"paragraph","spans":[{"id":"spn-97778","text":"Running consolidation too frequently during active work (once per session boundary is usually enough)"}]}],"id":"blk-67187","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierabk5s5vuqw3bdiq7kkw7qrbggbk3wy2q4f73u4nnfmwpaizux5j7a","vocabulary":"ampersand.docs.fs.v1"}