{"bendscript":"0.1","blocks":[{"id":"blk-67217","kind":"heading","level":1,"spans":[{"id":"spn-97836","text":"Consolidation"}]},{"id":"blk-67218","kind":"paragraph","spans":[{"id":"spn-97837","text":"Trigger graph maintenance — decay weak knowledge, prune, merge duplicates, strengthen relationships."}]},{"id":"blk-67219","kind":"heading","level":2,"spans":[{"id":"spn-97838","text":"Trigger Consolidation"}]},{"id":"blk-67220","kind":"code","language":"text","text":"consolidate(action: \"run\", wait_ms: 2000)"},{"id":"blk-67221","kind":"paragraph","spans":[{"id":"spn-97839","text":"The "},{"id":"spn-97840","marks":["code"],"text":"consolidate"},{"id":"spn-97841","text":" machine supports these actions:"}]},{"id":"blk-67222","items":[{"blocks":[{"id":"blk-67224","kind":"paragraph","spans":[{"id":"spn-97842","marks":["code"],"text":"run"},{"id":"spn-97843","text":" — trigger consolidation (optionally wait with "},{"id":"spn-97844","marks":["code"],"text":"wait_ms"},{"id":"spn-97845","text":")"}]}],"id":"blk-67223","kind":"list-item"},{"blocks":[{"id":"blk-67226","kind":"paragraph","spans":[{"id":"spn-97846","marks":["code"],"text":"stats"},{"id":"spn-97847","text":" — aggregate graph health without triggering"}]}],"id":"blk-67225","kind":"list-item"},{"blocks":[{"id":"blk-67228","kind":"paragraph","spans":[{"id":"spn-97848","marks":["code"],"text":"query"},{"id":"spn-97849","text":" — operation-based graph inspection"}]}],"id":"blk-67227","kind":"list-item"},{"blocks":[{"id":"blk-67230","kind":"paragraph","spans":[{"id":"spn-97850","marks":["code"],"text":"traverse"},{"id":"spn-97851","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-67229","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67231","kind":"paragraph","spans":[{"id":"spn-97852","marks":["bold"],"text":"`wait_ms`:"},{"id":"spn-97853","text":" 0–30000 (max 30 seconds). How long to wait for completion before returning status."}]},{"id":"blk-67232","kind":"heading","level":2,"spans":[{"id":"spn-97854","text":"The 7-Stage Pipeline"}]},{"id":"blk-67233","items":[{"blocks":[{"id":"blk-67235","kind":"paragraph","spans":[{"id":"spn-97855","marks":["bold"],"text":"Decay confidence"},{"id":"spn-97856","text":" — time-based confidence reduction. Nodes not accessed or reinforced gradually lose confidence."}]}],"id":"blk-67234","kind":"list-item"},{"blocks":[{"id":"blk-67237","kind":"paragraph","spans":[{"id":"spn-97857","marks":["bold"],"text":"Prune weak nodes"},{"id":"spn-97858","text":" — remove nodes below the confidence threshold. Eliminates knowledge that has decayed past usefulness."}]}],"id":"blk-67236","kind":"list-item"},{"blocks":[{"id":"blk-67239","kind":"paragraph","spans":[{"id":"spn-97859","marks":["bold"],"text":"Prune weak edges"},{"id":"spn-97860","text":" — remove edges below the weight threshold. Cleans up tenuous connections."}]}],"id":"blk-67238","kind":"list-item"},{"blocks":[{"id":"blk-67241","kind":"paragraph","spans":[{"id":"spn-97861","marks":["bold"],"text":"Strengthen co-activated"},{"id":"spn-97862","text":" — boost edges between nodes frequently retrieved together (\"neurons that fire together wire together\")."}]}],"id":"blk-67240","kind":"list-item"},{"blocks":[{"id":"blk-67243","kind":"paragraph","spans":[{"id":"spn-97863","marks":["bold"],"text":"Merge similar nodes"},{"id":"spn-97864","text":" — combine near-duplicate nodes (similarity > 0.95 default). Consolidates redundant knowledge."}]}],"id":"blk-67242","kind":"list-item"},{"blocks":[{"id":"blk-67245","kind":"paragraph","spans":[{"id":"spn-97865","marks":["bold"],"text":"Promote timescale"},{"id":"spn-97866","text":" — move valuable, frequently-accessed nodes to slower decay tiers (fast → medium → slow → glacial)."}]}],"id":"blk-67244","kind":"list-item"},{"blocks":[{"id":"blk-67247","kind":"paragraph","spans":[{"id":"spn-97867","marks":["bold"],"text":"Generate abstractions"},{"id":"spn-97868","text":" — create semantic summary nodes from clusters of episodic observations."}]}],"id":"blk-67246","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67248","kind":"heading","level":2,"spans":[{"id":"spn-97869","text":"Timescale System"}]},{"id":"blk-67249","kind":"paragraph","spans":[{"id":"spn-97870","text":"Nodes live on one of 4 decay tiers:"}]},{"head":[{"id":"blk-67251","spans":[{"id":"spn-97871","text":"Tier"}]},{"id":"blk-67252","spans":[{"id":"spn-97872","text":"TTL"}]},{"id":"blk-67253","spans":[{"id":"spn-97873","text":"Decay Rate"}]},{"id":"blk-67254","spans":[{"id":"spn-97874","text":"Purpose"}]}],"id":"blk-67250","kind":"table","rows":[[{"id":"blk-67255","spans":[{"id":"spn-97875","marks":["bold"],"text":"fast"}]},{"id":"blk-67256","spans":[{"id":"spn-97876","text":"Hours"}]},{"id":"blk-67257","spans":[{"id":"spn-97877","text":"High"}]},{"id":"blk-67258","spans":[{"id":"spn-97878","text":"Working memory, session-local observations"}]}],[{"id":"blk-67259","spans":[{"id":"spn-97879","marks":["bold"],"text":"medium"}]},{"id":"blk-67260","spans":[{"id":"spn-97880","text":"Days"}]},{"id":"blk-67261","spans":[{"id":"spn-97881","text":"Moderate"}]},{"id":"blk-67262","spans":[{"id":"spn-97882","text":"Recently reinforced knowledge"}]}],[{"id":"blk-67263","spans":[{"id":"spn-97883","marks":["bold"],"text":"slow"}]},{"id":"blk-67264","spans":[{"id":"spn-97884","text":"Weeks"}]},{"id":"blk-67265","spans":[{"id":"spn-97885","text":"Low"}]},{"id":"blk-67266","spans":[{"id":"spn-97886","text":"Well-established, frequently-used facts"}]}],[{"id":"blk-67267","spans":[{"id":"spn-97887","marks":["bold"],"text":"glacial"}]},{"id":"blk-67268","spans":[{"id":"spn-97888","text":"Months+"}]},{"id":"blk-67269","spans":[{"id":"spn-97889","text":"Minimal"}]},{"id":"blk-67270","spans":[{"id":"spn-97890","text":"Core architectural knowledge, proven procedures"}]}]]},{"id":"blk-67271","kind":"paragraph","spans":[{"id":"spn-97891","text":"Consolidation promotes nodes up tiers based on access frequency and confidence. Decay happens within each tier at its own rate."}]},{"id":"blk-67272","kind":"heading","level":2,"spans":[{"id":"spn-97892","text":"When to Consolidate"}]},{"id":"blk-67273","items":[{"blocks":[{"id":"blk-67275","kind":"paragraph","spans":[{"id":"spn-97893","text":"End of every productive session"}]}],"id":"blk-67274","kind":"list-item"},{"blocks":[{"id":"blk-67277","kind":"paragraph","spans":[{"id":"spn-97894","text":"Every 4–5 heavy storage/learning iterations"}]}],"id":"blk-67276","kind":"list-item"},{"blocks":[{"id":"blk-67279","kind":"paragraph","spans":[{"id":"spn-97895","text":"After outcome learning bursts"}]}],"id":"blk-67278","kind":"list-item"},{"blocks":[{"id":"blk-67281","kind":"paragraph","spans":[{"id":"spn-97896","text":"Before critical retrievals (ensures clean, high-quality graph)"}]}],"id":"blk-67280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67282","kind":"paragraph","spans":[{"id":"spn-97897","text":"Consolidation also runs automatically during idle — manual triggers supplement this."}]},{"id":"blk-67283","kind":"heading","level":2,"spans":[{"id":"spn-97898","text":"Consolidation Log Resource"}]},{"id":"blk-67284","kind":"paragraph","spans":[{"id":"spn-97899","text":"Read the current consolidation state and orchestrator metrics without triggering a cycle:"}]},{"id":"blk-67285","kind":"code","language":"text","text":"Resource URI: graphonomous://consolidation/log"},{"id":"blk-67286","kind":"paragraph","spans":[{"id":"spn-97900","text":"Returns consolidator state (cycle count, last run, config) and orchestrator plasticity metrics (current learning rate, churn estimate, counters). Useful for monitoring without side effects."}]},{"id":"blk-67287","kind":"heading","level":2,"spans":[{"id":"spn-97901","text":"Health Indicators"}]},{"head":[{"id":"blk-67289","spans":[{"id":"spn-97902","text":"Metric"}]},{"id":"blk-67290","spans":[{"id":"spn-97903","text":"Healthy Range"}]},{"id":"blk-67291","spans":[{"id":"spn-97904","text":"Problem If"}]}],"id":"blk-67288","kind":"table","rows":[[{"id":"blk-67292","spans":[{"id":"spn-97905","text":"Node count"}]},{"id":"blk-67293","spans":[{"id":"spn-97906","text":"Growing steadily"}]},{"id":"blk-67294","spans":[{"id":"spn-97907","text":"Stagnant or shrinking rapidly"}]}],[{"id":"blk-67295","spans":[{"id":"spn-97908","text":"Pruned count"}]},{"id":"blk-67296","spans":[{"id":"spn-97909","text":"> 0 occasionally"}]},{"id":"blk-67297","spans":[{"id":"spn-97910","text":"Always 0 (no decay) or very high (over-aggressive)"}]}],[{"id":"blk-67298","spans":[{"id":"spn-97911","text":"Merged count"}]},{"id":"blk-67299","spans":[{"id":"spn-97912","text":"Occasional"}]},{"id":"blk-67300","spans":[{"id":"spn-97913","text":"Never (duplicates accumulating)"}]}],[{"id":"blk-67301","spans":[{"id":"spn-97914","text":"Edge/node ratio"}]},{"id":"blk-67302","spans":[{"id":"spn-97915","text":"0.5–3.0"}]},{"id":"blk-67303","spans":[{"id":"spn-97916","text":"< 0.5 (isolated nodes) or > 3.0 (edge spaghetti)"}]}],[{"id":"blk-67304","spans":[{"id":"spn-97917","text":"Cycle count"}]},{"id":"blk-67305","spans":[{"id":"spn-97918","text":"Increasing"}]},{"id":"blk-67306","spans":[{"id":"spn-97919","text":"N/A (just informational)"}]}]]},{"id":"blk-67307","kind":"heading","level":2,"spans":[{"id":"spn-97920","text":"Consolidation and Goals"}]},{"id":"blk-67308","kind":"paragraph","spans":[{"id":"spn-97921","text":"Consolidation can prune nodes that are linked to goals, which affects coverage scores. After heavy consolidation, consider re-reviewing active goals with "},{"id":"spn-97922","marks":["code"],"text":"review_goal"},{"id":"spn-97923","text":" to ensure coverage hasn't dropped below thresholds."}]},{"id":"blk-67309","kind":"heading","level":2,"spans":[{"id":"spn-97924","text":"Anti-patterns to avoid"}]},{"id":"blk-67310","items":[{"blocks":[{"id":"blk-67312","kind":"paragraph","spans":[{"id":"spn-97925","text":"Consolidation neglect — never running consolidation, letting the graph accumulate noise"}]}],"id":"blk-67311","kind":"list-item"},{"blocks":[{"id":"blk-67314","kind":"paragraph","spans":[{"id":"spn-97926","text":"Running consolidation too frequently during active work (once per session boundary is usually enough)"}]}],"id":"blk-67313","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierabqo5dvwrctewy2woslxum4zrn36ardd6pyfwur7wcpftu2xekraa","vocabulary":"ampersand.docs.fs.v1"}