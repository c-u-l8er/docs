{"bendscript":"0.1","blocks":[{"id":"blk-68045","kind":"heading","level":1,"spans":[{"id":"spn-100449","text":"Consolidation"}]},{"id":"blk-68046","kind":"paragraph","spans":[{"id":"spn-100450","text":"Trigger graph maintenance — decay weak knowledge, prune, merge duplicates, strengthen relationships."}]},{"id":"blk-68047","kind":"heading","level":2,"spans":[{"id":"spn-100451","text":"Trigger Consolidation"}]},{"id":"blk-68048","kind":"code","language":"text","text":"consolidate(action: \"run\", wait_ms: 2000)"},{"id":"blk-68049","kind":"paragraph","spans":[{"id":"spn-100452","text":"The "},{"id":"spn-100453","marks":["code"],"text":"consolidate"},{"id":"spn-100454","text":" machine supports these actions:"}]},{"id":"blk-68050","items":[{"blocks":[{"id":"blk-68052","kind":"paragraph","spans":[{"id":"spn-100455","marks":["code"],"text":"run"},{"id":"spn-100456","text":" — trigger consolidation (optionally wait with "},{"id":"spn-100457","marks":["code"],"text":"wait_ms"},{"id":"spn-100458","text":")"}]}],"id":"blk-68051","kind":"list-item"},{"blocks":[{"id":"blk-68054","kind":"paragraph","spans":[{"id":"spn-100459","marks":["code"],"text":"stats"},{"id":"spn-100460","text":" — aggregate graph health without triggering"}]}],"id":"blk-68053","kind":"list-item"},{"blocks":[{"id":"blk-68056","kind":"paragraph","spans":[{"id":"spn-100461","marks":["code"],"text":"query"},{"id":"spn-100462","text":" — operation-based graph inspection"}]}],"id":"blk-68055","kind":"list-item"},{"blocks":[{"id":"blk-68058","kind":"paragraph","spans":[{"id":"spn-100463","marks":["code"],"text":"traverse"},{"id":"spn-100464","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-68057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68059","kind":"paragraph","spans":[{"id":"spn-100465","marks":["bold"],"text":"`wait_ms`:"},{"id":"spn-100466","text":" 0–30000 (max 30 seconds). How long to wait for completion before returning status."}]},{"id":"blk-68060","kind":"heading","level":2,"spans":[{"id":"spn-100467","text":"The 7-Stage Pipeline"}]},{"id":"blk-68061","items":[{"blocks":[{"id":"blk-68063","kind":"paragraph","spans":[{"id":"spn-100468","marks":["bold"],"text":"Decay confidence"},{"id":"spn-100469","text":" — time-based confidence reduction. Nodes not accessed or reinforced gradually lose confidence."}]}],"id":"blk-68062","kind":"list-item"},{"blocks":[{"id":"blk-68065","kind":"paragraph","spans":[{"id":"spn-100470","marks":["bold"],"text":"Prune weak nodes"},{"id":"spn-100471","text":" — remove nodes below the confidence threshold. Eliminates knowledge that has decayed past usefulness."}]}],"id":"blk-68064","kind":"list-item"},{"blocks":[{"id":"blk-68067","kind":"paragraph","spans":[{"id":"spn-100472","marks":["bold"],"text":"Prune weak edges"},{"id":"spn-100473","text":" — remove edges below the weight threshold. Cleans up tenuous connections."}]}],"id":"blk-68066","kind":"list-item"},{"blocks":[{"id":"blk-68069","kind":"paragraph","spans":[{"id":"spn-100474","marks":["bold"],"text":"Strengthen co-activated"},{"id":"spn-100475","text":" — boost edges between nodes frequently retrieved together (\"neurons that fire together wire together\")."}]}],"id":"blk-68068","kind":"list-item"},{"blocks":[{"id":"blk-68071","kind":"paragraph","spans":[{"id":"spn-100476","marks":["bold"],"text":"Merge similar nodes"},{"id":"spn-100477","text":" — combine near-duplicate nodes (similarity > 0.95 default). Consolidates redundant knowledge."}]}],"id":"blk-68070","kind":"list-item"},{"blocks":[{"id":"blk-68073","kind":"paragraph","spans":[{"id":"spn-100478","marks":["bold"],"text":"Promote timescale"},{"id":"spn-100479","text":" — move valuable, frequently-accessed nodes to slower decay tiers (fast → medium → slow → glacial)."}]}],"id":"blk-68072","kind":"list-item"},{"blocks":[{"id":"blk-68075","kind":"paragraph","spans":[{"id":"spn-100480","marks":["bold"],"text":"Generate abstractions"},{"id":"spn-100481","text":" — create semantic summary nodes from clusters of episodic observations."}]}],"id":"blk-68074","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68076","kind":"heading","level":2,"spans":[{"id":"spn-100482","text":"Timescale System"}]},{"id":"blk-68077","kind":"paragraph","spans":[{"id":"spn-100483","text":"Nodes live on one of 4 decay tiers:"}]},{"head":[{"id":"blk-68079","spans":[{"id":"spn-100484","text":"Tier"}]},{"id":"blk-68080","spans":[{"id":"spn-100485","text":"TTL"}]},{"id":"blk-68081","spans":[{"id":"spn-100486","text":"Decay Rate"}]},{"id":"blk-68082","spans":[{"id":"spn-100487","text":"Purpose"}]}],"id":"blk-68078","kind":"table","rows":[[{"id":"blk-68083","spans":[{"id":"spn-100488","marks":["bold"],"text":"fast"}]},{"id":"blk-68084","spans":[{"id":"spn-100489","text":"Hours"}]},{"id":"blk-68085","spans":[{"id":"spn-100490","text":"High"}]},{"id":"blk-68086","spans":[{"id":"spn-100491","text":"Working memory, session-local observations"}]}],[{"id":"blk-68087","spans":[{"id":"spn-100492","marks":["bold"],"text":"medium"}]},{"id":"blk-68088","spans":[{"id":"spn-100493","text":"Days"}]},{"id":"blk-68089","spans":[{"id":"spn-100494","text":"Moderate"}]},{"id":"blk-68090","spans":[{"id":"spn-100495","text":"Recently reinforced knowledge"}]}],[{"id":"blk-68091","spans":[{"id":"spn-100496","marks":["bold"],"text":"slow"}]},{"id":"blk-68092","spans":[{"id":"spn-100497","text":"Weeks"}]},{"id":"blk-68093","spans":[{"id":"spn-100498","text":"Low"}]},{"id":"blk-68094","spans":[{"id":"spn-100499","text":"Well-established, frequently-used facts"}]}],[{"id":"blk-68095","spans":[{"id":"spn-100500","marks":["bold"],"text":"glacial"}]},{"id":"blk-68096","spans":[{"id":"spn-100501","text":"Months+"}]},{"id":"blk-68097","spans":[{"id":"spn-100502","text":"Minimal"}]},{"id":"blk-68098","spans":[{"id":"spn-100503","text":"Core architectural knowledge, proven procedures"}]}]]},{"id":"blk-68099","kind":"paragraph","spans":[{"id":"spn-100504","text":"Consolidation promotes nodes up tiers based on access frequency and confidence. Decay happens within each tier at its own rate."}]},{"id":"blk-68100","kind":"heading","level":2,"spans":[{"id":"spn-100505","text":"When to Consolidate"}]},{"id":"blk-68101","items":[{"blocks":[{"id":"blk-68103","kind":"paragraph","spans":[{"id":"spn-100506","text":"End of every productive session"}]}],"id":"blk-68102","kind":"list-item"},{"blocks":[{"id":"blk-68105","kind":"paragraph","spans":[{"id":"spn-100507","text":"Every 4–5 heavy storage/learning iterations"}]}],"id":"blk-68104","kind":"list-item"},{"blocks":[{"id":"blk-68107","kind":"paragraph","spans":[{"id":"spn-100508","text":"After outcome learning bursts"}]}],"id":"blk-68106","kind":"list-item"},{"blocks":[{"id":"blk-68109","kind":"paragraph","spans":[{"id":"spn-100509","text":"Before critical retrievals (ensures clean, high-quality graph)"}]}],"id":"blk-68108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68110","kind":"paragraph","spans":[{"id":"spn-100510","text":"Consolidation also runs automatically during idle — manual triggers supplement this."}]},{"id":"blk-68111","kind":"heading","level":2,"spans":[{"id":"spn-100511","text":"Consolidation Log Resource"}]},{"id":"blk-68112","kind":"paragraph","spans":[{"id":"spn-100512","text":"Read the current consolidation state and orchestrator metrics without triggering a cycle:"}]},{"id":"blk-68113","kind":"code","language":"text","text":"Resource URI: graphonomous://consolidation/log"},{"id":"blk-68114","kind":"paragraph","spans":[{"id":"spn-100513","text":"Returns consolidator state (cycle count, last run, config) and orchestrator plasticity metrics (current learning rate, churn estimate, counters). Useful for monitoring without side effects."}]},{"id":"blk-68115","kind":"heading","level":2,"spans":[{"id":"spn-100514","text":"Health Indicators"}]},{"head":[{"id":"blk-68117","spans":[{"id":"spn-100515","text":"Metric"}]},{"id":"blk-68118","spans":[{"id":"spn-100516","text":"Healthy Range"}]},{"id":"blk-68119","spans":[{"id":"spn-100517","text":"Problem If"}]}],"id":"blk-68116","kind":"table","rows":[[{"id":"blk-68120","spans":[{"id":"spn-100518","text":"Node count"}]},{"id":"blk-68121","spans":[{"id":"spn-100519","text":"Growing steadily"}]},{"id":"blk-68122","spans":[{"id":"spn-100520","text":"Stagnant or shrinking rapidly"}]}],[{"id":"blk-68123","spans":[{"id":"spn-100521","text":"Pruned count"}]},{"id":"blk-68124","spans":[{"id":"spn-100522","text":"> 0 occasionally"}]},{"id":"blk-68125","spans":[{"id":"spn-100523","text":"Always 0 (no decay) or very high (over-aggressive)"}]}],[{"id":"blk-68126","spans":[{"id":"spn-100524","text":"Merged count"}]},{"id":"blk-68127","spans":[{"id":"spn-100525","text":"Occasional"}]},{"id":"blk-68128","spans":[{"id":"spn-100526","text":"Never (duplicates accumulating)"}]}],[{"id":"blk-68129","spans":[{"id":"spn-100527","text":"Edge/node ratio"}]},{"id":"blk-68130","spans":[{"id":"spn-100528","text":"0.5–3.0"}]},{"id":"blk-68131","spans":[{"id":"spn-100529","text":"< 0.5 (isolated nodes) or > 3.0 (edge spaghetti)"}]}],[{"id":"blk-68132","spans":[{"id":"spn-100530","text":"Cycle count"}]},{"id":"blk-68133","spans":[{"id":"spn-100531","text":"Increasing"}]},{"id":"blk-68134","spans":[{"id":"spn-100532","text":"N/A (just informational)"}]}]]},{"id":"blk-68135","kind":"heading","level":2,"spans":[{"id":"spn-100533","text":"Consolidation and Goals"}]},{"id":"blk-68136","kind":"paragraph","spans":[{"id":"spn-100534","text":"Consolidation can prune nodes that are linked to goals, which affects coverage scores. After heavy consolidation, consider re-reviewing active goals with "},{"id":"spn-100535","marks":["code"],"text":"review_goal"},{"id":"spn-100536","text":" to ensure coverage hasn't dropped below thresholds."}]},{"id":"blk-68137","kind":"heading","level":2,"spans":[{"id":"spn-100537","text":"Anti-patterns to avoid"}]},{"id":"blk-68138","items":[{"blocks":[{"id":"blk-68140","kind":"paragraph","spans":[{"id":"spn-100538","text":"Consolidation neglect — never running consolidation, letting the graph accumulate noise"}]}],"id":"blk-68139","kind":"list-item"},{"blocks":[{"id":"blk-68142","kind":"paragraph","spans":[{"id":"spn-100539","text":"Running consolidation too frequently during active work (once per session boundary is usually enough)"}]}],"id":"blk-68141","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierazhafxorxvji5yajr4q7al6trggvbapwq2noyp6zrlavrswd5rrxq","vocabulary":"ampersand.docs.fs.v1"}