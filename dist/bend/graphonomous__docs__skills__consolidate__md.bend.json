{"bendscript":"0.1","blocks":[{"id":"blk-42910","kind":"paragraph","spans":[{"id":"spn-48914","text":"--- name: consolidate description: Use at end of productive sessions, after heavy storage bursts, periodically during long iterations, or when the user says \"consolidate\", \"maintain graph\", \"merge nodes\", \"clean up memory\". Merges similar nodes and strengthens edges — not for deleting specific nodes (use "},{"id":"spn-48915","marks":["code"],"text":"forgetting"},{"id":"spn-48916","text":") or diagnostics (use "},{"id":"spn-48917","marks":["code"],"text":"graph-health"},{"id":"spn-48918","text":"). ---"}]},{"id":"blk-42911","kind":"heading","level":1,"spans":[{"id":"spn-48919","text":"Consolidation"}]},{"id":"blk-42912","kind":"paragraph","spans":[{"id":"spn-48920","text":"Trigger graph maintenance — decay weak knowledge, prune, merge duplicates, strengthen relationships."}]},{"id":"blk-42913","kind":"heading","level":2,"spans":[{"id":"spn-48921","text":"Trigger Consolidation"}]},{"id":"blk-42914","kind":"code","language":"text","text":"consolidate(action: \"run\", wait_ms: 2000)"},{"id":"blk-42915","kind":"paragraph","spans":[{"id":"spn-48922","text":"The "},{"id":"spn-48923","marks":["code"],"text":"consolidate"},{"id":"spn-48924","text":" machine supports these actions:"}]},{"id":"blk-42916","items":[{"blocks":[{"id":"blk-42918","kind":"paragraph","spans":[{"id":"spn-48925","marks":["code"],"text":"run"},{"id":"spn-48926","text":" — trigger consolidation (optionally wait with "},{"id":"spn-48927","marks":["code"],"text":"wait_ms"},{"id":"spn-48928","text":")"}]}],"id":"blk-42917","kind":"list-item"},{"blocks":[{"id":"blk-42920","kind":"paragraph","spans":[{"id":"spn-48929","marks":["code"],"text":"stats"},{"id":"spn-48930","text":" — aggregate graph health without triggering"}]}],"id":"blk-42919","kind":"list-item"},{"blocks":[{"id":"blk-42922","kind":"paragraph","spans":[{"id":"spn-48931","marks":["code"],"text":"query"},{"id":"spn-48932","text":" — operation-based graph inspection"}]}],"id":"blk-42921","kind":"list-item"},{"blocks":[{"id":"blk-42924","kind":"paragraph","spans":[{"id":"spn-48933","marks":["code"],"text":"traverse"},{"id":"spn-48934","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-42923","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42925","kind":"paragraph","spans":[{"id":"spn-48935","marks":["bold"],"text":"`wait_ms`:"},{"id":"spn-48936","text":" 0–30000 (max 30 seconds). How long to wait for completion before returning status."}]},{"id":"blk-42926","kind":"heading","level":2,"spans":[{"id":"spn-48937","text":"The 7-Stage Pipeline"}]},{"id":"blk-42927","kind":"paragraph","spans":[{"id":"spn-48938","text":"1. "},{"id":"spn-48939","marks":["bold"],"text":"Decay confidence"},{"id":"spn-48940","text":" — time-based confidence reduction. Nodes not accessed or reinforced gradually lose confidence. 2. "},{"id":"spn-48941","marks":["bold"],"text":"Prune weak nodes"},{"id":"spn-48942","text":" — remove nodes below the confidence threshold. Eliminates knowledge that has decayed past usefulness. 3. "},{"id":"spn-48943","marks":["bold"],"text":"Prune weak edges"},{"id":"spn-48944","text":" — remove edges below the weight threshold. Cleans up tenuous connections. 4. "},{"id":"spn-48945","marks":["bold"],"text":"Strengthen co-activated"},{"id":"spn-48946","text":" — boost edges between nodes frequently retrieved together (\"neurons that fire together wire together\"). 5. "},{"id":"spn-48947","marks":["bold"],"text":"Merge similar nodes"},{"id":"spn-48948","text":" — combine near-duplicate nodes (similarity > 0.95 default). Consolidates redundant knowledge. 6. "},{"id":"spn-48949","marks":["bold"],"text":"Promote timescale"},{"id":"spn-48950","text":" — move valuable, frequently-accessed nodes to slower decay tiers (fast → medium → slow → glacial). 7. "},{"id":"spn-48951","marks":["bold"],"text":"Generate abstractions"},{"id":"spn-48952","text":" — create semantic summary nodes from clusters of episodic observations."}]},{"id":"blk-42928","kind":"heading","level":2,"spans":[{"id":"spn-48953","text":"Timescale System"}]},{"id":"blk-42929","kind":"paragraph","spans":[{"id":"spn-48954","text":"Nodes live on one of 4 decay tiers:"}]},{"head":[{"id":"blk-42931","spans":[{"id":"spn-48955","text":"Tier"}]},{"id":"blk-42932","spans":[{"id":"spn-48956","text":"TTL"}]},{"id":"blk-42933","spans":[{"id":"spn-48957","text":"Decay Rate"}]},{"id":"blk-42934","spans":[{"id":"spn-48958","text":"Purpose"}]}],"id":"blk-42930","kind":"table","rows":[[{"id":"blk-42935","spans":[{"id":"spn-48959","marks":["bold"],"text":"fast"}]},{"id":"blk-42936","spans":[{"id":"spn-48960","text":"Hours"}]},{"id":"blk-42937","spans":[{"id":"spn-48961","text":"High"}]},{"id":"blk-42938","spans":[{"id":"spn-48962","text":"Working memory, session-local observations"}]}],[{"id":"blk-42939","spans":[{"id":"spn-48963","marks":["bold"],"text":"medium"}]},{"id":"blk-42940","spans":[{"id":"spn-48964","text":"Days"}]},{"id":"blk-42941","spans":[{"id":"spn-48965","text":"Moderate"}]},{"id":"blk-42942","spans":[{"id":"spn-48966","text":"Recently reinforced knowledge"}]}],[{"id":"blk-42943","spans":[{"id":"spn-48967","marks":["bold"],"text":"slow"}]},{"id":"blk-42944","spans":[{"id":"spn-48968","text":"Weeks"}]},{"id":"blk-42945","spans":[{"id":"spn-48969","text":"Low"}]},{"id":"blk-42946","spans":[{"id":"spn-48970","text":"Well-established, frequently-used facts"}]}],[{"id":"blk-42947","spans":[{"id":"spn-48971","marks":["bold"],"text":"glacial"}]},{"id":"blk-42948","spans":[{"id":"spn-48972","text":"Months+"}]},{"id":"blk-42949","spans":[{"id":"spn-48973","text":"Minimal"}]},{"id":"blk-42950","spans":[{"id":"spn-48974","text":"Core architectural knowledge, proven procedures"}]}]]},{"id":"blk-42951","kind":"paragraph","spans":[{"id":"spn-48975","text":"Consolidation promotes nodes up tiers based on access frequency and confidence. Decay happens within each tier at its own rate."}]},{"id":"blk-42952","kind":"heading","level":2,"spans":[{"id":"spn-48976","text":"When to Consolidate"}]},{"id":"blk-42953","items":[{"blocks":[{"id":"blk-42955","kind":"paragraph","spans":[{"id":"spn-48977","text":"End of every productive session"}]}],"id":"blk-42954","kind":"list-item"},{"blocks":[{"id":"blk-42957","kind":"paragraph","spans":[{"id":"spn-48978","text":"Every 4–5 heavy storage/learning iterations"}]}],"id":"blk-42956","kind":"list-item"},{"blocks":[{"id":"blk-42959","kind":"paragraph","spans":[{"id":"spn-48979","text":"After outcome learning bursts"}]}],"id":"blk-42958","kind":"list-item"},{"blocks":[{"id":"blk-42961","kind":"paragraph","spans":[{"id":"spn-48980","text":"Before critical retrievals (ensures clean, high-quality graph)"}]}],"id":"blk-42960","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42962","kind":"paragraph","spans":[{"id":"spn-48981","text":"Consolidation also runs automatically during idle — manual triggers supplement this."}]},{"id":"blk-42963","kind":"heading","level":2,"spans":[{"id":"spn-48982","text":"Consolidation Log Resource"}]},{"id":"blk-42964","kind":"paragraph","spans":[{"id":"spn-48983","text":"Read the current consolidation state and orchestrator metrics without triggering a cycle:"}]},{"id":"blk-42965","kind":"code","language":"text","text":"Resource URI: graphonomous://consolidation/log"},{"id":"blk-42966","kind":"paragraph","spans":[{"id":"spn-48984","text":"Returns consolidator state (cycle count, last run, config) and orchestrator plasticity metrics (current learning rate, churn estimate, counters). Useful for monitoring without side effects."}]},{"id":"blk-42967","kind":"heading","level":2,"spans":[{"id":"spn-48985","text":"Health Indicators"}]},{"head":[{"id":"blk-42969","spans":[{"id":"spn-48986","text":"Metric"}]},{"id":"blk-42970","spans":[{"id":"spn-48987","text":"Healthy Range"}]},{"id":"blk-42971","spans":[{"id":"spn-48988","text":"Problem If"}]}],"id":"blk-42968","kind":"table","rows":[[{"id":"blk-42972","spans":[{"id":"spn-48989","text":"Node count"}]},{"id":"blk-42973","spans":[{"id":"spn-48990","text":"Growing steadily"}]},{"id":"blk-42974","spans":[{"id":"spn-48991","text":"Stagnant or shrinking rapidly"}]}],[{"id":"blk-42975","spans":[{"id":"spn-48992","text":"Pruned count"}]},{"id":"blk-42976","spans":[{"id":"spn-48993","text":"> 0 occasionally"}]},{"id":"blk-42977","spans":[{"id":"spn-48994","text":"Always 0 (no decay) or very high (over-aggressive)"}]}],[{"id":"blk-42978","spans":[{"id":"spn-48995","text":"Merged count"}]},{"id":"blk-42979","spans":[{"id":"spn-48996","text":"Occasional"}]},{"id":"blk-42980","spans":[{"id":"spn-48997","text":"Never (duplicates accumulating)"}]}],[{"id":"blk-42981","spans":[{"id":"spn-48998","text":"Edge/node ratio"}]},{"id":"blk-42982","spans":[{"id":"spn-48999","text":"0.5–3.0"}]},{"id":"blk-42983","spans":[{"id":"spn-49000","text":"< 0.5 (isolated nodes) or > 3.0 (edge spaghetti)"}]}],[{"id":"blk-42984","spans":[{"id":"spn-49001","text":"Cycle count"}]},{"id":"blk-42985","spans":[{"id":"spn-49002","text":"Increasing"}]},{"id":"blk-42986","spans":[{"id":"spn-49003","text":"N/A (just informational)"}]}]]},{"id":"blk-42987","kind":"heading","level":2,"spans":[{"id":"spn-49004","text":"Consolidation and Goals"}]},{"id":"blk-42988","kind":"paragraph","spans":[{"id":"spn-49005","text":"Consolidation can prune nodes that are linked to goals, which affects coverage scores. After heavy consolidation, consider re-reviewing active goals with "},{"id":"spn-49006","marks":["code"],"text":"review_goal"},{"id":"spn-49007","text":" to ensure coverage hasn't dropped below thresholds."}]},{"id":"blk-42989","kind":"heading","level":2,"spans":[{"id":"spn-49008","text":"Anti-patterns to avoid"}]},{"id":"blk-42990","items":[{"blocks":[{"id":"blk-42992","kind":"paragraph","spans":[{"id":"spn-49009","text":"Consolidation neglect — never running consolidation, letting the graph accumulate noise"}]}],"id":"blk-42991","kind":"list-item"},{"blocks":[{"id":"blk-42994","kind":"paragraph","spans":[{"id":"spn-49010","text":"Running consolidation too frequently during active work (once per session boundary is usually enough)"}]}],"id":"blk-42993","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierapxsjkk6yht74dbrh43ls2pbkz744oqigr3vlcij5jh4oouldanvq","vocabulary":"ampersand.docs.fs.v1"}