{"bendscript":"0.1","blocks":[{"id":"blk-67091","kind":"heading","level":1,"spans":[{"id":"spn-97688","text":"Consolidation"}]},{"id":"blk-67092","kind":"paragraph","spans":[{"id":"spn-97689","text":"Trigger graph maintenance — decay weak knowledge, prune, merge duplicates, strengthen relationships."}]},{"id":"blk-67093","kind":"heading","level":2,"spans":[{"id":"spn-97690","text":"Trigger Consolidation"}]},{"id":"blk-67094","kind":"code","language":"text","text":"consolidate(action: \"run\", wait_ms: 2000)"},{"id":"blk-67095","kind":"paragraph","spans":[{"id":"spn-97691","text":"The "},{"id":"spn-97692","marks":["code"],"text":"consolidate"},{"id":"spn-97693","text":" machine supports these actions:"}]},{"id":"blk-67096","items":[{"blocks":[{"id":"blk-67098","kind":"paragraph","spans":[{"id":"spn-97694","marks":["code"],"text":"run"},{"id":"spn-97695","text":" — trigger consolidation (optionally wait with "},{"id":"spn-97696","marks":["code"],"text":"wait_ms"},{"id":"spn-97697","text":")"}]}],"id":"blk-67097","kind":"list-item"},{"blocks":[{"id":"blk-67100","kind":"paragraph","spans":[{"id":"spn-97698","marks":["code"],"text":"stats"},{"id":"spn-97699","text":" — aggregate graph health without triggering"}]}],"id":"blk-67099","kind":"list-item"},{"blocks":[{"id":"blk-67102","kind":"paragraph","spans":[{"id":"spn-97700","marks":["code"],"text":"query"},{"id":"spn-97701","text":" — operation-based graph inspection"}]}],"id":"blk-67101","kind":"list-item"},{"blocks":[{"id":"blk-67104","kind":"paragraph","spans":[{"id":"spn-97702","marks":["code"],"text":"traverse"},{"id":"spn-97703","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-67103","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67105","kind":"paragraph","spans":[{"id":"spn-97704","marks":["bold"],"text":"`wait_ms`:"},{"id":"spn-97705","text":" 0–30000 (max 30 seconds). How long to wait for completion before returning status."}]},{"id":"blk-67106","kind":"heading","level":2,"spans":[{"id":"spn-97706","text":"The 7-Stage Pipeline"}]},{"id":"blk-67107","items":[{"blocks":[{"id":"blk-67109","kind":"paragraph","spans":[{"id":"spn-97707","marks":["bold"],"text":"Decay confidence"},{"id":"spn-97708","text":" — time-based confidence reduction. Nodes not accessed or reinforced gradually lose confidence."}]}],"id":"blk-67108","kind":"list-item"},{"blocks":[{"id":"blk-67111","kind":"paragraph","spans":[{"id":"spn-97709","marks":["bold"],"text":"Prune weak nodes"},{"id":"spn-97710","text":" — remove nodes below the confidence threshold. Eliminates knowledge that has decayed past usefulness."}]}],"id":"blk-67110","kind":"list-item"},{"blocks":[{"id":"blk-67113","kind":"paragraph","spans":[{"id":"spn-97711","marks":["bold"],"text":"Prune weak edges"},{"id":"spn-97712","text":" — remove edges below the weight threshold. Cleans up tenuous connections."}]}],"id":"blk-67112","kind":"list-item"},{"blocks":[{"id":"blk-67115","kind":"paragraph","spans":[{"id":"spn-97713","marks":["bold"],"text":"Strengthen co-activated"},{"id":"spn-97714","text":" — boost edges between nodes frequently retrieved together (\"neurons that fire together wire together\")."}]}],"id":"blk-67114","kind":"list-item"},{"blocks":[{"id":"blk-67117","kind":"paragraph","spans":[{"id":"spn-97715","marks":["bold"],"text":"Merge similar nodes"},{"id":"spn-97716","text":" — combine near-duplicate nodes (similarity > 0.95 default). Consolidates redundant knowledge."}]}],"id":"blk-67116","kind":"list-item"},{"blocks":[{"id":"blk-67119","kind":"paragraph","spans":[{"id":"spn-97717","marks":["bold"],"text":"Promote timescale"},{"id":"spn-97718","text":" — move valuable, frequently-accessed nodes to slower decay tiers (fast → medium → slow → glacial)."}]}],"id":"blk-67118","kind":"list-item"},{"blocks":[{"id":"blk-67121","kind":"paragraph","spans":[{"id":"spn-97719","marks":["bold"],"text":"Generate abstractions"},{"id":"spn-97720","text":" — create semantic summary nodes from clusters of episodic observations."}]}],"id":"blk-67120","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67122","kind":"heading","level":2,"spans":[{"id":"spn-97721","text":"Timescale System"}]},{"id":"blk-67123","kind":"paragraph","spans":[{"id":"spn-97722","text":"Nodes live on one of 4 decay tiers:"}]},{"head":[{"id":"blk-67125","spans":[{"id":"spn-97723","text":"Tier"}]},{"id":"blk-67126","spans":[{"id":"spn-97724","text":"TTL"}]},{"id":"blk-67127","spans":[{"id":"spn-97725","text":"Decay Rate"}]},{"id":"blk-67128","spans":[{"id":"spn-97726","text":"Purpose"}]}],"id":"blk-67124","kind":"table","rows":[[{"id":"blk-67129","spans":[{"id":"spn-97727","marks":["bold"],"text":"fast"}]},{"id":"blk-67130","spans":[{"id":"spn-97728","text":"Hours"}]},{"id":"blk-67131","spans":[{"id":"spn-97729","text":"High"}]},{"id":"blk-67132","spans":[{"id":"spn-97730","text":"Working memory, session-local observations"}]}],[{"id":"blk-67133","spans":[{"id":"spn-97731","marks":["bold"],"text":"medium"}]},{"id":"blk-67134","spans":[{"id":"spn-97732","text":"Days"}]},{"id":"blk-67135","spans":[{"id":"spn-97733","text":"Moderate"}]},{"id":"blk-67136","spans":[{"id":"spn-97734","text":"Recently reinforced knowledge"}]}],[{"id":"blk-67137","spans":[{"id":"spn-97735","marks":["bold"],"text":"slow"}]},{"id":"blk-67138","spans":[{"id":"spn-97736","text":"Weeks"}]},{"id":"blk-67139","spans":[{"id":"spn-97737","text":"Low"}]},{"id":"blk-67140","spans":[{"id":"spn-97738","text":"Well-established, frequently-used facts"}]}],[{"id":"blk-67141","spans":[{"id":"spn-97739","marks":["bold"],"text":"glacial"}]},{"id":"blk-67142","spans":[{"id":"spn-97740","text":"Months+"}]},{"id":"blk-67143","spans":[{"id":"spn-97741","text":"Minimal"}]},{"id":"blk-67144","spans":[{"id":"spn-97742","text":"Core architectural knowledge, proven procedures"}]}]]},{"id":"blk-67145","kind":"paragraph","spans":[{"id":"spn-97743","text":"Consolidation promotes nodes up tiers based on access frequency and confidence. Decay happens within each tier at its own rate."}]},{"id":"blk-67146","kind":"heading","level":2,"spans":[{"id":"spn-97744","text":"When to Consolidate"}]},{"id":"blk-67147","items":[{"blocks":[{"id":"blk-67149","kind":"paragraph","spans":[{"id":"spn-97745","text":"End of every productive session"}]}],"id":"blk-67148","kind":"list-item"},{"blocks":[{"id":"blk-67151","kind":"paragraph","spans":[{"id":"spn-97746","text":"Every 4–5 heavy storage/learning iterations"}]}],"id":"blk-67150","kind":"list-item"},{"blocks":[{"id":"blk-67153","kind":"paragraph","spans":[{"id":"spn-97747","text":"After outcome learning bursts"}]}],"id":"blk-67152","kind":"list-item"},{"blocks":[{"id":"blk-67155","kind":"paragraph","spans":[{"id":"spn-97748","text":"Before critical retrievals (ensures clean, high-quality graph)"}]}],"id":"blk-67154","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67156","kind":"paragraph","spans":[{"id":"spn-97749","text":"Consolidation also runs automatically during idle — manual triggers supplement this."}]},{"id":"blk-67157","kind":"heading","level":2,"spans":[{"id":"spn-97750","text":"Consolidation Log Resource"}]},{"id":"blk-67158","kind":"paragraph","spans":[{"id":"spn-97751","text":"Read the current consolidation state and orchestrator metrics without triggering a cycle:"}]},{"id":"blk-67159","kind":"code","language":"text","text":"Resource URI: graphonomous://consolidation/log"},{"id":"blk-67160","kind":"paragraph","spans":[{"id":"spn-97752","text":"Returns consolidator state (cycle count, last run, config) and orchestrator plasticity metrics (current learning rate, churn estimate, counters). Useful for monitoring without side effects."}]},{"id":"blk-67161","kind":"heading","level":2,"spans":[{"id":"spn-97753","text":"Health Indicators"}]},{"head":[{"id":"blk-67163","spans":[{"id":"spn-97754","text":"Metric"}]},{"id":"blk-67164","spans":[{"id":"spn-97755","text":"Healthy Range"}]},{"id":"blk-67165","spans":[{"id":"spn-97756","text":"Problem If"}]}],"id":