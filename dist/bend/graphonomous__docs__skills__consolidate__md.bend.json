{"bendscript":"0.1","blocks":[{"id":"blk-74574","kind":"heading","level":1,"spans":[{"id":"spn-137199","text":"Consolidation"}]},{"id":"blk-74575","kind":"paragraph","spans":[{"id":"spn-137200","text":"Trigger graph maintenance — decay weak knowledge, prune, merge duplicates, strengthen relationships."}]},{"id":"blk-74576","kind":"heading","level":2,"spans":[{"id":"spn-137201","text":"Trigger Consolidation"}]},{"id":"blk-74577","kind":"code","language":"text","text":"consolidate(action: \"run\", wait_ms: 2000)"},{"id":"blk-74578","kind":"paragraph","spans":[{"id":"spn-137202","text":"The "},{"id":"spn-137203","marks":["code"],"text":"consolidate"},{"id":"spn-137204","text":" machine supports these actions:"}]},{"id":"blk-74579","items":[{"blocks":[{"id":"blk-74581","kind":"paragraph","spans":[{"id":"spn-137205","marks":["code"],"text":"run"},{"id":"spn-137206","text":" — trigger consolidation (optionally wait with "},{"id":"spn-137207","marks":["code"],"text":"wait_ms"},{"id":"spn-137208","text":")"}]}],"id":"blk-74580","kind":"list-item"},{"blocks":[{"id":"blk-74583","kind":"paragraph","spans":[{"id":"spn-137209","marks":["code"],"text":"stats"},{"id":"spn-137210","text":" — aggregate graph health without triggering"}]}],"id":"blk-74582","kind":"list-item"},{"blocks":[{"id":"blk-74585","kind":"paragraph","spans":[{"id":"spn-137211","marks":["code"],"text":"query"},{"id":"spn-137212","text":" — operation-based graph inspection"}]}],"id":"blk-74584","kind":"list-item"},{"blocks":[{"id":"blk-74587","kind":"paragraph","spans":[{"id":"spn-137213","marks":["code"],"text":"traverse"},{"id":"spn-137214","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-74586","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74588","kind":"paragraph","spans":[{"id":"spn-137215","marks":["bold"],"text":"`wait_ms`:"},{"id":"spn-137216","text":" 0–30000 (max 30 seconds). How long to wait for completion before returning status."}]},{"id":"blk-74589","kind":"heading","level":2,"spans":[{"id":"spn-137217","text":"The 7-Stage Pipeline"}]},{"id":"blk-74590","items":[{"blocks":[{"id":"blk-74592","kind":"paragraph","spans":[{"id":"spn-137218","marks":["bold"],"text":"Decay confidence"},{"id":"spn-137219","text":" — time-based confidence reduction. Nodes not accessed or reinforced gradually lose confidence."}]}],"id":"blk-74591","kind":"list-item"},{"blocks":[{"id":"blk-74594","kind":"paragraph","spans":[{"id":"spn-137220","marks":["bold"],"text":"Prune weak nodes"},{"id":"spn-137221","text":" — remove nodes below the confidence threshold. Eliminates knowledge that has decayed past usefulness."}]}],"id":"blk-74593","kind":"list-item"},{"blocks":[{"id":"blk-74596","kind":"paragraph","spans":[{"id":"spn-137222","marks":["bold"],"text":"Prune weak edges"},{"id":"spn-137223","text":" — remove edges below the weight threshold. Cleans up tenuous connections."}]}],"id":"blk-74595","kind":"list-item"},{"blocks":[{"id":"blk-74598","kind":"paragraph","spans":[{"id":"spn-137224","marks":["bold"],"text":"Strengthen co-activated"},{"id":"spn-137225","text":" — boost edges between nodes frequently retrieved together (\"neurons that fire together wire together\")."}]}],"id":"blk-74597","kind":"list-item"},{"blocks":[{"id":"blk-74600","kind":"paragraph","spans":[{"id":"spn-137226","marks":["bold"],"text":"Merge similar nodes"},{"id":"spn-137227","text":" — combine near-duplicate nodes (similarity > 0.95 default). Consolidates redundant knowledge."}]}],"id":"blk-74599","kind":"list-item"},{"blocks":[{"id":"blk-74602","kind":"paragraph","spans":[{"id":"spn-137228","marks":["bold"],"text":"Promote timescale"},{"id":"spn-137229","text":" — move valuable, frequently-accessed nodes to slower decay tiers (fast → medium → slow → glacial)."}]}],"id":"blk-74601","kind":"list-item"},{"blocks":[{"id":"blk-74604","kind":"paragraph","spans":[{"id":"spn-137230","marks":["bold"],"text":"Generate abstractions"},{"id":"spn-137231","text":" — create semantic summary nodes from clusters of episodic observations."}]}],"id":"blk-74603","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74605","kind":"heading","level":2,"spans":[{"id":"spn-137232","text":"Timescale System"}]},{"id":"blk-74606","kind":"paragraph","spans":[{"id":"spn-137233","text":"Nodes live on one of 4 decay tiers:"}]},{"head":[{"id":"blk-74608","spans":[{"id":"spn-137234","text":"Tier"}]},{"id":"blk-74609","spans":[{"id":"spn-137235","text":"TTL"}]},{"id":"blk-74610","spans":[{"id":"spn-137236","text":"Decay Rate"}]},{"id":"blk-74611","spans":[{"id":"spn-137237","text":"Purpose"}]}],"id":"blk-74607","kind":"table","rows":[[{"id":"blk-74612","spans":[{"id":"spn-137238","marks":["bold"],"text":"fast"}]},{"id":"blk-74613","spans":[{"id":"spn-137239","text":"Hours"}]},{"id":"blk-74614","spans":[{"id":"spn-137240","text":"High"}]},{"id":"blk-74615","spans":[{"id":"spn-137241","text":"Working memory, session-local observations"}]}],[{"id":"blk-74616","spans":[{"id":"spn-137242","marks":["bold"],"text":"medium"}]},{"id":"blk-74617","spans":[{"id":"spn-137243","text":"Days"}]},{"id":"blk-74618","spans":[{"id":"spn-137244","text":"Moderate"}]},{"id":"blk-74619","spans":[{"id":"spn-137245","text":"Recently reinforced knowledge"}]}],[{"id":"blk-74620","spans":[{"id":"spn-137246","marks":["bold"],"text":"slow"}]},{"id":"blk-74621","spans":[{"id":"spn-137247","text":"Weeks"}]},{"id":"blk-74622","spans":[{"id":"spn-137248","text":"Low"}]},{"id":"blk-74623","spans":[{"id":"spn-137249","text":"Well-established, frequently-used facts"}]}],[{"id":"blk-74624","spans":[{"id":"spn-137250","marks":["bold"],"text":"glacial"}]},{"id":"blk-74625","spans":[{"id":"spn-137251","text":"Months+"}]},{"id":"blk-74626","spans":[{"id":"spn-137252","text":"Minimal"}]},{"id":"blk-74627","spans":[{"id":"spn-137253","text":"Core architectural knowledge, proven procedures"}]}]]},{"id":"blk-74628","kind":"paragraph","spans":[{"id":"spn-137254","text":"Consolidation promotes nodes up tiers based on access frequency and confidence. Decay happens within each tier at its own rate."}]},{"id":"blk-74629","kind":"heading","level":2,"spans":[{"id":"spn-137255","text":"When to Consolidate"}]},{"id":"blk-74630","items":[{"blocks":[{"id":"blk-74632","kind":"paragraph","spans":[{"id":"spn-137256","text":"End of every productive session"}]}],"id":"blk-74631","kind":"list-item"},{"blocks":[{"id":"blk-74634","kind":"paragraph","spans":[{"id":"spn-137257","text":"Every 4–5 heavy storage/learning iterations"}]}],"id":"blk-74633","kind":"list-item"},{"blocks":[{"id":"blk-74636","kind":"paragraph","spans":[{"id":"spn-137258","text":"After outcome learning bursts"}]}],"id":"blk-74635","kind":"list-item"},{"blocks":[{"id":"blk-74638","kind":"paragraph","spans":[{"id":"spn-137259","text":"Before critical retrievals (ensures clean, high-quality graph)"}]}],"id":"blk-74637","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74639","kind":"paragraph","spans":[{"id":"spn-137260","text":"Consolidation also runs automatically during idle — manual triggers supplement this."}]},{"id":"blk-74640","kind":"heading","level":2,"spans":[{"id":"spn-137261","text":"Consolidation Log Resource"}]},{"id":"blk-74641","kind":"paragraph","spans":[{"id":"spn-137262","text":"Read the current consolidation state and orchestrator metrics without triggering a cycle:"}]},{"id":"blk-74642","kind":"code","language":"text","text":"Resource URI: graphonomous://consolidation/log"},{"id":"blk-74643","kind":"paragraph","spans":[{"id":"spn-137263","text":"Returns consolidator state (cycle count, last run, config) and orchestrator plasticity metrics (current learning rate, churn estimate, counters). Useful for monitoring without side effects."}]},{"id":"blk-74644","kind":"heading","level":2,"spans":[{"id":"spn-137264","text":"Health Indicators"}]},{"head":[{"id":"blk-74646","spans":[{"id":"spn-137265","text":"Metric"}]},{"id":"blk-74647","spans":[{"id":"spn-137266","text":"Healthy Range"}]},{"id":"blk-74648","spans":[{"id":"spn-137267","text":"Problem If"}]}],"id":"blk-74645","kind":"table","rows":[[{"id":"blk-74649","spans":[{"id":"spn-137268","text":"Node count"}]},{"id":"blk-74650","spans":[{"id":"spn-137269","text":"Growing steadily"}]},{"id":"blk-74651","spans":[{"id":"spn-137270","text":"Stagnant or shrinking rapidly"}]}],[{"id":"blk-74652","spans":[{"id":"spn-137271","text":"Pruned count"}]},{"id":"blk-74653","spans":[{"id":"spn-137272","text":"> 0 occasionally"}]},{"id":"blk-74654","spans":[{"id":"spn-137273","text":"Always 0 (no decay) or very high (over-aggressive)"}]}],[{"id":"blk-74655","spans":[{"id":"spn-137274","text":"Merged count"}]},{"id":"blk-74656","spans":[{"id":"spn-137275","text":"Occasional"}]},{"id":"blk-74657","spans":[{"id":"spn-137276","text":"Never (duplicates accumulating)"}]}],[{"id":"blk-74658","spans":[{"id":"spn-137277","text":"Edge/node ratio"}]},{"id":"blk-74659","spans":[{"id":"spn-137278","text":"0.5–3.0"}]},{"id":"blk-74660","spans":[{"id":"spn-137279","text":"< 0.5 (isolated nodes) or > 3.0 (edge spaghetti)"}]}],[{"id":"blk-74661","spans":[{"id":"spn-137280","text":"Cycle count"}]},{"id":"blk-74662","spans":[{"id":"spn-137281","text":"Increasing"}]},{"id":"blk-74663","spans":[{"id":"spn-137282","text":"N/A (just informational)"}]}]]},{"id":"blk-74664","kind":"heading","level":2,"spans":[{"id":"spn-137283","text":"Consolidation and Goals"}]},{"id":"blk-74665","kind":"paragraph","spans":[{"id":"spn-137284","text":"Consolidation can prune nodes that are linked to goals, which affects coverage scores. After heavy consolidation, consider re-reviewing active goals with "},{"id":"spn-137285","marks":["code"],"text":"review_goal"},{"id":"spn-137286","text":" to ensure coverage hasn't dropped below thresholds."}]},{"id":"blk-74666","kind":"heading","level":2,"spans":[{"id":"spn-137287","text":"Anti-patterns to avoid"}]},{"id":"blk-74667","items":[{"blocks":[{"id":"blk-74669","kind":"paragraph","spans":[{"id":"spn-137288","text":"Consolidation neglect — never running consolidation, letting the graph accumulate noise"}]}],"id":"blk-74668","kind":"list-item"},{"blocks":[{"id":"blk-74671","kind":"paragraph","spans":[{"id":"spn-137289","text":"Running consolidation too frequently during active work (once per session boundary is usually enough)"}]}],"id":"blk-74670","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierakfd5ui6li3e7vzxv342jsfovehzmx5aomitgbxhtd2snimngoduq","vocabulary":"ampersand.docs.fs.v1"}