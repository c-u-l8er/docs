{"bendscript":"0.1","blocks":[{"id":"blk-68111","kind":"heading","level":1,"spans":[{"id":"spn-98823","text":"Evidence Path Tracing"}]},{"id":"blk-68112","kind":"paragraph","spans":[{"id":"spn-98824","text":"Find the lowest-cost evidence path between two knowledge nodes using weighted Dijkstra with optional K-shortest alternate paths via Yen's algorithm."}]},{"id":"blk-68113","kind":"heading","level":2,"spans":[{"id":"spn-98825","text":"Arguments"}]},{"id":"blk-68114","kind":"paragraph","spans":[{"id":"spn-98826","text":"From/to node IDs and options: $ARGUMENTS"}]},{"id":"blk-68115","kind":"heading","level":2,"spans":[{"id":"spn-98827","text":"When to Use"}]},{"id":"blk-68116","items":[{"blocks":[{"id":"blk-68118","kind":"paragraph","spans":[{"id":"spn-98828","marks":["bold"],"text":"Explainability"},{"id":"spn-98829","text":" — \"Why did you conclude X from Y?\" Trace the causal chain."}]}],"id":"blk-68117","kind":"list-item"},{"blocks":[{"id":"blk-68120","kind":"paragraph","spans":[{"id":"spn-98830","marks":["bold"],"text":"Provenance audit"},{"id":"spn-98831","text":" — Verify that a conclusion has a legitimate evidence path."}]}],"id":"blk-68119","kind":"list-item"},{"blocks":[{"id":"blk-68122","kind":"paragraph","spans":[{"id":"spn-98832","marks":["bold"],"text":"Decision support"},{"id":"spn-98833","text":" — Before high-stakes actions, show the reasoning chain."}]}],"id":"blk-68121","kind":"list-item"},{"blocks":[{"id":"blk-68124","kind":"paragraph","spans":[{"id":"spn-98834","marks":["bold"],"text":"Contradiction investigation"},{"id":"spn-98835","text":" — When two nodes seem related but the connection is unclear."}]}],"id":"blk-68123","kind":"list-item"},{"blocks":[{"id":"blk-68126","kind":"paragraph","spans":[{"id":"spn-98836","marks":["bold"],"text":"After deliberation"},{"id":"spn-98837","text":" — Verify that crystallized conclusions connect back to source evidence."}]}],"id":"blk-68125","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68127","kind":"heading","level":2,"spans":[{"id":"spn-98838","text":"Basic Usage"}]},{"id":"blk-68128","kind":"heading","level":3,"spans":[{"id":"spn-98839","text":"Trace shortest evidence path"}]},{"id":"blk-68129","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\")"},{"id":"blk-68130","kind":"paragraph","spans":[{"id":"spn-98840","text":"Returns the single lowest-cost path with per-edge cost breakdown."}]},{"id":"blk-68131","kind":"heading","level":3,"spans":[{"id":"spn-98841","text":"Find K alternate paths"}]},{"id":"blk-68132","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\", k: 3)"},{"id":"blk-68133","kind":"paragraph","spans":[{"id":"spn-98842","text":"Returns up to K paths ranked by total cost, using Yen's algorithm. Useful for finding diverse reasoning chains."}]},{"id":"blk-68134","kind":"heading","level":2,"spans":[{"id":"spn-98843","text":"Parameters"}]},{"head":[{"id":"blk-68136","spans":[{"id":"spn-98844","text":"Parameter"}]},{"id":"blk-68137","spans":[{"id":"spn-98845","text":"Type"}]},{"id":"blk-68138","spans":[{"id":"spn-98846","text":"Default"}]},{"id":"blk-68139","spans":[{"id":"spn-98847","text":"Description"}]}],"id":"blk-68135","kind":"table","rows":[[{"id":"blk-68140","spans":[{"id":"spn-98848","marks":["code"],"text":"source_id"}]},{"id":"blk-68141","spans":[{"id":"spn-98849","text":"string"}]},{"id":"blk-68142","spans":[{"id":"spn-98850","text":"_(required)_"}]},{"id":"blk-68143","spans":[{"id":"spn-98851","text":"Source node ID"}]}],[{"id":"blk-68144","spans":[{"id":"spn-98852","marks":["code"],"text":"target_id"}]},{"id":"blk-68145","spans":[{"id":"spn-98853","text":"string"}]},{"id":"blk-68146","spans":[{"id":"spn-98854","text":"_(required)_"}]},{"id":"blk-68147","spans":[{"id":"spn-98855","text":"Target node ID"}]}],[{"id":"blk-68148","spans":[{"id":"spn-98856","marks":["code"],"text":"k"}]},{"id":"blk-68149","spans":[{"id":"spn-98857","text":"number"}]},{"id":"blk-68150","spans":[{"id":"spn-98858","text":"1"}]},{"id":"blk-68151","spans":[{"id":"spn-98859","text":"Number of alternate paths (max 10)"}]}],[{"id":"blk-68152","spans":[{"id":"spn-98860","marks":["code"],"text":"half_life_hours"}]},{"id":"blk-68153","spans":[{"id":"spn-98861","text":"number"}]},{"id":"blk-68154","spans":[{"id":"spn-98862","text":"168.0"}]},{"id":"blk-68155","spans":[{"id":"spn-98863","text":"Recency decay half-life (lower = prefer recent edges)"}]}],[{"id":"blk-68156","spans":[{"id":"spn-98864","marks":["code"],"text":"bidirectional"}]},{"id":"blk-68157","spans":[{"id":"spn-98865","text":"boolean"}]},{"id":"blk-68158","spans":[{"id":"spn-98866","text":"true"}]},{"id":"blk-68159","spans":[{"id":"spn-98867","text":"Search edges in both directions"}]}],[{"id":"blk-68160","spans":[{"id":"spn-98868","marks":["code"],"text":"max_hops"}]},{"id":"blk-68161","spans":[{"id":"spn-98869","text":"number"}]},{"id":"blk-68162","spans":[{"id":"spn-98870","text":"10"}]},{"id":"blk-68163","spans":[{"id":"spn-98871","text":"BFS expansion limit for subgraph construction"}]}]]},{"id":"blk-68164","kind":"heading","level":2,"spans":[{"id":"spn-98872","text":"Cost Function"}]},{"id":"blk-68165","kind":"paragraph","spans":[{"id":"spn-98873","text":"Each edge's cost is computed as:"}]},{"id":"blk-68166","kind":"code","language":"text","text":"cost = -log(confidence) + recency_decay(age_hours / half_life) + type_cost(edge_type)"},{"id":"blk-68167","kind":"paragraph","spans":[{"id":"spn-98874","marks":["bold"],"text":"Type costs:"}]},{"head":[{"id":"blk-68169","spans":[{"id":"spn-98875","text":"Edge Type"}]},{"id":"blk-68170","spans":[{"id":"spn-98876","text":"Cost"}]},{"id":"blk-68171","spans":[{"id":"spn-98877","text":"Rationale"}]}],"id":"blk-68168","kind":"table","rows":[[{"id":"blk-68172","spans":[{"id":"spn-98878","marks":["code"],"text":"causal"}]},{"id":"blk-68173","spans":[{"id":"spn-98879","text":"0.0"}]},{"id":"blk-68174","spans":[{"id":"spn-98880","text":"Direct causation is free — strongest evidence"}]}],[{"id":"blk-68175","spans":[{"id":"spn-98881","marks":["code"],"text":"supports"}]},{"id":"blk-68176","spans":[{"id":"spn-98882","text":"0.1"}]},{"id":"blk-68177","spans":[{"id":"spn-98883","text":"Supporting evidence is cheap"}]}],[{"id":"blk-68178","spans":[{"id":"spn-98884","marks":["code"],"text":"related_to"}]},{"id":"blk-68179","spans":[{"id":"spn-98885","text":"0.5"}]},{"id":"blk-68180","spans":[{"id":"spn-98886","text":"Association — weaker link"}]}],[{"id":"blk-68181","spans":[{"id":"spn-98887","marks":["code"],"text":"contradicts"}]},{"id":"blk-68182","spans":[{"id":"spn-98888","text":"2.0"}]},{"id":"blk-68183","spans":[{"id":"spn-98889","text":"Penalty for contradictory edges"}]}],[{"id":"blk-68184","spans":[{"id":"spn-98890","text":"other"}]},{"id":"blk-68185","spans":[{"id":"spn-98891","text":"1.0"}]},{"id":"blk-68186","spans":[{"id":"spn-98892","text":"Default penalty"}]}]]},{"id":"blk-68187","kind":"paragraph","spans":[{"id":"spn-98893","marks":["bold"],"text":"Implications:"}]},{"id":"blk-68188","items":[{"blocks":[{"id":"blk-68190","kind":"paragraph","spans":[{"id":"spn-98894","text":"High-confidence causal edges are nearly free to traverse."}]}],"id":"blk-68189","kind":"list-item"},{"blocks":[{"id":"blk-68192","kind":"paragraph","spans":[{"id":"spn-98895","text":"Old edges are more expensive (recency decay)."}]}],"id":"blk-68191","kind":"list-item"},{"blocks":[{"id":"blk-68194","kind":"paragraph","spans":[{"id":"spn-98896","text":"Contradictory paths are strongly penalized — if the shortest path traverses a "},{"id":"spn-98897","marks":["code"],"text":"contradicts"},{"id":"spn-98898","text":" edge, something may be wrong."}]}],"id":"blk-68193","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68195","kind":"heading","level":2,"spans":[{"id":"spn-98899","text":"Response Fields"}]},{"id":"blk-68196","kind":"code","language":"json","text":"{\n  \"paths\": [\n    {\n      \"path\": [\"node_abc\", \"node_def\", \"node_ghi\"],\n      \"total_cost\": 0.423,\n      \"edges\": [\n        {\"from\": \"node_abc\", \"to\": \"node_def\", \"cost\": 0.105, \"edge_type\": \"causal\", \"confidence\": 0.9},\n        {\"from\": \"node_def\", \"to\": \"node_ghi\", \"cost\": 0.318, \"edge_type\": \"supports\", \"confidence\": 0.7}\n      ]\n    }\n  ],\n  \"subgraph_size\": {\"nodes\": 15, \"edges\": 23}\n}"},{"id":"blk-68197","kind":"heading","level":2,"spans":[{"id":"spn-98900","text":"Full Workflow"}]},{"id":"blk-68198","items":[{"blocks":[{"id":"blk-68200","kind":"paragraph","spans":[{"id":"spn-98901","marks":["bold"],"text":"Identify endpoints"},{"id":"spn-98902","text":" — use "},{"id":"spn-98903","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-98904","text":" or "},{"id":"spn-98905","marks":["code"],"text":"consolidate(action: \"query\", ...)"},{"id":"spn-98906","text":" to find the two nodes you want to connect."}]}],"id":"blk-68199","kind":"list-item"},{"blocks":[{"id":"blk-68202","kind":"paragraph","spans":[{"id":"spn-98907","marks":["bold"],"text":"Trace path"},{"id":"spn-98908","text":" — "},{"id":"spn-98909","marks":["code"],"text":"retrieve(action: \"trace_evidence\", source_id: \"<id_a>\", target_id: \"<id_b>\", k: 3)"}]}],"id":"blk-68201","kind":"list-item"},{"blocks":[{"id":"blk-68204","kind":"paragraph","spans":[{"id":"spn-98910","marks":["bold"],"text":"Interpret costs"},{"id":"spn-98911","text":" — low total cost = strong evidence chain. Check for "},{"id":"spn-98912","marks":["code"],"text":"contradicts"},{"id":"spn-98913","text":" edges in any path."}]}],"id":"blk-68203","kind":"list-item"},{"blocks":[{"id":"blk-68206","kind":"paragraph","spans":[{"id":"spn-98914","marks":["bold"],"text":"Report to user"},{"id":"spn-98915","text":" — summarize the chain in natural language."}]}],"id":"blk-68205","kind":"list-item"},{"blocks":[{"id":"blk-68208","kind":"paragraph","spans":[{"id":"spn-98916","marks":["bold"],"text":"Store episodic"},{"id":"spn-98917","text":" — if the trace revealed something important, store it as an episodic node."}]}],"id":"blk-68207","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68209","kind":"heading","level":2,"spans":[{"id":"spn-98918","text":"Combining with Other Machines"}]},{"head":[{"id":"blk-68211","spans":[{"id":"spn-98919","text":"Scenario"}]},{"id":"blk-68212","spans":[{"id":"spn-98920","text":"Workflow"}]}],"id":"blk-68210","kind":"table","rows":[[{"id":"blk-68213","spans":[{"id":"spn-98921","text":"Verify deliberation output"}]},{"id":"blk-68214","spans":[{"id":"spn-98922","marks":["code"],"text":"route(action: \"deliberate\")"},{"id":"spn-98923","text":" -> "},{"id":"spn-98924","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-98925","text":" from source to conclusion"}]}],[{"id":"blk-68215","spans":[{"id":"spn-98926","text":"Audit before high-stakes action"}]},{"id":"blk-68216","spans":[{"id":"spn-98927","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-98928","text":" -> identify causal chain -> "},{"id":"spn-98929","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-98930","text":" to verify"}]}],[{"id":"blk-68217","spans":[{"id":"spn-98931","text":"Investigate contradiction"}]},{"id":"blk-68218","spans":[{"id":"spn-98932","marks":["code"],"text":"learn(action: \"contradictions\")"},{"id":"spn-98933","text":" -> find conflicting nodes -> "},{"id":"spn-98934","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-98935","text":" between them"}]}],[{"id":"blk-68219","spans":[{"id":"spn-98936","text":"Topology + path"}]},{"id":"blk-68220","spans":[{"id":"spn-98937","marks":["code"],"text":"route(action: \"topology\")"},{"id":"spn-98938","text":" -> identify SCC members -> "},{"id":"spn-98939","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-98940","text":" within the cycle"}]}],[{"id":"blk-68221","spans":[{"id":"spn-98941","text":"Goal provenance"}]},{"id":"blk-68222","spans":[{"id":"spn-98942","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-98943","text":" -> get linked nodes -> "},{"id":"spn-98944","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-98945","text":" from evidence to goal"}]}]]},{"id":"blk-68223","kind":"heading","level":2,"spans":[{"id":"spn-98946","text":"Tuning Tips"}]},{"id":"blk-68224","items":[{"blocks":[{"id":"blk-68226","kind":"paragraph","spans":[{"id":"spn-98947","marks":["bold"],"text":"Lower `half_life_hours`"},{"id":"spn-98948","text":" (e.g., 24) to strongly prefer recent evidence chains."}]}],"id":"blk-68225","kind":"list-item"},{"blocks":[{"id":"blk-68228","kind":"paragraph","spans":[{"id":"spn-98949","marks":["bold"],"text":"Set `bidirectional: false`"},{"id":"spn-98950","text":" to enforce strict causal direction."}]}],"id":"blk-68227","kind":"list-item"},{"blocks":[{"id":"blk-68230","kind":"paragraph","spans":[{"id":"spn-98951","marks":["bold"],"text":"Increase `k`"},{"id":"spn-98952","text":" to find diverse paths — if path 1 goes through node X but path 2 doesn't, node X is not the only link."}]}],"id":"blk-68229","kind":"list-item"},{"blocks":[{"id":"blk-68232","kind":"paragraph","spans":[{"id":"spn-98953","marks":["bold"],"text":"Increase `max_hops`"},{"id":"spn-98954","text":" for large graphs where the two nodes are far apart."}]}],"id":"blk-68231","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieragim2t3txuak6efapjoxudugh4elpmdzccgaxbomqhxd7thlrd22a","vocabulary":"ampersand.docs.fs.v1"}