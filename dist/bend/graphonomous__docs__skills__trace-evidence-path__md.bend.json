{"bendscript":"0.1","blocks":[{"id":"blk-75605","kind":"heading","level":1,"spans":[{"id":"spn-138387","text":"Evidence Path Tracing"}]},{"id":"blk-75606","kind":"paragraph","spans":[{"id":"spn-138388","text":"Find the lowest-cost evidence path between two knowledge nodes using weighted Dijkstra with optional K-shortest alternate paths via Yen's algorithm."}]},{"id":"blk-75607","kind":"heading","level":2,"spans":[{"id":"spn-138389","text":"Arguments"}]},{"id":"blk-75608","kind":"paragraph","spans":[{"id":"spn-138390","text":"From/to node IDs and options: $ARGUMENTS"}]},{"id":"blk-75609","kind":"heading","level":2,"spans":[{"id":"spn-138391","text":"When to Use"}]},{"id":"blk-75610","items":[{"blocks":[{"id":"blk-75612","kind":"paragraph","spans":[{"id":"spn-138392","marks":["bold"],"text":"Explainability"},{"id":"spn-138393","text":" — \"Why did you conclude X from Y?\" Trace the causal chain."}]}],"id":"blk-75611","kind":"list-item"},{"blocks":[{"id":"blk-75614","kind":"paragraph","spans":[{"id":"spn-138394","marks":["bold"],"text":"Provenance audit"},{"id":"spn-138395","text":" — Verify that a conclusion has a legitimate evidence path."}]}],"id":"blk-75613","kind":"list-item"},{"blocks":[{"id":"blk-75616","kind":"paragraph","spans":[{"id":"spn-138396","marks":["bold"],"text":"Decision support"},{"id":"spn-138397","text":" — Before high-stakes actions, show the reasoning chain."}]}],"id":"blk-75615","kind":"list-item"},{"blocks":[{"id":"blk-75618","kind":"paragraph","spans":[{"id":"spn-138398","marks":["bold"],"text":"Contradiction investigation"},{"id":"spn-138399","text":" — When two nodes seem related but the connection is unclear."}]}],"id":"blk-75617","kind":"list-item"},{"blocks":[{"id":"blk-75620","kind":"paragraph","spans":[{"id":"spn-138400","marks":["bold"],"text":"After deliberation"},{"id":"spn-138401","text":" — Verify that crystallized conclusions connect back to source evidence."}]}],"id":"blk-75619","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75621","kind":"heading","level":2,"spans":[{"id":"spn-138402","text":"Basic Usage"}]},{"id":"blk-75622","kind":"heading","level":3,"spans":[{"id":"spn-138403","text":"Trace shortest evidence path"}]},{"id":"blk-75623","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\")"},{"id":"blk-75624","kind":"paragraph","spans":[{"id":"spn-138404","text":"Returns the single lowest-cost path with per-edge cost breakdown."}]},{"id":"blk-75625","kind":"heading","level":3,"spans":[{"id":"spn-138405","text":"Find K alternate paths"}]},{"id":"blk-75626","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\", k: 3)"},{"id":"blk-75627","kind":"paragraph","spans":[{"id":"spn-138406","text":"Returns up to K paths ranked by total cost, using Yen's algorithm. Useful for finding diverse reasoning chains."}]},{"id":"blk-75628","kind":"heading","level":2,"spans":[{"id":"spn-138407","text":"Parameters"}]},{"head":[{"id":"blk-75630","spans":[{"id":"spn-138408","text":"Parameter"}]},{"id":"blk-75631","spans":[{"id":"spn-138409","text":"Type"}]},{"id":"blk-75632","spans":[{"id":"spn-138410","text":"Default"}]},{"id":"blk-75633","spans":[{"id":"spn-138411","text":"Description"}]}],"id":"blk-75629","kind":"table","rows":[[{"id":"blk-75634","spans":[{"id":"spn-138412","marks":["code"],"text":"source_id"}]},{"id":"blk-75635","spans":[{"id":"spn-138413","text":"string"}]},{"id":"blk-75636","spans":[{"id":"spn-138414","text":"_(required)_"}]},{"id":"blk-75637","spans":[{"id":"spn-138415","text":"Source node ID"}]}],[{"id":"blk-75638","spans":[{"id":"spn-138416","marks":["code"],"text":"target_id"}]},{"id":"blk-75639","spans":[{"id":"spn-138417","text":"string"}]},{"id":"blk-75640","spans":[{"id":"spn-138418","text":"_(required)_"}]},{"id":"blk-75641","spans":[{"id":"spn-138419","text":"Target node ID"}]}],[{"id":"blk-75642","spans":[{"id":"spn-138420","marks":["code"],"text":"k"}]},{"id":"blk-75643","spans":[{"id":"spn-138421","text":"number"}]},{"id":"blk-75644","spans":[{"id":"spn-138422","text":"1"}]},{"id":"blk-75645","spans":[{"id":"spn-138423","text":"Number of alternate paths (max 10)"}]}],[{"id":"blk-75646","spans":[{"id":"spn-138424","marks":["code"],"text":"half_life_hours"}]},{"id":"blk-75647","spans":[{"id":"spn-138425","text":"number"}]},{"id":"blk-75648","spans":[{"id":"spn-138426","text":"168.0"}]},{"id":"blk-75649","spans":[{"id":"spn-138427","text":"Recency decay half-life (lower = prefer recent edges)"}]}],[{"id":"blk-75650","spans":[{"id":"spn-138428","marks":["code"],"text":"bidirectional"}]},{"id":"blk-75651","spans":[{"id":"spn-138429","text":"boolean"}]},{"id":"blk-75652","spans":[{"id":"spn-138430","text":"true"}]},{"id":"blk-75653","spans":[{"id":"spn-138431","text":"Search edges in both directions"}]}],[{"id":"blk-75654","spans":[{"id":"spn-138432","marks":["code"],"text":"max_hops"}]},{"id":"blk-75655","spans":[{"id":"spn-138433","text":"number"}]},{"id":"blk-75656","spans":[{"id":"spn-138434","text":"10"}]},{"id":"blk-75657","spans":[{"id":"spn-138435","text":"BFS expansion limit for subgraph construction"}]}]]},{"id":"blk-75658","kind":"heading","level":2,"spans":[{"id":"spn-138436","text":"Cost Function"}]},{"id":"blk-75659","kind":"paragraph","spans":[{"id":"spn-138437","text":"Each edge's cost is computed as:"}]},{"id":"blk-75660","kind":"code","language":"text","text":"cost = -log(confidence) + recency_decay(age_hours / half_life) + type_cost(edge_type)"},{"id":"blk-75661","kind":"paragraph","spans":[{"id":"spn-138438","marks":["bold"],"text":"Type costs:"}]},{"head":[{"id":"blk-75663","spans":[{"id":"spn-138439","text":"Edge Type"}]},{"id":"blk-75664","spans":[{"id":"spn-138440","text":"Cost"}]},{"id":"blk-75665","spans":[{"id":"spn-138441","text":"Rationale"}]}],"id":"blk-75662","kind":"table","rows":[[{"id":"blk-75666","spans":[{"id":"spn-138442","marks":["code"],"text":"causal"}]},{"id":"blk-75667","spans":[{"id":"spn-138443","text":"0.0"}]},{"id":"blk-75668","spans":[{"id":"spn-138444","text":"Direct causation is free — strongest evidence"}]}],[{"id":"blk-75669","spans":[{"id":"spn-138445","marks":["code"],"text":"supports"}]},{"id":"blk-75670","spans":[{"id":"spn-138446","text":"0.1"}]},{"id":"blk-75671","spans":[{"id":"spn-138447","text":"Supporting evidence is cheap"}]}],[{"id":"blk-75672","spans":[{"id":"spn-138448","marks":["code"],"text":"related_to"}]},{"id":"blk-75673","spans":[{"id":"spn-138449","text":"0.5"}]},{"id":"blk-75674","spans":[{"id":"spn-138450","text":"Association — weaker link"}]}],[{"id":"blk-75675","spans":[{"id":"spn-138451","marks":["code"],"text":"contradicts"}]},{"id":"blk-75676","spans":[{"id":"spn-138452","text":"2.0"}]},{"id":"blk-75677","spans":[{"id":"spn-138453","text":"Penalty for contradictory edges"}]}],[{"id":"blk-75678","spans":[{"id":"spn-138454","text":"other"}]},{"id":"blk-75679","spans":[{"id":"spn-138455","text":"1.0"}]},{"id":"blk-75680","spans":[{"id":"spn-138456","text":"Default penalty"}]}]]},{"id":"blk-75681","kind":"paragraph","spans":[{"id":"spn-138457","marks":["bold"],"text":"Implications:"}]},{"id":"blk-75682","items":[{"blocks":[{"id":"blk-75684","kind":"paragraph","spans":[{"id":"spn-138458","text":"High-confidence causal edges are nearly free to traverse."}]}],"id":"blk-75683","kind":"list-item"},{"blocks":[{"id":"blk-75686","kind":"paragraph","spans":[{"id":"spn-138459","text":"Old edges are more expensive (recency decay)."}]}],"id":"blk-75685","kind":"list-item"},{"blocks":[{"id":"blk-75688","kind":"paragraph","spans":[{"id":"spn-138460","text":"Contradictory paths are strongly penalized — if the shortest path traverses a "},{"id":"spn-138461","marks":["code"],"text":"contradicts"},{"id":"spn-138462","text":" edge, something may be wrong."}]}],"id":"blk-75687","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75689","kind":"heading","level":2,"spans":[{"id":"spn-138463","text":"Response Fields"}]},{"id":"blk-75690","kind":"code","language":"json","text":"{\n  \"paths\": [\n    {\n      \"path\": [\"node_abc\", \"node_def\", \"node_ghi\"],\n      \"total_cost\": 0.423,\n      \"edges\": [\n        {\"from\": \"node_abc\", \"to\": \"node_def\", \"cost\": 0.105, \"edge_type\": \"causal\", \"confidence\": 0.9},\n        {\"from\": \"node_def\", \"to\": \"node_ghi\", \"cost\": 0.318, \"edge_type\": \"supports\", \"confidence\": 0.7}\n      ]\n    }\n  ],\n  \"subgraph_size\": {\"nodes\": 15, \"edges\": 23}\n}"},{"id":"blk-75691","kind":"heading","level":2,"spans":[{"id":"spn-138464","text":"Full Workflow"}]},{"id":"blk-75692","items":[{"blocks":[{"id":"blk-75694","kind":"paragraph","spans":[{"id":"spn-138465","marks":["bold"],"text":"Identify endpoints"},{"id":"spn-138466","text":" — use "},{"id":"spn-138467","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-138468","text":" or "},{"id":"spn-138469","marks":["code"],"text":"consolidate(action: \"query\", ...)"},{"id":"spn-138470","text":" to find the two nodes you want to connect."}]}],"id":"blk-75693","kind":"list-item"},{"blocks":[{"id":"blk-75696","kind":"paragraph","spans":[{"id":"spn-138471","marks":["bold"],"text":"Trace path"},{"id":"spn-138472","text":" — "},{"id":"spn-138473","marks":["code"],"text":"retrieve(action: \"trace_evidence\", source_id: \"<id_a>\", target_id: \"<id_b>\", k: 3)"}]}],"id":"blk-75695","kind":"list-item"},{"blocks":[{"id":"blk-75698","kind":"paragraph","spans":[{"id":"spn-138474","marks":["bold"],"text":"Interpret costs"},{"id":"spn-138475","text":" — low total cost = strong evidence chain. Check for "},{"id":"spn-138476","marks":["code"],"text":"contradicts"},{"id":"spn-138477","text":" edges in any path."}]}],"id":"blk-75697","kind":"list-item"},{"blocks":[{"id":"blk-75700","kind":"paragraph","spans":[{"id":"spn-138478","marks":["bold"],"text":"Report to user"},{"id":"spn-138479","text":" — summarize the chain in natural language."}]}],"id":"blk-75699","kind":"list-item"},{"blocks":[{"id":"blk-75702","kind":"paragraph","spans":[{"id":"spn-138480","marks":["bold"],"text":"Store episodic"},{"id":"spn-138481","text":" — if the trace revealed something important, store it as an episodic node."}]}],"id":"blk-75701","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75703","kind":"heading","level":2,"spans":[{"id":"spn-138482","text":"Combining with Other Machines"}]},{"head":[{"id":"blk-75705","spans":[{"id":"spn-138483","text":"Scenario"}]},{"id":"blk-75706","spans":[{"id":"spn-138484","text":"Workflow"}]}],"id":"blk-75704","kind":"table","rows":[[{"id":"blk-75707","spans":[{"id":"spn-138485","text":"Verify deliberation output"}]},{"id":"blk-75708","spans":[{"id":"spn-138486","marks":["code"],"text":"route(action: \"deliberate\")"},{"id":"spn-138487","text":" -> "},{"id":"spn-138488","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-138489","text":" from source to conclusion"}]}],[{"id":"blk-75709","spans":[{"id":"spn-138490","text":"Audit before high-stakes action"}]},{"id":"blk-75710","spans":[{"id":"spn-138491","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-138492","text":" -> identify causal chain -> "},{"id":"spn-138493","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-138494","text":" to verify"}]}],[{"id":"blk-75711","spans":[{"id":"spn-138495","text":"Investigate contradiction"}]},{"id":"blk-75712","spans":[{"id":"spn-138496","marks":["code"],"text":"learn(action: \"contradictions\")"},{"id":"spn-138497","text":" -> find conflicting nodes -> "},{"id":"spn-138498","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-138499","text":" between them"}]}],[{"id":"blk-75713","spans":[{"id":"spn-138500","text":"Topology + path"}]},{"id":"blk-75714","spans":[{"id":"spn-138501","marks":["code"],"text":"route(action: \"topology\")"},{"id":"spn-138502","text":" -> identify SCC members -> "},{"id":"spn-138503","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-138504","text":" within the cycle"}]}],[{"id":"blk-75715","spans":[{"id":"spn-138505","text":"Goal provenance"}]},{"id":"blk-75716","spans":[{"id":"spn-138506","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-138507","text":" -> get linked nodes -> "},{"id":"spn-138508","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-138509","text":" from evidence to goal"}]}]]},{"id":"blk-75717","kind":"heading","level":2,"spans":[{"id":"spn-138510","text":"Tuning Tips"}]},{"id":"blk-75718","items":[{"blocks":[{"id":"blk-75720","kind":"paragraph","spans":[{"id":"spn-138511","marks":["bold"],"text":"Lower `half_life_hours`"},{"id":"spn-138512","text":" (e.g., 24) to strongly prefer recent evidence chains."}]}],"id":"blk-75719","kind":"list-item"},{"blocks":[{"id":"blk-75722","kind":"paragraph","spans":[{"id":"spn-138513","marks":["bold"],"text":"Set `bidirectional: false`"},{"id":"spn-138514","text":" to enforce strict causal direction."}]}],"id":"blk-75721","kind":"list-item"},{"blocks":[{"id":"blk-75724","kind":"paragraph","spans":[{"id":"spn-138515","marks":["bold"],"text":"Increase `k`"},{"id":"spn-138516","text":" to find diverse paths — if path 1 goes through node X but path 2 doesn't, node X is not the only link."}]}],"id":"blk-75723","kind":"list-item"},{"blocks":[{"id":"blk-75726","kind":"paragraph","spans":[{"id":"spn-138517","marks":["bold"],"text":"Increase `max_hops`"},{"id":"spn-138518","text":" for large graphs where the two nodes are far apart."}]}],"id":"blk-75725","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieradbznbtptz45phx5sryz56cljwfiu35h3l7ibgfa4jsxb5rn5qtja","vocabulary":"ampersand.docs.fs.v1"}