{"bendscript":"0.1","blocks":[{"id":"blk-69076","kind":"heading","level":1,"spans":[{"id":"spn-101637","text":"Evidence Path Tracing"}]},{"id":"blk-69077","kind":"paragraph","spans":[{"id":"spn-101638","text":"Find the lowest-cost evidence path between two knowledge nodes using weighted Dijkstra with optional K-shortest alternate paths via Yen's algorithm."}]},{"id":"blk-69078","kind":"heading","level":2,"spans":[{"id":"spn-101639","text":"Arguments"}]},{"id":"blk-69079","kind":"paragraph","spans":[{"id":"spn-101640","text":"From/to node IDs and options: $ARGUMENTS"}]},{"id":"blk-69080","kind":"heading","level":2,"spans":[{"id":"spn-101641","text":"When to Use"}]},{"id":"blk-69081","items":[{"blocks":[{"id":"blk-69083","kind":"paragraph","spans":[{"id":"spn-101642","marks":["bold"],"text":"Explainability"},{"id":"spn-101643","text":" — \"Why did you conclude X from Y?\" Trace the causal chain."}]}],"id":"blk-69082","kind":"list-item"},{"blocks":[{"id":"blk-69085","kind":"paragraph","spans":[{"id":"spn-101644","marks":["bold"],"text":"Provenance audit"},{"id":"spn-101645","text":" — Verify that a conclusion has a legitimate evidence path."}]}],"id":"blk-69084","kind":"list-item"},{"blocks":[{"id":"blk-69087","kind":"paragraph","spans":[{"id":"spn-101646","marks":["bold"],"text":"Decision support"},{"id":"spn-101647","text":" — Before high-stakes actions, show the reasoning chain."}]}],"id":"blk-69086","kind":"list-item"},{"blocks":[{"id":"blk-69089","kind":"paragraph","spans":[{"id":"spn-101648","marks":["bold"],"text":"Contradiction investigation"},{"id":"spn-101649","text":" — When two nodes seem related but the connection is unclear."}]}],"id":"blk-69088","kind":"list-item"},{"blocks":[{"id":"blk-69091","kind":"paragraph","spans":[{"id":"spn-101650","marks":["bold"],"text":"After deliberation"},{"id":"spn-101651","text":" — Verify that crystallized conclusions connect back to source evidence."}]}],"id":"blk-69090","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69092","kind":"heading","level":2,"spans":[{"id":"spn-101652","text":"Basic Usage"}]},{"id":"blk-69093","kind":"heading","level":3,"spans":[{"id":"spn-101653","text":"Trace shortest evidence path"}]},{"id":"blk-69094","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\")"},{"id":"blk-69095","kind":"paragraph","spans":[{"id":"spn-101654","text":"Returns the single lowest-cost path with per-edge cost breakdown."}]},{"id":"blk-69096","kind":"heading","level":3,"spans":[{"id":"spn-101655","text":"Find K alternate paths"}]},{"id":"blk-69097","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\", k: 3)"},{"id":"blk-69098","kind":"paragraph","spans":[{"id":"spn-101656","text":"Returns up to K paths ranked by total cost, using Yen's algorithm. Useful for finding diverse reasoning chains."}]},{"id":"blk-69099","kind":"heading","level":2,"spans":[{"id":"spn-101657","text":"Parameters"}]},{"head":[{"id":"blk-69101","spans":[{"id":"spn-101658","text":"Parameter"}]},{"id":"blk-69102","spans":[{"id":"spn-101659","text":"Type"}]},{"id":"blk-69103","spans":[{"id":"spn-101660","text":"Default"}]},{"id":"blk-69104","spans":[{"id":"spn-101661","text":"Description"}]}],"id":"blk-69100","kind":"table","rows":[[{"id":"blk-69105","spans":[{"id":"spn-101662","marks":["code"],"text":"source_id"}]},{"id":"blk-69106","spans":[{"id":"spn-101663","text":"string"}]},{"id":"blk-69107","spans":[{"id":"spn-101664","text":"_(required)_"}]},{"id":"blk-69108","spans":[{"id":"spn-101665","text":"Source node ID"}]}],[{"id":"blk-69109","spans":[{"id":"spn-101666","marks":["code"],"text":"target_id"}]},{"id":"blk-69110","spans":[{"id":"spn-101667","text":"string"}]},{"id":"blk-69111","spans":[{"id":"spn-101668","text":"_(required)_"}]},{"id":"blk-69112","spans":[{"id":"spn-101669","text":"Target node ID"}]}],[{"id":"blk-69113","spans":[{"id":"spn-101670","marks":["code"],"text":"k"}]},{"id":"blk-69114","spans":[{"id":"spn-101671","text":"number"}]},{"id":"blk-69115","spans":[{"id":"spn-101672","text":"1"}]},{"id":"blk-69116","spans":[{"id":"spn-101673","text":"Number of alternate paths (max 10)"}]}],[{"id":"blk-69117","spans":[{"id":"spn-101674","marks":["code"],"text":"half_life_hours"}]},{"id":"blk-69118","spans":[{"id":"spn-101675","text":"number"}]},{"id":"blk-69119","spans":[{"id":"spn-101676","text":"168.0"}]},{"id":"blk-69120","spans":[{"id":"spn-101677","text":"Recency decay half-life (lower = prefer recent edges)"}]}],[{"id":"blk-69121","spans":[{"id":"spn-101678","marks":["code"],"text":"bidirectional"}]},{"id":"blk-69122","spans":[{"id":"spn-101679","text":"boolean"}]},{"id":"blk-69123","spans":[{"id":"spn-101680","text":"true"}]},{"id":"blk-69124","spans":[{"id":"spn-101681","text":"Search edges in both directions"}]}],[{"id":"blk-69125","spans":[{"id":"spn-101682","marks":["code"],"text":"max_hops"}]},{"id":"blk-69126","spans":[{"id":"spn-101683","text":"number"}]},{"id":"blk-69127","spans":[{"id":"spn-101684","text":"10"}]},{"id":"blk-69128","spans":[{"id":"spn-101685","text":"BFS expansion limit for subgraph construction"}]}]]},{"id":"blk-69129","kind":"heading","level":2,"spans":[{"id":"spn-101686","text":"Cost Function"}]},{"id":"blk-69130","kind":"paragraph","spans":[{"id":"spn-101687","text":"Each edge's cost is computed as:"}]},{"id":"blk-69131","kind":"code","language":"text","text":"cost = -log(confidence) + recency_decay(age_hours / half_life) + type_cost(edge_type)"},{"id":"blk-69132","kind":"paragraph","spans":[{"id":"spn-101688","marks":["bold"],"text":"Type costs:"}]},{"head":[{"id":"blk-69134","spans":[{"id":"spn-101689","text":"Edge Type"}]},{"id":"blk-69135","spans":[{"id":"spn-101690","text":"Cost"}]},{"id":"blk-69136","spans":[{"id":"spn-101691","text":"Rationale"}]}],"id":"blk-69133","kind":"table","rows":[[{"id":"blk-69137","spans":[{"id":"spn-101692","marks":["code"],"text":"causal"}]},{"id":"blk-69138","spans":[{"id":"spn-101693","text":"0.0"}]},{"id":"blk-69139","spans":[{"id":"spn-101694","text":"Direct causation is free — strongest evidence"}]}],[{"id":"blk-69140","spans":[{"id":"spn-101695","marks":["code"],"text":"supports"}]},{"id":"blk-69141","spans":[{"id":"spn-101696","text":"0.1"}]},{"id":"blk-69142","spans":[{"id":"spn-101697","text":"Supporting evidence is cheap"}]}],[{"id":"blk-69143","spans":[{"id":"spn-101698","marks":["code"],"text":"related_to"}]},{"id":"blk-69144","spans":[{"id":"spn-101699","text":"0.5"}]},{"id":"blk-69145","spans":[{"id":"spn-101700","text":"Association — weaker link"}]}],[{"id":"blk-69146","spans":[{"id":"spn-101701","marks":["code"],"text":"contradicts"}]},{"id":"blk-69147","spans":[{"id":"spn-101702","text":"2.0"}]},{"id":"blk-69148","spans":[{"id":"spn-101703","text":"Penalty for contradictory edges"}]}],[{"id":"blk-69149","spans":[{"id":"spn-101704","text":"other"}]},{"id":"blk-69150","spans":[{"id":"spn-101705","text":"1.0"}]},{"id":"blk-69151","spans":[{"id":"spn-101706","text":"Default penalty"}]}]]},{"id":"blk-69152","kind":"paragraph","spans":[{"id":"spn-101707","marks":["bold"],"text":"Implications:"}]},{"id":"blk-69153","items":[{"blocks":[{"id":"blk-69155","kind":"paragraph","spans":[{"id":"spn-101708","text":"High-confidence causal edges are nearly free to traverse."}]}],"id":"blk-69154","kind":"list-item"},{"blocks":[{"id":"blk-69157","kind":"paragraph","spans":[{"id":"spn-101709","text":"Old edges are more expensive (recency decay)."}]}],"id":"blk-69156","kind":"list-item"},{"blocks":[{"id":"blk-69159","kind":"paragraph","spans":[{"id":"spn-101710","text":"Contradictory paths are strongly penalized — if the shortest path traverses a "},{"id":"spn-101711","marks":["code"],"text":"contradicts"},{"id":"spn-101712","text":" edge, something may be wrong."}]}],"id":"blk-69158","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69160","kind":"heading","level":2,"spans":[{"id":"spn-101713","text":"Response Fields"}]},{"id":"blk-69161","kind":"code","language":"json","text":"{\n  \"paths\": [\n    {\n      \"path\": [\"node_abc\", \"node_def\", \"node_ghi\"],\n      \"total_cost\": 0.423,\n      \"edges\": [\n        {\"from\": \"node_abc\", \"to\": \"node_def\", \"cost\": 0.105, \"edge_type\": \"causal\", \"confidence\": 0.9},\n        {\"from\": \"node_def\", \"to\": \"node_ghi\", \"cost\": 0.318, \"edge_type\": \"supports\", \"confidence\": 0.7}\n      ]\n    }\n  ],\n  \"subgraph_size\": {\"nodes\": 15, \"edges\": 23}\n}"},{"id":"blk-69162","kind":"heading","level":2,"spans":[{"id":"spn-101714","text":"Full Workflow"}]},{"id":"blk-69163","items":[{"blocks":[{"id":"blk-69165","kind":"paragraph","spans":[{"id":"spn-101715","marks":["bold"],"text":"Identify endpoints"},{"id":"spn-101716","text":" — use "},{"id":"spn-101717","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-101718","text":" or "},{"id":"spn-101719","marks":["code"],"text":"consolidate(action: \"query\", ...)"},{"id":"spn-101720","text":" to find the two nodes you want to connect."}]}],"id":"blk-69164","kind":"list-item"},{"blocks":[{"id":"blk-69167","kind":"paragraph","spans":[{"id":"spn-101721","marks":["bold"],"text":"Trace path"},{"id":"spn-101722","text":" — "},{"id":"spn-101723","marks":["code"],"text":"retrieve(action: \"trace_evidence\", source_id: \"<id_a>\", target_id: \"<id_b>\", k: 3)"}]}],"id":"blk-69166","kind":"list-item"},{"blocks":[{"id":"blk-69169","kind":"paragraph","spans":[{"id":"spn-101724","marks":["bold"],"text":"Interpret costs"},{"id":"spn-101725","text":" — low total cost = strong evidence chain. Check for "},{"id":"spn-101726","marks":["code"],"text":"contradicts"},{"id":"spn-101727","text":" edges in any path."}]}],"id":"blk-69168","kind":"list-item"},{"blocks":[{"id":"blk-69171","kind":"paragraph","spans":[{"id":"spn-101728","marks":["bold"],"text":"Report to user"},{"id":"spn-101729","text":" — summarize the chain in natural language."}]}],"id":"blk-69170","kind":"list-item"},{"blocks":[{"id":"blk-69173","kind":"paragraph","spans":[{"id":"spn-101730","marks":["bold"],"text":"Store episodic"},{"id":"spn-101731","text":" — if the trace revealed something important, store it as an episodic node."}]}],"id":"blk-69172","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-69174","kind":"heading","level":2,"spans":[{"id":"spn-101732","text":"Combining with Other Machines"}]},{"head":[{"id":"blk-69176","spans":[{"id":"spn-101733","text":"Scenario"}]},{"id":"blk-69177","spans":[{"id":"spn-101734","text":"Workflow"}]}],"id":"blk-69175","kind":"table","rows":[[{"id":"blk-69178","spans":[{"id":"spn-101735","text":"Verify deliberation output"}]},{"id":"blk-69179","spans":[{"id":"spn-101736","marks":["code"],"text":"route(action: \"deliberate\")"},{"id":"spn-101737","text":" -> "},{"id":"spn-101738","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-101739","text":" from source to conclusion"}]}],[{"id":"blk-69180","spans":[{"id":"spn-101740","text":"Audit before high-stakes action"}]},{"id":"blk-69181","spans":[{"id":"spn-101741","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-101742","text":" -> identify causal chain -> "},{"id":"spn-101743","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-101744","text":" to verify"}]}],[{"id":"blk-69182","spans":[{"id":"spn-101745","text":"Investigate contradiction"}]},{"id":"blk-69183","spans":[{"id":"spn-101746","marks":["code"],"text":"learn(action: \"contradictions\")"},{"id":"spn-101747","text":" -> find conflicting nodes -> "},{"id":"spn-101748","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-101749","text":" between them"}]}],[{"id":"blk-69184","spans":[{"id":"spn-101750","text":"Topology + path"}]},{"id":"blk-69185","spans":[{"id":"spn-101751","marks":["code"],"text":"route(action: \"topology\")"},{"id":"spn-101752","text":" -> identify SCC members -> "},{"id":"spn-101753","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-101754","text":" within the cycle"}]}],[{"id":"blk-69186","spans":[{"id":"spn-101755","text":"Goal provenance"}]},{"id":"blk-69187","spans":[{"id":"spn-101756","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-101757","text":" -> get linked nodes -> "},{"id":"spn-101758","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-101759","text":" from evidence to goal"}]}]]},{"id":"blk-69188","kind":"heading","level":2,"spans":[{"id":"spn-101760","text":"Tuning Tips"}]},{"id":"blk-69189","items":[{"blocks":[{"id":"blk-69191","kind":"paragraph","spans":[{"id":"spn-101761","marks":["bold"],"text":"Lower `half_life_hours`"},{"id":"spn-101762","text":" (e.g., 24) to strongly prefer recent evidence chains."}]}],"id":"blk-69190","kind":"list-item"},{"blocks":[{"id":"blk-69193","kind":"paragraph","spans":[{"id":"spn-101763","marks":["bold"],"text":"Set `bidirectional: false`"},{"id":"spn-101764","text":" to enforce strict causal direction."}]}],"id":"blk-69192","kind":"list-item"},{"blocks":[{"id":"blk-69195","kind":"paragraph","spans":[{"id":"spn-101765","marks":["bold"],"text":"Increase `k`"},{"id":"spn-101766","text":" to find diverse paths — if path 1 goes through node X but path 2 doesn't, node X is not the only link."}]}],"id":"blk-69194","kind":"list-item"},{"blocks":[{"id":"blk-69197","kind":"paragraph","spans":[{"id":"spn-101767","marks":["bold"],"text":"Increase `max_hops`"},{"id":"spn-101768","text":" for large graphs where the two nodes are far apart."}]}],"id":"blk-69196","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7jvpsbth3y5v6y5pgsvgal6b6s4jnlcnwujnezprhbgavma5lehq","vocabulary":"ampersand.docs.fs.v1"}