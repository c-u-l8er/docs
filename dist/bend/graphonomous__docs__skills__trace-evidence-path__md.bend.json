{"bendscript":"0.1","blocks":[{"id":"blk-68248","kind":"heading","level":1,"spans":[{"id":"spn-99024","text":"Evidence Path Tracing"}]},{"id":"blk-68249","kind":"paragraph","spans":[{"id":"spn-99025","text":"Find the lowest-cost evidence path between two knowledge nodes using weighted Dijkstra with optional K-shortest alternate paths via Yen's algorithm."}]},{"id":"blk-68250","kind":"heading","level":2,"spans":[{"id":"spn-99026","text":"Arguments"}]},{"id":"blk-68251","kind":"paragraph","spans":[{"id":"spn-99027","text":"From/to node IDs and options: $ARGUMENTS"}]},{"id":"blk-68252","kind":"heading","level":2,"spans":[{"id":"spn-99028","text":"When to Use"}]},{"id":"blk-68253","items":[{"blocks":[{"id":"blk-68255","kind":"paragraph","spans":[{"id":"spn-99029","marks":["bold"],"text":"Explainability"},{"id":"spn-99030","text":" — \"Why did you conclude X from Y?\" Trace the causal chain."}]}],"id":"blk-68254","kind":"list-item"},{"blocks":[{"id":"blk-68257","kind":"paragraph","spans":[{"id":"spn-99031","marks":["bold"],"text":"Provenance audit"},{"id":"spn-99032","text":" — Verify that a conclusion has a legitimate evidence path."}]}],"id":"blk-68256","kind":"list-item"},{"blocks":[{"id":"blk-68259","kind":"paragraph","spans":[{"id":"spn-99033","marks":["bold"],"text":"Decision support"},{"id":"spn-99034","text":" — Before high-stakes actions, show the reasoning chain."}]}],"id":"blk-68258","kind":"list-item"},{"blocks":[{"id":"blk-68261","kind":"paragraph","spans":[{"id":"spn-99035","marks":["bold"],"text":"Contradiction investigation"},{"id":"spn-99036","text":" — When two nodes seem related but the connection is unclear."}]}],"id":"blk-68260","kind":"list-item"},{"blocks":[{"id":"blk-68263","kind":"paragraph","spans":[{"id":"spn-99037","marks":["bold"],"text":"After deliberation"},{"id":"spn-99038","text":" — Verify that crystallized conclusions connect back to source evidence."}]}],"id":"blk-68262","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68264","kind":"heading","level":2,"spans":[{"id":"spn-99039","text":"Basic Usage"}]},{"id":"blk-68265","kind":"heading","level":3,"spans":[{"id":"spn-99040","text":"Trace shortest evidence path"}]},{"id":"blk-68266","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\")"},{"id":"blk-68267","kind":"paragraph","spans":[{"id":"spn-99041","text":"Returns the single lowest-cost path with per-edge cost breakdown."}]},{"id":"blk-68268","kind":"heading","level":3,"spans":[{"id":"spn-99042","text":"Find K alternate paths"}]},{"id":"blk-68269","kind":"code","language":"text","text":"retrieve(action: \"trace_evidence\", source_id: \"<source_node_id>\", target_id: \"<target_node_id>\", k: 3)"},{"id":"blk-68270","kind":"paragraph","spans":[{"id":"spn-99043","text":"Returns up to K paths ranked by total cost, using Yen's algorithm. Useful for finding diverse reasoning chains."}]},{"id":"blk-68271","kind":"heading","level":2,"spans":[{"id":"spn-99044","text":"Parameters"}]},{"head":[{"id":"blk-68273","spans":[{"id":"spn-99045","text":"Parameter"}]},{"id":"blk-68274","spans":[{"id":"spn-99046","text":"Type"}]},{"id":"blk-68275","spans":[{"id":"spn-99047","text":"Default"}]},{"id":"blk-68276","spans":[{"id":"spn-99048","text":"Description"}]}],"id":"blk-68272","kind":"table","rows":[[{"id":"blk-68277","spans":[{"id":"spn-99049","marks":["code"],"text":"source_id"}]},{"id":"blk-68278","spans":[{"id":"spn-99050","text":"string"}]},{"id":"blk-68279","spans":[{"id":"spn-99051","text":"_(required)_"}]},{"id":"blk-68280","spans":[{"id":"spn-99052","text":"Source node ID"}]}],[{"id":"blk-68281","spans":[{"id":"spn-99053","marks":["code"],"text":"target_id"}]},{"id":"blk-68282","spans":[{"id":"spn-99054","text":"string"}]},{"id":"blk-68283","spans":[{"id":"spn-99055","text":"_(required)_"}]},{"id":"blk-68284","spans":[{"id":"spn-99056","text":"Target node ID"}]}],[{"id":"blk-68285","spans":[{"id":"spn-99057","marks":["code"],"text":"k"}]},{"id":"blk-68286","spans":[{"id":"spn-99058","text":"number"}]},{"id":"blk-68287","spans":[{"id":"spn-99059","text":"1"}]},{"id":"blk-68288","spans":[{"id":"spn-99060","text":"Number of alternate paths (max 10)"}]}],[{"id":"blk-68289","spans":[{"id":"spn-99061","marks":["code"],"text":"half_life_hours"}]},{"id":"blk-68290","spans":[{"id":"spn-99062","text":"number"}]},{"id":"blk-68291","spans":[{"id":"spn-99063","text":"168.0"}]},{"id":"blk-68292","spans":[{"id":"spn-99064","text":"Recency decay half-life (lower = prefer recent edges)"}]}],[{"id":"blk-68293","spans":[{"id":"spn-99065","marks":["code"],"text":"bidirectional"}]},{"id":"blk-68294","spans":[{"id":"spn-99066","text":"boolean"}]},{"id":"blk-68295","spans":[{"id":"spn-99067","text":"true"}]},{"id":"blk-68296","spans":[{"id":"spn-99068","text":"Search edges in both directions"}]}],[{"id":"blk-68297","spans":[{"id":"spn-99069","marks":["code"],"text":"max_hops"}]},{"id":"blk-68298","spans":[{"id":"spn-99070","text":"number"}]},{"id":"blk-68299","spans":[{"id":"spn-99071","text":"10"}]},{"id":"blk-68300","spans":[{"id":"spn-99072","text":"BFS expansion limit for subgraph construction"}]}]]},{"id":"blk-68301","kind":"heading","level":2,"spans":[{"id":"spn-99073","text":"Cost Function"}]},{"id":"blk-68302","kind":"paragraph","spans":[{"id":"spn-99074","text":"Each edge's cost is computed as:"}]},{"id":"blk-68303","kind":"code","language":"text","text":"cost = -log(confidence) + recency_decay(age_hours / half_life) + type_cost(edge_type)"},{"id":"blk-68304","kind":"paragraph","spans":[{"id":"spn-99075","marks":["bold"],"text":"Type costs:"}]},{"head":[{"id":"blk-68306","spans":[{"id":"spn-99076","text":"Edge Type"}]},{"id":"blk-68307","spans":[{"id":"spn-99077","text":"Cost"}]},{"id":"blk-68308","spans":[{"id":"spn-99078","text":"Rationale"}]}],"id":"blk-68305","kind":"table","rows":[[{"id":"blk-68309","spans":[{"id":"spn-99079","marks":["code"],"text":"causal"}]},{"id":"blk-68310","spans":[{"id":"spn-99080","text":"0.0"}]},{"id":"blk-68311","spans":[{"id":"spn-99081","text":"Direct causation is free — strongest evidence"}]}],[{"id":"blk-68312","spans":[{"id":"spn-99082","marks":["code"],"text":"supports"}]},{"id":"blk-68313","spans":[{"id":"spn-99083","text":"0.1"}]},{"id":"blk-68314","spans":[{"id":"spn-99084","text":"Supporting evidence is cheap"}]}],[{"id":"blk-68315","spans":[{"id":"spn-99085","marks":["code"],"text":"related_to"}]},{"id":"blk-68316","spans":[{"id":"spn-99086","text":"0.5"}]},{"id":"blk-68317","spans":[{"id":"spn-99087","text":"Association — weaker link"}]}],[{"id":"blk-68318","spans":[{"id":"spn-99088","marks":["code"],"text":"contradicts"}]},{"id":"blk-68319","spans":[{"id":"spn-99089","text":"2.0"}]},{"id":"blk-68320","spans":[{"id":"spn-99090","text":"Penalty for contradictory edges"}]}],[{"id":"blk-68321","spans":[{"id":"spn-99091","text":"other"}]},{"id":"blk-68322","spans":[{"id":"spn-99092","text":"1.0"}]},{"id":"blk-68323","spans":[{"id":"spn-99093","text":"Default penalty"}]}]]},{"id":"blk-68324","kind":"paragraph","spans":[{"id":"spn-99094","marks":["bold"],"text":"Implications:"}]},{"id":"blk-68325","items":[{"blocks":[{"id":"blk-68327","kind":"paragraph","spans":[{"id":"spn-99095","text":"High-confidence causal edges are nearly free to traverse."}]}],"id":"blk-68326","kind":"list-item"},{"blocks":[{"id":"blk-68329","kind":"paragraph","spans":[{"id":"spn-99096","text":"Old edges are more expensive (recency decay)."}]}],"id":"blk-68328","kind":"list-item"},{"blocks":[{"id":"blk-68331","kind":"paragraph","spans":[{"id":"spn-99097","text":"Contradictory paths are strongly penalized — if the shortest path traverses a "},{"id":"spn-99098","marks":["code"],"text":"contradicts"},{"id":"spn-99099","text":" edge, something may be wrong."}]}],"id":"blk-68330","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68332","kind":"heading","level":2,"spans":[{"id":"spn-99100","text":"Response Fields"}]},{"id":"blk-68333","kind":"code","language":"json","text":"{\n  \"paths\": [\n    {\n      \"path\": [\"node_abc\", \"node_def\", \"node_ghi\"],\n      \"total_cost\": 0.423,\n      \"edges\": [\n        {\"from\": \"node_abc\", \"to\": \"node_def\", \"cost\": 0.105, \"edge_type\": \"causal\", \"confidence\": 0.9},\n        {\"from\": \"node_def\", \"to\": \"node_ghi\", \"cost\": 0.318, \"edge_type\": \"supports\", \"confidence\": 0.7}\n      ]\n    }\n  ],\n  \"subgraph_size\": {\"nodes\": 15, \"edges\": 23}\n}"},{"id":"blk-68334","kind":"heading","level":2,"spans":[{"id":"spn-99101","text":"Full Workflow"}]},{"id":"blk-68335","items":[{"blocks":[{"id":"blk-68337","kind":"paragraph","spans":[{"id":"spn-99102","marks":["bold"],"text":"Identify endpoints"},{"id":"spn-99103","text":" — use "},{"id":"spn-99104","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-99105","text":" or "},{"id":"spn-99106","marks":["code"],"text":"consolidate(action: \"query\", ...)"},{"id":"spn-99107","text":" to find the two nodes you want to connect."}]}],"id":"blk-68336","kind":"list-item"},{"blocks":[{"id":"blk-68339","kind":"paragraph","spans":[{"id":"spn-99108","marks":["bold"],"text":"Trace path"},{"id":"spn-99109","text":" — "},{"id":"spn-99110","marks":["code"],"text":"retrieve(action: \"trace_evidence\", source_id: \"<id_a>\", target_id: \"<id_b>\", k: 3)"}]}],"id":"blk-68338","kind":"list-item"},{"blocks":[{"id":"blk-68341","kind":"paragraph","spans":[{"id":"spn-99111","marks":["bold"],"text":"Interpret costs"},{"id":"spn-99112","text":" — low total cost = strong evidence chain. Check for "},{"id":"spn-99113","marks":["code"],"text":"contradicts"},{"id":"spn-99114","text":" edges in any path."}]}],"id":"blk-68340","kind":"list-item"},{"blocks":[{"id":"blk-68343","kind":"paragraph","spans":[{"id":"spn-99115","marks":["bold"],"text":"Report to user"},{"id":"spn-99116","text":" — summarize the chain in natural language."}]}],"id":"blk-68342","kind":"list-item"},{"blocks":[{"id":"blk-68345","kind":"paragraph","spans":[{"id":"spn-99117","marks":["bold"],"text":"Store episodic"},{"id":"spn-99118","text":" — if the trace revealed something important, store it as an episodic node."}]}],"id":"blk-68344","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68346","kind":"heading","level":2,"spans":[{"id":"spn-99119","text":"Combining with Other Machines"}]},{"head":[{"id":"blk-68348","spans":[{"id":"spn-99120","text":"Scenario"}]},{"id":"blk-68349","spans":[{"id":"spn-99121","text":"Workflow"}]}],"id":"blk-68347","kind":"table","rows":[[{"id":"blk-68350","spans":[{"id":"spn-99122","text":"Verify deliberation output"}]},{"id":"blk-68351","spans":[{"id":"spn-99123","marks":["code"],"text":"route(action: \"deliberate\")"},{"id":"spn-99124","text":" -> "},{"id":"spn-99125","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-99126","text":" from source to conclusion"}]}],[{"id":"blk-68352","spans":[{"id":"spn-99127","text":"Audit before high-stakes action"}]},{"id":"blk-68353","spans":[{"id":"spn-99128","marks":["code"],"text":"retrieve(action: \"context\")"},{"id":"spn-99129","text":" -> identify causal chain -> "},{"id":"spn-99130","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-99131","text":" to verify"}]}],[{"id":"blk-68354","spans":[{"id":"spn-99132","text":"Investigate contradiction"}]},{"id":"blk-68355","spans":[{"id":"spn-99133","marks":["code"],"text":"learn(action: \"contradictions\")"},{"id":"spn-99134","text":" -> find conflicting nodes -> "},{"id":"spn-99135","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-99136","text":" between them"}]}],[{"id":"blk-68356","spans":[{"id":"spn-99137","text":"Topology + path"}]},{"id":"blk-68357","spans":[{"id":"spn-99138","marks":["code"],"text":"route(action: \"topology\")"},{"id":"spn-99139","text":" -> identify SCC members -> "},{"id":"spn-99140","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-99141","text":" within the cycle"}]}],[{"id":"blk-68358","spans":[{"id":"spn-99142","text":"Goal provenance"}]},{"id":"blk-68359","spans":[{"id":"spn-99143","marks":["code"],"text":"route(action: \"review_goal\")"},{"id":"spn-99144","text":" -> get linked nodes -> "},{"id":"spn-99145","marks":["code"],"text":"retrieve(action: \"trace_evidence\")"},{"id":"spn-99146","text":" from evidence to goal"}]}]]},{"id":"blk-68360","kind":"heading","level":2,"spans":[{"id":"spn-99147","text":"Tuning Tips"}]},{"id":"blk-68361","items":[{"blocks":[{"id":"blk-68363","kind":"paragraph","spans":[{"id":"spn-99148","marks":["bold"],"text":"Lower `half_life_hours`"},{"id":"spn-99149","text":" (e.g., 24) to strongly prefer recent evidence chains."}]}],"id":"blk-68362","kind":"list-item"},{"blocks":[{"id":"blk-68365","kind":"paragraph","spans":[{"id":"spn-99150","marks":["bold"],"text":"Set `bidirectional: false`"},{"id":"spn-99151","text":" to enforce strict causal direction."}]}],"id":"blk-68364","kind":"list-item"},{"blocks":[{"id":"blk-68367","kind":"paragraph","spans":[{"id":"spn-99152","marks":["bold"],"text":"Increase `k`"},{"id":"spn-99153","text":" to find diverse paths — if path 1 goes through node X but path 2 doesn't, node X is not the only link."}]}],"id":"blk-68366","kind":"list-item"},{"blocks":[{"id":"blk-68369","kind":"paragraph","spans":[{"id":"spn-99154","marks":["bold"],"text":"Increase `max_hops`"},{"id":"spn-99155","text":" for large graphs where the two nodes are far apart."}]}],"id":"blk-68368","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieravppuwrftksiimzqdeq6aspyrwetv52nxhhy3mdxl2qlh26q4ceya","vocabulary":"ampersand.docs.fs.v1"}