{"bendscript":"0.1","blocks":[{"id":"blk-16244","kind":"heading","level":1,"spans":[{"id":"spn-14182","text":"Skill 01 — Writing Agent Declarations"}]},{"blocks":[{"id":"blk-16246","kind":"paragraph","spans":[{"id":"spn-14183","text":"How to write "},{"id":"spn-14184","marks":["code"],"text":"ampersand.json"},{"id":"spn-14185","text":" files that declare an agent's capabilities, governance, and provenance requirements."}]}],"id":"blk-16245","kind":"quote"},{"id":"blk-16247","kind":"heading","level":2,"spans":[{"id":"spn-14186","text":"Why This Matters"}]},{"id":"blk-16248","kind":"paragraph","spans":[{"id":"spn-14187","text":"The "},{"id":"spn-14188","marks":["code"],"text":"ampersand.json"},{"id":"spn-14189","text":" declaration is the source of truth for what an agent can do. Everything else — validation, composition, MCP/A2A generation — flows from this file. Get the declaration right and the rest follows."}]},{"id":"blk-16249","kind":"heading","level":2,"spans":[{"id":"spn-14190","text":"Basic Structure"}]},{"id":"blk-16250","kind":"paragraph","spans":[{"id":"spn-14191","text":"Every declaration has these top-level fields:"}]},{"id":"blk-16251","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"AgentName\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": { ... },\n  \"governance\": { ... },\n  \"provenance\": true\n}"},{"head":[{"id":"blk-16253","spans":[{"id":"spn-14192","text":"Field"}]},{"id":"blk-16254","spans":[{"id":"spn-14193","text":"Required"}]},{"id":"blk-16255","spans":[{"id":"spn-14194","text":"Description"}]}],"id":"blk-16252","kind":"table","rows":[[{"id":"blk-16256","spans":[{"id":"spn-14195","marks":["code"],"text":"$schema"}]},{"id":"blk-16257","spans":[{"id":"spn-14196","text":"Recommended"}]},{"id":"blk-16258","spans":[{"id":"spn-14197","text":"Points to the JSON Schema for validation"}]}],[{"id":"blk-16259","spans":[{"id":"spn-14198","marks":["code"],"text":"agent"}]},{"id":"blk-16260","spans":[{"id":"spn-14199","text":"Yes"}]},{"id":"blk-16261","spans":[{"id":"spn-14200","text":"Agent identifier (PascalCase by convention)"}]}],[{"id":"blk-16262","spans":[{"id":"spn-14201","marks":["code"],"text":"version"}]},{"id":"blk-16263","spans":[{"id":"spn-14202","text":"Yes"}]},{"id":"blk-16264","spans":[{"id":"spn-14203","text":"Semver version string"}]}],[{"id":"blk-16265","spans":[{"id":"spn-14204","marks":["code"],"text":"capabilities"}]},{"id":"blk-16266","spans":[{"id":"spn-14205","text":"Yes"}]},{"id":"blk-16267","spans":[{"id":"spn-14206","text":"Map of capability identifiers to provider configs"}]}],[{"id":"blk-16268","spans":[{"id":"spn-14207","marks":["code"],"text":"governance"}]},{"id":"blk-16269","spans":[{"id":"spn-14208","text":"No"}]},{"id":"blk-16270","spans":[{"id":"spn-14209","text":"Hard/soft constraints, escalation rules, autonomy"}]}],[{"id":"blk-16271","spans":[{"id":"spn-14210","marks":["code"],"text":"pipelines"}]},{"id":"blk-16272","spans":[{"id":"spn-14211","text":"No"}]},{"id":"blk-16273","spans":[{"id":"spn-14212","text":"Named data-flow pipelines through capabilities"}]}],[{"id":"blk-16274","spans":[{"id":"spn-14213","marks":["code"],"text":"provenance"}]},{"id":"blk-16275","spans":[{"id":"spn-14214","text":"No"}]},{"id":"blk-16276","spans":[{"id":"spn-14215","text":"Boolean — enable hash-linked provenance chain"}]}]]},{"id":"blk-16277","kind":"heading","level":2,"spans":[{"id":"spn-14216","text":"Capability Identifier Patterns"}]},{"id":"blk-16278","kind":"paragraph","spans":[{"id":"spn-14217","text":"Capabilities follow the pattern "},{"id":"spn-14218","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14219","text":":"}]},{"id":"blk-16279","kind":"code","language":"text","text":"&memory.graph        — graph-structured persistent memory\n&memory.vector       — vector similarity search\n&memory.episodic     — event-based recall\n&reason.argument     — structured argumentation\n&reason.deliberate   — topology-aware focused reasoning\n&reason.attend       — proactive attention engine\n&time.anomaly        — temporal anomaly detection\n&time.forecast       — time-series prediction\n&space.fleet         — fleet-wide spatial awareness\n&space.geofence      — geographic boundary management"},{"id":"blk-16280","kind":"paragraph","spans":[{"id":"spn-14220","text":"Custom subtypes are permitted if they satisfy the primitive's capability contract."}]},{"id":"blk-16281","kind":"heading","level":2,"spans":[{"id":"spn-14221","text":"Provider Binding"}]},{"id":"blk-16282","kind":"paragraph","spans":[{"id":"spn-14222","text":"Each capability declares a provider — the service that implements it:"}]},{"id":"blk-16283","kind":"paragraph","spans":[{"id":"spn-14223","marks":["bold"],"text":"Explicit provider:"}]},{"id":"blk-16284","kind":"code","language":"json","text":"\"&memory.graph\": {\n  \"provider\": \"graphonomous\",\n  \"config\": { \"instance\": \"infra-ops\" }\n}"},{"id":"blk-16285","kind":"paragraph","spans":[{"id":"spn-14224","marks":["bold"],"text":"Auto-resolved provider:"}]},{"id":"blk-16286","kind":"code","language":"json","text":"\"&memory.vector\": {\n  \"provider\": \"auto\",\n  \"config\": { \"index\": \"documents\" }\n}"},{"id":"blk-16287","kind":"paragraph","spans":[{"id":"spn-14225","text":"When "},{"id":"spn-14226","marks":["code"],"text":"provider"},{"id":"spn-14227","text":" is "},{"id":"spn-14228","marks":["code"],"text":"\"auto\""},{"id":"spn-14229","text":", the runtime resolves the provider from the capability registry at composition time."}]},{"id":"blk-16288","kind":"heading","level":2,"spans":[{"id":"spn-14230","text":"Config Objects"}]},{"id":"blk-16289","kind":"paragraph","spans":[{"id":"spn-14231","text":"The "},{"id":"spn-14232","marks":["code"],"text":"config"},{"id":"spn-14233","text":" object is provider-specific. It passes through to the provider at bind time. Common patterns:"}]},{"head":[{"id":"blk-16291","spans":[{"id":"spn-14234","text":"Provider"}]},{"id":"blk-16292","spans":[{"id":"spn-14235","text":"Typical Config"}]}],"id":"blk-16290","kind":"table","rows":[[{"id":"blk-16293","spans":[{"id":"spn-14236","marks":["code"],"text":"graphonomous"}]},{"id":"blk-16294","spans":[{"id":"spn-14237","marks":["code"],"text":"instance"},{"id":"spn-14238","text":", "},{"id":"spn-14239","marks":["code"],"text":"budget"}]}],[{"id":"blk-16295","spans":[{"id":"spn-14240","marks":["code"],"text":"ticktickclock"}]},{"id":"blk-16296","spans":[{"id":"spn-14241","marks":["code"],"text":"streams"},{"id":"spn-14242","text":", "},{"id":"spn-14243","marks":["code"],"text":"window_days"},{"id":"spn-14244","text":", "},{"id":"spn-14245","marks":["code"],"text":"granularity"}]}],[{"id":"blk-16297","spans":[{"id":"spn-14246","marks":["code"],"text":"geofleetic"}]},{"id":"blk-16298","spans":[{"id":"spn-14247","marks":["code"],"text":"regions"},{"id":"spn-14248","text":", "},{"id":"spn-14249","marks":["code"],"text":"precision"}]}],[{"id":"blk-16299","spans":[{"id":"spn-14250","marks":["code"],"text":"deliberatic"}]},{"id":"blk-16300","spans":[{"id":"spn-14251","marks":["code"],"text":"governance"},{"id":"spn-14252","text":", "},{"id":"spn-14253","marks":["code"],"text":"mode"}]}]]},{"id":"blk-16301","kind":"paragraph","spans":[{"id":"spn-14254","text":"The schema does not constrain "},{"id":"spn-14255","marks":["code"],"text":"config"},{"id":"spn-14256","text":" contents — that is the provider's responsibility via its capability contract."}]},{"id":"blk-16302","kind":"heading","level":2,"spans":[{"id":"spn-14257","text":"Working Examples"}]},{"id":"blk-16303","kind":"heading","level":3,"spans":[{"id":"spn-14258","text":"Minimal declaration (single capability)"}]},{"id":"blk-16304","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"SimpleMemoryAgent\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  }\n}"},{"id":"blk-16305","kind":"heading","level":3,"spans":[{"id":"spn-14259","text":"Research agent (three capabilities, governance)"}]},{"id":"blk-16306","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"ResearchAgent\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.vector\": {\n      \"provider\": \"pgvector\",\n      \"config\": { \"index\": \"papers\", \"namespace\": \"research-corpus\" }\n    },\n    \"&time.pattern\": {\n      \"provider\": \"ticktickclock\",\n      \"config\": { \"window_days\": 30, \"granularity\": \"daily\" }\n    },\n    \"&reason.argument\": {\n      \"provider\": \"deliberatic\",\n      \"config\": { \"governance\": \"evidence-first\" }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\"Never present unsupported conclusions as facts\"],\n    \"soft\": [\"Prefer recent peer-reviewed evidence\"],\n    \"escalate_when\": { \"confidence_below\": 0.65 }\n  },\n  \"provenance\": true\n}"},{"id":"blk-16307","kind":"heading","level":3,"spans":[{"id":"spn-14260","text":"Full infrastructure agent (six capabilities, pipelines, governance)"}]},{"id":"blk-16308","kind":"paragraph","spans":[{"id":"spn-14261","text":"See "},{"id":"spn-14262","marks":["code"],"text":"examples/infra-operator.ampersand.json"},{"id":"spn-14263","text":" for the complete InfraOperator declaration with "},{"id":"spn-14264","marks":["code"],"text":"&memory.graph"},{"id":"spn-14265","text":", "},{"id":"spn-14266","marks":["code"],"text":"&time.anomaly"},{"id":"spn-14267","text":", "},{"id":"spn-14268","marks":["code"],"text":"&space.fleet"},{"id":"spn-14269","text":", "},{"id":"spn-14270","marks":["code"],"text":"&reason.argument"},{"id":"spn-14271","text":", "},{"id":"spn-14272","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-14273","text":", "},{"id":"spn-14274","marks":["code"],"text":"&reason.attend"},{"id":"spn-14275","text":", plus a named "},{"id":"spn-14276","marks":["code"],"text":"incident_triage"},{"id":"spn-14277","text":" pipeline and full governance block."}]},{"id":"blk-16309","kind":"heading","level":2,"spans":[{"id":"spn-14278","text":"Governance Block"}]},{"id":"blk-16310","kind":"paragraph","spans":[{"id":"spn-14279","text":"The "},{"id":"spn-14280","marks":["code"],"text":"governance"},{"id":"spn-14281","text":" object declares constraints the agent must respect:"}]},{"id":"blk-16311","kind":"code","language":"json","text":"\"governance\": {\n  \"hard\": [\"Never scale beyond 3x in a single action\"],\n  \"soft\": [\"Prefer gradual scaling over spikes\"],\n  \"escalate_when\": {\n    \"confidence_below\": 0.7,\n    \"cost_exceeds_usd\": 1000\n  },\n  \"autonomy\": {\n    \"level\": \"advise\",\n    \"model_tier\": \"local_small\",\n    \"heartbeat_seconds\": 300,\n    \"budget\": {\n      \"max_actions_per_hour\": 5,\n      \"require_approval_for\": [\"act\", \"propose\"]\n    }\n  }\n}"},{"id":"blk-16312","kind":"paragraph","spans":[{"id":"spn-14282","text":"See "},{"id":"spn-14283","marks":["code"],"text":"09_GOVERNANCE_PROVENANCE.md"},{"id":"spn-14284","text":" for full governance documentation."}]},{"id":"blk-16313","kind":"heading","level":2,"spans":[{"id":"spn-14285","text":"Common Mistakes"}]},{"head":[{"id":"blk-16315","spans":[{"id":"spn-14286","text":"Mistake"}]},{"id":"blk-16316","spans":[{"id":"spn-14287","text":"Why It Fails"}]},{"id":"blk-16317","spans":[{"id":"spn-14288","text":"Fix"}]}],"id":"blk-16314","kind":"table","rows":[[{"id":"blk-16318","spans":[{"id":"spn-14289","text":"Missing "},{"id":"spn-14290","marks":["code"],"text":"agent"},{"id":"spn-14291","text":" field"}]},{"id":"blk-16319","spans":[{"id":"spn-14292","text":"Schema validation rejects it"}]},{"id":"blk-16320","spans":[{"id":"spn-14293","text":"Always include agent name"}]}],[{"id":"blk-16321","spans":[{"id":"spn-14294","text":"Using bare primitives ("},{"id":"spn-14295","marks":["code"],"text":"&memory"},{"id":"spn-14296","text":")"}]},{"id":"blk-16322","spans":[{"id":"spn-14297","text":"Subtypes are required in declarations"}]},{"id":"blk-16323","spans":[{"id":"spn-14298","text":"Use "},{"id":"spn-14299","marks":["code"],"text":"&memory.graph"},{"id":"spn-14300","text":", "},{"id":"spn-14301","marks":["code"],"text":"&memory.vector"},{"id":"spn-14302","text":", etc."}]}],[{"id":"blk-16324","spans":[{"id":"spn-14303","text":"Omitting "},{"id":"spn-14304","marks":["code"],"text":"provider"}]},{"id":"blk-16325","spans":[{"id":"spn-14305","text":"Runtime cannot bind the capability"}]},{"id":"blk-16326","spans":[{"id":"spn-14306","text":"Specify a provider or use "},{"id":"spn-14307","marks":["code"],"text":"\"auto\""}]}],[{"id":"blk-16327","spans":[{"id":"spn-14308","text":"Putting pipeline logic in capabilities"}]},{"id":"blk-16328","spans":[{"id":"spn-14309","text":"Capabilities declare what, not how"}]},{"id":"blk-16329","spans":[{"id":"spn-14310","text":"Use the "},{"id":"spn-14311","marks":["code"],"text":"pipelines"},{"id":"spn-14312","text":" block for data flow"}]}],[{"id":"blk-16330","spans":[{"id":"spn-14313","text":"Duplicating capability keys"}]},{"id":"blk-16331","spans":[{"id":"spn-14314","text":"JSON keys must be unique"}]},{"id":"blk-16332","spans":[{"id":"spn-14315","text":"Each "},{"id":"spn-14316","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14317","text":" appears once"}]}],[{"id":"blk-16333","spans":[{"id":"spn-14318","text":"Non-semver version strings"}]},{"id":"blk-16334","spans":[{"id":"spn-14319","text":"Schema requires semver"}]},{"id":"blk-16335","spans":[{"id":"spn-14320","text":"Use "},{"id":"spn-14321","marks":["code"],"text":"\"1.0.0\""},{"id":"spn-14322","text":", not "},{"id":"spn-14323","marks":["code"],"text":"\"v1\""},{"id":"spn-14324","text":" or "},{"id":"spn-14325","marks":["code"],"text":"\"latest\""}]}]]}],"edges":[],"id":"bagaaieratsdaap3g7nzhjlatmsoguztznuag5szfbiy5kze6c77uaut6gska","vocabulary":"ampersand.docs.fs.v1"}