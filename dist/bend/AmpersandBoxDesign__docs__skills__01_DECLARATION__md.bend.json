{"bendscript":"0.1","blocks":[{"id":"blk-14400","kind":"heading","level":1,"spans":[{"id":"spn-13029","text":"Skill 01 — Writing Agent Declarations"}]},{"blocks":[{"id":"blk-14402","kind":"paragraph","spans":[{"id":"spn-13030","text":"How to write "},{"id":"spn-13031","marks":["code"],"text":"ampersand.json"},{"id":"spn-13032","text":" files that declare an agent's capabilities, governance, and provenance requirements."}]}],"id":"blk-14401","kind":"quote"},{"id":"blk-14403","kind":"paragraph","spans":[{"id":"spn-13033","text":"---"}]},{"id":"blk-14404","kind":"heading","level":2,"spans":[{"id":"spn-13034","text":"Why This Matters"}]},{"id":"blk-14405","kind":"paragraph","spans":[{"id":"spn-13035","text":"The "},{"id":"spn-13036","marks":["code"],"text":"ampersand.json"},{"id":"spn-13037","text":" declaration is the source of truth for what an agent can do. Everything else — validation, composition, MCP/A2A generation — flows from this file. Get the declaration right and the rest follows."}]},{"id":"blk-14406","kind":"paragraph","spans":[{"id":"spn-13038","text":"---"}]},{"id":"blk-14407","kind":"heading","level":2,"spans":[{"id":"spn-13039","text":"Basic Structure"}]},{"id":"blk-14408","kind":"paragraph","spans":[{"id":"spn-13040","text":"Every declaration has these top-level fields:"}]},{"id":"blk-14409","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"AgentName\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": { ... },\n  \"governance\": { ... },\n  \"provenance\": true\n}"},{"head":[{"id":"blk-14411","spans":[{"id":"spn-13041","text":"Field"}]},{"id":"blk-14412","spans":[{"id":"spn-13042","text":"Required"}]},{"id":"blk-14413","spans":[{"id":"spn-13043","text":"Description"}]}],"id":"blk-14410","kind":"table","rows":[[{"id":"blk-14414","spans":[{"id":"spn-13044","marks":["code"],"text":"$schema"}]},{"id":"blk-14415","spans":[{"id":"spn-13045","text":"Recommended"}]},{"id":"blk-14416","spans":[{"id":"spn-13046","text":"Points to the JSON Schema for validation"}]}],[{"id":"blk-14417","spans":[{"id":"spn-13047","marks":["code"],"text":"agent"}]},{"id":"blk-14418","spans":[{"id":"spn-13048","text":"Yes"}]},{"id":"blk-14419","spans":[{"id":"spn-13049","text":"Agent identifier (PascalCase by convention)"}]}],[{"id":"blk-14420","spans":[{"id":"spn-13050","marks":["code"],"text":"version"}]},{"id":"blk-14421","spans":[{"id":"spn-13051","text":"Yes"}]},{"id":"blk-14422","spans":[{"id":"spn-13052","text":"Semver version string"}]}],[{"id":"blk-14423","spans":[{"id":"spn-13053","marks":["code"],"text":"capabilities"}]},{"id":"blk-14424","spans":[{"id":"spn-13054","text":"Yes"}]},{"id":"blk-14425","spans":[{"id":"spn-13055","text":"Map of capability identifiers to provider configs"}]}],[{"id":"blk-14426","spans":[{"id":"spn-13056","marks":["code"],"text":"governance"}]},{"id":"blk-14427","spans":[{"id":"spn-13057","text":"No"}]},{"id":"blk-14428","spans":[{"id":"spn-13058","text":"Hard/soft constraints, escalation rules, autonomy"}]}],[{"id":"blk-14429","spans":[{"id":"spn-13059","marks":["code"],"text":"pipelines"}]},{"id":"blk-14430","spans":[{"id":"spn-13060","text":"No"}]},{"id":"blk-14431","spans":[{"id":"spn-13061","text":"Named data-flow pipelines through capabilities"}]}],[{"id":"blk-14432","spans":[{"id":"spn-13062","marks":["code"],"text":"provenance"}]},{"id":"blk-14433","spans":[{"id":"spn-13063","text":"No"}]},{"id":"blk-14434","spans":[{"id":"spn-13064","text":"Boolean — enable hash-linked provenance chain"}]}]]},{"id":"blk-14435","kind":"paragraph","spans":[{"id":"spn-13065","text":"---"}]},{"id":"blk-14436","kind":"heading","level":2,"spans":[{"id":"spn-13066","text":"Capability Identifier Patterns"}]},{"id":"blk-14437","kind":"paragraph","spans":[{"id":"spn-13067","text":"Capabilities follow the pattern "},{"id":"spn-13068","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-13069","text":":"}]},{"id":"blk-14438","kind":"code","language":"text","text":"&memory.graph        — graph-structured persistent memory\n&memory.vector       — vector similarity search\n&memory.episodic     — event-based recall\n&reason.argument     — structured argumentation\n&reason.deliberate   — topology-aware focused reasoning\n&reason.attend       — proactive attention engine\n&time.anomaly        — temporal anomaly detection\n&time.forecast       — time-series prediction\n&space.fleet         — fleet-wide spatial awareness\n&space.geofence      — geographic boundary management"},{"id":"blk-14439","kind":"paragraph","spans":[{"id":"spn-13070","text":"Custom subtypes are permitted if they satisfy the primitive's capability contract."}]},{"id":"blk-14440","kind":"paragraph","spans":[{"id":"spn-13071","text":"---"}]},{"id":"blk-14441","kind":"heading","level":2,"spans":[{"id":"spn-13072","text":"Provider Binding"}]},{"id":"blk-14442","kind":"paragraph","spans":[{"id":"spn-13073","text":"Each capability declares a provider — the service that implements it:"}]},{"id":"blk-14443","kind":"paragraph","spans":[{"id":"spn-13074","marks":["bold"],"text":"Explicit provider:"}]},{"id":"blk-14444","kind":"code","language":"json","text":"\"&memory.graph\": {\n  \"provider\": \"graphonomous\",\n  \"config\": { \"instance\": \"infra-ops\" }\n}"},{"id":"blk-14445","kind":"paragraph","spans":[{"id":"spn-13075","marks":["bold"],"text":"Auto-resolved provider:"}]},{"id":"blk-14446","kind":"code","language":"json","text":"\"&memory.vector\": {\n  \"provider\": \"auto\",\n  \"config\": { \"index\": \"documents\" }\n}"},{"id":"blk-14447","kind":"paragraph","spans":[{"id":"spn-13076","text":"When "},{"id":"spn-13077","marks":["code"],"text":"provider"},{"id":"spn-13078","text":" is "},{"id":"spn-13079","marks":["code"],"text":"\"auto\""},{"id":"spn-13080","text":", the runtime resolves the provider from the capability registry at composition time."}]},{"id":"blk-14448","kind":"paragraph","spans":[{"id":"spn-13081","text":"---"}]},{"id":"blk-14449","kind":"heading","level":2,"spans":[{"id":"spn-13082","text":"Config Objects"}]},{"id":"blk-14450","kind":"paragraph","spans":[{"id":"spn-13083","text":"The "},{"id":"spn-13084","marks":["code"],"text":"config"},{"id":"spn-13085","text":" object is provider-specific. It passes through to the provider at bind time. Common patterns:"}]},{"head":[{"id":"blk-14452","spans":[{"id":"spn-13086","text":"Provider"}]},{"id":"blk-14453","spans":[{"id":"spn-13087","text":"Typical Config"}]}],"id":"blk-14451","kind":"table","rows":[[{"id":"blk-14454","spans":[{"id":"spn-13088","marks":["code"],"text":"graphonomous"}]},{"id":"blk-14455","spans":[{"id":"spn-13089","marks":["code"],"text":"instance"},{"id":"spn-13090","text":", "},{"id":"spn-13091","marks":["code"],"text":"budget"}]}],[{"id":"blk-14456","spans":[{"id":"spn-13092","marks":["code"],"text":"ticktickclock"}]},{"id":"blk-14457","spans":[{"id":"spn-13093","marks":["code"],"text":"streams"},{"id":"spn-13094","text":", "},{"id":"spn-13095","marks":["code"],"text":"window_days"},{"id":"spn-13096","text":", "},{"id":"spn-13097","marks":["code"],"text":"granularity"}]}],[{"id":"blk-14458","spans":[{"id":"spn-13098","marks":["code"],"text":"geofleetic"}]},{"id":"blk-14459","spans":[{"id":"spn-13099","marks":["code"],"text":"regions"},{"id":"spn-13100","text":", "},{"id":"spn-13101","marks":["code"],"text":"precision"}]}],[{"id":"blk-14460","spans":[{"id":"spn-13102","marks":["code"],"text":"deliberatic"}]},{"id":"blk-14461","spans":[{"id":"spn-13103","marks":["code"],"text":"governance"},{"id":"spn-13104","text":", "},{"id":"spn-13105","marks":["code"],"text":"mode"}]}]]},{"id":"blk-14462","kind":"paragraph","spans":[{"id":"spn-13106","text":"The schema does not constrain "},{"id":"spn-13107","marks":["code"],"text":"config"},{"id":"spn-13108","text":" contents — that is the provider's responsibility via its capability contract."}]},{"id":"blk-14463","kind":"paragraph","spans":[{"id":"spn-13109","text":"---"}]},{"id":"blk-14464","kind":"heading","level":2,"spans":[{"id":"spn-13110","text":"Working Examples"}]},{"id":"blk-14465","kind":"heading","level":3,"spans":[{"id":"spn-13111","text":"Minimal declaration (single capability)"}]},{"id":"blk-14466","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"SimpleMemoryAgent\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  }\n}"},{"id":"blk-14467","kind":"heading","level":3,"spans":[{"id":"spn-13112","text":"Research agent (three capabilities, governance)"}]},{"id":"blk-14468","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"ResearchAgent\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.vector\": {\n      \"provider\": \"pgvector\",\n      \"config\": { \"index\": \"papers\", \"namespace\": \"research-corpus\" }\n    },\n    \"&time.pattern\": {\n      \"provider\": \"ticktickclock\",\n      \"config\": { \"window_days\": 30, \"granularity\": \"daily\" }\n    },\n    \"&reason.argument\": {\n      \"provider\": \"deliberatic\",\n      \"config\": { \"governance\": \"evidence-first\" }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\"Never present unsupported conclusions as facts\"],\n    \"soft\": [\"Prefer recent peer-reviewed evidence\"],\n    \"escalate_when\": { \"confidence_below\": 0.65 }\n  },\n  \"provenance\": true\n}"},{"id":"blk-14469","kind":"heading","level":3,"spans":[{"id":"spn-13113","text":"Full infrastructure agent (six capabilities, pipelines, governance)"}]},{"id":"blk-14470","kind":"paragraph","spans":[{"id":"spn-13114","text":"See "},{"id":"spn-13115","marks":["code"],"text":"examples/infra-operator.ampersand.json"},{"id":"spn-13116","text":" for the complete InfraOperator declaration with "},{"id":"spn-13117","marks":["code"],"text":"&memory.graph"},{"id":"spn-13118","text":", "},{"id":"spn-13119","marks":["code"],"text":"&time.anomaly"},{"id":"spn-13120","text":", "},{"id":"spn-13121","marks":["code"],"text":"&space.fleet"},{"id":"spn-13122","text":", "},{"id":"spn-13123","marks":["code"],"text":"&reason.argument"},{"id":"spn-13124","text":", "},{"id":"spn-13125","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-13126","text":", "},{"id":"spn-13127","marks":["code"],"text":"&reason.attend"},{"id":"spn-13128","text":", plus a named "},{"id":"spn-13129","marks":["code"],"text":"incident_triage"},{"id":"spn-13130","text":" pipeline and full governance block."}]},{"id":"blk-14471","kind":"paragraph","spans":[{"id":"spn-13131","text":"---"}]},{"id":"blk-14472","kind":"heading","level":2,"spans":[{"id":"spn-13132","text":"Governance Block"}]},{"id":"blk-14473","kind":"paragraph","spans":[{"id":"spn-13133","text":"The "},{"id":"spn-13134","marks":["code"],"text":"governance"},{"id":"spn-13135","text":" object declares constraints the agent must respect:"}]},{"id":"blk-14474","kind":"code","language":"json","text":"\"governance\": {\n  \"hard\": [\"Never scale beyond 3x in a single action\"],\n  \"soft\": [\"Prefer gradual scaling over spikes\"],\n  \"escalate_when\": {\n    \"confidence_below\": 0.7,\n    \"cost_exceeds_usd\": 1000\n  },\n  \"autonomy\": {\n    \"level\": \"advise\",\n    \"model_tier\": \"local_small\",\n    \"heartbeat_seconds\": 300,\n    \"budget\": {\n      \"max_actions_per_hour\": 5,\n      \"require_approval_for\": [\"act\", \"propose\"]\n    }\n  }\n}"},{"id":"blk-14475","kind":"paragraph","spans":[{"id":"spn-13136","text":"See "},{"id":"spn-13137","marks":["code"],"text":"09_GOVERNANCE_PROVENANCE.md"},{"id":"spn-13138","text":" for full governance documentation."}]},{"id":"blk-14476","kind":"paragraph","spans":[{"id":"spn-13139","text":"---"}]},{"id":"blk-14477","kind":"heading","level":2,"spans":[{"id":"spn-13140","text":"Common Mistakes"}]},{"head":[{"id":"blk-14479","spans":[{"id":"spn-13141","text":"Mistake"}]},{"id":"blk-14480","spans":[{"id":"spn-13142","text":"Why It Fails"}]},{"id":"blk-14481","spans":[{"id":"spn-13143","text":"Fix"}]}],"id":"blk-14478","kind":"table","rows":[[{"id":"blk-14482","spans":[{"id":"spn-13144","text":"Missing "},{"id":"spn-13145","marks":["code"],"text":"agent"},{"id":"spn-13146","text":" field"}]},{"id":"blk-14483","spans":[{"id":"spn-13147","text":"Schema validation rejects it"}]},{"id":"blk-14484","spans":[{"id":"spn-13148","text":"Always include agent name"}]}],[{"id":"blk-14485","spans":[{"id":"spn-13149","text":"Using bare primitives ("},{"id":"spn-13150","marks":["code"],"text":"&memory"},{"id":"spn-13151","text":")"}]},{"id":"blk-14486","spans":[{"id":"spn-13152","text":"Subtypes are required in declarations"}]},{"id":"blk-14487","spans":[{"id":"spn-13153","text":"Use "},{"id":"spn-13154","marks":["code"],"text":"&memory.graph"},{"id":"spn-13155","text":", "},{"id":"spn-13156","marks":["code"],"text":"&memory.vector"},{"id":"spn-13157","text":", etc."}]}],[{"id":"blk-14488","spans":[{"id":"spn-13158","text":"Omitting "},{"id":"spn-13159","marks":["code"],"text":"provider"}]},{"id":"blk-14489","spans":[{"id":"spn-13160","text":"Runtime cannot bind the capability"}]},{"id":"blk-14490","spans":[{"id":"spn-13161","text":"Specify a provider or use "},{"id":"spn-13162","marks":["code"],"text":"\"auto\""}]}],[{"id":"blk-14491","spans":[{"id":"spn-13163","text":"Putting pipeline logic in capabilities"}]},{"id":"blk-14492","spans":[{"id":"spn-13164","text":"Capabilities declare what, not how"}]},{"id":"blk-14493","spans":[{"id":"spn-13165","text":"Use the "},{"id":"spn-13166","marks":["code"],"text":"pipelines"},{"id":"spn-13167","text":" block for data flow"}]}],[{"id":"blk-14494","spans":[{"id":"spn-13168","text":"Duplicating capability keys"}]},{"id":"blk-14495","spans":[{"id":"spn-13169","text":"JSON keys must be unique"}]},{"id":"blk-14496","spans":[{"id":"spn-13170","text":"Each "},{"id":"spn-13171","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-13172","text":" appears once"}]}],[{"id":"blk-14497","spans":[{"id":"spn-13173","text":"Non-semver version strings"}]},{"id":"blk-14498","spans":[{"id":"spn-13174","text":"Schema requires semver"}]},{"id":"blk-14499","spans":[{"id":"spn-13175","text":"Use "},{"id":"spn-13176","marks":["code"],"text":"\"1.0.0\""},{"id":"spn-13177","text":", not "},{"id":"spn-13178","marks":["code"],"text":"\"v1\""},{"id":"spn-13179","text":" or "},{"id":"spn-13180","marks":["code"],"text":"\"latest\""}]}]]}],"edges":[],"id":"bagaaieraqmwc2kbm7ply3o4ht62zrmpd7jpkldurqk7rkyctqehzo3soza4q","vocabulary":"ampersand.docs.fs.v1"}