{"bendscript":"0.1","blocks":[{"id":"blk-16242","kind":"heading","level":1,"spans":[{"id":"spn-14382","text":"Skill 01 — Writing Agent Declarations"}]},{"blocks":[{"id":"blk-16244","kind":"paragraph","spans":[{"id":"spn-14383","text":"How to write "},{"id":"spn-14384","marks":["code"],"text":"ampersand.json"},{"id":"spn-14385","text":" files that declare an agent's capabilities, governance, and provenance requirements."}]}],"id":"blk-16243","kind":"quote"},{"id":"blk-16245","kind":"heading","level":2,"spans":[{"id":"spn-14386","text":"Why This Matters"}]},{"id":"blk-16246","kind":"paragraph","spans":[{"id":"spn-14387","text":"The "},{"id":"spn-14388","marks":["code"],"text":"ampersand.json"},{"id":"spn-14389","text":" declaration is the source of truth for what an agent can do. Everything else — validation, composition, MCP/A2A generation — flows from this file. Get the declaration right and the rest follows."}]},{"id":"blk-16247","kind":"heading","level":2,"spans":[{"id":"spn-14390","text":"Basic Structure"}]},{"id":"blk-16248","kind":"paragraph","spans":[{"id":"spn-14391","text":"Every declaration has these top-level fields:"}]},{"id":"blk-16249","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"AgentName\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": { ... },\n  \"governance\": { ... },\n  \"provenance\": true\n}"},{"head":[{"id":"blk-16251","spans":[{"id":"spn-14392","text":"Field"}]},{"id":"blk-16252","spans":[{"id":"spn-14393","text":"Required"}]},{"id":"blk-16253","spans":[{"id":"spn-14394","text":"Description"}]}],"id":"blk-16250","kind":"table","rows":[[{"id":"blk-16254","spans":[{"id":"spn-14395","marks":["code"],"text":"$schema"}]},{"id":"blk-16255","spans":[{"id":"spn-14396","text":"Recommended"}]},{"id":"blk-16256","spans":[{"id":"spn-14397","text":"Points to the JSON Schema for validation"}]}],[{"id":"blk-16257","spans":[{"id":"spn-14398","marks":["code"],"text":"agent"}]},{"id":"blk-16258","spans":[{"id":"spn-14399","text":"Yes"}]},{"id":"blk-16259","spans":[{"id":"spn-14400","text":"Agent identifier (PascalCase by convention)"}]}],[{"id":"blk-16260","spans":[{"id":"spn-14401","marks":["code"],"text":"version"}]},{"id":"blk-16261","spans":[{"id":"spn-14402","text":"Yes"}]},{"id":"blk-16262","spans":[{"id":"spn-14403","text":"Semver version string"}]}],[{"id":"blk-16263","spans":[{"id":"spn-14404","marks":["code"],"text":"capabilities"}]},{"id":"blk-16264","spans":[{"id":"spn-14405","text":"Yes"}]},{"id":"blk-16265","spans":[{"id":"spn-14406","text":"Map of capability identifiers to provider configs"}]}],[{"id":"blk-16266","spans":[{"id":"spn-14407","marks":["code"],"text":"governance"}]},{"id":"blk-16267","spans":[{"id":"spn-14408","text":"No"}]},{"id":"blk-16268","spans":[{"id":"spn-14409","text":"Hard/soft constraints, escalation rules, autonomy"}]}],[{"id":"blk-16269","spans":[{"id":"spn-14410","marks":["code"],"text":"pipelines"}]},{"id":"blk-16270","spans":[{"id":"spn-14411","text":"No"}]},{"id":"blk-16271","spans":[{"id":"spn-14412","text":"Named data-flow pipelines through capabilities"}]}],[{"id":"blk-16272","spans":[{"id":"spn-14413","marks":["code"],"text":"provenance"}]},{"id":"blk-16273","spans":[{"id":"spn-14414","text":"No"}]},{"id":"blk-16274","spans":[{"id":"spn-14415","text":"Boolean — enable hash-linked provenance chain"}]}]]},{"id":"blk-16275","kind":"heading","level":2,"spans":[{"id":"spn-14416","text":"Capability Identifier Patterns"}]},{"id":"blk-16276","kind":"paragraph","spans":[{"id":"spn-14417","text":"Capabilities follow the pattern "},{"id":"spn-14418","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14419","text":":"}]},{"id":"blk-16277","kind":"code","language":"text","text":"&memory.graph        — graph-structured persistent memory\n&memory.vector       — vector similarity search\n&memory.episodic     — event-based recall\n&reason.argument     — structured argumentation\n&reason.deliberate   — topology-aware focused reasoning\n&reason.attend       — proactive attention engine\n&time.anomaly        — temporal anomaly detection\n&time.forecast       — time-series prediction\n&space.fleet         — fleet-wide spatial awareness\n&space.geofence      — geographic boundary management"},{"id":"blk-16278","kind":"paragraph","spans":[{"id":"spn-14420","text":"Custom subtypes are permitted if they satisfy the primitive's capability contract."}]},{"id":"blk-16279","kind":"heading","level":2,"spans":[{"id":"spn-14421","text":"Provider Binding"}]},{"id":"blk-16280","kind":"paragraph","spans":[{"id":"spn-14422","text":"Each capability declares a provider — the service that implements it:"}]},{"id":"blk-16281","kind":"paragraph","spans":[{"id":"spn-14423","marks":["bold"],"text":"Explicit provider:"}]},{"id":"blk-16282","kind":"code","language":"json","text":"\"&memory.graph\": {\n  \"provider\": \"graphonomous\",\n  \"config\": { \"instance\": \"infra-ops\" }\n}"},{"id":"blk-16283","kind":"paragraph","spans":[{"id":"spn-14424","marks":["bold"],"text":"Auto-resolved provider:"}]},{"id":"blk-16284","kind":"code","language":"json","text":"\"&memory.vector\": {\n  \"provider\": \"auto\",\n  \"config\": { \"index\": \"documents\" }\n}"},{"id":"blk-16285","kind":"paragraph","spans":[{"id":"spn-14425","text":"When "},{"id":"spn-14426","marks":["code"],"text":"provider"},{"id":"spn-14427","text":" is "},{"id":"spn-14428","marks":["code"],"text":"\"auto\""},{"id":"spn-14429","text":", the runtime resolves the provider from the capability registry at composition time."}]},{"id":"blk-16286","kind":"heading","level":2,"spans":[{"id":"spn-14430","text":"Config Objects"}]},{"id":"blk-16287","kind":"paragraph","spans":[{"id":"spn-14431","text":"The "},{"id":"spn-14432","marks":["code"],"text":"config"},{"id":"spn-14433","text":" object is provider-specific. It passes through to the provider at bind time. Common patterns:"}]},{"head":[{"id":"blk-16289","spans":[{"id":"spn-14434","text":"Provider"}]},{"id":"blk-16290","spans":[{"id":"spn-14435","text":"Typical Config"}]}],"id":"blk-16288","kind":"table","rows":[[{"id":"blk-16291","spans":[{"id":"spn-14436","marks":["code"],"text":"graphonomous"}]},{"id":"blk-16292","spans":[{"id":"spn-14437","marks":["code"],"text":"instance"},{"id":"spn-14438","text":", "},{"id":"spn-14439","marks":["code"],"text":"budget"}]}],[{"id":"blk-16293","spans":[{"id":"spn-14440","marks":["code"],"text":"ticktickclock"}]},{"id":"blk-16294","spans":[{"id":"spn-14441","marks":["code"],"text":"streams"},{"id":"spn-14442","text":", "},{"id":"spn-14443","marks":["code"],"text":"window_days"},{"id":"spn-14444","text":", "},{"id":"spn-14445","marks":["code"],"text":"granularity"}]}],[{"id":"blk-16295","spans":[{"id":"spn-14446","marks":["code"],"text":"geofleetic"}]},{"id":"blk-16296","spans":[{"id":"spn-14447","marks":["code"],"text":"regions"},{"id":"spn-14448","text":", "},{"id":"spn-14449","marks":["code"],"text":"precision"}]}],[{"id":"blk-16297","spans":[{"id":"spn-14450","marks":["code"],"text":"deliberatic"}]},{"id":"blk-16298","spans":[{"id":"spn-14451","marks":["code"],"text":"governance"},{"id":"spn-14452","text":", "},{"id":"spn-14453","marks":["code"],"text":"mode"}]}]]},{"id":"blk-16299","kind":"paragraph","spans":[{"id":"spn-14454","text":"The schema does not constrain "},{"id":"spn-14455","marks":["code"],"text":"config"},{"id":"spn-14456","text":" contents — that is the provider's responsibility via its capability contract."}]},{"id":"blk-16300","kind":"heading","level":2,"spans":[{"id":"spn-14457","text":"Working Examples"}]},{"id":"blk-16301","kind":"heading","level":3,"spans":[{"id":"spn-14458","text":"Minimal declaration (single capability)"}]},{"id":"blk-16302","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"SimpleMemoryAgent\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  }\n}"},{"id":"blk-16303","kind":"heading","level":3,"spans":[{"id":"spn-14459","text":"Research agent (three capabilities, governance)"}]},{"id":"blk-16304","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"ResearchAgent\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.vector\": {\n      \"provider\": \"pgvector\",\n      \"config\": { \"index\": \"papers\", \"namespace\": \"research-corpus\" }\n    },\n    \"&time.pattern\": {\n      \"provider\": \"ticktickclock\",\n      \"config\": { \"window_days\": 30, \"granularity\": \"daily\" }\n    },\n    \"&reason.argument\": {\n      \"provider\": \"deliberatic\",\n      \"config\": { \"governance\": \"evidence-first\" }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\"Never present unsupported conclusions as facts\"],\n    \"soft\": [\"Prefer recent peer-reviewed evidence\"],\n    \"escalate_when\": { \"confidence_below\": 0.65 }\n  },\n  \"provenance\": true\n}"},{"id":"blk-16305","kind":"heading","level":3,"spans":[{"id":"spn-14460","text":"Full infrastructure agent (six capabilities, pipelines, governance)"}]},{"id":"blk-16306","kind":"paragraph","spans":[{"id":"spn-14461","text":"See "},{"id":"spn-14462","marks":["code"],"text":"examples/infra-operator.ampersand.json"},{"id":"spn-14463","text":" for the complete InfraOperator declaration with "},{"id":"spn-14464","marks":["code"],"text":"&memory.graph"},{"id":"spn-14465","text":", "},{"id":"spn-14466","marks":["code"],"text":"&time.anomaly"},{"id":"spn-14467","text":", "},{"id":"spn-14468","marks":["code"],"text":"&space.fleet"},{"id":"spn-14469","text":", "},{"id":"spn-14470","marks":["code"],"text":"&reason.argument"},{"id":"spn-14471","text":", "},{"id":"spn-14472","marks":["code"],"text":"&reason.deliberate"},{"id":"spn-14473","text":", "},{"id":"spn-14474","marks":["code"],"text":"&reason.attend"},{"id":"spn-14475","text":", plus a named "},{"id":"spn-14476","marks":["code"],"text":"incident_triage"},{"id":"spn-14477","text":" pipeline and full governance block."}]},{"id":"blk-16307","kind":"heading","level":2,"spans":[{"id":"spn-14478","text":"Governance Block"}]},{"id":"blk-16308","kind":"paragraph","spans":[{"id":"spn-14479","text":"The "},{"id":"spn-14480","marks":["code"],"text":"governance"},{"id":"spn-14481","text":" object declares constraints the agent must respect:"}]},{"id":"blk-16309","kind":"code","language":"json","text":"\"governance\": {\n  \"hard\": [\"Never scale beyond 3x in a single action\"],\n  \"soft\": [\"Prefer gradual scaling over spikes\"],\n  \"escalate_when\": {\n    \"confidence_below\": 0.7,\n    \"cost_exceeds_usd\": 1000\n  },\n  \"autonomy\": {\n    \"level\": \"advise\",\n    \"model_tier\": \"local_small\",\n    \"heartbeat_seconds\": 300,\n    \"budget\": {\n      \"max_actions_per_hour\": 5,\n      \"require_approval_for\": [\"act\", \"propose\"]\n    }\n  }\n}"},{"id":"blk-16310","kind":"paragraph","spans":[{"id":"spn-14482","text":"See "},{"id":"spn-14483","marks":["code"],"text":"09_GOVERNANCE_PROVENANCE.md"},{"id":"spn-14484","text":" for full governance documentation."}]},{"id":"blk-16311","kind":"heading","level":2,"spans":[{"id":"spn-14485","text":"Common Mistakes"}]},{"head":[{"id":"blk-16313","spans":[{"id":"spn-14486","text":"Mistake"}]},{"id":"blk-16314","spans":[{"id":"spn-14487","text":"Why It Fails"}]},{"id":"blk-16315","spans":[{"id":"spn-14488","text":"Fix"}]}],"id":"blk-16312","kind":"table","rows":[[{"id":"blk-16316","spans":[{"id":"spn-14489","text":"Missing "},{"id":"spn-14490","marks":["code"],"text":"agent"},{"id":"spn-14491","text":" field"}]},{"id":"blk-16317","spans":[{"id":"spn-14492","text":"Schema validation rejects it"}]},{"id":"blk-16318","spans":[{"id":"spn-14493","text":"Always include agent name"}]}],[{"id":"blk-16319","spans":[{"id":"spn-14494","text":"Using bare primitives ("},{"id":"spn-14495","marks":["code"],"text":"&memory"},{"id":"spn-14496","text":")"}]},{"id":"blk-16320","spans":[{"id":"spn-14497","text":"Subtypes are required in declarations"}]},{"id":"blk-16321","spans":[{"id":"spn-14498","text":"Use "},{"id":"spn-14499","marks":["code"],"text":"&memory.graph"},{"id":"spn-14500","text":", "},{"id":"spn-14501","marks":["code"],"text":"&memory.vector"},{"id":"spn-14502","text":", etc."}]}],[{"id":"blk-16322","spans":[{"id":"spn-14503","text":"Omitting "},{"id":"spn-14504","marks":["code"],"text":"provider"}]},{"id":"blk-16323","spans":[{"id":"spn-14505","text":"Runtime cannot bind the capability"}]},{"id":"blk-16324","spans":[{"id":"spn-14506","text":"Specify a provider or use "},{"id":"spn-14507","marks":["code"],"text":"\"auto\""}]}],[{"id":"blk-16325","spans":[{"id":"spn-14508","text":"Putting pipeline logic in capabilities"}]},{"id":"blk-16326","spans":[{"id":"spn-14509","text":"Capabilities declare what, not how"}]},{"id":"blk-16327","spans":[{"id":"spn-14510","text":"Use the "},{"id":"spn-14511","marks":["code"],"text":"pipelines"},{"id":"spn-14512","text":" block for data flow"}]}],[{"id":"blk-16328","spans":[{"id":"spn-14513","text":"Duplicating capability keys"}]},{"id":"blk-16329","spans":[{"id":"spn-14514","text":"JSON keys must be unique"}]},{"id":"blk-16330","spans":[{"id":"spn-14515","text":"Each "},{"id":"spn-14516","marks":["code"],"text":"&primitive.subtype"},{"id":"spn-14517","text":" appears once"}]}],[{"id":"blk-16331","spans":[{"id":"spn-14518","text":"Non-semver version strings"}]},{"id":"blk-16332","spans":[{"id":"spn-14519","text":"Schema requires semver"}]},{"id":"blk-16333","spans":[{"id":"spn-14520","text":"Use "},{"id":"spn-14521","marks":["code"],"text":"\"1.0.0\""},{"id":"spn-14522","text":", not "},{"id":"spn-14523","marks":["code"],"text":"\"v1\""},{"id":"spn-14524","text":" or "},{"id":"spn-14525","marks":["code"],"text":"\"latest\""}]}]]}],"edges":[],"id":"bagaaierawoweaq5swpyrgq4mibytjc55rugujdaueipaw62letlvqmgp6rha","vocabulary":"ampersand.docs.fs.v1"}