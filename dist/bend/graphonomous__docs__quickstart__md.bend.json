{"bendscript":"0.1","blocks":[{"id":"blk-41657","kind":"heading","level":1,"spans":[{"id":"spn-46806","text":"Graphonomous Quickstart"}]},{"id":"blk-41658","kind":"paragraph","spans":[{"id":"spn-46807","text":"This guide gets you from zero to a working Graphonomous MCP runtime in minutes."}]},{"id":"blk-41659","kind":"heading","level":2,"spans":[{"id":"spn-46808","text":"What you’ll set up"}]},{"id":"blk-41660","kind":"paragraph","spans":[{"id":"spn-46809","text":"1. Run Graphonomous locally 2. Connect it to your MCP-compatible client 3. Verify retrieval and learning loops 4. Build docs locally before publishing to Read the Docs"}]},{"id":"blk-41661","kind":"paragraph","spans":[{"id":"spn-46810","text":"---"}]},{"id":"blk-41662","kind":"heading","level":2,"spans":[{"id":"spn-46811","text":"Prerequisites"}]},{"id":"blk-41663","items":[{"blocks":[{"id":"blk-41665","kind":"paragraph","spans":[{"id":"spn-46812","text":"Linux/macOS (or WSL on Windows)"}]}],"id":"blk-41664","kind":"list-item"},{"blocks":[{"id":"blk-41667","kind":"paragraph","spans":[{"id":"spn-46813","text":"Elixir "},{"id":"spn-46814","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-41666","kind":"list-item"},{"blocks":[{"id":"blk-41669","kind":"paragraph","spans":[{"id":"spn-46815","text":"Erlang/OTP "},{"id":"spn-46816","marks":["code"],"text":"27.x"}]}],"id":"blk-41668","kind":"list-item"},{"blocks":[{"id":"blk-41671","kind":"paragraph","spans":[{"id":"spn-46817","text":"Node.js "},{"id":"spn-46818","marks":["code"],"text":">= 18"},{"id":"spn-46819","text":" (recommended for npm/npx workflow)"}]}],"id":"blk-41670","kind":"list-item"},{"blocks":[{"id":"blk-41673","kind":"paragraph","spans":[{"id":"spn-46820","text":"Python "},{"id":"spn-46821","marks":["code"],"text":">= 3.10"},{"id":"spn-46822","text":" (for docs build)"}]}],"id":"blk-41672","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41674","kind":"paragraph","spans":[{"id":"spn-46823","text":"---"}]},{"id":"blk-41675","kind":"heading","level":2,"spans":[{"id":"spn-46824","text":"1) Run Graphonomous"}]},{"id":"blk-41676","kind":"heading","level":3,"spans":[{"id":"spn-46825","text":"Option A — Fast start with "},{"id":"spn-46826","marks":["code"],"text":"npx"}]},{"id":"blk-41677","kind":"code","language":"sh","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-41678","kind":"heading","level":3,"spans":[{"id":"spn-46827","text":"Option B — Build from source"}]},{"id":"blk-41679","kind":"code","language":"sh","text":"cd ProjectAmp2/graphonomous\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nMIX_ENV=prod mix release --overwrite\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" -- --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-41680","kind":"paragraph","spans":[{"id":"spn-46828","text":"---"}]},{"id":"blk-41681","kind":"heading","level":2,"spans":[{"id":"spn-46829","text":"2) Configure your MCP client"}]},{"id":"blk-41682","kind":"paragraph","spans":[{"id":"spn-46830","text":"Use the Graphonomous command in your MCP server settings."}]},{"id":"blk-41683","kind":"paragraph","spans":[{"id":"spn-46831","text":"Example shape:"}]},{"id":"blk-41684","kind":"code","language":"json","text":"{\n  \"context_servers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"],\n      \"env\": {\n        \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\"\n      }\n    }\n  }\n}"},{"id":"blk-41685","kind":"paragraph","spans":[{"id":"spn-46832","text":"If you do not install globally, use "},{"id":"spn-46833","marks":["code"],"text":"npx"},{"id":"spn-46834","text":" as the command and pass the package in args."}]},{"id":"blk-41686","kind":"heading","level":3,"spans":[{"id":"spn-46835","text":"Claude Code"}]},{"id":"blk-41687","kind":"paragraph","spans":[{"id":"spn-46836","text":"Add to your project's "},{"id":"spn-46837","marks":["code"],"text":".mcp.json"},{"id":"spn-46838","text":":"}]},{"id":"blk-41688","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"./.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"]\n    }\n  }\n}"},{"id":"blk-41689","kind":"paragraph","spans":[{"id":"spn-46839","text":"---"}]},{"id":"blk-41690","kind":"heading","level":2,"spans":[{"id":"spn-46840","text":"3) Verify the memory loop"}]},{"id":"blk-41691","kind":"paragraph","spans":[{"id":"spn-46841","text":"In your client, run a simple cycle:"}]},{"id":"blk-41692","kind":"paragraph","spans":[{"id":"spn-46842","text":"1. "},{"id":"spn-46843","marks":["bold"],"text":"Store"}]},{"id":"blk-41693","items":[{"blocks":[{"id":"blk-41695","kind":"paragraph","spans":[{"id":"spn-46844","text":"Save one semantic fact via "},{"id":"spn-46845","marks":["code"],"text":"store_node"}]}],"id":"blk-41694","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41696","kind":"paragraph","spans":[{"id":"spn-46846","text":"2. "},{"id":"spn-46847","marks":["bold"],"text":"Retrieve"}]},{"id":"blk-41697","items":[{"blocks":[{"id":"blk-41699","kind":"paragraph","spans":[{"id":"spn-46848","text":"Query it with "},{"id":"spn-46849","marks":["code"],"text":"retrieve_context"}]}],"id":"blk-41698","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41700","kind":"paragraph","spans":[{"id":"spn-46850","text":"3. "},{"id":"spn-46851","marks":["bold"],"text":"Learn"}]},{"id":"blk-41701","items":[{"blocks":[{"id":"blk-41703","kind":"paragraph","spans":[{"id":"spn-46852","text":"Report outcome with "},{"id":"spn-46853","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-46854","text":" using returned causal IDs"}]}],"id":"blk-41702","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41704","kind":"para