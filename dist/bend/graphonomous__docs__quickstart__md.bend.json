{"bendscript":"0.1","blocks":[{"id":"blk-42629","kind":"heading","level":1,"spans":[{"id":"spn-49100","text":"Graphonomous Quickstart"}]},{"id":"blk-42630","kind":"paragraph","spans":[{"id":"spn-49101","text":"This guide gets you from zero to a working Graphonomous MCP runtime in minutes."}]},{"id":"blk-42631","kind":"heading","level":2,"spans":[{"id":"spn-49102","text":"What you’ll set up"}]},{"id":"blk-42632","kind":"paragraph","spans":[{"id":"spn-49103","text":"1. Run Graphonomous locally 2. Connect it to your MCP-compatible client 3. Verify retrieval and learning loops 4. Build docs locally before publishing to Read the Docs"}]},{"id":"blk-42633","kind":"paragraph","spans":[{"id":"spn-49104","text":"---"}]},{"id":"blk-42634","kind":"heading","level":2,"spans":[{"id":"spn-49105","text":"Prerequisites"}]},{"id":"blk-42635","items":[{"blocks":[{"id":"blk-42637","kind":"paragraph","spans":[{"id":"spn-49106","text":"Linux/macOS (or WSL on Windows)"}]}],"id":"blk-42636","kind":"list-item"},{"blocks":[{"id":"blk-42639","kind":"paragraph","spans":[{"id":"spn-49107","text":"Elixir "},{"id":"spn-49108","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-42638","kind":"list-item"},{"blocks":[{"id":"blk-42641","kind":"paragraph","spans":[{"id":"spn-49109","text":"Erlang/OTP "},{"id":"spn-49110","marks":["code"],"text":"27.x"}]}],"id":"blk-42640","kind":"list-item"},{"blocks":[{"id":"blk-42643","kind":"paragraph","spans":[{"id":"spn-49111","text":"Node.js "},{"id":"spn-49112","marks":["code"],"text":">= 18"},{"id":"spn-49113","text":" (recommended for npm/npx workflow)"}]}],"id":"blk-42642","kind":"list-item"},{"blocks":[{"id":"blk-42645","kind":"paragraph","spans":[{"id":"spn-49114","text":"Python "},{"id":"spn-49115","marks":["code"],"text":">= 3.10"},{"id":"spn-49116","text":" (for docs build)"}]}],"id":"blk-42644","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42646","kind":"paragraph","spans":[{"id":"spn-49117","text":"---"}]},{"id":"blk-42647","kind":"heading","level":2,"spans":[{"id":"spn-49118","text":"1) Run Graphonomous"}]},{"id":"blk-42648","kind":"heading","level":3,"spans":[{"id":"spn-49119","text":"Option A — Fast start with "},{"id":"spn-49120","marks":["code"],"text":"npx"}]},{"id":"blk-42649","kind":"code","language":"sh","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-42650","kind":"heading","level":3,"spans":[{"id":"spn-49121","text":"Option B — Build from source"}]},{"id":"blk-42651","kind":"code","language":"sh","text":"cd ProjectAmp2/graphonomous\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nMIX_ENV=prod mix release --overwrite\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" -- --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-42652","kind":"paragraph","spans":[{"id":"spn-49122","text":"---"}]},{"id":"blk-42653","kind":"heading","level":2,"spans":[{"id":"spn-49123","text":"2) Configure your MCP client"}]},{"id":"blk-42654","kind":"paragraph","spans":[{"id":"spn-49124","text":"Use the Graphonomous command in your MCP server settings."}]},{"id":"blk-42655","kind":"paragraph","spans":[{"id":"spn-49125","text":"Example shape:"}]},{"id":"blk-42656","kind":"code","language":"json","text":"{\n  \"context_servers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"],\n      \"env\": {\n        \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\"\n      }\n    }\n  }\n}"},{"id":"blk-42657","kind":"paragraph","spans":[{"id":"spn-49126","text":"If you do not install globally, use "},{"id":"spn-49127","marks":["code"],"text":"npx"},{"id":"spn-49128","text":" as the command and pass the package in args."}]},{"id":"blk-42658","kind":"heading","level":3,"spans":[{"id":"spn-49129","text":"Claude Code"}]},{"id":"blk-42659","kind":"paragraph","spans":[{"id":"spn-49130","text":"Add to your project's "},{"id":"spn-49131","marks":["code"],"text":".mcp.json"},{"id":"spn-49132","text":":"}]},{"id":"blk-42660","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"./.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"]\n    }\n  }\n}"},{"id":"blk-42661","kind":"paragraph","spans":[{"id":"spn-49133","text":"---"}]},{"id":"blk-42662","kind":"heading","level":2,"spans":[{"id":"spn-49134","text":"3) Verify the memory loop"}]},{"id":"blk-42663","kind":"paragraph","spans":[{"id":"spn-49135","text":"In your client, run a simple cycle:"}]},{"id":"blk-42664","kind":"paragraph","spans":[{"id":"spn-49136","text":"1. "},{"id":"spn-49137","marks":["bold"],"text":"Store"}]},{"id":"blk-42665","items":[{"blocks":[{"id":"blk-42667","kind":"paragraph","spans":[{"id":"spn-49138","text":"Save one semantic fact via "},{"id":"spn-49139","marks":["code"],"text":"store_node"}]}],"id":"blk-42666","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42668","kind":"paragraph","spans":[{"id":"spn-49140","text":"2. "},{"id":"spn-49141","marks":["bold"],"text":"Retrieve"}]},{"id":"blk-42669","items":[{"blocks":[{"id":"blk-42671","kind":"paragraph","spans":[{"id":"spn-49142","text":"Query it with "},{"id":"spn-49143","marks":["code"],"text":"retrieve_context"}]}],"id":"blk-42670","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42672","kind":"paragraph","spans":[{"id":"spn-49144","text":"3. "},{"id":"spn-49145","marks":["bold"],"text":"Learn"}]},{"id":"blk-42673","items":[{"blocks":[{"id":"blk-42675","kind":"paragraph","spans":[{"id":"spn-49146","text":"Report outcome with "},{"id":"spn-49147","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-49148","text":" using returned causal IDs"}]}],"id":"blk-42674","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42676","kind":"para