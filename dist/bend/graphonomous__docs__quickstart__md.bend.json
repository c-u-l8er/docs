{"bendscript":"0.1","blocks":[{"id":"blk-41547","kind":"heading","level":1,"spans":[{"id":"spn-46177","text":"Graphonomous Quickstart"}]},{"id":"blk-41548","kind":"paragraph","spans":[{"id":"spn-46178","text":"This guide gets you from zero to a working Graphonomous MCP runtime in minutes."}]},{"id":"blk-41549","kind":"heading","level":2,"spans":[{"id":"spn-46179","text":"What you’ll set up"}]},{"id":"blk-41550","kind":"paragraph","spans":[{"id":"spn-46180","text":"1. Run Graphonomous locally 2. Connect it to your MCP-compatible client 3. Verify retrieval and learning loops 4. Build docs locally before publishing to Read the Docs"}]},{"id":"blk-41551","kind":"paragraph","spans":[{"id":"spn-46181","text":"---"}]},{"id":"blk-41552","kind":"heading","level":2,"spans":[{"id":"spn-46182","text":"Prerequisites"}]},{"id":"blk-41553","items":[{"blocks":[{"id":"blk-41555","kind":"paragraph","spans":[{"id":"spn-46183","text":"Linux/macOS (or WSL on Windows)"}]}],"id":"blk-41554","kind":"list-item"},{"blocks":[{"id":"blk-41557","kind":"paragraph","spans":[{"id":"spn-46184","text":"Elixir "},{"id":"spn-46185","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-41556","kind":"list-item"},{"blocks":[{"id":"blk-41559","kind":"paragraph","spans":[{"id":"spn-46186","text":"Erlang/OTP "},{"id":"spn-46187","marks":["code"],"text":"27.x"}]}],"id":"blk-41558","kind":"list-item"},{"blocks":[{"id":"blk-41561","kind":"paragraph","spans":[{"id":"spn-46188","text":"Node.js "},{"id":"spn-46189","marks":["code"],"text":">= 18"},{"id":"spn-46190","text":" (recommended for npm/npx workflow)"}]}],"id":"blk-41560","kind":"list-item"},{"blocks":[{"id":"blk-41563","kind":"paragraph","spans":[{"id":"spn-46191","text":"Python "},{"id":"spn-46192","marks":["code"],"text":">= 3.10"},{"id":"spn-46193","text":" (for docs build)"}]}],"id":"blk-41562","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41564","kind":"paragraph","spans":[{"id":"spn-46194","text":"---"}]},{"id":"blk-41565","kind":"heading","level":2,"spans":[{"id":"spn-46195","text":"1) Run Graphonomous"}]},{"id":"blk-41566","kind":"heading","level":3,"spans":[{"id":"spn-46196","text":"Option A — Fast start with "},{"id":"spn-46197","marks":["code"],"text":"npx"}]},{"id":"blk-41567","kind":"code","language":"sh","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-41568","kind":"heading","level":3,"spans":[{"id":"spn-46198","text":"Option B — Build from source"}]},{"id":"blk-41569","kind":"code","language":"sh","text":"cd ProjectAmp2/graphonomous\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nMIX_ENV=prod mix release --overwrite\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" -- --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-41570","kind":"paragraph","spans":[{"id":"spn-46199","text":"---"}]},{"id":"blk-41571","kind":"heading","level":2,"spans":[{"id":"spn-46200","text":"2) Configure your MCP client"}]},{"id":"blk-41572","kind":"paragraph","spans":[{"id":"spn-46201","text":"Use the Graphonomous command in your MCP server settings."}]},{"id":"blk-41573","kind":"paragraph","spans":[{"id":"spn-46202","text":"Example shape:"}]},{"id":"blk-41574","kind":"code","language":"json","text":"{\n  \"context_servers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"],\n      \"env\": {\n        \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\"\n      }\n    }\n  }\n}"},{"id":"blk-41575","kind":"paragraph","spans":[{"id":"spn-46203","text":"If you do not install globally, use "},{"id":"spn-46204","marks":["code"],"text":"npx"},{"id":"spn-46205","text":" as the command and pass the package in args."}]},{"id":"blk-41576","kind":"heading","level":3,"spans":[{"id":"spn-46206","text":"Claude Code"}]},{"id":"blk-41577","kind":"paragraph","spans":[{"id":"spn-46207","text":"Add to your project's "},{"id":"spn-46208","marks":["code"],"text":".mcp.json"},{"id":"spn-46209","text":":"}]},{"id":"blk-41578","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"./.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"]\n    }\n  }\n}"},{"id":"blk-41579","kind":"paragraph","spans":[{"id":"spn-46210","text":"---"}]},{"id":"blk-41580","kind":"heading","level":2,"spans":[{"id":"spn-46211","text":"3) Verify the memory loop"}]},{"id":"blk-41581","kind":"paragraph","spans":[{"id":"spn-46212","text":"In your client, run a simple cycle:"}]},{"id":"blk-41582","kind":"paragraph","spans":[{"id":"spn-46213","text":"1. "},{"id":"spn-46214","marks":["bold"],"text":"Store"}]},{"id":"blk-41583","items":[{"blocks":[{"id":"blk-41585","kind":"paragraph","spans":[{"id":"spn-46215","text":"Save one semantic fact via "},{"id":"spn-46216","marks":["code"],"text":"store_node"}]}],"id":"blk-41584","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41586","kind":"paragraph","spans":[{"id":"spn-46217","text":"2. "},{"id":"spn-46218","marks":["bold"],"text":"Retrieve"}]},{"id":"blk-41587","items":[{"blocks":[{"id":"blk-41589","kind":"paragraph","spans":[{"id":"spn-46219","text":"Query it with "},{"id":"spn-46220","marks":["code"],"text":"retrieve_context"}]}],"id":"blk-41588","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41590","kind":"paragraph","spans":[{"id":"spn-46221","text":"3. "},{"id":"spn-46222","marks":["bold"],"text":"Learn"}]},{"id":"blk-41591","items":[{"blocks":[{"id":"blk-41593","kind":"paragraph","spans":[{"id":"spn-46223","text":"Report outcome with "},{"id":"spn-46224","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-46225","text":" using returned causal IDs"}]}],"id":"blk-41592","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41594","kind":"para