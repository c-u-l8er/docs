{"bendscript":"0.1","blocks":[{"id":"blk-42143","kind":"heading","level":1,"spans":[{"id":"spn-47980","text":"Graphonomous Quickstart"}]},{"id":"blk-42144","kind":"paragraph","spans":[{"id":"spn-47981","text":"This guide gets you from zero to a working Graphonomous MCP runtime in minutes."}]},{"id":"blk-42145","kind":"heading","level":2,"spans":[{"id":"spn-47982","text":"What you’ll set up"}]},{"id":"blk-42146","kind":"paragraph","spans":[{"id":"spn-47983","text":"1. Run Graphonomous locally 2. Connect it to your MCP-compatible client 3. Verify retrieval and learning loops 4. Build docs locally before publishing to Read the Docs"}]},{"id":"blk-42147","kind":"paragraph","spans":[{"id":"spn-47984","text":"---"}]},{"id":"blk-42148","kind":"heading","level":2,"spans":[{"id":"spn-47985","text":"Prerequisites"}]},{"id":"blk-42149","items":[{"blocks":[{"id":"blk-42151","kind":"paragraph","spans":[{"id":"spn-47986","text":"Linux/macOS (or WSL on Windows)"}]}],"id":"blk-42150","kind":"list-item"},{"blocks":[{"id":"blk-42153","kind":"paragraph","spans":[{"id":"spn-47987","text":"Elixir "},{"id":"spn-47988","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-42152","kind":"list-item"},{"blocks":[{"id":"blk-42155","kind":"paragraph","spans":[{"id":"spn-47989","text":"Erlang/OTP "},{"id":"spn-47990","marks":["code"],"text":"27.x"}]}],"id":"blk-42154","kind":"list-item"},{"blocks":[{"id":"blk-42157","kind":"paragraph","spans":[{"id":"spn-47991","text":"Node.js "},{"id":"spn-47992","marks":["code"],"text":">= 18"},{"id":"spn-47993","text":" (recommended for npm/npx workflow)"}]}],"id":"blk-42156","kind":"list-item"},{"blocks":[{"id":"blk-42159","kind":"paragraph","spans":[{"id":"spn-47994","text":"Python "},{"id":"spn-47995","marks":["code"],"text":">= 3.10"},{"id":"spn-47996","text":" (for docs build)"}]}],"id":"blk-42158","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42160","kind":"paragraph","spans":[{"id":"spn-47997","text":"---"}]},{"id":"blk-42161","kind":"heading","level":2,"spans":[{"id":"spn-47998","text":"1) Run Graphonomous"}]},{"id":"blk-42162","kind":"heading","level":3,"spans":[{"id":"spn-47999","text":"Option A — Fast start with "},{"id":"spn-48000","marks":["code"],"text":"npx"}]},{"id":"blk-42163","kind":"code","language":"sh","text":"npx -y graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-42164","kind":"heading","level":3,"spans":[{"id":"spn-48001","text":"Option B — Build from source"}]},{"id":"blk-42165","kind":"code","language":"sh","text":"cd ProjectAmp2/graphonomous\nmix deps.get\nmix compile --warnings-as-errors\nmix test\nMIX_ENV=prod mix release --overwrite\n_build/prod/rel/graphonomous/bin/graphonomous eval \"Graphonomous.CLI.main(System.argv())\" -- --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-42166","kind":"paragraph","spans":[{"id":"spn-48002","text":"---"}]},{"id":"blk-42167","kind":"heading","level":2,"spans":[{"id":"spn-48003","text":"2) Configure your MCP client"}]},{"id":"blk-42168","kind":"paragraph","spans":[{"id":"spn-48004","text":"Use the Graphonomous command in your MCP server settings."}]},{"id":"blk-42169","kind":"paragraph","spans":[{"id":"spn-48005","text":"Example shape:"}]},{"id":"blk-42170","kind":"code","language":"json","text":"{\n  \"context_servers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"],\n      \"env\": {\n        \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\"\n      }\n    }\n  }\n}"},{"id":"blk-42171","kind":"paragraph","spans":[{"id":"spn-48006","text":"If you do not install globally, use "},{"id":"spn-48007","marks":["code"],"text":"npx"},{"id":"spn-48008","text":" as the command and pass the package in args."}]},{"id":"blk-42172","kind":"heading","level":3,"spans":[{"id":"spn-48009","text":"Claude Code"}]},{"id":"blk-42173","kind":"paragraph","spans":[{"id":"spn-48010","text":"Add to your project's "},{"id":"spn-48011","marks":["code"],"text":".mcp.json"},{"id":"spn-48012","text":":"}]},{"id":"blk-42174","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"graphonomous\", \"--db\", \"./.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\"]\n    }\n  }\n}"},{"id":"blk-42175","kind":"paragraph","spans":[{"id":"spn-48013","text":"---"}]},{"id":"blk-42176","kind":"heading","level":2,"spans":[{"id":"spn-48014","text":"3) Verify the memory loop"}]},{"id":"blk-42177","kind":"paragraph","spans":[{"id":"spn-48015","text":"In your client, run a simple cycle:"}]},{"id":"blk-42178","kind":"paragraph","spans":[{"id":"spn-48016","text":"1. "},{"id":"spn-48017","marks":["bold"],"text":"Store"}]},{"id":"blk-42179","items":[{"blocks":[{"id":"blk-42181","kind":"paragraph","spans":[{"id":"spn-48018","text":"Save one semantic fact via "},{"id":"spn-48019","marks":["code"],"text":"store_node"}]}],"id":"blk-42180","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42182","kind":"paragraph","spans":[{"id":"spn-48020","text":"2. "},{"id":"spn-48021","marks":["bold"],"text":"Retrieve"}]},{"id":"blk-42183","items":[{"blocks":[{"id":"blk-42185","kind":"paragraph","spans":[{"id":"spn-48022","text":"Query it with "},{"id":"spn-48023","marks":["code"],"text":"retrieve_context"}]}],"id":"blk-42184","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42186","kind":"paragraph","spans":[{"id":"spn-48024","text":"3. "},{"id":"spn-48025","marks":["bold"],"text":"Learn"}]},{"id":"blk-42187","items":[{"blocks":[{"id":"blk-42189","kind":"paragraph","spans":[{"id":"spn-48026","text":"Report outcome with "},{"id":"spn-48027","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-48028","text":" using returned causal IDs"}]}],"id":"blk-42188","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42190","kind":"para