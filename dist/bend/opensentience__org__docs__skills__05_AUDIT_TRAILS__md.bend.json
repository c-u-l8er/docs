{"bendscript":"0.1","blocks":[{"id":"blk-49411","kind":"heading","level":1,"spans":[{"id":"spn-56291","text":"Skill 05 — Audit Trails"}]},{"blocks":[{"id":"blk-49413","kind":"paragraph","spans":[{"id":"spn-56292","text":"Append-only audit system: entry schema, event types, querying, compliance, and forensic reconstruction."}]}],"id":"blk-49412","kind":"quote"},{"id":"blk-49414","kind":"paragraph","spans":[{"id":"spn-56293","text":"---"}]},{"id":"blk-49415","kind":"heading","level":2,"spans":[{"id":"spn-56294","text":"Why This Matters"}]},{"id":"blk-49416","kind":"paragraph","spans":[{"id":"spn-56295","text":"The audit trail is the immutable record of everything that happened under governance. Without it, you have no evidence of what agents did, what was blocked, or why autonomy levels changed. The audit trail serves compliance, debugging, and trust verification."}]},{"id":"blk-49417","kind":"paragraph","spans":[{"id":"spn-56296","text":"---"}]},{"id":"blk-49418","kind":"heading","level":2,"spans":[{"id":"spn-56297","text":"Audit Entry Schema"}]},{"id":"blk-49419","kind":"paragraph","spans":[{"id":"spn-56298","text":"Every audit entry contains these fields:"}]},{"head":[{"id":"blk-49421","spans":[{"id":"spn-56299","text":"Field"}]},{"id":"blk-49422","spans":[{"id":"spn-56300","text":"Type"}]},{"id":"blk-49423","spans":[{"id":"spn-56301","text":"Description"}]}],"id":"blk-49420","kind":"table","rows":[[{"id":"blk-49424","spans":[{"id":"spn-56302","marks":["code"],"text":"id"}]},{"id":"blk-49425","spans":[{"id":"spn-56303","text":"string"}]},{"id":"blk-49426","spans":[{"id":"spn-56304","text":"Unique identifier (UUID or ULID)"}]}],[{"id":"blk-49427","spans":[{"id":"spn-56305","marks":["code"],"text":"timestamp"}]},{"id":"blk-49428","spans":[{"id":"spn-56306","text":"datetime"}]},{"id":"blk-49429","spans":[{"id":"spn-56307","text":"When the event occurred (UTC)"}]}],[{"id":"blk-49430","spans":[{"id":"spn-56308","marks":["code"],"text":"agent_id"}]},{"id":"blk-49431","spans":[{"id":"spn-56309","text":"string"}]},{"id":"blk-49432","spans":[{"id":"spn-56310","text":"Which agent this event belongs to"}]}],[{"id":"blk-49433","spans":[{"id":"spn-56311","marks":["code"],"text":"event_type"}]},{"id":"blk-49434","spans":[{"id":"spn-56312","text":"string"}]},{"id":"blk-49435","spans":[{"id":"spn-56313","text":"Category of event (see below)"}]}],[{"id":"blk-49436","spans":[{"id":"spn-56314","marks":["code"],"text":"operation"}]},{"id":"blk-49437","spans":[{"id":"spn-56315","text":"string"}]},{"id":"blk-49438","spans":[{"id":"spn-56316","text":"Human-readable description of what happened"}]}],[{"id":"blk-49439","spans":[{"id":"spn-56317","marks":["code"],"text":"result"}]},{"id":"blk-49440","spans":[{"id":"spn-56318","text":"string"}]},{"id":"blk-49441","spans":[{"id":"spn-56319","text":"Outcome: "},{"id":"spn-56320","marks":["code"],"text":"ok"},{"id":"spn-56321","text":", "},{"id":"spn-56322","marks":["code"],"text":"denied"},{"id":"spn-56323","text":", "},{"id":"spn-56324","marks":["code"],"text":"error"},{"id":"spn-56325","text":", "},{"id":"spn-56326","marks":["code"],"text":"blocked"}]}],[{"id":"blk-49442","spans":[{"id":"spn-56327","marks":["code"],"text":"actor"}]},{"id":"blk-49443","spans":[{"id":"spn-56328","text":"string"}]},{"id":"blk-49444","spans":[{"id":"spn-56329","text":"Who triggered this: "},{"id":"spn-56330","marks":["code"],"text":"system"},{"id":"spn-56331","text":", "},{"id":"spn-56332","marks":["code"],"text":"operator"},{"id":"spn-56333","text":", agent_id"}]}],[{"id":"blk-49445","spans":[{"id":"spn-56334","marks":["code"],"text":"reason"}]},{"id":"blk-49446","spans":[{"id":"spn-56335","text":"string"}]},{"id":"blk-49447","spans":[{"id":"spn-56336","text":"Why this happened (permission rule, policy, operator note)"}]}],[{"id":"blk-49448","spans":[{"id":"spn-56337","marks":["code"],"text":"metadata"}]},{"id":"blk-49449","spans":[{"id":"spn-56338","text":"map"}]},{"id":"blk-49450","spans":[{"id":"spn-56339","text":"Structured additional data (varies by event type)"}]}]]},{"id":"blk-49451","kind":"paragraph","spans":[{"id":"spn-56340","text":"---"}]},{"id":"blk-49452","kind":"heading","level":2,"spans":[{"id":"spn-56341","text":"Event Types"}]},{"head":[{"id":"blk-49454","spans":[{"id":"spn-56342","text":"Event Type"}]},{"id":"blk-49455","spans":[{"id":"spn-56343","text":"When It Fires"}]},{"id":"blk-49456","spans":[{"id":"spn-56344","text":"Example Operation"}]}],"id":"blk-49453","kind":"table","rows":[[{"id":"blk-49457","spans":[{"id":"spn-56345","marks":["code"],"text":"permission_check"}]},{"id":"blk-49458","spans":[{"id":"spn-56346","text":"Every permission evaluation"}]},{"id":"blk-49459","spans":[{"id":"spn-56347","marks":["code"],"text":"filesystem:read:/data/input.csv"}]}],[{"id":"blk-49460","spans":[{"id":"spn-56348","marks":["code"],"text":"lifecycle_transition"}]},{"id":"blk-49461","spans":[{"id":"spn-56349","text":"Agent state changes"}]},{"id":"blk-49462","spans":[{"id":"spn-56350","marks":["code"],"text":"installed -> enabled"}]}],[{"id":"blk-49463","spans":[{"id":"spn-56351","marks":["code"],"text":"autonomy_change"}]},{"id":"blk-49464","spans":[{"id":"spn-56352","text":"Autonomy level is modified"}]},{"id":"blk-49465","spans":[{"id":"spn-56353","marks":["code"],"text":"observe -> advise"}]}],[{"id":"blk-49466","spans":[{"id":"spn-56354","marks":["code"],"text":"action_executed"}]},{"id":"blk-49467","spans":[{"id":"spn-56355","text":"Agent successfully performs an action (act mode)"}]},{"id":"blk-49468","spans":[{"id":"spn-56356","marks":["code"],"text":"wrote file /data/output.csv"}]}],[{"id":"blk-49469","spans":[{"id":"spn-56357","marks":["code"],"text":"action_blocked"}]},{"id":"blk-49470","spans":[{"id":"spn-56358","text":"Agent action denied by permission or autonomy"}]},{"id":"blk-49471","spans":[{"id":"spn-56359","marks":["code"],"text":"network:outbound:evil.com denied"}]}],[{"id":"blk-49472","spans":[{"id":"spn-56360","marks":["code"],"text":"action_recommended"}]},{"id":"blk-49473","spans":[{"id":"spn-56361","text":"Agent recommendation logged (observe mode)"}]},{"id":"blk-49474","spans":[{"id":"spn-56362","marks":["code"],"text":"would write /data/output.csv"}]}]]},{"id":"blk-49475","kind":"paragraph","spans":[{"id":"spn-56363","text":"---"}]},{"id":"blk-49476","kind":"heading","level":2,"spans":[{"id":"spn-56364","text":"agent_audit Tool"}]},{"id":"blk-49477","kind":"heading","level":3,"spans":[{"id":"spn-56365","text":"Parameters"}]},{"head":[{"id":"blk-49479","spans":[{"id":"spn-56366","text":"Param"}]},{"id":"blk-49480","spans":[{"id":"spn-56367","text":"Required"}]},{"id":"blk-49481","spans":[{"id":"spn-56368","text":"Type"}]},{"id":"blk-49482","spans":[{"id":"spn-56369","text":"Description"}]}],"id":"blk-49478","kind":"table","rows":[[{"id":"blk-49483","spans":[{"id":"spn-56370","marks":["code"],"text":"agent_id"}]},{"id":"blk-49484","spans":[{"id":"spn-56371","text":"Yes"}]},{"id":"blk-49485","spans":[{"id":"spn-56372","text":"string"}]},{"id":"blk-49486","spans":[{"id":"spn-56373","text":"The agent to query"}]}],[{"id":"blk-49487","spans":[{"id":"spn-56374","marks":["code"],"text":"type"}]},{"id":"blk-49488","spans":[{"id":"spn-56375","text":"No"}]},{"id":"blk-49489","spans":[{"id":"spn-56376","text":"string"}]},{"id":"blk-49490","spans":[{"id":"spn-56377","text":"Filter by event_type"}]}],[{"id":"blk-49491","spans":[{"id":"spn-56378","marks":["code"],"text":"since"}]},{"id":"blk-49492","spans":[{"id":"spn-56379","text":"No"}]},{"id":"blk-49493","spans":[{"id":"spn-56380","text":"datetime"}]},{"id":"blk-49494","spans":[{"id":"spn-56381","text":"Only entries after this timestamp"}]}],[{"id":"blk-49495","spans":[{"id":"spn-56382","marks":["code"],"text":"limit"}]},{"id":"blk-49496","spans":[{"id":"spn-56383","text":"No"}]},{"id":"blk-49497","spans":[{"id":"spn-56384","text":"number"}]},{"id":"blk-49498","spans":[{"id":"spn-56385","text":"Maximum entries to return (default 50)"}]}]]},{"id":"blk-49499","kind":"heading","level":3,"spans":[{"id":"spn-56386","text":"Example Calls"}]},{"id":"blk-49500","kind":"paragraph","spans":[{"id":"spn-56387","marks":["bold"],"text":"All recent events for an agent:"}]},{"id":"blk-49501","kind":"code","language":"text","text":"agent_audit(agent_id: \"my-worker\", limit: 20)"},{"id":"blk-49502","kind":"paragraph","spans":[{"id":"spn-56388","marks":["bold"],"text":"Only permission denials:"}]},{"id":"blk-49503","kind":"code","language":"text","text":"agent_audit(agent_id: \"my-worker\", type: \"permission_check\", limit: 50)\n# Then filter results where result = \"denied\""},{"id":"blk-49504","kind":"paragraph","spans":[{"id":"spn-56389","marks":["bold"],"text":"Events since a specific time:"}]},{"id":"blk-49505","kind":"code","language":"text","text":"agent_audit(agent_id: \"my-worker\", since: \"2026-01-15T10:00:00Z\")"},{"id":"blk-49506","kind":"paragraph","spans":[{"id":"spn-56390","marks":["bold"],"text":"Lifecycle history:"}]},{"id":"blk-49507","kind":"code","language":"text","text":"agent_audit(agent_id: \"my-worker\", type: \"lifecycle_transition\")"},{"id":"blk-49508","kind":"paragraph","spans":[{"id":"spn-56391","text":"---"}]},{"id":"blk-49509","kind":"heading","level":2,"spans":[{"id":"spn-56392","text":"Compliance Workflows"}]},{"id":"blk-49510","kind":"heading","level":3,"spans":[{"id":"spn-56393","text":"Pre-Deployment Audit"}]},{"id":"blk-49511","kind":"paragraph","spans":[{"id":"spn-56394","text":"Before promoting an agent to "},{"id":"spn-56395","marks":["code"],"text":"act"},{"id":"spn-56396","text":" autonomy:"}]},{"id":"blk-49512","kind":"paragraph","spans":[{"id":"spn-56397","text":"1. Query all "},{"id":"spn-56398","marks":["code"],"text":"action_recommended"},{"id":"spn-56399","text":" entries from the "},{"id":"spn-56400","marks":["code"],"text":"observe"},{"id":"spn-56401","text":" period 2. Verify recommendations align with expected behavior 3. Check for any "},{"id":"spn-56402","marks":["code"],"text":"permission_check"},{"id":"spn-56403","text":" denials that indicate scope misconfiguration 4. Document the review in the autonomy change reason"}]},{"id":"blk-49513","kind":"heading","level":3,"spans":[{"id":"spn-56404","text":"Incident Response"}]},{"id":"blk-49514","kind":"paragraph","spans":[{"id":"spn-56405","text":"When an agent produces unexpected behavior:"}]},{"id":"blk-49515","kind":"paragraph","spans":[{"id":"spn-56406","text":"1. Query the audit trail for the time window of the incident 2. Identify the sequence: permission check, autonomy check, action execution 3. Determine whether the action was within granted permissions 4. Check whether the autonomy level was appropriate 5. Review the metadata for contextual details"}]},{"id":"blk-49516","kind":"heading","level":3,"spans":[{"id":"spn-56407","text":"Periodic Review"}]},{"id":"blk-49517","kind":"paragraph","spans":[{"id":"spn-56408","text":"For ongoing compliance:"}]},{"id":"blk-49518","kind":"paragraph","spans":[{"id":"spn-56409","text":"1. Aggregate "},{"id":"spn-56410","marks":["code"],"text":"action_blocked"},{"id":"spn-56411","text":" counts per agent per week 2. High block counts may indicate overly broad agent scope 3. Zero block counts on a highly active agent may indicate overly permissive grants 4. Review "},{"id":"spn-56412","marks":["code"],"text":"autonomy_change"},{"id":"spn-56413","text":" entries for unexpected demotions or promotions"}]},{"id":"blk-49519","kind":"paragraph","spans":[{"id":"spn-56414","text":"---"}]},{"id":"blk-49520","kind":"heading","level":2,"spans":[{"id":"spn-56415","text":"Forensic Reconstruction"}]},{"id":"blk-49521","kind":"paragraph","spans":[{"id":"spn-56416","text":"The audit trail enables full reconstruction of an agent's actions:"}]},{"id":"blk-49522","kind":"code","language":"text","text":"Timeline for agent \"my-worker\":\n\n10:30:00 lifecycle_transition  installed -> enabled       actor: operator\n10:30:01 autonomy_change       (none) -> observe          actor: system\n10:30:05 permission_check      filesystem:read:/data/**   result: ok\n10:30:06 action_recommended    read /data/input.csv       result: logged\n10:35:00 autonomy_change       observe -> advise          actor: operator\n10:35:10 permission_check      filesystem:read:/data/**   result: ok\n10:35:11 action_executed       read /data/input.csv       result: ok (approved)\n10:40:00 permission_check      network:outbound:evil.com  result: denied\n10:40:00 action_blocked        connect to evil.com        result: denied"},{"id":"blk-49523","kind":"paragraph","spans":[{"id":"spn-56417","text":"Every action has a chain of evidence: who triggered it, what permission was checked, what autonomy level was in effect, and what the outcome was."}]},{"id":"blk-49524","kind":"paragraph","spans":[{"id":"spn-56418","text":"---"}]},{"id":"blk-49525","kind":"heading","level":2,"spans":[{"id":"spn-56419","text":"Audit Storage Backends"}]},{"head":[{"id":"blk-49527","spans":[{"id":"spn-56420","text":"Backend"}]},{"id":"blk-49528","spans":[{"id":"spn-56421","text":"Persistence"}]},{"id":"blk-49529","spans":[{"id":"spn-56422","text":"Performance"}]},{"id":"blk-49530","spans":[{"id":"spn-56423","text":"Use Case"}]}],"id":"blk-49526","kind":"table","rows":[[{"id":"blk-49531","spans":[{"id":"spn-56424","text":"ETS"}]},{"id":"blk-49532","spans":[{"id":"spn-56425","text":"In-memory (lost on restart)"}]},{"id":"blk-49533","spans":[{"id":"spn-56426","text":"Fastest"}]},{"id":"blk-49534","spans":[{"id":"spn-56427","text":"Development, testing"}]}],[{"id":"blk-49535","spans":[{"id":"spn-56428","text":"File"}]},{"id":"blk-49536","spans":[{"id":"spn-56429","text":"Append-only log file"}]},{"id":"blk-49537","spans":[{"id":"spn-56430","text":"Fast writes, slow queries"}]},{"id":"blk-49538","spans":[{"id":"spn-56431","text":"Production with simple needs"}]}],[{"id":"blk-49539","spans":[{"id":"spn-56432","text":"Ecto"}]},{"id":"blk-49540","spans":[{"id":"spn-56433","text":"Database (Postgres, SQLite)"}]},{"id":"blk-49541","spans":[{"id":"spn-56434","text":"Indexed queries"}]},{"id":"blk-49542","spans":[{"id":"spn-56435","text":"Production with compliance requirements"}]}]]},{"id":"blk-49543","kind":"paragraph","spans":[{"id":"spn-56436","text":"The backend is configured at application startup. The AuditWriter GenServer abstracts the backend — callers do not need to know which is in use."}]},{"id":"blk-49544","kind":"paragraph","spans":[{"id":"spn-56437","text":"---"}]},{"id":"blk-49545","kind":"heading","level":2,"spans":[{"id":"spn-56438","text":"Immutability Guarantee"}]},{"id":"blk-49546","kind":"paragraph","spans":[{"id":"spn-56439","text":"Audit entries can only be appended. The AuditWriter API exposes no update or delete operations. This is enforced at the module level — there are no "},{"id":"spn-56440","marks":["code"],"text":"update_audit/2"},{"id":"spn-56441","text":" or "},{"id":"spn-56442","marks":["code"],"text":"delete_audit/1"},{"id":"spn-56443","text":" functions to call."}]},{"id":"blk-49547","kind":"paragraph","spans":[{"id":"spn-56444","text":"For the file backend, the log file is opened in append-only mode. For the Ecto backend, the migration creates the table without UPDATE or DELETE grants for the application role."}]},{"id":"blk-49548","kind":"paragraph","spans":[{"id":"spn-56445","text":"This immutability is a design requirement of OS-006, not an implementation detail that might change."}]}],"edges":[],"id":"bagaaierayise4yefistskwisy7hb3wsta6blcnonmm3gpbk7klewefysjybq","vocabulary":"ampersand.docs.fs.v1"}