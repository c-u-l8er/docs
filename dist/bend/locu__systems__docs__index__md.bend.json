{"bendscript":"0.1","blocks":[{"id":"blk-82402","kind":"heading","level":1,"spans":[{"id":"spn-146906","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-82404","kind":"paragraph","spans":[{"id":"spn-146907","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-82403","kind":"quote"},{"blocks":[{"id":"blk-82406","kind":"paragraph","spans":[{"id":"spn-146908","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-146909","text":" · "},{"id":"spn-146910","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-146911","text":" · "},{"id":"spn-146912","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-146913","text":" · "},{"id":"spn-146914","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-82405","kind":"quote"},{"id":"blk-82407","kind":"paragraph","spans":[{"id":"spn-146915","text":"Welcome to the documentation hub for "},{"id":"spn-146916","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-146917","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-82408","kind":"paragraph","spans":[{"id":"spn-146918","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-82409","items":[{"blocks":[{"id":"blk-82411","kind":"paragraph","spans":[{"id":"spn-146919","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-146920","text":" — create agents, deploy code bundles,"}]}],"id":"blk-82410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82412","kind":"paragraph","spans":[{"id":"spn-146921","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-82413","items":[{"blocks":[{"id":"blk-82415","kind":"paragraph","spans":[{"id":"spn-146922","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-146923","text":" — validate "},{"id":"spn-146924","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-82414","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82416","kind":"paragraph","spans":[{"id":"spn-146925","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-82417","kind":"paragraph","spans":[{"id":"spn-146926","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-82418","kind":"heading","level":2,"spans":[{"id":"spn-146927","text":"What you'll find here"}]},{"id":"blk-82419","items":[{"blocks":[{"id":"blk-82421","kind":"paragraph","spans":[{"id":"spn-146928","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-82420","kind":"list-item"},{"blocks":[{"id":"blk-82423","kind":"paragraph","spans":[{"id":"spn-146929","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-82422","kind":"list-item"},{"blocks":[{"id":"blk-82425","kind":"paragraph","spans":[{"id":"spn-146930","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-82424","kind":"list-item"},{"blocks":[{"id":"blk-82427","kind":"paragraph","spans":[{"id":"spn-146931","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-146932","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-82426","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82428","kind":"heading","level":2,"spans":[{"id":"spn-146933","text":"Quick Links"}]},{"head":[{"id":"blk-82430","spans":[{"id":"s