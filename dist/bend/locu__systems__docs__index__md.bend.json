lk-82520","kind":"paragraph","spans":[{"id":"spn-146983","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/skills/06_BILLING_AND_LIMITS.md"}],"text":"06_BILLING_AND_LIMITS"}]}],"id":"blk-82519","kind":"list-item"},{"blocks":[{"id":"blk-82522","kind":"paragraph","spans":[{"id":"spn-146984","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/skills/07_SECURITY_AND_SECRETS.md"}],"text":"07_SECURITY_AND_SECRETS"}]}],"id":"blk-82521","kind":"list-item"},{"blocks":[{"id":"blk-82524","kind":"paragraph","spans":[{"id":"spn-146985","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/skills/08_AMPERSAND_INTEGRATION.md"}],"text":"08_AMPERSAND_INTEGRATION"}]}],"id":"blk-82523","kind":"list-item"},{"blocks":[{"id":"blk-82526","kind":"paragraph","spans":[{"id":"spn-146986","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/skills/09_ANTI_PATTERNS.md"}],"text":"09_ANTI_PATTERNS"}]}],"id":"blk-82525","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82527","kind":"heading","level":2,"spans":[{"id":"spn-146987","text":"Suggested Reading Order"}]},{"id":"blk-82528","kind":"paragraph","spans":[{"id":"spn-146988","text":"If you're new to the project, follow this path:"}]},{"id":"blk-82529","items":[{"blocks":[{"id":"blk-82531","kind":"paragraph","spans":[{"id":"spn-146989","marks":["bold"],"text":"quickstart"},{"id":"spn-146990","text":" — local dev setup, first agent creation, verification"}]}],"id":"blk-82530","kind":"list-item"},{"blocks":[{"id":"blk-82533","kind":"paragraph","spans":[{"id":"spn-146991","marks":["bold"],"text":"architecture"},{"id":"spn-146992","text":" — control plane / data plane design, request flows, data model"}]}],"id":"blk-82532","kind":"list-item"},{"blocks":[{"id":"blk-82535","kind":"paragraph","spans":[{"id":"spn-146993","marks":["bold"],"text":"skills/SKILLS"},{"id":"spn-146994","text":" — skills registry and tool inventory"}]}],"id":"blk-82534","kind":"list-item"},{"blocks":[{"id":"blk-82537","kind":"paragraph","spans":[{"id":"spn-146995","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-146996","text":" — agent CRUD, status lifecycle, provider config"}]}],"id":"blk-82536","kind":"list-item"},{"blocks":[{"id":"blk-82539","kind":"paragraph","spans":[{"id":"spn-146997","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-146998","text":" — bundle upload, validation, immutable deployments"}]}],"id":"blk-82538","kind":"list-item"},{"blocks":[{"id":"blk-82541","kind":"paragraph","spans":[{"id":"spn-146999","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-147000","text":" — request/response shapes, auth, streaming"}]}],"id":"blk-82540","kind":"list-item"},{"blocks":[{"id":"blk-82543","kind":"paragraph","spans":[{"id":"spn-147001","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-147002","text":" — RPI abstraction, Cloudflare and AgentCore adapters"}]}],"id":"blk-82542","kind":"list-item"},{"blocks":[{"id":"blk-82545","kind":"paragraph","spans":[{"id":"spn-147003","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-147004","text":" — metrics schema, aggregation"}]}],"id":"blk-82544","kind":"list-item"},{"blocks":[{"id":"blk-82547","kind":"paragraph","spans":[{"id":"spn-147005","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-147006","text":" — subscription tiers, enforcement, checkout"}]}],"id":"blk-82546","kind":"list-item"},{"blocks":[{"id":"blk-82549","kind":"paragraph","spans":[{"id":"spn-147007","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-147008","text":" — RLS isolation, Vault secrets, audit"}]}],"id":"blk-82548","kind":"list-item"},{"blocks":[{"id":"blk-82551","kind":"paragraph","spans":[{"id":"spn-147009","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-147010","text":" — [&] manifests, MCP sidecars, A2A routing"}]}],"id":"blk-82550","kind":"list-item"},{"blocks":[{"id":"blk-82553","kind":"paragraph","spans":[{"id":"spn-147011","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-147012","text":" — common mistakes and how to avoid them"}]}],"id":"blk-82552","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-82554","kind":"paragraph","spans":[{"id":"spn-147013","text":"For "},{"id":"spn-147014","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-147015","text":", start at "},{"id":"spn-147016","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-147017","text":" and "},{"id":"spn-147018","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-147019","text":"."}]},{"id":"blk-82555","kind":"paragraph","spans":[{"id":"spn-147020","text":"For "},{"id":"spn-147021","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-147022","text":", start at "},{"id":"spn-147023","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-147024","text":" and the "},{"id":"spn-147025","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-147026","text":" spec."}]},{"id":"blk-82556","kind":"heading","level":2,"spans":[{"id":"spn-147027","text":"Core Concepts"}]},{"id":"blk-82557","kind":"heading","level":3,"spans":[{"id":"spn-147028","text":"Control Plane"}]},{"id":"blk-82558","kind":"paragraph","spans":[{"id":"spn-147029","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-82559","kind":"heading","level":3,"spans":[{"id":"spn-147030","text":"Data Plane"}]},{"id":"blk-82560","kind":"paragraph","spans":[{"id":"spn-147031","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-82562","spans":[{"id":"spn-147032","text":"Runtime"}]},{"id":"blk-82563","spans":[{"id":"spn-147033","text":"Strengths"}]},{"id":"blk-82564","spans":[{"id":"spn-147034","text":"Best for"}]}],"id":"blk-82561","kind":"table","rows":[[{"id":"blk-82565","spans":[{"id":"spn-147035","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-82566","spans":[{"id":"spn-147036","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-82567","spans":[{"id":"spn-147037","text":"Most agents (default)"}]}],[{"id":"blk-82568","spans":[{"id":"spn-147038","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-82569","spans":[{"id":"spn-147039","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-82570","spans":[{"id":"spn-147040","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-82571","kind":"heading","level":3,"spans":[{"id":"spn-147041","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-82572","kind":"paragraph","spans":[{"id":"spn-147042","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-82573","kind":"heading","level":3,"spans":[{"id":"spn-147043","text":"Deployment Immutability"}]},{"id":"blk-82574","kind":"paragraph","spans":[{"id":"spn-147044","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-82575","kind":"heading","level":3,"spans":[{"id":"spn-147045","text":"Metered Telemetry"}]},{"id":"blk-82576","kind":"paragraph","spans":[{"id":"spn-147046","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-82577","kind":"heading","level":2,"spans":[{"id":"spn-147047","text":"Core Idea"}]},{"id":"blk-82578","kind":"paragraph","spans":[{"id":"spn-147048","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-82580","kind":"paragraph","spans":[{"id":"spn-147049","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-82579","kind":"quote"},{"id":"blk-82581","kind":"paragraph","spans":[{"id":"spn-147050","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-147051","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-147052","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-82582","kind":"heading","level":2,"spans":[{"id":"spn-147053","text":"Spec References"}]},{"id":"blk-82583","kind":"paragraph","spans":[{"id":"spn-147054","text":"The authoritative engineering spec lives in "},{"id":"spn-147055","marks":["code"],"text":"docs/spec/"},{"id":"spn-147056","text":":"}]},{"id":"blk-82584","items":[{"blocks":[{"id":"blk-82586","kind":"paragraph","spans":[{"id":"spn-147057","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-82585","kind":"list-item"},{"blocks":[{"id":"blk-82588","kind":"paragraph","spans":[{"id":"spn-147058","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-82587","kind":"list-item"},{"blocks":[{"id":"blk-82590","kind":"paragraph","spans":[{"id":"spn-147059","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-82589","kind":"list-item"},{"blocks":[{"id":"blk-82592","kind":"paragraph","spans":[{"id":"spn-147060","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"blk-82591","kind":"list-item"},{"blocks":[{"id":"blk-82594","kind":"paragraph","spans":[{"id":"spn-147061","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/30_DATA_MODEL_SUPABASE.md"}],"text":"30 — Data Model (Supabase/PostgreSQL) & Access Control"}]}],"id":"blk-82593","kind":"list-item"},{"blocks":[{"id":"blk-82596","kind":"paragraph","spans":[{"id":"spn-147062","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}],"text":"40 — Security, Secrets, and Compliance"}]}],"id":"blk-82595","kind":"list-item"},{"blocks":[{"id":"blk-82598","kind":"paragraph","spans":[{"id":"spn-147063","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}],"text":"50 — Observability, Metering, Cost, Tiers, and Limit Enforcement"}]}],"id":"blk-82597","kind":"list-item"},{"blocks":[{"id":"blk-82600","kind":"paragraph","spans":[{"id":"spn-147064","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/60_TESTING_ACCEPTANCE.md"}],"text":"60 — Testing Plan & Acceptance Criteria"}]}],"id":"blk-82599","kind":"list-item"},{"blocks":[{"id":"blk-82602","kind":"paragraph","spans":[{"id":"spn-147065","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/70_AMPERSAND_PROTOCOL_INTEGRATION.md"}],"text":"70 — Ampersand Protocol Integration"}]}],"id":"blk-82601","kind":"list-item"},{"blocks":[{"id":"blk-82604","kind":"paragraph","spans":[{"id":"spn-147066","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/REALIGNMENT_PLAN.md"}],"text":"Spec-to-Implementation Realignment Plan"}]}],"id":"blk-82603","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82605","kind":"heading","level":3,"spans":[{"id":"spn-147067","text":"Architecture decision records"}]},{"id":"blk-82606","items":[{"b