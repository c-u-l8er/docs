{"bendscript":"0.1","blocks":[{"id":"blk-33046","kind":"heading","level":1,"spans":[{"id":"spn-35658","text":"ADR-0007: Tier Entitlements, Runtime Gating, and Limit Enforcement Strategy"}]},{"id":"blk-33047","kind":"paragraph","spans":[{"id":"spn-35659","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-33048","items":[{"blocks":[{"id":"blk-33050","kind":"paragraph","spans":[{"id":"spn-35660","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-33049","kind":"list-item"},{"blocks":[{"id":"blk-33052","kind":"paragraph","spans":[{"id":"spn-35661","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-33051","kind":"list-item"},{"blocks":[{"id":"blk-33054","kind":"paragraph","spans":[{"id":"spn-35662","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-33053","kind":"list-item"},{"blocks":[{"id":"blk-33056","kind":"paragraph","spans":[{"id":"spn-35663","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-33055","kind":"list-item"},{"blocks":[{"id":"blk-33058","kind":"paragraph","spans":[{"id":"spn-35664","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-33057","kind":"list-item"},{"blocks":[{"id":"blk-33060","kind":"paragraph","spans":[{"id":"spn-35665","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-33059","kind":"list-item"},{"blocks":[{"id":"blk-33062","kind":"paragraph","spans":[{"id":"spn-35666","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-33061","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33063","kind":"heading","level":2,"spans":[{"id":"spn-35667","text":"1) Context"}]},{"id":"blk-33064","kind":"paragraph","spans":[{"id":"spn-35668","text":"webhost.systems is a multi-runtime AI agent platform. The control plane must:"}]},{"id":"blk-33065","items":[{"blocks":[{"id":"blk-33067","kind":"paragraph","spans":[{"id":"spn-35669","text":"monetize via subscription tiers,"}]}],"id":"blk-33066","kind":"list-item"},{"blocks":[{"id":"blk-33069","kind":"paragraph","spans":[{"id":"spn-35670","text":"enforce tenant entitlements and limits in a way that protects platform cost exposure,"}]}],"id":"blk-33068","kind":"list-item"},{"blocks":[{"id":"blk-33071","kind":"paragraph","spans":[{"id":"spn-35671","text":"gate access to premium runtime providers (AWS Bedrock AgentCore),"}]}],"id":"blk-33070","kind":"list-item"},{"blocks":[{"id":"blk-33073","kind":"paragraph","spans":[{"id":"spn-35672","text":"provide predictable, explainable behavior to users and support."}]}],"id":"blk-33072","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33074","kind":"paragraph","spans":[{"id":"spn-35673","text":"The platform has heterogeneous cost profiles by runtime:"}]},{"id":"blk-33075","items":[{"blocks":[{"id":"blk-33077","kind":"paragraph","spans":[{"id":"spn-35674","marks":["bold"],"text":"Cloudflare Workers/DO"},{"id":"spn-35675","text":" supports a broad set of use cases with favorable economics and global edge distribution, enabling acquisition tiers (including free)."}]}],"id":"blk-33076","kind":"list-item"},{"blocks":[{"id":"blk-33079","kind":"paragraph","spans":[{"id":"spn-35676","text":"TypeScript-first: Workers/DO are TypeScript-friendly and support modern agent frameworks naturally."}]}],"id":"blk-33078","kind":"list-item"},{"blocks":[{"id":"blk-33081","kind":"paragraph","spans":[{"id":"spn-35677","marks":["bold"],"text":"AWS Bedrock AgentCore"},{"id":"spn-35678","text":" supports premium enterprise capabilities (long running sessions, stronger isolation, built-in tools), but has higher marginal cost and different operational constraints."}]}],"id":"blk-33080","kind":"list-item"},{"blocks":[{"id":"blk-33083","kind":"paragraph","spans":[{"id":"spn-35679","text":"TypeScript-first: AgentCore has first-class TypeScript SDK support for runtime operations and modern tooling integration:"}]}],"id":"blk-33082","kind":"list-item"},{"blocks":[{"id":"blk-33085","kind":"paragraph","spans":[{"id":"spn-35680","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-35681","text":" (TypeScript) for management and invocation"}]}],"id":"blk-33084","kind":"list-item"},{"blocks":[{"id":"blk-33087","kind":"paragraph","spans":[{"id":"spn-35682","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-35683","text":" (TypeScript) for built-in tools (e.g., Code Interpreter and Browser), with integration paths for modern agent frameworks (e.g., Vercel AI SDK)"}]}],"id":"blk-33086","kind":"list-item"},{"blocks":[{"id":"blk-33089","kind":"paragraph","spans":[{"id":"spn-35684","text":"Premium value drivers beyond runtime length:"}]}],"id":"blk-33088","kind":"list-item"},{"blocks":[{"id":"blk-33091","kind":"paragraph","spans":[{"id":"spn-35685","text":"built-in tool ecosystem (code execution + browser automation) that is otherwise “DIY” on many runtimes"}]}],"id":"blk-33090","kind":"list-item"},{"blocks":[{"id":"blk-33093","kind":"paragraph","spans":[{"id":"spn-35686","text":"enterprise isolation posture aligned with higher-tier requirements"}]}],"id":"blk-33092","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33094","kind":"paragraph","spans":[{"id":"spn-35687","text":"Limits are required for:"}]},{"id":"blk-33095","items":[{"blocks":[{"id":"blk-33097","kind":"paragraph","spans":[{"id":"spn-35688","text":"preventing runaway cost and abuse,"}]}],"id":"blk-33096","kind":"list-item"},{"blocks":[{"id":"blk-33099","kind":"paragraph","spans":[{"id":"spn-35689","text":"ensuring fairness and QoS,"}]}],"id":"blk-33098","kind":"list-item"},{"blocks":[{"id":"blk-33101","kind":"paragraph","spans":[{"id":"spn-35690","text":"aligning tier pricing with usage."}]}],"id":"blk-33100","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33102","kind":"paragraph","spans":[{"id":"spn-35691","text":"Key constraints:"}]},{"id":"blk-33103","items":[{"blocks":[{"id":"blk-33105","kind":"paragraph","spans":[{"id":"spn-35692","text":"Actual token usage and compute time are not known until after the invocation completes."}]}],"id":"blk-33104","kind":"list-item"},{"blocks":[{"id":"blk-33107","kind":"paragraph","spans":[{"id":"spn-35693","text":"Telemetry ingestion is asynchronous and may be delayed or fail transiently."}]}],"id":"blk-33106","kind":"list-item"},{"blocks":[{"id":"blk-33109","kind":"paragraph","spans":[{"id":"spn-35694","text":"Concurrency (multiple simultaneous invocations) can race around limit boundaries."}]}],"id":"blk-33108","kind":"list-item"},{"blocks":[{"id":"blk-33111","kind":"paragraph","spans":[{"id":"spn-35695","text":"Security requirements prohibit relying on client-provided usage or tier claims."}]}],"id":"blk-33110","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33112","kind":"paragraph","spans":[{"id":"spn-35696","text":"Therefore, v1 needs a robust entitlement model and a limit enforcement strategy that is safe, implementable, and extensible."}]},{"id":"blk-33113","kind":"heading","level":2,"spans":[{"id":"spn-35697","text":"2) Decision"}]},{"id":"blk-33114","kind":"heading","level":3,"spans":[{"id":"spn-35698","text":"2.1 Adopt a configuration-driven entitlement model (server authoritative)"}]},{"id":"blk-33115","kind":"paragraph","spans":[{"id":"spn-35699","text":"Entitlements are represented as a server-side configuration mapping a user’s current tier to a set of allowed capabilities and budgets. Entitlements MUST be treated as "},{"id":"spn-35700","marks":["bold"],"text":"authoritative"},{"id":"spn-35701","text":" on the server; the client/UI is advisory only."}]},{"id":"blk-33116","kind":"paragraph","spans":[{"id":"spn-35702","text":"Each tier defines (minimum):"}]},{"id":"blk-33117","items":[{"blocks":[{"id":"blk-33119","kind":"paragraph","spans":[{"id":"spn-35703","marks":["code"],"text":"maxRequestsPerPeriod"}]}],"id":"blk-33118","kind":"list-item"},{"blocks":[{"id":"blk-33121","kind":"paragraph","spans":[{"id":"spn-35704","marks":["code"],"text":"maxTokensPerPeriod"},{"id":"spn-35705","text":" (reported or estimated)"}]}],"id":"blk-33120","kind":"list-item"},{"blocks":[{"id":"blk-33123","kind":"paragraph","spans":[{"id":"spn-35706","marks":["code"],"text":"maxComputeMsPerPeriod"}]}],"id":"blk-33122","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33124","kind":"paragraph","spans":[{"id":"spn-35707","text":"Runtime access + capabilities:"}]},{"id":"blk-33125","items":[{"blocks":[{"id":"blk-33127","kind":"paragraph","spans":[{"id":"spn-35708","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-35709","text":" (boolean) — whether the user may deploy/invoke on AgentCore at all"}]}],"id":"blk-33126","kind":"list-item"},{"blocks":[{"id":"blk-33129","kind":"paragraph","spans":[{"id":"spn-35710","marks":["code"],"text":"memoryEnabled"},{"id":"spn-35711","text":" (boolean) — whether AgentCore Memory features may be enabled for deployments"}]}],"id":"blk-33128","kind":"list-item"},{"blocks":[{"id":"blk-33131","kind":"paragraph","spans":[{"id":"spn-35712","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-35713","text":" (boolean) — whether AgentCore Code Interpreter tools may be enabled for deployments"}]}],"id":"blk-33130","kind":"list-item"},{"blocks":[{"id":"blk-33133","kind":"paragraph","spans":[{"id":"spn-35714","marks":["code"],"text":"browserEnabled"},{"id":"spn-35715","text":" (boolean) — whether AgentCore Browser tools may be enabled for deployments"}]}],"id":"blk-33132","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33134","kind":"paragraph","spans":[{"id":"spn-35716","text":"Tool quotas (only meaningful if tools are enabled; omitted or set to 0 when disabled):"}]},{"id":"blk-33135","items":[{"blocks":[{"id":"blk-33137","kind":"paragraph","spans":[{"id":"spn-35717","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-35718","text":" (number, optional)"}]}],"id":"blk-33136","kind":"list-item"},{"blocks":[{"id":"blk-33139","kind":"paragraph","spans":[{"id":"spn-35719","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-35720","text":" (number, optional)"}]}],"id":"blk-33138","kind":"list-item"},{"blocks":[{"id":"blk-33141","kind":"paragraph","spans":[{"id":"spn-35721","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-35722","text":" (number, optional)"}]}],"id":"blk-33140","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33142","kind":"paragraph","spans":[{"id":"spn-35723","text":"Retention policies:"}]},{"id":"blk-33143","items":[{"blocks":[{"id":"blk-33145","kind":"paragraph","spans":[{"id":"spn-35724","text":"telemetry/logs retention days"}]}],"id":"blk-33144","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33146","kind":"paragraph","spans":[{"id":"spn-35725","text":"Entitlements MUST be stored and evaluated in a way that can be changed without code edits (e.g., configuration file/env, DB table, or feature flag system). Exact storage choice is implementation detail, but it MUST be server-controlled and auditable."}]},{"id":"blk-33147","kind":"heading","level":3,"spans":[{"id":"spn-35726","text":"2.2 Tier gating rules: runtime access is an entitlement (defense in depth)"}]},{"id":"blk-33148","kind":"paragraph","spans":[{"id":"spn-35727","text":"Runtime access is gated by entitlements:"}]},{"id":"blk-33149","items":[{"blocks":[{"id":"blk-33151","kind":"paragraph","spans":[{"id":"spn-35728","text":"If "},{"id":"spn-35729","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-35730","text":", then:"}]}],"id":"blk-33150","kind":"list-item"},{"blocks":[{"id":"blk-33153","kind":"paragraph","spans":[{"id":"spn-35731","text":"deploy to "},{"id":"spn-35732","marks":["code"],"text":"runtimeProvider=agentcore"},{"id":"spn-35733","text":" MUST be rejected, and"}]}],"id":"blk-33152","kind":"list-item"},{"blocks":[{"id":"blk-33155","kind":"paragraph","spans":[{"id":"spn-35734","text":"invoke routed to an AgentCore deployment MUST be rejected, and"}]}],"id":"blk-33154","kind":"list-item"},{"blocks":[{"id":"blk-33157","kind":"paragraph","spans":[{"id":"spn-35735","text":"any attempt to switch an agent’s runtimeProvider to "},{"id":"spn-35736","marks":["code"],"text":"agentcore"},{"id":"spn-35737","text":" SHOULD be rejected (v1 recommendation: reject to reduce confusion)."}]}],"id":"blk-33156","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33158","items":[{"blocks":[{"id":"blk-33160","kind":"paragraph","spans":[{"id":"spn-35738","text":"If "},{"id":"spn-35739","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-35740","text":", AgentCore capability flags MUST still be enforced:"}]}],"id":"blk-33159","kind":"list-item"},{"blocks":[{"id":"blk-33162","kind":"paragraph","spans":[{"id":"spn-35741","text":"If "},{"id":"spn-35742","marks":["code"],"text":"codeInterpreterEnabled=false"},{"id":"spn-35743","text":", deployments MUST NOT enable code interpreter tooling, and invocations MUST be treated as “tools unavailable” (no tool loop) even if user code requests it."}]}],"id":"blk-33161","kind":"list-item"},{"blocks":[{"id":"blk-33164","kind":"paragraph","spans":[{"id":"spn-35744","text":"If "},{"id":"spn-35745","marks":["code"],"text":"browserEnabled=false"},{"id":"spn-35746","text":", deployments MUST NOT enable browser tooling, and invocations MUST be treated as “tools unavailable” for browser interactions."}]}],"id":"blk-33163","kind":"list-item"},{"blocks":[{"id":"blk-33166","kind":"paragraph","spans":[{"id":"spn-35747","text":"If "},{"id":"spn-35748","marks":["code"],"text":"memoryEnabled=false"},{"id":"spn-35749","text":", deployments MUST NOT enable provider memory features."}]}],"id":"blk-33165","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33167","kind":"paragraph","spans":[{"id":"spn-35750","marks":["bold"],"text":"v1 recommendation (tools): enterprise-only"}]},{"id":"blk-33168","items":[{"blocks":[{"id":"blk-33170","kind":"paragraph","spans":[{"id":"spn-35751","text":"v1 SHOULD enable AgentCore tools ("},{"id":"spn-35752","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-35753","text":" and "},{"id":"spn-35754","marks":["code"],"text":"browserEnabled"},{"id":"spn-35755","text":") only on the "},{"id":"spn-35756","marks":["code"],"text":"enterprise"},{"id":"spn-35757","text":" tier."}]}],"id":"blk-33169","kind":"list-item"},{"blocks":[{"id":"blk-33172","kind":"paragraph","spans":[{"id":"spn-35758","text":"v1 MAY allow "},{"id":"spn-35759","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-35760","text":" on "},{"id":"spn-35761","marks":["code"],"text":"pro"},{"id":"spn-35762","text":" while keeping tools disabled (and optionally allowing "},{"id":"spn-35763","marks":["code"],"text":"memoryEnabled=true"},{"id":"spn-35764","text":" if cost/behavior is acceptable)."}]}],"id":"blk-33171","kind":"list-item"},{"blocks":[{"id":"blk-33174","kind":"paragraph","spans":[{"id":"spn-35765","text":"If you later enable tools for "},{"id":"spn-35766","marks":["code"],"text":"pro"},{"id":"spn-35767","text":", you MUST add explicit tool quotas ("},{"id":"spn-35768","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-35769","text":", "},{"id":"spn-35770","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-35771","text":", "},{"id":"spn-35772","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-35773","text":") and enforce them at invoke time."}]}],"id":"blk-33173","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33175","kind":"paragraph","spans":[{"id":"spn-35774","text":"This gating MUST be enforced at three layers (defense in depth): 1. "},{"id":"spn-35775","marks":["bold"],"text":"UI layer"},{"id":"spn-35776","text":": hide/disable options (non-authoritative) 2. "},{"id":"spn-35777","marks":["bold"],"text":"Control plane deploy/invoke APIs"},{"id":"spn-35778","text":": authoritative check before provider calls 3. "},{"id":"spn-35779","marks":["bold"],"text":"Runtime adapter layer"},{"id":"spn-35780","text":": refuse deploy/invoke if not entitled (in case of misrouting or bugs)"}]},{"id":"blk-33176","kind":"paragraph","spans":[{"id":"spn-35781","text":"The same three-layer enforcement applies to "},{"id":"spn-35782","marks":["bold"],"text":"AgentCore capability flags"},{"id":"spn-35783","text":" ("},{"id":"spn-35784","marks":["code"],"text":"memoryEnabled"},{"id":"spn-35785","text":", "},{"id":"spn-35786","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-35787","text":", "},{"id":"spn-35788","marks":["code"],"text":"browserEnabled"},{"id":"spn-35789","text":"):"}]},{"id":"blk-33177","items":[{"blocks":[{"id":"blk-33179","kind":"paragraph","spans":[{"id":"spn-35790","text":"UI MUST not present toggles the user is not entitled to."}]}],"id":"blk-33178","kind":"list-item"},{"blocks":[{"id":"blk-33181","kind":"paragraph","spans":[{"id":"spn-35791","text":"Deploy APIs MUST reject configurations that attempt to enable disallowed capabilities."}]}],"id":"blk-33180","kind":"list-item"},{"blocks":[{"id":"blk-33183","kind":"paragraph","spans":[{"id":"spn-35792","text":"Invoke routing MUST ensure a deployment cannot exercise disallowed capabilities (even if user code attempts to)."}]}],"id":"blk-33182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33184","kind":"heading","level":3,"spans":[{"id":"spn-35793","text":"2.3 Limit enforcement strategy (v1): requests hard-stop + post-charge tokens/compute, with upgrade path to reservation"}]},{"id":"blk-33185","kind":"paragraph","spans":[{"id":"spn-35794","text":"v1 enforcement strategy is:"}]},{"id":"blk-33186","items":[{"blocks":[{"id":"blk-33188","kind":"paragraph","spans":[{"id":"spn-35795","marks":["bold"],"text":"Pre-invocation hard-stop on requests"},{"id":"spn-35796","text":" (MUST)."}]}],"id":"blk-33187","kind":"list-item"},{"blocks":[{"id":"blk-33190","kind":"paragraph","spans":[{"id":"spn-35797","marks":["bold"],"text":"Post-invocation accounting for tokens/compute"},{"id":"spn-35798","text":" via telemetry (MUST)."}]}],"id":"blk-33189","kind":"list-item"},{"blocks":[{"id":"blk-33192","kind":"paragraph","spans":[{"id":"spn-35799","marks":["bold"],"text":"Subsequent invocations blocked"},{"id":"spn-35800","text":" if tokens/compute budgets exceeded (MUST)."}]}],"id":"blk-33191","kind":"list-item"},{"blocks":[{"id":"blk-33194","kind":"paragraph","spans":[{"id":"spn-35801","marks":["bold"],"text":"Optional predictive reservation"},{"id":"spn-35802","text":" for expensive runtimes (SHOULD for AgentCore, MAY for Cloudflare) as an enhancement."}]}],"id":"blk-33193","kind":"list-item"},{"blocks":[{"id":"blk-33196","kind":"paragraph","spans":[{"id":"spn-35803","text":"AgentCore-specific note: because AgentCore can support longer-running workloads and built-in tools (code execution, browser automation), it may concentrate more cost into a single invocation. This makes reservation (or stricter pre-flight checks) more valuable for AgentCore tiers."}]}],"id":"blk-33195","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33197","kind":"paragraph","spans":[{"id":"spn-35804","text":"This is a deliberate v1 tradeoff:"}]},{"id":"blk-33198","items":[{"blocks":[{"id":"blk-33200","kind":"paragraph","spans":[{"id":"spn-35805","text":"It protects the platform from request floods (and thus most cost/abuse)."}]}],"id":"blk-33199","kind":"list-item"},{"blocks":[{"id":"blk-33202","kind":"paragraph","spans":[{"id":"spn-35806","text":"It keeps implementation complexity manageable while still meeting product needs."}]}],"id":"blk-33201","kind":"list-item"},{"blocks":[{"id":"blk-33204","kind":"paragraph","spans":[{"id":"spn-35807","text":"It provides a clear path to a stronger pre-reservation model without changing the external API."}]}],"id":"blk-33203","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33205","kind":"heading","level":3,"spans":[{"id":"spn-35808","text":"2.4 Enforcement point: invocation gateway is the primary cost-control boundary"}]},{"id":"blk-33206","kind":"paragraph","spans":[{"id":"spn-35809","text":"Limits MUST be enforced in the invocation gateway "},{"id":"spn-35810","marks":["bold"],"text":"before calling a runtime provider"},{"id":"spn-35811","text":" whenever possible. This prevents spending money on requests that will be rejected."}]},{"id":"blk-33207","kind":"paragraph","spans":[{"id":"spn-35812","text":"For v1:"}]},{"id":"blk-33208","items":[{"blocks":[{"id":"blk-33210","kind":"paragraph","spans":[{"id":"spn-35813","text":"Request count enforcement MUST happen before provider invocation."}]}],"id":"blk-33209","kind":"list-item"},{"blocks":[{"id":"blk-33212","kind":"paragraph","spans":[{"id":"spn-35814","text":"Token/compute enforcement MAY lag by up to telemetry ingestion delay; when exceeded, block subsequent requests."}]}],"id":"blk-33211","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33213","kind":"heading","level":3,"spans":[{"id":"spn-35815","text":"2.5 Consistent error semantics"}]},{"id":"blk-33214","kind":"paragraph","spans":[{"id":"spn-35816","text":"When a deploy or invoke is rejected due to entitlements or limits, the system MUST return a normalized error envelope with:"}]},{"id":"blk-33215","items":[{"blocks":[{"id":"blk-33217","kind":"paragraph","spans":[{"id":"spn-35817","marks":["code"],"text":"code = LIMIT_EXCEEDED"},{"id":"spn-35818","text":" (or a dedicated entitlement code if added later),"}]}],"id":"blk-33216","kind":"list-item"},{"blocks":[{"id":"blk-33219","kind":"paragraph","spans":[{"id":"spn-35819","text":"a safe user-displayable message,"}]}],"id":"blk-33218","kind":"list-item"},{"blocks":[{"id":"blk-33221","kind":"paragraph","spans":[{"id":"spn-35820","text":"details including:"}]}],"id":"blk-33220","kind":"list-item"},{"blocks":[{"id":"blk-33223","kind":"paragraph","spans":[{"id":"spn-35821","text":"limit type ("},{"id":"spn-35822","marks":["code"],"text":"requests"},{"id":"spn-35823","text":", "},{"id":"spn-35824","marks":["code"],"text":"tokens"},{"id":"spn-35825","text":", "},{"id":"spn-35826","marks":["code"],"text":"computeMs"},{"id":"spn-35827","text":", or "},{"id":"spn-35828","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-35829","text":" / "},{"id":"spn-35830","marks":["code"],"text":"runtimeGated"},{"id":"spn-35831","text":"),"}]}],"id":"blk-33222","kind":"list-item"},{"blocks":[{"id":"blk-33225","kind":"paragraph","spans":[{"id":"spn-35832","text":"period key,"}]}],"id":"blk-33224","kind":"list-item"},{"blocks":[{"id":"blk-33227","kind":"paragraph","spans":[{"id":"spn-35833","text":"current usage and limit where known,"}]}],"id":"blk-33226","kind":"list-item"},{"blocks":[{"id":"blk-33229","kind":"paragraph","spans":[{"id":"spn-35834","text":"suggested action (upgrade tier)."}]}],"id":"blk-33228","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33230","kind":"paragraph","spans":[{"id":"spn-35835","text":"HTTP status mapping is defined in "},{"id":"spn-35836","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-35837","text":"."}]},{"id":"blk-33231","kind":"heading","level":2,"spans":[{"id":"spn-35838","text":"3) Rationale"}]},{"id":"blk-33232","kind":"heading","level":3,"spans":[{"id":"spn-35839","text":"3.1 Why configuration-driven entitlements"}]},{"id":"blk-33233","items":[{"blocks":[{"id":"blk-33235","kind":"paragraph","spans":[{"id":"spn-35840","text":"Pricing and tiers will iterate frequently; hardcoding makes iteration risky and slow."}]}],"id":"blk-33234","kind":"list-item"},{"blocks":[{"id":"blk-33237","kind":"paragraph","spans":[{"id":"spn-35841","text":"Entitlements must be authoritative and auditable, independent of client behavior."}]}],"id":"blk-33236","kind":"list-item"},{"blocks":[{"id":"blk-33239","kind":"paragraph","spans":[{"id":"spn-35842","text":"A single entitlements surface simplifies UI gating, API checks, and support tooling."}]}],"id":"blk-33238","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33240","kind":"heading","level":3,"spans":[{"id":"spn-35843","text":"3.2 Why runtime gating is mandatory"}]},{"id":"blk-33241","items":[{"blocks":[{"id":"blk-33243","kind":"paragraph","spans":[{"id":"spn-35844","text":"AgentCore has a materially different cost and capability footprint."}]}],"id":"blk-33242","kind":"list-item"},{"blocks":[{"id":"blk-33245","kind":"paragraph","spans":[{"id":"spn-35845","text":"Capability: long-running sessions and built-in tools (e.g., code execution and browser automation) unlock workflows that are not “free” to operate."}]}],"id":"blk-33244","kind":"list-item"},{"blocks":[{"id":"blk-33247","kind":"paragraph","spans":[{"id":"spn-35846","text":"DX: AgentCore is viable for TypeScript-first teams via official TypeScript SDK support and tool integrations, which strengthens its premium value proposition."}]}],"id":"blk-33246","kind":"list-item"},{"blocks":[{"id":"blk-33249","kind":"paragraph","spans":[{"id":"spn-35847","text":"Allowing access without gating risks unbounded cost exposure, especially for long-running or tool-heavy workloads."}]}],"id":"blk-33248","kind":"list-item"},{"blocks":[{"id":"blk-33251","kind":"paragraph","spans":[{"id":"spn-35848","text":"Tier-based runtime gating enables a clear product ladder (acquisition → premium) while keeping the default path cost-efficient and globally distributed."}]}],"id":"blk-33250","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33252","kind":"heading","level":3,"spans":[{"id":"spn-35849","text":"3.3 Why requests-first enforcement is acceptable for v1"}]},{"id":"blk-33253","items":[{"blocks":[{"id":"blk-33255","kind":"paragraph","spans":[{"id":"spn-35850","text":"Requests are the most immediate and reliable pre-invocation signal."}]}],"id":"blk-33254","kind":"list-item"},{"blocks":[{"id":"blk-33257","kind":"paragraph","spans":[{"id":"spn-35851","text":"Accurate tokens/compute budgets require predictive reservation or “post-charge” logic, which is more complex and varies by runtime."}]}],"id":"blk-33256","kind":"list-item"},{"blocks":[{"id":"blk-33259","kind":"paragraph","spans":[{"id":"spn-35852","text":"v1 still ensures tokens/compute budgets are enforced over time (subsequent blocking), which is sufficient to prevent ongoing overuse."}]}],"id":"blk-33258","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33260","kind":"heading","level":3,"spans":[{"id":"spn-35853","text":"3.4 Why we still plan for reservation"}]},{"id":"blk-33261","kind":"paragraph","spans":[{"id":"spn-35854","text":"For AgentCore, a single invocation can be expensive. Reservation provides better pre-flight protection:"}]},{"id":"blk-33262","items":[{"blocks":[{"id":"blk-33264","kind":"paragraph","spans":[{"id":"spn-35855","text":"reserve predicted tokens/compute,"}]}],"id":"blk-33263","kind":"list-item"},{"blocks":[{"id":"blk-33266","kind":"paragraph","spans":[{"id":"spn-35856","text":"reject if budget cannot cover expected cost,"}]}],"id":"blk-33265","kind":"list-item"},{"blocks":[{"id":"blk-33268","kind":"paragraph","spans":[{"id":"spn-35857","text":"reconcile after invocation."}]}],"id":"blk-33267","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33269","kind":"paragraph","spans":[{"id":"spn-35858","text":"We accept requests-first in v1 but design data models and APIs to allow reservation without breaking changes (e.g., counters and “pending usage” concepts)."}]},{"id":"blk-33270","kind":"heading","level":2,"spans":[{"id":"spn-35859","text":"4) Alternatives considered"}]},{"id":"blk-33271","kind":"heading","level":3,"spans":[{"id":"spn-35860","text":"A) No limits (reject)"}]},{"id":"blk-33272","kind":"paragraph","spans":[{"id":"spn-35861","text":"Pros:"}]},{"id":"blk-33273","items":[{"blocks":[{"id":"blk-33275","kind":"paragraph","spans":[{"id":"spn-35862","text":"simplest experience"}]}],"id":"blk-33274","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33276","kind":"paragraph","spans":[{"id":"spn-35863","text":"Cons:"}]},{"id":"blk-33277","items":[{"blocks":[{"id":"blk-33279","kind":"paragraph","spans":[{"id":"spn-35864","text":"unacceptable cost and abuse exposure"}]}],"id":"blk-33278","kind":"list-item"},{"blocks":[{"id":"blk-33281","kind":"paragraph","spans":[{"id":"spn-35865","text":"no pricing integrity"}]}],"id":"blk-33280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33282","kind":"paragraph","spans":[{"id":"spn-35866","text":"Rejected."}]},{"id":"blk-33283","kind":"heading","level":3,"spans":[{"id":"spn-35867","text":"B) Pre-reservation for all dimensions in v1 (defer)"}]},{"id":"blk-33284","kind":"paragraph","spans":[{"id":"spn-35868","text":"Pros:"}]},{"id":"blk-33285","items":[{"blocks":[{"id":"blk-33287","kind":"paragraph","spans":[{"id":"spn-35869","text":"best cost control and fewer “single request blows budget” events"}]}],"id":"blk-33286","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33288","kind":"paragraph","spans":[{"id":"spn-35870","text":"Cons:"}]},{"id":"blk-33289","items":[{"blocks":[{"id":"blk-33291","kind":"paragraph","spans":[{"id":"spn-35871","text":"requires good prediction of tokens/compute, which is inherently uncertain"}]}],"id":"blk-33290","kind":"list-item"},{"blocks":[{"id":"blk-33293","kind":"paragraph","spans":[{"id":"spn-35872","text":"requires stronger atomic counters and reconciliation logic"}]}],"id":"blk-33292","kind":"list-item"},{"blocks":[{"id":"blk-33295","kind":"paragraph","spans":[{"id":"spn-35873","text":"increases complexity and time-to-market"}]}],"id":"blk-33294","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33296","kind":"paragraph","spans":[{"id":"spn-35874","text":"Deferred; recommended as a post-v1 enhancement, and potentially as a “AgentCore-only” enhancement sooner."}]},{"id":"blk-33297","kind":"heading","level":3,"spans":[{"id":"spn-35875","text":"C) Provider-side enforcement only (reject)"}]},{"id":"blk-33298","kind":"paragraph","spans":[{"id":"spn-35876","text":"Pros:"}]},{"id":"blk-33299","items":[{"blocks":[{"id":"blk-33301","kind":"paragraph","spans":[{"id":"spn-35877","text":"offload to providers"}]}],"id":"blk-33300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33302","kind":"paragraph","spans":[{"id":"spn-35878","text":"Cons:"}]},{"id":"blk-33303","items":[{"blocks":[{"id":"blk-33305","kind":"paragraph","spans":[{"id":"spn-35879","text":"providers don’t enforce webhost.systems tier semantics"}]}],"id":"blk-33304","kind":"list-item"},{"blocks":[{"id":"blk-33307","kind":"paragraph","spans":[{"id":"spn-35880","text":"cannot unify multi-runtime behavior"}]}],"id":"blk-33306","kind":"list-item"},{"blocks":[{"id":"blk-33309","kind":"paragraph","spans":[{"id":"spn-35881","text":"cannot prevent cross-runtime abuse and cannot provide unified UX"}]}],"id":"blk-33308","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33310","kind":"paragraph","spans":[{"id":"spn-35882","text":"Rejected."}]},{"id":"blk-33311","kind":"heading","level":3,"spans":[{"id":"spn-35883","text":"D) Soft limits with overage billing from day one (defer)"}]},{"id":"blk-33312","kind":"paragraph","spans":[{"id":"spn-35884","text":"Pros:"}]},{"id":"blk-33313","items":[{"blocks":[{"id":"blk-33315","kind":"paragraph","spans":[{"id":"spn-35885","text":"better UX (fewer blocks), potential revenue upside"}]}],"id":"blk-33314","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33316","kind":"paragraph","spans":[{"id":"spn-35886","text":"Cons:"}]},{"id":"blk-33317","items":[{"blocks":[{"id":"blk-33319","kind":"paragraph","spans":[{"id":"spn-35887","text":"requires accurate reconciliation, payment handling, dispute workflows"}]}],"id":"blk-33318","kind":"list-item"},{"blocks":[{"id":"blk-33321","kind":"paragraph","spans":[{"id":"spn-35888","text":"increases complexity and compliance surface"}]}],"id":"blk-33320","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33322","kind":"paragraph","spans":[{"id":"spn-35889","text":"Deferred; start with hard-stop in v1."}]},{"id":"blk-33323","kind":"heading","level":2,"spans":[{"id":"spn-35890","text":"5) Consequences"}]},{"id":"blk-33324","kind":"heading","level":3,"spans":[{"id":"spn-35891","text":"Positive"}]},{"id":"blk-33325","items":[{"blocks":[{"id":"blk-33327","kind":"paragraph","spans":[{"id":"spn-35892","text":"Clear, predictable tier behavior."}]}],"id":"blk-33326","kind":"list-item"},{"blocks":[{"id":"blk-33329","kind":"paragraph","spans":[{"id":"spn-35893","text":"Strong control of premium runtime access."}]}],"id":"blk-33328","kind":"list-item"},{"blocks":[{"id":"blk-33331","kind":"paragraph","spans":[{"id":"spn-35894","text":"Requests hard-stop prevents the most common abuse patterns."}]}],"id":"blk-33330","kind":"list-item"},{"blocks":[{"id":"blk-33333","kind":"paragraph","spans":[{"id":"spn-35895","text":"Compatible with future improvements (reservation, overages, public invocations)."}]}],"id":"blk-33332","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33334","kind":"heading","level":3,"spans":[{"id":"spn-35896","text":"Negative / tradeoffs"}]},{"id":"blk-33335","items":[{"blocks":[{"id":"blk-33337","kind":"paragraph","spans":[{"id":"spn-35897","text":"A user may exceed token/compute budget within a single request in v1 (especially on premium runtime), then be blocked afterwards."}]}],"id":"blk-33336","kind":"list-item"},{"blocks":[{"id":"blk-33339","kind":"paragraph","spans":[{"id":"spn-35898","text":"Telemetry delays can cause temporary undercounting until aggregation catches up."}]}],"id":"blk-33338","kind":"list-item"},{"blocks":[{"id":"blk-33341","kind":"paragraph","spans":[{"id":"spn-35899","text":"Concurrency can cause minor overrun near boundaries unless atomic counters are implemented."}]}],"id":"blk-33340","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33342","kind":"heading","level":2,"spans":[{"id":"spn-35900","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-33343","kind":"heading","level":3,"spans":[{"id":"spn-35901","text":"6.1 Entitlements representation"}]},{"id":"blk-33344","kind":"paragraph","spans":[{"id":"spn-35902","text":"The system MUST have a function (or module) equivalent to:"}]},{"id":"blk-33345","items":[{"blocks":[{"id":"blk-33347","kind":"paragraph","spans":[{"id":"spn-35903","marks":["code"],"text":"getEntitlementsForTier(tier) -> { limits, runtimeAccess, retention }"}]}],"id":"blk-33346","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33348","kind":"paragraph","spans":[{"id":"spn-35904","text":"It MUST be deterministic, server-only, and auditable (config changes tracked via code review or admin change logs)."}]},{"id":"blk-33349","kind":"heading","level":3,"spans":[{"id":"spn-35905","text":"6.2 Period definition"}]},{"id":"blk-33350","kind":"paragraph","spans":[{"id":"spn-35906","text":"v1 MUST standardize billing periods. Recommendation:"}]},{"id":"blk-33351","items":[{"blocks":[{"id":"blk-33353","kind":"paragraph","spans":[{"id":"spn-35907","text":"calendar-month "},{"id":"spn-35908","marks":["code"],"text":"YYYY-MM"},{"id":"spn-35909","text":" as "},{"id":"spn-35910","marks":["code"],"text":"periodKey"}]}],"id":"blk-33352","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33354","kind":"paragraph","spans":[{"id":"spn-35911","text":"If subscription-aligned periods are implemented later, ensure backward compatibility in reporting."}]},{"id":"blk-33355","kind":"heading","level":3,"spans":[{"id":"spn-35912","text":"6.3 Invocation enforcement algorithm (v1)"}]},{"id":"blk-33356","kind":"paragraph","spans":[{"id":"spn-35913","text":"At invocation start (before provider call): 1. Resolve authenticated user. 2. Resolve agent; enforce ownership; ensure not disabled/deleted. 3. Resolve active deployment; ensure valid state. 4. Load entitlements for user tier. 5. Enforce runtime gating:"}]},{"id":"blk-33357","items":[{"blocks":[{"id":"blk-33359","kind":"paragraph","spans":[{"id":"spn-35914","text":"if deployment runtime is "},{"id":"spn-35915","marks":["code"],"text":"agentcore"},{"id":"spn-35916","text":" and "},{"id":"spn-35917","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-35918","text":", reject."}]}],"id":"blk-33358","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33360","kind":"paragraph","spans":[{"id":"spn-35919","text":"6. Load current period usage totals (from aggregated "},{"id":"spn-35920","marks":["code"],"text":"billingUsage"},{"id":"spn-35921","text":" and/or fast counters). 7. Enforce requests limit:"}]},{"id":"blk-33361","items":[{"blocks":[{"id":"blk-33363","kind":"paragraph","spans":[{"id":"spn-35922","text":"if requests already at/over limit, reject with "},{"id":"spn-35923","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-35924","text":"."}]}],"id":"blk-33362","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33364","kind":"paragraph","spans":[{"id":"spn-35925","text":"8. Proceed to provider invocation."}]},{"id":"blk-33365","kind":"paragraph","spans":[{"id":"spn-35926","text":"After invocation:"}]},{"id":"blk-33366","items":[{"blocks":[{"id":"blk-33368","kind":"paragraph","spans":[{"id":"spn-35927","text":"Ensure telemetry is recorded (directly from runtime or adapter-side)."}]}],"id":"blk-33367","kind":"list-item"},{"blocks":[{"id":"blk-33370","kind":"paragraph","spans":[{"id":"spn-35928","text":"Aggregation updates period totals."}]}],"id":"blk-33369","kind":"list-item"},{"blocks":[{"id":"blk-33372","kind":"paragraph","spans":[{"id":"spn-35929","text":"If tokens/compute exceed budgets:"}]}],"id":"blk-33371","kind":"list-item"},{"blocks":[{"id":"blk-33374","kind":"paragraph","spans":[{"id":"spn-35930","text":"subsequent invocations MUST be rejected until next period or upgrade."}]}],"id":"blk-33373","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33375","kind":"heading","level":3,"spans":[{"id":"spn-35931","text":"6.4 Deploy-time enforcement"}]},{"id":"blk-33376","kind":"paragraph","spans":[{"id":"spn-35932","text":"At deploy start:"}]},{"id":"blk-33377","items":[{"blocks":[{"id":"blk-33379","kind":"paragraph","spans":[{"id":"spn-35933","text":"Load entitlements."}]}],"id":"blk-33378","kind":"list-item"},{"blocks":[{"id":"blk-33381","kind":"paragraph","spans":[{"id":"spn-35934","text":"Enforce runtime gating (AgentCore enabled)."}]}],"id":"blk-33380","kind":"list-item"},{"blocks":[{"id":"blk-33383","kind":"paragraph","spans":[{"id":"spn-35935","text":"Enforce any deploy-related caps (optional in v1; e.g., max agents or deployments)."}]}],"id":"blk-33382","kind":"list-item"},{"blocks":[{"id":"blk-33385","kind":"paragraph","spans":[{"id":"spn-35936","text":"Create deployment record and proceed."}]}],"id":"blk-33384","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33386","kind":"heading","level":3,"spans":[{"id":"spn-35937","text":"6.5 Concurrency and counters (minimum vs recommended)"}]},{"id":"blk-33387","kind":"paragraph","spans":[{"id":"spn-35938","text":"Minimum acceptable v1:"}]},{"id":"blk-33388","items":[{"blocks":[{"id":"blk-33390","kind":"paragraph","spans":[{"id":"spn-35939","text":"Use aggregated usage totals and accept small overruns under concurrency."}]}],"id":"blk-33389","kind":"list-item"},{"blocks":[{"id":"blk-33392","kind":"paragraph","spans":[{"id":"spn-35940","text":"Ensure the system never systematically undercounts."}]}],"id":"blk-33391","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33393","kind":"paragraph","spans":[{"id":"spn-35941","text":"Recommended:"}]},{"id":"blk-33394","items":[{"blocks":[{"id":"blk-33396","kind":"paragraph","spans":[{"id":"spn-35942","text":"Maintain an atomic per-user per-period counter for "},{"id":"spn-35943","marks":["code"],"text":"requests"},{"id":"spn-35944","text":"."}]}],"id":"blk-33395","kind":"list-item"},{"blocks":[{"id":"blk-33398","kind":"paragraph","spans":[{"id":"spn-35945","text":"Optionally maintain token/compute counters as well."}]}],"id":"blk-33397","kind":"list-item"},{"blocks":[{"id":"blk-33400","kind":"paragraph","spans":[{"id":"spn-35946","text":"If counters are implemented, ensure idempotency under retries and telemetry dedupe."}]}],"id":"blk-33399","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33401","kind":"heading","level":3,"spans":[{"id":"spn-35947","text":"6.6 Telemetry integrity dependency"}]},{"id":"blk-33402","kind":"paragraph","spans":[{"id":"spn-35948","text":"This ADR depends on ADR-0004 (telemetry integrity). Limit enforcement based on usage requires trustworthy telemetry:"}]},{"id":"blk-33403","items":[{"blocks":[{"id":"blk-33405","kind":"paragraph","spans":[{"id":"spn-35949","text":"signed events per deployment,"}]}],"id":"blk-33404","kind":"list-item"},{"blocks":[{"id":"blk-33407","kind":"paragraph","spans":[{"id":"spn-35950","text":"ownership cross-check."}]}],"id":"blk-33406","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33408","kind":"heading","level":3,"spans":[{"id":"spn-35951","text":"6.7 Observability and UX requirements"}]},{"id":"blk-33409","kind":"paragraph","spans":[{"id":"spn-35952","text":"When rejecting for limits/gating:"}]},{"id":"blk-33410","items":[{"blocks":[{"id":"blk-33412","kind":"paragraph","spans":[{"id":"spn-35953","text":"include enough detail to explain why,"}]}],"id":"blk-33411","kind":"list-item"},{"blocks":[{"id":"blk-33414","kind":"paragraph","spans":[{"id":"spn-35954","text":"suggest an upgrade path,"}]}],"id":"blk-33413","kind":"list-item"},{"blocks":[{"id":"blk-33416","kind":"paragraph","spans":[{"id":"spn-35955","text":"never leak confidential internal state."}]}],"id":"blk-33415","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33417","kind":"paragraph","spans":[{"id":"spn-35956","text":"The dashboard MUST show:"}]},{"id":"blk-33418","items":[{"blocks":[{"id":"blk-33420","kind":"paragraph","spans":[{"id":"spn-35957","text":"current tier and limits,"}]}],"id":"blk-33419","kind":"list-item"},{"blocks":[{"id":"blk-33422","kind":"paragraph","spans":[{"id":"spn-35958","text":"current usage totals,"}]}],"id":"blk-33421","kind":"list-item"},{"blocks":[{"id":"blk-33424","kind":"paragraph","spans":[{"id":"spn-35959","text":"per-runtime breakdown,"}]}],"id":"blk-33423","kind":"list-item"},{"blocks":[{"id":"blk-33426","kind":"paragraph","spans":[{"id":"spn-35960","text":"“estimated” cost labeling."}]}],"id":"blk-33425","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33427","kind":"heading","level":2,"spans":[{"id":"spn-35961","text":"7) Testing requirements (acceptance-focused)"}]},{"id":"blk-33428","kind":"heading","level":3,"spans":[{"id":"spn-35962","text":"MUST"}]},{"id":"blk-33429","items":[{"blocks":[{"id":"blk-33431","kind":"paragraph","spans":[{"id":"spn-35963","text":"E2E: requests limit blocks invocations with "},{"id":"spn-35964","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-35965","text":"."}]}],"id":"blk-33430","kind":"list-item"},{"blocks":[{"id":"blk-33433","kind":"paragraph","spans":[{"id":"spn-35966","text":"Integration: AgentCore deploy/invoke blocked for non-entitled tiers."}]}],"id":"blk-33432","kind":"list-item"},{"blocks":[{"id":"blk-33435","kind":"paragraph","spans":[{"id":"spn-35967","text":"Unit: entitlements mapping returns expected limits and gating behavior."}]}],"id":"blk-33434","kind":"list-item"},{"blocks":[{"id":"blk-33437","kind":"paragraph","spans":[{"id":"spn-35968","text":"Integration: deploy-time gating prevents provider calls to AgentCore."}]}],"id":"blk-33436","kind":"list-item"},{"blocks":[{"id":"blk-33439","kind":"paragraph","spans":[{"id":"spn-35969","text":"Security: clients cannot modify tier or entitlements; only webhook-verified updates are effective."}]}],"id":"blk-33438","kind":"list-item"}],"kind":"list","order