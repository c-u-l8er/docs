{"bendscript":"0.1","blocks":[{"id":"blk-34127","kind":"heading","level":1,"spans":[{"id":"spn-38576","text":"ADR-0007: Tier Entitlements, Runtime Gating, and Limit Enforcement Strategy"}]},{"id":"blk-34128","kind":"paragraph","spans":[{"id":"spn-38577","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-34129","items":[{"blocks":[{"id":"blk-34131","kind":"paragraph","spans":[{"id":"spn-38578","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-34130","kind":"list-item"},{"blocks":[{"id":"blk-34133","kind":"paragraph","spans":[{"id":"spn-38579","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-34132","kind":"list-item"},{"blocks":[{"id":"blk-34135","kind":"paragraph","spans":[{"id":"spn-38580","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-34134","kind":"list-item"},{"blocks":[{"id":"blk-34137","kind":"paragraph","spans":[{"id":"spn-38581","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-34136","kind":"list-item"},{"blocks":[{"id":"blk-34139","kind":"paragraph","spans":[{"id":"spn-38582","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-34138","kind":"list-item"},{"blocks":[{"id":"blk-34141","kind":"paragraph","spans":[{"id":"spn-38583","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-34140","kind":"list-item"},{"blocks":[{"id":"blk-34143","kind":"paragraph","spans":[{"id":"spn-38584","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-34142","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34144","kind":"heading","level":2,"spans":[{"id":"spn-38585","text":"1) Context"}]},{"id":"blk-34145","kind":"paragraph","spans":[{"id":"spn-38586","text":"webhost.systems is a multi-runtime AI agent platform. The control plane must:"}]},{"id":"blk-34146","items":[{"blocks":[{"id":"blk-34148","kind":"paragraph","spans":[{"id":"spn-38587","text":"monetize via subscription tiers,"}]}],"id":"blk-34147","kind":"list-item"},{"blocks":[{"id":"blk-34150","kind":"paragraph","spans":[{"id":"spn-38588","text":"enforce tenant entitlements and limits in a way that protects platform cost exposure,"}]}],"id":"blk-34149","kind":"list-item"},{"blocks":[{"id":"blk-34152","kind":"paragraph","spans":[{"id":"spn-38589","text":"gate access to premium runtime providers (AWS Bedrock AgentCore),"}]}],"id":"blk-34151","kind":"list-item"},{"blocks":[{"id":"blk-34154","kind":"paragraph","spans":[{"id":"spn-38590","text":"provide predictable, explainable behavior to users and support."}]}],"id":"blk-34153","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34155","kind":"paragraph","spans":[{"id":"spn-38591","text":"The platform has heterogeneous cost profiles by runtime:"}]},{"id":"blk-34156","items":[{"blocks":[{"id":"blk-34158","kind":"paragraph","spans":[{"id":"spn-38592","marks":["bold"],"text":"Cloudflare Workers/DO"},{"id":"spn-38593","text":" supports a broad set of use cases with favorable economics and global edge distribution, enabling acquisition tiers (including free)."}]}],"id":"blk-34157","kind":"list-item"},{"blocks":[{"id":"blk-34160","kind":"paragraph","spans":[{"id":"spn-38594","text":"TypeScript-first: Workers/DO are TypeScript-friendly and support modern agent frameworks naturally."}]}],"id":"blk-34159","kind":"list-item"},{"blocks":[{"id":"blk-34162","kind":"paragraph","spans":[{"id":"spn-38595","marks":["bold"],"text":"AWS Bedrock AgentCore"},{"id":"spn-38596","text":" supports premium enterprise capabilities (long running sessions, stronger isolation, built-in tools), but has higher marginal cost and different operational constraints."}]}],"id":"blk-34161","kind":"list-item"},{"blocks":[{"id":"blk-34164","kind":"paragraph","spans":[{"id":"spn-38597","text":"TypeScript-first: AgentCore has first-class TypeScript SDK support for runtime operations and modern tooling integration:"}]}],"id":"blk-34163","kind":"list-item"},{"blocks":[{"id":"blk-34166","kind":"paragraph","spans":[{"id":"spn-38598","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-38599","text":" (TypeScript) for management and invocation"}]}],"id":"blk-34165","kind":"list-item"},{"blocks":[{"id":"blk-34168","kind":"paragraph","spans":[{"id":"spn-38600","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-38601","text":" (TypeScript) for built-in tools (e.g., Code Interpreter and Browser), with integration paths for modern agent frameworks (e.g., Vercel AI SDK)"}]}],"id":"blk-34167","kind":"list-item"},{"blocks":[{"id":"blk-34170","kind":"paragraph","spans":[{"id":"spn-38602","text":"Premium value drivers beyond runtime length:"}]}],"id":"blk-34169","kind":"list-item"},{"blocks":[{"id":"blk-34172","kind":"paragraph","spans":[{"id":"spn-38603","text":"built-in tool ecosystem (code execution + browser automation) that is otherwise “DIY” on many runtimes"}]}],"id":"blk-34171","kind":"list-item"},{"blocks":[{"id":"blk-34174","kind":"paragraph","spans":[{"id":"spn-38604","text":"enterprise isolation posture aligned with higher-tier requirements"}]}],"id":"blk-34173","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34175","kind":"paragraph","spans":[{"id":"spn-38605","text":"Limits are required for:"}]},{"id":"blk-34176","items":[{"blocks":[{"id":"blk-34178","kind":"paragraph","spans":[{"id":"spn-38606","text":"preventing runaway cost and abuse,"}]}],"id":"blk-34177","kind":"list-item"},{"blocks":[{"id":"blk-34180","kind":"paragraph","spans":[{"id":"spn-38607","text":"ensuring fairness and QoS,"}]}],"id":"blk-34179","kind":"list-item"},{"blocks":[{"id":"blk-34182","kind":"paragraph","spans":[{"id":"spn-38608","text":"aligning tier pricing with usage."}]}],"id":"blk-34181","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34183","kind":"paragraph","spans":[{"id":"spn-38609","text":"Key constraints:"}]},{"id":"blk-34184","items":[{"blocks":[{"id":"blk-34186","kind":"paragraph","spans":[{"id":"spn-38610","text":"Actual token usage and compute time are not known until after the invocation completes."}]}],"id":"blk-34185","kind":"list-item"},{"blocks":[{"id":"blk-34188","kind":"paragraph","spans":[{"id":"spn-38611","text":"Telemetry ingestion is asynchronous and may be delayed or fail transiently."}]}],"id":"blk-34187","kind":"list-item"},{"blocks":[{"id":"blk-34190","kind":"paragraph","spans":[{"id":"spn-38612","text":"Concurrency (multiple simultaneous invocations) can race around limit boundaries."}]}],"id":"blk-34189","kind":"list-item"},{"blocks":[{"id":"blk-34192","kind":"paragraph","spans":[{"id":"spn-38613","text":"Security requirements prohibit relying on client-provided usage or tier claims."}]}],"id":"blk-34191","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34193","kind":"paragraph","spans":[{"id":"spn-38614","text":"Therefore, v1 needs a robust entitlement model and a limit enforcement strategy that is safe, implementable, and extensible."}]},{"id":"blk-34194","kind":"heading","level":2,"spans":[{"id":"spn-38615","text":"2) Decision"}]},{"id":"blk-34195","kind":"heading","level":3,"spans":[{"id":"spn-38616","text":"2.1 Adopt a configuration-driven entitlement model (server authoritative)"}]},{"id":"blk-34196","kind":"paragraph","spans":[{"id":"spn-38617","text":"Entitlements are represented as a server-side configuration mapping a user’s current tier to a set of allowed capabilities and budgets. Entitlements MUST be treated as "},{"id":"spn-38618","marks":["bold"],"text":"authoritative"},{"id":"spn-38619","text":" on the server; the client/UI is advisory only."}]},{"id":"blk-34197","kind":"paragraph","spans":[{"id":"spn-38620","text":"Each tier defines (minimum):"}]},{"id":"blk-34198","items":[{"blocks":[{"id":"blk-34200","kind":"paragraph","spans":[{"id":"spn-38621","marks":["code"],"text":"maxRequestsPerPeriod"}]}],"id":"blk-34199","kind":"list-item"},{"blocks":[{"id":"blk-34202","kind":"paragraph","spans":[{"id":"spn-38622","marks":["code"],"text":"maxTokensPerPeriod"},{"id":"spn-38623","text":" (reported or estimated)"}]}],"id":"blk-34201","kind":"list-item"},{"blocks":[{"id":"blk-34204","kind":"paragraph","spans":[{"id":"spn-38624","marks":["code"],"text":"maxComputeMsPerPeriod"}]}],"id":"blk-34203","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34205","kind":"paragraph","spans":[{"id":"spn-38625","text":"Runtime access + capabilities:"}]},{"id":"blk-34206","items":[{"blocks":[{"id":"blk-34208","kind":"paragraph","spans":[{"id":"spn-38626","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-38627","text":" (boolean) — whether the user may deploy/invoke on AgentCore at all"}]}],"id":"blk-34207","kind":"list-item"},{"blocks":[{"id":"blk-34210","kind":"paragraph","spans":[{"id":"spn-38628","marks":["code"],"text":"memoryEnabled"},{"id":"spn-38629","text":" (boolean) — whether AgentCore Memory features may be enabled for deployments"}]}],"id":"blk-34209","kind":"list-item"},{"blocks":[{"id":"blk-34212","kind":"paragraph","spans":[{"id":"spn-38630","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-38631","text":" (boolean) — whether AgentCore Code Interpreter tools may be enabled for deployments"}]}],"id":"blk-34211","kind":"list-item"},{"blocks":[{"id":"blk-34214","kind":"paragraph","spans":[{"id":"spn-38632","marks":["code"],"text":"browserEnabled"},{"id":"spn-38633","text":" (boolean) — whether AgentCore Browser tools may be enabled for deployments"}]}],"id":"blk-34213","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34215","kind":"paragraph","spans":[{"id":"spn-38634","text":"Tool quotas (only meaningful if tools are enabled; omitted or set to 0 when disabled):"}]},{"id":"blk-34216","items":[{"blocks":[{"id":"blk-34218","kind":"paragraph","spans":[{"id":"spn-38635","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-38636","text":" (number, optional)"}]}],"id":"blk-34217","kind":"list-item"},{"blocks":[{"id":"blk-34220","kind":"paragraph","spans":[{"id":"spn-38637","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-38638","text":" (number, optional)"}]}],"id":"blk-34219","kind":"list-item"},{"blocks":[{"id":"blk-34222","kind":"paragraph","spans":[{"id":"spn-38639","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-38640","text":" (number, optional)"}]}],"id":"blk-34221","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34223","kind":"paragraph","spans":[{"id":"spn-38641","text":"Retention policies:"}]},{"id":"blk-34224","items":[{"blocks":[{"id":"blk-34226","kind":"paragraph","spans":[{"id":"spn-38642","text":"telemetry/logs retention days"}]}],"id":"blk-34225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34227","kind":"paragraph","spans":[{"id":"spn-38643","text":"Entitlements MUST be stored and evaluated in a way that can be changed without code edits (e.g., configuration file/env, DB table, or feature flag system). Exact storage choice is implementation detail, but it MUST be server-controlled and auditable."}]},{"id":"blk-34228","kind":"heading","level":3,"spans":[{"id":"spn-38644","text":"2.2 Tier gating rules: runtime access is an entitlement (defense in depth)"}]},{"id":"blk-34229","kind":"paragraph","spans":[{"id":"spn-38645","text":"Runtime access is gated by entitlements:"}]},{"id":"blk-34230","items":[{"blocks":[{"id":"blk-34232","kind":"paragraph","spans":[{"id":"spn-38646","text":"If "},{"id":"spn-38647","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-38648","text":", then:"}]}],"id":"blk-34231","kind":"list-item"},{"blocks":[{"id":"blk-34234","kind":"paragraph","spans":[{"id":"spn-38649","text":"deploy to "},{"id":"spn-38650","marks":["code"],"text":"runtimeProvider=agentcore"},{"id":"spn-38651","text":" MUST be rejected, and"}]}],"id":"blk-34233","kind":"list-item"},{"blocks":[{"id":"blk-34236","kind":"paragraph","spans":[{"id":"spn-38652","text":"invoke routed to an AgentCore deployment MUST be rejected, and"}]}],"id":"blk-34235","kind":"list-item"},{"blocks":[{"id":"blk-34238","kind":"paragraph","spans":[{"id":"spn-38653","text":"any attempt to switch an agent’s runtimeProvider to "},{"id":"spn-38654","marks":["code"],"text":"agentcore"},{"id":"spn-38655","text":" SHOULD be rejected (v1 recommendation: reject to reduce confusion)."}]}],"id":"blk-34237","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34239","items":[{"blocks":[{"id":"blk-34241","kind":"paragraph","spans":[{"id":"spn-38656","text":"If "},{"id":"spn-38657","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-38658","text":", AgentCore capability flags MUST still be enforced:"}]}],"id":"blk-34240","kind":"list-item"},{"blocks":[{"id":"blk-34243","kind":"paragraph","spans":[{"id":"spn-38659","text":"If "},{"id":"spn-38660","marks":["code"],"text":"codeInterpreterEnabled=false"},{"id":"spn-38661","text":", deployments MUST NOT enable code interpreter tooling, and invocations MUST be treated as “tools unavailable” (no tool loop) even if user code requests it."}]}],"id":"blk-34242","kind":"list-item"},{"blocks":[{"id":"blk-34245","kind":"paragraph","spans":[{"id":"spn-38662","text":"If "},{"id":"spn-38663","marks":["code"],"text":"browserEnabled=false"},{"id":"spn-38664","text":", deployments MUST NOT enable browser tooling, and invocations MUST be treated as “tools unavailable” for browser interactions."}]}],"id":"blk-34244","kind":"list-item"},{"blocks":[{"id":"blk-34247","kind":"paragraph","spans":[{"id":"spn-38665","text":"If "},{"id":"spn-38666","marks":["code"],"text":"memoryEnabled=false"},{"id":"spn-38667","text":", deployments MUST NOT enable provider memory features."}]}],"id":"blk-34246","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34248","kind":"paragraph","spans":[{"id":"spn-38668","marks":["bold"],"text":"v1 recommendation (tools): enterprise-only"}]},{"id":"blk-34249","items":[{"blocks":[{"id":"blk-34251","kind":"paragraph","spans":[{"id":"spn-38669","text":"v1 SHOULD enable AgentCore tools ("},{"id":"spn-38670","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-38671","text":" and "},{"id":"spn-38672","marks":["code"],"text":"browserEnabled"},{"id":"spn-38673","text":") only on the "},{"id":"spn-38674","marks":["code"],"text":"enterprise"},{"id":"spn-38675","text":" tier."}]}],"id":"blk-34250","kind":"list-item"},{"blocks":[{"id":"blk-34253","kind":"paragraph","spans":[{"id":"spn-38676","text":"v1 MAY allow "},{"id":"spn-38677","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-38678","text":" on "},{"id":"spn-38679","marks":["code"],"text":"pro"},{"id":"spn-38680","text":" while keeping tools disabled (and optionally allowing "},{"id":"spn-38681","marks":["code"],"text":"memoryEnabled=true"},{"id":"spn-38682","text":" if cost/behavior is acceptable)."}]}],"id":"blk-34252","kind":"list-item"},{"blocks":[{"id":"blk-34255","kind":"paragraph","spans":[{"id":"spn-38683","text":"If you later enable tools for "},{"id":"spn-38684","marks":["code"],"text":"pro"},{"id":"spn-38685","text":", you MUST add explicit tool quotas ("},{"id":"spn-38686","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-38687","text":", "},{"id":"spn-38688","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-38689","text":", "},{"id":"spn-38690","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-38691","text":") and enforce them at invoke time."}]}],"id":"blk-34254","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34256","kind":"paragraph","spans":[{"id":"spn-38692","text":"This gating MUST be enforced at three layers (defense in depth): 1. "},{"id":"spn-38693","marks":["bold"],"text":"UI layer"},{"id":"spn-38694","text":": hide/disable options (non-authoritative) 2. "},{"id":"spn-38695","marks":["bold"],"text":"Control plane deploy/invoke APIs"},{"id":"spn-38696","text":": authoritative check before provider calls 3. "},{"id":"spn-38697","marks":["bold"],"text":"Runtime adapter layer"},{"id":"spn-38698","text":": refuse deploy/invoke if not entitled (in case of misrouting or bugs)"}]},{"id":"blk-34257","kind":"paragraph","spans":[{"id":"spn-38699","text":"The same three-layer enforcement applies to "},{"id":"spn-38700","marks":["bold"],"text":"AgentCore capability flags"},{"id":"spn-38701","text":" ("},{"id":"spn-38702","marks":["code"],"text":"memoryEnabled"},{"id":"spn-38703","text":", "},{"id":"spn-38704","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-38705","text":", "},{"id":"spn-38706","marks":["code"],"text":"browserEnabled"},{"id":"spn-38707","text":"):"}]},{"id":"blk-34258","items":[{"blocks":[{"id":"blk-34260","kind":"paragraph","spans":[{"id":"spn-38708","text":"UI MUST not present toggles the user is not entitled to."}]}],"id":"blk-34259","kind":"list-item"},{"blocks":[{"id":"blk-34262","kind":"paragraph","spans":[{"id":"spn-38709","text":"Deploy APIs MUST reject configurations that attempt to enable disallowed capabilities."}]}],"id":"blk-34261","kind":"list-item"},{"blocks":[{"id":"blk-34264","kind":"paragraph","spans":[{"id":"spn-38710","text":"Invoke routing MUST ensure a deployment cannot exercise disallowed capabilities (even if user code attempts to)."}]}],"id":"blk-34263","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34265","kind":"heading","level":3,"spans":[{"id":"spn-38711","text":"2.3 Limit enforcement strategy (v1): requests hard-stop + post-charge tokens/compute, with upgrade path to reservation"}]},{"id":"blk-34266","kind":"paragraph","spans":[{"id":"spn-38712","text":"v1 enforcement strategy is:"}]},{"id":"blk-34267","items":[{"blocks":[{"id":"blk-34269","kind":"paragraph","spans":[{"id":"spn-38713","marks":["bold"],"text":"Pre-invocation hard-stop on requests"},{"id":"spn-38714","text":" (MUST)."}]}],"id":"blk-34268","kind":"list-item"},{"blocks":[{"id":"blk-34271","kind":"paragraph","spans":[{"id":"spn-38715","marks":["bold"],"text":"Post-invocation accounting for tokens/compute"},{"id":"spn-38716","text":" via telemetry (MUST)."}]}],"id":"blk-34270","kind":"list-item"},{"blocks":[{"id":"blk-34273","kind":"paragraph","spans":[{"id":"spn-38717","marks":["bold"],"text":"Subsequent invocations blocked"},{"id":"spn-38718","text":" if tokens/compute budgets exceeded (MUST)."}]}],"id":"blk-34272","kind":"list-item"},{"blocks":[{"id":"blk-34275","kind":"paragraph","spans":[{"id":"spn-38719","marks":["bold"],"text":"Optional predictive reservation"},{"id":"spn-38720","text":" for expensive runtimes (SHOULD for AgentCore, MAY for Cloudflare) as an enhancement."}]}],"id":"blk-34274","kind":"list-item"},{"blocks":[{"id":"blk-34277","kind":"paragraph","spans":[{"id":"spn-38721","text":"AgentCore-specific note: because AgentCore can support longer-running workloads and built-in tools (code execution, browser automation), it may concentrate more cost into a single invocation. This makes reservation (or stricter pre-flight checks) more valuable for AgentCore tiers."}]}],"id":"blk-34276","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34278","kind":"paragraph","spans":[{"id":"spn-38722","text":"This is a deliberate v1 tradeoff:"}]},{"id":"blk-34279","items":[{"blocks":[{"id":"blk-34281","kind":"paragraph","spans":[{"id":"spn-38723","text":"It protects the platform from request floods (and thus most cost/abuse)."}]}],"id":"blk-34280","kind":"list-item"},{"blocks":[{"id":"blk-34283","kind":"paragraph","spans":[{"id":"spn-38724","text":"It keeps implementation complexity manageable while still meeting product needs."}]}],"id":"blk-34282","kind":"list-item"},{"blocks":[{"id":"blk-34285","kind":"paragraph","spans":[{"id":"spn-38725","text":"It provides a clear path to a stronger pre-reservation model without changing the external API."}]}],"id":"blk-34284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34286","kind":"heading","level":3,"spans":[{"id":"spn-38726","text":"2.4 Enforcement point: invocation gateway is the primary cost-control boundary"}]},{"id":"blk-34287","kind":"paragraph","spans":[{"id":"spn-38727","text":"Limits MUST be enforced in the invocation gateway "},{"id":"spn-38728","marks":["bold"],"text":"before calling a runtime provider"},{"id":"spn-38729","text":" whenever possible. This prevents spending money on requests that will be rejected."}]},{"id":"blk-34288","kind":"paragraph","spans":[{"id":"spn-38730","text":"For v1:"}]},{"id":"blk-34289","items":[{"blocks":[{"id":"blk-34291","kind":"paragraph","spans":[{"id":"spn-38731","text":"Request count enforcement MUST happen before provider invocation."}]}],"id":"blk-34290","kind":"list-item"},{"blocks":[{"id":"blk-34293","kind":"paragraph","spans":[{"id":"spn-38732","text":"Token/compute enforcement MAY lag by up to telemetry ingestion delay; when exceeded, block subsequent requests."}]}],"id":"blk-34292","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34294","kind":"heading","level":3,"spans":[{"id":"spn-38733","text":"2.5 Consistent error semantics"}]},{"id":"blk-34295","kind":"paragraph","spans":[{"id":"spn-38734","text":"When a deploy or invoke is rejected due to entitlements or limits, the system MUST return a normalized error envelope with:"}]},{"id":"blk-34296","items":[{"blocks":[{"id":"blk-34298","kind":"paragraph","spans":[{"id":"spn-38735","marks":["code"],"text":"code = LIMIT_EXCEEDED"},{"id":"spn-38736","text":" (or a dedicated entitlement code if added later),"}]}],"id":"blk-34297","kind":"list-item"},{"blocks":[{"id":"blk-34300","kind":"paragraph","spans":[{"id":"spn-38737","text":"a safe user-displayable message,"}]}],"id":"blk-34299","kind":"list-item"},{"blocks":[{"id":"blk-34302","kind":"paragraph","spans":[{"id":"spn-38738","text":"details including:"}]}],"id":"blk-34301","kind":"list-item"},{"blocks":[{"id":"blk-34304","kind":"paragraph","spans":[{"id":"spn-38739","text":"limit type ("},{"id":"spn-38740","marks":["code"],"text":"requests"},{"id":"spn-38741","text":", "},{"id":"spn-38742","marks":["code"],"text":"tokens"},{"id":"spn-38743","text":", "},{"id":"spn-38744","marks":["code"],"text":"computeMs"},{"id":"spn-38745","text":", or "},{"id":"spn-38746","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-38747","text":" / "},{"id":"spn-38748","marks":["code"],"text":"runtimeGated"},{"id":"spn-38749","text":"),"}]}],"id":"blk-34303","kind":"list-item"},{"blocks":[{"id":"blk-34306","kind":"paragraph","spans":[{"id":"spn-38750","text":"period key,"}]}],"id":"blk-34305","kind":"list-item"},{"blocks":[{"id":"blk-34308","kind":"paragraph","spans":[{"id":"spn-38751","text":"current usage and limit where known,"}]}],"id":"blk-34307","kind":"list-item"},{"blocks":[{"id":"blk-34310","kind":"paragraph","spans":[{"id":"spn-38752","text":"suggested action (upgrade tier)."}]}],"id":"blk-34309","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34311","kind":"paragraph","spans":[{"id":"spn-38753","text":"HTTP status mapping is defined in "},{"id":"spn-38754","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-38755","text":"."}]},{"id":"blk-34312","kind":"heading","level":2,"spans":[{"id":"spn-38756","text":"3) Rationale"}]},{"id":"blk-34313","kind":"heading","level":3,"spans":[{"id":"spn-38757","text":"3.1 Why configuration-driven entitlements"}]},{"id":"blk-34314","items":[{"blocks":[{"id":"blk-34316","kind":"paragraph","spans":[{"id":"spn-38758","text":"Pricing and tiers will iterate frequently; hardcoding makes iteration risky and slow."}]}],"id":"blk-34315","kind":"list-item"},{"blocks":[{"id":"blk-34318","kind":"paragraph","spans":[{"id":"spn-38759","text":"Entitlements must be authoritative and auditable, independent of client behavior."}]}],"id":"blk-34317","kind":"list-item"},{"blocks":[{"id":"blk-34320","kind":"paragraph","spans":[{"id":"spn-38760","text":"A single entitlements surface simplifies UI gating, API checks, and support tooling."}]}],"id":"blk-34319","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34321","kind":"heading","level":3,"spans":[{"id":"spn-38761","text":"3.2 Why runtime gating is mandatory"}]},{"id":"blk-34322","items":[{"blocks":[{"id":"blk-34324","kind":"paragraph","spans":[{"id":"spn-38762","text":"AgentCore has a materially different cost and capability footprint."}]}],"id":"blk-34323","kind":"list-item"},{"blocks":[{"id":"blk-34326","kind":"paragraph","spans":[{"id":"spn-38763","text":"Capability: long-running sessions and built-in tools (e.g., code execution and browser automation) unlock workflows that are not “free” to operate."}]}],"id":"blk-34325","kind":"list-item"},{"blocks":[{"id":"blk-34328","kind":"paragraph","spans":[{"id":"spn-38764","text":"DX: AgentCore is viable for TypeScript-first teams via official TypeScript SDK support and tool integrations, which strengthens its premium value proposition."}]}],"id":"blk-34327","kind":"list-item"},{"blocks":[{"id":"blk-34330","kind":"paragraph","spans":[{"id":"spn-38765","text":"Allowing access without gating risks unbounded cost exposure, especially for long-running or tool-heavy workloads."}]}],"id":"blk-34329","kind":"list-item"},{"blocks":[{"id":"blk-34332","kind":"paragraph","spans":[{"id":"spn-38766","text":"Tier-based runtime gating enables a clear product ladder (acquisition → premium) while keeping the default path cost-efficient and globally distributed."}]}],"id":"blk-34331","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34333","kind":"heading","level":3,"spans":[{"id":"spn-38767","text":"3.3 Why requests-first enforcement is acceptable for v1"}]},{"id":"blk-34334","items":[{"blocks":[{"id":"blk-34336","kind":"paragraph","spans":[{"id":"spn-38768","text":"Requests are the most immediate and reliable pre-invocation signal."}]}],"id":"blk-34335","kind":"list-item"},{"blocks":[{"id":"blk-34338","kind":"paragraph","spans":[{"id":"spn-38769","text":"Accurate tokens/compute budgets require predictive reservation or “post-charge” logic, which is more complex and varies by runtime."}]}],"id":"blk-34337","kind":"list-item"},{"blocks":[{"id":"blk-34340","kind":"paragraph","spans":[{"id":"spn-38770","text":"v1 still ensures tokens/compute budgets are enforced over time (subsequent blocking), which is sufficient to prevent ongoing overuse."}]}],"id":"blk-34339","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34341","kind":"heading","level":3,"spans":[{"id":"spn-38771","text":"3.4 Why we still plan for reservation"}]},{"id":"blk-34342","kind":"paragraph","spans":[{"id":"spn-38772","text":"For AgentCore, a single invocation can be expensive. Reservation provides better pre-flight protection:"}]},{"id":"blk-34343","items":[{"blocks":[{"id":"blk-34345","kind":"paragraph","spans":[{"id":"spn-38773","text":"reserve predicted tokens/compute,"}]}],"id":"blk-34344","kind":"list-item"},{"blocks":[{"id":"blk-34347","kind":"paragraph","spans":[{"id":"spn-38774","text":"reject if budget cannot cover expected cost,"}]}],"id":"blk-34346","kind":"list-item"},{"blocks":[{"id":"blk-34349","kind":"paragraph","spans":[{"id":"spn-38775","text":"reconcile after invocation."}]}],"id":"blk-34348","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34350","kind":"paragraph","spans":[{"id":"spn-38776","text":"We accept requests-first in v1 but design data models and APIs to allow reservation without breaking changes (e.g., counters and “pending usage” concepts)."}]},{"id":"blk-34351","kind":"heading","level":2,"spans":[{"id":"spn-38777","text":"4) Alternatives considered"}]},{"id":"blk-34352","kind":"heading","level":3,"spans":[{"id":"spn-38778","text":"A) No limits (reject)"}]},{"id":"blk-34353","kind":"paragraph","spans":[{"id":"spn-38779","text":"Pros:"}]},{"id":"blk-34354","items":[{"blocks":[{"id":"blk-34356","kind":"paragraph","spans":[{"id":"spn-38780","text":"simplest experience"}]}],"id":"blk-34355","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34357","kind":"paragraph","spans":[{"id":"spn-38781","text":"Cons:"}]},{"id":"blk-34358","items":[{"blocks":[{"id":"blk-34360","kind":"paragraph","spans":[{"id":"spn-38782","text":"unacceptable cost and abuse exposure"}]}],"id":"blk-34359","kind":"list-item"},{"blocks":[{"id":"blk-34362","kind":"paragraph","spans":[{"id":"spn-38783","text":"no pricing integrity"}]}],"id":"blk-34361","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34363","kind":"paragraph","spans":[{"id":"spn-38784","text":"Rejected."}]},{"id":"blk-34364","kind":"heading","level":3,"spans":[{"id":"spn-38785","text":"B) Pre-reservation for all dimensions in v1 (defer)"}]},{"id":"blk-34365","kind":"paragraph","spans":[{"id":"spn-38786","text":"Pros:"}]},{"id":"blk-34366","items":[{"blocks":[{"id":"blk-34368","kind":"paragraph","spans":[{"id":"spn-38787","text":"best cost control and fewer “single request blows budget” events"}]}],"id":"blk-34367","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34369","kind":"paragraph","spans":[{"id":"spn-38788","text":"Cons:"}]},{"id":"blk-34370","items":[{"blocks":[{"id":"blk-34372","kind":"paragraph","spans":[{"id":"spn-38789","text":"requires good prediction of tokens/compute, which is inherently uncertain"}]}],"id":"blk-34371","kind":"list-item"},{"blocks":[{"id":"blk-34374","kind":"paragraph","spans":[{"id":"spn-38790","text":"requires stronger atomic counters and reconciliation logic"}]}],"id":"blk-34373","kind":"list-item"},{"blocks":[{"id":"blk-34376","kind":"paragraph","spans":[{"id":"spn-38791","text":"increases complexity and time-to-market"}]}],"id":"blk-34375","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34377","kind":"paragraph","spans":[{"id":"spn-38792","text":"Deferred; recommended as a post-v1 enhancement, and potentially as a “AgentCore-only” enhancement sooner."}]},{"id":"blk-34378","kind":"heading","level":3,"spans":[{"id":"spn-38793","text":"C) Provider-side enforcement only (reject)"}]},{"id":"blk-34379","kind":"paragraph","spans":[{"id":"spn-38794","text":"Pros:"}]},{"id":"blk-34380","items":[{"blocks":[{"id":"blk-34382","kind":"paragraph","spans":[{"id":"spn-38795","text":"offload to providers"}]}],"id":"blk-34381","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34383","kind":"paragraph","spans":[{"id":"spn-38796","text":"Cons:"}]},{"id":"blk-34384","items":[{"blocks":[{"id":"blk-34386","kind":"paragraph","spans":[{"id":"spn-38797","text":"providers don’t enforce webhost.systems tier semantics"}]}],"id":"blk-34385","kind":"list-item"},{"blocks":[{"id":"blk-34388","kind":"paragraph","spans":[{"id":"spn-38798","text":"cannot unify multi-runtime behavior"}]}],"id":"blk-34387","kind":"list-item"},{"blocks":[{"id":"blk-34390","kind":"paragraph","spans":[{"id":"spn-38799","text":"cannot prevent cross-runtime abuse and cannot provide unified UX"}]}],"id":"blk-34389","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34391","kind":"paragraph","spans":[{"id":"spn-38800","text":"Rejected."}]},{"id":"blk-34392","kind":"heading","level":3,"spans":[{"id":"spn-38801","text":"D) Soft limits with overage billing from day one (defer)"}]},{"id":"blk-34393","kind":"paragraph","spans":[{"id":"spn-38802","text":"Pros:"}]},{"id":"blk-34394","items":[{"blocks":[{"id":"blk-34396","kind":"paragraph","spans":[{"id":"spn-38803","text":"better UX (fewer blocks), potential revenue upside"}]}],"id":"blk-34395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34397","kind":"paragraph","spans":[{"id":"spn-38804","text":"Cons:"}]},{"id":"blk-34398","items":[{"blocks":[{"id":"blk-34400","kind":"paragraph","spans":[{"id":"spn-38805","text":"requires accurate reconciliation, payment handling, dispute workflows"}]}],"id":"blk-34399","kind":"list-item"},{"blocks":[{"id":"blk-34402","kind":"paragraph","spans":[{"id":"spn-38806","text":"increases complexity and compliance surface"}]}],"id":"blk-34401","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34403","kind":"paragraph","spans":[{"id":"spn-38807","text":"Deferred; start with hard-stop in v1."}]},{"id":"blk-34404","kind":"heading","level":2,"spans":[{"id":"spn-38808","text":"5) Consequences"}]},{"id":"blk-34405","kind":"heading","level":3,"spans":[{"id":"spn-38809","text":"Positive"}]},{"id":"blk-34406","items":[{"blocks":[{"id":"blk-34408","kind":"paragraph","spans":[{"id":"spn-38810","text":"Clear, predictable tier behavior."}]}],"id":"blk-34407","kind":"list-item"},{"blocks":[{"id":"blk-34410","kind":"paragraph","spans":[{"id":"spn-38811","text":"Strong control of premium runtime access."}]}],"id":"blk-34409","kind":"list-item"},{"blocks":[{"id":"blk-34412","kind":"paragraph","spans":[{"id":"spn-38812","text":"Requests hard-stop prevents the most common abuse patterns."}]}],"id":"blk-34411","kind":"list-item"},{"blocks":[{"id":"blk-34414","kind":"paragraph","spans":[{"id":"spn-38813","text":"Compatible with future improvements (reservation, overages, public invocations)."}]}],"id":"blk-34413","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34415","kind":"heading","level":3,"spans":[{"id":"spn-38814","text":"Negative / tradeoffs"}]},{"id":"blk-34416","items":[{"blocks":[{"id":"blk-34418","kind":"paragraph","spans":[{"id":"spn-38815","text":"A user may exceed token/compute budget within a single request in v1 (especially on premium runtime), then be blocked afterwards."}]}],"id":"blk-34417","kind":"list-item"},{"blocks":[{"id":"blk-34420","kind":"paragraph","spans":[{"id":"spn-38816","text":"Telemetry delays can cause temporary undercounting until aggregation catches up."}]}],"id":"blk-34419","kind":"list-item"},{"blocks":[{"id":"blk-34422","kind":"paragraph","spans":[{"id":"spn-38817","text":"Concurrency can cause minor overrun near boundaries unless atomic counters are implemented."}]}],"id":"blk-34421","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34423","kind":"heading","level":2,"spans":[{"id":"spn-38818","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-34424","kind":"heading","level":3,"spans":[{"id":"spn-38819","text":"6.1 Entitlements representation"}]},{"id":"blk-34425","kind":"paragraph","spans":[{"id":"spn-38820","text":"The system MUST have a function (or module) equivalent to:"}]},{"id":"blk-34426","items":[{"blocks":[{"id":"blk-34428","kind":"paragraph","spans":[{"id":"spn-38821","marks":["code"],"text":"getEntitlementsForTier(tier) -> { limits, runtimeAccess, retention }"}]}],"id":"blk-34427","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34429","kind":"paragraph","spans":[{"id":"spn-38822","text":"It MUST be deterministic, server-only, and auditable (config changes tracked via code review or admin change logs)."}]},{"id":"blk-34430","kind":"heading","level":3,"spans":[{"id":"spn-38823","text":"6.2 Period definition"}]},{"id":"blk-34431","kind":"paragraph","spans":[{"id":"spn-38824","text":"v1 MUST standardize billing periods. Recommendation:"}]},{"id":"blk-34432","items":[{"blocks":[{"id":"blk-34434","kind":"paragraph","spans":[{"id":"spn-38825","text":"calendar-month "},{"id":"spn-38826","marks":["code"],"text":"YYYY-MM"},{"id":"spn-38827","text":" as "},{"id":"spn-38828","marks":["code"],"text":"periodKey"}]}],"id":"blk-34433","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34435","kind":"paragraph","spans":[{"id":"spn-38829","text":"If subscription-aligned periods are implemented later, ensure backward compatibility in reporting."}]},{"id":"blk-34436","kind":"heading","level":3,"spans":[{"id":"spn-38830","text":"6.3 Invocation enforcement algorithm (v1)"}]},{"id":"blk-34437","kind":"paragraph","spans":[{"id":"spn-38831","text":"At invocation start (before provider call): 1. Resolve authenticated user. 2. Resolve agent; enforce ownership; ensure not disabled/deleted. 3. Resolve active deployment; ensure valid state. 4. Load entitlements for user tier. 5. Enforce runtime gating:"}]},{"id":"blk-34438","items":[{"blocks":[{"id":"blk-34440","kind":"paragraph","spans":[{"id":"spn-38832","text":"if deployment runtime is "},{"id":"spn-38833","marks":["code"],"text":"agentcore"},{"id":"spn-38834","text":" and "},{"id":"spn-38835","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-38836","text":", reject."}]}],"id":"blk-34439","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34441","kind":"paragraph","spans":[{"id":"spn-38837","text":"6. Load current period usage totals (from aggregated "},{"id":"spn-38838","marks":["code"],"text":"billingUsage"},{"id":"spn-38839","text":" and/or fast counters). 7. Enforce requests limit:"}]},{"id":"blk-34442","items":[{"blocks":[{"id":"blk-34444","kind":"paragraph","spans":[{"id":"spn-38840","text":"if requests already at/over limit, reject with "},{"id":"spn-38841","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-38842","text":"."}]}],"id":"blk-34443","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34445","kind":"paragraph","spans":[{"id":"spn-38843","text":"8. Proceed to provider invocation."}]},{"id":"blk-34446","kind":"paragraph","spans":[{"id":"spn-38844","text":"After invocation:"}]},{"id":"blk-34447","items":[{"blocks":[{"id":"blk-34449","kind":"paragraph","spans":[{"id":"spn-38845","text":"Ensure telemetry is recorded (directly from runtime or adapter-side)."}]}],"id":"blk-34448","kind":"list-item"},{"blocks":[{"id":"blk-34451","kind":"paragraph","spans":[{"id":"spn-38846","text":"Aggregation updates period totals."}]}],"id":"blk-34450","kind":"list-item"},{"blocks":[{"id":"blk-34453","kind":"paragraph","spans":[{"id":"spn-38847","text":"If tokens/compute exceed budgets:"}]}],"id":"blk-34452","kind":"list-item"},{"blocks":[{"id":"blk-34455","kind":"paragraph","spans":[{"id":"spn-38848","text":"subsequent invocations MUST be rejected until next period or upgrade."}]}],"id":"blk-34454","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34456","kind":"heading","level":3,"spans":[{"id":"spn-38849","text":"6.4 Deploy-time enforcement"}]},{"id":"blk-34457","kind":"paragraph","spans":[{"id":"spn-38850","text":"At deploy start:"}]},{"id":"blk-34458","items":[{"blocks":[{"id":"blk-34460","kind":"paragraph","spans":[{"id":"spn-38851","text":"Load entitlements."}]}],"id":"blk-34459","kind":"list-item"},{"blocks":[{"id":"blk-34462","kind":"paragraph","spans":[{"id":"spn-38852","text":"Enforce runtime gating (AgentCore enabled)."}]}],"id":"blk-34461","kind":"list-item"},{"blocks":[{"id":"blk-34464","kind":"paragraph","spans":[{"id":"spn-38853","text":"Enforce any deploy-related caps (optional in v1; e.g., max agents or deployments)."}]}],"id":"blk-34463","kind":"list-item"},{"blocks":[{"id":"blk-34466","kind":"paragraph","spans":[{"id":"spn-38854","text":"Create deployment record and proceed."}]}],"id":"blk-34465","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34467","kind":"heading","level":3,"spans":[{"id":"spn-38855","text":"6.5 Concurrency and counters (minimum vs recommended)"}]},{"id":"blk-34468","kind":"paragraph","spans":[{"id":"spn-38856","text":"Minimum acceptable v1:"}]},{"id":"blk-34469","items":[{"blocks":[{"id":"blk-34471","kind":"paragraph","spans":[{"id":"spn-38857","text":"Use aggregated usage totals and accept small overruns under concurrency."}]}],"id":"blk-34470","kind":"list-item"},{"blocks":[{"id":"blk-34473","kind":"paragraph","spans":[{"id":"spn-38858","text":"Ensure the system never systematically undercounts."}]}],"id":"blk-34472","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34474","kind":"paragraph","spans":[{"id":"spn-38859","text":"Recommended:"}]},{"id":"blk-34475","items":[{"blocks":[{"id":"blk-34477","kind":"paragraph","spans":[{"id":"spn-38860","text":"Maintain an atomic per-user per-period counter for "},{"id":"spn-38861","marks":["code"],"text":"requests"},{"id":"spn-38862","text":"."}]}],"id":"blk-34476","kind":"list-item"},{"blocks":[{"id":"blk-34479","kind":"paragraph","spans":[{"id":"spn-38863","text":"Optionally maintain token/compute counters as well."}]}],"id":"blk-34478","kind":"list-item"},{"blocks":[{"id":"blk-34481","kind":"paragraph","spans":[{"id":"spn-38864","text":"If counters are implemented, ensure idempotency under retries and telemetry dedupe."}]}],"id":"blk-34480","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34482","kind":"heading","level":3,"spans":[{"id":"spn-38865","text":"6.6 Telemetry integrity dependency"}]},{"id":"blk-34483","kind":"paragraph","spans":[{"id":"spn-38866","text":"This ADR depends on ADR-0004 (telemetry integrity). Limit enforcement based on usage requires trustworthy telemetry:"}]},{"id":"blk-34484","items":[{"blocks":[{"id":"blk-34486","kind":"paragraph","spans":[{"id":"spn-38867","text":"signed events per deployment,"}]}],"id":"blk-34485","kind":"list-item"},{"blocks":[{"id":"blk-34488","kind":"paragraph","spans":[{"id":"spn-38868","text":"ownership cross-check."}]}],"id":"blk-34487","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34489","kind":"heading","level":3,"spans":[{"id":"spn-38869","text":"6.7 Observability and UX requirements"}]},{"id":"blk-34490","kind":"paragraph","spans":[{"id":"spn-38870","text":"When rejecting for limits/gating:"}]},{"id":"blk-34491","items":[{"blocks":[{"id":"blk-34493","kind":"paragraph","spans":[{"id":"spn-38871","text":"include enough detail to explain why,"}]}],"id":"blk-34492","kind":"list-item"},{"blocks":[{"id":"blk-34495","kind":"paragraph","spans":[{"id":"spn-38872","text":"suggest an upgrade path,"}]}],"id":"blk-34494","kind":"list-item"},{"blocks":[{"id":"blk-34497","kind":"paragraph","spans":[{"id":"spn-38873","text":"never leak confidential internal state."}]}],"id":"blk-34496","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34498","kind":"paragraph","spans":[{"id":"spn-38874","text":"The dashboard MUST show:"}]},{"id":"blk-34499","items":[{"blocks":[{"id":"blk-34501","kind":"paragraph","spans":[{"id":"spn-38875","text":"current tier and limits,"}]}],"id":"blk-34500","kind":"list-item"},{"blocks":[{"id":"blk-34503","kind":"paragraph","spans":[{"id":"spn-38876","text":"current usage totals,"}]}],"id":"blk-34502","kind":"list-item"},{"blocks":[{"id":"blk-34505","kind":"paragraph","spans":[{"id":"spn-38877","text":"per-runtime breakdown,"}]}],"id":"blk-34504","kind":"list-item"},{"blocks":[{"id":"blk-34507","kind":"paragraph","spans":[{"id":"spn-38878","text":"“estimated” cost labeling."}]}],"id":"blk-34506","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34508","kind":"heading","level":2,"spans":[{"id":"spn-38879","text":"7) Testing requirements (acceptance-focused)"}]},{"id":"blk-34509","kind":"heading","level":3,"spans":[{"id":"spn-38880","text":"MUST"}]},{"id":"blk-34510","items":[{"blocks":[{"id":"blk-34512","kind":"paragraph","spans":[{"id":"spn-38881","text":"E2E: requests limit blocks invocations with "},{"id":"spn-38882","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-38883","text":"."}]}],"id":"blk-34511","kind":"list-item"},{"blocks":[{"id":"blk-34514","kind":"paragraph","spans":[{"id":"spn-38884","text":"Integration: AgentCore deploy/invoke blocked for non-entitled tiers."}]}],"id":"blk-34513","kind":"list-item"},{"blocks":[{"id":"blk-34516","kind":"paragraph","spans":[{"id":"spn-38885","text":"Unit: entitlements mapping returns expected limits and gating behavior."}]}],"id":"blk-34515","kind":"list-item"},{"blocks":[{"id":"blk-34518","kind":"paragraph","spans":[{"id":"spn-38886","text":"Integration: deploy-time gating prevents provider calls to AgentCore."}]}],"id":"blk-34517","kind":"list-item"},{"blocks":[{"id":"blk-34520","kind":"paragraph","spans":[{"id":"spn-38887","text":"Security: clients cannot modify tier or entitlements; only webhook-verified updates are effective."}]}],"id":"blk-34519","kind":"list-item"}],"kind":"list","order