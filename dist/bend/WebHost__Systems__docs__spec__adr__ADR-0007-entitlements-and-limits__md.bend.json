{"bendscript":"0.1","blocks":[{"id":"blk-33641","kind":"heading","level":1,"spans":[{"id":"spn-37460","text":"ADR-0007: Tier Entitlements, Runtime Gating, and Limit Enforcement Strategy"}]},{"id":"blk-33642","kind":"paragraph","spans":[{"id":"spn-37461","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-33643","items":[{"blocks":[{"id":"blk-33645","kind":"paragraph","spans":[{"id":"spn-37462","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-33644","kind":"list-item"},{"blocks":[{"id":"blk-33647","kind":"paragraph","spans":[{"id":"spn-37463","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-33646","kind":"list-item"},{"blocks":[{"id":"blk-33649","kind":"paragraph","spans":[{"id":"spn-37464","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-33648","kind":"list-item"},{"blocks":[{"id":"blk-33651","kind":"paragraph","spans":[{"id":"spn-37465","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-33650","kind":"list-item"},{"blocks":[{"id":"blk-33653","kind":"paragraph","spans":[{"id":"spn-37466","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-33652","kind":"list-item"},{"blocks":[{"id":"blk-33655","kind":"paragraph","spans":[{"id":"spn-37467","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-33654","kind":"list-item"},{"blocks":[{"id":"blk-33657","kind":"paragraph","spans":[{"id":"spn-37468","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-33656","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33658","kind":"heading","level":2,"spans":[{"id":"spn-37469","text":"1) Context"}]},{"id":"blk-33659","kind":"paragraph","spans":[{"id":"spn-37470","text":"webhost.systems is a multi-runtime AI agent platform. The control plane must:"}]},{"id":"blk-33660","items":[{"blocks":[{"id":"blk-33662","kind":"paragraph","spans":[{"id":"spn-37471","text":"monetize via subscription tiers,"}]}],"id":"blk-33661","kind":"list-item"},{"blocks":[{"id":"blk-33664","kind":"paragraph","spans":[{"id":"spn-37472","text":"enforce tenant entitlements and limits in a way that protects platform cost exposure,"}]}],"id":"blk-33663","kind":"list-item"},{"blocks":[{"id":"blk-33666","kind":"paragraph","spans":[{"id":"spn-37473","text":"gate access to premium runtime providers (AWS Bedrock AgentCore),"}]}],"id":"blk-33665","kind":"list-item"},{"blocks":[{"id":"blk-33668","kind":"paragraph","spans":[{"id":"spn-37474","text":"provide predictable, explainable behavior to users and support."}]}],"id":"blk-33667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33669","kind":"paragraph","spans":[{"id":"spn-37475","text":"The platform has heterogeneous cost profiles by runtime:"}]},{"id":"blk-33670","items":[{"blocks":[{"id":"blk-33672","kind":"paragraph","spans":[{"id":"spn-37476","marks":["bold"],"text":"Cloudflare Workers/DO"},{"id":"spn-37477","text":" supports a broad set of use cases with favorable economics and global edge distribution, enabling acquisition tiers (including free)."}]}],"id":"blk-33671","kind":"list-item"},{"blocks":[{"id":"blk-33674","kind":"paragraph","spans":[{"id":"spn-37478","text":"TypeScript-first: Workers/DO are TypeScript-friendly and support modern agent frameworks naturally."}]}],"id":"blk-33673","kind":"list-item"},{"blocks":[{"id":"blk-33676","kind":"paragraph","spans":[{"id":"spn-37479","marks":["bold"],"text":"AWS Bedrock AgentCore"},{"id":"spn-37480","text":" supports premium enterprise capabilities (long running sessions, stronger isolation, built-in tools), but has higher marginal cost and different operational constraints."}]}],"id":"blk-33675","kind":"list-item"},{"blocks":[{"id":"blk-33678","kind":"paragraph","spans":[{"id":"spn-37481","text":"TypeScript-first: AgentCore has first-class TypeScript SDK support for runtime operations and modern tooling integration:"}]}],"id":"blk-33677","kind":"list-item"},{"blocks":[{"id":"blk-33680","kind":"paragraph","spans":[{"id":"spn-37482","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-37483","text":" (TypeScript) for management and invocation"}]}],"id":"blk-33679","kind":"list-item"},{"blocks":[{"id":"blk-33682","kind":"paragraph","spans":[{"id":"spn-37484","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-37485","text":" (TypeScript) for built-in tools (e.g., Code Interpreter and Browser), with integration paths for modern agent frameworks (e.g., Vercel AI SDK)"}]}],"id":"blk-33681","kind":"list-item"},{"blocks":[{"id":"blk-33684","kind":"paragraph","spans":[{"id":"spn-37486","text":"Premium value drivers beyond runtime length:"}]}],"id":"blk-33683","kind":"list-item"},{"blocks":[{"id":"blk-33686","kind":"paragraph","spans":[{"id":"spn-37487","text":"built-in tool ecosystem (code execution + browser automation) that is otherwise “DIY” on many runtimes"}]}],"id":"blk-33685","kind":"list-item"},{"blocks":[{"id":"blk-33688","kind":"paragraph","spans":[{"id":"spn-37488","text":"enterprise isolation posture aligned with higher-tier requirements"}]}],"id":"blk-33687","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33689","kind":"paragraph","spans":[{"id":"spn-37489","text":"Limits are required for:"}]},{"id":"blk-33690","items":[{"blocks":[{"id":"blk-33692","kind":"paragraph","spans":[{"id":"spn-37490","text":"preventing runaway cost and abuse,"}]}],"id":"blk-33691","kind":"list-item"},{"blocks":[{"id":"blk-33694","kind":"paragraph","spans":[{"id":"spn-37491","text":"ensuring fairness and QoS,"}]}],"id":"blk-33693","kind":"list-item"},{"blocks":[{"id":"blk-33696","kind":"paragraph","spans":[{"id":"spn-37492","text":"aligning tier pricing with usage."}]}],"id":"blk-33695","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33697","kind":"paragraph","spans":[{"id":"spn-37493","text":"Key constraints:"}]},{"id":"blk-33698","items":[{"blocks":[{"id":"blk-33700","kind":"paragraph","spans":[{"id":"spn-37494","text":"Actual token usage and compute time are not known until after the invocation completes."}]}],"id":"blk-33699","kind":"list-item"},{"blocks":[{"id":"blk-33702","kind":"paragraph","spans":[{"id":"spn-37495","text":"Telemetry ingestion is asynchronous and may be delayed or fail transiently."}]}],"id":"blk-33701","kind":"list-item"},{"blocks":[{"id":"blk-33704","kind":"paragraph","spans":[{"id":"spn-37496","text":"Concurrency (multiple simultaneous invocations) can race around limit boundaries."}]}],"id":"blk-33703","kind":"list-item"},{"blocks":[{"id":"blk-33706","kind":"paragraph","spans":[{"id":"spn-37497","text":"Security requirements prohibit relying on client-provided usage or tier claims."}]}],"id":"blk-33705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33707","kind":"paragraph","spans":[{"id":"spn-37498","text":"Therefore, v1 needs a robust entitlement model and a limit enforcement strategy that is safe, implementable, and extensible."}]},{"id":"blk-33708","kind":"heading","level":2,"spans":[{"id":"spn-37499","text":"2) Decision"}]},{"id":"blk-33709","kind":"heading","level":3,"spans":[{"id":"spn-37500","text":"2.1 Adopt a configuration-driven entitlement model (server authoritative)"}]},{"id":"blk-33710","kind":"paragraph","spans":[{"id":"spn-37501","text":"Entitlements are represented as a server-side configuration mapping a user’s current tier to a set of allowed capabilities and budgets. Entitlements MUST be treated as "},{"id":"spn-37502","marks":["bold"],"text":"authoritative"},{"id":"spn-37503","text":" on the server; the client/UI is advisory only."}]},{"id":"blk-33711","kind":"paragraph","spans":[{"id":"spn-37504","text":"Each tier defines (minimum):"}]},{"id":"blk-33712","items":[{"blocks":[{"id":"blk-33714","kind":"paragraph","spans":[{"id":"spn-37505","marks":["code"],"text":"maxRequestsPerPeriod"}]}],"id":"blk-33713","kind":"list-item"},{"blocks":[{"id":"blk-33716","kind":"paragraph","spans":[{"id":"spn-37506","marks":["code"],"text":"maxTokensPerPeriod"},{"id":"spn-37507","text":" (reported or estimated)"}]}],"id":"blk-33715","kind":"list-item"},{"blocks":[{"id":"blk-33718","kind":"paragraph","spans":[{"id":"spn-37508","marks":["code"],"text":"maxComputeMsPerPeriod"}]}],"id":"blk-33717","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33719","kind":"paragraph","spans":[{"id":"spn-37509","text":"Runtime access + capabilities:"}]},{"id":"blk-33720","items":[{"blocks":[{"id":"blk-33722","kind":"paragraph","spans":[{"id":"spn-37510","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-37511","text":" (boolean) — whether the user may deploy/invoke on AgentCore at all"}]}],"id":"blk-33721","kind":"list-item"},{"blocks":[{"id":"blk-33724","kind":"paragraph","spans":[{"id":"spn-37512","marks":["code"],"text":"memoryEnabled"},{"id":"spn-37513","text":" (boolean) — whether AgentCore Memory features may be enabled for deployments"}]}],"id":"blk-33723","kind":"list-item"},{"blocks":[{"id":"blk-33726","kind":"paragraph","spans":[{"id":"spn-37514","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-37515","text":" (boolean) — whether AgentCore Code Interpreter tools may be enabled for deployments"}]}],"id":"blk-33725","kind":"list-item"},{"blocks":[{"id":"blk-33728","kind":"paragraph","spans":[{"id":"spn-37516","marks":["code"],"text":"browserEnabled"},{"id":"spn-37517","text":" (boolean) — whether AgentCore Browser tools may be enabled for deployments"}]}],"id":"blk-33727","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33729","kind":"paragraph","spans":[{"id":"spn-37518","text":"Tool quotas (only meaningful if tools are enabled; omitted or set to 0 when disabled):"}]},{"id":"blk-33730","items":[{"blocks":[{"id":"blk-33732","kind":"paragraph","spans":[{"id":"spn-37519","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-37520","text":" (number, optional)"}]}],"id":"blk-33731","kind":"list-item"},{"blocks":[{"id":"blk-33734","kind":"paragraph","spans":[{"id":"spn-37521","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-37522","text":" (number, optional)"}]}],"id":"blk-33733","kind":"list-item"},{"blocks":[{"id":"blk-33736","kind":"paragraph","spans":[{"id":"spn-37523","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-37524","text":" (number, optional)"}]}],"id":"blk-33735","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33737","kind":"paragraph","spans":[{"id":"spn-37525","text":"Retention policies:"}]},{"id":"blk-33738","items":[{"blocks":[{"id":"blk-33740","kind":"paragraph","spans":[{"id":"spn-37526","text":"telemetry/logs retention days"}]}],"id":"blk-33739","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33741","kind":"paragraph","spans":[{"id":"spn-37527","text":"Entitlements MUST be stored and evaluated in a way that can be changed without code edits (e.g., configuration file/env, DB table, or feature flag system). Exact storage choice is implementation detail, but it MUST be server-controlled and auditable."}]},{"id":"blk-33742","kind":"heading","level":3,"spans":[{"id":"spn-37528","text":"2.2 Tier gating rules: runtime access is an entitlement (defense in depth)"}]},{"id":"blk-33743","kind":"paragraph","spans":[{"id":"spn-37529","text":"Runtime access is gated by entitlements:"}]},{"id":"blk-33744","items":[{"blocks":[{"id":"blk-33746","kind":"paragraph","spans":[{"id":"spn-37530","text":"If "},{"id":"spn-37531","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-37532","text":", then:"}]}],"id":"blk-33745","kind":"list-item"},{"blocks":[{"id":"blk-33748","kind":"paragraph","spans":[{"id":"spn-37533","text":"deploy to "},{"id":"spn-37534","marks":["code"],"text":"runtimeProvider=agentcore"},{"id":"spn-37535","text":" MUST be rejected, and"}]}],"id":"blk-33747","kind":"list-item"},{"blocks":[{"id":"blk-33750","kind":"paragraph","spans":[{"id":"spn-37536","text":"invoke routed to an AgentCore deployment MUST be rejected, and"}]}],"id":"blk-33749","kind":"list-item"},{"blocks":[{"id":"blk-33752","kind":"paragraph","spans":[{"id":"spn-37537","text":"any attempt to switch an agent’s runtimeProvider to "},{"id":"spn-37538","marks":["code"],"text":"agentcore"},{"id":"spn-37539","text":" SHOULD be rejected (v1 recommendation: reject to reduce confusion)."}]}],"id":"blk-33751","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33753","items":[{"blocks":[{"id":"blk-33755","kind":"paragraph","spans":[{"id":"spn-37540","text":"If "},{"id":"spn-37541","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-37542","text":", AgentCore capability flags MUST still be enforced:"}]}],"id":"blk-33754","kind":"list-item"},{"blocks":[{"id":"blk-33757","kind":"paragraph","spans":[{"id":"spn-37543","text":"If "},{"id":"spn-37544","marks":["code"],"text":"codeInterpreterEnabled=false"},{"id":"spn-37545","text":", deployments MUST NOT enable code interpreter tooling, and invocations MUST be treated as “tools unavailable” (no tool loop) even if user code requests it."}]}],"id":"blk-33756","kind":"list-item"},{"blocks":[{"id":"blk-33759","kind":"paragraph","spans":[{"id":"spn-37546","text":"If "},{"id":"spn-37547","marks":["code"],"text":"browserEnabled=false"},{"id":"spn-37548","text":", deployments MUST NOT enable browser tooling, and invocations MUST be treated as “tools unavailable” for browser interactions."}]}],"id":"blk-33758","kind":"list-item"},{"blocks":[{"id":"blk-33761","kind":"paragraph","spans":[{"id":"spn-37549","text":"If "},{"id":"spn-37550","marks":["code"],"text":"memoryEnabled=false"},{"id":"spn-37551","text":", deployments MUST NOT enable provider memory features."}]}],"id":"blk-33760","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33762","kind":"paragraph","spans":[{"id":"spn-37552","marks":["bold"],"text":"v1 recommendation (tools): enterprise-only"}]},{"id":"blk-33763","items":[{"blocks":[{"id":"blk-33765","kind":"paragraph","spans":[{"id":"spn-37553","text":"v1 SHOULD enable AgentCore tools ("},{"id":"spn-37554","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-37555","text":" and "},{"id":"spn-37556","marks":["code"],"text":"browserEnabled"},{"id":"spn-37557","text":") only on the "},{"id":"spn-37558","marks":["code"],"text":"enterprise"},{"id":"spn-37559","text":" tier."}]}],"id":"blk-33764","kind":"list-item"},{"blocks":[{"id":"blk-33767","kind":"paragraph","spans":[{"id":"spn-37560","text":"v1 MAY allow "},{"id":"spn-37561","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-37562","text":" on "},{"id":"spn-37563","marks":["code"],"text":"pro"},{"id":"spn-37564","text":" while keeping tools disabled (and optionally allowing "},{"id":"spn-37565","marks":["code"],"text":"memoryEnabled=true"},{"id":"spn-37566","text":" if cost/behavior is acceptable)."}]}],"id":"blk-33766","kind":"list-item"},{"blocks":[{"id":"blk-33769","kind":"paragraph","spans":[{"id":"spn-37567","text":"If you later enable tools for "},{"id":"spn-37568","marks":["code"],"text":"pro"},{"id":"spn-37569","text":", you MUST add explicit tool quotas ("},{"id":"spn-37570","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-37571","text":", "},{"id":"spn-37572","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-37573","text":", "},{"id":"spn-37574","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-37575","text":") and enforce them at invoke time."}]}],"id":"blk-33768","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33770","kind":"paragraph","spans":[{"id":"spn-37576","text":"This gating MUST be enforced at three layers (defense in depth): 1. "},{"id":"spn-37577","marks":["bold"],"text":"UI layer"},{"id":"spn-37578","text":": hide/disable options (non-authoritative) 2. "},{"id":"spn-37579","marks":["bold"],"text":"Control plane deploy/invoke APIs"},{"id":"spn-37580","text":": authoritative check before provider calls 3. "},{"id":"spn-37581","marks":["bold"],"text":"Runtime adapter layer"},{"id":"spn-37582","text":": refuse deploy/invoke if not entitled (in case of misrouting or bugs)"}]},{"id":"blk-33771","kind":"paragraph","spans":[{"id":"spn-37583","text":"The same three-layer enforcement applies to "},{"id":"spn-37584","marks":["bold"],"text":"AgentCore capability flags"},{"id":"spn-37585","text":" ("},{"id":"spn-37586","marks":["code"],"text":"memoryEnabled"},{"id":"spn-37587","text":", "},{"id":"spn-37588","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-37589","text":", "},{"id":"spn-37590","marks":["code"],"text":"browserEnabled"},{"id":"spn-37591","text":"):"}]},{"id":"blk-33772","items":[{"blocks":[{"id":"blk-33774","kind":"paragraph","spans":[{"id":"spn-37592","text":"UI MUST not present toggles the user is not entitled to."}]}],"id":"blk-33773","kind":"list-item"},{"blocks":[{"id":"blk-33776","kind":"paragraph","spans":[{"id":"spn-37593","text":"Deploy APIs MUST reject configurations that attempt to enable disallowed capabilities."}]}],"id":"blk-33775","kind":"list-item"},{"blocks":[{"id":"blk-33778","kind":"paragraph","spans":[{"id":"spn-37594","text":"Invoke routing MUST ensure a deployment cannot exercise disallowed capabilities (even if user code attempts to)."}]}],"id":"blk-33777","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33779","kind":"heading","level":3,"spans":[{"id":"spn-37595","text":"2.3 Limit enforcement strategy (v1): requests hard-stop + post-charge tokens/compute, with upgrade path to reservation"}]},{"id":"blk-33780","kind":"paragraph","spans":[{"id":"spn-37596","text":"v1 enforcement strategy is:"}]},{"id":"blk-33781","items":[{"blocks":[{"id":"blk-33783","kind":"paragraph","spans":[{"id":"spn-37597","marks":["bold"],"text":"Pre-invocation hard-stop on requests"},{"id":"spn-37598","text":" (MUST)."}]}],"id":"blk-33782","kind":"list-item"},{"blocks":[{"id":"blk-33785","kind":"paragraph","spans":[{"id":"spn-37599","marks":["bold"],"text":"Post-invocation accounting for tokens/compute"},{"id":"spn-37600","text":" via telemetry (MUST)."}]}],"id":"blk-33784","kind":"list-item"},{"blocks":[{"id":"blk-33787","kind":"paragraph","spans":[{"id":"spn-37601","marks":["bold"],"text":"Subsequent invocations blocked"},{"id":"spn-37602","text":" if tokens/compute budgets exceeded (MUST)."}]}],"id":"blk-33786","kind":"list-item"},{"blocks":[{"id":"blk-33789","kind":"paragraph","spans":[{"id":"spn-37603","marks":["bold"],"text":"Optional predictive reservation"},{"id":"spn-37604","text":" for expensive runtimes (SHOULD for AgentCore, MAY for Cloudflare) as an enhancement."}]}],"id":"blk-33788","kind":"list-item"},{"blocks":[{"id":"blk-33791","kind":"paragraph","spans":[{"id":"spn-37605","text":"AgentCore-specific note: because AgentCore can support longer-running workloads and built-in tools (code execution, browser automation), it may concentrate more cost into a single invocation. This makes reservation (or stricter pre-flight checks) more valuable for AgentCore tiers."}]}],"id":"blk-33790","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33792","kind":"paragraph","spans":[{"id":"spn-37606","text":"This is a deliberate v1 tradeoff:"}]},{"id":"blk-33793","items":[{"blocks":[{"id":"blk-33795","kind":"paragraph","spans":[{"id":"spn-37607","text":"It protects the platform from request floods (and thus most cost/abuse)."}]}],"id":"blk-33794","kind":"list-item"},{"blocks":[{"id":"blk-33797","kind":"paragraph","spans":[{"id":"spn-37608","text":"It keeps implementation complexity manageable while still meeting product needs."}]}],"id":"blk-33796","kind":"list-item"},{"blocks":[{"id":"blk-33799","kind":"paragraph","spans":[{"id":"spn-37609","text":"It provides a clear path to a stronger pre-reservation model without changing the external API."}]}],"id":"blk-33798","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33800","kind":"heading","level":3,"spans":[{"id":"spn-37610","text":"2.4 Enforcement point: invocation gateway is the primary cost-control boundary"}]},{"id":"blk-33801","kind":"paragraph","spans":[{"id":"spn-37611","text":"Limits MUST be enforced in the invocation gateway "},{"id":"spn-37612","marks":["bold"],"text":"before calling a runtime provider"},{"id":"spn-37613","text":" whenever possible. This prevents spending money on requests that will be rejected."}]},{"id":"blk-33802","kind":"paragraph","spans":[{"id":"spn-37614","text":"For v1:"}]},{"id":"blk-33803","items":[{"blocks":[{"id":"blk-33805","kind":"paragraph","spans":[{"id":"spn-37615","text":"Request count enforcement MUST happen before provider invocation."}]}],"id":"blk-33804","kind":"list-item"},{"blocks":[{"id":"blk-33807","kind":"paragraph","spans":[{"id":"spn-37616","text":"Token/compute enforcement MAY lag by up to telemetry ingestion delay; when exceeded, block subsequent requests."}]}],"id":"blk-33806","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33808","kind":"heading","level":3,"spans":[{"id":"spn-37617","text":"2.5 Consistent error semantics"}]},{"id":"blk-33809","kind":"paragraph","spans":[{"id":"spn-37618","text":"When a deploy or invoke is rejected due to entitlements or limits, the system MUST return a normalized error envelope with:"}]},{"id":"blk-33810","items":[{"blocks":[{"id":"blk-33812","kind":"paragraph","spans":[{"id":"spn-37619","marks":["code"],"text":"code = LIMIT_EXCEEDED"},{"id":"spn-37620","text":" (or a dedicated entitlement code if added later),"}]}],"id":"blk-33811","kind":"list-item"},{"blocks":[{"id":"blk-33814","kind":"paragraph","spans":[{"id":"spn-37621","text":"a safe user-displayable message,"}]}],"id":"blk-33813","kind":"list-item"},{"blocks":[{"id":"blk-33816","kind":"paragraph","spans":[{"id":"spn-37622","text":"details including:"}]}],"id":"blk-33815","kind":"list-item"},{"blocks":[{"id":"blk-33818","kind":"paragraph","spans":[{"id":"spn-37623","text":"limit type ("},{"id":"spn-37624","marks":["code"],"text":"requests"},{"id":"spn-37625","text":", "},{"id":"spn-37626","marks":["code"],"text":"tokens"},{"id":"spn-37627","text":", "},{"id":"spn-37628","marks":["code"],"text":"computeMs"},{"id":"spn-37629","text":", or "},{"id":"spn-37630","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-37631","text":" / "},{"id":"spn-37632","marks":["code"],"text":"runtimeGated"},{"id":"spn-37633","text":"),"}]}],"id":"blk-33817","kind":"list-item"},{"blocks":[{"id":"blk-33820","kind":"paragraph","spans":[{"id":"spn-37634","text":"period key,"}]}],"id":"blk-33819","kind":"list-item"},{"blocks":[{"id":"blk-33822","kind":"paragraph","spans":[{"id":"spn-37635","text":"current usage and limit where known,"}]}],"id":"blk-33821","kind":"list-item"},{"blocks":[{"id":"blk-33824","kind":"paragraph","spans":[{"id":"spn-37636","text":"suggested action (upgrade tier)."}]}],"id":"blk-33823","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33825","kind":"paragraph","spans":[{"id":"spn-37637","text":"HTTP status mapping is defined in "},{"id":"spn-37638","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-37639","text":"."}]},{"id":"blk-33826","kind":"heading","level":2,"spans":[{"id":"spn-37640","text":"3) Rationale"}]},{"id":"blk-33827","kind":"heading","level":3,"spans":[{"id":"spn-37641","text":"3.1 Why configuration-driven entitlements"}]},{"id":"blk-33828","items":[{"blocks":[{"id":"blk-33830","kind":"paragraph","spans":[{"id":"spn-37642","text":"Pricing and tiers will iterate frequently; hardcoding makes iteration risky and slow."}]}],"id":"blk-33829","kind":"list-item"},{"blocks":[{"id":"blk-33832","kind":"paragraph","spans":[{"id":"spn-37643","text":"Entitlements must be authoritative and auditable, independent of client behavior."}]}],"id":"blk-33831","kind":"list-item"},{"blocks":[{"id":"blk-33834","kind":"paragraph","spans":[{"id":"spn-37644","text":"A single entitlements surface simplifies UI gating, API checks, and support tooling."}]}],"id":"blk-33833","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33835","kind":"heading","level":3,"spans":[{"id":"spn-37645","text":"3.2 Why runtime gating is mandatory"}]},{"id":"blk-33836","items":[{"blocks":[{"id":"blk-33838","kind":"paragraph","spans":[{"id":"spn-37646","text":"AgentCore has a materially different cost and capability footprint."}]}],"id":"blk-33837","kind":"list-item"},{"blocks":[{"id":"blk-33840","kind":"paragraph","spans":[{"id":"spn-37647","text":"Capability: long-running sessions and built-in tools (e.g., code execution and browser automation) unlock workflows that are not “free” to operate."}]}],"id":"blk-33839","kind":"list-item"},{"blocks":[{"id":"blk-33842","kind":"paragraph","spans":[{"id":"spn-37648","text":"DX: AgentCore is viable for TypeScript-first teams via official TypeScript SDK support and tool integrations, which strengthens its premium value proposition."}]}],"id":"blk-33841","kind":"list-item"},{"blocks":[{"id":"blk-33844","kind":"paragraph","spans":[{"id":"spn-37649","text":"Allowing access without gating risks unbounded cost exposure, especially for long-running or tool-heavy workloads."}]}],"id":"blk-33843","kind":"list-item"},{"blocks":[{"id":"blk-33846","kind":"paragraph","spans":[{"id":"spn-37650","text":"Tier-based runtime gating enables a clear product ladder (acquisition → premium) while keeping the default path cost-efficient and globally distributed."}]}],"id":"blk-33845","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33847","kind":"heading","level":3,"spans":[{"id":"spn-37651","text":"3.3 Why requests-first enforcement is acceptable for v1"}]},{"id":"blk-33848","items":[{"blocks":[{"id":"blk-33850","kind":"paragraph","spans":[{"id":"spn-37652","text":"Requests are the most immediate and reliable pre-invocation signal."}]}],"id":"blk-33849","kind":"list-item"},{"blocks":[{"id":"blk-33852","kind":"paragraph","spans":[{"id":"spn-37653","text":"Accurate tokens/compute budgets require predictive reservation or “post-charge” logic, which is more complex and varies by runtime."}]}],"id":"blk-33851","kind":"list-item"},{"blocks":[{"id":"blk-33854","kind":"paragraph","spans":[{"id":"spn-37654","text":"v1 still ensures tokens/compute budgets are enforced over time (subsequent blocking), which is sufficient to prevent ongoing overuse."}]}],"id":"blk-33853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33855","kind":"heading","level":3,"spans":[{"id":"spn-37655","text":"3.4 Why we still plan for reservation"}]},{"id":"blk-33856","kind":"paragraph","spans":[{"id":"spn-37656","text":"For AgentCore, a single invocation can be expensive. Reservation provides better pre-flight protection:"}]},{"id":"blk-33857","items":[{"blocks":[{"id":"blk-33859","kind":"paragraph","spans":[{"id":"spn-37657","text":"reserve predicted tokens/compute,"}]}],"id":"blk-33858","kind":"list-item"},{"blocks":[{"id":"blk-33861","kind":"paragraph","spans":[{"id":"spn-37658","text":"reject if budget cannot cover expected cost,"}]}],"id":"blk-33860","kind":"list-item"},{"blocks":[{"id":"blk-33863","kind":"paragraph","spans":[{"id":"spn-37659","text":"reconcile after invocation."}]}],"id":"blk-33862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33864","kind":"paragraph","spans":[{"id":"spn-37660","text":"We accept requests-first in v1 but design data models and APIs to allow reservation without breaking changes (e.g., counters and “pending usage” concepts)."}]},{"id":"blk-33865","kind":"heading","level":2,"spans":[{"id":"spn-37661","text":"4) Alternatives considered"}]},{"id":"blk-33866","kind":"heading","level":3,"spans":[{"id":"spn-37662","text":"A) No limits (reject)"}]},{"id":"blk-33867","kind":"paragraph","spans":[{"id":"spn-37663","text":"Pros:"}]},{"id":"blk-33868","items":[{"blocks":[{"id":"blk-33870","kind":"paragraph","spans":[{"id":"spn-37664","text":"simplest experience"}]}],"id":"blk-33869","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33871","kind":"paragraph","spans":[{"id":"spn-37665","text":"Cons:"}]},{"id":"blk-33872","items":[{"blocks":[{"id":"blk-33874","kind":"paragraph","spans":[{"id":"spn-37666","text":"unacceptable cost and abuse exposure"}]}],"id":"blk-33873","kind":"list-item"},{"blocks":[{"id":"blk-33876","kind":"paragraph","spans":[{"id":"spn-37667","text":"no pricing integrity"}]}],"id":"blk-33875","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33877","kind":"paragraph","spans":[{"id":"spn-37668","text":"Rejected."}]},{"id":"blk-33878","kind":"heading","level":3,"spans":[{"id":"spn-37669","text":"B) Pre-reservation for all dimensions in v1 (defer)"}]},{"id":"blk-33879","kind":"paragraph","spans":[{"id":"spn-37670","text":"Pros:"}]},{"id":"blk-33880","items":[{"blocks":[{"id":"blk-33882","kind":"paragraph","spans":[{"id":"spn-37671","text":"best cost control and fewer “single request blows budget” events"}]}],"id":"blk-33881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33883","kind":"paragraph","spans":[{"id":"spn-37672","text":"Cons:"}]},{"id":"blk-33884","items":[{"blocks":[{"id":"blk-33886","kind":"paragraph","spans":[{"id":"spn-37673","text":"requires good prediction of tokens/compute, which is inherently uncertain"}]}],"id":"blk-33885","kind":"list-item"},{"blocks":[{"id":"blk-33888","kind":"paragraph","spans":[{"id":"spn-37674","text":"requires stronger atomic counters and reconciliation logic"}]}],"id":"blk-33887","kind":"list-item"},{"blocks":[{"id":"blk-33890","kind":"paragraph","spans":[{"id":"spn-37675","text":"increases complexity and time-to-market"}]}],"id":"blk-33889","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33891","kind":"paragraph","spans":[{"id":"spn-37676","text":"Deferred; recommended as a post-v1 enhancement, and potentially as a “AgentCore-only” enhancement sooner."}]},{"id":"blk-33892","kind":"heading","level":3,"spans":[{"id":"spn-37677","text":"C) Provider-side enforcement only (reject)"}]},{"id":"blk-33893","kind":"paragraph","spans":[{"id":"spn-37678","text":"Pros:"}]},{"id":"blk-33894","items":[{"blocks":[{"id":"blk-33896","kind":"paragraph","spans":[{"id":"spn-37679","text":"offload to providers"}]}],"id":"blk-33895","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33897","kind":"paragraph","spans":[{"id":"spn-37680","text":"Cons:"}]},{"id":"blk-33898","items":[{"blocks":[{"id":"blk-33900","kind":"paragraph","spans":[{"id":"spn-37681","text":"providers don’t enforce webhost.systems tier semantics"}]}],"id":"blk-33899","kind":"list-item"},{"blocks":[{"id":"blk-33902","kind":"paragraph","spans":[{"id":"spn-37682","text":"cannot unify multi-runtime behavior"}]}],"id":"blk-33901","kind":"list-item"},{"blocks":[{"id":"blk-33904","kind":"paragraph","spans":[{"id":"spn-37683","text":"cannot prevent cross-runtime abuse and cannot provide unified UX"}]}],"id":"blk-33903","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33905","kind":"paragraph","spans":[{"id":"spn-37684","text":"Rejected."}]},{"id":"blk-33906","kind":"heading","level":3,"spans":[{"id":"spn-37685","text":"D) Soft limits with overage billing from day one (defer)"}]},{"id":"blk-33907","kind":"paragraph","spans":[{"id":"spn-37686","text":"Pros:"}]},{"id":"blk-33908","items":[{"blocks":[{"id":"blk-33910","kind":"paragraph","spans":[{"id":"spn-37687","text":"better UX (fewer blocks), potential revenue upside"}]}],"id":"blk-33909","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33911","kind":"paragraph","spans":[{"id":"spn-37688","text":"Cons:"}]},{"id":"blk-33912","items":[{"blocks":[{"id":"blk-33914","kind":"paragraph","spans":[{"id":"spn-37689","text":"requires accurate reconciliation, payment handling, dispute workflows"}]}],"id":"blk-33913","kind":"list-item"},{"blocks":[{"id":"blk-33916","kind":"paragraph","spans":[{"id":"spn-37690","text":"increases complexity and compliance surface"}]}],"id":"blk-33915","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33917","kind":"paragraph","spans":[{"id":"spn-37691","text":"Deferred; start with hard-stop in v1."}]},{"id":"blk-33918","kind":"heading","level":2,"spans":[{"id":"spn-37692","text":"5) Consequences"}]},{"id":"blk-33919","kind":"heading","level":3,"spans":[{"id":"spn-37693","text":"Positive"}]},{"id":"blk-33920","items":[{"blocks":[{"id":"blk-33922","kind":"paragraph","spans":[{"id":"spn-37694","text":"Clear, predictable tier behavior."}]}],"id":"blk-33921","kind":"list-item"},{"blocks":[{"id":"blk-33924","kind":"paragraph","spans":[{"id":"spn-37695","text":"Strong control of premium runtime access."}]}],"id":"blk-33923","kind":"list-item"},{"blocks":[{"id":"blk-33926","kind":"paragraph","spans":[{"id":"spn-37696","text":"Requests hard-stop prevents the most common abuse patterns."}]}],"id":"blk-33925","kind":"list-item"},{"blocks":[{"id":"blk-33928","kind":"paragraph","spans":[{"id":"spn-37697","text":"Compatible with future improvements (reservation, overages, public invocations)."}]}],"id":"blk-33927","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33929","kind":"heading","level":3,"spans":[{"id":"spn-37698","text":"Negative / tradeoffs"}]},{"id":"blk-33930","items":[{"blocks":[{"id":"blk-33932","kind":"paragraph","spans":[{"id":"spn-37699","text":"A user may exceed token/compute budget within a single request in v1 (especially on premium runtime), then be blocked afterwards."}]}],"id":"blk-33931","kind":"list-item"},{"blocks":[{"id":"blk-33934","kind":"paragraph","spans":[{"id":"spn-37700","text":"Telemetry delays can cause temporary undercounting until aggregation catches up."}]}],"id":"blk-33933","kind":"list-item"},{"blocks":[{"id":"blk-33936","kind":"paragraph","spans":[{"id":"spn-37701","text":"Concurrency can cause minor overrun near boundaries unless atomic counters are implemented."}]}],"id":"blk-33935","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33937","kind":"heading","level":2,"spans":[{"id":"spn-37702","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-33938","kind":"heading","level":3,"spans":[{"id":"spn-37703","text":"6.1 Entitlements representation"}]},{"id":"blk-33939","kind":"paragraph","spans":[{"id":"spn-37704","text":"The system MUST have a function (or module) equivalent to:"}]},{"id":"blk-33940","items":[{"blocks":[{"id":"blk-33942","kind":"paragraph","spans":[{"id":"spn-37705","marks":["code"],"text":"getEntitlementsForTier(tier) -> { limits, runtimeAccess, retention }"}]}],"id":"blk-33941","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33943","kind":"paragraph","spans":[{"id":"spn-37706","text":"It MUST be deterministic, server-only, and auditable (config changes tracked via code review or admin change logs)."}]},{"id":"blk-33944","kind":"heading","level":3,"spans":[{"id":"spn-37707","text":"6.2 Period definition"}]},{"id":"blk-33945","kind":"paragraph","spans":[{"id":"spn-37708","text":"v1 MUST standardize billing periods. Recommendation:"}]},{"id":"blk-33946","items":[{"blocks":[{"id":"blk-33948","kind":"paragraph","spans":[{"id":"spn-37709","text":"calendar-month "},{"id":"spn-37710","marks":["code"],"text":"YYYY-MM"},{"id":"spn-37711","text":" as "},{"id":"spn-37712","marks":["code"],"text":"periodKey"}]}],"id":"blk-33947","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33949","kind":"paragraph","spans":[{"id":"spn-37713","text":"If subscription-aligned periods are implemented later, ensure backward compatibility in reporting."}]},{"id":"blk-33950","kind":"heading","level":3,"spans":[{"id":"spn-37714","text":"6.3 Invocation enforcement algorithm (v1)"}]},{"id":"blk-33951","kind":"paragraph","spans":[{"id":"spn-37715","text":"At invocation start (before provider call): 1. Resolve authenticated user. 2. Resolve agent; enforce ownership; ensure not disabled/deleted. 3. Resolve active deployment; ensure valid state. 4. Load entitlements for user tier. 5. Enforce runtime gating:"}]},{"id":"blk-33952","items":[{"blocks":[{"id":"blk-33954","kind":"paragraph","spans":[{"id":"spn-37716","text":"if deployment runtime is "},{"id":"spn-37717","marks":["code"],"text":"agentcore"},{"id":"spn-37718","text":" and "},{"id":"spn-37719","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-37720","text":", reject."}]}],"id":"blk-33953","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33955","kind":"paragraph","spans":[{"id":"spn-37721","text":"6. Load current period usage totals (from aggregated "},{"id":"spn-37722","marks":["code"],"text":"billingUsage"},{"id":"spn-37723","text":" and/or fast counters). 7. Enforce requests limit:"}]},{"id":"blk-33956","items":[{"blocks":[{"id":"blk-33958","kind":"paragraph","spans":[{"id":"spn-37724","text":"if requests already at/over limit, reject with "},{"id":"spn-37725","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-37726","text":"."}]}],"id":"blk-33957","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33959","kind":"paragraph","spans":[{"id":"spn-37727","text":"8. Proceed to provider invocation."}]},{"id":"blk-33960","kind":"paragraph","spans":[{"id":"spn-37728","text":"After invocation:"}]},{"id":"blk-33961","items":[{"blocks":[{"id":"blk-33963","kind":"paragraph","spans":[{"id":"spn-37729","text":"Ensure telemetry is recorded (directly from runtime or adapter-side)."}]}],"id":"blk-33962","kind":"list-item"},{"blocks":[{"id":"blk-33965","kind":"paragraph","spans":[{"id":"spn-37730","text":"Aggregation updates period totals."}]}],"id":"blk-33964","kind":"list-item"},{"blocks":[{"id":"blk-33967","kind":"paragraph","spans":[{"id":"spn-37731","text":"If tokens/compute exceed budgets:"}]}],"id":"blk-33966","kind":"list-item"},{"blocks":[{"id":"blk-33969","kind":"paragraph","spans":[{"id":"spn-37732","text":"subsequent invocations MUST be rejected until next period or upgrade."}]}],"id":"blk-33968","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33970","kind":"heading","level":3,"spans":[{"id":"spn-37733","text":"6.4 Deploy-time enforcement"}]},{"id":"blk-33971","kind":"paragraph","spans":[{"id":"spn-37734","text":"At deploy start:"}]},{"id":"blk-33972","items":[{"blocks":[{"id":"blk-33974","kind":"paragraph","spans":[{"id":"spn-37735","text":"Load entitlements."}]}],"id":"blk-33973","kind":"list-item"},{"blocks":[{"id":"blk-33976","kind":"paragraph","spans":[{"id":"spn-37736","text":"Enforce runtime gating (AgentCore enabled)."}]}],"id":"blk-33975","kind":"list-item"},{"blocks":[{"id":"blk-33978","kind":"paragraph","spans":[{"id":"spn-37737","text":"Enforce any deploy-related caps (optional in v1; e.g., max agents or deployments)."}]}],"id":"blk-33977","kind":"list-item"},{"blocks":[{"id":"blk-33980","kind":"paragraph","spans":[{"id":"spn-37738","text":"Create deployment record and proceed."}]}],"id":"blk-33979","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33981","kind":"heading","level":3,"spans":[{"id":"spn-37739","text":"6.5 Concurrency and counters (minimum vs recommended)"}]},{"id":"blk-33982","kind":"paragraph","spans":[{"id":"spn-37740","text":"Minimum acceptable v1:"}]},{"id":"blk-33983","items":[{"blocks":[{"id":"blk-33985","kind":"paragraph","spans":[{"id":"spn-37741","text":"Use aggregated usage totals and accept small overruns under concurrency."}]}],"id":"blk-33984","kind":"list-item"},{"blocks":[{"id":"blk-33987","kind":"paragraph","spans":[{"id":"spn-37742","text":"Ensure the system never systematically undercounts."}]}],"id":"blk-33986","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33988","kind":"paragraph","spans":[{"id":"spn-37743","text":"Recommended:"}]},{"id":"blk-33989","items":[{"blocks":[{"id":"blk-33991","kind":"paragraph","spans":[{"id":"spn-37744","text":"Maintain an atomic per-user per-period counter for "},{"id":"spn-37745","marks":["code"],"text":"requests"},{"id":"spn-37746","text":"."}]}],"id":"blk-33990","kind":"list-item"},{"blocks":[{"id":"blk-33993","kind":"paragraph","spans":[{"id":"spn-37747","text":"Optionally maintain token/compute counters as well."}]}],"id":"blk-33992","kind":"list-item"},{"blocks":[{"id":"blk-33995","kind":"paragraph","spans":[{"id":"spn-37748","text":"If counters are implemented, ensure idempotency under retries and telemetry dedupe."}]}],"id":"blk-33994","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33996","kind":"heading","level":3,"spans":[{"id":"spn-37749","text":"6.6 Telemetry integrity dependency"}]},{"id":"blk-33997","kind":"paragraph","spans":[{"id":"spn-37750","text":"This ADR depends on ADR-0004 (telemetry integrity). Limit enforcement based on usage requires trustworthy telemetry:"}]},{"id":"blk-33998","items":[{"blocks":[{"id":"blk-34000","kind":"paragraph","spans":[{"id":"spn-37751","text":"signed events per deployment,"}]}],"id":"blk-33999","kind":"list-item"},{"blocks":[{"id":"blk-34002","kind":"paragraph","spans":[{"id":"spn-37752","text":"ownership cross-check."}]}],"id":"blk-34001","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34003","kind":"heading","level":3,"spans":[{"id":"spn-37753","text":"6.7 Observability and UX requirements"}]},{"id":"blk-34004","kind":"paragraph","spans":[{"id":"spn-37754","text":"When rejecting for limits/gating:"}]},{"id":"blk-34005","items":[{"blocks":[{"id":"blk-34007","kind":"paragraph","spans":[{"id":"spn-37755","text":"include enough detail to explain why,"}]}],"id":"blk-34006","kind":"list-item"},{"blocks":[{"id":"blk-34009","kind":"paragraph","spans":[{"id":"spn-37756","text":"suggest an upgrade path,"}]}],"id":"blk-34008","kind":"list-item"},{"blocks":[{"id":"blk-34011","kind":"paragraph","spans":[{"id":"spn-37757","text":"never leak confidential internal state."}]}],"id":"blk-34010","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34012","kind":"paragraph","spans":[{"id":"spn-37758","text":"The dashboard MUST show:"}]},{"id":"blk-34013","items":[{"blocks":[{"id":"blk-34015","kind":"paragraph","spans":[{"id":"spn-37759","text":"current tier and limits,"}]}],"id":"blk-34014","kind":"list-item"},{"blocks":[{"id":"blk-34017","kind":"paragraph","spans":[{"id":"spn-37760","text":"current usage totals,"}]}],"id":"blk-34016","kind":"list-item"},{"blocks":[{"id":"blk-34019","kind":"paragraph","spans":[{"id":"spn-37761","text":"per-runtime breakdown,"}]}],"id":"blk-34018","kind":"list-item"},{"blocks":[{"id":"blk-34021","kind":"paragraph","spans":[{"id":"spn-37762","text":"“estimated” cost labeling."}]}],"id":"blk-34020","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34022","kind":"heading","level":2,"spans":[{"id":"spn-37763","text":"7) Testing requirements (acceptance-focused)"}]},{"id":"blk-34023","kind":"heading","level":3,"spans":[{"id":"spn-37764","text":"MUST"}]},{"id":"blk-34024","items":[{"blocks":[{"id":"blk-34026","kind":"paragraph","spans":[{"id":"spn-37765","text":"E2E: requests limit blocks invocations with "},{"id":"spn-37766","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-37767","text":"."}]}],"id":"blk-34025","kind":"list-item"},{"blocks":[{"id":"blk-34028","kind":"paragraph","spans":[{"id":"spn-37768","text":"Integration: AgentCore deploy/invoke blocked for non-entitled tiers."}]}],"id":"blk-34027","kind":"list-item"},{"blocks":[{"id":"blk-34030","kind":"paragraph","spans":[{"id":"spn-37769","text":"Unit: entitlements mapping returns expected limits and gating behavior."}]}],"id":"blk-34029","kind":"list-item"},{"blocks":[{"id":"blk-34032","kind":"paragraph","spans":[{"id":"spn-37770","text":"Integration: deploy-time gating prevents provider calls to AgentCore."}]}],"id":"blk-34031","kind":"list-item"},{"blocks":[{"id":"blk-34034","kind":"paragraph","spans":[{"id":"spn-37771","text":"Security: clients cannot modify tier or entitlements; only webhook-verified updates are effective."}]}],"id":"blk-34033","kind":"list-item"}],"kind":"list","order