{"bendscript":"0.1","blocks":[{"id":"blk-33156","kind":"heading","level":1,"spans":[{"id":"spn-36287","text":"ADR-0007: Tier Entitlements, Runtime Gating, and Limit Enforcement Strategy"}]},{"id":"blk-33157","kind":"paragraph","spans":[{"id":"spn-36288","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-33158","items":[{"blocks":[{"id":"blk-33160","kind":"paragraph","spans":[{"id":"spn-36289","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-33159","kind":"list-item"},{"blocks":[{"id":"blk-33162","kind":"paragraph","spans":[{"id":"spn-36290","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-33161","kind":"list-item"},{"blocks":[{"id":"blk-33164","kind":"paragraph","spans":[{"id":"spn-36291","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-33163","kind":"list-item"},{"blocks":[{"id":"blk-33166","kind":"paragraph","spans":[{"id":"spn-36292","marks":["code"],"text":"WebHost.Systems/docs/spec/30_DATA_MODEL_CONVEX.md"}]}],"id":"blk-33165","kind":"list-item"},{"blocks":[{"id":"blk-33168","kind":"paragraph","spans":[{"id":"spn-36293","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-33167","kind":"list-item"},{"blocks":[{"id":"blk-33170","kind":"paragraph","spans":[{"id":"spn-36294","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-33169","kind":"list-item"},{"blocks":[{"id":"blk-33172","kind":"paragraph","spans":[{"id":"spn-36295","marks":["code"],"text":"WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}]}],"id":"blk-33171","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33173","kind":"heading","level":2,"spans":[{"id":"spn-36296","text":"1) Context"}]},{"id":"blk-33174","kind":"paragraph","spans":[{"id":"spn-36297","text":"webhost.systems is a multi-runtime AI agent platform. The control plane must:"}]},{"id":"blk-33175","items":[{"blocks":[{"id":"blk-33177","kind":"paragraph","spans":[{"id":"spn-36298","text":"monetize via subscription tiers,"}]}],"id":"blk-33176","kind":"list-item"},{"blocks":[{"id":"blk-33179","kind":"paragraph","spans":[{"id":"spn-36299","text":"enforce tenant entitlements and limits in a way that protects platform cost exposure,"}]}],"id":"blk-33178","kind":"list-item"},{"blocks":[{"id":"blk-33181","kind":"paragraph","spans":[{"id":"spn-36300","text":"gate access to premium runtime providers (AWS Bedrock AgentCore),"}]}],"id":"blk-33180","kind":"list-item"},{"blocks":[{"id":"blk-33183","kind":"paragraph","spans":[{"id":"spn-36301","text":"provide predictable, explainable behavior to users and support."}]}],"id":"blk-33182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33184","kind":"paragraph","spans":[{"id":"spn-36302","text":"The platform has heterogeneous cost profiles by runtime:"}]},{"id":"blk-33185","items":[{"blocks":[{"id":"blk-33187","kind":"paragraph","spans":[{"id":"spn-36303","marks":["bold"],"text":"Cloudflare Workers/DO"},{"id":"spn-36304","text":" supports a broad set of use cases with favorable economics and global edge distribution, enabling acquisition tiers (including free)."}]}],"id":"blk-33186","kind":"list-item"},{"blocks":[{"id":"blk-33189","kind":"paragraph","spans":[{"id":"spn-36305","text":"TypeScript-first: Workers/DO are TypeScript-friendly and support modern agent frameworks naturally."}]}],"id":"blk-33188","kind":"list-item"},{"blocks":[{"id":"blk-33191","kind":"paragraph","spans":[{"id":"spn-36306","marks":["bold"],"text":"AWS Bedrock AgentCore"},{"id":"spn-36307","text":" supports premium enterprise capabilities (long running sessions, stronger isolation, built-in tools), but has higher marginal cost and different operational constraints."}]}],"id":"blk-33190","kind":"list-item"},{"blocks":[{"id":"blk-33193","kind":"paragraph","spans":[{"id":"spn-36308","text":"TypeScript-first: AgentCore has first-class TypeScript SDK support for runtime operations and modern tooling integration:"}]}],"id":"blk-33192","kind":"list-item"},{"blocks":[{"id":"blk-33195","kind":"paragraph","spans":[{"id":"spn-36309","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-36310","text":" (TypeScript) for management and invocation"}]}],"id":"blk-33194","kind":"list-item"},{"blocks":[{"id":"blk-33197","kind":"paragraph","spans":[{"id":"spn-36311","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-36312","text":" (TypeScript) for built-in tools (e.g., Code Interpreter and Browser), with integration paths for modern agent frameworks (e.g., Vercel AI SDK)"}]}],"id":"blk-33196","kind":"list-item"},{"blocks":[{"id":"blk-33199","kind":"paragraph","spans":[{"id":"spn-36313","text":"Premium value drivers beyond runtime length:"}]}],"id":"blk-33198","kind":"list-item"},{"blocks":[{"id":"blk-33201","kind":"paragraph","spans":[{"id":"spn-36314","text":"built-in tool ecosystem (code execution + browser automation) that is otherwise “DIY” on many runtimes"}]}],"id":"blk-33200","kind":"list-item"},{"blocks":[{"id":"blk-33203","kind":"paragraph","spans":[{"id":"spn-36315","text":"enterprise isolation posture aligned with higher-tier requirements"}]}],"id":"blk-33202","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33204","kind":"paragraph","spans":[{"id":"spn-36316","text":"Limits are required for:"}]},{"id":"blk-33205","items":[{"blocks":[{"id":"blk-33207","kind":"paragraph","spans":[{"id":"spn-36317","text":"preventing runaway cost and abuse,"}]}],"id":"blk-33206","kind":"list-item"},{"blocks":[{"id":"blk-33209","kind":"paragraph","spans":[{"id":"spn-36318","text":"ensuring fairness and QoS,"}]}],"id":"blk-33208","kind":"list-item"},{"blocks":[{"id":"blk-33211","kind":"paragraph","spans":[{"id":"spn-36319","text":"aligning tier pricing with usage."}]}],"id":"blk-33210","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33212","kind":"paragraph","spans":[{"id":"spn-36320","text":"Key constraints:"}]},{"id":"blk-33213","items":[{"blocks":[{"id":"blk-33215","kind":"paragraph","spans":[{"id":"spn-36321","text":"Actual token usage and compute time are not known until after the invocation completes."}]}],"id":"blk-33214","kind":"list-item"},{"blocks":[{"id":"blk-33217","kind":"paragraph","spans":[{"id":"spn-36322","text":"Telemetry ingestion is asynchronous and may be delayed or fail transiently."}]}],"id":"blk-33216","kind":"list-item"},{"blocks":[{"id":"blk-33219","kind":"paragraph","spans":[{"id":"spn-36323","text":"Concurrency (multiple simultaneous invocations) can race around limit boundaries."}]}],"id":"blk-33218","kind":"list-item"},{"blocks":[{"id":"blk-33221","kind":"paragraph","spans":[{"id":"spn-36324","text":"Security requirements prohibit relying on client-provided usage or tier claims."}]}],"id":"blk-33220","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33222","kind":"paragraph","spans":[{"id":"spn-36325","text":"Therefore, v1 needs a robust entitlement model and a limit enforcement strategy that is safe, implementable, and extensible."}]},{"id":"blk-33223","kind":"heading","level":2,"spans":[{"id":"spn-36326","text":"2) Decision"}]},{"id":"blk-33224","kind":"heading","level":3,"spans":[{"id":"spn-36327","text":"2.1 Adopt a configuration-driven entitlement model (server authoritative)"}]},{"id":"blk-33225","kind":"paragraph","spans":[{"id":"spn-36328","text":"Entitlements are represented as a server-side configuration mapping a user’s current tier to a set of allowed capabilities and budgets. Entitlements MUST be treated as "},{"id":"spn-36329","marks":["bold"],"text":"authoritative"},{"id":"spn-36330","text":" on the server; the client/UI is advisory only."}]},{"id":"blk-33226","kind":"paragraph","spans":[{"id":"spn-36331","text":"Each tier defines (minimum):"}]},{"id":"blk-33227","items":[{"blocks":[{"id":"blk-33229","kind":"paragraph","spans":[{"id":"spn-36332","marks":["code"],"text":"maxRequestsPerPeriod"}]}],"id":"blk-33228","kind":"list-item"},{"blocks":[{"id":"blk-33231","kind":"paragraph","spans":[{"id":"spn-36333","marks":["code"],"text":"maxTokensPerPeriod"},{"id":"spn-36334","text":" (reported or estimated)"}]}],"id":"blk-33230","kind":"list-item"},{"blocks":[{"id":"blk-33233","kind":"paragraph","spans":[{"id":"spn-36335","marks":["code"],"text":"maxComputeMsPerPeriod"}]}],"id":"blk-33232","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33234","kind":"paragraph","spans":[{"id":"spn-36336","text":"Runtime access + capabilities:"}]},{"id":"blk-33235","items":[{"blocks":[{"id":"blk-33237","kind":"paragraph","spans":[{"id":"spn-36337","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-36338","text":" (boolean) — whether the user may deploy/invoke on AgentCore at all"}]}],"id":"blk-33236","kind":"list-item"},{"blocks":[{"id":"blk-33239","kind":"paragraph","spans":[{"id":"spn-36339","marks":["code"],"text":"memoryEnabled"},{"id":"spn-36340","text":" (boolean) — whether AgentCore Memory features may be enabled for deployments"}]}],"id":"blk-33238","kind":"list-item"},{"blocks":[{"id":"blk-33241","kind":"paragraph","spans":[{"id":"spn-36341","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-36342","text":" (boolean) — whether AgentCore Code Interpreter tools may be enabled for deployments"}]}],"id":"blk-33240","kind":"list-item"},{"blocks":[{"id":"blk-33243","kind":"paragraph","spans":[{"id":"spn-36343","marks":["code"],"text":"browserEnabled"},{"id":"spn-36344","text":" (boolean) — whether AgentCore Browser tools may be enabled for deployments"}]}],"id":"blk-33242","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33244","kind":"paragraph","spans":[{"id":"spn-36345","text":"Tool quotas (only meaningful if tools are enabled; omitted or set to 0 when disabled):"}]},{"id":"blk-33245","items":[{"blocks":[{"id":"blk-33247","kind":"paragraph","spans":[{"id":"spn-36346","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-36347","text":" (number, optional)"}]}],"id":"blk-33246","kind":"list-item"},{"blocks":[{"id":"blk-33249","kind":"paragraph","spans":[{"id":"spn-36348","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-36349","text":" (number, optional)"}]}],"id":"blk-33248","kind":"list-item"},{"blocks":[{"id":"blk-33251","kind":"paragraph","spans":[{"id":"spn-36350","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-36351","text":" (number, optional)"}]}],"id":"blk-33250","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33252","kind":"paragraph","spans":[{"id":"spn-36352","text":"Retention policies:"}]},{"id":"blk-33253","items":[{"blocks":[{"id":"blk-33255","kind":"paragraph","spans":[{"id":"spn-36353","text":"telemetry/logs retention days"}]}],"id":"blk-33254","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33256","kind":"paragraph","spans":[{"id":"spn-36354","text":"Entitlements MUST be stored and evaluated in a way that can be changed without code edits (e.g., configuration file/env, DB table, or feature flag system). Exact storage choice is implementation detail, but it MUST be server-controlled and auditable."}]},{"id":"blk-33257","kind":"heading","level":3,"spans":[{"id":"spn-36355","text":"2.2 Tier gating rules: runtime access is an entitlement (defense in depth)"}]},{"id":"blk-33258","kind":"paragraph","spans":[{"id":"spn-36356","text":"Runtime access is gated by entitlements:"}]},{"id":"blk-33259","items":[{"blocks":[{"id":"blk-33261","kind":"paragraph","spans":[{"id":"spn-36357","text":"If "},{"id":"spn-36358","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-36359","text":", then:"}]}],"id":"blk-33260","kind":"list-item"},{"blocks":[{"id":"blk-33263","kind":"paragraph","spans":[{"id":"spn-36360","text":"deploy to "},{"id":"spn-36361","marks":["code"],"text":"runtimeProvider=agentcore"},{"id":"spn-36362","text":" MUST be rejected, and"}]}],"id":"blk-33262","kind":"list-item"},{"blocks":[{"id":"blk-33265","kind":"paragraph","spans":[{"id":"spn-36363","text":"invoke routed to an AgentCore deployment MUST be rejected, and"}]}],"id":"blk-33264","kind":"list-item"},{"blocks":[{"id":"blk-33267","kind":"paragraph","spans":[{"id":"spn-36364","text":"any attempt to switch an agent’s runtimeProvider to "},{"id":"spn-36365","marks":["code"],"text":"agentcore"},{"id":"spn-36366","text":" SHOULD be rejected (v1 recommendation: reject to reduce confusion)."}]}],"id":"blk-33266","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33268","items":[{"blocks":[{"id":"blk-33270","kind":"paragraph","spans":[{"id":"spn-36367","text":"If "},{"id":"spn-36368","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-36369","text":", AgentCore capability flags MUST still be enforced:"}]}],"id":"blk-33269","kind":"list-item"},{"blocks":[{"id":"blk-33272","kind":"paragraph","spans":[{"id":"spn-36370","text":"If "},{"id":"spn-36371","marks":["code"],"text":"codeInterpreterEnabled=false"},{"id":"spn-36372","text":", deployments MUST NOT enable code interpreter tooling, and invocations MUST be treated as “tools unavailable” (no tool loop) even if user code requests it."}]}],"id":"blk-33271","kind":"list-item"},{"blocks":[{"id":"blk-33274","kind":"paragraph","spans":[{"id":"spn-36373","text":"If "},{"id":"spn-36374","marks":["code"],"text":"browserEnabled=false"},{"id":"spn-36375","text":", deployments MUST NOT enable browser tooling, and invocations MUST be treated as “tools unavailable” for browser interactions."}]}],"id":"blk-33273","kind":"list-item"},{"blocks":[{"id":"blk-33276","kind":"paragraph","spans":[{"id":"spn-36376","text":"If "},{"id":"spn-36377","marks":["code"],"text":"memoryEnabled=false"},{"id":"spn-36378","text":", deployments MUST NOT enable provider memory features."}]}],"id":"blk-33275","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33277","kind":"paragraph","spans":[{"id":"spn-36379","marks":["bold"],"text":"v1 recommendation (tools): enterprise-only"}]},{"id":"blk-33278","items":[{"blocks":[{"id":"blk-33280","kind":"paragraph","spans":[{"id":"spn-36380","text":"v1 SHOULD enable AgentCore tools ("},{"id":"spn-36381","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-36382","text":" and "},{"id":"spn-36383","marks":["code"],"text":"browserEnabled"},{"id":"spn-36384","text":") only on the "},{"id":"spn-36385","marks":["code"],"text":"enterprise"},{"id":"spn-36386","text":" tier."}]}],"id":"blk-33279","kind":"list-item"},{"blocks":[{"id":"blk-33282","kind":"paragraph","spans":[{"id":"spn-36387","text":"v1 MAY allow "},{"id":"spn-36388","marks":["code"],"text":"agentcoreEnabled=true"},{"id":"spn-36389","text":" on "},{"id":"spn-36390","marks":["code"],"text":"pro"},{"id":"spn-36391","text":" while keeping tools disabled (and optionally allowing "},{"id":"spn-36392","marks":["code"],"text":"memoryEnabled=true"},{"id":"spn-36393","text":" if cost/behavior is acceptable)."}]}],"id":"blk-33281","kind":"list-item"},{"blocks":[{"id":"blk-33284","kind":"paragraph","spans":[{"id":"spn-36394","text":"If you later enable tools for "},{"id":"spn-36395","marks":["code"],"text":"pro"},{"id":"spn-36396","text":", you MUST add explicit tool quotas ("},{"id":"spn-36397","marks":["code"],"text":"maxToolCallsPerPeriod"},{"id":"spn-36398","text":", "},{"id":"spn-36399","marks":["code"],"text":"maxCodeExecutionSecondsPerPeriod"},{"id":"spn-36400","text":", "},{"id":"spn-36401","marks":["code"],"text":"maxBrowserSessionsPerPeriod"},{"id":"spn-36402","text":") and enforce them at invoke time."}]}],"id":"blk-33283","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33285","kind":"paragraph","spans":[{"id":"spn-36403","text":"This gating MUST be enforced at three layers (defense in depth): 1. "},{"id":"spn-36404","marks":["bold"],"text":"UI layer"},{"id":"spn-36405","text":": hide/disable options (non-authoritative) 2. "},{"id":"spn-36406","marks":["bold"],"text":"Control plane deploy/invoke APIs"},{"id":"spn-36407","text":": authoritative check before provider calls 3. "},{"id":"spn-36408","marks":["bold"],"text":"Runtime adapter layer"},{"id":"spn-36409","text":": refuse deploy/invoke if not entitled (in case of misrouting or bugs)"}]},{"id":"blk-33286","kind":"paragraph","spans":[{"id":"spn-36410","text":"The same three-layer enforcement applies to "},{"id":"spn-36411","marks":["bold"],"text":"AgentCore capability flags"},{"id":"spn-36412","text":" ("},{"id":"spn-36413","marks":["code"],"text":"memoryEnabled"},{"id":"spn-36414","text":", "},{"id":"spn-36415","marks":["code"],"text":"codeInterpreterEnabled"},{"id":"spn-36416","text":", "},{"id":"spn-36417","marks":["code"],"text":"browserEnabled"},{"id":"spn-36418","text":"):"}]},{"id":"blk-33287","items":[{"blocks":[{"id":"blk-33289","kind":"paragraph","spans":[{"id":"spn-36419","text":"UI MUST not present toggles the user is not entitled to."}]}],"id":"blk-33288","kind":"list-item"},{"blocks":[{"id":"blk-33291","kind":"paragraph","spans":[{"id":"spn-36420","text":"Deploy APIs MUST reject configurations that attempt to enable disallowed capabilities."}]}],"id":"blk-33290","kind":"list-item"},{"blocks":[{"id":"blk-33293","kind":"paragraph","spans":[{"id":"spn-36421","text":"Invoke routing MUST ensure a deployment cannot exercise disallowed capabilities (even if user code attempts to)."}]}],"id":"blk-33292","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33294","kind":"heading","level":3,"spans":[{"id":"spn-36422","text":"2.3 Limit enforcement strategy (v1): requests hard-stop + post-charge tokens/compute, with upgrade path to reservation"}]},{"id":"blk-33295","kind":"paragraph","spans":[{"id":"spn-36423","text":"v1 enforcement strategy is:"}]},{"id":"blk-33296","items":[{"blocks":[{"id":"blk-33298","kind":"paragraph","spans":[{"id":"spn-36424","marks":["bold"],"text":"Pre-invocation hard-stop on requests"},{"id":"spn-36425","text":" (MUST)."}]}],"id":"blk-33297","kind":"list-item"},{"blocks":[{"id":"blk-33300","kind":"paragraph","spans":[{"id":"spn-36426","marks":["bold"],"text":"Post-invocation accounting for tokens/compute"},{"id":"spn-36427","text":" via telemetry (MUST)."}]}],"id":"blk-33299","kind":"list-item"},{"blocks":[{"id":"blk-33302","kind":"paragraph","spans":[{"id":"spn-36428","marks":["bold"],"text":"Subsequent invocations blocked"},{"id":"spn-36429","text":" if tokens/compute budgets exceeded (MUST)."}]}],"id":"blk-33301","kind":"list-item"},{"blocks":[{"id":"blk-33304","kind":"paragraph","spans":[{"id":"spn-36430","marks":["bold"],"text":"Optional predictive reservation"},{"id":"spn-36431","text":" for expensive runtimes (SHOULD for AgentCore, MAY for Cloudflare) as an enhancement."}]}],"id":"blk-33303","kind":"list-item"},{"blocks":[{"id":"blk-33306","kind":"paragraph","spans":[{"id":"spn-36432","text":"AgentCore-specific note: because AgentCore can support longer-running workloads and built-in tools (code execution, browser automation), it may concentrate more cost into a single invocation. This makes reservation (or stricter pre-flight checks) more valuable for AgentCore tiers."}]}],"id":"blk-33305","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33307","kind":"paragraph","spans":[{"id":"spn-36433","text":"This is a deliberate v1 tradeoff:"}]},{"id":"blk-33308","items":[{"blocks":[{"id":"blk-33310","kind":"paragraph","spans":[{"id":"spn-36434","text":"It protects the platform from request floods (and thus most cost/abuse)."}]}],"id":"blk-33309","kind":"list-item"},{"blocks":[{"id":"blk-33312","kind":"paragraph","spans":[{"id":"spn-36435","text":"It keeps implementation complexity manageable while still meeting product needs."}]}],"id":"blk-33311","kind":"list-item"},{"blocks":[{"id":"blk-33314","kind":"paragraph","spans":[{"id":"spn-36436","text":"It provides a clear path to a stronger pre-reservation model without changing the external API."}]}],"id":"blk-33313","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33315","kind":"heading","level":3,"spans":[{"id":"spn-36437","text":"2.4 Enforcement point: invocation gateway is the primary cost-control boundary"}]},{"id":"blk-33316","kind":"paragraph","spans":[{"id":"spn-36438","text":"Limits MUST be enforced in the invocation gateway "},{"id":"spn-36439","marks":["bold"],"text":"before calling a runtime provider"},{"id":"spn-36440","text":" whenever possible. This prevents spending money on requests that will be rejected."}]},{"id":"blk-33317","kind":"paragraph","spans":[{"id":"spn-36441","text":"For v1:"}]},{"id":"blk-33318","items":[{"blocks":[{"id":"blk-33320","kind":"paragraph","spans":[{"id":"spn-36442","text":"Request count enforcement MUST happen before provider invocation."}]}],"id":"blk-33319","kind":"list-item"},{"blocks":[{"id":"blk-33322","kind":"paragraph","spans":[{"id":"spn-36443","text":"Token/compute enforcement MAY lag by up to telemetry ingestion delay; when exceeded, block subsequent requests."}]}],"id":"blk-33321","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33323","kind":"heading","level":3,"spans":[{"id":"spn-36444","text":"2.5 Consistent error semantics"}]},{"id":"blk-33324","kind":"paragraph","spans":[{"id":"spn-36445","text":"When a deploy or invoke is rejected due to entitlements or limits, the system MUST return a normalized error envelope with:"}]},{"id":"blk-33325","items":[{"blocks":[{"id":"blk-33327","kind":"paragraph","spans":[{"id":"spn-36446","marks":["code"],"text":"code = LIMIT_EXCEEDED"},{"id":"spn-36447","text":" (or a dedicated entitlement code if added later),"}]}],"id":"blk-33326","kind":"list-item"},{"blocks":[{"id":"blk-33329","kind":"paragraph","spans":[{"id":"spn-36448","text":"a safe user-displayable message,"}]}],"id":"blk-33328","kind":"list-item"},{"blocks":[{"id":"blk-33331","kind":"paragraph","spans":[{"id":"spn-36449","text":"details including:"}]}],"id":"blk-33330","kind":"list-item"},{"blocks":[{"id":"blk-33333","kind":"paragraph","spans":[{"id":"spn-36450","text":"limit type ("},{"id":"spn-36451","marks":["code"],"text":"requests"},{"id":"spn-36452","text":", "},{"id":"spn-36453","marks":["code"],"text":"tokens"},{"id":"spn-36454","text":", "},{"id":"spn-36455","marks":["code"],"text":"computeMs"},{"id":"spn-36456","text":", or "},{"id":"spn-36457","marks":["code"],"text":"agentcoreEnabled"},{"id":"spn-36458","text":" / "},{"id":"spn-36459","marks":["code"],"text":"runtimeGated"},{"id":"spn-36460","text":"),"}]}],"id":"blk-33332","kind":"list-item"},{"blocks":[{"id":"blk-33335","kind":"paragraph","spans":[{"id":"spn-36461","text":"period key,"}]}],"id":"blk-33334","kind":"list-item"},{"blocks":[{"id":"blk-33337","kind":"paragraph","spans":[{"id":"spn-36462","text":"current usage and limit where known,"}]}],"id":"blk-33336","kind":"list-item"},{"blocks":[{"id":"blk-33339","kind":"paragraph","spans":[{"id":"spn-36463","text":"suggested action (upgrade tier)."}]}],"id":"blk-33338","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33340","kind":"paragraph","spans":[{"id":"spn-36464","text":"HTTP status mapping is defined in "},{"id":"spn-36465","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-36466","text":"."}]},{"id":"blk-33341","kind":"heading","level":2,"spans":[{"id":"spn-36467","text":"3) Rationale"}]},{"id":"blk-33342","kind":"heading","level":3,"spans":[{"id":"spn-36468","text":"3.1 Why configuration-driven entitlements"}]},{"id":"blk-33343","items":[{"blocks":[{"id":"blk-33345","kind":"paragraph","spans":[{"id":"spn-36469","text":"Pricing and tiers will iterate frequently; hardcoding makes iteration risky and slow."}]}],"id":"blk-33344","kind":"list-item"},{"blocks":[{"id":"blk-33347","kind":"paragraph","spans":[{"id":"spn-36470","text":"Entitlements must be authoritative and auditable, independent of client behavior."}]}],"id":"blk-33346","kind":"list-item"},{"blocks":[{"id":"blk-33349","kind":"paragraph","spans":[{"id":"spn-36471","text":"A single entitlements surface simplifies UI gating, API checks, and support tooling."}]}],"id":"blk-33348","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33350","kind":"heading","level":3,"spans":[{"id":"spn-36472","text":"3.2 Why runtime gating is mandatory"}]},{"id":"blk-33351","items":[{"blocks":[{"id":"blk-33353","kind":"paragraph","spans":[{"id":"spn-36473","text":"AgentCore has a materially different cost and capability footprint."}]}],"id":"blk-33352","kind":"list-item"},{"blocks":[{"id":"blk-33355","kind":"paragraph","spans":[{"id":"spn-36474","text":"Capability: long-running sessions and built-in tools (e.g., code execution and browser automation) unlock workflows that are not “free” to operate."}]}],"id":"blk-33354","kind":"list-item"},{"blocks":[{"id":"blk-33357","kind":"paragraph","spans":[{"id":"spn-36475","text":"DX: AgentCore is viable for TypeScript-first teams via official TypeScript SDK support and tool integrations, which strengthens its premium value proposition."}]}],"id":"blk-33356","kind":"list-item"},{"blocks":[{"id":"blk-33359","kind":"paragraph","spans":[{"id":"spn-36476","text":"Allowing access without gating risks unbounded cost exposure, especially for long-running or tool-heavy workloads."}]}],"id":"blk-33358","kind":"list-item"},{"blocks":[{"id":"blk-33361","kind":"paragraph","spans":[{"id":"spn-36477","text":"Tier-based runtime gating enables a clear product ladder (acquisition → premium) while keeping the default path cost-efficient and globally distributed."}]}],"id":"blk-33360","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33362","kind":"heading","level":3,"spans":[{"id":"spn-36478","text":"3.3 Why requests-first enforcement is acceptable for v1"}]},{"id":"blk-33363","items":[{"blocks":[{"id":"blk-33365","kind":"paragraph","spans":[{"id":"spn-36479","text":"Requests are the most immediate and reliable pre-invocation signal."}]}],"id":"blk-33364","kind":"list-item"},{"blocks":[{"id":"blk-33367","kind":"paragraph","spans":[{"id":"spn-36480","text":"Accurate tokens/compute budgets require predictive reservation or “post-charge” logic, which is more complex and varies by runtime."}]}],"id":"blk-33366","kind":"list-item"},{"blocks":[{"id":"blk-33369","kind":"paragraph","spans":[{"id":"spn-36481","text":"v1 still ensures tokens/compute budgets are enforced over time (subsequent blocking), which is sufficient to prevent ongoing overuse."}]}],"id":"blk-33368","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33370","kind":"heading","level":3,"spans":[{"id":"spn-36482","text":"3.4 Why we still plan for reservation"}]},{"id":"blk-33371","kind":"paragraph","spans":[{"id":"spn-36483","text":"For AgentCore, a single invocation can be expensive. Reservation provides better pre-flight protection:"}]},{"id":"blk-33372","items":[{"blocks":[{"id":"blk-33374","kind":"paragraph","spans":[{"id":"spn-36484","text":"reserve predicted tokens/compute,"}]}],"id":"blk-33373","kind":"list-item"},{"blocks":[{"id":"blk-33376","kind":"paragraph","spans":[{"id":"spn-36485","text":"reject if budget cannot cover expected cost,"}]}],"id":"blk-33375","kind":"list-item"},{"blocks":[{"id":"blk-33378","kind":"paragraph","spans":[{"id":"spn-36486","text":"reconcile after invocation."}]}],"id":"blk-33377","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33379","kind":"paragraph","spans":[{"id":"spn-36487","text":"We accept requests-first in v1 but design data models and APIs to allow reservation without breaking changes (e.g., counters and “pending usage” concepts)."}]},{"id":"blk-33380","kind":"heading","level":2,"spans":[{"id":"spn-36488","text":"4) Alternatives considered"}]},{"id":"blk-33381","kind":"heading","level":3,"spans":[{"id":"spn-36489","text":"A) No limits (reject)"}]},{"id":"blk-33382","kind":"paragraph","spans":[{"id":"spn-36490","text":"Pros:"}]},{"id":"blk-33383","items":[{"blocks":[{"id":"blk-33385","kind":"paragraph","spans":[{"id":"spn-36491","text":"simplest experience"}]}],"id":"blk-33384","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33386","kind":"paragraph","spans":[{"id":"spn-36492","text":"Cons:"}]},{"id":"blk-33387","items":[{"blocks":[{"id":"blk-33389","kind":"paragraph","spans":[{"id":"spn-36493","text":"unacceptable cost and abuse exposure"}]}],"id":"blk-33388","kind":"list-item"},{"blocks":[{"id":"blk-33391","kind":"paragraph","spans":[{"id":"spn-36494","text":"no pricing integrity"}]}],"id":"blk-33390","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33392","kind":"paragraph","spans":[{"id":"spn-36495","text":"Rejected."}]},{"id":"blk-33393","kind":"heading","level":3,"spans":[{"id":"spn-36496","text":"B) Pre-reservation for all dimensions in v1 (defer)"}]},{"id":"blk-33394","kind":"paragraph","spans":[{"id":"spn-36497","text":"Pros:"}]},{"id":"blk-33395","items":[{"blocks":[{"id":"blk-33397","kind":"paragraph","spans":[{"id":"spn-36498","text":"best cost control and fewer “single request blows budget” events"}]}],"id":"blk-33396","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33398","kind":"paragraph","spans":[{"id":"spn-36499","text":"Cons:"}]},{"id":"blk-33399","items":[{"blocks":[{"id":"blk-33401","kind":"paragraph","spans":[{"id":"spn-36500","text":"requires good prediction of tokens/compute, which is inherently uncertain"}]}],"id":"blk-33400","kind":"list-item"},{"blocks":[{"id":"blk-33403","kind":"paragraph","spans":[{"id":"spn-36501","text":"requires stronger atomic counters and reconciliation logic"}]}],"id":"blk-33402","kind":"list-item"},{"blocks":[{"id":"blk-33405","kind":"paragraph","spans":[{"id":"spn-36502","text":"increases complexity and time-to-market"}]}],"id":"blk-33404","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33406","kind":"paragraph","spans":[{"id":"spn-36503","text":"Deferred; recommended as a post-v1 enhancement, and potentially as a “AgentCore-only” enhancement sooner."}]},{"id":"blk-33407","kind":"heading","level":3,"spans":[{"id":"spn-36504","text":"C) Provider-side enforcement only (reject)"}]},{"id":"blk-33408","kind":"paragraph","spans":[{"id":"spn-36505","text":"Pros:"}]},{"id":"blk-33409","items":[{"blocks":[{"id":"blk-33411","kind":"paragraph","spans":[{"id":"spn-36506","text":"offload to providers"}]}],"id":"blk-33410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33412","kind":"paragraph","spans":[{"id":"spn-36507","text":"Cons:"}]},{"id":"blk-33413","items":[{"blocks":[{"id":"blk-33415","kind":"paragraph","spans":[{"id":"spn-36508","text":"providers don’t enforce webhost.systems tier semantics"}]}],"id":"blk-33414","kind":"list-item"},{"blocks":[{"id":"blk-33417","kind":"paragraph","spans":[{"id":"spn-36509","text":"cannot unify multi-runtime behavior"}]}],"id":"blk-33416","kind":"list-item"},{"blocks":[{"id":"blk-33419","kind":"paragraph","spans":[{"id":"spn-36510","text":"cannot prevent cross-runtime abuse and cannot provide unified UX"}]}],"id":"blk-33418","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33420","kind":"paragraph","spans":[{"id":"spn-36511","text":"Rejected."}]},{"id":"blk-33421","kind":"heading","level":3,"spans":[{"id":"spn-36512","text":"D) Soft limits with overage billing from day one (defer)"}]},{"id":"blk-33422","kind":"paragraph","spans":[{"id":"spn-36513","text":"Pros:"}]},{"id":"blk-33423","items":[{"blocks":[{"id":"blk-33425","kind":"paragraph","spans":[{"id":"spn-36514","text":"better UX (fewer blocks), potential revenue upside"}]}],"id":"blk-33424","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33426","kind":"paragraph","spans":[{"id":"spn-36515","text":"Cons:"}]},{"id":"blk-33427","items":[{"blocks":[{"id":"blk-33429","kind":"paragraph","spans":[{"id":"spn-36516","text":"requires accurate reconciliation, payment handling, dispute workflows"}]}],"id":"blk-33428","kind":"list-item"},{"blocks":[{"id":"blk-33431","kind":"paragraph","spans":[{"id":"spn-36517","text":"increases complexity and compliance surface"}]}],"id":"blk-33430","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33432","kind":"paragraph","spans":[{"id":"spn-36518","text":"Deferred; start with hard-stop in v1."}]},{"id":"blk-33433","kind":"heading","level":2,"spans":[{"id":"spn-36519","text":"5) Consequences"}]},{"id":"blk-33434","kind":"heading","level":3,"spans":[{"id":"spn-36520","text":"Positive"}]},{"id":"blk-33435","items":[{"blocks":[{"id":"blk-33437","kind":"paragraph","spans":[{"id":"spn-36521","text":"Clear, predictable tier behavior."}]}],"id":"blk-33436","kind":"list-item"},{"blocks":[{"id":"blk-33439","kind":"paragraph","spans":[{"id":"spn-36522","text":"Strong control of premium runtime access."}]}],"id":"blk-33438","kind":"list-item"},{"blocks":[{"id":"blk-33441","kind":"paragraph","spans":[{"id":"spn-36523","text":"Requests hard-stop prevents the most common abuse patterns."}]}],"id":"blk-33440","kind":"list-item"},{"blocks":[{"id":"blk-33443","kind":"paragraph","spans":[{"id":"spn-36524","text":"Compatible with future improvements (reservation, overages, public invocations)."}]}],"id":"blk-33442","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33444","kind":"heading","level":3,"spans":[{"id":"spn-36525","text":"Negative / tradeoffs"}]},{"id":"blk-33445","items":[{"blocks":[{"id":"blk-33447","kind":"paragraph","spans":[{"id":"spn-36526","text":"A user may exceed token/compute budget within a single request in v1 (especially on premium runtime), then be blocked afterwards."}]}],"id":"blk-33446","kind":"list-item"},{"blocks":[{"id":"blk-33449","kind":"paragraph","spans":[{"id":"spn-36527","text":"Telemetry delays can cause temporary undercounting until aggregation catches up."}]}],"id":"blk-33448","kind":"list-item"},{"blocks":[{"id":"blk-33451","kind":"paragraph","spans":[{"id":"spn-36528","text":"Concurrency can cause minor overrun near boundaries unless atomic counters are implemented."}]}],"id":"blk-33450","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33452","kind":"heading","level":2,"spans":[{"id":"spn-36529","text":"6) Implementation details (normative requirements)"}]},{"id":"blk-33453","kind":"heading","level":3,"spans":[{"id":"spn-36530","text":"6.1 Entitlements representation"}]},{"id":"blk-33454","kind":"paragraph","spans":[{"id":"spn-36531","text":"The system MUST have a function (or module) equivalent to:"}]},{"id":"blk-33455","items":[{"blocks":[{"id":"blk-33457","kind":"paragraph","spans":[{"id":"spn-36532","marks":["code"],"text":"getEntitlementsForTier(tier) -> { limits, runtimeAccess, retention }"}]}],"id":"blk-33456","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33458","kind":"paragraph","spans":[{"id":"spn-36533","text":"It MUST be deterministic, server-only, and auditable (config changes tracked via code review or admin change logs)."}]},{"id":"blk-33459","kind":"heading","level":3,"spans":[{"id":"spn-36534","text":"6.2 Period definition"}]},{"id":"blk-33460","kind":"paragraph","spans":[{"id":"spn-36535","text":"v1 MUST standardize billing periods. Recommendation:"}]},{"id":"blk-33461","items":[{"blocks":[{"id":"blk-33463","kind":"paragraph","spans":[{"id":"spn-36536","text":"calendar-month "},{"id":"spn-36537","marks":["code"],"text":"YYYY-MM"},{"id":"spn-36538","text":" as "},{"id":"spn-36539","marks":["code"],"text":"periodKey"}]}],"id":"blk-33462","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33464","kind":"paragraph","spans":[{"id":"spn-36540","text":"If subscription-aligned periods are implemented later, ensure backward compatibility in reporting."}]},{"id":"blk-33465","kind":"heading","level":3,"spans":[{"id":"spn-36541","text":"6.3 Invocation enforcement algorithm (v1)"}]},{"id":"blk-33466","kind":"paragraph","spans":[{"id":"spn-36542","text":"At invocation start (before provider call): 1. Resolve authenticated user. 2. Resolve agent; enforce ownership; ensure not disabled/deleted. 3. Resolve active deployment; ensure valid state. 4. Load entitlements for user tier. 5. Enforce runtime gating:"}]},{"id":"blk-33467","items":[{"blocks":[{"id":"blk-33469","kind":"paragraph","spans":[{"id":"spn-36543","text":"if deployment runtime is "},{"id":"spn-36544","marks":["code"],"text":"agentcore"},{"id":"spn-36545","text":" and "},{"id":"spn-36546","marks":["code"],"text":"agentcoreEnabled=false"},{"id":"spn-36547","text":", reject."}]}],"id":"blk-33468","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33470","kind":"paragraph","spans":[{"id":"spn-36548","text":"6. Load current period usage totals (from aggregated "},{"id":"spn-36549","marks":["code"],"text":"billingUsage"},{"id":"spn-36550","text":" and/or fast counters). 7. Enforce requests limit:"}]},{"id":"blk-33471","items":[{"blocks":[{"id":"blk-33473","kind":"paragraph","spans":[{"id":"spn-36551","text":"if requests already at/over limit, reject with "},{"id":"spn-36552","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-36553","text":"."}]}],"id":"blk-33472","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33474","kind":"paragraph","spans":[{"id":"spn-36554","text":"8. Proceed to provider invocation."}]},{"id":"blk-33475","kind":"paragraph","spans":[{"id":"spn-36555","text":"After invocation:"}]},{"id":"blk-33476","items":[{"blocks":[{"id":"blk-33478","kind":"paragraph","spans":[{"id":"spn-36556","text":"Ensure telemetry is recorded (directly from runtime or adapter-side)."}]}],"id":"blk-33477","kind":"list-item"},{"blocks":[{"id":"blk-33480","kind":"paragraph","spans":[{"id":"spn-36557","text":"Aggregation updates period totals."}]}],"id":"blk-33479","kind":"list-item"},{"blocks":[{"id":"blk-33482","kind":"paragraph","spans":[{"id":"spn-36558","text":"If tokens/compute exceed budgets:"}]}],"id":"blk-33481","kind":"list-item"},{"blocks":[{"id":"blk-33484","kind":"paragraph","spans":[{"id":"spn-36559","text":"subsequent invocations MUST be rejected until next period or upgrade."}]}],"id":"blk-33483","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33485","kind":"heading","level":3,"spans":[{"id":"spn-36560","text":"6.4 Deploy-time enforcement"}]},{"id":"blk-33486","kind":"paragraph","spans":[{"id":"spn-36561","text":"At deploy start:"}]},{"id":"blk-33487","items":[{"blocks":[{"id":"blk-33489","kind":"paragraph","spans":[{"id":"spn-36562","text":"Load entitlements."}]}],"id":"blk-33488","kind":"list-item"},{"blocks":[{"id":"blk-33491","kind":"paragraph","spans":[{"id":"spn-36563","text":"Enforce runtime gating (AgentCore enabled)."}]}],"id":"blk-33490","kind":"list-item"},{"blocks":[{"id":"blk-33493","kind":"paragraph","spans":[{"id":"spn-36564","text":"Enforce any deploy-related caps (optional in v1; e.g., max agents or deployments)."}]}],"id":"blk-33492","kind":"list-item"},{"blocks":[{"id":"blk-33495","kind":"paragraph","spans":[{"id":"spn-36565","text":"Create deployment record and proceed."}]}],"id":"blk-33494","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33496","kind":"heading","level":3,"spans":[{"id":"spn-36566","text":"6.5 Concurrency and counters (minimum vs recommended)"}]},{"id":"blk-33497","kind":"paragraph","spans":[{"id":"spn-36567","text":"Minimum acceptable v1:"}]},{"id":"blk-33498","items":[{"blocks":[{"id":"blk-33500","kind":"paragraph","spans":[{"id":"spn-36568","text":"Use aggregated usage totals and accept small overruns under concurrency."}]}],"id":"blk-33499","kind":"list-item"},{"blocks":[{"id":"blk-33502","kind":"paragraph","spans":[{"id":"spn-36569","text":"Ensure the system never systematically undercounts."}]}],"id":"blk-33501","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33503","kind":"paragraph","spans":[{"id":"spn-36570","text":"Recommended:"}]},{"id":"blk-33504","items":[{"blocks":[{"id":"blk-33506","kind":"paragraph","spans":[{"id":"spn-36571","text":"Maintain an atomic per-user per-period counter for "},{"id":"spn-36572","marks":["code"],"text":"requests"},{"id":"spn-36573","text":"."}]}],"id":"blk-33505","kind":"list-item"},{"blocks":[{"id":"blk-33508","kind":"paragraph","spans":[{"id":"spn-36574","text":"Optionally maintain token/compute counters as well."}]}],"id":"blk-33507","kind":"list-item"},{"blocks":[{"id":"blk-33510","kind":"paragraph","spans":[{"id":"spn-36575","text":"If counters are implemented, ensure idempotency under retries and telemetry dedupe."}]}],"id":"blk-33509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33511","kind":"heading","level":3,"spans":[{"id":"spn-36576","text":"6.6 Telemetry integrity dependency"}]},{"id":"blk-33512","kind":"paragraph","spans":[{"id":"spn-36577","text":"This ADR depends on ADR-0004 (telemetry integrity). Limit enforcement based on usage requires trustworthy telemetry:"}]},{"id":"blk-33513","items":[{"blocks":[{"id":"blk-33515","kind":"paragraph","spans":[{"id":"spn-36578","text":"signed events per deployment,"}]}],"id":"blk-33514","kind":"list-item"},{"blocks":[{"id":"blk-33517","kind":"paragraph","spans":[{"id":"spn-36579","text":"ownership cross-check."}]}],"id":"blk-33516","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33518","kind":"heading","level":3,"spans":[{"id":"spn-36580","text":"6.7 Observability and UX requirements"}]},{"id":"blk-33519","kind":"paragraph","spans":[{"id":"spn-36581","text":"When rejecting for limits/gating:"}]},{"id":"blk-33520","items":[{"blocks":[{"id":"blk-33522","kind":"paragraph","spans":[{"id":"spn-36582","text":"include enough detail to explain why,"}]}],"id":"blk-33521","kind":"list-item"},{"blocks":[{"id":"blk-33524","kind":"paragraph","spans":[{"id":"spn-36583","text":"suggest an upgrade path,"}]}],"id":"blk-33523","kind":"list-item"},{"blocks":[{"id":"blk-33526","kind":"paragraph","spans":[{"id":"spn-36584","text":"never leak confidential internal state."}]}],"id":"blk-33525","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33527","kind":"paragraph","spans":[{"id":"spn-36585","text":"The dashboard MUST show:"}]},{"id":"blk-33528","items":[{"blocks":[{"id":"blk-33530","kind":"paragraph","spans":[{"id":"spn-36586","text":"current tier and limits,"}]}],"id":"blk-33529","kind":"list-item"},{"blocks":[{"id":"blk-33532","kind":"paragraph","spans":[{"id":"spn-36587","text":"current usage totals,"}]}],"id":"blk-33531","kind":"list-item"},{"blocks":[{"id":"blk-33534","kind":"paragraph","spans":[{"id":"spn-36588","text":"per-runtime breakdown,"}]}],"id":"blk-33533","kind":"list-item"},{"blocks":[{"id":"blk-33536","kind":"paragraph","spans":[{"id":"spn-36589","text":"“estimated” cost labeling."}]}],"id":"blk-33535","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33537","kind":"heading","level":2,"spans":[{"id":"spn-36590","text":"7) Testing requirements (acceptance-focused)"}]},{"id":"blk-33538","kind":"heading","level":3,"spans":[{"id":"spn-36591","text":"MUST"}]},{"id":"blk-33539","items":[{"blocks":[{"id":"blk-33541","kind":"paragraph","spans":[{"id":"spn-36592","text":"E2E: requests limit blocks invocations with "},{"id":"spn-36593","marks":["code"],"text":"LIMIT_EXCEEDED"},{"id":"spn-36594","text":"."}]}],"id":"blk-33540","kind":"list-item"},{"blocks":[{"id":"blk-33543","kind":"paragraph","spans":[{"id":"spn-36595","text":"Integration: AgentCore deploy/invoke blocked for non-entitled tiers."}]}],"id":"blk-33542","kind":"list-item"},{"blocks":[{"id":"blk-33545","kind":"paragraph","spans":[{"id":"spn-36596","text":"Unit: entitlements mapping returns expected limits and gating behavior."}]}],"id":"blk-33544","kind":"list-item"},{"blocks":[{"id":"blk-33547","kind":"paragraph","spans":[{"id":"spn-36597","text":"Integration: deploy-time gating prevents provider calls to AgentCore."}]}],"id":"blk-33546","kind":"list-item"},{"blocks":[{"id":"blk-33549","kind":"paragraph","spans":[{"id":"spn-36598","text":"Security: clients cannot modify tier or entitlements; only webhook-verified updates are effective."}]}],"id":"blk-33548","kind":"list-item"}],"kind":"list","order