{"bendscript":"0.1","blocks":[{"id":"blk-90600","kind":"heading","level":1,"spans":[{"id":"spn-154680","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-90601","kind":"paragraph","spans":[{"id":"spn-154681","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-90602","items":[{"blocks":[{"id":"blk-90604","kind":"paragraph","spans":[{"id":"spn-154682","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-90603","kind":"list-item"},{"blocks":[{"id":"blk-90606","kind":"paragraph","spans":[{"id":"spn-154683","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-90605","kind":"list-item"},{"blocks":[{"id":"blk-90608","kind":"paragraph","spans":[{"id":"spn-154684","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-90607","kind":"list-item"},{"blocks":[{"id":"blk-90610","kind":"paragraph","spans":[{"id":"spn-154685","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-90609","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90611","kind":"heading","level":2,"spans":[{"id":"spn-154686","text":"Context"}]},{"id":"blk-90612","kind":"paragraph","spans":[{"id":"spn-154687","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-90613","items":[{"blocks":[{"id":"blk-90615","kind":"paragraph","spans":[{"id":"spn-154688","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-154689","text":" for the majority of users:"}]}],"id":"blk-90614","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-90616","items":[{"blocks":[{"id":"blk-90618","kind":"paragraph","spans":[{"id":"spn-154690","text":"low marginal cost for invocations,"}]}],"id":"blk-90617","kind":"list-item"},{"blocks":[{"id":"blk-90620","kind":"paragraph","spans":[{"id":"spn-154691","text":"low latency,"}]}],"id":"blk-90619","kind":"list-item"},{"blocks":[{"id":"blk-90622","kind":"paragraph","spans":[{"id":"spn-154692","text":"global availability,"}]}],"id":"blk-90621","kind":"list-item"},{"blocks":[{"id":"blk-90624","kind":"paragraph","spans":[{"id":"spn-154693","text":"simple developer experience."}]}],"id":"blk-90623","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90625","items":[{"blocks":[{"id":"blk-90627","kind":"paragraph","spans":[{"id":"spn-154694","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-154695","text":" for premium customers and advanced workloads:"}]}],"id":"blk-90626","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-90628","items":[{"blocks":[{"id":"blk-90630","kind":"paragraph","spans":[{"id":"spn-154696","text":"long-running sessions and tasks,"}]}],"id":"blk-90629","kind":"list-item"},{"blocks":[{"id":"blk-90632","kind":"paragraph","spans":[{"id":"spn-154697","text":"stronger isolation and security posture,"}]}],"id":"blk-90631","kind":"list-item"},{"blocks":[{"id":"blk-90634","kind":"paragraph","spans":[{"id":"spn-154698","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-90633","kind":"list-item"},{"blocks":[{"id":"blk-90636","kind":"paragraph","spans":[{"id":"spn-154699","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-90635","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90637","kind":"paragraph","spans":[{"id":"spn-154700","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-90638","kind":"paragraph","spans":[{"id":"spn-154701","text":"We also require:"}]},{"id":"blk-90639","items":[{"blocks":[{"id":"blk-90641","kind":"paragraph","spans":[{"id":"spn-154702","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-90640","kind":"list-item"},{"blocks":[{"id":"blk-90643","kind":"paragraph","spans":[{"id":"spn-154703","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-90642","kind":"list-item"},{"blocks":[{"id":"blk-90645","kind":"paragraph","spans":[{"id":"spn-154704","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-90644","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90646","kind":"heading","level":2,"spans":[{"id":"spn-154705","text":"Decision"}]},{"id":"blk-90647","kind":"paragraph","spans":[{"id":"spn-154706","text":"Adopt a "},{"id":"spn-154707","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-154708","text":" with a single "},{"id":"spn-154709","marks":["bold"],"text":"control plane"},{"id":"spn-154710","text":" and multiple "},{"id":"spn-154711","marks":["bold"],"text":"data plane"},{"id":"spn-154712","text":" runtime providers behind a shared "},{"id":"spn-154713","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-154714","text":"."}]},{"id":"blk-90648","kind":"heading","level":3,"spans":[{"id":"spn-154715","text":"Providers in v1"}]},{"id":"blk-90649","items":[{"blocks":[{"id":"blk-90651","kind":"paragraph","spans":[{"id":"spn-154716","marks":["bold"],"text":"Default runtime"},{"id":"spn-154717","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-154718","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-154719","text":")"}]}],"id":"blk-90650","kind":"list-item"},{"blocks":[{"id":"blk-90653","kind":"paragraph","spans":[{"id":"spn-154720","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-90652","kind":"list-item"},{"blocks":[{"id":"blk-90655","kind":"paragraph","spans":[{"id":"spn-154721","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-90654","kind":"list-item"},{"blocks":[{"id":"blk-90657","kind":"paragraph","spans":[{"id":"spn-154722","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-90656","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90658","items":[{"blocks":[{"id":"blk-90660","kind":"paragraph","spans":[{"id":"spn-154723","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-154724","text":": AWS Bedrock AgentCore ("},{"id":"spn-154725","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-154726","text":")"}]}],"id":"blk-90659","kind":"list-item"},{"blocks":[{"id":"blk-90662","kind":"paragraph","spans":[{"id":"spn-154727","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-90661","kind":"list-item"},{"blocks":[{"id":"blk-90664","kind":"paragraph","spans":[{"id":"spn-154728","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-90663","kind":"list-item"},{"blocks":[{"id":"blk-90666","kind":"paragraph","spans":[{"id":"spn-154729","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-154730","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-90665","kind":"list-item"},{"blocks":[{"id":"blk-90668","kind":"paragraph","spans":[{"id":"spn-154731","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-154732","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-90667","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90669","kind":"heading","level":3,"spans":[{"id":"spn-154733","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-90670","kind":"paragraph","spans":[{"id":"spn-154734","text":"webhost.systems is intended to be "},{"id":"spn-154735","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-154736","text":":"}]},{"id":"blk-90671","items":[{"blocks":[{"id":"blk-90673","kind":"paragraph","spans":[{"id":"spn-154737","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-90672","kind":"list-item"},{"blocks":[{"id":"blk-90675","kind":"paragraph","spans":[{"id":"spn-154738","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-90674","kind":"list-item"},{"blocks":[{"id":"blk-90677","kind":"paragraph","spans":[{"id":"spn-154739","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-90676","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90678","kind":"paragraph","spans":[{"id":"spn-154740","text":"This means "},{"id":"spn-154741","marks":["bold"],"text":"no Python requirement"},{"id":"spn-154742","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-90679","kind":"heading","level":3,"spans":[{"id":"spn-154743","text":"Control plane"}]},{"id":"blk-90680","items":[{"blocks":[{"id":"blk-90682","kind":"paragraph","spans":[{"id":"spn-154744","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-90681","kind":"list-item"},{"blocks":[{"id":"blk-90684","kind":"paragraph","spans":[{"id":"spn-154745","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-90683","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90685","kind":"heading","level":3,"spans":[{"id":"spn-154746","text":"Contract"}]},{"id":"blk-90686","items":[{"blocks":[{"id":"blk-90688","kind":"paragraph","spans":[{"id":"spn-154747","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-154748","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-154749","text":", including:"}]}],"id":"blk-90687","kind":"list-item"},{"blocks":[{"id":"blk-90690","kind":"paragraph","spans":[{"id":"spn-154750","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-90689","kind":"list-item"},{"blocks":[{"id":"blk-90692","kind":"paragraph","spans":[{"id":"spn-154751","marks":["code"],"text":"invoke(...)"},{"id":"spn-154752","text":" (streaming optional but preferred)"}]}],"id":"blk-90691","kind":"list-item"},{"blocks":[{"id":"blk-90694","kind":"paragraph","spans":[{"id":"spn-154753","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-90693","kind":"list-item"},{"blocks":[{"id":"blk-90696","kind":"paragraph","spans":[{"id":"spn-154754","text":"normalized error mapping"}]}],"id":"blk-90695","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90697","kind":"heading","level":2,"spans":[{"id":"spn-154755","text":"Alternatives considered"}]},{"id":"blk-90698","kind":"heading","level":3,"spans":[{"id":"spn-154756","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-90699","kind":"paragraph","spans":[{"id":"spn-154757","marks":["bold"],"text":"Pros"}]},{"id":"blk-90700","items":[{"blocks":[{"id":"blk-90702","kind":"paragraph","spans":[{"id":"spn-154758","text":"Simplest operational model and implementation."}]}],"id":"blk-90701","kind":"list-item"},{"blocks":[{"id":"blk-90704","kind":"paragraph","spans":[{"id":"spn-154759","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-90703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90705","kind":"paragraph","spans":[{"id":"spn-154760","marks":["bold"],"text":"Cons"}]},{"id":"blk-90706","items":[{"blocks":[{"id":"blk-90708","kind":"paragraph","spans":[{"id":"spn-154761","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-90707","kind":"list-item"},{"blocks":[{"id":"blk-90710","kind":"paragraph","spans":[{"id":"spn-154762","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-90709","kind":"list-item"},{"blocks":[{"id":"blk-90712","kind":"paragraph","spans":[{"id":"spn-154763","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-90711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90713","kind":"paragraph","spans":[{"id":"spn-154764","marks":["bold"],"text":"Why rejected"},{"id":"spn-154765","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-90714","kind":"heading","level":3,"spans":[{"id":"spn-154766","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-90715","kind":"paragraph","spans":[{"id":"spn-154767","marks":["bold"],"text":"Pros"}]},{"id":"blk-90716","items":[{"blocks":[{"id":"blk-90718","kind":"paragraph","spans":[{"id":"spn-154768","text":"Strong enterprise posture and capability set."}]}],"id":"blk-90717","kind":"list-item"},{"blocks":[{"id":"blk-90720","kind":"paragraph","spans":[{"id":"spn-154769","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-90719","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90721","kind":"paragraph","spans":[{"id":"spn-154770","marks":["bold"],"text":"Cons"}]},{"id":"blk-90722","items":[{"blocks":[{"id":"blk-90724","kind":"paragraph","spans":[{"id":"spn-154771","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-90723","kind":"list-item"},{"blocks":[{"id":"blk-90726","kind":"paragraph","spans":[{"id":"spn-154772","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-90725","kind":"list-item"},{"blocks":[{"id":"blk-90728","kind":"paragraph","spans":[{"id":"spn-154773","text":"Increased vendor lock-in risk."}]}],"id":"blk-90727","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90729","kind":"paragraph","spans":[{"id":"spn-154774","marks":["bold"],"text":"Why rejected"},{"id":"spn-154775","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-90730","kind":"heading","level":3,"spans":[{"id":"spn-154776","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-90731","kind":"paragraph","spans":[{"id":"spn-154777","marks":["bold"],"text":"Pros"}]},{"id":"blk-90732","items":[{"blocks":[{"id":"blk-90734","kind":"paragraph","spans":[{"id":"spn-154778","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-90733","kind":"list-item"},{"blocks":[{"id":"blk-90736","kind":"paragraph","spans":[{"id":"spn-154779","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-90735","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90737","kind":"paragraph","spans":[{"id":"spn-154780","marks":["bold"],"text":"Cons"}]},{"id":"blk-90738","items":[{"blocks":[{"id":"blk-90740","kind":"paragraph","spans":[{"id":"spn-154781","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-90739","kind":"list-item"},{"blocks":[{"id":"blk-90742","kind":"paragraph","spans":[{"id":"spn-154782","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-90741","kind":"list-item"},{"blocks":[{"id":"blk-90744","kind":"paragraph","spans":[{"id":"spn-154783","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-90743","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90745","kind":"paragraph","spans":[{"id":"spn-154784","marks":["bold"],"text":"Why rejected"},{"id":"spn-154785","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-90746","kind":"heading","level":3,"spans":[{"id":"spn-154786","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-90747","kind":"paragraph","spans":[{"id":"spn-154787","marks":["bold"],"text":"Pros"}]},{"id":"blk-90748","items":[{"blocks":[{"id":"blk-90750","kind":"paragraph","spans":[{"id":"spn-154788","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-90749","kind":"list-item"},{"blocks":[{"id":"blk-90752","kind":"paragraph","spans":[{"id":"spn-154789","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-90751","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90753","kind":"paragraph","spans":[{"id":"spn-154790","marks":["bold"],"text":"Cons"}]},{"id":"blk-90754","items":[{"blocks":[{"id":"blk-90756","kind":"paragraph","spans":[{"id":"spn-154791","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-90755","kind":"list-item"},{"blocks":[{"id":"blk-90758","kind":"paragraph","spans":[{"id":"spn-154792","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-90757","kind":"list-item"},{"blocks":[{"id":"blk-90760","kind":"paragraph","spans":[{"id":"spn-154793","text":"Slower time-to-market."}]}],"id":"blk-90759","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90761","kind":"paragraph","spans":[{"id":"spn-154794","marks":["bold"],"text":"Why rejected"},{"id":"spn-154795","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-90762","kind":"heading","level":2,"spans":[{"id":"spn-154796","text":"Consequences"}]},{"id":"blk-90763","kind":"heading","level":3,"spans":[{"id":"spn-154797","text":"Positive"}]},{"id":"blk-90764","items":[{"blocks":[{"id":"blk-90766","kind":"paragraph","spans":[{"id":"spn-154798","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-154799","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-90765","kind":"list-item"},{"blocks":[{"id":"blk-90768","kind":"paragraph","spans":[{"id":"spn-154800","marks":["bold"],"text":"Product flexibility"},{"id":"spn-154801","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-90767","kind":"list-item"},{"blocks":[{"id":"blk-90770","kind":"paragraph","spans":[{"id":"spn-154802","marks":["bold"],"text":"Risk reduction"},{"id":"spn-154803","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-90769","kind":"list-item"},{"blocks":[{"id":"blk-90772","kind":"paragraph","spans":[{"id":"spn-154804","marks":["bold"],"text":"Future extensibility"},{"id":"spn-154805","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-90771","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90773","kind":"heading","level":3,"spans":[{"id":"spn-154806","text":"Negative / costs"}]},{"id":"blk-90774","items":[{"blocks":[{"id":"blk-90776","kind":"paragraph","spans":[{"id":"spn-154807","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-154808","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-90775","kind":"list-item"},{"blocks":[{"id":"blk-90778","kind":"paragraph","spans":[{"id":"spn-154809","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-154810","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-90777","kind":"list-item"},{"blocks":[{"id":"blk-90780","kind":"paragraph","spans":[{"id":"spn-154811","marks":["bold"],"text":"Operational surface area"},{"id":"spn-154812","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-90779","kind":"list-item"},{"blocks":[{"id":"blk-90782","kind":"paragraph","spans":[{"id":"spn-154813","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-154814","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-90781","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90783","kind":"heading","level":2,"spans":[{"id":"spn-154815","text":"Implementation details (normative requirements)"}]},{"id":"blk-90784","items":[{"blocks":[{"id":"blk-90786","kind":"paragraph","spans":[{"id":"spn-154816","marks":["bold"],"text":"RPI is mandatory"}]}],"id":"blk-90785","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-90787","items":[{"blocks":[{"id":"blk-90789","kind":"paragraph","spans":[{"id":"spn-154817","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-90788","kind":"list-item"},{"blocks":[{"id":"blk-90791","kind":"paragraph","spans":[{"id":"spn-154818","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-90790","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90792","items":[{"blocks":[{"id":"blk-90794","kind":"paragraph","spans":[{"id":"spn-154819","marks":["bold"],"text":"Invocation protocol is consistent"}]}],"id":"blk-90793","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-90795","items":[{"blocks":[{"id":"blk-90797","kind":"paragraph","spans":[{"id":"spn-154820","text":"The canonical request/response shapes are defined in "},{"id":"spn-154821","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-154822","text":" and "},{"id":"spn-154823","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-154824","text":"."}]}],"id":"blk-90796","kind":"list-item"},{"blocks":[{"id":"blk-90799","kind":"paragraph","spans":[{"id":"spn-154825","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-90798","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90800","items":[{"blocks":[{"id":"blk-90802","kind":"paragraph","spans":[{"id":"spn-154826","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]}],"id":"blk-90801","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-90803","items":[{"blocks":[{"id":"blk-90805","kind":"paragraph","spans":[{"id":"spn-154827","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-154828","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-154829","text":"."}]}],"id":"blk-90804","kind":"list-item"},{"blocks":[{"id":"blk-90807","kind":"paragraph","spans":[{"id":"spn-154830","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-90806","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90808","items":[{"blocks":[{"id":"blk-90810","kind":"paragraph","spans":[{"id":"spn-154831","marks":["bold"],"text":"Tier gating"}]}],"id":"blk-90809","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-90811","items":[{"blocks":[{"id":"blk-90813","kind":"paragraph","spans":[{"id":"spn-154832","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-90812","kind":"list-item"},{"blocks":[{"id":"blk-90815","kind":"paragraph","spans":[{"id":"spn-154833","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-90814","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-90816","items":[{"blocks":[{"id":"blk-90818","kind":"paragraph","spans":[{"id":"spn-154834","marks":["bold"],"text":"Secrets handling"}]}],"id":"blk-90817","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-90819","items":[{"blocks":[{"id":"blk-90821","kind":"paragraph","spans":[{"id":"spn-154835","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-90820","kind":"list-item"},{"blocks":[{"id":"blk-90823","kind":"paragraph","spans":[{"id":"spn-154836","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id"