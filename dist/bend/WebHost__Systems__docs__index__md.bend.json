{"bendscript":"0.1","blocks":[{"id":"blk-24758","kind":"heading","level":1,"spans":[{"id":"spn-30032","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-24760","kind":"paragraph","spans":[{"id":"spn-30033","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-24759","kind":"quote"},{"blocks":[{"id":"blk-24762","kind":"paragraph","spans":[{"id":"spn-30034","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-30035","text":" · "},{"id":"spn-30036","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-30037","text":" · "},{"id":"spn-30038","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-30039","text":" · "},{"id":"spn-30040","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-24761","kind":"quote"},{"id":"blk-24763","kind":"paragraph","spans":[{"id":"spn-30041","text":"Welcome to the documentation hub for "},{"id":"spn-30042","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-30043","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-24764","kind":"paragraph","spans":[{"id":"spn-30044","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-24765","items":[{"blocks":[{"id":"blk-24767","kind":"paragraph","spans":[{"id":"spn-30045","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-30046","text":" — create agents, deploy code bundles,"}]}],"id":"blk-24766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24768","kind":"paragraph","spans":[{"id":"spn-30047","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-24769","items":[{"blocks":[{"id":"blk-24771","kind":"paragraph","spans":[{"id":"spn-30048","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-30049","text":" — validate "},{"id":"spn-30050","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-24770","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24772","kind":"paragraph","spans":[{"id":"spn-30051","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-24773","kind":"paragraph","spans":[{"id":"spn-30052","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-24774","kind":"paragraph","spans":[{"id":"spn-30053","text":"---"}]},{"id":"blk-24775","kind":"heading","level":2,"spans":[{"id":"spn-30054","text":"What you'll find here"}]},{"id":"blk-24776","items":[{"blocks":[{"id":"blk-24778","kind":"paragraph","spans":[{"id":"spn-30055","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-24777","kind":"list-item"},{"blocks":[{"id":"blk-24780","kind":"paragraph","spans":[{"id":"spn-30056","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-24779","kind":"list-item"},{"blocks":[{"id":"blk-24782","kind":"paragraph","spans":[{"id":"spn-30057","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-24781","kind":"list-item"},{"blocks":[{"id":"blk-24784","kind":"paragraph","spans":[{"id":"spn-30058","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-30059","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-24783","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24785","kind":"paragraph","spans":[{"id":"spn-30060","text":"---"}]},{"id":"blk-24786","kind":"heading","level":2,"spans":[{"id":"spn-30061","text":"Quick Links"}]},{"head":[{"id":"blk-24788","spans":[{"id":"spn-30062","text":"Document"}]},{"id":"blk-24789","spans":[{"id":"spn-30063","text":"Description"}]}],"id":"blk-24787","kind":"table","rows":[[{"id":"blk-24790","spans":[{"id":"spn-30064","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/quickstart.md"}],"text":"Quickstart"}]},{"id":"blk-24791","spans":[{"id":"spn-30065","text":"Local dev setup, first agent, verification"}]}],[{"id":"blk-24792","spans":[{"id":"spn-30066","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture"}]},{"id":"blk-24793","spans":[{"id":"spn-30067","text":"Control plane / data plane design, system diagram"}]}],[{"id":"blk-24794","spans":[{"id":"spn-30068","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"}]},{"id":"blk-24795","spans":[{"id":"spn-30069","text":"Operational skills index for agents and engineers"}]}]]},{"id":"blk-24796","kind":"paragraph","spans":[{"id":"spn-30070","text":"---"}]},{"id":"blk-24797","kind":"heading","level":2,"spans":[{"id":"spn-30071","text":"Documentation Map"}]},{"id":"blk-24798","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-24799","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-24800","kind":"code","language":"text","text":":maxdepth: 2\n:caption: WebHost.Systems Docs\n\nquickstart\narchitecture\nspec/00_MASTER_SPEC\nspec/README"},{"id":"blk-24801","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Skills\n\nskills/SKILLS\nskills/01_AGENT_MANAGEMENT\nskills/02_DEPLOYMENT_PIPELINE\nskills/03_INVOCATION_GATEWAY\nskills/04_RUNTIME_PROVIDERS\nskills/05_TELEMETRY_AND_METRICS\nskills/06_BILLING_AND_LIMITS\nskills/07_SECURITY_AND_SECRETS\nskills/08_AMPERSAND_INTEGRATION\nskills/09_ANTI_PATTERNS"},{"id":"blk-24802","kind":"paragraph","spans":[{"id":"spn-30072","text":"---"}]},{"id":"blk-24803","kind":"heading","level":2,"spans":[{"id":"spn-30073","text":"Suggested Reading Order"}]},{"id":"blk-24804","kind":"paragraph","spans":[{"id":"spn-30074","text":"If you're new to the project, follow this path:"}]},{"id":"blk-24805","kind":"paragraph","spans":[{"id":"spn-30075","text":"1. "},{"id":"spn-30076","marks":["bold"],"text":"quickstart"},{"id":"spn-30077","text":" — local dev setup, first agent creation, verification 2. "},{"id":"spn-30078","marks":["bold"],"text":"architecture"},{"id":"spn-30079","text":" — control plane / data plane design, request flows, data model 3. "},{"id":"spn-30080","marks":["bold"],"text":"skills/SKILLS"},{"id":"spn-30081","text":" — skills registry and tool inventory 4. "},{"id":"spn-30082","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-30083","text":" — agent CRUD, status lifecycle, provider config 5. "},{"id":"spn-30084","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-30085","text":" — bundle upload, validation, immutable deployments 6. "},{"id":"spn-30086","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-30087","text":" — request/response shapes, auth, streaming 7. "},{"id":"spn-30088","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-30089","text":" — RPI abstraction, Cloudflare and AgentCore adapters 8. "},{"id":"spn-30090","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-30091","text":" — metrics schema, aggregation 9. "},{"id":"spn-30092","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-30093","text":" — subscription tiers, enforcement, checkout 10. "},{"id":"spn-30094","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-30095","text":" — RLS isolation, Vault secrets, audit 11. "},{"id":"spn-30096","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-30097","text":" — [&] manifests, MCP sidecars, A2A routing 12. "},{"id":"spn-30098","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-30099","text":" — common mistakes and how to avoid them"}]},{"id":"blk-24806","kind":"paragraph","spans":[{"id":"spn-30100","text":"For "},{"id":"spn-30101","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-30102","text":", start at "},{"id":"spn-30103","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-30104","text":" and "},{"id":"spn-30105","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-30106","text":"."}]},{"id":"blk-24807","kind":"paragraph","spans":[{"id":"spn-30107","text":"For "},{"id":"spn-30108","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-30109","text":", start at "},{"id":"spn-30110","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-30111","text":" and the "},{"id":"spn-30112","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-30113","text":" spec."}]},{"id":"blk-24808","kind":"paragraph","spans":[{"id":"spn-30114","text":"---"}]},{"id":"blk-24809","kind":"heading","level":2,"spans":[{"id":"spn-30115","text":"Core Concepts"}]},{"id":"blk-24810","kind":"heading","level":3,"spans":[{"id":"spn-30116","text":"Control Plane"}]},{"id":"blk-24811","kind":"paragraph","spans":[{"id":"spn-30117","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-24812","kind":"heading","level":3,"spans":[{"id":"spn-30118","text":"Data Plane"}]},{"id":"blk-24813","kind":"paragraph","spans":[{"id":"spn-30119","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-24815","spans":[{"id":"spn-30120","text":"Runtime"}]},{"id":"blk-24816","spans":[{"id":"spn-30121","text":"Strengths"}]},{"id":"blk-24817","spans":[{"id":"spn-30122","text":"Best for"}]}],"id":"blk-24814","kind":"table","rows":[[{"id":"blk-24818","spans":[{"id":"spn-30123","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-24819","spans":[{"id":"spn-30124","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-24820","spans":[{"id":"spn-30125","text":"Most agents (default)"}]}],[{"id":"blk-24821","spans":[{"id":"spn-30126","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-24822","spans":[{"id":"spn-30127","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-24823","spans":[{"id":"spn-30128","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-24824","kind":"heading","level":3,"spans":[{"id":"spn-30129","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-24825","kind":"paragraph","spans":[{"id":"spn-30130","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-24826","kind":"heading","level":3,"spans":[{"id":"spn-30131","text":"Deployment Immutability"}]},{"id":"blk-24827","kind":"paragraph","spans":[{"id":"spn-30132","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-24828","kind":"heading","level":3,"spans":[{"id":"spn-30133","text":"Metered Telemetry"}]},{"id":"blk-24829","kind":"paragraph","spans":[{"id":"spn-30134","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-24830","kind":"paragraph","spans":[{"id":"spn-30135","text":"---"}]},{"id":"blk-24831","kind":"heading","level":2,"spans":[{"id":"spn-30136","text":"Core Idea"}]},{"id":"blk-24832","kind":"paragraph","spans":[{"id":"spn-30137","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-24834","kind":"paragraph","spans":[{"id":"spn-30138","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-24833","kind":"quote"},{"id":"blk-24835","kind":"paragraph","spans":[{"id":"spn-30139","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-30140","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-30141","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-24836","kind":"paragraph","spans":[{"id":"spn-30142","text":"---"}]},{"id":"blk-24837","kind":"heading","level":2,"spans":[{"id":"spn-30143","text":"Spec References"}]},{"id":"blk-24838","kind":"paragraph","spans":[{"id":"spn-30144","text":"The authoritative engineering spec lives in "},{"id":"spn-30145","marks":["code"],"text":"docs/spec/"},{"id":"spn-30146","text":":"}]},{"id":"blk-24839","items":[{"blocks":[{"id":"blk-24841","kind":"paragraph","spans":[{"id":"spn-30147","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-24840","kind":"list-item"},{"blocks":[{"id":"blk-24843","kind":"paragraph","spans":[{"id":"spn-30148","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-24842","kind":"list-item"},{"blocks":[{"id":"blk-24845","kind":"paragraph","spans":[{"id":"spn-30149","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-24844","kind":"list-item"},{"blocks":[{"id":"blk-24847","kind":"paragraph","spans":[{"id":"spn-30150","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"blk-24846","kind":"list-item"},{"blocks":[{"id":"blk-24849","kind":"paragraph","spans":[{"id":"spn-30151","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/30_DATA_MODEL_SUPABASE.md"}],"text":"30 — Data Model (Supabase/PostgreSQL) & Access Control"}]}],"id":"blk-24848","kind":"list-item"},{"blocks":[{"id":"blk-24851","kind":"paragraph","spans":[{"id":"spn-30152","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}],"text":"40 — Security, Secrets, and Compliance"}]}],"id":"blk-24850","kind":"list-item"},{"blocks":[{"id":"blk-24853","kind":"paragraph","spans":[{"id":"spn-30153","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}],"text":"50 — Observability, Metering, Cost, Tiers, and Limit Enforcement"}]}],"id":"blk-24852","kind":"list-item"},{"blocks":[{"id":"blk-24855","kind":"paragraph","spans":[{"id":"spn-30154","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}],"text":"60 — Testing Plan & Acceptance Criteria"}]}],"id":"blk-24854","kind":"list-item"},{"blocks":[{"id":"blk-24857","kind":"paragraph","spans":[{"id":"spn-30155","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/70_AMPERSAND_PROTOCOL_INTEGRATION.md"}],"text":"70 — Ampersand Protocol Integration"}]}],"id":"blk-24856","kind":"list-item"},{"blocks":[{"id":"blk-24859","kind":"paragraph","spans":[{"id":"spn-30156","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/REALIGNMENT_PLAN.md"}],"text":"Spec-to-Implementation Realignment Plan"}]}],"id":"blk-24858","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24860","kind":"heading","level":3,"spans":[{"id":"spn-30157","text":"Architecture decision records"}]},{"id":"blk-24861","items":[{"blocks":[{"id":"blk-24863","kind":"paragraph","spans":[{"id":"spn-30158","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0001-multi-runtime.md"}],"text":"ADR-0001 — Multi-Runtime Strategy"}]}],"id":"blk-24862","kind":"list-item"},{"blocks":[{"id":"blk-24865","kind":"paragraph","spans":[{"id":"spn-30159","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0002-supabase-control-plane.md"}],"text":"ADR-0002 — Supabase as the Control Plane Backend"}]}],"id":"blk-24864","kind":"list-item"},{"blocks":[{"id":"blk-24867","kind":"paragraph","spans":[{"id":"spn-30160","marks":[{"kind":"link","predicate":"cit