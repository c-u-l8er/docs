27","kind":"paragraph","spans":[{"id":"spn-70629","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-70630","text":" — agent CRUD, status lifecycle, provider config"}]}],"id":"blk-42826","kind":"list-item"},{"blocks":[{"id":"blk-42829","kind":"paragraph","spans":[{"id":"spn-70631","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-70632","text":" — bundle upload, validation, immutable deployments"}]}],"id":"blk-42828","kind":"list-item"},{"blocks":[{"id":"blk-42831","kind":"paragraph","spans":[{"id":"spn-70633","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-70634","text":" — request/response shapes, auth, streaming"}]}],"id":"blk-42830","kind":"list-item"},{"blocks":[{"id":"blk-42833","kind":"paragraph","spans":[{"id":"spn-70635","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-70636","text":" — RPI abstraction, Cloudflare and AgentCore adapters"}]}],"id":"blk-42832","kind":"list-item"},{"blocks":[{"id":"blk-42835","kind":"paragraph","spans":[{"id":"spn-70637","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-70638","text":" — metrics schema, aggregation"}]}],"id":"blk-42834","kind":"list-item"},{"blocks":[{"id":"blk-42837","kind":"paragraph","spans":[{"id":"spn-70639","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-70640","text":" — subscription tiers, enforcement, checkout"}]}],"id":"blk-42836","kind":"list-item"},{"blocks":[{"id":"blk-42839","kind":"paragraph","spans":[{"id":"spn-70641","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-70642","text":" — RLS isolation, Vault secrets, audit"}]}],"id":"blk-42838","kind":"list-item"},{"blocks":[{"id":"blk-42841","kind":"paragraph","spans":[{"id":"spn-70643","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-70644","text":" — [&] manifests, MCP sidecars, A2A routing"}]}],"id":"blk-42840","kind":"list-item"},{"blocks":[{"id":"blk-42843","kind":"paragraph","spans":[{"id":"spn-70645","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-70646","text":" — common mistakes and how to avoid them"}]}],"id":"blk-42842","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-42844","kind":"paragraph","spans":[{"id":"spn-70647","text":"For "},{"id":"spn-70648","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-70649","text":", start at "},{"id":"spn-70650","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-70651","text":" and "},{"id":"spn-70652","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-70653","text":"."}]},{"id":"blk-42845","kind":"paragraph","spans":[{"id":"spn-70654","text":"For "},{"id":"spn-70655","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-70656","text":", start at "},{"id":"spn-70657","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-70658","text":" and the "},{"id":"spn-70659","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-70660","text":" spec."}]},{"id":"blk-42846","kind":"heading","level":2,"spans":[{"id":"spn-70661","text":"Core Concepts"}]},{"id":"blk-42847","kind":"heading","level":3,"spans":[{"id":"spn-70662","text":"Control Plane"}]},{"id":"blk-42848","kind":"paragraph","spans":[{"id":"spn-70663","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-42849","kind":"heading","level":3,"spans":[{"id":"spn-70664","text":"Data Plane"}]},{"id":"blk-42850","kind":"paragraph","spans":[{"id":"spn-70665","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-42852","spans":[{"id":"spn-70666","text":"Runtime"}]},{"id":"blk-42853","spans":[{"id":"spn-70667","text":"Strengths"}]},{"id":"blk-42854","spans":[{"id":"spn-70668","text":"Best for"}]}],"id":"blk-42851","kind":"table","rows":[[{"id":"blk-42855","spans":[{"id":"spn-70669","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-42856","spans":[{"id":"spn-70670","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-42857","spans":[{"id":"spn-70671","text":"Most agents (default)"}]}],[{"id":"blk-42858","spans":[{"id":"spn-70672","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-42859","spans":[{"id":"spn-70673","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-42860","spans":[{"id":"spn-70674","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-42861","kind":"heading","level":3,"spans":[{"id":"spn-70675","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-42862","kind":"paragraph","spans":[{"id":"spn-70676","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-42863","kind":"heading","level":3,"spans":[{"id":"spn-70677","text":"Deployment Immutability"}]},{"id":"blk-42864","kind":"paragraph","spans":[{"id":"spn-70678","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-42865","kind":"heading","level":3,"spans":[{"id":"spn-70679","text":"Metered Telemetry"}]},{"id":"blk-42866","kind":"paragraph","spans":[{"id":"spn-70680","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-42867","kind":"heading","level":2,"spans":[{"id":"spn-70681","text":"Core Idea"}]},{"id":"blk-42868","kind":"paragraph","spans":[{"id":"spn-70682","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-42870","kind":"paragraph","spans":[{"id":"spn-70683","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-42869","kind":"quote"},{"id":"blk-42871","kind":"paragraph","spans":[{"id":"spn-70684","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-70685","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-70686","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-42872","kind":"heading","level":2,"spans":[{"id":"spn-70687","text":"Spec References"}]},{"id":"blk-42873","kind":"paragraph","spans":[{"id":"spn-70688","text":"The authoritative engineering spec lives in "},{"id":"spn-70689","marks":["code"],"text":"docs/spec/"},{"id":"spn-70690","text":":"}]},{"id":"blk-42874","items":[{"blocks":[{"id":"blk-42876","kind":"paragraph","spans":[{"id":"spn-70691","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-42875","kind":"list-item"},{"blocks":[{"id":"blk-42878","kind":"paragraph","spans":[{"id":"spn-70692","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-42877","kind":"list-item"},{"blocks":[{"id":"blk-42880","kind":"paragraph","spans":[{"id":"spn-70693","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-42879","kind":"list-item"},{"blocks":[{"id":"blk-42882","kind":"paragraph","spans":[{"id":"spn-70694","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"