43","kind":"paragraph","spans":[{"id":"spn-73019","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-73020","text":" — agent CRUD, status lifecycle, provider config"}]}],"id":"blk-43542","kind":"list-item"},{"blocks":[{"id":"blk-43545","kind":"paragraph","spans":[{"id":"spn-73021","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-73022","text":" — bundle upload, validation, immutable deployments"}]}],"id":"blk-43544","kind":"list-item"},{"blocks":[{"id":"blk-43547","kind":"paragraph","spans":[{"id":"spn-73023","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-73024","text":" — request/response shapes, auth, streaming"}]}],"id":"blk-43546","kind":"list-item"},{"blocks":[{"id":"blk-43549","kind":"paragraph","spans":[{"id":"spn-73025","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-73026","text":" — RPI abstraction, Cloudflare and AgentCore adapters"}]}],"id":"blk-43548","kind":"list-item"},{"blocks":[{"id":"blk-43551","kind":"paragraph","spans":[{"id":"spn-73027","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-73028","text":" — metrics schema, aggregation"}]}],"id":"blk-43550","kind":"list-item"},{"blocks":[{"id":"blk-43553","kind":"paragraph","spans":[{"id":"spn-73029","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-73030","text":" — subscription tiers, enforcement, checkout"}]}],"id":"blk-43552","kind":"list-item"},{"blocks":[{"id":"blk-43555","kind":"paragraph","spans":[{"id":"spn-73031","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-73032","text":" — RLS isolation, Vault secrets, audit"}]}],"id":"blk-43554","kind":"list-item"},{"blocks":[{"id":"blk-43557","kind":"paragraph","spans":[{"id":"spn-73033","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-73034","text":" — [&] manifests, MCP sidecars, A2A routing"}]}],"id":"blk-43556","kind":"list-item"},{"blocks":[{"id":"blk-43559","kind":"paragraph","spans":[{"id":"spn-73035","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-73036","text":" — common mistakes and how to avoid them"}]}],"id":"blk-43558","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43560","kind":"paragraph","spans":[{"id":"spn-73037","text":"For "},{"id":"spn-73038","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-73039","text":", start at "},{"id":"spn-73040","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-73041","text":" and "},{"id":"spn-73042","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-73043","text":"."}]},{"id":"blk-43561","kind":"paragraph","spans":[{"id":"spn-73044","text":"For "},{"id":"spn-73045","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-73046","text":", start at "},{"id":"spn-73047","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-73048","text":" and the "},{"id":"spn-73049","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-73050","text":" spec."}]},{"id":"blk-43562","kind":"heading","level":2,"spans":[{"id":"spn-73051","text":"Core Concepts"}]},{"id":"blk-43563","kind":"heading","level":3,"spans":[{"id":"spn-73052","text":"Control Plane"}]},{"id":"blk-43564","kind":"paragraph","spans":[{"id":"spn-73053","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-43565","kind":"heading","level":3,"spans":[{"id":"spn-73054","text":"Data Plane"}]},{"id":"blk-43566","kind":"paragraph","spans":[{"id":"spn-73055","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-43568","spans":[{"id":"spn-73056","text":"Runtime"}]},{"id":"blk-43569","spans":[{"id":"spn-73057","text":"Strengths"}]},{"id":"blk-43570","spans":[{"id":"spn-73058","text":"Best for"}]}],"id":"blk-43567","kind":"table","rows":[[{"id":"blk-43571","spans":[{"id":"spn-73059","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-43572","spans":[{"id":"spn-73060","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-43573","spans":[{"id":"spn-73061","text":"Most agents (default)"}]}],[{"id":"blk-43574","spans":[{"id":"spn-73062","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-43575","spans":[{"id":"spn-73063","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-43576","spans":[{"id":"spn-73064","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-43577","kind":"heading","level":3,"spans":[{"id":"spn-73065","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-43578","kind":"paragraph","spans":[{"id":"spn-73066","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-43579","kind":"heading","level":3,"spans":[{"id":"spn-73067","text":"Deployment Immutability"}]},{"id":"blk-43580","kind":"paragraph","spans":[{"id":"spn-73068","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-43581","kind":"heading","level":3,"spans":[{"id":"spn-73069","text":"Metered Telemetry"}]},{"id":"blk-43582","kind":"paragraph","spans":[{"id":"spn-73070","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-43583","kind":"heading","level":2,"spans":[{"id":"spn-73071","text":"Core Idea"}]},{"id":"blk-43584","kind":"paragraph","spans":[{"id":"spn-73072","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-43586","kind":"paragraph","spans":[{"id":"spn-73073","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-43585","kind":"quote"},{"id":"blk-43587","kind":"paragraph","spans":[{"id":"spn-73074","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-73075","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-73076","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-43588","kind":"heading","level":2,"spans":[{"id":"spn-73077","text":"Spec References"}]},{"id":"blk-43589","kind":"paragraph","spans":[{"id":"spn-73078","text":"The authoritative engineering spec lives in "},{"id":"spn-73079","marks":["code"],"text":"docs/spec/"},{"id":"spn-73080","text":":"}]},{"id":"blk-43590","items":[{"blocks":[{"id":"blk-43592","kind":"paragraph","spans":[{"id":"spn-73081","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-43591","kind":"list-item"},{"blocks":[{"id":"blk-43594","kind":"paragraph","spans":[{"id":"spn-73082","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-43593","kind":"list-item"},{"blocks":[{"id":"blk-43596","kind":"paragraph","spans":[{"id":"spn-73083","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-43595","kind":"list-item"},{"blocks":[{"id":"blk-43598","kind":"paragraph","spans":[{"id":"spn-73084","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"