{"bendscript":"0.1","blocks":[{"id":"blk-42692","kind":"heading","level":1,"spans":[{"id":"spn-70540","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-42694","kind":"paragraph","spans":[{"id":"spn-70541","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-42693","kind":"quote"},{"blocks":[{"id":"blk-42696","kind":"paragraph","spans":[{"id":"spn-70542","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-70543","text":" · "},{"id":"spn-70544","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-70545","text":" · "},{"id":"spn-70546","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-70547","text":" · "},{"id":"spn-70548","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-42695","kind":"quote"},{"id":"blk-42697","kind":"paragraph","spans":[{"id":"spn-70549","text":"Welcome to the documentation hub for "},{"id":"spn-70550","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-70551","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-42698","kind":"paragraph","spans":[{"id":"spn-70552","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-42699","items":[{"blocks":[{"id":"blk-42701","kind":"paragraph","spans":[{"id":"spn-70553","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-70554","text":" — create agents, deploy code bundles,"}]}],"id":"blk-42700","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42702","kind":"paragraph","spans":[{"id":"spn-70555","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-42703","items":[{"blocks":[{"id":"blk-42705","kind":"paragraph","spans":[{"id":"spn-70556","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-70557","text":" — validate "},{"id":"spn-70558","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-42704","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42706","kind":"paragraph","spans":[{"id":"spn-70559","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-42707","kind":"paragraph","spans":[{"id":"spn-70560","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-42708","kind":"heading","level":2,"spans":[{"id":"spn-70561","text":"What you'll find here"}]},{"id":"blk-42709","items":[{"blocks":[{"id":"blk-42711","kind":"paragraph","spans":[{"id":"spn-70562","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-42710","kind":"list-item"},{"blocks":[{"id":"blk-42713","kind":"paragraph","spans":[{"id":"spn-70563","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-42712","kind":"list-item"},{"blocks":[{"id":"blk-42715","kind":"paragraph","spans":[{"id":"spn-70564","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-42714","kind":"list-item"},{"blocks":[{"id":"blk-42717","kind":"paragraph","spans":[{"id":"spn-70565","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-70566","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-42716","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42718","kind":"heading","level":2,"spans":[{"id":"spn-70567","text":"Quick Links"}]},{"head":[{"id":"blk-42720","spans":[{"id":"spn-70568","text":"Document"}