{"bendscript":"0.1","blocks":[{"id":"blk-24272","kind":"heading","level":1,"spans":[{"id":"spn-28916","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-24274","kind":"paragraph","spans":[{"id":"spn-28917","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-24273","kind":"quote"},{"blocks":[{"id":"blk-24276","kind":"paragraph","spans":[{"id":"spn-28918","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-28919","text":" · "},{"id":"spn-28920","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-28921","text":" · "},{"id":"spn-28922","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-28923","text":" · "},{"id":"spn-28924","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-24275","kind":"quote"},{"id":"blk-24277","kind":"paragraph","spans":[{"id":"spn-28925","text":"Welcome to the documentation hub for "},{"id":"spn-28926","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-28927","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-24278","kind":"paragraph","spans":[{"id":"spn-28928","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-24279","items":[{"blocks":[{"id":"blk-24281","kind":"paragraph","spans":[{"id":"spn-28929","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-28930","text":" — create agents, deploy code bundles,"}]}],"id":"blk-24280","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24282","kind":"paragraph","spans":[{"id":"spn-28931","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-24283","items":[{"blocks":[{"id":"blk-24285","kind":"paragraph","spans":[{"id":"spn-28932","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-28933","text":" — validate "},{"id":"spn-28934","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-24284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24286","kind":"paragraph","spans":[{"id":"spn-28935","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-24287","kind":"paragraph","spans":[{"id":"spn-28936","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-24288","kind":"paragraph","spans":[{"id":"spn-28937","text":"---"}]},{"id":"blk-24289","kind":"heading","level":2,"spans":[{"id":"spn-28938","text":"What you'll find here"}]},{"id":"blk-24290","items":[{"blocks":[{"id":"blk-24292","kind":"paragraph","spans":[{"id":"spn-28939","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-24291","kind":"list-item"},{"blocks":[{"id":"blk-24294","kind":"paragraph","spans":[{"id":"spn-28940","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-24293","kind":"list-item"},{"blocks":[{"id":"blk-24296","kind":"paragraph","spans":[{"id":"spn-28941","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-24295","kind":"list-item"},{"blocks":[{"id":"blk-24298","kind":"paragraph","spans":[{"id":"spn-28942","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-28943","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-24297","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24299","kind":"paragraph","spans":[{"id":"spn-28944","text":"---"}]},{"id":"blk-24300","kind":"heading","level":2,"spans":[{"id":"spn-28945","text":"Quick Links"}]},{"head":[{"id":"blk-24302","spans":[{"id":"spn-28946","text":"Document"}]},{"id":"blk-24303","spans":[{"id":"spn-28947","text":"Description"}]}],"id":"blk-24301","kind":"table","rows":[[{"id":"blk-24304","spans":[{"id":"spn-28948","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/quickstart.md"}],"text":"Quickstart"}]},{"id":"blk-24305","spans":[{"id":"spn-28949","text":"Local dev setup, first agent, verification"}]}],[{"id":"blk-24306","spans":[{"id":"spn-28950","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture"}]},{"id":"blk-24307","spans":[{"id":"spn-28951","text":"Control plane / data plane design, system diagram"}]}],[{"id":"blk-24308","spans":[{"id":"spn-28952","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"}]},{"id":"blk-24309","spans":[{"id":"spn-28953","text":"Operational skills index for agents and engineers"}]}]]},{"id":"blk-24310","kind":"paragraph","spans":[{"id":"spn-28954","text":"---"}]},{"id":"blk-24311","kind":"heading","level":2,"spans":[{"id":"spn-28955","text":"Documentation Map"}]},{"id":"blk-24312","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-24313","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-24314","kind":"code","language":"text","text":":maxdepth: 2\n:caption: WebHost.Systems Docs\n\nquickstart\narchitecture\nspec/00_MASTER_SPEC\nspec/README"},{"id":"blk-24315","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Skills\n\nskills/SKILLS\nskills/01_AGENT_MANAGEMENT\nskills/02_DEPLOYMENT_PIPELINE\nskills/03_INVOCATION_GATEWAY\nskills/04_RUNTIME_PROVIDERS\nskills/05_TELEMETRY_AND_METRICS\nskills/06_BILLING_AND_LIMITS\nskills/07_SECURITY_AND_SECRETS\nskills/08_AMPERSAND_INTEGRATION\nskills/09_ANTI_PATTERNS"},{"id":"blk-24316","kind":"paragraph","spans":[{"id":"spn-28956","text":"---"}]},{"id":"blk-24317","kind":"heading","level":2,"spans":[{"id":"spn-28957","text":"Suggested Reading Order"}]},{"id":"blk-24318","kind":"paragraph","spans":[{"id":"spn-28958","text":"If you're new to the project, follow this path:"}]},{"id":"blk-24319","kind":"paragraph","spans":[{"id":"spn-28959","text":"1. "},{"id":"spn-28960","marks":["bold"],"text":"quickstart"},{"id":"spn-28961","text":" — local dev setup, first agent creation, verification 2. "},{"id":"spn-28962","marks":["bold"],"text":"architecture"},{"id":"spn-28963","text":" — control plane / data plane design, request flows, data model 3. "},{"id":"spn-28964","marks":["bold"],"text":"skills/SKILLS"},{"id":"spn-28965","text":" — skills registry and tool inventory 4. "},{"id":"spn-28966","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-28967","text":" — agent CRUD, status lifecycle, provider config 5. "},{"id":"spn-28968","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-28969","text":" — bundle upload, validation, immutable deployments 6. "},{"id":"spn-28970","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-28971","text":" — request/response shapes, auth, streaming 7. "},{"id":"spn-28972","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-28973","text":" — RPI abstraction, Cloudflare and AgentCore adapters 8. "},{"id":"spn-28974","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-28975","text":" — metrics schema, aggregation 9. "},{"id":"spn-28976","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-28977","text":" — subscription tiers, enforcement, checkout 10. "},{"id":"spn-28978","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-28979","text":" — RLS isolation, Vault secrets, audit 11. "},{"id":"spn-28980","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-28981","text":" — [&] manifests, MCP sidecars, A2A routing 12. "},{"id":"spn-28982","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-28983","text":" — common mistakes and how to avoid them"}]},{"id":"blk-24320","kind":"paragraph","spans":[{"id":"spn-28984","text":"For "},{"id":"spn-28985","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-28986","text":", start at "},{"id":"spn-28987","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-28988","text":" and "},{"id":"spn-28989","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-28990","text":"."}]},{"id":"blk-24321","kind":"paragraph","spans":[{"id":"spn-28991","text":"For "},{"id":"spn-28992","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-28993","text":", start at "},{"id":"spn-28994","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-28995","text":" and the "},{"id":"spn-28996","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-28997","text":" spec."}]},{"id":"blk-24322","kind":"paragraph","spans":[{"id":"spn-28998","text":"---"}]},{"id":"blk-24323","kind":"heading","level":2,"spans":[{"id":"spn-28999","text":"Core Concepts"}]},{"id":"blk-24324","kind":"heading","level":3,"spans":[{"id":"spn-29000","text":"Control Plane"}]},{"id":"blk-24325","kind":"paragraph","spans":[{"id":"spn-29001","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-24326","kind":"heading","level":3,"spans":[{"id":"spn-29002","text":"Data Plane"}]},{"id":"blk-24327","kind":"paragraph","spans":[{"id":"spn-29003","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-24329","spans":[{"id":"spn-29004","text":"Runtime"}]},{"id":"blk-24330","spans":[{"id":"spn-29005","text":"Strengths"}]},{"id":"blk-24331","spans":[{"id":"spn-29006","text":"Best for"}]}],"id":"blk-24328","kind":"table","rows":[[{"id":"blk-24332","spans":[{"id":"spn-29007","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-24333","spans":[{"id":"spn-29008","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-24334","spans":[{"id":"spn-29009","text":"Most agents (default)"}]}],[{"id":"blk-24335","spans":[{"id":"spn-29010","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-24336","spans":[{"id":"spn-29011","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-24337","spans":[{"id":"spn-29012","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-24338","kind":"heading","level":3,"spans":[{"id":"spn-29013","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-24339","kind":"paragraph","spans":[{"id":"spn-29014","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-24340","kind":"heading","level":3,"spans":[{"id":"spn-29015","text":"Deployment Immutability"}]},{"id":"blk-24341","kind":"paragraph","spans":[{"id":"spn-29016","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-24342","kind":"heading","level":3,"spans":[{"id":"spn-29017","text":"Metered Telemetry"}]},{"id":"blk-24343","kind":"paragraph","spans":[{"id":"spn-29018","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-24344","kind":"paragraph","spans":[{"id":"spn-29019","text":"---"}]},{"id":"blk-24345","kind":"heading","level":2,"spans":[{"id":"spn-29020","text":"Core Idea"}]},{"id":"blk-24346","kind":"paragraph","spans":[{"id":"spn-29021","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-24348","kind":"paragraph","spans":[{"id":"spn-29022","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-24347","kind":"quote"},{"id":"blk-24349","kind":"paragraph","spans":[{"id":"spn-29023","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-29024","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-29025","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-24350","kind":"paragraph","spans":[{"id":"spn-29026","text":"---"}]},{"id":"blk-24351","kind":"heading","level":2,"spans":[{"id":"spn-29027","text":"Spec References"}]},{"id":"blk-24352","kind":"paragraph","spans":[{"id":"spn-29028","text":"The authoritative engineering spec lives in "},{"id":"spn-29029","marks":["code"],"text":"docs/spec/"},{"id":"spn-29030","text":":"}]},{"id":"blk-24353","items":[{"blocks":[{"id":"blk-24355","kind":"paragraph","spans":[{"id":"spn-29031","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-24354","kind":"list-item"},{"blocks":[{"id":"blk-24357","kind":"paragraph","spans":[{"id":"spn-29032","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-24356","kind":"list-item"},{"blocks":[{"id":"blk-24359","kind":"paragraph","spans":[{"id":"spn-29033","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-24358","kind":"list-item"},{"blocks":[{"id":"blk-24361","kind":"paragraph","spans":[{"id":"spn-29034","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"blk-24360","kind":"list-item"},{"blocks":[{"id":"blk-24363","kind":"paragraph","spans":[{"id":"spn-29035","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/30_DATA_MODEL_SUPABASE.md"}],"text":"30 — Data Model (Supabase/PostgreSQL) & Access Control"}]}],"id":"blk-24362","kind":"list-item"},{"blocks":[{"id":"blk-24365","kind":"paragraph","spans":[{"id":"spn-29036","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}],"text":"40 — Security, Secrets, and Compliance"}]}],"id":"blk-24364","kind":"list-item"},{"blocks":[{"id":"blk-24367","kind":"paragraph","spans":[{"id":"spn-29037","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}],"text":"50 — Observability, Metering, Cost, Tiers, and Limit Enforcement"}]}],"id":"blk-24366","kind":"list-item"},{"blocks":[{"id":"blk-24369","kind":"paragraph","spans":[{"id":"spn-29038","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}],"text":"60 — Testing Plan & Acceptance Criteria"}]}],"id":"blk-24368","kind":"list-item"},{"blocks":[{"id":"blk-24371","kind":"paragraph","spans":[{"id":"spn-29039","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/70_AMPERSAND_PROTOCOL_INTEGRATION.md"}],"text":"70 — Ampersand Protocol Integration"}]}],"id":"blk-24370","kind":"list-item"},{"blocks":[{"id":"blk-24373","kind":"paragraph","spans":[{"id":"spn-29040","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/REALIGNMENT_PLAN.md"}],"text":"Spec-to-Implementation Realignment Plan"}]}],"id":"blk-24372","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-24374","kind":"heading","level":3,"spans":[{"id":"spn-29041","text":"Architecture decision records"}]},{"id":"blk-24375","items":[{"blocks":[{"id":"blk-24377","kind":"paragraph","spans":[{"id":"spn-29042","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0001-multi-runtime.md"}],"text":"ADR-0001 — Multi-Runtime Strategy"}]}],"id":"blk-24376","kind":"list-item"},{"blocks":[{"id":"blk-24379","kind":"paragraph","spans":[{"id":"spn-29043","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0002-supabase-control-plane.md"}],"text":"ADR-0002 — Supabase as the Control Plane Backend"}]}],"id":"blk-24378","kind":"list-item"},{"blocks":[{"id":"blk-24381","kind":"paragraph","spans":[{"id":"spn-29044","marks":[{"kind":"link","predicate":"cit