{"bendscript":"0.1","blocks":[{"id":"blk-23787","kind":"heading","level":1,"spans":[{"id":"spn-27743","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-23789","kind":"paragraph","spans":[{"id":"spn-27744","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-23788","kind":"quote"},{"blocks":[{"id":"blk-23791","kind":"paragraph","spans":[{"id":"spn-27745","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-27746","text":" · "},{"id":"spn-27747","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-27748","text":" · "},{"id":"spn-27749","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-27750","text":" · "},{"id":"spn-27751","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-23790","kind":"quote"},{"id":"blk-23792","kind":"paragraph","spans":[{"id":"spn-27752","text":"Welcome to the documentation hub for "},{"id":"spn-27753","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-27754","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-23793","kind":"paragraph","spans":[{"id":"spn-27755","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-23794","items":[{"blocks":[{"id":"blk-23796","kind":"paragraph","spans":[{"id":"spn-27756","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-27757","text":" — create agents, deploy code bundles,"}]}],"id":"blk-23795","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23797","kind":"paragraph","spans":[{"id":"spn-27758","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-23798","items":[{"blocks":[{"id":"blk-23800","kind":"paragraph","spans":[{"id":"spn-27759","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-27760","text":" — validate "},{"id":"spn-27761","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-23799","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23801","kind":"paragraph","spans":[{"id":"spn-27762","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-23802","kind":"paragraph","spans":[{"id":"spn-27763","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-23803","kind":"paragraph","spans":[{"id":"spn-27764","text":"---"}]},{"id":"blk-23804","kind":"heading","level":2,"spans":[{"id":"spn-27765","text":"What you'll find here"}]},{"id":"blk-23805","items":[{"blocks":[{"id":"blk-23807","kind":"paragraph","spans":[{"id":"spn-27766","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-23806","kind":"list-item"},{"blocks":[{"id":"blk-23809","kind":"paragraph","spans":[{"id":"spn-27767","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-23808","kind":"list-item"},{"blocks":[{"id":"blk-23811","kind":"paragraph","spans":[{"id":"spn-27768","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-23810","kind":"list-item"},{"blocks":[{"id":"blk-23813","kind":"paragraph","spans":[{"id":"spn-27769","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-27770","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-23812","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23814","kind":"paragraph","spans":[{"id":"spn-27771","text":"---"}]},{"id":"blk-23815","kind":"heading","level":2,"spans":[{"id":"spn-27772","text":"Quick Links"}]},{"head":[{"id":"blk-23817","spans":[{"id":"spn-27773","text":"Document"}]},{"id":"blk-23818","spans":[{"id":"spn-27774","text":"Description"}]}],"id":"blk-23816","kind":"table","rows":[[{"id":"blk-23819","spans":[{"id":"spn-27775","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/quickstart.md"}],"text":"Quickstart"}]},{"id":"blk-23820","spans":[{"id":"spn-27776","text":"Local dev setup, first agent, verification"}]}],[{"id":"blk-23821","spans":[{"id":"spn-27777","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture"}]},{"id":"blk-23822","spans":[{"id":"spn-27778","text":"Control plane / data plane design, system diagram"}]}],[{"id":"blk-23823","spans":[{"id":"spn-27779","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"}]},{"id":"blk-23824","spans":[{"id":"spn-27780","text":"Operational skills index for agents and engineers"}]}]]},{"id":"blk-23825","kind":"paragraph","spans":[{"id":"spn-27781","text":"---"}]},{"id":"blk-23826","kind":"heading","level":2,"spans":[{"id":"spn-27782","text":"Documentation Map"}]},{"id":"blk-23827","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-23828","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-23829","kind":"code","language":"text","text":":maxdepth: 2\n:caption: WebHost.Systems Docs\n\nquickstart\narchitecture\nspec/00_MASTER_SPEC\nspec/README"},{"id":"blk-23830","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Skills\n\nskills/SKILLS\nskills/01_AGENT_MANAGEMENT\nskills/02_DEPLOYMENT_PIPELINE\nskills/03_INVOCATION_GATEWAY\nskills/04_RUNTIME_PROVIDERS\nskills/05_TELEMETRY_AND_METRICS\nskills/06_BILLING_AND_LIMITS\nskills/07_SECURITY_AND_SECRETS\nskills/08_AMPERSAND_INTEGRATION\nskills/09_ANTI_PATTERNS"},{"id":"blk-23831","kind":"paragraph","spans":[{"id":"spn-27783","text":"---"}]},{"id":"blk-23832","kind":"heading","level":2,"spans":[{"id":"spn-27784","text":"Suggested Reading Order"}]},{"id":"blk-23833","kind":"paragraph","spans":[{"id":"spn-27785","text":"If you're new to the project, follow this path:"}]},{"id":"blk-23834","kind":"paragraph","spans":[{"id":"spn-27786","text":"1. "},{"id":"spn-27787","marks":["bold"],"text":"quickstart"},{"id":"spn-27788","text":" — local dev setup, first agent creation, verification 2. "},{"id":"spn-27789","marks":["bold"],"text":"architecture"},{"id":"spn-27790","text":" — control plane / data plane design, request flows, data model 3. "},{"id":"spn-27791","marks":["bold"],"text":"skills/SKILLS"},{"id":"spn-27792","text":" — skills registry and tool inventory 4. "},{"id":"spn-27793","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-27794","text":" — agent CRUD, status lifecycle, provider config 5. "},{"id":"spn-27795","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-27796","text":" — bundle upload, validation, immutable deployments 6. "},{"id":"spn-27797","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-27798","text":" — request/response shapes, auth, streaming 7. "},{"id":"spn-27799","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-27800","text":" — RPI abstraction, Cloudflare and AgentCore adapters 8. "},{"id":"spn-27801","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-27802","text":" — metrics schema, aggregation 9. "},{"id":"spn-27803","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-27804","text":" — subscription tiers, enforcement, checkout 10. "},{"id":"spn-27805","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-27806","text":" — RLS isolation, Vault secrets, audit 11. "},{"id":"spn-27807","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-27808","text":" — [&] manifests, MCP sidecars, A2A routing 12. "},{"id":"spn-27809","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-27810","text":" — common mistakes and how to avoid them"}]},{"id":"blk-23835","kind":"paragraph","spans":[{"id":"spn-27811","text":"For "},{"id":"spn-27812","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-27813","text":", start at "},{"id":"spn-27814","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-27815","text":" and "},{"id":"spn-27816","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-27817","text":"."}]},{"id":"blk-23836","kind":"paragraph","spans":[{"id":"spn-27818","text":"For "},{"id":"spn-27819","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-27820","text":", start at "},{"id":"spn-27821","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-27822","text":" and the "},{"id":"spn-27823","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-27824","text":" spec."}]},{"id":"blk-23837","kind":"paragraph","spans":[{"id":"spn-27825","text":"---"}]},{"id":"blk-23838","kind":"heading","level":2,"spans":[{"id":"spn-27826","text":"Core Concepts"}]},{"id":"blk-23839","kind":"heading","level":3,"spans":[{"id":"spn-27827","text":"Control Plane"}]},{"id":"blk-23840","kind":"paragraph","spans":[{"id":"spn-27828","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-23841","kind":"heading","level":3,"spans":[{"id":"spn-27829","text":"Data Plane"}]},{"id":"blk-23842","kind":"paragraph","spans":[{"id":"spn-27830","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-23844","spans":[{"id":"spn-27831","text":"Runtime"}]},{"id":"blk-23845","spans":[{"id":"spn-27832","text":"Strengths"}]},{"id":"blk-23846","spans":[{"id":"spn-27833","text":"Best for"}]}],"id":"blk-23843","kind":"table","rows":[[{"id":"blk-23847","spans":[{"id":"spn-27834","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-23848","spans":[{"id":"spn-27835","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-23849","spans":[{"id":"spn-27836","text":"Most agents (default)"}]}],[{"id":"blk-23850","spans":[{"id":"spn-27837","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-23851","spans":[{"id":"spn-27838","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-23852","spans":[{"id":"spn-27839","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-23853","kind":"heading","level":3,"spans":[{"id":"spn-27840","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-23854","kind":"paragraph","spans":[{"id":"spn-27841","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-23855","kind":"heading","level":3,"spans":[{"id":"spn-27842","text":"Deployment Immutability"}]},{"id":"blk-23856","kind":"paragraph","spans":[{"id":"spn-27843","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-23857","kind":"heading","level":3,"spans":[{"id":"spn-27844","text":"Metered Telemetry"}]},{"id":"blk-23858","kind":"paragraph","spans":[{"id":"spn-27845","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-23859","kind":"paragraph","spans":[{"id":"spn-27846","text":"---"}]},{"id":"blk-23860","kind":"heading","level":2,"spans":[{"id":"spn-27847","text":"Core Idea"}]},{"id":"blk-23861","kind":"paragraph","spans":[{"id":"spn-27848","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-23863","kind":"paragraph","spans":[{"id":"spn-27849","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-23862","kind":"quote"},{"id":"blk-23864","kind":"paragraph","spans":[{"id":"spn-27850","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-27851","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-27852","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-23865","kind":"paragraph","spans":[{"id":"spn-27853","text":"---"}]},{"id":"blk-23866","kind":"heading","level":2,"spans":[{"id":"spn-27854","text":"Spec References"}]},{"id":"blk-23867","kind":"paragraph","spans":[{"id":"spn-27855","text":"The authoritative engineering spec lives in "},{"id":"spn-27856","marks":["code"],"text":"docs/spec/"},{"id":"spn-27857","text":":"}]},{"id":"blk-23868","items":[{"blocks":[{"id":"blk-23870","kind":"paragraph","spans":[{"id":"spn-27858","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-23869","kind":"list-item"},{"blocks":[{"id":"blk-23872","kind":"paragraph","spans":[{"id":"spn-27859","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-23871","kind":"list-item"},{"blocks":[{"id":"blk-23874","kind":"paragraph","spans":[{"id":"spn-27860","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-23873","kind":"list-item"},{"blocks":[{"id":"blk-23876","kind":"paragraph","spans":[{"id":"spn-27861","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"blk-23875","kind":"list-item"},{"blocks":[{"id":"blk-23878","kind":"paragraph","spans":[{"id":"spn-27862","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/30_DATA_MODEL_SUPABASE.md"}],"text":"30 — Data Model (Supabase/PostgreSQL) & Access Control"}]}],"id":"blk-23877","kind":"list-item"},{"blocks":[{"id":"blk-23880","kind":"paragraph","spans":[{"id":"spn-27863","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}],"text":"40 — Security, Secrets, and Compliance"}]}],"id":"blk-23879","kind":"list-item"},{"blocks":[{"id":"blk-23882","kind":"paragraph","spans":[{"id":"spn-27864","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}],"text":"50 — Observability, Metering, Cost, Tiers, and Limit Enforcement"}]}],"id":"blk-23881","kind":"list-item"},{"blocks":[{"id":"blk-23884","kind":"paragraph","spans":[{"id":"spn-27865","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}],"text":"60 — Testing Plan & Acceptance Criteria"}]}],"id":"blk-23883","kind":"list-item"},{"blocks":[{"id":"blk-23886","kind":"paragraph","spans":[{"id":"spn-27866","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/70_AMPERSAND_PROTOCOL_INTEGRATION.md"}],"text":"70 — Ampersand Protocol Integration"}]}],"id":"blk-23885","kind":"list-item"},{"blocks":[{"id":"blk-23888","kind":"paragraph","spans":[{"id":"spn-27867","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/REALIGNMENT_PLAN.md"}],"text":"Spec-to-Implementation Realignment Plan"}]}],"id":"blk-23887","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23889","kind":"heading","level":3,"spans":[{"id":"spn-27868","text":"Architecture decision records"}]},{"id":"blk-23890","items":[{"blocks":[{"id":"blk-23892","kind":"paragraph","spans":[{"id":"spn-27869","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0001-multi-runtime.md"}],"text":"ADR-0001 — Multi-Runtime Strategy"}]}],"id":"blk-23891","kind":"list-item"},{"blocks":[{"id":"blk-23894","kind":"paragraph","spans":[{"id":"spn-27870","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0002-supabase-control-plane.md"}],"text":"ADR-0002 — Supabase as the Control Plane Backend"}]}],"id":"blk-23893","kind":"list-item"},{"blocks":[{"id":"blk-23896","kind":"paragraph","spans":[{"id":"spn-27871","marks":[{"kind":"link","predicate":"cit