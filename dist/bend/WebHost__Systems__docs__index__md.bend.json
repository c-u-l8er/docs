{"bendscript":"0.1","blocks":[{"id":"blk-43408","kind":"heading","level":1,"spans":[{"id":"spn-72930","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-43410","kind":"paragraph","spans":[{"id":"spn-72931","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-43409","kind":"quote"},{"blocks":[{"id":"blk-43412","kind":"paragraph","spans":[{"id":"spn-72932","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-72933","text":" · "},{"id":"spn-72934","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-72935","text":" · "},{"id":"spn-72936","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-72937","text":" · "},{"id":"spn-72938","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-43411","kind":"quote"},{"id":"blk-43413","kind":"paragraph","spans":[{"id":"spn-72939","text":"Welcome to the documentation hub for "},{"id":"spn-72940","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-72941","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-43414","kind":"paragraph","spans":[{"id":"spn-72942","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-43415","items":[{"blocks":[{"id":"blk-43417","kind":"paragraph","spans":[{"id":"spn-72943","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-72944","text":" — create agents, deploy code bundles,"}]}],"id":"blk-43416","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43418","kind":"paragraph","spans":[{"id":"spn-72945","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-43419","items":[{"blocks":[{"id":"blk-43421","kind":"paragraph","spans":[{"id":"spn-72946","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-72947","text":" — validate "},{"id":"spn-72948","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-43420","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43422","kind":"paragraph","spans":[{"id":"spn-72949","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-43423","kind":"paragraph","spans":[{"id":"spn-72950","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-43424","kind":"heading","level":2,"spans":[{"id":"spn-72951","text":"What you'll find here"}]},{"id":"blk-43425","items":[{"blocks":[{"id":"blk-43427","kind":"paragraph","spans":[{"id":"spn-72952","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-43426","kind":"list-item"},{"blocks":[{"id":"blk-43429","kind":"paragraph","spans":[{"id":"spn-72953","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-43428","kind":"list-item"},{"blocks":[{"id":"blk-43431","kind":"paragraph","spans":[{"id":"spn-72954","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-43430","kind":"list-item"},{"blocks":[{"id":"blk-43433","kind":"paragraph","spans":[{"id":"spn-72955","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-72956","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-43432","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43434","kind":"heading","level":2,"spans":[{"id":"spn-72957","text":"Quick Links"}]},{"head":[{"id":"blk-43436","spans":[{"id":"spn-72958","text":"Document"}