{"bendscript":"0.1","blocks":[{"id":"blk-23677","kind":"heading","level":1,"spans":[{"id":"spn-27114","text":"WebHost.Systems Documentation"}]},{"blocks":[{"id":"blk-23679","kind":"paragraph","spans":[{"id":"spn-27115","marks":["bold"],"text":"Deploy AI agents to the edge or the cloud — one API, any runtime."}]}],"id":"blk-23678","kind":"quote"},{"blocks":[{"id":"blk-23681","kind":"paragraph","spans":[{"id":"spn-27116","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-27117","text":" · "},{"id":"spn-27118","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-27119","text":" · "},{"id":"spn-27120","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-27121","text":" · "},{"id":"spn-27122","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-23680","kind":"quote"},{"id":"blk-23682","kind":"paragraph","spans":[{"id":"spn-27123","text":"Welcome to the documentation hub for "},{"id":"spn-27124","marks":["bold"],"text":"WebHost.Systems"},{"id":"spn-27125","text":" — a multi-runtime AI agent deployment and hosting platform built on Supabase, Cloudflare Workers, and AWS Bedrock AgentCore."}]},{"id":"blk-23683","kind":"paragraph","spans":[{"id":"spn-27126","text":"WebHost.Systems serves two roles:"}]},{"id":"blk-23684","items":[{"blocks":[{"id":"blk-23686","kind":"paragraph","spans":[{"id":"spn-27127","marks":["bold"],"text":"Hosting platform for developers"},{"id":"spn-27128","text":" — create agents, deploy code bundles,"}]}],"id":"blk-23685","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23687","kind":"paragraph","spans":[{"id":"spn-27129","text":"manage secrets, view logs and metrics, and handle billing through a single dashboard and API."}]},{"id":"blk-23688","items":[{"blocks":[{"id":"blk-23690","kind":"paragraph","spans":[{"id":"spn-27130","marks":["bold"],"text":"Hosting layer for the [&] Protocol ecosystem"},{"id":"spn-27131","text":" — validate "},{"id":"spn-27132","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-23689","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23691","kind":"paragraph","spans":[{"id":"spn-27133","text":"manifests, orchestrate MCP sidecars (Graphonomous, TickTickClock, etc.), route agent-to-agent skills via A2A, and enforce Delegatic governance."}]},{"id":"blk-23692","kind":"paragraph","spans":[{"id":"spn-27134","text":"WebHost.Systems is a Node.js/TypeScript monorepo in the [&] Protocol ecosystem. Built entirely on Supabase + Vite/React + Cloudflare/AWS runtimes."}]},{"id":"blk-23693","kind":"paragraph","spans":[{"id":"spn-27135","text":"---"}]},{"id":"blk-23694","kind":"heading","level":2,"spans":[{"id":"spn-27136","text":"What you'll find here"}]},{"id":"blk-23695","items":[{"blocks":[{"id":"blk-23697","kind":"paragraph","spans":[{"id":"spn-27137","text":"A practical quickstart that gets a local dev environment running with Supabase, Vite, and Edge Functions"}]}],"id":"blk-23696","kind":"list-item"},{"blocks":[{"id":"blk-23699","kind":"paragraph","spans":[{"id":"spn-27138","text":"Architecture documentation covering the control plane / data plane split, RPI abstraction, and request flows"}]}],"id":"blk-23698","kind":"list-item"},{"blocks":[{"id":"blk-23701","kind":"paragraph","spans":[{"id":"spn-27139","text":"Skills guides for every operational surface — agent management, deployment, invocation, billing, security, and [&] Protocol integration"}]}],"id":"blk-23700","kind":"list-item"},{"blocks":[{"id":"blk-23703","kind":"paragraph","spans":[{"id":"spn-27140","text":"Spec references pointing to the authoritative engineering spec in "},{"id":"spn-27141","marks":["code"],"text":"docs/spec/"}]}],"id":"blk-23702","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23704","kind":"paragraph","spans":[{"id":"spn-27142","text":"---"}]},{"id":"blk-23705","kind":"heading","level":2,"spans":[{"id":"spn-27143","text":"Quick Links"}]},{"head":[{"id":"blk-23707","spans":[{"id":"spn-27144","text":"Document"}]},{"id":"blk-23708","spans":[{"id":"spn-27145","text":"Description"}]}],"id":"blk-23706","kind":"table","rows":[[{"id":"blk-23709","spans":[{"id":"spn-27146","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/quickstart.md"}],"text":"Quickstart"}]},{"id":"blk-23710","spans":[{"id":"spn-27147","text":"Local dev setup, first agent, verification"}]}],[{"id":"blk-23711","spans":[{"id":"spn-27148","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/architecture.md"}],"text":"Architecture"}]},{"id":"blk-23712","spans":[{"id":"spn-27149","text":"Control plane / data plane design, system diagram"}]}],[{"id":"blk-23713","spans":[{"id":"spn-27150","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"}]},{"id":"blk-23714","spans":[{"id":"spn-27151","text":"Operational skills index for agents and engineers"}]}]]},{"id":"blk-23715","kind":"paragraph","spans":[{"id":"spn-27152","text":"---"}]},{"id":"blk-23716","kind":"heading","level":2,"spans":[{"id":"spn-27153","text":"Documentation Map"}]},{"id":"blk-23717","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-23718","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-23719","kind":"code","language":"text","text":":maxdepth: 2\n:caption: WebHost.Systems Docs\n\nquickstart\narchitecture\nspec/00_MASTER_SPEC\nspec/README"},{"id":"blk-23720","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Skills\n\nskills/SKILLS\nskills/01_AGENT_MANAGEMENT\nskills/02_DEPLOYMENT_PIPELINE\nskills/03_INVOCATION_GATEWAY\nskills/04_RUNTIME_PROVIDERS\nskills/05_TELEMETRY_AND_METRICS\nskills/06_BILLING_AND_LIMITS\nskills/07_SECURITY_AND_SECRETS\nskills/08_AMPERSAND_INTEGRATION\nskills/09_ANTI_PATTERNS"},{"id":"blk-23721","kind":"paragraph","spans":[{"id":"spn-27154","text":"---"}]},{"id":"blk-23722","kind":"heading","level":2,"spans":[{"id":"spn-27155","text":"Suggested Reading Order"}]},{"id":"blk-23723","kind":"paragraph","spans":[{"id":"spn-27156","text":"If you're new to the project, follow this path:"}]},{"id":"blk-23724","kind":"paragraph","spans":[{"id":"spn-27157","text":"1. "},{"id":"spn-27158","marks":["bold"],"text":"quickstart"},{"id":"spn-27159","text":" — local dev setup, first agent creation, verification 2. "},{"id":"spn-27160","marks":["bold"],"text":"architecture"},{"id":"spn-27161","text":" — control plane / data plane design, request flows, data model 3. "},{"id":"spn-27162","marks":["bold"],"text":"skills/SKILLS"},{"id":"spn-27163","text":" — skills registry and tool inventory 4. "},{"id":"spn-27164","marks":["bold"],"text":"skills/01_AGENT_MANAGEMENT"},{"id":"spn-27165","text":" — agent CRUD, status lifecycle, provider config 5. "},{"id":"spn-27166","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-27167","text":" — bundle upload, validation, immutable deployments 6. "},{"id":"spn-27168","marks":["bold"],"text":"skills/03_INVOCATION_GATEWAY"},{"id":"spn-27169","text":" — request/response shapes, auth, streaming 7. "},{"id":"spn-27170","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-27171","text":" — RPI abstraction, Cloudflare and AgentCore adapters 8. "},{"id":"spn-27172","marks":["bold"],"text":"skills/05_TELEMETRY_AND_METRICS"},{"id":"spn-27173","text":" — metrics schema, aggregation 9. "},{"id":"spn-27174","marks":["bold"],"text":"skills/06_BILLING_AND_LIMITS"},{"id":"spn-27175","text":" — subscription tiers, enforcement, checkout 10. "},{"id":"spn-27176","marks":["bold"],"text":"skills/07_SECURITY_AND_SECRETS"},{"id":"spn-27177","text":" — RLS isolation, Vault secrets, audit 11. "},{"id":"spn-27178","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-27179","text":" — [&] manifests, MCP sidecars, A2A routing 12. "},{"id":"spn-27180","marks":["bold"],"text":"skills/09_ANTI_PATTERNS"},{"id":"spn-27181","text":" — common mistakes and how to avoid them"}]},{"id":"blk-23725","kind":"paragraph","spans":[{"id":"spn-27182","text":"For "},{"id":"spn-27183","marks":["bold"],"text":"operations and DevOps"},{"id":"spn-27184","text":", start at "},{"id":"spn-27185","marks":["bold"],"text":"skills/02_DEPLOYMENT_PIPELINE"},{"id":"spn-27186","text":" and "},{"id":"spn-27187","marks":["bold"],"text":"skills/04_RUNTIME_PROVIDERS"},{"id":"spn-27188","text":"."}]},{"id":"blk-23726","kind":"paragraph","spans":[{"id":"spn-27189","text":"For "},{"id":"spn-27190","marks":["bold"],"text":"[&] Protocol integration"},{"id":"spn-27191","text":", start at "},{"id":"spn-27192","marks":["bold"],"text":"skills/08_AMPERSAND_INTEGRATION"},{"id":"spn-27193","text":" and the "},{"id":"spn-27194","marks":["code"],"text":"70_AMPERSAND_PROTOCOL_INTEGRATION.md"},{"id":"spn-27195","text":" spec."}]},{"id":"blk-23727","kind":"paragraph","spans":[{"id":"spn-27196","text":"---"}]},{"id":"blk-23728","kind":"heading","level":2,"spans":[{"id":"spn-27197","text":"Core Concepts"}]},{"id":"blk-23729","kind":"heading","level":3,"spans":[{"id":"spn-27198","text":"Control Plane"}]},{"id":"blk-23730","kind":"paragraph","spans":[{"id":"spn-27199","text":"The Supabase-backed layer that manages all platform state — agents, deployments, secrets, billing, and telemetry. Built on PostgreSQL with RLS for per-tenant isolation, Edge Functions for server-only logic, and Vault for encrypted secret storage."}]},{"id":"blk-23731","kind":"heading","level":3,"spans":[{"id":"spn-27200","text":"Data Plane"}]},{"id":"blk-23732","kind":"paragraph","spans":[{"id":"spn-27201","text":"Where agent code actually runs. WebHost supports two runtime providers behind a single abstraction:"}]},{"head":[{"id":"blk-23734","spans":[{"id":"spn-27202","text":"Runtime"}]},{"id":"blk-23735","spans":[{"id":"spn-27203","text":"Strengths"}]},{"id":"blk-23736","spans":[{"id":"spn-27204","text":"Best for"}]}],"id":"blk-23733","kind":"table","rows":[[{"id":"blk-23737","spans":[{"id":"spn-27205","marks":["bold"],"text":"Cloudflare Workers + DO"}]},{"id":"blk-23738","spans":[{"id":"spn-27206","text":"Global edge, strong economics, instant cold starts"}]},{"id":"blk-23739","spans":[{"id":"spn-27207","text":"Most agents (default)"}]}],[{"id":"blk-23740","spans":[{"id":"spn-27208","marks":["bold"],"text":"AWS Bedrock AgentCore"}]},{"id":"blk-23741","spans":[{"id":"spn-27209","text":"Long-running sessions, enterprise isolation, built-in tools"}]},{"id":"blk-23742","spans":[{"id":"spn-27210","text":"Premium/enterprise workloads"}]}]]},{"id":"blk-23743","kind":"heading","level":3,"spans":[{"id":"spn-27211","text":"Runtime Provider Interface (RPI)"}]},{"id":"blk-23744","kind":"paragraph","spans":[{"id":"spn-27212","text":"The abstraction layer that makes runtime portability possible. The RPI defines a consistent contract for deployment, invocation, session management, and telemetry across all providers. Deploy once, run anywhere."}]},{"id":"blk-23745","kind":"heading","level":3,"spans":[{"id":"spn-27213","text":"Deployment Immutability"}]},{"id":"blk-23746","kind":"paragraph","spans":[{"id":"spn-27214","text":"Deployments are append-only records. You never mutate a deployment — you create a new one. Rollback works by changing the active pointer, not by reverting code. This gives you a full audit trail and instant rollback."}]},{"id":"blk-23747","kind":"heading","level":3,"spans":[{"id":"spn-27215","text":"Metered Telemetry"}]},{"id":"blk-23748","kind":"paragraph","spans":[{"id":"spn-27216","text":"Every invocation emits authenticated metrics — requests, tokens, compute milliseconds, errors. Telemetry feeds both the dashboard and the billing engine, so usage tracking and limit enforcement are built in, not bolted on."}]},{"id":"blk-23749","kind":"paragraph","spans":[{"id":"spn-27217","text":"---"}]},{"id":"blk-23750","kind":"heading","level":2,"spans":[{"id":"spn-27218","text":"Core Idea"}]},{"id":"blk-23751","kind":"paragraph","spans":[{"id":"spn-27219","text":"A concise framing for the platform:"}]},{"blocks":[{"id":"blk-23753","kind":"paragraph","spans":[{"id":"spn-27220","text":"Supabase manages the control plane. Cloudflare and AgentCore run the data plane. The RPI makes them interchangeable."}]}],"id":"blk-23752","kind":"quote"},{"id":"blk-23754","kind":"paragraph","spans":[{"id":"spn-27221","text":"The goal is not to build another LLM provider, but to provide a "},{"id":"spn-27222","marks":["bold"],"text":"runtime-portable hosting layer"},{"id":"spn-27223","text":" where AI agents deploy, scale, and meter under a single API — regardless of which cloud actually executes the code."}]},{"id":"blk-23755","kind":"paragraph","spans":[{"id":"spn-27224","text":"---"}]},{"id":"blk-23756","kind":"heading","level":2,"spans":[{"id":"spn-27225","text":"Spec References"}]},{"id":"blk-23757","kind":"paragraph","spans":[{"id":"spn-27226","text":"The authoritative engineering spec lives in "},{"id":"spn-27227","marks":["code"],"text":"docs/spec/"},{"id":"spn-27228","text":":"}]},{"id":"blk-23758","items":[{"blocks":[{"id":"blk-23760","kind":"paragraph","spans":[{"id":"spn-27229","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/README.md"}],"text":"Spec index — Implementation-Ready Document Set"}]}],"id":"blk-23759","kind":"list-item"},{"blocks":[{"id":"blk-23762","kind":"paragraph","spans":[{"id":"spn-27230","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}],"text":"00 — Master Spec"}]}],"id":"blk-23761","kind":"list-item"},{"blocks":[{"id":"blk-23764","kind":"paragraph","spans":[{"id":"spn-27231","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}],"text":"10 — API Contracts"}]}],"id":"blk-23763","kind":"list-item"},{"blocks":[{"id":"blk-23766","kind":"paragraph","spans":[{"id":"spn-27232","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}],"text":"20 — Runtime Provider Interface"}]}],"id":"blk-23765","kind":"list-item"},{"blocks":[{"id":"blk-23768","kind":"paragraph","spans":[{"id":"spn-27233","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/30_DATA_MODEL_SUPABASE.md"}],"text":"30 — Data Model (Supabase/PostgreSQL) & Access Control"}]}],"id":"blk-23767","kind":"list-item"},{"blocks":[{"id":"blk-23770","kind":"paragraph","spans":[{"id":"spn-27234","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}],"text":"40 — Security, Secrets, and Compliance"}]}],"id":"blk-23769","kind":"list-item"},{"blocks":[{"id":"blk-23772","kind":"paragraph","spans":[{"id":"spn-27235","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}],"text":"50 — Observability, Metering, Cost, Tiers, and Limit Enforcement"}]}],"id":"blk-23771","kind":"list-item"},{"blocks":[{"id":"blk-23774","kind":"paragraph","spans":[{"id":"spn-27236","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/60_TESTING_ACCEPTANCE.md"}],"text":"60 — Testing Plan & Acceptance Criteria"}]}],"id":"blk-23773","kind":"list-item"},{"blocks":[{"id":"blk-23776","kind":"paragraph","spans":[{"id":"spn-27237","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/70_AMPERSAND_PROTOCOL_INTEGRATION.md"}],"text":"70 — Ampersand Protocol Integration"}]}],"id":"blk-23775","kind":"list-item"},{"blocks":[{"id":"blk-23778","kind":"paragraph","spans":[{"id":"spn-27238","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/REALIGNMENT_PLAN.md"}],"text":"Spec-to-Implementation Realignment Plan"}]}],"id":"blk-23777","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23779","kind":"heading","level":3,"spans":[{"id":"spn-27239","text":"Architecture decision records"}]},{"id":"blk-23780","items":[{"blocks":[{"id":"blk-23782","kind":"paragraph","spans":[{"id":"spn-27240","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0001-multi-runtime.md"}],"text":"ADR-0001 — Multi-Runtime Strategy"}]}],"id":"blk-23781","kind":"list-item"},{"blocks":[{"id":"blk-23784","kind":"paragraph","spans":[{"id":"spn-27241","marks":[{"kind":"link","predicate":"cites","target":"#/WebHost.Systems/docs/spec/adr/ADR-0002-supabase-control-plane.md"}],"text":"ADR-0002 — Supabase as the Control Plane Backend"}]}],"id":"blk-23783","kind":"list-item"},{"blocks":[{"id":"blk-23786","kind":"paragraph","spans":[{"id":"spn-27242","marks":[{"kind":"link","predicate":"cit