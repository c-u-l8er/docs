:"spn-200714","text":"before"}]},{"id":"blk-122836","spans":[{"id":"spn-200715","text":"after"}]}],"id":"blk-122833","kind":"table","rows":[[{"id":"blk-122837","spans":[{"id":"spn-200716","text":"Pages discovered"}]},{"id":"blk-122838","spans":[{"id":"spn-200717","text":"1"}]},{"id":"blk-122839","spans":[{"id":"spn-200718","marks":["bold"],"text":"7"}]}],[{"id":"blk-122840","spans":[{"id":"spn-200719","text":"Total extractable words"}]},{"id":"blk-122841","spans":[{"id":"spn-200720","marks":["bold"],"text":"0"}]},{"id":"blk-122842","spans":[{"id":"spn-200721","marks":["bold"],"text":"1,486"}]}],[{"id":"blk-122843","spans":[{"id":"spn-200722","text":"Claims"}]},{"id":"blk-122844","spans":[{"id":"spn-200723","marks":["bold"],"text":"0"}]},{"id":"blk-122845","spans":[{"id":"spn-200724","text":"real claims across all types"}]}],[{"id":"blk-122846","spans":[{"id":"spn-200725","text":"SPA pages (need JS)"}]},{"id":"blk-122847","spans":[{"id":"spn-200726","text":"1 / 1"}]},{"id":"blk-122848","spans":[{"id":"spn-200727","marks":["bold"],"text":"0"}]}],[{"id":"blk-122849","spans":[{"id":"spn-200728","text":"Pages without schema"}]},{"id":"blk-122850","spans":[{"id":"spn-200729","text":"1 / 1"}]},{"id":"blk-122851","spans":[{"id":"spn-200730","marks":["bold"],"text":"0 / 7"}]}],[{"id":"blk-122852","spans":[{"id":"spn-200731","text":"Page forms mintable"}]},{"id":"blk-122853","spans":[{"id":"spn-200732","text":"0"}]},{"id":"blk-122854","spans":[{"id":"spn-200733","marks":["bold"],"text":"1"},{"id":"spn-200734","text":" — Glossary, 5/3 definition claims"}]}]]},{"id":"blk-122855","kind":"paragraph","spans":[{"id":"spn-200735","text":"Still refused, and correctly: Statistics 1/5 "},{"id":"spn-200736","marks":["code"],"text":"quantity"},{"id":"spn-200737","text":" · FAQ 0/5 "},{"id":"spn-200738","marks":["code"],"text":"question"},{"id":"spn-200739","text":" · Comparison 4/6 · How-it-works 0/1 "},{"id":"spn-200740","marks":["code"],"text":"process"},{"id":"spn-200741","text":" · Entity 0/3 "},{"id":"spn-200742","marks":["code"],"text":"credential"},{"id":"spn-200743","text":"."}]},{"id":"blk-122856","kind":"paragraph","spans":[{"id":"spn-200744","marks":["bold"],"text":"Readable is not the same as sufficient."},{"id":"spn-200745","text":" The surface went from invisible to crawlable, and the refusal rule still declines to mint five of six forms because the material genuinely is not there. Phase 6 is what supplies the missing "},{"id":"spn-200746","marks":["code"],"text":"quantity"},{"id":"spn-200747","text":" claims — bundle counts and gate pass-rates, each resolving to a recomputable "},{"id":"spn-200748","marks":["code"],"text":"content_hash"},{"id":"spn-200749","text":"."}]},{"id":"blk-122857","kind":"paragraph","spans":[{"id":"spn-200750","marks":["bold"],"text":"Deploys take ~75 s"},{"id":"spn-200751","text":" from "},{"id":"spn-200752","marks":["code"],"text":"git push"},{"id":"spn-200753","text":" to live. Verified twice this session."}]},{"id":"blk-122858","kind":"heading","level":3,"spans":[{"id":"spn-200754","text":"Phase 2 — "},{"id":"spn-200755","marks":["code"],"text":"workbench watch"}]},{"id":"blk-122859","kind":"paragraph","spans":[{"id":"spn-200756","text":"Local daemon over "},{"id":"spn-200757","marks":["code"],"text":"~/.claude/projects"},{"id":"spn-200758","text":". Incremental (mtime + size + tail offset). Writes to a local library. No network. Kills the one-file-at-a-time ceiling."}]},{"id":"blk-122860","kind":"paragraph","spans":[{"id":"spn-200759","marks":["bold"],"text":"Gate:"},{"id":"spn-200760","text":" cold pass over 556 sessions produces N bundles unattended; a new session appended to while running is picked up without a restart; nothing leaves the machine."}]},{"id":"blk-122861","kind":"heading","level":3,"spans":[{"id":"spn-200761","text":"Phase 3 — "},{"id":"spn-200762","marks":["code"],"text":"workbench stats"}]},{"id":"blk-122862","kind":"paragraph","spans":[{"id":"spn-200763","text":"Aggregate over the local library. This is the honest first version of \"learning\" — statistics, not ML. Which tool sequences recur, which capability sets cluster, which segments fail which gates, how patterns moved over time."}]},{"id":"blk-122863","kind":"paragraph","spans":[{"id":"spn-200764","marks":["bold"],"text":"Gate:"},{"id":"spn-200765","text":" a report a person who is not the author can read and act on."}]},{"id":"blk-122864","kind":"heading","level":3,"spans":[{"id":"spn-200766","text":"Phase 4 — close the PULSE circuit"}]},{"id":"blk-122865","kind":"paragraph","spans":[{"id":"spn-200767","text":"Two files that the spec quotes but that "},{"id":"spn-200768","marks":["bold"],"text":"do not exist"},{"id":"spn-200769","text":": "},{"id":"spn-200770","marks":["code"],"text":"workbench/pulse-manifest.v0.1.json"},{"id":"spn-200771","text":" and "},{"id":"spn-200772","marks":["code"],"text":"workbench/workbench.ampersand.json"},{"id":"spn-200773","text":". The spec'd manifest declares "},{"id":"spn-200774","marks":["code"],"text":"\"consumes\": []"},{"id":"spn-200775","text":" — Workbench emits five token types and consumes nothing, which is exactly why nothing comes back."}]},{"id":"blk-122866","kind":"code","language":"text","text":"workbench ──ConsolidationEvent──▶ graphonomous.act/learn/consolidate\ngraphonomous.learn ──OutcomeSignal──▶ prism.observe          (already declared)\nprism.diagnose ──ReputationUpdate──▶ workbench.retrieve      (THE MISSING EDGE)"},{"id":"blk-122867","kind":"paragraph","spans":[{"id":"spn-200776","marks":["bold"],"text":"Gate:"},{"id":"spn-200777","text":" the manifest validates against "},{"id":"spn-200778","marks":["code"],"text":"PULSE/schemas/pulse-loop-manifest.v0.1.json"},{"id":"spn-200779","text":", lands in "},{"id":"spn-200780","marks":["code"],"text":"PULSE/manifests/"},{"id":"spn-200781","text":", and "},{"id":"spn-200782","marks":["code"],"text":"consumes"},{"id":"spn-200783","text":" is non-empty."}]},{"id":"blk-122868","kind":"paragraph","spans":[{"id":"spn-200784","marks":["bold"],"text":"Constraint that must not be violated:"},{"id":"spn-200785","text":" "},{"id":"spn-200786","marks":["code"],"text":"ReputationUpdate"},{"id":"spn-200787","text":" may rank retrieval. It must "},{"id":"spn-200788","marks":["bold"],"text":"never"},{"id":"spn-200789","text":" influence a gate verdict. "},{"id":"spn-200790","marks":["code"],"text":"verifyBundle"},{"id":"spn-200791","text":" is pure and offline and that is most of why it is trustworthy; a scorer contaminated by its own downstream scores is not a scorer."}]},{"id":"blk-122869","kind":"heading","level":3,"spans":[{"id":"spn-200792","text":"Phase 5 — real secret scanning"}]},{"id":"blk-122870","kind":"paragraph","spans":[{"id":"spn-200793","text":"Publication is gated on this, not the other way around. The current redactor is two regexes ("},{"id":"spn-200794","marks":["code"],"text":"sk-…"},{"id":"spn-200795","text":", email). A controlled study puts Gitleaks at 88% recall with hundreds of rules and entropy as a secondary signal, TruffleHog at 52%. Shell out; do not grow the regex list."}]},{"id":"blk-122871","kind":"paragraph","spans":[{"id":"spn-200796","marks":["bold"],"text":"Gate:"},{"id":"spn-200797","text":" a corpus pass reports a scan rate per rule class, and "},{"id":"spn-200798","marks":["code"],"text":"full"},{"id":"spn-200799","text":" profile output survives an independent scanner with zero findings."}]},{"id":"blk-122872","kind":"heading","level":3,"spans":[{"id":"spn-200800","text":"Phase 6 — publish the aggregate"}]},{"id":"blk-122873","kind":"paragraph","spans":[{"id":"spn-200801","text":"Bundle counts and gate pass-rates are "},{"id":"spn-200802","marks":["code"],"text":"quantity"},{"id":"spn-200803","text":" claims with units — the type alkeyword's spec calls \"the strongest measured citation lever,\" and the type its G5 matrix is starved of (Statistics 7/20, FAQ 0/20, How-it-works 0/20)."}]},{"id":"blk-122874","kind":"paragraph","spans":[{"id":"spn-200804","marks":["bold"],"text":"Every published quantity must resolve to a `content_hash` a reader can recompute."},{"id":"spn-200805","text":" See §5."}]},{"id":"blk-122875","kind":"heading","level":3,"spans":[{"id":"spn-200806","text":"Phase 7 — score the public commons (optional, high leverage)"}]},{"id":"blk-122876","kind":"paragraph","spans":[{"id":"spn-200807","marks":[{"kind":"link","predicate":"cites","target":"https://trace-commons-web.hf.space/"}],"text":"Trace Commons"},{"id":"spn-200808","text":" and "},{"id":"spn-200809","marks":[{"kind":"link","predicate":"cites","target":"https://tracelab.cs.washington.edu/"}],"text":"TraceLab"},{"id":"spn-200810","text":" host public, contributor-reviewed agent traces. Scoring "},{"id":"spn-200811","marks":["italic"],"text":"those"},{"id":"spn-200812","text":" yields cross-developer aggregate data while publishing nothing of ours. Nobody else scores traces against a stated algebra."}]},{"id":"blk-122877","kind":"heading","level":2,"spans":[{"id":"spn-200813","text":"4. Decided"}]},{"head":[{"id":"blk-122879","spans":[{"id":"spn-200814","text":"Decision"}]},{"id":"blk-122880","spans":[{"id":"spn-200815","text":"Choice"}]}],"id":"blk-122878","kind":"table","rows":[[{"id":"blk-122881","spans":[{"id":"spn-200816","text":"Skill unit"}]},{"id":"blk-122882","spans":[{"id":"spn-200817","text":"one "},{"id":"spn-200818","marks":["code"],"text":"user_message"},{"id":"spn-200819","text":" + its tool loop"}]}],[{"id":"blk-122883","spans":[{"id":"spn-200820","text":"Parser purity"}]},{"id":"blk-122884","spans":[{"id":"spn-200821","text":"no "},{"id":"spn-200822","marks":["code"],"text":"fs"},{"id":"spn-200823","text":"/DOM in "},{"id":"spn-200824","marks":["code"],"text":"lib/ingest/claude_code.ts"},{"id":"spn-200825","text":" — browser and CLI share it"}]}],[{"id":"blk-122885","spans":[{"id":"spn-200826","text":"Real transcripts"}]},{"id":"blk-122886","spans":[{"id":"spn-200827","text":"read from disk, never committed; fixtures are synthetic"}]}],[{"id":"blk-122887","spans":[{"id":"spn-200828","marks":["code"],"text":"thinking"},{"id":"spn-200829","text":" blocks / sidechains"}]},{"id":"blk-122888","spans":[{"id":"spn-200830","text":"excluded, "},{"id":"spn-200831","marks":["bold"],"text":"counted"}]}],[{"id":"blk-122889","spans":[{"id":"spn-200832","text":"Unmapped tools"}]},{"id":"blk-122890","spans":[{"id":"spn-200833","marks":["code"],"text":"&host.unknown_<name>"},{"id":"spn-200834","text":", never "},{"id":"spn-200835","marks":["code"],"text":"ambient"}]}],[{"id":"blk-122891","spans":[{"id":"spn-200836","text":"Learning, v1"}]},{"id":"blk-122892","spans":[{"id":"spn-200837","text":"statistics over the local corpus, not skill distillation"}]}],[{"id":"blk-122893","spans":[{"id":"spn-200838","text":"Aggregation"}]},{"id":"blk-122894","spans":[{"id":"spn-200839","text":"local-first; hosted multi-user is Phase 6+, after B1"}]}]]},{"id":"blk-122895","kind":"heading","level":2,"spans":[{"id":"spn-200840","text":"5. The failure mode this project must not commit"}]},{"id":"blk-122896","kind":"paragraph","spans":[{"id":"spn-200841","marks":["code"],"text":"ACADEMY.md"},{"id":"spn-200842","text":" §6e: "},{"id":"spn-200843","marks":["italic"],"text":"absence of evidence must remain distinguishable from evidence of absence, and every consequential transformation must expose why it occurred."}]},{"id":"blk-122897","kind":"paragraph","spans":[{"id":"spn-200844","text":"Two recorded violations, both by tools whose job was to enforce it:"}]},{"id":"blk-122898","items":[{"blocks":[{"id":"blk-122900","kind":"paragraph","spans":[{"id":"spn-200845","text":"alkeyword v0.5.0 filed a portfolio work item asserting three docs hosts had no canonical. It"}]}],"id":"blk-122899","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-122901","kind":"paragraph","spans":[{"id":"spn-200846","text":"never parsed "},{"id":"spn-200847","marks":["code"],"text":"<link rel=\"canonical\">"},{"id":"spn-200848","text":" and asserted absence anyway. Retracted by name."}]},{"id":"blk-122902","items":[{"blocks":[{"id":"blk-122904","kind":"paragraph","spans":[{"id":"spn-200849","text":"A 2026-08-11 session declared the Cloudflare build broken by grepping HTML for copy that HTML"}]}],"id":"blk-122903","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-122905","kind":"paragraph","spans":[{"id":"spn-200850","text":"never contains. Corrected in §2(b)."}]},{"id":"blk-122906","kind":"paragraph","spans":[{"id":"spn-200851","text":"Same shape both times: "},{"id":"spn-200852","marks":["bold"],"text":"measuring a proxy and reporting it as the thing."},{"id":"spn-200853","text":" Piping auto-generated Workbench numbers into alkeyword scales this risk — a wrong gate verdict becomes a published statistic wearing a provenance link. Hence the Phase 6 rule."}]},{"id":"blk-122907","kind":"heading","level":2,"spans":[{"id":"spn-200854","text":"6. Open — needs a decision, do not guess"}]},{"id":"blk-122908","items":[{"blocks":[{"id":"blk-122910","kind":"paragraph","spans":[{"id":"spn-200855","marks":["bold"],"text":"Local library store:"},{"id":"spn-200856","text":" its own SQLite/JSON, or Graphonomous nodes? Repo policy says use the"}]}],"id":"blk-122909","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-122911","kind":"paragraph","spans":[{"id":"spn-200857","text":"graph; a local-only daemon says otherwise. Unresolved."}]},{"id":"blk-122912","items":[{"blocks":[{"id":"blk-122914","kind":"paragraph","spans":[{"id":"spn-200858","marks":["bold"],"text":"B1 has never been run."},{"id":"spn-200859","text":" "},{"id":"spn-200860","marks":["code"],"text":"ACADEMY.md"},{"id":"spn-200861","text":" §6 marks it runnable today: one outsider, one real task,"}]}],"id":"blk-122913","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-122915","kind":"paragraph","spans":[{"id":"spn-200862","text":"recorded either way. Phases 6–7 build a multi-user surface ahead of it. That is the documented risk, accepted knowingly or not at all."}]},{"id":"blk-122916","kind":"heading","level":2,"spans":[{"id":"spn-200863","text":"7. Reproduce"}]},{"id":"blk-122917","kind":"code","language":"bash","text":"cd workbench/app && npm test"},{"id":"blk-122918","kind":"code","language":"bash","text":"cd workbench/app && ./node_modules/.bin/vite-node tools/ingest-transcript.ts ~/.claude/projects/<project>/<session>.jsonl"},{"id":"blk-122919","kind":"code","language":"bash","text":"cd alkeyword.com/prototype && python3 crawl.py workbench.opensentience.org"}],"edges":[],"id":"bagaaieranehmsv3r2bg5fcgfyouotct6iqqnmdyxkdua4uh5poyqz7fjqtla","vocabulary":"ampersand.docs.fs.v1"}