e"}]}],[{"id":"blk-95161","spans":[{"id":"spn-159049","marks":[{"kind":"link","predicate":"cites","target":"../specprompt.com/"}],"text":"SpecPrompt"}]},{"id":"blk-95162","spans":[{"id":"spn-159050","text":"OS-008 quality gates"}]},{"id":"blk-95163","spans":[{"id":"spn-159051","text":"Acceptance criteria for harness evaluation"}]}],[{"id":"blk-95164","spans":[{"id":"spn-159052","marks":[{"kind":"link","predicate":"cites","target":"../PRISM/"}],"text":"PRISM"}]},{"id":"blk-95165","spans":[{"id":"spn-159053","text":"OS-009"}]},{"id":"blk-95166","spans":[{"id":"spn-159054","text":"Diagnostic benchmark engine (Elixir/OTP, Fly.io, 6 machines)"}]}],[{"id":"blk-95167","spans":[{"id":"spn-159055","marks":[{"kind":"link","predicate":"cites","target":"../PULSE/"}],"text":"PULSE"}]},{"id":"blk-95168","spans":[{"id":"spn-159056","text":"OS-010"}]},{"id":"blk-95169","spans":[{"id":"spn-159057","text":"Loop manifest standard (JSON Schema, npm package)"}]}]]},{"id":"blk-95170","kind":"paragraph","spans":[{"id":"spn-159058","marks":["bold"],"text":"Does not use Supabase."},{"id":"spn-159059","text":" The governance shim uses ETS (dev/edge) or pluggable backends. PRISM uses SQLite. PULSE uses embedded SQLite + sqlite-vec."}]},{"id":"blk-95171","kind":"heading","level":2,"spans":[{"id":"spn-159060","text":"Documentation"}]},{"id":"blk-95172","kind":"paragraph","spans":[{"id":"spn-159061","text":"Documentation is built with Sphinx + MyST and configured for ReadTheDocs:"}]},{"id":"blk-95173","kind":"code","language":"bash","text":"# Build locally\ncd docs\npip install -r requirements.txt\nsphinx-build -b html . _build/html"},{"id":"blk-95174","kind":"heading","level":3,"spans":[{"id":"spn-159062","text":"Key documents"}]},{"id":"blk-95175","items":[{"blocks":[{"id":"blk-95177","kind":"paragraph","spans":[{"id":"spn-159063","marks":["bold"],"text":"[Master Spec](docs/spec/README.md)"},{"id":"spn-159064","text":" — All 10 protocols, architecture, implementation roadmap"}]}],"id":"blk-951