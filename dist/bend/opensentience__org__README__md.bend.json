Agent interface guide\n├── .readthedocs.yaml                       # ReadTheDocs build config\n└── old_scrap/                              # Historical v1/v2 iterations (not current)"},{"id":"blk-95107","kind":"heading","level":2,"spans":[{"id":"spn-158989","text":"Technology Stack"}]},{"head":[{"id":"blk-95109","spans":[{"id":"spn-158990","text":"Layer"}]},{"id":"blk-95110","spans":[{"id":"spn-158991","text":"Technology"}]},{"id":"blk-95111","spans":[{"id":"spn-158992","text":"Rationale"}]}],"id":"blk-95108","kind":"table","rows":[[{"id":"blk-95112","spans":[{"id":"spn-158993","text":"Language"}]},{"id":"blk-95113","spans":[{"id":"spn-158994","text":"Elixir 1.17+ / OTP 27"}]},{"id":"blk-95114","spans":[{"id":"spn-158995","text":"GenStateMachine for lifecycle, ETS for microsecond policy lookups"}]}],[{"id":"blk-95115","spans":[{"id":"spn-158996","text":"Distribution"}]},{"id":"blk-95116","spans":[{"id":"spn-158997","text":"Hex package ("},{"id":"spn-158998","marks":["code"],"text":"open_sentience"},{"id":"spn-158999","text":")"}]},{"id":"blk-95117","spans":[{"id":"spn-159000","text":"Dependency, not daemon — add to "},{"id":"spn-159001","marks":["code"],"text":"mix.exs"}]}],[{"id":"blk-95118","spans":[{"id":"spn-159002","text":"MCP Server"}]},{"id":"blk-95119","spans":[{"id":"spn-159003","marks":["code"],"text":"hermes_mcp"},{"id":"spn-159004","text":" (v0.8+)"}]},{"id":"blk-95120","spans":[{"id":"spn-159005","text":"Governance tools exposed as MCP tools"}]}],[{"id":"blk-95121","spans":[{"id":"spn-159006","text":"State Machine"}]},{"id":"blk-95122","spans":[{"id":"spn-159007","marks":["code"],"text":"gen_state_machine"}]},{"id":"blk-95123","spans":[{"id":"spn-159008","text":"Formal lifecycle transition rules"}]}],[{"id":"blk-95124","spans":[{"id":"spn-159009","text":"Hot Cache"}]},{"id":"blk-95125","spans":[{"id":"spn-159010","text":"ETS"}]},{"id":"blk-95126","spans":[{"id":"spn-159011","text":"Permission, lifecycle, and autonomy lookups — sub-microsecond"}]}],[{"id":"blk-95127","spans":[{"id":"spn-159012","text":"Audit Storage"}]},{"id":"blk-95128","spans":[{"id":"spn-159013","text":"Pluggable (ETS / File / Ecto)"}]},{"id":"blk-95129","spans":[{"id":"spn-159014","text":"ETS for dev, file for single-node, Ecto+Postgres for production"}]}],[{"id":"blk-95130","spans":[{"id":"spn-159015","text":"Telemetry"}]},{"id":"blk-95131","spans":[{"id":"spn-159016","marks":["code"],"text":":telemetry"}]},{"id":"blk-95132","spans":[{"id":"spn-159017","text":"Permission check latency, lifecycle transitions, audit throughput"}]}],[{"id":"blk-95133","spans":[{"id":"spn-159018","text":"Documentation"}]},{"id":"blk-95134","spans":[{"id":"spn-159019","text":"Sphinx + MyST"}]},{"id":"blk-95135","spans":[{"id":"spn-159020","text":"ReadTheDocs build (Ubuntu 24.04, Python 3.13)"}]}]]},{"id":"blk-95136","kind":"heading","level":2,"spans":[{"id":"spn-159021","text":"Quickstart"}]},{"id":"blk-95137","kind":"paragraph","spans":[{"id":"spn-159022","text":"The governance shim wraps any OTP supervision tree:"}]},{"id":"blk-95138","kind":"code","language":"elixir","text":"# 1. Add dependency\ndefp deps do\n  [{:open_sentience, \"~> 0.1\"}]\nend\n\n# 2. Add to your supervision tree\nchildren = [\n  {OpenSentience, policy: \"priv/governance/policy.yaml\"},\n  # ... your existing children\n]\n\n# 3. Install an agent\nOpenSentience.install_agent(\"my-agent\",\n  permissions: %{filesystem: %{read: [\"priv/**\"]}},\n  autonomy: :observe\n)"},{"id":"blk-95139","kind":"paragraph","spans":[{"id":"spn-159023","text":"Full integration guide: "},{"id":"spn-159024","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/quickstart.md"}],"text":"`docs/quickstart.md`"}]},{"id":"blk-95140","kind":"heading","level":2,"spans":[{"id":"spn-159025","text":"Ecosystem Relationships"}]},{"id":"blk-95141","kind":"paragraph","spans":[{"id":"spn-159026","text":"OpenSentience defines protocols. Portfolio products implement them:"}]},{"head":[{"id":"blk-95143","spa