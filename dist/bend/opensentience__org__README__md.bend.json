{"bendscript":"0.1","blocks":[{"id":"blk-72589","kind":"heading","level":1,"spans":[{"id":"spn-105567","text":"OpenSentience"}]},{"id":"blk-72590","kind":"paragraph","spans":[{"id":"spn-105568","marks":["bold"],"text":"Open research protocols for machine cognition, structured memory, deliberation topology, and agent governance."}]},{"id":"blk-72591","kind":"paragraph","spans":[{"id":"spn-105569","text":"Published by "},{"id":"spn-105570","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"Ampersand Box Design"},{"id":"spn-105571","text":" under the [&] Protocol ecosystem."}]},{"blocks":[{"id":"blk-72593","kind":"paragraph","spans":[{"id":"spn-105572","text":"\"Intelligence is not generation. It is structured accumulation.\""}]}],"id":"blk-72592","kind":"quote"},{"id":"blk-72594","kind":"paragraph","spans":[{"id":"spn-105573","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/license-Apache%202.0-blue.svg"}],"text":"![License"},{"id":"spn-105574","text":"](https://www.apache.org/licenses/LICENSE-2.0) "},{"id":"spn-105575","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/spec-v0.1%20draft-orange.svg"}],"text":"![Spec Status"},{"id":"spn-105576","text":"]() "},{"id":"spn-105577","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/docs-ReadTheDocs-informational.svg"}],"text":"![Docs"},{"id":"spn-105578","text":"]() "},{"id":"spn-105579","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/stack-Elixir%20%7C%20OTP-purple.svg"}],"text":"![Stack"},{"id":"spn-105580","text":"]()"}]},{"id":"blk-72595","kind":"heading","level":2,"spans":[{"id":"spn-105581","text":"What is OpenSentience?"}]},{"id":"blk-72596","kind":"paragraph","spans":[{"id":"spn-105582","text":"OpenSentience is the "},{"id":"spn-105583","marks":["bold"],"text":"research arm"},{"id":"spn-105584","text":" of the [&] Protocol ecosystem. It is "},{"id":"spn-105585","marks":["bold"],"text":"not a product"},{"id":"spn-105586","text":" — it is a research organization that publishes:"}]},{"id":"blk-72597","items":[{"blocks":[{"id":"blk-72599","kind":"paragraph","spans":[{"id":"spn-105587","marks":["bold"],"text":"Ten numbered protocols"},{"id":"spn-105588","text":" (OS-001 through OS-010) — each defining one cognitive capability or cross-cutting concern, grounded in cognitive science"}]}],"id":"blk-72598","kind":"list-item"},{"blocks":[{"id":"blk-72601","kind":"paragraph","spans":[{"id":"spn-105589","marks":["bold"],"text":"Three runtime artifacts"},{"id":"spn-105590","text":" — a governance shim (OS-006), a benchmark engine (OS-009 PRISM), and a loop manifest standard (OS-010 PULSE)"}]}],"id":"blk-72600","kind":"list-item"},{"blocks":[{"id":"blk-72603","kind":"paragraph","spans":[{"id":"spn-105591","marks":["bold"],"text":"Published research"},{"id":"spn-105592","text":" — cognitive science grounding, empirical benchmarks, and open questions"}]}],"id":"blk-72602","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-72604","kind":"paragraph","spans":[{"id":"spn-105593","text":"Other [&] portfolio products implement the protocols. OpenSentience defines them, grounds them in theory, and provides the thin enforcement layer that ties them together at runtime."}]},{"id":"blk-72605","kind":"heading","level":2,"spans":[{"id":"spn-105594","text":"The Ten Protocols"}]},{"id":"blk-72606","kind":"paragraph","spans":[{"id":"spn-105595","text":"Eight "},{"id":"spn-105596","marks":["bold"],"text":"cognitive primitives"},{"id":"spn-105597","text":" (OS-001–OS-008) plus two "},{"id":"spn-105598","marks":["bold"],"text":"cross-cutting protocols"},{"id":"spn-105599","text":" (OS-009, OS-010):"}]},{"head":[{"id":"blk-72608","spans":[{"id":"spn-105600","text":"ID"}]},{"id":"blk-72609","spans":[{"id":"spn-105601","text":"Protocol"}]},{"id":"blk-72610","spans":[{"id":"spn-105602","text":"[&] Primitive"}]},{"id":"blk-72611","spans":[{"id":"spn-105603","text":"Status"}]},{"id":"blk-72612","spans":[{"id":"spn-105604","text":"Implementation"}]}],"id":"blk-72607","kind":"table","rows":[[{"id":"blk-72613","spans":[{"id":"spn-105605","text":"OS-001"}]},{"id":"blk-72614","spans":[{"id":"spn-105606","text":"Continual Learning"}]},{"id":"blk-72615","spans":[{"id":"spn-105607","marks":["code"],"text":"&memory.graph"}]},{"id":"blk-72616","spans":[{"id":"spn-105608","text":"v0.3.3 shipped"}]},{"id":"blk-72617","spans":[{"id":"spn-105609","marks":[{"kind":"link","predicate":"cites","target":"../graphonomous/"}],"text":"Graphonomous"}]}],[{"id":"blk-72618","spans":[{"id":"spn-105610","text":"OS-002"}]},{"id":"blk-72619","spans":[{"id":"spn-105611","text":"Topological Routing (κ)"}]},{"id":"blk-72620","spans":[{"id":"spn-105612","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-72621","spans":[{"id":"spn-105613","text":"Spec complete"}]},{"id":"blk-72622","spans":[{"id":"spn-105614","text":"Graphonomous routing layer"}]}],[{"id":"blk-72623","spans":[{"id":"spn-105615","text":"OS-003"}]},{"id":"blk-72624","spans":[{"id":"spn-105616","text":"Deliberation Orchestrator"}]},{"id":"blk-72625","spans":[{"id":"spn-105617","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-72626","spans":[{"id":"spn-105618","text":"Spec complete"}]},{"id":"blk-72627","spans":[{"id":"spn-105619","text":"AgenTroMatic"}]}],[{"id":"blk-72628","spans":[{"id":"spn-105620","text":"OS-004"}]},{"id":"blk-72629","spans":[{"id":"spn-105621","text":"Attention Engine"}]},{"id":"blk-72630","spans":[{"id":"spn-105622","text":"meta-reasoning"}]},{"id":"blk-72631","spans":[{"id":"spn-105623","text":"Spec complete"}]},{"id":"blk-72632","spans":[{"id":"spn-105624","text":"Graphonomous attention module"}]}],[{"id":"blk-72633","spans":[{"id":"spn-105625","text":"OS-005"}]},{"id":"blk-72634","spans":[{"id":"spn-105626","text":"Model Tier Adaptation"}]},{"id":"blk-72635","spans":[{"id":"spn-105627","text":"system"}]},{"id":"blk-72636","spans":[{"id":"spn-105628","text":"Spec complete"}]},{"id":"blk-72637","spans":[{"id":"spn-105629","text":"Graphonomous / Agentelic"}]}],[{"id":"blk-72638","spans":[{"id":"spn-105630","text":"OS-006"}]},{"id":"blk-72639","spans":[{"id":"spn-105631","text":"Agent Governance Shim"}]},{"id":"blk-72640","spans":[{"id":"spn-105632","text":"governance"}]},{"id":"blk-72641","spans":[{"id":"spn-105633","text":"In development"}]},{"id":"blk-72642","spans":[{"id":"spn-105634","marks":["code"],"text":"open_sentience"},{"id":"spn-105635","text":" hex package"}]}],[{"id":"blk-72643","spans":[{"id":"spn-105636","text":"OS-007"}]},{"id":"blk-72644","spans":[{"id":"spn-105637","text":"Adversarial Robustness"}]},{"id":"blk-72645","spans":[{"id":"spn-105638","marks":["code"],"text":"&govern.identity"}]},{"id":"blk-72646","spans":[{"id":"spn-105639","text":"Draft"}]},{"id":"blk-72647","spans":[{"id":"spn-105640","text":"OpenSentience security module"}]}],[{"id":"blk-72648","spans":[{"id":"spn-105641","text":"OS-008"}]},{"id":"blk-72649","spans":[{"id":"spn-105642","text":"Agent Harness"}]},{"id":"blk-72650","spans":[{"id":"spn-105643","marks":["code"],"text":"&govern.harness"}]},{"id":"blk-72651","spans":[{"id":"spn-105644","text":"Draft"}]},{"id":"blk-72652","spans":[{"id":"spn-105645","text":"OpenSentience harness module"}]}],[{"id":"blk-72653","spans":[{"id":"spn-105646","marks":["bold"],"text":"OS-009"}]},{"id":"blk-72654","spans":[{"id":"spn-105647","marks":["bold"],"text":"PRISM"},{"id":"spn-105648","text":" (Rating Iterative System Memory)"}]},{"id":"blk-72655","spans":[{"id":"spn-105649","marks":["code"],"text":"&memory + &reason"}]},{"id":"blk-72656","spans":[{"id":"spn-105650","text":"v3.0 in development"}]},{"id":"blk-72657","spans":[{"id":"spn-105651","marks":[{"kind":"link","predicate":"cites","target":"../PRISM/"}],"text":"`/PRISM/`"},{"id":"spn-105652","text":" — Fly.io deploy"}]}],[{"id":"blk-72658","spans":[{"id":"spn-105653","marks":["bold"],"text":"OS-010"}]},{"id":"blk-72659","spans":[{"id":"spn-105654","marks":["bold"],"text":"PULSE"},{"id":"spn-105655","text":" (Uniform Loop State Exchange)"}]},{"id":"blk-72660","spans":[{"id":"spn-105656","marks":["code"],"text":"&memory + &govern + &time"}]},{"id":"blk-72661","spans":[{"id":"spn-105657","text":"v0.1 draft"}]},{"id":"blk-72662","spans":[{"id":"spn-105658","marks":[{"kind":"link","predicate":"cites","target":"../PULSE/"}],"text":"`/PULSE/`"},{"id":"spn-105659","text":" — manifest standard"}]}]]},{"id":"blk-72663","kind":"heading","level":3,"spans":[{"id":"spn-105660","text":"The Three-Protocol Stack"}]},{"id":"blk-72664","kind":"code","language":"text","text":"┌──────────────────────────────────────────────────────────┐\n│  PRISM (OS-009)  — measures loops over time   diagnostic │\n├──────────────────────────────────────────────────────────┤\n│  PULSE (OS-010)  — declares loops + signals    temporal  │\n├──────────────────────────────────────────────────────────┤\n│  OS-001 … OS-008 — cognitive primitives       capability │\n├──────────────────────────────────────────────────────────┤\n│  [&]             — composes capabilities      structural │\n└──────────────────────────────────────────────────────────┘"},{"id":"blk-72665","items":[{"blocks":[{"id":"blk-72667","kind":"paragraph","spans":[{"id":"spn-105661","marks":["bold"],"text":"[&]"},{"id":"spn-105662","text":" composes agents ("},{"id":"spn-105663","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-105664","text":") — structural layer"}]}],"id":"blk-72666","kind":"list-item"},{"blocks":[{"id":"blk-72669","kind":"paragraph","spans":[{"id":"spn-105665","marks":["bold"],"text":"PULSE"},{"id":"spn-105666","text":" gives them a heartbeat ("},{"id":"spn-105667","marks":["code"],"text":"*.pulse.json"},{"id":"spn-105668","text":") — temporal layer"}]}],"id":"blk-72668","kind":"list-item"},{"blocks":[{"id":"blk-72671","kind":"paragraph","spans":[{"id":"spn-105669","marks":["bold"],"text":"PRISM"},{"id":"spn-105670","text":" measures their effect — diagnostic layer"}]}],"id":"blk-72670","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72672","kind":"paragraph","spans":[{"id":"spn-105671","text":"Each protocol is independent. Adoption order is typically [&] → PULSE → PRISM."}]},{"id":"blk-72673","kind":"heading","level":2,"spans":[{"id":"spn-105672","text":"Protocol Summaries"}]},{"id":"blk-72674","kind":"heading","level":3,"spans":[{"id":"spn-105673","text":"OS-001: Continual Learning"}]},{"id":"blk-72675","kind":"paragraph","spans":[{"id":"spn-105674","text":"Hippocampal consolidation-inspired memory. Self-evolving knowledge graph with four node types (episodic, semantic, procedural, temporal), typed/weighted/decaying edges, multi-timescale consolidation, and no model weight modification — all learning is graph-structural."}]},{"id":"blk-72676","kind":"heading","level":3,"spans":[{"id":"spn-105675","text":"OS-002: Topological Routing (κ-Routing)"}]},{"id":"blk-72677","kind":"paragraph","spans":[{"id":"spn-105676","text":"Routes queries through knowledge graphs using topological structure, not just embedding similarity. The κ parameter balances exploitation (κ=0, follow strong edges) vs exploration (κ→∞, random walk). Inspired by prefrontal cortex working memory gating."}]},{"id":"blk-72678","kind":"heading","level":3,"spans":[{"id":"spn-105677","text":"OS-003: Deliberation Orchestrator"}]},{"id":"blk-72679","kind":"paragraph","spans":[{"id":"spn-105678","text":"Multi-agent consensus through structured phases: bid → debate → vote → commit. Uses weighted bipolar argumentation, Raft fast-path for agreement, PBFT for Byzantine tolerance, and reputation-weighted bid credibility. Maps to Kahneman's System 2."}]},{"id":"blk-72680","kind":"heading","level":3,"spans":[{"id":"spn-105679","text":"OS-004: Attention Engine"}]},{"id":"blk-72681","kind":"paragraph","spans":[{"id":"spn-105680","text":"Three-phase proactive attention cycle — survey (scan all sources, produce salience map) → triage (rank by urgency/novelty/goals) → dispatch (route to pipelines). Runs continuously with adaptive frequency. Grounded in endogenous top-down attention."}]},{"id":"blk-72682","kind":"heading","level":3,"spans":[{"id":"spn-105681","text":"OS-005: Model Tier Adaptation"}]},{"id":"blk-72683","kind":"paragraph","spans":[{"id":"spn-105682","text":"Graduated model selection across three tiers: "},{"id":"spn-105683","marks":["code"],"text":"local_small"},{"id":"spn-105684","text":" (1B–3B), "},{"id":"spn-105685","marks":["code"],"text":"local_large"},{"id":"spn-105686","text":" (7B–14B), "},{"id":"spn-105687","marks":["code"],"text":"cloud_frontier"},{"id":"spn-105688","text":" (70B+/API). Escalates when confidence falls below threshold; de-escalates by caching successful patterns as procedures. Based on resource rationality theory."}]},{"id":"blk-72684","kind":"heading","level":3,"spans":[{"id":"spn-105689","text":"OS-006: Agent Governance Shim"}]},{"id":"blk-72685","kind":"paragraph","spans":[{"id":"spn-105690","text":"The only protocol OpenSentience implements directly. Deny-by-default permissions, five lifecycle states (installed → enabled → running → disabled → removed), three autonomy levels (observe / advise / act), append-only audit trail. ETS-backed lookups at microsecond latency. Ships as the "},{"id":"spn-105691","marks":["code"],"text":"open_sentience"},{"id":"spn-105692","text":" hex package."}]},{"id":"blk-72686","kind":"heading","level":3,"spans":[{"id":"spn-105693","text":"OS-007: Adversarial Robustness"}]},{"id":"blk-72687","kind":"paragraph","spans":[{"id":"spn-105694","text":"Defense against prompt injection, model poisoning, side-channel attacks, identity spoofing, and resource exhaustion. Specification-stage protocol."}]},{"id":"blk-72688","kind":"heading","level":3,"spans":[{"id":"spn-105695","text":"OS-008: Agent Harness"}]},{"id":"blk-72689","kind":"paragraph","spans":[{"id":"spn-105696","text":"Pipeline enforcement above governance. Two enforced pipelines (reactive: "},{"id":"spn-105697","marks":["code"],"text":"query → recall → topology → deliberate → store"},{"id":"spn-105698","text":"; sprint: planner → generator → evaluator → commit). Quality gates with adversarial grading. Sprint contracts with acceptance criteria. Context management with 60% utilization threshold. Grounded in Norman & Shallice's Supervisory Attentional System."}]},{"id":"blk-72690","kind":"heading","level":3,"spans":[{"id":"spn-105699","text":"OS-009: PRISM"}]},{"id":"blk-72691","kind":"paragraph","spans":[{"id":"spn-105700","marks":["bold"],"text":"Protocol for Rating Iterative System Memory."},{"id":"spn-105701","text":" The first self-improving continual learning benchmark. Measures 9 CL dimensions (retrieval, transfer, uncertainty, feedback integration, forgetting, consolidation, temporal reasoning, multi-agent deliberation, composition). Four-phase evaluation loop: compose → interact → observe → reflect → diagnose. Features BYOR (Bring Your Own Repo), IRT calibration, three-layer judging, closed-loop verification, leaderboards, and actionable diagnostics."}]},{"id":"blk-72692","kind":"heading","level":3,"spans":[{"id":"spn-105702","text":"OS-010: PULSE"}]},{"id":"blk-72693","kind":"paragraph","spans":[{"id":"spn-105703","marks":["bold"],"text":"Protocol for Uniform Loop State Exchange."},{"id":"spn-105704","text":" Temporal algebra declaring how loops cycle, nest, and signal. Five canonical phase kinds (retrieve, route, act, learn, consolidate). Six cadence types (event, periodic, streaming, idle, cross_loop_signal, manual). Five canonical cross-loop tokens via CloudEvents v1.0 envelopes. BYOL (Bring Your Own Loop) — any system publishing a conforming manifest is automatically PRISM-evaluable."}]},{"id":"blk-72694","kind":"heading","level":2,"spans":[{"id":"spn-105705","text":"Architecture"}]},{"id":"blk-72695","kind":"heading","level":3,"spans":[{"id":"spn-105706","text":"Governance Shim (OS-006) — OTP Supervision Tree"}]},{"id":"blk-72696","kind":"code","language":"text","text":"OpenSentience.Application\n├── OpenSentience.PermissionEngine     (GenServer + ETS — deny-by-default policy)\n├── OpenSentience.AuditWriter          (GenServer — batched append-only)\n├── OpenSentience.AutonomyController   (GenServer + ETS — observe/advise/act)\n├── OpenSentience.AgentSupervisor      (DynamicSupervisor)\n│   ├── AgentLifecycle \"agent-001\"     (GenStateMachine → wraps real process)\n│   ├── AgentLifecycle \"agent-002\"\n│   └── ...\n├── OpenSentience.MCP.Server           (Hermes MCP — governance tools)\n└── OpenSentience.Telemetry            (telemetry handler)"},{"id":"blk-72697","kind":"heading","level":3,"spans":[{"id":"spn-105707","text":"Triple-Loop Nesting"}]},{"id":"blk-72698","kind":"paragraph","spans":[{"id":"spn-105708","text":"The reference [&] ecosystem operates with three nested closed loops:"}]},{"id":"blk-72699","kind":"code","language":"text","text":"PRISM (outer)              compose → interact → observe → reflect → diagnose\n  │\n  └─ Graphonomous         retrieve → route → act → learn → consolidate\n       │\n       └─ Deliberation    survey → triage → dispatch → act → learn"},{"id":"blk-72700","kind":"paragraph","spans":[{"id":"spn-105709","text":"PULSE manifests encode this nesting declaratively."}]},{"id":"blk-72701","kind":"heading","level":2,"spans":[{"id":"spn-105710","text":"Cognitive Science Grounding"}]},{"id":"blk-72702","kind":"paragraph","spans":[{"id":"spn-105711","text":"Every protocol maps to published research:"}]},{"head":[{"id":"blk-72704","spans":[{"id":"spn-105712","text":"Protocol"}]},{"id":"blk-72705","spans":[{"id":"spn-105713","text":"Theory"}]},{"id":"blk-72706","spans":[{"id":"spn-105714","text":"Key Reference"}]}],"id":"blk-72703","kind":"table","rows":[[{"id":"blk-72707","spans":[{"id":"spn-105715","text":"OS-001"}]},{"id":"blk-72708","spans":[{"id":"spn-105716","text":"Hippocampal consolidation"}]},{"id":"blk-72709","spans":[{"id":"spn-105717","text":"McClelland et al. 1995"}]}],[{"id":"blk-72710","spans":[{"id":"spn-105718","text":"OS-002"}]},{"id":"blk-72711","spans":[{"id":"spn-105719","text":"Working memory gating"}]},{"id":"blk-72712","spans":[{"id":"spn-105720","text":"O'Reilly & Frank 2006"}]}],[{"id":"blk-72713","spans":[{"id":"spn-105721","text":"OS-003"}]},{"id":"blk-72714","spans":[{"id":"spn-105722","text":"Dual-process theory"}]},{"id":"blk-72715","spans":[{"id":"spn-105723","text":"Kahneman 2011"}]}],[{"id":"blk-72716","spans":[{"id":"spn-105724","text":"OS-004"}]},{"id":"blk-72717","spans":[{"id":"spn-105725","text":"Endogenous attention"}]},{"id":"blk-72718","spans":[{"id":"spn-105726","text":"Desimone & Duncan 1995"}]}],[{"id":"blk-72719","spans":[{"id":"spn-105727","text":"OS-005"}]},{"id":"blk-72720","spans":[{"id":"spn-105728","text":"Resource rationality"}]},{"id":"blk-72721","spans":[{"id":"spn-105729","text":"Lieder & Griffiths 2020"}]}],[{"id":"blk-72722","spans":[{"id":"spn-105730","text":"OS-006"}]},{"id":"blk-72723","spans":[{"id":"spn-105731","text":"Executive function"}]},{"id":"blk-72724","spans":[{"id":"spn-105732","text":"Miyake et al. 2000"}]}],[{"id":"blk-72725","spans":[{"id":"spn-105733","text":"OS-007"}]},{"id":"blk-72726","spans":[{"id":"spn-105734","text":"Immune system analogy"}]},{"id":"blk-72727","spans":[{"id":"spn-105735","text":"—"}]}],[{"id":"blk-72728","spans":[{"id":"spn-105736","text":"OS-008"}]},{"id":"blk-72729","spans":[{"id":"spn-105737","text":"Supervisory attentional system"}]},{"id":"blk-72730","spans":[{"id":"spn-105738","text":"Norman & Shallice 1986"}]}],[{"id":"blk-72731","spans":[{"id":"spn-105739","text":"OS-009"}]},{"id":"blk-72732","spans":[{"id":"spn-105740","text":"Meta-cognition + IRT"}]},{"id":"blk-72733","spans":[{"id":"spn-105741","text":"Signal detection theory"}]}],[{"id":"blk-72734","spans":[{"id":"spn-105742","text":"OS-010"}]},{"id":"blk-72735","spans":[{"id":"spn-105743","text":"Closed-loop control + temporal cognition"}]},{"id":"blk-72736","spans":[{"id":"spn-105744","text":"Wiener 1948"}]}]]},{"id":"blk-72737","kind":"heading","level":2,"spans":[{"id":"spn-105745","text":"Empirical Results (OS-E001)"}]},{"id":"blk-72738","kind":"paragraph","spans":[{"id":"spn-105746","text":"Benchmark of Graphonomous v0.3.3 on the full [&] portfolio (18,165 files across 14 projects):"}]},{"head":[{"id":"blk-72740","spans":[{"id":"spn-105747","text":"Metric"}]},{"id":"blk-72741","spans":[{"id":"spn-105748","text":"Result"}]}],"id":"blk-72739","kind":"table","rows":[[{"id":"blk-72742","spans":[{"id":"spn-105749","text":"QA proxy accuracy (LongMemEval, 500 questions)"}]},{"id":"blk-72743","spans":[{"id":"spn-105750","text":"92.6%"}]}],[{"id":"blk-72744","spans":[{"id":"spn-105751","text":"Session hit rate"}]},{"id":"blk-72745","spans":[{"id":"spn-105752","text":"98.7%"}]}],[{"id":"blk-72746","spans":[{"id":"spn-105753","text":"Mean retrieval latency"}]},{"id":"blk-72747","spans":[{"id":"spn-105754","text":"1.4s"}]}],[{"id":"blk-72748","spans":[{"id":"spn-105755","text":"F1 gain from graph-expanded retrieval vs flat"}]},{"id":"blk-72749","spans":[{"id":"spn-105756","text":"+0.024"}]}],[{"id":"blk-72750","spans":[{"id":"spn-105757","text":"Recall gain from graph-expanded retrieval"}]},{"id":"blk-72751","spans":[{"id":"spn-105758","text":"+0.103"}]}],[{"id":"blk-72752","spans":[{"id":"spn-105759","text":"Automated edges extracted"}]},{"id":"blk-72753","spans":[{"id":"spn-105760","text":"12,871"}]}],[{"id":"blk-72754","spans":[{"id":"spn-105761","text":"Naturally occurring SCCs"}]},{"id":"blk-72755","spans":[{"id":"spn-105762","text":"22 (max κ=27)"}]}],[{"id":"blk-72756","spans":[{"id":"spn-105763","text":"κ detection accuracy"}]},{"id":"blk-72757","spans":[{"id":"spn-105764","text":"100% at 27K-node scale"}]}],[{"id":"blk-72758","spans":[{"id":"spn-105765","text":"Test pass rate"}]},{"id":"blk-72759","spans":[{"id":"spn-105766","text":"455/455 (100%)"}]}],[{"id":"blk-72760","spans":[{"id":"spn-105767","text":"Consolidation throughput"}]},{"id":"blk-72761","spans":[{"id":"spn-105768","text":"~27.1M nodes/sec"}]}],[{"id":"blk-72762","spans":[{"id":"spn-105769","text":"Abstention accuracy (learned ANN threshold)"}]},{"id":"blk-72763","spans":[{"id":"spn-105770","text":"96.7%"}]}]]},{"id":"blk-72764","kind":"paragraph","spans":[{"id":"spn-105771","text":"Full results: "},{"id":"spn-105772","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"}],"text":"`docs/spec/OS-E001-EMPIRICAL-EVALUATION.md`"}]},{"id":"blk-72765","kind":"heading","level":2,"spans":[{"id":"spn-105773","text":"κ Proof"}]},{"id":"blk-72766","kind":"paragraph","spans":[{"id":"spn-105774","marks":[{"kind":"link","predicate":"cites","target":"kappa_proof.js"}],"text":"`kappa_proof.js`"},{"id":"spn-105775","text":" is a browser-runnable proof verifying the κ-routing theorem across "},{"id":"spn-105776","marks":["bold"],"text":"1,926,351 test cases"},{"id":"spn-105777","text":":"}]},{"id":"blk-72767","items":[{"blocks":[{"id":"blk-72769","kind":"paragraph","spans":[{"id":"spn-105778","text":"1,052,740 directed graphs (n=2–5): κ(G) > 0 ⟺ β₁(G) > 0 ⟺ nontrivial SCC"}]}],"id":"blk-72768","kind":"list-item"},{"blocks":[{"id":"blk-72771","kind":"paragraph","spans":[{"id":"spn-105779","text":"873,611 finite dynamical systems (n=2–7): κ(f) > 0 ⟺ periodic orbit (period > 1)"}]}],"id":"blk-72770","kind":"list-item"},{"blocks":[{"id":"blk-72773","kind":"paragraph","spans":[{"id":"spn-105780","marks":["bold"],"text":"Zero counterexamples"}]}],"id":"blk-72772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72774","kind":"heading","level":2,"spans":[{"id":"spn-105781","text":"Repository Structure"}]},{"id":"blk-72775","kind":"code","language":"text","text":"opensentience.org/\n├── docs/\n│   ├── spec/\n│   │   ├── README.md                       # Master spec — all 10 protocols (source of truth)\n│   │   ├── OS-008-HARNESS.md               # Agent Harness Protocol\n│   │   ├── OS-009-PRISM-SPECIFICATION.md   # PRISM benchmark engine spec\n│   │   ├── OS-010-PULSE-SPECIFICATION.md   # PULSE loop manifest spec\n│   │   └── OS-E001-EMPIRICAL-EVALUATION.md # Empirical benchmark results\n│   ├── skills/                             # Agent skill guides (8 numbered modules)\n│   ├── index.md                            # ReadTheDocs homepage\n│   ├── architecture.md                     # OTP supervision tree details\n│   ├── ecosystem-overview.md               # 10 protocols + 12 product relationships\n│   ├── positioning.md                      # Governance stack & market positioning\n│   ├── competitive-landscape.md            # Comparison with CrewAI, LangGraph, etc.\n│   ├── harness-engineering.md              # Pipeline enforcement deep-dive\n│   ├── runtime-walkthrough.md              # Concrete agent lifecycle walkthrough\n│   ├── comparison-table.md                 # Feature matrix vs alternatives\n│   ├── research.md                         # Cognitive science grounding (7+ hours)\n│   ├── quickstart.md                       # Elixir integration guide\n│   ├── faq.md                              # Common questions\n│   ├── conf.py                             # Sphinx configuration\n│   └── requirements.txt                    # sphinx>=8, myst-parser>=4\n├── index.html                              # Marketing landing page\n├── kappa_proof.js                          # Browser-runnable κ proof (1.9M test cases)\n├── CLAUDE.md                               # Agent context\n├── AGENTS.md                               # Agent interface guide\n├── .readthedocs.yaml                       # ReadTheDocs build config\n└── old_scrap/                              # Historical v1/v2 iterations (not current)"},{"id":"blk-72776","kind":"heading","level":2,"spans":[{"id":"spn-105782","text":"Technology Stack"}]},{"head":[{"id":"blk-72778","spans":[{"id":"spn-105783","text":"Layer"}]},{"id":"blk-72779","spans":[{"