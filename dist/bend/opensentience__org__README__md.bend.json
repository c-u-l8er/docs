809","marks":["code"],"text":":telemetry"}]},{"id":"blk-72801","spans":[{"id":"spn-105810","text":"Permission check latency, lifecycle transitions, audit throughput"}]}],[{"id":"blk-72802","spans":[{"id":"spn-105811","text":"Documentation"}]},{"id":"blk-72803","spans":[{"id":"spn-105812","text":"Sphinx + MyST"}]},{"id":"blk-72804","spans":[{"id":"spn-105813","text":"ReadTheDocs build (Ubuntu 24.04, Python 3.13)"}]}]]},{"id":"blk-72805","kind":"heading","level":2,"spans":[{"id":"spn-105814","text":"Quickstart"}]},{"id":"blk-72806","kind":"paragraph","spans":[{"id":"spn-105815","text":"The governance shim wraps any OTP supervision tree:"}]},{"id":"blk-72807","kind":"code","language":"elixir","text":"# 1. Add dependency\ndefp deps do\n  [{:open_sentience, \"~> 0.1\"}]\nend\n\n# 2. Add to your supervision tree\nchildren = [\n  {OpenSentience, policy: \"priv/governance/policy.yaml\"},\n  # ... your existing children\n]\n\n# 3. Install an agent\nOpenSentience.install_agent(\"my-agent\",\n  permissions: %{filesystem: %{read: [\"priv/**\"]}},\n  autonomy: :observe\n)"},{"id":"blk-72808","kind":"paragraph","spans":[{"id":"spn-105816","text":"Full integration guide: "},{"id":"spn-105817","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/quickstart.md"}],"text":"`docs/quickstart.md`"}]},{"id":"blk-72809","kind":"heading","level":2,"spans":[{"id":"spn-105818","text":"Ecosystem Relationships"}]},{"id":"blk-72810","kind":"paragraph","spans":[{"id":"spn-105819","text":"OpenSentience defines protocols. Portfolio products implement them:"}]},{"head":[{"id":"blk-72812","spans":[{"id":"spn-105820","text":"Product"}]},{"id":"blk-72813","spans":[{"id":"spn-105821","text":"Protocols Implemented"}]},{"id":"blk-72814","spans":[{"id":"spn-105822","text":"Role"}]}],"id":"blk-72811","kind":"table","rows":[[{"id":"blk-72815","spans":[{"id":"spn-105823","marks":[{"kind":"link","predicate":"cites","target":"../graphonomous/"}],"text":"Graphonomous"}]},{"id":"blk-7281