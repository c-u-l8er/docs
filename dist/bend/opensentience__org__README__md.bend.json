{"bendscript":"0.1","blocks":[{"id":"blk-71624","kind":"heading","level":1,"spans":[{"id":"spn-102727","text":"OpenSentience"}]},{"id":"blk-71625","kind":"paragraph","spans":[{"id":"spn-102728","marks":["bold"],"text":"Open research protocols for machine cognition, structured memory, deliberation topology, and agent governance."}]},{"id":"blk-71626","kind":"paragraph","spans":[{"id":"spn-102729","text":"Published by "},{"id":"spn-102730","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"Ampersand Box Design"},{"id":"spn-102731","text":" under the [&] Protocol ecosystem."}]},{"blocks":[{"id":"blk-71628","kind":"paragraph","spans":[{"id":"spn-102732","text":"\"Intelligence is not generation. It is structured accumulation.\""}]}],"id":"blk-71627","kind":"quote"},{"id":"blk-71629","kind":"paragraph","spans":[{"id":"spn-102733","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/license-Apache%202.0-blue.svg"}],"text":"![License"},{"id":"spn-102734","text":"](https://www.apache.org/licenses/LICENSE-2.0) "},{"id":"spn-102735","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/spec-v0.1%20draft-orange.svg"}],"text":"![Spec Status"},{"id":"spn-102736","text":"]() "},{"id":"spn-102737","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/docs-ReadTheDocs-informational.svg"}],"text":"![Docs"},{"id":"spn-102738","text":"]() "},{"id":"spn-102739","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/stack-Elixir%20%7C%20OTP-purple.svg"}],"text":"![Stack"},{"id":"spn-102740","text":"]()"}]},{"id":"blk-71630","kind":"heading","level":2,"spans":[{"id":"spn-102741","text":"What is OpenSentience?"}]},{"id":"blk-71631","kind":"paragraph","spans":[{"id":"spn-102742","text":"OpenSentience is the "},{"id":"spn-102743","marks":["bold"],"text":"research arm"},{"id":"spn-102744","text":" of the [&] Protocol ecosystem. It is "},{"id":"spn-102745","marks":["bold"],"text":"not a product"},{"id":"spn-102746","text":" — it is a research organization that publishes:"}]},{"id":"blk-71632","items":[{"blocks":[{"id":"blk-71634","kind":"paragraph","spans":[{"id":"spn-102747","marks":["bold"],"text":"Ten numbered protocols"},{"id":"spn-102748","text":" (OS-001 through OS-010) — each defining one cognitive capability or cross-cutting concern, grounded in cognitive science"}]}],"id":"blk-71633","kind":"list-item"},{"blocks":[{"id":"blk-71636","kind":"paragraph","spans":[{"id":"spn-102749","marks":["bold"],"text":"Three runtime artifacts"},{"id":"spn-102750","text":" — a governance shim (OS-006), a benchmark engine (OS-009 PRISM), and a loop manifest standard (OS-010 PULSE)"}]}],"id":"blk-71635","kind":"list-item"},{"blocks":[{"id":"blk-71638","kind":"paragraph","spans":[{"id":"spn-102751","marks":["bold"],"text":"Published research"},{"id":"spn-102752","text":" — cognitive science grounding, empirical benchmarks, and open questions"}]}],"id":"blk-71637","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71639","kind":"paragraph","spans":[{"id":"spn-102753","text":"Other [&] portfolio products implement the protocols. OpenSentience defines them, grounds them in theory, and provides the thin enforcement layer that ties them together at runtime."}]},{"id":"blk-71640","kind":"heading","level":2,"spans":[{"id":"spn-102754","text":"The Ten Protocols"}]},{"id":"blk-71641","kind":"paragraph","spans":[{"id":"spn-102755","text":"Eight "},{"id":"spn-102756","marks":["bold"],"text":"cognitive primitives"},{"id":"spn-102757","text":" (OS-001–OS-008) plus two "},{"id":"spn-102758","marks":["bold"],"text":"cross-cutting protocols"},{"id":"spn-102759","text":" (OS-009, OS-010):"}]},{"head":[{"id":"blk-71643","spans":[{"id":"spn-102760","text":"ID"}]},{"id":"blk-71644","spans":[{"id":"spn-102761","text":"Protocol"}]},{"id":"blk-71645","spans":[{"id":"spn-102762","text":"[&] Primitive"}]},{"id":"blk-71646","spans":[{"id":"spn-102763","text":"Status"}]},{"id":"blk-71647","spans":[{"id":"spn-102764","text":"Implementation"}]}],"id":"blk-71642","kind":"table","rows":[[{"id":"blk-71648","spans":[{"id":"spn-102765","text":"OS-001"}]},{"id":"blk-71649","spans":[{"id":"spn-102766","text":"Continual Learning"}]},{"id":"blk-71650","spans":[{"id":"spn-102767","marks":["code"],"text":"&memory.graph"}]},{"id":"blk-71651","spans":[{"id":"spn-102768","text":"v0.3.3 shipped"}]},{"id":"blk-71652","spans":[{"id":"spn-102769","marks":[{"kind":"link","predicate":"cites","target":"../graphonomous/"}],"text":"Graphonomous"}]}],[{"id":"blk-71653","spans":[{"id":"spn-102770","text":"OS-002"}]},{"id":"blk-71654","spans":[{"id":"spn-102771","text":"Topological Routing (κ)"}]},{"id":"blk-71655","spans":[{"id":"spn-102772","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-71656","spans":[{"id":"spn-102773","text":"Spec complete"}]},{"id":"blk-71657","spans":[{"id":"spn-102774","text":"Graphonomous routing layer"}]}],[{"id":"blk-71658","spans":[{"id":"spn-102775","text":"OS-003"}]},{"id":"blk-71659","spans":[{"id":"spn-102776","text":"Deliberation Orchestrator"}]},{"id":"blk-71660","spans":[{"id":"spn-102777","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-71661","spans":[{"id":"spn-102778","text":"Spec complete"}]},{"id":"blk-71662","spans":[{"id":"spn-102779","text":"AgenTroMatic"}]}],[{"id":"blk-71663","spans":[{"id":"spn-102780","text":"OS-004"}]},{"id":"blk-71664","spans":[{"id":"spn-102781","text":"Attention Engine"}]},{"id":"blk-71665","spans":[{"id":"spn-102782","text":"meta-reasoning"}]},{"id":"blk-71666","spans":[{"id":"spn-102783","text":"Spec complete"}]},{"id":"blk-71667","spans":[{"id":"spn-102784","text":"Graphonomous attention module"}]}],[{"id":"blk-71668","spans":[{"id":"spn-102785","text":"OS-005"}]},{"id":"blk-71669","spans":[{"id":"spn-102786","text":"Model Tier Adaptation"}]},{"id":"blk-71670","spans":[{"id":"spn-102787","text":"system"}]},{"id":"blk-71671","spans":[{"id":"spn-102788","text":"Spec complete"}]},{"id":"blk-71672","spans":[{"id":"spn-102789","text":"Graphonomous / Agentelic"}]}],[{"id":"blk-71673","spans":[{"id":"spn-102790","text":"OS-006"}]},{"id":"blk-71674","spans":[{"id":"spn-102791","text":"Agent Governance Shim"}]},{"id":"blk-71675","spans":[{"id":"spn-102792","text":"governance"}]},{"id":"blk-71676","spans":[{"id":"spn-102793","text":"In development"}]},{"id":"blk-71677","spans":[{"id":"spn-102794","marks":["code"],"text":"open_sentience"},{"id":"spn-102795","text":" hex package"}]}],[{"id":"blk-71678","spans":[{"id":"spn-102796","text":"OS-007"}]},{"id":"blk-71679","spans":[{"id":"spn-102797","text":"Adversarial Robustness"}]},{"id":"blk-71680","spans":[{"id":"spn-102798","marks":["code"],"text":"&govern.identity"}]},{"id":"blk-71681","spans":[{"id":"spn-102799","text":"Draft"}]},{"id":"blk-71682","spans":[{"id":"spn-102800","text":"OpenSentience security module"}]}],[{"id":"blk-71683","spans":[{"id":"spn-102801","text":"OS-008"}]},{"id":"blk-71684","spans":[{"id":"spn-102802","text":"Agent Harness"}]},{"id":"blk-71685","spans":[{"id":"spn-102803","marks":["code"],"text":"&govern.harness"}]},{"id":"blk-71686","spans":[{"id":"spn-102804","text":"Draft"}]},{"id":"blk-71687","spans":[{"id":"spn-102805","text":"OpenSentience harness module"}]}],[{"id":"blk-71688","spans":[{"id":"spn-102806","marks":["bold"],"text":"OS-009"}]},{"id":"blk-71689","spans":[{"id":"spn-102807","marks":["bold"],"text":"PRISM"},{"id":"spn-102808","text":" (Rating Iterative System Memory)"}]},{"id":"blk-71690","spans":[{"id":"spn-102809","marks":["code"],"text":"&memory + &reason"}]},{"id":"blk-71691","spans":[{"id":"spn-102810","text":"v3.0 in development"}]},{"id":"blk-71692","spans":[{"id":"spn-102811","marks":[{"kind":"link","predicate":"cites","target":"../PRISM/"}],"text":"`/PRISM/`"},{"id":"spn-102812","text":" — Fly.io deploy"}]}],[{"id":"blk-71693","spans":[{"id":"spn-102813","marks":["bold"],"text":"OS-010"}]},{"id":"blk-71694","spans":[{"id":"spn-102814","marks":["bold"],"text":"PULSE"},{"id":"spn-102815","text":" (Uniform Loop State Exchange)"}]},{"id":"blk-71695","spans":[{"id":"spn-102816","marks":["code"],"text":"&memory + &govern + &time"}]},{"id":"blk-71696","spans":[{"id":"spn-102817","text":"v0.1 draft"}]},{"id":"blk-71697","spans":[{"id":"spn-102818","marks":[{"kind":"link","predicate":"cites","target":"../PULSE/"}],"text":"`/PULSE/`"},{"id":"spn-102819","text":" — manifest standard"}]}]]},{"id":"blk-71698","kind":"heading","level":3,"spans":[{"id":"spn-102820","text":"The Three-Protocol Stack"}]},{"id":"blk-71699","kind":"code","language":"text","text":"┌──────────────────────────────────────────────────────────┐\n│  PRISM (OS-009)  — measures loops over time   diagnostic │\n├──────────────────────────────────────────────────────────┤\n│  PULSE (OS-010)  — declares loops + signals    temporal  │\n├──────────────────────────────────────────────────────────┤\n│  OS-001 … OS-008 — cognitive primitives       capability │\n├──────────────────────────────────────────────────────────┤\n│  [&]             — composes capabilities      structural │\n└──────────────────────────────────────────────────────────┘"},{"id":"blk-71700","items":[{"blocks":[{"id":"blk-71702","kind":"paragraph","spans":[{"id":"spn-102821","marks":["bold"],"text":"[&]"},{"id":"spn-102822","text":" composes agents ("},{"id":"spn-102823","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-102824","text":") — structural layer"}]}],"id":"blk-71701","kind":"list-item"},{"blocks":[{"id":"blk-71704","kind":"paragraph","spans":[{"id":"spn-102825","marks":["bold"],"text":"PULSE"},{"id":"spn-102826","text":" gives them a heartbeat ("},{"id":"spn-102827","marks":["code"],"text":"*.pulse.json"},{"id":"spn-102828","text":") — temporal layer"}]}],"id":"blk-71703","kind":"list-item"},{"blocks":[{"id":"blk-71706","kind":"paragraph","spans":[{"id":"spn-102829","marks":["bold"],"text":"PRISM"},{"id":"spn-102830","text":" measures their effect — diagnostic layer"}]}],"id":"blk-71705","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71707","kind":"paragraph","spans":[{"id":"spn-102831","text":"Each protocol is independent. Adoption order is typically [&] → PULSE → PRISM."}]},{"id":"blk-71708","kind":"heading","level":2,"spans":[{"id":"spn-102832","text":"Protocol Summaries"}]},{"id":"blk-71709","kind":"heading","level":3,"spans":[{"id":"spn-102833","text":"OS-001: Continual Learning"}]},{"id":"blk-71710","kind":"paragraph","spans":[{"id":"spn-102834","text":"Hippocampal consolidation-inspired memory. Self-evolving knowledge graph with four node types (episodic, semantic, procedural, temporal), typed/weighted/decaying edges, multi-timescale consolidation, and no model weight modification — all learning is graph-structural."}]},{"id":"blk-71711","kind":"heading","level":3,"spans":[{"id":"spn-102835","text":"OS-002: Topological Routing (κ-Routing)"}]},{"id":"blk-71712","kind":"paragraph","spans":[{"id":"spn-102836","text":"Routes queries through knowledge graphs using topological structure, not just embedding similarity. The κ parameter balances exploitation (κ=0, follow strong edges) vs exploration (κ→∞, random walk). Inspired by prefrontal cortex working memory gating."}]},{"id":"blk-71713","kind":"heading","level":3,"spans":[{"id":"spn-102837","text":"OS-003: Deliberation Orchestrator"}]},{"id":"blk-71714","kind":"paragraph","spans":[{"id":"spn-102838","text":"Multi-agent consensus through structured phases: bid → debate → vote → commit. Uses weighted bipolar argumentation, Raft fast-path for agreement, PBFT for Byzantine tolerance, and reputation-weighted bid credibility. Maps to Kahneman's System 2."}]},{"id":"blk-71715","kind":"heading","level":3,"spans":[{"id":"spn-102839","text":"OS-004: Attention Engine"}]},{"id":"blk-71716","kind":"paragraph","spans":[{"id":"spn-102840","text":"Three-phase proactive attention cycle — survey (scan all sources, produce salience map) → triage (rank by urgency/novelty/goals) → dispatch (route to pipelines). Runs continuously with adaptive frequency. Grounded in endogenous top-down attention."}]},{"id":"blk-71717","kind":"heading","level":3,"spans":[{"id":"spn-102841","text":"OS-005: Model Tier Adaptation"}]},{"id":"blk-71718","kind":"paragraph","spans":[{"id":"spn-102842","text":"Graduated model selection across three tiers: "},{"id":"spn-102843","marks":["code"],"text":"local_small"},{"id":"spn-102844","text":" (1B–3B), "},{"id":"spn-102845","marks":["code"],"text":"local_large"},{"id":"spn-102846","text":" (7B–14B), "},{"id":"spn-102847","marks":["code"],"text":"cloud_frontier"},{"id":"spn-102848","text":" (70B+/API). Escalates when confidence falls below threshold; de-escalates by caching successful patterns as procedures. Based on resource rationality theory."}]},{"id":"blk-71719","kind":"heading","level":3,"spans":[{"id":"spn-102849","text":"OS-006: Agent Governance Shim"}]},{"id":"blk-71720","kind":"paragraph","spans":[{"id":"spn-102850","text":"The only protocol OpenSentience implements directly. Deny-by-default permissions, five lifecycle states (installed → enabled → running → disabled → removed), three autonomy levels (observe / advise / act), append-only audit trail. ETS-backed lookups at microsecond latency. Ships as the "},{"id":"spn-102851","marks":["code"],"text":"open_sentience"},{"id":"spn-102852","text":" hex package."}]},{"id":"blk-71721","kind":"heading","level":3,"spans":[{"id":"spn-102853","text":"OS-007: Adversarial Robustness"}]},{"id":"blk-71722","kind":"paragraph","spans":[{"id":"spn-102854","text":"Defense against prompt injection, model poisoning, side-channel attacks, identity spoofing, and resource exhaustion. Specification-stage protocol."}]},{"id":"blk-71723","kind":"heading","level":3,"spans":[{"id":"spn-102855","text":"OS-008: Agent Harness"}]},{"id":"blk-71724","kind":"paragraph","spans":[{"id":"spn-102856","text":"Pipeline enforcement above governance. Two enforced pipelines (reactive: "},{"id":"spn-102857","marks":["code"],"text":"query → recall → topology → deliberate → store"},{"id":"spn-102858","text":"; sprint: planner → generator → evaluator → commit). Quality gates with adversarial grading. Sprint contracts with acceptance criteria. Context management with 60% utilization threshold. Grounded in Norman & Shallice's Supervisory Attentional System."}]},{"id":"blk-71725","kind":"heading","level":3,"spans":[{"id":"spn-102859","text":"OS-009: PRISM"}]},{"id":"blk-71726","kind":"paragraph","spans":[{"id":"spn-102860","marks":["bold"],"text":"Protocol for Rating Iterative System Memory."},{"id":"spn-102861","text":" The first self-improving continual learning benchmark. Measures 9 CL dimensions (retrieval, transfer, uncertainty, feedback integration, forgetting, consolidation, temporal reasoning, multi-agent deliberation, composition). Four-phase evaluation loop: compose → interact → observe → reflect → diagnose. Features BYOR (Bring Your Own Repo), IRT calibration, three-layer judging, closed-loop verification, leaderboards, and actionable diagnostics."}]},{"id":"blk-71727","kind":"heading","level":3,"spans":[{"id":"spn-102862","text":"OS-010: PULSE"}]},{"id":"blk-71728","kind":"paragraph","spans":[{"id":"spn-102863","marks":["bold"],"text":"Protocol for Uniform Loop State Exchange."},{"id":"spn-102864","text":" Temporal algebra declaring how loops cycle, nest, and signal. Five canonical phase kinds (retrieve, route, act, learn, consolidate). Six cadence types (event, periodic, streaming, idle, cross_loop_signal, manual). Five canonical cross-loop tokens via CloudEvents v1.0 envelopes. BYOL (Bring Your Own Loop) — any system publishing a conforming manifest is automatically PRISM-evaluable."}]},{"id":"blk-71729","kind":"heading","level":2,"spans":[{"id":"spn-102865","text":"Architecture"}]},{"id":"blk-71730","kind":"heading","level":3,"spans":[{"id":"spn-102866","text":"Governance Shim (OS-006) — OTP Supervision Tree"}]},{"id":"blk-71731","kind":"code","language":"text","text":"OpenSentience.Application\n├── OpenSentience.PermissionEngine     (GenServer + ETS — deny-by-default policy)\n├── OpenSentience.AuditWriter          (GenServer — batched append-only)\n├── OpenSentience.AutonomyController   (GenServer + ETS — observe/advise/act)\n├── OpenSentience.AgentSupervisor      (DynamicSupervisor)\n│   ├── AgentLifecycle \"agent-001\"     (GenStateMachine → wraps real process)\n│   ├── AgentLifecycle \"agent-002\"\n│   └── ...\n├── OpenSentience.MCP.Server           (Hermes MCP — governance tools)\n└── OpenSentience.Telemetry            (telemetry handler)"},{"id":"blk-71732","kind":"heading","level":3,"spans":[{"id":"spn-102867","text":"Triple-Loop Nesting"}]},{"id":"blk-71733","kind":"paragraph","spans":[{"id":"spn-102868","text":"The reference [&] ecosystem operates with three nested closed loops:"}]},{"id":"blk-71734","kind":"code","language":"text","text":"PRISM (outer)              compose → interact → observe → reflect → diagnose\n  │\n  └─ Graphonomous         retrieve → route → act → learn → consolidate\n       │\n       └─ Deliberation    survey → triage → dispatch → act → learn"},{"id":"blk-71735","kind":"paragraph","spans":[{"id":"spn-102869","text":"PULSE manifests encode this nesting declaratively."}]},{"id":"blk-71736","kind":"heading","level":2,"spans":[{"id":"spn-102870","text":"Cognitive Science Grounding"}]},{"id":"blk-71737","kind":"paragraph","spans":[{"id":"spn-102871","text":"Every protocol maps to published research:"}]},{"head":[{"id":"blk-71739","spans":[{"id":"spn-102872","text":"Protocol"}]},{"id":"blk-71740","spans":[{"id":"spn-102873","text":"Theory"}]},{"id":"blk-71741","spans":[{"id":"spn-102874","text":"Key Reference"}]}],"id":"blk-71738","kind":"table","rows":[[{"id":"blk-71742","spans":[{"id":"spn-102875","text":"OS-001"}]},{"id":"blk-71743","spans":[{"id":"spn-102876","text":"Hippocampal consolidation"}]},{"id":"blk-71744","spans":[{"id":"spn-102877","text":"McClelland et al. 1995"}]}],[{"id":"blk-71745","spans":[{"id":"spn-102878","text":"OS-002"}]},{"id":"blk-71746","spans":[{"id":"spn-102879","text":"Working memory gating"}]},{"id":"blk-71747","spans":[{"id":"spn-102880","text":"O'Reilly & Frank 2006"}]}],[{"id":"blk-71748","spans":[{"id":"spn-102881","text":"OS-003"}]},{"id":"blk-71749","spans":[{"id":"spn-102882","text":"Dual-process theory"}]},{"id":"blk-71750","spans":[{"id":"spn-102883","text":"Kahneman 2011"}]}],[{"id":"blk-71751","spans":[{"id":"spn-102884","text":"OS-004"}]},{"id":"blk-71752","spans":[{"id":"spn-102885","text":"Endogenous attention"}]},{"id":"blk-71753","spans":[{"id":"spn-102886","text":"Desimone & Duncan 1995"}]}],[{"id":"blk-71754","spans":[{"id":"spn-102887","text":"OS-005"}]},{"id":"blk-71755","spans":[{"id":"spn-102888","text":"Resource rationality"}]},{"id":"blk-71756","spans":[{"id":"spn-102889","text":"Lieder & Griffiths 2020"}]}],[{"id":"blk-71757","spans":[{"id":"spn-102890","text":"OS-006"}]},{"id":"blk-71758","spans":[{"id":"spn-102891","text":"Executive function"}]},{"id":"blk-71759","spans":[{"id":"spn-102892","text":"Miyake et al. 2000"}]}],[{"id":"blk-71760","spans":[{"id":"spn-102893","text":"OS-007"}]},{"id":"blk-71761","spans":[{"id":"spn-102894","text":"Immune system analogy"}]},{"id":"blk-71762","spans":[{"id":"spn-102895","text":"—"}]}],[{"id":"blk-71763","spans":[{"id":"spn-102896","text":"OS-008"}]},{"id":"blk-71764","spans":[{"id":"spn-102897","text":"Supervisory attentional system"}]},{"id":"blk-71765","spans":[{"id":"spn-102898","text":"Norman & Shallice 1986"}]}],[{"id":"blk-71766","spans":[{"id":"spn-102899","text":"OS-009"}]},{"id":"blk-71767","spans":[{"id":"spn-102900","text":"Meta-cognition + IRT"}]},{"id":"blk-71768","spans":[{"id":"spn-102901","text":"Signal detection theory"}]}],[{"id":"blk-71769","spans":[{"id":"spn-102902","text":"OS-010"}]},{"id":"blk-71770","spans":[{"id":"spn-102903","text":"Closed-loop control + temporal cognition"}]},{"id":"blk-71771","spans":[{"id":"spn-102904","text":"Wiener 1948"}]}]]},{"id":"blk-71772","kind":"heading","level":2,"spans":[{"id":"spn-102905","text":"Empirical Results (OS-E001)"}]},{"id":"blk-71773","kind":"paragraph","spans":[{"id":"spn-102906","text":"Benchmark of Graphonomous v0.3.3 on the full [&] portfolio (18,165 files across 14 projects):"}]},{"head":[{"id":"blk-71775","spans":[{"id":"spn-102907","text":"Metric"}]},{"id":"blk-71776","spans":[{"id":"spn-102908","text":"Result"}]}],"id":"blk-71774","kind":"table","rows":[[{"id":"blk-71777","spans":[{"id":"spn-102909","text":"QA proxy accuracy (LongMemEval, 500 questions)"}]},{"id":"blk-71778","spans":[{"id":"spn-102910","text":"92.6%"}]}],[{"id":"blk-71779","spans":[{"id":"spn-102911","text":"Session hit rate"}]},{"id":"blk-71780","spans":[{"id":"spn-102912","text":"98.7%"}]}],[{"id":"blk-71781","spans":[{"id":"spn-102913","text":"Mean retrieval latency"}]},{"id":"blk-71782","spans":[{"id":"spn-102914","text":"1.4s"}]}],[{"id":"blk-71783","spans":[{"id":"spn-102915","text":"F1 gain from graph-expanded retrieval vs flat"}]},{"id":"blk-71784","spans":[{"id":"spn-102916","text":"+0.024"}]}],[{"id":"blk-71785","spans":[{"id":"spn-102917","text":"Recall gain from graph-expanded retrieval"}]},{"id":"blk-71786","spans":[{"id":"spn-102918","text":"+0.103"}]}],[{"id":"blk-71787","spans":[{"id":"spn-102919","text":"Automated edges extracted"}]},{"id":"blk-71788","spans":[{"id":"spn-102920","text":"12,871"}]}],[{"id":"blk-71789","spans":[{"id":"spn-102921","text":"Naturally occurring SCCs"}]},{"id":"blk-71790","spans":[{"id":"spn-102922","text":"22 (max κ=27)"}]}],[{"id":"blk-71791","spans":[{"id":"spn-102923","text":"κ detection accuracy"}]},{"id":"blk-71792","spans":[{"id":"spn-102924","text":"100% at 27K-node scale"}]}],[{"id":"blk-71793","spans":[{"id":"spn-102925","text":"Test pass rate"}]},{"id":"blk-71794","spans":[{"id":"spn-102926","text":"455/455 (100%)"}]}],[{"id":"blk-71795","spans":[{"id":"spn-102927","text":"Consolidation throughput"}]},{"id":"blk-71796","spans":[{"id":"spn-102928","text":"~27.1M nodes/sec"}]}],[{"id":"blk-71797","spans":[{"id":"spn-102929","text":"Abstention accuracy (learned ANN threshold)"}]},{"id":"blk-71798","spans":[{"id":"spn-102930","text":"96.7%"}]}]]},{"id":"blk-71799","kind":"paragraph","spans":[{"id":"spn-102931","text":"Full results: "},{"id":"spn-102932","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"}],"text":"`docs/spec/OS-E001-EMPIRICAL-EVALUATION.md`"}]},{"id":"blk-71800","kind":"heading","level":2,"spans":[{"id":"spn-102933","text":"κ Proof"}]},{"id":"blk-71801","kind":"paragraph","spans":[{"id":"spn-102934","marks":[{"kind":"link","predicate":"cites","target":"kappa_proof.js"}],"text":"`kappa_proof.js`"},{"id":"spn-102935","text":" is a browser-runnable proof verifying the κ-routing theorem across "},{"id":"spn-102936","marks":["bold"],"text":"1,926,351 test cases"},{"id":"spn-102937","text":":"}]},{"id":"blk-71802","items":[{"blocks":[{"id":"blk-71804","kind":"paragraph","spans":[{"id":"spn-102938","text":"1,052,740 directed graphs (n=2–5): κ(G) > 0 ⟺ β₁(G) > 0 ⟺ nontrivial SCC"}]}],"id":"blk-71803","kind":"list-item"},{"blocks":[{"id":"blk-71806","kind":"paragraph","spans":[{"id":"spn-102939","text":"873,611 finite dynamical systems (n=2–7): κ(f) > 0 ⟺ periodic orbit (period > 1)"}]}],"id":"blk-71805","kind":"list-item"},{"blocks":[{"id":"blk-71808","kind":"paragraph","spans":[{"id":"spn-102940","marks":["bold"],"text":"Zero counterexamples"}]}],"id":"blk-71807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71809","kind":"heading","level":2,"spans":[{"id":"spn-102941","text":"Repository Structure"}]},{"id":"blk-71810","kind":"code","language":"text","text":"opensentience.org/\n├── docs/\n│   ├── spec/\n│   │   ├── README.md                       # Master spec — all 10 protocols (source of truth)\n│   │   ├── OS-008-HARNESS.md               # Agent Harness Protocol\n│   │   ├── OS-009-PRISM-SPECIFICATION.md   # PRISM benchmark engine spec\n│   │   ├── OS-010-PULSE-SPECIFICATION.md   # PULSE loop manifest spec\n│   │   └── OS-E001-EMPIRICAL-EVALUATION.md # Empirical benchmark results\n│   ├── skills/                             # Agent skill guides (8 numbered modules)\n│   ├── index.md                            # ReadTheDocs homepage\n│   ├── architecture.md                     # OTP supervision tree details\n│   ├── ecosystem-overview.md               # 10 protocols + 12 product relationships\n│   ├── positioning.md                      # Governance stack & market positioning\n│   ├── competitive-landscape.md            # Comparison with CrewAI, LangGraph, etc.\n│   ├── harness-engineering.md              # Pipeline enforcement deep-dive\n│   ├── runtime-walkthrough.md              # Concrete agent lifecycle walkthrough\n│   ├── comparison-table.md                 # Feature matrix vs alternatives\n│   ├── research.md                         # Cognitive science grounding (7+ hours)\n│   ├── quickstart.md                       # Elixir integration guide\n│   ├── faq.md                              # Common questions\n│   ├── conf.py                             # Sphinx configuration\n│   └── requirements.txt                    # sphinx>=8, myst-parser>=4\n├── index.html                              # Marketing landing page\n├── kappa_proof.js                          # Browser-runnable κ proof (1.9M test cases)\n├── CLAUDE.md                               # Agent context\n├── AGENTS.md                               # Agent interface guide\n├── .readthedocs.yaml                       # ReadTheDocs build config\n└── old_scrap/                              # Historical v1/v2 iterations (not current)"},{"id":"blk-71811","kind":"heading","level":2,"spans":[{"id":"spn-102942","text":"Technology Stack"}]},{"head":[{"id":"blk-71813","spans":[{"id":"spn-102943","text":"Layer"}]},{"id":"blk-71814","spans":[{"