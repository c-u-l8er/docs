{"bendscript":"0.1","blocks":[{"id":"blk-71761","kind":"heading","level":1,"spans":[{"id":"spn-102928","text":"OpenSentience"}]},{"id":"blk-71762","kind":"paragraph","spans":[{"id":"spn-102929","marks":["bold"],"text":"Open research protocols for machine cognition, structured memory, deliberation topology, and agent governance."}]},{"id":"blk-71763","kind":"paragraph","spans":[{"id":"spn-102930","text":"Published by "},{"id":"spn-102931","marks":[{"kind":"link","predicate":"cites","target":"https://ampersandboxdesign.com"}],"text":"Ampersand Box Design"},{"id":"spn-102932","text":" under the [&] Protocol ecosystem."}]},{"blocks":[{"id":"blk-71765","kind":"paragraph","spans":[{"id":"spn-102933","text":"\"Intelligence is not generation. It is structured accumulation.\""}]}],"id":"blk-71764","kind":"quote"},{"id":"blk-71766","kind":"paragraph","spans":[{"id":"spn-102934","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/license-Apache%202.0-blue.svg"}],"text":"![License"},{"id":"spn-102935","text":"](https://www.apache.org/licenses/LICENSE-2.0) "},{"id":"spn-102936","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/spec-v0.1%20draft-orange.svg"}],"text":"![Spec Status"},{"id":"spn-102937","text":"]() "},{"id":"spn-102938","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/docs-ReadTheDocs-informational.svg"}],"text":"![Docs"},{"id":"spn-102939","text":"]() "},{"id":"spn-102940","marks":[{"kind":"link","predicate":"cites","target":"https://img.shields.io/badge/stack-Elixir%20%7C%20OTP-purple.svg"}],"text":"![Stack"},{"id":"spn-102941","text":"]()"}]},{"id":"blk-71767","kind":"heading","level":2,"spans":[{"id":"spn-102942","text":"What is OpenSentience?"}]},{"id":"blk-71768","kind":"paragraph","spans":[{"id":"spn-102943","text":"OpenSentience is the "},{"id":"spn-102944","marks":["bold"],"text":"research arm"},{"id":"spn-102945","text":" of the [&] Protocol ecosystem. It is "},{"id":"spn-102946","marks":["bold"],"text":"not a product"},{"id":"spn-102947","text":" — it is a research organization that publishes:"}]},{"id":"blk-71769","items":[{"blocks":[{"id":"blk-71771","kind":"paragraph","spans":[{"id":"spn-102948","marks":["bold"],"text":"Ten numbered protocols"},{"id":"spn-102949","text":" (OS-001 through OS-010) — each defining one cognitive capability or cross-cutting concern, grounded in cognitive science"}]}],"id":"blk-71770","kind":"list-item"},{"blocks":[{"id":"blk-71773","kind":"paragraph","spans":[{"id":"spn-102950","marks":["bold"],"text":"Three runtime artifacts"},{"id":"spn-102951","text":" — a governance shim (OS-006), a benchmark engine (OS-009 PRISM), and a loop manifest standard (OS-010 PULSE)"}]}],"id":"blk-71772","kind":"list-item"},{"blocks":[{"id":"blk-71775","kind":"paragraph","spans":[{"id":"spn-102952","marks":["bold"],"text":"Published research"},{"id":"spn-102953","text":" — cognitive science grounding, empirical benchmarks, and open questions"}]}],"id":"blk-71774","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-71776","kind":"paragraph","spans":[{"id":"spn-102954","text":"Other [&] portfolio products implement the protocols. OpenSentience defines them, grounds them in theory, and provides the thin enforcement layer that ties them together at runtime."}]},{"id":"blk-71777","kind":"heading","level":2,"spans":[{"id":"spn-102955","text":"The Ten Protocols"}]},{"id":"blk-71778","kind":"paragraph","spans":[{"id":"spn-102956","text":"Eight "},{"id":"spn-102957","marks":["bold"],"text":"cognitive primitives"},{"id":"spn-102958","text":" (OS-001–OS-008) plus two "},{"id":"spn-102959","marks":["bold"],"text":"cross-cutting protocols"},{"id":"spn-102960","text":" (OS-009, OS-010):"}]},{"head":[{"id":"blk-71780","spans":[{"id":"spn-102961","text":"ID"}]},{"id":"blk-71781","spans":[{"id":"spn-102962","text":"Protocol"}]},{"id":"blk-71782","spans":[{"id":"spn-102963","text":"[&] Primitive"}]},{"id":"blk-71783","spans":[{"id":"spn-102964","text":"Status"}]},{"id":"blk-71784","spans":[{"id":"spn-102965","text":"Implementation"}]}],"id":"blk-71779","kind":"table","rows":[[{"id":"blk-71785","spans":[{"id":"spn-102966","text":"OS-001"}]},{"id":"blk-71786","spans":[{"id":"spn-102967","text":"Continual Learning"}]},{"id":"blk-71787","spans":[{"id":"spn-102968","marks":["code"],"text":"&memory.graph"}]},{"id":"blk-71788","spans":[{"id":"spn-102969","text":"v0.3.3 shipped"}]},{"id":"blk-71789","spans":[{"id":"spn-102970","marks":[{"kind":"link","predicate":"cites","target":"../graphonomous/"}],"text":"Graphonomous"}]}],[{"id":"blk-71790","spans":[{"id":"spn-102971","text":"OS-002"}]},{"id":"blk-71791","spans":[{"id":"spn-102972","text":"Topological Routing (κ)"}]},{"id":"blk-71792","spans":[{"id":"spn-102973","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-71793","spans":[{"id":"spn-102974","text":"Spec complete"}]},{"id":"blk-71794","spans":[{"id":"spn-102975","text":"Graphonomous routing layer"}]}],[{"id":"blk-71795","spans":[{"id":"spn-102976","text":"OS-003"}]},{"id":"blk-71796","spans":[{"id":"spn-102977","text":"Deliberation Orchestrator"}]},{"id":"blk-71797","spans":[{"id":"spn-102978","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-71798","spans":[{"id":"spn-102979","text":"Spec complete"}]},{"id":"blk-71799","spans":[{"id":"spn-102980","text":"AgenTroMatic"}]}],[{"id":"blk-71800","spans":[{"id":"spn-102981","text":"OS-004"}]},{"id":"blk-71801","spans":[{"id":"spn-102982","text":"Attention Engine"}]},{"id":"blk-71802","spans":[{"id":"spn-102983","text":"meta-reasoning"}]},{"id":"blk-71803","spans":[{"id":"spn-102984","text":"Spec complete"}]},{"id":"blk-71804","spans":[{"id":"spn-102985","text":"Graphonomous attention module"}]}],[{"id":"blk-71805","spans":[{"id":"spn-102986","text":"OS-005"}]},{"id":"blk-71806","spans":[{"id":"spn-102987","text":"Model Tier Adaptation"}]},{"id":"blk-71807","spans":[{"id":"spn-102988","text":"system"}]},{"id":"blk-71808","spans":[{"id":"spn-102989","text":"Spec complete"}]},{"id":"blk-71809","spans":[{"id":"spn-102990","text":"Graphonomous / Agentelic"}]}],[{"id":"blk-71810","spans":[{"id":"spn-102991","text":"OS-006"}]},{"id":"blk-71811","spans":[{"id":"spn-102992","text":"Agent Governance Shim"}]},{"id":"blk-71812","spans":[{"id":"spn-102993","text":"governance"}]},{"id":"blk-71813","spans":[{"id":"spn-102994","text":"In development"}]},{"id":"blk-71814","spans":[{"id":"spn-102995","marks":["code"],"text":"open_sentience"},{"id":"spn-102996","text":" hex package"}]}],[{"id":"blk-71815","spans":[{"id":"spn-102997","text":"OS-007"}]},{"id":"blk-71816","spans":[{"id":"spn-102998","text":"Adversarial Robustness"}]},{"id":"blk-71817","spans":[{"id":"spn-102999","marks":["code"],"text":"&govern.identity"}]},{"id":"blk-71818","spans":[{"id":"spn-103000","text":"Draft"}]},{"id":"blk-71819","spans":[{"id":"spn-103001","text":"OpenSentience security module"}]}],[{"id":"blk-71820","spans":[{"id":"spn-103002","text":"OS-008"}]},{"id":"blk-71821","spans":[{"id":"spn-103003","text":"Agent Harness"}]},{"id":"blk-71822","spans":[{"id":"spn-103004","marks":["code"],"text":"&govern.harness"}]},{"id":"blk-71823","spans":[{"id":"spn-103005","text":"Draft"}]},{"id":"blk-71824","spans":[{"id":"spn-103006","text":"OpenSentience harness module"}]}],[{"id":"blk-71825","spans":[{"id":"spn-103007","marks":["bold"],"text":"OS-009"}]},{"id":"blk-71826","spans":[{"id":"spn-103008","marks":["bold"],"text":"PRISM"},{"id":"spn-103009","text":" (Rating Iterative System Memory)"}]},{"id":"blk-71827","spans":[{"id":"spn-103010","marks":["code"],"text":"&memory + &reason"}]},{"id":"blk-71828","spans":[{"id":"spn-103011","text":"v3.0 in development"}]},{"id":"blk-71829","spans":[{"id":"spn-103012","marks":[{"kind":"link","predicate":"cites","target":"../PRISM/"}],"text":"`/PRISM/`"},{"id":"spn-103013","text":" — Fly.io deploy"}]}],[{"id":"blk-71830","spans":[{"id":"spn-103014","marks":["bold"],"text":"OS-010"}]},{"id":"blk-71831","spans":[{"id":"spn-103015","marks":["bold"],"text":"PULSE"},{"id":"spn-103016","text":" (Uniform Loop State Exchange)"}]},{"id":"blk-71832","spans":[{"id":"spn-103017","marks":["code"],"text":"&memory + &govern + &time"}]},{"id":"blk-71833","spans":[{"id":"spn-103018","text":"v0.1 draft"}]},{"id":"blk-71834","spans":[{"id":"spn-103019","marks":[{"kind":"link","predicate":"cites","target":"../PULSE/"}],"text":"`/PULSE/`"},{"id":"spn-103020","text":" — manifest standard"}]}]]},{"id":"blk-71835","kind":"heading","level":3,"spans":[{"id":"spn-103021","text":"The Three-Protocol Stack"}]},{"id":"blk-71836","kind":"code","language":"text","text":"┌──────────────────────────────────────────────────────────┐\n│  PRISM (OS-009)  — measures loops over time   diagnostic │\n├──────────────────────────────────────────────────────────┤\n│  PULSE (OS-010)  — declares loops + signals    temporal  │\n├──────────────────────────────────────────────────────────┤\n│  OS-001 … OS-008 — cognitive primitives       capability │\n├──────────────────────────────────────────────────────────┤\n│  [&]             — composes capabilities      structural │\n└──────────────────────────────────────────────────────────┘"},{"id":"blk-71837","items":[{"blocks":[{"id":"blk-71839","kind":"paragraph","spans":[{"id":"spn-103022","marks":["bold"],"text":"[&]"},{"id":"spn-103023","text":" composes agents ("},{"id":"spn-103024","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-103025","text":") — structural layer"}]}],"id":"blk-71838","kind":"list-item"},{"blocks":[{"id":"blk-71841","kind":"paragraph","spans":[{"id":"spn-103026","marks":["bold"],"text":"PULSE"},{"id":"spn-103027","text":" gives them a heartbeat ("},{"id":"spn-103028","marks":["code"],"text":"*.pulse.json"},{"id":"spn-103029","text":") — temporal layer"}]}],"id":"blk-71840","kind":"list-item"},{"blocks":[{"id":"blk-71843","kind":"paragraph","spans":[{"id":"spn-103030","marks":["bold"],"text":"PRISM"},{"id":"spn-103031","text":" measures their effect — diagnostic layer"}]}],"id":"blk-71842","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71844","kind":"paragraph","spans":[{"id":"spn-103032","text":"Each protocol is independent. Adoption order is typically [&] → PULSE → PRISM."}]},{"id":"blk-71845","kind":"heading","level":2,"spans":[{"id":"spn-103033","text":"Protocol Summaries"}]},{"id":"blk-71846","kind":"heading","level":3,"spans":[{"id":"spn-103034","text":"OS-001: Continual Learning"}]},{"id":"blk-71847","kind":"paragraph","spans":[{"id":"spn-103035","text":"Hippocampal consolidation-inspired memory. Self-evolving knowledge graph with four node types (episodic, semantic, procedural, temporal), typed/weighted/decaying edges, multi-timescale consolidation, and no model weight modification — all learning is graph-structural."}]},{"id":"blk-71848","kind":"heading","level":3,"spans":[{"id":"spn-103036","text":"OS-002: Topological Routing (κ-Routing)"}]},{"id":"blk-71849","kind":"paragraph","spans":[{"id":"spn-103037","text":"Routes queries through knowledge graphs using topological structure, not just embedding similarity. The κ parameter balances exploitation (κ=0, follow strong edges) vs exploration (κ→∞, random walk). Inspired by prefrontal cortex working memory gating."}]},{"id":"blk-71850","kind":"heading","level":3,"spans":[{"id":"spn-103038","text":"OS-003: Deliberation Orchestrator"}]},{"id":"blk-71851","kind":"paragraph","spans":[{"id":"spn-103039","text":"Multi-agent consensus through structured phases: bid → debate → vote → commit. Uses weighted bipolar argumentation, Raft fast-path for agreement, PBFT for Byzantine tolerance, and reputation-weighted bid credibility. Maps to Kahneman's System 2."}]},{"id":"blk-71852","kind":"heading","level":3,"spans":[{"id":"spn-103040","text":"OS-004: Attention Engine"}]},{"id":"blk-71853","kind":"paragraph","spans":[{"id":"spn-103041","text":"Three-phase proactive attention cycle — survey (scan all sources, produce salience map) → triage (rank by urgency/novelty/goals) → dispatch (route to pipelines). Runs continuously with adaptive frequency. Grounded in endogenous top-down attention."}]},{"id":"blk-71854","kind":"heading","level":3,"spans":[{"id":"spn-103042","text":"OS-005: Model Tier Adaptation"}]},{"id":"blk-71855","kind":"paragraph","spans":[{"id":"spn-103043","text":"Graduated model selection across three tiers: "},{"id":"spn-103044","marks":["code"],"text":"local_small"},{"id":"spn-103045","text":" (1B–3B), "},{"id":"spn-103046","marks":["code"],"text":"local_large"},{"id":"spn-103047","text":" (7B–14B), "},{"id":"spn-103048","marks":["code"],"text":"cloud_frontier"},{"id":"spn-103049","text":" (70B+/API). Escalates when confidence falls below threshold; de-escalates by caching successful patterns as procedures. Based on resource rationality theory."}]},{"id":"blk-71856","kind":"heading","level":3,"spans":[{"id":"spn-103050","text":"OS-006: Agent Governance Shim"}]},{"id":"blk-71857","kind":"paragraph","spans":[{"id":"spn-103051","text":"The only protocol OpenSentience implements directly. Deny-by-default permissions, five lifecycle states (installed → enabled → running → disabled → removed), three autonomy levels (observe / advise / act), append-only audit trail. ETS-backed lookups at microsecond latency. Ships as the "},{"id":"spn-103052","marks":["code"],"text":"open_sentience"},{"id":"spn-103053","text":" hex package."}]},{"id":"blk-71858","kind":"heading","level":3,"spans":[{"id":"spn-103054","text":"OS-007: Adversarial Robustness"}]},{"id":"blk-71859","kind":"paragraph","spans":[{"id":"spn-103055","text":"Defense against prompt injection, model poisoning, side-channel attacks, identity spoofing, and resource exhaustion. Specification-stage protocol."}]},{"id":"blk-71860","kind":"heading","level":3,"spans":[{"id":"spn-103056","text":"OS-008: Agent Harness"}]},{"id":"blk-71861","kind":"paragraph","spans":[{"id":"spn-103057","text":"Pipeline enforcement above governance. Two enforced pipelines (reactive: "},{"id":"spn-103058","marks":["code"],"text":"query → recall → topology → deliberate → store"},{"id":"spn-103059","text":"; sprint: planner → generator → evaluator → commit). Quality gates with adversarial grading. Sprint contracts with acceptance criteria. Context management with 60% utilization threshold. Grounded in Norman & Shallice's Supervisory Attentional System."}]},{"id":"blk-71862","kind":"heading","level":3,"spans":[{"id":"spn-103060","text":"OS-009: PRISM"}]},{"id":"blk-71863","kind":"paragraph","spans":[{"id":"spn-103061","marks":["bold"],"text":"Protocol for Rating Iterative System Memory."},{"id":"spn-103062","text":" The first self-improving continual learning benchmark. Measures 9 CL dimensions (retrieval, transfer, uncertainty, feedback integration, forgetting, consolidation, temporal reasoning, multi-agent deliberation, composition). Four-phase evaluation loop: compose → interact → observe → reflect → diagnose. Features BYOR (Bring Your Own Repo), IRT calibration, three-layer judging, closed-loop verification, leaderboards, and actionable diagnostics."}]},{"id":"blk-71864","kind":"heading","level":3,"spans":[{"id":"spn-103063","text":"OS-010: PULSE"}]},{"id":"blk-71865","kind":"paragraph","spans":[{"id":"spn-103064","marks":["bold"],"text":"Protocol for Uniform Loop State Exchange."},{"id":"spn-103065","text":" Temporal algebra declaring how loops cycle, nest, and signal. Five canonical phase kinds (retrieve, route, act, learn, consolidate). Six cadence types (event, periodic, streaming, idle, cross_loop_signal, manual). Five canonical cross-loop tokens via CloudEvents v1.0 envelopes. BYOL (Bring Your Own Loop) — any system publishing a conforming manifest is automatically PRISM-evaluable."}]},{"id":"blk-71866","kind":"heading","level":2,"spans":[{"id":"spn-103066","text":"Architecture"}]},{"id":"blk-71867","kind":"heading","level":3,"spans":[{"id":"spn-103067","text":"Governance Shim (OS-006) — OTP Supervision Tree"}]},{"id":"blk-71868","kind":"code","language":"text","text":"OpenSentience.Application\n├── OpenSentience.PermissionEngine     (GenServer + ETS — deny-by-default policy)\n├── OpenSentience.AuditWriter          (GenServer — batched append-only)\n├── OpenSentience.AutonomyController   (GenServer + ETS — observe/advise/act)\n├── OpenSentience.AgentSupervisor      (DynamicSupervisor)\n│   ├── AgentLifecycle \"agent-001\"     (GenStateMachine → wraps real process)\n│   ├── AgentLifecycle \"agent-002\"\n│   └── ...\n├── OpenSentience.MCP.Server           (Hermes MCP — governance tools)\n└── OpenSentience.Telemetry            (telemetry handler)"},{"id":"blk-71869","kind":"heading","level":3,"spans":[{"id":"spn-103068","text":"Triple-Loop Nesting"}]},{"id":"blk-71870","kind":"paragraph","spans":[{"id":"spn-103069","text":"The reference [&] ecosystem operates with three nested closed loops:"}]},{"id":"blk-71871","kind":"code","language":"text","text":"PRISM (outer)              compose → interact → observe → reflect → diagnose\n  │\n  └─ Graphonomous         retrieve → route → act → learn → consolidate\n       │\n       └─ Deliberation    survey → triage → dispatch → act → learn"},{"id":"blk-71872","kind":"paragraph","spans":[{"id":"spn-103070","text":"PULSE manifests encode this nesting declaratively."}]},{"id":"blk-71873","kind":"heading","level":2,"spans":[{"id":"spn-103071","text":"Cognitive Science Grounding"}]},{"id":"blk-71874","kind":"paragraph","spans":[{"id":"spn-103072","text":"Every protocol maps to published research:"}]},{"head":[{"id":"blk-71876","spans":[{"id":"spn-103073","text":"Protocol"}]},{"id":"blk-71877","spans":[{"id":"spn-103074","text":"Theory"}]},{"id":"blk-71878","spans":[{"id":"spn-103075","text":"Key Reference"}]}],"id":"blk-71875","kind":"table","rows":[[{"id":"blk-71879","spans":[{"id":"spn-103076","text":"OS-001"}]},{"id":"blk-71880","spans":[{"id":"spn-103077","text":"Hippocampal consolidation"}]},{"id":"blk-71881","spans":[{"id":"spn-103078","text":"McClelland et al. 1995"}]}],[{"id":"blk-71882","spans":[{"id":"spn-103079","text":"OS-002"}]},{"id":"blk-71883","spans":[{"id":"spn-103080","text":"Working memory gating"}]},{"id":"blk-71884","spans":[{"id":"spn-103081","text":"O'Reilly & Frank 2006"}]}],[{"id":"blk-71885","spans":[{"id":"spn-103082","text":"OS-003"}]},{"id":"blk-71886","spans":[{"id":"spn-103083","text":"Dual-process theory"}]},{"id":"blk-71887","spans":[{"id":"spn-103084","text":"Kahneman 2011"}]}],[{"id":"blk-71888","spans":[{"id":"spn-103085","text":"OS-004"}]},{"id":"blk-71889","spans":[{"id":"spn-103086","text":"Endogenous attention"}]},{"id":"blk-71890","spans":[{"id":"spn-103087","text":"Desimone & Duncan 1995"}]}],[{"id":"blk-71891","spans":[{"id":"spn-103088","text":"OS-005"}]},{"id":"blk-71892","spans":[{"id":"spn-103089","text":"Resource rationality"}]},{"id":"blk-71893","spans":[{"id":"spn-103090","text":"Lieder & Griffiths 2020"}]}],[{"id":"blk-71894","spans":[{"id":"spn-103091","text":"OS-006"}]},{"id":"blk-71895","spans":[{"id":"spn-103092","text":"Executive function"}]},{"id":"blk-71896","spans":[{"id":"spn-103093","text":"Miyake et al. 2000"}]}],[{"id":"blk-71897","spans":[{"id":"spn-103094","text":"OS-007"}]},{"id":"blk-71898","spans":[{"id":"spn-103095","text":"Immune system analogy"}]},{"id":"blk-71899","spans":[{"id":"spn-103096","text":"—"}]}],[{"id":"blk-71900","spans":[{"id":"spn-103097","text":"OS-008"}]},{"id":"blk-71901","spans":[{"id":"spn-103098","text":"Supervisory attentional system"}]},{"id":"blk-71902","spans":[{"id":"spn-103099","text":"Norman & Shallice 1986"}]}],[{"id":"blk-71903","spans":[{"id":"spn-103100","text":"OS-009"}]},{"id":"blk-71904","spans":[{"id":"spn-103101","text":"Meta-cognition + IRT"}]},{"id":"blk-71905","spans":[{"id":"spn-103102","text":"Signal detection theory"}]}],[{"id":"blk-71906","spans":[{"id":"spn-103103","text":"OS-010"}]},{"id":"blk-71907","spans":[{"id":"spn-103104","text":"Closed-loop control + temporal cognition"}]},{"id":"blk-71908","spans":[{"id":"spn-103105","text":"Wiener 1948"}]}]]},{"id":"blk-71909","kind":"heading","level":2,"spans":[{"id":"spn-103106","text":"Empirical Results (OS-E001)"}]},{"id":"blk-71910","kind":"paragraph","spans":[{"id":"spn-103107","text":"Benchmark of Graphonomous v0.3.3 on the full [&] portfolio (18,165 files across 14 projects):"}]},{"head":[{"id":"blk-71912","spans":[{"id":"spn-103108","text":"Metric"}]},{"id":"blk-71913","spans":[{"id":"spn-103109","text":"Result"}]}],"id":"blk-71911","kind":"table","rows":[[{"id":"blk-71914","spans":[{"id":"spn-103110","text":"QA proxy accuracy (LongMemEval, 500 questions)"}]},{"id":"blk-71915","spans":[{"id":"spn-103111","text":"92.6%"}]}],[{"id":"blk-71916","spans":[{"id":"spn-103112","text":"Session hit rate"}]},{"id":"blk-71917","spans":[{"id":"spn-103113","text":"98.7%"}]}],[{"id":"blk-71918","spans":[{"id":"spn-103114","text":"Mean retrieval latency"}]},{"id":"blk-71919","spans":[{"id":"spn-103115","text":"1.4s"}]}],[{"id":"blk-71920","spans":[{"id":"spn-103116","text":"F1 gain from graph-expanded retrieval vs flat"}]},{"id":"blk-71921","spans":[{"id":"spn-103117","text":"+0.024"}]}],[{"id":"blk-71922","spans":[{"id":"spn-103118","text":"Recall gain from graph-expanded retrieval"}]},{"id":"blk-71923","spans":[{"id":"spn-103119","text":"+0.103"}]}],[{"id":"blk-71924","spans":[{"id":"spn-103120","text":"Automated edges extracted"}]},{"id":"blk-71925","spans":[{"id":"spn-103121","text":"12,871"}]}],[{"id":"blk-71926","spans":[{"id":"spn-103122","text":"Naturally occurring SCCs"}]},{"id":"blk-71927","spans":[{"id":"spn-103123","text":"22 (max κ=27)"}]}],[{"id":"blk-71928","spans":[{"id":"spn-103124","text":"κ detection accuracy"}]},{"id":"blk-71929","spans":[{"id":"spn-103125","text":"100% at 27K-node scale"}]}],[{"id":"blk-71930","spans":[{"id":"spn-103126","text":"Test pass rate"}]},{"id":"blk-71931","spans":[{"id":"spn-103127","text":"455/455 (100%)"}]}],[{"id":"blk-71932","spans":[{"id":"spn-103128","text":"Consolidation throughput"}]},{"id":"blk-71933","spans":[{"id":"spn-103129","text":"~27.1M nodes/sec"}]}],[{"id":"blk-71934","spans":[{"id":"spn-103130","text":"Abstention accuracy (learned ANN threshold)"}]},{"id":"blk-71935","spans":[{"id":"spn-103131","text":"96.7%"}]}]]},{"id":"blk-71936","kind":"paragraph","spans":[{"id":"spn-103132","text":"Full results: "},{"id":"spn-103133","marks":[{"kind":"link","predicate":"cites","target":"#/opensentience.org/docs/spec/OS-E001-EMPIRICAL-EVALUATION.md"}],"text":"`docs/spec/OS-E001-EMPIRICAL-EVALUATION.md`"}]},{"id":"blk-71937","kind":"heading","level":2,"spans":[{"id":"spn-103134","text":"κ Proof"}]},{"id":"blk-71938","kind":"paragraph","spans":[{"id":"spn-103135","marks":[{"kind":"link","predicate":"cites","target":"kappa_proof.js"}],"text":"`kappa_proof.js`"},{"id":"spn-103136","text":" is a browser-runnable proof verifying the κ-routing theorem across "},{"id":"spn-103137","marks":["bold"],"text":"1,926,351 test cases"},{"id":"spn-103138","text":":"}]},{"id":"blk-71939","items":[{"blocks":[{"id":"blk-71941","kind":"paragraph","spans":[{"id":"spn-103139","text":"1,052,740 directed graphs (n=2–5): κ(G) > 0 ⟺ β₁(G) > 0 ⟺ nontrivial SCC"}]}],"id":"blk-71940","kind":"list-item"},{"blocks":[{"id":"blk-71943","kind":"paragraph","spans":[{"id":"spn-103140","text":"873,611 finite dynamical systems (n=2–7): κ(f) > 0 ⟺ periodic orbit (period > 1)"}]}],"id":"blk-71942","kind":"list-item"},{"blocks":[{"id":"blk-71945","kind":"paragraph","spans":[{"id":"spn-103141","marks":["bold"],"text":"Zero counterexamples"}]}],"id":"blk-71944","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71946","kind":"heading","level":2,"spans":[{"id":"spn-103142","text":"Repository Structure"}]},{"id":"blk-71947","kind":"code","language":"text","text":"opensentience.org/\n├── docs/\n│   ├── spec/\n│   │   ├── README.md                       # Master spec — all 10 protocols (source of truth)\n│   │   ├── OS-008-HARNESS.md               # Agent Harness Protocol\n│   │   ├── OS-009-PRISM-SPECIFICATION.md   # PRISM benchmark engine spec\n│   │   ├── OS-010-PULSE-SPECIFICATION.md   # PULSE loop manifest spec\n│   │   └── OS-E001-EMPIRICAL-EVALUATION.md # Empirical benchmark results\n│   ├── skills/                             # Agent skill guides (8 numbered modules)\n│   ├── index.md                            # ReadTheDocs homepage\n│   ├── architecture.md                     # OTP supervision tree details\n│   ├── ecosystem-overview.md               # 10 protocols + 12 product relationships\n│   ├── positioning.md                      # Governance stack & market positioning\n│   ├── competitive-landscape.md            # Comparison with CrewAI, LangGraph, etc.\n│   ├── harness-engineering.md              # Pipeline enforcement deep-dive\n│   ├── runtime-walkthrough.md              # Concrete agent lifecycle walkthrough\n│   ├── comparison-table.md                 # Feature matrix vs alternatives\n│   ├── research.md                         # Cognitive science grounding (7+ hours)\n│   ├── quickstart.md                       # Elixir integration guide\n│   ├── faq.md                              # Common questions\n│   ├── conf.py                             # Sphinx configuration\n│   └── requirements.txt                    # sphinx>=8, myst-parser>=4\n├── index.html                              # Marketing landing page\n├── kappa_proof.js                          # Browser-runnable κ proof (1.9M test cases)\n├── CLAUDE.md                               # Agent context\n├── AGENTS.md                               # Agent interface guide\n├── .readthedocs.yaml                       # ReadTheDocs build config\n└── old_scrap/                              # Historical v1/v2 iterations (not current)"},{"id":"blk-71948","kind":"heading","level":2,"spans":[{"id":"spn-103143","text":"Technology Stack"}]},{"head":[{"id":"blk-71950","spans":[{"id":"spn-103144","text":"Layer"}]},{"id":"blk-71951","spans":[{"