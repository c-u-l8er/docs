:"paragraph","spans":[{"id":"spn-38476","text":"AgentCore-specific guidance (TypeScript):"}]}],"id":"blk-34020","kind":"list-item"},{"blocks":[{"id":"blk-34023","kind":"paragraph","spans":[{"id":"spn-38477","text":"the adapter SHOULD set "},{"id":"spn-38478","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-38479","text":" explicitly on invocation (e.g., "},{"id":"spn-38480","marks":["code"],"text":"sess_<generated>"},{"id":"spn-38481","text":"), or accept a provider-returned session id if the API returns one."}]}],"id":"blk-34022","kind":"list-item"},{"blocks":[{"id":"blk-34025","kind":"paragraph","spans":[{"id":"spn-38482","text":"the adapter MUST return the session identifier to the client as the opaque "},{"id":"spn-38483","marks":["code"],"text":"sessionId"},{"id":"spn-38484","text":" for subsequent calls."}]}],"id":"blk-34024","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34026","items":[{"blocks":[{"id":"blk-34028","kind":"paragraph","spans":[{"id":"spn-38485","text":"Session lifecycle and timeouts:"}]}],"id":"blk-34027","kind":"list-item"},{"blocks":[{"id":"blk-34030","kind":"paragraph","spans":[{"id":"spn-38486","text":"adapters SHOULD document provider-specific session lifetimes and idle timeouts (in internal docs and/or UI hints) but MUST keep the external "},{"id":"spn-38487","marks":["code"],"text":"invoke/v1"},{"id":"spn-38488","text":" contract stable."}]}],"id":"blk-34029","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34031","kind":"heading","level":3,"spans":[{"id":"spn-38489","text":"4) Streaming rules"}]},{"id":"blk-34032","items":[{"blocks":[{"id":"blk-34034","kind":"paragraph","spans":[{"id":"spn-38490","text":"Streaming endpoint MUST:"}]}],"id":"blk-34033","kind":"list-item"},{"blocks":[{"id":"blk-34036","kind":"paragraph","spans":[{"id":"spn-38491","text":"send "},{"id":"spn-38492","marks":["code"],"text":"meta"},{"id":"spn-38493","text":" as first event,"}]}],"id":"blk-34035","kind":"list-item"},{"blocks":[{"id":"blk-34038","kind":"paragraph","spans":[{"id":"spn-38494","text":"send "},{"id":"spn-38495","marks":["code"],"text":"done"},{"id":"spn-38496","text":" as last event on success,"}]}],"id":"blk-34037","kind":"list-item"},{"blocks":[{"id":"blk-34040","kind":"paragraph","spans":[{"id":"spn-38497","text":"send "},{"id":"spn-38498","marks":["code"],"text":"error"},{"id":"spn-38499","text":" as terminal event on failure."}]}],"id":"blk-34039","kind":"list-item"},{"blocks":[{"id":"blk-34042","kind":"paragraph","spans":[{"id":"spn-38500","text":"Even on streaming:"}]}],"id":"blk-34041","kind":"list-item"},{"blocks":[{"id":"blk-34044","kind":"paragraph","spans":[{"id":"spn-38501","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-34043","kind":"list-item"},{"blocks":[{"id":"blk-34046","kind":"paragraph","spans":[{"id":"spn-38502","marks":["code"],"text":"usage"},{"id":"spn-38503","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-34045","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34047","kind":"heading","level":3,"spans":[{"id":"spn-38504","text":"5) Error normalization"}]},{"id":"blk-34048","items":[{"blocks":[{"id":"blk-34050","kind":"paragraph","spans":[{"id":"spn-38505","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-38506","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-38507","text":"."}]}],"id":"blk-34049","kind":"list-item"},{"blocks":[{"id":"blk-34052","kind":"paragraph","spans":[{"id":"spn-38508","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-34051","kind":"list-item"},{"blocks":[{"id":"blk-34054","kind":"paragraph","spans":[{"id":"spn-38509","marks":["code"],"text":"retryable"},{"id":"spn-38510","text":" must be accurate:"}]}],"id":"blk-34053","kind":"list-item"},{"blocks":[{"id":"blk-34056","kind":"paragraph","spans":[{"id":"spn-38511","text":"transient provider failures: true"}]}],"id":"blk-34055","kind":"list-item"},{"blocks":[{"id":"blk-34058","kind":"paragraph","spans":[{"id":"spn-38512","text":"validation/config/session-expired: false"}]}],"id":"blk-34057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34059","kind":"heading","level":3,"spans":[{"id":"spn-38513","text":"6) Telemetry correlation"}]},{"id":"blk-34060","items":[{"blocks":[{"id":"blk-34062","kind":"paragraph","spans":[{"id":"spn-38514","text":"The invocation gateway MUST generate a "},{"id":"spn-38515","marks":["code"],"text":"traceId"},{"id":"spn-38516","text":" if missing and propagate it:"}]}],"id":"blk-34061","kind":"list-item"},{"blocks":[{"id":"blk-34064","kind":"paragraph","spans":[{"id":"spn-38517","text":"to the provider adapter request metadata (headers/metadata where possible),"}]}],"id":"blk-34063","kind":"list-item"},{"blocks":[{"id":"blk-34066","kind":"paragraph","spans":[{"id":"spn-38518","text":"to telemetry events emitted by the data plane or adapter."}]}],"id":"blk-34065","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34067","kind":"heading","level":3,"spans":[{"id":"spn-38519","text":"7) Limits and gating integration"}]},{"id":"blk-34068","items":[{"blocks":[{"id":"blk-34070","kind":"paragraph","spans":[{"id":"spn-38520","text":"Limit enforcement is performed in the invocation gateway before provider invocation whenever possible."}]}],"id":"blk-34069","kind":"list-item"},{"blocks":[{"id":"blk-34072","kind":"paragraph","spans":[{"id":"spn-38521","text":"Runtime gating (AgentCore entitlement) MUST be enforced on:"}]}],"id":"blk-34071","kind":"list-item"},{"blocks":[{"id":"blk-34074","kind":"paragraph","spans":[{"id":"spn-38522","text":"deploy path,"}]}],"id":"blk-34073","kind":"list-item"},{"blocks":[{"id":"blk-34076","kind":"paragraph","spans":[{"id":"spn-38523","text":"invoke path,"}]}],"id":"blk-34075","kind":"list-item"},{"blocks":[{"id":"blk-34078","kind":"paragraph","spans":[{"id":"spn-38524","text":"adapter path (defense in depth)."}]}],"id":"blk-34077","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34079","kind":"heading","level":2,"spans":[{"id":"spn-38525","text":"Acceptance criteria"}]},{"id":"blk-34080","kind":"paragraph","spans":[{"id":"spn-38526","text":"This ADR is correctly implemented when:"}]},{"id":"blk-34081","kind":"paragraph","spans":[{"id":"spn-38527","text":"1. "},{"id":"spn-38528","marks":["bold"],"text":"Unified contract"}]},{"id":"blk-34082","items":[{"blocks":[{"id":"blk-34084","kind":"paragraph","spans":[{"id":"spn-38529","text":"Both Cloudflare and AgentCore invocations accept the same "},{"id":"spn-38530","marks":["code"],"text":"invoke/v1"},{"id":"spn-38531","text":" request shape at the gateway."}]}],"id":"blk-34083","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34085","kind":"paragraph","spans":[{"id":"spn-38532","text":"2. "},{"id":"spn-38533","marks":["bold"],"text":"Normalization"}]},{"id":"blk-34086","items":[{"blocks":[{"id":"blk-34088","kind":"paragraph","spans":[{"id":"spn-38534","marks":["code"],"text":"prompt"},{"id":"spn-38535","text":" input is correctly normalized to "},{"id":"spn-38536","marks":["code"],"text":"messages"},{"id":"spn-38537","text":"."}]}],"id":"blk-34087","kind":"list-item"},{"blocks":[{"id":"blk-34090","kind":"paragraph","spans":[{"id":"spn-38538","text":"Ambiguous inputs (both prompt and messages) are handled consistently."}]}],"id":"blk-34089","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34091","kind":"paragraph","spans":[{"id":"spn-38539","text":"3. "},{"id":"spn-38540","marks":["bold"],"text":"Sessions"}]},{"id":"blk-34092","items":[{"blocks":[{"id":"blk-34094","kind":"paragraph","spans":[{"id":"spn-38541","marks":["code"],"text":"sessionId"},{"id":"spn-38542","text":" round-trips correctly for sessionful invocations on both providers (where supported)."}]}],"id":"blk-34093","kind":"list-item"},{"blocks":[{"id":"blk-34096","kind":"paragraph"