{"bendscript":"0.1","blocks":[{"id":"blk-33221","kind":"heading","level":1,"spans":[{"id":"spn-37096","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-33222","kind":"paragraph","spans":[{"id":"spn-37097","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-33223","items":[{"blocks":[{"id":"blk-33225","kind":"paragraph","spans":[{"id":"spn-37098","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-33224","kind":"list-item"},{"blocks":[{"id":"blk-33227","kind":"paragraph","spans":[{"id":"spn-37099","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-33226","kind":"list-item"},{"blocks":[{"id":"blk-33229","kind":"paragraph","spans":[{"id":"spn-37100","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-33228","kind":"list-item"},{"blocks":[{"id":"blk-33231","kind":"paragraph","spans":[{"id":"spn-37101","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-33230","kind":"list-item"},{"blocks":[{"id":"blk-33233","kind":"paragraph","spans":[{"id":"spn-37102","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-33232","kind":"list-item"},{"blocks":[{"id":"blk-33235","kind":"paragraph","spans":[{"id":"spn-37103","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-37104","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-33234","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33236","kind":"heading","level":2,"spans":[{"id":"spn-37105","text":"Context"}]},{"id":"blk-33237","kind":"paragraph","spans":[{"id":"spn-37106","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-33238","items":[{"blocks":[{"id":"blk-33240","kind":"paragraph","spans":[{"id":"spn-37107","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-33239","kind":"list-item"},{"blocks":[{"id":"blk-33242","kind":"paragraph","spans":[{"id":"spn-37108","text":"consistent session semantics across runtimes,"}]}],"id":"blk-33241","kind":"list-item"},{"blocks":[{"id":"blk-33244","kind":"paragraph","spans":[{"id":"spn-37109","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-33243","kind":"list-item"},{"blocks":[{"id":"blk-33246","kind":"paragraph","spans":[{"id":"spn-37110","text":"safe error handling and sanitization,"}]}],"id":"blk-33245","kind":"list-item"},{"blocks":[{"id":"blk-33248","kind":"paragraph","spans":[{"id":"spn-37111","text":"optional streaming output for good UX."}]}],"id":"blk-33247","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33249","kind":"paragraph","spans":[{"id":"spn-37112","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-33250","items":[{"blocks":[{"id":"blk-33252","kind":"paragraph","spans":[{"id":"spn-37113","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-33251","kind":"list-item"},{"blocks":[{"id":"blk-33254","kind":"paragraph","spans":[{"id":"spn-37114","text":"SDKs hard to write,"}]}],"id":"blk-33253","kind":"list-item"},{"blocks":[{"id":"blk-33256","kind":"paragraph","spans":[{"id":"spn-37115","text":"telemetry inconsistent,"}]}],"id":"blk-33255","kind":"list-item"},{"blocks":[{"id":"blk-33258","kind":"paragraph","spans":[{"id":"spn-37116","text":"limit enforcement unreliable."}]}],"id":"blk-33257","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33259","kind":"paragraph","spans":[{"id":"spn-37117","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-33260","kind":"heading","level":2,"spans":[{"id":"spn-37118","text":"Decision"}]},{"id":"blk-33261","kind":"heading","level":3,"spans":[{"id":"spn-37119","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-37120","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-33262","kind":"paragraph","spans":[{"id":"spn-37121","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-33263","items":[{"blocks":[{"id":"blk-33265","kind":"paragraph","spans":[{"id":"spn-37122","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-33264","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33266","kind":"paragraph","spans":[{"id":"spn-37123","text":"The protocol applies to:"}]},{"id":"blk-33267","items":[{"blocks":[{"id":"blk-33269","kind":"paragraph","spans":[{"id":"spn-37124","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-33268","kind":"list-item"},{"blocks":[{"id":"blk-33271","kind":"paragraph","spans":[{"id":"spn-37125","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-33270","kind":"list-item"},{"blocks":[{"id":"blk-33273","kind":"paragraph","spans":[{"id":"spn-37126","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-33272","kind":"list-item"},{"blocks":[{"id":"blk-33275","kind":"paragraph","spans":[{"id":"spn-37127","text":"telemetry correlation via "},{"id":"spn-37128","marks":["code"],"text":"traceId"},{"id":"spn-37129","text":"."}]}],"id":"blk-33274","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33276","kind":"paragraph","spans":[{"id":"spn-37130","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-37131","marks":["code"],"text":"invoke/v1"},{"id":"spn-37132","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-37133","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-37134","text":"."}]},{"id":"blk-33277","kind":"heading","level":3,"spans":[{"id":"spn-37135","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-33278","kind":"paragraph","spans":[{"id":"spn-37136","marks":["code"],"text":"invoke/v1"},{"id":"spn-37137","text":" defines the canonical input shape as chat "},{"id":"spn-37138","marks":["code"],"text":"messages"},{"id":"spn-37139","text":":"}]},{"id":"blk-33279","items":[{"blocks":[{"id":"blk-33281","kind":"paragraph","spans":[{"id":"spn-37140","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-33280","kind":"list-item"},{"blocks":[{"id":"blk-33283","kind":"paragraph","spans":[{"id":"spn-37141","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-33282","kind":"list-item"},{"blocks":[{"id":"blk-33285","kind":"paragraph","spans":[{"id":"spn-37142","marks":["code"],"text":"content: string"}]}],"id":"blk-33284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33286","kind":"paragraph","spans":[{"id":"spn-37143","text":"Additionally, for client convenience, "},{"id":"spn-37144","marks":["code"],"text":"invoke/v1"},{"id":"spn-37145","text":" allows a "},{"id":"spn-37146","marks":["code"],"text":"prompt"},{"id":"spn-37147","text":" form:"}]},{"id":"blk-33287","items":[{"blocks":[{"id":"blk-33289","kind":"paragraph","spans":[{"id":"spn-37148","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-33288","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33290","kind":"paragraph","spans":[{"id":"spn-37149","text":"When "},{"id":"spn-37150","marks":["code"],"text":"prompt"},{"id":"spn-37151","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-33291","items":[{"blocks":[{"id":"blk-33293","kind":"paragraph","spans":[{"id":"spn-37152","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-33292","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33294","kind":"paragraph","spans":[{"id":"spn-37153","text":"Rationale:"}]},{"id":"blk-33295","items":[{"blocks":[{"id":"blk-33297","kind":"paragraph","spans":[{"id":"spn-37154","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-33296","kind":"list-item"},{"blocks":[{"id":"blk-33299","kind":"paragraph","spans":[{"id":"spn-37155","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-33298","kind":"list-item"},{"blocks":[{"id":"blk-33301","kind":"paragraph","spans":[{"id":"spn-37156","text":"it avoids provider-specific payload drift."}]}],"id":"blk-33300","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33302","kind":"heading","level":3,"spans":[{"id":"spn-37157","text":"3) Session semantics: opaque "},{"id":"spn-37158","marks":["code"],"text":"sessionId"}]},{"id":"blk-33303","kind":"paragraph","spans":[{"id":"spn-37159","marks":["code"],"text":"invoke/v1"},{"id":"spn-37160","text":" standardizes stateful execution via an opaque "},{"id":"spn-37161","marks":["code"],"text":"sessionId"},{"id":"spn-37162","text":" string:"}]},{"id":"blk-33304","items":[{"blocks":[{"id":"blk-33306","kind":"paragraph","spans":[{"id":"spn-37163","text":"Clients MAY include "},{"id":"spn-37164","marks":["code"],"text":"sessionId"},{"id":"spn-37165","text":" to continue a prior session."}]}],"id":"blk-33305","kind":"list-item"},{"blocks":[{"id":"blk-33308","kind":"paragraph","spans":[{"id":"spn-37166","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-37167","marks":["code"],"text":"sessionId"},{"id":"spn-37168","text":"."}]}],"id":"blk-33307","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33309","kind":"paragraph","spans":[{"id":"spn-37169","text":"Rules:"}]},{"id":"blk-33310","items":[{"blocks":[{"id":"blk-33312","kind":"paragraph","spans":[{"id":"spn-37170","marks":["code"],"text":"sessionId"},{"id":"spn-37171","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-33311","kind":"list-item"},{"blocks":[{"id":"blk-33314","kind":"paragraph","spans":[{"id":"spn-37172","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-37173","marks":["code"],"text":"sessionId"},{"id":"spn-37174","text":" string."}]}],"id":"blk-33313","kind":"list-item"},{"blocks":[{"id":"blk-33316","kind":"paragraph","spans":[{"id":"spn-37175","text":"Each runtime provider maps "},{"id":"spn-37176","marks":["code"],"text":"sessionId"},{"id":"spn-37177","text":" to its own session primitive:"}]}],"id":"blk-33315","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33317","items":[{"blocks":[{"id":"blk-33319","kind":"paragraph","spans":[{"id":"spn-37178","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-33318","kind":"list-item"},{"blocks":[{"id":"blk-33321","kind":"paragraph","spans":[{"id":"spn-37179","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-33320","kind":"list-item"},{"blocks":[{"id":"blk-33323","kind":"paragraph","spans":[{"id":"spn-37180","marks":["code"],"text":"sessionId"},{"id":"spn-37181","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-33322","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33324","items":[{"blocks":[{"id":"blk-33326","kind":"paragraph","spans":[{"id":"spn-37182","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-37183","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-37184","text":")"}]}],"id":"blk-33325","kind":"list-item"},{"blocks":[{"id":"blk-33328","kind":"paragraph","spans":[{"id":"spn-37185","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-33327","kind":"list-item"},{"blocks":[{"id":"blk-33330","kind":"paragraph","spans":[{"id":"spn-37186","text":"The adapter MUST treat the "},{"id":"spn-37187","marks":["code"],"text":"sessionId"},{"id":"spn-37188","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-33329","kind":"list-item"},{"blocks":[{"id":"blk-33332","kind":"paragraph","spans":[{"id":"spn-37189","text":"If "},{"id":"spn-37190","marks":["code"],"text":"sessionId"},{"id":"spn-37191","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-37192","marks":["code"],"text":"sessionId"},{"id":"spn-37193","text":"."}]}],"id":"blk-33331","kind":"list-item"},{"blocks":[{"id":"blk-33334","kind":"paragraph","spans":[{"id":"spn-37194","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-33333","kind":"list-item"},{"blocks":[{"id":"blk-33336","kind":"paragraph","spans":[{"id":"spn-37195","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-37196","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-37197","text":" with a safe message such as “Session expired” and "},{"id":"spn-37198","marks":["code"],"text":"retryable=false"},{"id":"spn-37199","text":" (do not leak provider internals)."}]}],"id":"blk-33335","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33337","kind":"paragraph","spans":[{"id":"spn-37200","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-33338","items":[{"blocks":[{"id":"blk-33340","kind":"paragraph","spans":[{"id":"spn-37201","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-37202","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-37203","text":") and a "},{"id":"spn-37204","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-37205","text":" set to the opaque "},{"id":"spn-37206","marks":["code"],"text":"sessionId"},{"id":"spn-37207","text":" (or a newly generated one if absent)."}]}],"id":"blk-33339","kind":"list-item"},{"blocks":[{"id":"blk-33342","kind":"paragraph","spans":[{"id":"spn-37208","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-33341","kind":"list-item"},{"blocks":[{"id":"blk-33344","kind":"paragraph","spans":[{"id":"spn-37209","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-33343","kind":"list-item"},{"blocks":[{"id":"blk-33346","kind":"paragraph","spans":[{"id":"spn-37210","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-33345","kind":"list-item"},{"blocks":[{"id":"blk-33348","kind":"paragraph","spans":[{"id":"spn-37211","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-33347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33349","kind":"heading","level":3,"spans":[{"id":"spn-37212","text":"4) Canonical output: text-first"}]},{"id":"blk-33350","kind":"paragraph","spans":[{"id":"spn-37213","marks":["code"],"text":"invoke/v1"},{"id":"spn-37214","text":" defines the canonical output as:"}]},{"id":"blk-33351","items":[{"blocks":[{"id":"blk-33353","kind":"paragraph","spans":[{"id":"spn-37215","marks":["code"],"text":"output.text: string"},{"id":"spn-37216","text":" (required)"}]}],"id":"blk-33352","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33354","kind":"paragraph","spans":[{"id":"spn-37217","text":"Optionally:"}]},{"id":"blk-33355","items":[{"blocks":[{"id":"blk-33357","kind":"paragraph","spans":[{"id":"spn-37218","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-37219","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-33356","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33358","kind":"paragraph","spans":[{"id":"spn-37220","text":"Rationale:"}]},{"id":"blk-33359","items":[{"blocks":[{"id":"blk-33361","kind":"paragraph","spans":[{"id":"spn-37221","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-33360","kind":"list-item"},{"blocks":[{"id":"blk-33363","kind":"paragraph","spans":[{"id":"spn-37222","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-33362","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33364","kind":"heading","level":3,"spans":[{"id":"spn-37223","text":"5) Usage and correlation are first-class"}]},{"id":"blk-33365","kind":"paragraph","spans":[{"id":"spn-37224","text":"Every "},{"id":"spn-37225","marks":["code"],"text":"invoke/v1"},{"id":"spn-37226","text":" response MUST include:"}]},{"id":"blk-33366","items":[{"blocks":[{"id":"blk-33368","kind":"paragraph","spans":[{"id":"spn-37227","marks":["code"],"text":"traceId: string"},{"id":"spn-37228","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-33367","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33369","kind":"paragraph","spans":[{"id":"spn-37229","text":"Response SHOULD include:"}]},{"id":"blk-33370","items":[{"blocks":[{"id":"blk-33372","kind":"paragraph","spans":[{"id":"spn-37230","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-33371","kind":"list-item"},{"blocks":[{"id":"blk-33374","kind":"paragraph","spans":[{"id":"spn-37231","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-33373","kind":"list-item"},{"blocks":[{"id":"blk-33376","kind":"paragraph","spans":[{"id":"spn-37232","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-37233","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-33375","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33377","kind":"paragraph","spans":[{"id":"spn-37234","text":"Telemetry events MUST include the same "},{"id":"spn-37235","marks":["code"],"text":"traceId"},{"id":"spn-37236","text":" when available, and MUST be attributable to:"}]},{"id":"blk-33378","items":[{"blocks":[{"id":"blk-33380","kind":"paragraph","spans":[{"id":"spn-37237","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-33379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33381","kind":"heading","level":3,"spans":[{"id":"spn-37238","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-33382","kind":"paragraph","spans":[{"id":"spn-37239","marks":["code"],"text":"invoke/v1"},{"id":"spn-37240","text":" defines streaming semantics via "},{"id":"spn-37241","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-37242","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-33383","items":[{"blocks":[{"id":"blk-33385","kind":"paragraph","spans":[{"id":"spn-37243","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-33384","kind":"list-item"},{"blocks":[{"id":"blk-33387","kind":"paragraph","spans":[{"id":"spn-37244","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-33386","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33388","kind":"paragraph","spans":[{"id":"spn-37245","text":"Standard SSE event types:"}]},{"id":"blk-33389","items":[{"blocks":[{"id":"blk-33391","kind":"paragraph","spans":[{"id":"spn-37246","marks":["code"],"text":"meta"},{"id":"spn-37247","text":" (MUST be first)"}]}],"id":"blk-33390","kind":"list-item"},{"blocks":[{"id":"blk-33393","kind":"paragraph","spans":[{"id":"spn-37248","text":"includes "},{"id":"spn-37249","marks":["code"],"text":"traceId"},{"id":"spn-37250","text":" and "},{"id":"spn-37251","marks":["code"],"text":"sessionId"},{"id":"spn-37252","text":" (if known at start)"}]}],"id":"blk-33392","kind":"list-item"},{"blocks":[{"id":"blk-33395","kind":"paragraph","spans":[{"id":"spn-37253","marks":["code"],"text":"delta"},{"id":"spn-37254","text":" (0..N)"}]}],"id":"blk-33394","kind":"list-item"},{"blocks":[{"id":"blk-33397","kind":"paragraph","spans":[{"id":"spn-37255","text":"includes incremental output text chunks"}]}],"id":"blk-33396","kind":"list-item"},{"blocks":[{"id":"blk-33399","kind":"paragraph","spans":[{"id":"spn-37256","marks":["code"],"text":"usage"},{"id":"spn-37257","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-33398","kind":"list-item"},{"blocks":[{"id":"blk-33401","kind":"paragraph","spans":[{"id":"spn-37258","text":"includes final usage summary when available"}]}],"id":"blk-33400","kind":"list-item"},{"blocks":[{"id":"blk-33403","kind":"paragraph","spans":[{"id":"spn-37259","marks":["code"],"text":"done"},{"id":"spn-37260","text":" (MUST be last on success)"}]}],"id":"blk-33402","kind":"list-item"},{"blocks":[{"id":"blk-33405","kind":"paragraph","spans":[{"id":"spn-37261","marks":["code"],"text":"error"},{"id":"spn-37262","text":" (terminal on failure)"}]}],"id":"blk-33404","kind":"list-item"},{"blocks":[{"id":"blk-33407","kind":"paragraph","spans":[{"id":"spn-37263","text":"includes the normalized error envelope"}]}],"id":"blk-33406","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33408","kind":"paragraph","spans":[{"id":"spn-37264","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-33409","items":[{"blocks":[{"id":"blk-33411","kind":"paragraph","spans":[{"id":"spn-37265","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-37266","marks":["code"],"text":"delta"},{"id":"spn-37267","text":" events)."}]}],"id":"blk-33410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33412","kind":"paragraph","spans":[{"id":"spn-37268","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-33413","items":[{"blocks":[{"id":"blk-33415","kind":"paragraph","spans":[{"id":"spn-37269","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-33414","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33416","kind":"paragraph","spans":[{"id":"spn-37270","text":"Rationale:"}]},{"id":"blk-33417","items":[{"blocks":[{"id":"blk-33419","kind":"paragraph","spans":[{"id":"spn-37271","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-33418","kind":"list-item"},{"blocks":[{"id":"blk-33421","kind":"paragraph","spans":[{"id":"spn-37272","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-33420","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33422","kind":"heading","level":2,"spans":[{"id":"spn-37273","text":"Alternatives considered"}]},{"id":"blk-33423","kind":"heading","level":3,"spans":[{"id":"spn-37274","text":"A) Prompt-only protocol"}]},{"id":"blk-33424","kind":"paragraph","spans":[{"id":"spn-37275","text":"Pros:"}]},{"id":"blk-33425","items":[{"blocks":[{"id":"blk-33427","kind":"paragraph","spans":[{"id":"spn-37276","text":"simplest request shape"}]}],"id":"blk-33426","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33428","kind":"paragraph","spans":[{"id":"spn-37277","text":"Cons:"}]},{"id":"blk-33429","items":[{"blocks":[{"id":"blk-33431","kind":"paragraph","spans":[{"id":"spn-37278","text":"loses structured conversation context"}]}],"id":"blk-33430","kind":"list-item"},{"blocks":[{"id":"blk-33433","kind":"paragraph","spans":[{"id":"spn-37279","text":"complicates future tool call integration"}]}],"id":"blk-33432","kind":"list-item"},{"blocks":[{"id":"blk-33435","kind":"paragraph","spans":[{"id":"spn-37280","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-33434","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33436","kind":"paragraph","spans":[{"id":"spn-37281","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-33437","kind":"heading","level":3,"spans":[{"id":"spn-37282","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-33438","kind":"paragraph","spans":[{"id":"spn-37283","text":"Pros:"}]},{"id":"blk-33439","items":[{"blocks":[{"id":"blk-33441","kind":"paragraph","spans":[{"id":"spn-37284","text":"maximum leverage of each provider’s features"}]}],"id":"blk-33440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33442","kind":"paragraph","spans":[{"id":"spn-37285","text":"Cons:"}]},{"id":"blk-33443","items":[{"blocks":[{"id":"blk-33445","kind":"paragraph","spans":[{"id":"spn-37286","text":"breaks portability and unified SDKs"}]}],"id":"blk-33444","kind":"list-item"},{"blocks":[{"id":"blk-33447","kind":"paragraph","spans":[{"id":"spn-37287","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-33446","kind":"list-item"},{"blocks":[{"id":"blk-33449","kind":"paragraph","spans":[{"id":"spn-37288","text":"increases maintenance and user confusion"}]}],"id":"blk-33448","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33450","kind":"paragraph","spans":[{"id":"spn-37289","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-33451","kind":"heading","level":3,"spans":[{"id":"spn-37290","text":"C) WebSockets for streaming"}]},{"id":"blk-33452","kind":"paragraph","spans":[{"id":"spn-37291","text":"Pros:"}]},{"id":"blk-33453","items":[{"blocks":[{"id":"blk-33455","kind":"paragraph","spans":[{"id":"spn-37292","text":"bidirectional, flexible"}]}],"id":"blk-33454","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33456","kind":"paragraph","spans":[{"id":"spn-37293","text":"Cons:"}]},{"id":"blk-33457","items":[{"blocks":[{"id":"blk-33459","kind":"paragraph","spans":[{"id":"spn-37294","text":"more operational complexity (connection state, proxies)"}]}],"id":"blk-33458","kind":"list-item"},{"blocks":[{"id":"blk-33461","kind":"paragraph","spans":[{"id":"spn-37295","text":"not necessary for v1"}]}],"id":"blk-33460","kind":"list-item"},{"blocks":[{"id":"blk-33463","kind":"paragraph","spans":[{"id":"spn-37296","text":"harder to support across platforms and edge gateways"}]}],"id":"blk-33462","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33464","kind":"paragraph","spans":[{"id":"spn-37297","text":"Rejected for v1; SSE is sufficient for streaming output. WebSockets can be introduced later if interactive tool call UX requires it."}]},{"id":"blk-33465","kind":"heading","level":3,"spans":[{"id":"spn-37298","text":"D) gRPC for invocation"}]},{"id":"blk-33466","kind":"paragraph","spans":[{"id":"spn-37299","text":"Pros:"}]},{"id":"blk-33467","items":[{"blocks":[{"id":"blk-33469","kind":"paragraph","spans":[{"id":"spn-37300","text":"strict contracts, performance"}]}],"id":"blk-33468","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33470","kind":"paragraph","spans":[{"id":"spn-37301","text":"Cons:"}]},{"id":"blk-33471","items":[{"blocks":[{"id":"blk-33473","kind":"paragraph","spans":[{"id":"spn-37302","text":"browser compatibility constraints"}]}],"id":"blk-33472","kind":"list-item"},{"blocks":[{"id":"blk-33475","kind":"paragraph","spans":[{"id":"spn-37303","text":"higher adoption friction"}]}],"id":"blk-33474","kind":"list-item"},{"blocks":[{"id":"blk-33477","kind":"paragraph","spans":[{"id":"spn-37304","text":"more infrastructure requirements"}]}],"id":"blk-33476","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33478","kind":"paragraph","spans":[{"id":"spn-37305","text":"Rejected for v1; HTTP+JSON and SSE are simpler and adequate."}]},{"id":"blk-33479","kind":"heading","level":2,"spans":[{"id":"spn-37306","text":"Consequences"}]},{"id":"blk-33480","kind":"heading","level":3,"spans":[{"id":"spn-37307","text":"Positive"}]},{"id":"blk-33481","items":[{"blocks":[{"id":"blk-33483","kind":"paragraph","spans":[{"id":"spn-37308","text":"Stable, runtime-agnostic contract for clients and SDKs."}]}],"id":"blk-33482","kind":"list-item"},{"blocks":[{"id":"blk-33485","kind":"paragraph","spans":[{"id":"spn-37309","text":"Simplifies the invocation gateway and adapter logic (one normalized shape)."}]}],"id":"blk-33484","kind":"list-item"},{"blocks":[{"id":"blk-33487","kind":"paragraph","spans":[{"id":"spn-37310","text":"Enables consistent telemetry attribution and usage accounting."}]}],"id":"blk-33486","kind":"list-item"},{"blocks":[{"id":"blk-33489","kind":"paragraph","spans":[{"id":"spn-37311","text":"Makes streaming UX consistent across runtimes."}]}],"id":"blk-33488","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33490","kind":"heading","level":3,"spans":[{"id":"spn-37312","text":"Negative / tradeoffs"}]},{"id":"blk-33491","items":[{"blocks":[{"id":"blk-33493","kind":"paragraph","spans":[{"id":"spn-37313","text":"Some provider-native features won’t map cleanly to v1 without extensions (e.g., tool call transcripts)."}]}],"id":"blk-33492","kind":"list-item"},{"blocks":[{"id":"blk-33495","kind":"paragraph","spans":[{"id":"spn-37314","text":"Streaming emulation may not reflect true token-level timing for non-streaming providers."}]}],"id":"blk-33494","kind":"list-item"},{"blocks":[{"id":"blk-33497","kind":"paragraph","spans":[{"id":"spn-37315","text":"Token counts and usage fields may be estimated or unavailable for some providers; must be communicated as such."}]}],"id":"blk-33496","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33498","kind":"heading","level":2,"spans":[{"id":"spn-37316","text":"Implementation details (normative requirements)"}]},{"id":"blk-33499","kind":"heading","level":3,"spans":[{"id":"spn-37317","text":"1) Protocol versioning"}]},{"id":"blk-33500","items":[{"blocks":[{"id":"blk-33502","kind":"paragraph","spans":[{"id":"spn-37318","text":"Every deployment artifact manifest MUST declare "},{"id":"spn-37319","marks":["code"],"text":"protocol: \"invoke/v1\""},{"id":"spn-37320","text":"."}]}],"id":"blk-33501","kind":"list-item"},{"blocks":[{"id":"blk-33504","kind":"paragraph","spans":[{"id":"spn-37321","text":"The control plane MUST reject deployments with unknown protocol versions ("},{"id":"spn-37322","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-37323","text":")."}]}],"id":"blk-33503","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33505","kind":"heading","level":3,"spans":[{"id":"spn-37324","text":"2) Request normalization rules"}]},{"id":"blk-33506","items":[{"blocks":[{"id":"blk-33508","kind":"paragraph","spans":[{"id":"spn-37325","text":"If "},{"id":"spn-37326","marks":["code"],"text":"input.prompt"},{"id":"spn-37327","text":" provided and "},{"id":"spn-37328","marks":["code"],"text":"input.messages"},{"id":"spn-37329","text":" missing:"}]}],"id":"blk-33507","kind":"list-item"},{"blocks":[{"id":"blk-33510","kind":"paragraph","spans":[{"id":"spn-37330","text":"normalize to one user message."}]}],"id":"blk-33509","kind":"list-item"},{"blocks":[{"id":"blk-33512","kind":"paragraph","spans":[{"id":"spn-37331","text":"If both are provided:"}]}],"id":"blk-33511","kind":"list-item"},{"blocks":[{"id":"blk-33514","kind":"paragraph","spans":[{"id":"spn-37332","text":"prefer "},{"id":"spn-37333","marks":["code"],"text":"messages"},{"id":"spn-37334","text":" and ignore "},{"id":"spn-37335","marks":["code"],"text":"prompt"},{"id":"spn-37336","text":" (or reject as invalid; choose one consistent policy; v1 recommendation: reject with "},{"id":"spn-37337","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-37338","text":" to avoid ambiguity)."}]}],"id":"blk-33513","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33515","kind":"heading","level":3,"spans":[{"id":"spn-37339","text":"3) Session rules"}]},{"id":"blk-33516","items":[{"blocks":[{"id":"blk-33518","kind":"para