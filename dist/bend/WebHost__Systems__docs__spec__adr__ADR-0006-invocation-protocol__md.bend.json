{"bendscript":"0.1","blocks":[{"id":"blk-33707","kind":"heading","level":1,"spans":[{"id":"spn-38212","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-33708","kind":"paragraph","spans":[{"id":"spn-38213","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-33709","items":[{"blocks":[{"id":"blk-33711","kind":"paragraph","spans":[{"id":"spn-38214","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-33710","kind":"list-item"},{"blocks":[{"id":"blk-33713","kind":"paragraph","spans":[{"id":"spn-38215","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-33712","kind":"list-item"},{"blocks":[{"id":"blk-33715","kind":"paragraph","spans":[{"id":"spn-38216","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-33714","kind":"list-item"},{"blocks":[{"id":"blk-33717","kind":"paragraph","spans":[{"id":"spn-38217","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-33716","kind":"list-item"},{"blocks":[{"id":"blk-33719","kind":"paragraph","spans":[{"id":"spn-38218","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-33718","kind":"list-item"},{"blocks":[{"id":"blk-33721","kind":"paragraph","spans":[{"id":"spn-38219","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-38220","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-33720","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33722","kind":"heading","level":2,"spans":[{"id":"spn-38221","text":"Context"}]},{"id":"blk-33723","kind":"paragraph","spans":[{"id":"spn-38222","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-33724","items":[{"blocks":[{"id":"blk-33726","kind":"paragraph","spans":[{"id":"spn-38223","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-33725","kind":"list-item"},{"blocks":[{"id":"blk-33728","kind":"paragraph","spans":[{"id":"spn-38224","text":"consistent session semantics across runtimes,"}]}],"id":"blk-33727","kind":"list-item"},{"blocks":[{"id":"blk-33730","kind":"paragraph","spans":[{"id":"spn-38225","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-33729","kind":"list-item"},{"blocks":[{"id":"blk-33732","kind":"paragraph","spans":[{"id":"spn-38226","text":"safe error handling and sanitization,"}]}],"id":"blk-33731","kind":"list-item"},{"blocks":[{"id":"blk-33734","kind":"paragraph","spans":[{"id":"spn-38227","text":"optional streaming output for good UX."}]}],"id":"blk-33733","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33735","kind":"paragraph","spans":[{"id":"spn-38228","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-33736","items":[{"blocks":[{"id":"blk-33738","kind":"paragraph","spans":[{"id":"spn-38229","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-33737","kind":"list-item"},{"blocks":[{"id":"blk-33740","kind":"paragraph","spans":[{"id":"spn-38230","text":"SDKs hard to write,"}]}],"id":"blk-33739","kind":"list-item"},{"blocks":[{"id":"blk-33742","kind":"paragraph","spans":[{"id":"spn-38231","text":"telemetry inconsistent,"}]}],"id":"blk-33741","kind":"list-item"},{"blocks":[{"id":"blk-33744","kind":"paragraph","spans":[{"id":"spn-38232","text":"limit enforcement unreliable."}]}],"id":"blk-33743","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33745","kind":"paragraph","spans":[{"id":"spn-38233","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-33746","kind":"heading","level":2,"spans":[{"id":"spn-38234","text":"Decision"}]},{"id":"blk-33747","kind":"heading","level":3,"spans":[{"id":"spn-38235","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-38236","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-33748","kind":"paragraph","spans":[{"id":"spn-38237","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-33749","items":[{"blocks":[{"id":"blk-33751","kind":"paragraph","spans":[{"id":"spn-38238","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-33750","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33752","kind":"paragraph","spans":[{"id":"spn-38239","text":"The protocol applies to:"}]},{"id":"blk-33753","items":[{"blocks":[{"id":"blk-33755","kind":"paragraph","spans":[{"id":"spn-38240","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-33754","kind":"list-item"},{"blocks":[{"id":"blk-33757","kind":"paragraph","spans":[{"id":"spn-38241","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-33756","kind":"list-item"},{"blocks":[{"id":"blk-33759","kind":"paragraph","spans":[{"id":"spn-38242","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-33758","kind":"list-item"},{"blocks":[{"id":"blk-33761","kind":"paragraph","spans":[{"id":"spn-38243","text":"telemetry correlation via "},{"id":"spn-38244","marks":["code"],"text":"traceId"},{"id":"spn-38245","text":"."}]}],"id":"blk-33760","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33762","kind":"paragraph","spans":[{"id":"spn-38246","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-38247","marks":["code"],"text":"invoke/v1"},{"id":"spn-38248","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-38249","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-38250","text":"."}]},{"id":"blk-33763","kind":"heading","level":3,"spans":[{"id":"spn-38251","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-33764","kind":"paragraph","spans":[{"id":"spn-38252","marks":["code"],"text":"invoke/v1"},{"id":"spn-38253","text":" defines the canonical input shape as chat "},{"id":"spn-38254","marks":["code"],"text":"messages"},{"id":"spn-38255","text":":"}]},{"id":"blk-33765","items":[{"blocks":[{"id":"blk-33767","kind":"paragraph","spans":[{"id":"spn-38256","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-33766","kind":"list-item"},{"blocks":[{"id":"blk-33769","kind":"paragraph","spans":[{"id":"spn-38257","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-33768","kind":"list-item"},{"blocks":[{"id":"blk-33771","kind":"paragraph","spans":[{"id":"spn-38258","marks":["code"],"text":"content: string"}]}],"id":"blk-33770","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33772","kind":"paragraph","spans":[{"id":"spn-38259","text":"Additionally, for client convenience, "},{"id":"spn-38260","marks":["code"],"text":"invoke/v1"},{"id":"spn-38261","text":" allows a "},{"id":"spn-38262","marks":["code"],"text":"prompt"},{"id":"spn-38263","text":" form:"}]},{"id":"blk-33773","items":[{"blocks":[{"id":"blk-33775","kind":"paragraph","spans":[{"id":"spn-38264","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-33774","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33776","kind":"paragraph","spans":[{"id":"spn-38265","text":"When "},{"id":"spn-38266","marks":["code"],"text":"prompt"},{"id":"spn-38267","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-33777","items":[{"blocks":[{"id":"blk-33779","kind":"paragraph","spans":[{"id":"spn-38268","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-33778","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33780","kind":"paragraph","spans":[{"id":"spn-38269","text":"Rationale:"}]},{"id":"blk-33781","items":[{"blocks":[{"id":"blk-33783","kind":"paragraph","spans":[{"id":"spn-38270","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-33782","kind":"list-item"},{"blocks":[{"id":"blk-33785","kind":"paragraph","spans":[{"id":"spn-38271","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-33784","kind":"list-item"},{"blocks":[{"id":"blk-33787","kind":"paragraph","spans":[{"id":"spn-38272","text":"it avoids provider-specific payload drift."}]}],"id":"blk-33786","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33788","kind":"heading","level":3,"spans":[{"id":"spn-38273","text":"3) Session semantics: opaque "},{"id":"spn-38274","marks":["code"],"text":"sessionId"}]},{"id":"blk-33789","kind":"paragraph","spans":[{"id":"spn-38275","marks":["code"],"text":"invoke/v1"},{"id":"spn-38276","text":" standardizes stateful execution via an opaque "},{"id":"spn-38277","marks":["code"],"text":"sessionId"},{"id":"spn-38278","text":" string:"}]},{"id":"blk-33790","items":[{"blocks":[{"id":"blk-33792","kind":"paragraph","spans":[{"id":"spn-38279","text":"Clients MAY include "},{"id":"spn-38280","marks":["code"],"text":"sessionId"},{"id":"spn-38281","text":" to continue a prior session."}]}],"id":"blk-33791","kind":"list-item"},{"blocks":[{"id":"blk-33794","kind":"paragraph","spans":[{"id":"spn-38282","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-38283","marks":["code"],"text":"sessionId"},{"id":"spn-38284","text":"."}]}],"id":"blk-33793","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33795","kind":"paragraph","spans":[{"id":"spn-38285","text":"Rules:"}]},{"id":"blk-33796","items":[{"blocks":[{"id":"blk-33798","kind":"paragraph","spans":[{"id":"spn-38286","marks":["code"],"text":"sessionId"},{"id":"spn-38287","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-33797","kind":"list-item"},{"blocks":[{"id":"blk-33800","kind":"paragraph","spans":[{"id":"spn-38288","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-38289","marks":["code"],"text":"sessionId"},{"id":"spn-38290","text":" string."}]}],"id":"blk-33799","kind":"list-item"},{"blocks":[{"id":"blk-33802","kind":"paragraph","spans":[{"id":"spn-38291","text":"Each runtime provider maps "},{"id":"spn-38292","marks":["code"],"text":"sessionId"},{"id":"spn-38293","text":" to its own session primitive:"}]}],"id":"blk-33801","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33803","items":[{"blocks":[{"id":"blk-33805","kind":"paragraph","spans":[{"id":"spn-38294","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-33804","kind":"list-item"},{"blocks":[{"id":"blk-33807","kind":"paragraph","spans":[{"id":"spn-38295","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-33806","kind":"list-item"},{"blocks":[{"id":"blk-33809","kind":"paragraph","spans":[{"id":"spn-38296","marks":["code"],"text":"sessionId"},{"id":"spn-38297","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-33808","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33810","items":[{"blocks":[{"id":"blk-33812","kind":"paragraph","spans":[{"id":"spn-38298","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-38299","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-38300","text":")"}]}],"id":"blk-33811","kind":"list-item"},{"blocks":[{"id":"blk-33814","kind":"paragraph","spans":[{"id":"spn-38301","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-33813","kind":"list-item"},{"blocks":[{"id":"blk-33816","kind":"paragraph","spans":[{"id":"spn-38302","text":"The adapter MUST treat the "},{"id":"spn-38303","marks":["code"],"text":"sessionId"},{"id":"spn-38304","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-33815","kind":"list-item"},{"blocks":[{"id":"blk-33818","kind":"paragraph","spans":[{"id":"spn-38305","text":"If "},{"id":"spn-38306","marks":["code"],"text":"sessionId"},{"id":"spn-38307","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-38308","marks":["code"],"text":"sessionId"},{"id":"spn-38309","text":"."}]}],"id":"blk-33817","kind":"list-item"},{"blocks":[{"id":"blk-33820","kind":"paragraph","spans":[{"id":"spn-38310","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-33819","kind":"list-item"},{"blocks":[{"id":"blk-33822","kind":"paragraph","spans":[{"id":"spn-38311","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-38312","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-38313","text":" with a safe message such as “Session expired” and "},{"id":"spn-38314","marks":["code"],"text":"retryable=false"},{"id":"spn-38315","text":" (do not leak provider internals)."}]}],"id":"blk-33821","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33823","kind":"paragraph","spans":[{"id":"spn-38316","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-33824","items":[{"blocks":[{"id":"blk-33826","kind":"paragraph","spans":[{"id":"spn-38317","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-38318","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-38319","text":") and a "},{"id":"spn-38320","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-38321","text":" set to the opaque "},{"id":"spn-38322","marks":["code"],"text":"sessionId"},{"id":"spn-38323","text":" (or a newly generated one if absent)."}]}],"id":"blk-33825","kind":"list-item"},{"blocks":[{"id":"blk-33828","kind":"paragraph","spans":[{"id":"spn-38324","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-33827","kind":"list-item"},{"blocks":[{"id":"blk-33830","kind":"paragraph","spans":[{"id":"spn-38325","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-33829","kind":"list-item"},{"blocks":[{"id":"blk-33832","kind":"paragraph","spans":[{"id":"spn-38326","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-33831","kind":"list-item"},{"blocks":[{"id":"blk-33834","kind":"paragraph","spans":[{"id":"spn-38327","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-33833","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33835","kind":"heading","level":3,"spans":[{"id":"spn-38328","text":"4) Canonical output: text-first"}]},{"id":"blk-33836","kind":"paragraph","spans":[{"id":"spn-38329","marks":["code"],"text":"invoke/v1"},{"id":"spn-38330","text":" defines the canonical output as:"}]},{"id":"blk-33837","items":[{"blocks":[{"id":"blk-33839","kind":"paragraph","spans":[{"id":"spn-38331","marks":["code"],"text":"output.text: string"},{"id":"spn-38332","text":" (required)"}]}],"id":"blk-33838","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33840","kind":"paragraph","spans":[{"id":"spn-38333","text":"Optionally:"}]},{"id":"blk-33841","items":[{"blocks":[{"id":"blk-33843","kind":"paragraph","spans":[{"id":"spn-38334","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-38335","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-33842","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33844","kind":"paragraph","spans":[{"id":"spn-38336","text":"Rationale:"}]},{"id":"blk-33845","items":[{"blocks":[{"id":"blk-33847","kind":"paragraph","spans":[{"id":"spn-38337","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-33846","kind":"list-item"},{"blocks":[{"id":"blk-33849","kind":"paragraph","spans":[{"id":"spn-38338","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-33848","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33850","kind":"heading","level":3,"spans":[{"id":"spn-38339","text":"5) Usage and correlation are first-class"}]},{"id":"blk-33851","kind":"paragraph","spans":[{"id":"spn-38340","text":"Every "},{"id":"spn-38341","marks":["code"],"text":"invoke/v1"},{"id":"spn-38342","text":" response MUST include:"}]},{"id":"blk-33852","items":[{"blocks":[{"id":"blk-33854","kind":"paragraph","spans":[{"id":"spn-38343","marks":["code"],"text":"traceId: string"},{"id":"spn-38344","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-33853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33855","kind":"paragraph","spans":[{"id":"spn-38345","text":"Response SHOULD include:"}]},{"id":"blk-33856","items":[{"blocks":[{"id":"blk-33858","kind":"paragraph","spans":[{"id":"spn-38346","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-33857","kind":"list-item"},{"blocks":[{"id":"blk-33860","kind":"paragraph","spans":[{"id":"spn-38347","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-33859","kind":"list-item"},{"blocks":[{"id":"blk-33862","kind":"paragraph","spans":[{"id":"spn-38348","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-38349","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-33861","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33863","kind":"paragraph","spans":[{"id":"spn-38350","text":"Telemetry events MUST include the same "},{"id":"spn-38351","marks":["code"],"text":"traceId"},{"id":"spn-38352","text":" when available, and MUST be attributable to:"}]},{"id":"blk-33864","items":[{"blocks":[{"id":"blk-33866","kind":"paragraph","spans":[{"id":"spn-38353","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-33865","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33867","kind":"heading","level":3,"spans":[{"id":"spn-38354","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-33868","kind":"paragraph","spans":[{"id":"spn-38355","marks":["code"],"text":"invoke/v1"},{"id":"spn-38356","text":" defines streaming semantics via "},{"id":"spn-38357","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-38358","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-33869","items":[{"blocks":[{"id":"blk-33871","kind":"paragraph","spans":[{"id":"spn-38359","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-33870","kind":"list-item"},{"blocks":[{"id":"blk-33873","kind":"paragraph","spans":[{"id":"spn-38360","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-33872","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33874","kind":"paragraph","spans":[{"id":"spn-38361","text":"Standard SSE event types:"}]},{"id":"blk-33875","items":[{"blocks":[{"id":"blk-33877","kind":"paragraph","spans":[{"id":"spn-38362","marks":["code"],"text":"meta"},{"id":"spn-38363","text":" (MUST be first)"}]}],"id":"blk-33876","kind":"list-item"},{"blocks":[{"id":"blk-33879","kind":"paragraph","spans":[{"id":"spn-38364","text":"includes "},{"id":"spn-38365","marks":["code"],"text":"traceId"},{"id":"spn-38366","text":" and "},{"id":"spn-38367","marks":["code"],"text":"sessionId"},{"id":"spn-38368","text":" (if known at start)"}]}],"id":"blk-33878","kind":"list-item"},{"blocks":[{"id":"blk-33881","kind":"paragraph","spans":[{"id":"spn-38369","marks":["code"],"text":"delta"},{"id":"spn-38370","text":" (0..N)"}]}],"id":"blk-33880","kind":"list-item"},{"blocks":[{"id":"blk-33883","kind":"paragraph","spans":[{"id":"spn-38371","text":"includes incremental output text chunks"}]}],"id":"blk-33882","kind":"list-item"},{"blocks":[{"id":"blk-33885","kind":"paragraph","spans":[{"id":"spn-38372","marks":["code"],"text":"usage"},{"id":"spn-38373","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-33884","kind":"list-item"},{"blocks":[{"id":"blk-33887","kind":"paragraph","spans":[{"id":"spn-38374","text":"includes final usage summary when available"}]}],"id":"blk-33886","kind":"list-item"},{"blocks":[{"id":"blk-33889","kind":"paragraph","spans":[{"id":"spn-38375","marks":["code"],"text":"done"},{"id":"spn-38376","text":" (MUST be last on success)"}]}],"id":"blk-33888","kind":"list-item"},{"blocks":[{"id":"blk-33891","kind":"paragraph","spans":[{"id":"spn-38377","marks":["code"],"text":"error"},{"id":"spn-38378","text":" (terminal on failure)"}]}],"id":"blk-33890","kind":"list-item"},{"blocks":[{"id":"blk-33893","kind":"paragraph","spans":[{"id":"spn-38379","text":"includes the normalized error envelope"}]}],"id":"blk-33892","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33894","kind":"paragraph","spans":[{"id":"spn-38380","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-33895","items":[{"blocks":[{"id":"blk-33897","kind":"paragraph","spans":[{"id":"spn-38381","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-38382","marks":["code"],"text":"delta"},{"id":"spn-38383","text":" events)."}]}],"id":"blk-33896","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33898","kind":"paragraph","spans":[{"id":"spn-38384","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-33899","items":[{"blocks":[{"id":"blk-33901","kind":"paragraph","spans":[{"id":"spn-38385","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-33900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33902","kind":"paragraph","spans":[{"id":"spn-38386","text":"Rationale:"}]},{"id":"blk-33903","items":[{"blocks":[{"id":"blk-33905","kind":"paragraph","spans":[{"id":"spn-38387","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-33904","kind":"list-item"},{"blocks":[{"id":"blk-33907","kind":"paragraph","spans":[{"id":"spn-38388","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-33906","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33908","kind":"heading","level":2,"spans":[{"id":"spn-38389","text":"Alternatives considered"}]},{"id":"blk-33909","kind":"heading","level":3,"spans":[{"id":"spn-38390","text":"A) Prompt-only protocol"}]},{"id":"blk-33910","kind":"paragraph","spans":[{"id":"spn-38391","text":"Pros:"}]},{"id":"blk-33911","items":[{"blocks":[{"id":"blk-33913","kind":"paragraph","spans":[{"id":"spn-38392","text":"simplest request shape"}]}],"id":"blk-33912","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33914","kind":"paragraph","spans":[{"id":"spn-38393","text":"Cons:"}]},{"id":"blk-33915","items":[{"blocks":[{"id":"blk-33917","kind":"paragraph","spans":[{"id":"spn-38394","text":"loses structured conversation context"}]}],"id":"blk-33916","kind":"list-item"},{"blocks":[{"id":"blk-33919","kind":"paragraph","spans":[{"id":"spn-38395","text":"complicates future tool call integration"}]}],"id":"blk-33918","kind":"list-item"},{"blocks":[{"id":"blk-33921","kind":"paragraph","spans":[{"id":"spn-38396","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-33920","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33922","kind":"paragraph","spans":[{"id":"spn-38397","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-33923","kind":"heading","level":3,"spans":[{"id":"spn-38398","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-33924","kind":"paragraph","spans":[{"id":"spn-38399","text":"Pros:"}]},{"id":"blk-33925","items":[{"blocks":[{"id":"blk-33927","kind":"paragraph","spans":[{"id":"spn-38400","text":"maximum leverage of each provider’s features"}]}],"id":"blk-33926","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33928","kind":"paragraph","spans":[{"id":"spn-38401","text":"Cons:"}]},{"id":"blk-33929","items":[{"blocks":[{"id":"blk-33931","kind":"paragraph","spans":[{"id":"spn-38402","text":"breaks portability and unified SDKs"}]}],"id":"blk-33930","kind":"list-item"},{"blocks":[{"id":"blk-33933","kind":"paragraph","spans":[{"id":"spn-38403","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-33932","kind":"list-item"},{"blocks":[{"id":"blk-33935","kind":"paragraph","spans":[{"id":"spn-38404","text":"increases maintenance and user confusion"}]}],"id":"blk-33934","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33936","kind":"paragraph","spans":[{"id":"spn-38405","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-33937","kind":"heading","level":3,"spans":[{"id":"spn-38406","text":"C) WebSockets for streaming"}]},{"id":"blk-33938","kind":"paragraph","spans":[{"id":"spn-38407","text":"Pros:"}]},{"id":"blk-33939","items":[{"blocks":[{"id":"blk-33941","kind":"paragraph","spans":[{"id":"spn-38408","text":"bidirectional, flexible"}]}],"id":"blk-33940","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33942","kind":"paragraph","spans":[{"id":"spn-38409","text":"Cons:"}]},{"id":"blk-33943","items":[{"blocks":[{"id":"blk-33945","kind":"paragraph","spans":[{"id":"spn-38410","text":"more operational complexity (connection state, proxies)"}]}],"id":"blk-33944","kind":"list-item"},{"blocks":[{"id":"blk-33947","kind":"paragraph","spans":[{"id":"spn-38411","text":"not necessary for v1"}]}],"id":"blk-33946","kind":"list-item"},{"blocks":[{"id":"blk-33949","kind":"paragraph","spans":[{"id":"spn-38412","text":"harder to support across platforms and edge gateways"}]}],"id":"blk-33948","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33950","kind":"paragraph","spans":[{"id":"spn-38413","text":"Rejected for v1; SSE is sufficient for streaming output. WebSockets can be introduced later if interactive tool call UX requires it."}]},{"id":"blk-33951","kind":"heading","level":3,"spans":[{"id":"spn-38414","text":"D) gRPC for invocation"}]},{"id":"blk-33952","kind":"paragraph","spans":[{"id":"spn-38415","text":"Pros:"}]},{"id":"blk-33953","items":[{"blocks":[{"id":"blk-33955","kind":"paragraph","spans":[{"id":"spn-38416","text":"strict contracts, performance"}]}],"id":"blk-33954","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33956","kind":"paragraph","spans":[{"id":"spn-38417","text":"Cons:"}]},{"id":"blk-33957","items":[{"blocks":[{"id":"blk-33959","kind":"paragraph","spans":[{"id":"spn-38418","text":"browser compatibility constraints"}]}],"id":"blk-33958","kind":"list-item"},{"blocks":[{"id":"blk-33961","kind":"paragraph","spans":[{"id":"spn-38419","text":"higher adoption friction"}]}],"id":"blk-33960","kind":"list-item"},{"blocks":[{"id":"blk-33963","kind":"paragraph","spans":[{"id":"spn-38420","text":"more infrastructure requirements"}]}],"id":"blk-33962","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33964","kind":"paragraph","spans":[{"id":"spn-38421","text":"Rejected for v1; HTTP+JSON and SSE are simpler and adequate."}]},{"id":"blk-33965","kind":"heading","level":2,"spans":[{"id":"spn-38422","text":"Consequences"}]},{"id":"blk-33966","kind":"heading","level":3,"spans":[{"id":"spn-38423","text":"Positive"}]},{"id":"blk-33967","items":[{"blocks":[{"id":"blk-33969","kind":"paragraph","spans":[{"id":"spn-38424","text":"Stable, runtime-agnostic contract for clients and SDKs."}]}],"id":"blk-33968","kind":"list-item"},{"blocks":[{"id":"blk-33971","kind":"paragraph","spans":[{"id":"spn-38425","text":"Simplifies the invocation gateway and adapter logic (one normalized shape)."}]}],"id":"blk-33970","kind":"list-item"},{"blocks":[{"id":"blk-33973","kind":"paragraph","spans":[{"id":"spn-38426","text":"Enables consistent telemetry attribution and usage accounting."}]}],"id":"blk-33972","kind":"list-item"},{"blocks":[{"id":"blk-33975","kind":"paragraph","spans":[{"id":"spn-38427","text":"Makes streaming UX consistent across runtimes."}]}],"id":"blk-33974","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33976","kind":"heading","level":3,"spans":[{"id":"spn-38428","text":"Negative / tradeoffs"}]},{"id":"blk-33977","items":[{"blocks":[{"id":"blk-33979","kind":"paragraph","spans":[{"id":"spn-38429","text":"Some provider-native features won’t map cleanly to v1 without extensions (e.g., tool call transcripts)."}]}],"id":"blk-33978","kind":"list-item"},{"blocks":[{"id":"blk-33981","kind":"paragraph","spans":[{"id":"spn-38430","text":"Streaming emulation may not reflect true token-level timing for non-streaming providers."}]}],"id":"blk-33980","kind":"list-item"},{"blocks":[{"id":"blk-33983","kind":"paragraph","spans":[{"id":"spn-38431","text":"Token counts and usage fields may be estimated or unavailable for some providers; must be communicated as such."}]}],"id":"blk-33982","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33984","kind":"heading","level":2,"spans":[{"id":"spn-38432","text":"Implementation details (normative requirements)"}]},{"id":"blk-33985","kind":"heading","level":3,"spans":[{"id":"spn-38433","text":"1) Protocol versioning"}]},{"id":"blk-33986","items":[{"blocks":[{"id":"blk-33988","kind":"paragraph","spans":[{"id":"spn-38434","text":"Every deployment artifact manifest MUST declare "},{"id":"spn-38435","marks":["code"],"text":"protocol: \"invoke/v1\""},{"id":"spn-38436","text":"."}]}],"id":"blk-33987","kind":"list-item"},{"blocks":[{"id":"blk-33990","kind":"paragraph","spans":[{"id":"spn-38437","text":"The control plane MUST reject deployments with unknown protocol versions ("},{"id":"spn-38438","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-38439","text":")."}]}],"id":"blk-33989","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33991","kind":"heading","level":3,"spans":[{"id":"spn-38440","text":"2) Request normalization rules"}]},{"id":"blk-33992","items":[{"blocks":[{"id":"blk-33994","kind":"paragraph","spans":[{"id":"spn-38441","text":"If "},{"id":"spn-38442","marks":["code"],"text":"input.prompt"},{"id":"spn-38443","text":" provided and "},{"id":"spn-38444","marks":["code"],"text":"input.messages"},{"id":"spn-38445","text":" missing:"}]}],"id":"blk-33993","kind":"list-item"},{"blocks":[{"id":"blk-33996","kind":"paragraph","spans":[{"id":"spn-38446","text":"normalize to one user message."}]}],"id":"blk-33995","kind":"list-item"},{"blocks":[{"id":"blk-33998","kind":"paragraph","spans":[{"id":"spn-38447","text":"If both are provided:"}]}],"id":"blk-33997","kind":"list-item"},{"blocks":[{"id":"blk-34000","kind":"paragraph","spans":[{"id":"spn-38448","text":"prefer "},{"id":"spn-38449","marks":["code"],"text":"messages"},{"id":"spn-38450","text":" and ignore "},{"id":"spn-38451","marks":["code"],"text":"prompt"},{"id":"spn-38452","text":" (or reject as invalid; choose one consistent policy; v1 recommendation: reject with "},{"id":"spn-38453","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-38454","text":" to avoid ambiguity)."}]}],"id":"blk-33999","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-34001","kind":"heading","level":3,"spans":[{"id":"spn-38455","text":"3) Session rules"}]},{"id":"blk-34002","items":[{"blocks":[{"id":"blk-34004","kind":"para