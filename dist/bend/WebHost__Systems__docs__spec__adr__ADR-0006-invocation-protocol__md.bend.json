:"paragraph","spans":[{"id":"spn-37360","text":"AgentCore-specific guidance (TypeScript):"}]}],"id":"blk-33534","kind":"list-item"},{"blocks":[{"id":"blk-33537","kind":"paragraph","spans":[{"id":"spn-37361","text":"the adapter SHOULD set "},{"id":"spn-37362","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-37363","text":" explicitly on invocation (e.g., "},{"id":"spn-37364","marks":["code"],"text":"sess_<generated>"},{"id":"spn-37365","text":"), or accept a provider-returned session id if the API returns one."}]}],"id":"blk-33536","kind":"list-item"},{"blocks":[{"id":"blk-33539","kind":"paragraph","spans":[{"id":"spn-37366","text":"the adapter MUST return the session identifier to the client as the opaque "},{"id":"spn-37367","marks":["code"],"text":"sessionId"},{"id":"spn-37368","text":" for subsequent calls."}]}],"id":"blk-33538","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33540","items":[{"blocks":[{"id":"blk-33542","kind":"paragraph","spans":[{"id":"spn-37369","text":"Session lifecycle and timeouts:"}]}],"id":"blk-33541","kind":"list-item"},{"blocks":[{"id":"blk-33544","kind":"paragraph","spans":[{"id":"spn-37370","text":"adapters SHOULD document provider-specific session lifetimes and idle timeouts (in internal docs and/or UI hints) but MUST keep the external "},{"id":"spn-37371","marks":["code"],"text":"invoke/v1"},{"id":"spn-37372","text":" contract stable."}]}],"id":"blk-33543","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33545","kind":"heading","level":3,"spans":[{"id":"spn-37373","text":"4) Streaming rules"}]},{"id":"blk-33546","items":[{"blocks":[{"id":"blk-33548","kind":"paragraph","spans":[{"id":"spn-37374","text":"Streaming endpoint MUST:"}]}],"id":"blk-33547","kind":"list-item"},{"blocks":[{"id":"blk-33550","kind":"paragraph","spans":[{"id":"spn-37375","text":"send "},{"id":"spn-37376","marks":["code"],"text":"meta"},{"id":"spn-37377","text":" as first event,"}]}],"id":"blk-33549","kind":"list-item"},{"blocks":[{"id":"blk-33552","kind":"paragraph","spans":[{"id":"spn-37378","text":"send "},{"id":"spn-37379","marks":["code"],"text":"done"},{"id":"spn-37380","text":" as last event on success,"}]}],"id":"blk-33551","kind":"list-item"},{"blocks":[{"id":"blk-33554","kind":"paragraph","spans":[{"id":"spn-37381","text":"send "},{"id":"spn-37382","marks":["code"],"text":"error"},{"id":"spn-37383","text":" as terminal event on failure."}]}],"id":"blk-33553","kind":"list-item"},{"blocks":[{"id":"blk-33556","kind":"paragraph","spans":[{"id":"spn-37384","text":"Even on streaming:"}]}],"id":"blk-33555","kind":"list-item"},{"blocks":[{"id":"blk-33558","kind":"paragraph","spans":[{"id":"spn-37385","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-33557","kind":"list-item"},{"blocks":[{"id":"blk-33560","kind":"paragraph","spans":[{"id":"spn-37386","marks":["code"],"text":"usage"},{"id":"spn-37387","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-33559","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33561","kind":"heading","level":3,"spans":[{"id":"spn-37388","text":"5) Error normalization"}]},{"id":"blk-33562","items":[{"blocks":[{"id":"blk-33564","kind":"paragraph","spans":[{"id":"spn-37389","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-37390","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-37391","text":"."}]}],"id":"blk-33563","kind":"list-item"},{"blocks":[{"id":"blk-33566","kind":"paragraph","spans":[{"id":"spn-37392","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-33565","kind":"list-item"},{"blocks":[{"id":"blk-33568","kind":"paragraph","spans":[{"id":"spn-37393","marks":["code"],"text":"retryable"},{"id":"spn-37394","text":" must be accurate:"}]}],"id":"blk-33567","kind":"list-item"},{"blocks":[{"id":"blk-33570","kind":"paragraph","spans":[{"id":"spn-37395","text":"transient provider failures: true"}]}],"id":"blk-33569","kind":"list-item"},{"blocks":[{"id":"blk-33572","kind":"paragraph","spans":[{"id":"spn-37396","text":"validation/config/session-expired: false"}]}],"id":"blk-33571","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33573","kind":"heading","level":3,"spans":[{"id":"spn-37397","text":"6) Telemetry correlation"}]},{"id":"blk-33574","items":[{"blocks":[{"id":"blk-33576","kind":"paragraph","spans":[{"id":"spn-37398","text":"The invocation gateway MUST generate a "},{"id":"spn-37399","marks":["code"],"text":"traceId"},{"id":"spn-37400","text":" if missing and propagate it:"}]}],"id":"blk-33575","kind":"list-item"},{"blocks":[{"id":"blk-33578","kind":"paragraph","spans":[{"id":"spn-37401","text":"to the provider adapter request metadata (headers/metadata where possible),"}]}],"id":"blk-33577","kind":"list-item"},{"blocks":[{"id":"blk-33580","kind":"paragraph","spans":[{"id":"spn-37402","text":"to telemetry events emitted by the data plane or adapter."}]}],"id":"blk-33579","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33581","kind":"heading","level":3,"spans":[{"id":"spn-37403","text":"7) Limits and gating integration"}]},{"id":"blk-33582","items":[{"blocks":[{"id":"blk-33584","kind":"paragraph","spans":[{"id":"spn-37404","text":"Limit enforcement is performed in the invocation gateway before provider invocation whenever possible."}]}],"id":"blk-33583","kind":"list-item"},{"blocks":[{"id":"blk-33586","kind":"paragraph","spans":[{"id":"spn-37405","text":"Runtime gating (AgentCore entitlement) MUST be enforced on:"}]}],"id":"blk-33585","kind":"list-item"},{"blocks":[{"id":"blk-33588","kind":"paragraph","spans":[{"id":"spn-37406","text":"deploy path,"}]}],"id":"blk-33587","kind":"list-item"},{"blocks":[{"id":"blk-33590","kind":"paragraph","spans":[{"id":"spn-37407","text":"invoke path,"}]}],"id":"blk-33589","kind":"list-item"},{"blocks":[{"id":"blk-33592","kind":"paragraph","spans":[{"id":"spn-37408","text":"adapter path (defense in depth)."}]}],"id":"blk-33591","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33593","kind":"heading","level":2,"spans":[{"id":"spn-37409","text":"Acceptance criteria"}]},{"id":"blk-33594","kind":"paragraph","spans":[{"id":"spn-37410","text":"This ADR is correctly implemented when:"}]},{"id":"blk-33595","kind":"paragraph","spans":[{"id":"spn-37411","text":"1. "},{"id":"spn-37412","marks":["bold"],"text":"Unified contract"}]},{"id":"blk-33596","items":[{"blocks":[{"id":"blk-33598","kind":"paragraph","spans":[{"id":"spn-37413","text":"Both Cloudflare and AgentCore invocations accept the same "},{"id":"spn-37414","marks":["code"],"text":"invoke/v1"},{"id":"spn-37415","text":" request shape at the gateway."}]}],"id":"blk-33597","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33599","kind":"paragraph","spans":[{"id":"spn-37416","text":"2. "},{"id":"spn-37417","marks":["bold"],"text":"Normalization"}]},{"id":"blk-33600","items":[{"blocks":[{"id":"blk-33602","kind":"paragraph","spans":[{"id":"spn-37418","marks":["code"],"text":"prompt"},{"id":"spn-37419","text":" input is correctly normalized to "},{"id":"spn-37420","marks":["code"],"text":"messages"},{"id":"spn-37421","text":"."}]}],"id":"blk-33601","kind":"list-item"},{"blocks":[{"id":"blk-33604","kind":"paragraph","spans":[{"id":"spn-37422","text":"Ambiguous inputs (both prompt and messages) are handled consistently."}]}],"id":"blk-33603","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33605","kind":"paragraph","spans":[{"id":"spn-37423","text":"3. "},{"id":"spn-37424","marks":["bold"],"text":"Sessions"}]},{"id":"blk-33606","items":[{"blocks":[{"id":"blk-33608","kind":"paragraph","spans":[{"id":"spn-37425","marks":["code"],"text":"sessionId"},{"id":"spn-37426","text":" round-trips correctly for sessionful invocations on both providers (where supported)."}]}],"id":"blk-33607","kind":"list-item"},{"blocks":[{"id":"blk-33610","kind":"paragraph","spans":[{"id":"spn-37427","text":"The system treats session ids as opaque and does not leak provider internals."}]}],"id":"blk-33609","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33611","kind":"paragraph","spans":[{"id":"spn-37428","text":"4. "},{"id":"spn-37429","marks":["bold"],"text":"Streaming"}]},{"id":"blk-33612","items":[{"blocks":[{"id":"blk-33614","kind":"paragraph","spans":[{"id":"spn-37430","text":"Streaming endpoint emits SSE events in the required order ("},{"id":"spn-37431","marks":["code"],"text":"meta"},{"id":"spn-37432","text":" → "},{"id":"spn-37433","marks":["code"],"text":"delta*"},{"id":"spn-37434","text":" → "},{"id":"spn-37435","marks":["code"],"text":"usage?"},{"id":"spn-37436","text":" → "},{"id":"spn-37437","marks":["code"],"text":"done"},{"id":"spn-37438","text":" OR "},{"id":"spn-37439","marks":["code"],"text":"error"},{"id":"spn-37440","text":")."}]}],"id":"blk-33613","kind":"list-item"},{"blocks":[{"id":"blk-33616","kind":"paragraph","spans":[{"id":"spn-37441","text":"Non-streaming providers can still be used through streaming endpoint (emulated streaming acceptable)."}]}],"id":"blk-33615","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33617","kind":"paragraph","spans":[{"id":"spn-37442","text":"5. "},{"id":"spn-37443","marks":["bold"],"text":"Telemetry"}]},{"id":"blk-33618","items":[{"blocks":[{"id":"blk-33620","kind":"paragraph","spans":[{"id":"spn-37444","text":"Each invocation results in a telemetry event with correct attribution and "},{"id":"spn-37445","marks":["code"],"text":"traceId"},{"id":"spn-37446","text":"."}]}],"id":"blk-33619","kind":"list-item"},{"blocks":[{"id":"blk-33622","kind":"paragraph","spans":[{"id":"spn-37447","text":"Telemetry cannot be spoofed (signature verification enforced elsewhere per security spec)."}]}],"id":"blk-33621","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33623","kind":"paragraph","spans":[{"id":"spn-37448","text":"6. "},{"id":"spn-37449","m