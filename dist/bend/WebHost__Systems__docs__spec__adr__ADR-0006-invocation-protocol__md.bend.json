:"paragraph","spans":[{"id":"spn-36187","text":"AgentCore-specific guidance (TypeScript):"}]}],"id":"blk-33049","kind":"list-item"},{"blocks":[{"id":"blk-33052","kind":"paragraph","spans":[{"id":"spn-36188","text":"the adapter SHOULD set "},{"id":"spn-36189","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-36190","text":" explicitly on invocation (e.g., "},{"id":"spn-36191","marks":["code"],"text":"sess_<generated>"},{"id":"spn-36192","text":"), or accept a provider-returned session id if the API returns one."}]}],"id":"blk-33051","kind":"list-item"},{"blocks":[{"id":"blk-33054","kind":"paragraph","spans":[{"id":"spn-36193","text":"the adapter MUST return the session identifier to the client as the opaque "},{"id":"spn-36194","marks":["code"],"text":"sessionId"},{"id":"spn-36195","text":" for subsequent calls."}]}],"id":"blk-33053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33055","items":[{"blocks":[{"id":"blk-33057","kind":"paragraph","spans":[{"id":"spn-36196","text":"Session lifecycle and timeouts:"}]}],"id":"blk-33056","kind":"list-item"},{"blocks":[{"id":"blk-33059","kind":"paragraph","spans":[{"id":"spn-36197","text":"adapters SHOULD document provider-specific session lifetimes and idle timeouts (in internal docs and/or UI hints) but MUST keep the external "},{"id":"spn-36198","marks":["code"],"text":"invoke/v1"},{"id":"spn-36199","text":" contract stable."}]}],"id":"blk-33058","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33060","kind":"heading","level":3,"spans":[{"id":"spn-36200","text":"4) Streaming rules"}]},{"id":"blk-33061","items":[{"blocks":[{"id":"blk-33063","kind":"paragraph","spans":[{"id":"spn-36201","text":"Streaming endpoint MUST:"}]}],"id":"blk-33062","kind":"list-item"},{"blocks":[{"id":"blk-33065","kind":"paragraph","spans":[{"id":"spn-36202","text":"send "},{"id":"spn-36203","marks":["code"],"text":"meta"},{"id":"spn-36204","text":" as first event,"}]}],"id":"blk-33064","kind":"list-item"},{"blocks":[{"id":"blk-33067","kind":"paragraph","spans":[{"id":"spn-36205","text":"send "},{"id":"spn-36206","marks":["code"],"text":"done"},{"id":"spn-36207","text":" as last event on success,"}]}],"id":"blk-33066","kind":"list-item"},{"blocks":[{"id":"blk-33069","kind":"paragraph","spans":[{"id":"spn-36208","text":"send "},{"id":"spn-36209","marks":["code"],"text":"error"},{"id":"spn-36210","text":" as terminal event on failure."}]}],"id":"blk-33068","kind":"list-item"},{"blocks":[{"id":"blk-33071","kind":"paragraph","spans":[{"id":"spn-36211","text":"Even on streaming:"}]}],"id":"blk-33070","kind":"list-item"},{"blocks":[{"id":"blk-33073","kind":"paragraph","spans":[{"id":"spn-36212","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-33072","kind":"list-item"},{"blocks":[{"id":"blk-33075","kind":"paragraph","spans":[{"id":"spn-36213","marks":["code"],"text":"usage"},{"id":"spn-36214","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-33074","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33076","kind":"heading","level":3,"spans":[{"id":"spn-36215","text":"5) Error normalization"}]},{"id":"blk-33077","items":[{"blocks":[{"id":"blk-33079","kind":"paragraph","spans":[{"id":"spn-36216","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-36217","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-36218","text":"."}]}],"id":"blk-33078","kind":"list-item"},{"blocks":[{"id":"blk-33081","kind":"paragraph","spans":[{"id":"spn-36219","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-33080","kind":"list-item"},{"blocks":[{"id":"blk-33083","kind":"paragraph","spans":[{"id":"spn-36220","marks":["code"],"text":"retryable"},{"id":"spn-36221","text":" must be accurate:"}]}],"id":"blk-33082","kind":"list-item"},{"blocks":[{"id":"blk-33085","kind":"paragraph","spans":[{"id":"spn-36222","text":"transient provider failures: true"}]}],"id":"blk-33084","kind":"list-item"},{"blocks":[{"id":"blk-33087","kind":"paragraph","spans":[{"id":"spn-36223","text":"validation/config/session-expired: false"}]}],"id":"blk-33086","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33088","kind":"heading","level":3,"spans":[{"id":"spn-36224","text":"6) Telemetry correlation"}]},{"id":"blk-33089","items":[{"blocks":[{"id":"blk-33091","kind":"paragraph","spans":[{"id":"spn-36225","text":"The invocation gateway MUST generate a "},{"id":"spn-36226","marks":["code"],"text":"traceId"},{"id":"spn-36227","text":" if missing and propagate it:"}]}],"id":"blk-33090","kind":"list-item"},{"blocks":[{"id":"blk-33093","kind":"paragraph","spans":[{"id":"spn-36228","text":"to the provider adapter request metadata (headers/metadata where possible),"}]}],"id":"blk-33092","kind":"list-item"},{"blocks":[{"id":"blk-33095","kind":"paragraph","spans":[{"id":"spn-36229","text":"to telemetry events emitted by the data plane or adapter."}]}],"id":"blk-33094","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33096","kind":"heading","level":3,"spans":[{"id":"spn-36230","text":"7) Limits and gating integration"}]},{"id":"blk-33097","items":[{"blocks":[{"id":"blk-33099","kind":"paragraph","spans":[{"id":"spn-36231","text":"Limit enforcement is performed in the invocation gateway before provider invocation whenever possible."}]}],"id":"blk-33098","kind":"list-item"},{"blocks":[{"id":"blk-33101","kind":"paragraph","spans":[{"id":"spn-36232","text":"Runtime gating (AgentCore entitlement) MUST be enforced on:"}]}],"id":"blk-33100","kind":"list-item"},{"blocks":[{"id":"blk-33103","kind":"paragraph","spans":[{"id":"spn-36233","text":"deploy path,"}]}],"id":"blk-33102","kind":"list-item"},{"blocks":[{"id":"blk-33105","kind":"paragraph","spans":[{"id":"spn-36234","text":"invoke path,"}]}],"id":"blk-33104","kind":"list-item"},{"blocks":[{"id":"blk-33107","kind":"paragraph","spans":[{"id":"spn-36235","text":"adapter path (defense in depth)."}]}],"id":"blk-33106","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33108","kind":"heading","level":2,"spans":[{"id":"spn-36236","text":"Acceptance criteria"}]},{"id":"blk-33109","kind":"paragraph","spans":[{"id":"spn-36237","text":"This ADR is correctly implemented when:"}]},{"id":"blk-33110","kind":"paragraph","spans":[{"id":"spn-36238","text":"1. "},{"id":"spn-36239","marks":["bold"],"text":"Unified contract"}]},{"id":"blk-33111","items":[{"blocks":[{"id":"blk-33113","kind":"paragraph","spans":[{"id":"spn-36240","text":"Both Cloudflare and AgentCore invocations accept the same "},{"id":"spn-36241","marks":["code"],"text":"invoke/v1"},{"id":"spn-36242","text":" request shape at the gateway."}]}],"id":"blk-33112","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33114","kind":"paragraph","spans":[{"id":"spn-36243","text":"2. "},{"id":"spn-36244","marks":["bold"],"text":"Normalization"}]},{"id":"blk-33115","items":[{"blocks":[{"id":"blk-33117","kind":"paragraph","spans":[{"id":"spn-36245","marks":["code"],"text":"prompt"},{"id":"spn-36246","text":" input is correctly normalized to "},{"id":"spn-36247","marks":["code"],"text":"messages"},{"id":"spn-36248","text":"."}]}],"id":"blk-33116","kind":"list-item"},{"blocks":[{"id":"blk-33119","kind":"paragraph","spans":[{"id":"spn-36249","text":"Ambiguous inputs (both prompt and messages) are handled consistently."}]}],"id":"blk-33118","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33120","kind":"paragraph","spans":[{"id":"spn-36250","text":"3. "},{"id":"spn-36251","marks":["bold"],"text":"Sessions"}]},{"id":"blk-33121","items":[{"blocks":[{"id":"blk-33123","kind":"paragraph","spans":[{"id":"spn-36252","marks":["code"],"text":"sessionId"},{"id":"spn-36253","text":" round-trips correctly for sessionful invocations on both providers (where supported)."}]}],"id":"blk-33122","kind":"list-item"},{"blocks":[{"id":"blk-33125","kind":"paragraph","spans":[{"id":"spn-36254","text":"The system treats session ids as opaque and does not leak provider internals."}]}],"id":"blk-33124","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33126","kind":"paragraph","spans":[{"id":"spn-36255","text":"4. "},{"id":"spn-36256","marks":["bold"],"text":"Streaming"}]},{"id":"blk-33127","items":[{"blocks":[{"id":"blk-33129","kind":"paragraph","spans":[{"id":"spn-36257","text":"Streaming endpoint emits SSE events in the required order ("},{"id":"spn-36258","marks":["code"],"text":"meta"},{"id":"spn-36259","text":" → "},{"id":"spn-36260","marks":["code"],"text":"delta*"},{"id":"spn-36261","text":" → "},{"id":"spn-36262","marks":["code"],"text":"usage?"},{"id":"spn-36263","text":" → "},{"id":"spn-36264","marks":["code"],"text":"done"},{"id":"spn-36265","text":" OR "},{"id":"spn-36266","marks":["code"],"text":"error"},{"id":"spn-36267","text":")."}]}],"id":"blk-33128","kind":"list-item"},{"blocks":[{"id":"blk-33131","kind":"paragraph","spans":[{"id":"spn-36268","text":"Non-streaming providers can still be used through streaming endpoint (emulated streaming acceptable)."}]}],"id":"blk-33130","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33132","kind":"paragraph","spans":[{"id":"spn-36269","text":"5. "},{"id":"spn-36270","marks":["bold"],"text":"Telemetry"}]},{"id":"blk-33133","items":[{"blocks":[{"id":"blk-33135","kind":"paragraph","spans":[{"id":"spn-36271","text":"Each invocation results in a telemetry event with correct attribution and "},{"id":"spn-36272","marks":["code"],"text":"traceId"},{"id":"spn-36273","text":"."}]}],"id":"blk-33134","kind":"list-item"},{"blocks":[{"id":"blk-33137","kind":"paragraph","spans":[{"id":"spn-36274","text":"Telemetry cannot be spoofed (signature verification enforced elsewhere per security spec)."}]}],"id":"blk-33136","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33138","kind":"paragraph","spans":[{"id":"spn-36275","text":"6. "},{"id":"spn-36276","m