{"bendscript":"0.1","blocks":[{"id":"blk-52041","kind":"heading","level":1,"spans":[{"id":"spn-78596","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-52042","kind":"paragraph","spans":[{"id":"spn-78597","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-52043","items":[{"blocks":[{"id":"blk-52045","kind":"paragraph","spans":[{"id":"spn-78598","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-52044","kind":"list-item"},{"blocks":[{"id":"blk-52047","kind":"paragraph","spans":[{"id":"spn-78599","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-52046","kind":"list-item"},{"blocks":[{"id":"blk-52049","kind":"paragraph","spans":[{"id":"spn-78600","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-52048","kind":"list-item"},{"blocks":[{"id":"blk-52051","kind":"paragraph","spans":[{"id":"spn-78601","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-52050","kind":"list-item"},{"blocks":[{"id":"blk-52053","kind":"paragraph","spans":[{"id":"spn-78602","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-52052","kind":"list-item"},{"blocks":[{"id":"blk-52055","kind":"paragraph","spans":[{"id":"spn-78603","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-78604","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-52054","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52056","kind":"heading","level":2,"spans":[{"id":"spn-78605","text":"Context"}]},{"id":"blk-52057","kind":"paragraph","spans":[{"id":"spn-78606","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-52058","items":[{"blocks":[{"id":"blk-52060","kind":"paragraph","spans":[{"id":"spn-78607","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-52059","kind":"list-item"},{"blocks":[{"id":"blk-52062","kind":"paragraph","spans":[{"id":"spn-78608","text":"consistent session semantics across runtimes,"}]}],"id":"blk-52061","kind":"list-item"},{"blocks":[{"id":"blk-52064","kind":"paragraph","spans":[{"id":"spn-78609","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-52063","kind":"list-item"},{"blocks":[{"id":"blk-52066","kind":"paragraph","spans":[{"id":"spn-78610","text":"safe error handling and sanitization,"}]}],"id":"blk-52065","kind":"list-item"},{"blocks":[{"id":"blk-52068","kind":"paragraph","spans":[{"id":"spn-78611","text":"optional streaming output for good UX."}]}],"id":"blk-52067","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52069","kind":"paragraph","spans":[{"id":"spn-78612","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-52070","items":[{"blocks":[{"id":"blk-52072","kind":"paragraph","spans":[{"id":"spn-78613","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-52071","kind":"list-item"},{"blocks":[{"id":"blk-52074","kind":"paragraph","spans":[{"id":"spn-78614","text":"SDKs hard to write,"}]}],"id":"blk-52073","kind":"list-item"},{"blocks":[{"id":"blk-52076","kind":"paragraph","spans":[{"id":"spn-78615","text":"telemetry inconsistent,"}]}],"id":"blk-52075","kind":"list-item"},{"blocks":[{"id":"blk-52078","kind":"paragraph","spans":[{"id":"spn-78616","text":"limit enforcement unreliable."}]}],"id":"blk-52077","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52079","kind":"paragraph","spans":[{"id":"spn-78617","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-52080","kind":"heading","level":2,"spans":[{"id":"spn-78618","text":"Decision"}]},{"id":"blk-52081","kind":"heading","level":3,"spans":[{"id":"spn-78619","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-78620","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-52082","kind":"paragraph","spans":[{"id":"spn-78621","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-52083","items":[{"blocks":[{"id":"blk-52085","kind":"paragraph","spans":[{"id":"spn-78622","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-52084","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52086","kind":"paragraph","spans":[{"id":"spn-78623","text":"The protocol applies to:"}]},{"id":"blk-52087","items":[{"blocks":[{"id":"blk-52089","kind":"paragraph","spans":[{"id":"spn-78624","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-52088","kind":"list-item"},{"blocks":[{"id":"blk-52091","kind":"paragraph","spans":[{"id":"spn-78625","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-52090","kind":"list-item"},{"blocks":[{"id":"blk-52093","kind":"paragraph","spans":[{"id":"spn-78626","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-52092","kind":"list-item"},{"blocks":[{"id":"blk-52095","kind":"paragraph","spans":[{"id":"spn-78627","text":"telemetry correlation via "},{"id":"spn-78628","marks":["code"],"text":"traceId"},{"id":"spn-78629","text":"."}]}],"id":"blk-52094","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52096","kind":"paragraph","spans":[{"id":"spn-78630","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-78631","marks":["code"],"text":"invoke/v1"},{"id":"spn-78632","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-78633","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-78634","text":"."}]},{"id":"blk-52097","kind":"heading","level":3,"spans":[{"id":"spn-78635","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-52098","kind":"paragraph","spans":[{"id":"spn-78636","marks":["code"],"text":"invoke/v1"},{"id":"spn-78637","text":" defines the canonical input shape as chat "},{"id":"spn-78638","marks":["code"],"text":"messages"},{"id":"spn-78639","text":":"}]},{"id":"blk-52099","items":[{"blocks":[{"id":"blk-52101","kind":"paragraph","spans":[{"id":"spn-78640","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-52100","kind":"list-item"},{"blocks":[{"id":"blk-52103","kind":"paragraph","spans":[{"id":"spn-78641","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-52102","kind":"list-item"},{"blocks":[{"id":"blk-52105","kind":"paragraph","spans":[{"id":"spn-78642","marks":["code"],"text":"content: string"}]}],"id":"blk-52104","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52106","kind":"paragraph","spans":[{"id":"spn-78643","text":"Additionally, for client convenience, "},{"id":"spn-78644","marks":["code"],"text":"invoke/v1"},{"id":"spn-78645","text":" allows a "},{"id":"spn-78646","marks":["code"],"text":"prompt"},{"id":"spn-78647","text":" form:"}]},{"id":"blk-52107","items":[{"blocks":[{"id":"blk-52109","kind":"paragraph","spans":[{"id":"spn-78648","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-52108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52110","kind":"paragraph","spans":[{"id":"spn-78649","text":"When "},{"id":"spn-78650","marks":["code"],"text":"prompt"},{"id":"spn-78651","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-52111","items":[{"blocks":[{"id":"blk-52113","kind":"paragraph","spans":[{"id":"spn-78652","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-52112","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52114","kind":"paragraph","spans":[{"id":"spn-78653","text":"Rationale:"}]},{"id":"blk-52115","items":[{"blocks":[{"id":"blk-52117","kind":"paragraph","spans":[{"id":"spn-78654","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-52116","kind":"list-item"},{"blocks":[{"id":"blk-52119","kind":"paragraph","spans":[{"id":"spn-78655","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-52118","kind":"list-item"},{"blocks":[{"id":"blk-52121","kind":"paragraph","spans":[{"id":"spn-78656","text":"it avoids provider-specific payload drift."}]}],"id":"blk-52120","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52122","kind":"heading","level":3,"spans":[{"id":"spn-78657","text":"3) Session semantics: opaque "},{"id":"spn-78658","marks":["code"],"text":"sessionId"}]},{"id":"blk-52123","kind":"paragraph","spans":[{"id":"spn-78659","marks":["code"],"text":"invoke/v1"},{"id":"spn-78660","text":" standardizes stateful execution via an opaque "},{"id":"spn-78661","marks":["code"],"text":"sessionId"},{"id":"spn-78662","text":" string:"}]},{"id":"blk-52124","items":[{"blocks":[{"id":"blk-52126","kind":"paragraph","spans":[{"id":"spn-78663","text":"Clients MAY include "},{"id":"spn-78664","marks":["code"],"text":"sessionId"},{"id":"spn-78665","text":" to continue a prior session."}]}],"id":"blk-52125","kind":"list-item"},{"blocks":[{"id":"blk-52128","kind":"paragraph","spans":[{"id":"spn-78666","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-78667","marks":["code"],"text":"sessionId"},{"id":"spn-78668","text":"."}]}],"id":"blk-52127","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52129","kind":"paragraph","spans":[{"id":"spn-78669","text":"Rules:"}]},{"id":"blk-52130","items":[{"blocks":[{"id":"blk-52132","kind":"paragraph","spans":[{"id":"spn-78670","marks":["code"],"text":"sessionId"},{"id":"spn-78671","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-52131","kind":"list-item"},{"blocks":[{"id":"blk-52134","kind":"paragraph","spans":[{"id":"spn-78672","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-78673","marks":["code"],"text":"sessionId"},{"id":"spn-78674","text":" string."}]}],"id":"blk-52133","kind":"list-item"},{"blocks":[{"id":"blk-52136","kind":"paragraph","spans":[{"id":"spn-78675","text":"Each runtime provider maps "},{"id":"spn-78676","marks":["code"],"text":"sessionId"},{"id":"spn-78677","text":" to its own session primitive:"}]}],"id":"blk-52135","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52137","items":[{"blocks":[{"id":"blk-52139","kind":"paragraph","spans":[{"id":"spn-78678","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-52138","kind":"list-item"},{"blocks":[{"id":"blk-52141","kind":"paragraph","spans":[{"id":"spn-78679","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-52140","kind":"list-item"},{"blocks":[{"id":"blk-52143","kind":"paragraph","spans":[{"id":"spn-78680","marks":["code"],"text":"sessionId"},{"id":"spn-78681","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-52142","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52144","items":[{"blocks":[{"id":"blk-52146","kind":"paragraph","spans":[{"id":"spn-78682","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-78683","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-78684","text":")"}]}],"id":"blk-52145","kind":"list-item"},{"blocks":[{"id":"blk-52148","kind":"paragraph","spans":[{"id":"spn-78685","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-52147","kind":"list-item"},{"blocks":[{"id":"blk-52150","kind":"paragraph","spans":[{"id":"spn-78686","text":"The adapter MUST treat the "},{"id":"spn-78687","marks":["code"],"text":"sessionId"},{"id":"spn-78688","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-52149","kind":"list-item"},{"blocks":[{"id":"blk-52152","kind":"paragraph","spans":[{"id":"spn-78689","text":"If "},{"id":"spn-78690","marks":["code"],"text":"sessionId"},{"id":"spn-78691","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-78692","marks":["code"],"text":"sessionId"},{"id":"spn-78693","text":"."}]}],"id":"blk-52151","kind":"list-item"},{"blocks":[{"id":"blk-52154","kind":"paragraph","spans":[{"id":"spn-78694","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-52153","kind":"list-item"},{"blocks":[{"id":"blk-52156","kind":"paragraph","spans":[{"id":"spn-78695","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-78696","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-78697","text":" with a safe message such as “Session expired” and "},{"id":"spn-78698","marks":["code"],"text":"retryable=false"},{"id":"spn-78699","text":" (do not leak provider internals)."}]}],"id":"blk-52155","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52157","kind":"paragraph","spans":[{"id":"spn-78700","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-52158","items":[{"blocks":[{"id":"blk-52160","kind":"paragraph","spans":[{"id":"spn-78701","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-78702","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-78703","text":") and a "},{"id":"spn-78704","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-78705","text":" set to the opaque "},{"id":"spn-78706","marks":["code"],"text":"sessionId"},{"id":"spn-78707","text":" (or a newly generated one if absent)."}]}],"id":"blk-52159","kind":"list-item"},{"blocks":[{"id":"blk-52162","kind":"paragraph","spans":[{"id":"spn-78708","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-52161","kind":"list-item"},{"blocks":[{"id":"blk-52164","kind":"paragraph","spans":[{"id":"spn-78709","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-52163","kind":"list-item"},{"blocks":[{"id":"blk-52166","kind":"paragraph","spans":[{"id":"spn-78710","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-52165","kind":"list-item"},{"blocks":[{"id":"blk-52168","kind":"paragraph","spans":[{"id":"spn-78711","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-52167","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52169","kind":"heading","level":3,"spans":[{"id":"spn-78712","text":"4) Canonical output: text-first"}]},{"id":"blk-52170","kind":"paragraph","spans":[{"id":"spn-78713","marks":["code"],"text":"invoke/v1"},{"id":"spn-78714","text":" defines the canonical output as:"}]},{"id":"blk-52171","items":[{"blocks":[{"id":"blk-52173","kind":"paragraph","spans":[{"id":"spn-78715","marks":["code"],"text":"output.text: string"},{"id":"spn-78716","text":" (required)"}]}],"id":"blk-52172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52174","kind":"paragraph","spans":[{"id":"spn-78717","text":"Optionally:"}]},{"id":"blk-52175","items":[{"blocks":[{"id":"blk-52177","kind":"paragraph","spans":[{"id":"spn-78718","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-78719","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-52176","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52178","kind":"paragraph","spans":[{"id":"spn-78720","text":"Rationale:"}]},{"id":"blk-52179","items":[{"blocks":[{"id":"blk-52181","kind":"paragraph","spans":[{"id":"spn-78721","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-52180","kind":"list-item"},{"blocks":[{"id":"blk-52183","kind":"paragraph","spans":[{"id":"spn-78722","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-52182","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52184","kind":"heading","level":3,"spans":[{"id":"spn-78723","text":"5) Usage and correlation are first-class"}]},{"id":"blk-52185","kind":"paragraph","spans":[{"id":"spn-78724","text":"Every "},{"id":"spn-78725","marks":["code"],"text":"invoke/v1"},{"id":"spn-78726","text":" response MUST include:"}]},{"id":"blk-52186","items":[{"blocks":[{"id":"blk-52188","kind":"paragraph","spans":[{"id":"spn-78727","marks":["code"],"text":"traceId: string"},{"id":"spn-78728","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-52187","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52189","kind":"paragraph","spans":[{"id":"spn-78729","text":"Response SHOULD include:"}]},{"id":"blk-52190","items":[{"blocks":[{"id":"blk-52192","kind":"paragraph","spans":[{"id":"spn-78730","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-52191","kind":"list-item"},{"blocks":[{"id":"blk-52194","kind":"paragraph","spans":[{"id":"spn-78731","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-52193","kind":"list-item"},{"blocks":[{"id":"blk-52196","kind":"paragraph","spans":[{"id":"spn-78732","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-78733","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-52195","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52197","kind":"paragraph","spans":[{"id":"spn-78734","text":"Telemetry events MUST include the same "},{"id":"spn-78735","marks":["code"],"text":"traceId"},{"id":"spn-78736","text":" when available, and MUST be attributable to:"}]},{"id":"blk-52198","items":[{"blocks":[{"id":"blk-52200","kind":"paragraph","spans":[{"id":"spn-78737","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-52199","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52201","kind":"heading","level":3,"spans":[{"id":"spn-78738","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-52202","kind":"paragraph","spans":[{"id":"spn-78739","marks":["code"],"text":"invoke/v1"},{"id":"spn-78740","text":" defines streaming semantics via "},{"id":"spn-78741","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-78742","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-52203","items":[{"blocks":[{"id":"blk-52205","kind":"paragraph","spans":[{"id":"spn-78743","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-52204","kind":"list-item"},{"blocks":[{"id":"blk-52207","kind":"paragraph","spans":[{"id":"spn-78744","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-52206","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52208","kind":"paragraph","spans":[{"id":"spn-78745","text":"Standard SSE event types:"}]},{"id":"blk-52209","items":[{"blocks":[{"id":"blk-52211","kind":"paragraph","spans":[{"id":"spn-78746","marks":["code"],"text":"meta"},{"id":"spn-78747","text":" (MUST be first)"}]}],"id":"blk-52210","kind":"list-item"},{"blocks":[{"id":"blk-52213","kind":"paragraph","spans":[{"id":"spn-78748","text":"includes "},{"id":"spn-78749","marks":["code"],"text":"traceId"},{"id":"spn-78750","text":" and "},{"id":"spn-78751","marks":["code"],"text":"sessionId"},{"id":"spn-78752","text":" (if known at start)"}]}],"id":"blk-52212","kind":"list-item"},{"blocks":[{"id":"blk-52215","kind":"paragraph","spans":[{"id":"spn-78753","marks":["code"],"text":"delta"},{"id":"spn-78754","text":" (0..N)"}]}],"id":"blk-52214","kind":"list-item"},{"blocks":[{"id":"blk-52217","kind":"paragraph","spans":[{"id":"spn-78755","text":"includes incremental output text chunks"}]}],"id":"blk-52216","kind":"list-item"},{"blocks":[{"id":"blk-52219","kind":"paragraph","spans":[{"id":"spn-78756","marks":["code"],"text":"usage"},{"id":"spn-78757","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-52218","kind":"list-item"},{"blocks":[{"id":"blk-52221","kind":"paragraph","spans":[{"id":"spn-78758","text":"includes final usage summary when available"}]}],"id":"blk-52220","kind":"list-item"},{"blocks":[{"id":"blk-52223","kind":"paragraph","spans":[{"id":"spn-78759","marks":["code"],"text":"done"},{"id":"spn-78760","text":" (MUST be last on success)"}]}],"id":"blk-52222","kind":"list-item"},{"blocks":[{"id":"blk-52225","kind":"paragraph","spans":[{"id":"spn-78761","marks":["code"],"text":"error"},{"id":"spn-78762","text":" (terminal on failure)"}]}],"id":"blk-52224","kind":"list-item"},{"blocks":[{"id":"blk-52227","kind":"paragraph","spans":[{"id":"spn-78763","text":"includes the normalized error envelope"}]}],"id":"blk-52226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52228","kind":"paragraph","spans":[{"id":"spn-78764","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-52229","items":[{"blocks":[{"id":"blk-52231","kind":"paragraph","spans":[{"id":"spn-78765","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-78766","marks":["code"],"text":"delta"},{"id":"spn-78767","text":" events)."}]}],"id":"blk-52230","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52232","kind":"paragraph","spans":[{"id":"spn-78768","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-52233","items":[{"blocks":[{"id":"blk-52235","kind":"paragraph","spans":[{"id":"spn-78769","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-52234","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52236","kind":"paragraph","spans":[{"id":"spn-78770","text":"Rationale:"}]},{"id":"blk-52237","items":[{"blocks":[{"id":"blk-52239","kind":"paragraph","spans":[{"id":"spn-78771","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-52238","kind":"list-item"},{"blocks":[{"id":"blk-52241","kind":"paragraph","spans":[{"id":"spn-78772","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-52240","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52242","kind":"heading","level":2,"spans":[{"id":"spn-78773","text":"Alternatives considered"}]},{"id":"blk-52243","kind":"heading","level":3,"spans":[{"id":"spn-78774","text":"A) Prompt-only protocol"}]},{"id":"blk-52244","kind":"paragraph","spans":[{"id":"spn-78775","text":"Pros:"}]},{"id":"blk-52245","items":[{"blocks":[{"id":"blk-52247","kind":"paragraph","spans":[{"id":"spn-78776","text":"simplest request shape"}]}],"id":"blk-52246","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52248","kind":"paragraph","spans":[{"id":"spn-78777","text":"Cons:"}]},{"id":"blk-52249","items":[{"blocks":[{"id":"blk-52251","kind":"paragraph","spans":[{"id":"spn-78778","text":"loses structured conversation context"}]}],"id":"blk-52250","kind":"list-item"},{"blocks":[{"id":"blk-52253","kind":"paragraph","spans":[{"id":"spn-78779","text":"complicates future tool call integration"}]}],"id":"blk-52252","kind":"list-item"},{"blocks":[{"id":"blk-52255","kind":"paragraph","spans":[{"id":"spn-78780","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-52254","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52256","kind":"paragraph","spans":[{"id":"spn-78781","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-52257","kind":"heading","level":3,"spans":[{"id":"spn-78782","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-52258","kind":"paragraph","spans":[{"id":"spn-78783","text":"Pros:"}]},{"id":"blk-52259","items":[{"blocks":[{"id":"blk-52261","kind":"paragraph","spans":[{"id":"spn-78784","text":"maximum leverage of each provider’s features"}]}],"id":"blk-52260","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52262","kind":"paragraph","spans":[{"id":"spn-78785","text":"Cons:"}]},{"id":"blk-52263","items":[{"blocks":[{"id":"blk-52265","kind":"paragraph","spans":[{"id":"spn-78786","text":"breaks portability and unified SDKs"}]}],"id":"blk-52264","kind":"list-item"},{"blocks":[{"id":"blk-52267","kind":"paragraph","spans":[{"id":"spn-78787","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-52266","kind":"list-item"},{"blocks":[{"id":"blk-52269","kind":"paragraph","spans":[{"id":"spn-78788","text":"increases maintenance and user confusion"}]}],"id":"blk-52268","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52270","kind":"paragraph","spans":[{"id":"spn-78789","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-52271","kind":"heading","level":3,"spans":[{"id":"spn-78790","text":"C) WebSockets for streaming"}]},{"id":"blk-52272","kind":"paragraph","spans":[{"id":"spn-78791","text":"Pros:"}]},{"id":"blk-52273","items":[{"blocks":[{"id":"blk-52275","kind":"paragraph","spans":[{"id":"spn-78792","text":"bidirectional, flexible"}]}],"id":"blk-52274","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52276","kind":"paragraph","spans":[{"id":"spn-78793","text":"Cons:"}]},{"id":"blk-52277","items":[{"blocks":[{"id":"blk-52279","kind":"paragraph","spans":[{"id":"spn-78794","text":"more operational complexity (connection state, proxies)"}]}],"id":"blk-52278","kind":"list-item"},{"blocks":[{"id":"blk-52281","kind":"paragraph","spans":[{"id":"spn-78795","text":"not necessary for v1"}]}],"id":"blk-52280","kind":"list-item"},{"blocks":[{"id":"blk-52283","kind":"paragraph","spans":[{"id":"spn-78796","text":"harder to support across platforms and edge gateways"}]}],"id":"blk-52282","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52284","kind":"paragraph","spans":[{"id":"spn-78797","text":"Rejected for v1; SSE is sufficient for streaming output. WebSockets can be introduced later if interactive tool call UX requires it."}]},{"id":"blk-52285","kind":"heading","level":3,"spans":[{"id":"spn-78798","text":"D) gRPC for invocation"}]},{"id":"blk-52286","kind":"paragraph","spans":[{"id":"spn-78799","text":"Pros:"}]},{"id":"blk-52287","items":[{"blocks":[{"id":"blk-52289","kind":"paragraph","spans":[{"id":"spn-78800","text":"strict contracts, performance"}]}],"id":"blk-52288","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52290","kind":"paragraph","spans":[{"id":"spn-78801","text":"Cons:"}]},{"id":"blk-52291","items":[{"blocks":[{"id":"blk-52293","kind":"paragraph","spans":[{"id":"spn-78802","text":"browser compatibility constraints"}]}],"id":"blk-52292","kind":"list-item"},{"blocks":[{"id":"blk-52295","kind":"paragraph","spans":[{"id":"spn-78803","text":"higher adoption friction"}]}],"id":"blk-52294","kind":"list-item"},{"blocks":[{"id":"blk-52297","kind":"paragraph","spans":[{"id":"spn-78804","text":"more infrastructure requirements"}]}],"id":"blk-52296","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52298","kind":"paragraph","spans":[{"id":"spn-78805","text":"Rejected for v1; HTTP+JSON and SSE are simpler and adequate."}]},{"id":"blk-52299","kind":"heading","level":2,"spans":[{"id":"spn-78806","text":"Consequences"}]},{"id":"blk-52300","kind":"heading","level":3,"spans":[{"id":"spn-78807","text":"Positive"}]},{"id":"blk-52301","items":[{"blocks":[{"id":"blk-52303","kind":"paragraph","spans":[{"id":"spn-78808","text":"Stable, runtime-agnostic contract for clients and SDKs."}]}],"id":"blk-52302","kind":"list-item"},{"blocks":[{"id":"blk-52305","kind":"paragraph","spans":[{"id":"spn-78809","text":"Simplifies the invocation gateway and adapter logic (one normalized shape)."}]}],"id":"blk-52304","kind":"list-item"},{"blocks":[{"id":"blk-52307","kind":"paragraph","spans":[{"id":"spn-78810","text":"Enables consistent telemetry attribution and usage accounting."}]}],"id":"blk-52306","kind":"list-item"},{"blocks":[{"id":"blk-52309","kind":"paragraph","spans":[{"id":"spn-78811","text":"Makes streaming UX consistent across runtimes."}]}],"id":"blk-52308","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52310","kind":"heading","level":3,"spans":[{"id":"spn-78812","text":"Negative / tradeoffs"}]},{"id":"blk-52311","items":[{"blocks":[{"id":"blk-52313","kind":"paragraph","spans":[{"id":"spn-78813","text":"Some provider-native features won’t map cleanly to v1 without extensions (e.g., tool call transcripts)."}]}],"id":"blk-52312","kind":"list-item"},{"blocks":[{"id":"blk-52315","kind":"paragraph","spans":[{"id":"spn-78814","text":"Streaming emulation may not reflect true token-level timing for non-streaming providers."}]}],"id":"blk-52314","kind":"list-item"},{"blocks":[{"id":"blk-52317","kind":"paragraph","spans":[{"id":"spn-78815","text":"Token counts and usage fields may be estimated or unavailable for some providers; must be communicated as such."}]}],"id":"blk-52316","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52318","kind":"heading","level":2,"spans":[{"id":"spn-78816","text":"Implementation details (normative requirements)"}]},{"id":"blk-52319","kind":"heading","level":3,"spans":[{"id":"spn-78817","text":"1) Protocol versioning"}]},{"id":"blk-52320","items":[{"blocks":[{"id":"blk-52322","kind":"paragraph","spans":[{"id":"spn-78818","text":"Every deployment artifact manifest MUST declare "},{"id":"spn-78819","marks":["code"],"text":"protocol: \"invoke/v1\""},{"id":"spn-78820","text":"."}]}],"id":"blk-52321","kind":"list-item"},{"blocks":[{"id":"blk-52324","kind":"paragraph","spans":[{"id":"spn-78821","text":"The control plane MUST reject deployments with unknown protocol versions ("},{"id":"spn-78822","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-78823","text":")."}]}],"id":"blk-52323","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52325","kind":"heading","level":3,"spans":[{"id":"spn-78824","text":"2) Request normalization rules"}]},{"id":"blk-52326","items":[{"blocks":[{"id":"blk-52328","kind":"paragraph","spans":[{"id":"spn-78825","text":"If "},{"id":"spn-78826","marks":["code"],"text":"input.prompt"},{"id":"spn-78827","text":" provided and "},{"id":"spn-78828","marks":["code"],"text":"input.messages"},{"id":"spn-78829","text":" missing:"}]}],"id":"blk-52327","kind":"list-item"},{"blocks":[{"id":"blk-52330","kind":"paragraph","spans":[{"id":"spn-78830","text":"normalize to one user message."}]}],"id":"blk-52329","kind":"list-item"},{"blocks":[{"id":"blk-52332","kind":"paragraph","spans":[{"id":"spn-78831","text":"If both are provided:"}]}],"id":"blk-52331","kind":"list-item"},{"blocks":[{"id":"blk-52334","kind":"paragraph","spans":[{"id":"spn-78832","text":"prefer "},{"id":"spn-78833","marks":["code"],"text":"messages"},{"id":"spn-78834","text":" and ignore "},{"id":"spn-78835","marks":["code"],"text":"prompt"},{"id":"spn-78836","text":" (or reject as invalid; choose one consistent policy; v1 recommendation: reject with "},{"id":"spn-78837","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-78838","text":" to avoid ambiguity)."}]}],"id":"blk-52333","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52335","kind":"heading","level":3,"spans":[{"id":"spn-78839","text":"3) Session rules"}]},{"id":"blk-52336","items":[{"blocks":[{"id":"blk-52338","kind":"paragraph","spans":[{"id":"spn-78840","text":"If "},{"id":"spn-78841","marks":["code"],"text":"sessionId"},{"id":"spn-78842","text":" is present:"}]}],"id":"blk-52337","kind":"list-item"},{"blocks":[{"id":"blk-52340","kind":"paragraph","spans":[{"id":"spn-78843","text":"adapter MUST attempt to continue that session in the provider."}]}],"id":"blk-52339","kind":"list-item"},{"blocks":[{"id":"blk-52342","kind":"paragraph","spans":[{"id":"spn-78844","text":"adapter MUST treat "},{"id":"spn-78845","marks":["code"],"text":"sessionId"},{"id":"spn-78846","text":" as opaque and MUST NOT parse or re-encode it."}]}],"id":"blk-52341","kind":"list-item"},{"blocks":[{"id":"blk-52344","kind":"paragraph","spans":[{"id":"spn-78847","text":"if the provider rejects session id as unknown/expired:"}]}],"id":"blk-52343","kind":"list-item"},{"blocks":[{"id":"blk-52346","kind":"paragraph","spans":[{"id":"spn-78848","text":"return "},{"id":"spn-78849","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-78850","text":" with "},{"id":"spn-78851","marks":["code"],"text":"retryable=false"},{"id":"spn-78852","text":" (v1 canonical behavior) and a safe message such as “Session expired”."}]}],"id":"blk-52345","kind":"list-item"},{"blocks":[{"id":"blk-52348","kind":"paragraph","spans":[{"id":"spn-78853","text":"do not leak provider error details or identifiers to the client."}]}],"id":"blk-52347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52349","items":[{"blocks":[{"id":"blk-52351","kind":"paragraph","spans":[{"id":"spn-78854","text":"If "},{"id":"spn-78855","marks":["code"],"text":"sessionId"},{"id":"spn-78856","text":" is absent:"}]}],"id":"blk-52350","kind":"list-item"},{"blocks":[{"id":"blk-52353","kind":"paragraph","spans":[{"id":"spn-78857","text":"adapter MAY start a new session and MUST return the new "},{"id":"spn-78858","marks":["code"],"text":"sessionId"},{"id":"spn-78859","text":" if created."}]}],"id":"blk-52352","kind":"list-item"},{"blocks":[{"id":"blk-52355","kind":"paragraph","spans":[{"id":"spn-78860","text":"AgentCore-specific guidance (TypeScript):"}]}],"id":"blk-52354","kind":"list-item"},{"blocks":[{"id":"blk-52357","kind":"paragraph","spans":[{"id":"spn-78861","text":"the adapter SHOULD set "},{"id":"spn-78862","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-78863","text":" explicitly on invocation (e.g., "},{"id":"spn-78864","marks":["code"],"text":"sess_<generated>"},{"id":"spn-78865","text":"), or accept a provider-returned session id if the API returns one."}]}],"id":"blk-52356","kind":"list-item"},{"blocks":[{"id":"blk-52359","kind":"paragraph","spans":[{"id":"spn-78866","text":"the adapter MUST return the session identifier to the client as the opaque "},{"id":"spn-78867","marks":["code"],"text":"sessionId"},{"id":"spn-78868","text":" for subsequent calls."}]}],"id":"blk-52358","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52360","items":[{"blocks":[{"id":"blk-52362","kind":"paragraph","spans":[{"id":"spn-78869","text":"Session lifecycle and timeouts:"}]}],"id":"blk-52361","kind":"list-item"},{"blocks":[{"id":"blk-52364","kind":"paragraph","spans":[{"id":"spn-78870","text":"adapters SHOULD document provider-specific session lifetimes and idle timeouts (in internal docs and/or UI hints) but MUST keep the external "},{"id":"spn-78871","marks":["code"],"text":"invoke/v1"},{"id":"spn-78872","text":" contract stable."}]}],"id":"blk-52363","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52365","kind":"heading","level":3,"spans":[{"id":"spn-78873","text":"4) Streaming rules"}]},{"id":"blk-52366","items":[{"blocks":[{"id":"blk-52368","kind":"paragraph","spans":[{"id":"spn-78874","text":"Streaming endpoint MUST:"}]}],"id":"blk-52367","kind":"list-item"},{"blocks":[{"id":"blk-52370","kind":"paragraph","spans":[{"id":"spn-78875","text":"send "},{"id":"spn-78876","marks":["code"],"text":"meta"},{"id":"spn-78877","text":" as first event,"}]}],"id":"blk-52369","kind":"list-item"},{"blocks":[{"id":"blk-52372","kind":"paragraph","spans":[{"id":"spn-78878","text":"send "},{"id":"spn-78879","marks":["code"],"text":"done"},{"id":"spn-78880","text":" as last event on success,"}]}],"id":"blk-52371","kind":"list-item"},{"blocks":[{"id":"blk-52374","kind":"paragraph","spans":[{"id":"spn-78881","text":"send "},{"id":"spn-78882","marks":["code"],"text":"error"},{"id":"spn-78883","text":" as terminal event on failure."}]}],"id":"blk-52373","kind":"list-item"},{"blocks":[{"id":"blk-52376","kind":"paragraph","spans":[{"id":"spn-78884","text":"Even on streaming:"}]}],"id":"blk-52375","kind":"list-item"},{"blocks":[{"id":"blk-52378","kind":"paragraph","spans":[{"id":"spn-78885","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-52377","kind":"list-item"},{"blocks":[{"id":"blk-52380","kind":"paragraph","spans":[{"id":"spn-78886","marks":["code"],"text":"usage"},{"id":"spn-78887","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-52379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52381","kind":"heading","level":3,"spans":[{"id":"spn-78888","text":"5) Error normalization"}]},{"id":"blk-52382","items":[{"blocks":[{"id":"blk-52384","kind":"paragraph","spans":[{"id":"spn-78889","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-78890","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-78891","text":"."}]}],"id":"blk-52383","kind":"list-item"},{"blocks":[{"id":"blk-52386","kind":"paragraph","spans":[{"id":"spn-78892","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-52385","kind":"list-item"},{"blocks":[{"id":"blk-52388","kind":"paragraph","spans":[{"id":"spn-78893","marks":["code"],"text":"retryable"},{"id":"spn-78894","text":" must be accurate:"}]}],"id":"blk-52387","kind":"list-item"},{"blocks":[{"id":"blk-52390","kind":"paragraph","spans":[{"id":"spn-78895","text":"transient provider failures: true"}]}],"id":"blk-52389","kind":"list-item"},{"blocks":[{"id":"blk-52392","kind":"paragraph","spans":[{"id":"spn-78896","text":"validation/config/session-expired: false"}]}],"id":"blk-52391","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52393","kind":"heading","level":3,"spans":[{"id":"spn-78897","text":"6) Telemetry correlation"}]},{"id":"blk-52394","items":[{"blocks":[{"id":"blk-52396","kind":"paragraph","spans":[{"id":"spn-78898","text":"The invocation gateway MUST generate a "},{"id":"spn-78899","marks":["code"],"text":"traceId"},{"id":"spn-78900","text":" if missing and propagate it:"}]}],"id":"blk-52395","kind":"list-item"},{"blocks":[{"id":"blk-52398","kind":"paragraph","spans":[{"id":"spn-78901","text":"to the provider adapter request metadata (headers/metadata where possible),"}]}],"id":"blk-52397","kind":"list-item"},{"blocks":[{"id":"blk-52400","kind":"paragraph","spans":[{"id":"spn-78902","text":"to telemetry events emitted by the data plane or adapter."}]}],"id":"blk-52399","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52401","kind":"heading","level":3,"spans":[{"id":"spn-78903","text":"7) Limits and gating integration"}]},{"id":"blk-52402","items":[{"blocks":[{"id":"blk-52404","kind":"paragraph","spans":[{"id":"spn-78904","text":"Limit enforcement is performed in the invocation gateway before provider invocation whenever possible."}]}],"id":"blk-52403","kind":"list-item"},{"blocks":[{"id":"blk-52406","kind":"paragraph","spans":[{"id":"spn-78905","text":"Runtime gating (AgentCore entitlement) MUST be enforced on:"}]}],"id":"blk-52405","kind":"list-item"},{"blocks":[{"id":"blk-52408","kind":"paragraph","spans":[{"id":"spn-78906","text":"deploy path,"}]}],"id":"blk-52407","kind":"list-item"},{"blocks":[{"id":"blk-52410","kind":"paragraph","spans":[{"id":"spn-78907","text":"invoke path,"}]}],"id":"blk-52409","kind":"list-item"},{"blocks":[{"id":"blk-52412","kind":"paragraph","spans":[{"id":"spn-78908