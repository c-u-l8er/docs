{"bendscript":"0.1","blocks":[{"id":"blk-32736","kind":"heading","level":1,"spans":[{"id":"spn-35923","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-32737","kind":"paragraph","spans":[{"id":"spn-35924","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-32738","items":[{"blocks":[{"id":"blk-32740","kind":"paragraph","spans":[{"id":"spn-35925","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-32739","kind":"list-item"},{"blocks":[{"id":"blk-32742","kind":"paragraph","spans":[{"id":"spn-35926","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-32741","kind":"list-item"},{"blocks":[{"id":"blk-32744","kind":"paragraph","spans":[{"id":"spn-35927","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-32743","kind":"list-item"},{"blocks":[{"id":"blk-32746","kind":"paragraph","spans":[{"id":"spn-35928","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-32745","kind":"list-item"},{"blocks":[{"id":"blk-32748","kind":"paragraph","spans":[{"id":"spn-35929","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-32747","kind":"list-item"},{"blocks":[{"id":"blk-32750","kind":"paragraph","spans":[{"id":"spn-35930","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-35931","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-32749","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32751","kind":"heading","level":2,"spans":[{"id":"spn-35932","text":"Context"}]},{"id":"blk-32752","kind":"paragraph","spans":[{"id":"spn-35933","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-32753","items":[{"blocks":[{"id":"blk-32755","kind":"paragraph","spans":[{"id":"spn-35934","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-32754","kind":"list-item"},{"blocks":[{"id":"blk-32757","kind":"paragraph","spans":[{"id":"spn-35935","text":"consistent session semantics across runtimes,"}]}],"id":"blk-32756","kind":"list-item"},{"blocks":[{"id":"blk-32759","kind":"paragraph","spans":[{"id":"spn-35936","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-32758","kind":"list-item"},{"blocks":[{"id":"blk-32761","kind":"paragraph","spans":[{"id":"spn-35937","text":"safe error handling and sanitization,"}]}],"id":"blk-32760","kind":"list-item"},{"blocks":[{"id":"blk-32763","kind":"paragraph","spans":[{"id":"spn-35938","text":"optional streaming output for good UX."}]}],"id":"blk-32762","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32764","kind":"paragraph","spans":[{"id":"spn-35939","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-32765","items":[{"blocks":[{"id":"blk-32767","kind":"paragraph","spans":[{"id":"spn-35940","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-32766","kind":"list-item"},{"blocks":[{"id":"blk-32769","kind":"paragraph","spans":[{"id":"spn-35941","text":"SDKs hard to write,"}]}],"id":"blk-32768","kind":"list-item"},{"blocks":[{"id":"blk-32771","kind":"paragraph","spans":[{"id":"spn-35942","text":"telemetry inconsistent,"}]}],"id":"blk-32770","kind":"list-item"},{"blocks":[{"id":"blk-32773","kind":"paragraph","spans":[{"id":"spn-35943","text":"limit enforcement unreliable."}]}],"id":"blk-32772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32774","kind":"paragraph","spans":[{"id":"spn-35944","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-32775","kind":"heading","level":2,"spans":[{"id":"spn-35945","text":"Decision"}]},{"id":"blk-32776","kind":"heading","level":3,"spans":[{"id":"spn-35946","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-35947","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-32777","kind":"paragraph","spans":[{"id":"spn-35948","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-32778","items":[{"blocks":[{"id":"blk-32780","kind":"paragraph","spans":[{"id":"spn-35949","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-32779","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32781","kind":"paragraph","spans":[{"id":"spn-35950","text":"The protocol applies to:"}]},{"id":"blk-32782","items":[{"blocks":[{"id":"blk-32784","kind":"paragraph","spans":[{"id":"spn-35951","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-32783","kind":"list-item"},{"blocks":[{"id":"blk-32786","kind":"paragraph","spans":[{"id":"spn-35952","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-32785","kind":"list-item"},{"blocks":[{"id":"blk-32788","kind":"paragraph","spans":[{"id":"spn-35953","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-32787","kind":"list-item"},{"blocks":[{"id":"blk-32790","kind":"paragraph","spans":[{"id":"spn-35954","text":"telemetry correlation via "},{"id":"spn-35955","marks":["code"],"text":"traceId"},{"id":"spn-35956","text":"."}]}],"id":"blk-32789","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32791","kind":"paragraph","spans":[{"id":"spn-35957","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-35958","marks":["code"],"text":"invoke/v1"},{"id":"spn-35959","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-35960","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-35961","text":"."}]},{"id":"blk-32792","kind":"heading","level":3,"spans":[{"id":"spn-35962","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-32793","kind":"paragraph","spans":[{"id":"spn-35963","marks":["code"],"text":"invoke/v1"},{"id":"spn-35964","text":" defines the canonical input shape as chat "},{"id":"spn-35965","marks":["code"],"text":"messages"},{"id":"spn-35966","text":":"}]},{"id":"blk-32794","items":[{"blocks":[{"id":"blk-32796","kind":"paragraph","spans":[{"id":"spn-35967","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-32795","kind":"list-item"},{"blocks":[{"id":"blk-32798","kind":"paragraph","spans":[{"id":"spn-35968","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-32797","kind":"list-item"},{"blocks":[{"id":"blk-32800","kind":"paragraph","spans":[{"id":"spn-35969","marks":["code"],"text":"content: string"}]}],"id":"blk-32799","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32801","kind":"paragraph","spans":[{"id":"spn-35970","text":"Additionally, for client convenience, "},{"id":"spn-35971","marks":["code"],"text":"invoke/v1"},{"id":"spn-35972","text":" allows a "},{"id":"spn-35973","marks":["code"],"text":"prompt"},{"id":"spn-35974","text":" form:"}]},{"id":"blk-32802","items":[{"blocks":[{"id":"blk-32804","kind":"paragraph","spans":[{"id":"spn-35975","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-32803","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32805","kind":"paragraph","spans":[{"id":"spn-35976","text":"When "},{"id":"spn-35977","marks":["code"],"text":"prompt"},{"id":"spn-35978","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-32806","items":[{"blocks":[{"id":"blk-32808","kind":"paragraph","spans":[{"id":"spn-35979","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-32807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32809","kind":"paragraph","spans":[{"id":"spn-35980","text":"Rationale:"}]},{"id":"blk-32810","items":[{"blocks":[{"id":"blk-32812","kind":"paragraph","spans":[{"id":"spn-35981","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-32811","kind":"list-item"},{"blocks":[{"id":"blk-32814","kind":"paragraph","spans":[{"id":"spn-35982","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-32813","kind":"list-item"},{"blocks":[{"id":"blk-32816","kind":"paragraph","spans":[{"id":"spn-35983","text":"it avoids provider-specific payload drift."}]}],"id":"blk-32815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32817","kind":"heading","level":3,"spans":[{"id":"spn-35984","text":"3) Session semantics: opaque "},{"id":"spn-35985","marks":["code"],"text":"sessionId"}]},{"id":"blk-32818","kind":"paragraph","spans":[{"id":"spn-35986","marks":["code"],"text":"invoke/v1"},{"id":"spn-35987","text":" standardizes stateful execution via an opaque "},{"id":"spn-35988","marks":["code"],"text":"sessionId"},{"id":"spn-35989","text":" string:"}]},{"id":"blk-32819","items":[{"blocks":[{"id":"blk-32821","kind":"paragraph","spans":[{"id":"spn-35990","text":"Clients MAY include "},{"id":"spn-35991","marks":["code"],"text":"sessionId"},{"id":"spn-35992","text":" to continue a prior session."}]}],"id":"blk-32820","kind":"list-item"},{"blocks":[{"id":"blk-32823","kind":"paragraph","spans":[{"id":"spn-35993","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-35994","marks":["code"],"text":"sessionId"},{"id":"spn-35995","text":"."}]}],"id":"blk-32822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32824","kind":"paragraph","spans":[{"id":"spn-35996","text":"Rules:"}]},{"id":"blk-32825","items":[{"blocks":[{"id":"blk-32827","kind":"paragraph","spans":[{"id":"spn-35997","marks":["code"],"text":"sessionId"},{"id":"spn-35998","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-32826","kind":"list-item"},{"blocks":[{"id":"blk-32829","kind":"paragraph","spans":[{"id":"spn-35999","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-36000","marks":["code"],"text":"sessionId"},{"id":"spn-36001","text":" string."}]}],"id":"blk-32828","kind":"list-item"},{"blocks":[{"id":"blk-32831","kind":"paragraph","spans":[{"id":"spn-36002","text":"Each runtime provider maps "},{"id":"spn-36003","marks":["code"],"text":"sessionId"},{"id":"spn-36004","text":" to its own session primitive:"}]}],"id":"blk-32830","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32832","items":[{"blocks":[{"id":"blk-32834","kind":"paragraph","spans":[{"id":"spn-36005","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-32833","kind":"list-item"},{"blocks":[{"id":"blk-32836","kind":"paragraph","spans":[{"id":"spn-36006","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-32835","kind":"list-item"},{"blocks":[{"id":"blk-32838","kind":"paragraph","spans":[{"id":"spn-36007","marks":["code"],"text":"sessionId"},{"id":"spn-36008","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-32837","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32839","items":[{"blocks":[{"id":"blk-32841","kind":"paragraph","spans":[{"id":"spn-36009","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-36010","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-36011","text":")"}]}],"id":"blk-32840","kind":"list-item"},{"blocks":[{"id":"blk-32843","kind":"paragraph","spans":[{"id":"spn-36012","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-32842","kind":"list-item"},{"blocks":[{"id":"blk-32845","kind":"paragraph","spans":[{"id":"spn-36013","text":"The adapter MUST treat the "},{"id":"spn-36014","marks":["code"],"text":"sessionId"},{"id":"spn-36015","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-32844","kind":"list-item"},{"blocks":[{"id":"blk-32847","kind":"paragraph","spans":[{"id":"spn-36016","text":"If "},{"id":"spn-36017","marks":["code"],"text":"sessionId"},{"id":"spn-36018","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-36019","marks":["code"],"text":"sessionId"},{"id":"spn-36020","text":"."}]}],"id":"blk-32846","kind":"list-item"},{"blocks":[{"id":"blk-32849","kind":"paragraph","spans":[{"id":"spn-36021","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-32848","kind":"list-item"},{"blocks":[{"id":"blk-32851","kind":"paragraph","spans":[{"id":"spn-36022","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-36023","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-36024","text":" with a safe message such as “Session expired” and "},{"id":"spn-36025","marks":["code"],"text":"retryable=false"},{"id":"spn-36026","text":" (do not leak provider internals)."}]}],"id":"blk-32850","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32852","kind":"paragraph","spans":[{"id":"spn-36027","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-32853","items":[{"blocks":[{"id":"blk-32855","kind":"paragraph","spans":[{"id":"spn-36028","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-36029","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-36030","text":") and a "},{"id":"spn-36031","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-36032","text":" set to the opaque "},{"id":"spn-36033","marks":["code"],"text":"sessionId"},{"id":"spn-36034","text":" (or a newly generated one if absent)."}]}],"id":"blk-32854","kind":"list-item"},{"blocks":[{"id":"blk-32857","kind":"paragraph","spans":[{"id":"spn-36035","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-32856","kind":"list-item"},{"blocks":[{"id":"blk-32859","kind":"paragraph","spans":[{"id":"spn-36036","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-32858","kind":"list-item"},{"blocks":[{"id":"blk-32861","kind":"paragraph","spans":[{"id":"spn-36037","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-32860","kind":"list-item"},{"blocks":[{"id":"blk-32863","kind":"paragraph","spans":[{"id":"spn-36038","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-32862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32864","kind":"heading","level":3,"spans":[{"id":"spn-36039","text":"4) Canonical output: text-first"}]},{"id":"blk-32865","kind":"paragraph","spans":[{"id":"spn-36040","marks":["code"],"text":"invoke/v1"},{"id":"spn-36041","text":" defines the canonical output as:"}]},{"id":"blk-32866","items":[{"blocks":[{"id":"blk-32868","kind":"paragraph","spans":[{"id":"spn-36042","marks":["code"],"text":"output.text: string"},{"id":"spn-36043","text":" (required)"}]}],"id":"blk-32867","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32869","kind":"paragraph","spans":[{"id":"spn-36044","text":"Optionally:"}]},{"id":"blk-32870","items":[{"blocks":[{"id":"blk-32872","kind":"paragraph","spans":[{"id":"spn-36045","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-36046","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-32871","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32873","kind":"paragraph","spans":[{"id":"spn-36047","text":"Rationale:"}]},{"id":"blk-32874","items":[{"blocks":[{"id":"blk-32876","kind":"paragraph","spans":[{"id":"spn-36048","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-32875","kind":"list-item"},{"blocks":[{"id":"blk-32878","kind":"paragraph","spans":[{"id":"spn-36049","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-32877","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32879","kind":"heading","level":3,"spans":[{"id":"spn-36050","text":"5) Usage and correlation are first-class"}]},{"id":"blk-32880","kind":"paragraph","spans":[{"id":"spn-36051","text":"Every "},{"id":"spn-36052","marks":["code"],"text":"invoke/v1"},{"id":"spn-36053","text":" response MUST include:"}]},{"id":"blk-32881","items":[{"blocks":[{"id":"blk-32883","kind":"paragraph","spans":[{"id":"spn-36054","marks":["code"],"text":"traceId: string"},{"id":"spn-36055","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-32882","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32884","kind":"paragraph","spans":[{"id":"spn-36056","text":"Response SHOULD include:"}]},{"id":"blk-32885","items":[{"blocks":[{"id":"blk-32887","kind":"paragraph","spans":[{"id":"spn-36057","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-32886","kind":"list-item"},{"blocks":[{"id":"blk-32889","kind":"paragraph","spans":[{"id":"spn-36058","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-32888","kind":"list-item"},{"blocks":[{"id":"blk-32891","kind":"paragraph","spans":[{"id":"spn-36059","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-36060","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-32890","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32892","kind":"paragraph","spans":[{"id":"spn-36061","text":"Telemetry events MUST include the same "},{"id":"spn-36062","marks":["code"],"text":"traceId"},{"id":"spn-36063","text":" when available, and MUST be attributable to:"}]},{"id":"blk-32893","items":[{"blocks":[{"id":"blk-32895","kind":"paragraph","spans":[{"id":"spn-36064","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-32894","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32896","kind":"heading","level":3,"spans":[{"id":"spn-36065","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-32897","kind":"paragraph","spans":[{"id":"spn-36066","marks":["code"],"text":"invoke/v1"},{"id":"spn-36067","text":" defines streaming semantics via "},{"id":"spn-36068","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-36069","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-32898","items":[{"blocks":[{"id":"blk-32900","kind":"paragraph","spans":[{"id":"spn-36070","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-32899","kind":"list-item"},{"blocks":[{"id":"blk-32902","kind":"paragraph","spans":[{"id":"spn-36071","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-32901","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32903","kind":"paragraph","spans":[{"id":"spn-36072","text":"Standard SSE event types:"}]},{"id":"blk-32904","items":[{"blocks":[{"id":"blk-32906","kind":"paragraph","spans":[{"id":"spn-36073","marks":["code"],"text":"meta"},{"id":"spn-36074","text":" (MUST be first)"}]}],"id":"blk-32905","kind":"list-item"},{"blocks":[{"id":"blk-32908","kind":"paragraph","spans":[{"id":"spn-36075","text":"includes "},{"id":"spn-36076","marks":["code"],"text":"traceId"},{"id":"spn-36077","text":" and "},{"id":"spn-36078","marks":["code"],"text":"sessionId"},{"id":"spn-36079","text":" (if known at start)"}]}],"id":"blk-32907","kind":"list-item"},{"blocks":[{"id":"blk-32910","kind":"paragraph","spans":[{"id":"spn-36080","marks":["code"],"text":"delta"},{"id":"spn-36081","text":" (0..N)"}]}],"id":"blk-32909","kind":"list-item"},{"blocks":[{"id":"blk-32912","kind":"paragraph","spans":[{"id":"spn-36082","text":"includes incremental output text chunks"}]}],"id":"blk-32911","kind":"list-item"},{"blocks":[{"id":"blk-32914","kind":"paragraph","spans":[{"id":"spn-36083","marks":["code"],"text":"usage"},{"id":"spn-36084","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-32913","kind":"list-item"},{"blocks":[{"id":"blk-32916","kind":"paragraph","spans":[{"id":"spn-36085","text":"includes final usage summary when available"}]}],"id":"blk-32915","kind":"list-item"},{"blocks":[{"id":"blk-32918","kind":"paragraph","spans":[{"id":"spn-36086","marks":["code"],"text":"done"},{"id":"spn-36087","text":" (MUST be last on success)"}]}],"id":"blk-32917","kind":"list-item"},{"blocks":[{"id":"blk-32920","kind":"paragraph","spans":[{"id":"spn-36088","marks":["code"],"text":"error"},{"id":"spn-36089","text":" (terminal on failure)"}]}],"id":"blk-32919","kind":"list-item"},{"blocks":[{"id":"blk-32922","kind":"paragraph","spans":[{"id":"spn-36090","text":"includes the normalized error envelope"}]}],"id":"blk-32921","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32923","kind":"paragraph","spans":[{"id":"spn-36091","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-32924","items":[{"blocks":[{"id":"blk-32926","kind":"paragraph","spans":[{"id":"spn-36092","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-36093","marks":["code"],"text":"delta"},{"id":"spn-36094","text":" events)."}]}],"id":"blk-32925","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32927","kind":"paragraph","spans":[{"id":"spn-36095","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-32928","items":[{"blocks":[{"id":"blk-32930","kind":"paragraph","spans":[{"id":"spn-36096","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-32929","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32931","kind":"paragraph","spans":[{"id":"spn-36097","text":"Rationale:"}]},{"id":"blk-32932","items":[{"blocks":[{"id":"blk-32934","kind":"paragraph","spans":[{"id":"spn-36098","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-32933","kind":"list-item"},{"blocks":[{"id":"blk-32936","kind":"paragraph","spans":[{"id":"spn-36099","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-32935","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32937","kind":"heading","level":2,"spans":[{"id":"spn-36100","text":"Alternatives considered"}]},{"id":"blk-32938","kind":"heading","level":3,"spans":[{"id":"spn-36101","text":"A) Prompt-only protocol"}]},{"id":"blk-32939","kind":"paragraph","spans":[{"id":"spn-36102","text":"Pros:"}]},{"id":"blk-32940","items":[{"blocks":[{"id":"blk-32942","kind":"paragraph","spans":[{"id":"spn-36103","text":"simplest request shape"}]}],"id":"blk-32941","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32943","kind":"paragraph","spans":[{"id":"spn-36104","text":"Cons:"}]},{"id":"blk-32944","items":[{"blocks":[{"id":"blk-32946","kind":"paragraph","spans":[{"id":"spn-36105","text":"loses structured conversation context"}]}],"id":"blk-32945","kind":"list-item"},{"blocks":[{"id":"blk-32948","kind":"paragraph","spans":[{"id":"spn-36106","text":"complicates future tool call integration"}]}],"id":"blk-32947","kind":"list-item"},{"blocks":[{"id":"blk-32950","kind":"paragraph","spans":[{"id":"spn-36107","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-32949","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32951","kind":"paragraph","spans":[{"id":"spn-36108","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-32952","kind":"heading","level":3,"spans":[{"id":"spn-36109","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-32953","kind":"paragraph","spans":[{"id":"spn-36110","text":"Pros:"}]},{"id":"blk-32954","items":[{"blocks":[{"id":"blk-32956","kind":"paragraph","spans":[{"id":"spn-36111","text":"maximum leverage of each provider’s features"}]}],"id":"blk-32955","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32957","kind":"paragraph","spans":[{"id":"spn-36112","text":"Cons:"}]},{"id":"blk-32958","items":[{"blocks":[{"id":"blk-32960","kind":"paragraph","spans":[{"id":"spn-36113","text":"breaks portability and unified SDKs"}]}],"id":"blk-32959","kind":"list-item"},{"blocks":[{"id":"blk-32962","kind":"paragraph","spans":[{"id":"spn-36114","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-32961","kind":"list-item"},{"blocks":[{"id":"blk-32964","kind":"paragraph","spans":[{"id":"spn-36115","text":"increases maintenance and user confusion"}]}],"id":"blk-32963","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32965","kind":"paragraph","spans":[{"id":"spn-36116","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-32966","kind":"heading","level":3,"spans":[{"id":"spn-36117","text":"C) WebSockets for streaming"}]},{"id":"blk-32967","kind":"paragraph","spans":[{"id":"spn-36118","text":"Pros:"}]},{"id":"blk-32968","items":[{"blocks":[{"id":"blk-32970","kind":"paragraph","spans":[{"id":"spn-36119","text":"bidirectional, flexible"}]}],"id":"blk-32969","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32971","kind":"paragraph","spans":[{"id":"spn-36120","text":"Cons:"}]},{"id":"blk-32972","items":[{"blocks":[{"id":"blk-32974","kind":"paragraph","spans":[{"id":"spn-36121","text":"more operational complexity (connection state, proxies)"}]}],"id":"blk-32973","kind":"list-item"},{"blocks":[{"id":"blk-32976","kind":"paragraph","spans":[{"id":"spn-36122","text":"not necessary for v1"}]}],"id":"blk-32975","kind":"list-item"},{"blocks":[{"id":"blk-32978","kind":"paragraph","spans":[{"id":"spn-36123","text":"harder to support across platforms and edge gateways"}]}],"id":"blk-32977","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32979","kind":"paragraph","spans":[{"id":"spn-36124","text":"Rejected for v1; SSE is sufficient for streaming output. WebSockets can be introduced later if interactive tool call UX requires it."}]},{"id":"blk-32980","kind":"heading","level":3,"spans":[{"id":"spn-36125","text":"D) gRPC for invocation"}]},{"id":"blk-32981","kind":"paragraph","spans":[{"id":"spn-36126","text":"Pros:"}]},{"id":"blk-32982","items":[{"blocks":[{"id":"blk-32984","kind":"paragraph","spans":[{"id":"spn-36127","text":"strict contracts, performance"}]}],"id":"blk-32983","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32985","kind":"paragraph","spans":[{"id":"spn-36128","text":"Cons:"}]},{"id":"blk-32986","items":[{"blocks":[{"id":"blk-32988","kind":"paragraph","spans":[{"id":"spn-36129","text":"browser compatibility constraints"}]}],"id":"blk-32987","kind":"list-item"},{"blocks":[{"id":"blk-32990","kind":"paragraph","spans":[{"id":"spn-36130","text":"higher adoption friction"}]}],"id":"blk-32989","kind":"list-item"},{"blocks":[{"id":"blk-32992","kind":"paragraph","spans":[{"id":"spn-36131","text":"more infrastructure requirements"}]}],"id":"blk-32991","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32993","kind":"paragraph","spans":[{"id":"spn-36132","text":"Rejected for v1; HTTP+JSON and SSE are simpler and adequate."}]},{"id":"blk-32994","kind":"heading","level":2,"spans":[{"id":"spn-36133","text":"Consequences"}]},{"id":"blk-32995","kind":"heading","level":3,"spans":[{"id":"spn-36134","text":"Positive"}]},{"id":"blk-32996","items":[{"blocks":[{"id":"blk-32998","kind":"paragraph","spans":[{"id":"spn-36135","text":"Stable, runtime-agnostic contract for clients and SDKs."}]}],"id":"blk-32997","kind":"list-item"},{"blocks":[{"id":"blk-33000","kind":"paragraph","spans":[{"id":"spn-36136","text":"Simplifies the invocation gateway and adapter logic (one normalized shape)."}]}],"id":"blk-32999","kind":"list-item"},{"blocks":[{"id":"blk-33002","kind":"paragraph","spans":[{"id":"spn-36137","text":"Enables consistent telemetry attribution and usage accounting."}]}],"id":"blk-33001","kind":"list-item"},{"blocks":[{"id":"blk-33004","kind":"paragraph","spans":[{"id":"spn-36138","text":"Makes streaming UX consistent across runtimes."}]}],"id":"blk-33003","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33005","kind":"heading","level":3,"spans":[{"id":"spn-36139","text":"Negative / tradeoffs"}]},{"id":"blk-33006","items":[{"blocks":[{"id":"blk-33008","kind":"paragraph","spans":[{"id":"spn-36140","text":"Some provider-native features won’t map cleanly to v1 without extensions (e.g., tool call transcripts)."}]}],"id":"blk-33007","kind":"list-item"},{"blocks":[{"id":"blk-33010","kind":"paragraph","spans":[{"id":"spn-36141","text":"Streaming emulation may not reflect true token-level timing for non-streaming providers."}]}],"id":"blk-33009","kind":"list-item"},{"blocks":[{"id":"blk-33012","kind":"paragraph","spans":[{"id":"spn-36142","text":"Token counts and usage fields may be estimated or unavailable for some providers; must be communicated as such."}]}],"id":"blk-33011","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33013","kind":"heading","level":2,"spans":[{"id":"spn-36143","text":"Implementation details (normative requirements)"}]},{"id":"blk-33014","kind":"heading","level":3,"spans":[{"id":"spn-36144","text":"1) Protocol versioning"}]},{"id":"blk-33015","items":[{"blocks":[{"id":"blk-33017","kind":"paragraph","spans":[{"id":"spn-36145","text":"Every deployment artifact manifest MUST declare "},{"id":"spn-36146","marks":["code"],"text":"protocol: \"invoke/v1\""},{"id":"spn-36147","text":"."}]}],"id":"blk-33016","kind":"list-item"},{"blocks":[{"id":"blk-33019","kind":"paragraph","spans":[{"id":"spn-36148","text":"The control plane MUST reject deployments with unknown protocol versions ("},{"id":"spn-36149","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-36150","text":")."}]}],"id":"blk-33018","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33020","kind":"heading","level":3,"spans":[{"id":"spn-36151","text":"2) Request normalization rules"}]},{"id":"blk-33021","items":[{"blocks":[{"id":"blk-33023","kind":"paragraph","spans":[{"id":"spn-36152","text":"If "},{"id":"spn-36153","marks":["code"],"text":"input.prompt"},{"id":"spn-36154","text":" provided and "},{"id":"spn-36155","marks":["code"],"text":"input.messages"},{"id":"spn-36156","text":" missing:"}]}],"id":"blk-33022","kind":"list-item"},{"blocks":[{"id":"blk-33025","kind":"paragraph","spans":[{"id":"spn-36157","text":"normalize to one user message."}]}],"id":"blk-33024","kind":"list-item"},{"blocks":[{"id":"blk-33027","kind":"paragraph","spans":[{"id":"spn-36158","text":"If both are provided:"}]}],"id":"blk-33026","kind":"list-item"},{"blocks":[{"id":"blk-33029","kind":"paragraph","spans":[{"id":"spn-36159","text":"prefer "},{"id":"spn-36160","marks":["code"],"text":"messages"},{"id":"spn-36161","text":" and ignore "},{"id":"spn-36162","marks":["code"],"text":"prompt"},{"id":"spn-36163","text":" (or reject as invalid; choose one consistent policy; v1 recommendation: reject with "},{"id":"spn-36164","marks":["code"],"text":"INVALID_REQUEST"},{"id":"spn-36165","text":" to avoid ambiguity)."}]}],"id":"blk-33028","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-33030","kind":"heading","level":3,"spans":[{"id":"spn-36166","text":"3) Session rules"}]},{"id":"blk-33031","items":[{"blocks":[{"id":"blk-33033","kind":"para