{"bendscript":"0.1","blocks":[{"id":"blk-52759","kind":"heading","level":1,"spans":[{"id":"spn-80998","text":"ADR-0006: Canonical Invocation Protocol (invoke/v1) and Streaming Strategy"}]},{"id":"blk-52760","kind":"paragraph","spans":[{"id":"spn-80999","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-52761","items":[{"blocks":[{"id":"blk-52763","kind":"paragraph","spans":[{"id":"spn-81000","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-52762","kind":"list-item"},{"blocks":[{"id":"blk-52765","kind":"paragraph","spans":[{"id":"spn-81001","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-52764","kind":"list-item"},{"blocks":[{"id":"blk-52767","kind":"paragraph","spans":[{"id":"spn-81002","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-52766","kind":"list-item"},{"blocks":[{"id":"blk-52769","kind":"paragraph","spans":[{"id":"spn-81003","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-52768","kind":"list-item"},{"blocks":[{"id":"blk-52771","kind":"paragraph","spans":[{"id":"spn-81004","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-52770","kind":"list-item"},{"blocks":[{"id":"blk-52773","kind":"paragraph","spans":[{"id":"spn-81005","marks":["code"],"text":"WebHost.Systems/docs/spec/adr/ADR-0008-delegated-invocation-auth.md"},{"id":"spn-81006","text":" (delegated invocation auth mode; preserves invoke/v1 semantics)"}]}],"id":"blk-52772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52774","kind":"heading","level":2,"spans":[{"id":"spn-81007","text":"Context"}]},{"id":"blk-52775","kind":"paragraph","spans":[{"id":"spn-81008","text":"webhost.systems is a multi-runtime platform for deploying and running customer AI agents. The system must route invocations through a control plane to one of multiple data plane runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore), while maintaining:"}]},{"id":"blk-52776","items":[{"blocks":[{"id":"blk-52778","kind":"paragraph","spans":[{"id":"spn-81009","text":"a stable external API for clients and the dashboard,"}]}],"id":"blk-52777","kind":"list-item"},{"blocks":[{"id":"blk-52780","kind":"paragraph","spans":[{"id":"spn-81010","text":"consistent session semantics across runtimes,"}]}],"id":"blk-52779","kind":"list-item"},{"blocks":[{"id":"blk-52782","kind":"paragraph","spans":[{"id":"spn-81011","text":"consistent telemetry attribution and usage/cost accounting,"}]}],"id":"blk-52781","kind":"list-item"},{"blocks":[{"id":"blk-52784","kind":"paragraph","spans":[{"id":"spn-81012","text":"safe error handling and sanitization,"}]}],"id":"blk-52783","kind":"list-item"},{"blocks":[{"id":"blk-52786","kind":"paragraph","spans":[{"id":"spn-81013","text":"optional streaming output for good UX."}]}],"id":"blk-52785","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52787","kind":"paragraph","spans":[{"id":"spn-81014","text":"Without a canonical invocation protocol, each runtime will expose different request/response shapes (prompt-only vs message arrays, provider-specific session concepts, different streaming models, tool call shapes). This would make:"}]},{"id":"blk-52788","items":[{"blocks":[{"id":"blk-52790","kind":"paragraph","spans":[{"id":"spn-81015","text":"the invocation gateway hard to implement and evolve,"}]}],"id":"blk-52789","kind":"list-item"},{"blocks":[{"id":"blk-52792","kind":"paragraph","spans":[{"id":"spn-81016","text":"SDKs hard to write,"}]}],"id":"blk-52791","kind":"list-item"},{"blocks":[{"id":"blk-52794","kind":"paragraph","spans":[{"id":"spn-81017","text":"telemetry inconsistent,"}]}],"id":"blk-52793","kind":"list-item"},{"blocks":[{"id":"blk-52796","kind":"paragraph","spans":[{"id":"spn-81018","text":"limit enforcement unreliable."}]}],"id":"blk-52795","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52797","kind":"paragraph","spans":[{"id":"spn-81019","text":"We need a single “invoke contract” that the control plane and adapters can enforce, plus an explicit streaming model that works across runtimes."}]},{"id":"blk-52798","kind":"heading","level":2,"spans":[{"id":"spn-81020","text":"Decision"}]},{"id":"blk-52799","kind":"heading","level":3,"spans":[{"id":"spn-81021","text":"1) Adopt a canonical invocation protocol: "},{"id":"spn-81022","marks":["code"],"text":"invoke/v1"}]},{"id":"blk-52800","kind":"paragraph","spans":[{"id":"spn-81023","text":"All invocations in webhost.systems use a single protocol version identifier:"}]},{"id":"blk-52801","items":[{"blocks":[{"id":"blk-52803","kind":"paragraph","spans":[{"id":"spn-81024","marks":["code"],"text":"protocol = \"invoke/v1\""}]}],"id":"blk-52802","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52804","kind":"paragraph","spans":[{"id":"spn-81025","text":"The protocol applies to:"}]},{"id":"blk-52805","items":[{"blocks":[{"id":"blk-52807","kind":"paragraph","spans":[{"id":"spn-81026","text":"the invocation gateway API (client -> control plane),"}]}],"id":"blk-52806","kind":"list-item"},{"blocks":[{"id":"blk-52809","kind":"paragraph","spans":[{"id":"spn-81027","text":"the internal Runtime Provider Interface (control plane -> provider adapters),"}]}],"id":"blk-52808","kind":"list-item"},{"blocks":[{"id":"blk-52811","kind":"paragraph","spans":[{"id":"spn-81028","text":"the runtime payloads (as applicable) for data plane execution,"}]}],"id":"blk-52810","kind":"list-item"},{"blocks":[{"id":"blk-52813","kind":"paragraph","spans":[{"id":"spn-81029","text":"telemetry correlation via "},{"id":"spn-81030","marks":["code"],"text":"traceId"},{"id":"spn-81031","text":"."}]}],"id":"blk-52812","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52814","kind":"paragraph","spans":[{"id":"spn-81032","text":"Note: Additional authentication modes (e.g., delegated server-to-server invocation) MUST NOT introduce a new protocol shape. They preserve the same "},{"id":"spn-81033","marks":["code"],"text":"invoke/v1"},{"id":"spn-81034","text":" request/response semantics and differ only in how the invocation gateway authenticates and attributes the caller. See "},{"id":"spn-81035","marks":["code"],"text":"ADR-0008-delegated-invocation-auth.md"},{"id":"spn-81036","text":"."}]},{"id":"blk-52815","kind":"heading","level":3,"spans":[{"id":"spn-81037","text":"2) Canonical input: chat messages (with prompt convenience)"}]},{"id":"blk-52816","kind":"paragraph","spans":[{"id":"spn-81038","marks":["code"],"text":"invoke/v1"},{"id":"spn-81039","text":" defines the canonical input shape as chat "},{"id":"spn-81040","marks":["code"],"text":"messages"},{"id":"spn-81041","text":":"}]},{"id":"blk-52817","items":[{"blocks":[{"id":"blk-52819","kind":"paragraph","spans":[{"id":"spn-81042","marks":["code"],"text":"input.messages: Array<{ role, content }>"}]}],"id":"blk-52818","kind":"list-item"},{"blocks":[{"id":"blk-52821","kind":"paragraph","spans":[{"id":"spn-81043","marks":["code"],"text":"role ∈ { \"system\", \"user\", \"assistant\", \"tool\" }"}]}],"id":"blk-52820","kind":"list-item"},{"blocks":[{"id":"blk-52823","kind":"paragraph","spans":[{"id":"spn-81044","marks":["code"],"text":"content: string"}]}],"id":"blk-52822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52824","kind":"paragraph","spans":[{"id":"spn-81045","text":"Additionally, for client convenience, "},{"id":"spn-81046","marks":["code"],"text":"invoke/v1"},{"id":"spn-81047","text":" allows a "},{"id":"spn-81048","marks":["code"],"text":"prompt"},{"id":"spn-81049","text":" form:"}]},{"id":"blk-52825","items":[{"blocks":[{"id":"blk-52827","kind":"paragraph","spans":[{"id":"spn-81050","marks":["code"],"text":"input.prompt: string"}]}],"id":"blk-52826","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52828","kind":"paragraph","spans":[{"id":"spn-81051","text":"When "},{"id":"spn-81052","marks":["code"],"text":"prompt"},{"id":"spn-81053","text":" is provided, the control plane MUST normalize it to:"}]},{"id":"blk-52829","items":[{"blocks":[{"id":"blk-52831","kind":"paragraph","spans":[{"id":"spn-81054","marks":["code"],"text":"messages = [{ role: \"user\", content: prompt }]"}]}],"id":"blk-52830","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52832","kind":"paragraph","spans":[{"id":"spn-81055","text":"Rationale:"}]},{"id":"blk-52833","items":[{"blocks":[{"id":"blk-52835","kind":"paragraph","spans":[{"id":"spn-81056","text":"“messages” is compatible with most modern LLM/agent frameworks,"}]}],"id":"blk-52834","kind":"list-item"},{"blocks":[{"id":"blk-52837","kind":"paragraph","spans":[{"id":"spn-81057","text":"it supports future tool call and transcript semantics,"}]}],"id":"blk-52836","kind":"list-item"},{"blocks":[{"id":"blk-52839","kind":"paragraph","spans":[{"id":"spn-81058","text":"it avoids provider-specific payload drift."}]}],"id":"blk-52838","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52840","kind":"heading","level":3,"spans":[{"id":"spn-81059","text":"3) Session semantics: opaque "},{"id":"spn-81060","marks":["code"],"text":"sessionId"}]},{"id":"blk-52841","kind":"paragraph","spans":[{"id":"spn-81061","marks":["code"],"text":"invoke/v1"},{"id":"spn-81062","text":" standardizes stateful execution via an opaque "},{"id":"spn-81063","marks":["code"],"text":"sessionId"},{"id":"spn-81064","text":" string:"}]},{"id":"blk-52842","items":[{"blocks":[{"id":"blk-52844","kind":"paragraph","spans":[{"id":"spn-81065","text":"Clients MAY include "},{"id":"spn-81066","marks":["code"],"text":"sessionId"},{"id":"spn-81067","text":" to continue a prior session."}]}],"id":"blk-52843","kind":"list-item"},{"blocks":[{"id":"blk-52846","kind":"paragraph","spans":[{"id":"spn-81068","text":"If omitted, the system MAY create a new session and return a new "},{"id":"spn-81069","marks":["code"],"text":"sessionId"},{"id":"spn-81070","text":"."}]}],"id":"blk-52845","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52847","kind":"paragraph","spans":[{"id":"spn-81071","text":"Rules:"}]},{"id":"blk-52848","items":[{"blocks":[{"id":"blk-52850","kind":"paragraph","spans":[{"id":"spn-81072","marks":["code"],"text":"sessionId"},{"id":"spn-81073","text":" is opaque; clients MUST NOT parse it."}]}],"id":"blk-52849","kind":"list-item"},{"blocks":[{"id":"blk-52852","kind":"paragraph","spans":[{"id":"spn-81074","text":"The control plane MUST treat it as opaque and MUST NOT embed meaning or routing logic in the "},{"id":"spn-81075","marks":["code"],"text":"sessionId"},{"id":"spn-81076","text":" string."}]}],"id":"blk-52851","kind":"list-item"},{"blocks":[{"id":"blk-52854","kind":"paragraph","spans":[{"id":"spn-81077","text":"Each runtime provider maps "},{"id":"spn-81078","marks":["code"],"text":"sessionId"},{"id":"spn-81079","text":" to its own session primitive:"}]}],"id":"blk-52853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52855","items":[{"blocks":[{"id":"blk-52857","kind":"paragraph","spans":[{"id":"spn-81080","text":"Cloudflare: Durable Object id / instance key"}]}],"id":"blk-52856","kind":"list-item"},{"blocks":[{"id":"blk-52859","kind":"paragraph","spans":[{"id":"spn-81081","text":"Session state is stored in Durable Object storage."}]}],"id":"blk-52858","kind":"list-item"},{"blocks":[{"id":"blk-52861","kind":"paragraph","spans":[{"id":"spn-81082","marks":["code"],"text":"sessionId"},{"id":"spn-81083","text":" typically maps 1:1 to a DO instance identifier."}]}],"id":"blk-52860","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52862","items":[{"blocks":[{"id":"blk-52864","kind":"paragraph","spans":[{"id":"spn-81084","text":"AgentCore: AgentCore runtime session identifier (e.g., "},{"id":"spn-81085","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-81086","text":")"}]}],"id":"blk-52863","kind":"list-item"},{"blocks":[{"id":"blk-52866","kind":"paragraph","spans":[{"id":"spn-81087","text":"AgentCore is TypeScript-capable end-to-end (control plane and runtime integration), so the adapter SHOULD use the official TypeScript AWS SDK to invoke sessions."}]}],"id":"blk-52865","kind":"list-item"},{"blocks":[{"id":"blk-52868","kind":"paragraph","spans":[{"id":"spn-81088","text":"The adapter MUST treat the "},{"id":"spn-81089","marks":["code"],"text":"sessionId"},{"id":"spn-81090","text":" as a provider runtime session id and pass it through to invocation calls."}]}],"id":"blk-52867","kind":"list-item"},{"blocks":[{"id":"blk-52870","kind":"paragraph","spans":[{"id":"spn-81091","text":"If "},{"id":"spn-81092","marks":["code"],"text":"sessionId"},{"id":"spn-81093","text":" is not provided, the adapter SHOULD create one (or let the provider return one) and return it to the client as the opaque "},{"id":"spn-81094","marks":["code"],"text":"sessionId"},{"id":"spn-81095","text":"."}]}],"id":"blk-52869","kind":"list-item"},{"blocks":[{"id":"blk-52872","kind":"paragraph","spans":[{"id":"spn-81096","text":"Session expiration MUST be handled gracefully and consistently:"}]}],"id":"blk-52871","kind":"list-item"},{"blocks":[{"id":"blk-52874","kind":"paragraph","spans":[{"id":"spn-81097","text":"if the provider indicates “unknown/expired session”, return a normalized "},{"id":"spn-81098","marks":["code"],"text":"RUNTIME_ERROR"},{"id":"spn-81099","text":" with a safe message such as “Session expired” and "},{"id":"spn-81100","marks":["code"],"text":"retryable=false"},{"id":"spn-81101","text":" (do not leak provider internals)."}]}],"id":"blk-52873","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52875","kind":"paragraph","spans":[{"id":"spn-81102","text":"Implementation note (AgentCore TypeScript invocation shape, conceptual):"}]},{"id":"blk-52876","items":[{"blocks":[{"id":"blk-52878","kind":"paragraph","spans":[{"id":"spn-81103","text":"Invoke with the deployment’s AgentCore runtime reference (e.g., "},{"id":"spn-81104","marks":["code"],"text":"agentRuntimeArn"},{"id":"spn-81105","text":") and a "},{"id":"spn-81106","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-81107","text":" set to the opaque "},{"id":"spn-81108","marks":["code"],"text":"sessionId"},{"id":"spn-81109","text":" (or a newly generated one if absent)."}]}],"id":"blk-52877","kind":"list-item"},{"blocks":[{"id":"blk-52880","kind":"paragraph","spans":[{"id":"spn-81110","text":"Example fields you will typically populate via the TypeScript AWS SDK:"}]}],"id":"blk-52879","kind":"list-item"},{"blocks":[{"id":"blk-52882","kind":"paragraph","spans":[{"id":"spn-81111","marks":["code"],"text":"agentRuntimeArn: <from deployment.providerRef.agentcore.agentRuntimeArn>"}]}],"id":"blk-52881","kind":"list-item"},{"blocks":[{"id":"blk-52884","kind":"paragraph","spans":[{"id":"spn-81112","marks":["code"],"text":"runtimeSessionId: sessionId || <new session id>"}]}],"id":"blk-52883","kind":"list-item"},{"blocks":[{"id":"blk-52886","kind":"paragraph","spans":[{"id":"spn-81113","marks":["code"],"text":"payload: <encoded invoke/v1 request JSON>"}]}],"id":"blk-52885","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52887","kind":"heading","level":3,"spans":[{"id":"spn-81114","text":"4) Canonical output: text-first"}]},{"id":"blk-52888","kind":"paragraph","spans":[{"id":"spn-81115","marks":["code"],"text":"invoke/v1"},{"id":"spn-81116","text":" defines the canonical output as:"}]},{"id":"blk-52889","items":[{"blocks":[{"id":"blk-52891","kind":"paragraph","spans":[{"id":"spn-81117","marks":["code"],"text":"output.text: string"},{"id":"spn-81118","text":" (required)"}]}],"id":"blk-52890","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52892","kind":"paragraph","spans":[{"id":"spn-81119","text":"Optionally:"}]},{"id":"blk-52893","items":[{"blocks":[{"id":"blk-52895","kind":"paragraph","spans":[{"id":"spn-81120","marks":["code"],"text":"output.messages?: transcript array"},{"id":"spn-81121","text":" (MAY in v1; SHOULD be added later only if stable across runtimes)"}]}],"id":"blk-52894","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52896","kind":"paragraph","spans":[{"id":"spn-81122","text":"Rationale:"}]},{"id":"blk-52897","items":[{"blocks":[{"id":"blk-52899","kind":"paragraph","spans":[{"id":"spn-81123","text":"text-first is sufficient for v1 UX and reduces cross-runtime complexity."}]}],"id":"blk-52898","kind":"list-item"},{"blocks":[{"id":"blk-52901","kind":"paragraph","spans":[{"id":"spn-81124","text":"transcript support can be added later without breaking existing clients."}]}],"id":"blk-52900","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52902","kind":"heading","level":3,"spans":[{"id":"spn-81125","text":"5) Usage and correlation are first-class"}]},{"id":"blk-52903","kind":"paragraph","spans":[{"id":"spn-81126","text":"Every "},{"id":"spn-81127","marks":["code"],"text":"invoke/v1"},{"id":"spn-81128","text":" response MUST include:"}]},{"id":"blk-52904","items":[{"blocks":[{"id":"blk-52906","kind":"paragraph","spans":[{"id":"spn-81129","marks":["code"],"text":"traceId: string"},{"id":"spn-81130","text":" (generated by the invocation gateway if not provided)"}]}],"id":"blk-52905","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52907","kind":"paragraph","spans":[{"id":"spn-81131","text":"Response SHOULD include:"}]},{"id":"blk-52908","items":[{"blocks":[{"id":"blk-52910","kind":"paragraph","spans":[{"id":"spn-81132","marks":["code"],"text":"usage.tokens?: number"}]}],"id":"blk-52909","kind":"list-item"},{"blocks":[{"id":"blk-52912","kind":"paragraph","spans":[{"id":"spn-81133","marks":["code"],"text":"usage.computeMs?: number"}]}],"id":"blk-52911","kind":"list-item"},{"blocks":[{"id":"blk-52914","kind":"paragraph","spans":[{"id":"spn-81134","marks":["code"],"text":"usage.toolCalls?: number"},{"id":"spn-81135","text":" (or provider-specific tooling counters normalized when available)"}]}],"id":"blk-52913","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52915","kind":"paragraph","spans":[{"id":"spn-81136","text":"Telemetry events MUST include the same "},{"id":"spn-81137","marks":["code"],"text":"traceId"},{"id":"spn-81138","text":" when available, and MUST be attributable to:"}]},{"id":"blk-52916","items":[{"blocks":[{"id":"blk-52918","kind":"paragraph","spans":[{"id":"spn-81139","marks":["code"],"text":"{ userId, agentId, deploymentId, runtimeProvider, timestamp }"}]}],"id":"blk-52917","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52919","kind":"heading","level":3,"spans":[{"id":"spn-81140","text":"6) Streaming strategy: SSE as the standard transport"}]},{"id":"blk-52920","kind":"paragraph","spans":[{"id":"spn-81141","marks":["code"],"text":"invoke/v1"},{"id":"spn-81142","text":" defines streaming semantics via "},{"id":"spn-81143","marks":["bold"],"text":"Server-Sent Events (SSE)"},{"id":"spn-81144","text":" on a dedicated streaming endpoint:"}]},{"id":"blk-52921","items":[{"blocks":[{"id":"blk-52923","kind":"paragraph","spans":[{"id":"spn-81145","marks":["code"],"text":"POST /v1/invoke/{agentId}/stream"}]}],"id":"blk-52922","kind":"list-item"},{"blocks":[{"id":"blk-52925","kind":"paragraph","spans":[{"id":"spn-81146","marks":["code"],"text":"Accept: text/event-stream"}]}],"id":"blk-52924","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52926","kind":"paragraph","spans":[{"id":"spn-81147","text":"Standard SSE event types:"}]},{"id":"blk-52927","items":[{"blocks":[{"id":"blk-52929","kind":"paragraph","spans":[{"id":"spn-81148","marks":["code"],"text":"meta"},{"id":"spn-81149","text":" (MUST be first)"}]}],"id":"blk-52928","kind":"list-item"},{"blocks":[{"id":"blk-52931","kind":"paragraph","spans":[{"id":"spn-81150","text":"includes "},{"id":"spn-81151","marks":["code"],"text":"traceId"},{"id":"spn-81152","text":" and "},{"id":"spn-81153","marks":["code"],"text":"sessionId"},{"id":"spn-81154","text":" (if known at start)"}]}],"id":"blk-52930","kind":"list-item"},{"blocks":[{"id":"blk-52933","kind":"paragraph","spans":[{"id":"spn-81155","marks":["code"],"text":"delta"},{"id":"spn-81156","text":" (0..N)"}]}],"id":"blk-52932","kind":"list-item"},{"blocks":[{"id":"blk-52935","kind":"paragraph","spans":[{"id":"spn-81157","text":"includes incremental output text chunks"}]}],"id":"blk-52934","kind":"list-item"},{"blocks":[{"id":"blk-52937","kind":"paragraph","spans":[{"id":"spn-81158","marks":["code"],"text":"usage"},{"id":"spn-81159","text":" (0..1; SHOULD be emitted before done)"}]}],"id":"blk-52936","kind":"list-item"},{"blocks":[{"id":"blk-52939","kind":"paragraph","spans":[{"id":"spn-81160","text":"includes final usage summary when available"}]}],"id":"blk-52938","kind":"list-item"},{"blocks":[{"id":"blk-52941","kind":"paragraph","spans":[{"id":"spn-81161","marks":["code"],"text":"done"},{"id":"spn-81162","text":" (MUST be last on success)"}]}],"id":"blk-52940","kind":"list-item"},{"blocks":[{"id":"blk-52943","kind":"paragraph","spans":[{"id":"spn-81163","marks":["code"],"text":"error"},{"id":"spn-81164","text":" (terminal on failure)"}]}],"id":"blk-52942","kind":"list-item"},{"blocks":[{"id":"blk-52945","kind":"paragraph","spans":[{"id":"spn-81165","text":"includes the normalized error envelope"}]}],"id":"blk-52944","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52946","kind":"paragraph","spans":[{"id":"spn-81166","text":"If a runtime provider supports true streaming:"}]},{"id":"blk-52947","items":[{"blocks":[{"id":"blk-52949","kind":"paragraph","spans":[{"id":"spn-81167","text":"the adapter SHOULD pass-through streaming (mapping provider stream to "},{"id":"spn-81168","marks":["code"],"text":"delta"},{"id":"spn-81169","text":" events)."}]}],"id":"blk-52948","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52950","kind":"paragraph","spans":[{"id":"spn-81170","text":"If a runtime provider does not support streaming:"}]},{"id":"blk-52951","items":[{"blocks":[{"id":"blk-52953","kind":"paragraph","spans":[{"id":"spn-81171","text":"the adapter MAY emulate streaming by buffering and chunking output, but MUST preserve ordering and terminal events."}]}],"id":"blk-52952","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52954","kind":"paragraph","spans":[{"id":"spn-81172","text":"Rationale:"}]},{"id":"blk-52955","items":[{"blocks":[{"id":"blk-52957","kind":"paragraph","spans":[{"id":"spn-81173","text":"SSE is widely supported, simple, and works well for “text token streaming”."}]}],"id":"blk-52956","kind":"list-item"},{"blocks":[{"id":"blk-52959","kind":"paragraph","spans":[{"id":"spn-81174","text":"A consistent event schema enables a unified client and UI implementation."}]}],"id":"blk-52958","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52960","kind":"heading","level":2,"spans":[{"id":"spn-81175","text":"Alternatives considered"}]},{"id":"blk-52961","kind":"heading","level":3,"spans":[{"id":"spn-81176","text":"A) Prompt-only protocol"}]},{"id":"blk-52962","kind":"paragraph","spans":[{"id":"spn-81177","text":"Pros:"}]},{"id":"blk-52963","items":[{"blocks":[{"id":"blk-52965","kind":"paragraph","spans":[{"id":"spn-81178","text":"simplest request shape"}]}],"id":"blk-52964","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52966","kind":"paragraph","spans":[{"id":"spn-81179","text":"Cons:"}]},{"id":"blk-52967","items":[{"blocks":[{"id":"blk-52969","kind":"paragraph","spans":[{"id":"spn-81180","text":"loses structured conversation context"}]}],"id":"blk-52968","kind":"list-item"},{"blocks":[{"id":"blk-52971","kind":"paragraph","spans":[{"id":"spn-81181","text":"complicates future tool call integration"}]}],"id":"blk-52970","kind":"list-item"},{"blocks":[{"id":"blk-52973","kind":"paragraph","spans":[{"id":"spn-81182","text":"diverges from modern agent UX and frameworks"}]}],"id":"blk-52972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52974","kind":"paragraph","spans":[{"id":"spn-81183","text":"Rejected because messages are the better canonical baseline with a prompt convenience fallback."}]},{"id":"blk-52975","kind":"heading","level":3,"spans":[{"id":"spn-81184","text":"B) Provider-specific protocols per runtime"}]},{"id":"blk-52976","kind":"paragraph","spans":[{"id":"spn-81185","text":"Pros:"}]},{"id":"blk-52977","items":[{"blocks":[{"id":"blk-52979","kind":"paragraph","spans":[{"id":"spn-81186","text":"maximum leverage of each provider’s features"}]}],"id":"blk-52978","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52980","kind":"paragraph","spans":[{"id":"spn-81187","text":"Cons:"}]},{"id":"blk-52981","items":[{"blocks":[{"id":"blk-52983","kind":"paragraph","spans":[{"id":"spn-81188","text":"breaks portability and unified SDKs"}]}],"id":"blk-52982","kind":"list-item"},{"blocks":[{"id":"blk-52985","kind":"paragraph","spans":[{"id":"spn-81189","text":"complicates limit enforcement and telemetry"}]}],"id":"blk-52984","kind":"list-item"},{"blocks":[{"id":"blk-52987","kind":"paragraph","spans":[{"id":"spn-81190","text":"increases maintenance and user confusion"}]}],"id":"blk-52986","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52988","kind":"paragraph","spans":[{"id":"spn-81191","text":"Rejected because webhost.systems differentiates on portability and unified control plane semantics."}]},{"id":"blk-52989","kind":"heading","level":3,"spans":[{"id":"spn-81192","text":"C) WebSockets for streaming"}]},{"id":"blk-52990","kind":"paragraph","spans":[{"id":"spn-81193","text":"Pros:"}]},{"id":"blk-52991","items":[{"blocks":[{"id":"blk-52993","kind":"paragraph","spans":[{"id":"spn-81194","text":"bidirectional, flexible"}]}],"id":"blk-52992","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52994","kind":"paragraph","spans":[{"id":"spn-81195","text":"Cons:"}]},{"id":"blk-52995","items":[{"blocks":[{"id":"blk-52997","kind":"paragraph","spans":[{"id":"spn-81196","text":"more operational complexity (connection state, proxies)"}]}],"id":"blk-52996","kind":"list-item"},{"blocks":[{"id":"blk-52999","kind":"paragraph","spans":[{"id":"spn-81197","text":"not necessary for v1"}]}],"id":"blk-52998","kind":"list-item"},{"blocks":[{"id":"blk-53001","kind":"paragraph","spans":[{"id":"spn-81198","text":"harder to support across platforms and edge gateways"}]}],"id":"blk-53000","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53002","kind":"paragraph","spans":[{"id":"spn-81199","text":"Rejected for v1; SSE is sufficient for streaming output. WebSockets can be introduced later if interactive tool call UX requires it."}]},{"id":"blk-53003","kind":"heading","level":3,"spans":[{"id":"spn-81200","text":"D) gRPC for invocation"}]},{"id":"blk-53004","kind":"paragraph","spans":[{"id":"spn-81201","text":"Pros:"}]},{"id":"blk-53005","items":[{"blocks":[{"id":"blk-53007","kind":"paragraph","spans":[{"id":"spn-81202","text":"strict contracts, performance"}]}],"id":"blk-53006","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53008","kind":"paragraph","spans":[{"id":"spn-81203","text":"Cons:"}]},{"id":"blk-53009","items":[{"blocks":[{"id":"blk-53011","kind":"paragraph","spans":[{"id":"spn-81204","text":"browser compatibility constraints"}]}],"id":"blk-53010","kind":"list-item"},{"blocks":[{"id":"blk-53013","kind":"paragraph","spans":[{"id":"spn-81205","text":"higher adoption friction"}]}],"id":"blk-53012","kind":"list-item"},{"blocks":[{"id":"blk-53015","kind":"paragraph","spans":[{"id":"spn-81206","text":"more infrastructure requirements"}]}],"id":"blk-53014","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53016","kind":"paragraph","spans":[{"id":"spn-81207","text":"Rejected for v1; HTTP+JSON and SSE are simpler and adequate."}]},{"id":"blk-53017","kind":"heading","level":2,"spans":[{"id":"spn-81208","text":"Consequences"}]},{"id":"blk-53018","kind":"heading","level":3,"spans":[{"id":"spn-81209","text":"Positive"}]},{"id":"blk-53019","items":[{"blocks":[{"id":"blk-53021","kind":"paragraph","spans":[{"id":"spn-81210","text":"Stable, runtime-agnostic contract for clients and SDKs."}]}],"id":"blk-53020","kind":"list-item"},{"blocks":[{"id":"blk-53023","kind":"paragraph","spans":[{"id":"spn-81211","text":"Simplifies the invocation gateway and adapter logic (one normalized shape)."}]}],"id":"blk-53022","kind":"list-item"},{"blocks":[{"id":"blk-53025","kind":"paragraph","spans":[{"id":"spn-81212","text":"Enables consistent telemetry attribution and usage accounting."}]}],"id":"blk-53024","kind":"list-item"},{"blocks":[{"id":"blk-53027","kind":"paragraph","spans":[{"id":"spn-81213","text":"Makes streaming UX consistent across runtimes."}]}],"id":"blk-53026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53028","kind":"heading","level":3,"spans":[{"id":"spn-81214","text":"Negative / tradeoffs"}]},{"id":"blk-53029","items":[{"blocks":[{"id":"blk-53031","kind":"paragraph","spans":[{"id":"spn-81215","text":"Some provider-native features won’t map cleanly to v1 without extensions (e.g., tool call transcripts)."}]}],"id":"blk-53030","kind":"list-item"},{"blocks":[{"id":"blk-53033","kind":"paragraph","spans":[{"id":"spn-81216","text":"Streaming emulation may not reflect true token-level timing for non-streaming providers."}]}],"id":"blk-53032","kind":"list-item"},{"blocks":[{"id":"blk-53035","kind":"paragraph","spans":[{"id":"spn-81217","text":"Token counts and usage fields may be estimated or unavailable for some providers; must be communicated as such."}]}],"id":"blk-53034","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53036","kind":"heading","level":2,"spans":[{"id":"spn-81218","text":"Implementation details (normative requirements)"}]},{"id":"blk-53037","kind":"heading","level":3,"spans":[{"id":"spn-81219","text":"1) Protocol versioning"}]},{"id":"blk-53038","items":[{"blocks":[{"id":"blk-53040","kind":"paragraph","spans":[{"id":"spn-81220","