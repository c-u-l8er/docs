:"paragraph","spans":[{"id":"spn-81262","text":"AgentCore-specific guidance (TypeScript):"}]}],"id":"blk-53072","kind":"list-item"},{"blocks":[{"id":"blk-53075","kind":"paragraph","spans":[{"id":"spn-81263","text":"the adapter SHOULD set "},{"id":"spn-81264","marks":["code"],"text":"runtimeSessionId"},{"id":"spn-81265","text":" explicitly on invocation (e.g., "},{"id":"spn-81266","marks":["code"],"text":"sess_<generated>"},{"id":"spn-81267","text":"), or accept a provider-returned session id if the API returns one."}]}],"id":"blk-53074","kind":"list-item"},{"blocks":[{"id":"blk-53077","kind":"paragraph","spans":[{"id":"spn-81268","text":"the adapter MUST return the session identifier to the client as the opaque "},{"id":"spn-81269","marks":["code"],"text":"sessionId"},{"id":"spn-81270","text":" for subsequent calls."}]}],"id":"blk-53076","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53078","items":[{"blocks":[{"id":"blk-53080","kind":"paragraph","spans":[{"id":"spn-81271","text":"Session lifecycle and timeouts:"}]}],"id":"blk-53079","kind":"list-item"},{"blocks":[{"id":"blk-53082","kind":"paragraph","spans":[{"id":"spn-81272","text":"adapters SHOULD document provider-specific session lifetimes and idle timeouts (in internal docs and/or UI hints) but MUST keep the external "},{"id":"spn-81273","marks":["code"],"text":"invoke/v1"},{"id":"spn-81274","text":" contract stable."}]}],"id":"blk-53081","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53083","kind":"heading","level":3,"spans":[{"id":"spn-81275","text":"4) Streaming rules"}]},{"id":"blk-53084","items":[{"blocks":[{"id":"blk-53086","kind":"paragraph","spans":[{"id":"spn-81276","text":"Streaming endpoint MUST:"}]}],"id":"blk-53085","kind":"list-item"},{"blocks":[{"id":"blk-53088","kind":"paragraph","spans":[{"id":"spn-81277","text":"send "},{"id":"spn-81278","marks":["code"],"text":"meta"},{"id":"spn-81279","text":" as first event,"}]}],"id":"blk-53087","kind":"list-item"},{"blocks":[{"id":"blk-53090","kind":"paragraph","spans":[{"id":"spn-81280","text":"send "},{"id":"spn-81281","marks":["code"],"text":"done"},{"id":"spn-81282","text":" as last event on success,"}]}],"id":"blk-53089","kind":"list-item"},{"blocks":[{"id":"blk-53092","kind":"paragraph","spans":[{"id":"spn-81283","text":"send "},{"id":"spn-81284","marks":["code"],"text":"error"},{"id":"spn-81285","text":" as terminal event on failure."}]}],"id":"blk-53091","kind":"list-item"},{"blocks":[{"id":"blk-53094","kind":"paragraph","spans":[{"id":"spn-81286","text":"Even on streaming:"}]}],"id":"blk-53093","kind":"list-item"},{"blocks":[{"id":"blk-53096","kind":"paragraph","spans":[{"id":"spn-81287","text":"gateway MUST still produce telemetry for the invocation."}]}],"id":"blk-53095","kind":"list-item"},{"blocks":[{"id":"blk-53098","kind":"paragraph","spans":[{"id":"spn-81288","marks":["code"],"text":"usage"},{"id":"spn-81289","text":" event SHOULD be sent once final usage is known."}]}],"id":"blk-53097","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53099","kind":"heading","level":3,"spans":[{"id":"spn-81290","text":"5) Error normalization"}]},{"id":"blk-53100","items":[{"blocks":[{"id":"blk-53102","kind":"paragraph","spans":[{"id":"spn-81291","text":"All invocation failures MUST be mapped to the normalized error envelope described in "},{"id":"spn-81292","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-81293","text":"."}]}],"id":"blk-53101","kind":"list-item"},{"blocks":[{"id":"blk-53104","kind":"paragraph","spans":[{"id":"spn-81294","text":"Provider internals (request ids, stack traces, credentials) MUST NOT be returned to clients."}]}],"id":"blk-53103","kind":"list-item"},{"blocks":[{"id":"blk-53106","kind":"paragraph","spans":[{"id":"spn-81295","marks":["code"],"text":"retryable"},{"id":"spn-81296","text":" must be accurate:"}]}],"id":"blk-53105","kind":"list-item"},{"blocks":[{"id":"blk-53108","kind":"paragraph","spans":[{"id":"spn-81297","text":"transient provider failures: true"}]}],"id":"blk-53107","kind":"list-item"},{"blocks":[{"id":"blk-53110","kind":"paragraph","spans":[{"id":"spn-81298","text":"validation/config/session-expired: false"}]}],"id":"blk-53109","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53111","kind":"heading","level":3,"spans":[{"id":"spn-81299","text":"6) Telemetry correlation"}]},{"id":"blk-53112","items":[{"blocks":[{"id":"blk-53114","kind":"paragraph","spans":[{"id":"spn-81300","text":"The invocation gateway MUST generate a "},{"id":"spn-81301","marks":["code"],"text":"traceId"},{"id":"spn-81302","text":" if missing and propagate it:"}]}],"id":"blk-53113","kind":"list-item"},{"blocks":[{"id":"blk-53116","kind":"paragraph","spans":[{"id":"spn-81303","text":"to the provider adapter request metadata (headers/metadata where possible),"}]}],"id":"blk-53115","kind":"list-item"},{"blocks":[{"id":"blk-53118","kind":"paragraph","spans":[{"id":"spn-81304","text":"to telemetry events emitted by the data plane or adapter."}]}],"id":"blk-53117","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-53119","kind":"heading","level":3,"spans":[{"id":"spn-81305","text":"7) Limits and gating integration"}]},{"id":"blk-53120","items":[{"blocks":[{"id":"blk-53122","kind":"paragraph","spans":[{"id":"spn-81306","text":"Limit enforcement is performed in the invocation gateway before provider invocation whenever possible."}]}],"id":"blk-53121","kind":"list-item"},{"blocks":[{"id":"blk-53124","kind":"paragraph","spans":[{"id":"spn-81307","text":"Runtime gating (AgentCore entitlement) MUST be enforced on:"}]}],"id":"blk-53123","kind":"list-item"},{"blocks":[{"id":"blk-53126","kind":"paragraph","spans":[{"id":"spn-81308","text":"deploy path,"}]}],"id":"blk-53125","kind":"list-item"},{"blocks":[{"id":"blk-53128","kind":"paragraph","spans":[{"id":"spn-81309","text":"invoke path,"}]}],"id":"blk-53127","kind":"list-item"},{"blocks":[{"id":"blk-53130","kind":"paragraph","spans":[{"id":"spn-81310