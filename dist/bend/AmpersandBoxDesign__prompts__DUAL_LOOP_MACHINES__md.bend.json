":[{"id":"spn-17576","marks":["code"],"text":"run_interaction"}]},{"id":"blk-18936","spans":[{"id":"spn-17577","text":"One scenario × one system"}]}],[{"id":"blk-18937","spans":[{"id":"spn-17578","marks":["code"],"text":"run_sequence"}]},{"id":"blk-18938","spans":[{"id":"spn-17579","marks":["code"],"text":"run_sequence"}]},{"id":"blk-18939","spans":[{"id":"spn-17580","text":"Scenario sequence, no memory reset"}]}],[{"id":"blk-18940","spans":[{"id":"spn-17581","marks":["code"],"text":"run_matrix"}]},{"id":"blk-18941","spans":[{"id":"spn-17582","marks":["code"],"text":"run_matrix"}]},{"id":"blk-18942","spans":[{"id":"spn-17583","text":"N systems × M models × all scenarios"}]}],[{"id":"blk-18943","spans":[{"id":"spn-17584","marks":["code"],"text":"status"}]},{"id":"blk-18944","spans":[{"id":"spn-17585","marks":["code"],"text":"get_run_status"}]},{"id":"blk-18945","spans":[{"id":"spn-17586","text":"Check in-progress run"}]}],[{"id":"blk-18946","spans":[{"id":"spn-17587","marks":["code"],"text":"transcript"}]},{"id":"blk-18947","spans":[{"id":"spn-17588","marks":["code"],"text":"get_transcript"}]},{"id":"blk-18948","spans":[{"id":"spn-17589","text":"Full interaction transcript"}]}],[{"id":"blk-18949","spans":[{"id":"spn-17590","marks":["code"],"text":"cancel"}]},{"id":"blk-18950","spans":[{"id":"spn-17591","marks":["code"],"text":"cancel_run"}]},{"id":"blk-18951","spans":[{"id":"spn-17592","text":"Cancel in-progress run"}]}],[{"id":"blk-18952","spans":[{"id":"spn-17593","marks":["code"],"text":"byor_evaluate"}]},{"id":"blk-18953","spans":[{"id":"spn-17594","marks":["code"],"text":"byor_evaluate"}]},{"id":"blk-18954","spans":[{"id":"spn-17595","text":"Full BYOR evaluation"}]}],[{"id":"blk-18955","spans":[{"id":"spn-17596","marks":["code"],"text":"byor_compare"}]},{"id":"blk-18956","spans":[{"id":"spn-17597","marks":["code"],"text":"byor_compare"}]},{"id":"blk-18957","spans":[{"id":"spn-17598","text":"Head-to-head on your repo"}]}]]},{"id":"blk-18958","kind":"heading","level":3,"spans":[{"id":"spn-17599","marks":["code"],"text":"observe"},{"id":"spn-17600","text":" — \"Judge the result\""}]},{"head":[{"id":"blk-18960","spans":[{"id":"spn-17601","text":"Action"}]},{"id":"blk-18961","spans":[{"id":"spn-17602","text":"Replaces"}]},{"id":"blk-18962","spans":[{"id":"spn-17603","text":"Description"}]}],"id":"blk-18959","kind":"table","rows":[[{"id":"blk-18963","spans":[{"id":"spn-17604","marks":["code"],"text":"judge_transcript"}]},{"id":"blk-18964","spans":[{"id":"spn-17605","marks":["code"],"text":"judge_transcript"}]},{"id":"blk-18965","spans":[{"id":"spn-17606","text":"L2: all 9 dimensions for one transcript"}]}],[{"id":"blk-18966","spans":[{"id":"spn-17607","marks":["code"],"text":"judge_dimension"}]},{"id":"blk-18967","spans":[{"id":"spn-17608","marks":["code"],"text":"judge_dimension"}]},{"id":"blk-18968","spans":[{"id":"spn-17609","text":"L2: one specific dimension (debug)"}]}],[{"id":"blk-18969","spans":[{"id":"spn-17610","marks":["code"],"text":"meta_judge"}]},{"id":"blk-18970","spans":[{"id":"spn-17611","marks":["code"],"text":"meta_judge"}]},{"id":"blk-18971","spans":[{"id":"spn-17612","text":"L3: meta-judge one L2 judgment"}]}],[{"id":"blk-18972","spans":[{"id":"spn-17613","marks":["code"],"text":"meta_judge_batch"}]},{"id":"blk-18973","spans":[{"id":"spn-17614","marks":["code"],"text":"meta_judge_batch"}]},{"id":"blk-18974","spans":[{"id":"spn-17615","text":"L3: meta-judge all L2 judgments for a run"}]}],[{"id":"blk-18975","spans":[{"id":"spn-17616","marks":["code"],"text":"override"}]},{"id":"blk-18976","spans":[{"id":"spn-17617","marks":["code"],"text":"override_judgment"}]},{"id":"blk-18977","spans":[{"id":"spn-17618","text":"Human override with audit trail"}]}]]},{"id":"blk-18978","kind":"heading","level":3,"spans":[{"id":"spn-17619","marks":["code"],"text":"reflect"},{"id":"spn-17620","text":" — \"What should change?\""}]},{"head":[{"id":"blk-18980","spans":[{"id":"spn-17621","text":"Action"}]},{"id":"blk-18981","spans":[{"id":"spn-17622","text":"Replaces"}]},{"id":"blk-18982","spans":[{"id":"spn-17623","text":"Description"}]}],"id":"blk-18979","kind":"table","rows":[[{"id":"blk-18983","spans":[{"id":"spn-17624","marks":["code"],"text":"analyze_gaps"}]},{"id":"blk-18984","spans":[{"id":"spn-17625","marks":["code"],"text":"analyze_gaps"}]},{"id":"blk-18985","spans":[{"id":"spn-17626","text":"Under-tested dims, saturated scenarios, domain gaps"}]}],[{"id":"blk-18986","spans":[{"id":"spn-17627","marks":["code"],"text":"evolve"}]},{"id":"blk-18987","spans":[{"id":"spn-17628","marks":["code"],"text":"evolve_scenarios"}]},{"id":"blk-18988","spans":[{"id":"spn-17629","text":"Retire, extend, fork, promote"}]}],[{"id":"blk-18989","spans":[{"id":"spn-17630","marks":["code"],"text":"advance_cycle"}]},{"id":"blk-18990","spans":[{"id":"spn-17631","marks":["code"],"text":"advance_cycle"}]},{"id":"blk-18991","spans":[{"id":"spn-17632","text":"Run all 4 phases (Compose → Interact → Observe → Reflect)"}]}],[{"id":"blk-18992","spans":[{"id":"spn-17633","marks":["code"],"text":"calibrate_irt"}]},{"id":"blk-18993","spans":[{"id":"spn-17634","marks":["code"],"text":"calibrate_irt"}]},{"id":"blk-18994","spans":[{"id":"spn-17635","text":"Recalibrate IRT difficulty/discrimination"}]}],[{"id":"blk-18995","spans":[{"id":"spn-17636","marks":["code"],"text":"cycle_history"}]},{"id":"blk-18996","spans":[{"id":"spn-17637","marks":["code"],"text":"get_cycle_history"}]},{"id":"blk-18997","spans":[{"id":"spn-17638","text":"Full history of cycles and improvements"}]}],[{"id":"blk-18998","spans":[{"id":"spn-17639","marks":["code"],"text":"byor_recommend"}]},{"id":"blk-18999","spans":[{"id":"spn-17640","marks":["code"],"text":"byor_recommend"}]},{"id":"blk-19000","spans":[{"id":"spn-17641","text":"System recommendation for your use case"}]}],[{"id":"blk-19001","spans":[{"id":"spn-17642","marks":["code"],"text":"byor_infer_profile"}]},{"id":"blk-19002","spans":[{"id":"spn-17643","marks":["code"],"text":"byor_infer_profile"}]},{"id":"blk-19003","spans":[{"id":"spn-17644","text":"Infer task profile from repo patterns"}]}]]},{"id":"blk-19004","kind":"heading","level":3,"spans":[{"id":"spn-17645","marks":["code"],"text":"diagnose"},{"id":"spn-17646","text":" — \"What's actionable?\""}]},{"head":[{"id":"blk-19006","spans":[{"id":"spn-17647","text":"Action"}]},{"id":"blk-19007","spans":[{"id":"spn-17648","text":"Replaces"}]},{"id":"blk-19008","spans":[{"id":"spn-17649","text":"Description"}]}],"id":"blk-19005","kind":"table","rows":[[{"id":"blk-19009","spans":[{"id":"spn-17650","marks":["code"],"text":"report"}]},{"id":"blk-19010","spans":[{"id":"spn-17651","marks":["code"],"text":"get_diagnostic_report"}]},{"id":"blk-19011","spans":[{"id":"spn-17652","text":"Full diagnostic (failures, fixes, regressions)"}]}],[{"id":"blk-19012","spans":[{"id":"spn-17653","marks":["code"],"text":"failure_patterns"}]},{"id":"blk-19013","spans":[{"id":"spn-17654","marks":["code"],"text":"get_failure_patterns"}]},{"id":"blk-19014","spans":[{"id":"spn-17655","text":"Clustered failure analysis per dimension"}]}],[{"id":"blk-19015","spans":[{"id":"spn-17656","marks":["code"],"text":"retest"}]},{"id":"blk-19016","spans":[{"id":"spn-17657","marks":["code"],"text":"run_retest"}]},{"id":"blk-19017","spans":[{"id":"spn-17658","text":"Re-run specific scenarios after a fix"}]}],[{"id":"blk-19018","spans":[{"id":"spn-17659","marks":["code"],"text":"verify"}]},{"id":"blk-19019","spans":[{"id":"spn-17660","marks":["code"],"text":"get_verification_report"}]},{"id":"blk-19020","spans":[{"id":"spn-17661","text":"Before/after comparison from retest"}]}],[{"id":"blk-19021","spans":[{"id":"spn-17662","marks":["code"],"text":"regressions"}]},{"id":"blk-19022","spans":[{"id":"spn-17663","marks":["code"],"text":"get_regression_alerts"}]},{"id":"blk-19023","spans":[{"id":"spn-17664","text":"Cross-cycle regression analysis"}]}],[{"id":"blk-19024","spans":[{"id":"spn-17665","marks":["code"],"text":"suggest_fixes"}]},{"id":"blk-19025","spans":[{"id":"spn-17666","marks":["code"],"text":"suggest_fixes"}]},{"id":"blk-19026","spans":[{"id":"spn-17667","text":"AI-generated fix suggestions"}]}],[{"id":"blk-19027","spans":[{"id":"spn-17668","marks":["code"],"text":"leaderboard"}]},{"id":"blk-19028","spans":[{"id":"spn-17669","marks":["code"],"text":"get_leaderboard"}]},{"id":"blk-19029","spans":[{"id":"spn-17670","text":"Rankings with domain filter"}]}],[{"id":"blk-19030","spans":[{"id":"spn-17671","marks":["code"],"text":"leaderboard_history"}]},{"id":"blk-19031","spans":[{"id":"spn-17672","marks":["code"],"text":"get_leaderboard_history"}]},{"id":"blk-19032","spans":[{"id":"spn-17673","text":"Scores over time"}]}],[{"id":"blk-19033","spans":[{"id":"spn-17674","marks":["code"],"text":"compare_systems"}]},{"id":"blk-19034","spans":[{"id":"spn-17675","marks":["code"],"text":"compare_systems"}]},{"id":"blk-19035","spans":[{"id":"spn-17676","text":"Head-to-head across all 9 dimensions"}]}],[{"id":"blk-19036","spans":[{"id":"spn-17677","marks":["code"],"text":"dimension_leaders"}]},{"id":"blk-19037","spans":[{"id":"spn-17678","marks":["code"],"text":"get_dimension_leaders"}]},{"id":"blk-19038","spans":[{"id":"spn-17679","text":"Top system per CL dimension"}]}],[{"id":"blk-19039","spans":[{"id":"spn-17680","marks":["code"],"text":"fit_recommendation"}]},{"id":"blk-19040","spans":[{"id":"spn-17681","marks":["code"],"text":"get_fit_recommendation"}]},{"id":"blk-19041","spans":[{"id":"spn-17682","text":"System rec for a task profile"}]}],[{"id":"blk-19042","spans":[{"id":"spn-17683","marks":["code"],"text":"compare_fit"}]},{"id":"blk-19043","spans":[{"id":"spn-17684","marks":["code"],"text":"compare_fit"}]},{"id":"blk-19044","spans":[{"id":"spn-17685","text":"Compare two systems for a specific task"}]}],[{"id":"blk-19045","spans":[{"id":"spn-17686","marks":["code"],"text":"task_profiles"}]},{"id":"blk-19046","spans":[{"id":"spn-17687","marks":["code"],"text":"list_task_profiles"}]},{"id":"blk-19047","spans":[{"id":"spn-17688","text":"List pre-built and custom profiles"}]}]]},{"id":"blk-19048","kind":"heading","level":3,"spans":[{"id":"spn-17689","marks":["code"],"text":"config"},{"id":"spn-17690","text":" — Admin/setup (outside the loop)"}]},{"head":[{"id":"blk-19050","spans":[{"id":"spn-17691","text":"Action"}]},{"id":"blk-19051","spans":[{"id":"spn-17692","text":"Replaces"}]},{"id":"blk-19052","spans":[{"id":"spn-17693","text":"Description"}]}],"id":"blk-19049","kind":"table","rows":[[{"id":"blk-19053","spans":[{"id":"spn-17694","marks":["code"],"text":"set_weights"}]},{"id":"blk-19054","spans":[{"id":"spn-17695","marks":["code"],"text":"set_cl_weights"}]},{"id":"blk-19055","spans":[{"id":"spn-17696","text":"Update 9-dimension weight vector"}]}],[{"id":"blk-19056","spans":[{"id":"spn-17697","marks":["code"],"text":"register_system"}]},{"id":"blk-19057","spans":[{"id":"spn-17698","marks":["code"],"text":"register_system"}]},{"id":"blk-19058","spans":[{"id":"spn-17699","text":"Register memory system + MCP endpoint"}]}],[{"id":"blk-19059","spans":[{"id":"spn-17700","marks":["code"],"text":"list_systems"}]},{"id":"blk-19060","spans":[{"id":"spn-17701","marks":["code"],"text":"list_systems"}]},{"id":"blk-19061","spans":[{"id":"spn-17702","text":"List registered systems"}]}],[{"id":"blk-19062","spans":[{"id":"spn-17703","marks":["code"],"text":"get_config"}]},{"id":"blk-19063","spans":[{"id":"spn-17704","marks":["code"],"text":"get_config"}]},{"id":"blk-19064","spans":[{"id":"spn-17705","text":"Current full configuration"}]}],[{"id":"blk-19065","spans":[{"id":"spn-17706","marks":["code"],"text":"create_profile"}]},{"id":"blk-19066","spans":[{"id":"spn-17707","marks":["code"],"text":"create_task_profile"}]},{"id":"blk-19067","spans":[{"id":"spn-17708","text":"Define custom task profile"}]}]]},{"id":"blk-19068","kind":"paragraph","spans":[{"id":"spn-17709","marks":["bold"],"text":"Total: 6 tools exposed to the model (5 loop + 1 admin)."}]},{"id":"blk-19069","kind":"heading","level":2,"spans":[{"id":"spn-17710","text":"Combined Impact"}]},{"head":[{"id":"blk-19071","spans":[{"id":"spn-17711","text":"Scenario"}]},{"id":"blk-19072","spans":[{"id":"spn-17712","text":"Before"}]},{"id":"blk-19073","spans":[{"id":"spn-17713","text":"After"}]}],"id":"blk-19070","kind":"table","rows":[[{"id":"blk-19074","spans":[{"id":"spn-17714","text":"Graphonomous alone"}]},{"id":"blk-19075","spans":[{"id":"spn-17715","text":"29 tools"}]},{"id":"blk-19076","spans":[{"id":"spn-17716","text":"5 tools"}]}],[{"id":"blk-19077","spans":[{"id":"spn-17717","text":"PRISM alone"}]},{"id":"blk-19078","spans":[{"id":"spn-17718","text":"47 tools"}]},{"id":"blk-19079","spans":[{"id":"spn-17719","text":"6 tools"}]}],[{"id":"blk-19080","spans":[{"id":"spn-17720","text":"Both in same session"}]},{"id":"blk-19081","spans":[{"id":"spn-17721","text":"76 tools"}]},{"id":"blk-19082","spans":[{"id":"spn-17722","text":"11 tools"}]}]]},{"id":"blk-19083","kind":"paragraph","spans":[{"id":"spn-17723","text":"Context savings: ~80% reduction in tool schema tokens. Selection accuracy: from ~49% (76 tools) to ~95% (11 tools)."}]},{"id":"blk-19084","kind":"heading","level":2,"spans":[{"id":"spn-17724","text":"The Interlocking Loops"}]},{"id":"blk-19085","kind":"paragraph","spans":[{"id":"spn-17725","text":"When PRISM benchmarks Graphonomous, the loops nest:"}]},{"id":"blk-19086","kind":"code","language":"text","text":"PRISM compose ──→ PRISM interact ──→ PRISM observe ──→ PRISM reflect ──→ PRISM diagnose\n                       │\n                       ▼\n              ┌─── Graphonomous ───┐\n              │  retrieve → route  │\n              │  → act → learn     │\n              │  → consolidate     │\n              └────────────────────┘"},{"id":"blk-19087","kind":"paragraph","spans":[{"id":"spn-17726","text":"PRISM's "},{"id":"spn-17727","marks":["code"],"text":"interact"},{"id":"spn-17728","text":" phase drives the system-under-test through its own closed loop. PRISM's "},{"id":"spn-17729","marks":["code"],"text":"observe"},{"id":"spn-17730","text":" phase judges how well that inner loop performed. PRISM's "},{"id":"spn-17731","marks":["code"],"text":"reflect"},{"id":"spn-17732","text":" phase evolves scenarios based on where the inner loop failed."}]},{"id":"blk-19088","kind":"paragraph","spans":[{"id":"spn-17733","text":"This is the knockout feature: "},{"id":"spn-17734","marks":["bold"],"text":"two self-improving loops, one inside the other."},{"id":"spn-17735","text":" The outer loop (PRISM) improves the benchmark. The inner loop (Graphonomous) improves the memory. Each makes the other sharper."}]},{"id":"blk-19089","kind":"heading","level":2,"spans":[{"id":"spn-17736","text":"Implementation Pattern"}]},{"id":"blk-19090","kind":"paragraph","spans":[{"id":"spn-17737","text":"Both systems use the same Elixir pattern: a single MCP component module per machine with an "},{"id":"spn-17738","marks":["code"],"text":"action"},{"id":"spn-17739","text":" field that dispatches internally."}]},{"id":"blk-19091","kind":"code","language":"elixir","text":"defmodule Graphonomous.MCP.Retrieve do\n  use Anubis.Server.Component, type: :tool\n\n  schema do\n    field(:action, :string,\n      required: true,\n      description: \"context | episodic | procedural | coverage | trace_evidence | frontier\"\n    )\n    # Union of all action-specific fields, each documented with which action uses it\n    field(:query, :string, description: \"Search query (context, episodic, procedural, frontier)\")\n    field(:limit, :number, description: \"Max results (context, episodic, procedural)\")\n    # ... etc\n  end\n\n  def execute(%{action: \"context\"} = params, frame), do: do_context(params, frame)\n  def execute(%{action: \"episodic\"} = params, frame), do: do_episodic(params, frame)\n  # ...\nend"},{"id":"blk-19092","kind":"paragraph","spans":[{"id":"spn-17740","text":"Each machine module delegates to the existing "},{"id":"spn-17741","marks":["code"],"text":"Graphonomous.*"},{"id":"spn-17742","text":" functions — the internal API doesn't change, only the MCP surface."}]},{"id":"blk-19093","kind":"heading","level":2,"spans":[{"id":"spn-17743","text":"Migration Strategy"}]},{"id":"blk-19094","items":[{"blocks":[{"id":"blk-19096","kind":"paragraph","spans":[{"id":"spn-17744","marks":["bold"],"text":"Phase 1: Add machine modules alongside existing tools."},{"id":"spn-17745","text":" Both surfaces work."}]}],"id":"blk-19095","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-19097","kind":"paragraph","spans":[{"id":"spn-17746","text":"Register machines in "},{"id":"spn-17747","marks":["code"],"text":"server.ex"},{"id":"spn-17748","text":" with a "},{"id":"spn-17749","marks":["code"],"text":"v2_"},{"id":"spn-17750","text":" prefix for testing."}]},{"id":"blk-19098","items":[{"blocks":[{"id":"blk-19100","kind":"paragraph","spans":[{"id":"spn-17751","marks":["bold"],"text":"Phase 2: Update skill prompts"},{"id":"spn-17752","text":" to reference machine verbs instead of"}]}],"id":"blk-19099","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-19101","kind":"paragraph","spans":[{"id":"spn-17753","text":"individual tools. Run PRISM benchmarks comparing v1 vs v2 tool selection accuracy."}]},{"id":"blk-19102","items":[{"blocks":[{"id":"blk-19104","kind":"paragraph","spans":[{"id":"spn-17754","marks":["bold"],"text":"Phase 3: Deprecate individual tools."},{"id":"spn-17755","text":" Remove from "},{"id":"spn-17756","marks":["code"],"text":"server.ex"},{"id":"spn-17757","text":", keep modules"}]}],"id":"blk-19103","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-19105","kind":"paragraph","spans":[{"id":"spn-17758","text":"for reference."}]},{"id":"blk-19106","items":[{"blocks":[{"id":"blk-19108","kind":"paragraph","spans":[{"id":"spn-17759","marks":["bold"],"text":"Phase 4: Remove deprecated modules."},{"id":"spn-17760","text":" Clean cut."}]}],"id":"blk-19107","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-19109","kind":"heading","level":2,"spans":[{"id":"spn-17761","text":"Backward Compatibility"}]},{"id":"blk-19110","kind":"paragraph","spans":[{"id":"spn-17762","text":"Existing clients calling "},{"id":"spn-17763","marks":["code"],"text":"retrieve_context"},{"id":"spn-17764","text":" directly will break at Phase 3. Mitigation: the adapter layer in "},{"id":"spn-17765","marks":["code"],"text":"Prism.MCP.Adapter"},{"id":"spn-17766","text":" can translate legacy tool names to machine + action pairs during the transition."}]},{"id":"blk-19111","kind":"heading","level":2,"spans":[{"id":"spn-17767","text":"Triple loop and beyond — PULSE generalization"}]},{"id":"blk-19112","kind":"paragraph","spans":[{"id":"spn-17768","text":"The Graphonomous ↔ PRISM dual loop is the canonical example, but the [&] ecosystem actually runs "},{"id":"spn-17769","marks":["bold"],"text":"at least three"},{"id":"spn-17770","text":" nested loops today:"}]},{"id":"blk-19113","kind":"code","language":"text","text":"PRISM (outer)        compose → interact → observe → reflect → diagnose\n  │\n  └─ Graphonomous    retrieve → route → act → learn → consolidate\n       │\n       └─ Deliberation    survey → triage → dispatch → act → learn"},{"id":"blk-19114","kind":"paragraph","spans":[{"id":"spn-17771","text":"OS-010 PULSE encodes this nesting in each manifest's "},{"id":"spn-17772","marks":["code"],"text":"nesting"},{"id":"spn-17773","text":" block:"}]},{"id":"blk-19115","items":[{"blocks":[{"id":"blk-19117","kind":"paragraph","spans":[{"id":"spn-17774","marks":["code"],"text":"prism.benchmark"},{"id":"spn-17775","text":" declares "},{"id":"spn-17776","marks":["code"],"text":"inner_loops: [graphonomous.continual_learning]"}]}],"id":"blk-19116","kind":"list-item"},{"blocks":[{"id":"blk-19119","kind":"paragraph","spans":[{"id":"spn-17777","marks":["code"],"text":"graphonomous.continual_learning"},{"id":"spn-17778","text":" declares "},{"id":"spn-17779","marks":["code"],"text":"inner_loops: [graphonomous.deliberate]"},{"id":"spn-17780","text":" and "},{"id":"spn-17781","marks":["code"],"text":"parent_loop: prism.benchmark"}]}],"id":"blk-19118","kind":"list-item"},{"blocks":[{"id":"blk-19121","kind":"paragraph","spans":[{"id":"spn-17782","marks":["code"],"text":"graphonomous.deliberate"},{"id":"spn-17783","text":" declares "},{"id":"spn-17784","marks":["code"],"text":"parent_loop: graphonomous.continual_learning"}]}],"id":"blk-19120","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-19122","kind":"paragraph","spans":[{"id":"spn-17785","text":"PULSE supports unbounded nesting depth. OS-008 (Agent Harness, draft) is expected to add a fourth outer layer that wraps PRISM itself — when it ships, the only change required is a new manifest with "},{"id":"spn-17786","marks":["code"],"text":"inner_loops: [prism.benchmark]"},{"id":"spn-17787","text":". No code changes to existing machines."}]},{"id":"blk-19123","kind":"heading","level":3,"spans":[{"id":"spn-17788","text":"Why this matters for the machine architecture"}]},{"id":"blk-19124","kind":"paragraph","spans":[{"id":"spn-17789","text":"The 5/6/11-tool count documented above is a "},{"id":"spn-17790","marks":["bold"],"text":"floor"},{"id":"spn-17791","text":", not a ceiling. Adding a third loop adds at most 5 more machines (one per phase kind), and because PULSE manifests declare the inner-loop boundary explicitly, the outer machines do not need to learn about inner machines individually. PRISM's "},{"id":"spn-17792","marks":["code"],"text":"interact"},{"id":"spn-17793","text":" machine, for example, drives any PULSE-conforming inner loop through its declared "},{"id":"spn-17794","marks":["code"],"text":"retrieve"},{"id":"spn-17795","text":" phase — it does not need a Graphonomous-specific code path."}]},{"head":[{"id":"blk-19126","spans":[{"id":"spn-17796","text":"Layers in session"}]},{"id":"blk-19127","spans":[{"id":"spn-17797","text":"Tool count (machines)"}]},{"id":"blk-19128","spans":[{"id":"spn-17798","text":"Tool count (legacy v1)"}]}],"id":"blk-19125","kind":"table","rows":[[{"id":"blk-19129","spans":[{"id":"spn-17799","text":"Graphonomous alone"}]},{"id":"blk-19130","spans":[{"id":"spn-17800","text":"5"}]},{"id":"blk-19131","spans":[{"id":"spn-17801","text":"29"}]}],[{"id":"blk-19132","spans":[{"id":"spn-17802","text":"Graphonomous + PRISM"}]},{"id":"blk-19133","spans":[{"id":"spn-17803","text":"11"}]},{"id":"blk-19134","spans":[{"id":"spn-17804","text":"76"}]}],[{"id":"blk-19135","spans":[{"id":"spn-17805","text":"Graphonomous + PRISM + OS-008 Harness"}]},{"id":"blk-19136","spans":[{"id":"spn-17806","text":"~16"}]},{"id":"blk-19137","spans":[{"id":"spn-17807","text":"~100+"}]}],[{"id":"blk-19138","spans":[{"id":"spn-17808","text":"Graphonomous + PRISM + OS-008 + AgenTroMatic deliberation"}]},{"id":"blk-19139","spans":[{"id":"spn-17809","text":"~21"}]},{"id":"blk-19140","spans":[{"id":"spn-17810","text":"~130+"}]}]]},{"id":"blk-19141","kind":"paragraph","spans":[{"id":"spn-17811","text":"The savings compound with depth, and PULSE's manifest standard is what makes the composition algebraic instead of ad-hoc."}]},{"id":"blk-19142","kind":"heading","level":3,"spans":[{"id":"spn-17812","text":"Three-protocol stack at runtime"}]},{"id":"blk-19143","kind":"code","language":"text","text":"┌──────────────────────────────────────────────────────────┐\n│  PRISM    — measures loops over time      (diagnostic)   │ OS-009\n├──────────────────────────────────────────────────────────┤\n│  PULSE    — declares loops + circulation   (temporal)    │ OS-010\n├──────────────────────────────────────────────────────────┤\n│  [&]      — composes capabilities          (structural)  │ AmpersandBoxDesign\n└──────────────────────────────────────────────────────────┘"},{"id":"blk-19144","kind":"paragraph","spans":[{"id":"spn-17813","text":"A loop is "},{"id":"spn-17814","marks":["bold"],"text":"PULSE-conforming"},{"id":"spn-17815","text":" if its manifest validates against "},{"id":"spn-17816","marks":["code"],"text":"pulse-loop-manifest.v0.1.json"},{"id":"spn-17817","text":" and its runtime passes all 12 conformance tests. A system is "},{"id":"spn-17818","marks":["bold"],"text":"PRISM-evaluable"},{"id":"spn-17819","text":" automatically once it is PULSE-conforming — PRISM's "},{"id":"spn-17820","marks":["code"],"text":"compose"},{"id":"spn-17821","text":" phase reads the manifest, injects scenarios at the declared "},{"id":"spn-17822","marks":["code"],"text":"retrieve"},{"id":"spn-17823","text":" boundary, and observes outcomes via the declared "},{"id":"spn-17824","marks":["code"],"text":"learn"},{"id":"spn-17825","text":" phase. No bespoke per-system integration required."}]},{"id":"blk-19145","kind":"paragraph","spans":[{"id":"spn-17826","text":"See "},{"id":"spn-17827","marks":["code"],"text":"/PULSE/manifests/"},{"id":"spn-17828","text":" for the canonical reference manifests and "},{"id":"spn-17829","marks":["code"],"text":"opensentience.org/docs/spec/OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-17830","text":" for the full PULSE protocol spec."}]}],"edges":[],"id":"bagaaierarilot74ysyi7ggvo4ldavjxrv2buvspk3hwqnlut6oqhre65iita","vocabulary":"ampersand.docs.fs.v1"}