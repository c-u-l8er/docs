,"level":3,"spans":[{"id":"spn-16350","marks":["code"],"text":"observe"},{"id":"spn-16351","text":" — \"Judge the result\""}]},{"head":[{"id":"blk-17088","spans":[{"id":"spn-16352","text":"Action"}]},{"id":"blk-17089","spans":[{"id":"spn-16353","text":"Replaces"}]},{"id":"blk-17090","spans":[{"id":"spn-16354","text":"Description"}]}],"id":"blk-17087","kind":"table","rows":[[{"id":"blk-17091","spans":[{"id":"spn-16355","marks":["code"],"text":"judge_transcript"}]},{"id":"blk-17092","spans":[{"id":"spn-16356","marks":["code"],"text":"judge_transcript"}]},{"id":"blk-17093","spans":[{"id":"spn-16357","text":"L2: all 9 dimensions for one transcript"}]}],[{"id":"blk-17094","spans":[{"id":"spn-16358","marks":["code"],"text":"judge_dimension"}]},{"id":"blk-17095","spans":[{"id":"spn-16359","marks":["code"],"text":"judge_dimension"}]},{"id":"blk-17096","spans":[{"id":"spn-16360","text":"L2: one specific dimension (debug)"}]}],[{"id":"blk-17097","spans":[{"id":"spn-16361","marks":["code"],"text":"meta_judge"}]},{"id":"blk-17098","spans":[{"id":"spn-16362","marks":["code"],"text":"meta_judge"}]},{"id":"blk-17099","spans":[{"id":"spn-16363","text":"L3: meta-judge one L2 judgment"}]}],[{"id":"blk-17100","spans":[{"id":"spn-16364","marks":["code"],"text":"meta_judge_batch"}]},{"id":"blk-17101","spans":[{"id":"spn-16365","marks":["code"],"text":"meta_judge_batch"}]},{"id":"blk-17102","spans":[{"id":"spn-16366","text":"L3: meta-judge all L2 judgments for a run"}]}],[{"id":"blk-17103","spans":[{"id":"spn-16367","marks":["code"],"text":"override"}]},{"id":"blk-17104","spans":[{"id":"spn-16368","marks":["code"],"text":"override_judgment"}]},{"id":"blk-17105","spans":[{"id":"spn-16369","text":"Human override with audit trail"}]}]]},{"id":"blk-17106","kind":"heading","level":3,"spans":[{"id":"spn-16370","marks":["code"],"text":"reflect"},{"id":"spn-16371","text":" — \"What should change?\""}]},{"head":[{"id":"blk-17108","spans":[{"id":"spn-16372","text":"Action"}]},{"id":"blk-17109","spans":[{"id":"spn-16373","text":"Replaces"}]},{"id":"blk-17110","spans":[{"id":"spn-16374","text":"Description"}]}],"id":"blk-17107","kind":"table","rows":[[{"id":"blk-17111","spans":[{"id":"spn-16375","marks":["code"],"text":"analyze_gaps"}]},{"id":"blk-17112","spans":[{"id":"spn-16376","marks":["code"],"text":"analyze_gaps"}]},{"id":"blk-17113","spans":[{"id":"spn-16377","text":"Under-tested dims, saturated scenarios, domain gaps"}]}],[{"id":"blk-17114","spans":[{"id":"spn-16378","marks":["code"],"text":"evolve"}]},{"id":"blk-17115","spans":[{"id":"spn-16379","marks":["code"],"text":"evolve_scenarios"}]},{"id":"blk-17116","spans":[{"id":"spn-16380","text":"Retire, extend, fork, promote"}]}],[{"id":"blk-17117","spans":[{"id":"spn-16381","marks":["code"],"text":"advance_cycle"}]},{"id":"blk-17118","spans":[{"id":"spn-16382","marks":["code"],"text":"advance_cycle"}]},{"id":"blk-17119","spans":[{"id":"spn-16383","text":"Run all 4 phases (Compose → Interact → Observe → Reflect)"}]}],[{"id":"blk-17120","spans":[{"id":"spn-16384","marks":["code"],"text":"calibrate_irt"}]},{"id":"blk-17121","spans":[{"id":"spn-16385","marks":["code"],"text":"calibrate_irt"}]},{"id":"blk-17122","spans":[{"id":"spn-16386","text":"Recalibrate IRT difficulty/discrimination"}]}],[{"id":"blk-17123","spans":[{"id":"spn-16387","marks":["code"],"text":"cycle_history"}]},{"id":"blk-17124","spans":[{"id":"spn-16388","marks":["code"],"text":"get_cycle_history"}]},{"id":"blk-17125","spans":[{"id":"spn-16389","text":"Full history of cycles and improvements"}]}],[{"id":"blk-17126","spans":[{"id":"spn-16390","marks":["code"],"text":"byor_recommend"}]},{"id":"blk-17127","spans":[{"id":"spn-16391","marks":["code"],"text":"byor_recommend"}]},{"id":"blk-17128","spans":[{"id":"spn-16392","text":"System recommendation for your use case"}]}],[{"id":"blk-17129","spans":[{"id":"spn-16393","marks":["code"],"text":"byor_infer_profile"}]},{"id":"blk-17130","spans":[{"id":"spn-16394","marks":["code"],"text":"byor_infer_profile"}]},{"id":"blk-17131","spans":[{"id":"spn-16395","text":"Infer task profile from repo patterns"}]}]]},{"id":"blk-17132","kind":"heading","level":3,"spans":[{"id":"spn-16396","marks":["code"],"text":"diagnose"},{"id":"spn-16397","text":" — \"What's actionable?\""}]},{"head":[{"id":"blk-17134","spans":[{"id":"spn-16398","text":"Action"}]},{"id":"blk-17135","spans":[{"id":"spn-16399","text":"Replaces"}]},{"id":"blk-17136","spans":[{"id":"spn-16400","text":"Description"}]}],"id":"blk-17133","kind":"table","rows":[[{"id":"blk-17137","spans":[{"id":"spn-16401","marks":["code"],"text":"report"}]},{"id":"blk-17138","spans":[{"id":"spn-16402","marks":["code"],"text":"get_diagnostic_report"}]},{"id":"blk-17139","spans":[{"id":"spn-16403","text":"Full diagnostic (failures, fixes, regressions)"}]}],[{"id":"blk-17140","spans":[{"id":"spn-16404","marks":["code"],"text":"failure_patterns"}]},{"id":"blk-17141","spans":[{"id":"spn-16405","marks":["code"],"text":"get_failure_patterns"}]},{"id":"blk-17142","spans":[{"id":"spn-16406","text":"Clustered failure analysis per dimension"}]}],[{"id":"blk-17143","spans":[{"id":"spn-16407","marks":["code"],"text":"retest"}]},{"id":"blk-17144","spans":[{"id":"spn-16408","marks":["code"],"text":"run_retest"}]},{"id":"blk-17145","spans":[{"id":"spn-16409","text":"Re-run specific scenarios after a fix"}]}],[{"id":"blk-17146","spans":[{"id":"spn-16410","marks":["code"],"text":"verify"}]},{"id":"blk-17147","spans":[{"id":"spn-16411","marks":["code"],"text":"get_verification_report"}]},{"id":"blk-17148","spans":[{"id":"spn-16412","text":"Before/after comparison from retest"}]}],[{"id":"blk-17149","spans":[{"id":"spn-16413","marks":["code"],"text":"regressions"}]},{"id":"blk-17150","spans":[{"id":"spn-16414","marks":["code"],"text":"get_regression_alerts"}]},{"id":"blk-17151","spans":[{"id":"spn-16415","text":"Cross-cycle regression analysis"}]}],[{"id":"blk-17152","spans":[{"id":"spn-16416","marks":["code"],"text":"suggest_fixes"}]},{"id":"blk-17153","spans":[{"id":"spn-16417","marks":["code"],"text":"suggest_fixes"}]},{"id":"blk-17154","spans":[{"id":"spn-16418","text":"AI-generated fix suggestions"}]}],[{"id":"blk-17155","spans":[{"id":"spn-16419","marks":["code"],"text":"leaderboard"}]},{"id":"blk-17156","spans":[{"id":"spn-16420","marks":["code"],"text":"get_leaderboard"}]},{"id":"blk-17157","spans":[{"id":"spn-16421","text":"Rankings with domain filter"}]}],[{"id":"blk-17158","spans":[{"id":"spn-16422","marks":["code"],"text":"leaderboard_history"}]},{"id":"blk-17159","spans":[{"id":"spn-16423","marks":["code"],"text":"get_leaderboard_history"}]},{"id":"blk-17160","spans":[{"id":"spn-16424","text":"Scores over time"}]}],[{"id":"blk-17161","spans":[{"id":"spn-16425","marks":["code"],"text":"compare_systems"}]},{"id":"blk-17162","spans":[{"id":"spn-16426","marks":["code"],"text":"compare_systems"}]},{"id":"blk-17163","spans":[{"id":"spn-16427","text":"Head-to-head across all 9 dimensions"}]}],[{"id":"blk-17164","spans":[{"id":"spn-16428","marks":["code"],"text":"dimension_leaders"}]},{"id":"blk-17165","spans":[{"id":"spn-16429","marks":["code"],"text":"get_dimension_leaders"}]},{"id":"blk-17166","spans":[{"id":"spn-16430","text":"Top system per CL dimension"}]}],[{"id":"blk-17167","spans":[{"id":"spn-16431","marks":["code"],"text":"fit_recommendation"}]},{"id":"blk-17168","spans":[{"id":"spn-16432","marks":["code"],"text":"get_fit_recommendation"}]},{"id":"blk-17169","spans":[{"id":"spn-16433","text":"System rec for a task profile"}]}],[{"id":"blk-17170","spans":[{"id":"spn-16434","marks":["code"],"text":"compare_fit"}]},{"id":"blk-17171","spans":[{"id":"spn-16435","marks":["code"],"text":"compare_fit"}]},{"id":"blk-17172","spans":[{"id":"spn-16436","text":"Compare two systems for a specific task"}]}],[{"id":"blk-17173","spans":[{"id":"spn-16437","marks":["code"],"text":"task_profiles"}]},{"id":"blk-17174","spans":[{"id":"spn-16438","marks":["code"],"text":"list_task_profiles"}]},{"id":"blk-17175","spans":[{"id":"spn-16439","text":"List pre-built and custom profiles"}]}]]},{"id":"blk-17176","kind":"heading","level":3,"spans":[{"id":"spn-16440","marks":["code"],"text":"config"},{"id":"spn-16441","text":" — Admin/setup (outside the loop)"}]},{"head":[{"id":"blk-17178","spans":[{"id":"spn-16442","text":"Action"}]},{"id":"blk-17179","spans":[{"id":"spn-16443","text":"Replaces"}]},{"id":"blk-17180","spans":[{"id":"spn-16444","text":"Description"}]}],"id":"blk-17177","kind":"table","rows":[[{"id":"blk-17181","spans":[{"id":"spn-16445","marks":["code"],"text":"set_weights"}]},{"id":"blk-17182","spans":[{"id":"spn-16446","marks":["code"],"text":"set_cl_weights"}]},{"id":"blk-17183","spans":[{"id":"spn-16447","text":"Update 9-dimension weight vector"}]}],[{"id":"blk-17184","spans":[{"id":"spn-16448","marks":["code"],"text":"register_system"}]},{"id":"blk-17185","spans":[{"id":"spn-16449","marks":["code"],"text":"register_system"}]},{"id":"blk-17186","spans":[{"id":"spn-16450","text":"Register memory system + MCP endpoint"}]}],[{"id":"blk-17187","spans":[{"id":"spn-16451","marks":["code"],"text":"list_systems"}]},{"id":"blk-17188","spans":[{"id":"spn-16452","marks":["code"],"text":"list_systems"}]},{"id":"blk-17189","spans":[{"id":"spn-16453","text":"List registered systems"}]}],[{"id":"blk-17190","spans":[{"id":"spn-16454","marks":["code"],"text":"get_config"}]},{"id":"blk-17191","spans":[{"id":"spn-16455","marks":["code"],"text":"get_config"}]},{"id":"blk-17192","spans":[{"id":"spn-16456","text":"Current full configuration"}]}],[{"id":"blk-17193","spans":[{"id":"spn-16457","marks":["code"],"text":"create_profile"}]},{"id":"blk-17194","spans":[{"id":"spn-16458","marks":["code"],"text":"create_task_profile"}]},{"id":"blk-17195","spans":[{"id":"spn-16459","text":"Define custom task profile"}]}]]},{"id":"blk-17196","kind":"paragraph","spans":[{"id":"spn-16460","marks":["bold"],"text":"Total: 6 tools exposed to the model (5 loop + 1 admin)."}]},{"id":"blk-17197","kind":"paragraph","spans":[{"id":"spn-16461","text":"---"}]},{"id":"blk-17198","kind":"heading","level":2,"spans":[{"id":"spn-16462","text":"Combined Impact"}]},{"head":[{"id":"blk-17200","spans":[{"id":"spn-16463","text":"Scenario"}]},{"id":"blk-17201","spans":[{"id":"spn-16464","text":"Before"}]},{"id":"blk-17202","spans":[{"id":"spn-16465","text":"After"}]}],"id":"blk-17199","kind":"table","rows":[[{"id":"blk-17203","spans":[{"id":"spn-16466","text":"Graphonomous alone"}]},{"id":"blk-17204","spans":[{"id":"spn-16467","text":"29 tools"}]},{"id":"blk-17205","spans":[{"id":"spn-16468","text":"5 tools"}]}],[{"id":"blk-17206","spans":[{"id":"spn-16469","text":"PRISM alone"}]},{"id":"blk-17207","spans":[{"id":"spn-16470","text":"47 tools"}]},{"id":"blk-17208","spans":[{"id":"spn-16471","text":"6 tools"}]}],[{"id":"blk-17209","spans":[{"id":"spn-16472","text":"Both in same session"}]},{"id":"blk-17210","spans":[{"id":"spn-16473","text":"76 tools"}]},{"id":"blk-17211","spans":[{"id":"spn-16474","text":"11 tools"}]}]]},{"id":"blk-17212","kind":"paragraph","spans":[{"id":"spn-16475","text":"Context savings: ~80% reduction in tool schema tokens. Selection accuracy: from ~49% (76 tools) to ~95% (11 tools)."}]},{"id":"blk-17213","kind":"heading","level":2,"spans":[{"id":"spn-16476","text":"The Interlocking Loops"}]},{"id":"blk-17214","kind":"paragraph","spans":[{"id":"spn-16477","text":"When PRISM benchmarks Graphonomous, the loops nest:"}]},{"id":"blk-17215","kind":"code","language":"text","text":"PRISM compose ──→ PRISM interact ──→ PRISM observe ──→ PRISM reflect ──→ PRISM diagnose\n                       │\n                       ▼\n              ┌─── Graphonomous ───┐\n              │  retrieve → route  │\n              │  → act → learn     │\n              │  → consolidate     │\n              └────────────────────┘"},{"id":"blk-17216","kind":"paragraph","spans":[{"id":"spn-16478","text":"PRISM's "},{"id":"spn-16479","marks":["code"],"text":"interact"},{"id":"spn-16480","text":" phase drives the system-under-test through its own closed loop. PRISM's "},{"id":"spn-16481","marks":["code"],"text":"observe"},{"id":"spn-16482","text":" phase judges how well that inner loop performed. PRISM's "},{"id":"spn-16483","marks":["code"],"text":"reflect"},{"id":"spn-16484","text":" phase evolves scenarios based on where the inner loop failed."}]},{"id":"blk-17217","kind":"paragraph","spans":[{"id":"spn-16485","text":"This is the knockout feature: "},{"id":"spn-16486","marks":["bold"],"text":"two self-improving loops, one inside the other."},{"id":"spn-16487","text":" The outer loop (PRISM) improves the benchmark. The inner loop (Graphonomous) improves the memory. Each makes the other sharper."}]},{"id":"blk-17218","kind":"heading","level":2,"spans":[{"id":"spn-16488","text":"Implementation Pattern"}]},{"id":"blk-17219","kind":"paragraph","spans":[{"id":"spn-16489","text":"Both systems use the same Elixir pattern: a single MCP component module per machine with an "},{"id":"spn-16490","marks":["code"],"text":"action"},{"id":"spn-16491","text":" field that dispatches internally."}]},{"id":"blk-17220","kind":"code","language":"elixir","text":"defmodule Graphonomous.MCP.Retrieve do\n  use Anubis.Server.Component, type: :tool\n\n  schema do\n    field(:action, :string,\n      required: true,\n      description: \"context | episodic | procedural | coverage | trace_evidence | frontier\"\n    )\n    # Union of all action-specific fields, each documented with which action uses it\n    field(:query, :string, description: \"Search query (context, episodic, procedural, frontier)\")\n    field(:limit, :number, description: \"Max results (context, episodic, procedural)\")\n    # ... etc\n  end\n\n  def execute(%{action: \"context\"} = params, frame), do: do_context(params, frame)\n  def execute(%{action: \"episodic\"} = params, frame), do: do_episodic(params, frame)\n  # ...\nend"},{"id":"blk-17221","kind":"paragraph","spans":[{"id":"spn-16492","text":"Each machine module delegates to the existing "},{"id":"spn-16493","marks":["code"],"text":"Graphonomous.*"},{"id":"spn-16494","text":" functions — the internal API doesn't change, only the MCP surface."}]},{"id":"blk-17222","kind":"heading","level":2,"spans":[{"id":"spn-16495","text":"Migration Strategy"}]},{"id":"blk-17223","kind":"paragraph","spans":[{"id":"spn-16496","text":"1. "},{"id":"spn-16497","marks":["bold"],"text":"Phase 1: Add machine modules alongside existing tools."},{"id":"spn-16498","text":" Both surfaces work. Register machines in "},{"id":"spn-16499","marks":["code"],"text":"server.ex"},{"id":"spn-16500","text":" with a "},{"id":"spn-16501","marks":["code"],"text":"v2_"},{"id":"spn-16502","text":" prefix for testing. 2. "},{"id":"spn-16503","marks":["bold"],"text":"Phase 2: Update skill prompts"},{"id":"spn-16504","text":" to reference machine verbs instead of individual tools. Run PRISM benchmarks comparing v1 vs v2 tool selection accuracy. 3. "},{"id":"spn-16505","marks":["bold"],"text":"Phase 3: Deprecate individual tools."},{"id":"spn-16506","text":" Remove from "},{"id":"spn-16507","marks":["code"],"text":"server.ex"},{"id":"spn-16508","text":", keep modules for reference. 4. "},{"id":"spn-16509","marks":["bold"],"text":"Phase 4: Remove deprecated modules."},{"id":"spn-16510","text":" Clean cut."}]},{"id":"blk-17224","kind":"heading","level":2,"spans":[{"id":"spn-16511","text":"Backward Compatibility"}]},{"id":"blk-17225","kind":"paragraph","spans":[{"id":"spn-16512","text":"Existing clients calling "},{"id":"spn-16513","marks":["code"],"text":"retrieve_context"},{"id":"spn-16514","text":" directly will break at Phase 3. Mitigation: the adapter layer in "},{"id":"spn-16515","marks":["code"],"text":"Prism.MCP.Adapter"},{"id":"spn-16516","text":" can translate legacy tool names to machine + action pairs during the transition."}]},{"id":"blk-17226","kind":"paragraph","spans":[{"id":"spn-16517","text":"---"}]},{"id":"blk-17227","kind":"heading","level":2,"spans":[{"id":"spn-16518","text":"Triple loop and beyond — PULSE generalization"}]},{"id":"blk-17228","kind":"paragraph","spans":[{"id":"spn-16519","text":"The Graphonomous ↔ PRISM dual loop is the canonical example, but the [&] ecosystem actually runs "},{"id":"spn-16520","marks":["bold"],"text":"at least three"},{"id":"spn-16521","text":" nested loops today:"}]},{"id":"blk-17229","kind":"code","language":"text","text":"PRISM (outer)        compose → interact → observe → reflect → diagnose\n  │\n  └─ Graphonomous    retrieve → route → act → learn → consolidate\n       │\n       └─ Deliberation    survey → triage → dispatch → act → learn"},{"id":"blk-17230","kind":"paragraph","spans":[{"id":"spn-16522","text":"OS-010 PULSE encodes this nesting in each manifest's "},{"id":"spn-16523","marks":["code"],"text":"nesting"},{"id":"spn-16524","text":" block:"}]},{"id":"blk-17231","items":[{"blocks":[{"id":"blk-17233","kind":"paragraph","spans":[{"id":"spn-16525","marks":["code"],"text":"prism.benchmark"},{"id":"spn-16526","text":" declares "},{"id":"spn-16527","marks":["code"],"text":"inner_loops: [graphonomous.continual_learning]"}]}],"id":"blk-17232","kind":"list-item"},{"blocks":[{"id":"blk-17235","kind":"paragraph","spans":[{"id":"spn-16528","marks":["code"],"text":"graphonomous.continual_learning"},{"id":"spn-16529","text":" declares "},{"id":"spn-16530","marks":["code"],"text":"inner_loops: [graphonomous.deliberate]"},{"id":"spn-16531","text":" and "},{"id":"spn-16532","marks":["code"],"text":"parent_loop: prism.benchmark"}]}],"id":"blk-17234","kind":"list-item"},{"blocks":[{"id":"blk-17237","kind":"paragraph","spans":[{"id":"spn-16533","marks":["code"],"text":"graphonomous.deliberate"},{"id":"spn-16534","text":" declares "},{"id":"spn-16535","marks":["code"],"text":"parent_loop: graphonomous.continual_learning"}]}],"id":"blk-17236","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-17238","kind":"paragraph","spans":[{"id":"spn-16536","text":"PULSE supports unbounded nesting depth. OS-008 (Agent Harness, draft) is expected to add a fourth outer layer that wraps PRISM itself — when it ships, the only change required is a new manifest with "},{"id":"spn-16537","marks":["code"],"text":"inner_loops: [prism.benchmark]"},{"id":"spn-16538","text":". No code changes to existing machines."}]},{"id":"blk-17239","kind":"heading","level":3,"spans":[{"id":"spn-16539","text":"Why this matters for the machine architecture"}]},{"id":"blk-17240","kind":"paragraph","spans":[{"id":"spn-16540","text":"The 5/6/11-tool count documented above is a "},{"id":"spn-16541","marks":["bold"],"text":"floor"},{"id":"spn-16542","text":", not a ceiling. Adding a third loop adds at most 5 more machines (one per phase kind), and because PULSE manifests declare the inner-loop boundary explicitly, the outer machines do not need to learn about inner machines individually. PRISM's "},{"id":"spn-16543","marks":["code"],"text":"interact"},{"id":"spn-16544","text":" machine, for example, drives any PULSE-conforming inner loop through its declared "},{"id":"spn-16545","marks":["code"],"text":"retrieve"},{"id":"spn-16546","text":" phase — it does not need a Graphonomous-specific code path."}]},{"head":[{"id":"blk-17242","spans":[{"id":"spn-16547","text":"Layers in session"}]},{"id":"blk-17243","spans":[{"id":"spn-16548","text":"Tool count (machines)"}]},{"id":"blk-17244","spans":[{"id":"spn-16549","text":"Tool count (legacy v1)"}]}],"id":"blk-17241","kind":"table","rows":[[{"id":"blk-17245","spans":[{"id":"spn-16550","text":"Graphonomous alone"}]},{"id":"blk-17246","spans":[{"id":"spn-16551","text":"5"}]},{"id":"blk-17247","spans":[{"id":"spn-16552","text":"29"}]}],[{"id":"blk-17248","spans":[{"id":"spn-16553","text":"Graphonomous + PRISM"}]},{"id":"blk-17249","spans":[{"id":"spn-16554","text":"11"}]},{"id":"blk-17250","spans":[{"id":"spn-16555","text":"76"}]}],[{"id":"blk-17251","spans":[{"id":"spn-16556","text":"Graphonomous + PRISM + OS-008 Harness"}]},{"id":"blk-17252","spans":[{"id":"spn-16557","text":"~16"}]},{"id":"blk-17253","spans":[{"id":"spn-16558","text":"~100+"}]}],[{"id":"blk-17254","spans":[{"id":"spn-16559","text":"Graphonomous + PRISM + OS-008 + AgenTroMatic deliberation"}]},{"id":"blk-17255","spans":[{"id":"spn-16560","text":"~21"}]},{"id":"blk-17256","spans":[{"id":"spn-16561","text":"~130+"}]}]]},{"id":"blk-17257","kind":"paragraph","spans":[{"id":"spn-16562","text":"The savings compound with depth, and PULSE's manifest standard is what makes the composition algebraic instead of ad-hoc."}]},{"id":"blk-17258","kind":"heading","level":3,"spans":[{"id":"spn-16563","text":"Three-protocol stack at runtime"}]},{"id":"blk-17259","kind":"code","language":"text","text":"┌──────────────────────────────────────────────────────────┐\n│  PRISM    — measures loops over time      (diagnostic)   │ OS-009\n├──────────────────────────────────────────────────────────┤\n│  PULSE    — declares loops + circulation   (temporal)    │ OS-010\n├──────────────────────────────────────────────────────────┤\n│  [&]      — composes capabilities          (structural)  │ AmpersandBoxDesign\n└──────────────────────────────────────────────────────────┘"},{"id":"blk-17260","kind":"paragraph","spans":[{"id":"spn-16564","text":"A loop is "},{"id":"spn-16565","marks":["bold"],"text":"PULSE-conforming"},{"id":"spn-16566","text":" if its manifest validates against "},{"id":"spn-16567","marks":["code"],"text":"pulse-loop-manifest.v0.1.json"},{"id":"spn-16568","text":" and its runtime passes all 12 conformance tests. A system is "},{"id":"spn-16569","marks":["bold"],"text":"PRISM-evaluable"},{"id":"spn-16570","text":" automatically once it is PULSE-conforming — PRISM's "},{"id":"spn-16571","marks":["code"],"text":"compose"},{"id":"spn-16572","text":" phase reads the manifest, injects scenarios at the declared "},{"id":"spn-16573","marks":["code"],"text":"retrieve"},{"id":"spn-16574","text":" boundary, and observes outcomes via the declared "},{"id":"spn-16575","marks":["code"],"text":"learn"},{"id":"spn-16576","text":" phase. No bespoke per-system integration required."}]},{"id":"blk-17261","kind":"paragraph","spans":[{"id":"spn-16577","text":"See "},{"id":"spn-16578","marks":["code"],"text":"/PULSE/manifests/"},{"id":"spn-16579","text":" for the canonical reference manifests and "},{"id":"spn-16580","marks":["code"],"text":"opensentience.org/docs/spec/OS-010-PULSE-SPECIFICATION.md"},{"id":"spn-16581","text":" for the full PULSE protocol spec."}]}],"edges":[],"id":"bagaaieraqvdnzt2jg37arbw7v44u4yof4dfix77zfkffa3ifbeuf5jsumq7a","vocabulary":"ampersand.docs.fs.v1"}