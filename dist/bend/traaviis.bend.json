{"bendscript":"0.1","blocks":[{"id":"blk-1","kind":"heading","level":1,"spans":[{"id":"spn-360","text":"TRAAVIIS"}]},{"id":"blk-2","kind":"paragraph","spans":[{"id":"spn-361","text":"TRAAVIIS provides "},{"id":"spn-362","marks":["bold"],"text":"evidence-grade environments for evaluating agents"},{"id":"spn-363","text":" and proves what happened inside them. TRVM worlds are its strongest deterministic "},{"id":"spn-364","text":"substrate; Evidence Residency is its first repository-evidence substrate. Version "},{"id":"spn-365","marks":["code"],"text":"0.1.0"},{"id":"spn-366","text":". "},{"id":"spn-367","marks":["code"],"text":"trvs"},{"id":"spn-368","text":" carries no world semantics of its own — it is a thin, honest terminal "},{"id":"spn-369","text":"over the existing Forge/TRVM engine."}]},{"id":"blk-3","kind":"heading","level":2,"spans":[{"id":"spn-370","text":"The command set"}]},{"id":"blk-4","items":[{"blocks":[{"id":"blk-6","kind":"paragraph","spans":[{"id":"spn-371","text":"trvs doctor — engine location, versions, verifier availability"}]}],"id":"blk-5","kind":"list-item"},{"blocks":[{"id":"blk-8","kind":"paragraph","spans":[{"id":"spn-372","text":"trvs id — the world's SemanticArtifactID (pure identity)"}]}],"id":"blk-7","kind":"list-item"},{"blocks":[{"id":"blk-10","kind":"paragraph","spans":[{"id":"spn-373","text":"trvs run — lower + deterministically fold; per-epoch film"}]}],"id":"blk-9","kind":"list-item"},{"blocks":[{"id":"blk-12","kind":"paragraph","spans":[{"id":"spn-374","text":"trvs verify — reference / native / oracle agreement (strict)"}]}],"id":"blk-11","kind":"list-item"},{"blocks":[{"id":"blk-14","kind":"paragraph","spans":[{"id":"spn-375","text":"trvs eval-one — evaluate one agent run over one frozen subject"}]}],"id":"blk-13","kind":"list-item"},{"blocks":[{"id":"blk-16","kind":"paragraph","spans":[{"id":"spn-376","text":"trvs eval — run an agent over a split, score every episode"}]}],"id":"blk-15","kind":"list-item"},{"blocks":[{"id":"blk-18","kind":"paragraph","spans":[{"id":"spn-377","text":"trvs pack — close a scaffold into a verified, reopened package"}]}],"id":"blk-17","kind":"list-item"},{"blocks":[{"id":"blk-20","kind":"paragraph","spans":[{"id":"spn-378","text":"trvs serve --ors — serve a packed environment as a submission endpoint"}]}],"id":"blk-19","kind":"list-item"},{"blocks":[{"id":"blk-22","kind":"paragraph","spans":[{"id":"spn-379","text":"trvs batch — run several candidates over one split, compare per task"}]}],"id":"blk-21","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-23","kind":"heading","level":2,"spans":[{"id":"spn-380","text":"The artifact ladder"}]},{"id":"blk-24","items":[{"blocks":[{"id":"blk-26","kind":"paragraph","spans":[{"id":"spn-381","text":"sem-… — same subject?"}]}],"id":"blk-25","kind":"list-item"},{"blocks":[{"id":"blk-28","kind":"paragraph","spans":[{"id":"spn-382","text":"task-… — same assignment?"}]}],"id":"blk-27","kind":"list-item"},{"blocks":[{"id":"blk-30","kind":"paragraph","spans":[{"id":"spn-383","text":"trace-… — same behavior?"}]}],"id":"blk-29","kind":"list-item"},{"blocks":[{"id":"blk-32","kind":"paragraph","spans":[{"id":"spn-384","text":"episode-… — same evaluated outcome?"}]}],"id":"blk-31","kind":"list-item"},{"blocks":[{"id":"blk-34","kind":"paragraph","spans":[{"id":"spn-385","text":"env-… — same environment release?"}]}],"id":"blk-33","kind":"list-item"},{"blocks":[{"id":"blk-36","kind":"paragraph","spans":[{"id":"spn-386","text":"bundle-… — same distributed package tree?"}]}],"id":"blk-35","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-37","kind":"heading","level":2,"spans":[{"id":"spn-387","text":"Install"}]},{"id":"blk-38","kind":"code","language":"bash","text":"pipx install traaviis     # or: pip install traaviis\ntrvs doctor              # check engine + verifiers\ntrvs verify worlds/alley.wrl   # reference · native · oracle → 3/3"},{"blocks":[{"id":"blk-40","kind":"paragraph","spans":[{"id":"spn-388","tex