{"bendscript":"0.1","blocks":[{"id":"blk-82724","kind":"heading","level":1,"spans":[{"id":"spn-147158","text":"01 — Agent Management"}]},{"blocks":[{"id":"blk-82726","kind":"paragraph","spans":[{"id":"spn-147159","marks":["bold"],"text":"Purpose:"},{"id":"spn-147160","text":" How to create, configure, update, disable, and delete agents. Covers the agent status state machine, provider configuration, and RLS isolation rules."}]}],"id":"blk-82725","kind":"quote"},{"id":"blk-82727","kind":"heading","level":2,"spans":[{"id":"spn-147161","text":"What Is an Agent?"}]},{"id":"blk-82728","kind":"paragraph","spans":[{"id":"spn-147162","text":"An "},{"id":"spn-147163","marks":["bold"],"text":"agent"},{"id":"spn-147164","text":" is a logical AI service owned by a single user. It has a selected runtime provider, configuration, and an optional active deployment. Agents are the top-level organizational unit in WebHost.Systems."}]},{"id":"blk-82729","kind":"heading","level":2,"spans":[{"id":"spn-147165","text":"Agent Fields"}]},{"head":[{"id":"blk-82731","spans":[{"id":"spn-147166","text":"Field"}]},{"id":"blk-82732","spans":[{"id":"spn-147167","text":"Type"}]},{"id":"blk-82733","spans":[{"id":"spn-147168","text":"Required"}]},{"id":"blk-82734","spans":[{"id":"spn-147169","text":"Description"}]}],"id":"blk-82730","kind":"table","rows":[[{"id":"blk-82735","spans":[{"id":"spn-147170","marks":["code"],"text":"name"}]},{"id":"blk-82736","spans":[{"id":"spn-147171","text":"string"}]},{"id":"blk-82737","spans":[{"id":"spn-147172","text":"Yes"}]},{"id":"blk-82738","spans":[{"id":"spn-147173","text":"Unique per user"}]}],[{"id":"blk-82739","spans":[{"id":"spn-147174","marks":["code"],"text":"description"}]},{"id":"blk-82740","spans":[{"id":"spn-147175","text":"string"}]},{"id":"blk-82741","spans":[{"id":"spn-147176","text":"No"}]},{"id":"blk-82742","spans":[{"id":"spn-147177","text":"Human-readable description"}]}],[{"id":"blk-82743","spans":[{"id":"spn-147178","marks":["code"],"text":"framework"}]},{"id":"blk-82744","spans":[{"id":"spn-147179","text":"string"}]},{"id":"blk-82745","spans":[{"id":"spn-147180","text":"Yes"}]},{"id":"blk-82746","spans":[{"id":"spn-147181","text":"Informational (e.g., \"langchain\", \"custom\")"}]}],[{"id":"blk-82747","spans":[{"id":"spn-147182","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-82748","spans":[{"id":"spn-147183","text":"enum"}]},{"id":"blk-82749","spans":[{"id":"spn-147184","text":"Yes"}]},{"id":"blk-82750","spans":[{"id":"spn-147185","marks":["code"],"text":"cloudflare"},{"id":"spn-147186","text":" or "},{"id":"spn-147187","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-82751","spans":[{"id":"spn-147188","marks":["code"],"text":"env_var_keys"}]},{"id":"blk-82752","spans":[{"id":"spn-147189","text":"string[]"}]},{"id":"blk-82753","spans":[{"id":"spn-147190","text":"No"}]},{"id":"blk-82754","spans":[{"id":"spn-147191","text":"Secret key names (values in Vault)"}]}],[{"id":"blk-82755","spans":[{"id":"spn-147192","marks":["code"],"text":"provider_config"}]},{"id":"blk-82756","spans":[{"id":"spn-147193","text":"JSONB"}]},{"id":"blk-82757","spans":[{"id":"spn-147194","text":"No"}]},{"id":"blk-82758","spans":[{"id":"spn-147195","text":"Runtime-specific configuration"}]}],[{"id":"blk-82759","spans":[{"id":"spn-147196","marks":["code"],"text":"status"}]},{"id":"blk-82760","spans":[{"id":"spn-147197","text":"enum"}]},{"id":"blk-82761","spans":[{"id":"spn-147198","text":"Auto"}]},{"id":"blk-82762","spans":[{"id":"spn-147199","text":"Managed by the platform"}]}]]},{"id":"blk-82763","kind":"heading","level":2,"spans":[{"id":"spn-147200","text":"Status State Machine"}]},{"id":"blk-82764","kind":"code","language":"text","text":"                    deploy success\n  created -----> deploying ---------> active\n     |               |                  |\n     |          deploy fail         disable()\n     |               |                  |\n     |               v                  v\n     |             error            disabled\n     |               |                  |\n     +---------------+--- re-deploy ---+"},{"head":[{"id":"blk-82766","spans":[{"id":"spn-147201","text":"Status"}]},{"id":"blk-82767","spans":[{"id":"spn-147202","text":"Meaning"}]},{"id":"blk-82768","spans":[{"id":"spn-147203","text":"Invocations Allowed"}]}],"id":"blk-82765","kind":"table","rows":[[{"id":"blk-82769","spans":[{"id":"spn-147204","marks":["code"],"text":"created"}]},{"id":"blk-82770","spans":[{"id":"spn-147205","text":"Agent exists but never deployed"}]},{"id":"blk-82771","spans":[{"id":"spn-147206","text":"No"}]}],[{"id":"blk-82772","spans":[{"id":"spn-147207","marks":["code"],"text":"deploying"}]},{"id":"blk-82773","spans":[{"id":"spn-147208","text":"Deployment in progress"}]},{"id":"blk-82774","spans":[{"id":"spn-147209","text":"No"}]}],[{"id":"blk-82775","spans":[{"id":"spn-147210","marks":["code"],"text":"active"}]},{"id":"blk-82776","spans":[{"id":"spn-147211","text":"Active deployment ready"}]},{"id":"blk-82777","spans":[{"id":"spn-147212","text":"Yes"}]}],[{"id":"blk-82778","spans":[{"id":"spn-147213","marks":["code"],"text":"error"}]},{"id":"blk-82779","spans":[{"id":"spn-147214","text":"Last deployment failed"}]},{"id":"blk-82780","spans":[{"id":"spn-147215","text":"No"}]}],[{"id":"blk-82781","spans":[{"id":"spn-147216","marks":["code"],"text":"disabled"}]},{"id":"blk-82782","spans":[{"id":"spn-147217","text":"Manually disabled by user"}]},{"id":"blk-82783","spans":[{"id":"spn-147218","text":"No"}]}]]},{"id":"blk-82784","kind":"paragraph","spans":[{"id":"spn-147219","marks":["bold"],"text":"Invariant:"},{"id":"spn-147220","text":" Only "},{"id":"spn-147221","marks":["code"],"text":"active"},{"id":"spn-147222","text":" agents accept invocations."}]},{"id":"blk-82785","kind":"heading","level":2,"spans":[{"id":"spn-147223","text":"CRUD Operations"}]},{"id":"blk-82786","kind":"heading","level":3,"spans":[{"id":"spn-147224","text":"Create Agent"}]},{"id":"blk-82787","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\",\n    \"env_var_keys\": [\"OPENAI_API_KEY\"]\n  }'"},{"id":"blk-82788","kind":"heading","level":3,"spans":[{"id":"spn-147225","text":"Update Agent"}]},{"id":"blk-82789","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/update_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"description\": \"Updated description\" }'"},{"id":"blk-82790","kind":"heading","level":3,"spans":[{"id":"spn-147226","text":"List Agents"}]},{"id":"blk-82791","kind":"code","language":"bash","text":"curl \"$SUPABASE_URL/rest/v1/agents?select=*\" \\\n  -H \"Authorization: Bearer $TOKEN\""},{"id":"blk-82792","kind":"paragraph","spans":[{"id":"spn-147227","text":"RLS ensures only the authenticated user's agents are returned."}]},{"id":"blk-82793","kind":"heading","level":3,"spans":[{"id":"spn-147228","text":"Disable Agent"}]},{"id":"blk-82794","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/disable_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-82795","kind":"paragraph","spans":[{"id":"spn-147229","text":"Sets status to "},{"id":"spn-147230","marks":["code"],"text":"disabled"},{"id":"spn-147231","text":". All invocations will be rejected until re-enabled."}]},{"id":"blk-82796","kind":"heading","level":3,"spans":[{"id":"spn-147232","text":"Delete Agent (Soft)"}]},{"id":"blk-82797","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/delete_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\" }'"},{"id":"blk-82798","kind":"paragraph","spans":[{"id":"spn-147233","text":"Soft-deletes the agent. Provider resources should be revoked where possible."}]},{"id":"blk-82799","kind":"heading","level":2,"spans":[{"id":"spn-147234","text":"Provider Config"}]},{"id":"blk-82800","kind":"paragraph","spans":[{"id":"spn-147235","text":"The "},{"id":"spn-147236","marks":["code"],"text":"provider_config"},{"id":"spn-147237","text":" JSONB field holds runtime-specific settings:"}]},{"id":"blk-82801","kind":"paragraph","spans":[{"id":"spn-147238","marks":["bold"],"text":"Cloudflare:"}]},{"id":"blk-82802","kind":"code","language":"json","text":"{\n  \"worker_name\": \"agent-<uuid>\",\n  \"durable_object_namespace\": \"sessions\",\n  \"route_pattern\": \"agents.example.com/<uuid>/*\"\n}"},{"id":"blk-82803","kind":"paragraph","spans":[{"id":"spn-147239","marks":["bold"],"text":"AgentCore:"}]},{"id":"blk-82804","kind":"code","language":"json","text":"{\n  \"runtime_id\": \"arn:aws:bedrock-agentcore:...\",\n  \"container_port\": 8080,\n  \"idle_timeout_seconds\": 300,\n  \"network_mode\": \"egress_only\"\n}"},{"id":"blk-82805","kind":"heading","level":2,"spans":[{"id":"spn-147240","text":"RLS Isolation"}]},{"id":"blk-82806","kind":"paragraph","spans":[{"id":"spn-147241","text":"Every query against the "},{"id":"spn-147242","marks":["code"],"text":"agents"},{"id":"spn-147243","text":" table is filtered by:"}]},{"id":"blk-82807","kind":"code","language":"sql","text":"auth.uid() = user_id"},{"id":"blk-82808","items":[{"blocks":[{"id":"blk-82810","kind":"paragraph","spans":[{"id":"spn-147244","text":"Users can only see, update, and delete their own agents."}]}],"id":"blk-82809","kind":"list-item"},{"blocks":[{"id":"blk-82812","kind":"paragraph","spans":[{"id":"spn-147245","text":"The "},{"id":"spn-147246","marks":["code"],"text":"user_id"},{"id":"spn-147247","text":" field is set automatically from "},{"id":"spn-147248","marks":["code"],"text":"auth.uid()"},{"id":"spn-147249","text":" on creation."}]}],"id":"blk-82811","kind":"list-item"},{"blocks":[{"id":"blk-82814","kind":"paragraph","spans":[{"id":"spn-147250","text":"No admin bypass exists in MVP."}]}],"id":"blk-82813","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82815","kind":"heading","level":2,"spans":[{"id":"spn-147251","text":"Checklist"}]},{"id":"blk-82816","items":[{"blocks":[{"id":"blk-82818","kind":"paragraph","spans":[{"id":"spn-147252","text":"[ ] Agent name is unique within the user's namespace"}]}],"id":"blk-82817","kind":"list-item"},{"blocks":[{"id":"blk-82820","kind":"paragraph","spans":[{"id":"spn-147253","text":"[ ] "},{"id":"spn-147254","marks":["code"],"text":"runtime_provider"},{"id":"spn-147255","text":" matches the user's tier (AgentCore requires paid tier)"}]}],"id":"blk-82819","kind":"list-item"},{"blocks":[{"id":"blk-82822","kind":"paragraph","spans":[{"id":"spn-147256","text":"[ ] Secret key names in "},{"id":"spn-147257","marks":["code"],"text":"env_var_keys"},{"id":"spn-147258","text":" have corresponding Vault entries"}]}],"id":"blk-82821","kind":"list-item"},{"blocks":[{"id":"blk-82824","kind":"paragraph","spans":[{"id":"spn-147259","text":"[ ] Status transitions follow the state machine (no skipping states)"}]}],"id":"blk-82823","kind":"list-item"},{"blocks":[{"id":"blk-82826","kind":"paragraph","spans":[{"id":"spn-147260","text":"[ ] RLS policy is active on the "},{"id":"spn-147261","marks":["code"],"text":"agents"},{"id":"spn-147262","text":" table"}]}],"id":"blk-82825","kind":"list-item"},{"blocks":[{"id":"blk-82828","kind":"paragraph","spans":[{"id":"spn-147263","text":"[ ] Soft-delete revokes provider resources where feasible"}]}],"id":"blk-82827","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera5uzmyeoh2ui62b7zlw5r2eqyyq26m2afmpiyr36tnm7qpc34pxgq","vocabulary":"ampersand.docs.fs.v1"}