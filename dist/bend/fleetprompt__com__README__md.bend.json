{"bendscript":"0.1","blocks":[{"id":"blk-67920","kind":"heading","level":1,"spans":[{"id":"spn-129303","text":"FleetPrompt"}]},{"id":"blk-67921","kind":"paragraph","spans":[{"id":"spn-129304","text":"Registry for agents — publish one, install one, and check what it claims before you run it. Elixir/OTP with a Phoenix API and an MCP server. Part of the "},{"id":"spn-129305","marks":[{"kind":"link","predicate":"cites","target":"https://computedriven.com"}],"text":"ComputeDriven"},{"id":"spn-129306","text":" world."}]},{"id":"blk-67922","kind":"paragraph","spans":[{"id":"spn-129307","marks":["bold"],"text":"Written 2026-08-16."},{"id":"spn-129308","text":" This repository had no README before that date. Every figure below was measured that day with the command beside it."}]},{"id":"blk-67923","kind":"heading","level":2,"spans":[{"id":"spn-129309","text":"Status, honestly"}]},{"head":[{"id":"blk-67925","spans":[{"id":"spn-129310","text":""}]},{"id":"blk-67926","spans":[{"id":"spn-129311","text":""}]}],"id":"blk-67924","kind":"table","rows":[[{"id":"blk-67927","spans":[{"id":"spn-129312","text":"Version"}]},{"id":"blk-67928","spans":[{"id":"spn-129313","marks":["code"],"text":"0.1.0"},{"id":"spn-129314","text":" ("},{"id":"spn-129315","marks":["code"],"text":"mix.exs"},{"id":"spn-129316","text":", app "},{"id":"spn-129317","marks":["code"],"text":":fleet_prompt"},{"id":"spn-129318","text":")"}]}],[{"id":"blk-67929","spans":[{"id":"spn-129319","text":"Tests"}]},{"id":"blk-67930","spans":[{"id":"spn-129320","marks":["bold"],"text":"112 passing, 0 failures, 2 excluded"},{"id":"spn-129321","text":" — "},{"id":"spn-129322","marks":["code"],"text":"mix test"}]}],[{"id":"blk-67931","spans":[{"id":"spn-129323","text":"Marketing page"}]},{"id":"blk-67932","spans":[{"id":"spn-129324","marks":["bold"],"text":"live"},{"id":"spn-129325","text":" — "},{"id":"spn-129326","marks":["code"],"text":"https://fleetprompt.com"},{"id":"spn-129327","text":" answers 200"}]}],[{"id":"blk-67933","spans":[{"id":"spn-129328","text":"Application"}]},{"id":"blk-67934","spans":[{"id":"spn-129329","marks":["bold"],"text":"live on Fly"},{"id":"spn-129330","text":" as app "},{"id":"spn-129331","marks":["code"],"text":"fleetprompt"},{"id":"spn-129332","text":" — "},{"id":"spn-129333","marks":["code"],"text":"https://app.fleetprompt.com"},{"id":"spn-129334","text":" answers 200, and "},{"id":"spn-129335","marks":["code"],"text":"POST /mcp"},{"id":"spn-129336","text":" returns 200"}]}],[{"id":"blk-67935","spans":[{"id":"spn-129337","text":"Evidence rung"}]},{"id":"blk-67936","spans":[{"id":"spn-129338","marks":["code"],"text":"live_deployed"}]}]]},{"id":"blk-67937","kind":"paragraph","spans":[{"id":"spn-129339","marks":["bold"],"text":"The test count is 112, not 121."},{"id":"spn-129340","text":" "},{"id":"spn-129341","marks":["code"],"text":"COMPUTEDRIVEN_POSITIONING_PLAN.md"},{"id":"spn-129342","text":" says 121; the suite says 112 with 2 excluded. The suite counts itself and the plan does not, so the suite wins. Quote "},{"id":"spn-129343","marks":["code"],"text":"mix test"},{"id":"spn-129344","text":"; never hand-type this number — that drift has now happened to a law count, a migration count and two test counts in this portfolio."}]},{"id":"blk-67938","kind":"paragraph","spans":[{"id":"spn-129345","marks":["bold"],"text":"What is live is the prior design."},{"id":"spn-129346","text":" The marketing page describes a replay-gated, content-addressed registry. What is deployed predates that. The portfolio nav carries "},{"id":"spn-129347","marks":["code"],"text":"status: \"live · prior design\""},{"id":"spn-129348","text":" for exactly this reason: \"shipped\" is true (it runs) and would be misread as \"the replay-gated thing ships\". It does not."}]},{"id":"blk-67939","kind":"heading","level":2,"spans":[{"id":"spn-129349","text":"Quick start"}]},{"id":"blk-67940","kind":"code","language":"bash","text":"mix deps.get\nmix compile --warnings-as-errors\nmix test                       # 112 tests, 2 excluded\nmix format --check-formatted\nmix phx.server"},{"id":"blk-67941","kind":"paragraph","spans":[{"id":"spn-129350","text":"Deploy is "},{"id":"spn-129351","marks":["code"],"text":"fly deploy"},{"id":"spn-129352","text":" against "},{"id":"spn-129353","marks":["code"],"text":"fly.toml"},{"id":"spn-129354","text":" (app "},{"id":"spn-129355","marks":["code"],"text":"fleetprompt"},{"id":"spn-129356","text":")."}]},{"id":"blk-67942","kind":"paragraph","spans":[{"id":"spn-129357","text":"Check the deployed MCP endpoint:"}]},{"id":"blk-67943","kind":"code","language":"bash","text":"curl -s -o /dev/null -w '%{http_code}\\n' -X POST \\\n  -H 'content-type: application/json' \\\n  -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' \\\n  https://app.fleetprompt.com/mcp        # -> 200"},{"id":"blk-67944","kind":"heading","level":2,"spans":[{"id":"spn-129358","text":"The specification is authoritative, and superseded in part"}]},{"id":"blk-67945","kind":"paragraph","spans":[{"id":"spn-129359","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-129360","text":" is the technical specification and drives implementation. It carries a supersession banner added 2026-08-15:"}]},{"id":"blk-67946","items":[{"blocks":[{"id":"blk-67948","kind":"paragraph","spans":[{"id":"spn-129361","marks":["bold"],"text":"Superseded:"},{"id":"spn-129362","text":" Supabase Auth as publisher identity, the shared "},{"id":"spn-129363","marks":["code"],"text":"amp.profiles"}]}],"id":"blk-67947","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67949","kind":"paragraph","spans":[{"id":"spn-129364","text":"table, and anything else resting on the shared-Supabase data layer, which was abandoned by ruling on "},{"id":"spn-129365","marks":["bold"],"text":"2026-07-30"},{"id":"spn-129366","text":" in favour of "},{"id":"spn-129367","marks":["code"],"text":"studbook"},{"id":"spn-129368","text":". studbook is a spec with no implementation, blocked on an unruled confidentiality question. "},{"id":"spn-129369","marks":["bold"],"text":"Do not build against it yet."}]},{"id":"blk-67950","items":[{"blocks":[{"id":"blk-67952","kind":"paragraph","spans":[{"id":"spn-129370","marks":["bold"],"text":"Also corrected in the banner:"},{"id":"spn-129371","text":" the spec describes WebHost.Systems as a"}]}],"id":"blk-67951","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67953","kind":"paragraph","spans":[{"id":"spn-129372","marks":["bold"],"text":"Convex"},{"id":"spn-129373","text":" backend. It is not, and never was in this tree — WebHost depends on "},{"id":"spn-129374","marks":["code"],"text":"@supabase/supabase-js"},{"id":"spn-129375","text":" with no Convex dependency anywhere."}]},{"id":"blk-67954","items":[{"blocks":[{"id":"blk-67956","kind":"paragraph","spans":[{"id":"spn-129376","marks":["bold"],"text":"Not superseded:"},{"id":"spn-129377","text":" the registry, trust, install and crystallizer design,"}]}],"id":"blk-67955","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67957","kind":"paragraph","spans":[{"id":"spn-129378","text":"which is the bulk of the document."}]},{"id":"blk-67958","kind":"paragraph","spans":[{"id":"spn-129379","text":"The spec was "},{"id":"spn-129380","marks":["bold"],"text":"not rewritten"},{"id":"spn-129381","text":". It is a dated design record and rewriting it would fabricate a review nobody performed."}]},{"id":"blk-67959","kind":"heading","level":2,"spans":[{"id":"spn-129382","text":"A standing direction that affects this repository"}]},{"id":"blk-67960","kind":"paragraph","spans":[{"id":"spn-129383","text":"Ruled 2026-08-15: "},{"id":"spn-129384","marks":["bold"],"text":"compute moves into the ComputeDriven OS, and the Fly.io apps become storage or nothing."},{"id":"spn-129385","text":" This app is one of them. Nothing is torn down before its OS-side replacement runs locally, but check "},{"id":"spn-129386","marks":["code"],"text":"STACK_HUB.md"},{"id":"spn-129387","text":" in the workspace before planning new Fly-shaped work."}]},{"id":"blk-67961","kind":"paragraph","spans":[{"id":"spn-129388","marks":["code"],"text":"fleet.*"},{"id":"spn-129389","text":" in the archived Supabase instance still serves this product "},{"id":"spn-129390","marks":["bold"],"text":"today"},{"id":"spn-129391","text":", which is precisely why that instance is archived rather than deleted."}]},{"id":"blk-67962","kind":"heading","level":2,"spans":[{"id":"spn-129392","text":"The portfolio nav"}]},{"id":"blk-67963","kind":"paragraph","spans":[{"id":"spn-129393","marks":["code"],"text":"amp-nav.js"},{"id":"spn-129394","text":" is a "},{"id":"spn-129395","marks":["bold"],"text":"deployed copy"},{"id":"spn-129396","text":". The source is "},{"id":"spn-129397","marks":["code"],"text":"ampersand-nav/src/amp-nav.js"},{"id":"spn-129398","text":", fanned out by "},{"id":"spn-129399","marks":["code"],"text":"sync-nav.sh"},{"id":"spn-129400","text":". Edits here are lost on the next sync."}]},{"id":"blk-67964","kind":"heading","level":2,"spans":[{"id":"spn-129401","text":"Conventions"}]},{"id":"blk-67965","items":[{"blocks":[{"id":"blk-67967","kind":"paragraph","spans":[{"id":"spn-129402","marks":["code"],"text":"mix format"},{"id":"spn-129403","text":", warnings-as-errors."}]}],"id":"blk-67966","kind":"list-item"},{"blocks":[{"id":"blk-67969","kind":"paragraph","spans":[{"id":"spn-129404","text":"Never commit secrets."}]}],"id":"blk-67968","kind":"list-item"},{"blocks":[{"id":"blk-67971","kind":"paragraph","spans":[{"id":"spn-129405","marks":["code"],"text":"old_scrap/"},{"id":"spn-129406","text":" is historical and not authoritative."}]}],"id":"blk-67970","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67972","kind":"heading","level":2,"spans":[{"id":"spn-129407","text":"Related"}]},{"id":"blk-67973","items":[{"blocks":[{"id":"blk-67975","kind":"paragraph","spans":[{"id":"spn-129408","marks":[{"kind":"link","predicate":"cites","target":"