nrouter.js"}]},{"id":"blk-57185","kind":"paragraph","spans":[{"id":"spn-66883","text":"Client-side OpenRouter caller:"}]},{"id":"blk-57186","kind":"code","language":"js","text":"export async function callOpenRouter(apiKey, messages, tools, model) {\n  const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {\n    method: 'POST',\n    headers: {\n      'Authorization': `Bearer ${apiKey}`,\n      'Content-Type': 'application/json',\n      'HTTP-Referer': 'https://runefort.com',\n      'X-Title': 'RuneFort'\n    },\n    body: JSON.stringify({ model, messages, tools, max_tokens: 4096 })\n  });\n  return res.json();\n}"},{"id":"blk-57187","kind":"paragraph","spans":[{"id":"spn-66884","text":"Default model: "},{"id":"spn-66885","marks":["code"],"text":"qwen/qwen3-235b-a22b"},{"id":"spn-66886","text":" (free on OpenRouter)."}]},{"id":"blk-57188","kind":"heading","level":3,"spans":[{"id":"spn-66887","marks":["code"],"text":"src/lib/stores/apikey.svelte.js"}]},{"id":"blk-57189","kind":"paragraph","spans":[{"id":"spn-66888","text":"Svelte 5 rune store wrapping storage:"}]},{"id":"blk-57190","kind":"code","language":"js","text":"let _key = $state(null);\nexport function getApiKey() { return _key; }\nexport function initApiKey() { _key = loadApiKey(); }\nexport function setApiKey(k) { _key = k; saveApiKey(k); }\nexport function removeApiKey() { _key = null; clearApiKey(); }\nexport function hasApiKey() { return !!_key; }"},{"id":"blk-57191","kind":"heading","level":2,"spans":[{"id":"spn-66889","text":"Integration Point"}]},{"id":"blk-57192","kind":"paragraph","spans":[{"id":"spn-66890","text":"Add a key icon button to the "},{"id":"spn-66891","marks":["code"],"text":"/app"},{"id":"spn-66892","text":" toolbar (next to save button). Opens "},{"id":"spn-66893","marks":["code"],"text":"ApiKeyModal"},{"id":"spn-66894","text":". Show a green dot indicator when a key is set."}]},{"id":"blk-57193","kind":"heading","level":2,"spans":[{"id":"spn-66895","text":"Constraint