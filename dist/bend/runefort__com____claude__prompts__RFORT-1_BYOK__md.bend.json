nrouter.js"}]},{"id":"blk-56213","kind":"paragraph","spans":[{"id":"spn-64589","text":"Client-side OpenRouter caller:"}]},{"id":"blk-56214","kind":"code","language":"js","text":"export async function callOpenRouter(apiKey, messages, tools, model) {\n  const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {\n    method: 'POST',\n    headers: {\n      'Authorization': `Bearer ${apiKey}`,\n      'Content-Type': 'application/json',\n      'HTTP-Referer': 'https://runefort.com',\n      'X-Title': 'RuneFort'\n    },\n    body: JSON.stringify({ model, messages, tools, max_tokens: 4096 })\n  });\n  return res.json();\n}"},{"id":"blk-56215","kind":"paragraph","spans":[{"id":"spn-64590","text":"Default model: "},{"id":"spn-64591","marks":["code"],"text":"qwen/qwen3-235b-a22b"},{"id":"spn-64592","text":" (free on OpenRouter)."}]},{"id":"blk-56216","kind":"heading","level":3,"spans":[{"id":"spn-64593","marks":["code"],"text":"src/lib/stores/apikey.svelte.js"}]},{"id":"blk-56217","kind":"paragraph","spans":[{"id":"spn-64594","text":"Svelte 5 rune store wrapping storage:"}]},{"id":"blk-56218","kind":"code","language":"js","text":"let _key = $state(null);\nexport function getApiKey() { return _key; }\nexport function initApiKey() { _key = loadApiKey(); }\nexport function setApiKey(k) { _key = k; saveApiKey(k); }\nexport function removeApiKey() { _key = null; clearApiKey(); }\nexport function hasApiKey() { return !!_key; }"},{"id":"blk-56219","kind":"heading","level":2,"spans":[{"id":"spn-64595","text":"Integration Point"}]},{"id":"blk-56220","kind":"paragraph","spans":[{"id":"spn-64596","text":"Add a key icon button to the "},{"id":"spn-64597","marks":["code"],"text":"/app"},{"id":"spn-64598","text":" toolbar (next to save button). Opens "},{"id":"spn-64599","marks":["code"],"text":"ApiKeyModal"},{"id":"spn-64600","text":". Show a green dot indicator when a key is set."}]},{"id":"blk-56221","kind":"heading","level":2,"spans":[{"id":"spn-64601","text":"Constraints"}]},{"id":"blk-56222","items":[{"blocks":[{"id":"blk-56224","kind":"paragraph","spans":[{"id":"spn-64602","text":"No server-side key storage — localStorage only"}]}],"id":"blk-56223","kind":"list-item"},{"blocks":[{"id":"blk-56226","kind":"paragraph","spans":[{"id":"spn-64603","text":"Svelte 5 runes ("},{"id":"spn-64604","marks":["code"],"text":"$state"},{"id":"spn-64605","text":", "},{"id":"spn-64606","marks":["code"],"text":"$props"},{"id":"spn-64607","text":", "},{"id":"spn-64608","marks":["code"],"text":"$effect"},{"id":"spn-64609","text":") — no legacy stores"}]}],"id":"blk-56225","kind":"list-item"},{"blocks":[{"id":"blk-56228","kind":"paragraph","spans":[{"id":"spn-64610","text":"Match RuneFort's dark amber aesthetic (bg-zinc-900, amber-400 accents)"}]}],"id":"blk-56227","kind":"list-item"},{"blocks":[{"id":"blk-56230","kind":"paragraph","spans":[{"id":"spn-64611","marks":["code"],"text":"export const ssr = false"},{"id":"spn-64612","text":" already set on "},{"id":"spn-64613","marks":["code"],"text":"/app"},{"id":"spn-64614","text":" route"}]}],"id":"blk-56229","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraiblvih27gils6witcm6mkh25pj7i52grvgazgpgjyzroxcb4vldq","vocabulary":"ampersand.docs.fs.v1"}