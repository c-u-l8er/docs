33","marks":["code"],"text":"src/lib/play/openrouter.js"}]},{"id":"blk-82911","kind":"paragraph","spans":[{"id":"spn-115034","text":"Client-side OpenRouter caller:"}]},{"id":"blk-82912","kind":"code","language":"js","text":"export async function callOpenRouter(apiKey, messages, tools, model) {\n  const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {\n    method: 'POST',\n    headers: {\n      'Authorization': `Bearer ${apiKey}`,\n      'Content-Type': 'application/json',\n      'HTTP-Referer': 'https://runefort.com',\n      'X-Title': 'RuneFort'\n    },\n    body: JSON.stringify({ model, messages, tools, max_tokens: 4096 })\n  });\n  return res.json();\n}"},{"id":"blk-82913","kind":"paragraph","spans":[{"id":"spn-115035","text":"Default model: "},{"id":"spn-115036","marks":["code"],"text":"qwen/qwen3-235b-a22b"},{"id":"spn-115037","text":" (free on OpenRouter)."}]},{"id":"blk-82914","kind":"heading","level":3,"spans":[{"id":"spn-115038","marks":["code"],"text":"src/lib/stores/apikey.svelte.js"}]},{"id":"blk-82915","kind":"paragraph","spans":[{"id":"spn-115039","text":"Svelte 5 rune store wrapping storage:"}]},{"id":"blk-82916","kind":"code","language":"js","text":"let _key = $state(null);\nexport function getApiKey() { return _key; }\nexport function initApiKey() { _key = loadApiKey(); }\nexport function setApiKey(k) { _key = k; saveApiKey(k); }\nexport function removeApiKey() { _key = null; clearApiKey(); }\nexport function hasApiKey() { return !!_key; }"},{"id":"blk-82917","kind":"heading","level":2,"spans":[{"id":"spn-115040","text":"Integration Point"}]},{"id":"blk-82918","kind":"paragraph","spans":[{"id":"spn-115041","text":"Add a key icon button to the "},{"id":"spn-115042","marks":["code"],"text":"/app"},{"id":"spn-115043","text":" toolbar (next to save button). Opens "},{"id":"spn-115044","marks":["code"],"text":"ApiKeyModal"},{"id":"spn-115045","text":". Show a green dot indicator when a key is set."}]},{"id":"blk-82919","kind":"heading