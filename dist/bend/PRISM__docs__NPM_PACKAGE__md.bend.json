{"bendscript":"0.1","blocks":[{"id":"blk-22449","kind":"heading","level":1,"spans":[{"id":"spn-22548","text":"os-prism — NPM Package Specification"}]},{"id":"blk-22450","kind":"paragraph","spans":[{"id":"spn-22549","marks":["bold"],"text":"Package"},{"id":"spn-22550","text":": "},{"id":"spn-22551","marks":["code"],"text":"os-prism"},{"id":"spn-22552","text":" "},{"id":"spn-22553","marks":["bold"],"text":"Version"},{"id":"spn-22554","text":": "},{"id":"spn-22555","marks":["code"],"text":"0.1.0"},{"id":"spn-22556","text":" (initial) "},{"id":"spn-22557","marks":["bold"],"text":"Language"},{"id":"spn-22558","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-22559","marks":["bold"],"text":"License"},{"id":"spn-22560","text":": Apache-2.0 "},{"id":"spn-22561","marks":["bold"],"text":"Registry"},{"id":"spn-22562","text":": https://www.npmjs.com/package/os-prism "},{"id":"spn-22563","marks":["bold"],"text":"Repository"},{"id":"spn-22564","text":": "},{"id":"spn-22565","marks":["code"],"text":"AmpersandBoxDesign/PRISM"},{"id":"spn-22566","text":" (monorepo subdir)"}]},{"id":"blk-22451","kind":"heading","level":2,"spans":[{"id":"spn-22567","text":"Purpose"}]},{"id":"blk-22452","kind":"paragraph","spans":[{"id":"spn-22568","marks":["code"],"text":"os-prism"},{"id":"spn-22569","text":" is the MCP server for OS-009 PRISM. It exposes the 6 PRISM loop-phase machines ("},{"id":"spn-22570","marks":["code"],"text":"compose"},{"id":"spn-22571","text":", "},{"id":"spn-22572","marks":["code"],"text":"interact"},{"id":"spn-22573","text":", "},{"id":"spn-22574","marks":["code"],"text":"observe"},{"id":"spn-22575","text":", "},{"id":"spn-22576","marks":["code"],"text":"reflect"},{"id":"spn-22577","text":", "},{"id":"spn-22578","marks":["code"],"text":"diagnose"},{"id":"spn-22579","text":", "},{"id":"spn-22580","marks":["code"],"text":"config"},{"id":"spn-22581","text":") over stdio and runs benchmarks against any PULSE-conforming memory system. Unlike the Fly.io-hosted PRISM service, "},{"id":"spn-22582","marks":["code"],"text":"os-prism"},{"id":"spn-22583","text":" runs locally and stores benchmark state in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-22453","kind":"paragraph","spans":[{"id":"spn-22584","marks":["code"],"text":"os-prism"},{"id":"spn-22585","text":" wraps the existing Elixir PRISM engine via the same postinstall escript pattern that "},{"id":"spn-22586","marks":["code"],"text":"graphonomous"},{"id":"spn-22587","text":" uses. The Elixir engine carries PRISM's sophisticated IRT/Rasch calibration, three-layer judging pipeline, and scenario evolution logic — porting those to JavaScript is out of scope for v0.1 (the JS IRT ecosystem is thin; see "},{"id":"spn-22588","marks":["code"],"text":"../../../memory/research"},{"id":"spn-22589","text":" for details)."}]},{"id":"blk-22454","kind":"heading","level":2,"spans":[{"id":"spn-22590","text":"Install"}]},{"id":"blk-22455","kind":"code","language":"bash","text":"npx -y os-prism --db ~/.os-prism/benchmarks.db"},{"id":"blk-22456","kind":"paragraph","spans":[{"id":"spn-22591","text":"Or in "},{"id":"spn-22592","marks":["code"],"text":".mcp.json"},{"id":"spn-22593","text":":"}]},{"id":"blk-22457","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"prism\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"os-prism\", \"--db\", \"~/.os-prism/benchmarks.db\"]\n    }\n  }\n}"},{"id":"blk-22458","kind":"paragraph","spans":[{"id":"spn-22594","marks":["code"],"text":"postinstall"},{"id":"spn-22595","text":" fetches the platform-appropriate Elixir escript bundle (darwin-x64, darwin-arm64, linux-x64, linux-arm64) from the GitHub release assets attached to the matching "},{"id":"spn-22596","marks":["code"],"text":"os-prism-vX.Y.Z"},{"id":"spn-22597","text":" git tag, verifies the SHA256, and installs it under "},{"id":"spn-22598","marks":["code"],"text":"vendor/"},{"id":"spn-22599","text":". Offline installs can set "},{"id":"spn-22600","marks":["code"],"text":"PRISM_ESCRIPT_PATH"},{"id":"spn-22601","text":" to skip the fetch."}]},{"id":"blk-22459","kind":"heading","level":2,"spans":[{"id":"spn-22602","text":"CLI Flags"}]},{"head":[{"id":"blk-22461","spans":[{"id":"spn-22603","text":"Flag"}]},{"id":"blk-22462","spans":[{"id":"spn-22604","text":"Default"}]},{"id":"blk-22463","spans":[{"id":"spn-22605","text":"Description"}]}],"id":"blk-22460","kind":"table","rows":[[{"id":"blk-22464","spans":[{"id":"spn-22606","marks":["code"],"text":"--db <path>"}]},{"id":"blk-22465","spans":[{"id":"spn-22607","marks":["code"],"text":"~/.os-prism/benchmarks.db"}]},{"id":"blk-22466","spans":[{"id":"spn-22608","text":"SQLite database path."}]}],[{"id":"blk-22467","spans":[{"id":"spn-22609","marks":["code"],"text":"--transport"}]},{"id":"blk-22468","spans":[{"id":"spn-22610","marks":["code"],"text":"stdio"}]},{"id":"blk-22469","spans":[{"id":"spn-22611","marks":["code"],"text":"stdio"},{"id":"spn-22612","text":" or "},{"id":"spn-22613","marks":["code"],"text":"http"},{"id":"spn-22614","text":"."}]}],[{"id":"blk-22470","spans":[{"id":"spn-22615","marks":["code"],"text":"--port <n>"}]},{"id":"blk-22471","spans":[{"id":"spn-22616","marks":["code"],"text":"4712"}]},{"id":"blk-22472","spans":[{"id":"spn-22617","text":"HTTP port (ignored for stdio)."}]}],[{"id":"blk-22473","spans":[{"id":"spn-22618","marks":["code"],"text":"--engine-path <path>"}]},{"id":"blk-22474","spans":[{"id":"spn-22619","marks":["code"],"text":"./vendor/prism_engine"}]},{"id":"blk-22475","spans":[{"id":"spn-22620","text":"Path to the bundled Elixir escript."}]}],[{"id":"blk-22476","spans":[{"id":"spn-22621","marks":["code"],"text":"--llm-provider"}]},{"id":"blk-22477","spans":[{"id":"spn-22622","marks":["code"],"text":"openrouter"}]},{"id":"blk-22478","spans":[{"id":"spn-22623","marks":["code"],"text":"openrouter"},{"id":"spn-22624","text":", "},{"id":"spn-22625","marks":["code"],"text":"anthropic"},{"id":"spn-22626","text":", "},{"id":"spn-22627","marks":["code"],"text":"openai"},{"id":"spn-22628","text":", "},{"id":"spn-22629","marks":["code"],"text":"gemini"},{"id":"spn-22630","text":"."}]}],[{"id":"blk-22479","spans":[{"id":"spn-22631","marks":["code"],"text":"--llm-api-key-env"}]},{"id":"blk-22480","spans":[{"id":"spn-22632","marks":["code"],"text":"OPENROUTER_API_KEY"}]},{"id":"blk-22481","spans":[{"id":"spn-22633","text":"Env var name to read the API key from."}]}],[{"id":"blk-22482","spans":[{"id":"spn-22634","marks":["code"],"text":"--log-level"}]},{"id":"blk-22483","spans":[{"id":"spn-22635","marks":["code"],"text":"info"}]},{"id":"blk-22484","spans":[{"id":"spn-22636","marks":["code"],"text":"debug"},{"id":"spn-22637","text":", "},{"id":"spn-22638","marks":["code"],"text":"info"},{"id":"spn-22639","text":", "},{"id":"spn-22640","marks":["code"],"text":"warn"},{"id":"spn-22641","text":", "},{"id":"spn-22642","marks":["code"],"text":"error"},{"id":"spn-22643","text":"."}]}],[{"id":"blk-22485","spans":[{"id":"spn-22644","marks":["code"],"text":"--version"},{"id":"spn-22645","text":" / "},{"id":"spn-22646","marks":["code"],"text":"--help"}]},{"id":"blk-22486","spans":[{"id":"spn-22647","text":"—"}]},{"id":"blk-22487","spans":[{"id":"spn-22648","text":"Print and exit."}]}]]},{"id":"blk-22488","kind":"heading","level":2,"spans":[{"id":"spn-22649","text":"Dependencies"}]},{"head":[{"id":"blk-22490","spans":[{"id":"spn-22650","text":"Dependency"}]},{"id":"blk-22491","spans":[{"id":"spn-22651","text":"Version"}]},{"id":"blk-22492","spans":[{"id":"spn-22652","text":"Why"}]}],"id":"blk-22489","kind":"table","rows":[[{"id":"blk-22493","spans":[{"id":"spn-22653","marks":["code"],"text":"@modelcontextprotocol/sdk"}]},{"id":"blk-22494","spans":[{"id":"spn-22654","marks":["code"],"text":"^1.29.0"}]},{"id":"blk-22495","spans":[{"id":"spn-22655","text":"Stable v1.x MCP surface."}]}],[{"id":"blk-22496","spans":[{"id":"spn-22656","marks":["code"],"text":"better-sqlite3"}]},{"id":"blk-22497","spans":[{"id":"spn-22657","marks":["code"],"text":"^12.8.0"}]},{"id":"blk-22498","spans":[{"id":"spn-22658","text":"SQLite bindings (benchmark metadata)."}]}],[{"id":"blk-22499","spans":[{"id":"spn-22659","marks":["code"],"text":"sqlite-vec"}]},{"id":"blk-22500","spans":[{"id":"spn-22660","marks":["code"],"text":"^0.1.10"}]},{"id":"blk-22501","spans":[{"id":"spn-22661","text":"Vector index over scenario embeddings."}]}],[{"id":"blk-22502","spans":[{"id":"spn-22662","marks":["code"],"text":"zod"}]},{"id":"blk-22503","spans":[{"id":"spn-22663","marks":["code"],"text":"^3.23.0"}]},{"id":"blk-22504","spans":[{"id":"spn-22664","text":"Tool input schemas."}]}],[{"id":"blk-22505","spans":[{"id":"spn-22665","marks":["code"],"text":"yargs"}]},{"id":"blk-22506","spans":[{"id":"spn-22666","marks":["code"],"text":"^17.7.0"}]},{"id":"blk-22507","spans":[{"id":"spn-22667","text":"CLI parsing."}]}],[{"id":"blk-22508","spans":[{"id":"spn-22668","marks":["code"],"text":"node-fetch"}]},{"id":"blk-22509","spans":[{"id":"spn-22669","marks":["code"],"text":"^3.3.2"}]},{"id":"blk-22510","spans":[{"id":"spn-22670","text":"Escript bundle download (postinstall)."}]}],[{"id":"blk-22511","spans":[{"id":"spn-22671","text":"(Elixir runtime)"}]},{"id":"blk-22512","spans":[{"id":"spn-22672","text":"via escript"}]},{"id":"blk-22513","spans":[{"id":"spn-22673","marks":["code"],"text":"vendor/prism_engine"},{"id":"spn-22674","text":" — the PRISM OTP app as an escript."}]}]]},{"id":"blk-22514","kind":"paragraph","spans":[{"id":"spn-22675","text":"The Elixir engine itself pulls: "},{"id":"spn-22676","marks":["code"],"text":"ecto_sqlite3"},{"id":"spn-22677","text":", "},{"id":"spn-22678","marks":["code"],"text":"exqlite"},{"id":"spn-22679","text":", "},{"id":"spn-22680","marks":["code"],"text":"req"},{"id":"spn-22681","text":", "},{"id":"spn-22682","marks":["code"],"text":"jason"},{"id":"spn-22683","text":", "},{"id":"spn-22684","marks":["code"],"text":"peri"},{"id":"spn-22685","text":", "},{"id":"spn-22686","marks":["code"],"text":"nimble_options"},{"id":"spn-22687","text":". These live inside the escript bundle — they do "},{"id":"spn-22688","marks":["bold"],"text":"not"},{"id":"spn-22689","text":" appear in "},{"id":"spn-22690","marks":["code"],"text":"package.json"},{"id":"spn-22691","text":"."}]},{"id":"blk-22515","kind":"heading","level":2,"spans":[{"id":"spn-22692","text":"Wire Protocol (Node ⇄ Elixir)"}]},{"id":"blk-22516","kind":"paragraph","spans":[{"id":"spn-22693","text":"The TS MCP server spawns the vendored escript as a child process and communicates over line-delimited JSON on the escript's stdin/stdout. Each MCP tool call is translated into a single JSON-RPC-style request:"}]},{"id":"blk-22517","kind":"code","language":"jsonc","text":"// TS → escript\n{ \"id\": \"req-123\", \"method\": \"interact.run\", \"params\": { \"scenario_id\": \"s42\" } }\n\n// escript → TS\n{ \"id\": \"req-123\", \"ok\": true, \"result\": { \"run_id\": \"r_...\", \"transcript\": \"…\" } }"},{"id":"blk-22518","kind":"paragraph","spans":[{"id":"spn-22694","text":"The escript exposes exactly the same 6 machines + actions that the Elixir PRISM application currently supports, so the TS wrapper is a thin pass-through with zod input validation and MCP response shaping."}]},{"id":"blk-22519","kind":"heading","level":2,"spans":[{"id":"spn-22695","text":"SQLite Schema (TS-side)"}]},{"id":"blk-22520","kind":"paragraph","spans":[{"id":"spn-22696","text":"The TS wrapper stores a small projection for fast MCP resource responses; the authoritative benchmark state lives inside the escript's own SQLite file (at the path passed via "},{"id":"spn-22697","marks":["code"],"text":"--db"},{"id":"spn-22698","text":")."}]},{"id":"blk-22521","kind":"code","language":"sql","text":"CREATE TABLE IF NOT EXISTS systems (\n  id             TEXT PRIMARY KEY,                -- e.g. \"graphonomous@0.4.0\"\n  name           TEXT NOT NULL,\n  manifest_uri   TEXT,                            -- PULSE manifest URL or file path\n  registered_at  INTEGER NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS runs (\n  id             TEXT PRIMARY KEY,\n  system_id      TEXT NOT NULL,\n  scenario_id    TEXT NOT NULL,\n  status         TEXT NOT NULL,                   -- queued | running | ok | error\n  started_at     INTEGER NOT NULL,\n  ended_at       INTEGER,\n  transcript_uri TEXT,                            -- engine-side URI\n  FOREIGN KEY (system_id) REFERENCES systems (id)\n);"},{"id":"blk-22522","kind":"heading","level":2,"spans":[{"id":"spn-22699","text":"MCP Tools (6 machines, 47 actions — delegated to Elixir)"}]},{"head":[{"id":"blk-22524","spans":[{"id":"spn-22700","text":"Machine"}]},{"id":"blk-22525","spans":[{"id":"spn-22701","text":"Actions"}]}],"id":"blk-22523","kind":"table","rows":[[{"id":"blk-22526","spans":[{"id":"spn-22702","marks":["code"],"text":"compose"}]},{"id":"blk-22527","spans":[{"id":"spn-22703","marks":["code"],"text":"scenarios"},{"id":"spn-22704","text":", "},{"id":"spn-22705","marks":["code"],"text":"validate"},{"id":"spn-22706","text":", "},{"id":"spn-22707","marks":["code"],"text":"list"},{"id":"spn-22708","text":", "},{"id":"spn-22709","marks":["code"],"text":"get"},{"id":"spn-22710","text":", "},{"id":"spn-22711","marks":["code"],"text":"retire"},{"id":"spn-22712","text":", "},{"id":"spn-22713","marks":["code"],"text":"import"},{"id":"spn-22714","text":", "},{"id":"spn-22715","marks":["code"],"text":"byor_register"},{"id":"spn-22716","text":", "},{"id":"spn-22717","marks":["code"],"text":"byor_discover"},{"id":"spn-22718","text":", "},{"id":"spn-22719","marks":["code"],"text":"byor_generate"}]}],[{"id":"blk-22528","spans":[{"id":"spn-22720","marks":["code"],"text":"interact"}]},{"id":"blk-22529","spans":[{"id":"spn-22721","marks":["code"],"text":"run"},{"id":"spn-22722","text":", "},{"id":"spn-22723","marks":["code"],"text":"run_sequence"},{"id":"spn-22724","text":", "},{"id":"spn-22725","marks":["code"],"text":"run_matrix"},{"id":"spn-22726","text":", "},{"id":"spn-22727","marks":["code"],"text":"status"},{"id":"spn-22728","text":", "},{"id":"spn-22729","marks":["code"],"text":"transcript"},{"id":"spn-22730","text":", "},{"id":"spn-22731","marks":["code"],"text":"cancel"},{"id":"spn-22732","text":", "},{"id":"spn-22733","marks":["code"],"text":"byor_evaluate"},{"id":"spn-22734","text":", "},{"id":"spn-22735","marks":["code"],"text":"byor_compare"}]}],[{"id":"blk-22530","spans":[{"id":"spn-22736","marks":["code"],"text":"observe"}]},{"id":"blk-22531","spans":[{"id":"spn-22737","marks":["code"],"text":"judge_transcript"},{"id":"spn-22738","text":", "},{"id":"spn-22739","marks":["code"],"text":"judge_dimension"},{"id":"spn-22740","text":", "},{"id":"spn-22741","marks":["code"],"text":"meta_judge"},{"id":"spn-22742","text":", "},{"id":"spn-22743","marks":["code"],"text":"meta_judge_batch"},{"id":"spn-22744","text":", "},{"id":"spn-22745","marks":["code"],"text":"override"}]}],[{"id":"blk-22532","spans":[{"id":"spn-22746","marks":["code"],"text":"reflect"}]},{"id":"blk-22533","spans":[{"id":"spn-22747","marks":["code"],"text":"analyze_gaps"},{"id":"spn-22748","text":", "},{"id":"spn-22749","marks":["code"],"text":"evolve"},{"id":"spn-22750","text":", "},{"id":"spn-22751","marks":["code"],"text":"advance_cycle"},{"id":"spn-22752","text":", "},{"id":"spn-22753","marks":["code"],"text":"calibrate_irt"},{"id":"spn-22754","text":", "},{"id":"spn-22755","marks":["code"],"text":"cycle_history"},{"id":"spn-22756","text":", "},{"id":"spn-22757","marks":["code"],"text":"byor_recommend"},{"id":"spn-22758","text":", "},{"id":"spn-22759","marks":["code"],"text":"byor_infer_profile"}]}],[{"id":"blk-22534","spans":[{"id":"spn-22760","marks":["code"],"text":"diagnose"}]},{"id":"blk-22535","spans":[{"id":"spn-22761","marks":["code"],"text":"report"},{"id":"spn-22762","text":", "},{"id":"spn-22763","marks":["code"],"text":"failure_patterns"},{"id":"spn-22764","text":", "},{"id":"spn-22765","marks":["code"],"text":"retest"},{"id":"spn-22766","text":", "},{"id":"spn-22767","marks":["code"],"text":"verify"},{"id":"spn-22768","text":", "},{"id":"spn-22769","marks":["code"],"text":"regressions"},{"id":"spn-22770","text":", "},{"id":"spn-22771","marks":["code"],"text":"suggest_fixes"},{"id":"spn-22772","text":", "},{"id":"spn-22773","marks":["code"],"text":"leaderboard"},{"id":"spn-22774","text":", "},{"id":"spn-22775","marks":["code"],"text":"leaderboard_history"},{"id":"spn-22776","text":", "},{"id":"spn-22777","marks":["code"],"text":"compare_systems"},{"id":"spn-22778","text":", "},{"id":"spn-22779","marks":["code"],"text":"dimension_leaders"},{"id":"spn-22780","text":", "},{"id":"spn-22781","marks":["code"],"text":"fit_recommendation"},{"id":"spn-22782","text":", "},{"id":"spn-22783","marks":["code"],"text":"compare_fit"},{"id":"spn-22784","text":", "},{"id":"spn-22785","marks":["code"],"text":"task_profiles"}]}],[{"id":"blk-22536","spans":[{"id":"spn-22786","marks":["code"],"text":"config"}]},{"id":"blk-22537","spans":[{"id":"spn-22787","marks":["code"],"text":"set_weights"},{"id":"spn-22788","text":", "},{"id":"spn-22789","marks":["code"],"text":"register_system"},{"id":"spn-22790","text":", "},{"id":"spn-22791","marks":["code"],"text":"list_systems"},{"id":"spn-22792","text":", "},{"id":"spn-22793","marks":["code"],"text":"get_config"},{"id":"spn-22794","text":", "},{"id":"spn-22795","marks":["code"],"text":"create_profile"}]}]]},{"id":"blk-22538","kind":"paragraph","spans":[{"id":"spn-22796","text":"All 47 actions are already implemented in Elixir under "},{"id":"spn-22797","marks":["code"],"text":"PRISM/lib/prism/mcp/machines/"},{"id":"spn-22798","text":". The npm wrapper does not add or remove actions; it only exposes them over the MCP SDK's stdio transport."}]},{"id":"blk-22539","kind":"heading","level":2,"spans":[{"id":"spn-22799","text":"MCP Resources"}]},{"head":[{"id":"blk-22541","spans":[{"id":"spn-22800","text":"URI"}]},{"id":"blk-22542","spans":[{"id":"spn-22801","text":"Returns"}]}],"id":"blk-22540","kind":"table","rows":[[{"id":"blk-22543","spans":[{"id":"spn-22802","marks":["code"],"text":"prism://runtime/health"}]},{"id":"blk-22544","spans":[{"id":"spn-22803","text":"Engine health, pending run count, queue depth."}]}],[{"id":"blk-22545","spans":[{"id":"spn-22804","marks":["code"],"text":"prism://systems/registered"}]},{"id":"blk-22546","spans":[{"id":"spn-22805","text":"Registered BYOR systems."}]}],[{"id":"blk-22547","spans":[{"id":"spn-22806","marks":["code"],"text":"prism://runs/recent"}]},{"id":"blk-22548","spans":[{"id":"spn-22807","text":"Recent benchmark runs."}]}],[{"id":"blk-22549","spans":[{"id":"spn-22808","marks":["code"],"text":"prism://leaderboard/{profile}"}]},{"id":"blk-22550","spans":[{"id":"spn-22809","text":"Leaderboard for a given task profile."}]}],[{"id":"blk-22551","spans":[{"id":"spn-22810","marks":["code"],"text":"prism://scenarios/{id}"}]},{"id":"blk-22552","spans":[{"id":"spn-22811","text":"Scenario definition."}]}],[{"id":"blk-22553","spans":[{"id":"spn-22812","marks":["code"],"text":"prism://transcripts/{run_id}"}]},{"id":"blk-22554","spans":[{"id":"spn-22813","text":"Full transcript for a run."}]}]]},{"id":"blk-22555","kind":"heading","level":2,"spans":[{"id":"spn-22814","text":"Project Layout"}]},{"id":"blk-22556","kind":"code","language":"text","text":"PRISM/\n├── package.json                    # \"name\": \"os-prism\"\n├── tsconfig.json\n├── bin/\n│   └── os-prism.js\n├── src/\n│   ├── server.ts                   # MCP wiring\n│   ├── db.ts                       # projection DB\n│   ├── engine.ts                   # spawn + JSON-RPC over stdio\n│   ├── tools/\n│   │   ├── compose.ts\n│   │   ├── interact.ts\n│   │   ├── observe.ts\n│   │   ├── reflect.ts\n│   │   ├── diagnose.ts\n│   │   └── config.ts\n│   ├── resources/ …\n│   └── cli.ts\n├── scripts/\n│   └── postinstall.js              # fetch vendor/prism_engine\n└── lib/                            # existing Elixir PRISM app (escript source)"},{"id":"blk-22557","kind":"heading","level":2,"spans":[{"id":"spn-22815","text":"Build and Publish"}]},{"id":"blk-22558","kind":"code","language":"bash","text":"cd PRISM\n# 1. Build the Elixir escript engine for each target platform\nMIX_ENV=prod mix escript.build          # writes to ./prism_engine\n# 2. Upload to GitHub Releases under tag os-prism-v0.1.0 (CI)\n# 3. Build and publish the TS wrapper\nnpm install\nnpm run build\nnpm publish --access public"},{"id":"blk-22559","kind":"heading","level":2,"spans":[{"id":"spn-22816","text":"Why os-prism ships third"}]},{"id":"blk-22560","items":[{"blocks":[{"id":"blk-22562","kind":"paragraph","spans":[{"id":"spn-22817","text":"Optionally reads a system-under-test's "},{"id":"spn-22818","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-22819","text":" spec graph (via"}]}],"id":"blk-22561","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22563","kind":"paragraph","spans":[{"id":"spn-22820","text":"the [&] reference CLI / SDKs) to understand what it is composed of."}]},{"id":"blk-22564","items":[{"blocks":[{"id":"blk-22566","kind":"paragraph","spans":[{"id":"spn-22821","text":"Depends on "},{"id":"spn-22822","marks":["code"],"text":"os-pulse"},{"id":"spn-22823","text":" to read the system-under-test's PULSE manifest and"}]}],"id":"blk-22565","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-22567","kind":"paragraph","spans":[{"id":"spn-22824","text":"discover the "},{"id":"spn-22825","marks":["code"],"text":"retrieve"},{"id":"spn-22826","text":" and "},{"id":"spn-22827","marks":["code"],"text":"learn"},{"id":"spn-22828","text":" boundaries."}]},{"id":"blk-22568","items":[{"blocks":[{"id":"blk-22570","kind":"paragraph","spans":[{"id":"spn-22829","text":"Requires the graphonomous-style postinstall escript pattern, which is"}]}],"id":"blk-22569","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-22571","kind":"paragraph","spans":[{"id":"spn-22830","text":"the most complex install path of the three packages."}]}],"edges":[],"id":"bagaaieralfeeuglhz35nhdbs2nr3qwzahvqlh4xvpn4bzv4jeozjd5zpjuyq","vocabulary":"ampersand.docs.fs.v1"}