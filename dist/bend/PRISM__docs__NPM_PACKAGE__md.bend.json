{"bendscript":"0.1","blocks":[{"id":"blk-22482","kind":"heading","level":1,"spans":[{"id":"spn-22658","text":"os-prism — NPM Package Specification"}]},{"id":"blk-22483","kind":"paragraph","spans":[{"id":"spn-22659","marks":["bold"],"text":"Package"},{"id":"spn-22660","text":": "},{"id":"spn-22661","marks":["code"],"text":"os-prism"},{"id":"spn-22662","text":" "},{"id":"spn-22663","marks":["bold"],"text":"Version"},{"id":"spn-22664","text":": "},{"id":"spn-22665","marks":["code"],"text":"0.1.0"},{"id":"spn-22666","text":" (initial) "},{"id":"spn-22667","marks":["bold"],"text":"Language"},{"id":"spn-22668","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-22669","marks":["bold"],"text":"License"},{"id":"spn-22670","text":": Apache-2.0 "},{"id":"spn-22671","marks":["bold"],"text":"Registry"},{"id":"spn-22672","text":": https://www.npmjs.com/package/os-prism "},{"id":"spn-22673","marks":["bold"],"text":"Repository"},{"id":"spn-22674","text":": "},{"id":"spn-22675","marks":["code"],"text":"AmpersandBoxDesign/PRISM"},{"id":"spn-22676","text":" (monorepo subdir)"}]},{"id":"blk-22484","kind":"heading","level":2,"spans":[{"id":"spn-22677","text":"Purpose"}]},{"id":"blk-22485","kind":"paragraph","spans":[{"id":"spn-22678","marks":["code"],"text":"os-prism"},{"id":"spn-22679","text":" is the MCP server for OS-009 PRISM. It exposes the 6 PRISM loop-phase machines ("},{"id":"spn-22680","marks":["code"],"text":"compose"},{"id":"spn-22681","text":", "},{"id":"spn-22682","marks":["code"],"text":"interact"},{"id":"spn-22683","text":", "},{"id":"spn-22684","marks":["code"],"text":"observe"},{"id":"spn-22685","text":", "},{"id":"spn-22686","marks":["code"],"text":"reflect"},{"id":"spn-22687","text":", "},{"id":"spn-22688","marks":["code"],"text":"diagnose"},{"id":"spn-22689","text":", "},{"id":"spn-22690","marks":["code"],"text":"config"},{"id":"spn-22691","text":") over stdio and runs benchmarks against any PULSE-conforming memory system. Unlike the Fly.io-hosted PRISM service, "},{"id":"spn-22692","marks":["code"],"text":"os-prism"},{"id":"spn-22693","text":" runs locally and stores benchmark state in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-22486","kind":"paragraph","spans":[{"id":"spn-22694","marks":["code"],"text":"os-prism"},{"id":"spn-22695","text":" wraps the existing Elixir PRISM engine via the same postinstall escript pattern that "},{"id":"spn-22696","marks":["code"],"text":"graphonomous"},{"id":"spn-22697","text":" uses. The Elixir engine carries PRISM's sophisticated IRT/Rasch calibration, three-layer judging pipeline, and scenario evolution logic — porting those to JavaScript is out of scope for v0.1 (the JS IRT ecosystem is thin; see "},{"id":"spn-22698","marks":["code"],"text":"../../../memory/research"},{"id":"spn-22699","text":" for details)."}]},{"id":"blk-22487","kind":"heading","level":2,"spans":[{"id":"spn-22700","text":"Install"}]},{"id":"blk-22488","kind":"code","language":"bash","text":"npx -y os-prism --db ~/.os-prism/benchmarks.db"},{"id":"blk-22489","kind":"paragraph","spans":[{"id":"spn-22701","text":"Or in "},{"id":"spn-22702","marks":["code"],"text":".mcp.json"},{"id":"spn-22703","text":":"}]},{"id":"blk-22490","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"prism\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"os-prism\", \"--db\", \"~/.os-prism/benchmarks.db\"]\n    }\n  }\n}"},{"id":"blk-22491","kind":"paragraph","spans":[{"id":"spn-22704","marks":["code"],"text":"postinstall"},{"id":"spn-22705","text":" fetches the platform-appropriate Elixir escript bundle (darwin-x64, darwin-arm64, linux-x64, linux-arm64) from the GitHub release assets attached to the matching "},{"id":"spn-22706","marks":["code"],"text":"os-prism-vX.Y.Z"},{"id":"spn-22707","text":" git tag, verifies the SHA256, and installs it under "},{"id":"spn-22708","marks":["code"],"text":"vendor/"},{"id":"spn-22709","text":". Offline installs can set "},{"id":"spn-22710","marks":["code"],"text":"PRISM_ESCRIPT_PATH"},{"id":"spn-22711","text":" to skip the fetch."}]},{"id":"blk-22492","kind":"heading","level":2,"spans":[{"id":"spn-22712","text":"CLI Flags"}]},{"head":[{"id":"blk-22494","spans":[{"id":"spn-22713","text":"Flag"}]},{"id":"blk-22495","spans":[{"id":"spn-22714","text":"Default"}]},{"id":"blk-22496","spans":[{"id":"spn-22715","text":"Description"}]}],"id":"blk-22493","kind":"table","rows":[[{"id":"blk-22497","spans":[{"id":"spn-22716","marks":["code"],"text":"--db <path>"}]},{"id":"blk-22498","spans":[{"id":"spn-22717","marks":["code"],"text":"~/.os-prism/benchmarks.db"}]},{"id":"blk-22499","spans":[{"id":"spn-22718","text":"SQLite database path."}]}],[{"id":"blk-22500","spans":[{"id":"spn-22719","marks":["code"],"text":"--transport"}]},{"id":"blk-22501","spans":[{"id":"spn-22720","marks":["code"],"text":"stdio"}]},{"id":"blk-22502","spans":[{"id":"spn-22721","marks":["code"],"text":"stdio"},{"id":"spn-22722","text":" or "},{"id":"spn-22723","marks":["code"],"text":"http"},{"id":"spn-22724","text":"."}]}],[{"id":"blk-22503","spans":[{"id":"spn-22725","marks":["code"],"text":"--port <n>"}]},{"id":"blk-22504","spans":[{"id":"spn-22726","marks":["code"],"text":"4712"}]},{"id":"blk-22505","spans":[{"id":"spn-22727","text":"HTTP port (ignored for stdio)."}]}],[{"id":"blk-22506","spans":[{"id":"spn-22728","marks":["code"],"text":"--engine-path <path>"}]},{"id":"blk-22507","spans":[{"id":"spn-22729","marks":["code"],"text":"./vendor/prism_engine"}]},{"id":"blk-22508","spans":[{"id":"spn-22730","text":"Path to the bundled Elixir escript."}]}],[{"id":"blk-22509","spans":[{"id":"spn-22731","marks":["code"],"text":"--llm-provider"}]},{"id":"blk-22510","spans":[{"id":"spn-22732","marks":["code"],"text":"openrouter"}]},{"id":"blk-22511","spans":[{"id":"spn-22733","marks":["code"],"text":"openrouter"},{"id":"spn-22734","text":", "},{"id":"spn-22735","marks":["code"],"text":"anthropic"},{"id":"spn-22736","text":", "},{"id":"spn-22737","marks":["code"],"text":"openai"},{"id":"spn-22738","text":", "},{"id":"spn-22739","marks":["code"],"text":"gemini"},{"id":"spn-22740","text":"."}]}],[{"id":"blk-22512","spans":[{"id":"spn-22741","marks":["code"],"text":"--llm-api-key-env"}]},{"id":"blk-22513","spans":[{"id":"spn-22742","marks":["code"],"text":"OPENROUTER_API_KEY"}]},{"id":"blk-22514","spans":[{"id":"spn-22743","text":"Env var name to read the API key from."}]}],[{"id":"blk-22515","spans":[{"id":"spn-22744","marks":["code"],"text":"--log-level"}]},{"id":"blk-22516","spans":[{"id":"spn-22745","marks":["code"],"text":"info"}]},{"id":"blk-22517","spans":[{"id":"spn-22746","marks":["code"],"text":"debug"},{"id":"spn-22747","text":", "},{"id":"spn-22748","marks":["code"],"text":"info"},{"id":"spn-22749","text":", "},{"id":"spn-22750","marks":["code"],"text":"warn"},{"id":"spn-22751","text":", "},{"id":"spn-22752","marks":["code"],"text":"error"},{"id":"spn-22753","text":"."}]}],[{"id":"blk-22518","spans":[{"id":"spn-22754","marks":["code"],"text":"--version"},{"id":"spn-22755","text":" / "},{"id":"spn-22756","marks":["code"],"text":"--help"}]},{"id":"blk-22519","spans":[{"id":"spn-22757","text":"—"}]},{"id":"blk-22520","spans":[{"id":"spn-22758","text":"Print and exit."}]}]]},{"id":"blk-22521","kind":"heading","level":2,"spans":[{"id":"spn-22759","text":"Dependencies"}]},{"head":[{"id":"blk-22523","spans":[{"id":"spn-22760","text":"Dependency"}]},{"id":"blk-22524","spans":[{"id":"spn-22761","text":"Version"}]},{"id":"blk-22525","spans":[{"id":"spn-22762","text":"Why"}]}],"id":"blk-22522","kind":"table","rows":[[{"id":"blk-22526","spans":[{"id":"spn-22763","marks":["code"],"text":"@modelcontextprotocol/sdk"}]},{"id":"blk-22527","spans":[{"id":"spn-22764","marks":["code"],"text":"^1.29.0"}]},{"id":"blk-22528","spans":[{"id":"spn-22765","text":"Stable v1.x MCP surface."}]}],[{"id":"blk-22529","spans":[{"id":"spn-22766","marks":["code"],"text":"better-sqlite3"}]},{"id":"blk-22530","spans":[{"id":"spn-22767","marks":["code"],"text":"^12.8.0"}]},{"id":"blk-22531","spans":[{"id":"spn-22768","text":"SQLite bindings (benchmark metadata)."}]}],[{"id":"blk-22532","spans":[{"id":"spn-22769","marks":["code"],"text":"sqlite-vec"}]},{"id":"blk-22533","spans":[{"id":"spn-22770","marks":["code"],"text":"^0.1.10"}]},{"id":"blk-22534","spans":[{"id":"spn-22771","text":"Vector index over scenario embeddings."}]}],[{"id":"blk-22535","spans":[{"id":"spn-22772","marks":["code"],"text":"zod"}]},{"id":"blk-22536","spans":[{"id":"spn-22773","marks":["code"],"text":"^3.23.0"}]},{"id":"blk-22537","spans":[{"id":"spn-22774","text":"Tool input schemas."}]}],[{"id":"blk-22538","spans":[{"id":"spn-22775","marks":["code"],"text":"yargs"}]},{"id":"blk-22539","spans":[{"id":"spn-22776","marks":["code"],"text":"^17.7.0"}]},{"id":"blk-22540","spans":[{"id":"spn-22777","text":"CLI parsing."}]}],[{"id":"blk-22541","spans":[{"id":"spn-22778","marks":["code"],"text":"node-fetch"}]},{"id":"blk-22542","spans":[{"id":"spn-22779","marks":["code"],"text":"^3.3.2"}]},{"id":"blk-22543","spans":[{"id":"spn-22780","text":"Escript bundle download (postinstall)."}]}],[{"id":"blk-22544","spans":[{"id":"spn-22781","text":"(Elixir runtime)"}]},{"id":"blk-22545","spans":[{"id":"spn-22782","text":"via escript"}]},{"id":"blk-22546","spans":[{"id":"spn-22783","marks":["code"],"text":"vendor/prism_engine"},{"id":"spn-22784","text":" — the PRISM OTP app as an escript."}]}]]},{"id":"blk-22547","kind":"paragraph","spans":[{"id":"spn-22785","text":"The Elixir engine itself pulls: "},{"id":"spn-22786","marks":["code"],"text":"ecto_sqlite3"},{"id":"spn-22787","text":", "},{"id":"spn-22788","marks":["code"],"text":"exqlite"},{"id":"spn-22789","text":", "},{"id":"spn-22790","marks":["code"],"text":"req"},{"id":"spn-22791","text":", "},{"id":"spn-22792","marks":["code"],"text":"jason"},{"id":"spn-22793","text":", "},{"id":"spn-22794","marks":["code"],"text":"peri"},{"id":"spn-22795","text":", "},{"id":"spn-22796","marks":["code"],"text":"nimble_options"},{"id":"spn-22797","text":". These live inside the escript bundle — they do "},{"id":"spn-22798","marks":["bold"],"text":"not"},{"id":"spn-22799","text":" appear in "},{"id":"spn-22800","marks":["code"],"text":"package.json"},{"id":"spn-22801","text":"."}]},{"id":"blk-22548","kind":"heading","level":2,"spans":[{"id":"spn-22802","text":"Wire Protocol (Node ⇄ Elixir)"}]},{"id":"blk-22549","kind":"paragraph","spans":[{"id":"spn-22803","text":"The TS MCP server spawns the vendored escript as a child process and communicates over line-delimited JSON on the escript's stdin/stdout. Each MCP tool call is translated into a single JSON-RPC-style request:"}]},{"id":"blk-22550","kind":"code","language":"jsonc","text":"// TS → escript\n{ \"id\": \"req-123\", \"method\": \"interact.run\", \"params\": { \"scenario_id\": \"s42\" } }\n\n// escript → TS\n{ \"id\": \"req-123\", \"ok\": true, \"result\": { \"run_id\": \"r_...\", \"transcript\": \"…\" } }"},{"id":"blk-22551","kind":"paragraph","spans":[{"id":"spn-22804","text":"The escript exposes exactly the same 6 machines + actions that the Elixir PRISM application currently supports, so the TS wrapper is a thin pass-through with zod input validation and MCP response shaping."}]},{"id":"blk-22552","kind":"heading","level":2,"spans":[{"id":"spn-22805","text":"SQLite Schema (TS-side)"}]},{"id":"blk-22553","kind":"paragraph","spans":[{"id":"spn-22806","text":"The TS wrapper stores a small projection for fast MCP resource responses; the authoritative benchmark state lives inside the escript's own SQLite file (at the path passed via "},{"id":"spn-22807","marks":["code"],"text":"--db"},{"id":"spn-22808","text":")."}]},{"id":"blk-22554","kind":"code","language":"sql","text":"CREATE TABLE IF NOT EXISTS systems (\n  id             TEXT PRIMARY KEY,                -- e.g. \"graphonomous@0.4.0\"\n  name           TEXT NOT NULL,\n  manifest_uri   TEXT,                            -- PULSE manifest URL or file path\n  registered_at  INTEGER NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS runs (\n  id             TEXT PRIMARY KEY,\n  system_id      TEXT NOT NULL,\n  scenario_id    TEXT NOT NULL,\n  status         TEXT NOT NULL,                   -- queued | running | ok | error\n  started_at     INTEGER NOT NULL,\n  ended_at       INTEGER,\n  transcript_uri TEXT,                            -- engine-side URI\n  FOREIGN KEY (system_id) REFERENCES systems (id)\n);"},{"id":"blk-22555","kind":"heading","level":2,"spans":[{"id":"spn-22809","text":"MCP Tools (6 machines, 47 actions — delegated to Elixir)"}]},{"head":[{"id":"blk-22557","spans":[{"id":"spn-22810","text":"Machine"}]},{"id":"blk-22558","spans":[{"id":"spn-22811","text":"Actions"}]}],"id":"blk-22556","kind":"table","rows":[[{"id":"blk-22559","spans":[{"id":"spn-22812","marks":["code"],"text":"compose"}]},{"id":"blk-22560","spans":[{"id":"spn-22813","marks":["code"],"text":"scenarios"},{"id":"spn-22814","text":", "},{"id":"spn-22815","marks":["code"],"text":"validate"},{"id":"spn-22816","text":", "},{"id":"spn-22817","marks":["code"],"text":"list"},{"id":"spn-22818","text":", "},{"id":"spn-22819","marks":["code"],"text":"get"},{"id":"spn-22820","text":", "},{"id":"spn-22821","marks":["code"],"text":"retire"},{"id":"spn-22822","text":", "},{"id":"spn-22823","marks":["code"],"text":"import"},{"id":"spn-22824","text":", "},{"id":"spn-22825","marks":["code"],"text":"byor_register"},{"id":"spn-22826","text":", "},{"id":"spn-22827","marks":["code"],"text":"byor_discover"},{"id":"spn-22828","text":", "},{"id":"spn-22829","marks":["code"],"text":"byor_generate"}]}],[{"id":"blk-22561","spans":[{"id":"spn-22830","marks":["code"],"text":"interact"}]},{"id":"blk-22562","spans":[{"id":"spn-22831","marks":["code"],"text":"run"},{"id":"spn-22832","text":", "},{"id":"spn-22833","marks":["code"],"text":"run_sequence"},{"id":"spn-22834","text":", "},{"id":"spn-22835","marks":["code"],"text":"run_matrix"},{"id":"spn-22836","text":", "},{"id":"spn-22837","marks":["code"],"text":"status"},{"id":"spn-22838","text":", "},{"id":"spn-22839","marks":["code"],"text":"transcript"},{"id":"spn-22840","text":", "},{"id":"spn-22841","marks":["code"],"text":"cancel"},{"id":"spn-22842","text":", "},{"id":"spn-22843","marks":["code"],"text":"byor_evaluate"},{"id":"spn-22844","text":", "},{"id":"spn-22845","marks":["code"],"text":"byor_compare"}]}],[{"id":"blk-22563","spans":[{"id":"spn-22846","marks":["code"],"text":"observe"}]},{"id":"blk-22564","spans":[{"id":"spn-22847","marks":["code"],"text":"judge_transcript"},{"id":"spn-22848","text":", "},{"id":"spn-22849","marks":["code"],"text":"judge_dimension"},{"id":"spn-22850","text":", "},{"id":"spn-22851","marks":["code"],"text":"meta_judge"},{"id":"spn-22852","text":", "},{"id":"spn-22853","marks":["code"],"text":"meta_judge_batch"},{"id":"spn-22854","text":", "},{"id":"spn-22855","marks":["code"],"text":"override"}]}],[{"id":"blk-22565","spans":[{"id":"spn-22856","marks":["code"],"text":"reflect"}]},{"id":"blk-22566","spans":[{"id":"spn-22857","marks":["code"],"text":"analyze_gaps"},{"id":"spn-22858","text":", "},{"id":"spn-22859","marks":["code"],"text":"evolve"},{"id":"spn-22860","text":", "},{"id":"spn-22861","marks":["code"],"text":"advance_cycle"},{"id":"spn-22862","text":", "},{"id":"spn-22863","marks":["code"],"text":"calibrate_irt"},{"id":"spn-22864","text":", "},{"id":"spn-22865","marks":["code"],"text":"cycle_history"},{"id":"spn-22866","text":", "},{"id":"spn-22867","marks":["code"],"text":"byor_recommend"},{"id":"spn-22868","text":", "},{"id":"spn-22869","marks":["code"],"text":"byor_infer_profile"}]}],[{"id":"blk-22567","spans":[{"id":"spn-22870","marks":["code"],"text":"diagnose"}]},{"id":"blk-22568","spans":[{"id":"spn-22871","marks":["code"],"text":"report"},{"id":"spn-22872","text":", "},{"id":"spn-22873","marks":["code"],"text":"failure_patterns"},{"id":"spn-22874","text":", "},{"id":"spn-22875","marks":["code"],"text":"retest"},{"id":"spn-22876","text":", "},{"id":"spn-22877","marks":["code"],"text":"verify"},{"id":"spn-22878","text":", "},{"id":"spn-22879","marks":["code"],"text":"regressions"},{"id":"spn-22880","text":", "},{"id":"spn-22881","marks":["code"],"text":"suggest_fixes"},{"id":"spn-22882","text":", "},{"id":"spn-22883","marks":["code"],"text":"leaderboard"},{"id":"spn-22884","text":", "},{"id":"spn-22885","marks":["code"],"text":"leaderboard_history"},{"id":"spn-22886","text":", "},{"id":"spn-22887","marks":["code"],"text":"compare_systems"},{"id":"spn-22888","text":", "},{"id":"spn-22889","marks":["code"],"text":"dimension_leaders"},{"id":"spn-22890","text":", "},{"id":"spn-22891","marks":["code"],"text":"fit_recommendation"},{"id":"spn-22892","text":", "},{"id":"spn-22893","marks":["code"],"text":"compare_fit"},{"id":"spn-22894","text":", "},{"id":"spn-22895","marks":["code"],"text":"task_profiles"}]}],[{"id":"blk-22569","spans":[{"id":"spn-22896","marks":["code"],"text":"config"}]},{"id":"blk-22570","spans":[{"id":"spn-22897","marks":["code"],"text":"set_weights"},{"id":"spn-22898","text":", "},{"id":"spn-22899","marks":["code"],"text":"register_system"},{"id":"spn-22900","text":", "},{"id":"spn-22901","marks":["code"],"text":"list_systems"},{"id":"spn-22902","text":", "},{"id":"spn-22903","marks":["code"],"text":"get_config"},{"id":"spn-22904","text":", "},{"id":"spn-22905","marks":["code"],"text":"create_profile"}]}]]},{"id":"blk-22571","kind":"paragraph","spans":[{"id":"spn-22906","text":"All 47 actions are already implemented in Elixir under "},{"id":"spn-22907","marks":["code"],"text":"PRISM/lib/prism/mcp/machines/"},{"id":"spn-22908","text":". The npm wrapper does not add or remove actions; it only exposes them over the MCP SDK's stdio transport."}]},{"id":"blk-22572","kind":"heading","level":2,"spans":[{"id":"spn-22909","text":"MCP Resources"}]},{"head":[{"id":"blk-22574","spans":[{"id":"spn-22910","text":"URI"}]},{"id":"blk-22575","spans":[{"id":"spn-22911","text":"Returns"}]}],"id":"blk-22573","kind":"table","rows":[[{"id":"blk-22576","spans":[{"id":"spn-22912","marks":["code"],"text":"prism://runtime/health"}]},{"id":"blk-22577","spans":[{"id":"spn-22913","text":"Engine health, pending run count, queue depth."}]}],[{"id":"blk-22578","spans":[{"id":"spn-22914","marks":["code"],"text":"prism://systems/registered"}]},{"id":"blk-22579","spans":[{"id":"spn-22915","text":"Registered BYOR systems."}]}],[{"id":"blk-22580","spans":[{"id":"spn-22916","marks":["code"],"text":"prism://runs/recent"}]},{"id":"blk-22581","spans":[{"id":"spn-22917","text":"Recent benchmark runs."}]}],[{"id":"blk-22582","spans":[{"id":"spn-22918","marks":["code"],"text":"prism://leaderboard/{profile}"}]},{"id":"blk-22583","spans":[{"id":"spn-22919","text":"Leaderboard for a given task profile."}]}],[{"id":"blk-22584","spans":[{"id":"spn-22920","marks":["code"],"text":"prism://scenarios/{id}"}]},{"id":"blk-22585","spans":[{"id":"spn-22921","text":"Scenario definition."}]}],[{"id":"blk-22586","spans":[{"id":"spn-22922","marks":["code"],"text":"prism://transcripts/{run_id}"}]},{"id":"blk-22587","spans":[{"id":"spn-22923","text":"Full transcript for a run."}]}]]},{"id":"blk-22588","kind":"heading","level":2,"spans":[{"id":"spn-22924","text":"Project Layout"}]},{"id":"blk-22589","kind":"code","language":"text","text":"PRISM/\n├── package.json                    # \"name\": \"os-prism\"\n├── tsconfig.json\n├── bin/\n│   └── os-prism.js\n├── src/\n│   ├── server.ts                   # MCP wiring\n│   ├── db.ts                       # projection DB\n│   ├── engine.ts                   # spawn + JSON-RPC over stdio\n│   ├── tools/\n│   │   ├── compose.ts\n│   │   ├── interact.ts\n│   │   ├── observe.ts\n│   │   ├── reflect.ts\n│   │   ├── diagnose.ts\n│   │   └── config.ts\n│   ├── resources/ …\n│   └── cli.ts\n├── scripts/\n│   └── postinstall.js              # fetch vendor/prism_engine\n└── lib/                            # existing Elixir PRISM app (escript source)"},{"id":"blk-22590","kind":"heading","level":2,"spans":[{"id":"spn-22925","text":"Build and Publish"}]},{"id":"blk-22591","kind":"code","language":"bash","text":"cd PRISM\n# 1. Build the Elixir escript engine for each target platform\nMIX_ENV=prod mix escript.build          # writes to ./prism_engine\n# 2. Upload to GitHub Releases under tag os-prism-v0.1.0 (CI)\n# 3. Build and publish the TS wrapper\nnpm install\nnpm run build\nnpm publish --access public"},{"id":"blk-22592","kind":"heading","level":2,"spans":[{"id":"spn-22926","text":"Why os-prism ships third"}]},{"id":"blk-22593","items":[{"blocks":[{"id":"blk-22595","kind":"paragraph","spans":[{"id":"spn-22927","text":"Optionally reads a system-under-test's "},{"id":"spn-22928","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-22929","text":" spec graph (via"}]}],"id":"blk-22594","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22596","kind":"paragraph","spans":[{"id":"spn-22930","text":"the [&] reference CLI / SDKs) to understand what it is composed of."}]},{"id":"blk-22597","items":[{"blocks":[{"id":"blk-22599","kind":"paragraph","spans":[{"id":"spn-22931","text":"Depends on "},{"id":"spn-22932","marks":["code"],"text":"os-pulse"},{"id":"spn-22933","text":" to read the system-under-test's PULSE manifest and"}]}],"id":"blk-22598","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-22600","kind":"paragraph","spans":[{"id":"spn-22934","text":"discover the "},{"id":"spn-22935","marks":["code"],"text":"retrieve"},{"id":"spn-22936","text":" and "},{"id":"spn-22937","marks":["code"],"text":"learn"},{"id":"spn-22938","text":" boundaries."}]},{"id":"blk-22601","items":[{"blocks":[{"id":"blk-22603","kind":"paragraph","spans":[{"id":"spn-22939","text":"Requires the graphonomous-style postinstall escript pattern, which is"}]}],"id":"blk-22602","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-22604","kind":"paragraph","spans":[{"id":"spn-22940","text":"the most complex install path of the three packages."}]}],"edges":[],"id":"bagaaierajuwxnvqbd4djl4ihebqtpjp7v4kojlcqbqd4h4t6wfdmxpoeo3bq","vocabulary":"ampersand.docs.fs.v1"}