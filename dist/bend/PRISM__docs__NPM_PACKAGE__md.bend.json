{"bendscript":"0.1","blocks":[{"id":"blk-22662","kind":"heading","level":1,"spans":[{"id":"spn-23289","text":"os-prism — NPM Package Specification"}]},{"id":"blk-22663","kind":"paragraph","spans":[{"id":"spn-23290","marks":["bold"],"text":"Package"},{"id":"spn-23291","text":": "},{"id":"spn-23292","marks":["code"],"text":"os-prism"},{"id":"spn-23293","text":" "},{"id":"spn-23294","marks":["bold"],"text":"Version"},{"id":"spn-23295","text":": "},{"id":"spn-23296","marks":["code"],"text":"0.1.0"},{"id":"spn-23297","text":" (initial) "},{"id":"spn-23298","marks":["bold"],"text":"Language"},{"id":"spn-23299","text":": TypeScript (MCP wrapper) + Elixir (engine, vendored escript) "},{"id":"spn-23300","marks":["bold"],"text":"License"},{"id":"spn-23301","text":": Apache-2.0 "},{"id":"spn-23302","marks":["bold"],"text":"Registry"},{"id":"spn-23303","text":": https://www.npmjs.com/package/os-prism "},{"id":"spn-23304","marks":["bold"],"text":"Repository"},{"id":"spn-23305","text":": "},{"id":"spn-23306","marks":["code"],"text":"AmpersandBoxDesign/PRISM"},{"id":"spn-23307","text":" (monorepo subdir)"}]},{"id":"blk-22664","kind":"heading","level":2,"spans":[{"id":"spn-23308","text":"Purpose"}]},{"id":"blk-22665","kind":"paragraph","spans":[{"id":"spn-23309","marks":["code"],"text":"os-prism"},{"id":"spn-23310","text":" is the MCP server for OS-009 PRISM. It exposes the 6 PRISM loop-phase machines ("},{"id":"spn-23311","marks":["code"],"text":"compose"},{"id":"spn-23312","text":", "},{"id":"spn-23313","marks":["code"],"text":"interact"},{"id":"spn-23314","text":", "},{"id":"spn-23315","marks":["code"],"text":"observe"},{"id":"spn-23316","text":", "},{"id":"spn-23317","marks":["code"],"text":"reflect"},{"id":"spn-23318","text":", "},{"id":"spn-23319","marks":["code"],"text":"diagnose"},{"id":"spn-23320","text":", "},{"id":"spn-23321","marks":["code"],"text":"config"},{"id":"spn-23322","text":") over stdio and runs benchmarks against any PULSE-conforming memory system. Unlike the Fly.io-hosted PRISM service, "},{"id":"spn-23323","marks":["code"],"text":"os-prism"},{"id":"spn-23324","text":" runs locally and stores benchmark state in an embedded SQLite + sqlite-vec database."}]},{"id":"blk-22666","kind":"paragraph","spans":[{"id":"spn-23325","marks":["code"],"text":"os-prism"},{"id":"spn-23326","text":" wraps the existing Elixir PRISM engine via the same postinstall escript pattern that "},{"id":"spn-23327","marks":["code"],"text":"graphonomous"},{"id":"spn-23328","text":" uses. The Elixir engine carries PRISM's sophisticated IRT/Rasch calibration, three-layer judging pipeline, and scenario evolution logic — porting those to JavaScript is out of scope for v0.1 (the JS IRT ecosystem is thin; see "},{"id":"spn-23329","marks":["code"],"text":"../../../memory/research"},{"id":"spn-23330","text":" for details)."}]},{"id":"blk-22667","kind":"heading","level":2,"spans":[{"id":"spn-23331","text":"Install"}]},{"id":"blk-22668","kind":"code","language":"bash","text":"npx -y os-prism --db ~/.os-prism/benchmarks.db"},{"id":"blk-22669","kind":"paragraph","spans":[{"id":"spn-23332","text":"Or in "},{"id":"spn-23333","marks":["code"],"text":".mcp.json"},{"id":"spn-23334","text":":"}]},{"id":"blk-22670","kind":"code","language":"jsonc","text":"{\n  \"mcpServers\": {\n    \"prism\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"os-prism\", \"--db\", \"~/.os-prism/benchmarks.db\"]\n    }\n  }\n}"},{"id":"blk-22671","kind":"paragraph","spans":[{"id":"spn-23335","marks":["code"],"text":"postinstall"},{"id":"spn-23336","text":" fetches the platform-appropriate Elixir escript bundle (darwin-x64, darwin-arm64, linux-x64, linux-arm64) from the GitHub release assets attached to the matching "},{"id":"spn-23337","marks":["code"],"text":"os-prism-vX.Y.Z"},{"id":"spn-23338","text":" git tag, verifies the SHA256, and installs it under "},{"id":"spn-23339","marks":["code"],"text":"vendor/"},{"id":"spn-23340","text":". Offline installs can set "},{"id":"spn-23341","marks":["code"],"text":"PRISM_ESCRIPT_PATH"},{"id":"spn-23342","text":" to skip the fetch."}]},{"id":"blk-22672","kind":"heading","level":2,"spans":[{"id":"spn-23343","text":"CLI Flags"}]},{"head":[{"id":"blk-22674","spans":[{"id":"spn-23344","text":"Flag"}]},{"id":"blk-22675","spans":[{"id":"spn-23345","text":"Default"}]},{"id":"blk-22676","spans":[{"id":"spn-23346","text":"Description"}]}],"id":"blk-22673","kind":"table","rows":[[{"id":"blk-22677","spans":[{"id":"spn-23347","marks":["code"],"text":"--db <path>"}]},{"id":"blk-22678","spans":[{"id":"spn-23348","marks":["code"],"text":"~/.os-prism/benchmarks.db"}]},{"id":"blk-22679","spans":[{"id":"spn-23349","text":"SQLite database path."}]}],[{"id":"blk-22680","spans":[{"id":"spn-23350","marks":["code"],"text":"--transport"}]},{"id":"blk-22681","spans":[{"id":"spn-23351","marks":["code"],"text":"stdio"}]},{"id":"blk-22682","spans":[{"id":"spn-23352","marks":["code"],"text":"stdio"},{"id":"spn-23353","text":" or "},{"id":"spn-23354","marks":["code"],"text":"http"},{"id":"spn-23355","text":"."}]}],[{"id":"blk-22683","spans":[{"id":"spn-23356","marks":["code"],"text":"--port <n>"}]},{"id":"blk-22684","spans":[{"id":"spn-23357","marks":["code"],"text":"4712"}]},{"id":"blk-22685","spans":[{"id":"spn-23358","text":"HTTP port (ignored for stdio)."}]}],[{"id":"blk-22686","spans":[{"id":"spn-23359","marks":["code"],"text":"--engine-path <path>"}]},{"id":"blk-22687","spans":[{"id":"spn-23360","marks":["code"],"text":"./vendor/prism_engine"}]},{"id":"blk-22688","spans":[{"id":"spn-23361","text":"Path to the bundled Elixir escript."}]}],[{"id":"blk-22689","spans":[{"id":"spn-23362","marks":["code"],"text":"--llm-provider"}]},{"id":"blk-22690","spans":[{"id":"spn-23363","marks":["code"],"text":"openrouter"}]},{"id":"blk-22691","spans":[{"id":"spn-23364","marks":["code"],"text":"openrouter"},{"id":"spn-23365","text":", "},{"id":"spn-23366","marks":["code"],"text":"anthropic"},{"id":"spn-23367","text":", "},{"id":"spn-23368","marks":["code"],"text":"openai"},{"id":"spn-23369","text":", "},{"id":"spn-23370","marks":["code"],"text":"gemini"},{"id":"spn-23371","text":"."}]}],[{"id":"blk-22692","spans":[{"id":"spn-23372","marks":["code"],"text":"--llm-api-key-env"}]},{"id":"blk-22693","spans":[{"id":"spn-23373","marks":["code"],"text":"OPENROUTER_API_KEY"}]},{"id":"blk-22694","spans":[{"id":"spn-23374","text":"Env var name to read the API key from."}]}],[{"id":"blk-22695","spans":[{"id":"spn-23375","marks":["code"],"text":"--log-level"}]},{"id":"blk-22696","spans":[{"id":"spn-23376","marks":["code"],"text":"info"}]},{"id":"blk-22697","spans":[{"id":"spn-23377","marks":["code"],"text":"debug"},{"id":"spn-23378","text":", "},{"id":"spn-23379","marks":["code"],"text":"info"},{"id":"spn-23380","text":", "},{"id":"spn-23381","marks":["code"],"text":"warn"},{"id":"spn-23382","text":", "},{"id":"spn-23383","marks":["code"],"text":"error"},{"id":"spn-23384","text":"."}]}],[{"id":"blk-22698","spans":[{"id":"spn-23385","marks":["code"],"text":"--version"},{"id":"spn-23386","text":" / "},{"id":"spn-23387","marks":["code"],"text":"--help"}]},{"id":"blk-22699","spans":[{"id":"spn-23388","text":"—"}]},{"id":"blk-22700","spans":[{"id":"spn-23389","text":"Print and exit."}]}]]},{"id":"blk-22701","kind":"heading","level":2,"spans":[{"id":"spn-23390","text":"Dependencies"}]},{"head":[{"id":"blk-22703","spans":[{"id":"spn-23391","text":"Dependency"}]},{"id":"blk-22704","spans":[{"id":"spn-23392","text":"Version"}]},{"id":"blk-22705","spans":[{"id":"spn-23393","text":"Why"}]}],"id":"blk-22702","kind":"table","rows":[[{"id":"blk-22706","spans":[{"id":"spn-23394","marks":["code"],"text":"@modelcontextprotocol/sdk"}]},{"id":"blk-22707","spans":[{"id":"spn-23395","marks":["code"],"text":"^1.29.0"}]},{"id":"blk-22708","spans":[{"id":"spn-23396","text":"Stable v1.x MCP surface."}]}],[{"id":"blk-22709","spans":[{"id":"spn-23397","marks":["code"],"text":"better-sqlite3"}]},{"id":"blk-22710","spans":[{"id":"spn-23398","marks":["code"],"text":"^12.8.0"}]},{"id":"blk-22711","spans":[{"id":"spn-23399","text":"SQLite bindings (benchmark metadata)."}]}],[{"id":"blk-22712","spans":[{"id":"spn-23400","marks":["code"],"text":"sqlite-vec"}]},{"id":"blk-22713","spans":[{"id":"spn-23401","marks":["code"],"text":"^0.1.10"}]},{"id":"blk-22714","spans":[{"id":"spn-23402","text":"Vector index over scenario embeddings."}]}],[{"id":"blk-22715","spans":[{"id":"spn-23403","marks":["code"],"text":"zod"}]},{"id":"blk-22716","spans":[{"id":"spn-23404","marks":["code"],"text":"^3.23.0"}]},{"id":"blk-22717","spans":[{"id":"spn-23405","text":"Tool input schemas."}]}],[{"id":"blk-22718","spans":[{"id":"spn-23406","marks":["code"],"text":"yargs"}]},{"id":"blk-22719","spans":[{"id":"spn-23407","marks":["code"],"text":"^17.7.0"}]},{"id":"blk-22720","spans":[{"id":"spn-23408","text":"CLI parsing."}]}],[{"id":"blk-22721","spans":[{"id":"spn-23409","marks":["code"],"text":"node-fetch"}]},{"id":"blk-22722","spans":[{"id":"spn-23410","marks":["code"],"text":"^3.3.2"}]},{"id":"blk-22723","spans":[{"id":"spn-23411","text":"Escript bundle download (postinstall)."}]}],[{"id":"blk-22724","spans":[{"id":"spn-23412","text":"(Elixir runtime)"}]},{"id":"blk-22725","spans":[{"id":"spn-23413","text":"via escript"}]},{"id":"blk-22726","spans":[{"id":"spn-23414","marks":["code"],"text":"vendor/prism_engine"},{"id":"spn-23415","text":" — the PRISM OTP app as an escript."}]}]]},{"id":"blk-22727","kind":"paragraph","spans":[{"id":"spn-23416","text":"The Elixir engine itself pulls: "},{"id":"spn-23417","marks":["code"],"text":"ecto_sqlite3"},{"id":"spn-23418","text":", "},{"id":"spn-23419","marks":["code"],"text":"exqlite"},{"id":"spn-23420","text":", "},{"id":"spn-23421","marks":["code"],"text":"req"},{"id":"spn-23422","text":", "},{"id":"spn-23423","marks":["code"],"text":"jason"},{"id":"spn-23424","text":", "},{"id":"spn-23425","marks":["code"],"text":"peri"},{"id":"spn-23426","text":", "},{"id":"spn-23427","marks":["code"],"text":"nimble_options"},{"id":"spn-23428","text":". These live inside the escript bundle — they do "},{"id":"spn-23429","marks":["bold"],"text":"not"},{"id":"spn-23430","text":" appear in "},{"id":"spn-23431","marks":["code"],"text":"package.json"},{"id":"spn-23432","text":"."}]},{"id":"blk-22728","kind":"heading","level":2,"spans":[{"id":"spn-23433","text":"Wire Protocol (Node ⇄ Elixir)"}]},{"id":"blk-22729","kind":"paragraph","spans":[{"id":"spn-23434","text":"The TS MCP server spawns the vendored escript as a child process and communicates over line-delimited JSON on the escript's stdin/stdout. Each MCP tool call is translated into a single JSON-RPC-style request:"}]},{"id":"blk-22730","kind":"code","language":"jsonc","text":"// TS → escript\n{ \"id\": \"req-123\", \"method\": \"interact.run\", \"params\": { \"scenario_id\": \"s42\" } }\n\n// escript → TS\n{ \"id\": \"req-123\", \"ok\": true, \"result\": { \"run_id\": \"r_...\", \"transcript\": \"…\" } }"},{"id":"blk-22731","kind":"paragraph","spans":[{"id":"spn-23435","text":"The escript exposes exactly the same 6 machines + actions that the Elixir PRISM application currently supports, so the TS wrapper is a thin pass-through with zod input validation and MCP response shaping."}]},{"id":"blk-22732","kind":"heading","level":2,"spans":[{"id":"spn-23436","text":"SQLite Schema (TS-side)"}]},{"id":"blk-22733","kind":"paragraph","spans":[{"id":"spn-23437","text":"The TS wrapper stores a small projection for fast MCP resource responses; the authoritative benchmark state lives inside the escript's own SQLite file (at the path passed via "},{"id":"spn-23438","marks":["code"],"text":"--db"},{"id":"spn-23439","text":")."}]},{"id":"blk-22734","kind":"code","language":"sql","text":"CREATE TABLE IF NOT EXISTS systems (\n  id             TEXT PRIMARY KEY,                -- e.g. \"graphonomous@0.4.0\"\n  name           TEXT NOT NULL,\n  manifest_uri   TEXT,                            -- PULSE manifest URL or file path\n  registered_at  INTEGER NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS runs (\n  id             TEXT PRIMARY KEY,\n  system_id      TEXT NOT NULL,\n  scenario_id    TEXT NOT NULL,\n  status         TEXT NOT NULL,                   -- queued | running | ok | error\n  started_at     INTEGER NOT NULL,\n  ended_at       INTEGER,\n  transcript_uri TEXT,                            -- engine-side URI\n  FOREIGN KEY (system_id) REFERENCES systems (id)\n);"},{"id":"blk-22735","kind":"heading","level":2,"spans":[{"id":"spn-23440","text":"MCP Tools (6 machines, 47 actions — delegated to Elixir)"}]},{"head":[{"id":"blk-22737","spans":[{"id":"spn-23441","text":"Machine"}]},{"id":"blk-22738","spans":[{"id":"spn-23442","text":"Actions"}]}],"id":"blk-22736","kind":"table","rows":[[{"id":"blk-22739","spans":[{"id":"spn-23443","marks":["code"],"text":"compose"}]},{"id":"blk-22740","spans":[{"id":"spn-23444","marks":["code"],"text":"scenarios"},{"id":"spn-23445","text":", "},{"id":"spn-23446","marks":["code"],"text":"validate"},{"id":"spn-23447","text":", "},{"id":"spn-23448","marks":["code"],"text":"list"},{"id":"spn-23449","text":", "},{"id":"spn-23450","marks":["code"],"text":"get"},{"id":"spn-23451","text":", "},{"id":"spn-23452","marks":["code"],"text":"retire"},{"id":"spn-23453","text":", "},{"id":"spn-23454","marks":["code"],"text":"import"},{"id":"spn-23455","text":", "},{"id":"spn-23456","marks":["code"],"text":"byor_register"},{"id":"spn-23457","text":", "},{"id":"spn-23458","marks":["code"],"text":"byor_discover"},{"id":"spn-23459","text":", "},{"id":"spn-23460","marks":["code"],"text":"byor_generate"}]}],[{"id":"blk-22741","spans":[{"id":"spn-23461","marks":["code"],"text":"interact"}]},{"id":"blk-22742","spans":[{"id":"spn-23462","marks":["code"],"text":"run"},{"id":"spn-23463","text":", "},{"id":"spn-23464","marks":["code"],"text":"run_sequence"},{"id":"spn-23465","text":", "},{"id":"spn-23466","marks":["code"],"text":"run_matrix"},{"id":"spn-23467","text":", "},{"id":"spn-23468","marks":["code"],"text":"status"},{"id":"spn-23469","text":", "},{"id":"spn-23470","marks":["code"],"text":"transcript"},{"id":"spn-23471","text":", "},{"id":"spn-23472","marks":["code"],"text":"cancel"},{"id":"spn-23473","text":", "},{"id":"spn-23474","marks":["code"],"text":"byor_evaluate"},{"id":"spn-23475","text":", "},{"id":"spn-23476","marks":["code"],"text":"byor_compare"}]}],[{"id":"blk-22743","spans":[{"id":"spn-23477","marks":["code"],"text":"observe"}]},{"id":"blk-22744","spans":[{"id":"spn-23478","marks":["code"],"text":"judge_transcript"},{"id":"spn-23479","text":", "},{"id":"spn-23480","marks":["code"],"text":"judge_dimension"},{"id":"spn-23481","text":", "},{"id":"spn-23482","marks":["code"],"text":"meta_judge"},{"id":"spn-23483","text":", "},{"id":"spn-23484","marks":["code"],"text":"meta_judge_batch"},{"id":"spn-23485","text":", "},{"id":"spn-23486","marks":["code"],"text":"override"}]}],[{"id":"blk-22745","spans":[{"id":"spn-23487","marks":["code"],"text":"reflect"}]},{"id":"blk-22746","spans":[{"id":"spn-23488","marks":["code"],"text":"analyze_gaps"},{"id":"spn-23489","text":", "},{"id":"spn-23490","marks":["code"],"text":"evolve"},{"id":"spn-23491","text":", "},{"id":"spn-23492","marks":["code"],"text":"advance_cycle"},{"id":"spn-23493","text":", "},{"id":"spn-23494","marks":["code"],"text":"calibrate_irt"},{"id":"spn-23495","text":", "},{"id":"spn-23496","marks":["code"],"text":"cycle_history"},{"id":"spn-23497","text":", "},{"id":"spn-23498","marks":["code"],"text":"byor_recommend"},{"id":"spn-23499","text":", "},{"id":"spn-23500","marks":["code"],"text":"byor_infer_profile"}]}],[{"id":"blk-22747","spans":[{"id":"spn-23501","marks":["code"],"text":"diagnose"}]},{"id":"blk-22748","spans":[{"id":"spn-23502","marks":["code"],"text":"report"},{"id":"spn-23503","text":", "},{"id":"spn-23504","marks":["code"],"text":"failure_patterns"},{"id":"spn-23505","text":", "},{"id":"spn-23506","marks":["code"],"text":"retest"},{"id":"spn-23507","text":", "},{"id":"spn-23508","marks":["code"],"text":"verify"},{"id":"spn-23509","text":", "},{"id":"spn-23510","marks":["code"],"text":"regressions"},{"id":"spn-23511","text":", "},{"id":"spn-23512","marks":["code"],"text":"suggest_fixes"},{"id":"spn-23513","text":", "},{"id":"spn-23514","marks":["code"],"text":"leaderboard"},{"id":"spn-23515","text":", "},{"id":"spn-23516","marks":["code"],"text":"leaderboard_history"},{"id":"spn-23517","text":", "},{"id":"spn-23518","marks":["code"],"text":"compare_systems"},{"id":"spn-23519","text":", "},{"id":"spn-23520","marks":["code"],"text":"dimension_leaders"},{"id":"spn-23521","text":", "},{"id":"spn-23522","marks":["code"],"text":"fit_recommendation"},{"id":"spn-23523","text":", "},{"id":"spn-23524","marks":["code"],"text":"compare_fit"},{"id":"spn-23525","text":", "},{"id":"spn-23526","marks":["code"],"text":"task_profiles"}]}],[{"id":"blk-22749","spans":[{"id":"spn-23527","marks":["code"],"text":"config"}]},{"id":"blk-22750","spans":[{"id":"spn-23528","marks":["code"],"text":"set_weights"},{"id":"spn-23529","text":", "},{"id":"spn-23530","marks":["code"],"text":"register_system"},{"id":"spn-23531","text":", "},{"id":"spn-23532","marks":["code"],"text":"list_systems"},{"id":"spn-23533","text":", "},{"id":"spn-23534","marks":["code"],"text":"get_config"},{"id":"spn-23535","text":", "},{"id":"spn-23536","marks":["code"],"text":"create_profile"}]}]]},{"id":"blk-22751","kind":"paragraph","spans":[{"id":"spn-23537","text":"All 47 actions are already implemented in Elixir under "},{"id":"spn-23538","marks":["code"],"text":"PRISM/lib/prism/mcp/machines/"},{"id":"spn-23539","text":". The npm wrapper does not add or remove actions; it only exposes them over the MCP SDK's stdio transport."}]},{"id":"blk-22752","kind":"heading","level":2,"spans":[{"id":"spn-23540","text":"MCP Resources"}]},{"head":[{"id":"blk-22754","spans":[{"id":"spn-23541","text":"URI"}]},{"id":"blk-22755","spans":[{"id":"spn-23542","text":"Returns"}]}],"id":"blk-22753","kind":"table","rows":[[{"id":"blk-22756","spans":[{"id":"spn-23543","marks":["code"],"text":"prism://runtime/health"}]},{"id":"blk-22757","spans":[{"id":"spn-23544","text":"Engine health, pending run count, queue depth."}]}],[{"id":"blk-22758","spans":[{"id":"spn-23545","marks":["code"],"text":"prism://systems/registered"}]},{"id":"blk-22759","spans":[{"id":"spn-23546","text":"Registered BYOR systems."}]}],[{"id":"blk-22760","spans":[{"id":"spn-23547","marks":["code"],"text":"prism://runs/recent"}]},{"id":"blk-22761","spans":[{"id":"spn-23548","text":"Recent benchmark runs."}]}],[{"id":"blk-22762","spans":[{"id":"spn-23549","marks":["code"],"text":"prism://leaderboard/{profile}"}]},{"id":"blk-22763","spans":[{"id":"spn-23550","text":"Leaderboard for a given task profile."}]}],[{"id":"blk-22764","spans":[{"id":"spn-23551","marks":["code"],"text":"prism://scenarios/{id}"}]},{"id":"blk-22765","spans":[{"id":"spn-23552","text":"Scenario definition."}]}],[{"id":"blk-22766","spans":[{"id":"spn-23553","marks":["code"],"text":"prism://transcripts/{run_id}"}]},{"id":"blk-22767","spans":[{"id":"spn-23554","text":"Full transcript for a run."}]}]]},{"id":"blk-22768","kind":"heading","level":2,"spans":[{"id":"spn-23555","text":"Project Layout"}]},{"id":"blk-22769","kind":"code","language":"text","text":"PRISM/\n├── package.json                    # \"name\": \"os-prism\"\n├── tsconfig.json\n├── bin/\n│   └── os-prism.js\n├── src/\n│   ├── server.ts                   # MCP wiring\n│   ├── db.ts                       # projection DB\n│   ├── engine.ts                   # spawn + JSON-RPC over stdio\n│   ├── tools/\n│   │   ├── compose.ts\n│   │   ├── interact.ts\n│   │   ├── observe.ts\n│   │   ├── reflect.ts\n│   │   ├── diagnose.ts\n│   │   └── config.ts\n│   ├── resources/ …\n│   └── cli.ts\n├── scripts/\n│   └── postinstall.js              # fetch vendor/prism_engine\n└── lib/                            # existing Elixir PRISM app (escript source)"},{"id":"blk-22770","kind":"heading","level":2,"spans":[{"id":"spn-23556","text":"Build and Publish"}]},{"id":"blk-22771","kind":"code","language":"bash","text":"cd PRISM\n# 1. Build the Elixir escript engine for each target platform\nMIX_ENV=prod mix escript.build          # writes to ./prism_engine\n# 2. Upload to GitHub Releases under tag os-prism-v0.1.0 (CI)\n# 3. Build and publish the TS wrapper\nnpm install\nnpm run build\nnpm publish --access public"},{"id":"blk-22772","kind":"heading","level":2,"spans":[{"id":"spn-23557","text":"Why os-prism ships third"}]},{"id":"blk-22773","items":[{"blocks":[{"id":"blk-22775","kind":"paragraph","spans":[{"id":"spn-23558","text":"Optionally reads a system-under-test's "},{"id":"spn-23559","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-23560","text":" spec graph (via"}]}],"id":"blk-22774","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-22776","kind":"paragraph","spans":[{"id":"spn-23561","text":"the [&] reference CLI / SDKs) to understand what it is composed of."}]},{"id":"blk-22777","items":[{"blocks":[{"id":"blk-22779","kind":"paragraph","spans":[{"id":"spn-23562","text":"Depends on "},{"id":"spn-23563","marks":["code"],"text":"os-pulse"},{"id":"spn-23564","text":" to read the system-under-test's PULSE manifest and"}]}],"id":"blk-22778","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-22780","kind":"paragraph","spans":[{"id":"spn-23565","text":"discover the "},{"id":"spn-23566","marks":["code"],"text":"retrieve"},{"id":"spn-23567","text":" and "},{"id":"spn-23568","marks":["code"],"text":"learn"},{"id":"spn-23569","text":" boundaries."}]},{"id":"blk-22781","items":[{"blocks":[{"id":"blk-22783","kind":"paragraph","spans":[{"id":"spn-23570","text":"Requires the graphonomous-style postinstall escript pattern, which is"}]}],"id":"blk-22782","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-22784","kind":"paragraph","spans":[{"id":"spn-23571","text":"the most complex install path of the three packages."}]}],"edges":[],"id":"bagaaierafb7fch24csukcchfq6qfyiu5spi5gajkv67muglwmebhj2jdssxa","vocabulary":"ampersand.docs.fs.v1"}