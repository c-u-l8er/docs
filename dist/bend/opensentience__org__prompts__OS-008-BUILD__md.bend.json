],"text":"require_evidence: true"},{"id":"spn-64316","text":", "},{"id":"spn-64317","marks":["code"],"text":"max_evaluation_time: 120s"},{"id":"spn-64318","text":", "},{"id":"spn-64319","marks":["code"],"text":"adversarial_prompt: true"},{"id":"spn-64320","text":", "},{"id":"spn-64321","marks":["code"],"text":"separate_context: true"}]}],"id":"blk-55980","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55982","kind":"paragraph","spans":[{"id":"spn-64322","text":"2. "},{"id":"spn-64323","marks":["bold"],"text":"Implement iteration loop"},{"id":"spn-64324","text":" (section 6.3)"}]},{"id":"blk-55983","items":[{"blocks":[{"id":"blk-55985","kind":"paragraph","spans":[{"id":"spn-64325","text":"Generator implements → evaluator grades → if fail, feedback to generator → repeat"}]}],"id":"blk-55984","kind":"list-item"},{"blocks":[{"id":"blk-55987","kind":"paragraph","spans":[{"id":"spn-64326","text":"Up to "},{"id":"spn-64327","marks":["code"],"text":"max_iterations_per_sprint"},{"id":"spn-64328","text":" (tier-dependent: 2/3/5)"}]}],"id":"blk-55986","kind":"list-item"},{"blocks":[{"id":"blk-55989","kind":"paragraph","spans":[{"id":"spn-64329","text":"On max iterations reached → escalate to human"}]}],"id":"blk-55988","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55990","kind":"heading","level":3,"spans":[{"id":"spn-64330","text":"Phase 3: Contract Validator (weeks 5-7)"}]},{"id":"blk-55991","kind":"paragraph","spans":[{"id":"spn-64331","text":"1. "},{"id":"spn-64332","marks":["bold"],"text":"Implement ContractValidator"},{"id":"spn-64333","text":" ("},{"id":"spn-64334","marks":["code"],"text":"harness/contract_validator.ex"},{"id":"spn-64335","text":")"}]},{"id":"blk-55992","items":[{"blocks":[{"id":"blk-55994","kind":"paragraph","spans":[{"id":"spn-64336","marks":["code"],"text":"validate/2"},{"id":"spn-64337","text":" — validate action against governance block"}]}],"id":"blk-55993","kind":"list-item"},{"blocks":[{"id":"blk-55996","kind":"paragraph","spans":[{"id":"spn-64338","text":"Hard constraints → "},{"id":"spn-64339","marks":["code"],"text":":block"},{"id":"spn-64340","text":" (inviolable)"}]}],"id":"blk-55995","kind":"list-item"},{"blocks":[{"id":"blk-55998","kind":"paragraph","spans":[{"id":"spn-64341","text":"Soft constraints → "},{"id":"spn-64342","marks":["code"],"text":":allow"},{"id":"spn-64343","text":" with warnings"}]}],"id":"blk-55997","kind":"list-item"},{"blocks":[{"id":"blk-56000","kind":"paragraph","spans":[{"id":"spn-64344","text":"Escalation triggers → "},{"id":"spn-64345","marks":["code"],"text":":escalate"},{"id":"spn-64346","text":" (confidence_below, cost_exceeds_usd)"}]}],"id":"blk-55999","kind":"list-item"},{"blocks":[{"id":"blk-56002","kind":"paragraph","spans":[{"id":"spn-64347","text":"Confidence-gated execution (section 7.3)"}]}],"id":"blk-56001","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56003","kind":"paragraph","spans":[{"id":"spn-64348","text":"2. "},{"id":"spn-64349","marks":["bold"],"text":"Parse [&] governance blocks"},{"id":"spn-64350","text":" from "},{"id":"spn-64351","marks":["code"],"text":"ampersand.json"}]},{"id":"blk-56004","items":[{"blocks":[{"id":"blk-56006","kind":"paragraph","spans":[{"id":"spn-64352","text":"Hard/soft constraint extraction"}]}],"id":"blk-56005","kind":"list-item"},{"blocks":[{"id":"blk-56008","kind":"paragraph","spans":[{"id":"spn-64353","text":"Escalation rule extraction"}]}],"id":"blk-56007","kind":"list-item"},{"blocks":[{"id":"blk-56010","kind":"paragraph","spans":[{"id":"spn-64354","text":"Autonomy level caps"}]}],"id":"blk-56009","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56011","kind":"heading","level":3,"spans":[{"id":"spn-64355","text":"Phase 4: Sprint Controller (weeks 7-10)"}]},{"id":"blk-56012","kind":"paragraph","spans":[{"id":"spn-64356","text":"1. "},{"id":"spn-64357","marks":["bold"],"text":"Implement SprintController"},{"id":"spn-64358","text":" ("},{"id":"spn-64359","marks":["code"],"text":"harness/sprint_controller.ex"},{"id":"spn-64360","text":") as GenStateMachine"}]},{"id":"blk-56013","items":[{"blocks":[{"id":"blk-56015","kind":"paragraph","spans":[{"id":"spn-64361","text":"States: "},{"id":"spn-64362","marks":["code"],"text":"planned → generating → evaluating → passed → feedback → committed → escalated → completed"}]}],"id":"blk-56014","kind":"list-item"},{"blocks":[{"id":"blk-56017","kind":"paragraph","spans":[{"id":"spn-64363","text":"Sprint contract production (section 9.2)"}]}],"id":"blk-56016","kind":"list-item"},{"blocks":[{"id":"blk-56019","kind":"paragraph","spans":[{"id":"spn-64364","text":"Planner → generator → evaluator routing"}]}],"id":"blk-56018","kind":"list-item"},{"blocks":[{"id":"blk-56021","kind":"paragraph","spans":[{"id":"spn-64365","text":"Iteration tracking with budget enforcement"}]}],"id":"blk-56020","kind":"list-item"},{"blocks":[{"id":"blk-56023","kind":"paragraph","spans":[{"id":"spn-64366","text":"Git commit integration on sprint pass"}]}],"id":"blk-56022","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56024","kind":"paragraph","spans":[{"id":"spn-64367","text":"2. "},{"id":"spn-64368","marks":["bold"],"text":"Implement the three agent roles"},{"id":"spn-64369","text":" (section 4)"}]},{"id":"blk-56025","items":[{"blocks":[{"id":"blk-56027","kind":"paragraph","spans":[{"id":"spn-64370","text":"Planner: "},{"id":"spn-64371","marks":["code"],"text":"&reason.plan"},{"id":"spn-64372","text":" contract — decompose task → sprint specs"}]}],"id":"blk-56026","kind":"list-item"},{"blocks":[{"id":"blk-56029","kind":"paragraph","spans":[{"id":"spn-64373","text":"Generator: "},{"id":"spn-64374","marks":["code"],"text":"&reason.generate"},{"id":"spn-64375","text":" contract — implement sprint"}]}],"id":"blk-56028","kind":"list-item"},{"blocks":[{"id":"blk-56031","kind":"paragraph","spans":[{"id":"spn-64376","text":"Evaluator: "},{"id":"spn-64377","marks":["code"],"text":"&reason.evaluate"},{"id":"spn