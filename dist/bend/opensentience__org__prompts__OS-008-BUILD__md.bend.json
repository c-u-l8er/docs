code"],"text":"harness/sprint_controller.ex"},{"id":"spn-65534","text":") as GenStateMachine"}]},{"id":"blk-56499","items":[{"blocks":[{"id":"blk-56501","kind":"paragraph","spans":[{"id":"spn-65535","text":"States: "},{"id":"spn-65536","marks":["code"],"text":"planned → generating → evaluating → passed → feedback → committed → escalated → completed"}]}],"id":"blk-56500","kind":"list-item"},{"blocks":[{"id":"blk-56503","kind":"paragraph","spans":[{"id":"spn-65537","text":"Sprint contract production (section 9.2)"}]}],"id":"blk-56502","kind":"list-item"},{"blocks":[{"id":"blk-56505","kind":"paragraph","spans":[{"id":"spn-65538","text":"Planner → generator → evaluator routing"}]}],"id":"blk-56504","kind":"list-item"},{"blocks":[{"id":"blk-56507","kind":"paragraph","spans":[{"id":"spn-65539","text":"Iteration tracking with budget enforcement"}]}],"id":"blk-56506","kind":"list-item"},{"blocks":[{"id":"blk-56509","kind":"paragraph","spans":[{"id":"spn-65540","text":"Git commit integration on sprint pass"}]}],"id":"blk-56508","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56510","kind":"paragraph","spans":[{"id":"spn-65541","text":"2. "},{"id":"spn-65542","marks":["bold"],"text":"Implement the three agent roles"},{"id":"spn-65543","text":" (section 4)"}]},{"id":"blk-56511","items":[{"blocks":[{"id":"blk-56513","kind":"paragraph","spans":[{"id":"spn-65544","text":"Planner: "},{"id":"spn-65545","marks":["code"],"text":"&reason.plan"},{"id":"spn-65546","text":" contract — decompose task → sprint specs"}]}],"id":"blk-56512","kind":"list-item"},{"blocks":[{"id":"blk-56515","kind":"paragraph","spans":[{"id":"spn-65547","text":"Generator: "},{"id":"spn-65548","marks":["code"],"text":"&reason.generate"},{"id":"spn-65549","text":" contract — implement sprint"}]}],"id":"blk-56514","kind":"list-item"},{"blocks":[{"id":"blk-56517","kind":"paragraph","spans":[{"id":"spn-65550","text":"Evaluator: "},{"id":"spn-65551","marks":["code"],"text":"&reason.evaluate"},{"id":"spn