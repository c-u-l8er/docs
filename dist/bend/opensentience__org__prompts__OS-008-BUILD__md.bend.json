],"text":"require_evidence: true"},{"id":"spn-63604","text":", "},{"id":"spn-63605","marks":["code"],"text":"max_evaluation_time: 120s"},{"id":"spn-63606","text":", "},{"id":"spn-63607","marks":["code"],"text":"adversarial_prompt: true"},{"id":"spn-63608","text":", "},{"id":"spn-63609","marks":["code"],"text":"separate_context: true"}]}],"id":"blk-55850","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55852","kind":"paragraph","spans":[{"id":"spn-63610","text":"2. "},{"id":"spn-63611","marks":["bold"],"text":"Implement iteration loop"},{"id":"spn-63612","text":" (section 6.3)"}]},{"id":"blk-55853","items":[{"blocks":[{"id":"blk-55855","kind":"paragraph","spans":[{"id":"spn-63613","text":"Generator implements → evaluator grades → if fail, feedback to generator → repeat"}]}],"id":"blk-55854","kind":"list-item"},{"blocks":[{"id":"blk-55857","kind":"paragraph","spans":[{"id":"spn-63614","text":"Up to "},{"id":"spn-63615","marks":["code"],"text":"max_iterations_per_sprint"},{"id":"spn-63616","text":" (tier-dependent: 2/3/5)"}]}],"id":"blk-55856","kind":"list-item"},{"blocks":[{"id":"blk-55859","kind":"paragraph","spans":[{"id":"spn-63617","text":"On max iterations reached → escalate to human"}]}],"id":"blk-55858","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55860","kind":"heading","level":3,"spans":[{"id":"spn-63618","text":"Phase 3: Contract Validator (weeks 5-7)"}]},{"id":"blk-55861","kind":"paragraph","spans":[{"id":"spn-63619","text":"1. "},{"id":"spn-63620","marks":["bold"],"text":"Implement ContractValidator"},{"id":"spn-63621","text":" ("},{"id":"spn-63622","marks":["code"],"text":"harness/contract_validator.ex"},{"id":"spn-63623","text":")"}]},{"id":"blk-55862","items":[{"blocks":[{"id":"blk-55864","kind":"paragraph","spans":[{"id":"spn-63624","marks":["code"],"text":"validate/2"},{"id":"spn-63625","text":" — validate action against governance block"}]}],"id":"blk-55863","kind":"list-item"},{"blocks":[{"id":"blk-55866","kind":"paragraph","spans":[{"id":"spn-63626","text":"Hard constraints → "},{"id":"spn-63627","marks":["code"],"text":":block"},{"id":"spn-63628","text":" (inviolable)"}]}],"id":"blk-55865","kind":"list-item"},{"blocks":[{"id":"blk-55868","kind":"paragraph","spans":[{"id":"spn-63629","text":"Soft constraints → "},{"id":"spn-63630","marks":["code"],"text":":allow"},{"id":"spn-63631","text":" with warnings"}]}],"id":"blk-55867","kind":"list-item"},{"blocks":[{"id":"blk-55870","kind":"paragraph","spans":[{"id":"spn-63632","text":"Escalation triggers → "},{"id":"spn-63633","marks":["code"],"text":":escalate"},{"id":"spn-63634","text":" (confidence_below, cost_exceeds_usd)"}]}],"id":"blk-55869","kind":"list-item"},{"blocks":[{"id":"blk-55872","kind":"paragraph","spans":[{"id":"spn-63635","text":"Confidence-gated execution (section 7.3)"}]}],"id":"blk-55871","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55873","kind":"paragraph","spans":[{"id":"spn-63636","text":"2. "},{"id":"spn-63637","marks":["bold"],"text":"Parse [&] governance blocks"},{"id":"spn-63638","text":" from "},{"id":"spn-63639","marks":["code"],"text":"ampersand.json"}]},{"id":"blk-55874","items":[{"blocks":[{"id":"blk-55876","kind":"paragraph","spans":[{"id":"spn-63640","text":"Hard/soft constraint extraction"}]}],"id":"blk-55875","kind":"list-item"},{"blocks":[{"id":"blk-55878","kind":"paragraph","spans":[{"id":"spn-63641","text":"Escalation rule extraction"}]}],"id":"blk-55877","kind":"list-item"},{"blocks":[{"id":"blk-55880","kind":"paragraph","spans":[{"id":"spn-63642","text":"Autonomy level caps"}]}],"id":"blk-55879","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55881","kind":"heading","level":3,"spans":[{"id":"spn-63643","text":"Phase 4: Sprint Controller (weeks 7-10)"}]},{"id":"blk-55882","kind":"paragraph","spans":[{"id":"spn-63644","text":"1. "},{"id":"spn-63645","marks":["bold"],"text":"Implement SprintController"},{"id":"spn-63646","text":" ("},{"id":"spn-63647","marks":["code"],"text":"harness/sprint_controller.ex"},{"id":"spn-63648","text":") as GenStateMachine"}]},{"id":"blk-55883","items":[{"blocks":[{"id":"blk-55885","kind":"paragraph","spans":[{"id":"spn-63649","text":"States: "},{"id":"spn-63650","marks":["code"],"text":"planned → generating → evaluating → passed → feedback → committed → escalated → completed"}]}],"id":"blk-55884","kind":"list-item"},{"blocks":[{"id":"blk-55887","kind":"paragraph","spans":[{"id":"spn-63651","text":"Sprint contract production (section 9.2)"}]}],"id":"blk-55886","kind":"list-item"},{"blocks":[{"id":"blk-55889","kind":"paragraph","spans":[{"id":"spn-63652","text":"Planner → generator → evaluator routing"}]}],"id":"blk-55888","kind":"list-item"},{"blocks":[{"id":"blk-55891","kind":"paragraph","spans":[{"id":"spn-63653","text":"Iteration tracking with budget enforcement"}]}],"id":"blk-55890","kind":"list-item"},{"blocks":[{"id":"blk-55893","kind":"paragraph","spans":[{"id":"spn-63654","text":"Git commit integration on sprint pass"}]}],"id":"blk-55892","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55894","kind":"paragraph","spans":[{"id":"spn-63655","text":"2. "},{"id":"spn-63656","marks":["bold"],"text":"Implement the three agent roles"},{"id":"spn-63657","text":" (section 4)"}]},{"id":"blk-55895","items":[{"blocks":[{"id":"blk-55897","kind":"paragraph","spans":[{"id":"spn-63658","text":"Planner: "},{"id":"spn-63659","marks":["code"],"text":"&reason.plan"},{"id":"spn-63660","text":" contract — decompose task → sprint specs"}]}],"id":"blk-55896","kind":"list-item"},{"blocks":[{"id":"blk-55899","kind":"paragraph","spans":[{"id":"spn-63661","text":"Generator: "},{"id":"spn-63662","marks":["code"],"text":"&reason.generate"},{"id":"spn-63663","text":" contract — implement sprint"}]}],"id":"blk-55898","kind":"list-item"},{"blocks":[{"id":"blk-55901","kind":"paragraph","spans":[{"id":"spn-63664","text":"Evaluator: "},{"id":"spn-63665","marks":["code"],"text":"&reason.evaluate"},{"id":"spn