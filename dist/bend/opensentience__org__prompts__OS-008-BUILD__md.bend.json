],"text":"require_evidence: true"},{"id":"spn-66610","text":", "},{"id":"spn-66611","marks":["code"],"text":"max_evaluation_time: 120s"},{"id":"spn-66612","text":", "},{"id":"spn-66613","marks":["code"],"text":"adversarial_prompt: true"},{"id":"spn-66614","text":", "},{"id":"spn-66615","marks":["code"],"text":"separate_context: true"}]}],"id":"blk-56952","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56954","kind":"paragraph","spans":[{"id":"spn-66616","text":"2. "},{"id":"spn-66617","marks":["bold"],"text":"Implement iteration loop"},{"id":"spn-66618","text":" (section 6.3)"}]},{"id":"blk-56955","items":[{"blocks":[{"id":"blk-56957","kind":"paragraph","spans":[{"id":"spn-66619","text":"Generator implements → evaluator grades → if fail, feedback to generator → repeat"}]}],"id":"blk-56956","kind":"list-item"},{"blocks":[{"id":"blk-56959","kind":"paragraph","spans":[{"id":"spn-66620","text":"Up to "},{"id":"spn-66621","marks":["code"],"text":"max_iterations_per_sprint"},{"id":"spn-66622","text":" (tier-dependent: 2/3/5)"}]}],"id":"blk-56958","kind":"list-item"},{"blocks":[{"id":"blk-56961","kind":"paragraph","spans":[{"id":"spn-66623","text":"On max iterations reached → escalate to human"}]}],"id":"blk-56960","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56962","kind":"heading","level":3,"spans":[{"id":"spn-66624","text":"Phase 3: Contract Validator (weeks 5-7)"}]},{"id":"blk-56963","kind":"paragraph","spans":[{"id":"spn-66625","text":"1. "},{"id":"spn-66626","marks":["bold"],"text":"Implement ContractValidator"},{"id":"spn-66627","text":" ("},{"id":"spn-66628","marks":["code"],"text":"harness/contract_validator.ex"},{"id":"spn-66629","text":")"}]},{"id":"blk-56964","items":[{"blocks":[{"id":"blk-56966","kind":"paragraph","spans":[{"id":"spn-66630","marks":["code"],"text":"validate/2"},{"id":"spn-66631","text":" — validate action against governance block"}]}],"id":"blk-56965","kind":"list-item"},{"blocks":[{"id":"blk-56968","kind":"paragraph","spans":[{"id":"spn-66632","text":"Hard constraints → "},{"id":"spn-66633","marks":["code"],"text":":block"},{"id":"spn-66634","text":" (inviolable)"}]}],"id":"blk-56967","kind":"list-item"},{"blocks":[{"id":"blk-56970","kind":"paragraph","spans":[{"id":"spn-66635","text":"Soft constraints → "},{"id":"spn-66636","marks":["code"],"text":":allow"},{"id":"spn-66637","text":" with warnings"}]}],"id":"blk-56969","kind":"list-item"},{"blocks":[{"id":"blk-56972","kind":"paragraph","spans":[{"id":"spn-66638","text":"Escalation triggers → "},{"id":"spn-66639","marks":["code"],"text":":escalate"},{"id":"spn-66640","text":" (confidence_below, cost_exceeds_usd)"}]}],"id":"blk-56971","kind":"list-item"},{"blocks":[{"id":"blk-56974","kind":"paragraph","spans":[{"id":"spn-66641","text":"Confidence-gated execution (section 7.3)"}]}],"id":"blk-56973","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56975","kind":"paragraph","spans":[{"id":"spn-66642","text":"2. "},{"id":"spn-66643","marks":["bold"],"text":"Parse [&] governance blocks"},{"id":"spn-66644","text":" from "},{"id":"spn-66645","marks":["code"],"text":"ampersand.json"}]},{"id":"blk-56976","items":[{"blocks":[{"id":"blk-56978","kind":"paragraph","spans":[{"id":"spn-66646","text":"Hard/soft constraint extraction"}]}],"id":"blk-56977","kind":"list-item"},{"blocks":[{"id":"blk-56980","kind":"paragraph","spans":[{"id":"spn-66647","text":"Escalation rule extraction"}]}],"id":"blk-56979","kind":"list-item"},{"blocks":[{"id":"blk-56982","kind":"paragraph","spans":[{"id":"spn-66648","text":"Autonomy level caps"}]}],"id":"blk-56981","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56983","kind":"heading","level":3,"spans":[{"id":"spn-66649","text":"Phase 4: Sprint Controller (weeks 7-10)"}]},{"id":"blk-56984","kind":"paragraph","spans":[{"id":"spn-66650","text":"1. "},{"id":"spn-66651","marks":["bold"],"text":"Implement SprintController"},{"id":"spn-66652","text":" ("},{"id":"spn-66653","marks":["code"],"text":"harness/sprint_controller.ex"},{"id":"spn-66654","text":") as GenStateMachine"}]},{"id":"blk-56985","items":[{"blocks":[{"id":"blk-56987","kind":"paragraph","spans":[{"id":"spn-66655","text":"States: "},{"id":"spn-66656","marks":["code"],"text":"planned → generating → evaluating → passed → feedback → committed → escalated → completed"}]}],"id":"blk-56986","kind":"list-item"},{"blocks":[{"id":"blk-56989","kind":"paragraph","spans":[{"id":"spn-66657","text":"Sprint contract production (section 9.2)"}]}],"id":"blk-56988","kind":"list-item"},{"blocks":[{"id":"blk-56991","kind":"paragraph","spans":[{"id":"spn-66658","text":"Planner → generator → evaluator routing"}]}],"id":"blk-56990","kind":"list-item"},{"blocks":[{"id":"blk-56993","kind":"paragraph","spans":[{"id":"spn-66659","text":"Iteration tracking with budget enforcement"}]}],"id":"blk-56992","kind":"list-item"},{"blocks":[{"id":"blk-56995","kind":"paragraph","spans":[{"id":"spn-66660","text":"Git commit integration on sprint pass"}]}],"id":"blk-56994","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56996","kind":"paragraph","spans":[{"id":"spn-66661","text":"2. "},{"id":"spn-66662","marks":["bold"],"text":"Implement the three agent roles"},{"id":"spn-66663","text":" (section 4)"}]},{"id":"blk-56997","items":[{"blocks":[{"id":"blk-56999","kind":"paragraph","spans":[{"id":"spn-66664","text":"Planner: "},{"id":"spn-66665","marks":["code"],"text":"&reason.plan"},{"id":"spn-66666","text":" contract — decompose task → sprint specs"}]}],"id":"blk-56998","kind":"list-item"},{"blocks":[{"id":"blk-57001","kind":"paragraph","spans":[{"id":"spn-66667","text":"Generator: "},{"id":"spn-66668","marks":["code"],"text":"&reason.generate"},{"id":"spn-66669","text":" contract — implement sprint"}]}],"id":"blk-57000","kind":"list-item"},{"blocks":[{"id":"blk-57003","kind":"paragraph","spans":[{"id":"spn-66670","text":"Evaluator: "},{"id":"spn-66671","marks":["code"],"text":"&reason.evaluate"},{"id":"spn