{"bendscript":"0.1","blocks":[{"id":"blk-43323","kind":"heading","level":1,"spans":[{"id":"spn-71121","text":"04 — Runtime Providers"}]},{"blocks":[{"id":"blk-43325","kind":"paragraph","spans":[{"id":"spn-71122","marks":["bold"],"text":"Purpose:"},{"id":"spn-71123","text":" How the Runtime Provider Interface (RPI) abstracts execution across Cloudflare Workers/DO and AWS Bedrock AgentCore. Covers the adapter contracts for deploy, invoke, and healthcheck, plus session mapping and secrets injection."}]}],"id":"blk-43324","kind":"quote"},{"id":"blk-43326","kind":"heading","level":2,"spans":[{"id":"spn-71124","text":"RPI Overview"}]},{"id":"blk-43327","kind":"paragraph","spans":[{"id":"spn-71125","text":"The "},{"id":"spn-71126","marks":["bold"],"text":"Runtime Provider Interface"},{"id":"spn-71127","text":" is the abstraction boundary between the control plane and data plane. Every provider adapter implements the same contract so the control plane can deploy, invoke, and monitor agents identically regardless of where they execute."}]},{"id":"blk-43328","kind":"heading","level":2,"spans":[{"id":"spn-71128","text":"Required Adapter Methods"}]},{"head":[{"id":"blk-43330","spans":[{"id":"spn-71129","text":"Method"}]},{"id":"blk-43331","spans":[{"id":"spn-71130","text":"Signature"}]},{"id":"blk-43332","spans":[{"id":"spn-71131","text":"Purpose"}]}],"id":"blk-43329","kind":"table","rows":[[{"id":"blk-43333","spans":[{"id":"spn-71132","marks":["code"],"text":"deploy"}]},{"id":"blk-43334","spans":[{"id":"spn-71133","marks":["code"],"text":"(input: DeployInput) -> DeployOutput"}]},{"id":"blk-43335","spans":[{"id":"spn-71134","text":"Deploy code to provider"}]}],[{"id":"blk-43336","spans":[{"id":"spn-71135","marks":["code"],"text":"invoke"}]},{"id":"blk-43337","spans":[{"id":"spn-71136","marks":["code"],"text":"(input: InvokeInput) -> InvokeOutput"}]},{"id":"blk-43338","spans":[{"id":"spn-71137","text":"Execute agent (optionally streaming)"}]}],[{"id":"blk-43339","spans":[{"id":"spn-71138","marks":["code"],"text":"healthcheck"}]},{"id":"blk-43340","spans":[{"id":"spn-71139","marks":["code"],"text":"() -> HealthStatus"}]},{"id":"blk-43341","spans":[{"id":"spn-71140","text":"Check provider availability"}]}],[{"id":"blk-43342","spans":[{"id":"spn-71141","marks":["code"],"text":"estimateCost"}]},{"id":"blk-43343","spans":[{"id":"spn-71142","marks":["code"],"text":"(usage: UsageMetrics) -> number"}]},{"id":"blk-43344","spans":[{"id":"spn-71143","text":"Estimate cost in USD"}]}]]},{"id":"blk-43345","kind":"heading","level":2,"spans":[{"id":"spn-71144","text":"Deploy Contract"}]},{"id":"blk-43346","kind":"heading","level":3,"spans":[{"id":"spn-71145","text":"Input"}]},{"id":"blk-43347","kind":"code","language":"typescript","text":"interface DeployInput {\n  agentId: string;\n  userId: string;\n  deploymentId: string;\n  version: number;\n  artifact: ArtifactRef;       // uploaded_bundle or agentcore_container\n  envConfig: Record<string, string>;  // non-secret config\n  secretKeys: string[];        // values already in provider secret store\n}"},{"id":"blk-43348","kind":"heading","level":3,"spans":[{"id":"spn-71146","text":"Output"}]},{"id":"blk-43349","kind":"code","language":"typescript","text":"interface DeployOutput {\n  providerRef: Record<string, unknown>;  // sufficient to invoke\n  sessionConfig?: Record<string, unknown>;\n  status: \"success\" | \"failed\";\n  error?: NormalizedError;\n}"},{"id":"blk-43350","kind":"heading","level":2,"spans":[{"id":"spn-71147","text":"Invoke Contract"}]},{"id":"blk-43351","kind":"heading","level":3,"spans":[{"id":"spn-71148","text":"Input"}]},{"id":"blk-43352","kind":"code","language":"typescript","text":"interface InvokeInput {\n  deploymentRef: Record<string, unknown>;  // from DeployOutput.providerRef\n  input: { messages: Message[] };\n  sessionId?: string;\n  options?: InvokeOptions;\n  traceId: string;\n}"},{"id":"blk-43353","kind":"heading","level":3,"spans":[{"id":"spn-71149","text":"Output"}]},{"id":"blk-43354","kind":"code","language":"typescript","text":"interface InvokeOutput {\n  output: { text: string; messages?: Message[] };\n  sessionId?: string;\n  usage: { tokens?: number; computeMs?: number; toolCalls?: number };\n  traceId: string;\n  error?: NormalizedError;\n}"},{"id":"blk-43355","kind":"paragraph","spans":[{"id":"spn-71150","marks":["bold"],"text":"Rule:"},{"id":"spn-71151","text":" Adapters must enforce internal timeouts. Never block indefinitely."}]},{"id":"blk-43356","kind":"heading","level":2,"spans":[{"id":"spn-71152","text":"Cloudflare Workers/DO Adapter"}]},{"id":"blk-43357","kind":"heading","level":3,"spans":[{"id":"spn-71153","text":"Execution Model"}]},{"id":"blk-43358","items":[{"blocks":[{"id":"blk-43360","kind":"paragraph","spans":[{"id":"spn-71154","text":"Worker receives invocation and routes to a Durable Object for stateful sessions."}]}],"id":"blk-43359","kind":"list-item"},{"blocks":[{"id":"blk-43362","kind":"paragraph","spans":[{"id":"spn-71155","text":"DO stores conversation history and session state."}]}],"id":"blk-43361","kind":"list-item"},{"blocks":[{"id":"blk-43364","kind":"paragraph","spans":[{"id":"spn-71156","text":"Worker/DO calls the model provider (BYOK credentials)."}]}],"id":"blk-43363","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43365","kind":"heading","level":3,"spans":[{"id":"spn-71157","text":"Session Mapping"}]},{"head":[{"id":"blk-43367","spans":[{"id":"spn-71158","text":"Scenario"}]},{"id":"blk-43368","spans":[{"id":"spn-71159","text":"Behavior"}]}],"id":"blk-43366","kind":"table","rows":[[{"id":"blk-43369","spans":[{"id":"spn-71160","marks":["code"],"text":"sessionId"},{"id":"spn-71161","text":" provided"}]},{"id":"blk-43370","spans":[{"id":"spn-71162","text":"Route to existing DO instance"}]}],[{"id":"blk-43371","spans":[{"id":"spn-71163","marks":["code"],"text":"sessionId"},{"id":"spn-71164","text":" absent"}]},{"id":"blk-43372","spans":[{"id":"spn-71165","text":"Create new DO instance, return its ID"}]}]]},{"id":"blk-43373","kind":"heading","level":3,"spans":[{"id":"spn-71166","text":"Deploy Steps"}]},{"id":"blk-43374","items":[{"blocks":[{"id":"blk-43376","kind":"paragraph","spans":[{"id":"spn-71167","text":"Bundle user code as a Worker script"}]}],"id":"blk-43375","kind":"list-item"},{"blocks":[{"id":"blk-43378","kind":"paragraph","spans":[{"id":"spn-71168","text":"Configure Durable Object bindings (if sessionful)"}]}],"id":"blk-43377","kind":"list-item"},{"blocks":[{"id":"blk-43380","kind":"paragraph","spans":[{"id":"spn-71169","text":"Set secrets via Cloudflare API (telemetry key + user secrets)"}]}],"id":"blk-43379","kind":"list-item"},{"blocks":[{"id":"blk-43382","kind":"paragraph","spans":[{"id":"spn-71170","text":"Deploy via Cloudflare Workers API"}]}],"id":"blk-43381","kind":"list-item"},{"blocks":[{"id":"blk-43384","kind":"paragraph","spans":[{"id":"spn-71171","text":"Return "},{"id":"spn-71172","marks":["code"],"text":"providerRef: { workerName, scriptId, route }"}]}],"id":"blk-43383","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43385","kind":"heading","level":3,"spans":[{"id":"spn-71173","text":"Secrets"}]},{"id":"blk-43386","kind":"paragraph","spans":[{"id":"spn-71174","text":"Secrets are bound as Worker secrets at deploy time. The control plane calls the Cloudflare Secrets API -- plaintext values never persist in the control plane DB."}]},{"id":"blk-43387","kind":"heading","level":3,"spans":[{"id":"spn-71175","text":"Telemetry"}]},{"id":"blk-43388","kind":"paragraph","spans":[{"id":"spn-71176","text":"After each invocation, the DO sends telemetry to the control plane:"}]},{"id":"blk-43389","kind":"code","language":"typescript","text":"{\n  agentId, deploymentId, userId,\n  requests: 1,\n  llm_tokens: 150,\n  compute_ms: 340,\n  errors: 0,\n  trace_id: \"tr_abc123\"\n}"},{"id":"blk-43390","kind":"heading","level":2,"spans":[{"id":"spn-71177","text":"AWS Bedrock AgentCore Adapter"}]},{"id":"blk-43391","kind":"heading","level":3,"spans":[{"id":"spn-71178","text":"Execution Model"}]},{"id":"blk-43392","items":[{"blocks":[{"id":"blk-43394","kind":"paragraph","spans":[{"id":"spn-71179","text":"Control plane deploys a container-based runtime via AWS SDK ("},{"id":"spn-71180","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-71181","text":")."}]}],"id":"blk-43393","kind":"list-item"},{"blocks":[{"id":"blk-43396","kind":"paragraph","spans":[{"id":"spn-71182","text":"Invocations use AgentCore runtime invoke APIs."}]}],"id":"blk-43395","kind":"list-item"},{"blocks":[{"id":"blk-43398","kind":"paragraph","spans":[{"id":"spn-71183","text":"Optional tools SDK ("},{"id":"spn-71184","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-71185","text":") for code interpreter, browser tools."}]}],"id":"blk-43397","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43399","kind":"heading","level":3,"spans":[{"id":"spn-71186","text":"Session Mapping"}]},{"head":[{"id":"blk-43401","spans":[{"id":"spn-71187","text":"Scenario"}]},{"id":"blk-43402","spans":[{"id":"spn-71188","text":"Behavior"}]}],"id":"blk-43400","kind":"table","rows":[[{"id":"blk-43403","spans":[{"id":"spn-71189","marks":["code"],"text":"sessionId"},{"id":"spn-71190","text":" provided"}]},{"id":"blk-43404","spans":[{"id":"spn-71191","text":"Resume AgentCore session"}]}],[{"id":"blk-43405","spans":[{"id":"spn-71192","marks":["code"],"text":"sessionId"},{"id":"spn-71193","text":" absent"}]},{"id":"blk-43406","spans":[{"id":"spn-71194","text":"Create/init new session, return session ID"}]}]]},{"id":"blk-43407","kind":"heading","level":3,"spans":[{"id":"spn-71195","text":"Deploy Steps"}]},{"id":"blk-43408","items":[{"blocks":[{"id":"blk-43410","kind":"paragraph","spans":[{"id":"spn-71196","text":"Build OCI container from uploaded bundle (see "},{"id":"spn-71197","marks":["code"],"text":"02_DEPLOYMENT_PIPELINE.md"},{"id":"spn-71198","text":")"}]}],"id":"blk-43409","kind":"list-item"},{"blocks":[{"id"