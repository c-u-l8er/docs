{"bendscript":"0.1","blocks":[{"id":"blk-43821","kind":"heading","level":1,"spans":[{"id":"spn-71606","text":"08 — [&] Protocol Integration"}]},{"blocks":[{"id":"blk-43823","kind":"paragraph","spans":[{"id":"spn-71607","marks":["bold"],"text":"Purpose:"},{"id":"spn-71608","text":" How WebHost.Systems integrates with the [&] Protocol ecosystem, including ampersand.json manifests, MCP sidecar orchestration, agent-to-agent skill routing, Delegatic governance, capability provider resolution, and hash-linked provenance in telemetry."}]}],"id":"blk-43822","kind":"quote"},{"id":"blk-43824","kind":"heading","level":2,"spans":[{"id":"spn-71609","text":"Overview"}]},{"id":"blk-43825","kind":"paragraph","spans":[{"id":"spn-71610","text":"WebHost.Systems is the "},{"id":"spn-71611","marks":["bold"],"text":"hosting layer"},{"id":"spn-71612","text":" for [&] Protocol agents. The platform extends the base agent deployment model with protocol-aware capabilities:"}]},{"id":"blk-43826","items":[{"blocks":[{"id":"blk-43828","kind":"paragraph","spans":[{"id":"spn-71613","marks":["bold"],"text":"Manifest validation"},{"id":"spn-71614","text":" -- "},{"id":"spn-71615","marks":["code"],"text":"ampersand.json"},{"id":"spn-71616","text":" alongside "},{"id":"spn-71617","marks":["code"],"text":"agent.config.json"}]}],"id":"blk-43827","kind":"list-item"},{"blocks":[{"id":"blk-43830","kind":"paragraph","spans":[{"id":"spn-71618","marks":["bold"],"text":"MCP sidecars"},{"id":"spn-71619","text":" -- Graphonomous, TickTickClock, and other MCP servers"}]}],"id":"blk-43829","kind":"list-item"},{"blocks":[{"id":"blk-43832","kind":"paragraph","spans":[{"id":"spn-71620","marks":["bold"],"text":"A2A routing"},{"id":"spn-71621","text":" -- Agent-to-agent skill invocation"}]}],"id":"blk-43831","kind":"list-item"},{"blocks":[{"id":"blk-43834","kind":"paragraph","spans":[{"id":"spn-71622","marks":["bold"],"text":"Governance"},{"id":"spn-71623","text":" -- Delegatic policy enforcement"}]}],"id":"blk-43833","kind":"list-item"},{"blocks":[{"id":"blk-43836","kind":"paragraph","spans":[{"id":"spn-71624","marks":["bold"],"text":"Provenance"},{"id":"spn-71625","text":" -- Hash-linked telemetry chain"}]}],"id":"blk-43835","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43837","kind":"heading","level":2,"spans":[{"id":"spn-71626","text":"ampersand.json Manifest"}]},{"id":"blk-43838","kind":"paragraph","spans":[{"id":"spn-71627","text":"Agents that participate in the [&] Protocol include an "},{"id":"spn-71628","marks":["code"],"text":"ampersand.json"},{"id":"spn-71629","text":" in their deployment bundle:"}]},{"id":"blk-43839","kind":"code","language":"json","text":"{\n  \"protocol\": \"ampersand/v1\",\n  \"identity\": {\n    \"name\": \"research-agent\",\n    \"capabilities\": [\"web-search\", \"summarization\"],\n    \"version\": \"1.0.0\"\n  },\n  \"mcp_sidecars\": [\n    { \"name\": \"graphonomous\", \"version\": \">=0.5.0\" },\n    { \"name\": \"ticktickclock\", \"version\": \">=0.2.0\" }\n  ],\n  \"a2a\": {\n    \"skills_offered\": [\"web-search\", \"document-analysis\"],\n    \"skills_consumed\": [\"code-execution\"]\n  },\n  \"governance\": {\n    \"delegatic_policy\": \"default-sandbox\",\n    \"max_delegation_depth\": 3\n  }\n}"},{"id":"blk-43840","kind":"heading","level":3,"spans":[{"id":"spn-71630","text":"Validation Rules"}]},{"id":"blk-43841","items":[{"blocks":[{"id":"blk-43843","kind":"paragraph","spans":[{"id":"spn-71631","text":"[ ] "},{"id":"spn-71632","marks":["code"],"text":"protocol"},{"id":"spn-71633","text":" field is "},{"id":"spn-71634","marks":["code"],"text":"ampersand/v1"}]}],"id":"blk-43842","kind":"list-item"},{"blocks":[{"id":"blk-43845","kind":"paragraph","spans":[{"id":"spn-71635","text":"[ ] "},{"id":"spn-71636","marks":["code"],"text":"identity.name"},{"id":"spn-71637","text":" matches the agent name"}]}],"id":"blk-43844","kind":"list-item"},{"blocks":[{"id":"blk-43847","kind":"paragraph","spans":[{"id":"spn-71638","text":"[ ] "},{"id":"spn-71639","marks":["code"],"text":"capabilities"},{"id":"spn-71640","text":" are from the registered capability set"}]}],"id":"blk-43846","kind":"list-item"},{"blocks":[{"id":"blk-43849","kind":"paragraph","spans":[{"id":"spn-71641","text":"[ ] "},{"id":"spn-71642","marks":["code"],"text":"mcp_sidecars"},{"id":"spn-71643","text":" reference known MCP server packages"}]}],"id":"blk-43848","kind":"list-item"},{"blocks":[{"id":"blk-43851","kind":"paragraph","spans":[{"id":"spn-71644","text":"[ ] "},{"id":"spn-71645","marks":["code"],"text":"governance.max_delegation_depth"},{"id":"spn-71646","text":" is within platform limits"}]}],"id":"blk-43850","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43852","kind":"heading","level":2,"spans":[{"id":"spn-71647","text":"MCP Sidecar Orchestration"}]},{"id":"blk-43853","kind":"paragraph","spans":[{"id":"spn-71648","text":"When an agent declares "},{"id":"spn-71649","marks":["code"],"text":"mcp_sidecars"},{"id":"spn-71650","text":", the platform provisions companion MCP servers alongside the agent runtime:"}]},{"id":"blk-43854","kind":"heading","level":3,"spans":[{"id":"spn-71651","text":"Lifecycle"}]},{"id":"blk-43855","kind":"code","language":"text","text":"1. Deploy validates ampersand.json sidecar declarations\n2. Platform resolves sidecar versions from registry\n3. Sidecar processes are started alongside agent runtime\n4. Agent communicates with sidecars via MCP protocol (stdio or HTTP)\n5. Sidecars share the agent's namespace but not its secrets"},{"id":"blk-43856","kind":"heading","level":3,"spans":[{"id":"spn-71652","text":"Supported Sidecars"}]},{"head":[{"id":"blk-43858","spans":[{"id":"spn-71653","text":"Sidecar"}]},{"id":"blk-43859","spans":[{"id":"spn-71654","text":"Purpose"}]}],"id":"blk-43857","kind":"table","rows":[[{"id":"blk-43860","spans":[{"id":"spn-71655","marks":["bold"],"text":"Graphonomous"}]},{"id":"blk-43861","spans":[{"id":"spn-71656","text":"Continual learning engine, knowledge graph"}]}],[{"id":"blk-43862","spans":[{"id":"spn-71657","marks":["bold"],"text":"TickTickClock"}]},{"id":"blk-43863","spans":[{"id":"spn-71658","text":"Temporal intelligence, scheduling"}]}],[{"id":"blk-43864","spans":[{"id":"spn-71659","marks":["bold"],"text":"GeoFleetic"}]},{"id":"blk-43865","spans":[{"id":"spn-71660","text":"Spatial intelligence"}]}]]},{"id":"blk-43866","kind":"heading","level":3,"spans":[{"id":"spn-71661","text":"Configuration"}]},{"id":"blk-43867","kind":"paragraph","spans":[{"id":"spn-71662","text":"Sidecar config is injected via environment variables:"}]},{"id":"blk-43868","kind":"code","language":"text","text":"GRAPHONOMOUS_MCP_URL=http://localhost:3100\nTICKTICKCLOCK_MCP_URL=http://localhost:3101"},{"id":"blk-43869","kind":"heading","level":2,"spans":[{"id":"spn-71663","text":"Agent-to-Agent (A2A) Skill Routing"}]},{"id":"blk-43870","kind":"paragraph","spans":[{"id":"spn-71664","text":"Agents can invoke skills offered by other agents within the same tenant:"}]},{"id":"blk-43871","kind":"code","language":"text","text":"Agent A (consumer) -> POST /functions/v1/a2a/invoke\n  {\n    \"skill\": \"code-execution\",\n    \"input\": { \"prompt\": \"Run this Python script...\" },\n    \"caller\": { \"agentId\": \"<agent-a-id>\", \"traceId\": \"tr_xyz\" }\n  }"},{"id":"blk-43872","kind":"heading","level":3,"spans":[{"id":"spn-71665","text":"Routing Logic"}]},{"id":"blk-43873","items":[{"blocks":[{"id":"blk-43875","kind":"paragraph","spans":[{"id":"spn-71666","text":"Resolve agents offering the requested skill (same user, status "},{"id":"spn-71667","marks":["code"],"text":"active"},{"id":"spn-71668","text":")"}]}],"id":"blk-43874","kind":"list-item"},{"blocks":[{"id":"blk-43877","kind":"paragraph","spans":[{"id":"spn-71669","text":"Select best match (priority: explicit preference, then capability score)"}]}],"id":"blk-43876","kind":"list-item"},{"blocks":[{"id":"blk-43879","kind":"paragraph","spans":[{"id":"spn-71670","text":"Invoke target agent via the standard invocation gateway"}]}],"id":"blk-43878","kind":"list-item"},{"blocks":[{"id":"blk-43881","kind":"paragraph","spans":[{"id":"spn-71671","text":"Return result to caller with provenance metadata"}]}],"id":"blk-43880","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43882","kind":"heading","level":3,"spans":[{"id":"spn-71672","text":"Constraints"}]},{"id":"blk-43883","items":[{"blocks":[{"id":"blk-43885","kind":"paragraph","spans":[{"id":"spn-71673","text":"A2A calls count toward both caller and callee usage quotas"}]}],"id":"blk-43884","kind":"list-item"},{"blocks":[{"id":"blk-43887","kind":"paragraph","spans":[{"id":"spn-71674","text":"Delegation depth is enforced per "},{"id":"spn-71675","marks":["code"],"text":"governance.max_delegation_depth"}]}],"id":"blk-43886","kind":"list-item"},{"blocks":[{"id":"blk-43889","kind":"paragraph","spans":[{"id":"spn-71676","text":"Circular delegation is detected and rejected"}]}],"id":"blk-43888","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43890","kind":"heading","level":2,"spans":[{"id":"spn-71677","text":"Delegatic Governance"}]},{"id":"blk-43891","kind":"paragraph","spans":[{"id":"spn-71678","text":"The [&] Protocol uses Delegatic for governance enforcement:"}]},{"head":[{"id":"blk-43893","spans":[{"id":"spn-71679","text":"Policy"}]},{"id":"blk-43894","spans":[{"id":"spn-71680","text":"Effect"}]}],"id":"blk-43892","kind":"table","rows":[[{"id":"blk-43895","spans":[{"id":"spn-71681","marks":["code"],"text":"default-sandbox"}]},{"id":"blk-43896","spans":[{"id":"spn-71682","text":"Agent can only access declared capabilities"}]}],[{"id":"blk-43897","spans":[{"id":"spn-71683","marks":["code"],"text":"strict-isolation"}]},{"id":"blk-43898","spans":[{"id":"spn-71684","text":"No A2A calls, no external network"}]}],[{"id":"blk-43899","spans":[{"id":"spn-71685","marks":["code"],"text":"supervised"}]},{"id":"blk-43900","spans":[{"id":"spn-71686","text":"A2A calls require explicit approval"}]}]]},{"id":"blk-43901","kind":"paragraph","spans":[{"id":"spn-71687","text":"Governance policies are evaluated at:"}]},{"id":"blk-43902","items":[{"blocks":[{"id":"blk-43904","kind":"paragraph","spans":[{"id":"spn-71688","marks":["bold"],"text":"Deploy time:"},{"id":"spn-71689","text":" Validate manifest against policy constraints"}]}],"id":"blk-43903","kind":"list-item"},{"blocks":[{"id":"blk-43906","kind":"paragraph","spans":[{"id":"spn-71690","marks":["bold"],"text":"Invoke time:"},{"id":"spn-71691","text":" Check delegation depth and capability scope"}]}],"id":"blk-43905","kind":"list-item"},{"blocks":[{"id":"blk-43908","kind":"paragraph","spans":[{"id":"spn-71692","marks":["bold"],"text":"A2A routing:"},{"id":"spn-71693","text":" Enforce caller/callee governance compatibility"}]}],"id":"blk-43907","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43909","kind":"heading","level":2,"spans":[{"id":"spn-71694","text":"Capability Provider Resolution"}]},{"id":"blk-43910","kind":"paragraph","spans":[{"id":"spn-71695","text":"When an agent declares capabilities it needs but does not implement, the platform resolves them from the capability registry:"}]},{"id":"blk-43911","kind":"code","language":"text","text":"Agent declares: skills_consumed: [\"code-execution\"]\nPlatform resolves: agent \"code-runner-v2\" offers \"code-execution\"\nRuntime wiring: inject provider endpoint into agent env"},{"id":"blk-43912","kind":"paragraph","spans":[{"id":"spn-71696","text":"Resolution happens at deploy time. The resolved provider mapping is stored in "},{"id":"spn-71697","marks":["code"],"text":"deployments.provider_ref"},{"id":"spn-71698","text":" alongside the runtime reference."}]},{"id":"blk-43913","kind":"heading","level":2,"spans":[{"id":"spn-71699","text":"Provenance in Telemetry"}]},{"id":"blk-43914","kind":"paragraph","spans":[{"id":"spn-71700","text":"[&] Protocol agents emit telemetry with hash-linked provenance:"}]},{"id":"blk-43915","kind":"code","language":"json","text":"{\n  \"trace_id\": \"tr_abc123\",\n  \"parent_trace_id\": \"tr_parent\",\n  \"provenance\": {\n    \"hash\": \"sha256:abcdef...\",\n    \"parent_hash\": \"sha256:012345...\",\n    \"protocol\": \"ampersand/v1\",\n    \"delegation_depth\": 1\n  }\n}"},{"id":"blk-43916","kind":"paragraph","spans":[{"id":"spn-71701","text":"Each telemetry event links to its parent via content hash, creating an auditable chain of agent interactions."}]},{"id":"blk-43917","kind":"heading","level":2,"spans":[{"id":"spn-71702","text":"Checklist"}]},{"id":"blk-43918","items":[{"blocks":[{"id":"blk-43920","kind":"paragraph","spans":[{"id":"spn-71703","text":"[ ] "},{"id":"spn-71704","marks":["code"],"text":"ampersand.json"},{"id":"spn-71705","text":" is validated during deployment"}]}],"id":"blk-43919","kind":"list-item"},{"blocks":[{"id":"blk-43922","kind":"paragraph","spans":[{"id":"spn-71706","text":"[ ] MCP sidecars are provisioned from the sidecar registry"}]}],"id":"blk-43921","kind":"list-item"},{"blocks":[{"id":"blk-43924","kind":"paragraph","spans":[{"id":"spn-71707","text":"[ ] Sidecar lifecycle is tied to agent deployment lifecycle"}]}],"id":"blk-43923","kind":"list-item"},{"blocks":[{"id":"blk-43926","kind":"paragraph","spans":[{"id":"spn-71708","text":"[ ] A2A routing respects governance policies"}]}],"id":"blk-43925","kind":"list-item"},{"blocks":[{"id":"blk-43928","kind":"paragraph","spans":[{"id":"spn-71709","text":"[ ] Delegation depth is tracked and enforced"}]}],"id":"blk-43927","kind":"list-item"},{"blocks":[{"id":"blk-43930","kind":"paragraph","spans":[{"id":"spn-71710","text":"[ ] Circular delegation is detected and rejected"}]}],"id":"blk-43929","kind":"list-item"},{"blocks":[{"id":"blk-43932","kind":"paragraph","spans":[{"id":"spn-71711","text":"[ ] Capability resolution happens at deploy time"}]}],"id":"blk-43931","kind":"list-item"},{"blocks":[{"id":"blk-43934","kind":"paragraph","spans":[{"id":"spn-71712","text":"[ ] Telemetry includes hash-linked provenance when [&] Protocol is active"}]}],"id":"blk-43933","kind":"list-item"},{"blocks":[{"id":"blk-43936","kind":"paragraph","spans":[{"id":"spn-71713","text":"[ ] A2A invocations count toward both caller and callee usage"}]}],"id":"blk-43935","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierakzyuth6ciuzdhw4ds4sja3w2wwdmgv7i4t2lowuj2de7d76wow3a","vocabulary":"ampersand.docs.fs.v1"}