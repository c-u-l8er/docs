id":"blk-982","kind":"heading","level":3,"spans":[{"id":"spn-1040","text":"4. Provenance is part of the protocol"}]},{"id":"blk-983","kind":"paragraph","spans":[{"id":"spn-1041","text":"A conforming implementation should preserve where context came from and how decisions were derived."}]},{"id":"blk-984","kind":"heading","level":3,"spans":[{"id":"spn-1042","text":"5. The protocol complements the ecosystem"}]},{"id":"blk-985","kind":"paragraph","spans":[{"id":"spn-1043","text":"[&] does not replace MCP or A2A."}]},{"id":"blk-986","kind":"paragraph","spans":[{"id":"spn-1044","text":"It compiles into them."}]},{"id":"blk-987","kind":"heading","level":2,"spans":[{"id":"spn-1045","text":"Roadmap"}]},{"id":"blk-988","kind":"paragraph","spans":[{"id":"spn-1046","text":"Roadmap (implementation phases):"}]},{"id":"blk-989","kind":"heading","level":3,"spans":[{"id":"spn-1047","text":"Phase 1 — adoption unblockers"}]},{"id":"blk-990","items":[{"blocks":[{"id":"blk-992","kind":"paragraph","spans":[{"id":"spn-1048","text":"quickstart docs with reproducible CLI output"}]}],"id":"blk-991","kind":"list-item"},{"blocks":[{"id":"blk-994","kind":"paragraph","spans":[{"id":"spn-1049","text":"escript build verification"}]}],"id":"blk-993","kind":"list-item"},{"blocks":[{"id":"blk-996","kind":"paragraph","spans":[{"id":"spn-1050","text":"provider "},{"id":"spn-1051","marks":["code"],"text":"auto"},{"id":"spn-1052","text":" resolution"}]}],"id":"blk-995","kind":"list-item"},{"blocks":[{"id":"blk-998","kind":"paragraph","spans":[{"id":"spn-1053","text":"second real provider resolver"}]}],"id":"blk-997","kind":"list-item"},{"blocks":[{"id":"blk-1000","kind":"paragraph","spans":[{"id":"spn-1054","text":"runtime governance enforcement"}]}],"id":"blk-999","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-1001","kind":"heading","level":3,"spans":[{"id":"spn-1055","text":"Phase 2 — protocol story hardening"}]},{"id":"blk-1002","items":[{"blocks":[{"id":"blk-1004","kind":"paragraph","