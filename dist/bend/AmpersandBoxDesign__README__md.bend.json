nd":"heading","level":3,"spans":[{"id":"spn-870","text":"4. Provenance is part of the protocol"}]},{"id":"blk-985","kind":"paragraph","spans":[{"id":"spn-871","text":"A conforming implementation should preserve where context came from and how decisions were derived."}]},{"id":"blk-986","kind":"heading","level":3,"spans":[{"id":"spn-872","text":"5. The protocol complements the ecosystem"}]},{"id":"blk-987","kind":"paragraph","spans":[{"id":"spn-873","text":"[&] does not replace MCP or A2A."}]},{"id":"blk-988","kind":"paragraph","spans":[{"id":"spn-874","text":"It compiles into them."}]},{"id":"blk-989","kind":"heading","level":2,"spans":[{"id":"spn-875","text":"Roadmap"}]},{"id":"blk-990","kind":"paragraph","spans":[{"id":"spn-876","text":"Roadmap (implementation phases):"}]},{"id":"blk-991","kind":"heading","level":3,"spans":[{"id":"spn-877","text":"Phase 1 — adoption unblockers"}]},{"id":"blk-992","items":[{"blocks":[{"id":"blk-994","kind":"paragraph","spans":[{"id":"spn-878","text":"quickstart docs with reproducible CLI output"}]}],"id":"blk-993","kind":"list-item"},{"blocks":[{"id":"blk-996","kind":"paragraph","spans":[{"id":"spn-879","text":"escript build verification"}]}],"id":"blk-995","kind":"list-item"},{"blocks":[{"id":"blk-998","kind":"paragraph","spans":[{"id":"spn-880","text":"provider "},{"id":"spn-881","marks":["code"],"text":"auto"},{"id":"spn-882","text":" resolution"}]}],"id":"blk-997","kind":"list-item"},{"blocks":[{"id":"blk-1000","kind":"paragraph","spans":[{"id":"spn-883","text":"second real provider resolver"}]}],"id":"blk-999","kind":"list-item"},{"blocks":[{"id":"blk-1002","kind":"paragraph","spans":[{"id":"spn-884","text":"runtime governance enforcement"}]}],"id":"blk-1001","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-1003","kind":"heading","level":3,"spans":[{"id":"spn-885","text":"Phase 2 — protocol story hardening"}]},{"id":"blk-1004","items":[{"blocks":[{"id":"blk-1006","kind":"paragraph","spans":[{"id":"spn-886","text":