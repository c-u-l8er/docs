{"bendscript":"0.1","blocks":[{"id":"blk-704","kind":"heading","level":1,"spans":[{"id":"spn-615","text":"[&] Protocol"}]},{"id":"blk-705","kind":"paragraph","spans":[{"id":"spn-616","text":"The "},{"id":"spn-617","marks":["bold"],"text":"[&] Protocol"},{"id":"spn-618","text":" is an open, language-agnostic specification for "},{"id":"spn-619","marks":["bold"],"text":"capability composition in AI agents"},{"id":"spn-620","text":"."}]},{"id":"blk-706","kind":"paragraph","spans":[{"id":"spn-621","text":"It defines how an agent declares:"}]},{"id":"blk-707","items":[{"blocks":[{"id":"blk-709","kind":"paragraph","spans":[{"id":"spn-622","text":"what it can "},{"id":"spn-623","marks":["bold"],"text":"remember"}]}],"id":"blk-708","kind":"list-item"},{"blocks":[{"id":"blk-711","kind":"paragraph","spans":[{"id":"spn-624","text":"how it can "},{"id":"spn-625","marks":["bold"],"text":"reason"}]}],"id":"blk-710","kind":"list-item"},{"blocks":[{"id":"blk-713","kind":"paragraph","spans":[{"id":"spn-626","text":"how it understands "},{"id":"spn-627","marks":["bold"],"text":"time"}]}],"id":"blk-712","kind":"list-item"},{"blocks":[{"id":"blk-715","kind":"paragraph","spans":[{"id":"spn-628","text":"how it understands "},{"id":"spn-629","marks":["bold"],"text":"space"}]}],"id":"blk-714","kind":"list-item"},{"blocks":[{"id":"blk-717","kind":"paragraph","spans":[{"id":"spn-630","text":"how it is "},{"id":"spn-631","marks":["bold"],"text":"embodied"},{"id":"spn-632","text":" — perception, action, affordance"}]}],"id":"blk-716","kind":"list-item"},{"blocks":[{"id":"blk-719","kind":"paragraph","spans":[{"id":"spn-633","text":"how those capabilities "},{"id":"spn-634","marks":["bold"],"text":"compose"}]}],"id":"blk-718","kind":"list-item"},{"blocks":[{"id":"blk-721","kind":"paragraph","spans":[{"id":"spn-635","text":"how decisions retain "},{"id":"spn-636","marks":["bold"],"text":"provenance"}]}],"id":"blk-720","kind":"list-item"},{"blocks":[{"id":"blk-723","kind":"paragraph","spans":[{"id":"spn-637","text":"how constraints are expressed as "},{"id":"spn-638","marks":["bold"],"text":"governance"}]}],"id":"blk-722","kind":"list-item"},{"blocks":[{"id":"blk-725","kind":"paragraph","spans":[{"id":"spn-639","text":"how declarations compile into "},{"id":"spn-640","marks":["bold"],"text":"MCP"},{"id":"spn-641","text":" and "},{"id":"spn-642","marks":["bold"],"text":"A2A"},{"id":"spn-643","text":" configurations"}]}],"id":"blk-724","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-726","kind":"paragraph","spans":[{"id":"spn-644","text":"The ampersand ("},{"id":"spn-645","marks":["code"],"text":"&"},{"id":"spn-646","text":") is not branding syntax. It is the protocol’s core operator for composition."}]},{"id":"blk-727","kind":"heading","level":2,"spans":[{"id":"spn-647","text":"Why this exists"}]},{"id":"blk-728","kind":"paragraph","spans":[{"id":"spn-648","text":"The current agent stack has useful protocol layers already:"}]},{"id":"blk-729","items":[{"blocks":[{"id":"blk-731","kind":"paragraph","spans":[{"id":"spn-649","marks":["bold"],"text":"MCP"},{"id":"spn-650","text":" for agent-to-tool connectivity"}]}],"id":"blk-730","kind":"list-item"},{"blocks":[{"id":"blk-733","kind":"paragraph","spans":[{"id":"spn-651","marks":["bold"],"text":"A2A"},{"id":"spn-652","text":" for agent-to-agent coordination"}]}],"id":"blk-732","kind":"list-item"},{"blocks":[{"id":"blk-735","kind":"paragraph","spans":[{"id":"spn-653","marks":["bold"],"text":"UI protocols"},{"id":"spn-654","text":" for rendering and interaction"}]}],"id":"blk-734","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-736","kind":"paragraph","spans":[{"id":"spn-655","text":"What is still missing is a shared way to describe "},{"id":"spn-656","marks":["bold"],"text":"how an agent’s cognitive capabilities fit together before runtime wiring begins"},{"id":"spn-657","text":"."}]},{"id":"blk-737","kind":"paragraph","spans":[{"id":"spn-658","text":"The [&] Protocol fills that gap."}]},{"id":"blk-738","kind":"paragraph","spans":[{"id":"spn-659","text":"It provides a source-of-truth artifact, "},{"id":"spn-660","marks":["code"],"text":"ampersand.json"},{"id":"spn-661","text":", that can be:"}]},{"id":"blk-739","items":[{"blocks":[{"id":"blk-741","kind":"paragraph","spans":[{"id":"spn-662","text":"validated against a schema"}]}],"id":"blk-740","kind":"list-item"},{"blocks":[{"id":"blk-743","kind":"paragraph","spans":[{"id":"spn-663","text":"checked for composition correctness"}]}],"id":"blk-742","kind":"list-item"},{"blocks":[{"id":"blk-745","kind":"paragraph","spans":[{"id":"spn-664","text":"transformed into runtime configuration"}]}],"id":"blk-744","kind":"list-item"},{"blocks":[{"id":"blk-747","kind":"paragraph","spans":[{"id":"spn-665","text":"audited through provenance metadata"}]}],"id":"blk-746","kind":"list-item"},{"blocks":[{"id":"blk-749","kind":"paragraph","spans":[{"id":"spn-666","text":"extended across implementations and providers"}]}],"id":"blk-748","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-750","kind":"paragraph","spans":[{"id":"spn-667","text":"In short:"}]},{"blocks":[{"id":"blk-752","kind":"paragraph","spans":[{"id":"spn-668","text":"MCP defines how agents call tools.   A2A defines how agents call agents.   [&] defines how capabilities compose into a coherent agent."}]}],"id":"blk-751","kind":"quote"},{"id":"blk-753","kind":"heading","level":2,"spans":[{"id":"spn-669","text":"Core model"}]},{"id":"blk-754","kind":"paragraph","spans":[{"id":"spn-670","text":"The protocol starts from six capability primitives:"}]},{"id":"blk-755","items":[{"blocks":[{"id":"blk-757","kind":"paragraph","spans":[{"id":"spn-671","marks":["code"],"text":"&memory"},{"id":"spn-672","text":" — what the agent knows"}]}],"id":"blk-756","kind":"list-item"},{"blocks":[{"id":"blk-759","kind":"paragraph","spans":[{"id":"spn-673","marks":["code"],"text":"&reason"},{"id":"spn-674","text":" — how the agent decides"}]}],"id":"blk-758","kind":"list-item"},{"blocks":[{"id":"blk-761","kind":"paragraph","spans":[{"id":"spn-675","marks":["code"],"text":"&time"},{"id":"spn-676","text":" — when things happen"}]}],"id":"blk-760","kind":"list-item"},{"blocks":[{"id":"blk-763","kind":"paragraph","spans":[{"id":"spn-677","marks":["code"],"text":"&space"},{"id":"spn-678","text":" — where things are"}]}],"id":"blk-762","kind":"list-item"},{"blocks":[{"id":"blk-765","kind":"paragraph","spans":[{"id":"spn-679","marks":["code"],"text":"&body"},{"id":"spn-680","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-764","kind":"list-item"},{"blocks":[{"id":"blk-767","kind":"paragraph","spans":[{"id":"spn-681","marks":["code"],"text":"&govern"},{"id":"spn-682","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-768","kind":"paragraph","spans":[{"id":"spn-683","text":"Each primitive can be refined with namespaced subtypes:"}]},{"id":"blk-769","items":[{"blocks":[{"id":"blk-771","kind":"paragraph","spans":[{"id":"spn-684","marks":["code"],"text":"&memory.graph"}]}],"id":"blk-770","kind":"list-item"},{"blocks":[{"id":"blk-773","kind":"paragraph","spans":[{"id":"spn-685","marks":["code"],"text":"&memory.episodic"}]}],"id":"blk-772","kind":"list-item"},{"blocks":[{"id":"blk-775","kind":"paragraph","spans":[{"id":"spn-686","marks":["code"],"text":"&reason.argument"}]}],"id":"blk-774","kind":"list-item"},{"blocks":[{"id":"blk-777","kind":"paragraph","spans":[{"id":"spn-687","marks":["code"],"text":"&reason.vote"}]}],"id":"blk-776","kind":"list-item"},{"blocks":[{"id":"blk-779","kind":"paragraph","spans":[{"id":"spn-688","marks":["code"],"text":"&reason.plan"}]}],"id":"blk-778","kind":"list-item"},{"blocks":[{"id":"blk-781","kind":"paragraph","spans":[{"id":"spn-689","marks":["code"],"text":"&reason.chain"}]}],"id":"blk-780","kind":"list-item"},{"blocks":[{"id":"blk-783","kind":"paragraph","spans":[{"id":"spn-690","marks":["code"],"text":"&reason.deliberate"}]}],"id":"blk-782","kind":"list-item"},{"blocks":[{"id":"blk-785","kind":"paragraph","spans":[{"id":"spn-691","marks":["code"],"text":"&reason.attend"}]}],"id":"blk-784","kind":"list-item"},{"blocks":[{"id":"blk-787","kind":"paragraph","spans":[{"id":"spn-692","marks":["code"],"text":"&time.anomaly"}]}],"id":"blk-786","kind":"list-item"},{"blocks":[{"id":"blk-789","kind":"paragraph","spans":[{"id":"spn-693","marks":["code"],"text":"&time.forecast"}]}],"id":"blk-788","kind":"list-item"},{"blocks":[{"id":"blk-791","kind":"paragraph","spans":[{"id":"spn-694","marks":["code"],"text":"&space.fleet"}]}],"id":"blk-790","kind":"list-item"},{"blocks":[{"id":"blk-793","kind":"paragraph","spans":[{"id":"spn-695","marks":["code"],"text":"&space.route"}]}],"id":"blk-792","kind":"list-item"},{"blocks":[{"id":"blk-795","kind":"paragraph","spans":[{"id":"spn-696","marks":["code"],"text":"&body.browser"}]}],"id":"blk-794","kind":"list-item"},{"blocks":[{"id":"blk-797","kind":"paragraph","spans":[{"id":"spn-697","marks":["code"],"text":"&body.os"}]}],"id":"blk-796","kind":"list-item"},{"blocks":[{"id":"blk-799","kind":"paragraph","spans":[{"id":"spn-698","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-798","kind":"list-item"},{"blocks":[{"id":"blk-801","kind":"paragraph","spans":[{"id":"spn-699","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-800","kind":"list-item"},{"blocks":[{"id":"blk-803","kind":"paragraph","spans":[{"id":"spn-700","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-802","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-804","kind":"paragraph","spans":[{"id":"spn-701","text":"The protocol has exactly six primitive roots ("},{"id":"spn-702","marks":["code"],"text":"&memory"},{"id":"spn-703","text":", "},{"id":"spn-704","marks":["code"],"text":"&reason"},{"id":"spn-705","text":", "},{"id":"spn-706","marks":["code"],"text":"&time"},{"id":"spn-707","text":", "},{"id":"spn-708","marks":["code"],"text":"&space"},{"id":"spn-709","text":", "},{"id":"spn-710","marks":["code"],"text":"&body"},{"id":"spn-711","text":", "},{"id":"spn-712","marks":["code"],"text":"&govern"},{"id":"spn-713","text":"). Topology analysis and κ-routing are derived operations from "},{"id":"spn-714","marks":["code"],"text":"&memory.graph"},{"id":"spn-715","text":", not a separate primitive. "},{"id":"spn-716","marks":["code"],"text":"&body"},{"id":"spn-717","text":" is the sensorimotor primitive added in draft v0.1.0; see OS-011 (Embodiment Protocol) for the behavioral loop that consumes it."}]},{"id":"blk-805","kind":"paragraph","spans":[{"id":"spn-718","text":"Composition is defined with two operators:"}]},{"id":"blk-806","items":[{"blocks":[{"id":"blk-808","kind":"paragraph","spans":[{"id":"spn-719","marks":["code"],"text":"&"},{"id":"spn-720","text":" — combine capabilities into a set"}]}],"id":"blk-807","kind":"list-item"},{"blocks":[{"id":"blk-810","kind":"paragraph","spans":[{"id":"spn-721","marks":["code"],"text":"|>"},{"id":"spn-722","text":" — flow data through capability operations"}]}],"id":"blk-809","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-811","kind":"heading","level":2,"spans":[{"id":"spn-723","text":"Example declaration"}]},{"id":"blk-812","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"InfraOperator\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": { \"instance\": \"infra-ops\" }\n    },\n    \"&time.anomaly\": {\n      \"provider\": \"ticktickclock\",\n      \"config\": { \"streams\": [\"cpu\", \"mem\"] }\n    },\n    \"&space.fleet\": {\n      \"provider\": \"geofleetic\",\n      \"config\": { \"regions\": [\"us-east\"] }\n    },\n    \"&reason.argument\": {\n      \"provider\": \"deliberatic\",\n      \"config\": { \"governance\": \"constitutional\" }\n    },\n    \"&reason.deliberate\": {\n      \"provider\": \"graphonomous\",\n      \"config\": { \"budget\": \"kappa\" }\n    },\n    \"&reason.attend\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  },\n  \"governance\": {\n    \"hard\": [\"Never scale beyond 3x in a single action\"],\n    \"soft\": [\"Prefer gradual scaling over spikes\"],\n    \"escalate_when\": {\n      \"confidence_below\": 0.7,\n      \"cost_exceeds_usd\": 1000\n    },\n    \"autonomy\": {\n      \"level\": \"advise\",\n      \"model_tier\": \"local_small\",\n      \"heartbeat_seconds\": 300,\n      \"budget\": {\n        \"max_actions_per_hour\": 5,\n        \"max_deliberation_calls_per_query\": 1,\n        \"require_approval_for\": [\"act\", \"propose\"]\n      }\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-813","kind":"heading","level":2,"spans":[{"id":"spn-724","text":"What the repository contains"}]},{"id":"blk-814","kind":"paragraph","spans":[{"id":"spn-725","text":"This repository is the canonical home for the protocol and its reference artifacts."}]},{"id":"blk-815","kind":"heading","level":3,"spans":[{"id":"spn-726","text":"Specification"}]},{"id":"blk-816","items":[{"blocks":[{"id":"blk-818","kind":"paragraph","spans":[{"id":"spn-727","marks":["code"],"text":"site/protocol.html"},{"id":"spn-728","text":" — current HTML specification"}]}],"id":"blk-817","kind":"list-item"},{"blocks":[{"id":"blk-820","kind":"paragraph","spans":[{"id":"spn-729","marks":["code"],"text":"SPEC.md"},{"id":"spn-730","text":" — markdown protocol specification"}]}],"id":"blk-819","kind":"list-item"},{"blocks":[{"id":"blk-822","kind":"paragraph","spans":[{"id":"spn-731","marks":["code"],"text":"prompts/PROTOCOL_PROMPT.md"},{"id":"spn-732","text":" — implementation-oriented protocol prompt"}]}],"id":"blk-821","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-823","kind":"heading","level":3,"spans":[{"id":"spn-733","text":"Schemas"}]}