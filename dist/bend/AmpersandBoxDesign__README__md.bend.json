tml"}]}],"id":"blk-943","kind":"list-item"},{"blocks":[{"id":"blk-946","kind":"paragraph","spans":[{"id":"spn-829","marks":["code"],"text":"site/portfolio_company_complete_research.html"}]}],"id":"blk-945","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-947","kind":"heading","level":2,"spans":[{"id":"spn-830","text":"Quick start"}]},{"blocks":[{"id":"blk-949","kind":"paragraph","spans":[{"id":"spn-831","marks":["bold"],"text":"Note — the `box-and-box` name."},{"id":"spn-832","text":" It now belongs to the "},{"id":"spn-833","marks":["bold"],"text":"governance kernel"},{"id":"spn-834","text":" of the [&] stack (the eight-rung arithmetic ladder · 103 property-tested laws — see "},{"id":"spn-835","marks":["code"],"text":"opensentience.org/box-and-box/"},{"id":"spn-836","text":" and "},{"id":"spn-837","marks":["code"],"text":"https://ampersandboxdesign.com"},{"id":"spn-838","text":"). The previous "},{"id":"spn-839","marks":["code"],"text":"box-and-box"},{"id":"spn-840","text":" — the v0.1.0 [&] Protocol validator/composer MCP server — was removed in the clean-break stack upgrade. Validate and compose "},{"id":"spn-841","marks":["code"],"text":"*.ampersand.json"},{"id":"spn-842","text":" specs via the Elixir reference CLI (below) or the language SDKs instead."}]}],"id":"blk-948","kind":"quote"},{"id":"blk-950","kind":"heading","level":3,"spans":[{"id":"spn-843","text":"Option A — MCP servers (three-protocol stack)"}]},{"id":"blk-951","kind":"paragraph","spans":[{"id":"spn-844","text":"The [&] ecosystem ships three MCP servers, each installing identically with "},{"id":"spn-845","marks":["code"],"text":"npx"},{"id":"spn-846","text":" and carrying its own embedded SQLite + sqlite-vec database:"}]},{"id":"blk-952","kind":"code","language":"jsonc","text":"// .mcp.json\n{\n  \"mcpServers\": {\n    \"graphonomous\": { \"command\": \"npx\", \"args\": [\"-y\", \"graphonomous\", \"--db\", \"~/.graphonomous/knowledge.db\"] },\n    \"prism\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-prism\",     \"--db\", \"~/.os-prism/benchmarks.db\"] },\n    \"pulse\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-pulse\",     \"--db\", \"~/.os-pulse/manifests.db\"] }\n  }\n}"},{"id":"blk-953","kind":"heading","level":3,"spans":[{"id":"spn-847","text":"Option B — Elixir reference CLI (for protocol development)"}]},{"id":"blk-954","kind":"code","language":"bash","text":"cd reference/elixir/ampersand_core\nmix escript.build\n./ampersand validate ../../../examples/infra-operator.ampersand.json"},{"id":"blk-955","kind":"heading","level":3,"spans":[{"id":"spn-848","text":"2. Check composition"}]},{"id":"blk-956","kind":"code","language":"bash","text":"./ampersand compose ../../../examples/infra-operator.ampersand.json"},{"id":"blk-957","kind":"heading","level":3,"spans":[{"id":"spn-849","text":"3. Generate MCP config"}]},{"id":"blk-958","kind":"code","language":"bash","text":"./ampersand generate mcp ../../../examples/infra-operator.ampersand.json"},{"id":"blk-959","kind":"heading","level":3,"spans":[{"id":"spn-850","text":"4. Generate an A2A agent card"}]},{"id":"blk-960","kind":"code","language":"bash","text":"./ampersand generate a2a ../../../examples/infra-operator.ampersand.json"},{"id":"blk-961","kind":"heading","level":2,"spans":[{"id":"spn-851","text":"Current implementation status"}]},{"id":"blk-962","kind":"paragraph","spans":[{"id":"spn-852","text":"The repository currently includes working foundations for:"}]},{"id":"blk-963","items":[{"blocks":[{"id":"blk-965","kind":"paragraph","spans":[{"id":"spn-853","text":"canonical protocol schema + contract + registry artifacts"}]}],"id":"blk-964","kind":"list-item"},{"blocks":[{"id":"blk-967","kind":"paragraph","spans":[{"id":"spn-854","text":"validating example declarations"}]}],"id":"blk-966","kind":"list-item"},{"blocks":[{"id":"blk-969","kind":"paragraph","spans":[{"id":"spn-855","text":"Elixir reference runtime (validation, composition algebra, contract checks, run