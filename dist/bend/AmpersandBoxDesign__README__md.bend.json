{"bendscript":"0.1","blocks":[{"id":"blk-702","kind":"heading","level":1,"spans":[{"id":"spn-785","text":"[&] Protocol"}]},{"id":"blk-703","kind":"paragraph","spans":[{"id":"spn-786","text":"The "},{"id":"spn-787","marks":["bold"],"text":"[&] Protocol"},{"id":"spn-788","text":" is an open, language-agnostic specification for "},{"id":"spn-789","marks":["bold"],"text":"capability composition in AI agents"},{"id":"spn-790","text":"."}]},{"id":"blk-704","kind":"paragraph","spans":[{"id":"spn-791","text":"It defines how an agent declares:"}]},{"id":"blk-705","items":[{"blocks":[{"id":"blk-707","kind":"paragraph","spans":[{"id":"spn-792","text":"what it can "},{"id":"spn-793","marks":["bold"],"text":"remember"}]}],"id":"blk-706","kind":"list-item"},{"blocks":[{"id":"blk-709","kind":"paragraph","spans":[{"id":"spn-794","text":"how it can "},{"id":"spn-795","marks":["bold"],"text":"reason"}]}],"id":"blk-708","kind":"list-item"},{"blocks":[{"id":"blk-711","kind":"paragraph","spans":[{"id":"spn-796","text":"how it understands "},{"id":"spn-797","marks":["bold"],"text":"time"}]}],"id":"blk-710","kind":"list-item"},{"blocks":[{"id":"blk-713","kind":"paragraph","spans":[{"id":"spn-798","text":"how it understands "},{"id":"spn-799","marks":["bold"],"text":"space"}]}],"id":"blk-712","kind":"list-item"},{"blocks":[{"id":"blk-715","kind":"paragraph","spans":[{"id":"spn-800","text":"how it is "},{"id":"spn-801","marks":["bold"],"text":"embodied"},{"id":"spn-802","text":" — perception, action, affordance"}]}],"id":"blk-714","kind":"list-item"},{"blocks":[{"id":"blk-717","kind":"paragraph","spans":[{"id":"spn-803","text":"how those capabilities "},{"id":"spn-804","marks":["bold"],"text":"compose"}]}],"id":"blk-716","kind":"list-item"},{"blocks":[{"id":"blk-719","kind":"paragraph","spans":[{"id":"spn-805","text":"how decisions retain "},{"id":"spn-806","marks":["bold"],"text":"provenance"}]}],"id":"blk-718","kind":"list-item"},{"blocks":[{"id":"blk-721","kind":"paragraph","spans":[{"id":"spn-807","text":"how constraints are expressed as "},{"id":"spn-808","marks":["bold"],"text":"governance"}]}],"id":"blk-720","kind":"list-item"},{"blocks":[{"id":"blk-723","kind":"paragraph","spans":[{"id":"spn-809","text":"how declarations compile into "},{"id":"spn-810","marks":["bold"],"text":"MCP"},{"id":"spn-811","text":" and "},{"id":"spn-812","marks":["bold"],"text":"A2A"},{"id":"spn-813","text":" configurations"}]}],"id":"blk-722","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-724","kind":"paragraph","spans":[{"id":"spn-814","text":"The ampersand ("},{"id":"spn-815","marks":["code"],"text":"&"},{"id":"spn-816","text":") is not branding syntax. It is the protocol’s core operator for composition."}]},{"id":"blk-725","kind":"heading","level":2,"spans":[{"id":"spn-817","text":"Why this exists"}]},{"id":"blk-726","kind":"paragraph","spans":[{"id":"spn-818","text":"The current agent stack has useful protocol layers already:"}]},{"id":"blk-727","items":[{"blocks":[{"id":"blk-729","kind":"paragraph","spans":[{"id":"spn-819","marks":["bold"],"text":"MCP"},{"id":"spn-820","text":" for agent-to-tool connectivity"}]}],"id":"blk-728","kind":"list-item"},{"blocks":[{"id":"blk-731","kind":"paragraph","spans":[{"id":"spn-821","marks":["bold"],"text":"A2A"},{"id":"spn-822","text":" for agent-to-agent coordination"}]}],"id":"blk-730","kind":"list-item"},{"blocks":[{"id":"blk-733","kind":"paragraph","spans":[{"id":"spn-823","marks":["bold"],"text":"UI protocols"},{"id":"spn-824","text":" for rendering and interaction"}]}],"id":"blk-732","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-734","kind":"paragraph","spans":[{"id":"spn-825","text":"What is still missing is a shared way to describe "},{"id":"spn-826","marks":["bold"],"text":"how an agent’s cognitive capabilities fit together before runtime wiring begins"},{"id":"spn-827","text":"."}]},{"id":"blk-735","kind":"paragraph","spans":[{"id":"spn-828","text":"The [&] Protocol fills that gap."}]},{"id":"blk-736","kind":"paragraph","spans":[{"id":"spn-829","text":"It provides a source-of-truth artifact, "},{"id":"spn-830","marks":["code"],"text":"ampersand.json"},{"id":"spn-831","text":", that can be:"}]},{"id":"blk-737","items":[{"blocks":[{"id":"blk-739","kind":"paragraph","spans":[{"id":"spn-832","text":"validated against a schema"}]}],"id":"blk-738","kind":"list-item"},{"blocks":[{"id":"blk-741","kind":"paragraph","spans":[{"id":"spn-833","text":"checked for composition correctness"}]}],"id":"blk-740","kind":"list-item"},{"blocks":[{"id":"blk-743","kind":"paragraph","spans":[{"id":"spn-834","text":"transformed into runtime configuration"}]}],"id":"blk-742","kind":"list-item"},{"blocks":[{"id":"blk-745","kind":"paragraph","spans":[{"id":"spn-835","text":"audited through provenance metadata"}]}],"id":"blk-744","kind":"list-item"},{"blocks":[{"id":"blk-747","kind":"paragraph","spans":[{"id":"spn-836","text":"extended across implementations and providers"}]}],"id":"blk-746","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-748","kind":"paragraph","spans":[{"id":"spn-837","text":"In short:"}]},{"blocks":[{"id":"blk-750","kind":"paragraph","spans":[{"id":"spn-838","text":"MCP defines how agents call tools.   A2A defines how agents call agents.   [&] defines how capabilities compose into a coherent agent."}]}],"id":"blk-749","kind":"quote"},{"id":"blk-751","kind":"heading","level":2,"spans":[{"id":"spn-839","text":"Core model"}]},{"id":"blk-752","kind":"paragraph","spans":[{"id":"spn-840","text":"The protocol starts from six capability primitives:"}]},{"id":"blk-753","items":[{"blocks":[{"id":"blk-755","kind":"paragraph","spans":[{"id":"spn-841","marks":["code"],"text":"&memory"},{"id":"spn-842","text":" — what the agent knows"}]}],"id":"blk-754","kind":"list-item"},{"blocks":[{"id":"blk-757","kind":"paragraph","spans":[{"id":"spn-843","marks":["code"],"text":"&reason"},{"id":"spn-844","text":" — how the agent decides"}]}],"id":"blk-756","kind":"list-item"},{"blocks":[{"id":"blk-759","kind":"paragraph","spans":[{"id":"spn-845","marks":["code"],"text":"&time"},{"id":"spn-846","text":" — when things happen"}]}],"id":"blk-758","kind":"list-item"},{"blocks":[{"id":"blk-761","kind":"paragraph","spans":[{"id":"spn-847","marks":["code"],"text":"&space"},{"id":"spn-848","text":" — where things are"}]}],"id":"blk-760","kind":"list-item"},{"blocks":[{"id":"blk-763","kind":"paragraph","spans":[{"id":"spn-849","marks":["code"],"text":"&body"},{"id":"spn-850","text":" — how the agent is instantiated in an environment (perception, action, affordance)"}]}],"id":"blk-762","kind":"list-item"},{"blocks":[{"id":"blk-765","kind":"paragraph","spans":[{"id":"spn-851","marks":["code"],"text":"&govern"},{"id":"spn-852","text":" — who is acting, under what rules, at what cost"}]}],"id":"blk-764","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-766","kind":"paragraph","spans":[{"id":"spn-853","text":"Each primitive can be refined with namespaced subtypes:"}]},{"id":"blk-767","items":[{"blocks":[{"id":"blk-769","kind":"paragraph","spans":[{"id":"spn-854","marks":["code"],"text":"&memory.graph"}]}],"id":"blk-768","kind":"list-item"},{"blocks":[{"id":"blk-771","kind":"paragraph","spans":[{"id":"spn-855","marks":["code"],"text":"&memory.episodic"}]}],"id":"blk-770","kind":"list-item"},{"blocks":[{"id":"blk-773","kind":"paragraph","spans":[{"id":"spn-856","marks":["code"],"text":"&reason.argument"}]}],"id":"blk-772","kind":"list-item"},{"blocks":[{"id":"blk-775","kind":"paragraph","spans":[{"id":"spn-857","marks":["code"],"text":"&reason.vote"}]}],"id":"blk-774","kind":"list-item"},{"blocks":[{"id":"blk-777","kind":"paragraph","spans":[{"id":"spn-858","marks":["code"],"text":"&reason.plan"}]}],"id":"blk-776","kind":"list-item"},{"blocks":[{"id":"blk-779","kind":"paragraph","spans":[{"id":"spn-859","marks":["code"],"text":"&reason.chain"}]}],"id":"blk-778","kind":"list-item"},{"blocks":[{"id":"blk-781","kind":"paragraph","spans":[{"id":"spn-860","marks":["code"],"text":"&reason.deliberate"}]}],"id":"blk-780","kind":"list-item"},{"blocks":[{"id":"blk-783","kind":"paragraph","spans":[{"id":"spn-861","marks":["code"],"text":"&reason.attend"}]}],"id":"blk-782","kind":"list-item"},{"blocks":[{"id":"blk-785","kind":"paragraph","spans":[{"id":"spn-862","marks":["code"],"text":"&time.anomaly"}]}],"id":"blk-784","kind":"list-item"},{"blocks":[{"id":"blk-787","kind":"paragraph","spans":[{"id":"spn-863","marks":["code"],"text":"&time.forecast"}]}],"id":"blk-786","kind":"list-item"},{"blocks":[{"id":"blk-789","kind":"paragraph","spans":[{"id":"spn-864","marks":["code"],"text":"&space.fleet"}]}],"id":"blk-788","kind":"list-item"},{"blocks":[{"id":"blk-791","kind":"paragraph","spans":[{"id":"spn-865","marks":["code"],"text":"&space.route"}]}],"id":"blk-790","kind":"list-item"},{"blocks":[{"id":"blk-793","kind":"paragraph","spans":[{"id":"spn-866","marks":["code"],"text":"&body.browser"}]}],"id":"blk-792","kind":"list-item"},{"blocks":[{"id":"blk-795","kind":"paragraph","spans":[{"id":"spn-867","marks":["code"],"text":"&body.os"}]}],"id":"blk-794","kind":"list-item"},{"blocks":[{"id":"blk-797","kind":"paragraph","spans":[{"id":"spn-868","marks":["code"],"text":"&govern.telemetry"}]}],"id":"blk-796","kind":"list-item"},{"blocks":[{"id":"blk-799","kind":"paragraph","spans":[{"id":"spn-869","marks":["code"],"text":"&govern.escalation"}]}],"id":"blk-798","kind":"list-item"},{"blocks":[{"id":"blk-801","kind":"paragraph","spans":[{"id":"spn-870","marks":["code"],"text":"&govern.identity"}]}],"id":"blk-800","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-802","kind":"paragraph","spans":[{"id":"spn-871","text":"The protocol has exactly six primitive roots ("},{"id":"spn-872","marks":["code"],"text":"&memory"},{"id":"spn-873","text":", "},{"id":"spn-874","marks":["code"],"text":"&reason"},{"id":"spn-875","text":", "},{"id":"spn-876","marks":["code"],"text":"&time"},{"id":"spn-877","text":", "},{"id":"spn-878","marks":["code"],"text":"&space"},{"id":"spn-879","text":", "},{"id":"spn-880","marks":["code"],"text":"&body"},{"id":"spn-881","text":", "},{"id":"spn-882","marks":["code"],"text":"&govern"},{"id":"spn-883","text":"). Topology analysis and κ-routing are derived operations from "},{"id":"spn-884","marks":["code"],"text":"&memory.graph"},{"id":"spn-885","text":", not a separate primitive. "},{"id":"spn-886","marks":["code"],"text":"&body"},{"id":"spn-887","text":" is the sensorimotor primitive added in draft v0.1.0; see GRASP for the behavioral loop that consumes it."}]},{"id":"blk-803","kind":"paragraph","spans":[{"id":"spn-888","text":"Composition is defined with two operators:"}]},{"id":"blk-804","items":[{"blocks":[{"id":"blk-806","kind":"paragraph","spans":[{"id":"spn-889","marks":["code"],"text":"&"},{"id":"spn-890","text":" — combine capabilities into a set"}]}],"id":"blk-805","kind":"list-item"},{"blocks":[{"id":"blk-808","kind":"paragraph","spans":[{"id":"spn-891","marks":["code"],"text":"|>"},{"id":"spn-892","text":" — flow data through capability operations"}]}],"id":"blk-807","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-809","kind":"heading","level":2,"spans":[{"id":"spn-893","text":"Example declaration"}]},{"id":"blk-810","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"InfraOperator\",\n  \"version\": \"1.0.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": { \"instance\": \"infra-ops\" }\n    },\n    \"&time.anomaly\": {\n      \"provider\": \"ticktickclock\",\n      \"config\": { \"streams\": [\"cpu\", \"mem\"] }\n    },\n    \"&space.fleet\": {\n      \"provider\": \"geofleetic\",\n      \"config\": { \"regions\": [\"us-east\"] }\n    },\n    \"&reason.argument\": {\n      \"provider\": \"deliberatic\",\n      \"config\": { \"governance\": \"constitutional\" }\n    },\n    \"&reason.deliberate\": {\n      \"provider\": \"graphonomous\",\n      \"config\": { \"budget\": \"kappa\" }\n    },\n    \"&reason.attend\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {}\n    }\n  },\n  \"governance\": {\n    \"hard\": [\"Never scale beyond 3x in a single action\"],\n    \"soft\": [\"Prefer gradual scaling over spikes\"],\n    \"escalate_when\": {\n      \"confidence_below\": 0.7,\n      \"cost_exceeds_usd\": 1000\n    },\n    \"autonomy\": {\n      \"level\": \"advise\",\n      \"model_tier\": \"local_small\",\n      \"heartbeat_seconds\": 300,\n      \"budget\": {\n        \"max_actions_per_hour\": 5,\n        \"max_deliberation_calls_per_query\": 1,\n        \"require_approval_for\": [\"act\", \"propose\"]\n      }\n    }\n  },\n  \"provenance\": true\n}"},{"id":"blk-811","kind":"heading","level":2,"spans":[{"id":"spn-894","text":"What the repository contains"}]},{"id":"blk-812","kind":"paragraph","spans":[{"id":"spn-895","text":"This repository is the canonical home for the protocol and its reference artifacts."}]},{"id":"blk-813","kind":"heading","level":3,"spans":[{"id":"spn-896","text":"Specification"}]},{"id":"blk-814","items":[{"blocks":[{"id":"blk-816","kind":"paragraph","spans":[{"id":"spn-897","marks":["code"],"text":"site/protocol.html"},{"id":"spn-898","text":" — current HTML specification"}]}],"id":"blk-815","kind":"list-item"},{"blocks":[{"id":"blk-818","kind":"paragraph","spans":[{"id":"spn-899","marks":["code"],"text":"SPEC.md"},{"id":"spn-900","text":" — markdown protocol specification"}]}],"id":"blk-817","kind":"list-item"},{"blocks":[{"id":"blk-820","kind":"paragraph","spans":[{"id":"spn-901","marks":["code"],"text":"prompts/PROTOCOL_PROMPT.md"},{"id":"spn-902","text":" — implementation-oriented protocol prompt"}]}],"id":"blk-819","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-821","kind":"heading","level":3,"spans":[{"id":"spn-903","text":"Schemas"}]},{"id":"blk-822","items