, \"args\": [\"-y\", \"os-prism\",     \"--db\", \"~/.os-prism/benchmarks.db\"] },\n    \"pulse\":        { \"command\": \"npx\", \"args\": [\"-y\", \"os-pulse\",     \"--db\", \"~/.os-pulse/manifests.db\"] }\n  }\n}"},{"id":"blk-951","kind":"heading","level":3,"spans":[{"id":"spn-1017","text":"Option B — Elixir reference CLI (for protocol development)"}]},{"id":"blk-952","kind":"code","language":"bash","text":"cd reference/elixir/ampersand_core\nmix escript.build\n./ampersand validate ../../../examples/infra-operator.ampersand.json"},{"id":"blk-953","kind":"heading","level":3,"spans":[{"id":"spn-1018","text":"2. Check composition"}]},{"id":"blk-954","kind":"code","language":"bash","text":"./ampersand compose ../../../examples/infra-operator.ampersand.json"},{"id":"blk-955","kind":"heading","level":3,"spans":[{"id":"spn-1019","text":"3. Generate MCP config"}]},{"id":"blk-956","kind":"code","language":"bash","text":"./ampersand generate mcp ../../../examples/infra-operator.ampersand.json"},{"id":"blk-957","kind":"heading","level":3,"spans":[{"id":"spn-1020","text":"4. Generate an A2A agent card"}]},{"id":"blk-958","kind":"code","language":"bash","text":"./ampersand generate a2a ../../../examples/infra-operator.ampersand.json"},{"id":"blk-959","kind":"heading","level":2,"spans":[{"id":"spn-1021","text":"Current implementation status"}]},{"id":"blk-960","kind":"paragraph","spans":[{"id":"spn-1022","text":"The repository currently includes working foundations for:"}]},{"id":"blk-961","items":[{"blocks":[{"id":"blk-963","kind":"paragraph","spans":[{"id":"spn-1023","text":"canonical protocol schema + contract + registry artifacts"}]}],"id":"blk-962","kind":"list-item"},{"blocks":[{"id":"blk-965","kind":"paragraph","spans":[{"id":"spn-1024","text":"validating example declarations"}]}],"id":"blk-964","kind":"list-item"},{"blocks":[{"id":"blk-967","kind":"paragraph","spans":[{"id":"spn-1025","text":"Elixir reference runtime (validation, composition algebra, contract checks, 