8","text":"./graphonomous --db ~/.graphonomous/knowledge.db"}]},{"id":"blk-64952","kind":"paragraph","spans":[{"id":"spn-97069","text":"If you install/copy it onto PATH, use:"}]},{"id":"blk-64953","kind":"paragraph","spans":[{"id":"spn-97070","text":"graphonomous --db ~/.graphonomous/knowledge.db"}]},{"id":"blk-64954","kind":"paragraph","spans":[{"id":"spn-97071","text":"Standard MCP client configuration shape:"}]},{"id":"blk-64955","kind":"paragraph","spans":[{"id":"spn-97072","text":"{ \"mcpServers\": { \"graphonomous\": { \"command\": \"graphonomous\", \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\"], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\" } } } }"}]},{"id":"blk-64956","kind":"heading","level":2,"spans":[{"id":"spn-97073","text":"5) Functional Verification in IEx"}]},{"id":"blk-64957","kind":"paragraph","spans":[{"id":"spn-97074","text":"Start the app:"}]},{"id":"blk-64958","kind":"paragraph","spans":[{"id":"spn-97075","text":"iex -S mix"}]},{"id":"blk-64959","kind":"paragraph","spans":[{"id":"spn-97076","text":"Run these checks in IEx:"}]},{"id":"blk-64960","kind":"paragraph","spans":[{"id":"spn-97077","text":"Graphonomous.health() Graphonomous.store_node(%{ content: \"Hydraulic pressure error E-47 often indicates seal wear.\", node_type: \"semantic\", confidence: 0.82, source: \"bootstrap_manual\" }) Graphonomous.retrieve_context(\"What causes E-47 hydraulic pressure faults?\", limit: 3)"}]},{"id":"blk-64961","kind":"paragraph","spans":[{"id":"spn-97078","text":"What to verify:"}]},{"id":"blk-64962","items":[{"blocks":[{"id":"blk-64964","kind":"paragraph","spans":[{"id":"spn-97079","marks":["code"],"text":"Graphonomous.health/0"},{"id":"spn-97080","text":" reports services as "},{"id":"spn-97081","marks":["code"],"text":":up"}]}],"id":"blk-64963","kind":"list-item"},{"blocks":[{"id":"blk-64966","kind":"paragraph","spans":[{"id":"spn-97082","marks":["code"],"text":"store_node/1"},{"id":"spn-97083","text":" r