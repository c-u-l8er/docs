ence-transformers/all-MiniLM-L6-v2"}]},{"id":"blk-71442","items":[{"blocks":[{"id":"blk-71444","kind":"paragraph","spans":[{"id":"spn-133759","marks":["code"],"text":"GRAPHONOMOUS_EMBEDDER_BACKEND"}]}],"id":"blk-71443","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71445","kind":"paragraph","spans":[{"id":"spn-133760","text":"Allowed: "},{"id":"spn-133761","marks":["code"],"text":"auto | fallback"},{"id":"spn-133762","text":" Default: "},{"id":"spn-133763","marks":["code"],"text":"auto"}]},{"id":"blk-71446","items":[{"blocks":[{"id":"blk-71448","kind":"paragraph","spans":[{"id":"spn-133764","marks":["code"],"text":"GRAPHONOMOUS_SQLITE_VEC_EXTENSION_PATH"}]}],"id":"blk-71447","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71449","kind":"paragraph","spans":[{"id":"spn-133765","text":"Optional path to sqlite-vec extension"}]},{"id":"blk-71450","items":[{"blocks":[{"id":"blk-71452","kind":"paragraph","spans":[{"id":"spn-133766","marks":["code"],"text":"GRAPHONOMOUS_CONSOLIDATOR_INTERVAL_MS"}]}],"id":"blk-71451","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71453","kind":"paragraph","spans":[{"id":"spn-133767","text":"Default: "},{"id":"spn-133768","marks":["code"],"text":"300000"}]},{"id":"blk-71454","items":[{"blocks":[{"id":"blk-71456","kind":"paragraph","spans":[{"id":"spn-133769","marks":["code"],"text":"GRAPHONOMOUS_CONSOLIDATOR_DECAY_RATE"}]}],"id":"blk-71455","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71457","kind":"paragraph","spans":[{"id":"spn-133770","text":"Default: "},{"id":"spn-133771","marks":["code"],"text":"0.02"}]},{"id":"blk-71458","items":[{"blocks":[{"id":"blk-71460","kind":"paragraph","spans":[{"id":"spn-133772","marks":["code"],"text":"GRAPHONOMOUS_CONSOLIDATOR_PRUNE_THRESHOLD"}]}],"id":"blk-71459","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71461","kind":"paragraph","spans":[{"id":"spn-133773","text":"Default: "},{"id":"spn-133774","marks":["code"],"text":"0.1"}]},{"id":"blk-71462","items":[{"blocks":[{"id":"blk-71464","kind":"paragraph","spans":[{"id":"spn-133775","marks":["code"],"text":"GRAPHONOMOUS_CONSOLIDATOR_MERGE_SIMILARITY"}]}],"id":"blk-71463","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71465","kind":"paragraph","spans":[{"id":"spn-133776","text":"Default: "},{"id":"spn-133777","marks":["code"],"text":"0.95"}]},{"id":"blk-71466","items":[{"blocks":[{"id":"blk-71468","kind":"paragraph","spans":[{"id":"spn-133778","marks":["code"],"text":"GRAPHONOMOUS_LEARNING_RATE"}]}],"id":"blk-71467","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71469","kind":"paragraph","spans":[{"id":"spn-133779","text":"Default: "},{"id":"spn-133780","marks":["code"],"text":"0.2"}]},{"id":"blk-71470","items":[{"blocks":[{"id":"blk-71472","kind":"paragraph","spans":[{"id":"spn-133781","marks":["code"],"text":"LOG_LEVEL"}]}],"id":"blk-71471","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71473","kind":"paragraph","spans":[{"id":"spn-133782","text":"Allowed: "},{"id":"spn-133783","marks":["code"],"text":"debug | info | warning | error"},{"id":"spn-133784","text":" Default: "},{"id":"spn-133785","marks":["code"],"text":"info"}]},{"id":"blk-71474","kind":"heading","level":3,"spans":[{"id":"spn-133786","text":"Example (safe local dev profile)"}]},{"id":"blk-71475","kind":"paragraph","spans":[{"id":"spn-133787","text":"export GRAPHONOMOUS_DB_PATH=\"tmp/graphonomous_local.db\" export GRAPHONOMOUS_EMBEDDER_BACKEND=\"fallback\" export LOG_LEVEL=\"debug\""}]},{"id":"blk-71476","kind":"heading","level":3,"spans":[{"id":"spn-133788","text":"MCP Executable Build + Standard Client Command Configuration"}]},{"id":"blk-71477","kind":"paragraph","spans":[{"id":"spn-133789","text":"Build the executable command once:"}]},{"id":"blk-71478","kind":"paragraph","spans":[{"id":"spn-133790","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-71479","kind":"paragraph","spans":[{"id":"spn-133791","text":"Run directly (STDIO transport):"}]},{"id":"blk-71480","kind":"paragraph","spans":[{"id":"spn-133792","text":"./graphonomous --db ~/.graphonomous/knowledge.db"}]},{"id":"blk-71481","kind":"paragraph","spans":[{"id":"spn-133793","text":"If you install/copy it onto PATH, use:"}]},{"id":"blk-71482","kind":"paragraph","spans":[{"id":"spn-133794","text":"graphonomous --db ~/.graphonomous/knowledge.db"}]},{"id":"blk-71483","kind":"paragraph","spans":[{"id":"spn-133795","text":"Standard MCP client configuration shape:"}]},{"id":"blk-71484","kind":"paragraph","spans":[{"id":"spn-133796","text":"{ \"mcpServers\": { \"graphonomous\": { \"command\": \"graphonomous\", \"args\": [\"--db\", \"~/.graphonomous/knowledge.db\"], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\" } } } }"}]},{"id":"blk-71485","kind":"heading","level":2,"spans":[{"id":"spn-133797","text":"5) Functional Verification in IEx"}]},{"id":"blk-71486","kind":"paragraph","spans":[{"id":"spn-133798","text":"Start the app:"}]},{"id":"blk-71487","kind":"paragraph","spans":[{"id":"spn-133799","text":"iex -S mix"}]},{"id":"blk-71488","kind":"paragraph","spans":[{"id":"spn-133800","text":"Run these checks in IEx:"}]},{"id":"blk-71489","kind":"paragraph","spans":[{"id":"spn-133801","text":"Graphonomous.health() Graphonomous.store_node(%{ content: \"Hydraulic pressure error E-47 often indicates seal wear.\", node_type: \"semantic\", confidence: 0.82, source: \"bootstrap_manual\" }) Graphonomous.retrieve_context(\"What causes E-47 hydraulic pressure faults?\", limit: 3)"}]},{"id":"blk-71490","kind":"paragraph","spans":[{"id":"spn-133802","text":"What to verify:"}]},{"id":"blk-71491","items":[{"blocks":[{"id":"blk-71493","kind":"paragraph","spans":[{"id":"spn-133803","marks":["code"],"text":"Graphonomous.health/0"},{"id":"spn-133804","text":" reports services as "},{"id":"spn-133805","marks":["code"],"text":":up"}]}],"id":"blk-71492","kind":"list-item"},{"blocks":[{"id":"blk-71495","kind":"paragraph","spans":[{"id":"spn-133806","marks":["code"],"text":"store_node/1"},{"id":"spn-133807","text":" returns a node struct/map with an "},{"id":"spn-133808","marks":["code"],"text":"id"}]}],"id":"blk-71494","kind":"list-item"},{"blocks":[{"id":"blk-71497","kind":"paragraph","spans":[{"id":"spn-133809","marks":["code"],"text":"retrieve_context/2"},{"id":"spn-133810","text":" returns relevant node results"}]}],"id":"blk-71496","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71498","kind":"heading","level":2,"spans":[{"id":"spn-133811","text":"6) Store & Migration Verification"}]},{"id":"blk-71499","kind":"paragraph","spans":[{"id":"spn-133812","text":"The store auto-creates schema and applies tracked migrations at startup."}]},{"id":"blk-71500","kind":"paragraph","spans":[{"id":"spn-133813","text":"To verify via tests:"}]},{"id":"blk-71501","kind":"paragraph","spans":[{"id":"spn-133814","text":"mix test test/store_test.exs"}]},{"id":"blk-71502","kind":"paragraph","spans":[{"id":"spn-133815","text":"Coverage includes:"}]},{"id":"blk-71503","items":[{"blocks":[{"id":"blk-71505","kind":"paragraph","spans":[{"id":"spn-133816","text":"node/edge/outcome persistence"}]}],"id":"blk-71504","kind":"list-item"},{"blocks":[{"id":"blk-71507","kind":"paragraph","spans":[{"id":"spn-133817","text":"cache rebuild from SQLite"}]}],"id":"blk-71506","kind":"list-item"},{"blocks":[{"id":"blk-71509","kind":"paragraph","spans":[{"id":"spn-133818","text":"grounding trace persistence"}]}],"id":"blk-71508","kind":"list-item"},{"blocks":[{"id":"blk-71511","kind":"paragraph","spans":[{"id":"spn-133819","text":"migration bookkeeping ("},{"id":"spn-133820","marks":["code"],"text":"schema_migrations"},{"id":"spn-133821","text":" records applied IDs)"}]}],"id":"blk-71510","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-71512","kind":"heading","level":2,"spans":[{"id":"spn-133822","text":"7) CI Parity Commands (run exactly what CI expects)"}]},{"id":"blk-71513","kind":"