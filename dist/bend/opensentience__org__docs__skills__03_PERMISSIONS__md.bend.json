{"bendscript":"0.1","blocks":[{"id":"blk-75967","kind":"heading","level":1,"spans":[{"id":"spn-109140","text":"Skill 03 — Permissions"}]},{"blocks":[{"id":"blk-75969","kind":"paragraph","spans":[{"id":"spn-109141","text":"The permission taxonomy, evaluation order, glob patterns, and ETS hot cache."}]}],"id":"blk-75968","kind":"quote"},{"id":"blk-75970","kind":"heading","level":2,"spans":[{"id":"spn-109142","text":"Why This Matters"}]},{"id":"blk-75971","kind":"paragraph","spans":[{"id":"spn-109143","text":"Permissions are the core enforcement mechanism. Without them, governance is advisory only. The permission system ensures agents can only access what they have been explicitly granted, with explicit denials always winning."}]},{"id":"blk-75972","kind":"heading","level":2,"spans":[{"id":"spn-109144","text":"Permission Taxonomy"}]},{"id":"blk-75973","kind":"heading","level":3,"spans":[{"id":"spn-109145","text":"filesystem"}]},{"id":"blk-75974","kind":"paragraph","spans":[{"id":"spn-109146","text":"Controls access to the local filesystem."}]},{"head":[{"id":"blk-75976","spans":[{"id":"spn-109147","text":"Access"}]},{"id":"blk-75977","spans":[{"id":"spn-109148","text":"Meaning"}]}],"id":"blk-75975","kind":"table","rows":[[{"id":"blk-75978","spans":[{"id":"spn-109149","marks":["code"],"text":"read"}]},{"id":"blk-75979","spans":[{"id":"spn-109150","text":"Read file contents, list directories"}]}],[{"id":"blk-75980","spans":[{"id":"spn-109151","marks":["code"],"text":"write"}]},{"id":"blk-75981","spans":[{"id":"spn-109152","text":"Create, modify, or delete files"}]}],[{"id":"blk-75982","spans":[{"id":"spn-109153","marks":["code"],"text":"execute"}]},{"id":"blk-75983","spans":[{"id":"spn-109154","text":"Execute files as processes"}]}]]},{"id":"blk-75984","kind":"paragraph","spans":[{"id":"spn-109155","marks":["bold"],"text":"Resource format:"},{"id":"spn-109156","text":" Glob paths. Examples: "},{"id":"spn-109157","marks":["code"],"text":"/data/**"},{"id":"spn-109158","text":", "},{"id":"spn-109159","marks":["code"],"text":"/tmp/*.csv"},{"id":"spn-109160","text":", "},{"id":"spn-109161","marks":["code"],"text":"/home/agent/workspace/"}]},{"id":"blk-75985","kind":"heading","level":3,"spans":[{"id":"spn-109162","text":"network"}]},{"id":"blk-75986","kind":"paragraph","spans":[{"id":"spn-109163","text":"Controls network communication."}]},{"head":[{"id":"blk-75988","spans":[{"id":"spn-109164","text":"Access"}]},{"id":"blk-75989","spans":[{"id":"spn-109165","text":"Meaning"}]}],"id":"blk-75987","kind":"table","rows":[[{"id":"blk-75990","spans":[{"id":"spn-109166","marks":["code"],"text":"outbound"}]},{"id":"blk-75991","spans":[{"id":"spn-109167","text":"Make HTTP/TCP requests to external hosts"}]}],[{"id":"blk-75992","spans":[{"id":"spn-109168","marks":["code"],"text":"inbound"}]},{"id":"blk-75993","spans":[{"id":"spn-109169","text":"Accept incoming connections"}]}]]},{"id":"blk-75994","kind":"paragraph","spans":[{"id":"spn-109170","marks":["bold"],"text":"Resource format:"},{"id":"spn-109171","text":" Host patterns. Examples: "},{"id":"spn-109172","marks":["code"],"text":"api.example.com"},{"id":"spn-109173","text":", "},{"id":"spn-109174","marks":["code"],"text":"*.internal.net"},{"id":"spn-109175","text":", "},{"id":"spn-109176","marks":["code"],"text":"0.0.0.0:8080"}]},{"id":"blk-75995","kind":"heading","level":3,"spans":[{"id":"spn-109177","text":"tool_invocation"}]},{"id":"blk-75996","kind":"paragraph","spans":[{"id":"spn-109178","text":"Controls which MCP tools the agent may call."}]},{"head":[{"id":"blk-75998","spans":[{"id":"spn-109179","text":"Access"}]},{"id":"blk-75999","spans":[{"id":"spn-109180","text":"Meaning"}]}],"id":"blk-75997","kind":"table","rows":[[{"id":"blk-76000","spans":[{"id":"spn-109181","marks":["code"],"text":"allowed"}]},{"id":"blk-76001","spans":[{"id":"spn-109182","text":"Agent may invoke this tool"}]}],[{"id":"blk-76002","spans":[{"id":"spn-109183","marks":["code"],"text":"denied"}]},{"id":"blk-76003","spans":[{"id":"spn-109184","text":"Agent is blocked from invoking this tool"}]}]]},{"id":"blk-76004","kind":"paragraph","spans":[{"id":"spn-109185","marks":["bold"],"text":"Resource format:"},{"id":"spn-109186","text":" Tool names. Examples: "},{"id":"spn-109187","marks":["code"],"text":"store_node"},{"id":"spn-109188","text":", "},{"id":"spn-109189","marks":["code"],"text":"deliberate"},{"id":"spn-109190","text":", "},{"id":"spn-109191","marks":["code"],"text":"agent_install"}]},{"id":"blk-76005","kind":"heading","level":3,"spans":[{"id":"spn-109192","text":"graph_access"}]},{"id":"blk-76006","kind":"paragraph","spans":[{"id":"spn-109193","text":"Controls access to the Graphonomous knowledge graph."}]},{"head":[{"id":"blk-76008","spans":[{"id":"spn-109194","text":"Access"}]},{"id":"blk-76009","spans":[{"id":"spn-109195","text":"Meaning"}]}],"id":"blk-76007","kind":"table","rows":[[{"id":"blk-76010","spans":[{"id":"spn-109196","marks":["code"],"text":"read"}]},{"id":"blk-76011","spans":[{"id":"spn-109197","text":"Query nodes, edges, retrieve context"}]}],[{"id":"blk-76012","spans":[{"id":"spn-109198","marks":["code"],"text":"write"}]},{"id":"blk-76013","spans":[{"id":"spn-109199","text":"Store nodes, store edges, run consolidation"}]}]]},{"id":"blk-76014","kind":"paragraph","spans":[{"id":"spn-109200","marks":["bold"],"text":"Resource format:"},{"id":"spn-109201","text":" Graph namespaces or "},{"id":"spn-109202","marks":["code"],"text":"*"},{"id":"spn-109203","text":" for all."}]},{"id":"blk-76015","kind":"heading","level":2,"spans":[{"id":"spn-109204","text":"Evaluation Order"}]},{"id":"blk-76016","kind":"paragraph","spans":[{"id":"spn-109205","text":"Permission checks follow a strict precedence:"}]},{"id":"blk-76017","kind":"code","language":"text","text":"1. Explicit DENY  → if any denial matches, result is DENY (highest priority)\n2. Explicit ALLOW → if a grant matches, result is ALLOW\n3. Default DENY   → if nothing matches, result is DENY (lowest priority)"},{"id":"blk-76018","kind":"paragraph","spans":[{"id":"spn-109206","text":"This means:"}]},{"id":"blk-76019","items":[{"blocks":[{"id":"blk-76021","kind":"paragraph","spans":[{"id":"spn-109207","text":"Granting "},{"id":"spn-109208","marks":["code"],"text":"filesystem:read:/data/**"},{"id":"spn-109209","text":" allows reading anything under "},{"id":"spn-109210","marks":["code"],"text":"/data/"}]}],"id":"blk-76020","kind":"list-item"},{"blocks":[{"id":"blk-76023","kind":"paragraph","spans":[{"id":"spn-109211","text":"Adding a denial for "},{"id":"spn-109212","marks":["code"],"text":"filesystem:read:/data/secrets/**"},{"id":"spn-109213","text":" overrides the grant"}]}],"id":"blk-76022","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76024","kind":"paragraph","spans":[{"id":"spn-109214","text":"for that subtree"}]},{"id":"blk-76025","items":[{"blocks":[{"id":"blk-76027","kind":"paragraph","spans":[{"id":"spn-109215","text":"A resource with no matching grant or denial is denied by default"}]}],"id":"blk-76026","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76028","kind":"heading","level":2,"spans":[{"id":"spn-109216","text":"Glob Patterns"}]},{"id":"blk-76029","kind":"paragraph","spans":[{"id":"spn-109217","text":"Both filesystem paths and network hosts support glob matching:"}]},{"head":[{"id":"blk-76031","spans":[{"id":"spn-109218","text":"Pattern"}]},{"id":"blk-76032","spans":[{"id":"spn-109219","text":"Matches"}]},{"id":"blk-76033","spans":[{"id":"spn-109220","text":"Does Not Match"}]}],"id":"blk-76030","kind":"table","rows":[[{"id":"blk-76034","spans":[{"id":"spn-109221","marks":["code"],"text":"/data/**"}]},{"id":"blk-76035","spans":[{"id":"spn-109222","marks":["code"],"text":"/data/foo.csv"},{"id":"spn-109223","text":", "},{"id":"spn-109224","marks":["code"],"text":"/data/sub/bar.json"}]},{"id":"blk-76036","spans":[{"id":"spn-109225","marks":["code"],"text":"/etc/data"}]}],[{"id":"blk-76037","spans":[{"id":"spn-109226","marks":["code"],"text":"/tmp/*.csv"}]},{"id":"blk-76038","spans":[{"id":"spn-109227","marks":["code"],"text":"/tmp/report.csv"}]},{"id":"blk-76039","spans":[{"id":"spn-109228","marks":["code"],"text":"/tmp/sub/report.csv"}]}],[{"id":"blk-76040","spans":[{"id":"spn-109229","marks":["code"],"text":"*.example.com"}]},{"id":"blk-76041","spans":[{"id":"spn-109230","marks":["code"],"text":"api.example.com"},{"id":"spn-109231","text":", "},{"id":"spn-109232","marks":["code"],"text":"www.example.com"}]},{"id":"blk-76042","spans":[{"id":"spn-109233","marks":["code"],"text":"example.com"}]}],[{"id":"blk-76043","spans":[{"id":"spn-109234","marks":["code"],"text":"10.0.0.*"}]},{"id":"blk-76044","spans":[{"id":"spn-109235","marks":["code"],"text":"10.0.0.1"},{"id":"spn-109236","text":", "},{"id":"spn-109237","marks":["code"],"text":"10.0.0.255"}]},{"id":"blk-76045","spans":[{"id":"spn-109238","marks":["code"],"text":"10.0.1.1"}]}]]},{"id":"blk-76046","kind":"paragraph","spans":[{"id":"spn-109239","text":"The glob engine uses Elixir's "},{"id":"spn-109240","marks":["code"],"text":"Path.wildcard/1"},{"id":"spn-109241","text":" semantics for filesystem paths and a simple wildcard matcher for network hosts."}]},{"id":"blk-76047","kind":"heading","level":2,"spans":[{"id":"spn-109242","text":"permission_check Tool"}]},{"id":"blk-76048","kind":"heading","level":3,"spans":[{"id":"spn-109243","text":"Parameters"}]},{"head":[{"id":"blk-76050","spans":[{"id":"spn-109244","text":"Param"}]},{"id":"blk-76051","spans":[{"id":"spn-109245","text":"Required"}]},{"id":"blk-76052","spans":[{"id":"spn-109246","text":"Type"}]},{"id":"blk-76053","spans":[{"id":"spn-109247","text":"Description"}]}],"id":"blk-76049","kind":"table","rows":[[{"id":"blk-76054","spans":[{"id":"spn-109248","marks":["code"],"text":"agent_id"}]},{"id":"blk-76055","spans":[{"id":"spn-109249","text":"Yes"}]},{"id":"blk-76056","spans":[{"id":"spn-109250","text":"string"}]},{"id":"blk-76057","spans":[{"id":"spn-109251","text":"The agent to check"}]}],[{"id":"blk-76058","spans":[{"id":"spn-109252","marks":["code"],"text":"permission_type"}]},{"id":"blk-76059","spans":[{"id":"spn-109253","text":"Yes"}]},{"id":"blk-76060","spans":[{"id":"spn-109254","text":"string"}]},{"id":"blk-76061","spans":[{"id":"spn-109255","marks":["code"],"text":"filesystem"},{"id":"spn-109256","text":", "},{"id":"spn-109257","marks":["code"],"text":"network"},{"id":"spn-109258","text":", "},{"id":"spn-109259","marks":["code"],"text":"tool_invocation"},{"id":"spn-109260","text":", "},{"id":"spn-109261","marks":["code"],"text":"graph_access"}]}],[{"id":"blk-76062","spans":[{"id":"spn-109262","marks":["code"],"text":"access"}]},{"id":"blk-76063","spans":[{"id":"spn-109263","text":"Yes"}]},{"id":"blk-76064","spans":[{"id":"spn-109264","text":"string"}]},{"id":"blk-76065","spans":[{"id":"spn-109265","text":"Access mode (type-specific)"}]}],[{"id":"blk-76066","spans":[{"id":"spn-109266","marks":["code"],"text":"resource"}]},{"id":"blk-76067","spans":[{"id":"spn-109267","text":"Yes"}]},{"id":"blk-76068","spans":[{"id":"spn-109268","text":"string"}]},{"id":"blk-76069","spans":[{"id":"spn-109269","text":"The resource being accessed"}]}]]},{"id":"blk-76070","kind":"heading","level":3,"spans":[{"id":"spn-109270","text":"Example Calls"}]},{"id":"blk-76071","kind":"code","language":"text","text":"permission_check(\n  agent_id: \"my-worker\",\n  permission_type: \"filesystem\",\n  access: \"read\",\n  resource: \"/data/input.csv\"\n)\n# => {allow, \"explicit grant: /data/**\"}"},{"id":"blk-76072","kind":"code","language":"text","text":"permission_check(\n  agent_id: \"my-worker\",\n  permission_type: \"network\",\n  access: \"outbound\",\n  resource: \"malicious.example.com\"\n)\n# => {deny, \"default deny: no matching grant\"}"},{"id":"blk-76073","kind":"heading","level":2,"spans":[{"id":"spn-109271","text":"ETS Hot Cache"}]},{"id":"blk-76074","kind":"paragraph","spans":[{"id":"spn-109272","text":"Permission checks are performance-critical — they happen on every agent action. The PermissionEngine uses ETS for microsecond lookups:"}]},{"id":"blk-76075","items":[{"blocks":[{"id":"blk-76077","kind":"paragraph","spans":[{"id":"spn-109273","marks":["bold"],"text":"Table:"},{"id":"spn-109274","text":" "},{"id":"spn-109275","marks":["code"],"text":":os_permissions"},{"id":"spn-109276","text":", type "},{"id":"spn-109277","marks":["code"],"text":":bag"}]}],"id":"blk-76076","kind":"list-item"},{"blocks":[{"id":"blk-76079","kind":"paragraph","spans":[{"id":"spn-109278","marks":["bold"],"text":"Key:"},{"id":"spn-109279","text":" "},{"id":"spn-109280","marks":["code"],"text":"{agent_id, permission_type, access}"}]}],"id":"blk-76078","kind":"list-item"},{"blocks":[{"id":"blk-76081","kind":"paragraph","spans":[{"id":"spn-109281","marks":["bold"],"text":"Value:"},{"id":"spn-109282","text":" "},{"id":"spn-109283","marks":["code"],"text":"{:grant | :deny, resource_pattern}"}]}],"id":"blk-76080","kind":"list-item"},{"blocks":[{"id":"blk-76083","kind":"paragraph","spans":[{"id":"spn-109284","marks":["bold"],"text":"Lookup:"},{"id":"spn-109285","text":" "},{"id":"spn-109286","marks":["code"],"text":"permission_check/4"},{"id":"spn-109287","text":" reads directly from ETS (no GenServer call)"}]}],"id":"blk-76082","kind":"list-item"},{"blocks":[{"id":"blk-76085","kind":"paragraph","spans":[{"id":"spn-109288","marks":["bold"],"text":"Mutation:"},{"id":"spn-109289","text":" permission changes go through the GenServer for serialization,"}]}],"id":"blk-76084","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76086","kind":"paragraph","spans":[{"id":"spn-109290","text":"then update ETS"}]},{"id":"blk-76087","kind":"paragraph","spans":[{"id":"spn-109291","text":"This design means permission checks never block on GenServer mailbox contention. Thousands of checks per second are possible with no measurable overhead."}]},{"id":"blk-76088","kind":"heading","level":2,"spans":[{"id":"spn-109292","text":"Delegatic Policy Integration"}]},{"id":"blk-76089","kind":"paragraph","spans":[{"id":"spn-109293","text":"When Delegatic is connected, policies propagate via PubSub:"}]},{"id":"blk-76090","items":[{"blocks":[{"id":"blk-76092","kind":"paragraph","spans":[{"id":"spn-109294","text":"Delegatic publishes a policy change event"}]}],"id":"blk-76091","kind":"list-item"},{"blocks":[{"id":"blk-76094","kind":"paragraph","spans":[{"id":"spn-109295","text":"PermissionEngine subscribes and receives the event"}]}],"id":"blk-76093","kind":"list-item"},{"blocks":[{"id":"blk-76096","kind":"paragraph","spans":[{"id":"spn-109296","text":"ETS table is updated atomically"}]}],"id":"blk-76095","kind":"list-item"},{"blocks":[{"id":"blk-76098","kind":"paragraph","spans":[{"id":"spn-109297","text":"All subsequent permission checks use the new policy"}]}],"id":"blk-76097","kind":"list-item"},{"blocks":[{"id":"blk-76100","kind":"paragraph","spans":[{"id":"spn-109298","text":"Audit entry records the policy update with source"}]}],"id":"blk-76099","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-76101","kind":"paragraph","spans":[{"id":"spn-109299","text":"Cache invalidation is immediate — there is no TTL or polling delay."}]},{"id":"blk-76102","kind":"heading","level":2,"spans":[{"id":"spn-109300","text":"Permission Change Propagation"}]},{"id":"blk-76103","kind":"paragraph","spans":[{"id":"spn-109301","text":"When permissions change for a running agent:"}]},{"id":"blk-76104","items":[{"blocks":[{"id":"blk-76106","kind":"paragraph","spans":[{"id":"spn-109302","text":"New permissions take effect immediately (ETS is the source of truth)"}]}],"id":"blk-76105","kind":"list-item"},{"blocks":[{"id":"blk-76108","kind":"paragraph","spans":[{"id":"spn-109303","text":"In-flight actions that already passed a permission check are not revoked"}]}],"id":"blk-76107","kind":"list-item"},{"blocks":[{"id":"blk-76110","kind":"paragraph","spans":[{"id":"spn-109304","text":"The next action will be checked against the updated permissions"}]}],"id":"blk-76109","kind":"list-item"},{"blocks":[{"id":"blk-76112","kind":"paragraph","spans":[{"id":"spn-109305","text":"An audit entry records the permission change"}]}],"id":"blk-76111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-76113","kind":"paragraph","spans":[{"id":"spn-109306","text":"This is eventually consistent at the action level: a permission revocation does not kill running operations, but blocks all subsequent ones."}]},{"id":"blk-76114","kind":"heading","level":2,"spans":[{"id":"spn-109307","text":"Best Practices"}]},{"id":"blk-76115","items":[{"blocks":[{"id":"blk-76117","kind":"paragraph","spans":[{"id":"spn-109308","marks":["bold"],"text":"Least privilege:"},{"id":"spn-109309","text":" Grant only what the agent needs. Start narrow, widen"}]}],"id":"blk-76116","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-76118","kind":"paragraph","spans":[{"id":"spn-109310","text":"as trust builds."}]},{"id":"blk-76119","items":[{"blocks":[{"id":"blk-76121","kind":"paragraph","spans":[{"id":"spn-109311","marks":["bold"],"text":"Explicit denials for sensitive paths:"},{"id":"spn-109312","text":" Even if the grant does not cover"}]}],"id":"blk-76120","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-76122","kind":"paragraph","spans":[{"id":"spn-109313","text":"them, explicit denials serve as documentation and defense in depth."}]},{"id":"blk-76123","items":[{"blocks":[{"id":"blk-76125","kind":"paragraph","spans":[{"id":"spn-109314","marks":["bold"],"text":"Use glob specificity:"},{"id":"spn-109315","text":" "},{"id":"spn-109316","marks":["code"],"text":"/data/reports/*.csv"},{"id":"spn-109317","text":" is better than "},{"id":"spn-109318","marks":["code"],"text":"/data/**"}]}],"id":"blk-76124","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-76126","kind":"paragraph","spans":[{"id":"spn-109319","text":"when the agent only needs CSV reports."}]},{"id":"blk-76127","items":[{"blocks":[{"id":"blk-76129","kind":"paragraph","spans":[{"id":"spn-109320","marks":["bold"],"text":"Audit permission checks:"},{"id":"spn-109321","text":" The audit trail records every check. Review"}]}],"id":"blk-76128","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-76130","kind":"paragraph","spans":[{"id":"spn-109322","text":"denials periodically — they may indicate misconfiguration or scope creep."}]},{"id":"blk-76131","items":[{"blocks":[{"id":"blk-76133","kind":"paragraph","spans":[{"id":"spn-109323","marks":["bold"],"text":"Combine with autonomy:"},{"id":"spn-109324","text":" Permissions control "},{"id":"spn-109325","marks":["italic"],"text":"what"},{"id":"spn-109326","text":" is allowed; autonomy"}]}],"id":"blk-76132","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-76134","kind":"paragraph","spans":[{"id":"spn-109327","text":"controls "},{"id":"spn-109328","marks":["italic"],"text":"how"},{"id":"spn-109329","text":" it is allowed. Use both together."}]}],"edges":[],"id":"bagaaieravr6jvjmg5ii6anjf2ekn4cvbwpvqs6ucmgbb5dggj7ywmoqpkgxq","vocabulary":"ampersand.docs.fs.v1"}