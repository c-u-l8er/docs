{"bendscript":"0.1","blocks":[{"id":"blk-43168","kind":"paragraph","spans":[{"id":"spn-49666","text":"--- name: attention description: Use at session startup to regain context, for goal selection and prioritization, when the user asks \"what should I focus on?\", \"what needs attention?\", \"prioritize goals\", \"triage\", or for periodic status reporting. Routes through the "},{"id":"spn-49667","marks":["code"],"text":"route"},{"id":"spn-49668","text":" machine. argument-hint: [survey|cycle] [observe|advise|act] ---"}]},{"id":"blk-43169","kind":"heading","level":1,"spans":[{"id":"spn-49669","text":"Attention Engine"}]},{"id":"blk-43170","kind":"paragraph","spans":[{"id":"spn-49670","text":"Autonomous focus management — rank goals by urgency, knowledge gaps, and topology complexity."}]},{"id":"blk-43171","kind":"heading","level":2,"spans":[{"id":"spn-49671","text":"Arguments"}]},{"id":"blk-43172","kind":"paragraph","spans":[{"id":"spn-49672","text":"Mode: $ARGUMENTS"}]},{"id":"blk-43173","kind":"heading","level":2,"spans":[{"id":"spn-49673","text":"Survey (read-only ranking)"}]},{"id":"blk-43174","kind":"code","language":"text","text":"route(action: \"attention_survey\", include_idle: false)"},{"id":"blk-43175","kind":"paragraph","spans":[{"id":"spn-49674","text":"Returns ranked "},{"id":"spn-49675","marks":["code"],"text":"attention_items"},{"id":"spn-49676","text":" sorted by score (0.0-1.0). Each item includes:"}]},{"id":"blk-43176","items":[{"blocks":[{"id":"blk-43178","kind":"paragraph","spans":[{"id":"spn-49677","marks":["code"],"text":"goal_id"},{"id":"spn-49678","text":", "},{"id":"spn-49679","marks":["code"],"text":"goal_title"},{"id":"spn-49680","text":" — which goal"}]}],"id":"blk-43177","kind":"list-item"},{"blocks":[{"id":"blk-43180","kind":"paragraph","spans":[{"id":"spn-49681","marks":["code"],"text":"attention_score"},{"id":"spn-49682","text":" — composite priority (0.0-1.0)"}]}],"id":"blk-43179","kind":"list-item"},{"blocks":[{"id":"blk-43182","kind":"paragraph","spans":[{"id":"spn-49683","marks":["code"],"text":"dispatch_mode"},{"id":"spn-49684","text":" — "},{"id":"spn-49685","marks":["code"],"text":"act"},{"id":"spn-49686","text":", "},{"id":"spn-49687","marks":["code"],"text":"learn"},{"id":"spn-49688","text":", "},{"id":"spn-49689","marks":["code"],"text":"escalate"},{"id":"spn-49690","text":", or "},{"id":"spn-49691","marks":["code"],"text":"idle"}]}],"id":"blk-43181","kind":"list-item"},{"blocks":[{"id":"blk-43184","kind":"paragraph","spans":[{"id":"spn-49692","marks":["code"],"text":"coverage_score"},{"id":"spn-49693","text":", "},{"id":"spn-49694","marks":["code"],"text":"max_kappa"},{"id":"spn-49695","text":", "},{"id":"spn-49696","marks":["code"],"text":"routing"},{"id":"spn-49697","text":" — epistemic state"}]}],"id":"blk-43183","kind":"list-item"},{"blocks":[{"id":"blk-43186","kind":"paragraph","spans":[{"id":"spn-49698","marks":["code"],"text":"attention_rationale"},{"id":"spn-49699","text":" — compact summary of why this score"}]}],"id":"blk-43185","kind":"list-item"},{"blocks":[{"id":"blk-43188","kind":"paragraph","spans":[{"id":"spn-49700","marks":["code"],"text":"autonomy_level"},{"id":"spn-49701","text":" — current autonomy setting"}]}],"id":"blk-43187","kind":"list-item"},{"blocks":[{"id":"blk-43190","kind":"paragraph","spans":[{"id":"spn-49702","marks":["code"],"text":"next_heartbeat_in_ms"},{"id":"spn-49703","text":" — when the next automatic re-evaluation happens"}]}],"id":"blk-43189","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43191","kind":"paragraph","spans":[{"id":"spn-49704","text":"Use "},{"id":"spn-49705","marks":["code"],"text":"include_idle: true"},{"id":"spn-49706","text":" to also see goals that don't need attention right now."}]},{"id":"blk-43192","kind":"heading","level":2,"spans":[{"id":"spn-49707","text":"Run a Full Cycle (survey -> triage -> dispatch)"}]},{"id":"blk-43193","kind":"code","language":"text","text":"route(action: \"attention_cycle\", autono