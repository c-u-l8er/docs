{"bendscript":"0.1","blocks":[{"id":"blk-42196","kind":"paragraph","spans":[{"id":"spn-47372","text":"--- name: attention description: Use at session startup to regain context, for goal selection and prioritization, when the user asks \"what should I focus on?\", \"what needs attention?\", \"prioritize goals\", \"triage\", or for periodic status reporting. Routes through the "},{"id":"spn-47373","marks":["code"],"text":"route"},{"id":"spn-47374","text":" machine. argument-hint: [survey|cycle] [observe|advise|act] ---"}]},{"id":"blk-42197","kind":"heading","level":1,"spans":[{"id":"spn-47375","text":"Attention Engine"}]},{"id":"blk-42198","kind":"paragraph","spans":[{"id":"spn-47376","text":"Autonomous focus management — rank goals by urgency, knowledge gaps, and topology complexity."}]},{"id":"blk-42199","kind":"heading","level":2,"spans":[{"id":"spn-47377","text":"Arguments"}]},{"id":"blk-42200","kind":"paragraph","spans":[{"id":"spn-47378","text":"Mode: $ARGUMENTS"}]},{"id":"blk-42201","kind":"heading","level":2,"spans":[{"id":"spn-47379","text":"Survey (read-only ranking)"}]},{"id":"blk-42202","kind":"code","language":"text","text":"route(action: \"attention_survey\", include_idle: false)"},{"id":"blk-42203","kind":"paragraph","spans":[{"id":"spn-47380","text":"Returns ranked "},{"id":"spn-47381","marks":["code"],"text":"attention_items"},{"id":"spn-47382","text":" sorted by score (0.0-1.0). Each item includes:"}]},{"id":"blk-42204","items":[{"blocks":[{"id":"blk-42206","kind":"paragraph","spans":[{"id":"spn-47383","marks":["code"],"text":"goal_id"},{"id":"spn-47384","text":", "},{"id":"spn-47385","marks":["code"],"text":"goal_title"},{"id":"spn-47386","text":" — which goal"}]}],"id":"blk-42205","kind":"list-item"},{"blocks":[{"id":"blk-42208","kind":"paragraph","spans":[{"id":"spn-47387","marks":["code"],"text":"attention_score"},{"id":"spn-47388","text":" — composite priority (0.0-1.0)"}]}],"id":"blk-42207","kind":"list-item"},{"blocks":[{"id":"blk-42210","kind":"paragraph","spans":[{"id":"spn-47389","marks":["code"],"text":"dispatch_mode"},{"id":"spn-47390","text":" — "},{"id":"spn-47391","marks":["code"],"text":"act"},{"id":"spn-47392","text":", "},{"id":"spn-47393","marks":["code"],"text":"learn"},{"id":"spn-47394","text":", "},{"id":"spn-47395","marks":["code"],"text":"escalate"},{"id":"spn-47396","text":", or "},{"id":"spn-47397","marks":["code"],"text":"idle"}]}],"id":"blk-42209","kind":"list-item"},{"blocks":[{"id":"blk-42212","kind":"paragraph","spans":[{"id":"spn-47398","marks":["code"],"text":"coverage_score"},{"id":"spn-47399","text":", "},{"id":"spn-47400","marks":["code"],"text":"max_kappa"},{"id":"spn-47401","text":", "},{"id":"spn-47402","marks":["code"],"text":"routing"},{"id":"spn-47403","text":" — epistemic state"}]}],"id":"blk-42211","kind":"list-item"},{"blocks":[{"id":"blk-42214","kind":"paragraph","spans":[{"id":"spn-47404","marks":["code"],"text":"attention_rationale"},{"id":"spn-47405","text":" — compact summary of why this score"}]}],"id":"blk-42213","kind":"list-item"},{"blocks":[{"id":"blk-42216","kind":"paragraph","spans":[{"id":"spn-47406","marks":["code"],"text":"autonomy_level"},{"id":"spn-47407","text":" — current autonomy setting"}]}],"id":"blk-42215","kind":"list-item"},{"blocks":[{"id":"blk-42218","kind":"paragraph","spans":[{"id":"spn-47408","marks":["code"],"text":"next_heartbeat_in_ms"},{"id":"spn-47409","text":" — when the next automatic re-evaluation happens"}]}],"id":"blk-42217","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42219","kind":"paragraph","spans":[{"id":"spn-47410","text":"Use "},{"id":"spn-47411","marks":["code"],"text":"include_idle: true"},{"id":"spn-47412","text":" to also see goals that don't need attention right now."}]},{"id":"blk-42220","kind":"heading","level":2,"spans":[{"id":"spn-47413","text":"Run a Full Cycle (survey -> triage -> dispatch)"}]},{"id":"blk-42221","kind":"code","language":"text","text":"route(action: \"attention_cycle\", autono