{"bendscript":"0.1","blocks":[{"id":"blk-42086","kind":"paragraph","spans":[{"id":"spn-46743","text":"--- name: attention description: Use at session startup to regain context, for goal selection and prioritization, when the user asks \"what should I focus on?\", \"what needs attention?\", \"prioritize goals\", \"triage\", or for periodic status reporting. Routes through the "},{"id":"spn-46744","marks":["code"],"text":"route"},{"id":"spn-46745","text":" machine. argument-hint: [survey|cycle] [observe|advise|act] ---"}]},{"id":"blk-42087","kind":"heading","level":1,"spans":[{"id":"spn-46746","text":"Attention Engine"}]},{"id":"blk-42088","kind":"paragraph","spans":[{"id":"spn-46747","text":"Autonomous focus management — rank goals by urgency, knowledge gaps, and topology complexity."}]},{"id":"blk-42089","kind":"heading","level":2,"spans":[{"id":"spn-46748","text":"Arguments"}]},{"id":"blk-42090","kind":"paragraph","spans":[{"id":"spn-46749","text":"Mode: $ARGUMENTS"}]},{"id":"blk-42091","kind":"heading","level":2,"spans":[{"id":"spn-46750","text":"Survey (read-only ranking)"}]},{"id":"blk-42092","kind":"code","language":"text","text":"route(action: \"attention_survey\", include_idle: false)"},{"id":"blk-42093","kind":"paragraph","spans":[{"id":"spn-46751","text":"Returns ranked "},{"id":"spn-46752","marks":["code"],"text":"attention_items"},{"id":"spn-46753","text":" sorted by score (0.0-1.0). Each item includes:"}]},{"id":"blk-42094","items":[{"blocks":[{"id":"blk-42096","kind":"paragraph","spans":[{"id":"spn-46754","marks":["code"],"text":"goal_id"},{"id":"spn-46755","text":", "},{"id":"spn-46756","marks":["code"],"text":"goal_title"},{"id":"spn-46757","text":" — which goal"}]}],"id":"blk-42095","kind":"list-item"},{"blocks":[{"id":"blk-42098","kind":"paragraph","spans":[{"id":"spn-46758","marks":["code"],"text":"attention_score"},{"id":"spn-46759","text":" — composite priority (0.0-1.0)"}]}],"id":"blk-42097","kind":"list-item"},{"blocks":[{"id":"blk-42100","kind":"paragraph","spans":[{"id":"spn-46760","marks":["code"],"text":"dispatch_mode"},{"id":"spn-46761","text":" — "},{"id":"spn-46762","marks":["code"],"text":"act"},{"id":"spn-46763","text":", "},{"id":"spn-46764","marks":["code"],"text":"learn"},{"id":"spn-46765","text":", "},{"id":"spn-46766","marks":["code"],"text":"escalate"},{"id":"spn-46767","text":", or "},{"id":"spn-46768","marks":["code"],"text":"idle"}]}],"id":"blk-42099","kind":"list-item"},{"blocks":[{"id":"blk-42102","kind":"paragraph","spans":[{"id":"spn-46769","marks":["code"],"text":"coverage_score"},{"id":"spn-46770","text":", "},{"id":"spn-46771","marks":["code"],"text":"max_kappa"},{"id":"spn-46772","text":", "},{"id":"spn-46773","marks":["code"],"text":"routing"},{"id":"spn-46774","text":" — epistemic state"}]}],"id":"blk-42101","kind":"list-item"},{"blocks":[{"id":"blk-42104","kind":"paragraph","spans":[{"id":"spn-46775","marks":["code"],"text":"attention_rationale"},{"id":"spn-46776","text":" — compact summary of why this score"}]}],"id":"blk-42103","kind":"list-item"},{"blocks":[{"id":"blk-42106","kind":"paragraph","spans":[{"id":"spn-46777","marks":["code"],"text":"autonomy_level"},{"id":"spn-46778","text":" — current autonomy setting"}]}],"id":"blk-42105","kind":"list-item"},{"blocks":[{"id":"blk-42108","kind":"paragraph","spans":[{"id":"spn-46779","marks":["code"],"text":"next_heartbeat_in_ms"},{"id":"spn-46780","text":" — when the next automatic re-evaluation happens"}]}],"id":"blk-42107","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42109","kind":"paragraph","spans":[{"id":"spn-46781","text":"Use "},{"id":"spn-46782","marks":["code"],"text":"include_idle: true"},{"id":"spn-46783","text":" to also see goals that don't need attention right now."}]},{"id":"blk-42110","kind":"heading","level":2,"spans":[{"id":"spn-46784","text":"Run a Full Cycle (survey -> triage -> dispatch)"}]},{"id":"blk-42111","kind":"code","language":"text","text":"route(action: \"attention_cycle\", autono