{"bendscript":"0.1","blocks":[{"id":"blk-42682","kind":"paragraph","spans":[{"id":"spn-48546","text":"--- name: attention description: Use at session startup to regain context, for goal selection and prioritization, when the user asks \"what should I focus on?\", \"what needs attention?\", \"prioritize goals\", \"triage\", or for periodic status reporting. Routes through the "},{"id":"spn-48547","marks":["code"],"text":"route"},{"id":"spn-48548","text":" machine. argument-hint: [survey|cycle] [observe|advise|act] ---"}]},{"id":"blk-42683","kind":"heading","level":1,"spans":[{"id":"spn-48549","text":"Attention Engine"}]},{"id":"blk-42684","kind":"paragraph","spans":[{"id":"spn-48550","text":"Autonomous focus management — rank goals by urgency, knowledge gaps, and topology complexity."}]},{"id":"blk-42685","kind":"heading","level":2,"spans":[{"id":"spn-48551","text":"Arguments"}]},{"id":"blk-42686","kind":"paragraph","spans":[{"id":"spn-48552","text":"Mode: $ARGUMENTS"}]},{"id":"blk-42687","kind":"heading","level":2,"spans":[{"id":"spn-48553","text":"Survey (read-only ranking)"}]},{"id":"blk-42688","kind":"code","language":"text","text":"route(action: \"attention_survey\", include_idle: false)"},{"id":"blk-42689","kind":"paragraph","spans":[{"id":"spn-48554","text":"Returns ranked "},{"id":"spn-48555","marks":["code"],"text":"attention_items"},{"id":"spn-48556","text":" sorted by score (0.0-1.0). Each item includes:"}]},{"id":"blk-42690","items":[{"blocks":[{"id":"blk-42692","kind":"paragraph","spans":[{"id":"spn-48557","marks":["code"],"text":"goal_id"},{"id":"spn-48558","text":", "},{"id":"spn-48559","marks":["code"],"text":"goal_title"},{"id":"spn-48560","text":" — which goal"}]}],"id":"blk-42691","kind":"list-item"},{"blocks":[{"id":"blk-42694","kind":"paragraph","spans":[{"id":"spn-48561","marks":["code"],"text":"attention_score"},{"id":"spn-48562","text":" — composite priority (0.0-1.0)"}]}],"id":"blk-42693","kind":"list-item"},{"blocks":[{"id":"blk-42696","kind":"paragraph","spans":[{"id":"spn-48563","marks":["code"],"text":"dispatch_mode"},{"id":"spn-48564","text":" — "},{"id":"spn-48565","marks":["code"],"text":"act"},{"id":"spn-48566","text":", "},{"id":"spn-48567","marks":["code"],"text":"learn"},{"id":"spn-48568","text":", "},{"id":"spn-48569","marks":["code"],"text":"escalate"},{"id":"spn-48570","text":", or "},{"id":"spn-48571","marks":["code"],"text":"idle"}]}],"id":"blk-42695","kind":"list-item"},{"blocks":[{"id":"blk-42698","kind":"paragraph","spans":[{"id":"spn-48572","marks":["code"],"text":"coverage_score"},{"id":"spn-48573","text":", "},{"id":"spn-48574","marks":["code"],"text":"max_kappa"},{"id":"spn-48575","text":", "},{"id":"spn-48576","marks":["code"],"text":"routing"},{"id":"spn-48577","text":" — epistemic state"}]}],"id":"blk-42697","kind":"list-item"},{"blocks":[{"id":"blk-42700","kind":"paragraph","spans":[{"id":"spn-48578","marks":["code"],"text":"attention_rationale"},{"id":"spn-48579","text":" — compact summary of why this score"}]}],"id":"blk-42699","kind":"list-item"},{"blocks":[{"id":"blk-42702","kind":"paragraph","spans":[{"id":"spn-48580","marks":["code"],"text":"autonomy_level"},{"id":"spn-48581","text":" — current autonomy setting"}]}],"id":"blk-42701","kind":"list-item"},{"blocks":[{"id":"blk-42704","kind":"paragraph","spans":[{"id":"spn-48582","marks":["code"],"text":"next_heartbeat_in_ms"},{"id":"spn-48583","text":" — when the next automatic re-evaluation happens"}]}],"id":"blk-42703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42705","kind":"paragraph","spans":[{"id":"spn-48584","text":"Use "},{"id":"spn-48585","marks":["code"],"text":"include_idle: true"},{"id":"spn-48586","text":" to also see goals that don't need attention right now."}]},{"id":"blk-42706","kind":"heading","level":2,"spans":[{"id":"spn-48587","text":"Run a Full Cycle (survey -> triage -> dispatch)"}]},{"id":"blk-42707","kind":"code","language":"text","text":"route(action: \"attention_cycle\", autono