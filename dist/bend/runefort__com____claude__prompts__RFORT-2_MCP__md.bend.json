{"bendscript":"0.1","blocks":[{"id":"blk-82792","kind":"heading","level":1,"spans":[{"id":"spn-114859","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-82793","kind":"heading","level":2,"spans":[{"id":"spn-114860","text":"Goal"}]},{"id":"blk-82794","kind":"paragraph","spans":[{"id":"spn-114861","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-82795","kind":"heading","level":2,"spans":[{"id":"spn-114862","text":"Reference Implementation"}]},{"id":"blk-82796","kind":"paragraph","spans":[{"id":"spn-114863","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-82797","items":[{"blocks":[{"id":"blk-82799","kind":"paragraph","spans":[{"id":"spn-114864","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-114865","text":" — proxy route"}]}],"id":"blk-82798","kind":"list-item"},{"blocks":[{"id":"blk-82801","kind":"paragraph","spans":[{"id":"spn-114866","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-114867","text":" — client library"}]}],"id":"blk-82800","kind":"list-item"},{"blocks":[{"id":"blk-82803","kind":"paragraph","spans":[{"id":"spn-114868","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-114869","text":" — default servers"}]}],"id":"blk-82802","kind":"list-item"},{"blocks":[{"id":"blk-82805","kind":"paragraph","spans":[{"id":"spn-114870","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-114871","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-82804","kind":"list-item"},{"blocks":[{"id":"blk-82807","kind":"paragraph","spans":[{"id":"spn-114872","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-114873","text":" — connection UI"}]}],"id":"blk-82806","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82808","kind":"heading","level":2,"spans":[{"id":"spn-114874","text":"Files to Create"}]},{"id":"blk-82809","kind":"heading","level":3,"spans":[{"id":"spn-114875","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-82810","kind":"paragraph","spans":[{"id":"spn-114876","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-82811","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-82812","kind":"paragraph","spans":[{"id":"spn-114877","text":"Forwards to "},{"id":"spn-114878","marks":["code"],"text":"serverUrl"},{"id":"spn-114879","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-82813","kind":"heading","level":3,"spans":[{"id":"spn-114880","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-82814","kind":"paragraph","spans":[{"id":"spn-114881","text":"Functions:"}]},{"id":"blk-82815","items":[{"blocks":[{"id":"blk-82817","kind":"paragraph","spans":[{"id":"spn-114882","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-114883","text":" — sends "},{"id":"spn-114884","marks":["code"],"text":"initialize"},{"id":"spn-114885","text":" → "},{"id":"spn-114886","marks":["code"],"text":"notifications/initialized"},{"id":"spn-114887","text":" → "},{"id":"spn-114888","marks":["code"],"text":"tools/list"},{"id":"spn-114889","text":" through proxy. Returns "},{"id":"spn-114890","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-114891","text":"."}]}],"id":"blk-82816","kind":"list-item"},{"blocks":[{"id":"blk-82819","kind":"paragraph","spans":[{"id":"spn-114892","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-114893","text":" — sends "},