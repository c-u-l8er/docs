{"bendscript":"0.1","blocks":[{"id":"blk-82803","kind":"heading","level":1,"spans":[{"id":"spn-114912","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-82804","kind":"heading","level":2,"spans":[{"id":"spn-114913","text":"Goal"}]},{"id":"blk-82805","kind":"paragraph","spans":[{"id":"spn-114914","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-82806","kind":"heading","level":2,"spans":[{"id":"spn-114915","text":"Reference Implementation"}]},{"id":"blk-82807","kind":"paragraph","spans":[{"id":"spn-114916","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-82808","items":[{"blocks":[{"id":"blk-82810","kind":"paragraph","spans":[{"id":"spn-114917","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-114918","text":" — proxy route"}]}],"id":"blk-82809","kind":"list-item"},{"blocks":[{"id":"blk-82812","kind":"paragraph","spans":[{"id":"spn-114919","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-114920","text":" — client library"}]}],"id":"blk-82811","kind":"list-item"},{"blocks":[{"id":"blk-82814","kind":"paragraph","spans":[{"id":"spn-114921","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-114922","text":" — default servers"}]}],"id":"blk-82813","kind":"list-item"},{"blocks":[{"id":"blk-82816","kind":"paragraph","spans":[{"id":"spn-114923","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-114924","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-82815","kind":"list-item"},{"blocks":[{"id":"blk-82818","kind":"paragraph","spans":[{"id":"spn-114925","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-114926","text":" — connection UI"}]}],"id":"blk-82817","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82819","kind":"heading","level":2,"spans":[{"id":"spn-114927","text":"Files to Create"}]},{"id":"blk-82820","kind":"heading","level":3,"spans":[{"id":"spn-114928","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-82821","kind":"paragraph","spans":[{"id":"spn-114929","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-82822","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-82823","kind":"paragraph","spans":[{"id":"spn-114930","text":"Forwards to "},{"id":"spn-114931","marks":["code"],"text":"serverUrl"},{"id":"spn-114932","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-82824","kind":"heading","level":3,"spans":[{"id":"spn-114933","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-82825","kind":"paragraph","spans":[{"id":"spn-114934","text":"Functions:"}]},{"id":"blk-82826","items":[{"blocks":[{"id":"blk-82828","kind":"paragraph","spans":[{"id":"spn-114935","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-114936","text":" — sends "},{"id":"spn-114937","marks":["code"],"text":"initialize"},{"id":"spn-114938","text":" → "},{"id":"spn-114939","marks":["code"],"text":"notifications/initialized"},{"id":"spn-114940","text":" → "},{"id":"spn-114941","marks":["code"],"text":"tools/list"},{"id":"spn-114942","text":" through proxy. Returns "},{"id":"spn-114943","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-114944","text":"."}]}],"id":"blk-82827","kind":"list-item"},{"blocks":[{"id":"blk-82830","kind":"paragraph","spans":[{"id":"spn-114945","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-114946","text":" — sends "},