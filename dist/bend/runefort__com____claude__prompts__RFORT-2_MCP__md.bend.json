OLS"},{"id":"spn-114963","text":" array with RuneFort-specific tools:"}]}],"id":"blk-82840","kind":"list-item"},{"blocks":[{"id":"blk-82843","kind":"paragraph","spans":[{"id":"spn-114964","marks":["code"],"text":"navigate_fort"},{"id":"spn-114965","text":" — zoom to a specific level/node"}]}],"id":"blk-82842","kind":"list-item"},{"blocks":[{"id":"blk-82845","kind":"paragraph","spans":[{"id":"spn-114966","marks":["code"],"text":"list_forts"},{"id":"spn-114967","text":" — list loaded forts"}]}],"id":"blk-82844","kind":"list-item"},{"blocks":[{"id":"blk-82847","kind":"paragraph","spans":[{"id":"spn-114968","marks":["code"],"text":"get_fort_info"},{"id":"spn-114969","text":" — get current fort metadata"}]}],"id":"blk-82846","kind":"list-item"},{"blocks":[{"id":"blk-82849","kind":"paragraph","spans":[{"id":"spn-114970","marks":["code"],"text":"save_blueprint"},{"id":"spn-114971","text":" — save current fort to Supabase"}]}],"id":"blk-82848","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82850","kind":"heading","level":3,"spans":[{"id":"spn-114972","marks":["code"],"text":"src/lib/stores/mcp.svelte.js"}]},{"id":"blk-82851","kind":"paragraph","spans":[{"id":"spn-114973","text":"Svelte 5 rune store:"}]},{"id":"blk-82852","kind":"code","language":"js","text":"let _connections = $state([]);  // { url, name, label, version, tools, openaiTools, sessionId, status }\nexport function getConnections() { return _connections; }\nexport function addConnection(conn) { ... }\nexport function removeConnection(name) { ... }\nexport function getAllTools() { return _connections.flatMap(c => c.openaiTools); }\nexport async function autoConnect() { /* discover defaults + saved custom */ }"},{"id":"blk-82853","kind":"heading","level":3,"spans":[{"id":"spn-114974","marks":["code"],"text":"src/components/app/McpPanel.svelte"}]},{"id":"blk-82854","kind":"paragraph","spans":[{"id":"spn-114975","text":"Slide-out panel (right side). Shows:"}]},{"id":"blk-82855","items":[{"blocks":[{"id":"blk-82857","kind":"paragraph","spans":[{"id":"spn-114976","text":"Connected servers with tool count badges"}]}],"id":"blk-82856","kind":"list-item"},{"blocks":[{"id":"blk-82859","kind":"paragraph","spans":[{"id":"spn-114977","text":"URL + optional auth token input for custom servers"}]}],"id":"blk-82858","kind":"list-item"},{"blocks":[{"id":"blk-82861","kind":"paragraph","spans":[{"id":"spn-114978","text":"Connect/disconnect buttons"}]}],"id":"blk-82860","kind":"list-item"},{"blocks":[{"id":"blk-82863","kind":"paragraph","spans":[{"id":"spn-114979","text":"Status indicators (connecting/connected/error)"}]}],"id":"blk-82862","kind":"list-item"},{"blocks":[{"id":"blk-82865","kind":"paragraph","spans":[{"id":"spn-114980","text":"Matches RuneFort dark amber theme"}]}],"id":"blk-82864","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82866","kind":"heading","level":2,"spans":[{"id":"spn-114981","text":"Integration Point"}]},{"id":"blk-82867","kind":"paragraph","spans":[{"id":"spn-114982","text":"Add a plug/connection icon button to the "},{"id":"spn-114983","marks":["code"],"text":"/app"},{"id":"spn-114984","text":" toolbar. Opens McpPanel as a slide-over. Badge shows connected server count."}]},{"id":"blk-82868","kind":"heading","level":2,"spans":[{"id":"spn-114985","text":"Constraints"}]},{"id":"blk-82869","items":[{"blocks":[{"id":"blk-82871","kind":"paragraph","spans":[{"id":"spn-114986","text":"Proxy must handle both JSON and SSE responses"}]}],"id":"blk-82870","kind":"list-item"},{"blocks":[{"id":"blk-82873","kind":"paragraph","spans":[{"id":"spn-114987","text":"MCP JSON-RPC 2.0 protocol (initialize → notifications/initialized → tools/list)"}]}],"id":"blk-82872","kind":"list-item"},{"blocks":[{"id":"blk-82875","kind":"paragraph","spans":[{"id":"spn-114988","text":"Session ID must persist across calls to same server"}]}],"id":"blk-82874","kind":"list-item"},{"blocks":[{"id":"blk-82877","kind":"paragraph","spans":[{"id":"spn-114989","text":"Save cu