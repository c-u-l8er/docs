{"bendscript":"0.1","blocks":[{"id":"blk-106256","kind":"heading","level":1,"spans":[{"id":"spn-171399","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-106257","kind":"heading","level":2,"spans":[{"id":"spn-171400","text":"Goal"}]},{"id":"blk-106258","kind":"paragraph","spans":[{"id":"spn-171401","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-106259","kind":"heading","level":2,"spans":[{"id":"spn-171402","text":"Reference Implementation"}]},{"id":"blk-106260","kind":"paragraph","spans":[{"id":"spn-171403","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-106261","items":[{"blocks":[{"id":"blk-106263","kind":"paragraph","spans":[{"id":"spn-171404","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-171405","text":" — proxy route"}]}],"id":"blk-106262","kind":"list-item"},{"blocks":[{"id":"blk-106265","kind":"paragraph","spans":[{"id":"spn-171406","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-171407","text":" — client library"}]}],"id":"blk-106264","kind":"list-item"},{"blocks":[{"id":"blk-106267","kind":"paragraph","spans":[{"id":"spn-171408","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-171409","text":" — default servers"}]}],"id":"blk-106266","kind":"list-item"},{"blocks":[{"id":"blk-106269","kind":"paragraph","spans":[{"id":"spn-171410","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-171411","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-106268","kind":"list-item"},{"blocks":[{"id":"blk-106271","kind":"paragraph","spans":[{"id":"spn-171412","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-171413","text":" — connection UI"}]}],"id":"blk-106270","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106272","kind":"heading","level":2,"spans":[{"id":"spn-171414","text":"Files to Create"}]},{"id":"blk-106273","kind":"heading","level":3,"spans":[{"id":"spn-171415","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-106274","kind":"paragraph","spans":[{"id":"spn-171416","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-106275","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-106276","kind":"paragraph","spans":[{"id":"spn-171417","text":"Forwards to "},{"id":"spn-171418","marks":["code"],"text":"serverUrl"},{"id":"spn-171419","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-106277","kind":"heading","level":3,"spans":[{"id":"spn-171420","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-106278","kind":"paragraph","spans":[{"id":"spn-171421","text":"Functions:"}]},{"id":"blk-106279","items":[{"blocks":[{"id":"blk-106281","kind":"paragraph","spans":[{"id":"spn-171422","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-171423","text":" — sends "},{"id":"spn-171424","marks":["code"],"text":"initialize"},{"id":"spn-171425","text":" → "},{"id":"spn-171426","marks":["code"],"text":"notifications/initialized"},{"id":"spn-171427","text":" → "},{"id":"spn-171428","marks":["code"],"text":"tools/list"},{"id":"spn-171429","text":" through proxy. Returns "},{"id":"spn-171430","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-171431","text":"."}]}],"id":"blk-106280","kind":"list-item"},{"blocks":[{"id":"blk-106283","kind":"paragraph","spans":[{"id":"spn-171432","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-171433","text":" — sends "},{"id":"spn-171434","marks":["code"],"text":"tools/call"},{"id":"spn-171435","text":" through proxy. Returns result."}]}],"id":"blk-106282","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106284","kind":"paragraph","spans":[{"id":"spn-171436","text":"All calls go through "},{"id":"spn-171437","marks":["code"],"text":"/api/mcp-proxy"},{"id":"spn-171438","text":" to avoid CORS."}]},{"id":"blk-106285","kind":"heading","level":3,"spans":[{"id":"spn-171439","marks":["code"],"text":"src/lib/play/default-servers.js"}]},{"id":"blk-106286","kind":"code","language":"js","text":"export const DEFAULT_MCP_SERVERS = [\n  { url: 'https://graphonomous-mcp.fly.dev/mcp', name: 'graphonomous', label: 'Graphonomous Memory' },\n  { url: 'https://prism-eval.fly.dev/mcp', name: 'os-prism', label: 'PRISM Benchmarks' },\n  { url: 'https://box-and-box-mcp.fly.dev/mcp', name: 'box-and-box', label: '[&] Protocol' },\n  { url: 'https://os-pulse-mcp.fly.dev/mcp', name: 'os-pulse', label: 'PULSE Manifests' },\n];"},{"id":"blk-106287","kind":"heading","level":3,"spans":[{"id":"spn-171440","marks":["code"],"text":"src/lib/play/tools.js"}]},{"id":"blk-106288","items":[{"blocks":[{"id":"blk-106290","kind":"paragraph","spans":[{"id":"spn-171441","marks":["code"],"text":"mcpToolsToOpenAI(serverName, mcpTools)"},{"id":"spn-171442","text":" — converts MCP tool schemas to OpenAI function-calling format, namespaced as "},{"id":"spn-171443","marks":["code"],"text":"mcp__<serverName>__<toolName>"},{"id":"spn-171444","text":"."}]}],"id":"blk-106289","kind":"list-item"},{"blocks":[{"id":"blk-106292","kind":"paragraph","spans":[{"id":"spn-171445","marks":["code"],"text":"parseMcpToolName(name)"},{"id":"spn-171446","text":" — extracts "},{"id":"spn-171447","marks":["code"],"text":"{ serverName, toolName }"},{"id":"spn-171448","text":" from namespaced name."}]}],"id":"blk-106291","kind":"list-item"},{"blocks":[{"id":"blk-106294","kind":"paragraph","spans":[{"id":"spn-171449","marks":["code"],"text":"BUILTIN_TOOLS"},{"id":"spn-171450","text":" array with RuneFort-specific tools:"}]}],"id":"blk-106293","kind":"list-item"},{"blocks":[{"id":"blk-106296","kind":"paragraph","spans":[{"id":"spn-171451","marks":["code"],"text":"navigate_fort"},{"id":"spn-171452","text":" — zoom to a specific level/node"}]}],"id":"blk-106295","kind":"list-item"},{"blocks":[{"id":"blk-106298","kind":"paragraph","spans":[{"id":"spn-171453","marks":["code"],"text":"list_forts"},{"id":"spn-171454","text":" — list loaded forts"}]}],"id":"blk-106297","kind":"list-item"},{"blocks":[{"id":"blk-106300","kind":"paragraph","spans":[{"id":"spn-171455","marks":["code"],"text":"get_fort_info"},{"id":"spn-171456","text":" — get current fort metadata"}]}],"id":"blk-106299","kind":"list-item"},{"blocks":[{"id":"blk-106302","kind":"paragraph","spans":[{"id":"spn-171457","marks":["code"],"text":"save_blueprint"},{"id":"spn-171458","text":" — save current fort to Supabase"}]}],"id":"blk-106301","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-106303","kind":"heading","level":3,"spans":[{"id":"spn-171459","marks":["code"],"text":"src/lib/stores/mcp.svelte.js"}]},{"id":"blk-106304","kind":"paragraph","spans":[{"id":"spn-171460","text":"Svelte 5 rune store:"}]},{"id":"blk-106305","kind":"code","language":"js","text":"let _connections = $state([]);  // { url, name, label, version, tools, openaiTools, sessionId, status }\nexport function getConnections() { return _connections; }\nexport function addConnection(conn) { ... }\nexport function removeConnection(name) { ... }\nexport function getAllTools() { return _connections.flatMap(c => c.openaiTools); }\nexport async function autoConnect() { /* discover defaults + saved custom */ }"},{"id":"blk-106306","kind":"heading","level":3,"spans":[{"id":"spn-171461","marks":["code"],"text":"src/components/app/McpPanel.svelte"}]},{"id":"blk-106307","kind":"paragraph","spans":[{"id":"spn-171462","text":"Slide-out panel (right side).