{"bendscript":"0.1","blocks":[{"id":"blk-83757","kind":"heading","level":1,"spans":[{"id":"spn-117699","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-83758","kind":"heading","level":2,"spans":[{"id":"spn-117700","text":"Goal"}]},{"id":"blk-83759","kind":"paragraph","spans":[{"id":"spn-117701","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-83760","kind":"heading","level":2,"spans":[{"id":"spn-117702","text":"Reference Implementation"}]},{"id":"blk-83761","kind":"paragraph","spans":[{"id":"spn-117703","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-83762","items":[{"blocks":[{"id":"blk-83764","kind":"paragraph","spans":[{"id":"spn-117704","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-117705","text":" — proxy route"}]}],"id":"blk-83763","kind":"list-item"},{"blocks":[{"id":"blk-83766","kind":"paragraph","spans":[{"id":"spn-117706","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-117707","text":" — client library"}]}],"id":"blk-83765","kind":"list-item"},{"blocks":[{"id":"blk-83768","kind":"paragraph","spans":[{"id":"spn-117708","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-117709","text":" — default servers"}]}],"id":"blk-83767","kind":"list-item"},{"blocks":[{"id":"blk-83770","kind":"paragraph","spans":[{"id":"spn-117710","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-117711","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-83769","kind":"list-item"},{"blocks":[{"id":"blk-83772","kind":"paragraph","spans":[{"id":"spn-117712","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-117713","text":" — connection UI"}]}],"id":"blk-83771","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83773","kind":"heading","level":2,"spans":[{"id":"spn-117714","text":"Files to Create"}]},{"id":"blk-83774","kind":"heading","level":3,"spans":[{"id":"spn-117715","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-83775","kind":"paragraph","spans":[{"id":"spn-117716","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-83776","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-83777","kind":"paragraph","spans":[{"id":"spn-117717","text":"Forwards to "},{"id":"spn-117718","marks":["code"],"text":"serverUrl"},{"id":"spn-117719","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-83778","kind":"heading","level":3,"spans":[{"id":"spn-117720","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-83779","kind":"paragraph","spans":[{"id":"spn-117721","text":"Functions:"}]},{"id":"blk-83780","items":[{"blocks":[{"id":"blk-83782","kind":"paragraph","spans":[{"id":"spn-117722","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-117723","text":" — sends "},{"id":"spn-117724","marks":["code"],"text":"initialize"},{"id":"spn-117725","text":" → "},{"id":"spn-117726","marks":["code"],"text":"notifications/initialized"},{"id":"spn-117727","text":" → "},{"id":"spn-117728","marks":["code"],"text":"tools/list"},{"id":"spn-117729","text":" through proxy. Returns "},{"id":"spn-117730","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-117731","text":"."}]}],"id":"blk-83781","kind":"list-item"},{"blocks":[{"id":"blk-83784","kind":"paragraph","spans":[{"id":"spn-117732","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-117733","text":" — sends "},