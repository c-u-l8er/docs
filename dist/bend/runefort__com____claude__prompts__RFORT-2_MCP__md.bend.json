{"bendscript":"0.1","blocks":[{"id":"blk-56101","kind":"heading","level":1,"spans":[{"id":"spn-63903","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-56102","kind":"heading","level":2,"spans":[{"id":"spn-63904","text":"Goal"}]},{"id":"blk-56103","kind":"paragraph","spans":[{"id":"spn-63905","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-56104","kind":"heading","level":2,"spans":[{"id":"spn-63906","text":"Reference Implementation"}]},{"id":"blk-56105","kind":"paragraph","spans":[{"id":"spn-63907","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-56106","items":[{"blocks":[{"id":"blk-56108","kind":"paragraph","spans":[{"id":"spn-63908","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-63909","text":" — proxy route"}]}],"id":"blk-56107","kind":"list-item"},{"blocks":[{"id":"blk-56110","kind":"paragraph","spans":[{"id":"spn-63910","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-63911","text":" — client library"}]}],"id":"blk-56109","kind":"list-item"},{"blocks":[{"id":"blk-56112","kind":"paragraph","spans":[{"id":"spn-63912","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-63913","text":" — default servers"}]}],"id":"blk-56111","kind":"list-item"},{"blocks":[{"id":"blk-56114","kind":"paragraph","spans":[{"id":"spn-63914","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-63915","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-56113","kind":"list-item"},{"blocks":[{"id":"blk-56116","kind":"paragraph","spans":[{"id":"spn-63916","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-63917","text":" — connection UI"}]}],"id":"blk-56115","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56117","kind":"heading","level":2,"spans":[{"id":"spn-63918","text":"Files to Create"}]},{"id":"blk-56118","kind":"heading","level":3,"spans":[{"id":"spn-63919","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-56119","kind":"paragraph","spans":[{"id":"spn-63920","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-56120","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-56121","kind":"paragraph","spans":[{"id":"spn-63921","text":"Forwards to "},{"id":"spn-63922","marks":["code"],"text":"serverUrl"},{"id":"spn-63923","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-56122","kind":"heading","level":3,"spans":[{"id":"spn-63924","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-56123","kind":"paragraph","spans":[{"id":"spn-63925","text":"Functions:"}]},{"id":"blk-56124","items":[{"blocks":[{"id":"blk-56126","kind":"paragraph","spans":[{"id":"spn-63926","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-63927","text":" — sends "},{"id":"spn-63928","marks":["code"],"text":"initialize"},{"id":"spn-63929","text":" → "},{"id":"spn-63930","marks":["code"],"text":"notifications/initialized"},{"id":"spn-63931","text":" → "},{"id":"spn-63932","marks":["code"],"text":"tools/list"},{"id":"spn-63933","text":" through proxy. Returns "},{"id":"spn-63934","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-63935","text":"."}]}],"id":"blk-56125","kind":"list-item"},{"blocks":[{"id":"blk-56128","kind":"paragraph","spans":[{"id":"spn-63936","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-63937","text":" — sends "},{"id":"spn-63938","marks":["code"],"text":"tools/call"},{"id":"spn-63939","text":" through proxy. Returns result."}]}],"id":"blk-56127","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56129","kind":"paragraph","spans":[{"id":"spn-63940","text":"All calls go through "},{"id":"spn-63941","marks":["code"],"text":"/api/mcp-proxy"},{"id":"spn-63942","text":" to avoid CORS."}]},{"id":"blk-56130","kind":"heading","level":3,"spans":[{"id":"spn-63943","marks":["code"],"text":"src/lib/play/default-servers.js"}]},{"id":"blk-56131","kind":"code","language":"js","text":"export const DEFAULT_MCP_SERVERS = [\n  { url: 'https://graphonomous-mcp.fly.dev/mcp', name: 'graphonomous', label: 'Graphonomous Memory' },\n  { url: 'https://prism-eval.fly.dev/mcp', name: 'os-prism', label: 'PRISM Benchmarks' },\n  { url: 'https://box-and-box-mcp.fly.dev/mcp', name: 'box-and-box', label: '[&] Protocol' },\n  { url: 'https://os-pulse-mcp.fly.dev/mcp', name: 'os-pulse', label: 'PULSE Manifests' },\n];"},{"id":"blk-56132","kind":"heading","level":3,"spans":[{"id":"spn-63944","marks":["code"],"text":"src/lib/play/tools.js"}]},{"id":"blk-56133","items":[{"blocks":[{"id":"blk-56135","kind":"paragraph","spans":[{"id":"spn-63945","marks":["code"],"text":"mcpToolsToOpenAI(serverName, mcpTools)"},{"id":"spn-63946","text":" — converts MCP tool schemas to OpenAI function-calling format, namespaced as "},{"id":"spn-63947","marks":["code"],"text":"mcp__<serverName>__<toolName>"},{"id":"spn-63948","text":"."}]}],"id":"blk-56134","kind":"list-item"},{"blocks":[{"id":"blk-56137","kind":"paragraph","spans":[{"id":"spn-63949","marks":["code"],"text":"parseMcpToolName(name)"},{"id":"spn-63950","text":" — extracts "},{"id":"spn-63951","marks":["code"],"text":"{ serverName, toolName }"},{"id":"spn-63952","text":" from namespaced name."}]}],"id":"blk-56136","kind":"list-item"},{"blocks":[{"id":"blk-56139","kind":"paragraph","spans":[{"id":"spn-63953","marks":["code"],"text":"BUILTIN_TOOLS"},{"id":"spn-63954","text":" array with RuneFor