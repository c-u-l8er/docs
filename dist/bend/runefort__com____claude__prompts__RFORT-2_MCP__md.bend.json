{"bendscript":"0.1","blocks":[{"id":"blk-57203","kind":"heading","level":1,"spans":[{"id":"spn-66909","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-57204","kind":"heading","level":2,"spans":[{"id":"spn-66910","text":"Goal"}]},{"id":"blk-57205","kind":"paragraph","spans":[{"id":"spn-66911","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-57206","kind":"heading","level":2,"spans":[{"id":"spn-66912","text":"Reference Implementation"}]},{"id":"blk-57207","kind":"paragraph","spans":[{"id":"spn-66913","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-57208","items":[{"blocks":[{"id":"blk-57210","kind":"paragraph","spans":[{"id":"spn-66914","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-66915","text":" — proxy route"}]}],"id":"blk-57209","kind":"list-item"},{"blocks":[{"id":"blk-57212","kind":"paragraph","spans":[{"id":"spn-66916","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-66917","text":" — client library"}]}],"id":"blk-57211","kind":"list-item"},{"blocks":[{"id":"blk-57214","kind":"paragraph","spans":[{"id":"spn-66918","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-66919","text":" — default servers"}]}],"id":"blk-57213","kind":"list-item"},{"blocks":[{"id":"blk-57216","kind":"paragraph","spans":[{"id":"spn-66920","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-66921","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-57215","kind":"list-item"},{"blocks":[{"id":"blk-57218","kind":"paragraph","spans":[{"id":"spn-66922","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-66923","text":" — connection UI"}]}],"id":"blk-57217","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57219","kind":"heading","level":2,"spans":[{"id":"spn-66924","text":"Files to Create"}]},{"id":"blk-57220","kind":"heading","level":3,"spans":[{"id":"spn-66925","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-57221","kind":"paragraph","spans":[{"id":"spn-66926","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-57222","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-57223","kind":"paragraph","spans":[{"id":"spn-66927","text":"Forwards to "},{"id":"spn-66928","marks":["code"],"text":"serverUrl"},{"id":"spn-66929","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-57224","kind":"heading","level":3,"spans":[{"id":"spn-66930","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-57225","kind":"paragraph","spans":[{"id":"spn-66931","text":"Functions:"}]},{"id":"blk-57226","items":[{"blocks":[{"id":"blk-57228","kind":"paragraph","spans":[{"id":"spn-66932","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-66933","text":" — sends "},{"id":"spn-66934","marks":["code"],"text":"initialize"},{"id":"spn-66935","text":" → "},{"id":"spn-66936","marks":["code"],"text":"notifications/initialized"},{"id":"spn-66937","text":" → "},{"id":"spn-66938","marks":["code"],"text":"tools/list"},{"id":"spn-66939","text":" through proxy. Returns "},{"id":"spn-66940","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-66941","text":"."}]}],"id":"blk-57227","kind":"list-item"},{"blocks":[{"id":"blk-57230","kind":"paragraph","spans":[{"id":"spn-66942","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-66943","text":" — sends "},{"id":"spn-66944","marks":["code"],"text":"tools/call"},{"id":"spn-66945","text":" through proxy. Returns result."}]}],"id":"blk-57229","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-57231","kind":"paragraph","spans":[{"id":"spn-66946","text":"All calls go through "},{"id":"spn-66947","marks":["code"],"text":"/api/mcp-proxy"},{"id":"spn-66948","text":" to avoid CORS."}]},{"id":"blk-57232","kind":"heading","level":3,"spans":[{"id":"spn-66949","marks":["code"],"text":"src/lib/play/default-servers.js"}]},{"id":"blk-57233","kind":"code","language":"js","text":"export const DEFAULT_MCP_SERVERS = [\n  { url: 'https://graphonomous-mcp.fly.dev/mcp', name: 'graphonomous', label: 'Graphonomous Memory' },\n  { url: 'https://prism-eval.fly.dev/mcp', name: 'os-prism', label: 'PRISM Benchmarks' },\n  { url: 'https://box-and-box-mcp.fly.dev/mcp', name: 'box-and-box', label: '[&] Protocol' },\n  { url: 'https://os-pulse-mcp.fly.dev/mcp', name: 'os-pulse', label: 'PULSE Manifests' },\n];"},{"id":"blk-57234","kind":"heading","level":3,"spans":[{"id":"spn-66950","marks":["code"],"text":"src/lib/play/tools.js"}]},{"id":"blk-57235","items":[{"blocks":[{"id":"blk-57237","kind":"paragraph","spans":[{"id":"spn-66951","marks":["code"],"text":"mcpToolsToOpenAI(serverName, mcpTools)"},{"id":"spn-66952","text":" — converts MCP tool schemas to OpenAI function-calling format, namespaced as "},{"id":"spn-66953","marks":["code"],"text":"mcp__<serverName>__<toolName>"},{"id":"spn-66954","text":"."}]}],"id":"blk-57236","kind":"list-item"},{"blocks":[{"id":"blk-57239","kind":"paragraph","spans":[{"id":"spn-66955","marks":["code"],"text":"parseMcpToolName(name)"},{"id":"spn-66956","text":" — extracts "},{"id":"spn-66957","marks":["code"],"text":"{ serverName, toolName }"},{"id":"spn-66958","text":" from namespaced name."}]}],"id":"blk-57238","kind":"list-item"},{"blocks":[{"id":"blk-57241","kind":"paragraph","spans":[{"id":"spn-66959","marks":["code"],"text":"BUILTIN_TOOLS"},{"id":"spn-66960","text":" array with RuneFor