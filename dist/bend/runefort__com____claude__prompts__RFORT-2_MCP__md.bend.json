{"bendscript":"0.1","blocks":[{"id":"blk-56231","kind":"heading","level":1,"spans":[{"id":"spn-64615","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-56232","kind":"heading","level":2,"spans":[{"id":"spn-64616","text":"Goal"}]},{"id":"blk-56233","kind":"paragraph","spans":[{"id":"spn-64617","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-56234","kind":"heading","level":2,"spans":[{"id":"spn-64618","text":"Reference Implementation"}]},{"id":"blk-56235","kind":"paragraph","spans":[{"id":"spn-64619","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-56236","items":[{"blocks":[{"id":"blk-56238","kind":"paragraph","spans":[{"id":"spn-64620","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-64621","text":" — proxy route"}]}],"id":"blk-56237","kind":"list-item"},{"blocks":[{"id":"blk-56240","kind":"paragraph","spans":[{"id":"spn-64622","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-64623","text":" — client library"}]}],"id":"blk-56239","kind":"list-item"},{"blocks":[{"id":"blk-56242","kind":"paragraph","spans":[{"id":"spn-64624","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-64625","text":" — default servers"}]}],"id":"blk-56241","kind":"list-item"},{"blocks":[{"id":"blk-56244","kind":"paragraph","spans":[{"id":"spn-64626","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-64627","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-56243","kind":"list-item"},{"blocks":[{"id":"blk-56246","kind":"paragraph","spans":[{"id":"spn-64628","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-64629","text":" — connection UI"}]}],"id":"blk-56245","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56247","kind":"heading","level":2,"spans":[{"id":"spn-64630","text":"Files to Create"}]},{"id":"blk-56248","kind":"heading","level":3,"spans":[{"id":"spn-64631","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-56249","kind":"paragraph","spans":[{"id":"spn-64632","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-56250","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-56251","kind":"paragraph","spans":[{"id":"spn-64633","text":"Forwards to "},{"id":"spn-64634","marks":["code"],"text":"serverUrl"},{"id":"spn-64635","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-56252","kind":"heading","level":3,"spans":[{"id":"spn-64636","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-56253","kind":"paragraph","spans":[{"id":"spn-64637","text":"Functions:"}]},{"id":"blk-56254","items":[{"blocks":[{"id":"blk-56256","kind":"paragraph","spans":[{"id":"spn-64638","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-64639","text":" — sends "},{"id":"spn-64640","marks":["code"],"text":"initialize"},{"id":"spn-64641","text":" → "},{"id":"spn-64642","marks":["code"],"text":"notifications/initialized"},{"id":"spn-64643","text":" → "},{"id":"spn-64644","marks":["code"],"text":"tools/list"},{"id":"spn-64645","text":" through proxy. Returns "},{"id":"spn-64646","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-64647","text":"."}]}],"id":"blk-56255","kind":"list-item"},{"blocks":[{"id":"blk-56258","kind":"paragraph","spans":[{"id":"spn-64648","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-64649","text":" — sends "},{"id":"spn-64650","marks":["code"],"text":"tools/call"},{"id":"spn-64651","text":" through proxy. Returns result."}]}],"id":"blk-56257","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56259","kind":"paragraph","spans":[{"id":"spn-64652","text":"All calls go through "},{"id":"spn-64653","marks":["code"],"text":"/api/mcp-proxy"},{"id":"spn-64654","text":" to avoid CORS."}]},{"id":"blk-56260","kind":"heading","level":3,"spans":[{"id":"spn-64655","marks":["code"],"text":"src/lib/play/default-servers.js"}]},{"id":"blk-56261","kind":"code","language":"js","text":"export const DEFAULT_MCP_SERVERS = [\n  { url: 'https://graphonomous-mcp.fly.dev/mcp', name: 'graphonomous', label: 'Graphonomous Memory' },\n  { url: 'https://prism-eval.fly.dev/mcp', name: 'os-prism', label: 'PRISM Benchmarks' },\n  { url: 'https://box-and-box-mcp.fly.dev/mcp', name: 'box-and-box', label: '[&] Protocol' },\n  { url: 'https://os-pulse-mcp.fly.dev/mcp', name: 'os-pulse', label: 'PULSE Manifests' },\n];"},{"id":"blk-56262","kind":"heading","level":3,"spans":[{"id":"spn-64656","marks":["code"],"text":"src/lib/play/tools.js"}]},{"id":"blk-56263","items":[{"blocks":[{"id":"blk-56265","kind":"paragraph","spans":[{"id":"spn-64657","marks":["code"],"text":"mcpToolsToOpenAI(serverName, mcpTools)"},{"id":"spn-64658","text":" — converts MCP tool schemas to OpenAI function-calling format, namespaced as "},{"id":"spn-64659","marks":["code"],"text":"mcp__<serverName>__<toolName>"},{"id":"spn-64660","text":"."}]}],"id":"blk-56264","kind":"list-item"},{"blocks":[{"id":"blk-56267","kind":"paragraph","spans":[{"id":"spn-64661","marks":["code"],"text":"parseMcpToolName(name)"},{"id":"spn-64662","text":" — extracts "},{"id":"spn-64663","marks":["code"],"text":"{ serverName, toolName }"},{"id":"spn-64664","text":" from namespaced name."}]}],"id":"blk-56266","kind":"list-item"},{"blocks":[{"id":"blk-56269","kind":"paragraph","spans":[{"id":"spn-64665","marks":["code"],"text":"BUILTIN_TOOLS"},{"id":"spn-64666","text":" array with RuneFor