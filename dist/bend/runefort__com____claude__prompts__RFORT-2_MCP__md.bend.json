OLS"},{"id":"spn-117750","text":" array with RuneFort-specific tools:"}]}],"id":"blk-83794","kind":"list-item"},{"blocks":[{"id":"blk-83797","kind":"paragraph","spans":[{"id":"spn-117751","marks":["code"],"text":"navigate_fort"},{"id":"spn-117752","text":" — zoom to a specific level/node"}]}],"id":"blk-83796","kind":"list-item"},{"blocks":[{"id":"blk-83799","kind":"paragraph","spans":[{"id":"spn-117753","marks":["code"],"text":"list_forts"},{"id":"spn-117754","text":" — list loaded forts"}]}],"id":"blk-83798","kind":"list-item"},{"blocks":[{"id":"blk-83801","kind":"paragraph","spans":[{"id":"spn-117755","marks":["code"],"text":"get_fort_info"},{"id":"spn-117756","text":" — get current fort metadata"}]}],"id":"blk-83800","kind":"list-item"},{"blocks":[{"id":"blk-83803","kind":"paragraph","spans":[{"id":"spn-117757","marks":["code"],"text":"save_blueprint"},{"id":"spn-117758","text":" — save current fort to Supabase"}]}],"id":"blk-83802","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-83804","kind":"heading","level":3,"spans":[{"id":"spn-117759","marks":["code"],"text":"src/lib/stores/mcp.svelte.js"}]},{"id":"blk-83805","kind":"paragraph","spans":[{"id":"spn-117760","text":"Svelte 5 rune store:"}]},{"id":"blk-83806","kind":"code","language":"js","text":"let _connections = $state([]);  // { url, name, label, version, tools, openaiTools, sessionId, status }\nexport function getConnections() { return _connections; }\nexport function addConnection(conn) { ... }\nexport function removeConnection(name) { ... }\nexport function getAllTools() { return _connections.flatMap(c => c.openaiTools); }\nexport async function autoConnect() { /* discover defaults + saved custom */ }"},{"id":"blk-83807","kind":"heading","level":3,"spans":[{"id":"spn-117761","marks":["code"],"text":"src/components/app/McpPanel.svelte"}]},{"id":"blk-83808","kind":"paragraph","spans":[{"id":"spn-117762","text":"Slide-out panel (right side). Shows:"}]},{"id":"blk-83809","items":[{"blocks":[{"