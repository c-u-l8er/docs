{"bendscript":"0.1","blocks":[{"id":"blk-82929","kind":"heading","level":1,"spans":[{"id":"spn-115060","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-82930","kind":"heading","level":2,"spans":[{"id":"spn-115061","text":"Goal"}]},{"id":"blk-82931","kind":"paragraph","spans":[{"id":"spn-115062","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-82932","kind":"heading","level":2,"spans":[{"id":"spn-115063","text":"Reference Implementation"}]},{"id":"blk-82933","kind":"paragraph","spans":[{"id":"spn-115064","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-82934","items":[{"blocks":[{"id":"blk-82936","kind":"paragraph","spans":[{"id":"spn-115065","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-115066","text":" — proxy route"}]}],"id":"blk-82935","kind":"list-item"},{"blocks":[{"id":"blk-82938","kind":"paragraph","spans":[{"id":"spn-115067","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-115068","text":" — client library"}]}],"id":"blk-82937","kind":"list-item"},{"blocks":[{"id":"blk-82940","kind":"paragraph","spans":[{"id":"spn-115069","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-115070","text":" — default servers"}]}],"id":"blk-82939","kind":"list-item"},{"blocks":[{"id":"blk-82942","kind":"paragraph","spans":[{"id":"spn-115071","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-115072","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-82941","kind":"list-item"},{"blocks":[{"id":"blk-82944","kind":"paragraph","spans":[{"id":"spn-115073","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-115074","text":" — connection UI"}]}],"id":"blk-82943","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82945","kind":"heading","level":2,"spans":[{"id":"spn-115075","text":"Files to Create"}]},{"id":"blk-82946","kind":"heading","level":3,"spans":[{"id":"spn-115076","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-82947","kind":"paragraph","spans":[{"id":"spn-115077","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-82948","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-82949","kind":"paragraph","spans":[{"id":"spn-115078","text":"Forwards to "},{"id":"spn-115079","marks":["code"],"text":"serverUrl"},{"id":"spn-115080","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-82950","kind":"heading","level":3,"spans":[{"id":"spn-115081","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-82951","kind":"paragraph","spans":[{"id":"spn-115082","text":"Functions:"}]},{"id":"blk-82952","items":[{"blocks":[{"id":"blk-82954","kind":"paragraph","spans":[{"id":"spn-115083","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-115084","text":" — sends "},{"id":"spn-115085","marks":["code"],"text":"initialize"},{"id":"spn-115086","text":" → "},{"id":"spn-115087","marks":["code"],"text":"notifications/initialized"},{"id":"spn-115088","text":" → "},{"id":"spn-115089","marks":["code"],"text":"tools/list"},{"id":"spn-115090","text":" through proxy. Returns "},{"id":"spn-115091","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-115092","text":"."}]}],"id":"blk-82953","kind":"list-item"},{"blocks":[{"id":"blk-82956","kind":"paragraph","spans":[{"id":"spn-115093","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-115094","text":" — sends "},