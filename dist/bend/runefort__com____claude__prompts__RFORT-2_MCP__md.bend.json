{"bendscript":"0.1","blocks":[{"id":"blk-56717","kind":"heading","level":1,"spans":[{"id":"spn-65789","text":"RFort-2: MCP Proxy + Client + Connection Panel"}]},{"id":"blk-56718","kind":"heading","level":2,"spans":[{"id":"spn-65790","text":"Goal"}]},{"id":"blk-56719","kind":"paragraph","spans":[{"id":"spn-65791","text":"Add MCP server connectivity to RuneFort. A SvelteKit server route proxies JSON-RPC to external MCP servers (avoiding CORS). A client library discovers tools and calls them. A UI panel manages connections."}]},{"id":"blk-56720","kind":"heading","level":2,"spans":[{"id":"spn-65792","text":"Reference Implementation"}]},{"id":"blk-56721","kind":"paragraph","spans":[{"id":"spn-65793","text":"Port from these BendScript files, adapting to RuneFort's structure:"}]},{"id":"blk-56722","items":[{"blocks":[{"id":"blk-56724","kind":"paragraph","spans":[{"id":"spn-65794","marks":["code"],"text":"bendscript.com/src/routes/api/play/mcp-proxy/+server.js"},{"id":"spn-65795","text":" — proxy route"}]}],"id":"blk-56723","kind":"list-item"},{"blocks":[{"id":"blk-56726","kind":"paragraph","spans":[{"id":"spn-65796","marks":["code"],"text":"bendscript.com/src/lib/play/mcp-client.js"},{"id":"spn-65797","text":" — client library"}]}],"id":"blk-56725","kind":"list-item"},{"blocks":[{"id":"blk-56728","kind":"paragraph","spans":[{"id":"spn-65798","marks":["code"],"text":"bendscript.com/src/lib/play/default-servers.js"},{"id":"spn-65799","text":" — default servers"}]}],"id":"blk-56727","kind":"list-item"},{"blocks":[{"id":"blk-56730","kind":"paragraph","spans":[{"id":"spn-65800","marks":["code"],"text":"bendscript.com/src/lib/play/tools.js"},{"id":"spn-65801","text":" — MCP→OpenAI tool converter"}]}],"id":"blk-56729","kind":"list-item"},{"blocks":[{"id":"blk-56732","kind":"paragraph","spans":[{"id":"spn-65802","marks":["code"],"text":"bendscript.com/src/components/play/McpPanel.svelte"},{"id":"spn-65803","text":" — connection UI"}]}],"id":"blk-56731","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56733","kind":"heading","level":2,"spans":[{"id":"spn-65804","text":"Files to Create"}]},{"id":"blk-56734","kind":"heading","level":3,"spans":[{"id":"spn-65805","marks":["code"],"text":"src/routes/api/mcp-proxy/+server.js"}]},{"id":"blk-56735","kind":"paragraph","spans":[{"id":"spn-65806","text":"SvelteKit server route (POST handler). Receives:"}]},{"id":"blk-56736","kind":"code","language":"json","text":"{ \"serverUrl\": \"https://...\", \"authHeader\": \"Bearer ...\", \"sessionId\": \"...\", \"request\": { \"jsonrpc\": \"2.0\", ... } }"},{"id":"blk-56737","kind":"paragraph","spans":[{"id":"spn-65807","text":"Forwards to "},{"id":"spn-65808","marks":["code"],"text":"serverUrl"},{"id":"spn-65809","text":" with auth headers. Returns JSON or parses SSE. Security: block private network addresses in production, 64KB body limit, 30s timeout."}]},{"id":"blk-56738","kind":"heading","level":3,"spans":[{"id":"spn-65810","marks":["code"],"text":"src/lib/play/mcp-client.js"}]},{"id":"blk-56739","kind":"paragraph","spans":[{"id":"spn-65811","text":"Functions:"}]},{"id":"blk-56740","items":[{"blocks":[{"id":"blk-56742","kind":"paragraph","spans":[{"id":"spn-65812","marks":["code"],"text":"discoverTools(serverUrl, authHeader)"},{"id":"spn-65813","text":" — sends "},{"id":"spn-65814","marks":["code"],"text":"initialize"},{"id":"spn-65815","text":" → "},{"id":"spn-65816","marks":["code"],"text":"notifications/initialized"},{"id":"spn-65817","text":" → "},{"id":"spn-65818","marks":["code"],"text":"tools/list"},{"id":"spn-65819","text":" through proxy. Returns "},{"id":"spn-65820","marks":["code"],"text":"{ name, version, tools, sessionId }"},{"id":"spn-65821","text":"."}]}],"id":"blk-56741","kind":"list-item"},{"blocks":[{"id":"blk-56744","kind":"paragraph","spans":[{"id":"spn-65822","marks":["code"],"text":"callTool(serverUrl, authHeader, toolName, args, sessionId, signal)"},{"id":"spn-65823","text":" — sends "},{"id":"spn-65824","marks":["code"],"text":"tools/call"},{"id":"spn-65825","text":" through proxy. Returns result."}]}],"id":"blk-56743","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56745","kind":"paragraph","spans":[{"id":"spn-65826","text":"All calls go through "},{"id":"spn-65827","marks":["code"],"text":"/api/mcp-proxy"},{"id":"spn-65828","text":" to avoid CORS."}]},{"id":"blk-56746","kind":"heading","level":3,"spans":[{"id":"spn-65829","marks":["code"],"text":"src/lib/play/default-servers.js"}]},{"id":"blk-56747","kind":"code","language":"js","text":"export const DEFAULT_MCP_SERVERS = [\n  { url: 'https://graphonomous-mcp.fly.dev/mcp', name: 'graphonomous', label: 'Graphonomous Memory' },\n  { url: 'https://prism-eval.fly.dev/mcp', name: 'os-prism', label: 'PRISM Benchmarks' },\n  { url: 'https://box-and-box-mcp.fly.dev/mcp', name: 'box-and-box', label: '[&] Protocol' },\n  { url: 'https://os-pulse-mcp.fly.dev/mcp', name: 'os-pulse', label: 'PULSE Manifests' },\n];"},{"id":"blk-56748","kind":"heading","level":3,"spans":[{"id":"spn-65830","marks":["code"],"text":"src/lib/play/tools.js"}]},{"id":"blk-56749","items":[{"blocks":[{"id":"blk-56751","kind":"paragraph","spans":[{"id":"spn-65831","marks":["code"],"text":"mcpToolsToOpenAI(serverName, mcpTools)"},{"id":"spn-65832","text":" — converts MCP tool schemas to OpenAI function-calling format, namespaced as "},{"id":"spn-65833","marks":["code"],"text":"mcp__<serverName>__<toolName>"},{"id":"spn-65834","text":"."}]}],"id":"blk-56750","kind":"list-item"},{"blocks":[{"id":"blk-56753","kind":"paragraph","spans":[{"id":"spn-65835","marks":["code"],"text":"parseMcpToolName(name)"},{"id":"spn-65836","text":" — extracts "},{"id":"spn-65837","marks":["code"],"text":"{ serverName, toolName }"},{"id":"spn-65838","text":" from namespaced name."}]}],"id":"blk-56752","kind":"list-item"},{"blocks":[{"id":"blk-56755","kind":"paragraph","spans":[{"id":"spn-65839","marks":["code"],"text":"BUILTIN_TOOLS"},{"id":"spn-65840","text":" array with RuneFor