aph","spans":[{"id":"spn-47682","text":"Inflate confidence indiscriminately (no blanket 0.9+)"}]}],"id":"blk-42369","kind":"list-item"},{"blocks":[{"id":"blk-42372","kind":"paragraph","spans":[{"id":"spn-47683","text":"Store kitchen-sink nodes (multiple unrelated facts)"}]}],"id":"blk-42371","kind":"list-item"},{"blocks":[{"id":"blk-42374","kind":"paragraph","spans":[{"id":"spn-47684","text":"Fabricate coverage signals or causal provenance"}]}],"id":"blk-42373","kind":"list-item"},{"blocks":[{"id":"blk-42376","kind":"paragraph","spans":[{"id":"spn-47685","text":"Ignore repeated "},{"id":"spn-47686","marks":["code"],"text":"learn"},{"id":"spn-47687","text":"/"},{"id":"spn-47688","marks":["code"],"text":"escalate"},{"id":"spn-47689","text":" decisions from coverage review"}]}],"id":"blk-42375","kind":"list-item"},{"blocks":[{"id":"blk-42378","kind":"paragraph","spans":[{"id":"spn-47690","text":"Create edge spaghetti (link everything to everything)"}]}],"id":"blk-42377","kind":"list-item"},{"blocks":[{"id":"blk-42380","kind":"paragraph","spans":[{"id":"spn-47691","text":"Neglect consolidation indefinitely"}]}],"id":"blk-42379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42381","kind":"heading","level":2,"spans":[{"id":"spn-47692","text":"Available Resources (Read-Only Snapshots)"}]},{"head":[{"id":"blk-42383","spans":[{"id":"spn-47693","text":"URI"}]},{"id":"blk-42384","spans":[{"id":"spn-47694","text":"What It Returns"}]}],"id":"blk-42382","kind":"table","rows":[[{"id":"blk-42385","spans":[{"id":"spn-47695","marks":["code"],"text":"graphonomous://runtime/health"}]},{"id":"blk-42386","spans":[{"id":"spn-47696","text":"Runtime health, service status, counts"}]}],[{"id":"blk-42387","spans":[{"id":"spn-47697","marks":["code"],"text":"graphonomous://goals/snapshot"}]},{"id":"blk-42388","spans":[{"id":"spn-47698","text":"Goal totals and status breakdown"}]}],[{"id":"blk-42389","spans":[{"id":"spn-47699","marks":["code"],"text":"graphonomous://graph/node/{