ats\")`"},{"id":"spn-100460","text":" — aggregate graph health"}]}],"id":"blk-68028","kind":"list-item"},{"blocks":[{"id":"blk-68031","kind":"paragraph","spans":[{"id":"spn-100461","marks":["bold"],"text":"`consolidate(action: \"traverse\")`"},{"id":"spn-100462","text":" — BFS walk with depth/relationship filters"}]}],"id":"blk-68030","kind":"list-item"},{"blocks":[{"id":"blk-68033","kind":"paragraph","spans":[{"id":"spn-100463","marks":["bold"],"text":"`consolidate(action: \"query\")`"},{"id":"spn-100464","text":" — operation-based graph inspection"}]}],"id":"blk-68032","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68034","kind":"heading","level":2,"spans":[{"id":"spn-100465","text":"Session End Checklist"}]},{"id":"blk-68035","kind":"paragraph","spans":[{"id":"spn-100466","text":"Before ending a productive session:"}]},{"id":"blk-68036","items":[{"blocks":[{"id":"blk-68038","kind":"paragraph","spans":[{"id":"spn-100467","text":"Store key new knowledge: "},{"id":"spn-100468","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-68037","kind":"list-item"},{"blocks":[{"id":"blk-68040","kind":"paragraph","spans":[{"id":"spn-100469","text":"Report pending outcomes: "},{"id":"spn-100470","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"}]}],"id":"blk-68039","kind":"list-item"},{"blocks":[{"id":"blk-68042","kind":"paragraph","spans":[{"id":"spn-100471","text":"Update goal progress: "},{"id":"spn-100472","marks":["code"],"text":"act(action: \"manage_goal\", operation: \"set_progress\", ...)"}]}],"id":"blk-68041","kind":"list-item"},{"blocks":[{"id":"blk-68044","kind":"paragraph","spans":[{"id":"spn-100473","text":"Trigger consolidation: "},{"id":"spn-100474","marks":["code"],"text":"consolidate(action: \"run\")"}]}],"id":"blk-68043","kind":"list-item"}],"kind":"list","ordered":true}],"edges":[],"id":"bagaaierawsis3ruphwuhu7xk4oybbyzdkiuofhmxufy4uxjbqbi22mntrnbq","vocabulary":"ampersand.docs.fs.v1"}