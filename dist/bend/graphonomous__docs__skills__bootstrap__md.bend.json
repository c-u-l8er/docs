{"bendscript":"0.1","blocks":[{"id":"blk-43289","kind":"paragraph","spans":[{"id":"spn-49841","text":"--- name: bootstrap description: Use when starting a new session, switching topics, or when the user says \"bootstrap\", \"start session\", \"initialize graphonomous\", or \"load memory\". Activates the Graphonomous-first memory loop and orients on prior context. ---"}]},{"id":"blk-43290","kind":"heading","level":1,"spans":[{"id":"spn-49842","text":"Graphonomous Bootstrap"}]},{"id":"blk-43291","kind":"paragraph","spans":[{"id":"spn-49843","text":"Initialize the Graphonomous-first memory loop for this session."}]},{"id":"blk-43292","kind":"heading","level":2,"spans":[{"id":"spn-49844","text":"Steps"}]},{"id":"blk-43293","kind":"paragraph","spans":[{"id":"spn-49845","text":"1. "},{"id":"spn-49846","marks":["bold"],"text":"Retrieve prior context"},{"id":"spn-49847","text":" for the user's current topic: ``"},{"id":"spn-49848","marks":["code"],"text":" retrieve(action: \"context\", query: \"summary of prior work on <topic>\") "},{"id":"spn-49849","text":"``"}]},{"id":"blk-43294","kind":"paragraph","spans":[{"id":"spn-49850","text":"2. "},{"id":"spn-49851","marks":["bold"],"text":"Check active goals"},{"id":"spn-49852","text":" to regain session continuity: ``"},{"id":"spn-49853","marks":["code"],"text":" act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"}) "},{"id":"spn-49854","text":"``"}]},{"id":"blk-43295","kind":"paragraph","spans":[{"id":"spn-49855","text":"3. "},{"id":"spn-49856","marks":["bold"],"text":"Survey attention"},{"id":"spn-49857","text":" to see what needs focus: ``"},{"id":"spn-49858","marks":["code"],"text":" route(action: \"attention_survey\", include_idle: false) "},{"id":"spn-49859","text":"``"}]},{"id":"blk-43296","kind":"paragraph","spans":[{"id":"spn-49860","text":"4. "},{"id":"spn-49861","marks":["bold"],"text":"Adopt the policy"},{"id":"spn-49862","text":": \"Graphonomous-first memory loop is active.\""}]},{"id":"blk-43297","kind":"paragraph","spans":[{"id":"spn-49863","text":"5. "},{"id":"spn-49864","marks":["bold"],"text":"Report"},{"id":"spn-49865","text":" to the user: what prior context exists, which goals are active, and what the attention engine recommends focusing on."}]},{"id":"blk-43298","kind":"heading","level":2,"spans":[{"id":"spn-49866","text":"Core Loop (apply for remainder of session)"}]},{"id":"blk-43299","kind":"paragraph","spans":[{"id":"spn-49867","text":"For every non-trivial task, run the closed memory loop:"}]},{"id":"blk-43300","kind":"paragraph","spans":[{"id":"spn-49868","text":"1. "},{"id":"spn-49869","marks":["bold"],"text":"Retrieve"},{"id":"spn-49870","text":" — "},{"id":"spn-49871","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-49872","text":" before reasoning/acting. Never skip for domain-specific work. 2. "},{"id":"spn-49873","marks":["bold"],"text":"Route"},{"id":"spn-49874","text":" — check "},{"id":"spn-49875","marks":["code"],"text":"topology.routing"},{"id":"spn-49876","text":" in response. If "},{"id":"spn-49877","marks":["code"],"text":"\"deliberate\""},{"id":"spn-49878","text":", run "},{"id":"spn-49879","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\")"},{"id":"spn-49880","text":" 3. "},{"id":"spn-49881","marks":["bold"],"text":"Act"},{"id":"spn-49882","text":" — "},{"id":"spn-49883","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-49884","text":" to mutate the graph 4. "},{"id":"spn-49885","marks":["bold"],"text":"Learn"},{"id":"spn-49886","text":" — "},{"id":"spn-49887","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-49888","text":" when you have an outcome signal. Preserve "},{"id":"spn-49889","marks":["code"],"text":"causal_context"},{"id":"spn-49890","text":" between retrieval and outcome. 5. "},{"id":"spn-49891","marks":["bold"],"text":"Consolidate"},{"id":"spn-49892","text":" — "},{"id":"spn-49893","marks":["code"],"text":"consolidate(action: \"run\")"},{"id":"spn-49894","text":" periodically and at session end"}]},{"id":"blk-43301","kind":"heading","level":3,"spans":[{"id":"spn-49895","text":"Machine Architecture (v0.4)"}]},{"id":"blk-43302","kind":"paragraph","spans":[{"id":"spn-49896","text":"Graphonomous v0.4 exposes "},{"id":"spn-49897","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-49898","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-49899","marks":["code"],"text":"action"},{"id":"spn-49900","text":" parameter:"}]},{"head":[{"id":"blk-43304","spans":[{"id":"spn-49901","text":"Machine"}]},{"id":"blk-43305","spans":[{"id":"spn-49902","text":"Phase"}]},{"id":"blk-43306","spans":[{"id":"spn-49903","text":"Actions"}]}],"id":"blk-43303","kind":"table","rows":[[{"id":"blk-43307","spans":[{"id":"spn-49904","marks":["code"],"text":"retrieve"}]},{"id":"blk-43308","spans":[{"id":"spn-49905","text":"\"What do I know?\""}]},{"id":"blk-43309","spans":[{"id":"spn-49906","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-43310","spans":[{"id":"spn-49907","marks":["code"],"text":"route"}]},{"id":"blk-43311","spans":[{"id":"spn-49908","text":"\"What should I do?\""}]},{"id":"blk-43312","spans":[{"id":"spn-49909","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-43313","spans":[{"id":"spn-49910","marks":["code"],"text":"act"}]},{"id":"blk-43314","spans":[{"id":"spn-49911","text":"\"Do it\""}]},{"id":"blk-43315","spans":[{"id":"spn-49912","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-43316","spans":[{"id":"spn-49913","marks":["code"],"text":"learn"}]},{"id":"blk-43317","spans":[{"id":"spn-49914","text":"\"Did it work?\""}]},{"id":"blk-43318","spans":[{"id":"spn-49915","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-43319","spans":[{"id":"spn-49916","marks":["code"],"text":"consolidate"}]},{"id":"blk-43320","spans":[{"id":"spn-49917","text":"\"Clean up\""}]},{"id":"blk-43321","spans":[{"id":"spn-49918","text":"run, stats, query, traverse"}]}]]},{"id":"blk-43322","kind":"heading","level":2,"spans":[{"id":"spn-49919","text":"Node and Edge Discipline"}]},{"id":"blk-43323","items":[{"blocks":[{"id":"blk-43325","kind":"paragraph","spans":[{"id":"spn-49920","text":"Prefer "},{"id":"spn-49921","marks":["bold"],"text":"small, atomic nodes"},{"id":"spn-49922","text":" — one fact/procedure/event per node"}]}],"id":"blk-43324","kind":"list-item"},{"blocks":[{"id":"blk-43327","kind":"paragraph","spans":[{"id":"spn-49923","text":"Choose node types correctly: "},{"id":"spn-49924","marks":["code"],"text":"semantic"},{"id":"spn-49925","text":" (facts), "},{"id":"spn-49926","marks":["code"],"text":"procedural"},{"id":"spn-49927","text":" (how-to), "},{"id":"spn-49928","marks":["code"],"text":"episodic"},{"id":"spn-49929","text":" (events), "},{"id":"spn-49930","marks":["code"],"text":"temporal"},{"id":"spn-49931","text":" (time-bound observations), "},{"id":"spn-49932","marks":["code"],"text":"outcome"},{"id":"spn-49933","text":" (measured results), "},{"id":"spn-49934","marks":["code"],"text":"goal"},{"id":"spn-49935","text":" (objectives/targets)"}]}],"id":"blk-43326","kind":"list-item"},{"blocks":[{"id":"blk-43329","kind":"paragraph","spans":[{"id":"spn-49936","text":"Set confidence based on evidence quality, not optimism"}]}],"id":"blk-43328","kind":"list-item"},{"blocks":[{"id":"blk-43331","kind":"paragraph","spans":[{"id":"spn-49937","text":"Include "},{"id":"spn-49938","marks":["code"],"text":"source"},{"id":"spn-49939","text":" whenever possible (file path, URL, \"conversation\")"}]}],"id":"blk-43330","kind":"list-item"},{"blocks":[{"id":"blk-43333","kind":"paragraph","spans":[{"id":"spn-49940","text":"Create edges only when they improve retrieval: "},{"id":"spn-49941","marks":["code