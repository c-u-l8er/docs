{"bendscript":"0.1","blocks":[{"id":"blk-42803","kind":"paragraph","spans":[{"id":"spn-48721","text":"--- name: bootstrap description: Use when starting a new session, switching topics, or when the user says \"bootstrap\", \"start session\", \"initialize graphonomous\", or \"load memory\". Activates the Graphonomous-first memory loop and orients on prior context. ---"}]},{"id":"blk-42804","kind":"heading","level":1,"spans":[{"id":"spn-48722","text":"Graphonomous Bootstrap"}]},{"id":"blk-42805","kind":"paragraph","spans":[{"id":"spn-48723","text":"Initialize the Graphonomous-first memory loop for this session."}]},{"id":"blk-42806","kind":"heading","level":2,"spans":[{"id":"spn-48724","text":"Steps"}]},{"id":"blk-42807","kind":"paragraph","spans":[{"id":"spn-48725","text":"1. "},{"id":"spn-48726","marks":["bold"],"text":"Retrieve prior context"},{"id":"spn-48727","text":" for the user's current topic: ``"},{"id":"spn-48728","marks":["code"],"text":" retrieve(action: \"context\", query: \"summary of prior work on <topic>\") "},{"id":"spn-48729","text":"``"}]},{"id":"blk-42808","kind":"paragraph","spans":[{"id":"spn-48730","text":"2. "},{"id":"spn-48731","marks":["bold"],"text":"Check active goals"},{"id":"spn-48732","text":" to regain session continuity: ``"},{"id":"spn-48733","marks":["code"],"text":" act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"}) "},{"id":"spn-48734","text":"``"}]},{"id":"blk-42809","kind":"paragraph","spans":[{"id":"spn-48735","text":"3. "},{"id":"spn-48736","marks":["bold"],"text":"Survey attention"},{"id":"spn-48737","text":" to see what needs focus: ``"},{"id":"spn-48738","marks":["code"],"text":" route(action: \"attention_survey\", include_idle: false) "},{"id":"spn-48739","text":"``"}]},{"id":"blk-42810","kind":"paragraph","spans":[{"id":"spn-48740","text":"4. "},{"id":"spn-48741","marks":["bold"],"text":"Adopt the policy"},{"id":"spn-48742","text":": \"Graphonomous-first memory loop is active.\""}]},{"id":"blk-42811","kind":"paragraph","spans":[{"id":"spn-48743","text":"5. "},{"id":"spn-48744","marks":["bold"],"text":"Report"},{"id":"spn-48745","text":" to the user: what prior context exists, which goals are active, and what the attention engine recommends focusing on."}]},{"id":"blk-42812","kind":"heading","level":2,"spans":[{"id":"spn-48746","text":"Core Loop (apply for remainder of session)"}]},{"id":"blk-42813","kind":"paragraph","spans":[{"id":"spn-48747","text":"For every non-trivial task, run the closed memory loop:"}]},{"id":"blk-42814","kind":"paragraph","spans":[{"id":"spn-48748","text":"1. "},{"id":"spn-48749","marks":["bold"],"text":"Retrieve"},{"id":"spn-48750","text":" — "},{"id":"spn-48751","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-48752","text":" before reasoning/acting. Never skip for domain-specific work. 2. "},{"id":"spn-48753","marks":["bold"],"text":"Route"},{"id":"spn-48754","text":" — check "},{"id":"spn-48755","marks":["code"],"text":"topology.routing"},{"id":"spn-48756","text":" in response. If "},{"id":"spn-48757","marks":["code"],"text":"\"deliberate\""},{"id":"spn-48758","text":", run "},{"id":"spn-48759","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\")"},{"id":"spn-48760","text":" 3. "},{"id":"spn-48761","marks":["bold"],"text":"Act"},{"id":"spn-48762","text":" — "},{"id":"spn-48763","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-48764","text":" to mutate the graph 4. "},{"id":"spn-48765","marks":["bold"],"text":"Learn"},{"id":"spn-48766","text":" — "},{"id":"spn-48767","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-48768","text":" when you have an outcome signal. Preserve "},{"id":"spn-48769","marks":["code"],"text":"causal_context"},{"id":"spn-48770","text":" between retrieval and outcome. 5. "},{"id":"spn-48771","marks":["bold"],"text":"Consolidate"},{"id":"spn-48772","text":" — "},{"id":"spn-48773","marks":["code"],"text":"consolidate(action: \"run\")"},{"id":"spn-48774","text":" periodically and at session end"}]},{"id":"blk-42815","kind":"heading","level":3,"spans":[{"id":"spn-48775","text":"Machine Architecture (v0.4)"}]},{"id":"blk-42816","kind":"paragraph","spans":[{"id":"spn-48776","text":"Graphonomous v0.4 exposes "},{"id":"spn-48777","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-48778","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-48779","marks":["code"],"text":"action"},{"id":"spn-48780","text":" parameter:"}]},{"head":[{"id":"blk-42818","spans":[{"id":"spn-48781","text":"Machine"}]},{"id":"blk-42819","spans":[{"id":"spn-48782","text":"Phase"}]},{"id":"blk-42820","spans":[{"id":"spn-48783","text":"Actions"}]}],"id":"blk-42817","kind":"table","rows":[[{"id":"blk-42821","spans":[{"id":"spn-48784","marks":["code"],"text":"retrieve"}]},{"id":"blk-42822","spans":[{"id":"spn-48785","text":"\"What do I know?\""}]},{"id":"blk-42823","spans":[{"id":"spn-48786","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-42824","spans":[{"id":"spn-48787","marks":["code"],"text":"route"}]},{"id":"blk-42825","spans":[{"id":"spn-48788","text":"\"What should I do?\""}]},{"id":"blk-42826","spans":[{"id":"spn-48789","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-42827","spans":[{"id":"spn-48790","marks":["code"],"text":"act"}]},{"id":"blk-42828","spans":[{"id":"spn-48791","text":"\"Do it\""}]},{"id":"blk-42829","spans":[{"id":"spn-48792","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-42830","spans":[{"id":"spn-48793","marks":["code"],"text":"learn"}]},{"id":"blk-42831","spans":[{"id":"spn-48794","text":"\"Did it work?\""}]},{"id":"blk-42832","spans":[{"id":"spn-48795","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-42833","spans":[{"id":"spn-48796","marks":["code"],"text":"consolidate"}]},{"id":"blk-42834","spans":[{"id":"spn-48797","text":"\"Clean up\""}]},{"id":"blk-42835","spans":[{"id":"spn-48798","text":"run, stats, query, traverse"}]}]]},{"id":"blk-42836","kind":"heading","level":2,"spans":[{"id":"spn-48799","text":"Node and Edge Discipline"}]},{"id":"blk-42837","items":[{"blocks":[{"id":"blk-42839","kind":"paragraph","spans":[{"id":"spn-48800","text":"Prefer "},{"id":"spn-48801","marks":["bold"],"text":"small, atomic nodes"},{"id":"spn-48802","text":" — one fact/procedure/event per node"}]}],"id":"blk-42838","kind":"list-item"},{"blocks":[{"id":"blk-42841","kind":"paragraph","spans":[{"id":"spn-48803","text":"Choose node types correctly: "},{"id":"spn-48804","marks":["code"],"text":"semantic"},{"id":"spn-48805","text":" (facts), "},{"id":"spn-48806","marks":["code"],"text":"procedural"},{"id":"spn-48807","text":" (how-to), "},{"id":"spn-48808","marks":["code"],"text":"episodic"},{"id":"spn-48809","text":" (events), "},{"id":"spn-48810","marks":["code"],"text":"temporal"},{"id":"spn-48811","text":" (time-bound observations), "},{"id":"spn-48812","marks":["code"],"text":"outcome"},{"id":"spn-48813","text":" (measured results), "},{"id":"spn-48814","marks":["code"],"text":"goal"},{"id":"spn-48815","text":" (objectives/targets)"}]}],"id":"blk-42840","kind":"list-item"},{"blocks":[{"id":"blk-42843","kind":"paragraph","spans":[{"id":"spn-48816","text":"Set confidence based on evidence quality, not optimism"}]}],"id":"blk-42842","kind":"list-item"},{"blocks":[{"id":"blk-42845","kind":"paragraph","spans":[{"id":"spn-48817","text":"Include "},{"id":"spn-48818","marks":["code"],"text":"source"},{"id":"spn-48819","text":" whenever possible (file path, URL, \"conversation\")"}]}],"id":"blk-42844","kind":"list-item"},{"blocks":[{"id":"blk-42847","kind":"paragraph","spans":[{"id":"spn-48820","text":"Create edges only when they improve retrieval: "},{"id":"spn-48821","marks":["code"],"text":"causal"},{"id":"spn-48822","text":", "},{"id":"spn-48823","marks":["code"],"text":"causes"},{"id":"spn-48824","text":", "},{"id":"spn-48825","marks":["code"],"text":"resolves"},{"id":"spn-48826","text":", "},{"id":"spn-48827","marks":["code"],"text":"supports"},{"id":"spn-48828","text":", "},{"id":"spn-48829","marks":["code"],"text":"contradicts"},{"id":"spn-48830","text":", "},{"id":"spn-48831","marks":["code"],"text":"related"},{"id":"spn-48832","text":", "},{"id":"spn-48833","marks":["code"],"text":"related_to"},{"id":"spn-48834","text":", "},{"id":"spn-48835","marks":["code"],"text":"part_of"},{"id":"spn-48836","text":", "},{"id":"spn-48837","marks":["code"],"text":"follows"},{"id":"spn-48838","text":", "},{"id":"spn-48839","marks":["code"],"text":"supersedes"},{"id":"spn-48840","text":", "},{"id":"spn-48841","marks":["code"],"text":"depends_on"},{"id":"spn-48842","text":", "},{"id":"spn-48843","marks":["code"],"text":"similar_to"},{"id":"spn-48844","text":", "},{"id":"spn-48845","marks":["code"],"text":"derived_from"},{"id":"spn-48846","text":", "},{"id":"spn-48847","marks":["code"],"text":"temporal_before"},{"id":"spn-48848","text":", "},{"id":"spn-48849","marks":["code"],"text":"temporal_after"},{"id":"spn-48850","text":", "},{"id":"spn-48851","marks":["code"],"text":"co_occurs"}]}],"id":"blk-42846","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-42848","kind":"heading","level":2,"spans":[{"id":"spn-48852","text":"Hard Prohibitions"}]},{"id":"blk-42849","kind":"paragraph","spans":[{"id":"spn-48853","text":"Do NOT:"}]},{"id":"blk-42850","items":[{"blocks":[{"id":"blk-42852","kind":"paragraph","spans":[{"id":"spn-48854","text":"Skip retrieval habitually — prior context likely exists"}]}],"id":"blk-42851","kind":"list-item"},{"blocks":[{"id":"blk-42854","kind":"paragraph","spans":[{"id":"spn-48855","text":"Skip outcome learning on consequential actions"}]}],"id":"blk-42853","kind":"list-item"},{"blocks":[{"id":"blk-42856","kind":"paragr