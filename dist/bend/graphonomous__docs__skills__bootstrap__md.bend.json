{"bendscript":"0.1","blocks":[{"id":"blk-42317","kind":"paragraph","spans":[{"id":"spn-47547","text":"--- name: bootstrap description: Use when starting a new session, switching topics, or when the user says \"bootstrap\", \"start session\", \"initialize graphonomous\", or \"load memory\". Activates the Graphonomous-first memory loop and orients on prior context. ---"}]},{"id":"blk-42318","kind":"heading","level":1,"spans":[{"id":"spn-47548","text":"Graphonomous Bootstrap"}]},{"id":"blk-42319","kind":"paragraph","spans":[{"id":"spn-47549","text":"Initialize the Graphonomous-first memory loop for this session."}]},{"id":"blk-42320","kind":"heading","level":2,"spans":[{"id":"spn-47550","text":"Steps"}]},{"id":"blk-42321","kind":"paragraph","spans":[{"id":"spn-47551","text":"1. "},{"id":"spn-47552","marks":["bold"],"text":"Retrieve prior context"},{"id":"spn-47553","text":" for the user's current topic: ``"},{"id":"spn-47554","marks":["code"],"text":" retrieve(action: \"context\", query: \"summary of prior work on <topic>\") "},{"id":"spn-47555","text":"``"}]},{"id":"blk-42322","kind":"paragraph","spans":[{"id":"spn-47556","text":"2. "},{"id":"spn-47557","marks":["bold"],"text":"Check active goals"},{"id":"spn-47558","text":" to regain session continuity: ``"},{"id":"spn-47559","marks":["code"],"text":" act(action: \"manage_goal\", operation: \"list_goals\", filters: {\"status\": \"active\"}) "},{"id":"spn-47560","text":"``"}]},{"id":"blk-42323","kind":"paragraph","spans":[{"id":"spn-47561","text":"3. "},{"id":"spn-47562","marks":["bold"],"text":"Survey attention"},{"id":"spn-47563","text":" to see what needs focus: ``"},{"id":"spn-47564","marks":["code"],"text":" route(action: \"attention_survey\", include_idle: false) "},{"id":"spn-47565","text":"``"}]},{"id":"blk-42324","kind":"paragraph","spans":[{"id":"spn-47566","text":"4. "},{"id":"spn-47567","marks":["bold"],"text":"Adopt the policy"},{"id":"spn-47568","text":": \"Graphonomous-first memory loop is active.\""}]},{"id":"blk-42325","kind":"paragraph","spans":[{"id":"spn-47569","text":"5. "},{"id":"spn-47570","marks":["bold"],"text":"Report"},{"id":"spn-47571","text":" to the user: what prior context exists, which goals are active, and what the attention engine recommends focusing on."}]},{"id":"blk-42326","kind":"heading","level":2,"spans":[{"id":"spn-47572","text":"Core Loop (apply for remainder of session)"}]},{"id":"blk-42327","kind":"paragraph","spans":[{"id":"spn-47573","text":"For every non-trivial task, run the closed memory loop:"}]},{"id":"blk-42328","kind":"paragraph","spans":[{"id":"spn-47574","text":"1. "},{"id":"spn-47575","marks":["bold"],"text":"Retrieve"},{"id":"spn-47576","text":" — "},{"id":"spn-47577","marks":["code"],"text":"retrieve(action: \"context\", query: \"...\")"},{"id":"spn-47578","text":" before reasoning/acting. Never skip for domain-specific work. 2. "},{"id":"spn-47579","marks":["bold"],"text":"Route"},{"id":"spn-47580","text":" — check "},{"id":"spn-47581","marks":["code"],"text":"topology.routing"},{"id":"spn-47582","text":" in response. If "},{"id":"spn-47583","marks":["code"],"text":"\"deliberate\""},{"id":"spn-47584","text":", run "},{"id":"spn-47585","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\")"},{"id":"spn-47586","text":" 3. "},{"id":"spn-47587","marks":["bold"],"text":"Act"},{"id":"spn-47588","text":" — "},{"id":"spn-47589","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-47590","text":" to mutate the graph 4. "},{"id":"spn-47591","marks":["bold"],"text":"Learn"},{"id":"spn-47592","text":" — "},{"id":"spn-47593","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-47594","text":" when you have an outcome signal. Preserve "},{"id":"spn-47595","marks":["code"],"text":"causal_context"},{"id":"spn-47596","text":" between retrieval and outcome. 5. "},{"id":"spn-47597","marks":["bold"],"text":"Consolidate"},{"id":"spn-47598","text":" — "},{"id":"spn-47599","marks":["code"],"text":"consolidate(action: \"run\")"},{"id":"spn-47600","text":" periodically and at session end"}]},{"id":"blk-42329","kind":"heading","level":3,"spans":[{"id":"spn-47601","text":"Machine Architecture (v0.4)"}]},{"id":"blk-42330","kind":"paragraph","spans":[{"id":"spn-47602","text":"Graphonomous v0.4 exposes "},{"id":"spn-47603","marks":["bold"],"text":"5 loop-phase machines"},{"id":"spn-47604","text":" instead of 29 individual tools. Each machine accepts an "},{"id":"spn-47605","marks":["code"],"text":"action"},{"id":"spn-47606","text":" parameter:"}]},{"head":[{"id":"blk-42332","spans":[{"id":"spn-47607","text":"Machine"}]},{"id":"blk-42333","spans":[{"id":"spn-47608","text":"Phase"}]},{"id":"blk-42334","spans":[{"id":"spn-47609","text":"Actions"}]}],"id":"blk-42331","kind":"table","rows":[[{"id":"blk-42335","spans":[{"id":"spn-47610","marks":["code"],"text":"retrieve"}]},{"id":"blk-42336","spans":[{"id":"spn-47611","text":"\"What do I know?\""}]},{"id":"blk-42337","spans":[{"id":"spn-47612","text":"context, episodic, procedural, coverage, trace_evidence, frontier"}]}],[{"id":"blk-42338","spans":[{"id":"spn-47613","marks":["code"],"text":"route"}]},{"id":"blk-42339","spans":[{"id":"spn-47614","text":"\"What should I do?\""}]},{"id":"blk-42340","spans":[{"id":"spn-47615","text":"topology, deliberate, attention_survey, attention_cycle, review_goal"}]}],[{"id":"blk-42341","spans":[{"id":"spn-47616","marks":["code"],"text":"act"}]},{"id":"blk-42342","spans":[{"id":"spn-47617","text":"\"Do it\""}]},{"id":"blk-42343","spans":[{"id":"spn-47618","text":"store_node, store_edge, delete_node, manage_edge, manage_goal, belief_revise, forget_node, forget_policy, gdpr_erase"}]}],[{"id":"blk-42344","spans":[{"id":"spn-47619","marks":["code"],"text":"learn"}]},{"id":"blk-42345","spans":[{"id":"spn-47620","text":"\"Did it work?\""}]},{"id":"blk-42346","spans":[{"id":"spn-47621","text":"from_outcome, from_feedback, detect_novelty, from_interaction, contradictions"}]}],[{"id":"blk-42347","spans":[{"id":"spn-47622","marks":["code"],"text":"consolidate"}]},{"id":"blk-42348","spans":[{"id":"spn-47623","text":"\"Clean up\""}]},{"id":"blk-42349","spans":[{"id":"spn-47624","text":"run, stats, query, traverse"}]}]]},{"id":"blk-42350","kind":"heading","level":2,"spans":[{"id":"spn-47625","text":"Node and Edge Discipline"}]},{"id":"blk-42351","items":[{"blocks":[{"id":"blk-42353","kind":"paragraph","spans":[{"id":"spn-47626","text":"Prefer "},{"id":"spn-47627","marks":["bold"],"text":"small, atomic nodes"},{"id":"spn-47628","text":" — one fact/procedure/event per node"}]}],"id":"blk-42352","kind":"list-item"},{"blocks":[{"id":"blk-42355","kind":"paragraph","spans":[{"id":"spn-47629","text":"Choose node types correctly: "},{"id":"spn-47630","marks":["code"],"text":"semantic"},{"id":"spn-47631","text":" (facts), "},{"id":"spn-47632","marks":["code"],"text":"procedural"},{"id":"spn-47633","text":" (how-to), "},{"id":"spn-47634","marks":["code"],"text":"episodic"},{"id":"spn-47635","text":" (events), "},{"id":"spn-47636","marks":["code"],"text":"temporal"},{"id":"spn-47637","text":" (time-bound observations), "},{"id":"spn-47638","marks":["code"],"text":"outcome"},{"id":"spn-47639","text":" (measured results), "},{"id":"spn-47640","marks":["code"],"text":"goal"},{"id":"spn-47641","text":" (objectives/targets)"}]}],"id":"blk-42354","kind":"list-item"},{"blocks":[{"id":"blk-42357","kind":"paragraph","spans":[{"id":"spn-47642","text":"Set confidence based on evidence quality, not optimism"}]}],"id":"blk-42356","kind":"list-item"},{"blocks":[{"id":"blk-42359","kind":"paragraph","spans":[{"id":"spn-47643","text":"Include "},{"id":"spn-47644","marks":["code"],"text":"source"},{"id":"spn-47645","text":" whenever possible (file path, URL, \"conversation\")"}]}],"id":"blk-42358","kind":"list-item"},{"blocks":[{"id":"blk-42361","kind":"paragraph","spans":[{"id":"spn-47646","text":"Create edges only when they improve retrieval: "},{"id":"spn-47647","marks":["code