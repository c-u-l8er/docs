{"bendscript":"0.1","blocks":[{"id":"blk-68370","kind":"heading","level":1,"spans":[{"id":"spn-99156","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-68371","kind":"paragraph","spans":[{"id":"spn-99157","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-68372","kind":"heading","level":2,"spans":[{"id":"spn-99158","text":"Arguments"}]},{"id":"blk-68373","kind":"paragraph","spans":[{"id":"spn-99159","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-68374","items":[{"blocks":[{"id":"blk-68376","kind":"paragraph","spans":[{"id":"spn-99160","marks":["code"],"text":"<path>"},{"id":"spn-99161","text":": directory to watch (required)"}]}],"id":"blk-68375","kind":"list-item"},{"blocks":[{"id":"blk-68378","kind":"paragraph","spans":[{"id":"spn-99162","marks":["code"],"text":"--interval <ms>"},{"id":"spn-99163","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-68377","kind":"list-item"},{"blocks":[{"id":"blk-68380","kind":"paragraph","spans":[{"id":"spn-99164","marks":["code"],"text":"--extensions <list>"},{"id":"spn-99165","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-68379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68381","kind":"heading","level":2,"spans":[{"id":"spn-99166","text":"How It Works"}]},{"id":"blk-68382","kind":"paragraph","spans":[{"id":"spn-99167","text":"Graphonomous has a built-in "},{"id":"spn-99168","marks":["code"],"text":"watch_directory"},{"id":"spn-99169","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-68383","kind":"heading","level":3,"spans":[{"id":"spn-99170","text":"Starting the Watcher"}]},{"id":"blk-68384","items":[{"blocks":[{"id":"blk-68386","kind":"paragraph","spans":[{"id":"spn-99171","text":"Note the target directory and configuration"}]}],"id":"blk-68385","kind":"list-item"},{"blocks":[{"id":"blk-68388","kind":"paragraph","spans":[{"id":"spn-99172","text":"Inform the user that watching is active"}]}],"id":"blk-68387","kind":"list-item"},{"blocks":[{"id":"blk-68390","kind":"paragraph","spans":[{"id":"spn-99173","text":"On each detected change, use "},{"id":"spn-99174","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-99175","text":" to ingest"}]}],"id":"blk-68389","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68391","kind":"paragraph","spans":[{"id":"spn-99176","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-68392","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-68393","kind":"paragraph","spans":[{"id":"spn-99177","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-68394","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-68395","kind":"heading","level":3,"spans":[{"id":"spn-99178","text":"What Gets Watched"}]},{"id":"blk-68396","kind":"paragraph","spans":[{"id":"spn-99179","text":"The watcher tracks:"}]},{"id":"blk-68397","items":[{"blocks":[{"id":"blk-68399","kind":"paragraph","spans":[{"id":"spn-99180","marks":["bold"],"text":"Added files"},{"id":"spn-99181","text":": new files matching the extension filter -> "},{"id":"spn-99182","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-68398","kind":"list-item"},{"blocks":[{"id":"blk-68401","kind":"paragraph","spans":[{"id":"spn-99183","marks":["bold"],"text":"Modified files"},{"id":"spn-99184","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-68400","kind":"list-item"},{"blocks":[{"id":"blk-68403","kind":"paragraph","spans":[{"id":"spn-99185","marks":["bold"],"text":"Removed files"},{"id":"spn-99186","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-68402","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68404","kind":"heading","level":3,"spans":[{"id":"spn-99187","text":"Watcher Configuration"}]},{"head":[{"id":"blk-68406","spans":[{"id":"spn-99188","text":"Option"}]},{"id":"blk-68407","spans":[{"id":"spn-99189","text":"Default"}]},{"id":"blk-68408","spans":[{"id":"spn-99190","text":"Description"}]}],"id":"blk-68405","kind":"table","rows":[[{"id":"blk-68409","spans":[{"id":"spn-99191","marks":["code"],"text":"path"}]},{"id":"blk-68410","spans":[{"id":"spn-99192","text":"(required)"}]},{"id":"blk-68411","spans":[{"id":"spn-99193","text":"Root directory to watch"}]}],[{"id":"blk-68412","spans":[{"id":"spn-99194","marks":["code"],"text":"interval"}]},{"id":"blk-68413","spans":[{"id":"spn-99195","text":"5000ms"}]},{"id":"blk-68414","spans":[{"id":"spn-99196","text":"How often to check for changes"}]}],[{"id":"blk-68415","spans":[{"id":"spn-99197","marks":["code"],"text":"extensions"}]},{"id":"blk-68416","spans":[{"id":"spn-99198","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-68417","spans":[{"id":"spn-99199","text":"File types to include"}]}],[{"id":"blk-68418","spans":[{"id":"spn-99200","marks":["code"],"text":"recursive"}]},{"id":"blk-68419","spans":[{"id":"spn-99201","text":"true"}]},{"id":"blk-68420","spans":[{"id":"spn-99202","text":"Watch subdirectories"}]}],[{"id":"blk-68421","spans":[{"id":"spn-99203","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-68422","spans":[{"id":"spn-99204","text":"true"}]},{"id":"blk-68423","spans":[{"id":"spn-99205","text":"Skip .gitignore'd files"}]}],[{"id":"blk-68424","spans":[{"id":"spn-99206","marks":["code"],"text":"max_file_size"}]},{"id":"blk-68425","spans":[{"id":"spn-99207","text":"1MB"}]},{"id":"blk-68426","spans":[{"id":"spn-99208","text":"Skip files larger than this"}]}]]},{"id":"blk-68427","kind":"heading","level":3,"spans":[{"id":"spn-99209","text":"Important Notes"}]},{"id":"blk-68428","items":[{"blocks":[{"id":"blk-68430","kind":"paragraph","spans":[{"id":"spn-99210","text":"The watcher runs as a "},{"id":"spn-99211","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-99212","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-68429","kind":"list-item"},{"blocks":[{"id":"blk-68432","kind":"paragraph","spans":[{"id":"spn-99213","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-99214","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-68431","kind":"list-item"},{"blocks":[{"id":"blk-68434","kind":"paragraph","spans":[{"id":"spn-99215","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-99216","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-99217","text":" periodically for that)"}]}],"id":"blk-68433","kind":"list-item"},{"blocks":[{"id":"blk-68436","kind":"paragraph","spans":[{"id":"spn-99218","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-68435","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68437","kind":"heading","level":2,"spans":[{"id":"spn-99219","text":"Native CLI Alternative"}]},{"id":"blk-68438","kind":"paragraph","spans":[{"id":"spn-99220","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-68439","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-68440","kind":"paragraph","spans":[{"id":"spn-99221","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-68441","kind":"heading","level":2,"spans":[{"id":"spn-99222","text":"Anti-patterns to avoid"}]},{"id":"blk-68442","items":[{"blocks":[{"id":"blk-68444","kind":"paragraph","spans":[{"id":"spn-99223","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-68443","kind":"list-item"},{"blocks":[{"id":"blk-68446","kind":"paragraph","spans":[{"id":"spn-99224","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-68445","kind":"list-item"},{"blocks":[{"id":"blk-68448","kind":"paragraph","spans":[{"id":"spn-99225","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-68447","kind":"list-item"},{"blocks":[{"id":"blk-68450","kind":"paragraph","spans":[{"id":"spn-99226","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-68449","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierapfpidpkkvtix3rr2ywbwrff4n7g5hbfq6gsf3j2di7nwqgptbeya","vocabulary":"ampersand.docs.fs.v1"}