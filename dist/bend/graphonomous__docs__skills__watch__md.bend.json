{"bendscript":"0.1","blocks":[{"id":"blk-75727","kind":"heading","level":1,"spans":[{"id":"spn-138519","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-75728","kind":"paragraph","spans":[{"id":"spn-138520","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-75729","kind":"heading","level":2,"spans":[{"id":"spn-138521","text":"Arguments"}]},{"id":"blk-75730","kind":"paragraph","spans":[{"id":"spn-138522","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-75731","items":[{"blocks":[{"id":"blk-75733","kind":"paragraph","spans":[{"id":"spn-138523","marks":["code"],"text":"<path>"},{"id":"spn-138524","text":": directory to watch (required)"}]}],"id":"blk-75732","kind":"list-item"},{"blocks":[{"id":"blk-75735","kind":"paragraph","spans":[{"id":"spn-138525","marks":["code"],"text":"--interval <ms>"},{"id":"spn-138526","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-75734","kind":"list-item"},{"blocks":[{"id":"blk-75737","kind":"paragraph","spans":[{"id":"spn-138527","marks":["code"],"text":"--extensions <list>"},{"id":"spn-138528","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-75736","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75738","kind":"heading","level":2,"spans":[{"id":"spn-138529","text":"How It Works"}]},{"id":"blk-75739","kind":"paragraph","spans":[{"id":"spn-138530","text":"Graphonomous has a built-in "},{"id":"spn-138531","marks":["code"],"text":"watch_directory"},{"id":"spn-138532","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-75740","kind":"heading","level":3,"spans":[{"id":"spn-138533","text":"Starting the Watcher"}]},{"id":"blk-75741","items":[{"blocks":[{"id":"blk-75743","kind":"paragraph","spans":[{"id":"spn-138534","text":"Note the target directory and configuration"}]}],"id":"blk-75742","kind":"list-item"},{"blocks":[{"id":"blk-75745","kind":"paragraph","spans":[{"id":"spn-138535","text":"Inform the user that watching is active"}]}],"id":"blk-75744","kind":"list-item"},{"blocks":[{"id":"blk-75747","kind":"paragraph","spans":[{"id":"spn-138536","text":"On each detected change, use "},{"id":"spn-138537","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-138538","text":" to ingest"}]}],"id":"blk-75746","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-75748","kind":"paragraph","spans":[{"id":"spn-138539","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-75749","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-75750","kind":"paragraph","spans":[{"id":"spn-138540","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-75751","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-75752","kind":"heading","level":3,"spans":[{"id":"spn-138541","text":"What Gets Watched"}]},{"id":"blk-75753","kind":"paragraph","spans":[{"id":"spn-138542","text":"The watcher tracks:"}]},{"id":"blk-75754","items":[{"blocks":[{"id":"blk-75756","kind":"paragraph","spans":[{"id":"spn-138543","marks":["bold"],"text":"Added files"},{"id":"spn-138544","text":": new files matching the extension filter -> "},{"id":"spn-138545","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-75755","kind":"list-item"},{"blocks":[{"id":"blk-75758","kind":"paragraph","spans":[{"id":"spn-138546","marks":["bold"],"text":"Modified files"},{"id":"spn-138547","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-75757","kind":"list-item"},{"blocks":[{"id":"blk-75760","kind":"paragraph","spans":[{"id":"spn-138548","marks":["bold"],"text":"Removed files"},{"id":"spn-138549","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-75759","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75761","kind":"heading","level":3,"spans":[{"id":"spn-138550","text":"Watcher Configuration"}]},{"head":[{"id":"blk-75763","spans":[{"id":"spn-138551","text":"Option"}]},{"id":"blk-75764","spans":[{"id":"spn-138552","text":"Default"}]},{"id":"blk-75765","spans":[{"id":"spn-138553","text":"Description"}]}],"id":"blk-75762","kind":"table","rows":[[{"id":"blk-75766","spans":[{"id":"spn-138554","marks":["code"],"text":"path"}]},{"id":"blk-75767","spans":[{"id":"spn-138555","text":"(required)"}]},{"id":"blk-75768","spans":[{"id":"spn-138556","text":"Root directory to watch"}]}],[{"id":"blk-75769","spans":[{"id":"spn-138557","marks":["code"],"text":"interval"}]},{"id":"blk-75770","spans":[{"id":"spn-138558","text":"5000ms"}]},{"id":"blk-75771","spans":[{"id":"spn-138559","text":"How often to check for changes"}]}],[{"id":"blk-75772","spans":[{"id":"spn-138560","marks":["code"],"text":"extensions"}]},{"id":"blk-75773","spans":[{"id":"spn-138561","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-75774","spans":[{"id":"spn-138562","text":"File types to include"}]}],[{"id":"blk-75775","spans":[{"id":"spn-138563","marks":["code"],"text":"recursive"}]},{"id":"blk-75776","spans":[{"id":"spn-138564","text":"true"}]},{"id":"blk-75777","spans":[{"id":"spn-138565","text":"Watch subdirectories"}]}],[{"id":"blk-75778","spans":[{"id":"spn-138566","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-75779","spans":[{"id":"spn-138567","text":"true"}]},{"id":"blk-75780","spans":[{"id":"spn-138568","text":"Skip .gitignore'd files"}]}],[{"id":"blk-75781","spans":[{"id":"spn-138569","marks":["code"],"text":"max_file_size"}]},{"id":"blk-75782","spans":[{"id":"spn-138570","text":"1MB"}]},{"id":"blk-75783","spans":[{"id":"spn-138571","text":"Skip files larger than this"}]}]]},{"id":"blk-75784","kind":"heading","level":3,"spans":[{"id":"spn-138572","text":"Important Notes"}]},{"id":"blk-75785","items":[{"blocks":[{"id":"blk-75787","kind":"paragraph","spans":[{"id":"spn-138573","text":"The watcher runs as a "},{"id":"spn-138574","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-138575","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-75786","kind":"list-item"},{"blocks":[{"id":"blk-75789","kind":"paragraph","spans":[{"id":"spn-138576","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-138577","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-75788","kind":"list-item"},{"blocks":[{"id":"blk-75791","kind":"paragraph","spans":[{"id":"spn-138578","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-138579","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-138580","text":" periodically for that)"}]}],"id":"blk-75790","kind":"list-item"},{"blocks":[{"id":"blk-75793","kind":"paragraph","spans":[{"id":"spn-138581","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-75792","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-75794","kind":"heading","level":2,"spans":[{"id":"spn-138582","text":"Native CLI Alternative"}]},{"id":"blk-75795","kind":"paragraph","spans":[{"id":"spn-138583","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-75796","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-75797","kind":"paragraph","spans":[{"id":"spn-138584","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-75798","kind":"heading","level":2,"spans":[{"id":"spn-138585","text":"Anti-patterns to avoid"}]},{"id":"blk-75799","items":[{"blocks":[{"id":"blk-75801","kind":"paragraph","spans":[{"id":"spn-138586","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-75800","kind":"list-item"},{"blocks":[{"id":"blk-75803","kind":"paragraph","spans":[{"id":"spn-138587","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-75802","kind":"list-item"},{"blocks":[{"id":"blk-75805","kind":"paragraph","spans":[{"id":"spn-138588","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-75804","kind":"list-item"},{"blocks":[{"id":"blk-75807","kind":"paragraph","spans":[{"id":"spn-138589","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-75806","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierak4u5jjeenotv7v3lrnmbimpmmtiwcjswg2njhnkluu5zilfmo2na","vocabulary":"ampersand.docs.fs.v1"}