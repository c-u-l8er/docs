{"bendscript":"0.1","blocks":[{"id":"blk-43964","kind":"paragraph","spans":[{"id":"spn-50299","text":"--- name: watch description: Use when the user says \"watch directory\", \"monitor files\", \"start watching\", \"live sync\", \"auto-ingest\", or wants continuous filesystem monitoring synced to Graphonomous. Starts a polling loop that detects file changes and ingests them automatically. Uses "},{"id":"spn-50300","marks":["code"],"text":"act"},{"id":"spn-50301","text":" machine for storage. argument-hint: <path> [--interval <ms>] [--extensions <list>] ---"}]},{"id":"blk-43965","kind":"heading","level":1,"spans":[{"id":"spn-50302","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-43966","kind":"paragraph","spans":[{"id":"spn-50303","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-43967","kind":"heading","level":2,"spans":[{"id":"spn-50304","text":"Arguments"}]},{"id":"blk-43968","kind":"paragraph","spans":[{"id":"spn-50305","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-43969","items":[{"blocks":[{"id":"blk-43971","kind":"paragraph","spans":[{"id":"spn-50306","marks":["code"],"text":"<path>"},{"id":"spn-50307","text":": directory to watch (required)"}]}],"id":"blk-43970","kind":"list-item"},{"blocks":[{"id":"blk-43973","kind":"paragraph","spans":[{"id":"spn-50308","marks":["code"],"text":"--interval <ms>"},{"id":"spn-50309","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-43972","kind":"list-item"},{"blocks":[{"id":"blk-43975","kind":"paragraph","spans":[{"id":"spn-50310","marks":["code"],"text":"--extensions <list>"},{"id":"spn-50311","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-43974","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43976","kind":"heading","level":2,"spans":[{"id":"spn-50312","text":"How It Works"}]},{"id":"blk-43977","kind":"paragraph","spans":[{"id":"spn-50313","text":"Graphonomous has a built-in "},{"id":"spn-50314","marks":["code"],"text":"watch_directory"},{"id":"spn-50315","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-43978","kind":"heading","level":3,"spans":[{"id":"spn-50316","text":"Starting the Watcher"}]},{"id":"blk-43979","kind":"paragraph","spans":[{"id":"spn-50317","text":"1. Note the target directory and configuration 2. Inform the user that watching is active 3. On each detected change, use "},{"id":"spn-50318","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-50319","text":" to ingest"}]},{"id":"blk-43980","kind":"paragraph","spans":[{"id":"spn-50320","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-43981","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-43982","kind":"paragraph","spans":[{"id":"spn-50321","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-43983","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-43984","kind":"heading","level":3,"spans":[{"id":"spn-50322","text":"What Gets Watched"}]},{"id":"blk-43985","kind":"paragraph","spans":[{"id":"spn-50323","text":"The watcher tracks:"}]},{"id":"blk-43986","items":[{"blocks":[{"id":"blk-43988","kind":"paragraph","spans":[{"id":"spn-50324","marks":["bold"],"text":"Added files"},{"id":"spn-50325","text":": new files matching the extension filter -> "},{"id":"spn-50326","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-43987","kind":"list-item"},{"blocks":[{"id":"blk-43990","kind":"paragraph","spans":[{"id":"spn-50327","marks":["bold"],"text":"Modified files"},{"id":"spn-50328","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-43989","kind":"list-item"},{"blocks":[{"id":"blk-43992","kind":"paragraph","spans":[{"id":"spn-50329","marks":["bold"],"text":"Removed files"},{"id":"spn-50330","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-43991","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43993","kind":"heading","level":3,"spans":[{"id":"spn-50331","text":"Watcher Configuration"}]},{"head":[{"id":"blk-43995","spans":[{"id":"spn-50332","text":"Option"}]},{"id":"blk-43996","spans":[{"id":"spn-50333","text":"Default"}]},{"id":"blk-43997","spans":[{"id":"spn-50334","text":"Description"}]}],"id":"blk-43994","kind":"table","rows":[[{"id":"blk-43998","spans":[{"id":"spn-50335","marks":["code"],"text":"path"}]},{"id":"blk-43999","spans":[{"id":"spn-50336","text":"(required)"}]},{"id":"blk-44000","spans":[{"id":"spn-50337","text":"Root directory to watch"}]}],[{"id":"blk-44001","spans":[{"id":"spn-50338","marks":["code"],"text":"interval"}]},{"id":"blk-44002","spans":[{"id":"spn-50339","text":"5000ms"}]},{"id":"blk-44003","spans":[{"id":"spn-50340","text":"How often to check for changes"}]}],[{"id":"blk-44004","spans":[{"id":"spn-50341","marks":["code"],"text":"extensions"}]},{"id":"blk-44005","spans":[{"id":"spn-50342","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-44006","spans":[{"id":"spn-50343","text":"File types to include"}]}],[{"id":"blk-44007","spans":[{"id":"spn-50344","marks":["code"],"text":"recursive"}]},{"id":"blk-44008","spans":[{"id":"spn-50345","text":"true"}]},{"id":"blk-44009","spans":[{"id":"spn-50346","text":"Watch subdirectories"}]}],[{"id":"blk-44010","spans":[{"id":"spn-50347","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-44011","spans":[{"id":"spn-50348","text":"true"}]},{"id":"blk-44012","spans":[{"id":"spn-50349","text":"Skip .gitignore'd files"}]}],[{"id":"blk-44013","spans":[{"id":"spn-50350","marks":["code"],"text":"max_file_size"}]},{"id":"blk-44014","spans":[{"id":"spn-50351","text":"1MB"}]},{"id":"blk-44015","spans":[{"id":"spn-50352","text":"Skip files larger than this"}]}]]},{"id":"blk-44016","kind":"heading","level":3,"spans":[{"id":"spn-50353","text":"Important Notes"}]},{"id":"blk-44017","items":[{"blocks":[{"id":"blk-44019","kind":"paragraph","spans":[{"id":"spn-50354","text":"The watcher runs as a "},{"id":"spn-50355","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-50356","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-44018","kind":"list-item"},{"blocks":[{"id":"blk-44021","kind":"paragraph","spans":[{"id":"spn-50357","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-50358","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-44020","kind":"list-item"},{"blocks":[{"id":"blk-44023","kind":"paragraph","spans":[{"id":"spn-50359","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-50360","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-50361","text":" periodically for that)"}]}],"id":"blk-44022","kind":"list-item"},{"blocks":[{"id":"blk-44025","kind":"paragraph","spans":[{"id":"spn-50362","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-44024","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44026","kind":"heading","level":2,"spans":[{"id":"spn-50363","text":"Native CLI Alternative"}]},{"id":"blk-44027","kind":"paragraph","spans":[{"id":"spn-50364","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-44028","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-44029","kind":"paragraph","spans":[{"id":"spn-50365","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-44030","kind":"heading","level":2,"spans":[{"id":"spn-50366","text":"Anti-patterns to avoid"}]},{"id":"blk-44031","items":[{"blocks":[{"id":"blk-44033","kind":"paragraph","spans":[{"id":"spn-50367","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-44032","kind":"list-item"},{"blocks":[{"id":"blk-44035","kind":"paragraph","spans":[{"id":"spn-50368","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-44034","kind":"list-item"},{"blocks":[{"id":"blk-44037","kind":"paragraph","spans":[{"id":"spn-50369","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-44036","kind":"list-item"},{"blocks":[{"id":"blk-44039","kind":"paragraph","spans":[{"id":"spn-50370","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-44038","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieranos5hwxfqpegiffs7nrtik372auo4y7qrwdwuiqppjm2grwchvdq","vocabulary":"ampersand.docs.fs.v1"}