{"bendscript":"0.1","blocks":[{"id":"blk-43368","kind":"paragraph","spans":[{"id":"spn-48496","text":"--- name: watch description: Use when the user says \"watch directory\", \"monitor files\", \"start watching\", \"live sync\", \"auto-ingest\", or wants continuous filesystem monitoring synced to Graphonomous. Starts a polling loop that detects file changes and ingests them automatically. Uses "},{"id":"spn-48497","marks":["code"],"text":"act"},{"id":"spn-48498","text":" machine for storage. argument-hint: <path> [--interval <ms>] [--extensions <list>] ---"}]},{"id":"blk-43369","kind":"heading","level":1,"spans":[{"id":"spn-48499","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-43370","kind":"paragraph","spans":[{"id":"spn-48500","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-43371","kind":"heading","level":2,"spans":[{"id":"spn-48501","text":"Arguments"}]},{"id":"blk-43372","kind":"paragraph","spans":[{"id":"spn-48502","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-43373","items":[{"blocks":[{"id":"blk-43375","kind":"paragraph","spans":[{"id":"spn-48503","marks":["code"],"text":"<path>"},{"id":"spn-48504","text":": directory to watch (required)"}]}],"id":"blk-43374","kind":"list-item"},{"blocks":[{"id":"blk-43377","kind":"paragraph","spans":[{"id":"spn-48505","marks":["code"],"text":"--interval <ms>"},{"id":"spn-48506","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-43376","kind":"list-item"},{"blocks":[{"id":"blk-43379","kind":"paragraph","spans":[{"id":"spn-48507","marks":["code"],"text":"--extensions <list>"},{"id":"spn-48508","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-43378","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43380","kind":"heading","level":2,"spans":[{"id":"spn-48509","text":"How It Works"}]},{"id":"blk-43381","kind":"paragraph","spans":[{"id":"spn-48510","text":"Graphonomous has a built-in "},{"id":"spn-48511","marks":["code"],"text":"watch_directory"},{"id":"spn-48512","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-43382","kind":"heading","level":3,"spans":[{"id":"spn-48513","text":"Starting the Watcher"}]},{"id":"blk-43383","kind":"paragraph","spans":[{"id":"spn-48514","text":"1. Note the target directory and configuration 2. Inform the user that watching is active 3. On each detected change, use "},{"id":"spn-48515","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-48516","text":" to ingest"}]},{"id":"blk-43384","kind":"paragraph","spans":[{"id":"spn-48517","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-43385","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-43386","kind":"paragraph","spans":[{"id":"spn-48518","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-43387","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-43388","kind":"heading","level":3,"spans":[{"id":"spn-48519","text":"What Gets Watched"}]},{"id":"blk-43389","kind":"paragraph","spans":[{"id":"spn-48520","text":"The watcher tracks:"}]},{"id":"blk-43390","items":[{"blocks":[{"id":"blk-43392","kind":"paragraph","spans":[{"id":"spn-48521","marks":["bold"],"text":"Added files"},{"id":"spn-48522","text":": new files matching the extension filter -> "},{"id":"spn-48523","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-43391","kind":"list-item"},{"blocks":[{"id":"blk-43394","kind":"paragraph","spans":[{"id":"spn-48524","marks":["bold"],"text":"Modified files"},{"id":"spn-48525","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-43393","kind":"list-item"},{"blocks":[{"id":"blk-43396","kind":"paragraph","spans":[{"id":"spn-48526","marks":["bold"],"text":"Removed files"},{"id":"spn-48527","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-43395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43397","kind":"heading","level":3,"spans":[{"id":"spn-48528","text":"Watcher Configuration"}]},{"head":[{"id":"blk-43399","spans":[{"id":"spn-48529","text":"Option"}]},{"id":"blk-43400","spans":[{"id":"spn-48530","text":"Default"}]},{"id":"blk-43401","spans":[{"id":"spn-48531","text":"Description"}]}],"id":"blk-43398","kind":"table","rows":[[{"id":"blk-43402","spans":[{"id":"spn-48532","marks":["code"],"text":"path"}]},{"id":"blk-43403","spans":[{"id":"spn-48533","text":"(required)"}]},{"id":"blk-43404","spans":[{"id":"spn-48534","text":"Root directory to watch"}]}],[{"id":"blk-43405","spans":[{"id":"spn-48535","marks":["code"],"text":"interval"}]},{"id":"blk-43406","spans":[{"id":"spn-48536","text":"5000ms"}]},{"id":"blk-43407","spans":[{"id":"spn-48537","text":"How often to check for changes"}]}],[{"id":"blk-43408","spans":[{"id":"spn-48538","marks":["code"],"text":"extensions"}]},{"id":"blk-43409","spans":[{"id":"spn-48539","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-43410","spans":[{"id":"spn-48540","text":"File types to include"}]}],[{"id":"blk-43411","spans":[{"id":"spn-48541","marks":["code"],"text":"recursive"}]},{"id":"blk-43412","spans":[{"id":"spn-48542","text":"true"}]},{"id":"blk-43413","spans":[{"id":"spn-48543","text":"Watch subdirectories"}]}],[{"id":"blk-43414","spans":[{"id":"spn-48544","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-43415","spans":[{"id":"spn-48545","text":"true"}]},{"id":"blk-43416","spans":[{"id":"spn-48546","text":"Skip .gitignore'd files"}]}],[{"id":"blk-43417","spans":[{"id":"spn-48547","marks":["code"],"text":"max_file_size"}]},{"id":"blk-43418","spans":[{"id":"spn-48548","text":"1MB"}]},{"id":"blk-43419","spans":[{"id":"spn-48549","text":"Skip files larger than this"}]}]]},{"id":"blk-43420","kind":"heading","level":3,"spans":[{"id":"spn-48550","text":"Important Notes"}]},{"id":"blk-43421","items":[{"blocks":[{"id":"blk-43423","kind":"paragraph","spans":[{"id":"spn-48551","text":"The watcher runs as a "},{"id":"spn-48552","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-48553","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-43422","kind":"list-item"},{"blocks":[{"id":"blk-43425","kind":"paragraph","spans":[{"id":"spn-48554","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-48555","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-43424","kind":"list-item"},{"blocks":[{"id":"blk-43427","kind":"paragraph","spans":[{"id":"spn-48556","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-48557","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-48558","text":" periodically for that)"}]}],"id":"blk-43426","kind":"list-item"},{"blocks":[{"id":"blk-43429","kind":"paragraph","spans":[{"id":"spn-48559","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-43428","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43430","kind":"heading","level":2,"spans":[{"id":"spn-48560","text":"Native CLI Alternative"}]},{"id":"blk-43431","kind":"paragraph","spans":[{"id":"spn-48561","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-43432","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-43433","kind":"paragraph","spans":[{"id":"spn-48562","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-43434","kind":"heading","level":2,"spans":[{"id":"spn-48563","text":"Anti-patterns to avoid"}]},{"id":"blk-43435","items":[{"blocks":[{"id":"blk-43437","kind":"paragraph","spans":[{"id":"spn-48564","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-43436","kind":"list-item"},{"blocks":[{"id":"blk-43439","kind":"paragraph","spans":[{"id":"spn-48565","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-43438","kind":"list-item"},{"blocks":[{"id":"blk-43441","kind":"paragraph","spans":[{"id":"spn-48566","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-43440","kind":"list-item"},{"blocks":[{"id":"blk-43443","kind":"paragraph","spans":[{"id":"spn-48567","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-43442","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraqdhf33ff4szqgjwuhsowu6ewmb7t7rfvgyhdj7g5l42qnqu6irgq","vocabulary":"ampersand.docs.fs.v1"}