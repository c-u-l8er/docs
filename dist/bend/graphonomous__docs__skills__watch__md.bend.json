{"bendscript":"0.1","blocks":[{"id":"blk-69198","kind":"heading","level":1,"spans":[{"id":"spn-101769","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-69199","kind":"paragraph","spans":[{"id":"spn-101770","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-69200","kind":"heading","level":2,"spans":[{"id":"spn-101771","text":"Arguments"}]},{"id":"blk-69201","kind":"paragraph","spans":[{"id":"spn-101772","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-69202","items":[{"blocks":[{"id":"blk-69204","kind":"paragraph","spans":[{"id":"spn-101773","marks":["code"],"text":"<path>"},{"id":"spn-101774","text":": directory to watch (required)"}]}],"id":"blk-69203","kind":"list-item"},{"blocks":[{"id":"blk-69206","kind":"paragraph","spans":[{"id":"spn-101775","marks":["code"],"text":"--interval <ms>"},{"id":"spn-101776","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-69205","kind":"list-item"},{"blocks":[{"id":"blk-69208","kind":"paragraph","spans":[{"id":"spn-101777","marks":["code"],"text":"--extensions <list>"},{"id":"spn-101778","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-69207","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69209","kind":"heading","level":2,"spans":[{"id":"spn-101779","text":"How It Works"}]},{"id":"blk-69210","kind":"paragraph","spans":[{"id":"spn-101780","text":"Graphonomous has a built-in "},{"id":"spn-101781","marks":["code"],"text":"watch_directory"},{"id":"spn-101782","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-69211","kind":"heading","level":3,"spans":[{"id":"spn-101783","text":"Starting the Watcher"}]},{"id":"blk-69212","items":[{"blocks":[{"id":"blk-69214","kind":"paragraph","spans":[{"id":"spn-101784","text":"Note the target directory and configuration"}]}],"id":"blk-69213","kind":"list-item"},{"blocks":[{"id":"blk-69216","kind":"paragraph","spans":[{"id":"spn-101785","text":"Inform the user that watching is active"}]}],"id":"blk-69215","kind":"list-item"},{"blocks":[{"id":"blk-69218","kind":"paragraph","spans":[{"id":"spn-101786","text":"On each detected change, use "},{"id":"spn-101787","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-101788","text":" to ingest"}]}],"id":"blk-69217","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-69219","kind":"paragraph","spans":[{"id":"spn-101789","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-69220","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-69221","kind":"paragraph","spans":[{"id":"spn-101790","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-69222","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-69223","kind":"heading","level":3,"spans":[{"id":"spn-101791","text":"What Gets Watched"}]},{"id":"blk-69224","kind":"paragraph","spans":[{"id":"spn-101792","text":"The watcher tracks:"}]},{"id":"blk-69225","items":[{"blocks":[{"id":"blk-69227","kind":"paragraph","spans":[{"id":"spn-101793","marks":["bold"],"text":"Added files"},{"id":"spn-101794","text":": new files matching the extension filter -> "},{"id":"spn-101795","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-69226","kind":"list-item"},{"blocks":[{"id":"blk-69229","kind":"paragraph","spans":[{"id":"spn-101796","marks":["bold"],"text":"Modified files"},{"id":"spn-101797","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-69228","kind":"list-item"},{"blocks":[{"id":"blk-69231","kind":"paragraph","spans":[{"id":"spn-101798","marks":["bold"],"text":"Removed files"},{"id":"spn-101799","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-69230","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69232","kind":"heading","level":3,"spans":[{"id":"spn-101800","text":"Watcher Configuration"}]},{"head":[{"id":"blk-69234","spans":[{"id":"spn-101801","text":"Option"}]},{"id":"blk-69235","spans":[{"id":"spn-101802","text":"Default"}]},{"id":"blk-69236","spans":[{"id":"spn-101803","text":"Description"}]}],"id":"blk-69233","kind":"table","rows":[[{"id":"blk-69237","spans":[{"id":"spn-101804","marks":["code"],"text":"path"}]},{"id":"blk-69238","spans":[{"id":"spn-101805","text":"(required)"}]},{"id":"blk-69239","spans":[{"id":"spn-101806","text":"Root directory to watch"}]}],[{"id":"blk-69240","spans":[{"id":"spn-101807","marks":["code"],"text":"interval"}]},{"id":"blk-69241","spans":[{"id":"spn-101808","text":"5000ms"}]},{"id":"blk-69242","spans":[{"id":"spn-101809","text":"How often to check for changes"}]}],[{"id":"blk-69243","spans":[{"id":"spn-101810","marks":["code"],"text":"extensions"}]},{"id":"blk-69244","spans":[{"id":"spn-101811","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-69245","spans":[{"id":"spn-101812","text":"File types to include"}]}],[{"id":"blk-69246","spans":[{"id":"spn-101813","marks":["code"],"text":"recursive"}]},{"id":"blk-69247","spans":[{"id":"spn-101814","text":"true"}]},{"id":"blk-69248","spans":[{"id":"spn-101815","text":"Watch subdirectories"}]}],[{"id":"blk-69249","spans":[{"id":"spn-101816","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-69250","spans":[{"id":"spn-101817","text":"true"}]},{"id":"blk-69251","spans":[{"id":"spn-101818","text":"Skip .gitignore'd files"}]}],[{"id":"blk-69252","spans":[{"id":"spn-101819","marks":["code"],"text":"max_file_size"}]},{"id":"blk-69253","spans":[{"id":"spn-101820","text":"1MB"}]},{"id":"blk-69254","spans":[{"id":"spn-101821","text":"Skip files larger than this"}]}]]},{"id":"blk-69255","kind":"heading","level":3,"spans":[{"id":"spn-101822","text":"Important Notes"}]},{"id":"blk-69256","items":[{"blocks":[{"id":"blk-69258","kind":"paragraph","spans":[{"id":"spn-101823","text":"The watcher runs as a "},{"id":"spn-101824","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-101825","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-69257","kind":"list-item"},{"blocks":[{"id":"blk-69260","kind":"paragraph","spans":[{"id":"spn-101826","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-101827","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-69259","kind":"list-item"},{"blocks":[{"id":"blk-69262","kind":"paragraph","spans":[{"id":"spn-101828","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-101829","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-101830","text":" periodically for that)"}]}],"id":"blk-69261","kind":"list-item"},{"blocks":[{"id":"blk-69264","kind":"paragraph","spans":[{"id":"spn-101831","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-69263","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-69265","kind":"heading","level":2,"spans":[{"id":"spn-101832","text":"Native CLI Alternative"}]},{"id":"blk-69266","kind":"paragraph","spans":[{"id":"spn-101833","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-69267","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-69268","kind":"paragraph","spans":[{"id":"spn-101834","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-69269","kind":"heading","level":2,"spans":[{"id":"spn-101835","text":"Anti-patterns to avoid"}]},{"id":"blk-69270","items":[{"blocks":[{"id":"blk-69272","kind":"paragraph","spans":[{"id":"spn-101836","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-69271","kind":"list-item"},{"blocks":[{"id":"blk-69274","kind":"paragraph","spans":[{"id":"spn-101837","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-69273","kind":"list-item"},{"blocks":[{"id":"blk-69276","kind":"paragraph","spans":[{"id":"spn-101838","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-69275","kind":"list-item"},{"blocks":[{"id":"blk-69278","kind":"paragraph","spans":[{"id":"spn-101839","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-69277","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera24ibk2gmvkjurn3ikns6w4z2zsnont5cpw37d5jku4fxniosnhcq","vocabulary":"ampersand.docs.fs.v1"}