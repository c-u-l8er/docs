{"bendscript":"0.1","blocks":[{"id":"blk-68244","kind":"heading","level":1,"spans":[{"id":"spn-99008","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-68245","kind":"paragraph","spans":[{"id":"spn-99009","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-68246","kind":"heading","level":2,"spans":[{"id":"spn-99010","text":"Arguments"}]},{"id":"blk-68247","kind":"paragraph","spans":[{"id":"spn-99011","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-68248","items":[{"blocks":[{"id":"blk-68250","kind":"paragraph","spans":[{"id":"spn-99012","marks":["code"],"text":"<path>"},{"id":"spn-99013","text":": directory to watch (required)"}]}],"id":"blk-68249","kind":"list-item"},{"blocks":[{"id":"blk-68252","kind":"paragraph","spans":[{"id":"spn-99014","marks":["code"],"text":"--interval <ms>"},{"id":"spn-99015","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-68251","kind":"list-item"},{"blocks":[{"id":"blk-68254","kind":"paragraph","spans":[{"id":"spn-99016","marks":["code"],"text":"--extensions <list>"},{"id":"spn-99017","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-68253","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68255","kind":"heading","level":2,"spans":[{"id":"spn-99018","text":"How It Works"}]},{"id":"blk-68256","kind":"paragraph","spans":[{"id":"spn-99019","text":"Graphonomous has a built-in "},{"id":"spn-99020","marks":["code"],"text":"watch_directory"},{"id":"spn-99021","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-68257","kind":"heading","level":3,"spans":[{"id":"spn-99022","text":"Starting the Watcher"}]},{"id":"blk-68258","items":[{"blocks":[{"id":"blk-68260","kind":"paragraph","spans":[{"id":"spn-99023","text":"Note the target directory and configuration"}]}],"id":"blk-68259","kind":"list-item"},{"blocks":[{"id":"blk-68262","kind":"paragraph","spans":[{"id":"spn-99024","text":"Inform the user that watching is active"}]}],"id":"blk-68261","kind":"list-item"},{"blocks":[{"id":"blk-68264","kind":"paragraph","spans":[{"id":"spn-99025","text":"On each detected change, use "},{"id":"spn-99026","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-99027","text":" to ingest"}]}],"id":"blk-68263","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68265","kind":"paragraph","spans":[{"id":"spn-99028","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-68266","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-68267","kind":"paragraph","spans":[{"id":"spn-99029","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-68268","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-68269","kind":"heading","level":3,"spans":[{"id":"spn-99030","text":"What Gets Watched"}]},{"id":"blk-68270","kind":"paragraph","spans":[{"id":"spn-99031","text":"The watcher tracks:"}]},{"id":"blk-68271","items":[{"blocks":[{"id":"blk-68273","kind":"paragraph","spans":[{"id":"spn-99032","marks":["bold"],"text":"Added files"},{"id":"spn-99033","text":": new files matching the extension filter -> "},{"id":"spn-99034","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-68272","kind":"list-item"},{"blocks":[{"id":"blk-68275","kind":"paragraph","spans":[{"id":"spn-99035","marks":["bold"],"text":"Modified files"},{"id":"spn-99036","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-68274","kind":"list-item"},{"blocks":[{"id":"blk-68277","kind":"paragraph","spans":[{"id":"spn-99037","marks":["bold"],"text":"Removed files"},{"id":"spn-99038","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-68276","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68278","kind":"heading","level":3,"spans":[{"id":"spn-99039","text":"Watcher Configuration"}]},{"head":[{"id":"blk-68280","spans":[{"id":"spn-99040","text":"Option"}]},{"id":"blk-68281","spans":[{"id":"spn-99041","text":"Default"}]},{"id":"blk-68282","spans":[{"id":"spn-99042","text":"Description"}]}],"id":"blk-68279","kind":"table","rows":[[{"id":"blk-68283","spans":[{"id":"spn-99043","marks":["code"],"text":"path"}]},{"id":"blk-68284","spans":[{"id":"spn-99044","text":"(required)"}]},{"id":"blk-68285","spans":[{"id":"spn-99045","text":"Root directory to watch"}]}],[{"id":"blk-68286","spans":[{"id":"spn-99046","marks":["code"],"text":"interval"}]},{"id":"blk-68287","spans":[{"id":"spn-99047","text":"5000ms"}]},{"id":"blk-68288","spans":[{"id":"spn-99048","text":"How often to check for changes"}]}],[{"id":"blk-68289","spans":[{"id":"spn-99049","marks":["code"],"text":"extensions"}]},{"id":"blk-68290","spans":[{"id":"spn-99050","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-68291","spans":[{"id":"spn-99051","text":"File types to include"}]}],[{"id":"blk-68292","spans":[{"id":"spn-99052","marks":["code"],"text":"recursive"}]},{"id":"blk-68293","spans":[{"id":"spn-99053","text":"true"}]},{"id":"blk-68294","spans":[{"id":"spn-99054","text":"Watch subdirectories"}]}],[{"id":"blk-68295","spans":[{"id":"spn-99055","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-68296","spans":[{"id":"spn-99056","text":"true"}]},{"id":"blk-68297","spans":[{"id":"spn-99057","text":"Skip .gitignore'd files"}]}],[{"id":"blk-68298","spans":[{"id":"spn-99058","marks":["code"],"text":"max_file_size"}]},{"id":"blk-68299","spans":[{"id":"spn-99059","text":"1MB"}]},{"id":"blk-68300","spans":[{"id":"spn-99060","text":"Skip files larger than this"}]}]]},{"id":"blk-68301","kind":"heading","level":3,"spans":[{"id":"spn-99061","text":"Important Notes"}]},{"id":"blk-68302","items":[{"blocks":[{"id":"blk-68304","kind":"paragraph","spans":[{"id":"spn-99062","text":"The watcher runs as a "},{"id":"spn-99063","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-99064","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-68303","kind":"list-item"},{"blocks":[{"id":"blk-68306","kind":"paragraph","spans":[{"id":"spn-99065","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-99066","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-68305","kind":"list-item"},{"blocks":[{"id":"blk-68308","kind":"paragraph","spans":[{"id":"spn-99067","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-99068","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-99069","text":" periodically for that)"}]}],"id":"blk-68307","kind":"list-item"},{"blocks":[{"id":"blk-68310","kind":"paragraph","spans":[{"id":"spn-99070","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-68309","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68311","kind":"heading","level":2,"spans":[{"id":"spn-99071","text":"Native CLI Alternative"}]},{"id":"blk-68312","kind":"paragraph","spans":[{"id":"spn-99072","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-68313","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-68314","kind":"paragraph","spans":[{"id":"spn-99073","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-68315","kind":"heading","level":2,"spans":[{"id":"spn-99074","text":"Anti-patterns to avoid"}]},{"id":"blk-68316","items":[{"blocks":[{"id":"blk-68318","kind":"paragraph","spans":[{"id":"spn-99075","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-68317","kind":"list-item"},{"blocks":[{"id":"blk-68320","kind":"paragraph","spans":[{"id":"spn-99076","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-68319","kind":"list-item"},{"blocks":[{"id":"blk-68322","kind":"paragraph","spans":[{"id":"spn-99077","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-68321","kind":"list-item"},{"blocks":[{"id":"blk-68324","kind":"paragraph","spans":[{"id":"spn-99078","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-68323","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierayttvn4hdlfdl55az5rct4lligbfxiivarxkxe32zijluhnsjfs6q","vocabulary":"ampersand.docs.fs.v1"}