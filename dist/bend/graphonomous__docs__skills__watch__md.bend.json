{"bendscript":"0.1","blocks":[{"id":"blk-43478","kind":"paragraph","spans":[{"id":"spn-49125","text":"--- name: watch description: Use when the user says \"watch directory\", \"monitor files\", \"start watching\", \"live sync\", \"auto-ingest\", or wants continuous filesystem monitoring synced to Graphonomous. Starts a polling loop that detects file changes and ingests them automatically. Uses "},{"id":"spn-49126","marks":["code"],"text":"act"},{"id":"spn-49127","text":" machine for storage. argument-hint: <path> [--interval <ms>] [--extensions <list>] ---"}]},{"id":"blk-43479","kind":"heading","level":1,"spans":[{"id":"spn-49128","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-43480","kind":"paragraph","spans":[{"id":"spn-49129","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-43481","kind":"heading","level":2,"spans":[{"id":"spn-49130","text":"Arguments"}]},{"id":"blk-43482","kind":"paragraph","spans":[{"id":"spn-49131","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-43483","items":[{"blocks":[{"id":"blk-43485","kind":"paragraph","spans":[{"id":"spn-49132","marks":["code"],"text":"<path>"},{"id":"spn-49133","text":": directory to watch (required)"}]}],"id":"blk-43484","kind":"list-item"},{"blocks":[{"id":"blk-43487","kind":"paragraph","spans":[{"id":"spn-49134","marks":["code"],"text":"--interval <ms>"},{"id":"spn-49135","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-43486","kind":"list-item"},{"blocks":[{"id":"blk-43489","kind":"paragraph","spans":[{"id":"spn-49136","marks":["code"],"text":"--extensions <list>"},{"id":"spn-49137","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-43488","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43490","kind":"heading","level":2,"spans":[{"id":"spn-49138","text":"How It Works"}]},{"id":"blk-43491","kind":"paragraph","spans":[{"id":"spn-49139","text":"Graphonomous has a built-in "},{"id":"spn-49140","marks":["code"],"text":"watch_directory"},{"id":"spn-49141","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-43492","kind":"heading","level":3,"spans":[{"id":"spn-49142","text":"Starting the Watcher"}]},{"id":"blk-43493","kind":"paragraph","spans":[{"id":"spn-49143","text":"1. Note the target directory and configuration 2. Inform the user that watching is active 3. On each detected change, use "},{"id":"spn-49144","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-49145","text":" to ingest"}]},{"id":"blk-43494","kind":"paragraph","spans":[{"id":"spn-49146","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-43495","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-43496","kind":"paragraph","spans":[{"id":"spn-49147","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-43497","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-43498","kind":"heading","level":3,"spans":[{"id":"spn-49148","text":"What Gets Watched"}]},{"id":"blk-43499","kind":"paragraph","spans":[{"id":"spn-49149","text":"The watcher tracks:"}]},{"id":"blk-43500","items":[{"blocks":[{"id":"blk-43502","kind":"paragraph","spans":[{"id":"spn-49150","marks":["bold"],"text":"Added files"},{"id":"spn-49151","text":": new files matching the extension filter -> "},{"id":"spn-49152","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-43501","kind":"list-item"},{"blocks":[{"id":"blk-43504","kind":"paragraph","spans":[{"id":"spn-49153","marks":["bold"],"text":"Modified files"},{"id":"spn-49154","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-43503","kind":"list-item"},{"blocks":[{"id":"blk-43506","kind":"paragraph","spans":[{"id":"spn-49155","marks":["bold"],"text":"Removed files"},{"id":"spn-49156","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-43505","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43507","kind":"heading","level":3,"spans":[{"id":"spn-49157","text":"Watcher Configuration"}]},{"head":[{"id":"blk-43509","spans":[{"id":"spn-49158","text":"Option"}]},{"id":"blk-43510","spans":[{"id":"spn-49159","text":"Default"}]},{"id":"blk-43511","spans":[{"id":"spn-49160","text":"Description"}]}],"id":"blk-43508","kind":"table","rows":[[{"id":"blk-43512","spans":[{"id":"spn-49161","marks":["code"],"text":"path"}]},{"id":"blk-43513","spans":[{"id":"spn-49162","text":"(required)"}]},{"id":"blk-43514","spans":[{"id":"spn-49163","text":"Root directory to watch"}]}],[{"id":"blk-43515","spans":[{"id":"spn-49164","marks":["code"],"text":"interval"}]},{"id":"blk-43516","spans":[{"id":"spn-49165","text":"5000ms"}]},{"id":"blk-43517","spans":[{"id":"spn-49166","text":"How often to check for changes"}]}],[{"id":"blk-43518","spans":[{"id":"spn-49167","marks":["code"],"text":"extensions"}]},{"id":"blk-43519","spans":[{"id":"spn-49168","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-43520","spans":[{"id":"spn-49169","text":"File types to include"}]}],[{"id":"blk-43521","spans":[{"id":"spn-49170","marks":["code"],"text":"recursive"}]},{"id":"blk-43522","spans":[{"id":"spn-49171","text":"true"}]},{"id":"blk-43523","spans":[{"id":"spn-49172","text":"Watch subdirectories"}]}],[{"id":"blk-43524","spans":[{"id":"spn-49173","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-43525","spans":[{"id":"spn-49174","text":"true"}]},{"id":"blk-43526","spans":[{"id":"spn-49175","text":"Skip .gitignore'd files"}]}],[{"id":"blk-43527","spans":[{"id":"spn-49176","marks":["code"],"text":"max_file_size"}]},{"id":"blk-43528","spans":[{"id":"spn-49177","text":"1MB"}]},{"id":"blk-43529","spans":[{"id":"spn-49178","text":"Skip files larger than this"}]}]]},{"id":"blk-43530","kind":"heading","level":3,"spans":[{"id":"spn-49179","text":"Important Notes"}]},{"id":"blk-43531","items":[{"blocks":[{"id":"blk-43533","kind":"paragraph","spans":[{"id":"spn-49180","text":"The watcher runs as a "},{"id":"spn-49181","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-49182","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-43532","kind":"list-item"},{"blocks":[{"id":"blk-43535","kind":"paragraph","spans":[{"id":"spn-49183","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-49184","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-43534","kind":"list-item"},{"blocks":[{"id":"blk-43537","kind":"paragraph","spans":[{"id":"spn-49185","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-49186","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-49187","text":" periodically for that)"}]}],"id":"blk-43536","kind":"list-item"},{"blocks":[{"id":"blk-43539","kind":"paragraph","spans":[{"id":"spn-49188","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-43538","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43540","kind":"heading","level":2,"spans":[{"id":"spn-49189","text":"Native CLI Alternative"}]},{"id":"blk-43541","kind":"paragraph","spans":[{"id":"spn-49190","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-43542","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-43543","kind":"paragraph","spans":[{"id":"spn-49191","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-43544","kind":"heading","level":2,"spans":[{"id":"spn-49192","text":"Anti-patterns to avoid"}]},{"id":"blk-43545","items":[{"blocks":[{"id":"blk-43547","kind":"paragraph","spans":[{"id":"spn-49193","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-43546","kind":"list-item"},{"blocks":[{"id":"blk-43549","kind":"paragraph","spans":[{"id":"spn-49194","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-43548","kind":"list-item"},{"blocks":[{"id":"blk-43551","kind":"paragraph","spans":[{"id":"spn-49195","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-43550","kind":"list-item"},{"blocks":[{"id":"blk-43553","kind":"paragraph","spans":[{"id":"spn-49196","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-43552","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieralfatgfvu6w7cqfcjod6ixzx5smphvd6zdglwr7d3inpbj2szp54q","vocabulary":"ampersand.docs.fs.v1"}