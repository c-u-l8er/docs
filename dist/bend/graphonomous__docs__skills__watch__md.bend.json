{"bendscript":"0.1","blocks":[{"id":"blk-68233","kind":"heading","level":1,"spans":[{"id":"spn-98955","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-68234","kind":"paragraph","spans":[{"id":"spn-98956","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-68235","kind":"heading","level":2,"spans":[{"id":"spn-98957","text":"Arguments"}]},{"id":"blk-68236","kind":"paragraph","spans":[{"id":"spn-98958","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-68237","items":[{"blocks":[{"id":"blk-68239","kind":"paragraph","spans":[{"id":"spn-98959","marks":["code"],"text":"<path>"},{"id":"spn-98960","text":": directory to watch (required)"}]}],"id":"blk-68238","kind":"list-item"},{"blocks":[{"id":"blk-68241","kind":"paragraph","spans":[{"id":"spn-98961","marks":["code"],"text":"--interval <ms>"},{"id":"spn-98962","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-68240","kind":"list-item"},{"blocks":[{"id":"blk-68243","kind":"paragraph","spans":[{"id":"spn-98963","marks":["code"],"text":"--extensions <list>"},{"id":"spn-98964","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-68242","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68244","kind":"heading","level":2,"spans":[{"id":"spn-98965","text":"How It Works"}]},{"id":"blk-68245","kind":"paragraph","spans":[{"id":"spn-98966","text":"Graphonomous has a built-in "},{"id":"spn-98967","marks":["code"],"text":"watch_directory"},{"id":"spn-98968","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-68246","kind":"heading","level":3,"spans":[{"id":"spn-98969","text":"Starting the Watcher"}]},{"id":"blk-68247","items":[{"blocks":[{"id":"blk-68249","kind":"paragraph","spans":[{"id":"spn-98970","text":"Note the target directory and configuration"}]}],"id":"blk-68248","kind":"list-item"},{"blocks":[{"id":"blk-68251","kind":"paragraph","spans":[{"id":"spn-98971","text":"Inform the user that watching is active"}]}],"id":"blk-68250","kind":"list-item"},{"blocks":[{"id":"blk-68253","kind":"paragraph","spans":[{"id":"spn-98972","text":"On each detected change, use "},{"id":"spn-98973","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-98974","text":" to ingest"}]}],"id":"blk-68252","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68254","kind":"paragraph","spans":[{"id":"spn-98975","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-68255","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-68256","kind":"paragraph","spans":[{"id":"spn-98976","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-68257","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-68258","kind":"heading","level":3,"spans":[{"id":"spn-98977","text":"What Gets Watched"}]},{"id":"blk-68259","kind":"paragraph","spans":[{"id":"spn-98978","text":"The watcher tracks:"}]},{"id":"blk-68260","items":[{"blocks":[{"id":"blk-68262","kind":"paragraph","spans":[{"id":"spn-98979","marks":["bold"],"text":"Added files"},{"id":"spn-98980","text":": new files matching the extension filter -> "},{"id":"spn-98981","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-68261","kind":"list-item"},{"blocks":[{"id":"blk-68264","kind":"paragraph","spans":[{"id":"spn-98982","marks":["bold"],"text":"Modified files"},{"id":"spn-98983","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-68263","kind":"list-item"},{"blocks":[{"id":"blk-68266","kind":"paragraph","spans":[{"id":"spn-98984","marks":["bold"],"text":"Removed files"},{"id":"spn-98985","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-68265","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68267","kind":"heading","level":3,"spans":[{"id":"spn-98986","text":"Watcher Configuration"}]},{"head":[{"id":"blk-68269","spans":[{"id":"spn-98987","text":"Option"}]},{"id":"blk-68270","spans":[{"id":"spn-98988","text":"Default"}]},{"id":"blk-68271","spans":[{"id":"spn-98989","text":"Description"}]}],"id":"blk-68268","kind":"table","rows":[[{"id":"blk-68272","spans":[{"id":"spn-98990","marks":["code"],"text":"path"}]},{"id":"blk-68273","spans":[{"id":"spn-98991","text":"(required)"}]},{"id":"blk-68274","spans":[{"id":"spn-98992","text":"Root directory to watch"}]}],[{"id":"blk-68275","spans":[{"id":"spn-98993","marks":["code"],"text":"interval"}]},{"id":"blk-68276","spans":[{"id":"spn-98994","text":"5000ms"}]},{"id":"blk-68277","spans":[{"id":"spn-98995","text":"How often to check for changes"}]}],[{"id":"blk-68278","spans":[{"id":"spn-98996","marks":["code"],"text":"extensions"}]},{"id":"blk-68279","spans":[{"id":"spn-98997","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-68280","spans":[{"id":"spn-98998","text":"File types to include"}]}],[{"id":"blk-68281","spans":[{"id":"spn-98999","marks":["code"],"text":"recursive"}]},{"id":"blk-68282","spans":[{"id":"spn-99000","text":"true"}]},{"id":"blk-68283","spans":[{"id":"spn-99001","text":"Watch subdirectories"}]}],[{"id":"blk-68284","spans":[{"id":"spn-99002","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-68285","spans":[{"id":"spn-99003","text":"true"}]},{"id":"blk-68286","spans":[{"id":"spn-99004","text":"Skip .gitignore'd files"}]}],[{"id":"blk-68287","spans":[{"id":"spn-99005","marks":["code"],"text":"max_file_size"}]},{"id":"blk-68288","spans":[{"id":"spn-99006","text":"1MB"}]},{"id":"blk-68289","spans":[{"id":"spn-99007","text":"Skip files larger than this"}]}]]},{"id":"blk-68290","kind":"heading","level":3,"spans":[{"id":"spn-99008","text":"Important Notes"}]},{"id":"blk-68291","items":[{"blocks":[{"id":"blk-68293","kind":"paragraph","spans":[{"id":"spn-99009","text":"The watcher runs as a "},{"id":"spn-99010","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-99011","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-68292","kind":"list-item"},{"blocks":[{"id":"blk-68295","kind":"paragraph","spans":[{"id":"spn-99012","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-99013","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-68294","kind":"list-item"},{"blocks":[{"id":"blk-68297","kind":"paragraph","spans":[{"id":"spn-99014","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-99015","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-99016","text":" periodically for that)"}]}],"id":"blk-68296","kind":"list-item"},{"blocks":[{"id":"blk-68299","kind":"paragraph","spans":[{"id":"spn-99017","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-68298","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68300","kind":"heading","level":2,"spans":[{"id":"spn-99018","text":"Native CLI Alternative"}]},{"id":"blk-68301","kind":"paragraph","spans":[{"id":"spn-99019","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-68302","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-68303","kind":"paragraph","spans":[{"id":"spn-99020","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-68304","kind":"heading","level":2,"spans":[{"id":"spn-99021","text":"Anti-patterns to avoid"}]},{"id":"blk-68305","items":[{"blocks":[{"id":"blk-68307","kind":"paragraph","spans":[{"id":"spn-99022","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-68306","kind":"list-item"},{"blocks":[{"id":"blk-68309","kind":"paragraph","spans":[{"id":"spn-99023","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-68308","kind":"list-item"},{"blocks":[{"id":"blk-68311","kind":"paragraph","spans":[{"id":"spn-99024","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-68310","kind":"list-item"},{"blocks":[{"id":"blk-68313","kind":"paragraph","spans":[{"id":"spn-99025","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-68312","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraky46gnyilqh2drfemflledkbc4qaeoapbfyict6loky3e3wtzuna","vocabulary":"ampersand.docs.fs.v1"}