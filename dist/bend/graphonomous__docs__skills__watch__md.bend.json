{"bendscript":"0.1","blocks":[{"id":"blk-44450","kind":"paragraph","spans":[{"id":"spn-51419","text":"--- name: watch description: Use when the user says \"watch directory\", \"monitor files\", \"start watching\", \"live sync\", \"auto-ingest\", or wants continuous filesystem monitoring synced to Graphonomous. Starts a polling loop that detects file changes and ingests them automatically. Uses "},{"id":"spn-51420","marks":["code"],"text":"act"},{"id":"spn-51421","text":" machine for storage. argument-hint: <path> [--interval <ms>] [--extensions <list>] ---"}]},{"id":"blk-44451","kind":"heading","level":1,"spans":[{"id":"spn-51422","text":"Watch Directory — Continuous Filesystem Sync"}]},{"id":"blk-44452","kind":"paragraph","spans":[{"id":"spn-51423","text":"Start a polling loop that detects filesystem changes and ingests them into Graphonomous."}]},{"id":"blk-44453","kind":"heading","level":2,"spans":[{"id":"spn-51424","text":"Arguments"}]},{"id":"blk-44454","kind":"paragraph","spans":[{"id":"spn-51425","text":"Required path and optional flags: $ARGUMENTS"}]},{"id":"blk-44455","items":[{"blocks":[{"id":"blk-44457","kind":"paragraph","spans":[{"id":"spn-51426","marks":["code"],"text":"<path>"},{"id":"spn-51427","text":": directory to watch (required)"}]}],"id":"blk-44456","kind":"list-item"},{"blocks":[{"id":"blk-44459","kind":"paragraph","spans":[{"id":"spn-51428","marks":["code"],"text":"--interval <ms>"},{"id":"spn-51429","text":": poll interval in milliseconds (default: 5000)"}]}],"id":"blk-44458","kind":"list-item"},{"blocks":[{"id":"blk-44461","kind":"paragraph","spans":[{"id":"spn-51430","marks":["code"],"text":"--extensions <list>"},{"id":"spn-51431","text":": comma-separated extensions to watch (default: .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte)"}]}],"id":"blk-44460","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44462","kind":"heading","level":2,"spans":[{"id":"spn-51432","text":"How It Works"}]},{"id":"blk-44463","kind":"paragraph","spans":[{"id":"spn-51433","text":"Graphonomous has a built-in "},{"id":"spn-51434","marks":["code"],"text":"watch_directory"},{"id":"spn-51435","text":" feature that polls for file changes using snapshot diffing (size + mtime + content SHA256). This skill wires that into the Claude Code session."}]},{"id":"blk-44464","kind":"heading","level":3,"spans":[{"id":"spn-51436","text":"Starting the Watcher"}]},{"id":"blk-44465","kind":"paragraph","spans":[{"id":"spn-51437","text":"1. Note the target directory and configuration 2. Inform the user that watching is active 3. On each detected change, use "},{"id":"spn-51438","marks":["code"],"text":"/graphonomous:sync <changed_file_path>"},{"id":"spn-51439","text":" to ingest"}]},{"id":"blk-44466","kind":"paragraph","spans":[{"id":"spn-51440","marks":["bold"],"text":"Example — watch the graphonomous lib directory:"}]},{"id":"blk-44467","kind":"code","language":"text","text":"/graphonomous:watch graphonomous/lib/ --interval 3000"},{"id":"blk-44468","kind":"paragraph","spans":[{"id":"spn-51441","marks":["bold"],"text":"Example — watch with specific extensions:"}]},{"id":"blk-44469","kind":"code","language":"text","text":"/graphonomous:watch WebHost.Systems/src/ --extensions .ts,.tsx,.js"},{"id":"blk-44470","kind":"heading","level":3,"spans":[{"id":"spn-51442","text":"What Gets Watched"}]},{"id":"blk-44471","kind":"paragraph","spans":[{"id":"spn-51443","text":"The watcher tracks:"}]},{"id":"blk-44472","items":[{"blocks":[{"id":"blk-44474","kind":"paragraph","spans":[{"id":"spn-51444","marks":["bold"],"text":"Added files"},{"id":"spn-51445","text":": new files matching the extension filter -> "},{"id":"spn-51446","marks":["code"],"text":"act(action: \"store_node\", ...)"}]}],"id":"blk-44473","kind":"list-item"},{"blocks":[{"id":"blk-44476","kind":"paragraph","spans":[{"id":"spn-51447","marks":["bold"],"text":"Modified files"},{"id":"spn-51448","text":": changed content (SHA256 differs) -> update existing node or store new"}]}],"id":"blk-44475","kind":"list-item"},{"blocks":[{"id":"blk-44478","kind":"paragraph","spans":[{"id":"spn-51449","marks":["bold"],"text":"Removed files"},{"id":"spn-51450","text":": deleted files -> optionally mark node confidence to 0.0"}]}],"id":"blk-44477","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44479","kind":"heading","level":3,"spans":[{"id":"spn-51451","text":"Watcher Configuration"}]},{"head":[{"id":"blk-44481","spans":[{"id":"spn-51452","text":"Option"}]},{"id":"blk-44482","spans":[{"id":"spn-51453","text":"Default"}]},{"id":"blk-44483","spans":[{"id":"spn-51454","text":"Description"}]}],"id":"blk-44480","kind":"table","rows":[[{"id":"blk-44484","spans":[{"id":"spn-51455","marks":["code"],"text":"path"}]},{"id":"blk-44485","spans":[{"id":"spn-51456","text":"(required)"}]},{"id":"blk-44486","spans":[{"id":"spn-51457","text":"Root directory to watch"}]}],[{"id":"blk-44487","spans":[{"id":"spn-51458","marks":["code"],"text":"interval"}]},{"id":"blk-44488","spans":[{"id":"spn-51459","text":"5000ms"}]},{"id":"blk-44489","spans":[{"id":"spn-51460","text":"How often to check for changes"}]}],[{"id":"blk-44490","spans":[{"id":"spn-51461","marks":["code"],"text":"extensions"}]},{"id":"blk-44491","spans":[{"id":"spn-51462","text":".ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte"}]},{"id":"blk-44492","spans":[{"id":"spn-51463","text":"File types to include"}]}],[{"id":"blk-44493","spans":[{"id":"spn-51464","marks":["code"],"text":"recursive"}]},{"id":"blk-44494","spans":[{"id":"spn-51465","text":"true"}]},{"id":"blk-44495","spans":[{"id":"spn-51466","text":"Watch subdirectories"}]}],[{"id":"blk-44496","spans":[{"id":"spn-51467","marks":["code"],"text":"respect_gitignore"}]},{"id":"blk-44497","spans":[{"id":"spn-51468","text":"true"}]},{"id":"blk-44498","spans":[{"id":"spn-51469","text":"Skip .gitignore'd files"}]}],[{"id":"blk-44499","spans":[{"id":"spn-51470","marks":["code"],"text":"max_file_size"}]},{"id":"blk-44500","spans":[{"id":"spn-51471","text":"1MB"}]},{"id":"blk-44501","spans":[{"id":"spn-51472","text":"Skip files larger than this"}]}]]},{"id":"blk-44502","kind":"heading","level":3,"spans":[{"id":"spn-51473","text":"Important Notes"}]},{"id":"blk-44503","items":[{"blocks":[{"id":"blk-44505","kind":"paragraph","spans":[{"id":"spn-51474","text":"The watcher runs as a "},{"id":"spn-51475","marks":["bold"],"text":"conceptual loop within the conversation"},{"id":"spn-51476","text":" — Claude checks for changes when prompted or between tasks"}]}],"id":"blk-44504","kind":"list-item"},{"blocks":[{"id":"blk-44507","kind":"paragraph","spans":[{"id":"spn-51477","text":"For true background watching, use Graphonomous's native CLI: "},{"id":"spn-51478","marks":["code"],"text":"graphonomous watch <path>"}]}],"id":"blk-44506","kind":"list-item"},{"blocks":[{"id":"blk-44509","kind":"paragraph","spans":[{"id":"spn-51479","text":"The watcher does NOT automatically run edge extraction (use "},{"id":"spn-51480","marks":["code"],"text":"/graphonomous:sync --full"},{"id":"spn-51481","text":" periodically for that)"}]}],"id":"blk-44508","kind":"list-item"},{"blocks":[{"id":"blk-44511","kind":"paragraph","spans":[{"id":"spn-51482","text":"Stop watching by saying \"stop watching\" or ending the session"}]}],"id":"blk-44510","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44512","kind":"heading","level":2,"spans":[{"id":"spn-51483","text":"Native CLI Alternative"}]},{"id":"blk-44513","kind":"paragraph","spans":[{"id":"spn-51484","text":"For continuous background watching outside of Claude Code sessions:"}]},{"id":"blk-44514","kind":"code","language":"bash","text":"cd graphonomous\nmix run --no-halt -- watch /home/travis/ProjectAmp2 \\\n  --poll-interval-ms 5000 \\\n  --extensions .ex,.exs,.ts,.js,.tsx,.md,.html,.css,.json,.svelte \\\n  --ingest-on-start \\\n  --consolidation-cadence 100"},{"id":"blk-44515","kind":"paragraph","spans":[{"id":"spn-51485","text":"This runs as a persistent process and is the recommended approach for always-on filesystem sync."}]},{"id":"blk-44516","kind":"heading","level":2,"spans":[{"id":"spn-51486","text":"Anti-patterns to avoid"}]},{"id":"blk-44517","items":[{"blocks":[{"id":"blk-44519","kind":"paragraph","spans":[{"id":"spn-51487","text":"Don't set poll interval below 1000ms — excessive polling wastes resources"}]}],"id":"blk-44518","kind":"list-item"},{"blocks":[{"id":"blk-44521","kind":"paragraph","spans":[{"id":"spn-51488","text":"Don't watch node_modules, _build, deps, or .git directories"}]}],"id":"blk-44520","kind":"list-item"},{"blocks":[{"id":"blk-44523","kind":"paragraph","spans":[{"id":"spn-51489","text":"Don't expect real-time sub-second latency — this is polling-based, not inotify"}]}],"id":"blk-44522","kind":"list-item"},{"blocks":[{"id":"blk-44525","kind":"paragraph","spans":[{"id":"spn-51490","text":"Don't run multiple watchers on overlapping directories — you'll get duplicate nodes"}]}],"id":"blk-44524","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieranj5nfp2l5khionswrlvxlqbb6winiy4i3xzv66hwiwmgyfopchxq","vocabulary":"ampersand.docs.fs.v1"}