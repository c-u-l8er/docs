{"bendscript":"0.1","blocks":[{"id":"blk-31036","kind":"heading","level":1,"spans":[{"id":"spn-33993","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-31037","kind":"paragraph","spans":[{"id":"spn-33994","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-31038","items":[{"blocks":[{"id":"blk-31040","kind":"paragraph","spans":[{"id":"spn-33995","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-31039","kind":"list-item"},{"blocks":[{"id":"blk-31042","kind":"paragraph","spans":[{"id":"spn-33996","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-31041","kind":"list-item"},{"blocks":[{"id":"blk-31044","kind":"paragraph","spans":[{"id":"spn-33997","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-31043","kind":"list-item"},{"blocks":[{"id":"blk-31046","kind":"paragraph","spans":[{"id":"spn-33998","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-31045","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31047","kind":"heading","level":2,"spans":[{"id":"spn-33999","text":"Context"}]},{"id":"blk-31048","kind":"paragraph","spans":[{"id":"spn-34000","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-31049","kind":"paragraph","spans":[{"id":"spn-34001","text":"1. "},{"id":"spn-34002","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-34003","text":" for the majority of users:"}]},{"id":"blk-31050","items":[{"blocks":[{"id":"blk-31052","kind":"paragraph","spans":[{"id":"spn-34004","text":"low marginal cost for invocations,"}]}],"id":"blk-31051","kind":"list-item"},{"blocks":[{"id":"blk-31054","kind":"paragraph","spans":[{"id":"spn-34005","text":"low latency,"}]}],"id":"blk-31053","kind":"list-item"},{"blocks":[{"id":"blk-31056","kind":"paragraph","spans":[{"id":"spn-34006","text":"global availability,"}]}],"id":"blk-31055","kind":"list-item"},{"blocks":[{"id":"blk-31058","kind":"paragraph","spans":[{"id":"spn-34007","text":"simple developer experience."}]}],"id":"blk-31057","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31059","kind":"paragraph","spans":[{"id":"spn-34008","text":"2. "},{"id":"spn-34009","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-34010","text":" for premium customers and advanced workloads:"}]},{"id":"blk-31060","items":[{"blocks":[{"id":"blk-31062","kind":"paragraph","spans":[{"id":"spn-34011","text":"long-running sessions and tasks,"}]}],"id":"blk-31061","kind":"list-item"},{"blocks":[{"id":"blk-31064","kind":"paragraph","spans":[{"id":"spn-34012","text":"stronger isolation and security posture,"}]}],"id":"blk-31063","kind":"list-item"},{"blocks":[{"id":"blk-31066","kind":"paragraph","spans":[{"id":"spn-34013","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-31065","kind":"list-item"},{"blocks":[{"id":"blk-31068","kind":"paragraph","spans":[{"id":"spn-34014","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-31067","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31069","kind":"paragraph","spans":[{"id":"spn-34015","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-31070","kind":"paragraph","spans":[{"id":"spn-34016","text":"We also require:"}]},{"id":"blk-31071","items":[{"blocks":[{"id":"blk-31073","kind":"paragraph","spans":[{"id":"spn-34017","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-31072","kind":"list-item"},{"blocks":[{"id":"blk-31075","kind":"paragraph","spans":[{"id":"spn-34018","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-31074","kind":"list-item"},{"blocks":[{"id":"blk-31077","kind":"paragraph","spans":[{"id":"spn-34019","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-31076","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31078","kind":"heading","level":2,"spans":[{"id":"spn-34020","text":"Decision"}]},{"id":"blk-31079","kind":"paragraph","spans":[{"id":"spn-34021","text":"Adopt a "},{"id":"spn-34022","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-34023","text":" with a single "},{"id":"spn-34024","marks":["bold"],"text":"control plane"},{"id":"spn-34025","text":" and multiple "},{"id":"spn-34026","marks":["bold"],"text":"data plane"},{"id":"spn-34027","text":" runtime providers behind a shared "},{"id":"spn-34028","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-34029","text":"."}]},{"id":"blk-31080","kind":"heading","level":3,"spans":[{"id":"spn-34030","text":"Providers in v1"}]},{"id":"blk-31081","items":[{"blocks":[{"id":"blk-31083","kind":"paragraph","spans":[{"id":"spn-34031","marks":["bold"],"text":"Default runtime"},{"id":"spn-34032","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-34033","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-34034","text":")"}]}],"id":"blk-31082","kind":"list-item"},{"blocks":[{"id":"blk-31085","kind":"paragraph","spans":[{"id":"spn-34035","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-31084","kind":"list-item"},{"blocks":[{"id":"blk-31087","kind":"paragraph","spans":[{"id":"spn-34036","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-31086","kind":"list-item"},{"blocks":[{"id":"blk-31089","kind":"paragraph","spans":[{"id":"spn-34037","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-31088","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31090","items":[{"blocks":[{"id":"blk-31092","kind":"paragraph","spans":[{"id":"spn-34038","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-34039","text":": AWS Bedrock AgentCore ("},{"id":"spn-34040","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-34041","text":")"}]}],"id":"blk-31091","kind":"list-item"},{"blocks":[{"id":"blk-31094","kind":"paragraph","spans":[{"id":"spn-34042","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-31093","kind":"list-item"},{"blocks":[{"id":"blk-31096","kind":"paragraph","spans":[{"id":"spn-34043","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-31095","kind":"list-item"},{"blocks":[{"id":"blk-31098","kind":"paragraph","spans":[{"id":"spn-34044","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-34045","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-31097","kind":"list-item"},{"blocks":[{"id":"blk-31100","kind":"paragraph","spans":[{"id":"spn-34046","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-34047","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-31099","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31101","kind":"heading","level":3,"spans":[{"id":"spn-34048","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-31102","kind":"paragraph","spans":[{"id":"spn-34049","text":"webhost.systems is intended to be "},{"id":"spn-34050","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-34051","text":":"}]},{"id":"blk-31103","items":[{"blocks":[{"id":"blk-31105","kind":"paragraph","spans":[{"id":"spn-34052","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-31104","kind":"list-item"},{"blocks":[{"id":"blk-31107","kind":"paragraph","spans":[{"id":"spn-34053","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-31106","kind":"list-item"},{"blocks":[{"id":"blk-31109","kind":"paragraph","spans":[{"id":"spn-34054","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-31108","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31110","kind":"paragraph","spans":[{"id":"spn-34055","text":"This means "},{"id":"spn-34056","marks":["bold"],"text":"no Python requirement"},{"id":"spn-34057","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-31111","kind":"heading","level":3,"spans":[{"id":"spn-34058","text":"Control plane"}]},{"id":"blk-31112","items":[{"blocks":[{"id":"blk-31114","kind":"paragraph","spans":[{"id":"spn-34059","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-31113","kind":"list-item"},{"blocks":[{"id":"blk-31116","kind":"paragraph","spans":[{"id":"spn-34060","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-31115","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31117","kind":"heading","level":3,"spans":[{"id":"spn-34061","text":"Contract"}]},{"id":"blk-31118","items":[{"blocks":[{"id":"blk-31120","kind":"paragraph","spans":[{"id":"spn-34062","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-34063","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-34064","text":", including:"}]}],"id":"blk-31119","kind":"list-item"},{"blocks":[{"id":"blk-31122","kind":"paragraph","spans":[{"id":"spn-34065","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-31121","kind":"list-item"},{"blocks":[{"id":"blk-31124","kind":"paragraph","spans":[{"id":"spn-34066","marks":["code"],"text":"invoke(...)"},{"id":"spn-34067","text":" (streaming optional but preferred)"}]}],"id":"blk-31123","kind":"list-item"},{"blocks":[{"id":"blk-31126","kind":"paragraph","spans":[{"id":"spn-34068","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-31125","kind":"list-item"},{"blocks":[{"id":"blk-31128","kind":"paragraph","spans":[{"id":"spn-34069","text":"normalized error mapping"}]}],"id":"blk-31127","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31129","kind":"heading","level":2,"spans":[{"id":"spn-34070","text":"Alternatives considered"}]},{"id":"blk-31130","kind":"heading","level":3,"spans":[{"id":"spn-34071","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-31131","kind":"paragraph","spans":[{"id":"spn-34072","marks":["bold"],"text":"Pros"}]},{"id":"blk-31132","items":[{"blocks":[{"id":"blk-31134","kind":"paragraph","spans":[{"id":"spn-34073","text":"Simplest operational model and implementation."}]}],"id":"blk-31133","kind":"list-item"},{"blocks":[{"id":"blk-31136","kind":"paragraph","spans":[{"id":"spn-34074","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-31135","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31137","kind":"paragraph","spans":[{"id":"spn-34075","marks":["bold"],"text":"Cons"}]},{"id":"blk-31138","items":[{"blocks":[{"id":"blk-31140","kind":"paragraph","spans":[{"id":"spn-34076","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-31139","kind":"list-item"},{"blocks":[{"id":"blk-31142","kind":"paragraph","spans":[{"id":"spn-34077","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-31141","kind":"list-item"},{"blocks":[{"id":"blk-31144","kind":"paragraph","spans":[{"id":"spn-34078","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-31143","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31145","kind":"paragraph","spans":[{"id":"spn-34079","marks":["bold"],"text":"Why rejected"},{"id":"spn-34080","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-31146","kind":"heading","level":3,"spans":[{"id":"spn-34081","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-31147","kind":"paragraph","spans":[{"id":"spn-34082","marks":["bold"],"text":"Pros"}]},{"id":"blk-31148","items":[{"blocks":[{"id":"blk-31150","kind":"paragraph","spans":[{"id":"spn-34083","text":"Strong enterprise posture and capability set."}]}],"id":"blk-31149","kind":"list-item"},{"blocks":[{"id":"blk-31152","kind":"paragraph","spans":[{"id":"spn-34084","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-31151","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31153","kind":"paragraph","spans":[{"id":"spn-34085","marks":["bold"],"text":"Cons"}]},{"id":"blk-31154","items":[{"blocks":[{"id":"blk-31156","kind":"paragraph","spans":[{"id":"spn-34086","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-31155","kind":"list-item"},{"blocks":[{"id":"blk-31158","kind":"paragraph","spans":[{"id":"spn-34087","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-31157","kind":"list-item"},{"blocks":[{"id":"blk-31160","kind":"paragraph","spans":[{"id":"spn-34088","text":"Increased vendor lock-in risk."}]}],"id":"blk-31159","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31161","kind":"paragraph","spans":[{"id":"spn-34089","marks":["bold"],"text":"Why rejected"},{"id":"spn-34090","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-31162","kind":"heading","level":3,"spans":[{"id":"spn-34091","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-31163","kind":"paragraph","spans":[{"id":"spn-34092","marks":["bold"],"text":"Pros"}]},{"id":"blk-31164","items":[{"blocks":[{"id":"blk-31166","kind":"paragraph","spans":[{"id":"spn-34093","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-31165","kind":"list-item"},{"blocks":[{"id":"blk-31168","kind":"paragraph","spans":[{"id":"spn-34094","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-31167","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31169","kind":"paragraph","spans":[{"id":"spn-34095","marks":["bold"],"text":"Cons"}]},{"id":"blk-31170","items":[{"blocks":[{"id":"blk-31172","kind":"paragraph","spans":[{"id":"spn-34096","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-31171","kind":"list-item"},{"blocks":[{"id":"blk-31174","kind":"paragraph","spans":[{"id":"spn-34097","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-31173","kind":"list-item"},{"blocks":[{"id":"blk-31176","kind":"paragraph","spans":[{"id":"spn-34098","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-31175","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31177","kind":"paragraph","spans":[{"id":"spn-34099","marks":["bold"],"text":"Why rejected"},{"id":"spn-34100","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-31178","kind":"heading","level":3,"spans":[{"id":"spn-34101","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-31179","kind":"paragraph","spans":[{"id":"spn-34102","marks":["bold"],"text":"Pros"}]},{"id":"blk-31180","items":[{"blocks":[{"id":"blk-31182","kind":"paragraph","spans":[{"id":"spn-34103","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-31181","kind":"list-item"},{"blocks":[{"id":"blk-31184","kind":"paragraph","spans":[{"id":"spn-34104","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-31183","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31185","kind":"paragraph","spans":[{"id":"spn-34105","marks":["bold"],"text":"Cons"}]},{"id":"blk-31186","items":[{"blocks":[{"id":"blk-31188","kind":"paragraph","spans":[{"id":"spn-34106","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-31187","kind":"list-item"},{"blocks":[{"id":"blk-31190","kind":"paragraph","spans":[{"id":"spn-34107","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-31189","kind":"list-item"},{"blocks":[{"id":"blk-31192","kind":"paragraph","spans":[{"id":"spn-34108","text":"Slower time-to-market."}]}],"id":"blk-31191","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31193","kind":"paragraph","spans":[{"id":"spn-34109","marks":["bold"],"text":"Why rejected"},{"id":"spn-34110","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-31194","kind":"heading","level":2,"spans":[{"id":"spn-34111","text":"Consequences"}]},{"id":"blk-31195","kind":"heading","level":3,"spans":[{"id":"spn-34112","text":"Positive"}]},{"id":"blk-31196","items":[{"blocks":[{"id":"blk-31198","kind":"paragraph","spans":[{"id":"spn-34113","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-34114","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-31197","kind":"list-item"},{"blocks":[{"id":"blk-31200","kind":"paragraph","spans":[{"id":"spn-34115","marks":["bold"],"text":"Product flexibility"},{"id":"spn-34116","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-31199","kind":"list-item"},{"blocks":[{"id":"blk-31202","kind":"paragraph","spans":[{"id":"spn-34117","marks":["bold"],"text":"Risk reduction"},{"id":"spn-34118","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-31201","kind":"list-item"},{"blocks":[{"id":"blk-31204","kind":"paragraph","spans":[{"id":"spn-34119","marks":["bold"],"text":"Future extensibility"},{"id":"spn-34120","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-31203","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31205","kind":"heading","level":3,"spans":[{"id":"spn-34121","text":"Negative / costs"}]},{"id":"blk-31206","items":[{"blocks":[{"id":"blk-31208","kind":"paragraph","spans":[{"id":"spn-34122","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-34123","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-31207","kind":"list-item"},{"blocks":[{"id":"blk-31210","kind":"paragraph","spans":[{"id":"spn-34124","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-34125","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-31209","kind":"list-item"},{"blocks":[{"id":"blk-31212","kind":"paragraph","spans":[{"id":"spn-34126","marks":["bold"],"text":"Operational surface area"},{"id":"spn-34127","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-31211","kind":"list-item"},{"blocks":[{"id":"blk-31214","kind":"paragraph","spans":[{"id":"spn-34128","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-34129","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-31213","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31215","kind":"heading","level":2,"spans":[{"id":"spn-34130","text":"Implementation details (normative requirements)"}]},{"id":"blk-31216","kind":"paragraph","spans":[{"id":"spn-34131","text":"1. "},{"id":"spn-34132","marks":["bold"],"text":"RPI is mandatory"}]},{"id":"blk-31217","items":[{"blocks":[{"id":"blk-31219","kind":"paragraph","spans":[{"id":"spn-34133","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-31218","kind":"list-item"},{"blocks":[{"id":"blk-31221","kind":"paragraph","spans":[{"id":"spn-34134","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-31220","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31222","kind":"paragraph","spans":[{"id":"spn-34135","text":"2. "},{"id":"spn-34136","marks":["bold"],"text":"Invocation protocol is consistent"}]},{"id":"blk-31223","items":[{"blocks":[{"id":"blk-31225","kind":"paragraph","spans":[{"id":"spn-34137","text":"The canonical request/response shapes are defined in "},{"id":"spn-34138","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-34139","text":" and "},{"id":"spn-34140","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-34141","text":"."}]}],"id":"blk-31224","kind":"list-item"},{"blocks":[{"id":"blk-31227","kind":"paragraph","spans":[{"id":"spn-34142","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-31226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31228","kind":"paragraph","spans":[{"id":"spn-34143","text":"3. "},{"id":"spn-34144","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]},{"id":"blk-31229","items":[{"blocks":[{"id":"blk-31231","kind":"paragraph","spans":[{"id":"spn-34145","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-34146","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-34147","text":"."}]}],"id":"blk-31230","kind":"list-item"},{"blocks":[{"id":"blk-31233","kind":"paragraph","spans":[{"id":"spn-34148","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-31232","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31234","kind":"paragraph","spans":[{"id":"spn-34149","text":"4. "},{"id":"spn-34150","marks":["bold"],"text":"Tier gating"}]},{"id":"blk-31235","items":[{"blocks":[{"id":"blk-31237","kind":"paragraph","spans":[{"id":"spn-34151","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-31236","kind":"list-item"},{"blocks":[{"id":"blk-31239","kind":"paragraph","spans":[{"id":"spn-34152","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-31238","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31240","kind":"paragraph","spans":[{"id":"spn-34153","text":"5. "},{"id":"spn-34154","marks":["bold"],"text":"Secrets handling"}]},{"id":"blk-31241","items":[{"blocks":[{"id":"blk-31243","kind":"paragraph","spans":[{"id":"spn-34155","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-31242","kind":"list-item"},{"blocks":[{"id":"blk-31245","kind":"paragraph","spans":[{"id":"spn-34156","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id":"blk-31244","kind":"list-item"},{"blocks":[{"id":"blk-31247","kind":"paragraph","spans":[{"id":"spn-34157","text":"Telemetry signing secrets are deployment-scoped and injected into the data plane."}]}],"id":"blk-31246","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31248","kind":"paragraph","spans":[{"id":"spn-34158","text":"6. "},{"id":"spn-34159","marks":["bold"],"text":"Resource tagging"}]},{"id":"blk-31249","items":[{"blocks":[{"id":"blk-31251","kind":"paragraph","spans":[{"id":"spn-34160","text":"Provider resources should be tagged/labeled with "},{"id":"spn-34161","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-34162","text":" to support cleanup and future billing reconciliation."}]}],"id":"blk-31250","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31252","kind":"heading","level":2,"spans":[{"id":"spn-34163","text":"Operational considerations"}]},{"id":"blk-31253","items":[{"blocks":[{"id":"blk-31255","kind":"paragraph","spans":[{"id":"spn-34164","text":"Track per-provider health and error rates independently."}]}],"id":"blk-31254","kind":"list-item"},{"blocks":[{"id":"blk-31257","kind":"paragraph","spans":[{"id":"spn-34165","text":"Implement provider-specific circuit breakers if needed (post-v1)."}]}],"id":"blk-31256","kind":"list-item"},{"blocks":[{"id":"blk-31259","kind":"paragraph","spans":[{"id":"spn-34166","text":"Ensure staging environments exist for both providers with separate credentials and billing/webhook settings."}]}],"id":"blk-31258","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31260","kind":"heading","level":2,"spans":[{"id":"spn-34167","text":"Success criteria"}]},{"id":"blk-31261","kind":"paragraph","spans":[{"id":"spn-34168","text":"This decision is successful if:"}]},{"id":"blk-31262","items":[{"blocks":[{"id":"blk-31264","kind":"paragraph","spans":[{"id":"spn-34169","text":"Cloudflare deploy/invoke works end-to-end with telemetry and limit enforcement."}]}],"id":"blk-31263","kind":"list-item"},{"blocks":[{"id":"blk-31266","kind":"paragraph","spans":[{"id":"spn-34170","text":"AgentCore deploy/invoke works end-to-end for entitled users with telemetry and limit enforcement."}]}],"id":"blk-31265","kind":"list-item"},{"blocks":[{"id":"blk-31268","kind":"paragraph","spans":[{"id":"spn-34171","text":"Control plane routing remains provider-agnostic and uses only the RPI."}]}],"id":"blk-31267","kind":"list-item"},{"blocks":[{"id":"blk-31270","kind":"paragraph","spans":[{"id":"spn-34172","text":"Adding a new provider would require implementing a new adapter without major changes to the control plane schemas and APIs."}]}],"id":"blk-31269","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31271","kind":"heading","level":2,"spans":[{"id":"spn-34173","text":"Follow-ups / next ADRs"}]},{"id":"blk-31272","items":[{"blocks":[{"id":"blk-31274","kind":"paragraph","spans":[{"id":"spn-34174","text":"ADR-0002: Control plane backend choice (Supabase; supersedes original Convex choice)."}]}],"id":"blk-31273","kind":"list-item"},{"blocks":[{"id":"blk-31276","kind":"paragraph","spans":[{"id":"spn-34175","text":"ADR-0003: Secrets strategy (no plaintext in DB; provider injection)."}]}],"id":"blk-31275","kind":"list-item"},{"blocks":[{"id":"blk-31278","kind":"paragraph","spans":[{"id":"spn-34176","text":"ADR-0004: Telemetry integrity model (deployment-scoped signing) and ingestion validation."}]}],"id":"blk-31277","kind":"list-item"},{"blocks":[{"id":"blk-31280","kind":"paragraph","spans":[{"id":"spn-34177","text":"ADR-0005: Deployment immutability + active pointer model."}]}],"id":"blk-31279","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierabcpvxh53mckj5rsdyzmmq6txcuy6filwl6ovaghbx2iqvnyurmsa","vocabulary":"ampersand.docs.fs.v1"}