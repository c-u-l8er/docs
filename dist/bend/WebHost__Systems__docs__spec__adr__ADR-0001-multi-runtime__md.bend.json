{"bendscript":"0.1","blocks":[{"id":"blk-32117","kind":"heading","level":1,"spans":[{"id":"spn-36911","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-32118","kind":"paragraph","spans":[{"id":"spn-36912","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-32119","items":[{"blocks":[{"id":"blk-32121","kind":"paragraph","spans":[{"id":"spn-36913","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-32120","kind":"list-item"},{"blocks":[{"id":"blk-32123","kind":"paragraph","spans":[{"id":"spn-36914","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-32122","kind":"list-item"},{"blocks":[{"id":"blk-32125","kind":"paragraph","spans":[{"id":"spn-36915","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-32124","kind":"list-item"},{"blocks":[{"id":"blk-32127","kind":"paragraph","spans":[{"id":"spn-36916","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-32126","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32128","kind":"heading","level":2,"spans":[{"id":"spn-36917","text":"Context"}]},{"id":"blk-32129","kind":"paragraph","spans":[{"id":"spn-36918","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-32130","kind":"paragraph","spans":[{"id":"spn-36919","text":"1. "},{"id":"spn-36920","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-36921","text":" for the majority of users:"}]},{"id":"blk-32131","items":[{"blocks":[{"id":"blk-32133","kind":"paragraph","spans":[{"id":"spn-36922","text":"low marginal cost for invocations,"}]}],"id":"blk-32132","kind":"list-item"},{"blocks":[{"id":"blk-32135","kind":"paragraph","spans":[{"id":"spn-36923","text":"low latency,"}]}],"id":"blk-32134","kind":"list-item"},{"blocks":[{"id":"blk-32137","kind":"paragraph","spans":[{"id":"spn-36924","text":"global availability,"}]}],"id":"blk-32136","kind":"list-item"},{"blocks":[{"id":"blk-32139","kind":"paragraph","spans":[{"id":"spn-36925","text":"simple developer experience."}]}],"id":"blk-32138","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32140","kind":"paragraph","spans":[{"id":"spn-36926","text":"2. "},{"id":"spn-36927","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-36928","text":" for premium customers and advanced workloads:"}]},{"id":"blk-32141","items":[{"blocks":[{"id":"blk-32143","kind":"paragraph","spans":[{"id":"spn-36929","text":"long-running sessions and tasks,"}]}],"id":"blk-32142","kind":"list-item"},{"blocks":[{"id":"blk-32145","kind":"paragraph","spans":[{"id":"spn-36930","text":"stronger isolation and security posture,"}]}],"id":"blk-32144","kind":"list-item"},{"blocks":[{"id":"blk-32147","kind":"paragraph","spans":[{"id":"spn-36931","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-32146","kind":"list-item"},{"blocks":[{"id":"blk-32149","kind":"paragraph","spans":[{"id":"spn-36932","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-32148","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32150","kind":"paragraph","spans":[{"id":"spn-36933","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-32151","kind":"paragraph","spans":[{"id":"spn-36934","text":"We also require:"}]},{"id":"blk-32152","items":[{"blocks":[{"id":"blk-32154","kind":"paragraph","spans":[{"id":"spn-36935","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-32153","kind":"list-item"},{"blocks":[{"id":"blk-32156","kind":"paragraph","spans":[{"id":"spn-36936","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-32155","kind":"list-item"},{"blocks":[{"id":"blk-32158","kind":"paragraph","spans":[{"id":"spn-36937","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-32157","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32159","kind":"heading","level":2,"spans":[{"id":"spn-36938","text":"Decision"}]},{"id":"blk-32160","kind":"paragraph","spans":[{"id":"spn-36939","text":"Adopt a "},{"id":"spn-36940","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-36941","text":" with a single "},{"id":"spn-36942","marks":["bold"],"text":"control plane"},{"id":"spn-36943","text":" and multiple "},{"id":"spn-36944","marks":["bold"],"text":"data plane"},{"id":"spn-36945","text":" runtime providers behind a shared "},{"id":"spn-36946","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-36947","text":"."}]},{"id":"blk-32161","kind":"heading","level":3,"spans":[{"id":"spn-36948","text":"Providers in v1"}]},{"id":"blk-32162","items":[{"blocks":[{"id":"blk-32164","kind":"paragraph","spans":[{"id":"spn-36949","marks":["bold"],"text":"Default runtime"},{"id":"spn-36950","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-36951","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-36952","text":")"}]}],"id":"blk-32163","kind":"list-item"},{"blocks":[{"id":"blk-32166","kind":"paragraph","spans":[{"id":"spn-36953","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-32165","kind":"list-item"},{"blocks":[{"id":"blk-32168","kind":"paragraph","spans":[{"id":"spn-36954","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-32167","kind":"list-item"},{"blocks":[{"id":"blk-32170","kind":"paragraph","spans":[{"id":"spn-36955","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-32169","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32171","items":[{"blocks":[{"id":"blk-32173","kind":"paragraph","spans":[{"id":"spn-36956","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-36957","text":": AWS Bedrock AgentCore ("},{"id":"spn-36958","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-36959","text":")"}]}],"id":"blk-32172","kind":"list-item"},{"blocks":[{"id":"blk-32175","kind":"paragraph","spans":[{"id":"spn-36960","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-32174","kind":"list-item"},{"blocks":[{"id":"blk-32177","kind":"paragraph","spans":[{"id":"spn-36961","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-32176","kind":"list-item"},{"blocks":[{"id":"blk-32179","kind":"paragraph","spans":[{"id":"spn-36962","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-36963","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-32178","kind":"list-item"},{"blocks":[{"id":"blk-32181","kind":"paragraph","spans":[{"id":"spn-36964","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-36965","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-32180","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32182","kind":"heading","level":3,"spans":[{"id":"spn-36966","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-32183","kind":"paragraph","spans":[{"id":"spn-36967","text":"webhost.systems is intended to be "},{"id":"spn-36968","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-36969","text":":"}]},{"id":"blk-32184","items":[{"blocks":[{"id":"blk-32186","kind":"paragraph","spans":[{"id":"spn-36970","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-32185","kind":"list-item"},{"blocks":[{"id":"blk-32188","kind":"paragraph","spans":[{"id":"spn-36971","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-32187","kind":"list-item"},{"blocks":[{"id":"blk-32190","kind":"paragraph","spans":[{"id":"spn-36972","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-32189","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32191","kind":"paragraph","spans":[{"id":"spn-36973","text":"This means "},{"id":"spn-36974","marks":["bold"],"text":"no Python requirement"},{"id":"spn-36975","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-32192","kind":"heading","level":3,"spans":[{"id":"spn-36976","text":"Control plane"}]},{"id":"blk-32193","items":[{"blocks":[{"id":"blk-32195","kind":"paragraph","spans":[{"id":"spn-36977","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-32194","kind":"list-item"},{"blocks":[{"id":"blk-32197","kind":"paragraph","spans":[{"id":"spn-36978","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-32196","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32198","kind":"heading","level":3,"spans":[{"id":"spn-36979","text":"Contract"}]},{"id":"blk-32199","items":[{"blocks":[{"id":"blk-32201","kind":"paragraph","spans":[{"id":"spn-36980","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-36981","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-36982","text":", including:"}]}],"id":"blk-32200","kind":"list-item"},{"blocks":[{"id":"blk-32203","kind":"paragraph","spans":[{"id":"spn-36983","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-32202","kind":"list-item"},{"blocks":[{"id":"blk-32205","kind":"paragraph","spans":[{"id":"spn-36984","marks":["code"],"text":"invoke(...)"},{"id":"spn-36985","text":" (streaming optional but preferred)"}]}],"id":"blk-32204","kind":"list-item"},{"blocks":[{"id":"blk-32207","kind":"paragraph","spans":[{"id":"spn-36986","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-32206","kind":"list-item"},{"blocks":[{"id":"blk-32209","kind":"paragraph","spans":[{"id":"spn-36987","text":"normalized error mapping"}]}],"id":"blk-32208","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32210","kind":"heading","level":2,"spans":[{"id":"spn-36988","text":"Alternatives considered"}]},{"id":"blk-32211","kind":"heading","level":3,"spans":[{"id":"spn-36989","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-32212","kind":"paragraph","spans":[{"id":"spn-36990","marks":["bold"],"text":"Pros"}]},{"id":"blk-32213","items":[{"blocks":[{"id":"blk-32215","kind":"paragraph","spans":[{"id":"spn-36991","text":"Simplest operational model and implementation."}]}],"id":"blk-32214","kind":"list-item"},{"blocks":[{"id":"blk-32217","kind":"paragraph","spans":[{"id":"spn-36992","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-32216","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32218","kind":"paragraph","spans":[{"id":"spn-36993","marks":["bold"],"text":"Cons"}]},{"id":"blk-32219","items":[{"blocks":[{"id":"blk-32221","kind":"paragraph","spans":[{"id":"spn-36994","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-32220","kind":"list-item"},{"blocks":[{"id":"blk-32223","kind":"paragraph","spans":[{"id":"spn-36995","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-32222","kind":"list-item"},{"blocks":[{"id":"blk-32225","kind":"paragraph","spans":[{"id":"spn-36996","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-32224","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32226","kind":"paragraph","spans":[{"id":"spn-36997","marks":["bold"],"text":"Why rejected"},{"id":"spn-36998","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-32227","kind":"heading","level":3,"spans":[{"id":"spn-36999","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-32228","kind":"paragraph","spans":[{"id":"spn-37000","marks":["bold"],"text":"Pros"}]},{"id":"blk-32229","items":[{"blocks":[{"id":"blk-32231","kind":"paragraph","spans":[{"id":"spn-37001","text":"Strong enterprise posture and capability set."}]}],"id":"blk-32230","kind":"list-item"},{"blocks":[{"id":"blk-32233","kind":"paragraph","spans":[{"id":"spn-37002","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-32232","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32234","kind":"paragraph","spans":[{"id":"spn-37003","marks":["bold"],"text":"Cons"}]},{"id":"blk-32235","items":[{"blocks":[{"id":"blk-32237","kind":"paragraph","spans":[{"id":"spn-37004","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-32236","kind":"list-item"},{"blocks":[{"id":"blk-32239","kind":"paragraph","spans":[{"id":"spn-37005","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-32238","kind":"list-item"},{"blocks":[{"id":"blk-32241","kind":"paragraph","spans":[{"id":"spn-37006","text":"Increased vendor lock-in risk."}]}],"id":"blk-32240","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32242","kind":"paragraph","spans":[{"id":"spn-37007","marks":["bold"],"text":"Why rejected"},{"id":"spn-37008","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-32243","kind":"heading","level":3,"spans":[{"id":"spn-37009","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-32244","kind":"paragraph","spans":[{"id":"spn-37010","marks":["bold"],"text":"Pros"}]},{"id":"blk-32245","items":[{"blocks":[{"id":"blk-32247","kind":"paragraph","spans":[{"id":"spn-37011","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-32246","kind":"list-item"},{"blocks":[{"id":"blk-32249","kind":"paragraph","spans":[{"id":"spn-37012","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-32248","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32250","kind":"paragraph","spans":[{"id":"spn-37013","marks":["bold"],"text":"Cons"}]},{"id":"blk-32251","items":[{"blocks":[{"id":"blk-32253","kind":"paragraph","spans":[{"id":"spn-37014","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-32252","kind":"list-item"},{"blocks":[{"id":"blk-32255","kind":"paragraph","spans":[{"id":"spn-37015","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-32254","kind":"list-item"},{"blocks":[{"id":"blk-32257","kind":"paragraph","spans":[{"id":"spn-37016","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-32256","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32258","kind":"paragraph","spans":[{"id":"spn-37017","marks":["bold"],"text":"Why rejected"},{"id":"spn-37018","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-32259","kind":"heading","level":3,"spans":[{"id":"spn-37019","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-32260","kind":"paragraph","spans":[{"id":"spn-37020","marks":["bold"],"text":"Pros"}]},{"id":"blk-32261","items":[{"blocks":[{"id":"blk-32263","kind":"paragraph","spans":[{"id":"spn-37021","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-32262","kind":"list-item"},{"blocks":[{"id":"blk-32265","kind":"paragraph","spans":[{"id":"spn-37022","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-32264","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32266","kind":"paragraph","spans":[{"id":"spn-37023","marks":["bold"],"text":"Cons"}]},{"id":"blk-32267","items":[{"blocks":[{"id":"blk-32269","kind":"paragraph","spans":[{"id":"spn-37024","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-32268","kind":"list-item"},{"blocks":[{"id":"blk-32271","kind":"paragraph","spans":[{"id":"spn-37025","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-32270","kind":"list-item"},{"blocks":[{"id":"blk-32273","kind":"paragraph","spans":[{"id":"spn-37026","text":"Slower time-to-market."}]}],"id":"blk-32272","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32274","kind":"paragraph","spans":[{"id":"spn-37027","marks":["bold"],"text":"Why rejected"},{"id":"spn-37028","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-32275","kind":"heading","level":2,"spans":[{"id":"spn-37029","text":"Consequences"}]},{"id":"blk-32276","kind":"heading","level":3,"spans":[{"id":"spn-37030","text":"Positive"}]},{"id":"blk-32277","items":[{"blocks":[{"id":"blk-32279","kind":"paragraph","spans":[{"id":"spn-37031","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-37032","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-32278","kind":"list-item"},{"blocks":[{"id":"blk-32281","kind":"paragraph","spans":[{"id":"spn-37033","marks":["bold"],"text":"Product flexibility"},{"id":"spn-37034","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-32280","kind":"list-item"},{"blocks":[{"id":"blk-32283","kind":"paragraph","spans":[{"id":"spn-37035","marks":["bold"],"text":"Risk reduction"},{"id":"spn-37036","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-32282","kind":"list-item"},{"blocks":[{"id":"blk-32285","kind":"paragraph","spans":[{"id":"spn-37037","marks":["bold"],"text":"Future extensibility"},{"id":"spn-37038","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-32284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32286","kind":"heading","level":3,"spans":[{"id":"spn-37039","text":"Negative / costs"}]},{"id":"blk-32287","items":[{"blocks":[{"id":"blk-32289","kind":"paragraph","spans":[{"id":"spn-37040","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-37041","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-32288","kind":"list-item"},{"blocks":[{"id":"blk-32291","kind":"paragraph","spans":[{"id":"spn-37042","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-37043","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-32290","kind":"list-item"},{"blocks":[{"id":"blk-32293","kind":"paragraph","spans":[{"id":"spn-37044","marks":["bold"],"text":"Operational surface area"},{"id":"spn-37045","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-32292","kind":"list-item"},{"blocks":[{"id":"blk-32295","kind":"paragraph","spans":[{"id":"spn-37046","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-37047","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-32294","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32296","kind":"heading","level":2,"spans":[{"id":"spn-37048","text":"Implementation details (normative requirements)"}]},{"id":"blk-32297","kind":"paragraph","spans":[{"id":"spn-37049","text":"1. "},{"id":"spn-37050","marks":["bold"],"text":"RPI is mandatory"}]},{"id":"blk-32298","items":[{"blocks":[{"id":"blk-32300","kind":"paragraph","spans":[{"id":"spn-37051","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-32299","kind":"list-item"},{"blocks":[{"id":"blk-32302","kind":"paragraph","spans":[{"id":"spn-37052","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-32301","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32303","kind":"paragraph","spans":[{"id":"spn-37053","text":"2. "},{"id":"spn-37054","marks":["bold"],"text":"Invocation protocol is consistent"}]},{"id":"blk-32304","items":[{"blocks":[{"id":"blk-32306","kind":"paragraph","spans":[{"id":"spn-37055","text":"The canonical request/response shapes are defined in "},{"id":"spn-37056","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-37057","text":" and "},{"id":"spn-37058","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-37059","text":"."}]}],"id":"blk-32305","kind":"list-item"},{"blocks":[{"id":"blk-32308","kind":"paragraph","spans":[{"id":"spn-37060","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-32307","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32309","kind":"paragraph","spans":[{"id":"spn-37061","text":"3. "},{"id":"spn-37062","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]},{"id":"blk-32310","items":[{"blocks":[{"id":"blk-32312","kind":"paragraph","spans":[{"id":"spn-37063","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-37064","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-37065","text":"."}]}],"id":"blk-32311","kind":"list-item"},{"blocks":[{"id":"blk-32314","kind":"paragraph","spans":[{"id":"spn-37066","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-32313","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32315","kind":"paragraph","spans":[{"id":"spn-37067","text":"4. "},{"id":"spn-37068","marks":["bold"],"text":"Tier gating"}]},{"id":"blk-32316","items":[{"blocks":[{"id":"blk-32318","kind":"paragraph","spans":[{"id":"spn-37069","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-32317","kind":"list-item"},{"blocks":[{"id":"blk-32320","kind":"paragraph","spans":[{"id":"spn-37070","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-32319","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32321","kind":"paragraph","spans":[{"id":"spn-37071","text":"5. "},{"id":"spn-37072","marks":["bold"],"text":"Secrets handling"}]},{"id":"blk-32322","items":[{"blocks":[{"id":"blk-32324","kind":"paragraph","spans":[{"id":"spn-37073","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-32323","kind":"list-item"},{"blocks":[{"id":"blk-32326","kind":"paragraph","spans":[{"id":"spn-37074","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id":"blk-32325","kind":"list-item"},{"blocks":[{"id":"blk-32328","kind":"paragraph","spans":[{"id":"spn-37075","text":"Telemetry signing secrets are deployment-scoped and injected into the data plane."}]}],"id":"blk-32327","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-32329","kind":"paragraph","spans":[{"id":"spn-37076","text":"6. "},{"id":"spn-37077","marks":["bold"],"text":"Resource tagging"}]},{"id":"blk-32330","items":[{"blocks":[{"id":"blk-32332","kind":"paragraph","spans":[{"id":"spn-37078","text":"Provider resources should be tagged/labeled with "},{"id":"spn-37079","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-37080","text":" to support cleanup and future billing reconciliation