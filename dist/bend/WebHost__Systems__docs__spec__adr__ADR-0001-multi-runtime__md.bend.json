{"bendscript":"0.1","blocks":[{"id":"blk-31146","kind":"heading","level":1,"spans":[{"id":"spn-34622","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-31147","kind":"paragraph","spans":[{"id":"spn-34623","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-31148","items":[{"blocks":[{"id":"blk-31150","kind":"paragraph","spans":[{"id":"spn-34624","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-31149","kind":"list-item"},{"blocks":[{"id":"blk-31152","kind":"paragraph","spans":[{"id":"spn-34625","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-31151","kind":"list-item"},{"blocks":[{"id":"blk-31154","kind":"paragraph","spans":[{"id":"spn-34626","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-31153","kind":"list-item"},{"blocks":[{"id":"blk-31156","kind":"paragraph","spans":[{"id":"spn-34627","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-31155","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31157","kind":"heading","level":2,"spans":[{"id":"spn-34628","text":"Context"}]},{"id":"blk-31158","kind":"paragraph","spans":[{"id":"spn-34629","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-31159","kind":"paragraph","spans":[{"id":"spn-34630","text":"1. "},{"id":"spn-34631","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-34632","text":" for the majority of users:"}]},{"id":"blk-31160","items":[{"blocks":[{"id":"blk-31162","kind":"paragraph","spans":[{"id":"spn-34633","text":"low marginal cost for invocations,"}]}],"id":"blk-31161","kind":"list-item"},{"blocks":[{"id":"blk-31164","kind":"paragraph","spans":[{"id":"spn-34634","text":"low latency,"}]}],"id":"blk-31163","kind":"list-item"},{"blocks":[{"id":"blk-31166","kind":"paragraph","spans":[{"id":"spn-34635","text":"global availability,"}]}],"id":"blk-31165","kind":"list-item"},{"blocks":[{"id":"blk-31168","kind":"paragraph","spans":[{"id":"spn-34636","text":"simple developer experience."}]}],"id":"blk-31167","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31169","kind":"paragraph","spans":[{"id":"spn-34637","text":"2. "},{"id":"spn-34638","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-34639","text":" for premium customers and advanced workloads:"}]},{"id":"blk-31170","items":[{"blocks":[{"id":"blk-31172","kind":"paragraph","spans":[{"id":"spn-34640","text":"long-running sessions and tasks,"}]}],"id":"blk-31171","kind":"list-item"},{"blocks":[{"id":"blk-31174","kind":"paragraph","spans":[{"id":"spn-34641","text":"stronger isolation and security posture,"}]}],"id":"blk-31173","kind":"list-item"},{"blocks":[{"id":"blk-31176","kind":"paragraph","spans":[{"id":"spn-34642","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-31175","kind":"list-item"},{"blocks":[{"id":"blk-31178","kind":"paragraph","spans":[{"id":"spn-34643","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-31177","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31179","kind":"paragraph","spans":[{"id":"spn-34644","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-31180","kind":"paragraph","spans":[{"id":"spn-34645","text":"We also require:"}]},{"id":"blk-31181","items":[{"blocks":[{"id":"blk-31183","kind":"paragraph","spans":[{"id":"spn-34646","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-31182","kind":"list-item"},{"blocks":[{"id":"blk-31185","kind":"paragraph","spans":[{"id":"spn-34647","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-31184","kind":"list-item"},{"blocks":[{"id":"blk-31187","kind":"paragraph","spans":[{"id":"spn-34648","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-31186","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31188","kind":"heading","level":2,"spans":[{"id":"spn-34649","text":"Decision"}]},{"id":"blk-31189","kind":"paragraph","spans":[{"id":"spn-34650","text":"Adopt a "},{"id":"spn-34651","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-34652","text":" with a single "},{"id":"spn-34653","marks":["bold"],"text":"control plane"},{"id":"spn-34654","text":" and multiple "},{"id":"spn-34655","marks":["bold"],"text":"data plane"},{"id":"spn-34656","text":" runtime providers behind a shared "},{"id":"spn-34657","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-34658","text":"."}]},{"id":"blk-31190","kind":"heading","level":3,"spans":[{"id":"spn-34659","text":"Providers in v1"}]},{"id":"blk-31191","items":[{"blocks":[{"id":"blk-31193","kind":"paragraph","spans":[{"id":"spn-34660","marks":["bold"],"text":"Default runtime"},{"id":"spn-34661","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-34662","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-34663","text":")"}]}],"id":"blk-31192","kind":"list-item"},{"blocks":[{"id":"blk-31195","kind":"paragraph","spans":[{"id":"spn-34664","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-31194","kind":"list-item"},{"blocks":[{"id":"blk-31197","kind":"paragraph","spans":[{"id":"spn-34665","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-31196","kind":"list-item"},{"blocks":[{"id":"blk-31199","kind":"paragraph","spans":[{"id":"spn-34666","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-31198","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31200","items":[{"blocks":[{"id":"blk-31202","kind":"paragraph","spans":[{"id":"spn-34667","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-34668","text":": AWS Bedrock AgentCore ("},{"id":"spn-34669","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-34670","text":")"}]}],"id":"blk-31201","kind":"list-item"},{"blocks":[{"id":"blk-31204","kind":"paragraph","spans":[{"id":"spn-34671","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-31203","kind":"list-item"},{"blocks":[{"id":"blk-31206","kind":"paragraph","spans":[{"id":"spn-34672","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-31205","kind":"list-item"},{"blocks":[{"id":"blk-31208","kind":"paragraph","spans":[{"id":"spn-34673","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-34674","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-31207","kind":"list-item"},{"blocks":[{"id":"blk-31210","kind":"paragraph","spans":[{"id":"spn-34675","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-34676","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-31209","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31211","kind":"heading","level":3,"spans":[{"id":"spn-34677","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-31212","kind":"paragraph","spans":[{"id":"spn-34678","text":"webhost.systems is intended to be "},{"id":"spn-34679","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-34680","text":":"}]},{"id":"blk-31213","items":[{"blocks":[{"id":"blk-31215","kind":"paragraph","spans":[{"id":"spn-34681","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-31214","kind":"list-item"},{"blocks":[{"id":"blk-31217","kind":"paragraph","spans":[{"id":"spn-34682","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-31216","kind":"list-item"},{"blocks":[{"id":"blk-31219","kind":"paragraph","spans":[{"id":"spn-34683","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-31218","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31220","kind":"paragraph","spans":[{"id":"spn-34684","text":"This means "},{"id":"spn-34685","marks":["bold"],"text":"no Python requirement"},{"id":"spn-34686","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-31221","kind":"heading","level":3,"spans":[{"id":"spn-34687","text":"Control plane"}]},{"id":"blk-31222","items":[{"blocks":[{"id":"blk-31224","kind":"paragraph","spans":[{"id":"spn-34688","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-31223","kind":"list-item"},{"blocks":[{"id":"blk-31226","kind":"paragraph","spans":[{"id":"spn-34689","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-31225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31227","kind":"heading","level":3,"spans":[{"id":"spn-34690","text":"Contract"}]},{"id":"blk-31228","items":[{"blocks":[{"id":"blk-31230","kind":"paragraph","spans":[{"id":"spn-34691","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-34692","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-34693","text":", including:"}]}],"id":"blk-31229","kind":"list-item"},{"blocks":[{"id":"blk-31232","kind":"paragraph","spans":[{"id":"spn-34694","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-31231","kind":"list-item"},{"blocks":[{"id":"blk-31234","kind":"paragraph","spans":[{"id":"spn-34695","marks":["code"],"text":"invoke(...)"},{"id":"spn-34696","text":" (streaming optional but preferred)"}]}],"id":"blk-31233","kind":"list-item"},{"blocks":[{"id":"blk-31236","kind":"paragraph","spans":[{"id":"spn-34697","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-31235","kind":"list-item"},{"blocks":[{"id":"blk-31238","kind":"paragraph","spans":[{"id":"spn-34698","text":"normalized error mapping"}]}],"id":"blk-31237","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31239","kind":"heading","level":2,"spans":[{"id":"spn-34699","text":"Alternatives considered"}]},{"id":"blk-31240","kind":"heading","level":3,"spans":[{"id":"spn-34700","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-31241","kind":"paragraph","spans":[{"id":"spn-34701","marks":["bold"],"text":"Pros"}]},{"id":"blk-31242","items":[{"blocks":[{"id":"blk-31244","kind":"paragraph","spans":[{"id":"spn-34702","text":"Simplest operational model and implementation."}]}],"id":"blk-31243","kind":"list-item"},{"blocks":[{"id":"blk-31246","kind":"paragraph","spans":[{"id":"spn-34703","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-31245","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31247","kind":"paragraph","spans":[{"id":"spn-34704","marks":["bold"],"text":"Cons"}]},{"id":"blk-31248","items":[{"blocks":[{"id":"blk-31250","kind":"paragraph","spans":[{"id":"spn-34705","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-31249","kind":"list-item"},{"blocks":[{"id":"blk-31252","kind":"paragraph","spans":[{"id":"spn-34706","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-31251","kind":"list-item"},{"blocks":[{"id":"blk-31254","kind":"paragraph","spans":[{"id":"spn-34707","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-31253","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31255","kind":"paragraph","spans":[{"id":"spn-34708","marks":["bold"],"text":"Why rejected"},{"id":"spn-34709","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-31256","kind":"heading","level":3,"spans":[{"id":"spn-34710","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-31257","kind":"paragraph","spans":[{"id":"spn-34711","marks":["bold"],"text":"Pros"}]},{"id":"blk-31258","items":[{"blocks":[{"id":"blk-31260","kind":"paragraph","spans":[{"id":"spn-34712","text":"Strong enterprise posture and capability set."}]}],"id":"blk-31259","kind":"list-item"},{"blocks":[{"id":"blk-31262","kind":"paragraph","spans":[{"id":"spn-34713","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-31261","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31263","kind":"paragraph","spans":[{"id":"spn-34714","marks":["bold"],"text":"Cons"}]},{"id":"blk-31264","items":[{"blocks":[{"id":"blk-31266","kind":"paragraph","spans":[{"id":"spn-34715","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-31265","kind":"list-item"},{"blocks":[{"id":"blk-31268","kind":"paragraph","spans":[{"id":"spn-34716","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-31267","kind":"list-item"},{"blocks":[{"id":"blk-31270","kind":"paragraph","spans":[{"id":"spn-34717","text":"Increased vendor lock-in risk."}]}],"id":"blk-31269","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31271","kind":"paragraph","spans":[{"id":"spn-34718","marks":["bold"],"text":"Why rejected"},{"id":"spn-34719","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-31272","kind":"heading","level":3,"spans":[{"id":"spn-34720","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-31273","kind":"paragraph","spans":[{"id":"spn-34721","marks":["bold"],"text":"Pros"}]},{"id":"blk-31274","items":[{"blocks":[{"id":"blk-31276","kind":"paragraph","spans":[{"id":"spn-34722","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-31275","kind":"list-item"},{"blocks":[{"id":"blk-31278","kind":"paragraph","spans":[{"id":"spn-34723","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-31277","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31279","kind":"paragraph","spans":[{"id":"spn-34724","marks":["bold"],"text":"Cons"}]},{"id":"blk-31280","items":[{"blocks":[{"id":"blk-31282","kind":"paragraph","spans":[{"id":"spn-34725","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-31281","kind":"list-item"},{"blocks":[{"id":"blk-31284","kind":"paragraph","spans":[{"id":"spn-34726","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-31283","kind":"list-item"},{"blocks":[{"id":"blk-31286","kind":"paragraph","spans":[{"id":"spn-34727","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-31285","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31287","kind":"paragraph","spans":[{"id":"spn-34728","marks":["bold"],"text":"Why rejected"},{"id":"spn-34729","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-31288","kind":"heading","level":3,"spans":[{"id":"spn-34730","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-31289","kind":"paragraph","spans":[{"id":"spn-34731","marks":["bold"],"text":"Pros"}]},{"id":"blk-31290","items":[{"blocks":[{"id":"blk-31292","kind":"paragraph","spans":[{"id":"spn-34732","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-31291","kind":"list-item"},{"blocks":[{"id":"blk-31294","kind":"paragraph","spans":[{"id":"spn-34733","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-31293","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31295","kind":"paragraph","spans":[{"id":"spn-34734","marks":["bold"],"text":"Cons"}]},{"id":"blk-31296","items":[{"blocks":[{"id":"blk-31298","kind":"paragraph","spans":[{"id":"spn-34735","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-31297","kind":"list-item"},{"blocks":[{"id":"blk-31300","kind":"paragraph","spans":[{"id":"spn-34736","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-31299","kind":"list-item"},{"blocks":[{"id":"blk-31302","kind":"paragraph","spans":[{"id":"spn-34737","text":"Slower time-to-market."}]}],"id":"blk-31301","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31303","kind":"paragraph","spans":[{"id":"spn-34738","marks":["bold"],"text":"Why rejected"},{"id":"spn-34739","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-31304","kind":"heading","level":2,"spans":[{"id":"spn-34740","text":"Consequences"}]},{"id":"blk-31305","kind":"heading","level":3,"spans":[{"id":"spn-34741","text":"Positive"}]},{"id":"blk-31306","items":[{"blocks":[{"id":"blk-31308","kind":"paragraph","spans":[{"id":"spn-34742","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-34743","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-31307","kind":"list-item"},{"blocks":[{"id":"blk-31310","kind":"paragraph","spans":[{"id":"spn-34744","marks":["bold"],"text":"Product flexibility"},{"id":"spn-34745","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-31309","kind":"list-item"},{"blocks":[{"id":"blk-31312","kind":"paragraph","spans":[{"id":"spn-34746","marks":["bold"],"text":"Risk reduction"},{"id":"spn-34747","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-31311","kind":"list-item"},{"blocks":[{"id":"blk-31314","kind":"paragraph","spans":[{"id":"spn-34748","marks":["bold"],"text":"Future extensibility"},{"id":"spn-34749","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-31313","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31315","kind":"heading","level":3,"spans":[{"id":"spn-34750","text":"Negative / costs"}]},{"id":"blk-31316","items":[{"blocks":[{"id":"blk-31318","kind":"paragraph","spans":[{"id":"spn-34751","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-34752","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-31317","kind":"list-item"},{"blocks":[{"id":"blk-31320","kind":"paragraph","spans":[{"id":"spn-34753","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-34754","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-31319","kind":"list-item"},{"blocks":[{"id":"blk-31322","kind":"paragraph","spans":[{"id":"spn-34755","marks":["bold"],"text":"Operational surface area"},{"id":"spn-34756","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-31321","kind":"list-item"},{"blocks":[{"id":"blk-31324","kind":"paragraph","spans":[{"id":"spn-34757","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-34758","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-31323","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31325","kind":"heading","level":2,"spans":[{"id":"spn-34759","text":"Implementation details (normative requirements)"}]},{"id":"blk-31326","kind":"paragraph","spans":[{"id":"spn-34760","text":"1. "},{"id":"spn-34761","marks":["bold"],"text":"RPI is mandatory"}]},{"id":"blk-31327","items":[{"blocks":[{"id":"blk-31329","kind":"paragraph","spans":[{"id":"spn-34762","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-31328","kind":"list-item"},{"blocks":[{"id":"blk-31331","kind":"paragraph","spans":[{"id":"spn-34763","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-31330","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31332","kind":"paragraph","spans":[{"id":"spn-34764","text":"2. "},{"id":"spn-34765","marks":["bold"],"text":"Invocation protocol is consistent"}]},{"id":"blk-31333","items":[{"blocks":[{"id":"blk-31335","kind":"paragraph","spans":[{"id":"spn-34766","text":"The canonical request/response shapes are defined in "},{"id":"spn-34767","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-34768","text":" and "},{"id":"spn-34769","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-34770","text":"."}]}],"id":"blk-31334","kind":"list-item"},{"blocks":[{"id":"blk-31337","kind":"paragraph","spans":[{"id":"spn-34771","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-31336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31338","kind":"paragraph","spans":[{"id":"spn-34772","text":"3. "},{"id":"spn-34773","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]},{"id":"blk-31339","items":[{"blocks":[{"id":"blk-31341","kind":"paragraph","spans":[{"id":"spn-34774","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-34775","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-34776","text":"."}]}],"id":"blk-31340","kind":"list-item"},{"blocks":[{"id":"blk-31343","kind":"paragraph","spans":[{"id":"spn-34777","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-31342","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31344","kind":"paragraph","spans":[{"id":"spn-34778","text":"4. "},{"id":"spn-34779","marks":["bold"],"text":"Tier gating"}]},{"id":"blk-31345","items":[{"blocks":[{"id":"blk-31347","kind":"paragraph","spans":[{"id":"spn-34780","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-31346","kind":"list-item"},{"blocks":[{"id":"blk-31349","kind":"paragraph","spans":[{"id":"spn-34781","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-31348","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31350","kind":"paragraph","spans":[{"id":"spn-34782","text":"5. "},{"id":"spn-34783","marks":["bold"],"text":"Secrets handling"}]},{"id":"blk-31351","items":[{"blocks":[{"id":"blk-31353","kind":"paragraph","spans":[{"id":"spn-34784","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-31352","kind":"list-item"},{"blocks":[{"id":"blk-31355","kind":"paragraph","spans":[{"id":"spn-34785","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id":"blk-31354","kind":"list-item"},{"blocks":[{"id":"blk-31357","kind":"paragraph","spans":[{"id":"spn-34786","text":"Telemetry signing secrets are deployment-scoped and injected into the data plane."}]}],"id":"blk-31356","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31358","kind":"paragraph","spans":[{"id":"spn-34787","text":"6. "},{"id":"spn-34788","marks":["bold"],"text":"Resource tagging"}]},{"id":"blk-31359","items":[{"blocks":[{"id":"blk-31361","kind":"paragraph","spans":[{"id":"spn-34789","text":"Provider resources should be tagged/labeled with "},{"id":"spn-34790","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-34791","text":" to support cleanup and future billing reconciliation."}]}],"id":"blk-31360","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31362","kind":"heading","level":2,"spans":[{"id":"spn-34792","text":"Operational considerations"}]},{"id":"blk-31363","items":[{"blocks":[{"id":"blk-31365","kind":"paragraph","spans":[{"id":"spn-34793","text":"Track per-provider health and error rates independently."}]}],"id":"blk-31364","kind":"list-item"},{"blocks":[{"id":"blk-31367","kind":"paragraph","spans":[{"id":"spn-34794","text":"Implement provider-specific circuit breakers if needed (post-v1)."}]}],"id":"blk-31366","kind":"list-item"},{"blocks":[{"id":"blk-31369","kind":"paragraph","spans":[{"id":"spn-34795","text":"Ensure staging environments exist for both providers with separate credentials and billing/webhook settings."}]}],"id":"blk-31368","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31370","kind":"heading","level":2,"spans":[{"id":"spn-34796","text":"Success criteria"}]},{"id":"blk-31371","kind":"paragraph","spans":[{"id":"spn-34797","text":"This decision is successful if:"}]},{"id":"blk-31372","items":[{"blocks":[{"id":"blk-31374","kind":"paragraph","spans":[{"id":"spn-34798","text":"Cloudflare deploy/invoke works end-to-end with telemetry and limit enforcement."}]}],"id":"blk-31373","kind":"list-item"},{"blocks":[{"id":"blk-31376","kind":"paragraph","spans":[{"id":"spn-34799","text":"AgentCore deploy/invoke works end-to-end for entitled users with telemetry and limit enforcement."}]}],"id":"blk-31375","kind":"list-item"},{"blocks":[{"id":"blk-31378","kind":"paragraph","spans":[{"id":"spn-34800","text":"Control plane routing remains provider-agnostic and uses only the RPI."}]}],"id":"blk-31377","kind":"list-item"},{"blocks":[{"id":"blk-31380","kind":"paragraph","spans":[{"id":"spn-34801","text":"Adding a new provider would require implementing a new adapter without major changes to the control plane schemas and APIs."}]}],"id":"blk-31379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31381","kind":"heading","level":2,"spans":[{"id":"spn-34802","text":"Follow-ups / next ADRs"}]},{"id":"blk-31382","items":[{"blocks":[{"id":"blk-31384","kind":"paragraph","spans":[{"id":"spn-34803","text":"ADR-0002: Control plane backend choice (Supabase; supersedes original Convex choice)."}]}],"id":"blk-31383","kind":"list-item"},{"blocks":[{"id":"blk-31386","kind":"paragraph","spans":[{"id":"spn-34804","text":"ADR-0003: Secrets strategy (no plaintext in DB; provider injection)."}]}],"id":"blk-31385","kind":"list-item"},{"blocks":[{"id":"blk-31388","kind":"paragraph","spans":[{"id":"spn-34805","text":"ADR-0004: Telemetry integrity model (deployment-scoped signing) and ingestion validation."}]}],"id":"blk-31387","kind":"list-item"},{"blocks":[{"id":"blk-31390","kind":"paragraph","spans":[{"id":"spn-34806","text":"ADR-0005: Deployment immutability + active pointer model."}]}],"id":"blk-31389","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierapnqdxgus2khharsdstwlonwhhvaqn7e4rhssjqskdwxfndsmle2q","vocabulary":"ampersand.docs.fs.v1"}