{"bendscript":"0.1","blocks":[{"id":"blk-51035","kind":"heading","level":1,"spans":[{"id":"spn-79676","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-51036","kind":"paragraph","spans":[{"id":"spn-79677","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-51037","items":[{"blocks":[{"id":"blk-51039","kind":"paragraph","spans":[{"id":"spn-79678","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-51038","kind":"list-item"},{"blocks":[{"id":"blk-51041","kind":"paragraph","spans":[{"id":"spn-79679","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-51040","kind":"list-item"},{"blocks":[{"id":"blk-51043","kind":"paragraph","spans":[{"id":"spn-79680","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-51042","kind":"list-item"},{"blocks":[{"id":"blk-51045","kind":"paragraph","spans":[{"id":"spn-79681","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-51044","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51046","kind":"heading","level":2,"spans":[{"id":"spn-79682","text":"Context"}]},{"id":"blk-51047","kind":"paragraph","spans":[{"id":"spn-79683","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-51048","items":[{"blocks":[{"id":"blk-51050","kind":"paragraph","spans":[{"id":"spn-79684","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-79685","text":" for the majority of users:"}]}],"id":"blk-51049","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51051","items":[{"blocks":[{"id":"blk-51053","kind":"paragraph","spans":[{"id":"spn-79686","text":"low marginal cost for invocations,"}]}],"id":"blk-51052","kind":"list-item"},{"blocks":[{"id":"blk-51055","kind":"paragraph","spans":[{"id":"spn-79687","text":"low latency,"}]}],"id":"blk-51054","kind":"list-item"},{"blocks":[{"id":"blk-51057","kind":"paragraph","spans":[{"id":"spn-79688","text":"global availability,"}]}],"id":"blk-51056","kind":"list-item"},{"blocks":[{"id":"blk-51059","kind":"paragraph","spans":[{"id":"spn-79689","text":"simple developer experience."}]}],"id":"blk-51058","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51060","items":[{"blocks":[{"id":"blk-51062","kind":"paragraph","spans":[{"id":"spn-79690","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-79691","text":" for premium customers and advanced workloads:"}]}],"id":"blk-51061","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-51063","items":[{"blocks":[{"id":"blk-51065","kind":"paragraph","spans":[{"id":"spn-79692","text":"long-running sessions and tasks,"}]}],"id":"blk-51064","kind":"list-item"},{"blocks":[{"id":"blk-51067","kind":"paragraph","spans":[{"id":"spn-79693","text":"stronger isolation and security posture,"}]}],"id":"blk-51066","kind":"list-item"},{"blocks":[{"id":"blk-51069","kind":"paragraph","spans":[{"id":"spn-79694","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-51068","kind":"list-item"},{"blocks":[{"id":"blk-51071","kind":"paragraph","spans":[{"id":"spn-79695","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-51070","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51072","kind":"paragraph","spans":[{"id":"spn-79696","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-51073","kind":"paragraph","spans":[{"id":"spn-79697","text":"We also require:"}]},{"id":"blk-51074","items":[{"blocks":[{"id":"blk-51076","kind":"paragraph","spans":[{"id":"spn-79698","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-51075","kind":"list-item"},{"blocks":[{"id":"blk-51078","kind":"paragraph","spans":[{"id":"spn-79699","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-51077","kind":"list-item"},{"blocks":[{"id":"blk-51080","kind":"paragraph","spans":[{"id":"spn-79700","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-51079","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51081","kind":"heading","level":2,"spans":[{"id":"spn-79701","text":"Decision"}]},{"id":"blk-51082","kind":"paragraph","spans":[{"id":"spn-79702","text":"Adopt a "},{"id":"spn-79703","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-79704","text":" with a single "},{"id":"spn-79705","marks":["bold"],"text":"control plane"},{"id":"spn-79706","text":" and multiple "},{"id":"spn-79707","marks":["bold"],"text":"data plane"},{"id":"spn-79708","text":" runtime providers behind a shared "},{"id":"spn-79709","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-79710","text":"."}]},{"id":"blk-51083","kind":"heading","level":3,"spans":[{"id":"spn-79711","text":"Providers in v1"}]},{"id":"blk-51084","items":[{"blocks":[{"id":"blk-51086","kind":"paragraph","spans":[{"id":"spn-79712","marks":["bold"],"text":"Default runtime"},{"id":"spn-79713","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-79714","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-79715","text":")"}]}],"id":"blk-51085","kind":"list-item"},{"blocks":[{"id":"blk-51088","kind":"paragraph","spans":[{"id":"spn-79716","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-51087","kind":"list-item"},{"blocks":[{"id":"blk-51090","kind":"paragraph","spans":[{"id":"spn-79717","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-51089","kind":"list-item"},{"blocks":[{"id":"blk-51092","kind":"paragraph","spans":[{"id":"spn-79718","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-51091","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51093","items":[{"blocks":[{"id":"blk-51095","kind":"paragraph","spans":[{"id":"spn-79719","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-79720","text":": AWS Bedrock AgentCore ("},{"id":"spn-79721","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-79722","text":")"}]}],"id":"blk-51094","kind":"list-item"},{"blocks":[{"id":"blk-51097","kind":"paragraph","spans":[{"id":"spn-79723","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-51096","kind":"list-item"},{"blocks":[{"id":"blk-51099","kind":"paragraph","spans":[{"id":"spn-79724","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-51098","kind":"list-item"},{"blocks":[{"id":"blk-51101","kind":"paragraph","spans":[{"id":"spn-79725","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-79726","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-51100","kind":"list-item"},{"blocks":[{"id":"blk-51103","kind":"paragraph","spans":[{"id":"spn-79727","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-79728","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-51102","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51104","kind":"heading","level":3,"spans":[{"id":"spn-79729","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-51105","kind":"paragraph","spans":[{"id":"spn-79730","text":"webhost.systems is intended to be "},{"id":"spn-79731","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-79732","text":":"}]},{"id":"blk-51106","items":[{"blocks":[{"id":"blk-51108","kind":"paragraph","spans":[{"id":"spn-79733","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-51107","kind":"list-item"},{"blocks":[{"id":"blk-51110","kind":"paragraph","spans":[{"id":"spn-79734","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-51109","kind":"list-item"},{"blocks":[{"id":"blk-51112","kind":"paragraph","spans":[{"id":"spn-79735","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-51111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51113","kind":"paragraph","spans":[{"id":"spn-79736","text":"This means "},{"id":"spn-79737","marks":["bold"],"text":"no Python requirement"},{"id":"spn-79738","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-51114","kind":"heading","level":3,"spans":[{"id":"spn-79739","text":"Control plane"}]},{"id":"blk-51115","items":[{"blocks":[{"id":"blk-51117","kind":"paragraph","spans":[{"id":"spn-79740","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-51116","kind":"list-item"},{"blocks":[{"id":"blk-51119","kind":"paragraph","spans":[{"id":"spn-79741","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-51118","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51120","kind":"heading","level":3,"spans":[{"id":"spn-79742","text":"Contract"}]},{"id":"blk-51121","items":[{"blocks":[{"id":"blk-51123","kind":"paragraph","spans":[{"id":"spn-79743","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-79744","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-79745","text":", including:"}]}],"id":"blk-51122","kind":"list-item"},{"blocks":[{"id":"blk-51125","kind":"paragraph","spans":[{"id":"spn-79746","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-51124","kind":"list-item"},{"blocks":[{"id":"blk-51127","kind":"paragraph","spans":[{"id":"spn-79747","marks":["code"],"text":"invoke(...)"},{"id":"spn-79748","text":" (streaming optional but preferred)"}]}],"id":"blk-51126","kind":"list-item"},{"blocks":[{"id":"blk-51129","kind":"paragraph","spans":[{"id":"spn-79749","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-51128","kind":"list-item"},{"blocks":[{"id":"blk-51131","kind":"paragraph","spans":[{"id":"spn-79750","text":"normalized error mapping"}]}],"id":"blk-51130","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51132","kind":"heading","level":2,"spans":[{"id":"spn-79751","text":"Alternatives considered"}]},{"id":"blk-51133","kind":"heading","level":3,"spans":[{"id":"spn-79752","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-51134","kind":"paragraph","spans":[{"id":"spn-79753","marks":["bold"],"text":"Pros"}]},{"id":"blk-51135","items":[{"blocks":[{"id":"blk-51137","kind":"paragraph","spans":[{"id":"spn-79754","text":"Simplest operational model and implementation."}]}],"id":"blk-51136","kind":"list-item"},{"blocks":[{"id":"blk-51139","kind":"paragraph","spans":[{"id":"spn-79755","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-51138","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51140","kind":"paragraph","spans":[{"id":"spn-79756","marks":["bold"],"text":"Cons"}]},{"id":"blk-51141","items":[{"blocks":[{"id":"blk-51143","kind":"paragraph","spans":[{"id":"spn-79757","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-51142","kind":"list-item"},{"blocks":[{"id":"blk-51145","kind":"paragraph","spans":[{"id":"spn-79758","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-51144","kind":"list-item"},{"blocks":[{"id":"blk-51147","kind":"paragraph","spans":[{"id":"spn-79759","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-51146","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51148","kind":"paragraph","spans":[{"id":"spn-79760","marks":["bold"],"text":"Why rejected"},{"id":"spn-79761","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-51149","kind":"heading","level":3,"spans":[{"id":"spn-79762","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-51150","kind":"paragraph","spans":[{"id":"spn-79763","marks":["bold"],"text":"Pros"}]},{"id":"blk-51151","items":[{"blocks":[{"id":"blk-51153","kind":"paragraph","spans":[{"id":"spn-79764","text":"Strong enterprise posture and capability set."}]}],"id":"blk-51152","kind":"list-item"},{"blocks":[{"id":"blk-51155","kind":"paragraph","spans":[{"id":"spn-79765","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-51154","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51156","kind":"paragraph","spans":[{"id":"spn-79766","marks":["bold"],"text":"Cons"}]},{"id":"blk-51157","items":[{"blocks":[{"id":"blk-51159","kind":"paragraph","spans":[{"id":"spn-79767","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-51158","kind":"list-item"},{"blocks":[{"id":"blk-51161","kind":"paragraph","spans":[{"id":"spn-79768","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-51160","kind":"list-item"},{"blocks":[{"id":"blk-51163","kind":"paragraph","spans":[{"id":"spn-79769","text":"Increased vendor lock-in risk."}]}],"id":"blk-51162","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51164","kind":"paragraph","spans":[{"id":"spn-79770","marks":["bold"],"text":"Why rejected"},{"id":"spn-79771","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-51165","kind":"heading","level":3,"spans":[{"id":"spn-79772","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-51166","kind":"paragraph","spans":[{"id":"spn-79773","marks":["bold"],"text":"Pros"}]},{"id":"blk-51167","items":[{"blocks":[{"id":"blk-51169","kind":"paragraph","spans":[{"id":"spn-79774","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-51168","kind":"list-item"},{"blocks":[{"id":"blk-51171","kind":"paragraph","spans":[{"id":"spn-79775","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-51170","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51172","kind":"paragraph","spans":[{"id":"spn-79776","marks":["bold"],"text":"Cons"}]},{"id":"blk-51173","items":[{"blocks":[{"id":"blk-51175","kind":"paragraph","spans":[{"id":"spn-79777","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-51174","kind":"list-item"},{"blocks":[{"id":"blk-51177","kind":"paragraph","spans":[{"id":"spn-79778","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-51176","kind":"list-item"},{"blocks":[{"id":"blk-51179","kind":"paragraph","spans":[{"id":"spn-79779","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-51178","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51180","kind":"paragraph","spans":[{"id":"spn-79780","marks":["bold"],"text":"Why rejected"},{"id":"spn-79781","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-51181","kind":"heading","level":3,"spans":[{"id":"spn-79782","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-51182","kind":"paragraph","spans":[{"id":"spn-79783","marks":["bold"],"text":"Pros"}]},{"id":"blk-51183","items":[{"blocks":[{"id":"blk-51185","kind":"paragraph","spans":[{"id":"spn-79784","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-51184","kind":"list-item"},{"blocks":[{"id":"blk-51187","kind":"paragraph","spans":[{"id":"spn-79785","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-51186","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51188","kind":"paragraph","spans":[{"id":"spn-79786","marks":["bold"],"text":"Cons"}]},{"id":"blk-51189","items":[{"blocks":[{"id":"blk-51191","kind":"paragraph","spans":[{"id":"spn-79787","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-51190","kind":"list-item"},{"blocks":[{"id":"blk-51193","kind":"paragraph","spans":[{"id":"spn-79788","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-51192","kind":"list-item"},{"blocks":[{"id":"blk-51195","kind":"paragraph","spans":[{"id":"spn-79789","text":"Slower time-to-market."}]}],"id":"blk-51194","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51196","kind":"paragraph","spans":[{"id":"spn-79790","marks":["bold"],"text":"Why rejected"},{"id":"spn-79791","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-51197","kind":"heading","level":2,"spans":[{"id":"spn-79792","text":"Consequences"}]},{"id":"blk-51198","kind":"heading","level":3,"spans":[{"id":"spn-79793","text":"Positive"}]},{"id":"blk-51199","items":[{"blocks":[{"id":"blk-51201","kind":"paragraph","spans":[{"id":"spn-79794","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-79795","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-51200","kind":"list-item"},{"blocks":[{"id":"blk-51203","kind":"paragraph","spans":[{"id":"spn-79796","marks":["bold"],"text":"Product flexibility"},{"id":"spn-79797","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-51202","kind":"list-item"},{"blocks":[{"id":"blk-51205","kind":"paragraph","spans":[{"id":"spn-79798","marks":["bold"],"text":"Risk reduction"},{"id":"spn-79799","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-51204","kind":"list-item"},{"blocks":[{"id":"blk-51207","kind":"paragraph","spans":[{"id":"spn-79800","marks":["bold"],"text":"Future extensibility"},{"id":"spn-79801","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-51206","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51208","kind":"heading","level":3,"spans":[{"id":"spn-79802","text":"Negative / costs"}]},{"id":"blk-51209","items":[{"blocks":[{"id":"blk-51211","kind":"paragraph","spans":[{"id":"spn-79803","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-79804","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-51210","kind":"list-item"},{"blocks":[{"id":"blk-51213","kind":"paragraph","spans":[{"id":"spn-79805","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-79806","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-51212","kind":"list-item"},{"blocks":[{"id":"blk-51215","kind":"paragraph","spans":[{"id":"spn-79807","marks":["bold"],"text":"Operational surface area"},{"id":"spn-79808","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-51214","kind":"list-item"},{"blocks":[{"id":"blk-51217","kind":"paragraph","spans":[{"id":"spn-79809","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-79810","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-51216","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51218","kind":"heading","level":2,"spans":[{"id":"spn-79811","text":"Implementation details (normative requirements)"}]},{"id":"blk-51219","items":[{"blocks":[{"id":"blk-51221","kind":"paragraph","spans":[{"id":"spn-79812","marks":["bold"],"text":"RPI is mandatory"}]}],"id":"blk-51220","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-51222","items":[{"blocks":[{"id":"blk-51224","kind":"paragraph","spans":[{"id":"spn-79813","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-51223","kind":"list-item"},{"blocks":[{"id":"blk-51226","kind":"paragraph","spans":[{"id":"spn-79814","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-51225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51227","items":[{"blocks":[{"id":"blk-51229","kind":"paragraph","spans":[{"id":"spn-79815","marks":["bold"],"text":"Invocation protocol is consistent"}]}],"id":"blk-51228","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-51230","items":[{"blocks":[{"id":"blk-51232","kind":"paragraph","spans":[{"id":"spn-79816","text":"The canonical request/response shapes are defined in "},{"id":"spn-79817","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-79818","text":" and "},{"id":"spn-79819","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-79820","text":"."}]}],"id":"blk-51231","kind":"list-item"},{"blocks":[{"id":"blk-51234","kind":"paragraph","spans":[{"id":"spn-79821","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-51233","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51235","items":[{"blocks":[{"id":"blk-51237","kind":"paragraph","spans":[{"id":"spn-79822","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]}],"id":"blk-51236","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-51238","items":[{"blocks":[{"id":"blk-51240","kind":"paragraph","spans":[{"id":"spn-79823","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-79824","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-79825","text":"."}]}],"id":"blk-51239","kind":"list-item"},{"blocks":[{"id":"blk-51242","kind":"paragraph","spans":[{"id":"spn-79826","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-51241","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51243","items":[{"blocks":[{"id":"blk-51245","kind":"paragraph","spans":[{"id":"spn-79827","marks":["bold"],"text":"Tier gating"}]}],"id":"blk-51244","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-51246","items":[{"blocks":[{"id":"blk-51248","kind":"paragraph","spans":[{"id":"spn-79828","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-51247","kind":"list-item"},{"blocks":[{"id":"blk-51250","kind":"paragraph","spans":[{"id":"spn-79829","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-51249","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-51251","items":[{"blocks":[{"id":"blk-51253","kind":"paragraph","spans":[{"id":"spn-79830","marks":["bold"],"text":"Secrets handling"}]}],"id":"blk-51252","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-51254","items":[{"blocks":[{"id":"blk-51256","kind":"paragraph","spans":[{"id":"spn-79831","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-51255","kind":"list-item"},{"blocks":[{"id":"blk-51258","kind":"paragraph","spans":[{"id":"spn-79832","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id":"blk-51257","kind":"list-item"},{"blocks":[{"id":"blk-51260","kind":"paragraph","spans":[{"id":"spn-79833","text":"Telemetry signing secrets are deployment-