{"bendscript":"0.1","blocks":[{"id":"blk-50319","kind":"heading","level":1,"spans":[{"id":"spn-77308","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-50320","kind":"paragraph","spans":[{"id":"spn-77309","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-50321","items":[{"blocks":[{"id":"blk-50323","kind":"paragraph","spans":[{"id":"spn-77310","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-50322","kind":"list-item"},{"blocks":[{"id":"blk-50325","kind":"paragraph","spans":[{"id":"spn-77311","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-50324","kind":"list-item"},{"blocks":[{"id":"blk-50327","kind":"paragraph","spans":[{"id":"spn-77312","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-50326","kind":"list-item"},{"blocks":[{"id":"blk-50329","kind":"paragraph","spans":[{"id":"spn-77313","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-50328","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50330","kind":"heading","level":2,"spans":[{"id":"spn-77314","text":"Context"}]},{"id":"blk-50331","kind":"paragraph","spans":[{"id":"spn-77315","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-50332","items":[{"blocks":[{"id":"blk-50334","kind":"paragraph","spans":[{"id":"spn-77316","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-77317","text":" for the majority of users:"}]}],"id":"blk-50333","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-50335","items":[{"blocks":[{"id":"blk-50337","kind":"paragraph","spans":[{"id":"spn-77318","text":"low marginal cost for invocations,"}]}],"id":"blk-50336","kind":"list-item"},{"blocks":[{"id":"blk-50339","kind":"paragraph","spans":[{"id":"spn-77319","text":"low latency,"}]}],"id":"blk-50338","kind":"list-item"},{"blocks":[{"id":"blk-50341","kind":"paragraph","spans":[{"id":"spn-77320","text":"global availability,"}]}],"id":"blk-50340","kind":"list-item"},{"blocks":[{"id":"blk-50343","kind":"paragraph","spans":[{"id":"spn-77321","text":"simple developer experience."}]}],"id":"blk-50342","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50344","items":[{"blocks":[{"id":"blk-50346","kind":"paragraph","spans":[{"id":"spn-77322","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-77323","text":" for premium customers and advanced workloads:"}]}],"id":"blk-50345","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-50347","items":[{"blocks":[{"id":"blk-50349","kind":"paragraph","spans":[{"id":"spn-77324","text":"long-running sessions and tasks,"}]}],"id":"blk-50348","kind":"list-item"},{"blocks":[{"id":"blk-50351","kind":"paragraph","spans":[{"id":"spn-77325","text":"stronger isolation and security posture,"}]}],"id":"blk-50350","kind":"list-item"},{"blocks":[{"id":"blk-50353","kind":"paragraph","spans":[{"id":"spn-77326","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-50352","kind":"list-item"},{"blocks":[{"id":"blk-50355","kind":"paragraph","spans":[{"id":"spn-77327","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-50354","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50356","kind":"paragraph","spans":[{"id":"spn-77328","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-50357","kind":"paragraph","spans":[{"id":"spn-77329","text":"We also require:"}]},{"id":"blk-50358","items":[{"blocks":[{"id":"blk-50360","kind":"paragraph","spans":[{"id":"spn-77330","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-50359","kind":"list-item"},{"blocks":[{"id":"blk-50362","kind":"paragraph","spans":[{"id":"spn-77331","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-50361","kind":"list-item"},{"blocks":[{"id":"blk-50364","kind":"paragraph","spans":[{"id":"spn-77332","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-50363","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50365","kind":"heading","level":2,"spans":[{"id":"spn-77333","text":"Decision"}]},{"id":"blk-50366","kind":"paragraph","spans":[{"id":"spn-77334","text":"Adopt a "},{"id":"spn-77335","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-77336","text":" with a single "},{"id":"spn-77337","marks":["bold"],"text":"control plane"},{"id":"spn-77338","text":" and multiple "},{"id":"spn-77339","marks":["bold"],"text":"data plane"},{"id":"spn-77340","text":" runtime providers behind a shared "},{"id":"spn-77341","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-77342","text":"."}]},{"id":"blk-50367","kind":"heading","level":3,"spans":[{"id":"spn-77343","text":"Providers in v1"}]},{"id":"blk-50368","items":[{"blocks":[{"id":"blk-50370","kind":"paragraph","spans":[{"id":"spn-77344","marks":["bold"],"text":"Default runtime"},{"id":"spn-77345","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-77346","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-77347","text":")"}]}],"id":"blk-50369","kind":"list-item"},{"blocks":[{"id":"blk-50372","kind":"paragraph","spans":[{"id":"spn-77348","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-50371","kind":"list-item"},{"blocks":[{"id":"blk-50374","kind":"paragraph","spans":[{"id":"spn-77349","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-50373","kind":"list-item"},{"blocks":[{"id":"blk-50376","kind":"paragraph","spans":[{"id":"spn-77350","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-50375","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50377","items":[{"blocks":[{"id":"blk-50379","kind":"paragraph","spans":[{"id":"spn-77351","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-77352","text":": AWS Bedrock AgentCore ("},{"id":"spn-77353","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-77354","text":")"}]}],"id":"blk-50378","kind":"list-item"},{"blocks":[{"id":"blk-50381","kind":"paragraph","spans":[{"id":"spn-77355","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-50380","kind":"list-item"},{"blocks":[{"id":"blk-50383","kind":"paragraph","spans":[{"id":"spn-77356","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-50382","kind":"list-item"},{"blocks":[{"id":"blk-50385","kind":"paragraph","spans":[{"id":"spn-77357","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-77358","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-50384","kind":"list-item"},{"blocks":[{"id":"blk-50387","kind":"paragraph","spans":[{"id":"spn-77359","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-77360","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-50386","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50388","kind":"heading","level":3,"spans":[{"id":"spn-77361","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-50389","kind":"paragraph","spans":[{"id":"spn-77362","text":"webhost.systems is intended to be "},{"id":"spn-77363","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-77364","text":":"}]},{"id":"blk-50390","items":[{"blocks":[{"id":"blk-50392","kind":"paragraph","spans":[{"id":"spn-77365","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-50391","kind":"list-item"},{"blocks":[{"id":"blk-50394","kind":"paragraph","spans":[{"id":"spn-77366","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-50393","kind":"list-item"},{"blocks":[{"id":"blk-50396","kind":"paragraph","spans":[{"id":"spn-77367","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-50395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50397","kind":"paragraph","spans":[{"id":"spn-77368","text":"This means "},{"id":"spn-77369","marks":["bold"],"text":"no Python requirement"},{"id":"spn-77370","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-50398","kind":"heading","level":3,"spans":[{"id":"spn-77371","text":"Control plane"}]},{"id":"blk-50399","items":[{"blocks":[{"id":"blk-50401","kind":"paragraph","spans":[{"id":"spn-77372","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-50400","kind":"list-item"},{"blocks":[{"id":"blk-50403","kind":"paragraph","spans":[{"id":"spn-77373","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-50402","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50404","kind":"heading","level":3,"spans":[{"id":"spn-77374","text":"Contract"}]},{"id":"blk-50405","items":[{"blocks":[{"id":"blk-50407","kind":"paragraph","spans":[{"id":"spn-77375","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-77376","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-77377","text":", including:"}]}],"id":"blk-50406","kind":"list-item"},{"blocks":[{"id":"blk-50409","kind":"paragraph","spans":[{"id":"spn-77378","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-50408","kind":"list-item"},{"blocks":[{"id":"blk-50411","kind":"paragraph","spans":[{"id":"spn-77379","marks":["code"],"text":"invoke(...)"},{"id":"spn-77380","text":" (streaming optional but preferred)"}]}],"id":"blk-50410","kind":"list-item"},{"blocks":[{"id":"blk-50413","kind":"paragraph","spans":[{"id":"spn-77381","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-50412","kind":"list-item"},{"blocks":[{"id":"blk-50415","kind":"paragraph","spans":[{"id":"spn-77382","text":"normalized error mapping"}]}],"id":"blk-50414","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50416","kind":"heading","level":2,"spans":[{"id":"spn-77383","text":"Alternatives considered"}]},{"id":"blk-50417","kind":"heading","level":3,"spans":[{"id":"spn-77384","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-50418","kind":"paragraph","spans":[{"id":"spn-77385","marks":["bold"],"text":"Pros"}]},{"id":"blk-50419","items":[{"blocks":[{"id":"blk-50421","kind":"paragraph","spans":[{"id":"spn-77386","text":"Simplest operational model and implementation."}]}],"id":"blk-50420","kind":"list-item"},{"blocks":[{"id":"blk-50423","kind":"paragraph","spans":[{"id":"spn-77387","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-50422","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50424","kind":"paragraph","spans":[{"id":"spn-77388","marks":["bold"],"text":"Cons"}]},{"id":"blk-50425","items":[{"blocks":[{"id":"blk-50427","kind":"paragraph","spans":[{"id":"spn-77389","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-50426","kind":"list-item"},{"blocks":[{"id":"blk-50429","kind":"paragraph","spans":[{"id":"spn-77390","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-50428","kind":"list-item"},{"blocks":[{"id":"blk-50431","kind":"paragraph","spans":[{"id":"spn-77391","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-50430","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50432","kind":"paragraph","spans":[{"id":"spn-77392","marks":["bold"],"text":"Why rejected"},{"id":"spn-77393","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-50433","kind":"heading","level":3,"spans":[{"id":"spn-77394","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-50434","kind":"paragraph","spans":[{"id":"spn-77395","marks":["bold"],"text":"Pros"}]},{"id":"blk-50435","items":[{"blocks":[{"id":"blk-50437","kind":"paragraph","spans":[{"id":"spn-77396","text":"Strong enterprise posture and capability set."}]}],"id":"blk-50436","kind":"list-item"},{"blocks":[{"id":"blk-50439","kind":"paragraph","spans":[{"id":"spn-77397","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-50438","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50440","kind":"paragraph","spans":[{"id":"spn-77398","marks":["bold"],"text":"Cons"}]},{"id":"blk-50441","items":[{"blocks":[{"id":"blk-50443","kind":"paragraph","spans":[{"id":"spn-77399","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-50442","kind":"list-item"},{"blocks":[{"id":"blk-50445","kind":"paragraph","spans":[{"id":"spn-77400","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-50444","kind":"list-item"},{"blocks":[{"id":"blk-50447","kind":"paragraph","spans":[{"id":"spn-77401","text":"Increased vendor lock-in risk."}]}],"id":"blk-50446","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50448","kind":"paragraph","spans":[{"id":"spn-77402","marks":["bold"],"text":"Why rejected"},{"id":"spn-77403","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-50449","kind":"heading","level":3,"spans":[{"id":"spn-77404","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-50450","kind":"paragraph","spans":[{"id":"spn-77405","marks":["bold"],"text":"Pros"}]},{"id":"blk-50451","items":[{"blocks":[{"id":"blk-50453","kind":"paragraph","spans":[{"id":"spn-77406","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-50452","kind":"list-item"},{"blocks":[{"id":"blk-50455","kind":"paragraph","spans":[{"id":"spn-77407","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-50454","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50456","kind":"paragraph","spans":[{"id":"spn-77408","marks":["bold"],"text":"Cons"}]},{"id":"blk-50457","items":[{"blocks":[{"id":"blk-50459","kind":"paragraph","spans":[{"id":"spn-77409","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-50458","kind":"list-item"},{"blocks":[{"id":"blk-50461","kind":"paragraph","spans":[{"id":"spn-77410","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-50460","kind":"list-item"},{"blocks":[{"id":"blk-50463","kind":"paragraph","spans":[{"id":"spn-77411","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-50462","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50464","kind":"paragraph","spans":[{"id":"spn-77412","marks":["bold"],"text":"Why rejected"},{"id":"spn-77413","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-50465","kind":"heading","level":3,"spans":[{"id":"spn-77414","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-50466","kind":"paragraph","spans":[{"id":"spn-77415","marks":["bold"],"text":"Pros"}]},{"id":"blk-50467","items":[{"blocks":[{"id":"blk-50469","kind":"paragraph","spans":[{"id":"spn-77416","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-50468","kind":"list-item"},{"blocks":[{"id":"blk-50471","kind":"paragraph","spans":[{"id":"spn-77417","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-50470","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50472","kind":"paragraph","spans":[{"id":"spn-77418","marks":["bold"],"text":"Cons"}]},{"id":"blk-50473","items":[{"blocks":[{"id":"blk-50475","kind":"paragraph","spans":[{"id":"spn-77419","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-50474","kind":"list-item"},{"blocks":[{"id":"blk-50477","kind":"paragraph","spans":[{"id":"spn-77420","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-50476","kind":"list-item"},{"blocks":[{"id":"blk-50479","kind":"paragraph","spans":[{"id":"spn-77421","text":"Slower time-to-market."}]}],"id":"blk-50478","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50480","kind":"paragraph","spans":[{"id":"spn-77422","marks":["bold"],"text":"Why rejected"},{"id":"spn-77423","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-50481","kind":"heading","level":2,"spans":[{"id":"spn-77424","text":"Consequences"}]},{"id":"blk-50482","kind":"heading","level":3,"spans":[{"id":"spn-77425","text":"Positive"}]},{"id":"blk-50483","items":[{"blocks":[{"id":"blk-50485","kind":"paragraph","spans":[{"id":"spn-77426","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-77427","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-50484","kind":"list-item"},{"blocks":[{"id":"blk-50487","kind":"paragraph","spans":[{"id":"spn-77428","marks":["bold"],"text":"Product flexibility"},{"id":"spn-77429","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-50486","kind":"list-item"},{"blocks":[{"id":"blk-50489","kind":"paragraph","spans":[{"id":"spn-77430","marks":["bold"],"text":"Risk reduction"},{"id":"spn-77431","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-50488","kind":"list-item"},{"blocks":[{"id":"blk-50491","kind":"paragraph","spans":[{"id":"spn-77432","marks":["bold"],"text":"Future extensibility"},{"id":"spn-77433","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-50490","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50492","kind":"heading","level":3,"spans":[{"id":"spn-77434","text":"Negative / costs"}]},{"id":"blk-50493","items":[{"blocks":[{"id":"blk-50495","kind":"paragraph","spans":[{"id":"spn-77435","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-77436","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-50494","kind":"list-item"},{"blocks":[{"id":"blk-50497","kind":"paragraph","spans":[{"id":"spn-77437","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-77438","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-50496","kind":"list-item"},{"blocks":[{"id":"blk-50499","kind":"paragraph","spans":[{"id":"spn-77439","marks":["bold"],"text":"Operational surface area"},{"id":"spn-77440","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-50498","kind":"list-item"},{"blocks":[{"id":"blk-50501","kind":"paragraph","spans":[{"id":"spn-77441","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-77442","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-50500","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50502","kind":"heading","level":2,"spans":[{"id":"spn-77443","text":"Implementation details (normative requirements)"}]},{"id":"blk-50503","items":[{"blocks":[{"id":"blk-50505","kind":"paragraph","spans":[{"id":"spn-77444","marks":["bold"],"text":"RPI is mandatory"}]}],"id":"blk-50504","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-50506","items":[{"blocks":[{"id":"blk-50508","kind":"paragraph","spans":[{"id":"spn-77445","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-50507","kind":"list-item"},{"blocks":[{"id":"blk-50510","kind":"paragraph","spans":[{"id":"spn-77446","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-50509","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50511","items":[{"blocks":[{"id":"blk-50513","kind":"paragraph","spans":[{"id":"spn-77447","marks":["bold"],"text":"Invocation protocol is consistent"}]}],"id":"blk-50512","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-50514","items":[{"blocks":[{"id":"blk-50516","kind":"paragraph","spans":[{"id":"spn-77448","text":"The canonical request/response shapes are defined in "},{"id":"spn-77449","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-77450","text":" and "},{"id":"spn-77451","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-77452","text":"."}]}],"id":"blk-50515","kind":"list-item"},{"blocks":[{"id":"blk-50518","kind":"paragraph","spans":[{"id":"spn-77453","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-50517","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50519","items":[{"blocks":[{"id":"blk-50521","kind":"paragraph","spans":[{"id":"spn-77454","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]}],"id":"blk-50520","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-50522","items":[{"blocks":[{"id":"blk-50524","kind":"paragraph","spans":[{"id":"spn-77455","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-77456","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-77457","text":"."}]}],"id":"blk-50523","kind":"list-item"},{"blocks":[{"id":"blk-50526","kind":"paragraph","spans":[{"id":"spn-77458","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-50525","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50527","items":[{"blocks":[{"id":"blk-50529","kind":"paragraph","spans":[{"id":"spn-77459","marks":["bold"],"text":"Tier gating"}]}],"id":"blk-50528","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-50530","items":[{"blocks":[{"id":"blk-50532","kind":"paragraph","spans":[{"id":"spn-77460","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-50531","kind":"list-item"},{"blocks":[{"id":"blk-50534","kind":"paragraph","spans":[{"id":"spn-77461","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-50533","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-50535","items":[{"blocks":[{"id":"blk-50537","kind":"paragraph","spans":[{"id":"spn-77462","marks":["bold"],"text":"Secrets handling"}]}],"id":"blk-50536","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-50538","items":[{"blocks":[{"id":"blk-50540","kind":"paragraph","spans":[{"id":"spn-77463","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-50539","kind":"list-item"},{"blocks":[{"id":"blk-50542","kind":"paragraph","spans":[{"id":"spn-77464","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id":"blk-50541","kind":"list-item"},{"blocks":[{"id":"blk-50544","kind":"paragraph","spans":[{"id":"spn-77465","text":"Telemetry signing secrets are deployment-