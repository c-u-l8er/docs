{"bendscript":"0.1","blocks":[{"id":"blk-31631","kind":"heading","level":1,"spans":[{"id":"spn-35795","text":"ADR-0001: Multi-Runtime Strategy (Cloudflare Workers/DO + AWS Bedrock AgentCore)"}]},{"id":"blk-31632","kind":"paragraph","spans":[{"id":"spn-35796","text":"Status: Accepted (v1) Date: 2026-01-21 Decision Makers: Engineering Related Docs:"}]},{"id":"blk-31633","items":[{"blocks":[{"id":"blk-31635","kind":"paragraph","spans":[{"id":"spn-35797","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-31634","kind":"list-item"},{"blocks":[{"id":"blk-31637","kind":"paragraph","spans":[{"id":"spn-35798","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-31636","kind":"list-item"},{"blocks":[{"id":"blk-31639","kind":"paragraph","spans":[{"id":"spn-35799","marks":["code"],"text":"WebHost.Systems/docs/spec/50_OBSERVABILITY_BILLING_LIMITS.md"}]}],"id":"blk-31638","kind":"list-item"},{"blocks":[{"id":"blk-31641","kind":"paragraph","spans":[{"id":"spn-35800","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-31640","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31642","kind":"heading","level":2,"spans":[{"id":"spn-35801","text":"Context"}]},{"id":"blk-31643","kind":"paragraph","spans":[{"id":"spn-35802","text":"webhost.systems is a platform for deploying, running, and observing AI agents. The platform must serve two competing needs:"}]},{"id":"blk-31644","kind":"paragraph","spans":[{"id":"spn-35803","text":"1. "},{"id":"spn-35804","marks":["bold"],"text":"Broad adoption and strong economics"},{"id":"spn-35805","text":" for the majority of users:"}]},{"id":"blk-31645","items":[{"blocks":[{"id":"blk-31647","kind":"paragraph","spans":[{"id":"spn-35806","text":"low marginal cost for invocations,"}]}],"id":"blk-31646","kind":"list-item"},{"blocks":[{"id":"blk-31649","kind":"paragraph","spans":[{"id":"spn-35807","text":"low latency,"}]}],"id":"blk-31648","kind":"list-item"},{"blocks":[{"id":"blk-31651","kind":"paragraph","spans":[{"id":"spn-35808","text":"global availability,"}]}],"id":"blk-31650","kind":"list-item"},{"blocks":[{"id":"blk-31653","kind":"paragraph","spans":[{"id":"spn-35809","text":"simple developer experience."}]}],"id":"blk-31652","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31654","kind":"paragraph","spans":[{"id":"spn-35810","text":"2. "},{"id":"spn-35811","marks":["bold"],"text":"Enterprise-grade capabilities"},{"id":"spn-35812","text":" for premium customers and advanced workloads:"}]},{"id":"blk-31655","items":[{"blocks":[{"id":"blk-31657","kind":"paragraph","spans":[{"id":"spn-35813","text":"long-running sessions and tasks,"}]}],"id":"blk-31656","kind":"list-item"},{"blocks":[{"id":"blk-31659","kind":"paragraph","spans":[{"id":"spn-35814","text":"stronger isolation and security posture,"}]}],"id":"blk-31658","kind":"list-item"},{"blocks":[{"id":"blk-31661","kind":"paragraph","spans":[{"id":"spn-35815","text":"built-in tool ecosystems (e.g., code interpreter, browser automation) where available,"}]}],"id":"blk-31660","kind":"list-item"},{"blocks":[{"id":"blk-31663","kind":"paragraph","spans":[{"id":"spn-35816","text":"operational maturity and support for compliance-aligned deployments."}]}],"id":"blk-31662","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31664","kind":"paragraph","spans":[{"id":"spn-35817","text":"No single runtime platform optimizes for all of these simultaneously. In addition, vendor lock-in risk is material: a single-provider architecture can force business and technical constraints (pricing changes, platform limits, region constraints)."}]},{"id":"blk-31665","kind":"paragraph","spans":[{"id":"spn-35818","text":"We also require:"}]},{"id":"blk-31666","items":[{"blocks":[{"id":"blk-31668","kind":"paragraph","spans":[{"id":"spn-35819","text":"a unified invocation protocol across runtimes,"}]}],"id":"blk-31667","kind":"list-item"},{"blocks":[{"id":"blk-31670","kind":"paragraph","spans":[{"id":"spn-35820","text":"consistent metering/telemetry and plan enforcement,"}]}],"id":"blk-31669","kind":"list-item"},{"blocks":[{"id":"blk-31672","kind":"paragraph","spans":[{"id":"spn-35821","text":"a path to add additional runtimes later without rewriting the control plane."}]}],"id":"blk-31671","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31673","kind":"heading","level":2,"spans":[{"id":"spn-35822","text":"Decision"}]},{"id":"blk-31674","kind":"paragraph","spans":[{"id":"spn-35823","text":"Adopt a "},{"id":"spn-35824","marks":["bold"],"text":"multi-runtime architecture"},{"id":"spn-35825","text":" with a single "},{"id":"spn-35826","marks":["bold"],"text":"control plane"},{"id":"spn-35827","text":" and multiple "},{"id":"spn-35828","marks":["bold"],"text":"data plane"},{"id":"spn-35829","text":" runtime providers behind a shared "},{"id":"spn-35830","marks":["bold"],"text":"Runtime Provider Interface (RPI)"},{"id":"spn-35831","text":"."}]},{"id":"blk-31675","kind":"heading","level":3,"spans":[{"id":"spn-35832","text":"Providers in v1"}]},{"id":"blk-31676","items":[{"blocks":[{"id":"blk-31678","kind":"paragraph","spans":[{"id":"spn-35833","marks":["bold"],"text":"Default runtime"},{"id":"spn-35834","text":": Cloudflare Workers + Durable Objects ("},{"id":"spn-35835","marks":["code"],"text":"runtimeProvider = cloudflare"},{"id":"spn-35836","text":")"}]}],"id":"blk-31677","kind":"list-item"},{"blocks":[{"id":"blk-31680","kind":"paragraph","spans":[{"id":"spn-35837","text":"Target: the majority of workloads and tiers (including free acquisition)."}]}],"id":"blk-31679","kind":"list-item"},{"blocks":[{"id":"blk-31682","kind":"paragraph","spans":[{"id":"spn-35838","text":"Rationale: global edge footprint, strong economics, good latency, suitable for typical agent interactions."}]}],"id":"blk-31681","kind":"list-item"},{"blocks":[{"id":"blk-31684","kind":"paragraph","spans":[{"id":"spn-35839","text":"TypeScript: first-class TypeScript support (Workers + Durable Objects APIs are TypeScript-friendly; many agent frameworks and SDKs work naturally in this environment)."}]}],"id":"blk-31683","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31685","items":[{"blocks":[{"id":"blk-31687","kind":"paragraph","spans":[{"id":"spn-35840","marks":["bold"],"text":"Premium/enterprise runtime"},{"id":"spn-35841","text":": AWS Bedrock AgentCore ("},{"id":"spn-35842","marks":["code"],"text":"runtimeProvider = agentcore"},{"id":"spn-35843","text":")"}]}],"id":"blk-31686","kind":"list-item"},{"blocks":[{"id":"blk-31689","kind":"paragraph","spans":[{"id":"spn-35844","text":"Target: enterprise-tier workloads and advanced/long-running tasks."}]}],"id":"blk-31688","kind":"list-item"},{"blocks":[{"id":"blk-31691","kind":"paragraph","spans":[{"id":"spn-35845","text":"Rationale: enterprise-grade isolation and runtime capabilities (including long-running sessions), plus a strong TypeScript SDK ecosystem:"}]}],"id":"blk-31690","kind":"list-item"},{"blocks":[{"id":"blk-31693","kind":"paragraph","spans":[{"id":"spn-35846","marks":["code"],"text":"@aws-sdk/client-bedrock-agentcore"},{"id":"spn-35847","text":" for TypeScript control plane + runtime invocation"}]}],"id":"blk-31692","kind":"list-item"},{"blocks":[{"id":"blk-31695","kind":"paragraph","spans":[{"id":"spn-35848","marks":["code"],"text":"bedrock-agentcore"},{"id":"spn-35849","text":" tools SDK for TypeScript (e.g., Code Interpreter and Browser tool integrations), including modern agent tooling integrations such as Vercel AI SDK"}]}],"id":"blk-31694","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31696","kind":"heading","level":3,"spans":[{"id":"spn-35850","text":"TypeScript support across runtimes (explicit)"}]},{"id":"blk-31697","kind":"paragraph","spans":[{"id":"spn-35851","text":"webhost.systems is intended to be "},{"id":"spn-35852","marks":["bold"],"text":"TypeScript-native end-to-end"},{"id":"spn-35853","text":":"}]},{"id":"blk-31698","items":[{"blocks":[{"id":"blk-31700","kind":"paragraph","spans":[{"id":"spn-35854","text":"Control plane: TypeScript (Supabase backend + UI types)"}]}],"id":"blk-31699","kind":"list-item"},{"blocks":[{"id":"blk-31702","kind":"paragraph","spans":[{"id":"spn-35855","text":"Cloudflare runtime: TypeScript (Workers/DO)"}]}],"id":"blk-31701","kind":"list-item"},{"blocks":[{"id":"blk-31704","kind":"paragraph","spans":[{"id":"spn-35856","text":"AgentCore runtime: TypeScript SDK support for both management/invocation and tool ecosystems"}]}],"id":"blk-31703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31705","kind":"paragraph","spans":[{"id":"spn-35857","text":"This means "},{"id":"spn-35858","marks":["bold"],"text":"no Python requirement"},{"id":"spn-35859","text":" for deploying and operating on AgentCore from webhost.systems; TypeScript can be the primary implementation language for both runtimes."}]},{"id":"blk-31706","kind":"heading","level":3,"spans":[{"id":"spn-35860","text":"Control plane"}]},{"id":"blk-31707","items":[{"blocks":[{"id":"blk-31709","kind":"paragraph","spans":[{"id":"spn-35861","text":"The control plane (auth, DB, deployments, billing, telemetry ingestion, aggregation, UI) remains centralized and runtime-agnostic."}]}],"id":"blk-31708","kind":"list-item"},{"blocks":[{"id":"blk-31711","kind":"paragraph","spans":[{"id":"spn-35862","text":"The control plane chooses the provider at deploy time (and routes invocations based on active deployment)."}]}],"id":"blk-31710","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31712","kind":"heading","level":3,"spans":[{"id":"spn-35863","text":"Contract"}]},{"id":"blk-31713","items":[{"blocks":[{"id":"blk-31715","kind":"paragraph","spans":[{"id":"spn-35864","text":"All runtime providers MUST implement the RPI defined in "},{"id":"spn-35865","marks":["code"],"text":"20_RUNTIME_PROVIDER_INTERFACE.md"},{"id":"spn-35866","text":", including:"}]}],"id":"blk-31714","kind":"list-item"},{"blocks":[{"id":"blk-31717","kind":"paragraph","spans":[{"id":"spn-35867","marks":["code"],"text":"deploy(...)"}]}],"id":"blk-31716","kind":"list-item"},{"blocks":[{"id":"blk-31719","kind":"paragraph","spans":[{"id":"spn-35868","marks":["code"],"text":"invoke(...)"},{"id":"spn-35869","text":" (streaming optional but preferred)"}]}],"id":"blk-31718","kind":"list-item"},{"blocks":[{"id":"blk-31721","kind":"paragraph","spans":[{"id":"spn-35870","text":"telemetry emission strategy and integrity protections"}]}],"id":"blk-31720","kind":"list-item"},{"blocks":[{"id":"blk-31723","kind":"paragraph","spans":[{"id":"spn-35871","text":"normalized error mapping"}]}],"id":"blk-31722","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31724","kind":"heading","level":2,"spans":[{"id":"spn-35872","text":"Alternatives considered"}]},{"id":"blk-31725","kind":"heading","level":3,"spans":[{"id":"spn-35873","text":"A) Single-runtime: Cloudflare-only"}]},{"id":"blk-31726","kind":"paragraph","spans":[{"id":"spn-35874","marks":["bold"],"text":"Pros"}]},{"id":"blk-31727","items":[{"blocks":[{"id":"blk-31729","kind":"paragraph","spans":[{"id":"spn-35875","text":"Simplest operational model and implementation."}]}],"id":"blk-31728","kind":"list-item"},{"blocks":[{"id":"blk-31731","kind":"paragraph","spans":[{"id":"spn-35876","text":"Strong edge performance and acquisition economics."}]}],"id":"blk-31730","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31732","kind":"paragraph","spans":[{"id":"spn-35877","marks":["bold"],"text":"Cons"}]},{"id":"blk-31733","items":[{"blocks":[{"id":"blk-31735","kind":"paragraph","spans":[{"id":"spn-35878","text":"Hard ceiling on long-running tasks and certain tool ecosystems."}]}],"id":"blk-31734","kind":"list-item"},{"blocks":[{"id":"blk-31737","kind":"paragraph","spans":[{"id":"spn-35879","text":"Weaker enterprise narrative for isolation/compliance and advanced capabilities."}]}],"id":"blk-31736","kind":"list-item"},{"blocks":[{"id":"blk-31739","kind":"paragraph","spans":[{"id":"spn-35880","text":"Constrains future product tiers to one platform’s limitations."}]}],"id":"blk-31738","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31740","kind":"paragraph","spans":[{"id":"spn-35881","marks":["bold"],"text":"Why rejected"},{"id":"spn-35882","text":" Does not meet enterprise/advanced workload requirements without major additional infrastructure."}]},{"id":"blk-31741","kind":"heading","level":3,"spans":[{"id":"spn-35883","text":"B) Single-runtime: AgentCore-only"}]},{"id":"blk-31742","kind":"paragraph","spans":[{"id":"spn-35884","marks":["bold"],"text":"Pros"}]},{"id":"blk-31743","items":[{"blocks":[{"id":"blk-31745","kind":"paragraph","spans":[{"id":"spn-35885","text":"Strong enterprise posture and capability set."}]}],"id":"blk-31744","kind":"list-item"},{"blocks":[{"id":"blk-31747","kind":"paragraph","spans":[{"id":"spn-35886","text":"Potentially simpler story for long-running tasks and advanced tools."}]}],"id":"blk-31746","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31748","kind":"paragraph","spans":[{"id":"spn-35887","marks":["bold"],"text":"Cons"}]},{"id":"blk-31749","items":[{"blocks":[{"id":"blk-31751","kind":"paragraph","spans":[{"id":"spn-35888","text":"Higher cost structure for broad/free usage; weakens acquisition."}]}],"id":"blk-31750","kind":"list-item"},{"blocks":[{"id":"blk-31753","kind":"paragraph","spans":[{"id":"spn-35889","text":"Region footprint and latency may be weaker for global edge use-cases."}]}],"id":"blk-31752","kind":"list-item"},{"blocks":[{"id":"blk-31755","kind":"paragraph","spans":[{"id":"spn-35890","text":"Increased vendor lock-in risk."}]}],"id":"blk-31754","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31756","kind":"paragraph","spans":[{"id":"spn-35891","marks":["bold"],"text":"Why rejected"},{"id":"spn-35892","text":" Does not meet broad adoption/economics goals; raises lock-in and cost risk for the base tier."}]},{"id":"blk-31757","kind":"heading","level":3,"spans":[{"id":"spn-35893","text":"C) “Use Convex Agents for hosting”"}]},{"id":"blk-31758","kind":"paragraph","spans":[{"id":"spn-35894","marks":["bold"],"text":"Pros"}]},{"id":"blk-31759","items":[{"blocks":[{"id":"blk-31761","kind":"paragraph","spans":[{"id":"spn-35895","text":"Extremely fast iteration for control plane and simple assistant-like workflows."}]}],"id":"blk-31760","kind":"list-item"},{"blocks":[{"id":"blk-31763","kind":"paragraph","spans":[{"id":"spn-35896","text":"Unified stack for UI + backend + simple agent logic."}]}],"id":"blk-31762","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31764","kind":"paragraph","spans":[{"id":"spn-35897","marks":["bold"],"text":"Cons"}]},{"id":"blk-31765","items":[{"blocks":[{"id":"blk-31767","kind":"paragraph","spans":[{"id":"spn-35898","text":"Not designed as the primary hosting runtime for customer agents at scale."}]}],"id":"blk-31766","kind":"list-item"},{"blocks":[{"id":"blk-31769","kind":"paragraph","spans":[{"id":"spn-35899","text":"Time and execution constraints; mismatched to long-running and high-volume workloads."}]}],"id":"blk-31768","kind":"list-item"},{"blocks":[{"id":"blk-31771","kind":"paragraph","spans":[{"id":"spn-35900","text":"Harder to model durable state and provider-level isolation guarantees for untrusted code."}]}],"id":"blk-31770","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31772","kind":"paragraph","spans":[{"id":"spn-35901","marks":["bold"],"text":"Why rejected"},{"id":"spn-35902","text":" Convex Agents are better suited to control-plane automation (dashboard assistant), not customer agent hosting."}]},{"id":"blk-31773","kind":"heading","level":3,"spans":[{"id":"spn-35903","text":"D) Container/Kubernetes-based runtime as default"}]},{"id":"blk-31774","kind":"paragraph","spans":[{"id":"spn-35904","marks":["bold"],"text":"Pros"}]},{"id":"blk-31775","items":[{"blocks":[{"id":"blk-31777","kind":"paragraph","spans":[{"id":"spn-35905","text":"Full control of runtime environment and dependencies."}]}],"id":"blk-31776","kind":"list-item"},{"blocks":[{"id":"blk-31779","kind":"paragraph","spans":[{"id":"spn-35906","text":"Potentially easiest to support arbitrary frameworks."}]}],"id":"blk-31778","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31780","kind":"paragraph","spans":[{"id":"spn-35907","marks":["bold"],"text":"Cons"}]},{"id":"blk-31781","items":[{"blocks":[{"id":"blk-31783","kind":"paragraph","spans":[{"id":"spn-35908","text":"Highest operational complexity and ongoing cost."}]}],"id":"blk-31782","kind":"list-item"},{"blocks":[{"id":"blk-31785","kind":"paragraph","spans":[{"id":"spn-35909","text":"Harder to offer a generous free tier with predictable margins."}]}],"id":"blk-31784","kind":"list-item"},{"blocks":[{"id":"blk-31787","kind":"paragraph","spans":[{"id":"spn-35910","text":"Slower time-to-market."}]}],"id":"blk-31786","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31788","kind":"paragraph","spans":[{"id":"spn-35911","marks":["bold"],"text":"Why rejected"},{"id":"spn-35912","text":" Operationally heavy for v1; incompatible with rapid iteration and free-tier economics goals."}]},{"id":"blk-31789","kind":"heading","level":2,"spans":[{"id":"spn-35913","text":"Consequences"}]},{"id":"blk-31790","kind":"heading","level":3,"spans":[{"id":"spn-35914","text":"Positive"}]},{"id":"blk-31791","items":[{"blocks":[{"id":"blk-31793","kind":"paragraph","spans":[{"id":"spn-35915","marks":["bold"],"text":"Economic flexibility"},{"id":"spn-35916","text":": Cloudflare can power free and most paid tiers; AgentCore reserved for premium needs."}]}],"id":"blk-31792","kind":"list-item"},{"blocks":[{"id":"blk-31795","kind":"paragraph","spans":[{"id":"spn-35917","marks":["bold"],"text":"Product flexibility"},{"id":"spn-35918","text":": choose best runtime per workload; evolve pricing/tiering by runtime."}]}],"id":"blk-31794","kind":"list-item"},{"blocks":[{"id":"blk-31797","kind":"paragraph","spans":[{"id":"spn-35919","marks":["bold"],"text":"Risk reduction"},{"id":"spn-35920","text":": mitigates vendor lock-in through RPI and consistent protocol/telemetry."}]}],"id":"blk-31796","kind":"list-item"},{"blocks":[{"id":"blk-31799","kind":"paragraph","spans":[{"id":"spn-35921","marks":["bold"],"text":"Future extensibility"},{"id":"spn-35922","text":": additional providers can be added by implementing the RPI without redesigning the control plane."}]}],"id":"blk-31798","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31800","kind":"heading","level":3,"spans":[{"id":"spn-35923","text":"Negative / costs"}]},{"id":"blk-31801","items":[{"blocks":[{"id":"blk-31803","kind":"paragraph","spans":[{"id":"spn-35924","marks":["bold"],"text":"Engineering complexity"},{"id":"spn-35925","text":": must implement and maintain multiple adapters and consistent semantics."}]}],"id":"blk-31802","kind":"list-item"},{"blocks":[{"id":"blk-31805","kind":"paragraph","spans":[{"id":"spn-35926","marks":["bold"],"text":"Consistency challenges"},{"id":"spn-35927","text":": token counting, streaming, and tool semantics vary by provider."}]}],"id":"blk-31804","kind":"list-item"},{"blocks":[{"id":"blk-31807","kind":"paragraph","spans":[{"id":"spn-35928","marks":["bold"],"text":"Operational surface area"},{"id":"spn-35929","text":": two providers mean more credentials, monitoring, and failure modes."}]}],"id":"blk-31806","kind":"list-item"},{"blocks":[{"id":"blk-31809","kind":"paragraph","spans":[{"id":"spn-35930","marks":["bold"],"text":"Telemetry integrity"},{"id":"spn-35931","text":" must be handled carefully to prevent spoofing and cost manipulation."}]}],"id":"blk-31808","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31810","kind":"heading","level":2,"spans":[{"id":"spn-35932","text":"Implementation details (normative requirements)"}]},{"id":"blk-31811","kind":"paragraph","spans":[{"id":"spn-35933","text":"1. "},{"id":"spn-35934","marks":["bold"],"text":"RPI is mandatory"}]},{"id":"blk-31812","items":[{"blocks":[{"id":"blk-31814","kind":"paragraph","spans":[{"id":"spn-35935","text":"All runtime-specific logic must live behind the RPI."}]}],"id":"blk-31813","kind":"list-item"},{"blocks":[{"id":"blk-31816","kind":"paragraph","spans":[{"id":"spn-35936","text":"Control plane code must not call provider APIs directly except through the adapter layer."}]}],"id":"blk-31815","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31817","kind":"paragraph","spans":[{"id":"spn-35937","text":"2. "},{"id":"spn-35938","marks":["bold"],"text":"Invocation protocol is consistent"}]},{"id":"blk-31818","items":[{"blocks":[{"id":"blk-31820","kind":"paragraph","spans":[{"id":"spn-35939","text":"The canonical request/response shapes are defined in "},{"id":"spn-35940","marks":["code"],"text":"10_API_CONTRACTS.md"},{"id":"spn-35941","text":" and "},{"id":"spn-35942","marks":["code"],"text":"00_MASTER_SPEC.md"},{"id":"spn-35943","text":"."}]}],"id":"blk-31819","kind":"list-item"},{"blocks":[{"id":"blk-31822","kind":"paragraph","spans":[{"id":"spn-35944","text":"Providers may add extra diagnostics internally, but client-facing outputs must be normalized."}]}],"id":"blk-31821","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31823","kind":"paragraph","spans":[{"id":"spn-35945","text":"3. "},{"id":"spn-35946","marks":["bold"],"text":"Telemetry is required and integrity-protected"}]},{"id":"blk-31824","items":[{"blocks":[{"id":"blk-31826","kind":"paragraph","spans":[{"id":"spn-35947","text":"Each invocation must produce a telemetry event attributable to "},{"id":"spn-35948","marks":["code"],"text":"{userId, agentId, deploymentId, runtimeProvider}"},{"id":"spn-35949","text":"."}]}],"id":"blk-31825","kind":"list-item"},{"blocks":[{"id":"blk-31828","kind":"paragraph","spans":[{"id":"spn-35950","text":"Telemetry ingestion must verify integrity (deployment-scoped signing) and validate ownership."}]}],"id":"blk-31827","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31829","kind":"paragraph","spans":[{"id":"spn-35951","text":"4. "},{"id":"spn-35952","marks":["bold"],"text":"Tier gating"}]},{"id":"blk-31830","items":[{"blocks":[{"id":"blk-31832","kind":"paragraph","spans":[{"id":"spn-35953","text":"AgentCore must be gated by tier entitlements (enabled only for premium/enterprise tiers unless explicitly configured otherwise)."}]}],"id":"blk-31831","kind":"list-item"},{"blocks":[{"id":"blk-31834","kind":"paragraph","spans":[{"id":"spn-35954","text":"Both deploy and invoke paths must enforce entitlements (defense in depth)."}]}],"id":"blk-31833","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31835","kind":"paragraph","spans":[{"id":"spn-35955","text":"5. "},{"id":"spn-35956","marks":["bold"],"text":"Secrets handling"}]},{"id":"blk-31836","items":[{"blocks":[{"id":"blk-31838","kind":"paragraph","spans":[{"id":"spn-35957","text":"No plaintext secrets are stored in the primary DB."}]}],"id":"blk-31837","kind":"list-item"},{"blocks":[{"id":"blk-31840","kind":"paragraph","spans":[{"id":"spn-35958","text":"Secrets are injected using provider-native secret mechanisms."}]}],"id":"blk-31839","kind":"list-item"},{"blocks":[{"id":"blk-31842","kind":"paragraph","spans":[{"id":"spn-35959","text":"Telemetry signing secrets are deployment-scoped and injected into the data plane."}]}],"id":"blk-31841","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31843","kind":"paragraph","spans":[{"id":"spn-35960","text":"6. "},{"id":"spn-35961","marks":["bold"],"text":"Resource tagging"}]},{"id":"blk-31844","items":[{"blocks":[{"id":"blk-31846","kind":"paragraph","spans":[{"id":"spn-35962","text":"Provider resources should be tagged/labeled with "},{"id":"spn-35963","marks":["code"],"text":"{userId, agentId, deploymentId}"},{"id":"spn-35964","text":" to support cleanup and future billing reconciliation."}]}],"id":"blk-31845","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31847","kind":"heading","level":2,"spans":[{"id":"spn-35965","text":"Operational considerations"}]},{"id":"blk-31848","items":[{"blocks":[{"id":"blk-31850","kind":"paragraph","spans":[{"id":"spn-35966","text":"Track per-provider health and error rates independently."}]}],"id":"blk-31849","kind":"list-item"},{"blocks":[{"id":"blk-31852","kind":"paragraph","spans":[{"id":"spn-35967","text":"Implement provider-specific circuit breakers if needed (post-v1)."}]}],"id":"blk-31851","kind":"list-item"},{"blocks":[{"id":"blk-31854","kind":"paragraph","spans":[{"id":"spn-35968","text":"Ensure staging environments exist for both providers with separate credentials and billing/webhook settings."}]}],"id":"blk-31853","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31855","kind":"heading","level":2,"spans":[{"id":"spn-35969","text":"Success criteria"}]},{"id":"blk-31856","kind":"paragraph","spans":[{"id":"spn-35970","text":"This decision is successful if:"}]},{"id":"blk-31857","items":[{"blocks":[{"id":"blk-31859","kind":"paragraph","spans":[{"id":"spn-35971","text":"Cloudflare deploy/invoke works end-to-end with telemetry and limit enforcement."}]}],"id":"blk-31858","kind":"list-item"},{"blocks":[{"id":"blk-31861","kind":"paragraph","spans":[{"id":"spn-35972","text":"AgentCore deploy/invoke works end-to-end for entitled users with telemetry and limit enforcement."}]}],"id":"blk-31860","kind":"list-item"},{"blocks":[{"id":"blk-31863","kind":"paragraph","spans":[{"id":"spn-35973","text":"Control plane routing remains provider-agnostic and uses only the RPI."}]}],"id":"blk-31862","kind":"list-item"},{"blocks":[{"id":"blk-31865","kind":"paragraph","spans":[{"id":"spn-35974","text":"Adding a new provider would require implementing a new adapter without major changes to the control plane schemas and APIs."}]}],"id":"blk-31864","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-31866","kind":"heading","level":2,"spans":[{"id":"spn-35975","text":"Follow-ups / next ADRs"}]},{"id":"blk-31867","items":[{"blocks":[{"id":"blk-31869","kind":"paragraph","spans":[{"id":"spn-35976","text":"ADR-0002: Control plane backend choice (Supabase; supersedes original Convex choice)."}]}],"id":"blk-31868","kind":"list-item"},{"blocks":[{"id":"blk-31871","kind":"paragraph","spans":[{"id":"spn-35977","text":"ADR-0003: Secrets strategy (no plaintext in DB; provider injection)."}]}],"id":"blk-31870","kind":"list-item"},{"blocks":[{"id":"blk-31873","kind":"paragraph","spans":[{"id":"spn-35978","text":"ADR-0004: Telemetry integrity model (deployment-scoped signing) and ingestion validation."}]}],"id":"blk-31872","kind":"list-item"},{"blocks":[{"id":"blk-31875","kind":"paragraph","spans":[{"id":"spn-35979","text":"ADR-0005: Deployment immutability + active pointer model."}]}],"id":"blk-31874","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera7u2zztslrpolgch7pcgwvnonnd6fohdtmj7njaexzccbqv37lyaq","vocabulary":"ampersand.docs.fs.v1"}