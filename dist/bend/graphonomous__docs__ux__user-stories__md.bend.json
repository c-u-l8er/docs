{"bendscript":"0.1","blocks":[{"id":"blk-44800","kind":"heading","level":1,"spans":[{"id":"spn-50430","text":"Graphonomous — User Stories"}]},{"id":"blk-44801","kind":"paragraph","spans":[{"id":"spn-50431","text":"Canonical user-story catalog. Used for Playwright tests (via MCP inspector pattern) + Claude Design input for a future visualization UI (likely hosted on RuneFort)."}]},{"id":"blk-44802","kind":"paragraph","spans":[{"id":"spn-50432","marks":["bold"],"text":"Scope:"},{"id":"spn-50433","text":" Continual-learning knowledge-graph engine. MCP-only today; web visualizer planned. "},{"id":"spn-50434","marks":["bold"],"text":"Unit-test surface covered:"},{"id":"spn-50435","text":" "},{"id":"spn-50436","marks":["code"],"text":"test/**"},{"id":"spn-50437","text":" (573 tests)."}]},{"id":"blk-44803","kind":"paragraph","spans":[{"id":"spn-50438","text":"---"}]},{"id":"blk-44804","kind":"heading","level":2,"spans":[{"id":"spn-50439","text":"Story 1 · Agent learns from user queries over time"}]},{"id":"blk-44805","items":[{"blocks":[{"id":"blk-44807","kind":"paragraph","spans":[{"id":"spn-50440","marks":["bold"],"text":"Persona:"},{"id":"spn-50441","text":" Device manufacturer embedding LLMs on IoT hardware"}]}],"id":"blk-44806","kind":"list-item"},{"blocks":[{"id":"blk-44809","kind":"paragraph","spans":[{"id":"spn-50442","marks":["bold"],"text":"Goal:"},{"id":"spn-50443","text":" Deploy a 3B-param model on edge that improves over time without retraining"}]}],"id":"blk-44808","kind":"list-item"},{"blocks":[{"id":"blk-44811","kind":"paragraph","spans":[{"id":"spn-50444","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-50445","text":" Model on device; SQLite local; MCP stdio available"}]}],"id":"blk-44810","kind":"list-item"},{"blocks":[{"id":"blk-44813","kind":"paragraph","spans":[{"id":"spn-50446","marks":["bold"],"text":"Steps:"}]}],"id":"blk-44812","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44814","kind":"paragraph","spans":[{"id":"spn-50447","text":"1. Initialize Graphonomous: "},{"id":"spn-50448","marks":["code"],"text":"mix run -- --db ~/.graphonomous/knowledge.db"},{"id":"spn-50449","text":" 2. Agent receives query: \"How do I set the temperature?\" 3. Retriever injects relevant graph context (prior queries, procedures, facts) 4. LLM generates response (inference external — Graphonomous doesn't run it) 5. Learner extracts entities/relationships → new nodes, updated edges 6. System records outcome signal (success? user satisfied?)"}]},{"id":"blk-44815","items":[{"blocks":[{"id":"blk-44817","kind":"paragraph","spans":[{"id":"spn-50450","marks":["bold"],"text":"Success:"},{"id":"spn-50451","text":" After ~100 queries, graph contains domain-specific knowledge; similar questions answered faster"}]}],"id":"blk-44816","kind":"list-item"},{"blocks":[{"id":"blk-44819","kind":"paragraph","spans":[{"id":"spn-50452","marks":["bold"],"text":"Covers:"},{"id":"spn-50453","text":" "},{"id":"spn-50454","marks":["code"],"text":"retriever.ex"},{"id":"spn-50455","text":", "},{"id":"spn-50456","marks":["code"],"text":"learner.ex"},{"id":"spn-50457","text":", "},{"id":"spn-50458","marks":["code"],"text":"novelty_detector.ex"},{"id":"spn-50459","text":", graph CRUD, SQLite storage, outcome ingestion — ~80 unit tests"}]}],"id":"blk-44818","kind":"list-item"},{"blocks":[{"id":"blk-44821","kind":"paragraph","spans":[{"id":"spn-50460","marks":["bold"],"text":"UI status:"},{"id":"spn-50461","text":" mcp-only; Phoenix LiveView dashboard planned for server mode"}]}],"id":"blk-44820","kind":"list-item"},{"blocks":[{"id":"blk-44823","kind":"paragraph","spans":[{"id":"spn-50462","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-50463","text":" Graph growth timeline (node/edge count over N queries) with topic clusters"}]}],"id":"blk-44822","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44824","kind":"heading","level":2,"spans":[{"id":"spn-50464","text":"Story 2 · Detect contradictions and update confidence"}]},{"id":"blk-44825","items":[{"blocks":[{"id":"blk-44827","kind":"paragraph","spans":[{"id":"spn-50465","marks":["bold"],"text":"Persona:"},{"id":"spn-50466","text":" Scheduling agent learning meeting coordination"}]}],"id":"blk-44826","kind":"list-item"},{"blocks":[{"id":"blk-44829","kind":"paragraph","spans":[{"id":"spn-50467","marks":["bold"],"text":"Goal:"},{"id":"spn-50468","text":" Catch when learned policies conflict; adjust confidence based on outcomes"}]}],"id":"blk-44828","kind":"list-item"},{"blocks":[{"id":"blk-44831","kind":"paragraph","spans":[{"id":"spn-50469","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-50470","text":" Graph contains contradictory semantic nodes (e.g. \"book 9am slots\" vs \"9am always full\")"}]}],"id":"blk-44830","kind":"list-item"},{"blocks":[{"id":"blk-44833","kind":"paragraph","spans":[{"id":"spn-50471","marks":["bold"],"text":"Steps:"}]}],"id":"blk-44832","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44834","kind":"paragraph","spans":[{"id":"spn-50472","text":"1. Agent retrieves policy nodes for next booking 2. Commits action based on retrieved confidences 3. Runtime reports outcome via "},{"id":"spn-50473","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-50474","text":" 4. Graphonomous creates "},{"id":"spn-50475","marks":["code"],"text":":outcome"},{"id":"spn-50476","text":" node + updates causal parents 5. Consolidator flags contradiction via "},{"id":"spn-50477","marks":["code"],"text":"belief.contradictions"}]},{"id":"blk-44835","items":[{"blocks":[{"id":"blk-44837","kind":"paragraph","spans":[{"id":"spn-50478","marks":["bold"],"text":"Success:"},{"id":"spn-50479","text":" Conflicting nodes flagged; both decrease confidence; agent requests clarification"}]}],"id":"blk-44836","kind":"list-item"},{"blocks":[{"id":"blk-44839","kind":"paragraph","spans":[{"id":"spn-50480","marks":["bold"],"text":"Covers:"},{"id":"spn-50481","text":" outcome grounding, causal attribution, "},{"id":"spn-50482","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-50483","text":", contradiction detector — ~40 unit tests"}]}],"id":"blk-44838","kind":"list-item"},{"blocks":[{"id":"blk-44841","kind":"paragraph","spans":[{"id":"spn-50484","marks":["bold"],"text":"UI status:"},{"id":"spn-50485","text":" mcp-only"}]}],"id":"blk-44840","kind":"list-item"},{"blocks":[{"id":"blk-44843","kind":"paragraph","spans":[{"id":"spn-50486","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-50487","text":" Contradiction report showing conflicting nodes + confidence delta"}]}],"id":"blk-44842","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44844","kind":"heading","level":2,"spans":[{"id":"spn-50488","text":"Story 3 · Install and replay a learned workflow"}]},{"id":"blk-44845","items":[{"blocks":[{"id":"blk-44847","kind":"paragraph","spans":[{"id":"spn-50489","marks":["bold"],"text":"Persona:"},{"id":"spn-50490","text":" Fleet admin rolling out proven maintenance procedure across machines"}]}],"id":"blk-44846","kind":"list-item"},{"blocks":[{"id":"blk-44849","kind":"paragraph","spans":[{"id":"spn-50491","marks":["bold"],"text":"Goal:"},{"id":"spn-50492","text":" Install a SkillCandidate from FleetPrompt; replay the learned workflow on destination agent"}]}],"id":"blk-44848","kind":"list-item"},{"blocks":[{"id":"blk-44851","kind":"paragraph","spans":[{"id":"spn-50493","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-50494","text":" SkillCandidate stored (via consolidation); agent-browser body available"}]}],"id":"blk-44850","kind":"list-item"},{"blocks":[{"id":"blk-44853","kind":"paragraph","spans":[{"id":"spn-50495","marks":["bold"],"text":"Steps:"}]}],"id":"blk-44852","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44854","kind":"paragraph","spans":[{"id":"spn-50496","text":"1. Call "},{"id":"spn-50497","marks":["code"],"text":"body.browser.replay(Trace)"},{"id":"spn-50498","text":" on destination agent 2. For each state hash in trace: perceive + verify state match 3. On mismatch: fail-fast; on match: execute next action 4. Agent emits SurpriseSignal if forward model prediction diverges"}]},{"id":"blk-44855","items":[{"blocks":[{"id":"blk-44857","kind":"paragraph","spans":[{"id":"spn-50499","marks":["bold"],"text":"Success:"},{"id":"spn-50500","text":" Workflow executes on new machine; state hashes match; skill becomes persistent in destination graph"}]}],"id":"blk-44856","kind":"list-item"},{"blocks":[{"id":"blk-44859","kind":"paragraph","spans":[{"id":"spn-50501","marks":["bold"],"text":"Covers:"},{"id":"spn-50502","text":" trace replay, "},{"id":"spn-50503","marks":["code"],"text":"state_hash"},{"id":"spn-50504","text":" validation, SurpriseSignal emission, episodic node creation — ~30 unit tests"}]}],"id":"blk-44858","kind":"list-item"},{"blocks":[{"id":"blk-44861","kind":"paragraph","spans":[{"id":"spn-50505","marks":["bold"],"text":"UI status:"},{"id":"spn-50506","text":" mcp-only"}]}],"id":"blk-44860","kind":"list-item"},{"blocks":[{"id":"blk-44863","kind":"paragraph","spans":[{"id":"spn-50507","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-50508","text":" Side-by-side trace diff (Machine A original vs Machine B replay) with hash-match indicators"}]}],"id":"blk-44862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44864","kind":"heading","level":2,"spans":[{"id":"spn-50509","text":"Story 4 · Run consolidation to prune low-confidence knowledge"}]},{"id":"blk-44865","items":[{"blocks":[{"id":"blk-44867","kind":"paragraph","spans":[{"id":"spn-50510","marks":["bold"],"text":"Persona:"},{"id":"spn-50511","text":" Backend service operator managing memory footprint"}]}],"id":"blk-44866","kind":"list-item"},{"blocks":[{"id":"blk-44869","kind":"paragraph","spans":[{"id":"spn-50512","marks":["bold"],"text":"Goal:"},{"id":"spn-50513","text":" Decay old knowledge, merge duplicates, promote stable facts"}]}],"id":"blk-44868","kind":"list-item"},{"blocks":[{"id":"blk-44871","kind":"paragraph","s