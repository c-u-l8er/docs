state match 3. On mismatch: fail-fast; on match: execute next action 4. Agent emits SurpriseSignal if forward model prediction diverges"}]},{"id":"blk-44965","items":[{"blocks":[{"id":"blk-44967","kind":"paragraph","spans":[{"id":"spn-51128","marks":["bold"],"text":"Success:"},{"id":"spn-51129","text":" Workflow executes on new machine; state hashes match; skill becomes persistent in destination graph"}]}],"id":"blk-44966","kind":"list-item"},{"blocks":[{"id":"blk-44969","kind":"paragraph","spans":[{"id":"spn-51130","marks":["bold"],"text":"Covers:"},{"id":"spn-51131","text":" trace replay, "},{"id":"spn-51132","marks":["code"],"text":"state_hash"},{"id":"spn-51133","text":" validation, SurpriseSignal emission, episodic node creation — ~30 unit tests"}]}],"id":"blk-44968","kind":"list-item"},{"blocks":[{"id":"blk-44971","kind":"paragraph","spans":[{"id":"spn-51134","marks":["bold"],"text":"UI status:"},{"id":"spn-51135","text":" mcp-only"}]}],"id":"blk-44970","kind":"list-item"},{"blocks":[{"id":"blk-44973","kind":"paragraph","spans":[{"id":"spn-51136","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-51137","text":" Side-by-side trace diff (Machine A original vs Machine B replay) with hash-match indicators"}]}],"id":"blk-44972","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44974","kind":"heading","level":2,"spans":[{"id":"spn-51138","text":"Story 4 · Run consolidation to prune low-confidence knowledge"}]},{"id":"blk-44975","items":[{"blocks":[{"id":"blk-44977","kind":"paragraph","spans":[{"id":"spn-51139","marks":["bold"],"text":"Persona:"},{"id":"spn-51140","text":" Backend service operator managing memory footprint"}]}],"id":"blk-44976","kind":"list-item"},{"blocks":[{"id":"blk-44979","kind":"paragraph","spans":[{"id":"spn-51141","marks":["bold"],"text":"Goal:"},{"id":"spn-51142","text":" Decay old knowledge, merge duplicates, promote stable facts"}]}],"id":"blk-44978","kind":"list-item"},{"blocks":[{"id":"blk-44981","kind":"paragraph","s