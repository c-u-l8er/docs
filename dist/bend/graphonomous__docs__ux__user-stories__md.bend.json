{"bendscript":"0.1","blocks":[{"id":"blk-45396","kind":"heading","level":1,"spans":[{"id":"spn-52233","text":"Graphonomous — User Stories"}]},{"id":"blk-45397","kind":"paragraph","spans":[{"id":"spn-52234","text":"Canonical user-story catalog. Used for Playwright tests (via MCP inspector pattern) + Claude Design input for a future visualization UI (likely hosted on RuneFort)."}]},{"id":"blk-45398","kind":"paragraph","spans":[{"id":"spn-52235","marks":["bold"],"text":"Scope:"},{"id":"spn-52236","text":" Continual-learning knowledge-graph engine. MCP-only today; web visualizer planned. "},{"id":"spn-52237","marks":["bold"],"text":"Unit-test surface covered:"},{"id":"spn-52238","text":" "},{"id":"spn-52239","marks":["code"],"text":"test/**"},{"id":"spn-52240","text":" (573 tests)."}]},{"id":"blk-45399","kind":"paragraph","spans":[{"id":"spn-52241","text":"---"}]},{"id":"blk-45400","kind":"heading","level":2,"spans":[{"id":"spn-52242","text":"Story 1 · Agent learns from user queries over time"}]},{"id":"blk-45401","items":[{"blocks":[{"id":"blk-45403","kind":"paragraph","spans":[{"id":"spn-52243","marks":["bold"],"text":"Persona:"},{"id":"spn-52244","text":" Device manufacturer embedding LLMs on IoT hardware"}]}],"id":"blk-45402","kind":"list-item"},{"blocks":[{"id":"blk-45405","kind":"paragraph","spans":[{"id":"spn-52245","marks":["bold"],"text":"Goal:"},{"id":"spn-52246","text":" Deploy a 3B-param model on edge that improves over time without retraining"}]}],"id":"blk-45404","kind":"list-item"},{"blocks":[{"id":"blk-45407","kind":"paragraph","spans":[{"id":"spn-52247","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-52248","text":" Model on device; SQLite local; MCP stdio available"}]}],"id":"blk-45406","kind":"list-item"},{"blocks":[{"id":"blk-45409","kind":"paragraph","spans":[{"id":"spn-52249","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45408","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45410","kind":"paragraph","spans":[{"id":"spn-52250","text":"1. Initialize Graphonomous: "},{"id":"spn-52251","marks":["code"],"text":"mix run -- --db ~/.graphonomous/knowledge.db"},{"id":"spn-52252","text":" 2. Agent receives query: \"How do I set the temperature?\" 3. Retriever injects relevant graph context (prior queries, procedures, facts) 4. LLM generates response (inference external — Graphonomous doesn't run it) 5. Learner extracts entities/relationships → new nodes, updated edges 6. System records outcome signal (success? user satisfied?)"}]},{"id":"blk-45411","items":[{"blocks":[{"id":"blk-45413","kind":"paragraph","spans":[{"id":"spn-52253","marks":["bold"],"text":"Success:"},{"id":"spn-52254","text":" After ~100 queries, graph contains domain-specific knowledge; similar questions answered faster"}]}],"id":"blk-45412","kind":"list-item"},{"blocks":[{"id":"blk-45415","kind":"paragraph","spans":[{"id":"spn-52255","marks":["bold"],"text":"Covers:"},{"id":"spn-52256","text":" "},{"id":"spn-52257","marks":["code"],"text":"retriever.ex"},{"id":"spn-52258","text":", "},{"id":"spn-52259","marks":["code"],"text":"learner.ex"},{"id":"spn-52260","text":", "},{"id":"spn-52261","marks":["code"],"text":"novelty_detector.ex"},{"id":"spn-52262","text":", graph CRUD, SQLite storage, outcome ingestion — ~80 unit tests"}]}],"id":"blk-45414","kind":"list-item"},{"blocks":[{"id":"blk-45417","kind":"paragraph","spans":[{"id":"spn-52263","marks":["bold"],"text":"UI status:"},{"id":"spn-52264","text":" mcp-only; Phoenix LiveView dashboard planned for server mode"}]}],"id":"blk-45416","kind":"list-item"},{"blocks":[{"id":"blk-45419","kind":"paragraph","spans":[{"id":"spn-52265","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-52266","text":" Graph growth timeline (node/edge count over N queries) with topic clusters"}]}],"id":"blk-45418","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45420","kind":"heading","level":2,"spans":[{"id":"spn-52267","text":"Story 2 · Detect contradictions and update confidence"}]},{"id":"blk-45421","items":[{"blocks":[{"id":"blk-45423","kind":"paragraph","spans":[{"id":"spn-52268","marks":["bold"],"text":"Persona:"},{"id":"spn-52269","text":" Scheduling agent learning meeting coordination"}]}],"id":"blk-45422","kind":"list-item"},{"blocks":[{"id":"blk-45425","kind":"paragraph","spans":[{"id":"spn-52270","marks":["bold"],"text":"Goal:"},{"id":"spn-52271","text":" Catch when learned policies conflict; adjust confidence based on outcomes"}]}],"id":"blk-45424","kind":"list-item"},{"blocks":[{"id":"blk-45427","kind":"paragraph","spans":[{"id":"spn-52272","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-52273","text":" Graph contains contradictory semantic nodes (e.g. \"book 9am slots\" vs \"9am always full\")"}]}],"id":"blk-45426","kind":"list-item"},{"blocks":[{"id":"blk-45429","kind":"paragraph","spans":[{"id":"spn-52274","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45428","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45430","kind":"paragraph","spans":[{"id":"spn-52275","text":"1. Agent retrieves policy nodes for next booking 2. Commits action based on retrieved confidences 3. Runtime reports outcome via "},{"id":"spn-52276","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-52277","text":" 4. Graphonomous creates "},{"id":"spn-52278","marks":["code"],"text":":outcome"},{"id":"spn-52279","text":" node + updates causal parents 5. Consolidator flags contradiction via "},{"id":"spn-52280","marks":["code"],"text":"belief.contradictions"}]},{"id":"blk-45431","items":[{"blocks":[{"id":"blk-45433","kind":"paragraph","spans":[{"id":"spn-52281","marks":["bold"],"text":"Success:"},{"id":"spn-52282","text":" Conflicting nodes flagged; both decrease confidence; agent requests clarification"}]}],"id":"blk-45432","kind":"list-item"},{"blocks":[{"id":"blk-45435","kind":"paragraph","spans":[{"id":"spn-52283","marks":["bold"],"text":"Covers:"},{"id":"spn-52284","text":" outcome grounding, causal attribution, "},{"id":"spn-52285","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-52286","text":", contradiction detector — ~40 unit tests"}]}],"id":"blk-45434","kind":"list-item"},{"blocks":[{"id":"blk-45437","kind":"paragraph","spans":[{"id":"spn-52287","marks":["bold"],"text":"UI status:"},{"id":"spn-52288","text":" mcp-only"}]}],"id":"blk-45436","kind":"list-item"},{"blocks":[{"id":"blk-45439","kind":"paragraph","spans":[{"id":"spn-52289","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-52290","text":" Contradiction report showing conflicting nodes + confidence delta"}]}],"id":"blk-45438","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45440","kind":"heading","level":2,"spans":[{"id":"spn-52291","text":"Story 3 · Install and replay a learned workflow"}]},{"id":"blk-45441","items":[{"blocks":[{"id":"blk-45443","kind":"paragraph","spans":[{"id":"spn-52292","marks":["bold"],"text":"Persona:"},{"id":"spn-52293","text":" Fleet admin rolling out proven maintenance procedure across machines"}]}],"id":"blk-45442","kind":"list-item"},{"blocks":[{"id":"blk-45445","kind":"paragraph","spans":[{"id":"spn-52294","marks":["bold"],"text":"Goal:"},{"id":"spn-52295","text":" Install a SkillCandidate from FleetPrompt; replay the learned workflow on destination agent"}]}],"id":"blk-45444","kind":"list-item"},{"blocks":[{"id":"blk-45447","kind":"paragraph","spans":[{"id":"spn-52296","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-52297","text":" SkillCandidate stored (via consolidation); agent-browser body available"}]}],"id":"blk-45446","kind":"list-item"},{"blocks":[{"id":"blk-45449","kind":"paragraph","spans":[{"id":"spn-52298","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45448","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45450","kind":"paragraph","spans":[{"id":"spn-52299","text":"1. Call "},{"id":"spn-52300","marks":["code"],"text":"body.browser.replay(Trace)"},{"id":"spn-52301","text":" on destination agent 2. For each state hash in trace: perceive + verify state match 3. On mismatch: fail-fast; on match: execute next action 4. Agent emits SurpriseSignal if forward model prediction diverges"}]},{"id":"blk-45451","items":[{"blocks":[{"id":"blk-45453","kind":"paragraph","spans":[{"id":"spn-52302","marks":["bold"],"text":"Success:"},{"id":"spn-52303","text":" Workflow executes on new machine; state hashes match; skill becomes persistent in destination graph"}]}],"id":"blk-45452","kind":"list-item"},{"blocks":[{"id":"blk-45455","kind":"paragraph","spans":[{"id":"spn-52304","marks":["bold"],"text":"Covers:"},{"id":"spn-52305","text":" trace replay, "},{"id":"spn-52306","marks":["code"],"text":"state_hash"},{"id":"spn-52307","text":" validation, SurpriseSignal emission, episodic node creation — ~30 unit tests"}]}],"id":"blk-45454","kind":"list-item"},{"blocks":[{"id":"blk-45457","kind":"paragraph","spans":[{"id":"spn-52308","marks":["bold"],"text":"UI status:"},{"id":"spn-52309","text":" mcp-only"}]}],"id":"blk-45456","kind":"list-item"},{"blocks":[{"id":"blk-45459","kind":"paragraph","spans":[{"id":"spn-52310","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-52311","text":" Side-by-side trace diff (Machine A original vs Machine B replay) with hash-match indicators"}]}],"id":"blk-45458","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45460","kind":"heading","level":2,"spans":[{"id":"spn-52312","text":"Story 4 · Run consolidation to prune low-confidence knowledge"}]},{"id":"blk-45461","items":[{"blocks":[{"id":"blk-45463","kind":"paragraph","spans":[{"id":"spn-52313","marks":["bold"],"text":"Persona:"},{"id":"spn-52314","text":" Backend service operator managing memory footprint"}]}],"id":"blk-45462","kind":"list-item"},{"blocks":[{"id":"blk-45465","kind":"paragraph","spans":[{"id":"spn-52315","marks":["bold"],"text":"Goal:"},{"id":"spn-52316","text":" Decay old knowledge, merge duplicates, promote stable facts"}]}],"id":"blk-45464","kind":"list-item"},{"blocks":[{"id":"blk-45467","kind":"paragraph","s