","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45480","kind":"heading","level":2,"spans":[{"id":"spn-52337","text":"Story 5 · Use coverage scoring to route high-stakes actions"}]},{"id":"blk-45481","items":[{"blocks":[{"id":"blk-45483","kind":"paragraph","spans":[{"id":"spn-52338","marks":["bold"],"text":"Persona:"},{"id":"spn-52339","text":" Governance-aware agent approving contract modifications"}]}],"id":"blk-45482","kind":"list-item"},{"blocks":[{"id":"blk-45485","kind":"paragraph","spans":[{"id":"spn-52340","marks":["bold"],"text":"Goal:"},{"id":"spn-52341","text":" Before destructive action, check if graph has adequate knowledge; escalate if gaps"}]}],"id":"blk-45484","kind":"list-item"},{"blocks":[{"id":"blk-45487","kind":"paragraph","spans":[{"id":"spn-52342","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-52343","text":" Task description available; relevant semantic nodes (may be sparse)"}]}],"id":"blk-45486","kind":"list-item"},{"blocks":[{"id":"blk-45489","kind":"paragraph","spans":[{"id":"spn-52344","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45488","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45490","kind":"paragraph","spans":[{"id":"spn-52345","text":"1. Agent calls "},{"id":"spn-52346","marks":["code"],"text":"coverage_query(\"approval of contract clause C1\")"},{"id":"spn-52347","text":" 2. Returns: "},{"id":"spn-52348","marks":["code"],"text":"relevant_nodes"},{"id":"spn-52349","text":", "},{"id":"spn-52350","marks":["code"],"text":"coverage_score"},{"id":"spn-52351","text":" (0-1), "},{"id":"spn-52352","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-52353","text":", "},{"id":"spn-52354","marks":["code"],"text":"recommendation"},{"id":"spn-52355","text":" 3. If coverage ≥ 0.85 + recommendation=\"act\" → proceed 4. If coverage < 0.85 + recommendation=\"learn_first\" → retrieve more context 5. If recommendation=\"escalate\" → route to Delegatic or human"}]},{"id":"blk-45491","items":[{"blocks":[{"id":"bl