","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44994","kind":"heading","level":2,"spans":[{"id":"spn-51163","text":"Story 5 · Use coverage scoring to route high-stakes actions"}]},{"id":"blk-44995","items":[{"blocks":[{"id":"blk-44997","kind":"paragraph","spans":[{"id":"spn-51164","marks":["bold"],"text":"Persona:"},{"id":"spn-51165","text":" Governance-aware agent approving contract modifications"}]}],"id":"blk-44996","kind":"list-item"},{"blocks":[{"id":"blk-44999","kind":"paragraph","spans":[{"id":"spn-51166","marks":["bold"],"text":"Goal:"},{"id":"spn-51167","text":" Before destructive action, check if graph has adequate knowledge; escalate if gaps"}]}],"id":"blk-44998","kind":"list-item"},{"blocks":[{"id":"blk-45001","kind":"paragraph","spans":[{"id":"spn-51168","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-51169","text":" Task description available; relevant semantic nodes (may be sparse)"}]}],"id":"blk-45000","kind":"list-item"},{"blocks":[{"id":"blk-45003","kind":"paragraph","spans":[{"id":"spn-51170","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45002","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45004","kind":"paragraph","spans":[{"id":"spn-51171","text":"1. Agent calls "},{"id":"spn-51172","marks":["code"],"text":"coverage_query(\"approval of contract clause C1\")"},{"id":"spn-51173","text":" 2. Returns: "},{"id":"spn-51174","marks":["code"],"text":"relevant_nodes"},{"id":"spn-51175","text":", "},{"id":"spn-51176","marks":["code"],"text":"coverage_score"},{"id":"spn-51177","text":" (0-1), "},{"id":"spn-51178","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-51179","text":", "},{"id":"spn-51180","marks":["code"],"text":"recommendation"},{"id":"spn-51181","text":" 3. If coverage ≥ 0.85 + recommendation=\"act\" → proceed 4. If coverage < 0.85 + recommendation=\"learn_first\" → retrieve more context 5. If recommendation=\"escalate\" → route to Delegatic or human"}]},{"id":"blk-45005","items":[{"blocks":[{"id":"bl