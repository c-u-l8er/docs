","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44884","kind":"heading","level":2,"spans":[{"id":"spn-50534","text":"Story 5 · Use coverage scoring to route high-stakes actions"}]},{"id":"blk-44885","items":[{"blocks":[{"id":"blk-44887","kind":"paragraph","spans":[{"id":"spn-50535","marks":["bold"],"text":"Persona:"},{"id":"spn-50536","text":" Governance-aware agent approving contract modifications"}]}],"id":"blk-44886","kind":"list-item"},{"blocks":[{"id":"blk-44889","kind":"paragraph","spans":[{"id":"spn-50537","marks":["bold"],"text":"Goal:"},{"id":"spn-50538","text":" Before destructive action, check if graph has adequate knowledge; escalate if gaps"}]}],"id":"blk-44888","kind":"list-item"},{"blocks":[{"id":"blk-44891","kind":"paragraph","spans":[{"id":"spn-50539","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-50540","text":" Task description available; relevant semantic nodes (may be sparse)"}]}],"id":"blk-44890","kind":"list-item"},{"blocks":[{"id":"blk-44893","kind":"paragraph","spans":[{"id":"spn-50541","marks":["bold"],"text":"Steps:"}]}],"id":"blk-44892","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44894","kind":"paragraph","spans":[{"id":"spn-50542","text":"1. Agent calls "},{"id":"spn-50543","marks":["code"],"text":"coverage_query(\"approval of contract clause C1\")"},{"id":"spn-50544","text":" 2. Returns: "},{"id":"spn-50545","marks":["code"],"text":"relevant_nodes"},{"id":"spn-50546","text":", "},{"id":"spn-50547","marks":["code"],"text":"coverage_score"},{"id":"spn-50548","text":" (0-1), "},{"id":"spn-50549","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-50550","text":", "},{"id":"spn-50551","marks":["code"],"text":"recommendation"},{"id":"spn-50552","text":" 3. If coverage ≥ 0.85 + recommendation=\"act\" → proceed 4. If coverage < 0.85 + recommendation=\"learn_first\" → retrieve more context 5. If recommendation=\"escalate\" → route to Delegatic or human"}]},{"id":"blk-44895","items":[{"blocks":[{"id":"bl