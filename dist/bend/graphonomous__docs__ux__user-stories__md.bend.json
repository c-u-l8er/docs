","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45966","kind":"heading","level":2,"spans":[{"id":"spn-53457","text":"Story 5 · Use coverage scoring to route high-stakes actions"}]},{"id":"blk-45967","items":[{"blocks":[{"id":"blk-45969","kind":"paragraph","spans":[{"id":"spn-53458","marks":["bold"],"text":"Persona:"},{"id":"spn-53459","text":" Governance-aware agent approving contract modifications"}]}],"id":"blk-45968","kind":"list-item"},{"blocks":[{"id":"blk-45971","kind":"paragraph","spans":[{"id":"spn-53460","marks":["bold"],"text":"Goal:"},{"id":"spn-53461","text":" Before destructive action, check if graph has adequate knowledge; escalate if gaps"}]}],"id":"blk-45970","kind":"list-item"},{"blocks":[{"id":"blk-45973","kind":"paragraph","spans":[{"id":"spn-53462","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-53463","text":" Task description available; relevant semantic nodes (may be sparse)"}]}],"id":"blk-45972","kind":"list-item"},{"blocks":[{"id":"blk-45975","kind":"paragraph","spans":[{"id":"spn-53464","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45974","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45976","kind":"paragraph","spans":[{"id":"spn-53465","text":"1. Agent calls "},{"id":"spn-53466","marks":["code"],"text":"coverage_query(\"approval of contract clause C1\")"},{"id":"spn-53467","text":" 2. Returns: "},{"id":"spn-53468","marks":["code"],"text":"relevant_nodes"},{"id":"spn-53469","text":", "},{"id":"spn-53470","marks":["code"],"text":"coverage_score"},{"id":"spn-53471","text":" (0-1), "},{"id":"spn-53472","marks":["code"],"text":"knowledge_gaps"},{"id":"spn-53473","text":", "},{"id":"spn-53474","marks":["code"],"text":"recommendation"},{"id":"spn-53475","text":" 3. If coverage ≥ 0.85 + recommendation=\"act\" → proceed 4. If coverage < 0.85 + recommendation=\"learn_first\" → retrieve more context 5. If recommendation=\"escalate\" → route to Delegatic or human"}]},{"id":"blk-45977","items":[{"blocks":[{"id":"bl