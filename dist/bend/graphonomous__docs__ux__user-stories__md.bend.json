{"bendscript":"0.1","blocks":[{"id":"blk-45882","kind":"heading","level":1,"spans":[{"id":"spn-53353","text":"Graphonomous — User Stories"}]},{"id":"blk-45883","kind":"paragraph","spans":[{"id":"spn-53354","text":"Canonical user-story catalog. Used for Playwright tests (via MCP inspector pattern) + Claude Design input for a future visualization UI (likely hosted on RuneFort)."}]},{"id":"blk-45884","kind":"paragraph","spans":[{"id":"spn-53355","marks":["bold"],"text":"Scope:"},{"id":"spn-53356","text":" Continual-learning knowledge-graph engine. MCP-only today; web visualizer planned. "},{"id":"spn-53357","marks":["bold"],"text":"Unit-test surface covered:"},{"id":"spn-53358","text":" "},{"id":"spn-53359","marks":["code"],"text":"test/**"},{"id":"spn-53360","text":" (573 tests)."}]},{"id":"blk-45885","kind":"paragraph","spans":[{"id":"spn-53361","text":"---"}]},{"id":"blk-45886","kind":"heading","level":2,"spans":[{"id":"spn-53362","text":"Story 1 · Agent learns from user queries over time"}]},{"id":"blk-45887","items":[{"blocks":[{"id":"blk-45889","kind":"paragraph","spans":[{"id":"spn-53363","marks":["bold"],"text":"Persona:"},{"id":"spn-53364","text":" Device manufacturer embedding LLMs on IoT hardware"}]}],"id":"blk-45888","kind":"list-item"},{"blocks":[{"id":"blk-45891","kind":"paragraph","spans":[{"id":"spn-53365","marks":["bold"],"text":"Goal:"},{"id":"spn-53366","text":" Deploy a 3B-param model on edge that improves over time without retraining"}]}],"id":"blk-45890","kind":"list-item"},{"blocks":[{"id":"blk-45893","kind":"paragraph","spans":[{"id":"spn-53367","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-53368","text":" Model on device; SQLite local; MCP stdio available"}]}],"id":"blk-45892","kind":"list-item"},{"blocks":[{"id":"blk-45895","kind":"paragraph","spans":[{"id":"spn-53369","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45894","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45896","kind":"paragraph","spans":[{"id":"spn-53370","text":"1. Initialize Graphonomous: "},{"id":"spn-53371","marks":["code"],"text":"mix run -- --db ~/.graphonomous/knowledge.db"},{"id":"spn-53372","text":" 2. Agent receives query: \"How do I set the temperature?\" 3. Retriever injects relevant graph context (prior queries, procedures, facts) 4. LLM generates response (inference external — Graphonomous doesn't run it) 5. Learner extracts entities/relationships → new nodes, updated edges 6. System records outcome signal (success? user satisfied?)"}]},{"id":"blk-45897","items":[{"blocks":[{"id":"blk-45899","kind":"paragraph","spans":[{"id":"spn-53373","marks":["bold"],"text":"Success:"},{"id":"spn-53374","text":" After ~100 queries, graph contains domain-specific knowledge; similar questions answered faster"}]}],"id":"blk-45898","kind":"list-item"},{"blocks":[{"id":"blk-45901","kind":"paragraph","spans":[{"id":"spn-53375","marks":["bold"],"text":"Covers:"},{"id":"spn-53376","text":" "},{"id":"spn-53377","marks":["code"],"text":"retriever.ex"},{"id":"spn-53378","text":", "},{"id":"spn-53379","marks":["code"],"text":"learner.ex"},{"id":"spn-53380","text":", "},{"id":"spn-53381","marks":["code"],"text":"novelty_detector.ex"},{"id":"spn-53382","text":", graph CRUD, SQLite storage, outcome ingestion — ~80 unit tests"}]}],"id":"blk-45900","kind":"list-item"},{"blocks":[{"id":"blk-45903","kind":"paragraph","spans":[{"id":"spn-53383","marks":["bold"],"text":"UI status:"},{"id":"spn-53384","text":" mcp-only; Phoenix LiveView dashboard planned for server mode"}]}],"id":"blk-45902","kind":"list-item"},{"blocks":[{"id":"blk-45905","kind":"paragraph","spans":[{"id":"spn-53385","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-53386","text":" Graph growth timeline (node/edge count over N queries) with topic clusters"}]}],"id":"blk-45904","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45906","kind":"heading","level":2,"spans":[{"id":"spn-53387","text":"Story 2 · Detect contradictions and update confidence"}]},{"id":"blk-45907","items":[{"blocks":[{"id":"blk-45909","kind":"paragraph","spans":[{"id":"spn-53388","marks":["bold"],"text":"Persona:"},{"id":"spn-53389","text":" Scheduling agent learning meeting coordination"}]}],"id":"blk-45908","kind":"list-item"},{"blocks":[{"id":"blk-45911","kind":"paragraph","spans":[{"id":"spn-53390","marks":["bold"],"text":"Goal:"},{"id":"spn-53391","text":" Catch when learned policies conflict; adjust confidence based on outcomes"}]}],"id":"blk-45910","kind":"list-item"},{"blocks":[{"id":"blk-45913","kind":"paragraph","spans":[{"id":"spn-53392","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-53393","text":" Graph contains contradictory semantic nodes (e.g. \"book 9am slots\" vs \"9am always full\")"}]}],"id":"blk-45912","kind":"list-item"},{"blocks":[{"id":"blk-45915","kind":"paragraph","spans":[{"id":"spn-53394","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45914","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45916","kind":"paragraph","spans":[{"id":"spn-53395","text":"1. Agent retrieves policy nodes for next booking 2. Commits action based on retrieved confidences 3. Runtime reports outcome via "},{"id":"spn-53396","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-53397","text":" 4. Graphonomous creates "},{"id":"spn-53398","marks":["code"],"text":":outcome"},{"id":"spn-53399","text":" node + updates causal parents 5. Consolidator flags contradiction via "},{"id":"spn-53400","marks":["code"],"text":"belief.contradictions"}]},{"id":"blk-45917","items":[{"blocks":[{"id":"blk-45919","kind":"paragraph","spans":[{"id":"spn-53401","marks":["bold"],"text":"Success:"},{"id":"spn-53402","text":" Conflicting nodes flagged; both decrease confidence; agent requests clarification"}]}],"id":"blk-45918","kind":"list-item"},{"blocks":[{"id":"blk-45921","kind":"paragraph","spans":[{"id":"spn-53403","marks":["bold"],"text":"Covers:"},{"id":"spn-53404","text":" outcome grounding, causal attribution, "},{"id":"spn-53405","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-53406","text":", contradiction detector — ~40 unit tests"}]}],"id":"blk-45920","kind":"list-item"},{"blocks":[{"id":"blk-45923","kind":"paragraph","spans":[{"id":"spn-53407","marks":["bold"],"text":"UI status:"},{"id":"spn-53408","text":" mcp-only"}]}],"id":"blk-45922","kind":"list-item"},{"blocks":[{"id":"blk-45925","kind":"paragraph","spans":[{"id":"spn-53409","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-53410","text":" Contradiction report showing conflicting nodes + confidence delta"}]}],"id":"blk-45924","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45926","kind":"heading","level":2,"spans":[{"id":"spn-53411","text":"Story 3 · Install and replay a learned workflow"}]},{"id":"blk-45927","items":[{"blocks":[{"id":"blk-45929","kind":"paragraph","spans":[{"id":"spn-53412","marks":["bold"],"text":"Persona:"},{"id":"spn-53413","text":" Fleet admin rolling out proven maintenance procedure across machines"}]}],"id":"blk-45928","kind":"list-item"},{"blocks":[{"id":"blk-45931","kind":"paragraph","spans":[{"id":"spn-53414","marks":["bold"],"text":"Goal:"},{"id":"spn-53415","text":" Install a SkillCandidate from FleetPrompt; replay the learned workflow on destination agent"}]}],"id":"blk-45930","kind":"list-item"},{"blocks":[{"id":"blk-45933","kind":"paragraph","spans":[{"id":"spn-53416","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-53417","text":" SkillCandidate stored (via consolidation); agent-browser body available"}]}],"id":"blk-45932","kind":"list-item"},{"blocks":[{"id":"blk-45935","kind":"paragraph","spans":[{"id":"spn-53418","marks":["bold"],"text":"Steps:"}]}],"id":"blk-45934","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45936","kind":"paragraph","spans":[{"id":"spn-53419","text":"1. Call "},{"id":"spn-53420","marks":["code"],"text":"body.browser.replay(Trace)"},{"id":"spn-53421","text":" on destination agent 2. For each state hash in trace: perceive + verify state match 3. On mismatch: fail-fast; on match: execute next action 4. Agent emits SurpriseSignal if forward model prediction diverges"}]},{"id":"blk-45937","items":[{"blocks":[{"id":"blk-45939","kind":"paragraph","spans":[{"id":"spn-53422","marks":["bold"],"text":"Success:"},{"id":"spn-53423","text":" Workflow executes on new machine; state hashes match; skill becomes persistent in destination graph"}]}],"id":"blk-45938","kind":"list-item"},{"blocks":[{"id":"blk-45941","kind":"paragraph","spans":[{"id":"spn-53424","marks":["bold"],"text":"Covers:"},{"id":"spn-53425","text":" trace replay, "},{"id":"spn-53426","marks":["code"],"text":"state_hash"},{"id":"spn-53427","text":" validation, SurpriseSignal emission, episodic node creation — ~30 unit tests"}]}],"id":"blk-45940","kind":"list-item"},{"blocks":[{"id":"blk-45943","kind":"paragraph","spans":[{"id":"spn-53428","marks":["bold"],"text":"UI status:"},{"id":"spn-53429","text":" mcp-only"}]}],"id":"blk-45942","kind":"list-item"},{"blocks":[{"id":"blk-45945","kind":"paragraph","spans":[{"id":"spn-53430","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-53431","text":" Side-by-side trace diff (Machine A original vs Machine B replay) with hash-match indicators"}]}],"id":"blk-45944","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45946","kind":"heading","level":2,"spans":[{"id":"spn-53432","text":"Story 4 · Run consolidation to prune low-confidence knowledge"}]},{"id":"blk-45947","items":[{"blocks":[{"id":"blk-45949","kind":"paragraph","spans":[{"id":"spn-53433","marks":["bold"],"text":"Persona:"},{"id":"spn-53434","text":" Backend service operator managing memory footprint"}]}],"id":"blk-45948","kind":"list-item"},{"blocks":[{"id":"blk-45951","kind":"paragraph","spans":[{"id":"spn-53435","marks":["bold"],"text":"Goal:"},{"id":"spn-53436","text":" Decay old knowledge, merge duplicates, promote stable facts"}]}],"id":"blk-45950","kind":"list-item"},{"blocks":[{"id":"blk-45953","kind":"paragraph","s