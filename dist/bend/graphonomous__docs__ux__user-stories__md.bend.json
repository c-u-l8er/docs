{"bendscript":"0.1","blocks":[{"id":"blk-44910","kind":"heading","level":1,"spans":[{"id":"spn-51059","text":"Graphonomous — User Stories"}]},{"id":"blk-44911","kind":"paragraph","spans":[{"id":"spn-51060","text":"Canonical user-story catalog. Used for Playwright tests (via MCP inspector pattern) + Claude Design input for a future visualization UI (likely hosted on RuneFort)."}]},{"id":"blk-44912","kind":"paragraph","spans":[{"id":"spn-51061","marks":["bold"],"text":"Scope:"},{"id":"spn-51062","text":" Continual-learning knowledge-graph engine. MCP-only today; web visualizer planned. "},{"id":"spn-51063","marks":["bold"],"text":"Unit-test surface covered:"},{"id":"spn-51064","text":" "},{"id":"spn-51065","marks":["code"],"text":"test/**"},{"id":"spn-51066","text":" (573 tests)."}]},{"id":"blk-44913","kind":"paragraph","spans":[{"id":"spn-51067","text":"---"}]},{"id":"blk-44914","kind":"heading","level":2,"spans":[{"id":"spn-51068","text":"Story 1 · Agent learns from user queries over time"}]},{"id":"blk-44915","items":[{"blocks":[{"id":"blk-44917","kind":"paragraph","spans":[{"id":"spn-51069","marks":["bold"],"text":"Persona:"},{"id":"spn-51070","text":" Device manufacturer embedding LLMs on IoT hardware"}]}],"id":"blk-44916","kind":"list-item"},{"blocks":[{"id":"blk-44919","kind":"paragraph","spans":[{"id":"spn-51071","marks":["bold"],"text":"Goal:"},{"id":"spn-51072","text":" Deploy a 3B-param model on edge that improves over time without retraining"}]}],"id":"blk-44918","kind":"list-item"},{"blocks":[{"id":"blk-44921","kind":"paragraph","spans":[{"id":"spn-51073","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-51074","text":" Model on device; SQLite local; MCP stdio available"}]}],"id":"blk-44920","kind":"list-item"},{"blocks":[{"id":"blk-44923","kind":"paragraph","spans":[{"id":"spn-51075","marks":["bold"],"text":"Steps:"}]}],"id":"blk-44922","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44924","kind":"paragraph","spans":[{"id":"spn-51076","text":"1. Initialize Graphonomous: "},{"id":"spn-51077","marks":["code"],"text":"mix run -- --db ~/.graphonomous/knowledge.db"},{"id":"spn-51078","text":" 2. Agent receives query: \"How do I set the temperature?\" 3. Retriever injects relevant graph context (prior queries, procedures, facts) 4. LLM generates response (inference external — Graphonomous doesn't run it) 5. Learner extracts entities/relationships → new nodes, updated edges 6. System records outcome signal (success? user satisfied?)"}]},{"id":"blk-44925","items":[{"blocks":[{"id":"blk-44927","kind":"paragraph","spans":[{"id":"spn-51079","marks":["bold"],"text":"Success:"},{"id":"spn-51080","text":" After ~100 queries, graph contains domain-specific knowledge; similar questions answered faster"}]}],"id":"blk-44926","kind":"list-item"},{"blocks":[{"id":"blk-44929","kind":"paragraph","spans":[{"id":"spn-51081","marks":["bold"],"text":"Covers:"},{"id":"spn-51082","text":" "},{"id":"spn-51083","marks":["code"],"text":"retriever.ex"},{"id":"spn-51084","text":", "},{"id":"spn-51085","marks":["code"],"text":"learner.ex"},{"id":"spn-51086","text":", "},{"id":"spn-51087","marks":["code"],"text":"novelty_detector.ex"},{"id":"spn-51088","text":", graph CRUD, SQLite storage, outcome ingestion — ~80 unit tests"}]}],"id":"blk-44928","kind":"list-item"},{"blocks":[{"id":"blk-44931","kind":"paragraph","spans":[{"id":"spn-51089","marks":["bold"],"text":"UI status:"},{"id":"spn-51090","text":" mcp-only; Phoenix LiveView dashboard planned for server mode"}]}],"id":"blk-44930","kind":"list-item"},{"blocks":[{"id":"blk-44933","kind":"paragraph","spans":[{"id":"spn-51091","marks":["bold"],"text":"Claude Design hook:"},{"id":"spn-51092","text":" Graph growth timeline (node/edge count over N queries) with topic clusters"}]}],"id":"blk-44932","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44934","kind":"heading","level":2,"spans":[{"id":"spn-51093","text":"Story 2 · Detect contradictions and update confidence"}]},{"id":"blk-44935","items":[{"blocks":[{"id":"blk-44937","kind":"paragraph","spans":[{"id":"spn-51094","marks":["bold"],"text":"Persona:"},{"id":"spn-51095","text":" Scheduling agent learning meeting coordination"}]}],"id":"blk-44936","kind":"list-item"},{"blocks":[{"id":"blk-44939","kind":"paragraph","spans":[{"id":"spn-51096","marks":["bold"],"text":"Goal:"},{"id":"spn-51097","text":" Catch when learned policies conflict; adjust confidence based on outcomes"}]}],"id":"blk-44938","kind":"list-item"},{"blocks":[{"id":"blk-44941","kind":"paragraph","spans":[{"id":"spn-51098","marks":["bold"],"text":"Prerequisite:"},{"id":"spn-51099","text":" Graph contains contradictory semantic nodes (e.g. \"book 9am slots\" vs \"9am always full\")"}]}],"id":"blk-44940","kind":"list-item"},{"blocks":[{"id":"blk-44943","kind":"paragraph","spans":[{"id":"spn-51100","marks":["bold"],"text":"Steps:"}]}],"id":"blk-44942","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-44944","kind":"paragraph","spans":[{"id":"spn-51101","text":"1. Agent retrieves policy nodes for next booking 2. Commits action based on retrieved confidences 3. Runtime reports outcome via "},{"id":"spn-51102","marks":["code"],"text":"learn.from_outcome"},{"id":"spn-51103","text":" 4. Graphonomous creates "},{"id":"spn-51104","marks":["code"],"text":":outcome"},{"id":"spn-51105","text":" node + updates causal parents 5. Consolidator flags contradiction via "},{"id":"spn-51106","marks":["code"],"text":"belief.contradictions"}]},{"id":"blk-44945","items":[{"blocks":[{"id":"blk-44947","kind":"paragraph","spans":[{"id":"spn-51107","marks":["bold"],"text":"Success:"},{"id":"spn-51108","text":" Conflicting nodes flagged; both decrease confidence; agent requests clarification"}]}],"id":"blk-44946","kind":"list-item"},{"blocks":[{"id":"blk-44949","kind":"paragraph","spans":[{"id":"spn-51109","marks":["bold"],"text":"Covers:"},{"id":"spn-51110","text":" outcome grounding, causal attribution, "},{"id":"spn-51111","mark