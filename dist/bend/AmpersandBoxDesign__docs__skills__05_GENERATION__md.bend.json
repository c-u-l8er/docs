{"bendscript":"0.1","blocks":[{"id":"blk-16679","kind":"heading","level":1,"spans":[{"id":"spn-14745","text":"Skill 05 — Generation"}]},{"blocks":[{"id":"blk-16681","kind":"paragraph","spans":[{"id":"spn-14746","text":"Compiling agent declarations into MCP server configurations and A2A agent cards. The \"from spec to running agent\" path."}]}],"id":"blk-16680","kind":"quote"},{"id":"blk-16682","kind":"heading","level":2,"spans":[{"id":"spn-14747","text":"Why This Matters"}]},{"id":"blk-16683","kind":"paragraph","spans":[{"id":"spn-14748","text":"Generation is the payoff. A validated, composed "},{"id":"spn-14749","marks":["code"],"text":"ampersand.json"},{"id":"spn-14750","text":" compiles into runtime artifacts that existing protocols understand. This is how [&] complements MCP and A2A without replacing either."}]},{"id":"blk-16684","kind":"code","language":"text","text":"ampersand.json → ampersand generate → mcp-config.json + agent-card.json"},{"id":"blk-16685","kind":"heading","level":2,"spans":[{"id":"spn-14751","text":"Generating MCP Configuration"}]},{"id":"blk-16686","kind":"heading","level":3,"spans":[{"id":"spn-14752","text":"Command"}]},{"id":"blk-16687","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json"},{"id":"blk-16688","kind":"heading","level":3,"spans":[{"id":"spn-14753","text":"What It Produces"}]},{"id":"blk-16689","kind":"paragraph","spans":[{"id":"spn-14754","text":"An MCP server configuration that wires up the declared capability providers as MCP tools and resources:"}]},{"id":"blk-16690","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--instance\", \"infra-ops\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\n        \"store_node\", \"store_edge\", \"retrieve_context\",\n        \"topology_analyze\", \"deliberate\"\n      ],\n      \"resources\": [\"graphonomous://runtime/health\"]\n    },\n    \"ticktickclock\": {\n      \"command\": \"ticktickclock\",\n      \"args\": [\"--streams\", \"cpu,mem\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\"detect_anomaly\", \"enrich_context\", \"learn_observation\"]\n    },\n    \"deliberatic\": {\n      \"command\": \"deliberatic\",\n      \"args\": [\"--governance\", \"constitutional\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\"evaluate_argument\", \"structured_vote\"]\n    }\n  }\n}"},{"id":"blk-16691","kind":"heading","level":3,"spans":[{"id":"spn-14755","text":"How Capabilities Map to MCP Tools"}]},{"id":"blk-16692","kind":"paragraph","spans":[{"id":"spn-14756","text":"Each capability's operations become MCP tools:"}]},{"head":[{"id":"blk-16694","spans":[{"id":"spn-14757","text":"Capability"}]},{"id":"blk-16695","spans":[{"id":"spn-14758","text":"Operations"}]},{"id":"blk-16696","spans":[{"id":"spn-14759","text":"MCP Tools"}]}],"id":"blk-16693","kind":"table","rows":[[{"id":"blk-16697","spans":[{"id":"spn-14760","marks":["code"],"text":"&memory.graph"}]},{"id":"blk-16698","spans":[{"id":"spn-14761","marks":["code"],"text":"recall"},{"id":"spn-14762","text":", "},{"id":"spn-14763","marks":["code"],"text":"store"},{"id":"spn-14764","text":", "},{"id":"spn-14765","marks":["code"],"text":"enrich"},{"id":"spn-14766","text":", "},{"id":"spn-14767","marks":["code"],"text":"topology"}]},{"id":"blk-16699","spans":[{"id":"spn-14768","marks":["code"],"text":"retrieve_context"},{"id":"spn-14769","text":", "},{"id":"spn-14770","marks":["code"],"text":"store_node"},{"id":"spn-14771","text":", "},{"id":"spn-14772","marks":["code"],"text":"store_edge"},{"id":"spn-14773","text":", "},{"id":"spn-14774","marks":["code"],"text":"topology_analyze"}]}],[{"id":"blk-16700","spans":[{"id":"spn-14775","marks":["code"],"text":"&time.anomaly"}]},{"id":"blk-16701","spans":[{"id":"spn-14776","marks":["code"],"text":"detect"},{"id":"spn-14777","text":", "},{"id":"spn-14778","marks":["code"],"text":"enrich"},{"id":"spn-14779","text":", "},{"id":"spn-14780","marks":["code"],"text":"learn"}]},{"id":"blk-16702","spans":[{"id":"spn-14781","marks":["code"],"text":"detect_anomaly"},{"id":"spn-14782","text":", "},{"id":"spn-14783","marks":["code"],"text":"enrich_context"},{"id":"spn-14784","text":", "},{"id":"spn-14785","marks":["code"],"text":"learn_observation"}]}],[{"id":"blk-16703","spans":[{"id":"spn-14786","marks":["code"],"text":"&reason.argument"}]},{"id":"blk-16704","spans":[{"id":"spn-14787","marks":["code"],"text":"evaluate"},{"id":"spn-14788","text":", "},{"id":"spn-14789","marks":["code"],"text":"vote"}]},{"id":"blk-16705","spans":[{"id":"spn-14790","marks":["code"],"text":"evaluate_argument"},{"id":"spn-14791","text":", "},{"id":"spn-14792","marks":["code"],"text":"structured_vote"}]}],[{"id":"blk-16706","spans":[{"id":"spn-14793","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-16707","spans":[{"id":"spn-14794","marks":["code"],"text":"deliberate"},{"id":"spn-14795","text":", "},{"id":"spn-14796","marks":["code"],"text":"decompose"},{"id":"spn-14797","text":", "},{"id":"spn-14798","marks":["code"],"text":"reconcile"}]},{"id":"blk-16708","spans":[{"id":"spn-14799","marks":["code"],"text":"deliberate"},{"id":"spn-14800","text":", "},{"id":"spn-14801","marks":["code"],"text":"decompose_topology"},{"id":"spn-14802","text":", "},{"id":"spn-14803","marks":["code"],"text":"reconcile_conclusions"}]}],[{"id":"blk-16709","spans":[{"id":"spn-14804","marks":["code"],"text":"&reason.attend"}]},{"id":"blk-16710","spans":[{"id":"spn-14805","marks":["code"],"text":"survey"},{"id":"spn-14806","text":", "},{"id":"spn-14807","marks":["code"],"text":"triage"},{"id":"spn-14808","text":", "},{"id":"spn-14809","marks":["code"],"text":"dispatch"}]},{"id":"blk-16711","spans":[{"id":"spn-14810","marks":["code"],"text":"attention_survey"},{"id":"spn-14811","text":", "},{"id":"spn-14812","marks":["code"],"text":"attention_triage"},{"id":"spn-14813","text":", "},{"id":"spn-14814","marks":["code"],"text":"attention_run_cycle"}]}]]},{"id":"blk-16712","kind":"paragraph","spans":[{"id":"spn-14815","text":"The mapping is defined in each capability's contract. The generator reads the contract and emits the corresponding MCP tool registrations."}]},{"id":"blk-16713","kind":"heading","level":2,"spans":[{"id":"spn-14816","text":"Generating A2A Agent Cards"}]},{"id":"blk-16714","kind":"heading","level":3,"spans":[{"id":"spn-14817","text":"Command"}]},{"id":"blk-16715","kind":"code","language":"bash","text":"./ampersand generate a2a agent.ampersand.json"},{"id":"blk-16716","kind":"heading","level":3,"spans":[{"id":"spn-14818","text":"What It Produces"}]},{"id":"blk-16717","kind":"paragraph","spans":[{"id":"spn-14819","text":"An A2A agent card suitable for "},{"id":"spn-14820","marks":["code"],"text":"/.well-known/agent.json"},{"id":"spn-14821","text":":"}]},{"id":"blk-16718","kind":"code","language":"json","text":"{\n  \"name\": \"InfraOperator\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Infrastructure operations agent with graph memory, temporal anomaly detection, fleet awareness, and deliberative reasoning.\",\n  \"skills\": [\n    {\n      \"id\": \"temporal-anomaly-detection\",\n      \"name\": \"Temporal Anomaly Detection\",\n      \"description\": \"Detect anomalous events in temporal data streams.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    },\n    {\n      \"id\": \"topology-aware-deliberation\",\n      \"name\": \"Topology-Aware Deliberation\",\n      \"description\": \"Focused reasoning through knowledge graph cycles.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    },\n    {\n      \"id\": \"fleet-spatial-awareness\",\n      \"name\": \"Fleet Spatial Awareness\",\n      \"description\": \"Geospatial fleet tracking and geofence management.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    }\n  ],\n  \"capabilities\": {\n    \"streaming\": false,\n    \"pushNotifications\": false\n  }\n}"},{"id":"blk-16719","kind":"heading","level":3,"spans":[{"id":"spn-14822","text":"How Capabilities Map to A2A Skills"}]},{"id":"blk-16720","kind":"paragraph","spans":[{"id":"spn-14823","text":"Each capability contract includes an "},{"id":"spn-14824","marks":["code"],"text":"a2a_skills"},{"id":"spn-14825","text":" field that defines the skill identifiers exposed via A2A:"}]},{"head":[{"id":"blk-16722","spans":[{"id":"spn-14826","text":"Capability"}]},{"id":"blk-16723","spans":[{"id":"spn-14827","marks":["code"],"text":"a2a_skills"}]},{"id":"blk-16724","spans":[{"id":"spn-14828","text":"A2A Skill Entry"}]}],"id":"blk-16721","kind":"table","rows":[[{"id":"blk-16725","spans":[{"id":"spn-14829","marks":["code"],"text":"&time.anomaly"}]},{"id":"blk-16726","spans":[{"id":"spn-14830","marks":["code"],"text":"[\"temporal-anomaly-detection\"]"}]},{"id":"blk-16727","spans":[{"id":"spn-14831","text":"Temporal anomaly detection skill"}]}],[{"id":"blk-16728","spans":[{"id":"spn-14832","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-16729","spans":[{"id":"spn-14833","marks":["code"],"text":"[\"topology-aware-deliberation\"]"}]},{"id":"blk-16730","spans":[{"id":"spn-14834","text":"Deliberation skill"}]}],[{"id":"blk-16731","spans":[{"id":"spn-14835","marks":["code"],"text":"&space.fleet"}]},{"id":"blk-16732","spans":[{"id":"spn-14836","marks":["code"],"text":"[\"fleet-spatial-awareness\"]"}]},{"id":"blk-16733","spans":[{"id":"spn-14837","text":"Fleet tracking skill"}]}]]},{"id":"blk-16734","kind":"heading","level":2,"spans":[{"id":"spn-14838","text":"Output Options"}]},{"id":"blk-16735","kind":"heading","level":3,"spans":[{"id":"spn-14839","text":"Write to file"}]},{"id":"blk-16736","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --output mcp-config.json\n./ampersand generate a2a agent.ampersand.json --output agent-card.json"},{"id":"blk-16737","kind":"heading","level":3,"spans":[{"id":"spn-14840","text":"Write to stdout (default)"}]},{"id":"blk-16738","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json | jq ."},{"id":"blk-16739","kind":"heading","level":3,"spans":[{"id":"spn-14841","text":"Compact output"}]},{"id":"blk-16740","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --compact"},{"id":"blk-16741","kind":"heading","level":2,"spans":[{"id":"spn-14842","text":"Generation Pipeline"}]},{"id":"blk-16742","kind":"paragraph","spans":[{"id":"spn-14843","text":"Generation runs after validation and composition. The full sequence:"}]},{"id":"blk-16743","kind":"code","language":"text","text":"1. Parse ampersand.json\n2. Validate against schema (same as `validate`)\n3. Compose and check type safety (same as `compose`)\n4. Resolve providers from registry\n5. Load capability contracts for each provider\n6. Map operations → MCP tools or A2A skills\n7. Emit output artifact"},{"id":"blk-16744","kind":"paragraph","spans":[{"id":"spn-14844","text":"If validation or composition fails, generation aborts with the relevant errors. You do not need to run "},{"id":"spn-14845","marks":["code"],"text":"validate"},{"id":"spn-14846","text":" and "},{"id":"spn-14847","marks":["code"],"text":"compose"},{"id":"spn-14848","text":" separately before "},{"id":"spn-14849","marks":["code"],"text":"generate"},{"id":"spn-14850","text":" — the command includes both checks."}]},{"id":"blk-16745","kind":"heading","level":2,"spans":[{"id":"spn-14851","text":"Custom Generation"}]},{"id":"blk-16746","kind":"heading","level":3,"spans":[{"id":"spn-14852","text":"Provider overrides"}]},{"id":"blk-16747","kind":"paragraph","spans":[{"id":"spn-14853","text":"Override providers at generation time without modifying the declaration:"}]},{"id":"blk-16748","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json \\\n  --provider \"&memory.graph=custom-graph-service\""},{"id":"blk-16749","kind":"heading","level":3,"spans":[{"id":"spn-14854","text":"Transport selection"}]},{"id":"blk-16750","kind":"paragraph","spans":[{"id":"spn-14855","text":"Force a specific MCP transport:"}]},{"id":"blk-16751","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --transport http"},{"id":"blk-16752","kind":"paragraph","spans":[{"id":"spn-14856","text":"Default is "},{"id":"spn-14857","marks":["code"],"text":"stdio"},{"id":"spn-14858","text":"."}]},{"id":"blk-16753","kind":"heading","level":2,"spans":[{"id":"spn-14859","text":"What Generation Does NOT Do"}]},{"id":"blk-16754","items":[{"blocks":[{"id":"blk-16756","kind":"paragraph","spans":[{"id":"spn-14860","text":"It does not start MCP servers or deploy agents"}]}],"id":"blk-16755","kind":"list-item"},{"blocks":[{"id":"blk-16758","kind":"paragraph","spans":[{"id":"spn-14861","text":"It does not install provider binaries"}]}],"id":"blk-16757","kind":"list-item"},{"blocks":[{"id":"blk-16760","kind":"paragraph","spans":[{"id":"spn-14862","text":"It does not modify the source declaration"}]}],"id":"blk-16759","kind":"list-item"},{"blocks":[{"id":"blk-16762","kind":"paragraph","spans":[{"id":"spn-14863","text":"It does not create network connections"}]}],"id":"blk-16761","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16763","kind":"paragraph","spans":[{"id":"spn-14864","text":"Generation produces "},{"id":"spn-14865","marks":["bold"],"text":"configuration artifacts"},{"id":"spn-14866","text":". Deployment is a separate concern handled by your runtime infrastructure."}]}],"edges":[],"id":"bagaaierabirseybb5pw467xlcjxmxf4u4sz23yvpdnycr5zdknioovtoirlq","vocabulary":"ampersand.docs.fs.v1"}