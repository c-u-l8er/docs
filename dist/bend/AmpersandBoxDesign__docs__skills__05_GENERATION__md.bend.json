{"bendscript":"0.1","blocks":[{"id":"blk-16677","kind":"heading","level":1,"spans":[{"id":"spn-14945","text":"Skill 05 — Generation"}]},{"blocks":[{"id":"blk-16679","kind":"paragraph","spans":[{"id":"spn-14946","text":"Compiling agent declarations into MCP server configurations and A2A agent cards. The \"from spec to running agent\" path."}]}],"id":"blk-16678","kind":"quote"},{"id":"blk-16680","kind":"heading","level":2,"spans":[{"id":"spn-14947","text":"Why This Matters"}]},{"id":"blk-16681","kind":"paragraph","spans":[{"id":"spn-14948","text":"Generation is the payoff. A validated, composed "},{"id":"spn-14949","marks":["code"],"text":"ampersand.json"},{"id":"spn-14950","text":" compiles into runtime artifacts that existing protocols understand. This is how [&] complements MCP and A2A without replacing either."}]},{"id":"blk-16682","kind":"code","language":"text","text":"ampersand.json → ampersand generate → mcp-config.json + agent-card.json"},{"id":"blk-16683","kind":"heading","level":2,"spans":[{"id":"spn-14951","text":"Generating MCP Configuration"}]},{"id":"blk-16684","kind":"heading","level":3,"spans":[{"id":"spn-14952","text":"Command"}]},{"id":"blk-16685","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json"},{"id":"blk-16686","kind":"heading","level":3,"spans":[{"id":"spn-14953","text":"What It Produces"}]},{"id":"blk-16687","kind":"paragraph","spans":[{"id":"spn-14954","text":"An MCP server configuration that wires up the declared capability providers as MCP tools and resources:"}]},{"id":"blk-16688","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"command\": \"graphonomous\",\n      \"args\": [\"--instance\", \"infra-ops\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\n        \"store_node\", \"store_edge\", \"retrieve_context\",\n        \"topology_analyze\", \"deliberate\"\n      ],\n      \"resources\": [\"graphonomous://runtime/health\"]\n    },\n    \"ticktickclock\": {\n      \"command\": \"ticktickclock\",\n      \"args\": [\"--streams\", \"cpu,mem\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\"detect_anomaly\", \"enrich_context\", \"learn_observation\"]\n    },\n    \"deliberatic\": {\n      \"command\": \"deliberatic\",\n      \"args\": [\"--governance\", \"constitutional\"],\n      \"transport\": \"stdio\",\n      \"tools\": [\"evaluate_argument\", \"structured_vote\"]\n    }\n  }\n}"},{"id":"blk-16689","kind":"heading","level":3,"spans":[{"id":"spn-14955","text":"How Capabilities Map to MCP Tools"}]},{"id":"blk-16690","kind":"paragraph","spans":[{"id":"spn-14956","text":"Each capability's operations become MCP tools:"}]},{"head":[{"id":"blk-16692","spans":[{"id":"spn-14957","text":"Capability"}]},{"id":"blk-16693","spans":[{"id":"spn-14958","text":"Operations"}]},{"id":"blk-16694","spans":[{"id":"spn-14959","text":"MCP Tools"}]}],"id":"blk-16691","kind":"table","rows":[[{"id":"blk-16695","spans":[{"id":"spn-14960","marks":["code"],"text":"&memory.graph"}]},{"id":"blk-16696","spans":[{"id":"spn-14961","marks":["code"],"text":"recall"},{"id":"spn-14962","text":", "},{"id":"spn-14963","marks":["code"],"text":"store"},{"id":"spn-14964","text":", "},{"id":"spn-14965","marks":["code"],"text":"enrich"},{"id":"spn-14966","text":", "},{"id":"spn-14967","marks":["code"],"text":"topology"}]},{"id":"blk-16697","spans":[{"id":"spn-14968","marks":["code"],"text":"retrieve_context"},{"id":"spn-14969","text":", "},{"id":"spn-14970","marks":["code"],"text":"store_node"},{"id":"spn-14971","text":", "},{"id":"spn-14972","marks":["code"],"text":"store_edge"},{"id":"spn-14973","text":", "},{"id":"spn-14974","marks":["code"],"text":"topology_analyze"}]}],[{"id":"blk-16698","spans":[{"id":"spn-14975","marks":["code"],"text":"&time.anomaly"}]},{"id":"blk-16699","spans":[{"id":"spn-14976","marks":["code"],"text":"detect"},{"id":"spn-14977","text":", "},{"id":"spn-14978","marks":["code"],"text":"enrich"},{"id":"spn-14979","text":", "},{"id":"spn-14980","marks":["code"],"text":"learn"}]},{"id":"blk-16700","spans":[{"id":"spn-14981","marks":["code"],"text":"detect_anomaly"},{"id":"spn-14982","text":", "},{"id":"spn-14983","marks":["code"],"text":"enrich_context"},{"id":"spn-14984","text":", "},{"id":"spn-14985","marks":["code"],"text":"learn_observation"}]}],[{"id":"blk-16701","spans":[{"id":"spn-14986","marks":["code"],"text":"&reason.argument"}]},{"id":"blk-16702","spans":[{"id":"spn-14987","marks":["code"],"text":"evaluate"},{"id":"spn-14988","text":", "},{"id":"spn-14989","marks":["code"],"text":"vote"}]},{"id":"blk-16703","spans":[{"id":"spn-14990","marks":["code"],"text":"evaluate_argument"},{"id":"spn-14991","text":", "},{"id":"spn-14992","marks":["code"],"text":"structured_vote"}]}],[{"id":"blk-16704","spans":[{"id":"spn-14993","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-16705","spans":[{"id":"spn-14994","marks":["code"],"text":"deliberate"},{"id":"spn-14995","text":", "},{"id":"spn-14996","marks":["code"],"text":"decompose"},{"id":"spn-14997","text":", "},{"id":"spn-14998","marks":["code"],"text":"reconcile"}]},{"id":"blk-16706","spans":[{"id":"spn-14999","marks":["code"],"text":"deliberate"},{"id":"spn-15000","text":", "},{"id":"spn-15001","marks":["code"],"text":"decompose_topology"},{"id":"spn-15002","text":", "},{"id":"spn-15003","marks":["code"],"text":"reconcile_conclusions"}]}],[{"id":"blk-16707","spans":[{"id":"spn-15004","marks":["code"],"text":"&reason.attend"}]},{"id":"blk-16708","spans":[{"id":"spn-15005","marks":["code"],"text":"survey"},{"id":"spn-15006","text":", "},{"id":"spn-15007","marks":["code"],"text":"triage"},{"id":"spn-15008","text":", "},{"id":"spn-15009","marks":["code"],"text":"dispatch"}]},{"id":"blk-16709","spans":[{"id":"spn-15010","marks":["code"],"text":"attention_survey"},{"id":"spn-15011","text":", "},{"id":"spn-15012","marks":["code"],"text":"attention_triage"},{"id":"spn-15013","text":", "},{"id":"spn-15014","marks":["code"],"text":"attention_run_cycle"}]}]]},{"id":"blk-16710","kind":"paragraph","spans":[{"id":"spn-15015","text":"The mapping is defined in each capability's contract. The generator reads the contract and emits the corresponding MCP tool registrations."}]},{"id":"blk-16711","kind":"heading","level":2,"spans":[{"id":"spn-15016","text":"Generating A2A Agent Cards"}]},{"id":"blk-16712","kind":"heading","level":3,"spans":[{"id":"spn-15017","text":"Command"}]},{"id":"blk-16713","kind":"code","language":"bash","text":"./ampersand generate a2a agent.ampersand.json"},{"id":"blk-16714","kind":"heading","level":3,"spans":[{"id":"spn-15018","text":"What It Produces"}]},{"id":"blk-16715","kind":"paragraph","spans":[{"id":"spn-15019","text":"An A2A agent card suitable for "},{"id":"spn-15020","marks":["code"],"text":"/.well-known/agent.json"},{"id":"spn-15021","text":":"}]},{"id":"blk-16716","kind":"code","language":"json","text":"{\n  \"name\": \"InfraOperator\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Infrastructure operations agent with graph memory, temporal anomaly detection, fleet awareness, and deliberative reasoning.\",\n  \"skills\": [\n    {\n      \"id\": \"temporal-anomaly-detection\",\n      \"name\": \"Temporal Anomaly Detection\",\n      \"description\": \"Detect anomalous events in temporal data streams.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    },\n    {\n      \"id\": \"topology-aware-deliberation\",\n      \"name\": \"Topology-Aware Deliberation\",\n      \"description\": \"Focused reasoning through knowledge graph cycles.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    },\n    {\n      \"id\": \"fleet-spatial-awareness\",\n      \"name\": \"Fleet Spatial Awareness\",\n      \"description\": \"Geospatial fleet tracking and geofence management.\",\n      \"inputModes\": [\"application/json\"],\n      \"outputModes\": [\"application/json\"]\n    }\n  ],\n  \"capabilities\": {\n    \"streaming\": false,\n    \"pushNotifications\": false\n  }\n}"},{"id":"blk-16717","kind":"heading","level":3,"spans":[{"id":"spn-15022","text":"How Capabilities Map to A2A Skills"}]},{"id":"blk-16718","kind":"paragraph","spans":[{"id":"spn-15023","text":"Each capability contract includes an "},{"id":"spn-15024","marks":["code"],"text":"a2a_skills"},{"id":"spn-15025","text":" field that defines the skill identifiers exposed via A2A:"}]},{"head":[{"id":"blk-16720","spans":[{"id":"spn-15026","text":"Capability"}]},{"id":"blk-16721","spans":[{"id":"spn-15027","marks":["code"],"text":"a2a_skills"}]},{"id":"blk-16722","spans":[{"id":"spn-15028","text":"A2A Skill Entry"}]}],"id":"blk-16719","kind":"table","rows":[[{"id":"blk-16723","spans":[{"id":"spn-15029","marks":["code"],"text":"&time.anomaly"}]},{"id":"blk-16724","spans":[{"id":"spn-15030","marks":["code"],"text":"[\"temporal-anomaly-detection\"]"}]},{"id":"blk-16725","spans":[{"id":"spn-15031","text":"Temporal anomaly detection skill"}]}],[{"id":"blk-16726","spans":[{"id":"spn-15032","marks":["code"],"text":"&reason.deliberate"}]},{"id":"blk-16727","spans":[{"id":"spn-15033","marks":["code"],"text":"[\"topology-aware-deliberation\"]"}]},{"id":"blk-16728","spans":[{"id":"spn-15034","text":"Deliberation skill"}]}],[{"id":"blk-16729","spans":[{"id":"spn-15035","marks":["code"],"text":"&space.fleet"}]},{"id":"blk-16730","spans":[{"id":"spn-15036","marks":["code"],"text":"[\"fleet-spatial-awareness\"]"}]},{"id":"blk-16731","spans":[{"id":"spn-15037","text":"Fleet tracking skill"}]}]]},{"id":"blk-16732","kind":"heading","level":2,"spans":[{"id":"spn-15038","text":"Output Options"}]},{"id":"blk-16733","kind":"heading","level":3,"spans":[{"id":"spn-15039","text":"Write to file"}]},{"id":"blk-16734","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --output mcp-config.json\n./ampersand generate a2a agent.ampersand.json --output agent-card.json"},{"id":"blk-16735","kind":"heading","level":3,"spans":[{"id":"spn-15040","text":"Write to stdout (default)"}]},{"id":"blk-16736","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json | jq ."},{"id":"blk-16737","kind":"heading","level":3,"spans":[{"id":"spn-15041","text":"Compact output"}]},{"id":"blk-16738","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --compact"},{"id":"blk-16739","kind":"heading","level":2,"spans":[{"id":"spn-15042","text":"Generation Pipeline"}]},{"id":"blk-16740","kind":"paragraph","spans":[{"id":"spn-15043","text":"Generation runs after validation and composition. The full sequence:"}]},{"id":"blk-16741","kind":"code","language":"text","text":"1. Parse ampersand.json\n2. Validate against schema (same as `validate`)\n3. Compose and check type safety (same as `compose`)\n4. Resolve providers from registry\n5. Load capability contracts for each provider\n6. Map operations → MCP tools or A2A skills\n7. Emit output artifact"},{"id":"blk-16742","kind":"paragraph","spans":[{"id":"spn-15044","text":"If validation or composition fails, generation aborts with the relevant errors. You do not need to run "},{"id":"spn-15045","marks":["code"],"text":"validate"},{"id":"spn-15046","text":" and "},{"id":"spn-15047","marks":["code"],"text":"compose"},{"id":"spn-15048","text":" separately before "},{"id":"spn-15049","marks":["code"],"text":"generate"},{"id":"spn-15050","text":" — the command includes both checks."}]},{"id":"blk-16743","kind":"heading","level":2,"spans":[{"id":"spn-15051","text":"Custom Generation"}]},{"id":"blk-16744","kind":"heading","level":3,"spans":[{"id":"spn-15052","text":"Provider overrides"}]},{"id":"blk-16745","kind":"paragraph","spans":[{"id":"spn-15053","text":"Override providers at generation time without modifying the declaration:"}]},{"id":"blk-16746","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json \\\n  --provider \"&memory.graph=custom-graph-service\""},{"id":"blk-16747","kind":"heading","level":3,"spans":[{"id":"spn-15054","text":"Transport selection"}]},{"id":"blk-16748","kind":"paragraph","spans":[{"id":"spn-15055","text":"Force a specific MCP transport:"}]},{"id":"blk-16749","kind":"code","language":"bash","text":"./ampersand generate mcp agent.ampersand.json --transport http"},{"id":"blk-16750","kind":"paragraph","spans":[{"id":"spn-15056","text":"Default is "},{"id":"spn-15057","marks":["code"],"text":"stdio"},{"id":"spn-15058","text":"."}]},{"id":"blk-16751","kind":"heading","level":2,"spans":[{"id":"spn-15059","text":"What Generation Does NOT Do"}]},{"id":"blk-16752","items":[{"blocks":[{"id":"blk-16754","kind":"paragraph","spans":[{"id":"spn-15060","text":"It does not start MCP servers or deploy agents"}]}],"id":"blk-16753","kind":"list-item"},{"blocks":[{"id":"blk-16756","kind":"paragraph","spans":[{"id":"spn-15061","text":"It does not install provider binaries"}]}],"id":"blk-16755","kind":"list-item"},{"blocks":[{"id":"blk-16758","kind":"paragraph","spans":[{"id":"spn-15062","text":"It does not modify the source declaration"}]}],"id":"blk-16757","kind":"list-item"},{"blocks":[{"id":"blk-16760","kind":"paragraph","spans":[{"id":"spn-15063","text":"It does not create network connections"}]}],"id":"blk-16759","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16761","kind":"paragraph","spans":[{"id":"spn-15064","text":"Generation produces "},{"id":"spn-15065","marks":["bold"],"text":"configuration artifacts"},{"id":"spn-15066","text":". Deployment is a separate concern handled by your runtime infrastructure."}]}],"edges":[],"id":"bagaaierauxhn7y4bodmfpeni6ujyh5bhh7akdvyx2ndbbdrsykugowslzuyq","vocabulary":"ampersand.docs.fs.v1"}