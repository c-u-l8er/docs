{"bendscript":"0.1","blocks":[{"id":"blk-91213","kind":"heading","level":1,"spans":[{"id":"spn-155126","text":"ADR-0003: Secrets Handling & Provider Injection Strategy"}]},{"id":"blk-91214","items":[{"blocks":[{"id":"blk-91216","kind":"paragraph","spans":[{"id":"spn-155127","marks":["bold"],"text":"Status:"},{"id":"spn-155128","text":" Accepted"}]}],"id":"blk-91215","kind":"list-item"},{"blocks":[{"id":"blk-91218","kind":"paragraph","spans":[{"id":"spn-155129","marks":["bold"],"text":"Date:"},{"id":"spn-155130","text":" 2026-01-21"}]}],"id":"blk-91217","kind":"list-item"},{"blocks":[{"id":"blk-91220","kind":"paragraph","spans":[{"id":"spn-155131","marks":["bold"],"text":"Owners:"},{"id":"spn-155132","text":" Engineering"}]}],"id":"blk-91219","kind":"list-item"},{"blocks":[{"id":"blk-91222","kind":"paragraph","spans":[{"id":"spn-155133","marks":["bold"],"text":"Related docs:"}]}],"id":"blk-91221","kind":"list-item"},{"blocks":[{"id":"blk-91224","kind":"paragraph","spans":[{"id":"spn-155134","marks":["code"],"text":"WebHost.Systems/docs/spec/00_MASTER_SPEC.md"}]}],"id":"blk-91223","kind":"list-item"},{"blocks":[{"id":"blk-91226","kind":"paragraph","spans":[{"id":"spn-155135","marks":["code"],"text":"WebHost.Systems/docs/spec/10_API_CONTRACTS.md"}]}],"id":"blk-91225","kind":"list-item"},{"blocks":[{"id":"blk-91228","kind":"paragraph","spans":[{"id":"spn-155136","marks":["code"],"text":"WebHost.Systems/docs/spec/20_RUNTIME_PROVIDER_INTERFACE.md"}]}],"id":"blk-91227","kind":"list-item"},{"blocks":[{"id":"blk-91230","kind":"paragraph","spans":[{"id":"spn-155137","marks":["code"],"text":"WebHost.Systems/docs/spec/40_SECURITY_SECRETS_COMPLIANCE.md"}]}],"id":"blk-91229","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91231","kind":"heading","level":2,"spans":[{"id":"spn-155138","text":"Context"}]},{"id":"blk-91232","kind":"paragraph","spans":[{"id":"spn-155139","text":"webhost.systems is a multi-runtime AI agent deployment platform with:"}]},{"id":"blk-91233","items":[{"blocks":[{"id":"blk-91235","kind":"paragraph","spans":[{"id":"spn-155140","marks":["bold"],"text":"Control plane:"},{"id":"spn-155141","text":" Auth, dashboard, agent/deployment metadata, billing, limits, metrics aggregation."}]}],"id":"blk-91234","kind":"list-item"},{"blocks":[{"id":"blk-91237","kind":"paragraph","spans":[{"id":"spn-155142","marks":["bold"],"text":"Data plane:"},{"id":"spn-155143","text":" Executes customer agent code on runtime providers (initially Cloudflare Workers/DO and AWS Bedrock AgentCore)."}]}],"id":"blk-91236","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91238","kind":"paragraph","spans":[{"id":"spn-155144","text":"The platform must handle several categories of secrets:"}]},{"id":"blk-91239","items":[{"blocks":[{"id":"blk-91241","kind":"paragraph","spans":[{"id":"spn-155145","marks":["bold"],"text":"Customer secrets:"},{"id":"spn-155146","text":" model keys (e.g., "},{"id":"spn-155147","marks":["code"],"text":"OPENAI_API_KEY"},{"id":"spn-155148","text":"), third-party API keys used by agent code."}]}],"id":"blk-91240","kind":"list-item"},{"blocks":[{"id":"blk-91243","kind":"paragraph","spans":[{"id":"spn-155149","marks":["bold"],"text":"Platform secrets:"},{"id":"spn-155150","text":" Cloudflare API tokens, AWS credentials/roles, billing webhook secret, internal signing keys."}]}],"id":"blk-91242","kind":"list-item"},{"blocks":[{"id":"blk-91245","kind":"paragraph","spans":[{"id":"spn-155151","marks":["bold"],"text":"Integrity secrets:"},{"id":"spn-155152","text":" telemetry signing keys (deployment-scoped)."}]}],"id":"blk-91244","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91246","kind":"paragraph","spans":[{"id":"spn-155153","text":"Constraints:"}]},{"id":"blk-91247","items":[{"blocks":[{"id":"blk-91249","kind":"paragraph","spans":[{"id":"spn-155154","text":"Customer agent code is "},{"id":"spn-155155","marks":["bold"],"text":"untrusted"},{"id":"spn-155156","text":" and may exfiltrate secrets it is given; therefore secrets must be scoped and minimized."}]}],"id":"blk-91248","kind":"list-item"},{"blocks":[{"id":"blk-91251","kind":"paragraph","spans":[{"id":"spn-155157","text":"The platform must support "},{"id":"spn-155158","marks":["bold"],"text":"multiple runtimes"},{"id":"spn-155159","text":", each with different secret injection mechanisms."}]}],"id":"blk-91250","kind":"list-item"},{"blocks":[{"id":"blk-91253","kind":"paragraph","spans":[{"id":"spn-155160","text":"The platform must enable "},{"id":"spn-155161","marks":["bold"],"text":"telemetry integrity"},{"id":"spn-155162","text":": data plane must report usage to control plane without allowing spoofing."}]}],"id":"blk-91252","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91254","kind":"paragraph","spans":[{"id":"spn-155163","text":"Security and operational requirements:"}]},{"id":"blk-91255","items":[{"blocks":[{"id":"blk-91257","kind":"paragraph","spans":[{"id":"spn-155164","text":"Minimize blast radius of a control-plane DB read breach."}]}],"id":"blk-91256","kind":"list-item"},{"blocks":[{"id":"blk-91259","kind":"paragraph","spans":[{"id":"spn-155165","text":"Prevent secret leakage via logs, errors, metrics, or UI."}]}],"id":"blk-91258","kind":"list-item"},{"blocks":[{"id":"blk-91261","kind":"paragraph","spans":[{"id":"spn-155166","text":"Support secret rotation with minimal operational burden."}]}],"id":"blk-91260","kind":"list-item"},{"blocks":[{"id":"blk-91263","kind":"paragraph","spans":[{"id":"spn-155167","text":"Keep implementation feasible for MVP while providing a clear path to stronger controls."}]}],"id":"blk-91262","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91264","kind":"heading","level":2,"spans":[{"id":"spn-155168","text":"Decision"}]},{"id":"blk-91265","items":[{"blocks":[{"id":"blk-91267","kind":"paragraph","spans":[{"id":"spn-155169","marks":["bold"],"text":"No plaintext secrets are stored in the primary application database"},{"id":"spn-155170","text":" (Supabase)."}]}],"id":"blk-91266","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-91268","items":[{"blocks":[{"id":"blk-91270","kind":"paragraph","spans":[{"id":"spn-155171","text":"The DB stores only:"}]}],"id":"blk-91269","kind":"list-item"},{"blocks":[{"id":"blk-91272","kind":"paragraph","spans":[{"id":"spn-155172","text":"secret key names (e.g., "},{"id":"spn-155173","marks":["code"],"text":"envVarKeys"},{"id":"spn-155174","text":"),"}]}],"id":"blk-91271","kind":"list-item"},{"blocks":[{"id":"blk-91274","kind":"paragraph","spans":[{"id":"spn-155175","text":"provider secret references (names/ids),"}]}],"id":"blk-91273","kind":"list-item"},{"blocks":[{"id":"blk-91276","kind":"paragraph","spans":[{"id":"spn-155176","text":"rotation metadata (timestamps, versions),"}]}],"id":"blk-91275","kind":"list-item"},{"blocks":[{"id":"blk-91278","kind":"paragraph","spans":[{"id":"spn-155177","text":"booleans like “is configured”."}]}],"id":"blk-91277","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91279","items":[{"blocks":[{"id":"blk-91281","kind":"paragraph","spans":[{"id":"spn-155178","marks":["bold"],"text":"Secrets are injected into runtime providers using provider-native secret mechanisms"},{"id":"spn-155179","text":" (where possible)."}]}],"id":"blk-91280","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-91282","items":[{"blocks":[{"id":"blk-91284","kind":"paragraph","spans":[{"id":"spn-155180","marks":["bold"],"text":"Cloudflare:"},{"id":"spn-155181","text":" Worker secret bindings (set via Cloudflare API)."}]}],"id":"blk-91283","kind":"list-item"},{"blocks":[{"id":"blk-91286","kind":"paragraph","spans":[{"id":"spn-155182","marks":["bold"],"text":"AWS / AgentCore:"},{"id":"spn-155183","text":" "},{"id":"spn-155184","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-155185","text":" via the AgentCore Runtime API (recommended default for v1), with "},{"id":"spn-155186","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-155187","text":" as an optional enhancement for advanced rotation and centralized secret management."}]}],"id":"blk-91285","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91287","items":[{"blocks":[{"id":"blk-91289","kind":"paragraph","spans":[{"id":"spn-155188","marks":["bold"],"text":"Telemetry integrity uses deployment-scoped signing keys"},{"id":"spn-155189","text":" injected into the runtime as secrets."}]}],"id":"blk-91288","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-91290","items":[{"blocks":[{"id":"blk-91292","kind":"paragraph","spans":[{"id":"spn-155190","text":"Each deployment gets a unique "},{"id":"spn-155191","marks":["code"],"text":"telemetrySecret"},{"id":"spn-155192","text":" (HMAC key)."}]}],"id":"blk-91291","kind":"list-item"},{"blocks":[{"id":"blk-91294","kind":"paragraph","spans":[{"id":"spn-155193","text":"Data plane signs telemetry payloads with HMAC-SHA256 over raw request bytes."}]}],"id":"blk-91293","kind":"list-item"},{"blocks":[{"id":"blk-91296","kind":"paragraph","spans":[{"id":"spn-155194","text":"Control plane verifies signature using the secret reference associated with the deployment."}]}],"id":"blk-91295","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91297","items":[{"blocks":[{"id":"blk-91299","kind":"paragraph","spans":[{"id":"spn-155195","marks":["bold"],"text":"Control plane never exposes secret values back to clients."}]}],"id":"blk-91298","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-91300","items":[{"blocks":[{"id":"blk-91302","kind":"paragraph","spans":[{"id":"spn-155196","text":"A “set secrets” endpoint may exist and is write-only."}]}],"id":"blk-91301","kind":"list-item"},{"blocks":[{"id":"blk-91304","kind":"paragraph","spans":[{"id":"spn-155197","text":"A “get secrets” endpoint for plaintext MUST NOT exist."}]}],"id":"blk-91303","kind":"list-item"},{"blocks":[{"id":"blk-91306","kind":"paragraph","spans":[{"id":"spn-155198","text":"The UI can show only:"}]}],"id":"blk-91305","kind":"list-item"},{"blocks":[{"id":"blk-91308","kind":"paragraph","spans":[{"id":"spn-155199","text":"configured keys list,"}]}],"id":"blk-91307","kind":"list-item"},{"blocks":[{"id":"blk-91310","kind":"paragraph","spans":[{"id":"spn-155200","text":"status per key (set/not set),"}]}],"id":"blk-91309","kind":"list-item"},{"blocks":[{"id":"blk-91312","kind":"paragraph","spans":[{"id":"spn-155201","text":"last rotated timestamp (optional)."}]}],"id":"blk-91311","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91313","kind":"heading","level":2,"spans":[{"id":"spn-155202","text":"Rationale"}]},{"id":"blk-91314","items":[{"blocks":[{"id":"blk-91316","kind":"paragraph","spans":[{"id":"spn-155203","marks":["bold"],"text":"Reduces breach impact:"},{"id":"spn-155204","text":" If the primary DB is compromised, attackers do not automatically obtain usable API keys."}]}],"id":"blk-91315","kind":"list-item"},{"blocks":[{"id":"blk-91318","kind":"paragraph","spans":[{"id":"spn-155205","marks":["bold"],"text":"Aligns with best practices:"},{"id":"spn-155206","text":" Provider secret stores are purpose-built for secret storage and rotation."}]}],"id":"blk-91317","kind":"list-item"},{"blocks":[{"id":"blk-91320","kind":"paragraph","spans":[{"id":"spn-155207","marks":["bold"],"text":"Enables multi-runtime:"},{"id":"spn-155208","text":" Provider injection allows per-runtime deployment without inventing a bespoke secret distribution system."}]}],"id":"blk-91319","kind":"list-item"},{"blocks":[{"id":"blk-91322","kind":"paragraph","spans":[{"id":"spn-155209","marks":["bold"],"text":"Supports telemetry integrity:"},{"id":"spn-155210","text":" Deployment-scoped secrets and HMAC signatures prevent spoofing of usage events, which protects billing and limit enforcement."}]}],"id":"blk-91321","kind":"list-item"},{"blocks":[{"id":"blk-91324","kind":"paragraph","spans":[{"id":"spn-155211","marks":["bold"],"text":"Keeps MVP achievable:"},{"id":"spn-155212","text":" Write-only secrets entry + provider injection is implementable without building a full secrets vault and policy engine."}]}],"id":"blk-91323","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91325","kind":"heading","level":2,"spans":[{"id":"spn-155213","text":"Alternatives considered"}]},{"id":"blk-91326","kind":"heading","level":3,"spans":[{"id":"spn-155214","text":"A) Store encrypted secrets in the primary DB (application-managed encryption)"}]},{"id":"blk-91327","kind":"paragraph","spans":[{"id":"spn-155215","marks":["bold"],"text":"Pros"}]},{"id":"blk-91328","items":[{"blocks":[{"id":"blk-91330","kind":"paragraph","spans":[{"id":"spn-155216","text":"Simple read/write path."}]}],"id":"blk-91329","kind":"list-item"},{"blocks":[{"id":"blk-91332","kind":"paragraph","spans":[{"id":"spn-155217","text":"Centralized regardless of runtime provider."}]}],"id":"blk-91331","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91333","kind":"paragraph","spans":[{"id":"spn-155218","marks":["bold"],"text":"Cons"}]},{"id":"blk-91334","items":[{"blocks":[{"id":"blk-91336","kind":"paragraph","spans":[{"id":"spn-155219","text":"Key management becomes a major responsibility (KMS integration, rotation, access controls)."}]}],"id":"blk-91335","kind":"list-item"},{"blocks":[{"id":"blk-91338","kind":"paragraph","spans":[{"id":"spn-155220","text":"If application and DB are compromised, secrets may still be exposed via runtime memory or logs."}]}],"id":"blk-91337","kind":"list-item"},{"blocks":[{"id":"blk-91340","kind":"paragraph","spans":[{"id":"spn-155221","text":"More complex than necessary for MVP given provider secret facilities."}]}],"id":"blk-91339","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91341","kind":"paragraph","spans":[{"id":"spn-155222","marks":["bold"],"text":"Decision:"},{"id":"spn-155223","text":" Rejected for v1 (may revisit if a centralized secrets vault is required)."}]},{"id":"blk-91342","kind":"heading","level":3,"spans":[{"id":"spn-155224","text":"B) Centralized secret store for all secrets (e.g., dedicated vault) + runtime fetch at execution time"}]},{"id":"blk-91343","kind":"paragraph","spans":[{"id":"spn-155225","marks":["bold"],"text":"Pros"}]},{"id":"blk-91344","items":[{"blocks":[{"id":"blk-91346","kind":"paragraph","spans":[{"id":"spn-155226","text":"Single system of record, policy controls, potential audit/compliance benefits."}]}],"id":"blk-91345","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91347","kind":"paragraph","spans":[{"id":"spn-155227","marks":["bold"],"text":"Cons"}]},{"id":"blk-91348","items":[{"blocks":[{"id":"blk-91350","kind":"paragraph","spans":[{"id":"spn-155228","text":"Adds significant infrastructure and operational complexity."}]}],"id":"blk-91349","kind":"list-item"},{"blocks":[{"id":"blk-91352","kind":"paragraph","spans":[{"id":"spn-155229","text":"Requires secure runtime access and network paths from every provider."}]}],"id":"blk-91351","kind":"list-item"},{"blocks":[{"id":"blk-91354","kind":"paragraph","spans":[{"id":"spn-155230","text":"Introduces availability coupling: vault outage can break invocations."}]}],"id":"blk-91353","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91355","kind":"paragraph","spans":[{"id":"spn-155231","marks":["bold"],"text":"Decision:"},{"id":"spn-155232","text":" Rejected for v1; consider for enterprise roadmap if needed."}]},{"id":"blk-91356","kind":"heading","level":3,"spans":[{"id":"spn-155233","text":"C) Embed secrets in deployment artifacts or config files"}]},{"id":"blk-91357","kind":"paragraph","spans":[{"id":"spn-155234","marks":["bold"],"text":"Pros"}]},{"id":"blk-91358","items":[{"blocks":[{"id":"blk-91360","kind":"paragraph","spans":[{"id":"spn-155235","text":"Easiest to implement."}]}],"id":"blk-91359","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91361","kind":"paragraph","spans":[{"id":"spn-155236","marks":["bold"],"text":"Cons"}]},{"id":"blk-91362","items":[{"blocks":[{"id":"blk-91364","kind":"paragraph","spans":[{"id":"spn-155237","text":"Catastrophic: secrets leak via artifacts, logs, and provider introspection."}]}],"id":"blk-91363","kind":"list-item"},{"blocks":[{"id":"blk-91366","kind":"paragraph","spans":[{"id":"spn-155238","text":"Violates core security requirement."}]}],"id":"blk-91365","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91367","kind":"paragraph","spans":[{"id":"spn-155239","marks":["bold"],"text":"Decision:"},{"id":"spn-155240","text":" Rejected."}]},{"id":"blk-91368","kind":"heading","level":3,"spans":[{"id":"spn-155241","text":"D) Adapter-side telemetry only (no runtime telemetry secret)"}]},{"id":"blk-91369","kind":"paragraph","spans":[{"id":"spn-155242","marks":["bold"],"text":"Pros"}]},{"id":"blk-91370","items":[{"blocks":[{"id":"blk-91372","kind":"paragraph","spans":[{"id":"spn-155243","text":"Avoids injecting telemetry secret into runtime."}]}],"id":"blk-91371","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91373","kind":"paragraph","spans":[{"id":"spn-155244","marks":["bold"],"text":"Cons"}]},{"id":"blk-91374","items":[{"blocks":[{"id":"blk-91376","kind":"paragraph","spans":[{"id":"spn-155245","text":"Often cannot capture accurate compute/tool usage."}]}],"id":"blk-91375","kind":"list-item"},{"blocks":[{"id":"blk-91378","kind":"paragraph","spans":[{"id":"spn-155246","text":"Harder to attribute reliably at high concurrency; may undercount or miscount."}]}],"id":"blk-91377","kind":"list-item"},{"blocks":[{"id":"blk-91380","kind":"paragraph","spans":[{"id":"spn-155247","text":"Still requires strong integrity controls in adapter pathway."}]}],"id":"blk-91379","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91381","kind":"paragraph","spans":[{"id":"spn-155248","marks":["bold"],"text":"Decision:"},{"id":"spn-155249","text":" Not the primary strategy. Allowed only as a constrained fallback if provider limitations require it, but must preserve attribution integrity."}]},{"id":"blk-91382","kind":"heading","level":2,"spans":[{"id":"spn-155250","text":"Consequences"}]},{"id":"blk-91383","kind":"heading","level":3,"spans":[{"id":"spn-155251","text":"Positive"}]},{"id":"blk-91384","items":[{"blocks":[{"id":"blk-91386","kind":"paragraph","spans":[{"id":"spn-155252","text":"Stronger baseline security posture without heavy infrastructure."}]}],"id":"blk-91385","kind":"list-item"},{"blocks":[{"id":"blk-91388","kind":"paragraph","spans":[{"id":"spn-155253","text":"Clear separation of responsibilities:"}]}],"id":"blk-91387","kind":"list-item"},{"blocks":[{"id":"blk-91390","kind":"paragraph","spans":[{"id":"spn-155254","text":"DB stores metadata and references,"}]}],"id":"blk-91389","kind":"list-item"},{"blocks":[{"id":"blk-91392","kind":"paragraph","spans":[{"id":"spn-155255","text":"providers store values."}]}],"id":"blk-91391","kind":"list-item"},{"blocks":[{"id":"blk-91394","kind":"paragraph","spans":[{"id":"spn-155256","text":"Enables per-deployment telemetry signing and robust anti-spoofing."}]}],"id":"blk-91393","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91395","kind":"heading","level":3,"spans":[{"id":"spn-155257","text":"Negative / tradeoffs"}]},{"id":"blk-91396","items":[{"blocks":[{"id":"blk-91398","kind":"paragraph","spans":[{"id":"spn-155258","text":"Secret management becomes provider-dependent; implementation must support multiple injection mechanisms."}]}],"id":"blk-91397","kind":"list-item"},{"blocks":[{"id":"blk-91400","kind":"paragraph","spans":[{"id":"spn-155259","text":"Secret rotation may require redeploy on some providers."}]}],"id":"blk-91399","kind":"list-item"},{"blocks":[{"id":"blk-91402","kind":"paragraph","spans":[{"id":"spn-155260","text":"Debugging becomes harder because plaintext is not retrievable; must rely on “configured/not configured” and test invocations."}]}],"id":"blk-91401","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91403","kind":"heading","level":2,"spans":[{"id":"spn-155261","text":"Implementation details (normative)"}]},{"id":"blk-91404","kind":"heading","level":3,"spans":[{"id":"spn-155262","text":"1) Data model requirements"}]},{"id":"blk-91405","items":[{"blocks":[{"id":"blk-91407","kind":"paragraph","spans":[{"id":"spn-155263","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-155264","text":": list of secret key names (never values)."}]}],"id":"blk-91406","kind":"list-item"},{"blocks":[{"id":"blk-91409","kind":"paragraph","spans":[{"id":"spn-155265","marks":["code"],"text":"deployments.telemetryAuthRef"},{"id":"spn-155266","text":": provider reference to telemetry signing secret (never plaintext)."}]}],"id":"blk-91408","kind":"list-item"},{"blocks":[{"id":"blk-91411","kind":"paragraph","spans":[{"id":"spn-155267","text":"Optional "},{"id":"spn-155268","marks":["code"],"text":"secrets"},{"id":"spn-155269","text":" metadata table (if implemented) stores only:"}]}],"id":"blk-91410","kind":"list-item"},{"blocks":[{"id":"blk-91413","kind":"paragraph","spans":[{"id":"spn-155270","marks":["code"],"text":"userId"},{"id":"spn-155271","text":", "},{"id":"spn-155272","marks":["code"],"text":"agentId"},{"id":"spn-155273","text":", "},{"id":"spn-155274","marks":["code"],"text":"key"},{"id":"spn-155275","text":", "},{"id":"spn-155276","marks":["code"],"text":"provider"},{"id":"spn-155277","text":", "},{"id":"spn-155278","marks":["code"],"text":"secretRef"},{"id":"spn-155279","text":", "},{"id":"spn-155280","marks":["code"],"text":"createdAtMs"},{"id":"spn-155281","text":", "},{"id":"spn-155282","marks":["code"],"text":"rotatedAtMs"},{"id":"spn-155283","text":"."}]}],"id":"blk-91412","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91414","kind":"heading","level":3,"spans":[{"id":"spn-155284","text":"2) Secrets write endpoint"}]},{"id":"blk-91415","kind":"paragraph","spans":[{"id":"spn-155285","text":"If implementing "},{"id":"spn-155286","marks":["code"],"text":"POST /v1/agents/{agentId}/secrets"},{"id":"spn-155287","text":" (write-only):"}]},{"id":"blk-91416","items":[{"blocks":[{"id":"blk-91418","kind":"paragraph","spans":[{"id":"spn-155288","text":"MUST authenticate and enforce tenant ownership."}]}],"id":"blk-91417","kind":"list-item"},{"blocks":[{"id":"blk-91420","kind":"paragraph","spans":[{"id":"spn-155289","text":"MUST validate keys against "},{"id":"spn-155290","marks":["code"],"text":"agents.envVarKeys"},{"id":"spn-155291","text":" (or allow adding new keys via "},{"id":"spn-155292","marks":["code"],"text":"agents.update"},{"id":"spn-155293","text":" first)."}]}],"id":"blk-91419","kind":"list-item"},{"blocks":[{"id":"blk-91422","kind":"paragraph","spans":[{"id":"spn-155294","text":"MUST store values only in provider secret store(s) and discard plaintext immediately after injection."}]}],"id":"blk-91421","kind":"list-item"},{"blocks":[{"id":"blk-91424","kind":"paragraph","spans":[{"id":"spn-155295","text":"MUST NOT return secret values."}]}],"id":"blk-91423","kind":"list-item"},{"blocks":[{"id":"blk-91426","kind":"paragraph","spans":[{"id":"spn-155296","text":"MUST redact secret values in logs and error messages."}]}],"id":"blk-91425","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91427","kind":"heading","level":3,"spans":[{"id":"spn-155297","text":"3) Provider injection requirements"}]},{"id":"blk-91428","items":[{"blocks":[{"id":"blk-91430","kind":"paragraph","spans":[{"id":"spn-155298","text":"Cloudflare adapter:"}]}],"id":"blk-91429","kind":"list-item"},{"blocks":[{"id":"blk-91432","kind":"paragraph","spans":[{"id":"spn-155299","text":"Use provider API to set Worker secrets per deployment or per agent, and ensure the active Worker uses the correct secrets."}]}],"id":"blk-91431","kind":"list-item"},{"blocks":[{"id":"blk-91434","kind":"paragraph","spans":[{"id":"spn-155300","text":"AgentCore adapter:"}]}],"id":"blk-91433","kind":"list-item"},{"blocks":[{"id":"blk-91436","kind":"paragraph","spans":[{"id":"spn-155301","text":"Use "},{"id":"spn-155302","marks":["bold"],"text":"AgentCore Runtime environment variable injection"},{"id":"spn-155303","text":" (v1 default) to set deployment-scoped secrets (telemetry signing key, user-provided API keys) as runtime environment variables."}]}],"id":"blk-91435","kind":"list-item"},{"blocks":[{"id":"blk-91438","kind":"paragraph","spans":[{"id":"spn-155304","text":"Use "},{"id":"spn-155305","marks":["bold"],"text":"AWS Secrets Manager references"},{"id":"spn-155306","text":" as an optional enhancement (post-v1 or enterprise hardening) to support rotation without redeploy and centralized secret governance."}]}],"id":"blk-91437","kind":"list-item"},{"blocks":[{"id":"blk-91440","kind":"paragraph","spans":[{"id":"spn-155307","text":"Store only "},{"id":"spn-155308","marks":["bold"],"text":"references/metadata"},{"id":"spn-155309","text":" in the control plane DB (e.g., runtime env var key names and/or Secrets Manager ARNs). Never store plaintext values."}]}],"id":"blk-91439","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91441","kind":"heading","level":4,"spans":[{"id":"spn-155310","text":"AgentCore secret injection (implementation note)"}]},{"id":"blk-91442","kind":"paragraph","spans":[{"id":"spn-155311","text":"AgentCore supports multiple secret injection patterns. For v1, prefer environment variables because it minimizes moving parts and matches the Cloudflare deployment model (provider-managed secret injection at deploy time)."}]},{"id":"blk-91443","items":[{"blocks":[{"id":"blk-91445","kind":"paragraph","spans":[{"id":"spn-155312","marks":["bold"],"text":"Option 1 (v1 default): Environment variables"}]}],"id":"blk-91444","kind":"list-item"},{"blocks":[{"id":"blk-91447","kind":"paragraph","spans":[{"id":"spn-155313","text":"Control plane sets runtime environment variables as part of the deploy/create/update runtime call."}]}],"id":"blk-91446","kind":"list-item"},{"blocks":[{"id":"blk-91449","kind":"paragraph","spans":[{"id":"spn-155314","text":"Example variables:"}]}],"id":"blk-91448","kind":"list-item"},{"blocks":[{"id":"blk-91451","kind":"paragraph","spans":[{"id":"spn-155315","marks":["code"],"text":"TELEMETRY_SECRET"},{"id":"spn-155316","text":" (deployment-scoped HMAC key)"}]}],"id":"blk-91450","kind":"list-item"},{"blocks":[{"id":"blk-91453","kind":"paragraph","spans":[{"id":"spn-155317","text":"user-provided keys like "},{"id":"spn-155318","marks":["code"],"text":"OPENAI_API_KEY"}]}],"id":"blk-91452","kind":"list-item"},{"blocks":[{"id":"blk-91455","kind":"paragraph","spans":[{"id":"spn-155319","text":"Operational note: rotation may require redeploy depending on provider behavior; document in UI."}]}],"id":"blk-91454","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91456","items":[{"blocks":[{"id":"blk-91458","kind":"paragraph","spans":[{"id":"spn-155320","marks":["bold"],"text":"Option 2 (optional): AWS Secrets Manager references"}]}],"id":"blk-91457","kind":"list-item"},{"blocks":[{"id":"blk-91460","kind":"paragraph","spans":[{"id":"spn-155321","text":"Store secret values in Secrets Manager."}]}],"id":"blk-91459","kind":"list-item"},{"blocks":[{"id":"blk-91462","kind":"paragraph","spans":[{"id":"spn-155322","text":"Provide the runtime with references (ARNs) and an IAM role that permits retrieval."}]}],"id":"blk-91461","kind":"list-item"},{"blocks":[{"id":"blk-91464","kind":"paragraph","spans":[{"id":"spn-155323","text":"Operational note: enables rotation without redeploy, but increases IAM + operational complexity."}]}],"id":"blk-91463","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-91465","kind":"heading","level":3,"spans":[{"id":"spn-155324","text":"4) Telemetry signing requirements"}]},{"id":"blk-91466","items":[{"blocks":[{"id":"blk-91468","kind":"paragraph","spans":[{"id":"spn-155325","text":"Each deployment MUST have a unique telemetry signing secret."}]}],"id":"blk-91