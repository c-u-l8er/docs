{"bendscript":"0.1","blocks":[{"id":"blk-82829","kind":"heading","level":1,"spans":[{"id":"spn-147264","text":"02 — Deployment Pipeline"}]},{"blocks":[{"id":"blk-82831","kind":"paragraph","spans":[{"id":"spn-147265","marks":["bold"],"text":"Purpose:"},{"id":"spn-147266","text":" How bundles are uploaded, validated, and deployed to runtime providers. Covers the immutable deployment model, version monotonicity, rollback mechanics, and the AgentCore container build pipeline."}]}],"id":"blk-82830","kind":"quote"},{"id":"blk-82832","kind":"heading","level":2,"spans":[{"id":"spn-147267","text":"Deployment Model"}]},{"id":"blk-82833","kind":"paragraph","spans":[{"id":"spn-147268","text":"Deployments are "},{"id":"spn-147269","marks":["bold"],"text":"immutable records"},{"id":"spn-147270","text":". Once created, a deployment's artifact, version, and configuration never change. Only "},{"id":"spn-147271","marks":["code"],"text":"status"},{"id":"spn-147272","text":" and "},{"id":"spn-147273","marks":["code"],"text":"error_message"},{"id":"spn-147274","text":" are updated during the lifecycle. Rollback works by switching the agent's "},{"id":"spn-147275","marks":["code"],"text":"active_deployment_id"},{"id":"spn-147276","text":" pointer -- not by modifying old deployments."}]},{"id":"blk-82834","kind":"heading","level":2,"spans":[{"id":"spn-147277","text":"Deployment Fields"}]},{"head":[{"id":"blk-82836","spans":[{"id":"spn-147278","text":"Field"}]},{"id":"blk-82837","spans":[{"id":"spn-147279","text":"Type"}]},{"id":"blk-82838","spans":[{"id":"spn-147280","text":"Description"}]}],"id":"blk-82835","kind":"table","rows":[[{"id":"blk-82839","spans":[{"id":"spn-147281","marks":["code"],"text":"id"}]},{"id":"blk-82840","spans":[{"id":"spn-147282","text":"UUID"}]},{"id":"blk-82841","spans":[{"id":"spn-147283","text":"Immutable deployment identifier"}]}],[{"id":"blk-82842","spans":[{"id":"spn-147284","marks":["code"],"text":"agent_id"}]},{"id":"blk-82843","spans":[{"id":"spn-147285","text":"UUID"}]},{"id":"blk-82844","spans":[{"id":"spn-147286","text":"Parent agent"}]}],[{"id":"blk-82845","spans":[{"id":"spn-147287","marks":["code"],"text":"version"}]},{"id":"blk-82846","spans":[{"id":"spn-147288","text":"int"}]},{"id":"blk-82847","spans":[{"id":"spn-147289","text":"Monotonically increasing per agent"}]}],[{"id":"blk-82848","spans":[{"id":"spn-147290","marks":["code"],"text":"runtime_provider"}]},{"id":"blk-82849","spans":[{"id":"spn-147291","text":"enum"}]},{"id":"blk-82850","spans":[{"id":"spn-147292","marks":["code"],"text":"cloudflare"},{"id":"spn-147293","text":" or "},{"id":"spn-147294","marks":["code"],"text":"agentcore"}]}],[{"id":"blk-82851","spans":[{"id":"spn-147295","marks":["code"],"text":"status"}]},{"id":"blk-82852","spans":[{"id":"spn-147296","text":"enum"}]},{"id":"blk-82853","spans":[{"id":"spn-147297","marks":["code"],"text":"deploying"},{"id":"spn-147298","text":" / "},{"id":"spn-147299","marks":["code"],"text":"active"},{"id":"spn-147300","text":" / "},{"id":"spn-147301","marks":["code"],"text":"failed"},{"id":"spn-147302","text":" / "},{"id":"spn-147303","marks":["code"],"text":"rolled_back"}]}],[{"id":"blk-82854","spans":[{"id":"spn-147304","marks":["code"],"text":"artifact"}]},{"id":"blk-82855","spans":[{"id":"spn-147305","text":"JSONB"}]},{"id":"blk-82856","spans":[{"id":"spn-147306","text":"Upload reference (checksum, size)"}]}],[{"id":"blk-82857","spans":[{"id":"spn-147307","marks":["code"],"text":"provider_ref"}]},{"id":"blk-82858","spans":[{"id":"spn-147308","text":"JSONB"}]},{"id":"blk-82859","spans":[{"id":"spn-147309","text":"Provider-specific deployment reference"}]}],[{"id":"blk-82860","spans":[{"id":"spn-147310","marks":["code"],"text":"commit_hash"}]},{"id":"blk-82861","spans":[{"id":"spn-147311","text":"string?"}]},{"id":"blk-82862","spans":[{"id":"spn-147312","text":"Optional git commit"}]}],[{"id":"blk-82863","spans":[{"id":"spn-147313","marks":["code"],"text":"error_message"}]},{"id":"blk-82864","spans":[{"id":"spn-147314","text":"string?"}]},{"id":"blk-82865","spans":[{"id":"spn-147315","text":"Failure details (sanitized, no secrets)"}]}]]},{"id":"blk-82866","kind":"heading","level":2,"spans":[{"id":"spn-147316","text":"Deploy Flow"}]},{"id":"blk-82867","kind":"code","language":"text","text":"1. UI uploads bundle (zip/tar)\n2. POST /functions/v1/deploy\n3. Edge Function:\n   a. Validate bundle (see validation rules below)\n   b. INSERT deployment (status: deploying)\n   c. Call RPI adapter: deploy(artifact, config, secrets)\n   d. On success:\n      - UPDATE deployment status -> active\n      - SET agents.active_deployment_id = deployment.id\n      - SET agents.status -> active\n   e. On failure:\n      - UPDATE deployment status -> failed\n      - SET error_message\n      - SET agents.status -> error"},{"id":"blk-82868","kind":"heading","level":2,"spans":[{"id":"spn-147317","text":"Required Manifest: "},{"id":"spn-147318","marks":["code"],"text":"agent.config.json"}]},{"id":"blk-82869","kind":"paragraph","spans":[{"id":"spn-147319","text":"Every bundle must include this file at the root:"}]},{"id":"blk-82870","kind":"code","language":"json","text":"{\n  \"entrypoint\": \"src/index.ts\",\n  \"runtime\": \"cloudflare\",\n  \"protocol\": \"invoke/v1\",\n  \"env\": {\n    \"requiredKeys\": [\"OPENAI_API_KEY\"],\n    \"optionalKeys\": [\"DEBUG\"]\n  },\n  \"capabilities\": {\n    \"streaming\": true,\n    \"tools\": false\n  }\n}"},{"head":[{"id":"blk-82872","spans":[{"id":"spn-147320","text":"Field"}]},{"id":"blk-82873","spans":[{"id":"spn-147321","text":"Required"}]},{"id":"blk-82874","spans":[{"id":"spn-147322","text":"Description"}]}],"id":"blk-82871","kind":"table","rows":[[{"id":"blk-82875","spans":[{"id":"spn-147323","marks":["code"],"text":"entrypoint"}]},{"id":"blk-82876","spans":[{"id":"spn-147324","text":"Yes"}]},{"id":"blk-82877","spans":[{"id":"spn-147325","text":"Path to main file"}]}],[{"id":"blk-82878","spans":[{"id":"spn-147326","marks":["code"],"text":"runtime"}]},{"id":"blk-82879","spans":[{"id":"spn-147327","text":"Yes"}]},{"id":"blk-82880","spans":[{"id":"spn-147328","text":"Must match agent's "},{"id":"spn-147329","marks":["code"],"text":"runtime_provider"}]}],[{"id":"blk-82881","spans":[{"id":"spn-147330","marks":["code"],"text":"protocol"}]},{"id":"blk-82882","spans":[{"id":"spn-147331","text":"Yes"}]},{"id":"blk-82883","spans":[{"id":"spn-147332","text":"Must be "},{"id":"spn-147333","marks":["code"],"text":"invoke/v1"}]}],[{"id":"blk-82884","spans":[{"id":"spn-147334","marks":["code"],"text":"env.requiredKeys"}]},{"id":"blk-82885","spans":[{"id":"spn-147335","text":"Yes"}]},{"id":"blk-82886","spans":[{"id":"spn-147336","text":"Secret keys that must exist in Vault"}]}],[{"id":"blk-82887","spans":[{"id":"spn-147337","marks":["code"],"text":"capabilities"}]},{"id":"blk-82888","spans":[{"id":"spn-147338","text":"Yes"}]},{"id":"blk-82889","spans":[{"id":"spn-147339","text":"Feature flags"}]}]]},{"id":"blk-82890","kind":"heading","level":2,"spans":[{"id":"spn-147340","text":"Validation Rules (MUST)"}]},{"id":"blk-82891","items":[{"blocks":[{"id":"blk-82893","kind":"paragraph","spans":[{"id":"spn-147341","text":"[ ] "},{"id":"spn-147342","marks":["code"],"text":"agent.config.json"},{"id":"spn-147343","text":" exists and parses as valid JSON"}]}],"id":"blk-82892","kind":"list-item"},{"blocks":[{"id":"blk-82895","kind":"paragraph","spans":[{"id":"spn-147344","text":"[ ] "},{"id":"spn-147345","marks":["code"],"text":"entrypoint"},{"id":"spn-147346","text":" file exists in the bundle"}]}],"id":"blk-82894","kind":"list-item"},{"blocks":[{"id":"blk-82897","kind":"paragraph","spans":[{"id":"spn-147347","text":"[ ] "},{"id":"spn-147348","marks":["code"],"text":"runtime"},{"id":"spn-147349","text":" matches the agent's "},{"id":"spn-147350","marks":["code"],"text":"runtime_provider"}]}],"id":"blk-82896","kind":"list-item"},{"blocks":[{"id":"blk-82899","kind":"paragraph","spans":[{"id":"spn-147351","text":"[ ] "},{"id":"spn-147352","marks":["code"],"text":"protocol"},{"id":"spn-147353","text":" is "},{"id":"spn-147354","marks":["code"],"text":"invoke/v1"}]}],"id":"blk-82898","kind":"list-item"},{"blocks":[{"id":"blk-82901","kind":"paragraph","spans":[{"id":"spn-147355","text":"[ ] Bundle size within limits (compressed and extracted)"}]}],"id":"blk-82900","kind":"list-item"},{"blocks":[{"id":"blk-82903","kind":"paragraph","spans":[{"id":"spn-147356","text":"[ ] File count within limits"}]}],"id":"blk-82902","kind":"list-item"},{"blocks":[{"id":"blk-82905","kind":"paragraph","spans":[{"id":"spn-147357","text":"[ ] No path traversal entries or unsafe symlinks"}]}],"id":"blk-82904","kind":"list-item"},{"blocks":[{"id":"blk-82907","kind":"paragraph","spans":[{"id":"spn-147358","text":"[ ] Version is strictly greater than the previous deployment's version"}]}],"id":"blk-82906","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82908","kind":"heading","level":2,"spans":[{"id":"spn-147359","text":"Version Monotonicity"}]},{"id":"blk-82909","kind":"paragraph","spans":[{"id":"spn-147360","text":"Versions are monotonically increasing integers per agent. The platform auto-assigns the next version if not provided. Attempting to deploy a version less than or equal to the current maximum is rejected."}]},{"id":"blk-82910","kind":"code","language":"text","text":"agent_id | version | status\n---------+---------+--------\nabc      | 1       | rolled_back\nabc      | 2       | rolled_back\nabc      | 3       | active     <-- current"},{"id":"blk-82911","kind":"heading","level":2,"spans":[{"id":"spn-147361","text":"Rollback"}]},{"id":"blk-82912","kind":"paragraph","spans":[{"id":"spn-147362","text":"Rollback does "},{"id":"spn-147363","marks":["bold"],"text":"not"},{"id":"spn-147364","text":" create a new deployment. It switches the active pointer:"}]},{"id":"blk-82913","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/rest/v1/rpc/rollback_deployment\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{ \"agent_id\": \"<uuid>\", \"deployment_id\": \"<target-uuid>\" }'"},{"id":"blk-82914","kind":"paragraph","spans":[{"id":"spn-147365","text":"The target deployment must have status "},{"id":"spn-147366","marks":["code"],"text":"active"},{"id":"spn-147367","text":" or "},{"id":"spn-147368","marks":["code"],"text":"rolled_back"},{"id":"spn-147369","text":" and belong to the same agent. The current active deployment is marked "},{"id":"spn-147370","marks":["code"],"text":"rolled_back"},{"id":"spn-147371","text":"."}]},{"id":"blk-82915","kind":"heading","level":2,"spans":[{"id":"spn-147372","text":"AgentCore Container Build Pipeline"}]},{"id":"blk-82916","kind":"paragraph","spans":[{"id":"spn-147373","text":"When "},{"id":"spn-147374","marks":["code"],"text":"runtime=agentcore"},{"id":"spn-147375","text":", the control plane converts the uploaded bundle into a container image:"}]},{"id":"blk-82917","kind":"code","language":"text","text":"1. Extract and validate archive\n2. Build user code (TypeScript -> Node.js 20 artifact)\n3. Generate HTTP wrapper (invoke/v1 handler)\n4. Build OCI container image\n5. Push to ECR registry\n6. Create/update AgentCore runtime with image URI\n7. Inject env vars (telemetry key + user secrets)"},{"id":"blk-82918","kind":"paragraph","spans":[{"id":"spn-147376","text":"The pipeline is idempotent per "},{"id":"spn-147377","marks":["code"],"text":"deployment_id"},{"id":"spn-147378","text":" -- retries produce the same provider state."}]},{"id":"blk-82919","kind":"heading","level":2,"spans":[{"id":"spn-147379","text":"Concurrent Deploy Guard"}]},{"id":"blk-82920","kind":"paragraph","spans":[{"id":"spn-147380","text":"Only one deployment can be in "},{"id":"spn-147381","marks":["code"],"text":"deploying"},{"id":"spn-147382","text":" status per agent at a time. The Edge Function must check for existing in-progress deployments and reject concurrent attempts with an appropriate error."}]},{"id":"blk-82921","kind":"heading","level":2,"spans":[{"id":"spn-147383","text":"Checklist"}]},{"id":"blk-82922","items":[{"blocks":[{"id":"blk-82924","kind":"paragraph","spans":[{"id":"spn-147384","text":"[ ] Bundle includes valid "},{"id":"spn-147385","marks":["code"],"text":"agent.config.json"}]}],"id":"blk-82923","kind":"list-item"},{"blocks":[{"id":"blk-82926","kind":"paragraph","spans":[{"id":"spn-147386","text":"[ ] Entrypoint file exists"}]}],"id":"blk-82925","kind":"list-item"},{"blocks":[{"id":"blk-82928","kind":"paragraph","spans":[{"id":"spn-147387","text":"[ ] Runtime matches agent configuration"}]}],"id":"blk-82927","kind":"list-item"},{"blocks":[{"id":"blk-82930","kind":"paragraph","spans":[{"id":"spn-147388","text":"[ ] Version is monotonically increasing"}]}],"id":"blk-82929","kind":"list-item"},{"blocks":[{"id":"blk-82932","kind":"paragraph","spans":[{"id":"spn-147389","text":"[ ] Bundle passes size and file count limits"}]}],"id":"blk-82931","kind":"list-item"},{"blocks":[{"id":"blk-82934","kind":"paragraph","spans":[{"id":"spn-147390","text":"[ ] No concurrent deploys for the same agent"}]}],"id":"blk-82933","kind":"list-item"},{"blocks":[{"id":"blk-82936","kind":"paragraph","spans":[{"id":"spn-147391","text":"[ ] Secrets referenced in manifest exist in Vault"}]}],"id":"blk-82935","kind":"list-item"},{"blocks":[{"id":"blk-82938","kind":"paragraph","spans":[{"id":"spn-147392","text":"[ ] Deployment record is immutable after creation (except status/error)"}]}],"id":"blk-82937","kind":"list-item"},{"blocks":[{"id":"blk-82940","kind":"paragraph","spans":[{"id":"spn-147393","text":"[ ] AgentCore builds produce deterministic container images"}]}],"id":"blk-82939","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaiera63du7xtyrelpwktsnd36tyb4xftdxyvwmtfs5gkdoludpl7wmgfq","vocabulary":"ampersand.docs.fs.v1"}