{"bendscript":"0.1","blocks":[{"id":"blk-225","kind":"heading","level":1,"spans":[{"id":"spn-251","text":"Contributing to the [&] Protocol"}]},{"id":"blk-226","kind":"paragraph","spans":[{"id":"spn-252","text":"Thanks for contributing."}]},{"id":"blk-227","kind":"paragraph","spans":[{"id":"spn-253","text":"This repository is the canonical home for the [&] Protocol specification, schemas, examples, documentation, and reference implementation. The goal is to keep the project useful both as a "},{"id":"spn-254","marks":["bold"],"text":"human-readable protocol spec"},{"id":"spn-255","text":" and as a "},{"id":"spn-256","marks":["bold"],"text":"machine-readable implementation target"},{"id":"spn-257","text":"."}]},{"id":"blk-228","kind":"heading","level":2,"spans":[{"id":"spn-258","text":"What belongs in this repository"}]},{"id":"blk-229","kind":"paragraph","spans":[{"id":"spn-259","text":"This repository includes work on:"}]},{"id":"blk-230","items":[{"blocks":[{"id":"blk-232","kind":"paragraph","spans":[{"id":"spn-260","text":"protocol specification and terminology"}]}],"id":"blk-231","kind":"list-item"},{"blocks":[{"id":"blk-234","kind":"paragraph","spans":[{"id":"spn-261","text":"JSON Schema artifacts"}]}],"id":"blk-233","kind":"list-item"},{"blocks":[{"id":"blk-236","kind":"paragraph","spans":[{"id":"spn-262","text":"example "},{"id":"spn-263","marks":["code"],"text":"ampersand.json"},{"id":"spn-264","text":" declarations"}]}],"id":"blk-235","kind":"list-item"},{"blocks":[{"id":"blk-238","kind":"paragraph","spans":[{"id":"spn-265","text":"capability contract and registry artifacts"}]}],"id":"blk-237","kind":"list-item"},{"blocks":[{"id":"blk-240","kind":"paragraph","spans":[{"id":"spn-266","text":"reference implementations"}]}],"id":"blk-239","kind":"list-item"},{"blocks":[{"id":"blk-242","kind":"paragraph","spans":[{"id":"spn-267","text":"CLI tooling"}]}],"id":"blk-241","kind":"list-item"},{"blocks":[{"id":"blk-244","kind":"paragraph","spans":[{"id":"spn-268","text":"MCP and A2A generation"}]}],"id":"blk-243","kind":"list-item"},{"blocks":[{"id":"blk-246","kind":"paragraph","spans":[{"id":"spn-269","text":"documentation and positioning material"}]}],"id":"blk-245","kind":"list-item"},{"blocks":[{"id":"blk-248","kind":"paragraph","spans":[{"id":"spn-270","text":"site/source files for publishing the protocol"}]}],"id":"blk-247","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-249","kind":"heading","level":2,"spans":[{"id":"spn-271","text":"Guiding principles"}]},{"id":"blk-250","kind":"paragraph","spans":[{"id":"spn-272","text":"When contributing, optimize for these priorities:"}]},{"id":"blk-251","items":[{"blocks":[{"id":"blk-253","kind":"paragraph","spans":[{"id":"spn-273","marks":["bold"],"text":"Specification first"}]}],"id":"blk-252","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-254","kind":"paragraph","spans":[{"id":"spn-274","text":"The schema, examples, and protocol documents should agree."}]},{"id":"blk-255","items":[{"blocks":[{"id":"blk-257","kind":"paragraph","spans":[{"id":"spn-275","marks":["bold"],"text":"Machine-readable before magical"}]}],"id":"blk-256","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-258","kind":"paragraph","spans":[{"id":"spn-276","text":"Prefer explicit contracts, schemas, fixtures, and validation over prose-only ideas."}]},{"id":"blk-259","items":[{"blocks":[{"id":"blk-261","kind":"paragraph","spans":[{"id":"spn-277","marks":["bold"],"text":"Do not invent runtime details"}]}],"id":"blk-260","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-262","kind":"paragraph","spans":[{"id":"spn-278","text":"If a provider, protocol binding, or integration is not grounded in code or docs, leave it unresolved and document the gap."}]},{"id":"blk-263","items":[{"blocks":[{"id":"blk-265","kind":"paragraph","spans":[{"id":"spn-279","marks":["bold"],"text":"Keep the protocol provider-agnostic"}]}],"id":"blk-264","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-266","kind":"paragraph","spans":[{"id":"spn-280","text":"Capabilities are interfaces. Providers are implementations."}]},{"id":"blk-267","items":[{"blocks":[{"id":"blk-269","kind":"paragraph","spans":[{"id":"spn-281","marks":["bold"],"text":"Complement existing standards"}]}],"id":"blk-268","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-270","kind":"paragraph","spans":[{"id":"spn-282","text":"[&] compiles into MCP and A2A configurations. It does not replace them."}]},{"id":"blk-271","kind":"heading","level":2,"spans":[{"id":"spn-283","text":"Repository structure"}]},{"id":"blk-272","kind":"paragraph","spans":[{"id":"spn-284","text":"Contributions should generally fit into one of these areas:"}]},{"id":"blk-273","items":[{"blocks":[{"id":"blk-275","kind":"paragraph","spans":[{"id":"spn-285","marks":["code"],"text":"schema/"},{"id":"spn-286","text":" — canonical schemas"}]}],"id":"blk-274","kind":"list-item"},{"blocks":[{"id":"blk-277","kind":"paragraph","spans":[{"id":"spn-287","marks":["code"],"text":"examples/"},{"id":"spn-288","text":" — validating example declarations"}]}],"id":"blk-276","kind":"list-item"},{"blocks":[{"id":"blk-279","kind":"paragraph","spans":[{"id":"spn-289","marks":["code"],"text":"reference/"},{"id":"spn-290","text":" — reference implementations"}]}],"id":"blk-278","kind":"list-item"},{"blocks":[{"id":"blk-281","kind":"paragraph","spans":[{"id":"spn-291","marks":["code"],"text":"docs/"},{"id":"spn-292","text":" — supporting documentation"}]}],"id":"blk-280","kind":"list-item"},{"blocks":[{"id":"blk-283","kind":"paragraph","spans":[{"id":"spn-293","marks":["code"],"text":"site/"},{"id":"spn-294","text":" — website/source publishing assets"}]}],"id":"blk-282","kind":"list-item"},{"blocks":[{"id":"blk-285","kind":"paragraph","spans":[{"id":"spn-295","marks":["code"],"text":"tools/"},{"id":"spn-296","text":" — scripts and developer helpers"}]}],"id":"blk-284","kind":"list-item"},{"blocks":[{"id":"blk-287","kind":"paragraph","spans":[{"id":"spn-297","marks":["code"],"text":"prompts/"},{"id":"spn-298","text":" — implementation and research prompts"}]}],"id":"blk-286","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-288","kind":"paragraph","spans":[{"id":"spn-299","text":"If you need to add a new top-level directory, explain why in your pull request."}]},{"id":"blk-289","kind":"heading","level":2,"spans":[{"id":"spn-300","text":"Before you open a pull request"}]},{"id":"blk-290","kind":"paragraph","spans":[{"id":"spn-301","text":"Please make sure your contribution does the following where relevant:"}]},{"id":"blk-291","items":[{"blocks":[{"id":"blk-293","kind":"paragraph","spans":[{"id":"spn-302","text":"keeps terminology consistent with the protocol"}]}],"id":"blk-292","kind":"list-item"},{"blocks":[{"id":"blk-295","kind":"paragraph","spans":[{"id":"spn-303","text":"preserves or improves schema validity"}]}],"id":"blk-294","kind":"list-item"},{"blocks":[{"id":"blk-297","kind":"paragraph","spans":[{"id":"spn-304","text":"includes examples for new protocol concepts"}]}],"id":"blk-296","kind":"list-item"},{"blocks":[{"id":"blk-299","kind":"paragraph","spans":[{"id":"spn-305","text":"includes tests for implementation changes"}]}],"id":"blk-298","kind":"list-item"},{"blocks":[{"id":"blk-301","kind":"paragraph","spans":[{"id":"spn-306","text":"updates docs when behavior changes"}]}],"id":"blk-300","kind":"list-item"},{"blocks":[{"id":"blk-303","kind":"paragraph","spans":[{"id":"spn-307","text":"avoids unrelated formatting churn"}]}],"id":"blk-302","kind":"list-item"},{"blocks":[{"id":"blk-305","kind":"paragraph","spans":[{"id":"spn-308","text":"keeps generated artifacts out of commits unless intentionally checked in"}]}],"id":"blk-304","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-306","kind":"heading","level":2,"spans":[{"id":"spn-309","text":"Specification changes"}]},{"id":"blk-307","kind":"paragraph","spa