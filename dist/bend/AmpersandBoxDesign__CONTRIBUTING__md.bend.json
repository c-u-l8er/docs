,"id":"blk-328","kind":"list-item"},{"blocks":[{"id":"blk-331","kind":"paragraph","spans":[{"id":"spn-326","text":"prefer explicit validation rules over vague descriptions"}]}],"id":"blk-330","kind":"list-item"},{"blocks":[{"id":"blk-333","kind":"paragraph","spans":[{"id":"spn-327","text":"include examples where helpful"}]}],"id":"blk-332","kind":"list-item"},{"blocks":[{"id":"blk-335","kind":"paragraph","spans":[{"id":"spn-328","text":"preserve backward compatibility when possible"}]}],"id":"blk-334","kind":"list-item"},{"blocks":[{"id":"blk-337","kind":"paragraph","spans":[{"id":"spn-329","text":"if compatibility must break, document it clearly in the pull request"}]}],"id":"blk-336","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-338","kind":"paragraph","spans":[{"id":"spn-330","text":"If you add a new schema artifact, also add at least one realistic example document that validates against it."}]},{"id":"blk-339","kind":"heading","level":2,"spans":[{"id":"spn-331","text":"Example declaration rules"}]},{"id":"blk-340","kind":"paragraph","spans":[{"id":"spn-332","text":"Example files should be realistic, not toy placeholders."}]},{"id":"blk-341","kind":"paragraph","spans":[{"id":"spn-333","text":"Each example should:"}]},{"id":"blk-342","items":[{"blocks":[{"id":"blk-344","kind":"paragraph","spans":[{"id":"spn-334","text":"reference the canonical schema"}]}],"id":"blk-343","kind":"list-item"},{"blocks":[{"id":"blk-346","kind":"paragraph","spans":[{"id":"spn-335","text":"use realistic capability combinations"}]}],"id":"blk-345","kind":"list-item"},{"blocks":[{"id":"blk-348","kind":"paragraph","spans":[{"id":"spn-336","text":"use meaningful governance and provenance settings where appropriate"}]}],"id":"blk-347","kind":"list-item"},{"blocks":[{"id":"blk-350","kind":"paragraph","spans":[{"id":"spn-337","text":"demonstrate an actual use case"}]}],"id":"blk-349","kind":"list-item"},{"blocks":[{"id":"blk-352","kind":"paragraph","spans":[{"id":"spn-338","text":"validate successfully"}]}],"id":"blk-351","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-353","kind":"paragraph","spans":[{"id":"spn-339","text":"Examples are both documentation and test fixtures."}]},{"id":"blk-354","kind":"heading","level":2,"spans":[{"id":"spn-340","text":"Reference implementation rules"}]},{"id":"blk-355","kind":"paragraph","spans":[{"id":"spn-341","text":"Reference implementations should stay:"}]},{"id":"blk-356","items":[{"blocks":[{"id":"blk-358","kind":"paragraph","spans":[{"id":"spn-342","text":"small"}]}],"id":"blk-357","kind":"list-item"},{"blocks":[{"id":"blk-360","kind":"paragraph","spans":[{"id":"spn-343","text":"readable"}]}],"id":"blk-359","kind":"list-item"},{"blocks":[{"id":"blk-362","kind":"paragraph","spans":[{"id":"spn-344","text":"deterministic"}]}],"id":"blk-361","kind":"list-item"},{"blocks":[{"id":"blk-364","kind":"paragraph","spans":[{"id":"spn-345","text":"well-tested"}]}],"id":"blk-363","kind":"list-item"},{"blocks":[{"id":"blk-366","kind":"paragraph","spans":[{"id":"spn-346","text":"faithful to the spec"}]}],"id":"blk-365","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-367","kind":"paragraph","spans":[{"id":"spn-347","text":"Prefer minimal, explicit implementations over premature abstraction."}]},{"id":"blk-368","kind":"paragraph","spans":[{"id":"spn-348","text":"If you add a new implementation feature, include tests that show:"}]},{"id":"blk-369","items":[{"blocks":[{"id":"blk-371","kind":"paragraph","spans":[{"id":"spn-349","text":"valid behavior"}]}],"id":"blk-370","kind":"list-item"},{"blocks":[{"id":"blk-373","kind":"paragraph","spans":[{"id":"spn-350","text":"invalid behavior"}]}],"id":"blk-372","kind":"list-item"},{"blocks":[{"id":"blk-375","kind":"paragraph","spans":[{"id":"spn-351","text":"edge cases where useful"}]}],"id":"blk-374","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-376","kind":"heading","level":2,"spans":[{"id":"spn-352","text":"Documentation guidelines"}]},{"id":"blk-377","kind":"paragraph","spans":[{"id":"spn-353","text":"Documentation should be:"}]},{"id":"blk-378","items":[{"blocks":[{"id":"blk-380","kind":"paragraph","spans":[{"id":"spn-354","text":"technical but accessible"}]}],"id":"blk-379","kind":"list-item"},{"blocks":[{"id":"blk-382","kind":"paragraph","spans":[{"id":"spn-355","text":"precise about what is implemented vs planned"}]}],"id":"blk-381","kind":"list-item"},{"blocks":[{"id":"blk-384","kind":"paragraph","spans":[{"id":"spn-356","text":"respectful of the surrounding ecosystem"}]}],"id":"blk-383","kind":"list-item"},{"blocks":[{"id":"blk-386","kind":"paragraph","spans":[{"id":"spn-357","text":"light on hype"}]}],"id":"blk-385","kind":"list-item"},{"blocks":[{"id":"blk-388","kind":"paragraph","spans":[{"id":"spn-358","text":"heavy on examples"}]}],"id":"blk-387","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-389","kind":"paragraph","spans":[{"id":"spn-359","text":"Preferred framing:"}]},{"id":"blk-390","items":[{"blocks":[{"id":"blk-392","kind":"paragraph","spans":[{"id":"spn-360","text":"MCP handles agent-to-tool connectivity"}]}],"id":"blk-391","kind":"list-item"},{"blocks":[{"id":"blk-394","kind":"paragraph","spans":[{"id":"spn-361","text":"A2A handles agent-to-agent coordination"}]}],"id":"blk-393","kind":"list-item"},{"blocks":[{"id":"blk-396","kind":"paragraph","spans":[{"id":"spn-362","text":"[&] handles capability composition and compiles into MCP + A2A artifacts"}]}],"id":"blk-395","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-397","kind":"paragraph","spans":[{"id":"spn-363","text":"Avoid framing the protocol as replacing other standards."}]},{"id":"blk-398","kind":"heading","level":2,"spans":[{"id":"spn-364","text":"Commit guidelines"}]},{"id":"blk-399","kind":"paragraph","spans":[{"id":"spn-365","text":"Use clear, focused commits."}]},{"id":"blk-400","kind":"paragraph","spans":[{"id":"spn-366","text":"Good examples:"}]},{"id":"blk-401","items":[{