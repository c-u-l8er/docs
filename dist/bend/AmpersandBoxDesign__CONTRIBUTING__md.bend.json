{"bendscript":"0.1","blocks":[{"id":"blk-223","kind":"heading","level":1,"spans":[{"id":"spn-421","text":"Contributing to the [&] Protocol"}]},{"id":"blk-224","kind":"paragraph","spans":[{"id":"spn-422","text":"Thanks for contributing."}]},{"id":"blk-225","kind":"paragraph","spans":[{"id":"spn-423","text":"This repository is the canonical home for the [&] Protocol specification, schemas, examples, documentation, and reference implementation. The goal is to keep the project useful both as a "},{"id":"spn-424","marks":["bold"],"text":"human-readable protocol spec"},{"id":"spn-425","text":" and as a "},{"id":"spn-426","marks":["bold"],"text":"machine-readable implementation target"},{"id":"spn-427","text":"."}]},{"id":"blk-226","kind":"heading","level":2,"spans":[{"id":"spn-428","text":"What belongs in this repository"}]},{"id":"blk-227","kind":"paragraph","spans":[{"id":"spn-429","text":"This repository includes work on:"}]},{"id":"blk-228","items":[{"blocks":[{"id":"blk-230","kind":"paragraph","spans":[{"id":"spn-430","text":"protocol specification and terminology"}]}],"id":"blk-229","kind":"list-item"},{"blocks":[{"id":"blk-232","kind":"paragraph","spans":[{"id":"spn-431","text":"JSON Schema artifacts"}]}],"id":"blk-231","kind":"list-item"},{"blocks":[{"id":"blk-234","kind":"paragraph","spans":[{"id":"spn-432","text":"example "},{"id":"spn-433","marks":["code"],"text":"ampersand.json"},{"id":"spn-434","text":" declarations"}]}],"id":"blk-233","kind":"list-item"},{"blocks":[{"id":"blk-236","kind":"paragraph","spans":[{"id":"spn-435","text":"capability contract and registry artifacts"}]}],"id":"blk-235","kind":"list-item"},{"blocks":[{"id":"blk-238","kind":"paragraph","spans":[{"id":"spn-436","text":"reference implementations"}]}],"id":"blk-237","kind":"list-item"},{"blocks":[{"id":"blk-240","kind":"paragraph","spans":[{"id":"spn-437","text":"CLI tooling"}]}],"id":"blk-239","kind":"list-item"},{"blocks":[{"id":"blk-242","kind":"paragraph","spans":[{"id":"spn-438","text":"MCP and A2A generation"}]}],"id":"blk-241","kind":"list-item"},{"blocks":[{"id":"blk-244","kind":"paragraph","spans":[{"id":"spn-439","text":"documentation and positioning material"}]}],"id":"blk-243","kind":"list-item"},{"blocks":[{"id":"blk-246","kind":"paragraph","spans":[{"id":"spn-440","text":"site/source files for publishing the protocol"}]}],"id":"blk-245","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-247","kind":"heading","level":2,"spans":[{"id":"spn-441","text":"Guiding principles"}]},{"id":"blk-248","kind":"paragraph","spans":[{"id":"spn-442","text":"When contributing, optimize for these priorities:"}]},{"id":"blk-249","items":[{"blocks":[{"id":"blk-251","kind":"paragraph","spans":[{"id":"spn-443","marks":["bold"],"text":"Specification first"}]}],"id":"blk-250","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-252","kind":"paragraph","spans":[{"id":"spn-444","text":"The schema, examples, and protocol documents should agree."}]},{"id":"blk-253","items":[{"blocks":[{"id":"blk-255","kind":"paragraph","spans":[{"id":"spn-445","marks":["bold"],"text":"Machine-readable before magical"}]}],"id":"blk-254","kind":"list-item"}],"kind":"list","ordered":true,"start":2},{"id":"blk-256","kind":"paragraph","spans":[{"id":"spn-446","text":"Prefer explicit contracts, schemas, fixtures, and validation over prose-only ideas."}]},{"id":"blk-257","items":[{"blocks":[{"id":"blk-259","kind":"paragraph","spans":[{"id":"spn-447","marks":["bold"],"text":"Do not invent runtime details"}]}],"id":"blk-258","kind":"list-item"}],"kind":"list","ordered":true,"start":3},{"id":"blk-260","kind":"paragraph","spans":[{"id":"spn-448","text":"If a provider, protocol binding, or integration is not grounded in code or docs, leave it unresolved and document the gap."}]},{"id":"blk-261","items":[{"blocks":[{"id":"blk-263","kind":"paragraph","spans":[{"id":"spn-449","marks":["bold"],"text":"Keep the protocol provider-agnostic"}]}],"id":"blk-262","kind":"list-item"}],"kind":"list","ordered":true,"start":4},{"id":"blk-264","kind":"paragraph","spans":[{"id":"spn-450","text":"Capabilities are interfaces. Providers are implementations."}]},{"id":"blk-265","items":[{"blocks":[{"id":"blk-267","kind":"paragraph","spans":[{"id":"spn-451","marks":["bold"],"text":"Complement existing standards"}]}],"id":"blk-266","kind":"list-item"}],"kind":"list","ordered":true,"start":5},{"id":"blk-268","kind":"paragraph","spans":[{"id":"spn-452","text":"[&] compiles into MCP and A2A configurations. It does not replace them."}]},{"id":"blk-269","kind":"heading","level":2,"spans":[{"id":"spn-453","text":"Repository structure"}]},{"id":"blk-270","kind":"paragraph","spans":[{"id":"spn-454","text":"Contributions should generally fit into one of these areas:"}]},{"id":"blk-271","items":[{"blocks":[{"id":"blk-273","kind":"paragraph","spans":[{"id":"spn-455","marks":["code"],"text":"schema/"},{"id":"spn-456","text":" — canonical schemas"}]}],"id":"blk-272","kind":"list-item"},{"blocks":[{"id":"blk-275","kind":"paragraph","spans":[{"id":"spn-457","marks":["code"],"text":"examples/"},{"id":"spn-458","text":" — validating example declarations"}]}],"id":"blk-274","kind":"list-item"},{"blocks":[{"id":"blk-277","kind":"paragraph","spans":[{"id":"spn-459","marks":["code"],"text":"reference/"},{"id":"spn-460","text":" — reference implementations"}]}],"id":"blk-276","kind":"list-item"},{"blocks":[{"id":"blk-279","kind":"paragraph","spans":[{"id":"spn-461","marks":["code"],"text":"docs/"},{"id":"spn-462","text":" — supporting documentation"}]}],"id":"blk-278","kind":"list-item"},{"blocks":[{"id":"blk-281","kind":"paragraph","spans":[{"id":"spn-463","marks":["code"],"text":"site/"},{"id":"spn-464","text":" — website/source publishing assets"}]}],"id":"blk-280","kind":"list-item"},{"blocks":[{"id":"blk-283","kind":"paragraph","spans":[{"id":"spn-465","marks":["code"],"text":"tools/"},{"id":"spn-466","text":" — scripts and developer helpers"}]}],"id":"blk-282","kind":"list-item"},{"blocks":[{"id":"blk-285","kind":"paragraph","spans":[{"id":"spn-467","marks":["code"],"text":"prompts/"},{"id":"spn-468","text":" — implementation and research prompts"}]}],"id":"blk-284","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-286","kind":"paragraph","spans":[{"id":"spn-469","text":"If you need to add a new top-level directory, explain why in your pull request."}]},{"id":"blk-287","kind":"heading","level":2,"spans":[{"id":"spn-470","text":"Before you open a pull request"}]},{"id":"blk-288","kind":"paragraph","spans":[{"id":"spn-471","text":"Please make sure your contribution does the following where relevant:"}]},{"id":"blk-289","items":[{"blocks":[{"id":"blk-291","kind":"paragraph","spans":[{"id":"spn-472","text":"keeps terminology consistent with the protocol"}]}],"id":"blk-290","kind":"list-item"},{"blocks":[{"id":"blk-293","kind":"paragraph","spans":[{"id":"spn-473","text":"preserves or improves schema validity"}]}],"id":"blk-292","kind":"list-item"},{"blocks":[{"id":"blk-295","kind":"paragraph","spans":[{"id":"spn-474","text":"includes examples for new protocol concepts"}]}],"id":"blk-294","kind":"list-item"},{"blocks":[{"id":"blk-297","kind":"paragraph","spans":[{"id":"spn-475","text":"includes tests for implementation changes"}]}],"id":"blk-296","kind":"list-item"},{"blocks":[{"id":"blk-299","kind":"paragraph","spans":[{"id":"spn-476","text":"updates docs when behavior changes"}]}],"id":"blk-298","kind":"list-item"},{"blocks":[{"id":"blk-301","kind":"paragraph","spans":[{"id":"spn-477","text":"avoids unrelated formatting churn"}]}],"id":"blk-300","kind":"list-item"},{"blocks":[{"id":"blk-303","kind":"paragraph","spans":[{"id":"spn-478","text":"keeps generated artifacts out of commits unless intentionally checked in"}]}],"id":"blk-302","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-304","kind":"heading","level":2,"spans":[{"id":"spn-479","text":"Specification changes"}]},{"id":"blk-305","kind":"paragraph","spa