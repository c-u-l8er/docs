,"id":"blk-326","kind":"list-item"},{"blocks":[{"id":"blk-329","kind":"paragraph","spans":[{"id":"spn-496","text":"prefer explicit validation rules over vague descriptions"}]}],"id":"blk-328","kind":"list-item"},{"blocks":[{"id":"blk-331","kind":"paragraph","spans":[{"id":"spn-497","text":"include examples where helpful"}]}],"id":"blk-330","kind":"list-item"},{"blocks":[{"id":"blk-333","kind":"paragraph","spans":[{"id":"spn-498","text":"preserve backward compatibility when possible"}]}],"id":"blk-332","kind":"list-item"},{"blocks":[{"id":"blk-335","kind":"paragraph","spans":[{"id":"spn-499","text":"if compatibility must break, document it clearly in the pull request"}]}],"id":"blk-334","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-336","kind":"paragraph","spans":[{"id":"spn-500","text":"If you add a new schema artifact, also add at least one realistic example document that validates against it."}]},{"id":"blk-337","kind":"heading","level":2,"spans":[{"id":"spn-501","text":"Example declaration rules"}]},{"id":"blk-338","kind":"paragraph","spans":[{"id":"spn-502","text":"Example files should be realistic, not toy placeholders."}]},{"id":"blk-339","kind":"paragraph","spans":[{"id":"spn-503","text":"Each example should:"}]},{"id":"blk-340","items":[{"blocks":[{"id":"blk-342","kind":"paragraph","spans":[{"id":"spn-504","text":"reference the canonical schema"}]}],"id":"blk-341","kind":"list-item"},{"blocks":[{"id":"blk-344","kind":"paragraph","spans":[{"id":"spn-505","text":"use realistic capability combinations"}]}],"id":"blk-343","kind":"list-item"},{"blocks":[{"id":"blk-346","kind":"paragraph","spans":[{"id":"spn-506","text":"use meaningful governance and provenance settings where appropriate"}]}],"id":"blk-345","kind":"list-item"},{"blocks":[{"id":"blk-348","kind":"paragraph","spans":[{"id":"spn-507","text":"demonstrate an actual use case"}]}],"id":"blk-347","kind":"list-item"},{"blocks":[{"id":"blk-350","kind":"paragraph","spans":[{"id":"spn-508","text":"validate successfully"}]}],"id":"blk-349","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-351","kind":"paragraph","spans":[{"id":"spn-509","text":"Examples are both documentation and test fixtures."}]},{"id":"blk-352","kind":"heading","level":2,"spans":[{"id":"spn-510","text":"Reference implementation rules"}]},{"id":"blk-353","kind":"paragraph","spans":[{"id":"spn-511","text":"Reference implementations should stay:"}]},{"id":"blk-354","items":[{"blocks":[{"id":"blk-356","kind":"paragraph","spans":[{"id":"spn-512","text":"small"}]}],"id":"blk-355","kind":"list-item"},{"blocks":[{"id":"blk-358","kind":"paragraph","spans":[{"id":"spn-513","text":"readable"}]}],"id":"blk-357","kind":"list-item"},{"blocks":[{"id":"blk-360","kind":"paragraph","spans":[{"id":"spn-514","text":"deterministic"}]}],"id":"blk-359","kind":"list-item"},{"blocks":[{"id":"blk-362","kind":"paragraph","spans":[{"id":"spn-515","text":"well-tested"}]}],"id":"blk-361","kind":"list-item"},{"blocks":[{"id":"blk-364","kind":"paragraph","spans":[{"id":"spn-516","text":"faithful to the spec"}]}],"id":"blk-363","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-365","kind":"paragraph","spans":[{"id":"spn-517","text":"Prefer minimal, explicit implementations over premature abstraction."}]},{"id":"blk-366","kind":"paragraph","spans":[{"id":"spn-518","text":"If you add a new implementation feature, include tests that show:"}]},{"id":"blk-367","items":[{"blocks":[{"id":"blk-369","kind":"paragraph","spans":[{"id":"spn-519","text":"valid behavior"}]}],"id":"blk-368","kind":"list-item"},{"blocks":[{"id":"blk-371","kind":"paragraph","spans":[{"id":"spn-520","text":"invalid behavior"}]}],"id":"blk-370","kind":"list-item"},{"blocks":[{"id":"blk-373","kind":"paragraph","spans":[{"id":"spn-521","text":"edge cases where useful"}]}],"id":"blk-372","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-374","kind":"heading","level":2,"spans":[{"id":"spn-522","text":"Documentation guidelines"}]},{"id":"blk-375","kind":"paragraph","spans":[{"id":"spn-523","text":"Documentation should be:"}]},{"id":"blk-376","items":[{"blocks":[{"id":"blk-378","kind":"paragraph","spans":[{"id":"spn-524","text":"technical but accessible"}]}],"id":"blk-377","kind":"list-item"},{"blocks":[{"id":"blk-380","kind":"paragraph","spans":[{"id":"spn-525","text":"precise about what is implemented vs planned"}]}],"id":"blk-379","kind":"list-item"},{"blocks":[{"id":"blk-382","kind":"paragraph","spans":[{"id":"spn-526","text":"respectful of the surrounding ecosystem"}]}],"id":"blk-381","kind":"list-item"},{"blocks":[{"id":"blk-384","kind":"paragraph","spans":[{"id":"spn-527","text":"light on hype"}]}],"id":"blk-383","kind":"list-item"},{"blocks":[{"id":"blk-386","kind":"paragraph","spans":[{"id":"spn-528","text":"heavy on examples"}]}],"id":"blk-385","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-387","kind":"paragraph","spans":[{"id":"spn-529","text":"Preferred framing:"}]},{"id":"blk-388","items":[{"blocks":[{"id":"blk-390","kind":"paragraph","spans":[{"id":"spn-530","text":"MCP handles agent-to-tool connectivity"}]}],"id":"blk-389","kind":"list-item"},{"blocks":[{"id":"blk-392","kind":"paragraph","spans":[{"id":"spn-531","text":"A2A handles agent-to-agent coordination"}]}],"id":"blk-391","kind":"list-item"},{"blocks":[{"id":"blk-394","kind":"paragraph","spans":[{"id":"spn-532","text":"[&] handles capability composition and compiles into MCP + A2A artifacts"}]}],"id":"blk-393","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-395","kind":"paragraph","spans":[{"id":"spn-533","text":"Avoid framing the protocol as replacing other standards."}]},{"id":"blk-396","kind":"heading","level":2,"spans":[{"id":"spn-534","text":"Commit guidelines"}]},{"id":"blk-397","kind":"paragraph","spans":[{"id":"spn-535","text":"Use clear, focused commits."}]},{"id":"blk-398","kind":"paragraph","spans":[{"id":"spn-536","text":"Good examples:"}]},{"id":"blk-399","items":[{