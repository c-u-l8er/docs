,{"id":"spn-73372","marks":["bold"],"text":"8"},{"id":"spn-73373","text":"; and the correct "},{"id":"spn-73374","marks":["code"],"text":"InstantiationReceipt"},{"id":"spn-73375","text":" accepts only the 7-producing term. Your \"causally meaningful all the way to the outcome\" version."}]},{"id":"blk-41430","items":[{"blocks":[{"id":"blk-41432","kind":"paragraph","spans":[{"id":"spn-73376","text":"Then the "},{"id":"spn-73377","marks":["code"],"text":"add(2,3)"},{"id":"spn-73378","text":" regression restated through "},{"id":"spn-73379","marks":["code"],"text":"instantiate({})"},{"id":"spn-73380","text":" — same ic32 bytes, same film,"}]}],"id":"blk-41431","kind":"list-item"}],"kind":"list","ordered":true,"start":6},{"id":"blk-41433","kind":"paragraph","spans":[{"id":"spn-73381","text":"same outcome — so the layer's arrival is provable rather than assumed."}]},{"id":"blk-41434","kind":"paragraph","spans":[{"id":"spn-73382","text":"Then "},{"id":"spn-73383","marks":["code"],"text":"church_exp_2_2"},{"id":"spn-73384","text":" and the dedicated DUP-ERA fixture."}]}],"edges":[],"id":"bagaaierapicp4bfpo7ih2dy4niwkgzmd5xx6fgq7t77w5umhb4t2a524pdja","vocabulary":"ampersand.docs.fs.v1"}