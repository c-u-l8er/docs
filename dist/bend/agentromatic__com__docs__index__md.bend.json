{"bendscript":"0.1","blocks":[{"id":"blk-56290","kind":"heading","level":1,"spans":[{"id":"spn-84296","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-56292","kind":"paragraph","spans":[{"id":"spn-84297","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-56291","kind":"quote"},{"blocks":[{"id":"blk-56294","kind":"paragraph","spans":[{"id":"spn-84298","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-84299","text":" · "},{"id":"spn-84300","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-84301","text":" · "},{"id":"spn-84302","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-84303","text":" · "},{"id":"spn-84304","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-56293","kind":"quote"},{"id":"blk-56295","kind":"paragraph","spans":[{"id":"spn-84305","text":"Welcome to the documentation hub for "},{"id":"spn-84306","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-84307","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-56296","kind":"paragraph","spans":[{"id":"spn-84308","text":"AgenTroMatic is "},{"id":"spn-84309","marks":["bold"],"text":"not"},{"id":"spn-84310","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-56297","kind":"heading","level":2,"spans":[{"id":"spn-84311","text":"How It Works"}]},{"id":"blk-56298","items":[{"blocks":[{"id":"blk-56300","kind":"paragraph","spans":[{"id":"spn-84312","marks":["bold"],"text":"Task arrives"},{"id":"spn-84313","text":" — submitted via Phoenix API or A2A protocol"}]}],"id":"blk-56299","kind":"list-item"},{"blocks":[{"id":"blk-56302","kind":"paragraph","spans":[{"id":"spn-84314","marks":["bold"],"text":"Agents bid"},{"id":"spn-84315","text":" — each agent evaluates capability fit and submits a bid"}]}],"id":"blk-56301","kind":"list-item"},{"blocks":[{"id":"blk-56304","kind":"paragraph","spans":[{"id":"spn-84316","marks":["bold"],"text":"Deliberation"},{"id":"spn-84317","text":" — overlapping capabilities trigger structured debate"}]}],"id":"blk-56303","kind":"list-item"},{"blocks":[{"id":"blk-56306","kind":"paragraph","spans":[{"id":"spn-84318","marks":["bold"],"text":"Consensus"},{"id":"spn-84319","text":" — Ra (Raft) elects a leader; quorum validates the result"}]}],"id":"blk-56305","kind":"list-item"},{"blocks":[{"id":"blk-56308","kind":"paragraph","spans":[{"id":"spn-84320","marks":["bold"],"text":"Execution"},{"id":"spn-84321","text":" — winning agent executes under governance constraints"}]}],"id":"blk-56307","kind":"list-item"},{"blocks":[{"id":"blk-56310","kind":"paragraph","spans":[{"id":"spn-84322","marks":["bold"],"text":"Reputation update"},{"id":"spn-84323","text":" — outcomes feed back into reputation scores"}]}],"id":"blk-56309","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-56311","kind":"paragraph","spans":[{"id":"spn-84324","text":"AgenTroMatic is the "},{"id":"spn-84325","marks":["bold"],"text":"automation layer"},{"id":"spn-84326","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-56312","kind":"heading","level":2,"spans":[{"id":"spn-84327","text":"Documentation Map"}]},{"id":"blk-56313","kind":"paragraph","spans":[{"id":"spn-84328","marks":["bold"],"text":"Homepages"}]},{"id":"blk-56314","item