{"bendscript":"0.1","blocks":[{"id":"blk-36710","kind":"heading","level":1,"spans":[{"id":"spn-41233","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-36712","kind":"paragraph","spans":[{"id":"spn-41234","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-36711","kind":"quote"},{"blocks":[{"id":"blk-36714","kind":"paragraph","spans":[{"id":"spn-41235","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-41236","text":" · "},{"id":"spn-41237","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-41238","text":" · "},{"id":"spn-41239","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-41240","text":" · "},{"id":"spn-41241","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-36713","kind":"quote"},{"id":"blk-36715","kind":"paragraph","spans":[{"id":"spn-41242","text":"Welcome to the documentation hub for "},{"id":"spn-41243","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-41244","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-36716","kind":"paragraph","spans":[{"id":"spn-41245","text":"AgenTroMatic is "},{"id":"spn-41246","marks":["bold"],"text":"not"},{"id":"spn-41247","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-36717","kind":"paragraph","spans":[{"id":"spn-41248","text":"---"}]},{"id":"blk-36718","kind":"heading","level":2,"spans":[{"id":"spn-41249","text":"How It Works"}]},{"id":"blk-36719","kind":"paragraph","spans":[{"id":"spn-41250","text":"1. "},{"id":"spn-41251","marks":["bold"],"text":"Task arrives"},{"id":"spn-41252","text":" — submitted via Phoenix API or A2A protocol 2. "},{"id":"spn-41253","marks":["bold"],"text":"Agents bid"},{"id":"spn-41254","text":" — each agent evaluates capability fit and submits a bid 3. "},{"id":"spn-41255","marks":["bold"],"text":"Deliberation"},{"id":"spn-41256","text":" — overlapping capabilities trigger structured debate 4. "},{"id":"spn-41257","marks":["bold"],"text":"Consensus"},{"id":"spn-41258","text":" — Ra (Raft) elects a leader; quorum validates the result 5. "},{"id":"spn-41259","marks":["bold"],"text":"Execution"},{"id":"spn-41260","text":" — winning agent executes under governance constraints 6. "},{"id":"spn-41261","marks":["bold"],"text":"Reputation update"},{"id":"spn-41262","text":" — outcomes feed back into reputation scores"}]},{"id":"blk-36720","kind":"paragraph","spans":[{"id":"spn-41263","text":"AgenTroMatic is the "},{"id":"spn-41264","marks":["bold"],"text":"automation layer"},{"id":"spn-41265","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-36721","kind":"paragraph","spans":[{"id":"spn-41266","text":"---"}]},{"id":"blk-36722","kind":"heading","level":2,"spans":[{"id":"spn-41267","text":"Documentation Map"}]},{"id":"blk-36723","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-36724","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-36725","kind":"code","language":"text","text":":maxdepth: 2\n:caption: AgenTroMatic Docs\n\nspec/README"},{"id":"blk-36726","kind":"paragraph","spans":[{"id":"spn-41268","text":"---"}]},{"id":"blk-36727","kind":"heading","level":2,"spans":[{"id":"spn-41269","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-36729","spans":[{"id":"spn-41270","text":"Component"}]},{"id":"blk-36730","spans":[{"id":"spn-41271","text":"Role"}]},{"id":"blk-36731","spans":[{"id":"spn-41272","text":"OTP Pattern"}]}],"id":"blk-36728","kind":"table","rows":[[{"id":"blk-36732","spans":[{"id":"spn-41273","marks":["bold"],"text":"Deliberation Supervisor"}]},{"id":"blk-36733","spans":[{"id":"spn-41274","text":"Spawns one process per deliberation"}]},{"id":"blk-36734","spans":[{"id":"spn-41275","text":"DynamicSupervisor"}]}],[{"id":"blk-36735","spans":[{"id":"spn-41276","marks":["bold"],"text":"Reputation Engine"}]},{"id":"blk-36736","spans":[{"id":"spn-41277","text":"Tracks agent performance via ETS cache"}]},{"id":"blk-36737","spans":[{"id":"spn-41278","text":"GenServer + ETS"}]}],[{"id":"blk-36738","spans":[{"id":"spn-41279","marks":["bold"],"text":"A2A Gateway"}]},{"id":"blk-36739","spans":[{"id":"spn-41280","text":"HTTP client per agent for inter-agent comms"}]},{"id":"blk-36740","spans":[{"id":"spn-41281","text":"Req/Finch"}]}],[{"id":"blk-36741","spans":[{"id":"spn-41282","marks":["bold"],"text":"Observatory"}]},{"id":"blk-36742","spans":[{"id":"spn-41283","text":"Real-time deliberation streaming UI"}]},{"id":"blk-36743","spans":[{"id":"spn-41284","text":"Phoenix LiveView"}]}],[{"id":"blk-36744","spans":[{"id":"spn-41285","marks":["bold"],"text":"Ra Consensus"}]},{"id":"blk-36745","spans":[{"id":"spn-41286","text":"Leader election and log replication"}]},{"id":"blk-36746","spans":[{"id":"spn-41287","text":"Ra (Raft)"}]}]]},{"id":"blk-36747","kind":"paragraph","spans":[{"id":"spn-41288","text":"---"}]},{"id":"blk-36748","kind":"heading","level":2,"spans":[{"id":"spn-41289","text":"Design Principles"}]},{"id":"blk-36749","kind":"paragraph","spans":[{"id":"spn-41290","text":"1. "},{"id":"spn-41291","marks":["bold"],"text":"Deliberation over routing"},{"id":"spn-41292","text":" — Static routing is the wrong abstraction for overlapping, evolving capabilities. Agents negotiate every time. 2. "},{"id":"spn-41293","marks":["bold"],"text":"A2A-native"},{"id":"spn-41294","text":" — Every inter-agent message flows through standard A2A protocol. 3. "},{"id":"spn-41295","marks":["bold"],"text":"Reputation is memory"},{"id":"spn-41296","text":" — Past performance shapes future assignments. Overconfident agents lose weight. 4. "},{"id":"spn-41297","marks":["bold"],"text":"Visible by default"},{"id":"spn-41298","text":" — Every deliberation is traceable. The Observatory is not optional — it's the product. 5. "},{"id":"spn-41299","marks":["bold"],"text":"Consensus before commit"},{"id":"spn-41300","text":" — Results publish only when quorum validates. 6. "},{"id":"spn-41301","marks":["bold"],"text":"Ra under the hood"},{"id":"spn-41302","text":" — Battle-tested Raft from RabbitMQ."}]},{"id":"blk-36750","kind":"paragraph","spans":[{"id":"spn-41303","text":"---"}]},{"id":"blk-36751","kind":"heading","level":2,"spans":[{"id":"spn-41304","text":"Tech Stack"}]},{"head":[{"id":"blk-36753","spans":[{"id":"spn-41305","text":"Layer"}]},{"id":"blk-36754","spans":[{"id":"spn-41306","text":"Technology"}]}],"id":"blk-36752","kind":"table","rows":[[{"id":"blk-36755","spans":[{"id":"spn-41307","text":"Language"}]},{"id":"blk-36756","spans":[{"id":"spn-41308","text":"Elixir 1.17+"}]}],[{"id":"blk-36757","spans":[{"id":"spn-41309","text":"Framework"}]},{"id":"blk-36758","spans":[{"id":"spn-41310","text":"Phoenix 1.8+ (LiveView for Observatory)"}]}],[{"id":"blk-36759","spans":[{"id":"spn-41311","text":"Consensus"}]},{"id":"blk-36760","spans":[{"id":"spn-41312","text":"Ra (Raft library from RabbitMQ)"}]}],[{"id":"blk-36761","spans":[{"id":"spn-41313","text":"Database"}]},{"id":"blk-36762","spans":[{"id":"spn-41314","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-36763","spans":[{"id":"spn-41315","text":"Hot Cache"}]},{"id":"blk-36764","spans":[{"id":"spn-41316","text":"ETS (reputation lookups)"}]}],[{"id":"blk-36765","spans":[{"id":"spn-41317","text":"Agent Comms"}]},{"id":"blk-36766","spans":[{"id":"spn-41318","text":"A2A v0.3+ via Req/Finch"}]}]]},{"id":"blk-36767","kind":"paragraph","spans":[{"id":"spn-41319","text":"---"}]},{"id":"blk-36768","kind":"heading","level":2,"spans":[{"id":"spn-41320","text":"Project Links"}]},{"id":"blk-36769","items":[{"blocks":[{"id":"blk-36771","kind":"paragraph","spans":[{"id":"spn-41321","marks":["bold"],"text":"Spec:"},{"id":"spn-41322","text":" "},{"id":"spn-41323","marks":[{"kind":"link","predicate":"cites","target":"#/agentromatic.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-36770","kind":"list-item"},{"blocks":[{"id":"blk-36773","kind":"paragraph","spans":[{"id":"spn-41324","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-41325","text":" "},{"id":"spn-41326","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-36772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36774","kind":"paragraph","spans":[{"id":"spn-41327","text":"---"}]},{"id":"blk-36775","kind":"paragraph","spans":[{"id":"spn-41328","text":"*[&] Ampersand Box Design — agentromatic.com*"}]}],"edges":[],"id":"bagaaierau6fbpznwlrvjp6qdyjmi7hbejsrn5mlwgq7ptdyf7oj6p55g3osq","vocabulary":"ampersand.docs.fs.v1"}