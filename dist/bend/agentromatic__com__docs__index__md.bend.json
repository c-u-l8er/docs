{"bendscript":"0.1","blocks":[{"id":"blk-55535","kind":"heading","level":1,"spans":[{"id":"spn-81845","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-55537","kind":"paragraph","spans":[{"id":"spn-81846","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-55536","kind":"quote"},{"blocks":[{"id":"blk-55539","kind":"paragraph","spans":[{"id":"spn-81847","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-81848","text":" · "},{"id":"spn-81849","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-81850","text":" · "},{"id":"spn-81851","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-81852","text":" · "},{"id":"spn-81853","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-55538","kind":"quote"},{"id":"blk-55540","kind":"paragraph","spans":[{"id":"spn-81854","text":"Welcome to the documentation hub for "},{"id":"spn-81855","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-81856","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-55541","kind":"paragraph","spans":[{"id":"spn-81857","text":"AgenTroMatic is "},{"id":"spn-81858","marks":["bold"],"text":"not"},{"id":"spn-81859","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-55542","kind":"heading","level":2,"spans":[{"id":"spn-81860","text":"How It Works"}]},{"id":"blk-55543","items":[{"blocks":[{"id":"blk-55545","kind":"paragraph","spans":[{"id":"spn-81861","marks":["bold"],"text":"Task arrives"},{"id":"spn-81862","text":" — submitted via Phoenix API or A2A protocol"}]}],"id":"blk-55544","kind":"list-item"},{"blocks":[{"id":"blk-55547","kind":"paragraph","spans":[{"id":"spn-81863","marks":["bold"],"text":"Agents bid"},{"id":"spn-81864","text":" — each agent evaluates capability fit and submits a bid"}]}],"id":"blk-55546","kind":"list-item"},{"blocks":[{"id":"blk-55549","kind":"paragraph","spans":[{"id":"spn-81865","marks":["bold"],"text":"Deliberation"},{"id":"spn-81866","text":" — overlapping capabilities trigger structured debate"}]}],"id":"blk-55548","kind":"list-item"},{"blocks":[{"id":"blk-55551","kind":"paragraph","spans":[{"id":"spn-81867","marks":["bold"],"text":"Consensus"},{"id":"spn-81868","text":" — Ra (Raft) elects a leader; quorum validates the result"}]}],"id":"blk-55550","kind":"list-item"},{"blocks":[{"id":"blk-55553","kind":"paragraph","spans":[{"id":"spn-81869","marks":["bold"],"text":"Execution"},{"id":"spn-81870","text":" — winning agent executes under governance constraints"}]}],"id":"blk-55552","kind":"list-item"},{"blocks":[{"id":"blk-55555","kind":"paragraph","spans":[{"id":"spn-81871","marks":["bold"],"text":"Reputation update"},{"id":"spn-81872","text":" — outcomes feed back into reputation scores"}]}],"id":"blk-55554","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-55556","kind":"paragraph","spans":[{"id":"spn-81873","text":"AgenTroMatic is the "},{"id":"spn-81874","marks":["bold"],"text":"automation layer"},{"id":"spn-81875","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-55557","kind":"heading","level":2,"spans":[{"id":"spn-81876","text":"Documentation Map"}]},{"id":"blk-55558","kind":"paragraph","spans":[{"id":"spn-81877","marks":["bold"],"text":"Homepages"}]},{"id":"blk-55559","item