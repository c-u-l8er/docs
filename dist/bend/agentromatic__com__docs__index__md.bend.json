{"bendscript":"0.1","blocks":[{"id":"blk-36224","kind":"heading","level":1,"spans":[{"id":"spn-40117","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-36226","kind":"paragraph","spans":[{"id":"spn-40118","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-36225","kind":"quote"},{"blocks":[{"id":"blk-36228","kind":"paragraph","spans":[{"id":"spn-40119","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-40120","text":" · "},{"id":"spn-40121","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-40122","text":" · "},{"id":"spn-40123","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-40124","text":" · "},{"id":"spn-40125","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-36227","kind":"quote"},{"id":"blk-36229","kind":"paragraph","spans":[{"id":"spn-40126","text":"Welcome to the documentation hub for "},{"id":"spn-40127","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-40128","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-36230","kind":"paragraph","spans":[{"id":"spn-40129","text":"AgenTroMatic is "},{"id":"spn-40130","marks":["bold"],"text":"not"},{"id":"spn-40131","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-36231","kind":"paragraph","spans":[{"id":"spn-40132","text":"---"}]},{"id":"blk-36232","kind":"heading","level":2,"spans":[{"id":"spn-40133","text":"How It Works"}]},{"id":"blk-36233","kind":"paragraph","spans":[{"id":"spn-40134","text":"1. "},{"id":"spn-40135","marks":["bold"],"text":"Task arrives"},{"id":"spn-40136","text":" — submitted via Phoenix API or A2A protocol 2. "},{"id":"spn-40137","marks":["bold"],"text":"Agents bid"},{"id":"spn-40138","text":" — each agent evaluates capability fit and submits a bid 3. "},{"id":"spn-40139","marks":["bold"],"text":"Deliberation"},{"id":"spn-40140","text":" — overlapping capabilities trigger structured debate 4. "},{"id":"spn-40141","marks":["bold"],"text":"Consensus"},{"id":"spn-40142","text":" — Ra (Raft) elects a leader; quorum validates the result 5. "},{"id":"spn-40143","marks":["bold"],"text":"Execution"},{"id":"spn-40144","text":" — winning agent executes under governance constraints 6. "},{"id":"spn-40145","marks":["bold"],"text":"Reputation update"},{"id":"spn-40146","text":" — outcomes feed back into reputation scores"}]},{"id":"blk-36234","kind":"paragraph","spans":[{"id":"spn-40147","text":"AgenTroMatic is the "},{"id":"spn-40148","marks":["bold"],"text":"automation layer"},{"id":"spn-40149","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-36235","kind":"paragraph","spans":[{"id":"spn-40150","text":"---"}]},{"id":"blk-36236","kind":"heading","level":2,"spans":[{"id":"spn-40151","text":"Documentation Map"}]},{"id":"blk-36237","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-36238","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-36239","kind":"code","language":"text","text":":maxdepth: 2\n:caption: AgenTroMatic Docs\n\nspec/README"},{"id":"blk-36240","kind":"paragraph","spans":[{"id":"spn-40152","text":"---"}]},{"id":"blk-36241","kind":"heading","level":2,"spans":[{"id":"spn-40153","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-36243","spans":[{"id":"spn-40154","text":"Component"}]},{"id":"blk-36244","spans":[{"id":"spn-40155","text":"Role"}]},{"id":"blk-36245","spans":[{"id":"spn-40156","text":"OTP Pattern"}]}],"id":"blk-36242","kind":"table","rows":[[{"id":"blk-36246","spans":[{"id":"spn-40157","marks":["bold"],"text":"Deliberation Supervisor"}]},{"id":"blk-36247","spans":[{"id":"spn-40158","text":"Spawns one process per deliberation"}]},{"id":"blk-36248","spans":[{"id":"spn-40159","text":"DynamicSupervisor"}]}],[{"id":"blk-36249","spans":[{"id":"spn-40160","marks":["bold"],"text":"Reputation Engine"}]},{"id":"blk-36250","spans":[{"id":"spn-40161","text":"Tracks agent performance via ETS cache"}]},{"id":"blk-36251","spans":[{"id":"spn-40162","text":"GenServer + ETS"}]}],[{"id":"blk-36252","spans":[{"id":"spn-40163","marks":["bold"],"text":"A2A Gateway"}]},{"id":"blk-36253","spans":[{"id":"spn-40164","text":"HTTP client per agent for inter-agent comms"}]},{"id":"blk-36254","spans":[{"id":"spn-40165","text":"Req/Finch"}]}],[{"id":"blk-36255","spans":[{"id":"spn-40166","marks":["bold"],"text":"Observatory"}]},{"id":"blk-36256","spans":[{"id":"spn-40167","text":"Real-time deliberation streaming UI"}]},{"id":"blk-36257","spans":[{"id":"spn-40168","text":"Phoenix LiveView"}]}],[{"id":"blk-36258","spans":[{"id":"spn-40169","marks":["bold"],"text":"Ra Consensus"}]},{"id":"blk-36259","spans":[{"id":"spn-40170","text":"Leader election and log replication"}]},{"id":"blk-36260","spans":[{"id":"spn-40171","text":"Ra (Raft)"}]}]]},{"id":"blk-36261","kind":"paragraph","spans":[{"id":"spn-40172","text":"---"}]},{"id":"blk-36262","kind":"heading","level":2,"spans":[{"id":"spn-40173","text":"Design Principles"}]},{"id":"blk-36263","kind":"paragraph","spans":[{"id":"spn-40174","text":"1. "},{"id":"spn-40175","marks":["bold"],"text":"Deliberation over routing"},{"id":"spn-40176","text":" — Static routing is the wrong abstraction for overlapping, evolving capabilities. Agents negotiate every time. 2. "},{"id":"spn-40177","marks":["bold"],"text":"A2A-native"},{"id":"spn-40178","text":" — Every inter-agent message flows through standard A2A protocol. 3. "},{"id":"spn-40179","marks":["bold"],"text":"Reputation is memory"},{"id":"spn-40180","text":" — Past performance shapes future assignments. Overconfident agents lose weight. 4. "},{"id":"spn-40181","marks":["bold"],"text":"Visible by default"},{"id":"spn-40182","text":" — Every deliberation is traceable. The Observatory is not optional — it's the product. 5. "},{"id":"spn-40183","marks":["bold"],"text":"Consensus before commit"},{"id":"spn-40184","text":" — Results publish only when quorum validates. 6. "},{"id":"spn-40185","marks":["bold"],"text":"Ra under the hood"},{"id":"spn-40186","text":" — Battle-tested Raft from RabbitMQ."}]},{"id":"blk-36264","kind":"paragraph","spans":[{"id":"spn-40187","text":"---"}]},{"id":"blk-36265","kind":"heading","level":2,"spans":[{"id":"spn-40188","text":"Tech Stack"}]},{"head":[{"id":"blk-36267","spans":[{"id":"spn-40189","text":"Layer"}]},{"id":"blk-36268","spans":[{"id":"spn-40190","text":"Technology"}]}],"id":"blk-36266","kind":"table","rows":[[{"id":"blk-36269","spans":[{"id":"spn-40191","text":"Language"}]},{"id":"blk-36270","spans":[{"id":"spn-40192","text":"Elixir 1.17+"}]}],[{"id":"blk-36271","spans":[{"id":"spn-40193","text":"Framework"}]},{"id":"blk-36272","spans":[{"id":"spn-40194","text":"Phoenix 1.8+ (LiveView for Observatory)"}]}],[{"id":"blk-36273","spans":[{"id":"spn-40195","text":"Consensus"}]},{"id":"blk-36274","spans":[{"id":"spn-40196","text":"Ra (Raft library from RabbitMQ)"}]}],[{"id":"blk-36275","spans":[{"id":"spn-40197","text":"Database"}]},{"id":"blk-36276","spans":[{"id":"spn-40198","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-36277","spans":[{"id":"spn-40199","text":"Hot Cache"}]},{"id":"blk-36278","spans":[{"id":"spn-40200","text":"ETS (reputation lookups)"}]}],[{"id":"blk-36279","spans":[{"id":"spn-40201","text":"Agent Comms"}]},{"id":"blk-36280","spans":[{"id":"spn-40202","text":"A2A v0.3+ via Req/Finch"}]}]]},{"id":"blk-36281","kind":"paragraph","spans":[{"id":"spn-40203","text":"---"}]},{"id":"blk-36282","kind":"heading","level":2,"spans":[{"id":"spn-40204","text":"Project Links"}]},{"id":"blk-36283","items":[{"blocks":[{"id":"blk-36285","kind":"paragraph","spans":[{"id":"spn-40205","marks":["bold"],"text":"Spec:"},{"id":"spn-40206","text":" "},{"id":"spn-40207","marks":[{"kind":"link","predicate":"cites","target":"#/agentromatic.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-36284","kind":"list-item"},{"blocks":[{"id":"blk-36287","kind":"paragraph","spans":[{"id":"spn-40208","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-40209","text":" "},{"id":"spn-40210","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-36286","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-36288","kind":"paragraph","spans":[{"id":"spn-40211","text":"---"}]},{"id":"blk-36289","kind":"paragraph","spans":[{"id":"spn-40212","text":"*[&] Ampersand Box Design — agentromatic.com*"}]}],"edges":[],"id":"bagaaieraluihgrlm36rcfimnbo2nunfmcbthy4hh5bnukdb2gr23owvbnpoa","vocabulary":"ampersand.docs.fs.v1"}