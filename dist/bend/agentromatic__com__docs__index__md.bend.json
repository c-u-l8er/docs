{"bendscript":"0.1","blocks":[{"id":"blk-55409","kind":"heading","level":1,"spans":[{"id":"spn-81697","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-55411","kind":"paragraph","spans":[{"id":"spn-81698","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-55410","kind":"quote"},{"blocks":[{"id":"blk-55413","kind":"paragraph","spans":[{"id":"spn-81699","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-81700","text":" · "},{"id":"spn-81701","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-81702","text":" · "},{"id":"spn-81703","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-81704","text":" · "},{"id":"spn-81705","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-55412","kind":"quote"},{"id":"blk-55414","kind":"paragraph","spans":[{"id":"spn-81706","text":"Welcome to the documentation hub for "},{"id":"spn-81707","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-81708","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-55415","kind":"paragraph","spans":[{"id":"spn-81709","text":"AgenTroMatic is "},{"id":"spn-81710","marks":["bold"],"text":"not"},{"id":"spn-81711","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-55416","kind":"heading","level":2,"spans":[{"id":"spn-81712","text":"How It Works"}]},{"id":"blk-55417","items":[{"blocks":[{"id":"blk-55419","kind":"paragraph","spans":[{"id":"spn-81713","marks":["bold"],"text":"Task arrives"},{"id":"spn-81714","text":" — submitted via Phoenix API or A2A protocol"}]}],"id":"blk-55418","kind":"list-item"},{"blocks":[{"id":"blk-55421","kind":"paragraph","spans":[{"id":"spn-81715","marks":["bold"],"text":"Agents bid"},{"id":"spn-81716","text":" — each agent evaluates capability fit and submits a bid"}]}],"id":"blk-55420","kind":"list-item"},{"blocks":[{"id":"blk-55423","kind":"paragraph","spans":[{"id":"spn-81717","marks":["bold"],"text":"Deliberation"},{"id":"spn-81718","text":" — overlapping capabilities trigger structured debate"}]}],"id":"blk-55422","kind":"list-item"},{"blocks":[{"id":"blk-55425","kind":"paragraph","spans":[{"id":"spn-81719","marks":["bold"],"text":"Consensus"},{"id":"spn-81720","text":" — Ra (Raft) elects a leader; quorum validates the result"}]}],"id":"blk-55424","kind":"list-item"},{"blocks":[{"id":"blk-55427","kind":"paragraph","spans":[{"id":"spn-81721","marks":["bold"],"text":"Execution"},{"id":"spn-81722","text":" — winning agent executes under governance constraints"}]}],"id":"blk-55426","kind":"list-item"},{"blocks":[{"id":"blk-55429","kind":"paragraph","spans":[{"id":"spn-81723","marks":["bold"],"text":"Reputation update"},{"id":"spn-81724","text":" — outcomes feed back into reputation scores"}]}],"id":"blk-55428","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-55430","kind":"paragraph","spans":[{"id":"spn-81725","text":"AgenTroMatic is the "},{"id":"spn-81726","marks":["bold"],"text":"automation layer"},{"id":"spn-81727","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-55431","kind":"heading","level":2,"spans":[{"id":"spn-81728","text":"Documentation Map"}]},{"id":"blk-55432","kind":"paragraph","spans":[{"id":"spn-81729","marks":["bold"],"text":"Homepages"}]},{"id":"blk-55433","item