{"bendscript":"0.1","blocks":[{"id":"blk-35629","kind":"heading","level":1,"spans":[{"id":"spn-38315","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-35631","kind":"paragraph","spans":[{"id":"spn-38316","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-35630","kind":"quote"},{"blocks":[{"id":"blk-35633","kind":"paragraph","spans":[{"id":"spn-38317","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-38318","text":" · "},{"id":"spn-38319","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-38320","text":" · "},{"id":"spn-38321","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-38322","text":" · "},{"id":"spn-38323","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-35632","kind":"quote"},{"id":"blk-35634","kind":"paragraph","spans":[{"id":"spn-38324","text":"Welcome to the documentation hub for "},{"id":"spn-38325","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-38326","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-35635","kind":"paragraph","spans":[{"id":"spn-38327","text":"AgenTroMatic is "},{"id":"spn-38328","marks":["bold"],"text":"not"},{"id":"spn-38329","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-35636","kind":"paragraph","spans":[{"id":"spn-38330","text":"---"}]},{"id":"blk-35637","kind":"heading","level":2,"spans":[{"id":"spn-38331","text":"How It Works"}]},{"id":"blk-35638","kind":"paragraph","spans":[{"id":"spn-38332","text":"1. "},{"id":"spn-38333","marks":["bold"],"text":"Task arrives"},{"id":"spn-38334","text":" — submitted via Phoenix API or A2A protocol 2. "},{"id":"spn-38335","marks":["bold"],"text":"Agents bid"},{"id":"spn-38336","text":" — each agent evaluates capability fit and submits a bid 3. "},{"id":"spn-38337","marks":["bold"],"text":"Deliberation"},{"id":"spn-38338","text":" — overlapping capabilities trigger structured debate 4. "},{"id":"spn-38339","marks":["bold"],"text":"Consensus"},{"id":"spn-38340","text":" — Ra (Raft) elects a leader; quorum validates the result 5. "},{"id":"spn-38341","marks":["bold"],"text":"Execution"},{"id":"spn-38342","text":" — winning agent executes under governance constraints 6. "},{"id":"spn-38343","marks":["bold"],"text":"Reputation update"},{"id":"spn-38344","text":" — outcomes feed back into reputation scores"}]},{"id":"blk-35639","kind":"paragraph","spans":[{"id":"spn-38345","text":"AgenTroMatic is the "},{"id":"spn-38346","marks":["bold"],"text":"automation layer"},{"id":"spn-38347","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-35640","kind":"paragraph","spans":[{"id":"spn-38348","text":"---"}]},{"id":"blk-35641","kind":"heading","level":2,"spans":[{"id":"spn-38349","text":"Documentation Map"}]},{"id":"blk-35642","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-35643","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-35644","kind":"code","language":"text","text":":maxdepth: 2\n:caption: AgenTroMatic Docs\n\nspec/README"},{"id":"blk-35645","kind":"paragraph","spans":[{"id":"spn-38350","text":"---"}]},{"id":"blk-35646","kind":"heading","level":2,"spans":[{"id":"spn-38351","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-35648","spans":[{"id":"spn-38352","text":"Component"}]},{"id":"blk-35649","spans":[{"id":"spn-38353","text":"Role"}]},{"id":"blk-35650","spans":[{"id":"spn-38354","text":"OTP Pattern"}]}],"id":"blk-35647","kind":"table","rows":[[{"id":"blk-35651","spans":[{"id":"spn-38355","marks":["bold"],"text":"Deliberation Supervisor"}]},{"id":"blk-35652","spans":[{"id":"spn-38356","text":"Spawns one process per deliberation"}]},{"id":"blk-35653","spans":[{"id":"spn-38357","text":"DynamicSupervisor"}]}],[{"id":"blk-35654","spans":[{"id":"spn-38358","marks":["bold"],"text":"Reputation Engine"}]},{"id":"blk-35655","spans":[{"id":"spn-38359","text":"Tracks agent performance via ETS cache"}]},{"id":"blk-35656","spans":[{"id":"spn-38360","text":"GenServer + ETS"}]}],[{"id":"blk-35657","spans":[{"id":"spn-38361","marks":["bold"],"text":"A2A Gateway"}]},{"id":"blk-35658","spans":[{"id":"spn-38362","text":"HTTP client per agent for inter-agent comms"}]},{"id":"blk-35659","spans":[{"id":"spn-38363","text":"Req/Finch"}]}],[{"id":"blk-35660","spans":[{"id":"spn-38364","marks":["bold"],"text":"Observatory"}]},{"id":"blk-35661","spans":[{"id":"spn-38365","text":"Real-time deliberation streaming UI"}]},{"id":"blk-35662","spans":[{"id":"spn-38366","text":"Phoenix LiveView"}]}],[{"id":"blk-35663","spans":[{"id":"spn-38367","marks":["bold"],"text":"Ra Consensus"}]},{"id":"blk-35664","spans":[{"id":"spn-38368","text":"Leader election and log replication"}]},{"id":"blk-35665","spans":[{"id":"spn-38369","text":"Ra (Raft)"}]}]]},{"id":"blk-35666","kind":"paragraph","spans":[{"id":"spn-38370","text":"---"}]},{"id":"blk-35667","kind":"heading","level":2,"spans":[{"id":"spn-38371","text":"Design Principles"}]},{"id":"blk-35668","kind":"paragraph","spans":[{"id":"spn-38372","text":"1. "},{"id":"spn-38373","marks":["bold"],"text":"Deliberation over routing"},{"id":"spn-38374","text":" — Static routing is the wrong abstraction for overlapping, evolving capabilities. Agents negotiate every time. 2. "},{"id":"spn-38375","marks":["bold"],"text":"A2A-native"},{"id":"spn-38376","text":" — Every inter-agent message flows through standard A2A protocol. 3. "},{"id":"spn-38377","marks":["bold"],"text":"Reputation is memory"},{"id":"spn-38378","text":" — Past performance shapes future assignments. Overconfident agents lose weight. 4. "},{"id":"spn-38379","marks":["bold"],"text":"Visible by default"},{"id":"spn-38380","text":" — Every deliberation is traceable. The Observatory is not optional — it's the product. 5. "},{"id":"spn-38381","marks":["bold"],"text":"Consensus before commit"},{"id":"spn-38382","text":" — Results publish only when quorum validates. 6. "},{"id":"spn-38383","marks":["bold"],"text":"Ra under the hood"},{"id":"spn-38384","text":" — Battle-tested Raft from RabbitMQ."}]},{"id":"blk-35669","kind":"paragraph","spans":[{"id":"spn-38385","text":"---"}]},{"id":"blk-35670","kind":"heading","level":2,"spans":[{"id":"spn-38386","text":"Tech Stack"}]},{"head":[{"id":"blk-35672","spans":[{"id":"spn-38387","text":"Layer"}]},{"id":"blk-35673","spans":[{"id":"spn-38388","text":"Technology"}]}],"id":"blk-35671","kind":"table","rows":[[{"id":"blk-35674","spans":[{"id":"spn-38389","text":"Language"}]},{"id":"blk-35675","spans":[{"id":"spn-38390","text":"Elixir 1.17+"}]}],[{"id":"blk-35676","spans":[{"id":"spn-38391","text":"Framework"}]},{"id":"blk-35677","spans":[{"id":"spn-38392","text":"Phoenix 1.8+ (LiveView for Observatory)"}]}],[{"id":"blk-35678","spans":[{"id":"spn-38393","text":"Consensus"}]},{"id":"blk-35679","spans":[{"id":"spn-38394","text":"Ra (Raft library from RabbitMQ)"}]}],[{"id":"blk-35680","spans":[{"id":"spn-38395","text":"Database"}]},{"id":"blk-35681","spans":[{"id":"spn-38396","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-35682","spans":[{"id":"spn-38397","text":"Hot Cache"}]},{"id":"blk-35683","spans":[{"id":"spn-38398","text":"ETS (reputation lookups)"}]}],[{"id":"blk-35684","spans":[{"id":"spn-38399","text":"Agent Comms"}]},{"id":"blk-35685","spans":[{"id":"spn-38400","text":"A2A v0.3+ via Req/Finch"}]}]]},{"id":"blk-35686","kind":"paragraph","spans":[{"id":"spn-38401","text":"---"}]},{"id":"blk-35687","kind":"heading","level":2,"spans":[{"id":"spn-38402","text":"Project Links"}]},{"id":"blk-35688","items":[{"blocks":[{"id":"blk-35690","kind":"paragraph","spans":[{"id":"spn-38403","marks":["bold"],"text":"Spec:"},{"id":"spn-38404","text":" "},{"id":"spn-38405","marks":[{"kind":"link","predicate":"cites","target":"#/agentromatic.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-35689","kind":"list-item"},{"blocks":[{"id":"blk-35692","kind":"paragraph","spans":[{"id":"spn-38406","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-38407","text":" "},{"id":"spn-38408","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-35691","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-35693","kind":"paragraph","spans":[{"id":"spn-38409","text":"---"}]},{"id":"blk-35694","kind":"paragraph","spans":[{"id":"spn-38410","text":"*[&] Ampersand Box Design — agentromatic.com*"}]}],"edges":[],"id":"bagaaierayczienepr6zehximnuj4kdcjacncp3fvoxijphjrxlncv6dwpmvq","vocabulary":"ampersand.docs.fs.v1"}