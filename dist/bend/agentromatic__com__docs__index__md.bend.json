{"bendscript":"0.1","blocks":[{"id":"blk-35739","kind":"heading","level":1,"spans":[{"id":"spn-38944","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-35741","kind":"paragraph","spans":[{"id":"spn-38945","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-35740","kind":"quote"},{"blocks":[{"id":"blk-35743","kind":"paragraph","spans":[{"id":"spn-38946","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-38947","text":" · "},{"id":"spn-38948","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-38949","text":" · "},{"id":"spn-38950","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-38951","text":" · "},{"id":"spn-38952","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-35742","kind":"quote"},{"id":"blk-35744","kind":"paragraph","spans":[{"id":"spn-38953","text":"Welcome to the documentation hub for "},{"id":"spn-38954","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-38955","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-35745","kind":"paragraph","spans":[{"id":"spn-38956","text":"AgenTroMatic is "},{"id":"spn-38957","marks":["bold"],"text":"not"},{"id":"spn-38958","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-35746","kind":"paragraph","spans":[{"id":"spn-38959","text":"---"}]},{"id":"blk-35747","kind":"heading","level":2,"spans":[{"id":"spn-38960","text":"How It Works"}]},{"id":"blk-35748","kind":"paragraph","spans":[{"id":"spn-38961","text":"1. "},{"id":"spn-38962","marks":["bold"],"text":"Task arrives"},{"id":"spn-38963","text":" — submitted via Phoenix API or A2A protocol 2. "},{"id":"spn-38964","marks":["bold"],"text":"Agents bid"},{"id":"spn-38965","text":" — each agent evaluates capability fit and submits a bid 3. "},{"id":"spn-38966","marks":["bold"],"text":"Deliberation"},{"id":"spn-38967","text":" — overlapping capabilities trigger structured debate 4. "},{"id":"spn-38968","marks":["bold"],"text":"Consensus"},{"id":"spn-38969","text":" — Ra (Raft) elects a leader; quorum validates the result 5. "},{"id":"spn-38970","marks":["bold"],"text":"Execution"},{"id":"spn-38971","text":" — winning agent executes under governance constraints 6. "},{"id":"spn-38972","marks":["bold"],"text":"Reputation update"},{"id":"spn-38973","text":" — outcomes feed back into reputation scores"}]},{"id":"blk-35749","kind":"paragraph","spans":[{"id":"spn-38974","text":"AgenTroMatic is the "},{"id":"spn-38975","marks":["bold"],"text":"automation layer"},{"id":"spn-38976","text":" of the [&] Protocol ecosystem — the service mesh that adds consensus, resilience, observability, and governance on top of Google's A2A protocol."}]},{"id":"blk-35750","kind":"paragraph","spans":[{"id":"spn-38977","text":"---"}]},{"id":"blk-35751","kind":"heading","level":2,"spans":[{"id":"spn-38978","text":"Documentation Map"}]},{"id":"blk-35752","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Homepages\n\n[&] Ampersand Box <https://ampersandboxdesign.com>\nGraphonomous <https://graphonomous.com>\nBendScript <https://bendscript.com>\nWebHost.Systems <https://webhost.systems>\nAgentelic <https://agentelic.com>\nAgenTroMatic <https://agentromatic.com>\nDelegatic <https://delegatic.com>\nDeliberatic <https://deliberatic.com>\nFleetPrompt <https://fleetprompt.com>\nGeoFleetic <https://geofleetic.com>\nOpenSentience <https://opensentience.org>\nSpecPrompt <https://specprompt.com>\nTickTickClock <https://ticktickclock.com>"},{"id":"blk-35753","kind":"code","language":"text","text":":maxdepth: 1\n:caption: Root Docs\n\n[&] Protocol Docs <https://docs.ampersandboxdesign.com>\nGraphonomous Docs <https://docs.graphonomous.com>\nBendScript Docs <https://docs.bendscript.com>\nWebHost.Systems Docs <https://docs.webhost.systems>\nAgentelic Docs <https://docs.agentelic.com>\nAgenTroMatic Docs <https://docs.agentromatic.com>\nDelegatic Docs <https://docs.delegatic.com>\nDeliberatic Docs <https://docs.deliberatic.com>\nFleetPrompt Docs <https://docs.fleetprompt.com>\nGeoFleetic Docs <https://docs.geofleetic.com>\nOpenSentience Docs <https://docs.opensentience.org>\nSpecPrompt Docs <https://docs.specprompt.com>\nTickTickClock Docs <https://docs.ticktickclock.com>"},{"id":"blk-35754","kind":"code","language":"text","text":":maxdepth: 2\n:caption: AgenTroMatic Docs\n\nspec/README"},{"id":"blk-35755","kind":"paragraph","spans":[{"id":"spn-38979","text":"---"}]},{"id":"blk-35756","kind":"heading","level":2,"spans":[{"id":"spn-38980","text":"Architecture at a Glance"}]},{"head":[{"id":"blk-35758","spans":[{"id":"spn-38981","text":"Component"}]},{"id":"blk-35759","spans":[{"id":"spn-38982","text":"Role"}]},{"id":"blk-35760","spans":[{"id":"spn-38983","text":"OTP Pattern"}]}],"id":"blk-35757","kind":"table","rows":[[{"id":"blk-35761","spans":[{"id":"spn-38984","marks":["bold"],"text":"Deliberation Supervisor"}]},{"id":"blk-35762","spans":[{"id":"spn-38985","text":"Spawns one process per deliberation"}]},{"id":"blk-35763","spans":[{"id":"spn-38986","text":"DynamicSupervisor"}]}],[{"id":"blk-35764","spans":[{"id":"spn-38987","marks":["bold"],"text":"Reputation Engine"}]},{"id":"blk-35765","spans":[{"id":"spn-38988","text":"Tracks agent performance via ETS cache"}]},{"id":"blk-35766","spans":[{"id":"spn-38989","text":"GenServer + ETS"}]}],[{"id":"blk-35767","spans":[{"id":"spn-38990","marks":["bold"],"text":"A2A Gateway"}]},{"id":"blk-35768","spans":[{"id":"spn-38991","text":"HTTP client per agent for inter-agent comms"}]},{"id":"blk-35769","spans":[{"id":"spn-38992","text":"Req/Finch"}]}],[{"id":"blk-35770","spans":[{"id":"spn-38993","marks":["bold"],"text":"Observatory"}]},{"id":"blk-35771","spans":[{"id":"spn-38994","text":"Real-time deliberation streaming UI"}]},{"id":"blk-35772","spans":[{"id":"spn-38995","text":"Phoenix LiveView"}]}],[{"id":"blk-35773","spans":[{"id":"spn-38996","marks":["bold"],"text":"Ra Consensus"}]},{"id":"blk-35774","spans":[{"id":"spn-38997","text":"Leader election and log replication"}]},{"id":"blk-35775","spans":[{"id":"spn-38998","text":"Ra (Raft)"}]}]]},{"id":"blk-35776","kind":"paragraph","spans":[{"id":"spn-38999","text":"---"}]},{"id":"blk-35777","kind":"heading","level":2,"spans":[{"id":"spn-39000","text":"Design Principles"}]},{"id":"blk-35778","kind":"paragraph","spans":[{"id":"spn-39001","text":"1. "},{"id":"spn-39002","marks":["bold"],"text":"Deliberation over routing"},{"id":"spn-39003","text":" — Static routing is the wrong abstraction for overlapping, evolving capabilities. Agents negotiate every time. 2. "},{"id":"spn-39004","marks":["bold"],"text":"A2A-native"},{"id":"spn-39005","text":" — Every inter-agent message flows through standard A2A protocol. 3. "},{"id":"spn-39006","marks":["bold"],"text":"Reputation is memory"},{"id":"spn-39007","text":" — Past performance shapes future assignments. Overconfident agents lose weight. 4. "},{"id":"spn-39008","marks":["bold"],"text":"Visible by default"},{"id":"spn-39009","text":" — Every deliberation is traceable. The Observatory is not optional — it's the product. 5. "},{"id":"spn-39010","marks":["bold"],"text":"Consensus before commit"},{"id":"spn-39011","text":" — Results publish only when quorum validates. 6. "},{"id":"spn-39012","marks":["bold"],"text":"Ra under the hood"},{"id":"spn-39013","text":" — Battle-tested Raft from RabbitMQ."}]},{"id":"blk-35779","kind":"paragraph","spans":[{"id":"spn-39014","text":"---"}]},{"id":"blk-35780","kind":"heading","level":2,"spans":[{"id":"spn-39015","text":"Tech Stack"}]},{"head":[{"id":"blk-35782","spans":[{"id":"spn-39016","text":"Layer"}]},{"id":"blk-35783","spans":[{"id":"spn-39017","text":"Technology"}]}],"id":"blk-35781","kind":"table","rows":[[{"id":"blk-35784","spans":[{"id":"spn-39018","text":"Language"}]},{"id":"blk-35785","spans":[{"id":"spn-39019","text":"Elixir 1.17+"}]}],[{"id":"blk-35786","spans":[{"id":"spn-39020","text":"Framework"}]},{"id":"blk-35787","spans":[{"id":"spn-39021","text":"Phoenix 1.8+ (LiveView for Observatory)"}]}],[{"id":"blk-35788","spans":[{"id":"spn-39022","text":"Consensus"}]},{"id":"blk-35789","spans":[{"id":"spn-39023","text":"Ra (Raft library from RabbitMQ)"}]}],[{"id":"blk-35790","spans":[{"id":"spn-39024","text":"Database"}]},{"id":"blk-35791","spans":[{"id":"spn-39025","text":"PostgreSQL 16+ via Ecto"}]}],[{"id":"blk-35792","spans":[{"id":"spn-39026","text":"Hot Cache"}]},{"id":"blk-35793","spans":[{"id":"spn-39027","text":"ETS (reputation lookups)"}]}],[{"id":"blk-35794","spans":[{"id":"spn-39028","text":"Agent Comms"}]},{"id":"blk-35795","spans":[{"id":"spn-39029","text":"A2A v0.3+ via Req/Finch"}]}]]},{"id":"blk-35796","kind":"paragraph","spans":[{"id":"spn-39030","text":"---"}]},{"id":"blk-35797","kind":"heading","level":2,"spans":[{"id":"spn-39031","text":"Project Links"}]},{"id":"blk-35798","items":[{"blocks":[{"id":"blk-35800","kind":"paragraph","spans":[{"id":"spn-39032","marks":["bold"],"text":"Spec:"},{"id":"spn-39033","text":" "},{"id":"spn-39034","marks":[{"kind":"link","predicate":"cites","target":"#/agentromatic.com/docs/spec/README.md"}],"text":"Technical Specification"}]}],"id":"blk-35799","kind":"list-item"},{"blocks":[{"id":"blk-35802","kind":"paragraph","spans":[{"id":"spn-39035","marks":["bold"],"text":"[&] Protocol ecosystem:"},{"id":"spn-39036","text":" "},{"id":"spn-39037","marks":["code"],"text":"AmpersandBoxDesign/"}]}],"id":"blk-35801","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-35803","kind":"paragraph","spans":[{"id":"spn-39038","text":"---"}]},{"id":"blk-35804","kind":"paragraph","spans":[{"id":"spn-39039","text":"*[&] Ampersand Box Design — agentromatic.com*"}]}],"edges":[],"id":"bagaaiera247cqpfxbndsrlf3di5nleet6vxoe24u26po22zaxajaxc2lww6a","vocabulary":"ampersand.docs.fs.v1"}