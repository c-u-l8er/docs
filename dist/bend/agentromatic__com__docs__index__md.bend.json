{"bendscript":"0.1","blocks":[{"id":"blk-52095","kind":"heading","level":1,"spans":[{"id":"spn-99956","text":"AgenTroMatic Documentation"}]},{"blocks":[{"id":"blk-52097","kind":"paragraph","spans":[{"id":"spn-99957","marks":["bold"],"text":"Your agents don't need a boss. They need a deliberation."}]}],"id":"blk-52096","kind":"quote"},{"blocks":[{"id":"blk-52099","kind":"paragraph","spans":[{"id":"spn-99958","marks":["bold"],"text":"Part of the [&] Protocol stack"},{"id":"spn-99959","text":" · "},{"id":"spn-99960","marks":[{"kind":"link","predicate":"cites","target":"#/ECOSYSTEM.md"}],"text":"Ecosystem overview"},{"id":"spn-99961","text":" · "},{"id":"spn-99962","marks":[{"kind":"link","predicate":"cites","target":"#/PULSE/docs/THREE_PROTOCOL_STACK.md"}],"text":"Three-protocol stack"},{"id":"spn-99963","text":" · "},{"id":"spn-99964","marks":[{"kind":"link","predicate":"cites","target":"#/STACK_COMPLETION.md"}],"text":"Stack status"}]}],"id":"blk-52098","kind":"quote"},{"id":"blk-52100","kind":"paragraph","spans":[{"id":"spn-99965","text":"Welcome to the documentation hub for "},{"id":"spn-99966","marks":["bold"],"text":"AgenTroMatic"},{"id":"spn-99967","text":" — the automatic deliberation engine for multi-agent AI systems. When a task arrives, agents bid based on ability, debate when capabilities overlap, elect leaders by consensus, execute under quorum validation, and build reputation over time. No human routing required — ever."}]},{"id":"blk-52101","kind":"paragraph","spans":[{"id":"spn-99968","text":"AgenTroMatic is "},{"id":"spn-99969","marks":["bold"],"text":"not"},{"id":"spn-99970","text":" an orchestrator (that's Delegatic) or a framework for building agents (that's Agentelic). It is the automation layer that sits between human-defined governance and raw agent execution — making self-organization reliable, visible, and auditable."}]},{"id":"blk-52102","kind":"heading","level":2,"spans":[{"id":"spn-99971","text":"How It Works"}]},{"id":"blk-52103","items":[{