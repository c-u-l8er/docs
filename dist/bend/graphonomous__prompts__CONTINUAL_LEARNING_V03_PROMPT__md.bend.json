{"bendscript":"0.1","blocks":[{"id":"blk-46338","kind":"heading","level":1,"spans":[{"id":"spn-53210","text":"Graphonomous v0.3 Continual Learning Implementation Prompt"}]},{"id":"blk-46339","kind":"heading","level":2,"spans":[{"id":"spn-53211","text":"Session Goal"}]},{"id":"blk-46340","kind":"paragraph","spans":[{"id":"spn-53212","text":"Implement P0 continual learning capabilities for Graphonomous: "},{"id":"spn-53213","marks":["bold"],"text":"kappa activation"},{"id":"spn-53214","text":", "},{"id":"spn-53215","marks":["bold"],"text":"belief revision substrate"},{"id":"spn-53216","text":", and "},{"id":"spn-53217","marks":["bold"],"text":"conflict-aware consolidation"},{"id":"spn-53218","text":". These three capabilities together solve the kappa=0 problem — the single biggest gap between Graphonomous's competitive thesis and its measured behavior."}]},{"id":"blk-46341","kind":"heading","level":2,"spans":[{"id":"spn-53219","text":"Context"}]},{"id":"blk-46342","items":[{"blocks":[{"id":"blk-46344","kind":"paragraph","spans":[{"id":"spn-53220","marks":["bold"],"text":"Active Graphonomous goal:"},{"id":"spn-53221","text":" "},{"id":"spn-53222","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"},{"id":"spn-53223","text":" — \"Graphonomous v0.3 Continual Learning Capabilities\""}]}],"id":"blk-46343","kind":"list-item"},{"blocks":[{"id":"blk-46346","kind":"paragraph","spans":[{"id":"spn-53224","marks":["bold"],"text":"Plan file:"},{"id":"spn-53225","text":" "},{"id":"spn-53226","marks":["code"],"text":"/home/travis/.claude/plans/smooth-tumbling-sunbeam.md"}]}],"id":"blk-46345","kind":"list-item"},{"blocks":[{"id":"blk-46348","kind":"paragraph","spans":[{"id":"spn-53227","marks":["bold"],"text":"Current state:"},{"id":"spn-53228","text":" v0.2.0, 240 tests passing, 22 MCP tools, kappa=0 across all 150 benchmark questions"}]}],"id":"blk-46347","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46349","kind":"heading","level":2,"spans":[{"id":"spn-53229","text":"The kappa=0 Root Cause"}]},{"id":"blk-46350","kind":"paragraph","spans":[{"id":"spn-53230","text":"The Retriever's "},{"id":"spn-53231","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-53232","text":" only builds adjacency from edges between the ~20 retrieved nodes. EdgeExtractor creates unidirectional edges via regex (A imports B -> edge A->B). Cycles require bidirectional edges, which almost never form because:"}]},{"id":"blk-46351","kind":"paragraph","spans":[{"id":"spn-53233","text":"1. Regex extraction misses conceptual back-references 2. No mechanism creates "},{"id":"spn-53234","marks":["code"],"text":":contradicts"},{"id":"spn-53235","text":"/"},{"id":"spn-53236","marks":["code"],"text":":supersedes"},{"id":"spn-53237","text":" edges automatically 3. Topology window is too narrow (only retrieved nodes, not their neighbors)"}]},{"id":"blk-46352","kind":"heading","level":2,"spans":[{"id":"spn-53238","text":"What to Build (P0, ~10 days)"}]},{"id":"blk-46353","kind":"heading","level":3,"spans":[{"id":"spn-53239","text":"1. Kappa Activation (3 days)"}]},{"id":"blk-46354","kind":"paragraph","spans":[{"id":"spn-53240","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/edge_extractor.ex`"}]},{"id":"blk-46355","items":[{"blocks":[{"id":"blk-46357","kind":"paragraph","spans":[{"id":"spn-53241","text":"Add "},{"id":"spn-53242","marks":["code"],"text":"extract_semantic_backrefs/1"},{"id":"spn-53243","text":" — after forward edge creation, compute cosine similarity between target and source embeddings. If > 0.75, create reverse "},{"id":"spn-53244","marks":["code"],"text":":supports"},{"id":"spn-53245","text":" edge."}]}],"id":"blk-46356","kind":"list-item"},{"blocks":[{"id":"blk-46359","kind":"paragraph","spans":[{"id":"spn-53246","text":"This requires access to embeddings during extraction (currently regex-only)."}]}],"id":"blk-46358","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46360","kind":"paragraph","spans":[{"id":"spn-53247","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/retriever.ex`"}]},{"id":"blk-46361","items":[{"blocks":[{"id":"blk-46363","kind":"paragraph","spans":[{"id":"spn-53248","text":"Modify "},{"id":"spn-53249","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-53250","text":" to expand the topology window: include 1-hop neighbors of retrieved nodes, not just the retrieved nodes themselves."}]}],"id":"blk-46362","kind":"list-item"},{"blocks":[{"id":"blk-46365","kind":"paragraph","spans":[{"id":"spn-53251","text":"Current code calls "},{"id":"spn-53252","marks":["code"],"text":"Store.list_edges_between(node_ids)"},{"id":"spn-53253","text":" where "},{"id":"spn-53254","marks":["code"],"text":"node_ids"},{"id":"spn-53255","text":" is ~20 retrieved results. Change to:"}]}],"id":"blk-46364","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46366","kind":"paragraph","spans":[{"id":"spn-53256","text":"1. Get edges for each retrieved node ("},{"id":"spn-53257","marks":["code"],"text":"Store.list_edges_for_node/1"},{"id":"spn-53258","text":") 2. Collect all neighbor IDs 3. Build adjacency over "},{"id":"spn-53259","marks":["code"],"text":"retrieved_ids ++ neighbor_ids"},{"id":"spn-53260","text":" 4. Run Tarjan SCC + kappa on the expanded set"}]},{"id":"blk-46367","kind":"heading","level":3,"spans":[{"id":"spn-53261","text":"2. Belief Revision Substrate (4 days)"}]},{"id":"blk-46368","kind":"paragraph","spans":[{"id":"spn-53262","marks":["bold"],"text":"Schema migration (new file in `graphonomous/lib/graphonomous/store.ex` or migration system):"}]},{"id":"blk-46369","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN revision_id TEXT;\nALTER TABLE nodes ADD COLUMN superseded_by TEXT;\n\nCREATE TABLE IF NOT EXISTS revisions (\n  id TEXT PRIMARY KEY,\n  operation TEXT NOT NULL,  -- 'expansion' | 'revision' | 'contraction'\n  trigger_node_id TEXT NOT NULL,\n  affected_node_ids TEXT NOT NULL DEFAULT '[]',\n  rationale TEXT,\n  agent_id TEXT,\n  created_at TEXT NOT NULL\n);"},{"id":"blk-46370","kind":"paragraph","spans":[{"id":"spn-53263","marks":["bold"],"text":"New file: `graphonomous/lib/graphonomous/belief_revision.ex`"}]},{"id":"blk-46371","kind":"code","language":"elixir","text":"defmodule Graphonomous.BeliefRevision do\n  @moduledoc \"\"\"\n  AGM-rational belief revision operations with provenance tracking.\n  Provides storage/provenance substrate — reasoning about which belief wins\n  is delegated to external systems (Deliberatic, BendScript) via pluggable hooks.\n  \"\"\"\n\n  # Core operations\n  def expand(content, opts \\\\ [])        # Add belief, check contradictions first\n  def revise(node_id, new_content, opts) # Supersede old belief, propagate confidence\n  def contract(node_id, opts)            # Remove belief, retract dependents\n\n  # Detection\n  def detect_contradictions(node_id_or_content) # Find contradicting nodes\n  def propagate_retraction(node_id, opts)       # Walk derived_from/supports, reduce confidence\n\n  # Hooks\n  def register_resolution_hook(module)   # External resolver (Deliberatic, BendScript)\n  def resolve_contradiction(node_a, node_b) # Call registered hook or use default heuristic\nend"},{"id":"blk-46372","kind":"paragraph","spans":[{"id":"spn-53264","marks":["bold"],"text":"New MCP tools (register in `graphonomous/lib/graphonomous/mcp/server.ex`):"}]},{"id":"blk-46373","items":[{"blocks":[{"id":"blk-46375","kind":"paragraph","spans":[{"id":"spn-53265","marks":["code"],"text":"belief_revise"},{"id":"spn-53266","text":" — "},{"id":"spn-53267","marks":["code"],"text":"{node_id, new_content, rationale, operation: \"expand\"|\"revise\"|\"contract\"}"}]}],"id":"blk-46374","kind":"list-item"},{"blocks":[{"id":"blk-46377","kind":"paragraph","spans":[{"id":"spn-53268","marks":["code"],"text":"belief_contradictions"},{"id":"spn-53269","text":" — "},{"id":"spn-53270","marks":["code"],"text":"{node_id}"},{"id":"spn-53271","text":" or "},{"id":"spn-53272","marks":["code"],"text":"{content}"},{"id":"spn-53273","text":" — returns contradicting nodes with similarity scores"}]}],"id":"blk-46376","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46378","kind":"paragraph","spans":[{"id":"spn-53274","marks":["bold"],"text":"New edge type:"},{"id":"spn-53275","text":" Add "},{"id":"spn-53276","marks":["code"],"text":":superseded_by"},{"id":"spn-53277","text":" to valid edge types in "},{"id":"spn-53278","marks":["code"],"text":"Graph"},{"id":"spn-53279","text":" module."}]},{"id":"blk-46379","kind":"paragraph","spans":[{"id":"spn-53280","marks":["bold"],"text":"Integration with Learner:"},{"id":"spn-53281","text":" In "},{"id":"spn-53282","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-53283","text":", after "},{"id":"spn-53284","marks":["code"],"text":"store_node"},{"id":"spn-53285","text":", call "},{"id":"spn-53286","marks":["code"],"text":"detect_contradictions"},{"id":"spn-53287","text":". If found, create "},{"id":"spn-53288","marks":["code"],"text":":contradicts"},{"id":"spn-53289","text":" edges (these form 2-node SCCs = kappa=1)."}]},{"id":"blk-46380","kind":"paragraph","spans":[{"id":"spn-53290","marks":["bold"],"text":"Integration with Consolidator Stage 5:"},{"id":"spn-53291","text":" Before merging (cosine > 0.95), check if pair has "},{"id":"spn-53292","marks":["code"],"text":":contradicts"},{"id":"spn-53293","text":" edges. If so, route to "},{"id":"spn-53294","marks":["code"],"text":"BeliefRevision.resolve_contradiction/2"},{"id":"spn-53295","text":" instead of merging."}]},{"id":"blk-46381","kind":"heading","level":3,"spans":[{"id":"spn-53296","text":"3. Conflict-Aware Consolidation (3 days)"}]},{"id":"blk-46382","kind":"paragraph","spans":[{"id":"spn-53297","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/retriever.ex`"}]},{"id":"blk-46383","items":[{"blocks":[{"id":"blk-46385","kind":"paragraph","spans":[{"id":"spn-53298","text":"Add "},{"id":"spn-53299","marks":["code"],"text":"detect_and_tag_conflicts/1"},{"id":"spn-53300","text":" after ranking, before return"}]}],"id":"blk-46384","kind":"list-item"},{"blocks":[{"id":"blk-46387","kind":"paragraph","spans":[{"id":"spn-53301","text":"Tag pairs where: semantic similarity > 0.8 AND confidence divergence > 0.3"}]}],"id":"blk-46386","kind":"list-item"},{"blocks":[{"id":"blk-46389","kind":"paragraph","spans":[{"id":"spn-53302","text":"Store conflict tags in node metadata (or a lightweight ETS cache)"}]}],"id":"blk-46388","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46390","kind":"paragraph","spans":[{"id":"spn-53303","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/consolidator.ex`"}]},{"id":"blk-46391","items":[{"blocks":[{"id":"blk-46393","kind":"paragraph","spans":[{"id":"spn-53304","text":"Add Stage 4.5 between \"strengthen coactivated\" and \"merge similar\""}]}],"id":"blk-46392","kind":"list-item"},{"blocks":[{"id":"blk-46395","kind":"paragraph","spans":[{"id":"spn-53305","marks":["code"],"text":"stage_resolve_conflicts/0"},{"id":"spn-53306","text":":"}]}],"id":"blk-46394","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46396","kind":"paragraph","spans":[{"id":"spn-53307","text":"1. Find all conflict-tagged pairs 2. For each pair, try resolution strategies in order: a. Temporal (newer supersedes older) b. Evidence (more outcome references wins) c. External hook (registered resolver) d. Escalate to attention (create attention item) 3. Winning resolution: call "},{"id":"spn-53308","marks":["code"],"text":"BeliefRevision.revise/3"},{"id":"spn-53309","text":" 4. Unresolved: create "},{"id":"spn-53310","marks":["code"],"text":":contradicts"},{"id":"spn-53311","text":" edges (activates kappa)"}]},{"id":"blk-46397","kind":"paragraph","spans":[{"id":"spn-53312","marks":["bold"],"text":"Key insight:"},{"id":"spn-53313","text":" Unresolved conflicts get "},{"id":"spn-53314","marks":["code"],"text":":contradicts"},{"id":"spn-53315","text":" edges = guaranteed kappa>=1. This is the PRIMARY kappa activation mechanism for organic (non-synthetic) knowledge."}]},{"id":"blk-46398","kind":"heading","level":2,"spans":[{"id":"spn-53316","text":"Files to Read Before Coding"}]},{"id":"blk-46399","kind":"paragraph","spans":[{"id":"spn-53317","text":"Read these files FIRST to understand the current implementation:"}]},{"id":"blk-46400","kind":"paragraph","spans":[{"id":"spn-53318","text":"1. "},{"id":"spn-53319","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"},{"id":"spn-53320","text":" — retrieval pipeline, "},{"id":"spn-53321","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-53322","text":", scoring 2. "},{"id":"spn-53323","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"},{"id":"spn-53324","text":" — 7-stage pipeline, decay rates, prune logic 3. "},{"id":"spn-53325","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"},{"id":"spn-53326","text":" — "},{"id":"spn-53327","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-53328","text":", "},{"id":"spn-53329","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-53330","text":", confidence updates 4. "},{"id":"spn-53331","marks":["code"],"text":"graphonomous/lib/graphonomous/edge_extractor.ex"},{"id":"spn-53332","text":" — regex extraction, edge type assignment 5. "},{"id":"spn-53333","marks":["code"],"text":"graphonomous/lib/graphonomous/topology.ex"},{"id":"spn-53334","text":" — "},{"id":"spn-53335","marks":["code"],"text":"tarjan_scc/1"},{"id":"spn-53336","text":", "},{"id":"spn-53337","marks":["code"],"text":"compute_kappa/2"},{"id":"spn-53338","text":", "},{"id":"spn-53339","marks":["code"],"text":"analyze/1"},{"id":"spn-53340","text":" 6. "},{"id":"spn-53341","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"},{"id":"spn-53342","text":" — SQLite schema, migrations, CRUD operations 7. "},{"id":"spn-53343","marks":["code"],"text":"graphonomous/lib/graphonomous/graph.ex"},{"id":"spn-53344","text":" — edge types, graph operations 8. "},{"id":"spn-53345","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/server.ex"},{"id":"spn-53346","text":" — MCP tool registration pattern 9. "},{"id":"spn-53347","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"},{"id":"spn-53348","text":" — Node struct definition 10. "},{"id":"spn-53349","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"},{"id":"spn-53350","text":" — Edge struct definition"}]},{"id":"blk-46401","kind":"heading","level":2,"spans":[{"id":"spn-53351","text":"Coding Conventions"}]},{"id":"blk-46402","items":[{"blocks":[{"id":"blk-46404","kind":"paragraph","spans":[{"id":"spn-53352","text":"Use "},{"id":"spn-53353","marks":["code"],"text":"mix format"},{"id":"spn-53354","text":" style"}]}],"id":"blk-46403","kind":"list-item"},{"blocks":[{"id":"blk-46406","kind":"paragraph","spans":[{"id":"spn-53355","text":"All new modules need "},{"id":"spn-53356","marks":["code"],"text":"@moduledoc"},{"id":"spn-53357","text":" and "},{"id":"spn-53358","marks":["code"],"text":"@doc"},{"id":"spn-53359","text":" on public functions"}]}],"id":"blk-46405","kind":"list-item"},{"blocks":[{"id":"blk-46408","kind":"paragraph","spans":[{"id":"spn-53360","text":"Add to existing test files or create new ones in "},{"id":"spn-53361","marks":["code"],"text":"test/graphonomous/"}]}],"id":"blk-46407","kind":"list-item"},{"blocks":[{"id":"blk-46410","kind":"paragraph","spans":[{"id":"spn-53362","text":"New MCP tools follow the pattern in existing tool modules under "},{"id":"spn-53363","marks":["code"],"text":"lib/graphonomous/mcp/tools/"}]}],"id":"blk-46409","kind":"list-item"},{"blocks":[{"id":"blk-46412","kind":"paragraph","spans":[{"id":"spn-53364","text":"Schema changes go through the Store migration system"}]}],"id":"blk-46411","kind":"list-item"},{"blocks":[{"id":"blk-46414","kind":"paragraph","spans":[{"id":"spn-53365","text":"Emit telemetry events for new operations (follow existing "},{"id":"spn-53366","marks":["code"],"text":"[:graphonomous, :*, :*]"},{"id":"spn-53367","text":" pattern)"}]}],"id":"blk-46413","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46415","kind":"heading","level":2,"spans":[{"id":"spn-53368","text":"Verification Checklist"}]},{"id":"blk-46416","kind":"paragraph","spans":[{"id":"spn-53369","text":"After implementing P0:"}]},{"id":"blk-46417","items":[{"blocks":[{"id":"blk-46419","kind":"paragraph","spans":[{"id":"spn-53370","text":"[ ] "},{"id":"spn-53371","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-53372","text":" passes"}]}],"id":"blk-46418","kind":"list-item"},{"blocks":[{"id":"blk-46421","kind":"paragraph","spans":[{"id":"spn-53373","text":"[ ] "},{"id":"spn-53374","marks":["code"],"text":"mix test"},{"id":"spn-53375","text":" — all 240+ existing tests pass (regression)"}]}],"id":"blk-46420","kind":"list-item"},{"blocks":[{"id":"blk-46423","kind":"paragraph","spans":[{"id":"spn-53376","text":"[ ] New tests for BeliefRevision module pass"}]}],"id":"blk-46422","kind":"list-item"},{"blocks":[{"id":"blk-46425","kind":"paragraph","spans":[{"id":"spn-53377","text":"[ ] New tests for conflict-aware consolidation pass"}]}],"id":"blk-46424","kind":"list-item"},{"blocks":[{"id":"blk-46427","kind":"paragraph","spans":[{"id":"spn-53378","text":"[ ] New tests for expanded topology window pass"}]}],"id":"blk-46426","kind":"list-item"},{"blocks":[{"id":"blk-46429","kind":"paragraph","spans":[{"id":"spn-53379","text":"[ ] Run "},{"id":"spn-53380","marks":["code"],"text":"mix benchmark.run"},{"id":"spn-53381","text":" — verify kappa>0 appears in at least some queries"}]}],"id":"blk-46428","kind":"list-item"},{"blocks":[{"id":"blk-46431","kind":"paragraph","spans":[{"id":"spn-53382","text":"[ ] Manual test: store two contradicting facts via MCP, verify "},{"id":"spn-53383","marks":["code"],"text":":contradicts"},{"id":"spn-53384","text":" edges form, verify kappa=1 on retrieval involving both"}]}],"id":"blk-46430","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46432","kind":"heading","level":2,"spans":[{"id":"spn-53385","text":"Research References (for context, not implementation)"}]},{"id":"blk-46433","items":[{"blocks":[{"id":"blk-46435","kind":"paragraph","spans":[{"id":"spn-53386","text":"Kumiho (arxiv 2603.17244) — AGM maps to property graph operations (validates our approach)"}]}],"id":"blk-46434","kind":"list-item"},{"blocks":[{"id":"blk-46437","kind":"paragraph","spans":[{"id":"spn-53387","text":"SleepGate (arxiv 2603.14517) — separate conflict detection from resolution (our Stage 4.5 design)"}]}],"id":"blk-46436","kind":"list-item"},{"blocks":[{"id":"blk-46439","kind":"paragraph","spans":[{"id":"spn-53388","text":"MemRL (arxiv 2601.03192) — two-phase retrieval (P1, not this session)"}]}],"id":"blk-46438","kind":"list-item"},{"blocks":[{"id":"blk-46441","kind":"paragraph","spans":[{"id":"spn-53389","text":"MAGMA (arxiv 2601.03236) — multi-view adjacency indexes (future optimization for kappa)"}]}],"id":"blk-46440","kind":"list-item"},{"blocks":[{"id":"blk-46443","kind":"paragraph","spans":[{"id":"spn-53390","text":"UtU (arxiv 2402.10695) — constant-time graph unlearning (P1 forgetting, not this session)"}]}],"id":"blk-46442","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46444","kind":"heading","level":2,"spans":[{"id":"spn-53391","text":"Success Criteria for This Session"}]},{"id":"blk-46445","kind":"paragraph","spans":[{"id":"spn-53392","text":"1. "},{"id":"spn-53393","marks":["bold"],"text":"kappa > 0 activates"},{"id":"spn-53394","text":" on at least one real retrieval query (not synthetic) 2. "},{"id":"spn-53395","marks":["bold"],"text":"Belief revision"},{"id":"spn-53396","text":" creates revision records and supersedes edges 3. "},{"id":"spn-53397","marks":["bold"],"text":"Conflict detection"},{"id":"spn-53398","text":" tags conflicts during retrieval 4. "},{"id":"spn-53399","marks":["bold"],"text":"Conflict resolution"},{"id":"spn-53400","text":" runs during consolidation Stage 4.5 5. "},{"id":"spn-53401","marks":["bold"],"text":"All existing tests pass"}]}],"edges":[],"id":"bagaaieraovfchvxhpapyp3nho4xpfacl6ln6mja3x32u2oz2r4ujc3sa5g4q","vocabulary":"ampersand.docs.fs.v1"}