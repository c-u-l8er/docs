{"bendscript":"0.1","blocks":[{"id":"blk-45852","kind":"heading","level":1,"spans":[{"id":"spn-52036","text":"Graphonomous v0.3 Continual Learning Implementation Prompt"}]},{"id":"blk-45853","kind":"heading","level":2,"spans":[{"id":"spn-52037","text":"Session Goal"}]},{"id":"blk-45854","kind":"paragraph","spans":[{"id":"spn-52038","text":"Implement P0 continual learning capabilities for Graphonomous: "},{"id":"spn-52039","marks":["bold"],"text":"kappa activation"},{"id":"spn-52040","text":", "},{"id":"spn-52041","marks":["bold"],"text":"belief revision substrate"},{"id":"spn-52042","text":", and "},{"id":"spn-52043","marks":["bold"],"text":"conflict-aware consolidation"},{"id":"spn-52044","text":". These three capabilities together solve the kappa=0 problem — the single biggest gap between Graphonomous's competitive thesis and its measured behavior."}]},{"id":"blk-45855","kind":"heading","level":2,"spans":[{"id":"spn-52045","text":"Context"}]},{"id":"blk-45856","items":[{"blocks":[{"id":"blk-45858","kind":"paragraph","spans":[{"id":"spn-52046","marks":["bold"],"text":"Active Graphonomous goal:"},{"id":"spn-52047","text":" "},{"id":"spn-52048","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"},{"id":"spn-52049","text":" — \"Graphonomous v0.3 Continual Learning Capabilities\""}]}],"id":"blk-45857","kind":"list-item"},{"blocks":[{"id":"blk-45860","kind":"paragraph","spans":[{"id":"spn-52050","marks":["bold"],"text":"Plan file:"},{"id":"spn-52051","text":" "},{"id":"spn-52052","marks":["code"],"text":"/home/travis/.claude/plans/smooth-tumbling-sunbeam.md"}]}],"id":"blk-45859","kind":"list-item"},{"blocks":[{"id":"blk-45862","kind":"paragraph","spans":[{"id":"spn-52053","marks":["bold"],"text":"Current state:"},{"id":"spn-52054","text":" v0.2.0, 240 tests passing, 22 MCP tools, kappa=0 across all 150 benchmark questions"}]}],"id":"blk-45861","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45863","kind":"heading","level":2,"spans":[{"id":"spn-52055","text":"The kappa=0 Root Cause"}]},{"id":"blk-45864","kind":"paragraph","spans":[{"id":"spn-52056","text":"The Retriever's "},{"id":"spn-52057","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-52058","text":" only builds adjacency from edges between the ~20 retrieved nodes. EdgeExtractor creates unidirectional edges via regex (A imports B -> edge A->B). Cycles require bidirectional edges, which almost never form because:"}]},{"id":"blk-45865","kind":"paragraph","spans":[{"id":"spn-52059","text":"1. Regex extraction misses conceptual back-references 2. No mechanism creates "},{"id":"spn-52060","marks":["code"],"text":":contradicts"},{"id":"spn-52061","text":"/"},{"id":"spn-52062","marks":["code"],"text":":supersedes"},{"id":"spn-52063","text":" edges automatically 3. Topology window is too narrow (only retrieved nodes, not their neighbors)"}]},{"id":"blk-45866","kind":"heading","level":2,"spans":[{"id":"spn-52064","text":"What to Build (P0, ~10 days)"}]},{"id":"blk-45867","kind":"heading","level":3,"spans":[{"id":"spn-52065","text":"1. Kappa Activation (3 days)"}]},{"id":"blk-45868","kind":"paragraph","spans":[{"id":"spn-52066","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/edge_extractor.ex`"}]},{"id":"blk-45869","items":[{"blocks":[{"id":"blk-45871","kind":"paragraph","spans":[{"id":"spn-52067","text":"Add "},{"id":"spn-52068","marks":["code"],"text":"extract_semantic_backrefs/1"},{"id":"spn-52069","text":" — after forward edge creation, compute cosine similarity between target and source embeddings. If > 0.75, create reverse "},{"id":"spn-52070","marks":["code"],"text":":supports"},{"id":"spn-52071","text":" edge."}]}],"id":"blk-45870","kind":"list-item"},{"blocks":[{"id":"blk-45873","kind":"paragraph","spans":[{"id":"spn-52072","text":"This requires access to embeddings during extraction (currently regex-only)."}]}],"id":"blk-45872","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45874","kind":"paragraph","spans":[{"id":"spn-52073","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/retriever.ex`"}]},{"id":"blk-45875","items":[{"blocks":[{"id":"blk-45877","kind":"paragraph","spans":[{"id":"spn-52074","text":"Modify "},{"id":"spn-52075","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-52076","text":" to expand the topology window: include 1-hop neighbors of retrieved nodes, not just the retrieved nodes themselves."}]}],"id":"blk-45876","kind":"list-item"},{"blocks":[{"id":"blk-45879","kind":"paragraph","spans":[{"id":"spn-52077","text":"Current code calls "},{"id":"spn-52078","marks":["code"],"text":"Store.list_edges_between(node_ids)"},{"id":"spn-52079","text":" where "},{"id":"spn-52080","marks":["code"],"text":"node_ids"},{"id":"spn-52081","text":" is ~20 retrieved results. Change to:"}]}],"id":"blk-45878","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45880","kind":"paragraph","spans":[{"id":"spn-52082","text":"1. Get edges for each retrieved node ("},{"id":"spn-52083","marks":["code"],"text":"Store.list_edges_for_node/1"},{"id":"spn-52084","text":") 2. Collect all neighbor IDs 3. Build adjacency over "},{"id":"spn-52085","marks":["code"],"text":"retrieved_ids ++ neighbor_ids"},{"id":"spn-52086","text":" 4. Run Tarjan SCC + kappa on the expanded set"}]},{"id":"blk-45881","kind":"heading","level":3,"spans":[{"id":"spn-52087","text":"2. Belief Revision Substrate (4 days)"}]},{"id":"blk-45882","kind":"paragraph","spans":[{"id":"spn-52088","marks":["bold"],"text":"Schema migration (new file in `graphonomous/lib/graphonomous/store.ex` or migration system):"}]},{"id":"blk-45883","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN revision_id TEXT;\nALTER TABLE nodes ADD COLUMN superseded_by TEXT;\n\nCREATE TABLE IF NOT EXISTS revisions (\n  id TEXT PRIMARY KEY,\n  operation TEXT NOT NULL,  -- 'expansion' | 'revision' | 'contraction'\n  trigger_node_id TEXT NOT NULL,\n  affected_node_ids TEXT NOT NULL DEFAULT '[]',\n  rationale TEXT,\n  agent_id TEXT,\n  created_at TEXT NOT NULL\n);"},{"id":"blk-45884","kind":"paragraph","spans":[{"id":"spn-52089","marks":["bold"],"text":"New file: `graphonomous/lib/graphonomous/belief_revision.ex`"}]},{"id":"blk-45885","kind":"code","language":"elixir","text":"defmodule Graphonomous.BeliefRevision do\n  @moduledoc \"\"\"\n  AGM-rational belief revision operations with provenance tracking.\n  Provides storage/provenance substrate — reasoning about which belief wins\n  is delegated to external systems (Deliberatic, BendScript) via pluggable hooks.\n  \"\"\"\n\n  # Core operations\n  def expand(content, opts \\\\ [])        # Add belief, check contradictions first\n  def revise(node_id, new_content, opts) # Supersede old belief, propagate confidence\n  def contract(node_id, opts)            # Remove belief, retract dependents\n\n  # Detection\n  def detect_contradictions(node_id_or_content) # Find contradicting nodes\n  def propagate_retraction(node_id, opts)       # Walk derived_from/supports, reduce confidence\n\n  # Hooks\n  def register_resolution_hook(module)   # External resolver (Deliberatic, BendScript)\n  def resolve_contradiction(node_a, node_b) # Call registered hook or use default heuristic\nend"},{"id":"blk-45886","kind":"paragraph","spans":[{"id":"spn-52090","marks":["bold"],"text":"New MCP tools (register in `graphonomous/lib/graphonomous/mcp/server.ex`):"}]},{"id":"blk-45887","items":[{"blocks":[{"id":"blk-45889","kind":"paragraph","spans":[{"id":"spn-52091","marks":["code"],"text":"belief_revise"},{"id":"spn-52092","text":" — "},{"id":"spn-52093","marks":["code"],"text":"{node_id, new_content, rationale, operation: \"expand\"|\"revise\"|\"contract\"}"}]}],"id":"blk-45888","kind":"list-item"},{"blocks":[{"id":"blk-45891","kind":"paragraph","spans":[{"id":"spn-52094","marks":["code"],"text":"belief_contradictions"},{"id":"spn-52095","text":" — "},{"id":"spn-52096","marks":["code"],"text":"{node_id}"},{"id":"spn-52097","text":" or "},{"id":"spn-52098","marks":["code"],"text":"{content}"},{"id":"spn-52099","text":" — returns contradicting nodes with similarity scores"}]}],"id":"blk-45890","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45892","kind":"paragraph","spans":[{"id":"spn-52100","marks":["bold"],"text":"New edge type:"},{"id":"spn-52101","text":" Add "},{"id":"spn-52102","marks":["code"],"text":":superseded_by"},{"id":"spn-52103","text":" to valid edge types in "},{"id":"spn-52104","marks":["code"],"text":"Graph"},{"id":"spn-52105","text":" module."}]},{"id":"blk-45893","kind":"paragraph","spans":[{"id":"spn-52106","marks":["bold"],"text":"Integration with Learner:"},{"id":"spn-52107","text":" In "},{"id":"spn-52108","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-52109","text":", after "},{"id":"spn-52110","marks":["code"],"text":"store_node"},{"id":"spn-52111","text":", call "},{"id":"spn-52112","marks":["code"],"text":"detect_contradictions"},{"id":"spn-52113","text":". If found, create "},{"id":"spn-52114","marks":["code"],"text":":contradicts"},{"id":"spn-52115","text":" edges (these form 2-node SCCs = kappa=1)."}]},{"id":"blk-45894","kind":"paragraph","spans":[{"id":"spn-52116","marks":["bold"],"text":"Integration with Consolidator Stage 5:"},{"id":"spn-52117","text":" Before merging (cosine > 0.95), check if pair has "},{"id":"spn-52118","marks":["code"],"text":":contradicts"},{"id":"spn-52119","text":" edges. If so, route to "},{"id":"spn-52120","marks":["code"],"text":"BeliefRevision.resolve_contradiction/2"},{"id":"spn-52121","text":" instead of merging."}]},{"id":"blk-45895","kind":"heading","level":3,"spans":[{"id":"spn-52122","text":"3. Conflict-Aware Consolidation (3 days)"}]},{"id":"blk-45896","kind":"paragraph","spans":[{"id":"spn-52123","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/retriever.ex`"}]},{"id":"blk-45897","items":[{"blocks":[{"id":"blk-45899","kind":"paragraph","spans":[{"id":"spn-52124","text":"Add "},{"id":"spn-52125","marks":["code"],"text":"detect_and_tag_conflicts/1"},{"id":"spn-52126","text":" after ranking, before return"}]}],"id":"blk-45898","kind":"list-item"},{"blocks":[{"id":"blk-45901","kind":"paragraph","spans":[{"id":"spn-52127","text":"Tag pairs where: semantic similarity > 0.8 AND confidence divergence > 0.3"}]}],"id":"blk-45900","kind":"list-item"},{"blocks":[{"id":"blk-45903","kind":"paragraph","spans":[{"id":"spn-52128","text":"Store conflict tags in node metadata (or a lightweight ETS cache)"}]}],"id":"blk-45902","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45904","kind":"paragraph","spans":[{"id":"spn-52129","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/consolidator.ex`"}]},{"id":"blk-45905","items":[{"blocks":[{"id":"blk-45907","kind":"paragraph","spans":[{"id":"spn-52130","text":"Add Stage 4.5 between \"strengthen coactivated\" and \"merge similar\""}]}],"id":"blk-45906","kind":"list-item"},{"blocks":[{"id":"blk-45909","kind":"paragraph","spans":[{"id":"spn-52131","marks":["code"],"text":"stage_resolve_conflicts/0"},{"id":"spn-52132","text":":"}]}],"id":"blk-45908","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45910","kind":"paragraph","spans":[{"id":"spn-52133","text":"1. Find all conflict-tagged pairs 2. For each pair, try resolution strategies in order: a. Temporal (newer supersedes older) b. Evidence (more outcome references wins) c. External hook (registered resolver) d. Escalate to attention (create attention item) 3. Winning resolution: call "},{"id":"spn-52134","marks":["code"],"text":"BeliefRevision.revise/3"},{"id":"spn-52135","text":" 4. Unresolved: create "},{"id":"spn-52136","marks":["code"],"text":":contradicts"},{"id":"spn-52137","text":" edges (activates kappa)"}]},{"id":"blk-45911","kind":"paragraph","spans":[{"id":"spn-52138","marks":["bold"],"text":"Key insight:"},{"id":"spn-52139","text":" Unresolved conflicts get "},{"id":"spn-52140","marks":["code"],"text":":contradicts"},{"id":"spn-52141","text":" edges = guaranteed kappa>=1. This is the PRIMARY kappa activation mechanism for organic (non-synthetic) knowledge."}]},{"id":"blk-45912","kind":"heading","level":2,"spans":[{"id":"spn-52142","text":"Files to Read Before Coding"}]},{"id":"blk-45913","kind":"paragraph","spans":[{"id":"spn-52143","text":"Read these files FIRST to understand the current implementation:"}]},{"id":"blk-45914","kind":"paragraph","spans":[{"id":"spn-52144","text":"1. "},{"id":"spn-52145","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"},{"id":"spn-52146","text":" — retrieval pipeline, "},{"id":"spn-52147","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-52148","text":", scoring 2. "},{"id":"spn-52149","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"},{"id":"spn-52150","text":" — 7-stage pipeline, decay rates, prune logic 3. "},{"id":"spn-52151","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"},{"id":"spn-52152","text":" — "},{"id":"spn-52153","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-52154","text":", "},{"id":"spn-52155","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-52156","text":", confidence updates 4. "},{"id":"spn-52157","marks":["code"],"text":"graphonomous/lib/graphonomous/edge_extractor.ex"},{"id":"spn-52158","text":" — regex extraction, edge type assignment 5. "},{"id":"spn-52159","marks":["code"],"text":"graphonomous/lib/graphonomous/topology.ex"},{"id":"spn-52160","text":" — "},{"id":"spn-52161","marks":["code"],"text":"tarjan_scc/1"},{"id":"spn-52162","text":", "},{"id":"spn-52163","marks":["code"],"text":"compute_kappa/2"},{"id":"spn-52164","text":", "},{"id":"spn-52165","marks":["code"],"text":"analyze/1"},{"id":"spn-52166","text":" 6. "},{"id":"spn-52167","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"},{"id":"spn-52168","text":" — SQLite schema, migrations, CRUD operations 7. "},{"id":"spn-52169","marks":["code"],"text":"graphonomous/lib/graphonomous/graph.ex"},{"id":"spn-52170","text":" — edge types, graph operations 8. "},{"id":"spn-52171","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/server.ex"},{"id":"spn-52172","text":" — MCP tool registration pattern 9. "},{"id":"spn-52173","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"},{"id":"spn-52174","text":" — Node struct definition 10. "},{"id":"spn-52175","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"},{"id":"spn-52176","text":" — Edge struct definition"}]},{"id":"blk-45915","kind":"heading","level":2,"spans":[{"id":"spn-52177","text":"Coding Conventions"}]},{"id":"blk-45916","items":[{"blocks":[{"id":"blk-45918","kind":"paragraph","spans":[{"id":"spn-52178","text":"Use "},{"id":"spn-52179","marks":["code"],"text":"mix format"},{"id":"spn-52180","text":" style"}]}],"id":"blk-45917","kind":"list-item"},{"blocks":[{"id":"blk-45920","kind":"paragraph","spans":[{"id":"spn-52181","text":"All new modules need "},{"id":"spn-52182","marks":["code"],"text":"@moduledoc"},{"id":"spn-52183","text":" and "},{"id":"spn-52184","marks":["code"],"text":"@doc"},{"id":"spn-52185","text":" on public functions"}]}],"id":"blk-45919","kind":"list-item"},{"blocks":[{"id":"blk-45922","kind":"paragraph","spans":[{"id":"spn-52186","text":"Add to existing test files or create new ones in "},{"id":"spn-52187","marks":["code"],"text":"test/graphonomous/"}]}],"id":"blk-45921","kind":"list-item"},{"blocks":[{"id":"blk-45924","kind":"paragraph","spans":[{"id":"spn-52188","text":"New MCP tools follow the pattern in existing tool modules under "},{"id":"spn-52189","marks":["code"],"text":"lib/graphonomous/mcp/tools/"}]}],"id":"blk-45923","kind":"list-item"},{"blocks":[{"id":"blk-45926","kind":"paragraph","spans":[{"id":"spn-52190","text":"Schema changes go through the Store migration system"}]}],"id":"blk-45925","kind":"list-item"},{"blocks":[{"id":"blk-45928","kind":"paragraph","spans":[{"id":"spn-52191","text":"Emit telemetry events for new operations (follow existing "},{"id":"spn-52192","marks":["code"],"text":"[:graphonomous, :*, :*]"},{"id":"spn-52193","text":" pattern)"}]}],"id":"blk-45927","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45929","kind":"heading","level":2,"spans":[{"id":"spn-52194","text":"Verification Checklist"}]},{"id":"blk-45930","kind":"paragraph","spans":[{"id":"spn-52195","text":"After implementing P0:"}]},{"id":"blk-45931","items":[{"blocks":[{"id":"blk-45933","kind":"paragraph","spans":[{"id":"spn-52196","text":"[ ] "},{"id":"spn-52197","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-52198","text":" passes"}]}],"id":"blk-45932","kind":"list-item"},{"blocks":[{"id":"blk-45935","kind":"paragraph","spans":[{"id":"spn-52199","text":"[ ] "},{"id":"spn-52200","marks":["code"],"text":"mix test"},{"id":"spn-52201","text":" — all 240+ existing tests pass (regression)"}]}],"id":"blk-45934","kind":"list-item"},{"blocks":[{"id":"blk-45937","kind":"paragraph","spans":[{"id":"spn-52202","text":"[ ] New tests for BeliefRevision module pass"}]}],"id":"blk-45936","kind":"list-item"},{"blocks":[{"id":"blk-45939","kind":"paragraph","spans":[{"id":"spn-52203","text":"[ ] New tests for conflict-aware consolidation pass"}]}],"id":"blk-45938","kind":"list-item"},{"blocks":[{"id":"blk-45941","kind":"paragraph","spans":[{"id":"spn-52204","text":"[ ] New tests for expanded topology window pass"}]}],"id":"blk-45940","kind":"list-item"},{"blocks":[{"id":"blk-45943","kind":"paragraph","spans":[{"id":"spn-52205","text":"[ ] Run "},{"id":"spn-52206","marks":["code"],"text":"mix benchmark.run"},{"id":"spn-52207","text":" — verify kappa>0 appears in at least some queries"}]}],"id":"blk-45942","kind":"list-item"},{"blocks":[{"id":"blk-45945","kind":"paragraph","spans":[{"id":"spn-52208","text":"[ ] Manual test: store two contradicting facts via MCP, verify "},{"id":"spn-52209","marks":["code"],"text":":contradicts"},{"id":"spn-52210","text":" edges form, verify kappa=1 on retrieval involving both"}]}],"id":"blk-45944","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45946","kind":"heading","level":2,"spans":[{"id":"spn-52211","text":"Research References (for context, not implementation)"}]},{"id":"blk-45947","items":[{"blocks":[{"id":"blk-45949","kind":"paragraph","spans":[{"id":"spn-52212","text":"Kumiho (arxiv 2603.17244) — AGM maps to property graph operations (validates our approach)"}]}],"id":"blk-45948","kind":"list-item"},{"blocks":[{"id":"blk-45951","kind":"paragraph","spans":[{"id":"spn-52213","text":"SleepGate (arxiv 2603.14517) — separate conflict detection from resolution (our Stage 4.5 design)"}]}],"id":"blk-45950","kind":"list-item"},{"blocks":[{"id":"blk-45953","kind":"paragraph","spans":[{"id":"spn-52214","text":"MemRL (arxiv 2601.03192) — two-phase retrieval (P1, not this session)"}]}],"id":"blk-45952","kind":"list-item"},{"blocks":[{"id":"blk-45955","kind":"paragraph","spans":[{"id":"spn-52215","text":"MAGMA (arxiv 2601.03236) — multi-view adjacency indexes (future optimization for kappa)"}]}],"id":"blk-45954","kind":"list-item"},{"blocks":[{"id":"blk-45957","kind":"paragraph","spans":[{"id":"spn-52216","text":"UtU (arxiv 2402.10695) — constant-time graph unlearning (P1 forgetting, not this session)"}]}],"id":"blk-45956","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-45958","kind":"heading","level":2,"spans":[{"id":"spn-52217","text":"Success Criteria for This Session"}]},{"id":"blk-45959","kind":"paragraph","spans":[{"id":"spn-52218","text":"1. "},{"id":"spn-52219","marks":["bold"],"text":"kappa > 0 activates"},{"id":"spn-52220","text":" on at least one real retrieval query (not synthetic) 2. "},{"id":"spn-52221","marks":["bold"],"text":"Belief revision"},{"id":"spn-52222","text":" creates revision records and supersedes edges 3. "},{"id":"spn-52223","marks":["bold"],"text":"Conflict detection"},{"id":"spn-52224","text":" tags conflicts during retrieval 4. "},{"id":"spn-52225","marks":["bold"],"text":"Conflict resolution"},{"id":"spn-52226","text":" runs during consolidation Stage 4.5 5. "},{"id":"spn-52227","marks":["bold"],"text":"All existing tests pass"}]}],"edges":[],"id":"bagaaieraiu4jl4qk5hawgads626c6yznxniiaf2hgc72zcb7647qz7qfhmzq","vocabulary":"ampersand.docs.fs.v1"}