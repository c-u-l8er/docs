{"bendscript":"0.1","blocks":[{"id":"blk-46824","kind":"heading","level":1,"spans":[{"id":"spn-54330","text":"Graphonomous v0.3 Continual Learning Implementation Prompt"}]},{"id":"blk-46825","kind":"heading","level":2,"spans":[{"id":"spn-54331","text":"Session Goal"}]},{"id":"blk-46826","kind":"paragraph","spans":[{"id":"spn-54332","text":"Implement P0 continual learning capabilities for Graphonomous: "},{"id":"spn-54333","marks":["bold"],"text":"kappa activation"},{"id":"spn-54334","text":", "},{"id":"spn-54335","marks":["bold"],"text":"belief revision substrate"},{"id":"spn-54336","text":", and "},{"id":"spn-54337","marks":["bold"],"text":"conflict-aware consolidation"},{"id":"spn-54338","text":". These three capabilities together solve the kappa=0 problem — the single biggest gap between Graphonomous's competitive thesis and its measured behavior."}]},{"id":"blk-46827","kind":"heading","level":2,"spans":[{"id":"spn-54339","text":"Context"}]},{"id":"blk-46828","items":[{"blocks":[{"id":"blk-46830","kind":"paragraph","spans":[{"id":"spn-54340","marks":["bold"],"text":"Active Graphonomous goal:"},{"id":"spn-54341","text":" "},{"id":"spn-54342","marks":["code"],"text":"goal_ae39998e19f363c1519679b15d24744d"},{"id":"spn-54343","text":" — \"Graphonomous v0.3 Continual Learning Capabilities\""}]}],"id":"blk-46829","kind":"list-item"},{"blocks":[{"id":"blk-46832","kind":"paragraph","spans":[{"id":"spn-54344","marks":["bold"],"text":"Plan file:"},{"id":"spn-54345","text":" "},{"id":"spn-54346","marks":["code"],"text":"/home/travis/.claude/plans/smooth-tumbling-sunbeam.md"}]}],"id":"blk-46831","kind":"list-item"},{"blocks":[{"id":"blk-46834","kind":"paragraph","spans":[{"id":"spn-54347","marks":["bold"],"text":"Current state:"},{"id":"spn-54348","text":" v0.2.0, 240 tests passing, 22 MCP tools, kappa=0 across all 150 benchmark questions"}]}],"id":"blk-46833","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46835","kind":"heading","level":2,"spans":[{"id":"spn-54349","text":"The kappa=0 Root Cause"}]},{"id":"blk-46836","kind":"paragraph","spans":[{"id":"spn-54350","text":"The Retriever's "},{"id":"spn-54351","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-54352","text":" only builds adjacency from edges between the ~20 retrieved nodes. EdgeExtractor creates unidirectional edges via regex (A imports B -> edge A->B). Cycles require bidirectional edges, which almost never form because:"}]},{"id":"blk-46837","kind":"paragraph","spans":[{"id":"spn-54353","text":"1. Regex extraction misses conceptual back-references 2. No mechanism creates "},{"id":"spn-54354","marks":["code"],"text":":contradicts"},{"id":"spn-54355","text":"/"},{"id":"spn-54356","marks":["code"],"text":":supersedes"},{"id":"spn-54357","text":" edges automatically 3. Topology window is too narrow (only retrieved nodes, not their neighbors)"}]},{"id":"blk-46838","kind":"heading","level":2,"spans":[{"id":"spn-54358","text":"What to Build (P0, ~10 days)"}]},{"id":"blk-46839","kind":"heading","level":3,"spans":[{"id":"spn-54359","text":"1. Kappa Activation (3 days)"}]},{"id":"blk-46840","kind":"paragraph","spans":[{"id":"spn-54360","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/edge_extractor.ex`"}]},{"id":"blk-46841","items":[{"blocks":[{"id":"blk-46843","kind":"paragraph","spans":[{"id":"spn-54361","text":"Add "},{"id":"spn-54362","marks":["code"],"text":"extract_semantic_backrefs/1"},{"id":"spn-54363","text":" — after forward edge creation, compute cosine similarity between target and source embeddings. If > 0.75, create reverse "},{"id":"spn-54364","marks":["code"],"text":":supports"},{"id":"spn-54365","text":" edge."}]}],"id":"blk-46842","kind":"list-item"},{"blocks":[{"id":"blk-46845","kind":"paragraph","spans":[{"id":"spn-54366","text":"This requires access to embeddings during extraction (currently regex-only)."}]}],"id":"blk-46844","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46846","kind":"paragraph","spans":[{"id":"spn-54367","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/retriever.ex`"}]},{"id":"blk-46847","items":[{"blocks":[{"id":"blk-46849","kind":"paragraph","spans":[{"id":"spn-54368","text":"Modify "},{"id":"spn-54369","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-54370","text":" to expand the topology window: include 1-hop neighbors of retrieved nodes, not just the retrieved nodes themselves."}]}],"id":"blk-46848","kind":"list-item"},{"blocks":[{"id":"blk-46851","kind":"paragraph","spans":[{"id":"spn-54371","text":"Current code calls "},{"id":"spn-54372","marks":["code"],"text":"Store.list_edges_between(node_ids)"},{"id":"spn-54373","text":" where "},{"id":"spn-54374","marks":["code"],"text":"node_ids"},{"id":"spn-54375","text":" is ~20 retrieved results. Change to:"}]}],"id":"blk-46850","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46852","kind":"paragraph","spans":[{"id":"spn-54376","text":"1. Get edges for each retrieved node ("},{"id":"spn-54377","marks":["code"],"text":"Store.list_edges_for_node/1"},{"id":"spn-54378","text":") 2. Collect all neighbor IDs 3. Build adjacency over "},{"id":"spn-54379","marks":["code"],"text":"retrieved_ids ++ neighbor_ids"},{"id":"spn-54380","text":" 4. Run Tarjan SCC + kappa on the expanded set"}]},{"id":"blk-46853","kind":"heading","level":3,"spans":[{"id":"spn-54381","text":"2. Belief Revision Substrate (4 days)"}]},{"id":"blk-46854","kind":"paragraph","spans":[{"id":"spn-54382","marks":["bold"],"text":"Schema migration (new file in `graphonomous/lib/graphonomous/store.ex` or migration system):"}]},{"id":"blk-46855","kind":"code","language":"sql","text":"ALTER TABLE nodes ADD COLUMN revision_id TEXT;\nALTER TABLE nodes ADD COLUMN superseded_by TEXT;\n\nCREATE TABLE IF NOT EXISTS revisions (\n  id TEXT PRIMARY KEY,\n  operation TEXT NOT NULL,  -- 'expansion' | 'revision' | 'contraction'\n  trigger_node_id TEXT NOT NULL,\n  affected_node_ids TEXT NOT NULL DEFAULT '[]',\n  rationale TEXT,\n  agent_id TEXT,\n  created_at TEXT NOT NULL\n);"},{"id":"blk-46856","kind":"paragraph","spans":[{"id":"spn-54383","marks":["bold"],"text":"New file: `graphonomous/lib/graphonomous/belief_revision.ex`"}]},{"id":"blk-46857","kind":"code","language":"elixir","text":"defmodule Graphonomous.BeliefRevision do\n  @moduledoc \"\"\"\n  AGM-rational belief revision operations with provenance tracking.\n  Provides storage/provenance substrate — reasoning about which belief wins\n  is delegated to external systems (Deliberatic, BendScript) via pluggable hooks.\n  \"\"\"\n\n  # Core operations\n  def expand(content, opts \\\\ [])        # Add belief, check contradictions first\n  def revise(node_id, new_content, opts) # Supersede old belief, propagate confidence\n  def contract(node_id, opts)            # Remove belief, retract dependents\n\n  # Detection\n  def detect_contradictions(node_id_or_content) # Find contradicting nodes\n  def propagate_retraction(node_id, opts)       # Walk derived_from/supports, reduce confidence\n\n  # Hooks\n  def register_resolution_hook(module)   # External resolver (Deliberatic, BendScript)\n  def resolve_contradiction(node_a, node_b) # Call registered hook or use default heuristic\nend"},{"id":"blk-46858","kind":"paragraph","spans":[{"id":"spn-54384","marks":["bold"],"text":"New MCP tools (register in `graphonomous/lib/graphonomous/mcp/server.ex`):"}]},{"id":"blk-46859","items":[{"blocks":[{"id":"blk-46861","kind":"paragraph","spans":[{"id":"spn-54385","marks":["code"],"text":"belief_revise"},{"id":"spn-54386","text":" — "},{"id":"spn-54387","marks":["code"],"text":"{node_id, new_content, rationale, operation: \"expand\"|\"revise\"|\"contract\"}"}]}],"id":"blk-46860","kind":"list-item"},{"blocks":[{"id":"blk-46863","kind":"paragraph","spans":[{"id":"spn-54388","marks":["code"],"text":"belief_contradictions"},{"id":"spn-54389","text":" — "},{"id":"spn-54390","marks":["code"],"text":"{node_id}"},{"id":"spn-54391","text":" or "},{"id":"spn-54392","marks":["code"],"text":"{content}"},{"id":"spn-54393","text":" — returns contradicting nodes with similarity scores"}]}],"id":"blk-46862","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46864","kind":"paragraph","spans":[{"id":"spn-54394","marks":["bold"],"text":"New edge type:"},{"id":"spn-54395","text":" Add "},{"id":"spn-54396","marks":["code"],"text":":superseded_by"},{"id":"spn-54397","text":" to valid edge types in "},{"id":"spn-54398","marks":["code"],"text":"Graph"},{"id":"spn-54399","text":" module."}]},{"id":"blk-46865","kind":"paragraph","spans":[{"id":"spn-54400","marks":["bold"],"text":"Integration with Learner:"},{"id":"spn-54401","text":" In "},{"id":"spn-54402","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-54403","text":", after "},{"id":"spn-54404","marks":["code"],"text":"store_node"},{"id":"spn-54405","text":", call "},{"id":"spn-54406","marks":["code"],"text":"detect_contradictions"},{"id":"spn-54407","text":". If found, create "},{"id":"spn-54408","marks":["code"],"text":":contradicts"},{"id":"spn-54409","text":" edges (these form 2-node SCCs = kappa=1)."}]},{"id":"blk-46866","kind":"paragraph","spans":[{"id":"spn-54410","marks":["bold"],"text":"Integration with Consolidator Stage 5:"},{"id":"spn-54411","text":" Before merging (cosine > 0.95), check if pair has "},{"id":"spn-54412","marks":["code"],"text":":contradicts"},{"id":"spn-54413","text":" edges. If so, route to "},{"id":"spn-54414","marks":["code"],"text":"BeliefRevision.resolve_contradiction/2"},{"id":"spn-54415","text":" instead of merging."}]},{"id":"blk-46867","kind":"heading","level":3,"spans":[{"id":"spn-54416","text":"3. Conflict-Aware Consolidation (3 days)"}]},{"id":"blk-46868","kind":"paragraph","spans":[{"id":"spn-54417","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/retriever.ex`"}]},{"id":"blk-46869","items":[{"blocks":[{"id":"blk-46871","kind":"paragraph","spans":[{"id":"spn-54418","text":"Add "},{"id":"spn-54419","marks":["code"],"text":"detect_and_tag_conflicts/1"},{"id":"spn-54420","text":" after ranking, before return"}]}],"id":"blk-46870","kind":"list-item"},{"blocks":[{"id":"blk-46873","kind":"paragraph","spans":[{"id":"spn-54421","text":"Tag pairs where: semantic similarity > 0.8 AND confidence divergence > 0.3"}]}],"id":"blk-46872","kind":"list-item"},{"blocks":[{"id":"blk-46875","kind":"paragraph","spans":[{"id":"spn-54422","text":"Store conflict tags in node metadata (or a lightweight ETS cache)"}]}],"id":"blk-46874","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46876","kind":"paragraph","spans":[{"id":"spn-54423","marks":["bold"],"text":"File: `graphonomous/lib/graphonomous/consolidator.ex`"}]},{"id":"blk-46877","items":[{"blocks":[{"id":"blk-46879","kind":"paragraph","spans":[{"id":"spn-54424","text":"Add Stage 4.5 between \"strengthen coactivated\" and \"merge similar\""}]}],"id":"blk-46878","kind":"list-item"},{"blocks":[{"id":"blk-46881","kind":"paragraph","spans":[{"id":"spn-54425","marks":["code"],"text":"stage_resolve_conflicts/0"},{"id":"spn-54426","text":":"}]}],"id":"blk-46880","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46882","kind":"paragraph","spans":[{"id":"spn-54427","text":"1. Find all conflict-tagged pairs 2. For each pair, try resolution strategies in order: a. Temporal (newer supersedes older) b. Evidence (more outcome references wins) c. External hook (registered resolver) d. Escalate to attention (create attention item) 3. Winning resolution: call "},{"id":"spn-54428","marks":["code"],"text":"BeliefRevision.revise/3"},{"id":"spn-54429","text":" 4. Unresolved: create "},{"id":"spn-54430","marks":["code"],"text":":contradicts"},{"id":"spn-54431","text":" edges (activates kappa)"}]},{"id":"blk-46883","kind":"paragraph","spans":[{"id":"spn-54432","marks":["bold"],"text":"Key insight:"},{"id":"spn-54433","text":" Unresolved conflicts get "},{"id":"spn-54434","marks":["code"],"text":":contradicts"},{"id":"spn-54435","text":" edges = guaranteed kappa>=1. This is the PRIMARY kappa activation mechanism for organic (non-synthetic) knowledge."}]},{"id":"blk-46884","kind":"heading","level":2,"spans":[{"id":"spn-54436","text":"Files to Read Before Coding"}]},{"id":"blk-46885","kind":"paragraph","spans":[{"id":"spn-54437","text":"Read these files FIRST to understand the current implementation:"}]},{"id":"blk-46886","kind":"paragraph","spans":[{"id":"spn-54438","text":"1. "},{"id":"spn-54439","marks":["code"],"text":"graphonomous/lib/graphonomous/retriever.ex"},{"id":"spn-54440","text":" — retrieval pipeline, "},{"id":"spn-54441","marks":["code"],"text":"analyze_topology/1"},{"id":"spn-54442","text":", scoring 2. "},{"id":"spn-54443","marks":["code"],"text":"graphonomous/lib/graphonomous/consolidator.ex"},{"id":"spn-54444","text":" — 7-stage pipeline, decay rates, prune logic 3. "},{"id":"spn-54445","marks":["code"],"text":"graphonomous/lib/graphonomous/learner.ex"},{"id":"spn-54446","text":" — "},{"id":"spn-54447","marks":["code"],"text":"learn_from_interaction"},{"id":"spn-54448","text":", "},{"id":"spn-54449","marks":["code"],"text":"learn_from_outcome"},{"id":"spn-54450","text":", confidence updates 4. "},{"id":"spn-54451","marks":["code"],"text":"graphonomous/lib/graphonomous/edge_extractor.ex"},{"id":"spn-54452","text":" — regex extraction, edge type assignment 5. "},{"id":"spn-54453","marks":["code"],"text":"graphonomous/lib/graphonomous/topology.ex"},{"id":"spn-54454","text":" — "},{"id":"spn-54455","marks":["code"],"text":"tarjan_scc/1"},{"id":"spn-54456","text":", "},{"id":"spn-54457","marks":["code"],"text":"compute_kappa/2"},{"id":"spn-54458","text":", "},{"id":"spn-54459","marks":["code"],"text":"analyze/1"},{"id":"spn-54460","text":" 6. "},{"id":"spn-54461","marks":["code"],"text":"graphonomous/lib/graphonomous/store.ex"},{"id":"spn-54462","text":" — SQLite schema, migrations, CRUD operations 7. "},{"id":"spn-54463","marks":["code"],"text":"graphonomous/lib/graphonomous/graph.ex"},{"id":"spn-54464","text":" — edge types, graph operations 8. "},{"id":"spn-54465","marks":["code"],"text":"graphonomous/lib/graphonomous/mcp/server.ex"},{"id":"spn-54466","text":" — MCP tool registration pattern 9. "},{"id":"spn-54467","marks":["code"],"text":"graphonomous/lib/graphonomous/types/node.ex"},{"id":"spn-54468","text":" — Node struct definition 10. "},{"id":"spn-54469","marks":["code"],"text":"graphonomous/lib/graphonomous/types/edge.ex"},{"id":"spn-54470","text":" — Edge struct definition"}]},{"id":"blk-46887","kind":"heading","level":2,"spans":[{"id":"spn-54471","text":"Coding Conventions"}]},{"id":"blk-46888","items":[{"blocks":[{"id":"blk-46890","kind":"paragraph","spans":[{"id":"spn-54472","text":"Use "},{"id":"spn-54473","marks":["code"],"text":"mix format"},{"id":"spn-54474","text":" style"}]}],"id":"blk-46889","kind":"list-item"},{"blocks":[{"id":"blk-46892","kind":"paragraph","spans":[{"id":"spn-54475","text":"All new modules need "},{"id":"spn-54476","marks":["code"],"text":"@moduledoc"},{"id":"spn-54477","text":" and "},{"id":"spn-54478","marks":["code"],"text":"@doc"},{"id":"spn-54479","text":" on public functions"}]}],"id":"blk-46891","kind":"list-item"},{"blocks":[{"id":"blk-46894","kind":"paragraph","spans":[{"id":"spn-54480","text":"Add to existing test files or create new ones in "},{"id":"spn-54481","marks":["code"],"text":"test/graphonomous/"}]}],"id":"blk-46893","kind":"list-item"},{"blocks":[{"id":"blk-46896","kind":"paragraph","spans":[{"id":"spn-54482","text":"New MCP tools follow the pattern in existing tool modules under "},{"id":"spn-54483","marks":["code"],"text":"lib/graphonomous/mcp/tools/"}]}],"id":"blk-46895","kind":"list-item"},{"blocks":[{"id":"blk-46898","kind":"paragraph","spans":[{"id":"spn-54484","text":"Schema changes go through the Store migration system"}]}],"id":"blk-46897","kind":"list-item"},{"blocks":[{"id":"blk-46900","kind":"paragraph","spans":[{"id":"spn-54485","text":"Emit telemetry events for new operations (follow existing "},{"id":"spn-54486","marks":["code"],"text":"[:graphonomous, :*, :*]"},{"id":"spn-54487","text":" pattern)"}]}],"id":"blk-46899","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46901","kind":"heading","level":2,"spans":[{"id":"spn-54488","text":"Verification Checklist"}]},{"id":"blk-46902","kind":"paragraph","spans":[{"id":"spn-54489","text":"After implementing P0:"}]},{"id":"blk-46903","items":[{"blocks":[{"id":"blk-46905","kind":"paragraph","spans":[{"id":"spn-54490","text":"[ ] "},{"id":"spn-54491","marks":["code"],"text":"mix compile --warnings-as-errors"},{"id":"spn-54492","text":" passes"}]}],"id":"blk-46904","kind":"list-item"},{"blocks":[{"id":"blk-46907","kind":"paragraph","spans":[{"id":"spn-54493","text":"[ ] "},{"id":"spn-54494","marks":["code"],"text":"mix test"},{"id":"spn-54495","text":" — all 240+ existing tests pass (regression)"}]}],"id":"blk-46906","kind":"list-item"},{"blocks":[{"id":"blk-46909","kind":"paragraph","spans":[{"id":"spn-54496","text":"[ ] New tests for BeliefRevision module pass"}]}],"id":"blk-46908","kind":"list-item"},{"blocks":[{"id":"blk-46911","kind":"paragraph","spans":[{"id":"spn-54497","text":"[ ] New tests for conflict-aware consolidation pass"}]}],"id":"blk-46910","kind":"list-item"},{"blocks":[{"id":"blk-46913","kind":"paragraph","spans":[{"id":"spn-54498","text":"[ ] New tests for expanded topology window pass"}]}],"id":"blk-46912","kind":"list-item"},{"blocks":[{"id":"blk-46915","kind":"paragraph","spans":[{"id":"spn-54499","text":"[ ] Run "},{"id":"spn-54500","marks":["code"],"text":"mix benchmark.run"},{"id":"spn-54501","text":" — verify kappa>0 appears in at least some queries"}]}],"id":"blk-46914","kind":"list-item"},{"blocks":[{"id":"blk-46917","kind":"paragraph","spans":[{"id":"spn-54502","text":"[ ] Manual test: store two contradicting facts via MCP, verify "},{"id":"spn-54503","marks":["code"],"text":":contradicts"},{"id":"spn-54504","text":" edges form, verify kappa=1 on retrieval involving both"}]}],"id":"blk-46916","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46918","kind":"heading","level":2,"spans":[{"id":"spn-54505","text":"Research References (for context, not implementation)"}]},{"id":"blk-46919","items":[{"blocks":[{"id":"blk-46921","kind":"paragraph","spans":[{"id":"spn-54506","text":"Kumiho (arxiv 2603.17244) — AGM maps to property graph operations (validates our approach)"}]}],"id":"blk-46920","kind":"list-item"},{"blocks":[{"id":"blk-46923","kind":"paragraph","spans":[{"id":"spn-54507","text":"SleepGate (arxiv 2603.14517) — separate conflict detection from resolution (our Stage 4.5 design)"}]}],"id":"blk-46922","kind":"list-item"},{"blocks":[{"id":"blk-46925","kind":"paragraph","spans":[{"id":"spn-54508","text":"MemRL (arxiv 2601.03192) — two-phase retrieval (P1, not this session)"}]}],"id":"blk-46924","kind":"list-item"},{"blocks":[{"id":"blk-46927","kind":"paragraph","spans":[{"id":"spn-54509","text":"MAGMA (arxiv 2601.03236) — multi-view adjacency indexes (future optimization for kappa)"}]}],"id":"blk-46926","kind":"list-item"},{"blocks":[{"id":"blk-46929","kind":"paragraph","spans":[{"id":"spn-54510","text":"UtU (arxiv 2402.10695) — constant-time graph unlearning (P1 forgetting, not this session)"}]}],"id":"blk-46928","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-46930","kind":"heading","level":2,"spans":[{"id":"spn-54511","text":"Success Criteria for This Session"}]},{"id":"blk-46931","kind":"paragraph","spans":[{"id":"spn-54512","text":"1. "},{"id":"spn-54513","marks":["bold"],"text":"kappa > 0 activates"},{"id":"spn-54514","text":" on at least one real retrieval query (not synthetic) 2. "},{"id":"spn-54515","marks":["bold"],"text":"Belief revision"},{"id":"spn-54516","text":" creates revision records and supersedes edges 3. "},{"id":"spn-54517","marks":["bold"],"text":"Conflict detection"},{"id":"spn-54518","text":" tags conflicts during retrieval 4. "},{"id":"spn-54519","marks":["bold"],"text":"Conflict resolution"},{"id":"spn-54520","text":" runs during consolidation Stage 4.5 5. "},{"id":"spn-54521","marks":["bold"],"text":"All existing tests pass"}]}],"edges":[],"id":"bagaaierasm53eckynxd2saglbeok7mlud37gqz7cie7qgqr3tf75tshz3ljq","vocabulary":"ampersand.docs.fs.v1"}