{"bendscript":"0.1","blocks":[{"id":"blk-55509","kind":"heading","level":1,"spans":[{"id":"spn-81825","text":"AgenTroMatic — Automatic Deliberation Engine"}]},{"id":"blk-55510","kind":"paragraph","spans":[{"id":"spn-81826","text":"Automatic deliberation engine for multi-agent AI systems. Agents bid, debate, elect leaders by consensus, execute under quorum, and build reputation over time."}]},{"id":"blk-55511","kind":"heading","level":2,"spans":[{"id":"spn-81827","text":"Source-of-truth spec"}]},{"id":"blk-55512","items":[{"blocks":[{"id":"blk-55514","kind":"paragraph","spans":[{"id":"spn-81828","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-81829","text":" — AgenTroMatic technical specification"}]}],"id":"blk-55513","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55515","kind":"heading","level":2,"spans":[{"id":"spn-81830","text":"Role in [&] Ecosystem"}]},{"id":"blk-55516","kind":"paragraph","spans":[{"id":"spn-81831","text":"AgenTroMatic is the "},{"id":"spn-81832","marks":["bold"],"text":"automation layer"},{"id":"spn-81833","text":" — the service mesh that sits between governance (Delegatic) and raw agent execution. It adds consensus, resilience, observability, and reputation tracking on top of Google's A2A protocol."}]},{"id":"blk-55517","kind":"heading","level":2,"spans":[{"id":"spn-81834","text":"Design principles"}]},{"id":"blk-55518","items":[{"blocks":[{"id":"blk-55520","kind":"paragraph","spans":[{"id":"spn-81835","text":"Deliberation over routing — agents negotiate every time"}]}],"id":"blk-55519","kind":"list-item"},{"blocks":[{"id":"blk-55522","kind":"paragraph","spans":[{"id":"spn-81836","text":"A2A-native — all inter-agent messages flow through standard A2A protocol"}]}],"id":"blk-55521","kind":"list-item"},{"blocks":[{"id":"blk-55524","kind":"paragraph","spans":[{"id":"spn-81837","text":"Reputation is memory — past performance shapes future assignments"}]}],"id":"blk-55523","kind":"list-item"},{"blocks":[{"id":"blk-55526","kind":"paragraph","spans":[{"id":"spn-81838","text":"Visible by default — every deliberation is traceable via the Observatory"}]}],"id":"blk-55525","kind":"list-item"},{"blocks":[{"id":"blk-55528","kind":"paragraph","spans":[{"id":"spn-81839","text":"Consensus before commit — Ra (Raft) quorum validation required"}]}],"id":"blk-55527","kind":"list-item"},{"blocks":[{"id":"blk-55530","kind":"paragraph","spans":[{"id":"spn-81840","text":"Governance-aware — respects Delegatic policy boundaries"}]}],"id":"blk-55529","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-55531","kind":"heading","level":2,"spans":[{"id":"spn-81841","text":"Tech stack"}]},{"id":"blk-55532","kind":"paragraph","spans":[{"id":"spn-81842","text":"Elixir/OTP, Phoenix LiveView, Ra (Raft), PostgreSQL, ETS"}]},{"id":"blk-55533","kind":"heading","level":2,"spans":[{"id":"spn-81843","text":"Status"}]},{"id":"blk-55534","kind":"paragraph","spans":[{"id":"spn-81844","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieranc2wdlocbhh6f4pbkyf2nu5oufwb2d5a2ybztlvpbqeeeeurrkkq","vocabulary":"ampersand.docs.fs.v1"}