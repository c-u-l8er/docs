{"bendscript":"0.1","blocks":[{"id":"blk-55381","kind":"heading","level":1,"spans":[{"id":"spn-81665","text":"AgenTroMatic — Automatic Deliberation Engine"}]},{"id":"blk-55382","kind":"paragraph","spans":[{"id":"spn-81666","text":"Automatic deliberation engine for multi-agent AI systems. Agents bid, debate, elect leaders by consensus, execute under quorum, and build reputation over time."}]},{"id":"blk-55383","kind":"heading","level":2,"spans":[{"id":"spn-81667","text":"Source-of-truth spec"}]},{"id":"blk-55384","items":[{"blocks":[{"id":"blk-55386","kind":"paragraph","spans":[{"id":"spn-81668","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-81669","text":" — AgenTroMatic technical specification"}]}],"id":"blk-55385","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-55387","kind":"heading","level":2,"spans":[{"id":"spn-81670","text":"Role in [&] Ecosystem"}]},{"id":"blk-55388","kind":"paragraph","spans":[{"id":"spn-81671","text":"AgenTroMatic is the "},{"id":"spn-81672","marks":["bold"],"text":"automation layer"},{"id":"spn-81673","text":" — the service mesh that sits between governance (Delegatic) and raw agent execution. It adds consensus, resilience, observability, and reputation tracking on top of Google's A2A protocol."}]},{"id":"blk-55389","kind":"heading","level":2,"spans":[{"id":"spn-81674","text":"Design principles"}]},{"id":"blk-55390","items":[{"blocks":[{"id":"blk-55392","kind":"paragraph","spans":[{"id":"spn-81675","text":"Deliberation over routing — agents negotiate every time"}]}],"id":"blk-55391","kind":"list-item"},{"blocks":[{"id":"blk-55394","kind":"paragraph","spans":[{"id":"spn-81676","text":"A2A-native — all inter-agent messages flow through standard A2A protocol"}]}],"id":"blk-55393","kind":"list-item"},{"blocks":[{"id":"blk-55396","kind":"paragraph","spans":[{"id":"spn-81677","text":"Reputation is memory — past performance shapes future assignments"}]}],"id":"blk-55395","kind":"list-item"},{"blocks":[{"id":"blk-55398","kind":"paragraph","spans":[{"id":"spn-81678","text":"Visible by default — every deliberation is traceable via the Observatory"}]}],"id":"blk-55397","kind":"list-item"},{"blocks":[{"id":"blk-55400","kind":"paragraph","spans":[{"id":"spn-81679","text":"Consensus before commit — Ra (Raft) quorum validation required"}]}],"id":"blk-55399","kind":"list-item"},{"blocks":[{"id":"blk-55402","kind":"paragraph","spans":[{"id":"spn-81680","text":"Governance-aware — respects Delegatic policy boundaries"}]}],"id":"blk-55401","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-55403","kind":"heading","level":2,"spans":[{"id":"spn-81681","text":"Tech stack"}]},{"id":"blk-55404","kind":"paragraph","spans":[{"id":"spn-81682","text":"Elixir/OTP, Phoenix LiveView, Ra (Raft), PostgreSQL, ETS"}]},{"id":"blk-55405","kind":"heading","level":2,"spans":[{"id":"spn-81683","text":"Status"}]},{"id":"blk-55406","kind":"paragraph","spans":[{"id":"spn-81684","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaierafjaov5gxnh34k5umcmvywncytxcwigpzk2roignjnjzkaevacnxa","vocabulary":"ampersand.docs.fs.v1"}