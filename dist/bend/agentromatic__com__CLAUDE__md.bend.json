{"bendscript":"0.1","blocks":[{"id":"blk-52069","kind":"heading","level":1,"spans":[{"id":"spn-99936","text":"AgenTroMatic — Automatic Deliberation Engine"}]},{"id":"blk-52070","kind":"paragraph","spans":[{"id":"spn-99937","text":"Automatic deliberation engine for multi-agent AI systems. Agents bid, debate, elect leaders by consensus, execute under quorum, and build reputation over time."}]},{"id":"blk-52071","kind":"heading","level":2,"spans":[{"id":"spn-99938","text":"Source-of-truth spec"}]},{"id":"blk-52072","items":[{"blocks":[{"id":"blk-52074","kind":"paragraph","spans":[{"id":"spn-99939","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-99940","text":" — AgenTroMatic technical specification"}]}],"id":"blk-52073","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52075","kind":"heading","level":2,"spans":[{"id":"spn-99941","text":"Role in [&] Ecosystem"}]},{"id":"blk-52076","kind":"paragraph","spans":[{"id":"spn-99942","text":"AgenTroMatic is the "},{"id":"spn-99943","marks":["bold"],"text":"automation layer"},{"id":"spn-99944","text":" — the service mesh that sits between governance (Delegatic) and raw agent execution. It adds consensus, resilience, observability, and reputation tracking on top of Google's A2A protocol."}]},{"id":"blk-52077","kind":"heading","level":2,"spans":[{"id":"spn-99945","text":"Design principles"}]},{"id":"blk-52078","items":[{"blocks":[{"id":"blk-52080","kind":"paragraph","spans":[{"id":"spn-99946","text":"Deliberation over routing — agents negotiate every time"}]}],"id":"blk-52079","kind":"list-item"},{"blocks":[{"id":"blk-52082","kind":"paragraph","spans":[{"id":"spn-99947","text":"A2A-native — all inter-agent messages flow through standard A2A protocol"}]}],"id":"blk-52081","kind":"list-item"},{"blocks":[{"id":"blk-52084","kind":"paragraph","spans":[{"id":"spn-99948","text":"Reputation is memory — past performance shapes future assignments"}]}],"id":"blk-52083","kind":"list-item"},{"blocks":[{"id":"blk-52086","