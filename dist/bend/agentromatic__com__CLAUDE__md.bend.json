{"bendscript":"0.1","blocks":[{"id":"blk-56264","kind":"heading","level":1,"spans":[{"id":"spn-84298","text":"AgenTroMatic — Automatic Deliberation Engine"}]},{"id":"blk-56265","kind":"paragraph","spans":[{"id":"spn-84299","text":"Automatic deliberation engine for multi-agent AI systems. Agents bid, debate, elect leaders by consensus, execute under quorum, and build reputation over time."}]},{"id":"blk-56266","kind":"heading","level":2,"spans":[{"id":"spn-84300","text":"Source-of-truth spec"}]},{"id":"blk-56267","items":[{"blocks":[{"id":"blk-56269","kind":"paragraph","spans":[{"id":"spn-84301","marks":["code"],"text":"docs/spec/README.md"},{"id":"spn-84302","text":" — AgenTroMatic technical specification"}]}],"id":"blk-56268","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-56270","kind":"heading","level":2,"spans":[{"id":"spn-84303","text":"Role in [&] Ecosystem"}]},{"id":"blk-56271","kind":"paragraph","spans":[{"id":"spn-84304","text":"AgenTroMatic is the "},{"id":"spn-84305","marks":["bold"],"text":"automation layer"},{"id":"spn-84306","text":" — the service mesh that sits between governance (Delegatic) and raw agent execution. It adds consensus, resilience, observability, and reputation tracking on top of Google's A2A protocol."}]},{"id":"blk-56272","kind":"heading","level":2,"spans":[{"id":"spn-84307","text":"Design principles"}]},{"id":"blk-56273","items":[{"blocks":[{"id":"blk-56275","kind":"paragraph","spans":[{"id":"spn-84308","text":"Deliberation over routing — agents negotiate every time"}]}],"id":"blk-56274","kind":"list-item"},{"blocks":[{"id":"blk-56277","kind":"paragraph","spans":[{"id":"spn-84309","text":"A2A-native — all inter-agent messages flow through standard A2A protocol"}]}],"id":"blk-56276","kind":"list-item"},{"blocks":[{"id":"blk-56279","kind":"paragraph","spans":[{"id":"spn-84310","text":"Reputation is memory — past performance shapes future assignments"}]}],"id":"blk-56278","kind":"list-item"},{"blocks":[{"id":"blk-56281","kind":"paragraph","spans":[{"id":"spn-84311","text":"Visible by default — every deliberation is traceable via the Observatory"}]}],"id":"blk-56280","kind":"list-item"},{"blocks":[{"id":"blk-56283","kind":"paragraph","spans":[{"id":"spn-84312","text":"Consensus before commit — Ra (Raft) quorum validation required"}]}],"id":"blk-56282","kind":"list-item"},{"blocks":[{"id":"blk-56285","kind":"paragraph","spans":[{"id":"spn-84313","text":"Governance-aware — respects Delegatic policy boundaries"}]}],"id":"blk-56284","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-56286","kind":"heading","level":2,"spans":[{"id":"spn-84314","text":"Tech stack"}]},{"id":"blk-56287","kind":"paragraph","spans":[{"id":"spn-84315","text":"Elixir/OTP, Phoenix LiveView, Ra (Raft), PostgreSQL, ETS"}]},{"id":"blk-56288","kind":"heading","level":2,"spans":[{"id":"spn-84316","text":"Status"}]},{"id":"blk-56289","kind":"paragraph","spans":[{"id":"spn-84317","text":"This is a spec + marketing site. No implementation code yet. Implementation will be Elixir/OTP."}]}],"edges":[],"id":"bagaaieraea46qoz5mqzhks2isn7u7a62ywrvz4gt6vmo2ifjgxugfifjznna","vocabulary":"ampersand.docs.fs.v1"}