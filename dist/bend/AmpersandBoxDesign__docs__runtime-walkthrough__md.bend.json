{"bendscript":"0.1","blocks":[{"id":"blk-15894","kind":"heading","level":1,"spans":[{"id":"spn-13891","text":"Runtime Walkthrough"}]},{"id":"blk-15895","kind":"paragraph","spans":[{"id":"spn-13892","text":"This page shows what happens when a runtime processes an "},{"id":"spn-13893","marks":[{"kind":"link","predicate":"cites","target":"#/AmpersandBoxDesign/docs/architecture.md"}],"text":"`ampersand.json`"},{"id":"spn-13894","text":" declaration from start to finish."}]},{"id":"blk-15896","kind":"paragraph","spans":[{"id":"spn-13895","text":"The goal is to make the protocol operational, not just conceptual. The CLI flow shown here is reproducible in the reference implementation; for copy/paste setup steps and captured command output, see "},{"id":"spn-13896","marks":[{"kind":"link","predicate":"cites","target":"#/AmpersandBoxDesign/docs/quickstart.md"}],"text":"`quickstart.md`"},{"id":"spn-13897","text":"."}]},{"id":"blk-15897","kind":"paragraph","spans":[{"id":"spn-13898","text":"It answers practical questions such as:"}]},{"id":"blk-15898","items":[{"blocks":[{"id":"blk-15900","kind":"paragraph","spans":[{"id":"spn-13899","text":"what gets validated first"}]}],"id":"blk-15899","kind":"list-item"},{"blocks":[{"id":"blk-15902","kind":"paragraph","spans":[{"id":"spn-13900","text":"what gets normalized during composition"}]}],"id":"blk-15901","kind":"list-item"},{"blocks":[{"id":"blk-15904","kind":"paragraph","spans":[{"id":"spn-13901","text":"when providers are resolved"}]}],"id":"blk-15903","kind":"list-item"},{"blocks":[{"id":"blk-15906","kind":"paragraph","spans":[{"id":"spn-13902","text":"how governance and provenance are preserved"}]}],"id":"blk-15905","kind":"list-item"},{"blocks":[{"id":"blk-15908","kind":"paragraph","spans":[{"id":"spn-13903","text":"what generation into MCP and A2A artifacts looks like"}]}],"id":"blk-15907","kind":"list-item"},{"blocks":[{"id":"blk-15910","kind":"paragraph","spans":[{"id":"spn-13904","text":"what a failure looks like in CLI output"}]}],"id":"blk-15909","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15911","kind":"heading","level":2,"spans":[{"id":"spn-13905","text":"1. What this walkthrough is"}]},{"id":"blk-15912","kind":"paragraph","spans":[{"id":"spn-13906","text":"This is a "},{"id":"spn-13907","marks":["bold"],"text":"reference workflow"},{"id":"spn-13908","text":" for an implementation of the [&] Protocol."}]},{"id":"blk-15913","kind":"paragraph","spans":[{"id":"spn-13909","text":"It is not a requirement that every runtime use the same CLI syntax or internal module layout. It "},{"id":"spn-13910","marks":["bold"],"text":"is"},{"id":"spn-13911","text":" the intended lifecycle of the protocol:"}]},{"id":"blk-15914","items":[{"blocks":[{"id":"blk-15916","kind":"paragraph","spans":[{"id":"spn-13912","text":"declaration"}]}],"id":"blk-15915","kind":"list-item"},{"blocks":[{"id":"blk-15918","kind":"paragraph","spans":[{"id":"spn-13913","text":"validation"}]}],"id":"blk-15917","kind":"list-item"},{"blocks":[{"id":"blk-15920","kind":"paragraph","spans":[{"id":"spn-13914","text":"composition"}]}],"id":"blk-15919","kind":"list-item"},{"blocks":[{"id":"blk-15922","kind":"paragraph","spans":[{"id":"spn-13915","text":"contract checking"}]}],"id":"blk-15921","kind":"list-item"},{"blocks":[{"id":"blk-15924","kind":"paragraph","spans":[{"id":"spn-13916","text":"provider resolution"}]}],"id":"blk-15923","kind":"list-item"},{"blocks":[{"id":"blk-15926","kind":"paragraph","spans":[{"id":"spn-13917","text":"generation"}]}],"id":"blk-15925","kind":"list-item"},{"blocks":[{"id":"blk-15928","kind":"paragraph","spans":[{"id":"spn-13918","text":"execution-time provenance emission"}]}],"id":"blk-15927","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-15929","kind":"paragraph","spans":[{"id":"spn-13919","text":"In short:"}]},{"blocks":[{"id":"blk-15931","kind":"paragraph","spans":[{"id":"spn-13920","text":"declaration → validation → composition → resolution → generation"}]}],"id":"blk-15930","kind":"quote"},{"id":"blk-15932","kind":"heading","level":2,"spans":[{"id":"spn-13921","text":"2. A minimal declaration"}]},{"id":"blk-15933","kind":"paragraph","spans":[{"id":"spn-13922","text":"Consider an infrastructure operations agent that needs:"}]},{"id":"blk-15934","items":[{"blocks":[{"id":"blk-15936","kind":"paragraph","spans":[{"id":"spn-13923","text":"graph-backed recall of prior incidents"}]}],"id":"blk-15935","kind":"list-item"},{"blocks":[{"id":"blk-15938","kind":"paragraph","spans":[{"id":"spn-13924","text":"anomaly detection over telemetry"}]}],"id":"blk-15937","kind":"list-item"},{"blocks":[{"id":"blk-15940","kind":"paragraph","spans":[{"id":"spn-13925","text":"fleet localization"}]}],"id":"blk-15939","kind":"list-item"},{"blocks":[{"id":"blk-15942","kind":"paragraph","spans":[{"id":"spn-13926","text":"argument-based reasoning under governance constraints"}]}],"id":"blk-15941","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15943","kind":"paragraph","spans":[{"id":"spn-13927","text":"A declaration may look like this:"}]},{"id":"blk-15944","kind":"code","language":"json","text":"{\n  \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\",\n  \"agent\": \"infra-ops\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": {\n    \"&memory.graph\": {\n      \"provider\": \"graphonomous\",\n      \"config\": {\n        \"instance\": \"infra-ops\"\n      }\n    },\n    \"&time.anomaly\": {\n      \"provider\": \"ticktickclock\",\n      \"config\": {\n        \"streams\": [\"cpu\", \"mem\", \"latency\"]\n      }\n    },\n    \"&space.fleet\": {\n      \"provider\": \"geofleetic\",\n      \"config\": {\n        \"regions\": [\"us-east-1\", \"us-west-2\", \"eu-central-1\"]\n      }\n    },\n    \"&reason.argument\": {\n      \"provider\": \"deliberatic\",\n      \"config\": {\n        \"governance\": \"constitutional\"\n      }\n    }\n  },\n  \"governance\": {\n    \"hard\": [\n      \"do_not_recommend_destructive_action_without_human_review\"\n    ],\n    \"soft\": [\n      \"prefer_reversible_remediation\"\n    ],\n    \"escalate_when\": [\n      \"confidence_below:0.75\",\n      \"cross_region_impact=true\"\n    ]\n  },\n  \"provenance\": {\n    \"mode\": \"hash-linked\"\n  }\n}"},{"id":"blk-15945","kind":"heading","level":3,"spans":[{"id":"spn-13928","text":"What the runtime sees immediately"}]},{"id":"blk-15946","kind":"paragraph","spans":[{"id":"spn-13929","text":"Before doing any execution, a runtime can already infer:"}]},{"id":"blk-15947","items":[{"blocks":[{"id":"blk-15949","kind":"paragraph","spans":[{"id":"spn-13930","text":"the declaration targets one agent: "},{"id":"spn-13931","marks":["code"],"text":"infra-ops"}]}],"id":"blk-15948","kind":"list-item"},{"blocks":[{"id":"blk-15951","kind":"paragraph","spans":[{"id":"spn-13932","text":"four capability bindings are requested"}]}],"id":"blk-15950","kind":"list-item"},{"blocks":[{"id":"blk-15953","kind":"paragraph","spans":[{"id":"spn-13933","text":"provider identity is explicit rather than automatic"}]}],"id":"blk-15952","kind":"list-item"},{"blocks":[{"id":"blk-15955","kind":"paragraph","spans":[{"id":"spn-13934","text":"governance must survive the rest of the lifecycle"}]}],"id":"blk-15954","kind":"list-item"},{"blocks":[{"id":"blk-15957","kind":"paragraph","spans":[{"id":"spn-13935","text":"provenance is expected to be preserved in a hash-linked form"}]}],"id":"blk-15956","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15958","kind":"heading","level":2,"spans":[{"id":"spn-13936","text":"3. Step 1: schema validation"}]},{"id":"blk-15959","kind":"paragraph","spans":[{"id":"spn-13937","text":"The first step is structural validation."}]},{"id":"blk-15960","kind":"paragraph","spans":[{"id":"spn-13938","text":"A CLI might expose that as (with reproducible command/output examples in "},{"id":"spn-13939","marks":[{"kind":"link","predicate":"cites","target":"#/AmpersandBoxDesign/docs/quickstart.md"}],"text":"`quickstart.md`"},{"id":"spn-13940","text":"):"}]},{"id":"blk-15961","kind":"code","language":"text","text":"$ ampersand validate examples/infra-ops.ampersand.json\n✔ schema valid\n✔ agent id present\n✔ version present\n✔ capabilities object valid\n✔ governance object valid\n✔ provenance object valid"},{"id":"blk-15962","kind":"paragraph","spans":[{"id":"spn-13941","text":"At this stage the runtime is checking things like:"}]},{"id":"blk-15963","items":[{"blocks":[{"id":"blk-15965","kind":"paragraph","spans":[{"id":"spn-13942","text":"required top-level fields exist"}]}],"id":"blk-15964","kind":"list-item"},{"blocks":[{"id":"blk-15967","kind":"paragraph","spans":[{"id":"spn-13943","text":"the capabilities object is well-formed"}]}],"id":"blk-15966","kind":"list-item"},{"blocks":[{"id":"blk-15969","kind":"paragraph","spans":[{"id":"spn-13944","text":"each capability entry matches the declaration schema"}]}],"id":"blk-15968","kind":"list-item"},{"blocks":[{"id":"blk-15971","kind":"paragraph","spans":[{"id":"spn-13945","text":"governance and provenance fields have valid shapes"}]}],"id":"blk-15970","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15972","kind":"heading","level":3,"spans":[{"id":"spn-13946","text":"What validation does not do yet"}]},{"id":"blk-15973","kind":"paragraph","spans":[{"id":"spn-13947","text":"Schema validation alone does "},{"id":"spn-13948","marks":["bold"],"text":"not"},{"id":"spn-13949","text":" answer:"}]},{"id":"blk-15974","items":[{"blocks":[{"id":"blk-15976","kind":"paragraph","spans":[{"id":"spn-13950","text":"whether the chosen provider really supports the capability"}]}],"id":"blk-15975","kind":"list-item"},{"blocks":[{"id":"blk-15978","kind":"paragraph","spans":[{"id":"spn-13951","text":"whether capability combinations are semantically compatible"}]}],"id":"blk-15977","kind":"list-item"},{"blocks":[{"id":"blk-15980","kind":"paragraph","spans":[{"id":"spn-13952","text":"whether a pipeline between operations is type-safe"}]}],"id":"blk-15979","kind":"list-item"},{"blocks":[{"id":"blk-15982","kind":"paragraph","spans":[{"id":"spn-13953","text":"whether a provider can actually be launched in a target runtime"}]}],"id":"blk-15981","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-15983","kind":"paragraph","spans":[{"id":"spn-13954","text":"It only establishes that the declaration is structurally well-formed."}]},{"id":"blk-15984","kind":"heading","level":2,"spans":[{"id":"spn-13955","text":"4. Step 2: normalization and composition"}]},{"id":"blk-15985","kind":"paragraph","spans":[{"id":"spn-13956","text":"After schema validation, the runtime normalizes the capability set."}]},{"id":"blk-15986","kind":"paragraph","spans":[{"id":"spn-13957","text":"This is where the protocol’s set-like semantics matter."}]},{"id":"blk-15987","kind":"heading","level":3,"spans":[{"id":"spn-13958","text":"What normalization typically does"}]},{"id":"blk-15988","kind":"paragraph","spans":[{"id":"spn-13959","text":"A runtime may:"}]},{"id":"blk-15989","items":[{"blocks":[{"id":"blk-15991","kind":"paragraph","spans":[{"id":"spn-13960","text":"canonicalize capability keys"}]}],"id":"blk-15990","kind":"list-item"},{"blocks":[{"id":"blk-15993","kind":"paragraph","spans":[{"id":"spn-13961","text":"normalize provider binding objects"}]}],"id":"blk-15992","kind":"list-item"},{"blocks":[{"id":"blk-15995","kind":"paragraph","spans":[{"id":"spn-13962","text":"sort capabilities into a stable internal order"}]}],"id":"blk-15994","kind":"list-item"},{"blocks":[{"id":"blk-15997","kind":"paragraph","spans":[{"id":"spn-13963","text":"collapse exact duplicates"}]}],"id":"blk-15996","kind":"list-item"},{"blocks":[{"id":"blk-15999","kind":"paragraph","spans":[{"id":"spn-13964","text":"surface incompatible duplicate bindings as conflicts"}]}],"id":"blk-15998","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16000","kind":"paragraph","spans":[{"id":"spn-13965","text":"For the declaration above, the normalized internal shape may be represented like this:"}]},{"id":"blk-16001","kind":"code","language":"json","text":"{\n  \"agent\": \"infra-ops\",\n  \"version\": \"0.1.0\",\n  \"capabilities\": [\n    {\n      \"id\": \"&memory.graph\",\n      \"provider\": \"graphonomous\",\n      \"config\": {\n        \"instance\": \"infra-ops\"\n      }\n    },\n    {\n      \"id\": \"&reason.argument\",\n      \"provider\": \"deliberatic\",\n      \"config\": {\n        \"governance\": \"constitutional\"\n      }\n    },\n    {\n      \"id\": \"&space.fleet\",\n      \"provider\": \"geofleetic\",\n      \"config\": {\n        \"regions\": [\"us-east-1\", \"us-west-2\", \"eu-central-1\"]\n      }\n    },\n    {\n      \"id\": \"&time.anomaly\",\n      \"provider\": \"ticktickclock\",\n      \"config\": {\n        \"streams\": [\"cpu\", \"mem\", \"latency\"]\n      }\n    }\n  ],\n  \"governance\": {\n    \"hard\": [\n      \"do_not_recommend_destructive_action_without_human_review\"\n    ],\n    \"soft\": [\n      \"prefer_reversible_remediation\"\n    ],\n    \"escalate_when\": [\n      \"confidence_below:0.75\",\n      \"cross_region_impact=true\"\n    ]\n  },\n  \"provenance\": {\n    \"mode\": \"hash-linked\"\n  }\n}"},{"id":"blk-16002","kind":"paragraph","spans":[{"id":"spn-13966","text":"The exact representation is runtime-specific. The important point is that composition produces a "},{"id":"spn-13967","marks":["bold"],"text":"deterministic, normalized capability graph"},{"id":"spn-13968","text":"."}]},{"id":"blk-16003","kind":"heading","level":3,"spans":[{"id":"spn-13969","text":"Example CLI output"}]},{"id":"blk-16004","kind":"paragraph","spans":[{"id":"spn-13970","text":"The snippets below are illustrative of the same working commands demonstrated end-to-end in "},{"id":"spn-13971","marks":[{"kind":"link","predicate":"cites","target":"#/AmpersandBoxDesign/docs/quickstart.md"}],"text":"`quickstart.md`"},{"id":"spn-13972","text":", where actual captured JSON output is included."}]},{"id":"blk-16005","kind":"code","language":"text","text":"$ ampersand compose examples/infra-ops.ampersand.json\n✔ normalized 4 capabilities\n✔ no duplicate bindings\n✔ no provider conflicts\n✔ governance preserved\n✔ provenance mode preserved"},{"id":"blk-16006","kind":"heading","level":2,"spans":[{"id":"spn-13973","text":"5. Step 3: contract checking"}]},{"id":"blk-16007","kind":"paragraph","spans":[{"id":"spn-13974","text":"Once the declaration is normalized, the runtime can check capability contracts."}]},{"id":"blk-16008","kind":"paragraph","spans":[{"id":"spn-13975","text":"This is where the protocol moves from “well-shaped JSON” to “valid composition.”"}]},{"id":"blk-16009","kind":"paragraph","spans":[{"id":"spn-13976","text":"A runtime may verify:"}]},{"id":"blk-16010","items":[{"blocks":[{"id":"blk-16012","kind":"paragraph","spans":[{"id":"spn-13977","text":"the capability subtype exists in a known registry"}]}],"id":"blk-16011","kind":"list-item"},{"blocks":[{"id":"blk-16014","kind":"paragraph","spans":[{"id":"spn-13978","text":"the bound provider claims support for that subtype"}]}],"id":"blk-16013","kind":"list-item"},{"blocks":[{"id":"blk-16016","kind":"paragraph","spans":[{"id":"spn-13979","text":"required operations are available"}]}],"id":"blk-16015","kind":"list-item"},{"blocks":[{"id":"blk-16018","kind":"paragraph","spans":[{"id":"spn-13980","text":"declared or inferred pipelines are type-compatible"}]}],"id":"blk-16017","kind":"list-item"},{"blocks":[{"id":"blk-16020","kind":"paragraph","spans":[{"id":"spn-13981","text":"adjacency rules such as "},{"id":"spn-13982","marks":["code"],"text":"accepts_from"},{"id":"spn-13983","text":" and "},{"id":"spn-13984","marks":["code"],"text":"feeds_into"},{"id":"spn-13985","text":" are satisfied"}]}],"id":"blk-16019","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16021","kind":"heading","level":3,"spans":[{"id":"spn-13986","text":"Conceptual pipeline"}]},{"id":"blk-16022","kind":"paragraph","spans":[{"id":"spn-13987","text":"A common operational path for this agent might be:"}]},{"id":"blk-16023","kind":"code","language":"text","text":"stream_data\n|> &time.anomaly.detect()\n|> &memory.graph.enrich()\n|> &space.fleet.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-16024","kind":"paragraph","spans":[{"id":"spn-13988","text":"Important: "},{"id":"spn-13989","marks":["code"],"text":"|>"},{"id":"spn-13990","text":" is used in the docs as a "},{"id":"spn-13991","marks":["bold"],"text":"conceptual pipeline notation"},{"id":"spn-13992","text":". It expresses ordered flow between capability operations. It is not, by itself, a required wire format for the protocol and it is not required to be literal CLI syntax."}]},{"id":"blk-16025","kind":"heading","level":3,"spans":[{"id":"spn-13993","text":"What the runtime checks"}]},{"id":"blk-16026","kind":"paragraph","spans":[{"id":"spn-13994","text":"For that pipeline, the runtime asks:"}]},{"id":"blk-16027","items":[{"blocks":[{"id":"blk-16029","kind":"paragraph","spans":[{"id":"spn-13995","text":"does "},{"id":"spn-13996","marks":["code"],"text":"&time.anomaly"},{"id":"spn-13997","text":" support "},{"id":"spn-13998","marks":["code"],"text":"detect"}]}],"id":"blk-16028","kind":"list-item"},{"blocks":[{"id":"blk-16031","kind":"paragraph","spans":[{"id":"spn-13999","text":"does "},{"id":"spn-14000","marks":["code"],"text":"detect"},{"id":"spn-14001","text":" emit a type that "},{"id":"spn-14002","marks":["code"],"text":"&memory.graph.enrich"},{"id":"spn-14003","text":" accepts"}]}],"id":"blk-16030","kind":"list-item"},{"blocks":[{"id":"blk-16033","kind":"paragraph","spans":[{"id":"spn-14004","text":"does "},{"id":"spn-14005","marks":["code"],"text":"&memory.graph.enrich"},{"id":"spn-14006","text":" emit a type that "},{"id":"spn-14007","marks":["code"],"text":"&space.fleet.enrich"},{"id":"spn-14008","text":" accepts"}]}],"id":"blk-16032","kind":"list-item"},{"blocks":[{"id":"blk-16035","kind":"paragraph","spans":[{"id":"spn-14009","text":"does "},{"id":"spn-14010","marks":["code"],"text":"&space.fleet.enrich"},{"id":"spn-14011","text":" emit a type that "},{"id":"spn-14012","marks":["code"],"text":"&reason.argument.evaluate"},{"id":"spn-14013","text":" accepts"}]}],"id":"blk-16034","kind":"list-item"},{"blocks":[{"id":"blk-16037","kind":"paragraph","spans":[{"id":"spn-14014","text":"do the adjacency rules permit each transition"}]}],"id":"blk-16036","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-16038","kind":"heading","level":3,"spans":[{"id":"spn-14015","text":"Example success output"}]},{"id":"blk-16039","kind":"code","language":"text","text":"$ ampersand check examples/infra-ops.ampersand.json --pipeline infra_ops\n✔ capability contracts loaded\n✔ provider support metadata loaded\n✔ &time.anomaly.detect -> &memory.graph.enrich valid\n✔ &memory.graph.enrich -> &space.fleet.enrich valid\n✔ &space.fleet.enrich -> &reason.argument.evaluate valid\n✔ pipeline infra_ops is contract-safe"},{"id":"blk-16040","kind":"paragraph","spans":[{"id":"spn-14016","text":"At this point the runtime knows that the declaration is not only valid in shape, but also meaningful as a composed system."}]},{"id":"blk-16041","kind":"heading","level":2,"spans":[{"id":"spn-14017","text":"6. Step 4: provider resolution"}]},{"id":"blk-16042","kind":"paragraph","spans":[{"id":"spn-14018","text":"Provider resolution answers:"}]},{"blocks":[{"id":"blk-16044","kind":"paragraph","spans":[{"id":"spn-14019","text":"Which implementation actually satisfies each declared capability?"}]}],"id":"blk-16043","kind":"quote"},{"id":"blk-16045","kind":"paragraph","spans":[{"id":"spn-14020","text":"There are two common cases."}]},{"id":"blk-16046","kind":"heading","level":3,"spans":[{"id":"spn-14021","text":"Explicit provider binding"}]},{"id":"blk-16047","kind":"paragraph","spans":[{"id":"spn-14022","text":"In the example declaration, every capability names a provider directly:"}]},{"id":"blk-16048","items":[{"blocks":[{"id":"blk-16050","kind":"paragraph","spans":[{"id":"spn-14023","marks":["code"],"text":"&memory.graph"},{"id":"spn-14024","text":" → "},{"id":"spn-14025","marks":["code"],"text":"graphonomous"}]}],"id":"blk-16049","kind":"list-item"},{"blocks":[{"id":"blk-16052","kind":"paragraph","spans":[{"id":"spn-14026","marks":["code"],"text":"&time.anomaly"},{"id":"spn-14027","text":" → "},{"id":"spn-14028","marks":["code"],"text":"ticktickclock"}]}],"id":"blk-16051","kind":"list-item"},{"blocks":[{"id":"blk-16054","kind":"paragraph","spans":[{"id":"spn-14029","marks":["code"],"text":"&space.fleet"},{"id":"spn-14030","text":" → "},{"id":"spn-14031","marks":["code"],"text":"geofleetic"}]}],"id":"blk-16053","kind":"list-item"},{"blocks":[{"id":"blk-16056","kind":"paragraph","spans":[{"id":"spn-14032","marks":["code"],"text":"&reason.argument"},{"id":"spn-14033","text":" → "},{"id":"spn-14034","marks":["code"],"text":"deliberatic"}]}],"id":"blk-16055","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16057","kind":"paragraph","spans":[{"id":"spn-14035","text":"In that case, resolution is mostly verification:"}]},{"id":"blk-16058","items":[{"blocks":[{"id":"blk-16060","kind":"paragraph","spans":[{"id":"spn-14036","text":"is the provider known"}]}],"id":"blk-16059","kind":"list-item"},{"blocks":[{"id":"blk-16062","kind":"paragraph","spans":[{"id":"spn-14037","text":"does the provider advertise support for this subtype"}]}],"id":"blk-16061","kind":"list-item"},{"blocks":[{"id":"blk-16064","kind":"paragraph","spans":[{"id":"spn-14038","text":"are launch details or integration details available"}]}],"id":"blk-16063","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16065","kind":"heading","level":3,"spans":[{"id":"spn-14039","text":"Automatic provider resolution"}]},{"id":"blk-16066","kind":"paragraph","spans":[{"id":"spn-14040","text":"If a declaration uses "},{"id":"spn-14041","marks":["code"],"text":"provider: \"auto\""},{"id":"spn-14042","text":", a runtime would consult a registry and select a provider that satisfies the requested capability and constraints."}]},{"id":"blk-16067","kind":"paragraph","spans":[{"id":"spn-14043","text":"For example:"}]},{"id":"blk-16068","kind":"code","language":"json","text":"{\n  \"&memory.graph\": {\n    \"provider\": \"auto\",\n    \"need\": \"relationship-aware incident recall\"\n  }\n}"},{"id":"blk-16069","kind":"paragraph","spans":[{"id":"spn-14044","text":"A runtime might then produce:"}]},{"id":"blk-16070","kind":"code","language":"text","text":"$ ampersand resolve examples/infra-ops-auto.ampersand.json\n✔ found 2 candidate providers for &memory.graph\n✔ selected graphonomous\n  reason: supports &memory.graph, mcp_v1 transport metadata present, graph recall operations available"},{"id":"blk-16071","kind":"heading","level":3,"spans":[{"id":"spn-14045","text":"About provider names in the docs"}]},{"id":"blk-16072","kind":"paragraph","spans":[{"id":"spn-14046","text":"Provider names such as "},{"id":"spn-14047","marks":["code"],"text":"graphonomous"},{"id":"spn-14048","text":", "},{"id":"spn-14049","marks":["code"],"text":"deliberatic"},{"id":"spn-14050","text":", "},{"id":"spn-14051","marks":["code"],"text":"ticktickclock"},{"id":"spn-14052","text":", and "},{"id":"spn-14053","marks":["code"],"text":"geofleetic"},{"id":"spn-14054","text":" are used throughout this documentation as "},{"id":"spn-14055","marks":["bold"],"text":"illustrative example providers unless explicitly stated otherwise"},{"id":"spn-14056","text":"."}]},{"id":"blk-16073","kind":"paragraph","spans":[{"id":"spn-14057","text":"Their purpose is to make capability/provider separation concrete in examples. They should not be read as a guarantee that those providers currently exist as public implementations."}]},{"id":"blk-16074","kind":"heading","level":2,"spans":[{"id":"spn-14058","text":"7. Step 5: generation into downstream artifacts"}]},{"id":"blk-16075","kind":"paragraph","spans":[{"id":"spn-14059","text":"After validation, composition, and provider resolution, the runtime can compile the declaration into downstream artifacts."}]},{"id":"blk-16076","kind":"paragraph","spans":[{"id":"spn-14060","text":"This is where the protocol becomes operational."}]},{"id":"blk-16077","kind":"heading","level":2,"spans":[{"id":"spn-14061","text":"7.1 MCP generation"}]},{"id":"blk-16078","kind":"paragraph","spans":[{"id":"spn-14062","text":"A generator may emit an MCP-oriented configuration that groups capability bindings by provider and preserves enough provider information for a tool-facing runtime."}]},{"id":"blk-16079","kind":"paragraph","spans":[{"id":"spn-14063","text":"An illustrative generated artifact might look like this:"}]},{"id":"blk-16080","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"transport\": \"stdio\",\n      \"command\": \"graphonomous-mcp\",\n      \"args\": [\"serve\", \"--instance\", \"infra-ops\"]\n    },\n    \"ticktickclock\": {\n      \"transport\": \"stdio\",\n      \"command\": \"ticktickclock-mcp\",\n      \"args\": [\"serve\", \"--streams\", \"cpu,mem,latency\"]\n    },\n    \"geofleetic\": {\n      \"transport\": \"stdio\",\n      \"command\": \"geofleetic-mcp\",\n      \"args\": [\"serve\", \"--regions\", \"us-east-1,us-west-2,eu-central-1\"]\n    },\n    \"deliberatic\": {\n      \"transport\": \"stdio\",\n      \"command\": \"deliberatic-mcp\",\n      \"args\": [\"serve\", \"--governance\", \"constitutional\"]\n    }\n  }\n}"},{"id":"blk-16081","kind":"paragraph","spans":[{"id":"spn-14064","text":"A CLI could report:"}]},{"id":"blk-16082","kind":"code","language":"text","text":"$ ampersand generate mcp examples/infra-ops.ampersand.json -o build/mcp.json\n✔ generated MCP configuration\n✔ 4 provider entries emitted\n✔ unresolved providers: 0"},{"id":"blk-16083","kind":"heading","level":3,"spans":[{"id":"spn-14065","text":"Important constraint"}]},{"id":"blk-16084","kind":"paragraph","spans":[{"id":"spn-14066","text":"A generator should only emit details that are actually known from the runtime or registry metadata. If launch details are unknown, the artifact should preserve that explicitly instead of inventing them."}]},{"id":"blk-16085","kind":"paragraph","spans":[{"id":"spn-14067","text":"For example:"}]},{"id":"blk-16086","kind":"code","language":"json","text":"{\n  \"mcpServers\": {\n    \"graphonomous\": {\n      \"transport\": \"unknown\",\n      \"status\": \"unresolved-launch-details\"\n    }\n  }\n}"},{"id":"blk-16087","kind":"heading","level":2,"spans":[{"id":"spn-14068","text":"7.2 A2A generation"}]},{"id":"blk-16088","kind":"paragraph","spans":[{"id":"spn-14069","text":"A generator may also emit an A2A-style coordination artifact or agent card."}]},{"id":"blk-16089","kind":"paragraph","spans":[{"id":"spn-14070","text":"An illustrative output could look like this:"}]},{"id":"blk-16090","kind":"code","language":"json","text":"{\n  \"agent\": {\n    \"id\": \"infra-ops\",\n    \"version\": \"0.1.0\",\n    \"skills\": [\n      \"memory.graph.recall\",\n      \"memory.graph.enrich\",\n      \"time.anomaly.detect\",\n      \"space.fleet.enrich\",\n      \"reason.argument.evaluate\"\n    ],\n    \"capabilities\": [\n      \"&memory.graph\",\n      \"&time.anomaly\",\n      \"&space.fleet\",\n      \"&reason.argument\"\n    ],\n    \"governance\": {\n      \"hard\": [\n        \"do_not_recommend_destructive_action_without_human_review\"\n      ],\n      \"soft\": [\n        \"prefer_reversible_remediation\"\n      ],\n      \"escalate_when\": [\n        \"confidence_below:0.75\",\n        \"cross_region_impact=true\"\n      ]\n    },\n    \"provenance\": {\n      \"mode\": \"hash-linked\"\n    }\n  }\n}"},{"id":"blk-16091","kind":"paragraph","spans":[{"id":"spn-14071","text":"And the CLI might show:"}]},{"id":"blk-16092","kind":"code","language":"text","text":"$ ampersand generate a2a examples/infra-ops.ampersand.json -o build/agent-card.json\n✔ generated A2A artifact\n✔ 5 skills published\n✔ governance metadata preserved\n✔ provenance metadata preserved"},{"id":"blk-16093","kind":"heading","level":2,"spans":[{"id":"spn-14072","text":"8. Step 6: runtime execution and provenance emission"}]},{"id":"blk-16094","kind":"paragraph","spans":[{"id":"spn-14073","text":"The protocol compiles declarations into downstream artifacts, but provenance becomes visible during execution."}]},{"id":"blk-16095","kind":"paragraph","spans":[{"id":"spn-14074","text":"Suppose telemetry enters the system and the runtime executes the conceptual pipeline:"}]},{"id":"blk-16096","kind":"code","language":"text","text":"stream_data\n|> &time.anomaly.detect()\n|> &memory.graph.enrich()\n|> &space.fleet.enrich()\n|> &reason.argument.evaluate()"},{"id":"blk-16097","kind":"paragraph","spans":[{"id":"spn-14075","text":"A provenance-aware runtime may emit records like:"}]},{"id":"blk-16098","kind":"code","language":"json","text":"[\n  {\n    \"source\": \"&time.anomaly\",\n    \"provider\": \"ticktickclock\",\n    \"operation\": \"detect\",\n    \"timestamp\": \"2026-03-14T14:23:07Z\",\n    \"input_hash\": \"sha256:1111aaaa\",\n    \"output_hash\": \"sha256:2222bbbb\",\n    \"parent_hash\": null\n  },\n  {\n    \"source\": \"&memory.graph\",\n    \"provider\": \"graphonomous\",\n    \"operation\": \"enrich\",\n    \"timestamp\": \"2026-03-14T14:23:08Z\",\n    \"input_hash\": \"sha256:2222bbbb\",\n    \"output_hash\": \"sha256:3333cccc\",\n    \"parent_hash\": \"sha256:2222bbbb\"\n  },\n  {\n    \"source\": \"&space.fleet\",\n    \"provider\": \"geofleetic\",\n    \"operation\": \"enrich\",\n    \"timestamp\": \"2026-03-14T14:23:09Z\",\n    \"input_hash\": \"sha256:3333cccc\",\n    \"output_hash\": \"sha256:4444dddd\",\n    \"parent_hash\": \"sha256:3333cccc\"\n  },\n  {\n    \"source\": \"&reason.argument\",\n    \"provider\": \"deliberatic\",\n    \"operation\": \"evaluate\",\n    \"timestamp\": \"2026-03-14T14:23:10Z\",\n    \"input_hash\": \"sha256:4444dddd\",\n    \"output_hash\": \"sha256:5555eeee\",\n    \"parent_hash\": \"sha256:4444dddd\"\n  }\n]"},{"id":"blk-16099","kind":"paragraph","spans":[{"id":"spn-14076","text":"This is why provenance is treated as a protocol concern rather than as optional logging."}]},{"id":"blk-16100","kind":"paragraph","spans":[{"id":"spn-14077","text":"The declaration asked for provenance preservation. The runtime is now honoring that requirement at execution time."}]},{"id":"blk-16101","kind":"heading","level":2,"spans":[{"id":"spn-14078","text":"9. What failure looks like"}]},{"id":"blk-16102","kind":"paragraph","spans":[{"id":"spn-14079","text":"A useful walkthrough needs at least one failing example."}]},{"id":"blk-16103","kind":"paragraph","spans":[{"id":"spn-14080","text":"Consider this invalid pipeline:"}]},{"id":"blk-16104","kind":"code","language":"text","text":"stream_data\n|> &time.anomaly.detect()\n|> &reason.argument.evaluate()\n|> &memory.graph.enrich()"},{"id":"blk-16105","kind":"paragraph","spans":[{"id":"spn-14081","text":"Assume:"}]},{"id":"blk-16106","items":[{"blocks":[{"id":"blk-16108","kind":"paragraph","spans":[{"id":"spn-14082","marks":["code"],"text":"&time.anomaly.detect"},{"id":"spn-14083","text":" outputs "},{"id":"spn-14084","marks":["code"],"text":"anomaly_event"}]}],"id":"blk-16107","kind":"list-item"},{"blocks":[{"id":"blk-16110","kind":"paragraph","spans":[{"id":"spn-14085","marks":["code"],"text":"&reason.argument.evaluate"},{"id":"spn-14086","text":" outputs "},{"id":"spn-14087","marks":["code"],"text":"decision_record"}]}],"id":"blk-16109","kind":"list-item"},{"blocks":[{"id":"blk-16112","kind":"paragraph","spans":[{"id":"spn-14088","marks":["code"],"text":"&memory.graph.enrich"},{"id":"spn-14089","text":" expects "},{"id":"spn-14090","marks":["code"],"text":"incident_context"},{"id":"spn-14091","text":" or "},{"id":"spn-14092","marks":["code"],"text":"memory_context"}]}],"id":"blk-16111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16113","kind":"paragraph","spans":[{"id":"spn-14093","text":"The transition from "},{"id":"spn-14094","marks":["code"],"text":"&reason.argument.evaluate"},{"id":"spn-14095","text":" to "},{"id":"spn-14096","marks":["code"],"text":"&memory.graph.enrich"},{"id":"spn-14097","text":" may then be invalid."}]},{"id":"blk-16114","kind":"heading","level":3,"spans":[{"id":"spn-14098","text":"Example failure output"}]},{"id":"blk-16115","kind":"code","language":"text","text":"$ ampersand check examples/infra-ops-bad.ampersand.json --pipeline infra_ops_bad\n✔ capability contracts loaded\n✔ &time.anomaly.detect -> &reason.argument.evaluate valid\n✖ &reason.argument.evaluate -> &memory.graph.enrich invalid\n\nreason:\n  output type \"decision_record\" is not accepted by &memory.graph.enrich\n  allowed input types: [\"incident_context\", \"memory_context\"]\n\nexit status: 1"},{"id":"blk-16116","kind":"paragraph","spans":[{"id":"spn-14099","text":"That kind of failure is exactly why the composition layer exists. The protocol allows the runtime to reject bad compositions before they become runtime bugs."}]},{"id":"blk-16117","kind":"heading","level":2,"spans":[{"id":"spn-14100","text":"10. What governance does during runtime processing"}]},{"id":"blk-16118","kind":"paragraph","spans":[{"id":"spn-14101","text":"Governance is declared early, but it influences more than one stage."}]},{"id":"blk-16119","kind":"heading","level":3,"spans":[{"id":"spn-14102","text":"During validation"}]},{"id":"blk-16120","kind":"paragraph","spans":[{"id":"spn-14103","text":"The runtime checks that governance fields are well-formed."}]},{"id":"blk-16121","kind":"heading","level":3,"spans":[{"id":"spn-14104","text":"During generation"}]},{"id":"blk-16122","kind":"paragraph","spans":[{"id":"spn-14105","text":"The runtime preserves governance metadata in generated artifacts so that downstream systems know what constraints travel with the agent."}]},{"id":"blk-16123","kind":"heading","level":3,"spans":[{"id":"spn-14106","text":"During execution"}]},{"id":"blk-16124","kind":"paragraph","spans":[{"id":"spn-14107","text":"The runtime or provider may enforce the declared constraints."}]},{"id":"blk-16125","kind":"paragraph","spans":[{"id":"spn-14108","text":"For the example declaration, a decision flow might produce:"}]},{"id":"blk-16126","kind":"code","language":"text","text":"$ ampersnad run examples/infra-ops.ampersand.json --input sample-event.json\n…\n! escalation triggered\n  reason: cross_region_impact=true\n  action: require_human_review"},{"id":"blk-16127","kind":"paragraph","spans":[{"id":"spn-14109","text":"The protocol does not require one universal enforcement engine. It requires governance intent to be "},{"id":"spn-14110","marks":["bold"],"text":"declared portably"},{"id":"spn-14111","text":" so runtimes can preserve and apply it consistently."}]},{"id":"blk-16128","kind":"heading","level":2,"spans":[{"id":"spn-14112","text":"11. Reference lifecycle summary"}]},{"id":"blk-16129","kind":"paragraph","spans":[{"id":"spn-14113","text":"A compliant implementation should be understandable in terms of the following lifecycle:"}]},{"id":"blk-16130","kind":"heading","level":3,"spans":[{"id":"spn-14114","text":"Phase A: parse and validate"}]},{"id":"blk-16131","items":[{"blocks":[{"id":"blk-16133","kind":"paragraph","spans":[{"id":"spn-14115","text":"read "},{"id":"spn-14116","marks":["code"],"text":"ampersand.json"}]}],"id":"blk-16132","kind":"list-item"},{"blocks":[{"id":"blk-16135","kind":"paragraph","spans":[{"id":"spn-14117","text":"validate against the declaration schema"}]}],"id":"blk-16134","kind":"list-item"},{"blocks":[{"id":"blk-16137","kind":"paragraph","spans":[{"id":"spn-14118","text":"reject malformed declarations"}]}],"id":"blk-16136","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16138","kind":"heading","level":3,"spans":[{"id":"spn-14119","text":"Phase B: normalize and compose"}]},{"id":"blk-16139","items":[{"blocks":[{"id":"blk-16141","kind":"paragraph","spans":[{"id":"spn-14120","text":"canonicalize capability bindings"}]}],"id":"blk-16140","kind":"list-item"},{"blocks":[{"id":"blk-16143","kind":"paragraph","spans":[{"id":"spn-14121","text":"collapse exact duplicates"}]}],"id":"blk-16142","kind":"list-item"},{"blocks":[{"id":"blk-16145","kind":"paragraph","spans":[{"id":"spn-14122","text":"surface conflicts explicitly"}]}],"id":"blk-16144","kind":"list-item"},{"blocks":[{"id":"blk-16147","kind":"paragraph","spans":[{"id":"spn-14123","text":"preserve governance and provenance metadata"}]}],"id":"blk-16146","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16148","kind":"heading","level":3,"spans":[{"id":"spn-14124","text":"Phase C: check semantics"}]},{"id":"blk-16149","items":[{"blocks":[{"id":"blk-16151","kind":"paragraph","spans":[{"id":"spn-14125","text":"load contracts"}]}],"id":"blk-16150","kind":"list-item"},{"blocks":[{"id":"blk-16153","kind":"paragraph","spans":[{"id":"spn-14126","text":"load registry or provider support metadata"}]}],"id":"blk-16152","kind":"list-item"},{"blocks":[{"id":"blk-16155","kind":"paragraph","spans":[{"id":"spn-14127","text":"verify subtype support"}]}],"id":"blk-16154","kind":"list-item"},{"blocks":[{"id":"blk-16157","kind":"paragraph","spans":[{"id":"spn-14128","text":"verify pipeline compatibility when applicable"}]}],"id":"blk-16156","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16158","kind":"heading","level":3,"spans":[{"id":"spn-14129","text":"Phase D: resolve providers"}]},{"id":"blk-16159","items":[{"blocks":[{"id":"blk-16161","kind":"paragraph","spans":[{"id":"spn-14130","text":"confirm explicit providers"}]}],"id":"blk-16160","kind":"list-item"},{"blocks":[{"id":"blk-16163","kind":"paragraph","spans":[{"id":"spn-14131","text":"or select providers for "},{"id":"spn-14132","marks":["code"],"text":"provider: \"auto\""}]}],"id":"blk-16162","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16164","kind":"heading","level":3,"spans":[{"id":"spn-14133","text":"Phase E: generate artifacts"}]},{"id":"blk-16165","items":[{"blocks":[{"id":"blk-16167","kind":"paragraph","spans":[{"id":"spn-14134","text":"emit MCP configuration"}]}],"id":"blk-16166","kind":"list-item"},{"blocks":[{"id":"blk-16169","kind":"paragraph","spans":[{"id":"spn-14135","text":"emit A2A coordination artifacts"}]}],"id":"blk-16168","kind":"list-item"},{"blocks":[{"id":"blk-16171","kind":"paragraph","spans":[{"id":"spn-14136","text":"preserve unresolved details explicitly when they are unknown"}]}],"id":"blk-16170","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16172","kind":"heading","level":3,"spans":[{"id":"spn-14137","text":"Phase F: execute with lineage"}]},{"id":"blk-16173","items":[{"blocks":[{"id":"blk-16175","kind":"paragraph","spans":[{"id":"spn-14138","text":"run capability operations in the target runtime"}]}],"id":"blk-16174","kind":"list-item"},{"blocks":[{"id":"blk-16177","kind":"paragraph","spans":[{"id":"spn-14139","text":"emit provenance records according to the declaration"}]}],"id":"blk-16176","kind":"list-item"},{"blocks":[{"id":"blk-16179","kind":"paragraph","spans":[{"id":"spn-14140","text":"enforce or surface governance constraints"}]}],"id":"blk-16178","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16180","kind":"heading","level":2,"spans":[{"id":"spn-14141","text":"12. What is normative and what is illustrative"}]},{"id":"blk-16181","kind":"paragraph","spans":[{"id":"spn-14142","text":"This page includes both protocol expectations and implementation examples."}]},{"id":"blk-16182","kind":"heading","level":3,"spans":[{"id":"spn-14143","text":"Normative at the protocol level"}]},{"id":"blk-16183","kind":"paragraph","spans":[{"id":"spn-14144","text":"These ideas are central to the protocol model:"}]},{"id":"blk-16184","items":[{"blocks":[{"id":"blk-16186","kind":"paragraph","spans":[{"id":"spn-14145","text":"declarations are validated before generation"}]}],"id":"blk-16185","kind":"list-item"},{"blocks":[{"id":"blk-16188","kind":"paragraph","spans":[{"id":"spn-14146","text":"capability composition is distinct from execution"}]}],"id":"blk-16187","kind":"list-item"},{"blocks":[{"id":"blk-16190","kind":"paragraph","spans":[{"id":"spn-14147","text":"provider identity is separate from capability identity"}]}],"id":"blk-16189","kind":"list-item"},{"blocks":[{"id":"blk-16192","kind":"paragraph","spans":[{"id":"spn-14148","text":"contracts make composition checkable"}]}],"id":"blk-16191","kind":"list-item"},{"blocks":[{"id":"blk-16194","kind":"paragraph","spans":[{"id":"spn-14149","text":"governance and provenance travel with the declaration"}]}],"id":"blk-16193","kind":"list-item"},{"blocks":[{"id":"blk-16196","kind":"paragraph","spans":[{"id":"spn-14150","text":"downstream artifacts can be generated from a validated declaration"}]}],"id":"blk-16195","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16197","kind":"heading","level":3,"spans":[{"id":"spn-14151","text":"Illustrative in this page"}]},{"id":"blk-16198","kind":"paragraph","spans":[{"id":"spn-14152","text":"These details are examples rather than mandatory:"}]},{"id":"blk-16199","items":[{"blocks":[{"id":"blk-16201","kind":"paragraph","spans":[{"id":"spn-14153","text":"the exact CLI command names"}]}],"id":"blk-16200","kind":"list-item"},{"blocks":[{"id":"blk-16203","kind":"paragraph","spans":[{"id":"spn-14154","text":"the exact terminal output format"}]}],"id":"blk-16202","kind":"list-item"},{"blocks":[{"id":"blk-16205","kind":"paragraph","spans":[{"id":"spn-14155","text":"the internal normalized JSON shape"}]}],"id":"blk-16204","kind":"list-item"},{"blocks":[{"id":"blk-16207","kind":"paragraph","spans":[{"id":"spn-14156","text":"the specific provider names used in examples"}]}],"id":"blk-16206","kind":"list-item"},{"blocks":[{"id":"blk-16209","kind":"paragraph","spans":[{"id":"spn-14157","text":"the exact generated MCP command lines"}]}],"id":"blk-16208","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16210","kind":"paragraph","spans":[{"id":"spn-14158","text":"That distinction matters. The protocol defines the lifecycle and artifact roles, not one single implementation UX."}]},{"id":"blk-16211","kind":"heading","level":2,"spans":[{"id":"spn-14159","text":"13. Why this walkthrough matters"}]},{"id":"blk-16212","kind":"paragraph","spans":[{"id":"spn-14160","text":"The most important idea in the protocol is not just that an agent can "},{"id":"spn-14161","marks":["italic"],"text":"declare"},{"id":"spn-14162","text":" capabilities."}]},{"id":"blk-16213","kind":"paragraph","spans":[{"id":"spn-14163","text":"It is that a declaration can be:"}]},{"id":"blk-16214","items":[{"blocks":[{"id":"blk-16216","kind":"paragraph","spans":[{"id":"spn-14164","text":"validated"}]}],"id":"blk-16215","kind":"list-item"},{"blocks":[{"id":"blk-16218","kind":"paragraph","spans":[{"id":"spn-14165","text":"normalized"}]}],"id":"blk-16217","kind":"list-item"},{"blocks":[{"id":"blk-16220","kind":"paragraph","spans":[{"id":"spn-14166","text":"checked"}]}],"id":"blk-16219","kind":"list-item"},{"blocks":[{"id":"blk-16222","kind":"paragraph","spans":[{"id":"spn-14167","text":"resolved"}]}],"id":"blk-16221","kind":"list-item"},{"blocks":[{"id":"blk-16224","kind":"paragraph","spans":[{"id":"spn-14168","text":"compiled"}]}],"id":"blk-16223","kind":"list-item"},{"blocks":[{"id":"blk-16226","kind":"paragraph","spans":[{"id":"spn-14169","text":"executed with lineage preserved"}]}],"id":"blk-16225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-16227","kind":"paragraph","spans":[{"id":"spn-14170","text":"Without that lifecycle, "},{"id":"spn-14171","marks":["code"],"text":"ampersand.json"},{"id":"spn-14172","text":" would be only documentation. With that lifecycle, it becomes an operational source of truth for agent composition."}]},{"id":"blk-16228","kind":"heading","level":2,"spans":[{"id":"spn-14173","text":"14. Short summary"}]},{"id":"blk-16229","kind":"paragraph","spans":[{"id":"spn-14174","text":"A runtime processing the [&] Protocol should be understandable as:"}]},{"id":"blk-16230","items":[{"blocks":[{"id":"blk-16232","kind":"paragraph","spans":[{"id":"spn-14175","marks":["bold"],"text":"validate the declaration"}]}],"id":"blk-16231","kind":"list-item"},{"blocks":[{"id":"blk-16234","kind":"paragraph","spans":[{"id":"spn-14176","marks":["bold"],"text":"normalize the capability set"}]}],"id":"blk-16233","kind":"list-item"},{"blocks":[{"id":"blk-16236","kind":"paragraph","spans":[{"id":"spn-14177","marks":["bold"],"text":"check contracts and pipeline compatibility"}]}],"id":"blk-16235","kind":"list-item"},{"blocks":[{"id":"blk-16238","kind":"paragraph","spans":[{"id":"spn-14178","marks":["bold"],"text":"resolve providers"}]}],"id":"blk-16237","kind":"list-item"},{"blocks":[{"id":"blk-16240","kind":"paragraph","spans":[{"id":"spn-14179","marks":["bold"],"text":"generate MCP and A2A artifacts"}]}],"id":"blk-16239","kind":"list-item"},{"blocks":[{"id":"blk-16242","kind":"paragraph","spans":[{"id":"spn-14180","marks":["bold"],"text":"emit provenance and apply governance during execution"}]}],"id":"blk-16241","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-16243","kind":"paragraph","spans":[{"id":"spn-14181","text":"That is how the protocol moves from architecture description to runtime behavior."}]}],"edges":[],"id":"bagaaieratq6vltd5krsdtgjcbk5hfdq3xpo6y7nj6t3phm5cb4ichlijrtma","vocabulary":"ampersand.docs.fs.v1"}