{"bendscript":"0.1","blocks":[{"id":"blk-67178","kind":"heading","level":1,"spans":[{"id":"spn-97726","text":"Topology and Deliberation"}]},{"id":"blk-67179","kind":"paragraph","spans":[{"id":"spn-97727","text":"Detect and reason through circular dependencies (cycles) in knowledge."}]},{"id":"blk-67180","kind":"heading","level":2,"spans":[{"id":"spn-97728","text":"Key Concepts"}]},{"id":"blk-67181","kind":"paragraph","spans":[{"id":"spn-97729","marks":["bold"],"text":"kappa"},{"id":"spn-97730","text":" is the cycle-complexity invariant — it measures how entangled the knowledge is:"}]},{"id":"blk-67182","items":[{"blocks":[{"id":"blk-67184","kind":"paragraph","spans":[{"id":"spn-97731","marks":["bold"],"text":"kappa = 0"},{"id":"spn-97732","text":" — acyclic DAG, no cycles. Safe for fast retrieval."}]}],"id":"blk-67183","kind":"list-item"},{"blocks":[{"id":"blk-67186","kind":"paragraph","spans":[{"id":"spn-97733","marks":["bold"],"text":"kappa = 1"},{"id":"spn-97734","text":" — simple cycle (A->B->C->A). Deliberation may help for high-stakes decisions."}]}],"id":"blk-67185","kind":"list-item"},{"blocks":[{"id":"blk-67188","kind":"paragraph","spans":[{"id":"spn-97735","marks":["bold"],"text":"kappa = 2+"},{"id":"spn-97736","text":" — nested/overlapping cycles. Deliberation strongly recommended."}]}],"id":"blk-67187","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67189","kind":"paragraph","spans":[{"id":"spn-97737","marks":["bold"],"text":"SCCs (Strongly Connected Components)"},{"id":"spn-97738","text":" are maximal cyclic clusters — groups of nodes where every node can reach every other node through directed edges."}]},{"id":"blk-67190","kind":"paragraph","spans":[{"id":"spn-97739","marks":["bold"],"text":"Fault-line edges"},{"id":"spn-97740","text":" are the weakest links in a cycle — the assumptions most likely to be wrong. Examining these first is the fastest path to resolving contradictions."}]},{"id":"blk-67191","kind":"heading","level":2,"spans":[{"id":"spn-97741","text":"Arguments"}]},{"id":"blk-67192","kind":"paragraph","spans":[{"id":"spn-97742","text":"Question to deliberate: $ARGUMENTS"}]},{"id":"blk-67193","kind":"heading","level":2,"spans":[{"id":"spn-97743","text":"Analyze Topology"}]},{"id":"blk-67194","kind":"paragraph","spans":[{"id":"spn-97744","text":"Read-only diagnostic — understand the structure:"}]},{"id":"blk-67195","kind":"code","language":"text","text":"route(action: \"topology\", query: \"<topic>\")"},{"id":"blk-67196","kind":"paragraph","spans":[{"id":"spn-97745","marks":["bold"],"text":"Parameters:"}]},{"id":"blk-67197","items":[{"blocks":[{"id":"blk-67199","kind":"paragraph","spans":[{"id":"spn-97746","marks":["code"],"text":"node_ids"},{"id":"spn-97747","text":" (optional) — explicit array of node IDs to analyze"}]}],"id":"blk-67198","kind":"list-item"},{"blocks":[{"id":"blk-67201","kind":"paragraph","spans":[{"id":"spn-97748","marks":["code"],"text":"query"},{"id":"spn-97749","text":" (optional) — retrieve nodes by query, then analyze"}]}],"id":"blk-67200","kind":"list-item"},{"blocks":[{"id":"blk-67203","kind":"paragraph","spans":[{"id":"spn-97750","text":"Neither — analyzes full graph"}]}],"id":"blk-67202","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67204","kind":"paragraph","spans":[{"id":"spn-97751","text":"If both "},{"id":"spn-97752","marks":["code"],"text":"node_ids"},{"id":"spn-97753","text":" and "},{"id":"spn-97754","marks":["code"],"text":"query"},{"id":"spn-97755","text":" are provided, "},{"id":"spn-97756","marks":["code"],"text":"node_ids"},{"id":"spn-97757","text":" takes precedence."}]},{"id":"blk-67205","kind":"paragraph","spans":[{"id":"spn-97758","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-67206","items":[{"blocks":[{"id":"blk-67208","kind":"paragraph","spans":[{"id":"spn-97759","marks":["code"],"text":"routing"},{"id":"spn-97760","text":" — "},{"id":"spn-97761","marks":["code"],"text":"\"fast\""},{"id":"spn-97762","text":" or "},{"id":"spn-97763","marks":["code"],"text":"\"deliberate\""}]}],"id":"blk-67207","kind":"list-item"},{"blocks":[{"id":"blk-67210","kind":"paragraph","spans":[{"id":"spn-97764","marks":["code"],"text":"max_kappa"},{"id":"spn-97765","text":" — highest kappa value found"}]}],"id":"blk-67209","kind":"list-item"},{"blocks":[{"id":"blk-67212","kind":"paragraph","spans":[{"id":"spn-97766","marks":["code"],"text":"sccs"},{"id":"spn-97767","text":" — array of strongly connected components, each with its own "},{"id":"spn-97768","marks":["code"],"text":"routing"},{"id":"spn-97769","text":" and "},{"id":"spn-97770","marks":["code"],"text":"kappa"}]}],"id":"blk-67211","kind":"list-item"},{"blocks":[{"id":"blk-67214","kind":"paragraph","spans":[{"id":"spn-97771","marks":["code"],"text":"fault_line_edges"},{"id":"spn-97772","text":" — weakest edges in cycles (examine these first)"}]}],"id":"blk-67213","kind":"list-item"},{"blocks":[{"id":"blk-67216","kind":"paragraph","spans":[{"id":"spn-97773","marks":["code"],"text":"deliberation_budget"},{"id":"spn-97774","text":" — "},{"id":"spn-97775","marks":["code"],"text":"max_iterations"},{"id":"spn-97776","text":" and "},{"id":"spn-97777","marks":["code"],"text":"focus_edges"},{"id":"spn-97778","text":" to guide deliberation effort"}]}],"id":"blk-67215","kind":"list-item"},{"blocks":[{"id":"blk-67218","kind":"paragraph","spans":[{"id":"spn-97779","marks":["code"],"text":"recommendation"},{"id":"spn-97780","text":" — human-readable guidance"}]}],"id":"blk-67217","kind":"list-item"},{"blocks":[{"id":"blk-67220","kind":"paragraph","spans":[{"id":"spn-97781","marks":["code"],"text":"selection"},{"id":"spn-97782","text":" — how nodes were resolved (explicit/query/full_graph)"}]}],"id":"blk-67219","kind":"list-item"},{"blocks":[{"id":"blk-67222","kind":"paragraph","spans":[{"id":"spn-97783","marks":["code"],"text":"approximate"},{"id":"spn-97784","text":" — whether analysis used approximation for large graphs"}]}],"id":"blk-67221","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67223","kind":"heading","level":2,"spans":[{"id":"spn-97785","text":"Deliberate Through Cycles"}]},{"id":"blk-67224","kind":"paragraph","spans":[{"id":"spn-97786","text":"Reason through cyclic knowledge and optionally persist conclusions:"}]},{"id":"blk-67225","kind":"code","language":"text","text":"route(action: \"deliberate\",\n  query: \"Should we use approach A or B given the conflicting evidence?\",\n  node_ids: [\"<node1>\", \"<node2>\"],\n  write_back: true\n)"},{"id":"blk-67226","kind":"paragraph","spans":[{"id":"spn-97787","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-67227","items":[{"blocks":[{"id":"blk-67229","kind":"paragraph","spans":[{"id":"spn-97788","marks":["code"],"text":"conclusions"},{"id":"spn-97789","text":" — array of resolved conclusions, each with "},{"id":"spn-97790","marks":["code"],"text":"source_scc_id"},{"id":"spn-97791","text":", "},{"id":"spn-97792","marks":["code"],"text":"source_kappa"},{"id":"spn-97793","text":", "},{"id":"spn-97794","marks":["code"],"text":"fault_lines_examined"}]}],"id":"blk-67228","kind":"list-item"},{"blocks":[{"id":"blk-67231","kind":"paragraph","spans":[{"id":"spn-97795","marks":["code"],"text":"deliberation.converged"},{"id":"spn-97796","text":" — whether deliberation reached stable conclusions"}]}],"id":"blk-67230","kind":"list-item"},{"blocks":[{"id":"blk-67233","kind":"paragraph","spans":[{"id":"spn-97797","marks":["code"],"text":"deliberation.iterations_used"},{"id":"spn-97798","text":" — how many reasoning passes were needed"}]}],"id":"blk-67232","kind":"list-item"},{"blocks":[{"id":"blk-67235","kind":"paragraph","spans":[{"id":"spn-97799","marks":["code"],"text":"deliberation.topology_change"},{"id":"spn-97800","text":" — "},{"id":"spn-97801","marks":["code"],"text":"kappa_before"},{"id":"spn-97802","text":", "},{"id":"spn-97803","marks":["code"],"text":"kappa_after"},{"id":"spn-97804","text":", "},{"id":"spn-97805","marks":["code"],"text":"new_nodes_created"}]}],"id":"blk-67234","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67236","kind":"heading","level":3,"spans":[{"id":"spn-97806","text":"When to use "},{"id":"spn-97807","marks":["code"],"text":"write_back"}]},{"id":"blk-67237","items":[{"blocks":[{"id":"blk-67239","kind":"paragraph","spans":[{"id":"spn-97808","marks":["code"],"text":"write_back: true"},{"id":"spn-97809","text":" — crystallizes conclusions as new nodes. Use when you've reached a resolution you want to persist (reduces kappa for future retrievals)."}]}],"id":"blk-67238","kind":"list-item"},{"blocks":[{"id":"blk-67241","kind":"paragraph","spans":[{"id":"spn-97810","marks":["code"],"text":"write_back: false"},{"id":"spn-97811","text":" — reasoning only, no graph changes. Use for exploration or when you're not confident in the conclusion yet."}]}],"id":"blk-67240","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67242","kind":"heading","level":2,"spans":[{"id":"spn-97812","text":"Full Workflow"}]},{"id":"blk-67243","items":[{"blocks":[{"id":"blk-67245","kind":"paragraph","spans":[{"id":"spn-97813","marks":["bold"],"text":"Detect"},{"id":"spn-97814","text":" — "},{"id":"spn-97815","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-97816","text":" returns "},{"id":"spn-97817","marks":["code"],"text":"topology.routing: \"deliberate\""}]}],"id":"blk-67244","kind":"list-item"},{"blocks":[{"id":"blk-67247","kind":"paragraph","spans":[{"id":"spn-97818","marks":["bold"],"text":"Diagnose"},{"id":"spn-97819","text":" — "},{"id":"spn-97820","marks":["code"],"text":"route(action: \"topology\", query: \"...\")"},{"id":"spn-97821","text":" for detailed cycle info and fault-lines"}]}],"id":"blk-67246","kind":"list-item"},{"blocks":[{"id":"blk-67249","kind":"paragraph","spans":[{"id":"spn-97822","marks":["bold"],"text":"Examine fault-lines"},{"id":"spn-97823","text":" — inspect the weakest edges identified in step 2"}]}],"id":"blk-67248","kind":"list-item"},{"blocks":[{"id":"blk-67251","kind":"paragraph","spans":[{"id":"spn-97824","marks":["bold"],"text":"Deliberate"},{"id":"spn-97825","text":" — "},{"id":"spn-97826","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\", write_back: true)"},{"id":"spn-97827","text":" to reason through and resolve"}]}],"id":"blk-67250","kind":"list-item"},{"blocks":[{"id":"blk-67253","kind":"paragraph","spans":[{"id":"spn-97828","marks":["bold"],"text":"Verify"},{"id":"spn-97829","text":" — re-run "},{"id":"spn-97830","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-97831","text":" to confirm kappa decreased after resolution"}]}],"id":"blk-67252","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67254","kind":"heading","level":2,"spans":[{"id":"spn-97832","text":"When NOT to deliberate"}]},{"id":"blk-67255","items":[{"blocks":[{"id":"blk-67257","kind":"paragraph","spans":[{"id":"spn-97833","text":"When "},{"id":"spn-97834","marks":["code"],"text":"routing: \"fast\""},{"id":"spn-97835","text":" — normal retrieval is sufficient"}]}],"id":"blk-67256","kind":"list-item"},{"blocks":[{"id":"blk-67259","kind":"paragraph","spans":[{"id":"spn-97836","text":"For low-stakes decisions — deliberation has a cost"}]}],"id":"blk-67258","kind":"list-item"},{"blocks":[{"id":"blk-67261","kind":"paragraph","spans":[{"id":"spn-97837","text":"When there are no cycles (kappa = 0) — nothing to deliberate about"}]}],"id":"blk-67260","kind":"list-item"},{"blocks":[{"id":"blk-67263","kind":"paragraph","spans":[{"id":"spn-97838","text":"Over-deliberation is an anti-pattern — only deliberate when routing recommends it or you suspect contradictions"}]}],"id":"blk-67262","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaieraacdmhc5dsidzqrktrjwk3k2szhk2vmekjgononp77ny22ckg6l7q","vocabulary":"ampersand.docs.fs.v1"}