{"bendscript":"0.1","blocks":[{"id":"blk-67315","kind":"heading","level":1,"spans":[{"id":"spn-97927","text":"Topology and Deliberation"}]},{"id":"blk-67316","kind":"paragraph","spans":[{"id":"spn-97928","text":"Detect and reason through circular dependencies (cycles) in knowledge."}]},{"id":"blk-67317","kind":"heading","level":2,"spans":[{"id":"spn-97929","text":"Key Concepts"}]},{"id":"blk-67318","kind":"paragraph","spans":[{"id":"spn-97930","marks":["bold"],"text":"kappa"},{"id":"spn-97931","text":" is the cycle-complexity invariant — it measures how entangled the knowledge is:"}]},{"id":"blk-67319","items":[{"blocks":[{"id":"blk-67321","kind":"paragraph","spans":[{"id":"spn-97932","marks":["bold"],"text":"kappa = 0"},{"id":"spn-97933","text":" — acyclic DAG, no cycles. Safe for fast retrieval."}]}],"id":"blk-67320","kind":"list-item"},{"blocks":[{"id":"blk-67323","kind":"paragraph","spans":[{"id":"spn-97934","marks":["bold"],"text":"kappa = 1"},{"id":"spn-97935","text":" — simple cycle (A->B->C->A). Deliberation may help for high-stakes decisions."}]}],"id":"blk-67322","kind":"list-item"},{"blocks":[{"id":"blk-67325","kind":"paragraph","spans":[{"id":"spn-97936","marks":["bold"],"text":"kappa = 2+"},{"id":"spn-97937","text":" — nested/overlapping cycles. Deliberation strongly recommended."}]}],"id":"blk-67324","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67326","kind":"paragraph","spans":[{"id":"spn-97938","marks":["bold"],"text":"SCCs (Strongly Connected Components)"},{"id":"spn-97939","text":" are maximal cyclic clusters — groups of nodes where every node can reach every other node through directed edges."}]},{"id":"blk-67327","kind":"paragraph","spans":[{"id":"spn-97940","marks":["bold"],"text":"Fault-line edges"},{"id":"spn-97941","text":" are the weakest links in a cycle — the assumptions most likely to be wrong. Examining these first is the fastest path to resolving contradictions."}]},{"id":"blk-67328","kind":"heading","level":2,"spans":[{"id":"spn-97942","text":"Arguments"}]},{"id":"blk-67329","kind":"paragraph","spans":[{"id":"spn-97943","text":"Question to deliberate: $ARGUMENTS"}]},{"id":"blk-67330","kind":"heading","level":2,"spans":[{"id":"spn-97944","text":"Analyze Topology"}]},{"id":"blk-67331","kind":"paragraph","spans":[{"id":"spn-97945","text":"Read-only diagnostic — understand the structure:"}]},{"id":"blk-67332","kind":"code","language":"text","text":"route(action: \"topology\", query: \"<topic>\")"},{"id":"blk-67333","kind":"paragraph","spans":[{"id":"spn-97946","marks":["bold"],"text":"Parameters:"}]},{"id":"blk-67334","items":[{"blocks":[{"id":"blk-67336","kind":"paragraph","spans":[{"id":"spn-97947","marks":["code"],"text":"node_ids"},{"id":"spn-97948","text":" (optional) — explicit array of node IDs to analyze"}]}],"id":"blk-67335","kind":"list-item"},{"blocks":[{"id":"blk-67338","kind":"paragraph","spans":[{"id":"spn-97949","marks":["code"],"text":"query"},{"id":"spn-97950","text":" (optional) — retrieve nodes by query, then analyze"}]}],"id":"blk-67337","kind":"list-item"},{"blocks":[{"id":"blk-67340","kind":"paragraph","spans":[{"id":"spn-97951","text":"Neither — analyzes full graph"}]}],"id":"blk-67339","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67341","kind":"paragraph","spans":[{"id":"spn-97952","text":"If both "},{"id":"spn-97953","marks":["code"],"text":"node_ids"},{"id":"spn-97954","text":" and "},{"id":"spn-97955","marks":["code"],"text":"query"},{"id":"spn-97956","text":" are provided, "},{"id":"spn-97957","marks":["code"],"text":"node_ids"},{"id":"spn-97958","text":" takes precedence."}]},{"id":"blk-67342","kind":"paragraph","spans":[{"id":"spn-97959","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-67343","items":[{"blocks":[{"id":"blk-67345","kind":"paragraph","spans":[{"id":"spn-97960","marks":["code"],"text":"routing"},{"id":"spn-97961","text":" — "},{"id":"spn-97962","marks":["code"],"text":"\"fast\""},{"id":"spn-97963","text":" or "},{"id":"spn-97964","marks":["code"],"text":"\"deliberate\""}]}],"id":"blk-67344","kind":"list-item"},{"blocks":[{"id":"blk-67347","kind":"paragraph","spans":[{"id":"spn-97965","marks":["code"],"text":"max_kappa"},{"id":"spn-97966","text":" — highest kappa value found"}]}],"id":"blk-67346","kind":"list-item"},{"blocks":[{"id":"blk-67349","kind":"paragraph","spans":[{"id":"spn-97967","marks":["code"],"text":"sccs"},{"id":"spn-97968","text":" — array of strongly connected components, each with its own "},{"id":"spn-97969","marks":["code"],"text":"routing"},{"id":"spn-97970","text":" and "},{"id":"spn-97971","marks":["code"],"text":"kappa"}]}],"id":"blk-67348","kind":"list-item"},{"blocks":[{"id":"blk-67351","kind":"paragraph","spans":[{"id":"spn-97972","marks":["code"],"text":"fault_line_edges"},{"id":"spn-97973","text":" — weakest edges in cycles (examine these first)"}]}],"id":"blk-67350","kind":"list-item"},{"blocks":[{"id":"blk-67353","kind":"paragraph","spans":[{"id":"spn-97974","marks":["code"],"text":"deliberation_budget"},{"id":"spn-97975","text":" — "},{"id":"spn-97976","marks":["code"],"text":"max_iterations"},{"id":"spn-97977","text":" and "},{"id":"spn-97978","marks":["code"],"text":"focus_edges"},{"id":"spn-97979","text":" to guide deliberation effort"}]}],"id":"blk-67352","kind":"list-item"},{"blocks":[{"id":"blk-67355","kind":"paragraph","spans":[{"id":"spn-97980","marks":["code"],"text":"recommendation"},{"id":"spn-97981","text":" — human-readable guidance"}]}],"id":"blk-67354","kind":"list-item"},{"blocks":[{"id":"blk-67357","kind":"paragraph","spans":[{"id":"spn-97982","marks":["code"],"text":"selection"},{"id":"spn-97983","text":" — how nodes were resolved (explicit/query/full_graph)"}]}],"id":"blk-67356","kind":"list-item"},{"blocks":[{"id":"blk-67359","kind":"paragraph","spans":[{"id":"spn-97984","marks":["code"],"text":"approximate"},{"id":"spn-97985","text":" — whether analysis used approximation for large graphs"}]}],"id":"blk-67358","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67360","kind":"heading","level":2,"spans":[{"id":"spn-97986","text":"Deliberate Through Cycles"}]},{"id":"blk-67361","kind":"paragraph","spans":[{"id":"spn-97987","text":"Reason through cyclic knowledge and optionally persist conclusions:"}]},{"id":"blk-67362","kind":"code","language":"text","text":"route(action: \"deliberate\",\n  query: \"Should we use approach A or B given the conflicting evidence?\",\n  node_ids: [\"<node1>\", \"<node2>\"],\n  write_back: true\n)"},{"id":"blk-67363","kind":"paragraph","spans":[{"id":"spn-97988","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-67364","items":[{"blocks":[{"id":"blk-67366","kind":"paragraph","spans":[{"id":"spn-97989","marks":["code"],"text":"conclusions"},{"id":"spn-97990","text":" — array of resolved conclusions, each with "},{"id":"spn-97991","marks":["code"],"text":"source_scc_id"},{"id":"spn-97992","text":", "},{"id":"spn-97993","marks":["code"],"text":"source_kappa"},{"id":"spn-97994","text":", "},{"id":"spn-97995","marks":["code"],"text":"fault_lines_examined"}]}],"id":"blk-67365","kind":"list-item"},{"blocks":[{"id":"blk-67368","kind":"paragraph","spans":[{"id":"spn-97996","marks":["code"],"text":"deliberation.converged"},{"id":"spn-97997","text":" — whether deliberation reached stable conclusions"}]}],"id":"blk-67367","kind":"list-item"},{"blocks":[{"id":"blk-67370","kind":"paragraph","spans":[{"id":"spn-97998","marks":["code"],"text":"deliberation.iterations_used"},{"id":"spn-97999","text":" — how many reasoning passes were needed"}]}],"id":"blk-67369","kind":"list-item"},{"blocks":[{"id":"blk-67372","kind":"paragraph","spans":[{"id":"spn-98000","marks":["code"],"text":"deliberation.topology_change"},{"id":"spn-98001","text":" — "},{"id":"spn-98002","marks":["code"],"text":"kappa_before"},{"id":"spn-98003","text":", "},{"id":"spn-98004","marks":["code"],"text":"kappa_after"},{"id":"spn-98005","text":", "},{"id":"spn-98006","marks":["code"],"text":"new_nodes_created"}]}],"id":"blk-67371","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67373","kind":"heading","level":3,"spans":[{"id":"spn-98007","text":"When to use "},{"id":"spn-98008","marks":["code"],"text":"write_back"}]},{"id":"blk-67374","items":[{"blocks":[{"id":"blk-67376","kind":"paragraph","spans":[{"id":"spn-98009","marks":["code"],"text":"write_back: true"},{"id":"spn-98010","text":" — crystallizes conclusions as new nodes. Use when you've reached a resolution you want to persist (reduces kappa for future retrievals)."}]}],"id":"blk-67375","kind":"list-item"},{"blocks":[{"id":"blk-67378","kind":"paragraph","spans":[{"id":"spn-98011","marks":["code"],"text":"write_back: false"},{"id":"spn-98012","text":" — reasoning only, no graph changes. Use for exploration or when you're not confident in the conclusion yet."}]}],"id":"blk-67377","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-67379","kind":"heading","level":2,"spans":[{"id":"spn-98013","text":"Full Workflow"}]},{"id":"blk-67380","items":[{"blocks":[{"id":"blk-67382","kind":"paragraph","spans":[{"id":"spn-98014","marks":["bold"],"text":"Detect"},{"id":"spn-98015","text":" — "},{"id":"spn-98016","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-98017","text":" returns "},{"id":"spn-98018","marks":["code"],"text":"topology.routing: \"deliberate\""}]}],"id":"blk-67381","kind":"list-item"},{"blocks":[{"id":"blk-67384","kind":"paragraph","spans":[{"id":"spn-98019","marks":["bold"],"text":"Diagnose"},{"id":"spn-98020","text":" — "},{"id":"spn-98021","marks":["code"],"text":"route(action: \"topology\", query: \"...\")"},{"id":"spn-98022","text":" for detailed cycle info and fault-lines"}]}],"id":"blk-67383","kind":"list-item"},{"blocks":[{"id":"blk-67386","kind":"paragraph","spans":[{"id":"spn-98023","marks":["bold"],"text":"Examine fault-lines"},{"id":"spn-98024","text":" — inspect the weakest edges identified in step 2"}]}],"id":"blk-67385","kind":"list-item"},{"blocks":[{"id":"blk-67388","kind":"paragraph","spans":[{"id":"spn-98025","marks":["bold"],"text":"Deliberate"},{"id":"spn-98026","text":" — "},{"id":"spn-98027","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\", write_back: true)"},{"id":"spn-98028","text":" to reason through and resolve"}]}],"id":"blk-67387","kind":"list-item"},{"blocks":[{"id":"blk-67390","kind":"paragraph","spans":[{"id":"spn-98029","marks":["bold"],"text":"Verify"},{"id":"spn-98030","text":" — re-run "},{"id":"spn-98031","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-98032","text":" to confirm kappa decreased after resolution"}]}],"id":"blk-67389","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-67391","kind":"heading","level":2,"spans":[{"id":"spn-98033","text":"When NOT to deliberate"}]},{"id":"blk-67392","items":[{"blocks":[{"id":"blk-67394","kind":"paragraph","spans":[{"id":"spn-98034","text":"When "},{"id":"spn-98035","marks":["code"],"text":"routing: \"fast\""},{"id":"spn-98036","text":" — normal retrieval is sufficient"}]}],"id":"blk-67393","kind":"list-item"},{"blocks":[{"id":"blk-67396","kind":"paragraph","spans":[{"id":"spn-98037","text":"For low-stakes decisions — deliberation has a cost"}]}],"id":"blk-67395","kind":"list-item"},{"blocks":[{"id":"blk-67398","kind":"paragraph","spans":[{"id":"spn-98038","text":"When there are no cycles (kappa = 0) — nothing to deliberate about"}]}],"id":"blk-67397","kind":"list-item"},{"blocks":[{"id":"blk-67400","kind":"paragraph","spans":[{"id":"spn-98039","text":"Over-deliberation is an anti-pattern — only deliberate when routing recommends it or you suspect contradictions"}]}],"id":"blk-67399","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierawz76wstaabmyciutlwf77m7zeqic6gzwyw32v322xyusmgo3yzta","vocabulary":"ampersand.docs.fs.v1"}