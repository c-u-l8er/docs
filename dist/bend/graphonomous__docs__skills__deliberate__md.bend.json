{"bendscript":"0.1","blocks":[{"id":"blk-68143","kind":"heading","level":1,"spans":[{"id":"spn-100566","text":"Topology and Deliberation"}]},{"id":"blk-68144","kind":"paragraph","spans":[{"id":"spn-100567","text":"Detect and reason through circular dependencies (cycles) in knowledge."}]},{"id":"blk-68145","kind":"heading","level":2,"spans":[{"id":"spn-100568","text":"Key Concepts"}]},{"id":"blk-68146","kind":"paragraph","spans":[{"id":"spn-100569","marks":["bold"],"text":"kappa"},{"id":"spn-100570","text":" is the cycle-complexity invariant — it measures how entangled the knowledge is:"}]},{"id":"blk-68147","items":[{"blocks":[{"id":"blk-68149","kind":"paragraph","spans":[{"id":"spn-100571","marks":["bold"],"text":"kappa = 0"},{"id":"spn-100572","text":" — acyclic DAG, no cycles. Safe for fast retrieval."}]}],"id":"blk-68148","kind":"list-item"},{"blocks":[{"id":"blk-68151","kind":"paragraph","spans":[{"id":"spn-100573","marks":["bold"],"text":"kappa = 1"},{"id":"spn-100574","text":" — simple cycle (A->B->C->A). Deliberation may help for high-stakes decisions."}]}],"id":"blk-68150","kind":"list-item"},{"blocks":[{"id":"blk-68153","kind":"paragraph","spans":[{"id":"spn-100575","marks":["bold"],"text":"kappa = 2+"},{"id":"spn-100576","text":" — nested/overlapping cycles. Deliberation strongly recommended."}]}],"id":"blk-68152","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68154","kind":"paragraph","spans":[{"id":"spn-100577","marks":["bold"],"text":"SCCs (Strongly Connected Components)"},{"id":"spn-100578","text":" are maximal cyclic clusters — groups of nodes where every node can reach every other node through directed edges."}]},{"id":"blk-68155","kind":"paragraph","spans":[{"id":"spn-100579","marks":["bold"],"text":"Fault-line edges"},{"id":"spn-100580","text":" are the weakest links in a cycle — the assumptions most likely to be wrong. Examining these first is the fastest path to resolving contradictions."}]},{"id":"blk-68156","kind":"heading","level":2,"spans":[{"id":"spn-100581","text":"Arguments"}]},{"id":"blk-68157","kind":"paragraph","spans":[{"id":"spn-100582","text":"Question to deliberate: $ARGUMENTS"}]},{"id":"blk-68158","kind":"heading","level":2,"spans":[{"id":"spn-100583","text":"Analyze Topology"}]},{"id":"blk-68159","kind":"paragraph","spans":[{"id":"spn-100584","text":"Read-only diagnostic — understand the structure:"}]},{"id":"blk-68160","kind":"code","language":"text","text":"route(action: \"topology\", query: \"<topic>\")"},{"id":"blk-68161","kind":"paragraph","spans":[{"id":"spn-100585","marks":["bold"],"text":"Parameters:"}]},{"id":"blk-68162","items":[{"blocks":[{"id":"blk-68164","kind":"paragraph","spans":[{"id":"spn-100586","marks":["code"],"text":"node_ids"},{"id":"spn-100587","text":" (optional) — explicit array of node IDs to analyze"}]}],"id":"blk-68163","kind":"list-item"},{"blocks":[{"id":"blk-68166","kind":"paragraph","spans":[{"id":"spn-100588","marks":["code"],"text":"query"},{"id":"spn-100589","text":" (optional) — retrieve nodes by query, then analyze"}]}],"id":"blk-68165","kind":"list-item"},{"blocks":[{"id":"blk-68168","kind":"paragraph","spans":[{"id":"spn-100590","text":"Neither — analyzes full graph"}]}],"id":"blk-68167","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68169","kind":"paragraph","spans":[{"id":"spn-100591","text":"If both "},{"id":"spn-100592","marks":["code"],"text":"node_ids"},{"id":"spn-100593","text":" and "},{"id":"spn-100594","marks":["code"],"text":"query"},{"id":"spn-100595","text":" are provided, "},{"id":"spn-100596","marks":["code"],"text":"node_ids"},{"id":"spn-100597","text":" takes precedence."}]},{"id":"blk-68170","kind":"paragraph","spans":[{"id":"spn-100598","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-68171","items":[{"blocks":[{"id":"blk-68173","kind":"paragraph","spans":[{"id":"spn-100599","marks":["code"],"text":"routing"},{"id":"spn-100600","text":" — "},{"id":"spn-100601","marks":["code"],"text":"\"fast\""},{"id":"spn-100602","text":" or "},{"id":"spn-100603","marks":["code"],"text":"\"deliberate\""}]}],"id":"blk-68172","kind":"list-item"},{"blocks":[{"id":"blk-68175","kind":"paragraph","spans":[{"id":"spn-100604","marks":["code"],"text":"max_kappa"},{"id":"spn-100605","text":" — highest kappa value found"}]}],"id":"blk-68174","kind":"list-item"},{"blocks":[{"id":"blk-68177","kind":"paragraph","spans":[{"id":"spn-100606","marks":["code"],"text":"sccs"},{"id":"spn-100607","text":" — array of strongly connected components, each with its own "},{"id":"spn-100608","marks":["code"],"text":"routing"},{"id":"spn-100609","text":" and "},{"id":"spn-100610","marks":["code"],"text":"kappa"}]}],"id":"blk-68176","kind":"list-item"},{"blocks":[{"id":"blk-68179","kind":"paragraph","spans":[{"id":"spn-100611","marks":["code"],"text":"fault_line_edges"},{"id":"spn-100612","text":" — weakest edges in cycles (examine these first)"}]}],"id":"blk-68178","kind":"list-item"},{"blocks":[{"id":"blk-68181","kind":"paragraph","spans":[{"id":"spn-100613","marks":["code"],"text":"deliberation_budget"},{"id":"spn-100614","text":" — "},{"id":"spn-100615","marks":["code"],"text":"max_iterations"},{"id":"spn-100616","text":" and "},{"id":"spn-100617","marks":["code"],"text":"focus_edges"},{"id":"spn-100618","text":" to guide deliberation effort"}]}],"id":"blk-68180","kind":"list-item"},{"blocks":[{"id":"blk-68183","kind":"paragraph","spans":[{"id":"spn-100619","marks":["code"],"text":"recommendation"},{"id":"spn-100620","text":" — human-readable guidance"}]}],"id":"blk-68182","kind":"list-item"},{"blocks":[{"id":"blk-68185","kind":"paragraph","spans":[{"id":"spn-100621","marks":["code"],"text":"selection"},{"id":"spn-100622","text":" — how nodes were resolved (explicit/query/full_graph)"}]}],"id":"blk-68184","kind":"list-item"},{"blocks":[{"id":"blk-68187","kind":"paragraph","spans":[{"id":"spn-100623","marks":["code"],"text":"approximate"},{"id":"spn-100624","text":" — whether analysis used approximation for large graphs"}]}],"id":"blk-68186","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68188","kind":"heading","level":2,"spans":[{"id":"spn-100625","text":"Deliberate Through Cycles"}]},{"id":"blk-68189","kind":"paragraph","spans":[{"id":"spn-100626","text":"Reason through cyclic knowledge and optionally persist conclusions:"}]},{"id":"blk-68190","kind":"code","language":"text","text":"route(action: \"deliberate\",\n  query: \"Should we use approach A or B given the conflicting evidence?\",\n  node_ids: [\"<node1>\", \"<node2>\"],\n  write_back: true\n)"},{"id":"blk-68191","kind":"paragraph","spans":[{"id":"spn-100627","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-68192","items":[{"blocks":[{"id":"blk-68194","kind":"paragraph","spans":[{"id":"spn-100628","marks":["code"],"text":"conclusions"},{"id":"spn-100629","text":" — array of resolved conclusions, each with "},{"id":"spn-100630","marks":["code"],"text":"source_scc_id"},{"id":"spn-100631","text":", "},{"id":"spn-100632","marks":["code"],"text":"source_kappa"},{"id":"spn-100633","text":", "},{"id":"spn-100634","marks":["code"],"text":"fault_lines_examined"}]}],"id":"blk-68193","kind":"list-item"},{"blocks":[{"id":"blk-68196","kind":"paragraph","spans":[{"id":"spn-100635","marks":["code"],"text":"deliberation.converged"},{"id":"spn-100636","text":" — whether deliberation reached stable conclusions"}]}],"id":"blk-68195","kind":"list-item"},{"blocks":[{"id":"blk-68198","kind":"paragraph","spans":[{"id":"spn-100637","marks":["code"],"text":"deliberation.iterations_used"},{"id":"spn-100638","text":" — how many reasoning passes were needed"}]}],"id":"blk-68197","kind":"list-item"},{"blocks":[{"id":"blk-68200","kind":"paragraph","spans":[{"id":"spn-100639","marks":["code"],"text":"deliberation.topology_change"},{"id":"spn-100640","text":" — "},{"id":"spn-100641","marks":["code"],"text":"kappa_before"},{"id":"spn-100642","text":", "},{"id":"spn-100643","marks":["code"],"text":"kappa_after"},{"id":"spn-100644","text":", "},{"id":"spn-100645","marks":["code"],"text":"new_nodes_created"}]}],"id":"blk-68199","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68201","kind":"heading","level":3,"spans":[{"id":"spn-100646","text":"When to use "},{"id":"spn-100647","marks":["code"],"text":"write_back"}]},{"id":"blk-68202","items":[{"blocks":[{"id":"blk-68204","kind":"paragraph","spans":[{"id":"spn-100648","marks":["code"],"text":"write_back: true"},{"id":"spn-100649","text":" — crystallizes conclusions as new nodes. Use when you've reached a resolution you want to persist (reduces kappa for future retrievals)."}]}],"id":"blk-68203","kind":"list-item"},{"blocks":[{"id":"blk-68206","kind":"paragraph","spans":[{"id":"spn-100650","marks":["code"],"text":"write_back: false"},{"id":"spn-100651","text":" — reasoning only, no graph changes. Use for exploration or when you're not confident in the conclusion yet."}]}],"id":"blk-68205","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-68207","kind":"heading","level":2,"spans":[{"id":"spn-100652","text":"Full Workflow"}]},{"id":"blk-68208","items":[{"blocks":[{"id":"blk-68210","kind":"paragraph","spans":[{"id":"spn-100653","marks":["bold"],"text":"Detect"},{"id":"spn-100654","text":" — "},{"id":"spn-100655","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-100656","text":" returns "},{"id":"spn-100657","marks":["code"],"text":"topology.routing: \"deliberate\""}]}],"id":"blk-68209","kind":"list-item"},{"blocks":[{"id":"blk-68212","kind":"paragraph","spans":[{"id":"spn-100658","marks":["bold"],"text":"Diagnose"},{"id":"spn-100659","text":" — "},{"id":"spn-100660","marks":["code"],"text":"route(action: \"topology\", query: \"...\")"},{"id":"spn-100661","text":" for detailed cycle info and fault-lines"}]}],"id":"blk-68211","kind":"list-item"},{"blocks":[{"id":"blk-68214","kind":"paragraph","spans":[{"id":"spn-100662","marks":["bold"],"text":"Examine fault-lines"},{"id":"spn-100663","text":" — inspect the weakest edges identified in step 2"}]}],"id":"blk-68213","kind":"list-item"},{"blocks":[{"id":"blk-68216","kind":"paragraph","spans":[{"id":"spn-100664","marks":["bold"],"text":"Deliberate"},{"id":"spn-100665","text":" — "},{"id":"spn-100666","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\", write_back: true)"},{"id":"spn-100667","text":" to reason through and resolve"}]}],"id":"blk-68215","kind":"list-item"},{"blocks":[{"id":"blk-68218","kind":"paragraph","spans":[{"id":"spn-100668","marks":["bold"],"text":"Verify"},{"id":"spn-100669","text":" — re-run "},{"id":"spn-100670","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-100671","text":" to confirm kappa decreased after resolution"}]}],"id":"blk-68217","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-68219","kind":"heading","level":2,"spans":[{"id":"spn-100672","text":"When NOT to deliberate"}]},{"id":"blk-68220","items":[{"blocks":[{"id":"blk-68222","kind":"paragraph","spans":[{"id":"spn-100673","text":"When "},{"id":"spn-100674","marks":["code"],"text":"routing: \"fast\""},{"id":"spn-100675","text":" — normal retrieval is sufficient"}]}],"id":"blk-68221","kind":"list-item"},{"blocks":[{"id":"blk-68224","kind":"paragraph","spans":[{"id":"spn-100676","text":"For low-stakes decisions — deliberation has a cost"}]}],"id":"blk-68223","kind":"list-item"},{"blocks":[{"id":"blk-68226","kind":"paragraph","spans":[{"id":"spn-100677","text":"When there are no cycles (kappa = 0) — nothing to deliberate about"}]}],"id":"blk-68225","kind":"list-item"},{"blocks":[{"id":"blk-68228","kind":"paragraph","spans":[{"id":"spn-100678","text":"Over-deliberation is an anti-pattern — only deliberate when routing recommends it or you suspect contradictions"}]}],"id":"blk-68227","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierarl6zte3zi4wx6j5ynm2m7pli2pwy5jmle6kfg7znowplgr4g577a","vocabulary":"ampersand.docs.fs.v1"}