{"bendscript":"0.1","blocks":[{"id":"blk-74672","kind":"heading","level":1,"spans":[{"id":"spn-137290","text":"Topology and Deliberation"}]},{"id":"blk-74673","kind":"paragraph","spans":[{"id":"spn-137291","text":"Detect and reason through circular dependencies (cycles) in knowledge."}]},{"id":"blk-74674","kind":"heading","level":2,"spans":[{"id":"spn-137292","text":"Key Concepts"}]},{"id":"blk-74675","kind":"paragraph","spans":[{"id":"spn-137293","marks":["bold"],"text":"kappa"},{"id":"spn-137294","text":" is the cycle-complexity invariant — it measures how entangled the knowledge is:"}]},{"id":"blk-74676","items":[{"blocks":[{"id":"blk-74678","kind":"paragraph","spans":[{"id":"spn-137295","marks":["bold"],"text":"kappa = 0"},{"id":"spn-137296","text":" — acyclic DAG, no cycles. Safe for fast retrieval."}]}],"id":"blk-74677","kind":"list-item"},{"blocks":[{"id":"blk-74680","kind":"paragraph","spans":[{"id":"spn-137297","marks":["bold"],"text":"kappa = 1"},{"id":"spn-137298","text":" — simple cycle (A->B->C->A). Deliberation may help for high-stakes decisions."}]}],"id":"blk-74679","kind":"list-item"},{"blocks":[{"id":"blk-74682","kind":"paragraph","spans":[{"id":"spn-137299","marks":["bold"],"text":"kappa = 2+"},{"id":"spn-137300","text":" — nested/overlapping cycles. Deliberation strongly recommended."}]}],"id":"blk-74681","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74683","kind":"paragraph","spans":[{"id":"spn-137301","marks":["bold"],"text":"SCCs (Strongly Connected Components)"},{"id":"spn-137302","text":" are maximal cyclic clusters — groups of nodes where every node can reach every other node through directed edges."}]},{"id":"blk-74684","kind":"paragraph","spans":[{"id":"spn-137303","marks":["bold"],"text":"Fault-line edges"},{"id":"spn-137304","text":" are the weakest links in a cycle — the assumptions most likely to be wrong. Examining these first is the fastest path to resolving contradictions."}]},{"id":"blk-74685","kind":"heading","level":2,"spans":[{"id":"spn-137305","text":"Arguments"}]},{"id":"blk-74686","kind":"paragraph","spans":[{"id":"spn-137306","text":"Question to deliberate: $ARGUMENTS"}]},{"id":"blk-74687","kind":"heading","level":2,"spans":[{"id":"spn-137307","text":"Analyze Topology"}]},{"id":"blk-74688","kind":"paragraph","spans":[{"id":"spn-137308","text":"Read-only diagnostic — understand the structure:"}]},{"id":"blk-74689","kind":"code","language":"text","text":"route(action: \"topology\", query: \"<topic>\")"},{"id":"blk-74690","kind":"paragraph","spans":[{"id":"spn-137309","marks":["bold"],"text":"Parameters:"}]},{"id":"blk-74691","items":[{"blocks":[{"id":"blk-74693","kind":"paragraph","spans":[{"id":"spn-137310","marks":["code"],"text":"node_ids"},{"id":"spn-137311","text":" (optional) — explicit array of node IDs to analyze"}]}],"id":"blk-74692","kind":"list-item"},{"blocks":[{"id":"blk-74695","kind":"paragraph","spans":[{"id":"spn-137312","marks":["code"],"text":"query"},{"id":"spn-137313","text":" (optional) — retrieve nodes by query, then analyze"}]}],"id":"blk-74694","kind":"list-item"},{"blocks":[{"id":"blk-74697","kind":"paragraph","spans":[{"id":"spn-137314","text":"Neither — analyzes full graph"}]}],"id":"blk-74696","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74698","kind":"paragraph","spans":[{"id":"spn-137315","text":"If both "},{"id":"spn-137316","marks":["code"],"text":"node_ids"},{"id":"spn-137317","text":" and "},{"id":"spn-137318","marks":["code"],"text":"query"},{"id":"spn-137319","text":" are provided, "},{"id":"spn-137320","marks":["code"],"text":"node_ids"},{"id":"spn-137321","text":" takes precedence."}]},{"id":"blk-74699","kind":"paragraph","spans":[{"id":"spn-137322","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-74700","items":[{"blocks":[{"id":"blk-74702","kind":"paragraph","spans":[{"id":"spn-137323","marks":["code"],"text":"routing"},{"id":"spn-137324","text":" — "},{"id":"spn-137325","marks":["code"],"text":"\"fast\""},{"id":"spn-137326","text":" or "},{"id":"spn-137327","marks":["code"],"text":"\"deliberate\""}]}],"id":"blk-74701","kind":"list-item"},{"blocks":[{"id":"blk-74704","kind":"paragraph","spans":[{"id":"spn-137328","marks":["code"],"text":"max_kappa"},{"id":"spn-137329","text":" — highest kappa value found"}]}],"id":"blk-74703","kind":"list-item"},{"blocks":[{"id":"blk-74706","kind":"paragraph","spans":[{"id":"spn-137330","marks":["code"],"text":"sccs"},{"id":"spn-137331","text":" — array of strongly connected components, each with its own "},{"id":"spn-137332","marks":["code"],"text":"routing"},{"id":"spn-137333","text":" and "},{"id":"spn-137334","marks":["code"],"text":"kappa"}]}],"id":"blk-74705","kind":"list-item"},{"blocks":[{"id":"blk-74708","kind":"paragraph","spans":[{"id":"spn-137335","marks":["code"],"text":"fault_line_edges"},{"id":"spn-137336","text":" — weakest edges in cycles (examine these first)"}]}],"id":"blk-74707","kind":"list-item"},{"blocks":[{"id":"blk-74710","kind":"paragraph","spans":[{"id":"spn-137337","marks":["code"],"text":"deliberation_budget"},{"id":"spn-137338","text":" — "},{"id":"spn-137339","marks":["code"],"text":"max_iterations"},{"id":"spn-137340","text":" and "},{"id":"spn-137341","marks":["code"],"text":"focus_edges"},{"id":"spn-137342","text":" to guide deliberation effort"}]}],"id":"blk-74709","kind":"list-item"},{"blocks":[{"id":"blk-74712","kind":"paragraph","spans":[{"id":"spn-137343","marks":["code"],"text":"recommendation"},{"id":"spn-137344","text":" — human-readable guidance"}]}],"id":"blk-74711","kind":"list-item"},{"blocks":[{"id":"blk-74714","kind":"paragraph","spans":[{"id":"spn-137345","marks":["code"],"text":"selection"},{"id":"spn-137346","text":" — how nodes were resolved (explicit/query/full_graph)"}]}],"id":"blk-74713","kind":"list-item"},{"blocks":[{"id":"blk-74716","kind":"paragraph","spans":[{"id":"spn-137347","marks":["code"],"text":"approximate"},{"id":"spn-137348","text":" — whether analysis used approximation for large graphs"}]}],"id":"blk-74715","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74717","kind":"heading","level":2,"spans":[{"id":"spn-137349","text":"Deliberate Through Cycles"}]},{"id":"blk-74718","kind":"paragraph","spans":[{"id":"spn-137350","text":"Reason through cyclic knowledge and optionally persist conclusions:"}]},{"id":"blk-74719","kind":"code","language":"text","text":"route(action: \"deliberate\",\n  query: \"Should we use approach A or B given the conflicting evidence?\",\n  node_ids: [\"<node1>\", \"<node2>\"],\n  write_back: true\n)"},{"id":"blk-74720","kind":"paragraph","spans":[{"id":"spn-137351","marks":["bold"],"text":"Response fields:"}]},{"id":"blk-74721","items":[{"blocks":[{"id":"blk-74723","kind":"paragraph","spans":[{"id":"spn-137352","marks":["code"],"text":"conclusions"},{"id":"spn-137353","text":" — array of resolved conclusions, each with "},{"id":"spn-137354","marks":["code"],"text":"source_scc_id"},{"id":"spn-137355","text":", "},{"id":"spn-137356","marks":["code"],"text":"source_kappa"},{"id":"spn-137357","text":", "},{"id":"spn-137358","marks":["code"],"text":"fault_lines_examined"}]}],"id":"blk-74722","kind":"list-item"},{"blocks":[{"id":"blk-74725","kind":"paragraph","spans":[{"id":"spn-137359","marks":["code"],"text":"deliberation.converged"},{"id":"spn-137360","text":" — whether deliberation reached stable conclusions"}]}],"id":"blk-74724","kind":"list-item"},{"blocks":[{"id":"blk-74727","kind":"paragraph","spans":[{"id":"spn-137361","marks":["code"],"text":"deliberation.iterations_used"},{"id":"spn-137362","text":" — how many reasoning passes were needed"}]}],"id":"blk-74726","kind":"list-item"},{"blocks":[{"id":"blk-74729","kind":"paragraph","spans":[{"id":"spn-137363","marks":["code"],"text":"deliberation.topology_change"},{"id":"spn-137364","text":" — "},{"id":"spn-137365","marks":["code"],"text":"kappa_before"},{"id":"spn-137366","text":", "},{"id":"spn-137367","marks":["code"],"text":"kappa_after"},{"id":"spn-137368","text":", "},{"id":"spn-137369","marks":["code"],"text":"new_nodes_created"}]}],"id":"blk-74728","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74730","kind":"heading","level":3,"spans":[{"id":"spn-137370","text":"When to use "},{"id":"spn-137371","marks":["code"],"text":"write_back"}]},{"id":"blk-74731","items":[{"blocks":[{"id":"blk-74733","kind":"paragraph","spans":[{"id":"spn-137372","marks":["code"],"text":"write_back: true"},{"id":"spn-137373","text":" — crystallizes conclusions as new nodes. Use when you've reached a resolution you want to persist (reduces kappa for future retrievals)."}]}],"id":"blk-74732","kind":"list-item"},{"blocks":[{"id":"blk-74735","kind":"paragraph","spans":[{"id":"spn-137374","marks":["code"],"text":"write_back: false"},{"id":"spn-137375","text":" — reasoning only, no graph changes. Use for exploration or when you're not confident in the conclusion yet."}]}],"id":"blk-74734","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-74736","kind":"heading","level":2,"spans":[{"id":"spn-137376","text":"Full Workflow"}]},{"id":"blk-74737","items":[{"blocks":[{"id":"blk-74739","kind":"paragraph","spans":[{"id":"spn-137377","marks":["bold"],"text":"Detect"},{"id":"spn-137378","text":" — "},{"id":"spn-137379","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-137380","text":" returns "},{"id":"spn-137381","marks":["code"],"text":"topology.routing: \"deliberate\""}]}],"id":"blk-74738","kind":"list-item"},{"blocks":[{"id":"blk-74741","kind":"paragraph","spans":[{"id":"spn-137382","marks":["bold"],"text":"Diagnose"},{"id":"spn-137383","text":" — "},{"id":"spn-137384","marks":["code"],"text":"route(action: \"topology\", query: \"...\")"},{"id":"spn-137385","text":" for detailed cycle info and fault-lines"}]}],"id":"blk-74740","kind":"list-item"},{"blocks":[{"id":"blk-74743","kind":"paragraph","spans":[{"id":"spn-137386","marks":["bold"],"text":"Examine fault-lines"},{"id":"spn-137387","text":" — inspect the weakest edges identified in step 2"}]}],"id":"blk-74742","kind":"list-item"},{"blocks":[{"id":"blk-74745","kind":"paragraph","spans":[{"id":"spn-137388","marks":["bold"],"text":"Deliberate"},{"id":"spn-137389","text":" — "},{"id":"spn-137390","marks":["code"],"text":"route(action: \"deliberate\", query: \"...\", write_back: true)"},{"id":"spn-137391","text":" to reason through and resolve"}]}],"id":"blk-74744","kind":"list-item"},{"blocks":[{"id":"blk-74747","kind":"paragraph","spans":[{"id":"spn-137392","marks":["bold"],"text":"Verify"},{"id":"spn-137393","text":" — re-run "},{"id":"spn-137394","marks":["code"],"text":"route(action: \"topology\", ...)"},{"id":"spn-137395","text":" to confirm kappa decreased after resolution"}]}],"id":"blk-74746","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-74748","kind":"heading","level":2,"spans":[{"id":"spn-137396","text":"When NOT to deliberate"}]},{"id":"blk-74749","items":[{"blocks":[{"id":"blk-74751","kind":"paragraph","spans":[{"id":"spn-137397","text":"When "},{"id":"spn-137398","marks":["code"],"text":"routing: \"fast\""},{"id":"spn-137399","text":" — normal retrieval is sufficient"}]}],"id":"blk-74750","kind":"list-item"},{"blocks":[{"id":"blk-74753","kind":"paragraph","spans":[{"id":"spn-137400","text":"For low-stakes decisions — deliberation has a cost"}]}],"id":"blk-74752","kind":"list-item"},{"blocks":[{"id":"blk-74755","kind":"paragraph","spans":[{"id":"spn-137401","text":"When there are no cycles (kappa = 0) — nothing to deliberate about"}]}],"id":"blk-74754","kind":"list-item"},{"blocks":[{"id":"blk-74757","kind":"paragraph","spans":[{"id":"spn-137402","text":"Over-deliberation is an anti-pattern — only deliberate when routing recommends it or you suspect contradictions"}]}],"id":"blk-74756","kind":"list-item"}],"kind":"list","ordered":false}],"edges":[],"id":"bagaaierablehnpzg5dhdqbargm32mo3eelm4bd4ebsg5j42cfn5iksgrn5lq","vocabulary":"ampersand.docs.fs.v1"}