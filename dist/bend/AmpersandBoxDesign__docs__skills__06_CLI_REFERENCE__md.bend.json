 Capability set: &memory.graph & &time.anomaly & &reason.argument\n  ACI normal form: &memory.graph & &reason.argument & &time.anomaly\n  Pipelines: incident_triage (3 steps, type-safe)\n  Providers: graphonomous, ticktickclock, deliberatic"},{"id":"blk-16823","kind":"heading","level":3,"spans":[{"id":"spn-14925","text":"Output (verbose)"}]},{"id":"blk-16824","kind":"code","language":"text","text":"  Pipeline: incident_triage\n    Step 1: &time.anomaly.detect()\n      Input:  stream_data (from source_ref)\n      Output: anomaly_set\n    Step 2: &memory.graph.enrich()\n      Input:  anomaly_set (matches &time.* in accepts_from) OK\n      Output: enriched_context\n    Step 3: &reason.argument.evaluate()\n      Input:  enriched_context (matches &memory.* in accepts_from) OK\n      Output: evaluation_result\n    Pipeline type-safe: YES"},{"id":"blk-16825","kind":"heading","level":3,"spans":[{"id":"spn-14926","text":"Exit Codes"}]},{"head":[{"id":"blk-16827","spans":[{"id":"spn-14927","text":"Code"}]},{"id":"blk-16828","spans":[{"id":"spn-14928","text":"Meaning"}]}],"id":"blk-16826","kind":"table","rows":[[{"id":"blk-16829","spans":[{"id":"spn-14929","marks":["code"],"text":"0"}]},{"id":"blk-16830","spans":[{"id":"spn-14930","text":"Composition valid"}]}],[{"id":"blk-16831","spans":[{"id":"spn-14931","marks":["code"],"text":"1"}]},{"id":"blk-16832","spans":[{"id":"spn-14932","text":"Composition errors (type mismatch, missing provider)"}]}],[{"id":"blk-16833","spans":[{"id":"spn-14933","marks":["code"],"text":"2"}]},{"id":"blk-16834","spans":[{"id":"spn-14934","text":"File not found or unreadable"}]}]]},{"id":"blk-16835","kind":"heading","level":2,"spans":[{"id":"spn-14935","text":"generate mcp"}]},{"id":"blk-16836","kind":"paragraph","spans":[{"id":"spn-14936","text":"Generate an MCP server configuration from a declaration."}]},{"id":"blk-16837","kind":"heading","level":3,"spans":[{"id":"spn-14937","text":"Usage"}]},{"id":"blk-16838","kind":"code","language":"bash","text