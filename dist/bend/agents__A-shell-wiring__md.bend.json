d":"blk-52741","kind":"paragraph","spans":[{"id":"spn-100643","marks":["bold"],"text":"`publish.js`"},{"id":"spn-100644","text":" seals a track into a content-addressed bundle. *The address is the hash of the"}]}],"id":"blk-52740","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52742","kind":"paragraph","spans":[{"id":"spn-100645","text":"bundle and the guard is inside the bundle*, so a tampered track fails either on id mismatch or on a derived-vs-stated comparison. 33 tests."}]},{"id":"blk-52743","items":[{"blocks":[{"id":"blk-52745","kind":"paragraph","spans":[{"id":"spn-100646","marks":["bold"],"text":"`trackstore.js`"},{"id":"spn-100647","text":" puts and fetches bundles, and "},{"id":"spn-100648","marks":["bold"],"text":"never trusts the store"},{"id":"spn-100649","text":" — every read"}]}],"id":"blk-52744","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52746","kind":"paragraph","spans":[{"id":"spn-100650","text":"re-derives the hash. Two adapters ("},{"id":"spn-100651","marks":["code"],"text":"memoryAdapter"},{"id":"spn-100652","text":", "},{"id":"spn-100653","marks":["code"],"text":"httpAdapter"},{"id":"spn-100654","text":"), logic in neither. 34 tests."}]},{"id":"blk-52747","items":[{"blocks":[{"id":"blk-52749","kind":"paragraph","spans":[{"id":"spn-100655","marks":["bold"],"text":"The machine-A-publishes / machine-B-refuses demo exists as a test"},{"id":"spn-100656","text":" ("},{"id":"spn-100657","marks":["code"],"text":"test/trackstore.mjs"},{"id":"spn-100658","text":" §5)."}]}],"id":"blk-52748","kind":"list-item"},{"blocks":[{"id":"blk-52751","kind":"paragraph","spans":[{"id":"spn-100659","text":"Whole suite: "},{"id":"spn-100660","marks":["bold"],"text":"507 tests, 0 failures"},{"id":"spn-100661","text":", eight files."}]}],"id":"blk-52750","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52752","kind":"heading","level":2,"spans":[{"id":"spn-100662","text":"What is missing — this lane's work"}]},{"id":"blk-52753","kind":"heading","level":3,"spans":[{"id":"spn-100663","text":"1. Wire publishing into the reel"}]},{"id":"blk-52754","kind":"paragraph","spans":[{"id":"spn-100664","text":"There is no "},{"id":"spn-100665","marks":["code"],"text":"publish"},{"id":"spn-100666","text":" verb, no button, nothing in the UI. The reel (gear "},{"id":"spn-100667","marks":["bold"],"text":"R"},{"id":"spn-100668","text":") is where a track is managed, so it is where \"publish this one\" belongs. Seal → show the id → offer the bytes."}]},{"id":"blk-52755","kind":"paragraph","spans":[{"id":"spn-100669","marks":["bold"],"text":"Design constraint:"},{"id":"spn-100670","text":" the shell must keep working with no network. Publishing is an action a user takes, never something that happens on a timer or on save."}]},{"id":"blk-52756","kind":"heading","level":3,"spans":[{"id":"spn-100671","text":"2. Connect a fetched track to "},{"id":"spn-100672","marks":["code"],"text":"ops.replay"}]},{"id":"blk-52757","kind":"paragraph","spans":[{"id":"spn-100673","marks":["code"],"text":"check()"},{"id":"spn-100674","text":" answers "},{"id":"spn-100675","marks":["italic"],"text":"may this run here"},{"id":"spn-100676","text":". Handing the steps to the seam is the remaining piece, and it is small on purpose — "},{"id":"spn-100677","marks":["code"],"text":"ops.replay"},{"id":"spn-100678","text":" is already a "},{"id":"spn-100679","marks":["code"],"text":"for"},{"id":"spn-100680","text":" loop over "},{"id":"spn-100681","marks":["code"],"text":"apply"},{"id":"spn-100682","text":", deliberately not a second code path. "},{"id":"spn-100683","marks":["bold"],"text":"Do not add a second one here."},{"id":"spn-100684","text":" A fetched track's steps go through the same "},{"id":"spn-100685","marks":["code"],"text":"apply"},{"id":"spn-100686","text":" every local replay uses, or the §9 claim in "},{"id":"spn-100687","marks":["code"],"text":"OP_VOCABULARY_DRAFT.md"},{"id":"spn-100688","text":" is false."}]},{"id":"blk-52758","kind":"paragraph","spans":[{"id":"spn-100689","text":"Order is fixed: "},{"id":"spn-100690","marks":["code"],"text":"store.get"},{"id":"spn-100691","text":" (verifies) → "},{"id":"spn-100692","marks":["code"],"text":"check"},{"id":"spn-100693","text":" (roads, before anything moves) → "},{"id":"spn-100694","marks":["code"],"text":"ops.replay"},{"id":"spn-100695","text":"."}]},{"id":"blk-52759","kind":"heading","level":3,"spans":[{"id":"spn-100696","text":"3. Fix the silent-persistence defect"}]},{"id":"blk-52760","kind":"paragraph","spans":[{"id":"spn-100697","marks":["bold"],"text":"Measured 2026-08-15:"},{"id":"spn-100698","text":" "},{"id":"spn-100699","marks":["code"],"text":"tracks.js"},{"id":"spn-100700","text":" permits ~212.9 MB (999 tracks × "},{"id":"spn-100701","marks":["code"],"text":"REC_MAX"},{"id":"spn-100702","text":" 4096), the real "},{"id":"spn-100703","marks":["code"],"text":"localStorage"},{"id":"spn-100704","text":" quota is "},{"id":"spn-100705","marks":["bold"],"text":"5,187,584 bytes (4.95 MB)"},{"id":"spn-100706","text":" — a "},{"id":"spn-100707","marks":["bold"],"text":"43× gap"},{"id":"spn-100708","text":", so only ~23 full tracks fit. "},{"id":"spn-100709","marks":["code"],"text":"save()"},{"id":"spn-100710","text":" wraps "},{"id":"spn-100711","marks":["code"],"text":"setItem"},{"id":"spn-100712","text":" in "},{"id":"spn-100713","marks":["code"],"text":"try {} catch {}"},{"id":"spn-100714","text":", right for private-browsing mode and "},{"id":"spn-100715","marks":["bold"],"text":"wrong for `QuotaExceededError`"},{"id":"spn-100716","text":", which it swallows too. The shell keeps running, stops persisting, and loses the drive on the next reload with nothing said."}]},{"id":"blk-52761","kind":"paragraph","spans":[{"id":"spn-100717","marks":["code"],"text":"workspaces.js"},{"id":"spn-100718","text":" and "},{"id":"spn-100719","marks":["code"],"text":"layout.js"},{"id":"spn-100720","text":" have the same bare-catch pattern — check them too."}]},{"id":"blk-52762","kind":"paragraph","spans":[{"id":"spn-100721","text":"Direction (not a ruling): probe once at load with a tiny key to tell private-mode from quota; surface the quota case via "},{"id":"spn-100722","marks":["code"],"text":"#status"},{"id":"spn-100723","text":", which already un-hides itself when written; and consider whether the caps should be bounded by the real store rather than by numbers 43× above it."}]},{"id":"blk-52763","kind":"paragraph","spans":[{"id":"spn-100724","marks":["bold"],"text":"4.95 MB is one Chrome."},{"id":"spn-100725","text":" The guest runs a "},{"id":"spn-100726","marks":["bold"],"text":"Firefox"},{"id":"spn-100727","text":" kiosk, which was never measured. Measure it before hard-coding a threshold."}]},{"id":"blk-52764","kind":"heading","level":2,"spans":[{"id":"spn-100728","text":"Done means"}]},{"id":"blk-52765","items":[{"blocks":[{"id":"blk-52767","kind":"paragraph","spans":[{"id":"spn-100729","marks":["code"],"text":"node test/publish.mjs && node test/trackstore.mjs && node test/ops.mjs"},{"id":"spn-100730","text":" green, plus the rest of"}]}],"id":"blk-52766","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52768","kind":"paragraph","spans":[{"id":"spn-100731","marks":["code"],"text":"test/"},{"id":"spn-100732","text":"."}]},{"id":"blk-52769","items":[{"blocks":[{"id":"blk-52771","kind":"paragraph","spans":[{"id":"spn-100733","text":"A track published from the reel and replayed on a "},{"id":"spn-100734","marks":["bold"],"text":"second profile or machine"},{"id":"spn-100735","text":" — and a refusal"}]}],"id":"blk-52770","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-52772","kind":"paragraph","spans":[{"id":"spn-100736","text":"demonstrated when a road is missing. The refusal is the interesting half."}]},{"id":"blk-52773","items":[{"blocks":[{"id":"blk-52775","kind":"paragraph","spans":[{"id":"spn-100737","text":"Quota exhaustion produces a "},{"id":"spn-100738","m