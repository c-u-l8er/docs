{"bendscript":"0.1","blocks":[{"id":"blk-40641","kind":"heading","level":1,"spans":[{"id":"spn-45235","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-40642","kind":"paragraph","spans":[{"id":"spn-45236","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-45237","marks":["bold"],"text":"Zed"},{"id":"spn-45238","text":" with a working local setup."}]},{"id":"blk-40643","kind":"paragraph","spans":[{"id":"spn-45239","text":"---"}]},{"id":"blk-40644","kind":"heading","level":2,"spans":[{"id":"spn-45240","text":"1) Prerequisites"}]},{"id":"blk-40645","items":[{"blocks":[{"id":"blk-40647","kind":"paragraph","spans":[{"id":"spn-45241","text":"Elixir "},{"id":"spn-45242","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-40646","kind":"list-item"},{"blocks":[{"id":"blk-40649","kind":"paragraph","spans":[{"id":"spn-45243","text":"Erlang/OTP "},{"id":"spn-45244","marks":["code"],"text":"27.x"}]}],"id":"blk-40648","kind":"list-item"},{"blocks":[{"id":"blk-40651","kind":"paragraph","spans":[{"id":"spn-45245","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-40650","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40652","kind":"paragraph","spans":[{"id":"spn-45246","text":"From the project root:"}]},{"id":"blk-40653","kind":"paragraph","spans":[{"id":"spn-45247","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-40654","kind":"paragraph","spans":[{"id":"spn-45248","text":"---"}]},{"id":"blk-40655","kind":"heading","level":2,"spans":[{"id":"spn-45249","text":"2) Choose a launch mode"}]},{"id":"blk-40656","kind":"paragraph","spans":[{"id":"spn-45250","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-40657","kind":"heading","level":3,"spans":[{"id":"spn-45251","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-40658","kind":"paragraph","spans":[{"id":"spn-45252","text":"Use Mix with no compile step:"}]},{"id":"blk-40659","kind":"paragraph","spans":[{"id":"spn-45253","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-40660","kind":"paragraph","spans":[{"id":"spn-45254","text":"This is the easiest way to test local changes quickly."}]},{"id":"blk-40661","kind":"heading","level":3,"spans":[{"id":"spn-45255","text":"B) Built executable mode (recommended for stable deployment)"}]},{"id":"blk-40662","kind":"paragraph","spans":[{"id":"spn-45256","text":"Build the "},{"id":"spn-45257","marks":["code"],"text":"graphonomous"},{"id":"spn-45258","text":" executable:"}]},{"id":"blk-40663","kind":"paragraph","spans":[{"id":"spn-45259","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-40664","kind":"paragraph","spans":[{"id":"spn-45260","text":"This creates:"}]},{"id":"blk-40665","kind":"paragraph","spans":[{"id":"spn-45261","text":"./graphonomous"}]},{"id":"blk-40666","kind":"paragraph","spans":[{"id":"spn-45262","text":"---"}]},{"id":"blk-40667","kind":"heading","level":2,"spans":[{"id":"spn-45263","text":"3) Quick local run check (recommended)"}]},{"id":"blk-40668","kind":"paragraph","spans":[{"id":"spn-45264","text":"Before wiring Zed, verify the command starts."}]},{"id":"blk-40669","kind":"paragraph","spans":[{"id":"spn-45265","text":"If using fast dev mode:"}]},{"id":"blk-40670","kind":"paragraph","spans":[{"id":"spn-45266","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--help\"])'"}]},{"id":"blk-40671","kind":"paragraph","spans":[{"id":"spn-45267","text":"If using built executable mode:"}]},{"id":"blk-40672","kind":"paragraph","spans":[{"id":"spn-45268","text":"./graphonomous --help"}]},{"id":"blk-40673","kind":"paragraph","spans":[{"id":"spn-45269","text":"Then run server mode (stdio MCP transport)."}]},{"id":"blk-40674","kind":"paragraph","spans":[{"id":"spn-45270","text":"Fast dev mode:"}]},{"id":"blk-40675","kind":"paragraph","spans":[{"id":"spn-45271","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-40676","kind":"paragraph","spans":[{"id":"spn-45272","text":"Built executable mode:"}]},{"id":"blk-40677","kind":"paragraph","spans":[{"id":"spn-45273","text":"./graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-40678","kind":"paragraph","spans":[{"id":"spn-45274","text":"Notes:"}]},{"id":"blk-40679","items":[{"blocks":[{"id":"blk-40681","kind":"paragraph","spans":[{"id":"spn-45275","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-45276","text":" is the safest default for constrained laptops."}]}],"id":"blk-40680","kind":"list-item"},{"blocks":[{"id":"blk-40683","kind":"paragraph","spans":[{"id":"spn-45277","text":"Press "},{"id":"spn-45278","marks":["code"],"text":"Ctrl+C"},{"id":"spn-45279","text":" to stop."}]}],"id":"blk-40682","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40684","kind":"heading","level":3,"spans":[{"id":"spn-45280","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-40685","kind":"paragraph","spans":[{"id":"spn-45281","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-40686","kind":"paragraph","spans":[{"id":"spn-45282","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-40687","kind":"paragraph","spans":[{"id":"spn-45283","text":"What it validates: 1. "},{"id":"spn-45284","marks":["code"],"text":"initialize"},{"id":"spn-45285","text":" handshake succeeds 2. "},{"id":"spn-45286","marks":["code"],"text":"notifications/initialized"},{"id":"spn-45287","text":" is accepted 3. "},{"id":"spn-45288","marks":["code"],"text":"tools/list"},{"id":"spn-45289","text":" responds 4. "},{"id":"spn-45290","marks":["code"],"text":"resources/list"},{"id":"spn-45291","text":" responds 5. response latencies stay within thresholds"}]},{"id":"blk-40688","kind":"paragraph","spans":[{"id":"spn-45292","text":"Useful variants:"}]},{"id":"blk-40689","kind":"paragraph","spans":[{"id":"spn-45293","text":"# verbose stderr while testing python scripts/mcp_smoke_test.py --cwd . --tee-stderr"}]},{"id":"blk-40690","kind":"paragraph","spans":[{"id":"spn-45294","text":"# stricter latency gates (example) python scripts/mcp_smoke_test.py --cwd . --max-initialize-ms 2500 --max-discovery-ms 2500"}]},{"id":"blk-40691","kind":"paragraph","spans":[{"id":"spn-45295","text":"---"}]},{"id":"blk-40692","kind":"heading","level":2,"spans":[{"id":"spn-45296","text":"4) Configure Zed ("},{"id":"spn-45297","marks":["code"],"text":"context_servers"},{"id":"spn-45298","text":")"}]},{"id":"blk-40693","kind":"paragraph","spans":[{"id":"spn-45299","text":"Open your Zed settings JSON and add one of the following."}]},{"id":"blk-40694","kind":"heading","level":3,"spans":[{"id":"spn-45300","text":"Option A: Built executable (recommended for stable use)"}]},{"id":"blk-40695","kind":"paragraph","spans":[{"id":"spn-45301","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"/absolute/path/to/ProjectAmp2/graphonomous/graphonomous\", \"args\": [ \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\" ], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\", \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-40696","kind":"paragraph","spans":[{"id":"spn-45302","text":"If "},{"id":"spn-45303","marks":["code"],"text":"graphonomous"},{"id":"spn-45304","text":" is on your "},{"id":"spn-45305","marks":["code"],"text":"PATH"},{"id":"spn-45306","text":", you can use:"}]},{"id":"blk-40697","kind":"paragraph","spans":[{"id":"spn-45307","text":"\"command\": \"graphonomous\""}]},{"id":"blk-40698","kind":"paragraph","spans":[{"id":"spn-45308","text":"instead of an absolute path."}]},{"id":"blk-40699","kind":"heading","level":3,"spans":[{"id":"spn-45309","text":"Option B: Fast dev mode with no compile"}]},{"id":"blk-40700","kind":"paragraph","spans":[{"id":"spn-45310","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"sh\", \"args\": [ \"-lc\", \"cd /absolute/path/to/ProjectAmp2/graphonomous && mix run --no-compile -e 'Graphonomous.CLI.main([\\\"--db\\\",\\\"~/.graphonomous/knowledge.db\\\",\\\"--embedder-backend\\\",\\\"fallback\\\"])'\" ], \"env\": { \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-40701","kind":"paragraph","spans":[{"id":"spn-45311","text":"Use Option B while actively changing code; switch to Option A for daily/stable usage."}]},{"id":"blk-40702","kind":"paragraph","spans":[{"id":"spn-45312","text":"---"}]},{"id":"blk-40703","kind":"heading","level":2,"spans":[{"id":"spn-45313","text":"4.1) Always-on skills prompt wiring (required for every chat)"}]},{"id":"blk-40704","kind":"paragraph","spans":[{"id":"spn-45314","text":"To make Graphonomous usage consistent in every chat, load the skills pack into your agent prompt context at chat start."}]},{"id":"blk-40705","kind":"paragraph","spans":[{"id":"spn-45315","text":"Skills live in the "},{"id":"spn-45316","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-45317","text":" repo. Reference docs are mirrored in "},{"id":"spn-45318","marks":["code"],"text":"docs/skills/"},{"id":"spn-45319","text":"."}]},{"id":"blk-40706","kind":"paragraph","spans":[{"id":"spn-45320","text":"Minimum required context:"}]},{"id":"blk-40707","kind":"paragraph","spans":[{"id":"spn-45321","text":"1. "},{"id":"spn-45322","marks":["code"],"text":"docs/skills/SKILLS.md"},{"id":"spn-45323","text":" 2. "},{"id":"spn-45324","marks":["code"],"text":"docs/skills/bootstrap.md"}]},{"id":"blk-40708","kind":"paragraph","spans":[{"id":"spn-45325","text":"Recommended full context:"}]},{"id":"blk-40709","items":[{"blocks":[{"id":"blk-40711","kind":"paragraph","spans":[{"id":"spn-45326","marks":["code"],"text":"docs/skills/retrieve.md"}]}],"id":"blk-40710","kind":"list-item"},{"blocks":[{"id":"blk-40713","kind":"paragraph","spans":[{"id":"spn-45327","marks":["code"],"text":"docs/skills/learn.md"}]}],"id":"blk-40712","kind":"list-item"},{"blocks":[{"id":"blk-40715","kind":"paragraph","spans":[{"id":"spn-45328","marks":["code"],"text":"docs/skills/deliberate.md"}]}],"id":"blk-40714","kind":"list-item"},{"blocks":[{"id":"blk-40717","kind":"paragraph","spans":[{"id":"spn-45329","marks":["code"],"text":"docs/skills/consolidate.md"}]}],"id":"blk-40716","kind":"list-item"},{"blocks":[{"id":"blk-40719","kind":"paragraph","spans":[{"id":"spn-45330","marks":["code"],"text":"docs/skills/goals.md"}]}],"id":"blk-40718","kind":"list-item"},{"blocks":[{"id":"blk-40721","kind":"paragraph","spans":[{"id":"spn-45331","marks":["code"],"text":"docs/skills/attention.md"}]}],"id":"blk-40720","kind":"list-item"},{"blocks":[{"id":"blk-40723","kind":"paragraph","spans":[{"id":"spn-45332","marks":["code"],"text":"docs/skills/workflows.md"}]}],"id":"blk-40722","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40724","kind":"paragraph","spans":[{"id":"spn-45333","text":"If your Zed workflow supports per-assistant system/developer instructions, include the SKILLS.md and bootstrap.md there so they are applied automatically each chat."}]},{"id":"blk-40725","kind":"paragraph","spans":[{"id":"spn-45334","text":"---"}]},{"id":"blk-40726","kind":"heading","level":2,"spans":[{"id":"spn-45335","text":"5) Validate in Zed"}]},{"id":"blk-40727","kind":"paragraph","spans":[{"id":"spn-45336","text":"1. Open the Agent panel. 2. Go to MCP/context server settings. 3. Confirm "},{"id":"spn-45337","marks":["code"],"text":"graphonomous"},{"id":"spn-45338","text":" is active (running indicator). 4. At the start of each new chat, load the prompt context from:"}]},{"id":"blk-40728","items":[{"blocks":[{"id":"blk-40730","kind":"paragraph","spans":[{"id":"spn-45339","marks":["code"],"text":"docs/skills/SKILLS.md"}]}],"id":"blk-40729","kind":"list-item"},{"blocks":[{"id":"blk-40732","kind":"paragraph","spans":[{"id":"spn-45340","marks":["code"],"text":"docs/skills/bootstrap.md"}]}],"id":"blk-40731","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40733","kind":"paragraph","spans":[{"id":"spn-45341","text":"5. For best results, also load additional skill files from "},{"id":"spn-45342","marks":["code"],"text":"docs/skills/"},{"id":"spn-45343","text":" (e.g., retrieve.md, learn.md, workflows.md). 6. Start the prompt and ask it to use Graphonomous tools explicitly, e.g.:"}]},{"id":"blk-40734","items":[{"blocks":[{"id":"blk-40736","kind":"paragraph","spans":[{"id":"spn-45344","text":"“Use "},{"id":"spn-45345","marks":["code"],"text":"graphonomous"},{"id":"spn-45346","text":" to "},{"id":"spn-45347","marks":["code"],"text":"retrieve(action: “context”, ...)"},{"id":"spn-45348","text":" before answering.”"}]}],"id":"blk-40735","kind":"list-item"},{"blocks":[{"id":"blk-40738","kind":"paragraph","spans":[{"id":"spn-45349","text":"“Use "},{"id":"spn-45350","marks":["code"],"text":"graphonomous"},{"id":"spn-45351","text":" to "},{"id":"spn-45352","marks":["code"],"text":"act(action: “store_node”, ...)"},{"id":"spn-45353","text":" for semantic memory.”"}]}],"id":"blk-40737","kind":"list-item"},{"blocks":[{"id":"blk-40740","kind":"paragraph","spans":[{"id":"spn-45354","text":"“Use "},{"id":"spn-45355","marks":["code"],"text":"graphonomous"},{"id":"spn-45356","text":" to "},{"id":"spn-45357","marks":["code"],"text":"learn(action: “from_outcome”, ...)"},{"id":"spn-45358","text":" for outcome feedback.”"}]}],"id":"blk-40739","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40741","kind":"paragraph","spans":[{"id":"spn-45359","text":"---"}]},{"id":"blk-40742","kind":"heading","level":2,"spans":[{"id":"spn-45360","text":"6) First-use workflow (fastest)"}]},{"id":"blk-40743","kind":"paragraph","spans":[{"id":"spn-45361","text":"1. Store a few nodes with "},{"id":"spn-45362","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-45363","text":". 2. Query them via "},{"id":"spn-45364","marks":["code"],"tex