{"bendscript":"0.1","blocks":[{"id":"blk-41127","kind":"heading","level":1,"spans":[{"id":"spn-46409","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-41128","kind":"paragraph","spans":[{"id":"spn-46410","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-46411","marks":["bold"],"text":"Zed"},{"id":"spn-46412","text":" with a working local setup."}]},{"id":"blk-41129","kind":"paragraph","spans":[{"id":"spn-46413","text":"---"}]},{"id":"blk-41130","kind":"heading","level":2,"spans":[{"id":"spn-46414","text":"1) Prerequisites"}]},{"id":"blk-41131","items":[{"blocks":[{"id":"blk-41133","kind":"paragraph","spans":[{"id":"spn-46415","text":"Elixir "},{"id":"spn-46416","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-41132","kind":"list-item"},{"blocks":[{"id":"blk-41135","kind":"paragraph","spans":[{"id":"spn-46417","text":"Erlang/OTP "},{"id":"spn-46418","marks":["code"],"text":"27.x"}]}],"id":"blk-41134","kind":"list-item"},{"blocks":[{"id":"blk-41137","kind":"paragraph","spans":[{"id":"spn-46419","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-41136","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41138","kind":"paragraph","spans":[{"id":"spn-46420","text":"From the project root:"}]},{"id":"blk-41139","kind":"paragraph","spans":[{"id":"spn-46421","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-41140","kind":"paragraph","spans":[{"id":"spn-46422","text":"---"}]},{"id":"blk-41141","kind":"heading","level":2,"spans":[{"id":"spn-46423","text":"2) Choose a launch mode"}]},{"id":"blk-41142","kind":"paragraph","spans":[{"id":"spn-46424","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-41143","kind":"heading","level":3,"spans":[{"id":"spn-46425","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-41144","kind":"paragraph","spans":[{"id":"spn-46426","text":"Use Mix with no compile step:"}]},{"id":"blk-41145","kind":"paragraph","spans":[{"id":"spn-46427","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-41146","kind":"paragraph","spans":[{"id":"spn-46428","text":"This is the easiest way to test local changes quickly."}]},{"id":"blk-41147","kind":"heading","level":3,"spans":[{"id":"spn-46429","text":"B) Built executable mode (recommended for stable deployment)"}]},{"id":"blk-41148","kind":"paragraph","spans":[{"id":"spn-46430","text":"Build the "},{"id":"spn-46431","marks":["code"],"text":"graphonomous"},{"id":"spn-46432","text":" executable:"}]},{"id":"blk-41149","kind":"paragraph","spans":[{"id":"spn-46433","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-41150","kind":"paragraph","spans":[{"id":"spn-46434","text":"This creates:"}]},{"id":"blk-41151","kind":"paragraph","spans":[{"id":"spn-46435","text":"./graphonomous"}]},{"id":"blk-41152","kind":"paragraph","spans":[{"id":"spn-46436","text":"---"}]},{"id":"blk-41153","kind":"heading","level":2,"spans":[{"id":"spn-46437","text":"3) Quick local run check (recommended)"}]},{"id":"blk-41154","kind":"paragraph","spans":[{"id":"spn-46438","text":"Before wiring Zed, verify the command starts."}]},{"id":"blk-41155","kind":"paragraph","spans":[{"id":"spn-46439","text":"If using fast dev mode:"}]},{"id":"blk-41156","kind":"paragraph","spans":[{"id":"spn-46440","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--help\"])'"}]},{"id":"blk-41157","kind":"paragraph","spans":[{"id":"spn-46441","text":"If using built executable mode:"}]},{"id":"blk-41158","kind":"paragraph","spans":[{"id":"spn-46442","text":"./graphonomous --help"}]},{"id":"blk-41159","kind":"paragraph","spans":[{"id":"spn-46443","text":"Then run server mode (stdio MCP transport)."}]},{"id":"blk-41160","kind":"paragraph","spans":[{"id":"spn-46444","text":"Fast dev mode:"}]},{"id":"blk-41161","kind":"paragraph","spans":[{"id":"spn-46445","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-41162","kind":"paragraph","spans":[{"id":"spn-46446","text":"Built executable mode:"}]},{"id":"blk-41163","kind":"paragraph","spans":[{"id":"spn-46447","text":"./graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-41164","kind":"paragraph","spans":[{"id":"spn-46448","text":"Notes:"}]},{"id":"blk-41165","items":[{"blocks":[{"id":"blk-41167","kind":"paragraph","spans":[{"id":"spn-46449","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-46450","text":" is the safest default for constrained laptops."}]}],"id":"blk-41166","kind":"list-item"},{"blocks":[{"id":"blk-41169","kind":"paragraph","spans":[{"id":"spn-46451","text":"Press "},{"id":"spn-46452","marks":["code"],"text":"Ctrl+C"},{"id":"spn-46453","text":" to stop."}]}],"id":"blk-41168","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41170","kind":"heading","level":3,"spans":[{"id":"spn-46454","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-41171","kind":"paragraph","spans":[{"id":"spn-46455","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-41172","kind":"paragraph","spans":[{"id":"spn-46456","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-41173","kind":"paragraph","spans":[{"id":"spn-46457","text":"What it validates: 1. "},{"id":"spn-46458","marks":["code"],"text":"initialize"},{"id":"spn-46459","text":" handshake succeeds 2. "},{"id":"spn-46460","marks":["code"],"text":"notifications/initialized"},{"id":"spn-46461","text":" is accepted 3. "},{"id":"spn-46462","marks":["code"],"text":"tools/list"},{"id":"spn-46463","text":" responds 4. "},{"id":"spn-46464","marks":["code"],"text":"resources/list"},{"id":"spn-46465","text":" responds 5. response latencies stay within thresholds"}]},{"id":"blk-41174","kind":"paragraph","spans":[{"id":"spn-46466","text":"Useful variants:"}]},{"id":"blk-41175","kind":"paragraph","spans":[{"id":"spn-46467","text":"# verbose stderr while testing python scripts/mcp_smoke_test.py --cwd . --tee-stderr"}]},{"id":"blk-41176","kind":"paragraph","spans":[{"id":"spn-46468","text":"# stricter latency gates (example) python scripts/mcp_smoke_test.py --cwd . --max-initialize-ms 2500 --max-discovery-ms 2500"}]},{"id":"blk-41177","kind":"paragraph","spans":[{"id":"spn-46469","text":"---"}]},{"id":"blk-41178","kind":"heading","level":2,"spans":[{"id":"spn-46470","text":"4) Configure Zed ("},{"id":"spn-46471","marks":["code"],"text":"context_servers"},{"id":"spn-46472","text":")"}]},{"id":"blk-41179","kind":"paragraph","spans":[{"id":"spn-46473","text":"Open your Zed settings JSON and add one of the following."}]},{"id":"blk-41180","kind":"heading","level":3,"spans":[{"id":"spn-46474","text":"Option A: Built executable (recommended for stable use)"}]},{"id":"blk-41181","kind":"paragraph","spans":[{"id":"spn-46475","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"/absolute/path/to/ProjectAmp2/graphonomous/graphonomous\", \"args\": [ \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\" ], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\", \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-41182","kind":"paragraph","spans":[{"id":"spn-46476","text":"If "},{"id":"spn-46477","marks":["code"],"text":"graphonomous"},{"id":"spn-46478","text":" is on your "},{"id":"spn-46479","marks":["code"],"text":"PATH"},{"id":"spn-46480","text":", you can use:"}]},{"id":"blk-41183","kind":"paragraph","spans":[{"id":"spn-46481","text":"\"command\": \"graphonomous\""}]},{"id":"blk-41184","kind":"paragraph","spans":[{"id":"spn-46482","text":"instead of an absolute path."}]},{"id":"blk-41185","kind":"heading","level":3,"spans":[{"id":"spn-46483","text":"Option B: Fast dev mode with no compile"}]},{"id":"blk-41186","kind":"paragraph","spans":[{"id":"spn-46484","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"sh\", \"args\": [ \"-lc\", \"cd /absolute/path/to/ProjectAmp2/graphonomous && mix run --no-compile -e 'Graphonomous.CLI.main([\\\"--db\\\",\\\"~/.graphonomous/knowledge.db\\\",\\\"--embedder-backend\\\",\\\"fallback\\\"])'\" ], \"env\": { \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-41187","kind":"paragraph","spans":[{"id":"spn-46485","text":"Use Option B while actively changing code; switch to Option A for daily/stable usage."}]},{"id":"blk-41188","kind":"paragraph","spans":[{"id":"spn-46486","text":"---"}]},{"id":"blk-41189","kind":"heading","level":2,"spans":[{"id":"spn-46487","text":"4.1) Always-on skills prompt wiring (required for every chat)"}]},{"id":"blk-41190","kind":"paragraph","spans":[{"id":"spn-46488","text":"To make Graphonomous usage consistent in every chat, load the skills pack into your agent prompt context at chat start."}]},{"id":"blk-41191","kind":"paragraph","spans":[{"id":"spn-46489","text":"Skills live in the "},{"id":"spn-46490","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-46491","text":" repo. Reference docs are mirrored in "},{"id":"spn-46492","marks":["code"],"text":"docs/skills/"},{"id":"spn-46493","text":"."}]},{"id":"blk-41192","kind":"paragraph","spans":[{"id":"spn-46494","text":"Minimum required context:"}]},{"id":"blk-41193","kind":"paragraph","spans":[{"id":"spn-46495","text":"1. "},{"id":"spn-46496","marks":["code"],"text":"docs/skills/SKILLS.md"},{"id":"spn-46497","text":" 2. "},{"id":"spn-46498","marks":["code"],"text":"docs/skills/bootstrap.md"}]},{"id":"blk-41194","kind":"paragraph","spans":[{"id":"spn-46499","text":"Recommended full context:"}]},{"id":"blk-41195","items":[{"blocks":[{"id":"blk-41197","kind":"paragraph","spans":[{"id":"spn-46500","marks":["code"],"text":"docs/skills/retrieve.md"}]}],"id":"blk-41196","kind":"list-item"},{"blocks":[{"id":"blk-41199","kind":"paragraph","spans":[{"id":"spn-46501","marks":["code"],"text":"docs/skills/learn.md"}]}],"id":"blk-41198","kind":"list-item"},{"blocks":[{"id":"blk-41201","kind":"paragraph","spans":[{"id":"spn-46502","marks":["code"],"text":"docs/skills/deliberate.md"}]}],"id":"blk-41200","kind":"list-item"},{"blocks":[{"id":"blk-41203","kind":"paragraph","spans":[{"id":"spn-46503","marks":["code"],"text":"docs/skills/consolidate.md"}]}],"id":"blk-41202","kind":"list-item"},{"blocks":[{"id":"blk-41205","kind":"paragraph","spans":[{"id":"spn-46504","marks":["code"],"text":"docs/skills/goals.md"}]}],"id":"blk-41204","kind":"list-item"},{"blocks":[{"id":"blk-41207","kind":"paragraph","spans":[{"id":"spn-46505","marks":["code"],"text":"docs/skills/attention.md"}]}],"id":"blk-41206","kind":"list-item"},{"blocks":[{"id":"blk-41209","kind":"paragraph","spans":[{"id":"spn-46506","marks":["code"],"text":"docs/skills/workflows.md"}]}],"id":"blk-41208","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41210","kind":"paragraph","spans":[{"id":"spn-46507","text":"If your Zed workflow supports per-assistant system/developer instructions, include the SKILLS.md and bootstrap.md there so they are applied automatically each chat."}]},{"id":"blk-41211","kind":"paragraph","spans":[{"id":"spn-46508","text":"---"}]},{"id":"blk-41212","kind":"heading","level":2,"spans":[{"id":"spn-46509","text":"5) Validate in Zed"}]},{"id":"blk-41213","kind":"paragraph","spans":[{"id":"spn-46510","text":"1. Open the Agent panel. 2. Go to MCP/context server settings. 3. Confirm "},{"id":"spn-46511","marks":["code"],"text":"graphonomous"},{"id":"spn-46512","text":" is active (running indicator). 4. At the start of each new chat, load the prompt context from:"}]},{"id":"blk-41214","items":[{"blocks":[{"id":"blk-41216","kind":"paragraph","spans":[{"id":"spn-46513","marks":["code"],"text":"docs/skills/SKILLS.md"}]}],"id":"blk-41215","kind":"list-item"},{"blocks":[{"id":"blk-41218","kind":"paragraph","spans":[{"id":"spn-46514","marks":["code"],"text":"docs/skills/bootstrap.md"}]}],"id":"blk-41217","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41219","kind":"paragraph","spans":[{"id":"spn-46515","text":"5. For best results, also load additional skill files from "},{"id":"spn-46516","marks":["code"],"text":"docs/skills/"},{"id":"spn-46517","text":" (e.g., retrieve.md, learn.md, workflows.md). 6. Start the prompt and ask it to use Graphonomous tools explicitly, e.g.:"}]},{"id":"blk-41220","items":[{"blocks":[{"id":"blk-41222","kind":"paragraph","spans":[{"id":"spn-46518","text":"“Use "},{"id":"spn-46519","marks":["code"],"text":"graphonomous"},{"id":"spn-46520","text":" to "},{"id":"spn-46521","marks":["code"],"text":"retrieve(action: “context”, ...)"},{"id":"spn-46522","text":" before answering.”"}]}],"id":"blk-41221","kind":"list-item"},{"blocks":[{"id":"blk-41224","kind":"paragraph","spans":[{"id":"spn-46523","text":"“Use "},{"id":"spn-46524","marks":["code"],"text":"graphonomous"},{"id":"spn-46525","text":" to "},{"id":"spn-46526","marks":["code"],"text":"act(action: “store_node”, ...)"},{"id":"spn-46527","text":" for semantic memory.”"}]}],"id":"blk-41223","kind":"list-item"},{"blocks":[{"id":"blk-41226","kind":"paragraph","spans":[{"id":"spn-46528","text":"“Use "},{"id":"spn-46529","marks":["code"],"text":"graphonomous"},{"id":"spn-46530","text":" to "},{"id":"spn-46531","marks":["code"],"text":"learn(action: “from_outcome”, ...)"},{"id":"spn-46532","text":" for outcome feedback.”"}]}],"id":"blk-41225","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41227","kind":"paragraph","spans":[{"id":"spn-46533","text":"---"}]},{"id":"blk-41228","kind":"heading","level":2,"spans":[{"id":"spn-46534","text":"6) First-use workflow (fastest)"}]},{"id":"blk-41229","kind":"paragraph","spans":[{"id":"spn-46535","text":"1. Store a few nodes with "},{"id":"spn-46536","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-46537","text":". 2. Query them via "},{"id":"spn-46538","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-46539","text":". 3. Feed outcomes via "},{"id":"spn-46540","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-46541","text":". 4. Inspect runtime with "},{"id":"spn-46542","marks":["code"],"text":"query_graph"},{"id":"spn-46543","text":" and resource snapshots."}]},{"id":"blk-41230","kind":"paragraph","spans":[{"id":"spn-46544","text":"This gives you a full closed-loop memory flow without external integrations."}]},{"id":"blk-41231","kind":"paragraph","spans":[{"id":"spn-46545","text":"---"}]},{"id":"blk-41232","kind":"heading","level":2,"spans":[{"id":"spn-46546","text":"7) Optional: install command globally"}]},{"id":"blk-41233","kind":"paragraph","spans":[{"id":"spn-46547","text":"If you want Zed to use "},{"id":"spn-46548","marks":["code"],"text":"command: \"graphonomous\""},{"id":"spn-46549","text":" without absolute paths:"}]},{"id":"blk-41234","kind":"paragraph","spans":[{"id":"spn-46550","text":"sudo install -m 0755 ./graphonomous /usr/local/bin/graphonomous"}]},{"id":"blk-41235","kind":"paragraph","spans":[{"id":"spn-46551","text":"Then confirm:"}]},{"id":"blk-41236","kind":"paragraph","spans":[{"id":"spn-46552","text":"graphonomous --help"}]},{"id":"blk-41237","kind":"paragraph","spans":[{"id":"spn-46553","text":"---"}]},{"id":"blk-41238","kind":"heading","level":2,"spans":[{"id":"spn-46554","text":"8) Troubleshooting"}]},{"id":"blk-41239","kind":"heading","level":3,"spans":[{"id":"spn-46555","text":"Server does not start in Zed"}]},{"id":"blk-41240","items":[{"blocks":[{"id":"blk-41242","kind":"paragraph","spans":[{"id":"spn-46556","text":"Use absolute "},{"id":"spn-46557","marks":["code"],"text":"command"},{"id":"spn-46558","text":" path first."}]}],"id":"blk-41241","kind":"list-item"},{"blocks":[{"id":"blk-41244","kind":"paragraph","spans":[{"id":"spn-46559","text":"Verify executable permissions:"}]}],"id":"blk-41243","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41245","kind":"paragraph","spans":[{"id":"spn-46560","text":"chmod +x /absolute/path/to/graphonomous"}]},{"id":"blk-41246","items":[{"blocks":[{"id":"blk-41248","kind":"paragraph","spans":[{"id":"spn-46561","text":"Test the exact command manually in terminal."}]}],"id":"blk-41247","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41249","kind":"heading","level":3,"spans":[{"id":"spn-46562","text":"Path/database issues"}]},{"id":"blk-41250","items":[{"blocks":[{"id":"blk-41252","kind":"paragraph","spans":[{"id":"spn-46563","text":"Ensure parent dir exists:"}]}],"id":"blk-41251","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41253","kind":"paragraph","spans":[{"id":"spn-46564","text":"mkdir -p ~/.graphonomous"}]},{"id":"blk-41254","kind":"heading","level":3,"spans":[{"id":"spn-46565","text":"Heavy model/runtime pressure on laptop"}]},{"id":"blk-41255","items":[{"blocks":[{"id":"blk-41257","kind":"paragraph","spans":[{"id":"spn-46566","text":"Keep "},{"id":"spn-46567","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-46568","text":"."}]}],"id":"blk-41256","kind":"list-item"},{"blocks":[{"id":"blk-41259","kind":"paragraph","spans":[{"id":"spn-46569","text":"Keep default model unless you intentionally change it."}]}],"id":"blk-41258","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41260","kind":"heading","level":3,"spans":[{"id":"spn-46570","text":"Zed shows server but tools are not being used"}]},{"id":"blk-41261","items":[{"blocks":[{"id":"blk-41263","kind":"paragraph","spans":[{"id":"spn-46571","text":"Mention "},{"id":"spn-46572","marks":["code"],"text":"graphonomous"},{"id":"spn-46573","text":" by name in your prompt."}]}],"id":"blk-41262","kind":"list-item"},{"blocks":[{"id":"blk-41265","kind":"paragraph","spans":[{"id":"spn-46574","text":"Ask explicitly to call a specific tool ("},{"id":"spn-46575","marks":["code"],"text":"store_node"},{"id":"spn-46576","text":", "},{"id":"spn-46577","marks":["code"],"t