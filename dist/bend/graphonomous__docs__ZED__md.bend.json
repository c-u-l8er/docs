{"bendscript":"0.1","blocks":[{"id":"blk-65045","kind":"heading","level":1,"spans":[{"id":"spn-95312","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-65046","kind":"paragraph","spans":[{"id":"spn-95313","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-95314","marks":["bold"],"text":"Zed"},{"id":"spn-95315","text":" with a working local setup."}]},{"id":"blk-65047","kind":"heading","level":2,"spans":[{"id":"spn-95316","text":"1) Prerequisites"}]},{"id":"blk-65048","items":[{"blocks":[{"id":"blk-65050","kind":"paragraph","spans":[{"id":"spn-95317","text":"Elixir "},{"id":"spn-95318","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-65049","kind":"list-item"},{"blocks":[{"id":"blk-65052","kind":"paragraph","spans":[{"id":"spn-95319","text":"Erlang/OTP "},{"id":"spn-95320","marks":["code"],"text":"27.x"}]}],"id":"blk-65051","kind":"list-item"},{"blocks":[{"id":"blk-65054","kind":"paragraph","spans":[{"id":"spn-95321","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-65053","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65055","kind":"paragraph","spans":[{"id":"spn-95322","text":"From the project root:"}]},{"id":"blk-65056","kind":"paragraph","spans":[{"id":"spn-95323","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-65057","kind":"heading","level":2,"spans":[{"id":"spn-95324","text":"2) Choose a launch mode"}]},{"id":"blk-65058","kind":"paragraph","spans":[{"id":"spn-95325","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-65059","kind":"heading","level":3,"spans":[{"id":"spn-95326","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-65060","kind":"paragraph","spans":[{"id":"spn-95327","text":"Use Mix with no compile step:"}]},{"id":"blk-65061","kind":"paragraph","spans":[{"id":"spn-95328","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-65062","kind":"paragraph","span