{"bendscript":"0.1","blocks":[{"id":"blk-40531","kind":"heading","level":1,"spans":[{"id":"spn-44606","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-40532","kind":"paragraph","spans":[{"id":"spn-44607","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-44608","marks":["bold"],"text":"Zed"},{"id":"spn-44609","text":" with a working local setup."}]},{"id":"blk-40533","kind":"paragraph","spans":[{"id":"spn-44610","text":"---"}]},{"id":"blk-40534","kind":"heading","level":2,"spans":[{"id":"spn-44611","text":"1) Prerequisites"}]},{"id":"blk-40535","items":[{"blocks":[{"id":"blk-40537","kind":"paragraph","spans":[{"id":"spn-44612","text":"Elixir "},{"id":"spn-44613","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-40536","kind":"list-item"},{"blocks":[{"id":"blk-40539","kind":"paragraph","spans":[{"id":"spn-44614","text":"Erlang/OTP "},{"id":"spn-44615","marks":["code"],"text":"27.x"}]}],"id":"blk-40538","kind":"list-item"},{"blocks":[{"id":"blk-40541","kind":"paragraph","spans":[{"id":"spn-44616","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-40540","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40542","kind":"paragraph","spans":[{"id":"spn-44617","text":"From the project root:"}]},{"id":"blk-40543","kind":"paragraph","spans":[{"id":"spn-44618","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-40544","kind":"paragraph","spans":[{"id":"spn-44619","text":"---"}]},{"id":"blk-40545","kind":"heading","level":2,"spans":[{"id":"spn-44620","text":"2) Choose a launch mode"}]},{"id":"blk-40546","kind":"paragraph","spans":[{"id":"spn-44621","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-40547","kind":"heading","level":3,"spans":[{"id":"spn-44622","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-40548","kind":"paragraph","spans":[{"id":"spn-44623","text":"Use Mix with no compile step:"}]},{"id":"blk-40549","kind":"paragraph","spans":[{"id":"spn-44624","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-40550","kind":"paragraph","spans":[{"id":"spn-44625","text":"This is the easiest way to test local changes quickly."}]},{"id":"blk-40551","kind":"heading","level":3,"spans":[{"id":"spn-44626","text":"B) Built executable mode (recommended for stable deployment)"}]},{"id":"blk-40552","kind":"paragraph","spans":[{"id":"spn-44627","text":"Build the "},{"id":"spn-44628","marks":["code"],"text":"graphonomous"},{"id":"spn-44629","text":" executable:"}]},{"id":"blk-40553","kind":"paragraph","spans":[{"id":"spn-44630","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-40554","kind":"paragraph","spans":[{"id":"spn-44631","text":"This creates:"}]},{"id":"blk-40555","kind":"paragraph","spans":[{"id":"spn-44632","text":"./graphonomous"}]},{"id":"blk-40556","kind":"paragraph","spans":[{"id":"spn-44633","text":"---"}]},{"id":"blk-40557","kind":"heading","level":2,"spans":[{"id":"spn-44634","text":"3) Quick local run check (recommended)"}]},{"id":"blk-40558","kind":"paragraph","spans":[{"id":"spn-44635","text":"Before wiring Zed, verify the command starts."}]},{"id":"blk-40559","kind":"paragraph","spans":[{"id":"spn-44636","text":"If using fast dev mode:"}]},{"id":"blk-40560","kind":"paragraph","spans":[{"id":"spn-44637","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--help\"])'"}]},{"id":"blk-40561","kind":"paragraph","spans":[{"id":"spn-44638","text":"If using built executable mode:"}]},{"id":"blk-40562","kind":"paragraph","spans":[{"id":"spn-44639","text":"./graphonomous --help"}]},{"id":"blk-40563","kind":"paragraph","spans":[{"id":"spn-44640","text":"Then run server mode (stdio MCP transport)."}]},{"id":"blk-40564","kind":"paragraph","spans":[{"id":"spn-44641","text":"Fast dev mode:"}]},{"id":"blk-40565","kind":"paragraph","spans":[{"id":"spn-44642","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-40566","kind":"paragraph","spans":[{"id":"spn-44643","text":"Built executable mode:"}]},{"id":"blk-40567","kind":"paragraph","spans":[{"id":"spn-44644","text":"./graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-40568","kind":"paragraph","spans":[{"id":"spn-44645","text":"Notes:"}]},{"id":"blk-40569","items":[{"blocks":[{"id":"blk-40571","kind":"paragraph","spans":[{"id":"spn-44646","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-44647","text":" is the safest default for constrained laptops."}]}],"id":"blk-40570","kind":"list-item"},{"blocks":[{"id":"blk-40573","kind":"paragraph","spans":[{"id":"spn-44648","text":"Press "},{"id":"spn-44649","marks":["code"],"text":"Ctrl+C"},{"id":"spn-44650","text":" to stop."}]}],"id":"blk-40572","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40574","kind":"heading","level":3,"spans":[{"id":"spn-44651","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-40575","kind":"paragraph","spans":[{"id":"spn-44652","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-40576","kind":"paragraph","spans":[{"id":"spn-44653","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-40577","kind":"paragraph","spans":[{"id":"spn-44654","text":"What it validates: 1. "},{"id":"spn-44655","marks":["code"],"text":"initialize"},{"id":"spn-44656","text":" handshake succeeds 2. "},{"id":"spn-44657","marks":["code"],"text":"notifications/initialized"},{"id":"spn-44658","text":" is accepted 3. "},{"id":"spn-44659","marks":["code"],"text":"tools/list"},{"id":"spn-44660","text":" responds 4. "},{"id":"spn-44661","marks":["code"],"text":"resources/list"},{"id":"spn-44662","text":" responds 5. response latencies stay within thresholds"}]},{"id":"blk-40578","kind":"paragraph","spans":[{"id":"spn-44663","text":"Useful variants:"}]},{"id":"blk-40579","kind":"paragraph","spans":[{"id":"spn-44664","text":"# verbose stderr while testing python scripts/mcp_smoke_test.py --cwd . --tee-stderr"}]},{"id":"blk-40580","kind":"paragraph","spans":[{"id":"spn-44665","text":"# stricter latency gates (example) python scripts/mcp_smoke_test.py --cwd . --max-initialize-ms 2500 --max-discovery-ms 2500"}]},{"id":"blk-40581","kind":"paragraph","spans":[{"id":"spn-44666","text":"---"}]},{"id":"blk-40582","kind":"heading","level":2,"spans":[{"id":"spn-44667","text":"4) Configure Zed ("},{"id":"spn-44668","marks":["code"],"text":"context_servers"},{"id":"spn-44669","text":")"}]},{"id":"blk-40583","kind":"paragraph","spans":[{"id":"spn-44670","text":"Open your Zed settings JSON and add one of the following."}]},{"id":"blk-40584","kind":"heading","level":3,"spans":[{"id":"spn-44671","text":"Option A: Built executable (recommended for stable use)"}]},{"id":"blk-40585","kind":"paragraph","spans":[{"id":"spn-44672","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"/absolute/path/to/ProjectAmp2/graphonomous/graphonomous\", \"args\": [ \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\" ], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\", \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-40586","kind":"paragraph","spans":[{"id":"spn-44673","text":"If "},{"id":"spn-44674","marks":["code"],"text":"graphonomous"},{"id":"spn-44675","text":" is on your "},{"id":"spn-44676","marks":["code"],"text":"PATH"},{"id":"spn-44677","text":", you can use:"}]},{"id":"blk-40587","kind":"paragraph","spans":[{"id":"spn-44678","text":"\"command\": \"graphonomous\""}]},{"id":"blk-40588","kind":"paragraph","spans":[{"id":"spn-44679","text":"instead of an absolute path."}]},{"id":"blk-40589","kind":"heading","level":3,"spans":[{"id":"spn-44680","text":"Option B: Fast dev mode with no compile"}]},{"id":"blk-40590","kind":"paragraph","spans":[{"id":"spn-44681","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"sh\", \"args\": [ \"-lc\", \"cd /absolute/path/to/ProjectAmp2/graphonomous && mix run --no-compile -e 'Graphonomous.CLI.main([\\\"--db\\\",\\\"~/.graphonomous/knowledge.db\\\",\\\"--embedder-backend\\\",\\\"fallback\\\"])'\" ], \"env\": { \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-40591","kind":"paragraph","spans":[{"id":"spn-44682","text":"Use Option B while actively changing code; switch to Option A for daily/stable usage."}]},{"id":"blk-40592","kind":"paragraph","spans":[{"id":"spn-44683","text":"---"}]},{"id":"blk-40593","kind":"heading","level":2,"spans":[{"id":"spn-44684","text":"4.1) Always-on skills prompt wiring (required for every chat)"}]},{"id":"blk-40594","kind":"paragraph","spans":[{"id":"spn-44685","text":"To make Graphonomous usage consistent in every chat, load the skills pack into your agent prompt context at chat start."}]},{"id":"blk-40595","kind":"paragraph","spans":[{"id":"spn-44686","text":"Skills live in the "},{"id":"spn-44687","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-44688","text":" repo. Reference docs are mirrored in "},{"id":"spn-44689","marks":["code"],"text":"docs/skills/"},{"id":"spn-44690","text":"."}]},{"id":"blk-40596","kind":"paragraph","spans":[{"id":"spn-44691","text":"Minimum required context:"}]},{"id":"blk-40597","kind":"paragraph","spans":[{"id":"spn-44692","text":"1. "},{"id":"spn-44693","marks":["code"],"text":"docs/skills/SKILLS.md"},{"id":"spn-44694","text":" 2. "},{"id":"spn-44695","marks":["code"],"text":"docs/skills/bootstrap.md"}]},{"id":"blk-40598","kind":"paragraph","spans":[{"id":"spn-44696","text":"Recommended full context:"}]},{"id":"blk-40599","items":[{"blocks":[{"id":"blk-40601","kind":"paragraph","spans":[{"id":"spn-44697","marks":["code"],"text":"docs/skills/retrieve.md"}]}],"id":"blk-40600","kind":"list-item"},{"blocks":[{"id":"blk-40603","kind":"paragraph","spans":[{"id":"spn-44698","marks":["code"],"text":"docs/skills/learn.md"}]}],"id":"blk-40602","kind":"list-item"},{"blocks":[{"id":"blk-40605","kind":"paragraph","spans":[{"id":"spn-44699","marks":["code"],"text":"docs/skills/deliberate.md"}]}],"id":"blk-40604","kind":"list-item"},{"blocks":[{"id":"blk-40607","kind":"paragraph","spans":[{"id":"spn-44700","marks":["code"],"text":"docs/skills/consolidate.md"}]}],"id":"blk-40606","kind":"list-item"},{"blocks":[{"id":"blk-40609","kind":"paragraph","spans":[{"id":"spn-44701","marks":["code"],"text":"docs/skills/goals.md"}]}],"id":"blk-40608","kind":"list-item"},{"blocks":[{"id":"blk-40611","kind":"paragraph","spans":[{"id":"spn-44702","marks":["code"],"text":"docs/skills/attention.md"}]}],"id":"blk-40610","kind":"list-item"},{"blocks":[{"id":"blk-40613","kind":"paragraph","spans":[{"id":"spn-44703","marks":["code"],"text":"docs/skills/workflows.md"}]}],"id":"blk-40612","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40614","kind":"paragraph","spans":[{"id":"spn-44704","text":"If your Zed workflow supports per-assistant system/developer instructions, include the SKILLS.md and bootstrap.md there so they are applied automatically each chat."}]},{"id":"blk-40615","kind":"paragraph","spans":[{"id":"spn-44705","text":"---"}]},{"id":"blk-40616","kind":"heading","level":2,"spans":[{"id":"spn-44706","text":"5) Validate in Zed"}]},{"id":"blk-40617","kind":"paragraph","spans":[{"id":"spn-44707","text":"1. Open the Agent panel. 2. Go to MCP/context server settings. 3. Confirm "},{"id":"spn-44708","marks":["code"],"text":"graphonomous"},{"id":"spn-44709","text":" is active (running indicator). 4. At the start of each new chat, load the prompt context from:"}]},{"id":"blk-40618","items":[{"blocks":[{"id":"blk-40620","kind":"paragraph","spans":[{"id":"spn-44710","marks":["code"],"text":"docs/skills/SKILLS.md"}]}],"id":"blk-40619","kind":"list-item"},{"blocks":[{"id":"blk-40622","kind":"paragraph","spans":[{"id":"spn-44711","marks":["code"],"text":"docs/skills/bootstrap.md"}]}],"id":"blk-40621","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40623","kind":"paragraph","spans":[{"id":"spn-44712","text":"5. For best results, also load additional skill files from "},{"id":"spn-44713","marks":["code"],"text":"docs/skills/"},{"id":"spn-44714","text":" (e.g., retrieve.md, learn.md, workflows.md). 6. Start the prompt and ask it to use Graphonomous tools explicitly, e.g.:"}]},{"id":"blk-40624","items":[{"blocks":[{"id":"blk-40626","kind":"paragraph","spans":[{"id":"spn-44715","text":"“Use "},{"id":"spn-44716","marks":["code"],"text":"graphonomous"},{"id":"spn-44717","text":" to "},{"id":"spn-44718","marks":["code"],"text":"retrieve(action: “context”, ...)"},{"id":"spn-44719","text":" before answering.”"}]}],"id":"blk-40625","kind":"list-item"},{"blocks":[{"id":"blk-40628","kind":"paragraph","spans":[{"id":"spn-44720","text":"“Use "},{"id":"spn-44721","marks":["code"],"text":"graphonomous"},{"id":"spn-44722","text":" to "},{"id":"spn-44723","marks":["code"],"text":"act(action: “store_node”, ...)"},{"id":"spn-44724","text":" for semantic memory.”"}]}],"id":"blk-40627","kind":"list-item"},{"blocks":[{"id":"blk-40630","kind":"paragraph","spans":[{"id":"spn-44725","text":"“Use "},{"id":"spn-44726","marks":["code"],"text":"graphonomous"},{"id":"spn-44727","text":" to "},{"id":"spn-44728","marks":["code"],"text":"learn(action: “from_outcome”, ...)"},{"id":"spn-44729","text":" for outcome feedback.”"}]}],"id":"blk-40629","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40631","kind":"paragraph","spans":[{"id":"spn-44730","text":"---"}]},{"id":"blk-40632","kind":"heading","level":2,"spans":[{"id":"spn-44731","text":"6) First-use workflow (fastest)"}]},{"id":"blk-40633","kind":"paragraph","spans":[{"id":"spn-44732","text":"1. Store a few nodes with "},{"id":"spn-44733","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-44734","text":". 2. Query them via "},{"id":"spn-44735","marks":["code"],"tex