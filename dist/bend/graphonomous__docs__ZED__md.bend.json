-db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-65079","kind":"paragraph","spans":[{"id":"spn-95348","text":"Notes:"}]},{"id":"blk-65080","items":[{"blocks":[{"id":"blk-65082","kind":"paragraph","spans":[{"id":"spn-95349","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-95350","text":" is the safest default for constrained laptops."}]}],"id":"blk-65081","kind":"list-item"},{"blocks":[{"id":"blk-65084","kind":"paragraph","spans":[{"id":"spn-95351","text":"Press "},{"id":"spn-95352","marks":["code"],"text":"Ctrl+C"},{"id":"spn-95353","text":" to stop."}]}],"id":"blk-65083","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65085","kind":"heading","level":3,"spans":[{"id":"spn-95354","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-65086","kind":"paragraph","spans":[{"id":"spn-95355","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-65087","kind":"paragraph","spans":[{"id":"spn-95356","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-65088","kind":"paragraph","spans":[{"id":"spn-95357","text":"What it validates:"}]},{"id":"blk-65089","items":[{"blocks":[{"id":"blk-65091","kind":"paragraph","spans":[{"id":"spn-95358","marks":["code"],"text":"initialize"},{"id":"spn-95359","text":" handshake succeeds"}]}],"id":"blk-65090","kind":"list-item"},{"blocks":[{"id":"blk-65093","kind":"paragraph","spans":[{"id":"spn-95360","marks":["code"],"text":"notifications/initialized"},{"id":"spn-95361","text":" is accepted"}]}],"id":"blk-65092","kind":"list-item"},{"blocks":[{"id":"blk-65095","kind":"paragraph","spans":[{"id":"spn-95362","marks":["code"],"text":"tools/list"},{"id":"spn-95363","text":" responds"}]}],"id":"blk-65094","kind":"list-item"},{"blocks":[{"id":"blk-65097","kind":"paragraph","spans":[{"id":"spn-95364","marks":["code"],"text":"resources/list"},{"id":"spn-95365","text":" responds"}]}],"id":"blk-65096","kind":"list-item"},{"blocks":[{"id":"blk-65099","kind":"p