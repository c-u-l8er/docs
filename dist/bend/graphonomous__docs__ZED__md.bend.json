{"bendscript":"0.1","blocks":[{"id":"blk-72402","kind":"heading","level":1,"spans":[{"id":"spn-134675","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-72403","kind":"paragraph","spans":[{"id":"spn-134676","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-134677","marks":["bold"],"text":"Zed"},{"id":"spn-134678","text":" with a working local setup."}]},{"id":"blk-72404","kind":"heading","level":2,"spans":[{"id":"spn-134679","text":"1) Prerequisites"}]},{"id":"blk-72405","items":[{"blocks":[{"id":"blk-72407","kind":"paragraph","spans":[{"id":"spn-134680","text":"Elixir "},{"id":"spn-134681","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-72406","kind":"list-item"},{"blocks":[{"id":"blk-72409","kind":"paragraph","spans":[{"id":"spn-134682","text":"Erlang/OTP "},{"id":"spn-134683","marks":["code"],"text":"27.x"}]}],"id":"blk-72408","kind":"list-item"},{"blocks":[{"id":"blk-72411","kind":"paragraph","spans":[{"id":"spn-134684","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-72410","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72412","kind":"paragraph","spans":[{"id":"spn-134685","text":"From the project root:"}]},{"id":"blk-72413","kind":"paragraph","spans":[{"id":"spn-134686","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-72414","kind":"heading","level":2,"spans":[{"id":"spn-134687","text":"2) Choose a launch mode"}]},{"id":"blk-72415","kind":"paragraph","spans":[{"id":"spn-134688","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-72416","kind":"heading","level":3,"spans":[{"id":"spn-134689","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-72417","kind":"paragraph","spans":[{"id":"spn-134690","text":"Use Mix with no compile step:"}]},{"id":"blk-72418","kind":"paragraph","spans":[{"id":"spn-134691","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-72419","kind":"paragraph","spans":[{"id":"spn-134692","text":"This is the easiest way to test local changes quickly."}]},{"id":"blk-72420","kind":"heading","level":3,"spans":[{"id":"spn-134693","text":"B) Built executable mode (recommended for stable deployment)"}]},{"id":"blk-72421","kind":"paragraph","spans":[{"id":"spn-134694","text":"Build the "},{"id":"spn-134695","marks":["code"],"text":"graphonomous"},{"id":"spn-134696","text":" executable:"}]},{"id":"blk-72422","kind":"paragraph","spans":[{"id":"spn-134697","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-72423","kind":"paragraph","spans":[{"id":"spn-134698","text":"This creates:"}]},{"id":"blk-72424","kind":"paragraph","spans":[{"id":"spn-134699","text":"./graphonomous"}]},{"id":"blk-72425","kind":"heading","level":2,"spans":[{"id":"spn-134700","text":"3) Quick local run check (recommended)"}]},{"id":"blk-72426","kind":"paragraph","spans":[{"id":"spn-134701","text":"Before wiring Zed, verify the command starts."}]},{"id":"blk-72427","kind":"paragraph","spans":[{"id":"spn-134702","text":"If using fast dev mode:"}]},{"id":"blk-72428","kind":"paragraph","spans":[{"id":"spn-134703","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--help\"])'"}]},{"id":"blk-72429","kind":"paragraph","spans":[{"id":"spn-134704","text":"If using built executable mode:"}]},{"id":"blk-72430","kind":"paragraph","spans":[{"id":"spn-134705","text":"./graphonomous --help"}]},{"id":"blk-72431","kind":"paragraph","spans":[{"id":"spn-134706","text":"Then run server mode (stdio MCP transport)."}]},{"id":"blk-72432","kind":"paragraph","spans":[{"id":"spn-134707","text":"Fast dev mode:"}]},{"id":"blk-72433","kind":"paragraph","spans":[{"id":"spn-134708","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-72434","kind":"paragraph","spans":[{"id":"spn-134709","text":"Built executable mode:"}]},{"id":"blk-72435","kind":"paragraph","spans":[{"id":"spn-134710","text":"./graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-72436","kind":"paragraph","spans":[{"id":"spn-134711","text":"Notes:"}]},{"id":"blk-72437","items":[{"blocks":[{"id":"blk-72439","kind":"paragraph","spans":[{"id":"spn-134712","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-134713","text":" is the safest default for constrained laptops."}]}],"id":"blk-72438","kind":"list-item"},{"blocks":[{"id":"blk-72441","kind":"paragraph","spans":[{"id":"spn-134714","text":"Press "},{"id":"spn-134715","marks":["code"],"text":"Ctrl+C"},{"id":"spn-134716","text":" to stop."}]}],"id":"blk-72440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-72442","kind":"heading","level":3,"spans":[{"id":"spn-134717","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-72443","kind":"paragraph","spans":[{"id":"spn-134718","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-72444","kind":"paragraph","spans":[{"id":"spn-134719","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-72445","kind":"paragraph","spans":[{"id":"spn-134720","text":"What it validates:"}]},{"id":"blk-72446","items":[{"blocks":[{"id":"blk-72448","kind":"paragraph","spans":[{"id":"spn-134721","marks":["code"],"text":"initialize"},{"id":"spn-134722","text":" handshake succeeds"}]}],"id":"blk-72447","kind":"list-item"},{"blocks":[{"id":"blk-72450","kind":"paragraph","spans":[{"id":"spn-134723","marks":["code"],"text":"notifications/initialized"},{"id":"spn-134724","text":" is accepted"}]}],"id":"blk-72449","kind":"list-item"},{"blocks":[{"id":"blk-72452","kind":"paragraph","spans":[{"id":"spn-134725","marks":["code"],"text":"tools/list"},{"id":"spn-134726","text":" responds"}]}],"id":"blk-72451","kind":"list-item"},{"blocks":[{"id":"blk-72454","kind":"paragraph","spans":[{"id":"spn-134727","marks":["code"],"text":"resources/list"},{"id":"spn-134728","text":" responds"}]}],"id":"blk-72453","kind":"list-item"},{"blocks":[{"id":"blk-72456","kind":"paragraph","spans":[{"id":"spn-134729","text":"response latencies stay within thresholds"}]}],"id":"blk-72455","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-72457","kind":"paragraph","spans":[{"id":"spn-134730","text":"Useful variants:"}]},{"id":"blk-72458","kind":"paragraph","spans":[{"id":"spn-134731","text":"# verbose stderr while testing python scripts/mcp_smoke_test.py --cwd . --tee-stderr"}]},{"id":"blk-72459","kind":"paragraph","spans":[{"id":"spn-134732","text":"# stricter latency gates (example) python scripts/mcp_smoke_test.py --cwd . --max-initialize-ms 2500 --max-discovery-ms 2500"}]},{"id":"blk-72460","kind":"heading","level":2,"spans":[{"id":"spn-134733","text":"4) Configure Zed ("},{"id":"spn-134734","marks":["code"],"text":"context_servers"},{"id":"spn-134735","text":")"}]},{"id":"blk-72461","kind":"paragraph","spans":[{"id":"spn-134736","text":"Open your Zed settings JSON and add one of the following."}]},{"id":"blk-72462","kind":"heading","level":3,"spans":[{"id":"spn-134737","text":"Option A: Built executable (recommended for stable use)"}]},{"id":"blk-72463","kind":"paragraph","spans":[{"id":"spn-134738","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"/absolute/path/to/ProjectAmp2/graphonomous/graphonomous\", \"args\": [ \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\" ], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\", \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-72464","kind":"paragraph","spans":[{"id":"spn-134739","text":"If "},{"id":"spn-134740","marks":["code"],"text":"graphonomous"},{"id":"spn-134741","text":" is on your "},{"id":"spn-134742","marks":["code"],"text":"PATH"},{"id":"spn-134743","text":", you can use:"}]},{"id":"blk-72465","kind":"paragraph","spans":[{"id":"spn-134744","text":"\"command\": \"graphonomous\""}]},{"id":"blk-72466","kind":"paragraph","spans":[{"id":"spn-