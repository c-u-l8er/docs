k-40759","kind":"paragraph","spans":[{"id":"spn-45386","text":"chmod +x /absolute/path/to/graphonomous"}]},{"id":"blk-40760","items":[{"blocks":[{"id":"blk-40762","kind":"paragraph","spans":[{"id":"spn-45387","text":"Test the exact command manually in terminal."}]}],"id":"blk-40761","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40763","kind":"heading","level":3,"spans":[{"id":"spn-45388","text":"Path/database issues"}]},{"id":"blk-40764","items":[{"blocks":[{"id":"blk-40766","kind":"paragraph","spans":[{"id":"spn-45389","text":"Ensure parent dir exists:"}]}],"id":"blk-40765","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40767","kind":"paragraph","spans":[{"id":"spn-45390","text":"mkdir -p ~/.graphonomous"}]},{"id":"blk-40768","kind":"heading","level":3,"spans":[{"id":"spn-45391","text":"Heavy model/runtime pressure on laptop"}]},{"id":"blk-40769","items":[{"blocks":[{"id":"blk-40771","kind":"paragraph","spans":[{"id":"spn-45392","text":"Keep "},{"id":"spn-45393","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-45394","text":"."}]}],"id":"blk-40770","kind":"list-item"},{"blocks":[{"id":"blk-40773","kind":"paragraph","spans":[{"id":"spn-45395","text":"Keep default model unless you intentionally change it."}]}],"id":"blk-40772","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-40774","kind":"heading","level":3,"spans":[{"id":"spn-45396","text":"Zed shows server but tools are not being used"}]},{"id":"blk-40775","items":[{"blocks":[{"id":"blk-40777","kind":"paragraph","spans":[{"id":"spn-45397","text":"Mention "},{"id":"spn-45398","marks":["code"],"text":"graphonomous"},{"id":"spn-45399","text":" by name in your prompt."}]}],"id":"blk-40776","kind":"list-item"},{"blocks":[{"id":"blk-40779","kind":"paragraph","spans":[{"id":"spn-45400","text":"Ask explicitly to call a specific tool ("},{"id":"spn-45401","marks":["code"],"text":"store_node"},{"id":"spn-45402","text":", "},{"id":"spn-45403","marks":["code"],"t