-db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-64942","kind":"paragraph","spans":[{"id":"spn-95147","text":"Notes:"}]},{"id":"blk-64943","items":[{"blocks":[{"id":"blk-64945","kind":"paragraph","spans":[{"id":"spn-95148","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-95149","text":" is the safest default for constrained laptops."}]}],"id":"blk-64944","kind":"list-item"},{"blocks":[{"id":"blk-64947","kind":"paragraph","spans":[{"id":"spn-95150","text":"Press "},{"id":"spn-95151","marks":["code"],"text":"Ctrl+C"},{"id":"spn-95152","text":" to stop."}]}],"id":"blk-64946","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-64948","kind":"heading","level":3,"spans":[{"id":"spn-95153","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-64949","kind":"paragraph","spans":[{"id":"spn-95154","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-64950","kind":"paragraph","spans":[{"id":"spn-95155","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-64951","kind":"paragraph","spans":[{"id":"spn-95156","text":"What it validates:"}]},{"id":"blk-64952","items":[{"blocks":[{"id":"blk-64954","kind":"paragraph","spans":[{"id":"spn-95157","marks":["code"],"text":"initialize"},{"id":"spn-95158","text":" handshake succeeds"}]}],"id":"blk-64953","kind":"list-item"},{"blocks":[{"id":"blk-64956","kind":"paragraph","spans":[{"id":"spn-95159","marks":["code"],"text":"notifications/initialized"},{"id":"spn-95160","text":" is accepted"}]}],"id":"blk-64955","kind":"list-item"},{"blocks":[{"id":"blk-64958","kind":"paragraph","spans":[{"id":"spn-95161","marks":["code"],"text":"tools/list"},{"id":"spn-95162","text":" responds"}]}],"id":"blk-64957","kind":"list-item"},{"blocks":[{"id":"blk-64960","kind":"paragraph","spans":[{"id":"spn-95163","marks":["code"],"text":"resources/list"},{"id":"spn-95164","text":" responds"}]}],"id":"blk-64959","kind":"list-item"},{"blocks":[{"id":"blk-64962","kind":"p