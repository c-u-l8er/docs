{"bendscript":"0.1","blocks":[{"id":"blk-65873","kind":"heading","level":1,"spans":[{"id":"spn-97925","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-65874","kind":"paragraph","spans":[{"id":"spn-97926","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-97927","marks":["bold"],"text":"Zed"},{"id":"spn-97928","text":" with a working local setup."}]},{"id":"blk-65875","kind":"heading","level":2,"spans":[{"id":"spn-97929","text":"1) Prerequisites"}]},{"id":"blk-65876","items":[{"blocks":[{"id":"blk-65878","kind":"paragraph","spans":[{"id":"spn-97930","text":"Elixir "},{"id":"spn-97931","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-65877","kind":"list-item"},{"blocks":[{"id":"blk-65880","kind":"paragraph","spans":[{"id":"spn-97932","text":"Erlang/OTP "},{"id":"spn-97933","marks":["code"],"text":"27.x"}]}],"id":"blk-65879","kind":"list-item"},{"blocks":[{"id":"blk-65882","kind":"paragraph","spans":[{"id":"spn-97934","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-65881","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65883","kind":"paragraph","spans":[{"id":"spn-97935","text":"From the project root:"}]},{"id":"blk-65884","kind":"paragraph","spans":[{"id":"spn-97936","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-65885","kind":"heading","level":2,"spans":[{"id":"spn-97937","text":"2) Choose a launch mode"}]},{"id":"blk-65886","kind":"paragraph","spans":[{"id":"spn-97938","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-65887","kind":"heading","level":3,"spans":[{"id":"spn-97939","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-65888","kind":"paragraph","spans":[{"id":"spn-97940","text":"Use Mix with no compile step:"}]},{"id":"blk-65889","kind":"paragraph","spans":[{"id":"spn-97941","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-65890","kind":"paragraph","spans":[{"id":"spn-97942","text":"This is the easiest way to test local changes quickly."}]},{"id":"blk-65891","kind":"heading","level":3,"spans":[{"id":"spn-97943","text":"B) Built executable mode (recommended for stable deployment)"}]},{"id":"blk-65892","kind":"paragraph","spans":[{"id":"spn-97944","text":"Build the "},{"id":"spn-97945","marks":["code"],"text":"graphonomous"},{"id":"spn-97946","text":" executable:"}]},{"id":"blk-65893","kind":"paragraph","spans":[{"id":"spn-97947","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-65894","kind":"paragraph","spans":[{"id":"spn-97948","text":"This creates:"}]},{"id":"blk-65895","kind":"paragraph","spans":[{"id":"spn-97949","text":"./graphonomous"}]},{"id":"blk-65896","kind":"heading","level":2,"spans":[{"id":"spn-97950","text":"3) Quick local run check (recommended)"}]},{"id":"blk-65897","kind":"paragraph","spans":[{"id":"spn-97951","text":"Before wiring Zed, verify the command starts."}]},{"id":"blk-65898","kind":"paragraph","spans":[{"id":"spn-97952","text":"If using fast dev mode:"}]},{"id":"blk-65899","kind":"paragraph","spans":[{"id":"spn-97953","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--help\"])'"}]},{"id":"blk-65900","kind":"paragraph","spans":[{"id":"spn-97954","text":"If using built executable mode:"}]},{"id":"blk-65901","kind":"paragraph","spans":[{"id":"spn-97955","text":"./graphonomous --help"}]},{"id":"blk-65902","kind":"paragraph","spans":[{"id":"spn-97956","text":"Then run server mode (stdio MCP transport)."}]},{"id":"blk-65903","kind":"paragraph","spans":[{"id":"spn-97957","text":"Fast dev mode:"}]},{"id":"blk-65904","kind":"paragraph","spans":[{"id":"spn-97958","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-65905","kind":"paragraph","spans":[{"id":"spn-97959","text":"Built executable mode:"}]},{"id":"blk-65906","kind":"paragraph","spans":[{"id":"spn-97960","text":"./graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-65907","kind":"paragraph","spans":[{"id":"spn-97961","text":"Notes:"}]},{"id":"blk-65908","items":[{"blocks":[{"id":"blk-65910","kind":"paragraph","spans":[{"id":"spn-97962","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-97963","text":" is the safest default for constrained laptops."}]}],"id":"blk-65909","kind":"list-item"},{"blocks":[{"id":"blk-65912","kind":"paragraph","spans":[{"id":"spn-97964","text":"Press "},{"id":"spn-97965","marks":["code"],"text":"Ctrl+C"},{"id":"spn-97966","text":" to stop."}]}],"id":"blk-65911","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65913","kind":"heading","level":3,"spans":[{"id":"spn-97967","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-65914","kind":"paragraph","spans":[{"id":"spn-97968","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-65915","kind":"paragraph","spans":[{"id":"spn-97969","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-65916","kind":"paragraph","spans":[{"id":"spn-97970","text":"What it validates:"}]},{"id":"blk-65917","items":[{"blocks":[{"id":"blk-65919","kind":"paragraph","spans":[{"id":"spn-97971","marks":["code"],"text":"initialize"},{"id":"spn-97972","text":" handshake succeeds"}]}],"id":"blk-65918","kind":"list-item"},{"blocks":[{"id":"blk-65921","kind":"paragraph","spans":[{"id":"spn-97973","marks":["code"],"text":"notifications/initialized"},{"id":"spn-97974","text":" is accepted"}]}],"id":"blk-65920","kind":"list-item"},{"blocks":[{"id":"blk-65923","kind":"paragraph","spans":[{"id":"spn-97975","marks":["code"],"text":"tools/list"},{"id":"spn-97976","text":" responds"}]}],"id":"blk-65922","kind":"list-item"},{"blocks":[{"id":"blk-65925","kind":"paragraph","spans":[{"id":"spn-97977","marks":["code"],"text":"resources/list"},{"id":"spn-97978","text":" responds"}]}],"id":"blk-65924","kind":"list-item"},{"blocks":[{"id":"blk-65927","kind":"paragraph","spans":[{"id":"spn-97979","text":"response latencies stay within thresholds"}]}],"id":"blk-65926","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-65928","kind":"paragraph","spans":[{"id":"spn-97980","text":"Useful variants:"}]},{"id":"blk-65929","kind":"paragraph","spans":[{"id":"spn-97981","text":"# verbose stderr while testing python scripts/mcp_smoke_test.py --cwd . --tee-stderr"}]},{"id":"blk-65930","kind":"paragraph","spans":[{"id":"spn-97982","text":"# stricter latency gates (example) python scripts/mcp_smoke_test.py --cwd . --max-initialize-ms 2500 --max-discovery-ms 2500"}]},{"id":"blk-65931","kind":"heading","level":2,"spans":[{"id":"spn-97983","text":"4) Configure Zed ("},{"id":"spn-97984","marks":["code"],"text":"context_servers"},{"id":"spn-97985","text":")"}]},{"id":"blk-65932","kind":"paragraph","spans":[{"id":"spn-97986","text":"Open your Zed settings JSON and add one of the following."}]},{"id":"blk-65933","kind":"heading","level":3,"spans":[{"id":"spn-97987","text":"Option A: Built executable (recommended for stable use)"}]},{"id":"blk-65934","kind":"paragraph","spans":[{"id":"spn-97988","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"/absolute/path/to/ProjectAmp2/graphonomous/graphonomous\", \"args\": [ \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\" ], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\", \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-65935","kind":"paragraph","spans":[{"id":"spn-97989","text":"If "},{"id":"spn-97990","marks":["code"],"text":"graphonomous"},{"id":"spn-97991","text":" is on your "},{"id":"spn-97992","marks":["code"],"text":"PATH"},{"id":"spn-97993","text":", you can use:"}]},{"id":"blk-65936","kind":"paragraph","spans":[{"id":"spn-97994","text":"\"command\": \"graphonomous\""}]},{"id":"blk-65937","kind":"paragraph","spans":[{"id":"spn-97995","text":"instead of an absolute path."}]},{"id":"blk-65938","kin