:"}]},{"id":"blk-65951","items":[{"blocks":[{"id":"blk-65953","kind":"paragraph","spans":[{"id":"spn-98010","marks":["code"],"text":"docs/skills/retrieve.md"}]}],"id":"blk-65952","kind":"list-item"},{"blocks":[{"id":"blk-65955","kind":"paragraph","spans":[{"id":"spn-98011","marks":["code"],"text":"docs/skills/learn.md"}]}],"id":"blk-65954","kind":"list-item"},{"blocks":[{"id":"blk-65957","kind":"paragraph","spans":[{"id":"spn-98012","marks":["code"],"text":"docs/skills/deliberate.md"}]}],"id":"blk-65956","kind":"list-item"},{"blocks":[{"id":"blk-65959","kind":"paragraph","spans":[{"id":"spn-98013","marks":["code"],"text":"docs/skills/consolidate.md"}]}],"id":"blk-65958","kind":"list-item"},{"blocks":[{"id":"blk-65961","kind":"paragraph","spans":[{"id":"spn-98014","marks":["code"],"text":"docs/skills/goals.md"}]}],"id":"blk-65960","kind":"list-item"},{"blocks":[{"id":"blk-65963","kind":"paragraph","spans":[{"id":"spn-98015","marks":["code"],"text":"docs/skills/attention.md"}]}],"id":"blk-65962","kind":"list-item"},{"blocks":[{"id":"blk-65965","kind":"paragraph","spans":[{"id":"spn-98016","marks":["code"],"text":"docs/skills/workflows.md"}]}],"id":"blk-65964","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-65966","kind":"paragraph","spans":[{"id":"spn-98017","text":"If your Zed workflow supports per-assistant system/developer instructions, include the SKILLS.md and bootstrap.md there so they are applied automatically each chat."}]},{"id":"blk-65967","kind":"heading","level":2,"spans":[{"id":"spn-98018","text":"5) Validate in Zed"}]},{"id":"blk-65968","items":[{"blocks":[{"id":"blk-65970","kind":"paragraph","spans":[{"id":"spn-98019","text":"Open the Agent panel."}]}],"id":"blk-65969","kind":"list-item"},{"blocks":[{"id":"blk-65972","kind":"paragraph","spans":[{"id":"spn-98020","text":"Go to MCP/context server settings."}]}],"id":"blk-65971","kind":"list-item"},{"blocks":[{"id":"blk-65974","kind":"paragraph","spans":[{"id":"spn-98021","text":"Confirm "},