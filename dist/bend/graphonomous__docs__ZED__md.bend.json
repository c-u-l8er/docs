{"bendscript":"0.1","blocks":[{"id":"blk-41613","kind":"heading","level":1,"spans":[{"id":"spn-47529","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-41614","kind":"paragraph","spans":[{"id":"spn-47530","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-47531","marks":["bold"],"text":"Zed"},{"id":"spn-47532","text":" with a working local setup."}]},{"id":"blk-41615","kind":"paragraph","spans":[{"id":"spn-47533","text":"---"}]},{"id":"blk-41616","kind":"heading","level":2,"spans":[{"id":"spn-47534","text":"1) Prerequisites"}]},{"id":"blk-41617","items":[{"blocks":[{"id":"blk-41619","kind":"paragraph","spans":[{"id":"spn-47535","text":"Elixir "},{"id":"spn-47536","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-41618","kind":"list-item"},{"blocks":[{"id":"blk-41621","kind":"paragraph","spans":[{"id":"spn-47537","text":"Erlang/OTP "},{"id":"spn-47538","marks":["code"],"text":"27.x"}]}],"id":"blk-41620","kind":"list-item"},{"blocks":[{"id":"blk-41623","kind":"paragraph","spans":[{"id":"spn-47539","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-41622","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41624","kind":"paragraph","spans":[{"id":"spn-47540","text":"From the project root:"}]},{"id":"blk-41625","kind":"paragraph","spans":[{"id":"spn-47541","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-41626","kind":"paragraph","spans":[{"id":"spn-47542","text":"---"}]},{"id":"blk-41627","kind":"heading","level":2,"spans":[{"id":"spn-47543","text":"2) Choose a launch mode"}]},{"id":"blk-41628","kind":"paragraph","spans":[{"id":"spn-47544","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-41629","kind":"heading","level":3,"spans":[{"id":"spn-47545","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-41630","kind":"paragraph","spans":[{"id":"spn-47546","text":"Use Mix with no compile step:"}]},{"id":"blk-41631","kind":"paragraph","spans":[{"id":"spn-47547","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-41632","kind":"paragraph","spans":[{"id":"spn-47548","text":"This is the easiest way to test local changes quickly."}]},{"id":"blk-41633","kind":"heading","level":3,"spans":[{"id":"spn-47549","text":"B) Built executable mode (recommended for stable deployment)"}]},{"id":"blk-41634","kind":"paragraph","spans":[{"id":"spn-47550","text":"Build the "},{"id":"spn-47551","marks":["code"],"text":"graphonomous"},{"id":"spn-47552","text":" executable:"}]},{"id":"blk-41635","kind":"paragraph","spans":[{"id":"spn-47553","text":"MIX_ENV=prod mix escript.build"}]},{"id":"blk-41636","kind":"paragraph","spans":[{"id":"spn-47554","text":"This creates:"}]},{"id":"blk-41637","kind":"paragraph","spans":[{"id":"spn-47555","text":"./graphonomous"}]},{"id":"blk-41638","kind":"paragraph","spans":[{"id":"spn-47556","text":"---"}]},{"id":"blk-41639","kind":"heading","level":2,"spans":[{"id":"spn-47557","text":"3) Quick local run check (recommended)"}]},{"id":"blk-41640","kind":"paragraph","spans":[{"id":"spn-47558","text":"Before wiring Zed, verify the command starts."}]},{"id":"blk-41641","kind":"paragraph","spans":[{"id":"spn-47559","text":"If using fast dev mode:"}]},{"id":"blk-41642","kind":"paragraph","spans":[{"id":"spn-47560","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--help\"])'"}]},{"id":"blk-41643","kind":"paragraph","spans":[{"id":"spn-47561","text":"If using built executable mode:"}]},{"id":"blk-41644","kind":"paragraph","spans":[{"id":"spn-47562","text":"./graphonomous --help"}]},{"id":"blk-41645","kind":"paragraph","spans":[{"id":"spn-47563","text":"Then run server mode (stdio MCP transport)."}]},{"id":"blk-41646","kind":"paragraph","spans":[{"id":"spn-47564","text":"Fast dev mode:"}]},{"id":"blk-41647","kind":"paragraph","spans":[{"id":"spn-47565","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-41648","kind":"paragraph","spans":[{"id":"spn-47566","text":"Built executable mode:"}]},{"id":"blk-41649","kind":"paragraph","spans":[{"id":"spn-47567","text":"./graphonomous --db ~/.graphonomous/knowledge.db --embedder-backend fallback"}]},{"id":"blk-41650","kind":"paragraph","spans":[{"id":"spn-47568","text":"Notes:"}]},{"id":"blk-41651","items":[{"blocks":[{"id":"blk-41653","kind":"paragraph","spans":[{"id":"spn-47569","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-47570","text":" is the safest default for constrained laptops."}]}],"id":"blk-41652","kind":"list-item"},{"blocks":[{"id":"blk-41655","kind":"paragraph","spans":[{"id":"spn-47571","text":"Press "},{"id":"spn-47572","marks":["code"],"text":"Ctrl+C"},{"id":"spn-47573","text":" to stop."}]}],"id":"blk-41654","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41656","kind":"heading","level":3,"spans":[{"id":"spn-47574","text":"MCP smoke test workflow (pre-deploy)"}]},{"id":"blk-41657","kind":"paragraph","spans":[{"id":"spn-47575","text":"Run this before deploying or updating your Zed config:"}]},{"id":"blk-41658","kind":"paragraph","spans":[{"id":"spn-47576","text":"python scripts/mcp_smoke_test.py --cwd ."}]},{"id":"blk-41659","kind":"paragraph","spans":[{"id":"spn-47577","text":"What it validates: 1. "},{"id":"spn-47578","marks":["code"],"text":"initialize"},{"id":"spn-47579","text":" handshake succeeds 2. "},{"id":"spn-47580","marks":["code"],"text":"notifications/initialized"},{"id":"spn-47581","text":" is accepted 3. "},{"id":"spn-47582","marks":["code"],"text":"tools/list"},{"id":"spn-47583","text":" responds 4. "},{"id":"spn-47584","marks":["code"],"text":"resources/list"},{"id":"spn-47585","text":" responds 5. response latencies stay within thresholds"}]},{"id":"blk-41660","kind":"paragraph","spans":[{"id":"spn-47586","text":"Useful variants:"}]},{"id":"blk-41661","kind":"paragraph","spans":[{"id":"spn-47587","text":"# verbose stderr while testing python scripts/mcp_smoke_test.py --cwd . --tee-stderr"}]},{"id":"blk-41662","kind":"paragraph","spans":[{"id":"spn-47588","text":"# stricter latency gates (example) python scripts/mcp_smoke_test.py --cwd . --max-initialize-ms 2500 --max-discovery-ms 2500"}]},{"id":"blk-41663","kind":"paragraph","spans":[{"id":"spn-47589","text":"---"}]},{"id":"blk-41664","kind":"heading","level":2,"spans":[{"id":"spn-47590","text":"4) Configure Zed ("},{"id":"spn-47591","marks":["code"],"text":"context_servers"},{"id":"spn-47592","text":")"}]},{"id":"blk-41665","kind":"paragraph","spans":[{"id":"spn-47593","text":"Open your Zed settings JSON and add one of the following."}]},{"id":"blk-41666","kind":"heading","level":3,"spans":[{"id":"spn-47594","text":"Option A: Built executable (recommended for stable use)"}]},{"id":"blk-41667","kind":"paragraph","spans":[{"id":"spn-47595","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"/absolute/path/to/ProjectAmp2/graphonomous/graphonomous\", \"args\": [ \"--db\", \"~/.graphonomous/knowledge.db\", \"--embedder-backend\", \"fallback\" ], \"env\": { \"GRAPHONOMOUS_EMBEDDING_MODEL\": \"sentence-transformers/all-MiniLM-L6-v2\", \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-41668","kind":"paragraph","spans":[{"id":"spn-47596","text":"If "},{"id":"spn-47597","marks":["code"],"text":"graphonomous"},{"id":"spn-47598","text":" is on your "},{"id":"spn-47599","marks":["code"],"text":"PATH"},{"id":"spn-47600","text":", you can use:"}]},{"id":"blk-41669","kind":"paragraph","spans":[{"id":"spn-47601","text":"\"command\": \"graphonomous\""}]},{"id":"blk-41670","kind":"paragraph","spans":[{"id":"spn-47602","text":"instead of an absolute path."}]},{"id":"blk-41671","kind":"heading","level":3,"spans":[{"id":"spn-47603","text":"Option B: Fast dev mode with no compile"}]},{"id":"blk-41672","kind":"paragraph","spans":[{"id":"spn-47604","text":"{ \"context_servers\": { \"graphonomous\": { \"command\": \"sh\", \"args\": [ \"-lc\", \"cd /absolute/path/to/ProjectAmp2/graphonomous && mix run --no-compile -e 'Graphonomous.CLI.main([\\\"--db\\\",\\\"~/.graphonomous/knowledge.db\\\",\\\"--embedder-backend\\\",\\\"fallback\\\"])'\" ], \"env\": { \"LOG_LEVEL\": \"info\" } } } }"}]},{"id":"blk-41673","kind":"paragraph","spans":[{"id":"spn-47605","text":"Use Option B while actively changing code; switch to Option A for daily/stable usage."}]},{"id":"blk-41674","kind":"paragraph","spans":[{"id":"spn-47606","text":"---"}]},{"id":"blk-41675","kind":"heading","level":2,"spans":[{"id":"spn-47607","text":"4.1) Always-on skills prompt wiring (required for every chat)"}]},{"id":"blk-41676","kind":"paragraph","spans":[{"id":"spn-47608","text":"To make Graphonomous usage consistent in every chat, load the skills pack into your agent prompt context at chat start."}]},{"id":"blk-41677","kind":"paragraph","spans":[{"id":"spn-47609","text":"Skills live in the "},{"id":"spn-47610","marks":[{"kind":"link","predicate":"cites","target":"https://github.com/c-u-l8er/ampersand-plugins"}],"text":"ampersand-plugins"},{"id":"spn-47611","text":" repo. Reference docs are mirrored in "},{"id":"spn-47612","marks":["code"],"text":"docs/skills/"},{"id":"spn-47613","text":"."}]},{"id":"blk-41678","kind":"paragraph","spans":[{"id":"spn-47614","text":"Minimum required context:"}]},{"id":"blk-41679","kind":"paragraph","spans":[{"id":"spn-47615","text":"1. "},{"id":"spn-47616","marks":["code"],"text":"docs/skills/SKILLS.md"},{"id":"spn-47617","text":" 2. "},{"id":"spn-47618","marks":["code"],"text":"docs/skills/bootstrap.md"}]},{"id":"blk-41680","kind":"paragraph","spans":[{"id":"spn-47619","text":"Recommended full context:"}]},{"id":"blk-41681","items":[{"blocks":[{"id":"blk-41683","kind":"paragraph","spans":[{"id":"spn-47620","marks":["code"],"text":"docs/skills/retrieve.md"}]}],"id":"blk-41682","kind":"list-item"},{"blocks":[{"id":"blk-41685","kind":"paragraph","spans":[{"id":"spn-47621","marks":["code"],"text":"docs/skills/learn.md"}]}],"id":"blk-41684","kind":"list-item"},{"blocks":[{"id":"blk-41687","kind":"paragraph","spans":[{"id":"spn-47622","marks":["code"],"text":"docs/skills/deliberate.md"}]}],"id":"blk-41686","kind":"list-item"},{"blocks":[{"id":"blk-41689","kind":"paragraph","spans":[{"id":"spn-47623","marks":["code"],"text":"docs/skills/consolidate.md"}]}],"id":"blk-41688","kind":"list-item"},{"blocks":[{"id":"blk-41691","kind":"paragraph","spans":[{"id":"spn-47624","marks":["code"],"text":"docs/skills/goals.md"}]}],"id":"blk-41690","kind":"list-item"},{"blocks":[{"id":"blk-41693","kind":"paragraph","spans":[{"id":"spn-47625","marks":["code"],"text":"docs/skills/attention.md"}]}],"id":"blk-41692","kind":"list-item"},{"blocks":[{"id":"blk-41695","kind":"paragraph","spans":[{"id":"spn-47626","marks":["code"],"text":"docs/skills/workflows.md"}]}],"id":"blk-41694","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41696","kind":"paragraph","spans":[{"id":"spn-47627","text":"If your Zed workflow supports per-assistant system/developer instructions, include the SKILLS.md and bootstrap.md there so they are applied automatically each chat."}]},{"id":"blk-41697","kind":"paragraph","spans":[{"id":"spn-47628","text":"---"}]},{"id":"blk-41698","kind":"heading","level":2,"spans":[{"id":"spn-47629","text":"5) Validate in Zed"}]},{"id":"blk-41699","kind":"paragraph","spans":[{"id":"spn-47630","text":"1. Open the Agent panel. 2. Go to MCP/context server settings. 3. Confirm "},{"id":"spn-47631","marks":["code"],"text":"graphonomous"},{"id":"spn-47632","text":" is active (running indicator). 4. At the start of each new chat, load the prompt context from:"}]},{"id":"blk-41700","items":[{"blocks":[{"id":"blk-41702","kind":"paragraph","spans":[{"id":"spn-47633","marks":["code"],"text":"docs/skills/SKILLS.md"}]}],"id":"blk-41701","kind":"list-item"},{"blocks":[{"id":"blk-41704","kind":"paragraph","spans":[{"id":"spn-47634","marks":["code"],"text":"docs/skills/bootstrap.md"}]}],"id":"blk-41703","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41705","kind":"paragraph","spans":[{"id":"spn-47635","text":"5. For best results, also load additional skill files from "},{"id":"spn-47636","marks":["code"],"text":"docs/skills/"},{"id":"spn-47637","text":" (e.g., retrieve.md, learn.md, workflows.md). 6. Start the prompt and ask it to use Graphonomous tools explicitly, e.g.:"}]},{"id":"blk-41706","items":[{"blocks":[{"id":"blk-41708","kind":"paragraph","spans":[{"id":"spn-47638","text":"“Use "},{"id":"spn-47639","marks":["code"],"text":"graphonomous"},{"id":"spn-47640","text":" to "},{"id":"spn-47641","marks":["code"],"text":"retrieve(action: “context”, ...)"},{"id":"spn-47642","text":" before answering.”"}]}],"id":"blk-41707","kind":"list-item"},{"blocks":[{"id":"blk-41710","kind":"paragraph","spans":[{"id":"spn-47643","text":"“Use "},{"id":"spn-47644","marks":["code"],"text":"graphonomous"},{"id":"spn-47645","text":" to "},{"id":"spn-47646","marks":["code"],"text":"act(action: “store_node”, ...)"},{"id":"spn-47647","text":" for semantic memory.”"}]}],"id":"blk-41709","kind":"list-item"},{"blocks":[{"id":"blk-41712","kind":"paragraph","spans":[{"id":"spn-47648","text":"“Use "},{"id":"spn-47649","marks":["code"],"text":"graphonomous"},{"id":"spn-47650","text":" to "},{"id":"spn-47651","marks":["code"],"text":"learn(action: “from_outcome”, ...)"},{"id":"spn-47652","text":" for outcome feedback.”"}]}],"id":"blk-41711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41713","kind":"paragraph","spans":[{"id":"spn-47653","text":"---"}]},{"id":"blk-41714","kind":"heading","level":2,"spans":[{"id":"spn-47654","text":"6) First-use workflow (fastest)"}]},{"id":"blk-41715","kind":"paragraph","spans":[{"id":"spn-47655","text":"1. Store a few nodes with "},{"id":"spn-47656","marks":["code"],"text":"act(action: \"store_node\", ...)"},{"id":"spn-47657","text":". 2. Query them via "},{"id":"spn-47658","marks":["code"],"text":"retrieve(action: \"context\", ...)"},{"id":"spn-47659","text":". 3. Feed outcomes via "},{"id":"spn-47660","marks":["code"],"text":"learn(action: \"from_outcome\", ...)"},{"id":"spn-47661","text":". 4. Inspect runtime with "},{"id":"spn-47662","marks":["code"],"text":"query_graph"},{"id":"spn-47663","text":" and resource snapshots."}]},{"id":"blk-41716","kind":"paragraph","spans":[{"id":"spn-47664","text":"This gives you a full closed-loop memory flow without external integrations."}]},{"id":"blk-41717","kind":"paragraph","spans":[{"id":"spn-47665","text":"---"}]},{"id":"blk-41718","kind":"heading","level":2,"spans":[{"id":"spn-47666","text":"7) Optional: install command globally"}]},{"id":"blk-41719","kind":"paragraph","spans":[{"id":"spn-47667","text":"If you want Zed to use "},{"id":"spn-47668","marks":["code"],"text":"command: \"graphonomous\""},{"id":"spn-47669","text":" without absolute paths:"}]},{"id":"blk-41720","kind":"paragraph","spans":[{"id":"spn-47670","text":"sudo install -m 0755 ./graphonomous /usr/local/bin/graphonomous"}]},{"id":"blk-41721","kind":"paragraph","spans":[{"id":"spn-47671","text":"Then confirm:"}]},{"id":"blk-41722","kind":"paragraph","spans":[{"id":"spn-47672","text":"graphonomous --help"}]},{"id":"blk-41723","kind":"paragraph","spans":[{"id":"spn-47673","text":"---"}]},{"id":"blk-41724","kind":"heading","level":2,"spans":[{"id":"spn-47674","text":"8) Troubleshooting"}]},{"id":"blk-41725","kind":"heading","level":3,"spans":[{"id":"spn-47675","text":"Server does not start in Zed"}]},{"id":"blk-41726","items":[{"blocks":[{"id":"blk-41728","kind":"paragraph","spans":[{"id":"spn-47676","text":"Use absolute "},{"id":"spn-47677","marks":["code"],"text":"command"},{"id":"spn-47678","text":" path first."}]}],"id":"blk-41727","kind":"list-item"},{"blocks":[{"id":"blk-41730","kind":"paragraph","spans":[{"id":"spn-47679","text":"Verify executable permissions:"}]}],"id":"blk-41729","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41731","kind":"paragraph","spans":[{"id":"spn-47680","text":"chmod +x /absolute/path/to/graphonomous"}]},{"id":"blk-41732","items":[{"blocks":[{"id":"blk-41734","kind":"paragraph","spans":[{"id":"spn-47681","text":"Test the exact command manually in terminal."}]}],"id":"blk-41733","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41735","kind":"heading","level":3,"spans":[{"id":"spn-47682","text":"Path/database issues"}]},{"id":"blk-41736","items":[{"blocks":[{"id":"blk-41738","kind":"paragraph","spans":[{"id":"spn-47683","text":"Ensure parent dir exists:"}]}],"id":"blk-41737","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41739","kind":"paragraph","spans":[{"id":"spn-47684","text":"mkdir -p ~/.graphonomous"}]},{"id":"blk-41740","kind":"heading","level":3,"spans":[{"id":"spn-47685","text":"Heavy model/runtime pressure on laptop"}]},{"id":"blk-41741","items":[{"blocks":[{"id":"blk-41743","kind":"paragraph","spans":[{"id":"spn-47686","text":"Keep "},{"id":"spn-47687","marks":["code"],"text":"--embedder-backend fallback"},{"id":"spn-47688","text":"."}]}],"id":"blk-41742","kind":"list-item"},{"blocks":[{"id":"blk-41745","kind":"paragraph","spans":[{"id":"spn-47689","text":"Keep default model unless you intentionally change it."}]}],"id":"blk-41744","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-41746","kind":"heading","level":3,"spans":[{"id":"spn-47690","text":"Zed shows server but tools are not being used"}]},{"id":"blk-41747","items":[{"blocks":[{"id":"blk-41749","kind":"paragraph","spans":[{"id":"spn-47691","text":"Mention "},{"id":"spn-47692","marks":["code"],"text":"graphonomous"},{"id":"spn-47693","text":" by name in your prompt."}]}],"id":"blk-41748","kind":"list-item"},{"blocks":[{"id":"blk-41751","kind":"paragraph","spans":[{"id":"spn-47694","text":"Ask explicitly to call a specific tool ("},{"id":"spn-47695","marks":["code"],"text":"store_node"},{"id":"spn-47696","text":", "},{"id":"spn-47697","marks":["code"],"t