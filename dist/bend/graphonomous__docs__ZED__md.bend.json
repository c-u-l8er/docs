{"bendscript":"0.1","blocks":[{"id":"blk-64908","kind":"heading","level":1,"spans":[{"id":"spn-95111","text":"Graphonomous + Zed MCP Setup Guide"}]},{"id":"blk-64909","kind":"paragraph","spans":[{"id":"spn-95112","text":"This guide shows you how to run Graphonomous as an MCP server in "},{"id":"spn-95113","marks":["bold"],"text":"Zed"},{"id":"spn-95114","text":" with a working local setup."}]},{"id":"blk-64910","kind":"heading","level":2,"spans":[{"id":"spn-95115","text":"1) Prerequisites"}]},{"id":"blk-64911","items":[{"blocks":[{"id":"blk-64913","kind":"paragraph","spans":[{"id":"spn-95116","text":"Elixir "},{"id":"spn-95117","marks":["code"],"text":"~> 1.17"}]}],"id":"blk-64912","kind":"list-item"},{"blocks":[{"id":"blk-64915","kind":"paragraph","spans":[{"id":"spn-95118","text":"Erlang/OTP "},{"id":"spn-95119","marks":["code"],"text":"27.x"}]}],"id":"blk-64914","kind":"list-item"},{"blocks":[{"id":"blk-64917","kind":"paragraph","spans":[{"id":"spn-95120","text":"Zed with Agent/AI features enabled"}]}],"id":"blk-64916","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-64918","kind":"paragraph","spans":[{"id":"spn-95121","text":"From the project root:"}]},{"id":"blk-64919","kind":"paragraph","spans":[{"id":"spn-95122","text":"cd ProjectAmp2/graphonomous"}]},{"id":"blk-64920","kind":"heading","level":2,"spans":[{"id":"spn-95123","text":"2) Choose a launch mode"}]},{"id":"blk-64921","kind":"paragraph","spans":[{"id":"spn-95124","text":"You can run Graphonomous in two modes:"}]},{"id":"blk-64922","kind":"heading","level":3,"spans":[{"id":"spn-95125","text":"A) Fast dev mode (recommended while iterating)"}]},{"id":"blk-64923","kind":"paragraph","spans":[{"id":"spn-95126","text":"Use Mix with no compile step:"}]},{"id":"blk-64924","kind":"paragraph","spans":[{"id":"spn-95127","text":"mix run --no-compile -e 'Graphonomous.CLI.main([\"--db\",\"~/.graphonomous/knowledge.db\",\"--embedder-backend\",\"fallback\"])'"}]},{"id":"blk-64925","kind":"paragraph","span