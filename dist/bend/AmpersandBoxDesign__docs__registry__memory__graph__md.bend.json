{"bendscript":"0.1","blocks":[{"id":"blk-10130","kind":"heading","level":1,"spans":[{"id":"spn-9430","marks":["code"],"text":"&memory.graph"},{"id":"spn-9431","text":" — Graph-Structured Memory Capability"}]},{"id":"blk-10131","kind":"paragraph","spans":[{"id":"spn-9432","marks":["code"],"text":"&memory.graph"},{"id":"spn-9433","text":" is a concrete capability page for the [&] Protocol's "},{"id":"spn-9434","marks":["code"],"text":"&memory"},{"id":"spn-9435","text":" primitive."}]},{"id":"blk-10132","kind":"paragraph","spans":[{"id":"spn-9436","text":"It describes the capability interface for "},{"id":"spn-9437","marks":["bold"],"text":"graph-structured memory"},{"id":"spn-9438","text":": a memory system that stores entities, events, concepts, and relationships in a connected form and can use that structure to enrich retrieval, support reasoning, and preserve durable context over time."}]},{"id":"blk-10133","kind":"paragraph","spans":[{"id":"spn-9439","text":"This page is part of the capability registry and documentation hub. It is intended to be useful both to humans and to downstream generation systems."}]},{"id":"blk-10134","kind":"heading","level":2,"spans":[{"id":"spn-9440","text":"1. Definition"}]},{"id":"blk-10135","kind":"paragraph","spans":[{"id":"spn-9441","marks":["code"],"text":"&memory.graph"},{"id":"spn-9442","text":" is the capability for:"}]},{"id":"blk-10136","items":[{"blocks":[{"id":"blk-10138","kind":"paragraph","spans":[{"id":"spn-9443","text":"relationship-aware recall"}]}],"id":"blk-10137","kind":"list-item"},{"blocks":[{"id":"blk-10140","kind":"paragraph","spans":[{"id":"spn-9444","text":"graph-linked context enrichment"}]}],"id":"blk-10139","kind":"list-item"},{"blocks":[{"id":"blk-10142","kind":"paragraph","spans":[{"id":"spn-9445","text":"durable structured memory"}]}],"id":"blk-10141","kind":"list-item"},{"blocks":[{"id":"blk-10144","kind":"paragraph","spans":[{"id":"spn-9446","text":"consolidation of repeated observations into connected knowledge"}]}],"id":"blk-10143","kind":"list-item"},{"blocks":[{"id":"blk-10146","kind":"paragraph","spans":[{"id":"spn-9447","text":"retrieval over entities, events, dependencies, and incident structure"}]}],"id":"blk-10145","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10147","kind":"paragraph","spans":[{"id":"spn-9448","text":"Unlike flat text retrieval alone, graph memory preserves "},{"id":"spn-9449","marks":["bold"],"text":"how things relate"},{"id":"spn-9450","text":"."}]},{"id":"blk-10148","kind":"paragraph","spans":[{"id":"spn-9451","text":"That makes it especially useful when an agent must answer questions like:"}]},{"id":"blk-10149","items":[{"blocks":[{"id":"blk-10151","kind":"paragraph","spans":[{"id":"spn-9452","text":"What other incidents are connected to this one?"}]}],"id":"blk-10150","kind":"list-item"},{"blocks":[{"id":"blk-10153","kind":"paragraph","spans":[{"id":"spn-9453","text":"Which dependency chain links this failure to a prior outage?"}]}],"id":"blk-10152","kind":"list-item"},{"blocks":[{"id":"blk-10155","kind":"paragraph","spans":[{"id":"spn-9454","text":"Which entities, regions, or customers are affected through known relationships?"}]}],"id":"blk-10154","kind":"list-item"},{"blocks":[{"id":"blk-10157","kind":"paragraph","spans":[{"id":"spn-9455","text":"What prior action led to this current state?"}]}],"id":"blk-10156","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10158","kind":"paragraph","spans":[{"id":"spn-9456","text":"In protocol terms, the canonical capability identifier is:"}]},{"id":"blk-10159","items":[{"blocks":[{"id":"blk-10161","kind":"paragraph","spans":[{"id":"spn-9457","marks":["code"],"text":"&memory.graph"}]}],"id":"blk-10160","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10162","kind":"heading","level":2,"spans":[{"id":"spn-9458","text":"2. Why this capability exists"}]},{"id":"blk-10163","kind":"paragraph","spans":[{"id":"spn-9459","text":"A large share of important agent workloads are not just about finding similar text. They are about traversing structure."}]},{"id":"blk-10164","kind":"paragraph","spans":[{"id":"spn-9460","text":"Examples:"}]},{"id":"blk-10165","items":[{"blocks":[{"id":"blk-10167","kind":"paragraph","spans":[{"id":"spn-9461","text":"infrastructure incidents linked through services, hosts, and dependencies"}]}],"id":"blk-10166","kind":"list-item"},{"blocks":[{"id":"blk-10169","kind":"paragraph","spans":[{"id":"spn-9462","text":"research concepts linked through claims, citations, and prior conclusions"}]}],"id":"blk-10168","kind":"list-item"},{"blocks":[{"id":"blk-10171","kind":"paragraph","spans":[{"id":"spn-9463","text":"customer support cases linked through account history, policies, and prior escalations"}]}],"id":"blk-10170","kind":"list-item"},{"blocks":[{"id":"blk-10173","kind":"paragraph","spans":[{"id":"spn-9464","text":"fraud investigations linked through entities, accounts, devices, and event chains"}]}],"id":"blk-10172","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10174","kind":"paragraph","spans":[{"id":"spn-9465","text":"A graph memory capability is useful whenever:"}]},{"id":"blk-10175","items":[{"blocks":[{"id":"blk-10177","kind":"paragraph","spans":[{"id":"spn-9466","text":"relationship structure matters"}]}],"id":"blk-10176","kind":"list-item"},{"blocks":[{"id":"blk-10179","kind":"paragraph","spans":[{"id":"spn-9467","text":"recall should be explainable"}]}],"id":"blk-10178","kind":"list-item"},{"blocks":[{"id":"blk-10181","kind":"paragraph","spans":[{"id":"spn-9468","text":"enrichment should include linked context rather than only nearest-neighbor similarity"}]}],"id":"blk-10180","kind":"list-item"},{"blocks":[{"id":"blk-10183","kind":"paragraph","spans":[{"id":"spn-9469","text":"memory should consolidate into durable connected knowledge over time"}]}],"id":"blk-10182","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10184","kind":"paragraph","spans":[{"id":"spn-9470","text":"This is why "},{"id":"spn-9471","marks":["code"],"text":"&memory.graph"},{"id":"spn-9472","text":" is a distinct capability rather than just a provider detail."}]},{"id":"blk-10185","kind":"heading","level":2,"spans":[{"id":"spn-9473","text":"3. Capability family position"}]},{"id":"blk-10186","kind":"paragraph","spans":[{"id":"spn-9474","marks":["code"],"text":"&memory.graph"},{"id":"spn-9475","text":" sits inside the "},{"id":"spn-9476","marks":["code"],"text":"&memory"},{"id":"spn-9477","text":" namespace."}]},{"id":"blk-10187","kind":"paragraph","spans":[{"id":"spn-9478","text":"Related memory capabilities include:"}]},{"id":"blk-10188","items":[{"blocks":[{"id":"blk-10190","kind":"paragraph","spans":[{"id":"spn-9479","marks":["code"],"text":"&memory.vector"},{"id":"spn-9480","text":" — semantic retrieval over embedded content"}]}],"id":"blk-10189","kind":"list-item"},{"blocks":[{"id":"blk-10192","kind":"paragraph","spans":[{"id":"spn-9481","marks":["code"],"text":"&memory.episodic"},{"id":"spn-9482","text":" — replayable prior experiences or sessions"}]}],"id":"blk-10191","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10193","kind":"paragraph","spans":[{"id":"spn-9483","text":"A useful shorthand:"}]},{"id":"blk-10194","items":[{"blocks":[{"id":"blk-10196","kind":"paragraph","spans":[{"id":"spn-9484","marks":["code"],"text":"memory.graph"},{"id":"spn-9485","text":" = connected durable knowledge"}]}],"id":"blk-10195","kind":"list-item"},{"blocks":[{"id":"blk-10198","kind":"paragraph","spans":[{"id":"spn-9486","marks":["code"],"text":"memory.vector"},{"id":"spn-9487","text":" = semantic similarity retrieval"}]}],"id":"blk-10197","kind":"list-item"},{"blocks":[{"id":"blk-10200","kind":"paragraph","spans":[{"id":"spn-9488","marks":["code"],"text":"memory.episodic"},{"id":"spn-9489","text":" = prior experience replay"}]}],"id":"blk-10199","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10201","kind":"paragraph","spans":[{"id":"spn-9490","text":"In many real systems, these capabilities compose rather than compete."}]},{"id":"blk-10202","kind":"heading","level":2,"spans":[{"id":"spn-9491","text":"4. Capability contract summary"}]},{"id":"blk-10203","kind":"paragraph","spans":[{"id":"spn-9492","text":"Below is a representative contract for "},{"id":"spn-9493","marks":["code"],"text":"&memory.graph"},{"id":"spn-9494","text":"."}]},{"id":"blk-10204","kind":"paragraph","spans":[{"id":"spn-9495","text":"~~~json { \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\", \"capability\": \"&memory.graph\", \"provider\": \"graphonomous\", \"version\": \"0.1.0\", \"description\": \"Graph-structured memory contract for relationship-aware recall, enrichment, and consolidation across incident, research, and operational contexts.\", \"operations\": { \"recall\": { \"in\": \"query_context\", \"out\": \"memory_hits\", \"description\": \"Retrieve graph-linked facts, incidents, entities, and relationships relevant to the current query.\", \"deterministic\": false, \"side_effects\": false }, \"learn\": { \"in\": \"observation\", \"out\": \"ack\", \"description\": \"Persist a new observation or derived relationship into graph memory.\", \"deterministic\": true, \"side_effects\": true }, \"consolidate\": { \"in\": \"memory_batch\", \"out\": \"graph_update\", \"description\": \"Merge repeated observations into more durable graph structure.\", \"deterministic\": false, \"side_effects\": true }, \"enrich\": { \"in\": \"anomaly_set\", \"out\": \"enriched_context\", \"description\": \"Add linked historical incidents, dependencies, or related entities to a current anomaly set.\", \"deterministic\": false, \"side_effects\": false } }, \"accepts_from\": [ \"&time.*\", \"&reason.*\", \"query_context\", \"observation\", \"memory_batch\" ], \"feeds_into\": [ \"&reason.*\", \"&space.*\", \"output\" ], \"a2a_skills\": [ \"graph-memory-recall\", \"context-enrichment\", \"memory-consolidation\" ] } ~~~"}]},{"id":"blk-10205","kind":"heading","level":3,"spans":[{"id":"spn-9496","text":"Interpretation"}]},{"id":"blk-10206","kind":"paragraph","spans":[{"id":"spn-9497","text":"This contract says that "},{"id":"spn-9498","marks":["code"],"text":"&memory.graph"},{"id":"spn-9499","text":" can:"}]},{"id":"blk-10207","items":[{"blocks":[{"id":"blk-10209","kind":"paragraph","spans":[{"id":"spn-9500","text":"recall graph-linked knowledge from a query context"}]}],"id":"blk-10208","kind":"list-item"},{"blocks":[{"id":"blk-10211","kind":"paragraph","spans":[{"id":"spn-9501","text":"learn new observations"}]}],"id":"blk-10210","kind":"list-item"},{"blocks":[{"id":"blk-10213","kind":"paragraph","spans":[{"id":"spn-9502","text":"consolidate batches into stronger graph structure"}]}],"id":"blk-10212","kind":"list-item"},{"blocks":[{"id":"blk-10215","kind":"paragraph","spans":[{"id":"spn-9503","text":"enrich anomaly-oriented or operational context for downstream reasoning"}]}],"id":"blk-10214","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10216","kind":"paragraph","spans":[{"id":"spn-9504","text":"It also says that it composes especially naturally with:"}]},{"id":"blk-10217","items":[{"blocks":[{"id":"blk-10219","kind":"paragraph","spans":[{"id":"spn-9505","text":"temporal capabilities upstream"}]}],"id":"blk-10218","kind":"list-item"},{"blocks":[{"id":"blk-10221","kind":"paragraph","spans":[{"id":"spn-9506","text":"reasoning capabilities downstream"}]}],"id":"blk-10220","kind":"list-item"},{"blocks":[{"id":"blk-10223","kind":"paragraph","spans":[{"id":"spn-9507","text":"spatial capabilities downstream"}]}],"id":"blk-10222","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10224","kind":"heading","level":2,"spans":[{"id":"spn-9508","text":"5. Operations"}]},{"id":"blk-10225","kind":"heading","level":3,"spans":[{"id":"spn-9509","marks":["code"],"text":"recall"}]},{"id":"blk-10226","kind":"paragraph","spans":[{"id":"spn-9510","text":"Purpose:"}]},{"id":"blk-10227","items":[{"blocks":[{"id":"blk-10229","kind":"paragraph","spans":[{"id":"spn-9511","text":"retrieve relevant nodes, edges, and linked context"}]}],"id":"blk-10228","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10230","kind":"paragraph","spans":[{"id":"spn-9512","text":"Typical input:"}]},{"id":"blk-10231","items":[{"blocks":[{"id":"blk-10233","kind":"paragraph","spans":[{"id":"spn-9513","marks":["code"],"text":"query_context"}]}],"id":"blk-10232","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10234","kind":"paragraph","spans":[{"id":"spn-9514","text":"Typical output:"}]},{"id":"blk-10235","items":[{"blocks":[{"id":"blk-10237","kind":"paragraph","spans":[{"id":"spn-9515","marks":["code"],"text":"memory_hits"}]}],"id":"blk-10236","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10238","kind":"paragraph","spans":[{"id":"spn-9516","text":"Use when:"}]},{"id":"blk-10239","items":[{"blocks":[{"id":"blk-10241","kind":"paragraph","spans":[{"id":"spn-9517","text":"the agent needs graph-aware recall instead of plain document search"}]}],"id":"blk-10240","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10242","kind":"heading","level":3,"spans":[{"id":"spn-9518","marks":["code"],"text":"learn"}]},{"id":"blk-10243","kind":"paragraph","spans":[{"id":"spn-9519","text":"Purpose:"}]},{"id":"blk-10244","items":[{"blocks":[{"id":"blk-10246","kind":"paragraph","spans":[{"id":"spn-9520","text":"store new observations or relationship updates"}]}],"id":"blk-10245","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10247","kind":"paragraph","spans":[{"id":"spn-9521","text":"Typical input:"}]},{"id":"blk-10248","items":[{"blocks":[{"id":"blk-10250","kind":"paragraph","spans":[{"id":"spn-9522","marks":["code"],"text":"observation"}]}],"id":"blk-10249","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10251","kind":"paragraph","spans":[{"id":"spn-9523","text":"Typical output:"}]},{"id":"blk-10252","items":[{"blocks":[{"id":"blk-10254","kind":"paragraph","spans":[{"id":"spn-9524","marks":["code"],"text":"ack"}]}],"id":"blk-10253","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10255","kind":"paragraph","spans":[{"id":"spn-9525","text":"Use when:"}]},{"id":"blk-10256","items":[{"blocks":[{"id":"blk-10258","kind":"paragraph","spans":[{"id":"spn-9526","text":"the agent should update durable memory after a task or decision"}]}],"id":"blk-10257","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10259","kind":"heading","level":3,"spans":[{"id":"spn-9527","marks":["code"],"text":"consolidate"}]},{"id":"blk-10260","kind":"paragraph","spans":[{"id":"spn-9528","text":"Purpose:"}]},{"id":"blk-10261","items":[{"blocks":[{"id":"blk-10263","kind":"paragraph","spans":[{"id":"spn-9529","text":"merge repeated or fragmented knowledge into more stable graph structure"}]}],"id":"blk-10262","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10264","kind":"paragraph","spans":[{"id":"spn-9530","text":"Typical input:"}]},{"id":"blk-10265","items":[{"blocks":[{"id":"blk-10267","kind":"paragraph","spans":[{"id":"spn-9531","marks":["code"],"text":"memory_batch"}]}],"id":"blk-10266","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10268","kind":"paragraph","spans":[{"id":"spn-9532","text":"Typical output:"}]},{"id":"blk-10269","items":[{"blocks":[{"id":"blk-10271","kind":"paragraph","spans":[{"id":"spn-9533","marks":["code"],"text":"graph_update"}]}],"id":"blk-10270","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10272","kind":"paragraph","spans":[{"id":"spn-9534","text":"Use when:"}]},{"id":"blk-10273","items":[{"blocks":[{"id":"blk-10275","kind":"paragraph","spans":[{"id":"spn-9535","text":"the system accumulates many observations and needs durable structure"}]}],"id":"blk-10274","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10276","kind":"heading","level":3,"spans":[{"id":"spn-9536","marks":["code"],"text":"enrich"}]},{"id":"blk-10277","kind":"paragraph","spans":[{"id":"spn-9537","text":"Purpose:"}]},{"id":"blk-10278","items":[{"blocks":[{"id":"blk-10280","kind":"paragraph","spans":[{"id":"spn-9538","text":"attach graph-linked historical or dependency context to an existing payload"}]}],"id":"blk-10279","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10281","kind":"paragraph","spans":[{"id":"spn-9539","text":"Typical input:"}]},{"id":"blk-10282","items":[{"blocks":[{"id":"blk-10284","kind":"paragraph","spans":[{"id":"spn-9540","marks":["code"],"text":"anomaly_set"},{"id":"spn-9541","text":" or compatible context object"}]}],"id":"blk-10283","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10285","kind":"paragraph","spans":[{"id":"spn-9542","text":"Typical output:"}]},{"id":"blk-10286","items":[{"blocks":[{"id":"blk-10288","kind":"paragraph","spans":[{"id":"spn-9543","marks":["code"],"text":"enriched_context"}]}],"id":"blk-10287","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10289","kind":"paragraph","spans":[{"id":"spn-9544","text":"Use when:"}]},{"id":"blk-10290","items":[{"blocks":[{"id":"blk-10292","kind":"paragraph","spans":[{"id":"spn-9545","text":"another capability has already produced a signal and graph memory should make it more useful"}]}],"id":"blk-10291","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10293","kind":"heading","level":2,"spans":[{"id":"spn-9546","text":"6. Architecture patterns"}]},{"id":"blk-10294","kind":"heading","level":3,"spans":[{"id":"spn-9547","text":"Pattern A: anomaly enrichment"}]},{"id":"blk-10295","kind":"paragraph","spans":[{"id":"spn-9548","text":"~~~text stream_data"}]},{"id":"blk-10296","kind":"paragraph","spans":[{"id":"spn-9549","text":"~~~"}]},{"id":"blk-10297","kind":"paragraph","spans":[{"id":"spn-9550","text":"What happens:"}]},{"id":"blk-10298","items":[{"blocks":[{"id":"blk-10300","kind":"paragraph","spans":[{"id":"spn-9551","text":"a temporal capability detects anomalies"}]}],"id":"blk-10299","kind":"list-item"},{"blocks":[{"id":"blk-10302","kind":"paragraph","spans":[{"id":"spn-9552","text":"graph memory adds linked incident and dependency context"}]}],"id":"blk-10301","kind":"list-item"},{"blocks":[{"id":"blk-10304","kind":"paragraph","spans":[{"id":"spn-9553","text":"reasoning evaluates the best action"}]}],"id":"blk-10303","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10305","kind":"paragraph","spans":[{"id":"spn-9554","text":"This is one of the strongest "},{"id":"spn-9555","marks":["code"],"text":"&memory.graph"},{"id":"spn-9556","text":" patterns."}]},{"id":"blk-10306","kind":"heading","level":3,"spans":[{"id":"spn-9557","text":"Pattern B: research knowledge graph"}]},{"id":"blk-10307","kind":"paragraph","spans":[{"id":"spn-9558","text":"~~~text research_query"}]},{"id":"blk-10308","kind":"paragraph","spans":[{"id":"spn-9559","text":"~~~"}]},{"id":"blk-10309","kind":"paragraph","spans":[{"id":"spn-9560","text":"What happens:"}]},{"id":"blk-10310","items":[{"blocks":[{"id":"blk-10312","kind":"paragraph","spans":[{"id":"spn-9561","text":"graph memory retrieves claims, relationships, and prior linked knowledge"}]}],"id":"blk-10311","kind":"list-item"},{"blocks":[{"id":"blk-10314","kind":"paragraph","spans":[{"id":"spn-9562","text":"reasoning compares or synthesizes evidence"}]}],"id":"blk-10313","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10315","kind":"heading","level":3,"spans":[{"id":"spn-9563","text":"Pattern C: learning from outcomes"}]},{"id":"blk-10316","kind":"paragraph","spans":[{"id":"spn-9564","text":"~~~text decision_outcome"}]},{"id":"blk-10317","kind":"paragraph","spans":[{"id":"spn-9565","text":"~~~"}]},{"id":"blk-10318","kind":"paragraph","spans":[{"id":"spn-9566","text":"What happens:"}]},{"id":"blk-10319","items":[{"blocks":[{"id":"blk-10321","kind":"paragraph","spans":[{"id":"spn-9567","text":"outcome evidence is added to graph memory"}]}],"id":"blk-10320","kind":"list-item"},{"blocks":[{"id":"blk-10323","kind":"paragraph","spans":[{"id":"spn-9568","text":"repeated or related observations are consolidated"}]}],"id":"blk-10322","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10324","kind":"paragraph","spans":[{"id":"spn-9569","text":"This supports continual learning without discarding structure."}]},{"id":"blk-10325","kind":"heading","level":2,"spans":[{"id":"spn-9570","text":"7. Architecture diagram"}]},{"id":"blk-10326","kind":"paragraph","spans":[{"id":"spn-9571","text":"A simple mental model for "},{"id":"spn-9572","marks":["code"],"text":"&memory.graph"},{"id":"spn-9573","text":":"}]},{"id":"blk-10327","kind":"paragraph","spans":[{"id":"spn-9574","text":"~~~text ┌─────────────────────┐ │   incoming signal   │ │  query / anomaly /  │ │     observation     │ └─────────┬───────────┘ │ ▼ ┌─────────────────────┐ │   &memory.graph     │ │                     │ │  - recall           │ │  - enrich           │ │  - learn            │ │  - consolidate      │ └─────────┬───────────┘ │ ┌──────────────┼──────────────┐ │              │              │ ▼              ▼              ▼ ┌────────────────┐ ┌──────────────┐ ┌───────────────┐ │ enriched       │ │ graph update │ │ memory hits   │ │ context        │ │ / ack        │ │ / linked facts│ └──────┬─────────┘ └──────────────┘ └───────────────┘ │ ▼ ┌─────────────────────┐ │ downstream reason / │ │ space / output flow │ └─────────────────────┘ ~~~"}]},{"id":"blk-10328","kind":"heading","level":2,"spans":[{"id":"spn-9575","text":"8. Example declaration"}]},{"id":"blk-10329","kind":"paragraph","spans":[{"id":"spn-9576","text":"A concrete "},{"id":"spn-9577","marks":["code"],"text":"ampersand.json"},{"id":"spn-9578","text":" fragment:"}]},{"id":"blk-10330","kind":"paragraph","spans":[{"id":"spn-9579","text":"~~~json { \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"infra-ops\" } } } ~~~"}]},{"id":"blk-10331","kind":"paragraph","spans":[{"id":"spn-9580","text":"A fuller declaration:"}]},{"id":"blk-10332","kind":"paragraph","spans":[{"id":"spn-9581","text":"~~~json { \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\", \"agent\": \"InfraOperator\", \"version\": \"1.0.0\", \"capabilities\": { \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"infra-ops\" } }, \"&time.anomaly\": { \"provider\": \"ticktickclock\", \"config\": { \"streams\": [\"cpu\", \"mem\"] } }, \"&space.fleet\": { \"provider\": \"geofleetic\", \"config\": { \"regions\": [\"us-east\"] } }, \"&reason.argument\": { \"provider\": \"deliberatic\", \"config\": { \"governance\": \"constitutional\" } } }, \"provenance\": true } ~~~"}]},{"id":"blk-10333","kind":"heading","level":2,"spans":[{"id":"spn-9582","text":"9. Example API shape"}]},{"id":"blk-10334","kind":"paragraph","spans":[{"id":"spn-9583","text":"A provider-specific API may vary, but the protocol-level shape can look like this."}]},{"id":"blk-10335","kind":"heading","level":3,"spans":[{"id":"spn-9584","text":"Recall request"}]},{"id":"blk-10336","kind":"paragraph","spans":[{"id":"spn-9585","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"recall\", \"input\": { \"query_context\": { \"incident_type\": \"cpu_spike\", \"region\": \"us-east\", \"service\": \"api-gateway\" } } } ~~~"}]},{"id":"blk-10337","kind":"heading","level":3,"spans":[{"id":"spn-9586","text":"Recall response"}]},{"id":"blk-10338","kind":"paragraph","spans":[{"id":"spn-9587","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"recall\", \"output\": { \"memory_hits\": [ { \"entity\": \"incident-4821\", \"summary\": \"CPU saturation on api-gateway during regional traffic spike\", \"links\": [\"service:api-gateway\", \"region:us-east\", \"runbook:scale-gateway\"] }, { \"entity\": \"incident-4792\", \"summary\": \"Dependency saturation caused by cache failure\", \"links\": [\"service:cache\", \"service:api-gateway\"] } ] } } ~~~"}]},{"id":"blk-10339","kind":"heading","level":3,"spans":[{"id":"spn-9588","text":"Enrich request"}]},{"id":"blk-10340","kind":"paragraph","spans":[{"id":"spn-9589","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"enrich\", \"input\": { \"anomaly_set\": { \"service\": \"api-gateway\", \"region\": \"us-east\", \"anomalies\": [\"cpu_spike\", \"latency_jump\"] } } } ~~~"}]},{"id":"blk-10341","kind":"heading","level":3,"spans":[{"id":"spn-9590","text":"Enrich response"}]},{"id":"blk-10342","kind":"paragraph","spans":[{"id":"spn-9591","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"enrich\", \"output\": { \"enriched_context\": { \"related_incidents\": [\"incident-4821\", \"incident-4792\"], \"related_entities\": [\"service:cache\", \"service:api-gateway\", \"region:us-east\"], \"suggested_runbooks\": [\"scale-gateway\", \"check-cache-health\"] } } } ~~~"}]},{"id":"blk-10343","kind":"heading","level":2,"spans":[{"id":"spn-9592","text":"10. Compatible providers"}]},{"id":"blk-10344","kind":"paragraph","spans":[{"id":"spn-9593","marks":["code"],"text":"&memory.graph"},{"id":"spn-9594","text":" is a capability interface. Compatible providers are implementations that can satisfy the contract."}]},{"id":"blk-10345","kind":"paragraph","spans":[{"id":"spn-9595","text":"Representative providers:"}]},{"id":"blk-10346","items":[{"blocks":[{"id":"blk-10348","kind":"paragraph","spans":[{"id":"spn-9596","marks":["code"],"text":"graphonomous"}]}],"id":"blk-10347","kind":"list-item"},{"blocks":[{"id":"blk-10350","kind":"paragraph","spans":[{"id":"spn-9597","marks":["code"],"text":"neo4j-memory"}]}],"id":"blk-10349","kind":"list-item"},{"blocks":[{"id":"blk-10352","kind":"paragraph","spans":[{"id":"spn-9598","text":"custom graph-backed MCP services"}]}],"id":"blk-10351","kind":"list-item"},{"blocks":[{"id":"blk-10354","kind":"paragraph","spans":[{"id":"spn-9599","text":"domain-specific knowledge graph systems wrapped behind a protocol-compatible surface"}]}],"id":"blk-10353","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10355","kind":"heading","level":3,"spans":[{"id":"spn-9600","text":"Current default ecosystem fit"}]},{"id":"blk-10356","items":[{"blocks":[{"id":"blk-10358","kind":"paragraph","spans":[{"id":"spn-9601","marks":["code"],"text":"graphonomous"},{"id":"spn-9602","text":" is the clearest default example provider in this repository"}]}],"id":"blk-10357","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10359","kind":"paragraph","spans":[{"id":"spn-9603","text":"Why it fits:"}]},{"id":"blk-10360","items":[{"blocks":[{"id":"blk-10362","kind":"paragraph","spans":[{"id":"spn-9604","text":"graph-oriented memory model"}]}],"id":"blk-10361","kind":"list-item"},{"blocks":[{"id":"blk-10364","kind":"paragraph","spans":[{"id":"spn-9605","text":"MCP-friendly runtime shape"}]}],"id":"blk-10363","kind":"list-item"},{"blocks":[{"id":"blk-10366","kind":"paragraph","spans":[{"id":"spn-9606","text":"suitable for recall, enrichment, and learning workflows"}]}],"id":"blk-10365","kind":"list-item"},{"blocks":[{"id":"blk-10368","kind":"paragraph","spans":[{"id":"spn-9607","text":"directly useful for infra, research, and agent memory scenarios"}]}],"id":"blk-10367","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10369","kind":"heading","level":2,"spans":[{"id":"spn-9608","text":"11. A2A-facing skills"}]},{"id":"blk-10370","kind":"paragraph","spans":[{"id":"spn-9609","text":"A "},{"id":"spn-9610","marks":["code"],"text":"&memory.graph"},{"id":"spn-9611","text":" capability may advertise skills such as:"}]},{"id":"blk-10371","items":[{"blocks":[{"id":"blk-10373","kind":"paragraph","spans":[{"id":"spn-9612","marks":["code"],"text":"graph-memory-recall"}]}],"id":"blk-10372","kind":"list-item"},{"blocks":[{"id":"blk-10375","kind":"paragraph","spans":[{"id":"spn-9613","marks":["code"],"text":"context-enrichment"}]}],"id":"blk-10374","kind":"list-item"},{"blocks":[{"id":"blk-10377","kind":"paragraph","spans":[{"id":"spn-9614","marks":["code"],"text":"memory-consolidation"}]}],"id":"blk-10376","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10378","kind":"paragraph","spans":[{"id":"spn-9615","text":"These skills are useful when generating A2A agent cards from a declaration, because they let an externally visible agent surface say more than just “has memory.”"}]},{"id":"blk-10379","kind":"heading","level":2,"spans":[{"id":"spn-9616","text":"12. Governance implications"}]},{"id":"blk-10380","kind":"paragraph","spans":[{"id":"spn-9617","text":"Graph memory often sits close to high-value historical context, so governance matters."}]},{"id":"blk-10381","kind":"paragraph","spans":[{"id":"spn-9618","text":"Examples of governance constraints that commonly pair with "},{"id":"spn-9619","marks":["code"],"text":"&memory.graph"},{"id":"spn-9620","text":":"}]},{"id":"blk-10382","kind":"heading","level":3,"spans":[{"id":"spn-9621","text":"Hard constraints"}]},{"id":"blk-10383","items":[{"blocks":[{"id":"blk-10385","kind":"paragraph","spans":[{"id":"spn-9622","text":"never reveal private customer-linked graph context outside authorized workflows"}]}],"id":"blk-10384","kind":"list-item"},{"blocks":[{"id":"blk-10387","kind":"paragraph","spans":[{"id":"spn-9623","text":"never delete incident lineage without human approval"}]}],"id":"blk-10386","kind":"list-item"},{"blocks":[{"id":"blk-10389","kind":"paragraph","spans":[{"id":"spn-9624","text":"always preserve audit trail for graph-backed decision support"}]}],"id":"blk-10388","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10390","kind":"heading","level":3,"spans":[{"id":"spn-9625","text":"Soft constraints"}]},{"id":"blk-10391","items":[{"blocks":[{"id":"blk-10393","kind":"paragraph","spans":[{"id":"spn-9626","text":"prefer policy-grounded linked evidence over unsupported inference"}]}],"id":"blk-10392","kind":"list-item"},{"blocks":[{"id":"blk-10395","kind":"paragraph","spans":[{"id":"spn-9627","text":"prefer recent validated graph context when conflicts exist"}]}],"id":"blk-10394","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10396","kind":"heading","level":3,"spans":[{"id":"spn-9628","text":"Escalation triggers"}]},{"id":"blk-10397","items":[{"blocks":[{"id":"blk-10399","kind":"paragraph","spans":[{"id":"spn-9629","text":"escalate when confidence in recalled graph context is below threshold"}]}],"id":"blk-10398","kind":"list-item"},{"blocks":[{"id":"blk-10401","kind":"paragraph","spans":[{"id":"spn-9630","text":"escalate when a decision depends on sparse or conflicting graph evidence"}]}],"id":"blk-10400","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10402","kind":"heading","level":2,"spans":[{"id":"spn-9631","text":"13. Provenance implications"}]},{"id":"blk-10403","kind":"paragraph","spans":[{"id":"spn-9632","marks":["code"],"text":"&memory.graph"},{"id":"spn-9633","text":" should participate in the provenance chain."}]},{"id":"blk-10404","kind":"paragraph","spans":[{"id":"spn-9634","text":"Representative provenance record:"}]},{"id":"blk-10405","kind":"paragraph","spans":[{"id":"spn-9635","text":"~~~json { \"source\": \"&memory.graph\", \"provider\": \"graphonomous\", \"operation\": \"enrich\", \"timestamp\": \"2026-03-14T14:23:07Z\", \"input_hash\": \"sha256:1a2b...\", \"output_hash\": \"sha256:7c8d...\", \"parent_hash\": \"sha256:0000...\" } ~~~"}]},{"id":"blk-10406","kind":"paragraph","spans":[{"id":"spn-9636","text":"This matters because graph-backed context often strongly influences downstream reasoning. If a system chooses a remediation path because graph memory linked the current issue to prior incidents, that enrichment step should be auditable."}]},{"id":"blk-10407","kind":"heading","level":2,"spans":[{"id":"spn-9637","text":"14. Typical use cases"}]},{"id":"blk-10408","kind":"paragraph","spans":[{"id":"spn-9638","marks":["code"],"text":"&memory.graph"},{"id":"spn-9639","text":" is especially strong in the following domains."}]},{"id":"blk-10409","kind":"heading","level":3,"spans":[{"id":"spn-9640","text":"Infrastructure operations"}]},{"id":"blk-10410","items":[{"blocks":[{"id":"blk-10412","kind":"paragraph","spans":[{"id":"spn-9641","text":"dependency-aware incident recall"}]}],"id":"blk-10411","kind":"list-item"},{"blocks":[{"id":"blk-10414","kind":"paragraph","spans":[{"id":"spn-9642","text":"similar outage enrichment"}]}],"id":"blk-10413","kind":"list-item"},{"blocks":[{"id":"blk-10416","kind":"paragraph","spans":[{"id":"spn-9643","text":"durable operational knowledge"}]}],"id":"blk-10415","kind":"list-item"},{"blocks":[{"id":"blk-10418","kind":"paragraph","spans":[{"id":"spn-9644","text":"continual learning from postmortems"}]}],"id":"blk-10417","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10419","kind":"heading","level":3,"spans":[{"id":"spn-9645","text":"Research systems"}]},{"id":"blk-10420","items":[{"blocks":[{"id":"blk-10422","kind":"paragraph","spans":[{"id":"spn-9646","text":"linked concepts and citations"}]}],"id":"blk-10421","kind":"list-item"},{"blocks":[{"id":"blk-10424","kind":"paragraph","spans":[{"id":"spn-9647","text":"claim/evidence relationship structure"}]}],"id":"blk-10423","kind":"list-item"},{"blocks":[{"id":"blk-10426","kind":"paragraph","spans":[{"id":"spn-9648","text":"durable research graph building"}]}],"id":"blk-10425","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10427","kind":"heading","level":3,"spans":[{"id":"spn-9649","text":"Customer support"}]},{"id":"blk-10428","items":[{"blocks":[{"id":"blk-10430","kind":"paragraph","spans":[{"id":"spn-9650","text":"account and case relationship modeling"}]}],"id":"blk-10429","kind":"list-item"},{"blocks":[{"id":"blk-10432","kind":"paragraph","spans":[{"id":"spn-9651","text":"escalation lineage"}]}],"id":"blk-10431","kind":"list-item"},{"blocks":[{"id":"blk-10434","kind":"paragraph","span