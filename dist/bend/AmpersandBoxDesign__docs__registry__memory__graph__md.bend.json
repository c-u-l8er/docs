{"bendscript":"0.1","blocks":[{"id":"blk-10128","kind":"heading","level":1,"spans":[{"id":"spn-9630","marks":["code"],"text":"&memory.graph"},{"id":"spn-9631","text":" — Graph-Structured Memory Capability"}]},{"id":"blk-10129","kind":"paragraph","spans":[{"id":"spn-9632","marks":["code"],"text":"&memory.graph"},{"id":"spn-9633","text":" is a concrete capability page for the [&] Protocol's "},{"id":"spn-9634","marks":["code"],"text":"&memory"},{"id":"spn-9635","text":" primitive."}]},{"id":"blk-10130","kind":"paragraph","spans":[{"id":"spn-9636","text":"It describes the capability interface for "},{"id":"spn-9637","marks":["bold"],"text":"graph-structured memory"},{"id":"spn-9638","text":": a memory system that stores entities, events, concepts, and relationships in a connected form and can use that structure to enrich retrieval, support reasoning, and preserve durable context over time."}]},{"id":"blk-10131","kind":"paragraph","spans":[{"id":"spn-9639","text":"This page is part of the capability registry and documentation hub. It is intended to be useful both to humans and to downstream generation systems."}]},{"id":"blk-10132","kind":"heading","level":2,"spans":[{"id":"spn-9640","text":"1. Definition"}]},{"id":"blk-10133","kind":"paragraph","spans":[{"id":"spn-9641","marks":["code"],"text":"&memory.graph"},{"id":"spn-9642","text":" is the capability for:"}]},{"id":"blk-10134","items":[{"blocks":[{"id":"blk-10136","kind":"paragraph","spans":[{"id":"spn-9643","text":"relationship-aware recall"}]}],"id":"blk-10135","kind":"list-item"},{"blocks":[{"id":"blk-10138","kind":"paragraph","spans":[{"id":"spn-9644","text":"graph-linked context enrichment"}]}],"id":"blk-10137","kind":"list-item"},{"blocks":[{"id":"blk-10140","kind":"paragraph","spans":[{"id":"spn-9645","text":"durable structured memory"}]}],"id":"blk-10139","kind":"list-item"},{"blocks":[{"id":"blk-10142","kind":"paragraph","spans":[{"id":"spn-9646","text":"consolidation of repeated observations into connected knowledge"}]}],"id":"blk-10141","kind":"list-item"},{"blocks":[{"id":"blk-10144","kind":"paragraph","spans":[{"id":"spn-9647","text":"retrieval over entities, events, dependencies, and incident structure"}]}],"id":"blk-10143","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10145","kind":"paragraph","spans":[{"id":"spn-9648","text":"Unlike flat text retrieval alone, graph memory preserves "},{"id":"spn-9649","marks":["bold"],"text":"how things relate"},{"id":"spn-9650","text":"."}]},{"id":"blk-10146","kind":"paragraph","spans":[{"id":"spn-9651","text":"That makes it especially useful when an agent must answer questions like:"}]},{"id":"blk-10147","items":[{"blocks":[{"id":"blk-10149","kind":"paragraph","spans":[{"id":"spn-9652","text":"What other incidents are connected to this one?"}]}],"id":"blk-10148","kind":"list-item"},{"blocks":[{"id":"blk-10151","kind":"paragraph","spans":[{"id":"spn-9653","text":"Which dependency chain links this failure to a prior outage?"}]}],"id":"blk-10150","kind":"list-item"},{"blocks":[{"id":"blk-10153","kind":"paragraph","spans":[{"id":"spn-9654","text":"Which entities, regions, or customers are affected through known relationships?"}]}],"id":"blk-10152","kind":"list-item"},{"blocks":[{"id":"blk-10155","kind":"paragraph","spans":[{"id":"spn-9655","text":"What prior action led to this current state?"}]}],"id":"blk-10154","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10156","kind":"paragraph","spans":[{"id":"spn-9656","text":"In protocol terms, the canonical capability identifier is:"}]},{"id":"blk-10157","items":[{"blocks":[{"id":"blk-10159","kind":"paragraph","spans":[{"id":"spn-9657","marks":["code"],"text":"&memory.graph"}]}],"id":"blk-10158","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10160","kind":"heading","level":2,"spans":[{"id":"spn-9658","text":"2. Why this capability exists"}]},{"id":"blk-10161","kind":"paragraph","spans":[{"id":"spn-9659","text":"A large share of important agent workloads are not just about finding similar text. They are about traversing structure."}]},{"id":"blk-10162","kind":"paragraph","spans":[{"id":"spn-9660","text":"Examples:"}]},{"id":"blk-10163","items":[{"blocks":[{"id":"blk-10165","kind":"paragraph","spans":[{"id":"spn-9661","text":"infrastructure incidents linked through services, hosts, and dependencies"}]}],"id":"blk-10164","kind":"list-item"},{"blocks":[{"id":"blk-10167","kind":"paragraph","spans":[{"id":"spn-9662","text":"research concepts linked through claims, citations, and prior conclusions"}]}],"id":"blk-10166","kind":"list-item"},{"blocks":[{"id":"blk-10169","kind":"paragraph","spans":[{"id":"spn-9663","text":"customer support cases linked through account history, policies, and prior escalations"}]}],"id":"blk-10168","kind":"list-item"},{"blocks":[{"id":"blk-10171","kind":"paragraph","spans":[{"id":"spn-9664","text":"fraud investigations linked through entities, accounts, devices, and event chains"}]}],"id":"blk-10170","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10172","kind":"paragraph","spans":[{"id":"spn-9665","text":"A graph memory capability is useful whenever:"}]},{"id":"blk-10173","items":[{"blocks":[{"id":"blk-10175","kind":"paragraph","spans":[{"id":"spn-9666","text":"relationship structure matters"}]}],"id":"blk-10174","kind":"list-item"},{"blocks":[{"id":"blk-10177","kind":"paragraph","spans":[{"id":"spn-9667","text":"recall should be explainable"}]}],"id":"blk-10176","kind":"list-item"},{"blocks":[{"id":"blk-10179","kind":"paragraph","spans":[{"id":"spn-9668","text":"enrichment should include linked context rather than only nearest-neighbor similarity"}]}],"id":"blk-10178","kind":"list-item"},{"blocks":[{"id":"blk-10181","kind":"paragraph","spans":[{"id":"spn-9669","text":"memory should consolidate into durable connected knowledge over time"}]}],"id":"blk-10180","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10182","kind":"paragraph","spans":[{"id":"spn-9670","text":"This is why "},{"id":"spn-9671","marks":["code"],"text":"&memory.graph"},{"id":"spn-9672","text":" is a distinct capability rather than just a provider detail."}]},{"id":"blk-10183","kind":"heading","level":2,"spans":[{"id":"spn-9673","text":"3. Capability family position"}]},{"id":"blk-10184","kind":"paragraph","spans":[{"id":"spn-9674","marks":["code"],"text":"&memory.graph"},{"id":"spn-9675","text":" sits inside the "},{"id":"spn-9676","marks":["code"],"text":"&memory"},{"id":"spn-9677","text":" namespace."}]},{"id":"blk-10185","kind":"paragraph","spans":[{"id":"spn-9678","text":"Related memory capabilities include:"}]},{"id":"blk-10186","items":[{"blocks":[{"id":"blk-10188","kind":"paragraph","spans":[{"id":"spn-9679","marks":["code"],"text":"&memory.vector"},{"id":"spn-9680","text":" — semantic retrieval over embedded content"}]}],"id":"blk-10187","kind":"list-item"},{"blocks":[{"id":"blk-10190","kind":"paragraph","spans":[{"id":"spn-9681","marks":["code"],"text":"&memory.episodic"},{"id":"spn-9682","text":" — replayable prior experiences or sessions"}]}],"id":"blk-10189","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10191","kind":"paragraph","spans":[{"id":"spn-9683","text":"A useful shorthand:"}]},{"id":"blk-10192","items":[{"blocks":[{"id":"blk-10194","kind":"paragraph","spans":[{"id":"spn-9684","marks":["code"],"text":"memory.graph"},{"id":"spn-9685","text":" = connected durable knowledge"}]}],"id":"blk-10193","kind":"list-item"},{"blocks":[{"id":"blk-10196","kind":"paragraph","spans":[{"id":"spn-9686","marks":["code"],"text":"memory.vector"},{"id":"spn-9687","text":" = semantic similarity retrieval"}]}],"id":"blk-10195","kind":"list-item"},{"blocks":[{"id":"blk-10198","kind":"paragraph","spans":[{"id":"spn-9688","marks":["code"],"text":"memory.episodic"},{"id":"spn-9689","text":" = prior experience replay"}]}],"id":"blk-10197","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10199","kind":"paragraph","spans":[{"id":"spn-9690","text":"In many real systems, these capabilities compose rather than compete."}]},{"id":"blk-10200","kind":"heading","level":2,"spans":[{"id":"spn-9691","text":"4. Capability contract summary"}]},{"id":"blk-10201","kind":"paragraph","spans":[{"id":"spn-9692","text":"Below is a representative contract for "},{"id":"spn-9693","marks":["code"],"text":"&memory.graph"},{"id":"spn-9694","text":"."}]},{"id":"blk-10202","kind":"paragraph","spans":[{"id":"spn-9695","text":"~~~json { \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/capability-contract.schema.json\", \"capability\": \"&memory.graph\", \"provider\": \"graphonomous\", \"version\": \"0.1.0\", \"description\": \"Graph-structured memory contract for relationship-aware recall, enrichment, and consolidation across incident, research, and operational contexts.\", \"operations\": { \"recall\": { \"in\": \"query_context\", \"out\": \"memory_hits\", \"description\": \"Retrieve graph-linked facts, incidents, entities, and relationships relevant to the current query.\", \"deterministic\": false, \"side_effects\": false }, \"learn\": { \"in\": \"observation\", \"out\": \"ack\", \"description\": \"Persist a new observation or derived relationship into graph memory.\", \"deterministic\": true, \"side_effects\": true }, \"consolidate\": { \"in\": \"memory_batch\", \"out\": \"graph_update\", \"description\": \"Merge repeated observations into more durable graph structure.\", \"deterministic\": false, \"side_effects\": true }, \"enrich\": { \"in\": \"anomaly_set\", \"out\": \"enriched_context\", \"description\": \"Add linked historical incidents, dependencies, or related entities to a current anomaly set.\", \"deterministic\": false, \"side_effects\": false } }, \"accepts_from\": [ \"&time.*\", \"&reason.*\", \"query_context\", \"observation\", \"memory_batch\" ], \"feeds_into\": [ \"&reason.*\", \"&space.*\", \"output\" ], \"a2a_skills\": [ \"graph-memory-recall\", \"context-enrichment\", \"memory-consolidation\" ] } ~~~"}]},{"id":"blk-10203","kind":"heading","level":3,"spans":[{"id":"spn-9696","text":"Interpretation"}]},{"id":"blk-10204","kind":"paragraph","spans":[{"id":"spn-9697","text":"This contract says that "},{"id":"spn-9698","marks":["code"],"text":"&memory.graph"},{"id":"spn-9699","text":" can:"}]},{"id":"blk-10205","items":[{"blocks":[{"id":"blk-10207","kind":"paragraph","spans":[{"id":"spn-9700","text":"recall graph-linked knowledge from a query context"}]}],"id":"blk-10206","kind":"list-item"},{"blocks":[{"id":"blk-10209","kind":"paragraph","spans":[{"id":"spn-9701","text":"learn new observations"}]}],"id":"blk-10208","kind":"list-item"},{"blocks":[{"id":"blk-10211","kind":"paragraph","spans":[{"id":"spn-9702","text":"consolidate batches into stronger graph structure"}]}],"id":"blk-10210","kind":"list-item"},{"blocks":[{"id":"blk-10213","kind":"paragraph","spans":[{"id":"spn-9703","text":"enrich anomaly-oriented or operational context for downstream reasoning"}]}],"id":"blk-10212","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10214","kind":"paragraph","spans":[{"id":"spn-9704","text":"It also says that it composes especially naturally with:"}]},{"id":"blk-10215","items":[{"blocks":[{"id":"blk-10217","kind":"paragraph","spans":[{"id":"spn-9705","text":"temporal capabilities upstream"}]}],"id":"blk-10216","kind":"list-item"},{"blocks":[{"id":"blk-10219","kind":"paragraph","spans":[{"id":"spn-9706","text":"reasoning capabilities downstream"}]}],"id":"blk-10218","kind":"list-item"},{"blocks":[{"id":"blk-10221","kind":"paragraph","spans":[{"id":"spn-9707","text":"spatial capabilities downstream"}]}],"id":"blk-10220","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10222","kind":"heading","level":2,"spans":[{"id":"spn-9708","text":"5. Operations"}]},{"id":"blk-10223","kind":"heading","level":3,"spans":[{"id":"spn-9709","marks":["code"],"text":"recall"}]},{"id":"blk-10224","kind":"paragraph","spans":[{"id":"spn-9710","text":"Purpose:"}]},{"id":"blk-10225","items":[{"blocks":[{"id":"blk-10227","kind":"paragraph","spans":[{"id":"spn-9711","text":"retrieve relevant nodes, edges, and linked context"}]}],"id":"blk-10226","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10228","kind":"paragraph","spans":[{"id":"spn-9712","text":"Typical input:"}]},{"id":"blk-10229","items":[{"blocks":[{"id":"blk-10231","kind":"paragraph","spans":[{"id":"spn-9713","marks":["code"],"text":"query_context"}]}],"id":"blk-10230","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10232","kind":"paragraph","spans":[{"id":"spn-9714","text":"Typical output:"}]},{"id":"blk-10233","items":[{"blocks":[{"id":"blk-10235","kind":"paragraph","spans":[{"id":"spn-9715","marks":["code"],"text":"memory_hits"}]}],"id":"blk-10234","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10236","kind":"paragraph","spans":[{"id":"spn-9716","text":"Use when:"}]},{"id":"blk-10237","items":[{"blocks":[{"id":"blk-10239","kind":"paragraph","spans":[{"id":"spn-9717","text":"the agent needs graph-aware recall instead of plain document search"}]}],"id":"blk-10238","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10240","kind":"heading","level":3,"spans":[{"id":"spn-9718","marks":["code"],"text":"learn"}]},{"id":"blk-10241","kind":"paragraph","spans":[{"id":"spn-9719","text":"Purpose:"}]},{"id":"blk-10242","items":[{"blocks":[{"id":"blk-10244","kind":"paragraph","spans":[{"id":"spn-9720","text":"store new observations or relationship updates"}]}],"id":"blk-10243","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10245","kind":"paragraph","spans":[{"id":"spn-9721","text":"Typical input:"}]},{"id":"blk-10246","items":[{"blocks":[{"id":"blk-10248","kind":"paragraph","spans":[{"id":"spn-9722","marks":["code"],"text":"observation"}]}],"id":"blk-10247","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10249","kind":"paragraph","spans":[{"id":"spn-9723","text":"Typical output:"}]},{"id":"blk-10250","items":[{"blocks":[{"id":"blk-10252","kind":"paragraph","spans":[{"id":"spn-9724","marks":["code"],"text":"ack"}]}],"id":"blk-10251","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10253","kind":"paragraph","spans":[{"id":"spn-9725","text":"Use when:"}]},{"id":"blk-10254","items":[{"blocks":[{"id":"blk-10256","kind":"paragraph","spans":[{"id":"spn-9726","text":"the agent should update durable memory after a task or decision"}]}],"id":"blk-10255","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10257","kind":"heading","level":3,"spans":[{"id":"spn-9727","marks":["code"],"text":"consolidate"}]},{"id":"blk-10258","kind":"paragraph","spans":[{"id":"spn-9728","text":"Purpose:"}]},{"id":"blk-10259","items":[{"blocks":[{"id":"blk-10261","kind":"paragraph","spans":[{"id":"spn-9729","text":"merge repeated or fragmented knowledge into more stable graph structure"}]}],"id":"blk-10260","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10262","kind":"paragraph","spans":[{"id":"spn-9730","text":"Typical input:"}]},{"id":"blk-10263","items":[{"blocks":[{"id":"blk-10265","kind":"paragraph","spans":[{"id":"spn-9731","marks":["code"],"text":"memory_batch"}]}],"id":"blk-10264","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10266","kind":"paragraph","spans":[{"id":"spn-9732","text":"Typical output:"}]},{"id":"blk-10267","items":[{"blocks":[{"id":"blk-10269","kind":"paragraph","spans":[{"id":"spn-9733","marks":["code"],"text":"graph_update"}]}],"id":"blk-10268","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10270","kind":"paragraph","spans":[{"id":"spn-9734","text":"Use when:"}]},{"id":"blk-10271","items":[{"blocks":[{"id":"blk-10273","kind":"paragraph","spans":[{"id":"spn-9735","text":"the system accumulates many observations and needs durable structure"}]}],"id":"blk-10272","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10274","kind":"heading","level":3,"spans":[{"id":"spn-9736","marks":["code"],"text":"enrich"}]},{"id":"blk-10275","kind":"paragraph","spans":[{"id":"spn-9737","text":"Purpose:"}]},{"id":"blk-10276","items":[{"blocks":[{"id":"blk-10278","kind":"paragraph","spans":[{"id":"spn-9738","text":"attach graph-linked historical or dependency context to an existing payload"}]}],"id":"blk-10277","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10279","kind":"paragraph","spans":[{"id":"spn-9739","text":"Typical input:"}]},{"id":"blk-10280","items":[{"blocks":[{"id":"blk-10282","kind":"paragraph","spans":[{"id":"spn-9740","marks":["code"],"text":"anomaly_set"},{"id":"spn-9741","text":" or compatible context object"}]}],"id":"blk-10281","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10283","kind":"paragraph","spans":[{"id":"spn-9742","text":"Typical output:"}]},{"id":"blk-10284","items":[{"blocks":[{"id":"blk-10286","kind":"paragraph","spans":[{"id":"spn-9743","marks":["code"],"text":"enriched_context"}]}],"id":"blk-10285","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10287","kind":"paragraph","spans":[{"id":"spn-9744","text":"Use when:"}]},{"id":"blk-10288","items":[{"blocks":[{"id":"blk-10290","kind":"paragraph","spans":[{"id":"spn-9745","text":"another capability has already produced a signal and graph memory should make it more useful"}]}],"id":"blk-10289","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10291","kind":"heading","level":2,"spans":[{"id":"spn-9746","text":"6. Architecture patterns"}]},{"id":"blk-10292","kind":"heading","level":3,"spans":[{"id":"spn-9747","text":"Pattern A: anomaly enrichment"}]},{"id":"blk-10293","kind":"paragraph","spans":[{"id":"spn-9748","text":"~~~text stream_data"}]},{"id":"blk-10294","kind":"paragraph","spans":[{"id":"spn-9749","text":"~~~"}]},{"id":"blk-10295","kind":"paragraph","spans":[{"id":"spn-9750","text":"What happens:"}]},{"id":"blk-10296","items":[{"blocks":[{"id":"blk-10298","kind":"paragraph","spans":[{"id":"spn-9751","text":"a temporal capability detects anomalies"}]}],"id":"blk-10297","kind":"list-item"},{"blocks":[{"id":"blk-10300","kind":"paragraph","spans":[{"id":"spn-9752","text":"graph memory adds linked incident and dependency context"}]}],"id":"blk-10299","kind":"list-item"},{"blocks":[{"id":"blk-10302","kind":"paragraph","spans":[{"id":"spn-9753","text":"reasoning evaluates the best action"}]}],"id":"blk-10301","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10303","kind":"paragraph","spans":[{"id":"spn-9754","text":"This is one of the strongest "},{"id":"spn-9755","marks":["code"],"text":"&memory.graph"},{"id":"spn-9756","text":" patterns."}]},{"id":"blk-10304","kind":"heading","level":3,"spans":[{"id":"spn-9757","text":"Pattern B: research knowledge graph"}]},{"id":"blk-10305","kind":"paragraph","spans":[{"id":"spn-9758","text":"~~~text research_query"}]},{"id":"blk-10306","kind":"paragraph","spans":[{"id":"spn-9759","text":"~~~"}]},{"id":"blk-10307","kind":"paragraph","spans":[{"id":"spn-9760","text":"What happens:"}]},{"id":"blk-10308","items":[{"blocks":[{"id":"blk-10310","kind":"paragraph","spans":[{"id":"spn-9761","text":"graph memory retrieves claims, relationships, and prior linked knowledge"}]}],"id":"blk-10309","kind":"list-item"},{"blocks":[{"id":"blk-10312","kind":"paragraph","spans":[{"id":"spn-9762","text":"reasoning compares or synthesizes evidence"}]}],"id":"blk-10311","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10313","kind":"heading","level":3,"spans":[{"id":"spn-9763","text":"Pattern C: learning from outcomes"}]},{"id":"blk-10314","kind":"paragraph","spans":[{"id":"spn-9764","text":"~~~text decision_outcome"}]},{"id":"blk-10315","kind":"paragraph","spans":[{"id":"spn-9765","text":"~~~"}]},{"id":"blk-10316","kind":"paragraph","spans":[{"id":"spn-9766","text":"What happens:"}]},{"id":"blk-10317","items":[{"blocks":[{"id":"blk-10319","kind":"paragraph","spans":[{"id":"spn-9767","text":"outcome evidence is added to graph memory"}]}],"id":"blk-10318","kind":"list-item"},{"blocks":[{"id":"blk-10321","kind":"paragraph","spans":[{"id":"spn-9768","text":"repeated or related observations are consolidated"}]}],"id":"blk-10320","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-10322","kind":"paragraph","spans":[{"id":"spn-9769","text":"This supports continual learning without discarding structure."}]},{"id":"blk-10323","kind":"heading","level":2,"spans":[{"id":"spn-9770","text":"7. Architecture diagram"}]},{"id":"blk-10324","kind":"paragraph","spans":[{"id":"spn-9771","text":"A simple mental model for "},{"id":"spn-9772","marks":["code"],"text":"&memory.graph"},{"id":"spn-9773","text":":"}]},{"id":"blk-10325","kind":"paragraph","spans":[{"id":"spn-9774","text":"~~~text ┌─────────────────────┐ │   incoming signal   │ │  query / anomaly /  │ │     observation     │ └─────────┬───────────┘ │ ▼ ┌─────────────────────┐ │   &memory.graph     │ │                     │ │  - recall           │ │  - enrich           │ │  - learn            │ │  - consolidate      │ └─────────┬───────────┘ │ ┌──────────────┼──────────────┐ │              │              │ ▼              ▼              ▼ ┌────────────────┐ ┌──────────────┐ ┌───────────────┐ │ enriched       │ │ graph update │ │ memory hits   │ │ context        │ │ / ack        │ │ / linked facts│ └──────┬─────────┘ └──────────────┘ └───────────────┘ │ ▼ ┌─────────────────────┐ │ downstream reason / │ │ space / output flow │ └─────────────────────┘ ~~~"}]},{"id":"blk-10326","kind":"heading","level":2,"spans":[{"id":"spn-9775","text":"8. Example declaration"}]},{"id":"blk-10327","kind":"paragraph","spans":[{"id":"spn-9776","text":"A concrete "},{"id":"spn-9777","marks":["code"],"text":"ampersand.json"},{"id":"spn-9778","text":" fragment:"}]},{"id":"blk-10328","kind":"paragraph","spans":[{"id":"spn-9779","text":"~~~json { \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"infra-ops\" } } } ~~~"}]},{"id":"blk-10329","kind":"paragraph","spans":[{"id":"spn-9780","text":"A fuller declaration:"}]},{"id":"blk-10330","kind":"paragraph","spans":[{"id":"spn-9781","text":"~~~json { \"$schema\": \"https://protocol.ampersandboxdesign.com/schema/v0.1.0/ampersand.schema.json\", \"agent\": \"InfraOperator\", \"version\": \"1.0.0\", \"capabilities\": { \"&memory.graph\": { \"provider\": \"graphonomous\", \"config\": { \"instance\": \"infra-ops\" } }, \"&time.anomaly\": { \"provider\": \"ticktickclock\", \"config\": { \"streams\": [\"cpu\", \"mem\"] } }, \"&space.fleet\": { \"provider\": \"geofleetic\", \"config\": { \"regions\": [\"us-east\"] } }, \"&reason.argument\": { \"provider\": \"deliberatic\", \"config\": { \"governance\": \"constitutional\" } } }, \"provenance\": true } ~~~"}]},{"id":"blk-10331","kind":"heading","level":2,"spans":[{"id":"spn-9782","text":"9. Example API shape"}]},{"id":"blk-10332","kind":"paragraph","spans":[{"id":"spn-9783","text":"A provider-specific API may vary, but the protocol-level shape can look like this."}]},{"id":"blk-10333","kind":"heading","level":3,"spans":[{"id":"spn-9784","text":"Recall request"}]},{"id":"blk-10334","kind":"paragraph","spans":[{"id":"spn-9785","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"recall\", \"input\": { \"query_context\": { \"incident_type\": \"cpu_spike\", \"region\": \"us-east\", \"service\": \"api-gateway\" } } } ~~~"}]},{"id":"blk-10335","kind":"heading","level":3,"spans":[{"id":"spn-9786","text":"Recall response"}]},{"id":"blk-10336","kind":"paragraph","spans":[{"id":"spn-9787","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"recall\", \"output\": { \"memory_hits\": [ { \"entity\": \"incident-4821\", \"summary\": \"CPU saturation on api-gateway during regional traffic spike\", \"links\": [\"service:api-gateway\", \"region:us-east\", \"runbook:scale-gateway\"] }, { \"entity\": \"incident-4792\", \"summary\": \"Dependency saturation caused by cache failure\", \"links\": [\"service:cache\", \"service:api-gateway\"] } ] } } ~~~"}]},{"id":"blk-10337","kind":"heading","level":3,"spans":[{"id":"spn-9788","text":"Enrich request"}]},{"id":"blk-10338","kind":"paragraph","spans":[{"id":"spn-9789","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"enrich\", \"input\": { \"anomaly_set\": { \"service\": \"api-gateway\", \"region\": \"us-east\", \"anomalies\": [\"cpu_spike\", \"latency_jump\"] } } } ~~~"}]},{"id":"blk-10339","kind":"heading","level":3,"spans":[{"id":"spn-9790","text":"Enrich response"}]},{"id":"blk-10340","kind":"paragraph","spans":[{"id":"spn-9791","text":"~~~json { \"capability\": \"&memory.graph\", \"operation\": \"enrich\", \"output\": { \"enriched_context\": { \"related_incidents\": [\"incident-4821\", \"incident-4792\"], \"related_entities\": [\"service:cache\", \"service:api-gateway\", \"region:us-east\"], \"suggested_runbooks\": [\"scale-gateway\", \"check-cache-health\"] } } } ~~~"}]},{"id":"blk-10341","kind":"heading","level":2,"spans":[{"id":"spn-9792","text":"10. Compatible providers"}]},{"id":"blk-10342","kind":"paragraph","spans":[{"id":"spn-9793","marks":["code"],"text":"&memory.graph"},{"id":"spn-9794","text":" is a capability interface. Compatible providers are implementations that can satisfy the contract."}]},{"id":"blk-10343","kind":"paragraph","spans":[{"id":"spn-9795","text":"Representative providers:"}]},{"id":"blk-10344","items":[{"blocks":[{"id":"blk-10346","kind":"paragraph","spans":[{"id":"spn-9796","marks":["code"],"text":"graphonomous"}]}],"id":"blk-10345","kind":"list-item"},{"blocks":[{"id":"blk-10348","kind":"paragraph","spans":[{"id":"spn-9797","marks":["code"],"text":"neo4j-memory"}]}],"id":"blk-10347","kind":"list-item"},{"blocks":[{"id":"blk-10350","kind":"paragraph","spans":[{"id":"spn-9798","text":"custom graph-backed MCP services"}]}],"id":"blk-10349","kind":"list-item"},{"blocks":[{"id":"blk-10352","kind":"paragraph","spans":[{"id":"spn-9799","text":"domain-specific knowledge graph systems wrapped behind a protocol-compatible surface"}]}],"id":"blk-10351","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10353","kind":"heading","level":3,"spans":[{"id":"spn-9800","text":"Current default ecosystem fit"}]},{"id":"blk-10354","items":[{"blocks":[{"id":"blk-10356","kind":"paragraph","spans":[{"id":"spn-9801","marks":["code"],"text":"graphonomous"},{"id":"spn-9802","text":" is the clearest default example provider in this repository"}]}],"id":"blk-10355","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10357","kind":"paragraph","spans":[{"id":"spn-9803","text":"Why it fits:"}]},{"id":"blk-10358","items":[{"blocks":[{"id":"blk-10360","kind":"paragraph","spans":[{"id":"spn-9804","text":"graph-oriented memory model"}]}],"id":"blk-10359","kind":"list-item"},{"blocks":[{"id":"blk-10362","kind":"paragraph","spans":[{"id":"spn-9805","text":"MCP-friendly runtime shape"}]}],"id":"blk-10361","kind":"list-item"},{"blocks":[{"id":"blk-10364","kind":"paragraph","spans":[{"id":"spn-9806","text":"suitable for recall, enrichment, and learning workflows"}]}],"id":"blk-10363","kind":"list-item"},{"blocks":[{"id":"blk-10366","kind":"paragraph","spans":[{"id":"spn-9807","text":"directly useful for infra, research, and agent memory scenarios"}]}],"id":"blk-10365","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10367","kind":"heading","level":2,"spans":[{"id":"spn-9808","text":"11. A2A-facing skills"}]},{"id":"blk-10368","kind":"paragraph","spans":[{"id":"spn-9809","text":"A "},{"id":"spn-9810","marks":["code"],"text":"&memory.graph"},{"id":"spn-9811","text":" capability may advertise skills such as:"}]},{"id":"blk-10369","items":[{"blocks":[{"id":"blk-10371","kind":"paragraph","spans":[{"id":"spn-9812","marks":["code"],"text":"graph-memory-recall"}]}],"id":"blk-10370","kind":"list-item"},{"blocks":[{"id":"blk-10373","kind":"paragraph","spans":[{"id":"spn-9813","marks":["code"],"text":"context-enrichment"}]}],"id":"blk-10372","kind":"list-item"},{"blocks":[{"id":"blk-10375","kind":"paragraph","spans":[{"id":"spn-9814","marks":["code"],"text":"memory-consolidation"}]}],"id":"blk-10374","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10376","kind":"paragraph","spans":[{"id":"spn-9815","text":"These skills are useful when generating A2A agent cards from a declaration, because they let an externally visible agent surface say more than just “has memory.”"}]},{"id":"blk-10377","kind":"heading","level":2,"spans":[{"id":"spn-9816","text":"12. Governance implications"}]},{"id":"blk-10378","kind":"paragraph","spans":[{"id":"spn-9817","text":"Graph memory often sits close to high-value historical context, so governance matters."}]},{"id":"blk-10379","kind":"paragraph","spans":[{"id":"spn-9818","text":"Examples of governance constraints that commonly pair with "},{"id":"spn-9819","marks":["code"],"text":"&memory.graph"},{"id":"spn-9820","text":":"}]},{"id":"blk-10380","kind":"heading","level":3,"spans":[{"id":"spn-9821","text":"Hard constraints"}]},{"id":"blk-10381","items":[{"blocks":[{"id":"blk-10383","kind":"paragraph","spans":[{"id":"spn-9822","text":"never reveal private customer-linked graph context outside authorized workflows"}]}],"id":"blk-10382","kind":"list-item"},{"blocks":[{"id":"blk-10385","kind":"paragraph","spans":[{"id":"spn-9823","text":"never delete incident lineage without human approval"}]}],"id":"blk-10384","kind":"list-item"},{"blocks":[{"id":"blk-10387","kind":"paragraph","spans":[{"id":"spn-9824","text":"always preserve audit trail for graph-backed decision support"}]}],"id":"blk-10386","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10388","kind":"heading","level":3,"spans":[{"id":"spn-9825","text":"Soft constraints"}]},{"id":"blk-10389","items":[{"blocks":[{"id":"blk-10391","kind":"paragraph","spans":[{"id":"spn-9826","text":"prefer policy-grounded linked evidence over unsupported inference"}]}],"id":"blk-10390","kind":"list-item"},{"blocks":[{"id":"blk-10393","kind":"paragraph","spans":[{"id":"spn-9827","text":"prefer recent validated graph context when conflicts exist"}]}],"id":"blk-10392","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10394","kind":"heading","level":3,"spans":[{"id":"spn-9828","text":"Escalation triggers"}]},{"id":"blk-10395","items":[{"blocks":[{"id":"blk-10397","kind":"paragraph","spans":[{"id":"spn-9829","text":"escalate when confidence in recalled graph context is below threshold"}]}],"id":"blk-10396","kind":"list-item"},{"blocks":[{"id":"blk-10399","kind":"paragraph","spans":[{"id":"spn-9830","text":"escalate when a decision depends on sparse or conflicting graph evidence"}]}],"id":"blk-10398","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10400","kind":"heading","level":2,"spans":[{"id":"spn-9831","text":"13. Provenance implications"}]},{"id":"blk-10401","kind":"paragraph","spans":[{"id":"spn-9832","marks":["code"],"text":"&memory.graph"},{"id":"spn-9833","text":" should participate in the provenance chain."}]},{"id":"blk-10402","kind":"paragraph","spans":[{"id":"spn-9834","text":"Representative provenance record:"}]},{"id":"blk-10403","kind":"paragraph","spans":[{"id":"spn-9835","text":"~~~json { \"source\": \"&memory.graph\", \"provider\": \"graphonomous\", \"operation\": \"enrich\", \"timestamp\": \"2026-03-14T14:23:07Z\", \"input_hash\": \"sha256:1a2b...\", \"output_hash\": \"sha256:7c8d...\", \"parent_hash\": \"sha256:0000...\" } ~~~"}]},{"id":"blk-10404","kind":"paragraph","spans":[{"id":"spn-9836","text":"This matters because graph-backed context often strongly influences downstream reasoning. If a system chooses a remediation path because graph memory linked the current issue to prior incidents, that enrichment step should be auditable."}]},{"id":"blk-10405","kind":"heading","level":2,"spans":[{"id":"spn-9837","text":"14. Typical use cases"}]},{"id":"blk-10406","kind":"paragraph","spans":[{"id":"spn-9838","marks":["code"],"text":"&memory.graph"},{"id":"spn-9839","text":" is especially strong in the following domains."}]},{"id":"blk-10407","kind":"heading","level":3,"spans":[{"id":"spn-9840","text":"Infrastructure operations"}]},{"id":"blk-10408","items":[{"blocks":[{"id":"blk-10410","kind":"paragraph","spans":[{"id":"spn-9841","text":"dependency-aware incident recall"}]}],"id":"blk-10409","kind":"list-item"},{"blocks":[{"id":"blk-10412","kind":"paragraph","spans":[{"id":"spn-9842","text":"similar outage enrichment"}]}],"id":"blk-10411","kind":"list-item"},{"blocks":[{"id":"blk-10414","kind":"paragraph","spans":[{"id":"spn-9843","text":"durable operational knowledge"}]}],"id":"blk-10413","kind":"list-item"},{"blocks":[{"id":"blk-10416","kind":"paragraph","spans":[{"id":"spn-9844","text":"continual learning from postmortems"}]}],"id":"blk-10415","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10417","kind":"heading","level":3,"spans":[{"id":"spn-9845","text":"Research systems"}]},{"id":"blk-10418","items":[{"blocks":[{"id":"blk-10420","kind":"paragraph","spans":[{"id":"spn-9846","text":"linked concepts and citations"}]}],"id":"blk-10419","kind":"list-item"},{"blocks":[{"id":"blk-10422","kind":"paragraph","spans":[{"id":"spn-9847","text":"claim/evidence relationship structure"}]}],"id":"blk-10421","kind":"list-item"},{"blocks":[{"id":"blk-10424","kind":"paragraph","spans":[{"id":"spn-9848","text":"durable research graph building"}]}],"id":"blk-10423","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-10425","kind":"heading","level":3,"spans":[{"id":"spn-9849","text":"Customer support"}]},{"id":"blk-10426","items":[{"blocks":[{"id":"blk-10428","kind":"paragraph","spans":[{"id":"spn-9850","text":"account and case relationship modeling"}]}],"id":"blk-10427","kind":"list-item"},{"blocks":[{"id":"blk-10430","kind":"paragraph","spans":[{"id":"spn-9851","text":"escalation lineage"}]}],"id":"blk-10429","kind":"list-item"},{"blocks":[{"id":"blk-10432","kind":"paragraph","span