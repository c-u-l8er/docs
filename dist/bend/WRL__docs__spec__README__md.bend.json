{"bendscript":"0.1","blocks":[{"id":"blk-42998","kind":"heading","level":1,"spans":[{"id":"spn-72337","text":"WallRiderLang — spec index"}]},{"id":"blk-42999","kind":"paragraph","spans":[{"id":"spn-72338","marks":["bold"],"text":"WRL is an executable topology language whose meaning is a hash."}]},{"id":"blk-43000","kind":"paragraph","spans":[{"id":"spn-72339","text":"This file is the "},{"id":"spn-72340","marks":["italic"],"text":"index"},{"id":"spn-72341","text":" to the WRL specification. It is not the specification. The normative text is "},{"id":"spn-72342","marks":[{"kind":"link","predicate":"cites","target":"../../spec.html"}],"text":"`spec.html`"},{"id":"spn-72343","text":" "},{"id":"spn-72344","marks":["bold"],"text":"Part I — WRL Core 0.1.2, the frozen family extract"},{"id":"spn-72345","text":"; where this page and that page disagree, that page wins. Part II of the same document is a non-normative design draft and binds nothing."}]},{"id":"blk-43001","kind":"heading","level":2,"spans":[{"id":"spn-72346","text":"Where each thing lives"}]},{"head":[{"id":"blk-43003","spans":[{"id":"spn-72347","text":"Artifact"}]},{"id":"blk-43004","spans":[{"id":"spn-72348","text":"What it is"}]},{"id":"blk-43005","spans":[{"id":"spn-72349","text":"Status"}]}],"id":"blk-43002","kind":"table","rows":[[{"id":"blk-43006","spans":[{"id":"spn-72350","marks":[{"kind":"link","predicate":"cites","target":"../../spec.html"}],"text":"`spec.html`"},{"id":"spn-72351","text":" Part I"}]},{"id":"blk-43007","spans":[{"id":"spn-72352","marks":["bold"],"text":"WRL Core 0.1.2"},{"id":"spn-72353","text":" — the normative frozen family extract"}]},{"id":"blk-43008","spans":[{"id":"spn-72354","marks":["bold"],"text":"normative"}]}],[{"id":"blk-43009","spans":[{"id":"spn-72355","marks":[{"kind":"link","predicate":"cites","target":"../../spec.html"}],"text":"`spec.html`"},{"id":"spn-72356","text":" Part II"}]},{"id":"blk-43010","spans":[{"id":"spn-72357","text":"design draft, stated in the spec's own language"}]},{"id":"blk-43011","spans":[{"id":"spn-72358","text":"non-normative"}]}],[{"id":"blk-43012","spans":[{"id":"spn-72359","marks":[{"kind":"link","predicate":"cites","target":"../../reference.html"}],"text":"`reference.html`"}]},{"id":"blk-43013","spans":[{"id":"spn-72360","text":"every table: grammar, roles, ports, edges, clocks, rotors, sugar bounds, diagnostic codes, pinned policy ids, stability tiers"}]},{"id":"blk-43014","spans":[{"id":"spn-72361","text":"normative tables"}]}],[{"id":"blk-43015","spans":[{"id":"spn-72362","marks":[{"kind":"link","predicate":"cites","target":"../../draft.html"}],"text":"`draft.html`"}]},{"id":"blk-43016","spans":[{"id":"spn-72363","text":"the authored full-language design, Parts II–VI, each section marked Core / Experimental / Proposed"}]},{"id":"blk-43017","spans":[{"id":"spn-72364","marks":["bold"],"text":"not built"}]}],[{"id":"blk-43018","spans":[{"id":"spn-72365","marks":[{"kind":"link","predicate":"cites","target":"../../direction.html"}],"text":"`direction.html`"}]},{"id":"blk-43019","spans":[{"id":"spn-72366","text":"what the language is "},{"id":"spn-72367","marks":["italic"],"text":"for"},{"id":"spn-72368","text":", the honest scorecard, and the dependency-ordered list of what is missing"}]},{"id":"blk-43020","spans":[{"id":"spn-72369","text":"argument"}]}],[{"id":"blk-43021","spans":[{"id":"spn-72370","marks":[{"kind":"link","predicate":"cites","target":"../../guide.html"}],"text":"`guide.html`"},{"id":"spn-72371","text":" · "},{"id":"spn-72372","marks":[{"kind":"link","predicate":"cites","target":"../../learn.html"}],"text":"`learn.html`"}]},{"id":"blk-43022","spans":[{"id":"spn-72373","text":"the language guide and the 20-minute tutorial"}]},{"id":"blk-43023","spans":[{"id":"spn-72374","text":"teaching"}]}],[{"id":"blk-43024","spans":[{"id":"spn-72375","marks":[{"kind":"link","predicate":"cites","target":"../../playground.html"}],"text":"`playground.html`"}]},{"id":"blk-43025","spans":[{"id":"spn-72376","text":"live browser playground that computes real "},{"id":"spn-72377","marks":["code"],"text":"SemanticArtifactID"},{"id":"spn-72378","text":"s"}]},{"id":"blk-43026","spans":[{"id":"spn-72379","text":"executable"}]}]]},{"id":"blk-43027","kind":"paragraph","spans":[{"id":"spn-72380","text":"The reference implementation of the identity spine lives in this repository as "},{"id":"spn-72381","marks":[{"kind":"link","predicate":"cites","target":"../../wrl.js"}],"text":"`wrl.js`"},{"id":"spn-72382","text":"; the runtime that "},{"id":"spn-72383","marks":["italic"],"text":"executes"},{"id":"spn-72384","text":" what WRL denotes lives in "},{"id":"spn-72385","marks":[{"kind":"link","predicate":"cites","target":"../../../TRVM/forge"}],"text":"TRVM Forge"},{"id":"spn-72386","text":"."}]},{"id":"blk-43028","kind":"heading","level":2,"spans":[{"id":"spn-72387","text":"What is frozen"}]},{"id":"blk-43029","kind":"paragraph","spans":[{"id":"spn-72388","text":"Freezing a "},{"id":"spn-72389","marks":["bold"],"text":"family"},{"id":"spn-72390","text":" means the set of members is closed and each member's meaning-role is settled. It does "},{"id":"spn-72391","marks":["bold"],"text":"not"},{"id":"spn-72392","text":" freeze exact glyphs, argument grammars, sugar, or edge-case rules. Read "},{"id":"spn-72393","marks":[{"kind":"link","predicate":"cites","target":"../../reference.html#tiers"}],"text":"the stability tier table"},{"id":"spn-72394","text":" before building on anything."}]},{"head":[{"id":"blk-43031","spans":[{"id":"spn-72395","text":"Thing"}]},{"id":"blk-43032","spans":[{"id":"spn-72396","text":"State"}]}],"id":"blk-43030","kind":"table","rows":[[{"id":"blk-43033","spans":[{"id":"spn-72397","text":"WRL Core"}]},{"id":"blk-43034","spans":[{"id":"spn-72398","marks":["bold"],"text":"0.1.2 — frozen"},{"id":"spn-72399","text":" (families only)"}]}],[{"id":"blk-43035","spans":[{"id":"spn-72400","text":"Forge Semantic IR 1.x"}]},{"id":"blk-43036","spans":[{"id":"spn-72401","marks":["bold"],"text":"frozen"},{"id":"spn-72402","text":" ("},{"id":"spn-72403","marks":["code"],"text":"forge.world.core.v1"},{"id":"spn-72404","text":")"}]}],[{"id":"blk-43037","spans":[{"id":"spn-72405","text":"Forge Semantic IR 2.0"}]},{"id":"blk-43038","spans":[{"id":"spn-72406","marks":["bold"],"text":"draft — implemented"},{"id":"spn-72407","text":" ("},{"id":"spn-72408","marks":[{"kind":"link","predicate":"cites","target":"../../relation-v2.js"}],"text":"`relation-v2.js`"},{"id":"spn-72409","text":"); named relations over the "},{"id":"spn-72410","marks":["italic"],"text":"same"},{"id":"spn-72411","text":" profile, both pinned ids unmoved"}]}],[{"id":"blk-43039","spans":[{"id":"spn-72412","text":"§D8 relation model"}]},{"id":"blk-43040","spans":[{"id":"spn-72413","marks":["bold"],"text":"draft"},{"id":"spn-72414","text":" — the period-0 arithmetic runs; §D8.4, §D8.6 and all of §D9 do not"}]}],[{"id":"blk-43041","spans":[{"id":"spn-72415","text":"Surface sugar"}]},{"id":"blk-43042","spans":[{"id":"spn-72416","marks":["code"],"text":"sugar.v2"},{"id":"spn-72417","text":" — implemented, battery green, identity-equivalent, "},{"id":"spn-72418","marks":["bold"],"text":"not frozen"}]}],[{"id":"blk-43043","spans":[{"id":"spn-72419","text":"Route texture "},{"id":"spn-72420","marks":["code"],"text":"--"}]},{"id":"blk-43044","spans":[{"id":"spn-72421","text":"surface-grounded"}]}],[{"id":"blk-43045","spans":[{"id":"spn-72422","text":"Route textures "},{"id":"spn-72423","marks":["code"],"text":"~~"},{"id":"spn-72424","text":" "},{"id":"spn-72425","marks":["code"],"text":"=="},{"id":"spn-72426","text":" "},{"id":"spn-72427","marks":["code"],"text":"!!"}]},{"id":"blk-43046","spans":[{"id":"spn-72428","text":"partial — the notation is frozen, the surface construct is not writable"}]}]]},{"id":"blk-43047","kind":"heading","level":2,"spans":[{"id":"spn-72429","text":"The writable surface, in full"}]},{"id":"blk-43048","kind":"paragraph","spans":[{"id":"spn-72430","text":"A world document opens with exactly one "},{"id":"spn-72431","marks":["code"],"text":"profile <id>"},{"id":"spn-72432","text":" line (comments and blank lines may precede it; nothing else may). A profile-only document is legal — it is the "},{"id":"spn-72433","marks":["bold"],"text":"empty world"},{"id":"spn-72434","text":", and it seals."}]},{"id":"blk-43049","kind":"code","language":"text","text":"profile-line ::= \"profile\" WS profile-id\ndeclaration  ::= \"[\" role \":\" id \"]\" [ config ] [ ports ]\nedge         ::= \"[\" [ role \":\" ] id \"]\" \"--\" edge-tag \"-->\" \"[\" [ role \":\" ] id \"]\"\n\nconfig       ::= \"(\" [ config-item ( \",\" config-item )* ] \")\"\nports        ::= \"{\" [ port ( \",\" port )* ] \"}\"\nconfig-item  ::= key \"=\" value | clock-sugar | \"configurable\"\n\nrole         ::= \"pulser\" | \"relay\" | \"door\" | \"spinner\" | \"orb\"\nedge-tag     ::= \"sig\" | \"socket\"\nid           ::= WORD   ; [A-Za-z0-9_]+, and MUST NOT contain \"__\"\ncomment      ::= \";\" ANY*"},{"id":"blk-43050","kind":"paragraph","spans":[{"id":"spn-72435","text":"Five roles, two edge kinds, one grounded texture. That is the whole language you can type today."}]},{"id":"blk-43051","kind":"heading","level":3,"spans":[{"id":"spn-72436","text":"Roles and their frozen port signatures"}]},{"head":[{"id":"blk-43053","spans":[{"id":"spn-72437","text":"Role"}]},{"id":"blk-43054","spans":[{"id":"spn-72438","text":"Canonical"}]},{"id":"blk-43055","spans":[{"id":"spn-72439","text":"out"}]},{"id":"blk-43056","spans":[{"id":"spn-72440","text":"in"}]}],"id":"blk-43052","kind":"table","rows":[[{"id":"blk-43057","spans":[{"id":"spn-72441","marks":["code"],"text":"pulser"}]},{"id":"blk-43058","spans":[{"id":"spn-72442","marks":["code"],"text":"Pulser"}]},{"id":"blk-43059","spans":[{"id":"spn-72443","marks":["code"],"text":"sig_out"}]},{"id":"blk-43060","spans":[{"id":"spn-72444","text":"—"}]}],[{"id":"blk-43061","spans":[{"id":"spn-72445","marks":["code"],"text":"relay"}]},{"id":"blk-43062","spans":[{"id":"spn-72446","marks":["code"],"text":"Relay"}]},{"id":"blk-43063","spans":[{"id":"spn-72447","marks":["code"],"text":"sig_out"}]},{"id":"blk-43064","spans":[{"id":"spn-72448","marks":["code"],"text":"sig_in"}]}],[{"id":"blk-43065","spans":[{"id":"spn-72449","marks":["code"],"text":"door"}]},{"id":"blk-43066","spans":[{"id":"spn-72450","marks":["code"],"text":"Door"}]},{"id":"blk-43067","spans":[{"id":"spn-72451","text":"—"}]},{"id":"blk-43068","spans":[{"id":"spn-72452","marks":["code"],"text":"sig_in"}]}],[{"id":"blk-43069","spans":[{"id":"spn-72453","marks":["code"],"text":"spinner"}]},{"id":"blk-43070","spans":[{"id":"spn-72454","marks":["code"],"text":"Spinner"}]},{"id":"blk-43071","spans":[{"id":"spn-72455","marks":["code"],"text":"socket"}]},{"id":"blk-43072","spans":[{"id":"spn-72456","marks":["code"],"text":"sig_in"}]}],[{"id":"blk-43073","spans":[{"id":"spn-72457","marks":["code"],"text":"orb"}]},{"id":"blk-43074","spans":[{"id":"spn-72458","marks":["code"],"text":"Orb"}]},{"id":"blk-43075","spans":[{"id":"spn-72459","text":"—"}]},{"id":"blk-43076","spans":[{"id":"spn-72460","marks":["code"],"text":"pose"}]}],[{"id":"blk-43077","spans":[{"id":"spn-72461","text":"— none —"}]},{"id":"blk-43078","spans":[{"id":"spn-72462","marks":["code"],"text":"Mailbox"}]},{"id":"blk-43079","spans":[{"id":"spn-72463","text":"—"}]},{"id":"blk-43080","spans":[{"id":"spn-72464","text":"—"}]}]]},{"id":"blk-43081","kind":"paragraph","spans":[{"id":"spn-72465","marks":["code"],"text":"Mailbox"},{"id":"spn-72466","text":" has "},{"id":"spn-72467","marks":["bold"],"text":"no surface spelling"},{"id":"spn-72468","text":". It is IR/runtime-grounded — it exists in the canonical IR and the runtime honours it — but WRL source cannot declare it and the formatter cannot emit it. It is therefore not a sixth writable role, and its presence does not mean the async route texture was promoted."}]},{"id":"blk-43082","kind":"paragraph","spans":[{"id":"spn-72469","text":"The "},{"id":"spn-72470","marks":["code"],"text":"{…}"},{"id":"spn-72471","text":" group on a declaration is "},{"id":"spn-72472","marks":["italic"],"text":"checked against"},{"id":"spn-72473","text":" the port table, not defined by it. The state schema reference is derived, never written: "},{"id":"spn-72474","marks":["code"],"text":"state.<role lowercased>.v1"},{"id":"spn-72475","text":"."}]},{"id":"blk-43083","kind":"heading","level":3,"spans":[{"id":"spn-72476","text":"Edge kinds"}]},{"head":[{"id":"blk-43085","spans":[{"id":"spn-72477","text":"Surface tag"}]},{"id":"blk-43086","spans":[{"id":"spn-72478","text":"Canonical kind"}]},{"id":"blk-43087","spans":[{"id":"spn-72479","text":"Source port"}]},{"id":"blk-43088","spans":[{"id":"spn-72480","text":"Destination port"}]},{"id":"blk-43089","spans":[{"id":"spn-72481","text":"Legal sources"}]},{"id":"blk-43090","spans":[{"id":"spn-72482","text":"Legal destinations"}]}],"id":"blk-43084","kind":"table","rows":[[{"id":"blk-43091","spans":[{"id":"spn-72483","marks":["code"],"text":"--sig-->"}]},{"id":"blk-43092","spans":[{"id":"spn-72484","marks":["code"],"text":"SignalWire"}]},{"id":"blk-43093","spans":[{"id":"spn-72485","marks":["code"],"text":"sig_out"}]},{"id":"blk-43094","spans":[{"id":"spn-72486","marks":["code"],"text":"sig_in"}]},{"id":"blk-43095","spans":[{"id":"spn-72487","text":"Pulser, Relay"}]},{"id":"blk-43096","spans":[{"id":"spn-72488","text":"Relay, Door, Spinner"}]}],[{"id":"blk-43097","spans":[{"id":"spn-72489","marks":["code"],"text":"--socket-->"}]},{"id":"blk-43098","spans":[{"id":"spn-72490","marks":["code"],"text":"SocketControl"}]},{"id":"blk-43099","spans":[{"id":"spn-72491","marks":["code"],"text":"socket"}]},{"id":"blk-43100","spans":[{"id":"spn-72492","marks":["code"],"text":"pose"}]},{"id":"blk-43101","spans":[{"id":"spn-72493","text":"Spinner"}]},{"id":"blk-43102","spans":[{"id":"spn-72494","text":"Orb"}]}]]},{"id":"blk-43103","kind":"paragraph","spans":[{"id":"spn-72495","marks":["bold"],"text":"At most one edge may land on any input port."},{"id":"spn-72496","text":" Fan-out is unrestricted; fan-in is "},{"id":"spn-72497","marks":["code"],"text":"WRL_CONTROLLER_CONFLICT"},{"id":"spn-72498","text":"."}]},{"id":"blk-43104","kind":"heading","level":2,"spans":[{"id":"spn-72499","text":"Rules that exist because identity is a hash"}]},{"id":"blk-43105","kind":"paragraph","spans":[{"id":"spn-72500","text":"Every rule below is there because the alternative would make a world's "},{"id":"spn-72501","marks":["code"],"text":"sem-"},{"id":"spn-72502","text":" id depend on something a reader cannot see."}]},{"id":"blk-43106","items":[{"blocks":[{"id":"blk-43108","kind":"paragraph","spans":[{"id":"spn-72503","marks":["bold"],"text":"`#` is not a comment marker."},{"id":"spn-72504","text":" In the core surface the only comment marker is"}]}],"id":"blk-43107","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43109","kind":"paragraph","spans":[{"id":"spn-72505","marks":["code"],"text":";"},{"id":"spn-72506","text":". "},{"id":"spn-72507","marks":["code"],"text":"#"},{"id":"spn-72508","text":" belongs to the identity family and is "},{"id":"spn-72509","marks":["italic"],"text":"preserved"},{"id":"spn-72510","text":" by the parser rather than discarded."}]},{"id":"blk-43110","items":[{"blocks":[{"id":"blk-43112","kind":"paragraph","spans":[{"id":"spn-72511","marks":["bold"],"text":"A double underscore is reserved."},{"id":"spn-72512","text":" "},{"id":"spn-72513","marks":["code"],"text":"[relay:a__b]"},{"id":"spn-72514","text":" is rejected with"}]}],"id":"blk-43111","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43113","kind":"paragraph","spans":[{"id":"spn-72515","marks":["code"],"text":"WRL_UNSUPPORTED_FEATURE"},{"id":"spn-72516","text":" even though it matches "},{"id":"spn-72517","marks":["code"],"text":"[A-Za-z0-9_]+"},{"id":"spn-72518","text":". The sequence is reserved for compiler-generated names so a lowered identifier can never collide with one you wrote."}]},{"id":"blk-43114","items":[{"blocks":[{"id":"blk-43116","kind":"paragraph","spans":[{"id":"spn-72519","marks":["bold"],"text":"Every group is a set, and a set has no repeats."},{"id":"spn-72520","text":" A "},{"id":"spn-72521","marks":["code"],"text":"{ports}"},{"id":"spn-72522","text":" group naming"}]}],"id":"blk-43115","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43117","kind":"paragraph","spans":[{"id":"spn-72523","text":"the same port twice is "},{"id":"spn-72524","marks":["code"],"text":"WRL_PORT_SIGNATURE"},{"id":"spn-72525","text":"; a "},{"id":"spn-72526","marks":["code"],"text":"(config)"},{"id":"spn-72527","text":" group setting the same key twice is "},{"id":"spn-72528","marks":["code"],"text":"WRL_DUPLICATE_CONFIG_KEY"},{"id":"spn-72529","text":". Neither is last-one-wins, because silently keeping one of them would make the id depend on which."}]},{"id":"blk-43118","items":[{"blocks":[{"id":"blk-43120","kind":"paragraph","spans":[{"id":"spn-72530","marks":["bold"],"text":"A role prefix on an edge endpoint is optional but checked."},{"id":"spn-72531","text":" "},{"id":"spn-72532","marks":["code"],"text":"[relay:r0]"}]}],"id":"blk-43119","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43121","kind":"paragraph","spans":[{"id":"spn-72533","text":"and "},{"id":"spn-72534","marks":["code"],"text":"[r0]"},{"id":"spn-72535","text":" seal identically, but writing "},{"id":"spn-72536","marks":["code"],"text":"[door:r0]"},{"id":"spn-72537","text":" when "},{"id":"spn-72538","marks":["code"],"text":"r0"},{"id":"spn-72539","text":" was declared a relay is "},{"id":"spn-72540","marks":["code"],"text":"WRL_ROLE_PREFIX_MISMATCH"},{"id":"spn-72541","text":". The prefix never affects the id; it would be worth nothing if it could lie."}]},{"id":"blk-43122","items":[{"blocks":[{"id":"blk-43124","kind":"paragraph","spans":[{"id":"spn-72542","marks":["bold"],"text":"Empty groups are omitted, not emptied."},{"id":"spn-72543","text":" In the canonical artifact a Door"}]}],"id":"blk-43123","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43125","kind":"paragraph","spans":[{"id":"spn-72544","text":"carries "},{"id":"spn-72545","marks":["code"],"text":"{\"in\":[\"sig_in\"]}"},{"id":"spn-72546","text":" with "},{"id":"spn-72547","marks":["italic"],"text":"no"},{"id":"spn-72548","text":" "},{"id":"spn-72549","marks":["code"],"text":"\"out\""},{"id":"spn-72550","text":" key. Emitting "},{"id":"spn-72551","marks":["code"],"text":"\"out\":[]"},{"id":"spn-72552","text":" produces different bytes and therefore a different "},{"id":"spn-72553","marks":["code"],"text":"sem-"},{"id":"spn-72554","text":" id."}]},{"id":"blk-43126","items":[{"blocks":[{"id":"blk-43128","kind":"paragraph","spans":[{"id":"spn-72555","marks":["bold"],"text":"The profile line is required, singular and first."},{"id":"spn-72556","text":" Omitting it is"}]}],"id":"blk-43127","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-43129","kind":"paragraph","spans":[{"id":"spn-72557","marks":["code"],"text":"WRL_MISSING_PROFILE"},{"id":"spn-72558","text":", repeating it is "},{"id":"spn-72559","marks":["code"],"text":"WRL_DUPLICATE_PROFILE"},{"id":"spn-72560","text":", and writing it with trailing tokens or no id at all is "},{"id":"spn-72561","marks":["code"],"text":"WRL_MALFORMED_PROFILE"},{"id":"spn-72562","text":"."}]},{"id":"blk-43130","kind":"paragraph","spans":[{"id":"spn-72563","text":"The full diagnostic-code table is "},{"id":"spn-72564","marks":[{"kind":"link","predicate":"cites","target":"../../reference.html#codes"}],"text":"`reference.html#codes`"},{"id":"spn-72565","text":". Every rejection carries a typed "},{"id":"spn-72566","marks":["code"],"text":"WRL_*"},{"id":"spn-72567","text":" code; no raw exception escapes."}]},{"id":"blk-43131","kind":"heading","level":2,"spans":[{"id":"spn-72568","text":"Identity"}]},{"id":"blk-43132","kind":"code","language":"text","text":"desugar → parse → validate → canonicalize → serialize → SHA-256"},{"id":"blk-43133","kind":"paragraph","spans":[{"id":"spn-72569","text":"That pipeline produces the "},{"id":"spn-72570","marks":["bold"],"text":"`SemanticArtifactID`"},{"id":"spn-72571","text":" ("},{"id":"spn-72572","marks":["code"],"text":"sem-"},{"id":"spn-72573","text":") — sorted-key JSON with no incidental whitespace, empty port groups omitted rather than emitted, spinner configuration normalized to its typed form, hashed with SHA-256. "},{"id":"spn-72574","marks":["code"],"text":"wrl.js"},{"id":"spn-72575","text":" is a faithful browser port of it and reproduces the reference implementation's canonical bytes exactly, so the id the playground shows is the id the toolchain would produce. It deliberately stops at the seal: it does not lower to a backend, compile interaction-calculus terms, or reduce films — those belong to "},{"id":"spn-72576","marks":[{"kind":"link","predicate":"cites","target":"../../../TRVM"}],"text":"the runtime"},{"id":"spn-72577","text":"."}]},{"id":"blk-43134","kind":"paragraph","spans":[{"id":"spn-72578","text":"Two worlds are pinned and asserted on every change by "},{"id":"spn-72579","marks":[{"kind":"link","predicate":"cites","target":"../../test/conformance.mjs"}],"text":"`test/conformance.mjs`"},{"id":"spn-72580","text":":"}]},{"head":[{"id":"blk-43136","spans":[{"id":"spn-72581","text":"World"}]},{"id":"blk-43137","spans":[{"id":"spn-72582","text":"Id"}]}],"id":"blk-43135","kind":"table","rows":[[{"id":"blk-43138","spans":[{"id":"spn-72583","text":"the "},{"id":"spn-72584","marks":["bold"],"text":"starter world"},{"id":"spn-72585","text":" — pulser, relay, spinner, orb; what the tutorial builds"}]},{"id":"blk-43139","spans":[{"id":"spn-72586","marks":["code"],"text":"sem-67e954cfe3115166b49388366df3f062a46572ba2baf53380f1520f4050b60ae"}]}],[{"id":"blk-43140","spans":[{"id":"spn-72587","text":"the "},{"id":"spn-72588","marks":["bold"],"text":"pinned conformance fixture"},{"id":"spn-72589","text":" — six objects; what the toolchain's test batteries assert against"}]},{"id":"blk-43141","spans":[{"id":"spn-72590","marks":["code"],"text":"sem-8ae91fe9…fe4a"}]}]]},{"id":"blk-43142","kind":"heading","level":3,"spans":[{"id":"spn-72591","text":"Semantic IR 2.0"}]},{"id":"blk-43143","kind":"paragraph","spans":[{"id":"spn-72592","text":"A second "},{"id":"spn-72593","marks":["bold"],"text":"encoding"},{"id":"spn-72594","text":" of the same worlds, not a second world model. A V2 source carries a required "},{"id":"spn-72595","marks":["code"],"text":"ir 2.0"},{"id":"spn-72596","text":" header — nothing else decides which parser reads it, because "},{"id":"spn-72597","marks":["italic"],"text":"an encoding a reader has to guess is an identity a reader gets to choose"},{"id":"spn-72598","text":". A V2 world stores "},{"id":"spn-72599","marks":["code"],"text":"relations"},{"id":"spn-72600","text":" where V1 stored "},{"id":"spn-72601","marks":["code"],"text":"edges"},{"id":"spn-72602","text":", each an "},{"id":"spn-72603","marks":["code"],"text":"{ identity_seed, revision }"},{"id":"spn-72604","text":" pair. No "},{"id":"spn-72605","marks":["code"],"text":"world_id"},{"id":"spn-72606","text":", no "},{"id":"spn-72607","marks":["code"],"text":"rel-"},{"id":"spn-72608","text":", no "},{"id":"spn-72609","marks":["code"],"text":"rev-"},{"id":"spn-72610","text":" appears in the bytes, because all three are "},{"id":"spn-72611","marks":["italic"],"text":"derived"},{"id":"spn-72612","text":" from them."}]},{"id":"blk-43144","kind":"paragraph","spans":[{"id":"spn-72613","marks":["code"],"text":"profile_id"},{"id":"spn-72614","text":" does "},{"id":"spn-72615","marks":["bold"],"text":"not"},{"id":"spn-72616","text":" move. Both pinned fixtures still seal to the same "},{"id":"spn-72617","marks":["code"],"text":"sem-"},{"id":"spn-72618","text":" they always did. "},{"id":"spn-72619","marks":["code"],"text":"migrateV1ToV2"},{"id":"spn-72620","text":" imports, "},{"id":"spn-72621","marks":["code"],"text":"downgradeV2ToV1"},{"id":"spn-72622","text":" projects back, and V1 → V2 → V1 is byte-exact. An imported world's relations carry "},{"id":"spn-72623","marks":["code"],"text":"legacy-edge"},{"id":"spn-72624","text":" seeds recording that they crossed the migration "},{"id":"spn-72625","marks":["italic"],"text":"without ever being named"},{"id":"spn-72626","text":"; "},{"id":"spn-72627","marks":["code"],"text":"adoptLegacyRelations"},{"id":"spn-72628","text":" is how someone supplies the names, in one exhaustive act, and nothing derives a name from the endpoints."}]},{"id":"blk-43145","kind":"paragraph","spans":[{"id":"spn-72629","text":"§D8 and Semantic IR 2.0 are both "},{"id":"spn-72630","marks":["bold"],"text":"drafts"},{"id":"spn-72631","text":". An implementation that runs does not settle the design it implements."}]},{"id":"blk-43146","kind":"heading","level":2,"spans":[{"id":"spn-72632","text":"What is missing, in dependency order"}]},{"id":"blk-43147","kind":"paragraph","spans":[{"id":"spn-72633","text":"The next gated deliverable is the "},{"id":"spn-72634","marks":["code"],"text":"~~"},{"id":"spn-72635","text":" async route, which requires a canonical logical route declaration "},{"id":"spn-72636","marks":["italic"],"text":"distinct from"},{"id":"spn-72637","text":" the structural edge declaration — an async message does not settle within the period, so it cannot be an ordinary edge."}]},{"id":"blk-43148","kind":"paragraph","spans":[{"id":"spn-72638","text":"After that, in dependency order and not in order of appeal. The capability names in backticks are registry ids, and the test suite fails if this list disagrees with "},{"id":"spn-72639","marks":[{"kind":"link","predicate":"cites","target":"../../direction.html#ladder"}],"text":"`direction.html#ladder`"},{"id":"spn-72640","text":":"}]},{"id":"blk-43149","items":[{"blocks":[{"id":"blk-43151","kind":"paragraph","spans":[{"id":"spn-72641","text":"Typed ports and message schemas — "},{"id":"spn-72642","marks":["code"],"text":"typed-ports"}]}],"id":"blk-43150","kind":"list-item"},{"blocks":[{"id":"blk-43153","kind":"paragraph","spans":[{"id":"spn-72643","marks":["code"],"text":"~~"},{"id":"spn-72644","text":" async route and mailbox surface — "},{"id":"spn-72645","marks":["code"],"text":"async-route"}]}],"id":"blk-43152","kind":"list-item"},{"blocks":[{"id":"blk-43155","kind":"paragraph","spans":[{"id":"spn-72646","text":"Profile "},{"id":"spn-72647","marks":["italic"],"text":"mechanism"},{"id":"spn-72648","text":" ("},{"id":"spn-72649","marks":["code"],"text":"ProfileSchemaV1"},{"id":"spn-72650","text":") — "},{"id":"spn-72651","marks":["code"],"text":"profile-mechanism"}]}],"id":"blk-43154","kind":"list-item"},{"blocks":[{"id":"blk-43157","kind":"paragraph","spans":[{"id":"spn-72652","text":"Attributed relations and resolved terminals — "},{"id":"spn-72653","marks":["code"],"text":"attributed-relations"},{"id":"spn-72654","text":", "},{"id":"spn-72655","marks":["code"],"text":"resolved-terminals"}]}],"id":"blk-43156","kind":"list-item"},{"blocks":[{"id":"blk-43159","kind":"paragraph","spans":[{"id":"spn-72656","text":"Behaviours — "},{"id":"spn-72657","marks":["code"],"text":"behaviours"},{"id":"spn-72658","text":", "},{"id":"spn-72659","marks":["code"],"text":"collections"},{"id":"spn-72660","text":", "},{"id":"spn-72661","marks":["code"],"text":"expression-notation"},{"id":"spn-72662","text":", "},{"id":"spn-72663","marks":["code"],"text":"generics-traits"},{"id":"spn-72664","text":", "},{"id":"spn-72665","marks":["code"],"text":"numerics"},{"id":"spn-72666","text":", "},{"id":"spn-72667","marks":["code"],"text":"resources"}]}],"id":"blk-43158","kind":"list-item"},{"blocks":[{"id":"blk-43161","kind":"paragraph","spans":[{"id":"spn-72668","marks":["code"],"text":"=="},{"id":"spn-72669","text":" verified route — "},{"id":"spn-72670","marks":["code"],"text":"merge-routes"},{"id":"spn-72671","text":", "},{"id":"spn-72672","marks":["code"],"text":"verified-route"}]}],"id":"blk-43160","kind":"list-item"},{"blocks":[{"id":"blk-43163","kind":"paragraph","spans":[{"id":"spn-72673","text":"Supervision floor and "},{"id":"spn-72674","marks":["code"],"text":"!!"},{"id":"spn-72675","text":" — "},{"id":"spn-72676","marks":["code"],"text":"supervision"}]}],"id":"blk-43162","kind":"list-item"},{"blocks":[{"id":"blk-43165","kind":"paragraph","spans":[{"id":"spn-72677","text":"Dynamic topology — "},{"id":"spn-72678","marks":["code"],"text":"dynamic-topology"}]}],"id":"blk-43164","kind":"list-item"},{"blocks":[{"id":"blk-43167","kind":"paragraph","spans":[{"id":"spn-72679","text":"Effect adapters and the solver wall — "},{"id":"spn-72680","marks":["code"],"text":"acausal-relations"},{"id":"spn-72681","text":", "},{"id":"spn-72682","marks":["code"],"text":"effect-walls"},{"id":"spn-72683","text":", "},{"id":"spn-72684","marks":["code"],"text":"migration"},{"id":"spn-72685","text":", "},{"id":"spn-72686","marks":["code"],"text":"podium"}]}],"id":"blk-43166","kind":"list-item"},{"blocks":[{"id":"blk-43169","kind":"paragraph","spans":[{"id":"spn-72687","text":"Derive boundary and checkers — "},{"id":"spn-72688","marks":["code"],"text":"derives"},{"id":"spn-72689","text":", "},{"id":"spn-72690","marks":["code"],"text":"ffi"},{"id":"spn-72691","text":", "},{"id":"spn-72692","marks":["code"],"text":"metaprogramming"},{"id":"spn-72693","text":", "},{"id":"spn-72694","marks":["code"],"text":"modules"},{"id":"spn-72695","text":", "},{"id":"spn-72696","marks":["code"],"text":"reflection"},{"id":"spn-72697","text":", "},{"id":"spn-72698","marks":["code"],"text":"testing"}]}],"id":"blk-43168","kind":"list-item"},{"blocks":[{"id":"blk-43171","kind":"paragraph","spans":[{"id":"spn-72699","text":"Production domain profiles — "},{"id":"spn-72700","marks":["code"],"text":"domain-profiles"}]}],"id":"blk-43170","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-43172","kind":"paragraph","spans":[{"id":"spn-72701","text":"Every aspirational code block in the published pages is "},{"id":"spn-72702","marks":["bold"],"text":"asserted by the test suite to be rejected"},{"id":"spn-72703","text":" by today's toolchain, and each names the "},{"id":"spn-72704","marks":[{"kind":"link","predicate":"cites","target":"../../reference.html#capabilities"}],"text":"promotion capabilities"},{"id":"spn-72705","text":" it waits on. The suite parses the published capability table as its registry and checks the claim in both directions: every named requirement must be a registered capability, and every registered capability must be required by at least one snippet. That turns the draft into a roadmap dependency graph rather than inert prose."}]},{"id":"blk-43173","kind":"heading","level":2,"spans":[{"id":"spn-72706","text":"Reading order"}]},{"id":"blk-43174","items":[{"blocks":[{"id":"blk-43176","kind":"paragraph","spans":[{"id":"spn-72707","marks":[{"kind":"link","predicate":"cites","target":"../../learn.html"}],"text":"`learn.html`"},{"id":"spn-72708","text":" — build one world from an empty file, then watch its identity move"}]}],"id":"blk-43175","kind":"list-item"},{"blocks":[{"id":"blk-43178","kind":"paragraph","spans":[{"id":"spn-72709","marks":[{"kind":"link","predicate":"cites","target":"../../reference.html#tiers"}],"text":"`reference.html#tiers`"},{"id":"spn-72710","text":" — see how little of the language you can type today"}]}],"id":"blk-43177","kind":"list-item"},{"blocks":[{"id":"blk-43180","kind":"paragraph","spans":[{"id":"spn-72711","marks":[{"kind":"link","predicate":"cites","target":"../../spec.html"}],"text":"`spec.html`"},{"id":"spn-72712","text":" Part I — the normative text"}]}],"id":"blk-43179","kind":"list-item"},{"blocks":[{"id":"blk-43182","kind":"paragraph","spans":[{"id":"spn-72713","marks":[{"kind":"link","predicate":"cites","target":"../../direction.html"}],"text":"`direction.html`"},{"id":"spn-72714","text":" — the argument for why the narrow surface 