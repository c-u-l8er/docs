{"bendscript":"0.1","blocks":[{"id":"blk-70809","kind":"heading","level":1,"spans":[{"id":"spn-132638","text":"Graphonomous — CLAUDE Instructions"}]},{"id":"blk-70810","kind":"paragraph","spans":[{"id":"spn-132639","text":"This file defines how Claude (and Claude-driven agents) must operate in this repository."}]},{"id":"blk-70811","kind":"heading","level":2,"spans":[{"id":"spn-132640","text":"Status — read first (2026-09-27)"}]},{"id":"blk-70812","kind":"paragraph","spans":[{"id":"spn-132641","text":"This repository holds three things. Know which one you are touching."}]},{"head":[{"id":"blk-70814","spans":[{"id":"spn-132642","text":"Path"}]},{"id":"blk-70815","spans":[{"id":"spn-132643","text":"What"}]},{"id":"blk-70816","spans":[{"id":"spn-132644","text":"State"}]}],"id":"blk-70813","kind":"table","rows":[[{"id":"blk-70817","spans":[{"id":"spn-132645","marks":["code"],"text":"lib/"},{"id":"spn-132646","text":", "},{"id":"spn-132647","marks":["code"],"text":"mix.exs"},{"id":"spn-132648","text":", "},{"id":"spn-132649","marks":["code"],"text":"npm/"},{"id":"spn-132650","text":", "},{"id":"spn-132651","marks":["code"],"text":"docs/spec/README.md"}]},{"id":"blk-70818","spans":[{"id":"spn-132652","marks":["bold"],"text":"v1"},{"id":"spn-132653","text":" — the Elixir/OTP memory engine + MCP server + npm package, v0.4.3"}]},{"id":"blk-70819","spans":[{"id":"spn-132654","marks":["bold"],"text":"LEGACY."},{"id":"spn-132655","text":" Its plugin is disabled; do not run its memory loop"}]}],[{"id":"blk-70820","spans":[{"id":"spn-132656","marks":["code"],"text":"v2/"}]},{"id":"blk-70821","spans":[{"id":"spn-132657","marks":["bold"],"text":"v2"},{"id":"spn-132658","text":" — the certified semantic/evidence graph (G0/G1)"}]},{"id":"blk-70822","spans":[{"id":"spn-132659","text":"the active lane; read "},{"id":"spn-132660","marks":["code"],"text":"v2/handoff/STATUS.md"},{"id":"spn-132661","text":" first, then "},{"id":"spn-132662","marks":["code"],"text":"v2/handoff/ROADMAP.md"}]}],[{"id":"blk-70823","spans":[{"id":"spn-132663","marks":["code"],"text":"docs/spec/v3/README.md"}]},{"id":"blk-70824","spans":[{"id":"spn-132664","marks":["bold"],"text":"Graphonomous v3"},{"id":"spn-132665","text":" — the proposal for a carried memory built on v2"}]},{"id":"blk-70825","spans":[{"id":"spn-132666","marks":["bold"],"text":"CLOSED 2026-09-28 (D-078): there is no Graphonomous v3."},{"id":"spn-132667","text":" Tested by V3-1 ("},{"id":"spn-132668","marks":["code"],"text":"v3-bench/"},{"id":"spn-132669","text":") and not justified; a record, not a direction. Its survivors are in "},{"id":"spn-132670","marks":["code"],"text":"v2/handoff/ROADMAP.md"}]}]]},{"id":"blk-70826","kind":"paragraph","spans":[{"id":"spn-132671","marks":["bold"],"text":"D-078 (Travis, 2026-09-28):"},{"id":"spn-132672","text":" Graphonomous stays v2 — "},{"id":"spn-132673","marks":["italic"],"text":"a derived semantic graph over sources it does not own"},{"id":"spn-132674","text":". It gains the memory folder and the ruling register as sources, and only authored relations. When a relation is uncertain, it abstains or queues the pair for review. Recall is BM25 ("},{"id":"spn-132675","marks":["code"],"text":"scripts/memory-search.py"},{"id":"spn-132676","text":" in the root repository), outside Graphonomous. Do not build any of the following:"}]},{"id":"blk-70827","items":[{"blocks":[{"id":"blk-70829","kind":"paragraph","spans":[{"id":"spn-132677","text":"a Graphonomous memory store;"}]}],"id":"blk-70828","kind":"list-item"},{"blocks":[{"id":"blk-70831","kind":"paragraph","spans":[{"id":"spn-132678","text":"a recall daemon;"}]}],"id":"blk-70830","kind":"list-item"},{"blocks":[{"id":"blk-70833","kind":"paragraph","spans":[{"id":"spn-132679","text":"a journal;"}]}],"id":"blk-70832","kind":"list-item"},{"blocks":[{"id":"blk-70835","kind":"paragraph","spans":[{"id":"spn-132680","text":"model-mediated recall;"}]}],"id":"blk-70834","kind":"list-item"},{"blocks":[{"id":"blk-70837","kind":"paragraph","spans":[{"id":"spn-132681","text":"a model in the relation-emission path."}]}],"id":"blk-70836","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70838","kind":"paragraph","spans":[{"id":"spn-132682","text":"Do not renumber v2 as v3 for gaining features."}]},{"id":"blk-70839","kind":"paragraph","spans":[{"id":"spn-132683","marks":["bold"],"text":"D-079 (Travis, 2026-09-28) — the source boundary. Read it before writing any adapter:"}]},{"id":"blk-70840","items":[{"blocks":[{"id":"blk-70842","kind":"paragraph","spans":[{"id":"spn-132684","marks":["bold"],"text":"This repository is PUBLIC."},{"id":"spn-132685","text":" Anything derived from a private source goes in "},{"id":"spn-132686","marks":["code"],"text":"~/.graphonomous/v2/"},{"id":"spn-132687","text":", never"}]}],"id":"blk-70841","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70843","kind":"paragraph","spans":[{"id":"spn-132688","text":"here (SB-1). That covers projections, indexes, evidence, review candidates, UI payloads and quoting receipts."}]},{"id":"blk-70844","items":[{"blocks":[{"id":"blk-70846","kind":"paragraph","spans":[{"id":"spn-132689","marks":["bold"],"text":"Authority is per record"},{"id":"spn-132690","text":", never per family and never by ingestion order (SB-2)."}]}],"id":"blk-70845","kind":"list-item"},{"blocks":[{"id":"blk-70848","kind":"paragraph","spans":[{"id":"spn-132691","marks":["bold"],"text":"A model's or reviewer's relation is a candidate"},{"id":"spn-132692","text":" until an authorized source records it (SB-3)."}]}],"id":"blk-70847","kind":"list-item"},{"blocks":[{"id":"blk-70850","kind":"paragraph","spans":[{"id":"spn-132693","marks":["bold"],"text":"Secret-shaped text is refused at intake"},{"id":"spn-132694","text":" (SB-4)."}]}],"id":"blk-70849","kind":"list-item"},{"blocks":[{"id":"blk-70852","kind":"paragraph","spans":[{"id":"spn-132695","marks":["bold"],"text":"Source order:"},{"id":"spn-132696","text":" WRL → ruling register → memory folder."}]}],"id":"blk-70851","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70853","kind":"paragraph","spans":[{"id":"spn-132697","marks":["bold"],"text":"The \"Graphonomous-first memory loop\" is OFF — ruled by Travis 2026-09-27."},{"id":"spn-132698","text":" This file's Primary Directive and its sections 1–12 used to tell every session to run retrieve → route → act → learn → consolidate through this engine's MCP server. Do not restore them, and do not call "},{"id":"spn-132699","marks":["code"],"text":"mcp__plugin_graphonomous_graphonomous__*"},{"id":"spn-132700","text":". The retired text is "},{"id":"spn-132701","marks":["code"],"text":"git show 61adec2d:CLAUDE.md"},{"id":"spn-132702","text":"; the skills it loaded are still in "},{"id":"spn-132703","marks":["code"],"text":"docs/skills/"},{"id":"spn-132704","text":"."}]},{"id":"blk-70854","kind":"paragraph","spans":[{"id":"spn-132705","marks":["bold"],"text":"Why:"},{"id":"spn-132706","text":" the v1 engine was deleting everything it stored. The consolidator ("},{"id":"spn-132707","marks":["code"],"text":"config/config.exs"},{"id":"spn-132708","text":", "},{"id":"spn-132709","marks":["code"],"text":"lib/graphonomous/consolidator.ex"},{"id":"spn-132710","text":") runs every 5 minutes, decays every node's confidence by 2 % and hard-deletes below 0.1, so a node stored at 0.5 is gone in about 7 hours; "},{"id":"spn-132711","marks":["code"],"text":"~/.graphonomous/knowledge.db"},{"id":"spn-132712","text":" held "},{"id":"spn-132713","marks":["bold"],"text":"0 nodes"},{"id":"spn-132714","text":" on 2026-09-27. The plugin also started one server per open session (29 at once, ≈ 1.6 GB), each loading its own cache and running its own consolidator. The measurements and the direction are in "},{"id":"spn-132715","marks":["code"],"text":"docs/spec/v3/README.md"},{"id":"spn-132716","text":" §1.1 and §6."}]},{"id":"blk-70855","kind":"paragraph","spans":[{"id":"spn-132717","marks":["bold"],"text":"Name trap:"},{"id":"spn-132718","text":" section 3's \"v2 Machine Surface\" and \"v1 Legacy Surface\" are two generations of the "},{"id":"spn-132719","marks":["bold"],"text":"v1 engine's"},{"id":"spn-132720","text":" MCP tool surface — not Graphonomous v2 ("},{"id":"spn-132721","marks":["code"],"text":"v2/"},{"id":"spn-132722","text":"), and neither is Graphonomous v3."}]},{"id":"blk-70856","kind":"paragraph","spans":[{"id":"spn-132723","marks":["bold"],"text":"Two disciplines survive the old policy:"},{"id":"spn-132724","text":" never fabricate provenance, outcomes, causal links or coverage signals; never state confidence the evidence does not carry."}]},{"id":"blk-70857","kind":"heading","level":2,"spans":[{"id":"spn-132725","text":"1) Project Constraints (v1 — keep intact while v1 is maintained)"}]},{"id":"blk-70858","items":[{"blocks":[{"id":"blk-70860","kind":"paragraph","spans":[{"id":"spn-132726","text":"Source of truth:"}]}],"id":"blk-70859","kind":"list-item"},{"blocks":[{"id":"blk-70862","kind":"paragraph","spans":[{"id":"spn-132727","marks":["code"],"text":"docs/spec/README.md"}]}],"id":"blk-70861","kind":"list-item"},{"blocks":[{"id":"blk-70864","kind":"paragraph","spans":[{"id":"spn-132728","marks":["code"],"text":"../AmpersandBoxDesign/prompts/GRAPHONOMOUS_PROMPT.md"}]}],"id":"blk-70863","kind":"list-item"},{"blocks":[{"id":"blk-70866","kind":"paragraph","spans":[{"id":"spn-132729","text":"Keep vendored MCP dependency approach in "},{"id":"spn-132730","marks":["code"],"text":"vendor/anubis_mcp"}]}],"id":"blk-70865","kind":"list-item"},{"blocks":[{"id":"blk-70868","kind":"paragraph","spans":[{"id":"spn-132731","text":"EXLA is now included for fast neural embeddings (~87ms vs 20s on BinaryBackend)"}]}],"id":"blk-70867","kind":"list-item"},{"blocks":[{"id":"blk-70870","kind":"paragraph","spans":[{"id":"spn-132732","text":"Requires "},{"id":"spn-132733","marks":["code"],"text":"LD_LIBRARY_PATH=/opt/cuda/lib64"},{"id":"spn-132734","text":" at runtime (see "},{"id":"spn-132735","marks":["code"],"text":".envrc"},{"id":"spn-132736","text":")"}]}],"id":"blk-70869","kind":"list-item"},{"blocks":[{"id":"blk-70872","kind":"paragraph","spans":[{"id":"spn-132737","text":"If EXLA fails to load, embedder gracefully falls back to deterministic hashing"}]}],"id":"blk-70871","kind":"list-item"},{"blocks":[{"id":"blk-70874","kind":"paragraph","spans":[{"id":"spn-132738","text":"Set "},{"id":"spn-132739","marks":["code"],"text":"GRAPHONOMOUS_EMBEDDER_BACKEND=fallback"},{"id":"spn-132740","text":" to skip EXLA entirely"}]}],"id":"blk-70873","kind":"list-item"},{"blocks":[{"id":"blk-70876","kind":"paragraph","spans":[{"id":"spn-132741","text":"Keep raw SQL + parameterized writes model"}]}],"id":"blk-70875","kind":"list-item"},{"blocks":[{"id":"blk-70878","kind":"paragraph","spans":[{"id":"spn-132742","text":"Keep version synchronization across:"}]}],"id":"blk-70877","kind":"list-item"},{"blocks":[{"id":"blk-70880","kind":"paragraph","spans":[{"id":"spn-132743","marks":["code"],"text":"mix.exs"}]}],"id":"blk-70879","kind":"list-item"},{"blocks":[{"id":"blk-70882","kind":"paragraph","spans":[{"id":"spn-132744","marks":["code"],"text":"npm/package.json"}]}],"id":"blk-70881","kind":"list-item"},{"blocks":[{"id":"blk-70884","kind":"paragraph","spans":[{"id":"spn-132745","text":"git tag "},{"id":"spn-132746","marks":["code"],"text":"vX.Y.Z"}]}],"id":"blk-70883","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-70885","kind":"heading","level":2,"spans":[{"id":"spn-132747","text":"2) Build and Run (v1 reference)"}]},{"id":"blk-70886","kind":"code","language":"sh","text":"source .envrc  # sets LD_LIBRARY_PATH for CUDA/EXLA\nmix deps.get\nmix compile --warnings-as-errors\nmix format --check-formatted\nmix test\n# Neural embeddings (default, requires EXLA):\nmix run --no-halt -- --db ~/.graphonomous/knowledge.db\n# Fallback mode (no EXLA needed):\nmix run --no-halt -- --db ~/.graphonomous/knowledge.db --embedder-backend fallback"},{"id":"blk-