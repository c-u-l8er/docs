{"bendscript":"0.1","blocks":[{"id":"blk-82645","kind":"heading","level":1,"spans":[{"id":"spn-147095","text":"WebHost.Systems Quickstart"}]},{"blocks":[{"id":"blk-82647","kind":"paragraph","spans":[{"id":"spn-147096","marks":["bold"],"text":"Purpose:"},{"id":"spn-147097","text":" Get a local development environment running and deploy your first agent in under 10 minutes."}]}],"id":"blk-82646","kind":"quote"},{"id":"blk-82648","kind":"heading","level":2,"spans":[{"id":"spn-147098","text":"Prerequisites"}]},{"id":"blk-82649","items":[{"blocks":[{"id":"blk-82651","kind":"paragraph","spans":[{"id":"spn-147099","text":"Node.js >= 20"}]}],"id":"blk-82650","kind":"list-item"},{"blocks":[{"id":"blk-82653","kind":"paragraph","spans":[{"id":"spn-147100","text":"npm (ships with Node)"}]}],"id":"blk-82652","kind":"list-item"},{"blocks":[{"id":"blk-82655","kind":"paragraph","spans":[{"id":"spn-147101","text":"Supabase CLI ("},{"id":"spn-147102","marks":["code"],"text":"npm i -g supabase"},{"id":"spn-147103","text":")"}]}],"id":"blk-82654","kind":"list-item"},{"blocks":[{"id":"blk-82657","kind":"paragraph","spans":[{"id":"spn-147104","text":"A Supabase project (or local emulator)"}]}],"id":"blk-82656","kind":"list-item"},{"blocks":[{"id":"blk-82659","kind":"paragraph","spans":[{"id":"spn-147105","text":"Cloudflare account (for data plane testing)"}]}],"id":"blk-82658","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82660","kind":"heading","level":2,"spans":[{"id":"spn-147106","text":"1. Clone and Install"}]},{"id":"blk-82661","kind":"code","language":"bash","text":"git clone <repo-url> WebHost.Systems\ncd WebHost.Systems\nnpm install"},{"id":"blk-82662","kind":"heading","level":2,"spans":[{"id":"spn-147107","text":"2. Environment Setup"}]},{"id":"blk-82663","kind":"paragraph","spans":[{"id":"spn-147108","text":"Copy the example env and fill in your keys:"}]},{"id":"blk-82664","kind":"code","language":"bash","text":"cp .env.example .env.local"},{"id":"blk-82665","kind":"paragraph","spans":[{"id":"spn-147109","text":"Required variables:"}]},{"head":[{"id":"blk-82667","spans":[{"id":"spn-147110","text":"Variable"}]},{"id":"blk-82668","spans":[{"id":"spn-147111","text":"Description"}]}],"id":"blk-82666","kind":"table","rows":[[{"id":"blk-82669","spans":[{"id":"spn-147112","marks":["code"],"text":"SUPABASE_URL"}]},{"id":"blk-82670","spans":[{"id":"spn-147113","text":"Your Supabase project URL"}]}],[{"id":"blk-82671","spans":[{"id":"spn-147114","marks":["code"],"text":"SUPABASE_ANON_KEY"}]},{"id":"blk-82672","spans":[{"id":"spn-147115","text":"Supabase anonymous key (for client)"}]}],[{"id":"blk-82673","spans":[{"id":"spn-147116","marks":["code"],"text":"SUPABASE_SERVICE_ROLE_KEY"}]},{"id":"blk-82674","spans":[{"id":"spn-147117","text":"Service role key (for Edge Functions)"}]}],[{"id":"blk-82675","spans":[{"id":"spn-147118","marks":["code"],"text":"CLOUDFLARE_API_TOKEN"}]},{"id":"blk-82676","spans":[{"id":"spn-147119","text":"Cloudflare API token (deploy adapter)"}]}],[{"id":"blk-82677","spans":[{"id":"spn-147120","marks":["code"],"text":"CLOUDFLARE_ACCOUNT_ID"}]},{"id":"blk-82678","spans":[{"id":"spn-147121","text":"Cloudflare account ID"}]}],[{"id":"blk-82679","spans":[{"id":"spn-147122","marks":["code"],"text":"LEMONSQUEEZY_WEBHOOK_SECRET"}]},{"id":"blk-82680","spans":[{"id":"spn-147123","text":"Billing webhook verification"}]}]]},{"id":"blk-82681","kind":"heading","level":2,"spans":[{"id":"spn-147124","text":"3. Start Development Servers"}]},{"id":"blk-82682","kind":"code","language":"bash","text":"# Terminal 1 -- Vite dev server (dashboard UI)\nnpm run dev\n\n# Terminal 2 -- Supabase local (if using emulator)\nsupabase start\n\n# Terminal 3 -- Edge Functions local dev\nsupabase functions serve"},{"id":"blk-82683","kind":"heading","level":2,"spans":[{"id":"spn-147125","text":"4. Create Your First Agent"}]},{"id":"blk-82684","kind":"heading","level":3,"spans":[{"id":"spn-147126","text":"Via the dashboard"}]},{"id":"blk-82685","items":[{"blocks":[{"id":"blk-82687","kind":"paragraph","spans":[{"id":"spn-147127","text":"Navigate to "},{"id":"spn-147128","marks":["code"],"text":"http://localhost:5173"}]}],"id":"blk-82686","kind":"list-item"},{"blocks":[{"id":"blk-82689","kind":"paragraph","spans":[{"id":"spn-147129","text":"Sign in (Supabase Auth: email or OAuth)"}]}],"id":"blk-82688","kind":"list-item"},{"blocks":[{"id":"blk-82691","kind":"paragraph","spans":[{"id":"spn-147130","text":"Click \"New Agent\""}]}],"id":"blk-82690","kind":"list-item"},{"blocks":[{"id":"blk-82693","kind":"paragraph","spans":[{"id":"spn-147131","text":"Fill in name, framework, and select "},{"id":"spn-147132","marks":["code"],"text":"cloudflare"},{"id":"spn-147133","text":" runtime"}]}],"id":"blk-82692","kind":"list-item"},{"blocks":[{"id":"blk-82695","kind":"paragraph","spans":[{"id":"spn-147134","text":"Upload a bundle containing "},{"id":"spn-147135","marks":["code"],"text":"agent.config.json"},{"id":"spn-147136","text":" and your entrypoint"}]}],"id":"blk-82694","kind":"list-item"},{"blocks":[{"id":"blk-82697","kind":"paragraph","spans":[{"id":"spn-147137","text":"Click \"Deploy\""}]}],"id":"blk-82696","kind":"list-item"}],"kind":"list","ordered":true},{"id":"blk-82698","kind":"heading","level":3,"spans":[{"id":"spn-147138","text":"Via the API"}]},{"id":"blk-82699","kind":"code","language":"bash","text":"# Authenticate and get a token\nTOKEN=$(supabase auth token)\n\n# Create an agent\ncurl -X POST \"$SUPABASE_URL/rest/v1/rpc/create_agent\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"my-first-agent\",\n    \"framework\": \"custom\",\n    \"runtime_provider\": \"cloudflare\"\n  }'"},{"id":"blk-82700","kind":"heading","level":2,"spans":[{"id":"spn-147139","text":"5. Invoke Your Agent"}]},{"id":"blk-82701","kind":"code","language":"bash","text":"curl -X POST \"$SUPABASE_URL/functions/v1/invoke/$AGENT_ID\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"input\": { \"prompt\": \"Hello, agent!\" }\n  }'"},{"id":"blk-82702","kind":"heading","level":2,"spans":[{"id":"spn-147140","text":"6. View Metrics"}]},{"id":"blk-82703","kind":"paragraph","spans":[{"id":"spn-147141","text":"Navigate to the agent detail page in the dashboard to see:"}]},{"id":"blk-82704","items":[{"blocks":[{"id":"blk-82706","kind":"paragraph","spans":[{"id":"spn-147142","text":"Request count"}]}],"id":"blk-82705","kind":"list-item"},{"blocks":[{"id":"blk-82708","kind":"paragraph","spans":[{"id":"spn-147143","text":"Token usage"}]}],"id":"blk-82707","kind":"list-item"},{"blocks":[{"id":"blk-82710","kind":"paragraph","spans":[{"id":"spn-147144","text":"Compute time (ms)"}]}],"id":"blk-82709","kind":"list-item"},{"blocks":[{"id":"blk-82712","kind":"paragraph","spans":[{"id":"spn-147145","text":"Error rate"}]}],"id":"blk-82711","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82713","kind":"heading","level":2,"spans":[{"id":"spn-147146","text":"Next Steps"}]},{"id":"blk-82714","items":[{"blocks":[{"id":"blk-82716","kind":"paragraph","spans":[{"id":"spn-147147","text":"Read the "},{"id":"spn-147148","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/architecture.md"}],"text":"Architecture Overview"},{"id":"spn-147149","text":" for system design context"}]}],"id":"blk-82715","kind":"list-item"},{"blocks":[{"id":"blk-82718","kind":"paragraph","spans":[{"id":"spn-147150","text":"See "},{"id":"spn-147151","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/skills/SKILLS.md"}],"text":"Skills Reference"},{"id":"spn-147152","text":" for operational guides"}]}],"id":"blk-82717","kind":"list-item"},{"blocks":[{"id":"blk-82720","kind":"paragraph","spans":[{"id":"spn-147153","text":"Review the "},{"id":"spn-147154","marks":[{"kind":"link","predicate":"cites","target":"#/locu.systems/docs/spec/00_MASTER_SPEC.md"}],"text":"Master Spec"},{"id":"spn-147155","text":" for full requirements"}]}],"id":"blk-82719","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-82721","kind":"heading","level":2,"spans":[{"id":"spn-147156","text":"Verify Your Setup"}]},{"id":"blk-82722","kind":"code","language":"bash","text":"npm run typecheck     # TypeScript check\nnpm run lint          # ESLint\nnpm run format:check  # Prettier"},{"id":"blk-82723","kind":"paragraph","spans":[{"id":"spn-147157","text":"All three should pass with zero errors before committing."}]}],"edges":[],"id":"bagaaierarbg6xzwm3kyaiffm6blmyhgz3gvgiueonvkl3e4mkaxcydgabwoa","vocabulary":"ampersand.docs.fs.v1"}