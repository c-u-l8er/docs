{"bendscript":"0.1","blocks":[{"id":"blk-47283","kind":"heading","level":1,"spans":[{"id":"spn-54992","text":"Architecture"}]},{"blocks":[{"id":"blk-47285","kind":"paragraph","spans":[{"id":"spn-54993","text":"OTP supervision tree, GenServers, ETS caches, MCP server layout, and harness components for the "},{"id":"spn-54994","marks":["code"],"text":"open_sentience"},{"id":"spn-54995","text":" governance shim and agent harness."}]}],"id":"blk-47284","kind":"quote"},{"id":"blk-47286","kind":"paragraph","spans":[{"id":"spn-54996","text":"---"}]},{"id":"blk-47287","kind":"heading","level":2,"spans":[{"id":"spn-54997","text":"Overview"}]},{"id":"blk-47288","kind":"paragraph","spans":[{"id":"spn-54998","text":"The "},{"id":"spn-54999","marks":["code"],"text":"open_sentience"},{"id":"spn-55000","text":" hex package is an OTP application that wraps arbitrary "},{"id":"spn-55001","marks":["code"],"text":"child_spec"},{"id":"spn-55002","text":" processes with governance: permissions, lifecycle management, graduated autonomy, and append-only audit logging."}]},{"id":"blk-47289","kind":"paragraph","spans":[{"id":"spn-55003","text":"It ships as a single supervision tree that can be added to any Elixir application. The shim interposes between the host supervisor and the governed agent processes, adding policy enforcement without modifying the agent code."}]},{"id":"blk-47290","kind":"paragraph","spans":[{"id":"spn-55004","marks":["bold"],"text":"Design constraint:"},{"id":"spn-55005","text":" The shim must add less than 1% CPU overhead, less than 5 MB RSS, and less than 2 microseconds per permission check."}]},{"id":"blk-47291","kind":"paragraph","spans":[{"id":"spn-55006","text":"---"}]},{"id":"blk-47292","kind":"heading","level":2,"spans":[{"id":"spn-55007","text":"Supervision Tree"}]},{"id":"blk-47293","kind":"code","language":"text","text":"OpenSentience.Application\n  |\n  +-- OpenSentience.Supervisor (one_for_one)\n        |\n        +-- OpenSentience.PermissionEngine     (GenServer + ETS)\n        |\n        +-- OpenSentience.AutonomyController   (GenServer + ETS)\n        |\n        +-- OpenSentience.AuditWriter          (GenServer, batched)\n        |\n        +-- OpenSentience.AgentSupervisor      (DynamicSupervisor)\n        |     |\n        |     +-- OpenSentience.AgentLifecycle  (GenStateMachine, per agent)\n        |           |\n        |           +-- <wrapped agent process> (the actual child_spec)\n        |\n        +-- OpenSentience.MCP.Server           (Hermes MCP server)\n        |\n        +-- OpenSentience.Harness.Supervisor  (DynamicSupervisor)\n              |\n              +-- OpenSentience.Harness.Session  (per task, supervised)\n                    |\n                    +-- Harness.PipelineEnforcer   (GenServer)\n                    +-- Harness.QualityGate        (GenServer)\n                    +-- Harness.ContractValidator   (GenServer + ETS)\n                    +-- Harness.SprintController    (GenStateMachine)\n                    +-- Harness.ContextManager      (GenServer)"},{"id":"blk-47294","kind":"paragraph","spans":[{"id":"spn-55008","text":"Each component has a single responsibility. The supervision strategy is "},{"id":"spn-55009","marks":["code"],"text":"one_for_one"},{"id":"spn-55010","text":" — a crash in the AuditWriter does not take down the PermissionEngine, and vice versa. Harness sessions are supervised independently under a DynamicSupervisor — each task gets its own isolated session."}]},{"id":"blk-47295","kind":"paragraph","spans":[{"id":"spn-55011","text":"---"}]},{"id":"blk-47296","kind":"heading","level":2,"spans":[{"id":"spn-55012","text":"Component Details"}]},{"id":"blk-47297","kind":"heading","level":3,"spans":[{"id":"spn-55013","text":"PermissionEngine (GenServer + ETS)"}]},{"id":"blk-47298","kind":"paragraph","spans":[{"id":"spn-55014","text":"Manages the permission taxonomy and evaluates permission checks."}]},{"id":"blk-47299","items":[{"blocks":[{"id":"blk-47301","kind":"paragraph","spans":[{"id":"spn-55015","marks":["bold"],"text":"ETS table:"},{"id":"spn-55016","text":" "},{"id":"spn-55017","marks":["code"],"text":":os_permissions"},{"id":"spn-55018","text":" — keyed by "},{"id":"spn-55019","marks":["code"],"text":"{agent_id, permission_type, resource}"}]}],"id":"blk-47300","kind":"list-item"},{"blocks":[{"id":"blk-47303","kind":"paragraph","spans":[{"id":"spn-55020","marks":["bold"],"text":"Evaluation order:"},{"id":"spn-55021","text":" explicit deny > explicit allow > default deny"}]}],"id":"blk-47302","kind":"list-item"},{"blocks":[{"id":"blk-47305","kind":"paragraph","spans":[{"id":"spn-55022","marks":["bold"],"text":"Glob support:"},{"id":"spn-55023","text":" filesystem paths and network hosts support glob patterns"}]}],"id":"blk-47304","kind":"list-item"},{"blocks":[{"id":"blk-47307","kind":"paragraph","spans":[{"id":"spn-55024","marks":["bold"],"text":"Hot path:"},{"id":"spn-55025","text":" permission checks read directly from ETS (no GenServer call)"}]}],"id":"blk-47306","kind":"list-item"},{"blocks":[{"id":"blk-47309","kind":"paragraph","spans":[{"id":"spn-55026","marks":["bold"],"text":"Cold path:"},{"id":"spn-55027","text":" permission mutations go through the GenServer for serialization"}]}],"id":"blk-47308","kind":"list-item"},{"blocks":[{"id":"blk-47311","kind":"paragraph","spans":[{"id":"spn-55028","marks":["bold"],"text":"Integrates with:"},{"id":"spn-55029","text":" Delegatic policy PubSub for external policy updates"}]}],"id":"blk-47310","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47312","kind":"heading","level":3,"spans":[{"id":"spn-55030","text":"AgentLifecycle (GenStateMachine)"}]},{"id":"blk-47313","kind":"paragraph","spans":[{"id":"spn-55031","text":"One instance per governed agent. Manages the lifecycle state machine:"}]},{"id":"blk-47314","kind":"code","language":"text","text":"installed --> enabled --> running\n                ^          |\n                |          v\n                +--- enabled (stop)\n                       |\n                       v\n                    disabled --> removed"},{"id":"blk-47315","items":[{"blocks":[{"id":"blk-47317","kind":"paragraph","spans":[{"id":"spn-55032","marks":["bold"],"text":"States:"},{"id":"spn-55033","text":" "},{"id":"spn-55034","marks":["code"],"text":"installed"},{"id":"spn-55035","text":", "},{"id":"spn-55036","marks":["code"],"text":"enabled"},{"id":"spn-55037","text":", "},{"id":"spn-55038","marks":["code"],"text":"running"},{"id":"spn-55039","text":", "},{"id":"spn-55040","marks":["code"],"text":"disabled"},{"id":"spn-55041","text":", "},{"id":"spn-55042","marks":["code"],"text":"removed"}]}],"id":"blk-47316","kind":"list-item"},{"blocks":[{"id":"blk-47319","kind":"paragraph","spans":[{"id":"spn-55043","marks":["bold"],"text":"Transitions:"},{"id":"spn-55044","text":" validated by GenStateMachine callbacks"}]}],"id":"blk-47318","kind":"list-item"},{"blocks":[{"id":"blk-47321","kind":"paragraph","spans":[{"id":"spn-55045","marks":["bold"],"text":"On enable:"},{"id":"spn-55046","text":" starts the wrapped "},{"id":"spn-55047","marks":["code"],"text":"child_spec"},{"id":"spn-55048","text":" under AgentSupervisor"}]}],"id":"blk-47320","kind":"list-item"},{"blocks":[{"id":"blk-47323","kind":"paragraph","spans":[{"id":"spn-55049","marks":["bold"],"text":"On disable:"},{"id":"spn-55050","text":" graceful shutdown with configurable timeout, then force kill"}]}],"id":"blk-47322","kind":"list-item"},{"blocks":[{"id":"blk-47325","kind":"paragraph","spans":[{"id":"spn-55051","marks":["bold"],"text":"On remove:"},{"id":"spn-55052","text":" ensures disabled first, then cleans up ETS entries"}]}],"id":"blk-47324","kind":"list-item"},{"blocks":[{"id":"blk-47327","kind":"paragraph","spans":[{"id":"spn-55053","marks":["bold"],"text":"Audit:"},{"id":"spn-55054","text":" every transition emits an audit entry via AuditWriter"}]}],"id":"blk-47326","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47328","kind":"heading","level":3,"spans":[{"id":"spn-55055","text":"AuditWriter (GenServer)"}]},{"id":"blk-47329","kind":"paragraph","spans":[{"id":"spn-55056","text":"Append-only audit trail with batched writes."}]},{"id":"blk-47330","items":[{"blocks":[{"id":"blk-47332","kind":"paragraph","spans":[{"id":"spn-55057","marks":["bold"],"text":"Batching:"},{"id":"spn-55058","text":" collects entries for a configurable interval (default 100ms),"}]}],"id":"blk-47331","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47333","kind":"paragraph","spans":[{"id":"spn-55059","text":"then flushes as a single write"}]},{"id":"blk-47334","items":[{"blocks":[{"id":"blk-47336","kind":"paragraph","spans":[{"id":"spn-55060","marks":["bold"],"text":"Backends:"},{"id":"spn-55061","text":" ETS (default, in-memory), file (append-only log), Ecto (optional)"}]}],"id":"blk-47335","kind":"list-item"},{"blocks":[{"id":"blk-47338","kind":"paragraph","spans":[{"id":"spn-55062","marks":["bold"],"text":"Schema:"},{"id":"spn-55063","text":" each entry contains id, timestamp, agent_id, event_type,"}]}],"id":"blk-47337","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47339","kind":"paragraph","spans":[{"id":"spn-55064","text":"operation, result, actor, reason, and metadata"}]},{"id":"blk-47340","items":[{"blocks":[{"id":"blk-47342","kind":"paragraph","spans":[{"id":"spn-55065","marks":["bold"],"text":"Immutability:"},{"id":"spn-55066","text":" entries can only be appended, never modified or deleted"}]}],"id":"blk-47341","kind":"list-item"},{"blocks":[{"id":"blk-47344","kind":"paragraph","spans":[{"id":"spn-55067","marks":["bold"],"text":"Query:"},{"id":"spn-55068","text":" supports filtering by agent_id, event_type, time range, and limit"}]}],"id":"blk-47343","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47345","kind":"heading","level":3,"spans":[{"id":"spn-55069","text":"AutonomyController (GenServer + ETS)"}]},{"id":"blk-47346","kind":"paragraph","spans":[{"id":"spn-55070","text":"Manages graduated autonomy levels per agent."}]},{"id":"blk-47347","items":[{"blocks":[{"id":"blk-47349","kind":"paragraph","spans":[{"id":"spn-55071","marks":["bold"],"text":"ETS table:"},{"id":"spn-55072","text":" "},{"id":"spn-55073","marks":["code"],"text":":os_autonomy"},{"id":"spn-55074","text":" — keyed by "},{"id":"spn-55075","marks":["code"],"text":"agent_id"}]}],"id":"blk-47348","kind":"list-item"},{"blocks":[{"id":"blk-47351","kind":"paragraph","spans":[{"id":"spn-55076","marks":["bold"],"text":"Levels:"},{"id":"spn-55077","text":" "},{"id":"spn-55078","marks":["code"],"text":"observe"},{"id":"spn-55079","text":", "},{"id":"spn-55080","marks":["code"],"text":"advise"},{"id":"spn-55081","text":", "},{"id":"spn-55082","marks":["code"],"text":"act"}]}],"id":"blk-47350","kind":"list-item"},{"blocks":[{"id":"blk-47353","kind":"paragraph","spans":[{"id":"spn-55083","marks":["bold"],"text":"Enforcement:"}]}],"id":"blk-47352","kind":"list-item"},{"blocks":[{"id":"blk-47355","kind":"paragraph","spans":[{"id":"spn-55084","marks":["code"],"text":"observe"},{"id":"spn-55085","text":" — agent generates recommendations, shim blocks execution"}]}],"id":"blk-47354","kind":"list-item"},{"blocks":[{"id":"blk-47357","kind":"paragraph","spans":[{"id":"spn-55086","marks":["code"],"text":"advise"},{"id":"spn-55087","text":" — agent prepares actions, shim queues for human approval"}]}],"id":"blk-47356","kind":"list-item"},{"blocks":[{"id":"blk-47359","kind":"paragraph","spans":[{"id":"spn-55088","marks":["code"],"text":"act"},{"id":"spn-55089","text":" — agent executes autonomously within granted permissions"}]}],"id":"blk-47358","kind":"list-item"},{"blocks":[{"id":"blk-47361","kind":"paragraph","spans":[{"id":"spn-55090","marks":["bold"],"text":"Transitions:"},{"id":"spn-55091","text":" every level change is audited"}]}],"id":"blk-47360","kind":"list-item"},{"blocks":[{"id":"blk-47363","kind":"paragraph","spans":[{"id":"spn-55092","marks":["bold"],"text":"Default:"},{"id":"spn-55093","text":" new agents start at "},{"id":"spn-55094","marks":["code"],"text":"observe"}]}],"id":"blk-47362","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47364","kind":"heading","level":3,"spans":[{"id":"spn-55095","text":"AgentSupervisor (DynamicSupervisor)"}]},{"id":"blk-47365","kind":"paragraph","spans":[{"id":"spn-55096","text":"Standard OTP DynamicSupervisor that hosts the per-agent AgentLifecycle processes. No custom logic — supervision is delegated to the per-agent GenStateMachine instances."}]},{"id":"blk-47366","kind":"heading","level":3,"spans":[{"id":"spn-55097","text":"MCP Server (Hermes)"}]},{"id":"blk-47367","kind":"paragraph","spans":[{"id":"spn-55098","text":"Exposes the governance shim as MCP tools for LLM agents."}]},{"id":"blk-47368","items":[{"blocks":[{"id":"blk-47370","kind":"paragraph","spans":[{"id":"spn-55099","marks":["bold"],"text":"Transport:"},{"id":"spn-55100","text":" stdio (default) or SSE"}]}],"id":"blk-47369","kind":"list-item"},{"blocks":[{"id":"blk-47372","kind":"paragraph","spans":[{"id":"spn-55101","marks":["bold"],"text":"Seven tools:"},{"id":"spn-55102","text":" "},{"id":"spn-55103","marks":["code"],"text":"agent_install"},{"id":"spn-55104","text":", "},{"id":"spn-55105","marks":["code"],"text":"agent_enable"},{"id":"spn-55106","text":", "},{"id":"spn-55107","marks":["code"],"text":"agent_disable"},{"id":"spn-55108","text":","}]}],"id":"blk-47371","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47373","kind":"paragraph","spans":[{"id":"spn-55109","marks":["code"],"text":"agent_status"},{"id":"spn-55110","text":", "},{"id":"spn-55111","marks":["code"],"text":"agent_audit"},{"id":"spn-55112","text":", "},{"id":"spn-55113","marks":["code"],"text":"permission_check"},{"id":"spn-55114","text":", "},{"id":"spn-55115","marks":["code"],"text":"autonomy_level"}]},{"id":"blk-47374","items":[{"blocks":[{"id":"blk-47376","kind":"paragraph","spans":[{"id":"spn-55116","marks":["bold"],"text":"Built on:"},{"id":"spn-55117","text":" Hermes MCP library"}]}],"id":"blk-47375","kind":"list-item"},{"blocks":[{"id":"blk-47378","kind":"paragraph","spans":[{"id":"spn-55118","marks":["bold"],"text":"Authentication:"},{"id":"spn-55119","text":" delegates to host application (not handled by shim)"}]}],"id":"blk-47377","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47379","kind":"paragraph","spans":[{"id":"spn-55120","text":"---"}]},{"id":"blk-47380","kind":"heading","level":2,"spans":[{"id":"spn-55121","text":"Data Flow"}]},{"id":"blk-47381","kind":"heading","level":3,"spans":[{"id":"spn-55122","text":"Permission Check (Hot Path)"}]},{"id":"blk-47382","kind":"code","language":"text","text":"Agent action\n  --> PermissionEngine.check(agent_id, permission, resource)\n  --> ETS :os_permissions lookup (< 2 microseconds)\n  --> {allow | deny, reason}\n  --> AuditWriter.append(permission_check entry)"},{"id":"blk-47383","kind":"heading","level":3,"spans":[{"id":"spn-55123","text":"Agent Install Flow"}]},{"id":"blk-47384","kind":"code","language":"text","text":"agent_install(manifest)\n  --> PermissionEngine: write grants/denials to ETS\n  --> AgentSupervisor: start_child(AgentLifecycle)\n  --> AgentLifecycle: initial state = :installed\n  --> AuditWriter: log install event"},{"id":"blk-47385","kind":"heading","level":3,"spans":[{"id":"spn-55124","text":"Autonomy Enforcement"}]},{"id":"blk-47386","kind":"code","language":"text","text":"Agent wants to execute action\n  --> AutonomyController.level(agent_id) --> observe | advise | act\n  --> observe: log recommendation, block execution\n  --> advise:  queue action, notify human, await approval\n  --> act:     PermissionEngine.check() --> allow? execute : block"},{"id":"blk-47387","kind":"paragraph","spans":[{"id":"spn-55125","text":"---"}]},{"id":"blk-47388","kind":"heading","level":2,"spans":[{"id":"spn-55126","text":"Integration Points"}]},{"id":"blk-47389","kind":"heading","level":3,"spans":[{"id":"spn-55127","text":"Delegatic Policies"}]},{"id":"blk-47390","kind":"paragraph","spans":[{"id":"spn-55128","text":"Delegatic publishes governance policies via PubSub. The PermissionEngine subscribes and updates its ETS cache when policies change. This enables centralized policy authoring with distributed enforcement."}]},{"id":"blk-47391","kind":"heading","level":3,"spans":[{"id":"spn-55129","text":"Graphonomous Wrapping"}]},{"id":"blk-47392","kind":"paragraph","spans":[{"id":"spn-55130","text":"The governance shim can wrap a Graphonomous instance, adding "},{"id":"spn-55131","marks":["code"],"text":"graph_access"},{"id":"spn-55132","text":" permissions (read/write) to control which agents can query or modify the knowledge graph."}]},{"id":"blk-47393","kind":"heading","level":3,"spans":[{"id":"spn-55133","text":"Agentelic Manifests"}]},{"id":"blk-47394","kind":"paragraph","spans":[{"id":"spn-55134","text":"Agent manifests from Agentelic declare required permissions. The "},{"id":"spn-55135","marks":["code"],"text":"agent_install"},{"id":"spn-55136","text":" tool consumes these manifests, granting or denying permissions according to the current policy."}]},{"id":"blk-47395","kind":"heading","level":3,"spans":[{"id":"spn-55137","text":"FleetPrompt Marketplace"}]},{"id":"blk-47396","kind":"paragraph","spans":[{"id":"spn-55138","text":"Agents installed from the FleetPrompt marketplace enter the same governance flow — "},{"id":"spn-55139","marks":["code"],"text":"agent_install"},{"id":"spn-55140","text":" with the marketplace manifest, starting at "},{"id":"spn-55141","marks":["code"],"text":"observe"},{"id":"spn-55142","text":" autonomy."}]},{"id":"blk-47397","kind":"paragraph","spans":[{"id":"spn-55143","text":"---"}]},{"id":"blk-47398","kind":"heading","level":2,"spans":[{"id":"spn-55144","text":"Harness Components (OS-008)"}]},{"id":"blk-47399","kind":"paragraph","spans":[{"id":"spn-55145","text":"The harness layer sits above the governance shim components. It orchestrates agent pipelines, enforces prerequisite ordering, and manages quality gates."}]},{"id":"blk-47400","kind":"heading","level":3,"spans":[{"id":"spn-55146","text":"PipelineEnforcer (GenServer)"}]},{"id":"blk-47401","kind":"paragraph","spans":[{"id":"spn-55147","text":"Ensures pipeline stages execute in order. Blocks tool calls that violate prerequisites."}]},{"id":"blk-47402","items":[{"blocks":[{"id":"blk-47404","kind":"paragraph","spans":[{"id":"spn-55148","marks":["bold"],"text":"Prerequisite model:"},{"id":"spn-55149","text":" each tool call has a set of required prior stages"}]}],"id":"blk-47403","kind":"list-item"},{"blocks":[{"id":"blk-47406","kind":"paragraph","spans":[{"id":"spn-55150","marks":["bold"],"text":"Key rule:"},{"id":"spn-55151","text":" "},{"id":"spn-55152","marks":["code"],"text":"retrieve_context"},{"id":"spn-55153","text":" MUST complete before any write-class tool call"}]}],"id":"blk-47405","kind":"list-item"},{"blocks":[{"id":"blk-47408","kind":"paragraph","spans":[{"id":"spn-55154","marks":["bold"],"text":"Stage tracking:"},{"id":"spn-55155","text":" MapSet of completed "},{"id":"spn-55156","marks":["code"],"text":"{stage, status}"},{"id":"spn-55157","text":" tuples per session"}]}],"id":"blk-47407","kind":"list-item"},{"blocks":[{"id":"blk-47410","kind":"paragraph","spans":[{"id":"spn-55158","marks":["bold"],"text":"Integration:"},{"id":"spn-55159","text":" wraps above OS-006 permission checks — both must pass"}]}],"id":"blk-47409","kind":"list-item"},{"blocks":[{"id":"blk-47412","kind":"paragraph","spans":[{"id":"spn-55160","marks":["bold"],"text":"Violations:"},{"id":"spn-55161","text":" logged to audit trail with session_id and missing prerequisites"}]}],"id":"blk-47411","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47413","kind":"heading","level":3,"spans":[{"id":"spn-55162","text":"QualityGate (GenServer)"}]},{"id":"blk-47414","kind":"paragraph","spans":[{"id":"spn-55163","text":"Evaluator orchestrator. Spawns evaluator agents in isolated contexts to grade generator output against acceptance criteria."}]},{"id":"blk-47415","items":[{"blocks":[{"id":"blk-47417","kind":"paragraph","spans":[{"id":"spn-55164","marks":["bold"],"text":"Separate context:"},{"id":"spn-55165","text":" evaluator never sees generator reasoning (enforced)"}]}],"id":"blk-47416","kind":"list-item"},{"blocks":[{"id":"blk-47419","kind":"paragraph","spans":[{"id":"spn-55166","marks":["bold"],"text":"Adversarial tuning:"},{"id":"spn-55167","text":" system prompt emphasizes finding failures"}]}],"id":"blk-47418","kind":"list-item"},{"blocks":[{"id":"blk-47421","kind":"paragraph","spans":[{"id":"spn-55168","marks":["bold"],"text":"Evidence required:"},{"id":"spn-55169","text":" pass judgments must cite specific evidence"}]}],"id":"blk-47420","kind":"list-item"},{"blocks":[{"id":"blk-47423","kind":"paragraph","spans":[{"id":"spn-55170","marks":["bold"],"text":"Iteration loop:"},{"id":"spn-55171","text":" fail → feedback → generator iterates (up to max_iterations)"}]}],"id":"blk-47422","kind":"list-item"},{"blocks":[{"id":"blk-47425","kind":"paragraph","spans":[{"id":"spn-55172","marks":["bold"],"text":"Escalation:"},{"id":"spn-55173","text":" max iterations reached → escalate to human"}]}],"id":"blk-47424","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47426","kind":"heading","level":3,"spans":[{"id":"spn-55174","text":"ContractValidator (GenServer + ETS)"}]},{"id":"blk-47427","kind":"paragraph","spans":[{"id":"spn-55175","text":"Validates [&] Protocol governance blocks at runtime."}]},{"id":"blk-47428","items":[{"blocks":[{"id":"blk-47430","kind":"paragraph","spans":[{"id":"spn-55176","marks":["bold"],"text":"Hard constraints:"},{"id":"spn-55177","text":" inviolable — action blocked if violated"}]}],"id":"blk-47429","kind":"list-item"},{"blocks":[{"id":"blk-47432","kind":"paragraph","spans":[{"id":"spn-55178","marks":["bold"],"text":"Soft constraints:"},{"id":"spn-55179","text":" logged as warnings if overridden"}]}],"id":"blk-47431","kind":"list-item"},{"blocks":[{"id":"blk-47434","kind":"paragraph","spans":[{"id":"spn-55180","marks":["bold"],"text":"Escalation rules:"},{"id":"spn-55181","text":" "},{"id":"spn-55182","marks":["code"],"text":"escalate_when.confidence_below"},{"id":"spn-55183","text":", "},{"id":"spn-55184","marks":["code"],"text":"escalate_when.cost_exceeds_usd"}]}],"id":"blk-47433","kind":"list-item"},{"blocks":[{"id":"blk-47436","kind":"paragraph","spans":[{"id":"spn-55185","marks":["bold"],"text":"Confidence gating:"},{"id":"spn-55186","text":" coverage assessment must exceed threshold before dispatch"}]}],"id":"blk-47435","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47437","kind":"heading","level":3,"spans":[{"id":"spn-55187","text":"SprintController (GenStateMachine)"}]},{"id":"blk-47438","kind":"paragraph","spans":[{"id":"spn-55188","text":"Manages the planner → generator → evaluator loop as a state machine."}]},{"id":"blk-47439","items":[{"blocks":[{"id":"blk-47441","kind":"paragraph","spans":[{"id":"spn-55189","marks":["bold"],"text":"States:"},{"id":"spn-55190","text":" "},{"id":"spn-55191","marks":["code"],"text":"planned"},{"id":"spn-55192","text":", "},{"id":"spn-55193","marks":["code"],"text":"generating"},{"id":"spn-55194","text":", "},{"id":"spn-55195","marks":["code"],"text":"evaluating"},{"id":"spn-55196","text":", "},{"id":"spn-55197","marks":["code"],"text":"passed"},{"id":"spn-55198","text":", "},{"id":"spn-55199","marks":["code"],"text":"feedback"},{"id":"spn-55200","text":","}]}],"id":"blk-47440","kind":"list-item"}],"kind":"list","ordered":false},{"id":"blk-47442","kind":"paragraph","spans":[{"id":"spn-55201","marks":["code"],"text":"committed"},{"id":"spn-55202","text":", "},{"id":"spn-55203","marks":["code"],"text":"escalated"},{"id":"spn-55204","text":", "},{"id":"spn-55205","marks":["code"],"text":"completed"}]},{"id":"blk-47443","items":[{"blocks":[{"id":"blk-47445","kind":"paragraph","spans"